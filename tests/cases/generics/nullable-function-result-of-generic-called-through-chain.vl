// @run
// @log 2.5
// @log s
// @log 8
// @log true
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_t` (leading `_` marks it unused)
// D3935: a generic returning a function or null, its result called through the chain inside a
// generic and at top level, and a lambda that returns the null.
function a<T>(_x: T): (t: T) => ((u: T) => T) | null {
  (_t: T) => (u: T) => u
}
function g<T>(x: T) {
  const f = a(x)(x)
  if f != null { print(f(x)) }
}
g(2.5)
g("s")
const h = a(7)(7)
if h != null { print(h(8)) }
function n<T>(_x: T): (t: T) => ((u: T) => T) | null {
  (_t: T) => null
}
const k = n(1)(1)
print(k == null)
