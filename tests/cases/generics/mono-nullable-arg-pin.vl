// @run
// A NULLABLE argument to a generic call pins its type parameter with the `| null` STILL ON.
//
// THE PIN IS THE INSTANCE'S PARAMETER ANNOTATION, which is why nullability has to ride it.
// Every channel `monoArgTyName` consults below the annotation ladder answers about the
// REP, and a nullable's rep IS its non-null base — deliberately: `paramString` claims a
// `string | null` parameter because a `(ref null $s)` takes the string ops once narrowed,
// and `nodeTyMapName` renders the map name for a nullable map. So the cascade named the
// argument `string` / `{[string]: i32}`, the instance declared a NON-NULL parameter, and
// the caller handed it the nullable ref: `vl check` rc 0 and `expected (ref $type), found
// (ref null $type)`. The i32-list niche loses the same information one column over —
// pinned `i32[]`, it built and ran, and an actual `null` argument TRAPPED inside the
// instance. `monoAnnPinName` now claims a nullable whose non-null base it already claims,
// echoing the whole spelling back, so the base membership list stays in one place.
//
// WHAT MOVES, measured over an 18-rep x 8-shape grid (144 cells), each cell its own
// compile: 64 -> 104 correct, 40 moved, 0 backward.
//   * the NULLABLE'S BASE REP. `string`, `string[]`, `f64[]`, `i64[]`, `{[string]: i32}`,
//     `i32[][]`, `S` and `S[]` moved; `i32`, `i64`, `f32`, `f64`, `boolean` and a litunion
//     alias were already correct (their niches are value-encoded, not a nullable ref).
//   * WHERE THE `| null` IS SPELLED: a parameter and a `R | null`-annotated local move
//     alike, and so does a forwarder whose own return is concrete.
//   * THE RUNTIME VALUE is not the axis but it IS the tell: `i32[] | null` and
//     `boolean[] | null` were CORRECT on a non-null argument and TRAPPED on `null`, which
//     is the same dropped `| null` reported one column over.
// CONTROLS: narrowing the value non-null BEFORE the generic call was always correct, and
// so was the same program with no `| null` anywhere.
//
// STILL OPEN, measured on the same grid: the GENERIC spelling of the forwarder
// (`function fwd<T>(x: T | null): T | null`) is a loud `monomorphize: unsupported argument
// type` for all 18 reps, before and after — a `T | null` ANNOTATION riding a type
// parameter is a different site (`monoTyParamOf`); and a module-GLOBAL nullable read
// inside a function is unmoved for `string` and for a map (2 of 18), because
// `monoGlobalLetOf` declines inside a function by design (a function-scoped binding of the
// same name shadows the global) and the cascade's global arms answer about the rep.
//
// @hint Intentionally-unused variable `_y`
// @hint redundant type annotation: `retConcrete` is inferred as `i32`
// @hint redundant type annotation: `noNull` is inferred as `string`
function gid<T>(x: T): T { return x }

// ── the filed shape: a concrete forwarder with a nullable PARAMETER ────────────
function wrapStr(x: string | null): string | null { return gid(x) }
function wrapStrList(x: string[] | null): string[] | null { return gid(x) }
function wrapF64List(x: f64[] | null): f64[] | null { return gid(x) }
function wrapI64List(x: i64[] | null): i64[] | null { return gid(x) }
function wrapMap(x: {[string]: i32} | null): {[string]: i32} | null { return gid(x) }
function wrapNested(x: i32[][] | null): i32[][] | null { return gid(x) }

type P = { x: i32 }
function wrapStruct(x: P | null): P | null { return gid(x) }
function wrapStructList(x: P[] | null): P[] | null { return gid(x) }

function params() {
  // @log aa
  const s = wrapStr("aa")
  if s != null { print(s) } else { print("null") }
  // @log 1
  const sl = wrapStrList(["a"])
  if sl != null { print(sl.length) } else { print("null") }
  // @log 1
  const dl = wrapF64List([1.5])
  if dl != null { print(dl.length) } else { print("null") }
  // @log 1
  const ll = wrapI64List([5 as i64])
  if ll != null { print(ll.length) } else { print("null") }
  const m: {[string]: i32} = Map()
  m["a"] = 1
  // @log 1
  const mm = wrapMap(m)
  if mm != null { print(mm.length) } else { print("null") }
  // @log 2
  const nn = wrapNested([[1, 2]])
  if nn != null { print(nn[0].length) } else { print("null") }
  // @log 7
  const st = wrapStruct({ x: 7 })
  if st != null { print(st.x) } else { print("null") }
  // @log 1
  const sa = wrapStructList([{ x: 7 }])
  if sa != null { print(sa.length) } else { print("null") }
}
params()

// ── an actual `null`: the same instances, the other runtime input ──────────────
// For the ref reps this was the invalid module above; for `i32[] | null` it was the
// runtime trap that identifies the dropped `| null` as the mechanism.
function nullsPassed() {
  // @log null
  const s = wrapStr(null)
  if s != null { print(s) } else { print("null") }
  // @log null
  const mm = wrapMap(null)
  if mm != null { print(mm.length) } else { print("null") }
  // @log null
  const st = wrapStruct(null)
  if st != null { print(st.x) } else { print("null") }
  // @log null
  const nn = wrapNulI32List(null)
  if nn != null { print(nn.length) } else { print("null") }
}

// The i32-list and boolean-list niches: correct on a value, a TRAP on `null`.
function wrapNulI32List(x: i32[] | null): i32[] | null { return gid(x) }
function wrapNulBoolList(x: boolean[] | null): boolean[] | null { return gid(x) }

function niches() {
  // @log 2
  const a = wrapNulI32List([1, 2])
  if a != null { print(a.length) } else { print("null") }
  // @log 1
  const b = wrapNulBoolList([true])
  if b != null { print(b.length) } else { print("null") }
  // @log null
  const c = wrapNulBoolList(null)
  if c != null { print(c.length) } else { print("null") }
}
nullsPassed()
niches()

// ── the `R | null`-annotated LOCAL, and a CONCRETE forwarder return ────────────
function localStr(x: string): string | null {
  const y: string | null = x
  return gid(y)
}
function localMap(x: {[string]: i32}): {[string]: i32} | null {
  const y: {[string]: i32} | null = x
  return gid(y)
}
function retConcrete(x: string | null): i32 {
  const _y = gid(x)
  return 1
}

function otherSpellings() {
  // @log aa
  const s = localStr("aa")
  if s != null { print(s) } else { print("null") }
  const m: {[string]: i32} = Map()
  m["a"] = 1
  m["b"] = 2
  // @log 2
  const mm = localMap(m)
  if mm != null { print(mm.length) } else { print("null") }
  // @log 1
  print(retConcrete("aa"))
}
otherSpellings()

// ── CONTROLS: narrowed before the call, and no `| null` at all ─────────────────
function narrowed(x: string | null): string | null {
  if x != null { return gid(x) }
  return null
}
function noNull(x: string): string { return gid(x) }

function controls() {
  // @log aa
  const s = narrowed("aa")
  if s != null { print(s) } else { print("null") }
  // @log aa
  print(noNull("aa"))
}
controls()

// ── a nullable ELEMENT read, where the two arms of this slice meet ─────────────
// The array's element is itself nullable, so the element peel hands `monoAnnPinName` a
// nullable spelling: one arm feeding the other, with no extra rule for the pair. The peel
// is `listElemNameOf` rather than the raw `[]` cut precisely for this — a composite
// element carries its own grouping parens in the array's name, and the ladder reads bare
// spellings. A nullable MAP element (`({[string]: i32} | null)[]`) does NOT reach here:
// its array LITERAL is a loud `bare null needs a struct-typed context`, before and after.
function takeFirst<T>(xs: T[]): T { return gid(xs[0]) }

function nullableElements() {
  const ss: (string | null)[] = ["aa", "bb"]
  // @log aa
  const s = takeFirst(ss)
  if s != null { print(s) } else { print("null") }
}
nullableElements()
