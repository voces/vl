// @run
// @log 0.30000001192092896
// @log -0.30000001192092896
// @log 1.0000001192092896
// @log 0.30000000000000004
// @log 3

// A constant tree argument at a generic's bare type parameter adapts to the call's destination
// as a lone literal does (D3539, D16540): at `f32` it folds in `f32` arithmetic, at `f64` in
// doubles, and an integer tree takes an integer destination.
function g<T>(x: T): T { x }
const a: f32 = g(0.1 + 0.2)
print(a)
const b: f32 = g(-(0.1 + 0.2))
print(b)
const c: f32 = g((1.5 % 0.1) / (2.5 % 0.1))
print(c)
const d: f64 = g(0.1 + 0.2)
print(d)
const e: i64 = g(1 + 2)
print(e)
