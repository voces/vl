// A generic whose returns join to two list types at a pin: the uses the checker admits of the
// same function spelled without a type parameter build and give the right values (D2766).
function h<T>(c: boolean, t: T) {
  let i = 0
  while i < 2 {
    if c { return [t] }
    i = i + 1
  }
  [1]
}
function count(xs: string[] | i32[]) {
  if xs is string[] { return xs.length }
  0
}
h(true, "s")
print("ok")
const q = h(true, "s")
if q is string[] { print(q[0]) }
const w: string[] | i32[] = h(true, "t")
if w is string[] { print(w.length) }
print(count(h(true, "u")))
