// @emit-error `is` cannot tell {[i32]:i32} from {[i32]:boolean} yet: this instance's union holds both
// A member call (UFCS) reaches the same instance test as a direct call, and is refused at emit.
type IM = {[i32]: i32}
type BM = {[i32]: boolean}
const mb: BM = Map()
mb.set(1, true)
const v: IM | BM = mb
function isIm<T>(self: T): boolean { self is IM }
print(v.isIm())
