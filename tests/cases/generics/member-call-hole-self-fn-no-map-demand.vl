// @run
// @log true
// @log true
// @log 1
// A map or set method name on an un-annotated parameter demands a map only when no
// `self`-function of that name is in scope (D2518). With one in scope the parameter stays open
// and each call site picks the built-in or the function for its own argument: `f(s)` reaches the
// `Set`'s `get` function, and `g(m)` the boolean map's `add`. Before, both were forced into a
// map and refused ("parameter is used as a map…", "expected Set<i32>, got {[i32]: boolean}").
function get(self: Set<i32>, k: i32) { self.has(k) }
function add(self: {[i32]: boolean}, k: i32) { self[k] = true }
function f(x) { x.get(4) }
function g(x) { x.add(3) }
const s = Set<i32>()
s.add(4)
print(f(s))
const m: {[i32]: boolean} = Map()
g(m)
print(m[3] ?? false)
print(m.length)
