// @run
// @log 2
// @log 1
// @log 0
// @log 3
// A parameter `T | IM | string` pinned at `T := BM` is a union the pin mints; the instance
// registers it, so the argument is boxed rather than passed as a bare map (D2657's parameter face).
type IM = {[i32]: i32}
type BM = {[i32]: boolean}
type SM = {[i32]: string}
function k<T>(u: T | IM | string) {
  match u {
    string => 0
    IM => 1
    _ => 2
  }
}
const mb: BM = Map()
const mi: IM = Map()
print(k<BM>(mb))
print(k<BM>(mi))
print(k<BM>("s"))
const ms: SM = Map()
ms.set(1, "a")
function n<T>(u: T | IM) {
  if u is IM { return -1 }
  3
}
print(n<SM>(ms))
