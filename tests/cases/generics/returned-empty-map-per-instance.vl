// @run
// @log 0
// @log 2
// @log 1
// @log 0
// @hint Intentionally-unused parameter `_v` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_w` (leading `_` marks it unused)
// An empty map a generic function returns takes each instance's value type, as its tail spelling
// does: the `return` grades the hole before pinning it from the declared result.
function mk<T>(_v: T): {[string]: T} { return Map() }
const a = mk(1)
print(a.length)
const b = mk("s")
b["k"] = "v"
b["j"] = "w"
print(b.length)
const c = mk(1.5)
c["x"] = 2.5
print(c.length)
function byId<T>(_w: T): Map<i32, T> { return Map() }
print(byId(1).length + byId("s").length)
