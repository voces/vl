// @run
// @log 5
// @log 5
// @log -1
// @log <4>
// @log 3
// @log 4
// A `?.` read under `??` in a hole identity whose argument an instance adopted at a record with a
// boxed `i32 | null` field is that field or the default, at a `const`, an argument, a return and a
// print (D17566).
type A = { d: i32 | null }
function show(n: i32) { return "<\{n}>" }
function g(v) {
  print(v?.d ?? 0)
  return v
}
function atConst(v) {
  const k = v?.d ?? -1
  print(k)
  return v
}
function atArg(v) {
  print(show(v?.d ?? 7))
  return v
}
function atRet(v) {
  print(v?.d ?? 3)
  return v
}
const c: A = g({ d: 5 })
print(c.d ?? -1)
const c2: A = atConst({ d: null })
const c3: A = atArg({ d: 4 })
const c4: A = atRet({ d: null })
print((c2.d ?? 0) + (c3.d ?? 0) + (c4.d ?? 0))
