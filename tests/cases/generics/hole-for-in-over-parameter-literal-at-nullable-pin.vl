// @run
// @log 2
// @log null
// @log 2.5
// @log null
// @log 1
// @log null
// @log q
// @log null
// @log 4
// @log 4
// A hole function's `for`-in over a list literal of its parameter binds the loop variable at
// the parameter's pin, a boxed or nullable one included, whether or not a local holds the
// literal; a second instance at another pin keeps its own (D3014).
type NN = 1 | 2 | null
function f(x) {
  for e in [x] { print(e) }
}
const a: i32 | null = 2
f(a)
const an: i32 | null = null
f(an)
const b: f64 | null = 2.5
f(b)
const bn: f64 | null = null
f(bn)
const c: NN = 1
f(c)
const cn: NN = null
f(cn)
const d: string | null = "q"
f(d)
const dn: string | null = null
f(dn)
function twice(x) {
  for e in [x, x] { print(e) }
}
const t: i32 | null = 4
twice(t)
