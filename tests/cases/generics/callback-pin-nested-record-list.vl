// @run
// @log 4
// @log 4
// @log 1
// @log 2
// An un-annotated callback over a list of record lists pins the generic it calls at the
// element's record, which the checker types from the receiver, through a generic record's
// list field too; same-shaped records are one type, and either name pins (D3834).
type A = { x: i32 }
type B = { x: i32 }
function h<T>(x: T) { x.x }
const a: A = { x: 4 }
print([[a]].map((xs) => h(xs[0]))[0])
const l: A[][] = [[a]]
print(l.map((xs) => h(xs[0]))[0])
type Box<T> = { v: T }
const ba: Box<A[]> = { v: [{ x: 1 }] }
const bb: Box<B[]> = { v: [{ x: 2 }] }
print([ba].map((e) => h(e.v[0]))[0])
print([bb].map((e) => h(e.v[0]))[0])
