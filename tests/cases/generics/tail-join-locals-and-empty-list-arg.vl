// @run
// @log 1.5
// @log cd
// @log 7
// @log 1
// @log true
// @log 40
// @log 2
// @log 3
// @log 1.5
// @log d
// @log 9
// @log 7

// D2186: a tail `if` joining two locals of a type parameter is checked as `T | T`, which the
// instance's result read as no parameter at all and declared `i32`. D2607: an empty `[]`
// argument for `xs: T[]` bound `T` to the literal's `i32` default before a later argument
// named the element the checker inferred.
type P = { p: i32 }
function k64() {
  const r: i64 = 7
  r
}
function mkm(n: i32): {[string]: i32} {
  const m: {[string]: i32} = Map()
  m["k"] = n
  m
}
function mks(n: i32): Set<i32> {
  const s: Set<i32> = Set()
  s.add(n)
  s
}

function join<T>(c: boolean, x: T, y: T) {
  const a = x
  const b = y
  if c { a } else { b }
}
function joinp<T>(c: boolean, x: T, y: T) {
  if c { x } else { y }
}

print(join(true, 1.5, 2.5))
print(join(false, "ab", "cd"))
print(join(true, k64(), k64()))
const jm = join(true, mkm(1), mkm(2))
print(jm["k"] ?? 0)
print(joinp(true, mks(1), mks(2)).has(1))
const jf = joinp(false, (a: i32) => a + 1, (a: i32) => a * 10)
print(jf(4))
print(join(false, [{ p: 1 }], [{ p: 2 }])[0].p)
print(joinp(true, [[3]], [[4]])[0][0])

function first<T>(xs: T[], d: T) {
  for e in xs { return e }
  return d
}
function firstRev<T>(d: T, xs: T[]) {
  if xs.length > 0 { return xs[0] }
  d
}
print(first([], 1.5))
print(first([], "d"))
print(firstRev([8, 9], [])[1])
print(first([], { p: 7 }).p)
