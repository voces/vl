// @run
// @hint Intentionally-unused parameter `_y`
// At a pin that makes an annotated join a `string | null`, `boolean | null` or record niche, a
// numeric literal union is a member of none of them: `is` answers false (D3546).
type L = 1 | 2
type Rec = { x: i32 }
function F<A, B>(x: A, _y: B) {
  const v: A | B | null = x
  print(v is L)
}
F("a", "a")
F(true, false)
F({ x: 1 }, { x: 2 })
F(1, 2)
// @log false
// @log false
// @log false
// @log true
