// @run
// @log z
// @log 1.5
// @log y
// @log 7
// @log w
// @log 2.5
// @log k
// @log true
// @log 5
// @log 8
// @log q
// The SAME defect `type-param-shadows-transparent-alias.vl` pins at the BARE and `[]`
// depths, asked of every OTHER constructor the annotation grammar has. `gaeApplyFieldTy`
// peeled the `[]` ladder and nothing else, so a type PARAMETER sitting behind a `| null`,
// an inline `{…}` shape, a nested APPLICATION, a non-nullable union arm, or any of those
// under a `[]` run was reported as "the substitution does not land here" — the canon'd
// alias BODY was recorded, and the field interned at `i32` while the checker had bound it
// to the ARGUMENT. `vl check` rc=0, "expected i32, found (ref $type)".
//
// Measured over a 15 x 8 grid (the shadowed declaration's KIND x the constructor the
// parameter sits behind, each with a non-shadowing `<T>` control): 66 cells invalid wasm,
// 3 silently WRONG output, 15 a compiler CRASH — every one with a green or greener
// control. The substitution is now the structural walk `monoSubstAnn` already was for the
// FuncDecl half, not a third hand-rolled ladder.
//
// TWO HALVES HAD TO MOVE AND ONLY THE FIRST IS THE SUBSTITUTION. The inline-shape rows
// stayed invalid wasm with the substitution fixed, because the substituted target
// `{a:string}` is a text that appears NOWHERE in the program: a declared struct's nested
// shape is interned from its own `FieldDef` and an inline annotation's from its own
// `TypeRef`, and a monomorphized field has neither. `emit_collect.collectGenAliasShapes`
// now interns an application's substituted field shapes before `gaeEnsure` codes them.
// Adding a `const w: {a: string}` elsewhere in the program was enough to turn the cell
// green on the substitution-only build, which is what told the two halves apart.
//
// Held fixed: one shadowed declaration per alias, one field, one application at a type
// OTHER than the shadowed one. What varies is the CONSTRUCTOR the parameter sits behind
// and the rep under the application (i32 / i64 / f64 / f32 / boolean / string), so a
// rep-blind substitution cannot pass.
type Id = i32

type Nm = string

type Z = 0 | 1

type One = 1

type K = "a" | "b"

type Sx = { n: i32 }

type MyS = Sx

type Fn = (i32) => i32

type Inner<X> = { w: X }

type NulId<Id> = { v: Id | null }

type ShapeId<Id> = { v: { a: Id } }

type NulArrZ<Z> = { v: (Z | null)[] }

type ShapeArrOne<One> = { v: { a: One }[] }

type ShapeInArrK<K> = { v: { a: K[] } }

type AppMyS<MyS> = { v: Inner<MyS> }

type PairFn<Fn> = { v: Fn | i32 }

type NulNm<Nm> = { v: Nm | null }

type ShapeSx<Sx> = { v: { a: Sx } }

const a: NulId<string> = { v: "z" }
print(a.v)

const b: ShapeId<f64> = { v: { a: 1.5 } }
print(b.v.a)

const c: NulArrZ<string> = { v: ["y"] }
print(c.v[0])

const d: ShapeArrOne<i64> = { v: [{ a: 7 }] }
print(d.v[0].a)

const e: ShapeInArrK<string> = { v: { a: ["w"] } }
print(e.v.a[0])

const f: AppMyS<f32> = { v: { w: 2.5 } }
print(f.v.w)

const g: PairFn<string> = { v: "k" }
const gv = g.v
if gv is string { print(gv) }

const h: NulNm<boolean> = { v: true }
print(h.v)

const i: ShapeSx<i64> = { v: { a: 5 } }
print(i.v.a)

// The IDENTITY application — substituting the parameter for the very type its shadowed
// alias names is a no-op, and it must keep running at these depths too.
const j: NulId<i32> = { v: 8 }
const jv = j.v
if jv is i32 { print(jv) }

// A parameter named for a PRIMITIVE binds NOTHING (`primTyOfName` runs before the
// type-param environment), so this field really is `string | null` and the application at
// `i32` changes nothing. The widened substitution must NOT swallow it.
type BoxPrim<string> = { v: string | null }

const k: BoxPrim<i32> = { v: "q" }
const kv = k.v
if kv is string { print(kv) }
