// @run
// @log 8
// @log a!
// @log 6
// An un-annotated lambda handed to a generic at one call passes its parameter to a function, and an
// annotated one is handed at another: the argument bound is judged at its own call only (D16873).
function sel<A>(f: (x: A) => A): (x: A) => A { return f }
function dbl(n: i32) { return n * 2 }
print(sel((x) => dbl(x))(4))
const g = sel((s: string) => s + "!")
print(g("a"))
const h = sel(((x) => dbl(x)))
print(h(3))
