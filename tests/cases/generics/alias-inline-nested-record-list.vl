// @run
// @log 1
// @log 3
// @log x
// @log 1
// @log 7
// @log 3
// @log 1
// @log 2
// D10930: a list of a generic alias whose field is an inline nested record, handed to a
// generic, keys that field by the row its shape interned onto, even when an earlier literal
// interned it first under another name.
type B<U> = { s: { g: U } }
type N<U> = { s: { t: { g: U } } }
type O<U> = { s: { g: U } | null }

function len<T>(v: B<T>[]) { v.length }
function first<T>(v: B<T>[]): T { v[0].s.g }
function put<T>(v: B<T>[], x: T): T {
  v[0].s.g = x
  v[0].s.g
}
function deep<T>(v: N<T>[]): T { v[0].s.t.g }
function opt<T>(v: O<T>[]) { v.length }

print(len([{ s: { g: 3 } }]))
print(first([{ s: { g: 3 } }]))
print(first([{ s: { g: "x" } }]))
const xs = [{ s: { g: 3 } }]
print(len(xs))
print(put([{ s: { g: 3 } }], 7))
print(deep([{ s: { t: { g: 3 } } }]))
print(opt([{ s: { g: 3 } }]))
const a = { g: 9 }
print(len([{ s: a }, { s: { g: 3 } }]))
