// @run
// @log false
// @log false
// @log 3.5
// @log 8
// @log true
// @log false
// Readers of a lambda's join of its body's type parameters (D3520). A string literal union is
// no member of a box with no string arm, so `g() is L` answers false after one call. A lambda
// relaying a helper's call returns what the helper returns, so its caller reads each arm.
type L = "a" | "b"
function F<A, B>(k: i32, x: A, y: B) {
  const g = () => {
    if k == 0 { x } else { y }
  }
  print(g() is L)
}
F(0, 2.5, 1)
F(1, 2.5, 1)
function H<A, B>(k: i32, a: A, b: B) {
  if k == 0 { a } else { b }
}
function W<A, B>(k: i32, a: A, b: B) {
  const f = (j: i32) => H(j, a, b)
  f(k)
}
function Rd<A, B>(k: i32, a: A, b: B) {
  const v = W(k, a, b)
  print(v + 1)
}
Rd(0, 2.5, 7)
Rd(1, 2.5, 7)
function Pi<A, B>(k: i32, a: A, b: B) {
  const g = () => {
    if k == 0 { a } else { b }
  }
  print(g() is i32)
}
Pi(0, 3, 2.5)
Pi(1, 3, 2.5)
