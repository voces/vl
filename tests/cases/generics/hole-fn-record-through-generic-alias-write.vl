// @run
// @log 5
// A field written through an alias of the binding a call initialises holds the written function: the
// read is not resolved through the call, and the function taken as a value is instanced (D16842).
function inc0(a) { return a + 1 }
function inc1(a) { return a + 2 }
function id(x) { return x }
const r = id({ f: inc0 })
const s = r
s.f = inc1
print(r.f(3))
