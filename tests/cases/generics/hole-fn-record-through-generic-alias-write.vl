// @emit-error cannot take the generic function `inc0` as a value
// A field written through an alias of the binding a call initialises is not resolved through the
// call: the read stays a value, refused until a hole function taken as a value is instanced (D16842).
function inc0(a) { return a + 1 }
function inc1(a) { return a + 2 }
function id(x) { return x }
const r = id({ f: inc0 })
const s = r
s.f = inc1
print(r.f(3))
