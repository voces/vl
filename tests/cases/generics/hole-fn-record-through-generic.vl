// @run
// @log 4
// @log 1.5
// @log 7
// @log 8
// @log 6
// Un-annotated functions held as record fields, handed through a generic identity and read off the
// binding of its result, resolve to their one function through the call, each call its own
// argument (D16739).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function inc2(a) { return a + 3 }
function inc3(a) { return a + 4 }
function inc4(a) { return a + 5 }
function id(x) { return x }
const r = id({ f: inc0, g: half })
print(r.f(3))
print(r.g(3))
const s = id({ f: inc3 })
print(s.f(3))
const t = id({ f: inc4 })
print(t.f(3))
const ns = id({ a: { b: { f: inc2 } } })
print(ns.a.b.f(3))
