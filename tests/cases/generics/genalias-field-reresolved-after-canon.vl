// @run
// @log 1069547520
// @log a
// @log 1
// A generic alias whose FIELD annotation is one `canonEmitTypeNames` REWRITES
// (`"a" | "b"` -> `string`), applied at an argument the emitter mints a fresh
// arena index for (`f32` through a monomorphized `wrap`, and a nullable
// `Box<i32 | null>` narrowed with `is`).
//
// WHY THIS SHAPE: `applyGenAliasArgs` memo-keys an application on the head plus
// the ARGUMENT ARENA INDICES, and a nullable / freshly-minted argument type is
// not hash-consed — so the emitter's own re-resolution MISSES the memo and
// re-resolves the alias's field annotations a second time, AFTER canon has run.
// That is the only place in the compiler where the parser's spelling tree is
// read past the pass that rewrites `TypeRef.tyName` in place, and this file is
// the corpus's reach into it: measured, master reads a spelling tree here that
// still says `"a"|"b"` while the node's name says `string`.
//
// It PINS NOTHING TODAY and that is stated rather than implied: canon is
// rep-preserving by construction (softening a literal member to its base scalar
// leaves the runtime representation alone), and the emitter asks the
// re-resolution only for the rep — so both spellings answer the same and every
// channel reads identical. `ast.clearAnnTs` closes the invariant anyway (a live
// root must render to the node's CURRENT name), and this file is the case that
// will exercise it the moment a consumer downstream of canon asks the tree for
// anything sharper than a rep.

type Box<T> = { v: T, w: "a" | "b" }

function wrap<T>(x: T, y: "a" | "b"): Box<T> { return { v: x, w: y } }

const fv: f32 = 1.5
const bx = wrap(fv * 1.0, "a")
print(f32bits(bx.v))
print(bx.w)

let nb: Box<i32 | null> | null = null
nb = { v: 4, w: "b" }
if nb is Box<i32 | null> { print(1) }
