// @run
// @log 10
// @log 1
// @log 20
// @log 10
// @log 100
// @log -1
// @log 104
// @log 30
// @log 40
// @hint redundant type annotation: `h` is inferred as `i32`
// An instance's `is Q[]` over a list of another record, one lacking a field `Q` names, is a fit
// exactly when the list is empty (D4962, by the D4771 ruling), and the arm reads, measures and
// iterates that empty `Q[]`; a nonempty list stays false, and so does a union's other arm.
type P = { x: i32 }
type Q = { y: string }
function a<V>(v: V[]) {
  const q: V[] = []
  if q is Q[] { print(q.length + 10) }
  print(v.length)
}
function g<V>(v: V[]) {
  if v is Q[] { print(10) } else { print(20) }
}
function h<V>(v: V[]): i32 {
  if v is Q[] {
    let n = 0
    for e in v { n = n + e.y.length }
    return n + v.length + 100
  }
  -1
}
function u<V>(v: V[] | i32) {
  if v is Q[] { print(30) } else { print(40) }
}
const ps: P[] = [{ x: 1 }]
const pe: P[] = []
a(ps)
g(ps)
g(pe)
print(h(pe))
print(h(ps))
print(h([{ y: "abc" }]))
u(pe)
u(ps)
