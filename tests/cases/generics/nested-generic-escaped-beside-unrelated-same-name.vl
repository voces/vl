// @run
// @log 2
// @log 2
// @log true
// A nested generic passed as a value beside another function's unrelated nested generic with the
// same parameter name: the second one's call binds only its own rows (D3853 review).
function a<T>(x: T) {
  function b<U>(y: U) { const n: i32 = y; print(n + 1) }
  const f = b
  f(1)
  b(x)
}
function c<T>(x: T) {
  function b<U>(y: U) { print(y) }
  b(x)
}
a(1)
c(true)
