// @log null
// A local bound to a join of the parameter, handed to a generic or a hole callee, picks the
// callee at the join's `string | null` pin, in a `<T>` and a hole instance (D3090).
function idg<T>(a: T): T { return a }
function idh(a) { return a }
function f<T>(x: T) {
  const y = if x == x { x } else { x }
  print(idg(y))
}
const v: string | null = null
f(v)
const w: string | null = "s"
f(w)
function h(x) {
  const y = if x == x { x } else { x }
  print(idh(y))
  print(idg(y))
}
h(v)
