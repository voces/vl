// @log 2
// @log true
// @log 2
// @log 2
// A generic if-join of a type parameter's list and a concrete list is their union at a pin that
// binds the two apart (`f64[] | string[]` at `T := f64`), and one list where they agree. Bound
// to a `const`, the join is built as the union box, so `is`, an alias, a capture, a loop, a
// `match`, a chain and a generic caller all read the arm that ran (D2832).
type Q = { b: string }
function yes() { true }
function no() { false }
function bound<T>(xs: T[], ys: string[]) {
  const r = if no() { xs } else { ys }
  if r is string[] { print(r.length) } else { print(0 - r.length) }
}
function concreteFirst<T>(xs: T[], ys: string[]) {
  const r = if yes() { ys } else { xs }
  if r is string[] { print(r.length) } else { print(0 - r.length) }
}
function taken<T>(xs: T[], ys: string[]) {
  const r = if yes() { xs } else { ys }
  if r is string[] { print(r.length) } else { print(0 - r.length) }
}
function aliased<T>(xs: T[], ys: Q[]) {
  const r = if no() { xs } else { ys }
  const s = r
  if s is Q[] { print(s.length) } else { print(0) }
}
function matched<T>(xs: T[], ys: string[], k: i32) {
  const r = match k {
    0 => xs
    _ => ys
  }
  if r is string[] { print(r.length) } else { print(0) }
}
function chained<T>(xs: T[], ys: string[]) {
  const r = if no() { xs } else if no() { [2] } else { ys }
  if r is string[] { print(r.length) } else { print(0) }
}
function relay<U>(us: U[]) { bound(us, ["a", "b"]) }
function looped<T>(xs: T[], ys: string[]) {
  let i = 0
  while i < 2 {
    const r = if i == 0 { xs } else { ys }
    if r is string[] { print(r.length) } else { print(0 - r.length) }
    i = i + 1
  }
}
function captured<T>(xs: T[], ys: string[]) {
  const r = if no() { xs } else { ys }
  const g = () => r is string[]
  print(g())
}
function returned<T>(xs: T[], ys: string[]) {
  return if no() { xs } else { ys }
}
bound([1.5], ["a", "b"])
concreteFirst([{ b: "x" }], ["a", "b"])
taken([4], ["a", "b"])
aliased([1.5], [{ b: "x" }, { b: "y" }])
matched([true], ["a", "b"], 1)
chained([1.5], ["a", "b"])
relay([1.5])
relay(["q", "r"])
looped([1.5], ["a", "b"])
captured([1.5], ["a", "b"])
const back = returned([1.5], ["a", "b"])
if back is string[] { print(back.length) } else { print(0) }
bound(["q"], ["a", "b"])
