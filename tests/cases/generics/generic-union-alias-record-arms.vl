// @run
// @log false
// @log bad
// @log 4
// @log L
// @log R
// @log 6
// @log 2
// A generic union alias resolves its members under its own type parameters: a record arm over
// `T`, two parameters, a nested generic arm, a record instance, declared after its first use.
const u: Res<{ n: i32 }> = { ok: { n: 4 } }
print(u is { err: string })
type Res<T> = { ok: T } | { err: string }
const w: Res<{ n: i32 }> = { err: "bad" }
if w is { err: string } { print(w.err) }
if u is { ok: { n: i32 } } { print(u.ok.n) }

type Either<L, R> = { left: L } | { right: R }
function side(e: Either<i32, string>) {
  if e is { left: i32 } { return "L" }
  return e.right
}
print(side({ left: 1 }))
print(side({ right: "R" }))

type Box<T> = { v: T }
type U<T> = Box<T> | { z: i32 }
const a: U<Box<i32>> = { v: { v: 6 } }
if a is Box<Box<i32>> { print(a.v.v) }
const b: U<string> = { z: 2 }
if b is { z: i32 } { print(b.z) }
