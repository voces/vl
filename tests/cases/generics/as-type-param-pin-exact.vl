// @run
// @log 2
// @log 7
// @log 9
// @log null
// @log 3
// @log null
// @log 0.10000000149011612
// @hint redundant type annotation: `k` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `n` is inferred as `f32` — remove it to lean on inference
// @hint redundant type annotation: `x` is inferred as `f64` — remove it to lean on inference
// A numeric cast over a type parameter converts at each pin as the direct cast does: an exact
// value converts, and a bare `as` hands the function's null back where `as!` would trap (D2791).
function k<T>(u: T): i32 { u as! i32 }
function b<T>(u: T): i32 | null { u as i32 }
function n<T>(u: T): f32 { u as! f32 }
const x: f64 = 2.0
const y: i64 = 7
print(k(x))
print(k(y))
print(k(9))
print(b(2.5))
print(b(3.0))
print(b("s"))
print(n(0.1))
