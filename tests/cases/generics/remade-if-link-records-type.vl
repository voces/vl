// @run
// @log 8
// @log O
// @log 1
// @warning Unused parameter `x` (prefix with `_` to suppress, or remove it)
// A generic instance re-makes a tail `if` whose arms it re-minted, and the re-made link answers
// its template's join: a capturing lambda in both arms (D3297), and a closure whose tail `if`
// writes a capture cell in both arms (D4306).
function pick<T>(c: boolean, n: i32, x: T) {
  let s = (k: i32) => k + n
  if c { s = (k: i32) => k + n } else { s = (k: i32) => k + n }
}
const r = pick(false, 7, 3)
print(r(1))

function inner<U>(u: U) {
  print("I")
  print(u)
}
function other<V>(v: V) {
  print("O")
  print(v)
}
function third<W>(w: W) {
  print("3")
  print(w)
}
function a<T>(x: T, w: boolean) {
  let k: (t: T) => void = inner
  const toO = () => {
    if w { k = other } else { k = third }
  }
  toO()
  k(x)
}
a(1, true)
