// @error cannot infer type parameter `T`: no parameter of `f` names it, but its body reads `T.size`
// `T.size` with no parameter naming `T` has nothing to bind it from at a call.
// `size-of-explicit-type-arg.vl` is the neighbour that runs.
flat type P = { a: i32, b: i32 }
function f<T>(n: i32): i32 {
  const g = () => T.size
  return g() + n
}
print(f(1))
