// @run
// @log 3:hit 3
// @log 3:30
// D3792: a generic pinned at a `slice` result spelled the record structurally, and that render
// softens a literal field (`kind: "hit"` to `string`) and unfolds a recursive record, so the
// instance built rows the declared ones never twin. The pin is now the declared name.
import { toString } from "std:fmt"

type Hit = { tick: i32, kind: "hit" }
type Miss = { reason: string, kind: "miss" }
type St = { key: i32, evs: (Hit | Miss)[] }
type Node = { key: i32, kids: Node[] }
function g<T>(x: T[]): T[] { return x }
function mk(k: i32): St { return { key: k, evs: [{ tick: k, kind: "hit" }] } }
function node(k: i32): Node {
  return { key: k, kids: [{ key: k * 10, kids: [] }] }
}
const a = [mk(1), mk(2), mk(3)]
const r = g(a.slice(1, 3))
const e = r[1].evs[0]
if e is Hit {
  print(r[1].key.toString() + ":hit " + e.tick.toString())
} else {
  print("miss")
}
const ns = [node(1), node(2), node(3)]
const rn = g(ns.filter((n) => n.key != 2))
print(rn[1].key.toString() + ":" + rn[1].kids[0].key.toString())
