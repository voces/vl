// @hint redundant type annotation: `g` is inferred as `boolean` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// @hint redundant type annotation: `h` is inferred as `boolean` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// @hint redundant type annotation: `f` is inferred as `boolean` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// A Set and a boolean map share a box tag, so `is` over a generic call's result tells them apart
// by the instance's exact type, whether the type argument is explicit or inferred (D10540).
function id<X>(x: X): X { x }
function g<T>(u: T | string): boolean { id(u) is Set<i32> }
function h<T>(u: T | string): boolean { id(u) is {[i32]: boolean} }
const q: {[i32]: boolean} = Map()
const uq: {[i32]: boolean} | string = q
const p: Set<i32> = Set()
const up: Set<i32> | string = p
print(g<{[i32]: boolean}>(uq))
print(g<Set<i32>>(up))
print(g(uq))
print(g(up))
print(h<Set<i32>>(up))
print(h<{[i32]: boolean}>(uq))
print(h(uq))
print(h(up))
function f<T>(u: T | string): boolean { id(u) is {a: Set<i32>} }
const um: {a: {[i32]: boolean}} | string = { a: Map() }
const us: {a: Set<i32>} | string = { a: Set() }
print(f<{a: {[i32]: boolean}}>(um))
print(f<{a: Set<i32>}>(us))
function idu<X>(x: X) { x }
function k<T>(u: T | string) {
  const v = idu(u)
  v is Set<i32>
}
function mk(): {[i32]: boolean} | string {
  const m: {[i32]: boolean} = Map()
  m
}
print(k<{[i32]: boolean}>(mk()))
print(k(mk()))
print(k<Set<i32>>(up))
