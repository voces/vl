// @run
// @log 3
// @log 3
// @log 3
// @log 3
// @log 0.5
// @log 0.25
// @log 0.25
// @log 2
// @log 0.75
// @log 5
// @log 7
// @log 1.5
// @log 0.75
// @log 0.25
// @log 3
// A type parameter's uses join over numeric widening (i32 to i64 or f64, f32 to f64), so the
// order of the arguments does not decide the instance, and a callback's wider result binds it
// whether it comes before or after the narrower value, annotated or not (D2459).
function first<T>(x: T, g: (i32) => T) { [x, g(2)][1] }
function last<T>(g: (i32) => T, x: T) { [x, g(2)][1] }
function keep<T>(x: T, g: (i32) => T) { [x, g(2)][0] }
function mix<T>(a: T, b: T): T[] { [a, b] }
function both<T>(x: T, g: (i32) => T): T[] { [x, g(2)] }
function pair<T>(a: T, b: T, c: T) { [a, b, c][0] }
function inBody<U>(u: U, x: i32, y: f64) {
  print(mix(x, y)[0] / 4.0)
  u
}
function run(two: i32, one: i32, wide: f64, big: i64, half: f32) {
  print(first(two, (i) => i * 1.5))
  print(first(two, (i: i32): f64 => i * 1.5))
  print(last((i) => i * 1.5, two))
  print(last((i: i32): f64 => i * 1.5, two))
  print(keep(two, (i) => i * 1.5) / 4.0)
  print(mix(one, wide)[0] / 4.0)
  print(mix(wide, one)[1] / 4.0)
  print(mix(one, big)[0] + 1)
  print(mix(half, wide)[0] + 0.25)
  const r = both(two, (i) => i * 1.5)
  print(r[0] + r[1])
  print(both(two, (i): i64 => if i == 2 { big } else { 0 })[0] + big - 2)
  print(pair(two, wide, two) / 4.0 + 1.0)
  print(pair(half, wide, half) + 0.25)
  inBody(true, one, wide)
  const nested = mix(mix(one, wide)[0], two)
  print(nested[1] + 1.0)
}
run(2, 1, 2.5, 7, 0.5)
