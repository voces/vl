// @run
// @log 2
// @log 4
// @log 5
// @log 7
// @log 9
// @log s
// @log t
// @log u
// @hint Intentionally-unused parameter `_a` (leading `_` marks it unused)
// A call through a binding typed with the body's `T` runs at an instance binding the other
// type parameter alike, and an un-annotated alias or a nested generic keeps its own (D6483).
function h<T>(x: T) { print(x) }
function f<T, U>(_a: T, b: U) { const k: (x: T) => void = h; k(b) }
f(1, 2)
function f2<T, U>(_a: T, b: U) { const k = (x: T) => print(x); k(b) }
f2(3, 4)
function f3<T, U>(k: (x: T) => void, b: U) { k(b) }
f3((x: i32) => print(x), 5)
function f4<T, U>(_a: T, b: U) {
  function k(x: T) { print(x) }
  k(b)
}
f4(6, 7)
function o<A, B>(a: A, b: B) { f(a, b) }
o(8, 9)
function f5<T, U>(_a: T, b: U) { const k = h; k(b) }
f5(1, "s")
function f6<T, U>(_a: T, b: U) {
  function k<T>(x: T) { print(x) }
  k(b)
}
f6(1, "t")
function f7<T>(a: T) { const k: (x: T) => void = h; k(a) }
f7("u")
