// @error cannot assign boolean to 'n' of type i32
// A nested generic redeclaring `T` that makes a demand of its own `T` and the same demand of
// the enclosing `T` through a capture: the captured one is checked at the enclosing pin.
function a<T>(x: T) {
  function b<T>(y: T) {
    const k: i32 = y
    const n: i32 = x
    print(n + k)
  }
  b(1)
}
a(true)
