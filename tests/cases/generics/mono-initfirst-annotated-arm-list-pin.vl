// Regression (silent-class-inventory D37): a generic's type parameter first bound at an
// INIT-FIRST accumulator column, handed an ANNOTATED `Circle[]` — a list over a declared
// union ARM. No layout twin (`Dot` is absent), and not reachable through `std:array`, whose
// `reduce` is callback-first.
//
// THE COMPLEMENT WAS THREE LINES UP. `monoAnnPinName` is the one home for "which annotation
// NAME can serve as a monomorphization pin", and its STRUCT arm `monoStructAnnName` has had
// BOTH rungs since it was written:
//
//   if isSName(name) { return name }                        // bare  S
//   if nameIsArray(name) && isSName(arrElemNameRaw(name)) { return name }   // list  S[]
//
// The union-ARM arm added for D23 took only the FIRST of the two. So `Circle[]` was claimed
// by neither: `monoStructAnnName`'s list rung asks `isSName("Circle")`, false by the very
// construction its own header names (a variant has no struct row), and
// `variantIndexOf("Circle[]")` is false because the name is an array. Both declines are
// correct in isolation; together they left a spelling with no home and the cascade's `"i32"`
// catch-all pinned an i32 over a `(ref $rlWrap)` list — the instance declared
// `(param structref (ref $list) i32 (ref $clo))` and handed that i32 to a callback expecting
// `(ref $rlWrap)`. `vl check` rc 0; `type mismatch: expected (ref $type), found i32`.
//
// THE FILED ROW NAMED THE WRONG AXIS AND THE GRID IS WHAT SAYS SO. It read "THE SEED BEING
// EMPTY IS THE TRIGGER", because its control replaced the annotated empty local with a
// call-result argument — changing TWO things at once. Crossed properly, 120 cells,
// parameter order x seed spelling x arm-ness x declaration order:
//
//   seed spelling         master   branch      parameter order   master  branch
//   annotated `[]`         4/24     0/24       init-first        12/40    0/40
//   annotated `[c0]`       4/24     0/24       callback-first     0/40    0/40
//   annotated `mk()`       4/24     0/24       no generic         0/40    0/40
//   INFERRED  `mk()`       0/24     0/24
//   direct    `mk()`       0/24     0/24
//
// Emptiness is FLAT across the three annotated spellings and absent from the two
// un-annotated ones: the trigger is the ANNOTATION, which is the only channel
// `monoAnnPinName` is consulted on. Parameter order and arm-ness are load-bearing as filed
// (0/30 at `plain` and at a non-member struct); declaration order is FLAT.
//
// All five seed spellings are pinned below at the init-first order, so the axis is closed by
// the cross product rather than by the diagonal that filed it.
// @run
// @log 1
// @log 9
// @log 9
// @log 9
// @log 9
// @log 1
// THE `: Circle` / `Circle[]` ANNOTATIONS ARE LOAD-BEARING — the `s: Circle[]` seeds are the
// row's whole trigger — so the hints that DO fire are declared rather than silenced.
// @hint redundant type annotation: `c` is inferred as `{r: i32}`
// @hint redundant type annotation: `c` is inferred as `{r: i32}`
// @hint redundant type annotation: `o` is inferred as `Circle[]`
// @hint redundant type annotation: `c0` is inferred as `{r: i32}`
// @hint redundant type annotation: `s` is inferred as `Circle[]`
// @hint redundant type annotation: `s` is inferred as `Circle[]`

type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq

function addTo(acc: Circle[], x: i32): Circle[] {
  const c: Circle = { r: x }
  acc.push(c)
  return acc
}

function mkSeed(i: i32): Circle[] {
  const c: Circle = { r: i }
  const o: Circle[] = [c]
  return o
}

function rdList(v: Circle[]) { return v[0].r }

// INIT-FIRST: `A` is first bound at the `init` column, so the pin comes off the argument's
// own annotation rather than off the callback's signature.
function genInit<T, A>(xs: T[], init: A, f: (A, T) => A): A {
  let a = init
  let i = 0
  while i < xs.length {
    a = f(a, xs[i])
    i = i + 1
  }
  return a
}

// CALLBACK-FIRST — the same body, the same empty annotated seed. This one ran before
// (`A` is bound at `f` first); it is kept as the control that separates the two orders.
function genCb<T, A>(xs: T[], f: (A, T) => A, init: A): A {
  let a = init
  let i = 0
  while i < xs.length {
    a = f(a, xs[i])
    i = i + 1
  }
  return a
}

// The five seed spellings at the INIT-FIRST column.
function seedAnnotEmpty() {
  const s: Circle[] = []
  return rdList(genInit([1, 2], s, addTo))
}

function seedAnnotLit() {
  const c0: Circle = { r: 9 }
  const s: Circle[] = [c0]
  return rdList(genInit([1, 2], s, addTo))
}

function seedAnnotCall() {
  const s: Circle[] = mkSeed(9)
  return rdList(genInit([1, 2], s, addTo))
}

function seedInferCall() {
  const s = mkSeed(9)
  return rdList(genInit([1, 2], s, addTo))
}

function seedDirectCall() { return rdList(genInit([1, 2], mkSeed(9), addTo)) }

// The callback-first control, with the identical annotated empty seed.
function cbAnnotEmpty() {
  const s: Circle[] = []
  return rdList(genCb([1, 2], addTo, s))
}

print(seedAnnotEmpty())
print(seedAnnotLit())
print(seedAnnotCall())
print(seedInferCall())
print(seedDirectCall())
print(cbAnnotEmpty())
