// @check
// @error cannot infer type parameter `T`: `mk`'s return type names it and no parameter does, so a call has nothing to bind it from — give `T` a parameter position, or make the return type concrete
// @error cannot infer type parameter `B`: `pair`'s return type names it and no parameter does, so a call has nothing to bind it from — give `B` a parameter position, or make the return type concrete
// @error cannot infer type parameter `T`: `firstOf`'s return type names it and no parameter does, so a call has nothing to bind it from — give `T` a parameter position, or make the return type concrete
// @warning Unused parameter `self` (prefix with `_` to suppress, or remove it)
// @hint Intentionally-unused variable `_xs` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_p` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_f` (leading `_` marks it unused)
// A type parameter only the RETURN type names is bound by nothing: VL infers a generic call
// from its arguments, so no call site can pin it and the refusal is the checker's (D1813).
// A destination annotation is no pin — it is checked against the call's type, never fed into
// inference — and `self` keeps its name, since UFCS dispatch requires that exact spelling.

function mk<T>(): T[] { return [] }
const _xs: i32[] = mk()

function pair<A, B>(a: A): { x: A, y: B } { return { x: a, y: a } }
const _p = pair(1)

type Box = { n: i32 }
function firstOf<T>(self: Box): T[] { return [] }
const b = { n: 1 }
const _f = b.firstOf()

// The accept set, in the same file so a fix that over-refuses cannot pass: a declaration
// nothing calls is useless rather than ill-typed, and a type parameter the return shares
// with a parameter is bound by the argument, which is the ordinary generic.
export function neverCalled<T>(): T[] { return [] }
function box<T>(seed: T): T[] { return [seed] }
const ns = box(1)
if ns.length > 0 { print("ok") }
