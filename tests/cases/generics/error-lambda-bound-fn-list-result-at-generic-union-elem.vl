// @check
// @error a function of type `() => (() => i32)[]` cannot be used as `() => ((() => i32) | boolean)[]` here
// @error a (() => i32)[] cannot be delivered as ((() => i32) | boolean)[] here
// A lambda returning a bound list of lambdas keeps its own result: only a fresh literal is built at
// the bound union (D16917), where master built an invalid module.
function gen<T>(f: () => ((() => T) | boolean)[]) { return f().length }
const gs = [() => 1]
print(gen(() => gs))
