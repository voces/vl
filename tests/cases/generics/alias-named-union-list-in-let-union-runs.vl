// @run
// @log 2
// @log 2
// @log 2
// A generic's let union over a list of a union reads the same whether the union is named by an
// alias or spelled inline: one set, one row (D15761).
type Circle = { r: i32 }
type Square = { s: i32 }
type Shape = Circle | Square
function keep<T>(xs: Shape[]) {
  const all: Shape[] | T = xs
  if all is Shape[] { return all.length }
  0
}
function keepInline<T>(xs: (Circle | Square)[]) {
  const all: (Circle | Square)[] | T = xs
  if all is (Circle | Square)[] { return all.length }
  0
}
const c: Circle = { r: 1 }
const q: Square = { s: 2 }
const xs = [c, q]
print(keep<i32>(xs))
print(keepInline<i32>(xs))
print(keep<string>(xs))
