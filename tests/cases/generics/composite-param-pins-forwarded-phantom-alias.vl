// @run
// @log 8
// @hint Intentionally-unused parameter `_self` (leading `_` marks it unused)
// @hint redundant type annotation: `outer` is inferred as `i32` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// A phantom alias parameter forwarded through a generic pins at the type the elaboration gives
// it at the inner call (D12601).
type Rows<T> = { base: i32, count: i32 }
function stride<T>(_self: Rows<T>) { return 7 }
function outer<T>(r: Rows<T>): i32 { return stride(r) + 1 }
const st: Rows<i32> = { base: 1000, count: 4 }
print(outer(st))
