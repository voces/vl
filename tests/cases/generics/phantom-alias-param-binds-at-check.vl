// @check
// @error-at 9:6 print expects one scalar or string value
// @error-at 9:12 argument 2: expected P, got i32
// A phantom `T` of `Rows<T>` binds from the application's argument at the call, so `5`
// meets `T = P` here rather than in the instance the monomorphizer builds (D12470).
type P = { a: i32, b: i32 }
type Rows<T> = { base: i32, count: i32 }
function g<T>(_r: Rows<T>, x: T): T { x }
const st: Rows<P> = { base: 1000, count: 4 }
print(g(st, 5))
