// @run
// @log x
// @log 2
// @log x
// @log 2
// @log 5
// @log y
// @log 3
// A non-capturing `const` lambda of a generic encloser, handed to a parameter that calls it at two
// types: every instance of the encloser reads the one closure per signature (D15600).
function mid<F>(a: F) {
  print(a("x"))
  print(a(2))
}
function outer<U>(u: U) {
  const same = (k) => {
    k
  }
  mid(same)
}
outer(7)
outer(true)
function midPair<F>(a: F) {
  print(a(5))
  print(a("y"))
}
function outerPair<U, V>(u: U, v: V) {
  const pass = (k) => {
    k
  }
  midPair(pass)
  print(3)
}
outerPair(1, "z")
