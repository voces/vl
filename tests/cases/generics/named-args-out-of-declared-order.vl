// @run
// @log 1
// @log s
// @log 7
// @log x
// @log x 2.5 5
// @log x true 2.5
// @log x 9 2.5
// @log len2
// @log b
// @log 42
// @log 4
// @log 11
// @log 12
// @log s42.5
// @log k81.5
// @log in
// @log 3
// @log 8
// @log 2
// @log ab
// @hint Intentionally-unused parameter `_b` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_b` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_b` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_b` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_a` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_a` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_a` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_n` (leading `_` marks it unused)
// @hint redundant type annotation: `p` is inferred as `{x: i32}`
// Named arguments bind a generic's type parameters by NAME, not by source position (D2344).

type P = { x: i32 }
function gen<T>(a: () => i32, _b: T) { return a() }
function first<T>(a: string, _b: T) { return a }
function second<T>(_a: () => i32, b: T) { return b }
function third<T>(_a: i32, b: T) { return b }
function g3<T>(a: string, b: f64, c: T) { return "\{a} \{b} \{c}" }
function g3m<T>(a: string, b: T, c: f64) { return "\{a} \{b} \{c}" }
function gl<T>(n: string, xs: T[]) { return "\{n}\{xs.length}" }
function gi<T>(n: i32, xs: T[]) { return xs[n] }
function one() { return 41 }
function cb<T>(a: () => i32, _b: T) { return a() + 1 }
function ap<T>(x: T, f: (T) => T) { return f(x) }
function gs<T>(a: P, _b: T) { return a.x }
function keep<T>(_a: string, b: T) { return b }
function tag<T>(self: string, n: i32, v: T) { return "\{self}\{n}\{v}" }
function gd<T>(c: T, a: string, b: i32 = 3) { return "\{a}\{b}\{c}" }
function idf<U>(u: U) { return u }
function hof(s: string, f: (i32) => i32) { return f(s.length + 7) }
function mk<T>(_n: i32, xs: T[]) { return xs }
let log = ""
function e(s: string, v: i32) {
  log = log + s
  return v
}
function main() {
  print(gen(_b: 7, a: () => 1))
  print(first(_b: 7, a: "s"))
  print(second(b: 7, _a: () => 1))
  print(third(b: "x", _a: 1))
  print(g3(c: 5, b: 2.5, a: "x"))
  print(g3m(c: 2.5, a: "x", b: true))
  print(g3m("x", c: 2.5, b: 9))
  print(gl(xs: ["a", "b"], n: "len"))
  print(gi(xs: ["a", "b"], n: 1))
  print(cb(_b: "q", a: one))
  print(ap(f: (v: i32) => v + 1, x: 3))
  print(gs(_b: "u", a: { x: 11 }))
  const p: P = { x: 12 }
  print(keep(b: p, _a: "u").x)
  print("s".tag(v: 2.5, n: 4))
  print(gd(b: 8, a: "k", c: 1.5))
  print(second(b: second(b: "in", _a: () => 2), _a: () => 1))
  print(second(b: [1, 2, 3], _a: () => 1).length)
  print(hof(f: idf, s: "z"))
  const empty: string[] = []
  print(mk(xs: ["a", "b"], _n: 1).length + mk(xs: empty, _n: 0).length)
  third(b: e("b", 1), _a: e("a", 2))
  print(log)
}
main()
