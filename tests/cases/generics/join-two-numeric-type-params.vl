// @run
// @log 2.5
// @log 1
// @log 3.5
// @log 5000000000
// A join of two type parameters is their union in the generic body (D2760), and at a pin it
// re-joins as the same join written with the pinned types would: `i32` beside `f64` widens to
// `f64` and `i32` beside `i64` to `i64`; a pair with no numeric join stays a union.
function f<A, B>(a: A, b: B, k: boolean) {
  const r = if k { a } else { b }
  r
}
print(f(1, 2.5, false))
print(f(1, 2.5, true))
print(f(1, 2.5, false) + 1.0)
print(f(1, 5000000000, false))
