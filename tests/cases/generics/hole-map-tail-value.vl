// @run
// A hole function whose tail is a `.map` over a hole-typed call result keeps the tail as its
// value, in a bare tail, an `if`/`else` tail, and a generic receiver (D4670).
function mk(v) { return [v] }
function mkg<U>(v: U): U[] { return [v] }
function t(x) { mk(x).map((_e) => "v") }
function u(x) {
  if 1 > 0 { mk(x).map((_e) => "a") } else { mk(x).map((_e) => "b") }
}
function w(x) {
  mk(x).map((_e) => "v")
  7
}
function s<T>(x: T) { mkg(x).map((e) => e) }
print(t(4).length)
print(u(4)[0])
print(w(4))
print(s(5)[0])
print(s(2.5)[0])
// @log 1
// @log a
// @log 7
// @log 5
// @log 2.5
// @hint Intentionally-unused parameter `_e`
