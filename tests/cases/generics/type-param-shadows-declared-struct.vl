// @run
// @log 5
// @log 6
// @log 2
// @log 8
// @log 1
// @log 9
// @hint redundant type annotation: `b` is inferred as `{v: i32}`
// @hint redundant type annotation: `a` is inferred as `{v: i32[]}`
// @hint redundant type annotation: `c` is inferred as `{v: string[]}`
// @hint redundant type annotation: `d` is inferred as `{v: i32[][]}`
// THE INVERTED CONTROL for `type-param-shadows-builtin-application.vl`, and the reason
// that guard is bounded by the PRIMITIVE spellings rather than by "names a real type".
//
// A parameter named for a DECLARED struct IS a parameter. The checker's leaf resolution
// asks `primTyOfName`, then the live parameter binding, then the declared registry — so
// a primitive beats a parameter and a parameter beats a declared type. Both directions
// are observable from the checker alone: it reports `Box<i32>` over `type Box<S> = {v: S}`
// as `{v: i32}` (S bound), and `Box<string>` over `type Box<i32> = {v: i32}` as `{v: i32}`
// (i32 not bound). A guard that declined on any resolvable name would take this file's
// fields with it and hand the emitter `S`/`S[]`/`S[][]` where the checker said i32.
//
// The depth-2 field is the cell that MOVED: with a two-rung substitution ladder
// (`S` and `S[]` only) `v: S[][]` survived un-substituted into the instantiated shape,
// which is a ref-list of a declared struct where the program stores a nested i32 list —
// `vl check` rc=0 and a module that does not parse. Reading the depth off the leaf peel
// fixes it for the same reason it fixes `T[][]`: the rung count stops being a list
// someone wrote down.
type S = { n: i32 }

type Box<S> = { v: S }

type Arr<S> = { v: S[] }

type Nest<S> = { v: S[][] }

const b: Box<i32> = { v: 5 }
print(b.v)

const a: Arr<i32> = { v: [6, 7] }
print(a.v[0])
print(a.v.length)

const c: Arr<string> = { v: ["8"] }
print(c.v[0])

const d: Nest<i32> = { v: [[9]] }
print(d.v.length)
print(d.v[0][0])
