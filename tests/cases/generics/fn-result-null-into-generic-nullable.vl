// @log 1
// @log 1
// @log 0
// @log 1
// @log 0
// @log 0
// @log 0
// @log 1
// A `null`-result lambda for a generic's `() => T | null` parameter binds nothing, so `T` takes
// the unbound default, and the lambda that adopted the open result is typed at the bound one
// (D10211).
function len<T>(f: () => T | null) {
  const t = f()
  if t == null { 0 } else { 1 }
}
print(len(() => null))
print(len((): i32 | null => null))
print(len(() => 4))
print(len(() => null) + len(() => 2))

function size<T>(f: () => T[] | null) {
  const t = f()
  if t == null { 0 } else { 1 }
}
print(size(() => null))
print(size(() => [1]))

function deep<T>(f: () => T | null, n: i32): i32 {
  if n > 0 { return deep(f, n - 1) }
  const t = f()
  if t == null { 0 } else { 1 }
}
print(deep(() => null, 2))

function outer<T>(x: T): T {
  print(len(() => null))
  x
}
outer(5)
outer("s")
print(deep(() => 7, 2))
