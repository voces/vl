// @run
// @log 1
// @log s
// @log null
// @log 2
// @log nil
// @log null
// @log 4
// @log 1
// @log 5
// One un-annotated parameter's field function at several results: scalar, string, nullable,
// narrowed, read out of a list, and through a declared row's nullable result.
function F(z) {
  const g = z.f
  print(g())
}
F({ f: () => 1 })
F({ f: () => "s" })
F({ f: (): i32 | null => null })
function N(z) {
  const g = z.f
  const v = g()
  if v != null { print(v) } else { print("nil") }
}
N({ f: (): i32 | null => 2 })
N({ f: (): i32 | null => null })
function L(z) {
  const xs = [z.f]
  print(xs[0]())
}
L({ f: (): i32 | null => null })
L({ f: () => 4 })
type R = { f: () => i32 | null }
function C(z) {
  const g = z.f
  print(g() ?? 5)
}
C({ f: () => 1 })
const r: R = { f: () => null }
C(r)
