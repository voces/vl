// @check
// @error cannot infer type parameter `T`: `mk`'s return type is inferred as `T[]`, which names it, and no parameter does, so a call has nothing to bind it from — give `T` a parameter position, or make the return type concrete
// @error cannot infer type parameter `T`: `boxed`'s return type is inferred as `{v: T[]}`, which names it, and no parameter does, so a call has nothing to bind it from — give `T` a parameter position, or make the return type concrete
// @error cannot infer type parameter `B`: `pairUp`'s return type is inferred as `B[]`, which names it, and no parameter does, so a call has nothing to bind it from — give `B` a parameter position, or make the return type concrete
// @error cannot infer type parameter `T`: `firstOf`'s return type is inferred as `T[]`, which names it, and no parameter does, so a call has nothing to bind it from — give `T` a parameter position, or make the return type concrete
// @error cannot infer type parameter `T`: `inner`'s return type is inferred as `T[]`, which names it, and no parameter does, so a call has nothing to bind it from — give `T` a parameter position, or make the return type concrete
// @warning Unused parameter `self` (prefix with `_` to suppress, or remove it)
// @hint redundant type annotation: `xs` is inferred as `T[]` — remove it to lean on inference
// A type parameter an INFERRED return type names is bound by nothing, exactly as a declared
// one is: VL infers a generic call from its arguments, so no call site can pin it and the
// refusal is the checker's (D1819). A destination annotation is no pin, `self` keeps its name
// because UFCS dispatch requires that spelling, and a relayed call is named at the relay.

function mk<T>() {
  const xs: T[] = []
  return xs
}
mk()

function boxed<T>() {
  const s: { v: T[] } = { v: [] }
  return s
}
boxed()

function pairUp<A, B>(a: A) {
  const xs: B[] = []
  print(a)
  return xs
}
pairUp(1)

type Bag = { n: i32 }
function firstOf<T>(self: Bag) {
  const xs: T[] = []
  return xs
}
const bag = { n: 1 }
bag.firstOf()

function inner<T>() {
  const xs: T[] = []
  return xs
}
function relay<U>(seed: U) {
  print(seed)
  return inner()
}
relay(1)

// The accept set, in the same file so a fix that over-refuses cannot pass: a type parameter
// the inferred return shares with a PARAMETER is bound by the argument, a return that names
// no type parameter is concrete, and a declaration nothing calls is useless, not ill-typed.
function keep<T>(seed: T) {
  const xs: T[] = [seed]
  return xs
}
print(keep(3).length)

function countOf<T>() {
  const xs: T[] = []
  return xs.length
}
print(countOf())

export function neverCalled<T>() {
  const xs: T[] = []
  return xs
}
