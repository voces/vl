// @run
// @log none
// @log none
// @log none
// @log none
// A guarded call through a hole's `(() => f64) | null`, `i64` or `f32` field, or a nested
// record's field, reads its result at that type where the program holds no closure of that
// signature (D3203, D3217).
type R = { v: i32, f: (() => f64) | null }
type S = { v: i32, f: (() => i64) | null }
type U = { v: i32, f: (() => f32) | null }
function F(z) {
  if z.f != null { print(z.f()) } else { print("none") }
}
const r: R = { v: 1, f: null }
F(r)
const s: S = { v: 2, f: null }
F(s)
const u: U = { v: 3, f: null }
F(u)
type H = { g: () => f64 }
type Q = { v: i32, f: H | null }
function N(z) {
  const g = z.f
  if g != null { print(g.g()) } else { print("none") }
}
const q: Q = { v: 4, f: null }
N(q)
