// @run
// @log 5000000002
// @log 5000000002
// @log 5000000002
// @log 5000000002
// @log 15000000000
// @log 5000000003
// @log 5000000004
// @log 5000000002
// @log true
// @log false
// @log 5000000002
// @hint redundant type annotation: `w` is inferred as `i64`
// An `i64` literal beside an un-annotated parameter computes at `i64` at an `i32`-range
// argument, as `x: i32` does, and each destination of the result is `i64` (D9620).
type S = 1 | 2
const a: S = 2
function f(x) { x + 5000000000 }
const g = (x) => x + 5000000000
function h<T>(x: T) { x + 5000000000 }
function k(x: i32) { x + 5000000000 }
function m(x) { x * 5000000000 }
function big(x) { x > 5000000000 }
function take(v: i64) { print(v + 2) }
print(f(2))
print(g(2))
print(h(2))
print(f(a))
print(m(3))
const w: i64 = f(2)
print(w + 1)
take(f(2))
const xs: i64[] = []
xs.push(f(2))
print(xs[0])
print(big(5000000001))
print(big(2))
print(k(2))
