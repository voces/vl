// @run
// @log RA1
// @log 2
// @log RA3
// @log RA4
// @log RA5
// @log RA6
// @log RA7!
// @log RA8
// @log RA9
// @log 1
// @log RA9
// @log s
// @log 10
// @log 11
// An un-annotated lambda whose parameter takes its type from where it is delivered, calling a
// generic with that parameter: the generic is instantiated at the lambda's contextual type
// (D3820). Each line is one delivery position; the record field in each value proves the
// callee read the record, not the hole's `i32` default.
type A = { x: i32 }
function d(self: A) { "RA\{self.x}" }
function h<T>(x: T) { x.d() }
function k(x) { x.x > 1 }
function id<T>(x: T): T { x }

// A `.map` and a `.filter` callback.
const a1: A = { x: 1 }
print([a1].map((x) => h(x))[0])
const xs: A[] = [{ x: 1 }, { x: 2 }, { x: 3 }]
print(xs.filter((x) => k(x)).length)

// An annotated binding, a declared function return, and a record field.
const kb: (a: A) => string = (x) => h(x)
print(kb({ x: 3 }))
function mk(): (a: A) => string {
  (x) => h(x)
}
print(mk()({ x: 4 }))
type Box = { f: (a: A) => string }
const b: Box = { f: (x) => h(x) }
print(b.f({ x: 5 }))

// An argument to a concrete higher-order function, and a capturing lambda.
function ap(f: (a: A) => string) { f({ x: 6 }) }
print(ap((x) => h(x)))
const suf = "!"
const a7: A = { x: 7 }
print([a7].map((x) => h(x) + suf)[0])

// Inside a function body, inside a generic instantiated twice, and nested in another lambda.
function run(ys: A[]) { ys.map((x) => h(x))[0] }
print(run([{ x: 8 }]))
function runG<U>(ys: A[], u: U) {
  print(ys.map((x) => h(x))[0])
  print(u)
}
runG([{ x: 9 }], 1)
runG([{ x: 9 }], "s")
const nest: A[][] = [[{ x: 10 }]]
print(nest.map((ys) => ys.map((x) => id(x))[0])[0].x)

// A generic handing the record back.
const a11: A = { x: 11 }
print([a11].map((x) => id(x))[0].x)
