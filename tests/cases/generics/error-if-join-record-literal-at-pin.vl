// @error {f: i32} is not {f: i32 | string}: they store field `f` differently
// @error the branches of an `if`, `match` or `??` in the body of `ann` join {f: i32 | string}: cannot assign {f: i32 | string} to 'v' of type {f: string}
// A generic join of a record literal and a record over a type parameter is re-checked at each
// pin, as a list join is: a `{f: 1}` arm cannot be the `{f: string}` the body declares, and a
// runtime `{f: i32}` arm cannot widen to the join `{f: i32 | string}` (D14001).
function ann<T>(t: T, b: boolean) {
  const v: {f: T} = if b { { f: 1 } } else { { f: t } }
  print(v.f)
}
function run<T>(t: T, r: {f: i32}, b: boolean) {
  const v = if b { r } else { { f: t } }
  print(v.f)
}
ann(2, true)
ann("s", true)
run(2, { f: 7 }, true)
run("s", { f: 7 }, true)
