// @run
// @log 1
// @log true
// @log 1
// @log s
// @log 2
// @log 1
// @log 1
// @log true
// A generic's list literal of its `T | null` parameter, at the `T = never` instance a `null`-only
// call binds, is the `null[]` list: each element is that list's null (D17447).
function f<T>(x: T | null) { return [x] }
print(f(null).length)
print(f(null)[0] == null)
print(f<string>(null).length)
print(f("s")[0] ?? "none")
function two<T>(x: T | null) { return [x, x] }
print(two(null).length)
function bound<T>(x: T | null) {
  const xs = [x]
  return xs.length
}
print(bound(null))
function h(x) { return [x] }
print(h(null).length)
const r = f(null)
print(r[0] == null)
