// The neighbours of a `Z | null` result bound at `never` (D17092): a bound result, a plain
// return, the `is null` spelling, and a second instance at a real type beside the `null` one.
function h<Z>(z: Z | null): Z | null {
  if z != null { return z }
  return null
}
function plain<Z>(z: Z | null): Z | null { return z }
function isNul<Z>(z: Z | null): Z | null {
  if z is null { return null }
  return z
}
const r = h(null)
print(r == null)
print(plain(null) == null)
print(isNul(null) == null)
print(h(5) == null)
print(h(5))
print(isNul(null) == null)
print(isNul(7) == null)
