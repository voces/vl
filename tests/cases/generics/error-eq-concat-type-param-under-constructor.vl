// @check
// @error `==` over Circle[] has no lowering
// @error `eqL` compares its type parameter with `==` here: `==` over Circle[] has no lowering
// @error {[string]: i32}[] isn't equatable (a field is not value-comparable)
// @error `==` over {[string]: i32}[] has no lowering
// @error `eqL` compares its type parameter with `==` here: {[string]: i32}[] isn't equatable (a field is not value-comparable) — compare a projection whose components are value-comparable, and only one that no two distinct values share
// @error `eqL` compares its type parameter with `==` here: `==` over {[string]: i32}[] has no lowering
// @error `==` over f64[] has no lowering
// @error `eqL` compares its type parameter with `==` here: `==` over f64[] has no lowering
// @error `==` over F[] has no lowering
// @error `eqL` compares its type parameter with `==` here: `==` over F[] has no lowering
// @error `==` over Circle[][] has no lowering
// @error `eqL` compares its type parameter with `==` here: `==` over Circle[][] has no lowering
// @error `+` over Circle[] has no lowering
// @error `addL` concatenates its type parameter with `+` here: `+` over Circle[] has no lowering
// @error `+` over f64[] has no lowering
// @error `addL` concatenates its type parameter with `+` here: `+` over f64[] has no lowering
// @error `+` over F[] has no lowering
// @error `addL` concatenates its type parameter with `+` here: `+` over F[] has no lowering
// @error `==` over {[string]: i32} | null has no lowering
// @error `eqN` compares its type parameter with `==` here: `==` over {[string]: i32} | null has no lowering
// @error `==` over Circle[] | null has no lowering
// @error `eqN` compares its type parameter with `==` here: `==` over Circle[] | null has no lowering
// GRADUATED from `silent-class-inventory` D421 — D35's and D44's shape ONE CONSTRUCTOR UP.
//
// D35 closed "a `needle: T` the checker will not `==` loses that refusal in the instantiation"
// and D44 closed the same thing for `+`. Both grids varied the delivery of the needle, the
// receiver and the callee, and in every cell the operand's TYPE was `T` itself. `noteBinCstr`
// records a deferred constraint only when an operand's type IS a hole, so `a: T[]` — a
// `TyArray` OVER a hole — recorded nothing, the pin had nothing to re-ask, and every gate in
// the body answered OPAQUE about the instance (`eqCmpKindOfArrayElem` of a `TyVar` element is
// "", and so is `eqCmpKindOfNulInner` of a `TyVar` inner).
//
// EVERY REFUSAL BELOW IS THE DIRECT SPELLING'S OWN, and the pair is what makes that checkable:
// each `…Direct` is the comparison written out and each `…Pinned` is the identical comparison
// reached through a type parameter one constructor down. Before D421 the `Direct` half was a
// loud check reject and the `Pinned` half was `vl check` rc 0 over a module the engine refuses.
// The accept set — every element rep that does NOT lose a capability here — is the sibling
// fixture `eq-concat-type-param-under-constructor-runs.vl`, which reads its answers back.

type Circle = { r: i32 }
type CM = {[string]: i32}
type F = 1.5 | 2.5

function eqL<T>(a: T[], b: T[]): boolean { a == b }
function addL<T>(a: T[], b: T[]): T[] { a + b }
function eqN<T>(a: T | null, b: T | null): boolean { a == b }

function mkm(): CM { const m: CM = Map(); m["k"] = 1; m }

// ── `==` at an element rep with no list-compare core ──────────────────────────────────
function structListDirect(a: Circle[], b: Circle[]): boolean { a == b }
function structListPinned(a: Circle[], b: Circle[]): boolean { eqL(a, b) }
function mapListDirect(a: CM[], b: CM[]): boolean { a == b }
function mapListPinned(a: CM[], b: CM[]): boolean { eqL(a, b) }
function f64ListDirect(a: f64[], b: f64[]): boolean { a == b }
function f64ListPinned(a: f64[], b: f64[]): boolean { eqL(a, b) }
function f64UnionListDirect(a: F[], b: F[]): boolean { a == b }
function f64UnionListPinned(a: F[], b: F[]): boolean { eqL(a, b) }
function nestedListDirect(a: Circle[][], b: Circle[][]): boolean { a == b }
function nestedListPinned(a: Circle[][], b: Circle[][]): boolean { eqL(a, b) }

// ── `+` at the same element reps — D44's operator, D421's spelling ────────────────────
function structConcatDirect(a: Circle[], b: Circle[]): i32 { (a + b).length }
function structConcatPinned(a: Circle[], b: Circle[]): i32 { addL(a, b).length }
function f64ConcatDirect(a: f64[], b: f64[]): i32 { (a + b).length }
function f64ConcatPinned(a: f64[], b: f64[]): i32 { addL(a, b).length }
function f64UnionConcatDirect(a: F[], b: F[]): i32 { (a + b).length }
function f64UnionConcatPinned(a: F[], b: F[]): i32 { addL(a, b).length }

// ── THE OTHER CONSTRUCTOR: `T | null`. A nullable whose inner has no compare core is the
//    same lost refusal, and the `Circle | null` cell that DOES have one is in the sibling
//    fixture because its correct end state is `runs`. ──────────────────────────────────
function nulMapDirect(a: CM | null, b: CM | null): boolean { a == b }
function nulMapPinned(a: CM | null, b: CM | null): boolean { eqN(a, b) }
function nulStructListDirect(a: Circle[] | null, b: Circle[] | null): boolean {
  a == b
}
function nulStructListPinned(a: Circle[] | null, b: Circle[] | null): boolean {
  eqN(a, b)
}

print(structListDirect([{ r: 1 }], [{ r: 2 }]))
print(structListPinned([{ r: 1 }], [{ r: 2 }]))
print(mapListDirect([mkm()], [mkm()]))
print(mapListPinned([mkm()], [mkm()]))
print(f64ListDirect([1.5], [2.5]))
print(f64ListPinned([1.5], [2.5]))
print(f64UnionListDirect([1.5], [2.5]))
print(f64UnionListPinned([1.5], [2.5]))
print(nestedListDirect([[{ r: 1 }]], [[{ r: 2 }]]))
print(nestedListPinned([[{ r: 1 }]], [[{ r: 2 }]]))
print(structConcatDirect([{ r: 1 }], [{ r: 2 }]))
print(structConcatPinned([{ r: 1 }], [{ r: 2 }]))
print(f64ConcatDirect([1.5], [2.5]))
print(f64ConcatPinned([1.5], [2.5]))
print(f64UnionConcatDirect([1.5], [2.5]))
print(f64UnionConcatPinned([1.5], [2.5]))
print(nulMapDirect(mkm(), null))
print(nulMapPinned(mkm(), null))
print(nulStructListDirect([{ r: 1 }], null))
print(nulStructListPinned([{ r: 1 }], null))
