// @run
// @log true
// @log false
// @log true
// @log false
// @log 4
// @hint redundant type annotation: `app` is inferred as `boolean` — remove it to lean on inference
// A named function with an inference-hole parameter handed to a generic callback parameter takes
// the type the value argument binds, over a value union, a record union and an i32 (D3095, D2458).
type P = { a: i32 }
type Q = { b: string }
function app<T>(x: T, f: (T) => boolean): boolean { return f(x) }
function g(w) { return w is i64 }
function gp(w) { return w is P }
const z: (string | i64)[] = [5, "t"]
for e in z { print(app(e, g)) }
const zr: (P | Q)[] = [{ a: 1 }, { b: "t" }]
for e in zr { print(app(e, gp)) }
function show(a) { return a + 1 }
function run<T>(cb: (T) => i32, v: T) { return cb(v) }
print(run(show, 3))
