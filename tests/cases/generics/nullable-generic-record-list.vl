// @run
// @log 0.75
// @log true
// @log abc
// @log 21
// @log 2
// @log 4
// @log 2
// @log q
// @log 3
// A nullable list element whose inner is a record (`CX<T> | null`) or a union (`null | K | i32`)
// is not a niche: the record rides its own row and the union boxes (D3137).
type CX<X> = { v: X }
function f<T>(v: T): (CX<T> | null)[] { [{ v: v }, null] }
const r = f(1.5)
const e = r[0]
if e != null { print(e.v / 2.0) }
print(r[1] == null)
const s = f("ab")
const e2 = s[0]
if e2 != null { print(e2.v + "c") }
const t = f(7)
const e3 = t[0]
if e3 != null { print(e3.v * 3) }
function cnt<T>(v: (CX<T> | null)[]) {
  let n = 0
  for x in v {
    if x != null { n = n + 1 }
  }
  n
}
print(cnt([{ v: "a" }, null, { v: "b" }]))
function g<T>(x: T) {
  const l: (CX<T> | null)[] = [{ v: x }, null]
  const a = l[0]
  if a != null { print(a.v) }
  l.length
}
print(g(4))
g("q")
type K = "a" | "b"
const zz: (null | K | i32)[] = ["a", null, 3]
print(zz.length)
