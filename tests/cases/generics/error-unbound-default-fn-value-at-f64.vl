// @check
// @error argument 1: expected i32, got f64 (`sel`'s `A` is bound by nothing at its call, so it is `i32` there: write `sel<f64>(…)`)
// A generic function handed to a generic's function-typed parameter that nothing else binds takes
// the unbound default, so its value used at `f64` through a list element is refused at check, not
// built at `i32` and trapped on (D16562; the run face is D16640).
function gid<A>(x: A): A { return x }
function sel<A>(f: (x: A) => A): (x: A) => A { return f }
const xs = [sel(gid)]
print(xs[0](1.5))
