// @emit-error `is` cannot tell {[i32]:i32} from {[i32]:boolean} yet: this instance's union holds both
// The union `V | {[i32]: i32}` is formed in the body, so no type argument holds the pair (D2657).
function g<V>(m: V, n: {[i32]: i32}): boolean {
  const u: V | {[i32]: i32} = n
  u is {[i32]: i32}
}
const mb: {[i32]: boolean} = Map()
const mi: {[i32]: i32} = Map()
print(g(mb, mi))
