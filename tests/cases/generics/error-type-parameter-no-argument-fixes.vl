// @check
// @error cannot infer the type parameter `T` of `only`: no argument fixes it; annotate `w` or pass the type parameter explicitly
// @hint Intentionally-unused parameter `_r`
// A call whose type parameter no argument binds leaves its result a type variable; an un-annotated
// binding of it is refused at check, with the contract, not built with no type (D17575).
type Rows<T> = { base: i32, count: i32 }
function mk<T>(b: i32): Rows<T> { return { base: b, count: 1 } }
function only<T>(_r: Rows<T>): T[] { return [] }
const su = mk<i32>(8)
const w = only(su)
print(w.length)
