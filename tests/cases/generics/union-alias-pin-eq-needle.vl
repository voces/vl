// @run
// @log 1
// @log 0
// @log 2
// @log true
// @log 1
// @log 0
// @log 1
// A generic `self[i] == needle` pinned at a numeric union ALIAS compares per member on both
// sides: the parameter reaches the instance with no recorded type, and its box's member set is
// read through the alias (D3491's review). A `(T, T) => boolean` generic beside it is what makes
// the instance dispatch.
import { count, includes, indexOf, lastIndexOf, sorted } from "std:array"

type D = 9000000000 | 1
type U = i32 | i64
function idx<T>(self: T[], needle: T) {
  let i = 0
  while i < self.length {
    if self[i] == needle { return i }
    i = i + 1
  }
  return -1
}
const a: D[] = [9000000000, 1, 1]
print(indexOf(a, 1))
print(indexOf(a, 9000000000))
print(lastIndexOf(a, 1))
print(includes(a, 9000000000))
print(count(a, 9000000000))
const s = sorted(a, (x: D, y: D) => x == 9000000000 && y != 9000000000)
print(idx(s, 9000000000))
const u: U[] = [9000000000, 1]
print(idx(u, 1))
