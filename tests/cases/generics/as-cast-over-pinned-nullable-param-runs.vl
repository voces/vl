// @run
// @log 2
// @log 0
// @log 7
// @log 9
// @log -1
// @log s
// A cast over a `T | null` parameter is lowered at the instance's own type, where `T` pinned
// to a reference makes `| null` a nullable reference to test (D2719).
type R = { a: i32 }
function size<T>(u: T | null) {
  const w = u as? Set<i32>
  if w == null { return 0 }
  return w.length
}
const s: Set<i32> = Set()
s.add(3)
s.add(4)
print(size<Set<i32>>(s))
print(size<Set<i32>>(null))
function first<T>(u: T | null) {
  const w = u as! i32[]
  return w[0]
}
print(first<i32[]>([7, 8]))
function get<T>(u: T | null) {
  const w = u as? R
  if w == null { return 0 - 1 }
  return w.a
}
print(get<R>({ a: 9 }))
print(get<R>(null))
function ms(): string | null { return "s" }
function gen<T>(x: T | null): T { return x as! T }
print(gen(ms()))
