// @run
// @log 7
// @log true
// @log b
// @log a
// @log true
// @log 7
// @log b
// @log true
// @log 7
// @log true
// D3167: function values whose types share a wasm signature (`() => i32`, `() => boolean`, a
// literal union and its `| null` niche) get one instance each of the un-annotated function they
// are passed to, through an instance's parameter and through a binding alike (D3176).
type K = "a" | "b"
function H(h) { return h() }
function F<Z>(g: Z) { print(H(g)) }
F(() => 7)
F(() => true)
F((): K => "b")
F((): K | null => "a")
function G(g) { print(H(g)) }
G(() => true)
G(() => 7)
{
  const q = (): K => "b"
  print(H(q))
}
{
  const q = () => true
  print(H(q))
}
function P(g) { print(g()) }
const c0 = () => 7
P(c0)
const c1 = () => true
P(c1)
