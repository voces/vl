// @run
// @log 0
// @log 0
// @log 0
// @log 2
// @log 3
// `is` over a bounded type parameter's field whose pin makes the test false is false, and the
// arm it guards, typed at the tested type, is not lowered (D15606).
function boundShow<T: { x: i32 | string }>(t: T) {
  if t.x is string { print(t.x) } else { print(0) }
}
function boundNum<T: { x: i32 | string }>(t: T) {
  if t.x is i32 { print(t.x) } else { print(0) }
}
function boundLen<T: { x: i32 | string }>(t: T) {
  const r = if t.x is string { t.x.length } else { 0 }
  print(r)
  if !(t.x is string) { print(2) }
}
const a: { x: i32 } = { x: 7 }
const s: { x: string } = { x: "abc" }
boundShow(a)
boundNum(s)
boundLen(a)
boundLen(s)
