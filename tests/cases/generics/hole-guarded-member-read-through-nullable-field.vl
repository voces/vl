// @run
// @log 0
// @log 3
// @log 0
// @log 3
// @log 0
// @log 3
// @log 9
// @log 0
// @log 3
// @log 0
// @log 3
// @log 7
// @log 5
// @log 0
// @log 0
// @log 3
// @log 5
// @log 6
// @log 8
// A member read through a `| null` field runs in a hole or generic body when a null test
// guards it (on the field, on a binding of it, through `&&` or an early return), after a
// non-null write, and in the arms of an `is` chain whose remainder has no `null` left (D3287);
// a list cell and a nested field narrow the same way.
type O = { n: i32 }
type R = { v: O | null }
const n: R = { v: null }
const y: R = { v: { n: 3 } }

function onField(z) {
  if z.v != null { print(z.v.n) } else { print(0) }
}
onField(n)
onField(y)
function onBinding<Z>(z: Z) {
  const o = z.v
  if o != null { print(o.n) } else { print(0) }
}
onBinding(n)
onBinding(y)
function viaAnd(z) {
  if z.v != null && z.v.n > 0 { print(z.v.n) } else { print(0) }
}
viaAnd(n)
viaAnd(y)
function afterWrite(z) {
  z.v = { n: 9 }
  print(z.v.n)
}
const w: R = { v: null }
afterWrite(w)
function earlyReturn(z) {
  if z.v == null {
    print(0)
    return
  }
  print(z.v.n)
}
earlyReturn(n)
earlyReturn(y)
function isNullElse(z) {
  if z.v is null { print(0) } else { print(z.v.n) }
}
isNullElse(n)
isNullElse(y)

type A = { a: i32 }
type U = { h: A | i32 | null }
function chain(z) {
  if z.h == null { print(0) }
  else if z.h is i32 { print(z.h) }
  else { print(z.h.a) }
}
chain({ h: { a: 7 } })
const five: U = { h: 5 }
chain(five)
const none: U = { h: null }
chain(none)

function onCell(xs) {
  if xs[0] != null { print(xs[0].n) } else { print(0) }
}
const cells: (O | null)[] = [null]
onCell(cells)
onCell([{ n: 3 }])
function writeCell(xs, a) {
  xs[0] = a
  print(xs[0].n)
}
const cells2: (O | null)[] = [null]
writeCell(cells2, { n: 5 })
function writeNested(b) {
  b.r.v = { n: 6 }
  print(b.r.v.n)
}
writeNested({ r: w })
function writeNestedHole(b, a) {
  b.r.v = a
  print(b.r.v.n)
}
writeNestedHole({ r: n }, { n: 8 })
