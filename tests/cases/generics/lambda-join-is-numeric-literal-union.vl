// @run
// `g() is L` over a lambda joining two parameters, at a pin of members, tests the value the
// call returns rather than folding by name (D3547).
type L = 1 | 2
function F<A, B>(k: i32, x: A, y: B) {
  const g = () => {
    if k == 0 { x } else { y }
  }
  print(g() is L)
}
F(0, 1, 1)
F(1, 1, 1)
F(1, 1, 7)
// @log true
// @log true
// @log false
