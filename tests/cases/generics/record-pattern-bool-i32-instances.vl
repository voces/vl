// @run
// A record-pattern generic instantiated at `{ x: boolean }` and `{ x: i32 }`, whatever field
// order the argument has and whichever comes first: the two share a layout, and each
// instance reads and formats its own (D3693).
type W2 = { y: i32, x: boolean }
function getX<T>(r: { x: T }): T { r.x }
const a = { y: 5, x: true }
const b: W2 = { y: 6, x: false }
const c = { y: 5, x: 7 }
print(getX(a))
print(getX({ x: 1 }) + 1)
print(getX(b))
print(getX(c))
print(getX({ x: true }))
// @log true
// @log 2
// @log false
// @log 7
// @log true
