// @log 3
// D13540, D13541, D13542: an `if` or `match` choosing un-annotated functions, handed to a
// parameter the callee calls at two types, runs once where the source runs it: bound to a
// `const` in a function with an un-annotated parameter, after an expression that calls in the
// same statement, in a `while` condition, and on the right of `??`, `&&` or `||` when it calls.
function both(f) {
  print(f("a"))
  return f(1)
}
function bothAt(n, f) {
  print(f("a"))
  return f(n)
}
function inner(s) { return s }
function ask(s) { return s }
function twice(s) { return s + s }
function two(a: i32, b: i32) { return a + b }
function twoAny(a, b) { return a + b }
let k = false
let tk = 0
function tick() {
  tk = tk + 1
  print("tick")
  return tk % 2 == 0
}
function tickN() {
  tk = tk + 1
  print("tick")
  print(tk)
  return tk % 2 == 0
}
function flip() {
  k = !k
  print("flip")
  return 0
}
function bump() {
  tk = tk + 100
  return 0
}

function bound(c) {
  const h = if c { inner } else { ask }
  print(both(h))
}
bound(false)
bound(true)

function boundLbl(c) {
  const h = @B { break @B if c { inner } else { ask } }
  print(both(h))
}
boundLbl(false)

function boundUnread(c) {
  const h = if k { inner } else { twice }
  print(both(h))
  print(c)
}
boundUnread(3)
k = true
boundUnread("x")

function boundMatch(n, c) {
  const h = match c {
    0 => inner
    _ => twice
  }
  print(both(h) + n)
}
boundMatch(1, 0)
boundMatch(2, 5)

k = false
print(two(flip(), both(if k { twice } else { inner })))

k = false
tk = 0
type R = { a: boolean, v: i32 }
function ahead(z) {
  const r: R = { a: tickN(), v: both(if k { twice } else { inner }) }
  print(r.v)
  print(z + both(if tickN() { inner } else { ask }))
  print(two(flip(), two(flip(), both(if k { twice } else { inner }))))
  print(two(tk, two(flip(), both(if k { twice } else { inner }))))
}
ahead(10)
const xs = [1, 2]
print(xs[0] + both(if tickN() { twice } else { inner }))

function loopCond(c: boolean) {
  let i = 0
  while i < both(if c { inner } else { ask }) {
    print(i)
    i = i + 1
  }
}
loopCond(true)

k = false
tk = 0
function lazy(m: i32 | null, ys: boolean[]) {
  print(two(tk, two(bump(), both(if k { twice } else { inner }))))
  print(m ?? both(if tick() { inner } else { ask }))
  print(m ?? both(if ys[3] { inner } else { ask }))
  print(m ?? two(flip(), both(if k { twice } else { inner })))
  print(ys[0] && both(if tick() { inner } else { ask }) > 0)
  print(ys[1] || both(if tick() { inner } else { ask }) > 0)
  let i = 0
  while i < both(if tick() { inner } else { twice }) {
    i = i + 1
    if i == 1 { continue }
    print(i)
  }
}
lazy(7, [false, true])
print("--")
lazy(null, [true, false, true, true])

k = false
tk = 0
function second(z: i32, c) {
  print(twoAny(flip(), bothAt(z, if k { twice } else { inner })))
  print(twoAny(tk, bothAt(z, if tick() { inner } else { twice })))
  let i = 0
  while (
    i
      < bothAt(
      z,
      match c {
        0 => inner
        _ => twice
      },
    )
    && tick()
  ) {
    i = i + 1
    print(i)
  }
  const h = if c == 0 { inner } else { twice }
  print(twoAny(flip(), bothAt(z, h)))
}
second(3, 0)
second(1, 1)

k = false
function boundBeside(z) {
  const h = if k { twice } else { inner }
  print(bothAt(z, h))
}
boundBeside(3)
