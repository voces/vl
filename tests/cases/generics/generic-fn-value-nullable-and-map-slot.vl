// @run
// @log 6
// @log 6
// @log 15
// @log 10
// @log 3
// D3112: a generic function named as a value is instantiated at the function type it is
// delivered to, through a nullable binding, a map value, a pushed list element and another
// generic's function parameter (D3113) as well as a plain annotated binding.
function show<T>(x: T) { print(x * 3) }
function show5<T>(x: T) { print(x * 5) }
function app<U>(f: (U) => void, u: U) { f(u) }
function id<T>(x: T) { print(x) }

let h: ((i32) => void) | null = null
h = show
if h != null { h(2) }
const m: {[string]: (i32) => void} = Map()
m["k"] = show
const mk = m["k"]
if mk != null { mk(2) }
const fs: ((i32) => void)[] = []
fs.push(show5)
fs[0](3)
m.set("j", show5)
const mj = m.get("j")
if mj != null { mj(2) }
app(id, 3)
