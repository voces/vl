// @error cannot assign boolean to 'n' of type i32
// A nested generic with a self-call in its own body, called with a value of the enclosing `T`:
// the self-call binds nothing for the enclosing pin (D3853 review).
function a<T>(x: T) {
  function b<T>(y: T) {
    if false { b(y) }
    const n: i32 = y
    print(n + 1)
  }
  b(x)
}
a(true)
