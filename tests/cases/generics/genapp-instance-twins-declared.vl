// @run
// @log 7
// @log 8
// @log 9
// @log 10
// @log 11
// @log 12
// @log q
// A GENERIC-ALIAS INSTANCE AND A DECLARED STRUCT OF THE SAME SHAPE ARE ONE HEAP TYPE.
//
// `Box<i32>` and `type IBox = { v: i32 }` are the same type — the checker has always
// agreed (`assignable` takes one where the other is asked for) and every position below
// type-checks clean. The emitter did not: `gaeEnsure` mints a struct row for each concrete
// application, and that row's `sTyIx` sidecar banked -1 because the name ladder behind it
// (`sTyIxOfNameTy`) had no arm for a `Head<…>` spelling — `cUserTypes` holds the generic
// BASE (`Box`), never an application, and the inline-shape rung wants a leading `{`. A -1
// there makes `slotCanonId` answer -1, and `buildStructTwins` tests `keys[i] >= 0` BEFORE
// `structFieldCodesEq`, so an application row was never compared against ANY row. It got a
// heap type of its own, and every one of the seven crossings below was check-clean INVALID
// WASM ("type mismatch: expected (ref $type), found (ref $type)" — two heap types printing
// the same name, which is what makes that message unreadable).
//
// This is the generic-application sibling of the permuted-alias ruling
// (`types/permuted-inline-shape-shares-row.vl`,
// `soundness/xfail-miscompile-permuted-struct-fields.vl`): the same two gates, blocked at
// the same FIRST one, for a different reason — there the key disagreed, here there was no
// key at all.
//
// A `flat type` (order IS layout) and a `new` brand stay distinct on their own terms;
// `types/genapp-instance-vs-flat-and-newtype.vl` is that control.
type Box<T> = { v: T }
type IBox = { v: i32 }
type SBox = { v: string }

// @hint redundant type annotation: `bi` is inferred as `{v: i32}`
const bi: Box<i32> = { v: 7 }

// PARAM — the application value into a parameter annotated with the declared name.
function useI(b: IBox) { b.v }
print(useI(bi))

// PARAM, the other direction — a declared-name value into an application-typed parameter.
// @hint redundant type annotation: `d8` is inferred as `{v: i32}`
function useB(b: Box<i32>) { b.v }
const d8: IBox = { v: 8 }
print(useB(d8))

// RETURN — a declared-name return flowing into an application-typed binding.
// @hint redundant type annotation: `r` is inferred as `IBox`
function mk9(): IBox { { v: 9 } }
const r: Box<i32> = mk9()
print(r.v)

// STRUCT FIELD.
// @hint redundant type annotation: `h` is inferred as `{c: {v: i32}}`
type Holder = { c: IBox }
const h: Holder = { c: { v: 10 } }
print(h.c.v)

// ARRAY ELEMENT.
// @hint redundant type annotation: `b11` is inferred as `{v: i32}`
// @hint redundant type annotation: `xs` is inferred as `Box<i32>[]`
const b11: Box<i32> = { v: 11 }
const xs: IBox[] = [b11]
print(xs[0].v)

// MAP VALUE.
const m: {[string]: IBox} = Map()
m["k"] = bi
const mv = m["k"]
if mv != null { print(mv.v + 5) }

// A SECOND INSTANCE OF THE SAME BASE, so the merge is per-instance and not per-base: the
// `string` instance twins `SBox`, not `IBox`, and the two instances stay apart.
// @hint redundant type annotation: `bs` is inferred as `{v: string}`
function useS(b: SBox) { b.v }
const bs: Box<string> = { v: "q" }
print(useS(bs))
