// @run
// @log a
// @log a
// @log x
// @log x
// @log null
// @log null
// @log N
// D3140: a union a substitution builds beside a nullable niche is the union the annotation
// route spells for the same members, `K | null | i32` wrapping its `null` and `K | null | string`
// the `string | null` niche, so a caller binding the result, a `.map` returning it, a grouped
// `(K | null) | string` annotation and a union-list literal of niche values all agree on the rep.
type K = "a" | "b"
type L = "x" | "y"
function f<T>(x: T, pick: boolean, o: i32): T | i32 {
  if pick { return x }
  return o
}
const a: K | null = "a"
const r = f(a, true, 7)
print(r)
function s<T>(x: T, pick: boolean, o: string): T | string {
  if pick { return x }
  return o
}
const r2 = s(a, true, "z")
print(r2)
function k<T>(x: T, pick: boolean, o: K): T | K {
  if pick { return x }
  return o
}
const kl: K | L | null = "x"
const ko: K = "a"
print(k(kl, true, ko))
function m<T>(ys: T[], pick: boolean, o: string): (T | string)[] {
  return ys.map((e): T | string => {
    if pick { return e }
    return o
  })
}
print(m([kl], true, "z")[0])
function g<T>(x: T): (T | string)[] { return [x].map((e): T | string => e) }
function h() {
  const z: K | null = null
  const zs = g(z)
  print(zs[0])
}
h()
function w(x: K | null): ((K | null) | string)[] {
  return [x].map((e): (K | null) | string => e)
}
print(w(null)[0])
function kn(b: boolean): K | null {
  if b { return "b" }
  return null
}
const xs: (K | null | i32)[] = [kn(false)]
xs[0] = kn(false)
const v = xs[0]
if v == null { print("N") } else { print("other") }
