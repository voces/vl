// @run
// @log 7
// @log 2.5
// @log 2.5
// @log 5
// @log s
// @log s
// @log 5
// A generic function stored in a field of a generic record alias at the enclosing T, with one
// instance and with two: the field's type is the alias applied at the instance (D3909).
type R<V> = { f: (v: V) => void }
type P<V, W> = { f: (v: V) => void, g: (w: W) => void }
function b<U>(y: U) { print(y) }
function a<T>(x: T) {
  const r: R<T> = { f: b }
  r.f(x)
  const p: P<T, i32> = { f: b, g: b }
  p.f(x)
  p.g(5)
}
function one<T>(x: T) {
  const r: R<T> = { f: b }
  r.f(x)
}
one(7)
a(2.5)
a("s")
