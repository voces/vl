// @run
// @log 1
// @log true
// @hint redundant type annotation: `pa` is inferred as `{a: i32}[]`
// @hint redundant type annotation: `qa` is inferred as `{a: boolean}[]`
// D8240's annotated spelling: lists of a generic record constructor's `i32` and `boolean` pins,
// each bound under its record list type, build as ref lists.

function pc<T>(x: T) { { a: x } }
const pa: { a: i32 }[] = [pc(1)]
const qa: { a: boolean }[] = [pc(true)]
print(pa[0].a)
print(qa[0].a)
