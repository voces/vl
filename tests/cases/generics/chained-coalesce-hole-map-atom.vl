// D3424: a `??` chained over a `??` of two reads of a hole's `K | null` map prints the member
// text, not the atom id, for a miss, a hit, the `<T>` spelling and a bound inner result.
// @run
// @log a
// @log b
// @log a
// @log b
type AB = "a" | "b"
type R = { m: {[i32]: AB | null} }
function mk(): R {
  const m: {[i32]: AB | null} = Map()
  m[3] = "b"
  { m: m }
}
function use(p) {
  print((p.m[9] ?? p.m[8]) ?? "a")
  print((p.m[9] ?? p.m[3]) ?? "a")
}
function useT<T>(p: T) { print((p.m[9] ?? p.m[8]) ?? "a") }
function bound(p) {
  const x = p.m[9] ?? p.m[3]
  print(x ?? "a")
}
use(mk())
useT(mk())
bound(mk())
