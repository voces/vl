// @run
// @log 1
// @log ORDER 1
// @log INDEXOF 1
// @log MAP 1
// @log NESTED 1
// @warning Unused parameter
// @warning Unused parameter
// @warning Unused parameter
// @warning Unused parameter
// @hint redundant type annotation: `two` is inferred as `i32`
// @hint redundant type annotation: `bareFirst` is inferred as `i32`
// A generic instance carrying BOTH `T[]` and `T` at a nullable-ref element (D1896). The
// `T[]` argument binds `T` to its element name, and that binding was stored with the
// grouping parens the array spelling needs — so a bare `T` parameter pinned `(S|null)`, a
// spelling nothing interns, and the signature's valtype had no shape row.
//
// The binding is the UNGROUPED element now, and every `[]` put back on it goes through
// `arrElemSuffixed`. Both parameter ORDERS are here because each used to fail with its own
// sentence: `T[]` first refused `ref valtype with no interned shape`, `T` first refused
// `array value does not match any array member of the union`.
//
// The `: i32` returns keep their declared hint rather than being removed: an un-annotated
// return routes the instance through return inference, which is a different path.
import { indexOf } from "std:array"
import { toString } from "std:fmt"

type S = { w: i32 }

function mk(i: i32): S | null {
  if i == 0 { return null }
  { w: i }
}

function two<T>(xs: T[], t: T): i32 { return 1 }

function listFirst() {
  const rs = [mk(1)]
  print(two(rs, mk(2)))
}
listFirst()

function bareFirst<T>(t: T, xs: T[]): i32 { return 1 }

function orderFlipped() {
  const rs = [mk(1)]
  print("ORDER " + toString(bareFirst(mk(2), rs)))
}
orderFlipped()

function viaIndexOf() {
  const rs = [mk(1), mk(2)]
  const rd = mk(2)
  print("INDEXOF " + toString(rs.indexOf(rd)))
}
viaIndexOf()

function mkM(i: i32): {[string]: i32} | null {
  if i == 0 { return null }
  Map()
}

function nullableMapElem() {
  const ms = [mkM(1)]
  print("MAP " + toString(two(ms, mkM(2))))
}
nullableMapElem()

function mkR(i: i32): i32[][] | null {
  if i == 0 { return null }
  [[i]]
}

function nestedListElem() {
  const rs = [mkR(1)]
  print("NESTED " + toString(two(rs, mkR(2))))
}
nestedListElem()
