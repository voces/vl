// @run
// @warning Unused variable `g` (prefix with `_` to suppress, or remove it)
// @log ok
// @log ok
// @log ok
// A lambda in a generic body returning `[t]` beside `[1]` is typed at the join of both returns
// at each pin, so its body is valid whether or not it is called (D2894).
function k<T>(t: T) {
  const g = (c: boolean) => {
    if c { return [t] }
    [1]
  }
  print("ok")
}
k(3)
k("s")
k(2.5)
