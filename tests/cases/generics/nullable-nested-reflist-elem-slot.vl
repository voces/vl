// @run
// @log 2
// @log 1
// @hint redundant type annotation: `ss` is inferred as `string[][][]` — remove it to lean on inference
// @hint redundant type annotation: `rs` is inferred as `(i32[][] | null)[]` — remove it to lean on inference
// @hint redundant type annotation: `rd` is inferred as `i32[][] | null` — remove it to lean on inference
// A `(i32[][] | null)[]` read UN-narrowed inside a monomorphized generic: `self[i]` and
// `needle` both name a NULLABLE ref list, which neither the nested-array rung (the name does
// not end `[]`) nor the grouped `(i32[][]|null)` param spelling could decompose. The element
// name went unresolved and the slot read borrowed row 0 — right only while row 0 happens to
// be this list's. `ss` displaces it, so the borrow is a check-clean invalid module. D1835.
// The hints were right and the MONOMORPHIZER was wrong: dropping the annotations refused
// until D1836 gave the mono argument reader the grouping rule the arena renderer already had.
// `nullable-nested-reflist-elem-slot-inferred.vl` is that face.

import { indexOf } from "std:array"

function mkS(): string[][] { [["a"]] }

function mkR(i: i32): i32[][] | null {
  if i == 0 { return null }
  [[i]]
}

function nulRefListCells() {
  const ss: string[][][] = [mkS(), mkS()]
  print(ss.length)
  const rs: (i32[][] | null)[] = [mkR(1), mkR(2)]
  const rd: i32[][] | null = mkR(2)
  print(rs.indexOf(rd))
}

nulRefListCells()
