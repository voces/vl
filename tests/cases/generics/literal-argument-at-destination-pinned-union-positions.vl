// @run
// @log 2.5999999046325684
// @log -2.5
// @log 5
// @log -7
// @log true
// @log 7
// @log 7.5
// @log 7
// @log 1.5
// @log 9
// A literal argument binding a type parameter that only its destination fixes takes the
// destination's union element as that parameter. Each literal is built at the union's one number
// and boxed under it: a nullable float, a negated literal, a wide integer, a union with a string.
import { filled } from "std:array"

function one<T>(v: T): T[] { return [v] }
function two<T>(v: T, w: T): T[] { return [v, w] }

const f: (f32 | null)[] = one(2.5)
print((f[0] ?? 0.0) + 0.1)
const neg: (f64 | null)[] = one(-2.5)
print(neg[0] ?? 0.0)
const wide: (i64 | null)[] = one(5)
print(wide[0] ?? 0)
const negInt: (i32 | null)[] = one(-7)
print(negInt[0] ?? 0)
const mixed: (i32 | string)[] = filled(2, 7)
print(mixed[0] is i32)
print(mixed[1])
const floatStr: (f64 | string)[] = filled(2, 7.5)
print(floatStr[1])
const wideBool: (i64 | boolean)[] = filled(1, 7)
print(wideBool[0])
const pair: (f32 | null)[] = two(1.5, null)
print(pair[0] ?? 0.0)
print(pair[1] ?? 9.0)
