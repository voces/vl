// @check
// @error cannot index non-array boolean[] | i32[]
// D2800: the join of a type parameter's list and `i32[]` is the union at `T := boolean`, as at
// `T := string`, so indexing the call without narrowing it is refused.
function h<T>(c: boolean, t: T) {
  if c { return [t] }
  [1]
}
print(h<boolean>(false, false)[0])
