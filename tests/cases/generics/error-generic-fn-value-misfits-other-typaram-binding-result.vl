// @check
// @error cannot assign <T>(T) => string to 'b' of type <T>(T) => T (parameter `a1` of `mid`, used at
// A generic function value whose result does not follow its parameter is refused at a binding
// annotated with another type parameter whose generic function keeps it, though that type
// parameter is never closed by a call (D17322).
function same<T>(k: T): T { return k }
function twice<T>(_k: T): string { return "tw" }
function mid<F, G>(a: F, a1: G) {
  let b: F = a1
  print(a("x"))
  print(b(3))
}
mid(same, twice)
