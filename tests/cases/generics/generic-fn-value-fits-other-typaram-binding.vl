// @run
// @log x
// @log 1
// @log y
// @log 2
// @log z
// @log 3
// @log v
// @log 4
// @hint Intentionally-unused parameter `_u`
// @hint Intentionally-unused parameter `_b`
// @hint Intentionally-unused variable `_b`
// @hint Intentionally-unused variable `_b`
// @hint Intentionally-unused variable `_b`
// @hint Intentionally-unused variable `_b`
// A generic function value that fits a binding annotated with another type parameter's generic
// function type is accepted: the same signature, a renamed type parameter, two type parameters,
// the `const` spelling, and a value-returning generic into a `void` one (D17322's controls).
function same<T>(k: T): T { return k }
function twice<T>(k: T): T { return k }
function pair<U>(k: U): U { return k }
function fst<T, U>(k: T, _u: U): T { return k }
function pick<A, B>(a: A, _b: B): A { return a }
function mid<F, G>(a: F, a1: G) {
  let _b: F = a1
  print(a("x"))
  print(a(1))
}
function midConst<F, G>(a: F, a1: G) {
  const _b: F = a1
  print(a("y"))
  print(a(2))
}
function mid2<F, G>(a: F, a1: G) {
  let _b: F = a1
  print(a("z", 1))
  print(a(3, "w"))
}
function inner<U>(u: U) { print(u) }
function retV<V>(v: V): V { return v }
function midVoid<F, G>(a: F, a1: G) {
  let _b: F = a1
  a("v")
  a(4)
}
mid(same, twice)
midConst(same, pair)
mid2(fst, pick)
midVoid(inner, retV)
