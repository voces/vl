// @run
// @log y
// @log n
// @log green!
// @log 2.5
// A `new string` brand meeting a HOLE parameter. `nomBinMixes` decided the brand question
// against an operand whose type was still a hole, so it refused a body whose annotated
// spelling runs; the pin is where both operands are concrete, and it now asks the same
// question there — the deferral and its mirror are one change (D1747).
//
// The hole parameters are load-bearing: annotate any of them and the refusal was never
// reached. `tests/cases/generics/error-newtype-brand-mix-at-pin.vl` is the other half —
// two DIFFERENT brands must still be refused, and it is refused at the pin now.

type S = new string
type F = new f64

const sv: S = "green"
const fv: F = 1.5

function eq(a) {
  if a == sv { print("y") } else { print("n") }
}

function lt(a) {
  if a < sv { print("y") } else { print("n") }
}

function cat(a) { print(a + "!") }

function add(a) { print(a + 1.0) }

eq(sv)
lt(sv)
cat(sv)
add(fv)
