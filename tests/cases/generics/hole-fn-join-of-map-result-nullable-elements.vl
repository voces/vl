// D10794: a join of a hole function's `.map` result over nullable elements reads each element
// at the instance's own list type, through a loop, an index and a `match` join alike.
function t(x) {
  const c = 1 > 0
  const m = [x].map((e) => {
    if e != null { return e }
    return null
  })
  const n = if c { m } else { m }
  for y in n { print(y) }
  print(n[0])
}
function u(x) {
  const m = [x].map((e) => {
    if e != null { return e }
    return null
  })
  const k = 1
  const n = match k {
    1 => m
    _ => m
  }
  print(n[0] == null)
}
const a: string | null = null
const v: string | null = "v"
const b: i32 | null = null
t(a)
u(a)
t(v)
t(4)
t(b)
t("s")
u(b)
