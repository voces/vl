// @error argument of type string flows into `k` expecting i32 (the call's argument types)
// @error argument of type string[] flows into `k` expecting i32[] (the call's argument types)
// @error argument of type string flows into `k` expecting i32 (the call's argument types)
// A call through a binding typed with the body's `T`, a lambda over `T`, a function-typed
// parameter or a nested function over `T` takes that `T`: an argument of another type
// parameter is judged at each instance, as the direct call is (D6483).
function h<T>(x: T) { print(x) }
function f<T, U>(_a: T, b: U) { const k: (x: T) => void = h; k(b) }
f(1, "s")
function f2<T, U>(_a: T, b: U) { const k = (x: T) => print(x); k(b) }
f2(1, "s")
function f3<T, U>(k: (x: T) => void, b: U) { k(b) }
f3((x: i32) => print(x), "s")
function f4<T, U>(_a: T, b: U) {
  function k(x: T) { print(x) }
  k(b)
}
f4(1, "s")
function f5<T, U>(_a: T, b: U[]) {
  const k: (x: T[]) => void = (xs) => print(xs.length); k(b)
}
f5(1, ["s"])
function f6<T, U>(_a: T, b: U) { const k: (x: T) => void = h; k(b) }
function o<A, B>(a: A, b: B) { f6(a, b) }
o(1, "s")
