// @run
// D1693 — a null-narrowing INSIDE a body the pin re-checks, at the three floors D691's
// deferred tables re-ask: index, `.length`, and `operator +`. Every pair below is emitted
// twice, once through an un-annotated parameter (the monomorphization pin) and once written
// out at the concrete type, and the two must agree.
//
// The pin has no narrowing state of its own, so before this fixture it asked each floor about
// the SUBSTITUTED parameter type — `A[] | null` for a receiver the body had already proved
// non-null — and refused a program whose direct spelling runs. Both narrowing spellings are
// here because they reach the floor differently: `!= null` is a flow fact the body collects,
// `?? []` is the operator's own result type, and the second was the sharper miss (the sentence
// named `A[] | null` for a receiver whose type after `??` is `A[]`).
//
// THE ELEMENT REPS ARE THE OTHER HALF. The narrowed value's rep is read at the pin, not off
// its declaration, so a string list, an f64 list and a boolean list each land on a different
// classifier; before this fixture the first two were check-clean invalid wasm and the third
// printed `1` for `true`. The refusals that must SURVIVE — the same bodies with no narrowing
// at all — are `error-narrowed-nullable-at-pin.vl`.

// @log 4
// @log 4
// @log 1
// @log 1
// @log 4
// @log 4
// @log 5
// @log 5
// @log 6
// @log 6
// @log hi
// @log hi
// @log 1.5
// @log 1.5
// @log true
// @log true

type A = { r: i32 }
function mkA(): A[] | null { return [{ r: 4 }] }
function mkN(): i32 | null { return 4 }
function mkS(): string[] | null { return ["hi"] }
function mkF(): f64[] | null { return [1.5] }
function mkB(): boolean[] | null { return [true] }

// index, `!= null`
function idxPinned(a) {
  const l = a.xs
  if l != null { print(l[0].r) } else { print(0) }
}
idxPinned({ xs: mkA() })
const dIdx = mkA()
if dIdx != null { print(dIdx[0].r) } else { print(0) }

// `.length`, `!= null`
function lenPinned(a) {
  const l = a.xs
  if l != null { print(l.length) } else { print(0) }
}
lenPinned({ xs: mkA() })
const dLen = mkA()
if dLen != null { print(dLen.length) } else { print(0) }

// index, `?? []` — the receiver's type after the operator is `A[]`
function coalPinned(a) {
  const l = a.xs ?? []
  print(l[0].r)
}
coalPinned({ xs: mkA() })
const dCoal = mkA() ?? []
print(dCoal[0].r)

// `operator +`, `!= null`, over the bare parameter rather than a field
function plusPinned(v) {
  if v != null { print(v + 1) } else { print(0) }
}
plusPinned(mkN())
const dPlus = mkN()
if dPlus != null { print(dPlus + 1) } else { print(0) }

// `operator +`, `?? 0`
function plusCoalPinned(v) {
  const w = v ?? 0
  print(w + 2)
}
plusCoalPinned(mkN())
const dPlusCoal = mkN() ?? 0
print(dPlusCoal + 2)

// the element reps: a string list, an f64 list, a boolean list
function strPinned(a) {
  const l = a.ss
  if l != null { print(l[0]) } else { print("no") }
}
strPinned({ ss: mkS() })
const dStr = mkS()
if dStr != null { print(dStr[0]) } else { print("no") }

function f64Pinned(a) {
  const l = a.fs
  if l != null { print(l[0]) } else { print(0.0) }
}
f64Pinned({ fs: mkF() })
const dF64 = mkF()
if dF64 != null { print(dF64[0]) } else { print(0.0) }

function boolPinned(a) {
  const l = a.bs
  if l != null { print(l[0]) } else { print(false) }
}
boolPinned({ bs: mkB() })
const dBool = mkB()
if dBool != null { print(dBool[0]) } else { print(false) }
