// @check
// @error-at 13:14 union members 'Handle<Texture>' and 'Handle<Mesh>' have the same runtime representation, so `is` cannot tell them apart — a nominal newtype is erased to its base at run time
// @error-at 20:27 Handle<Mesh> doesn't fit in Handle<Texture>
// @error-at 21:11 argument 1: expected Handle<Texture>, got i32
// @error-at 21:20 argument 1: expected Box<i32>, got {v: i32, n: i32}
// Two instances of a generic `new` type are different brands, a bare base or a structural
// variable is neither, and `is` cannot tell two instances apart at run time (A14 (a)).
type Texture = { t: i32 }
type Mesh = { m: i32 }
type Handle<T> = new i32
type Box<T> = new { v: T, n: i32 }
function load(h: Handle<Texture>): i32 { return h as i32 }
function val(b: Box<i32>): i32 { return b.v }
function k(x: Handle<Texture> | Handle<Mesh>): i32 {
  if x is Handle<Texture> { return 1 }
  return 2
}
const g = 4 as Handle<Mesh>
const n: i32 = 5
const r = { v: n, n: 0 }
const w: Handle<Texture> = g
print(load(n) + val(r) + load(w) + k(g))
