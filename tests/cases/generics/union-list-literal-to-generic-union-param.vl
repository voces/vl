// @hint redundant type annotation: `n` is inferred as `i32`
// @run
// @log 2
// @log 2
// @log 2
// @log 12
// @log w
// @log 1
// @log 4
// @log 2
// @log true
// D10931: a union-element list literal that spells a record arm by shape, handed to a generic
// `(S | T)[]` parameter, boxes and narrows its elements at the instance's own union.
type S = { g: i32 }

function n<T>(v: (S | T)[]): i32 { v.length }

function f<T>(v: (S | T)[], z: T): T {
  let r = z
  let k = 0
  for e in v {
    if e is S { k = k + e.g } else { r = e }
  }
  print(k)
  r
}

const a = [{ g: 1 }, 3]
print(n<i32>(a))
print(n(a))
print(n([{ g: 1 }, "a"]))
const v = [{ g: 5 }, "q", { g: 7 }, "w"]
print(f(v, ""))
print(f([3, { g: 1 }, 4], 0))
function main() {
  const w = [{ g: 2 }, true]
  print(f(w, false))
}
main()
