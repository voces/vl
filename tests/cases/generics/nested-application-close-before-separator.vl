// @run
// @log 1
// @log 3
// @log 7
// @log 11
// @log 19
// @log 3
// @log 29
// @log 4
// @log 2
// @log 0
// A nested generic application closed by a fused `>>` or `>>>`, followed by the separator of
// the ENCLOSING list (D2534). The fused token banks a `>` the outer application still owes, so
// the `,` after it is not one more type argument: it separates fields, parameters, or the
// arguments of a further-out application. Each cell is one such list; the last is the control,
// a trailing comma inside the application, which is still tolerated.
type R = { a: i32 }
type B<T> = { v: T }
type P<A, C> = { a: A, c: C }

// Record field: `>>` then `,` then another field — the filed witness.
type F = { parts: Map<string, Map<string, R>>, rc: i32 }
const f: F = { parts: Map(), rc: 1 }
print(f.rc)

// Function parameter: `>>` then `,`.
function byMap(m: Map<string, Map<string, i32>>, n: i32) { m.length + n }
print(byMap(Map(), 3))

// `>>>` closes three levels and banks two; the `,` must survive both drains.
function three(m: B<B<B<i32>>>, n: i32) { m.v.v.v + n }
print(three({ v: { v: { v: 4 } } }, 3))

// Type argument of a further-out application: `P<B<B<i32>>, i32>`.
const p: P<B<B<i32>>, i32> = { a: { v: { v: 5 } }, c: 6 }
print(p.a.v.v + p.c)

// `>>>` then `,` in a record field.
type F3 = { x: B<B<B<i32>>>, y: i32 }
const f3: F3 = { x: { v: { v: { v: 9 } } }, y: 10 }
print(f3.x.v.v.v + f3.y)

// Function-type parameter list, and the lambda's own parameter list.
function apply(fn: (a: B<B<i32>>, b: i32) => i32) { fn({ v: { v: 1 } }, 2) }
print(apply((a: B<B<i32>>, b: i32) => a.v.v + b))

// Explicit type arguments at a call: `>>` then `,`, then `>>` closing the call's list.
function id<T>(x: T): T { x }
const w = id<P<B<B<i32>>, i32>>({ a: { v: { v: 14 } }, c: 15 })
print(w.a.v.v + w.c)

// `>>` before `=` in an initialiser, then `>>` before `)`.
const u: B<B<i32>> = { v: { v: 4 } }
print(u.v.v)
function unwrap(b: B<B<i32>>) { b.v.v }
print(unwrap({ v: { v: 2 } }))

// The control: a trailing comma inside the application, closed by a plain `>`.
const t: Map<string, Map<string, i32>,> = Map()
print(t.length)
