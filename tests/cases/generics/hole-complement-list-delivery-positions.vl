// @run
// @log a
// @log a
// @log 3
// @log 3
// @log -1
// @log 3
// @log b
// @log 3
// @log c
// @log 1
// The return of a hole function joining `[t, t]` with `[1, 2, 3]` keeps the two lists apart,
// as `w<T>` does, so the complement of `is i32[]` over it is the pin's list: returned as a tail,
// bound at the top level, read for its length and tested at a `boolean` pin.
function w(t, b: boolean) {
  if b { return [t, t] }
  [1, 2, 3]
}

function ret(t, b: boolean) {
  const v = w(t, b)
  if v is i32[] { return [t] }
  v
}

function size(t, b: boolean) {
  const v = w(t, b)
  if v is i32[] { return v.length }
  0 - 1
}

function wt<T>(t: T, b: boolean) {
  if b { return [t, t] }
  [1, 2, 3]
}

function retT<T>(t: T, b: boolean) {
  const v = wt(t, b)
  if v is i32[] { return [t] }
  v
}

print(ret("a", false)[0])
print(ret("a", true)[1])
print(w("a", false).length)
print(size("a", false))
print(size("a", true))
const top = w("b", false)
if top is i32[] { print(top[2]) } else { print(top[0]) }
print(w("b", true)[0])
const flag = w(true, false)
if flag is i32[] { print(flag[2]) } else { print("bool") }
print(retT("c", true)[0])
print(retT(2, true).length)
