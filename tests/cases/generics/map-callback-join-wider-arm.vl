// @run
// A `.map` callback joining its element with an `f64` at an `i32` pin builds the `f64` list its
// readers take: iterated, indexed in a hole body, returned, and behind a narrowing test (D3188).
function each<T>(x: T) {
  const n = [x].map((e) => {
    if 1 > 2 { return e }
    return 1.5
  })
  for y in n { print(y) }
}
function hole(x) {
  const n = [x].map((e) => {
    if 1 > 2 { return e }
    return 1.5
  })
  print(n[0])
}
function ret<T>(x: T) {
  return [x, x].map((e) => {
    if 1 > 2 { return e }
    return 1.5
  })
}
function same<T>(x: T) {
  const n = [x].map((e) => {
    if e == x { return e }
    return 1.5
  })
  for y in n { print(y) }
}

each(4)
hole(4)
const r = ret(4)
print(r[1] + 1.0)
same(4)
// @log 1.5
// @log 1.5
// @log 2.5
// @log 4
