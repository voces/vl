// @run
// @log 1
// @log 1
// @log 11
// A list of a union a pin mints, stored into a record field the pin mints too, is built at its
// union's rep: the rep is read after the pin registers the union (D16953).
type IM = {[i32]: i32}
type R = { r: i32 }
function g<V>(x: IM) {
  const xs: (V | IM)[] = [x]
  const b: { v: (V | IM)[], k: i32 } = { v: xs, k: 1 }
  return b.v.length
}
function r<V>(x: R) {
  const xs: (V | R)[] = [x]
  const b: { v: (V | R)[] } = { v: xs }
  return b.v.length
}
const m: IM = Map()
m[1] = 11
print(g<string>(m))
print(r<string>({ r: 1 }))
function h<V>(x: IM) {
  const xs: (V | IM)[] = [x]
  const b: { v: (V | IM)[] } = { v: xs }
  const e = b.v[0]
  if e is IM { print(e[1] ?? -1) }
  return 0
}
h<string>(m)
