// @run
// @log 1
// @log q
// @log 2
// @log s
// @log 1
// @log s
// @log q
// @log 2
// @log q
// @log 2
// @log iu
// @log 8
// @log 8
// @log 8
// @log w
// A union boxed in both member orders, declared (`A | B` beside `B | A`) and over scalars
// (`i32 | string` beside `string | i32`), read through a generic instance, a list element, a
// returned value and a pinned parameter. Each read finds its own arm whichever order named it.
type A = { a: i32 }
type B = { b: string }
type AB = A | B
type BA = B | A
function id<T>(x: T): T { return x }
function first<T>(xs: T[]): T { return xs[0] }
function showAB(u: AB) {
  if u is A { print(u.a) } else { print(u.b) }
}
function showBA(u: BA) {
  if u is A { print(u.a) } else { print(u.b) }
}
function wrapAB(x: AB): AB { return x }
function wrapBA(x: BA): BA { return x }
const p: AB = { a: 1 }
const q: AB = { b: "q" }
const r: BA = { a: 2 }
const s: BA = { b: "s" }
showAB(id(p))
showAB(id(q))
showBA(id(r))
showBA(id(s))
const xs: AB[] = [p, q]
const ys: BA[] = [s, r]
showAB(first(xs))
showBA(first(ys))
showAB(wrapAB(id(q)))
showBA(wrapBA(id(r)))
function pick<T>(c: boolean, x: T, y: T): T { return if c { x } else { y } }
showAB(pick(false, p, q))
showBA(pick(false, s, r))
const iu: i32 | string = "iu"
const ui: string | i32 = 7
function showIU(v: i32 | string) {
  if v is i32 { print(v + 1) } else { print(v) }
}
function showUI(v: string | i32) {
  if v is i32 { print(v + 1) } else { print(v) }
}
showIU(id(iu))
showUI(id(ui))
const zs: (string | i32)[] = [ui, "z"]
showUI(first(zs))
showIU(id(7))
showUI(id("w"))
