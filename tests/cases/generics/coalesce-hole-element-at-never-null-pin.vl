// @run
// @log 4
// @log 7
// @log 5
// @log 8
// @log 2
// @log 6.5
// @log 2.5
// @log 0.25
// @log 4
// @log 7
// @log 5
// @log 3
// @log 1.5
// @log 7
// @log 1.5
// @log 3
// @log 4
// @log 7
// A `??` over a list element or record field of a hole, called at a nullable pin and at a
// never-null one, is the element or field itself at the never-null pin (D9915).
function take(a, d) { print(a[1] ?? d) }
const l: (i32 | null)[] = [null, 4]
take(l, 1.5)
const k = [3, 7]
take(k, 9)
const li: (i64 | null)[] = [null, 5]
take(li, 9)
const ki: i64[] = [3, 8]
take(ki, 9)
const lf: (f64 | null)[] = [null, null]
take(lf, 2)
const kf = [3, 6.5]
take(kf, 9)
const lg: (f32 | null)[] = [null, null]
take(lg, 2.5)
const kg: f32[] = [3, 0.25]
take(kg, 9)
function gen<T>(a: T[], d: f64) { print(a[1] ?? d) }
gen(l, 1.5)
gen(k, 9)
function back(a, d) { return a[1] ?? d }
const b1 = back(l, 1.5)
print(b1 + 1)
const b2 = back(k, 9)
print(b2 / 2)
function bind(a, d) {
  const x = a[0][1] ?? d
  print(x)
}
const ln: (i32 | null)[][] = [[null, null]]
bind(ln, 1.5)
const kn: i32[][] = [[3, 7]]
bind(kn, 9)
function fld(r, d) {
  const x = r.v ?? d
  return x
}
const rn: { v: i32 | null } = { v: null }
print(fld(rn, 1.5))
const rk: { v: i32 } = { v: 7 }
print(fld(rk, 9) / 2)
function pass(a, d) { return back(a, d) }
print(pass(l, 2.5))
print(pass(k, 9))
