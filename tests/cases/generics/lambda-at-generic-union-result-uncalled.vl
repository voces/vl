// A lambda handed to a generic's union-result function type, in each delivery position, with the
// function never called: the adapter still returns the instance's union box (D16899, D14082).
function listS0<T>(fs: (() => T | string)[]) { return fs.length }
print(listS0([() => 5]))
function oneS0<T>(f: () => T | string) { return [f].length }
print(oneS0(() => 5))
function recS0<T>(r: {g: () => T | string}) { return [r.g].length + 1 }
print(recS0({ g: () => 5 }))
function nulS0<T>(g: (() => T | string) | null) {
  return if g == null { 0 } else { 3 }
}
print(nulS0(() => 5))
function nulListS0<T>(fs: ((() => T | string) | null)[]) {
  return fs.length + 3
}
print(nulListS0([() => 5]))
function nestedS0<T>(fs: (() => T | string)[][]) { return fs[0].length + 4 }
print(nestedS0([[() => 5]]))
function fiveS0() { return 5 }
print(listS0([fiveS0]))
function outerS0(n: i32) { print(listS0([() => n]) + 5) }
outerS0(1)
function wideS0<T>(fs: (() => T | f64 | string)[]) { return fs.length + 6 }
print(wideS0([() => 5]))
function argS0<T>(fs: ((x: i32) => T | string)[]) { return fs.length + 7 }
print(argS0([(x) => x]))
function extraS0<T>(fs: (() => T | string)[], x: T) {
  return fs.length + [x].length + 7
}
print(extraS0([() => 5], 1))
function listS1<T>(fs: (() => T | {a: i32})[]) { return fs.length }
print(listS1([() => 5]))
function oneS1<T>(f: () => T | {a: i32}) { return [f].length }
print(oneS1(() => 5))
function recS1<T>(r: {g: () => T | {a: i32}}) { return [r.g].length + 1 }
print(recS1({ g: () => 5 }))
function nulS1<T>(g: (() => T | {a: i32}) | null) {
  return if g == null { 0 } else { 3 }
}
print(nulS1(() => 5))
function nulListS1<T>(fs: ((() => T | {a: i32}) | null)[]) {
  return fs.length + 3
}
print(nulListS1([() => 5]))
function nestedS1<T>(fs: (() => T | {a: i32})[][]) { return fs[0].length + 4 }
print(nestedS1([[() => 5]]))
function fiveS1() { return 5 }
print(listS1([fiveS1]))
function outerS1(n: i32) { print(listS1([() => n]) + 5) }
outerS1(1)
function wideS1<T>(fs: (() => T | f64 | {a: i32})[]) { return fs.length + 6 }
print(wideS1([() => 5]))
function argS1<T>(fs: ((x: i32) => T | {a: i32})[]) { return fs.length + 7 }
print(argS1([(x) => x]))
function extraS1<T>(fs: (() => T | {a: i32})[], x: T) {
  return fs.length + [x].length + 7
}
print(extraS1([() => 5], 1))
