// @run
// @hint redundant type annotation: `count` is inferred as `i32`
// @log 1
// @log 2
// @log 7
// D8321's annotated face: the parameter names the record list, so no pin is taken from the
// argument; it must keep agreeing with the un-annotated spelling.
function pc<T>(x: T) { { a: x } }
function g(v: { a: i32 }[]) { print(v[0].a) }
g([pc(1)])
function h(v: { a: i32 }[]): { a: i32 } { v[0] }
print(h([pc(2)]).a)
function count(ws: { v: i32 }[]): i32 { return ws.length }
print(h([{ a: 6 }]).a + count([{ v: 7 }]))
