// @run
// @log 3
// @log 1
// @log 5
// @log 0
// @log 8
// @log 11
// @log hi
// List, map and function members over `T`, and a `match` over a record arm that holds `T`.
type R<T> = T[] | { one: T }
function count(r: R<i32>) {
  if r is { one: i32 } { return 1 }
  return r.length
}
print(count([1, 2, 3]))
print(count({ one: 9 }))

type M<T> = { [string]: T } | string
function show(m: M<i32>) {
  if m is string { return 0 }
  return m["a"] ?? 0
}
const mm: { [string]: i32 } = Map()
mm["a"] = 5
print(show(mm))
print(show("x"))

type F<T> = ((x: T) => T) | T
function apply(f: F<i32>, v: i32): i32 {
  if f is i32 { return f }
  return f(v)
}
print(apply((x: i32) => x * 2, 4))
print(apply(11, 4))

type K<T> = { a: T } | { b: i32 }
const k: K<string> = { a: "hi" }
match k {
  { a: string } => print(k.a)
  { b: i32 } => print("b")
}
