// @run
// @log 4
// @log 4
// @log s
// @log 4
// @log 6
// @log 4
// @log 2
// @hint redundant type annotation: `g` is inferred as `() => i32` — remove it to lean on inference
// @hint redundant type annotation: `h` is inferred as `() => string` — remove it to lean on inference
// A hole parameter bound to a function value hands it on to a generic's function-typed parameter
// at the function type its instance pinned it at (D10132).
function app<T>(f: () => T): T { f() }
const g: () => i32 = () => 4
const h: () => string = () => "s"
function take(a) { print(app(a)) }
take(g)
function pass(b) { take(b) }
pass(g)
take(h)
take(() => 4)
function appAt<T>(f: (n: i32) => T, x: i32): T { f(x) }
function twice(a) { print(appAt(a, 3)) }
twice((n: i32) => n * 2)
function cnt<T>(f: () => T[] | i32) {
  const t = f()
  if t is i32 { t } else { t.length }
}
const k: () => i32[] | i32 = () => [1, 2]
function count(a) { print(cnt(a)) }
take(() => 4)
count(k)
