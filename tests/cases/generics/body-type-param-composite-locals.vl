// @run
// @log 3
// @log s
// @log 7
// @log 4
// @log 9
// @hint redundant type annotation: `b` is inferred as `{item: T}` — remove it to lean on inference
// A generic body's annotated local at COMPOSITE shapes — the shapes `body-type-param.vl`
// does not reach. That fixture covers bare `T` and `T[]`; these ride the type parameter
// under a nested array, an inline object shape, and a nullable, which are the constructors
// where re-parsing the SUBSTITUTED SPELLING and substituting the TYPE can diverge.
//
// WHY THIS FILE EXISTS: the monomorphizer hands the substituted TYPE to the instance's
// `LetDecl` annotation instead of re-parsing the substituted name. A sabotage build that
// deliberately records the wrong type there leaves the whole 2,027-file corpus green except
// for two files — `generics/body-type-param.vl` and `modules/std-array-building/entry.vl`.
// Two files is thin cover for a type-recording path, and a clean corpus run over a
// population that small is not evidence that the recording is right. Each shape below was
// checked to FAIL against that sabotage build, so this file is cover rather than decoration.
type P = { v: i32 }

// A nested array of the type parameter: `T[][]`, plus the inner `T[]` it is built from.
function wrap<T>(v: T): T[][] {
  const out: T[][] = []
  const inner: T[] = []
  inner.push(v)
  out.push(inner)
  return out
}

// An inline object shape whose FIELD rides the type parameter.
function boxed<T>(v: T): { item: T } {
  const b: { item: T } = { item: v }
  return b
}

// A nullable riding the type parameter.
function firstOrNull<T>(self: T[]): T | null {
  const x: T | null = self[0]
  return x
}

print(wrap(3)[0][0])            // 3
print(wrap("s")[0][0])          // s
print(boxed(7).item)            // 7
print(boxed({ v: 4 }).item.v)   // 4
const n = firstOrNull([{ v: 9 }])
if n != null { print(n.v) }     // 9
