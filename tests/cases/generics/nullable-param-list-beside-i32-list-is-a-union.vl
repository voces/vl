// @run
// @log 8
// @log true
// @log 8
// @log q
// @log 5
// @log 8
// A return set's `(T | null)[]` beside an `i32[]` stays the union at every pin, as `T[]` beside
// `i32[]` does, so the `i32` arm reads as numbers (D2858).
function h<T>(c: boolean, t: T) {
  if c { return [null, t] }
  [7, 8, 9]
}
const v = h(false, true)
if v is (boolean | null)[] { print(v[1]) } else { print(v[1]) }
const w = h(true, true)
if w is (boolean | null)[] { print(w[1]) } else { print(w[1]) }
const s = h(false, "q")
if s is (string | null)[] { print(s[1]) } else { print(s[1]) }
const s2 = h(true, "q")
if s2 is (string | null)[] { print(s2[1]) } else { print(s2[1]) }
const n = h(true, 5)
print(n[1])
function g<T>(c: boolean, t: T): (T | null)[] | i32[] {
  if c { return [null, t] }
  [7, 8, 9]
}
const a = g(false, true)
if a is (boolean | null)[] { print(a[1]) } else { print(a[1]) }
