// @run
// @log 1.5
// @log 1.5
// @info `v` is never reassigned; use `const` instead of `let`
// A local alias of a map parameter, read for a function value the map's inferred type holds, is
// read at each instance's map, as the read on the parameter is (D16807).
function half(a) { return a / 2.0 }
const m4 = Map()
m4.set("a", half)
function take(a) {
  const v = a
  const h = v.get("a")
  if h != null { print(h(3)) }
}
function viaChain(a) {
  const u = a
  let v = u
  const h = v.get("a")
  if h != null { print(h(3)) }
}
take(m4)
viaChain(m4)
