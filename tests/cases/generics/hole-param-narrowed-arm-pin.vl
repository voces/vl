// @run
// @log 8
// @log 8
// @log 8
// @log 8
// @log 8
// @hint redundant type annotation: `ann` is inferred as `A` — remove it to lean on inference

// D1754 — a narrowed struct arm delivered to an un-annotated (hole) parameter. The pin's
// narrowing rung compared the arm's spelling against the union's arms, and the two render
// differently: a narrowed object spells structurally (`{r:i32}`) while a union carries its
// arms' declared names. The test therefore missed on the SPELLING, the pin named the whole
// union, and `a.r` inside the instance had a box where it wanted a struct.
type A = { r: i32 }
type M = i32 | A

function st(): A { return { r: 8 } }

function mkInf(b: boolean) {
  if b { return st() }
  7
}

function mkDecl(b: boolean): M {
  if b { return st() }
  7
}

function take(a) { print(a.r) }

// The inferred union, whose arms have no alias of their own.
const p = mkInf(true)
if p is A { take(p) } else { print(0) }

// The declared union, whose pin is the alias `M`.
const d = mkDecl(true)
if d is A { take(d) } else { print(0) }

// The arm bound first and then delivered — the binding carries the arm since D1741, and the
// pin has to read it the same way.
const q = mkInf(true)
if q is A {
  const held = q
  take(held)
} else {
  print(0)
}

// The two spellings that always ran, as controls: a plain struct value, and the annotated
// bind of the same arm.
take(st())

const r = mkInf(true)
if r is A {
  const ann: A = r
  take(ann)
} else {
  print(0)
}
