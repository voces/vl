// @trap
// @hint redundant type annotation: `k` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `big` is inferred as `i64` — remove it to lean on inference
// `u as! i32` over a type parameter pinned at `i64` traps on a value outside i32's range, as the
// direct cast does, rather than wrapping it (D2791).
function k<T>(u: T): i32 { u as! i32 }
const big: i64 = 5000000000
print(k(big))
print(-1)
