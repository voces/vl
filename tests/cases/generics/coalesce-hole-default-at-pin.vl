// @run
// @log 0.75
// @log 0.75
// @log 7
// @log true
// @log 2.5
// @log 3
// @log 2
// @log s
// A `??` with a type-parameter default takes its type at the pin: a default that fits the
// left's face (`f64`, an `i32` that widens, the same `T`) keeps it, and one that does not
// joins it, so an un-annotated or union destination holds either (D3252).
function bind<T>(x: T) {
  const o: f64 | null = null
  const v: f64 = o ?? x
  return v / 4.0
}
function widen<T>(x: T) {
  const o: i32 | null = null
  const v: i32 | null = o ?? x
  return v
}
function same<T>(x: T): T {
  const o: T | null = null
  return o ?? x
}
function infer<T>(x: T) {
  const o: string | null = null
  const v = o ?? x
  return v
}
function live<T>(x: T): f64 {
  const o: f64 | null = 2.0
  return o ?? x
}
function union<T>(x: T) {
  const o: f64 | null = null
  const v: f64 | string = o ?? x
  return v
}
print(bind(3.0))
print(bind(3))
print(widen(7))
print(same(3 > 2))
print(same(2.5))
print(infer(3))
print(live(1.5))
print(union("s"))
