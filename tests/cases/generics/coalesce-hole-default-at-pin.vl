// @run
// @hint redundant type annotation: `v` is inferred as `f64` — remove it to lean on inference
// @hint redundant type annotation: `live` is inferred as `f64` — remove it to lean on inference
// @log 0.75
// @log 0.75
// @log 7
// @log true
// @log 2.5
// @log 2
// @log 3
// @log L
// A `??` with a type-parameter default is re-asked at the pin as the concrete `??` types it,
// and a pin the destination holds keeps running: a default that fits the left's face (`f64`,
// an `i32` that widens, the same `T`), a live left, and an un-annotated binding (D3252).
function bind<T>(x: T) {
  const o: f64 | null = null
  const v: f64 = o ?? x
  return v / 4.0
}
function widen<T>(x: T) {
  const o: i32 | null = null
  const v: i32 | null = o ?? x
  return v
}
function same<T>(x: T): T {
  const o: T | null = null
  return o ?? x
}
function live<T>(x: T): f64 {
  const o: f64 | null = 2.0
  return o ?? x
}
function infer<T>(x: T) {
  const o: string | null = null
  const v = o ?? x
  print(v)
  return 0
}
function joined<T>(x: T) {
  const o: string | null = "L"
  const v = o ?? x
  print(v)
  return 0
}
print(bind(3.0))
print(bind(3))
print(widen(7))
print(same(3 > 2))
print(same(2.5))
print(live(1.5))
infer(3)
joined(3)
