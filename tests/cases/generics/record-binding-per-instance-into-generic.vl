// @run
// @log s
// @log 7
// @log 7
// @log t
// @log u
// @log 9
// A record literal bound in a generic body and handed to another generic is built at its own
// instance's row, so the callee is monomorphized at that row (D3038, D13962); a generic's record
// result delivered as a literal's field has its row too (D10933).
function h(o) { o.k }
function g<T>(x: T): T {
  const o = { k: x, n: 1 }
  h(o)
}
print(g("s"))
print(g(7))

function readX(o) { o.x }
function viaBinding<T>(v: T) {
  const o = { x: v }
  readX(o)
}
print(viaBinding(7))
print(viaBinding("t"))

// A generic's record result as an un-annotated record literal's field, and the annotated
// spelling of the same delivery.
function mk<T>(x: T): { g: T } { return { g: x } }
const w = { f: mk("u") }
print(w.f.g)
const wa: { f: { g: i32 } } = { f: mk(9) }
print(wa.f.g)
