// @run
// @log true
// @log null
// @log true
// @log 5
// @log 7
// @log 2.5
// @log s
// Records of one row whose field functions differ call their own through a capture of the
// receiver, generic or hole, and a hole member call over a local argument reads its own
// record (D3141, D3168).
function F<Z>(z: Z) {
  const k = () => z.f()
  print(k())
}
const r0 = { f: () => true }
F(r0)
const r1 = { f: (): i32 | null => null }
F(r1)
function H(z) {
  const k = () => z.f()
  print(k())
}
H(r0)
const r2 = { f: (): i32 | null => 5 }
H(r2)
function M(z) { print(z.f()) }
function main() {
  const a = { f: () => 7 }
  M(a)
  const b = { f: () => 2.5 }
  M(b)
  const c = { f: () => "s" }
  M(c)
}
main()
