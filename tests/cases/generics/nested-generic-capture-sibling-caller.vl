// @hint Intentionally-unused parameter `_u` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_u` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_u` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_u` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_u` (leading `_` marks it unused)
// A nested generic capturing its enclosing function's parameter, called from a function or a
// lambda nested in a second instance of the enclosing function, calls that instance's copy,
// whose env holds the parameter at that instance's type (D3827).
function outer<T>(x: T) {
  function inner<U>(_u: U) { print(x) }
  function other() { inner(true) }
  other()
}
outer(7)
outer("s")
function viaLambda<T>(x: T) {
  function inner<U>(_u: U) { print(x) }
  const f = () => inner(1)
  f()
}
viaLambda(7)
viaLambda("s")
function deeper<T>(x: T) {
  function inner<U>(u: U) {
    print(x)
    print(u)
  }
  function mid() {
    function deep() { inner(2) }
    deep()
    inner("u")
  }
  mid()
}
deeper(7)
deeper("s")
function returned<T>(x: T): () => void {
  function inner<U>(_u: U) { print(x) }
  () => inner(0)
}
const r7 = returned(7)
const rs = returned("s")
r7()
rs()
function valued<T>(x: T) {
  function inner<U>(_u: U): T { x }
  function other(): T { inner(true) }
  print(other())
}
valued(7)
valued("s")
function underGeneric<T>(x: T) {
  function mid<V>(v: V) {
    function inner<U>(_u: U) {
      print(x)
      print(v)
    }
    function other() { inner(1) }
    other()
  }
  mid(1.5)
  mid("m")
}
underGeneric(7)
underGeneric("s")
