// @run
// @info `k` is never reassigned; use `const` instead of `let`
// @log 4
// @log q
// @log 5
// @log r
// @log 6
// @log s
// @log 2.5
// A generic function named as a value at a binding typed with the body's `T` runs at every
// instance of the body: a `const`, a `let`, and a `void` result (D6501).
function id<T>(x: T): T { return x }
function f<T>(a: T): T { const k: (x: T) => T = id; return k(a) }
print(f(4))
print(f("q"))
function g<T>(a: T): T { let k: (x: T) => T = id; return k(a) }
print(g(5))
print(g("r"))
function h<T>(x: T) { print(x) }
function v<T>(a: T) { const k: (x: T) => void = h; k(a) }
v(6)
v("s")
print(f(2.5))
