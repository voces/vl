// @run
// @log 3
// @log 3
// @log 2.5
// @log 7
// @log s
// D4032: a lambda parameter annotated `T[]` in a generic body, passed to a generic function,
// reads as a list at the inner call, so the call is pinned with the instance's element type.
import { reverse } from "std:array"

function rev<T>(self: T[]): T[] { self }
function first<T>(self: T[]): T { self[0] }
function len<T>(xs: T[]) {
  const k = (ys: T[]) => rev(ys).length
  k(xs)
}
function last<T>(xs: T[]): T {
  const k = (ys: T[]) => ys.reverse()[0]
  k(xs)
}
function head<T>(xs: T[]): T {
  const k = (ys: T[]) => first(ys)
  k(xs)
}
print(len([1, 2, 3]))
print(last([1, 2, 3]))
print(last([1.5, 2.5]))
print(head([7, 8]))
print(head(["s"]))
