// @run
// @log s
// @log n
// @log false
// @log 9
// @log 3
// @log n
// A declared `A | B` with a nullable pin is the nullable `string | null`, not a union holding a
// nullable member that `print` could not dispatch and `== null` built an unregistered box for (D3502).
const ns: string | null = "n"
const ni: i32 | null = null
function H<A, B>(k: i32, a: A, b: B): A | B {
  if k == 0 { return a }
  b
}
print(H(1, ns, "s"))
print(H(1, "s", ns))
const r = H(1, ns, "s")
print(r == null)
print(H(0, ni, 3) ?? 9)
print(H(1, ni, 3) ?? 9)
const q = H(0, ns, "s")
if q is string { print(q) } else { print(q == null) }
