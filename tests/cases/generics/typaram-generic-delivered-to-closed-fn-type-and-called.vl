// @run
// @info `b` is never reassigned; use `const` instead of `let`
// @log x
// @log 1
// @log x
// @log 1
// @log 1
// @log x
// @log y
// @log 1
// A generic bound to a type parameter, called at one type and handed to a parameter of a closed
// function type that calls it at another, takes each instance per use (D6741).
function same<T>(k: T): T { k }
function twice(f: (x: i32) => i32) { f(f(1)) }
function ss(f: (x: string) => string) { f("y") }
function mid<F, G>(a: F, a1: G) {
  let b: F = a1
  print(a("x"))
  print(twice(b))
}
function one<F>(a: F) {
  print(a("x"))
  print(twice(a))
}
function swapped<F>(a: F) {
  print(twice(a))
  print(a("x"))
}
function both<F>(a: F) {
  print(ss(a))
  print(twice(a))
}
mid(same, same)
one(same)
swapped(same)
both(same)
