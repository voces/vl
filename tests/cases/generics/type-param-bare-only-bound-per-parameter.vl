// @run
// @log 4
// @log x
// @log 2
// @log y
// @log 6
// @log z
// @log 8
// @log w
// @log 10
// @log 11
// A type parameter that only annotates parameters, handed different generics of one signature,
// binds per parameter: each parameter is called at two types (D15401), through a copy, a hand
// to a hole parameter, or a `const` alias of a generic.
function id<T>(x: T): T { x }
function dup<T>(x: T): T { x }
const g = dup
function take(f) { print(f("w")) }
function both<F>(a: F, c: F) {
  print(a(3) + 1)
  print(a("x"))
  print(c(2))
  print(c("y"))
}
both(id, dup)
function viaCopy<F>(a: F, c: F) {
  const b: F = a
  print(b(5) + 1)
  print(a("z"))
  print(c(8))
}
viaCopy(id, g)
function viaHole<F>(a: F, c: F) {
  take(a)
  print(a(9) + 1)
  print(c(11))
}
viaHole(dup, id)
