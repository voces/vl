// @run
// @log n
// @log q
// @log n
// @log q
// @log k
// @log m
// @log w
// @log 3
// @log z
// @log r
// @log 4
// A `??` over a binding typed by a union holding a type parameter is dead only where the
// instance's own type excludes null: the checker types the read at the template's `string`, and
// a `string | null` pin keeps the default live (D3421), for a `const`, a written `let` and a
// parameter, and the checker does not call those defaults dead (D14772).
function g<T>(x: T) {
  const s: T | string = x
  print(s ?? "n")
}
function w<T>(x: T, c: boolean) {
  let s: T | string = "k"
  if c { s = x } else { s = "k" }
  print(s ?? "n")
}
function p<T>(s: T | string) { print(s ?? "m") }
function q<T>(x: T) {
  const s: T | string = x
  const t = s ?? "z"
  print(t)
}
const v: string | null = null
g(v)
g("q")
w(v, true)
w("q", true)
w(v, false)
p(v)
p("w")
p(3)
q(v)
q("r")
q(4)
