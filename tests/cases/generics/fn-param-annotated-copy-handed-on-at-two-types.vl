// @run
// @log x
// @log 3
// @log x
// @log 3
// A generic handed to parameters of the function's own type parameter, copied into a binding
// annotated with it and handed on to a hole function called at another type, runs each call at
// its own type.
function same<T>(k: T): T { k }
function take(a) { print(a("x")) }
function take2(a) { print(a(3)) }
function mid<F>(a: F, a1: F) {
  const b: F = a1
  take(a)
  take2(b)
}
mid(same, same)

function one<F>(a: F) {
  const b: F = a
  take(a)
  take2(b)
}
one(same)
