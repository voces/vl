// @run
// @log 2.5
// @log true
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// D13967: a generic's declared record result whose function field reads the type parameter is
// built at the instance's row, for a function value and for `null` alike.
function b<U>(y: U) { print(y) }
function a<T>(_x: T): { f: (t: T) => void } { return { f: b } }
a(2.5).f(2.5)
function a2<T>(_x: T): { f: ((t: T) => void) | null } { return { f: null } }
print(a2(2.5).f == null)
