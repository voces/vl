// @run
// @log k
// @log 2.5
// @log k
// A `.map` whose callback joins its returns at the pin keeps running where the delivery can
// build its element: returned over a box receiver, assigned as a float over floats, and in a
// bound `if` arm (D3125, D3143).
function t<T>(x: T) {
  return [x].map((e) => {
    if 1 > 2 { return e }
    return "k"
  })
}
const a: i32 | null = null
for y in t(a) { print(y) }
function u<T>(x: T) {
  let n = [x].map((e) => {
    if 1 > 2 { return 1 }
    return e
  })
  n = [x].map((e) => {
    if 1 > 2 { return 1 }
    return e
  })
  for y in n { print(y) }
}
u(2.5)
function w<T>(x: T) {
  const c = 1 > 0
  const n = if c { [x].map((e) => {
    if 1 > 2 { return e }
    return "k"
  }) } else { [x].map((e) => {
    if 1 > 2 { return e }
    return "k"
  }) }
  for y in n { print(y) }
}
w(a)
