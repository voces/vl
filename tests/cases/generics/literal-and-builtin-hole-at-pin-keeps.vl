// @run
// @hint Intentionally-unused parameter `_self` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_a` (leading `_` marks it unused)
// @hint redundant type annotation: `xs` is inferred as `T[]`
// @hint redundant type annotation: `xs` is inferred as `i32[]`
// @log 1
// @log 1
// @log 200
// @log 200
// @log 0
// @log s
// @log s
// @log 1
// @log aa
// @log 1
// @log 3
// WHAT THE LITERAL AND BUILTIN PINS MUST NOT COST (silent-class-inventory D581 / D582).
// Re-asking a literal's SLOT and a builtin method's ARGUMENT at the pin is only safe if the
// programs they SHOULD accept still run, and every line here is one a draft of those checks
// did or could plausibly refuse.
//
//   · a7arr / a7push  THE A7 COERCION, at both rungs and the reason each asks
//               `assignableExpr` rather than `assignable`. A boolean-typed VALUE flows into
//               an `i32` slot as 1/0, and that rule lives at the EXPRESSION seam —
//               deliberately absent from the plain predicate. D551's first cut asked the
//               plain one at the return seam and invented a false reject in exactly this
//               shape. It is available at BOTH new sites and these two lines refuse it.
//
//   · u8arr / u8push  THE `u8` STORAGE SLOT, an expression-seam rule too: an i32 VALUE into
//               a one-byte element is the documented truncation, and `assignable(i32, u8)`
//               is deliberately FALSE, so only the expression predicate admits it.
//
//   · brand     A LITERAL adopting a newtype brand through an array ELEMENT. `nomLitAdopts`
//               waives the destination's own brand for a syntactic literal; a pin reading
//               the element off the container must not lose it.
//
//   · okhole / okholepush  THE CONTROL: a hole-typed destination fed the hole itself.
//               Correct at every instance, so it must run — and the pin does REACH it (the
//               counter probe reads `litElem reach=1 ans=0` and `bm note=1 ans=0` here),
//               which is what says the rungs discriminate rather than never firing.
//
//               THE `: T` RETURN IS GONE, AND ITS ABSENCE IS NOW THE POINT. It was declared
//               here because the un-annotated form was a SECOND defect this line must not
//               import — check-clean invalid wasm off an inferred return over a hole-typed
//               element read, filed as D592. D592 closed (the monomorphizer's un-annotated
//               return ladder asks the return EXPRESSION's own type instead of matching its
//               shape), so the annotation is no longer load-bearing, and dropping it turns a
//               workaround into coverage: these two lines now exercise BOTH pins — the
//               literal/builtin slot AND the inferred return — and re-open D592 loudly if
//               that ladder ever loses the fall-through.
//
//   · joinok    THE JOIN-DROPPED SLOT WHEN IT IS CORRECT. `[1, self]` at `g(true)` joins to
//               `i32` with the hole collapsed away, and the slot the pin then asks is
//               `boolean` into `i32` — the A7 coercion again, one mechanism down. The
//               REFUSED third rung (`scripts/silent-sweep/d581/lists.json`) reconstructed
//               the union instead and refused this line.
//
//   · litunion  THE ATOM LIST. A `string[]` destination over an all-literal-union element
//               list is the one place `assignableExpr` RECORDS a rep on the literal node;
//               the element read must not disturb it.
//
//   · nulnest   D117's nested niche element, whose only rep signal is the recorded
//               destination type, reached through the same element recursion.
//
//   · bump      D571's OWN WITNESS — a generic returning a bare type parameter whose body
//               builds an i32. It is the deliberate residue of D561's newtype exemption and
//               neither rung here touches the RETURN seam, so it must still RUN.

function a7arr<T>(self: T) {
  const xs: i32[] = [self]
  return xs[0]
}
function a7push<T>(self: T) {
  const xs: i32[] = []
  xs.push(self)
  return xs[0]
}
function u8arr<T>(self: T) {
  const b: u8[] = [self]
  return b[0]
}
function u8push<T>(self: T) {
  const b: u8[] = []
  b.push(self)
  return b[0]
}
type A1 = new i32
function brand<T>(_self: T) {
  const xs: A1[] = [0, 1]
  return xs[0]
}
function okhole<T>(self: T) {
  const xs: T[] = [self]
  return xs[0]
}
function okholepush<T>(self: T) {
  const xs: T[] = []
  xs.push(self)
  return xs[0]
}
function joinok<T>(self: T) {
  const xs: i32[] = [1, self]
  return xs[1]
}
type VK = "aa" | "bb"
function litunion<T>(_self: T) {
  const k: VK = "aa"
  const ys: string[] = [k]
  return ys[0]
}
type K = "a" | "b"
function nulnest<T>(_self: T) {
  const c: (K | null)[][] = [[null]]
  return c.length
}
function bump<T>(_a: T, n: i32): T {
  return n + 1
}

print(a7arr(true))
print(a7push(true))
print(u8arr(200))
print(u8push(200))
print(brand(0) as! i32)
print(okhole("s"))
print(okholepush("s"))
print(joinok(true))
print(litunion(0))
print(nulnest(0))
const addr: A1 = 0
print(bump(addr, 2) as! i32)
