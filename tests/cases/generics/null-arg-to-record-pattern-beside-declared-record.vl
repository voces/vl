// @run
// @log 5
// @log 2
// @log 5
// A `null` argument to a nullable record pattern binds its type parameter from another
// argument's record, and the instance reads that record's layout rather than a declared record
// sharing the pattern's field names (D3144).
import { toString } from "std:fmt"

type D = { m: string, n: i32 }
function g<T>(b: { m: T, n: i32 } | null, d: T): T {
  if b != null { b.m } else { d }
}
const b = g(null, { x: 0, y: 5 })
print(toString(b.y))
function h<T>(b: { m: T, n: i32 } | null, d: T): T {
  if b != null { b.m } else { d }
}
const a = h({ m: { x: 1, y: 2 }, n: 2 }, { x: 0, y: 0 })
const c = h(null, { x: 0, y: 5 })
print(toString(a.y))
print(toString(c.y))
