// @run
// @log 1
// @log true
// A nested generic used as a value at more than one function type binds its parameter per
// use, as a call does: valid, and run (D3896 review).
function a<T>(x: T) {
  function b<U>(y: U) { print(y) }
  const g: (n: i32) => void = b
  const h: (t: T) => void = b
  g(1)
  h(x)
}
a(true)
