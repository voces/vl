// @run
// @log 9
// @log 2.5
// @log 9
// @log 2.5
// @warning Unused parameter `x`
// @warning Unused parameter `x`
// @hint redundant type annotation: `ys` is inferred as `f64[]` — remove it to lean on inference
// The f32-list pair of the return-kind reader family resolves through the calling frame:
// a per-pin clone shares its template's name, so the flat first-occurrence map hands the
// f32 instance the struct pin's kind (D1834). The f64 half is the oracle — its reader is
// frame-aware, so a regression in `repOfNameResult` breaks both halves rather than one.

type S = { a: i32 }

function mkS(): S { return { a: 9 } }

function mkF(): f32[] {
  const xs: f32[] = [1.5, 2.5]
  return xs
}

function mkD(): f64[] {
  const ys: f64[] = [1.5, 2.5]
  return ys
}

function of(n) {
  function k(x: i32) { return n }
  return k(1)
}

print(of(mkS()).a)
print(of(mkF())[1])

function od(n) {
  function k(x: i32) { return n }
  return k(1)
}

print(od(mkS()).a)
print(od(mkD())[1])
