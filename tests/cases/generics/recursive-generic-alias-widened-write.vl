// @check
// @error a L<i32> cannot be delivered as L<i32|string> here: the assignment on line 10 writes a widened field. A record is shared, not copied, so a wider value stored through the L<i32|string> would sit in the L<i32> it came from. Declare the source as L<i32|string>, pass a fresh copy, or drop the write
// @error L<i32> is not L<i32|string>: they store field `head` differently (`i32` into `i32 | string`), and a record is shared, not copied, so only a fresh record widens. A write through the L<i32|string> would break the L<i32>. Build the source as `L<i32|string>`, or copy it with a literal `{ head: a.head, tail: a.tail }`
// A recursive instance delivered to a genuinely wider one is still a shared record: the
// write two links down lands a `string` in a list of `i32`, so the delivery is refused.
type L<T> = { head: T, tail: L<T> | null }

function poke(x: L<i32 | string>) {
  const t = x.tail
  if t != null { t.head = "s" }
}

const a: L<i32> = { head: 1, tail: { head: 2, tail: null } }
poke(a)
const at = a.tail
if at != null { print(at.head + 1) }
