// @run
// @log yo
// @log 8
// @log null
// A `??` over a hole's map read after a store to the same key reads the stored value at the
// map's own rep: the store narrows the place, and the fused read still owns the null test.
type R = {
  s: {[i32]: string},
  n: {[i32]: i32 | null},
  t: {[i32]: string | null},
}
function mk(): R {
  const s: {[i32]: string} = Map()
  const n: {[i32]: i32 | null} = Map()
  const t: {[i32]: string | null} = Map()
  { s: s, n: n, t: t }
}
function use(p) {
  p.s[13] = "yo"
  print(p.s[13] ?? "d")
  p.n[13] = 8
  print(p.n[13] ?? 5)
  p.t[13] = null
  print(p.t[13] ?? null)
}
use(mk())
