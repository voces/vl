// @check
// @error-at 16:22 cannot assign {v: i32} to '_u' of type U
// D4's ASSIGNMENT face: an object literal that matches NO arm of a union whose arm is a NESTED
// generic application. `{ v: 5 }` gives `v` an `i32`, and the only struct arm demands a
// `Box<i32>` there — so it is a reject, exactly as it already was for the same shape spelled
// with named aliases (`type Outer = { v: Inner }`), spelled inline (`{ v: { v: i32 } } | i32`),
// and as the NON-union annotation `const u: Box<Box<i32>> = { v: 5 }` always was.
//
// It was ACCEPTED. The lexer fuses `>>` into one token, so the inner close banked the second
// `>` and the still-open argument list's union loop swallowed the outer `| i32`, folding the
// declaration into the single type `Box<Box<i32>|i32>` — under which `v: 5` is well typed. The
// non-union spelling one line away was the control that discriminated: it has no trailing `|`
// for the credit to leak into, so it rejected all along.
type Box<T> = { v: T }
type U = Box<Box<i32>> | i32

const _u: U = { v: 5 }

