// @run
// @log 7
// @log 1
// @log 3
// `F` is called only at `i32`, so the call closes it at `(i32) => i32` and `inc` fits (T9.1, D17745).
function same<T>(k: T): T { return k }
function inc(k: i32) { return k + 1 }
function mid<F, G>(a: F, a1: G) {
  print(a(7))
  print(a(1))
  const b: F = a1
  print(b(2))
}
mid(same, inc)
