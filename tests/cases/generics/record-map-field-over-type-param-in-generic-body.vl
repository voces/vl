// @run
// @log s
// A record annotated in a generic body whose field is a map over the type parameter: the
// original's annotation has no type, so only the instance's mints the row (D3919).
function a<T>(x: T) {
  const r: { m: Map<string, T> } = { m: Map() }
  r.m.set("k", x)
  const g = r.m.get("k")
  if g != null { print(g) }
}
a("s")
