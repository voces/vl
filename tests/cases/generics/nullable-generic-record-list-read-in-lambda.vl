// @run
// @log 2
// A generic record holding a `(P | null)[]`, handed in a `(T | null)[]` to a generic that reads
// the list through a lambda. This was refused at emit as "a nullable-Box<i32> list element has
// no rep" though it type-checks and runs.
type Box<P> = { items: (P | null)[] }
function pick<T>(xs: (T | null)[], n: i32): T | null {
  const get = (i: i32) => xs[i]
  return get(n)
}
const b: Box<i32> = { items: [1, null] }
const r = pick([b, null], 0)
if r != null { print(r.items.length) }
