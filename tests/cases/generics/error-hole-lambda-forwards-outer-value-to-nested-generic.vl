// @error cannot assign boolean to 'n' of type i32
// A hole lambda forwarding its parameter to a nested generic, called with a value of the enclosing
// `T`: the generic's demand reaches the enclosing pin through the lambda's hole (D3893).
function a<T>(x: T) {
  function b<U>(y: U) { const n: i32 = y; print(n + 1) }
  const g = (q) => b(q)
  g(x)
}
a(true)
