// @run
// @log true
// @log true
// @log null
// @log false
// @log true
// @log none
// A `boolean` map read through an un-annotated parameter is `boolean | null` at the pin, as
// it is at the declared type: a stored value prints as a boolean, a miss as `null` (D3130).
type H = { m: {[i32]: boolean} }
function f(): H {
  const v: {[i32]: boolean} = Map()
  v[0] = true
  { m: v }
}
function use(r) {
  const e = r.m
  print(e[0] ?? false)
  print(e[0])
  print(e[9])
  print(e[9] ?? false)
  print(r.m[5] == null)
  const x = e[7]
  if x == null { print("none") } else { print(x) }
}
use(f())
