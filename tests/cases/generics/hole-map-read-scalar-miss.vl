// @run
// @log null
// @log 7
// @log null
// @log none
// @log true
// @log 7
// A scalar map read through an un-annotated parameter is `V | null` at the pin: a miss binds
// the value box the declared spelling builds, not the raw zero (D3155).
type H = { m: {[i32]: i32}, f: {[i32]: f64}, l: {[i32]: i64} }
function mk(): H {
  const v: {[i32]: i32} = Map()
  v[3] = 7
  const f: {[i32]: f64} = Map()
  f[3] = 1.5
  const l: {[i32]: i64} = Map()
  const k: i64 = 7
  l[3] = k
  { m: v, f: f, l: l }
}
function use(r) {
  const e = r.m
  const x = e[9]
  print(x)
  const y = e[3]
  print(y)
  const g = r.f[9]
  print(g)
  const z = r.l[9]
  if z == null { print("none") } else { print(z) }
  print(e[9] == null)
  const w = r.l[3]
  print(w)
}
use(mk())
