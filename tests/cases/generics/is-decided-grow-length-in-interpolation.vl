// @run
// @log n=0
// @log n=1
// A decided pushing arm's grown length inside an interpolation hole, the Q58 position the ir-shadow-rows
// sweep (is-decided-fit-shadow-grow-positions) cannot hold, since its rows build without std.
function pInterp<V>(v: V[]) {
  if v is f64[] { v.push(1.5) }
  print("n=\{v.length}")
}
const e: i32[] = []
pInterp(e)
const f: f64[] = []
pInterp(f)
