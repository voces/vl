// @run
// @log 1
// @log 2.5
// @log s
// A generic returning its own list before another generic's two-list result returns the union
// of both, in either order, so its call is typed as the instance builds it (D2814).
function g<U>(u: U, c: boolean) {
  if c { return [u] }
  [2.5]
}
function h<T>(c: boolean, t: T) {
  if !c { return [t] }
  g(t, false)
}
print(h(true, 3).length)
const q = h(true, "s")
if q is f64[] { print(q[0]) } else { print(-1) }
const p = h(false, "s")
if p is string[] { print(p[0]) } else { print(-1) }
