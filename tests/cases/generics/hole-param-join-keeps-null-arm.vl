// @run
// @log 1
// @log s
// @log null
// @log 1
// @log s
// @log null
// @log true
// @log 7
// @log 2.5
// @log t
// @log null
// @log true
// @log true
// @log s
// @log 9
// @log 1
// @log s
// @log null
// Un-annotated parameters are gradual as declared type parameters are: their join with a `null`
// arm keeps the null at every pin, so the null arm's value no longer fails the caller's cast at a
// pin with a string arm (D3497). A function forwarding the call, and a declared parameter
// beside a hole, keep the null too (D3501).
function two(k: i32, a, b) {
  if k == 0 { a }
  else if k == 1 { b }
  else { null }
}
function ret(k: i32, a, b) {
  if k == 0 { return a }
  if k == 1 { return b }
  return null
}
print(two(0, 1, "s"))
print(two(1, 1, "s"))
print(two(2, 1, "s"))
print(ret(0, 1, "s"))
print(ret(1, 1, "s"))
print(ret(2, 1, "s"))
print(two(2, 1, "s") == null)
print(two(2, 1, "s") ?? 7)
print(two(0, 2.5, true))
print(two(1, false, "t"))
print(ret(2, "u", 1))
function fwd(k: i32, a, b) { two(k, a, b) }
print(fwd(2, true, true) == null)
print(fwd(2, 1, "s") == null)
print(fwd(1, "r", "s"))
print(fwd(2, 1, 2) ?? 9)
function mixed<A>(k: i32, a: A, b) {
  if k == 0 { a }
  else if k == 1 { b }
  else { null }
}
print(mixed(0, 1, "s"))
print(mixed(1, 1, "s"))
print(mixed(2, 1, "s"))
