// @run
// @log 7
// @log 7
// @log 7
// @log 7
// D14140: a fresh record handed to a generic parameter that stores its field as a union with the
// inferred type parameter adopts that parameter's record (DECISIONS.md, D2996): a literal
// binding, a `let`, a second field, and a literal built inside a generic.
function len<T>(r: {v: T | string}) {
  if r.v is string { 0 } else { 7 }
}
const r = { v: 5 }
print(len(r))
let q = { v: 5 }
q = { v: 6 }
print(len(q))
function len2<T>(r: {v: T | string, w: i32}) { r.w + 6 }
const r2 = { v: 5, w: 1 }
print(len2(r2))
function outer<U>(x: U) { print(len({ v: x })) }
outer(5)
