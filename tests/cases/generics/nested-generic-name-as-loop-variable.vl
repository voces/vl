// @run
// @log 1
// @log 2
// @log 2
// @log s
// A `for` variable named like a nested generic is another binding, not an escape (D3853 review).
function a<T>(x: T) {
  function b<U>(y: U) { const n: i32 = y; print(n + 1) }
  for b in [1, 2] { print(b) }
  b(x)
}
function c<T>(x: T) {
  function q<U>(y: U) { print(y) }
  q(x)
}
a(1)
c("s")
