// @run
// @log a!
// @log a?
// @log a!q
// @log a?
// @log a!
// @log a?
// @log 6
// @log 10
// @log xa
// @log xb
// @log xc
// @log a!
// @log a?
// @log a!!
// @log a??
// D13282: a choice among nested hole functions, written as the argument of a hole parameter,
// takes the type the flow table pins its arms' reads at, as one of them handed alone does: from
// a labelled block (with and without a capture), an `if`, an `else if` chain, a later argument
// position, and a callee calling it twice.
function ask(s) { return s + "?" }
function apply(f, s: string) { return f(s) }
function g(xs: string[]) {
  print(
    apply(
      @B {
        for v in xs {
          function inner(s) { return s + "!" }
          if v == "q" { break @B inner }
        }
        ask
      },
      "a",
    ),
  )
}
g(["p", "q"])
g(["z"])

function h(xs: string[]) {
  print(
    apply(
      @B {
        for v in xs {
          function inner(s) { return s + "!" + v }
          if v == "q" { break @B inner }
        }
        ask
      },
      "a",
    ),
  )
}
h(["p", "q"])
h(["z"])

function pick(c: boolean) {
  function inner(s) { return s + "!" }
  print(apply(if c { inner } else { ask }, "a"))
}
pick(true)
pick(false)

function applyN(f, x: i32) { return f(x) }
function num(c: boolean) {
  function inc(s) { return s + 1 }
  function dbl(s) { return s * 2 }
  print(applyN(if c { inc } else { dbl }, 5))
}
num(true)
num(false)

function three(n: i32) {
  function a(s) { return s + "a" }
  function b(s) { return s + "b" }
  function c(s) { return s + "c" }
  print(apply(if n == 0 { a } else if n == 1 { b } else { c }, "x"))
}
three(0)
three(1)
three(2)

function applyLast(s: string, f) { return f(s) }
function last(c: boolean) {
  function inner(s) { return s + "!" }
  print(applyLast("a", if c { inner } else { ask }))
}
last(true)
last(false)

function twice(f, s: string) { return f(f(s)) }
function tw(c: boolean) {
  function inner(s) { return s + "!" }
  print(twice(if c { inner } else { ask }, "a"))
}
tw(true)
tw(false)
