// A generic's join of `{a: t}` with `{a: 1}` keeps the field apart at the pin (D2809, D2855),
// and an undeclared record built from a hole keeps its own row at the instance (D8900).
type J = { f: i32 | null }
function h<T>(c: boolean, t: T) {
  if c { return { a: t } }
  { a: 1 }
}
print(h<boolean>(false, true).a)
const r = h(false, "x")
print(r.a)
print(h(true, "x").a)
function bump(n) { return { f: n + 1 } }
function take(a) {
  const v = a
  print(v.f + 1)
}
take(bump(4))
// @log 1
// @log 1
// @log x
// @log 6
