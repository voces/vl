// @run
// @log true
// @log null
// @log b
// @log null
// @log none
// @log null
// A map read off a declared type parameter's field is `V | null` at the instance's binding,
// the same read an un-annotated parameter gets: a boolean, an atom and a miss each print as
// the declared spelling prints them (D3130, D3155, D3157).
type AB = "a" | "b"
type R = { b: {[i32]: boolean}, n: {[i32]: AB | null}, m: {[i32]: i32} }
function mk(): R {
  const b: {[i32]: boolean} = Map()
  b[0] = true
  const n: {[i32]: AB | null} = Map()
  n[3] = "b"
  const m: {[i32]: i32} = Map()
  m[3] = 7
  { b: b, n: n, m: m }
}
function use<T>(r: T) {
  print(r.b[0])
  print(r.b[9])
  print(r.n[3] ?? null)
  print(r.n[9])
  const x = r.m[9]
  if x == null { print("none") } else { print(x) }
  const e = r.m
  const y = e[9]
  print(y)
}
use(mk())
