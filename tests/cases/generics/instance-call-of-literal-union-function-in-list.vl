// @run
// @log a
// @log a
// @log true
// @log <b>
// A literal-union function reached through a list, a nested list or a list of records, called
// in a hole or generic instance, renders its member (D3199).
function F(z) { print(z[0]()) }
const fs: (() => "a" | "b")[] = [() => "a"]
F(fs)
type K = "a" | "b"
function G<Z>(z: Z) { print(z[0][0]()) }
const gs: (() => K)[][] = [[() => "a"]]
G(gs)
function E(z) { print(z[0].f() == "a") }
const rs: { f: () => "a" | "b" }[] = [{ f: () => "a" }]
E(rs)
function I(z) { print("<\{z[0]()}>") }
const hs: (() => "a" | "b")[] = [() => "b"]
I(hs)
