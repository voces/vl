// D3969, refused by design (owner ruling 2026-11-05, Q5): a `let` holding a function that
// returns nothing cannot be written with one that returns a value, or the other way round, so
// each write is refused alone, beside a direct call, between writes back, and at module scope.
function inner<U>(u: U) { print("I"); print(u) }
function retV<V>(v: V): V { print("R"); print(v); v }
function main() {
  let k = inner
  k = retV
  k(3)
}
main()
function beside() {
  let k = inner
  k = retV
  k(4)
  print(retV("s"))
}
beside()
function back() {
  let k = inner
  k(1)
  k = retV
  k(5)
  k = inner
  k(6)
}
back()
let m = inner
m = retV
m(7)
m("t")
