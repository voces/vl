// @run
// @log 7
// @log 3
// @log 9
// @log s
// @log null
// @log b
// A hole-bound field function's result read by `??`, by a field read and through a
// capturing lambda, at a nullable, a record and a literal-union result (D3165).
function F(z) {
  const g = z.f
  print(g() ?? 7)
}
F({ f: (): i32 | null => null })
F({ f: (): i32 | null => 3 })
function G(z) {
  const g = z.f
  print(g().v)
}
G({ f: () => ({ v: 9 }) })
G({ f: (): { v: string } => ({ v: "s" }) })
function H(z) {
  const g = z.f
  const k = () => g()
  print(k())
}
H({ f: (): i32 | null => null })
H({ f: (): "a" | "b" => "b" })
