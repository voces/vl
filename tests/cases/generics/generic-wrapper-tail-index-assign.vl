// @run
// @hint redundant type annotation: `t` is inferred as `{slots: {w: i32}[], n: i32}` — remove it to lean on inference
// @log 4
// @log 1
// A generic wrapper relaying a generic function whose tail is an index assignment after a
// statement `if` gets that function's result: the `if` arm's statement is not a return (D2536).
type Tbl<V> = { slots: V[], n: i32 }
function put<V>(self: Tbl<V>, id: i32, v: V) {
  if id > 5 { self.n = self.n + 1 }
  self.slots[id] = v
}
function putw<V>(self: Tbl<V>, id: i32, v: V) { put(self, id, v) }
type Tex = { w: i32 }
const t: Tbl<Tex> = { slots: [{ w: 0 }], n: 0 }
putw(t, 0, { w: 4 })
print(t.slots[0].w)
print(t.slots.length)
