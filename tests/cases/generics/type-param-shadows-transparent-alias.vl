// @run
// @log z
// @log 2
// @log 1.5
// @log 7
// @log 4
// @log 2.5
// @log y
// @log w
// @log 6
// @log true
// @log k
// @log 8
// @log 1
// @log 9
// @hint redundant type annotation: `a` is inferred as `{v: string}`
// @hint redundant type annotation: `b` is inferred as `{v: f64[]}`
// @hint redundant type annotation: `d` is inferred as `{v: i32}`
// @hint redundant type annotation: `f` is inferred as `{v: string}`
// @hint redundant type annotation: `g` is inferred as `{v: string}`
// @hint redundant type annotation: `h` is inferred as `{v: i32}`
// @hint redundant type annotation: `p` is inferred as `{v: boolean}`
// @hint redundant type annotation: `q` is inferred as `{v: string}`
// @hint redundant type annotation: `r` is inferred as `{v: i32}`
// @hint redundant type annotation: `s` is inferred as `{v: i32[][]}`
// A generic alias whose type-PARAMETER name shadows a type the CANON PASS REWRITES. The
// parameter binds — `tsLeafTy` asks the live binding (`tpEnvTyOfName`) before the declared
// registry (`declaredTyOfName`), so the checker reports `BoxId<string>` as `{v: string}` —
// but `typecheck.canonEmitName` had already rewritten the field annotation `Id` to `i32`
// before `emit_collect.gaeCollectDecls` recorded it. `emit_base.gaeApplyFieldTy` was then
// handed the type name `i32` against a parameter list holding `Id`, matched nothing, and
// left the field at the ALIAS's body type while the checker had bound it to the ARGUMENT.
// `vl check` rc=0, and a module that does not even parse ("expected i32, found (ref $type)").
//
// The population is NOT "a transparent single-member alias". It is every name canon
// rewrites, and that is at least three arms: `singleMemberAliasName` (`type Id = i32`,
// `type Ids = i32[]`, `type MyS = Sx`, the alias-of-an-alias `type J = Id`, the function
// type, the map), and `numLitUnionAliasName` — which claims `type Z = 0 | 1` AND the
// one-member `type One = 1`, and is reached before the `nameNeedsCanon` early-out. A
// declared STRUCT or UNION shadow never failed, because canon rewrites neither; a STRING
// literal union (`type K = "a" | "b"`) never failed either, because canon deliberately keeps
// its alias name. Sampling one route would have measured a sixth of this.
//
// The route back is a SIDECAR (`typecheck.genAliasFieldRawTyName`), not a canon suppression,
// and that distinction is measured: teaching `canonEmitNameAt` to leave a live parameter
// name alone fixes the same cells but REDDENS the depth-2 identity application below —
// surviving in the ARENA, `Id[][]` is a nested list whose element names a `UnionDecl`
// (`type Id = i32` is one), so the ref-list intern gave the inner row a union BOX element
// and `[[9]]` lowered into it. Only the substitution wants the parameter name back; every
// other pass wants what canon produces.
//
// Held fixed while varying: one alias, one field, one application at a type OTHER than the
// shadowed one. What moves is the SHADOWED declaration's kind and the depth the field writes
// the parameter at (`Id`, `Id[]`, `Id[][]`) — the reps under the applications are spread
// across i32 / i64 / f64 / f32 / boolean / string so a rep-blind swap cannot pass.
//
// `type-param-shadows-builtin-application.vl` is the arm that must NOT substitute (a
// parameter named for a BUILTIN binds nothing — `primTyOfName` runs first), and
// `type-param-shadows-declared-struct.vl` is the arm that always did.
type Id = i32

type Nm = string

type Ids = i32[]

type Z = 0 | 1

type One = 1

type Sx = { n: i32 }

type MyS = Sx

type J = Id

type Fn = (i32) => i32

type BoxId<Id> = { v: Id }

type ArrId<Id> = { v: Id[] }

type NestId<Id> = { v: Id[][] }

type BoxNm<Nm> = { v: Nm }

type BoxIds<Ids> = { v: Ids }

type BoxZ<Z> = { v: Z }

type BoxOne<One> = { v: One }

type BoxMyS<MyS> = { v: MyS }

type BoxJ<J> = { v: J }

type BoxFn<Fn> = { v: Fn }

const a: BoxId<string> = { v: "z" }
print(a.v)

const b: ArrId<f64> = { v: [1.5, 2.5] }
print(b.v.length)
print(b.v[0])

const c: NestId<i64> = { v: [[7]] }
print(c.v[0][0])

const d: BoxNm<i32> = { v: 4 }
print(d.v)

const e: BoxIds<f32> = { v: 2.5 }
print(e.v)

const f: BoxZ<string> = { v: "y" }
print(f.v)

const g: BoxOne<string> = { v: "w" }
print(g.v)

const h: BoxMyS<i32> = { v: 6 }
print(h.v)

const p: BoxJ<boolean> = { v: true }
print(p.v)

const q: BoxFn<string> = { v: "k" }
print(q.v)

// The IDENTITY application: substituting the parameter for the very type its shadowed alias
// names is a no-op, so it must keep running — and at DEPTH 2 it is the cell the suppression
// alternative broke.
const r: BoxId<i32> = { v: 8 }
print(r.v)

const s: NestId<i32> = { v: [[9]] }
print(s.v.length)
print(s.v[0][0])
