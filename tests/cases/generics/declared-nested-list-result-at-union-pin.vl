// @run
// @log 1
// @log 4
// @log 4
// @log 100
// @log 12
// @log s
// @log c
// @log nil
// @log 4
// @log 1
// @log c
// @log 2
// @log 12
// @log 2
// @log s
// @log 3
// @log 4
// @log 3
// @log s
// @log 3
// @log c
// A generic's declared `T[][]` result at an `i32 | null`, `i32 | string` or `string | null` pin
// is the list of that union, grouped, both for a returned literal and a returned local, and
// matches the un-annotated result at every delivery position (D13061). A `T[][]` parameter
// at those pins binds `T` to the same list type (D13060).
function mk<T>(x: T): T[][] { [[x]] }
function mkL<T>(x: T): T[][] {
  const l = [[x], [x, x]]
  return l
}
function mkU<T>(x: T) { [[x]] }
function mkUL<T>(x: T) {
  const l = [[x], [x, x]]
  return l
}

function total(rows: (i32 | null)[][]) {
  let n = 0
  for r in rows {
    for e in r { n = n + (e ?? 100) }
  }
  n
}

type Holder = { rows: (string | null)[][] }

const a: i32 | null = 4
const an: i32 | null = null
const b: i32 | string = "s"
const c: string | null = "c"

// A binding.
const r1 = mk(a)
print(r1.length)
print(r1[0][0] ?? -1)
// An argument.
print(total(mk(a)))
print(total(mk(an)))
print(total(mkL(a)))
// An annotated binding.
const r2: (i32 | string)[][] = mk(b)
const e2 = r2[0][0]
if e2 is string { print(e2) }
// A record field.
const h: Holder = { rows: mk(c) }
print(h.rows[0][0] ?? "none")
// A return.
function wrap(s: string | null): (string | null)[][] { mk(s) }
print(wrap(null)[0][0] ?? "nil")
// The un-annotated face.
print(total(mkU(a)))
print(mkU(b).length)
print(mkU(c)[0][0] ?? "none")
print(mkUL(c)[1].length)
print(total(mkUL(a)))
// A returned local in the annotated face, at the other two pins.
print(mkL(c)[1].length)
const e3 = mkL(b)[1][1]
if e3 is string { print(e3) }

// A declared `T[][]` parameter at the same pins substitutes the same way (D13060).
function n<T>(l: T[][]) { return l.length + l[0].length }
function first<T>(l: T[][]): T { l[0][0] }
const l1: (i32 | null)[][] = [[a, null]]
print(n(l1))
print(first(l1) ?? -1)
const ls: (i32 | string)[][] = [[b], [1]]
print(n(ls))
const f = first(ls)
if f is string { print(f) }
const lc: (string | null)[][] = [[null, c]]
print(n(lc))
print(first(mk(c)) ?? "nil")
