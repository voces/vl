// @run
// @log 3
// @log 0
// @log 0
// @log 1
// THE SCOPE OF THE THIRD `is`-SPELLING GATE (#1310), pinned from the side it can over-reach.
//
// `monoStaticIsResult` decides a monomorphized instance's `v is T` guard at COMPILE TIME:
// each instance pins the un-annotated param to ONE concrete type, so the test is a constant
// per instance. Its first act is an EXCLUSION — a tested spelling that names a union VARIANT
// is not a static guard, it belongs to `emitIs`'s union ladder. #1310 had to teach that
// exclusion `isVariantSpelling` (the rule #1309 gave `emitIs` and `pushNarrowIs`), because a
// raw-string exclusion silently const-folded an inline-shape union test to FALSE once the
// inferred union's duplicate structural row stopped registering that spelling.
//
// APPLYING IT UNCONDITIONALLY IS THE OVER-REACH THIS FILE PINS. `isVariantSpelling` answers
// about the tested TYPE, not about the receiver: `{meow: i32}` resolves to the declared `Cat`
// wherever a `Cat | Dog` union exists in the module — including here, where the guarded value
// is an `i32`. Unconditional, the exclusion fires, the static arm declines, and the union
// ladder rejects a program that is decidable and correct:
//   `emitProgram: `is` receiver is not a union value`
// A 60-cell monomorphized-guard grid put that at 12 cells. The gate is therefore scoped by
// `nodeTyIsUnion(receiver)` — the CHECKER's view of the operand, deliberately not the
// emitter's `exprUnion`, which is the rep classification that has the gap the third gate
// exists for.
//
// The union below is LOAD-BEARING, not decoration: without a `Cat | Dog` in the module,
// `{meow: i32}` names no row, `isVariantSpelling` has nothing to resolve to, and the
// unconditional form would behave exactly like the scoped one.
type Cat = { meow: i32 }
type Dog = { woof: i32 }
type U = Cat | Dog

const uu: U = { meow: 3 }

function g<T>(v: T) {
  if v is {meow: i32} {
    print(1)
  } else {
    print(0)
  }
}

function h<T>(v: T) {
  if v is i32 {
    print(1)
  } else {
    print(0)
  }
}

function go() {
  if uu is Cat {
    print(uu.meow)
  }
  g(11)
  g("s")
  h(11)
}

go()
