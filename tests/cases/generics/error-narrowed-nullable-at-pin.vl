// @check
// D1693's FLOOR, the refusals its close must not take with it. The row's fix teaches every
// null-test spelling to mint the hole's non-null face, so the pin re-asks its floors against
// the narrowed type — and a body with NO narrowing has nothing to mint, so each floor below
// still refuses at both spellings, in the direct spelling's own sentence.
//
// The pairing is what makes that checkable: every `…Pinned` reaches the operation through an
// un-annotated parameter and every `…Direct` writes it out at the concrete type, so a fix that
// taught the pin to accept everything would drop the pinned half of each pair while the direct
// half stood. These are the sibling of `narrowed-nullable-at-pin.vl`, which reads back the
// narrowed forms that now run.

// @error cannot index non-array A[] | null
// @error cannot index non-array A[] | null (the body of `idxPinned` at the call's argument types)
// @error member access '.length' on non-object A[] | null
// @error member access '.length' on non-object A[] | null (the body of `lenPinned` at the call's argument types)
// @error operator '+' is not defined for i32 | null and i32
// @error argument 1: operator '+' is not defined for i32 | null and i32 (the body of `plusPinned` applies '+' to this argument)

type A = { r: i32 }
function mkA(): A[] | null { return [{ r: 4 }] }
function mkN(): i32 | null { return 4 }

function idxPinned(a) {
  const l = a.xs
  print(l[0].r)
}
idxPinned({ xs: mkA() })
const dIdx = mkA()
print(dIdx[0].r)

function lenPinned(a) {
  const l = a.ys
  print(l.length)
}
lenPinned({ ys: mkA() })
const dLen = mkA()
print(dLen.length)

function plusPinned(v) { print(v + 1) }
plusPinned(mkN())
const dPlus = mkN()
print(dPlus + 1)
