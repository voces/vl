// D3969: a generic with a value return written to a `let` initialized with a void generic is
// called through the binding at its void type, alone, beside a direct call at another type,
// between writes back to the void generic, and at module scope.
function inner<U>(u: U) { print("I"); print(u) }
function retV<V>(v: V): V { print("R"); print(v); v }
function main() {
  let k = inner
  k = retV
  k(3)
}
main()
function beside() {
  let k = inner
  k = retV
  k(4)
  print(retV("s"))
}
beside()
function back() {
  let k = inner
  k(1)
  k = retV
  k(5)
  k = inner
  k(6)
}
back()
let m = inner
m = retV
m(7)
m("t")
