// @run
// @log 2
// @log 2
// @log 2
// @log 2
// @log 3
// @log x
// A union of records over a type parameter, handed a union of records, binds the parameter field by
// field through the arm with the same field names, in either order, so an `is` or `match` naming
// the parameter tests the instance's arm (D16150).
function kids<T>(t: { leaf: T } | { kids: T[] }) {
  if t is { kids: T[] } { return t.kids.length }
  return 1
}
function leafFirst<T>(t: { leaf: T } | { kids: T[] }) {
  if t is { leaf: T } { return 1 }
  return t.kids.length
}
function matched<T>(t: { leaf: T } | { kids: T[] }) {
  return match t {
    { leaf: T } => 1
    { kids: T[] } => t.kids.length
  }
}
function swapped<T>(t: { kids: T[] } | { leaf: T }) {
  if t is { kids: T[] } { return t.kids.length }
  return 1
}
function back<T>(t: { leaf: T } | { kids: T }): { leaf: T } | { kids: T } { return t }
const a: { leaf: string } | { kids: string[] } = { kids: ["x", "y"] }
print(kids(a))
print(leafFirst(a))
print(matched(a))
print(swapped(a))
const b: { leaf: i32 } | { kids: i32[] } = { kids: [1, 2, 3] }
print(kids(b))
const c: { leaf: string } | { kids: string } = { kids: "x" }
const r = back(c)
if r is { kids: string } { print(r.kids) }
