// @run
// @log 1
// @log 2
// @log 1
// @log 1
// @log s
// @log 1
// @log null
// @log 2.5
// @log b
// @log b
// @log a
// @log p
// @log q
// A hole function's list literal of its parameter is built at the parameter's pin wherever it
// stands: a member read, an index, a callback's receiver, an argument to a generic, and a local
// of it handed on. A second instance at another pin keeps its own (D3066, D3064, D3085).
type AB = "a" | "b"
function h<W>(w: W[]) { print(w[1]) }
function each<U>(l: U[]) {
  for e in l { print(e) }
}
function f(x) {
  print([x].length)
  print([x][0])
  print([x].filter((e) => e == e).length)
}
const v: i32 | null = 2
f(v)
const s: string | null = "s"
f(s)
function g(x) { const y = x; h([y, y]) }
const n: i32 | null = null
g(n)
g(2.5)
const ab: AB = "b"
g(ab)
function two(x, y) { const l = [x, y]; each(l) }
const b1: AB = "b"
const b2: AB = "a"
two(b1, b2)
two("p", "q")
