// @run
// @log false
// @log 1
// @log 1
// @log 8
// @log 7
// @hint Intentionally-unused parameter `_v` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_r` (leading `_` marks it unused)
// @hint redundant type annotation: `isNul` is inferred as `boolean` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// @hint redundant type annotation: `viaClosure` is inferred as `boolean` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// @hint redundant type annotation: `n` is inferred as `i32` — remove it to lean on inference
// A composite parameter riding type parameters pins at the type the elaboration gives it at the
// call, where the type parameter is bound from another argument, from nothing, or through an
// alias whose parameter no field names (D2735, D12100, D12101, D12180, D12600).
type C = { x: i32 }
type P = { a: i32, b: i32 }
type Rows<T> = { base: i32, count: i32 }

function isNul<T>(u: T | null): boolean { u == null }
function viaClosure<T>(u: T | null): boolean {
  const k = () => isNul<T>(u)
  k()
}
const m: {[i32]: boolean} = Map()
print(viaClosure<{[i32]: boolean}>(m))

function g<T>(_v: T | C) { print(1) }
const n: i32 = 3
g(n)
const s: string = "s"
g(s)

function inner<T>(r: Rows<T>) { return r.base }
function outer<U>(r: Rows<U>) { return inner(r) * 2 }
const st: Rows<string> = { base: 4, count: 1 }
print(outer(st))

function pick<T>(_r: Rows<T>, x: T): T { x }
function mk<T>(base: i32): Rows<T> { return { base: base, count: 1 } }
const su = mk<P>(8)
const q = pick(su, { a: 3, b: 4 })
print(q.a + q.b)
