// @run
// @log bool
// @log int
// D2493 at a generic pin: the body's `is IM` is checked against a bare `T`; this instance binds `T`
// to a union of two maps with one representation, whose box tags tell them apart.
type IM = {[i32]: i32}
type BM = {[i32]: boolean}
const mb: BM = Map()
mb.set(1, true)
const mi: IM = Map()
function k<T>(u: T) {
  if u is IM { print("int") } else { print("bool") }
}
const v: IM | BM = mb
k(v)
const v2: IM | BM = mi
k(v2)
