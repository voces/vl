// @run
// @log 2
// @log 2
// @log 2
// @log 2
// @log 2
// @log 2
// The spellings beside a nested generic whose inferred result joins its encloser's parameter
// with its own: the result annotated, the two parameters lifted to one module-scope generic, and
// the call's value bound inside a hole lambda, called at two types in two encloser instances.
function annotated<T>(x: T) {
  function wrap<U>(u: U): (T | U)[] { return [x, u] }
  print(wrap("a").length)
}
annotated(1)

function lifted<T, U>(x: T, u: U) { return [x, u] }
print(lifted(1, "a").length)

function bound<T>(x: T) {
  function wrap<U>(u: U) { return [x, u] }
  const g = (v) => {
    const r = wrap(v)
    return r.length
  }
  print(g(1))
  print(g("a"))
}
bound(1)
bound("s")
