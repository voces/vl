// @run
// @log 7
// @log false
// @log 4
// @log null
// A lambda returned at an open union result runs when the type parameter is itself a union, beside
// a scalar instance and a null one (D17062).
function keep<U>(x: U): () => U | string { return () => x }
const v: i32 | boolean = 7
print(keep(v)())
const w: i32 | boolean = false
print(keep(w)())
print(keep(4)())
print(keep(null)())
