// @hint redundant type annotation: `tb` is inferred as `string`
// @run
// @log a
// @log -
// @log T
// @log N
// D2525's boundary, narrowed: a `(V | null)[]` over a type parameter now builds where `V | null`
// is a string or boolean niche, each instance reading its elements at its own rep. A literal
// union element still refuses (error-nullable-type-param-list-niche-litunion.vl).
function put<V>(xs: (V | null)[], id: i32, v: V) {
  const none: V | null = null
  while xs.length <= id { xs.push(none) }
  xs[id] = v
}

function tb(x: boolean | null): string {
  if x == null { return "N" }
  if x { return "T" }
  "F"
}

const s: (string | null)[] = []
put(s, 2, "a")
print(s[2] ?? "-")
print(s[0] ?? "-")
const b: (boolean | null)[] = []
put(b, 1, true)
print(tb(b[1]))
print(tb(b[0]))
