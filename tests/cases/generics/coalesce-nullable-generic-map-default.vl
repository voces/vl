// @run
// @log 3
// @log 1
// @log s
// @log 3
// @log 5
// @log 6
// @log x
// `??` over a generic nullable map with a map default is the map at every pin, and over an
// un-annotated function's join of a generic map and `null` (D12390).
function mk<T>(v: T): Map<string, T> {
  const m = Map<string, T>()
  m["a"] = v
  m
}
function h<T>(o: Map<string, T> | null, d: T) {
  const z = o ?? Map<string, T>()
  z["a"] ?? d
}
function hr<T>(o: Map<string, T> | null, d: T) {
  return (o ?? Map<string, T>())["a"] ?? d
}
function hc(v, d, c: boolean) {
  const o = if c { mk(v) } else { null }
  const z = o ?? mk(d)
  z["a"] ?? d
}
print(h(null, 3))
print(h(mk(1), 2))
print(h(null, "s"))
print(hr(null, 3))
print(hc(5, 6, true))
print(hc(5, 6, false))
const got = h(mk("x"), "y")
print(got)
