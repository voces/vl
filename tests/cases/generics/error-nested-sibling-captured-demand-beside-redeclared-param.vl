// @error cannot assign boolean to 'm' of type i32
// A sibling nested generic's demand on the enclosing `T`, read through a capture, is checked at
// the enclosing pin beside a nested generic that redeclares `T` (D3853 review).
function a<T>(x: T) {
  function b<T>(y: T) {
    const n: i32 = y
    print(n + 1)
  }
  function c<U>(z: U) {
    const m: i32 = x
    print(m)
  }
  b(1)
  c(1)
}
a(true)
