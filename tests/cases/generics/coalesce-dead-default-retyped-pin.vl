// @run
// @log 2.5
// @log 1.25
// @log 0.5
// @log 1.5
// @log 1.5
// @log 0
// A `??` in a pinned instance whose operand cannot be null and whose pin is another type
// delivers the operand into the pin: an `f32` cell read by a closure joined with an `f64`
// default (D3707), and an `f32` element read through a hole parameter joined with `0` (D3797).
// A cell reset to `null` before the closure runs still takes the default.
function g<T>(x: T) {
  let c: f32 | null = null
  c = x
  const h = () => c ?? 0.5
  print(h())
}
function gReset<T>(x: T) {
  let c: f32 | null = null
  c = x
  const h = () => c ?? 0.5
  c = null
  print(h())
}
const v: f32 = 2.5
const w: f32 = 1.25
g(v)
g(w)
gReset(v)
function take(a) { print(a[1] ?? 0) }
const x: f32 = 1.5
const k = [x, x]
take(k)
function takeBound(a) {
  const r = a[1] ?? 0
  print(r)
}
takeBound(k)
function takeNullable(a) {
  const r = a[1] ?? 0
  print(r)
}
const y = 1.5
const kn: (f64 | null)[] = [y, null]
takeNullable(kn)
