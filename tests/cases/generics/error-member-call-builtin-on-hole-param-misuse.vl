// @check
// @error no field 'slice' on string
// @error slice expects 2 arguments, got 3
// @error slice expects i32 bounds, got string and i32
// A built-in answers a member the body calls; read as a value, or called with the wrong arity or
// argument types, it is refused as the direct spelling refuses it (D16882).
function asValue(a) {
  const g = a.slice
  print(1)
}
function arity(a) { print(a.slice(0, 2, 3)) }
function argTy(a) { print(a.slice("x", 2)) }
asValue("hello")
arity("hello")
argTy("hello")
