// @run
// @log 7
// @log 1
// @log 7
// @log first
// @log 7
// @log 1
// @log 3
// @log 3
// @log 2
// @log 4
// @log s!
// Two functions each nesting a generic whose type parameter has one name keep two bindings of
// it, aliased and called directly, beside a top-level function of the nested one's name (D3927).
function call(f: (n: i32) => void) { f(1) }
function outer(x: i32) {
  function inner<U>(u: U) { print(x); print(u) }
  const k = inner
  call(k)
}
function firstOther(x: i32) {
  function inner<U>(u: U) { print(x); print(u) }
  const k = inner
  k("first")
  call(k)
}
outer(7)
firstOther(7)
function inner<U>(u: U) { print(u) }
inner(3)
function wrap<T>(t: T) {
  function inner<U>(u: U): U { print(t); return u }
  print(inner(1) + 1)
}
function other(x: i32) {
  function inner<U>(u: U): U { print(x); return u }
  print(inner("s") + "!")
}
wrap(3)
other(4)
