// @run
// @log 3
// @log 4
// @log 3
// @log 4
// @log 3
// @log 4
// A record literal in an inferred generic body is built at the row its own instance names:
// each function runs at i32 and at f64, so `{x: ...}` needs a row per instance. The annotated
// spelling is `record-literal-row-per-instance-annotated.vl`; an annotation here would declare
// the i32 row and hide the f64 instance's literal.
// Return position.
function addx(self, b) { x: self.x + b.x }
const p = addx({ x: 1 }, { x: 2 })
print(p.x)
const q = addx({ x: 1.5 }, { x: 2.5 })
print(q.x)

// Binding position.
function addxBound(self, b) {
  const o = { x: self.x + b.x }
  return o
}
print(addxBound({ x: 1 }, { x: 2 }).x)
print(addxBound({ x: 1.5 }, { x: 2.5 }).x)

// List element passed as an argument.
function firstX(xs) { xs[0].x }
function addxArg(self, b) { firstX([{ x: self.x + b.x }]) }
print(addxArg({ x: 1 }, { x: 2 }))
print(addxArg({ x: 1.5 }, { x: 2.5 }))
