// @run
// @log b
// @log 1.5
// @log 4
// @log a
// @log 2.5
// @log b
// @log 1.5
// @log 4
// @log a
// @log 2.5
// @log b
// @log 1.5
// @log 4
// @log a
// @log 2.5
// @log b
// @log 1.5
// @log 4
// @log a
// @log 2.5
// @log d
// @log 7.5
// @log c
// @log 8.5
// CONTRACT (D5380, D5460): a declared union read out of a projection and handed to an
// un-annotated parameter pins at the union's declared name, as a call return or an annotated
// parameter does, so the instance's field reads find the union's member set. The projections
// are a field, a nested field, a list field's element, a list element's field and a call
// result's field, and the same field read inside an un-annotated function's own instance,
// where it used to be refused as an unsupported argument type.
//
// Nothing here annotates `show`'s parameter or a carrier's binding.
type A = { kind: "a", v: f64 }
type B = { kind: "b", v: f64, n: i32 }
type S = A | B
type C = { kind: "c", v: f64 }
type D = { kind: "d", v: f64, w: string }
type U = C | D
type Bx = { it: S }

function mk(b: boolean): S {
  if b { return { kind: "b", v: 1.5, n: 4 } }
  { kind: "a", v: 2.5 }
}
function mu(b: boolean): U {
  if b { return { kind: "d", v: 7.5, w: "dd" } }
  { kind: "c", v: 8.5 }
}
function mkb(b: boolean): Bx { { it: mk(b) } }

function show(p) {
  print(p.kind)
  print(p.v)
  if p is B { print(p.n) }
}

const box = { it: mk(true), jt: mk(false) }
show(box.it)
show(box.jt)

const deep = { inner: { it: mk(true) } }
show(deep.inner.it)
const lst = { xs: [mk(true), mk(false)] }
show(lst.xs[1])

const rows = [{ it: mk(true) }]
show(rows[0].it)
show(mkb(false).it)

function wrap(q) { show(q.it) }
wrap({ it: mk(true) })
wrap({ it: mk(false) })
wrap({ it: mu(true) })
wrap({ it: mu(false) })
