// @check
// @error map key must be i32, got string
// The generic's `is` arm fixes the empty map at `{[i32]: f64}`, so the caller's own write of a
// string key is refused at check (DECISIONS.md "No default type").
function f<T>(x: T) {
  if x is {[i32]: f64} {
    x[1] = 2.5
    return x.length
  }
  return 0
}
const m = Map()
print(f(m))
m["a"] = 1
