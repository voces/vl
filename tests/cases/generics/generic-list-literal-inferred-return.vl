// @run
// @hint redundant type annotation: `c` is inferred as `{r: i32}` — remove it to lean on inference
// @hint redundant type annotation: `c1` is inferred as `{r: i32}[]` — remove it to lean on inference
// @hint redundant type annotation: `f1` is inferred as `f64[]` — remove it to lean on inference
// @hint redundant type annotation: `big` is inferred as `i64` — remove it to lean on inference
// @log 3
// @log 2
// @log 1.5
// @log 1.5
// @log s
// @log 7
// @log true
// @log 4
// @log b
// @log 3
// @log 2.5
// @log n
// @log u
// @log 5
// @log 9
// @log 5000000000
// @log 8
// @log 3
// @log 4
// @log 1.5
// A generic returning a list literal of its parameter with no return annotation builds the
// list at the element type each instance pins: the instance's return is inferred from `[x]`
// itself, not left to the i32 default (D2300). Several instances share one module.

type Circle = { r: i32 }
function wrap<T>(x: T) { return [x] }
function two<T>(x: T, y: T) { return [x, y] }
function nest<T>(x: T) { return [[x]] }
const c: Circle = { r: 3 }
const c1: Circle[] = [{ r: 4 }]
const f1: f64[] = [1.5]
print(wrap(c)[0].r)
print((wrap(c1[0]) + c1).length)
print(wrap(f1)[0][0])
print(wrap(1.5)[0])
print(wrap("s")[0])
print(wrap(7)[0])
print(wrap(true)[0])
print(wrap(c1)[0][0].r)
print(two("a", "b")[1])
print(two(c, c)[1].r)
print(nest(2.5)[0][0])
print(nest("n")[0][0])
const u: i32 | string = "u"
print(wrap(u)[0])
const inc = (n: i32) => {
  n + 1
}
print(wrap(inc)[0](4))
const m: {[string]: i32} = Map()
m["k"] = 9
print(wrap(m)[0]["k"])
const big: i64 = 5000000000
print(wrap(big)[0])
function g() {
  const ws = wrap(c)
  ws.push({ r: 8 })
  print(ws[1].r)
}
g()
function idg<A>(x: A) { return [x] }
print(idg(3)[0])
print(idg(c1)[0][0].r)
print(idg(f1)[0][0])
