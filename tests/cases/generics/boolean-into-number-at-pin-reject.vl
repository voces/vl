// @check
// @error cannot assign boolean[] to 'xs' of type i32[] — a `boolean` is not a number; convert each element with `b as i32` (the body of `arr`
// @error push: cannot add boolean to i32[] — a `boolean` is not a number; convert it with `b as i32` (the body of `push`
// @error cannot assign boolean[] to 'bs' of type u8[] — a `boolean` is not a number; convert each element with `b as u8` (the body of `u8arr`
// @error push: cannot add boolean to u8[] — a `boolean` is not a number; convert it with `b as u8` (the body of `u8push`
// @error cannot assign boolean to i32 — a `boolean` is not a number; convert it with `b as i32` (the body of `joined`
// @error cannot assign boolean to 'r' of type i32 — a `boolean` is not a number; convert it with `b as i32` (the body of `local`
// @error return type mismatch: expected i32, got boolean — a `boolean` is not a number; convert it with `b as i32` (the return of `ret`
// @error argument 1: expected i32, got boolean — a `boolean` is not a number; convert it with `b as i32` (the call of `h`
// @error cannot assign boolean to i32 — a `boolean` is not a number; convert it with `b as i32` (the body of `store`
// @error set: expected i32, got boolean — a `boolean` is not a number; convert it with `b as i32` (the body of `mset`
// A type parameter bound to `boolean` refuses at the pin wherever the direct spelling refuses
// the value: a list-literal element, push, a `u8` element, a joined literal, a declared local,
// a declared return, a hole callee's argument, an index store and a map value. Each names the
// explicit `as`, and each keeps running once the body converts.
function arr<T>(self: T) {
  const xs: i32[] = [self]
  return xs[0]
}
function push<T>(self: T) {
  const xs: i32[] = []
  xs.push(self)
  return xs[0]
}
function u8arr<T>(self: T) {
  const bs: u8[] = [self]
  return bs[0]
}
function u8push<T>(self: T) {
  const bs: u8[] = []
  bs.push(self)
  return bs[0]
}
function joined<T>(self: T) {
  const xs: i32[] = [1, self]
  return xs[1]
}
function local<T>(self: T): i32 {
  const r: i32 = self
  return r
}
function ret<T>(self: T): i32 { return self }
function apply(h, v) { return h(v) }
function store<T>(self: T) {
  const xs = [0]
  xs[0] = self
  return xs[0]
}
function mset<T>(self: T) {
  const m = Map<string, i32>()
  m.set("a", self)
  return m["a"] ?? 5
}
const b = 3 > 2
print(arr(b))
print(push(b))
print(u8arr(b))
print(u8push(b))
print(joined(b))
print(local(b))
print(ret(b))
print(apply((x: i32) => x + 1, b))
print(store(b))
print(mset(b))
