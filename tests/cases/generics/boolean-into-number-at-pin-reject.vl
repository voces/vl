// A type parameter bound to `boolean` refuses at the pin wherever the direct spelling refuses
// the value: a list-literal element, push, a `u8` element, a joined literal, a declared local,
// a declared return, a hole callee's argument, an index store (naming `u8` for a byte cell) and a map value. Each names the
// explicit `as`, and each keeps running once the body converts.
function arr<T>(self: T) {
  const xs: i32[] = [self]
  return xs[0]
}
function push<T>(self: T) {
  const xs: i32[] = []
  xs.push(self)
  return xs[0]
}
function u8arr<T>(self: T) {
  const bs: u8[] = [self]
  return bs[0]
}
function u8push<T>(self: T) {
  const bs: u8[] = []
  bs.push(self)
  return bs[0]
}
function joined<T>(self: T) {
  const xs: i32[] = [1, self]
  return xs[1]
}
function local<T>(self: T): i32 {
  const r: i32 = self
  return r
}
function ret<T>(self: T): i32 { return self }
function apply(h, v) { return h(v) }
function store<T>(self: T) {
  const xs = [0]
  xs[0] = self
  return xs[0]
}
function u8store<T>(self: T) {
  const bs: u8[] = [0]
  bs[0] = self
  return bs[0]
}
function mset<T>(self: T) {
  const m = Map<string, i32>()
  m.set("a", self)
  return m["a"] ?? 5
}
const b = 3 > 2
print(arr(b))
print(push(b))
print(u8arr(b))
print(u8push(b))
print(joined(b))
print(local(b))
print(ret(b))
print(apply((x: i32) => x + 1, b))
print(store(b))
print(u8store(b))
print(mset(b))
