// @emit-error this `is` arm reads an empty list at an element type it was not built with
// A type parameter no argument binds stays unbound where an `is K[]` arm reads its list from a
// closure, and the instance cannot hand that closure the arm's empty `K[]` (D4911).
function s<T, U>(a: T[]) {
  const q: U[] = []
  if q is f64[] {
    const k = () => q.length + 10
    print(k())
  }
  print(a.length)
}
s([1])
