// @run
// @info `b` is never reassigned; use `const` instead of `let`
// @log x
// @log 3
// @log y
// @log 4
// A binding annotated with a type parameter and seeded from a second parameter of that type is
// called at its own type, so the two parameters are built at one instance each (D6523).
function same<T>(k: T): T { k }
function mid<F>(a: F, a1: F) {
  let b: F = a1
  print(a("x"))
  print(b(3))
}
mid(same, same)
function mid2<F>(a: F, a1: F) {
  const b: F = a1
  print(a("y"))
  print(b(4))
}
mid2(same, same)
