// @check
// A write narrows a hole's function field only while the direct spelling's would hold: not for
// a value the template cannot prove non-null, and not past a call, a closure or an aliased write
// that may null the field (D3197). Each is refused as the annotated `direct` is, in its words.

// @error called value is not a function ((() => i32) | null) (the body of `holeValue` at the call's argument types)
// @error called value is not a function ((() => i32) | null) (the body of `globalWrite` at the call's argument types)
// @error called value is not a function ((() => i32) | null) (the body of `closureWrite` at the call's argument types)
// @error called value is not a function ((() => i32) | null) (the body of `aliasWrite` at the call's argument types)
// @error called value is not a function ((() => i32) | null) (the body of `declaredCall` at the call's argument types)
// @error called value is not a function ((() => i32) | null) (the body of `holeCall` at the call's argument types)
// @error called value is not a function ((() => i32) | null) — 'z.f' is no longer narrowed to () => i32: the call to 'clr' on line 78 may reassign it; re-test 'z.f' after the call

type R = { v: i32, f: (() => i32) | null, g: (() => i32) | null }
const NF: (() => i32) | null = null
let G: R = { v: 1, f: null, g: null }
const r: R = { v: 1, f: null, g: null }

function holeValue(z) {
  z.f = z.g
  print(z.f())
}
holeValue(r)

function clrG() {
  G.f = NF
  return
}
function globalWrite(z) {
  z.f = () => 5
  clrG()
  print(z.f())
}
globalWrite(G)

function closureWrite(z) {
  const k = () => {
    z.f = NF
  }
  z.f = () => 5
  k()
  print(z.f())
}
closureWrite(r)

function aliasWrite(z) {
  const y = z
  z.f = () => 5
  y.f = NF
  print(z.f())
}
aliasWrite(r)

function clr(q: R) {
  q.f = NF
  return
}
function declaredCall<Z>(z: Z) {
  z.f = () => 5
  clr(z)
  print(z.f())
}
declaredCall(r)

function clrH(q) {
  q.f = NF
  return
}
function holeCall(z) {
  z.f = () => 5
  clrH(z)
  print(z.f())
}
holeCall(r)

function direct(z: R) {
  z.f = () => 5
  clr(z)
  print(z.f())
}
direct(r)
