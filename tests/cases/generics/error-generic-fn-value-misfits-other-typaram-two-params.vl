// @check
// @error cannot assign <A, B>(A, B) => B to 'b' of type <T, U>(T, U) => T (parameter `a1` of `mid`
// A two-parameter generic returning its second parameter does not fit one returning its first,
// whatever its type parameters are named (D17322).
function fst<T, U>(k: T, _u: U): T { return k }
function snd<A, B>(_a: A, b: B): B { return b }
function mid<F, G>(a: F, a1: G) {
  let b: F = a1
  print(a("x", 1))
  print(a(1, "y"))
}
mid(fst, snd)
