// @run
// @log 1
// @log s
// A record field typed as a union of a generic application and a scalar stores the union box.
type B<T> = { v: T }
type Obj = { q: B<i32> | string, r: i32 }
const o: Obj = { q: { v: 1 }, r: 2 }
const q = o.q
if (q is string) { print(q) } else { print(q.v) }
const p: Obj = { q: "s", r: 3 }
const s = p.q
if (s is string) { print(s) } else { print(s.v) }
