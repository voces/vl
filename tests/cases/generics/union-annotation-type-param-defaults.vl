// @run
// @hint Intentionally-unused parameter `_v` (leading `_` marks it unused)
// @log 0
// @log 5
// @log 0
// A type parameter only a union annotation names is defaulted at a call whose argument binds
// none of it, as the bare `V[]` one is (D4913): the argument here is the `string` arm.
function probe<V>(_v: V[] | string) { return 0 }
function size<V>(v: V[] | string) {
  if v is string { return v.length }
  0
}
print(probe("s"))
const n = size("hello")
print(n)
const e: i32[] = []
print(size(e))
