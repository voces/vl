// @run
// @log 42
// @log s
// @log 8
// @log t
// @log ay
// @log by
// @log 6
// @log v
// @log 10
// @log w
// @hint Intentionally-unused parameter `_n` (leading `_` marks it unused)
// @hint redundant type annotation: `show` is inferred as `string`
// @hint redundant type annotation: `show2` is inferred as `string`
// @hint redundant type annotation: `capOnly` is inferred as `string`
// The `retOnly` row NEEDS a parameter it does not read: the point is a nested function whose
// RETURN names `T` while no parameter does, which is the spelling `checkParams` cannot see.
// The `: string` annotations on `capOnly`'s two nested functions are the load-bearing half of
// that row — a CONCRETE signature is what makes the capture the only thing making it a
// template — so they are declared rather than deleted (CLAUDE.md).
// D1046 — A NESTED NAMED `function` INSIDE A GENERIC BODY SEES THE ENCLOSING `T`, and is
// monomorphized per pin exactly as the arrow-lambda spelling has been since D426. The rule the
// owner agreed to on 2026-09-02 is "an inner declaration sees the enclosing function's type
// parameters", for local `type`s and for named functions alike (DECISIONS.md §"A `type`
// declared in a function body is legal and lexically scoped"), so this closes with D1045.
//
// THE ROW WAS UNDER-FILED AND THIS FILE IS WHY IT MATTERS. Only the FIRST spelling was loud
// (`checkParams` reads PARAMETERS, and its message still said "a lambda"); the second and
// third were `vl check` rc 0 followed by INVALID WASM, which no narrowing of that message
// could ever have reached. Every arrow-lambda control ran throughout, which is what makes the
// three one defect rather than three.
//
//   pTyParam  — a PARAMETER names `T`                       (was: loud emit reject)
//   retOnly   — the RETURN names `T`, no parameter does      (was: check-clean invalid wasm)
//   capOnly   — a fully CONCRETE signature CAPTURING a `T`   (was: check-clean invalid wasm)
//   viaClo    — the nested function called FROM A CLOSURE    (was: loud emit reject)
//   recur     — RECURSION through the nested function        (was: loud emit reject)
//
// `capOnly` is D943's defect at the named spelling: one lifted slot means one env struct
// (`fnEnvIdx` is parallel to `fnStmts`), so the first instantiation's layout was the only one
// there was and the `string` instance stored a ref into an `i32` field.
//
// EVERY ROW IS INSTANTIATED TWICE, at `i32` and at `string`, and prints from each — a single
// pin cannot tell a per-instance clone from a shared template.
function pTyParam<T>(x: T): T {
  function id(a: T): T { return a }
  return id(x)
}
function retOnly<T>(x: T): T {
  function mk(_n: i32): T { return x }
  return mk(1)
}
function capOnly<T>(x: T, tag: string): string {
  function show(): string { return tag }
  const held = x
  function show2(): string { if held == held { return "y" } return "n" }
  return show() + show2()
}
function viaClo<T>(x: T): T {
  function id(a: T): T { return a }
  const via = () => id(x)
  return via()
}
function recur<T>(x: T, n: i32): T {
  function down(a: T, m: i32): T {
    if m <= 0 { return a }
    return down(a, m - 1)
  }
  return down(x, n)
}
print(pTyParam(41) + 1)
print(pTyParam("s"))
print(retOnly(7) + 1)
print(retOnly("t"))
print(capOnly(1, "a"))
print(capOnly("u", "b"))
print(viaClo(5) + 1)
print(viaClo("v"))
print(recur(9, 3) + 1)
print(recur("w", 2))
