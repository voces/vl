// @run
// @log local
// @log local
// @log local
// @log local
// @log param
// @log param
// @warning Unused parameter `t` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `t` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `t` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `t` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `t` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `t` (prefix with `_` to suppress, or remove it)
// A local `const`, a reassigned `let` and a parameter named like a module generic `b` are what
// `b` means where they are in scope, delivered at a type built from the enclosing T at two
// instances: no adapter is built for the module generic (D3918).
function b<U>(y: U) {
  print("generic")
  print(y)
}
function a<T>(x: T) {
  const b = (t: T) => print("local")
  const h: (t: T) => void = b
  h(x)
}
function m<T>(x: T) {
  let b = (t: T) => print("first")
  b = (t: T) => print("local")
  const fs: ((t: T) => void)[] = [b]
  fs[0](x)
}
function p<T>(x: T, b: (t: T) => void) {
  const fs: ((t: T) => void)[] = [(t: T) => print("other")]
  fs[0] = b
  fs[0](x)
}
a(2.5)
a("s")
m(2.5)
m("s")
p(2.5, (t: f64) => print("param"))
p("s", (t: string) => print("param"))
