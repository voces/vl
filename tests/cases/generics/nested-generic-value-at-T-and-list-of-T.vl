// @run
// @warning Unused parameter `y` (prefix with `_` to suppress, or remove it)
// @log 1
// @log 1
// A nested generic used as a value at more than one function type binds its parameter per
// use, as a call does: valid, and run (D3896 review).
function a<T>(x: T) {
  function b<U>(y: U) { print(1) }
  const h: (t: T) => void = b
  const g: (t: T[]) => void = b
  h(x)
  g([x])
}
a(true)
