// @run
// A record argument whose pin is a declared record's name, its own or one sharing its field
// names, binds a record-pattern generic from the argument's own fields (D3146, D3179).
import { toString } from "std:fmt"

type D = { m: { x: i32, y: i32 }, n: i32 }
type S = { m: string, n: i32 }
function g<T>(b: { m: T, n: i32 }): T { b.m }
function h<T>(b: { m: T, n: i32 }, d: T): T {
  if b.n > 100 { d } else { b.m }
}
const z: i32 | null = 4
const e = g({ m: z, n: 1 })
if e != null { print(toString(e)) } else { print("n") }
print(h({ m: "m", n: 0 }, "d"))
const s: S = { m: "s", n: 2 }
print(g(s))
// @log 4
// @log m
// @log s
