// @run
// @log 2
// @log a
// @log 2
// @log 2.5
// @log 2
// @log 2.5
// @log 2
// @log 2.5

// D1782 — a per-pin clone of a nested capturing function reached through a BINDING rather than
// by name. The binding's target is resolved from the frame it is read in, so the instance gets
// its own clone; the flat name map answers the template, whose signature validates, so this is
// a wrong ANSWER and not a refusal. Every pair must print two different values.

function o(n) {
  function k() { return n }
  const f = k
  return f()
}
print(o(2))
print(o("a"))

// A second hop, and a reassignment: both resolve through the same target read.
function h(n) {
  function k() { return n }
  const f = k
  const g = f
  return g()
}
print(h(2))
print(h(2.5))

function r(n) {
  function k() { return n }
  let f = k
  f = k
  return f()
}
print(r(2))
print(r(2.5))

// The struct-field hop, which the binding fix alone does not reach: the field's own resolver
// has to carry the frame too, and reading the callers does not find this position.
function s(n) {
  function k() { return n }
  const box = { g: k }
  return box.g()
}
print(s(2))
print(s(2.5))
