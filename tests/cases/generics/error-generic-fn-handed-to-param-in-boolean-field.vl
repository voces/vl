// @check
// @error cannot assign {b: (T) => T} to 'zz' of type {b: boolean} (the body of `one` at the call's argument types)
// D14979 through a record field: a generic function as the `boolean` field of a record.
function id<T>(x: T): T { x }
function one<F>(a: F) {
  const zz: { b: boolean } = { b: a }
  print(zz.b)
}
one(id)
