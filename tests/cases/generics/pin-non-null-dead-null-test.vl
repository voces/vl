// @run
// @log a
// @log 5
// @log true
// @log false
// @log true
// @log false
// @log true
// @log false
// @log 1
// @log 8
// @log false
// @log true
// @log 9
// @log 3
// @log 0
// @log 5
// @log 0
// @hint redundant type annotation: `r` is inferred as `{a: i32}`
// @warning `v` shadows the `v` declared at
// A null test of a type parameter at a pin that admits no null is the constant its direct twin
// folds to: `!= null` true and `== null` false, in a condition, a value, either operand order,
// a negation and a conjunction; a nullable pin still tests the value (D2802). An un-annotated
// parameter's hole is the same pin (D2240), and a local that shadows the parameter is not.
type LS = "a" | "b"
type R = { a: i32 }
function arms<T>(v: T) {
  if v != null { print(v) } else { print(v) }
}
function val<T>(v: T) {
  print(v != null)
  print(null == v)
}
function neg<T>(v: T) {
  if !(v == null) && true { print(1) } else { print(0) }
}
function rec<T>(v: T) {
  if v == null { print(9) } else { print(8) }
}
const x: LS = "a"
arms(x)
arms(5)
val(2.5)
val(true)
val("s")
neg([4])
const r: R = { a: 3 }
rec(r)
const nn: i32 | null = null
val(nn)
rec(nn)
function first(a) {
  if a != null { return a[0] }
  0
}
const b = [3]
const c: i32[] | null = null
print(first(b))
print(first(c))
function shadow<T>(v: T, w: T | null) {
  print(v)
  if true {
    const v = w
    if v != null { print(1) } else { print(0) }
  }
}
shadow(5, null)
