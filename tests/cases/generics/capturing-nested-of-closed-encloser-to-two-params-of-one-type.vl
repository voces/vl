// @run
// @log 7
// @log x
// @log 7
// @log 2
// @log 8
// @log y
// @log 8
// @log 3
// A capturing nested function of a closed encloser handed to two parameters of one type
// parameter, each called at its own type: the call is keyed at no instance of its encloser, and
// still joins both parameters' signatures (D15603).
function mid<F>(a: F, b: F) {
  print(a("x"))
  print(b(2))
}
function outer(u: i32) {
  function same(k) {
    print(u)
    k
  }
  mid(same, same)
}
outer(7)
function midG<F>(a: F, b: F) {
  print(a("y"))
  print(b(3))
}
function outerG(u: i32) {
  function same<T>(k: T): T {
    print(u)
    k
  }
  midG(same, same)
}
outerG(8)
