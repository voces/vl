// D7440: a field typed by one bare string literal reps as its atom, and handed to a generic it
// pins the `string` instance, so the call widens it to the literal's text.
// @run
// @log 1
// @log a
// @log 1
// @log c
// @log 1
type A = { kind: "a", x: i32 }
type B = { kind: "b" | "c", x: i32 }
type U = A | B
function id<T>(x: T): T { return x }
const a: A = { kind: "a", x: 1 }
const u: U = a
print(u.x)
print(id(a.kind))
print(id(a.kind).length)
const c: B = { kind: "c", x: 1 }
print(id(c.kind))
print(id(c.kind).length)
