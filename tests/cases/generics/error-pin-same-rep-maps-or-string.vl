// @emit-error `is` cannot tell {[i32]:i32} from {[i32]:boolean} yet: this instance's union holds both
// A `T | string` parameter pinned at `T := IM | BM` holds the pair.
type IM = {[i32]: i32}
type BM = {[i32]: boolean}
const mb: BM = Map()
mb.set(1, true)
const v: IM | BM = mb
function k<T>(u: T | string): boolean { u is IM }
const mi: IM = Map()
const v2: IM | BM = mi
print(k(v))
print(k(v2))
