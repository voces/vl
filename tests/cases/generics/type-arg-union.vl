// @run
// @log 3
// @log hi
// @log 4
// A generic alias applied to a UNION type argument (`Box<i32 | null>`). The type
// name the parser folds is `Box<i32|null>`, and the checker's name scanners tracked
// `{}`/`[]`/`()` depth but NOT the generic-application brackets `<>` — so the
// TOP-LEVEL union split shredded the argument list into the garbage atoms `Box<i32`
// and `null>`, and the whole annotation was rejected with `unknown type
// 'Box<i32|null>'`. `Box<i32>` (no separator inside the brackets) always worked, so
// the defect was invisible until an argument carried a `|`.
type Box<T> = { v: T }

const b: Box<i32 | null> = { v: 3 }
if b.v is i32 { print(b.v) }

const s: Box<i32 | string> = { v: "hi" }
if s.v is string { print(s.v) }

// The nested application: the inner `<…>` closes before the outer one.
const n: Box<Box<i32 | null>> = { v: { v: 4 } }
const iv = n.v.v
if iv is i32 { print(iv) }
