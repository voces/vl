// @run
// @log 3
// @log 100
// @log 100
// @log 5
// @log 4
// @log 100
// A generic's own parameter handed back as `() => x` into `() => T | string` binds `T` to the
// fixed member the enclosing pin delivers, so the instance at `U = string` reads it as that
// member (D10270).
function len<T>(f: () => T | string) {
  const t = f()
  if t is string { t.length } else { 100 }
}
function outer<U>(x: U) { print(len(() => x)) }
outer("abc")
outer(2.5)
outer(7)
outer("hello")
function outerAnn<U>(x: U) { print(len((): U | string => x)) }
outerAnn("abcd")
outerAnn(1.5)
