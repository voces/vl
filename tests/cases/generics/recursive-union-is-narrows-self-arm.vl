// @run
// @log 2
// @log 3
// @log 2
// @log 1
// @log 2
// @log 2
// @log 3
// Inside a generic, `is` narrows a recursive union to the arm that refers back to the union, which
// interns apart from the pattern spelling it (D17034): inline, through the recursive walk, through
// an alias arm, in a negated test's else, in a `match` arm and under `&&`, while the arm free of the
// self-reference narrows as before.
type Tr<T> = { leaf: T } | { kids: Tr<T>[] }
type Kids<T> = { kids: Rt<T>[] }
type Rt<T> = { leaf: T } | Kids<T>
function width<T>(t: Tr<T>): i32 {
  if t is { kids: Tr<T>[] } { return t.kids.length }
  return 1
}
function count<T>(t: Tr<T>): i32 {
  if t is { kids: Tr<T>[] } {
    let n = 0
    for k in t.kids { n = n + count(k) }
    return n
  }
  return 1
}
function viaAlias<T>(t: Rt<T>): i32 {
  if t is Kids<T> { return t.kids.length }
  return 1
}
function leafFirst<T>(t: Tr<T>): i32 {
  if t is { leaf: T } { return 1 }
  return t.kids.length
}
function negated<T>(t: Tr<T>): i32 {
  if !(t is { kids: Tr<T>[] }) { return 1 }
  return t.kids.length
}
function matched<T>(t: Tr<T>): i32 {
  return match t {
    { kids: Tr<T>[] } => t.kids.length
    _ => 1
  }
}
function both<T>(t: Tr<T>, ok: boolean): i32 {
  if t is { kids: Tr<T>[] } && ok { return t.kids.length }
  return 1
}
const t: Tr<i32> = { kids: [{ leaf: 1 }, { kids: [{ leaf: 2 }, { leaf: 3 }] }] }
function r2(): Tr<i32> { return { kids: [{ leaf: 1 }, { leaf: 2 }] } }
const r: Rt<i32> = { kids: [{ leaf: 1 }, { leaf: 2 }] }
print(width(t))
print(count(t))
print(viaAlias(r))
print(leafFirst({ leaf: 9 }))
const s: Tr<string> = { kids: [{ leaf: "a" }, { leaf: "b" }, { leaf: "c" }] }
print(negated(r2()))
print(matched(r2()))
print(both(s, true))
