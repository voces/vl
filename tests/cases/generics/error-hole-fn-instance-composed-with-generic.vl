// @emit-error emitProgram: monomorphize: unsupported argument type for `g` in a call to `compose`
// A hole function whose only instance is at `string`, composed after a generic the call pins at
// `i32`: the two arguments bind `B` at different types, and the call is refused as each of its
// neighbouring spellings is (D16412), not built at one of them or trapped on (D16493).
function hid(x) { return x }
function gid<A>(x: A): A { return x }
function app<A, B>(f: (x: A) => B, x: A): B { return f(x) }
function compose<A, B, C>(f: (x: A) => B, g: (x: B) => C): (x: A) => C {
  return (x: A) => g(f(x))
}
print(hid("a"))
print(compose(gid, hid)(5))
print(app(gid, 7))
