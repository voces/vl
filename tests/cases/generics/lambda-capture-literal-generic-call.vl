// @run
// @log b
// @log b
// @log b
// @log zz
// @log 7
// D3063: a lambda inside a `<T>` instance calls a generic on the captured parameter at the
// instance's pin, a literal union's text included.
type AB = "a" | "b"
function g<T>(x: T) { const f = () => h(x); f(); f() }
function h<U>(u: U) { print(u) }
const v: AB = "b"
g(v)
function g1<T>(x: T) { const f = () => h(x); f() }
g1(v)
g1("zz")
g1(7)
