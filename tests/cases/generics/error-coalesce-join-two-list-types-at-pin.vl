// @error at the call's argument types, the branches of an `if`, `match` or `??` in the body of `nested` join string[][] and i32[][]: it returns string[][] | i32[][], which the call reads as string[][]
// @error at the call's argument types, the branches of an `if`, `match` or `??` in the body of `flat` join f64[] and boolean[]: it returns f64[] | boolean[], which the call reads as f64[]
// A generic `??` whose operand list and default list a pin binds apart is the `if` it spells:
// returned, it is refused at the call that reads it as the operand's list (D2846, D2816).
function nested<T>(xs: T[][] | null) { xs ?? [[1]] }
function flat<T>(xs: T[] | null) {
  const r = xs ?? [false]
  r
}
const q = nested([["s"]])
print(q.length)
const p = flat<f64>(null)
print(p.length)
