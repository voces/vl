// @error the branches of an `if`, `match` or `??` join string[][] and i32[][] (the body of `nested`, used at 5:47)
// @error the branches of an `if`, `match` or `??` join f64[] and boolean[] (the body of `flat`, used at 7:13)
// A generic `??` whose operand list and default list a pin binds apart is the `if` it spells:
// returned, it is refused at the call that reads it as the operand's list (D2846, D2816).
function nested<T>(xs: T[][] | null) { return xs ?? [[1]] }
function flat<T>(xs: T[] | null) {
  const r = xs ?? [false]
  return r
}
const q = nested([["s"]])
print(q.length)
const p = flat<f64>(null)
print(p.length)
