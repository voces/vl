// @hint redundant type annotation: `r` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `r2` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `r3` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `r4` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `r5` is inferred as `string` — remove it to lean on inference
// A generic's `T[] | i32` parameter narrowed by `is i32` and joined with a literal returns the
// join, not the parameter's union, wherever the return is written (D10131).
function len<T>(t: T[] | i32) {
  if t is i32 { t } else { 5 }
}
const r: i32 = len([1, 2])
print(r)
print(len(3))
const r2: i32 = len(7)
print(r2)
function early<T>(t: T[] | i32) {
  if t is i32 { return t }
  5
}
const r3: i32 = early(["a"])
print(r3)
print(early(9))
function viaFn<T>(f: () => T[] | i32) {
  const t = f()
  if t is i32 { t } else { 5 }
}
const r4: i32 = viaFn((): i32[] | i32 => [1, 2])
print(r4)
print(viaFn((): i32[] | i32 => 6))
function str<T>(t: T[] | string) {
  if t is string { t } else { "x" }
}
const r5: string = str([1, 2])
print(r5)
print(str("q"))
function wide<T>(t: T[] | i32) {
  if t is i32 { t } else { 2.5 }
}
print(wide([1, 2]))
print(wide(4))
function mixed<T>(t: T[] | i32) {
  if t is i32 { t } else { "s" }
}
print(mixed([1, 2]))
print(mixed(4))
