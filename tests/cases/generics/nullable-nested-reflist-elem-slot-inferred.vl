// @run
// @log 2
// @log 1
// @log ONE-LEVEL 1
// @log FREE-CALL 1
// @log NON-NULL 1
// THE UN-ANNOTATED FACE of `nullable-nested-reflist-elem-slot.vl` (D1836). Its annotations
// were rep-load-bearing while the checker called them redundant; the checker was right and the
// MONOMORPHIZER was wrong, so this file is the same program with the annotations gone.
//
// The mono argument reader builds an array-literal's pin by concatenation —
// `arrLitElemName(ix) + "[]"` — and skipped the grouping rule the arena renderer applies. A
// nullable element has two top-level atoms, so the bare suffix bound into its last arm:
// `(i32[][] | null)[]` spelled `i32[][]|null[]`, and `nameIsArray` rightly said no. The arena
// render of the same node was `(i32[][]|null)[]` all along, which is what made the annotated
// face work.
//
// The last three rows are the ablation: the nesting LEVEL is not an ingredient (one level
// refuses the same way), the UFCS spelling is not (the free call does too), and the nullable
// ELEMENT is (a non-nullable nested list always ran).
import { indexOf } from "std:array"
import { toString } from "std:fmt"

function mkS(): string[][] { [["a"]] }

function mkR(i: i32): i32[][] | null {
  if i == 0 { return null }
  [[i]]
}

function nulRefListCells() {
  const ss = [mkS(), mkS()]
  print(ss.length)
  const rs = [mkR(1), mkR(2)]
  const rd = mkR(2)
  print(rs.indexOf(rd))
}

nulRefListCells()

function mkR1(i: i32): i32[] | null {
  if i == 0 { return null }
  [i]
}

function oneLevel() {
  const rs = [mkR1(1), mkR1(2)]
  const rd = mkR1(2)
  print("ONE-LEVEL " + toString(rs.indexOf(rd)))
}
oneLevel()

function freeCall() {
  const rs = [mkR(1), mkR(2)]
  const rd = mkR(2)
  print("FREE-CALL " + toString(indexOf(rs, rd)))
}
freeCall()

function mkN(i: i32): i32[][] { [[i]] }

function nonNull() {
  const rs = [mkN(1), mkN(2)]
  const rd = mkN(2)
  print("NON-NULL " + toString(rs.indexOf(rd)))
}
nonNull()
