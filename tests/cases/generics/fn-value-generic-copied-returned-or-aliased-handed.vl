// @run
// @log 2
// @log 4
// @log 4
// @log 4
// A generic returned by an un-annotated function runs when held in a written `let`, copied into a
// `const` and handed on (D10380), or passed back through a second function's return and handed
// on at two types (D10381); a generic aliased out of a list element into a record field, stored
// in an un-annotated `Map()`, runs when read back and handed on at two types (D10401).
function id<T>(x: T): T { x }
function run<U>(f: (x: U) => U, u: U): U { f(u) }
function mk() { id }
function deliver() { return mk() }

let a = mk()
let b = mk()
b = a
const c = b
print(run(c, 2))

let a2 = mk()
let b2 = mk()
b2 = a2
const c2 = b2
print(run(c2, 2) + run(c2, "ab").length)

const v = deliver()
print(run(v, 2) + run(v, "ab").length)

const xs = [id]
const e = xs[0]
const w = { f: e }
const m = Map()
m["k"] = w.f
const r = m["k"]
if r != null { print(run(r, 2) + run(r, "ab").length) }
