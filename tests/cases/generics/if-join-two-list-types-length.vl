// @run
// @log 2
// A generic if-join whose arms are two different list types at the pin (`f64[]` and
// `string[]`) is their union there, and its length is read out of whichever arm the box holds
// (D2832, D16897).
function no() { return false }
function f<T>(xs: T[], ys: string[]) {
  const r = if no() { xs } else { ys }
  print(r.length)
}
f([1.5], ["a", "b"])
