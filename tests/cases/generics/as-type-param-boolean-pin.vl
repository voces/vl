// @run
// @log 1
// @log 1
// @log 1
// @log 0
// @log 1.5
// @log 0
// @log -7
// @log 2
// @hint redundant type annotation: `g2` is inferred as `i32`
// @hint redundant type annotation: `g5` is inferred as `f64`
// `x as N` over a type parameter pinned at `boolean` converts exactly as the direct spelling
// `b as N` does, at every mode: the bare `as` and `as!` give 1 or 0, `as?` gives the number
// rather than null, and every numeric target converts. A pin at no number still misses
// (`as-trap-type-param-non-number.vl`), and a number pin keeps its own exactness.
function g<T>(x: T): i32 | null { return x as i32 }
function g2<T>(x: T): i32 { return x as! i32 }
function g3<T>(x: T) { return x as? i32 }
function g4<T>(x: T): i64 | null { return x as i64 }
function g5<T>(x: T): f64 { return x as! f64 }
function g6<T>(x: T) { return x as? u8 }
const t = 3 > 2
const f = 3 < 2
print(g(t) ?? -7)
print(g2(t))
print(g3(t) ?? -7)
print(g4(f) ?? -7)
print(g5(true) + 0.5)
print(g6(f) ?? -7)
print(g6(300) ?? -7)
print(g5(2))
