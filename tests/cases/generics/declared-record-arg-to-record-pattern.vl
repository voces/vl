// @run
// A declared record handed to a parameter spelled as an object shape over type parameters
// binds them field by field, as an anonymous record does (D3674).
type V = { x: f64 }
type I = { x: i32 }
type Wide = { x: i32, y: i32 }
type P = { a: i32, b: string }
type O = { v: I }
function setX<T>(r: { x: T }, v: T) { r.x = v }
function getX<T>(r: { x: T }): T { r.x }
function second<A, B>(r: { a: A, b: B }): B { r.b }
function first<T>(rs: { x: T }[]): T { rs[0].x }
function inner<T>(o: { v: { x: T } }): T { o.v.x }
const a: V = { x: 1.0 }
setX(a, 2.5)
print(a.x)
const i: I = { x: 7 }
print(getX(i) + 1)
const w: Wide = { x: 1, y: 2 }
setX(w, 30)
print(w.x + w.y)
const p: P = { a: 1, b: "bee" }
print(second(p))
const xs: I[] = [{ x: 11 }]
print(first(xs))
const o: O = { v: { x: 12 } }
print(inner(o))
// @log 2.5
// @log 8
// @log 32
// @log bee
// @log 11
// @log 12
