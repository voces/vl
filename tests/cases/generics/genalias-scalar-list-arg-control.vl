// @run
// @log 7
// @log 1.5
// @log 6000000000
// @log 1.5
// @log a
// @log true
// @hint redundant type annotation: `bi` is inferred as `{v: i32[]}`
// @hint redundant type annotation: `bf` is inferred as `{v: f64[]}`
// @hint redundant type annotation: `bl` is inferred as `{v: i64[]}`
// @hint redundant type annotation: `bt` is inferred as `{v: string[]}`
// @hint redundant type annotation: `bb` is inferred as `{v: boolean[]}`
// THE DOWN-SIDE CONTROL for `u8-field-through-generic-alias.vl`. That file adds a
// LOUD refusal inside `gaeEnsure`'s field loop, and a refusal is only a fix if it declines
// exactly one thing. The refused arm sits in the middle of `fieldCodeOfSpelling`'s
// scalar-list ladder, so this file instantiates the alias at EVERY OTHER member of that
// ladder — the six list spellings a struct field does lower — and reads each one back.
//
// `Box<i32[]>` alone would not be the control: the ladder's arms are separate tests, and a
// guard written one arm too wide takes the f64 / i64 / f32 / string / boolean backings with
// it while the i32 one keeps working.
type Box<T> = { v: T }

const bi: Box<i32[]> = { v: [7] }
const bf: Box<f64[]> = { v: [1.5] }
const bl: Box<i64[]> = { v: [6000000000] }
const bs: Box<f32[]> = { v: [1.5] }
const bt: Box<string[]> = { v: ["a"] }
const bb: Box<boolean[]> = { v: [true] }

print(bi.v[0])
print(bf.v[0])
print(bl.v[0])
print(bs.v[0])
print(bt.v[0])
print(bb.v[0])
