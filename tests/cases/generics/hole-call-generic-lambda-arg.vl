// @run
// @log 3
// @log 3
// @log 5
// @log true
// @log 12
// @log 8
// @log 5
// @log s
// @log 7
// @log h
// @log 4
// A declared generic handed to a hole and called there with an un-annotated lambda binds the
// lambda's parameter and result as the direct call does, whichever side the lambda is on, with
// a capture, a list result, a type parameter left open, and beside a direct call at another
// type (D6543).
function app<T, U>(f: (T) => U, v: T): U { f(v) }
function app2<T, U>(v: T, f: (T) => U): U { f(v) }
function via(a) { print(a((n) => n + 1, 2)) }
via(app)
function viaLen(a) { print(a((s) => s.length, "abc")) }
viaLen(app)
function viaAfter(a) { print(a(2.5, (x) => x * 2.0)) }
viaAfter(app2)
function viaBlock(a) {
  print(
    a(
      (n) => {
        const m = n * 3
        m > 5
      },
      2,
    ),
  )
}
viaBlock(app)
function viaCap(a, k) { print(a((n) => n + k, 2)) }
viaCap(app, 10)
function viaRec(a) {
  const r = a((n) => [n, n * 2], 4)
  print(r[1])
}
viaRec(app)
function viaT<T>(a, x: T) { return a((n) => n, x) }
print(viaT(app, 5))
print(viaT(app, "s"))
function viaH(a, x) { return a((n) => n, x) }
print(viaH(app, 7))
print(viaH(app, "h"))
const r = app((n) => [n, n], 4)
print(r[0])
