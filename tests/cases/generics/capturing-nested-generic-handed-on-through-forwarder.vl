// A capturing nested generic handed on through one or two forwarders to a parameter that calls it
// is built under its encloser's instance (D15592).
function mid<F>(a: F) { print(a("x")) }
function fwd<G>(g: G) { mid(g) }
function fwd2<H>(g: H) { fwd(g) }
function outer<U>(u: U) {
  function same<T>(k: T): T {
    print(u)
    k
  }
  fwd(same)
}
outer(7)
function outer2<U>(u: U) {
  function same<T>(k: T): T {
    print(u)
    k
  }
  fwd(same)
}
outer2(7)
outer2("s")
function outer3<U>(u: U) {
  function same<T>(k: T): T {
    print(u)
    k
  }
  fwd2(same)
}
outer3(7)
function midh(a) { print(a("x")) }
function fwdh(g) { midh(g) }
function outer4<U>(u: U) {
  function same<T>(k: T): T {
    print(u)
    k
  }
  fwdh(same)
}
outer4(7)
