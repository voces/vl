// @run
// A generic's declared record result holding `T` beside inline literals, or a `T` pinned to a
// nullable or a union beside a literal union, is spelled the way its field unions register (D7900).
type K = "a" | "b"
type L = "x" | "y"
type B = { n: i32 }

function r<T>(x: T): { v: T | "a" | "b" } { return { v: x } }
function one<T>(x: T): { v: T | "a" } { return { v: x } }
function rk<T>(x: T): { v: T | K } { return { v: x } }
function ri<T>(x: T): { v: T | i32 } { return { v: x } }
function rb<T>(x: T, b: B): { v: T | "a", b: B } { return { v: x, b: b } }
function nest<T>(x: T): { w: { v: T | "a" | "b" } } { return { w: { v: x } } }
function lst<T>(x: T): { v: T | "a" | "b" }[] { return [{ v: x }] }
function plus(q: { v: i32 | "a" | "b" }): i32 {
  return if q.v is i32 { q.v + 100 } else { 0 }
}

print(r(3).v)
const q = r(5)
print(q.v)
const qa: { v: i32 | "a" | "b" } = r(6)
print(qa.v)
print(plus(r(7)))
print(r(1.25).v)
print(r(true).v)
print(one(4).v)
const s: i32 | string = "zz"
print(r(s).v)
const n: i32 | null = 8
print(rk(n).v)
const nn: i32 | null = null
print(rk(nn).v)
const l: L | null = "y"
print(ri(l).v)
const ln: L | null = null
print(ri(ln).v)
print(rb(9, { n: 2 }).b.n)
print(nest(10).w.v)
print(lst(11)[0].v)
// @hint redundant type annotation: `plus` is inferred as `i32`
// @hint redundant type annotation: `qa` is inferred as `{v: i32 | "a" | "b"}`
// @log 3
// @log 5
// @log 6
// @log 107
// @log 1.25
// @log true
// @log 4
// @log zz
// @log 8
// @log null
// @log y
// @log null
// @log 2
// @log 10
// @log 11
