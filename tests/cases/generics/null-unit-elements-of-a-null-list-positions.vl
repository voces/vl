// @run
// @log 3
// @log true
// @log 1
// @log true
// A `null[]` literal's elements typed at the `null` unit, a generic's `T | null` at `T = never`,
// are each the list's null: a parameter beside a `null` literal, an element of a nested instance,
// and a list returned through another.
function mixed<T>(x: T | null) { return [x, null, x] }
function inner<T>(x: T | null) { return [x] }
function outer<T>(x: T | null) { return inner(x) }
print(mixed(null).length)
print(mixed(null)[1] == null)
print(outer(null).length)
print(outer(null)[0] == null)
