// @hint redundant type annotation: `n` is inferred as `i32`
// @run
// @log 3
// @log x
// @log 2
// D10882: a generic alias whose field is an inline nested record, read through that record
// inside a generic body, takes the record row the instance's parameter type names.
type B<U> = { s: { g: U } }
type L<U> = { s: { g: U[] } }

function f<T>(v: B<T>): T { v.s.g }
function n<T>(v: L<T>): i32 { v.s.g.length }

print(f({ s: { g: 3 } }))
print(f({ s: { g: "x" } }))
print(n({ s: { g: [3, 4] } }))
