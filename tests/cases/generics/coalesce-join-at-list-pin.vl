// @run
// `a ?? 5` over a type parameter pinned at `i32[]` is the join `i32[] | i32`: an un-annotated
// binding of it, the instance's result, and a union `==` against the parameter all read that
// box, at every spelling a caller can write (D10600).
function tail<T>(a: T) { a ?? 5 }
function bound<T>(a: T) {
  const r = a ?? 5
  return r
}
function annot<T>(a: T): T | i32 {
  const r = a ?? 5
  r
}
function joined<T>(a: T, b: T, c: boolean) {
  const r = if c { a ?? 5 } else { b }
  r
}
function renamed<T>(a: T, b: T, c: boolean) {
  const r = if c { a ?? 5 } else { b }
  const s = r
  s
}
function early<T>(a: T, b: T, c: boolean) {
  if !c { return b }
  const r = if c { a ?? 5 } else { b }
  return r
}
function same<T>(a: T, b: T, c: boolean) {
  const r = if c { a ?? 5 } else { b }
  if r == b { print("eq") }
  r
}
const u = [1, 2]
const w = [3]
const v1 = tail(u)
if v1 is i32[] { print(v1.length) } else { print(v1) }
const v2 = bound(u)
if v2 is i32[] { print(v2.length) } else { print(v2) }
const v3 = annot(u)
if v3 is i32[] { print(v3.length) } else { print(v3) }
const v4 = joined(u, w, false)
if v4 is i32[] { print(v4.length) } else { print(v4) }
const v5 = renamed(u, w, true)
if v5 is i32[] { print(v5.length) } else { print(v5) }
const v6 = early(u, w, false)
if v6 is i32[] { print(v6.length) } else { print(v6) }
const v7 = same(u, w, false)
if v7 is i32[] { print(v7.length) } else { print(v7) }
const v8 = same(u, w, true)
if v8 is i32[] { print(v8.length) } else { print(v8) }
// @log 2
// @log 2
// @log 2
// @log 1
// @log 2
// @log 1
// @log eq
// @log 1
// @log 2
