// @run
// @log 1
// @log 5
// @log 9
// @log 2
// @log 2
// @log 7
// @log 2
// @hint Intentionally-unused parameter `_e`
// D12900: a closure inside a generic body whose `T` pins to a union arm returns that arm. The
// instance spells the pinned `T` by shape, and the closure's result row is the arm's own row
// whether `T` is read back as a declared name or as that shape.

type C = { r: i32 }
type S = { s: i32 }
type U = C | S
type D = { r: i32 }
type V = D | S
const cs: C[] = [{ r: 1 }, { r: 2 }]
const ss: S[] = [{ s: 5 }]
const ds: D[] = [{ r: 9 }]

function ap<T>(x: T): T {
  const f = (e: T) => e
  f(x)
}
function fl<T>(xs: T[]): T[] { xs.filter((_e) => true) }
function mi<T>(xs: T[]): T[] { xs.map((e) => e) }
function mk<T>(xs: T[]) { xs.map((_e) => 7) }

// Each arm of one union, and a same-shaped arm of another.
print(ap(cs[0]).r)
print(ap(ss[0]).s)
print(ap(ds[0]).r)
// The list callbacks inside a generic body.
print(fl(cs)[1].r)
print(mi(cs)[1].r)
print(mk(cs)[1])
// The un-annotated binding of the result.
const back = ap(cs[1])
print(back.r)
