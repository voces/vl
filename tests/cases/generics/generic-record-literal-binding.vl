// @run
// @log 1
// @log 1
// @log s
// @log 2.5
// @log 7
// @log 4
// @log 7
// @log 7
// @log true
// An un-annotated binding of an object literal whose shape mentions a type parameter takes the
// shape at each pin as its annotation, so every instance has a struct row (D2804).
function len<T>(t: T) { const o = { v: [t] }; print(o.v.length) }
function one<T>(t: T) { const o = { v: t }; print(o.v) }
function two<T>(t: T) { const o = { v: [t], n: 3 }; print(o.v.length + o.n) }
function nested<T>(t: T) { const o = { w: { v: t } }; print(o.w.v) }
function captured<T>(t: T) {
  const o = { v: t }; const g = () => o.v; print(g())
}
function isI32<T>(t: T) { const o = { v: t }; print(o.v is i32) }
len(7)
len("s")
one("s")
one(2.5)
one(7)
two(7)
nested(7)
captured(7)
const u: i32 | string = 3
isI32(u)
