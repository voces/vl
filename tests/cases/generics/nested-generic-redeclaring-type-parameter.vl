// @log true
// A nested generic that declares a type parameter its enclosing function declares too has its
// body's demands checked at its own calls, not at the enclosing function's pin (D3853).
function f(n: i32) { print(n) }
function a<T>(x: T) {
  function b<T>(y: T) {
    const n: i32 = y
    print(n + 1)
  }
  b(1)
  print(x)
}
a(true)
function add<A>(x: A) {
  function b<A>(y: A) { print(y + 1) }
  b(1)
  print(x)
}
add(true)
function ret<R>(x: R) {
  function b<R>(y: R): i32 { y }
  print(b(1))
  print(x)
}
ret(true)
function len<L>(x: L) {
  function b<L>(y: L) { print(y.length) }
  b([1, 2])
  print(x)
}
len(true)
function arg<G>(x: G) {
  function b<G>(y: G) { f(y) }
  b(3)
  print(x)
}
arg(true)
function cmp<C>(x: C) {
  function b<C>(y: C) { print(y < 2) }
  b(1)
  print(x)
}
cmp("s")
function idx<I>(x: I) {
  function b<I>(y: I) { print(y[0]) }
  b([7])
  print(x)
}
idx(true)
function viaLambda<V>(x: V) {
  function b<V>(y: V) {
    const n: i32 = y
    print(n)
  }
  const g = () => b(4)
  g()
  print(x)
}
viaLambda(true)
