// @run
// @log u
// @log null
// @log 5
// @log null
// An un-annotated parameter joined with `null` is its nullable, re-joined at each call, so at an
// `i32 | string` pin the `null` arm is the box's own null (D3116).
function f(x, c: boolean) {
  const y = if c { x } else { null }
  print(y)
}
const v0: i32 | string = "u"
f(v0, true)
f(v0, false)
const v1: i32 | string = 5
f(v1, true)
f(v1, false)
