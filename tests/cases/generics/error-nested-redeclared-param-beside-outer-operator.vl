// @error argument 1: operator '+' is not defined for boolean and i32
// The enclosing function's own `+` on its `T` is checked at its pin beside a nested generic
// that redeclares `T` and adds to its own (D3853 review).
function a<T>(x: T) {
  function b<T>(y: T) { print(y + 1) }
  print(x + 1)
}
a(true)
