// @run
// @log 8
// @log 7
// @log 2.5
// D3047 — a literal at a type parameter takes the declared row of its pin's own kind before
// one the pin widens to, whatever the declaration order, and a list of it keeps the row the
// list names (the D3032 review's B1 and B2).
type Xn = { k: i32 | null }
type Xi = { k: i32 }
type Yf = { j: f64 }
type Yl = { j: i64 }
function g(x) {
  const o = { k: x }
  return o.k
}
print(g(7) + 1)
function h<T>(x: T): T {
  const o = { j: x }
  const xs = [o]
  xs[0].j
}
print(h(7))
print(h(2.5))
