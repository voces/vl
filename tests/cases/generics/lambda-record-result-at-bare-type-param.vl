// @log 3
// A lambda whose result is an anonymous record, handed to a generic's bare type parameter,
// binds it at the lambda's own function type (D16890).
function id<T>(x: T): T { return x }
const f = id(() => ({ a: 5 }))
print(f().a)
const p = id((x: i32) => ({ a: x + 5 }))
print(p(2).a)
const k = () => ({ a: 6 })
const kk = id(k)
print(kk().a)
function use(g: (x: i32) => {a: i32} | f64) {
  const r = g(1)
  if r is f64 { return 0 }
  return r.a
}
print(use(id((x: i32) => ({ a: x + 5 }))))
const two = id(() => ({ a: 5, b: "s" }))
print(two().b)
function second<T>(x: T, y: T): T { return [x, y][1] }
const sec = second(() => ({ a: 1 }), () => ({ a: 2 }))
print(sec().a)
function box<T>(x: T): T[] { return [x] }
const fs = box(() => ({ a: 7 }))
print(fs[0]().a)
const nest = id(() => ({ a: { b: 8 } }))
print(nest().a.b)
const lst = id(() => ({ a: [9] }))
print(lst().a[0])
function inner() {
  const g = id(() => ({ a: 10 }))
  return g().a
}
print(inner())
const other = id(() => ({ b: "t", c: 2.5 }))
print(other().b)
print(other().c)
print(id(3))
