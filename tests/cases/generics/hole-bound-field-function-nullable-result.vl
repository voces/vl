// @run
// @log null
// @log a
// A hole-bound field function whose result is not a scalar or a string is called at the
// type its record's own instance binds, a nullable scalar and a literal union alike (D3165).
function F(z) {
  const g = z.f
  print(g())
}
const r0 = { f: (): i32 | null => null }
F(r0)
const r1 = { f: (): "a" | "b" => "a" }
F(r1)
