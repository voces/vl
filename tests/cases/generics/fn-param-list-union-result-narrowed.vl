// @run
// @log 2
// @log 3
// @log 9
// @log a
// @log 1
// @log 2
// @log 2
// A generic's `() => T[] | i32` parameter binds `T` through the function's union result, so the
// call's result narrowed past `is i32` is the list (D10031).
function len<T>(f: () => T[] | i32) {
  const t = f()
  if t is i32 { t } else { t.length }
}
const g: () => i32[] | i32 = () => [1, 2]
const h: () => string[] | i32 = () => ["a", "b", "c"]
print(len(g))
print(len(h))
print(len((): i32[] | i32 => 9))
function first<T>(f: () => T[] | i32, d: T): T {
  const t = f()
  if t is i32 { d } else { t[0] }
}
print(first(h, "z"))
function cnt<T>(f: (n: i32) => T[] | i32) {
  const t = f(4)
  if t is i32 { t } else { t.length }
}
print(cnt((n: i32): f64[] | i32 => if n > 2 { [1.5] } else { n }))
function mkG<V>(x: V): () => V[] | i32 {
  (): V[] | i32 => [x, x]
}
print(len(mkG("q")))
print(len(mkG(1.5)))
