// @trap
// An `as!` over `T | null` pinned where no member can be the target traps there, as one over a
// type parameter pinned at no number does (D2791, D16323); the pin where it fits hits first.
function count<T>(u: T | null) { (u as! Set<i32>).length }

const s: Set<i32> = Set()
s.add(1)
print(count<Set<i32>>(s))
print(count<string>("ab"))
