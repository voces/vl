// @run
// @warning Unused parameter
// @hint redundant type annotation
// @log false
// @log false
// @log true
// @log 7
// D7484: the same call inside a generic body at two instances, with an inferred return, and
// with one parameter naming `T`.
function two<T>(x: T): i32 { return 1 }
function three<T>(x: T): i32 { return 3 }
function same<T>(f: (x: T) => i32, g: (x: T) => i32): boolean { return f == g }
function outer<U>(u: U): boolean { return same(two, three) }
function alike<T>(f: (x: T) => i32, g: (x: T) => i32) { return f == g }
function seven<T>(f: (x: T) => i32): i32 { return 7 }
print(outer("w"))
print(outer(4))
print(alike(three, three))
print(seven(two))
