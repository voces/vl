// D13620: an `if` or `match` of generics handed beside the caller's own un-annotated parameter,
// to a callee that calls it at that parameter's type, takes the per-type instance of each arm.
function both2(n, f) {
  print(f("a"))
  return f(n)
}
function only(n, f) { return f(n) }
function inner(s) { return s }
function twice(s) { return s + s }
function thrice(s) { return s + s + s }
let k = false
let seq = 0
function flip() {
  seq = seq + 1
  print("flip")
  return seq % 2 == 1
}
function tick() {
  seq = seq + 1
  print("tick")
  return seq
}
function two(a, b) {
  print(a)
  return b
}

// The witness, and its annotated twin.
function g(z) { print(both2(z, if k { twice } else { inner })) }
function gA(z: i32) { print(both2(z, if k { twice } else { inner })) }
g(3)
gA(3)
k = true
g(3)
gA(3)

// A `match` and an else-if chain.
let m = 0
function gm(z) {
  print(
    both2(
      z,
      match m {
        0 => twice
        _ => inner
      },
    ),
  )
}
function ge(z) {
  print(both2(z, if m == 0 { twice } else if m == 1 { thrice } else { inner }))
}
gm(4)
ge(4)
m = 1
gm(4)
ge(4)
m = 2
ge(4)

// A side-effecting condition, at three argument types.
function gf(z) { return only(z, if flip() { twice } else { inner }) }
print(gf(2))
print(gf(2.5))
print(gf("q"))
print(gf("q"))

// Evaluation order: the outer call's first argument runs before the choice.
function go(z) {
  print(two(tick(), both2(z, if flip() { twice } else { inner })))
}
go(5)
go(5)

// A second delivery position: bound by `let`, and returned.
function gl(z) {
  const r = only(z, if k { thrice } else { inner })
  return r
}
k = true
print(gl(7))
print(gl("b"))
k = false
print(gl(7))
