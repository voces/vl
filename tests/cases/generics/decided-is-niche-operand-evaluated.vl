// @run
// @log 8
// @log 1
// @log 7
// @log 2
// @log false
// @log 3
// An instance's `is` that can never match a niche-held `T | null` is decided `false`, and its
// operand still runs for its effect, in statement and value position alike (D17021).
let calls = 0
function mk<T>(x: T): T | null {
  calls = calls + 1
  return x
}
function g3<T>(x: T): i32 {
  if mk(x) is i32 { return 7 }
  return 8
}
function g6<T>(x: T): boolean { return mk(x) is i32 }
print(g3("x"))
print(calls)
print(g3(1))
print(calls)
print(g6("y"))
print(calls)
