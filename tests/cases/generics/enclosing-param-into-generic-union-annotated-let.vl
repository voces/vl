// @run
// @log 3
// @log 100
// @log 100
// @log 3
// @hint redundant type annotation: `t` is inferred as `T | string`
// An instance's call binds the template's `T := U` under its substitution, so `len` at
// `U = string` reads `t: T | string` as `string`, not at the default `i32` (D14500). The last
// line is the direct spelling, where nothing binds `T` and the default stands.
function len<T>(f: () => T | string) {
  const t: T | string = f()
  if t is string { t.length } else { 100 }
}
function outer<U>(x: U) { print(len(() => x)) }
outer("abc")
outer(2.5)
outer(7)
print(len(() => "abc"))
