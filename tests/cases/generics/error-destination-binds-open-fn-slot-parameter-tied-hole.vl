// @check
// @hint Intentionally-unused parameter `_a`
// @error-at 9:36 argument 1: expected (f64, string) => f64, got (_, _) => _
// The un-annotated spelling: a hole function returning its second parameter ties it to the slot's
// result, and a destination that binds them apart is refused at the argument (D16563).
function hsnd(_a, b) { b }
function bind1<A, B>(f: (a: A, b: B) => A, a: A): (b: B) => A {
  (b: B) => f(a, b)
}
const v: (b: string) => f64 = bind1(hsnd, 2.5)
print(v("s"))
