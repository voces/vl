// @run
// @log 7
// @log 1
// @log 7
// A bounded type parameter pinned at a record whose field is one member of the bound's union
// tests that member true (D15544).
function boundShow<T: { x: i32 | string }>(t: T) {
  if t.x is i32 { print(t.x) }
}
function boundElse<T: { x: i32 | string }>(t: T) {
  if t.x is i32 { print(1) } else { print(t.x) }
}
const a: { x: i32 } = { x: 7 }
boundShow(a)
boundElse(a)
const w: { x: i32 | string } = { x: 7 }
boundShow(w)
