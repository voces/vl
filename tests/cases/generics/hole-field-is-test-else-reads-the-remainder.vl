// @run
// @log 5
// @log bee
// @log 3
// @log bee
// @log bee
// @log 3
// @log bee
// @log tee
// @log tee
// @log dee
// @log sea
// The else arm of an `is` test on a hole's field reads the field at the pin's remainder, so it
// prints a union's other member and reads that member's fields, at every spelling, and a
// second test over the remainder narrows it again, to any depth (D3216).
type H = { v: i32 }
function P(z) {
  if z.h is H { print(z.h.v) } else { print(z.h) }
}
const p: { h: H | i32 } = { h: 5 }
P(p)
type A = { v: i32 }
type B = { s: string }
const a: { h: A | B } = { h: { s: "bee" } }
const b: { h: A | B } = { h: { v: 3 } }
function E(z) {
  if z.h is A { print(z.h.v) } else { print(z.h.s) }
}
E(a)
E(b)
function R(z) {
  if z.h is A { return }
  print(z.h.s)
}
R(a)
function G<Z>(z: Z) {
  const k = z.h
  if !(k is A) { print(k.s) } else { print(k.v) }
}
G(a)
G(b)
function I(z) {
  if z.h is B { print(z.h.s) } else { print(z.h.v) }
}
I(a)
type C = { t: string }
type D = { d: string }
function E2(z) {
  if z.h is A { print(z.h.v) }
  else if z.h is B { print(z.h.s) }
  else { print(z.h.t) }
}
const c: { h: A | B | C } = { h: { t: "tee" } }
E2(c)
function E2g<Z>(z: Z) {
  const k = z.h
  if k is A { return }
  if k is B { return }
  print(k.t)
}
E2g(c)
function E3(z) {
  if z.h is A { print(z.h.v) }
  else if z.h is B { print(z.h.s) }
  else if z.h is C { print(z.h.t) }
  else { print(z.h.d) }
}
const e: { h: A | B | C | D } = { h: { d: "dee" } }
E3(e)
const f: { h: A | B | C | D } = { h: { t: "sea" } }
E3(f)
