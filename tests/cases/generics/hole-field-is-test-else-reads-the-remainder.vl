// @run
// @log 5
// @log bee
// @log 3
// @log bee
// @log bee
// @log 3
// @log bee
// The else arm of an `is` test on a hole's field reads the field at the pin's remainder, so it
// prints a union's other member and reads that member's fields, at every spelling (D3216).
type H = { v: i32 }
function P(z) {
  if z.h is H { print(z.h.v) } else { print(z.h) }
}
const p: { h: H | i32 } = { h: 5 }
P(p)
type A = { v: i32 }
type B = { s: string }
const a: { h: A | B } = { h: { s: "bee" } }
const b: { h: A | B } = { h: { v: 3 } }
function E(z) {
  if z.h is A { print(z.h.v) } else { print(z.h.s) }
}
E(a)
E(b)
function R(z) {
  if z.h is A { return }
  print(z.h.s)
}
R(a)
function G<Z>(z: Z) {
  const k = z.h
  if !(k is A) { print(k.s) } else { print(k.v) }
}
G(a)
G(b)
function I(z) {
  if z.h is B { print(z.h.s) } else { print(z.h.v) }
}
I(a)
