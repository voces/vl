// @run
// @log 7
// @log 8
// @log 3
// @log null
// D6360: the element-or-null list returned from the generic and delivered to an annotated
// parameter, and the same callback inside a function whose parameter is un-annotated.
function t<T>(x: T) {
  return [x].map((e) => {
    if e != null { return e }
    return null
  })
}
function show(xs: (i32 | null)[]) {
  for v in xs { print(v) }
}
show(t(7))
const q = t(8)
print(q[0])
function h(x) {
  const n = [x].map((e) => {
    if e != null { return e }
    return null
  })
  for y in n { print(y) }
}
h(3)
const a: string | null = null
h(a)
