// @run
// @log n=2
// @log none
// A decided list test's region reads its receiver inside an interpolation hole, the Q58 position the
// ir-shadow-rows sweep (is-decided-fit-shadow-positions) cannot hold, since its rows build without std.
function pInterp<V>(v: V) {
  if v is f64[] { print("n=\{v.length}") } else { print("none") }
}
const fs = [1.5, 2.5]
const ns = [1]
pInterp(fs)
pInterp(ns)
