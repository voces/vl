// @check
// @hint redundant type annotation: `x` is inferred as `{h: {v: i32}}` — remove it to lean on inference
// @error no field 's' on A (the body of `F` at the call's argument types)
// A write in the arm of a negated `is` re-narrows a hole's field to the member the value lands
// on at the pin, so a read of another member is refused there, as at the annotated spelling (D3249).
type A = { v: i32 }
type B = { s: string }
function F(z) {
  if !(z.h is A) {
    print("then")
  } else {
    z.h = { v: 9 }
    print(z.h.s)
  }
}
const x: { h: A } = { h: { v: 3 } }
F(x)
