// @run
// @log 2:hit 2
// @log 2->1
// D3793: a generic over a `readonly` list read through a record field kept the structural pin,
// which softens `kind: "hit"` and unfolds a recursive record, so the instance's rows did not
// twin the declared ones. A view shares its list's rep, so it pins the declared name too.
import { toString } from "std:fmt"

type Hit = { tick: i32, kind: "hit" }
type Miss = { reason: string, kind: "miss" }
type St = { key: i32, evs: (Hit | Miss)[] }
type H = { ro: readonly St[] }
type Node = { v: i32, next: Node | null }
type Hn = { ro: readonly Node[] }
function g<T>(x: readonly T[]): T { return x[1] }
function mk(k: i32): St { return { key: k, evs: [{ tick: k, kind: "hit" }] } }
const a = [mk(1), mk(2), mk(3)]
const h: H = { ro: a }
const r = g(h.ro)
const e = r.evs[0]
if e is Hit {
  print(r.key.toString() + ":hit " + e.tick.toString())
} else {
  print("miss")
}
const n1: Node = { v: 1, next: null }
const n2: Node = { v: 2, next: n1 }
const xs = [n1, n2]
const hn: Hn = { ro: xs }
const rn = g(hn.ro)
const nx = rn.next
if nx != null {
  print(rn.v.toString() + "->" + nx.v.toString())
} else {
  print("none")
}
