// @run
// @log 2
// @log b
// @log none
// @log yes
// A `(T | null)[]` over a type parameter bound to a string literal union reads its elements at
// the instance's rep, the literal union's niche (D12451).
type K = "a" | "b"
function f<T>(x: T): (T | null)[] { [x, null] }
const k: K = "b"
const r = f(k)
print(r.length)
print(r[0] ?? "none")
print(r[1] ?? "none")
if r[0] == "b" { print("yes") } else { print("no") }
