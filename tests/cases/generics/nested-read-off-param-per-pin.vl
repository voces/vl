// @run
// @log 1
// @log 2
// @log 3
// Nested reads off a type parameter that every pin's argument carries run (D1433).
function a<T>(x: T): i32 { x.inner.foo }
function b<T>(x: T): i32 { x.inner.bar }
print(a({ inner: { foo: 1 } }))
print(b({ inner: { bar: 2 } }))
function c(x) { x.inner.foo }
print(c({ inner: { foo: 3 } }))
