// @emit-error recursive generic type `A<i32>` is not supported
// MUTUAL recursion between two generic aliases. A declaration-local check cannot see
// it (neither alias mentions itself), which is why the guard tests the CYCLE in the
// resolved arena type rather than the spelling of any one declaration.
type A<T> = { b: B<T> | null, v: T }
type B<T> = { a: A<T> | null, w: T }

const x: A<i32> = { b: null, v: 1 }
print(x.v)
