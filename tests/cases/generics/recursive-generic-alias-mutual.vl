// @run
// @log 6
// Mutual recursion between two generic aliases: neither declaration mentions itself, so
// finiteness is a cycle in the resolved type graph, through the nullable fields.
type A<T> = { b: B<T> | null, v: T }
type B<T> = { a: A<T> | null, w: T }

const x: A<i32> = { b: { a: { b: null, v: 3 }, w: 2 }, v: 1 }
let s = x.v
const xb = x.b
if xb != null {
  s = s + xb.w
  const xa = xb.a
  if xa != null { s = s + xa.v }
}
print(s)
