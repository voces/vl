// @run
// @log 4
// @log 2
// @log 2
// Q58 position sweep: a list of un-annotated functions handed to an un-annotated generic's
// parameter, whose closure list legacy keys at the parameter's wrapper: a binding's initializer,
// a print operand, a call inside a function.
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function id(x) { return x }
const r = id([inc0, half])
print(r[0](3))
print(id([inc0, half]).length)
function inFn() {
  print(id([inc0, half]).length)
}
inFn()
