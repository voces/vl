// @run
// @log 4
// @log 5
// @log x
// @warning `n != null` is always true here (n is Box<i32>)
// D14300 at a nullable inline union and at a two-argument application: both are variant boxes,
// so a null-initialised global takes either arm.
type Box<T> = { v: T }
type Pair<A, B> = { a: A, b: B }
type Tag = { t: i32 }

let n: Box<i32> | Tag | null = null
n = { v: 4 }
if n is Tag { print(n.t) }
else if n != null { print(n.v) }
n = { t: 5 }
if n is Tag { print(n.t) }
let p: Pair<i32, string> | Tag = { t: 6 }
p = { a: 7, b: "x" }
if p is Tag { print(p.t) } else { print(p.b) }
