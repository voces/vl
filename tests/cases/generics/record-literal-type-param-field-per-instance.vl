// @run
// @log 1
// @log s
// @log 1.5
// @log true
// @log 10000000000
// @log 7
// @log s
// @log 2.5
// @log 0
// @log 0
// @log b
// @log 3
// @log t
// @warning Unused variable `o` (prefix with `_` to suppress, or remove it)
// @hint redundant type annotation: `u` is inferred as `i32` — remove it to lean on inference
// D3032 — a record literal whose field is a type parameter is built at its instance's type:
// every pin gets a row of its own, and no declared record of the same field names claims it.
type X = { k: i32, n: i32 }
type U = X | { z: i32 }
function g<T>(x: T): T {
  const o = { k: x, n: 1 }
  o.k
}
print(g(1))
print(g("s"))
print(g(1.5))
print(g(true))
print(g(10000000000))
print(g({ a: 7 }).a)
function h(x) { return { k: x, n: 1 } }
print(h("s").k)
print(h(2.5).k)
function u<T>(x: T): i32 {
  const o = { k: x, n: 1 }
  0
}
print(u(1))
print(u("s"))
function c<T>(x: T): T {
  let o = { k: x, j: x, n: 1 }
  o = { k: x, j: x, n: 2 }
  const f = () => o.j
  f()
}
print(c("b"))
print(c(3))
print(c("t"))
