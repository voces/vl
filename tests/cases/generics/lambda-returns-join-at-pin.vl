// @run
// @log n
// @log 4
// @log n
// @log 1
// @log n
// @log s
// @log 3
// @log null
// @log true
// A `.map` callback with a return beside its tail or last return joins them at the instance's
// pin, so an early `return "n"` does not type the whole callback (D3125).
function h(x) {
  print(
    [x].map((e) => {
      if e == null { return "n" }
      return e
    })[0],
  )
}
const a: i32 | null = null
h(a)
const b: i32 | null = 4
h(b)
function t<T>(x: T) {
  const m = [x].map((e) => {
    if e == null { return "n" }
    e
  })
  print(m[0])
  print(m.length)
}
t(a)
function s(x) {
  for y in [x].map((e) => {
    if e == null { return "n" }
    return e
  }) {
    print(y)
  }
}
const c: string | null = null
s(c)
const d: string | null = "s"
s(d)
function f<T>(x: T) {
  print(
    [x].map((e) => {
      if e == null { return 0 }
      return e
    })[0],
  )
}
const g: i32 | null = 3
f(g)
function u(x) {
  const m = [x].map((e) => {
    if e != null { return e }
    return null
  })
  print(m[0])
}
const sn: string | null = null
u(sn)
function v(x) {
  const m = [x].map((e) => {
    if e != null { return e }
    return null
  })
  for y in m { print(y) }
}
v(true)
