// @run
// @log 9
// @log no
// @hint redundant type annotation: `r` is inferred as `T | string`
// @hint redundant type annotation: `h` is inferred as `i32`
// A record guard in a body pinned at the record and at a literal union answers false at the
// literal union's pin, whose value reps as a string, not a box (D2976).
type R = { x: i32 }
type K = "a" | "b"
function h<T>(a: T, c: boolean): i32 {
  const r: T | string = if c { a } else { "z" }
  if r is R {
    print(r.x)
    return 1
  }
  print("no")
  return 0
}
const pv0: R = { x: 9 }
h(pv0, true)
const pv1: K = "a"
h(pv1, true)
