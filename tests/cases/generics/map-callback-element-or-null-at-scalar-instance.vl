// @run
// @log 4
// @log 4
// @log null
// @log null
// @log 2.5
// @log 2.5
// @log null
// @log null
// @log 4
// D6360: an un-annotated `.map` callback returning its element or `null` returns the element's
// nullable at each instance, scalar or not, whichever of the two returns comes first.
function t<T>(x: T, keep: boolean) {
  const n = [x, x].map((e) => {
    if keep { return e }
    return null
  })
  for y in n { print(y) }
}
function u<T>(x: T) {
  const n = [x].map((e) => {
    if e == null { return null }
    return e
  })
  for y in n { print(y) }
}
t(4, true)
t(5, false)
t(2.5, true)
t("s", false)
u(4)
