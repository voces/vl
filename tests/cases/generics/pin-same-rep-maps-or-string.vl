// @run
// @log false
// @log true
// @log false
// A `T | string` parameter pinned at `T := IM | BM` holds the pair; each map keeps its tag.
type IM = {[i32]: i32}
type BM = {[i32]: boolean}
const mb: BM = Map()
mb.set(1, true)
const v: IM | BM = mb
function k<T>(u: T | string) { u is IM }
const mi: IM = Map()
const v2: IM | BM = mi
print(k(v))
print(k(v2))
print(k<IM | BM>("s"))
