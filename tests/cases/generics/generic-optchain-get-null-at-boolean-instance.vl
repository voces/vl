// @run
// @log true
// @log false
// @log true
// @log true
// @log true
// @log false
// D15500: a generic's `?.get` default `null` at a `boolean | null` instance is the boolean
// niche's null, returned whole, bound first, or tested before it is returned.
function f<V>(k: {[string]: V} | null): V | null { k?.get("a") }
const b: {[string]: boolean} = Map()
b["a"] = true
print(f(b) ?? false)
const n: {[string]: boolean} | null = null
print(f(n) ?? false)
function g<V>(k: {[string]: V} | null): V | null {
  const x = k?.get("a")
  return x
}
const e: {[string]: boolean} = Map()
print(g(e) ?? true)
print(g(n) ?? true)
function h<V>(k: {[string]: V} | null, d: V): V {
  const x = k?.get("a")
  if x != null { return x }
  return d
}
print(h(n, true))
print(h(e, false))
