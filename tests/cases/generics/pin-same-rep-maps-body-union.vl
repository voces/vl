// @run
// @log false
// @log true
// @log 2
// @log 1
// @log 2
// The union `V | {[i32]: i32}` is formed in the body, so no type argument holds the pair; the
// instance registers the union it mints and boxes each map under its member's tag (D2657).
function g<V>(m: V, n: {[i32]: i32}) {
  const u: V | {[i32]: i32} = m
  print(u is {[i32]: i32})
  const w: V | {[i32]: i32} = n
  print(w is {[i32]: i32})
}
const mb: {[i32]: boolean} = Map()
const mi: {[i32]: i32} = Map()
g(mb, mi)
function h<V>(m: V, n: {[string]: i32}, c: boolean) {
  let u: V | {[string]: i32} = n
  if c { u = m }
  if u is {[string]: i32} { return 1 }
  2
}
const sb: {[string]: boolean} = Map()
const si: {[string]: i32} = Map()
print(h(sb, si, true))
print(h(sb, si, false))
print(h("x", si, true))
