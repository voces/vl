// @check
// @error `T` of `gen` is fixed by none of its parameters
// @error cannot infer type parameter `T`: `gen`'s return type names it and no parameter does
// A generic function value whose type parameter only its result names leaves that parameter
// unbound against the binding's parameters, and is refused by name (D17322).
function same<T>(k: T): T { return k }
function gen<T>(_k: i32): T[] { return [] }
function mid<F, G>(a: F, a1: G) {
  let b: F = a1
  print(a("x"))
  print(a(1))
}
mid(same, gen)
