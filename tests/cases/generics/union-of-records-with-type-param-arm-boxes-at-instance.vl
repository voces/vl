// @run
// @log 1
// @log 2.5
// @log 2.5
// @log 1
// @log 2.5
// A record literal whose field holds a type parameter, delivered into a union of records with
// that parameter's arm, boxes at the instance's arm, not the template's default rep (D15042).
function g<T>(b: boolean, t: T) {
  const v: {f: i32} | {f: T} = if b { { f: 1 } } else { { f: t } }
  print(v.f)
}
function direct<T>(t: T) {
  const v: {f: i32} | {f: T} = { f: t }
  print(v.f)
}
function ret<T>(b: boolean, t: T): {f: i32} | {f: T} {
  if b { return { f: 1 } }
  { f: t }
}
g(true, 2.5)
g(false, 2.5)
direct(2.5)
const a = ret(true, 2.5)
const c = ret(false, 2.5)
print(a.f)
print(c.f)
