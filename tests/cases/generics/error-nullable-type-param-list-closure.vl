// @emit-error a nullable-i32[] list element has no rep; use a non-null element type
// D2525's boundary inside a lambda: a closure capturing a `(V | null)[]` read the element at the
// template's rep when `V` is a list, which was check-clean invalid wasm. The concrete twin
// (`xs: (i32[] | null)[]`) runs; the generic one stays refused until the capture is wired.
function mkGet<V>(xs: (V | null)[]): (i32) => V | null {
  return (i: i32) => xs[i]
}
const s: (i32[] | null)[] = [null, [4, 5]]
const g = mkGet(s)
print(g(0) == null)
