// @run
// @log 1
// @log 2
// @log 2
// @log 3
// A callback over `{ v: A }` handed to a user generic and to std's `sort`, in a program that also
// declares `Box<A[]>`: the record's spelling resolves to its own row, not the one sharing `v` (D3898).
import { sort } from "std:array"

type A = { x: i32 }
function h<T>(x: T) { x.x }
type Box<T> = { v: T }
function ap<T, U>(xs: T[], f: (t: T) => U): U[] {
  const r: U[] = []
  for x in xs { r.push(f(x)) }
  r
}
const ba: Box<A[]> = { v: [{ x: 1 }] }
print(ap([ba], (e) => h(e.v[0]))[0])
const o: { v: A } = { v: { x: 2 } }
print(ap([o], (e) => h(e.v))[0])
const xs: { v: A }[] = [{ v: { x: 3 } }, { v: { x: 2 } }]
xs.sort((a, b) => h(a.v) < h(b.v))
print(xs[0].v.x)
print(xs[1].v.x)
