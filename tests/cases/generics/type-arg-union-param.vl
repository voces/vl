// @run
// @log w
// A PARAMETER whose type is a generic application carrying a union argument
// (`Pair<i32 | null, string>`). The annotation reaches the checker as one rendered
// name, and every top-level scan of it must treat `<…>` as a bracket: an angle-blind
// `|` scan splits the name into the garbage atoms `Pair<i32` and `null,string>`, the
// parameter classifies as a union, and the emitted module fails to compile.
//
// Sibling of `type-arg-list-element.vl`, which was the ONLY corpus witness for the
// generic-bracket leg of the type-name scanner until D-TCSCAN measured it (one file
// out of 1,319). This one, `type-arg-union-return.vl` and
// `type-arg-union-nested-list.vl` are the param / return / nested-element positions
// of the same shape.
type Pair<A, B> = { a: A, b: B }

function show(p: Pair<i32 | null, string>) { print(p.b) }

show({ a: null, b: "w" })
