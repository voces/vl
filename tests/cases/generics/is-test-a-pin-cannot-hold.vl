// @run
// @hint redundant type annotation: `r` is inferred as `T | i32`
// @log no
// @log no
// @log no
// @log no
// @log 2
// @log not
// @log not
// @log 3
// @log 3
// @log 1.5
// @log 3
// @hint redundant type annotation: `two` is inferred as `i32[]`
// @hint redundant type annotation: `negGuard` is inferred as `f64`
// An instance decides an `is` whose tested type its pin's union cannot hold. A list test over
// `T | i32` at a pin with no list member is false and its arm is not lowered (D2955), at a
// scalar pin and at a record pin. A `!is` of such a type is true, so its dead arm, and the
// tail after an arm that exits, are not lowered either (D2957).
type Rec = { x: i32 }
function listTest<T>(a: T, c: boolean) {
  const r: T | i32 = if c { a } else { 5 }
  if r is i32[] { print(r.length) } else { print("no") }
}
listTest(true, true)
const rec: Rec = { x: 9 }
listTest(rec, true)
listTest(rec, false)
function strListTest<T>(a: T, c: boolean) {
  const r: T | i32 = if c { a } else { 5 }
  if r is string[] { print(r.length) } else { print("no") }
}
strListTest(3, true)
const two: i32[] = [4, 5]
listTest(two, true)
function negTest<T>(a: T, c: boolean) {
  const r: T | i32 = if c { a } else { 5 }
  if r !is f64 { print("not") } else { print(r + 0.5) }
}
negTest(3, true)
negTest(3, false)
function negList<T>(a: T, c: boolean) {
  const r: T | i32 = if c { a } else { 5 }
  if r !is i32[] { print(3) } else { print(r.length) }
}
negList(true, true)
negList(rec, false)
function negGuard<T>(a: T, c: boolean): f64 {
  const r: T | i32 = if c { a } else { 5 }
  if r !is f64 { return 1.5 }
  r + 0.5
}
print(negGuard(3, true))
print(negGuard(2.5, true))
