// @check
// @error return type mismatch: expected never, got never | i32 (the return of `G` at the call's argument types; the call binds no type to `A`, so give it an explicit type argument)
// @error return type mismatch: expected never, got never | i32 (the return of `H` at the call's argument types; the call binds no type to `A`, so give it an explicit type argument)
// A type parameter a call leaves open, as D2803 allows, is `never` in that call's deferred return:
// a body that returns a value as the open parameter is refused (D14802).
function G<A>(v: A | i32): A { v }
const y: boolean = G(5)
print(y)
function H<A, B>(v: A | i32, _w: B): A { v }
const z: string = H(5, true)
print(z)
function pr<T>(v: T | string) { print(v) }
pr("q")
