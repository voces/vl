// @run
// @log 3
// @log 3.5
// @log 2
// @log 9000000000
// @log 2.5
// @log 2
// @log 3
// @log 3.5

// D1780 — a nested function that captures its enclosing function's parameter needs its own
// clone per pin, and the instance has to read that clone's return kind rather than the
// template's. Every pair here prints two DIFFERENT values: one shared lifted `k` prints the
// first value twice, which a single-pin fixture cannot see.

function o(n) {
  function k(x: i32) { return x + n }
  return k(1)
}
print(o(2))
print(o(2.5))

// The instance's own signature is the stale half when its outer return carries no synthesized
// annotation; at an i64 pin the annotation is there and a spurious widening shows instead.
function w(n) {
  function k() { return n }
  return k()
}
print(w(2))
print(w(9000000000))

// The reverse direction: the wide type is the template's pin and the narrow one the
// instance's, so the instance must not inherit the template's f64 result.
function r(n) {
  function k() { return n }
  return k()
}
print(r(2.5))
print(r(2))

// An un-annotated nested parameter (ROADMAP B15's floor): a direct call by name pins it, so
// the closure the call synthesizes never escapes and the generic-value floor does not apply.
function h(n) {
  function k(x) { return x + n }
  return k(1)
}
print(h(2))
print(h(2.5))
