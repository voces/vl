// A `match` joining three different type parameters' lists keeps all three as arms: the third
// is not folded into the first two's union, so the instance reads each list as itself (D3346).
function g<T0, T1, T2>(a0: T0[], a1: T1[], a2: T2[], k: i32) {
  const r = match k {
    0 => a0
    1 => a1
    _ => a2
  }
  const e = r[0]
  print(e is i32)
  print(e is string)
  print(e is boolean)
  print(e is null)
}
g(["x"], [false], [6], 0)
g(["x"], [false], [6], 1)
g(["x"], [false], [6], 2)
function h<T0, T1, T2>(a0: T0[], a1: T1[], a2: T2[], k: i32) {
  const r = match k {
    0 => a0
    1 => a1
    _ => a2
  }
  print(r.length)
}
h(["x"], [false], [6], 0)
