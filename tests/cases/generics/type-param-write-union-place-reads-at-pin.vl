// @run
// @log true
// @log n
// @log false
// @log 5
// @log true
// @log n
// @log false
// @log q
// @log true
// @log n
// @log false
// @log 5
// @log 7
// @log 2
// @log 7
// @log 2
// @log 7
// @log 2
// A type-parameter write into a field, a list cell or a module global declared over a
// several-member or number-literal union reads, at each pin, whether the pin can be null (D8820).
type R = { s: string | i32 | null }
type N = 1 | 2
type RN = { s: N | null }
let gs: string | i32 | null = 1
let gn: N | null = 1
function field<T>(x: T, r: R) {
  r.s = x
  print(r.s == null)
  print(r.s ?? "n")
}
function global<T>(x: T) {
  gs = x
  print(gs == null)
  print(gs ?? "n")
}
function cell<T>(x: T) {
  const a: (string | i32 | null)[] = [1]
  a[0] = x
  print(a[0] == null)
  print(a[0] ?? "n")
}
function fieldN<T>(x: T, r: RN) {
  r.s = x
  const k: i32 = r.s ?? 7
  k
}
function globalN<T>(x: T) {
  gn = x
  const k: i32 = gn ?? 7
  k
}
function cellN<T>(x: T) {
  const a: (N | null)[] = [1]
  a[0] = x
  const k: i32 = a[0] ?? 7
  k
}
const v: string | i32 | null = null
field(v, { s: 1 })
field(5, { s: 1 })
global(v)
global("q")
cell(v)
cell(5)
const nv: N | null = null
const nw: N | null = 2
print(fieldN(nv, { s: 1 }))
print(fieldN(nw, { s: 1 }))
print(globalN(nv))
print(globalN(nw))
print(cellN(nv))
print(cellN(nw))
