// @run
// @log 1
// @log 0
// @log 0
// @hint Intentionally-unused variable `_b`
// @hint Intentionally-unused variable `_b`
// A record annotation in a generic body whose field is a list of a union the pin mints
// (`{ v: (V | IM)[] }` at `V := string`) takes a row of its own, and the literal stored in it builds
// its elements boxed, read or not, nested or not (D16947).
type IM = {[i32]: i32}
function h<V>(x: IM) {
  const b: { v: (V | IM)[] } = { v: [x] }
  return b.v.length
}
function u<V>(x: IM) {
  const _b: { v: (V | IM)[] } = { v: [x] }
  return 0
}
function n<V>(x: IM) {
  const _b: { o: { v: (V | IM)[] } } = { o: { v: [x] } }
  return 0
}
const m: IM = Map()
print(h<string>(m))
print(u<string>(m))
print(n<string>(m))
