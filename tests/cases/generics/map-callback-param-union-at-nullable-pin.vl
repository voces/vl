// @run
// @log null
// @log s
// @log 1
// A `.map` callback's declared `T | string` at a `string | null` pin is the niche
// `string | null`, not a box holding a nullable string that no union row reads (D3140).
function g<T>(x: T) {
  const m = [x].map((e): T | string => e)
  print(m[0])
}
function h<T>(x: T) {
  const m = [x].map((e): T | string => e)
  print(m.length)
}
const a: string | null = null
const b: string | null = "s"
g(a)
g(b)
h(a)
