// @run
// @log u
// @log w
// A LIST whose element is a generic application carrying a union argument
// (`Pair<i32 | null, string>[]`). The `[]` peel runs BELOW the union split, so the
// `<>`-blind top-level `|` scan claimed the whole name first and the element never
// resolved.
type Pair<A, B> = { a: A, b: B }

const ps: Pair<i32 | null, string>[] = [{ a: 1, b: "u" }, { a: null, b: "w" }]
let i = 0
while i < ps.length {
  print(ps[i].b)
  i = i + 1
}
