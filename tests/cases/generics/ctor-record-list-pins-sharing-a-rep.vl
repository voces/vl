// @run
// @log 1
// @log true
// @log true
// @log 3
// @log true
// @log true
// D8240: a generic record constructor pinned at `i32` and then `boolean` mints a row for each
// pin, though the two records share one wasm shape, so a list of the second builds as a ref
// list. Each spelling has its own constructor and no annotation names the shape, so nothing
// else gives the pin a row: a binding, two elements and a push, and a function result.

function pc<T>(x: T) { { a: x } }
const p = [pc(1)]
const q = [pc(true)]
print(p[0].a)
print(q[0].a)

function pd<T>(x: T) { { a: x } }
const pp = [pd(1), pd(2)]
const qq = [pd(true), pd(false)]
qq.push(pd(true))
print(qq[2].a)
print(qq.length + pp.length - 2)

function pf<T>(x: T) { { a: x } }
const pq = [pf(1)]
function mkq() { [pf(true)] }
const qf = mkq()
print(qf[0].a)
print(pq[0].a == 1)
