// D8240: a generic record constructor pinned at `i32` and then `boolean` mints a row for each
// pin, though the two records share one wasm shape, so a list of the second builds as a ref
// list. The annotated spelling, a function result, a push and a record field run too.

function pc<T>(x: T) { { a: x } }

const p = [pc(1)]
const q = [pc(true)]
const s = [pc("s")]
print(p[0].a)
print(q[0].a)
print(s[0].a)

const pp = [pc(1), pc(2)]
const qq = [pc(true), pc(false)]
qq.push(pc(true))
print(pp[1].a)
print(qq[2].a)
print(qq.length)

const pa: { a: i32 }[] = [pc(1)]
const qa: { a: boolean }[] = [pc(true)]
print(pa[0].a)
print(qa[0].a)

function mkq() { [pc(true)] }
const qf = mkq()
print(qf[0].a)

const hd = { p: [pc(1)], q: [pc(true)] }
print(hd.p[0].a)
