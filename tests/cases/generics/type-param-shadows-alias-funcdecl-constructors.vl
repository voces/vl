// @run
// @log 4
// @log w
// @log 1.5
// @log 2.5
// @log 7
// @log q
// @hint redundant type annotation: `a` is inferred as `{w: i32}`
// @hint redundant type annotation: `b` is inferred as `{w: string}`
// @hint redundant type annotation: `c` is inferred as `{w: f64}`
// @hint redundant type annotation: `f` is inferred as `{w: string}`
// The FuncDecl half of the shadow family at the constructors `type-param-shadows-alias-
// funcdecl.vl` did NOT reach. That slice routed the signature back to the DECLARED spelling
// (`typecheck.declAnnRawTyName`) behind the gate `monoTyParamOf`, which matches a BARE
// parameter and ONE `[]` level and nothing else — so a parameter sitting behind
// `Inner<Id>`, `Id | null`, `{a: Id}`, `Id[][]` or `(Id | null)[]` was still reported as
// "not parametric", the canon'd alias BODY was taken, and the instance pinned `i32` while
// the checker had bound the ARGUMENT.
//
// It is the SAME narrow-gate defect #1238 closed on the generic-ALIAS half, whose shipped
// gate read the array grammar and nothing else. The two halves are now one predicate:
// `emit_collect.gaeDeclFieldTyName` asks `gaeAnnHasParam` (which IS `monoAnnHasTyParam`
// over the live parameters) and `monoDeclAnnName` now asks `monoAnnHasTyParam` too — the
// gate its own header had already claimed for a slice and a half.
//
// Measured as a 192-cell grid (CONSTRUCTOR x what the shadowed name is DECLARED as x the
// call ARGUMENT's type x whether the RETURN also carries the parameter), every shadow cell
// against its own NON-SHADOWING `<T>` control: 41 cells forward — 26 invalid wasm -> a loud
// reject, 6 invalid wasm -> CORRECT, 9 loud reject -> CORRECT — and 0 controls moved.
//
// THE RETURN AXIS IS WHY A SMALLER GRID READS THIS FAMILY AS ALREADY-LOUD. When the return
// annotation ALSO carries the parameter, the erased signature leaves it unbound and the
// monomorphizer says so ("a return type parameter of `fnv` is not bound by any parameter").
// It is the CONCRETE-return arm that has nothing to trip that reject and writes the module.
// One return spelling per row measures only the half that was already loud.
type Id = i32

type Nm = string

type Z = 0 | 1

type Inner<Y> = { w: Y }

// The nested APPLICATION `Inner<Id>` — invalid wasm at a concrete return, a loud
// "return type parameter not bound" at a parametric one, and CORRECT at both now.
function appI<Id>(v: Inner<Id>): Id { return v.w }

const a: Inner<i32> = { w: 4 }
print(appI(a))

const b: Inner<string> = { w: "w" }
print(appI(b))

// The shadowed name declared through the OTHER canon arm (`numLitUnionAliasName`) behind
// the same constructor — a rep the alias body does not name.
function appZ<Z>(v: Inner<Z>): Z { return v.w }

const c: Inner<f64> = { w: 1.5 }
print(appZ(c))

// And through a STRING alias, at a third rep.
function appNm<Nm>(v: Inner<Nm>): Nm { return v.w }

const d: Inner<f32> = { w: 2.5 }
print(appNm(d))

const e: Inner<i64> = { w: 7 }
print(appNm(e))

// The IDENTITY application — the argument's type IS what the shadowed alias names, so the
// erasure was a no-op and this cell was always green. It must stay green.
function appId2<Nm>(v: Inner<Nm>): Nm { return v.w }

const f: Inner<string> = { w: "q" }
print(appId2(f))
