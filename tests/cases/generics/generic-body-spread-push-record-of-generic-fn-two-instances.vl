// @run
// @log 3
// @log ab
// @log 3
// @log ab
// @log 2
// @log ab
// @log 3
// @log ab
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)

// A spread list literal in a generic body is shared by every instance, so each instance builds
// its elements' generic function at its own T: spread into a push (D16571), as a bare name
// (D16572), after a direct push, and spread into an initialiser.
function id<T>(x: T): T { return x }
function run<T>(_x: T) {
  const rs: {f: (x: T) => T}[] = []
  rs.push(...[{ f: id }])
  return rs
}
function runB<T>(_x: T) {
  const rs: ((x: T) => T)[] = []
  rs.push(...[id])
  return rs
}
function runD<T>(_x: T) {
  const rs: {f: (x: T) => T}[] = []
  rs.push({ f: id })
  rs.push(...[{ f: id }])
  return rs
}
function runI<T>(_x: T) {
  const rs: {f: (x: T) => T}[] = [...[{ f: id }]]
  return rs
}
print(run(3)[0].f(3))
print(run("ab")[0].f("ab"))
print(runB(3)[0](3))
print(runB("ab")[0]("ab"))
print(runD(3).length)
print(runD("ab")[1].f("ab"))
print(runI(3)[0].f(3))
print(runI("ab")[0].f("ab"))
