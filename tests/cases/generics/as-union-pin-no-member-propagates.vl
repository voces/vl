// @run
// @log true
// @log true
// @log 1
// A bare `as` over `T | null` pinned where no member can be the target propagates its operand to
// the enclosing return, as the remainder of a union cast does (D2791, D16323).
function pick<T>(u: T | null): Set<i32> | string | null {
  const w = u as Set<i32>
  w
}

const s: Set<i32> = Set()
s.add(1)
print(pick<string>("ab") == "ab")
print(pick<string>(null) == null)
const back = pick<Set<i32>>(s)
if back is Set<i32> { print(back.length) }
