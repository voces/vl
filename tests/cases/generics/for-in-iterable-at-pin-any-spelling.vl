// @log e=true
// @log true
// @log 2.5
// @log true
// @log true
// A for-in loop variable takes its element from the iterable's own type at the instance,
// whatever spells the iterable (D3842): a literal of the parameter, a literal holding a generic
// call, a bound generic result, a direct generic call, and a call through a function value.
function id<U>(u: U): U { u }
function wrap<U>(u: U): U[] { [u] }
function show<V>(v: V) { print(v) }

function five<T>(x: T, f: (t: T) => T[]) {
  for e in [x] { print(e) }
  for e in [id(x)] { print(e) }
  const ws = wrap(x)
  for e in ws { print(e) }
  for e in wrap(x) { print(e) }
  for e in f(x) { print(e) }
}
five(true, (t) => [t])

// The function-value call, passed on and interpolated, at a literal union, and at two pins.
function viaFn<T>(x: T, f: (t: T) => T[]) {
  for e in f(x) { show(e) }
}
viaFn(true, (t) => [t])
const lb: "a" | "b" = "b"
viaFn(lb, (t) => [t])
function interp<T>(x: T, f: (t: T) => T[]) {
  for e in f(x) { print("e=\{e}") }
}
interp(true, (t) => [t])
function twoPins<T>(x: T, f: (t: T) => T[]) {
  for e in f(x) { print(e) }
}
twoPins(true, (t) => [t])
twoPins(2.5, (t) => [t])

// An un-annotated enclosing function calling a function value of its own.
function hole(x) {
  const f = (t) => [t, t]
  for e in f(x) { print(e) }
}
hole(true)
