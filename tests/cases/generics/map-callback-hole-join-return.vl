// @run
// A `.map` callback whose returns join a string with the hole's element keeps the join as its
// return at every pin: read in place, bound and iterated, assigned, returned, passed (D3125).
function h(x) {
  print(
    [x].map((e) => {
      if e == null { return "n" }
      return e
    })[0],
  )
}
function each<T>(x: T) {
  const n = [x].map((e) => {
    if e == null { return "n" }
    return e
  })
  for y in n { print(y) }
}
function reassign(x) {
  let n = [x].map((e) => {
    if e == null { return "n" }
    return e
  })
  n = [x].map((e) => {
    if e == null { return "m" }
    return e
  })
  print(n[0])
}
function ret(x) {
  return [x].map((e) => {
    if e == null { return "n" }
    return e
  })
}
function count(xs) { print(xs.length) }
function pass<T>(x: T) {
  count(
    [x].map((e) => {
      if e == null { return "n" }
      return e
    }),
  )
}
function last<T>(x: T) {
  const n = [x].map((e) => {
    if 1 > 2 { return e }
    return "k"
  })
  for y in n { print(y) }
}
const a: i32 | null = null
h(a)
each(a)
each(4)
each(2.5)
each("s")
reassign(a)
const r = ret(a)
print(r[0])
pass(4)
last(a)
// @log n
// @log n
// @log 4
// @log 2.5
// @log s
// @log m
// @log n
// @log 1
// @log k
