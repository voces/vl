// @run
// @log null
// @log null
// @log null
// @log null
// @log null
// @log s
// A hole value at a `string | null` pin joined through an `if` or `match` keeps its null,
// bound to a local, printed directly, or returned from a hole callee (D3016).
function viaLet(x) {
  const y = if x == x { x } else { x }
  print(y)
}
function inline(x) { print(if x == x { x } else { x }) }
function viaMatch(x) {
  const y = match 1 {
    1 => x
    _ => x
  }
  print(y)
}
function matchInline(x) {
  print(
    match 1 {
      1 => x
      _ => x
    },
  )
}
function pick(z) { return if z == z { z } else { z } }
const v: string | null = null
viaLet(v)
inline(v)
viaMatch(v)
matchInline(v)
print(pick(v))
const w: string | null = "s"
viaLet(w)
