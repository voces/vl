// @run
// @log 3
// @log x
// @log 5
// A binding of one type parameter seeded from a second's parameter and then written from a
// third's holds each in turn (D17321).
function same<T>(k: T): T { return k }
function twice<T>(k: T): T { return k }
function third<T>(k: T): T { return k }
function mid<F, G, H>(a: F, a1: G, a2: H) {
  let b: F = a1
  print(b(3))
  if "ab".length > 1 { b = a2 }
  print(a("x"))
  print(b(5))
}
mid(same, twice, third)
