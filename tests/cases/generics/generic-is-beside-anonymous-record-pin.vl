// @run
// @log 3
// @log 3
// @log 3
// @hint redundant type annotation: `r` is inferred as `T | i32`
// @hint redundant type annotation: `r` is inferred as `T | i32`
// D2958: an anonymous-record pin of `T | i32` beside an `is` over another scalar union, at a
// plain function and at a generic one pinned to `f64`.
function first<T>(a: T, c: boolean) {
  const r: T | i32 = if c { a } else { 5 }
  if r is i32 { print(3) } else { print("x") }
}
const rec = { x: 9 }
first(rec, false)
function h(a: f64, c: boolean) {
  const r: f64 | i32 = if c { a } else { 5 }
  if r is f64 { print(r + 0.5) } else { print("no") }
}
h(2.5, true)
function k<T>(a: T, c: boolean) {
  const r: T | i32 = if c { a } else { 5 }
  if r is f64 { print(r + 0.5) } else { print("no") }
}
k(2.5, true)
