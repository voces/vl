// @emit-error called from a function nested in a second instance of that enclosing function
// A nested generic capturing its enclosing function's parameter, called from a sibling function
// at a second instance of the enclosing function, is refused: the call would reach the first
// instance's copy, whose env holds the parameter at the first instance's type (D3827).
function outer<T>(x: T) {
  function inner<U>(_u: U) { print(x) }
  function other() { inner(true) }
  other()
}
outer(7)
outer("s")
