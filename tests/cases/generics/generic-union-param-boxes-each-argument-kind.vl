// @run
// @log s:hi
// @log n:7
// @log l:3
// A generic function's `T | i32` parameter given a string, an i32 and a list: each argument is
// boxed at the parameter's union, so the test inside finds its arm.
function show<T>(v: T | i32) {
  if v is i32 { return "n:\{v}" }
  if v is string { return "s:" + v }
  return "l:3"
}

print(show("hi"))
print(show<string>(7))
print(show([1, 2, 3]))
