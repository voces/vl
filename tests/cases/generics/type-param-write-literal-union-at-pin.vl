// @log b
// @log n
// @log a
// A literal-union place a type-parameter value was written into keeps its null tests real at a
// nullable pin, and reads the member at a non-null one, in both the `<T>` and hole spellings (D3423).
type K = "a" | "b"
type R = { s: K | null, n: i32 }
let gs: K | null = null
function name<T>(x: T) {
  let s: K | null = null
  s = x
  print(s ?? "n")
  print(s == null)
}
function field<T>(x: T) {
  const o: R = { s: null, n: 1 }
  o.s = x
  if o.s != null { print(o.s) } else { print("N") }
  const f = () => o.s ?? "c"
  print(f())
}
function elem(x) {
  const xs: (K | null)[] = [null]
  xs[0] = x
  print(xs[0] ?? "n")
  print(xs[0] == "a")
}
function glob(x): K | null {
  gs = null
  gs = x
  return gs
}
const kn: K | null = null
const kb: K | null = "b"
const ka: K = "a"
name(kn)
name(ka)
name(kb)
field(kn)
field(ka)
field(kb)
elem(kn)
elem(ka)
print(glob(kn) ?? "n")
print(glob(kb) ?? "n")
print(glob(kn) ?? "n")
print(glob(ka) ?? "n")
