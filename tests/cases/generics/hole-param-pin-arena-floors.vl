// @run
// @log a
// @log a
// @log a
// @log 6

// D1755 — the monomorphizer's argument-pin ladder ends in named loud floors, and two of them
// asked the arena nothing. Every arm above resolves a BINDING, so an if-expression or a call
// reaches the floor with a type the checker recorded and no channel to spell it, and the pin
// refused a program whose annotated-parameter neighbour runs. The union floor beside them was
// already given this question; these two now ask it through the same membership list.
type E = { msg: string }

function mkA(ok: boolean): E | null {
  if ok { return null }
  return { msg: "a" }
}

function mkB(ok: boolean): E | null {
  if ok { return null }
  return { msg: "b" }
}

function truthy() { 1 == 1 }
function falsy() { 1 == 2 }

function take(a) {
  const v = a
  if v != null { print(v.msg) } else { print("null") }
}

// The nullable-struct floor: an if-expression whose arms are `E | null`.
take(if truthy() { mkA(falsy()) } else { mkB(falsy()) })

// Binding it first does not launder it — the Ident arm recurses into the initializer and
// propagates the floor's own refusal, so one rung has to serve both.
const held = if truthy() { mkA(falsy()) } else { mkB(falsy()) }
take(held)

// The early-return shape of the same delivery, which the position matrix grades separately.
function guard(v) {
  if v != null {
    print(v.msg)
    return
  }
  print("null")
}
guard(if truthy() { mkA(falsy()) } else { mkB(falsy()) })

// The ref-array floor: a nested list from a CALL rather than an array literal, which is the
// only shape that floor could name.
function takeNested(a) { print(a[1][1]) }
takeNested(__array_new__(2, [0, 6]))
