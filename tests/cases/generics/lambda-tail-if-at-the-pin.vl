// @run
// @log null
// @log n
// @log 7
// @log null
// A lambda in a generic body whose tail is a value `if` returns the type its template was
// checked at, read at the pin: `T` bound to `string | null` keeps the null (D2905).
function g0<T>(a: T, b: T, c: boolean) {
  const f = () => if c { a } else { b }
  const r = f()
  if r == null { print("null") } else { print(r) }
}
const u: string | null = "n"
const w: string | null = null
g0(u, w, false)
g0(u, w, true)
const i: i32 | null = 7
const j: i32 | null = null
g0(i, j, true)
g0(i, j, false)
