// @run
// @log true
// @log 1
// @log end
// @log 2
// A type parameter whose only argument is a `null` its bare `Z | null` parameter takes binds
// `never`, so the instance's guarded reads through it are unreachable and check clean (D3178).
function callFace<Z>(z: Z | null) {
  if z != null { print(z.f()) }
}
callFace({ f: () => true })
callFace(null)
function fieldFace<Z>(z: Z | null) {
  if z != null { print(z.v) }
}
fieldFace({ v: 1 })
fieldFace(null)
function onlyNull<Z>(z: Z | null) {
  if z != null { print(z.f()) }
  print("end")
}
onlyNull(null)
function listParam<Z>(z: Z[] | null) {
  if z != null { print(z.length) }
}
listParam([1, 2])
listParam(null)
