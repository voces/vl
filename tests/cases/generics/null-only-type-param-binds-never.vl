// @run
// @log true
// @log 1
// @log end
// @log 2
// @log true
// @log true
// A type parameter whose only argument is a `null` its `X | null` parameter takes binds
// `never`, so the instance's guarded reads through it are unreachable and check clean (D3178).
// Inside a list or record the `never` slot reps as the default `i32`, which no value reaches (D15530).
function callFace<Z>(z: Z | null) {
  if z != null { print(z.f()) }
}
callFace({ f: () => true })
callFace(null)
function fieldFace<Z>(z: Z | null) {
  if z != null { print(z.v) }
}
fieldFace({ v: 1 })
fieldFace(null)
function onlyNull<Z>(z: Z | null) {
  if z != null { print(z.f()) }
  print("end")
}
onlyNull(null)
function listParam<Z>(z: Z[] | null) {
  if z != null { print(z.length) }
}
listParam([1, 2])
listParam(null)
function listElemCall<Z>(z: Z[] | null) {
  if z != null { print(z[0].f()) }
}
listElemCall([{ f: () => true }])
listElemCall(null)
function recordField<Z>(r: { z: Z } | null) {
  if r != null { print(r.z.f()) }
}
recordField({ z: { f: () => true } })
recordField(null)
