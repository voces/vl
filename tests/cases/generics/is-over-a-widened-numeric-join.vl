// @run
// @log true
// @log false
// @log 3
// @log false
// @log true
// @log 2.5
// A join of type parameters pinned at `i32` and `f64` is `i32 | f64` at the pin, as the direct
// join of two runtime values is, so `is` answers for the arm the value came from (D3345).
function g<T, U>(a: T, b: U, k: i32) {
  const r = if k == 0 { a } else { b }
  print(r is i32)
  print(r is f64)
  print(r)
}
g(3, 2.5, 0)
g(3, 2.5, 1)
