// @run
// @log false
// @log true
// @log 3
// @log false
// @log true
// @log 2.5
// A join of type parameters pinned at `i32` and `f64` widens to `f64` as the direct join does, so
// its value is an `f64` and `is i32` is false for both arms (D3345).
function g<T, U>(a: T, b: U, k: i32) {
  const r = if k == 0 { a } else { b }
  print(r is i32)
  print(r is f64)
  print(r)
}
g(3, 2.5, 0)
g(3, 2.5, 1)
