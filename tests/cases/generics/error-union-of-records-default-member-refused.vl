// @check
// @error cannot infer type parameter `T` in this call to `kk`: its argument is `A | B`
// Refused even when the value is the member the unbound default `i32` happens to match: the
// instance was built at `i32` for either member, so a `B` value trapped.
type A = { k: i32 }
type B = { k: string }
function kk<T>(x: { k: T }): T { return x.k }
const r: A | B = { k: 1 }
print(kk(r))
