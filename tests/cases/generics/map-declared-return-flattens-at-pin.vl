// @run
// @log null
// @log 4
// @log null
// @log true
// @log null
// @log u
// A `.map` callback's declared `T | X` at a nullable pin is read through the union row its
// flattened members name, not the module's first union (D3129).
type AB = "a" | "b"
type U = i32 | string
function g<T>(x: T) {
  const m = [x].map((e): T | i32 => e)
  print(m[0])
}
const a: i32 | null = null
g(a)
const b: i32 | null = 4
g(b)
function k<T>(x: T) {
  for y in [x].map((e): T | boolean => e) { print(y) }
}
k(a)
k(true)
function f<T>(x: T) { print([x].map((e): T | f64 => e)[0]) }
f(a)
const c: i32 | string = "u"
f(c)
