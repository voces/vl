// @run
// @log true
// @log 3
// @log 2.5
// @log a
// @log s
// @log 4
// Three instances of a lambda returned at an open union result, a string instance whose union
// collapses, and a result narrowed after the call each run at their own instance (D17062).
function keep<U>(x: U): () => U | string { return () => x }
print(keep(true)())
print(keep(3)())
print(keep(2.5)())
print(keep("a")())
function pick<U>(x: U, b: boolean): () => U | string {
  return () => if b { x } else { "s" }
}
print(pick(1, false)())
const r = keep(3)()
if r is string { print(r) } else { print(r + 1) }
