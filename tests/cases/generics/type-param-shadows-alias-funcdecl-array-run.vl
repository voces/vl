// @run
// @log true
// @log 1.5
// @log 7
// @log true
// The `[]`-RUN residue #1245 left behind, on the FuncDecl shadow family. That slice routed
// a generic signature back to its DECLARED spelling behind the gate `monoAnnHasTyParam`,
// whose header had claimed a `[]`-run arm ("array-of at any dimension … or behind a `[]`
// run (`(T | null)[]`, `{a: T}[]`)") since #1242 — and NO arm below it delivered one.
// `splitUnionAtoms` will not split inside the grouping parens of `(Id | null)[]`,
// `annObjFieldSplit` answers -1 on a name ending in `]`, and `peelGroupParens` returns a
// `…[]` name unchanged, so a parameter behind a `[]` run read as "not parametric", the
// canon'd alias BODY was pinned, and the instance disagreed with the checker exactly as
// the bare case did before #1245. THE HEADER WAS THE THIRD IN TWO DAYS TO DESCRIBE A WALK
// ITS OWN BODY DID NOT HAVE.
//
// The arm is now real, in all three walks at once (`monoAnnHasTyParam` reports the run,
// `monoBindFromAnn` binds through it, `monoSubstAnn` re-attaches it), and the binder
// finally has the UNION / inline-OBJECT / grouping-PAREN arms its two siblings have always
// had — without them the widened gate reported a parameter that nothing bound and nothing
// could replace, which is a loud reject rather than a wrong module, but not the answer.
//
// Measured over 1,152 cells (8 constructors x 4 declarations x 6 argument types x 3 return
// spellings x 2 scopes), every shadow cell against its own non-shadowing `<T>` control:
// 528 cells forward (160 invalid wasm -> CORRECT, 368 loud reject -> CORRECT) and ZERO
// backward. The shadow cells that were only ACCIDENTALLY green — the diagonal, where canon
// erased the shadowed name to the very type the call passed — are now green because the
// instance is pinned right, not because the erasure happened to agree.
type Id = i32

type Nm = string

type Z = 0 | 1

// A grouping-paren UNION under the run.
function nulRun<Id>(v: (Id | null)[]): boolean { return v.length > 0 }

const a: (string | null)[] = ["z"]

print(nulRun(a))

// An inline OBJECT SHAPE under the run, at a rep the alias body does not name.
function shapeRun<Nm>(v: {a: Nm}[]): Nm { return v[0].a }

const b: {a: f64}[] = [{ a: 1.5 }]

print(shapeRun(b))

// The plain nested run over a shadowed name, through the OTHER canon arm
// (`numLitUnionAliasName` — `type Z = 0 | 1` shadows a parameter exactly as `type Id = i32`
// does).
function nested<Z>(v: Z[][]): Z { return v[0][0] }

const c: i64[][] = [[7]]

print(nested(c))

// The DIAGONAL — the argument's type IS what the shadowed alias names, so the erasure was a
// no-op and this cell was green for the wrong reason. It must stay green.
function nulRunId<Id>(v: (Id | null)[]): boolean { return v.length > 1 }

const d: (i32 | null)[] = [4, null]

print(nulRunId(d))
