// @run
// @log true
// @log 1
// @log 6
// A nested generic named like a top-level function is called as itself, not checked against the
// top-level one's demands (D3895).
function b<U>(y: U) { const n: i32 = y; print(n + 1) }
function a<T>(x: T) {
  function b<U>(y: U) { print(y) }
  b(true)
  print(x)
}
a(1)
b(5)
