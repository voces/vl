// @run
// @log 0
// @log 4
// @log 6
// @log 5
// @log 9
// @log 3
// @log 2
// @log none
// @log n3
// @log 5
// @log k4
// @log 3
// @log true
// @log 3
// @log t=4
// @log 3
// @log 1.5
// @log null
// @log 0.5
// @log 3
// @warning Unused parameter `g` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `x` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `x` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `x` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `g` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `x` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `x` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `x` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `i` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `x` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `x` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `x` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `x` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `fallback` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `x` (prefix with `_` to suppress, or remove it)
// The other direction: a type variable only in a callback's RETURN binds from the callback,
// so the argument keeps source order and `f((i) => i * 1.5, 2)` binds `T = f64` exactly as
// its annotated twin does. Deferring these would refuse working programs. The unused
// parameters are declared warnings: each one binds `T`, so it is part of the cell.
// cell a01
function f_a01<T>(g: (i32) => T, xs: T[]) { return xs.length }
print(f_a01((i) => i + 1, []))

// cell a02
function f_a02<T>(g: (i32) => T, x: T) { return g(3) }
print(f_a02((i) => i + 1, 5))

// cell a03
function f_a03<T>(g: (i32) => T, x: T | null) { return g(3) }
print(f_a03((i) => i * 2, null))

// cell a08
function mk_a08<T>(f: (i32) => T, v: T) { return f(v as i32) }
print(mk_a08((x) => x + 1, 4))

// cell a21
function withDefault_a21<T>(f: () => T, x: T | null) { return x ?? f() }
print(withDefault_a21(() => 9, null))

// cell b01
function f_b01<T>(g: (i32) => T, x: T) { return g(2) }
print(f_b01((i) => i * 1.5, 2))

// cell b02
function f_b02<T>(g: (i32) => T, x: T) { return x }
print(f_b02((i) => i * 1.5, 2))

// cell b03
function f_b03<T>(g: (i32) => T, x: T) { return g(1) }
const r_b03 = f_b03(
  (i) => {
    if i > 0 { return null }
    return "s"
  },
  "x",
)
print(r_b03 ?? "none")

// cell b04
function f_b04<T>(g: (i32) => T, x: T | null) { return g(3) }
print(f_b04((i) => "n\{i}", null))

// cell b07
function f_b07<T>(g: (i32) => T, xs: T[]) { xs.push(g(4)); return xs[0] }
print(f_b07((i) => i + 1, []))

// cell b08
function f_b08<T>(g: (i32) => T, xs: T[]) { xs.push(g(4)); return xs[0] }
print(f_b08((i) => "k\{i}", []))

// cell b09
function f_b09<T>(g: (i32) => T, x: T) { return g(1) }
const v_b09: string | i32 = 3
print(f_b09((i) => v_b09, v_b09))

// cell b12
function f_b12<T>(g: (i32) => T, x: T) { return g(2) }
print(f_b12((i) => i > 1, false))

// cell b14
function f_b14<T>(g: (i32) => T, x: T) { return g(2) }
print(f_b14((i) => i * 1.5, 2.0))

// cell b15
function f_b15<T>(g: (i32) => T, h: (T) => string) { return h(g(3)) }
print(f_b15((i) => i + 1, (t) => "t=\{t}"))

// cell c01
function f_c01<T>(g: (i32) => T, x: T) { return g(2) }
print(f_c01((i: i32) => i * 1.5, 2))

// cell c03
function f_c03<T>(g: () => T, x: T) { return g() }
print(f_c03(() => 1.5, 2))

// cell c05
function orElse_c05<T>(make: (i32) => T, fallback: T) { return make(1) }
const s_c05 = orElse_c05(
  (i) => {
    if i == 1 { return null }
    return "v"
  },
  "d",
)
print(s_c05 ?? "null")

// cell c06
function tab_c06<T>(gen: (i32) => T, seed: T) {
  const out_c06 = [seed]
  out_c06.push(gen(1))
  return out_c06
}
const r_c06 = tab_c06((i) => i * 0.5, 0)
print(r_c06[1])

// cell c07
function k_c07<T>(g: (i32) => T, x: T) { return g(2) }
function half_c07(i: i32) { return i * 1.5 }
print(k_c07(half_c07, 2))
