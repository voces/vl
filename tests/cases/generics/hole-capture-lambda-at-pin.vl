// @run
// @log true
// @log 7
// @log null
// @log s
// @log null
// @log isnull
// @log y
// @log x
// A parameter-less lambda capturing a hole-typed value returns, and its call answers, the type
// the instance's pin names: a `boolean` prints as one (D2900), a null is kept (D2878) and a
// literal-set member prints as its text (D2852).
function show(x) {
  const c = () => x
  print(c())
}
show(true)
show(7)
function field(o) {
  const c = () => o.f
  print(c())
}
const rn: { f: string | null } = { f: null }
field(rn)
const rs: { f: string | null } = { f: "s" }
field(rs)
const ni: i32 | null = null
show(ni)
function probe(o) {
  const c = () => o.f
  const v = c()
  if v == null { print("isnull") } else { print(v) }
}
probe(rn)
type K = "x" | "y"
const ky: K = "y"
const kx: K = "x"
show(ky)
show(kx)
