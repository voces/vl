// @run
// @log a
// @log null
// @log z
// @log a
// @log null
// @log z
// A lambda in a generic body returning a `match` join keeps the null one type parameter binds,
// at `string | null` and at a literal union (D4171). Two functions: one sharing both pins is D4885.
type K = "a" | "b"
function g<T0, T1>(a0: T0, a1: T1, k: i32) {
  const f = () => match k {
    0 => a0
    1 => a1
    _ => "z"
  }
  print(f())
}
function gk<T0, T1>(a0: T0, a1: T1, k: i32) {
  const f = () => match k {
    0 => a0
    1 => a1
    _ => "z"
  }
  print(f())
}
const x0 = "a"
const x1: string | null = null
g(x0, x1, 0)
g(x0, x1, 1)
g(x0, x1, 2)
const y0: K = "a"
const y1: K | null = null
gk(y0, y1, 0)
gk(y0, y1, 1)
gk(y0, y1, 2)
