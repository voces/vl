// @check
// @error-at 9:37 argument 1: expected (f64, string) => f64, got (X, Y) => Y
// A destination that binds an open-function slot's parameter to a type the handed generic ties to
// the bound one is refused at the argument, not built (D16563).
function second<X, Y>(_x: X, y: Y): Y { y }
function bind1<A, B>(f: (a: A, b: B) => A, a: A): (b: B) => A {
  (b: B) => f(a, b)
}
const v: (b: string) => f64 = bind1(second, 2.5)
print(v("s"))
