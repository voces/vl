// @run
// @log s
// @log 5
// @log t
// @log 6
// @log u
// @log 7
// @log v
// @log 8
// A record literal leading a list literal in a generic body is built at its own instance's
// row, and the list is keyed by that row: the declared `X` matches the `i32` instance's
// literal and must not claim the `string` one (D3036).
type X = { k: i32, n: i32 }

// Binding position.
function g<T>(x: T): T {
  const xs = [{ k: x, n: 1 }]
  xs[0].k
}
print(g("s"))
print(g(5))

// Argument position.
function first(xs) { xs[0].k }
function h<T>(x: T): T { first([{ k: x, n: 2 }]) }
print(h("t"))
print(h(6))

// Return position.
function mk<T>(x: T) { [{ k: x, n: 3 }] }
print(mk("u")[0].k)
print(mk(7)[0].k)

// The annotated spelling of the binding.
function ga<T>(x: T): T {
  const xs: { k: T, n: i32 }[] = [{ k: x, n: 4 }]
  xs[0].k
}
print(ga("v"))
print(ga(8))
