// @run
// @log 4
// @log 2.5
// A `??` over a hole's nullable element, in a function called at an `i32 | null` and an
// `f64 | null` element, is read per instance, so each call prints its own width (D3796).
function take(a) { print(a[1] ?? 0) }
const l: (i32 | null)[] = [null, 4]
take(l)
const m: (f64 | null)[] = [null, 2.5]
take(m)
