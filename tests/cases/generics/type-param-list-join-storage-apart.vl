// @run
// @log 7
// @log 4
// @log 1
// @log 3
// @log null
// A join of two type parameters' lists stays a union at a pin whose element types are stored
// differently, so each arm reads its own list instead of one list built for both (D3367).
function g<T0, T1>(a0: T0[], a1: T1[], k: i32) {
  const r = if k == 0 { a0 } else { a1 }
  const e = r[0]
  print(e)
}
function n<T0, T1>(a0: T0[], a1: T1[], k: i32) {
  const r = if k == 0 { a0 } else { a1 }
  print(r.length)
}
const x0: i32 | null = 7
const x1 = 4
g([x0], [x1], 0)
g([x0], [x1], 1)
n([x0], [x1, x1, x1], 0)
n([x0], [x1, x1, x1], 1)
const y0: i32 | null = null
g([x1], [y0], 1)
