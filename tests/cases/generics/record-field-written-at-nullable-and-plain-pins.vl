// @run
// @log 9
// @log 9
// A type parameter's record field written at two pins, one admitting null and one not, builds
// the literal at the row both pins share (D3440).
type A = { v: i32 }
function g<Z>(z: Z) {
  z.h = { v: 9 }
  print(z.h.v)
}
const x: { h: A | null } = { h: null }
g(x)
const y: { h: A } = { h: { v: 1 } }
g(y)
