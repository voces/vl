// @run
// @log false
// @log true
// @log true
// @log false
// @log null
// @log x
// A join of two bare type parameters is their union, so at `boolean` and `i32` the boolean arm
// keeps its own tag and `is i32` is false for it (D3268); a list of the join at `i32 | null` and
// `string` holds the string arm as a string.
function g<T, U>(a: T, b: U, k: i32) {
  const r = if k == 0 { a } else { b }
  print(r is i32)
}
const x = true
const y = 3
g(x, y, 0)
g(x, y, 1)
function h<T, U>(a: T, b: U, k: i32) {
  const r = if k == 0 { a } else { b }
  print(r is boolean)
}
h(x, y, 0)
h(x, y, 1)
function hl<E>(xs: E[]) { print(xs[0]) }
function l<T, U>(a: T, b: U, k: i32) {
  const r = if k == 0 { a } else { b }
  hl([r])
}
const n: i32 | null = null
l(n, "x", 0)
l(n, "x", 1)
