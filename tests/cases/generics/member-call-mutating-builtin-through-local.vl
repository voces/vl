// @run
// @log 3
// @log 3
// @log 3
// @log 2
// @log 2
// @warning Unused parameter `self` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `v` (prefix with `_` to suppress, or remove it)
// A mutating built-in (`push`, a set's `add`, a map's `set`) called through a local copy of a
// generic's parameter, or from inside a closure, with a same-named `self`-function in scope: the
// call cannot be re-dispatched per instance (D2520), so the receiver keeps the list or map the
// method name demands and the built-in runs, as it did before per-instance dispatch (D2518).
function push(self: boolean, v: i32) { print(99 + v - v) }
function add(self: boolean, k: string) { print(k) }
function set(self: i32[] | boolean, k: string, v: i32) { print(k) }
function viaLocal<T>(x: T) {
  const y = x
  y.push(5)
}
function viaClosure<U>(x: U) {
  const g = () => x.push(5)
  g()
}
function holeLocal(x) {
  const y = x
  y.push(5)
}
function setAdd<S>(x: S) {
  const y = x
  y.add("b")
}
function mapSet(x) {
  const g = () => x.set("b", 6)
  g()
}
const r1 = [1, 2]
viaLocal(r1)
print(r1.length)
const r2 = [1, 2]
viaClosure(r2)
print(r2.length)
const r3 = [1, 2]
holeLocal(r3)
print(r3.length)
const s = Set<string>()
s.add("a")
setAdd(s)
print(s.length)
const m: {[string]: i32} = Map()
m["a"] = 5
mapSet(m)
print(m.length)
