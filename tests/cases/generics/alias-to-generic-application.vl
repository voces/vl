// @run
// @log 1
// @log 3
// @log hi
// @log 40
// @log 5
// @log yo
// @hint redundant type annotation: `y` is inferred as `{v: i32}`
// @hint redundant type annotation: `p` is inferred as `{a: i32, b: string}`
// @hint redundant type annotation: `takeP` is inferred as `string`
// An ALIAS whose body is a generic APPLICATION (`type Y = Box<i32>`) — the alias-to-
// generic-application path. The parser encodes every non-`{`-bodied `type N = …` as a
// ONE-MEMBER `UnionDecl`, so `Y` reached the emitter as a declared union alias
// (`unNames`/`isUName`): `globalCellKind` classified `const y: Y` as a value-union BOX cell
// while the `{ v: 1 }` initializer lowered a plain `struct.new` — a `global.set` type
// mismatch. `vl check` accepted the program (emitting only a redundant-annotation HINT),
// `vl build` wrote a 173-byte module, and that module FAILED TO PARSE as WebAssembly:
// silent invalid wasm, the worst class of defect the compiler can produce.
//
// The un-aliased `const y: Box<i32> = { v: 1 }` always printed 1 — the alias was the whole
// difference, which is what located the defect on the alias-resolution path rather than in
// generic instantiation. A one-member alias is TRANSPARENT: it denotes its member, so the
// checker resolves `Y` to the instantiated `{v: i32}` and the emitter is handed that
// annotation — exactly the vocabulary the un-aliased spelling already lowers through.
type Box<T> = { v: T }
type Pair<A, B> = { a: A, b: B }
type Y = Box<i32>
type P = Pair<i32, string>

// The reported program, verbatim.
const y: Y = { v: 1 }
print(y.v)

// A TWO-argument application behind the alias, with a non-scalar argument.
const p: P = { a: 3, b: "hi" }
print(p.a)
print(p.b)

// The alias in PARAM and RETURN position (each a separate classifier ladder from the
// global cell above — the param ladder rejected with `ref valtype with no interned shape`).
function takeY(q: Y) { q.v * 10 }
print(takeY({ v: 4 }))

function makeY(n: i32): Y { return { v: n } }
print(makeY(5).v)

function takeP(q: P): string { return q.b }
print(takeP({ a: 6, b: "yo" }))
