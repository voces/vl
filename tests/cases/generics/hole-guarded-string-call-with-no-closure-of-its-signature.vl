// @run
// @log none
// A guarded call through a hole's `(() => string) | null` field reads its result as a string
// where the program holds no closure of that signature (D3203).
type R = { v: i32, f: (() => string) | null }
function F(z) {
  if z.f != null { print(z.f()) } else { print("none") }
}
const r0: R = { v: 7, f: null }
F(r0)
