// @run
// @log 3
// @log 4
// @log 5
// @log 6
// @log 7
// @log 8
// @log 9
// @log 20
// @hint redundant type annotation: `b2` is inferred as `{base: i32}`
// @hint redundant type annotation: `c2` is inferred as `{base: i32}`
// D1598 — THE SINGLE-FILE SPELLING of the cross-module fixture in
// `tests/cases/modules/sibling-block-hole-param-one-type-cross-module/`. The module boundary
// is not an ingredient: the pin declined here identically.
//
// `moduleLocalLetOfUnique` declines on any name the module frame binds in more than one
// block, because the table behind it is first-wins over a walk with no notion of which block
// a call site sits in (D1596). Declining is right only where the candidates DISAGREE; where
// they agree the decline cost a working program, and where they disagree the CHECKER had
// already resolved which binding the site denotes.
//
// Leg 4 is the guard that keeps the resolution from becoming a wider scan: the struct binding
// is a candidate for `dup` and must not reach the i32 call.
type Box = { base: i32 }

function ld(self: Box) { self.base }

function fieldHole(b) { b.base }

function ufcsHole(b) { b.ld() }

function twice(x) { x + x }

// leg 1 — two sibling blocks, one INFERRED type between them, the field-read delivery
if true {
  const a1 = { base: 3 }
  print(a1.base)
}
if true {
  const a1 = { base: 4 }
  print(fieldHole(a1))
}

// leg 2 — the same pair ANNOTATED, through the UFCS delivery: an annotation pins the rep, so
// the two faces have to be graded separately
if true {
  const b2: Box = { base: 5 }
  print(b2.base)
}
if true {
  const b2: Box = { base: 6 }
  print(ufcsHole(b2))
}

// leg 3 — the candidates DISAGREE and the call is on the struct one (D1596's own residue):
// the site's recorded type names the binding it denotes
if true {
  const c2 = 7
  print(c2)
}
if true {
  const c2: Box = { base: 8 }
  print(ufcsHole(c2))
}

// leg 4 — CONTROL: the candidates disagree and the call is on the i32 one. Pinning the
// struct candidate here is a `runs -> not-runs`, so this leg must keep the i32 instance.
if true {
  const dup = { base: 9 }
  print(dup.base)
}
if true {
  const dup = 10
  print(twice(dup))
}
