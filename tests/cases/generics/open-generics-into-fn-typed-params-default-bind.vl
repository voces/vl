// @run
// @warning Unused parameter
// @hint redundant type annotation
// @log true
// @log false
// D7484: no argument binds `same`'s `T`, since both are generic in their own parameter;
// it default-binds and each generic is instanced at the default.
function two<T>(x: T): i32 { return 1 }
function three<T>(x: T): i32 { return 3 }
function same<T>(f: (x: T) => i32, g: (x: T) => i32): boolean { return f == g }
print(same(two, two))
print(same(two, three))
