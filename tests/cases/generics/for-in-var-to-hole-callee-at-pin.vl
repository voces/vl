// @run
// @log 2.5
// @log s
// @log null
// @log 5
// @log 1.5
// @log true
// @log 3
// @log null
// @log q
// A `for`-in loop variable over a `<T>` list, handed to a hole callee, pins the callee at the
// list's element at this instance rather than at `i32`; and a loop over a local list of a
// `string | null` parameter binds the nullable string (D3015).
type P = { a: i32 }
function idh(z) { return z }
function f<T>(x: T[]) {
  for e in x { print(idh(e)) }
}
const fs = [2.5]
f(fs)
const ss = ["s"]
f(ss)
const sn: (string | null)[] = [null]
f(sn)
const ls: i64[] = [5]
f(ls)
const f32s: f32[] = [1.5]
f(f32s)
const bs = [true]
f(bs)
function g<T>(x: T[]) {
  for e in x { print(idh(e).a) }
}
const ps = [{ a: 3 }]
g(ps)
function h<T>(x: T) {
  const l = [x]
  for e in l { print(e) }
}
const n: string | null = null
h(n)
const q: string | null = "q"
h(q)
