// @run
// @log 2.5
// @log not f64[][]
// @log s
// @log B
// @log 1
// @log 7
// D2818, D2859: a written `T[][] | i32[][]` (or `T[] | i32[]`) return keeps the type
// parameter's arm apart from the concrete one, so at each pin the value built by either arm
// answers for itself; at `T := i32` the two arms are one list.
function k<T>(c: boolean, t: T): T[][] | i32[][] {
  if c { return [[t]] }
  [[1]]
}
const z = k(true, 2.5)
if z is f64[][] { print(z[0][0]) } else { print("not f64[][]") }
const z2 = k(false, 2.5)
if z2 is f64[][] { print(z2[0][0]) } else { print("not f64[][]") }
const z3 = k(true, "s")
if z3 is string[][] { print(z3[0][0]) } else { print("not string[][]") }
function w<T>(t: T): T[] | i32[] { [t] }
const a = w(true)
if a is boolean[] { print("B") } else { print("N") }
const b = k(false, 7)
print(b[0][0])
print(k(true, 7)[0][0])
