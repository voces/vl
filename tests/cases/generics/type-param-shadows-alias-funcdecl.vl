// @run
// @log z
// @log 5
// @log 2.5
// @log true
// @log 9
// @log 1.5
// @log 7
// @log 4
// @log w
// The FuncDecl half of the shadow family `type-param-shadows-transparent-alias.vl` opened.
// `canonEmitTypeNames` is a name rewrite with no scope, so in `type Id = i32` +
// `function ident<Id>(v: Id): Id` it resolved the SIGNATURE's annotations to `i32` while the
// CHECKER resolved them as the type parameter (`resolveAnnotAt` asks the type-param
// environment before the declared registry). `emit_mono` was then handed `i32` against a
// parameter list holding `Id`, matched nothing, and pinned the ALIAS's body type while the
// call passed something else — `vl check` rc=0 and invalid wasm.
//
// THE AXIS IS THE CALL ARGUMENT'S TYPE, NOT THE REP. Swept as an 11 x 6 grid (what the
// shadowed name is DECLARED as x the ARGUMENT's type), each cell against a `<T>`-named
// control: 49 of 66 invalid wasm or silently WRONG, with a CORRECT control in every one,
// and 0 of 66 after. The 17 that were green are the DIAGONAL — the argument's type equals
// what the alias names, so the erasure is a no-op — plus the two rows canon does not
// rewrite (a declared struct; and a STRING literal union, whose alias name canon keeps).
// One argument literal per row measures only that diagonal.
//
// The route back is `typecheck.declAnnRawTyName`, the SAME per-annotation-node bank the
// alias half already reads, extended to a generic FuncDecl's parameter and return
// annotations. The arena stays canon'd — a parameter name left standing in it is a name
// `collectU` may already have claimed, which is what #1238 measured and rejected.
//
// The arguments below are ANNOTATED CONSTS, never bare literals: a bare `ident(5)` is an
// i32 literal that widens at the call and lands back on the diagonal, which is how a probe
// suite reports this whole family as green.
type Id = i32

type Nm = string

type Z = 0 | 1

type Ids = i32[]

type Fn = (i32) => i32

function identId<Id>(v: Id): Id { return v }

const a: string = "z"
print(identId(a))

const b: i64 = 5
print(identId(b))

const c: f32 = 2.5
print(identId(c))

// The shadowed name declared through the OTHER canon arm (`numLitUnionAliasName`), and
// through the array / function-type spellings.
function identZ<Z>(v: Z): Z { return v }

const d: boolean = true
print(identZ(d))

function identIds<Ids>(v: Ids): Ids { return v }

const e: i64 = 9
print(identIds(e))

function identFn<Fn>(v: Fn): Fn { return v }

const f: f64 = 1.5
print(identFn(f))

// The `T[]` annotation depth over a shadowed name, and the DIAGONAL (argument type ==
// what the alias names), which must not move.
function firstNm<Nm>(v: Nm[]): Nm { return v[0] }

const g: i64[] = [7, 8]
print(firstNm(g))

const h: i32 = 4
print(identId(h))

// The CONTROL the whole grid is read against: a parameter name that shadows nothing.
function identT<T>(v: T): T { return v }

const i: string = "w"
print(identT(i))
