// @run
// @log 2
// @log q
// @log q
// @log 2
// A generic whose un-annotated return joins two list constructors returns the list at every
// instance (D2217): the instance takes its checked result, a list, as its return type. Before,
// no rung of the return ladder named a joined list, and the result fell to the scalar `i32`.
function w<T>(a: T, b: T, k: boolean) {
  if k { [a] } else { [b] }
}
function v<T>(a: T, b: T, k: boolean) {
  const x = [a]
  const y = [b]
  if k { x } else { y }
}
print(w(1, 2, false)[0])
print(w("p", "q", false)[0])
print(v("p", "q", false)[0])
print(v(1, 2, false)[0])
