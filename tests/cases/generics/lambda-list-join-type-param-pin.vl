// @run
// @hint Intentionally-unused variable `_g` (leading `_` marks it unused)
// @log ok
// @log ok
// @log false
// @log true
// @log true
// A lambda in a generic body returning `[t]` beside `[1]` builds its kept-apart list join at
// every pin, called or not (D2894).
function k<T>(t: T) {
  const _g = (c: boolean) => {
    if c { return [t] }
    [1]
  }
  print("ok")
}
k("s")
k(2.5)
function m<T>(t: T, c: boolean) {
  const g = (c: boolean) => {
    if c { return [t] }
    [1]
  }
  const r = g(c)
  print(r is i32[])
}
m("s", true)
m("s", false)
m(3, true)
