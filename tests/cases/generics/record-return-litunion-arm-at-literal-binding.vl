// @run
// @hint Intentionally-unused parameter `_o` (leading `_` marks it unused)
// @log a
// @log x
// @log x
// @log y
// A record return whose field joins a type parameter with a literal-union alias, instantiated at
// another literal union, a nullable one, or one nesting a nullable union, spells the field as
// one literal set, so the record has a field code and a shape.
type K = "a" | "b"
type L = "x" | "y"
function r<T>(x: T): { v: T | K } { return { v: x } }
function s<T>(x: T, _o: K): { v: T | K } { return { v: x } }
const a: K | (L | null) = "a"
print(s(a, "b").v)
const b: L | null = "x"
print(r(b).v)
const c: L = "x"
print(r(c).v)
const d: L | null = "y"
const w = s(d, "a")
print(w.v)
