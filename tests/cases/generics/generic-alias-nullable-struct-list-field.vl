// @run
// @log 4
// @log none
// @log 5
// @hint redundant type annotation: `t` is inferred as `{slots: (Tex | null)[]}`
// D2528: an application of a generic record alias whose field is a list of a NULLABLE record,
// `(Tex | null)[]` spelled directly or reached through `(V | null)[]`, keyed the field's element
// by its parenthesised spelling, which names no list slot: "ref valtype with no interned shape".
type Tbl<V> = { slots: (V | null)[] }
type Fixed<V> = { slots: (Tex | null)[], tag: V }

type Tex = { w: i32 }
const s: (Tex | null)[] = [null, null]
const t: Tbl<Tex> = { slots: s }
t.slots[0] = { w: 4 }
const r = t.slots[0]
if r != null { print(r.w) }
const miss = t.slots[1]
if miss == null { print("none") }

const f: Fixed<i32> = { slots: [null], tag: 1 }
f.slots[0] = { w: 5 }
const g = f.slots[0]
if g != null { print(g.w) }
