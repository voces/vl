// @run
// @log A
// @log B
// @log 5
// @log end
// An un-annotated record parameter whose tail calls a field's void function returns nothing,
// exported or called beside a record whose field returns a value (D3925).
export function click(b) { b.onClick() }
click({ onClick: () => print("A") })
function tap(b) { b.onClick() }
tap({ onClick: () => print("B") })
const k = tap({ onClick: () => 5 })
print(k)
print("end")
