// @run
// @log fn
// @log he
// @log fn
// @log wo
// @log fn
// @log ab
// @info `v` is never reassigned; use `const` instead of `let`
// A member call through a local that only ever holds an un-annotated parameter picks per instance,
// as the call on the parameter does: a `const`, an unwritten `let` and a chain of them (D2520).
function slice(self: boolean | string, a: i32, b: i32) {
  if self == true || a > b { return "fn" }
  return "fn"
}
function viaConst(a) {
  const v = a
  print(v.slice(0, 2))
}
function viaLet(a) {
  let v = a
  print(v.slice(0, 2))
}
function viaChain(a) {
  const u = a
  const v = u
  print(v.slice(0, 2))
}
viaConst(true)
viaConst("hello")
viaLet(true)
viaLet("world")
viaChain(true)
viaChain("abc")
