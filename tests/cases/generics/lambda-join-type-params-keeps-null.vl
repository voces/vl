// A lambda in a generic body that joins the body's type parameters, or parameter holes, keeps
// the join apart as the body does, null included: the lambda's instance and every caller
// re-join it at the pin alike (D3520, D3521, D3506).
const r7 = { x: 7 }
function G<A, B>(k: i32, a: A, b: B) {
  const g = () => {
    if k == 0 { a }
    else if k == 1 { b }
    else { null }
  }
  const v = g()
  print((v ?? 9) is i32)
}
G(0, 3, "t")
G(1, 3, "t")
G(2, 3, "t")
function N<A, B>(k: i32, a: A, b: B) {
  const g = () => {
    const h = () => {
      if k == 0 { a } else { b }
    }
    h()
  }
  g()
}
print(N(0, 3, 2.5))
print(N(1, 3, 2.5))
function NN<A, B>(k: i32, a: A, b: B) {
  const g = () => {
    const h = () => {
      if k == 0 { a }
      else if k == 1 { b }
      else { null }
    }
    h()
  }
  g()
}
print(NN(2, r7, 3) == null)
print(NN(1, r7, 3) is i32)
function H(k: i32, a, b) {
  const g = () => {
    if k == 0 { a }
    else if k == 1 { b }
    else { null }
  }
  g()
}
print(H(2, r7, r7) == null)
print(H(0, r7, r7) == null)
function R(k: i32, a, b) {
  () => {
    if k == 0 { a }
    else if k == 1 { b }
    else { null }
  }
}
print(R(2, 3, "t")() == null)
print(R(1, 3, "t")() ?? "z")
print(R(2, 3, "t")() ?? 9)
function I<A, B>(k: i32, a: A, b: B) {
  const g = () => {
    if k == 0 { a } else { b }
  }
  print(g() is i32)
  print(g() is f64)
}
I(0, 3, 2.5)
I(1, 3, 2.5)
function app(f) { f() }
function P<A, B>(k: i32, a: A, b: B) {
  const v = app(() => {
    if k == 0 { a }
    else if k == 1 { null }
    else { b }
  })
  print((v ?? 9) is i32)
}
P(0, 3, r7)
P(1, 3, r7)
P(2, 3, r7)
