// @run
// @log 2
// @log 3
// @log 1
// @log 1
// @log 1
// `.length` ON AN UNBOUNDED TYPE PARAMETER, admitted the way `x[i]` already was
// (silent-class-inventory-2 D14).
//
// `checkMemberNode`'s `TyVar` arm was gated on `ot.tvName[0] == '?'` — the INFERENCE HOLE
// only — while `checkIndexNode`'s `TyVar` arm has no such gate and hands EVERY type
// variable a derived `HD_ELEM`. D14's actionable content was that disagreement, and this
// file is the side that was refused: `function gtake<T>(x: T) { print(x.length) }` over a
// map was `member access '.length' on non-object T` while `x[0][1]` over the same
// unbounded `T` compiled and ran.
//
// THE PRICE IS A REP WITH NO LENGTH, and it is a MESSAGE, not a silent cell: at `i32`,
// `f64`, `boolean`, a record, a function, a nullable or a union the read is now
// `emitProgram: '.length' on a receiver the emitter cannot classify as a list, string, map
// or set` (`memFloorMsg`) instead of the checker's `non-object T`. Both loud; measured at
// 7 of the 15 reps in `scripts/silent-sweep/d14/lengrid.py`, with 0 `runs` lost and 0
// cells going silent.

function glen<T>(x: T) { print(x.length) }

function body() {
  const xs = [7, 8]
  glen(xs)

  const s = "abc"
  glen(s)

  const m: {[string]: i32} = Map()
  m["a"] = 1
  glen(m)

  const st: {[string]: boolean} = Set()
  st.add("a")
  glen(st)

  // A NESTED list — the leaf rep the INDEX side of the same asymmetry gets wrong
  // (`print(x[0])` here is check-clean invalid wasm; that is D401, still open).
  const nested = [[7, 8]]
  glen(nested)
}
body()
