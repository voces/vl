// @run
// @log 5
// @log 7
// @log 11
// @log 0
// @log 13
// @log 17
// @log 19
// A generic APPLICATION in FIELD position (`type Holder = { c: Box<i32> }`) — the one
// position of the application family the field-code ladder had no route for.
//
// `fieldTypeCode` classifies a declared struct's fields from the field's SPELLING, and no
// arm claimed `Box<i32>`: it is not a primitive, an array, a map, a union or a `TypeDecl`
// NAME, so the field coded -1 and the whole program took
// `only i32 / boolean / string / array struct fields are supported`. Every OTHER position of
// the same type — global, local, parameter, return, list element, map value, and a field of
// another APPLICATION (`gaeEnsure`'s own -1→15 fallback) — already lowered it as a struct
// ref, so the field was the family's single hole.
//
// The route cannot be the struct TABLE, and that is an ORDER fact rather than a capability
// one: `collectS` codes every declared struct's fields in its first loop and only then runs
// `collectGenAliasShapes`, because the instances that pass interns may reference the very
// structs being declared (`Box<Node2>` below). At field-code time the instance is in neither
// the struct table nor the `gaeBases` registry, so the evidence is the arena — a `TypeDecl`
// whose own name applies the same head (`nameIsGenAppDecl`), the DECLARATION scan
// `nameIsStructDecl` already uses for the nominal case.
type Box<T> = { v: T }
type Node2 = { n: i32 }

// The bare application as a field.
type Holder = { c: Box<i32> }
const h: Holder = { c: { v: 5 } }
print(h.c.v)

// A STRUCT argument: the instance's own field is a nested struct ref, which is why the
// declaration pass has to precede the instance pass.
type Deep = { c: Box<Node2> }
const d: Deep = { c: { v: { n: 7 } } }
print(d.c.v.n)

// The NULLABLE field spelling — one code-15 slot, `nonNulBaseOf` peeled before the scan.
type OptHolder = { c: Box<i32> | null }
const o: OptHolder = { c: { v: 11 } }
const oc = o.c
if oc != null { print(oc.v) }
const e: OptHolder = { c: null }
if e.c == null { print(0) }

// A UNION-VARIANT field: `collectVariantFields` reads the same ladder, so the variant table
// takes the route with the struct table.
type Cat = { c: Box<i32> }
type Dog = { d: i32 }
type U = Cat | Dog
const u: U = { c: { v: 13 } }
if u is Cat { print(u.c.v) }

// The ARRAY-of-application field is the CONTROL — `nameIsArray` claims it several arms
// above, so it lowered before this route existed and must be unmoved by it.
type ListHolder = { c: Box<i32>[] }
const l: ListHolder = { c: [{ v: 16 }, { v: 17 }] }
print(l.c[1].v)

// A field of a field: the instance interned for the outer holder is reached through the
// declared struct, not through another application.
type Outer = { inner: Holder }
const w: Outer = { inner: { c: { v: 19 } } }
print(w.inner.c.v)
