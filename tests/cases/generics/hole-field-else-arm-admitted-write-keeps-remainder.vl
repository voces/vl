// @run
// @log 8
// @log 8
// An alias write in the else arm of an `is` test on a hole's field that stores a member the
// remainder admits keeps the remainder at the pin, as the direct spelling's does (D3420).
type A = { v: i32 }
type B = { s: string }
type W = { h: A | B }
function viaParam<Z>(z: Z) {
  if z.h is B {
    print(z.h.s)
  } else {
    const al = z
    al.h = { v: 8 }
    print(z.h.v)
  }
}
function direct(z: W) {
  if z.h is B {
    print(z.h.s)
  } else {
    const al = z
    al.h = { v: 8 }
    print(z.h.v)
  }
}
const x: W = { h: { v: 3 } }
viaParam(x)
direct(x)
