// @run
// @log null
// @log u
// A lambda returning `T | f64`, pinned once at `i32 | null` and once at `i32 | string`. At the
// second pin the return type is a union holding a nested union, and its row must be minted for
// the flattened `i32 | string | f64` rather than reading the first pin's.
function f<T>(x: T) { print([x].map((e): T | f64 => e)[0]) }
const a: i32 | null = null
f(a)
const b: i32 | string = "u"
f(b)
