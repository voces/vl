// @run
// @log 9
// @log b
// @log 2.5
// @log true
// @log 5000000000
// @log 2
// @log 2
// @log 2
// @log 7
// @log 1
// @log 2
// @log 2
// @log 2
// @log 2
// @log 7
// @log 1
// @log 2
// The LOCAL and PARAM half of `tail-assign-inferred-return.vl`'s shape. A function body's
// LAST statement may be an ASSIGNMENT, and assignment is an EXPRESSION yielding the assigned
// value (DECISIONS: assignment-as-expression), so the function has a value RETURN nobody
// wrote down. Two independent answers decide its type and they must agree:
//
//   * the emitted BODY — `emitBinExprNode`'s `=` arm (`wasmEmit.vl`) lowers it
//     STORE-then-RE-READ, so the value on the stack has the TARGET CELL's rep;
//   * the emitted FUNCTYPE — `emitTypeSection`'s un-annotated-return arm reads `fRetKind`,
//     filled by `criClassify` (`emit_classify.vl`), whose `fnAssignRetKind` dispatches over
//     the target's STORAGE CLASS in the order the emitter resolves a target: a body `let`
//     (`letCellKind`), then a parameter (`vtKindOfParam`), then a module global
//     (`globalCellKind`). Each class asks the very resolver that decides its own valtype.
//
// #1235 gave the GLOBAL target the cell's own answer; #1258 gave the LOCAL and PARAM targets
// theirs, closing the half this file was minted as the floor for. THIS FILE IS THE AGREEING
// SET — the cells where the RHS answer was ALREADY right because storing it needs no
// coercion — and it is now the regression pin for the dispatch's easy rows rather than a
// boundary: it was green before that change and is green after, which is exactly the claim
// worth pinning about a resolver that got a whole storage class re-routed underneath it.
//
// THE DISAGREEING SET HAS ITS OWN PIN NOW: `tests/cases/statements/tail-assign-coercing-local.vl`
// carries the coercing and weaker-RHS LOCAL and PARAM cells — an i32 literal into an
// `i64`/`f64` cell, a member string into a literal-union cell, a value into a nullable cell,
// a variant literal into a union box — every one of them `vl check`-clean INVALID WASM
// before that slice. What is still NOT pinnable is the EMPTY-`[]` rows: they are fixed, but
// the CHECKER types `v = []` as the empty literal's own type, so the function's inferred
// return renders `<none>[]` and `tests/lsp_undisplayable_type_test.ts`'s corpus control
// (rightly) fails any diagnostic-free corpus file carrying an undisplayable inferred type.
// That is the checker-side half, filed at `fnAssignRetTargetName`. The other open rows are
// listed with their counts at `fnAssignRetKind` in `emit_classify.vl` — the if-arm target,
// the deliberately-declined `string | null` cell, the captured local, and the lambda `f32[]`.
//
// One fact that makes the shape easy to mis-file, and it survived the fix: it is POSITIONAL,
// not "the value has no consumer". Appending ANY further statement — even `print(1)`, which
// never reads the assigned cell — moves the assignment out of tail position, and the whole
// family compiles and runs on every build.
type S = { n: i32 }

// ── LOCAL targets ───────────────────────────────────────────────────────────────────────
function locI32() {
  let v = 0
  v = 9
}
print(locI32())

function locStr() {
  let v = "a"
  v = "b"
}
print(locStr())

function locF64() {
  let v = 1.0
  v = 2.5
}
print(locF64())

function locBool() {
  let v = false
  v = true
}
print(locBool())

// An i64 cell assigned an i64-MAGNITUDE literal needs no widening, so the two answers meet.
function locI64() {
  let v: i64 = 1
  v = 5000000000
}
print(locI64())

function locI32List() {
  let v: i32[] = [1]
  v = [1, 2]
}
print(locI32List().length)

function locStrList() {
  let v: string[] = ["x"]
  v = ["p", "q"]
}
print(locStrList().length)

function locF64List() {
  let v: f64[] = [1.5]
  v = [1.5, 2.5]
}
print(locF64List().length)

function locStruct() {
  let v: S = { n: 1 }
  v = { n: 7 }
}
print(locStruct().n)

function locRefList() {
  let v: S[] = [{ n: 1 }, { n: 2 }]
  v = [{ n: 3 }]
}
print(locRefList().length)

function locNested() {
  let v: i32[][] = [[1]]
  v = [[1], [2]]
}
print(locNested().length)

// ── PARAM targets — the third storage class, identical rows ─────────────────────────────
function parI32List(v: i32[]) {
  v = [1, 2]
}
print(parI32List([9]).length)

function parStrList(v: string[]) {
  v = ["p", "q"]
}
print(parStrList(["x"]).length)

function parF64List(v: f64[]) {
  v = [1.5, 2.5]
}
print(parF64List([9.5]).length)

function parStruct(v: S) {
  v = { n: 7 }
}
print(parStruct({ n: 1 }).n)

function parRefList(v: S[]) {
  v = [{ n: 3 }]
}
print(parRefList([{ n: 1 }]).length)

function parNested(v: i32[][]) {
  v = [[1], [2]]
}
print(parNested([[9]]).length)
