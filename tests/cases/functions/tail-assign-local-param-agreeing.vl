// @run
// @log 9
// @log b
// @log 2.5
// @log true
// @log 5000000000
// @log 2
// @log 2
// @log 2
// @log 7
// @log 1
// @log 2
// @log 2
// @log 2
// @log 2
// @log 7
// @log 1
// @log 2
// The LOCAL and PARAM half of `tail-assign-inferred-return.vl`'s shape. A function body's
// LAST statement may be an ASSIGNMENT, and assignment is an EXPRESSION yielding the assigned
// value (DECISIONS: assignment-as-expression), so the function has a value RETURN nobody
// wrote down. Two independent answers decide its type and they must agree:
//
//   * the emitted BODY — `emitBinExprNode`'s `=` arm (`wasmEmit.vl` ~13260) lowers it
//     STORE-then-RE-READ, so the value on the stack has the TARGET CELL's rep;
//   * the emitted FUNCTYPE — `emitTypeSection`'s un-annotated-return arm reads `fRetKind`,
//     filled by `criClassify` (`emit_classify.vl` ~2011), which for a NON-GLOBAL target
//     still reads the assignment's RIGHT-HAND SIDE (`rx = rxe.binRight`).
//
// #1235 gave the GLOBAL target the cell's own answer (`fnAssignRetTargetLet` ->
// `globalCellKind`). A LOCAL or PARAM target has no such resolver in that pass, so it keeps
// the RHS answer — right exactly when storing the RHS needs NO coercion and the RHS's own
// classifier answer is as strong as the cell's. THIS FILE IS THAT AGREEING SET, for both
// non-global storage classes, so a future local-cell resolver has a floor to land on.
//
// THE DISAGREEING SET IS NOT PINNABLE HERE — it is `vl check`-clean INVALID WASM, and
// `@emit-error` cannot pin invalid wasm (`--codegen` exits 0 and `vl build` writes the module
// before failing). Measured on `173367f`, LOCAL and PARAM alike, one minimal program per row:
//
//   COERCING RHS      `i64`/`f64` cell assigned an i32 literal · a literal-union cell assigned
//                     its member string (`K` and `K[]`, aliased and inline) · `i32 | null`
//   WEAKER RHS        an EMPTY `[]` into a `string[]`/`f64[]`/`i64[]`/`f32[]`/`S[]`/`i32[][]`/
//                     `(S | null)[]` cell (the RHS classifies as the DEFAULT i32 list) · a
//                     non-empty literal into an `i64[]`/`f32[]` cell · `null` into any nullable
//                     cell (`S | null`, `S[] | null`, `string | null`, `i32 | null`)
//
// Two facts that make the shape easy to mis-file, both measured here:
//   1. It is POSITIONAL, not "the value has no consumer". Appending ANY further statement —
//      even `print(1)`, which never reads the assigned cell — moves the assignment out of
//      tail position and every row above compiles and runs.
//   2. The PARAM storage class fails identically to the LOCAL one on every row. The filing
//      at `wasmEmit.vl:13228` lists PARAM `i64` alone.
type S = { n: i32 }

// ── LOCAL targets ───────────────────────────────────────────────────────────────────────
function locI32() {
  let v = 0
  v = 9
}
print(locI32())

function locStr() {
  let v = "a"
  v = "b"
}
print(locStr())

function locF64() {
  let v = 1.0
  v = 2.5
}
print(locF64())

function locBool() {
  let v = false
  v = true
}
print(locBool())

// An i64 cell assigned an i64-MAGNITUDE literal needs no widening, so the two answers meet.
function locI64() {
  let v: i64 = 1
  v = 5000000000
}
print(locI64())

function locI32List() {
  let v: i32[] = [1]
  v = [1, 2]
}
print(locI32List().length)

function locStrList() {
  let v: string[] = ["x"]
  v = ["p", "q"]
}
print(locStrList().length)

function locF64List() {
  let v: f64[] = [1.5]
  v = [1.5, 2.5]
}
print(locF64List().length)

function locStruct() {
  let v: S = { n: 1 }
  v = { n: 7 }
}
print(locStruct().n)

function locRefList() {
  let v: S[] = [{ n: 1 }, { n: 2 }]
  v = [{ n: 3 }]
}
print(locRefList().length)

function locNested() {
  let v: i32[][] = [[1]]
  v = [[1], [2]]
}
print(locNested().length)

// ── PARAM targets — the third storage class, identical rows ─────────────────────────────
function parI32List(v: i32[]) {
  v = [1, 2]
}
print(parI32List([9]).length)

function parStrList(v: string[]) {
  v = ["p", "q"]
}
print(parStrList(["x"]).length)

function parF64List(v: f64[]) {
  v = [1.5, 2.5]
}
print(parF64List([9.5]).length)

function parStruct(v: S) {
  v = { n: 7 }
}
print(parStruct({ n: 1 }).n)

function parRefList(v: S[]) {
  v = [{ n: 3 }]
}
print(parRefList([{ n: 1 }]).length)

function parNested(v: i32[][]) {
  v = [[1], [2]]
}
print(parNested([[9]]).length)
