// @run
// @log 3
// @log 4
// A hole function read out of a two-element list and handed a generic called through it at two
// types, while the other element is never called (D6792).
function add(a, b) { return a + b }
function apply2(g) { print(g(1, 2)); print(g(1.5, 2.5)) }
function apply3(g) { print(g(1, 2)); print(g(1.5, 2.5)) }
const fs = [apply2, apply3]
fs[0](add)
