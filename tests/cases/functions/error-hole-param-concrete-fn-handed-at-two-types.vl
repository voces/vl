// @error argument of type (i32) => i32 flows into `run` expecting (string) => string
// A hole parameter handed a concrete function stays refused where it is passed on at two types.
function inc(x: i32): i32 { x + 1 }
function run<U>(f: (x: U) => U, u: U): U { f(u) }
function take(a) {
  print(run(a, 2) + run(a, "ab").length)
}
take(inc)
