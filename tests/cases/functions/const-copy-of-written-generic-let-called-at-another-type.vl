// @run
// @log x
// @log 3
// A `const` copy of a `let` seeded with a generic and written with a hole parameter calls what
// the `let` holds, not the generic it started as (D15048).
function same<T>(k: T): T { k }
function furtherCopy(a) {
  let b = same
  b = a
  const c = b
  print(a("x"))
  print(c(3))
}
furtherCopy(same)
