// @error operator '+' is not defined for boolean and i32
// A field of a record literal is delivered to the field type, a call at its parameters for
// every function written to the binding (D3968).
function inner<U>(u: U) { print(u) }
function plus<V>(v: V) { print(v + 1) }
function other<V>(v: V) { print(v) }
type H = { f: (b: boolean) => void }
function main() {
  let k = inner
  k = plus
  const h: H = { f: k }
  h.f(true)
}
main()
