// @error cannot assign {f: (V) => void} to 'h' of type H
// A field of a record literal is delivered to the field type: the read holds the function its
// most recent write stored, `plus`, which no `boolean` closes (D3968, D15957).
function inner<U>(u: U) { print(u) }
function plus<V>(v: V) { print(v + 1) }
function other<V>(v: V) { print(v) }
type H = { f: (b: boolean) => void }
function main() {
  let k = inner
  k = plus
  const h: H = { f: k }
  h.f(true)
}
main()
