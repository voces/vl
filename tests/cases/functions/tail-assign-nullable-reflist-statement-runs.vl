// @run
// @log 9
// @log true
// The statement-call twin of `tail-assign-nullable-reflist-reject.vl`: nothing reads
// `clearXs()`, so it is `void` (D2631) and its tail assignment lowers as a statement.
type S = { n: i32 }

let xs: S[] | null = [{ n: 1 }]

function clearXs() { xs = null }

clearXs()
print(9)
print(xs == null)
