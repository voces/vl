// @run
// @log 4
// @log ab
// @log 4
// @log true
// @log 9000000001
// A nested function with NO parameters of its own: its RESULT type is decided entirely
// by its captures. `computeRetInference` classifies that result, and it runs long
// before `mAssignTypeIndices` mints the env struct heap types — so a capture kind
// gated on `fnEnvIdx` reads as "not a capture" for the whole of return inference and
// the result falls to the i32 default while the BODY emits the real thing.
//
// `joinCaps` is the sharp cell: every binding in it is annotated, nothing is generic,
// and the function was still declared `(result i32)` around a body producing a string
// ref — `vl check`-clean invalid wasm. The un-annotated twins (`sumCaps`, `cmpCaps`)
// are the same defect reached through the same route.
//
// Each nested function needs a DISTINCT name: capture analysis is name-keyed
// module-wide.
function sumCaps(a, b) {
  function addCaps() a + b
  addCaps()
}
function joinCaps(a: string, b: string) {
  function catCaps() a + b
  catCaps()
}
function sumCapsAnn(a: f64, b: f64) {
  function addCapsAnn() a + b
  addCapsAnn()
}
function cmpCaps(a, b) {
  function underCaps() a < b
  underCaps()
}
function sumCapsI64(a: i64, b: i64) {
  function addCapsI64() a + b
  addCapsI64()
}
print(sumCaps(2.5, 1.5))
print(joinCaps("a", "b"))
print(sumCapsAnn(2.5, 1.5))
print(cmpCaps(1.5, 2.5))
print(sumCapsI64(9000000000, 1))
