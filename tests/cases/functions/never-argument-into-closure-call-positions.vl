// @run
// @log 3
// @log 1.5
// @log 7
// @log 4
// @log 9
// A function-value call whose argument is a call that never returns, at each scalar parameter
// width and through a local lambda, a parameter and a record field. The argument stops before the
// call, which is reached only on the untaken path.
function fail(): never { __trap__() }
function k(n: i32) {
  const f = (x) => x
  if n > 5 { f(__trap__()) }
  return n
}
function kf(n: i32) {
  const g = (x: f64) => x / 2.0
  if n > 5 { return g(fail()) }
  return g(3.0)
}
function ki(n: i32) {
  const h = (x: i64) => x + 1
  if n > 5 { return h(fail()) }
  return h(6)
}
function viaParam(p: (x: i32) => i32, n: i32) {
  if n > 5 { return p(__trap__()) }
  return p(n)
}
function viaField(n: i32) {
  const r = { f: (x: i32) => x * 3 }
  if n > 5 { return r.f(fail()) }
  return r.f(n)
}
print(k(3))
print(kf(3))
print(ki(3))
print(viaParam((x) => x + 1, 3))
print(viaField(3))
