// @emit-error cannot take the generic function `npadd` as a value
// The OTHER boundary of the partial-annotation value path: a context that declares NOTHING.
// `const fs = [npadd]` is a bare array literal with no annotation, so there is no type to fill
// `npadd`'s hole `b` from — the value floor rejects, exactly as it does for a fully un-annotated
// function in the same position. What closed the annotated cells was reading the type the CONTEXT
// declares; where the context declares none, nothing changed and nothing should have.
//
// No call site pins `npadd` by name either — the only call goes through the array — so the message
// takes its no-inferred-signature branch and asks for the annotation rather than implying one.
// `generic-fn-value-partial-annotation.vl` is the accepting twin: annotate the array
// (`((i32, i32) => i32)[]`) and the same value materializes.
function npadd(a: i32, b) { return a + b }

function go() {
  const fs = [npadd]
  print(fs[0](1, 2))
}

go()
