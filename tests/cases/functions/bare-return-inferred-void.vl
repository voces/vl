// @run
// @log 1
// @log 1
// @log 0
// @log 5
// @log 7
// @hint redundant type annotation: `g` is inferred as `i32` — remove it to lean on inference
// `g`'s `: i32` is DECLARED redundant, not removed — it is the control's whole point that the
// function genuinely returns a value, and writing that down is how a reader sees it.
// Regression (silent-class-inventory D1032).
//
// A bare `return` used as a guard clause was refused at EMIT — `bare return is not supported`,
// reported at the FUNCTION NAME — because the function's INFERRED result type was not void.
// Found building `std/json.vl`, whose renderer was void and used bare returns as guards.
//
// NOTHING IN THE SOURCE SAYS "NON-VOID". The body's tail is `if n == 1 { buf.push(1) }`, whose
// last expression is a `push`; the else-less `if` makes the checker infer `i32 | null`, and
// `inferRetBearsNull` keeps the function non-void on that alone. Nobody wrote a return type
// and nobody returned a value.
//
// A BARE `return` IS THE AUTHOR SETTLING THE QUESTION. You cannot `return;` out of a function
// that owes a value, so its presence in the body is a written statement that this function
// returns nothing — and it now vetoes the nullable inference the same way an empty tail arm
// does (D1034, the sibling gate). Both are "the source says void" beating "the inference
// guessed non-void".
//
// THE MESSAGE WAS ALSO FALSE AS WRITTEN. A bare `return` IS supported and lowers to `0x0f`
// two lines above the reject; what is refused is a bare return from a NON-VOID function.
// "not supported" sent a reader looking for a missing keyword lowering instead of at why
// their function is non-void.
function f(n: i32, buf: i32[]) {
  if n == 0 {
    buf.push(0)
    return
  }
  if n == 1 {
    buf.push(1)
  }
}

// the guard path, the tail path, and neither
const b1: i32[] = []
f(0, b1)
print(b1.length)

const b2: i32[] = []
f(1, b2)
print(b2.length)

const b3: i32[] = []
f(9, b3)
print(b3.length)

// THE CONTROL: a function that genuinely returns a value keeps doing so. A veto that fired on
// any `return` at all would break this.
function g(n: i32): i32 {
  if n == 0 { return 5 }
  7
}
print(g(0))
print(g(1))
