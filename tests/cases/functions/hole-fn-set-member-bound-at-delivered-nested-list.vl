// @run
// @log 6
// @log 2.5
// @hint Intentionally-unused parameter `_n` (leading `_` marks it unused)
// @log 4
// A set's un-annotated members delivered to a closed function type bind their holes at its
// parameters, each one, so the second member of a nested list has an instance at the delivered
// signature beside the one its other read takes (D16700).
function inc(a) { return a + 1 }
function dbl(a) { return a * 2 }
function give(_n) {
  const w = [[inc], [dbl]]
  return w
}
function deliver(): ((a: i32) => i32)[][] { return give(1) }
print(deliver()[1][0](3))
print(give("s")[1][0](1.25))
const ws = deliver()
print(ws[0][0](3))
