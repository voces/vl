// @run
// @log null
// @log 3
// @log 4
// @log -1
// @log 0
// @log null
// @log 10
// @log 16
// @log 10
// @log 5
// @log hi
// A parameter default naming a module `const` whose cell is start-initialised (a `null`
// value box, a closure, a const read through another const) is delivered with the same
// non-null recovery the argument spelling of that read gets, in every frame (D3510, D3277,
// D3323).
const bv: i32 | null = null
function g(d: i32 | null = bv) { print(d) }
g()
const N: i32 | null = null
function f(x: i32 | null = N) { print(x ?? 3) }
f()
f(4)
const Fn: f64 | null = null
function h(a: f64, x: f64 | null = Fn) { print((x ?? -1.0) + a) }
h(a: 0.0)
const U: i32 | string | null = null
function u<A>(a: A, x: i32 | string | null = U) {
  print(a)
  print(x)
}
u(0)
const K = (n: i32) => n * 2
function k(x: i32 | null = N, c: (n: i32) => i32 = K) { print((x ?? 0) + c(5)) }
function frame() { k() }
frame()
const lam = () => {
  k(6)
}
lam()
print(K(5))
const C0 = 5
const C1: i32 | null = C0
function m(x: i32 | null = C1) { print(x ?? 0) }
m()
const S0 = "hi"
const S = S0
function sf(x: string = S) { x }
print(sf())
