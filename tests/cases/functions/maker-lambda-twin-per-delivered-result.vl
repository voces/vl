// @run
// @log 2
// @log 2
// @log 2
// @log 4
// @log 0.5
// @log 1.125
// @log 4
// @log 0.5
// A maker returning a hole lambda, delivered at two function types whose results differ, builds
// a closure per delivered result; a lambda the maker does not return keeps its own (D16753).
function deliver() {
  const g = (a) => a + 1
  print(g(1))
  return (a) => a * 3 + 1
}
const v: (a: i32) => i32 = deliver()
const w: (a: i32) => f64 = deliver()
const x: (a: i32) => f64 = deliver()
print(v(1))
print(w(1) / 8.0)
print(x(3) / 8.0 - 0.125)
function make() { return (a) => a + 1 }
function both(p: (a: i32) => i32, q: (a: i32) => f64) {
  print(p(3))
  print(q(3) / 8.0)
}
both(make(), make())
