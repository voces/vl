// A lambda reached through a chain of `const` aliases, called with a generic it calls at two
// types, runs like one alias of it (D6420). Also three aliases deep, read by two names, inside a
// function, and read from a function that declares its own lambda by the first name.
function id(a) { return a }
const lap = (g) => {
  print(g(1) + 1)
  return g("s")
}
const k = lap
const k2 = k
print(k2(id))
const k3 = k2
print(k3(id))
print(k2(id))
function main() {
  const lap2 = (g) => {
    print(g(1) + 1)
    return g("s")
  }
  const j = lap2
  const j2 = j
  print(j2(id))
}
main()
function other() {
  const lap = (g) => {
    print(g(10))
    return g("t")
  }
  print(lap(id))
}
other()
