// @run
// The CONSUMER-POSITION axis of `coalesce-bool-short-circuit.vl`, which pins the LHS-SOURCE
// axis. Position cannot change WHICH emit arm fires — every position reaches `emitCoalesce`
// through `emitExpr`, and the arm is chosen by the LHS's rep — so this file exists to pin the
// negative: `??` short-circuiting must not depend on where the expression sits, including the
// positions that put a CONTROL FRAME around it (a condition, a loop body, a nested `??`),
// which is where an `if`-framed lowering could get its branch depth wrong.
//
// A LOG-MISMATCH pin in both directions, for the reason its sibling gives: `RHS RAN` must be
// absent on the present leg and PRESENT on the null leg.
// @log bind/present
// @log true
// @log bind/null
// @log RHS RAN
// @log false
// @log annotated/present
// @log true
// @log annotated/null
// @log RHS RAN
// @log false
// @log arg/present
// @log true
// @log arg/null
// @log RHS RAN
// @log false
// @log return/present
// @log true
// @log return/null
// @log RHS RAN
// @log false
// @log fieldinit/present
// @log true
// @log fieldinit/null
// @log RHS RAN
// @log false
// @log eleminit/present
// @log true
// @log eleminit/null
// @log RHS RAN
// @log false
// @log chain/left-present
// @log true
// @log chain/middle-present
// @log true
// @log chain/both-null
// @log RHS RAN
// @log false
// @log cond/present
// @log T
// @log cond/null
// @log RHS RAN
// @log F
// @log while/present
// @log 2
// @log while/null
// @log RHS RAN
// @log 0
// @log logical/present
// @log true
// @log logical/null
// @log RHS RAN
// @log false
// @log not/present
// @log false
// @log not/null
// @log RHS RAN
// @log true
// @log assign/present
// @log true
// @log assign/null
// @log RHS RAN
// @log false
// @log loopbody/present
// @log T
// @log T
// @log loopbody/null
// @log RHS RAN
// @log F
// @log RHS RAN
// @log F
// @hint redundant type annotation: `v` is inferred as `boolean`
// @hint redundant type annotation: `posRet` is inferred as `boolean`
// @hint redundant type annotation: `h` is inferred as `{f: boolean}`
// @hint redundant type annotation: `xs` is inferred as `boolean[]`

function loud() {
  print("RHS RAN")
  false
}

function takesB(b: boolean) { print(b) }

type Holder = { f: boolean }

// ── an inferred binding init ──
function posBind(p: boolean | null) {
  const v = p ?? loud()
  print(v)
}
print("bind/present")
posBind(true)
print("bind/null")
posBind(null)

// ── an ANNOTATED binding init ──
function posAnn(p: boolean | null) {
  const v: boolean = p ?? loud()
  print(v)
}
print("annotated/present")
posAnn(true)
print("annotated/null")
posAnn(null)

// ── an ARGUMENT ──
function posArg(p: boolean | null) { takesB(p ?? loud()) }
print("arg/present")
posArg(true)
print("arg/null")
posArg(null)

// ── a RETURN ──
function posRet(p: boolean | null): boolean { return p ?? loud() }
print("return/present")
print(posRet(true))
print("return/null")
print(posRet(null))

// ── a struct FIELD initializer ──
function posFieldInit(p: boolean | null) {
  const h: Holder = { f: p ?? loud() }
  print(h.f)
}
print("fieldinit/present")
posFieldInit(true)
print("fieldinit/null")
posFieldInit(null)

// ── an array ELEMENT initializer ──
function posElemInit(p: boolean | null) {
  const xs: boolean[] = [p ?? loud()]
  print(xs[0])
}
print("eleminit/present")
posElemInit(true)
print("eleminit/null")
posElemInit(null)

// ── a NESTED `??`: `a ?? b ?? d` re-associates to `a ?? (b ?? d)`, so the MIDDLE operand
// becomes an LHS in its own right and the default is reached only when both are null.
function posChain(p: boolean | null, q: boolean | null) { print(p ?? q ?? loud()) }
print("chain/left-present")
posChain(true, null)
print("chain/middle-present")
posChain(null, true)
print("chain/both-null")
posChain(null, null)

// ── inside an `if` CONDITION ──
function posCond(p: boolean | null) {
  if p ?? loud() { print("T") } else { print("F") }
}
print("cond/present")
posCond(true)
print("cond/null")
posCond(null)

// ── inside a `while` CONDITION: the RHS must not run on ANY of the iterations whose LHS
// is present, so the present leg prints no `RHS RAN` at all despite three condition evals.
function posWhile(p: boolean | null) {
  let n = 0
  while (p ?? loud()) && n < 2 { n = n + 1 }
  print(n)
}
print("while/present")
posWhile(true)
print("while/null")
posWhile(null)

// ── as an operand of `||` ──
function posLogic(p: boolean | null) { print((p ?? loud()) || false) }
print("logical/present")
posLogic(true)
print("logical/null")
posLogic(null)

// ── under a `!` ──
function posNot(p: boolean | null) { print(!(p ?? loud())) }
print("not/present")
posNot(true)
print("not/null")
posNot(null)

// ── on the RHS of an ASSIGNMENT ──
function posAssign(p: boolean | null) {
  let v = false
  v = p ?? loud()
  print(v)
}
print("assign/present")
posAssign(true)
print("assign/null")
posAssign(null)

// ── inside a `for` BODY, so the lowering's own `if` frame is nested in the loop's ──
function posLoopBody(p: boolean | null) {
  for i in 0 to 1 {
    if p ?? loud() { print("T") } else { print("F") }
  }
}
print("loopbody/present")
posLoopBody(true)
print("loopbody/null")
posLoopBody(null)
