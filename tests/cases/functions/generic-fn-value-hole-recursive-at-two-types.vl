// A hole parameter called at two types in a function that hands it back to itself takes a
// parameter per type, and the recursive call hands on every one (D6091).
function same<T>(k: T): T { k }
function sameH(k) { k }
function take(b) { print(b(true)) }
function mid(a, n: i32) {
  print(a("x"))
  print(a(n))
  if n > 0 { mid(a, n - 1) }
}
function first(a, n: i32) {
  if n > 0 { first(a, n - 1) }
  print(a("x"))
  print(a(n))
}
function midH(a, n: i32) {
  print(a("x"))
  print(a(n))
  if n > 0 { midH(a, n - 1) }
}
function viaTake(a, n: i32) {
  print(a("x"))
  take(a)
  if n > 0 { viaTake(a, n - 1) }
}
function main() {
  const s = same
  mid(s, 1)
}
mid(same, 1)
first(same, 1)
viaTake(same, 1)
main()
midH(sameH, 1)
