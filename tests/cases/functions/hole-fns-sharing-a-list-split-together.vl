// @run
// @log 3
// @log 4
// @log 3
// @log 4
// @log 3
// @log 4
// Hole functions sharing a list literal, each called through it with a generic it calls at two
// types, split their parameter at the same keys (D6832).
function add(a, b) { return a + b }
function apply2(g) {
  print(g(1, 2))
  print(g(1.5, 2.5))
}
function apply3(g) {
  print(g(1, 2))
  print(g(1.5, 2.5))
}
const fs = [apply2, apply3]
fs[0](add)
fs[1](add)
const h = fs[1]
h(add)
