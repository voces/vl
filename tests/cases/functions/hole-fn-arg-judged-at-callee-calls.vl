// @run
// @log vv4
// @log vv4
// @log v4
// @log 1
// @log s
// @log 6.5
// @warning Unused parameter `g`
// A declared function handed to a hole parameter is judged at each call the callee's body makes
// of it, and runs where its body takes every one of those instances (D6190).
function tos(a) { return "v" + a }
function str(a) { return "v\{a}" }
function id(a) { return a }
function inc(a) { return a + 1 }
let lap = (g, x) => x
lap = (g, x) => g(g(x))
function lap2(g, h, x) { return h(g(x)) }
function lap1(g, x) { return g(x) }
function both(g) {
  print(g(1))
  return g("s")
}
function twice(g, x) { return g(g(x)) }
print(lap(tos, "4"))
print(lap2(str, str, 4))
print(lap1(str, 4))
print(both(id))
print(twice(inc, 4.5))
