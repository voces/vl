// @run
// @log 7
// @log 8
// @log 2
// @log 6
// @log 12
// A generic function handed on bare to a callee that calls it at two types gives the call the
// result the callee's body reads with each call at its own instance, as the direct spelling
// does, so an un-annotated `const` of it builds (D15648).
function dbl(v) { return v + v }
function c2(r, x) { return r(x) + r(1) }
function c1(r, x) { return r(x) }
function both2(g) { return c2(g, 2.5) }
function bothD(g) {
  print(g(1))
  return c1(g, 2.5)
}
function c3(r, x) { return r(x) * r(2) }
function both3(g) { return c3(g, 1.5) }
const b = both2(dbl)
print(b)
print(b + 1)
const d = bothD(dbl)
print(d + 1)
const e = both3(dbl)
print(e)
