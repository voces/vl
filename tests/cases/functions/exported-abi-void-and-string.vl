// @run
// @log hi!
// @log 6
// @log 2
// The wrapper's RESULT-SHAPE coverage: a VOID export and a `string` export in the same
// function-value-using module (#1264).
//
// The wrapper's functype is produced by the same `emitOneFuncType` the main type-section
// loop uses, called with `withEnv` false — so a void result stays 0 results, and a string
// param/result keeps its `(ref 0)` rep, without a second copy of the result dispatch (which
// branches a dozen ways over void / closure / inferred / annotated returns). These two
// exported as `(structref, (ref 0)) -> ()` and `(structref, i32) -> i32` before; they now
// export `((ref 0)) -> ()` and `(i32) -> i32`.
export function shout(s: string) { print(s + "!") }

export function twice(n: i32): i32 { return n * 2 }

const h = (x: i32) => x + 1
shout("hi")
print(twice(3))
print(h(1))
