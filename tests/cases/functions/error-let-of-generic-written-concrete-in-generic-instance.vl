// @error cannot assign boolean to i32
// Inside a generic, a call at the type parameter is refused at the instance whose argument
// does not fit the written function (D3960).
function inner<U>(u: U) { print(u) }
function q(n: i32) { print(n) }
function a<T>(x: T) {
  let k = inner
  k = q
  k(x)
}
a(1)
a(true)
