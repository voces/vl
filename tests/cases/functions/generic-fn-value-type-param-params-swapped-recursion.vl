// Parameters whose only use of their type parameter `F` is its bare annotation take a
// parameter per type when a recursive call hands them back in other positions (D6240).
function same<T>(k: T): T { k }
function twice<T>(k: T): T { k }
function mid<F>(a: F, b: F, n: i32) {
  print(a("x"))
  print(b(n))
  if n > 0 { mid(b, a, n - 1) }
}
function rot<F>(a: F, b: F, c: F, n: i32) {
  print(a("x"))
  print(b(n))
  print(c(1.5))
  if n > 0 { rot(c, a, b, n - 1) }
}
function third<F>(a: F, b: F, c: F, n: i32) {
  print(a("x"))
  print(b(n))
  print(c("c"))
  if n > 0 { third(b, a, c, n - 1) }
}
function main() { mid(same, twice, 1) }
mid(same, same, 1)
rot(same, same, same, 2)
third(same, same, same, 1)
main()
