// @run
// @log 11
// @log 110
// @log 3
// @log 30
// @log 11
// @log 110
// @log 103
// @log 103
// @log 11
// @log 1010
// @hint redundant type annotation: `inner` is inferred as `i32`
// @hint redundant type annotation: `mid` is inferred as `i32`
// @hint redundant type annotation: `sibA` is inferred as `i32`
// @hint redundant type annotation: `sibB` is inferred as `i32`
// @hint redundant type annotation: `count` is inferred as `i32`
// @hint redundant type annotation: `recA` is inferred as `i32`
// @hint redundant type annotation: `recB` is inferred as `i32`
// @hint redundant type annotation: `lamA` is inferred as `i32`
// @hint redundant type annotation: `lamB` is inferred as `i32`
// @hint redundant type annotation: `innermost` is inferred as `i32`
// @hint redundant type annotation: `deep` is inferred as `i32`
// @hint redundant type annotation: `threeLevels` is inferred as `i32`
// @hint redundant type annotation: `topInner` is inferred as `i32`
// @hint redundant type annotation: `chainA` is inferred as `i32`
// @hint redundant type annotation: `chainB` is inferred as `i32`
// THE SCOPE **CHAIN**, not just the calling frame.
//
// The one-level resolver (`fnIndexOfInScope`) matches a lifted function whose PARENT is
// the calling frame itself. That misses three rungs, each of which stayed a silent wrong
// answer after the direct-collision fix:
//
//   - a SIBLING nested function's call (`mid` calls the `inner` declared beside it —
//     `inner`'s parent is the enclosing frame, not `mid`);
//   - a LAMBDA's call into its enclosing frame (the lambda is its own lifted frame);
//   - a nested function's own RECURSIVE call (the frame that declares it is its PARENT,
//     one step out) — which silently rewired the recursion to the other frame's twin and
//     printed 12 for 30.
//
// `fnIndexOfInScopeChain` walks outward and takes the innermost declaration. The last two
// groups are the CONTROLS: innermost must still beat outermost, and running off the chain
// must still reach a TOP-LEVEL function even when it is declared later in the file.

// (1) SIBLING: `mid` calls the `inner` declared beside it in its own frame.
function sibA(): i32 {
  function inner(x: i32): i32 { return x + 1 }
  function mid(x: i32): i32 { return inner(x) }
  return mid(10)
}
function sibB(): i32 {
  function inner(x: i32): i32 { return x + 100 }
  function mid(x: i32): i32 { return inner(x) }
  return mid(10)
}
print(sibA())
print(sibB())

// (2) RECURSION: each frame's `count` calls ITSELF. On master `countB` reached
// `countA`'s `count` and printed 12.
function recA(n: i32): i32 {
  function count(x: i32): i32 {
    if x <= 0 { return 0 }
    return 1 + count(x - 1)
  }
  return count(n)
}
function recB(n: i32): i32 {
  function count(x: i32): i32 {
    if x <= 0 { return 0 }
    return 10 + count(x - 1)
  }
  return count(n)
}
print(recA(3))
print(recB(3))

// (3) a LAMBDA calling its enclosing frame's nested function.
function lamA(): i32 {
  function inner(x: i32): i32 { return x + 1 }
  const g = (y: i32) => inner(y)
  return g(10)
}
function lamB(): i32 {
  function inner(x: i32): i32 { return x + 100 }
  const g = (y: i32) => inner(y)
  return g(10)
}
print(lamA())
print(lamB())

// (4) CONTROL — INNERMOST WINS. A nested `mid` that declares its OWN `inner` must use
// that one, not the frame-level `inner` one step further out.
function innermost(): i32 {
  function inner(x: i32): i32 { return x + 1 }
  function mid(x: i32): i32 {
    function inner(y: i32): i32 { return y + 100 }
    return inner(x)
  }
  return inner(1) + mid(1)
}
print(innermost())

// (5) CONTROL — three nesting LEVELS with the name declared at level 1 and level 3.
function threeLevels(): i32 {
  function inner(x: i32): i32 { return x + 1 }
  function mid(x: i32): i32 {
    function deep(y: i32): i32 {
      function inner(z: i32): i32 { return z + 100 }
      return inner(y)
    }
    return deep(x) + inner(x)
  }
  return mid(1)
}
print(threeLevels())

// (6) CONTROL — running OFF the chain reaches a TOP-LEVEL function, even one declared
// AFTER the frame that shadows it. (Top-level functions enter `fnStmts` before any lift,
// so the flat map already preferred `topInner` here — the chain walk must not disturb
// that, and must still let `chainA` see its own.)
function chainA(): i32 {
  function topInner(x: i32): i32 { return x + 1 }
  return topInner(10)
}
function topInner(x: i32): i32 { return x + 1000 }
function chainB(): i32 {
  return topInner(10)
}
print(chainA())
print(chainB())
