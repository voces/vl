// @run
// @log 3
// @log 4
// @log 7
// @log 1
// @log s
// A hole function read out of a list literal and handed a generic it calls at two types is split
// like a call by name, for an un-annotated and a declared generic (D6764).
function add(a, b) { return a + b }
function apply2(g) {
  print(g(1, 2))
  print(g(1.5, 2.5))
}
const fs = [apply2]
fs[0](add)
print(add(3, 4))
function same<T>(k: T): T { k }
function apply1(g) {
  print(g(1))
  print(g("s"))
}
const gs = [apply1]
gs[0](same)
