// @log 3
// @log 4
// @log 3
// @log 4
// A hole function called through a `const` alias, at module scope, inside a function and
// through a forward, beside a direct call, takes a parameter per type its calls use (D6261).
function add(a, b) { return a + b }
function apply2(g) {
  print(g(1, 2))
  print(g(1.5, 2.5))
}
const h = apply2
h(add)
apply2(add)
function main() {
  const k = apply2
  k(add)
}
main()
function fwd(f) { h(f) }
fwd(add)
