// @run
// @log 0
// @log 1
// @log 6
// @log a-b-c
// @log []
// @log 7
// @log a

// A rest parameter packs its trailing arguments into a list
// (`docs/internals/variadics-design.md`). Inside the callee `xs` is an ordinary mutable
// `T[]`; with no argument reaching it, it is the empty list, which is what makes the
// accepted arity "at least the fixed head" rather than a closed range.
function sum(...xs: i32[]) {
  let t = 0
  let i = 0
  while i < xs.length {
    t = t + xs[i]
    i = i + 1
  }
  return t
}

// A fixed head before the rest, and a non-scalar element: the pack is one list at the
// element's own rep, so a string rest is a string list and not a boxed one.
function join(sep: string, ...parts: string[]) {
  let out = ""
  let i = 0
  while i < parts.length {
    if i > 0 { out = out + sep }
    out = out + parts[i]
    i = i + 1
  }
  return out
}

// The rest element is a HOLE, bound from the first trailing argument and checked against
// for the others — the ordinary first-use-wins rule, reached through the packed list's own
// element type rather than through a rule of its own.
function first<T>(...xs: T[]): T { return xs[0] }

print(sum())
print(sum(1))
print(sum(1, 2, 3))
print(join("-", "a", "b", "c"))
print("[" + join("-") + "]")
print(first(7, 8))
print(first("a", "b"))
