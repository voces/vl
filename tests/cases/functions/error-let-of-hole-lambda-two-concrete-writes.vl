// @error cannot assign (boolean) => void to `k`, which holds (i32) => void since the write on line 9 — a binding holds one function type
// A hole-lambda seed is fixed by its first concrete write as a generic seed is (D3960).
function cI32(n: i32) { print(n + 100) }
function cBool(b: boolean) { print(!b) }
function main() {
  let k = (u) => {
    print(u)
  }
  k = cI32
  k = cBool
  print("ok")
}
main()
