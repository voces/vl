// @run
// @log 9
// @log false
// @log 3
// @log 4
// @log 5
// @log 6
// @log 7
// @log x
// @log b
// @log 2
// A function whose parameter is a union or `T | null` is a function of each member: delivered
// where the parameter is one member, it is adapted, as a record arm is (D16181). A number
// widened into the parameter is no member, so `(a: f64)` at `(a: i32)` stays refused.
function w<B>(a: i32 | string, b: B) {
  print(a)
  print(b)
}
function run(f: (a: i32, b: boolean) => void) { f(9, false) }
run(w)

function u(a: i32 | string | null) { print(a) }
function one(f: (a: i32) => void, n: i32) { f(n) }
one(u, 3)
const fs: ((a: i32) => void)[] = [u]
fs[0](4)
type H = { f: (a: i32) => void }
const h: H = { f: u }
h.f(5)
function mk(): (a: i32) => void { return u }
mk()(6)
const m: {[string]: (a: i32) => void} = Map()
m.set("k", u)
const got = m["k"]
if got != null { got(7) }

function orNone(a: string | null) { print(a ?? "none") }
function str(f: (a: string) => void) { f("x") }
str(orNone)

type K = "a" | "b"
function kOr(a: K | i32) { print(a) }
function onK(f: (a: K) => void) { f("b") }
onK(kOr)

function count(_a: i32 | string): i32 { return 1 }
function inc(f: (a: i32) => i32) { print(f(3) + 1) }
inc(count)
