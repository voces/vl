// @run
// @log 2
// @log 2.5
// @log 2.5
// Two widened bindings of one function set, one writing its initialiser's function back from an
// `if` arm, dispatch by id (D15337).
function id1(a) { return a }
function id2(a) { return a }
function id3(a) { return a }
const c = 1 > 0
const n = 3
let r = { f: id1 }
r = if c { { f: id2 } } else { { f: id3 } }
print(r.f(2))
print(r.f(2.5))
let e = { f: id1 }
e = if n > 5 { { f: id2 } } else if n > 1 { { f: id3 } } else { { f: id1 } }
print(e.f(2.5))
