// @run
// @log 4
// @log true
// @log true
// @log 4
// A call of a constant list's element past 0 is typed through that element (D10892, D10894, D10895).
function apply2(g) { print(g(1, 2)) }
function apply3(g) { print(g(1.5, 2.5)) }
const gs = [apply2, apply3]
const l = (a, b) => a + b
gs[1](l)

function eq2<T>(g, x: T) { print(g(x, x)) }
function eq3<T>(g, x: T) {
  print(g(x, x))
  print(g(x, x))
}
const es = [eq2, eq3]
es[1]((a, b) => a == b, 7)

function h(g) { print(g(1.5, 2.5)) }
function relay3(g) { h(g) }
const rs = [apply2, relay3]
rs[1]((a, b) => a + b)
