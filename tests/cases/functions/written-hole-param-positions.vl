// @run
// @log 6
// @log 8
// @log 4
// @log 42
// @log 8
// @log 9
// An un-annotated parameter the body writes, at each position the write and its read take.
function id<T>(x: T): T { return x }
function dbl<T>(x: T): T { return x + x }
// written, then called
function w1(a) {
  a = dbl
  print(a(3))
}
w1(id)
// written in one branch of an `if`
function w2(a, flip: boolean) {
  if flip { a = dbl }
  print(a(4))
}
w2(id, true)
w2(id, false)
// a scalar hole parameter written from itself
function w3(n) {
  n = n + 1
  print(n)
}
w3(41)
// written in a loop
function w4(n) {
  let i = 0
  while i < 3 {
    n = n * 2
    i = i + 1
  }
  print(n)
}
w4(1)
// written, then returned
function w5(n) {
  n = n - 1
  return n
}
print(w5(10))
