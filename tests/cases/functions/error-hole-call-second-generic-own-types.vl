// @check
// @error operator '+' is not defined for string and i32 (the call's argument types)
// @error operator '+' is not defined for boolean and i32 (the call's argument types)
// A second generic handed to the same hole is read at its own result type, so a body
// ill-typed at that result still refuses at the call that hands it (D6521).
function same<T>(k: T): T { k }
function str<T>(_k: T): string { "s" }
function isIt<T>(_k: T): boolean { true }
function viaResult(a) {
  print(a("x"))
  print(a(3) + 1)
}
viaResult(same)
viaResult(str)
viaResult(isIt)
