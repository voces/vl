// @run
// @log 3
// @log 3
// @log 7
// @log b
// @log 2
// @log 5
// @hint redundant type annotation: `s` is inferred as `{n: i32}`
// The EXPLICIT spelling of the same shape: `return (g = e)`. It reaches the identical
// `emitBinExprNode` `=` arm as an implicit tail assignment, so it takes the identical
// answer — the assignment TARGET's cell kind — and `fnAssignRetTargetLet`
// (`emit_classify.vl`) looks through the tail `RetStmt` to find it.
//
// This spelling was broken WIDER than the implicit one: on master even the
// NON-coercing ref cells failed (`return (s = {n: 3})` over a plain `S` global emitted
// invalid wasm), because the RHS classifier's struct arm ran on the assignment node
// rather than on the value.
type S = { n: i32 }
type K = "a" | "b"
type Cat = { legs: i32 }
type Dog = { tail: i32 }
type U = Cat | Dog

// A NON-coercing struct cell — broken on master in this spelling alone.
let s: S = { n: 0 }

function setS() { return (s = { n: 3 }) }

print(setS().n)
print(s.n)

// A WIDENING store.
let wide: i64 = 0

function setWide() { return (wide = 7) }

setWide()
print(wide)

// A LITERAL-UNION atom.
let k: K = "a"

function setK() { return (k = "b") }

setK()
print(k)

// A ref-ARRAY cell (`S[]`), whose result valtype needs this slot's element wrapper.
let xs: S[] = []

function setXs() { return (xs = [{ n: 2 }]) }

print(setXs()[0].n)

// A UNION cell: the store boxes, so the result is the box.
let u: U = { legs: 4 }

function setU() { return (u = { tail: 5 }) }

setU()
if u is Dog { print(u.tail) }
