// @check
// @error-at 11:3 comparison expects numeric operands, got void and i32 — `bump` ends in a call with no `return`: write `return` before its last expression
// @error-at 12:6 operator '*' is not defined for void and i32 — `bump` ends in a call with no `return`: write `return` before its last expression
// @error-at 13:6 unary '-' expects a numeric type, got void — `bump` ends in a call with no `return`: write `return` before its last expression
// @error-at 14:3 operator '!' expects boolean, got void — `isOk` ends in a call with no `return`: write `return` before its last expression
// A `void` operand of a comparison, an arithmetic or a unary operator, from an un-annotated
// function whose block body ends in a call, names that function and where its `return` goes.
function prep(x: i32): i32 { return x - 1 }
function bump(x: i32) { prep(x) }
function ok(x: i32): boolean { return x > 0 }
function isOk(x: i32) { ok(x) }
if bump(3) < 0 { print("neg") }
print(bump(2) * 2)
print(-bump(3))
if !isOk(1) { print("no") }
