// @check
// @error a default value must be a literal, a module-level `const`, or `__callsite__`
// A module-scope `let` is NOT a legal default. The `const` restriction is what
// makes "the expression comes from the declaration, its evaluation position is
// the call" a distinction with no observable consequence: an immutable module
// binding has the same value at every site, so the two readings cannot be told
// apart and v1 owes no answer about which it meant. A `let` can change between
// two calls, which would make the question real — and answerable only by
// deciding something this feature deliberately does not decide.
let K: i32 = 7
function f(a: i32, b: i32 = K): i32 { a + b }
print(f(1))
