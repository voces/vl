// @run
// @log 1.5
// @log 4
// @log 1.5
// @log 1.5
// @log 1.5
// @log 4
// @log 1.5
// A list of lists of records whose nested record's field holds un-annotated functions of
// different result types: a call through `xs[i][j].a.f` runs the function stored there, its
// nested record literals built at the list's rep (D16835).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const xs = [[{ a: { f: inc0 } }], [{ a: { f: half } }]]
print(xs[1][0].a.f(3))
print(xs[0][0].a.f(3))
const deep = [[{ a: { b: { f: inc0 } } }], [{ a: { b: { f: half } } }]]
print(deep[1][0].a.b.f(3))
const ys = [[{ a: { f: inc0 } }]]
ys.push([{ a: { f: half } }])
print(ys[1][0].a.f(3))
ys[0].push({ a: { f: half } })
print(ys[0][1].a.f(3))
for row in xs {
  for r in row { print(r.a.f(3)) }
}
