// @run
// @log x
// @log 3
// @log x
// @log 3
// @log x
// @log 3
// A generic handed to a parameter typed at a bare type parameter `F` stays generic, as an
// un-annotated one does (D5611): `F` is the generic's type, and each call through the parameter
// instances it at its own types. The un-annotated twin, and a delivery through a `const` alias.
function same<T>(k: T): T { k }
function take(a) { print(a("x")) }
function take2(a) { print(a(3)) }
function mid<F>(a: F) {
  take(a)
  take2(a)
}
mid(same)

function midU(a) {
  take(a)
  take2(a)
}
midU(same)

const h = same
mid(h)
