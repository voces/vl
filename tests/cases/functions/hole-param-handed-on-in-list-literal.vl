// @run
// @log 5
// @log 6
// @log 7
// @log 2
// A hole parameter handed on inside a list literal stays its caller's hole, so the callee's demands
// on the element reach the function or record the caller is given (D15565).
function h(v) { return v }
function call0(fs, x) { print(fs[0](x)) }
function run(g) { call0([g], 5) }
run(h)
function runLet(g) {
  const fs = [g]
  call0(fs, 6)
}
runLet((v: i32) => v)
function runTwice(g) {
  g(1)
  call0([g], 7)
}
runTwice(h)
function field0(rs) { print(rs[0].a) }
function runRec(r) { field0([r]) }
runRec({ a: 2 })
