// @run
// @log 1
// @log 2
// @log 3
// @log 4
// @log 5
// @log 6
// @log 7
// An exported generic written two steps deep is instanced by a call reading the place, an alias
// of the inner container or the binding a re-pointed root shares, so the checker passes it, as
// it does when an annotation fixes the type (D12302).
export function ia<T>(x: T): T { x }
const ra = { a: { f: ia } }
ra.a.f = ia
print(ra.a.f(1))
export function ib<T>(x: T): T { x }
const inner = { f: ib }
const rb = { a: inner }
rb.a.f = ib
print(inner.f(2))
export function ic<T>(x: T): T { x }
const rc = { a: { f: ic } }
const q = rc.a
rc.a.f = ic
print(q.f(3))
export function idd<T>(x: T): T { x }
function other<T>(x: T): T { x }
let rd = { f: other }
const o = { f: other }
rd = o
rd.f = idd
print(o.f(4))
export function ie<T>(x: T): T { x }
const re = [[ie]]
re[0][0] = ie
print(re[0][0](5))
export function ig<T>(x: T): T { x }
const rg: { a: { f: (x: i32) => i32 } } = { a: { f: ig } }
rg.a.f = ig
print(6)
export function ih<T>(x: T): T { x }
const rh: ((x: i32) => i32)[][] = [[ih]]
rh[0][0] = ih
print(7)
