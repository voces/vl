// @run
// @log 1
// @log 4
// @log s
// @log 4
// A record literal returned from a function whose inferred result is a declared twin of it (a
// nullable record field beside a non-null one), cell `generic`: built at the result's row and rep,
// or, where a nested literal sits at another rep, a named miss (return coercion).
type J = { f: i32 }
type K = { j: J | null }
function mk<T>(x: T) {
  print(x)
  return { j: { f: 4 } }
}
const y = mk(1)
print(y.j.f)
const z = mk("s")
print(z.j.f)
