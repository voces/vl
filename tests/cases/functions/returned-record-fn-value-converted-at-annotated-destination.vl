// @run
// A function called twice returns a fresh record holding one generic function: the call into a
// binding of a closed closure type is copied there with its field coerced, and the other call
// keeps the set's id, which dispatches at its own signature (D17764).
function id(a) { return a }
function deliver() { return { f: id } }
const v: { f: (a: f64) => f64 } = deliver()
const u = deliver()
print(v.f(2.5) + u.f(2))
function deliver2() { return { f: id } }
const g = deliver2().f
print(g(2))
print(g(2.5))
const w: { f: (a: f64) => f64 } = deliver2()
print(w.f(1.5))
function pick(k: i32) {
  if k > 0 { return { f: id } }
  return { f: id }
}
const p: { f: (a: f64) => f64 } = pick(1)
const q = pick(0)
print(p.f(2.5) + q.f(2))
// @log 4.5
// @log 2
// @log 2.5
// @log 1.5
// @log 4.5
