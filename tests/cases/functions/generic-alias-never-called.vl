// @run
// @log 1
// @log 2
// @hint Intentionally-unused variable `_f` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_f2` (leading `_` marks it unused)
// A generic (un-annotated-param) named function aliased to a binding that is never read, inside
// a body and at module scope: nothing calls the value, so the function is built as no body and
// `s + "!"` is never asked to build over the i32 default (D6830).
function exclaim(s) { return s + "!" }

function go() {
  const _f = exclaim
  return 1
}

print(go())
const _f2 = exclaim
print(2)
