// @log T
// @log 2
// A literal argument is graded by its own value, so it fits a literal-union parameter it is a
// member of, at the binding's declaration or above it (D3960).
function inner<U>(u: U) { print(u) }
function cLit(n: 1 | 2) { print("T"); print(n) }
function useK() { k(2) }
let k = inner
k = cLit
k(1)
useK()
