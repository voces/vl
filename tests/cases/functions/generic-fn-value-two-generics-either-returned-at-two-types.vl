// @run
// @log dup
// @log 3
// @log dup
// @log x
// @log 3
// @log x
// @log 3
// @log x
// Two different generics handed to two parameters of one type parameter, either returned and the
// result called at two types: the result holds the union of their sets, in either order (D15465).
function id<T>(x: T): T { x }
function dup<T>(x: T): T {
  print("dup")
  x
}
function pick<F>(a: F, c: F, k: boolean): F {
  if k { return a }
  c
}
const h = pick(id, dup, false)
print(h(3))
print(h("x"))
const g = pick(dup, id, false)
print(g(3))
print(g("x"))
const e = pick(id, dup, true)
print(e(3))
print(e("x"))
