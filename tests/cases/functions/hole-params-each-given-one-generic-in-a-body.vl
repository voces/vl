// @log s
// Two hole parameters of one function, each handed one generic by name from inside another
// function's body, are each that function (D6705).
function id(a) { return a }
function app(g, h) { print(g(1) + 1); return h("s") }
function use(n) { print(n); return app(id, id) }
print(use(1))
print(use(2))
