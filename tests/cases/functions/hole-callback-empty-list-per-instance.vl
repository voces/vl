// @run
// @log 9
// @log 9
// @log 9
// @log 9
// @log 12
// An empty list handed to an un-annotated callback is built, in each instance of the
// function, at the parameter type that instance's callback reads it as.
function ef(a: i32, b: f64[]) { return a + b.length }
function es(a: i32, b: string[]) { return a * 2 + b.length }
function ei(a: i32, b: i32[]) { return a * 2 + b.length }
function empty(h) { return h(3, []) }
print(empty(ef) + empty(es))
print(empty(ef) + empty(ei))
type RF = { ys: f64[] }
type RS = { ys: string[] }
function rf(a: i32, b: RF) { return a + b.ys.length }
function rs(a: i32, b: RS) { return a * 2 + b.ys.length }
function inRec(h) { return h(3, { ys: [] }) }
print(inRec(rf) + inRec(rs))
const lf = (a: i32, b: f64[]) => a + b.length
const ls = (a: i32, b: string[]) => a * 2 + b.length
print(empty(lf) + empty(ls))
function pf(a: i32, b: f64[]) {
  b.push(1.5)
  return a + b.length
}
function ps(a: i32, b: string[]) {
  b.push("x")
  return a * 2 + b.length + b[0].length
}
print(empty(pf) + empty(ps))
