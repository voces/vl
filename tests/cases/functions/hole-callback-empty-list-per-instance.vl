// @log 11
// @log 13
// @log 12
// An empty list, or a list of empty lists, handed to an un-annotated callback is built, in each
// instance of the function, at the parameter type that instance's callback reads it as.
function ef(a: i32, b: f64[]) { a + b.length }
function es(a: i32, b: string[]) { a * 2 + b.length }
function ei(a: i32, b: i32[]) { a * 2 + b.length }
function empty(h) { return h(3, []) }
print(empty(ef) + empty(es))
print(empty(ef) + empty(ei))
type RF = { ys: f64[] }
type RS = { ys: string[] }
function rf(a: i32, b: RF) { a + b.ys.length }
function rs(a: i32, b: RS) { a * 2 + b.ys.length }
function inRec(h) { return h(3, { ys: [] }) }
print(inRec(rf) + inRec(rs))
const lf = (a: i32, b: f64[]) => a + b.length
const ls = (a: i32, b: string[]) => a * 2 + b.length
print(empty(lf) + empty(ls))
function pf(a: i32, b: f64[]) {
  b.push(1.5)
  a + b.length
}
function ps(a: i32, b: string[]) {
  b.push("x")
  a * 2 + b.length + b[0].length
}
print(empty(pf) + empty(ps))
function nf(a: i32, b: f64[][]) { a + b.length }
function ns(a: i32, b: string[][]) { a * 2 + b.length }
function nested(h) { return h(3, [[]]) }
print(nested(nf) + nested(ns))
function nested2(h) { return h(3, [[], []]) }
print(nested2(nf) + nested2(ns))
function df(a: i32, b: f64[][][]) { a + b.length + b[0].length }
function ds(a: i32, b: string[][][]) { a * 2 + b.length }
function deep(h) { return h(3, [[[]]]) }
print(deep(df) + deep(ds))
