// @run
// @log 9
// @log 115
// @log 157
// @log 11
// @log 12
// @log 319
// @log -99
// @log 213
// @log 10
// @log ab
// A direct call with named arguments binds them to its parameters (a positional one at its written
// index, a missing one at its default, a UFCS receiver at slot 0), as `emitDirectCall` does. Each
// position is its own function, and module scope repeats them.

function sub(a: i32, b: i32) { return a - b }
function dflt(a: i32, b: i32 = 1, c: i32 = 2) { return a * 100 + b * 10 + c }
function scale(self: i32, by: i32, plus: i32) { return self * by + plus }
function pair<T>(x: T, y: T) { return [x, y] }

function swapped() { print(sub(b: 1, a: 10)) }
swapped()

function defaulted() {
  print(dflt(1, c: 5))
  print(dflt(a: 1, b: 5, 7))
}
defaulted()

function ufcs() { print((5).scale(plus: 1, by: 2)) }
ufcs()

function generic() {
  const p = pair(y: 2, x: 1)
  print(p[0] * 10 + p[1])
}
generic()

function bound() {
  const r = dflt(c: 9, a: 3)
  print(r)
}
bound()

print(sub(b: 100, a: 1))
print(dflt(2, c: 3))
print((3).scale(by: 3, plus: 1))
const q = pair(y: "b", x: "a")
print(q[0] + q[1])
