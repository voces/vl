// @run
// @log 3
// @log 7
// @log 7
// @log 3
// A concrete function handed to a hole function read out of a list holding two of them, at a
// literal or a computed index, is called at the function's own type (D6795, D6831).
function add(a: i32, b: i32) { return a + b }
function apply2(g) { print(g(1, 2)) }
function apply3(g) { print(g(3, 4)) }
const fs = [apply2, apply3]
fs[0](add)
fs[1](add)
let i = 0
i = i + 1
fs[i](add)
const one = [apply2]
let j = 1
j = j - 1
one[j](add)
