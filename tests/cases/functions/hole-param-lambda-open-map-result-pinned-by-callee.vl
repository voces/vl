// @run
// @log s
// @log 1
// @log 0
// @log 41
// A lambda whose `Map()` result is left open, handed to an un-annotated parameter: the callee
// pins it by writing through the result of calling the parameter, or by handing that result
// to a typed parameter.
type Circle = { r: i32 }
function useM(u: {[string]: i32}) { u.length }
function mu(u: {[string]: i32} | Circle) {
  if u is Circle { return u.r }
  u["a"] = 41
  u["a"] ?? -1
}
function writeS(a) {
  const m = a()
  m["k"] = "s"
  print(m["k"] ?? "-")
}
function writeI(a) {
  const m = a()
  m["k"] = 4
  print(m.length)
}
function hand(a) { print(useM(a())) }
function handU(a) { print(mu(a())) }
writeS(() => Map())
writeI(() => Map())
hand(() => Map())
handU(() => Map())
