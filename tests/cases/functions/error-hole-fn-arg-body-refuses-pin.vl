// @warning Unused parameter `g`
// A declared function handed to an un-annotated parameter is judged at the instance each call
// of that parameter asks for, so a body that cannot take it is refused at the handing call (D6190).
function tos(a) { return "v" + a }
function tosT<T>(a: T) { return "v" + a }
function lap1(g, x) { return g(x) }
function lap2(g, x) { return g(g(x)) }
function lap3(g, h, x) { return h(g(x)) }
const lam = (g, x) => g(x)
let lap = (g, x) => x + 1
lap = (g, x) => g(g(x))
const y = 4
print(lap(tos, 4))
print(lam(tos, 4))
print(lap1(tos, 4))
print(lap1(tos, 4.5))
print(lap1(tos, y))
print(lap1(tosT, 4))
print(lap2(tos, 4))
print(lap3(tos, tos, 4))
