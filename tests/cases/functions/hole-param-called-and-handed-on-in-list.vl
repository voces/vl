// @run
// @log 5
// @log s
// @log 5
// @log s
// @log 5
// @log 6
// @log 10
// @log 5
// @log 7
// @log t
// @log 8
// @log u
// A hole parameter called directly at one type and handed on inside a list literal, or a `const`
// of one, to a callee that calls the element at another takes each type's instance (D15609).
function id(v) { return v }
function dbl(v) { return v + v }
function call1(f, x) { print(f(x)) }
function call0(fs, x) { call1(fs[0], x) }
function callIx(fs, x) { print(fs[0](x)) }
function callTwo(fs, x) { print(fs[1](x)) }
function run(g) {
  call1(g, 5)
  call0([g], "s")
}
run(id)
function runSelf(g) {
  print(g(5))
  callIx([g], "s")
}
runSelf(id)
function runSame(g) {
  call1(g, 5)
  call0([g], 6)
}
runSame(id)
function runDbl(g) {
  print(g(5))
  callIx([g], 2.5)
}
runDbl(dbl)
function runTwo(g) {
  print(g(7))
  callTwo([g, g], "t")
}
runTwo(id)
function runLet(g) {
  print(g(8))
  const fs = [g]
  callIx(fs, "u")
}
runLet(id)
