// @log 4
// A function generic only by its un-annotated parameter, handed to an un-annotated parameter
// called at two types, is instanced at each (D5611). The typed spelling, a delivery through a
// second forwarding hole, and a two-parameter function called at (i32, i32) and (f64, f64).
function same(k) { k }
function take(a) { print(a("x")) }
function take2(a) { print(a(3)) }
function mid(a) {
  take(a)
  take2(a)
}
mid(same)

function midT<F>(a: F) {
  take(a)
  take2(a)
}
midT(same)

function outer(b) { mid(b) }
outer(same)

function add(a, b) { return a + b }
function apply2<G>(g: G) {
  print(g(1, 2))
  print(g(1.5, 2.5))
}
apply2(add)
