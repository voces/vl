// @run
// @log x
// @log 3
// @log x
// @log 3
// @log y
// @log 4
// A generic handed to two parameters of one type parameter, called at two types and one of them
// handed back as the result, is one set's id at both: the hand-back is read across a hand-on and
// past the signature-alternative instances the result's type makes (D6200, D6425).
function same<T>(k: T): T { k }
function take(a) { print(a("x")) }
function take2(a) { print(a(3)) }
function mid<F>(a: F, a1: F): F {
  take(a)
  take2(a1)
  a
}
mid(same, same)
function mid2<F>(a: F, a1: F): F {
  take(a)
  take2(a1)
  a1
}
mid2(same, same)
function take3(a) { print(a("y")) }
function take4(a) { print(a(4)) }
function mid3<F>(a: F, a1: F): F {
  take3(a1)
  take4(a)
  return a1
}
mid3(same, same)
