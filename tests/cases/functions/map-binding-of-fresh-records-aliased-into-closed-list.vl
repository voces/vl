// @run
// A binding of a `.map` building fresh records, aliased into a list that closes a field, is one
// storage at the closed element: both names call it there (D17826).
function id(a) { return a }
function deliver() { return [{ f: id }] }
const m = deliver().map((r) => ({ f: r.f }))
const v: { f: (a: f64) => f64 }[] = m
print(v[0].f(2.5))
print(m[0].f(1.5))
// @log 2.5
// @log 1.5
