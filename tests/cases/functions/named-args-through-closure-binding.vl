// @check
// @error named arguments require a declared function
// A named argument resolves against the declaration the callee's name denotes. Here `g` is
// `tak`'s parameter — a function value, which carries no parameter names — so the call is
// refused whatever the module function of the same name declares. Before D1604 the checker
// read the module `function g`'s parameter list off the flat top-level table, returned rc 0,
// and the emitter refused the same call with `named arguments require a declared function`.
// Renaming the module function's parameter changed whether this program type-checked.
function g(alpha: i32) { print(alpha) }
function tak(g: (i32) => void) { g(alpha: 8) }
tak((n) => { print(n + 1) })
