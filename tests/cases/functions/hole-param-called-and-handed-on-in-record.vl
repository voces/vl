// A hole parameter called directly at one type and handed on as a field of a record literal, to a
// callee that calls the field at another, takes each type's instance (D15638).
function id(v) { return v }
function dbl(v) { return v + v }
function call0(r, x) { print(r.f(x)) }
function callN(r, x) { print(r.f(x) + r.n) }
function call1(f, x) { print(f(x)) }
function callFwd(r, x) { call1(r.f, x) }
function call2(r, x) {
  print(r.f(x))
  print(r.h(x))
}
function run(g) {
  print(g(5))
  call0({ f: g }, "s")
}
run(id)
function runDbl(g) {
  print(g(5))
  call0({ f: g }, 2.5)
}
runDbl(dbl)
function runN(g) {
  print(g(7))
  callN({ f: g, n: 1 }, 2.5)
}
runN(dbl)
function runFwd(g) {
  print(g(8))
  callFwd({ f: g }, "u")
}
runFwd(id)
function runSame(g) {
  print(g(9))
  call0({ f: g }, 10)
}
runSame(id)
function both(g, k) {
  print(g(1))
  print(k(1))
  call2({ f: g, h: k }, 2.5)
}
both(dbl, id)
function twice(g) {
  print(g(1))
  call2({ f: g, h: g }, 2)
}
twice(dbl)
twice(id)
