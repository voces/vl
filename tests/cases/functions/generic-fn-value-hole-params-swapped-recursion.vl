// @info `g` is never reassigned; use `const` instead of `let`
// A recursive function handing its hole parameters back in rotated positions gives each a
// parameter per type its own calls and every forward it reaches call at (D6202).
function same<T>(k: T): T { k }
function mid(a, b, n: i32) {
  print(a("x"))
  print(b(n))
  if n > 0 { mid(b, a, n - 1) }
}
function rot(a, b, c, n: i32) {
  print(a("x"))
  print(b(n))
  print(c(1.5))
  if n > 0 { rot(c, a, b, n - 1) }
}
function typed(a, b, n: i32) {
  const s: string = a("x")
  const m: i32 = b(n)
  print([s][0])
  print(m)
  if n > 0 { typed(b, a, n - 1) }
}
const f = same
let g = same
mid(same, same, 1)
mid(f, g, 0)
rot(same, same, same, 2)
typed(same, same, 1)
