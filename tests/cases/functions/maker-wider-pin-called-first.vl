// @run
// @log 3.5
// @log 5
// @log 3.5
// @log 5
// A maker's two call bindings, the wider pin's called first: each call through a binding is at the
// types its own maker call pinned, generic and un-annotated alike (D16815).
function adder(n) { return (a) => a + n }
function gadder<T>(n: T) { return (a) => a + n }
const x = adder(1.5)
print(x(2.0))
const v = adder(2)
print(v(3))
const gx = gadder(1.5)
print(gx(2.0))
const gv = gadder(2)
print(gv(3))
