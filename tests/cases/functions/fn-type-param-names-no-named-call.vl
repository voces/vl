// @check
// @error-at 11:37 named arguments work only on declared functions, not on a function value
// @error-at 13:6 named arguments work only on declared functions, not on a function value
// @error-at 15:23 cannot assign (string) => i32 to 'bad' of type (fn: i32, rcx: i64) => i32
// Owner ruling A1: the names a function TYPE writes are documentation, so a call through a
// value of that type still binds positionally, and a named argument there is refused with
// the reason rather than resolved against the type's names. A mismatch diagnostic quotes the
// annotation as the author spelled it, names included. The declared function takes names.
type GuestCall = (fn: i32, rcx: i64) => i32
function h(fn: i32, rcx: i64) { fn + (rcx as! i32) }
function w(s: string) { s.length }
function viaParam(hook: GuestCall) { hook(fn: 1, rcx: 2 as i64) }
const g: GuestCall = h
print(g(rcx: 2 as i64, fn: 1))
print(h(rcx: 2 as i64, fn: 1))
const bad: GuestCall = w
viaParam(g)
print(bad(1, 2 as i64))
