// @run
// @log v
// @log none
// @log 1.5
// CONTRACT (D956): the inferred nullable-MAP return works for ANY string-keyed map, not only
// the i32-valued one D937 shipped.
//
// D937 restricted its renderer, its classifier and its return-site seed to `i32` for a stated
// reason: the seed hardcoded the MONO `$mapStruct`, so rendering a name the emitter could not
// then lower would have lifted the checker's floor while leaving the program broken — trading
// a clean refusal for a worse one. That reason expired without anyone noticing: the SIGNATURE
// side already resolves a non-mono shape through `inferredRetMapSlot` (its own comment records
// gaining the `nulmap` arm), so the seed only had to ask the same home instead of assuming.
//
// THE ANNOTATED TWIN RAN THROUGHOUT, which is what makes this a capability gap and not a
// design rule — `: {[string]: string} | null` spelled out lowers and returns `v`.
//
// Both branches, because the null one is where the seed is load-bearing: with the mono shape
// assumed, a `string`-valued map's `return null` reached `emitNullLitNode` with the wrong
// heap type rather than none, which validates in some modules and not others.
function pick(c: boolean) {
  if c { return null }
  const m: {[string]: string} = Map()
  m["k"] = "v"
  m
}

function pickF(c: boolean) {
  if c { return null }
  const m: {[string]: f64} = Map()
  m["k"] = 1.5
  m
}

function show(c: boolean) {
  const r = pick(c)
  if r != null { print((r)["k"]) } else { print("none") }
}

show(false)
show(true)

const g = pickF(false)
if g != null { print((g)["k"]) } else { print(0) }
