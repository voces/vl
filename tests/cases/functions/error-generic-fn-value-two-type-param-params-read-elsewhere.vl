// @emit-error a generic function handed to two parameters of type `F` in a call to `mid` is called at two types, and `F` takes one
// Where the type parameter is also the result type, one binding has to cover both parameters,
// so a generic called at two types through them is refused rather than built at one (D6090,
// D6200). The spelling that runs is `generic-fn-value-two-type-param-params-at-two-types.vl`.
function same<T>(k: T): T { k }
function take(a) { print(a("x")) }
function take2(a) { print(a(3)) }
function mid<F>(a: F, a1: F): F {
  take(a)
  take2(a1)
  a
}
mid(same, same)
