// @emit-error a generic function handed to two parameters of type `F` in a call to `mid` is called at two types, and `F` takes one
// Where the result may be either parameter of the type parameter, one type has to cover both
// parameters, so a generic called at two types through them is refused rather than built at
// one (D6090, D6372). The spellings that run are `generic-fn-value-two-type-param-params-read-elsewhere.vl`,
// `generic-fn-value-two-type-param-params-split-param-returned.vl`,
// `generic-fn-value-two-type-param-params-into-annotated-binding.vl` and
// `generic-fn-value-two-type-param-params-at-two-types.vl`.
function same<T>(k: T): T { k }
function take(a) { print(a("x")) }
function take2(a) { print(a(3)) }
function mid<F>(a: F, a1: F, c: boolean): F {
  take(a)
  take2(a1)
  if c { return a }
  a1
}
mid(same, same, false)
