// A record of a named function and a record of a hole parameter reach one callee, the hole
// handed a different named function at each call: each record keeps its set (D15651).
function dbl(v) { return v + v }
function inc(v) { return v + 1 }
function call0(r, x) { print(r.f(x)) }
function both(g) {
  print(g(1))
  call0({ f: g }, 2.5)
}
const r = { f: dbl }
call0(r, 4)
both(dbl)
both(inc)

function idf(v) { return v }
function tri(v) { return v * 3 }
function call1(r, x) { print(r.f(x)) }
function hand1(g) {
  print(g(1))
  call1({ f: g }, 2.5)
}
call1({ f: idf }, 1.5)
hand1(idf)
hand1(tri)

function sq(v) { return v * v }
function call2(r, x) { print(r.f(x)) }
function hand2(g) { call2({ f: g }, 2) }
hand2(sq)
hand2(cube)
function cube(v) { return v * v * v }
function mk() { return { f: cube } }
call2(mk(), 2)
