// @run
// @log 1
// @log 1
// @log bc
// @log 2
// @log b
// @log 0
// @log a
// @log other
// @log 6
// @log 4
// The initialised twin of `uninit-ref-let-branch-writes.vl`: each `let` carries an
// initializer and is then overwritten in every arm, so its local stays a non-null wasm cell.
type P = { x: i32 }
type A = { kind: "a", x: i32 }
type B = { kind: "b", y: i32 }

function listUnion(c: boolean) {
  let r: i32[] | string[] = [0, 0]
  if (c) { r = [1] } else { r = ["a"] }
  r.length
}
function list(c: boolean) {
  let r = [0, 0, 0]
  if (c) { r = [1] } else { r = [2, 3] }
  r.length
}
function str(c: boolean) {
  let r = "z"
  if (c) { r = "a" } else { r = "bc" }
  r
}
function rec(c: boolean) {
  let r: P = { x: 0 }
  if (c) { r = { x: 1 } } else { r = { x: 2 } }
  r.x
}
function recUnion(c: boolean): string {
  let r: A | B = { kind: "a", x: 0 }
  if (c) { r = { kind: "a", x: 1 } } else { r = { kind: "b", y: 2 } }
  r.kind
}
function map(c: boolean) {
  let r: Map<string, i32> = Map()
  r.set("k", 1)
  if (c) { r = Map() } else { r = Map() }
  r.length
}
function valueUnion(c: boolean): string {
  let r: string | i32 = 0
  if (c) { r = "a" } else { r = 2 }
  if (r is string) { return r }
  "i"
}
function matched(k: i32) {
  let r = "z"
  match (k) {
    1 => {
      r = "one"
    }
    _ => {
      r = "other"
    }
  }
  r
}
function fn(c: boolean): i32 {
  let f: (x: i32) => i32 = (x: i32) => x
  if (c) { f = (x: i32) => x + 1 } else { f = (x: i32) => x * 2 }
  f(3)
}
function captured(c: boolean) {
  let r: i32[] = []
  if (c) { r = [1, 2, 3] } else { r = [4] }
  const g = () => r.length
  g() + 1
}

print(listUnion(true))
print(list(true))
print(str(false))
print(rec(false))
print(recUnion(false))
print(map(true))
print(valueUnion(true))
print(matched(2))
print(fn(false))
print(captured(true))
