// @run
// @log x
// @log 3
// @log x
// @log 3
// @log x
// @log 3
// @log x
// @log 4
// @log x
// @log 3
// @log x
// @log 3
// @log 4
// @log x
// @log 3
// A function parameter called at one type and copied into a binding called at another takes a
// parameter per call type (D6470): a `const` or initialized copy, a write in a branch taken or
// not, a copy handed on through a forward, a lambda argument, and a body reached from a function.
function same<T>(k: T): T { k }
function take2(a) { print(a(3)) }
function fwd(f) { take2(f) }
function viaConst(a) {
  const b = a
  print(a("x"))
  print(b(3))
}
function viaBranch<F>(a: F, a1: F, c: boolean) {
  let b = a1
  if c { b = a }
  print(a("x"))
  print(b(3))
}
function viaResult(a) {
  const b = a
  print(a("x"))
  const r = b(3)
  print(r + 1)
}
function viaForward<F>(a: F, a1: F) {
  let b: F = a1
  b = a
  print(a("x"))
  fwd(b)
}
function viaBoth<F>(a: F, a1: F) {
  let b = a1
  b = a
  print(a("x"))
  print(b(3))
  print(a1(4))
}
function outer(f) { viaConst(f) }
viaConst(same)
viaBranch(same, same, false)
viaBranch(same, same, true)
viaResult((u) => u)
viaForward(same, same)
viaBoth(same, same)
outer(same)
