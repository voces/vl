// @check
// @error-at 20:2 named arguments require a declared function
// @error-at 29:2 named arguments require a declared function
// @error-at 33:4 named arguments require a declared function
// @error-at 41:2 named arguments require a declared function
// @error-at 47:2 named arguments require a declared function
// One answer for every storage class a closure-valued binding has, and for every module
// function the name could collide with: a `const`, a `let`, a parameter captured by an inner
// lambda, a same-named module function whose parameter is spelled differently, and a name no
// module function declares at all. All five are the same program — the callee denotes a value
// with no parameter names — so all five get the same refusal (D1604).
function g(alpha: i32) { print(alpha) }
function h(alpha: i32) { print(alpha) }
function k(alpha: i32) { print(alpha) }
function m(beta: i32) { print(beta) }

function viaConst() {
  const g: (i32) => void = (n) => {
    print(n + 1)
  }
  g(alpha: 8)
}
function viaLet() {
  let h: (i32) => void = (n) => {
    print(n + 1)
  }
  h = (n) => {
    print(n + 2)
  }
  h(alpha: 8)
}
function viaCapture(k: (i32) => void) {
  const inner = () => {
    k(alpha: 8)
  }
  inner()
}
function viaOtherName() {
  const m: (i32) => void = (n) => {
    print(n + 1)
  }
  m(alpha: 8)
}
function viaNoDecl() {
  const q: (i32) => void = (n) => {
    print(n + 1)
  }
  q(alpha: 8)
}
viaConst()
viaLet()
viaCapture((n) => {
  print(n + 1)
})
viaOtherName()
viaNoDecl()
