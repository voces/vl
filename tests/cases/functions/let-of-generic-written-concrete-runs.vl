// @run
// @log I
// @log 7
// @log Q
// @log 8
// @log Q
// @log 9
// @log B
// @log true
// A `let` seeded with a generic and written with a concrete function runs when every call and
// delivery fits that function; a parameter of the same name is another binding (D3960).
function inner<U>(u: U) { print("I"); print(u) }
function q(n: i32) { print("Q"); print(n) }
function b(v: boolean) { print("B"); print(v) }
function ci(f: (n: i32) => void, n: i32) { f(n) }
function h(k: (v: boolean) => void) { k(true) }
function main() {
  let k = inner
  k(7)
  k = q
  k(8)
  ci(k, 9)
  h(b)
}
main()
