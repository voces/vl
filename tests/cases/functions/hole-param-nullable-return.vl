// @run
// @log true
// @log a
// @log true
// @log 5
// @log true
// @log 6
// @log true
// @log true
// @log true
// @log 5
// @log none
// @log x
// @hint redundant type annotation: `x` is inferred as `string | null`
// @hint redundant type annotation: `y` is inferred as `string | null`

// D2605: a nullable niche handed to an un-annotated parameter and returned. The checker types
// the result as the parameter's own type variable and records no inferred return, so the
// instance's result fell to the non-null rep: a null `string` or list trapped, and a map, set
// or closure built invalid wasm.
function hole(v) { v }
function copyHole(v) {
  const w = v
  w
}

function mkS(n: i32): string | null {
  if n == 2 { return null }
  "a"
}
function mkL(n: i32): i32[] | null {
  if n == 2 { return null }
  [4, 5]
}
function mkM(n: i32): {[string]: i32} | null {
  if n == 2 { return null }
  const m: {[string]: i32} = Map()
  m["k"] = 6
  m
}
function mkSet(n: i32): Set<i32> | null {
  if n == 2 { return null }
  const s: Set<i32> = Set()
  s.add(3)
  s
}
function mkF(n: i32): ((i32) => i32) | null {
  if n == 2 { return null }
  (a: i32) => a + 1
}

function go(n: i32) {
  const x: string | null = if n == 2 { null } else { "a" }
  const y: string | null = hole(x)
  print(y == null)
}
go(2)
print(hole(mkS(1)) ?? "none")
print(hole(mkL(2)) == null)
const l = copyHole(mkL(1))
if l != null { print(l[1]) }
print(hole(mkM(2)) == null)
const m = hole(mkM(1))
if m != null { print(m["k"] ?? 0) }
print(hole(mkSet(2)) == null)
const s = hole(mkSet(1))
if s != null { print(s.has(3)) }
print(hole(mkF(2)) == null)
const f = hole(mkF(1))
if f != null { print(f(4)) }
const c = () => {
  const r = copyHole(mkS(2))
  print(r ?? "none")
}
c()
const strs: string[] | null = ["x"]
const hs = hole(strs)
if hs != null { print(hs[0]) }
