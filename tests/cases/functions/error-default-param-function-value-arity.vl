// @check
// @error wrong number of arguments: expected 2, got 1
// Defaults are DIRECT-call-site sugar only. A call through a function VALUE has
// no declaration to read a default from, so it keeps the full-arity gate — which
// is exactly what leaves the closure `$fnsig` signature space out of this
// feature: a function value's signature is the declared one, unconditionally.
function k(a: i32, b: i32 = 2): i32 { a + b }
const kv = k
print(kv(1))
