// @check
// @error cannot infer a return type for '[]@V'
// @error cannot infer a return type for '+@V'
// @error cannot infer a return type for 'rec'
// @error cannot infer a return type for 'ma'
// @error cannot infer a return type for 'mb'
// @error cannot infer a return type for 'viaMap'
// @error cannot infer a return type for 'viaLocal'
// @error cannot infer a return type for 'viaValue'
// @error cannot infer a return type for ''
// @error cannot assign string to 'zz' of type i32
// A base-case-less cycle is a cause of its own whichever way it is reached: an operator, a
// method call, a lambda or a function value. An unrelated error beside it leaves its refusal
// reported (D3771).
type V = { a: i32 }
function "[]"(self: V, i: i32) { return self[i] }
function "+"(self: V, o: V) { return self + o }
const v: V = { a: 1 }
print(v[0])
print(v + v)

function rec(self: i32) { return self.rec() }
print(rec(1))
function ma(self: i32) { return self.mb() }
function mb(self: i32) { return self.ma() }
print(ma(1))

function viaMap(n: i32) { return [1, 2].map((x) => viaMap(x))[0] }
print(viaMap(1))
function viaLocal(n: i32) {
  const h = (k: i32) => viaLocal(k)
  return h(n)
}
print(viaLocal(1))
function viaValue(n: i32) {
  const g = viaValue
  return g(n)
}
print(viaValue(1))

const zz: i32 = "s"
print(zz)
