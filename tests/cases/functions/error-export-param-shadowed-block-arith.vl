// @error exported function `t`: parameter `x` has no type and nothing in the program calls `t`; the host calls it, so its signature must be explicit. The body fits more than one type (i32, i64, f32, f64, …). Annotate it: `export function t(x: f64)`
// @warning `x` shadows the `x` declared
// Without the shadowing block's string use, the parameter's own arithmetic fits every
// numeric type: the refusal names the parameter, not the arithmetic (D3817).
function shout(s: string) { s + "!" }
export function t(x) {
  if true {
    const x = "inner"
    print(shout(x))
  }
  print(x * 2)
}
print(1)
