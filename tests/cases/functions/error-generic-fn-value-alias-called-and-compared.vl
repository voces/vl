// @emit-error Call sites pin `id` at (i32), (string)
// A `const` alias of a hole function, called through and compared, while the function's own
// name is called at another type: the comparison reads the alias as a value, so its binding is
// built as a closure and meets the floor (D7383). This pins the diagnostic's informative branch,
// which names the signatures the program's own calls pin `id` at.
function id(x) { return x }
const k = id
print(k(1))
print(id("s"))
print(k == id)
