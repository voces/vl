// @run
// @log 3
// @log w
// @log 3
// @log 4
// @log 5
// @log 6
// @log v
// @log 3
// @log 7
// A function handed through a hole or generic function's result to a declared function type
// binds that function's instance at the declared type, one per type (rung B's escapes).
function fw(f) { return f }
function gw<F>(f: F): F { return f }
function ap(h: (x: i32) => i32) { return h(3) }
type Box = { h: (x: i32) => i32 }
const lam = (x) => x
const a: (x: i32) => i32 = fw(lam)
const b: (x: string) => string = fw(lam)
print(a(3))
print(b("w"))
print(ap(fw(lam)))
const bx: Box = { h: fw(lam) }
print(bx.h(4))
const xs: ((x: i32) => i32)[] = []
xs.push(fw(lam))
print(xs[0](5))
const c: (x: i32) => i32 = gw(lam)
const d: (x: string) => string = gw(lam)
print(c(6))
print(d("v"))
print(ap(gw(lam)))
function ret(): (x: i32) => i32 { return fw(lam) }
print(ret()(7))
