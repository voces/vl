// @check
// @error-at 31:6 argument 2: expected i32[], got i32 (the call of `g` at the call's argument types)
// @error-at 32:6 argument 1: expected i32[], got i32 (the call of `g` at the call's argument types)
// @error-at 33:6 argument 2: expected i32[], got i32 (the call of `g` at the call's argument types)
// @error-at 34:6 argument 2: expected i32[], got i32 (the call of `g` at the call's argument types)
// @error-at 35:6 argument 2: expected i32[], got i32 (the call of `g` at the call's argument types)
// @error-at 36:6 argument 2: expected i32[], got boolean (the call of `g` at the call's argument types)
// @error-at 37:6 argument 2: expected string[], got string (the call of `g` at the call's argument types)
// @error-at 38:6 argument 2: expected string[], got i32[] (the call of `g` at the call's argument types)
// @error-at 39:6 argument 2: expected i32, got i32[] (the call of `g` at the call's argument types)
// @error-at 40:6 argument 2: expected i32, got P (the call of `g` at the call's argument types)
// @error-at 41:6 argument 2: expected P, got string (the call of `g` at the call's argument types)
// @error-at 42:6 argument 2: expected (i32) => i32, got i32 (the call of `g` at the call's argument types)
// @error-at 43:6 argument 2: expected i32[] | null, got i32 (the call of `g` at the call's argument types)
// D5790: a function handed to an un-annotated parameter and called there with an argument its
// parameter does not take is refused at the call that hands it. A rest parameter is a list in
// the function's type, so a call through the value passes the list, never the spread elements.
type P = { x: i32 }
function rst(a: i32, ...xs: i32[]): i32 { a + xs.length }
function only(...xs: i32[]): i32 { xs.length }
function lst(a: i32, b: i32[]): i32 { a + b.length }
function strs(a: i32, b: string[]): i32 { a + b.length }
function two(a: i32, b: i32): i32 { a + b }
function rec(a: i32, b: P): i32 { a + b.x }
function cb(a: i32, b: (n: i32) => i32): i32 { b(a) }
function opt(a: i32, _b: i32[] | null): i32 { a }
function apply(g, x, y) { return g(x, y) }
function apply1(g, x) { return g(x) }
function lit(g, x) { return g(x, 7) }
const ap = (g, x, y) => g(x, y)
const p: P = { x: 1 }
print(apply(rst, 3, 4))
print(apply1(only, 3))
print(lit(rst, 3))
print(ap(rst, 3, 4))
print(apply(lst, 3, 4))
print(apply(lst, 3, true))
print(apply(strs, 3, "s"))
print(apply(strs, 3, [4]))
print(apply(two, 3, [4]))
print(apply(two, 3, p))
print(apply(rec, 3, "s"))
print(apply(cb, 3, 4))
print(apply(opt, 3, 4))
print(apply(rst, 3, [4, 5]))
print(apply1(only, [1, 2, 3]))
