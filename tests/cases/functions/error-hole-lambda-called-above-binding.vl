// @error cannot assign i32 to 's' of type string
// A module binding of a lambda with an un-annotated parameter, called from a function declared
// above it, is checked against the lambda's body as it is below the binding (D4019).
function useK() {
  const s: string = k(1)
  print(s)
}
const k = (x) => x + 1
useK()
