// @run
// @log 2
// @log b
// @log 2
// @log 4
// @log d
// @log s
// @log t
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// Two un-annotated parameters handed to one type parameter run at every instance that binds
// them alike, one function further out, and beside a union that holds the other (D6482).
function g<T>(_x: T, y: T): T { return y }
function f(a, b) { return g(a, b) }
print(f(1, 2))
print(f("a", "b"))
print(f(1.5, 2))
function o(p, q) { return f(p, q) }
print(o(3, 4))
print(o("c", "d"))
const v: i32 | string = 1
print(f(v, "s"))
function g2<T, U>(_x: T, y: U): U { return y }
function f2(a, b) { return g2(a, b) }
print(f2(1, "t"))
