// @run
// @log fn 8
// @log str
// @log fn 7
// @log 10
// @log -1
// @log 16
// @log 6
// @log yo!
// @log 16
// @hint redundant type annotation: `nfs` is inferred as `(((i32) => i32) | null)[]`
// Owner ruling A1, the union and generic positions: named function types as a union member
// beside a string, as the nullable member of an alias, as generic arguments crossing to an
// alias-spelled pair, and in a closure-returning function. The names never reach identity, so
// the member-set ABI is the unnamed one (`vl_fn_type_param_names_test.ts` holds the bytes).
type F = (x: i32) => i32
type G = (s: string) => string
type NF = F | null
type Pair<A, B> = { a: A, b: B }
function dbl(x: i32) { x * 2 }
function ex(s: string) { s + "!" }
function run(v: ((x: i32) => i32) | string) {
  if v is string { return v }
  "fn \{v(4)}"
}
function runN(v: ((y: i32) => i32) | null) {
  if v == null { return -1 }
  v(5)
}
function mkAdder(n: i32): (x: i32) => i32 {
  const k = n + 1
  (x: i32): i32 => x + k
}
const p: Pair<(x: i32) => i32, (y: string) => string> = { a: dbl, b: ex }
const p2: Pair<F, G> = p
const nfs: NF[] = [dbl, null]
nfs.push(mkAdder(10))
print(run(dbl))
print(run("str"))
print(run(mkAdder(2)))
print(runN(nfs[0]))
print(runN(nfs[1]))
print(runN(nfs[2]))
print(p2.a(3))
print(p2.b("yo"))
function compose(f: (x: i32) => i32, g: (y: i32) => i32): (z: i32) => i32 {
  (v: i32): i32 => g(f(v))
}
print(compose(dbl, mkAdder(1))(7))
