// @run
// @info `b` is never reassigned; use `const` instead of `let`
// @log x
// @log 3
// @log y
// A function parameter copied into a binding that is itself called at two types takes one
// parameter per call type, and the original keeps its own (D6470, D6530).
function same<T>(k: T): T { k }
function mid(a) {
  let b = a
  print(a("x"))
  print(b(3))
  print(b("y"))
}
mid(same)
