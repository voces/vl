// @error `g` returns i32, but a block body returns a value only through `return`: write `return` before its last expression
// @error this lambda is expected to return a value, but a block body returns one only through `return`: write `return` before its last expression
// @error `void[]` stores `void`, which has no value
// A block body whose function returns a value, by its annotation or by what its context expects
// of a lambda (a `map` callback included), must reach that value through `return`.
function g(n: i32): i32 {
  const y = n + 2
  y * 3
}
const xs = [1, 2].map((x) => {
  const z = x + 1
  z * 10
})
print(g(1) + xs.length)
