// @log 3
// A generic handed to two parameters of one type parameter, called at two types, runs when that
// type parameter is also the result type: each parameter read only as a call argument takes a
// type parameter of its own (D6200). Also in either call order, at three parameters, with the
// result called, twice, and inside a function.
function same<T>(k: T): T { k }
function take(a) { print(a("x")) }
function take2(a) { print(a(3)) }
function take3(a) { print(a(true)) }
function mid<F>(a: F, a1: F): F {
  take(a)
  take2(a1)
  a
}
mid(same, same)
function mid2<F>(a: F, a1: F): F {
  take2(a1)
  take(a)
  a
}
mid2(same, same)
function mid3<F>(a: F, a1: F, a2: F): F {
  take(a)
  take2(a1)
  take3(a2)
  a
}
mid3(same, same, same)
function mid4<F>(a: F, a1: F): F {
  take(a)
  take2(a1)
  a
}
const r = mid4(same, same)
print(r("y"))
function mid5<F>(a: F, a1: F): F {
  take(a)
  take2(a1)
  return a
}
mid5(same, same)
mid5(same, same)
function mid6<F>(a: F, a1: F): F {
  take(a)
  take2(a1)
  a
}
function main() { mid6(same, same) }
main()
