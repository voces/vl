// @run
// @log 5
// @log s
// @log 7
// @log 6
// @log t
// @log 3
// @log uu
// A list element read handed on to a hole function that a direct call already instanced at another
// type delivers the element the literal holds, not the function's first instance (D15611).
function id(v) { return v }
function dbl(v) { return v + v }
function call1(f, x) { print(f(x)) }
function call0(fs, x) { call1(fs[0], x) }
call1(id, 5)
call0([id], "s")
call0([id], 7)
function callAt(fs, i, x) { call1(fs[i], x) }
function viaConst(fs, x) {
  const g = fs[0]
  call1(g, x)
}
call1(id, 6)
viaConst([id], "t")
callAt([id, dbl], 0, 3)
callAt([id, dbl], 1, "u")
