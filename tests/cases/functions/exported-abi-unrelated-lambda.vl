// @run
// @log 2
// @log 4
// @hint redundant type annotation: `f` is inferred as `i32`
// THE CELL THAT REFUTES THE NARROW FRAMING of #1265. `f` is exported and is NEVER taken as
// a function value — the only function value in the file is `h`, an unrelated lambda that
// `f` does not mention. `f`'s export was leaked all the same.
//
// The env param is not a property of the function; `fnValUsed` is a WHOLE-MODULE flag, so
// one lambda anywhere gives every function in the module the hidden `structref`. The defect
// was filed as "an exported AND value-referenced function leaks a structref env param",
// which describes half the set: the trigger is a function value existing ANYWHERE, and a
// bare `xs.map(...)` is enough to flip it (measured — an exported `f` in a file whose only
// function value is a `.map` callback published `(structref, i32) -> i32` too).
//
// So the wrapper is emitted per EXPORT ENTRY under `fnValUsed`, not per value-referenced
// function: asking whether THIS function is used as a value would have missed this file,
// and every file shaped like it.
export function f(a: i32): i32 { return a + 1 }

const h = (x: i32) => x * 2

print(f(1))
print(h(2))
