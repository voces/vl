// @run
// @hint Intentionally-unused parameter `_a` (leading `_` marks it unused)
// @log x
// @log 4
// @log x
// @log 4
// @log x
// @log 4
// @log x
// @log 4
// @log 3
// @log y
// @log 3
// @log y
// @log x!
// @log 4
// @log x!
// @log 4
// A hole bound to a generic is read at each call's own argument types, so a second call of the
// same function re-checks the body at its own instance, not the first call's (D6521). Two
// different generics, nested calls, a two-parameter generic and `const`-bound results.
function same<T>(k: T): T { k }
function other<T>(k: T): T { k }
function viaResult(a) {
  print(a("x"))
  print(a(3) + 1)
}
viaResult(same)
viaResult(same)
viaResult(other)

function nested(a) {
  print(a("x"))
  print(a(a(3)) + 1)
}
nested(same)

function pick<A, B>(_a: A, b: B): B { b }
function via(f) {
  print(f("x", 2) + 1)
  print(f(3, "y"))
}
via(pick)
via(pick)

function bound(a) {
  const s = a("x")
  const n = a(3)
  print(s + "!")
  print(n + 1)
}
bound(same)
bound(same)
