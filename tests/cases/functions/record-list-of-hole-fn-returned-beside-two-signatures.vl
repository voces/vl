// @run
// @log 7
// @hint redundant type annotation: `twoSigs` is inferred as `f64`
// @hint redundant type annotation: `n` is inferred as `i32`
// A returned list of records of an un-annotated function, beside another list of it called at
// two signatures: the returned literal holds the set's ids, as every other holder does (D15900).
function id(a) { return a }
const xs = [{ f: id }]
function twoSigs(k: i32): f64 {
  const n: i32 = xs[k].f(2)
  return n + xs[k].f(2.5)
}
function make() { return [{ f: id }] }
const v = make()
print(twoSigs(0) + v[0].f(2.5))
