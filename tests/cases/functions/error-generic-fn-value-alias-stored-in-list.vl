// @emit-error Call sites pin `id` at (i32), (string)
// A `const` alias of a hole function, called through and stored in a list, while the function's
// own name is called at another type: the list holds the alias as a value, so its binding is
// built as a closure and meets the floor, whose message names the signatures the calls pin.
function id(x) { return x }
const k = id
print(k(1))
print(id("s"))
const ks = [k]
print(ks.length)
