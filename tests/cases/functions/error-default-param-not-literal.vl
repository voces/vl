// @check
// @error a default value must be a literal, a module-level `const`, or `__callsite__`
// A default that is a CALL — or any other form outside v1's three — is rejected
// because it would have to be EVALUATED, and the only place that could happen is
// the caller's frame, where the callee's names do not exist. The three admitted
// forms each dodge that: a literal has no names, a module `const` is one name
// resolved at the declaration and read through its global, and `__callsite__` is
// not an expression at all.
function side(): i32 { 3 }
function f(a: i32, b: i32 = side()): i32 { a + b }
print(f(1))
