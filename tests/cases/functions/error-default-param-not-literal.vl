// @check
// @error a default value must be a literal
// A default that is a CALL — or any other non-literal — is rejected for the
// same reason a parameter reference is: a literal is the only form with no free
// names, and therefore the only form that means the same thing at every call
// site it is substituted into.
function side(): i32 { 3 }
function f(a: i32, b: i32 = side()): i32 { a + b }
print(f(1))
