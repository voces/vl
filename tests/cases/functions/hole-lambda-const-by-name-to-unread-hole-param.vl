// @run
// @log 4
// @log 4
// @log 8
// @log 4
// @log -2.5
// @log 4
// @warning Unused parameter `g`
// @info `k` is never reassigned; use `const` instead of `let`
// @hint redundant type annotation
// A `const` or `let` lambda handed by name to a hole parameter the callee never reads needs no
// type for its parameter: nothing calls it there, as for the lambda literal (D6112).
function apply(h, x: i32, g) { return h(x) }
function inc(n: i32): i32 { return n + 1 }
function show(v: i32) { print(v) }
const f = (n) => 0 - n
print(apply(inc, 3, f))

// The result delivered to a binding, and to an annotated parameter.
const r = apply(inc, 3, f)
show(r)
show(apply(inc, 7, f))

// A `let` binding.
let k = (n) => 0 - n
print(apply(inc, 3, k))

// The lambda also called elsewhere, at another type.
const m = (n) => 0 - n
print(m(2.5))
print(apply(inc, 3, m))
