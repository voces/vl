// @run
// @log 2
// @log true
// @log true
// @log 2
// A call through a re-pointed generic `let` runs the function its most recent write stored, so
// only that function is instanced at the call's argument types (D15956).
function inner<U>(u: U) { print(u) }
function plus<V>(v: V) { print(v + 1) }
function main() {
  let k = plus
  k(1)
  k = inner
  k(true)
}
main()
function swapped() {
  let j = inner
  j(true)
  j = plus
  j(1)
}
swapped()
