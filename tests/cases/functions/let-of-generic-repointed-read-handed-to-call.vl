// @run
// @log true
// @log 5
// @log true
// @log 7
// @log true
// @log 2
// A read of a re-pointed generic `let` handed to a call is the function its most recent write
// stored when the parameter is a closed function type, as a call through it is (D16182, beside
// D15956). An open parameter is bound at the binding's whole set, one slot per type it is called at.
function inner<U>(u: U) { print(u) }
function plus<V>(v: V) { print(v + 1) }
function apply(f: (b: boolean) => void) { f(true) }
function applyI(f: (b: i32) => void) { f(4) }

// The filed witness: a closed function-typed parameter holds the one function the read names.
function witness() {
  let k = plus
  k = inner
  apply(k)
}
witness()

// Each read takes the write before it, at the callee each reaches.
function each() {
  let k = plus
  applyI(k)
  k = inner
  apply(k)
  k(7)
}
each()

// A write after the handed read re-points the later calls.
function after() {
  let k = plus
  k = inner
  apply(k)
  k = plus
  k(1)
}
after()
