// @run
// Beside the refused two-signature read of one returned function value: each read alone, both at
// one signature, and a list of bare functions (each element its own value) run.
function id(a) { return a }
function deliverR() { return [{ f: id }] }
const v: { f: (a: f64) => f64 }[] = deliverR()
print(v[0].f(2.5))
function deliverS() { return [{ f: id }] }
const u = deliverS()
print(u[0].f(2))
function deliverT() { return [{ f: id }] }
const p: { f: (a: i32) => i32 }[] = deliverT()
const q = deliverT()
print(p[0].f(3) + q[0].f(2))
function deliverL() { return [id] }
const w: ((a: f64) => f64)[] = deliverL()
const z = deliverL()
print(w[0](2.5) + z[0](2))
// @log 2.5
// @log 2
// @log 5
// @log 4.5
