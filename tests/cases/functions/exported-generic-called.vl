// @run
// @log 1
// @log s
// The CALLED twin of `error-exported-generic-uncalled.vl`. An exported `<T>` generic with
// at least one in-module call site is instantiated, and instance 0 REPLACES the template's
// slot under the bare name — so the export section resolves to a real typed function
// (`(i32) -> i32` here) instead of the `() -> void` stub the uncalled case used to publish.
//
// The second call at `string` becomes `id$1`, a separate private function: an exported
// generic's ABI entry is the FIRST instantiation's shape. That is a narrowing worth knowing
// about, but it is a real typed export, not a wrong one, and it is master's behavior — this
// case exists so the exported-uncalled REJECT cannot creep into it.
export function id<T>(x: T): T { return x }

print(id(1))
print(id("s"))
