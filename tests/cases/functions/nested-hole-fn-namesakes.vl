// D13281: un-annotated nested functions of one name in different functions, blocks or methods
// each take their own parameter holes, called directly, through an alias, out of a labelled
// block, as a return value, and beside a top-level namesake.
function inner(s) { return s + 1 }
function top() {
  function inner(s) { return s + "!" }
  print(inner("a"))
}
print(inner(10))
top()

function blocks(c: boolean) {
  if c {
    function inner(s) { return s + 1 }
    print(inner(10))
  } else {
    function inner(s) { return s + "!" }
    print(inner("a"))
  }
}
blocks(true)
blocks(false)

function both() {
  function inner(s) { return s + s }
  print(inner(10))
  print(inner("a"))
}
both()

function aliasNum() {
  function inner(s) { return s + 1 }
  const x = inner
  print(x(10))
}
function aliasStr() {
  function inner(s) { return s + "!" }
  const x = inner
  print(x("a"))
}
aliasNum()
aliasStr()

function labNum() {
  const x = @B {
    function inner(s) { return s + 1 }
    break @B inner
  }
  print(x(10))
}
function labStr() {
  const x = @B {
    function inner(s) { return s + "!" }
    break @B inner
  }
  print(x("a"))
}
labNum()
labStr()

type P = { n: i32 }
function a(self: P) {
  function inner(s) { return s + 1 }
  return inner(self.n)
}
function b(self: P) {
  function inner(s) { return s + "!" }
  if self.n > 9 { return inner("y") }
  return inner("x")
}
const p: P = { n: 4 }
print(p.a())
print(p.b())

function retNum() {
  function inner(s) { return s * 2 }
  return inner(10)
}
function retStr() {
  function inner(s) { return s + "?" }
  return inner("b")
}
const rn = retNum()
const rs = retStr()
print(rn)
print(rs)

function twoNum() {
  function inner2(a, s) { return a + s }
  print(inner2(1, 10))
}
function twoStr() {
  function inner2(a, s) { return a + s }
  print(inner2("p", "q"))
}
twoNum()
twoStr()

type R = { len: i32 }
function memRec() {
  function inner3(s) { return s.len }
  const r: R = { len: 3 }
  print(inner3(r))
}
function memStr() {
  function inner3(s) { return s.length }
  print(inner3("abcd"))
}
memRec()
memStr()
