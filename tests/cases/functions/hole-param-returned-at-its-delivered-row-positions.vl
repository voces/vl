// @run
// @hint Intentionally-unused variable `_dA` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_h` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_h` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_h` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_h` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_h` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_h` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_h` (leading `_` marks it unused)
// @log true
// @log true
// @log true
// @log true
// @log true
// @log true
// @log true
// A function returning its hole parameter, which its caller holds at another record's row, returns
// it at that row: read at the call, bound, held in a record field, through an `if` join, and a
// capturing lambda bound or held in a field, and a closure held in a field whose call is bound
// (D17682). The same call read directly waits on D17682.
type J = { f: i32 | null }
function mk2() { return { f: null } }
const _dA: J = mk2()
function top(y) { return y }
function topJoin(y, c: boolean) {
  if c { return y }
  return y
}
function direct(y) {
  const _h = { w: y }
  return top(y).f == null
}
function bound(y) {
  const _h = { w: y }
  const r = top(y)
  return r.f == null
}
function field(y) {
  const _h = { w: y }
  const o = { v: top(y) }
  return o.v.f == null
}
function joined(y) {
  const _h = { w: y }
  return topJoin(y, [1].length > 0).f == null
}
function lamBound(y) {
  const b = () => y
  const _h = { w: y }
  const r = b()
  return r.f == null
}
function lamField(y) {
  const b = () => y
  const _h = { w: y }
  const o = { v: b() }
  return o.v.f == null
}
function fieldClosureBound(y) {
  const _h = { w: y }
  const o = { b: () => y }
  const r = o.b()
  return r.f == null
}
print(direct(mk2()))
print(bound(mk2()))
print(field(mk2()))
print(joined(mk2()))
print(lamBound(mk2()))
print(lamField(mk2()))
print(fieldClosureBound(mk2()))
