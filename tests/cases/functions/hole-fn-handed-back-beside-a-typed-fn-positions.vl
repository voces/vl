// @run
// @log 4
// @log hi!
// @log 5
// @log a!
// @log 6
// @log b!
// @log c!
// @log 7
// @log d!
// @log 14
// A hole function and a typed one handed back by makers, each call's result its own: through a
// record, bare, by a generic, by two makers, bound then called, and an uncalled handing beside a
// called one (D17721).
function inc0(a) { return a + 1 }
function ex(s: string) { return s + "!" }
function dbl(s: i32) { return s * 2 }
function mkRec(f) { return { f: f } }
function mkBare(f) { return f }
function mkOther(g) { return g }
function id<T>(x: T): T { return x }
print(mkRec(inc0).f(3))
print(mkRec(ex).f("hi"))
print(mkBare(inc0)(4))
print(mkBare(ex)("a"))
print(id(inc0)(5))
print(id(ex)("b"))
print(mkOther(ex)("c"))
const p = mkBare(inc0)
const q = mkBare(ex)
print(p(6))
print(q("d"))
const _u = mkOther(inc0)
const w = mkOther(dbl)
print(w(7))
