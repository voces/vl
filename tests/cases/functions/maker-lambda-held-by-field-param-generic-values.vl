// @run
// @log 0.5
// @log 0.5
// @log 0.5
// @log 0.5
// @log 0.5
// @log 0.5
// @log 0.5
// @log 0.5
// @log none
// A maker's hole lambda stored where a function type returning `f64` holds it returns `f64` at
// every read of that holder: a record field's list or map (D16774), a list or map handed in as a
// parameter (D16775), a read through a generic function (D16776) and through `.values()`
// (D16777).
function deliver() { return (a) => a + 1 }
type R = { xs: ((a: i32) => f64)[], m: { [string]: (a: i32) => f64 } }
const r: R = { xs: [], m: Map() }
r.xs.push(deliver())
print(r.xs[0](3) / 8.0)
r.m["k"] = deliver()
const rv = r.m["k"]
if rv != null { print(rv(3) / 8.0) }
function put(xs: ((a: i32) => f64)[]) { xs.push(deliver()) }
const ys: ((a: i32) => f64)[] = []
put(ys)
print(ys[0](3) / 8.0)
function store(m: { [string]: (a: i32) => f64 }) { m["k"] = deliver() }
const pm: { [string]: (a: i32) => f64 } = Map()
store(pm)
const pv = pm["k"]
if pv != null { print(pv(3) / 8.0) }
function first<V>(xs: V[]): V { return xs[0] }
const zs: ((a: i32) => f64)[] = []
zs.push(deliver())
print(first(zs)(3) / 8.0)
function getOr<V>(m: { [string]: V }, k: string): V | null { return m[k] }
const gm: { [string]: (a: i32) => f64 } = Map()
gm["k"] = deliver()
const gf = getOr(gm, "k")
if gf != null { print(gf(3) / 8.0) }
const vm: { [string]: (a: i32) => f64 } = Map()
vm["k"] = deliver()
print(vm.values()[0](3) / 8.0)
for f in vm.values() { print(f(3) / 8.0) }
const gz = getOr(gm, "z")
if gz == null { print("none") }
