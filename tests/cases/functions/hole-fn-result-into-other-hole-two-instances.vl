// @run
// @log 2
// @log 2
// @log 2
// @log 1
// @log 2
// @log 4
// @log 2
// @log s
// @log 2
// @log 2
// @log 2
// @log 2
// @log 2
// @log 2
// @log 4
// @log 4
// @log 4
// @log 3
// @log 3
// @log 3
// @log 2
// @log 2
// @log 2
// @log 2
// @info `y` is never reassigned
// A hole parameter called on another hole parameter's result and on a plain value is emitted
// once per instance, whichever spelling holds the result (D6250).
function wrap(a) { return [a] }
function pair(a) { return [a, a] }
function two(a) { return [[a]] }
function three(a) { return [a, a, a] }
function pair2(a, b) { return [a, b] }
function lap(g, h, x) {
  print(h(g(x)).length)
  print(h(x).length)
  return 0
}
function lapBack(g, h, x) {
  print(h(g(x)).length)
  print(g(h(x)).length)
  return 0
}
function lapConst(g, h, x) {
  const y = g(x)
  print(h(y).length)
  print(h(x)[1])
  return 0
}
function lapStr(g, h, x) {
  print(h(x).length)
  print(h(g(x))[0][0])
  return 0
}
function lapAnnot(g, h, x) {
  const r: i32[][] = h(g(x))
  print(r.length)
  print(h(x).length)
  return 0
}
function lapDeep(g, h, x) {
  print(h(g(g(x))).length)
  print(h(x).length)
  return 0
}
function lapSum(g, h, x) { return h(g(x)).length + h(x).length }
function lapKeys(g, h, x) {
  print(h(g(x))[0][0][0])
  print(h(h(x))[0][0])
  return 0
}
function lap3(g, h, k, x) {
  print(k(h(g(x))).length)
  print(k(x).length)
  print(k(g(x)).length)
  return 0
}
function lapPair(g, h, x) {
  print(h(g(x), g(x)).length)
  print(h(x, x).length)
  return 0
}
function lapLet(g, h, x) {
  let y = h(g(x))
  print(y.length)
  print(h(x).length)
  return 0
}
lap(wrap, pair, 4)
lapBack(wrap, pair, 4)
lapConst(wrap, pair, 4)
lapStr(wrap, pair, "s")
lapAnnot(wrap, pair, 4)
lapDeep(wrap, pair, 4)
lap(wrap, pair, true)
print(lapSum(wrap, pair, 4))
lapKeys(two, pair, 4)
lap3(wrap, pair, three, 4)
lapPair(wrap, pair2, 4)
lapLet(wrap, pair, 4)
