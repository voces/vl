// @run
// @log 1
// @log 1
// @hint redundant type annotation: `xs` is inferred as `i32[]`
// D2165's control. A receiver only READ through `self` takes the same read-only converting
// copy the argument spelling takes, so both spellings run and agree.
function rd(self: f64[]) { return self[0] }
const xs: i32[] = [1, 2]
print(xs.rd())
print(rd(xs))
