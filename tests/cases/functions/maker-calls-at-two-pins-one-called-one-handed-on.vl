// @run
// @log 5
// @log 2.75
// @log 5
// @log 2.75
// @log 2.75
// @log 5
// Two calls of a maker at two pins, one called directly or at an annotated parameter and one handed
// to an un-annotated parameter, are each built at their own binding's type (D16852).
function adder(n) { return (a) => a + n }
function take(a: (a: i32) => i32) { print(a(3)) }
function half(a) { print(a(0.5)) }
const x = adder(2)
print(x(3))
const z = adder(2.25)
half(z)
const x2 = adder(2)
take(x2)
const z2 = adder(2.25)
half(z2)
const z3 = adder(2.25)
half(z3)
const x3 = adder(2)
print(x3(3))
