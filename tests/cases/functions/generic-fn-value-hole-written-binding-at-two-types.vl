// @log 3
// @log o
// @log x
// @log o
// @log 3
// @log o
// @log x
// @log o
// @log 3
// A written binding of generics handed to an un-annotated parameter called at two types holds
// one slot per type, every write filling each (D5611, D3975), and the call hands each slot once.
// A binding rewritten to a second generic, the typed spelling, and the calls made in the body.
function same<T>(k: T): T { k }
function other<T>(k: T): T {
  print("o")
  k
}
function take(a) { print(a("x")) }
function take2(a) { print(a(3)) }
function mid(a) {
  take(a)
  take2(a)
}
let h = same
h = same
mid(h)

let g = same
g = other
mid(g)

function midT<F>(a: F) {
  print(a("x"))
  print(a(3))
}
let j = same
j = other
midT(j)
