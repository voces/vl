// @trap :12:1
// A hole function called through a list at an out-of-range computed index with a generic traps
// on the read, before the call runs (D7182).
function add(a, b) { return a + b }
function apply2(g) {
  print(g(1, 2))
  print(g(1.5, 2.5))
}
const fs = [apply2]
const i = fs.length
print("before")
fs[i](add)
print("after")
