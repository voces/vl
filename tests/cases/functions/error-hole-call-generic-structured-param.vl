// @check
// @error argument 1: expected T[], got string (the call of `a` at the call's argument types)
// @error argument 1: expected T[], got {y: i32} (the call of `a` at the call's argument types)
// @error argument 1: expected T[], got {[string]: i32} (the call of `a` at the call's argument types)
// @error argument 1: expected {x: T}, got string (the call of `a` at the call's argument types)
// @error argument 1: expected (T) => U, got i32 (the call of `a` at the call's argument types)
// @error argument 2: expected i32, got string (the call of `a` at the call's argument types)
// @error argument 1: expected {[string]: V}, got string (the call of `a` at the call's argument types)
// @error argument 2: expected i32[], got string[] (the call of `a` at the call's argument types)
// @error argument 1: expected T[], got i32 (the call of `a` at the call's argument types)
// A declared generic handed to a hole is checked at each call's own arguments, so a call
// its structured parameter cannot take refuses as the direct call does (D6540).
function first<T>(k: T[]): T { k[0] }
function getx<T>(r: {x: T}): T { r.x }
function app<T, U>(f: (T) => U, v: T): U { f(v) }
function size<V>(m: Map<string, V>): i32 { m.length }
function pair<T>(x: T, _k: T[]): T { x }
function viaStr(a) { print(a("x")) }
function viaRec(a) { print(a({ y: 5 })) }
function viaMap(a) {
  const m: Map<string, i32> = Map()
  print(a(m))
}
function viaApp(a) { print(a(3, 2)) }
function viaCross(a) { print(a((n: i32) => n + 1, "s")) }
function viaPair(a) { print(a(1, ["s"])) }
function viaSecond(a) {
  print(a([1]))
  print(a(3))
}
viaStr(first)
viaRec(first)
viaMap(first)
viaStr(getx)
viaApp(app)
viaCross(app)
viaStr(size)
viaPair(pair)
viaSecond(first)
