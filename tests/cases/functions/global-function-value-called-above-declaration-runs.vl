// @run
// @log 1
// @log s
// @log true
// @log 6
// @log 42
// @log 5
// @log t
// Module bindings of a generic function, an annotated lambda, an un-annotated function and an
// un-annotated lambda, each called from a function declared above the binding (D3899).
function id<T>(x: T) { x }
function inc(x) { x + 1 }
function useK() {
  print(k(1))
  print(k("s"))
  print(k(true))
  print(j(5))
  print(m(41))
  print(h(5))
  print(h("t"))
}
const k = id
const j = (x: i32) => x + 1
const m = inc
const h = (x) => x
useK()
