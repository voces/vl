// @run
// @log 5
// @log 4
// @log 4
// @log 5
// @log 8
// A returned bundle bound at one member's annotated type, beside a holder of the same call called
// at the other member, runs in either order (D15860).
function lap(f) {
  f(2.5)
  f(3)
  return f
}
function g() { return lap((a) => a + 1) }
const v: (f64) => f64 = g()
print(v(4))
const w = g()
print(w(3))
const w2 = g()
print(w2(3))
const v2: (f64) => f64 = g()
print(v2(4))
const u: (i32) => i32 = g()
print(u(7))
