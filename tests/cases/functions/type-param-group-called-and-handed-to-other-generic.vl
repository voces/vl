// @run
// @log x
// @log 1
// @log x
// @log 0
// Two parameters of one shared type parameter, each called, handed swapped to another generic
// that calls them at the other types: the set they share is tagged, so each call dispatches
// (D6090's hand-on to another generic).
function same<T>(k: T): T { k }
function other<G>(a: G, b: G, n: i32) {
  print(a("x"))
  print(b(n))
}
function mid<F>(a: F, b: F, n: i32) {
  print(a("x"))
  print(b(n))
  if n > 0 { other(b, a, n - 1) }
}
mid(same, same, 1)
