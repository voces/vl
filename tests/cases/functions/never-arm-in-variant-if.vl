// @run
// @log 3
// @log 4
// @log 5
// @log 6
// @log 7
// @log 8
// @log 12
// @log 4
// @log 6
// @log 7
// @log 3
// @hint redundant type annotation: `v` is inferred as `Circle` — remove it to lean on inference
// @hint redundant type annotation: `g` is inferred as `Circle` — remove it to lean on inference
// @hint redundant type annotation: `xs` is inferred as `Circle[]` — remove it to lean on inference
// An `if` delivered to one variant of a union, with a `never` arm, at each position that
// coerces to the variant: return, binding, assignment, global initialiser, list element, a
// narrowed value and a global assignment, annotated and inferred. The `never` arm builds as
// its own `unreachable`.
type Circle = {kind: "c", r: i32}
type Square = {kind: "s", s: i32}
type Shape = Circle | Square
function fail(m: string): never { __trap__(m) }
function mkc(r: i32): Circle { { kind: "c", r: r } }
function area(x: Shape) {
  if x is Circle { return x.r }
  x.s
}

function viaReturn(c: boolean): Circle {
  return if c { mkc(3) } else { fail("no") }
}
function viaBinding(c: boolean): Circle {
  const v: Circle = if c { mkc(4) } else { fail("no") }
  v
}
function viaAssign(c: boolean): Circle {
  let v: Circle = { kind: "c", r: 1 }
  v = if c { mkc(5) } else { fail("no") }
  v
}
const on = true
const g: Circle = if on { mkc(6) } else { fail("no") }
function viaElement(c: boolean): Circle[] {
  const xs: Circle[] = [if c { mkc(7) } else { fail("no") }]
  xs
}
function viaNarrowed(c: boolean, s: Shape): Circle {
  if s is Circle { return if c { s } else { fail("no") } }
  fail("sq")
}
let h: Circle = { kind: "c", r: 1 }
function setH(c: boolean) { h = if c { mkc(12) } else { fail("no") } }

function inferBinding(c: boolean) {
  const w = if c { mkc(4) } else { fail("no") }
  w
}
const k = if on { mkc(6) } else { fail("no") }
function inferElement(c: boolean) {
  const ys = [if c { mkc(7) } else { fail("no") }]
  ys
}
function inferTail(c: boolean) {
  if c { mkc(3) } else { fail("no") }
}

print(area(viaReturn(true)))
print(area(viaBinding(true)))
print(area(viaAssign(true)))
print(area(g))
print(area(viaElement(true)[0]))
print(area(viaNarrowed(true, { kind: "c", r: 8 })))
setH(true)
print(area(h))
print(area(inferBinding(true)))
print(area(k))
print(area(inferElement(true)[0]))
print(area(inferTail(true)))
