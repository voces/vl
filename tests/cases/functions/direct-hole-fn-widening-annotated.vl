// @run
// @log 1.5
// @log 1.5
// @log 3.5
// @hint redundant type annotation: `r` is inferred as `f64`
// @hint redundant type annotation: `s` is inferred as `f64`
// The annotated spellings of a direct call of a function widening `i32` to `f64`: an `f64`
// destination, and the function's own parameter annotated (D8161).
function half(a) { return a / 2.0 }
function halfI(a: i32) { return a / 2.0 }
type B = { v: f64 }
const r: f64 = half(3)
print(r)
const s: f64 = halfI(3)
print(s)
const b: B = { v: half(7) }
print(b.v)
