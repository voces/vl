// @run
// @log 71.5
// @log 71.5
// @log 2.5
// @log 2.5
// @log OTHER
// @hint Intentionally-unused parameter `_q0` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_q` (leading `_` marks it unused)
// A `const` alias of a lambda held in an annotated union, narrowed and called, calls the
// union's own value rather than the lambda it was built from. Also two aliases deep, in a
// list, in a record field, through an annotated function type, and at the other arm.
function go() {
  const v: ((i32) => f32) | boolean = (_q0) => 71.5
  const t0 = v
  if t0 is (i32) => f32 {
    print(t0(1))
    const t1 = t0
    print(t1(2))
  }
  const w: (n: i32) => f32 = (_q) => 2.5
  const a = w
  const b = a
  const fs = [b]
  print(fs[0](1))
  const r = { f: b }
  print(r.f(1))
  const z: ((i32) => f32) | boolean = false
  const z0 = z
  if z0 is (i32) => f32 { print(z0(1)) } else { print("OTHER") }
}
go()
