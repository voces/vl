// @check
// @error-at 36:10 'skipTags' is not a method — its first parameter is named `c`, not `self`, and a UFCS call `x.skipTags(…)` dispatches only to a `self` first parameter; rename it to `self`, or call `skipTags(…)` directly
// @error-at 38:10 no method 'widen' for Cursor — the free function `widen` takes `self: Span`
// @error-at 40:10 `bump` expects 0 arguments after `self`, got 2 — a UFCS call `x.bump(…)` passes the receiver as `self`
// @error-at 42:10 'tally' is not a method — it takes no parameters, and a UFCS call `x.tally(…)` dispatches only to a function whose FIRST parameter is named `self`; call `tally(…)` directly
// @error-at 44:10 no field 'nowhere' on Cursor
// D1570 — ONE GATE PER SENTENCE. `x.f(…)` resolves only to a free function whose FIRST
// parameter is named `self` (DECISIONS.md §"UFCS is never implicit"), and every call below
// is illegal for a DIFFERENT reason. Each used to report `no field 'f' on Cursor` — true,
// permanent, and pointing the reader at a field the type will never have, while the compiler
// knew both that the function exists and which gate turned it down (glean VL-021).
//
// THE ARMS MIRROR `ufcsCallTy`'s GATE IN ITS ORDER, so a call cannot be claimed by a later
// sentence than the one that actually refused it: the `self`-NAME rule, then the arity RANGE,
// then the receiver type.
//
// THE LAST CALL IS THE CONTROL and it is the reason this file is not just four asserts:
// `nowhere` names nothing at all, so the old sentence must survive. An enrichment that widens
// into every missing member is the failure mode this pins against.
type Cursor = { pos: i32 }
type Span = { lo: i32, hi: i32 }

// Gate 1 — a free function taking this very receiver, whose first parameter is not `self`.
function skipTags(c: Cursor): i32 { return c.pos + 1 }

// Gate 3 — a real `self`-function, on a DIFFERENT type.
function widen(self: Span): i32 { return self.hi - self.lo }

// Gate 2 — a `self`-function on this receiver, called with arguments it does not take.
function bump(self: Cursor): i32 { return self.pos + 2 }

// Gate 1 again, at its degenerate end: no parameters at all, so there is no name to rename.
function tally(): i32 { return 7 }

const cur: Cursor = { pos: 3 }

print(cur.skipTags())

print(cur.widen())

print(cur.bump(1, 2))

print(cur.tally())

print(cur.nowhere())
