// @error exported function `id` is generic over `T` and nothing in the program calls it
// A record held by another binding's field is the same record, so a write through `r.a.f`
// reaches `inner.f`; nothing calls either, and the export has no instance (D12332).
export function id<T>(x: T): T { x }
const inner = { f: id }
const r = { a: inner }
r.a.f = id
print(1)
