// @run
// @log ok
// @log s
// @log 1
// @log 2.5
// @log y
// @log 9
// @log 3
// @log s
// @log 1
// @log 9
// @log 3
// @hint redundant type annotation: `cc` is inferred as `{r: i32}` — remove it to lean on inference
// An un-annotated function whose returns join lists of different storage returns their union,
// built as the annotated spelling builds it, whether the result is discarded, bound, passed,
// relayed or held in a list (D2768).
type Circle = { r: i32 }
function h(c: boolean, t: string) {
  if c { return [t] }
  [1]
}
function g(c: boolean, t: f64) {
  if c { return [t] }
  ["y"]
}
function k(c: boolean, t: Circle) {
  if c { return [t] }
  [3]
}
function show(q: string[] | i32[]) {
  if q is string[] { print(q[0]) } else { print(q[0]) }
}
function relay(c: boolean) { return h(c, "s") }
h(true, "s")
print("ok")
show(h(true, "s"))
show(h(false, "s"))
const a = g(true, 2.5)
if a is f64[] { print(a[0]) }
const b = g(false, 2.5)
if b is string[] { print(b[0]) }
const cc: Circle = { r: 9 }
const p = k(true, cc)
if p is Circle[] { print(p[0].r) } else { print(p[0]) }
const n = k(false, cc)
if n is Circle[] { print(n[0].r) } else { print(n[0]) }
show(relay(true))
show(relay(false))
const l = [k(true, cc), k(false, cc)]
const l0 = l[0]
if l0 is Circle[] { print(l0[0].r) } else { print(l0[0]) }
const l1 = l[1]
if l1 is Circle[] { print(l1[0].r) } else { print(l1[0]) }
