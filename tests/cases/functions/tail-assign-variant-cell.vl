// A tail assignment to a union-VARIANT cell (`Circle`), returned from an un-annotated
// function. Pinned as an emit reject (`ref valtype with no interned shape`) until D4555
// pinned an inferred variant return to the arm's nominal name; it now runs at both the
// annotated and the un-annotated local, and the result is read and passed on as a `Shape`.
// @run
// @hint redundant type annotation: `c` is inferred as `Circle`
// @log 9
// @log 18
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq

function area(sh: Shape) {
  if sh is Circle { return sh.r }
  0
}

function mkCircle(): Circle { return { r: 3 } }
function mkBigger(): Circle { return { r: 9 } }

function bumpAnn() {
  let c: Circle = mkCircle()
  return (c = mkBigger())
}

function bumpUn() {
  let c = mkCircle()
  return (c = mkBigger())
}

print(bumpAnn().r)
const k = bumpUn()
print(k.r + area(k))
