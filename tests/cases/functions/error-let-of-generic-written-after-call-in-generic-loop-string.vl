// @error operator '+' is not defined for string and i32
// The string instance of a generic body whose loop writes the binding after calling it (D3968).
function inner<U>(u: U) { print(u) }
function plus<V>(v: V) { print(v + 1) }
function g<T>(t: T) {
  let k = inner
  let i = 0
  while i < 2 { k(t); k = plus; i = i + 1 }
}
g("s")
