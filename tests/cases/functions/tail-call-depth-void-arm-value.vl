// @run
// @log 1000000
// @log 1000000
// @log 1000000
// @log 1000000
// @log 3000000
// @log 1000000
// @log 1000000
// @log 1000000
// @log 1000000
// @log 1000000
// @log 15
// @log 6
// @log 10
// Void functions whose call is in tail position, each a million levels deep, which overflows
// the stack unless the call reuses the caller's frame:
//   · a call through a function value (`return_call_indirect`, D4680), bare and returned.
//   · a call ending the last `if` arm (D4681): then-only, both arms, an `else if` chain, a
//     nested `if`, a bare block, a function value, and an un-annotated void function.
// The last three prints are controls: a call with work after it is not a tail call.
let viaValue = 0
function downValue(n: i32): void {
  if n == 0 { return }
  viaValue = viaValue + 1
  const f = downValue
  f(n - 1)
}
downValue(1_000_000)
print(viaValue)

let viaValueRet = 0
function downValueRet(n: i32): void {
  if n == 0 { return }
  viaValueRet = viaValueRet + 1
  const f = downValueRet
  return f(n - 1)
}
downValueRet(1_000_000)
print(viaValueRet)

let thenOnly = 0
function downThen(n: i32): void {
  if n > 0 {
    thenOnly = thenOnly + 1
    downThen(n - 1)
  }
}
downThen(1_000_000)
print(thenOnly)

let both = 0
function downBoth(n: i32): void {
  if n % 2 == 0 {
    both = both + 1
    if n > 0 { downBoth(n - 1) }
  } else {
    both = both + 1
    downBoth(n - 1)
  }
}
downBoth(999_999)
print(both)

let chain = 0
function downChain(n: i32): void {
  if n == 0 {
    chain = chain + 0
  } else if n % 3 == 0 {
    chain = chain + 3
    downChain(n - 1)
  } else if n % 3 == 1 {
    chain = chain + 3
    downChain(n - 1)
  } else {
    chain = chain + 3
    downChain(n - 1)
  }
}
downChain(1_000_000)
print(chain)

let nested = 0
function downNested(n: i32): void {
  if n > 0 {
    nested = nested + 1
    if n > 1 { downNested(n - 1) } else { downNested(0) }
  }
}
downNested(1_000_000)
print(nested)

let blocked = 0
function downBlock(n: i32): void {
  if n == 0 { return }
  {
    blocked = blocked + 1
    {
      downBlock(n - 1)
    }
  }
}
downBlock(1_000_000)
print(blocked)

let armValue = 0
function downArmValue(n: i32): void {
  if n > 0 {
    armValue = armValue + 1
    const g = downArmValue
    g(n - 1)
  }
}
downArmValue(1_000_000)
print(armValue)

let byParam = 0
function hop(k: (n: i32) => void, n: i32): void {
  if n > 0 {
    byParam = byParam + 1
    k(n - 1)
  }
}
function viaParam(n: i32): void { hop(viaParam, n) }
viaParam(1_000_000)
print(byParam)

let inferred = 0
function downInferred(n: i32) {
  if n > 0 {
    inferred = inferred + 1
    downInferred(n - 1)
  }
}
downInferred(1_000_000)
print(inferred)

let after = 0
function notLast(n: i32): void {
  if n > 0 { notLast(n - 1) }
  after = after + n
}
notLast(5)
print(after)

let looped = 0
function loopCall(n: i32): void {
  if n > 0 {
    let i = 0
    while i < 2 {
      looped = looped + 1
      noop(i)
      i = i + 1
    }
    loopCall(n - 1)
  }
}
function noop(i: i32): void {
  if i < 0 { print(i) }
}
loopCall(3)
print(looped)

let tally = 0
function count(n: i32): void {
  if n > 0 {
    count(n - 1)
    tally = tally + n
  }
}
count(4)
print(tally)
