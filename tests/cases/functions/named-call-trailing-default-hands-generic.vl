// @run
// @log 3
// @log ab
// @log 3
// @log ab
// A call naming its arguments and leaving a trailing defaulted parameter out reads as its
// positional spelling, so a generic it hands is the set's id, called at two types (D14950).
function add(a, b) { return a + b }
function applyS(g, n: i32 = 1) {
  print(g(n, 2))
  print(g("a", "b"))
}
applyS(g: add)
function fwdS(h) { applyS(g: h) }
fwdS(add)
