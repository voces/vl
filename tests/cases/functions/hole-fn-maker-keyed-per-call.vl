// @run
// @hint redundant type annotation: `dbl` is inferred as `i32` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// @hint redundant type annotation: `sq` is inferred as `f64` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// @hint redundant type annotation: `ex` is inferred as `string` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// @hint Intentionally-unused variable `_p` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_s` (leading `_` marks it unused)
// Each call of a maker with an un-annotated parameter is keyed at its own argument: an uncalled
// hole function's call is closed at that function's default, never at another call's signature;
// a default whose body does not check at it is built with no body.
function inc0(a) { return a + 1 }
function mk2(f) { return f }
const _p = mk2(inc0)
function shout(s) { return s.length }
const _s = mk2(shout)
function dbl(s: i32): i32 { return s * 2 }
function sq(s: f64): f64 { return s * s }
function ex(s: string): string { return s + "!" }
const w = mk2(dbl)
const v = mk2(sq)
const q = mk2(ex)
print(w(4))
print(v(1.5))
print(q("hi"))
// @log 8
// @log 2.25
// @log hi!
