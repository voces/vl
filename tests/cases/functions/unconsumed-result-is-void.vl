// @run
// @log 1
// @log 2
// @log 1
// @log ok
// @log 4
// @log 11
// @log 3
// @hint Intentionally-unused variable `_k` (leading `_` marks it unused)
// @hint redundant type annotation: `want` is inferred as `v128` — remove it to lean on inference
// @hint redundant type annotation: `x` is inferred as `i32 | string` — remove it to lean on inference
// Regression (D2631, D2626; plumb PL-044). An un-annotated function whose result no caller
// reads is `void`: its tail value is never typed for lowering, so a tail `if` that assigns a
// vector, or a closure-captured union, no longer forces `v128 | null` or an assignment value.
let want: v128 = __splat_i32x4__(0)
function f(op: i32) {
  if op == 0 { want = __splat_i32x4__(1) }
}
f(0)
print(__extract_lane_i32x4__(want, 0))

// A tail call chain: `g` is read nowhere, so neither is `setTwo`.
function setTwo() {
  if true { want = __splat_i32x4__(2) }
}
function g() { setTwo() }
g()
print(__extract_lane_i32x4__(want, 0))

// A declared `: void` tail `if` is discarded the same way.
function h(op: i32): void {
  if op == 0 { want = __splat_i32x4__(1) }
}
h(0)
print(__extract_lane_i32x4__(want, 0))

// D2626: the tail `if` assigns a binding a closure captures.
function src(): i32 | string { return "s" }
function cap() {
  let x: i32 | string = src()
  const _k = () => x
  if x is string { x = "t" }
}
cap()
print("ok")

// A result some caller reads is still returned, through a tail call too.
function inc(x: i32) { x + 1 }
function viaTail(x: i32) { inc(x) }
inc(0)
print(viaTail(3))
function both(x: i32) { x + 10 }
both(0)
print(both(1))
const asValue = inc
print(asValue(2))
