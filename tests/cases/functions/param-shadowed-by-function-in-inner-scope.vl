// @run
// @log inner f
// @log 1
// @log shadow g
// @log 1
// @log 2
// A function declared in an inner block or a lambda body may shadow a parameter of its name;
// one declared directly in the body may not (D3945).
function b(f: i32) {
  if true {
    function f() { print("inner f") }
    f()
  }
  print(f)
}
b(1)
function c(g: (n: i32) => void) {
  const run = () => {
    function g(n: i32) {
      print("shadow g")
      print(n)
    }
    g(1)
  }
  run()
  g(2)
}
c((n: i32) => print(n))
