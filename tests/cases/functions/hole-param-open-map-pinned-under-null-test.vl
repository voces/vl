// @run
// @log 5
// @log 0
// @log 2
// A hole callee's map write on its parameter's non-null face pins an open `Map()` argument,
// handed directly or as the result of calling a lambda.
function take(a) {
  if a == null {
    print(0)
  } else {
    a["a"] = 4
    print(a.length + (a["a"] ?? 0))
  }
}
function viaCall(f) {
  const m = f()
  if m == null {
    print(0)
  } else {
    m["k"] = "s"
    print(m.length - 1)
  }
}
function pair(f) {
  const m = f()
  if m != null {
    m["x"] = 1.5
    m["y"] = 2.5
    print(m.length)
  }
}
take(Map())
viaCall(() => Map())
pair(() => Map())
