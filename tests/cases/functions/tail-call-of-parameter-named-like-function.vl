// @run
// @log 4
// @warning This function always recurses
// A tail call through a function-typed parameter that shares its function's name calls the
// parameter, so the function is as void as the parameter's result, not its own (D3828).
function f(n: i32, f: (a: i32) => i32) { f(n) }
print(f(3, (a: i32) => a + 1))
