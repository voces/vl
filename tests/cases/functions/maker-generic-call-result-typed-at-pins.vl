// @run
// @log 5
// @log 3.5
// @log 0.625
// @log 5
// @log 3.5
// @log 5
// @log 3.5
// A generic maker's call binds its type parameters, which pin the lambda it returns as a hole
// parameter's argument does: each binding's lambda is built at its own instance (D16799).
function adder<T>(n: T) { return (a) => a + n }
function annotated<T>(n: T) { return (a: T) => a + n }
const v = adder(2)
print(v(3))
const x = adder(1.5)
print(x(2.0))
print(v(3) / 8.0)
const e = adder<i32>(2)
print(e(3))
const f = adder<f64>(1.5)
print(f(2.0))
const g = annotated(2)
print(g(3))
const h = annotated(1.5)
print(h(2.0))
