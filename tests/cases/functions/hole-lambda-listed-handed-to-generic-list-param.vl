// @run
// @log 1
// @log 5
// A lambda listed by a hole parameter and handed to a declared generic's `T[]` parameter binds
// `T` at the lambda; the calls through the list instance it at each of their own types.
function use<T>(ys: T[]) { print(ys.length) }
function take(a) {
  const xs = [a]
  use(xs)
  print(xs[0]("abc").length + xs[0](2))
}
take((x) => x)
