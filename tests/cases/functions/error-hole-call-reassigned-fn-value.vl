// @check
// @error cannot pass the generic function `id` through `lap`: it is reassigned, so it holds a function value with one signature, and the parameter this argument meets is called at two types — call a `const` or a declared function, or pass a function of one type
// @error cannot pass the generic function `id` through `lap`: it is reassigned, so it holds a function value with one signature, and the parameter this argument meets is called at two types — call a `const` or a declared function, or pass a function of one type
// @error cannot pass the generic function `id` through `lap2`: it is reassigned, so it holds a function value with one signature, and the parameter this argument meets is called at two types — call a `const` or a declared function, or pass a function of one type
// @error cannot pass the generic function `id` through `lap3`: it is reassigned, so it holds a function value with one signature, and the parameter this argument meets is called at two types — call a `const` or a declared function, or pass a function of one type
// A generic function handed through a reassigned binding to a parameter its body calls at two
// types is refused at the call: the binding holds one function value, whose parameter takes one
// type. Reassigned before or after the call, in a branch, or to itself (D6351).
function id(a) { return a }
let lap = (g) => {
  print(g(1) + 1); return g("s")
}
print(lap(id))
lap = (g) => {
  print(g(2) + 2); return g("t")
}
print(lap(id))
let lap2 = (g) => {
  print(g(1) + 1); return g("s")
}
lap2 = lap2
print(lap2(id))
function main() {
  let lap3 = (g) => {
    print(g(1) + 1); return g("s")
  }
  if true {
    lap3 = (g) => {
      print(g(2) + 2); return g("t")
    }
  }
  print(lap3(id))
}
main()
