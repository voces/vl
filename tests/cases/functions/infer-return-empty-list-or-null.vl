// @run
// @log 0
// @log 0
// @log false
// @log 0
// @log 1
// An inferred return joining an empty list literal with `null`, whose list no caller writes, is
// built at the unbound default as a `let` of one is (D16448): an `if` value, an early return, a
// test of the call, a hole parameter handed it, and a caller that writes it.
function joined(c: boolean) { return if c { [] } else { null } }
const a = joined(true)
if a != null { print(a.length) } else { print("null") }
function early(c: boolean) {
  if c { return [] }
  return null
}
const b = early(true)
if b != null { print(b.length) } else { print("null") }
print(joined(true) == null)
function use(x) {
  if x != null { print(x.length) }
}
use(early(true))
function written(c: boolean) { return if c { [] } else { null } }
const w = written(true)
if w != null {
  w.push(7)
  print(w.length)
}
