// @error a {f: (_) => _} cannot be delivered as {f: (f64) => f64} here
// An identity `.map` hands on the source's own records, so delivering it where a field closes is
// the record-sharing case, refused; the list is fresh, its elements are not (D17793).
function id(a) { return a }
function deliver() { return [{ f: id }] }
const v: { f: (a: f64) => f64 }[] = deliver().map((r) => r)
print(v[0].f(2.5))
