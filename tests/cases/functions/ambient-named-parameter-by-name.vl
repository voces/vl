// @run
// @log 32
// @log 9
// @log 41
// D4066 — a parameter named like an ambient function is still passed by its own name; the
// merge renames the binding apart from the builtin, never the label a caller writes.
function show(print: i32, n: i32) { print * 10 + n }
function mk(Set: i32) { Set }
function both(fromCodePoint: i32, Map: i32) { fromCodePoint * 10 + Map }
print(show(n: 2, print: 3))
print(mk(Set: 9))
print(both(Map: 1, fromCodePoint: 4))
