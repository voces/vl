// @run
// @log 8
// @log 2
// @log 5
// @log 9
// @log 2
// @log 3.5
// @log 5
// A named function in a record field is a set id, as in a list: a record of it and a record of
// a hole parameter bound to it reach one callee at two types, in either order (D15640).
function dbl(v) { return v + v }
function inc(v) { return v + 1 }
function call0(r, x) { print(r.f(x)) }
function both(g) {
  print(g(1))
  call0({ f: g }, 2.5)
}
const r = { f: dbl }
call0(r, 4)
both(dbl)
const q = { f: dbl }
call0(q, 4.5)
function call1(r, x) { print(r.f(x)) }
function both1(g) {
  print(g(1))
  call1({ f: g }, 2.5)
}
both1(inc)
function mk() { return { f: inc } }
call1(mk(), 4)
