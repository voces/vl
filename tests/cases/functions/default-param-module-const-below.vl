// @run
// @log 5
// @log 7
// @log 5
// A default naming a module `const` declared BELOW its function is legal wherever the first
// call stands: the default's name is the binder's, resolved at the declaration (D3322).
function f(x: i32 = K) { x }
const K = 5
print(f())
print(f(7))
const r = f()
print(r)
