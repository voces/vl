// @emit-error emitProgram: cannot take the generic function `id` as a value
// The list spelling, the un-annotated destination first: one function value read at two signatures.
function id(a) { return a }
function deliver() { return [{ f: id }] }
const u = deliver()
const v: { f: (a: f64) => f64 }[] = deliver()
print(v[0].f(2.5))
print(u[0].f(2))
