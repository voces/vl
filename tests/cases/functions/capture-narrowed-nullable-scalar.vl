// @run
// @log D:8
// @log C:8
// @log L:8
// @log D:NO
// @log C:NO
// @log L:NO
// @log ne:8
// @log el:8
// @log and:8
// @log wh:8
// @log ne:NO
// @log el:NO
// @log and:NO
// @log wh:NO
// @log 2.5
// @log 9000000002
// @log 2.5
// @log f64:NO
// @log i64:NO
// @log f32:NO
// @hint redundant type annotation: `v` is inferred as `i64`
// A BOXED nullable scalar (`i32 | null` and friends — NOT one of the eleven niches; a scalar
// has no spare value, so it rides the value-union box) captured by a closure, narrowed both
// WHERE THE CLOSURE IS WRITTEN and INSIDE THE CLOSURE'S OWN BODY. Both were `vl check`-clean
// invalid wasm (`expected i32, found (ref $type)`: the read handed the box to `print`).
//
// The two halves need different machinery and this file pins both:
//   · narrowed at the DECLARATION SITE — the guard is in the enclosing frame, so the callee
//     needs the narrowing REPLAYED (`capNarrowSeed`).
//   · narrowed INSIDE the callee — the narrowing is already live there; what was missing is
//     that `emitUnionBoxPush` had no capture leg, so the box could not be fetched from the
//     env at all. Its own comment claimed "a clean reject, not invalid wasm" — but that
//     floor was unreachable, because `emitIdentNode` read the env FIRST and returned.
// Every null-COMPARISON spelling is covered (`!= null`, `== null` with the narrowed arm as
// the ELSE, `&&`, and a `while` guard), because the guard FORM decides which resolver runs.
//
// `D:`/`ne:`/`el:`/`and:`/`wh:` each print the non-captured spelling first where one exists,
// and both runtime inputs (a present value and `null`) are exercised for every cell. The
// f64 / i64 / f32 arms print their value BARE, in that order — `toString` takes only i32 or
// boolean, so a labelled form is not available for them.
function declSite(u: i32 | null) {
  if u != null {
    print("D:" + toString(u + 1))
  } else {
    print("D:NO")
  }
  if u != null {
    function capNesA() {
      print("C:" + toString(u + 1))
    }
    capNesA()
  } else {
    print("C:NO")
  }
  if u != null {
    const capLamA = () => {
      print("L:" + toString(u + 1))
    }
    capLamA()
  } else {
    print("L:NO")
  }
}

function inBody(u: i32 | null) {
  function capNe() {
    if u != null { print("ne:" + toString(u + 1)) } else { print("ne:NO") }
  }
  capNe()
  function capEl() {
    if u == null { print("el:NO") } else { print("el:" + toString(u + 1)) }
  }
  capEl()
  function capAnd() {
    if u != null && 1 == 1 {
      print("and:" + toString(u + 1))
    } else {
      print("and:NO")
    }
  }
  capAnd()
  function capWhile() {
    while u != null {
      print("wh:" + toString(u + 1))
      break
    }
    if u == null { print("wh:NO") }
  }
  capWhile()
}

function otherScalars(f: f64 | null, j: i64 | null, g: f32 | null) {
  if f != null {
    function capF() { print(f + 1.0) }
    capF()
  } else {
    print("f64:NO")
  }
  if j != null {
    function capJ() { print(j + 1) }
    capJ()
  } else {
    print("i64:NO")
  }
  if g != null {
    function capG() { print(g + 1.0) }
    capG()
  } else {
    print("f32:NO")
  }
}

function mkI(b: boolean): i32 | null {
  if b { return 7 }
  return null
}

function mkF(b: boolean): f64 | null {
  if b { return 1.5 }
  return null
}

// The `i64` annotation on `v` is what makes the literal an i64 rather than the i32 the
// bare spelling infers, so it is KEPT and its hint declared above.
function mkJ(b: boolean): i64 | null {
  if b {
    const v: i64 = 9000000001
    return v
  }
  return null
}

function mkG(b: boolean): f32 | null {
  if b {
    const v: f32 = 1.5
    return v
  }
  return null
}

function main() {
  declSite(mkI(true))
  declSite(mkI(false))
  inBody(mkI(true))
  inBody(mkI(false))
  otherScalars(mkF(true), mkJ(true), mkG(true))
  otherScalars(mkF(false), mkJ(false), mkG(false))
}

main()
