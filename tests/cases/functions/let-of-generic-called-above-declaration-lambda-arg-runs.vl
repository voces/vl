// @run
// @log 5
// @info `k` is never reassigned; use `const` instead of `let`
// A call above the module binding's declaration leaves a lambda argument to the call's own
// typing; the binding's check does not type it out of context (D3960).
function app2<T>(x: T, f: (n: T) => T) { print(f(x)) }
function useK() { k(4, (x) => x + 1) }
let k = app2
useK()
