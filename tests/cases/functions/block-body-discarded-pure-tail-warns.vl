// @run
// @warning this value is discarded; did you mean `return …`?
// @warning this value is discarded; did you mean `return …`?
// @log 3
// A block body returns a value only through `return`: a pure expression left as its last
// statement is discarded and warns, parenthesised too, while a call there is never warned.
function plain(n: i32) {
  const x = n + 1
  x
}
function paren(n: i32) {
  const y = n * 2
  (y)
}
function called(n: i32) { print(n) }
plain(1)
paren(2)
called(3)
