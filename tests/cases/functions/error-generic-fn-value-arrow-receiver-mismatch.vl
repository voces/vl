// @check
// @error argument 1: expected (i32, i32) -> i32, got (f64, _) -> f64
// @error argument 1: expected (i32, i32) -> i32, got (_, _, _) -> _
// The BOUNDARY of the arrow-receiver path. Making the receiver's declared parameter type heard is
// only sound while it constrains rather than invents: a written `a: f64` that disagrees with the
// declared `(i32, i32) => i32` is not assignable however the receiver is spelled, and neither is a
// three-parameter value. Both reject at the CHECKER, before the coercion is asked anything, which
// is where the `function`-declaration spelling has always rejected them.
//
// The accepting twin is `generic-fn-value-arrow-receiver.vl`, whose `applyC` is the same
// declaration; the only difference is whether the value AGREES with what it declares.
function mpadd(a: f64, b) { return a + b }
function tripAdd(a, b, c) { return a + b + c }
const applyC = (g: (i32, i32) => i32, x: i32, y: i32) => g(x, y)

print(applyC(mpadd, 3, 4))
print(applyC(tripAdd, 3, 4))
