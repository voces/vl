// @error operator '+' is not defined for boolean and i32
// A delivery of the binding to a concrete function parameter is a call at that parameter's
// types for every function written to it (D3968).
function inner<U>(u: U) { print(u) }
function plus<V>(v: V) { print(v + 1) }
function ci(f: (b: boolean) => void) { f(true) }
function main() {
  let k = inner
  k = plus
  ci(k)
}
main()
