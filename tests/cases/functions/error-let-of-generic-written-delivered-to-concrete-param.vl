// @error argument 1: expected (boolean) => void, got (V) => void
// A delivery of the binding to a concrete function parameter is the function its last write
// stored, `plus`, refused at that parameter's types as `ci(plus)` is (D3968, D16182).
function inner<U>(u: U) { print(u) }
function plus<V>(v: V) { print(v + 1) }
function ci(f: (b: boolean) => void) { f(true) }
function main() {
  let k = inner
  k = plus
  ci(k)
}
main()
