// @log 6
// A lambda literal in a body whose instances hand it on at a different function type each
// takes an instance per type (D5931).
function two(a: i32, b: (n: i32) => i32) { b(a) }
function twof(a: f64, b: (n: f64) => f64) { b(a) }
function twos(a: string, b: (n: string) => string) { b(a) }

function outerA(h, x) { return h(x, (n) => n * 2) }
print(outerA(two, 3))
print(outerA(twof, 1.5))

function fwd(h, x, f) { return h(x, f) }
function outerB(h, x) { return fwd(h, x, (n) => n * 2) }
print(outerB(two, 3))
print(outerB(twof, 1.5))

function outerC(h, x) { return h(x, (n) => n + n) }
print(outerC(two, 3))
print(outerC(twof, 1.5))
print(outerC(twos, "ab"))
print(outerC(two, 5))
print(outerC(twof, 0.25))

function lead(b: (n: i32) => i32, a: i32) { b(a) }
function leadf(b: (n: f64) => f64, a: f64) { b(a) }
function outerD(h, x) { return h(((n) => n * 2), x) }
print(outerD(lead, 3))
print(outerD(leadf, 1.5))

function test(a: i32, b: (n: i32) => boolean) { b(a) }
function testf(a: f64, b: (n: f64) => boolean) { b(a) }
function outerE(h, x) { return h(x, (n) => n > 2) }
print(outerE(test, 3))
print(outerE(testf, 1.5))

function both(a: i32, b: (n: i32) => i32, c: (n: i32) => i32) { c(b(a)) }
function bothf(a: f64, b: (n: f64) => f64, c: (n: f64) => f64) { c(b(a)) }
function outerF(h, x) { return h(x, (n) => n * 2, (m) => m + 1) }
print(outerF(both, 3))
print(outerF(bothf, 1.5))

function outerG(h, x) {
  let s = x
  for i in [1, 2] { s = h(s, (n) => n * 2) }
  return s
}
print(outerG(two, 3))
print(outerG(twof, 1.5))
