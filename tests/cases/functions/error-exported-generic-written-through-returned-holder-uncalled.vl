// @error exported function `id` is generic over `T` and nothing in the program calls it
// A returned record holding another binding reaches that binding's record, whose reads decide
// the write; none of them calls it (D12370).
export function id<T>(x: T): T { x }
const inner = { f: id }
function mk() { { a: inner } }
const r = mk()
r.a.f = id
print(1)
