// @run
// @log 2
// @log 2
// @log 2
// @log 2
// @log 5
// @log 2
// @log s
// @log 5
// @log 7
// A value join of list or record literals, one arm holding a generic named function and the other
// an annotated one, inside a function with a hole parameter, builds the generic member's instance
// at the join's closed type: called directly, through a hole callee, nested, or returned (D15659).
function idA(a) { return a }
function idB(a) { return a }
function idC(a) { return a }
function idD(a) { return a }
function idE(a) { return a }
function idF(a) { return a }
function idG(a) { return a }
function id3(a: i32) { return a }
function id4(a: string) { return a }
function gl(r) { return r[0](2) }
function gf(r) { return r.f(2) }
function viaHole(c) {
  const k = if c { [idA] } else { [id3] }
  print(gl(k))
}
function direct(c) {
  const k = if c { [id3] } else { [idB] }
  print(k[0](2))
}
function rec(c) {
  const k = if c { { f: idC } } else { { f: id3 } }
  print(gf(k))
}
function nested(c) {
  const k = if c { [[idD]] } else { [[id3]] }
  print(k[0][0](2))
}
function twoElems(c) {
  const k = if c { [idE, id3] } else { [id3, idE] }
  print(gl(k) + k[1](3))
}
function twoInst(c, z, v) {
  const k = if c { [idF] } else { [z] }
  print(k[0](v))
}
function returned(c) { return if c { [idG] } else { [id3] } }
viaHole(true)
direct(false)
rec(true)
nested(true)
twoElems(false)
twoInst(true, id3, 2)
twoInst(true, id4, "s")
twoInst(false, id3, 5)
print(returned(true)[0](7))
