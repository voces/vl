// A generic handed to two parameters of one type parameter, each called at another type,
// keeps its own pin per parameter when the type parameter is read nowhere else (D6090).
function same<T>(k: T): T { k }
function also<T>(k: T): T { k }
function take(a) { print(a("x")) }
function take2(a) { print(a(3)) }
function mid<F>(a: F, a1: F) {
  take(a)
  take2(a1)
}
function midN<F>(a: F, n: i32, a1: F) {
  take(a)
  take2(a1)
  print(n)
}
function direct<F>(a: F, a1: F) {
  print(a("x"))
  print(a1(3))
}
function holes(a, a1) {
  take(a)
  take2(a1)
}
function agree<F>(a: F, a1: F) {
  take(a)
  take(a1)
}
function main() { mid(same, same) }
mid(same, same)
main()
midN(same, 7, same)
midN(same, 8, same)
mid(same, also)
direct(same, same)
holes(same, same)
agree(same, same)
