// @run
// @log 1
// @log 1
// @log 2
// @log 3
// @log 7
// @log 4
// @hint redundant type annotation: `h` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `hs` is inferred as `string` — remove it to lean on inference
// @hint redundant type annotation: `h3` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `hd` is inferred as `{on: () => void}` — remove it to lean on inference
// DECISIONS (void-discard, clause 3): a NAMED module-scope function's VALUE
// `(P…) => T` is assignable where `(P…) => void` is expected — wholesale coercion
// (TS/Kotlin-adapted-reference precedent), so extracting an inline lambda to a
// named function cannot break the call that worked. The emitter mints a VOID TWIN
// per coerced target (`synthVoidTwins`): the value called through the void slot
// carries a genuine 0-result functype, and the original keeps returning its value
// to its own callers. The deliberate asymmetry: this named `(): i32` with an
// explicit `return` coerces as a VALUE, while the same body written INLINE errors
// on its explicit return (`void-callback-explicit-return-rejected.vl`).
function g(cb: () => void) {
  cb()
  cb()
}
function h(): i32 {
  print(1)
  return 7
}
g(h)
// The binding and struct-field seams coerce the same way.
function hs(): string {
  print(2)
  "x"
}
const k: () => void = hs
k()
type Handler = { on: () => void }
function h3(): i32 { 3 + 4 }
const hd: Handler = { on: () => {
  print(3)
  h3()
} }
hd.on()
// The original is untouched for its own callers.
print(h3())
print(4)
