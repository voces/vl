// @run
// A fresh record of several fields holding a generic function, delivered to a closed closure
// field and also kept un-annotated: the result holds the set's id, the annotated destination
// converts it per field, and each member is pinned at the field's signature (D17777).
function id(a) { return a }
function dbl(a) { return a + a }
function deliver() { return { f: id, n: 3 } }
const v: { f: (a: f64) => f64, n: i32 } = deliver()
const u = deliver()
print(v.f(2.5) + u.f(2) + v.n)
function two() { return { f: id, g: id, n: 3 } }
const w: { f: (a: f64) => f64, g: (a: f64) => f64, n: i32 } = two()
const x = two()
print(w.f(2.5) + w.g(1.5) + x.f(2) + w.n)
function pick(k: i32) {
  if k > 0 { return { f: id, n: 3 } }
  return { f: dbl, n: 4 }
}
const p: { f: (a: f64) => f64, n: i32 } = pick(0)
const q = pick(1)
print(p.f(2.5) + q.f(2) + p.n)
function main() {
  const m: { f: (a: f64) => f64, n: i32 } = deliver()
  print(m.f(2.5) + m.n)
}
main()
function use<T>(t: T) {
  print(t)
  const r: { f: (a: f64) => f64, n: i32 } = deliver()
  return r.f(2.5) + r.n
}
print(use(1) + use("s"))
// @log 7.5
// @log 9
// @log 11
// @log 5.5
// @log 1
// @log s
// @log 11
