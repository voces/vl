// @run
// A three-arm `else if` choice of named functions in a generic instance (an un-annotated
// condition) is held at its set's id, each link of the chain built at that one rep.
function id(v) { return v }
function dbl(v) { return v + v }
function neg(v) { return 0 - v }
function t(b) {
  const g = if b { id } else if b { dbl } else { neg }
  print(g(3))
}
t(false)
function u(b, c) {
  const g = if b { id } else { if c { dbl } else { neg } }
  print(g(3))
  print(g(2.5))
}
u(false, true)
// @log -3
// @log 6
// @log 5
