// @error operator '+' is not defined for boolean and i32
// An element of an array literal is delivered to the element type, a call at its parameters
// for every function written to the binding (D3968).
function inner<U>(u: U) { print(u) }
function plus<V>(v: V) { print(v + 1) }
function other<V>(v: V) { print(v) }
function main() {
  let k = inner
  k = plus
  const fs: ((b: boolean) => void)[] = [k]
  fs[0](true)
}
main()
