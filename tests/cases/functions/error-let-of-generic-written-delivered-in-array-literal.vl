// @error cannot assign ((V) => void)[] to 'fs' of type ((boolean) => void)[]
// An element of an array literal is delivered to the element type: the read holds the function
// its most recent write stored, `plus`, which no `boolean` closes (D3968, D15957).
function inner<U>(u: U) { print(u) }
function plus<V>(v: V) { print(v + 1) }
function other<V>(v: V) { print(v) }
function main() {
  let k = inner
  k = plus
  const fs: ((b: boolean) => void)[] = [k]
  fs[0](true)
}
main()
