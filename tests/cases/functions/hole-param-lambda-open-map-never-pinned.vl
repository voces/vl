// @run
// @warning the element type of a container this argument holds is never fixed by any write, so it is always empty — give it its type where it is built if a write was meant
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// @log 0
// A lambda's `Map()` result handed to an un-annotated parameter that only reads its length:
// nothing gives the map a key or value type, so it runs at the default, as the binding does.
function take(a) {
  const v = a
  print(v(2).length)
}
take((_x: i32) => Map())
