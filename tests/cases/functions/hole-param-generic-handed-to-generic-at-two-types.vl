// @run
// @log 4
// @log 4
// @log 1.5
// @log 4
// A hole parameter handed a named generic and passed on to a generic's function parameter at two
// types is that generic at each call, whatever order the types come in or how many frames in.
function id<T>(x: T): T { x }
function run<U>(f: (x: U) => U, u: U): U { f(u) }
function take(a) {
  print(run(a, 2) + run(a, "ab").length)
}
function both(a) {
  print(run(a, "ab").length + run(a, 2))
  print(run(a, 1.5))
}
function fwd(g) { take(g) }
take(id)
both(id)
fwd(id)
