// @run
// @log 321
// @log 7
// A function type's parameter list may break after `(`, after each `,` and before `)`, as a
// declared function's does (D3278). Named signatures are long enough to need it; the unnamed
// form was a parse error too.
type GuestCall = (
  fn: i32,
  rcx: i64,
  rdx: i64,
) => i32
function h(fn: i32, rcx: i64, rdx: i64) {
  fn + (rcx as! i32) * 10 + (rdx as! i32) * 100
}
function k(cb: (i32, i32) => i32) { cb(3, 4) }
const g: GuestCall = h
print(g(1, 2 as i64, 3 as i64))
print(k((a: i32, b: i32): i32 => a + b))
