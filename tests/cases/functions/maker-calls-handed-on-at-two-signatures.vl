// @run
// @log 5
// @log 2.75
// @log 5
// @log 2.75
// Two calls of a maker at two pins, each bound and handed on to a parameter calling it at its own
// signature, are each built at their binding's type: annotated destinations or not (D16846, D16850).
function adder(n) { return (a) => a + n }
function take(a) { print(a(3)) }
function half(a) { print(a(0.5)) }
const x = adder(2)
take(x)
const z = adder(2.25)
half(z)
function takeAt(a: (a: i32) => i32) { print(a(3)) }
function halfAt(a: (a: f64) => f64) { print(a(0.5)) }
const x2 = adder(2)
takeAt(x2)
const z2 = adder(2.25)
halfAt(z2)
