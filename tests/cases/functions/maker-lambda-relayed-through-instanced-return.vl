// @run
// @log 0.5
// @log 0.5
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// @log 0.625
// A maker's hole lambda relayed by a generic or hole-parameter function, delivered at a function
// type returning `f64`, returns `f64`: the call search climbs out through the instanced relay's
// return to its calls (D16780).
function deliver() { return (a) => a + 1 }
function wrap<T>(_x: T) { return deliver() }
const w: (a: i32) => f64 = wrap("s")
print(w(3) / 8.0)
function relay(_x) { return deliver() }
const r: (a: i32) => f64 = relay(1)
print(r(3) / 8.0)
function twice<T>(x: T) { return wrap(x) }
const t: (a: i32) => f64 = twice(true)
print(t(4) / 8.0)
