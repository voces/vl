// @run
// @log 14
// @log 14
// @log 3.5
// @log -6
// @log -6
// @log -1.5
// @log 14
// @log 3.5
// A literal a hole forwarder hands on is, in each instance, the literal at the width of the
// parameter it reaches: i64, f32 and f64, a negative literal, and through two forwarders.
function wantI64(a: i64) { return a * 2 }
function wantF32(a: f32) { return a * 2.0 }
function wantF64(a: f64) { return a / 2.0 }
function apply(g, x) { return g(x) }
function lit(h) { return apply(h, 7) }
function neg(h) { return apply(h, -3) }
function twice(h) { return lit(h) }
print(lit(wantI64))
print(lit(wantF32))
print(lit(wantF64))
print(neg(wantI64))
print(neg(wantF32))
print(neg(wantF64))
print(twice(wantI64))
print(twice(wantF64))
