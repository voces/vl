// @run
// @log 5
// @log 5
// @log 5
// @log 5
// @hint redundant type annotation: `vAnn` is inferred as `(i32) => i32` — remove it to lean on inference
// @hint redundant type annotation: `bvAnn` is inferred as `(i32) => i32` — remove it to lean on inference
// THE MODULE IS THE OUTERMOST FRAME, and `exprIsClosureNoLocal`'s scope chain ended before
// it. `fnParent` is -1 for a top-level lambda, so a lambda whose tail READS a module-scope
// binding fell through to the module-wide FUNCTION lookup — and a lifted lambda is not named
// `held`, so the tail classified as a non-closure and the whole result type went with it.
// The caller reads the same predicate for a call RESULT, which is why the symptom lands at
// `const v = get()` and not at `get`. D1542.
//
// FOUR STORAGE CLASSES OF THE CAPTURED BINDING, and each was a different outcome: a module
// GLOBAL and a module BLOCK-LOCAL both refused `call to unknown function`; the same two with
// the destination ANNOTATED were check-clean invalid wasm. The function-body face always ran,
// which is what proves the module is the missing frame rather than the shape being unbuildable.
type Inc = (i32) => i32
const held = (x: i32) => x + 1
const get = () => held
const v = get()
print(v(4))
const vAnn: Inc = get()
print(vAnn(4))
if true {
  const bHeld = (x: i32) => x + 1
  const bGet = () => bHeld
  const bv = bGet()
  print(bv(4))
  const bvAnn: Inc = bGet()
  print(bvAnn(4))
}
