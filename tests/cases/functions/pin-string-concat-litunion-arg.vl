// @run
// @log green!
// @log green!
// @log !green
// @log green!
// @log red!
// The generic pin's `+` floor and `checkBinary` must accept the same operand pairs. The direct
// rule is ONE operand being the `string` prim plus mutual assignability; the pin mirror asked
// for BOTH to be it, so every operand that is only assignable to `string` — a literal union, a
// bare literal type — was refused through a hole parameter while its annotation ran (D1732).
//
// The hole parameters are load-bearing: annotate any of them and the refusal was never reached.
// The numeric line is the control — the pin's numeric leg always consulted the softened pair,
// which is what made the string half's absence a missing leg rather than a policy.

type K = "red" | "green"
const src: K[] = ["green", "red"]
const inl: ("red" | "green")[] = ["green", "red"]
const one: "red"[] = ["red"]

function cat(a) { print(a + "!") }
function catInline(a) { print(a + "!") }
function rev(a) { print("!" + a) }
function hop(a) {
  const b = a
  print(b + "!")
}
function catLit(a) { print(a + "!") }

cat(src[0])
catInline(inl[0])
rev(src[0])
hop(src[0])
catLit(one[0])
