// @error cannot assign string to i32
// Two open maps that meet at a store are one map: its value is one hole, so the first write pins
// it and the second, conflicting write is refused, as on an annotated `{[string]: i32}`.
const a = Map()
let b = Map()
b = a
b["k"] = 1
a["j"] = "s"
print(b.length)
