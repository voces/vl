// @check
// @error-at 6:25 the parameter name `a` appears twice in this list
// @error-at 7:25 the parameter name `a` appears twice in this list
// Two parameters of one list under one name (D3279): the body and a named argument can reach
// only one of them, so the second was silently dead and `f(1, 2)` read `1`. `_` may repeat,
// since it names nothing.
function f(a: i32, a: i32) { a }
const l = (a: i32, a: i32): i32 => a
const skip = (_: i32, _: i32): i32 => 3
print(f(1, 2) + l(1, 2) + skip(1, 2))
