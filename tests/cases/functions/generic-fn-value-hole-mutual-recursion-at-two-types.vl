// @log x
// @log 0
// A hole parameter called at two types in a function that recurses through a second function
// takes a parameter per type, and both functions hand on every one (D6203).
function same<T>(k: T): T { k }
function mid(a, n: i32) {
  print(a("x"))
  print(a(n))
  if n > 0 { mid2(a, n - 1) }
}
function mid2(a, n: i32) { mid(a, n) }
mid(same, 1)
