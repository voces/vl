// @emit-error emitProgram: cannot take the generic function `id` as a value
// One value of a generic function, returned in a record by a function called twice, is read at
// `f64` through an annotated binding and at `i32` through an un-annotated one: a function value
// carries one signature, so this is refused as the both-annotated spelling is, whichever
// destination comes first (it trapped `indirect call type mismatch` before).
function id(a) { return a }
function deliver() { return { f: id } }
const v: { f: (a: f64) => f64 } = deliver()
const u = deliver()
print(v.f(2.5) + u.f(2))
