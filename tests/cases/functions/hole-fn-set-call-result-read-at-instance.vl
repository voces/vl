// @run
// @log 3
// @log 3
// @log 3
// @log 0
// @log 2
// @log s
// @log 2
// @log s
// A call through a hole parameter bound to one function types at the instance, so an operator,
// an index and a binding over its result take that type, and a call nested in its argument, an
// `if` tail of such calls, and one call through two singleton sets in two instances run.
function wrap(a) { return [a] }
function id(a) { return a }
function other(a) { return a }
function opOn(g, x) { print(g(x)[0] + 0.5) }
function bound(g, x) {
  const r = g(x)
  print(r[0] + 0.5)
}
function nested(g, x) {
  const r = g(g(x))
  print(r[0][0] + 0.5)
}
function tailIf(g, x) {
  if x > 3 { g(g(x)) } else { g(g(0)) }
}
function lap(g) {
  print(g(1) + 1)
  return g("s")
}
opOn(wrap, 2.5)
bound(wrap, 2.5)
nested(wrap, 2.5)
print(tailIf(wrap, 2)[0][0])
print(lap(id))
print(lap(other))
