// A generic handed to hole parameters of a call inside a hole function's body keeps the instance
// each parameter calls it at, beside another hole function handed it at module scope (D6743).
function id(a) { return a }
function app(g, h) { print(g(1)); return h("s") }
function use(n) { print(n); return app(id, id) }
print(use(1))
function app3(g) { return g(1) }
print(app3(id))
function app1(g) { return g("s") }
function use1<T>(n: T) { print(n); return app1(id) }
print(use1(1))
print(app3(id))
function idd<A>(a: A): A { return a }
function use2(n) { print(n); return app1(idd) }
print(use2(1))
print(app3(idd))
