// @run
// @log 3
// @log x
// @log true
// @warning Unused parameter `h`
// A generic handed to two parameters of one type parameter and handed on to a two-parameter
// callee whose result is called at another type: the parameters share one tagged set, so each
// call dispatches rather than one instance serving both types (once refused at emit).
function same<T>(k: T): T { k }
function call2<G>(g: G, h: G) { return g }
function mid<F>(a: F, b: F) {
  const r = call2(a, b)
  print(r(3))
  print(a("x"))
  print(b(true))
}
mid(same, same)
