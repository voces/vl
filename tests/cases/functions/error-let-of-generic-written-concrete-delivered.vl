// @error cannot assign (i32) => void to (boolean) => void — `k` holds (i32) => void since the write on line 8
// A delivery of the binding is held to the written function's type too (D3960).
function inner<U>(u: U) { print(u) }
function q(n: i32) { print(n) }
function ci(f: (b: boolean) => void) { f(true) }
function main() {
  let k = inner
  k = q
  ci(k)
}
main()
