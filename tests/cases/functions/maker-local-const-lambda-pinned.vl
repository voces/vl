// @run
// @log 3.5
// @log 7
// @log 1.25
// @log 3.5
// A maker returning its lambda through a local `const`: a call through a binding of its call is
// typed by that lambda at the call's pins, as by one returned directly (D16818).
function adder(n) {
  const f = (a) => a + n
  return f
}
function gadder<T>(n: T) {
  const f = (a) => a + n
  return f
}
const x = adder(1.5)
print(x(2.0))
print(x(2.0) * 2.0)
const y = adder(0.25)
print(y(1.0))
const g = gadder(1.5)
print(g(2.0))
