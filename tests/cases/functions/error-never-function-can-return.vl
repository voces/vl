// @check
// @error `fail` is declared `never` but can return
// @error `half` is declared `never` but can return
// @error a function declared `never` cannot return
// @error a function declared `never` cannot return
// @error `spin` is declared `never` but can return
// A `: never` function must end every path in a call that never returns. Falling off the end,
// a path the `if` leaves open, and any `return` are refused at the declaration. A `while true`
// body is not an exit yet, the same rule as a guard arm's (D1973). D1972.
function fail(msg: string): never { print(msg) }
function half(c: boolean): never {
  if c { __trap__() }
}
function bare(): never { return }
function valued(): never { return 1 }
function spin(): never {
  while true { print(1) }
}
print(1)
