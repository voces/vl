// @error Its uses disagree: `takesI(…x…)` (line 7) wants `i32`, and `takesS(…x…)` (line 8) wants `string`
// @error argument 1: expected string, got i32
// Two uses pinning an export's untyped parameter to different types: both sites are named (D3817).
function takesI(a: i32) { a }
function takesS(a: string) { a }
export function c(x) {
  print(takesI(x))
  print(takesS(x))
}
print(1)
