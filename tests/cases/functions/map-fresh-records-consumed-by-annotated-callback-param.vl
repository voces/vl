// @run
// A `.map` building fresh records, consumed by a later `.map` or `.filter` whose callback
// annotates its parameter at a closed record, is typed there, directly or through a binding.
function id(a) { return a }
function deliver() { return [{ f: id }] }
const v: { f: (a: f64) => f64 }[] = deliver().map((r) => ({ f: r.f })).map((q: { f: (a: f64) => f64 }) => ({ f: q.f }))
print(v[0].f(2.5))
const m = deliver().map((r) => ({ f: r.f }))
const w: { f: (a: f64) => f64 }[] = m.map((q: { f: (a: f64) => f64 }) => ({ f: q.f }))
print(w[0].f(1.5))
const u = deliver().map((r) => ({ f: r.f })).filter((q: { f: (a: f64) => f64 }) => q.f(0.5) > 0)
print(u[0].f(3.5))
// @log 2.5
// @log 1.5
// @log 3.5
