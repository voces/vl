// @run
// @log 3
// @log 4
// @log 3
// @log 4
// A generic (un-annotated-param) function handed to an un-annotated callback parameter that is
// called at two signatures stays generic, and each call instances it at its own (D5611): `add`
// runs at (i32, i32) and at (f64, f64) through `g` as it does by name. The refusal that named
// those signatures, for a callback that cannot take a parameter per type, is
// `error-generic-fn-value-inferred-hof-default-param.vl`.
function add(a, b) { return a + b }
function apply2(g) {
  print(g(1, 2))
  print(g(1.5, 2.5))
}

print(add(1, 2))
print(add(1.5, 2.5))
apply2(add)
