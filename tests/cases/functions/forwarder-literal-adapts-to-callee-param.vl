// @run
// @log 4
// @log 6
// @log 5
// @log 3
// @log 4.5
// A list literal handed through a forwarder is built at the parameter of the callee it reaches,
// nested lists at that parameter's element, at each hole binding (D14120).
function nest(a: i32, b: f64[]) { a + b.length }
function nest2(a: i32, b: f64[][]) { a + b[0].length + b.length }
function fwdA(g, x, y) { return g(x, y) }
function outerB(v) { return fwdA(nest, 3, [v]) }
function outerC(v) { return fwdA(nest2, 3, [[v, v]]) }
function outerD(v) { return fwdA(nest, 3, [v, 2]) }
function sumF(b: f64[]) {
  let s = 0.0
  for x in b { s = s + x }
  s
}
function fwdS(y) { return sumF(y) }
function outerE(v) { return fwdS([v, 2]) }
print(outerB(1))
print(outerC(1))
print(outerD(1))
print(outerE(1))
print(outerE(2.5))
