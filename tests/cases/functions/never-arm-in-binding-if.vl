// @run
// @log 4
// @log 5
// @log hi
// A nullable and a union binding whose `if` else arm calls a user `never` function: the arm is
// that call, followed by nothing, and the value path stores the binding.
type A = { a: i32 }
type B = { b: string }
function fail(m: string): never { __trap__(m) }
function opt(c: boolean, n: i32) {
  const v: i32 | null = if c { n } else { fail("no value") }
  return v ?? 0
}
function pick(c: boolean, x: A) {
  const u: A | B = if c { x } else { fail("no arm") }
  if u is A { return u.a }
  return 0
}
function word(c: boolean, s: string) {
  const w: string | null = if c { s } else { fail("no word") }
  return w ?? ""
}
print(opt(true, 4))
print(pick(true, { a: 5 }))
print(word(true, "hi"))
