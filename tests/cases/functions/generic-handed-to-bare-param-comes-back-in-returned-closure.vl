// @run
// @log 3
// @log x
// A generic handed to a callee's bare-only parameter comes back to the caller in a closure the callee
// returns, which calls it at another type: the set stays tagged through the hand-back, so each
// call dispatches to its own instance.
function same<T>(k: T): T { return k }
function wrap<G>(g: G) { return () => g }
function mid<F>(a: F) {
  const w = wrap(a)
  print(w()(3))
  print(a("x"))
}
mid(same)
