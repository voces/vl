// @run
// @log 4
// @log 4
// A record literal returned from a function whose inferred result is a declared twin of it (a
// nullable record field beside a non-null one), cell `in-list`: built at the result's row and rep,
// or, where a nested literal sits at another rep, a named miss (return coercion).
type J = { f: i32 }
type K = { j: J | null }
type L = { l: K[] }
function mk() { return { l: [{ j: { f: 4 } }] } }
const y = mk()
print(y.l[0].j.f)
const w: L = mk()
print(w.l[0].j?.f ?? 0)
