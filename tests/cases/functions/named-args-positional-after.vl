// @run
// @log 32
// @log 32
// @log 115
// @log 157
// @log 147
// @log 123
// @log 512
// @log 512
// @log 2
// @log 2
// A positional argument lands at its written index (D4061), so it may follow named arguments
// that each sit in their own parameter's position, and a named argument may come after the
// positional ones that fill the parameters before it. The receiver of a method call is
// position 0, so the first argument in the parentheses is position 1, as `c` is.
function box(w: i32, h: i32) { w * 10 + h }
print(box(w: 3, 2))
print(box(3, h: 2))

function f(a: i32, b: i32 = 1, c: i32 = 2) { a * 100 + b * 10 + c }
print(f(1, c: 5))
print(f(a: 1, b: 5, 7))
print(f(a: 1, 4, c: 7))

function g3(a: i32, b: i32, c: i32) { a * 100 + b * 10 + c }
print(g3(1, c: 3, b: 2))

function m(self: i32, c: i32, d: i32) { self * 100 + c * 10 + d }
print((5).m(c: 1, 2))
print((5).m(1, d: 2))

function pick<T>(a: T, b: T): T[] { [b, a] }
print(pick(a: 3, 2)[0])
print(pick(3, b: 2)[0])
