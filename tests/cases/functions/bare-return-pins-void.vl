// @run
// @log 2
// @log 1
// @log 3
// @log 4
// @log 7
// @log 2
// @log 9
// @log 1
// @log ok
// @log 5
// @log 1
// @log 6
// @log 5
// @log 7
// @hint redundant type annotation: `keeps` is inferred as `i32` — remove it to lean on inference
// A bare `return` anywhere in a body pins the function's return type to void, whatever the
// tail yields, and the tail is then lowered in statement position (D1600). The rule is the
// checker's: `blockHasBareReturn` decides the inferred return and `computeVoidFns` asks the
// same predicate for the functype, so a caller cannot be checked against a type the emitted
// function does not have.
//
// The consumer report is the first block: a tally whose loop returns early and whose tail is
// a direct `count.push(1)`. `.push` is typed `i32`, so the inferred return of a function
// ending in one is `i32`, and the guard `return` had nowhere to lower.
//
// `keeps`'s `: i32` is declared redundant rather than removed: the control's whole point is a
// function that genuinely returns a value, and writing that down is how a reader sees it.
// `count` carries an annotation the consumer's own spelling does not, for a reason that has
// nothing to do with this rule: `count[name] += 1` reads an element the list has not pinned
// yet, and the binding's type then renders `<error>[]` while the program checks and runs.
// The row's repro is the un-annotated original; `seen` keeps that face here.

const seen = []
const count: i32[] = []
function note(name: i32) {
  for i in 0 to seen.length - 1 {
    if seen[i] == name {
      count[i] += 1
      return
    }
  }
  seen.push(name)
  count.push(1)
}
note(7)
note(7)
print(count[0])
print(seen.length)

// One tail shape per rep, each with the bare `return` in a different place.

// a scalar expression, guard at the top
function tScalar(n: i32) {
  if n < 0 { return }
  n + 2
}
tScalar(1)
print(3)

// a bare name, guard inside a nested `for`
const four = 4
function tName(n: i32) {
  for i in 0 to 1 {
    if i == n { return }
  }
  four
}
tName(0)
print(four)

// a struct literal, guard in a `while`
type P = { a: i32 }
function tStruct(n: i32) {
  let w = 0
  while w < 1 {
    w = w + 1
    if n == 9 { return }
  }
  { a: n }
}
tStruct(7)
print(7)

// an `if`/`else` expression tail, guard in the `else` arm
function tIfElse(n: i32) {
  if n == 1 {
    print(2)
  } else {
    return
  }
  if n > 0 { 1 } else { 2 }
}
tIfElse(1)

// an else-less `if` tail (the shape that infers `T | null`), guard nested two deep
function tElseLess(n: i32) {
  if n == 1 {
    for i in 0 to 1 {
      if i == 9 { return }
    }
  }
  if n > 0 { 9 }
}
tElseLess(1)
print(9)

// a value-returning member call tail, guard in a `for`-in
const zs = [1, 2, 3]
function tSlice(n: i32) {
  for e in [1, 2] {
    if e == n { return }
  }
  zs.slice(0, 2)
}
tSlice(9)
print(1)

// a string tail and an assignment tail
let m = 0
function tStr(n: i32) {
  if n < 0 { return }
  "ok"
}
tStr(1)
function tAssign(n: i32) {
  if n < 0 { return }
  m = 5
}
tAssign(1)
print("ok")
print(m)

// a list literal tail, and a call tail whose callee returns a value
function g() { 6 }
function tList(n: i32) {
  if n < 0 { return }
  [n, n]
}
tList(1)
print(1)
function tCall(n: i32) {
  if n < 0 { return }
  g()
}
tCall(1)
print(g())

// The controls: a function with no bare `return` keeps its inferred value return, and an
// explicit `: void` beside a bare `return` is untouched by the rule.
function keeps(n: i32): i32 {
  if n == 0 { return 5 }
  7
}
function annotated(n: i32): void {
  if n < 0 { return }
  n + 1
}
annotated(1)
print(keeps(0))
print(keeps(1))
