// @run
// @log 3
// @log 4
// @log 3
// @log 4
// @log 3
// @log 4
// @log true
// @log true
// @log false
// A one-element list of a hole function, called through its element and through a `for`'s loop
// variable that is also compared, handed a generic called through it at two signatures: the
// comparison reads the declaration's identity and calls nothing, so the hole still takes a
// parameter per signature (D7180). `apply2`'s own name and a different function compare too.
function add(a, b) { return a + b }
print(add(1, 2))
print(add(1.5, 2.5))
function apply2(g) {
  print(g(1, 2))
  print(g(1.5, 2.5))
}
const fs = [apply2]
fs[0](add)
for f in fs { f(add); print(f == apply2) }
print(apply2 == apply2)
print(apply2 != apply2)
