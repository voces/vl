// @run
// @log 3
// @log 4
// @log 3
// @log 4
// @log 3
// @log 4
// A hole function read out of a list into a `const` alias, or out of a record field, and handed
// a generic it calls at two types is split like a call by name (D6790, D6791).
function add(a, b) { return a + b }
function apply2(g) {
  print(g(1, 2))
  print(g(1.5, 2.5))
}
function apply3(g) {
  print(g(1, 2))
  print(g(1.5, 2.5))
}
const fs = [apply2]
const h = fs[0]
h(add)
const rs = { k: apply2, m: apply3 }
rs.k(add)
rs.m(add)
