// @emit-error exported function `id` is generic over `T` and nothing in the program calls it
// D12211: an exported generic that is read as a value but never called has no instance, so
// the host's entry has no signature. The checker passes it because something reads `id`;
// the emitter refuses it. The checker owes this refusal.
export function id<T>(x: T): T { x }
const g = id
print(1)
