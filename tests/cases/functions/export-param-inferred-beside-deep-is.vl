// @run
// @log 0
// @hint `x` inferred as i32 from `const y: … = x`; annotate to freeze the export
// A deep `is` re-checks the program with its generated walkers spliced in, and that check keeps
// the export parameter's inferred pin: the hint is the one the program gets without the `is`,
// and `y`'s annotation, the parameter's only pin, is not reported redundant (D5490).
type Json = null | boolean | f64 | string | Json[] | { [string]: Json }
type Cfg = { port: i32, host: string | null }
export function g(x) {
  const y: i32 = x
  y
}
function a(r: Json) {
  if r is Cfg { return r.port }
  0
}
const m: { [string]: Json } = Map()
print(a(m))
