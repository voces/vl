// @check
// @error-at 6:18 cannot assign i32 to 'y' of type string
// A call through a binding that holds an un-annotated maker's call has the lambda's result at the
// maker call's pins, which a `string` destination refuses (D16798).
function adder(n) { return (a) => a + n }
const v = adder(2)
const y: string = v(3)
print(y)
