// @run
// A `.map` callback returning a fresh record is typed at the element the destination closes and
// built there; an identity map over closed records shares them, so a write through it is seen
// through the source (D17793).
function id(a) { return a }
function deliver() { return [{ f: id }] }
const v: { f: (a: f64) => f64 }[] = deliver().map((r) => ({ f: r.f }))
print(v[0].f(2.5))
function inc(a: f64): f64 { return a + 1 }
function closed() { return [{ f: inc }] }
const x = closed()
const ys: { f: (a: f64) => f64 }[] = x.map((r) => r)
ys[0].f = (a: f64): f64 => a * 2
print(x[0].f(2.5))
// @log 2.5
// @log 5
