// @run
// @log 5
// @log 5
// @log 5
// @log 1
// @log 6
// D1589 — AN ELSE-LESS TAIL `if c { x = 5 }` OVER A BOXED CELL. The `if` is a valued return
// (`T | null`), an assignment's value is its TARGET CELL, and here that cell is the value-
// union BOX — so the re-read `emitBinExprNode` pushes IS the result the functype declares.
// `exprUnion` did not answer for an assignment node, so `emitUnionCoerce` read it as an
// unclassified scalar and `struct.new`'d the box into an i32 payload field: check-clean
// invalid wasm inside the function itself, before any caller was reached.
// Three cells: the annotated `i32 | null` spelling, the un-annotated hole that D1576 fills to
// the same type, and a non-nullable value union.
function annotated(c: boolean) {
  let x: i32 | null = null
  if c { x = 5 }
}

function hole(c: boolean) {
  let x = null
  if c { x = 5 }
}

function valueUnion(c: boolean) {
  let x: i32 | string = 1
  if c { x = 5 }
}

function noCaller(c: boolean) {
  let x: i32 | null = null
  if c { x = 6 }
}

print(annotated(true) ?? 0)
print(hole(true) ?? 0)
const vu = valueUnion(true)
if vu is i32 { print(vu) } else { print(0) }
print(annotated(false) ?? 1)
print(noCaller(true) ?? 0)
