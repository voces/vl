// @run
// @log 2
// @log 2.5
// @log 6
// @log 6.5
// Two functions' returned records whose fields are widened to two sets sharing members dispatch
// each set by tag (D15278).

function id0(a) { return a }
function id1(a) { return a }
function id2(a) { return a }
function mkA() { return { f: id1 } }
const r = mkA()
r.f = id0
print(r.f(2))
print(r.f(2.5))
function mkD() { return { f: id1 } }
const rd = mkD()
rd.f = id0
rd.f = id2
print(rd.f(6))
print(rd.f(6.5))
