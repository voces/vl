// @error argument 1: expected A, got {k: string, w: string}
// The value of `d = both` is the adapter stored at `d`'s signature, so calling it with a `B`
// is refused, as a call through `d` or a lambda literal assigned there is (D3866).
type A = { k: "a", v: i32 }
type B = { k: "b", w: string }
const both = (p: A | B): i32 => {
  if p.k == "a" { p.v } else { 7 }
}
let d: (p: A) => i32 = (p: A): i32 => 0
const g = () => {
  d = both
}
const r = g()
print(r({ k: "b", w: "z" }))
