// @run
// @log 3
// @log 6
// Controls for D12332: the record a write reaches through a sharing container is called
// through its first binding, so the export has an instance and runs.
export function id<T>(x: T): T { x }
const inner = { f: id }
const r = { a: inner }
r.a.f = id
print(inner.f(3))
const inner2 = { f: id }
const fs = [inner2]
fs[0].f = id
print(inner2.f(6))
