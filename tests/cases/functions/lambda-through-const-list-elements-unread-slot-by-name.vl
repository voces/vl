// @run
// @log 3
// @log 4
// @log 3
// The lambda handed by name: one `const` bound to it reaches both elements (D12472).
function apply2(g) { print(g(1, 2)) }
function apply3(g) {
  print(g(1.5, 2.5))
  print(g(1, 2))
}
const gs = [apply2, apply3]
const add = (a, b) => a + b
gs[0](add)
gs[1](add)
