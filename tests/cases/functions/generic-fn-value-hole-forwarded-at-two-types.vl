// @run
// @log x
// @log 3
// @log x
// @log 3
// @log x
// @log 3
// @log x
// @log 3
// A generic handed to an un-annotated parameter stays generic, so forwarding it to two holes
// that call it at two types instances it at each (D5611). The parameter takes one parameter per
// type and the call hands the value once per parameter. Spelled with an explicit type
// parameter, delivered through a second forwarding hole, and inside a block-local function.
function same<T>(k: T): T { k }
function take(a) { print(a("x")) }
function take2(a) { print(a(3)) }
function mid(a) {
  take(a)
  take2(a)
}
mid(same)

function midT<F>(a: F) {
  take(a)
  take2(a)
}
midT(same)

function outer(b) { mid(b) }
outer(same)

function main() {
  function local(a) {
    take(a)
    take2(a)
  }
  local(same)
}
main()
