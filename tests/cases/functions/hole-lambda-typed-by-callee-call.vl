// @run
// @log -4
// @log 6
// @log -2.5
// @log -4
// @log -4
// @log 15
// @log -3
// A lambda argument to a hole parameter the callee calls takes its parameter types from the
// arguments of that call, as a named generic function in its place does.
function lap(g, x) { return g(x) }
print(lap((n) => 0 - n, 4))

function apply(f) { return f(3) }
print(apply((n) => n * 2))

print(lap((n) => 0 - n, 2.5))

// The callee a `const` lambda, and a written `let` lambda.
const lapC = (g, x) => g(x)
print(lapC((n) => 0 - n, 4))

let lapL = (g, x) => g(x)
lapL = (g, x) => g(x) + 0
print(lapL((n) => 0 - n, 4))

// The result delivered to a binding, and as an argument to an annotated parameter.
const r = lap((n) => n * 3, 5)
print(r)

function show(v: i32) { print(v) }
show(lap((n) => 1 - n, 4))
