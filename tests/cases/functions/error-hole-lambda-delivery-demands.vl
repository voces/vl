// @check
// @error 'toString' is not imported
// @error `g` cannot be delivered as (P) => i32: its body uses parameter 1 as {x: _}, got P
// @error `k` cannot be delivered as (i32) => i32: its body indexes parameter 1, and i32 cannot be indexed
// A function value whose parameters are holes, delivered at a concrete function type, has its
// body's demands judged at that type, as a direct call through it would (D5932).
function name(b: (n: i32) => string): string { b(7) }
const f = (n) => "v" + n.toString()
print(name(f))

type P = { y: i32 }
function useP(b: (p: P) => i32): i32 { b({ y: 5 }) }
const g = (p) => p.x + 1
print(useP(g))

function useI(b: (xs: i32) => i32): i32 { b(4) }
const k = (xs) => xs[1]
print(useI(k))
