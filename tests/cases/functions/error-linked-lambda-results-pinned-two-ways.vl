// @error cannot assign () => string[] to () => i32[]
// Two lambdas whose `[]` results meet at a store build one list, so a use pinning each
// result to a different element is refused at the store, as the annotated twin is.
const a = () => []
let b = () => []
b = a
const m = b()
m.push(1)
const n = a()
n.push("s")
print(m.length)
