// @error push: cannot add string to i32[]
// Two lambdas whose `[]` results meet at a store build one list: its element is one hole, so the
// first push pins it and the second, conflicting push is refused, as on an annotated `i32[]`.
const a = () => []
let b = () => []
b = a
const m = b()
m.push(1)
const n = a()
n.push("s")
print(m.length)
