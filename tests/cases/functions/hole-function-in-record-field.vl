// @run
// @log true
// @log s
// @log 4
// @log 6
// @log 3
// @log true
// An un-annotated function stored in a record field takes the instance its field's type pins, and
// the field's call runs that instance, inline or through a binding.
function g(a) { return a }
function inc(a) { return a + 1 }
function twice(a) { return a * 2 }

function run() {
  print({ f: g, n: 1 }.f(true))
  print({ f: g, n: "x" }.f("s"))
}

function bound() {
  const r = { f: twice }
  const h = r.f
  return h(3)
}

run()
print({ f: inc }.f(3))
print(bound())
print({ f: g, n: 1 }.f(3))
print({ f: g, n: 1 }.f(true))
