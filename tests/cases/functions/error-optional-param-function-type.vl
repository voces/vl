// @check
// @error `?` does not apply to a function type
// `?` desugars to a `| null` suffix, and a bare suffix on a FUNCTION type binds
// into the RESULT (`(i32) => i32 | null` is a function returning a nullable
// i32). `?` has nowhere to put the grouping parens that would fix that, so it
// is rejected rather than quietly meaning the other thing.
function f(g?: (i32) => i32): i32 { 1 }
print(f())
