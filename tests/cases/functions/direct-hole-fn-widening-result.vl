// @run
// @log 1.5
// @log 1.5
// @log 3.75
// @log 2.5
// @log 3.5
// @log 0.5
// @log 1.75
// @log 0.75
// @log 1.5
// @log 1.5
// @log 1.5
// A direct call of an un-annotated function widening `i32` to `f64` is typed at the result its
// body gives at the argument, in every delivery position (D8161).
function half(a) { return a / 2.0 }
function take(x: f64) { print(x * 2.5) }
function ret() { return half(5) }
function scaled(k: i32, a) { return a / 2.0 + k - k }
const lam = (a) => a / 2.0
const r = half(3)
print(r)
const f = half
print(f(3))
take(half(3))
print(ret())
const o = { v: half(7) }
print(o.v)
const xs = [half(1)]
print(xs[0])
let w = half(3)
w = w + 0.25
print(w)
print(half(half(3)))
print(scaled(1, 3))
print(lam(3))
function main() {
  function local(a) { return a / 2.0 }
  print(local(3))
}
main()
