// @run
// @log 7
// @log 3.5
// @log 5.5
// @log ab
// @log 7
// @log 11
// @log 17
// The RECEIVER's definition form is not an axis: a HOF spelled `const apply = (g: (i32,i32) =>
// i32, …) => …` pins a function value exactly as `function apply(g: (i32,i32) => i32, …)` does.
// Both declare the identical parameter type, and only the `function` spelling used to be heard —
// the argument coercion read the callee's parameters through the name→slot map, and an arrow
// lambda parses to a NAMELESS `FuncDecl` whose name lives on the BINDING, so an arrow receiver
// presented no parameter list at all and the emit-time value floor refused the value.
// `monoFnFeOfIdent` is the one resolver both halves go through.
function padd(a, b) { return a + b }
function pmix(n: i32, x) { return x + n }
function pjoin(s: string, t) { return s + t }
function pidT<T>(a: T, b: T): T { return a + b }

// An arrow `const` receiver — the filed spelling.
const applyC = (g: (i32, i32) => i32, x: i32, y: i32) => g(x, y)
// An arrow `let` receiver, REASSIGNED to a second arrow of the same declared type. Its callback
// HOLE is a DIFFERENT type from the value's written annotation, so the pin is doing real work
// rather than riding the i32 default a hole would otherwise take.
let applyL = (g: (i32, f64) => f64) => g(1, 2.5)
// A BLOCK-bodied arrow receiver.
const applyB = (g: (string, string) => string) => {
  return g("a", "b")
}
// An arrow receiver carrying its own declared RETURN type.
const applyR = (g: (i32, i32) => i32, x: i32, y: i32): i32 => g(x, y)

print(applyC(padd, 3, 4)) // 7
print(applyL(pmix)) // 2.5 + 1 = 3.5
applyL = (g: (i32, f64) => f64) => g(2, 3.5)
print(applyL(pmix)) // 3.5 + 2 = 5.5, the reassigned arrow's own body
print(applyB(pjoin)) // ab
print(applyR(pidT, 3, 4)) // an explicit `<T>` value, bound by the arrow's parameter type

// A NESTED arrow receiver: the resolver walks the scope chain for a named function and the
// binding chain for a lambda, so a receiver declared inside a frame is reached the same way.
function goNested() {
  const applyN = (g: (i32, i32) => i32, x: i32, y: i32) => g(x, y)
  return applyN(padd, 5, 6)
}
print(goNested()) // 11

// Two function-typed parameters on ONE arrow receiver, at two different pins of the same
// un-annotated value: the parameter list is read once per call, not once per argument.
const applyTwo = (f: (i32, i32) => i32, g: (i32, i32) => i32, x: i32, y: i32) => f(x, y) + g(x, y)
function pmul(a, b) { return a * b }
print(applyTwo(padd, pmul, 2, 5)) // 7 + 10
