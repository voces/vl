// @run
// @log 5.5
// @log 3
// One maker call handed straight to its destination and one bound and handed on at another
// function type each build their own copy of the maker's lambda (D16851).
function mk() { return (a) => a + 2.5 }
function take(a: (a: i32) => f64) { print(a(3)) }
function half(a: (a: f64) => f64) { print(a(0.5)) }
take(mk())
const z = mk()
half(z)
