// @error print expects a value, got void — `get` ends in a call with no `return`: write `return` before its last expression
// A function with no annotation whose block body ends in a call returns nothing, so a caller
// using its result is refused, naming the function whose last call lacks its `return`.
function compute(x: i32): i32 { return x * 2 }
function get(x: i32) {
  const y = x + 1
  compute(y)
}
print(get(3))
