// @error operator '+' is not defined for boolean and i32
// A call through the binding binds a written generic's type parameter through `A | null` (D3968).
function s<A>(a: A | null) { print("S") }
function w<A>(a: A | null) {
  if a != null { print(a + 1) }
}
function main() {
  let k = s
  k = w
  k(true)
}
main()
