// @error-at 11:9 return type mismatch: expected void, got i32
// DECISIONS (void-discard): an EXPLICIT `return expr` where void is expected stays
// a type error — it states an intent the compiler holds the author to — and the
// diagnostic ANCHORS AT the return, not at the call's closing token and not at the
// function header. Same arm, message and anchor as the declared spelling
// `function f(): void { return 7 }` has always produced.
function g(cb: () => void) {
  cb()
}
g(() => {
  print(1)
  return 7
})
