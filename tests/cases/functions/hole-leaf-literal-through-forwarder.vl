// @run
// @log 4
// @log 17
// @log 2.5
// @log 3
// @log z4
// @log 4
// @log 5
// @log 6
// @log 2.5
// @log 2.5
// @log 2.5
// A list or record literal with an un-annotated parameter among its leaves, handed on through
// a forwarder to a typed function, is built at the type that function takes (D5930).
import { toString } from "std:fmt"

function nest(a: i32, b: f64[][]) { a + b.length }
function nestI(a: i32, b: i32[][]) { a + b.length * 10 }
function fwdA(g, x, y) { return g(x, y) }
function outerA(h, v) { return fwdA(h, 3, [[v]]) }
print(outerA(nest, 1))
print(outerA(nest, 1) + outerA(nestI, 1))

function flat(a: i32, b: f64[]) { b[a - 3] * 2.5 }
function fwdB(g, x, y) { return g(x, y) }
function outerB(h, v) { return fwdB(h, 3, [v]) }
print(outerB(flat, 1))

function sum2(a: i32, b: f64[]) { b[a - 3] + b[a - 2] }
function fwdC(g, x, y) { return g(x, y) }
function fwdC2(g, x, y) { return fwdC(g, x, y) }
function outerC(h, v) { return fwdC2(h, 3, [v, 2]) }
print(outerC(sum2, 1))

function rec(a: i32, b: {p: f64, q: string}) {
  if a > 0 { b.q + b.p.toString() } else { "" }
}
function fwdD(g, x, y) { return g(x, y) }
function outerD(h, v) { return fwdD(h, 3, { p: v, q: "z" }) }
print(outerD(rec, 4))

function maybe(a: i32, b: f64[] | null) {
  if b == null { 0 } else { a + b.length }
}
function fwdE(g, x, y) { return g(x, y) }
function outerE(h, v) { return fwdE(h, 3, [v]) }
print(outerE(maybe, 1))

function ragged(a: i32, b: f64[][]) { b[a - 2][a - 2] * 2.5 }
function fwdF(g, x, y) { return g(x, y) }
function outerF(h, v) { return fwdF(h, 3, [[v], [v, v]]) }
print(outerF(ragged, 2))

function wide(a: i32, b: i64[]) { b[a - 3] + 1 }
function fwdG(g, x, y) { return g(x, y) }
function outerG(h, v) { return fwdG(h, 3, [v]) }
print(outerG(wide, 5))

function flatH(a: i32, b: f64[]) { b[a - 3] * 2.5 }
function fwdH(g, x, y) { return g(x, y) }
function outerH(h, v) { return fwdH(h, 3, [v]) }
print(outerH(flatH, 1))
print(outerH(flatH, 1.0))

function flatI(a: i32, b: f64[]) { b[a - 3] * 2.5 }
function fwdI<G, Y>(g: G, x: i32, y: Y) { return g(x, y) }
function outerI(h, v) { return fwdI(h, 3, [v]) }
print(outerI(flatI, 1))
