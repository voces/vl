// @run
// @hint Intentionally-unused parameter `_a`
// @log 2
// @log s
// @log 5
// @log s
// @log 3
// @log t
// @log 2
// @log s
// @log 2
// @log 1
// @log 2
// @log 2
// @log s
// @log 2
// @log s
// @log 2
// @log s
// @log 2
// A lambda literal handed to a hole the callee calls at two types takes one copy per type, as a
// declared function there does: beside a second parameter, with two parameters of its own, in
// parentheses, with its result read, at three types, to a `const` lambda callee, and to a
// function declared in another's body while capturing a written local (D6331).
function lap(g) {
  print(g(1) + 1)
  return g("s")
}
function lap2(g, x) {
  print(g(x) + 1)
  return g("s")
}
function lap3(g) {
  print(g(1, 2) + 1)
  return g("s", "t")
}
function lap4(g) {
  print(g(1) + 1)
  print(g([1, 2]).length)
  return g("s")
}
const clap = (g) => {
  print(g(1) + 1)
  return g("s")
}
print(lap((a) => a))
print(lap2((a) => a, 4))
print(lap3((_a, b) => b))
print(lap(((a) => a)))
print(lap((b) => b).length)
print(lap4((a) => a))
print(clap((a) => a))
function main() {
  let n = 0
  function nlap(g) {
    print(g(1) + 1)
    return g("s")
  }
  print(
    nlap((a) => {
      n = n + 1
      return a
    }),
  )
  print(n)
}
main()
