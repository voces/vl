// @run
// @log 4
// @log 4
// A hole parameter called on its own result and returned hands back the outer instance's
// result, for a hole function and an explicit generic alike (D6210).
function wrap(a) { return [a] }
function wrapT<T>(a: T) { return [a] }
function lapRet(g, x) { return g(g(x)) }
function lapRetT(g, x) { return g(g(x)) }
print(lapRet(wrap, 4)[0][0])
print(lapRetT(wrapT, 4)[0][0])
