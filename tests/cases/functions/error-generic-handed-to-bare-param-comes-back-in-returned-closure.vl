// @emit-error a generic function taken as a value reaches no call that fixes its type
// A generic handed to a callee's bare-only parameter comes back to the caller in a closure the callee
// returns, which calls it at another type: the refusal stands rather than building one instance for
// both types.
function same<T>(k: T): T { return k }
function wrap<G>(g: G) { return () => g }
function mid<F>(a: F) {
  const w = wrap(a)
  print(w()(3))
  print(a("x"))
}
mid(same)
