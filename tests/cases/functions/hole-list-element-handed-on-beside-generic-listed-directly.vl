// @run
// @log 8
// @log vv
// @log x
// @log 6
// @log ww
// @log 6
// A hole function listed at two types beside a generic listed directly to the same callee, which
// hands the element on to one calling it, runs each listing at its own set (D15622).
function id(v) { return v }
function dbl(v) { return v + v }
function call1(f, x) { print(f(x)) }
function call0(fs, x) { call1(fs[0], x) }
function run(g) {
  call0([g], 4)
  call0([g], "v")
}
run(dbl)
call0([id], "x")
function mid(fs, x) { print(fs[0](x)) }
function whole(fs, x) { mid(fs, x) }
function runWhole(g) {
  whole([g], 3)
  whole([g], "w")
}
runWhole(dbl)
whole([id], 6)
