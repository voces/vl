// @check
// @error cannot assign f64 to 'b' of type string
// The call's result is the callee's body read at each call's instance, so a destination of
// another type is refused, as the direct spelling is (D15648).
function dbl(v) { return v + v }
function c2(r, x) { return r(x) + r(1) }
function both2(g) { return c2(g, 2.5) }
const b: string = both2(dbl)
print(b)
