// @run
// @log 13
// @log 17
// @log 6
// @log 5
// A forwarder's literal reached first by the i32 instance is still built at f64 for the other
// (D15288).
function nest(a: i32, b: f64[][]) { a + b.length }
function nestI(a: i32, b: i32[][]) { a + b.length * 10 }
function fwdA(g, x, y) { return g(x, y) }
function outerA(h, v) { return fwdA(h, 3, [[v]]) }
print(outerA(nestI, 1))
print(outerA(nestI, 1) + outerA(nest, 1))
function ragged(a: i32, b: f64[][]) { b[a - 2][a - 2] * 2.5 }
function raggedI(a: i32, b: i32[][]) { b[a - 2][a - 2] * 3 }
function fwdF(g, x, y) { return g(x, y) }
function outerF(h, v) { return fwdF(h, 3, [[v], [v, v]]) }
print(outerF(raggedI, 2))
print(outerF(ragged, 2))
