// @run
// @log 0
// @log x
// @log 1
// @log x
// The same hand-on with the calls and declarations in the other order.
function same<T>(k: T): T { k }
function mid<F>(a: F, b: F, n: i32) {
  if n > 0 { other(b, a, n - 1) }
  print(b(n))
  print(a("x"))
}
function other<G>(a: G, b: G, n: i32) {
  print(b(n))
  print(a("x"))
}
mid(same, same, 1)
