// @run
// @log 1
// @log 5
// @log 5
// An inferred `{q: i32}[] | i32` return, which no recorder names for the emitter, is lowered as
// its annotated twin (D16171's family).
function mk(c: boolean) {
  if c { return [{ q: 1 }] }
  return 5
}
function go(c: boolean) {
  const r = mk(c)
  if r is i32 { print(r) }
}
go(true)
const r = mk(true)
if r is {q: i32}[] { print(r[0].q) } else { print(0) }
const t = mk(false)
if t is i32 { print(t) }
go(false)
