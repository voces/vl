// @run
// @log -4
// @log -4
// @log -2.5
// @log -3
// @log -7
// @log -4
// @warning Unused parameter `g`
// A generic function handed to a written `let` lambda whose initializer never calls that
// parameter takes its instance from the calls the later writes make, the second write included.
function neg(a) { return 0 - a }

let lap = (g, x) => x + 1
lap = (g, x) => g(x)
print(lap(neg, 4))

let lap2 = (g, x) => x + 1
lap2 = (g, x) => x + 2
lap2 = (g, x) => g(x)
print(lap2(neg, 4))

let lapF = (g, x) => x + 1
lapF = (g, x) => g(x)
print(lapF(neg, 2.5))

// The result delivered to a binding, and the call made twice.
let lapB = (g, x) => x + 1
lapB = (g, x) => g(x)
const r = lapB(neg, 4)
print(r + 1)
print(lapB(neg, 7))

// The annotated initializer spelling.
let lapA = (g: (i32) => i32, x: i32) => x + 1
lapA = (g, x) => g(x)
print(lapA(neg, 4))
