// @run
// @log 1
// @log 1
// @log 1
// @log 4
// @log 4
// @log 3
// @log 1
// @log 1
// @log 1
// @log 1
// @log vv4
// @log vv4
// A function handed to a hole parameter and called on its own result is emitted once per
// instance the calls ask for, whichever spelling holds the result (D6210, D6211).
function wrap(a) { return [a] }
function str(a) { return "v\{a}" }
function wrapT<T>(a: T) { return [a] }
function lap(g, x) {
  print(g(g(x)).length)
  return 0
}
function lapConst(g, x) {
  const y = g(x)
  print(g(y).length)
  return 0
}
function lapAnnot(g, x) {
  const r: i32[][] = g(g(x))
  print(r[0][0])
  return 0
}
function lapElem(g, x) {
  const xs = [g(g(x))]
  print(xs[0][0][0])
  return 0
}
function lapLet(g, x) {
  const r = g(g(x))
  print(r[0][0] + 0.5)
  return 0
}
function lap3(g, x) {
  print(g(g(g(x))).length)
  return 0
}
function lapTwo(g, g2, x) {
  const y = g(x)
  print(g2(y).length)
  return 0
}
function lapStr(g, x) { return g(g(x)) }
function lapStrConst(g, x) {
  const y = g(x)
  return g(y)
}
lap(wrap, 4)
lap(wrap, "s")
lapConst(wrap, 4)
lapAnnot(wrap, 4)
lapElem(wrap, 4)
lapLet(wrap, 2.5)
lap3(wrap, 4)
lapTwo(wrap, wrap, 4)
lap(wrapT, 4)
lap(wrap, true)
print(lapStr(str, 4))
print(lapStrConst(str, 4))
