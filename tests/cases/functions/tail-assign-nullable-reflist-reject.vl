// @emit-error ref valtype with no interned shape
// A tail assignment to a NULLABLE REF-ARRAY global (`S[] | null`, kind `nulreflist`) is
// the one cell kind `fnAssignRetKind` (`emit_classify.vl`) can NAME but the un-annotated
// functype path cannot yet SPELL: `emit_sections`' inferred-return arm resolves an
// `infSlot` for `struct` / `nulstruct` / `reflist` / `map` only, so a `nulreflist` result
// reaches `fbValtype` with slot -1 and is rejected there.
//
// PINNED AS A REJECT ON PURPOSE. On master this same program was `vl check`-clean (rc 0)
// and emitted a module that FAILED TO VALIDATE — silent invalid wasm. A loud emit-stage
// error is the strictly better outcome class, and this pin is what keeps it from sliding
// back. It GRADUATES to `@run` the moment `emit_sections` gains the one line its
// ANNOTATED sibling already has (`retNulRefArrFlag` → `tyAnnRefListSlot`); the annotated
// spelling `function c(): S[] | null { xs = null }` runs today.
type S = { n: i32 }

let xs: S[] | null = null

function clearXs() { xs = null }

clearXs()
print(9)
