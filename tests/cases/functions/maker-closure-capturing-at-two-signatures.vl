// @run
// @log 5
// @log 2.75
// @log 5
// A maker with an annotated parameter returns a hole lambda capturing it; each call delivered at
// its own function type builds its closure there, over its own argument (D16851, D16922).
function adder(n: f64) { return (a) => a + n }
function take(a: (a: i32) => f64) { print(a(3)) }
function half(a: (a: f64) => f64) { print(a(0.5)) }
const x = adder(2)
take(x)
const z = adder(2.25)
half(z)
const v: (a: i32) => f64 = adder(2)
print(v(3))
