// @run
// @log 37 7
// @log 38 7
// @log 39 7
// @log true
// @log 9 9
// @log 48 7
// @hint redundant type annotation: `where` is inferred as `string`
// @hint redundant type annotation: `pos` is inferred as `string`
// @hint Intentionally-unused parameter `_tag` (leading `_` marks it unused)
// `__callsite__` — the ONE default whose value is the CALL SITE rather than the
// declaration. It is legal only as a default value; everywhere else it is the
// refusal in `error-callsite-outside-default.vl`.
//
// THE `@log` LINES ARE ABSOLUTE LINE NUMBERS OF THIS FILE, which is the point
// rather than an accident — so EDITING THE PROSE ABOVE A CALL SHIFTS THEM, and
// re-running the case is how you find out. Adding a line to this comment block
// has already done it once.
//
// WHY THE VALUE IS PER-SITE AND THE NODE IS TOO. Every other v1 default form
// means the same thing at every call, so every other form SHARES one arena node.
// This one cannot, so `csPreMintLocs` (driver.vl) mints one location object per
// CALL — before `checkProgram` sizes `nodeTyIx`, because a node minted after that
// reads its type back as -1 forever (D969). From there it is an ordinary object
// literal: typed by the checker, collected and lowered by the emitter, with
// nothing downstream aware the argument was synthesized.
//
// The file is the CALLER's module key, so it is not asserted verbatim here (it
// is a path, and paths differ per checkout); the module case
// `modules/default-param-declaration-scope` asserts the attribution instead.
function where(
  _tag: string,
  c: { file: string, line: i32, col: i32 } = __callsite__,
): string {
  return `\{c.line} \{c.col}`
}
print(where("a"))
print(where("b"))
print(where("c"))
print(where("d").length > 0)

// SUPPLIED EXPLICITLY, it is an ordinary argument — the default is sugar for a
// value the caller could always have written.
function pos(c: { file: string, line: i32, col: i32 } = __callsite__): string {
  return `\{c.line} \{c.col}`
}
print(pos({ file: "hand", line: 9, col: 9 }))
print(pos())
