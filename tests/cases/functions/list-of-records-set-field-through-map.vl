// @run
// A generic function held in a fresh list of records and called at two signatures is a set's
// member: `.map` over the list types its lambda at the element, converts the field where the
// lambda's result closes it, and a whole delivery is copied through `.map` (D17775).
function id(a) { return a }
function deliver() { return [{ f: id }] }
const u = deliver()
print(u[0].f(2))
const a = deliver().map((r): { f: (a: f64) => f64 } => ({ f: r.f }))
print(a[0].f(2.5))
const b = deliver().map((r) => r.f(1.5))
print(b[0])
const c = deliver().map((r): (a: f64) => f64 => r.f)
print(c[0](3.5))
const d = deliver().map((r) => r.f)
print(d[0](4))
const e: { f: (a: f64) => f64 }[] = deliver()
print(e[0].f(0.5))
// @log 2
// @log 2.5
// @log 1.5
// @log 3.5
// @log 4
// @log 0.5
