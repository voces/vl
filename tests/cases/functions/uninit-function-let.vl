// @run
// @log 12
// @log 2
// @log 70
// @log 20
// @log 10
// @log 5
// @hint redundant type annotation: `b` is inferred as `{f: (i32) => i32}`
// A function-typed `let` with no initializer holds its closure in a nullable cell, since a
// write inside an `if` arm does not set a non-null local for the code after the `if`; every
// delivery of it reads the closure back (D3256). Asking for an aliased binding's source no longer
// traps the compiler on the missing initializer (D3353).
type Box = { f: (i32) => i32 }
function apply(g: (i32) => i32, v: i32) { g(v) }
function mkf(n: i32): (i32) => i32 {
  let y: (i32) => i32
  if n > 2 { y = (x: i32) => x + n } else { y = (x: i32) => x - n }
  y
}
function arms(n: i32) {
  let y: (i32) => i32
  if n > 2 { y = (x: i32) => x * n } else { y = (x: i32) => x - n }
  y(3)
}
function h(n: i32) {
  let y: (i32) => i32
  y = (x: i32) => x * n
  const b: Box = { f: y }
  const c = () => y(2)
  const ys = [y]
  let z = y
  z = y
  apply(y, 1) + b.f(3) + c() + ys[0](4) + z(5) + mkf(n)(6)
}
function labelled(n: i32) {
  const f = B: {
    if n > 2 { break :B (x: i32) => x + n }
    (x: i32) => x - n
  }
  f(6)
}
print(arms(4))
print(arms(1))
print(h(4))
print(h(1))
print(labelled(4))
print(labelled(1))
