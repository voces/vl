// @run
// @log 1
// @log 2
// @log 5
// @log 105
// @log 30
// @log 40
// @log 11
// @log 12
// @log 13
// @log 22
// @log 29
// @log -7
// @log 0
// @log 31
// @log 32
// @log 41
// @log 42
// @log A
// @log other
// @log 50
// @log -1
// @log 60
// @log 61
// @log 70
// @log 80
// @log 1
// @log 200
// @log 3
// @log 70
// @log 70
// @log 71
// @log 71
// @log 0
// @log 5
// @log 2
// @log one
// @log other
// @log after
// @log 9
// @log 10
// `return e` whose value is void, inside a function that returns nothing, calls `e` and then
// returns (D2635, plumb PL-045). One position per block; each prints what proves which arm ran.
function g(x: i32) { print(x) }
function gd(x: i32): void { print(x * 10) }

// an early return, in an inferred-void function (the report's shape)
function early(op: i32) {
  if op == 0 { return g(1) }
  g(2)
}
// the tail
function tail(op: i32) {
  g(op)
  return g(op + 100)
}
// a declared `: void`
function decl(op: i32): void {
  if op == 0 { return gd(3) }
  gd(4)
}
// both arms of a nested `if`
function nested(a: i32, b: i32) {
  if a > 0 {
    if b > 0 { return g(11) } else { return g(12) }
  }
  g(13)
}
// inside a `while` and a `for`-in
function loop(n: i32) {
  let i = 0
  while i < n {
    if i == 2 { return g(20 + i) }
    i = i + 1
  }
  g(29)
}
function forLoop(xs: i32[]) {
  for x in xs {
    if x < 0 { return g(x) }
  }
  g(0)
}
// beside a bare `return`
function mixed(op: i32) {
  if op == 0 { return }
  if op == 1 { return g(31) }
  g(32)
}
// every return a void return
function allVoid(op: i32) {
  if op == 0 { return g(41) }
  return g(42)
}
// a built-in void call, and a call through a void function value
function viaPrint(s: string) {
  if s == "a" { return print("A") }
  print("other")
}
function viaValue(f: (i32) => void, x: i32) {
  if x > 0 { return f(x) }
  print(-1)
}

early(0)
early(1)
tail(5)
decl(0)
decl(1)
nested(1, 1)
nested(1, 0)
nested(0, 0)
loop(5)
loop(1)
forLoop([1, -7, 3])
forLoop([1])
mixed(0)
mixed(1)
mixed(2)
allVoid(0)
allVoid(1)
viaPrint("a")
viaPrint("b")
viaValue(g, 50)
viaValue(g, 0)

// closures: inferred, annotated `: void`, a lambda argument to a void parameter, and a nested
// closure returned from by its enclosing function
const lam = (x: i32) => {
  if x > 0 { return g(60) }
  g(61)
}
lam(1)
lam(0)
const lamD = (x: i32): void => {
  if x > 0 { return gd(7) }
  gd(8)
}
lamD(1)
lamD(0)
function each(ys: i32[], f: (i32) => void) {
  for y in ys { f(y) }
}
each([1, 2, 3], (x) => {
  if x == 2 { return g(200) }
  g(x)
})
function outer(k: i32) {
  const inner = () => {
    if k > 0 { return g(70) }
    g(71)
  }
  inner()
  return inner()
}
outer(1)
outer(0)

// recursion under a declared `: void`, a generic, a `match` arm, and a parenthesised call
function down(n: i32): void {
  if n > 0 { return down(n - 1) }
  print(n)
}
down(3)
function ga<T>(x: T) { print(x) }
function gen<T>(x: T, c: boolean) {
  if c { return ga(x) }
  print(2)
}
gen(5, true)
gen("s", false)
function m(k: i32) {
  match k {
    1 => {
      return print("one")
    }
    _ => print("other")
  }
  print("after")
}
m(1)
m(2)
function par(op: i32) {
  if op == 0 { return (g(9)) }
  g(10)
}
par(0)
par(1)
