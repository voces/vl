// @run
// @log 3
// @log 4
// @log 5
// @log 6
// @log 7
// @log 8
// A call whose argument never returns is dead past that argument, at each position: a statement,
// a binding, a `print` argument, a returned value, an argument of another call, after an
// effect-free argument, and in a closure. Each runs on a branch not taken here.
function fail(): never { __trap__() }
function id(x) { return x }
function two(a: i32, b: i32) { return a + b }
function show(n: i32) { print(n) }
function stmt(n: i32) {
  if n > 9 { id(fail()) }
  print(n)
}
function bound(n: i32) {
  if n > 9 {
    const x: i32 = id(fail())
    print(x)
  }
  print(n)
}
function printed(n: i32) {
  if n > 9 { print(id(fail())) }
  print(n)
}
function returned(n: i32) {
  if n > 9 { return id(fail()) }
  return n
}
function nested(n: i32) {
  if n > 9 { show(id(fail())) }
  print(n)
}
function after(n: i32) {
  if n > 9 { two(1, fail()) }
  print(n)
}
stmt(3)
bound(4)
printed(5)
print(returned(6))
nested(7)
after(8)
