// @error cannot assign boolean to i32
// A call at the type parameter of a generic declared above the binding is re-asked by each of
// its instances (D3967).
function inner<U>(u: U) { print(u) }
function cI32(n: i32) { print(n) }
function useK<T>(x: T) { k(x) }
let k = inner
k = cI32
useK(7)
useK(true)
