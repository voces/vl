// @run
// @log 3
// @log 4
// @log 3
// @log 3
// @log 4
// @log 3
// @hint Intentionally-unused parameter `_g2` (leading `_` marks it unused)
// Two elements of a constant function list each called with a lambda, one of them at two
// instances: a handed-out copy its slot never calls takes the unread default (D12472).
function apply2(g) { print(g(1, 2)) }
function apply3(g) {
  print(g(1.5, 2.5))
  print(g(1, 2))
}
const gs = [apply2, apply3]
gs[0]((a, b) => a + b)
gs[1]((a, b) => a + b)
function pair2(g, _g2) { print(g(1, 2)) }
function pair3(g, g2) {
  print(g2(1.5, 2.5))
  print(g(1, 2))
}
const ps = [pair2, pair3]
ps[0]((a, b) => a + b, (a, b) => a + b)
ps[1]((a, b) => a + b, (a, b) => a + b)
