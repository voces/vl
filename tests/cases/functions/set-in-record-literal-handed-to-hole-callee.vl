// @run
// @log 3
// @log 6
// @log 3
// @log 2.5
// @log 9
// @log 10
// @log 14
// @log -7
// @log 3
// @log 6
// @log 6
// @log -3
// @log -3
// @log -1
// @log -3
// @log -1
// @log s
// A choice of named functions held by a `const`, handed as a record literal's field to a callee
// that calls the field, dispatches by tag in that callee (D15641).
function id(v) { return v }
function dbl(v) { return v + v }
function neg(v) { return 0 - v }
function call0(r, x) { print(r.f(x)) }
function callN(r, x) { print(r.f(x) + r.n) }
function call1(f, x) { print(f(x)) }
function callFwd(r, x) { call1(r.f, x) }
function call2(r, x) {
  print(r.f(x))
  print(r.h(x))
}
function callL(xs, x) { print(xs[0](x)) }
function keep(f: (i32) => i32) { print(f(1)) }
function run(b) {
  const g = if b { id } else { dbl }
  call0({ f: g }, 3)
}
run(true)
run(false)
function twoTypes(b) {
  const g = if b { id } else { dbl }
  call0({ f: g }, 3)
  call0({ f: g }, 2.5)
}
twoTypes(true)
function withField(b) {
  const g = if b { id } else { dbl }
  callN({ f: g, n: 1 }, 4)
}
withField(false)
function handedOn(b) {
  const g = if b { id } else { dbl }
  callFwd({ f: g }, 5)
}
handedOn(false)
function twoSets(b) {
  const g = if b { dbl } else { neg }
  call0({ f: g }, 7)
}
twoSets(true)
twoSets(false)
function twoFields(b) {
  const g = if b { id } else { dbl }
  const h = if b { dbl } else { neg }
  call2({ f: g, h: h }, 3)
}
twoFields(true)
twoFields(false)
// The choice also delivered to a closed function type is its member's closure there.
function delivered(b) {
  const g = if b { id } else { neg }
  call0({ f: g }, 3)
  keep(g)
}
delivered(false)
function deliveredInList(b) {
  const g = if b { id } else { neg }
  callL([g], 3)
  keep(g)
}
deliveredInList(false)
function atString(b) {
  const g = if b { id } else { dbl }
  call0({ f: g }, "s")
}
atString(true)
