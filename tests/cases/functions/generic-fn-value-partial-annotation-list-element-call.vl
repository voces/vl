// @run
// @log 3
// A generic function value whose context declares no type: `const fs = [npadd]` is a bare list
// literal with no annotation, and its only call goes through the list. That call gives the list
// its element type, as an annotation would, so `npadd`'s hole `b` is filled from it (D3977).
// `generic-fn-value-partial-annotation.vl` is the annotated twin.
function npadd(a: i32, b) { return a + b }

function go() {
  const fs = [npadd]
  print(fs[0](1, 2))
}

go()
