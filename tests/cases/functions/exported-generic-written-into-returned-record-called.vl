// @run
// @log 3
// @log 7
// @log 8
// @log 9
// Controls for D12370: a write into a function's result that a call reads, through the result
// itself, a binding it returns, a binding it holds, or a parameter it hands back.
export function id<T>(x: T): T { x }
function mk() { { f: id } }
const r = mk()
r.f = id
print(r.f(3))
const inner = { f: id }
function mk1() { inner }
const r1 = mk1()
r1.f = id
print(inner.f(7))
const inner2 = { f: id }
function mk2() { { a: inner2 } }
const r2 = mk2()
r2.a.f = id
print(inner2.f(8))
function mk3(o) { o }
const q = { f: id }
const r3 = mk3(q)
r3.f = id
print(q.f(9))
