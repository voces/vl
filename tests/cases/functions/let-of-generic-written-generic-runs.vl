// @run
// @log O
// @log 1
// @log Q
// @log 8
// A generic `let` takes another generic, and an annotated one holds a concrete function (D3960).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function q(n: i32) { print("Q"); print(n + 1) }
function ci(f: (n: i32) => void, n: i32) { f(n) }
function main() {
  let k = inner
  k = other
  ci(k, 1)
  let j: (n: i32) => void = inner
  j = q
  j(7)
}
main()
