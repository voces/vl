// @run
// @info `z` is never reassigned; use `const` instead of `let`
// @log 1
// @log 1
// @log 1
// A `??` whose default is a list literal of another storage joins both lists whether the call
// that binds its result comes before or after the function's declaration (D16300).
const a: boolean[] | null = null
const y = pc(a)
let z = pc(null)
print(y.length)
print(z.length)
function pc(xs: boolean[] | null) { return xs ?? [1] }
function qc(xs: string[] | null) { return xs ?? [1] }
const w = qc(null)
print(w.length)
