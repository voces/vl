// @error a list is passed as the same storage, so its element type cannot differ between `a` and this destination
// The aliased list handed to a generic function's parameter and called there at (i32) is the
// same storage the annotation closes at (f64) (D17822).
function id(a) { return a }
function deliver() { return [{ f: id }] }
function use(xs) { return xs[0].f(2) }
const a = deliver()
const b: { f: (a: f64) => f64 }[] = a
print(use(a))
print(b[0].f(2.5))
