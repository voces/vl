// @run
// @log 3
// @log 3.5
// @log 7
// @log 2
// @log 2
// @log 2
// @hint redundant type annotation: `area` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `count` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `ints` is inferred as `i32[]` — remove it to lean on inference
// @hint redundant type annotation: `floats` is inferred as `f64[]` — remove it to lean on inference
// @hint redundant type annotation: `circles` is inferred as `{r: i32}[]` — remove it to lean on inference
// An UN-ANNOTATED list parameter is not a covariant destination: each call specialises the
// function at the argument's own list type, so nothing widens and nothing is copied. The
// numeric pair and the union-element pair the container rule refuses at an annotated
// `f64[]` / `Shape[]` parameter run here, and so does a generic `<T>(xs: T[])`.
// `bump` writes its parameter, and the caller sees the write, since the list is shared.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq

function total(xs) {
  let s = 0.0
  let i = 0
  while i < xs.length {
    s = s + xs[i]
    i = i + 1
  }
  s
}

function area(s: Shape): i32 {
  if s is Circle { return s.r }
  0
}

function areas(xs) {
  let t = 0
  let i = 0
  while i < xs.length {
    t = t + area(xs[i])
    i = i + 1
  }
  t
}

function bump(xs) { xs[0] = xs[0] + 1 }

function count<T>(xs: T[]): i32 { xs.length }

const ints: i32[] = [1, 2]
const floats: f64[] = [1.5, 2.0]
const circles: Circle[] = [{ r: 3 }, { r: 4 }]
print(total(ints))
print(total(floats))
print(areas(circles))
bump(ints)
print(ints[0])
print(count(ints))
print(count(circles))
