// @check
// @error argument 1: expected an array, got string
// @error argument 1: expected an array, got string
// @error argument 1: expected an array, got string
// @error argument 1: expected an array, got T
// @error argument 1: expected an array, got string
// @error receiver: expected an array, got string
// @error receiver: expected an array, got i32
// @error receiver: expected an array, got i32
// A hole the body writes as a list (`push`, `pop`, an index store) cannot take a string, which can
// be indexed but not written: at a direct call, through a caller's own hole, and as a method
// call's receiver, where a scalar the body indexes is refused too (D6332, D6352).
type T = "a" | "b"
function pu(a) {
  a.push(1)
  return 0
}
function po(a) {
  a.pop()
  return 0
}
function st(a) {
  a[0] = 1
  return 0
}
function w(b) { return pu(b) }
function spu(self) {
  self.push(1)
  return 0
}
function hd(self) { return self[0] }
const t: T = "a"
const n = 5
print(pu("s"))
print(po("s"))
print(st("s"))
print(pu(t))
print(w("s"))
print("s".spu())
print(n.hd())
print(n.spu())
