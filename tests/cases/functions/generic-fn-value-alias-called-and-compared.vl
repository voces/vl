// @run
// @log 1
// @log s
// @log true
// @log true
// @log false
// A `const` alias of a hole function, called through and compared: a comparison calls nothing,
// so the alias is still elided and compares as the function it names (D7383).
function id(x) { return x }
function other(x) { return x }
const k = id
print(k(1))
print(id("s"))
print(k == id)
print(k == k)
print(k == other)
