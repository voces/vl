// @error operator '+' is not defined for boolean and i32
// A written generic whose type parameter is named like the enclosing generic's is still its own
// (D3968).
function inner<U>(u: U) { print(u) }
function plusU<U>(u: U) { print(u + 1) }
function g<U>(x: U) {
  print(x)
  let k = inner
  k = plusU
  k(true)
}
g(1)
