// @run
// @log 7
// @log 4
// @log 19
// @log 7
// @log 7
// @log 7
// A generic (un-annotated-param) function used as a function-typed struct FIELD VALUE
// (`type Box = {op: (i32,i32)=>i32}`, `const b: Box = {op: add}`) is monomorphized at the field's
// declared type — the struct-shaped sibling of `generic-fn-array-boundary.vl`. `monoCoerceFnValue`
// recurses into an object literal, matching each `FieldInit` to its `FieldDef` by name, so the
// generic materializes at the signature the field declares rather than reaching the emitter's
// value floor at the i32 default.
//
// The two spellings of the expected type resolve by different routes and both are covered: a
// DECLARED alias reads its `TypeDecl`'s field nodes, an INLINE shape has no declaration and falls
// back to the shape layer's field scanner. And because the composite arms are mutually recursive,
// a field holding an ARRAY of generic functions materializes each element too.
type IBox = { op: (i32, i32) => i32 }
type FBox = { op: (f64, f64) => f64 }
type Table = { ops: ((i32, i32) => i32)[] }

function add(a, b) a + b
function mul(a, b) a * b

function useIBox(b: IBox) { return b.op(3, 4) }
function mkIBox(): IBox { return { op: add } }

function go() {
  // a declared alias pins `add` at (i32, i32) => i32.
  const bi: IBox = { op: add }
  print(bi.op(3, 4)) // 7

  // the SAME generic in a differently-typed field clones its own f64 instance.
  const bf: FBox = { op: add }
  print(bf.op(2.5, 1.5)) // 4

  // a field holding an ARRAY of generic functions — the object arm recurses into the array arm.
  const t: Table = { ops: [add, mul] }
  print(t.ops[0](3, 4) + t.ops[1](3, 4)) // 7 + 12 = 19

  // an INLINE object shape, with no `type` declaration to read the field types off. Its field is
  // named `apply`, not `op`: an inline shape that COINCIDES with a declared alias's shape is a
  // separate, pre-existing emitter limit ("binding's inline-shape type has an unsupported field",
  // reproducible with no generic in sight) and is not what this case pins.
  const bin: { apply: (i32, i32) => i32 } = { apply: add }
  print(bin.apply(3, 4)) // 7

  // the same coercion at the other typed boundaries an object literal reaches.
  print(useIBox({ op: add })) // 7 — a struct-typed ARGUMENT
  print(mkIBox().op(3, 4)) // 7 — an annotated RETURN
}

go()
