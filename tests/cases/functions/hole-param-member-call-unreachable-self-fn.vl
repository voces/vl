// @run
// @log fld
// @log C
// @hint redundant type annotation: `b` is inferred as `{tag: () => string}` — remove it to lean on inference
// @hint redundant type annotation: `tag` is inferred as `string` — remove it to lean on inference
// D1430 — A `self`-FUNCTION WHOSE RECEIVER TYPE NO INSTANTIATION CAN HAVE. `tag` here
// takes a `Circle`, and `g` is never called at one, so the member call inside `g` must
// resolve as the closure FIELD its only argument carries. The dispatch rewrite read
// `fnTyParams.length == 0` as "not generic", declined to ask the call sites, and rewrote
// `x.tag()` onto `tag(x)`: `vl check` rc 0 and invalid wasm.
//
// AN UN-ANNOTATED PARAMETER IS A GENERIC TOO — the declared `<T>` twin of the first line
// was already right, which is exactly the asymmetry the ruling closes.
//
// THE SECOND LINE IS THE CONTROL, and it is what makes the fix a narrowing rather than a
// disabling: `h` is called only at a `Circle`, which carries no `tag` field, so UFCS is
// still the right answer and still taken.
type Boxed = { tag: () => string }
type Circle = { r: f64 }

function tag(self: Circle): string {
  if self.r > 0.0 { return "C" }
  "c"
}

function g(x) { x.tag() }
function h(y) { y.tag() }

const b: Boxed = { tag: () => "fld" }
print(g(b))
print(h({ r: 1.0 }))
