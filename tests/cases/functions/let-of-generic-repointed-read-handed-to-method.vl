// @run
// @log true
// @log true
// @log true
// A read of a re-pointed generic `let` handed to `.push` or `.set` on a receiver annotated with a
// closed function type is the function its most recent write stored, whether the receiver is
// declared before the binding or after its write (D16551, beside D16182).
function inner<U>(u: U) { print(u) }
function plus<V>(v: V) { print(v + 1) }
function pushed() {
  let k = plus
  k = inner
  const fs: ((b: boolean) => void)[] = []
  fs.push(k)
  fs[0](true)
}
pushed()
function pushedFirst() {
  const fs: ((b: boolean) => void)[] = []
  let k = plus
  k = inner
  fs.push(k)
  fs[0](true)
}
pushedFirst()
function stored() {
  let k = plus
  k = inner
  const m: {[string]: (b: boolean) => void} = Map()
  m.set("k", k)
  const got = m["k"]
  if got != null { got(true) }
}
stored()
