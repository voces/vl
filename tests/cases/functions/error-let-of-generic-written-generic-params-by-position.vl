// @error argument 2: operator '+' is not defined for boolean and i32
// A generic written to a generic `let` binds its own type parameters by position at the call,
// whatever they are named (D3968).
function s<A, B>(a: A, b: B) {
  print(a)
  print(b)
}
function w<B, A>(b: B, a: A) {
  print(b + 1)
  print(a)
}
function main() {
  let k = s
  k = w
  k(5, true)
  k(true, 5)
}
main()
