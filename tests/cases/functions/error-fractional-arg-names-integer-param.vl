// @check
// @error-at 5:44 argument 2: expected i32, got f64 — it is the parameter `digits: i32`, which takes a whole number
// A fractional argument for an integer parameter names the parameter it meets, so a call that
// passes a tolerance where a count of decimal places is wanted reads which one it is.
function round(x: f64, digits: i32): f64 { x + (digits as f64) }
function check(tol: f64) { print(round(1.0, tol)) }
check(0.01)
