// @run
// @log 2
// An EXPORTED function that is also taken as a function VALUE. The export must publish the
// signature the source declares — `(i32) -> i32` — not the env-leading one the module uses
// internally (#1264).
//
// When any function value exists, `envSlotShift` gives EVERY function a hidden leading
// `structref env` param, and the export section used to publish the target function
// directly, so that internal convention leaked into the ABI: this file exported `f` as
// `(structref, i32) -> i32`. An importer calling `f(1)` got a boundary TypeError ("type
// incompatibility when transforming from/to JS"); one that guessed `f(null, 1)` got the
// right answer. Measured through a real JS/wasm instantiation, both before and after.
//
// The export now names a thin forwarding wrapper that carries the clean signature and
// supplies the null env, so `f(1)` returns 2 across the boundary. The `@log` below only
// witnesses that the wrapper did not disturb the in-module call — the ABI itself is checked
// on the export section, which no case-file directive can assert.
export function f(a: i32): i32 { return a + 1 }

const g = f

print(g(1))
