// @run
// @log 12
// @log 7
// @log 4
// @log 3
// @log 12
// @log 7
// The two composite paths a function VALUE reaches its declared type through: a CONDITIONAL in
// value position, and a later ASSIGNMENT to an already-declared binding.
//
// An if-EXPRESSION's arms each produce the whole value, so the expected type reaches every arm
// unchanged (`monoCoerceFnValueName` recurses per-arm, and through a block to its LAST statement —
// an arm's value IS its last statement). An `=` reads the same boundary as the initializer did:
// a binding has ONE declared type and every write to it is that type, so `monoWalk`'s assignment
// limb routes the right-hand side through the same coercion `LetDecl` uses.
//
// The conditions are PARAMETERS rather than literals so no arm is const-folded away — a folded
// `if true` would leave the other arm unreached and pin nothing.
function cadd(a, b) { return a + b }
function cmul(a, b) { return a * b }
function csub(a, b) { return a - b }
function cmulF(a: f64, b: f64): f64 { return a * b }

// Both arms generic — each materializes at the annotation.
function bothArms(k: i32) {
  const f1: (i32, i32) => i32 = if k == 1 { cadd } else { cmul }
  return f1(3, 4)
}

// NESTED if-expressions: the recursion reaches an arm at any depth.
function nestedArms(k: i32) {
  const f2: (i32, i32) => i32 = if k == 1 { cmul } else {
    if k == 0 { cadd } else { csub }
  }
  return f2(3, 4)
}

// One generic arm and one already-concrete arm, pinned at f64 rather than the i32 default.
function mixedArms(k: i32) {
  const f3: (f64, f64) => f64 = if k == 0 { cadd } else { cmulF }
  return f3(1.5, 2.5)
}

function go() {
  print(bothArms(0)) // cmul(3,4) = 12
  print(nestedArms(0)) // cadd(3,4) = 7
  print(mixedArms(0)) // cadd(1.5,2.5) = 4

  // ASSIGNMENT to an annotated binding, after a concrete initializer.
  let f4: (i32, i32) => i32 = csub
  print(f4(7, 4)) // 3
  f4 = cmul
  print(f4(3, 4)) // 12
}

go()

// The same assignment boundary at MODULE scope.
let gf: (i32, i32) => i32 = csub
gf = cadd
print(gf(3, 4)) // 7
