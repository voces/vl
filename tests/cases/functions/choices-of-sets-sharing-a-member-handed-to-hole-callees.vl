// @run
// @log 2
// @log 2.5
// @log 2
// @log 4
// @log 2
// @log 4
// @log -2.5
// @log 7
// Two choices whose function sets share a member, each handed to a hole callee, are tagged
// together and dispatched by id, in a record or a list, at one type or two (D15643).
function id1(a) { return a }
function id2(a) { return a }
function dbl(a) { return a + a }
function neg(a) { return 0 - a }
function g(r) { return r.f(2) }
function h(r) { return r.f(2.5) }
function gl(r) { return r[0](2) }
function keep(f: (i32) => i32) { print(f(7)) }
function pickA(c) {
  const k = if c { { f: id1 } } else { { f: id2 } }
  print(g(k))
}
function pickB(c) {
  const k = if c { { f: id1 } } else { { f: dbl } }
  print(h(k))
}
function listA(c) {
  const k = if c { [id1] } else { [id2] }
  print(gl(k))
}
function listB(c) {
  const k = if c { [id2] } else { [dbl] }
  print(gl(k))
}
function recC(c) {
  const k = match c {
    1 => { f: dbl }
    _ => { f: neg }
  }
  print(h(k))
}
function recD(c) {
  const k = if c { { f: id2 } } else { { f: dbl } }
  print(g(k))
}
pickA(true)
pickB(true)
listA(true)
listB(false)
recD(true)
recD(false)
recC(2)
keep(id1)
