// @run
// @log 5
// @log s
// @log true
// @log s
// @log 5
// @log 2.5
// A `const` record of a hole handed on whole and also read through its field calls the hole
// where the field is read (D15772): a call at another type, and beside a field of a value.
function id(v) { return v }
function call0(r, x) { print(r.f(x)) }
function run(g) {
  print(g(5))
  const r = { f: g }
  call0(r, "s")
  print(r.f(true))
}
run(id)
function both(g, n) {
  const r = { f: g, k: n }
  call0(r, "s")
  print(r.k + 1)
  print(r.f(2.5))
}
both(id, 4)
