// @run
// @log 5
// @log 3
// @log 4
// @log 5
// @log 6
// @log 7
// A function of a wider parameter assigned into a narrower function-typed place is stored as
// an adapter at the place's signature, and the assignment's value is that adapter, typed as the
// place: called through the result it takes the place's argument (D3866).
type A = { k: "a", v: i32 }
type B = { k: "b", w: string }
type S = { f: (p: A) => i32 }
const both = (p: A | B): i32 => {
  if p.k == "a" { p.v } else { 7 }
}
let d: (p: A) => i32 = (p: A): i32 => p.v * 0
const g = () => {
  d = both
}
const r = g()
print(r({ k: "a", v: 5 }))
print(d({ k: "a", v: 3 }))
const s: S = { f: (p: A): i32 => p.v * 0 }
function gs() { s.f = both }
const rs = gs()
print(rs({ k: "a", v: 4 }))
print(s.f({ k: "a", v: 5 }))
function m() {
  let dl: (p: A) => i32 = (p: A): i32 => p.v * 0
  const gl = () => {
    dl = both
  }
  const rl = gl()
  print(rl({ k: "a", v: 6 }))
  print(dl({ k: "a", v: 7 }))
}
m()
