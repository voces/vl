// @check
// @error got i32[] — print the elements or fields individually, e.g. `print(xs[0])` (in `lap`, at one of the instances it calls a function argument at)
// @error got i32[] — print the elements or fields individually, e.g. `print(xs[0])` (in `lap`, at one of the instances it calls a function argument at)
// @error got i32[] — print the elements or fields individually, e.g. `print(xs[0])` (in `lap2`, at one of the instances it calls a function argument at)
// A hole called at two instances has each `print` of its results judged at each one, as the
// one-instance spelling is, so a list result is refused at the call and not at emit (D6350).
function wrap(a) { return [a] }
function lap(g) {
  print(g(1))
  return g("s")
}
const lid = (a) => [a]
function lap2(g) {
  const x = g(1)
  print(x)
  return g("s")
}
print(lap(wrap)[0])
print(lap((a) => [a])[0])
print(lap2(lid)[0])
