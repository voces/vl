// @error return expects a value, got void
// CONTRACT (must-error): `return <void call>` names a value to return and has none.
//
// This is the INFERRED return path: the enclosing function carries no return annotation, so
// its return type is still being resolved when the `return` is checked and the mismatch rule
// ("return type mismatch: expected i32, got void") is not reachable — there is nothing yet to
// mismatch against. The void was recorded as the inferred return and reached codegen, which
// emitted a `return` with nothing on the stack: `vl check` clean, module invalid.
//
// A void body still forwards a void call the two ways that lower: as a bare statement
// (`function g() { pv() }`) or with a valueless `return`.
//
// A VERDICT pin: the defect is a program that fails to build, and the fix makes it fail at
// the check tier instead — a `@log` oracle has no correct run to compare against.
function pv() { print(1) }
function fwd() { return pv() }
fwd()
