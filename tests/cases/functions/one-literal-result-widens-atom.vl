// D7445: a function whose declared result is one string literal returns its string, so an
// atom it returns (a one-literal alias, a list element, a field) widens at the return.
// @run
// @log circle
// @log circle
// @log circle
// @log circle
// @log 6
type KC = "circle"
function g(a: KC): "circle" { a }
function el(a: KC[]): "circle" { return a[0] }
function fld(a: {k: "circle"}): "circle" { a.k }
const xs: KC[] = ["circle"]
print(g("circle"))
print(el(xs))
print(fld({ k: "circle" }))
const s = el(xs)
print(s)
print(s.length)
