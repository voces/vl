// @run
// @log 5
// @log 5
// @log 9
// @log 6
// @log hi
// @log 5
// @hint redundant type annotation: `coalesced` is inferred as `i32`
// @hint redundant type annotation: `compared` is inferred as `i32`
// @hint redundant type annotation: `falseArm` is inferred as `i32`
// @hint redundant type annotation: `arithmetic` is inferred as `i32`
// @hint redundant type annotation: `stringArm` is inferred as `string`
// @hint redundant type annotation: `r` is inferred as `i32?`
// @hint redundant type annotation: `annotated` is inferred as `i32`
// CONTRACT (must-RUN): an else-less `if` used as a `let`/`const` INITIALIZER types as
// `thenTy | null`, not `TY_VOID`.
//
// It typed void on the parent commit, by a documented decline whose stated reason —
// "outside tail position the emitter can't yet leave a nullable value on the stack …
// pending a typed-blocktype if-expression" — WAS NO LONGER TRUE when it was read:
// `emit_collect.nliInferIfLet` lowers an if-expression BINDING against the checker's own
// exported inferred union (`inferLetIx`/`inferLetTy`), and that export's gate (`isIfInit`
// in `checkLetDeclNode`) is this exact position. The capability arrived and nothing
// re-read the decline.
//
// The symptom was filed as a `??` bug. `??` IS NOT INVOLVED — it returns its LHS
// unchanged; the refusal was at the BINDING (`cannot assign void to 'r'`, `return type
// mismatch: expected i32, got void`, `operator '+' is not defined for void and i32`,
// `cannot compare void with null` — one per use, all of them downstream of the same
// void).
//
// POSITION-GATED, and the gate is a measurement, not caution: a call ARGUMENT, an explicit
// `return`, and a module-scope binding read through `print` all answer
// `emitProgram: union if-expression requires an else arm`, so widening there would trade
// the checker's clean positioned "cannot assign void" for an emit-stage reject. Those keep
// the parent's behaviour exactly; `types/if-expression-no-else-non-let-positions.vl` pins
// one of them.
function coalesced(): i32 {
  const r = if 1 == 1 then 5
  return r ?? 0
}
print(coalesced())

function compared(): i32 {
  const r = if 1 == 1 then 5
  if r == null { return 0 }
  return r
}
print(compared())

function falseArm(): i32 {
  const r = if 1 == 2 then 5
  return r ?? 9
}
print(falseArm())

function arithmetic(): i32 {
  const r = if 1 == 1 then 5
  return (r ?? 0) + 1
}
print(arithmetic())

function stringArm(): string {
  const r = if 1 == 1 then "hi"
  return r ?? "no"
}
print(stringArm())

function annotated(): i32 {
  const r: i32 | null = if 1 == 1 then 5
  return r ?? 0
}
print(annotated())
