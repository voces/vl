// @run
// @log 3
// @log w
// @log 2.5
// @log 10
// @log 10
// @log 3
// @log w
// @log 4
// @log v
// @hint redundant type annotation: `a` is inferred as `i32`
// @hint redundant type annotation: `s` is inferred as `string`
// One binding of a hole lambda handed through an identity, called at several types, holds a
// fresh copy of the lambda per type, a lambda reading a module constant included (D6201).
function fw(f) { return f }
const k = 10
const lam = (x) => x
const lamK = (x) => {
  print(k)
  x
}
const q = fw(lam)
print(q(3))
print(q("w"))
print(q(2.5))
const r = fw(lamK)
const a: i32 = r(3)
const s: string = r("w")
print(a)
print(s)
function main() {
  const inner = (x) => x
  const p = fw(inner)
  print(p(4))
  print(p("v"))
}
main()
