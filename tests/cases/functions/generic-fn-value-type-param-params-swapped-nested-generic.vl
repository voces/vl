// @run
// @log x
// @log 1
// @log x
// @log 0
// The swapped recursion of D6240 handing on a generic nested in another function, which no name
// reaches from the recursion's call: the hand-on keeps the generic's own frame.
function mid<F>(a: F, b: F, n: i32) {
  print(a("x"))
  print(b(n))
  if n > 0 { mid(b, a, n - 1) }
}
function outer(u: i32) {
  function same<T>(k: T): T { k }
  mid(same, same, u)
}
outer(1)
