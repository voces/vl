// @run
// The same list's element handed to a lambda whose annotated result closes the field: the id is
// converted in the lambda's body, at the result's signature (D17790).
function id(a) { return a }
function deliver() { return [{ f: id }] }
const u = deliver()
print(u[0].f(2))
const k = (r): { f: (a: f64) => f64 } => ({ f: r.f })
print(k(deliver()[0]).f(1.5))
// @log 2
// @log 1.5
