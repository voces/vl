// @run
// @log v7
// @log v7
// @log v3
// @log 6
// A function value whose parameters are holes, delivered at a concrete function type, runs at
// that type once the member functions its body calls are imported (D5932).
import { toString } from "std:fmt"

function name(b: (n: i32) => string) { b(7) }
const f = (n) => "v" + n.toString()
print(name(f))
function go(h) { return h((n) => "v" + n.toString()) }
print(go(name))
function mk(): (n: i32) => string { return f }
print(mk()(3))
type P = { x: i32 }
function useP(b: (p: P) => i32) { b({ x: 5 }) }
const g = (p) => p.x + 1
print(useP(g))
