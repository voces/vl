// @run
// A fresh record holding one generic function in two fields annotated at two signatures: each
// field is converted at its own signature, so each pins the member there (D17786).
function id(a) { return a }
function two() { return { f: id, g: id, n: 3 } }
const w: { f: (a: f64) => f64, g: (a: i32) => i32, n: i32 } = two()
const x = two()
print(w.f(2.5) + w.g(1) + x.f(2) + w.n)
// @log 8.5
