// @run
// @log 4
// @log 4
// @log 4
// @log 4
// @log -2.5
// @warning Unused parameter `g`
// @warning Unused parameter `h`
// A generic declared function handed to a parameter nothing reads is never called, so it takes
// an unobservable default instance, as a lambda does (D6213).
function outer(g) { return 4 }
function inner(h) { return 4 }
function fwd(g) { return inner(g) }
function neg(a) { return 0 - a }
function idT<T>(a: T): T { return a }
function add(a, b) { return a + b }
print(outer(neg))
print(outer(idT))
print(fwd(neg))
print(outer(add))
print(neg(2.5))
