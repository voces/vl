// @run
// @log x
// @log x
// @log 0
// A recursion that hands a generic on in swapped positions and returns a scalar: the hand-on is
// skipped and each parameter takes its own pin.
function same<T>(k: T): T { k }
function mid<F>(a: F, b: F, n: i32) {
  print(a("x"))
  if n > 0 { const r = mid(b, a, n - 1); print(r) }
  return n
}
mid(same, same, 1)
