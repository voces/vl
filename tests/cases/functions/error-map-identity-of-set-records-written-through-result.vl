// @error a {f: (_) => _} cannot be delivered as {f: (f64) => f64} here
// A write through the identity map's result would reach `x`'s own record, so the delivery is
// refused rather than copied (D17793).
function id(a) { return a }
function dbl(a) { return a * 2 }
function deliver() { return [{ f: id }] }
const x = deliver()
const ys: { f: (a: f64) => f64 }[] = x.map((r) => r)
ys[0].f = dbl
print(x[0].f(2.5))
