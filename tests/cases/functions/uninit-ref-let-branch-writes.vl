// @run
// @log 1
// @log 1
// @log bc
// @log 2
// @log b
// @log 0
// @log a
// @log other
// @log 6
// @log 4
// A ref-typed `let` with no initializer, written in every arm of an `if` or `match` and read
// after the join, at one type per local kind. Its wasm local is declared nullable, since a
// write inside an arm does not set a non-null local for the code after it; each read asserts
// non-null (D3242). The initialised twin is `uninit-ref-let-branch-writes-initialised.vl`.
type P = { x: i32 }
type A = { kind: "a", x: i32 }
type B = { kind: "b", y: i32 }

function listUnion(c: boolean) {
  let r: i32[] | string[]
  if (c) { r = [1] } else { r = ["a"] }
  r.length
}
function list(c: boolean) {
  let r: i32[]
  if (c) { r = [1] } else { r = [2, 3] }
  r.length
}
function str(c: boolean) {
  let r: string
  if (c) { r = "a" } else { r = "bc" }
  r
}
function rec(c: boolean) {
  let r: P
  if (c) { r = { x: 1 } } else { r = { x: 2 } }
  r.x
}
function recUnion(c: boolean): string {
  let r: A | B
  if (c) { r = { kind: "a", x: 1 } } else { r = { kind: "b", y: 2 } }
  r.kind
}
function map(c: boolean) {
  let r: Map<string, i32>
  if (c) { r = Map() } else { r = Map() }
  r.length
}
function valueUnion(c: boolean): string {
  let r: string | i32
  if (c) { r = "a" } else { r = 2 }
  if (r is string) { return r }
  "i"
}
function matched(k: i32) {
  let r: string
  match (k) {
    1 => {
      r = "one"
    }
    _ => {
      r = "other"
    }
  }
  r
}
function fn(c: boolean): i32 {
  let f: (x: i32) => i32
  if (c) { f = (x: i32) => x + 1 } else { f = (x: i32) => x * 2 }
  f(3)
}
function captured(c: boolean) {
  let r: i32[]
  if (c) { r = [1, 2, 3] } else { r = [4] }
  const g = () => r.length
  g() + 1
}

print(listUnion(true))
print(list(true))
print(str(false))
print(rec(false))
print(recUnion(false))
print(map(true))
print(valueUnion(true))
print(matched(2))
print(fn(false))
print(captured(true))
