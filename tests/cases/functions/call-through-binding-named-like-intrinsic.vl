// @run
// @log 3
// The unimplemented-memory-intrinsic refusal is about the default-scope binding of that name, so
// it asks the scope chain: a parameter spelled `__store_string__` is an ordinary closure-valued
// binding and its call is an ordinary call. Before D1604 the gate read the flat top-level table
// alone, found no user declaration, and refused a program that never named the intrinsic.
function tak(__store_string__: (i32, i32) => void) { __store_string__(1, 2) }
tak((a, b) => { print(a + b) })
