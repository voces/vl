// @check
// @error cannot assign f64 to 'b' of type string
// @error cannot assign f64 to 'r' of type string
// The call's result is the instance the literal's element or field takes in the callee, so a
// destination of another type is refused, as the direct spelling is (D15645).
function dbl(v) { return v + v }
function c1(r, x) { return r[0](x) }
function cf(r, x) { return r.f(x) }
function both1(g) { return c1([g], 2.5) }
function bothF(g) { return cf({ f: g }, 2.5) }
const b: string = both1(dbl)
const r: string = bothF(dbl)
print(b + r)
