// @run
// @log 3
// @log 4
// @log 3
// @log 4
// @log 7
// A generic handed to a hole split per type and to another hole calling it at one of the split's
// types runs each call at its own instance (D6280).
function add(a, b) { return a + b }
function apply2(g) {
  print(g(1, 2))
  print(g(1.5, 2.5))
}
function app3(g) { print(g(1, 2)) }
function app4(g) { print(g(1.5, 2.5)) }
apply2(add)
app3(add)
app4(add)
print(add(3, 4))
