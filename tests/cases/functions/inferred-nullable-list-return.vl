// @run
// @log true
// @log 2
// @log 10
// @log a
// @log 1.5
// @log 7
// @log true
// @hint redundant type annotation: `vs` is inferred as `string[]` — remove it to lean on inference
// @hint redundant type annotation: `vf` is inferred as `f64[]` — remove it to lean on inference
// @hint redundant type annotation: `vb` is inferred as `boolean[]` — remove it to lean on inference
// D1062 — an UN-ANNOTATED function whose returns join to `T[] | null`. NOTHING HERE
// ANNOTATES A RETURN, and that is the whole fixture: the annotated twin of every
// function below already ran, so a fixture that wrote `: i32[] | null` could not see
// this defect at all (D969's rule — an annotation pins the rep, and inference doing
// the pinning instead is the ingredient).
//
// The row split ONE shape across TWO refusal channels, decided by the element type:
// `i32[]` / `boolean[]` reached the emitter and failed there (`emitProgram: bare null
// needs a struct-typed context`), every other element type was refused by the CHECKER
// with a message conceding the program was type-valid. `synthNulListRetAnns` pins the
// annotation the user did not write, so both channels lower through the path the
// annotated spelling already had.
//
// EACH ARM IS CONSTRUCTED **AND** DISCRIMINATED: the `null` arm is taken and compared,
// and the non-null arm is read THROUGH the returned container (`.length`, then an
// element) — a boxed or mis-repped result fails on the read rather than passing a
// pointer comparison.
//
// The `u8[]` leaf is deliberately NOT here: a `u8[] | null` cell beside an
// `i64[] | null` / `f64[] | null` / `f32[] | null` one in the same module is
// check-clean invalid wasm at the ANNOTATED spelling too (D1105), so its coverage
// lives alone in `inferred-nullable-u8-list-return.vl`.
//
// The ELEMENT-TYPE annotations below are load-bearing at `f64[]` in the sense the
// hints record: they are what the arm returns, and the hint says only that the
// checker agrees about the TYPE — never that the two spellings agree about the REP,
// which is the whole subject of this file.

// The i32 backing — the channel that used to reach the emitter.
function pickI32(n: i32) {
  if n == 0 { return [10, 20] }
  return null
}
print(pickI32(1) == null)
const ri = pickI32(0)
if ri != null {
  print(ri.length)
  print(ri[0])
}

// The string element — the channel the CHECKER used to refuse.
function pickStr(n: i32) {
  const vs: string[] = ["a", "b"]
  if n == 0 { return vs }
  return null
}
const rs = pickStr(0)
if rs != null { print(rs[0]) }

// A DISTINCT-BACKING leaf (`f64[]`), whose wrapper is neither the i32 list nor a ref list.
function pickF64(n: i32) {
  const vf: f64[] = [1.5, 2.5]
  if n == 0 { return vf }
  return null
}
const rf = pickF64(0)
if rf != null { print(rf[0]) }

// The i64 leaf, and the ARM ORDER reversed — `return null` first refused identically.
function pickI64(n: i32) {
  const vl: i64[] = [7, 8]
  if n != 0 { return null }
  return vl
}
const rl = pickI64(0)
if rl != null { print(rl[0]) }

// FALL-THROUGH inference: no `return null` is written at all, the totality rule widens
// the return to `T[] | null`, and the pin must read that widened type too.
function pickFall(n: i32) {
  const vb: boolean[] = [true, false]
  if n == 0 { return vb }
}
const rb = pickFall(0)
if rb != null { print(rb[0]) }
