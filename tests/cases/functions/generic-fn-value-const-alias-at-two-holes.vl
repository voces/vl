// @info `hl` is never reassigned; use `const` instead of `let`
// A binding of a hole function handed to two holes, each calling it at another type, takes a
// slot per hole (D6092): a const, a never-written let, an alias of an alias, a lambda, through
// a forwarder, and inside a function.
function same(k) { k }
function sameG<T>(k: T): T { k }
function take(a) { print(a("x")) }
function take2(a) { print(a(3)) }
function fwd(b) { take(b) }
function mid<F>(a: F, a1: F) {
  take(a)
  take2(a1)
}
function midH(a, a1) {
  take(a)
  take2(a1)
}
const h = same
take(h)
take2(h)
function main() {
  const hm = same
  take(hm)
  take2(hm)
}
main()
let hl = same
take(hl)
take2(hl)
const hc = same
take(hc)
take2(hc)
print(hc(true))
const hf = same
fwd(hf)
take2(hf)
const ha = same
const hb = ha
take(hb)
take2(ha)
const lam = (k) => k
take(lam)
take2(lam)
const s = sameG
mid(s, s)
const s2 = sameG
midH(s2, s2)
