// @run
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// @log 3
// @log w
// @log 4
// @log z
// @log 3
// @log w
// Bindings of one hole lambda handed through two identities, of a two-parameter lambda, and of
// a lambda also called directly take a slot per binding type (D6241).
function fw(f) { return f }
function fw2(g) { return g }
const lamB = (x) => x
const qb = fw(lamB)
const rb = fw2(lamB)
print(qb(3))
print(rb("w"))
const lam2 = (_x, y) => y
const q2 = fw(lam2)
const r2 = fw(lam2)
print(q2(3, 4))
print(r2("w", "z"))
const lamD = (x) => x
const qd = fw(lamD)
print(qd(3))
print(lamD("w"))
