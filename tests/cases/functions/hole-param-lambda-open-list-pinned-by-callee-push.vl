// @run
// @log s
// @log s
// @log 2
// A lambda whose `[]` result is left open, handed inline or bound to an un-annotated parameter
// that pushes through the result of calling it: the list takes the callee's element.
function first(a) {
  const m = a(2)
  m.push("s")
  print(m[0])
}
function count(a) {
  const m = a()
  m.push(1.5)
  m.push(2.5)
  print(m.length)
}
first((_x: i32) => [])
const g = (_x: i32) => []
first(g)
count(() => [])
