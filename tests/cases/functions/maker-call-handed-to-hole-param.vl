// @run
// @log 5
// @log 5.5
// @log 7
// A maker call handed straight to an un-annotated parameter is built at the type that parameter
// calls it at, each call at its own maker instance (D16816).
function adder(n) { return (a) => a + n }
function take(a) { print(a(3)) }
take(adder(2))
take(adder(2.5))
take(adder(4))
