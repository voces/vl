// @run
// @log x
// @log 3
// @log other
// @log x
// @log other
// @log 3
// @log x
// @log 3
// @log other
// @log x
// @log other
// @log 3
// Two generics handed to one un-annotated parameter called at two types are each instanced at
// both (D5611): every call hands its own value once per parameter. The typed spelling, and a
// delivery through a second forwarding hole.
function same<T>(k: T): T { k }
function other<T>(k: T): T {
  print("other")
  k
}
function take(a) { print(a("x")) }
function take2(a) { print(a(3)) }
function mid(a) {
  take(a)
  take2(a)
}
mid(same)
mid(other)

function midT<F>(a: F) {
  take(a)
  take2(a)
}
function outer(b) { midT(b) }
outer(same)
outer(other)
