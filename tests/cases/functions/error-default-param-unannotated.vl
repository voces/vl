// @check
// @error a default value needs a type annotation
// A defaulted parameter must be ANNOTATED. An un-annotated parameter is an
// inference HOLE that each call site pins independently and the emitter
// monomorphizes per pinned shape; a hole with a default would be pinned at some
// call sites and left to the default at others. Keeping defaults and holes
// disjoint is what leaves the monomorphizer's instance keying untouched.
function g(a = 1): i32 { a }
print(g())
