// @run
// @log 11
// @log 10
// @log 6
// @log 12
// @log 2
// @log 12
// @log [hi]
// @log <hi]
// @log <hi>
// @log -!
// @log empty
// @hint redundant type annotation: `scale` is inferred as `i32`
// @hint redundant type annotation: `p` is inferred as `{x: i32, y: i32}`
// @hint redundant type annotation: `wrap` is inferred as `string`
// @hint redundant type annotation: `firstTag` is inferred as `string`
// @hint redundant type annotation: `ns` is inferred as `i32[]`
// UFCS DISPATCH TAKES THE SAME ARITY RANGE THE DIRECT SPELLING TAKES.
// `scale(5, 2)` and `5.scale(2)` are the same call — the receiver fills `self`,
// the defaults fill the tail — and v1's first cut had them DISAGREE: the
// receiver-injecting match was exact-arity, so the method spelling of a call the
// plain spelling accepted was `member access '.scale' on non-object i32`. That
// is a DISPATCH rule wearing an argument-filling one's clothes, and both halves
// (the checker's `ufcsCallTy`, the emitter's `drwSelfFnOf`) now read the
// declaration's range so they cannot drift apart.
function scale(self: i32, by: i32, plus: i32 = 1): i32 { self * by + plus }
print(5.scale(2))
print(5.scale(2, 0))

// A STRUCT receiver, with the tail omitted and supplied.
type Pt = { x: i32, y: i32 }
function shift(self: Pt, dx: i32, dy: i32 = 10): Pt {
  return { x: self.x + dx, y: self.y + dy }
}
const p: Pt = { x: 1, y: 2 }
const a = p.shift(5)
print(a.x)
print(a.y)
const b = p.shift(5, 0)
print(b.y)
// A NAMED argument may skip a middle defaulted parameter here too: the injected
// receiver rides slot 0 UNNAMED, so the explicit names bind against the
// parameters after `self`.
const c = p.shift(dx: 5)
print(c.y)

// A STRING receiver with TWO defaults, omitted from the right.
function wrap(self: string, l: string = "[", r: string = "]"): string {
  return l + self + r
}
print("hi".wrap())
print("hi".wrap("<"))
print("hi".wrap("<", ">"))

// A GENERIC `self`-function whose defaulted tail names no type parameter: the
// receiver still binds `T`, and omitting the tail drops no binding site.
function firstTag<T>(self: T[], tag: string = "-"): string {
  if self.length == 0 { return tag }
  return tag + "!"
}
const ns: i32[] = [1, 2]
const ss: string[] = []
print(ns.firstTag())
print(ss.firstTag("empty"))
