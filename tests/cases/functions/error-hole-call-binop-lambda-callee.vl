// @error operator '+' is not defined for string and i32 (in `lap4`, at one of the instances it calls a function argument at)
// A hole called at two instances inside a `const` lambda, or inside a function declared in
// another function's body, has each operator over its results judged at each instance, as a
// top-level declared callee's is (D6300, D6330).
function id(a) { return a }
const lid = (a) => a
const lap = (g) => "" + g(1) + g("s")
const lap2 = (g) => {
  const x = g(1)
  return "" + x + g("s")
}
print(lap(id))
print(lap(lid))
print(lap2(id))
function main() {
  const lap3 = (g) => "" + g(1) + g("s")
  function lap4(g) { return "" + g(1) + g("s") }
  print(lap3(id))
  print(lap4(id))
}
main()
