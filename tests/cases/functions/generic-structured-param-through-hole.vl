// @run
// @log 1
// @log s
// @log 5
// @log 7
// @log 2
// @log 1
// @log s
// A declared generic with a structured parameter, handed to a hole, still runs at every
// call its parameter can take: two element types, a nested list, a record and a function (D6540).
function first<T>(k: T[]): T { k[0] }
function getx<T>(r: {x: T}): T { r.x }
function app<T, U>(f: (T) => U, v: T): U { f(v) }
function viaTwo(a) {
  print(a([1]))
  print(a(["s"]))
}
function viaNested(a) { print(a([[4, 5]])[1]) }
function viaRec(a) { print(a({ x: 7 })) }
function viaApp(a) { print(a((s: string) => s.length, "ab")) }
viaTwo(first)
viaNested(first)
viaRec(getx)
viaApp(app)
viaTwo((k) => k[0])
