// @run
// @log dup
// @log 3
// @log 4
// Two different generics handed to two parameters of one type parameter, the second returned and
// called at one type: the call runs the second, not the first argument's set (D15465).
function id<T>(x: T): T { x }
function dup<T>(x: T): T {
  print("dup")
  x
}
function pick<F>(a: F, c: F, k: boolean): F {
  if k { return a }
  c
}
const h = pick(id, dup, false)
print(h(3))
print(pick(dup, id, false)(4))
