// @run
// @log x
// @log 3
// @log x
// @log 3
// @log x
// @log 3
// @log true
// @log y
// @log x
// @log 3
// @log 3
// @log x
// A generic handed to an un-annotated parameter that the body calls at two types is instanced
// at each (D5611). The typed spelling `mid<F>(a: F)`, four calls at three types, a call inside
// a lambda, and a call whose result is the function's return.
function same<T>(k: T): T { k }
function mid(a) {
  print(a("x"))
  print(a(3))
}
mid(same)

function midT<F>(a: F) {
  print(a("x"))
  print(a(3))
}
midT(same)

function three(a) {
  print(a("x"))
  print(a(3))
  print(a(true))
  print(a("y"))
}
three(same)

function inLambda(a) {
  const f = () => a("x")
  print(f())
  print(a(3))
}
inLambda(same)

function ret(a): string {
  print(a(3))
  a("x")
}
print(ret(same))
