// @error cannot assign (i32) => void to `k`: it keeps the generic type of its initializer, so a function written to it must be generic too — to hold this one, annotate it, `let k: (i32) => void = …`
// A `let` initialized with an un-annotated lambda keeps that lambda's generic type too (D3960).
function q(n: i32) { print(n + 1) }
function main() {
  let k = (u) => {
    print(u)
  }
  k = q
  k(1)
}
main()
