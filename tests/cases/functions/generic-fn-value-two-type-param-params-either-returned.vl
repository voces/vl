// @log x
// @log 3
// @log y
// A generic handed to two parameters of one type parameter and called through them at two types,
// where the result may be either parameter: each parameter is handed back, so the result is one
// argument's value of the set they share (D12232, D15461). Was refused at emit (D6090, D6372).
function same<T>(k: T): T { k }
function take(a) { print(a("x")) }
function take2(a) { print(a(3)) }
function mid<F>(a: F, a1: F, c: boolean): F {
  take(a)
  take2(a1)
  if c { return a }
  a1
}
mid(same, same, false)
print(mid(same, same, false)(7))
print(mid(same, same, true)("y"))
