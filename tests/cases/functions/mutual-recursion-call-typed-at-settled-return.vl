// A call into a mutual-recursion member is typed at that member's settled return in every spelling
// over it: the left and right of a binary, a negation and a `const` (D17081).
// @run
// @log 7
// @log 3
// @log 1
// @log 7
// @log 3
type N = { k: i32 }
function a1(self: N) {
  if self.k <= 0 { return 0 }
  return b1({ k: self.k - 1 }) * 2
}
function b1(self: N) { return a1(self) + 1 }
function a2(self: N) {
  if self.k <= 0 { return 0 }
  return b2({ k: self.k - 1 }) + 0
}
function b2(self: N) { return a2(self) + 1 }
function a3(self: N) {
  if self.k <= 0 { return 0 }
  return -b3({ k: self.k - 1 })
}
function b3(self: N) { return a3(self) + 1 }
function a4(self: N) {
  if self.k <= 0 { return 0 }
  const r = b4({ k: self.k - 1 })
  return r * 2
}
function b4(self: N) { return a4(self) + 1 }
function a5(self: N) {
  if self.k <= 0 { return 0 }
  return 0 + b5({ k: self.k - 1 })
}
function b5(self: N) { return a5(self) + 1 }
print(b1({ k: 2 }))
print(b2({ k: 2 }))
print(b3({ k: 2 }))
print(b4({ k: 2 }))
print(b5({ k: 2 }))
