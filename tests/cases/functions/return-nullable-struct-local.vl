// @run
// @log 9
// @hint redundant type annotation: `c` is inferred as `{a: i32} | null` — remove it to lean on inference
// Returning a NULLABLE-struct LOCAL from an un-annotated function lowers (D887). This file
// asserted the refusal — "stays the checker's explicit-annotation policy" — and the policy was
// a capability admission wearing a policy's clothes: its own message said `type-valid, but …
// not yet supported by codegen`. The DECLARED inner (`Ctx`) is the second half of the bound
// beside `unsupported-inferred-nullable-return.vl`'s inline shape; `nullableRetName` renders the
// nominal name for one and the emitter-format shape text for the other, and
// `structIndexOfTypeName` resolves both onto the row the annotated spelling keys.
type Ctx = { a: i32 }

function mk(f: i32) {
  const c: Ctx | null = if f > 0 { { a: 9 } } else { null }
  return c
}

const r = mk(1)
if r != null { print(r.a) }
