// @run
// @log 1.5
// @log 4
// @log 1.5
// @log 1.5
// @log 1.5
// @log 4
// @log 1.5
// A list of lists of records whose field holds un-annotated functions of different result types,
// built by literals at every level: a call through `xs[i][j].f` runs the function stored there,
// as through a list of the records (D16824).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const xs = [[{ f: inc0 }], [{ f: half }]]
print(xs[1][0].f(3))
print(xs[0][0].f(3))
const deep = [[[{ f: inc0 }]], [[{ f: half }]]]
print(deep[1][0][0].f(3))
const ys = [[{ f: inc0 }]]
ys[0].push({ f: half })
print(ys[0][1].f(3))
ys[0][0].f = half
print(ys[0][0].f(3))
for row in xs {
  for r in row { print(r.f(3)) }
}
