// @error exported function `id` is generic over `T` and nothing in the program calls it
// An exported generic written to an element of a record's list that no call reads is refused,
// as the same list with no write is (D12302).
export function id<T>(x: T): T { x }
const r = { a: [id] }
r.a[0] = id
print(r.a.length)
