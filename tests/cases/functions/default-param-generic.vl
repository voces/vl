// @run
// @log #!
// @log #
// @log F!
// @log #!
// @log #!
// @log #
// @log 105
// @log 59
// @log 60
// @log 61
// @hint redundant type annotation: `ns` is inferred as `i32[]`
// @hint redundant type annotation: `fs` is inferred as `f64[]`
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// DEFAULTS ON A GENERIC, MONOMORPHIZED PER INSTANCE. The rule that makes this
// work is the one B15a already had — a defaulted parameter's annotation may not
// name one of the function's own type parameters — so omitting the argument
// drops no binding site and the monomorphizer's instance keying sees exactly the
// argument types it always did. What v1 adds is that the omitted value may be a
// module `const` or `__callsite__`, and neither changes that: the const is one
// global read by every instance, and the location is per CALL SITE, which is a
// finer grain than per instance and therefore never confuses one.
//
// The `@log` lines for `tell` are ABSOLUTE line numbers of this file — editing
// the prose above them shifts what the case expects.
const TAG = "#"

function firstOr<T>(self: T[], tag: string = TAG) {
  if self.length == 0 { return tag }
  return tag + "!"
}
const ns: i32[] = [1, 2]
const ss: string[] = []
const fs: f64[] = [1.5]
print(firstOr(ns))
print(firstOr(ss))
print(firstOr(fs, "F"))
// The same three instances through the UFCS spelling, tail omitted.
print(ns.firstOr())
print(fs.firstOr())
print(ss.firstOr())

// A NESTED function's default resolves through the scope chain, and its call
// still goes through the capturing-call lowering.
function outer(n: i32) {
  function innerAdd(x: i32, y: i32 = 4) { x + y + n }
  return innerAdd(1)
}
print(outer(100))

// `__callsite__` on a generic's tail: three instances, three DIFFERENT locations,
// because the location belongs to the call and not to the instance.
function tell<T>(
  _x: T,
  c: { file: string, line: i32, col: i32 } = __callsite__,
) {
  return c.line
}
print(tell(1))
print(tell("s"))
print(tell(1.5))
