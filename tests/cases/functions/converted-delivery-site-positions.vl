// @warning `g != null` is always true here (g is (T) => void)
// @warning `B` is the same type as `A` ({v: i32}); this union has one member. help: add a discriminant field
// A generic function written into a nullable function slot typed by the enclosing T goes in by
// the slot's niche at a declaration, an assignment and a record field; a narrowed record goes into a nullable parameter by its niche; a returned `if` joining
// a nullable record with another record boxes it.
function b<U>(y: U) {
  print("G")
  print(y)
}
function sites<T>(x: T) {
  const d: ((t: T) => void) | null = b
  if d != null { d(x) }
  let h: ((t: T) => void) | null = null
  h = b
  if h != null { h(x) }
  const r: { f: ((t: T) => void) | null } = { f: null }
  r.f = b
  const g = r.f
  if g != null { g(x) }
}
sites(2.5)
sites("s")
type R = { v: i32 } | { v: i32 }
type A = { v: i32 }
type B = { v: i32 }
type N = A | B
const n: N = { v: 3 }
function some(x: { v: i32 } | null) { return x?.v ?? 0 }
const q: R = { v: 7 }
function narrowArg() {
  let o = 0
  if q is { v: i32 } { o = some(q) }
  return o
}
print(narrowArg())
print(n.v)
type In = { v: i32 }
type Sub = { v: i32, k: i32 }
const rec: In = { v: 9 }
let m = null
function pick(flag: boolean) { return if flag { m } else { rec } }
m = { v: 4, k: 1 }
print(pick(false)?.v ?? -1)
print(pick(true)?.v ?? -1)
