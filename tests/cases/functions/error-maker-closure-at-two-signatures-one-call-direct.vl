// @error this lambda is handed on at two different function types, and one lambda literal has one signature — bind it once per type, or annotate its parameters
// One maker call handed straight to its destination builds its own copy; the bound one, at
// another function type, shares the maker's one lambda: refused at check, never built (D16851).
function mk() { return (a) => a + 2.5 }
function take(a: (a: i32) => f64) { print(a(3)) }
function half(a: (a: f64) => f64) { print(a(0.5)) }
take(mk())
const z = mk()
half(z)
