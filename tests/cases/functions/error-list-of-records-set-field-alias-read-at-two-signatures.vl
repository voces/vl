// @error a list is passed as the same storage, so its element type cannot differ between `a` and this destination
// A binding's list delivered to an annotated list is one storage: a call through `a` at (i32)
// and the annotation's (f64) field cannot both hold (D17819).
function id(a) { return a }
function deliver() { return [{ f: id }] }
const a = deliver()
const b: { f: (a: f64) => f64 }[] = a
print(a[0].f(2))
print(b[0].f(2.5))
