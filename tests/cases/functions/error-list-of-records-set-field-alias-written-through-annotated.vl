// @error a list is passed as the same storage, so its element type cannot differ between `a` and this destination
// A record written through the annotated name and read through `a` at (i32): one storage meets
// two signatures, so the delivery is refused (D17819).
function id(a) { return a }
function dbl(a) { return a * 2 }
function deliver() { return [{ f: id }] }
const a = deliver()
const b: { f: (a: f64) => f64 }[] = a
b[0] = { f: dbl }
print(a[0].f(2))
