// @error cannot assign (boolean) => void to `k`, which holds (i32) => void since the write on line 8 — a binding holds one function type
// Two concrete functions of different types cannot both be written to one binding (D3960).
function inner<U>(u: U) { print(u) }
function q(n: i32) { print(n) }
function b(v: boolean) { print(v) }
function main() {
  let k = inner
  k = q
  k = b
}
main()
