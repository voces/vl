// @run
// @log 7
// @log 11
// @hint redundant type annotation: `scalarTail` is inferred as `i32` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// The function-VALUE variant of `nonvoid-bare-tail-value-arrives.vl`: a bare-tail
// callee bound to a `const` and called through the binding must keep returning its
// value. The wholesale `(…) => T` → `(…) => void` value coercion applies only where
// the EXPECTED type is void; a non-void-typed function value never discards.
function src(p: {r: i32}): {r: i32} | null { p }
const f = src
const got = f({ r: 7 })
print(got?.r ?? -1)

function scalarTail(n: i32): i32 { n + 4 }
const g = scalarTail
print(g(7))
