// @error cannot assign (T) => void to `k`: it keeps the generic type of its initializer
// A function typed by the enclosing generic's parameter is concrete in each instance (D3960).
function inner<U>(u: U) { print(u) }
function g<T>(f: (x: T) => void, x: T) {
  let k = inner
  k = f
  k(x)
}
g((b: boolean) => print(!b), true)
