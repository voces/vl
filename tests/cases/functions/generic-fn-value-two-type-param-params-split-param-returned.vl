// @log x
// @log 3
// A generic handed to two parameters of one type parameter, called at two types, runs when the
// parameter that takes a type parameter of its own is the result: the result type takes it too
// (D6425). As the tail, through `return`, with the result called, through an annotated binding,
// and twice inside a function.
function same<T>(k: T): T { k }
function take(a) { print(a("x")) }
function take2(a) { print(a(3)) }
function mid<F>(a: F, a1: F): F {
  take(a)
  take2(a1)
  a1
}
mid(same, same)
function mid2<F>(a: F, a1: F): F {
  take(a)
  take2(a1)
  return a1
}
const g = mid2(same, same)
print(g(4))
function mid3<F>(a: F, a1: F): F {
  take(a)
  take2(a1)
  const b: F = a1
  b
}
mid3(same, same)
function mid4<F>(a: F, a1: F): F {
  take(a)
  take2(a1)
  a1
}
function main() {
  mid4(same, same)
  mid4(same, same)
}
main()
