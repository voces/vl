// @check
// @error `__callsite__` is legal only as a parameter default value
// `__callsite__` is a DEFAULT-VALUE intrinsic, not an expression. Its whole
// meaning is "the site of the call that omitted this argument", and there is no
// such site in an ordinary expression position — the value would have to mean
// the position of the expression itself, which is a different feature (Zig's
// `@src()`, callee-side) that this deliberately is not.
//
// Nothing declares the name, so the floor a stray `__callsite__` would otherwise
// hit is `undeclared identifier` — a message that is true and useless, since the
// name DOES exist and the author only put it in the wrong place. This says
// where it belongs instead.
const C: { file: string, line: i32, col: i32 } = __callsite__
print(C.file)
