// @run
// @log 5
// @log 0.625
// @log 5
// @log 0.625
// @log 1
// @log s
// A maker with an un-annotated parameter returning a hole lambda, delivered at two function types
// whose results differ, builds a closure per delivered result, each at the type its call hands
// the parameter (D16778); a hole function returning named functions is no maker.
function adder(n) { return (a) => a + n }
const v: (a: i32) => i32 = adder(2)
const w: (a: i32) => f64 = adder(2)
print(v(3))
print(w(3) / 8.0)
function both() {
  const p: (a: i32) => i32 = adder(2)
  const q: (a: i32) => f64 = adder(2)
  print(p(3))
  print(q(3) / 8.0)
}
both()
function k<T>(t: T): T { return t }
function pick(on) {
  print(on)
  return k
}
const f = pick(1)
print(f("s"))
