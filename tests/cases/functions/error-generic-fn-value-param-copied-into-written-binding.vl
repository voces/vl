// @emit-error parameter `a` of `mid` is called at two function types that no parameter per type separates
// A generic parameter copied into a binding called at another type than the parameter itself
// is one value called at two types, which one type parameter cannot build, so it is refused
// rather than built at one instance and read at the other (D6423, open as D6470). The
// un-annotated binding is `error-generic-fn-value-param-copied-into-unannotated-binding.vl`.
function same<T>(k: T): T { k }
function take(a) { print(a("x")) }
function take2(a) { print(a(3)) }
function mid<F>(a: F, a1: F) {
  let b: F = a1
  b = a
  take(a)
  take2(b)
}
mid(same, same)
