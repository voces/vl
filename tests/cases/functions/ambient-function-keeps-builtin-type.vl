// @check
// D4066 — a top-level `function Map` / `function Set` shadows the ambient function at a call;
// `Map<…>` and `Set<…>` in type position still name the built-in types.
export function Map(n: i32): i32 { n * 2 }
export function Set(n: i32): i32 { n * 3 }
export function count(m: Map<string, i32>, s: Set<i32>): i32 {
  m.length + s.length + Map(1) + Set(1)
}
