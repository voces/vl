// @run
// @log 1.5
// @log 1.5
// @log 2.5
// @log 4
// @hint redundant type annotation: `s` is inferred as `f64`
// @hint redundant type annotation: `k` is inferred as `i32`
// D8220: a wrapper returning a direct call of an un-annotated function takes that call's result
// at its bound argument. Un-annotated, at an `f64` binding, as an `f64` argument and through a
// second level, `w(3)` is the `f64` `half` gives; an `i32`-preserving wrapper keeps `i32`.
function half(a) { return a / 2.0 }
function w(x) { return half(x) }
function w2(x) { w(x) }
function inc(a) { a + 1 }
function wi(x) { return inc(x) }
function takeF(v: f64) { print(v) }
const r = w(3)
print(r)
const s: f64 = w(3)
print(s)
takeF(w2(5))
const k: i32 = wi(3)
print(k)
