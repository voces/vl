// @run
// @log 1
// @log ab
// @log x
// @log ok
// @log 2
// @log q
// A returned union `if` with a `never` arm, in either arm, mid-chain and through a declared
// `never` function, and a union binding initialised the same way. The `never` arm builds as its
// own `unreachable`; the other arms box into the union (D1972).
function fail(m: string): never { __trap__(m) }
function r1(c: boolean): i32 | string { return if c { 1 } else { __trap__() } }
function r2(c: boolean): i32 | string {
  return if c { __trap__() } else { "ab" }
}
function r3(c: i32): i32 | string {
  return if c == 1 { 1 } else if c == 2 { __trap__() } else { "x" }
}
function r4(c: boolean): i32 | string {
  return if c { "ok" } else { fail("no") }
}
function r6(c: boolean): i32[] | string[] {
  if !c { return ["a"] }
  return if c { [1, 2] } else { __trap__() }
}
function b1(c: boolean) {
  const v: i32 | string = if c { "q" } else { __trap__() }
  if v is string { return v }
  "n"
}

const v1 = r1(true)
if v1 is i32 { print(v1) }
const v2 = r2(false)
if v2 is string { print(v2) }
const v3 = r3(3)
if v3 is string { print(v3) }
const v4 = r4(true)
if v4 is string { print(v4) }
print(r6(true).length)
print(b1(true))
