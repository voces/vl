// @check
// @error-at 18:16 `h` is parameter 2 but is written in position 1; name the arguments after it, or move it
// @error-at 19:16 `w` is already given by the positional argument in position 1; give it once
// @error-at 22:14 `c` is parameter 3 but is written in position 1; name the arguments after it, or move it
// @error-at 23:14 `b` is parameter 2 but is written in position 1; name the arguments after it, or move it
// @error-at 24:17 `a` is already given by the positional argument in position 1; give it once
// @error-at 27:18 `d` is parameter 2 but is written in position 1; name the arguments after it, or move it
// @error-at 28:18 `c` is already given by the positional argument in position 1; give it once
// @error-at 31:17 `b` is parameter 2 but is written in position 1; name the arguments after it, or move it
// @error-at 32:17 `a` is already given by the positional argument in position 1; give it once
// @error-at 35:6 a named argument binds one parameter and a rest parameter is many, so a call that reaches a rest parameter is positional
// A positional argument lands at its written index (D4061): after a named argument that is not
// in its own parameter's position it has no index to land at, and a name may not take a
// parameter a positional argument already filled. Each of these once bound silently to another
// parameter (`box(h: 3, 2)` printed 23). The receiver of a method call is position 0, so `d`,
// the third declared parameter, is parameter 2. A call that reaches a rest parameter keeps its
// own refusal of names.
function box(w: i32, h: i32) { w * 10 + h }
print(box(h: 3, 2))
print(box(3, w: 2))

function f(a: i32, b: i32 = 1, c: i32 = 2) { a * 100 + b * 10 + c }
print(f(c: 5, 1, 7))
print(f(b: 5, 1))
print(f(1, 2, a: 3))

function m(self: i32, c: i32, d: i32) { self * 100 + c * 10 + d }
print((5).m(d: 1, 2))
print((5).m(1, c: 2))

function pick<T>(a: T, b: T): T[] { [b, a] }
print(pick(b: 3, 2)[0])
print(pick(3, a: 2)[0])

function r(a: i32, ...xs: i32[]) { a + xs.length }
print(r(a: 1, 2, 3))
