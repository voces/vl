// @run
// @log 2
// @log 5
// @log -1
// @log -2.5
// @log 10
// @log 8
// @log -5
// @log -4
// A `const` record literal of a hole its function never calls, handed on to a callee that calls
// the field at two types, runs as the literal written as the argument does (D15700): at one
// instance, at two, and beside a direct call of the hole at two instances.
function dbl(v) { return v + v }
function neg(v) { return -v }
function call0(r, x) {
  print(r.f(1))
  print(r.f(x))
}
function both(g) {
  const r = { f: g }
  call0(r, 2.5)
}
both(dbl)
both(neg)
function call1(r, x) { print(r.f(x)) }
function run(g) {
  print(g(5))
  const r = { f: g }
  call1(r, 4)
}
run(dbl)
run(neg)
