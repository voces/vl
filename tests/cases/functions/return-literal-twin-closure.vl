// @run
// @log 2
// @log 3
// A record literal returned from a function whose inferred result is a declared twin of it (a
// nullable record field beside a non-null one), cell `closure`: built at the result's row and rep,
// or, where a nested literal sits at another rep, a named miss (return coercion).
type F = (i32) => i32
type K = { j: F | null }
function mk() { return { j: (x: i32) => x + 1 } }
const y = mk()
print(y.j(1))
const k: K = mk()
print(if k.j == null { 0 } else { k.j(2) })
