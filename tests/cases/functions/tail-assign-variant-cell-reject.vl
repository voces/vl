// @emit-error ref valtype with no interned shape
// A tail assignment to a union-VARIANT cell (`Circle`, kind `variant`), consumed nowhere —
// the `nulreflist` sibling's exact shape, one heap table over. `fnAssignRetKind` NAMES the
// kind; `emit_sections`' inferred-return arm resolves an `infSlot` for `struct` /
// `nulstruct` / `reflist` / `map` only, so a `variant` result reaches `fbValtype` with slot
// -1 and its out-of-bounds guard rejects there.
//
// PINNED AS A REJECT ON PURPOSE, and it is a REPAIR: `fnAssignKindGuard` used to DECLINE
// `variant` beside `map` / `nulmap`, and the decline is what made this program `vl check`-
// clean (rc 0) with a module that FAILED TO VALIDATE — `type mismatch: expected i32, found
// (ref $type)` at byte offset 253. `null` from that guard is not a neutral answer; it
// restores the `i32` default, and an `i32` result valtype under a body that pushes a ref is
// silent invalid wasm. Naming the kind and letting `fbValtype` refuse the missing slot is
// the strictly better outcome class, exactly as it already was for `nulreflist`.
//
// THE UN-ANNOTATED SPELLING IS THE SAME CELL: `let c = mkCircle()` classifies through
// `letInitCellKind`, which since #1935 mirrors `collectLocals` arm for arm and so names
// `variant` here too. Both spellings reach this one reject; before #1935 they disagreed,
// the annotated one being the invalid-wasm half.
//
// It GRADUATES to `@run` the moment `emit_sections` learns to mint a `uVarHeap` slot for an
// inferred return, the same line the `nulreflist` pin is waiting on for `rlWrapIdx`.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq

export function area(sh: Shape) {
  if sh is Circle { return sh.r }
  0
}

function mkCircle(): Circle { return { r: 3 } }
function mkBigger(): Circle { return { r: 9 } }

function bumpAnn() {
  let c: Circle = mkCircle()
  return (c = mkBigger())
}

bumpAnn()
print(9)
