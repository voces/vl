// @run
// @log 4
// @log 3
// @log 4
// @log 3
// A lambda handed to a list element that calls it at two instances is typed through that
// element, at each instance, at index 0 as past it (D10893).
function apply2(g) { print(g(1, 2)) }
function apply3(g) {
  print(g(1.5, 2.5))
  print(g(1, 2))
}
const gs = [apply2, apply3]
gs[1]((a, b) => a + b)
const hs = [apply3, apply2]
hs[0]((a, b) => a + b)
