// @error a {f: (_) => _} cannot be delivered as {f: (f64) => f64} here
// An annotated callback parameter of a second `.map` consumes the first map's elements, so the
// identity map's callback is typed there: it hands on shared records, refused (D17827).
function id(a) { return a }
function deliver() { return [{ f: id }] }
const v: { f: (a: f64) => f64 }[] = deliver().map((r) => r).map((q: { f: (a: f64) => f64 }) => ({ f: q.f }))
print(v[0].f(2.5))
