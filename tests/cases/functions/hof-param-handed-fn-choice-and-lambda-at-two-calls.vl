// @run
// @log 5
// @log e
// @log 5
// @log e!
// @log 3
// An instance of a higher-order function judges only the choice of functions its own call hands
// over, so an `if` of un-annotated functions handed at one call is not judged at another call's
// lambda argument type (D16831).
function app<A, B>(f: (x: A) => B, x: A): B { return f(x) }
function happ(f, x) { return f(x) }
function hinc(x) { return x + 1 }
function hid(x) { return x }
const c = 3 > 2
const h = if c { hinc } else { hid }
print(app(h, 4))
print(app((s: string) => s, "e"))
print(happ(h, 4))
print(happ((s: string) => s + "!", "e"))
print(app((s: string) => s.length, "abc"))
