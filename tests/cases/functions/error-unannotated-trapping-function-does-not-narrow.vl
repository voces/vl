// @check
// @error operator '*' is not defined for i64 | IoError and i32
// A function that only traps but does not DECLARE `: never` infers `void`, so a call to it is
// an ordinary statement and does not end the guard's path. Inference never produces `never`:
// the annotation is the contract, and adding one is what makes `fail` a terminator. D1972.
type IoError = { msg: string }
function fail(msg: string) {
  print(msg)
  __trap__()
}
function f(x: i64 | IoError): i64 {
  if x is IoError { fail("io") }
  x * 2
}
print(f(3 as i64))
