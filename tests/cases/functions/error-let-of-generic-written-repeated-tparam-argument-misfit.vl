// @error argument 1: expected boolean, got i32
// A call through the binding checks each argument against the parameters of the generic its
// most recent write stored, under that generic's bindings, as a direct call does (D3968, D15956).
function s<A, B>(a: A, b: B) { print(a); print(b) }
function w<A>(a: A, b: A) { print(a); print(b * 2) }
function main() {
  let k = s
  k = w
  k(5, true)
}
main()
