// @error argument 2: expected i32, got boolean
// A call through the binding checks each argument against the parameters of every generic
// written to it, under that generic's bindings, as a direct call does (D3968).
function s<A, B>(a: A, b: B) { print(a); print(b) }
function w<A>(a: A, b: A) { print(a); print(b * 2) }
function main() {
  let k = s
  k = w
  k(5, true)
}
main()
