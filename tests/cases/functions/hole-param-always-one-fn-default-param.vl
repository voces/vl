// @run
// @log 3
// @log 4
// @log 3
// @log 4
// @log 5
// @log 4
// A hole parameter handed the same module function at every call is that function, so it is
// called by name at both types, beside a defaulted parameter and one given (D6481).
function add(a, b) { return a + b }
function apply2(g, n: i32 = 1) {
  print(g(n, 2))
  print(g(1.5, 2.5))
}

print(add(1, 2))
print(add(1.5, 2.5))
apply2(add)
apply2(add, 3)
