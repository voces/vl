// @error return type mismatch: expected void, got i32 — a bare `return` in this body makes the function void; drop it, or return no value here
// A bare `return` and a valued `return` in one un-annotated body disagree about what the
// function returns, and the bare one wins: it pins the return type to void, so the valued one
// is a mismatch (D1600). Nobody wrote `: void`, so the sentence has to say where the void came
// from — the emitter's old reject named the function and not the line that decided it.
function f(c: boolean) {
  if c { return }
  return 5
}
f(true)
