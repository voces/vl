// @log 4
// @log 3
// @log 4
// A generic handed to a hole parameter by a named argument, in parameter order, takes a
// parameter per type its calls use, beside a positional call and through a forward (D6260).
function add(a, b) { return a + b }
function apply2(g) {
  print(g(1, 2))
  print(g(1.5, 2.5))
}
apply2(g: add)
function apply3(x: i32, g) {
  print(g(x, 2))
  print(g(1.5, 2.5))
}
apply3(x: 1, g: add)
apply3(5, add)
function fwd(h) { apply2(g: h) }
fwd(h: add)
