// @run
// @log 7
// @log 0
// CONTRACT (D937): an un-annotated function whose returns join to a NULLABLE MAP
// (`{[string]: i32} | null`) LOWERS, exactly as the annotated spelling always did. It used to
// floor with `'pick' infers the nullable return type {[string]: i32} | null — type-valid, but
// an inferred return of this shape is not yet supported by codegen; annotate the return type`,
// which concedes the program's type-validity in its own sentence — a capability refusal and so
// a clause-2 violation of the standing goal, and one NO corpus cell reaches (the corpus is
// generated over fixed axes; `goal-scoreboard.py --sites` is what counts these).
//
// The map's rep is a ref (the kind-3 map struct), so `| null` is the same niche the nullable
// STRUCT return takes — D887's shape, one inner over. FIVE sites had to agree, and each was
// measured to still fail before the next was added:
//
//   1. `nullableRetName`      — render the name at all (it had no map arm)
//   2. `buildFnMap`           — classify the recorded name as kind `nulmap`
//   3. `retKindPri`           — rank `nulmap` ABOVE `map`, or `criClassify` sees the returned
//                               map local and overwrites the nullable fact with the non-null one
//   4. `emitReturnValue`      — seed `pendingNulRefHeap` so a bare `return null` types
//   5. `exprNullableMap`      — the CALLER's `const r = pick(…)` binds a nullable cell, so
//                               `if r != null` has a typed null to compare against
//
// Both branches are exercised, and the null one is not decorative: with site 4 missing the
// value branch alone still built.
function pick(c: boolean) {
  if c { return null }
  const m: {[string]: i32} = Map()
  m["k"] = 7
  m
}

function show(c: boolean) {
  const r = pick(c)
  if r != null { print((r)["k"]) } else { print(0) }
}

show(false)
show(true)
