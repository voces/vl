// @run
// @log 8
// @log 7
// @log 35
// A written generic `let` called directly holds its set's id; listed beside another function at a
// closed type, its element is the member's closure there, in either order and handed to a generic
// that pins the list's type (D16361).
function id<T>(x: T): T { return x }
function inc(x: i32) { return x + 1 }
function run<U>(a: ((x: U) => U)[], u: U): U { return a[1](u) }
let v = id
v = id
const fs: ((x: i32) => i32)[] = [v, inc]
print(fs[1](2) + v(5))
const gs: ((x: i32) => i32)[] = [inc, v]
print(gs[1](2) + v(5))
print(run([v, inc], 2) * 10 + v(5))
