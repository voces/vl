// @check
// @error a rest parameter must be last — `...xs` is followed by `y`
// @error a function has at most one rest parameter, and `as` is already this one's
// @error a rest parameter packs its arguments into a list — write `...ns: T[]`
// @error a rest parameter is the empty list when no argument reaches it, so `ds` cannot carry a default
// @error `self` is the receiver and comes first, so it cannot be a rest parameter
// @error a rest parameter is the empty list when no argument reaches it, so `os` cannot also be optional
// Every refusal a rest parameter's own DECLARATION owes, each naming the fix. All six are
// the design's rules and not a capability gap: a rest is last so the pack has a boundary,
// it is a list so the callee has something to read, and it is empty rather than defaulted
// or optional because "no argument reached it" already has a value.
function notLast(...xs: i32[], y: i32): i32 { return y }
function twice(...as: i32[], ...bs: i32[]): i32 { return 1 }
function untyped(...ns): i32 { return 1 }
function defaulted(...ds: i32[] = [1]): i32 { return 1 }
function receiver(...self: i32[]): i32 { return 1 }
function optional(...os?: i32[]): i32 { return 1 }
print(1)
