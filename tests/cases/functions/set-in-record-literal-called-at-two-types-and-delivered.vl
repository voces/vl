// A choice of named functions in a record literal, called at two types in the callee and also
// delivered to a closed function type: the callee dispatches by tag, and the delivery is the
// closure of the member the id names (D15642).
function id(v) { return v }
function dbl(v) { return v + v }
function neg(v) { return 0 - v }
function dec(v) { return v - 1 }
function inc(v: i32) { return v + 1 }
function call0(r, x) { print(r.f(x)) }
function callP(r, x) { print(r.f(x)) }
function callL(l, x) { print(l[0](x)) }
function keep(f: (i32) => i32) { print(f(1)) }
function keepF(f: (f64) => f64) { print(f(1.5)) }
function run(b) {
  const g = if b { id } else { dbl }
  call0({ f: g }, 3)
  call0({ f: g }, 2.5)
  keep(g)
}
run(true)
run(false)
function atTwoClosedTypes(b) {
  const g = if b { id } else { dbl }
  call0({ f: g }, 3)
  call0({ f: g }, 2.5)
  keep(g)
  keepF(g)
}
atTwoClosedTypes(false)
function threeMembers(b, c) {
  const g = if b { id } else if c { dbl } else { neg }
  call0({ f: g }, 3)
  call0({ f: g }, 2.5)
  keep(g)
}
threeMembers(true, true)
threeMembers(false, false)
function inList(b) {
  const g = if b { id } else { dbl }
  callL([g], 3)
  callL([g], 2.5)
  keep(g)
}
inList(false)
function annotatedBinding(b) {
  const g = if b { id } else { dbl }
  call0({ f: g }, 3)
  call0({ f: g }, 2.5)
  const h: (i32) => i32 = g
  print(h(7))
}
annotatedBinding(false)
function pick(b): (i32) => i32 {
  const g = if b { id } else { dbl }
  call0({ f: g }, 2.5)
  return g
}
print(pick(false)(4))
function mapped(b) {
  const g = if b { id } else { dbl }
  call0({ f: g }, 3)
  call0({ f: g }, 2.5)
  print([1, 2].map(g)[1])
}
mapped(false)
function annotatedField(b) {
  const g = if b { id } else { dbl }
  call0({ f: g }, 3)
  call0({ f: g }, 2.5)
  const r: { f: (i32) => i32 } = { f: g }
  print(r.f(5))
}
annotatedField(false)
function plainMember(b) {
  const g = if b { dec } else { inc }
  callP({ f: g }, 3)
  keep(g)
}
plainMember(true)
plainMember(false)
