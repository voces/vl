// @run
// @log 5
// @log 5
// @log 4
// A call to an un-annotated function, handed an un-annotated function declared below it in a list
// or through a `const`, checks that function first: the result it reads is the instance's, not open.
const l = c4([dbl], 2.5)
print(l)
const fs = [dbl]
print(c4(fs, 2.5))
print(c4([dbl], 2))
function dbl(v) { return v + v }
function c4(r, x) { return r[0](x) }
