// @run
// @log 2
// @log 2
// @log 2.5
// @log 4
// @log 5
// A `const` bound to a value `if` of records of un-annotated functions, handed to an un-annotated
// parameter that calls the field, dispatches by tag in the callee (D15330).
function id1(a) { return a }
function id2(a) { return a }
function dbl(a) { return a + a }
function id3(a) { return a }
const c = 1 > 0
function g(r) { return r.f(2) }
const k = if c { { f: id1 } } else { { f: id2 } }
print(g(k))
function g2(r) { return r.f(2) }
function h(r) { return r.f(2.5) }
function pick(c) {
  const k = if c { { f: id3 } } else { { f: dbl } }
  print(g2(k))
  print(h(k))
}
pick(true)
pick(false)
