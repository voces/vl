// @run
// @log 7
// @log b
// @log 1
// @log 2
// @log 3
// @log four
// @log 5
// @log b
// @log 6
// A function body's LAST statement may be an ASSIGNMENT, which makes it the implicit
// RETURN (DECISIONS: assignment-as-expression). `tail-assign-inferred-return.vl` pins
// the NON-coercing cells; this file pins the COERCING ones, which were every one of
// them INVALID WASM on a `vl check`-clean program (rc 0) until the functype started
// asking the assignment TARGET.
//
// The lowering is STORE-then-RE-READ (`emitBinExprNode`'s `=` arm, `wasmEmit.vl`), so
// the value the body pushes is the target CELL's rep — the RHS *coerced to the target's
// declared type*. `criClassify` (`emit_classify.vl`) now reads that same cell through
// `globalCellKind`, the resolver the global section and every read of the global also
// use, so the three cannot drift. Reading the RHS instead was right only by coincidence
// (a `string` cell assigned a string needs no coercion); every line below is a store
// that DOES coerce.
type S = { n: i32 }
type K = "a" | "b"
type Cat = { legs: i32 }
type Dog = { tail: i32 }
type U = Cat | Dog

// A WIDENING store: an i32 literal into an i64 cell. The RHS answer was `i32` over a
// body pushing i64.
let wide: i64 = 0

function setWide() { wide = 7 }

setWide()
print(wide)

// A LITERAL-UNION cell is an i32-backed interned ATOM; the RHS answer was `str`, so the
// functype promised `(ref $array)` over a body pushing the atom.
let k: K = "a"

function setK() { k = "b" }

setK()
print(k)

// A NULLABLE-STRUCT cell assigned `null`: the RHS `null` classified as nothing at all,
// so the functype defaulted to i32 over a body pushing `(ref null $S)`.
let ns: S | null = null

function clearNs() { ns = null }

clearNs()
if ns == null { print(1) }

// The same cell assigned a VALUE — the mirrored disagreement (the RHS is a plain
// struct, the cell is the nullable one).
let ns2: S | null = null

function setNs2() { ns2 = { n: 2 } }

setNs2()
if ns2 != null { print(ns2.n) }

// A NULLABLE i32-LIST cell (kind 15).
let nl: i32[] | null = null

function setNl() { nl = [3] }

setNl()
if nl != null { print(nl[0]) }

// A NULLABLE STRING-LIST cell — its own `(ref null $mkList)` wrapper, not the i32 one.
let nsl: string[] | null = null

function setNsl() { nsl = ["four"] }

setNsl()
if nsl != null { print(nsl[0]) }

// A UNION cell: the store BOXES the variant literal, so the body pushes the box while
// the RHS answer named the bare variant shape.
let u: U = { legs: 4 }

function setU() { u = { tail: 5 } }

setU()
if u is Dog { print(u.tail) }

// A `K | null` NICHE cell — the i32 atom with `-1` for null.
let nk: K | null = null

function setNk() { nk = "b" }

setNk()
if nk != null { print(nk) }

// An `i32 | null` cell.
let ni: i32 | null = null

function setNi() { ni = 6 }

setNi()
if ni != null { print(ni) }
