// @run
// @log 6
// @log 6
// @log 6
// @log 3
// @log 6
// @log 5
// @log 11
// @log 6
// @hint redundant type annotation: `tw` is inferred as `f64`
// A function handed on inside a list or record literal to a callee that calls the element or
// field gives the call the result of that instance, as the direct spelling does (D15645).
function dbl(v) { return v + v }
function c1(r, x) { return r[0](x) }
function cf(r, x) { return r.f(x) }
function c2(r, x) { return r.f(x) + r.h(x) }
function cn(r, x) { return r[1](x) }
function both1(g) { return c1([g], 2.5) }
function bothF(g) { return cf({ f: g }, 2.5) }
function bothC(g) {
  const r = [g]
  return c1(r, 2.5)
}
function bothD(g) {
  print(g(1.5))
  return cf({ f: g }, 2.5)
}
function bothN(g) { return cn([dbl, g], 2) }
function bothH(g) { return c2({ f: g, h: g }, 2.5) }
const b = both1(dbl)
print(b + 1)
const bf = bothF(dbl)
print(bf + 1)
print(bothC(dbl) + 1)
const bd = bothD(dbl)
print(bd + 1)
print(bothN(dbl) + 1)
print(bothH(dbl) + 1)
const tw: f64 = both1(dbl)
print(tw + 1)
