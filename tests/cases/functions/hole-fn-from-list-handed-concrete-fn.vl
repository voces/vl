// @run
// @log 2
// @log 2
// @log 11
// @log 21
// A concrete function handed to a hole function read out of a list builds: the list's element
// type renders with the hole parameter's result left unnamed (D6794).
function inc(a: i32) { return a + 1 }
function apply2(g) { print(g(1)) }
const fs = [apply2]
fs[0](inc)
const h = fs[0]
h(inc)
function apply1(g) { print(g(10)) }
const gs = [apply1]
gs[0](inc)
gs[0]((x: i32) => x * 2 + 1)
