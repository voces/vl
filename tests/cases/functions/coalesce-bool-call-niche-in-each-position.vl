// @log fb
// @log T
// @log fb
// @log true
// @log fb
// @log <T>
// @log fb
// @log [true]
// @log fb
// @log true
// @log fb
// @log true
// @log fb
// @log true
// @log fb
// @log false
// @log fb
// @log true
// @log fb
// @log true
// A `??` over a call returning `boolean | null`, stashed once and tested against its sentinel, in
// each position: a scalar and a union argument, a nested argument, a concat operand, an
// interpolation hole, a return, an initializer, an `if` arm, a `??` operand, a record field and
// after an operand; its call runs once.
type R = { b: boolean }
function fb(k: i32): boolean | null {
  print("fb")
  if k > 1 { return true }
  if k > 0 { return false }
  return null
}
function neg(b: boolean) { return !b }
function show(u: boolean | string) {
  if u is string { return u } else { return if u { "T" } else { "F" } }
}
function id(b: boolean) { return b }
function argScalar(k: i32) { return neg(fb(k) ?? true) }
function argUnion(k: i32) { return show(fb(k) ?? false) }
function argNested(k: i32) { return neg(id(fb(k) ?? false)) }
function concat(k: i32) { return "<" + show(fb(k) ?? true) + ">" }
function interp(k: i32) { return "[\{fb(k) ?? false}]" }
function ret(k: i32) { return fb(k) ?? true }
function letInit(k: i32) {
  const b = fb(k) ?? false
  return !b
}
function ifArm(k: i32, c: boolean) {
  const b = if c { fb(k) ?? true } else { false }
  return b
}
function coal(k: i32) { return (fb(k) ?? null) ?? true }
function rec(k: i32) {
  const r: R = { b: fb(k) ?? false }
  return r
}
function after(a: boolean, k: i32) { return a && (fb(k) ?? true) }
print(argScalar(0))
print(argUnion(2))
print(argNested(1))
print(concat(0))
print(interp(2))
print(ret(0))
print(letInit(1))
print(ifArm(0, true))
print(coal(1))
print(rec(2).b)
print(after(true, 0))
