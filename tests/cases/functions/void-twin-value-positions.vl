// @run
// @log 1
// @log 2
// @log 1
// @log 1
// @log 1
// @log 2
// @log 2
// @log 2
// @log 1
// @hint redundant type annotation: `h` is inferred as `i32` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// @hint redundant type annotation: `hs` is inferred as `string` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// A named function returning a value, taken where `() => void` is expected, is its void twin at
// each delivery position: a call argument, a module binding, a local binding, a record field, a
// list element, a function result, a reassigned let and a map value.
function h(): i32 {
  print(1)
  return 7
}
function hs(): string {
  print(2)
  return "x"
}
function run(cb: () => void) { cb() }
// a call argument
run(h)
// a module binding
const k: () => void = hs
k()
// a local binding inside a function, then called
function inner() {
  const kk: () => void = h
  kk()
}
inner()
// a record field
type Handler = { on: () => void }
const hd: Handler = { on: h }
hd.on()
// a list element
const fs: (() => void)[] = [h, hs]
for f in fs { f() }
// a function result
function pick(): () => void { return hs }
pick()()
// a reassigned module let
let cur: () => void = h
cur = hs
cur()
// a map value
const m = Map<string, () => void>()
m["a"] = h
const g = m.get("a")
if g != null { g() }
