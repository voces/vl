// @emit-error Call sites pin `add` at (i32, i32), (f64, f64)
// An exported callback's signature is what an importer sees, so a hole parameter of one does
// not take a parameter per type, and a generic called through it at two signatures reaches the
// emitter's floor (D6091). What this case pins is the DIAGNOSTIC's informative branch: `add` is
// instanced at (i32, i32) and (f64, f64), and the reject names them. The no-call-site branch
// is `error-generic-alias-never-called.vl`; the callback that runs is
// `generic-fn-value-inferred-hof.vl`.
function add(a, b) { return a + b }
export function apply2(g) {
  print(g(1, 2))
  print(g(1.5, 2.5))
}

print(add(1, 2))
print(add(1.5, 2.5))
apply2(add)
