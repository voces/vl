// @run
// @log 6
// @log 5
// @log 12
// @log 15
// @log 6
// @log ab!
// @log 13
// D5881: an un-annotated lambda handed to a call of an un-annotated function parameter, directly
// or on through a forwarder, takes its parameter types from the function the call is bound to.
function two(a: i32, b: (n: i32) => i32) { b(a) }
function one(b: (n: i32) => i32) { b(4) }
function pair(b: (x: i32, y: i32) => i32) { b(3, 4) }
function name(b: (s: string) => string) { b("ab") }
function direct(h) { return h(3, (n) => n * 2) }
function oneArg(h) { return h((n) => n + 1) }
function twoParams(h) { return h((x, y) => x * y) }
function capturing(h, k) { return h(3, (n) => n * k) }
function apply(g, x, y) { return g(x, y) }
function app1(g, y) { return g(y) }
function viaApply(h) { return apply(h, 3, (n) => n * 2) }
function viaApp1(h) { return app1(h, (s) => s + "!") }
function mid(h, x, f) { return apply(h, x, f) }
function twoHops(h) { return mid(h, 3, (n) => n + 10) }
print(direct(two))
print(oneArg(one))
print(twoParams(pair))
print(capturing(two, 5))
print(viaApply(two))
print(viaApp1(name))
print(twoHops(two))
