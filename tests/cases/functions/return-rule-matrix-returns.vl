// @run
// @hint redundant type annotation: `id` is inferred as `i32`
// @hint redundant type annotation: `a_expr` is inferred as `i32`
// @hint redundant type annotation: `a_call` is inferred as `i32`
// @hint redundant type annotation: `a_ifelse` is inferred as `i32`
// @hint redundant type annotation: `a_match` is inferred as `i32`
// @log 2
// @log 2
// @log 2
// @log 2
// @log 1
// @log 1
// @log 1
// @log 2
// @log 1
// @log 1
// @log 1
// @log 2
// @log 1
// @log 1
// @log 1
// @log 2
// @log 6
// @log 6
// @log 6
// @log 2
// Every tail kind with `return` runs: annotated, inferred, a typed lambda and a `map` callback.
function id(v: i32): i32 { return v }
function a_expr(x: i32): i32 {
  return x + 1
}
function i_expr(x: i32) {
  return x + 1
}
const l_expr: (x: i32) => i32 = (x: i32) => {
  return x + 1
}
print(a_expr(1))
print(i_expr(1))
print(l_expr(1))
print([1, 2].map((x: i32) => {
  return x + 1
}).length)
function a_call(x: i32): i32 {
  return id(x)
}
function i_call(x: i32) {
  return id(x)
}
const l_call: (x: i32) => i32 = (x: i32) => {
  return id(x)
}
print(a_call(1))
print(i_call(1))
print(l_call(1))
print([1, 2].map((x: i32) => {
  return id(x)
}).length)
function a_ifelse(x: i32): i32 {
  return if x > 0 { 1 } else { 2 }
}
function i_ifelse(x: i32) {
  return if x > 0 { 1 } else { 2 }
}
const l_ifelse: (x: i32) => i32 = (x: i32) => {
  return if x > 0 { 1 } else { 2 }
}
print(a_ifelse(1))
print(i_ifelse(1))
print(l_ifelse(1))
print([1, 2].map((x: i32) => {
  return if x > 0 { 1 } else { 2 }
}).length)
function a_elseless(x: i32): i32 | null {
  return if x > 0 { 1 }
}
function i_elseless(x: i32) {
  return if x > 0 { 1 }
}
const l_elseless: (x: i32) => i32 | null = (x: i32) => {
  return if x > 0 { 1 }
}
print(a_elseless(1) ?? 0)
print(i_elseless(1) ?? 0)
print(l_elseless(1) ?? 0)
print([1, 2].map((x: i32) => {
  return if x > 0 { 1 }
}).length)
function a_match(x: i32): i32 {
  return match x {
    0 => 5
    _ => 6
  }
}
function i_match(x: i32) {
  return match x {
    0 => 5
    _ => 6
  }
}
const l_match: (x: i32) => i32 = (x: i32) => {
  return match x {
    0 => 5
    _ => 6
  }
}
print(a_match(1))
print(i_match(1))
print(l_match(1))
print([1, 2].map((x: i32) => {
  return match x {
    0 => 5
    _ => 6
  }
}).length)
