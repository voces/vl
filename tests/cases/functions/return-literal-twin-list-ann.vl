// @run
// @log 2
// A record literal returned from a function whose inferred result is a declared twin of it (a
// nullable record field beside a non-null one), cell `list-ann`: built at the result's row and rep,
// or, where a nested literal sits at another rep, a named miss (return coercion).
type K = { j: i32[] | null }
function mk(): K { return { j: [1, 2] } }
const k = mk()
print(if k.j == null { 0 } else { k.j.length })
