// @run
// @log 5
// @log s
// @log 5
// @log s
// @log 7
// @log u
// @log 8
// @log vv
// A hole list parameter handed on whole, or its element bound to a `const` and handed on, takes
// each type's instance of the function the list was given at the callee that calls it (D15620,
// D15621, D15626).
function id(v) { return v }
function dbl(v) { return v + v }
function call1(f, x) { print(f(x)) }
function viaConst(fs, x) {
  const h = fs[0]
  call1(h, x)
}
function runConst(g) {
  viaConst([g], 5)
  viaConst([g], "s")
}
runConst(id)
function mid(fs, x) { print(fs[0](x)) }
function whole(fs, x) { mid(fs, x) }
function runWhole(g) {
  whole([g], 5)
  whole([g], "s")
}
runWhole(id)
function call2(fs, x) { print(fs[1](x)) }
function fwd(fs, x) { call2(fs, x) }
function runJoined(g, h) {
  fwd([g, h], 7)
  fwd([g, h], "u")
}
runJoined(dbl, id)
function runDbl(g) {
  whole([g], 4)
  whole([g], "v")
}
runDbl(dbl)
