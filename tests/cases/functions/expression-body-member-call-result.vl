// @run
// @log true
// @log true
// @log b
// @log a
// @log false
// @log 2
// @log true
// @log false
// @log true
// @log true
// @log 1
// @log a
// @log 2
// @log false
// D2566: a function whose expression body is a value-yielding member call (`xs.map(…)`,
// `xs.slice(…)`) types its result from that call, as the `return` spelling does, rather than
// declaring the default `i32` over a body that builds a list. The generic spellings are D2543.
type K = "a" | "b"
function g(x: i32) { [x, 7].map((e) => e == 7) }
function gAnn(x: i32) { [x, 7].map((e): boolean => e == 7) }
function gLit(x: i32) { [x, 7].map((e): K => if e > 6 { "b" } else { "a" }) }
function gNot(x: i32) { [x == 7, true].map((e) => !e) }
function gChain(x: i32) { [x, 7].map((e) => e == 7).filter((b) => b) }
function gSlice(xs: boolean[]) { xs.slice(0, 1) }
function gNull<T>(x: T) { [x, null].map((e) => e == null) }
function gEq<T>(x: T) { [x, x].map((e) => e == x) }
function f<T>(x: T[]) { x.slice(0, 1) }
function m<T>(x: T[]) { x.filter((e) => e == x[0]) }
function n<T>(x: T[]) { x.map((e) => e == x[0]) }
print(g(5)[1])
print(gAnn(5)[1])
print(gLit(5)[1])
print(gLit(5)[0])
print(gNot(5)[1])
print(gChain(7).length)
print(gSlice([true, false])[0])
print(gNull(5)[0])
print(gNull("s")[1])
print(gEq(5)[1])
print(f([1, 2, 3]).length)
print(f(["a", "b"])[0])
print(m([true, false, true]).length)
print(n(["a", "b"])[1])
