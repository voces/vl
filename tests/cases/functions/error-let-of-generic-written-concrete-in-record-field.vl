// @error cannot assign (i32) => void to (boolean) => void — `k` holds (i32) => void since the write on line 8
// A record literal's field delivers the binding to the field's type (D3960).
function inner<U>(u: U) { print(u) }
function cI32(n: i32) { print(n + 100) }
type R = { f: (b: boolean) => void }
function main() {
  let k = inner
  k = cI32
  const r: R = { f: k }
  r.f(true)
}
main()
