// @run
// @log 11
// @log 21
// THE FIRST HALF OF A TWO-FILE PAIR that pins the PER-PROGRAM RESET of the scope-chain
// child index (`fnChildHead`/`fnChildNext` in `emit_collect.vl`, `fnParent` inverted).
//
// The index is a derived cache, rebuilt on first use and freshness-tested by LENGTH. A
// length test alone is not a reset: in a SHARED `WebAssembly.Instance` — which is exactly
// how `tests/cases_wasm_test.ts` and `vl check <dir>` compile a whole corpus — the next
// program keeps the previous one's columns whenever the two agree on `fnStmts.length`.
//
// This file's shape is chosen to be the poisoning one: FOUR functions, parents
// `[-1, -1, 0, 1]` — two top-level makers that each declare their own nested `inner`, so
// frame 0's child list is `[2]` and frame 1's is `[3]`. Its sibling `-b` has the SAME four
// functions with parents `[-1, -1, -1, 2]`, so under a stale index frame 2 looks childless
// and its `inner` call falls through to the module's TOP-LEVEL `inner` — a silent wrong
// answer, which is what `-b`'s `@log` pins.
function makeA(x: i32) {
  function inner(y: i32) {
    return y + 10
  }
  return inner(x)
}

function makeB(x: i32) {
  function inner(y: i32) {
    return y + 20
  }
  return inner(x)
}

print(makeA(1))
print(makeB(1))
