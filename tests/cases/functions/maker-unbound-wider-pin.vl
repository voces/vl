// @run
// @log 5
// @log 8
// @log 5
// A maker called at a wider pin whose result nothing calls, then at a narrower one that is called:
// each instance's lambda returns its own pin's type, never a sibling instance's narrower call (D16817).
function cap(n) { return () => n }
function adder(n) { return (a) => a + n }
function gcap<T>(n: T) { return () => n }
cap(2.5)
const w = cap(5)
print(w())
adder(2.5)
const a = adder(5)
print(a(3))
gcap(2.5)
const g = gcap(5)
print(g())
