// @run
// @log 3
// @log true
// @log true
// @log 3
// @log 4
// A rest parameter whose element is inferred as `i32 | boolean` packs a boxed list, the
// rep the concrete spelling `...xs: (i32 | boolean)[]` gives it, and the instance reads it so (D4830).
function each<T>(...xs: T[]) {
  for x in xs { print(x) }
}
each(3, true)
function second<T>(...xs: T[]): T { return xs[1] }
print(second(1, true))
function again<T>(...xs: T[]): T[] {
  xs.push(xs[0])
  return xs
}
const r = again(4, false)
print(r.length)
print(r[2])
