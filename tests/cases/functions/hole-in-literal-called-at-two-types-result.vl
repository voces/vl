// @run
// @log 2
// @log 6
// @log 2
// @log 6
// @log 2
// @log 6
// A function handed on inside a list or record literal and also called at another type gives a
// call returning one element or field call the result of that call's instance (D15645).
function dbl(v) { return v + v }
function c1(r, x) { return r[0](x) }
function cf(r, x) { return r.f(x) }
function bothE(g) {
  const r = [g]
  print(r[0](1))
  return c1(r, 2.5)
}
function c3(r, x) {
  print(r[0](1))
  return r[0](x)
}
function bothG(g) { return c3([g], 2.5) }
function bothD(g) {
  print(g(1))
  return cf({ f: g }, 2.5)
}
print(bothE(dbl) + 1)
print(bothG(dbl) + 1)
print(bothD(dbl) + 1)
