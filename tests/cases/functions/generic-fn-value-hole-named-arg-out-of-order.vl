// Generics handed to hole parameters by named arguments out of parameter order reach the
// parameters they name, and a hole called at two types takes a parameter per type (D6281,
// D6290). Named arguments are evaluated in parameter order, as with every other callee.
function add(a, b) { return a + b }
function cat(a, b) { return a + b }
function apply2(g, h) {
  print(g(1, 2))
  print(h("a", "b"))
}
apply2(h: cat, g: add)

function both(g, h) {
  print(g(1, 2))
  print(g(1.5, 2.5))
  print(h("a", "b"))
}
both(h: add, g: add)

function bothI(g, h) {
  print(g(1, 2))
  print(g(1.5, 2.5))
  print(h(3, 4))
}
bothI(h: add, g: add)

function apply3(g, n: i32, h) {
  print(g(n, 2))
  print(g(1.5, 2.5))
  print(h("a", "b"))
}
apply3(g: add, 5, h: cat)

function tag(s: string) {
  print(s)
  return 1
}
function apply4(x: i32, g, y: i32) {
  print(g(x, y))
  print(g(1.5, 2.5))
}
apply4(y: tag("y"), g: add, x: tag("x"))
