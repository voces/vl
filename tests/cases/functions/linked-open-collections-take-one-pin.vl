// @run
// @log q
// @log q
// @log s
// @log 3
// Two open collections that meet at a store (`b = a`) are one value: a later use of either
// gives both its type, whether they are bindings or lambdas' results.
const ma = Map()
let mb = Map()
mb = ma
mb["a"] = "q"
print(ma["a"] ?? "none")
const fa = () => Map()
let fb = () => Map()
fb = fa
const fm = fb()
fm["a"] = "q"
print(fm["a"] ?? "none")
const la = () => []
let lb = () => []
lb = la
const ll = lb()
ll.push("s")
print(ll[0])
const xa = []
let xb = []
xb = xa
xb.push(1)
xb.push(2)
xb.push(3)
print(xa.length)
