// A hole parameter its function never calls, handed on only as a record literal's field to a
// callee that calls the field, takes the named function's set there, as a list element does: the
// callee calls it at two types, or another caller calls it through a list at two types (D15649).
// Two functions' literals of the set's record share one row (D15701).
function dbl(v) { return v + v }
function cf(r, x) { return r.f(x) }
function bothD(g) { return cf({ f: g }, 2.5) }
function c3(r, x) {
  print(r[0](1))
  return r[0](x)
}
function bothG(g) { return c3([g], 2.5) }
print(bothD(dbl))
print(bothG(dbl))

function idf(v) { return v }
function call2(r, x) {
  print(r.f(3))
  print(r.f(x))
}
function hand(g) { call2({ f: g }, "s") }
hand(idf)

function idg(v) { return v }
function call3(r, x) {
  print(r.f(1))
  print(r.f(x))
}
function hand3(g) { call3({ f: g }, 2.5) }
hand3(idg)

function quad(v) { return v * 4 }
function call4(r, x) { print(r.f(x)) }
function hand4(g) { call4({ f: g }, 2) }
hand4(quad)
function c5(r) { print(r[0](2)) }
function bothQ(g) { c5([g]) }
bothQ(quad)

function inc(v) { return v + 1 }
function call6(r, x) { print(r.f(x)) }
function hand6(g) { call6({ f: g, n: 1 }, 2) }
hand6(inc)
function call7(r) { print(r.f(6)) }
function hand7(g) { call7({ f: g }) }
hand7(inc)

function tri(v) { return v * 3 }
function cq(r, x) { return r.f(x) }
function handQ(g) { return cq({ f: g }, 2.5) }
function callQ(g) {
  print(g(1.5))
  return cq({ f: g }, 2.5)
}
print(handQ(tri))
print(callQ(tri))
function callR(g) {
  print(g(0.5))
  return cq({ f: g }, 1.5)
}
print(callR(tri))
