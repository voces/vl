// @run
// @log 11
// A function whose tail `if`/`else` has a `never` arm infers the other arm's type: the arm that
// never completes yields no value, so it does not veto the tail being the function's value (D1972).
function fail(msg: string): never {
  print(msg)
  __trap__()
}
function f(c: boolean) {
  if c { fail("x") } else { 5 }
}
function g(c: boolean) {
  if c { 6 } else { __trap__("y") }
}
print(f(false) + g(true))
