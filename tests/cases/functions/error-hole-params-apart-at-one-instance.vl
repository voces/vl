// @check
// @error argument of type string flows into `g` expecting i32 (the call's argument types)
// @error argument of type i32 flows into `g` expecting string (the call's argument types)
// @error argument of type f64 flows into `g` expecting i32 (the call's argument types)
// @error argument of type string flows into `g` expecting i32 (the call's argument types)
// @error argument of type string flows into `g` expecting i32 (the call's argument types)
// @error argument of type string flows into `g` expecting i32 (the call's argument types)
// Two un-annotated parameters handed to one type parameter are judged at each instance, as two
// declared ones are: an instance binding them apart is refused at the call, swapped, beside a
// declared parameter, in a lambda, or one function further out (D6482).
function g<T>(_x: T, y: T): T { return y }
function f(a, b) { return g(a, b) }
print(f(1, "s"))
function f2(a, b) { return g(b, a) }
print(f2(1, "s"))
function f3(a, b) { return g(a, b) }
print(f3(1, 2.5))
function f4<T>(a: T, b) { return g(a, b) }
print(f4(1, "s"))
const f5 = (a, b) => g(a, b)
print(f5(1, "s"))
function f6(a, b) { return g(a, b) }
function o(p, q) { return f6(p, q) }
print(o(1, "s"))
