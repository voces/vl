// @log 4
// A list of records holding an un-annotated function, handed through an un-annotated function
// that returns its parameter whole: as a literal, as a binding, read then called, its length
// alone, beside a number field, through a `const` copy, and at a second parameter (D16825: the
// instance's result had no spelling, so it fell to `i32` while the parameter held the list).

function id(x) { return x }
function idc(x) {
  const y = x
  return y
}
function snd(n, x) {
  print(n)
  return x
}
function inc0(a) { return a + 1 }

const xs = id([{ f: inc0 }])
print(xs[0].f(3))
const ys = [{ f: inc0 }]
print(id(ys)[0].f(3))
const g = xs[0].f
print(g(3))
print(id([{ f: inc0 }]).length)
const ns = id([{ f: inc0, n: 2 }])
print(ns[0].f(ns[0].n))
const cs = idc([{ f: inc0 }])
print(cs[0].f(3))
const ss = snd(2, [{ f: inc0 }])
print(ss[0].f(3))
