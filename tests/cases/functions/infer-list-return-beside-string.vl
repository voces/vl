// @run
// @log 1.5
// @log z
// @log r
// @log 4
// @log 1.5
// @hint redundant type annotation: `a` is inferred as `i32[]`
// @hint this 2-element `f64[]` is returned
// D2870: an un-annotated function returning a list beside another type returns the union box.
// A `return` of a list literal, a bound list or a spread may not re-seat the result on the list.
const a: i32[] = [3]
function g(k: boolean) {
  if k { return [...a, 2.5] }
  "z"
}
const v = g(true)
if v is f64[] { print(v[0] / 2.0) }
const w = g(false)
if w is string { print(w) }
function h(k: boolean) {
  const l = ["q", "r"]
  if k { return l }
  "z"
}
const x = h(true)
if x is string[] { print(x[1]) }
type C = { n: i32 }
function m(k: boolean) {
  if k { return ["q"] }
  { n: 4 }
}
const y = m(false)
if y is C { print(y.n) }
const n = (k: boolean) => {
  if k { return [3.0, 2.5] }
  "z"
}
const p = n(true)
if p is f64[] { print(p[0] / 2.0) }
