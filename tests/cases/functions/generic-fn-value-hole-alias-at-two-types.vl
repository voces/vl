// @run
// @log x
// @log 3
// @log x
// @log 3
// @log x
// @log 3
// A `const` alias of a generic handed to an un-annotated parameter called at two types is
// instanced at each (D5611), as the name is. The typed spelling, and a block-local alias handed
// to a block-local function.
function same<T>(k: T): T { k }
function take(a) { print(a("x")) }
function take2(a) { print(a(3)) }
function mid(a) {
  take(a)
  take2(a)
}
const h = same
mid(h)

function midT<F>(a: F) {
  take(a)
  take2(a)
}
midT(h)

function main() {
  function local(a) {
    print(a("x"))
    print(a(3))
  }
  const g = same
  local(g)
}
main()
