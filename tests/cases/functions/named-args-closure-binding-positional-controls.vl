// @run
// @log 9
// @log 9
// @log 9
// @log 9
// The positional half of D1604's grid, and the reason the fix is confined to the named-argument
// arm: the same shadowed callees, called with a positional argument, still reach the closure the
// name denotes and still print its answer. Each prints `n + 1`, never the module function's
// `alpha`, so a diversion back to the flat top-level table would print `8` here.
function g(alpha: i32) { print(alpha) }
function h(alpha: i32) { print(alpha) }
function m(beta: i32) { print(beta) }

function viaParam(g: (i32) => void) { g(8) }
function viaConst() {
  const h: (i32) => void = (n) => { print(n + 1) }
  h(8)
}
function viaLet() {
  let m: (i32) => void = (n) => { print(n + 1) }
  m = (n) => { print(n + 1) }
  m(8)
}
function viaNoDecl() {
  const q: (i32) => void = (n) => { print(n + 1) }
  q(8)
}
viaParam((n) => { print(n + 1) })
viaConst()
viaLet()
viaNoDecl()
