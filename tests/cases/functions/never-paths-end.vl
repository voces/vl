// @run
// @log ok
// @log 3
// @log int
// @log 105
// @log 4
// @log 7
// @log 7
// @log 1
// @log 15
// A path ends at a `return`, a `never` call (through a function value too), a `while true` that
// no `break` leaves, and an `if`, `match` or block whose every arm ends. One rule decides it for
// narrowing, definite assignment and a `never` body alike. D1971, D1973, D2025, D2026.
type IoError = { msg: string }

// D1971: the else arm exits, so the code after the `if` reads the then arm's facts.
function elseExits(x: i64 | IoError): i64 | null {
  if x is i64 { print("ok") } else { return null }
  x
}

// ...and a chain whose every arm but the first exits, inside a lambda.
function elseChain(x: i32 | string | boolean) {
  const f = (y: i32 | string | boolean): i32 => {
    if y is i32 { print("int") }
    else if y is string { return 1 }
    else { return 2 }
    y + 100
  }
  f(x)
}

// D1973: a guard arm ending in `while true` with no `break` never falls through.
function loopGuard(x: i64 | IoError): i64 | null {
  if x is IoError {
    while true { return null }
  }
  x
}

// ...and in a match arm, where a nested loop's own `break` leaves only that loop.
function loopInArm(x: i32 | null, k: i32) {
  match k {
    0 => {
      if x == null {
        while true {
          for i in 0 until 3 {
            if i == 1 { break }
          }
        }
      }
    }
    _ => {
      if x == null { return -1 }
    }
  }
  if x == null { return -2 }
  x + 6
}

// D2025: a `never` body that loops forever.
function spin(): never {
  while true { print(1) }
}

// ...and a `never` lambda, called on a path that never runs.
function spinLater(go: boolean) {
  const forever = (): never => {
    let i = 0
    while true { i = i + 1 }
  }
  if go { forever() }
  7
}

// D2026: a function type spells a `never` result.
function g(onErr: (string) => never, c: boolean) {
  if c { return 1 }
  onErr("no")
}

// ...and a record field of that type ends a guard arm.
type Handlers = { fail: (string) => never }
function viaField(h: Handlers, x: i32 | null) {
  if x == null { h.fail("null") }
  x + 10
}

const bail = (s: string): never => {
  print(s)
  if s == "" { spin() }
  __trap__()
}

print(elseExits(3 as i64))
print(elseChain(5))
print(loopGuard(4 as i64))
print(loopInArm(1, 0))
print(spinLater(false))
print(g(bail, true))
print(viaField({ fail: bail }, 5))
