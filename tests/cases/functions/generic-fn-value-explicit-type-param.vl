// @run
// @log 4
// @log q
// @log 4
// @log 4
// @log 4
// @log 1.5
// An EXPLICIT `<T>` generic taken as a VALUE at a boundary that declares a concrete function type.
// The boundary BINDS the type parameter, exactly as an argument type does on the call-driven path,
// and the instance is materialized at that binding.
//
// This half of the family was the worst-behaved one, because it slipped the value floor entirely:
// the floor's predicate is `fnHasUnannotatedParam`, and `x: T` IS an annotation, so nothing
// stopped the value being emitted at the un-substituted `T`. `vl check` reported no errors and the
// engine then met `wasm trap: indirect call type mismatch` — an accepted program that fails at
// run time, which is worse than any reject. Now the boundary resolves it and the instance is the
// one the checker already typed the program as using.
//
// A type parameter the boundary binds two ways (`pairT<T>(a: T, b: T)` reaching
// `(i32, string) => …`) is NOT admitted here: the bindings are substituted back through every
// written annotation and must reproduce the boundary, so a contradiction declines rather than
// taking first-use-wins.
function idT<T>(x: T): T { return x }
function pickT<T>(a: T, b: T, n: i32): T {
  if n > 0 { return a }
  return b
}

function applyTI(g: (i32) => i32) { return g(4) }
function applyTS(g: (string) => string) { return g("q") }
function mkT(): (i32) => i32 { return idT }

type TBox = { op: (i32) => i32 }

function go() {
  // PARAMETER boundary, at two different bindings of the same `T` in one program.
  print(applyTI(idT)) // 4
  print(applyTS(idT)) // q

  // RETURN boundary.
  const gt: (i32) => i32 = mkT()
  print(gt(4)) // 4

  // An annotated ARRAY of them, and a struct FIELD.
  const fs: ((i32) => i32)[] = [idT]
  print(fs[0](4)) // 4
  const bx: TBox = { op: idT }
  print(bx.op(4)) // 4

  // A type parameter appearing TWICE beside a concretely annotated parameter: both `T` positions
  // bind to the same boundary type (they must, or the instance declines), and the concrete `n: i32`
  // has to agree with the boundary's third param.
  const gm: (f64, f64, i32) => f64 = pickT
  print(gm(1.5, 2.5, 1)) // 1.5
}

go()
