// @run
// @log 1
// @log s
// @log 1
// @log s
// @log 1
// @log s
// @log 1
// @log s
// @log 1
// @log s
// @log 3
// @log s
// @log 1
// @log s!
// @log 7
// @log s
// @log 1
// @log s
// @warning Unused parameter `x`
// @info `lapLet` is never reassigned
// A hole parameter of a lambda a binding holds, called at two types, takes one parameter per
// type, as a declared function's does (D6212).
function id(a) { return a }
function idT<T>(a: T): T { return a }
const idL = (a) => a
const k = 7
const lap = (g, x) => {
  print(g(1))
  return g("s")
}
let lapLet = (g, x) => {
  print(g(1))
  return g("s")
}
const lapK = (g, x) => {
  print(g(k))
  return g("s")
}
function inBody() {
  const lapIn = (g, x) => {
    print(g(x))
    return g("s")
  }
  print(lapIn(id, 3))
  return 0
}
print(lap(id, 0))
print(lapLet(id, 0))
print(lap(idT, 0))
print(lap(idL, 0))
print(lap(id, 1))
inBody()
const r = lap(id, 2)
print(r + "!")
print(lapK(id, 0))
const m = lap
print(m(id, 0))
