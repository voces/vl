// @run
// `??` SHORT-CIRCUITS OVER `boolean | null` — the default is evaluated ONLY when the LHS is
// null, the rule every other rep already held (`i32 | null`, `f64 | null`, `string | null`,
// `K | null`, and every nullable ref). The `boolean | null` niche is an i32 cell holding 0/1
// with `2` for null, and a sentinel test has no `br_on_null`, so the lowering is a branching
// `if` over the `0x7f` blocktype — not a `select`, which is one opcode but evaluates BOTH
// value operands and therefore ran a side-effecting default on the PRESENT path.
//
// A LOG-MISMATCH pin, because the contract is literally "`RHS RAN` must not print": a verdict
// pin cannot see it (the wrong program is `vl check`-clean, emits a valid module and exits 0 —
// only the evaluation COUNT is wrong). BOTH DIRECTIONS ARE PINNED: the present leg must not
// print `RHS RAN`, and the null leg MUST — without the second leg this file would also pass
// for a `??` that never evaluates its default at all.
//
// The axis is the LHS SOURCE, which is what selects the emit arm; the consumer POSITION axis
// is `coalesce-bool-short-circuit-positions.vl`. The map source is the CONTROL: `m[k] ?? d`
// is the fused `emitMapGetOr` read, which already branched, so it must be unmoved.
// @log param/present
// @log true
// @log param/null
// @log RHS RAN
// @log false
// @log local/present
// @log true
// @log local/null
// @log RHS RAN
// @log false
// @log global/present
// @log true
// @log field/present
// @log true
// @log field/null
// @log RHS RAN
// @log false
// @log elem/present
// @log true
// @log elem/null
// @log RHS RAN
// @log false
// @log call/present
// @log true
// @log call/null
// @log RHS RAN
// @log false
// @log pop/present
// @log true
// @log pop/null
// @log RHS RAN
// @log false
// @log map/present
// @log true
// @log map/null
// @log RHS RAN
// @log false
// @hint redundant type annotation: `o` is inferred as `{fld: boolean | null}`
// @hint redundant type annotation: `xs` is inferred as `(boolean | null)[]`

function loud() {
  print("RHS RAN")
  false
}

function mkB(n: i32): boolean | null {
  if n == 0 { return null }
  return true
}

// ── a PARAM binding ──
function srcParam(p: boolean | null) { print(p ?? loud()) }
print("param/present")
srcParam(true)
print("param/null")
srcParam(null)

// ── a LOCAL binding, inferred from a call ──
function srcLocal(n: i32) {
  const q = mkB(n)
  print(q ?? loud())
}
print("local/present")
srcLocal(1)
print("local/null")
srcLocal(0)

// ── a module GLOBAL binding ──
const g: boolean | null = true
print("global/present")
print(g ?? loud())

// ── a `boolean | null` struct FIELD read (code 21) ──
type BoxB = { fld: boolean | null }

function srcField(p: boolean | null) {
  const o: BoxB = { fld: p }
  print(o.fld ?? loud())
}
print("field/present")
srcField(true)
print("field/null")
srcField(null)

// ── a `(boolean | null)[]` ELEMENT read ──
function srcElem(p: boolean | null) {
  const xs: (boolean | null)[] = [p]
  print(xs[0] ?? loud())
}
print("elem/present")
srcElem(true)
print("elem/null")
srcElem(null)

// ── a CALL lhs: it cannot be re-read, so it is stashed once in the bool coalesce slot ──
function srcCall(n: i32) { print(mkB(n) ?? loud()) }
print("call/present")
srcCall(1)
print("call/null")
srcCall(0)

// ── a binding seeded by a BOOLEAN-list `.pop()` (the same sentinel, its own arm) ──
function srcPop(n: i32) {
  const bs: boolean[] = []
  if n == 1 { bs.push(true) }
  const t = bs.pop()
  print(t ?? loud())
}
print("pop/present")
srcPop(1)
print("pop/null")
srcPop(0)

// ── CONTROL: a `{[string]: boolean | null}` read is the FUSED `emitMapGetOr`, already
// branching before this fix — it must be correct here and byte-unmoved by it.
function srcMap(n: i32) {
  const m: {[string]: boolean | null} = Map()
  if n == 1 { m["k"] = true }
  print(m["k"] ?? loud())
}
print("map/present")
srcMap(1)
print("map/null")
srcMap(0)
