// @run
// @log D:hi
// @log C:hi
// @log L:hi
// @log A:hi
// @log D:3
// @log NO-nested
// @log NO-lambda
// @log NO-ann
// @hint redundant type annotation: `v` is inferred as `string | i32`
// The LOCAL-BINDING half of the narrowed-capture rep, which resolves through different
// machinery than the parameter half and therefore needs its own pin.
//
// A parameter's union-ness is answerable from the arena alone (`paramUnion`). A
// function-scope local's is not: `exprUnion`'s ident arm reaches it through
// `declaredUnion`, which reads the EMIT-TIME local table that `buildLocals` fills one
// function at a time. So an early pass banking declaration-site narrowings sees
// `narrowTop == 0` at the closure in every local-bound spelling — annotated or not — and
// banks nothing. `emitFuncCode` re-banks its own frame right after `buildLocals`, which is
// the only point where a guard over a local resolves at all.
//
// Both spellings are here because the checker calls the annotation REDUNDANT on the
// un-annotated one's twin (`redundant type annotation: u is inferred as string | i32`), and
// the annotation is nevertheless load-bearing for a DIFFERENT reason one layer down
// (`captureValKind`'s un-annotated-`let` arm classifies the initializer through a shorter
// ladder than `collectLocals` uses). The annotated arm is spelled with a NAMED alias so the
// hint does not fire on it.
type UL = string | i32

function localUnion(b: boolean) {
  const u = mk(b)
  if u is string {
    print("D:" + u)
  } else {
    print("D:" + toString(u))
  }
  if u is string {
    function capLocNes() {
      print("C:" + u)
    }
    capLocNes()
  } else {
    print("NO-nested")
  }
  if u is string {
    const capLocLam = () => {
      print("L:" + u)
    }
    capLocLam()
  } else {
    print("NO-lambda")
  }
  const v: UL = mk(b)
  if v is string {
    function capAnnNes() {
      print("A:" + v)
    }
    capAnnNes()
  } else {
    print("NO-ann")
  }
}

function mk(b: boolean): UL {
  if b { return "hi" }
  return 3
}

function main() {
  localUnion(true)
  localUnion(false)
}

main()
