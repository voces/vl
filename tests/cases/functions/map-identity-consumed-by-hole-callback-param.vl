// @run
// An identity `.map` over a set's records, consumed by a later `.map` whose callback leaves its
// parameter open, hands that callback the records of the list it maps, directly, through a
// `const`, or through a second identity map.
function id(a) { return a }
function deliver() { return [{ f: id }] }
const v: { f: (a: f64) => f64 }[] = deliver()
  .map((r) => r)
  .map((q): { f: (a: f64) => f64 } => ({ f: q.f }))
print(v[0].f(2.5))
const w = deliver().map((r) => r)
const u: { f: (a: f64) => f64 }[] = w.map(
  (q): { f: (a: f64) => f64 } => ({ f: q.f }),
)
print(u[0].f(1.5))
const x = deliver().map((r) => r).map((r) => r).map((q) => q.f(3.5))
print(x[0])
// @log 2.5
// @log 1.5
// @log 3.5
