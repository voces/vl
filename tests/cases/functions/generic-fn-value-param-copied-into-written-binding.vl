// @run
// @log x
// @log 3
// A generic parameter copied into a binding called at another type than the parameter itself
// takes a parameter per call type, and the copy reads the one its binding is called at (D6470).
// The un-annotated binding is `generic-fn-value-param-copied-into-unannotated-binding.vl`.
function same<T>(k: T): T { k }
function take(a) { print(a("x")) }
function take2(a) { print(a(3)) }
function mid<F>(a: F, a1: F) {
  let b: F = a1
  b = a
  take(a)
  take2(b)
}
mid(same, same)
