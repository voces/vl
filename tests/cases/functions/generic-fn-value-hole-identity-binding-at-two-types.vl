// @run
// @info `qL` is never reassigned; use `const` instead of `let`
// @log 3
// @log w
// @log 3
// @log w
// @log 3
// @log w
// @log 3
// @log w
// @log x
// @log 3
// A hole function handed through an identity call into one binding called at two types takes
// a slot per type (D6020): at module scope, inside a function, in a let, and handed to holes.
function fw(f) { return f }
function id(x) { return x }
function take(a) { print(a("x")) }
function take2(a) { print(a(3)) }
const q = fw(id)
print(q(3))
print(q("w"))
function main() {
  const qm = fw(id)
  print(qm(3))
  print(qm("w"))
}
main()
let qL = fw(id)
print(qL(3))
print(qL("w"))
const qa = fw(id)
const qb = fw(id)
print(qa(3))
print(qb("w"))
const qh = fw(id)
take(qh)
take2(qh)
