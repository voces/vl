// @run
// @log a
// @log 3
// @log 7
// A `??` whose default is a call that never returns, in the builders that write the default in a
// null arm: a `string | null`, a shared `scalar | null` field across a union's records, and a
// shared binding's cell, each read when present.
function fail(m: string): never { __trap__(m) }
function str(s: string | null) { return s ?? fail("s") }
type A = { k: i32 | null, x: i32 }
type B = { k: i32 | null, y: string }
function field(u: A | B) { return u.k ?? fail("k") }
type U = { a: i32 } | { b: string }
function cell() {
  let u: U
  u = { a: 7 }
  const g = () => if u is { a: i32 } { u.a } else { 0 }
  return g()
}
print(str("a"))
print(field({ k: 3, x: 1 }))
print(cell())
