// @check
// @error member access '.scale' on non-object i32
// UFCS dispatch (`o.f(args)` → `f(o, args)`) matches a `self`-function by EXACT
// arity, and v1 does not widen that match to a default's arity range: the
// receiver-injecting rewrite decides whether a member call is a method call at
// all, so relaxing it there changes DISPATCH, not just argument filling. The
// plain call `scale(5, 2)` takes the default; the UFCS spelling needs every
// argument.
function scale(self: i32, by: i32, plus: i32 = 1): i32 { self * by + plus }
print(5.scale(2))
