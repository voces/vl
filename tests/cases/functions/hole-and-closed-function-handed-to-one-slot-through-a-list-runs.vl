// @run
// @log 2.5
// @log 5
// @log 2.5
// @log 5
// @log 2.5
// @log 5
// A hole function and a closed-typed function handed to one parameter through a list element, an
// if-joined callee, or with a named closed function, run: the tag decision settles with the
// hole's set untagged once tagging it refutes itself (D15484).
function id(x) { return x }
function dbl(x: f64) { return x * 2.0 }
function onceF(h) { print(h(2.5)) }
const gs = [onceF]
gs[0](id)
gs[0]((x: f64) => x * 2.0)
const c = true
const g = if c { onceF } else { onceF }
g(id)
g((x: f64) => x * 2.0)
gs[0](id)
gs[0](dbl)
