// @run
// A binding's list delivered to an annotated list is the same list, never a copy: a write or a
// push through either name is seen through the other where both call its field at one signature.
function id(a) { return a }
function dbl(a) { return a * 2 }
function deliver() { return [{ f: id }] }
const a = deliver()
const b: { f: (a: f64) => f64 }[] = a
a[0] = { f: dbl }
print(b[0].f(2))
a.push({ f: id })
print(b.length)
b[1] = { f: dbl }
print(a[1].f(1.5))
for r in a { print(r.f(0.5)) }
// @log 4
// @log 2
// @log 3
// @log 1
// @log 1
