// @run
// @log 2
// @log s
// @log 2
// @log s
// @log xy
// @log 2
// A hole called at two instances whose operators are defined at each runs, one instance per
// call, beside the ill-typed spellings the checker refuses (D6300).
function id(a) { return a }
const lid = (a) => a
function lap(g) {
  print(g(1) + 1)
  return g("s")
}
function lap2(g) {
  print(g("x") + g("y"))
  return g(2)
}
print(lap(id))
print(lap(lid))
print(lap2(id))
