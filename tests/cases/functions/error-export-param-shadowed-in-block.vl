// @error exported function `t`: parameter `x` has no type and nothing in the program calls `t`; the host calls it, so its signature must be explicit. The body fits more than one type (any type). Annotate it: `export function t(x: T)`
// @warning `x` shadows the `x` declared
// A use of a block's own `x` that shadows the parameter reads the block's binding, so it
// cannot type an export nothing calls (D3817).
function shout(s: string) { s + "!" }
export function t(x) {
  if true {
    const x = "inner"
    print(shout(x))
  }
  print(x)
}
print(1)
