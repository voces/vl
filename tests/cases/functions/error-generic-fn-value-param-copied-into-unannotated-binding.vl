// @emit-error parameter `a` of `mid` is called at two function types that no parameter per type separates
// The un-annotated twin of `error-generic-fn-value-param-copied-into-written-binding.vl`,
// written inside a branch and reached from a function (D6423, open as D6470).
function same<T>(k: T): T { k }
function take(a) { print(a("x")) }
function take2(a) { print(a(3)) }
function mid<F>(a: F, a1: F, c: boolean) {
  let b = a1
  if c { b = a }
  take(a)
  take2(b)
}
function main() { mid(same, same, true) }
main()
