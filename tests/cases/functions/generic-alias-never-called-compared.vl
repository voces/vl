// @run
// @log true
// A hole function aliased in a body and returned, with no call site, to a caller that compares
// the result: the comparison reads the declaration's identity and calls nothing, so the stub
// the unread return gets is never observed (D7180). The same return bound unread runs:
// `closures/uncalled-hole-fn-returned-unread.vl` (D6882).
function exclaim(s) { return s + "!" }

function go() {
  const f = exclaim
  return f
}

const g = go()
print(g == g)
