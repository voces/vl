// @run
// @log 2
// @log 2.5
// @log 6
// @log 3
// A top-level function read as a value before its declaration has its return inferred
// there, as a call to it would (D7762).
function viaConst() {
  const g = f
  return g(1)
}
function f(n: i32) { return n + 1 }
print(viaConst())

function id<T>(x: T) { return x }
function viaGeneric() {
  const k = id(h)
  return k(2)
}
function h(n: i32) { return n + 0.5 }
print(viaGeneric())

function viaList() {
  const fs = [p, q]
  return fs[1](2)
}
function p(n: i32) { return n }
function q(n: i32) { return n * 3 }
print(viaList())

function ap<T, R>(k: (x: T) => R, v: T) { return k(v) }
function viaArg() { return ap(f, 2) }
print(viaArg())
