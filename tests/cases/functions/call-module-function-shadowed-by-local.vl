// @error-at 8:6 `over` here is the `i32` declared at 8:9, which shadows the function `over` declared at 4:10; rename it
// D3599: a local that hides a module function names itself and the function when it is called.
// The call above the `const` reaches the function and is not reported.
function over(x: i32) { x + 1 }
export function f(k: i32) {
  let a = 0
  if k > 0 { a = over(1) }
  const over = 3
  a + over(2)
}
