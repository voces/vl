// @run
// @log 3
// @log false
// @log true
// @log null
// @log s
// @log 2.5
// @log true
// @log two
// @log 8
// A forwarder of a hole function whose let result joins its parameters returns the join at each
// instance, as the function itself does: two and three arms, a null arm, and a forwarder of a
// forwarder (D14734).
function g(a0, a1, k: i32) {
  const r = if k == 0 { a0 } else if k == 1 { a1 } else { null }
  return r
}
function h(x, y, k: i32) { return g(x, y, k) }
const x1 = false
print(h(3, x1, 0))
print(h(3, x1, 1))
print(h(3, true, 1))
print(h(3, x1, 2))
function h2(x, y, k: i32) { return h(x, y, k) }
print(h2("s", 2.5, 0))
print(h2("s", 2.5, 1))
function g3(a0, a1, a2, k: i32) {
  const r = if k == 0 { a0 } else if k == 1 { a1 } else { a2 }
  return r
}
function h3(x, y, z, k: i32) { return g3(x, y, z, k) }
print(h3(1, "two", true, 2))
print(h3(1, "two", true, 1))
print(h(7, 8, 1))
