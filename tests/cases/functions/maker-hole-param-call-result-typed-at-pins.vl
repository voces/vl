// @run
// @log 0.625
// @log 0.625
// @log 0.625
// @log 10
// @log 5
// @log 3.5
// A call through a binding that holds an un-annotated maker's call is typed by the lambda's body at
// the call's arguments and the binding the maker call pinned: `adder(2)` pins `n` at `i32`, so
// `v(3)` over `a + n` is `i32`, and float arithmetic on it widens (D16798, D16799).
function adder(n) { return (a) => a + n }
const v = adder(2)
print(v(3) / 8.0)
const r = v(3)
print(r / 8.0)
const q: f64 = v(3)
print(q / 8.0)
print(v(3) * 2)
const w = adder(2)
print(w(3))
const x = adder(1.5)
print(x(2.0))
