// @run
// @log 5.5
// @log 3
// A maker's calls whose values are delivered at two function types each build their own copy
// of its lambda at the signature their binding is handed on at (D16851).
function mk() { return (a) => a + 2.5 }
function take(a: (a: i32) => f64) { print(a(3)) }
function half(a: (a: f64) => f64) { print(a(0.5)) }
const x = mk()
take(x)
const z = mk()
half(z)
