// @run
// @log 5.5
// @log 3
// @log 5.5
// @log 3
// A maker's calls handed in place, or through annotated bindings, to destinations of two function
// types each build their own copy of its lambda (D16871).
function mk() { return (a) => a + 2.5 }
function take(a: (a: i32) => f64) { print(a(3)) }
function half(a: (a: f64) => f64) { print(a(0.5)) }
take(mk())
half(mk())
const x: (a: i32) => f64 = mk()
take(x)
const z: (a: f64) => f64 = mk()
half(z)
