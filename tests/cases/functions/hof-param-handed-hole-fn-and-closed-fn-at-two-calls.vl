// @run
// @log 3
// @log e
// @log 3
// @log e!
// @log 3.5
// @log 3
// @log 1
// @log 0.375
// An instance of a higher-order function calls only the function its own call hands over, so an
// un-annotated function handed at one call is not built at another call's argument (D16814).
function app<A, B>(f: (x: A) => B, x: A): B { return f(x) }
function happ(f, x) { return f(x) }
function hinc(x) { return x + 1 }
function sid(s: string) { return s }
print(app(hinc, 2))
print(app((s: string) => s, "e"))
print(happ(hinc, 2))
print(happ((s: string) => s + "!", "e"))
print(happ(hinc, 2.5))
const h = hinc
print(app(h, 2))
print(app((s: string) => s.length, sid("e")))
const r: f64 = app(hinc, 2)
print(r / 8.0)
