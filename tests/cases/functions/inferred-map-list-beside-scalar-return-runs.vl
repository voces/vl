// @run
// @log true
// @log false
// @log 8
// An inferred `{[i32]: i32}[] | i32` return, a list of maps beside a scalar, runs as its
// annotated twin does (D16171).
function pick(c: boolean) {
  if c {
    const m: {[i32]: i32} = Map()
    m[2] = 8
    return [m]
  }
  return 1
}
print(pick(true) is {[i32]: i32}[])
print(pick(false) is {[i32]: i32}[])
const p = pick(true)
if p is {[i32]: i32}[] { print(p[0][2] ?? 0) }
