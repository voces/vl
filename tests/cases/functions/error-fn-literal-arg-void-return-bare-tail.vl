// @run
// @log 1
// DECISIONS (void-discard): a function literal whose bare TAIL expression has a
// value, checked against a `() => void` parameter, ADOPTS the void return and the
// tail value is DISCARDED — this case was a must-error pin at the pre-coercion
// semantics, and its own note assigned the flip to the coercion change. The
// explicit `return 7` spelling stays the error
// (`error-fn-literal-arg-void-return-explicit.vl`).
function g(cb: () => void) {
  cb()
}
g(() => {
  print(1)
  7
})
