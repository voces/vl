// @check
// @error-at 14:2 argument 1: expected () => void, got () => i32
// CONTRACT (must-error, at TODAY'S semantics): a function literal whose bare
// TAIL expression gives it a non-void return type is rejected against a
// `() => void` parameter, and the diagnostic anchors at that tail expression
// (the site the return type was inferred from), not at the literal's closing
// brace. NOTE: the decided void-coercion change (an implicit tail value in a
// void context is DISCARDED) will flip this case to accepted — that update
// belongs to the coercion change, and is not a regression of this pin.
function g(cb: () => void) {
  cb()
}
g(() => {
  print(1)
  7
})
