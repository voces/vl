// @run
// @log 3
// @log 4
// @log 3
// @log 4
// A hole function with a defaulted parameter splits its hole per type when every call passes
// that parameter; leaving it to the default is the refusal in
// `error-generic-fn-value-inferred-hof-default-param.vl` (D6280).
function add(a, b) { return a + b }
function apply2(g, n: i32 = 1) {
  print(g(n, 2))
  print(g(1.5, 2.5))
}
print(add(1, 2))
print(add(1.5, 2.5))
apply2(add, 1)
