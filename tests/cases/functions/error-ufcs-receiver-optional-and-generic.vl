// @check
// @error-at 20:0 i32[] is not f64[]: a container never widens implicitly, and only a readonly list is covariant
// @error-at 25:6 K[] is not string[]: a container never widens implicitly
// @error-at 30:0 cannot be assigned to Shape[] here: the list is written through (line 29)
// @error-at 35:0 i32[] is not (i32 | null)[]: a container never widens implicitly
// @error-at 40:0 i32[] is not f64[]: a container never widens implicitly, and only a readonly list is covariant
// @hint redundant type annotation: `ys` is inferred as `i32[]`
// @hint redundant type annotation: `zs` is inferred as `i32[]`
// D2165 — the receiver takes the argument's verdict in three more spellings: an optional
// chain `xs?.f()` binds `self` as `xs.f()` does, a generic `self` is asked under the
// receiver's binding, and a receiver in an un-annotated body is asked at the pinning call.
type K = "a" | "b"
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq

// Numeric: a written `self` over an optional receiver. Without the refusal this printed the
// stale 1 from a converted copy.
function sm(self: f64[]) { self[0] = 2.5 }
const xs: i32[] | null = [1, 2]
xs?.sm()

// Literal union into `string`, optional receiver.
function jn(self: string[]) { return self.length }
const ks: K[] | null = ["a", "b"]
print(ks?.jn())

// A plain struct row into a union box, written through `self`.
function put(self: Shape[]) { self[0] = { s: 2 } }
const cs: Circle[] | null = [{ r: 1 }]
cs?.put()

// A generic `self`: `T` binds `i32`, and `(i32 | null)[]` is stored differently.
function nl<T>(self: (T | null)[]) { self[0] = null }
const ys: i32[] = [1, 2]
ys.nl()

// A receiver in an un-annotated body, pinned at `g(zs)`.
function g(x) { x.sm() }
const zs: i32[] = [1, 2]
g(zs)
