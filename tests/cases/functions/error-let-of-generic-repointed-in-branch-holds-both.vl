// @error argument 1: operator '+' is not defined for boolean and i32
// A write in a branch leaves the read after it holding either function, so both are asked at the
// call: `plus` cannot take a `boolean` (D15956's flow rule; a branch keeps the whole set).
function inner<U>(u: U) { print(u) }
function plus<V>(v: V) { print(v + 1) }
function main(c: boolean) {
  let k = plus
  if c { k = inner }
  k(true)
}
main(true)
