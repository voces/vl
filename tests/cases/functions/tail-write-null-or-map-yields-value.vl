// @run
// @log true
// @log true
// @log true
// @log true
// @log true
// @log true
// @log 5
// @log 5
// @log 5
// @log 7
// D2497, D2544 — a function whose tail statement writes a bare `null` or a map to a field, an
// element or a map entry returns the written value. The emitter kept such a function void
// while the checker typed its result, so a caller binding it read nothing: invalid wasm.
type O = { v: string | null }
function clrField(o: O) { o.v = null }
function clrElem(xs: (string | null)[]) { xs[0] = null }
function clrAnn(o: O): null { o.v = null }

const o1: O = { v: "a" }
const r1 = clrField(o1)
print(r1 == null)
print(o1.v == null)
const xs: (string | null)[] = ["a"]
const r2 = clrElem(xs)
print(r2 == null)
print(xs[0] == null)
const o3: O = { v: "a" }
const r3 = clrAnn(o3)
print(r3 == null)
print(o3.v == null)

function mkM(): {[i32]: i32} {
  const mm: {[i32]: i32} = Map()
  mm[1] = 5
  mm
}
const k = 1
const m: {[i32]: {[i32]: i32}} = Map()
function putEntry() { m[k] = mkM() }
const r4 = putEntry()
print(r4[1] ?? 0)
print((m[1] ?? Map())[1] ?? 0)
const ms: {[i32]: i32}[] = [Map()]
function putElem() { ms[0] = mkM() }
const r5 = putElem()
print(r5[1] ?? 0)

// The same writes as statements keep running.
const tally: {[string]: i32} = Map()
function count(key: string) { tally[key] = 7 }
clrField(o1)
clrElem(xs)
count("q")
print(tally["q"] ?? 0)
