// @warning Unused function `keep`
// @warning This branch is never taken
// A choice of named functions returning `boolean`, held in a record literal handed to a callee
// that calls the field at a type no direct call reaches, dispatches by tag to each member's
// instance at that type (D15644, D15647).
function keep(f: (i32) => i32) { print(f(1)) }
function pos(v) { return v > 0 }
function big(v) { return v > 1 }
function odd(v) { return v % 2 == 1 }
function neg(v) { return v < 0 }
function callP(r, x) { print(r.f(x)) }
function callQ(r, x) { return r.f(x) }
function run(b) {
  const g = if b { pos } else { big }
  callP({ f: g }, 3)
  callP({ f: g }, 2.5)
}
function runO(b) {
  const g = if b { pos } else { odd }
  callP({ f: g }, 3)
  callP({ f: g, h: 1 }, 2.5)
}
function run3(b, c) {
  const g = if b { pos } else if c { odd } else { neg }
  callP({ f: g }, 3)
  callP({ f: g }, -2.5)
}
function runQ(b) {
  const g = if b { pos } else { odd }
  const ok = callQ({ f: g }, 2.5)
  print(ok)
}
run(false)
runO(false)
run3(false, false)
runQ(true)
const m = if true { odd } else { pos }
callP({ f: m }, 3.0)
callP({ f: m }, 3)
