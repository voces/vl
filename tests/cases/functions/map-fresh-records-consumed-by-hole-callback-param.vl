// @run
// A `.map` building fresh records over a set's records, consumed by a later `.map` whose callback
// leaves its parameter open, gives that callback the records it built.
function id(a) { return a }
function deliver() { return [{ f: id }] }
const v: { f: (a: f64) => f64 }[] = deliver()
  .map((r) => ({ f: r.f }))
  .map((q): { f: (a: f64) => f64 } => ({ f: q.f }))
print(v[0].f(2.5))
const x = deliver().map((r) => ({ f: r.f })).map((q) => q.f(1.5))
print(x[0])
// @log 2.5
// @log 1.5
