// @error cannot store 'half' in 'rows[].a.f'
// A list of records whose nested record holds functions of different result types, read through
// an un-annotated parameter: the instance reads the nested field at the argument's own sets, not
// their join, so the read is refused rather than calling `half` at `inc0`'s signature (D16860).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const rows = [{ a: { f: inc0 } }, { a: { f: half } }]
function take(a) { print(a[1].a.f(3)) }
take(rows)
