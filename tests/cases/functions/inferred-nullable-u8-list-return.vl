// @run
// @log true
// @log 2
// @log 9
// D1062, the PACKED leaf. An un-annotated function whose returns join to `u8[] | null`
// lowers through the annotation `synthNulListRetAnns` pins, exactly as the other element
// types do in `inferred-nullable-list-return.vl`.
//
// ALONE IN ITS OWN FILE ON PURPOSE, and the reason is a DIFFERENT defect: a
// `u8[] | null` cell in the same module as an `i64[] | null` / `f64[] | null` /
// `f32[] | null` one is check-clean INVALID WASM — the second cell is typed and read
// through the first leaf's wrapper. That is D1105, it reproduces with both returns
// ANNOTATED and with no inference anywhere, and it predates this pin. Putting `u8[]`
// beside the other leaves here would pin that bug rather than this capability.
function pickU8(n: i32) {
  const vu: u8[] = [9, 8]
  if n == 0 { return vu }
  return null
}
print(pickU8(1) == null)
const ru = pickU8(0)
if ru != null {
  print(ru.length)
  print(ru[0])
}
