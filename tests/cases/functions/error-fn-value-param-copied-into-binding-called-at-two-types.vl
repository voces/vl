// @emit-error `a` is called at two instances of the function handed to it in a call to `mid`
// A function parameter copied into a binding that is itself called at two types stays refused:
// the split gives the copy the one parameter its binding is called at, and here there are two
// (D6470).
function same<T>(k: T): T { k }
function mid(a) {
  let b = a
  print(a("x"))
  print(b(3))
  print(b("y"))
}
mid(same)
