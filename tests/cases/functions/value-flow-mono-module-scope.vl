// @run
// @log 7
// @log 4
// @log ba
// @log 9
// @log 12
// @log 30
// MODULE-SCOPE value-flow monomorphization — the twin of `value-flow-mono.vl`, whose bindings all
// live in a function body. A generic (un-annotated-param) NAMED function aliased to a module-level
// `const`/`let` is the same sound shape for the same reason: `monomorphize` resolves the callee
// through the binding (`identClosureFeSid` falls back to the GLOBAL let table when no frame owns
// the name) and instantiates per call site, so each call reaches the instance its own argument
// types pinned and the closure the cell stores is never the thing a differently-typed call goes
// through.
//
// The region the exemption has to clear is WIDER here and that is the whole difference: a global is
// visible from every function body, so "used only as a direct-call callee" is a PROGRAM-WIDE
// property (`monoGenericAliasFe`'s arena scan), not a within-one-frame one. `useFromFn` below is
// the case that needs it — the call site is in another function entirely.
function add(a, b) a + b

// i32 through a module-level alias.
const g = add
print(g(3, 4)) // 7

// f64 through its own alias.
const h = add
print(h(2.5, 1.5)) // 4.0 → 4

// string `+` is concatenation.
const s = add
print(s("b", "a")) // ba

// MULTIPLE call types through ONE module-level alias: the i32 call rides `add`'s own slot, the
// f64 call clones a fresh annotated instance and rewrites that call site to it.
const k = add
print(k(4, 5)) // 9
print(k(7.5, 4.5)) // 12.0 → 12

// The alias is a GLOBAL, so the call may sit in a different frame than the binding.
const m = add
function useFromFn() { return m(10, 20) }
print(useFromFn()) // 30
