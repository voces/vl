// @run
// @log 6
// @log O
// @log 7
// A lambda written to a generic `let` runs at a type its body takes (D3968), and a module binding
// written with a generic is instanced at its call (D3961).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function main() {
  let j = inner
  j = (x) => {
    print(x + 1)
  }
  j(5)
}
main()
let m = inner
m = other
m(7)
