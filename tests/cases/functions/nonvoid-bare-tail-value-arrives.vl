// @run
// @log 7
// @log 11
// @log tail
// GUARD for the void-discard change: the implicit-tail DISCARD is keyed on the
// enclosing return context being VOID — never on the tail's shape. A callee with
// a NON-void declared return whose body returns by bare tail (the dominant idiom
// in the `??`-carrier family) must keep delivering its value to the caller. If
// the discard predicate is ever keyed on "bare expression in tail position"
// instead of "context is void AND tail has a value", these values stop arriving
// and this file fails loudly.
function src(p: {r: i32}): {r: i32} | null { p }
const got = src({r: 7})
print(got?.r ?? -1)

function scalarTail(n: i32): i32 { n + 4 }
print(scalarTail(7))

function strTail(): string { "tail" }
print(strTail())
