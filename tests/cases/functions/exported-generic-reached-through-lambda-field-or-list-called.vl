// @run
// @log 1
// @log 2
// @log 3
// @log 4
// @log 5
// @hint Intentionally-unused parameter `_n` (leading `_` marks it unused)
// An exported generic reached through a lambda's result, an alias, a field written later or a
// list of lambdas is instanced by the call that reaches it, so the checker passes it (D12237).
export function ia<T>(x: T): T { x }
const ka = () => ia
print(ka()(1))
export function ib<T>(x: T): T { x }
const g = ib
const kb = () => g
print(kb()(2))
export function ic<T>(x: T): T { x }
const kc = (_n: i32) => {
  ic
}
print(kc(1)(3))
export function ie<T>(x: T): T { x }
const r = { f: ie }
r.f = ie
print(r.f(4))
export function iff<T>(x: T): T { x }
const ks = [() => iff]
print(ks[0]()(5))
