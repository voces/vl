// @run
// @log 2
// @log 2
// @log 2
// @log 2
// A rest parameter's element is inferred from the arguments by the SAME join a list literal
// uses — `[1, 2.5]` is `f64[]` and `[1, true]` is `(i32 | boolean)[]`, so the rest packs to
// exactly those. What a type parameter cannot be pinned to is a union that BOXES, which is
// the twin of this file (`error-rest-element-hole-boxed-union.vl`).
function f<T>(...xs: T[]) { return xs.length }
// Two numeric arguments widen rather than union, so nothing boxes.
print(f(1, 2.5))
// `(i32 | boolean)` rides the i32 spine — both arms are i32-repped — so it pins and runs.
print(f(1, true))
print(f(1, 5000000000))
// The concrete spelling is what the boxed-union refusal names, and it runs at every arm.
function g(...xs: (i32 | string)[]) { return xs.length }
print(g(1, "x"))
