// @run
// @hint Intentionally-unused parameter `_u` (leading `_` marks it unused)
// @log x
// @log 3
// @log x
// @log 3
// @log x
// @log 3
// @log x
// @log 3
// @log x
// @log 3
// @log x
// @log 4
// A binding seeded with a generic and then written with a function parameter called at another
// type takes the parameter per call type (D6520): a plain write, one in a branch, a further
// copy, a body reached through a forward, two parameters, and a returned call.
function same<T>(k: T): T { k }
function pair<T, U>(k: T, _u: U): T { k }
function plain(a) {
  let b = same
  b = a
  print(a("x"))
  print(b(3))
}
function inBranch(a, c: boolean) {
  let b = same
  if c { b = a }
  print(a("x"))
  print(b(3))
}
function furtherCopy(a) {
  let b = same
  b = a
  const c = b
  print(a("x"))
  print(c(3))
}
function outer(a) { plain(a) }
function twoArgs(a) {
  let b = pair
  b = a
  print(a("x", 1))
  print(b(3, "y"))
}
function returned(a) {
  let b = same
  b = a
  print(a("x"))
  return b(3) + 1
}
plain(same)
inBranch(same, true)
furtherCopy(same)
outer(same)
twoArgs(pair)
print(returned(same))
