// A hole parameter of an exported function takes a parameter per type its calls use, as an
// unexported one does, so a generic called through it at two signatures runs (D6204).
function add(a, b) { return a + b }
function same<T>(k: T): T { k }
export function apply2(g) {
  print(g(1, 2))
  print(g(1.5, 2.5))
}
export function mid(a, b, n: i32) {
  print(a("x"))
  print(b(n))
  if n > 0 { mid(b, a, n - 1) }
}
export function one<F>(a: F) {
  print(a("x"))
  print(a(3))
}

print(add(1, 2))
print(add(1.5, 2.5))
apply2(add)
mid(same, same, 1)
one(same)
