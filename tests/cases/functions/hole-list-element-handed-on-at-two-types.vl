// @run
// @log 5
// @log s
// @log 5
// @log s
// @log 7
// @log u
// @log 8
// @log vv
// @log 9
// @log 9
// @log w
// @log w
// An element of a hole list parameter handed on to another hole function, which calls it at
// several types, takes each type's instance of the function the list was given (D15612).
function id(v) { return v }
function dbl(v) { return v + v }
function call1(f, x) { print(f(x)) }
function call0(fs, x) { call1(fs[0], x) }
function callAt(fs, x) {
  const i = 1
  call1((fs[i]), x)
}
function both(fs, x) {
  call1(fs[0], x)
  print(fs[0](x))
}
function run(g) {
  call0([g], 5)
  call0([g], "s")
}
run(id)
function runLet(g) {
  const fs = [g]
  call0(fs, 5)
  call0(fs, "s")
}
runLet(id)
function runTwo(g, h) {
  callAt([g, h], 7)
  callAt([g, h], "u")
}
runTwo(id, id)
function runDbl(g) {
  call0([g], 4)
  call0([g], "v")
}
runDbl(dbl)
function runBoth(g) {
  both([g], 9)
  both([g], "w")
}
runBoth(id)
