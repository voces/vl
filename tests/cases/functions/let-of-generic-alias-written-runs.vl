// @run
// @log C
// @log 107
// @log I
// @log true
// @log I
// @log s
// @info `k` is never reassigned; use `const` instead of `let`
// An alias takes its source's type, but a write to the alias is the alias's own: the generic it
// was read from stays generic (D3960).
function inner<U>(u: U) { print("I"); print(u) }
function cI32(n: i32) { print("C"); print(n + 100) }
function main() {
  let k = inner
  let a = k
  a = cI32
  a(7)
  k(true)
  k("s")
}
main()
