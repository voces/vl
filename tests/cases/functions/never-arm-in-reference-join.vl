// @run
// @log ada
// @log 3
// @log 2
// A reference join whose arm calls a user `never` function on one path and yields its value on
// the other: the never arm is that call's statement and stores nothing into the join.
function fail(m: string): never { __trap__(m) }
function name(c: boolean, s: string): string {
  const v = if c { s } else { fail("no name") }
  return v
}
function size(c: boolean, xs: i32[]): i32 {
  const ys = if c { xs } else { fail("no list") }
  return ys.length
}
function keep(c: boolean, xs: i32[]): i32[] {
  return if c { xs } else { fail("no keep") }
}
print(name(true, "ada"))
print(size(true, [1, 2, 3]))
print(keep(true, [1, 2])[1])
