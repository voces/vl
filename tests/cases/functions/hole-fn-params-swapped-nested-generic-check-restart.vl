// @log x
// @log 0
// A hole function's two parameters swapped by a recursive call, handed a generic nested in
// another function, compiles: a row the elaboration kept across a check restart names a key of
// the run before, which this run's drain skips (D15407).
function mid(a, b, n: i32) {
  print(a("x"))
  print(b(n))
  if n > 0 { mid(b, a, n - 1) }
}
function outer(u: i32) {
  function same<T>(k: T): T { k }
  mid(same, same, u)
}
outer(1)
