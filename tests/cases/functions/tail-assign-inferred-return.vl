// @run
// @log 5
// @log 5
// @log b
// @log 2.5
// @log true
// @log 1
// @log 9
// A function body's LAST statement may be an ASSIGNMENT, and assignment is an
// EXPRESSION yielding the assigned value (DECISIONS: assignment-as-expression) — so
// such a function has a value RETURN whose type nobody wrote down. TWO independent
// answers decide what that type is, and this file pins the set on which they agree.
//
//   * the emitted BODY — `emitBinExprNode`'s `=` arm (`wasmEmit.vl`) lowers it
//     STORE-then-RE-READ: `emitAssign` stores, then the TARGET is re-read through the
//     normal Ident path. The value left on the stack has the TARGET's rep.
//   * the emitted FUNCTYPE — `emitTypeSection`'s un-annotated-return arm reads
//     `fRetKind`, filled by `criClassify` (`emit_classify.vl`).
//
// The cells below are the ones on which the two agreed even when the functype was
// derived from the assignment's RIGHT-HAND SIDE: an i32 / string / f64 / boolean /
// ref-array target assigned a value already in its own rep, as a GLOBAL and as a LOCAL
// — storing them needs no coercion, so the RHS's rep IS the target's.
//
// UPDATE: the functype no longer asks the RHS for ANY storage class. `criClassify`'s
// `fnAssignRetKind` (`emit_classify.vl`) dispatches over the assignment target's STORAGE
// CLASS, in the order the emitter resolves a target — a body `let` (`letCellKind`), then a
// parameter (`vtKindOfParam`), then a module global (`globalCellKind`) — so each class asks
// the very resolver that decides its own valtype and cannot drift from what
// store-then-re-read pushes. #1235 did the GLOBAL half (pinned by
// `tail-assign-coercing-global.vl` and `return-assign-expression-global.vl`); #1258 did the
// LOCAL and PARAM halves, and the coercing / weaker-RHS cells of those two classes are
// pinned by `tests/cases/statements/tail-assign-coercing-local.vl`. This file therefore pins
// the AGREEING floor those slices landed on, not a boundary — its cells were already green
// and stay green, which is what makes it the regression pin for the dispatch's easy rows.
// (The reason once given here for the LOCAL half's exclusion — "there is no local-cell-kind
// resolver reachable from that pass" — was measurably false: `parentLetOf` resolves one on
// exactly that pass, as `retIsMapLocalAnnot` and `criRetLocalLet` always did.)
type S = { n: i32 }

let g = 0

function bumpGlobal() { g = 5 }

// The result is genuinely a VALUE — reading it is what makes the functype's claim
// observable, and it is the same 5 the global now holds.
print(bumpGlobal())
print(g)

let gs = "a"

function setStr() { gs = "b" }

print(setStr())

let gd = 1.0

function setF64() { gd = 2.5 }

print(setF64())

let gb = false

function setBool() { gb = true }

print(setBool())

// A REF-ARRAY target: the re-read pushes this slot's element wrapper and the RHS
// literal builds the same one, so the two answers coincide on the wrapper too.
let xs: S[] = []

function setList() { xs = [{ n: 7 }] }

print(setList().length)

// The LOCAL half of the same shape — the target is a wasm local, not a global, and
// the tail is still the implicit return.
function localTail() {
  let n = 0
  n = 9
}

print(localTail())
