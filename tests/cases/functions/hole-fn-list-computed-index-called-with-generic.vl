// @run
// @log 3
// @log 4
// @log a
// @log 3
// @log 4
// @log b
// @log 3
// @log 4
// A one-element list of a hole function called at a computed index with a generic runs, and the
// index is still evaluated before the call (D7182).
function add(a, b) { return a + b }
function apply2(g) {
  print(g(1, 2))
  print(g(1.5, 2.5))
}
function note(s: string) {
  print(s)
  return 0
}
print(add(1, 2))
print(add(1.5, 2.5))
const fs = [apply2]
fs[note("a")](add)
function run() {
  const gs = [apply2]
  gs[note("b")](add)
}
run()
