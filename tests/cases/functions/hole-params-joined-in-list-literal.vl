// @run
// @log 7
// @log u
// @log 14
// @log uu
// @log 14
// @log uu
// @log 9
// @log 18
// Two hole parameters joined in one list literal handed to a callee that calls an element at two
// types are tagged with the join, which dispatches each type's instance (D15610).
function id(v) { return v }
function dbl(v) { return v + v }
function call0(fs, x) { print(fs[0](x)) }
function call1(fs, x) { print(fs[1](x)) }
function runTwo(g, h) {
  call1([g, h], 7)
  call1([g, h], "u")
}
runTwo(dbl, id)
function runLet(g, h) {
  const fs = [g, h]
  call0(fs, 7)
  call0(fs, "u")
}
runLet(dbl, id)
function mid(g, h) {
  call0([g, h], 7)
  call0([g, h], "u")
}
function outer(g, h) { mid(g, h) }
outer(dbl, id)
function runAll(g, h) {
  call1([g, h], 9)
  call0([g, h], 9)
}
runAll(dbl, id)
