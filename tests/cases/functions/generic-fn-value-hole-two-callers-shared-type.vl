// A generic handed to two hole functions, one calling it at two types and one at the first of
// them, takes a parameter per type in the first, whatever order the calls come in (D6280).
function add(a, b) { return a + b }
function apply2(g) {
  print(g(1, 2))
  print(g(1.5, 2.5))
}
function app3(g) { print(g(1, 2)) }
apply2(add)
app3(add)

function app4(g: (a: i32, b: i32) => i32) { print(g(1, 2)) }
apply2(add)
app4(add)

app3(add)
apply2(add)

const h = apply2
const k = app3
h(add)
k(add)
print(add(3, 4))
