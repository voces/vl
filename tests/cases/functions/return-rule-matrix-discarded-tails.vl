// @warning this value is discarded; did you mean `return …`?
// @log ran
// A pure tail a block body discards warns (A2): a bare expression, an `if`/`else`, an else-less `if`
// and a `match` whose arm values are pure, in an un-annotated function, a `void` one and a lambda.
function u_expr(x: i32) { x + 1 }
function v_expr(x: i32): void { x + 1 }
const n_expr = (x: i32) => {
  x + 1
}
u_expr(1)
v_expr(1)
n_expr(1)
function u_ifelse(x: i32) {
  if x > 0 { 1 } else { 2 }
}
function v_ifelse(x: i32): void {
  if x > 0 { 1 } else { 2 }
}
const n_ifelse = (x: i32) => {
  if x > 0 { 1 } else { 2 }
}
u_ifelse(1)
v_ifelse(1)
n_ifelse(1)
function u_elseless(x: i32) {
  if x > 0 { 1 }
}
function v_elseless(x: i32): void {
  if x > 0 { 1 }
}
const n_elseless = (x: i32) => {
  if x > 0 { 1 }
}
u_elseless(1)
v_elseless(1)
n_elseless(1)
function u_match(x: i32) {
  match x {
    0 => 5
    _ => 6
  }
}
function v_match(x: i32): void {
  match x {
    0 => 5
    _ => 6
  }
}
const n_match = (x: i32) => {
  match x {
    0 => 5
    _ => 6
  }
}
u_match(1)
v_match(1)
n_match(1)
print("ran")
