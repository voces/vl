// @run
// @log 6
// @log 5
// @log 7
// @log 2
// @log 11
// @log 3
// @log 20
// @log ok!
// @log 8
// @log 10
// A call whose type is `never` ends its path: `__trap__()`, `__trap__("why")`, and any function
// declared `: never` narrow the code after a guard, satisfy definite assignment, and stand in a
// value position, where the join drops them. The emitter follows each such call with
// `unreachable`, so every value position validates. D1972 (plumb PL-007 follow-up).
type IoError = { msg: string }

function fail(msg: string): never {
  print(msg)
  __trap__()
}

// A `never` function may end in another one.
function die(): never { fail("die") }

// The row's witness: an `is` guard whose arm traps.
function f(x: i64 | IoError) {
  if x is IoError { __trap__("io") }
  x * 2
}
print(f(3 as i64))

// A null guard through a user `never` function, under a prelude.
function g(x: i32 | null) {
  if x == null {
    print("no value")
    fail("null")
  }
  x + 1
}
print(g(4))

// Nested: both arms of an inner `if` end in a `never` call, and one sits in a bare block.
function h(x: i32 | null, k: i32) {
  if x == null {
    if k > 0 {
      {
        die()
      }
    } else {
      __trap__()
    }
  }
  x + 1
}
print(h(6, 1))

// A `match` whose every arm ends in one.
function m(c: boolean, k: i32) {
  let y: i32
  if c {
    y = 1
  } else {
    match k {
      1 => {
        fail("one")
      }
      _ => {
        __trap__()
      }
    }
  }
  y + 1
}
print(m(true, 1))

// Value positions: an if-expression arm, a match arm, and a function's tail.
function v(c: boolean) {
  const n = if c { 10 } else { fail("no") }
  n + 1
}
print(v(true))
function w(k: i32) {
  match k {
    1 => 3
    _ => die()
  }
}
print(w(1))
function t(c: boolean) {
  if c { return 20 }
  fail("tail")
}
print(t(true))

// A reference join and a float join.
function s(c: boolean) {
  const r = if c { "ok" } else { __trap__("no") }
  r + "!"
}
print(s(true))
function d(c: boolean) {
  const r = if c { 4.0 } else { fail("no") }
  r * 2.0
}
print(d(true))

// An annotated binding may take a `never` initializer; the code after it is dead.
function a(c: boolean) {
  if c { return 10 }
  const z: i32 = die()
  z
}
print(a(true))
