// @run
// @log 7
// @log 3.5
// @log 30
// @log 9
// @log 3
// @log ab
// A PARTIALLY annotated function (`function padd(a: i32, b)`) is a function VALUE at every
// boundary that declares its type: the written annotation is kept, the remaining HOLE is filled
// from the boundary. One written annotation used to make a function strictly WORSE as a value than
// the same function with none — `monoInstanceFor` required EVERY parameter to be a hole while the
// emit-time value floor (`fnHasUnannotatedParam`) is satisfied by ONE, and the gap between the two
// predicates was exactly this family.
//
// The gate that keeps it sound is AGREEMENT: an already-annotated parameter must match the
// boundary's param type, so a written `a: i32` is never re-read as a boundary's `f64` — that
// spelling rejects (`error-generic-fn-value-partial-annotation-mismatch.vl`). An explicit `<T>`
// generic is excluded from this path for the same reason and keeps the call-driven one.
function padd(a: i32, b) { return a + b }
function pmix(n: i32, x) { return x + n }
function pjoin(s: string, t) { return s + t }

// PARAMETER boundary — the callback param's declared type pins the instance. `pmix`'s hole is a
// DIFFERENT type from its written annotation, so the pin is doing real work rather than riding the
// i32 default that a hole would otherwise take.
function applyPI(g: (i32, i32) => i32, x: i32, y: i32) { return g(x, y) }
function applyPF(g: (i32, f64) => f64) { return g(1, 2.5) }
function applyPJ(g: (string, string) => string) { return g("a", "b") }

// RETURN boundary — the declared function return type pins it.
function mkPadd(): (i32, i32) => i32 { return padd }

type PBox = { op: (i32, i32) => i32 }

function go() {
  print(applyPI(padd, 3, 4)) // 7
  print(applyPF(pmix)) // 2.5 + 1 = 3.5

  // RETURN: bind the returned closure at its concrete type, then call it.
  const gi: (i32, i32) => i32 = mkPadd()
  print(gi(10, 20)) // 30

  // An annotated ARRAY of them, indexed and called.
  const fs: ((i32, i32) => i32)[] = [padd]
  print(fs[0](4, 5)) // 9

  // A struct FIELD declaring the function type.
  const bx: PBox = { op: padd }
  print(bx.op(1, 2)) // 3
}

go()

// A string HOLE beside a string-annotated parameter: the annotated half and the pinned half are
// the same type here, the arrangement that must not be special-cased away.
print(applyPJ(pjoin)) // ab
