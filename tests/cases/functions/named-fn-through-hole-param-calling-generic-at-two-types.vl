// @log t
// A named function handed to a hole parameter and called there with a generic, which it calls at
// two types, takes the generic's id: every set the calls through the parameter go through takes it
// (D14942).
function id(a) { return a }
function dup(a) { return a }
function lap(g) { print(g(1)); print(g("s")) }
function lop(g) { print(g(2)); print(g(true)) }
function use(k) { k(id) }
use(lap)
use(lop)
function both(k) { k(id); k(dup) }
both(lap)
function nested(k) {
  function inner() { k(id) }
  inner()
}
function top(g) { print(g(2) + 10); print(g("t")) }
nested(top)
