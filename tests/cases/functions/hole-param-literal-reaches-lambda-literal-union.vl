// @run
// @log b
// @log b
// @log true
// @log b
// @log 1
// D3171: a literal handed beside a function value to an un-annotated function is typed by the
// parameter of the function it reaches, as the direct call types it: a string at a literal union,
// at its nullable twin, with a boolean result, through a forwarder, and a record literal missing
// a nullable field.
type K = "a" | "b"
type R = { a: i32, b: i32 | null }
function H(h, v) { return h(v) }
function F(g, v) { return H(g, v) }
print(H((x: K) => x, "b"))
print(H((x: K | null) => x ?? "a", "b"))
print(H((x: K) => x == "b", "b"))
print(F((x: K) => x, "b"))
print(H((r: R) => r.a, { a: 1 }))
