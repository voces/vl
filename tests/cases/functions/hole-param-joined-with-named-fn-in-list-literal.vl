// @log 7
// @log u
// @log 7
// @log u
// A hole parameter joined in a list literal with a function the literal names directly, handed to
// a callee that calls an element at two types, is tagged with the join (D15625).
function id(v) { return v }
function dbl(v) { return v + v }
function tri(v) { return v + v + v }
function call0(fs, x) { print(fs[0](x)) }
function call1(fs, x) { print(fs[1](x)) }
function callBoth(fs, x) {
  print(fs[0](x))
  print(fs[1](x))
}
function call2(fs, x) { print(fs[2](x)) }
function named2nd(g) {
  call1([g, id], 7)
  call1([g, id], "u")
}
named2nd(dbl)
function named1st(g) {
  call0([id, g], 7)
  call0([id, g], "u")
}
named1st(dbl)
function both(g) {
  callBoth([g, id], 7)
  callBoth([g, id], "u")
}
both(dbl)
function three(g) {
  call2([g, id, tri], 7)
  call2([g, id, tri], "u")
}
three(dbl)
function twice(g) {
  call1([g, id], 7)
  call1([g, id], "u")
}
twice(dbl)
twice(id)
