// @run
// @log 3
// @log 3.5
// @log 3
// @log 3.5
// D5840: a literal handed through an un-annotated parameter takes its type from the parameter
// of the function the call hands it to, as a direct call's literal does: an empty list, a nested
// list, a literal-union string, and a nested list through a forwarder into a const lambda.
type K = "x" | "y"
function tE(a: i32, b: string[]) { a + b.length }
function tN(a: i32, b: f64[][]) { a + b[0][0] / 2 }
function tK(a: i32, b: K) {
  if b == "x" { return a } else { return 0 }
}
function apply(g, x, y) { return g(x, y) }
print(apply(tE, 3, []))
print(apply(tN, 3, [[1]]))
print(apply(tK, 3, "x"))
const ap = (g, x, y) => g(x, y)
function outer(h) { return ap(h, 3, [[1]]) }
print(outer(tN))
