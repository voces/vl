// @run
// @log D:hi
// @log C:hi
// @log L:hi
// @log T:hi
// @log D:3
// @log NO-nested
// @log NO-lambda
// @log NO-chain
// A closure that CAPTURES a binding narrowed at the closure's DECLARATION SITE reads it at
// the narrowed rep. The closure body is lexically inside the guard, so the checker narrows
// the capture there — and the emitter has to agree, which it did not: the narrowing stack
// is per-function-body and a lifted body is emitted on its own, so inside the callee the
// read had NO rep and pushed the raw `(ref $uBox)` where the `string` arm was expected.
// `vl check`-clean INVALID WASM (`expected (ref $type), found (ref $type)` — the box vs the
// string), at EVERY capture route.
//
// The env FIELD was never wrong: `captureValKind` types it from the DECLARATION and the box
// is what the declaration holds. The READ was the wrong half. `capNarrowBuild` banks the
// narrowing SLOT active where each closure is written and `capNarrowSeed` replays it at the
// two walks that enter a function body (the classifier's and the emitter's).
//
// Every arm here is written TWICE: `D:` is the same guard and the same read with no capture
// — the oracle — and `C:` / `L:` / `T:` read it through a nested function, an arrow lambda,
// and a two-level capture chain (the value flows env-to-env). Both runtime inputs are
// exercised: the `string` member and the `i32` member, so the else-arm complement read is
// pinned too. Each nested function needs a DISTINCT name — capture analysis is name-keyed
// module-wide.
function shapes(u: string | i32) {
  if u is string {
    print("D:" + u)
  } else {
    print("D:" + toString(u))
  }
  if u is string {
    function capNested() {
      print("C:" + u)
    }
    capNested()
  } else {
    print("NO-nested")
  }
  if u is string {
    const capLambda = () => {
      print("L:" + u)
    }
    capLambda()
  } else {
    print("NO-lambda")
  }
  if u is string {
    function capOuter() {
      function capInner() {
        print("T:" + u)
      }
      capInner()
    }
    capOuter()
  } else {
    print("NO-chain")
  }
}

function mk(b: boolean): string | i32 {
  if b { return "hi" }
  return 3
}

function main() {
  shapes(mk(true))
  shapes(mk(false))
}

main()
