// @run
// @hint redundant type annotation: `m` is inferred as `string`
// @hint redundant type annotation: `top` is inferred as `string`
// A NESTED named function with no return annotation whose inferred return is a union or a
// nullable (D1966). Its row is keyed by its declaration, not its name: the name is not unique
// (a top-level or sibling namesake) and its binding is gone once the enclosing scope pops.
function m(): string { return "top" }

function apply(f: (i32) => i32 | null, k: i32): i32 | null { return f(k) }

function popLocal() {
  // the filed witness: a tail `.pop()` is `i32 | null`
  function m() {
    const out = [1, 5]
    out.pop()
  }
  print(m())
  // @log 5
}

function popCaptured() {
  const xs = [1, 2]
  function take() { xs.pop() }
  print(take())
  // @log 2
  print(xs.length)
  // @log 1
}

function popEveryElement() {
  function f() {
    const fs = [1.5, 2.5]
    fs.pop()
  }
  print(f() ?? -1.0)
  // @log 2.5
  function s() {
    const ss = ["a", "b"]
    ss.pop()
  }
  print(s() ?? "none")
  // @log b
  function p() {
    const ps = [{ x: 3, y: 4 }]
    ps.pop()
  }
  const pv = p()
  if (pv != null) { print(pv.x) } else { print(-1) }
  // @log 3
  function l() {
    const ls = [[1, 2]]
    ls.pop()
  }
  const lv = l()
  if (lv != null) { print(lv.length) } else { print(-1) }
  // @log 2
}

function joins(k: i32) {
  // an explicit `return` join, and a two-scalar value union
  function orNull(q: i32) {
    if (q > 0) { return q * 10 }
    return null
  }
  print(orNull(k) ?? -1)
  // @log 40
  print(orNull(0) ?? -1)
  // @log -1
  function either(q: i32) {
    if (q > 0) { return q }
    "s"
  }
  print(either(k))
  // @log 4
  print(either(0))
  // @log s
}

function twoDeep() {
  function mid() {
    function inner() {
      const ss = ["q"]
      ss.pop()
    }
    print(inner() ?? "none")
    // @log q
  }
  mid()
}

function recursive() {
  function fact(k: i32) {
    if (k <= 1) { return 1 }
    return k * fact(k - 1)
  }
  print(fact(5))
  // @log 120
  function down(k: i32) {
    if (k <= 0) { return null }
    if (k == 1) { return 10 }
    return down(k - 1)
  }
  print(down(3) ?? -1)
  // @log 10
  print(down(0) ?? -1)
  // @log -1
}

function asValue() {
  function pop2(k: i32) {
    const xs = [k, k + 1]
    xs.pop()
  }
  print(apply(pop2, 4) ?? -1)
  // @log 5
  const g = pop2
  print(g(7) ?? -1)
  // @log 8
}

function shadowA() {
  function m() { 1 + 1 }
  print(m())
  // @log 2
}

function shadowB() {
  function m() {
    const xs = [1, 5]
    xs.pop()
  }
  print(m() ?? -1)
  // @log 5
}

// sibling namesakes whose unions differ in rep: each call resolves in its own frame
function sibB() {
  function k(b: boolean) {
    if b { return 2.5 }
    null
  }
  const r = k(true)
  if r != null { print(r * 2.0) }
  // @log 5
  print(k(false) == null)
  // @log true
}

function sibA() {
  function k(b: boolean) {
    if b { return 1 }
    "one"
  }
  const r = k(true)
  if r is i32 { print(r + 1) } else { print(r) }
  // @log 2
  print(k(false))
  // @log one
}

function id<T>(v: T): T { v }

// a generic call's pin reads the nested callee's return, not the top-level namesake's
function monoPin() {
  function m() { 2.5 }
  print(id(m()) * 2.0)
  // @log 5
}

popLocal()
popCaptured()
popEveryElement()
joins(4)
twoDeep()
recursive()
asValue()
shadowA()
shadowB()
sibB()
sibA()
monoPin()
print(id(m()))
// @log top
// the top-level `m` keeps its own `string` return, whatever its nested namesakes infer
const top: string = m()
print(top)
// @log top
