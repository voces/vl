// @run
// @warning Unused function `never` (prefix with `_` to suppress, remove it, or `export` it)
// @warning Unused function `quiet` (prefix with `_` to suppress, remove it, or `export` it)
// @log x
// @log 3
// @log y
// @log 4
// A hole function's parameter written into a `let` seeded with a generic: a direct call that hands
// on its caller's own parameter hands what reaches that one, and a call or a store in a function
// nothing calls hands nothing.
function same<T>(k: T): T { k }
function plain(a) {
  let b = same
  b = a
  print(a("x"))
  print(b(3))
}
function outer(a) { plain(a) }
outer(same)
function never(a) { plain(a) }
function quiet(a) {
  let b = same
  b = a
}
function solo(a) {
  let b = same
  b = a
  print(a("y"))
  print(b(4))
}
solo(same)
