// @run
// A three-arm `else if` choice in a generic instance (an un-annotated condition): each link of the
// chain is an arm of the outer join, built at the join's rep whatever its kind (functions held at
// their set's id, records, lists).
function id(v) { return v }
function dbl(v) { return v + v }
function neg(v) { return 0 - v }
function t(b) {
  const g = if b { id } else if b { dbl } else { neg }
  print(g(3))
}
t(false)
function u(b, c) {
  const g = if b { id } else { if c { dbl } else { neg } }
  print(g(3))
  print(g(2.5))
}
u(false, true)
function rec(b) {
  const r = if b { { a: 1, s: "x" } } else if b { { a: 2, s: "y" } } else { { a: 3, s: "z" } }
  print(r.a)
  print(r.s)
}
rec(false)
function lst(b) {
  const l = if b { [1, 2] } else if b { [3] } else { [4, 5, 6] }
  print(l.length)
}
lst(false)
// @log -3
// @log 6
// @log 5
// @log 3
// @log z
// @log 3
