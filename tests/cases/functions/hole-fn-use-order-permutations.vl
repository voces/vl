// D9031: an un-annotated function gets its own instance at each use, so the order of its
// uses never changes the answer. Each copy below takes the same four uses in one of the 24
// orders: a delivery to a parameter of type `(a: i32) => i32`, a record field of type
// `(a: f64) => f64`, and direct calls at `f64` and `i32`.
function wa(h: (a: i32) => i32) { return h(3) }
type Rf = { f: (a: f64) => f64 }

// order 1 2 3 4
function inc1(a) { return a + 1 }
print(wa(inc1))
const r1: Rf = { f: inc1 }
print(r1.f(0.5))
print(inc1(3.5))
print(inc1(7))
// order 1 2 4 3
function inc2(a) { return a + 1 }
print(wa(inc2))
const r2: Rf = { f: inc2 }
print(r2.f(0.5))
print(inc2(7))
print(inc2(3.5))
// order 1 3 2 4
function inc3(a) { return a + 1 }
print(wa(inc3))
print(inc3(3.5))
const r3: Rf = { f: inc3 }
print(r3.f(0.5))
print(inc3(7))
// order 1 3 4 2
function inc4(a) { return a + 1 }
print(wa(inc4))
print(inc4(3.5))
print(inc4(7))
const r4: Rf = { f: inc4 }
print(r4.f(0.5))
// order 1 4 2 3
function inc5(a) { return a + 1 }
print(wa(inc5))
print(inc5(7))
const r5: Rf = { f: inc5 }
print(r5.f(0.5))
print(inc5(3.5))
// order 1 4 3 2
function inc6(a) { return a + 1 }
print(wa(inc6))
print(inc6(7))
print(inc6(3.5))
const r6: Rf = { f: inc6 }
print(r6.f(0.5))
// order 2 1 3 4
function inc7(a) { return a + 1 }
const r7: Rf = { f: inc7 }
print(r7.f(0.5))
print(wa(inc7))
print(inc7(3.5))
print(inc7(7))
// order 2 1 4 3
