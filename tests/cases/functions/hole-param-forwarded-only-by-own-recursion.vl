// @run
// @log x
// @log 1
// @log x
// @log 0
// A hole parameter handed only to its own function's recursion reaches no use, so a generic it is
// handed is still tagged where a swapped recursion beside it calls that generic at two types
// (D15405).
function same<T>(k: T): T { k }
function twice<T>(k: T): T { k }
function mid(a, b, n: i32) {
  print(a("x"))
  print(b(n))
  if n > 0 { mid(b, a, n - 1) }
}
function third(a, n: i32) {
  if n > 0 { third(a, n - 1) }
}
third(same, 1)
mid(same, twice, 1)
