// @check
// @error-at 12:6 K[] is not string[]: a container never widens implicitly
// @error-at 17:6 i32[] is not f64[] here: this list is written (line 16), and a written container never widens implicitly
// @hint redundant type annotation: `xs` is inferred as `i32[]`
// D2165 — a method-call receiver is `self`'s argument and takes the argument's verdict: the
// direct spellings `jn(ks)` and `sm(xs)` refuse, so the receiver spellings refuse too, with the
// same message. `xs`'s annotation is load-bearing: the rule's hard case is a pinned source.
// `ufcs-receiver-container-widening-runs.vl` is the read-only control, which both spellings
// accept.
type K = "a" | "b"
function jn(self: string[]) { return self.length }
const ks: K[] = ["a", "b"]
print(ks.jn())

// Written through `self`, so a converting copy would lose the write.
function sm(self: f64[]) { self[0] = 2.5; return self[0] }
const xs: i32[] = [1, 2]
print(xs.sm())
