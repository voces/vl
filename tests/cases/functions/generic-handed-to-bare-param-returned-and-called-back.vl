// @run
// @log 3
// @log x
// A generic handed to a callee that returns it, called back at another type: the hand-on is
// followed, not skipped, and each call takes its own instance.
function same<T>(k: T): T { k }
function wrap<G>(g: G) { return g }
function mid<F>(a: F) {
  const r = wrap(a)
  print(r(3))
  print(a("x"))
}
mid(same)
