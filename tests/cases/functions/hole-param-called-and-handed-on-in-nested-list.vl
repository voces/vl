// @run
// @log 5
// @log s
// @log 5
// @log s
// @log 5
// @log s
// @log 5
// @log s
// @log 7
// A hole parameter called directly at one type and handed on inside a nested list literal, or a
// `const` of one, to a callee that calls the element at another takes each type's instance
// (D15637).
function id(v) { return v }
function call2(fss, x) { print(fss[0][0](x)) }
function call3(fsss, x) { print(fsss[0][0][0](x)) }
function callAt(fss, x) { const f = fss[1][0]; print(f(x)) }
function run(g) {
  print(g(5))
  call2([[g]], "s")
}
function runConst(g) {
  print(g(5))
  const ws = [[g]]
  call2(ws, "s")
}
function runDeep(g) {
  print(g(5))
  call3([[[g]]], "s")
}
function runTwo(g) {
  print(g(5))
  callAt([[g], [g]], "s")
  callAt([[g], [g]], 7)
}
run(id)
runConst(id)
runDeep(id)
runTwo(id)
