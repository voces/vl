// @check
// @error-at 10:51 return type mismatch: expected ((i32) => i32)[][], got ((_) => _)[][]
// A set's un-annotated member whose body cannot hold at the delivered signature refuses the
// delivery, as the first member's would (D16700).
function inc(a) { return a + 1 }
function cat(a) { return a + "x" }
function give(_n) {
  const w = [[inc], [cat]]
  return w
}
function deliver(): ((a: i32) => i32)[][] { return give(1) }
print(deliver()[1][0](3))
