// @log 7
// @log 4
// @log 3
// @log ab
// A hole function forwarded through a parameter to a hole called at two types, in a call that
// leaves a defaulted parameter out, is handed once per type (D6707).
function add(a, b) { return a + b }
function apply2(g, n: i32 = 1) {
  print(g(n, 2))
  print(g(1.5, 2.5))
}
function applyS(g, n: i32 = 1) {
  print(g(n, 2))
  print(g("a", "b"))
}
function fwd(h) { apply2(h); apply2(h, 5) }
function fwdS(h) { applyS(g: h) }

print(add(1, 2))
print(add(1.5, 2.5))
fwd(add)
fwdS(add)
