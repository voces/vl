// @run
// @log s
// @log 1
// @log 41
// @log 42
// A written generic `let` called at two types holds its set's id, and so does a copy of it written
// into an un-annotated binding or map: the write stores the id, not one instance's closure (D16363).
function id<T>(x: T): T { return x }
let f = id
f = id
print(f("s"))
print(f(1))
let v = f
v = f
print(v(41))
const m = Map()
m["k"] = f
const g = m["k"] ?? f
print(g(42))
