// @check
// @error operator '+' is not defined for string and i32 (in `lap`, at one of the instances it calls a function argument at)
// @error operator '+' is not defined for string and i32 (in `lap2`, at one of the instances it calls a function argument at)
// @error operator '+' is not defined for string and i32 (in `lap3`, at one of the instances it calls a function argument at)
// A hole called at two instances has each operator over its results judged at each one, as the
// direct spelling `"" + 1` is, whether it is handed a declared function or a `const` lambda, and
// whether the result is read in place or through a binding (D6300).
function id(a) { return a }
const lid = (a) => a
function lap(g) {
  print("" + g(1))
  return g("s")
}
function lap2(g) {
  print("" + g(1))
  return g("s")
}
function lap3(g) {
  const a = g(1)
  const b = g("s")
  return "" + a + b
}
print(lap(id))
print(lap2(lid))
print(lap3(id))
