// @error operator '+' is not defined for string and i32
// A call through the binding at the enclosing generic's type parameter is re-asked at each of
// its instances, as a direct call is (D3968).
function inner<U>(u: U) { print(u) }
function plus<V>(v: V) { print(v + 1) }
function g<T>(t: T) {
  let k = inner
  k = plus
  k(t)
}
g(1)
g("s")
