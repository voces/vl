// @run
// @log 1
// @hint `x` inferred as string from `shout(…x…)`; annotate to freeze the export
// @hint `v` inferred as f64 from `return v`; annotate to freeze the export
// @hint `n` inferred as i64 from `const m: … = n`; annotate to freeze the export
// @warning Unused function `deadCode`
// An exported function nothing in the program calls takes each untyped parameter's type from
// the use that pins it: an argument to a typed parameter, a return under an annotated result,
// a binding with an annotation. A function that is not exported stays dead code (D3817).
function shout(s: string) { s + "!" }

export function t(x) { print(shout(x)) }
export function r(v): f64 { return v }
export function b(n) {
  const m: i64 = n
  print(m)
}
function deadCode(x) { x * 2 }
print(1)
