// @run
// @log 4
// @log 4
// @log 5
// @log -4
// @log 2.5
// @warning Unused parameter `g`
// A generic handed to a written `let` lambda whose write calls it on its own result takes the
// instance the inner call makes; the outer call agrees with it (D6111).
function neg(a) { return 0 - a }
function show(v: i32) { print(v) }
let lap = (g, x) => x + 1
lap = (g, x) => g(g(x))
print(lap(neg, 4))

// The result delivered to an annotated parameter, and to a binding.
show(lap(neg, 4))
const r = lap(neg, 5)
print(r)

// Three calls deep.
let lap3 = (g, x) => x + 1
lap3 = (g, x) => g(g(g(x)))
print(lap3(neg, 4))

// At `f64`.
let lapf = (g, x) => x + 1.0
lapf = (g, x) => g(g(x))
print(lapf(neg, 2.5))
