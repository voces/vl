// @error cannot assign (i32) => void to `a`: it keeps the generic type of its initializer
// An un-annotated alias of a generic `let` is generic too (D3960).
function inner<U>(u: U) { print(u) }
function q(n: i32) { print(n + 1) }
function main() {
  const k = inner
  let a = k
  a = q
  a(1)
}
main()
