// @run
// @log 4
// @log 4
// @log 4
// @log 4
// @log 4
// @log 4
// @log 4
// @warning Unused parameter `g`
// A function handed to a parameter nothing reads takes the first default its body admits, so a
// body reading `.length`, indexing, pushing or joining a string is not refused at `i32`; nothing
// calls it, so none can observe which (D6301).
function outer(g) { return 4 }
function len(a) { return a.length }
function first(a) { return a[0] + 1 }
function pu(a) {
  a.push(1)
  return 0
}
function cat(a) { return a + "!" }
const llen = (a) => a.length
print(outer(len))
print(outer(first))
print(outer(pu))
print(outer(cat))
print(outer(llen))
print(outer((a) => a.length))
print(
  outer((a) => {
    a.push(1)
    return 0
  }),
)
