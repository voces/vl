// @run
// @log 1001
// @log 21
// THE SECOND HALF OF THE PAIR — see `scope-index-reset-a.vl`.
//
// FOUR functions again, so `fnStmts.length` matches `-a`'s exactly, but the parents are
// `[-1, -1, -1, 2]`: a TOP-LEVEL `inner`, two makers, and `makeB`'s own nested `inner` at
// position 3. `-a`'s columns say frame 1 owns position 3 and frame 2 owns nothing, which
// is false here in both directions — so a STALE index gets BOTH logs wrong, and swaps
// them: `makeA` reaches `makeB`'s nested `inner` (21 for 1001) and `makeB` runs off the
// chain to the top-level one (1001 for 21). Both with rc=0.
//
// This is a pin on the RESET, not on the walk — the walk itself is pinned by
// `nested-same-name-*.vl`. It can only fail in a SHARED instance: one process per file
// rebuilds the index from scratch every time, which is why the corpus A/B cannot see it.
function inner(y: i32) {
  return y + 1000
}

// CONTROL: an unshadowed frame runs off the chain and reaches the top-level `inner`.
function makeA(x: i32) {
  return inner(x)
}

function makeB(x: i32) {
  function inner(y: i32) {
    return y + 20
  }
  return inner(x)
}

print(makeA(1))
print(makeB(1))
