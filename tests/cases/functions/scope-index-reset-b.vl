// @run
// @log 21
// THE SECOND HALF OF THE PAIR — see `scope-index-reset-a.vl`.
//
// FOUR functions again, so `fnStmts.length` matches `-a`'s exactly, but the parents are
// `[-1, -1, -1, 2]`: a TOP-LEVEL `inner` (which the flat first-wins map would hand out),
// two makers, and `makeB`'s own nested `inner` at position 3.
//
// The lexical rule says `inner(1)` inside `makeB` means `makeB`'s own — 21. Under `-a`'s
// STALE child index frame 2 has no children, the walk runs off the chain, and `fnIndexOf`
// answers with the top-level `inner`: 1001, rc=0. The `@log` below is therefore a pin on
// the RESET, not on the walk — the walk itself is pinned by `nested-same-name-*.vl`.
function inner(y: i32) {
  return y + 1000
}

function makeA(x: i32) {
  return x
}

function makeB(x: i32) {
  function inner(y: i32) {
    return y + 20
  }
  return inner(x)
}

print(makeB(1))
