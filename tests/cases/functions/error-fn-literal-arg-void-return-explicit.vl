// @check
// @error-at 15:9 return type mismatch: expected void, got i32
// CONTRACT (must-error): an EXPLICIT `return expr` in a function literal checked
// against a `() => void` parameter stays a type error under the void-discard
// semantics (DECISIONS: it states an intent the compiler holds the author to),
// and the diagnostic anchors at the OFFENDING RETURN SITE — the returned
// expression — not at the literal's own closing brace or the call's end. Same
// arm, message and anchor as `function f(): void { return 7 }`. The bare-tail
// spelling of the same body is accepted and discarded
// (`error-fn-literal-arg-void-return-bare-tail.vl`).
function g(cb: () => void) {
  cb()
}
g(() => {
  print(1)
  return 7
})
