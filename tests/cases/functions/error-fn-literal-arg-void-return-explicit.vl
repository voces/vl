// @check
// @error-at 11:9 argument 1: expected () => void, got () => i32
// CONTRACT (must-error): a function-literal argument whose RETURN type the
// parameter forbids is rejected, and the diagnostic anchors at the OFFENDING
// RETURN SITE — the returned expression — not at the literal's own closing
// brace (`nodeToks` anchors every node at its LAST token) or the call's end.
function g(cb: () => void) {
  cb()
}
g(() => {
  print(1)
  return 7
})
