// @run
// @log 9
// A tail assignment of `null` to a nullable ref-array global is a `null`-typed return: the
// checker types the assignment `null`, so its value is the literal, not a re-read of the
// `S[] | null` cell, and the functype reads that type rather than the cell's kind (D14491).
type S = { n: i32 }

let xs: S[] | null = null

function clearXs() { xs = null }

// Read, so the result is the function's return (a statement call leaves it `void`, D2631).
if clearXs() == null { print(9) }
