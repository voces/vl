// @run
// @log x
// @log null
// @log 2
// A returned else-less `if` under a return type that admits `null` is graded arm by arm, so a
// literal arm keeps its literal type against `L | null`, and a false test returns `null` (D2041).
type L = "x" | "y" | "z"
function f(c: boolean): L | null { return if c { "x" } }
function g(c: boolean): i32 | null { return if c { 1 } else if !c { 2 } }
print(f(true))
print(f(false))
print(g(false))
