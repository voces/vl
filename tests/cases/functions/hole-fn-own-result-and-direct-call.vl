// @run
// @log 4
// @log 1
// @log 4
// @log 1
// @log 4
// @log 1
// @log 4
// @log 5
// @log 4
// @log 4
// @log 4
// @log 1
// @hint redundant type annotation
// A function handed to a hole called on its own result keeps that call's instances to itself,
// so another use of the function at another type runs (D6251).
function wrap(a) { return [a] }
function lapRet(g, x) { return g(g(x)) }
function lapB(g, x) { return g(x).length }
function lapIf(g, x) {
  if x > 3 { return g(g(x)) }
  return g(g(0))
}
function lapConst(g, x) {
  const y = g(g(x))
  return y
}
function use(v) { return v[0][0] }
print(lapRet(wrap, 4)[0][0])
print(wrap(true).length)
const q: i32[][] = lapRet(wrap, 4)
print(q[0][0])
print(wrap(5).length)
print(lapRet(wrap, 4)[0][0])
print(lapB(wrap, true))
print(lapRet(wrap, 4)[0][0])
print(lapRet(wrap, 5)[0][0])
print(lapIf(wrap, 4)[0][0])
print(lapConst(wrap, 4)[0][0])
print(use(lapRet(wrap, 4)))
print(wrap("s").length)
