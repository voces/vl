// @run
// @log 3
// @log 4
// @log 5
// @log 6
// @log 7
// @log 8
// @log end
// A named `never` function passed as a callback is called through the specialization that bakes
// it in; the call never returns at any value position: a return, an operand, a union `const`, a
// union return, a tail `if`'s arm and an argument.
type B = (s: string) => never
function bail(s: string): never {
  print(s)
  __trap__()
}
function ret(b: B, c: boolean) {
  if c { return 3 }
  return b("x")
}
function opnd(b: B, c: boolean) {
  if c { return 4 }
  return b("y") + 1
}
function cst(b: B, c: boolean): i32 | string {
  if c { return 5 }
  const u: i32 | string = b("z")
  return u
}
function uni(b: B, c: boolean): i32 | string {
  if c { return 6 }
  return b("w")
}
function tailIf(b: B, c: boolean) { return if c { 7 } else { b("v") } }
function show(n: i32) { print(n) }
function arg(b: B, c: boolean) {
  if c { show(8) } else { show(b("u")) }
}
print(ret(bail, true))
print(opnd(bail, true))
print(cst(bail, true))
print(uni(bail, true))
print(tailIf(bail, true))
arg(bail, true)
print("end")
