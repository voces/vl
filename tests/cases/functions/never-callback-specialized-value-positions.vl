// @run
// @log 3
// @log 4
// @log 5
// @log 6
// @log end
// A named `never` function passed as a callback is called through the specialization that bakes
// it in; the call never returns at any value position: a return, an operand, a union `const` and a
// union return.
type B = (s: string) => never
function bail(s: string): never {
  print(s)
  __trap__()
}
function ret(b: B, c: boolean) {
  if c { return 3 }
  return b("x")
}
function opnd(b: B, c: boolean) {
  if c { return 4 }
  return b("y") + 1
}
function cst(b: B, c: boolean): i32 | string {
  if c { return 5 }
  const u: i32 | string = b("z")
  return u
}
function uni(b: B, c: boolean): i32 | string {
  if c { return 6 }
  return b("w")
}
print(ret(bail, true))
print(opnd(bail, true))
print(cst(bail, true))
print(uni(bail, true))
print("end")
