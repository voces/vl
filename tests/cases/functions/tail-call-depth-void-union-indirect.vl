// @run
// @log 1000000
// @log 1000000
// @log 2000000
// @log done
// @log 1000000
// @log 3000000
// @log 1000005
// @log 500500
// @log xxxxx
// @log 110
// @hint redundant type annotation: `step` is inferred as `i32`
// @hint redundant type annotation: `bounce` is inferred as `i32`
// @hint redundant type annotation: `via` is inferred as `i32`
// @hint redundant type annotation: `outer` is inferred as `i32`
// @hint redundant type annotation: `sum` is inferred as `i32`
// @hint redundant type annotation: `twice` is inferred as `i32`
// Four more shapes whose call is in tail position, each a million levels deep, which
// overflows the stack unless the call reuses the caller's frame:
//   · `return f()` in a void function (D4654), and a void body ending in a bare call (D4655).
//   · a call returned through a union return type (D4656).
//   · a call through a function value, lowered to `return_call_indirect` (D4657).
// The last three prints are controls: a call with work after it is not a tail call.
let total = 0
function downReturn(n: i32): void {
  if n == 0 { return }
  total = total + 1
  return downReturn(n - 1)
}
downReturn(1_000_000)
print(total)

let bare = 0
function downBare(n: i32): void {
  if n == 0 { return }
  bare = bare + 1
  downBare(n - 1)
}
downBare(1_000_000)
print(bare)

let arms = 0
function downArms(n: i32): void {
  if n == 0 {
    return
  } else {
    arms = arms + 2
    return downArms(n - 1)
  }
}
downArms(1_000_000)
print(arms)

function walk(n: i32): i32 | string {
  if n == 0 { return "done" }
  return walk(n - 1)
}
print(walk(1_000_000))

function step(n: i32, acc: i32): i32 {
  if n == 0 { return acc }
  const f = step
  return f(n - 1, acc + 1)
}
print(step(1_000_000, 0))

function bounce(n: i32, acc: i32): i32 {
  if n == 0 { return acc }
  return via(bounce, n - 1, acc + 3)
}
function via(f: (n: i32, acc: i32) => i32, n: i32, acc: i32): i32 {
  return f(n, acc)
}
print(bounce(1_000_000, 0))

function outer(k: i32): i32 {
  function inner(n: i32, acc: i32): i32 {
    if n == 0 { return acc + k }
    return inner(n - 1, acc + 1)
  }
  return inner(1_000_000, 0)
}
print(outer(5))

function sum(n: i32): i32 {
  if n == 0 { return 0 }
  return n + sum(n - 1)
}
print(sum(1000))

let order = ""
function note(n: i32): void {
  if n == 0 { return }
  note(n - 1)
  order = order + "x"
}
note(5)
print(order)

function twice(n: i32): i32 {
  const g = sum
  return g(n) * 2
}
print(twice(10))
