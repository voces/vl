// @run
// @log 1
// CONTRACT (D887, and this file used to hold its opposite): an un-annotated function whose
// returns join to a NULLABLE STRUCT ref (`{x: i32} | null`) LOWERS, exactly as the annotated
// `: {x: i32} | null` spelling always did. It used to floor with
// `'find' infers the nullable return type {x: i32} | null — type-valid, but an inferred return
// of this shape is not yet supported by codegen`, which conceded the program's type-validity in
// its own sentence — a capability refusal, not a design rule, and so a clause-2 violation of the
// standing goal. The rep was never missing: the checker recorded no inferred-return row for the
// shape, so the emitter's A20 pass kept `fRetKind`'s `"i32"` default and the floor existed to
// stop that default reaching codegen.
//
// The file KEEPS ITS NAME so the history reads straight: it is the pin for the refusal that was
// lifted, and a rename would hide that this fixture once asserted the opposite. A nullable the
// renderer still cannot name floors with the message unchanged — see `nullableRetName`'s
// declines. D937 removed the i32-valued string-keyed MAP from that list (see
// `infer-nullable-map-return.vl`); a map with any other value type, and an un-internable field,
// still floor.
function find(c: boolean) {
  if c { return null }
  return { x: 1 }
}
function go(c: boolean) {
  const v = find(c)
  if v != null { print(v.x) }
}
go(false)
