// @run
// @log 2
// @log 2
// @hint redundant type annotation: `outer` is inferred as `i32`
// @hint redundant type annotation: `host` is inferred as `i32`
// The FALSE-POSITIVE guard for the exported-uncalled-generic reject
// (`error-exported-generic-uncalled.vl`). One NAME, two carriers: an exported CONCRETE
// `outer` and an un-instantiated `outer<T>` nested inside `host`, which lambda lifting
// appends to `fnStmts` UNMANGLED.
//
// The reject asks whether an un-instantiated generic is the module's ABI entry. Asking that
// by NAME alone answers yes here and rejects a program that is completely correct — measured,
// and the reason `monoFirstFnIndexNamed` exists: the gate mirrors `emitExportSection`'s own
// resolution (the FIRST `fnStmts` slot with the name), so the nested homonym is not the
// carrier and goes on taking the routine silent no-op stub.
//
// Lifting appends, so the top-level export wins the scan whichever order the two are written
// in — the reversed source order (`host` first) was measured too and is likewise unaffected.
export function outer(n: i32): i32 { return n + 1 }

function host(): i32 {
  function outer<T>(x: T): T { return x }
  return 2
}

print(outer(1))
print(host())
