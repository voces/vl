// @run
// @log 8
// @log 12
// @log a-b
// @log 1.5
// @log 8
// @log a-b
// @log 11
// @warning Unused variable `K` (prefix with `_` to suppress, or remove it)
// @warning Unused variable `S` (prefix with `_` to suppress, or remove it)
// A default may name a MODULE-SCOPE `const`. It is still call-site sugar — the
// expression is substituted into every call that omits the argument — and the
// rule that makes that sound is the one this case exists to pin:
//
//   THE EXPRESSION COMES FROM THE DECLARATION AND ITS NAMES RESOLVE THERE.
//   Only its EVALUATION POSITION is the call site.
//
// `const` and not `let`: an immutable module binding has the same value at every
// site, so "evaluated at the declaration" and "evaluated at the call" cannot be
// told apart, and v1 owes no answer about which it meant.
const K = 7
const S = "-"
const F = 0.5

function f(a: i32, b: i32 = K) { a + b }
print(f(1))
print(f(1, 11))

function join2(a: string, b: string, sep: string = S) { a + sep + b }
print(join2("a", "b"))

function fl(a: f64, b: f64 = F) { a + b }
print(fl(1.0))

// THE HYGIENE THE RULE BUYS, and the two `Unused variable` warnings declared
// above are the point rather than noise: a caller-local binding sharing the
// const's name does NOT capture the substituted reference, so these locals are
// genuinely dead. The checker marks the default node as a module reference and
// resolves it against the module frame; the emitter reads the same mark and
// emits `global.get` without consulting the caller's locals. Without the mark
// this prints 901 and `xLOCAL`, and the two locals would be "used".
function caller() {
  const K = 900
  return f(1)
}
function callerS() {
  const S = "LOCAL"
  return join2("a", "b")
}
print(caller())
print(callerS())

// And through UFCS, where the receiver fills slot 0 and the const fills the tail.
function scale(self: i32, by: i32, plus: i32 = K) { self * by + plus }
print(2.scale(2))
