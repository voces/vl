// @run
// @log 2
// @log s
// @log 2
// @log s
// @log 2
// @log t
// @log 2
// @log t
// @info `lap` is never reassigned; use `const` instead of `let`
// @info `lap2` is never reassigned; use `const` instead of `let`
// A `const` alias of a never-assigned `let` lambda, called with a generic it calls at two
// types, runs like the alias of a `const` lambda (D6390). Also called by both names, and with
// the alias read twice.
function id(a) { return a }
let lap = (g) => {
  print(g(1) + 1)
  return g("s")
}
const k = lap
print(k(id))
print(lap(id))
let lap2 = (g) => {
  print(g(1) + 1)
  return g("t")
}
const k2 = lap2
print(k2(id))
print(k2(id))
