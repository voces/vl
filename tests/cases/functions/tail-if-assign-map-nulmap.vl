// @run
// @log 7
// @hint redundant type annotation: `gc` is inferred as `{[string]: S}` — remove it to lean on inference
// The witness of D2665, which runs since the tail-assignment return is read off the checker's type.
type S = { a: i32 }
function mkR(v: i32): {[string]: S} {
  const m: {[string]: S} = Map()
  m["a"] = { a: v }
  return m
}
let gd: {[string]: S} | null = null
let gc: {[string]: S} = mkR(1)
function fc(c: boolean) {
  if c { gc = mkR(8) } else { gd = mkR(7) }
}
const r = fc(false)
const v = r["a"]
if v != null { print(v.a) }
