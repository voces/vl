// @run
// @log 1.5
// @log 1.5
// @log 7
// @log -1
// A top-level statement checks the annotated functions it reaches below it before itself, as an
// early function's body does: a generic handed to a generic, and a guard function read by a callee.
print(k(1.5, gid)[0])
const m = mapL([2.0, 1.5], gid)
print(m[1])
print(readX(1))
print(readX(0))
function k<A, B>(x: A, f: (x: A) => B): B[] { [f(x)] }
function mapL<A, B>(xs: A[], f: (x: A) => B): B[] {
  const out: B[] = []
  for x in xs { out.push(f(x)) }
  out
}
function gid<A>(x: A): A { x }
function maybe(b: i32): { x: i32 } | null {
  if b > 0 { return { x: 7 } }
  return null
}
function isNull(p: { x: i32 } | null) { return p == null }
function readX(b: i32) {
  const p = maybe(b)
  if isNull(p) { return -1 }
  return p.x
}
