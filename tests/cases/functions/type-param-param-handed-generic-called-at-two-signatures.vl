// @run
// @log 4
// @log 4
// @log 8
// @log 4
// @log 4
// A parameter its own type parameter alone annotates, handed a generic that the instance calls at
// two signatures, takes it as a hole would: once per generic, beside a value argument, and through
// a second generic that forwards it (D15575).
function id<T>(x: T): T { x }
function dup<T>(x: T): T { x }
function run<U>(f: (x: U) => U, u: U): U { f(u) }
function take<A>(a: A) { print(run(a, 2) + run(a, "ab").length) }
function takeN<A>(a: A, n: i32) { print(run(a, n) + run(a, "abc").length) }
function mid<A>(a: A) { take(a) }
take(id)
take(dup)
takeN(id, 5)
mid(id)
mid(dup)
