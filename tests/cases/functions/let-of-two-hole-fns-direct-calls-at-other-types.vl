// @run
// @log 1.5
// @log 100
// @log 2.5
// @log s
// @log 3.5
// @log 8
// @log 0.5
// @log 9
// A top-level `let` that holds two un-annotated functions does not pin them: each direct call
// types its own body, and a call through the binding joins its members (D16813).
function hid(x) { return x }
function kid(x) { return x + 1 }
let g4 = hid
g4 = kid
print(hid(1.5))
print(hid(100))
print(kid(1.5))
print(hid("s"))
print(g4(2.5))
print(g4(7))
let g5 = kid
g5 = hid
print(hid(0.5))
print(g5(8) + 1)
