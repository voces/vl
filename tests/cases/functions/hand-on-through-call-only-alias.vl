// @run
// @log 3
// @log w
// A function handed through a hole function's result into another hole function, which calls
// it only through a `const` alias of its parameter, is that parameter's set: each call through
// the alias is a member's own instance, at two types here.
function fw(f) { return f }
const lam = (x) => x
function take(a) {
  const v = a
  print(v(3))
  print(v("w"))
}
take(fw(lam))
