// @run
// @log 1
// @log 10
// @log 11
// @log 12
// @log 13
// @log 20
// @log 21
// @log 30
// @log 41
// @log 42
// @log 5
// @hint redundant type annotation: `mks` is inferred as `string` — remove it to lean on inference
// DECISIONS (void-discard): a function LITERAL checked against an expected
// `(…) => void` whose body ends in a VALUE-bearing tail is accepted, and the value
// is DISCARDED — uniformly for every rep: i32, string, array, struct literal, a
// value-returning call, and a generic instance. The discard is keyed on the
// CONTEXT being void (the expected return type / the declared `: void`), never on
// the tail's shape. The explicit `return expr` spelling stays a type error
// (`void-callback-explicit-return-rejected.vl`).
function g(cb: () => void) {
  cb()
}
g(() => {
  print(1)
  7
})
function mks(): string { "made" }
g(() => {
  print(10)
  "a string tail"
})
g(() => {
  print(11)
  [1, 2]
})
g(() => {
  print(12)
  ({r: 7})
})
g(() => {
  print(13)
  mks()
})
// DECLARED-void named functions: same rule, both an effect-only body (which used
// to TRAP — the `: void` annotation never reached the emitter's classification)
// and value tails of every rep (a ref tail used to be check-clean INVALID wasm).
function dv(): void { print(20) }
dv()
function dvs(): void {
  print(21)
  "dropped"
}
dvs()
function dvi(): void { 7 }
dvi()
print(30)
// Generic instances with value tails in a void context.
function id<T>(x: T): T { x }
g(() => {
  print(41)
  id(7)
})
g(() => {
  print(42)
  id("s")
})
// An explicitly `: void`-annotated lambda literal discards its tail too.
g((): void => {
  print(5)
  99
})
