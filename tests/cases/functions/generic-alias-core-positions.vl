// @run
// @log 11
// @log 14
// @log 7
// @log 5
// @log 100
// @log 101
// @log 102
// @log 6
// A `const x = inner` of a generic nested function called only through `x` stores its core closure:
// called once, twice, over a capture, with two defaulted parameters, in a loop, inside a lambda.
// the i32 default, called once
function a1() {
  function inner(s) { return s + 1 }
  const x = inner
  print(x(10))
}
// the i32 default, called twice
function a2() {
  function inner(s) { return s * 2 }
  const x = inner
  print(x(3) + x(4))
}
// a capture of the enclosing frame
function a3(k: i32) {
  function inner(s) { return s + k }
  const x = inner
  print(x(5))
}
// two parameters, both defaulted
function a4() {
  function inner(p, q) { return p - q }
  const x = inner
  print(x(9, 4))
}
// the alias called inside a loop
function a5() {
  function inner(s) { return s + 100 }
  const x = inner
  for i in 0 to 2 { print(x(i)) }
}
// the alias called inside a nested lambda
function a6() {
  function inner(s) { return s - 1 }
  const x = inner
  const go = () => print(x(7))
  go()
}
a1()
a2()
a3(2)
a4()
a5()
a6()
