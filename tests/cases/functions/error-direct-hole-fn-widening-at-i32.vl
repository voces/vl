// @error f64 doesn't fit in i32 — the conversion is lossy and must be made explicit with `as` (write `x as i32`)
// A direct call of an un-annotated function whose body widens `i32` to `f64` is typed `f64`,
// so an `i32` binding refuses it, as a hole call of it does (D8161).
function half(a) { return a / 2.0 }
const r: i32 = half(3)
print(r)
