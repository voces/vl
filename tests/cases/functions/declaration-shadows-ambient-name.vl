// @run
// @log 103
// @log 105
// @log 7
// @log 108
// @log A
// @log 110
// @log 4
// @log true
// @log 111
// D4066 — a declaration named like an ambient function shadows it in its scope, for the call
// and its type. Each value below proves the user's binding ran; the lines after each scope
// prove the ambient name is back.
type Foo = { v: i32 }

function local() {
  function print(x: i32) { x + 100 }
  print(3)
}

function viaLambda() {
  const print = (x: i32): i32 => x + 100
  print(5)
}

function viaParam(print: (x: i32) => i32) { print(6) }

function viaCodePoint() {
  const fromCodePoint = (x: i32): i32 => x + 100
  fromCodePoint(8)
}

function fromCodePoints(self: Foo) { self.v + 100 }

function viaSelf() {
  const f: Foo = { v: 10 }
  f.fromCodePoints()
}

function viaMap() {
  const Map = (n: i32): i32 => n + 100
  const Set = (n: i32): i32 => n + 100
  Map(11) - Set(0) + 100
}

print(local())
print(viaLambda())
print(viaParam((x: i32): i32 => x + 1))
print(viaCodePoint())
print(fromCodePoint(65))
print(viaSelf())
const m = Map<string, i32>()
m["k"] = 4
print(m["k"] ?? 0)
const s = Set<string>()
s.add("k")
print(s.has("k"))
print(viaMap())
