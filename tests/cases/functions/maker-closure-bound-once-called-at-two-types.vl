// @run
// @log 5.5
// @log 3
// @log 5
// @log 2.75
// @log 4
// @log 2.5
// One call of a maker returning a hole lambda, bound once and called at two parameter types, holds
// a closure per signature over one run of the maker: its captures, a counter included, are shared
// (D16845).
function mk() { return (a) => a + 2.5 }
const x = mk()
print(x(3))
print(x(0.5))
function adder(n: f64) { return (a) => a + n }
function go() {
  const y = adder(2.25)
  print(y(3) - 0.25)
  print(y(0.5))
}
go()
function counter() {
  let c = 0
  return (a) => {
    c = c + 1
    return a + c
  }
}
const z = counter()
print(z(3))
print(z(0.5))
