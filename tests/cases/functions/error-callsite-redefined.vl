// @check
// @error '__callsite__' is a compiler intrinsic and cannot be redefined
// @error parameter `b` is `__callsite__`, so its type must be `{ file: string, line: i32, col: i32 }`
// @error argument 2: expected i32, got {file: string, line: i32, col: i32}
// The name is matched by SPELLING in parameter-default position, before anything
// looks up a declaration — so a user binding of it would be shadowed by the
// intrinsic at exactly the place the name matters, and a module
// `const __callsite__` would read as a legal const default while meaning the
// intrinsic. Refused at the DEFINITION, where the author can see it, which is
// the same rule (and the same message shape) the emitter intrinsics get.
const __callsite__ = 5
function f(a: i32, b: i32 = __callsite__): i32 { a + b }
print(f(1))
