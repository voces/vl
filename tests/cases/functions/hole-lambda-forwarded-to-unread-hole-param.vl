// @run
// @log 4
// @log 4
// @log 4
// @log 3
// @warning Unused parameter `g`
// @hint redundant type annotation
// A hole lambda handed on through a hole parameter to one nothing reads is never called, so it
// takes the unread parameter's default, however many functions it passes through (D6191).
function apply(h, x: i32, g) { return h(x) }
function inc(n: i32): i32 { return n + 1 }
function outer(g) { return apply(inc, 3, g) }
function mid(g) { return outer(g) }
const f = (n) => 0 - n
print(outer(f))

// Two hops.
print(mid(f))

// A written `let` lambda.
let k = (n) => n
k = (n) => 0 - n
print(outer(k))

// Control: a callee that calls the parameter it is handed pins it there.
function both(h, x: i32, g) { return h(x) + g(1) }
function outer2(g) { return both(inc, 3, g) }
print(outer2(f))
