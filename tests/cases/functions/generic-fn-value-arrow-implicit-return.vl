// @run
// @log 7
// @log 3.5
// @log 7
// @log 9
// @log 4
// @hint redundant type annotation: `gi` is inferred as `(i32, i32) -> i32`
// @hint redundant type annotation: `gf` is inferred as `(i32, f64) -> f64`
// @hint redundant type annotation: `gt` is inferred as `(i32, i32) -> i32`
// A BARE-EXPRESSION function body is an IMPLICIT return, and the declared return type has to reach
// its value there. `const mk = (): (i32,i32) => i32 => padd` parses to a synthetic one-statement
// block with no `RetStmt` at all, so the coercion keyed on `return` saw nothing — while the same
// declaration written `=> { return padd }` was coerced and accepted. The `<T>` cell below was the
// worst of them: `vl check`, `vl build` and `wasm-tools validate` were all clean and the module
// TRAPPED at run, an accepted program that fails at run time. `monoWalkFnBody` coerces the body
// block against the declared return type before walking it, and a block's value is its LAST
// statement — the same rule an if-expression arm already used.
function padd(a, b) { return a + b }
function pmix(n: i32, x) { return x + n }
function pidT<T>(a: T, b: T): T { return a + b }

const mkI = (): (i32, i32) => i32 => padd
const mkF = (): (i32, f64) => f64 => pmix
const mkT = (): (i32, i32) => i32 => pidT

const gi: (i32, i32) => i32 = mkI()
print(gi(3, 4)) // 7
const gf: (i32, f64) => f64 = mkF()
print(gf(1, 2.5)) // 3.5
const gt: (i32, i32) => i32 = mkT()
print(gt(3, 4)) // 7

// The braced trailing-expression body is the same implicit return by the same rule.
const mkB = (): (i32, i32) => i32 => {
  padd
}
print(mkB()(4, 5)) // 9

// A `function`-form bare-expression body reaches the boundary through the same helper.
function mkFn(): (i32, i32) => i32 { padd }
print(mkFn()(1, 3)) // 4
