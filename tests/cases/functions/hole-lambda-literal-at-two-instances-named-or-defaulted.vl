// @run
// @log 1
// @log s
// @log 4
// @log s
// @log 2
// @log s
// A lambda literal handed to a hole the callee calls at two types takes one copy per type when the
// call leaves a defaulted parameter out or names its arguments, as a positional call does (D6331).
function lapD(g, x: i32 = 0) {
  print(g(1) + x)
  return g("s")
}
function lapN(g, x: i32) {
  print(g(1) + x)
  return g("s")
}
print(lapD((v) => v))
print(lapD((v) => v, 3))
print(lapN(x: 1, g: (v) => v))
