// @run
// @log 1
// @log 2
// @log 1
// @log 5
// @log end
// @hint Intentionally-unused parameter `_n`
// @hint Intentionally-unused parameter `_n`
// A `never` function used as a VALUE lowers with a `void` result: in a list, through an
// alias, as a never lambda, and as the argument that pins a generic's `T` (D1972).
function fail(): never { __trap__("f") }
function die(_n: i32): never { __trap__("d") }
function call<T>(f: () => T): T { return f() }
function main(c: boolean) {
  const fs = [fail]
  print(fs.length)
  const g = fail
  const gs = [g, g]
  print(gs.length)
  const hs = [
    die,
    (_n: i32): never => {
      __trap__()
    },
  ]
  print(hs.length - 1)
  print(call(() => 5))
  if c { call(fail) }
  print("end")
}
main(false)
