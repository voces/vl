// @run
// @log 3
// @log 7
// @log 4
// @log ok
// A call to a user `never` function returned from a valued function, and as a `??` default:
// each is the call and its `unreachable`, and the value path prints its result.
function fail(m: string): never { __trap__(m) }
function half(n: i32) {
  if n % 2 == 0 { return n / 2 }
  return fail("odd")
}
function orFail(x: i32 | null) {
  return x ?? fail("null")
}
function nameOr(s: string | null) {
  const t = s ?? fail("no name")
  return t.length
}
function flag(b: boolean | null) {
  if b ?? fail("no flag") { return "ok" }
  return "no"
}
print(half(6))
print(orFail(7))
print(nameOr("abcd"))
print(flag(true))
