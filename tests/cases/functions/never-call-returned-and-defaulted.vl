// @run
// @log 3
// @log 7
// @log 4
// @log ok
// @log 2.5
// @log 9
// A call to a user `never` function returned from a valued function, and as a `??` default at an
// i32, string, boolean and f64, plus a closure's read of a shared `let` with no initializer, whose
// cell read defaults to a trap: each is the call and its `unreachable`, and the value path prints.
function fail(m: string): never { __trap__(m) }
function half(n: i32) {
  if n % 2 == 0 { return n / 2 }
  return fail("odd")
}
function orFail(x: i32 | null) {
  return x ?? fail("null")
}
function nameOr(s: string | null) {
  const t = s ?? fail("no name")
  return t.length
}
function flag(b: boolean | null) {
  if b ?? fail("no flag") { return "ok" }
  return "no"
}
function wide(x: f64 | null) {
  return x ?? fail("no f64")
}
function shared() {
  let u: i32
  const g = () => u
  u = 9
  return g()
}
print(half(6))
print(orFail(7))
print(nameOr("abcd"))
print(flag(true))
print(wide(2.5))
print(shared())
