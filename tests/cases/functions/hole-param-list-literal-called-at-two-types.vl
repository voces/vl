// @run
// @log 5
// @log s
// @log true
// @log 6
// @log t
// @log 7
// @log u
// @log 8
// @log vv
// A hole parameter handed on inside a list literal, or a `const` of one, to a callee that calls the
// element at several types takes each type's instance of the function it is given (D15566).
function id(v) { return v }
function dbl(v) { return v + v }
function call0(fs, x) { print(fs[0](x)) }
function call1(fs, x) { print(fs[1](x)) }
function run(g) {
  call0([g], 5)
  call0([g], "s")
  call0([g], true)
}
run(id)
function runLet(g) {
  const fs = [g]
  call0(fs, 6)
  call0(fs, "t")
}
runLet(id)
function runTwo(g, h) {
  call1([g, h], 7)
  call1([g, h], "u")
}
runTwo(id, id)
function runDbl(g) {
  call0([g], 4)
  call0([g], "v")
}
runDbl(dbl)
