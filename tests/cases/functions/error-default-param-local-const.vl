// @check
// @error a default value must be a literal, a module-level `const`, or `__callsite__`
// A FUNCTION-LOCAL `const` is not a legal default even though it is a `const`:
// the default is substituted into the CALLER's frame, where that binding does
// not exist. The rule is resolved against the MODULE frame specifically
// (`isModuleScopeConst`), not by walking the scope chain — walking it would
// admit exactly the bindings that cannot survive the substitution.
function outer(): i32 {
  const L: i32 = 5
  function f(a: i32, b: i32 = L): i32 { a + b }
  return f(1)
}
print(outer())
