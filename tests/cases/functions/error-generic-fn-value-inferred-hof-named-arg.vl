// @emit-error Call sites pin `add` at (i32, i32), (f64, f64)
// A hole parameter reached by named arguments out of parameter order is not split, so a
// generic called through it at two signatures reaches the emitter's floor (D6281). This pins
// the diagnostic's informative branch, which names the signatures the program's own calls pin
// `add` at. The in-order spelling that runs is `generic-fn-value-hole-named-arg.vl`.
function add(a, b) { return a + b }
function apply2(x: i32, g) {
  print(g(x, 2))
  print(g(1.5, 2.5))
}

print(add(1, 2))
print(add(1.5, 2.5))
apply2(g: add, x: 1)
