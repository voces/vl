// @emit-error Call sites pin `add` at (i32, i32), (f64, f64)
// A hole parameter reached by a named argument is not split, so a generic called through it
// at two signatures reaches the emitter's floor (D6260). This pins the diagnostic's
// informative branch, which names the signatures the program's own calls pin `add` at. The
// positional spelling that runs is `generic-fn-value-inferred-hof-exported.vl`.
function add(a, b) { return a + b }
function apply2(g) {
  print(g(1, 2))
  print(g(1.5, 2.5))
}

print(add(1, 2))
print(add(1.5, 2.5))
apply2(g: add)
