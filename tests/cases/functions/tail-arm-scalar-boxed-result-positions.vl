// @run
// @log 1.5
// @log 102
// @log 7
// @log ss
// @log i=5.5
// @log 4.5
// @log 6
// @log 7.5
// @log 8.5
// @log 9
// Q58 position sweep: a function whose tail `??` arm yields a bare scalar at a `T | null` or
// `T | string` result, boxed at the result's union by the shared box plan, its result read as a
// scalar and a union call argument, a nested call argument, a concat operand, an interpolation
// hole, a return, a let initializer, an if arm, a `??` operand and a record field.
function pickN(xs: f64[], d: f64 | null) {
  const t = xs.pop()
  return t ?? d
}
function pickS(xs: i32[]) {
  const t = xs.pop()
  return t ?? "s"
}
function takeF(x: f64) { print(x) }
function takeU(x: i32 | string) {
  if x is string { print(x) } else { print(x + 100) }
}
function dbl(x: f64) { return x * 2.0 }
function show(x: i32 | string) { return if x is string { x } else { "\{x}" } }
function ret(): f64 | null { return pickN([4.5], null) }
function go(c: boolean) {
  takeF(pickN([1.5], null) ?? 0.0)
  takeU(pickS([2]))
  takeF(dbl(pickN([3.5], null) ?? 0.0))
  print("s" + show(pickS([])))
  print("i=\{pickN([], 5.5) ?? 0.0}")
  print(ret() ?? 0.0)
  const l = pickS([6])
  print(show(l))
  print(if c { pickN([7.5], null) ?? 0.0 } else { 0.0 })
  print(pickN([], null) ?? 8.5)
  const r = { v: pickS([9]) }
  print(show(r.v))
}
go(true)
