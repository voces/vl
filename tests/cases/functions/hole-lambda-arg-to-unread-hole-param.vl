// @run
// @log 4
// @log 4
// @log 5
// @log 4
// @warning Unused parameter `y`
// @hint redundant type annotation
// A lambda argument to a hole parameter the callee's body never reads needs no type for its
// parameter: nothing calls it, so it is accepted like an uncalled `const` lambda.
function inc(a: i32): i32 { a + 1 }
function apply(g, x, y) { return g(x) }
print(apply(inc, 3, (n) => n * 2))

// Handed on through an un-annotated forwarder.
function h(a) { return inc(a) }
print(apply(h, 3, (n) => n * 2))

// The result delivered to a binding.
const r = apply(inc, 3, (n) => n * 2)
print(r + 1)

// The un-annotated callee spelling.
function inc2(a) { return a + 1 }
print(apply(inc2, 3, (n) => n * 2))
