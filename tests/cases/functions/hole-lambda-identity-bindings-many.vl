// Seven bindings of seven hole lambdas handed through one identity, and one through another,
// each called at two types, take a slot per binding type however many there are (D6262).
function fw(f) { return f }
function fv(f) { return f }
const l1 = (x) => x
const l2 = (x) => x
const l3 = (x) => x
const l4 = (x) => x
const l5 = (x) => x
const l6 = (x) => x
const l7 = (x) => x
const l8 = (x) => x
const q1 = fw(l1)
const q2 = fw(l2)
const q3 = fw(l3)
const q4 = fw(l4)
const q5 = fw(l5)
const q6 = fw(l6)
const q7 = fw(l7)
const q8 = fv(l8)
print(q1(1))
print(q1("a"))
print(q2(2))
print(q2("b"))
print(q3(3))
print(q3("c"))
print(q4(4))
print(q4("d"))
print(q5(5))
print(q5("e"))
print(q6(6))
print(q6("f"))
print(q7(7))
print(q7("g"))
print(q8(8))
print(q8("h"))
