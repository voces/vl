// @run
// @log 5
// @log s
// @log 5
// @log 4
// @log 10
// @log 8
// A hole function called directly at one type and handed on in a `const` record to a callee that
// calls the field at another runs (D15639), and at two instances keeps each one's set.
function id(v) { return v }
function twice(v) { return v + v }
function call0(r, x) { print(r.f(x)) }
function run(g) {
  print(g(5))
  const r = { f: g }
  call0(r, "s")
}
run(id)
function call1(r, x) { print(r.f(x)) }
function run2(g) {
  print(g(5))
  const r = { f: g }
  call1(r, 4)
}
run2(id)
run2(twice)
