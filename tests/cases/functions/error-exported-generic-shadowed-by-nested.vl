// @error exported function `id` is generic over `T` and nothing in the program calls it
// The only `id(...)` in the file sits inside `host`, where a nested concrete `id` shadows the
// exported generic, so nothing calls the generic: the checker refuses it, as it does an export
// with no call site at all (D3817).
export function id<T>(x: T): T { return x }

function host(): i32 {
  function id(n: i32): i32 { return n + 100 }
  return id(1)
}

print(host())
