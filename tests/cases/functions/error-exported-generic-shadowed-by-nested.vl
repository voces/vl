// @emit-error the exported generic function `id` is never instantiated
// The cell where #1265's scope fix TURNS ON #1260's reject, and the two are the same
// judgement seen twice.
//
// The exported `id<T>` has no call site: the only `id(...)` in the file sits inside `host`,
// where a nested CONCRETE `id` shadows it. The pre-fix monomorphizer resolved that call with
// the flat `fnIndexOf`, credited it to the top-level generic, and instantiated `id<T>` at
// i32 — so the module built rc 0 and published `id` at `(structref, i32) -> i32` (measured),
// an instantiation NO source call site ever asked for. Silently wrong ABI.
//
// With the scope-aware resolver the call goes where the language says it goes, the exported
// generic is left genuinely un-instantiated, and #1260's gate reports it. A cell moving from
// a silently-wrong export to a loud build-time reject, which is forward.
export function id<T>(x: T): T { return x }

function host(): i32 {
  function id(n: i32): i32 { return n + 100 }
  return id(1)
}

print(host())
