// @run
// @log 0
// @log s
// @log z
// @log 41
// A lambda whose `Map()` result is left open, handed on before the function type it is used at
// is known: the map is built at that type's result, through an inferred return, a binding and
// an argument, including a result that unions the map with a record.
type Circle = { r: i32 }
function deliver() { return () => Map() }
const v: () => {[string]: string} = deliver()
print(v().length)
const f = () => Map()
const a: () => {[string]: string} = f
const am = a()
am["k"] = "s"
print(am["k"] ?? "-")
function use(h: () => {[string]: string}) {
  const m = h()
  m["k"] = "z"
  m["k"] ?? "-"
}
print(use(deliver()))
function mk() { return () => Map() }
function mu(u: {[string]: i32} | Circle) {
  if u is Circle { return u.r }
  u["a"] = 41
  u["a"] ?? -1
}
const g: () => ({[string]: i32} | Circle) = mk()
print(mu(g()))
