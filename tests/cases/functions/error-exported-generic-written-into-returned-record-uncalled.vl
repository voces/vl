// @error exported function `id` is generic over `T` and nothing in the program calls it
// A record a declared function returns is followed to the write into it, as a literal bound
// directly is; nothing calls `r.f`, and the export has no instance (D12370).
export function id<T>(x: T): T { x }
function mk() { { f: id } }
const r = mk()
r.f = id
print(1)
