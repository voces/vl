// @run
// @log 1.5
// @log 1.5
// @log 1.5
// @log 4
// @hint redundant type annotation: `k` is inferred as `i32`
// D8940: an un-annotated function whose returns join an `f64` with its `i32` argument returns
// `i32 | f64`. Un-annotated, at an `f64` binding and as an `f64` argument it runs and prints the
// `f64` arm; a join of two `i32` returns stays `i32`.
function halfOr(a) {
  if a > 1 { return a / 2.0 }
  return a
}
function halfIf(a) { return if a > 1 { a / 2.0 } else { a } }
function incOr(a) {
  if a > 1 { return a + 1 }
  return a
}
function takeF(v: f64) { print(v) }
const u = halfOr(3)
print(u)
const s: f64 = halfOr(3)
print(s)
takeF(halfIf(3))
const k: i32 = incOr(3)
print(k)
