// @run
// @log true
// @log false
// @log 3
// A re-pointed generic `let` delivered at a closed function type is typed at the function its
// most recent write stored: as a list element, at an annotated binding and through a copy (D15957).
function inner<U>(u: U) { print(u) }
function plus<V>(v: V) { print(v + 1) }
function main() {
  let k = plus
  k = inner
  const fs: ((b: boolean) => void)[] = [k]
  fs[0](true)
  const f: (b: boolean) => void = k
  f(false)
  const g = k
  g(3)
}
main()
