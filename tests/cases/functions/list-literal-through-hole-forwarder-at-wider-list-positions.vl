// @run
// @log 4
// @log 9
// @log 5
// @log 10
// A list literal a hole forwarder hands on is, in each instance, built at the list of the
// parameter it reaches, each element widened: f64[], i64[], f64[] | null, one or two elements.
function wantF64(a: i32, b: f64[]) { return b[0] + a }
function wantI64(a: i32, b: i64[]) { return b[1] + a }
function maybe(a: i32, b: f64[] | null) {
  return if b == null { -1.0 } else { b[0] + a }
}
function fwd(g, x, y) { return g(x, y) }
function one(h, v) { return fwd(h, 3, [v]) }
function two(h, v) { return fwd(h, 3, [v, v + 1]) }
print(one(wantF64, 1))
print(two(wantI64, 5))
print(one(maybe, 2))
print(two(wantF64, 7))
