// @run
// @log 8
// @log 8
// @log 0.5
// @log 1
// @log 3
// @log 9
// @log 2
// @log 5
// D5880: a literal a forwarder hands through another function's un-annotated parameter takes, in
// each of the forwarder's instances, the parameter type of the function that instance is called
// with: nested and flat lists, an empty list, three types, and a record literal.
type P = { x: f64 }
type Q = { x: i32 }
function nf(a: i32, b: f64[][]) { a + b.length }
function ni(a: i32, b: i32[][]) { a + b[0][0] }
function ff(a: i32, b: f64[]) { a + b.length }
function fi(a: i32, b: i32[]) { a + b[0] }
function a1(a: i32, b: f64[][]) {
  if a == 3 { b[0][0] / 2.0 } else { 0.0 }
}
function a2(a: i32, b: i32[][]) {
  if a + b[0][0] == 4 { 1.0 } else { 0.0 }
}
function a3(a: i32, b: i64[][]) {
  if a == 3 && b.length == 1 { 3.0 } else { 0.0 }
}
function ef(a: i32, b: f64[]) { a + b.length }
function es(a: i32, b: string[]) { a * 2 + b.length }
function fp(a: i32, b: P) {
  if a == 3 { b.x } else { 0.0 }
}
function fq(a: i32, b: Q) { b.x + a }
function apply(g, x, y) { return g(x, y) }
function nested(h) { return apply(h, 3, [[1]]) }
function flat(h) { return apply(h, 3, [1]) }
function empty(h) { return apply(h, 3, []) }
function rec(h) { return apply(h, 3, { x: 2 }) }
print(nested(nf) + nested(ni))
print(flat(ff) + flat(fi))
print(nested(a1))
print(nested(a2))
print(nested(a3))
print(empty(ef) + empty(es))
print(rec(fp))
print(rec(fq))
