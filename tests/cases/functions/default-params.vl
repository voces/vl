// @run
// @log hi!
// @log hi?
// @log 111
// @log 103
// @log 6
// @log 16
// @log 5
// @log 1.5
// @log 8
// @log 3
// @log 105
// @log 11
// @log 3
// @log 10
// @log -!
// @log empty
// @log a, b
// @log a-b
// @log 5
// A parameter may carry a DEFAULT VALUE (`p: T = <literal>`). Defaults are
// direct-call-site sugar: a call that omits trailing arguments is normalized to
// the callee's full arity before emit, so the callee's own signature — and the
// closure `$fnsig` value-call ABI — are untouched.
function greet(name: string, punct: string = "!") { print(name + punct) }
greet("hi")
greet("hi", "?")

// Several defaults, omitted from the right.
function add(a: i32, b: i32 = 10, c: i32 = 100): i32 { a + b + c }
print(add(1))
print(add(1, 2))
print(add(1, 2, 3))
// A NAMED argument may skip a MIDDLE defaulted parameter: `b` takes its default
// while `c` is bound by name.
print(add(1, c: 5))

// The default is a LITERAL — including a signed one — in every scalar rep.
function off(a: i32, d: i32 = -5): i32 { a + d }
print(off(10))
function fl(a: f64, b: f64 = 0.5): f64 { a + b }
print(fl(1.0))
function big(a: i64, b: i64 = 7): i64 { a + b }
print(big(1))
function flag(a: i32, on: boolean = true): i32 {
  if on { return a }
  return 0
}
print(flag(3))

// A NESTED function's default resolves through the scope chain, and its call
// still goes through the capturing-call lowering.
function outer(n: i32): i32 {
  function innerAdd(x: i32, y: i32 = 4): i32 { x + y + n }
  return innerAdd(1)
}
print(outer(100))

// A `self`-function called PLAIN takes its default like any other.
function scale(self: i32, by: i32, plus: i32 = 1): i32 { self * by + plus }
print(scale(5, 2))

// The same function used as a VALUE keeps its FULL arity — the value call has no
// declaration to read a default from, so it supplies every argument.
function mixed(a: i32, b: i32 = 9): i32 { a + b }
const mv = mixed
print(mv(1, 2))
print(mixed(1))

// A GENERIC function may default a parameter whose type names no type parameter:
// omitting it drops no binding site, so the monomorphizer's instance keying sees
// exactly the argument types it always did — here, one instance per element type.
function firstOr<T>(xs: T[], tag: string = "-"): string {
  if xs.length == 0 { return tag }
  return tag + "!"
}
const ns: i32[] = [1, 2]
const ss: string[] = []
print(firstOr(ns))
print(firstOr(ss, "empty"))

// A `string[]` parameter beside a defaulted `string`.
function join(parts: string[], sep: string = ", "): string {
  let out = ""
  let i = 0
  while i < parts.length {
    if i > 0 { out = out + sep }
    out = out + parts[i]
    i = i + 1
  }
  return out
}
const ps: string[] = ["a", "b"]
print(join(ps))
print(join(ps, "-"))

// A CLOSURE-typed parameter beside a defaulted scalar: the closure argument
// still travels the value ABI, and only the omitted scalar is filled.
function twice(f: (i32) => i32, n: i32 = 3): i32 { f(f(n)) }
print(twice((x: i32) => x + 1))
