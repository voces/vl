// An un-annotated generic identity handed a function value, its result called in place: the
// instance's return is the bound function type, not a signature-less placeholder (D7763).
function id<T>(x: T) { return x }
function idA<T>(x: T): T { return x }
function ap<T, R>(h: (x: T) => R) { return h }
function h(n: i32) { return n + 1 }
type P = { x: i32, y: i32 }
function mk(n: i32): P { return { x: n, y: n * 2 } }

print(id(h)(2))
print(id((n: i32) => n * 10)(2))
print(ap(h)(2))
print(id((s: string) => s + "!")("a"))

// A capturing lambda, a record result, and the result delivered to a list and a record field.
function main(k: i32) {
  const add = (a: i32) => a + k
  print(id(add)(1))
  print(id(mk)(3).y)
  const fs = [id(add), id(add)]
  print(fs[1](10))
  const r = { f: id(add) }
  print(r.f(20))
}
main(100)

// Through a second generic, a hole parameter, and nested identities.
function id2<T>(x: T) { return id(x) }
function d(n: f64) { return n * 2.0 }
function app(g) { return id(g)(3) }
print(id2(h)(2))
print(id2(d)(2.5))
print(app(h))
print(wrapper(h)(7))
print(id(id(h))(9))
function wrapper<T>(f: T) { return id(f) }

// The annotated and the bound spellings, which already ran.
print(idA(h)(2))
const k = id(h)
print(k(2))
