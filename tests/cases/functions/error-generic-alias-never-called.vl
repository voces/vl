// @emit-error cannot take the generic function `exclaim` as a value
// A generic (un-annotated-param) NAMED function aliased in a body and RETURNED, with no call site,
// to a caller that COMPARES the result is a clean emit reject: the comparison reads the value, so
// the stub an unread return gets would be observed, and with nothing pinned only the i32 default
// could serve it, where `s + "!"` does not build.
//
// The message takes its NO-call-site branch here — with nothing pinned there is no inferred
// signature to offer, and it says so rather than implying one. The other branch, which names the
// signatures the program itself already pins, is
// `error-generic-fn-value-inferred-hof-default-param.vl`. The same return bound unread runs:
// `closures/uncalled-hole-fn-returned-unread.vl` (D6882).
function exclaim(s) { return s + "!" }

function go() {
  const f = exclaim
  return f
}

const g = go()
print(g == g)
