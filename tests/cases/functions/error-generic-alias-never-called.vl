// @emit-error cannot take a generic function (un-annotated parameters) as a value
// A generic (un-annotated-param) NAMED function aliased to a binding that is NEVER CALLED is a
// clean emit REJECT, at module scope and inside a function body alike.
//
// The value-floor exemption (`value-flow-mono.vl`) rests on "the closure is `call_ref`'d only at
// the shape its slot was pinned to" — which presupposes that a call site pinned it. With no call
// site the template stays un-pinned and its body emits at the i32 DEFAULT, and that body is only
// accidentally valid: `a + b` lowers, while the `s + "!"` below emits a string-concat helper call
// over an i32 parameter. That was `vl check` rc 0 with INVALID WASM (`type mismatch: expected
// (ref $type), found i32` at the engine) — #1254 mechanism B, whose prune declines exactly when
// the name is taken as a VALUE and so relied on this floor to cover the case.
//
// The twin that must NOT move is `value-flow-mono.vl` / `value-flow-mono-module-scope.vl`: the
// same alias WITH call sites, which monomorphize and run.
function exclaim(s) { return s + "!" }

function go() {
  const f = exclaim
  return 1
}

print(go())
