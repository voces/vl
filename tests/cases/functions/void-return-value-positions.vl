// @run
// @log A
// @log B
// @log C
// @log D
// @log E
// @log F
// @log 7
// @log end
// A `return <expr>` in a function with no result evaluates the expression for its effect and
// returns nothing: a field's void call, a parameter's call, an early return inside an `if`, a
// generic at a `never` argument, and a nested function.
function say(s: string) { print(s) }
function onField(b) { return b.go() }
function onParam(f) { return f("B") }
function early(c: boolean) {
  if c { return say("C") }
  say("x")
}
function id<T>(x: T): T { return x }
function fail(): never { __trap__("f") }
function viaId(c: boolean) {
  if c { id(fail()) }
  say("D")
}
function outer() {
  function inner(k) { return k("E") }
  inner(say)
}
function loop() {
  for i in 0 to 3 {
    if i == 1 { return say("F") }
  }
}
onField({ go: () => say("A") })
onParam(say)
early(true)
viaId(false)
outer()
loop()
print(onField({ go: () => 7 }))
print("end")
