// @error operator '+' is not defined for boolean and i32
// A write after a call in source order (a loop's back edge) inside a generic body is re-asked at
// each instance of that body (D3968).
function inner<U>(u: U) { print(u) }
function plus<V>(v: V) { print(v + 1) }
function other<V>(v: V) { print(v) }
function g<T>(t: T) {
  let k = inner
  let i = 0
  while i < 2 { k(t); k = plus; i = i + 1 }
}
g(true)
