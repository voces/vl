// @run
// @log ok
// @log ok
// @log ok
// @log ok
// @log 5
// D975 — A USER FUNCTION NAMED LIKE A BUILTIN OWNS ITS OWN NAME.
//
// The emitter's builtin arms are matched BEFORE the `fnIndexOf` lookup, because for a real
// builtin that lookup fails ("unknown function"). But the test was the raw SPELLING, so a
// program declaring `function toString(self: {foo: string})` had its own call routed into the
// builtin: `vl check` rc 0 and INVALID WASM, while the identical program with the function
// renamed ran.
//
// MEASURED ACROSS THE WHOLE SET, not one name: `print`, `toString`, `fromCodePoint`,
// `fromCodePoints`, `Map` and `Set` all collided. Asking whether the callee RESOLVES is what
// the arms' own comment already assumed — a builtin resolves to nothing.
//
// `toString` HAS SINCE LEFT THE BUILTIN SET (2026-09-01, owner ruling — it is `std:fmt`'s
// export now), so its arm below no longer has a collision to survive. It STAYS, as D975's
// refutation pin: the name that named the defect must keep running as a plain user function,
// and the day someone re-introduces a by-raw-name special case for it this file is what says
// so. The file deliberately does NOT import `std:fmt` — a module that both imports and
// declares `toString` is a hard parse error ("Duplicate binding"), which is the language's
// own answer to the shadowing question and is pinned separately.
const b = { foo: "ok" }

function toString(self: { foo: string }) {
  self.foo
}
print(b.toString())

function print2(self: { foo: string }) {
  self.foo
}
print(b.print2())

function fromCodePoint(self: { foo: string }) {
  self.foo
}
print(b.fromCodePoint())

function fromCodePoints(self: { foo: string }) {
  self.foo
}
print(b.fromCodePoints())

// THE BUILTINS THEMSELVES MUST STILL WORK — the whole point of the arms.
const m: {[string]: i32} = Map()
m["k"] = 5
print(m["k"])
