// @error return needs a value of type i32 — return a value, or annotate this function `: void`
// @error return needs a value of type string — return a value, or annotate this function `: void`
// @error return needs a value of type T — return a value, or annotate this function `: void`
// A bare `return` under a declared non-void return type is the one shape the rule still
// refuses, and it is the checker that refuses it, at the `return` rather than at the function
// name (D1600). The sentence names both route-arounds because either can be the intended one.
function f(n: i32): i32 {
  if n < 0 { return }
  n + 1
}
function g(n: i32): string {
  for i in 0 to 2 {
    if i == n { return }
  }
  "s"
}
// A declared type PARAMETER is the same refusal: `assignable` waves a `TyVar` past any
// destination, so this one reached the emitter as a floor rather than the checker.
function pick<T>(v: T): T {
  if false { return }
  v
}
print(f(1))
print(g(9))
print(pick(5))
