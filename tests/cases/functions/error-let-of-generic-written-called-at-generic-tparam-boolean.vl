// @error operator '+' is not defined for boolean and i32
// The boolean instance of a call through the binding at the enclosing generic's type parameter (D3968).
function inner<U>(u: U) { print(u) }
function other<V>(v: V) { print(v) }
function plus<V>(v: V) { print(v + 1) }
function g<T>(t: T) {
  let k = inner
  k = plus
  k(t)
}
g(true)
