// @error operator '+' is not defined for boolean and i32
// A call through the binding binds a written generic's type parameter through `Box<A>` (D3968).
type Box<A> = { v: A }
function s<A>(b: Box<A>) { print("S") }
function w<A>(b: Box<A>) { print(b.v + 1) }
function main() {
  let k = s
  k = w
  const bx: Box<boolean> = { v: true }
  k(bx)
}
main()
