// @run
// @log 4
// @log 0
// @log 8
// @log 1.5
// @log 3
// @log 9
// @log 0
// D5882: a nullable ref list (`f64[][] | null`, `P[] | null`) as the parameter or the result of a
// function handed through an un-annotated parameter or bound to a name, with a literal, a `null`
// and a caller's own list delivered there.
type P = { x: i32 }
function two(a: i32, b: f64[][] | null) {
  if b == null { return 0 } else { return a + b.length }
}
function recs(a: i32, b: P[] | null) {
  if b == null { return 0 } else { return a + b[0].x }
}
function mk(n: i32): f64[][] | null {
  if n > 0 { return [[1.5]] } else { return null }
}
function poke(a: i32, b: f64[][] | null) {
  if b == null {
    return 0
  } else {
    b[0][0] = 9.0
    return a
  }
}
function apply(g, x, y) { return g(x, y) }
function apply1(g, x) { return g(x) }
print(apply(two, 3, [[1]]))
print(apply(two, 3, null))
print(apply(recs, 3, [{ x: 5 }]))
const r = apply1(mk, 1)
if r != null { print(r[0][0]) } else { print(0) }
const v: f64[][] = [[1.0]]
print(apply(poke, 3, v))
print(v[0][0])
const g = mk
const r0 = g(0)
if r0 != null { print(r0[0][0]) } else { print(0) }
