// @error return expects a value of type i32, got void
// `return e` of a void `e` is a void return, so it is refused in a function that returns a
// value: here the inferred return is `i32`, decided by the other `return` (D2635).
function g(x: i32) { print(x) }
function f(op: i32) {
  if op == 0 { return g(1) }
  return 5
}
print(f(1))
