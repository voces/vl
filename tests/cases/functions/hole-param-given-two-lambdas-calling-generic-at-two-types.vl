// @run
// @log 2
// @log s
// @log 10
// @log o
// @log 7
// @log true
// A hole parameter handed a different lambda at each call takes a copy of its function per
// lambda, and each lambda's own hole hands the generic once per type it is called at (D6706).
function id(a) { return a }
const lap = (g) => {
  print(g(1) + 1); return g("s")
}
const lop = (g) => {
  print(g(5) * 2); return g("o")
}
const lup = (g) => {
  print(g(7)); return g(true)
}
function use(k) { return k(id) }
print(use(lap))
print(use(lop))
print(use(lup))
