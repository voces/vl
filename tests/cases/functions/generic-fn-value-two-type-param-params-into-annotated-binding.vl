// @run
// @log x
// @log 3
// @log x
// @log 3
// @log x
// @log 3
// @log 3
// @log x
// @log 3
// @log 2
// @log 3
// @info `b` is never reassigned; use `const` instead of `let`
// A generic handed to two parameters of one type parameter, called at two types, runs when a
// parameter is read into a binding annotated with that type parameter: the annotation takes the
// parameter's own type parameter with it (D6372). Also through a chain of two, with both
// parameters bound, the binding read twice, a `let`, and a `let` written at one type.
function same<T>(k: T): T { k }
function one(k: i32) { k }
function take(a) { print(a("x")) }
function take2(a) { print(a(3)) }
function take1(a) { print(a(2)) }
function mid<F>(a: F, a1: F) {
  const b: F = a1
  take(a)
  take2(b)
}
mid(same, same)
function mid2<F>(a: F, a1: F) {
  const b: F = a1
  const c: F = b
  take(a)
  take2(c)
}
mid2(same, same)
function mid3<F>(a: F, a1: F) {
  const b: F = a1
  const e: F = a
  take(e)
  take2(b)
  take2(b)
}
mid3(same, same)
function mid4<F>(a: F, a1: F) {
  let b: F = a1
  take(a)
  take2(b)
}
mid4(same, same)
function mid5<F>(a: F, a1: F) {
  let b: F = a1
  b = a
  take1(a)
  take2(b)
}
mid5(one, one)
