// @run
// @log 11
// @log 110
// @log 11
// @log 110
// @log 3
// @log 30
// @log 103
// @log 1010
// @log 11
// @log 1010
// @hint redundant type annotation: `inner` is inferred as `i32`
// @hint redundant type annotation: `mid` is inferred as `i32`
// @hint redundant type annotation: `vsA` is inferred as `i32`
// @hint redundant type annotation: `vsB` is inferred as `i32`
// @hint redundant type annotation: `apply` is inferred as `i32`
// @hint redundant type annotation: `vaA` is inferred as `i32`
// @hint redundant type annotation: `vaB` is inferred as `i32`
// @hint redundant type annotation: `vrA` is inferred as `i32`
// @hint redundant type annotation: `vrB` is inferred as `i32`
// @hint redundant type annotation: `viA` is inferred as `i32`
// @hint redundant type annotation: `vtop` is inferred as `i32`
// @hint redundant type annotation: `vcA` is inferred as `i32`
// @hint redundant type annotation: `vcB` is inferred as `i32`
// @hint redundant type annotation: `vg` is inferred as `(i32) -> i32`
// @hint redundant type annotation: `vframe` is inferred as `i32`
// A NESTED FUNCTION TAKEN AS A VALUE RESOLVES THROUGH THE WHOLE SCOPE CHAIN.
//
// #1204 gave the by-name CALL path the lexical rule (`fnIndexOfInScopeChain`) but left
// the function-VALUE resolver `fnIndexOfInScope` matching only a function whose PARENT is
// the calling frame. The same three rungs it fixed on the call path stayed SILENT WRONG
// ANSWERS on the value path:
//
//   - a SIBLING nested function taken as a value (`inner`'s parent is the enclosing
//     frame, not `mid`);
//   - a nested function referring to ITSELF as a value — its declaring frame is its
//     PARENT, one step out — which rewired the recursion to the other frame's twin and
//     printed 12 for 30;
//   - a nested function SHADOWING a top-level one, as seen from a sibling frame.
//
// Group (2) additionally covers the callback SPECIALIZATION: `apply(inner, v)` is baked
// into a top-level clone by NAME, so a same-named twin in another frame made the clone
// call the wrong one while the closure argument carried the right funcref. The bake is
// declined when the name is ambiguous and the general `call_ref` path takes over.
//
// The last two groups are the CONTROLS: innermost must beat outermost, and running off
// the chain must still reach a top-level function.

// (1) a SIBLING nested function taken as a VALUE.
function vsA(): i32 {
  function inner(x: i32): i32 { return x + 1 }
  function mid(x: i32): i32 {
    const f = inner
    return f(x)
  }
  return mid(10)
}
function vsB(): i32 {
  function inner(x: i32): i32 { return x + 100 }
  function mid(x: i32): i32 {
    const f = inner
    return f(x)
  }
  return mid(10)
}
print(vsA())
print(vsB())

// (2) a nested function PASSED AS AN ARGUMENT to a top-level HOF.
function apply(f: (i32) => i32, v: i32): i32 { return f(v) }
function vaA(): i32 {
  function inner(x: i32): i32 { return x + 1 }
  function mid(v: i32): i32 { return apply(inner, v) }
  return mid(10)
}
function vaB(): i32 {
  function inner(x: i32): i32 { return x + 100 }
  function mid(v: i32): i32 { return apply(inner, v) }
  return mid(10)
}
print(vaA())
print(vaB())

// (3) a nested function referring to ITSELF as a value — the RECURSIVE rung. On the
// unfixed compiler `vrB` printed 12 (= 10 + 1 + 1 + 0): the second frame's recursion
// dropped into the first frame's twin after one step.
function vrA(): i32 {
  function inner(x: i32): i32 {
    if x <= 0 { return 0 }
    return 1 + apply(inner, x - 1)
  }
  return inner(3)
}
function vrB(): i32 {
  function inner(x: i32): i32 {
    if x <= 0 { return 0 }
    return 10 + apply(inner, x - 1)
  }
  return inner(3)
}
print(vrA())
print(vrB())

// (4) CONTROL — INNERMOST WINS on the value path (1 + 102... i.e. 3 + 100).
function viA(): i32 {
  function inner(x: i32): i32 { return x + 1 }
  function mid(x: i32): i32 {
    function inner(y: i32): i32 { return y + 100 }
    const f = inner
    return f(x)
  }
  const g = inner
  return g(1) + mid(1)
}
print(viA())

// (5) CONTROL — the value path runs OFF the chain to a TOP-LEVEL function, and a frame
// that shadows it with its own nested twin sees the nested one from a sibling frame.
function vtop(x: i32): i32 { return x + 1000 }
function vcA(): i32 {
  function mid(x: i32): i32 {
    const f = vtop
    return f(x)
  }
  return mid(10)
}
function vcB(): i32 {
  function vtop(x: i32): i32 { return x + 1 }
  function mid(x: i32): i32 {
    const f = vtop
    return f(x)
  }
  return mid(10)
}
print(vcA())
print(vcB())

// (6) CONTROL — a module-GLOBAL closure binding keeps meaning the TOP-LEVEL function.
const vg: (i32) => i32 = vtop
function vframe(): i32 {
  function vtop(x: i32): i32 { return x + 1 }
  return vg(10)
}
print(vframe())
