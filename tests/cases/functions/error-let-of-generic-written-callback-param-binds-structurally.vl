// @error operator '+' is not defined for boolean and i32
// A call through the binding binds a written generic's type parameter through `() => A` (D3968).
function s<A>(f: () => A) { print("S") }
function w<A>(f: () => A) { print(f() + 1) }
function main() {
  let k = s
  k = w
  k(() => true)
}
main()
