// One hole parameter handed two generics by name beside a second handed one, at calls inside
// another function's body, takes a copy of the function per name (D6742).
function id(a) { return a }
function dbl(a) { return a + a }
function app(g, h) { print(g(1) + 1); return h(2) }
function use(n) { print(n); print(app(id, id)); return app(dbl, id) }
print(use(1))
function use2(n) { print(n); print(app(id, dbl)); return app(dbl, id) }
print(use2(1))
function apps(g, h) { print(g(1)); return h("x") }
function use3(n) { print(n); print(apps(id, id)); return 0 }
print(use3(1))
function app3(g) { return g(true) }
print(app3(id))
