// @log ab
// @log xy
// @log 8
// A named call that skips a parameter whose default is a literal reads as its positional
// spelling with that default, so a generic it hands is the set's id, called at two types (D14970).
function add(a, b) { return a + b }
function three(g, n: i32 = 1, m: i32 = 2) {
  print(g(n, m))
  print(g("a", "b"))
}
three(g: add, m: 5)
three(m: 5, g: add)
function strs(g, s: string = "x", m: i32 = 2) {
  print(g(s, "y"))
  print(g(m, 3))
}
strs(g: add, m: 5)
