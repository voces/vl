// @run
// @log 1
// @log s
// @log 1
// A `const` alias of a hole function, called through and stored in a list, while the function's
// own name is called at another type: the call through the alias instances the function at its
// own argument, and the list holds the alias as a value.
function id(x) { return x }
const k = id
print(k(1))
print(id("s"))
const ks = [k]
print(ks.length)
