// @trap :6:2
// A `never` call reached in a value position aborts there: the binding after it never runs.
// The sibling of never-call-ends-path.vl, which takes the other arm every time (D1972).
function fail(msg: string): never {
  print(msg)
  __trap__()
}
function g(c: boolean) {
  const n = if c { 1 } else { fail("before") }
  print("after")
  n
}
print(g(false))
