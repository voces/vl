// @emit-error parameter `a` of `mid` is called at two function types that no parameter per type separates
// A generic handed to a callee's bare-only parameter comes back to the caller in a record the callee returns, which calls
// it at another type: the per-parameter pin does not skip that hand-on, so the refusal stands
// rather than building one instance for both types.
function same<T>(k: T): T { k }
function mk<G>(g: G) { return { f: g } }
function mid<F>(a: F) {
  const o = mk(a)
  print(o.f(3))
  print(a("x"))
}
mid(same)
