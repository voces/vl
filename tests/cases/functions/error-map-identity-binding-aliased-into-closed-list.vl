// @error a {f: (_) => _} cannot be delivered as {f: (f64) => f64} here
// A binding of an identity `.map`, aliased into a list that closes a field, is that list's storage:
// its callback is typed at the closed element and refused as record sharing (D17826).
function id(a) { return a }
function deliver() { return [{ f: id }] }
const m = deliver().map((r) => r)
const v: { f: (a: f64) => f64 }[] = m
print(v[0].f(2.5))
