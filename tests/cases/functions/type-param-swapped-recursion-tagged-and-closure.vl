// @run
// @log x
// @log 1
// @log x
// @log 0
// Two type parameters' parameters swapped by a recursive call, one handed a generic another
// function tags and the other an untagged generic: each instance hands on the value it holds,
// not the generic named by the first instance (D15406).
function same<T>(k: T): T { k }
function twice<T>(k: T): T { k }
function mid<F, G>(a: F, b: G, n: i32) {
  print(a("x"))
  print(b(n))
  if n > 0 { mid(b, a, n - 1) }
}
function third<F, G>(a: F, b: G, n: i32) {
  if n > 0 { third(b, a, n - 1) }
}
third(same, same, 1)
mid(same, twice, 1)
