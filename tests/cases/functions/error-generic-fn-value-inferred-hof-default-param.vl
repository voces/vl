// @emit-error Call sites pin `add` at (i32, i32), (f64, f64)
// One hole parameter handed two generics by name inside another function's body still reaches
// the emitter's floor (D6742). This pins the diagnostic's informative branch, which names the
// signatures the program's own calls pin `add` at. The same calls at module scope run.
function add(a, b) { return a + b }
function dbl(a, b) { return a * b }
function app(g, h) { print(g(1, 2) + 1); return h(2, 3) }
function use(n) { print(n); print(app(add, add)); return app(dbl, add) }
print(add(1, 2))
print(add(1.5, 2.5))
print(use(1))
