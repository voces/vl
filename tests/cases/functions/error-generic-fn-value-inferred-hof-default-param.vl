// @emit-error Call sites pin `add` at (i32, i32), (f64, f64)
// A hole function read out of a list and handed a generic called through it at two signatures
// reaches the emitter's floor (D6764). This pins the diagnostic's informative branch, which names
// the signatures the program's own calls pin `add` at. Called by name, the same function runs.
function add(a, b) { return a + b }
print(add(1, 2))
print(add(1.5, 2.5))
function apply2(g) {
  print(g(1, 2))
  print(g(1.5, 2.5))
}
const fs = [apply2]
fs[0](add)
