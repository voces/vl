// @emit-error Call sites pin `add` at (i32, i32), (f64, f64)
// A hole function read out of a two-element list whose other element is never called, handed a
// generic called through it at two signatures, reaches the emitter's floor (D6792). This pins
// the diagnostic's informative branch, which names the signatures the program's own calls pin
// `add` at.
function add(a, b) { return a + b }
print(add(1, 2))
print(add(1.5, 2.5))
function apply2(g) {
  print(g(1, 2))
  print(g(1.5, 2.5))
}
function apply3(g) {
  print(g(1, 2))
  print(g(1.5, 2.5))
}
const fs = [apply2, apply3]
fs[0](add)
