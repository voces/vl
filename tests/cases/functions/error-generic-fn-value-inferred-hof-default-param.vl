// @emit-error Call sites pin `add` at (i32, i32), (f64, f64)
// A hole function reached only through another function's parameter is not split, so a generic
// called through its hole at two signatures reaches the emitter's floor (D6280). This pins the
// diagnostic's informative branch, which names the signatures the program's own calls pin
// `add` at. Handed `add` by name, the same hole runs (`hole-param-always-one-fn-default-param.vl`).
function add(a, b) { return a + b }
function apply2(g, n: i32 = 1) {
  print(g(n, 2))
  print(g(1.5, 2.5))
}
function fwd(h) { apply2(h) }

print(add(1, 2))
print(add(1.5, 2.5))
fwd(add)
