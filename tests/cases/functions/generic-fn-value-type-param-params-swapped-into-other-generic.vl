// @run
// @log x
// @log 1
// @log x
// @log 0
// Two parameters of one bare type parameter, handed swapped to a second generic of the same
// shape, each pin the generic they carry at the destination's own close (D6240, D6202).
function same<T>(k: T): T { k }
function mid<F>(a: F, b: F, n: i32) {
  print(a("x"))
  print(b(n))
  if n > 0 { other(b, a, n - 1) }
}
function other<G>(a: G, b: G, n: i32) {
  print(a("x"))
  print(b(n))
}
mid(same, same, 1)
