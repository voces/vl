// @run
// @log 3
// @log w
// @log 2.5
// @log 1
// @log 3
// @log 1
// @log w
// @log 3
// @log w
// Several bindings of one hole lambda handed through an identity, each called at its own
// type, take a slot per binding type, a capturing lambda and annotated destinations included
// (D6241).
function fw(f) { return f }
const lam = (x) => x
const q = fw(lam)
const r = fw(lam)
const s = fw(lam)
print(q(3))
print(r("w"))
print(s(2.5))
function main() {
  const k = 1
  const cap = (x) => {
    print(k)
    x
  }
  const q1 = fw(cap)
  const r1 = fw(cap)
  print(q1(3))
  print(r1("w"))
}
main()
const lamA = (x) => x
const qa: (x: i32) => i32 = fw(lamA)
const ra: (x: string) => string = fw(lamA)
print(qa(3))
print(ra("w"))
