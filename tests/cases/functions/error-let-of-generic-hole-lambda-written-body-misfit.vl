// @error operator '+' is not defined for boolean and i32
// A lambda written to a generic `let` is re-checked at each call through the binding, at the
// argument types that call passes, wherever the call stands (D3968).
function inner<U>(u: U) { print(u) }
function main() {
  let k = inner
  k = (x) => {
    print(x + 1)
  }
  k(true)
}
main()
