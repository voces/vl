// @run
// @log 4
// A record literal returned from a function whose inferred result is a declared twin of it (a
// nullable record field beside a non-null one), cell `nested-ann`: built at the result's row and rep,
// or, where a nested literal sits at another rep, a named miss (return coercion).
type J = { f: i32 }
type K = { j: J | null }
type W = { k: K }
function mk(): W { return { k: { j: { f: 4 } } } }
const w = mk()
print(w.k.j?.f ?? 0)
