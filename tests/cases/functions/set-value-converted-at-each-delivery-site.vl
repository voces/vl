// @run
// A generic function stored in a list of records and called at two signatures is a set's member:
// a loop's element read into a record annotated at another signature converts the id there, the
// member pinned at that slot's signature (D17790).
function id(a) { return a }
function deliver() { return [{ f: id }] }
const u = deliver()
print(u[0].f(2))
for r in deliver() {
  const h: { f: (a: f64) => f64 } = { f: r.f }
  print(h.f(2.5))
}
// @log 2
// @log 2.5
