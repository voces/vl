// @run
// @log 6
// @log 4
// A function written into a record field twenty fields down, then called through the same chain,
// and the same chain read through a `for` loop's element: the write scan walks the whole chain to
// its root binding, with no step limit.

function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
const r = {
  a1: {
    a2: {
      a3: {
        a4: {
          a5: {
            a6: {
              a7: {
                a8: {
                  a9: {
                    a10: {
                      a11: {
                        a12: {
                          a13: {
                            a14: { a15: { a16: { a17: { a18: { a19: { a20: { f: inc0 } } } } } } },
                          },
                        },
                      },
                    },
                  },
                },
              },
            },
          },
        },
      },
    },
  },
}
r.a1.a2.a3.a4.a5.a6.a7.a8.a9.a10.a11.a12.a13.a14.a15.a16.a17.a18.a19.a20.f = dbl
print(
  r.a1.a2.a3.a4.a5.a6.a7.a8.a9.a10.a11.a12.a13.a14.a15.a16.a17.a18.a19.a20.f(3),
)
const s = {
  a1: {
    a2: {
      a3: {
        a4: {
          a5: {
            a6: {
              a7: {
                a8: {
                  a9: {
                    a10: {
                      a11: {
                        a12: {
                          a13: {
                            a14: { a15: { a16: { a17: { a18: { a19: { a20: { f: inc0 } } } } } } },
                          },
                        },
                      },
                    },
                  },
                },
              },
            },
          },
        },
      },
    },
  },
}
for x in [s] {
  print(
    x.a1.a2.a3.a4.a5.a6.a7.a8.a9.a10.a11.a12.a13.a14.a15.a16.a17.a18.a19.a20.f(3),
  )
}
