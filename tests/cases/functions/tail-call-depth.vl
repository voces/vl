// @run
// @log 407392
// @log 137729
// @log 55
// A call standing alone as a function's entire return value is in TAIL position, and
// lowers to wasm `return_call`, which reuses the caller's frame instead of stacking a
// new one. That makes recursion DEPTH a capability rather than a speed question: the
// descents below are millions of levels deep, which exhausts any fixed stack when the
// same call is lowered as a plain `call` followed by `return`.
//
// Three shapes are pinned together because they lower differently:
//   · SELF tail recursion — the callee is the enclosing function.
//   · MUTUAL tail recursion — the cycle spans two functions, so neither one is a loop
//     the callee could have been turned into; only the frame reuse makes it finite.
//   · a NON-tail call — `1 + sumDown(...)` has work pending after the call returns, so
//     the frame must survive it. It stays a plain `call`, and its depth stays bounded;
//     it is here as the control that ordinary recursion is untouched.
function digestTail(n: i32, acc: i32): i32 {
  if n == 0 { return acc }
  return digestTail(n - 1, (acc * 3 + n) & 1_048_575)
}
print(digestTail(5_000_000, 0))

function pingTail(n: i32, s: i32): i32 {
  if n == 0 { return s }
  return pongTail(n - 1, (s * 3 + 1) & 1_048_575)
}

function pongTail(n: i32, s: i32): i32 {
  if n == 0 { return (s * 7 + 5) & 1_048_575 }
  return pingTail(n - 1, (s * 5 + 2) & 1_048_575)
}
print(pingTail(2_000_000, 1))

function sumDown(n: i32): i32 {
  if n == 0 { return 0 }
  return 1 + sumDown(n - 1)
}
print(sumDown(55))
