// @run
// @log 3
// @log 6
// @log 4
// @log 2.5
// @log 5
// @log 4
// @log 6
// @log 4
// @log 6
// @log 4
// A record holding a choice of hole functions and a record holding a closed function, handed to one
// hole callee, key two instances: the set's dispatches by tag, the other calls the closure (D15646).
function id(v) { return v }
function dbl(v) { return v + v }
function inc(v: i32) { return v + 1 }
function inc2(v) { return v + 1 }
function call0(r, x) { print(r.f(x)) }
function callL(l, x) { print(l[0](x)) }
function run(b) {
  const g = if b { id } else { dbl }
  call0({ f: g }, 3)
}
run(true)
run(false)
call0({ f: inc }, 3)
function runF(b) {
  const g = if b { id } else { dbl }
  call0({ f: g }, 2.5)
}
runF(true)
runF(false)
call0({ f: (v: i32) => v + 1 }, 3)
function runL(b) {
  const g = if b { id } else { dbl }
  callL([g], 3)
}
runL(false)
callL([inc], 3)
function runH(b) {
  const g = if b { id } else { dbl }
  call0({ f: g }, 3)
}
runH(false)
call0({ f: inc2 }, 3)
