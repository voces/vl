// @run
// @info `k` is never reassigned; use `const` instead of `let`
// @hint redundant type annotation: `n` is inferred as `i32` — remove it to lean on inference
// A function returning a fresh list of a set's records, called into an annotated binding and
// elsewhere: the annotated delivery is copied through `.map`, so the result keeps one layout.
function id(a) { return a }
const xs = [{ f: id }]
function deliver() { return [{ f: id }] }
const v: { f: (a: f64) => f64 }[] = deliver()
const u = deliver()
let k = 0
const n: i32 = xs[k].f(2)
print(n + xs[k].f(2.5) + v[0].f(2.5) + u[0].f(2))
// @log 9
