// @run
// @warning Unreachable code
// @hint Intentionally-unused
// @hint redundant type annotation
// @log a
// @log p
// @log n
// @log g1
// @log a
// @log a
// @log l3
// @log q
// @log b
// @log a
// @log a
// @log 4
// @log a
// @log w7
// A value tail after a statement that always exits is dead, not the implicit return: the
// checker does not type it against the declared return, and the emitter lowers it as
// `unreachable` rather than as the result (D1974). One function per tail position.
import { toString } from "std:fmt"

function body(k: i32): string {
  {
    return "a"
  }
  k
}
function arm(k: i32): string {
  if k > 0 {
    return "p"
    5
  }
  return "n"
  7
}
function gen<T>(x: T, k: i32): string {
  return "g" + k.toString()
  x
}
function nested(k: i32): string {
  function inner(j: i32): string {
    return "a"
    j
  }
  inner(k)
}
function inferred(k: i32) {
  return "a"
  k
}
const lam = (k: i32): string => {
  return "l" + k.toString()
  5
}
function ifValueArm(k: i32): string {
  const s: string = if k > 0 {
    return "q"
    5
  } else {
    "b"
  }
  s
}
function deadNull(_k: i32): string {
  return "a"
  null
}
function deadFn(k: i32): string {
  return "a"
  function g(): i32 { k }
}
function deadRecord(k: i32): {r: i32} {
  return { r: k }
  "s"
}
function matchArms(k: i32): string {
  match k {
    1 => {
      return "a"
    }
    _ => {
      return "b"
    }
  }
  5
}
function slotsAfter(k: i32): string {
  if k > 0 {
    return "a"
    const _z = k + 1
  }
  const w = k + 7
  "w" + w.toString()
}
print(body(1))
print(arm(1))
print(arm(0))
print(gen(true, 1))
print(nested(1))
print(inferred(1))
print(lam(3))
print(ifValueArm(1))
print(ifValueArm(0))
print(deadNull(1))
print(deadFn(1))
print(deadRecord(4).r)
print(matchArms(1))
print(slotsAfter(0))
