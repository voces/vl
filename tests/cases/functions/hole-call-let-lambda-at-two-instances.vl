// @run
// @info `lap` is never reassigned; use `const` instead of `let`
// @info `lap2` is never reassigned; use `const` instead of `let`
// @info `lap4` is never reassigned; use `const` instead of `let`
// @log 2
// @log s
// @log 2
// @log s
// @log 2
// @log s
// @log 2
// @log s
// @log 4
// A lambda held by a never-assigned `let` runs a hole it calls at two types as a `const` one
// does: given a declared generic, at module scope or in a function, or given a lambda literal.
// Reassigned, it still runs a hole called at one type (D6351).
function id(a) { return a }
let lap = (g) => {
  print(g(1) + 1); return g("s")
}
print(lap(id))
let lap2 = (g) => {
  print(g(1) + 1); return g("s")
}
print(lap2((x) => x))
const lap3 = (g) => {
  print(g(1) + 1); return g("s")
}
const k3 = lap3
print(k3(id))
function main() {
  let lap4 = (g) => {
    print(g(1) + 1); return g("s")
  }
  print(lap4(id))
}
main()
let one = (g) => g(1) + 1
one = (g) => g(2) + 2
print(one(id))
