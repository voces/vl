// @run
// @log 0.5
// @log 0.5
// @log 0.625
// A hole lambda a maker returns, stored into a map whose values are functions returning `f64`,
// returns `f64`: the calls through the map's reads are the lambda's (D16752).
function deliver() { return (a) => a + 1 }
const m: { [string]: (a: i32) => f64 } = Map()
m["k"] = deliver()
const mv = m["k"]
if mv != null { print(mv(3) / 8.0) }
const n: { [string]: (a: i32) => f64 } = Map()
n.set("k", deliver())
const nv = n["k"]
if nv != null { print(nv(3) / 8.0) }
const p: { [string]: (a: i32) => f64 } = Map()
function put() { p["k"] = deliver() }
put()
const pv = p["k"]
if pv != null { print(pv(4) / 8.0) }
