// @run
// @log 4
// @log 4
// @log true
// @log 9000000001
// @log 4
// @log 6
// A capture's env FIELD type (`captureValKind`) and the classification of the READ
// out of that field (`exprIsF64` / `exprIsI64` / `exprIsF32`) are the SAME answer.
// When they disagree the read is widened a second time — `f64.convert_i32_s` over a
// field the env already types `f64` — which is `vl check`-clean invalid wasm.
//
// The checker's recorded type answers the read only when the OWNING binding is
// annotated: an un-annotated parameter is `any`, so the emitter's syntactic
// derivation is the only route left and it is the one that needs a capture arm.
// Annotating the NESTED function's own parameter does NOT help — `capF64Ann` has an
// annotated `x` and is the same cell as `capF64`, which is why this is a property of
// the CAPTURE and not of the function-value ABI's i32 parameter default.
//
// Each nested function needs a DISTINCT name: capture analysis is name-keyed
// module-wide.
function capF64(n) {
  function bumpF64(x) x + n
  bumpF64(1.5)
}
function capF64Ann(n) {
  function bumpF64Ann(x: f64) x + n
  bumpF64Ann(1.5)
}
function capF64Cmp(n) {
  function underF64(x: f64) x < n
  underF64(1.5)
}
function capI64(n) {
  function bumpI64(x: i64) x + n
  bumpI64(1)
}
function capF32(n) {
  function bumpF32(x) x + n
  bumpF32(1.5)
}
// The control: the owning binding annotated, clean on either side of the arm.
function capF64Ctl(n: f64) {
  function bumpF64Ctl(x: f64) x + n
  bumpF64Ctl(1.5)
}
const f32v: f32 = 2.5
print(capF64(2.5))
print(capF64Ann(2.5))
print(capF64Cmp(2.5))
print(capI64(9000000000))
print(capF32(f32v))
print(capF64Ctl(4.5))
