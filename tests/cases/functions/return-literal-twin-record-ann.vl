// @run
// @log 4
// A record literal returned from a function whose inferred result is a declared twin of it (a
// nullable record field beside a non-null one), cell `record-ann`: built at the result's row and rep,
// or, where a nested literal sits at another rep, a named miss (return coercion).
type J = { f: i32 }
type K = { j: J | null }
function mk(): K { return { j: { f: 4 } } }
const k = mk()
print(k.j?.f ?? 0)
