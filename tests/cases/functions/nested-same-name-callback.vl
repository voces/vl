// @run
// @log 4
// @log 103
// @log 4
// @log 103
// @log 4
// @log 103
// @log 104
// @log 1
// @log 2
// @log 1003
// @log 4
// @log 4
// A `.map`/`.filter` CALLBACK NAMED BY IDENTIFIER RESOLVES IN SCOPE.
//
// `mfCallbackFe` resolved the callback with the flat first-occurrence-wins `fnIndexOf`,
// so `xs.map(inner)` in EVERY frame mapped with the module's FIRST `inner`. Like the
// by-name CALL path #1204 repaired, the colliding bodies usually agree in shape, so this
// is not a crash but a WRONG LIST with exit code 0 — the one shape #1204's 28-shape
// census was left holding (`4 / 4` for `4 / 103`).
//
// It now resolves through `fnIndexOfInScope`, which walks the whole lexical chain, so the
// repair reaches the callback taken from a sibling frame, from a lambda, and from a
// deeper frame that shadows an outer one — and `.filter` with it.
//
// The last two groups are the CONTROLS: an unshadowed frame must still reach a TOP-LEVEL
// callback, and a module-GLOBAL binding of a callback must keep meaning the top-level
// function even when some frame declares a nested twin.

// (1) the canonical collision — `.map(inner)` in two frames.
function mapA(): i32 {
  function inner(x: i32): i32 { return x + 1 }
  const xs = [3]
  const ys = xs.map(inner)
  return ys[0]
}
function mapB(): i32 {
  function inner(x: i32): i32 { return x + 100 }
  const xs = [3]
  const ys = xs.map(inner)
  return ys[0]
}
print(mapA())
print(mapB())

// (2) the callback mapped from a SIBLING nested function — `inner`'s parent is the
// enclosing frame, not `mid`, so the one-level rule missed it.
function sibA(): i32 {
  function inner(x: i32): i32 { return x + 1 }
  function mid(): i32 {
    const xs = [3]
    const ys = xs.map(inner)
    return ys[0]
  }
  return mid()
}
function sibB(): i32 {
  function inner(x: i32): i32 { return x + 100 }
  function mid(): i32 {
    const xs = [3]
    const ys = xs.map(inner)
    return ys[0]
  }
  return mid()
}
print(sibA())
print(sibB())

// (3) the callback mapped inside a LAMBDA in the declaring frame (the lambda is its own
// lifted frame, one step in from `inner`).
function lamA(): i32 {
  function inner(x: i32): i32 { return x + 1 }
  const g = (n: i32) => [n].map(inner)[0]
  return g(3)
}
function lamB(): i32 {
  function inner(x: i32): i32 { return x + 100 }
  const g = (n: i32) => [n].map(inner)[0]
  return g(3)
}
print(lamA())
print(lamB())

// (4) INNERMOST WINS — a nested `mid` declaring its own `inner` maps with THAT one, and
// the frame-level `inner` is still reachable beside it (1 + 103).
function innermost(): i32 {
  function inner(x: i32): i32 { return x + 1 }
  function mid(): i32 {
    function inner(y: i32): i32 { return y + 100 }
    const xs = [3]
    const ys = xs.map(inner)
    return ys[0]
  }
  return mid() + inner(0)
}
print(innermost())

// (5) `.filter` takes the same path — a wrong predicate is a wrong LENGTH.
function filA(): i32 {
  function keep(x: i32): boolean { return x > 2 }
  const xs = [1, 3]
  const ys = xs.filter(keep)
  return ys.length
}
function filB(): i32 {
  function keep(x: i32): boolean { return x > 0 }
  const xs = [1, 3]
  const ys = xs.filter(keep)
  return ys.length
}
print(filA())
print(filB())

// (6) CONTROL — a nested callback SHADOWS a top-level one. The unshadowed frame must
// still reach the TOP-LEVEL function (a resolver that always preferred a nested
// declaration would break this line).
function sinc(x: i32): i32 { return x + 1000 }
function plainFrame(): i32 {
  const xs = [3]
  const ys = xs.map(sinc)
  return ys[0]
}
function shadowFrame(): i32 {
  function sinc(x: i32): i32 { return x + 1 }
  const xs = [3]
  const ys = xs.map(sinc)
  return ys[0]
}
print(plainFrame())
print(shadowFrame())

// (7) CONTROL — a MODULE-GLOBAL binding of a callback. Its initializer is elaborated at
// top level, where no frame's nested declarations are in scope, so `gf` denotes the
// top-level `ginc` even when read inside a frame that declares its own.
function ginc(x: i32): i32 { return x + 1 }
const gf = ginc
function globalCbFrame(): i32 {
  function ginc(x: i32): i32 { return x + 100 }
  const xs = [3]
  const ys = xs.map(gf)
  return ys[0]
}
print(globalCbFrame())
