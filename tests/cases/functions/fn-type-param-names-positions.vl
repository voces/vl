// @hint redundant type annotation: `s` is inferred as `{f: (i32) => i32, g: (i32, i32) => i32}`
// Owner ruling A1: a function type may name its parameters, and the names are documentation
// only. Every type position here spells a named function type, and values cross between
// positions whose names differ (`x` into `y` into `z`, `S` into a record naming `q`/`m`/`n`),
// through an alias, a param, a return, a field, a list element, a generic argument, a map
// value, a union member, a join and a monomorphized call. `vl_fn_type_param_names_test.ts`
// builds this program's unnamed and renamed spellings and holds all three byte-identical.
type Un = (x: i32) => i32
type Bin = (a: i32, b: i32) => i32
type S = { f: (x: i32) => i32, g: Bin }
type Box<T> = { v: T }
function dbl(x: i32) { x * 2 }
function add(a: i32, b: i32) { a + b }
function apply(f: (x: i32) => i32, v: i32) { f(v) }
function mk(k: i32): (x: i32) => i32 {
  (v: i32) => v * k
}
function mkU(): Un { dbl }
function id<T>(x: T): T { x }
function callG<T>(f: (x: T) => T, v: T): T { f(v) }
function twice(f: (cb: (x: i32) => i32, v: i32) => i32) { f(dbl, 5) }
function orNull(c: boolean): ((x: i32) => i32) | null {
  if c { return dbl }
  null
}
const u: Un = dbl
const u2: (y: i32) => i32 = u
let u3: (z: i32) => i32 = mk(3)
u3 = u2
const s: S = { f: u, g: add }
const s2: { f: (q: i32) => i32, g: (m: i32, n: i32) => i32 } = s
const fs: ((x: i32) => i32)[] = [dbl, u, u2, mk(4)]
const fs2: Un[] = fs
const bx: Box<(x: i32) => i32> = { v: dbl }
const bx2: Box<Un> = bx
const mp: {[string]: (x: i32) => i32} = Map()
mp["a"] = u2
const lam = (f: (w: i32) => i32): i32 => f(21)
const pick = if u(0) == 0 { u } else { u2 }
print(pick(23))
print(u(1))
print(u2(2))
print(u3(3))
print(s.f(4) + s.g(5, 6))
print(s2.f(7) + s2.g(8, 9))
print(fs[3](10) + fs2[1](11))
print(bx.v(12) + bx2.v(13))
print((mp["a"] ?? dbl)(14))
print(lam(u))
print(apply(u2, 15))
print(apply(mk(5), 16))
print(mkU()(17))
print(id(u)(18))
print(id(u2)(19))
print(callG(u, 20))
print(twice((cb: (x: i32) => i32, v: i32): i32 => cb(v) + 1))
const on = orNull(true)
if on != null { print(on(22)) }
