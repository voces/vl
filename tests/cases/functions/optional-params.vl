// @run
// @log x
// @log x=7
// @log none
// @log 4
// @log plain
// @log Cat Momo
// @hint redundant type annotation: `tag` is inferred as `string`
// @hint redundant type annotation: `orElse` is inferred as `i32`
// @hint redundant type annotation: `label` is inferred as `string`
// @hint redundant type annotation: `describe` is inferred as `string`
// An OPTIONAL parameter `p?: T` is sugar for `p: T | null = null` — VL has real
// null unions, so one mechanism serves both spellings. The annotation the
// checker sees is the union, and the omitted argument is filled with `null`, so
// the body narrows it exactly as a hand-written nullable parameter would.
function tag(s: string, n?: i32): string {
  if n == null { return s }
  return s + "=7"
}
print(tag("x"))
print(tag("x", 7))

// The `| null` half is a real union member, so `??` works over it.
function orElse(v?: i32): i32 { v ?? 4 }
function label(s?: string): string { s ?? "none" }
print(label())
print(orElse())
print(label("plain"))

// A STRUCT-typed optional parameter is the nullable struct ref, not a box.
type Cat = { name: string }
function describe(kind: string, c?: Cat): string {
  if c == null { return kind }
  return kind + " " + c.name
}
print(describe("Cat", { name: "Momo" }))
