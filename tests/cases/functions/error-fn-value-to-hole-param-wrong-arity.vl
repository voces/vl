// @error-at 38:6 wrong number of arguments: expected 1, got 2 (the body of `mid` at the call's argument types)
// D5750: a function handed to an un-annotated parameter and called there with the wrong number
// of arguments is refused at the call that hands it, with the direct spelling's sentence. A
// default does not widen the arity of a call through a function value.
function one(v: i32): i32 { v }
function two(a: i32, b: i32): i32 { a + b }
function dflt(a: i32, b: i32 = 10): i32 { a + b }
function pair<T>(a: T, _b: T): T { a }
function idg<T>(v: T): T { v }
function neg(a) { return 0 - a }
function apply1(g, x) { return g(x) }
function apply2(g, x, y) { return g(x, y) }
function twice(g, x) { return g(x, x) }
function mid(h, x) { return apply2(h, x, 0) }
const lap = (g, x) => g(x)
print(apply1(two, 3))
print(apply1(dflt, 3))
print(apply1(pair, 3))
print(apply1((a: i32, b: i32) => a + b, 3))
print(lap(two, 3))
print(apply2(one, 3, 0))
print(apply2(idg, 3, 0))
print(apply2(neg, 3, 0))
print(apply2((a: i32) => a + 1, 3, 0))
print(twice(one, 3))
print(mid(one, 3))
print(mid(idg, 3))
