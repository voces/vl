// @run
// @log 3
// @log 3
// A record literal returned from a function whose inferred result is a declared twin of it (a
// nullable record field beside a non-null one), cell `map`: built at the result's row and rep,
// or, where a nested literal sits at another rep, a named miss (return coercion).
type M = {[string]: i32}
type K = { j: M | null }
function mm() {
  const m: M = Map()
  m["a"] = 3
  return m
}
function mk() { return { j: mm() } }
const y = mk()
print(y.j["a"] ?? 0)
const k: K = mk()
print(if k.j == null { 0 } else { k.j["a"] ?? 0 })
