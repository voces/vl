// @check
// Imported wasm globals: `extern let` imports a mutable global and `extern const` an immutable
// one, in the `extern` namespace beside `extern function`. Every read is a `global.get` on the
// import and every write a `global.set` — at top level, in a function and in a closure — so a
// write the host makes between two reads is seen by the second. No host `vl` provides a
// global, so this only checks; `tests/vl_extern_global_test.ts` builds it, supplies each one as
// a `WebAssembly.Global`, and asserts the output and the values the host reads back.
extern let rax: i64
extern let zf: boolean
extern const width: i32
extern let scale: f64
extern let ratio: f32
extern function tick(): void

function step(): void { rax = rax + 1 }
const addTo = (d: i64) => {
  rax = rax + d
}
const readBack = () => rax

print(rax)
step()
print(rax)
tick()
print(readBack())
addTo(9)
print(rax)
zf = rax > 100
print(zf)
print(width * 2)
scale = scale * 4.0
print(scale)
ratio = ratio + 0.5
print(ratio)

export function peek() { return rax }
