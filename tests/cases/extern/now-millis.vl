// @run
// @log true
// @log true
// A HOST IMPORT DECLARED IN THE PROGRAM — `extern function`, the whole feature end to end:
// declared at module level with no body, collected into the wasm import section under the
// `extern` namespace, and provided by whoever instantiates the module.
//
// The assertion is a STABLE property of a clock rather than a value: two reads are
// non-decreasing, and a millisecond clock is past the epoch. Both hosts implement
// `nowMillis` (`scripts/vl-host/src/main.rs` `register_extern_imports`,
// `tests/support/runWasm.ts`), so this runs under either.
extern function nowMillis(): i64

const a = nowMillis()
const b = nowMillis()
print(b >= a)
print(a > 0)
