// @check
// The importing half of `global-export.vl`: a separately built unit that takes that unit's
// exported globals and function as its imports. `incr` writes the provider's global and this
// unit's next read sees it, because both units name ONE global rather than each holding a
// copy. Linked by `tests/vl_extern_global_test.ts` through V8 and through `wasm-merge`.
extern let rax: i64
extern const width: i32
extern function incr(): void

print(rax)
incr()
print(rax)
rax = rax + width
incr()
print(rax)
