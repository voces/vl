// @run
// @log 2
// @log true
// @hint redundant type annotation: `g` is inferred as `i64` — remove it to lean on inference
// An extern called inside a named function of a module that also uses a function value. Every
// function's free names are scanned for captures once a closure exists, and an extern callee
// is the import, not a capture, so the call lowers to it here as it does at top level (D1997).
extern function nowMillis(): i64

const h = (x: i32) => x + 1
function g(): i64 { return nowMillis() }
print(h(1))
print(g() > (0 as i64))
