// @run
// @log 8
// @log 9
// @log true
// A module-scope `for` variable is in scope only inside its own loop's body: a closure written
// after the loop, or inside a named function, that calls the same spelling calls the extern
// (D2010).
extern function nowMillis(): i64
const fs: (() => i32)[] = []
for nowMillis in [7, 8] { fs.push(() => nowMillis + 1) }
for f in fs { print(f()) }
const g = () => nowMillis() > 0
print(g())
