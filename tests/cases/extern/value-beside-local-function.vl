// @log true
// @hint redundant type annotation: `h` is inferred as `i64` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// @hint redundant type annotation: `pick` is inferred as `i64` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// @hint redundant type annotation: `callIt` is inferred as `boolean` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// Reported by plumb (PL-042), in its own shape: an extern taken as a value — here in a list
// beside a local function, then bound, passed, returned and captured — is the closure of a
// forwarding function, so it is called like any function value (D2618).
extern function nowMillis(): i64

function h(): i64 { 7 as i64 }
function pick(i: i32): i64 {
  const fs = [nowMillis, h]
  fs[i]()
}
print(pick(1))
print(pick(0) > (0 as i64))

const f = nowMillis
print(f() > (0 as i64))
function callIt(g: () => i64): boolean { g() > (0 as i64) }
print(callIt(nowMillis))
function give(): () => i64 { nowMillis }
print(give()() > (0 as i64))
const later = () => {
  const k = nowMillis
  k() > (0 as i64)
}
print(later())
