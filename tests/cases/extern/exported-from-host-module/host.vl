// The host boundary declared in one place — the shape `export extern` exists for: every other
// module imports the name instead of re-declaring the signature.
export extern function nowMillis(): i64

export extern function hostEcho(x: i32): i32

// Not exported, so no other module can spell it — visibility is ordinary, exactly as on a
// `function`. It is callable in this module, which is what makes that a rule rather than a dead row.
extern function hostPrivate(x: i32): i32

export function twice(x: i32) {
  return hostPrivate(hostPrivate(x))
}
