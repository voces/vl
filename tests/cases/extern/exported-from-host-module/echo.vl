// The second importer, using the OTHER extern — and re-exporting it, which must work like any
// other re-export: an importer of this module reaches `host.vl`'s declaration, not a copy.
export { hostEcho } from "./host"

import { hostEcho } from "./host"

export function twiceEcho(x: i32) {
  return hostEcho(hostEcho(x))
}
