// @check
// One place declares the host boundary, everywhere else imports by name. `host.vl` exports two
// externs and keeps a third private; `clock.vl` and `echo.vl` take one each; this module
// reaches `hostEcho` through `echo.vl`'s re-export, which resolves to `host.vl`'s declaration
// rather than to a copy.
//
// `@check`-tier on purpose, and that is itself the assertion: `vl check` needs no provider, so
// a program declaring externs no host implements is clean. The running half is
// `tests/cases/extern/now-millis.vl`, and the import section — one entry per extern, three
// for three declarations — is disassembled in `tests/vl_extern_test.ts`.
import { hostEcho } from "./echo"
import { elapsed } from "./clock"
import { nowMillis, twice } from "./host"

const t = nowMillis()
print(elapsed(t) >= 0)
print(hostEcho(1) + twice(2) >= 0)
