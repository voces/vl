// @run
// @log 0
// @log 1
// An entry module's scalar `export let` is a wasm global export, the way its `export function`
// is a function export: `export let` publishes a mutable global and `export const` an immutable
// one, so another unit's `extern let rax: i64` / `extern const width: i32` links to it. A
// binding of any other type stays a VL-level export only. `tests/vl_extern_global_test.ts`
// reads the export section and links a second unit against it.
export let rax: i64 = 0
export const width = 8
export let zf = false
export let label = "not a wasm global"

export function incr(): void { rax = rax + 1 }

print(rax)
incr()
print(rax)
