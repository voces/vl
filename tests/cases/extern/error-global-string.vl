// @check
// @error extern `name` is typed `string`, which cannot cross a host boundary — an imported global holds i32, i64, f32, f64 or boolean only
// CONTRACT (must-error): the extern type set is closed to scalars for a global exactly as for
// a function's parameters, and for the same reason: a browser host cannot read a GC ref.
extern let name: string

print(name)
