// @check
// A module-scope `for` variable spelled like an extern is the variable, both inside a closure
// in the loop body and in the body itself, never the host import. `tests/vl_extern_test.ts`
// builds this with a `g` that answers 999, so a call routed to the import would print 999 in
// place of 11, 21, 12 or 22; the call after the loop is the import's.
extern function g(a: i32): i32

const fns = [(x: i32) => x + 1, (x: i32) => x + 2]
for g in fns {
  const h = () => g(10)
  print(h())
  print(g(20))
}
print(g(0))
