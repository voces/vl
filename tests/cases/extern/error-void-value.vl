// @check
// @error cannot bind the void result of 'x' — a void function returns no value
// @error print expects a value, got void
// @error return type mismatch: expected i32, got void
// CONTRACT (must-error): a `: void` extern leaves nothing on the stack, so its call is a
// statement. Every position that needs a value refuses it with the message a void `function`
// gets — binding it, printing it, and returning it where a value is declared.
extern function sink(a: i32): void

const x = sink(1)
print(sink(2))

function f(): i32 { return sink(3) }

print(x)
print(f())
