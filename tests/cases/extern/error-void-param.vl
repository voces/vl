// @check
// @error extern `sink` takes `void`, which is not a value — `void` is legal only as an extern's return type
// CONTRACT (must-error): `void` names the absence of a result, so it is an extern's return
// type and never a parameter's. The refusal says so rather than naming the byte-passing
// workaround the other non-scalar parameter types get.
extern function sink(a: void): void

sink(1)
