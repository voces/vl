// @check
// @error extern `clock` is declared both as a function and as a global — one name is one host import
// @error 'clock' is declared `extern` — every call to it lowers to a host import, so this definition would never run
// CONTRACT (must-error): functions and globals share the `extern` import namespace, and a host
// object holds one value per key, so one name cannot be both.
extern function clock(): i64
extern let clock: i64

