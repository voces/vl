// @run
// @log true
// TWO MODULES, ONE IMPORT. Both this module and `./clock` declare `nowMillis` with the same
// signature, and the emitted module carries exactly one `(import "extern" "nowMillis" …)` —
// the manifest is keyed on the NAME, which is what makes a shared declaration in a header-like
// module the natural spelling. `tests/vl_extern_test.ts` disassembles the import section and
// asserts the count.
import { tick } from "./clock"

extern function nowMillis(): i64

const a = nowMillis()
const b = tick()
print(b >= a)
