// @run
// @log true
// @log 5
// @hint redundant type annotation: `__extv_nowMillis` is inferred as `i64` — remove it to lean on inference
// The function an extern value closes over is spelled so no program can name it: a user
// function of any spelling stays its own function and the value still reads the clock (D2618).
extern function nowMillis(): i64
function __extv_nowMillis(): i64 { 5 as i64 }
const v = nowMillis
print(v() > (10 as i64))
print(__extv_nowMillis())
