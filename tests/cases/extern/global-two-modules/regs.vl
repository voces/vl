// A module that owns part of the register file: `export extern let` publishes the VL name
// `rax` to importers, and the private `extern let rbx` is the same import as the entry's own
// declaration of it, so both modules write one global.
export extern let rax: i64
extern let rbx: i32

export function bumpB(): void { rbx = rbx + 1 }

export function readB(): i32 { return rbx }
