// @check
// One extern global declared in two modules is ONE import, and an `export extern let` is
// imported by name like any binding. The import section this builds is asserted by
// `tests/vl_extern_global_test.ts`: exactly `extern.rax` and `extern.rbx`, both mutable.
import { bumpB, rax, readB } from "./regs"

extern let rbx: i32

rax = rax + 1
bumpB()
rbx = rbx + 100
print(readB())
print(rax)
