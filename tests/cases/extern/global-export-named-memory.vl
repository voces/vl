// @run
// @log 7
// A program that uses linear memory exports it under the name `memory`, so an entry-module
// `export let memory` keeps its VL meaning and is simply not published as a wasm global — the
// same rule as a public name a function already took. It must still build and run.
import { Buffer, loadI32, storeI32 } from "std:buffer"

export let memory = 7
const b = Buffer(8)
storeI32(b, 0, memory)
print(loadI32(b, 0))
