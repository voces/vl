// @run
// @log true
// `export extern` is ordinary visibility, exactly as on a `function` — legal here with nobody
// importing it, and it publishes a VL NAME, never a wasm one: the module's export section is
// untouched and the import entry is the whole of what a host sees. The multi-module half is
// `tests/cases/extern/exported-from-host-module/`.
export extern function nowMillis(): i64

print(nowMillis() > 0)
