// @check
// @error an `extern` needs no `export` — its name is the host import's name, so it is already visible in every module
// CONTRACT (must-error): the flat link namespace, said at the one spelling that would suggest
// otherwise. `export` on a `function` controls which modules may import the name; an extern's
// name is the wasm import name, which every module already spells directly, so there is
// nothing for `export` to widen. Refused rather than accepted as a no-op, because a no-op
// keyword reads as a visibility rule that is not there.
export extern function nowMillis(): i64

print(nowMillis())
