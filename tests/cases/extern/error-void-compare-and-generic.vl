// @check
// @error `==` expects a value, got void
// @error `!=` expects a value, got void
// @error argument 1 expects a value, got void
// CONTRACT (must-error): a void call is not an operand of `==`/`!=` and does not bind a type
// parameter, for a `: void` extern and a void `function` alike — both leave nothing to compare
// or to instantiate a generic with.
extern function sink(a: i32): void
function quiet(a: i32): void { print(a) }
function id<T>(x: T): T { x }

const b = sink(1) == sink(2)
print(quiet(1) != quiet(2))
id(sink(3))
print(b)
