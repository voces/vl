// @check
// An `extern function` may declare `never`: it lowers as a result-less import, and a call to it
// ends its path, so a guard arm narrows and an if-expression arm joins away. No host `vl` runs
// implements `exit`; `tests/vl_extern_test.ts` links it and runs this to the trap. D2027.
extern function exit(code: i32): never

function f(x: i32 | null) {
  if x == null { exit(2) }
  x + 1
}

// ...and through a binding of it, in a value position.
const leave = exit
function g(c: boolean, s: string | null) {
  const v = if c { "yes" } else { leave(3) }
  if s == null { leave(4) }
  v + s
}

print(f(1))
print(g(true, "!"))
print(f(null))
