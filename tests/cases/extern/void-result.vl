// @check
// A result-less host import: `extern function name(…): void` declares a wasm import with an
// empty result list, and a call to it is a statement. This file is every position such a call
// can stand in; `tests/vl_extern_test.ts` builds it, provides `sink`, and asserts the calls
// arrive in this order — no host `vl` implements `sink`, so the fixture itself only checks.
extern function sink(a: i32): void

// at top level
sink(1)

// in a function, and as the last statement of a `: void` one
function twice(x: i32): void {
  sink(x)
  sink(x + 1)
}
twice(2)

// as the last statement of a function whose return is inferred
function tail(x: i32) { sink(x) }
tail(4)

// inside a lambda: an expression body, a block body, and one annotated `=> void`
const f = (x: i32) => sink(x)
f(5)
const g = (x: i32) => {
  sink(x)
}
g(6)
const h: (i32) => void = (x) => sink(x)
h(7)

// in both arms of an `if` inside a loop
for i in [8, 9] {
  if i % 2 == 0 { sink(i) } else { sink(i * 10) }
}

// before an early bare `return`
function early(x: i32): void {
  if x > 0 {
    sink(x)
    return
  }
  sink(-1)
}
early(11)
early(0)
