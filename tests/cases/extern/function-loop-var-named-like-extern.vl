// @run
// @log 106
// @log 130
// @hint redundant type annotation: `f` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `g` is inferred as `i32` — remove it to lean on inference
// A function's `for` variable is in scope only inside its own loop: after the loop, or in a
// closure written outside it, the same spelling is the extern, read as a value or called
// (D2620). A closure written inside the loop still reads the loop variable.
extern function nowMillis(): i64

function f(): i32 {
  let s = 0
  for nowMillis in [1, 2, 3] { s = s + nowMillis }
  const v = nowMillis
  if v() > (0 as i64) { s = s + 100 }
  s
}
print(f())

function g(): i32 {
  const fs: (() => i32)[] = []
  for nowMillis in [1, 2] { fs.push(() => nowMillis * 10) }
  const later = () => nowMillis() > (0 as i64)
  let s = fs[0]() + fs[1]()
  if later() { s = s + 100 }
  s
}
print(g())
