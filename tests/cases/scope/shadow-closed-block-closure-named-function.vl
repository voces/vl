// @run
// @log s
// @log 0.75
// @log 4
// @log 0.75
// @log s
// @log 0.75
// @log 5
// @log top!
// @log s!
// @log 0.75
// @log 1.25
// @log top
// @log 7
// @log top
// @hint redundant type annotation: `w` is inferred as `f64`
// @hint redundant type annotation: `r` is inferred as `f64`
// @hint redundant type annotation: `top` is inferred as `string`

// D2384 — a block's closure that shadows a module function is out of scope once its block
// closes, so a later call of the name is the module function's, cell and all. D2415 — the
// module-scope twin, where a block's closure shadows the module function inside its block.

function w(): f64 { return 1.5 }

function blk(c: boolean) {
  if c {
    const w = () => {
      return "s"
    }
    print(w())
  }
  const r = w()
  print(r / 2.0)
}
blk(true)

type P = { x: i32 }
function structClosure(c: boolean) {
  if c {
    const w = (): P => {
      return { x: 4 }
    }
    print(w().x)
  }
  const r: f64 = w()
  print(r / 2.0)
}
structClosure(true)

function loopBlock() {
  let i = 0
  while i < 1 {
    const w = () => {
      return "s"
    }
    print(w())
    i = i + 1
  }
  const r = w()
  print(r / 2.0)
}
loopBlock()

function top(): string { return "top" }
function i64Closure(c: boolean) {
  if c {
    const top = (): i64 => {
      return 5 as i64
    }
    print(top())
  }
  const r = top()
  print(r + "!")
}
i64Closure(true)

if true {
  const w = () => {
    return "s"
  }
  const r = w()
  print(r + "!")
}
print(w() / 2.0)

if true {
  const top = () => {
    return 2.5
  }
  print(top() / 2.0)
}
print(top())

let k = 0
while k < 1 {
  const top = (): i64 => {
    return 5 as i64
  }
  const r = top()
  print(r + (2 as i64))
  k = k + 1
}
print(top())
