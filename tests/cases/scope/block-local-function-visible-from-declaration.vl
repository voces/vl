// @log 1
// D3608, D3614: a block-local `function` is in scope from its declaration to the end of its
// block, as a `let` is, which is how the checker resolves it. The emitter looked a nested
// function up by name over the whole calling frame, so a call above it or after its block
// called it: a wrong value where the signatures agree, an invalid module where they do not.
function k() { 1 }
function above() {
  print(k())
  function k() { 2 }
  print(k())
}
function m() { "mod" }
function afterBlock(t: boolean) {
  if t {
    function m() { 2 }
    print(m())
  }
  print(m() + "!")
}
function siblings(t: boolean) {
  if t {
    function k() { 3 }
    print(k())
  }
  if t {
    function k() { 4 }
    print(k())
  }
  print(k())
}
function lambdaAbove(t: boolean) {
  const c = 5
  const g = () => k()
  if t {
    function k() { c }
    print(k())
  }
  print(g())
}
function recursive(t: boolean) {
  if t {
    function k() { 6 }
    function down(n: i32) {
      if n <= 0 { return k() }
      down(n - 1)
    }
    print(down(3))
  }
  print(k())
}
function builtin(t: boolean) {
  print(abs(0 - 7))
  if t {
    function abs(x: i32) { x * 10 }
    print(abs(0 - 7))
  }
  print(abs(0 - 8))
}
above()
afterBlock(true)
siblings(true)
lambdaAbove(true)
recursive(true)
builtin(true)
function gen<T>(x: T, n: i32): T {
  if n > 0 {
    function k() { n }
    print(k())
  }
  if n > 0 {
    function k() { n + 100 }
    print(k())
  }
  print(k())
  x
}
print(gen(3, 7))
print(gen("z", 8))
function kk<T>(x: T): T { x }
function genHost<U>(y: U): U {
  if true {
    function kk(x: i32) { x + 100 }
    print(kk(5))
  }
  print(kk(7))
  y
}
print(genHost(1))
function b() { 11 }
function boolHost() {
  if true {
    function b() { false }
    print(b())
  }
  print(b())
}
boolHost()
const tt = true
if tt {
  function k() { 9 }
  print(k())
}
print(k())
