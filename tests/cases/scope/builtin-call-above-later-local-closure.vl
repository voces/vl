// @run
// @warning `sqrt` shadows the builtin `sqrt`, which this function calls above it; below it the name means the binding, so rename one
// @warning `min` shadows the builtin `min`, which this function calls above it; below it the name means the binding, so rename one
// @warning `abs` shadows the builtin `abs`, which this function calls above it; below it the name means the binding, so rename one
// @warning `k` shadows the function `k` declared at 33:10, which this function calls above it
// @log 4
// @log 16
// @log 3
// @log 12
// @log 5
// @log 8
// @log 1
// @log 2
// D3607: a direct call above a later local of a builtin's or a module function's name reaches
// the builtin or the function, as the checker resolves it. The emitter asked whether the name
// was bound anywhere in the function, so it called the later local: a missing signature for a
// closure, a float `min` or `abs` for an integer one, or a read of an unset local.
function a() {
  print(sqrt(16.0))
  const sqrt = (x: f64) => x
  print(sqrt(16.0))
}
function b() {
  print(min(3, 4))
  const min = (p: i32, q: i32) => p * q
  print(min(3, 4))
}
function c() {
  print(abs(0 - 5))
  const abs = 8
  print(abs)
}
function k() { 1 }
function d() {
  print(k())
  const k = () => 2
  print(k())
}
a()
b()
c()
d()
