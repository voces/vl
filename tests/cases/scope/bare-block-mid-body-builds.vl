// @run
// @log 4
// @log 9
// @log 7
// A bare block mid-body is rewritten to `if true { … }`, whose `true` the checker never typed:
// legacy writes the block's statements in place. A block declaring its own local, one nested in
// another, and one in a loop body.
function mid(x: i32) {
  let y = x
  {
    const z = y + 1
    y = z * 2
  }
  return y
}
function nested(x: i32) {
  let y = x
  {
    {
      y = y + 4
    }
    y = y + 1
  }
  return y
}
function looped(n: i32) {
  let s = 0
  let i = 0
  while i < n {
    {
      s = s + i
    }
    i = i + 1
  }
  return s + 1
}
print(mid(1))
print(nested(4))
print(looped(4))
