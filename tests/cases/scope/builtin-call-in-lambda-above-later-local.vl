// @run
// @warning `floor` shadows the builtin `floor`, which this function calls above it; below it the name means the binding, so rename one
// @warning `sqrt` shadows the builtin `sqrt`, which this function calls above it; below it the name means the binding, so rename one
// @warning `min` shadows the builtin `min`, which this function calls above it; below it the name means the binding, so rename one
// @log 2
// @log 0.25
// @log 4
// @log 116
// @log 3
// @log 7
// @log 2
// @log 0.5
// D3604: a lambda created above a later local named like a numeric builtin calls the builtin.
// The capture scan bound the name over the whole function, so the lambda captured the later
// local and the emitter refused the call. Lambda, nested lambda and nested function each.
function a(x: f64) {
  const g = () => floor(x)
  const floor = 0.25
  print(g())
  print(floor)
}
function b() {
  const g = () => () => sqrt(16.0)
  const sqrt = (y: f64) => y + 100.0
  print(g()())
  print(sqrt(16.0))
}
function c() {
  function g() { min(3, 4) }
  const min = 7
  print(g())
  print(min)
}
function d(x: f64) {
  const g = () => floor(x)
  if x > 0.0 {
    const floor = 0.5
    print(g())
    print(floor)
  }
}
a(2.5)
b()
c()
d(2.5)
