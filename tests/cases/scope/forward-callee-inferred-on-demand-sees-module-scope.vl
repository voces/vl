// @run
// @info `x` is never reassigned; use `const` instead of `let`
// @log 2.5
// @log 1
// @log 2.5
// @log 1
// @log 2.5
// @log 1
// @log 7
// @log 1
// @log true
// @log 2
// @log s
// @log 1
// @log 2.5
// @log 1
// @log 2.5
// @log 6
// @log 2.5
// @log 10
// @log 2.5
// @log 1
// @log 2.5
// @log 1
// @log 2.5
// @log 1
// D5650: a callee declared after its caller is inferred inside the caller's body, and still
// resolves its free names at module scope, whichever caller binding shadows them.
const x = 1
function byConst() {
  const x = 2.5
  print(x)
  return gConst()
}
function byParam(x: f64) {
  print(x)
  return gParam()
}
function byLet() {
  let x = 2.5
  print(x)
  return gLet()
}
function byNested() {
  function x() { return 7 }
  print(x())
  return gNested()
}
function byBool() {
  const x = true
  print(x)
  return gBool()
}
function byStr() {
  const x = "s"
  print(x)
  return gStr()
}
function byBlock() {
  if true {
    const x = 2.5
    print(x)
    return gBlock()
  }
  return 0
}
function byUfcs() {
  const x = 2.5
  print(x)
  return 5.gUfcs()
}
function byChain() {
  const x = 2.5
  print(x)
  return hChain()
}
function byLambda() {
  const x = 2.5
  const f = () => gLambda()
  print(x)
  return f()
}
function byFnName() {
  const hName = 2.5
  print(hName)
  return gName()
}
function byNestedName() {
  function hNested() { return 2.5 }
  print(hNested())
  return gNestedName()
}
print(byConst())
print(byParam(2.5))
print(byLet())
print(byNested())
print(byBool() + 1)
print(byStr())
print(byBlock())
print(byUfcs())
print(byChain())
print(byLambda())
print(byFnName())
print(byNestedName())
function gConst() { return x }
function gParam() { return x }
function gLet() { return x }
function gNested() { return x }
function gBool() { return x }
function gStr() { return x }
function gBlock() { return x }
function gUfcs(self: i32) { return self + x }
function hChain() {
  const z = 9
  return gChain() + z
}
function gChain() { return x }
function gLambda() { return x }
function gName() { return hName() }
function hName() { return 1 }
function gNestedName() { return hNested() }
function hNested() { return 1 }
