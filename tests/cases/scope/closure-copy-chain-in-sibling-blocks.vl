// @run
// @log 7
// @log loc
// @log 7
// D3632: a call through a copy of a copy (`const g = f`) resolved the copied name without its
// position, so with a same-named `f` in a sibling block, or in a module-scope block, the call
// took the first `f`'s signature and trapped with `indirect call type mismatch`.
function k() { 7 }
function q() { "loc" }
function host() {
  {
    const f = k
    const g = f
    print(g())
  }
  {
    const f = q
    const g = f
    print(g())
  }
}
host()
{
  const f = k
  const g = f
  print(g())
}
