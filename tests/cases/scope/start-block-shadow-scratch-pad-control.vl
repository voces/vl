// @run
// @log xy
// @log 0
// @log 1
// @log one
// The CONTROL for D1595, and the program that identified the missing frame: the same shadowed
// binding with one UNAMBIGUOUS top-level string op beside it.
//
// `const pad = "x" + "y"` names no local, so the scratch detection cannot mis-resolve it — the
// string frame is reserved for the whole start function and the block's `print(n)` finds it.
// This ran before the fix while its sibling `start-block-shadow-scratch-frame.vl` did not, and
// it must keep running: the fix reserves MORE, never less.

const pad = "x" + "y"
print(pad)

for n in 0 to 1 { print(n) }
if true {
  const n = "one"
  print(n)
}
