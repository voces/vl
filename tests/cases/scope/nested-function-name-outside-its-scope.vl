// @run
// @hint redundant type annotation: `s` is inferred as `i32`
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// @log 1
// @log top
// @log 2
// @log 4
// @log 5
// D1969, D3091: a nested function's name read outside its scope named the nested function,
// because the emitter's flat function map holds it. A module global `s` read at the top level
// was lowered against `a`'s nested `s` (an invalid module), and `capRead`'s closure `k` was
// called as `o`'s nested `k`, so `appG`'s lambda found no signature (an emit refusal).
function a() {
  function s(): i32 { return 1 }
  print(s())
}
a()
const s = "top"
print(s)
function o(n) {
  function k(_x: i32) { return n }
  return k(1)
}
print(o(2))
function capRead(x) {
  const y = x
  const k = () => y
  print(k())
}
capRead(4)
function appG<T>(g: () => T): T { return g() }
function viaG(x) { print(appG(() => x)) }
viaG(5)
