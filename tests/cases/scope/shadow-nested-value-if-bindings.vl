// @run
// @log s
// @log 1
// @log 5
// @log s
// @log 8
// @log 5
// @log s
// @log 1
// @log 5
// @warning Unused variable `w` (prefix with `_` to suppress, or remove it)
// @warning Unused variable `w` (prefix with `_` to suppress, or remove it)

// D2385 — three nested bindings of one name, the middle one a value `if` whose own arm binds
// the name again. The scan records a binding before its initializer's, which sit earlier in the
// arena, so each name's rows are sorted before the scope search reads them.

function f9(c: boolean) {
  const w = () => {
    return 2.5
  }
  if c {
    const w = if c {
      const w = () => {
        return "s"
      }
      const r = w()
      print(r)
      () => {
        return 7
      }
    } else {
      () => {
        return 8
      }
    }
    print(1)
  }
  const z = w()
  print(z * 2.0)
}
f9(true)

function f4(c: boolean) {
  const w = () => {
    return 2.5
  }
  if c {
    const w = if c {
      const w = () => {
        return "s"
      }
      const r = w()
      print(r)
      () => {
        return 7
      }
    } else {
      () => {
        return 8
      }
    }
    const q = w()
    print(q + 1)
  }
  const z = w()
  print(z * 2.0)
}
f4(true)

function f11(c: boolean) {
  const w = () => {
    return 2.5
  }
  if c {
    const w = if c {
      const w = () => {
        return "s"
      }
      print(w())
      () => {
        return 7
      }
    } else {
      () => {
        return 8
      }
    }
    print(1)
  }
  print(w() * 2.0)
}
f11(true)
