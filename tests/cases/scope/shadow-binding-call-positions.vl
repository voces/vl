// @run
// @log 4
// @log local
// @log 50
// @log zero
// @log 101
// @log 4
// @log 16
// @log 5
// @log 8
// @log 9
// @log 1.5
// @log 0
// @log 9
// @log 1001
// @log 25
// A call of a name that a parameter, local, loop variable or capture binds is a call of that
// binding even when a module function shares the name; once its block closes, the name is the
// function again. Each position is its own function.

function w() { return 1.5 }
function sq(x: i32) { return x * x }

function asArgument(sq: (x: i32) => i32) { return sq(3) }
print(asArgument((x: i32) => x + 1))

function asReturn() {
  const w = () => "local"
  return w()
}
print(asReturn())

function inBinary() {
  const sq = (x: i32) => x * 10
  return sq(2) + sq(3)
}
print(inBinary())

function inCondition() {
  const sq = (x: i32) => x - 1
  if sq(1) == 0 { return "zero" }
  return "other"
}
print(inCondition())

type Box = { n: i32 }
function inRecordField() {
  const sq = (x: i32) => x + 100
  const b: Box = { n: sq(1) }
  return b.n
}
print(inRecordField())

function inListElement() {
  const sq = (x: i32) => x * 2
  const xs = [sq(1), sq(2)]
  return xs[1]
}
print(inListElement())

function aliasOfFunction() {
  const w = sq
  return w(4)
}
print(aliasOfFunction())

function loopVariable() {
  let t = 0
  for sq in [(x: i32) => x + 1, (x: i32) => x + 2] { t = t + sq(1) }
  return t
}
print(loopVariable())

function throughCapture() {
  const sq = (x: i32) => x + 7
  const g = () => sq(1)
  return g()
}
print(throughCapture())

function afterBlock(c: boolean) {
  if c {
    const w = () => 9.0
    print(w())
  }
  return w()
}
print(afterBlock(true))

type Fa = { sq: (x: i32) => i32 }
type Fb = { k: i32 }
function destructured(u: Fa | Fb) {
  match u {
    Fa{sq} => print(sq(6))
    Fb{k} => print(sq(k))
  }
}
destructured({ sq: (x: i32) => x - 6 })
destructured({ k: 3 })

if true {
  const sq = (x: i32) => x + 1000
  print(sq(1))
}
print(sq(5))
