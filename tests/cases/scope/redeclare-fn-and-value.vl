// @check
// @error redeclared v
// B16 is one binding per name per scope, and a top-level `function` and a top-level
// `let`/`const` are one scope. The two same-kind rules each read their own registry —
// `fnDeclIx` for functions, `moduleGlobals` for values — and neither reads the other, so
// this pair is the one the cross-check owes (D1661).
function v(): i32 { 6 }

const v: (i32) => void = (n: i32) => {
  print(n)
}

v(8)
