// @run
// @log 1
// @log 10
// @log 2
// @log 11
// @log 8
// @log 8
// @log 1
// @log 2
// @hint redundant type annotation: `cA` is inferred as `i32`
// A start-function BLOCK binding shadowed by a module-scope binding of the same name (D1593).
//
// A `const n = f()` inside a top-level block is a START-FUNCTION LOCAL, not a wasm global, so
// `identBoundInFrame` — the D705 guard that keeps a module global from claiming a shadowed
// read — cannot see it. `startBlockLetOfSid` answered by NAME across EVERY top-level statement,
// so a `for n in …` body's read of `n` was handed the union declared in a SIBLING block: `let c
// = n` classified kind-4, the assignment below it boxed an i32 into the box, and `local.set`
// took `(ref $box)` into an i32 slot — `vl check` rc 0, invalid wasm. Met in the wild as
// glean's VL-042.
//
// BOTH FACES: `c` leaves its type to inference, `cA` annotates it — an annotation pins the
// rep, so only the inferred face can show a defect whose ingredient IS inference. Both were
// broken here, because the union came from the INITIALISER's name either way.
//
// The read from INSIDE the block is the other direction and the control the guard must not
// break: there `n` DOES denote the block binding, and narrowing it must still unbox.

type E = { msg: string }

function pick(k: i32): i32 | E {
  if k < 0 { return { msg: "neg" } }
  return k + 7
}

for n in 0 to 1 {
  let c = n
  c = c + 1
  print(c)
  let cA: i32 = n
  cA = cA + 10
  print(cA)
}

if pick(1) is E {
  print(0 - 1)
} else {
  // the covering binding itself: a read from inside its own block still resolves here
  const n = pick(1)
  if n is E { print(0 - 2) } else { print(n) }
  // a second, deeper block re-declaring the same name
  while n == 8 {
    const m = pick(1)
    if m is E { print(0 - 3) } else { print(m) }
    break
  }
}

// CONTROL: the same shapes with no name in common, which ran before the fix and must keep
// running.
for q in 0 to 1 {
  let d = q
  d = d + 1
  print(d)
}
