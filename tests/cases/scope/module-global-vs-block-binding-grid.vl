// @run
// @log 3
// @log 9
// @log 3
// @log 9
// @log 3
// @log 9
// @log 3
// @log 9
// @log 3
// @log 3
// @log 9
// @log 4
// @log 9
// @log 3
// @log outer
// @log 3
// @log 9.5
// @log 3
// @log true
// @log inner
// @log 9
// @log outer
// @log 3
// @log outer
// @log 9
// @log 3
// @log outer
// @hint redundant type annotation: `s` is inferred as `string`
// D1597's POSITION/REP GRID: a module GLOBAL and a same-named binding in a TOP-LEVEL
// BLOCK. A read outside the block denotes the GLOBAL — a start-function local may not
// answer for it, whatever `localNames` says — and a read inside one still denotes the
// block's own binding, which is the direction the fix must not break.
//
// THE AXES, one section each: the block FORM, the binding KEYWORD, the read's POSITION
// (top level vs inside a function), and the REP PAIR — a mixed pair is where the wrong
// slot stops being a wrong number and becomes invalid wasm.
//
// The single-module spelling is the point: with any import the merge mangles top-level
// names per module and the collision cannot form
// (`tests/cases/modules/module-global-shadowed-by-block-binding-cross-module/`).

// ── the block FORM ───────────────────────────────────────────────────────────
if true {
  const n = 3
  print(n)
}

const n = 9
print(n)

let pass = 0
while pass < 1 {
  const n = 3
  print(n)
  pass = pass + 1
}
print(n)

{
  const n = 3
  print(n)
}
print(n)

if true {
  if true {
    const n = 3
    print(n)
  }
}
print(n)

// two sibling blocks binding the same name
if true {
  const n = 3
  print(n)
}
if true {
  const n = 3
  print(n)
}
print(n)

// ── the binding KEYWORD on the block side ────────────────────────────────────
if true {
  let n = 3
  n = n + 1
  print(n)
}
print(n)

// ── the REP PAIRS, one global each, shadowed by a block binding of another rep ─
const s: string = "outer"
const f = 9.5
const b = true
const xs = [9, 8]

if true {
  const s = 3
  print(s)
}
print(s)

if true {
  const f = 3
  print(f)
}
print(f)

if true {
  const b = 3
  print(b)
}
print(b)

if true {
  const xs = "inner"
  print(xs)
}
print(xs[0])

// ── the read INSIDE a function, over both faces of the block's position ──────
function readsGlobal() {
  print(s)
  if true {
    const s = 3
    print(s)
  }
  print(s)
}

function blockAtModuleScope() {
  print(n)
}

readsGlobal()
blockAtModuleScope()

// CONTROL: the same shapes with no name in common, which ran before the fix.
if true {
  const other = 3
  print(other)
}
print(s)
