// @run
// @log 10
// @log 5
// @log 5
// @log 105
// D2480, D2481: a UFCS call resolves where it is written. Inside a lambda after a closed
// block's `const name`, it is the module function, not a capture of the dead local; above a
// later `const name` closure in the same block, it is the module function, not the unset local.
function name(self: i32) { self }
function a() {
  {
    const name = 10
    print(name)
  }
  const f = () => 5.name()
  print(f())
}
function b() {
  print(5.name())
  const name = (self: i32): i32 => self + 100
  print(name(5))
}
a()
b()
