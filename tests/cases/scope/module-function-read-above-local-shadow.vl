// @run
// @warning `over` shadows the function `over` declared at 10:10, which this function calls above it
// @log 7
// @log 5
// D3603: a read of `over` above a block's `const over` reaches the module's function, as it
// does in a single-module program. The `std:math` import makes this a merged compile, whose
// rename treated the `const` as shadowing its whole block and left the earlier calls undeclared.
import { hypotF64 } from "std:math"

function over(x: i32) { x + 1 }
function f(k: i32) {
  let a = 0
  for i in 0 until k { a += over(i) }
  const h = () => over(a)
  const over = 3
  print(h() + over)
  over + hypotF64(3.0, 4.0) as! i32 - 3
}
print(f(2))
