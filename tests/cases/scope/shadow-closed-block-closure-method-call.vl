// @log s
// @log 0.75
// @log s
// @log 0.75
// @hint redundant type annotation: `w` is inferred as `f64`
// @warning Unused parameter `self` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `self` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `self` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `self` (prefix with `_` to suppress, or remove it)

// D2384 — the method-call spelling: `n.w()` is rewritten to a call of the module function
// `w`, whose callee node is minted after the body, so its scope is asked at the call's own
// position. A closed block's closure `w` is not in scope there.

function w(self: i32): f64 { return 1.5 }

function viaBinding(c: boolean) {
  if c {
    const w = (self: i32) => {
      return "s"
    }
    print(w(1))
  }
  const n = 5
  const r = n.w()
  print(r / 2.0)
}
viaBinding(true)

function viaLiteral(c: boolean) {
  if c {
    const w = (self: i32) => {
      return "s"
    }
    print(w(1))
  }
  const r = (5).w()
  print(r / 2.0)
}
viaLiteral(true)

if true {
  const w = (self: i32) => {
    return "s"
  }
  print(w(1))
}
const n = 5
const r = n.w()
print(r / 2.0)
