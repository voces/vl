// @log 8
// @log 40
// @log 9
// @log 15
// @log 22
// A read of a module global above a same-named local `let` in the function's own statement
// list denotes the global, as the checker resolves it; the local takes the name from its
// declaration on, and its own initializer still reads the global (D2664).

type P = { x: i32 }

function seven() { 7 }
function mkP(): P { { x: 7 } }

const n = seven()
const p = mkP()

function f() {
  const a = n
  const n = 2
  return a + n
}

function g() {
  const a = n
  const n = "x"
  print(n)
  return a
}

function h() {
  const n = n + 1
  return n
}

function k() {
  const a = n + 1
  const n = 5
  return a * n
}

function s() {
  const a = p.x
  const p = 2
  return a + p
}

function loop() {
  let t = 0
  let i = 0
  while i < 2 {
    t = t + n
    i = i + 1
  }
  const n = 1
  return t + n
}

function one() {
  const n = 1
  return n
}

function three() {
  const a = n
  const n = 3
  return a * n
}

print(f())
print(g())
print(h())
print(k())
print(s())
print(loop())
print(one() + three())
