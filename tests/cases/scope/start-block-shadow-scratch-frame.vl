// @run
// @log 0
// @log 1
// @log one
// @log 0
// @log hi
// @log 5
// @log hi
// @log 7
// @log 8
// @log two
// @log 0
// @log hi
// @log 0
// @log 1
// @log hi
// Two declared locals of ONE name in one frame, where the SECOND is the one that needs a
// scratch frame (D1595, the detection half of D1593's collision).
//
// The scratch detectors run with the scope stack EMPTY, so `declaredSlotOf` answers a
// shadowed name by a flat first-match scan over `localNames`. Where the first match is the
// `for n` loop variable's i32 slot, `print(n)` over the BLOCK's string binding is not seen as
// a string op at all: the frame goes unreserved and the body then `local.set`s into a local
// the vector never declared — `vl check` rc 0, `unknown local 3` from the engine.
//
// NO UNAMBIGUOUS STRING OP MAY BE ADDED TO THIS FILE. A frame is detected once for the whole
// start function, so a single `const pad = "x" + "y"` anywhere at module scope reserves it and
// every cell below passes on the broken compiler. That control is its own file,
// `start-block-shadow-scratch-pad-control.vl`.

type E = { msg: string }

function mk(): E { return { msg: "hi" } }

// The witness: a module-scope loop variable and a top-level block's `const`, one name.
for n in 0 to 1 { print(n) }
if true {
  const n = "one"
  print(n)
}

// The STRUCT face — the string is a field of the block binding, not the binding itself.
for s in 0 to 0 { print(s) }
if true {
  const s = mk()
  print(s.msg)
}

// No loop variable at all: two SIBLING blocks binding one name. The first-match scan hands
// the second block the FIRST block's i32 slot, so a rule that only skipped loop vars would
// still miss this.
if true {
  const r = 5
  print(r)
}
if true {
  const r = mk()
  print(r.msg)
}

// A for-IN loop variable is the same collision with a different declaration shape.
for e in [7, 8] { print(e) }
if true {
  const e = "two"
  print(e)
}

// A REF-LIST PUSH frame — the same collision in the other clause. The push receiver's element
// type is resolved through the shadowed name too, so this one was a LOUD emit reject
// (`a ref-element list op needs its receiver's element type known before the body is lowered`)
// rather than invalid wasm.
for p in 0 to 0 { print(p) }
if true {
  const p: E[] = []
  p.push(mk())
  print(p[0].msg)
}

// The IN-FUNCTION twin: a user frame's detection is scope-less for the same reason, so the
// collision reaches it too — and D1593's module-scope-only read fix cannot see it.
function go() {
  for n in 0 to 1 { print(n) }
  if true {
    const n = mk()
    print(n.msg)
  }
}

go()
