// @hint redundant type annotation: `a2` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `b2` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `b3` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `p` is inferred as `{x: i32}` — remove it to lean on inference
// @hint redundant type annotation: `ys` is inferred as `i32[]` — remove it to lean on inference
// @hint redundant type annotation: `q` is inferred as `{[string]: i32} | i32` — remove it to lean on inference
// The bare-`Block` census. `drwBareBlock` rewrites `{ … }` into `if true { … }` (D1253), so a
// block node survives only in the passes BEFORE that rewrite; everything after sees an
// `IfStmt`. These pin both halves: the shapes that reach a pre-rewrite ladder, and the ones
// that prove the post-rewrite scans are covered by the rewrite rather than by an arm.
// `scripts/block-census.py` derives the population; the reading is in
// docs/internals/bare-block-census-2026-09.md.

// D1901 — a `return` inside a bare block, at the ANNOTATED face. The un-annotated face and
// the `if true` twin both ran while this was `expected i32, got void`.
function a2(): i32 {
  {
    return 5
  }
}
print(a2())

// The un-annotated face of the same function, which already ran.
function a4() {
  {
    return 5
  }
}
print(a4())

// The `if true` twin — the program `drwBareBlock` turns the two above into.
function b2(): i32 {
  if true { return 5 }
  0
}
print(b2())

// A bare block in NON-tail position, with a value tail after it.
function b3(): i32 {
  {
    print(0)
  }
  5
}
print(b3())

// `criWalkStmt` (`computeRetInference`, a pre-rewrite pass) reaches a bare block: an inferred
// return kind whose `return` sits inside one.
type P = { x: i32 }

function mkP(v: i32): P {
  const p: P = { x: v }
  p
}

function pick() {
  {
    return mkP(5)
  }
}
print(pick().x)

// The post-rewrite scans, one subject each: the loop cursor, a declared local, a ref list, a
// string op and a closure — every one spelled ONLY inside a bare block at module scope.
{
  const xs = [10, 20, 30]
  let t = 0
  for v in xs { t = t + v }
  print(t)
}

{
  const ys: i32[] = [1, 2]
  ys.push(3)
  print(ys.length)
}

{
  const ps: P[] = []
  ps.push({ x: 5 })
  ps.push({ x: 6 })
  print(ps.length)
  print(ps[1].x)
}

{
  print("x" + "y")
}

{
  const f = (a: i32) => a * 2
  print(f(21))
}

// A block nested in a block, and one inside a function — neither is module scope, which is
// what D1900's ablation separated from the module-block family.
{
  {
    const q: { [string]: i32 } | i32 = mkP7()
    if q is { [string]: i32 } { print(q.size) } else { print(7) }
  }
}

function mkP7(): { [string]: i32 } | i32 { 7 }

function go() {
  {
    const w = 9
    print(w)
  }
}
go()
