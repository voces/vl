// @run
// @log 7
// @log 7
// @log 8
// @log 7
// @log 7
// @log 8
// @log 7
// @log 7
// @log 0
// @log 1
// @log 7
// @log 0
// @log hi
// @log 1.5
// @log 7
// @log 2
// @log b
// @log 5
// @log 7
// @log 7
// @log hi
// @log 2
// @log 7
// @hint redundant type annotation: `sh` is inferred as `string`
// @hint redundant type annotation: `sh` is inferred as `i32`
//
// A module-scope global SHADOWED by a binding inside a function. The checker resolves the
// reference to the inner binding; every emit-side classifier resolved it through the module
// NAME table instead, so `print` (and every other rep-keyed sink) chose its arm from the
// GLOBAL's type while the operand came from the local's slot — check-clean INVALID WASM
// whenever the two reps differed (D705). `identBoundInFrame` asks the frame first.
//
// THE ARMS ARE THE STORAGE CLASS of the shadowing binding and the DELIVERY POSITION of its
// value: the fault was in name resolution, not in any rep ladder — a local, a param, a
// block local, a loop variable and a capture were all wrong the same way;
// `gRev`/`gRename`/`gGlobalRead` are the controls that already ran.
//
// BOTH FACES: `gAnn` annotates the shadowing binding; `gInt` and every un-annotated RETURN
// leave it to inference — a face `computeRetInference` reaches with `localNames` still empty.

const sh: string = "hi"

// the global itself still reads as a string everywhere it is NOT shadowed
function shLen() { sh.length }

// un-annotated and annotated faces of the same shadow
function gInt() {
  const sh = 7
  print(sh)
}
function gAnn() {
  const sh: i32 = 7
  print(sh)
}

// the delivery positions of the shadowing local's value
function gPlus() {
  const sh = 7
  sh + 1
}
function takeI32(v: i32) { v }
function gArg() {
  const sh = 7
  takeI32(sh)
}
function gField() {
  const sh = 7
  const o = { r: sh }
  o.r
}
function gCapture() {
  const sh = 7
  const f = () => sh + 1
  f()
}
function gAssign() {
  const sh = 7
  let t = 0
  t = sh
  t
}

// the storage class of the shadowing binding: a PARAM, a block local, a loop variable,
// and a capture read from inside the lambda
function gParam(sh: i32) { print(sh) }
function gBlock(n: i32) {
  if n > 0 {
    const sh = 7
    print(sh)
  }
}
function gLoopVar() {
  for sh in 0 to 1 { print(sh) }
}
function gCapRead() {
  const sh = 7
  const f = () => {
    print(sh)
    return 0
  }
  f()
}

// the OTHER direction of the rep pair, and five more pairs
function gRev() {
  const sh = "hi"
  print(sh)
}
function gF64() {
  const sh = 1.5
  print(sh)
}
function gI64() {
  const sh: i64 = 7
  print(sh)
}
function gList() {
  const sh = [1, 2]
  print(sh[1])
}
function gStrList() {
  const sh = ["a", "b"]
  print(sh[1])
}
function gMap() {
  const sh = Map()
  sh["k"] = 5
  print(sh["k"] ?? 0)
}
function gStruct() {
  const sh = { r: 7 }
  print(sh.r)
}

// CONTROLS that already ran before the fix and must keep running
function gRename() {
  const other = 7
  print(other)
}
function gGlobalRead() { print(sh) }

gInt()
gAnn()
print(gPlus())
print(gArg())
print(gField())
print(gCapture())
gParam(7)
gBlock(1)
gLoopVar()
print(gCapRead())
gRev()
gF64()
print(gAssign())
gList()
gStrList()
gMap()
gStruct()
gRename()
gGlobalRead()
print(shLen())
gI64()
