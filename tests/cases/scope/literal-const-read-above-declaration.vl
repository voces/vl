// @run
// @log 4
// @log 3000000000
// @log 4294967295
// @log 3000000000
// @log 4294967295
// @hint redundant type annotation: `useKAbove` is inferred as `i64` — remove it to lean on inference
// @hint redundant type annotation: `useKBelow` is inferred as `i64` — remove it to lean on inference
// A read of a literal `const` is its literal wherever it stands, so a read above the
// declaration, at the top level or in a function written above it, takes the same value as
// one below (D3246).
print(K + 1)
function useKAbove(): i64 { K * 1000000000 }
function useBAbove(): i64 { B }
const K = 3
const B = 0xFFFFFFFF
function useKBelow(): i64 { K * 1000000000 }
function useBBelow(): i64 { B }
print(useKAbove())
print(useBAbove())
print(useKBelow())
print(useBBelow())
