// @run
// @log 2.5
// @log 2
// @log 2.5
// @log 3
// @log 2.5
// @log 1
// @log 2.5
// @log 5
// @log 2.5
// @log 7
// @log 2.5
// @log 8
// @log 2.5
// @log d
// @log 2.5
// @log 10
// @log 2.5
// @log 11
// @log 5
// @log 12
// @warning `p` shadows the `p` declared at
// @info `r` is never reassigned; use `const` instead of `let`
// @info `b` is never reassigned; use `const` instead of `let`
// A `for … in` loop variable of another type beside a same-named module `let` or parameter:
// outside the loop every read and write of the name denotes that binding, not the dead loop
// variable (D9751).
type Box = { n: i32 }

// The filed witness: `=` at module scope.
let w = 1
w = 2
for w in [2.5] { print(w) }
print(w)

// `+=` and `++`, before and after the loop.
let c = 1
c += 1
for c in [2.5] { print(c) }
c++
print(c)

// A read alone, with no assignment.
let r = 1
for r in [2.5] { print(r) }
print(r)

// The assignment in a nested block and in a function.
let nb = 1
for nb in [2.5] { print(nb) }
if true { nb = 5 }
print(nb)
let fv = 1
function bump() { fv = fv + 6 }
for fv in [2.5] { print(fv) }
bump()
print(fv)

// A field of the shadowed name, and a list-typed binding.
let b: Box = { n: 1 }
for b in [2.5] { print(b) }
b.n = 8
print(b.n)
let l = ["a", "b"]
for l in [2.5] { print(l) }
l = ["c", "d"]
print(l[1])

// A parameter, and a loop inside a function over a module binding.
function param(p: i32) {
  for p in [2.5] { print(p) }
  p = p + 9
  print(p)
}
param(1)
let g = 1
function loopOver() {
  for g in [2.5] { print(g) }
  g = g + 10
  print(g)
}
loopOver()

// Control: a loop variable of the same type.
let s = 1
for s in [5] { print(s) }
s = 12
print(s)
