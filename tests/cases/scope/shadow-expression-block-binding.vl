// @run
// @log 9
// @log top
// @log 9
// @log top
// @log top
// @log 9
// @log 6
// @log top
// @log s4
// @log c2
// @hint redundant type annotation: `w` is inferred as `string`
// @hint redundant type annotation: `returned` is inferred as `i32`
// @hint redundant type annotation: `six` is inferred as `i32`

// D2385 — a binding inside a block that is an EXPRESSION (a value `if` arm, a `match` arm)
// shadows a module function inside that block only: its own call is the closure's, and a
// call after the block is the module function's again. D2039 is a payload `match` over such
// a binding.

function w(): string { return "top" }

function valueIf(c: boolean) {
  const r = if c {
    const w = () => {
      return 8
    }
    w() + 1
  } else {
    0
  }
  print(r)
  print(w())
}
valueIf(true)

function matchArm(k: i32) {
  const r = match k {
    1 => {
      const w = () => {
        return 8
      }
      w() + 1
    }
    _ => 0
  }
  print(r)
  print(w())
}
matchArm(1)

function returned(c: boolean): i32 {
  print(w())
  return if c {
    const w = () => {
      return 8
    }
    w() + 1
  } else {
    0
  }
}
print(returned(true))

function loopVarInArm(k: i32) {
  const r = match k {
    1 => {
      let s = 0
      for w in [1, 2, 3] { s = s + w }
      s
    }
    _ => 0
  }
  print(r)
  print(w())
}
loopVarInArm(1)

type Ci = { r: i32 }
type Sq = { s: i32 }
type Sh = Ci | Sq
function payload(u: Sh, b: boolean) {
  const res = if b {
    const m = u
    match m {
      Ci{r} => "c\{r}"
      Sq{s} => "s\{s}"
    }
  } else {
    "no"
  }
  print(res)
}
payload({ s: 4 }, true)
function six(): i32 { 6 }
function shape(): Sh { return { r: 2 } }
function nested() {
  const res = match six() {
    6 => match shape() {
      Ci{r} => "c\{r}"
      Sq{s} => "s\{s}"
    }
    _ => "no"
  }
  print(res)
}
nested()
