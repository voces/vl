// @check
// @error `b` is used before it is assigned
// A module-level `const` is in the temporal dead zone until pass 2 reaches its
// initializer, exactly like a `let`: having an initializer does not make it
// assigned at a point the initializer has not run yet. A `const` whose value is a
// bare literal has no dead zone, since each read is that literal
// (literal-const-read-above-declaration.vl).
function two(): i32 { 2 }
const a = b + 1
const b = two()
print(a)
