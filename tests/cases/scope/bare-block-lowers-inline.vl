// @run
// @log if-true
// @log top
// @log 2
// @log 10
// @log 126
// @log 33
// @log a72.5
// A bare `{ … }` and a written `if true` lower inline, with no wasm frame (D2335): an exit
// inside one, a `break` or `continue` from one, a shadowing block inside another, and
// sibling blocks binding one name at three types all keep their meaning.

function early(a: i32) {
  {
    const m = a + 1
    if m > 5 { return m }
  }
  {
    const m = a * 2
    return m
  }
}

function noTail(a: i32) {
  let acc = a
  {
    const m = acc + 1
    acc = acc * m
  }
  {
    const m = acc + 2
    {
      const m = 100
      acc = acc + m
    }
    acc = acc + m
  }
  {
    return acc
  }
}

function loopy(n: i32) {
  let s = 0
  let i = 0
  while true {
    {
      const k = i * 3
      s = s + k
    }
    {
      if i >= n { break }
    }
    {
      i = i + 1
      if i == 2 { continue }
    }
    {
      s = s + 1
    }
  }
  s
}

function strs() {
  const parts: string[] = []
  {
    const p = "a"
    parts.push(p)
  }
  {
    const p = 7
    parts.push("\{p}")
  }
  {
    const p = 2.5
    parts.push("\{p}")
  }
  parts[0] + parts[1] + parts[2]
}

if true { print("if-true") }
{
  const t = "top"
  print(t)
}
print(early(1))
print(early(9))
print(noTail(3))
print(loopy(4))
print(strs())
