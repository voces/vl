// @run
// @log 1
// @log 8

// @hint redundant type annotation: `v` is inferred as `i32`
// @hint redundant type annotation: `v` is inferred as `(i32) => void`

// B16 allows nested shadowing, and these are the controls for the same-scope rule its
// sibling fixture pins: a function body and a module-scope BLOCK are each a scope of their
// own, so a binding of the module function's name there shadows rather than redeclares.

function v(): i32 { 6 }

function inFrame() {
  const v = 1

  print(v)
}

inFrame()

if true {
  const v: (i32) => void = (n: i32) => {
    print(n)
  }

  v(8)
}
