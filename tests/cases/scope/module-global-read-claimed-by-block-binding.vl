// @emit-error emitProgram: field access receiver is not a struct
// D1597 — A MODULE GLOBAL AND A SAME-NAMED BINDING IN A TOP-LEVEL BLOCK ARE ONE SLOT.
// Every module's top-level statements are lowered into one start function, so a `const`
// written inside a top-level block is a start-function LOCAL. Wasm locals are
// FUNCTION-scoped and VL's module top level is LEXICALLY scoped, so the read below —
// outside the block, of the module global — is claimed by the block's local.
//
// This file pins the LOUD face. The same collision at a numeric global is a check-clean
// SILENTLY WRONG VALUE (`scripts/capability-probes/module-global-read-claimed-by-block-binding.vl`),
// and struct-on-struct is check-clean invalid wasm (`uninitialized local: 0`).
//
// THE CONTROL IS A SECOND MODULE: `tests/cases/modules/module-global-shadowed-by-block-binding-cross-module/`
// is this program with one import added, and it runs and prints the right values. The
// module merge mangles TOP-LEVEL names per module (`n` -> `n$m1`) and leaves block-local
// ones alone, so the collision only exists in a program with no imports at all — which is
// why every cross-module fixture in the tree missed it.
//
// When it is fixed this file prints `hi` then `9`: flip the directive to `@run` and add
// the two `@log` lines.
if true {
  const n = "hi"
  print(n)
}

const n = { base: 9 }
print(n.base)
