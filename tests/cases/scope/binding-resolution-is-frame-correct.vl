// @run
// @log 9
// @log 2
// @log z
// @log 1.5
// @log 3
// @log 4
// @log 100
// @log 7
// @log 12
// Binding resolution is frame-correct by three separate routes, and this is the pin that
// says so: `localNames` is per function, `paramTypeNode` reads its own frame, `identBoundInFrame` vetoes.

type S = { a: i32 }

function mkS(): S { return { a: 9 } }

// Three frames binding `v`, at four reps across two monomorphized instances.
function o(n) {
  const v = n
  return v
}

function p(n) {
  const v = n
  return v
}

print(o(mkS()).a)
print(o(2))
print(p("z"))
print(p(1.5))

// Two locals of the SAME name at different reps in ONE frame, in sibling blocks.
function siblingBlocks(pick: boolean) {
  if pick {
    const w = 3
    return w
  }
  const w = "four"
  return w.length
}

print(siblingBlocks(true))
print(siblingBlocks(false))

// A module global shadowed only inside a nested block: the veto is live-scope aware.
const g = 7

function blockShadow(pick: boolean) {
  if pick {
    const g = 100
    return g
  }
  return g
}

function nestedBlockShadow() {
  let total = 0
  if true {
    const g = 5
    total = total + g
  }
  total = total + g
  return total
}

print(blockShadow(true))
print(blockShadow(false))
print(nestedBlockShadow())
