// @log 1.5
// @log 1.25
// @log 6
// @log 2.5
// @log 2.5
// @log b
// @log 2.5
// @log b
// @log 1.5
// @log b
// @log 1.5
// @log a
// @log a
// @log 2.5
// @log b
// @log 1.5
// @log x
