// @log 41
// @log nope
// @log 2
// @log 1
// @log hello
// @log 1
// @log 2
// @log 2
// @log 2
// @warning `a` shadows the `a` declared at
// @hint redundant type annotation: `v15` is inferred as `i32[]`
// A module binding read through an un-annotated alias, `const v = w`, where the reader's frame
// holds a same-named local `w`: the alias denotes the module `w` the resolver bound it to, at
// every scope and kind, and the local denotes itself (D9681).
type P = { x: i32, y: string }
type Q = { q: f64 }

// The filed witness: the local's initializer reads the alias.
const w = [1, 2]
const v = w
if true {
  const w = v[1]
  print(w)
}

// A function body and a function-local alias.
const w2 = [3, 4]
const v2 = w2
function body() {
  const w2 = v2[1]
  print(w2)
}
body()
function local() {
  const a = [3, 4]
  const b = a
  if true {
    const a = b[1]
    print(a)
  }
}
local()

// The local is another kind than the module binding.
const w3 = ["a", "b"]
const v3 = w3
if true {
  const w3 = [1.5, 2.5]
  print(v3[1])
  print(w3[0] + 0.0 == 1.5)
}
const w4 = Map<string, string>()
w4["k"] = "val"
const v4 = w4
if true {
  const w4 = [7, 8]
  print(v4["k"] ?? "none")
  print(w4[0])
}
const w5: P = { x: 3, y: "why" }
const v5 = w5
if true {
  const w5 = "shadow"
  print(v5.y)
  print(w5)
}
const w6 = [3, 4]
const v6 = w6
function mapLocal() {
  const w6 = Map<string, f64>()
  w6["a"] = 1.5
  print(v6[0])
  print(w6["a"] ?? 0.0)
}
mapLocal()

// Same kind, another rep: a record and a map of another value type.
const w7: P = { x: 3, y: "why" }
const v7 = w7
if true {
  const w7: Q = { q: 1.25 }
  print(w7.q)
  print(v7.x * 2)
}
const w8 = Map<string, f64>()
w8["k"] = 0.25
const v8 = w8
if true {
  const w8 = Map<string, i32>()
  w8["k"] = 41
  print((v8["k"] ?? 0.0) * 10.0)
}

// A `let`, a loop body, a bare block, a nested function, a parameter and a loop variable.
const w9 = ["a", "b"]
let v9 = w9
v9 = w9
for i in 0 to 0 {
  const w9 = [1.5]
  print(w9[0] + 1.0)
  print(v9[1])
}
{
  const w9 = [2.5]
  print(w9[0])
  print(v9[1])
}
function outer() {
  function inner() {
    const w9 = [1.5]
    print(w9[0])
    print(v9[1])
  }
  inner()
}
outer()
function param(w9: f64[]) {
  print(w9[0])
  print(v9[0])
}
param([1.5])
for w9 in [2.5] {
  print(v9[0])
  print(w9)
}
let k = 0
while k < 1 {
  const w9 = [1.5]
  print(v9[1])
  print(w9[0])
  k = k + 1
}

// A list of a union, read through the alias, with a list local.
type A = { a: i32 }
type B = { b: string }
const w10: (A | B)[] = [{ a: 1 }, { b: "x" }]
const v10 = w10
if true {
  const w10 = [9]
  const e = v10[1]
  if e is B { print(e.b) }
  print(w10[0])
}

// A local map shadowing a map of another value type, both read.
const w11 = Map<string, i32>()
w11["k"] = 41
const v11 = w11
if true {
  const w11 = Map<string, string>()
  print(v11["k"] ?? 0)
  print(w11["k"] ?? "nope")
}

// A nested list, and the shadow's initializer reading its own outer name.
const w12 = [[1, 2], [3, 4]]
const v12 = w12
if true {
  const w12 = v12[0]
  print(w12[1])
}
const w13 = [1, 2]
if true {
  const w13 = w13[0]
  print(w13)
}

// A start-block binding shadowed in a nested block, and a chain of aliases.
if true {
  const s = "hello"
  const t = s
  if true {
    const s = [1, 2]
    print(t)
    print(s[0])
  }
}
const w14 = [1, 2]
const u14 = w14
const v14 = u14
if true {
  const w14 = v14[1]
  const u14 = w14
  print(u14)
}

// Controls: the alias annotated, and the local renamed.
const w15 = [1, 2]
const v15: i32[] = w15
if true {
  const w15 = v15[1]
  print(w15)
}
const w16 = [1, 2]
const v16 = w16
if true {
  const z16 = v16[1]
  print(z16)
}
