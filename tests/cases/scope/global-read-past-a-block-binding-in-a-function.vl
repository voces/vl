// @run
// @log 3
// @log 7
// @log 3
// @log hi
// @log 7
// @log hi
// @log true
// @log 7
// @log true
// @log 9
// @log 7
// @log 9
// @log 7
// @log 3
// @hint redundant type annotation: `g` is inferred as `i32`
// @hint redundant type annotation: `gs` is inferred as `string`
// D1304 — the FUNCTION-scope face of D1597: a module global read from a frame that binds
// the same name inside a BLOCK the read is not inside. `localNames` holds every declared
// local of a function whatever block declared it, so the flat registry scan handed the
// read a binding that is out of scope — before the block (never entered) and after it
// (already closed) alike. `hi`/`true` are the mixed-rep faces, where the wrong slot was
// invalid wasm rather than a wrong number.
//
// The in-block read is the direction the fix must not break: there the name DOES denote
// the block's own binding, so each `leg` prints the block's value in the middle.

const g: i32 = 3
const gs: string = "hi"
const gb = true
const gl = [9, 8]

function legI32() {
  print(g)
  if 1 > 0 {
    const g = 7
    print(g)
  }
  print(g)
}

function legStr() {
  print(gs)
  if 1 > 0 {
    const gs = 7
    print(gs)
  }
  print(gs)
}

function legBool() {
  print(gb)
  if 1 > 0 {
    const gb = 7
    print(gb)
  }
  print(gb)
}

function legList() {
  print(gl[0])
  if 1 > 0 {
    const gl = 7
    print(gl)
  }
  print(gl[0])
}

// CONTROL: a block binding with no global of its name, read from inside its own block.
function legControl() {
  if 1 > 0 {
    const only = 7
    print(only)
  }
  print(g)
}

legI32()
legStr()
legBool()
legList()
legControl()
