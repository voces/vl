// @run
// @log 1
// @log 2
// @log 2
// @log 2
// @log 30
// @log 5
// D3608 in a merged compile, which a module import makes: the merge shadowed a block-local
// function's name over its whole block, so the call above it named a function the checker
// could not find. And a block-local `abs` stood in for the builtin inside `std:math`, whose
// own `abs` call reached it through the flat function map (an invalid module).
import { hypotF64 } from "std:math"

function k() { 1 }
function f(t: boolean) {
  print(k())
  function k() { 2 }
  print(k())
  if t {
    function abs(x: i32) { x * 10 }
    print(k())
  }
  print(k() + abs(0))
}
f(true)
function g() {
  function abs(x: i32) { x * 10 }
  print(abs(3))
}
g()
print(hypotF64(3.0, 4.0))
