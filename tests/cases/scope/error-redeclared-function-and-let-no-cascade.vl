// @error-at 5:16 redeclared outLen
// @info `outLen` is never reassigned; use `const` instead of `let`
// diderven DV-401 — a module `let` and a function of one name are one refusal. A read of the
// name could mean either, so it is that refusal's cascade: no second "expected i32, got () => i32".
let outLen = 0
export function outLen(): i32 { outLen }
