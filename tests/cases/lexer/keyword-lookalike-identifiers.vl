// @run
// @log 39
// @log 5
// Near-miss identifiers for every KEYWORD BUCKET. `keywordKind` dispatches on the
// first character (and, for the two-character `if`/`is` pair, the second), so the
// hazard it introduces is a LOOKALIKE — a name that shares a bucket with a keyword
// and must still lex as `IDENT`. One or more per bucket, including the boundary
// lengths (1 character, and 9 — one past the longest keyword `function`/`continue`),
// both two-character `i` names that are not `if`/`is`, and a name for every keyword
// that differs only by a suffix or a missing final character.
//
// The keywords THEMSELVES are covered by every other file in the corpus (and by the
// compiler's own source through the fixpoint ladder); what nothing else pins is that
// `iff`, `typ`, `trues` and their 30-odd siblings are still ordinary identifiers.
const i = 1
const ix = 1
const iff = 1
const isx = 1
const imp = 1
const imports = 1
const fo = 1
const fors = 1
const fun = 1
const functions = 1
const functional = 1
const falsey = 1
const cons = 1
const constant = 1
const continues = 1
const els = 1
const elses = 1
const exports = 1
const typ = 1
const types = 1
const tru = 1
const trues = 1
const ret = 1
const returns = 1
const le = 1
const lets = 1
const whil = 1
const whiles = 1
const awai = 1
const awaits = 1
const brea = 1
const breaks = 1
const matc = 1
const matches = 1
const nul = 1
const nulls = 1
const zz = 1
const q = 1
const ii = 1
print(
  i +
    ix +
    iff +
    isx +
    imp +
    imports +
    fo +
    fors +
    fun +
    functions +
    functional +
    falsey +
    cons +
    constant +
    continues +
    els +
    elses +
    exports +
    typ +
    types +
    tru +
    trues +
    ret +
    returns +
    le +
    lets +
    whil +
    whiles +
    awai +
    awaits +
    brea +
    breaks +
    matc +
    matches +
    nul +
    nulls +
    zz +
    q +
    ii,
)
// The lookalikes must also survive as FUNCTION and PARAMETER names, which is the
// other position `keywordKind`'s verdict reaches.
function typ2(iff: i32, typ: i32) {
  if iff > typ { return iff }
  typ
}
function whiles2(nul: i32) {
  let matc = 0
  for k in 0 to nul { matc = matc + 1 }
  matc
}
print(typ2(2, 1) + whiles2(2))
