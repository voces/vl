// @run
// @log N
// @log N
// @log N
// @log N
// @log N
// @log N
// @log V
// @log 5
// @log N
// @log N
// A kind-18 NULLABLE REF-ARRAY *local* (or param) accepts `null` by ASSIGNMENT.
//
// `emitAssign`'s LOCAL arm seeds a bare-`null` RHS for four niches (nullable bool /
// string / closure / i32-list, then struct / distinct-backing scalar list / map) but
// never for the kind-18 ref array, so `g = null` over `let g: i32[][] | null` reached
// `emitNullLitNode` with no context and rejected the whole module — `vl check` clean,
// `emitProgram: bare null needs a struct-typed context`. The same binding INITIALIZED
// to `null`, and the same cell as a module GLOBAL, both lowered fine.
//
// The split is the ELEMENT's rep, not the nesting: every REF element was broken
// (`i32[]`, `string[]`, `S`, `S[]`, a niche-nullable `S | null`) while the SCALAR-element
// lists — `i32[] | null`, `f64[] | null`, `string | null` — all ran, because those are
// the `exprNullableList` / `exprNulScalarListKind` seeds already in the ladder. The two
// scalar rows at the end are the control that pins them still working behind the new arm.

type S = { v: i32 }

function nested() {
  let g: i32[][] | null = [[1, 2]]
  g = null
  if g == null { print("N") } else { print("V") }
}
nested()

function nestedStr() {
  let g: string[][] | null = [["a"]]
  g = null
  if g == null { print("N") } else { print("V") }
}
nestedStr()

function structElem() {
  let g: S[] | null = [{ v: 3 }]
  g = null
  if g == null { print("N") } else { print("V") }
}
structElem()

function structArrElem() {
  let g: S[][] | null = [[{ v: 3 }]]
  g = null
  if g == null { print("N") } else { print("V") }
}
structArrElem()

function nicheElem() {
  let g: (S | null)[] | null = [{ v: 3 }]
  g = null
  if g == null { print("N") } else { print("V") }
}
nicheElem()

// A PARAM cell takes the same arm (`localIndexOf` resolves params first), and its inner
// wrapper is resolved from the annotation rather than the local slot.
function paramCell(p: S[] | null) {
  p = null
  if p == null { print("N") } else { print("V") }
}
paramCell([{ v: 3 }])

// A live element still reads back through the re-assigned cell. The non-null direction is
// observed through a `T | null` PARAMETER: assigning a list NARROWS the binding to
// non-null, so a direct `g == null` after it is a checker reject.
//
// (The seed is armed only when the RHS IS a bare `null` — the seed-leak gate. Its witness,
// a list-literal RHS whose ELEMENT is null, cannot be an `@run` row here: `g = [null]` over
// a LOCAL is an independent open reject, because the local assign arm seeds no list
// kind/slot at all. That gap is filed at `emitAssign`'s local arm; the gate is what keeps
// this fix from turning that clean reject into invalid wasm.)
function obStruct(x: S[] | null) {
  if x == null { print("N") } else { print("V") }
  if x != null { print(x[0].v) }
}
function reassignLive() {
  let g: S[] | null = null
  g = [{ v: 5 }]
  obStruct(g)
}
reassignLive()

// CONTROL — the SCALAR-element lists, which always worked, still do.
function flatScalar() {
  let g: i32[] | null = [1, 2]
  g = null
  if g == null { print("N") } else { print("V") }
}
flatScalar()

function flatStr() {
  let g: string[] | null = ["a"]
  g = null
  if g == null { print("N") } else { print("V") }
}
flatStr()
