// @check
// @error `y` is used before it is assigned
// Two uninitialized bindings live at once, and the one that is written is not the
// most recent: assigning `x` must drop `x` alone, leaving `y` still unassigned so
// the later read of `y` is the error and the read of `x` is not.
function f(): i32 {
  let x: i32
  let y: i32
  x = 1
  print(x)
  return y
}
print(f())
