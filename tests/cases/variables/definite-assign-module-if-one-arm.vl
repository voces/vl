// @check
// @error `m` is used before it is assigned
// A module-level `if` forks and joins the module's OWN dead zone, which holds every top-level
// binding until pass 2 reaches its initializer — the widest set the join ever sees. One arm
// assigning is not every surviving path assigning, so the read below is still an error.
let m: i32
if 1 > 0 { m = 1 }
print(m)
