// @run
// @log 4
// @hint redundant type annotation: `inner` is inferred as `i32`
// @hint redundant type annotation: `outer` is inferred as `i32`
// A nested function body is its own flow context — it runs at call time, not at the
// declaration site — so reading an outer binding that is still unassigned where the
// nested function is DECLARED is sound, and the call happens after the write.
function outer(): i32 {
  let x: i32
  function inner(): i32 { x }
  x = 4
  return inner()
}
print(outer())
