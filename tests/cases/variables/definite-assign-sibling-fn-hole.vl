// @check
// @error `y` is used before it is assigned
// Two sibling bodies declare the same name and the FIRST leaves it unassigned to the
// end. Each body is its own flow context, so the first body's hole must not be visible
// as the second's — if it were, the second's own hole would look already recorded and
// its read would go unreported.
function first(): i32 {
  let y: i32
  return 0
}
function second(): i32 {
  let y: i32
  return y
}
print(first() + second())
