// @run
// @log 6
// @hint redundant type annotation: `inner` is inferred as `i32`
// @hint redundant type annotation: `f` is inferred as `i32`
// A function declared INSIDE an `if` arm opens its own flow frame in the middle of that arm's
// fork. Closing the frame must restore the arm's own live set and nothing else — otherwise the
// arm's delta against the fork point is read against the wrong set and the join answers for a
// binding neither arm touched.
function f(c: boolean): i32 {
  let x: i32
  if c {
    x = 5
    function inner(): i32 { x + 1 }
    return inner()
  } else {
    x = 2
  }
  return x
}
print(f(true))
