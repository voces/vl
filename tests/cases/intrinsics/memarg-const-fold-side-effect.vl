// @run
// @log 42
// @log 1
// A side-effecting bounded part (D2368/D2369): the declaration-time fold tees the ALREADY-
// computed bounded value into its scratch local rather than re-evaluating it at each address
// use, so `bump()` still runs exactly once even though the address it feeds is read twice
// below (a store and a load).
const D = 1024
let calls = 0
function bump() {
  calls = calls + 1
  calls
}
function f() {
  const p = D + (bump() & 1023) * 8
  __store_i64__(p, 42)
  (__load_i64__(p) as% i32)
}
print(f())
print(calls)
