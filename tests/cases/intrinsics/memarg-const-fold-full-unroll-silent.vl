// @run
// @log 1012
// SILENT WRONG VALUE before the fix, with no diagnostic at all: `maFoldRowOf`'s linear scan
// returns the FIRST row for a re-emitted declaration, so a later `const q` bound to the SAME
// address family read the stale scratch slot the loop's single trip left behind instead of
// its own freshly-computed value (master/expected 1012; the bug printed 2020).
const D = 1024
function f(xs: i32[]) {
  let s = 0
  for i in 0 to 1 {
    const p = D + (i & 255) * 8
    __store_i64__(p, (i + 1) as i64)
  }
  const q = D + (xs[0] & 255) * 8
  s = (__load_i64__(q) as% i32)
  s * 1000 + (__load_i64__(D) as% i32) * 10 + (__load_i64__(D + 8) as% i32)
}
print(f([0]))
