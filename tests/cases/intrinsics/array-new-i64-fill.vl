// @run
// @log 3
// @log 7
// @log 2.5
// CONTRACT (D963): `__array_new__` with an i64 fill builds the i64 list. The refusal that
// stood here was a clause-2 violation whose STATED REASON had gone stale: it read "No i64[] /
// f32[] backing exists yet (only i32/f64/string/ref lists), so an i64 / f32 fill would
// otherwise store into the i32 backing and emit INVALID wasm". The i64 pair
// (`ia64TypeIdx`/`il64TypeIdx`) is interned exactly like the f64 pair the arm above it uses,
// and `i64[]` lists lower and run — so the sentence described a tree that no longer existed.
//
// Three sites, mirroring the f64 fill exactly: `arrNewIntrKind` gains kind 4, the collector
// marks `ia64Used`, and the emitter picks the i64 backing/wrapper.
//
// The f32 guard that stood beside it is gone too (D1673). What differed is that the emitter
// had no f32 arm to reach: D1470 built one for `__array_new_default__` and left the fill's
// guard standing above it. `array-new-f32-fill.vl` is that column.
const v: i64 = 7

const xs = __array_new__(3, v)

print(xs.length)
print(xs[1])

// the f64 sibling, unchanged
const fs = __array_new__(2, 2.5)

print(fs[0])
