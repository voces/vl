// @run
// @log 11
// @log 11
// @log 22
// @log 22
// An i64 address narrowed with `as%` wraps at 32 bits like an i32 one. From p = 2^32 - 4,
// `(p + 8) as% i32` is address 4, so the load reads what was stored there; only a build that
// promises `--low-memory-unused` may move the 8 into the memarg, where the access would trap.
__store_i64__(16, 4294967292 as i64)
__store_i32__(4, 11)
const p = __load_i64__(16)
print(__load_i32__((p + 8) as% i32))
print(__load_i32__((p + 4 + 4) as% i32))
__store_i32__((p + 12) as% i32, 22)
print(__load_i32__(8))
const q = p as% i32
print(__load_i32__(q + 12))
