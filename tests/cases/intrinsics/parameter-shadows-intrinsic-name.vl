// @run
// @log 779
// @log 2
// @log 4
// A PARAMETER whose spelling is an emitter intrinsic, and which is CALLED. `emitCall`
// matched the SPELLING before any declaration lookup — exactly the hazard
// `nameIsEmitterIntrinsic`'s own header describes ("a user `function __fs_read__(…)` would
// be silently discarded and every call to it would become a syscall") — so the emitter
// lowered `memory.grow` and the user's parameter was never called (D1087).
//
// THIS WAS A CHECK-CLEAN SILENTLY WRONG ANSWER, not merely a refusal. `run` below printed
// `1` (the previous page count) instead of `779`, and the disassembled body was
// `(memory.grow (i32.const 1))`. `__memory_size__` was the LOUDER instance of one defect —
// `__memory_size__ takes no arguments`, about a parameter the checker had just typed at
// arity 1 — and the names whose arity HAPPENS to match the intrinsic's are the silent ones.
//
// THE FIX IS IN CALLEE POSITION, NOT AT THE BINDING, and `closures/capture-local-named-like-
// builtin.vl` is why: it deliberately PINS a parameter named `__load_i32__` as legal VL, and
// states the rule this follows — *"A name denotes instructions only where it is being
// CALLED."* Reserving every binding form would have broken that fixture, and it is right: an
// intrinsic-spelled name that is never called denotes nothing. So the eleven intrinsic
// dispatch arms now ask the SCOPE (`identNameIsUserBound`), which is the same test
// `userOwnsName` already made for the six builtin names (D975, "a user function of the same
// name wins") — asked of the frame rather than of the function table, because a parameter is
// in neither.
//
// The checker's reservation on `function` / `const` / `let` of an intrinsic name is
// UNCHANGED (`error-redefine-intrinsic.vl`, `error-redefine-intrinsic-binding.vl`): those
// forms really are redefinitions, and a parameter is not.
function run(__memory_grow__: (i32) => i32) { return __memory_grow__(1) }

function go() {
  const k = 778
  return run((n: i32) => {
    return n + k
  })
}

// The LOUD half of the same dispatch: an arity that does NOT match the intrinsic's.
function sized(__memory_size__: (i32) => i32) { return __memory_size__(1) }

// A memory intrinsic still lowers where nothing binds the name — the guard admits exactly
// the call sites it used to reach.
function realGrow() {
  const before = __memory_size__()
  __memory_grow__(2)
  return __memory_size__() - before + 2
}

print(go())
print(
  sized((n: i32) => {
    return n + 1
  }),
)
print(realGrow())
