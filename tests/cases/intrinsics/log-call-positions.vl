// @run
// @log 7
// @log 9
// @log 11
// @log 13
// `__log__` reads tag/value pairs from memory (tag 0 is a plain i32): called as a statement in a
// function, in an `if` arm, in a loop, with computed operands, and at module scope.
function put(at: i32, v: i32) {
  __store_i32__(at, 0)
  __store_i32__(at + 4, v)
}
function one(v: i32) {
  put(0, v)
  __log__(0, 8)
}
function arm(c: boolean) {
  put(16, 9)
  if c { __log__(16, 8) } else { __log__(0, 0) }
}
function loop(n: i32) {
  for i in 0 until n {
    put(32, 11 + i * 2)
    __log__(32 + 0 * i, 4 + 4)
  }
}
one(7)
arm(true)
loop(1)
put(48, 13)
__log__(48, 8)
