// @run
// @log 42
// @log 1234605616436508552
// @log 1.5
// @log 2.5
// @log -56
// @log 200
// @log -25536
// @log 40000
// @log 7
// @log -2
// @log 0.25
// @log 0.5
// @log -1
// @log 255
// @log -1
// @log 65535
// @log 99
// @log 99
// @log 5
// @log 6
// @log 5
// @log 77
// The offset form of every scalar load and store: `__load_<w>__(p, off)` and
// `__store_<w>__(p, off, v)` write `off` into the instruction's memarg, so the effective
// address is `p + off` computed without wrapping. Each value is written through one spelling
// and read back through the other, so a wrong offset shows as a wrong value.
const FIELD = 16
function roundTrip(p: i32) {
  __store_i32__(p, FIELD, 42)
  __store_i64__(p, 8, 0x1122334455667788)
  __store_f64__(p, 24, 1.5)
  __store_f32__(p, 32, 2.5 as f32)
  __store_i8__(p, 36, 200)
  __store_i16__(p, 38, 40000)
  print(__load_i32__(p + 16))
  print(__load_i64__(p + 8))
  print(__load_f64__(p + 24))
  print(__load_f32__(p + 32))
  print(__load_i8__(p + 36))
  print(__load_u8__(p + 36))
  print(__load_i16__(p + 38))
  print(__load_u16__(p + 38))
  __store_i32__(p + 40, 7)
  __store_i64__(p + 48, -2)
  __store_f64__(p + 56, 0.25)
  __store_f32__(p + 64, 0.5 as f32)
  __store_i8__(p + 68, 255)
  __store_i16__(p + 70, 65535)
  print(__load_i32__(p, 40))
  print(__load_i64__(p, 48))
  print(__load_f64__(p, 56))
  print(__load_f32__(p, 64))
  print(__load_i8__(p, 68))
  print(__load_u8__(p, 68))
  print(__load_i16__(p, 70))
  print(__load_u16__(p, 70))
}
roundTrip(1024)

// The offset may be as large as the memory: here it names the last byte of the one page, from
// address 0 and from address 1 with the offset one smaller.
__store_i8__(0, 65535, 99)
print(__load_u8__(1, 65534))
print(__load_u8__(65535))

// A constant address, and a constant plus a masked index, fold into the offset; the value
// read is the same either way.
__store_i32__(2048, 5)
__store_i32__(2060, 6)
print(__load_i32__(2048 + 0))
function pick(x: i32) { __load_i32__(2048 + (x & 3) * 4) }
print(pick(7))
print(pick(4))

// An add whose operand is not provably small keeps its i32 wrap: 0x1FFFFFFF * 8 + 12 wraps to
// address 4, and the load reads it rather than trapping at 2^32 + 4.
__store_i32__(4, 77)
function wrapRead(x: i32) { __load_i32__(x * 8 + 12) }
print(wrapRead(0x1FFFFFFF))
