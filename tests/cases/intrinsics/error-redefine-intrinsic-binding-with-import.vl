// @check
// @error '__trap__' is a compiler intrinsic and cannot be redefined
// The import face of error-redefine-intrinsic-binding.vl (D2263): a module-level `const` of an
// intrinsic's name is refused whether or not the program imports anything.
import { hypotF64 } from "std:math"

const __trap__ = (x: i32) => x + 1
print(__trap__(4))
print(hypotF64(3.0, 4.0))
