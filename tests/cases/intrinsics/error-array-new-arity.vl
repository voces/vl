// @check
// @error __array_new__ expects 2 arguments, got 1
// @error cannot infer a type for 'xs' — an empty array literal has no element type until it is used; use it where its type is known, or annotate the binding (`const xs: i32[] = []`)
// `__array_new__` takes exactly (length, fill): a missing fill is an arity
// error, and with no fill the element type is also uninferable.
const xs = __array_new__(3)
print(xs.length)
