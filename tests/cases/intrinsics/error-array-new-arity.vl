// @check
// @error __array_new__ expects 2 arguments, got 1
// @warning the element type of 'xs' is never fixed by any write, so it is always empty — give it its type where it is built if a write was meant
// `__array_new__` takes exactly (length, fill): a missing fill is an arity
// error, and with no fill nothing fixes the element type, which the warning names.
const xs = __array_new__(3)
print(xs.length)
