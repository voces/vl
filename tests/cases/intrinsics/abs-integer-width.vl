// @run
// @log 193
// @log 2
// @log 9000000000
// @log -2147483648
// @log -9223372036854775808
// @log 2.5
// @log 0.5
// @log 1.5
// @log once
// @log 4
// @log 1
// @log 1.5
// `abs` keeps an integer operand's width, as `min` and `max` do: `abs(i32): i32`,
// `abs(i64): i64` (D3563, sunpa SP-017). It used to widen to f64, so an i32 accumulator could
// not take it and an integer `/` after it divided as floats. The one negative value with no
// positive counterpart wraps, as `0 - x` does. A literal argument adapts to its destination.
const v = 200
let s = 0
s += abs(v - 7)
print(s)
const n = -5
print(abs(n) / 2)
const big = -9000000000
print(abs(big))
const imin = -2147483647 - 1
print(abs(imin))
const lmin = -9223372036854775807 - 1
print(abs(lmin))
print(abs(-2.5))
const g: f32 = -0.5
print(abs(g))
const lit: f64 = abs(-3)
print(lit / 2.0)
function once() {
  print("once")
  -4
}
print(abs(once()))
function k(x) { abs(x) }
print(k(-3) / 2)
print(k(-3.0) / 2)
