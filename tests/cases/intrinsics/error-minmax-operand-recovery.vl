// @check
// @error-at 11:14 undeclared identifier 'zzz'
// @error-at 18:19 undeclared identifier 'yyy'
// @error-at 24:17 undeclared identifier 'www'
// @error-at 29:42 min expects i32, got boolean
// @error-at 29:46 operator '!' expects boolean, got i32
// @error-at 33:12 sqrt expects 1 argument, got 2
// An operand an earlier diagnostic refused takes no part in a numeric intrinsic's width: the
// call computes at what its other operands give, so the only error is the operand's own.
// A non-numeric operand is refused at that width, and a wrong-arity call yields no width.
function undeclared(n: i32): i32 {
  let k = min(zzz, n - 1)
  if k >= 2 { k += 1 }
  return k
}
print(undeclared(4))

function wide(n: i64): i64 {
  const k = max(n, yyy)
  return k
}
print(wide(4))

function narrowFloat(x: f32): f32 {
  const k = sqrt(www) + x
  return k
}
print(narrowFloat(4.0))

function notNumeric(n: i32): i32 { return min(!n, n) }
print(notNumeric(4))

function arity(n: i32): i32 {
  const k = sqrt(n, n)
  return k
}
print(arity(4))
