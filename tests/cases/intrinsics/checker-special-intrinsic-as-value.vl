// @run
// @log hi
// @log 10
// @log q
// @log 4
// @log 6
// @log 1.5
// @log end
// The checker-special intrinsics whose type a parameter closes are function values too:
// `__array_new__` and `__array_copy__` stay generic in their element type, and `__trap__` takes
// its message unless the destination takes no argument.
function app(f: (n: i32, x: i32) => i32[]) { f(4, 2).length }
const sb = __str_from_bytes__
const bs: u8[] = [104, 105, 33]
print(sb(bs, 0, 2))
const an = __array_new__
const a = an(3, 7)
print(a[2] + a.length)
print(an(2, "q")[1])
print(app(__array_new__))
const cp = __array_copy__
const d = [0, 0, 0]
cp(d, 1, [5, 6], 0, 2)
print(d[2])
const cpf: (d: f64[], a: i32, s: f64[], b: i32, n: i32) => void = __array_copy__
const e = [0.5, 0.5]
cpf(e, 0, [1.5], 0, 1)
print(e[0])
const t0: () => never = __trap__
const t1 = __trap__
if e.length > 5 { t0() }
if e.length > 5 { t1("unreached") }
print("end")
