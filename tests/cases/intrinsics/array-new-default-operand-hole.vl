// @info `a` is never reassigned; use `const` instead of `let`
// @info `a` is never reassigned; use `const` instead of `let`
// @info `a` is never reassigned; use `const` instead of `let`
// @info `b` is never reassigned; use `const` instead of `let`
// @info `a` is never reassigned; use `const` instead of `let`
// @info `a` is never reassigned; use `const` instead of `let`
// @info `a` is never reassigned; use `const` instead of `let`
// @info `a` is never reassigned; use `const` instead of `let`
// The `let` spelling is DECLARED rather than swapped for `const`: the witness this fixture
// pins is a `let`, and rewriting it would grade a program the defect was never filed against.
// An OPERATOR over an element of an unpinned `__array_new_default__`. The element is a hole
// until something pins it, and a hole nothing pins takes the `i32` default at the scope FLUSH,
// after the body is checked — so every operator arm saw the in-band `-1` an open element reads
// back as and indexed `T.tys` with it: an out-of-bounds read that TRAPPED the compiler on a
// program whose `let a: i32[]` face already printed `1`. The operand now PEEKS the default it
// is entitled to, leaving the row open so a later store still decides it. D1566.
function lhs() {
  let a = __array_new_default__(3)
  print(a[0] + 1)
}
lhs()
function rhs() {
  let a = __array_new_default__(3)
  print(1 + a[0])
}
rhs()
function alias() {
  let a = __array_new_default__(3)
  let b = a
  print(b[0] + 1)
}
alias()
function negate() {
  let a = __array_new_default__(3)
  print(-a[0])
}
negate()
function compare() {
  let a = __array_new_default__(3)
  print(a[0] < 1)
}
compare()
function widen() {
  let a = __array_new_default__(3)
  print(a[0] + 1.0)
}
widen()
print(__array_new_default__(3)[0] + 1)
function coalesce() {
  let a = __array_new_default__(3)
  print(a[0] ?? 1)
}
coalesce()
// THE TWO ORDERING CONTROLS, and they are what make the peek a peek. A LATER store still
// decides the element — pinning `i32` at the read instead made this pair `cannot assign f64 to
// i32` — and an EARLIER store is untouched, which is the constraint the `-1` guard below the
// `=` arm rides (a guard above it would delete the index-write inference and print `1`).
function storeAfter() {
  let a = __array_new_default__(3)
  print(a[0] + 1)
  a[0] = 1.5
  print(a[0])
}
storeAfter()
const early = [0]
early[0] = 5
print(early[0] + 1)
function earlyIntrinsic() {
  let a = __array_new_default__(3)
  a[0] = 5
  print(a[0] + 1)
}
earlyIntrinsic()
