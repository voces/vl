// @run
// @log 7
// A folded `const` address read by a v128 store and load: both take the declaration's scratch
// local and the folded offset, as the scalar accesses do.
const D = 1024
function f(x: i32): i32 {
  const p = D + (x & 1023) * 16
  __store_v128__(p, __splat_i32x4__(7))
  return __extract_lane_i32x4__(__load_v128__(p), 2)
}
print(f(37))
