// @run
// @log 2
// @log 7.75
// @log 7.75
// @log 7.75
// @log 7.75
// @hint redundant type annotation: `annotated` is inferred as `f32[]`
// @hint redundant type annotation: `pinned` is inferred as `f32[]`
// CONTRACT (D1673): `__array_new__` with an f32 fill builds the f32 list at every spelling —
// an annotated `f32[]` destination, an INFERRED binding, and a generic instance whose fill is
// the substituted parameter. `exprF32Array` lacked the `__array_new__` arm its i64/f64/string/
// ref siblings carry, so an inferred binding held an i32 cell over the f32 backing; and
// `arrNewKindOfElemVKind` excluded `f32` by hand, so the pin named no kind at all.
//
// Every read adds a fraction, so a list built at the i32 backing cannot pass.
function anfMk(): f32 { 7.5 }

const annotated: f32[] = __array_new__(2, anfMk())

print(annotated.length)
print(annotated[1] + 0.25)

// the inferred face: nothing but the fill and the intrinsic names the rep
const inferred = __array_new__(2, anfMk())

print(inferred[0] + 0.25)

function anfPick<T>(v: T): T[] {
  const out = __array_new__(2, v)
  return out
}

const pinned: f32[] = anfPick(anfMk())

print(pinned[1] + 0.25)

// the same pin with the destination un-annotated
const pinnedInferred = anfPick(anfMk())

print(pinnedInferred[0] + 0.25)
