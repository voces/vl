// @run
// @log 556
// The mix kernel's real pattern: ONE `const p` declaration read at TWO memory-intrinsic call
// sites — a store, then a load of what was just stored. Both uses read the same
// declaration-time scratch local, so a wrong slot or a stale value shows up as
// a wrong number here, not just a wrong offset byte.
const D = 1024
function f(x: i32) {
  const p = D + (x & 1023) * 8
  __store_i64__(p, 555)
  const v = __load_i64__(p)
  __store_i64__(p, v + 1)
  (__load_i64__(p) as% i32)
}
print(f(9))
