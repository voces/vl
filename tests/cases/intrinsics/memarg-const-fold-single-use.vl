// @run
// @log 555
// A local `const` address bound once and read once — the vs-rust `mix` kernel's own shape
// (D2368/D2369): `emitMemAddr` sees only the expression written INSIDE the call, so binding
// the address to a name first used to keep the fold from firing. The declaration now tees the
// bounded part into its own scratch local, so this reads exactly like the inline spelling.
const D = 1024
function f(x: i32) {
  const p = D + (x & 1023) * 8
  __store_i64__(p, 555)
  (__load_i64__(p) as% i32)
}
print(f(37))
