// @run
// @log 1122
// @log 2222
// @log 30
// Two folded `const` addresses in one function each keep their own scratch slot: a store through
// one and a read through the other name different cells, and a loop re-builds its fold each trip.
const D = 1024
function two(x: i32, y: i32) {
  const p = D + (x & 1023) * 8
  const q = D + (y & 1023) * 8
  __store_i64__(p, 11)
  __store_i64__(q, 22)
  return (__load_i64__(p) as% i32) * 100 + (__load_i64__(q) as% i32)
}
function loop(n: i32) {
  let s = 0
  for i in 0 to n {
    const p = D + (i & 1023) * 8
    __store_i64__(p, (i * 2) as i64)
    s = s + (__load_i64__(p) as% i32)
  }
  return s
}
print(two(1, 2))
print(two(3, 3))
print(loop(5))
