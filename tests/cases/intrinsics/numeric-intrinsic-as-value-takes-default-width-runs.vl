// @run
// @log 4
// @log 3
// @log 31
// @log 2
// @log 3
// @log true
// A width-generic numeric intrinsic named as a value reads a wrapper at its family's default
// width, f64 for the float intrinsics and i32 for the integer ones (D2621).
const g = sqrt
print(g(16.0))
print([4.0, 9.0].map(sqrt)[1])
function app(h: (i32) => i32, x: i32): i32 { h(x) }
print(app(clz, 1))
function mk(): (f64) => f64 { floor }
print(mk()(2.5))
type B = { h: (f64, f64) => f64 }
const b: B = { h: max }
print(b.h(1.0, 3.0))
const cmp = ltU
print(cmp(1, -1))
