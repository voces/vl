// @run
// @log 12345
// A fully-unrolled constant-range loop (PL-037 item 3, `emitRangeUnrolled`) re-emits the same
// `const p = …` LetDecl once per trip. The scratch slot the declaration-time fold tees into
// must belong to the DECLARATION, not to each emission — an earlier version claimed a fresh
// slot per trip although only one was ever reserved, invalid wasm ("unknown local") once
// there was more than one trip.
const D = 1024
function f() {
  let s = 0
  for i in 0 to 4 {
    const p = D + (i & 255) * 8
    __store_i64__(p, (i + 1) as i64)
    s = s * 10 + (__load_i64__(p) as% i32)
  }
  s
}
print(f())
