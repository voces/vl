// @trap memory access out of bounds
// The fold must not change WHICH addresses trap: `D` alone is one page past this module's one
// page of memory, so `D + (x & 0) * 8` — always exactly `D` — traps whether or not the const
// binding's own address folds into the memarg offset.
const D = 65536
function f(x: i32) {
  const p = D + (x & 0) * 8
  (__load_i64__(p) as% i32)
}
print(f(0))
