// @run
// @log none
// @log 0
// @log s
// @log b
// @log 7
// @log none
// @log 9
// A fill legacy boxes into a union element, or a `null` fill at a nullable element, built in a
// function, a loop body, a returned list, a module binding read in a function, and a record field.
function names(n: i32): (string | null)[] {
  const xs: (string | null)[] = __array_new__(n, null)
  return xs
}
print(names(2)[1] ?? "none")
for k in [1] {
  const ys: (i32 | string)[] = __array_new__(k + 1, 0)
  ys[1] = "s"
  print(ys[0])
  print(ys[1])
}
function strs(): (i32 | string)[] { return __array_new__(1, "b") }
print(strs()[0])
const ns: (i32 | null)[] = __array_new__(2, 7)
function firstN() { return ns[0] ?? -1 }
print(firstN())
type Bag = { items: (string | null)[], nums: (i32 | string)[] }
const bag: Bag = { items: __array_new__(1, null), nums: __array_new__(1, 9) }
print(bag.items[0] ?? "none")
print(bag.nums[0])
