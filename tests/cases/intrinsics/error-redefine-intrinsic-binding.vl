// @check
// @error '__store_i32__' is a compiler intrinsic and cannot be redefined
// CONTRACT (must-error): the same reservation for the BINDING spelling — a `const`
// holding a lambda is called through the emitter's inline arm exactly like the
// `function` spelling, so the lambda never runs. A nested `function` of a reserved name
// is covered by the same site (`checkFuncDeclNode` sees top-level and nested alike).
const __store_i32__ = (a: i32, b: i32) => a + b
print(__store_i32__(1, 2))
