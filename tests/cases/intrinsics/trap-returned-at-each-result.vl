// @run
// @log 7
// A returned `__trap__()` is the trap, then a dead `return`: an unset hook's default, at each
// result a hook can have. Only the replaced hooks run.
type Pt = { x: i32, y: i32 }
function unsetI(): i32 { return __trap__() }
function unsetL(): i64 { return __trap__() }
function unsetF(): f64 { return __trap__() }
function unsetS(): string { return __trap__("unset") }
function unsetB(): boolean { return __trap__() }
function unsetP(): Pt { return __trap__() }
function unsetU(): i32 | string { return __trap__() }
function unsetN(): string | null { return __trap__() }
function unsetA(): i32[] { return __trap__() }
export let hookI: () => i32 = unsetI
export let hookL: () => i64 = unsetL
export let hookF: () => f64 = unsetF
export let hookS: () => string = unsetS
export let hookB: () => boolean = unsetB
export let hookP: () => Pt = unsetP
export let hookU: () => i32 | string = unsetU
export let hookN: () => string | null = unsetN
export let hookA: () => i32[] = unsetA
function seven() { return 7 }
hookI = seven
print(hookI())
