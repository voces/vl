// @check
// @error `mk` builds its type parameter's list here: __array_new_default__ fills every slot with the element's default value, and string has none — use __array_new__(n, fill)
// CONTRACT (must-error): an instance of a generic `__array_new_default__` whose element has no
// default is refused at the call, as the direct spelling is at its own (D2578).
function mk<T>(n: i32, _seed: T): T[] {
  const xs: T[] = __array_new_default__(n)
  return xs
}
print(mk(2, 1.5).length)
print(mk(2, "x").length)
