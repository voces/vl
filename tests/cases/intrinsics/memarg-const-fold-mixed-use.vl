// @run
// @log 1841
// `p` used as BOTH a memory-intrinsic address and an ordinary integer value:
// the address use folds into the offset, but `p`'s own local still holds its full `K +
// bounded` value for the plain read — folding must never change what a non-address use sees.
const D = 1024
function f(x: i32) {
  const p = D + (x & 1023) * 8
  __store_i64__(p, 777)
  const v = __load_i64__(p)
  (v as% i32) + p
}
print(f(5))
