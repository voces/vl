// @check
// @error __load_i64__ takes its offset (argument 2) as a compile-time integer in 0..4294967295
// The offset is the instruction's memarg immediate, so it must be known at compile time: a
// literal, or a top-level `const` bound to one. A runtime value belongs in the address.
function read(p: i32, off: i32) { __load_i64__(p, off) }
print(read(0, 8))
