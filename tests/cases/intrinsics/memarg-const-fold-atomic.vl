// @run
// @log 14
// @log 9
// A folded `const` address read by atomics: each takes the declaration's scratch local and the
// folded offset, as the scalar accesses do. The address stays aligned for every width.
const D = 1024
function f(x: i32) {
  const p = D + (x & 1023) * 8
  __atomic_store_i32__(p, 9)
  print(__atomic_rmw_add_i32__(p, 5) + 5)
  return __atomic_load_i32__(p) - 5
}
print(f(37))
