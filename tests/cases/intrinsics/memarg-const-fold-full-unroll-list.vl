// @run
// @log 604468
// The same fully-unrolled re-emission as `memarg-const-fold-full-unroll.vl`, with a list read
// inside the loop and two more folded reads AFTER the loop — proving the reused scratch slot
// left by the LAST trip does not leak into unrelated later folds of the same declaration name.
const D = 1024
function f(xs: i32[]) {
  let s = 0
  for i in 0 to 2 {
    const p = D + (i & 255) * 8
    __store_i64__(p, (xs[i] + 1) as i64)
    s = s * 10 + (__load_i64__(p) as% i32)
  }
  s + __load_i32__(D) * 1000 + __load_i32__(D + 8) * 100000
}
print(f([3, 5, 7]))
