// @run
// @log 1234567
// A VARIABLE-trip range loop (#3129's 4x partial unroll, `emitForRangeCopies`-shaped): the
// trip count is not a compile-time constant, so the body is copied 4 at a time with a rolled
// remainder — a second re-emission mechanism for the same `LetDecl`, on top of the fully
// constant-unrolled case `memarg-const-fold-full-unroll.vl` covers. 7 trips exercises one
// batch of 4 copies plus a 3-trip rolled remainder, so both re-emission paths run.
const D = 1024
function f(n: i32) {
  let s = 0
  for i in 0 to n {
    const p = D + (i & 255) * 8
    __store_i64__(p, (i + 1) as i64)
    s = s * 10 + (__load_i64__(p) as% i32)
  }
  s
}
print(f(6))
