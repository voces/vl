// @error cannot be named as a value: its element type comes only from the destination
// `__array_new_default__`'s element type is fixed only by where its result lands, which no
// parameter of a value can bind, so it is refused as a value, as a generic function is whose
// type parameter only its return type names.
function app(f: (n: i32) => i32[]): i32 { f(2).length }
print(app(__array_new_default__))
