// @run
// @log 41
// @log 41
// @log 42
// @log v41
// @log h41
// @log 41
// @log 41
// @log 41
// @log 41
// @log 41
// A load through a folded `const` address, its value delivered to each position: the fold's local
// and offset name the cell the store wrote.
type R = { v: i32 }
const D = 1024
function prep(x: i32) { __store_i32__(D + (x & 255) * 4, 41) }
function sink(n: i32) { print(n) }
function sinkU(u: i32 | string) { print(u) }
function add(a: i32, b: i32) { return a + b }
function id(n: i32) { return n }
function pick(n: i32 | null) { return n }
function argScalar(x: i32) {
  const p = D + (x & 255) * 4
  sink(__load_i32__(p))
}
function argUnion(x: i32) {
  const p = D + (x & 255) * 4
  sinkU(__load_i32__(p))
}
function argNested(x: i32) {
  const p = D + (x & 255) * 4
  print(add(1, id(__load_i32__(p))))
}
function concat(x: i32) {
  const p = D + (x & 255) * 4
  print("v" + "\{__load_i32__(p)}")
}
function hole(x: i32) {
  const p = D + (x & 255) * 4
  print("h\{__load_i32__(p)}")
}
function ret(x: i32) {
  const p = D + (x & 255) * 4
  return __load_i32__(p)
}
function letInit(x: i32) {
  const p = D + (x & 255) * 4
  const v = __load_i32__(p)
  print(v)
}
function ifArm(x: i32, c: boolean) {
  const p = D + (x & 255) * 4
  const y = if c { __load_i32__(p) } else { 0 }
  print(y)
}
function coalesce(x: i32) {
  const p = D + (x & 255) * 4
  print(pick(null) ?? __load_i32__(p))
}
function field(x: i32) {
  const p = D + (x & 255) * 4
  const r: R = { v: __load_i32__(p) }
  print(r.v)
}
prep(7)
argScalar(7)
argUnion(7)
argNested(7)
concat(7)
hole(7)
print(ret(7))
letInit(7)
ifArm(7, true)
coalesce(7)
field(7)
