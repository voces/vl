// @run
// @log 4252703
// `for x in xs` over a hoisted list backing gets the same 4x partial unroll (#3129,
// `emitForInCopies`) as a variable-trip range loop — a THIRD re-emission mechanism for the
// same `LetDecl`. 7 elements exercises one batch of 4 copies plus a 3-element rolled
// remainder walk, so both re-emission paths run against the same scratch slot.
const D = 1024
function g(xs: i32[]) {
  let s = 0
  for x in xs {
    const p = D + (x & 255) * 8
    __store_i64__(p, (x + 1) as i64)
    s = s * 10 + (__load_i64__(p) as% i32)
  }
  s
}
print(g([3, 1, 4, 1, 5, 9, 2]))
