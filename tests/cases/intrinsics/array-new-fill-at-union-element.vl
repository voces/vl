// @run
// @log 2
// @log a
// @log none
// @log 0
// @log s
// @log 7
// @log -1
// @log 2.5
// @log q
// @log 1
// A scalar, string or `null` fill is built at the union or nullable element its destination
// names, as a literal of the same value is (D16887).
const xs: (string | null)[] = __array_new__(2, null)
print(xs.length)
xs[0] = "a"
print(xs[0] ?? "none")
print(xs[1] ?? "none")
const ys: (i32 | string)[] = __array_new__(2, 0)
ys[1] = "s"
print(ys[0])
print(ys[1])
const ns: (i32 | null)[] = __array_new__(3, 7)
ns[2] = null
print(ns[0] ?? -1)
print(ns[2] ?? -1)
const fs = __array_new__(1, 2.5)
print(fs[0] ?? 0.0)
const ss = __array_new__(1, "q")
print(ss[0] ?? "none")
function mk(n: i32): (i32 | string)[] { return __array_new__(n, 1) }
print(mk(2)[1])
