// @run
// @log 333
// An inner block's `const p` shadows the outer one: the fold is resolved by the
// LIVE emission scope (the same slot rung a shadowed name always resolves through), so each
// binding gets its own scratch local and its own K — mixing them up would read one binding's
// bytes through the other's offset.
const D = 1024
const D2 = 2048
function f(x: i32, y: i32) {
  const p = D + (x & 1023) * 8
  __store_i64__(p, 111)
  let inner = 0
  if x > 0 {
    const p = D2 + (y & 1023) * 8
    __store_i64__(p, 222)
    inner = (__load_i64__(p) as% i32)
  }
  (__load_i64__(p) as% i32) + inner
}
print(f(3, 9))
