// @run
// @log 3
// @log 5000000001
// @log 2.5
// @log false
// @log 0.5
// @log 2
// @log 3
// @log true
// @log 9
// @log <2>
// @log 5000000000!
// One-instruction intrinsics whose i32 operand is widened to the operation's kind (`ltU` and
// `popcnt` at i64, `sqrt` and `min` at f64, `floor` at f32), each delivered to a position: a
// `return`, a nested call, a `let`, an `if` arm, a `??` operand, a union parameter, a record
// field, an interpolation hole and a concat operand.
import { toString } from "std:fmt"

function id(x: i64) { return x }
function show(u: f64 | string) {
  if u is f64 { print(u) } else { print(u) }
}
function viaReturn(a: i64, k: i32) { return popcnt(a & 0) + popcnt(k) + 1 }
function nested(a: i64, k: i32) { print(id(id(a + popcnt(k) - 1))) }
function viaLet(x: f64, k: i32) {
  const v = min(x, k)
  print(v)
}
function ifArm(c: boolean, a: i64, k: i32) {
  print(if c { ltU(a, k) } else { ltU(k, a) })
}
function atUnion(k: i32) { show(sqrt(k) / 4.0) }
function coalesce(m: Map<string, f32>, k: i32) { print(m["k"] ?? floor(k)) }
function field(x: f64, k: i32) {
  const r = { n: min(x, k) * 2.0 }
  print(r.n)
}
function both(a: i64, k: i32) { print(ltU(k, a) == true) }
function interp(x: f64, k: i32) { print("<\{min(x, k)}>") }
function concat(a: i64, k: i32) { print(toString(max(a, k)) + "!") }
print(viaReturn(5 as i64, 3))
nested(5000000000 as i64, 3)
viaLet(2.5, 7)
ifArm(true, 5 as i64, 2)
atUnion(4)
coalesce(Map(), 2)
field(1.5, 3)
both(5000000000 as i64, 1)
print(max(9, 2) * 1)
interp(9.5, 2)
concat(5000000000 as i64, 1)
