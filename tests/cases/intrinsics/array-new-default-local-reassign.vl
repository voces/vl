// @run
// @log 1.5
// @log 3.5
// @log 0
// Two `__array_new_default__` calls that meet at a PLAIN `=` into an inferred `let`. Neither
// row is pinned where it is checked, so the assignment records a hole LINK and a later store
// resolves only ONE of the pair; the other used to take the `i32` default and hand an i32
// backing to an f64 slot — check-clean invalid wasm. Every store here comes AFTER the
// reassignment, because the intrinsic writes zeros and `0` reads the same off either
// backing: a proof that stores first passes on the miscompile. D1512.
function local() {
  let v = __array_new_default__(3)
  v = __array_new_default__(3)
  v[0] = 1.25
  print(v[0] + 0.25)
}
local()
let g = __array_new_default__(2)
g = __array_new_default__(2)
g[1] = 3.5
print(g[1])
print(g[0])
