// @check
// @error-at 5:33 undeclared identifier 'round' — the rounding intrinsics are `nearest` (half to even), `floor`, `ceil` and `trunc`
// @error-at 8:33 undeclared identifier 'Math' — VL has no `Math` namespace; the math intrinsics are bare calls, as in `sqrt(x)`, `floor(x)`, `nearest(x)` and `min(a, b)`
// `round` and the `Math` namespace are other languages' spellings: the undeclared-name report
// names the rounding intrinsics, or says the math intrinsics are bare calls.
function r(u: f64): f64 { return round(u) }
print(r(2.5))

function m(u: f64): f64 { return Math.floor(u) }
print(m(2.5))
