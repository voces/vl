// @run
// @log 3
// @log 7
// @log 9
// @log 4
// @log 5
// @log 2!
// @log <8>
// @log -3
// @log 6
// @log 12
// @log 1
// @log 10
// @log 5000000000
// @log 5000000001
// @log 5000000001
// @log 7
// @log 7
// The integer `abs`, `min` and `max`, which lower to a select over a signed compare, delivered to
// each position: a scalar and a union parameter, a nested call, a concat operand, an
// interpolation hole, a `return`, a `let`, an `if` arm, a `??` operand and a record field, at
// i32 and at i64, with an i32 operand widened into an i64 one.
import { toString } from "std:fmt"

type R = { n: i32 }
function id(x: i32) { return x }
function show(u: i32 | string) {
  if u is i32 { print(u) } else { print(u) }
}
function atScalar(a: i32, b: i32) { print(id(min(a, b))) }
function atUnion(a: i32, b: i32) { show(max(a, b)) }
function nested(a: i32) { print(id(id(abs(a)))) }
function viaReturn(a: i32, b: i32) { return max(min(a, b), 4) }
function viaLet(a: i32) {
  const v = abs(a)
  print(v)
}
function concat(a: i32, b: i32) { print(toString(min(a, b)) + "!") }
function interp(a: i32, b: i32) { print("<\{max(a, b)}>") }
function ifArm(c: boolean, a: i32, b: i32) {
  const v = if c { min(a, b) } else { max(a, b) }
  print(v)
}
function coalesce(m: Map<string, i32>, a: i32) { print(m["k"] ?? abs(a)) }
function field(a: i32, b: i32) {
  const r: R = { n: max(a, b) }
  print(r.n)
}
function negAbs(a: i32) { return abs(a) - abs(a + a) }
function wide(a: i64, b: i64) {
  print(max(a, b))
  print(abs(a + 1))
}
function widened(a: i64, k: i32) {
  print(min(a, k))
  const w: i64 = max(k, 2)
  print(w)
}
atScalar(3, 8)
atUnion(2, 7)
nested(-9)
print(viaReturn(1, 9))
viaLet(-5)
concat(2, 5)
interp(8, -1)
ifArm(true, -3, 4)
ifArm(false, -3, 6)
field(12, 3)
print(negAbs(-1) + 2)
coalesce(Map(), -10)
wide(5000000000 as i64, -2 as i64)
print(abs(-5000000001 as i64))
widened(4999999999 as i64, 7)
