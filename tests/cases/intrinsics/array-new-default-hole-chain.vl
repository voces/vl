// @run
// @log 1.5
// @log 1.5
// @log 1.5
// @log 0
// @log 1.5
// @info `a` is never reassigned; use `const` instead of `let`
// @info `a` is never reassigned; use `const` instead of `let`
// @info `ma` is never reassigned; use `const` instead of `let`
// A CHAIN of `__array_new_default__` holes linked by plain `=`. The link consult used to be
// ONE HOP, and the flush walks pending bindings in DECLARATION order, so the head of a chain
// was asked before its partner had resolved and took the `i32` default under an `f64` tail —
// check-clean invalid wasm at three holes and above. Every store comes AFTER the last link,
// because the intrinsic writes zeros and `0` reads the same off either backing: a proof that
// stores first passes on the miscompile. D1565.
function chain3() {
  let a = __array_new_default__(3)
  let b = __array_new_default__(3)
  let c = __array_new_default__(3)
  b = a
  c = b
  c[0] = 1.25
  print(c[0] + 0.25)
}
chain3()

function chain4() {
  let a = __array_new_default__(3)
  let b = __array_new_default__(3)
  let c = __array_new_default__(3)
  let d = __array_new_default__(3)
  b = a
  c = b
  d = c
  d[0] = 1.25
  print(d[0] + 0.25)
}
chain4()

// A CYCLE, which the fixpoint must terminate on rather than treat as a special case: pinned
// (the propagation stops when nothing moves) and unpinned (nothing moves at all, so every row
// takes the `i32` default and agrees with itself).
function cycle3() {
  let a = __array_new_default__(3)
  let b = __array_new_default__(3)
  let c = __array_new_default__(3)
  b = a
  c = b
  a = c
  c[0] = 1.25
  print(c[0] + 0.25)
}
cycle3()

function cycleOpen() {
  let a = __array_new_default__(3)
  let b = __array_new_default__(3)
  let c = __array_new_default__(3)
  b = a
  c = b
  a = c
  print(a[0])
}
cycleOpen()

// The MODULE-SCOPE spelling of the three-chain, which failed with the nullable global slot's
// own sentence and is the same mechanism.
let ma = __array_new_default__(3)
let mb = __array_new_default__(3)
let mc = __array_new_default__(3)
mb = ma
mc = mb
mc[0] = 1.25
print(mc[0] + 0.25)
