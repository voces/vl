// @run
// @log 2
// @log 63
// @log 1.5
// @log 1099511627776
// @log 2
// @log -2
// @log true
// @log 3
// @log 3
// @log 63
// @log 4
// A width-generic numeric intrinsic named as a value takes the width its destination's function
// type names: a binding, a parameter, a field, a return, an assignment, or a list's element (D15569).
// With nothing pinning it, it takes f64 (float) or i32 (integer).
const g: (f32) => f32 = sqrt
print(g(4.0))
const h: (i64) => i64 = clz
print(h(1 as i64))
function ap(f: (f32) => f32, x: f32) { f(x) }
print(ap(sqrt, 2.25))
type B = { r: (i64, i64) => i64 }
const b: B = { r: rotl }
print(b.r(1 as i64, 40 as i64))
function mk(): (f32) => f32 { floor }
print(mk()(2.5))
const m: (i32, i32) => i32 = min
print(m(3, -2))
const c: (i64, i64) => boolean = ltU
print(c(1 as i64, -1 as i64))
let k: (f32) => f32 = floor
k = sqrt
print(k(9.0))
const xs: f32[] = [4.0, 9.0]
print(xs.map(sqrt)[1])
const ys = [1 as i64]
print(ys.map(clz)[0])
const d = sqrt
print(d(16.0))
