// @run
// @log two 3 5 5
// @log three 2 4
// @log f64 2 4.5
// @log function 35
// @log generic 24 24
// @hint redundant type annotation: `g` is inferred as `i32`
// An `__array_new__` whose fill is computed by another `__array_new__` keeps its own
// length: a site inside another site's fill stages its length in a slot of its own depth,
// at two and three levels, at an f64 fill, inside a function and in a generic (D2333).
const a = __array_new__(3, __array_new__(5, 7).length)
print("two \{a.length} \{a[0]} \{a[2]}")
const b = __array_new__(2, __array_new__(4, __array_new__(6, 1).length).length)
print("three \{b.length} \{b[0]}")
const c = __array_new__(2, 0.5 + __array_new__(4, 1).length)
print("f64 \{c.length} \{c[1]}")
function inFn() {
  const d = __array_new__(3, __array_new__(5, 7).length)
  return d.length * 10 + d[0]
}
print("function \{inFn()}")
function g<T>(v: T): i32 {
  const e = __array_new__(2, __array_new__(4, v).length)
  return e.length * 10 + e[0]
}
print("generic \{g("s")} \{g(1.5)}")
