// @run
// @log 0
// @log 42
// @log 2
// @log 42
// @log 5
// @log 7
// @log 5
// @log 7
// A declared `__…__` intrinsic named as a value reads a wrapper function of its own signature, in
// every function-value position, and a parameter of the intrinsic's name still shadows it (D2621).
const f = __load_i32__
print(f(0))
const st = __store_i32__
st(64, 42)
print(f(64))
print([1.5, 2.7].map(__trunc_sat_f64_s_i32__)[1])
function inner(): i32 {
  const q = __load_i32__
  q(64)
}
print(inner())
const add = __add_i32x4__
const sp = __splat_i32x4__
print(__extract_lane_i32x4__(add(sp(2), sp(3)), 2))
type H = { h: (i32) => i32 }
function shadow(__load_i32__: i32): i32 { __load_i32__ + 2 }
const r: H = { h: shadow }
print(r.h(5))
const hs = [__load_i32__, f]
print(shadow(hs[0](0) + 3))
print(shadow(hs[1](0) + 5))
