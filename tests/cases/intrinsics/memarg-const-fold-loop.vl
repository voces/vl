// @run
// @log true
// @info `p` is never reassigned; use `const` instead of `let`
// @info `p2` is never reassigned; use `const` instead of `let`
// The mix kernel's own shape, in full: `const p` declared FRESH each loop iteration, folded
// at every iteration's own store and load. Cross-checked against `letGround` —
// the same loop with `let p` (never folded, since a `let` can be reassigned) — so a wrong
// fold would show up as the two answers disagreeing.
// Two disjoint regions (`DA`/`DB`, each 8192 bytes, more than `& 1023) * 8`'s 8184-byte span
// apart) so the two functions' stores never alias — a shared address would make them disagree
// for a reason that has nothing to do with the fold.
const DA = 1024
const DB = 9216
function folded(n: i32) {
  let a: i64 = 7
  let i = 0
  while i < n {
    const p = DA + ((a >>> 3) as% i32 & 1023) * 8
    const v = __load_i64__(p)
    a = a + 1
    __store_i64__(p, v + 1)
    i = i + 1
  }
  const p2 = DA + ((a >>> 3) as% i32 & 1023) * 8
  (__load_i64__(p2) as% i32)
}
function letGround(n: i32) {
  let a: i64 = 7
  let i = 0
  while i < n {
    let p = DB + ((a >>> 3) as% i32 & 1023) * 8
    const v = __load_i64__(p)
    a = a + 1
    __store_i64__(p, v + 1)
    i = i + 1
  }
  let p2 = DB + ((a >>> 3) as% i32 & 1023) * 8
  (__load_i64__(p2) as% i32)
}
print(folded(50) == letGround(50))
