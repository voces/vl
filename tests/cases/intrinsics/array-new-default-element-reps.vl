// @run
// @log 1.75
// @log 0
// @log 9007199254740993
// @log 200
// @log 1.5
// @log 4
// @log 0
// `__array_new_default__(n)`'s element kind is the DESTINATION's, read off the call node the
// checker already pinned it onto — not the i32 list it was once hardcoded to. Each rep here
// STORES before it reads, because every slot the intrinsic writes is a zero and `0` reads the
// same off the i32 backing as off any other: a read-only proof passes on the miscompile.
// The tail is the un-annotated face, where nothing pins the hole and `i32` is the answer
// `flushUninferred` gives it. D1470.
const ds: f64[] = __array_new_default__(3)
ds[0] = 1.5
print(ds[0] + 0.25)
print(ds[2])
const ls: i64[] = __array_new_default__(2)
ls[0] = 9007199254740993
print(ls[0])
const bs: u8[] = __array_new_default__(2)
bs[0] = 200
print(bs[0])
const fs: f32[] = __array_new_default__(2)
fs[0] = 1.5
print(fs[0])
function mk(len: i32) {
  return __array_new_default__(len)
}
const zs = mk(4)
print(zs.length)
print(zs[3])
