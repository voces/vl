// @run
// @log 0
// @log 1.5
// @log 1
// @log 8
// @log 7
// @log 4
// @log 42
// @log 3.5
// @log 3
// An intrinsic named as a value is a function value that calls it (D2621).
const f = __load_i32__
print(f(0))
const s = sqrt
print(s(2.25))
print([1.5].map(__trunc_sat_f64_s_i32__)[0])
const r = rotl
print(r(1, 3))
function inBody() {
  const g = __load_i32__
  g(0) + 7
}
print(inBody())
type Holder = { op: (x: f64) => f64 }
const h: Holder = { op: sqrt }
print(h.op(16.0))
const st = __store_i32__
st(8, 42)
print(__load_i32__(8))
const add = __add_f32x4__
const a = __splat_f32x4__(1.5 as f32)
const b = __splat_f32x4__(2.0 as f32)
print(__extract_lane_f32x4__(add(a, b), 0))
const al = __atomic_load_i32__
print(al(8) - 39)
