// @run
// @log i!
// @log i!x
// @log 2
// @log true
// @log 0
// @log h!
// @log hi!
// `__str_from_bytes__(src, at, count)` copies `src[at .. at + count]` into one exact-size string
// (D4784): a slice, the empty slice, the result in a concat, a return and a list element.
const b: u8[] = []
b.push(104)
b.push(105)
b.push(33)
const s = __str_from_bytes__(b, 1, 2)
print(s)
print(s + "x")
print(s.length)
print(s == "i!")
print(__str_from_bytes__(b, 0, 0).length)
function at(k: i32) { __str_from_bytes__(b, k, 1) }
print(at(0) + at(2))
const xs: string[] = []
xs.push(__str_from_bytes__(b, 0, 3))
print(xs[0])
