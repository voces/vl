// @run
// @log 12340
// @log 76543210
// @log 3141592
// @log 4321
// Memory written through an inline address and read through a folded `const`, and the reverse,
// in a fully unrolled range, a partially unrolled range and a list walk: a fold slot or offset
// that named the wrong address would read another cell.
const D = 1024
function fill(n: i32) {
  let i = 0
  while i < n {
    __store_i64__(D + (i & 255) * 8, (n - i) as i64)
    i = i + 1
  }
}
function fullUnroll() {
  fill(4)
  let s = 0
  for i in 0 to 4 {
    const p = D + ((3 - i) & 255) * 8
    s = s * 10 + (__load_i64__(p) as% i32)
  }
  return s
}
function partialRange(n: i32) {
  fill(n)
  let s = 0
  for i in 0 to n {
    const p = D + (i & 255) * 8
    s = s * 10 + (__load_i64__(p) as% i32)
  }
  return s
}
function listWalk(xs: i32[]) {
  let k = 0
  for x in xs {
    const p = D + (k & 255) * 8
    __store_i64__(p, x as i64)
    k = k + 1
  }
  let s = 0
  let i = 0
  while i < k {
    s = s * 10 + (__load_i64__(D + (i & 255) * 8) as% i32)
    i = i + 1
  }
  return s
}
function reverseRead() {
  for i in 0 to 4 {
    const p = D + (i & 255) * 8
    __store_i64__(p, (i + 1) as i64)
  }
  let s = 0
  let i = 3
  while i >= 0 {
    s = s * 10 + (__load_i64__(D + (i & 255) * 8) as% i32)
    i = i - 1
  }
  return s
}
print(fullUnroll())
print(partialRange(7))
print(listWalk([3, 1, 4, 1, 5, 9, 2]))
print(reverseRead())
