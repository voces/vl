// @check
// @error `g` builds its type parameter's list here: __array_new_default__ fills every slot with the element's default value, and {a: i32} has none — use __array_new__(n, fill)
// CONTRACT (must-error): a generic handing its own type parameter on to a generic
// `__array_new_default__` is refused where that parameter is bound (D2578).
function mk<T>(n: i32, _seed: T): T[] {
  const xs: T[] = __array_new_default__(n)
  return xs
}
function g<U>(u: U): i32 { mk(3, u).length }
print(g(2.5))
print(g({ a: 1 }))
