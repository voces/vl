// @run
// @skip the fs floor needs a host that can build a WasmGC value — V8 cannot; asserted natively by tests/selfhost_native_align_test.ts
// @log 0
// @log 16
// @log 0
// @log 20
// @log 0
// @log 20
// @log -28
// @log -28
// @log -21
// @log 21
// @log 0
// @log 0
// THE WRITE-FROM-MEMORY FLOOR — `__fs_write_from__(path, offset, addr, len, mode)`, the
// `Buf` source of `std:fs`'s three writes.
//
// The host reads `[addr, addr + len)` straight out of the module's exported linear memory,
// so nothing is copied into a GC array first. `mode` is `__fs_write_at__`'s. Nothing in
// this program touches linear memory any other way — no load, no store, no `std:buffer` —
// so the memory it reads exists only because the use scan reserves it for this call, as
// it does for `__fs_read_into__`; without that the first write here would fail to find a
// memory at all. A source outside the memory is `-EFAULT` (-21).
//
// `@skip`ped under the V8 harness and asserted natively for the reason
// `tests/cases/intrinsics/fs-range.vl` sets out. Hermetic on the same terms.
function pathBytes(s: string): u8[] {
  const out: u8[] = []
  let i = 0
  while i < s.length {
    out.push(s[i])
    i = i + 1
  }
  out
}

const path = pathBytes("/tmp/vl-fs-write-from-case.bin")

// Byte 1024 is where `std:buffer` would start its heap; the memory is at least a page, so
// sixteen bytes from there exist and are zero.
const SRC = 1024

print(__fs_write_from__(path, 0, SRC, 16, 0))
print(__fs_size__(path))
print(__fs_write_from__(path, 0, SRC, 4, 2))
print(__fs_size__(path))
print(__fs_write_from__(path, 18, SRC, 2, 1))
print(__fs_size__(path))

// A negative address or length is `-EINVAL`, and a source past the end of the memory is
// `-EFAULT` rather than a trap.
print(__fs_write_from__(path, 0, 0 - 1, 4, 0))
print(__fs_write_from__(path, 0, SRC, 0 - 4, 0))
print(__fs_write_from__(path, 0, 2147483000, 16, 1))
print(__fs_errno__())

// A zero-length source still opens the file, so mode 0 truncates it.
print(__fs_write_from__(path, 0, SRC, 0, 0))
print(__fs_size__(path))
