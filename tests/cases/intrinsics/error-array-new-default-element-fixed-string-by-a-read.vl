// @check
// @error __array_new_default__ fills every slot with the element's default value, and string has none — use __array_new__(n, fill)
// The read into a `string` fixes the element (DECISIONS.md "No default type"), and `string` has no
// zero for the intrinsic to fill with (D16984).
const a = __array_new_default__(2)
const s: string = a[0]
print(s)
