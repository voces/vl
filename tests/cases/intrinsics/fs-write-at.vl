// @run
// @skip the fs floor needs a host that can build a WasmGC value — V8 cannot; asserted natively by tests/selfhost_native_align_test.ts
// @log 0
// @log 3
// @log 0
// @log 5
// @log 0
// @log 5
// @log 0
// @log 2
// @log -28
// @log 28
// @log 2
// @log -28
// @log -28
// @log -28
// @log -44
// @log 44
// THE POSITIONAL WRITE FLOOR — `__fs_write_at__(path, offset, data, mode)`, under
// `std:fs`'s `writeFileRange` and `appendFile`.
//
// `mode` is 0 replace (offset ignored), 1 at `offset` without truncating, 2 append
// (offset ignored). Mode 1 is CONTIGUOUS: an offset past the end of the file it opened
// is `-EINVAL` and nothing is written, and at a non-zero offset a missing file is past
// the end of an empty one rather than created. Every answer is 0 or `-errno`, and
// `__fs_errno__` carries the same code.
//
// `@skip`ped under the V8 harness and asserted natively for the reason
// `tests/cases/intrinsics/fs-range.vl` sets out. Hermetic on the same terms: one file at a
// FIXED path under `/tmp`, and every run starts it over with mode 0.
function pathBytes(s: string): u8[] {
  const out: u8[] = []
  let i = 0
  while i < s.length {
    out.push(s[i])
    i = i + 1
  }
  out
}

const path = pathBytes("/tmp/vl-fs-write-at-case.bin")
const abc: u8[] = [1, 2, 3]
const xy: u8[] = [8, 9]

// Mode 0 replaces, whatever an earlier run left.
print(__fs_write_at__(path, 0, abc, 0))
print(__fs_size__(path))

// Mode 2 appends: three bytes plus two.
print(__fs_write_at__(path, 99, xy, 2))
print(__fs_size__(path))

// Mode 1 inside the file overwrites in place and keeps the length.
print(__fs_write_at__(path, 1, xy, 1))
print(__fs_size__(path))

// Mode 0 again truncates to what it writes.
print(__fs_write_at__(path, 0, xy, 0))
print(__fs_size__(path))

// One past the end is `-EINVAL` (-28), and the file is unchanged.
print(__fs_write_at__(path, 3, abc, 1))
print(__fs_errno__())
print(__fs_size__(path))

// A negative offset and an unknown mode are `-EINVAL` too.
print(__fs_write_at__(path, 0 - 1, abc, 1))
print(__fs_write_at__(path, 0, abc, 3))

// A missing file at a non-zero offset is past the end of nothing: `-EINVAL`, not created.
const absent = pathBytes("/tmp/vl-fs-write-at-absent-dir/x.bin")
print(__fs_write_at__(absent, 1, abc, 1))

// At offset 0 the host tries to create it, and a missing directory is `-ENOENT` (-44).
print(__fs_write_at__(absent, 0, abc, 1))
print(__fs_errno__())
