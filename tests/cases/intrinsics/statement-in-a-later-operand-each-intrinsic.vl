function opt(n: i32): i32 | null { return if n > 0 { n } else { null } }
function simd(c: boolean, n: i32) {
  const a = __splat_i32x4__(n)
  print(
    __extract_lane_i32x4__(
      __add_i32x4__(a, __splat_i32x4__(if c { 2 } else { 3 })),
      0,
    ),
  )
  print(
    __extract_lane_i32x4__(
      __add_i32x4__(__splat_i32x4__(n), __splat_i32x4__(opt(0) ?? 3)),
      1,
    ),
  )
}
function mem(c: boolean, p: i32) {
  __store_v128__(p, 16, __splat_i32x4__(if c { 12 } else { 13 }))
  print(__extract_lane_i32x4__(__load_v128__(p + 16), 2))
  __store_v128__(p, 16, __splat_i32x4__(opt(13) ?? 0))
  print(__extract_lane_i32x4__(__load_v128__(p + 16), 3))
}
function bytes(c: boolean) {
  const b: u8[] = [97, 98, 99, 100]
  print(__str_from_bytes__(b, if c { 1 } else { 2 }, opt(0) ?? 2))
}
function spread(c: boolean, xs: i32[]) {
  const ys = [...xs, if c { 9 } else { 8 }]
  print(ys.length)
  print(ys[1])
  const zs = [0, ...xs, ...[opt(0) ?? 9]]
  print(zs[2])
  const ws = [0, ...[opt(2) ?? 1]]
  print(ws[1])
  print(ws.length + (opt(0) ?? 1))
  print([...[opt(1) ?? 0]][0])
}
simd(false, 2)
simd(true, 3)
mem(false, 1024)
bytes(true)
bytes(false)
spread(true, [3, 4])
