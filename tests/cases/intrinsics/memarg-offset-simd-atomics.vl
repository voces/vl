// The offset form of the v128 loads and stores and of every atomic that carries a memarg: the
// offset is argument 2 and the operands after it keep their order. An atomic's alignment
// applies to the effective address `p + off`, so both halves are chosen aligned here.
function vec(p: i32) {
  __store_v128__(p, 16, __splat_i32x4__(7))
  print(__extract_lane_i32x4__(__load_v128__(p + 16), 2))
  __store_i32__(p + 36, 0x04030201)
  print(__extract_lane_u_i16x8__(__load8x8_u_v128__(p, 36), 3))
  print(__extract_lane_i32x4__(__load32_splat_v128__(p, 36), 1))
  print(__extract_lane_i32x4__(__load32_zero_v128__(p, 36), 1))
  print(__extract_lane_i64x2__(__load64_zero_v128__(p, 36), 0))
}
vec(1024)

function atom(p: i32) {
  __atomic_store_i32__(p, 32, 9)
  print(__atomic_load_i32__(p + 32))
  print(__atomic_rmw_add_i32__(p, 32, 5))
  print(__atomic_rmw8_sub_u_i32__(p, 32, 1))
  print(__atomic_load8_u_i32__(p, 32))
  print(__atomic_rmw_cmpxchg_i64__(p, 40, 0 as i64, 77 as i64))
  print(__atomic_load_i64__(p + 40))
  __atomic_store16_i64__(p, 48, 65535 as i64)
  print(__atomic_load16_u_i64__(p, 48))
  print(__atomic_rmw32_xchg_u_i64__(p, 48, 3 as i64))
  print(__atomic_notify__(p, 32, 1))
  __atomic_fence__()
}
atom(2048)
