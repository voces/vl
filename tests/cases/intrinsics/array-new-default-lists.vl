// @run
// @log 3
// @log 0
// @log 4
// @log 2
// __array_new_default__ over i32, f64 and byte lists, beside __array_new__.
function zeros(n: i32): i32[] { return __array_new_default__(n) }
function fzeros(n: i32): f64[] { return __array_new_default__(n) }
function bytes(n: i32): u8[] { return __array_new_default__(n) }
function strs(n: i32) {
  const out = __array_new__(n, "")
  return out
}
print(zeros(3).length)
print(fzeros(2)[1])
print(bytes(4).length)
print(strs(2).length)
