// @run
// @skip the fs floor needs a host that can build a WasmGC value — V8 cannot; asserted natively by tests/selfhost_native_align_test.ts
// @log 0
// @log 3
// @log true
// @log true
// A host-floor intrinsic, whose parameters are `u8[]`, `i64` and `i32`, named as a value is a
// function value that calls it, and reads what the direct call reads (D2621).
function pathBytes(s: string): u8[] {
  const out: u8[] = []
  let i = 0
  while i < s.length {
    out.push(s[i])
    i = i + 1
  }
  out
}
const p = pathBytes("/tmp/vl-fs-intrinsic-as-value.txt")
const wr = __fs_write__
print(wr(p, pathBytes("abc")))
const sz = __fs_size__
print(sz(p))
const rd = __fs_read__
print(rd(p).length == __fs_read__(p).length)
const st = __fs_stat__
print(st(p) == __fs_stat__(p))
