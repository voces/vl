// @run
// @log b
// @log 0
// @log 2
// @log 5000000000
// @log 2.5
// @log 3
// @log 1.5
// @log true
// @log 2
// @log x
// @log none
// @log u
// @log 3
// @log 1
// @log 5
// @log h
// @log 2
import { zeroBytes } from "std:bytes"
// `__array_copy__` copies a backing of every list kind with one `array.copy`, as `.slice` does:
// strings, records, the scalar widths, lists, nullable strings, unions, maps, closures and bytes,
// and overlapping ranges of one list (D3549).
const xs = ["a", "b"]
const out = __array_new__(2, "")
__array_copy__(out, 0, xs, 0, 2)
print(out[1])
type P = { n: i32 }
const ps: P[] = [{ n: 1 }, { n: 2 }, { n: 3 }]
const po = __array_new__(3, { n: 0 })
__array_copy__(po, 1, ps, 0, 2)
print(po[0].n)
print(po[2].n)
const ls = [5000000000, 7]
const lo = __array_new__(2, 0 as i64)
__array_copy__(lo, 0, ls, 0, 2)
print(lo[0])
const fs: f32[] = [1.5, 2.5]
const fo = __array_new__(2, 0.0 as f32)
__array_copy__(fo, 0, fs, 1, 1)
print(fo[0])
const ns = [1, 2, 3]
const io = __array_new__(3, 0)
__array_copy__(io, 0, ns, 0, 3)
print(io[2])
const ds = [1.5]
const dout = __array_new__(1, 0.0)
__array_copy__(dout, 0, ds, 0, 1)
print(dout[0])
const bs = [true, false]
const bo = __array_new__(2, false)
__array_copy__(bo, 0, bs, 0, 2)
print(bo[0])
const ll2: i32[][] = [[1], [2, 3]]
const lo2 = __array_new__(2, [0])
__array_copy__(lo2, 0, ll2, 0, 2)
print(lo2[1].length)
const ns2: (string | null)[] = ["x", null]
const nfill2: string | null = null
const no2 = __array_new__(2, nfill2)
__array_copy__(no2, 0, ns2, 0, 2)
print(no2[0] ?? "none")
print(no2[1] ?? "none")
const us2 = [1, "u"]
const ufill2: i32 | string = 0
const uo2 = __array_new__(2, ufill2)
__array_copy__(uo2, 0, us2, 0, 2)
print(uo2[1])
const ov2 = [1, 2, 3, 4]
__array_copy__(ov2, 1, ov2, 0, 3)
print(ov2[3])
const ms2: {[string]: i32}[] = [Map()]
const mo2: {[string]: i32}[] = __array_new__(1, Map())
__array_copy__(mo2, 0, ms2, 0, 1)
print(mo2.length)
const fs2: ((x: i32) => i32)[] = [(x: i32) => x + 1]
const fo2: ((x: i32) => i32)[] = __array_new__(1, (x: i32) => x)
__array_copy__(fo2, 0, fs2, 0, 1)
print(fo2[0](4))
function cp<T>(dst: T[], src: T[]) { __array_copy__(dst, 0, src, 0, src.length) }
const gs2 = ["g", "h"]
const go2 = __array_new__(2, "")
cp(go2, gs2)
print(go2[1])
const bs2: u8[] = [1, 2]
const bo2 = zeroBytes(2)
__array_copy__(bo2, 0, bs2, 0, 2)
print(bo2[1])
