// @run
// @log 1
// @log 0.5
// @log 1
// @log 2.5
// CONTRACT (must-RUN): a linear-memory intrinsic's operands are i32 BY DECLARATION — a
// byte address, a stored word, a page count — so no WIDE-SCALAR context an enclosing
// position set may reach them.
//
// On the parent commit `emitLetDecl`'s `letIsF32` arm seeded `pendingF32` across the whole
// initializer subtree and `emitCall`'s intrinsic arms emitted their arguments with it
// still set, so a bare address literal lowered as `f32.const` — `f32.const 0` followed by
// `f32.load`, an UNPARSEABLE MODULE with `vl check` clean. Measured over a position matrix:
// 9 of 11 f32 positions (annotated and inferred `let`, module and function scope, an f32
// RETURN, an f32 ARGUMENT, and anything nested in them) and 1 of 4 i64 positions (an i64
// ARGUMENT). f64 escaped only by accident of routing — its `let`/return arms call
// `emitExprAsF64` and never seed the flag.
//
// `emitMemIntrinArg` clears the three pending flags around each operand and restores them,
// the same discipline (and the same reason) as the `call_ref` argument spine.
//
// Values, not just "no longer invalid": 1065353216 is the f32 bit pattern of 1.0 and
// 1056964608 that of 0.5, so each cell checks the ADDRESS reached the right place AND the
// width read the right bytes.
__store_i32__(0, 1065353216)
__store_i32__(4, 1056964608)

// 1. an f32 RETURN — the whole result expression sits in f32 context
function readF32(a: i32): f32 { return __load_f32__(a) }
print(readF32(0))

// 2. an f32 ARGUMENT position
function showF32(v: f32) { print(v) }
showF32(__load_f32__(4))

// 3. an i64 ARGUMENT position, the same defect one width over
function showI64(v: i64) { print(v + 1) }
showI64(__load_i64__(8))

// 4. an f32 binding whose address is itself an intrinsic read (nested, so the inner
//    address literal is two frames inside the f32 context)
function nested(): f32 { return __load_f32__(__load_i32__(8)) }
print(nested() + 1.5 as f32)
