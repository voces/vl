// @run
// @log 2
// @log 5
// WAS AN `@emit-error` FENCE — inverted by D-CAPCALLEE.
//
// Wrapping a memory intrinsic in a named function is fine on its own, but in a
// module that also uses a function value ANYWHERE the emitter routes every
// "capturing" function through its closure env — and on master capture analysis
// recorded `__store_i32__` as a free variable, because it is not a collected
// function, a module global, or a locally bound name.
//
// `__log__`, `__trap__` and the `__array_*__` intrinsics did NOT hit this: they
// sat on `isBuiltinFnName`'s exemption list (`compiler/emit_base.vl`) and
// `__store_i32__` / `__load_i32__` did not. The fix does not extend that list at
// every identifier — it moves the whole question into CALLEE POSITION
// (`capScan`'s `Call` arm), which is the only place a name means "instructions
// the emitter lowers inline". See `docs/internals/buffer-design.md` §B3.
function poke(a: i32, v: i32) {
  __store_i32__(a, v)
  0
}

const xs = [1, 2, 3]
const doubled = xs.map((v: i32) => v * 2)
print(doubled[0])
poke(0, 5)
print(__load_i32__(0))
