// @run
// @log 5
// @log 8
// @log 1
// @log 11
// @log 5
// @log s!
// @log 7
// @log 9
// @log 2
// @log 12
// @log 7
// @log u
// @log 6
// @log 4
// @log 3
// @log 13
// @log 8
// @log v
// A value `if` whose arm is another `if`, the inner arm binding a local before its value: the
// outer arm has no prelude of its own, so the inner `if` walks its arm. Positions: binding,
// argument, `return`, record field, a list join and a string join.
type P = { a: i32 }
type H = { p: P }
function id(p: P): P { return p }
function ret(c: boolean, d: boolean): P {
  return if c { if d { const x: P = { a: 1 }; x } else { { a: 2 } } } else { { a: 3 } }
}
function run(c: boolean, d: boolean) {
  const r = if c { if d { const x: P = { a: 5 }; x } else { { a: 7 } } } else { { a: 6 } }
  print(r.a)
  print(
    id(
      if c { if d { const y: P = { a: 8 }; y } else { { a: 9 } } } else { { a: 4 } },
    ).a,
  )
  print(ret(c, d).a)
  const h: H = {
    p: if c { if d { const z: P = { a: 11 }; z } else { { a: 12 } } } else { { a: 13 } },
  }
  print(h.p.a)
  const l = if c { if d { const w = [5, 6]; w } else { [7] } } else { [8] }
  print(l[0])
  const s = if c { if d { const t = "s"; t + "!" } else { "u" } } else { "v" }
  print(s)
}
run(true, true)
run(true, false)
run(false, true)
