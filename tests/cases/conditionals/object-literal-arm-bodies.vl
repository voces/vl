// @log 1
// @log 2
// @log 3
// @log 4
// @log 5
// @log 6
// @log 7
// @log 8
// @log 9
// @log 10
// @log 11
// @log 12
// Braces that open `{ name: …` are an object literal in every body position, since a label is
// `@name` (owner ruling 2026-09-30, D3374): a function body, a lambda body, an `if` branch, an
// `else` branch, an `else if` link, a `match` arm, and each of those holding a nested object.
function fnBody() { a: 1 }
print(fnBody().a)
const lam = () => { a: 2 }
print(lam().a)
function branches(c: boolean) {
  if c { a: 3 } else { a: 4 }
}
print(branches(true).a)
print(branches(false).a)
function chain(k: i32) {
  if k == 0 { a: 0 }
  else if k == 5 { a: 5 }
  else { a: 6 }
}
print(chain(5).a)
print(chain(9).a)
function arms(k: i32) {
  match k {
    1 => { a: 7 }
    _ => { a: 8 }
  }
}
print(arms(1).a)
print(arms(2).a)
const picked = if 2 > 1 { a: 9, b: 0 } else { a: 0, b: 0 }
print(picked.a)
function nested(c: boolean) {
  if c { a: { b: 10 } } else { a: { b: 0 } }
}
print(nested(true).a.b)
function multiLine(c: boolean) {
  if c { a: 11, b: 0 } else { a: 0, b: 0 }
}
print(multiLine(true).a)
const nestedArm = (k: i32) => match k {
  3 => { a: { b: 12 } }
  _ => { a: { b: 0 } }
}
print(nestedArm(3).a.b)
