// @run
// @log 5
// @log 0
// @log 0
// @log 6
// `{ a: { b } }` reads the same in an if-expression's then arm and its else arm: an object literal,
// since a label is `@name` (D3374).
function h(c: boolean, b: i32) {
  const t = if c { a: { b: b } } else { a: { b: 0 } }
  const e = if c { a: { b: 0 } } else { a: { b: b } }
  print(t.a.b)
  print(e.a.b)
}
h(true, 5)
h(false, 6)
