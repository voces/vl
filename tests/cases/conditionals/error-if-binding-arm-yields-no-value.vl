// @check
// @error this arm yields no value, but the `if` is the value of `a`: end the arm with a value, or make the `if` a statement
// @error this arm yields no value, but the `if` is the value of `b`: end the arm with a value, or make the `if` a statement
// @error this arm yields no value, but the `if` is the value of `d`: end the arm with a value, or make the `if` a statement
// @error this arm yields no value, but the `match` is the value of `e`: end the arm with a value, or make the `match` a statement
// @error this arm yields no value, but the `if` is the value of `h`: end the arm with a value, or make the `if` a statement
// @error this arm yields no value, but the `if` is the value of `k`: end the arm with a value, or make the `if` a statement
// @error-at 34:24 `i32 | void` has a `void` member, and `void` has no value to hold: write `i32 | null` for a value that may be absent
// @error-at 38:26 `i32 | void` has a `void` member, and `void` has no value to hold: write `i32 | null` for a value that may be absent
// @error `m` would take the type i32 | void, and a value that may be `void` cannot be stored: test it before binding it, or bind it only where it holds a value
// @error `q` would take the type i32 | void, and a value that may be `void` cannot be stored: test it before binding it, or bind it only where it holds a value
// An un-annotated binding of an `if` whose arm ends in a statement is refused at that arm (D4071);
// one whose initializer is no `if` but includes `void` is refused at the initializer.
function f(c: boolean, n: i32): i32 {
  const a = if c { 1 } else { print(2) }
  const b = if c { print(1) } else { 2 }
  const d = if c { 1 } else { if c { print(3) } }
  const e = match n {
    1 => 1
    _ => {
      print(4)
    }
  }
  print(a)
  print(b)
  print(d)
  print(e)
  return 0
}
print(f(true, 1))

// A void call or an empty block as the arm (D1993, D1994), and an initializer that is no
// `if` at all but whose type includes `void`; a written `i32 | void` is refused too (D12467).
function v() { print(5) }
function r(c: boolean): i32 | void {
  if c { return 1 }
  return
}
function g(c: boolean, p: i32 | void): i32 {
  const h = if c { v() } else { 1 }
  const k = if c { 1 } else { }
  const m = p
  const q = r(c)
  print(h)
  print(k)
  print(m)
  print(q)
  return 0
}
print(g(true, 1))
