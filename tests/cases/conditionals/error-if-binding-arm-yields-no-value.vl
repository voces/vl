// @check
// @error this arm yields no value, but the `if` is the value of `a`: end the arm with a value, or make the `if` a statement
// @error this arm yields no value, but the `if` is the value of `b`: end the arm with a value, or make the `if` a statement
// @error this arm yields no value, but the `if` is the value of `d`: end the arm with a value, or make the `if` a statement
// @error this arm yields no value, but the `match` is the value of `e`: end the arm with a value, or make the `match` a statement
// An un-annotated binding of an `if` whose arm ends in a statement is refused at that arm (D4071).
function f(c: boolean, n: i32): i32 {
  const a = if c { 1 } else { print(2) }
  const b = if c { print(1) } else { 2 }
  const d = if c { 1 } else { if c { print(3) } }
  const e = match n {
    1 => 1
    _ => {
      print(4)
    }
  }
  print(a)
  print(b)
  print(d)
  print(e)
  return 0
}
print(f(true, 1))
