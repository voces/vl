// @run
// @log a!
// @log 3
// @log 4
// @log none
// @log 6
// @log a.
// @log none
// @log 4
// @log none
// @log none
// A valued `if` whose arm is built at another rep than the join's, and no retag reaches it: the
// arm is delivered at the join's rep. Hole functions at a closure join, and a record element at a
// nullable record join, at a `const`, a return, a record field and through a call.
function bang(s) { return s + "!" }
function hush(s) { return s + "." }
function id<T>(x: T): T { return x }
function pickRec(xs, n: i32) { return if xs.length > n { xs[0] } else { null } }
function run(on: boolean) {
  const g = if on { bang } else { hush }
  print(g("a"))
  const xs = [{ f: id }]
  const c = if on { xs[0] } else { null }
  if c != null { print(c.f(3)) } else { print("none") }
  const p = pickRec(xs, 0)
  if p != null { print(p.f(4)) } else { print("none") }
  const q = pickRec(xs, 5)
  if q != null { print(q.f(4)) } else { print("none") }
  const box = { r: if on { xs[0] } else { null } }
  if box.r != null { print(box.r.f(6)) } else { print("none") }
}
run(true)
run(false)
