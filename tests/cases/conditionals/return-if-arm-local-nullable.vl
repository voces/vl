// @run
// @log b
// @log null
// @log null
// @log b
// @log null
// @log b
// @log null
// A returned if-expression whose arm reads a nullable binding declared in that arm keeps the
// nullable result: the binding's own declaration no longer clears the return's `null` seed
// before the arm's value is read (D3352).
function a(n: i32) {
  return if n > -5 {
    let z: string | null = null
    if n == 1 { z = "b" }
    z
  } else {
    null
  }
}
function b(n: i32) {
  return if n > -5 {
    const z: string | null = null
    z
  } else {
    null
  }
}
function c(n: i32): string | null {
  return if n > -5 {
    let z: string | null = "b"
    if n == 7 { z = null }
    z
  } else {
    "q"
  }
}
function d(n: i32) {
  return if n > -5 {
    let z: string | null = null
    if n == 1 { z = "b" }
    z
  } else {
    __trap__()
  }
}
print(a(1))
print(a(7))
print(b(7))
print(c(1))
print(c(7))
print(d(1))
print(d(7))
