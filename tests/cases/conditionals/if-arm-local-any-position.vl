// @log 41
// @hint redundant type annotation: `id` is inferred as `i32`
// @hint redundant type annotation: `pick` is inferred as `boolean`
// @hint redundant type annotation: `f` is inferred as `i32`
// @hint redundant type annotation: `k` is inferred as `f64`
// @hint redundant type annotation: `q` is inferred as `i64`
// @hint redundant type annotation: `wide` is inferred as `i64`
// @hint redundant type annotation: `loopArm` is inferred as `i32`
// @hint redundant type annotation: `call` is inferred as `i32`
// @hint redundant type annotation: `narrow` is inferred as `i32`
// @hint redundant type annotation: `jumps` is inferred as `i32`
// @hint this 2-element `f32[]` is returned to callers that read it only at fixed indexes
// An if-expression arm that declares a local lowers in every position, not only as a binding
// initializer: its locals are allocated by node wherever the collect pass finds the expression,
// at module scope included, and at every numeric width (D2591, D2785).
type P = { a: i32, b: string }
function id(n: i32): i32 { n }
function pick(): boolean { true }
function f(c: boolean, x: i32): i32 {
  return id(if c { const q = 3; q + x } else { const r = 5; r - x })
}
print(f(true, 1))
print(f(false, 1))
const c = pick()
const x = 4
print(if c { const q = 3; q + x } else { 0 })
const k: f64 = if !c { 1.5 } else { const z = 2.25; z * 2.0 }
print(k)
let t = 0
t = if c { const w = 7; w } else { 1 }
print(t)
function mk(c: boolean): P {
  {
    a: if c { const q = 3; q * 3 } else { 1 },
    b: if c { "y" } else { const s = "n"; s + "!" },
  }
}
print(mk(true).a)
print(mk(false).b)
function arr(c: boolean): f32[] {
  [if c { const q: f32 = 1.5; q } else { 2.0 }, 3.0]
}
print(arr(true)[0])
function wide(c: boolean): i64 {
  1 + (if c { const q: i64 = 5000000000; q * 3 } else { 9 })
}
print(wide(true))
let s = 0
for i in 0 to 3 { s = s + (if i > 1 { const d = i * 10; d } else { i }) }
print(s)
function loopArm(c: boolean): i32 {
  1 + (if c { let acc = 0; for j in 0 to 4 { acc = acc + j }; acc } else { 0 })
}
print(loopArm(true))
function call(g: () => i32): i32 { g() }
print(call(if pick() { const q = 3; () => q + 1 } else { () => 0 }))
const shadow = 100
print(shadow + (if pick() { const shadow = 5; shadow } else { 0 }) + shadow)
function narrow(u: i32 | string): i32 {
  1 + (if u is i32 { const n = u; n * 2 } else { const l = u; l.length })
}
print(narrow(4))
print(narrow("abc"))
function jumps(): i32 {
  let acc = 0
  for i in 0 to 4 {
    acc = acc
      + id(if i > 0 { const v = i * 5; if i == 2 { continue }; v } else { 1 })
  }
  acc
}
print(jumps())
