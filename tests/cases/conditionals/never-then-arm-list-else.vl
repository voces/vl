// @run
// @log 6
// @log 4
// An if-expression whose then arm is a `never` call classifies by its else arm, so a list else
// binds a list (D3258).
function die(msg: string): never {
  print(msg)
  __trap__()
}
function h(n: i32) {
  const y = if n == 99 { die("dead") } else { [n, n] }
  y.length + y[0]
}
type Rec = { r: i32 }
function g(n: i32) {
  const y = if n == 99 { die("dead") } else { { r: n } }
  y.r
}
print(h(4))
print(g(4))
