// @run
// @log 1
// @log 0
// @log 2
// @log 0
// @log 3
// @log 6
// @log 4
// @log 5
// @log 7
// @log 5
// @log null
// @log 6
// @log 5
// @log 6
// @log 5
// @log 9
// Regression (D1995, D2013, D2018 — plumb PL-011). A tail `if`/`else` or `match` is the
// function's value only when every arm that completes yields one; an exiting arm adds nothing.
let hits = 0
function v() {
  hits = hits + 1
  return
}

// D1995: an un-annotated closure, one arm a `.push`, the other a `print` — either flag.
function closures() {
  const f = (flag: boolean) => {
    const xs: i32[] = []
    if flag { xs.push(8) } else { print(0) }
  }
  f(true)
  print(1)
  f(false)
  print(2)
  // A captured nullable list, the other arm taken.
  const ns: i32[] | null = null
  const g = () => {
    if ns != null { ns.push(8) } else { print(0) }
  }
  g()
  print(3)
}
closures()

// PL-011: mutually recursive void functions whose tail arms end in calls, one of them void.
const out: string[] = []
function ln(s: string) { out.push(s) }
function doTree(x: i32) {
  if x % 2 == 0 {
    ln("h")
    nodeWithin(x)
  } else {
    nodeWithin(x)
  }
}
function nodeWithin(x: i32) {
  if x <= 0 {
    emitBlock(x)
    return
  }
  ln("b")
  doTree(x - 1)
}
function emitBlock(x: i32) {
  if x < 0 { doBranch(x) } else { ln("leaf") }
}
function doBranch(x: i32) {
  if x == -1 { ln("c") } else { doTree(x + 1) }
}
doTree(3)
print(out.length)

// A value arm beside a void-call arm, and the same as a `match`.
function mixed(c: boolean) {
  if c { 5 } else { v() }
}
mixed(true)
mixed(false)
function mixedMatch(k: i32) {
  match k {
    1 => {
      5
    }
    _ => {
      v()
    }
  }
}
mixedMatch(1)
mixedMatch(2)
print(hits + 2)

// An exiting arm adds nothing: this is `i32`, not `void | i32`, recursion included.
function early(c: boolean, n: i32) {
  if n > 0 { early(c, n - 1) }
  else if c { return 5 }
  else { 7 }
}
print(early(true, 2))
print(early(false, 2))
// A `return` beside a value-less arm falls through, so the result is `i32 | null`.
function guard(c: boolean) {
  if c { return 5 } else { v() }
}
print(guard(true))
print(guard(false))

// D2013: an assignment's value, through a captured cell, a field and a literal index.
function assigns() {
  let q = 0
  const f = () => q = 6
  print(f())
  const o = { x: 0 }
  const g = (c: boolean) => if c { o.x = 5 } else { 7 }
  print(g(true))
  const arr = [0]
  const h = () => arr[0] = 6
  print(h())
  print(o.x)
  print(q + arr[0] - 3)
}
assigns()
