// @run
// @log 1
// @log s
// @log 2
// @log t
// @warning this `else` can never run (`v` is always `string`)
// @warning this `else` can never run (`v` is always `string`)
// A dead `else`, nested and as a chain's last link, is written by neither emitter (D16006).
function f(v: i32 | string) {
  if v is i32 {
    print(v)
  } else {
    if v is string { print(v) } else { print("OTHER") }
  }
}
function g(v: i32 | string) {
  if v is i32 { print(v) }
  else if v is string { print(v) }
  else { print("OTHER") }
}
f(1)
f("s")
g(2)
g("t")
