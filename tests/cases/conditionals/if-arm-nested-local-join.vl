// @run
// @log 5
// @log 7
// @log 6
// @log 6
// @log 1.5
// @log 5
// @log s!
// @hint redundant type annotation: `pick` is inferred as `boolean`
// @hint redundant type annotation: `x` is inferred as `{a: i32}`
// @hint redundant type annotation: `g` is inferred as `i32`
// @hint redundant type annotation: `x` is inferred as `{a: i32}`
// An arm whose value is another `if`, the inner arm yielding a local of its own prelude: the
// join, the binding and a module global are classified with that local's rep, at every depth (D2825).
type P = { a: i32 }
function id(p: P): P { p }
function pick(): boolean { true }
function f(c: boolean, d: boolean): P {
  return id(
    if c { if d { const x: P = { a: 5 }; x } else { { a: 7 } } } else { { a: 6 } },
  )
}
print(f(true, true).a)
print(f(true, false).a)
print(f(false, true).a)
function g(c: boolean): i32 {
  const r = if c { if c { if c { const x = [5, 6]; x } else { [7] } } else { [8] } } else { [9] }
  r[1]
}
print(g(true))
const c = pick()
const k = if c { const q: f64 = 1; q } else { 2.5 }
print(k + 0.5)
const s = (if c { if c { const x: P = { a: 5 }; x } else { { a: 7 } } } else { { a: 7 } })
print(s.a)
const t = if c { const x = "s"; x + "!" } else { "t" }
print(t)
