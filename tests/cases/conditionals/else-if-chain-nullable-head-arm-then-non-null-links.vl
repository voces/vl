// @run
// @log none
// @log b
// @log z
// A string `else if` chain whose first arm is a parameter instantiated nullable, and whose later
// links yield no null, is one nullable join read at every link.
type K = "a" | "b"
function g(a0, a1, k: i32) {
  const o = { v: if k == 0 { a0 } else if k == 1 { a1 } else { "z" } }
  print(o.v ?? "none")
}
const x0: K | null = null
const x1: K = "b"
g(x0, x1, 0)
g(x0, x1, 1)
g(x0, x1, 2)
