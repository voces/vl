// @run
// @log true
// @log false
// @log false
// @log true
// @log 2.5
// @log -1
// @log true
// @log false
// @log 3
// @log true
// An `if` whose value is a nullable scalar (`i32 | null`, `f64 | null`) is the union box
// wherever it is read, so comparing it to `null`, coalescing it, testing it with `is` or
// passing it on works inline as it does bound to a local first. The map `??` read desugars
// to the same `if`, so it reads inline too (D2250, D2251).

type Err = { code: i32 }

function show(x: i32 | null) { print(x ?? -1) }

function h(c: boolean) { show(if c { 3 } else { null }) }

function f(c: boolean, a: i32 | null, b: i32 | null) {
  print((if c { a } else { b }) != null)
  print((if c { a } else { null }) is null)
}

function g(c: boolean, a: f64 | null, b: f64 | null) {
  print((if c { a } else { b }) ?? -1.0)
}

f(true, 1, null)
f(false, 1, null)
g(true, 2.5, null)
h(false)

const arrs: {[string]: i32[] | Err} = Map()
const moreArrs: {[string]: i32[] | Err} = Map()
print((arrs["q"] ?? moreArrs["q"]) == null)
print((arrs["q"] ?? moreArrs["q"]) is Err)
arrs["q"] = [1, 2, 3]
const got = arrs["q"] ?? moreArrs["q"]
if got != null && !(got is Err) { print(got.length) }
const plain: {[string]: i32[]} = Map()
const none: i32[] | null = null
print((plain["q"] ?? none) == null)
