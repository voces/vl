// @log 2
// @log 5
// @log 6
// @log a
// @log b
// @log 2
// @log y
// A list or record seed an if or match arm sets for its own value ends with the arm, so a
// later literal with no destination of its own builds at its own type (D5370).
type Item = { a: i32 }
type H = { w: Item, ar: Item | null }
function lines(h: H) {
  const a = h.ar
  let n = 0
  for it in if a == null { [h.w] } else { [h.w, a] } { n = n + it.a }
  for p in ["x", "y"] { print(p) }
  n
}
function ints() {
  for k in [1, 2] { print(k) }
}
function inferred(k: i32) {
  let n = 0
  for it in match k {
    0 => [{ a: 1 }]
    _ => [{ a: 2 }, { a: 3 }]
  } {
    n = n + it.a
  }
  print(n)
  let s = 0.0
  for x in if k == 0 { [1.5] } else { [2.5, 3.5] } { s = s + x }
  print(s)
  for p in ["a", "b"] { print(p) }
  print(["x", "y"].length)
  print(["x", "y"][1])
}
print(lines({ w: { a: 1 }, ar: { a: 2 } }))
ints()
inferred(1)
