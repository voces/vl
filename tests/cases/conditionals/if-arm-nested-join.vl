// @run
// @log 1
// @log k!
// @log 7
// @log 3
// @log 5
// @log 7
// @log s
// @log null
// @log null
// @log nul
// @log 6
// @log 8
// @log t
// @log 5
// @log nul
// @log six
// @log 5
// @log 6
// @log -1
// @hint redundant type annotation: `pick` is inferred as `boolean`
// @hint redundant type annotation: `z0` is inferred as `i32`
// @hint redundant type annotation: `w` is inferred as `i32 | string`
// @hint redundant type annotation: `s` is inferred as `string | i32`
// An arm that ends in another if-expression joins at the outer join's rep: a union box, a
// concrete variant, a struct, or a nullable frame when the inner `if` has no else (D2822; D2040, D2051).
type A = { a: i32 }
type B = { b: string }
type U = A | B
type P = { a: i32 }
function pick(): boolean { true }
function z0(): i32 { 0 }
const sel = z0()
const w: i32 | string = match sel {
  0 => if sel == 0 { 1 } else { "s" }
  _ => "t"
}
print(w)
const s: string | i32 = if pick() { const t = "k"; if pick() { t + "!" } else { 1 } } else { 2 }
print(s)
function mk(): U {
  const u: U = if pick() { if !pick() { { b: "x" } } else { { a: 7 } } } else { { b: "y" } }
  u
}
const m = mk()
if m is A { print(m.a) } else { print("B") }
const va: A = if pick() { if pick() { { a: 3 } } else { { a: 4 } } } else { { a: 5 } }
print(va.a)
function f(c: boolean, d: boolean) {
  const x = if c { if d { if d { 5 } } } else { 6 }
  if x != null { print(x) } else { print("null") }
  const y: P | null = if c { if d { { a: 7 } } } else { { a: 8 } }
  if y != null { print(y.a) } else { print("null") }
  const z = if c { if d { "s" } } else { "t" }
  print(z ?? "nul")
}
f(true, true)
f(true, false)
f(false, true)
function r(c: boolean, d: boolean) {
  if c {
    if d {
      if d { 5 }
    }
  } else {
    "six"
  }
}
print(r(true, true) ?? "nul")
print(r(true, false) ?? "nul")
print(r(false, false) ?? "nul")
function g(k: i32): i32 | null { return if k == 0 { 5 } else if k == 1 { 6 } }
print(g(0) ?? -1)
print(g(1) ?? -1)
print(g(2) ?? -1)
