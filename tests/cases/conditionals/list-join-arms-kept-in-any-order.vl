// @run
// @log 2
// @log 2
// @log 2
// @log 2
// @log 2
// @log 2
// @log 2
// @log 4
// A join of stored lists keeps each list whose elements a sibling stores differently, beside
// a union as beside a single list, so arm order and arm count do not decide which list is
// kept: an `i32[]` arm after `f64[] | string[]` is still an `i32[]` (D14083).
type K = "a" | "b"
function m3(a0: f64[], a1: string[], a2: i32[], k: i32) {
  const r = match k {
    0 => a0
    1 => a1
    _ => a2
  }
  if r is i32[] { print(r.length) } else { print(-1) }
}
m3([1.5], ["x"], [6, 7], 2)
function m4(a0: string[], a1: f64[], a2: K[], a3: i32[], k: i32) {
  const r = match k {
    0 => a0
    1 => a1
    2 => a2
    _ => a3
  }
  if r is i32[] { print(r.length) } else { print(-1) }
}
m4(["x"], [1.5], ["a"], [6, 7], 3)
function i3(a0: i32[], a1: f64[], a2: K[], k: i32) {
  const r = if k == 0 { a0 } else if k == 1 { a1 } else { a2 }
  if r is i32[] { print(r.length) } else { print(-1) }
}
i3([6, 7], [1.5], ["a"], 0)
function twoStep(a0: f64[], a1: string[], a2: i32[], k: i32) {
  const t = if k == 0 { a0 } else { a1 }
  const r = if k == 2 { a2 } else { t }
  if r is i32[] { print(r.length) } else { print(-1) }
}
twoStep([1.5], ["x"], [6, 7], 2)
function retSet(a0: f64[], a1: string[], a2: i32[], k: i32) {
  if k == 0 { return a0 }
  if k == 1 { return a1 }
  return a2
}
const rs = retSet([1.5], ["x"], [6, 7], 2)
if rs is i32[] { print(rs.length) } else { print(-1) }
function lol(a0: f64[], a1: string[], a2: i32[]) {
  const xs = [a0, a1, a2]
  const e = xs[2]
  if e is i32[] { print(e.length) } else { print(-1) }
}
lol([1.5], ["x"], [6, 7])
function g<T0, T1, T2>(a0: T0[], a1: T1[], a2: T2[], k: i32) {
  const r = match k {
    0 => a0
    1 => a1
    _ => a2
  }
  print(r.length)
}
g([1.5], ["x"], [6, 7], 2)
function ks(a0: string[], a1: f64[], a2: K[], k: i32) {
  const r = match k {
    0 => a0
    1 => a1
    _ => a2
  }
  if r is f64[] { print(-1) } else { print(4) }
}
ks(["x"], [1.5], ["a", "b", "a", "b"], 2)
