// Regression (D2495, D2496 — plumb PL-040). A function whose tail is an `if` ending in an
// assignment yields the assigned value, `null` where it falls through: a nullable list of any
// element type has a fall-through `null`, and a computed-index or map write is a value.
type S = { iocp: i64, skip: boolean }
const portQueues: {[i32]: i64[]} = Map()
function complete(s: S, ov: i64, atOnce: boolean) {
  __store_i64__(64, ov)
  if s.iocp != 0 && !(atOnce && s.skip) {
    const q = portQueues[s.iocp as% i32] ?? []
    q.push(ov)
    portQueues[s.iocp as% i32] = q
  }
}
complete({ iocp: 5, skip: false }, 1, false)
print("taken ok")
complete({ iocp: 0, skip: false }, 1, false)
print("not taken ok")
const got = complete({ iocp: 6, skip: false }, 7, false)
print(got == null)
if got != null { print(got[0]) }
print(complete({ iocp: 0, skip: false }, 7, false) == null)
print((portQueues[5] ?? []).length + (portQueues[6] ?? []).length)

// D2495: the fall-through `null` of a nullable list at a distinct-backing element type.
function f64s(k: i32): f64[] | null {
  if k != 0 { return [0.5, 1.5] }
}
print(f64s(1) == null)
print(f64s(0) == null)
const fs = f64s(2)
if fs != null { print(fs[1]) }
function strs(k: i32) {
  if k != 0 { ["a"] }
}
print((strs(1) ?? ["b"])[0])

// D2496: a map or computed-index write at the tail is the function's value.
const byKey: {[i32]: i32} = Map()
function put(k: i32) { byKey[k] = k * 2 }
print(put(1) + put(1))
const cells = [0, 0, 0, 0]
function setCell(k: i32) {
  if k > 1 { cells[k] = k * 2 } else { cells[k] = -1 }
}
print(setCell(3) + cells[3] - 4)
print(setCell(4 - 3) + 7)
const names: {[i32]: string} = Map()
function name(k: i32) {
  match k {
    0 => {
      names[k] = "none"
    }
    _ => {
      names[k] = "s" + "x"
    }
  }
}
print(name(1))
print(name(0))
function maybeSet(k: i32) {
  if k != 0 { byKey[k] = k * 2 }
}
print(maybeSet(3) ?? -1)
print(maybeSet(0) ?? 0)
print((byKey[3] ?? -1) - 2)
const later = (k: i32) => {
  if k != 0 { names[k] = "a" }
}
print(later(3) ?? "none")
print(later(0) ?? "none")
later(4)
print(names[4] ?? "none")

// D2019 and D2200: a computed-index, nested-receiver or wider-field tail write, and a returned
// closure whose tail is one.
function atIx(a: i32[], i: i32) { a[i] = 5 }
print(atIx([0, 0], 1))
function nested(o: { q: { x: i32 } }) { o.q.x = 5 }
print(nested({ q: { x: 0 } }))
function wider(o: { x: f64 }) { o.x = 5 }
print(wider({ x: 1.5 }))
const xs = [1, 2, 3]
const k = 2
function mkc() {
  return () => {
    xs[k] = 100
  }
}
const c = mkc()
c()
print(xs[2])

// A map or function value written in every arm has no inferred-return rep, so the function
// stays void and runs as a statement.
const mm: {[i32]: {[i32]: i32}} = Map()
const e: {[i32]: i32} = Map()
function both(flag: boolean, k: i32) {
  if flag { mm[k] = e } else { mm[k + 1] = e }
}
both(true, 1)
both(false, 1)
print(mm.length)
const fns: {[i32]: (i32) => i32} = Map()
function chain(flag: boolean, k: i32) {
  if flag { fns[k] = (n) => n + 1 }
  else if k == 99 { fns[k] = (n) => n + 2 }
}
chain(true, 1)
chain(false, 2)
chain(false, 99)
const f99 = fns[99]
if f99 != null { print(f99(1)) }
