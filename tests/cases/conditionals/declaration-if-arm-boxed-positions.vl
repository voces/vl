// @run
// @log 1.5
// @log 2.5
// @log 3.5
// @log s
// @log 4.5
// @log -1
// @log 5.5
// @log one
// @log none
// @log 6.5
// @log e
// @log false
// @log true
// A declaration `if` written per arm into a boxed binding, whose arm value the checker records no
// box for (a desugared `??`'s narrowed arm): the arm is boxed at the binding's union as legacy's
// `emitUnionBoxOwed` does. Q58 sweep of the per-arm write: a `??` into a nullable and into a union
// (the binding sink), an else-less `if`, an `else if` chain, an arm with a prelude, and each in a
// generic instance.
function popNul(xs: f32[], d: f32 | null) {
  const t = xs.pop()
  const r = t ?? d
  print(r ?? -1.0)
}
function popStr(xs: f32[]) {
  const t = xs.pop()
  const r = t ?? "s"
  print(r)
}
function elseLess(xs: f32[], c: boolean) {
  const t = xs.pop()
  const r = if c && t != null { t } else { null }
  print(r ?? -1.0)
}
function chain(xs: f32[], k: i32) {
  const t = xs.pop()
  const r = if k == 0 && t != null { t } else if k == 1 { "one" } else { null }
  print(r ?? "none")
}
function prelude(xs: f32[]) {
  const t = xs.pop()
  const r = if t != null {
    const u = t
    u
  } else {
    "e"
  }
  print(r)
}
function inst<T>(xs: T[], d: T | null) {
  const t = xs.pop()
  const r = t ?? d
  print(r == null)
}

popNul([1.5], null)
popNul([], 2.5)
popStr([3.5])
popStr([])
elseLess([4.5], true)
elseLess([4.5], false)
chain([5.5], 0)
chain([5.5], 1)
chain([5.5], 2)
prelude([6.5])
prelude([])
inst([1], null)
inst<string>([], null)
