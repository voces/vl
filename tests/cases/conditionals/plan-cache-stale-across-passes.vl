// @run
// @log 1
// @hint redundant type annotation: `run` is inferred as `i32`
// @warning Unused variable `done` (prefix with `_` to suppress, or remove it)
// D2389 — `parentLetOf`'s single-entry cache, keyed only by blockIx, held `insert`'s plan
// from its FIRST call and never rebuilt it after that call's own rewrite spilled a tail
// temp into the same body; a program with no top-level statements has nothing to evict it
// by accident, unlike master's own start-block scan.
type Node = { v: i32, left: Node | null }
function insert(n: Node, v: i32) {
  if n.left == null { n.left = { v: v, left: null } } else { insert(n.left, v) }
}
function run(): i32 {
  const root: Node = { v: 5, left: null }
  insert(root, 3)
  insert(root, 1)
  print(1)
  0
}
const done = run()
