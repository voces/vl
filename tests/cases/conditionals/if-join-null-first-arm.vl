// @run
// @log 0
// @log 3.5
// @log hi
// @log true
// @log 6
// @log 3
// @log ret
// @log 8
// @log true
// @log 3
// @log m
// @log 2.5
// @log true
// @log 11
// @log dflt
// @log false
// @log 42
// @log true
// @hint redundant type annotation: `xs` is inferred as `string[] | null`
// @hint redundant type annotation: `q` is inferred as `{x: i32}`
// @hint redundant type annotation: `m1` is inferred as `string[] | null`
// A join's rep comes from its first arm that is not a bare `null`, whatever the arm order
// (D2227): a `null` then arm has no rep to pick a blocktype from. A `null` arm in the middle
// of an `else if` chain or a `match`, and a join whose every arm is `null`, are the same question.

type P = { x: i32 }

let k = 0
function no() {
  k = k + 1
  1 == 2
}
function yes() {
  k = k + 10
  1 == 1
}
function one() { 3 }

// null first, a list after it, annotated and not
const xs: string[] | null = if yes() { null } else { ["a"] }
if xs != null { print(xs.length) } else { print(0) }
const ys = if no() { null } else { [(1.5 as f32), (2.0 as f32)] }
if ys != null { print(ys[0] + ys[1]) }

// null first over a scalar niche, a string and a struct
const s1 = if no() { null } else { "hi" }
print(s1 ?? "none")
const b1 = if no() { null } else { true }
print(b1 ?? false)
const n1 = if no() { null } else { 6 }
print(n1 ?? 0)
const q: P = { x: 3 }
const p1 = if no() { null } else { q }
if p1 != null { print(p1.x) }
function pick(c: boolean) {
  if c { null } else { "ret" }
}
print(pick(false) ?? "none")

// a null arm inside an else-if chain, first or in the middle
const c1 = if no() { null } else if no() { null } else { [7, 8] }
if c1 != null { print(c1[1]) }
const c2 = if no() { [1] } else if yes() { null } else { [5, 6] }
print(c2 == null)
const c3 = if no() { null } else if no() { null } else { q }
if c3 != null { print(c3.x) }

// match arms desugar to the same chain
const m1: string[] | null = match one() {
  1 => null
  2 => null
  _ => ["m"]
}
if m1 != null { print(m1[0]) }
const m2 = match one() {
  1 => null
  2 => null
  _ => 2.5
}
print(m2 ?? 0.0)

// every arm null: the value is the null its destination takes, and each condition still runs once
k = 0
const a1 = if no() { null } else if yes() { null } else { null }
print(a1 == null)
print(k)
const a2: string | null = if no() { null } else { null }
print(a2 ?? "dflt")
const a3: boolean | null = if no() { null } else { null }
print(a3 ?? false)
const a4: i32 | null = if no() { null } else { null }
print(a4 ?? 42)
function nothing(c: boolean) {
  if c { null } else { null }
}
print(nothing(true) == null)
