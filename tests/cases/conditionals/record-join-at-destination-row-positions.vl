// @run
// @log 2.5
// @log 3.5
// @log 4.5
// @log 5.5
// @log 6.5
// @log 7.5
// @log 8.5
// @log 9.5
// @log 9.5
// @log 1
// @log 2
// @log 3
// @log 4
// @log 5
// @log 6
// @log 7
// @log 8
// @log i8
// A value `if` of record literals delivered to a record whose field is a numeric union is built at
// that record's row, each literal built as it (D15020). Q58 sweep of the join: a record and a union
// argument, a nested argument, a return, a binding, an `if` arm, a `??` operand and a record
// field; its field read at concat and interpolation.
import { toString } from "std:fmt"

type R = { f: i32 | f64 }
function show(r: R) { print(r.f) }
function showU(r: R | string) {
  if r is R { print(r.f) } else { print(r) }
}
function id<T>(t: T): T { return t }
function pArg(b: boolean) { show(if b { { f: 2.5 } } else { { f: 1 } }) }
function pUnion(b: boolean) {
  const r: R = if b { { f: 3.5 } } else { { f: 2 } }
  showU(r)
}
function pNested(b: boolean) {
  show(id<R>(if b { { f: 4.5 } } else { { f: 3 } }))
}
function pRet(b: boolean): R { return if b { { f: 5.5 } } else { { f: 4 } } }
function pLet(b: boolean) {
  const r: R = if b { { f: 6.5 } } else { { f: 5 } }
  show(r)
}
function pIf(b: boolean, c: boolean) {
  const r: R = if c { if b { { f: 7.5 } } else { { f: 6 } } } else { { f: 0 } }
  show(r)
}
function pCoal(b: boolean) {
  const o: R | null = if b { { f: 8.5 } } else { { f: 7 } }
  show(o ?? { f: 0 })
}
function pField(b: boolean) {
  const h: { r: R } = { r: if b { { f: 9.5 } } else { { f: 8 } } }
  show(h.r)
  const x = h.r.f
  if x is i32 { print("i" + toString(x)) } else { print("\{x}") }
}
for b in [true, false] {
  pArg(b)
  pUnion(b)
  pNested(b)
  show(pRet(b))
  pLet(b)
  pIf(b, true)
  pCoal(b)
  pField(b)
}
