// @run
// @log 1
// @log 1
// @log 5
// @log B
// @log 3
// @log 3
// @log 9
// @log 9
// @log 9
// @log a
// @log null
// @log b
// @log 6
// @log -1
// @log 6
// @log 5
// A returned value `if` is the tail `if`: `return if c { a } else { b }` lowers, reserves and
// infers exactly as the body-tail `if c { a } else { b }` does (D16460, D16461, D16462, D16464).

// Each arm is its own exit, so an arm the other arm's type does not fit is no join (D16460).
function popOrPush(xs: i32[], c: boolean) {
  return if c { xs.pop() } else { xs.push(7) }
}
print(popOrPush([1], true))
function popOr(xs: i32[], c: boolean): i32 | null {
  return if c { xs.pop() } else { 7 }
}
print(popOr([1], true))

// A `??` delivered into a wider number converts at each operand (D16460).
type E = 9000000000 | 1 | null
function orFive(x: E): f64 { return x ?? 5 }
print(orFive(null))

// A nested arm widening an atom reserves the string frame, as the tail does (D16461).
type K = "A" | "B"
function nestedAtom(k: K, c: boolean): string {
  return if c { if c { k } else { "A" } } else { "A" }
}
print(nestedAtom("B", true))

// A recursive function with no declared result yields its arms' values (D16462).
type Node = { v: i32, left: Node | null }
function insert(n: Node, v: i32) {
  return if n.left == null { n.left = { v: v, left: null } } else { insert(n.left, v) }
}
const fresh: Node = { v: 1, left: null }
print(insert(fresh, 3).v)
const kept: Node = { v: 1, left: null }
insert(kept, 3)
print(kept.left?.v ?? 0)
insert(kept, 4).v = 9
print(kept.left?.left?.v ?? 0)
type Acc = { x: f64 }
function bump(b: Acc, k: i32) {
  return if k == 0 { b.x = 9 } else { bump(b, k - 1) }
}
const acc: Acc = { x: 1.5 }
print(bump(acc, 2))
print(acc.x)

// The control: a generic's returned join of its `K` pin, `null` and a member keeps running.
type L = "a" | "b"
function g<T>(a0: T, k: i32) {
  return if k == 0 { a0 } else if k == 1 { null } else { "b" }
}
const x0: L = "a"
print(g(x0, 0))
print(g(x0, 1))
print(g(x0, 2))

// An else-less chain falls through to the nullable result's `null`, as the tail does (D2051).
function elseLess(k: i32): i32 | null {
  return if k == 0 { 5 } else if k == 1 { 6 }
}
print(elseLess(1) ?? -1)
print(elseLess(2) ?? -1)

// An arm's field write yields the value written, not the field re-read at its rep (D16464).
type O = { f: i32 | null }
function writeArm(o: O, c: boolean) { return if c { o.f = 5 } else { 2 } }
const o: O = { f: null }
print(writeArm(o, true) + 1)
print(o.f ?? 0)
