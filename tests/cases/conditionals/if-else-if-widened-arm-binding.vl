// @run
// @hint redundant type annotation: `x` is inferred as `f64 | null` — remove it to lean on inference
// @hint redundant type annotation: `s` is inferred as `string | f64` — remove it to lean on inference
// An `else if` whose own join widens a scalar is one arm of a nullable or union binding, annotated
// or inferred.
function f(a: boolean, q: i32 | null, r: i32 | null) {
  const x: f64 | null = if a { null } else if q != null { q } else { 2.5 }
  print(x ?? -1.0)
  const s: string | f64 = if a { "s" } else if r != null { r } else { 0.5 }
  print(s)
}
function g(a: boolean, q: i32 | null, r: i32 | null) {
  const x = if a { null } else if q != null { q } else { 2.5 }
  print(x ?? -1.0)
  const s = if a { "s" } else if r != null { r } else { 0.5 }
  print(s)
}
f(true, 3, 4)
f(false, 3, 4)
f(false, null, null)
g(true, 3, 4)
g(false, 3, 4)
g(false, null, null)
// @log -1
// @log s
// @log 3
// @log 4
// @log 2.5
// @log 0.5
// @log -1
// @log s
// @log 3
// @log 4
// @log 2.5
// @log 0.5
