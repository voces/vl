// @run
// The `if` nested in an arm of an annotated union return is a join of its own: `r` beside
// `2.5` is `f64` there too, in the block, `else if` and explicit `return` spellings (D3656).
function mk(q: i32 | null, r: i32 | null): i32 | f64 {
  if q != null {
    q
  } else {
    if r != null { r } else { 2.5 }
  }
}
function chain(q: i32 | null, r: i32 | null): i32 | f64 {
  if q != null { q }
  else if r != null { r }
  else { 2.5 }
}
function ret(q: i32 | null, r: i32 | null): i32 | f64 {
  return if q != null { q } else { if r != null { r } else { 2.5 } }
}
const x = mk(null, -3)
print(x is f64)
print(x / 2)
print(chain(null, -3) is f64)
print(ret(null, -3) is f64)
print(mk(4, null) is i32)
// @log true
// @log -1.5
// @log true
// @log true
// @log true
