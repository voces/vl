// @run
// @log f ran
// @log 1
// @log f ran
// @log true
// @log f ran
// @log null
// @log f ran
// @log -1
// @log f ran
// @log 9
// @log f ran
// @log n ran
// @log 6
// @log true
// @log true
// @log nil
// @log true
// @log false
// A join whose every arm is `null` is the `null` type, and it still runs: each condition once,
// each arm's calls, in every position that reads the value without keeping it — a box, `??`,
// a folded `== null`, `print` (D2227). A nested all-`null` if in an arm is itself a `null` arm.

let k = 0
function f() {
  k = k + 1
  print("f ran")
  false
}
function n() {
  print("n ran")
  null
}
function take(x: i32 | null) { print(x ?? -1) }

const v1: i32 | null = if f() { null } else { null }
print(v1 ?? k)
print((if f() { null } else { null }) == null)
print(if f() { null } else { null })
take(if f() { null } else { null })
const v2 = (if f() { null } else { null }) ?? 9
print(v2)
const v3: i32 | null = if f() { n() } else { n() }
print(v3 ?? k)

const a = 1 == 2
const d1 = if a { null } else { if a { null } else { null } }
print(d1 == null)
const d2 = if a { if a { null } else { null } } else { null }
print(d2 == null)
const d3: string | null = if a { null } else { if a { null } else { null } }
print(d3 ?? "nil")

function mk(c: boolean): boolean | null {
  if c { null } else { true }
}
const nb = mk(false)
const zb = mk(true)
function show(b: boolean | null) { print(b ?? false) }
show(if nb == null { null } else { nb })
show(if zb == null { null } else { zb })
