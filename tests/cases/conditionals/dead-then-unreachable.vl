// @run
// @log a
// @log 5
// @warning this branch can never run (`v` is always `i32`)
// A dead `then` under `!` is `unreachable` in both emitters (D16006).
function k(v: i32 | string) {
  if v is string {
    print(v)
  } else {
    if !(v is i32) { print("NEVER") } else { print(v) }
  }
}
k("a")
k(5)
