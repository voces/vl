// @run
// @hint redundant type annotation: `isArm` is inferred as `i32` — remove it to lean on inference
// @log 4
// @log 1
// @log 3
// @log 0
// @log 3
// @log 1.5
// @log false
// @log true
// @log 8
// @log -2
// @log -2
// @log 2
// @log 2
// @log 3
// @log zz
// @log 8
// An un-annotated binding of an `if` whose then arm is narrowed by the `if`'s own condition
// takes the join's scalar cell, not the arm's declared union box: the classifier reads the arm
// where no narrow is active, so the join's own type decides (D2264, D2322).

function nonNull(n: i32 | null) {
  const w = if n != null { n } else { 0 }
  print(w + 1)
}

function isArm(x: i32 | string): i32 {
  const n = if x is i32 { x } else { 0 }
  n
}

function wide(n: f64 | null) {
  const w = if n != null { n } else { 0.5 }
  print(w + 1.0)
}

function flag(b: boolean | null) {
  const w = if b != null { b } else { false }
  print(!w)
}

function nulArm(x: i32 | string | null) {
  let v = if x is i32 { x } else { -1 }
  v = v * 2
  print(v)
}

function big(x: i64 | string, z: i64) {
  const w = if x is i64 { x } else { z }
  print(w + z)
}

function stillUnion(x: i32 | string) {
  const w = if x is i32 { x } else { "zz" }
  print(w)
}

const g: i32 | null = 7
const gw = if g != null { g } else { 0 }

nonNull(3)
nonNull(null)
print(isArm(3))
print(isArm("a"))
wide(2.0)
wide(null)
flag(true)
flag(null)
nulArm(4)
nulArm("s")
nulArm(null)
const z: i64 = 1
big(z, z)
big("q", z)
stillUnion(3)
stillUnion("a")
print(gw + 1)
