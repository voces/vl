// @run
// @log 2
// @log 2
// @log 2
// @log 1.5
// @log 2
// @log 1
// @hint redundant type annotation: `ai` is inferred as `i64[]`
// @hint redundant type annotation: `takesI` is inferred as `i32`
// @hint redundant type annotation: `ad` is inferred as `f64[]`
// @hint redundant type annotation: `bd` is inferred as `f64[]`
// @hint redundant type annotation: `takesF` is inferred as `i32`
// @hint redundant type annotation: `z` is inferred as `f32[]`
// @hint redundant type annotation: `takesM` is inferred as `i32`
// @hint redundant type annotation: `ap` is inferred as `{v: i32}`
// @hint redundant type annotation: `bp` is inferred as `{v: i32}`
// @hint redundant type annotation: `z` is inferred as `P`
// The REF-typed if-expression join classifies from ONE ladder, and it knew four of the
// seven ref shapes a join can have.
//
// `ifExprRefKind` had arms for closure / string / `string[]` / `f64[]` / `S[]` / `i32[]` /
// struct — no `i64[]`, no `f32[]`, no map. Its fallthrough is not "some other ref": it is
// `null`, which routes the whole if-expression to the SINGLE-BYTE numeric blocktype path
// (`ifExprValtype`, i32 by default). So `if flag { a } else { b }` over two `i64[]` values
// emitted `if (result i32)` over two arms each pushing `(ref $il64Wrapper)` — `vl check`
// clean, INVALID WASM at instantiation (`type mismatch`). The `f64[]` rows are the oracle:
// identical programs that have always run, which is what makes this a missing arm.
//
// The scalar-list arms run in `scalarListElemKind`'s order — f32 BEFORE f64, because
// `exprF64Array`'s typed-IR fast path would otherwise claim an `f32[]` join. A map join's
// blocktype selects THIS value-shape's `$mapStruct`, so `ifExprRefSlot` answers the map
// SHAPE for it, the same value every other map valtype site passes.

type P = { v: i32 }

const flag = true

// ---- i64[] — the arm that did not exist ----
const ai: i64[] = [5000000000, 2]
const bi: i64[] = [3]
function takesI(z: i64[]): i32 { z.length }
print(takesI(if flag { ai } else { bi }))

// ---- f64[] — the ORACLE: green before and after ----
const ad: f64[] = [1.5, 2.5]
const bd: f64[] = [3.5]
function takesF(z: f64[]): i32 { z.length }
print(takesF(if flag { ad } else { bd }))

// ---- f32[] ----
const as32: f32[] = [1.5, 2.5]
const bs32: f32[] = [3.5]
function goF32() {
  const z: f32[] = if flag { as32 } else { bs32 }
  print(z.length)
  print(z[0])
}
goF32()

// ---- map ----
const am: {[string]: i32} = Map()
am.set("x", 1)
am.set("y", 2)
const bm: {[string]: i32} = Map()
function takesM(z: {[string]: i32}): i32 { z.length }
print(takesM(if flag { am } else { bm }))

// ---- CONTROL: a struct join, the pinned pre-existing arm ----
const ap: P = { v: 1 }
const bp: P = { v: 2 }
function goP() {
  const z: P = if flag { ap } else { bp }
  print(z.v)
}
goP()
