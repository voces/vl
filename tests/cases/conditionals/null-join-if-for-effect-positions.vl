// @run
// @log a1
// @log -1
// @log a2
// @log -2
// @log a3
// @log -1
// @log a4
// @log -1
// @log a5
// @log -5
// @log a6
// @log -6
// @log a7
// @log 7
// @log a8
// @log -8
// @log y8
// @log 9
// @log -1
// @log -2
// @log -1
// @log -1
// @log b5
// @log -5
// @log -6
// @log 7
// @log -8
// @log y8
// @log 9
// @hint redundant type annotation: `y` is inferred as `i32 | null` — remove it to lean on inference
// A value `if` whose join is the `null` type runs for its effects, then is its destination's null.
// Q58 sweep of the join: a nullable and a union argument, a nested argument, a return, a binding,
// an `if` arm, a `??` operand and a record field; `null` has no concat or interpolation position,
// the `??` over it does.
import { toString } from "std:fmt"

function take(a: i32 | null) { return a ?? -1 }
function takeU(a: i32 | string | null) { return if a is i32 { a } else { -2 } }
function id<T>(t: T): T { return t }
function pArg(f: boolean) {
  print(take(if f { print("a1") null } else { null }))
}
function pUnion(f: boolean) {
  print(takeU(if f { print("a2") null } else { null }))
}
function pNested(f: boolean) {
  print(take(id(if f { print("a3") null } else { null })))
}
function pRet(f: boolean): i32 | null {
  return if f { print("a4") null } else { null }
}
function pLet(f: boolean) {
  const y = if f { print("a5") null } else { print("b5") null }
  print(y ?? -5)
}
function pIf(f: boolean, g: boolean) {
  const y: i32 | null = if g { if f { print("a6") null } else { null } } else { 6 }
  print(y ?? -6)
}
function pCoal(f: boolean) {
  const y = if f { print("a7") null } else { null }
  print(y ?? 7)
}
function pField(f: boolean) {
  const r: { y: i32 | null } = { y: if f { print("a8") null } else { null } }
  print(r.y ?? -8)
  print("y" + toString(r.y ?? 8))
  print("\{r.y ?? 9}")
}
for f in [true, false] {
  pArg(f)
  pUnion(f)
  pNested(f)
  print(take(pRet(f)))
  pLet(f)
  pIf(f, true)
  pCoal(f)
  pField(f)
}
