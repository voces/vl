// @run
// @log 2
// @log 0
// @log 7
// Regression (D2631; plumb PL-044). An `if` in statement position discards its value, so its
// arms' join is never typed: an arm assigning a vector beside one assigning an `i64` is not an
// `i64 | v128`, before the tail, in a loop body, or at the top level.
function f(c: boolean): v128 {
  let x = __splat_i32x4__(0)
  let r: i64 = 0
  if c { r = 1 } else { x = __splat_i32x4__(2) }
  x
}
print(__extract_lane_i32x4__(f(false), 0))
print(__extract_lane_i32x4__(f(true), 0))

let v = __splat_i32x4__(0)
let n: i64 = 0
let i = 0
while i < 2 {
  if i == 0 { n = 5 } else { v = __splat_i32x4__(7) }
  i = i + 1
}
if n == 0 { n = 1 } else { v = __splat_i32x4__(7) }
print(__extract_lane_i32x4__(v, 0))
