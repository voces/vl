// @run
// @log 0
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// @log 2
// @log 0
// Regression (silent-class-inventory D1034).
//
// An `if`/`else` with ONE EMPTY BRANCH inside a void function was check-clean and TRAPPED on
// a compiler-emitted `unreachable` — either branch empty, either branch taken. Found building
// `std/json.vl`, whose renderer was void and whose f64 arm was `if isFiniteF64(v) { } else {
// rendFail(…) }`.
//
// TWO GATES HAD TO MOVE, and finding only the first one looks like progress. `ifTailIsValue`
// asks "does ANY arm end in a bare value", which is the right question for choosing
// `emitIfTail` and the wrong one for the `fRetVoid` fixpoint it also feeds: one arm had a
// value and the other had no tail at all. Fixing that alone changed nothing, because the
// CHECKER independently infers `i32 | null` for the same shape — one arm's value, the other's
// absence — and `inferRetBearsNull` kept the function non-void on its own. An arm written
// EMPTY is the author saying there is no value here; the nullable inference was reading that
// absence as a null a caller could receive.
//
// NOT WIDENED TO "EVERY ARM MUST BE A VALUE", which is the tempting form and is too strong:
// an arm ending in an explicit `return x` is not a bare tail value, so requiring both would
// reclassify the working `if c { return 1 } else { 2 }` below as void. EMPTINESS is the
// measured ingredient — both arms non-empty runs, and so does the else-less `if` — so
// emptiness is what the decline keys on. That control is in this file for exactly that
// reason.
function f(c: boolean, buf: i32[]) {
  if c {
  } else {
    buf.push(1)
  }
}

// 1 — the empty branch TAKEN, and 2 — the populated one
const b1: i32[] = []
f(true, b1)
print(b1.length)
const b2: i32[] = []
f(false, b2)
print(b2.length)

// 3 — the mirror: empty ELSE
function g(c: boolean, buf: i32[]) {
  if c {
    buf.push(1)
  } else {
  }
}
const b3: i32[] = []
g(true, b3)
print(b3.length)

// 4 — both arms non-empty: always ran, must keep running
function h(c: boolean, buf: i32[]) {
  if c {
    buf.push(2)
  } else {
    buf.push(1)
  }
}
const b4: i32[] = []
h(true, b4)
print(b4.length)

// 5 — the else-less `if`, which the void fixpoint deliberately ignores
function k(c: boolean, buf: i32[]) {
  if c {
  }
  buf.push(1)
}
const b5: i32[] = []
k(true, b5)
print(b5.length)

// 6 and 7 — THE CONTROL AN "every arm must be a value" FIX WOULD BREAK: one arm returns
// explicitly, the other is a bare tail value.
function r(c: boolean): i32 {
  if c { return 1 } else { 2 }
}
print(r(true))
print(r(false))

// 8 — an `else if` CHAIN whose first arm is empty
function e(c: i32, buf: i32[]) {
  if c == 0 {
  } else if c == 1 {
    buf.push(1)
  } else {
    buf.push(2)
  }
}
const b8: i32[] = []
e(0, b8)
print(b8.length)
