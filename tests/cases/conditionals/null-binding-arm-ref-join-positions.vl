// @run
// @log -1
// @log -2
// @log -1
// @log -1
// @log -1
// @log -1
// @log 0
// @log -1
// @log v-1
// @log -1
// @log 1
// @log 2
// @log 3
// @log 4
// @log 5
// @log 6
// @log 7
// @log 8
// @log v8
// @log 8
// A value `if` whose arm reads a `null`-typed binding, joined with a record arm at a nullable
// record: the arm is the bottom ref the join holds as it stands. Q58 sweep of the join: a nullable
// and a union argument, a nested argument, a return, a binding, an `if` arm, a `??` operand and a
// record field; a record has no concat or interpolation position, its field read does.
import { toString } from "std:fmt"

type In = { v: i32 }
const n = null
function take(a: In | null) { return if a == null { -1 } else { a.v } }
function takeU(a: In | string | null) { return if a is In { a.v } else { -2 } }
function id<T>(t: T): T { return t }
function pArg(f: boolean) { print(take(if f { n } else { { v: 1 } })) }
function pUnion(f: boolean) {
  const a: In | null = if f { n } else { { v: 2 } }
  print(takeU(a))
}
function pNested(f: boolean) { print(take(id(if f { n } else { { v: 3 } }))) }
function pRet(f: boolean): In | null { return if f { n } else { { v: 4 } } }
function pLet(f: boolean) {
  const a: In | null = if f { n } else { { v: 5 } }
  print(take(a))
}
function pIf(f: boolean, g: boolean) {
  const a: In | null = if g { if f { n } else { { v: 6 } } } else { null }
  print(take(a))
}
function pCoal(f: boolean) {
  const a: In | null = if f { n } else { { v: 7 } }
  print((a ?? { v: 0 }).v)
}
function pField(f: boolean) {
  const a: In | null = if f { n } else { { v: 8 } }
  const r = { a: a }
  print(take(r.a))
  print("v" + toString(take(a)))
  print("\{take(a)}")
}
for f in [true, false] {
  pArg(f)
  pUnion(f)
  pNested(f)
  print(take(pRet(f)))
  pLet(f)
  pIf(f, true)
  pCoal(f)
  pField(f)
}
