// @run
// @log 5
// @log null
// @log 6
// @log 5
// @log null
// @log 6
// @log a
// @log null
// @log 5
// @log null
// @log 6
// @log 7
// @log null
// @log 1
// @log null
// @log 5
// @log null
// @log null
// @log 5
// @log null
// @log false
// @log true
// @log 5
// @log a
// @log null
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_u` (leading `_` marks it unused)
// Owner ruling on D1995: an else-less `if` ending an arm of a tail `if`/`else` or `match` is a
// value, `T | null`, at any depth; an exiting then-arm leaves the `null` path (D2037 generic).
type P = { a: i32 }

// Un-annotated, depth 1: infers `i32 | null`.
function f(c: boolean, d: boolean) {
  if c {
    if d { 5 }
  } else {
    6
  }
}
print(f(true, true))
print(f(true, false))
print(f(false, true))

// Depth 3, with an exiting innermost arm.
function g(c: boolean, d: boolean) {
  if c {
    if d {
      if d { return 5 }
    }
  } else {
    6
  }
}
print(g(true, true))
print(g(true, false))
print(g(false, false))

// A string, and a struct through the annotated `T | null` face.
function s(c: boolean, d: boolean) {
  if c {
    if d { "a" }
  } else {
    "b"
  }
}
print(s(true, true))
print(s(true, false))
function p(c: boolean, d: boolean): P | null {
  if c {
    if d { { a: 5 } }
  } else {
    { a: 6 }
  }
}
const p1 = p(true, true)
if p1 != null { print(p1.a) }
const p2 = p(true, false)
if p2 == null { print("null") }
const p3 = p(false, true)
if p3 != null { print(p3.a) }

// A `match` arm.
function m(k: i32, d: boolean) {
  match k {
    1 => {
      if d { 7 }
    }
    _ => {
      8
    }
  }
}
print(m(1, true))
print(m(1, false))

// A generic whose fall-through makes its return `i32 | null` (D2037).
function gen<T>(c: boolean, _x: T) {
  if c { return 1 }
  if c { 2 }
}
print(gen(true, 3))
print(gen(false, 3))

// A function TAIL whose else-less `if` ends in another: un-annotated and `: i32 | null`.
function w(c: boolean, d: boolean) {
  if c {
    if d { 5 }
  }
}
print(w(true, true))
print(w(true, false))
function wa(c: boolean, d: boolean): i32 | null {
  if c {
    if d { 5 }
  }
}
print(wa(false, true))

// A lambda, and the niche-typed struct and list values.
const lw = (c: boolean, d: boolean) => {
  if c {
    if d { 5 }
  }
}
print(lw(true, true))
print(lw(true, false))
function ws(c: boolean, d: boolean) {
  if c {
    if d { { a: 5 } }
  }
}
print(ws(true, true) == null)
print(ws(true, false) == null)
function wl(c: boolean, d: boolean) {
  if c {
    if d { [5] }
  }
}
const l1 = wl(true, true)
if l1 != null { print(l1[0]) }

// A generic string instance (D2037 at a ref type).
function gs<U>(c: boolean, d: boolean, _u: U) {
  if c {
    if d { return "a" }
  } else {
    "b"
  }
}
print(gs(true, true, 1))
print(gs(true, false, 1))
