// @run
// An `if` nested in an `else` arm is a join of its own: `r` beside `2.5` is `f64`, and the
// outer union holds that `f64`, in the block spelling and the `else if` spelling alike (D3571).
function run(q: i32 | null, r: i32 | null) {
  const x = if q != null { q } else { if r != null { r } else { 2.5 } }
  print(x / 2)
}
function chain(q: i32 | null, r: i32 | null) {
  const x = if q != null { q } else if r != null { r } else { 2.5 }
  print(x / 2)
}
run(null, -3)
run(4, null)
chain(null, -3)
chain(null, null)
// @log -1.5
// @log 2
// @log -1.5
// @log 1.25
