// @run
// @log 3
// @log 4
// @log 3
// @log 5
// @log 9
// @log 5
// @log 3
// @log 7
// @log 4
// @log 3
// @log 3
// @log 3
// @log 3
// @log 5
// @hint redundant type annotation: `acc` is inferred as `{x: f64}`
// Regression (D2170). A function with no declared result whose tail `if` pairs a field write
// with a value arm yields the write's right-hand side from that arm, and an `if` joining two
// struct locals returns the struct. Each arm below used to trap `unreachable` or fail to validate.
type Node = { v: i32, left: Node | null }

function insert(n: Node, v: i32) {
  if n.left == null { n.left = { v: v, left: null } } else { insert(n.left, v) }
}
const root: Node = { v: 5, left: null }
insert(root, 3)
insert(root, 4)
print(root.left?.v ?? 0)
print(root.left?.left?.v ?? 0)

// The value used: the arm yields the record it stored.
const fresh: Node = { v: 1, left: null }
print(insert(fresh, 3).v)

// Both arms write, one of them through a narrowed field.
function both(n: Node, v: i32) {
  const m: Node = { v: v, left: null }
  if n.left == null { n.left = m } else { n.left = m }
}
print(both(root, 5).v)

// A field wider than the value: an f64 field written an integer yields the integer.
type Acc = { x: f64 }
function bump(b: Acc, k: i32) {
  if k == 0 { b.x = 9 } else { bump(b, k - 1) }
}
const acc: Acc = { x: 1.5 }
print(bump(acc, 2))

// A name's write in an arm yields the name's cell.
function rebind(n: Node, v: i32) {
  if n.left == null { n = { v: v, left: null } } else { rebind(n.left, v) }
}
print(rebind(fresh, 5).v)

// A `match` tail, and mutual recursion.
type Cmd = "add" | "skip"
function viaMatch(n: Node, v: i32, c: Cmd) {
  match c {
    "add" => {
      n.left = { v: v, left: null }
    }
    "skip" => {
      viaMatch(n, v, "add")
    }
  }
}
const m1: Node = { v: 0, left: null }
viaMatch(m1, 3, "skip")
print(m1.left?.v ?? 0)
function ping(n: Node, v: i32) {
  if n.v > 100 { n.left = { v: v, left: null } } else { pong(n, v) }
}
function pong(n: Node, v: i32) {
  if n.left == null { n.left = { v: v, left: null } } else { ping(n.left, v) }
}
const m2: Node = { v: 0, left: null }
ping(m2, 7)
print(m2.left?.v ?? 0)

// A generic frame at two types.
function tagged<T>(n: Node, v: i32, tag: T) {
  if n.left == null {
    n.left = { v: v, left: null }
  } else {
    tagged(n.left, v, tag)
  }
}
const m3: Node = { v: 0, left: null }
tagged(m3, 3, 1)
tagged(m3, 4, "s")
print(m3.left?.left?.v ?? 0)

// A module-block caller, and a module global written in an arm.
if true {
  const m4: Node = { v: 0, left: null }
  insert(m4, 3)
  print(m4.left?.v ?? 0)
}
let g: Node = { v: 1, left: null }
function toGlobal(v: i32) {
  if g.left == null {
    g.left = { v: v, left: null }
  } else {
    g = { v: 9, left: null }
  }
}
toGlobal(3)
print(g.left?.v ?? 0)

// An `if` joining two struct locals, bound first or returned directly.
function join(n: Node, v: i32) {
  const a: Node = { v: v, left: null }
  const r = if n.left == null { a } else { a }
  r
}
print(join(root, 3).v)
function joinDirect(n: Node, v: i32) {
  const a: Node = { v: v, left: null }
  if n.left == null { a } else { joinDirect(n.left, v) }
}
print(joinDirect(root, 3).v)

// A closure whose arm writes a field beside a void arm stays void.
function viaClosure() {
  const put = (n: Node, v: i32) => {
    if n.left == null { n.left = { v: v, left: null } } else { print(0) }
  }
  const m5: Node = { v: 0, left: null }
  put(m5, 5)
  print(m5.left?.v ?? 0)
}
viaClosure()
