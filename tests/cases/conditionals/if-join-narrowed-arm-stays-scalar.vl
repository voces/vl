// @run
// @log 18
// @log -3
// @log 5
// @log 1.5
// @log 3
// @log 9
// @log 4
// @log 0
// @log 2.5
// An `if` whose arm is a nullable binding narrowed by the `if`'s own condition joins to the
// bare scalar, not the nullable box: its value is used inline in arithmetic, returned, bound,
// passed and tested as the scalar. The then arm's declared type is not the join's (D2250).

function f(n: i32 | null) { print((if n != null { n } else { -1 }) * 3) }

function g(n: i32 | null): i32 {
  return if n != null { n } else { 0 }
}

function gf(n: f64 | null): f64 {
  return if n == null { 0.0 } else { n }
}

function h(n: i32 | null, k: i32 | null): i32 {
  return if n != null { n } else if k != null { k } else { 0 }
}

function twice(x: i32) { x * 2 }

function bind(n: i32 | null) {
  const x: i32 = if n != null { n } else { 0 }
  print(x + 4)
}

function pass(n: i32 | null) { print(twice(if n != null { n } else { 0 }) + 4) }

function arm(u: i32 | string) { print(if u is i32 { u } else { 0 }) }

function wide(n: f64 | null) {
  const x: f64 = if n != null { n } else { 0.5 }
  print(x)
}

f(6)
f(null)
print(g(5))
print(gf(1.5))
print(h(null, 3))
bind(5)
pass(0)
arm("s")
wide(2.5)
