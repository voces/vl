// @check
// @error named arguments require a declared function
// The UFCS spelling of D1604. `ld` denotes `go`'s parameter, so `b.ld(k: 3)` has no declaration
// to bind the name `k` against and is refused — the module `function ld`'s parameter list is not
// this callee's. Before the fix the checker read that list by name, returned rc 0, and the
// emitter refused with `named arguments require a declared function`.
function ld(self: {v: i32}, k: i32) { print(self.v + k) }
function go(b: {v: i32}, ld: ({v: i32}, i32) => void): void { b.ld(k: 3) }
const bx = { v: 1 }
const cl: ({v: i32}, i32) => void = (bb, kk) => { print(bb.v * kk) }
go(bx, cl)
