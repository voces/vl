// @run
// @log 1
// @log 9
// @hint redundant type annotation: `sv` is inferred as `{q: i32}`
// D1609 — the clause-2 face of the same resolver, and the control the refusal must not touch.
// The width-pair source `sv` in `go` is the un-annotated binding D938 exempts; the decoy above
// it is an annotated binding of that name in another scope. A resolver reading arena order
// found the decoy first, withdrew the exemption and refused a program that runs. `sv: Q` is
// load-bearing: without it the decoy is un-annotated too and the arms stop differing. The
// accepting side with no decoy in it is `object-shape-unannotated-literal-rebuilt.vl`.
type Narrow = { a: i32 }
type ON = { n: Narrow }
type Q = { q: i32 }

function decoy() {
  const sv: Q = { q: 9 }
  sv.q
}

function go() {
  const sv = { n: { a: 1, b: 2 } }
  const u: ON = sv
  (u.n).a
}

print(go())
print(decoy())
