// @run
// @log 3
// @log 9
// @log 3
// @log 0
// @log 3
// @log 0
// @log 3
// @log 0
// @log 7
// @log 4
// @log 0
// @log 2
// @log 1
// An intersection alias in a record field, a nullable field, a nullable parameter and a nullable
// result, over a recursive record (D14162), a recursive record widened by the intersection, and
// two inline records. Each position stores the alias at its record's row.
type Node = { v: i32, next: Node | null }
type M = Node & { v: i32 }
type H = { m: M }
const h: H = { m: { v: 3, next: null } }
print(h.m.v)
h.m.v = 9
print(h.m.v)
type HN = { m: M | null }
const hn: HN = { m: { v: 3, next: null } }
print(hn.m?.v ?? 0)
const hn0: HN = { m: null }
print(hn0.m?.v ?? 0)
function f(m: M | null) {
  if m == null { return 0 } else { return m.v }
}
print(f({ v: 3, next: null }))
print(f(null))
function mk(k: i32): M | null {
  if k > 0 { return { v: 3, next: null } } else { return null }
}
print(mk(1)?.v ?? 0)
print(mk(0)?.v ?? 0)

type Wide = { v: i32, next: Wide | null, w: i32 }
type MW = Wide & { w: i32 }
type HW = { m: MW }
const hw: HW = { m: { v: 3, next: null, w: 4 } }
print(hw.m.v + hw.m.w)

type AB = { a: i32 } & { b: i32 }
type HA = { m: AB }
const ha: HA = { m: { a: 4, b: 2 } }
print(ha.m.a)
function g(m: AB | null) {
  if m == null { return 0 } else { return m.b }
}
print(g(null))
print(g(ha.m))
print(g({ a: 0, b: 1 }))
