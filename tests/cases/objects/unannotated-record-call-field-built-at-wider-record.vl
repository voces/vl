// @run
// @log 6
// @log 8
// @log 4
// An un-annotated record literal holds its field values at the record they are built as: `mk()`
// is built at `J` for `wideJ`, so `w.a` is a `J`, and a later `w.a = mk()` stores the same build
// (D14519).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const wideJ: J = mk()
const w = { a: mk(), b: mk(), n: 2 }
w.a = mk()
const j = w.a
print(j.f + w.n)
const xs = [w.a, w.b]
print(xs[1].f + w.b.f)
print(wideJ.f ?? 0)
