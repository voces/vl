// @run
// @log 1
// @log 4
// @log 8
// @log 10
// @log z
// @log 4
// D15094: a record literal inside a binding's literal, whose field is a union none of whose arms
// declares every field it sets, is built at its own row and boxed as the arm whose fields are
// the first of its own; the dropped field's initializer still runs once.
type A = { k: i32, legs: i32 }
type B = { s: string }
type Pet = A | B
type Box = { pet: Pet }
type Outer = { box: Box, t: i32 }
let n = 0
function f() {
  n = n + 1
  return true
}
function legs(p: Pet) {
  if p is A { return p.legs }
  -1
}
function mk(): Box {
  const sv = { pet: { k: 1, legs: 4, purr: f() } }
  return sv
}
const b = mk()
print(n)
print(legs(b.pet))
const sv2 = { pet: { k: 2, legs: 6, purr: true } }
const b2: Box = sv2
const p2 = b2.pet
if p2 is A { print(p2.k + p2.legs) }
function mko(): Outer {
  const so = { box: { pet: { k: 1, legs: 7, purr: true } }, t: 3 }
  return so
}
const o = mko()
print(legs(o.box.pet) + o.t)
function pick(c: boolean): Box {
  const sa = { pet: { k: 1, legs: 4, purr: true } }
  const sb = { pet: { s: "z" } }
  if c { return sa }
  return sb
}
const q = pick(false).pet
if q is B { print(q.s) }
print(legs(pick(true).pet))
