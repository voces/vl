// @run
// @log return nul 7 2.5 true true true
// @log const nul 7 2.5 true true true
// @log let o 0
// @log reassigned nul 7
// @log argument nul 7 2.5 true true true
// @log element nul z 4 7
// @log field nul 7
// @log fallback nul p
// @log tail nul o 7 0
// @log stmt null 0
// @log stmt record 1
// @log valued null 0 1
// @log valued record 4 2
// @log read true false
// @log field null 2
// @log field record 3
// A `null` a rewrite mints with no type of its own: an omitted reference-kind field of a union
// arm, at each delivery position, and the else arm of a `?.` guard at an instance whose receiver
// is only `null`, which makes no call (`calls` does not move).
type Other = { b: i32 }
type OS = { s: string | null }
type OI = { n: i32 | null }
type OF = { x: f64 | null }
type OR = { r: Other | null }
type OL = { l: i32[] | null }
type OC = { c: ((x: i32) => i32) | null }
function ss(v: Other | OS) { return if v is OS { v.s ?? "nul" } else { "o" } }
function si(v: Other | OI) { return if v is OI { v.n ?? 7 } else { 0 } }
function sf(v: Other | OF) { return if v is OF { v.x ?? 2.5 } else { 0.0 } }
function sr(v: Other | OR) { return if v is OR { v.r == null } else { false } }
function sl(v: Other | OL) { return if v is OL { v.l == null } else { false } }
function sc(v: Other | OC) { return if v is OC { v.c == null } else { false } }
function rs(): Other | OS { return {} }
function ri(): Other | OI { return {} }
function rf(): Other | OF { return {} }
function rr(): Other | OR { return {} }
function rl(): Other | OL { return {} }
function rc(): Other | OC { return {} }
print(
  "return \{ss(rs())} \{si(ri())} \{sf(rf())} \{sr(rr())} \{sl(rl())} \{sc(rc())}",
)
const cs: Other | OS = {}
const ci: Other | OI = {}
const cf: Other | OF = {}
const cr: Other | OR = {}
const cl: Other | OL = {}
const cc: Other | OC = {}
print("const \{ss(cs)} \{si(ci)} \{sf(cf)} \{sr(cr)} \{sl(cl)} \{sc(cc)}")
let ls: Other | OS = { b: 1 }
let li: Other | OI = { b: 1 }
print("let \{ss(ls)} \{si(li)}")
ls = {}
li = {}
print("reassigned \{ss(ls)} \{si(li)}")
print("argument \{ss({})} \{si({})} \{sf({})} \{sr({})} \{sl({})} \{sc({})}")
const xs: (Other | OS)[] = [{}, { s: "z" }]
const ys: (Other | OI)[] = [{ n: 4 }, {}]
print("element \{ss(xs[0])} \{ss(xs[1])} \{si(ys[0])} \{si(ys[1])}")
type H = { v: Other | OS, w: Other | OI }
const h: H = { v: {}, w: {} }
print("field \{ss(h.v)} \{si(h.w)}")
function pick(k: i32): Other | OS | null {
  return if k == 0 { null } else { { s: "p" } }
}
print("fallback \{ss(pick(0) ?? {})} \{ss(pick(1) ?? {})}")
function tailIf(k: i32): Other | OS {
  return if k == 0 { ({}) } else { { b: 2 } }
}
function tailMatch(k: i32): Other | OI {
  return match k {
    0 => ({})
    _ => { b: 3 }
  }
}
print(
  "tail \{ss(tailIf(0))} \{ss(tailIf(1))} \{si(tailMatch(0))} \{si(tailMatch(1))}",
)
// A `?.` call off a receiver one instance types `null`: never made, so `calls` does not move.
let calls = 0
function bump(x: i32) {
  calls = calls + 1
  return x
}
function inc(x: i32) { return x + 1 }
function stmt(b) { b?.f(bump(2)) }
function valued(b) { return b?.f(bump(3)) ?? 0 }
function read(b) { return b?.f == null }
function viaField(o) { o.d?.f(bump(4)) }
stmt(null)
print("stmt null \{calls}")
stmt({ f: inc })
print("stmt record \{calls}")
print("valued null \{valued(null)} \{calls}")
print("valued record \{valued({ f: inc })} \{calls}")
print("read \{read(null)} \{read({ f: inc })}")
viaField({ d: null })
print("field null \{calls}")
viaField({ d: { f: inc } })
print("field record \{calls}")
