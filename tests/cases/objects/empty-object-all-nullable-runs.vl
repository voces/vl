// @run
// @log false none
// @log false none
// @log false none
// @log false none
// @log false none
// @log false none 1
// @log false none 2
// @log false none
// @log 7 2.5
// @log 7 2.5
// @log false none
// @log false none
// @log false none
// @log na
// @log na
// @log A
// @log na o
// @log na
// @log na z
// @log none
// @log true
// A record whose fields all admit `null` is completed by `{}`, every field null (D2223): an
// annotated binding and its reassignment, an argument, a return, a lambda's return, a field, a
// list element, a nullable destination, the fallback of `??`, and the value arms of a tail
// `if` and `match`. Value-union fields (`i32 | null`, `f64 | null`) take the same path. Into a
// union it is the first all-nullable member in declaration order; a callback's expected
// return completes it too, and `type E = {}` is inhabited by it.
type Cfg = { verbose: boolean | null, out: string | null }
type Num = { n: i32 | null, x: f64 | null }
function show(c: Cfg) { print("\{c.verbose ?? false} \{c.out ?? "none"}") }
function showN(m: Num) { print("\{m.n ?? 7} \{m.x ?? 2.5}") }
const c: Cfg = {}
show(c)
let d: Cfg = { out: "x" }
d = {}
show(d)
show({})
function mk(): Cfg { return {} }
show(mk())
const lam = (): Cfg => ({})
show(lam())
type Holder = { c: Cfg, k: i32 }
const h: Holder = { c: {}, k: 1 }
print("\{h.c.verbose ?? false} \{h.c.out ?? "none"} \{h.k}")
const cs: Cfg[] = [{}, {}]
print("\{cs[1].verbose ?? false} \{cs[1].out ?? "none"} \{cs.length}")
const maybe: Cfg | null = {}
if maybe != null { show(maybe) }
const m: Num = {}
showN(m)
showN({})
function lookup(k: i32): Cfg | null {
  if k > 0 { return { out: "found" } }
  null
}
show(lookup(0) ?? {})
function tailIf(k: i32): Cfg | null {
  if k == 0 { ({}) } else { null }
}
const t = tailIf(0)
if t != null { show(t) }
function tailMatch(k: i32): Cfg | null {
  match k {
    0 => ({})
    _ => null
  }
}
const u = tailMatch(0)
if u != null { show(u) }
type Opt = { a: string | null }
type Other = { b: i32 }
type Nb = { n: i32 | null }
function which(u: Other | Opt) {
  if u is { b: i32 } { return "o" }
  u.a ?? "na"
}
const u1: Other | Opt = {}
print(which(u1))
const u2: Opt | string = {}
if u2 is string { print(u2) } else { print(u2.a ?? "na") }
const u3: Opt | Nb = {}
if u3 is { a: string | null } { print("A") } else { print("B") }
print("\{which({})} \{which({ b: 1 })}")
function mkU(): Other | Opt { return {} }
print(which(mkU()))
const us: Other[] | Opt[] = [{}, { a: "z" }]
if us is Opt[] { print("\{us[0].a ?? "na"} \{us[1].a ?? "na"}") }
function viaCallback(f: () => Cfg) { f() }
print(viaCallback(() => ({})).out ?? "none")
type E = {}
const e: E = {}
function takesE(x: E) { print(x == x) }
takesE(e)
