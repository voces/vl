// @run
// @log 3
// @log -1
// @log 1.5
// @log -1
// @log hi
// @log none
// @log 9
// @log -1
// @log tt
// @log none
// A standalone `?.` read off a nullable record at each leaf kind it builds: a number and a float
// into their box, a nullable string, a nullable record and a string, each null when the receiver is.
type P = { x: i32, f: f64, s: string | null, q: Q | null, t: string }
type Q = { n: i32 }
function xs(p: P | null) { return p?.x }
function fs(p: P | null) { return p?.f }
function ss(p: P | null) { return p?.s }
function qs(p: P | null) { return p?.q }
function ts(p: P | null) { return p?.t }
const a: P = { x: 3, f: 1.5, s: "hi", q: { n: 9 }, t: "tt" }
const none: P | null = null
print(xs(a) ?? -1)
print(xs(none) ?? -1)
print(fs(a) ?? -1.0)
print(fs(none) ?? -1.0)
print(ss(a) ?? "none")
print(ss(none) ?? "none")
print(qs(a)?.n ?? -1)
print(qs(none)?.n ?? -1)
print(ts(a) ?? "none")
print(ts(none) ?? "none")
