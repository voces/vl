// @log q
// A declared record parameter handed records of wider shapes is specialized per concrete record:
// two parameters of one type each take their own record (D4021), a nullable or a list's element
// takes the record inside (D4022), and a recursive call that swaps them closes (D4023).
type Pos = { x: f64, y: f64 }
type A = { k: i32, y: f64, x: f64 }
type B = { y: f64, s: string, x: f64 }
function d(p: Pos, q: Pos): f64 {
  p.y = p.y + 1.0
  p.x - q.x
}
const a: A = { k: 7, y: 3.0, x: 10.0 }
const b: B = { y: 30.0, s: "q", x: 1.0 }
print(d(a, b))
print(d(b, a))
print(d(a, a))
print(a.y)
print(b.y)
function mv(p: Pos | null) {
  if p != null { p.x = p.x + 1.0 }
}
const c: A = { k: 7, y: 3.0, x: 2.0 }
mv(c)
print(c.x)
const n: A | null = c
mv(n)
print(c.x)
function mvl(ps: Pos[]) { ps[0].x = ps[0].x + 1.0 }
mvl([c])
print(c.x)
function ping(p: Pos, q: Pos, n: i32) {
  if n > 0 {
    p.x = p.x + 1.0
    ping(q, p, n - 1)
  }
}
const e: A = { k: 7, y: 3.0, x: 0.0 }
const g: B = { y: 3.0, s: "q", x: 100.0 }
ping(e, g, 5)
print(e.x)
print(g.x)
print(g.s)
