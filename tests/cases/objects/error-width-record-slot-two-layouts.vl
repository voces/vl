// @error an existing record keeps its own record layout where it is delivered (no copy is made), and `m` is given records of two layouts
// @error an existing record keeps its own record layout where it is delivered (no copy is made), and `m` is given records of two layouts
// @error an existing record keeps its own record layout where it is delivered (no copy is made), and `jn` is joined with a value of another layout
// @error an existing record keeps its own record layout where it is delivered (no copy is made), and this list literal holds records of two layouts
// @error an object value of shape A flowing into Pos (reached through A[] into readonly Pos[])
// A declared record slot that would hold records of two layouts keeps its refusal: one fed a
// second shape, one feeding a join with another shape, and a `readonly` view (D4054, D4050).
type Pos = { x: f64, y: f64 }
type A = { k: i32, x: f64, y: f64 }
type B = { s: string, x: f64, y: f64 }
const a: A = { k: 7, x: 2.0, y: 3.0 }
const b: B = { s: "q", x: 10.0, y: 30.0 }
let m: Pos = a
m = b
print(m.x)
const jn: Pos = a
const js = [jn, b]
print(js[0].x)
const as2: A[] = [a]
const view: readonly Pos[] = as2
print(view[0].x)
