// @run
// @log 12
// An anon-struct field's bare-identifier value is typed as a closure only when the
// identifier's declaration is a function. `q` and `qq` share a prefix: field `g` is the
// i32 binding and field `h` the function value, so the case fails both when a binding is
// taken for a function and when a function is not.
function qq(x: i32) { x + 1 }
const q = 5
const o = { g: q, h: qq }
const hh = o.h
print(o.g + hh(6))
