// @run
// @log true
// @log true
// @log 7
// @log y
// @log false
// @log true
// @log true
// D2762: a record literal handed to an un-annotated parameter reads its field as the literal's
// own type (a boolean prints `true`, not `1`), beside a constructor sharing the field name, a
// literal-set field and a bound literal that joins another literal's row.
function p(o) { print(o.f) }
p({ f: true })
function mk(x) { return { f: x } }
print(mk(true).f)
print(mk(7).f)
type K = "x" | "y"
const k: K = "y"
function show(o) { print(o.g) }
show({ g: k })
show({ g: false })
function r(o) { return o.h }
function q(o) { print(o.h) }
print(r({ h: true }))
const b1 = { h: true }
q(b1)
