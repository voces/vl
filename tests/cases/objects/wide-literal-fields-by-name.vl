// @run
// @log 12
// @log 11
// @log 12
// @log 2
// A literal of more than eight fields is read by name through its field index, and built at a
// narrower record's layout: a dropped field's initialiser still runs (D16558).
type N = { a: i32, b: i32 }
let calls = 0
function tick(v: i32) {
  calls = calls + 1
  return v
}
function take(n: N): i32 { return n.a * 10 + n.b }
const w = { j: 10, i: 9, h: 8, g: 7, f: 6, e: 5, d: 4, c: 3, b: 2, a: 1 }
print(take(w))
print(w.j + w.a)
print(
  take(
    {
      k: tick(11),
      j: 10,
      i: 9,
      h: 8,
      g: 7,
      f: 6,
      e: 5,
      d: 4,
      c: 3,
      b: tick(2),
      a: 1,
    },
  ),
)
print(calls)
