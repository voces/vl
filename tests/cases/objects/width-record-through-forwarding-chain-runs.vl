// @run
// @log 1
// @log 2
// A wider record forwarded whole through a chain of declared record parameters is passed as it
// is at every link, whichever order the links are declared in (D3992, D4020).
type Pos = { x: f64, y: f64 }
type A = { k: i32, y: f64, x: f64 }
function r6(p: Pos) { r5(p) }
function r5(p: Pos) { r4(p) }
function r4(p: Pos) { r3(p) }
function r3(p: Pos) { r2(p) }
function r2(p: Pos) { r1(p) }
function r1(p: Pos) { p.x = p.x + 1.0 }
function g1(p: Pos) { p.x = p.x + 1.0 }
function g2(p: Pos) { g1(p) }
function g3(p: Pos) { g2(p) }
function g4(p: Pos) { g3(p) }
function g5(p: Pos) { g4(p) }
function g6(p: Pos) { g5(p) }
const a: A = { k: 7, y: 3.0, x: 0.0 }
r6(a)
print(a.x)
g6(a)
print(a.x)
