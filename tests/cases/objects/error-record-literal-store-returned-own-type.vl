// @emit-error this record is handed on here at its own type, and elsewhere to a declared record type
// A store is a value: a lambda whose last statement stores the literal into a wider declared
// record's place also returns it at the literal's own type, and one record cannot be both
// (D2994). Refused loudly, not built as an invalid module.
type D = { v: f64 }
const x: i32 = 3
const c: {[string]: D} = Map()
const o = { v: x }
const f = () => {
  c["k"] = o
}
f()
