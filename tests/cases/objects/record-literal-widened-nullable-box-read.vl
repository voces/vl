// @run
// @log 3
// @log 2147483650
// @log 1.5
// @log 7
// An `i32 | null` field of a literal built at a wider `f64 | null` record is boxed there at the
// wider member, and its binding takes that record as its type, so `o.v` reads an `f64 | null`
// through every handle (D3006, D3339).
type D = { v: f64 | null }
const x: i32 | null = 3
const c: {[string]: D} = Map()
const o = { v: x }
c["k"] = o
print(o.v ?? 0)
if o.v != null { print(o.v + 2147483647) }
const r = c["k"]
if r != null { print((r.v ?? 0) / 2.0) }
o.v = null
print(o.v ?? 7)
