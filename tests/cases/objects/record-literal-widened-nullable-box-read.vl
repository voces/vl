// @run
// @log 3
// @log -2147483646
// @log 1.5
// @log 7
// An `i32 | null` field of a literal built at a wider `f64 | null` record is boxed there at the
// wider member, and read back through the own handle at its own member (D3006).
type D = { v: f64 | null }
const x: i32 | null = 3
const c: {[string]: D} = Map()
const o = { v: x }
c["k"] = o
print(o.v ?? 0)
if o.v != null { print(o.v + 2147483647) }
const r = c["k"]
if r != null { print((r.v ?? 0) / 2.0) }
o.v = null
print(o.v ?? 7)
