// @error an object of type OW cannot flow into ON: they agree on field names but differ INSIDE a field, and a struct field is mutable — writing through the narrower view would leave the original holding a value of the wrong type, so the two are unrelated by design and not by a missing lowering. Give the source exactly ON's field types, or read the field out and rebuild
// D1609 — the same refusal, with an unrelated binding of the name above it.
//
// D938's refusal asks whether the source name is bound without an annotation, since such a
// binding has no pinned wasm type and the emitter lays it out at the shape it flows into. The
// question is about the binding the name resolves to. Answering it by scanning the arena for
// the first `LetDecl` spelling the name takes `decoy`'s local `w`, and then `vl check` returns
// rc 0 and the engine refuses the module — D938's own clause-1 miscompile, reachable by adding
// a function nobody calls. `decoy` is never called and its `w` is another type in another scope.
// Moving it below the const is the ablation, pinned by the sibling arm.
type Wide = { a: i32, b: i32 }
type Narrow = { a: i32 }
type OW = { n: Wide }
type ON = { n: Narrow }

function take(o: ON): i32 {
  (o.n).a
}

function decoy(): i32 {
  const w = { n: { a: 9, b: 9 } }
  (w.n).a
}

const w: OW = { n: { a: 1, b: 2 } }

print(take(w))
