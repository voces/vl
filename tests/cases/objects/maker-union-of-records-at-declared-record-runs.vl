// @log 7
// @log 5
// A maker joining a record holding a nested record with one holding `null` returns the union of
// the two records. Delivered at a declared record whose field is that record or `null`, each of
// its literals is built at the declared record, at one call site or two, and so is a value `if`
// of the two literals (D15719; unfiled: D15719, filed in #7242).
type J = { a: i32 }
type K = { j: J | null }
function mk(b: boolean) {
  if b { { j: { a: 1 } } } else { { j: null } }
}
const _k: K = mk(false)
print(_k.j?.a ?? 5)
const _l: K = mk(true)
print(_l.j?.a ?? 5)
const go = [1].length > 0
const _m: K = if go { { j: { a: 7 } } } else { { j: null } }
print(_m.j?.a ?? 5)
const _n: K = if !go { { j: { a: 7 } } } else { { j: null } }
print(_n.j?.a ?? 5)
