// @run
// @log 3
// @log 15
// @log hi!
// An anon-struct field's bare-identifier value is a closure only when the identifier's
// declaration is a function. A local spelled like a function declared elsewhere is a
// plain value: `v` is i32 in `make` and string in `makeStr`.
function total(xs: i32[]) {
  let s = 0
  for x in xs { s = s + x }
  s
}

function make(n: i32) {
  const total = n * 2
  const r = { v: total, w: n }
  r.v + r.w
}

function makeStr(s: string) {
  const total = s + "!"
  const r = { v: total }
  r.v
}

print(total([1, 2]))
print(make(5))
print(makeStr("hi"))
