// @warning `==` on `R` compares every element of its list field `xs`
// @warning `==` on `R` compares every element of its list field `xs`
// @warning `==` on `O` compares every element of its list field `r.xs`
// @warning `==` on `O` compares every element of its list field `r.xs`
// @warning `!=` on `R` compares every element of its list field `xs`
// @warning `!=` on `R` compares every element of its list field `xs`
// D15054: `==` over a record whose `(string | null)[]` field holds a null compares the field's
// elements null-aware: two nulls agree, a null and a string do not. So does a union arm's
// field, nullable or not, a nested record's, a list of such records, and a list of such lists.
type R = { xs: (string | null)[], n: i32 }
type O = { r: R }
type V = { k: i32 } | { xs: (string | null)[], ys: (string | null)[] | null }
const r: R = { xs: ["x", null], n: 1 }
const q: R = { xs: ["x", null], n: 1 }
const z: R = { xs: ["x", "y"], n: 1 }
print(r == q)
print(r == z)
const o: O = { r: r }
print(o == { r: q })
print(o == { r: z })
const v: V = { xs: ["a", null], ys: [null, "b"] }
const w: V = { xs: ["a", null], ys: [null, "b"] }
const x: V = { xs: ["a", null], ys: null }
print(v == w)
print(v == x)
const rs = [r, z]
print(rs == [q, z])
print(rs == [z, q])
print(r != z)
print(r != q)
const ll: (string | null)[][] = [["x", null], [null]]
const lm: (string | null)[][] = [["x", null], [null]]
const ln: (string | null)[][] = [["x", null], ["n"]]
print(ll == lm)
print(ll == ln)
