// @check
// @error 'plain' is not a method — its first parameter is named `x`, not `self`
// A non-`self` free function is NOT a method — it is not reachable through an
// instance, so `o.plain(2)` doesn't resolve to the global `plain`. This is what
// the `self` marker buys: no namespace pollution (vs a type-directed UFCS where
// every global would become a method on every object).
//
// D1570 — THE SENTENCE NAMES THE RULE. It read `no field 'plain' on {x: i32}`, which
// is true and sends the reader looking for a field that will never exist; the
// compiler knew all along that `plain` is a function in scope and which gate it
// failed (glean VL-021).
function plain(x: i32) x + 1
let o = { x: 5 }
let r = o.plain(2)
