// @log 1
// @log x
// @log 1
// @log s
// @log true
// @log 3
// @hint redundant type annotation: `c` is inferred as `{v: i32}` — remove it to lean on inference
// D8162: a record literal whose field holds a hole call's result is a record over an open
// type in its function, and gets its row at the instance, at `i32` and at `f64`. The
// annotated spellings are the same records, and the result is also read as an argument.

function inc(a) { return a + 1 }
function half(a) { return a / 2.0 }
function boxed(h) { return { v: h(5) } }

const b = boxed(inc)
print(b.v)
print(boxed(half).v)

function boxedAnn(h: (n: i32) => i32) { return { v: h(5) } }
print(boxedAnn(inc).v)
const c: { v: i32 } = boxed(inc)
print(c.v)
function show(o) { print(o.v) }
show(boxed(half))

// Constructors whose record holds a parameter get a row at each pin: in a list in a generic
// body (D2871), at a map, list and scalar hole (D3132), holding a function (D3196), with two
// fields (D3567), and at `boolean` (D3709).
function pc<T>(x: T) { { a: x } }
function inList<T>(t: T) {
  const xs = [pc(t)]
  print(xs.length)
  print(xs[0].a)
  0
}
inList(1)
inList("s")

function holdM(v) { { m: v } }
const hm: {[i32]: i32} = Map()
hm[3] = 7
print(holdM(hm).m[3] ?? -1)
print(holdM([4, 5]).m[1])
print(holdM(5).m)

function holdF(g) { return { v: 1, f: g } }
print(holdF(() => 1).f())
print(holdF(() => "x").f())

function two<T>(x: T) { return { a: x, b: x } }
print(two(1).a)
print(two("s").b)

function holdB<T>(v: T) { { x: v } }
print(holdB(true).x)
const hb = holdB(3)
print(hb.x)
