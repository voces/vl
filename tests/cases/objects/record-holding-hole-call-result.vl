// @run
// @log 6
// @log 2.5
// @log 6
// @log 6
// @log 2.5
// @hint redundant type annotation: `c` is inferred as `{v: i32}` — remove it to lean on inference
// D8162: a record literal whose field holds a hole call's result is a record over an open
// type in its function, and gets its row at the instance, at `i32` and at `f64`. The
// annotated spellings are the same records, and the result is also read as an argument.

function inc(a) { return a + 1 }
function half(a) { return a / 2.0 }
function boxed(h) { return { v: h(5) } }

const b = boxed(inc)
print(b.v)
print(boxed(half).v)

function boxedAnn(h: (n: i32) => i32) { return { v: h(5) } }
print(boxedAnn(inc).v)
const c: { v: i32 } = boxed(inc)
print(c.v)
function show(o) { print(o.v) }
show(boxed(half))
