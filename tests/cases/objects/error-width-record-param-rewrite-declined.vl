// @error an object value of shape A flowing into Pos drops the field
// @error an object value of shape A flowing into Pos drops the field
// @error an object value of shape A flowing into Pos drops the field
// A wider record is refused at a declared record parameter whose function returns it, compares
// it by identity, or reassigns a local holding it: a generic parameter would change what the
// body means (D3992).
type Pos = { x: f64, y: f64 }
type A = { k: i32, y: f64, x: f64 }
const z: Pos = { x: 2.0, y: 3.0 }
function id(p: Pos) { p.x = p.x + 1.0; return p }
function same(p: Pos): boolean { p == z }
function f(p: Pos): f64 { let q = p; q = { x: 10.0, y: 20.0 }; q.x + p.x }
const a: A = { k: 7, y: 3.0, x: 2.0 }
print(id(a).x)
print(same(a))
print(f(a))
