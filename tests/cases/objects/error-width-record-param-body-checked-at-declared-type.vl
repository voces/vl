// @error no field 'z' on Pos
// @error an object value of shape A flowing into Pos drops the field
// The body is checked at the declared type, whatever wider record a call passes (D3992).
type Pos = { x: f64, y: f64 }
type A = { k: i32, x: f64, y: f64, z: f64 }
function mv(p: Pos) { p.z = 1.0 }
const a: A = { k: 1, x: 2.0, y: 3.0, z: 0.0 }
mv(a)
