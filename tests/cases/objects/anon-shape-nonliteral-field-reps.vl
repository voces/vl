// @run
// @hint redundant type annotation: `mI` is inferred as `i32`
// @hint redundant type annotation: `mB` is inferred as `boolean`
// @hint redundant type annotation: `mS` is inferred as `string`
// @hint redundant type annotation: `mF64` is inferred as `f64`
// @hint redundant type annotation: `mI64` is inferred as `i64`
// @hint redundant type annotation: `mIL` is inferred as `i32[]`
// @hint redundant type annotation: `mSL` is inferred as `string[]`
// @log 7
// @log 7
// @log true
// @log true
// @log s
// @log s
// @log 1.5
// @log 1.5
// @log 1.5
// @log 1.5
// @log 6000000000
// @log 6000000000
// @log 1
// @log 1
// @log s
// @log s
// @log 1.5
// @log 1.5
// @log 6000000000
// @log 6000000000
// @log 1.5
// @log 1.5
// @log 8
// @log 8
// EVERY FIELD REP the recorded-type rung of `anonFieldCode` admits, each stored into an
// UN-ANNOTATED object literal from a CALL (a value form the syntax rung cannot classify)
// and read back out. On master every binding here is `emitProgram: ref valtype with no
// interned shape`.
//
// EACH PAIR IS ITS OWN ORACLE and needs no annotated twin at all: the value is printed
// directly, then printed again through the anonymous struct field. A field interned at the
// wrong code moves the second line of its pair and nothing else, so the failure names the
// rep. Every field name is DISTINCT, which keeps `collectAnonShapes`' field-name-set match
// from letting one cell intern another's shape.
//
// THE ADMITTED SET IS "the codes whose wasm slot the code alone decides" — the scalars,
// the string ref, the five scalar-backed list wrappers, and the closure fat pointer. A
// code that carries a COMPANION column (`sFieldElemName`) is NOT admitted here, because
// this path has no annotation to read the companion from; `anon-shape-ref-element-field-
// reject.vl` is the pin that it stays loud.
function mI(): i32 { return 7 }
function mB(): boolean { return true }
function mS(): string { return "s" }
function mF64(): f64 { return 1.5 }
function mF32(): f32 { return 1.5 }
function mI64(): i64 { return 6000000000 }
function mIL(): i32[] { return [1, 2] }
function mSL(): string[] { return ["s"] }
function mFL(): f64[] { return [1.5] }
function mI64L(): i64[] { return [6000000000] }
function mF32L(): f32[] { return [1.5] }
function inc(x: i32) { return x + 1 }
function mFn(): (i32) => i32 { return inc }

print(mI())
const ci = { fi: mI() }
print(ci.fi)

print(mB())
const cb = { fb: mB() }
print(cb.fb)

print(mS())
const cs = { fs: mS() }
print(cs.fs)

print(mF64())
const cf = { ff: mF64() }
print(cf.ff)

print(mF32())
const cg = { fg: mF32() }
print(cg.fg)

print(mI64())
const cj = { fj: mI64() }
print(cj.fj)

print(mIL()[0])
const cil = { fil: mIL() }
print(cil.fil[0])

print(mSL()[0])
const csl = { fsl: mSL() }
print(csl.fsl[0])

print(mFL()[0])
const cfl = { ffl: mFL() }
print(cfl.ffl[0])

print(mI64L()[0])
const cjl = { fjl: mI64L() }
print(cjl.fjl[0])

print(mF32L()[0])
const cgl = { fgl: mF32L() }
print(cgl.fgl[0])

print(mFn()(7))
const cfn = { ffn: mFn() }
print(cfn.ffn(7))
