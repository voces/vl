// @run
// @log true
// @log false
// @log true
// Structural `==` over a struct whose nested field is a DECLARED struct type
// (`inner: Inner`), not an inline object literal's anonymous shape. The
// field-wise lowering recurses through the code-15 field by resolving the
// field's TARGET struct row (`sFieldTgtStructIdx`).
//
// COVERAGE PIN (destringify D5). `objects/equality.vl` compares
// `{pos: {x: 1}}` literals, whose nested rows are synthetic `#anonN` shapes —
// a name the arena sidecar cannot resolve, so the struct-eq recursion's ARENA
// leg never ran anywhere in the corpus. It took an ANNOTATED nested field for
// the migrated leg to be consulted at all; a per-site sabotage build fired on
// zero corpus files before this case existed.
type Inner = { x: i32, tag: string }
type Outer = { a: i32, inner: Inner }

const p: Outer = { a: 1, inner: { x: 7, tag: "hi" } }
const q: Outer = { a: 1, inner: { x: 7, tag: "hi" } }
const r: Outer = { a: 1, inner: { x: 8, tag: "hi" } }
print(p == q)
print(p == r)
print(p != r)
