// @run
// @log 1.5
// @log 1.5
// @log 1.5
// @log 1.5
// @log 9000000000
// @log 3
// @log 3
// @log 4
// @log 3
// @log 3
// @log 3
// @hint redundant type annotation: `t` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `xs` is inferred as `{v: f64}[]` — remove it to lean on inference
// @hint redundant type annotation: `w` is inferred as `{d: {v: f64}}` — remove it to lean on inference
// @hint redundant type annotation: `h` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `y` is inferred as `i32` — remove it to lean on inference
// An un-annotated record literal stored into a place of a wider declared record (a map value,
// a list element, a field) is built at that record (D2990), and its binding takes that record as
// its type, so every read of it computes at the wider field, as its annotated twin's does (D3339).
type D = { v: f64 }
type L = { v: i64 }
type W = { d: D }
const x = 3
function t(a: i32): i32 { a }

const c: {[string]: D} = Map()
const o = { v: x }
c["k"] = o
const r = c["k"]
if r != null { print(r.v / 2.0) }

const xs: D[] = [{ v: 1.0 }]
const p = { v: x }
xs[0] = p
print(xs[0].v / 2.0)

const w: W = { d: { v: 1.0 } }
const f = { v: x }
w.d = f
print(w.d.v / 2.0)

function local(n: i32) {
  const m: {[string]: D} = Map()
  const q = { v: n }
  m["k"] = q
  const g = m["k"]
  if g != null { print(g.v / 2.0) }
}
local(3)

const ls: {[string]: L} = Map()
const q = { v: 3 }
ls["k"] = q
const lq = ls["k"]
if lq != null { print(lq.v * 3000000000) }
print(q.v)

const z = { v: 3 }
function h(): i32 { z.v }
print(h())
const y: i32 = z.v + 1
print(y)
print(o.v)

if true {
  const b = { v: 3 }
  print(t(b.v))
}
function inFn() {
  const e = { v: 3 }
  print(t(e.v))
}
inFn()
