// @run
// @log 9
// @log in
// @log 10
// @log in
// @log 11
// A record literal holding a generic, handed to a narrower declared record parameter that calls
// the function under `is`, is declared as a `const` first, so the narrowed call pins it (D6701).
type G = { g: i32 }
type H = { f: (x: string) => string, g: i32 }
function k4<T>(x: T): T { return x }
function look(o: G) {
  if o is H { print(o.f("in")) }
  print(o.g)
}
function look2(n: i32, o: G) {
  if o is H { print(o.f("in")) }
  print(o.g + n)
}
look({ g: 9 })
look({ f: k4, g: 10 })
look2(1, { f: k4, g: 10 })
