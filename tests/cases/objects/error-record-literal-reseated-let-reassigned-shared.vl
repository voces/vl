// @emit-error this record is handed on here at its own type, and elsewhere to a declared record type
// A `let` a delivery re-seats at a wider declared record cannot then be assigned a record that is
// not a fresh literal at its own type: a record is shared, not converted (D3010). Refused loudly,
// not built as an invalid module.
type D = { v: f64 }
const x = 3
const c: {[string]: D} = Map()
let o = { v: x }
c["k"] = o
const q: {v: i32} = { v: 5 }
o = q
print(o.v)
