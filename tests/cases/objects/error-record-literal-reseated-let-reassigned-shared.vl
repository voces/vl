// @check
// @error {v: i32} is not D: they store field `v` differently
// A `let` assigned a record that is not a fresh literal holds more than a literal, so it is not
// built at the wider record it is delivered to, and a record is shared, not copied: the delivery
// is refused (D3010; DECISIONS.md "Record covariance: only a fresh value widens").
type D = { v: f64 }
const x = 3
const c: {[string]: D} = Map()
let o = { v: x }
c["k"] = o
const q: {v: i32} = { v: 5 }
o = q
print(o.v)
