// @run
// D1720 — a nested-struct field's slot is `(ref null $H)` whether the field is declared `S`
// or `S | null`, one hop for both, so a store into it never owes `ref.as_non_null`; asking
// for one traps on the only value the niche exists to carry.

// Both store positions are covered, the literal and the assignment, since the construct and
// store halves of a field code are separate sites; each store is read back through a `??`,
// whose null test can only run if the null reaches it.

// @log 8
// @log 8
// @log 8
// @log 5
// @log 8
// @log 8

// The holder annotations are declared rather than removed: a declared row and an anonymous
// mint are the two cases this covers, and inference would collapse them to one.

// @hint redundant type annotation: `w` is inferred as `{f: A | null}` — remove it to lean on inference
// @hint redundant type annotation: `w2` is inferred as `{f: A | null}` — remove it to lean on inference
// @hint redundant type annotation: `w3` is inferred as `{f: A | null}` — remove it to lean on inference
// @hint redundant type annotation: `v` is inferred as `{f: A}` — remove it to lean on inference
// @hint redundant type annotation: `q` is inferred as `{f: A | null}` — remove it to lean on inference

type A = { r: i32 }
type W = { f: A | null }
type V = { f: A }

function st(): A { return { r: 8 } }
function mkNul(): A | null { return null }
function mkSome(): A | null { return { r: 5 } }

// the literal store, into a declared holder…
const w: W = { f: mkNul() }
const g = w.f ?? st()
print(g.r)

// …the assignment store, over a field that held a value…
const w2: W = { f: mkSome() }
w2.f = mkNul()
const g2 = w2.f ?? st()
print(g2.r)

// …and the literal store into an anonymous holder, whose row is minted rather than declared.
const a = { f: mkNul() }
const g3 = a.f ?? st()
print(g3.r)

// A present value still reaches the field and reads back as itself.
const w3: W = { f: mkSome() }
const g4 = w3.f ?? st()
print(g4.r)

// The non-null field is the control: its slot is the same `(ref null $H)` hop, so dropping
// the recover must leave it running.
const v: V = { f: st() }
print(v.f.r)

// The same store and read inside a function, where the holder is a local.
function inFn() {
  const q: W = { f: mkNul() }
  const r = q.f ?? st()
  print(r.r)
}
inFn()
