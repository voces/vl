// @check
// @error-at 6:4 `{ print }` here is a block, not a record — write `return { print }` or `({ print })`
// DV-1216 over a parameter named like an ambient function (D4066): the note still names the field.
type Logger = { print: (x: i32) => i32 }
export function mk(print: (x: i32) => i32): Logger {
  {
    print
  }
}
