// @check
// @hint Intentionally-unused parameter `_s`
// @hint Intentionally-unused parameter `_s`
// @error sets `purr`, which Animal does not declare
// @error sets `purr`, which Animal does not declare
// @error sets `purr`, which Animal does not declare
// @error (reached through {legs: i32, purr: boolean}[] into Animal[])
// @error (reached through {pet: {legs: i32, purr: boolean}} into Shelter)
// @error sets `purr`, which Animal does not declare
// @error sets `purr`, `tail`, which Animal does not declare
// VERDICT PIN (must-error), and NO `@log` form exists for the DEFECT — which is worth
// stating, because the defect's contract reads like a log contract and is not one. On
// master every program below checks clean, builds a valid module, prints the same number
// this file's neighbours print, and NEVER CALLS `side`: the excess field's initializer is
// dropped along with the field. The fix makes the program a REJECT, so after it there is
// no stdout to diff, and before it the stdout was already the "right" number — the missing
// line is an absence, and `@log` pins presence. The evaluation that must still happen when
// the field IS declared is pinned separately, by
// `objects/object-literal-declared-field-initializer-runs.vl`.
//
// `emitObj` walks the DESTINATION struct's field list and looks each name up in the
// literal, so a field the destination does not declare is never visited. Its initializer
// is never lowered, never evaluated, and its side effects never happen — a wrong
// evaluation COUNT on a program `vl check` reports clean. `objShapeAdapterless` already
// answers true for a source carrying a field the destination lacks "under ANY source
// form"; the object-LITERAL arm judged the literal's field VALUES and returned, carrying
// that leg of the rule and not this one.
//
// THE AXIS IS THE EXCESS FIELD, NOT THE INITIALIZER. A constant excess field is dropped
// exactly as a call is (last two cases) — it is simply not observable that it was — so the
// rule is keyed on the field and the diagnostic names the field.
type Animal = { legs: i32 }
type Shelter = { pet: Animal }

function side(_s: string) {
  print("SIDE EFFECT RAN")
  return true
}
function sideNull(_s: string) {
  print("SIDE EFFECT RAN")
  return null
}

// ANNOTATED BINDING — the shape the defect was found in.
const a1: Animal = { legs: 4, purr: side("bind") }
print(a1.legs)

// The same binding with a NULL-valued excess field: the drop does not care what the
// initializer produces, only that the field has nowhere to go.
const a2: Animal = { legs: 4, purr: sideNull("null") }
print(a2.legs)

// ARGUMENT.
function countOne(a: Animal) { print(a.legs) }
countOne({ legs: 5, purr: side("arg") })

// ARRAY-LITERAL ELEMENT — reported through the container, and the wording still follows
// the pair the walk stopped on (an object literal), not the array literal it entered on.
function countArr(xs: Animal[]) { print(xs[0].legs) }
countArr([{ legs: 6, purr: side("elem") }])

// A LITERAL FIELD VALUE that is itself a literal.
const s1: Shelter = { pet: { legs: 7, purr: side("nested") } }
print(s1.pet.legs)

// RETURN position — the literal flows into the function's DECLARED return type. (A
// literal returned from an UN-annotated function is a different case: the call result is
// then a pinned value and `object-width-value-source-forms.vl` owns it, with the
// codegen wording, on master already.)
function mk(): Animal {
  return { legs: 8, purr: side("ret") }
}
print(mk().legs)

// A CONSTANT excess field, and TWO of them: same verdict, and the diagnostic names both.
const a3: Animal = { legs: 9, purr: true, tail: 1 }
print(a3.legs)
