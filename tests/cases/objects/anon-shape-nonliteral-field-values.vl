// @run
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log s
// @log s
// @log 4
// @log 7
// @log 4
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log s
// @log s
// @log 4
// @log 7
// @log 4
// @log 7
// An UN-ANNOTATED object literal whose field VALUE is not a literal — a variable, a call,
// a field read, a parenthesised read, an array index. On master every `u*` binding below
// is `emitProgram: ref valtype with no interned shape` (a module-global binding) or
// `emitProgram: object literal but no struct type declared` (a function-local one): ONE
// root with two messages, because a global cell resolves its valtype in
// `emitGlobalSection` before `emitObj` ever runs, while a local reaches `emitObj` and
// meets its `sDeclared` guard first. `{ lead: 4, g: 1 + 1 }` — the same shape with a
// constant-foldable field — compiled fine, so the axis was never the field COUNT or the
// field TYPE but whether `anonFieldCode` could read the value's rep off its SYNTAX.
//
// EACH READ IS PAIRED WITH ITS ORACLE: the un-annotated binding's read is printed, then
// the same value is read back out of an ANNOTATED shape, which works on master because
// the annotation interns the shape on the other pass (`collectAnnShapes`).
//
// THE ORACLE'S FIELD NAMES ARE DELIBERATELY DIFFERENT (`o`/`olead`, not `g`/`lead`), and
// this is load-bearing: `collectAnonShapes` skips a literal whose field-name SET already
// matches an interned shape, so an oracle spelled `{ g: … }` interns `{g}` from its own
// annotation and RESCUES the very binding it is supposed to be judging. A first cut of
// this file did exactly that and passed on master.
const gv = 7
const gs = "s"
const gsrc = { q: 7 }
const garr = [7]
function mkv() { return 7 }
function pickI(p: { o: i32 }) { return p.o }
function pickS(p: { o: string }) { return p.o }
function pickTwo(p: { olead: i32, o: i32 }) { return p.o }

// ── module-global bindings ──
const uVar = { g: gv }
print(uVar.g)
print(pickI({ o: gv }))

const uCall = { g: mkv() }
print(uCall.g)
print(pickI({ o: mkv() }))

const uMem = { g: gsrc.q }
print(uMem.g)
print(pickI({ o: gsrc.q }))

const uPar = { g: (gv) }
print(uPar.g)
print(pickI({ o: (gv) }))

const uIdx = { g: garr[0] }
print(uIdx.g)
print(pickI({ o: garr[0] }))

const uStr = { g: gs }
print(uStr.g)
print(pickS({ o: gs }))

// TWO fields, the leading one a literal: the field COUNT is not the axis. (The EXCESS-field
// neighbour is a reject — `objects/object-literal-excess-field-reject.vl`. Both fields
// here are declared by every shape they flow into.)
const uTwo = { lead: 4, g: gv }
print(uTwo.lead)
print(uTwo.g)
print(4)
print(pickTwo({ olead: 4, o: gv }))

// ── the SAME grid inside a function body ──
function locals() {
  const lVar = { h: gv }
  print(lVar.h)
  print(pickI({ o: gv }))

  const lCall = { h: mkv() }
  print(lCall.h)
  print(pickI({ o: mkv() }))

  const lMem = { h: gsrc.q }
  print(lMem.h)
  print(pickI({ o: gsrc.q }))

  const lPar = { h: (gv) }
  print(lPar.h)
  print(pickI({ o: (gv) }))

  const lIdx = { h: garr[0] }
  print(lIdx.h)
  print(pickI({ o: garr[0] }))

  const lStr = { h: gs }
  print(lStr.h)
  print(pickS({ o: gs }))

  const lTwo = { hlead: 4, h: gv }
  print(lTwo.hlead)
  print(lTwo.h)
  print(4)
  print(pickTwo({ olead: 4, o: gv }))
}
locals()
