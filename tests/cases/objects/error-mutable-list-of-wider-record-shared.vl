// @error an existing list keeps its elements' own record layout where it is delivered (no copy is made), and a mutable `Animal[]` stores one record layout for every element, so `animals` cannot share this Cat[]
// An existing list of a wider record delivered to a mutable list of a narrower one is refused by
// the container ruling: a write through the narrow list would reach the wide one (D4051).
type Animal = { a: string }
type Cat = { a: string, z: i32 }
const cats: Cat[] = [{ a: "c", z: 9 }]
const animals: Animal[] = cats
animals.push({ a: "dog" })
print(cats.length)
print(cats[0].a)
print(cats[0].z)
print(animals[0].a)
