// @check
// @error-at 10:8 no field 'widht' on Size; did you mean 'width'?
// @error-at 12:9 no field 'heigth' on Size; did you mean 'height'?
// @error-at 13:2 no field 'widht' on Size; did you mean 'width'?
// @error-at 14:8 no field 'depth' on Size
// A missing field within the edit budget of one the record declares names it, on a read, a
// `?.` read and a write; a far one gets no note.
type Size = { width: i32, height: i32 }

const s: Size = { width: 1, height: 2 }
print(s.widht)
const t: Size | null = s
print(t?.heigth ?? 0)
s.widht = 3
print(s.depth)
