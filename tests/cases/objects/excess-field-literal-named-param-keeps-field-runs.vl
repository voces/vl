// @run
// @log true
// @log 3
// @log true
// @log 3
// A literal argument that sets a field its named record parameter does not declare is built at its
// own record, as the same literal bound first is, so a test for the wider record sees the field (D15481).
type G = { g: i32 }
type H = { f: i32, g: i32 }
function look(o: G) { print(o is H) }
function read(o: G) {
  if o is H { print(o.f) } else { print("no") }
}
look({ f: 3, g: 10 })
read({ f: 3, g: 10 })
const r = { f: 3, g: 10 }
look(r)
read(r)
