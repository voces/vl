// @run
// @log true
// @log false
// @log true
// @log false
// @log 7
// @log -1
// @log 8
// @log 9
// @log 10
// @log 15
// @log 18
// A standalone `?.` whose LEAF FIELD is a nested struct. `o?.f` over `o: T | null` with
// `T = {f: S}` has type `S | null`, and every OTHER producer of that type already compared
// and ran — two locals, two call results, a `(S|null)[]` element, a plain `x.f == y.f`, a
// closure value call, a monomorphized `eqN<T>` — so the refusal was a MISSING ARM and not a
// rep gap (D1084). Three arms, one per layer:
//
//   · `structIndexOfExpr` had no `OptMember` arm, so the equality classifier could not name
//     the row (`struct equality over a non-struct operand`);
//   · `emitOptMemberValue` had no code-15 arm, so the operand had no value lowering
//     (`a standalone ?. supports only i32/boolean and string leaf fields`);
//   · `exprNullableStruct` had no `OptMember` arm, WITHOUT WHICH ONLY THE ANNOTATED
//     SPELLING WORKS. `const r: S | null = o?.f` ran while `const r = o?.f` was refused
//     `bare null needs a struct-typed context` at its own `!= null` guard — the annotation
//     was pinning the rep. The un-annotated bindings below are the ones that pin that.
type S = { a: i32 }
type T = { f: S }
type M = { f: S }
type Deep = { m: M }

function eq(o: T | null, q: S | null) { return o?.f == q }

function guarded(o: T | null) {
  const r = o?.f
  if r != null { return r.a }
  return -1
}

function returned(o: T | null): S | null { return o?.f }

function passed(o: T | null) { return take(o?.f) }

function take(v: S | null) {
  if v != null { return v.a }
  return -1
}

let gcell: S | null = null

function throughGlobal(o: T | null) {
  gcell = o?.f
  if gcell != null { return gcell.a }
  return -1
}

function chained(o: Deep | null) {
  const r = o?.m
  if r != null { return r.f.a }
  return -1
}

const s1 = { a: 7 }
const s2 = { a: 99 }
const t1 = { f: s1 }

// CONSTRUCT AND DISCRIMINATE: the compare must be false for two different structs, and the
// null receiver must still answer.
print(eq(t1, s1))
print(eq(t1, s2))
print(eq(null, null))
print(eq(t1, null))

print(guarded(t1))
print(guarded(null))

const eight = { f: { a: 8 } }
const nine = { f: { a: 9 } }
const ten = { f: { a: 10 } }
const fifteen = { f: { a: 15 } }

const ret = returned(eight)
if ret != null { print(ret.a) }
print(passed(nine))
print(take(ten?.f))
print(throughGlobal(fifteen))

const deep = { m: { f: { a: 18 } } }
print(chained(deep))
