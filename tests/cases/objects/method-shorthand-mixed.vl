// @run
// @log 10
// @log 3
// @log 30
// A function-valued field alongside ordinary fields: a value field (`base`), a
// block-bodied one (`addBase`) and an expression-bodied one (`triple`). Written as
// the `addBase(x) { … }` shorthand, which `vl fmt` canonicalises to this spelling —
// the shorthand itself is pinned in `tests/vl_fmt_test.ts`.
const obj = {
  base: 7,
  addBase: (x: i32) => {
    return x + 7
  },
  triple: (x: i32) => x + x + x,
}
print(obj.addBase(3))
print(obj.base - 4)
print(obj.triple(10))
