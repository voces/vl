// @run
// @log 2
// @log 2
// @log 7
// @log 1
// @log NUL
// @hint redundant type annotation: `w` is inferred as `{f: i32[][] | null}`
// @hint redundant type annotation: `w` is inferred as `{f: i32[][] | null}`
// @hint redundant type annotation: `w` is inferred as `{g: {[string]: i32} | null}`
// @hint redundant type annotation: `w` is inferred as `{h: {[string]: boolean} | null}`
// The four hints are DECLARED rather than removed: the `WA`/`WM`/`WS` annotations are what
// make these NAMED struct fields rather than anonymous ones, and the named row is what the
// emitter's Member arm resolves the field code through.
// NARROWING A NULLABLE CONTAINER FIELD IN PLACE, then using it — `if w.f != null { w.f[0] }`
// with no temp binding in between.
//
// WHAT THIS PINS (inventory #2 D10). The checker narrowed the path correctly and the
// EMITTER did not follow, for 104 of the position's 184 cells: `emitProgram: index receiver
// is not an array or string` for the nested arrays, `field access receiver is not a struct`
// for the maps and sets. Binding a temp first (`const t = w.f`) was correct for every rep,
// which is what located it in the emitter's expression classifiers rather than in the guard.
//
// THE MECHANISM IS ONE MISSING RUNG, TWICE. `exprRefArray`'s IDENT arm carries three
// nullable rungs — `declaredKind == "nulreflist"`, `paramNulRefArray`,
// `globalIsNulRefArraySid` — each added when a storage class was found missing. Its MEMBER
// arm carried exactly one test, `memFieldTypeCode == 5`, the NON-nullable ref-list field
// code; code 28, the `T[] | null` field, reached nothing. `exprMap` is the same shape one
// classifier over: its Ident arm ends `return exprNullableMap(exprIx, fnIx)` and its Member
// arm tested only code 19. Both nullable twins ALREADY had the Member arm
// (`exprNullableRefArray` -> code 28, `exprNullableMap` -> code 29), so the fix is to ask
// the twin rather than to re-derive the code — the grep-for-the-type-taking-twin rule.
//
// The emitted read is the temp-binding control's, instruction for instruction:
// `ref.as_non_null (struct.get $0 0 …)` then the ordinary list index. No box, no re-hash.
type WA = { f: i32[][] | null }
type WM = { g: {[string]: i32} | null }
type WS = { h: {[string]: boolean} | null }

function mkA(): i32[][] | null { return [[1, 2]] }
function mkM(): {[string]: i32} | null {
  const m = Map()
  m["a"] = 7
  return m
}
function mkS(): {[string]: boolean} | null {
  const s = Set()
  s.add("a")
  return s
}
function nul(): i32[][] | null { return null }

// The nine nested-array reps route through `exprRefArray`'s Member arm.
function arr() {
  const w: WA = { f: mkA() }
  if w.f != null { print(w.f[0][1]) } else { print("NUL") }
}
// A CONTROL for the same rep: bind a temp, narrow the temp. Correct on master and here.
function arrTemp() {
  const w: WA = { f: mkA() }
  const t = w.f
  if t != null { print(t[0][1]) } else { print("NUL") }
}
// Maps and sets route through `exprMap`'s Member arm — one struct, two flavours.
function map() {
  const w: WM = { g: mkM() }
  if w.g != null { print(w.g["a"] ?? 0) } else { print("NUL") }
}
function set() {
  const w: WS = { h: mkS() }
  if w.h != null { print(w.h.length) } else { print("NUL") }
}
// The `null` half of the same guard, so the else arm is exercised at the same position.
function arrNull() {
  const w: WA = { f: nul() }
  if w.f != null { print(w.f[0][1]) } else { print("NUL") }
}

arr()
arrTemp()
map()
set()
arrNull()
