// @run
// @log 10155
// @log 23
// An un-annotated parameter read at ten fields grows its demanded shape in place past the field-name
// index's threshold, and a field read again answers its first slot (D16558).
function sum(p) {
  return p.f0 + p.f1 + p.f2 + p.f3 + p.f4 + p.f5 + p.f6 + p.f7 + p.f8 + p.f9 + p.f0 * 100 + p.f9 * 1000
}
type W = { f0: i32, f1: i32, f2: i32, f3: i32, f4: i32, f5: i32, f6: i32, f7: i32, f8: i32, f9: i32, f10: i32, f11: i32 }
const w: W = { f0: 1, f1: 2, f2: 3, f3: 4, f4: 5, f5: 6, f6: 7, f7: 8, f8: 9, f9: 10, f10: 11, f11: 12 }
print(sum(w))
print(w.f10 + w.f11)
