// @run
// @log 10155
// @log 23
// An un-annotated parameter read at ten fields grows its demanded shape in place past the
// field-name index's threshold, and a field read again answers its first slot (D16558).
function sum(p) {
  return p.a
    + p.b
    + p.c
    + p.d
    + p.e
    + p.f
    + p.g
    + p.h
    + p.i
    + p.j
    + p.a * 100
    + p.j * 1000
}
type W = {
  a: i32,
  b: i32,
  c: i32,
  d: i32,
  e: i32,
  f: i32,
  g: i32,
  h: i32,
  i: i32,
  j: i32,
  k: i32,
  l: i32,
}
const w: W = {
  a: 1,
  b: 2,
  c: 3,
  d: 4,
  e: 5,
  f: 6,
  g: 7,
  h: 8,
  i: 9,
  j: 10,
  k: 11,
  l: 12,
}
print(sum(w))
print(w.k + w.l)
