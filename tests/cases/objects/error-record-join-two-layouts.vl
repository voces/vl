// @error an existing record keeps its own record layout where it is delivered (no copy is made), and this list literal holds records of two layouts
// @error an existing record keeps its own record layout where it is delivered (no copy is made), and this `if` gives records of two layouts
// @error an existing record keeps its own record layout where it is delivered (no copy is made), and this list literal holds records of two layouts
// An existing record joined with a record of another layout, in a list literal or an `if`, is held
// to the width floor a binding of it is: one list or value cannot hold two layouts (D15872).
type Pos = { x: f64, y: f64 }
type A = { k: i32, x: f64, y: f64 }
const a: A = { k: 7, x: 2.0, y: 3.0 }
const z: Pos = { x: 1.0, y: 2.0 }
const arr = [a, z]
print(arr[1].x)
const w = if a.k > 1 { a } else { z }
print(w.x)
const lit = [a, { x: 1.0, y: 2.0 }]
print(lit[1].x)
