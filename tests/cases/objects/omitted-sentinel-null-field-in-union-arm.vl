// @run
// @log const true true
// @log return true true
// @log argument true true
// @log other-arm true true
// @log field-given true true 1
// @log neighbours true true true true
// @log fallback true true
// A `{}` completing a union arm leaves a `boolean | null` or a literal union with `null` field
// at its own null, the sentinel its i32 slot holds (D17320), at each delivery position.
type Other = { b: i32 }
type OB = { q: boolean | null }
type OL = { q: "a" | "b" | null }
type OBz = { q: boolean | null, z: i32 }
type OLz = { q: "a" | "b" | null, z: i32 }
type OS = { q: string | null }
type OI = { q: i32 | null }
type OR = { q: Other | null }
type OV = { q: i32 | string | null }
function nb(v: Other | OB) { return if v is OB { v.q == null } else { false } }
function nl(v: Other | OL) { return if v is OL { v.q == null } else { false } }
const cb: Other | OB = {}
const cl: Other | OL = {}
print("const \{nb(cb)} \{nl(cl)}")
function mb(): Other | OB { return {} }
function ml(): Other | OL { return {} }
print("return \{nb(mb())} \{nl(ml())}")
print("argument \{nb({})} \{nl({})}")
const sb: OB | string = {}
const sl: OL | string = {}
const sbn = if sb is string { false } else { sb.q == null }
const sln = if sl is string { false } else { sl.q == null }
print("other-arm \{sbn} \{sln}")
const zb: Other | OBz = { z: 1 }
const zl: Other | OLz = { z: 1 }
const zbn = if zb is OBz { zb.q == null } else { false }
const zln = if zl is OLz { zl.q == null } else { false }
const zz = if zl is OLz { zl.z } else { 0 }
print("field-given \{zbn} \{zln} \{zz}")
const ns: Other | OS = {}
const ni: Other | OI = {}
const nr: Other | OR = {}
const nv: Other | OV = {}
const nsn = if ns is OS { ns.q == null } else { false }
const nin = if ni is OI { ni.q == null } else { false }
const nrn = if nr is OR { nr.q == null } else { false }
const nvn = if nv is OV { nv.q == null } else { false }
print("neighbours \{nsn} \{nin} \{nrn} \{nvn}")
function pick(k: i32): Other | OB | null {
  return if k == 0 { null } else { { q: true } }
}
const fb = pick(0) ?? {}
const fl: Other | OL = if nl(cl) { ({}) } else { { b: 2 } }
print("fallback \{nb(fb)} \{nl(fl)}")
