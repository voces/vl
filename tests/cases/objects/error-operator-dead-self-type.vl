// @check
// @error operator `+` can never dispatch: `self` is the LEFT OPERAND and dispatch needs an object, but i32 is not one
// @error operator `-` can never dispatch: `self` is the LEFT OPERAND and dispatch needs an object, but string is not one
// @error operator `*` can never dispatch: `self` is the LEFT OPERAND and dispatch needs an object, but i32 is not one
// @error operator `/` can never dispatch: `self` is the LEFT OPERAND and dispatch needs an object, but Bid is not one
// @error operator `%` can never dispatch: `self` is the LEFT OPERAND and dispatch needs an object, but i32[] is not one
// @error operator `<` can never dispatch: `self` is the LEFT OPERAND and dispatch needs an object, but U is not one
// GRADUATED from `silent-class-inventory` D425 — the DECLARATION side of the rule
// `checkBinary` already applies at every use site, and the third of the three
// declaration-site gates that row named (#2005 built the other two, D444's arity and
// D445's index receiver).
//
// THE SWALLOW WAS ALREADY THE LANGUAGE'S DECISION; IT WAS JUST SILENT AT THE
// DECLARATION. `checkBinary` reaches `opSelfFnTy` only under `if odsp is TyObj` over
// the LEFT OPERAND's type, so `function "+"(self: i32, other: i32) { return 99 }`
// beside `print(1 + 2)` was `vl check` rc 0 and printed `3` — not a dispatch that
// failed, one the language had already decided would never happen. The emitted module
// held the declared function, returning 99, with nothing calling it.
//
// KEYED ON THE RESOLVED TYPE, which is why it cannot live beside the parser's D444 and
// D471 clauses: an ALIAS (`Id = i32`), a NEWTYPE (`Bid = new i32`) and a UNION are all
// dead receivers and none of them is spelled `i32`, while an INTERSECTION spelled the
// same way is alive. The gate calls `binOpDeadSelf`, which is the negation of the
// dispatch gate rather than a restatement beside it.
//
// THE INTERSECTION IS WHY THIS ROW STAYED OPEN FOR TWO PASSES, and it is a CONTROL
// here rather than a reject. `type AB = {a} & {b}` IS an object — `intersectTy` merges
// the two shapes into a real `TyObj` — but `declaredTyOfName` hands the checker an
// OPAQUE one-member `TyUnion` box for it, because `singleAliasMemberTyIx`'s object arm
// is gated on `isPlainAliasRef` so that the EMITTER can intern `AB` as a named struct.
// The row filed that as a blocker: "`self` must be an object type" is a FALSE sentence
// for `self: AB`. It is false only of a test that cannot see through the box.
// `tyDenotesObj` looks through it, at the DECLARATION only, where the look-through can
// merely widen what is accepted; the SITE's refusal to dispatch over `AB` is D402's
// root and is untouched here (`print(x + y)` over two `AB`s is still
// `operator '+' is not defined for AB and AB`).
//
// THREE SHAPES IT MUST NOT REFUSE, each measured DISPATCHING today: an un-annotated
// `self` (`operator-self-method.vl`'s spelling), a generic `self: T` (silent at an i32
// site, dispatching at an object one — decided per call site, not here), and the
// intersection above. They are the subtractions `binOpDeadSelf` makes, and they are
// the reason the gate is not simply `!(is TyObj)`.
//
// THE PRICE, WHICH IS REAL AND ARGUED RATHER THAN ASSUMED AWAY: 110 grid cells go
// `runs` -> loud check reject, plus every program that declares such an operator and
// never uses it. Each ran ONLY because its own declaration was dead — the body says
// 99 and the program printed the built-in's answer — so it was producing a WRONG
// VALUE, and turning that loud is strictly better. Nothing in `compiler/`, `std/`,
// `tests/`, `bench/`, `playground/` or `reference/` loses a capability: all 8 arity-2
// `self`-named binary operator declarations in the tree take an object or a hole
// (instrumented count, gate reached 8 times and answered `false` 8 times).
type V = { x: i32 }
type Id = i32
type AB = { a: i32 } & { b: i32 }

function "+"(self: i32, other: i32): i32 { return 99 }

function -(self: string, other: string): i32 { return 99 }

// An ALIAS over a built-in is dead too, and it is not spelled `i32` — the reject
// reports what the annotation RESOLVES to.
function *(self: Id, other: Id): i32 { return 99 }

// A NEWTYPE over a built-in erases to the built-in and indexes into the same native
// lowering, so it is dead as well.
function /(self: Bid, other: Bid): i32 { return 99 }

function %(self: i32[], other: i32[]): i32 { return 99 }

function <(self: U, other: U): boolean { return true }

type Bid = new i32
type U = i32 | string

// CONTROLS — none of these is this gate's business, and each is one axis away from a
// reject above.
// A STRUCT receiver dispatches, and must keep dispatching.
function >(self: V, b: V): boolean { return self.x > b.x }

// An INTERSECTION alias denotes an object; the box `declaredTyOfName` keeps it in is
// the emitter's naming, not the language's rule. Accepted here (its SITE is D402).
function >=(self: AB, other: AB): i32 { return 99 }

// A generic `self` is decided per call site — it DISPATCHES at an object receiver.
function ^<T>(self: T, other: T): i32 { return 99 }

function cell(p: V, q: V): boolean { p > q }

print(cell({ x: 2 }, { x: 1 }))
