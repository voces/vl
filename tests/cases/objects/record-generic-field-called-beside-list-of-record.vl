// @run
// @log w
// @log 5
// @log 1
// @log w
// @log 2
// @log v
// @warning Unused variable `ys`
// A record whose field holds a generic, called at two types, stays a holder of the field's set
// when a list holds the record: read through the list, or not read at all, at module scope and in
// a function.
function k<T>(x: T): T { return x }
const r = { f: k, g: 7 }
const xs = [r]
print(xs[0].f("w"))
print(xs[0].f(5))
const r2 = { f: k, g: 8 }
const ys = [r2]
print(r2.f(1))
print(r2.f("w"))
function main() {
  const r3 = { f: k, g: 9 }
  const zs = [r3]
  print(zs[0].f(2))
  print(r3.f("v"))
}
main()
