// @error an object of type OW cannot flow into ON: they agree on field names but differ INSIDE a field, and a struct field is mutable — writing through the narrower view would leave the original holding a value of the wrong type, so the two are unrelated by design and not by a missing lowering. Give the source exactly ON's field types, or read the field out and rebuild
// D1609 — the ablation arm of `error-nested-width-pair-decoy-above.vl`.
//
// The same two bindings of `w`, with the decoy's one below the const. This arm refuses on the
// commit that named the defect and the above arm does not, which is what makes arena order the
// single ingredient rather than the extra function. Both arms are pinned because a name resolved
// through the scope chain answers the same at either position and one read off arena order does
// not, so a regression shows here as a split between two files that differ only in line order.
type Wide = { a: i32, b: i32 }
type Narrow = { a: i32 }
type OW = { n: Wide }
type ON = { n: Narrow }

function take(o: ON): i32 {
  (o.n).a
}

const w: OW = { n: { a: 1, b: 2 } }

function decoy(): i32 {
  const w = { n: { a: 9, b: 9 } }
  (w.n).a
}

print(take(w))
