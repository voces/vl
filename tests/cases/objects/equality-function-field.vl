// @run
// @log true
// @log true
// @log true
// A record with a function field refuses `==`, since a function has no value to compare
// (DECISIONS A15): its data fields compare by `==` and the function field by `===`, so the
// same data and the same function are equal, and a different function or data is not.
function inc(n: i32) n + 1
function dec(n: i32) n - 1
const a = { x: 1, f: inc }
const b = { x: 1, f: inc }
const c = { x: 1, f: dec }
const e = { x: 9, f: inc }
print(a.x == b.x && a.f === b.f)
print(a.x != c.x || a.f !== c.f)
print(a.x != e.x || a.f !== e.f)
