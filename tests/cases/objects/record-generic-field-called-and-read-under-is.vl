// @run
// @log 1
// @log in
// @log 7
// @log in
// @log 8
// A record's generic field called directly at one type and under `is` at another, through a
// narrower declared record parameter, takes a field per type (D6702).
type G = { g: i32 }
type H = { f: (x: string) => string, g: i32 }
function k<T>(x: T): T { return x }
function k2<T>(x: T): T { return x }
function show(o: G) {
  if o is H { print(o.f("in")) }
  print(o.g)
}
const r = { f: k, g: 7 }
print(r.f(1))
show(r)
const r2 = { f: k2, g: 8 }
show(r2)
