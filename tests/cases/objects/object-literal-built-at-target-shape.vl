// @run
// @log 4
// @log 5
// @log 5
// @log 6
// @log 7
// THE OTHER ACCEPTED NEIGHBOUR of `object-width-value-no-lowering.vl`, and the workaround
// the floor's diagnostic names: an object LITERAL is BUILT at the shape it flows into, so
// a literal whose shape merely DIFFERS from the destination's — a reordered field list, a
// field whose type widens — reaches an `Animal` slot with `Animal`'s rep. That is why the
// floor exempts a literal source, and it must keep working at every position the floor can
// fire from, otherwise the diagnostic would offer a fix that does not exist.
//
// THE EXEMPTION IS SCOPED TO WHAT BUILDING AT THE DESTINATION SHAPE ACTUALLY BUYS, and an
// EXCESS field is outside it: building at that shape is precisely what discards such a
// field, initializer and all. So every literal below carries exactly the destination's
// field names; the excess-field spelling is a REJECT, pinned by
// `objects/object-literal-excess-field-reject.vl`.
//
// This file passes on master too. It is a boundary pin, not a red-on-master fixture.
type Animal = { legs: i32, name: string }

// annotated binding, reordered field list
const a1: Animal = { name: "cat", legs: 4 }
print(a1.legs)

// annotated binding, a field whose type WIDENS from the literal's own (i32 -> i64)
type Wide = { f: i64 }
const w1: Wide = { f: 5 }
print(w1.f)

// argument
function countOne(a: Animal) { print(a.legs) }
countOne({ name: "dog", legs: 5 })

// array literal element
function countArr(xs: Animal[]) { print(xs[0].legs) }
countArr([{ name: "fox", legs: 6 }])

// a literal field VALUE that is itself a literal
type Shelter = { pet: Animal }
const s1: Shelter = { pet: { name: "owl", legs: 7 } }
print(s1.pet.legs)
