// @run
// @log 4
// @log 5
// @log 6
// @log 7
// THE OTHER ACCEPTED NEIGHBOUR of `object-width-value-no-lowering.vl`, and the workaround
// the floor's diagnostic names: an object LITERAL is BUILT at the shape it flows into, so
// a literal carrying extra fields reaches an `Animal` slot with `Animal`'s rep. That is
// why the floor exempts a literal source, and it must keep working at every position the
// floor can fire from — otherwise the diagnostic would offer a fix that does not exist.
//
// KNOWN, MEASURED, AND DELIBERATELY NOT PINNED HERE: the excess field's INITIALISER is
// dropped along with the field, so `{ legs: 4, purr: sideEffect() }` never calls
// `sideEffect`. That is a separate defect (a wrong evaluation COUNT on a program that
// checks clean, builds a valid module and prints the right number) and this file stays
// clear of it on purpose — every excess field below is a constant, so the values pinned
// are the values the language should produce either way.
//
// This file passes on master too. It is a boundary pin, not a red-on-master fixture.
type Animal = { legs: i32 }

// annotated binding
const a1: Animal = { legs: 4, purr: true }
print(a1.legs)

// argument
function countOne(a: Animal) { print(a.legs) }
countOne({ legs: 5, purr: true })

// array literal element
function countArr(xs: Animal[]) { print(xs[0].legs) }
countArr([{ legs: 6, purr: true }])

// a literal field VALUE that is itself a literal
type Shelter = { pet: Animal }
const s1: Shelter = { pet: { legs: 7, purr: true } }
print(s1.pet.legs)
