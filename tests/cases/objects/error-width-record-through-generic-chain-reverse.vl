// @error an object value of shape A flowing into Pos drops the field
// A generic forwarding a wider record through another generic into a declared record parameter
// is refused whatever order the three are declared in (D4010).
type Pos = { x: f64, y: f64 }
type A = { k: i32, y: f64, x: f64 }
function f3<W>(p: W) { f2(p) }
function f2<W>(p: W) { f1(p) }
function f1(p: Pos) { p.x = p.x + 1.0 }
const a: A = { k: 7, y: 3.0, x: 0.0 }
f3(a)
print(a.x)
