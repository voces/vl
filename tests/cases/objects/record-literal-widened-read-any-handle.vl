// @run
// @log 1
// @log 1
// @log 1
// @log -2147483646
// @log 1.5
// @log 3
// @hint redundant type annotation: `z` is inferred as `f32` — remove it to lean on inference
// A record literal built at a wider declared record reads its field back at its own type through
// every handle: a nested field (D3003), an alias (D3004), and an `f32` read of an `f64` slot
// (D3005), each narrowed from the storage the delivery chose.
type D = { v: f64 }
type W = { d: D }
const x = 3
const c: {[string]: W} = Map()
const o = { d: { v: x } }
c["k"] = o
print(o.d.v / 2)
const inner = o.d
print(inner.v / 2)

const m: {[string]: D} = Map()
const a = { v: x }
m["k"] = a
const same = a
print(same.v / 2)
const s2 = same
print(s2.v + 2147483647)

const y: f32 = 1.5
const f = { v: y }
m["f"] = f
const z: f32 = f.v
print(z)
print(f.v * 2)
