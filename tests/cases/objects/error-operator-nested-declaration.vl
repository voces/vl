// @check
// @error operator `+` can never dispatch: a binary operator must be declared at MODULE SCOPE, and this declaration is nested inside a function — move it to the top level
// @error operator `<` can never dispatch: a binary operator must be declared at MODULE SCOPE, and this declaration is nested inside a function — move it to the top level
// GRADUATED from `silent-class-inventory` D541 — the POSITION axis of the binary-operator
// declaration family, which no gate in it had ever looked at.
//
// D444's arity, D445's index receiver, D471's `self` name, D425's `self` type and
// D491/D521's whole-program deadness all live in `checkProgram`'s pass-1 hoist, and that
// hoist walks `gRootStmts` — the Program node's OWN statement list. So a `function "+"`
// written inside a function body escaped all five, at both `self` spellings and at every
// receiver: measured on `042624e1`, the two declarations below were `vl check` rc 0 and
// the program printed `10` / `true`, which is the built-in's answer and not theirs.
//
// IT IS DEAD AT EVERY RECEIVER, which is why the reject needs no type and no site bank.
// `opSelfFnTy` resolves the operator through `lookup(op)` on the TYPE scope; a nested
// declaration is recorded by `declareFnDeclNode` in a node table instead, so even an
// OBJECT receiver three lines below it is the loud `operator '+' is not defined for V and
// V` — a site error blaming the reader for not declaring what they just declared. The
// disassembly says the same thing from the other end: the nested declaration compiles to
// an empty closure body `(func $1 (param structref))` that nothing calls, while the site
// emits `i32.add` inline.
//
// The price is 40 grid cells and ZERO corpus cells, measured rather than assumed: no `.vl`
// under `tests/`, `std/`, `compiler/` or the distilled corpus declares a binary operator
// below module scope. The 40 are kept whole in `distilled/named/` as `d521_*_nest_i32_*`,
// because a price nothing in the corpus carries is exactly the price a later lift pays
// back invisibly.
type V = { x: i32 }

function outer(): i32 {
  function "+"(self: V, other: V): i32 { return 99 }
  const a: i32 = 8
  const b: i32 = 2
  return a + b
}

function inner(): boolean {
  function <(self, other) { return true }
  const a: i32 = 1
  const b: i32 = 2
  return a < b
}

print(outer())
print(inner())
