// @run
// @log 0.5
// @log 0.5
// @log 1.5
// @log 7
// @log true
// @log 2
// @log 3
// @log q
// @log a
// @log 3
// @log b
// @hint redundant type annotation: `v` is inferred as `{k: f64[]}`
// @hint redundant type annotation: `v` is inferred as `{k: f64[], m: f64}`
// @hint redundant type annotation: `b` is inferred as `{k: boolean}`
// @hint redundant type annotation: `i` is inferred as `{h: i32}`
// @hint redundant type annotation: `s` is inferred as `{k: string}`
// A record literal is built at the row of the record it is delivered into, even when another
// declared record shares its field names (D2437), and never at a row whose field it cannot
// fill: an `i32` is no `boolean` (D2435), a list no scalar (D2436), an `i32` no literal set.

type R = { k: f64[] }
type S = { k: f64[], m: f64 }
type T = { k: i32[], m: i32 }
type B = { k: boolean }
type I = { h: i32 }
type N = { k: string }
type K = "a" | "b"
type L = { j: K }
function assigned() {
  let v: R = { k: [1.5] }
  v = { k: [1, 2] }
  return v.k[1] / 4.0
}
function mk() { return { k: [1, 2] } }
function assignedTwo() {
  let v: S = { k: [1.5], m: 1.5 }
  v = { k: [3], m: 1 }
  return v.k[0] / 2.0
}
function mkT(): T { return { k: [5], m: 6 } }
function main() {
  print(assigned())
  const r: R = mk()
  print(r.k[1] / 4.0)
  print(assignedTwo() + mkT().m - 6.0)
  const b: B = { k: true }
  const n = { k: 7 }
  print(n.k)
  print(b.k)
  const xs = [1, 2]
  const i: I = { h: 3 }
  const li = { h: xs }
  print(li.h[1])
  print(i.h)
  const ss = ["p", "q"]
  const s: N = { k: "a" }
  const ls = { k: ss }
  print(ls.k[1])
  print(s.k)
  const l: L = { j: "b" }
  const lj = { j: 3 }
  print(lj.j)
  print(l.j)
}
main()
