// @run
// @log 5
// @log 5
// @log 5
// @log 9
// @log 4
// @log 5
// An INFERRED anonymous struct field holding a `u8[]` mints its row at field code 35 — the
// code `fieldCodeOfSpelling` gives the declared twin. The guessing rungs below read the
// literal's own type and a bare `[4, 5, 6]` never infers `u8[]`, so the code has to come from
// the destination the value adopts (D1854).
const src: u8[] = [4, 5, 6]
const h = { f: src }
print(h.f[1])
// Two packed fields in one row, and one beside a scalar — the row's key carries both.
const s2: u8[] = [7, 8]
const two = { a: src, b: s2 }
print(two.a[1])
const mixed = { f: src, n: 1 }
print(mixed.f[1])
// The field is the list itself: a write through it is visible at the source.
h.f[0] = 9
print(src[0])
// `push` through the field, and an anonymous row nested inside another.
h.f.push(1)
print(h.f.length)
const outer = { g: { f: s2 } }
print(outer.g.f[0] - 2)
