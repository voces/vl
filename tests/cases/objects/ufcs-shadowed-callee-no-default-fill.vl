// @check
// @error no field 'ld' on {v: i32}
// The UFCS arity range is read from the declaration the callee's name denotes, not from the flat
// top-level table. `ld` here is `go`'s parameter, so the module `function ld`'s `k: i32 = 5` is
// not this callee's default and cannot fill the missing argument. Before D1604 it did: the call
// type-checked with one argument short and the emitted module failed to validate.
function ld(self: {v: i32}, k: i32 = 5) { print(self.v + k) }
function go(b: {v: i32}, ld: ({v: i32}, i32) => void): void { b.ld() }
const bx = { v: 1 }
const cl: ({v: i32}, i32) => void = (bb, kk) => { print(bb.v * kk) }
go(bx, cl)
