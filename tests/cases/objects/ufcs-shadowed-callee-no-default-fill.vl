// @check
// @error `ld` here names a parameter at 7:25, not a function with a `self` parameter
// The UFCS arity range is never read from a declaration the callee's name does not denote. `ld`
// here is `go`'s fn-typed parameter, which declares no `self` parameter, so `b.ld()` is refused
// and the module `function ld`'s `k: i32 = 5` cannot fill the missing argument (D1604).
function ld(self: {v: i32}, k: i32 = 5) { print(self.v + k) }
function go(b: {v: i32}, ld: ({v: i32}, i32) => void): void { b.ld() }
const bx = { v: 1 }
const cl: ({v: i32}, i32) => void = (bb, kk) => {
  print(bb.v * kk)
}
go(bx, cl)
