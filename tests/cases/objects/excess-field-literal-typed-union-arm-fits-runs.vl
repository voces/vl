// @run
// @log 2
// @log 2
// @log 2
// @hint `B` is contained in `A`, so `is B` tests the value
// A literal whose field one union arm does not declare is built at the arm that declares it,
// at a binding, an argument and a return (D4070).
type A = { k: "a", v: i32 }
type B = { k: "a", v: i32, w: i32 }
type U = A | B
function wOf(u: U) {
  if u is B { return u.w }
  return -1
}
function m() {
  const u: U = { k: "a", v: 1, w: 2 }
  return wOf(u)
}
function r(): U { return { k: "a", v: 1, w: 2 } }
print(m())
print(wOf({ k: "a", v: 1, w: 2 }))
print(wOf(r()))
