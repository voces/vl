// @run
// @log 13
// @log true
// @log 4
// @log 2
// @log false
// @log 5
// @log 5
// @log 4
// @log -2
// @log 4
// @log 4
// @log 5
// @log -1
// @log 5
// @hint `A` is contained in `C`, so `is A` tests the value
// A record whose fields begin with one union arm's fields is delivered into the union as that
// arm: the same reference, boxed under the arm's tag, so a write through the binding shows
// through the union. A declared record that is another union's arm, a box narrowed to such an
// arm, a nullable record and a value of the other union are delivered alike; of two arms it fits,
// it takes the longer.
type A = { k: i32, legs: i32 }
type B = { s: string }
type Pet = A | B
type C = { k: i32 }
type D = { k: i32, legs: i32, purr: boolean }
function legs(p: Pet | null) {
  if p == null { return -2 }
  if p is A { return p.legs }
  -1
}
function mk(c: boolean): D | B {
  if c { return { k: 3, legs: 5, purr: true } }
  return { s: "x" }
}
function mn(c: boolean) {
  if c { return { k: 1, legs: 4, purr: true } }
  return null
}
const sv = { k: 1, legs: 4, purr: true }
const p: Pet = sv
sv.k = 9
if p is A { print(p.k + p.legs) }
print(sv.purr)
print(legs(sv))
const d: D = { k: 1, legs: 2, purr: false }
const w: D | B = d
print(legs(d))
if w is D { print(w.purr) }
const u = mk(true)
if u is D {
  const q: Pet = u
  print(legs(q))
  print(legs(u))
}
print(legs(mn(true)))
print(legs(mn(false)))
const ac: A | C = sv
if ac is A { print(ac.legs) } else { print(ac.k) }
const w2 = { k: 1, legs: 4, purr: true, z: 3 }
print(legs(w2))
const m = Map()
m["k"] = mk(true)
print(legs(mk(true)))
print(legs(mk(false)))
print(legs(m["k"]))
