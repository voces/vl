type Wide = { a: i32, b: i32 }
type Narrow = { a: i32 }
type OW = { n: Wide }
type ON = { n: Narrow }

function take(o: ON): i32 { return (o.n).a }

function decoy() {
  const w = { n: { a: 9, b: 9 } }
  return (w.n).a
}

