// @run
// @log ok
// D1070's witness. A struct callable FIELD and a module-scope `self`-function share
// the name `toString`, and the receiver is bound inside a FUNCTION BODY. The ruled
// order (DECISIONS: "field first, then a UFCS free function") makes this the field,
// so it prints `ok` — the free function's `self: {foo: string}` could not take this
// receiver at all, and picking it was `vl check` rc 0 followed by INVALID WASM.
//
// UN-ANNOTATED on purpose: the binding's rep is pinned by inference, which is the
// spelling an annotating fixture cannot see (CLAUDE.md).
function toString(self: {foo: string}) { self.foo }
function f() {
  const a = { toString: () => "ok" }
  print(a.toString())
}
f()
