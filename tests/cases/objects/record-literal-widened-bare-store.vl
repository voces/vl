// @run
// @log 1.5
// @log 1
// @log 1
// @log 1
// @log 1.5
// @hint redundant type annotation: `slot` is inferred as `{v: f64}` — remove it to lean on inference
// A bare-name store `slot = o` into a binding of a wider declared record builds the literal there
// (D3007), and a literal-bound name assigned into a `let` a delivery re-seated follows it to the
// same record (D3008).
type D = { v: f64 }
const x = 3
let slot: D = { v: 1.5 }
const o = { v: x }
slot = o
print(slot.v / 2.0)
print(o.v / 2)

const c: {[string]: D} = Map()
let q = { v: x }
c["k"] = q
const p = { v: 4 }
q = p
print(q.v / 3)
print(p.v / 3)
const r = c["k"]
if r != null { print(r.v / 2.0) }
