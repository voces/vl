// @run
// @log 1.5
// @log 1.5
// @log 1.3333333333333333
// @log 1.3333333333333333
// @log 1.5
// A bare-name store `slot = o` into a binding of a wider declared record builds the literal there
// (D3007), and a literal-bound name assigned into a `let` a delivery re-seated follows it to the
// same record (D3008); each binding reads at that record's type, as its annotated twin does.
type D = { v: f64 }
const x = 3
let slot: D = { v: 1.5 }
const o = { v: x }
slot = o
print(slot.v / 2.0)
print(o.v / 2)

const c: {[string]: D} = Map()
let q = { v: x }
c["k"] = q
const p = { v: 4 }
q = p
print(q.v / 3)
print(p.v / 3)
const r = c["k"]
if r != null { print(r.v / 2.0) }
