// @run
// @log 1
// @log 7
// @log s
// @log 7
// @log 8
// @log 9
// @log in
// @log 10
// Two records of one shape each holding a generic called at its own type, handed to one
// parameter of a narrower declared record, each keep their own instance; a parameter that cannot
// read a function out of the record leaves an uncalled generic inert (D6471).
type G = { g: i32 }
type H = { f: (x: string) => string, g: i32 }
function k<T>(x: T): T { return x }
function k2<T>(x: T): T { return x }
function k3<T>(x: T): T { return x }
function k4<T>(x: T): T { return x }
function show(o: G) { print(o.g) }
const r = { f: k, g: 7 }
print(r.f(1))
show(r)
const r2 = { f: k2, g: 7 }
print(r2.f("s"))
show(r2)
const r3 = { f: k3, g: 8 }
show(r3)
function look(o: G) {
  if o is H { print(o.f("in")) }
  print(o.g)
}
look({ g: 9 })
const r4 = { f: k4, g: 10 }
look(r4)
