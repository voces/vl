// @run
// @log true
// @log false
// @hint redundant type annotation: `same` is inferred as `boolean`
// CONTRACT (D959): two declared types with the SAME shape compare with `==`. VL is
// structurally typed, so `Circle` and `Circle2` below are one type — and the emitter agrees
// where it matters: disassembled, the module carries ONE `(struct (field (mut i32)))` for
// both, so the field-wise compare reads through a heap type both operands genuinely have.
//
// On master this pair was `vl check` rc 0 followed by `emitProgram: struct equality is not
// supported yet` — a clause-2 violation, and one the checker could NOT have owned instead:
// `Circle == Dot` with DIFFERENT shapes is already a loud check reject, which is the control
// saying the type system is doing its job and only the emitter was guessing.
//
// BOTH VALUES ARE PINNED because the fix must be a real field compare, not reference
// identity: `{r: 1} == {r: 1}` is true across the two names and `{r: 1} == {r: 2}` is false.
type Circle = { r: i32 }
type Circle2 = { r: i32 }

function same(a: Circle, b: Circle2): boolean {
  a == b
}

print(same({ r: 1 }, { r: 1 }))
print(same({ r: 1 }, { r: 2 }))
