// @run
// @log 5
// @log 5
// @log 5
// D14872: a binding of an `if` or `match` whose every tail is an object literal holds only fresh
// records, so it adopts the record it is delivered to, as a binding of one literal does
// (DECISIONS.md, record covariance): at an annotated binding and at an argument.
type J = { f: i32 | null }
function g(x: i32) {
  const n = if x > 0 { { f: 5 } } else { { f: 4 } }
  const b: J = n
  print(b.f ?? 70)
}
g(3)
const x = 3
const m = match x {
  3 => { f: 5 }
  _ => { f: 4 }
}
const c: J = m
print(c.f ?? 70)
function take(j: J) { print(j.f ?? 70) }
const k = if x > 0 { { f: 5 } } else { { f: 4 } }
take(k)
