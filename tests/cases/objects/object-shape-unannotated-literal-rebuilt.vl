// @run
// @log 7
// @log 7
// @log 7
// @log 4
// @log 4
// THE BOUNDARY OF THE OBJECT-SHAPE FLOOR, pinned from the ACCEPTING side, because the
// axis that decides these is the source's shape PROVENANCE and nothing in the types says
// which side of it a program is on.
//
// Every binding below is UN-ANNOTATED with an object-literal initialiser, so the emitter
// re-interns that literal at the destination row and the flow works — even though the two
// shapes are not identical: a field whose own type widens (`i32` into `i64`, into
// `i32 | null`, into `i32 | string`), a REORDERED field list, and a nested shape that
// drops a field. Annotate the same bindings and every one of them emits invalid wasm
// instead; that annotated twin is a `vl check`-clean emit hole this slice deliberately
// does NOT reject, because rejecting it would reject these.
//
// So this is the pin a later variance implementation moves against from the other
// direction: it may make the annotated twins work, and it may not make these stop.
//
// This file passes on master too. It is a boundary pin, not a red-on-master fixture.

// a field whose own type widens numerically
function widenNum() {
  const sv = { a: 7, f: true }
  const u: {a: i64, f: boolean} = sv
  print(u.a)
}

// a field that gains `| null`
// (its field is named apart from the others on purpose: two same-field-name-set shapes
// with different field REPS in one module collide in the emitter's literal-row resolver,
// on master and here alike, and that collision is not what this file pins)
function widenNullable() {
  const sv = { b: 7 }
  const u: {b: i32 | null} = sv
  print(u.b ?? 0)
}

// a field that gains a union member
function widenUnion() {
  const sv = { c: 7 }
  const u: {c: i32 | string} = sv
  if u.c is i32 { print(u.c) }
}

// the same field NAMES in another order
function reorderFields() {
  const sv = { purr: true, legs: 4 }
  const u: {legs: i32, purr: boolean} = sv
  print(u.legs)
}

// a NESTED shape that drops a field
function nestedDrop() {
  const sv = { pet: { legs: 4, purr: true } }
  const u: {pet: {legs: i32}} = sv
  print(u.pet.legs)
}

widenNum()
widenNullable()
widenUnion()
reorderFields()
nestedDrop()
