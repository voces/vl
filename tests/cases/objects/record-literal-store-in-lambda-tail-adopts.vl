// @run
// @log 1.5
// @log 1.5
// @hint redundant type annotation: `x` is inferred as `i32`
// D2994: a binding holding only a literal, stored into a map of a record that stores its field
// as `f64`, takes that record as its type, so the lambda whose last statement is the store
// returns a `D` too, and every read of `o` computes at `f64` (DECISIONS.md "Record covariance").
type D = { v: f64 }
const x: i32 = 3
const c: {[string]: D} = Map()
const o = { v: x }
const f = () => {
  c["k"] = o
}
f()
print(o.v / 2)
const r = c["k"]
if r != null { print(r.v / 2) }
