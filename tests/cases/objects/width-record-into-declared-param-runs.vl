// @run
// @log 3
// @log 2.5
// @log 8
// @log 17.5
// @log 5
// @log s
// @log 6
// @log 4
// @log 3
// @log 12
// A record with more fields than a function's declared record parameter is passed to it as it
// is, so a write through the parameter reaches it: the parameter takes each argument's own
// layout (D3992). It holds through a forwarding call, recursion and a closure (D3993).
type Pos = { x: f64, y: f64 }
type A = { k: i32, x: f64, y: f64 }
type B = { y: f64, x: f64, name: string }
function mv(p: Pos, dx: f64) { p.x += dx }
function len(p: Pos): f64 { p.x + p.y }
function fwd(p: Pos) { mv(p, 1.0) }
function walk(p: Pos, n: i32) {
  if n > 0 {
    p.x += 1.0
    walk(p, n - 1)
  }
}
function tagged<T>(p: Pos, t: T) {
  p.x += 1.0
  print(t)
}
function dbl(p: Pos): f64 { p.x * 2.0 }
function main() {
  const a: A = { k: 1, x: 2.0, y: 3.0 }
  const b: B = { y: 1.0, x: 0.5, name: "b" }
  const q: Pos = { x: 5.0, y: 0.0 }
  mv(a, 1.0)
  mv(b, 2.0)
  mv(q, 3.0)
  print(a.x)
  print(b.x)
  print(q.x)
  print(len(a) + len(b) + len(q))
  const c: A = { k: 2, x: 1.0, y: 0.0 }
  walk(c, 3)
  fwd(c)
  print(c.x)
  tagged(b, "s")
  const f = () => {
    fwd(c)
  }
  f()
  print(c.x)
  print(b.x + 0.5)
  const xs: A[] = [{ k: 1, x: 2.0, y: 3.0 }, { k: 2, x: 1.0, y: 0.0 }]
  let s = 0.0
  for e in xs { s = s + dbl(e) }
  print(s / 2.0)
  print(dbl(xs[0]) * 3.0)
}
main()
