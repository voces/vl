// @run
// @log field
// @log field
// @log field
// @log field
// @log field
// @log field
// @warning Unused parameter `self` (prefix with `_` to suppress, or remove it)
// The warning is declared rather than fixed: a UFCS `self`-function's first parameter
// must be NAMED `self` to be dispatch-reachable at all, and this one's whole job is to
// stay unreached. Renaming it to `_self` would make the case measure nothing.
//
// D1070's headline cell, at every RECEIVER SCOPE. The `self`-function ADMITS the
// receiver here, so BOTH resolutions type and the printed word is the measurement
// rather than a crash: `field` means the ruled field-first order held, `UFCS` means
// the free function won.
//
// Before the fix the answer depended on where the receiver was BOUND — module top
// level and a captured/parameter receiver printed `field`, while a plain body, an
// arrow lambda and a nested named function printed `UFCS`. The emitter was asking
// `structIndexOfExpr` (an emit-side struct-table ROW, which `buildLocals` has not
// filled when the dispatch rewrite runs) where the checker asks the receiver's own
// recorded TYPE. One predicate now answers for both.
function toString(self: {toString: () => string}) { return "UFCS" }

// 1 — module top level
const top = { toString: () => "field" }
print(top.toString())

// 2 — a plain function body
function inBody() {
  const a = { toString: () => "field" }
  print(a.toString())
}
inBody()

// 3 — an arrow lambda's body
const inLambda = () => {
  const a = { toString: () => "field" }
  print(a.toString())
}
inLambda()

// 4 — a NESTED named function's body
function outer() {
  function inner() {
    const a = { toString: () => "field" }
    print(a.toString())
  }
  inner()
}
outer()

// 5 — bound at top level, USED inside a lambda (captured)
const cap = { toString: () => "field" }
const useCap = () => { print(cap.toString()) }
useCap()

// 6 — the receiver is a PARAMETER
function takes(a: {toString: () => string}) { print(a.toString()) }
function passIt() {
  const a = { toString: () => "field" }
  takes(a)
}
passIt()
