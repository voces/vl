// @emit-error this field is stored at a wider record whose member two of its own members widen to
// Two own members (`i32`, `f32`) are both stored as the wider record's `f64`, so a read at the
// own type cannot tell which one the box held. Refused loudly, not guessed (D3006).
type D = { v: f64 | string }
const x: i32 | f32 | string = 1.5
const o = { v: x }
const c: {[string]: D} = Map()
c["k"] = o
const t = o.v
if t is f32 { print(t * 2) }
