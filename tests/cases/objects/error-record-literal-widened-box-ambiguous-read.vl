// @check
// @error `o` is built as D where line 9 delivers it, which stores field `v` (`i32 | f32 | string`) as `f64 | string`, keeping two of its numbers as one
// Two own members (`i32`, `f32`) are both stored as the wider record's `f64`, so a read at the own
// type cannot tell which one the box held: refused at the delivery, as D3011's merge is (D12462).
type D = { v: f64 | string }
const x: i32 | f32 | string = 1.5
const o = { v: x }
const c: {[string]: D} = Map()
c["k"] = o
const t = o.v
if t is f32 { print(t * 2) }
