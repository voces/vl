// @run
// @log 1
// @log 7
// @log 3
// @log 2
// A generic forwarding a wider record through another generic into a declared record parameter
// passes it at its own row whatever order the three are declared in (D4020, D16219).
type Pos = { x: f64, y: f64 }
type A = { k: i32, y: f64, x: f64 }
function f3<W>(p: W) { f2(p) }
function f2<W>(p: W) { f1(p) }
function f1(p: Pos) { p.x = p.x + 1.0 + p.y * 0.0 }
function h1(p: Pos) { p.x = p.x + 1.0 }
function h2<W>(p: W) { h1(p) }
function h3<W>(p: W) { h2(p) }
const a: A = { k: 7, y: 3.0, x: 0.0 }
f3(a)
print(a.x)
print(a.k)
print(a.y)
h3(a)
print(a.x)
