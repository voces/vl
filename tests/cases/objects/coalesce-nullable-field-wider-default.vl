// @run
// @log 2.5
// @log 1.5
// @log true
// @log 7
// @log 0.5
// A `??` over a nullable scalar record field with a wider runtime default builds, and joins the
// two apart as the same `??` over a parameter does (D10060, D10061). A delivery into the wider
// type widens the field when present.
function pick(r: { v: i32 | null }, d: f64) { return r.v ?? d }
const a: { v: i32 | null } = { v: 5 }
const w: f64 = pick(a, 1.5)
print(w / 2)
const b: { v: i32 | null } = { v: null }
print(pick(b, 1.5))
print(pick(a, 1.5) is i32)
function wide(r: { v: i32 | null }, d: i64) { return r.v ?? d }
print(wide(a, 9) + 2)
function hole(r, d) { print(r.v ?? d) }
const c: { v: i32 | null } = { v: null }
hole(c, 0.5)
