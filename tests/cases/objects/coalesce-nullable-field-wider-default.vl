// @run
// @log 2.5
// @log 1.5
// @log 7
// @log 0.5
// A `??` over a nullable scalar record field with a wider default is the wider type, the
// field widened when present (D10060).
function pick(r: { v: i32 | null }, d: f64) { return r.v ?? d }
const a: { v: i32 | null } = { v: 5 }
print(pick(a, 1.5) / 2)
const b: { v: i32 | null } = { v: null }
print(pick(b, 1.5))
function wide(r: { v: i32 | null }, d: i64) { return r.v ?? d }
print(wide(a, 9) + 2)
function hole(r, d) { print(r.v ?? d) }
const c: { v: i32 | null } = { v: null }
hole(c, 0.5)
