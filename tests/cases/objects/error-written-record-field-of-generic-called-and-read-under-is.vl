// @emit-error a generic function taken as a value reaches no call that fixes its type
// A field the program writes is no fixed function: the call through it is not its first
// value's direct call, and the refusal stands.
type G = { g: i32 }
type H = { f: (x: string) => string, g: i32 }
function k<T>(x: T): T { return x }
function show(o: G) {
  if o is H { print(o.f("in")) }
  print(o.g)
}
function other<T>(x: T): T {
  print("other")
  return x
}
const r = { f: k, g: 7 }
r.f = other
print(r.f(1))
show(r)
