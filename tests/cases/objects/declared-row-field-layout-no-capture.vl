// @run
// @log 1
// @log 2
// @log 1.5
// @log 4
// @log 3
// @log 2
// @log 5
// @log 1
// @log 9
// @log 0
// @log 2
// @log 1.5
// @hint redundant type annotation: `ps` is inferred as `{x: i32}[]`
// @hint redundant type annotation: `ann` is inferred as `{k: i32[]}`
// @hint redundant type annotation: `q` is inferred as `{k: {x: i32}[]}`
// @hint redundant type annotation: `a` is inferred as `{k: i32}`
// @hint redundant type annotation: `nq` is inferred as `{k: {x: i32}[]}`
// An un-annotated record literal shares a declared row with its field names only where the two
// fields share a layout: a struct list is no `i32[]`, a record no `i32` and no record list, an
// `f64[]` no `i32[]` (D2423). An integer array literal still widens into a declared list.

type P = { x: i32 }
type Q = { k: P[] }
type A = { k: i32 }
type R = { k: f64[] }
function readF(r: R) { return r.k[0] }
function readQ(r: Q) { return r.k.length }
function inFn(xs: f64[]) {
  const r = { k: xs }
  return r.k[0]
}
function main() {
  const ps: P[] = [{ x: 1 }]
  const p = { k: ps }
  print(p.k[0].x)
  const ann: { k: i32[] } = { k: [1, 2] }
  print(ann.k[1])
  print(inFn([1.5]))
  const q: Q = { k: [{ x: 4 }] }
  print(q.k[0].x)
  const s = { k: [1, 3] }
  print(s.k[1])
  print(readF({ k: [2] }))
  const a: A = { k: 5 }
  print(a.k)
  const o = { k: { x: 1 } }
  print(o.k.x)
  const nq: Q = { k: [{ x: 9 }] }
  print(nq.k[0].x)
  print(readQ({ k: [] }))
  print(readQ({ k: ps + ps }))
  const lit = { k: [1.5] }
  print(lit.k[0])
}
main()
