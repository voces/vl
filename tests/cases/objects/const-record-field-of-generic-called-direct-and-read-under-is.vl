// @run
// @log 1
// @log s
// @log 2.5
// @log in
// @log 7
// @log 3
// @log in
// @log 8
// A call through a field of a `const` record literal that names a declared function, never
// written, is that function's direct call, so the field keeps the one closure a narrowing read
// takes, at module scope and inside a function.
type G = { g: i32 }
type H = { f: (x: string) => string, g: i32 }
function k<T>(x: T): T { return x }
function show(o: G) {
  if o is H { print(o.f("in")) }
  print(o.g)
}
const r = { f: k, g: 7 }
print(r.f(1))
print(r.f("s"))
print(r.f(2.5))
show(r)
function main() {
  const r2 = { f: k, g: 8 }
  print(r2.f(3))
  show(r2)
}
main()
