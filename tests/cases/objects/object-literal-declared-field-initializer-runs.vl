// @run
// @hint redundant type annotation: `a1` is inferred as `{legs: i32, purr: boolean}`
// @hint redundant type annotation: `s1` is inferred as `{pet: {legs: i32, purr: boolean}}`
// @log SIDE EFFECT RAN legs
// @log 4
// @log SIDE EFFECT RAN arg
// @log 5
// @log SIDE EFFECT RAN ret
// @log 6
// @log SIDE EFFECT RAN nested
// @log 7
// @log SIDE EFFECT RAN elem
// @log 8
// THE OBSERVABLE HALF of `objects/object-literal-excess-field-reject.vl`: every field
// initializer in an object literal RUNS, in source order, once. This is the contract the
// excess-field drop violated silently — there, the call in the extra field never happened
// and the only evidence was an absent line.
//
// It is a MUST-NOT-REGRESS pin, not a red-on-master fixture, and the difference matters:
// the fix turns the excess-field program into a reject, so no program's output changes and
// no `@log` file can be red on master for that defect. What a log form CAN hold is the
// neighbour one field name away — declare `purr` on `Animal` and the same call runs — and
// that is what makes the reject's diagnostic ("declare it on Animal") an honest way out.
//
// The `side` argument is printed so the ORDER and the COUNT are both pinned: a lowering
// that evaluated a field twice, or evaluated the fields in struct-declaration order rather
// than source order, moves a line here.
type Animal = { legs: i32, purr: boolean }
type Shelter = { pet: Animal }

function side(s: string) {
  print("SIDE EFFECT RAN " + s)
  return true
}

const a1: Animal = { legs: 4, purr: side("legs") }
print(a1.legs)

function countOne(a: Animal) { print(a.legs) }
countOne({ legs: 5, purr: side("arg") })

function mk(): Animal {
  return { legs: 6, purr: side("ret") }
}
print(mk().legs)

const s1: Shelter = { pet: { legs: 7, purr: side("nested") } }
print(s1.pet.legs)

function countArr(xs: Animal[]) { print(xs[0].legs) }
countArr([{ legs: 8, purr: side("elem") }])
