// @run
// @log true
// @log 1
// @log 4
// @log 4
// D8240, D8260: a record field is a second delivery position for both. A field holding a list
// of a generic constructor's `boolean` pin beside its `i32` pin, and a field holding a map whose
// value union only the constructor's type argument spells.

type J = { r: i32 }
function pc<T>(x: T) { { a: x } }

const h = { p: [pc(1)], q: [pc(true)] }
print(h.q[0].a)
print(h.p[0].a)

const o = { m: Map<string, J | string>() }
o.m.set("a", { r: 4 })
const g = o.m.get("a")
if g is J { print(g.r) }

const oa: { m: Map<string, J | string> } = { m: Map() }
oa.m.set("a", { r: 4 })
const ga = oa.m.get("a")
if ga is J { print(ga.r) }
