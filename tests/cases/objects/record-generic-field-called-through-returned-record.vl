// @run
// @log 1
// @log z
// @log w
// @log w
// @log 5
// A maker's generic result in a record field takes a field per type, so a call through a
// returned or listed record reaches the field of its own type (D6700).
function k<T>(x: T): T { return x }
function mk() { return k }
const r = { f: mk(), g: 7 }
function get() { return r }
const xs = [r]
print(r.f(1))
print(r.f("z"))
print(get().f("w"))
print(xs[0].f("w"))
print(xs[0].f(5))
