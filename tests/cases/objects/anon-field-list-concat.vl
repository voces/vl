// @run
// @log 3
// @log 3
// @log 3.5
// @log 1
// @log c
// @log 7
// @log 3
// @log false
// @log 4
// @log 1.5
// @log q
// @log 5
// @log 2.25
// @log b
// @log 2.5
// @log 1.5
// @log 1.5
// @log 1.5
// @log 3
// @log 3
// @hint redundant type annotation: `ps` is inferred as `{x: i32}[]`
// @hint redundant type annotation: `qs` is inferred as `{x: i32}[]`
// @hint redundant type annotation: `us` is inferred as `(i32 | string)[]`
// @hint redundant type annotation: `ann` is inferred as `{k: i32[]}`
// An inferred record field holding a list concatenation is a list slot: the anonymous row
// coded every `+` it could not read as a string concat as arithmetic, and stored the list
// into an i32 field (D2382). Every element type, and the field's other delivery positions.

type P = { x: i32 }
function inFn(xs: f64[], ys: f64[]) {
  const r = { k: xs + ys }
  return r.k[1]
}
function ret(xs: string[], ys: string[]) { return { k: xs + ys } }
function main() {
  const i = { k: [1, 2] + [3] }
  print(i.k.length)
  print(i.k[2])
  const fs = [1.5, 2.5]
  const f = { k: fs + [3.5] }
  print(f.k[2])
  const ls: i64[] = [1, 2]
  const l = { k: ls + ls }
  print(l.k[2])
  const ss = ["a", "b"]
  const s = { k: ss + ["c"] }
  print(s.k[2])
  const ps: P[] = [{ x: 1 }]
  const qs: P[] = [{ x: 7 }]
  const p = { k: ps + qs }
  print(p.k[1].x)
  const ns = [[1], [2, 3]]
  const n = { k: ns + [[4]] }
  print(n.k[1][1])
  const bs = [true]
  const b = { k: bs + [false] }
  print(b.k[1])
  const us: (i32 | string)[] = [1, "s"]
  const u = { k: us + us }
  print(u.k.length)
  const two = { a: 5, k: fs + fs, s: ["q"] + ["q"] }
  print(two.k[0])
  print(two.s[1])
  print(two.a)
  print(inFn([1.0], [2.25]))
  print(ret(["a"], ["b"]).k[1])
  const mk = () => ({ k: [2.5] + [2.5] })
  print(mk().k[1])
  const nested = { a: { k: fs + fs } }
  print(nested.a.k[0])
  const rows = [{ k: fs + fs }]
  print(rows[0].k[2])
  const nul: f64[] | null = [1.5]
  if nul != null {
    const r = { k: nul + nul }
    print(r.k[1])
  }
  const chain = { k: fs + fs + [9.0] }
  print(chain.k.length - 2)
  const ann: { k: i32[] } = { k: [1, 2] + [3] }
  print(ann.k.length)
}
main()
