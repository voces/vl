// @run
// @log 8
// @log 42
// @log 99
// @warning Unused parameter `self` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `other` (prefix with `_` to suppress, or remove it)
// @hint redundant type annotation: `+` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `unrelated` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `objsite` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `a` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `b` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `pv` is inferred as `{x: i32}` — remove it to lean on inference
// @hint redundant type annotation: `qv` is inferred as `{x: i32}` — remove it to lean on inference
// THE BOUNDARY OF D491's REJECT, AND IT IS #2007's OWN REFUTATION PROGRAM — the three
// lines that killed the CALL-SITE rule, kept whole as the control the declaration-site
// answer must not break.
//
// `print(a + b)` at i32 is the cell a reject wants; `unrelated()` is a `+` in a different
// function entirely; `objsite` is the SAME generic declaration DISPATCHING at an object
// receiver, which must keep working. A site reject that catches the first also catches the
// second and has to leave the third alone — that is why PLACEMENT (B) was refused.
//
// The end-of-`checkProgram` verdict touches none of them: an object site DID dispatch to
// `+`, so the declaration is not dead and nothing is reported. Everything prints exactly
// what it printed before the rung landed, including the `8` — the very cell D491 files.
// The row is closed for a program whose only `+` sites decline; a program with one live
// site is out of the class by the rule's own predicate, not by an exception carved for it.
type V = { x: i32 }
function "+"<T>(self: T, other: T): i32 { return 99 }
function unrelated(): i32 { return 40 + 2 }
function objsite(p: V, q: V): i32 { p + q }
const a: i32 = 7
const b: i32 = 1
const pv: V = { x: 1 }
const qv: V = { x: 2 }
print(a + b)
print(unrelated())
print(objsite(pv, qv))
