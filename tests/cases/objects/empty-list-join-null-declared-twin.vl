// @run
// @log witness true
// @log take 1 q
// @log f64 0
// @log local false
// @log local true
// @log reversed false
// @log two true 3
// A record literal holding an un-annotated `[] | null` join is not built as a declared record
// whose field is a list of another element, and keeps its `null` (D6271).
import { toString } from "std:fmt"

type B = { xs: string[] | null }
type F = { xs: f64[] | null }
type Two = { n: i32, xs: string[] | null }

function t() { 1 == 1 }

const b = { xs: if !t() { [] } else { null } }
const y = b.xs
print("witness " + toString(y == null))

function take(a) {
  if a != null {
    a.push("q")
    print("take " + toString(a.length) + " " + a[0])
  }
}
const b2 = { xs: if t() { [] } else { null } }
take(b2.xs)

const fb = { xs: if t() { [] } else { null } }
if fb.xs != null { print("f64 " + toString(fb.xs.length)) }

function local(c: boolean) {
  const lb = { xs: if c { [] } else { null } }
  print("local " + toString(lb.xs == null))
}
local(true)
local(false)

const rb = { xs: if t() { null } else { [] } }
print("reversed " + toString(rb.xs != null))

const tw = { n: 3, xs: if !t() { [] } else { null } }
print("two " + toString(tw.xs == null) + " " + toString(tw.n))
