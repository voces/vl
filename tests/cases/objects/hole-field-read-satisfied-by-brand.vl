// @run
// @log 3
// @log 7
// @log hi
// @log 3
// A `new`-branded argument reaching an un-annotated parameter whose only use is a FIELD READ.
// The hole solve synthesises a structural shape (`{x: _}`) from `p.x`, then checked the branded
// argument against that shape and refused it — `argument 1: expected {x: _}, got Pln` — even
// though `Pln` is the very type that induced the demand. A brand is erased at run time (the arena
// is structural), so the underlying structure is exactly what the body reads. D1894.
//
// The structural twin (`type S = { … }`, no `new`) ran already and is the control: this fixture
// pins that the brand no longer changes the answer.

type Pln = new { x: i32 }

function mkPln(): Pln {
  const r: Pln = { x: 3 }
  return r
}

function readX(p) { print(p.x) }
readX(mkPln())

type Pair = new { x: i32, y: i32 }

function mkPair(): Pair {
  const r: Pair = { x: 3, y: 4 }
  return r
}

function readSum(p) { print(p.x + p.y) }
readSum(mkPair())

type Named = new { s: string }

function mkNamed(): Named {
  const r: Named = { s: "hi" }
  return r
}

function readS(p) { print(p.s) }
readS(mkNamed())

// Delivered through a FIELD rather than straight from a call — the demand is the same.
const box = { it: mkPln() }

function viaField(p) { print(p.x) }
viaField(box.it)
