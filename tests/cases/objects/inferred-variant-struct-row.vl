// @run
// D1737 / D1738 — a struct that becomes a union VARIANT through an INFERRED join has its
// struct row registered under the structural render, so the name scan missed it and the
// VARIANT-table index answered in its place. The two coincide only while the arm's struct
// is row 0, which is why a second declared struct is what makes the defect visible.

// Every line below delivers the same `A` somewhere its row is read: the join itself, a
// binding, a return, an annotated parameter and a hole parameter. A declared
// `type M = string | A` does not reproduce it — that registration gives `A` a named row.

// @log 8
// @log 8
// @log 8
// @log 8
// @log 8

// The holder is declared, and annotated, so `W` has a real row ahead of `A`'s: with one
// struct in the table the two indices coincide and the family is invisible.
// @hint Intentionally-unused variable `_wpad` (leading `_` marks it unused)
// @hint redundant type annotation: `_wpad` is inferred as `{g: i32, h: i32}` — remove it to lean on inference

type W = { g: i32, h: i32 }
type A = { r: i32 }

function mkS(): string | null { return null }
function st(): A { return { r: 8 } }

const _wpad: W = { g: 1, h: 2 }

// the inferred join, which is what makes `A` a variant at all
const v = mkS()
const k = v ?? st()
if k is A { print(k.r) } else { print(0) }

// and the same struct still delivered as itself, at the positions its row is read from
const b = st()
print(b.r)

function ret(): A { return st() }
print(ret().r)

function take(a: A) { print(a.r) }
take(st())

function takeHole(a) { print(a.r) }
takeHole(st())
