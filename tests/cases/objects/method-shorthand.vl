// @run
// @log 7
// @log 12
// A function-valued object field is callable as a method (ROADMAP B5/B15). The
// `add(a, b) { … }` shorthand spelling desugars to exactly this field and is
// pinned in `tests/vl_fmt_test.ts`, which reads its text without formatting it.
const foo = {
  add: (a: i32, b: i32) => {
    return a + b
  },
}
print(foo.add(3, 4))
print(foo.add(5, 7))
