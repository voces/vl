// @check
// @error-at 17:8 no field 'area' on Box
// @error-at 20:32 no field 'area' on Box
// D1260's CONTROL for a self-function in THE SAME FILE that is simply out of
// scope. It keeps the plain sentence, and the reason is the code's name: there is
// no import that would make either call resolve, so `ufcs-not-imported` would be
// a false promise and a quick-fix keyed on it would have nothing to write.
//
// Both spellings refuse today, and the FIRST one is the interesting half: a
// nested `self`-function is not reachable by UFCS even from inside its own
// enclosing frame, so "move the call in" is not a fix either. The enrichment is
// scoped to a missing IMPORT, which is a fault with a mechanical repair; this one
// is a scoping mistake, which is not.
type Box = { v: i32 }

function outer(inner: Box): i32 {
  function area(self: Box) { self.v * self.v }
  inner.area()
}

function useIt(b: Box): i32 { b.area() }

print(outer({ v: 2 }))
print(useIt({ v: 5 }))
