// @check
// @error-at 13:32 no field 'area' on Box
// D1230's control for a self-function in the same file that is simply out of scope. It keeps
// the plain sentence: no import would make the call resolve, so `ufcs-not-imported` would be a
// false promise. Inside its own frame the nested `self`-function is in lexical scope and the
// call dispatches; from `useIt` it is not, and the call is refused.
type Box = { v: i32 }

function outer(inner: Box): i32 {
  function area(self: Box) { self.v * self.v }
  inner.area()
}

function useIt(b: Box): i32 { b.area() }

print(outer({ v: 2 }))
print(useIt({ v: 5 }))
