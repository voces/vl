// @run
// @log 4
// @log 12
// @log 4
// An f32-returning OPERATOR closure field (B13). `a + b` on a struct carrying a
// `"+"` field is rewritten to the member call `a."+"(b)` before lowering, and that
// `Call` node is MINTED by the rewrite — no checker-recorded type — so the emitter's
// f32 classification falls to the syntactic cascade, which had no field-closure arm.
// Same one arm as the `"[]"` trap's f32 result (tests/cases/index/f32-closure-field-read.vl);
// this is the operator-field half of it, and it failed validation the same way.
function f32box(base: f32) { { "+": (o: f32) => base + o } }
function i32box(base: i32) { { "+": (o: i32) => base + o } }

const fb = f32box(1.5)
const s = fb + 2.5
print(s)

const ib = i32box(10)
const t = ib + 2
print(t)

// The f32 result is a genuine f32 slot, so it composes with f32 arithmetic.
const u = s * 1.0
print(u)
