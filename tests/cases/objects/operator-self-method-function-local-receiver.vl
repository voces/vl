// EVERY DIRECTIVE BELOW IS DECLARED RATHER THAN SILENCED. The `: V` on each local and the
// `: boolean` on each relational operator declaration are two of the grid's own AXES —
// D424's 80 cells cross the declaration's parameter annotation and the receiver's
// delivery, and deleting the annotations to quiet the lint would delete half of that.
// The `let` bindings are the MUTABLE-local delivery for the same reason.
// @hint redundant type annotation: `<` is inferred as `boolean`
// @hint redundant type annotation: `<=` is inferred as `boolean`
// @hint redundant type annotation: `>` is inferred as `boolean`
// @hint redundant type annotation: `>=` is inferred as `boolean`
// @hint redundant type annotation: `a` is inferred as `{x: i32, y: i32}`
// @hint redundant type annotation: `b` is inferred as `{x: i32, y: i32}`
// @hint redundant type annotation: `a` is inferred as `{x: i32, y: i32}`
// @hint redundant type annotation: `b` is inferred as `{x: i32, y: i32}`
// @hint redundant type annotation: `a` is inferred as `{x: i32, y: i32}`
// @hint redundant type annotation: `b` is inferred as `{x: i32, y: i32}`
// @hint redundant type annotation: `a` is inferred as `{x: i32, y: i32}`
// @hint redundant type annotation: `b` is inferred as `{x: i32, y: i32}`
// @hint redundant type annotation: `a` is inferred as `{x: i32, y: i32}`
// @hint redundant type annotation: `b` is inferred as `{x: i32, y: i32}`
// @hint redundant type annotation: `a` is inferred as `{x: i32, y: i32}`
// @hint redundant type annotation: `b` is inferred as `{x: i32, y: i32}`
// @hint redundant type annotation: `a` is inferred as `{x: i32, y: i32}`
// @hint redundant type annotation: `b` is inferred as `{x: i32, y: i32}`
// @hint redundant type annotation: `a` is inferred as `{x: i32, y: i32}`
// @hint redundant type annotation: `b` is inferred as `{x: i32, y: i32}`
// @hint redundant type annotation: `a` is inferred as `{x: i32, y: i32}`
// @hint redundant type annotation: `b` is inferred as `{x: i32, y: i32}`
// @hint redundant type annotation: `a` is inferred as `{x: i32, y: i32}`
// @hint redundant type annotation: `b` is inferred as `{x: i32, y: i32}`
// @hint redundant type annotation: `a` is inferred as `{x: i32, y: i32}`
// @hint redundant type annotation: `b` is inferred as `{x: i32, y: i32}`
// @info `a` is never reassigned; use `const` instead of `let`
// @info `b` is never reassigned; use `const` instead of `let`
// @info `a` is never reassigned; use `const` instead of `let`
// @info `b` is never reassigned; use `const` instead of `let`
// GRADUATED from `silent-class-inventory` D424 — the operator dispatch of B13/B14 at every
// RECEIVER DELIVERY, not just the one the tree's original fixture used.
//
// `operator-self-method.vl` next door is the tree's ONE operator-declaration fixture, and
// every binding in it is a module GLOBAL. That is the one delivery `structIndexOfExpr`'s
// `Ident` arm cannot answer for. Its other three rungs — a PARAM, a module GLOBAL and a
// CAPTURE — read tables that exist by then; the local-slot rung reads `localNames` /
// `localStructIdx`, which `buildLocals` fills per function during body lowering, downstream
// of the `dispatchRewrite` pass that asks. So `const a: V = { … }  a + b` inside a function body did not dispatch
// at all — `a < b` fell through to the numeric tail and emitted `i32.lt_s` over two struct
// refs (`vl check` rc 0, INVALID WASM) while `a + b` reached its field read as a non-struct
// (a loud `emitProgram: field access receiver is not a struct`). One position, and the
// fixture sat at the working one.
//
// SIXTEEN CELLS WERE SILENT AND TWENTY-FOUR LOUD, over a grid of operator x name spelling
// (quoted / symbol token) x parameter annotation x receiver type: the four RELATIONAL
// operators were the silent half, because a `boolean` result lets `i32.lt_s` over two refs
// through where an object result trips the field read. Every cell below is a function-body
// LOCAL receiver.

type V = { x: i32, y: i32 }

function +(self: V, b: V): V { x: self.x + b.x, y: self.y + b.y }
function <(self: V, b: V): boolean { return self.x < b.x }
function <=(self: V, b: V): boolean { return self.x <= b.x }
function >(self: V, b: V): boolean { return self.x > b.x }
function >=(self: V, b: V): boolean { return self.x >= b.x }
function *(self: V, b: V): V { x: self.x * b.x, y: self.y * b.y }
function -(self: V, b: V): V { x: self.x - b.x, y: self.y - b.y }

function mk(n: i32): V { x: n, y: n }

// ── the ANNOTATED local, which is the shape a reader writes first ────────────────────
function annotLocal() {
  const a: V = { x: 1, y: 2 }
  const b: V = { x: 3, y: 4 }
  const c = a + b
  return c.x
}
function annotLocalLt() {
  const a: V = { x: 1, y: 2 }
  const b: V = { x: 3, y: 4 }
  return a < b
}

// ── the INFERRED local, the spelling `operator-self-method.vl` uses at module scope ──
function bareLocal() {
  const a = { x: 1, y: 2 }
  const b = { x: 3, y: 4 }
  return (a + b).x
}
function bareLocalLt() {
  const a = { x: 1, y: 2 }
  const b = { x: 3, y: 4 }
  return a < b
}

// ── a MUTABLE local, and one bound from a CALL — the two other ways a local arrives. The
//    `let` is LOAD-BEARING and its four `use const instead` infos are declared above rather
//    than silenced: a mutable local reaches `structIndexOfExpr`'s `Ident` arm by the same
//    route a `const` one does, and the point of the cell is that neither is answered for. ──
function letLocal() {
  let a: V = { x: 1, y: 2 }
  let b: V = { x: 3, y: 4 }
  return (a + b).x
}
function letLocalLt() {
  let a: V = { x: 1, y: 2 }
  let b: V = { x: 3, y: 4 }
  return a < b
}
function callLocal() {
  const a = mk(1)
  const b = mk(3)
  return (a + b).x
}
function callLocalLt() {
  const a = mk(1)
  const b = mk(3)
  return a < b
}

// ── nested one level down, and inside a LAMBDA: the rewrite walks both ───────────────
function nestedLocal() {
  function inner() {
    const a: V = { x: 1, y: 2 }
    const b: V = { x: 3, y: 4 }
    return (a + b).x
  }
  return inner()
}
const lam = () => {
  const a: V = { x: 1, y: 2 }
  const b: V = { x: 3, y: 4 }
  return (a + b).x
}

// ── THE BODY MUST DISAGREE WITH THE FALLBACK or the cell proves nothing, which is D46's
//    own lesson: a declaration that returns what the built-in would have returned is
//    indistinguishable from one that was ignored. `*` here multiplies and `-` subtracts,
//    so the printed values could not come from any other lowering. ───────────────────
function mulLocal() {
  const a: V = { x: 3, y: 4 }
  const b: V = { x: 4, y: 5 }
  return (a * b).x
}
function subLocal() {
  const a: V = { x: 5, y: 9 }
  const b: V = { x: 3, y: 4 }
  return (a - b).x
}
function relLocal() {
  const a: V = { x: 1, y: 2 }
  const b: V = { x: 1, y: 2 }
  return a <= b
}
function relLocalGe() {
  const a: V = { x: 1, y: 2 }
  const b: V = { x: 1, y: 2 }
  return a >= b
}

// a chain, which is what makes the rewritten call re-enter its own rewrite
function chainLocal() {
  const a: V = { x: 1, y: 2 }
  const b: V = { x: 3, y: 4 }
  return ((a + b) + a).x
}

print(annotLocal())
print(annotLocalLt())
print(bareLocal())
print(bareLocalLt())
print(letLocal())
print(letLocalLt())
print(callLocal())
print(callLocalLt())
print(nestedLocal())
print(lam())
print(mulLocal())
print(subLocal())
print(chainLocal())
print(relLocal())
print(relLocalGe())
