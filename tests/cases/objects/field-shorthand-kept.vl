// @run
// @log 13
// @log 26
// A field written as shorthand stays shorthand under `vl fmt`, a written `seq: seq` stays
// written, and a literal that fits stays on one line (D3478, sunpa SP-004). The file is
// fmt-clean only while that holds: a formatter that expands `{ seq }` makes it drift.
type Intent = { seq: i32, moveX: i32, moveY: i32, attack: boolean }
type P = { id: i32 }
type Q = { p: P, n: i32 }

function intents(seq: i32, moveX: i32, moveY: i32) {
  const attack = true
  const pending: Intent[] = []
  const i: Intent = { seq, moveX, moveY, attack }
  pending.push({ seq, moveX, moveY, attack })
  pending.push({ seq: seq, moveX, moveY: 3, attack: false })
  i.seq + pending[0].moveX + pending[1].moveY + pending.length + moveY
}

function nested(id: i32, n: i32): Q { ({ p: { id }, n }) }
function wrapped(id: i32): P { ({ id }) }
function returned(id: i32): P { return { id } }
const lambda = (id: i32): P => ({ id })

print(intents(1, 2, 5))
const q = nested(1, 2)
print(q.p.id + q.n + wrapped(4).id + returned(8).id + lambda(11).id)
