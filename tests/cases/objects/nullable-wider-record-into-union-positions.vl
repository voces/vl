// @run
// @log 4
// @log -2
// @log 4
// @log -2
// @log 4
// @log 4
// @log -2
// @log 4
// A nullable record wider than a union arm, delivered into `Pet | null`: its null is the union's,
// else it boxes under the arm it is wider than. Passed, bound, returned, as a list element and at
// top level.
type A = { k: i32, legs: i32 }
type B = { s: string }
type Pet = A | B
function legs(p: Pet | null) {
  if p == null { return -2 }
  if p is A { return p.legs }
  return -1
}
function mn(c: boolean) {
  if c { return { k: 1, legs: 4, purr: true } }
  return null
}
function passed(c: boolean) { print(legs(mn(c))) }
function bound(c: boolean) {
  const p: Pet | null = mn(c)
  print(legs(p))
}
function returned(c: boolean): Pet | null { return mn(c) }
function listed(c: boolean) {
  const xs: (Pet | null)[] = [mn(c)]
  print(legs(xs[0]))
}
passed(true) // 4
passed(false) // -2
bound(true) // 4
bound(false) // -2
print(legs(returned(true))) // 4
listed(true) // 4
listed(false) // -2
print(legs(mn(true))) // 4
