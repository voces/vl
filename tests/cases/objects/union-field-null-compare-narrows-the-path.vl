// @run
// @log 0
// @log 7
// @log 0
// @log 7
// @log 0
// @log 2.5
// CONTRACT: `w.f != null` over a boxed-union FIELD narrows the member PATH, exactly as
// `w.f is T` does — one narrowing key (`memberPathKeyOf`'s path string), and `emitMem`
// unboxes the then-arm's reads under it. The two spellings ask one question of one rep.
//
// The failure this pins is `setNarrowFromCond`'s null-compare selectors accepting an IDENT
// receiver only: the guard's TEST was already right (the box tag compared against the null
// tag) while the then-arm's `w.f` read stayed the raw `(ref $uBox)` and went straight into
// its i32 consumer — `vl check` clean, INVALID WASM (`type mismatch: expected i32, found
// (ref $type)`). The `is null` spelling of the identical program was CORRECT one line away,
// because only the `is` arm had a member channel; that asymmetry is the whole tell, and the
// `is null` form below is kept as the control.
//
// The member set comes from the FIELD's own declared union name rather than
// `currentNarrowSetOf`, whose `unionNameOfIdent` fallback cannot resolve a path key.

type W = { f: i32 | null }
type F = { g: f64 | null }

const wn: W = { f: null }
if wn.f != null { print(wn.f) } else { print(0) }

const wv: W = { f: 7 }
if wv.f != null { print(wv.f) } else { print(0) }

// the `==` direction pins `null`, so the ELSE arm is the narrowed one
if wn.f == null { print(0) } else { print(wn.f) }
if wv.f == null { print(0) } else { print(wv.f) }

// CONTROL: the `is null` spelling of the same question over the same rep
if wn.f is null { print(0) } else { print(wn.f) }

// a wide-scalar member of the same box shape, whose unboxed read is an f64
const fv: F = { g: 2.5 }
if fv.g != null { print(fv.g) } else { print(0) }
