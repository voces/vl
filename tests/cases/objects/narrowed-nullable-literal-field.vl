// @run
// @log false
// @log b
// @log true
// D3121: an un-annotated object literal whose field is a value narrowed to `K | null` out of a
// box mints its record with the atom niche field, as the annotated record does.
type K = "a" | "b"
function t(e: K | null | i32) {
  if !(e is i32) {
    const o = { f: e }
    print(o.f == null)
    if o.f != null { print(o.f) }
  }
}
t("b")
t(null)
t(3)
