// @run
// @log 1
// @log z
// @log 5
// @log 2
// @log y
// @log 6
// A maker's generic result in a module record field is called at each type it is called at,
// through the record itself, a function returning it and a list holding it (D6473).
function k<T>(x: T): T { return x }
function mk() { return k }
const r = { f: mk(), g: 7 }
function get() { return r }
print(r.f(1))
print(r.f("z"))
print(get().f(5))
const r2 = { f: mk(), g: 8 }
const xs = [r2]
print(r2.f(2))
print(r2.f("y"))
print(xs[0].f(6))
