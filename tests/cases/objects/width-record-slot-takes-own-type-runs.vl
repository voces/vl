// @run
// @log tom
// @log 5
// @log 2
// @log 9
// @log 6
// @log 8
// A declared record binding or return whose only source is an existing record of a wider shape
// takes that record's own type, so writes through it reach the record (D4054). A fresh list or
// record literal around it is built at the record's own layout.
type Animal = { b: string }
type Cat = { b: string, a: i32 }
const c: Cat = { b: "tom", a: 1 }
const an: Animal = c
print(an.b)
type Pos = { x: f64, y: f64 }
type A = { k: i32, x: f64, y: f64 }
const a: A = { k: 7, x: 2.0, y: 3.0 }
const n: Pos = a
n.x = 5.0
print(a.x)
a.x = 2.0
function pick(): Pos { a }
print(pick().x)
let s: Pos = a
s = a
s.x = 9.0
print(a.x)
const xs: Pos[] = [a]
xs[0].x = 6.0
print(a.x)
const w: { f: Pos } = { f: a }
w.f.x = 8.0
print(a.x)
