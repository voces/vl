// @run
// @log 99
// @log 7
// @log 99
// @log 8
// @log 9
// @log 4
// @log 99
// @log 5
// A literal argument that sets a field its literal-typed record parameter does not declare is
// passed wider, as its `k: string` twin is, and the extra field's initializer runs, parenthesised
// or not (D4070).
type A = { k: "a", v: i32 }
type L = { k: "a" | "b", v: i32 }
function eff() {
  print(99)
  return 2
}
function g(a: A) { return a.v }
function h<T>(a: { k: "a", v: T }) { return a.v }
function l(a: L) { return a.v }
type S = { n: i32 }
function take(self: S, a: A) { return a.v + self.n }
print(g({ k: "a", v: 7, w: eff() }))
print(h({ k: "a", v: 8, w: eff() }))
print(l({ k: "b", v: 9, w: 2 }))
const s: S = { n: 1 }
print(s.take({ k: "a", v: 3, w: 2 }))
print(g(({ k: "a", v: 5, w: eff() })))
