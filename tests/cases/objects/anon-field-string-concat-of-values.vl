// @log gg
// An inferred record field whose value concatenates string VALUES (no literal in the chain) is
// the string slot, not the i32 an arithmetic `+` would code: the anonymous row read the `+` as
// arithmetic (D2305). A `new` type's operator building its record this way minted that row and
// broke a sibling constructor sharing the shape (D2307).

type Widget = new { s: string }
function mk(s: string): Widget {
  const r: Widget = { s: s }
  return r
}
function "+"(self: Widget, other: string): Widget {
  const r: Widget = { s: self.s + other + other }
  return r
}
function show(o: { k: string, n: i32 }) {
  print(o.k)
  print(o.n)
}
function main(a: string) {
  const b = "y"
  const o = { k: a + a }
  print(o.k)
  print(o.k.length)
  const o2 = { k: a + b, n: 1 }
  print(o2.k)
  print(o2.n)
  const o3 = { k: a + "!" }
  print(o3.k)
  const o4 = { k: "\{a}!" }
  print(o4.k)
  const xs = [{ k: a + b }, { k: b + a }]
  print(xs[1].k)
  show({ k: a + b + a, n: 2 })
  const o5 = { k: a + b + a + b, m: 2 + 3 }
  print(o5.k)
  print(o5.m)
  print((mk("p") + "q").s)
}
main("x")
function gv() { "g" }
const g = gv()
const go = { k: g + g }
print(go.k)
