// @check
// @error-at 6:58 `ld` here names a parameter at 7:25, not a function with a `self` parameter
// The positional control for D1604's UFCS cells. A fn-typed parameter declares no `self`
// parameter, so `b.ld(3)` is refused rather than dispatched to it; the direct call `ld(b, 3)` is
// the spelling that reaches the closure.
function ld(self: {v: i32}, k: i32) { print(self.v + k) }
function go(b: {v: i32}, ld: ({v: i32}, i32) => void) { b.ld(3) }
function goRenamed(b: {v: i32}, ld: ({v: i32}, i32) => void) { ld(b, 3) }
const bx = { v: 1 }
const cl: ({v: i32}, i32) => void = (bb, kk) => {
  print(bb.v * kk)
}
go(bx, cl)
goRenamed(bx, cl)
