// @run
// @log 3
// @log 3
// @warning Unused parameter `ld`
// The positional control for D1604's UFCS cells. A UFCS call whose callee name a closure-valued
// binding shadows still reaches that binding — `b.ld(3)` is `ld(b, 3)` and `ld` is the parameter
// — so both spellings print the closure's `v * k`, never the module function's `v + k`.
//
// The declared warning is the unused-parameter lint's own blind spot, not this row's mechanism:
// `go` calls `ld` through the UFCS spelling and the lint counts only the direct one. Residue on
// D1604; the value printed is what proves the dispatch happened.
function ld(self: {v: i32}, k: i32) { print(self.v + k) }
function go(b: {v: i32}, ld: ({v: i32}, i32) => void) { b.ld(3) }
function goRenamed(b: {v: i32}, ld: ({v: i32}, i32) => void) { ld(b, 3) }
const bx = { v: 1 }
const cl: ({v: i32}, i32) => void = (bb, kk) => { print(bb.v * kk) }
go(bx, cl)
goRenamed(bx, cl)
