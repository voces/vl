// @run
// @log c
// @log c
// A record joined with one whose fields are a layout prefix of its own, in a list literal or an
// `if`, runs: the narrower struct is the wider one's supertype (D15872).
type Animal = { a: string }
type Cat = { a: string, z: i32 }
const c: Cat = { a: "c", z: 1 }
const an: Animal = { a: "d" }
const arr = [c, an]
print(arr[0].a)
const w = if c.z > 0 { c } else { an }
print(w.a)
