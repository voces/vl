// @run
// @log 1
// @log 7
// @log 2
// D938's nested width pair, `{n: Wide}` delivered to `{n: Narrow}`. A struct's mutable field is
// invariant in WasmGC, so no narrower view of the record exists to declare. The parameter is
// instantiated at the record's own type instead (D3431, extending D4054), so a write through it
// reaches the original and the field `Narrow` does not name is kept.
type Wide = { a: i32, b: i32 }
type Narrow = { a: i32 }
type OW = { n: Wide }
type ON = { n: Narrow }

function take(o: ON): i32 { return (o.n).a }
function bump(o: ON) { o.n.a = 7 }

const w: OW = { n: { a: 1, b: 2 } }

print(take(w))
bump(w)
print(w.n.a)
print(w.n.b)
