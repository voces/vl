// @error argument 1: expected Pos, got {x: f64}
// A parameter that takes wider records is still held to its declared type: a record missing one
// of its fields is refused (D3992).
type Pos = { x: f64, y: f64 }
type A = { k: i32, x: f64, y: f64 }
function mv(p: Pos) { p.x += 1.0 }
const a: A = { k: 1, x: 2.0, y: 3.0 }
mv(a)
mv({ x: 1.0 })
