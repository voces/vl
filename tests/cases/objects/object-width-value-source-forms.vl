// @check
// @error-at 24:20 flowing into Animal drops the field
// @error-at 31:26 flowing into Animal drops the field
// @error-at 38:22 flowing into Animal drops the field
// @error-at 46:30 (reached through {pet: Cat} into Shelter)
// VERDICT PIN (must-error), NO `@log` form — same reason as
// `object-width-value-no-lowering.vl`: every shape here emits invalid wasm on master with
// `vl check` reporting the file clean, so this file FAILS on master by producing no
// diagnostic for these directives to match.
//
// The companion axis to that file. There the CONTAINER varied; here the SOURCE FORM does,
// because the source form is what the measurement actually separated: an object value
// whose shape is PINNED — by a parameter list, by a callee's return type, by a field read,
// or by an annotated binding — cannot reach a different shape under any spelling.
//
// The one form that is NOT pinned is an object LITERAL: it is built at the shape it flows
// into, so it is exempt, and its exemption is what the diagnostic offers as the fix. Its
// FIELD VALUES are not exempt, which is the last case below: the literal `{ pet: aCat }`
// is rebuilt at `{pet: Animal}`, but the value it puts in `pet` is a pinned `Cat`.
type Animal = { legs: i32 }
type Cat = { legs: i32, purr: boolean }

// PINNED BY A PARAMETER LIST.
function viaParam(c: Cat) {
  const a: Animal = c
  print(a.legs)
}

// PINNED BY A CALLEE'S RETURN TYPE.
function mkCat(): Cat { return { legs: 4, purr: true } }
function viaCallResult() {
  const a: Animal = mkCat()
  print(a.legs)
}

// PINNED BY A FIELD READ.
type Kennel = { pet: Cat }
function viaFieldRead(k: Kennel) {
  const a: Animal = k.pet
  print(a.legs)
}

// A LITERAL's FIELD VALUE is judged on its own, so a pinned value inside an exempt
// literal is still caught.
type Shelter = { pet: Animal }
function viaLiteralField(c: Cat) {
  const s: Shelter = { pet: c }
  print(s.pet.legs)
}

viaParam({ legs: 4, purr: true })
viaCallResult()
viaFieldRead({ pet: { legs: 4, purr: true } })
viaLiteralField({ legs: 4, purr: true })
