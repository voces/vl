// @run
// @log 4
// @log 4
// @log 4
// @log 4
// @log 4
// @log 4
// @hint redundant type annotation: `oneCat` is inferred as `{legs: i32, purr: boolean}` — remove it to lean on inference
// `oneCat: Cat` IS DECLARED, NOT DELETED — the annotation is what pins the source to the
// WIDER shape, which is the whole of what the bare-binding shape below tests.
// THE SOURCE-FORM AXIS DISSOLVED (D622, 2026-08-30). This file was a VERDICT PIN
// (must-error) and it is now a run pin, because the thing it pinned is gone.
//
// WHAT IT USED TO SAY, and it was right at the time: an object value whose shape is PINNED
// — by a parameter list, by a callee's return type, by a field read, or by an annotated
// binding — "cannot reach a different shape under any spelling", because the emitter interns
// a struct's wasm heap type from its own field list and there is no field-dropping
// conversion. Every shape below was `vl check` rc 1 with "not yet supported by codegen".
//
// WHAT CHANGED. `emitTypeSection` now declares `(type $Cat (sub $Animal …))` for a pair
// whose canonical field lists are in a prefix relation, so a pinned `Cat` reference fits an
// `Animal` slot AS IT STANDS — no conversion, no allocation, and reference identity intact.
// The source FORM never mattered to that; what mattered was whether a reference had to
// change type, and now it does not have to.
//
// THE LITERAL IS STILL NOT LIFTED, and the last shape is why. A literal is not a reference
// waiting to be passed — `emitObj` builds it at the DESTINATION's field list, so an excess
// field is never visited and its initializer never runs. `object-literal-excess-field-reject.vl`
// still pins that verdict; here the literal `{ pet: c }` is exempt as it always was, and the
// pinned `Cat` it puts in `pet` is now carried by the subtype edge rather than refused.
//
// WHAT DID NOT MOVE: a source under a MUTABLE CONTAINER whose own wasm type would have to
// relate — an array element, a map value, a function signature. Those keep the refusal, and
// `object-width-value-no-lowering.vl` is now exactly that residue.
type Animal = { legs: i32 }
type Cat = { legs: i32, purr: boolean }

// PINNED BY A PARAMETER LIST.
function viaParam(c: Cat) {
  const a: Animal = c
  print(a.legs)
}

// PINNED BY A CALLEE'S RETURN TYPE.
function mkCat(): Cat { return { legs: 4, purr: true } }
function viaCallResult() {
  const a: Animal = mkCat()
  print(a.legs)
}

// PINNED BY A FIELD READ.
type Kennel = { pet: Cat }
function viaFieldRead(k: Kennel) {
  const a: Animal = k.pet
  print(a.legs)
}

// A LITERAL's FIELD VALUE is judged on its own; the pinned `Cat` inside the exempt literal
// is now carried by the edge.
type Shelter = { pet: Animal }
function viaLiteralField(c: Cat) {
  const s: Shelter = { pet: c }
  print(s.pet.legs)
}

// NO CONTAINER AT ALL — moved here from `object-width-value-no-lowering.vl`, which keeps
// only the shapes that still have no lowering.
const oneCat: Cat = { legs: 4, purr: true }
const asAnimal: Animal = oneCat
print(asAnimal.legs)

// Behind `| null` — a nullable ref is the same reftype, so the peel changes nothing.
function countNul(a: Animal | null) { print((a ?? { legs: 0 }).legs) }

viaParam({ legs: 4, purr: true })
viaCallResult()
viaFieldRead({ pet: { legs: 4, purr: true } })
viaLiteralField({ legs: 4, purr: true })
countNul(oneCat)
