// @run
// A record field holding a list literal of a record that matches a declared type and a
// non-record is a union list, not the first element's struct list: at a global, a local and
// a return (D4688).
type H = { x: i32 }
const w = { f: [{ x: 1 }, "t"] }
print(w.f.length)
for e in w.f {
  if e is string { print(e) } else { print(e.x) }
}
function local() {
  const v = { f: [{ x: 2 }, 3] }
  print(v.f.length)
}
local()
function mk() { return { f: [{ x: 1 }, "u"] } }
const m = mk().f[1]
if m is string { print(m) }
// @log 2
// @log 1
// @log t
// @log 2
// @log u
