// @run
// The annotated twin of `anon-field-number-first-mixed-list.vl`: the declared field type
// names the union list, so the record's row does not depend on its literals (D12580).
const v: { xs: (i32 | string)[] } = { xs: [1, "z"] }
print(v.xs.length)
print(v.xs[1])
for x in v.xs {
  if x is string { print(x) } else { print(x + 1) }
}
function local() {
  const w: { ys: (i32 | { k: i32 })[], n: i32 } = { ys: [2, { k: 3 }], n: 4 }
  print(w.ys.length)
  print(w.n)
}
local()
function mk(): { xs: (f64 | string)[] } { return { xs: [1.5, "u"] } }
const m = mk().xs[1]
if m is string { print(m) }
// @log 2
