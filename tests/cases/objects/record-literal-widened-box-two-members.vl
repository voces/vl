// @run
// @log 3
// @log 7
// A box whose members widen to two different members of a wider record is read back at the
// member each came from: the read inverts the write's first-match mapping (`i32` to `i64`,
// `f32` to `f64`), so the `f32` is not truncated to an `i32` (D3006).
type D = { v: i64 | f64 }
const x: i32 | f32 = 1.5
const o = { v: x }
const c: {[string]: D} = Map()
c["k"] = o
const t = o.v
if t is f32 { print(t * 2) } else { print("lost f32") }
if t is i32 { print(t) }
const y: i32 | f32 = 7
const p = { v: y }
c["p"] = p
const u = p.v
if u is i32 { print(u) } else { print("lost i32") }
