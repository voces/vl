// @run
// @log true
// @log false
// @log false
// @log true
// @log true
// Structural `==` over a struct with an `i32[]` FIELD — the code-4 arm of the
// field-wise compare, which is length-then-element-wise over the two backings.
//
// COVERAGE PIN. Nothing in the corpus compared two structs carrying an `i32[]`
// field, and that arm is the one place in the emitter where a LIST backing and a
// STRING shared a scratch slot: it stashed both backings in the string-op frame's
// `strScrA`/`strScrB`, which are `(ref $sTypeIdx)` string refs. That was legal only
// while `string` and an `i32[]`'s backing were ONE heap type; the Stage-2a split
// gives the arm two `(ref null $aTypeIdx)` slots of its own. With no case here the
// rewrite was invisible to every gate — `vl check --codegen` never validated the arm,
// because no corpus module emitted it.
//
// The `string` field rides along deliberately: it forces the string-op frame to
// exist in the same function, so a compare that confused the two frames' slot types
// would fail validation rather than pass by absence.
type Row = { tag: string, xs: i32[] }

function same(p: Row, q: Row) { p == q }
function differs(p: Row, q: Row) { p != q }

const a = { tag: "hi", xs: [1, 2, 3] }
const b = { tag: "hi", xs: [1, 2, 3] }
const c = { tag: "hi", xs: [1, 2, 4] }
const d = { tag: "hi", xs: [1, 2] }
print(same(a, b))
print(same(a, c)) // same length, one element differs
print(same(a, d)) // a length mismatch short-circuits before the element loop
print(differs(a, c))
print(a == b) // the same compare inlined at module scope, off the start function
