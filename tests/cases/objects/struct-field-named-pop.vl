// @run
// @log 2
// @log 2
// @log 2
// @log 2
// @log 4
// A function-valued struct FIELD named after a list method. `emitCallNode`'s member dispatch
// read `callee.memProp == "pop"` with NO receiver guard, unlike its `map` / `filter` / `keys`
// / `values` / `get` neighbours which all test the receiver first — so `s.pop(1)` over a
// user's own `{ pop: (i32) => i32 }` was routed into the list lowering and came back
// `emitProgram: .pop takes no arguments`, about a field the checker had just typed at arity 1
// (D1087).
//
// `pop` is not a reserved word here, and that is what makes this the dispatch's bug rather
// than the name's: the identical program with the field named `push`, `map` or `filter`
// already ran. The four-family receiver test is lifted to `popRecvIsList` and asked at BOTH
// dispatch sites and at `emitPop`'s own floor, so the routing decision and the floor cannot
// drift apart.
type WithPop = { pop: (i32) => i32 }
type WithPush = { push: (i32) => i32 }
type WithMap = { map: (i32) => i32 }
type WithFilter = { filter: (i32) => i32 }

function callPop(s: WithPop) { return s.pop(1) }
function callPush(s: WithPush) { return s.push(1) }
function callMap(s: WithMap) { return s.map(1) }
function callFilter(s: WithFilter) { return s.filter(1) }

// A real list `.pop()` STATEMENT still lowers — the guard admits exactly the receivers it
// used to reach. The VALUE position is deliberately absent: `return xs.pop()` is check-clean
// invalid wasm on master too (byte-identical, 1886 bytes), a pre-existing clause-1 defect
// unrelated to this dispatch, and a fixture that carried it would pin someone else's bug.
function realPopStatement() {
  const xs = [1, 2, 4]
  xs.pop()
  return xs.length + 2
}

print(
  callPop(
    {
      pop: (n: i32) => {
        return n + 1
      },
    },
  ),
)
print(
  callPush(
    {
      push: (n: i32) => {
        return n + 1
      },
    },
  ),
)
print(
  callMap(
    {
      map: (n: i32) => {
        return n + 1
      },
    },
  ),
)
print(
  callFilter(
    {
      filter: (n: i32) => {
        return n + 1
      },
    },
  ),
)
print(realPopStatement())
