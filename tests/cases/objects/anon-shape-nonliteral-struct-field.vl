// @run
// @log 3
// @log 3
// @log 3
// @log 3
// @log 3
// AN ANONYMOUS OBJECT LITERAL WHOSE STRUCT-VALUED FIELD IS NOT ITSELF A LITERAL got no row.
// `collectAnonShapes` mints only when EVERY field has a code, and the name ladder codes a
// field by its RENDERED type — which for a struct value is the STRUCTURAL `{name: string, n:
// i32}` even where the value carries a declared alias. `fieldCodeOfSpelling` has no code for
// that spelling, so the field coded -1 and the OUTER literal was refused a row entirely:
// `ref valtype with no interned shape`. The row the field needed already existed; the reverse
// lookup from the value's TYPE to it was what was missing. D1543.
//
// FIVE SOURCES FOR THE FIELD VALUE, all of them ordinary: a binding, a declared-struct
// binding, a call, a hole-param call, and a member read. The nested-LITERAL spelling
// (`{ item: { … } }`) always worked, which is what made the gap invisible to every fixture.
type Rec = { name: string, n: i32 }
type Outer = { r: Rec }
function mkr(): Rec { return { name: "ada", n: 3 } }
function passh(x) { return x }
const r = { name: "ada", n: 3 }
const fromBinding = { item: r }
print(fromBinding.item.n)
const ann: Rec = { name: "ada", n: 3 }
const fromAnnotated = { item: ann }
print(fromAnnotated.item.n)
const fromCall = { item: mkr() }
print(fromCall.item.n)
const fromHole = { item: passh({ name: "ada", n: 3 }) }
print(fromHole.item.n)
const o: Outer = { r: { name: "ada", n: 3 } }
const fromMember = { item: o.r }
print(fromMember.item.n)
