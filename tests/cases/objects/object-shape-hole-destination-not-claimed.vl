// @run
// @log 1
// @log 1
// @log 3
// @hint redundant type annotation: `annotated` is inferred as `{x: i32, y: i32}` — remove it to lean on inference
// THE THIRD ACCEPTED NEIGHBOUR of the object-shape floor, and the one a leg-by-leg
// sabotage found the other pins could not reach: a destination shape that is still an
// inference HOLE.
//
// An un-annotated parameter used only as `o.x` demands `{x: _}` — one field, and that
// field's type unresolved. Handed a two-field argument, that pair looks exactly like the
// width subtyping the floor rejects: the destination's field-name set is smaller. It is
// not the same thing. The parameter is not a shape yet, so there is nothing for the
// emitter to fail to convert; the solve pins it from the argument and the program runs.
//
// The floor therefore declines any pair reaching a hole, and this file is what holds that
// clause honest — without it, every `function f(o) { print(o.x) }` called with a wider
// record is rejected. Both the un-annotated and the alias-annotated argument spellings
// are here, because they take different paths to the same demand, and an operator-named
// `self` method is here because that is the spelling the corpus already carries
// (`objects/operator-self-method.vl`) and the one that found this clause.
//
// This file passes on master too. It is a boundary pin, not a red-on-master fixture.
type Pt = { x: i32, y: i32 }

function readX(o) { print(o.x) }

function main() {
  const inferred = { x: 1, y: 2 }
  readX(inferred)
  const annotated: Pt = { x: 1, y: 2 }
  readX(annotated)
}
main()

function sumXY(self, b) { self.x + b.x + self.y + b.y }
const p1 = { x: 1, y: 0 }
const p2 = { x: 2, y: 0 }
print(sumXY(p1, p2))
