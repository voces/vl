// @check
// @error (reached through Cat[] into Animal[])
// @error (reached through {[string]: Cat} into {[string]: Animal})
// VERDICT PIN (must-error), and it has NO `@log` form on purpose: every shape below is a
// program the emitter cannot lower, so there is no output to pin — the verdict IS the
// contract.
//
// THE AXIS IS THE CONTAINER, and since D622 that is the WHOLE of it. This file used to
// carry four shapes on the claim that "the axis is the OBJECT PAIR, not the container: the
// bare binding below breaks exactly as the array does". Measured, that is no longer true —
// the bare binding and the `| null` peel both RUN, and they moved to
// `object-width-value-source-forms.vl`. What is left is the residue, and it is a real one.
//
// WHY THE CONTAINER IS DIFFERENT. `emitTypeSection` declares `(type $Cat (sub $Animal …))`,
// so a `(ref $Cat)` fits an `(ref $Animal)` slot with no conversion. That is a relation
// between the two STRUCT types. An array of one into an array of the other needs a relation
// between the two ARRAY types, and a map likewise between the two map structs — and their
// element/value fields are MUTABLE, which wasm makes INVARIANT under subtyping for the
// reason every language with mutable containers meets: were `Cat[]` a subtype of
// `Animal[]`, a plain `Animal` could be stored through the wider view and the original's
// elements would no longer all be `Cat`s. So this is not a lowering waiting to be written;
// it is the same soundness rule the subtype edge itself obeys, one container out.
//
// The way out is the one the diagnostic names: build the container at the destination's
// element type. `structural-width-subtyping.vl` is the accepted neighbour.
type Animal = { legs: i32 }
type Cat = { legs: i32, purr: boolean }

const oneCat: Cat = { legs: 4, purr: true }

// The filed shape — an array of the wider struct meeting an array of the narrower.
function countArr(xs: Animal[]) { print(xs[0].legs) }
const cats: Cat[] = [oneCat]
countArr(cats)

// A map VALUE.
function countMap(m: {[string]: Animal}) {
  const v = m["k"]
  if v != null { print(v.legs) }
}
const catsByName: {[string]: Cat} = Map()
catsByName["k"] = oneCat
countMap(catsByName)
