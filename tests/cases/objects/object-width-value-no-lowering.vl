// @check
// @error (reached through Cat[] into Animal[])
// @error flowing into Animal drops the field
// @error (reached through {[string]: Cat} into {[string]: Animal})
// @error (reached through Cat into Animal?)
// VERDICT PIN (must-error), and it has NO `@log` form on purpose: every shape below is a
// program the emitter cannot lower, so there is no output to pin — the verdict IS the
// contract. On master each of these is `vl check` rc 0 followed by `Invalid input
// WebAssembly code: type mismatch: expected (ref $type), found (ref $type)`, so this file
// FAILS on master, and it fails in an unusual way: master emits no diagnostic for the
// `@error` directives to match. "Master's failure mode is that it compiled something
// broken" is the red this file wants.
//
// `assignable`'s object arm is structural WIDTH subtyping — it walks the DESTINATION's
// field names only, so a source carrying EXTRA fields is accepted. The emitter interns a
// struct's wasm heap type from its own field list, so the two shapes are unrelated types
// and there is no field-dropping conversion. The floor is `objShapeAdapterless`, reported
// at `assignableExpr` — the one seam every binding / argument / return / field / element /
// store flows through.
//
// The axis is the OBJECT PAIR, not the container: the bare binding below breaks exactly
// as the array does, which is why it is pinned beside it rather than treated as a control.
type Animal = { legs: i32 }
type Cat = { legs: i32, purr: boolean }

const oneCat: Cat = { legs: 4, purr: true }

// The filed shape — an array of the wider struct meeting an array of the narrower.
function countArr(xs: Animal[]) { print(xs[0].legs) }
const cats: Cat[] = [oneCat]
countArr(cats)

// NO CONTAINER AT ALL. The same rejection, from the same floor.
const asAnimal: Animal = oneCat
print(asAnimal.legs)

// A map VALUE.
function countMap(m: {[string]: Animal}) {
  const v = m["k"]
  if v != null { print(v.legs) }
}
const catsByName: {[string]: Cat} = Map()
catsByName["k"] = oneCat
countMap(catsByName)

// Behind `| null`.
function countNul(a: Animal | null) { print((a ?? { legs: 0 }).legs) }
countNul(oneCat)
