// @run
// @log false
// @log 0
// @log true
// @log x
// @log 7
// An anonymous struct field holding an un-annotated `[]`-or-`null` join (D2228). With no use
// to pin the element it takes the nullable i32 list a plain local gets; a later push pins it.

const w = { f: if 1 == 1 { [] } else { null }, n: 7 }
print(w.f == null)
const g = w.f
if g != null { print(g.length) }

const z = { f: if 1 == 2 { [] } else { null } }
print(z.f == null)

const s = { f: if 1 == 1 { [] } else { null } }
const h = s.f
if h != null {
  h.push("x")
  print(h[0])
}
print(w.n)
