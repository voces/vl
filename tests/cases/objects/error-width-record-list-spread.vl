// @error an object value of shape Circle flowing into Shape (reached through Circle[] into Shape[]) drops the field
// @error an object value of shape Circle flowing into Shape (reached through Circle[] into Shape[]) drops the field
// D13960: a spread hands over an existing list's records one at a time, so each is judged as
// an existing record handed over directly is: into a rest parameter and into a list literal.
type Shape = { r: f64 }
type Circle = { r: f64, name: string }
function total(...xs: Shape[]): f64 { xs[0].r }
const cs: Circle[] = [{ r: 1.5, name: "a" }]
print(total(...cs))
const ys: Shape[] = [...cs]
print(ys.length)
