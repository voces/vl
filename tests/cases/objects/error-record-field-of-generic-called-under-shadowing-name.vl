// @emit-error a function-value call has no interned signature
// A name declared around the call that shadows the field's function is not that function, so
// the call through the field is not its direct call, and the refusal stands.
type G = { g: i32 }
type H = { f: (x: string) => string, g: i32 }
function k<T>(x: T): T { return x }
function show(o: G) {
  if o is H { print(o.f("in")) }
  print(o.g)
}
const r = { f: k, g: 7 }
function main() {
  function k(x: i32): i32 { return x + 100 }
  print(r.f(1))
  print(k(1))
}
main()
show(r)
