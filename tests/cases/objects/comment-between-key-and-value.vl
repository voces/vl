// @run
// @log 17
// A comment between an object key and its value stays there under `vl fmt` (D3492), as one
// between two fields does (D1777). The file is fmt-clean only while that holds: a formatter
// that moves the comment out of the literal makes it drift.
const seq = 5
const o = { seq: // the shorthand-shaped field
  seq }
const a = { x: // a plain value
  5 }
const d = {
  x: 1,
  y: // in a multi-line literal
    2,
  z: 3,
}
const h = { "q": // a quoted key
  seq }
print(o.seq + a.x + d.y + h.q)
