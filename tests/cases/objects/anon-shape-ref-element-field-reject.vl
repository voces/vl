// @emit-error ref valtype with no interned shape
// VERDICT PIN (must-emit-error) for the OTHER side of `anon-shape-nonliteral-field-reps.vl`:
// a field code the recorded-type rung does NOT admit still fails loudly, and it must,
// because the rung has nothing to fill the field's COMPANION column with.
//
// A shape interned by `collectAnonShapes` fills `sFieldElemName` from `anonFieldElemName`,
// which answers for a MAP field (its value name) and a NESTED-STRUCT field (the inner
// shape's table name) and "" for everything else. A ref-ELEMENT list field (code 5) is
// resolved by the emitter through exactly that name, so minting the code with an empty
// companion interns a field whose element heap type cannot be found: `emitProgram:
// ref-list field element type is not interned`, measured on 24 grid cells and on two
// corpus files (`closures/closure-struct-elem-list-map-fields.vl` and
// `closures/closure-value-union-array-struct-elem-list-field.vl`, which an ungated first
// cut turned from green to that reject).
//
// So `anonCodeIsSelfContained` admits only the codes whose wasm slot the code alone
// decides, and this file is the pin that widening it needs `anonFieldElemName` widened in
// the same change. The way out for a program that hits this is the same one it has always
// had: annotate the binding, which interns the shape from the ANNOTATION instead
// (`collectAnnShapes`) and carries the element name with it.
type S = { w: i32 }
function mkList(): S[] { return [{ w: 3 }] }
const c = { f: mkList() }
print(c.f[0].w)
