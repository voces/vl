// @run
// @log 3
// GRADUATED FROM A `@emit-error` PIN (D1515), on the terms the pin itself set.
//
// It pinned `emitProgram: ref valtype with no interned shape` and said the widening it
// guards "needs `anonFieldElemName` widened in the same change", because a code-5 field
// resolves its element heap type through `sFieldElemName` and minting the code with an
// empty companion interns a field the emitter cannot find a type for.
//
// That is the change D1515 made: `anonRefListElemRow` reads the row off the checker's
// recorded ELEMENT type through `repRowOfTyStruct`, so the admission and the companion
// arrive together. The way out this file used to name — annotate the binding — is now
// one spelling of two rather than the only one.
type S = { w: i32 }
function mkList(): S[] { return [{ w: 3 }] }
const c = { f: mkList() }
print(c.f[0].w)
