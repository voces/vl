// @run
// @log 1
// @log true
// @log 7
// A struct literal that OMITS a nullable NESTED-STRUCT field (`inner: Inner |
// null`, field code 15): the completion coercion emits that field's per-rep
// null, `ref.null $Inner`, which needs the field's TARGET struct row
// (`sFieldTgtStructIdx`).
//
// COVERAGE PIN (destringify D5). The omitted-field null for a code-15 field
// fired on ZERO corpus files under a per-site sabotage build — the corpus omits
// nullable SCALAR / list / union fields, never a declared nested struct.
type Inner = { x: i32 }
type Outer = { a: i32, inner: Inner | null }

const o: Outer = { a: 1 }
print(o.a)
print(o.inner == null)

const full: Outer = { a: 2, inner: { x: 7 } }
const fi = full.inner
if fi != null { print(fi.x) }
