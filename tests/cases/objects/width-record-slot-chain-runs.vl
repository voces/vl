// @run
// @log 4
// @log 5
// @log 6
// @log 2
// @log 7
// @info `ga` is never reassigned; use `const` instead of `let`
// A declared record slot handed the value of a slot that took an existing wider record's own type
// takes it too: a binding of a binding, a field or element written and read back, an annotated
// return bound at the record, and one binding assigned another (D4054).
type Pos = { x: f64, y: f64 }
type A = { k: i32, x: f64, y: f64 }
const a: A = { k: 7, x: 2.0, y: 3.0 }
const s1: Pos = a
const s2: Pos = s1
s2.x = 4.0
print(a.x)
type W = { f: Pos }
const w: W = { f: a }
w.f = a
const fv: Pos = w.f
fv.x = 5.0
print(a.x)
const xs: Pos[] = [a]
xs[0] = a
const ev: Pos = xs[0]
ev.x = 6.0
print(a.x)
a.x = 2.0
function d(): Pos { return a }
const rv: Pos = d()
print(rv.x)
let ga: Pos = a
let gb: Pos = a
gb = ga
gb.x = 7.0
print(a.x)
