// @run
// @log 1
// @warning Unused function `decoy` (prefix with `_` to suppress, remove it, or `export` it)
// D1609 — the ablation arm of `nested-width-pair-decoy-above.vl`.
//
// The same two bindings of `w`, with the decoy's one below the const. A name resolved through
// the scope chain answers the same at either position and one read off arena order does not, so
// a regression shows as a split between two files that differ only in line order.
type Wide = { a: i32, b: i32 }
type Narrow = { a: i32 }
type OW = { n: Wide }
type ON = { n: Narrow }

function take(o: ON): i32 { return (o.n).a }

const w: OW = { n: { a: 1, b: 2 } }

function decoy() {
  const w = { n: { a: 9, b: 9 } }
  return (w.n).a
}

print(take(w))
