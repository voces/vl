// @run
// @log UFCS-top
// @log UFCS-body
// @log UFCS-lambda
// D1070's counter-pin: field precedence must not swallow UFCS. When the receiver has
// NO field of that name, the free `self`-function is still what `a.toString()` means
// — at module top level and inside a function body alike. The fix narrows the UFCS
// rewrite only where the receiver's own checked type carries the field, so a receiver
// that does not is unchanged.
function toString(self: {foo: string}) { return "UFCS-" + self.foo }

const top = { foo: "top" }
print(top.toString())

function inBody() {
  const a = { foo: "body" }
  print(a.toString())
}
inBody()

const inLambda = () => {
  const a = { foo: "lambda" }
  print(a.toString())
}
inLambda()
