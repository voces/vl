// @run
// @log 4
// @log 5
// @log 6
// @log 7
// @hint redundant type annotation: `oneBeast` is inferred as `{legs: i32}` — remove it to lean on inference
// @hint redundant type annotation: `asAnimal` is inferred as `{legs: i32}` — remove it to lean on inference
// @hint redundant type annotation: `beasts` is inferred as `{legs: i32}[]` — remove it to lean on inference
// @hint redundant type annotation: `seven` is inferred as `{legs: i32}` — remove it to lean on inference
// THE ACCEPTED NEIGHBOUR of `object-width-value-no-lowering.vl`, one step away from every
// shape that file rejects: the two shapes are IDENTICAL, spelled through two different
// aliases. Nothing about the object-shape floor may touch this — a struct value whose
// field list matches the destination's has the destination's wasm type already, so there
// is no adapter to want.
//
// It is the pin a later variance implementation has to move DELIBERATELY: widening the
// rule has to keep every line here running and printing these values, while the reject
// pin beside it stops rejecting. Both directions, on purpose.
//
// This file passes on master too. It is a boundary pin, not a red-on-master fixture.
type Animal = { legs: i32 }
type Beast = { legs: i32 }

// bare
const oneBeast: Beast = { legs: 4 }
const asAnimal: Animal = oneBeast
print(asAnimal.legs)

// array element
function countArr(xs: Animal[]) { print(xs[0].legs) }
const beasts: Beast[] = [{ legs: 5 }]
countArr(beasts)

// map value
function countMap(m: {[string]: Animal}) {
  const v = m["k"]
  if v != null { print(v.legs) }
}
const byName: {[string]: Beast} = Map()
byName["k"] = { legs: 6 }
countMap(byName)

// behind `| null`
function countNul(a: Animal | null) { print((a ?? { legs: 0 }).legs) }
const seven: Beast = { legs: 7 }
countNul(seven)
