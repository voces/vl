// @log 11
// @log u101
// @log 12
// @log c102
// @log h30
// @log 20
// @log 103
// @log 40
// @log 104
// @log 50
// @log 60
// @log 11
// @log h107
// @log 108
// Q58 position sweep: a call of a function-valued record field named `map` or `filter` is that
// field's call, not the list method's, wherever its result is delivered.
import { toString } from "std:fmt"

type WithMap = { map: (i32) => i32 }
type WithFilter = { filter: (i32) => i32 }
type R = { v: i32 }
function sc(x: i32) { return x + 1 }
function un(x: i32 | string) {
  return if x is string { x } else { "u" + toString(x) }
}
function viaMap(s: WithMap) { return s.map(2) }
function viaFilter(s: WithFilter) { return s.filter(3) }
function nul(s: WithMap): i32 | null {
  return if s.map(0) > 0 { s.map(0) } else { null }
}

function all(s: WithMap, t: WithFilter) {
  print(sc(s.map(1)))
  print(un(t.filter(1)))
  print(sc(sc(s.map(1))))
  print("c" + toString(t.filter(2)))
  print("h\{s.map(3)}")
  print(viaMap(s))
  print(viaFilter(t))
  const c = s.map(4)
  print(c)
  const v = if c > 0 { t.filter(4) } else { 0 }
  print(v)
  print(nul(s) ?? s.map(5))
  const r: R = { v: s.map(6) }
  print(r.v)
}

const s: WithMap = { map: (x: i32) => x * 10 }
const t: WithFilter = { filter: (x: i32) => x + 100 }
all(s, t)
print(sc(s.map(1)))
print("h\{t.filter(7)}")
const r: R = { v: t.filter(8) }
print(r.v)
