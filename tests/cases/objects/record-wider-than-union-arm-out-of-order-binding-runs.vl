// @run
// @log 4
// A fresh record binding wider than a union arm, whose arm fields are not the first of its own,
// is built at that arm, since nothing else uses it at its own layout (D15093; was refused, D4054).
type A = { k: i32, legs: i32 }
type B = { s: string }
type Pet = A | B
const w = { a: true, k: 1, legs: 4 }
const p: Pet = w
if p is A { print(p.legs) }
