// @check
// @error an object value of shape {a: boolean, k: i32, legs: i32} flowing into A
// A record wider than a union arm whose arm fields are not the first of its own, in the field
// order a struct is laid out in, is not that arm's subtype, so it is still refused (D4054).
type A = { k: i32, legs: i32 }
type B = { s: string }
type Pet = A | B
const w = { a: true, k: 1, legs: 4 }
const p: Pet = w
if p is A { print(p.legs) }
