// @run
// A list literal of an inline record and `null` keeps its element nullable: read from an
// un-annotated record field, from a local list, through a binding and in a function, and with
// a declared record in the field (D4721).
const w = { f: [{ x: 1 }, null] }
print(w.f[1] == null)
print(w.f[0] != null)
const w0 = w.f[0]
if w0 != null { print(w0.x) }
const l = [{ x: 2 }, null]
print(l[1] == null)
const e = l[1]
print(e == null)
const n = [null, { x: 3 }]
for v in n {
  if v == null { print("null") } else { print(v.x) }
}
type P = { x: i32 }
const p = { f: [{ x: 4 }, null] }
const p0 = p.f[0]
if p0 != null { print(p0.x) }
print(p.f[1] == null)
function inner() {
  const q = [{ x: 5 }, null]
  const q1 = q[1]
  print(q1 == null)
}
inner()
// @log true
// @log true
// @log 1
// @log true
// @log true
// @log null
// @log 3
// @log 4
// @log true
// @log true
