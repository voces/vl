// @run
// @log f1
// @log f2
// @log f3
// @log 2
// @log f4
// @log 4
// @log f5
// @log 5
// @log f6
// @log f7
// @log 7
// @warning Unused parameter `a`
// @warning Unused parameter `b`
// A fresh object literal is built at its destination record's row, each field kept for its
// effect in source order, a field the destination drops included: a closure call's argument, a
// direct call's argument, and a list element.
type P = { x: i32 }
function f(n: i32) {
  print("f\{n}")
  return n
}
function s<A, B>(a: A, b: B) { print("S") }
function w<B>(a: P, b: B) { print(a.x) }
function take(p: P) { print(p.x) }
function main() {
  let k = s
  k = w
  k({ y: f(1), x: f(2), z: f(3) }, true)
  k({ x: f(4) }, "s")
  take({ x: f(5) })
  const ps: P[] = [{ x: f(6) }, { x: f(7) }]
  print(ps[1].x)
}
main()
