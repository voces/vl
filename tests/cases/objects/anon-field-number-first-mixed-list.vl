// @run
// A record field holding a list literal whose first element is a number and a later one is
// not is a union list, not the number list its literals would code: at a global, a local and
// a return (D12580).
const v = { xs: [1, "z"] }
print(v.xs.length)
print(v.xs[1])
for x in v.xs {
  if x is string { print(x) } else { print(x + 1) }
}
function local() {
  const w = { ys: [2, { k: 3 }], n: 4 }
  print(w.ys.length)
  print(w.n)
}
local()
function mk() { return { xs: [1.5, "u"] } }
const m = mk().xs[1]
if m is string { print(m) }
// @log 2
// @log z
// @log 2
// @log z
// @log 2
// @log 4
// @log u
