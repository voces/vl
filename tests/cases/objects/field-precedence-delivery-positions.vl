// @run
// @log field
// @log field
// @log field
// @log field
// @log field
// @log field
// @log field
// @log field!
// @log field
// @log field
// @log field
// @log field
// @warning Unused parameter `self` (prefix with `_` to suppress, or remove it)
// @hint redundant type annotation: `pReturnAnnot` is inferred as `string` — remove it to lean on inference
// Both are DECLARED rather than fixed. The `self` parameter of a UFCS `self`-function
// must be NAMED `self` to be dispatch-reachable at all, and this one's whole job is to
// stay unreached. And `pReturnAnnot`'s return annotation is the load-bearing half of a
// PAIR — an annotation pins a rep, so the un-annotated `pReturn` beside it is the cell
// that can see a defect inference causes; taking the hint would delete one of the two.
//
// D1070's POSITION MATRIX. The member call is delivered at every syntactic position,
// with the receiver bound inside a function BODY — the scope the defect needed. The
// `self`-function admits the receiver, so each cell prints which resolution ran.
//
// Measured on the pre-fix compiler: TEN of these twelve printed `UFCS`. Only the
// closure cell (the receiver is captured, so `capturedStructIndex` resolved it) and
// the parameter cell (`paramStructIndex`) were already right — which is exactly the
// shape of a rule enforced through a row lookup that answers in some scopes and not
// others, rather than through the rule itself.
function toString(self: {toString: () => string}) { return "UFCS" }
function shout(self: string) { return self + "!" }
function show(s: string) { print(s) }

// 1 — bound to a local
function pBinding() {
  const a = { toString: () => "field" }
  const s = a.toString()
  print(s)
}
pBinding()

// 2 — passed as an argument
function pArgument() {
  const a = { toString: () => "field" }
  show(a.toString())
}
pArgument()

// 3 — returned (un-annotated return: inference does the pinning)
function pReturn() {
  const a = { toString: () => "field" }
  return a.toString()
}
print(pReturn())

// 4 — returned from an ANNOTATED function
function pReturnAnnot(): string {
  const a = { toString: () => "field" }
  return a.toString()
}
print(pReturnAnnot())

// 5 — inside a closure
function pClosure() {
  const a = { toString: () => "field" }
  const g = () => a.toString()
  print(g())
}
pClosure()

// 6 — the body's TAIL expression (no `return` keyword)
function pTail() {
  const a = { toString: () => "field" }
  a.toString()
}
print(pTail())

// 7 — the receiver is a parameter
function pParamRecv(a: {toString: () => string}) { print(a.toString()) }
function pParamCall() {
  const a = { toString: () => "field" }
  pParamRecv(a)
}
pParamCall()

// 8 — a link in a UFCS CHAIN (the result is the next receiver)
function pChain() {
  const a = { toString: () => "field" }
  print(a.toString().shout())
}
pChain()

// 9 — stored into a struct field
function pStructField() {
  const a = { toString: () => "field" }
  const w = { s: a.toString() }
  print(w.s)
}
pStructField()

// 10 — a list element
function pListElem() {
  const a = { toString: () => "field" }
  const xs = [a.toString()]
  print(xs[0])
}
pListElem()

// 11 — assigned to a module global
let gCell = ""
function pGlobalAssign() {
  const a = { toString: () => "field" }
  gCell = a.toString()
}
pGlobalAssign()
print(gCell)

// 12 — in a condition
function pCondition() {
  const a = { toString: () => "field" }
  if a.toString() == "field" { print("field") } else { print("UFCS") }
}
pCondition()
