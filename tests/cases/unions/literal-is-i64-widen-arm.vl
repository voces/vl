// @run
// @log yes
// @log no
// @log other
// A `v is <IN-RANGE integer literal>` test over a mixed-rep value union whose only
// integer arm is `i64`. This is `emitUnionLitIs`'s FOURTH ladder arm — the one that
// asks the union itself: the lexeme `7` fits i32, so the ladder only settles on the
// i64 atom because the union has NO `i32` member and DOES have an `i64` one. Both
// halves of that test decide the box TAG the `is` compares and which value box the
// payload unboxes through.
//
// The hole this fills: that arm's two membership tests are reached ZERO times across
// all 1,345 files of the corpus (measured per-site — the `emitUnionLitIs` i32 test at
// every other reach answers TRUE and short-circuits the `&&`). Its sibling
// `literal-is-i64-arm-kind.vl` pins the OUT-OF-RANGE lexeme arm above it, which never
// consults the union at all. So master could answer either test wrongly here and stay
// byte-, message- and run-identical on every existing file — exactly the gap
// destringify D-VALKIND had to be able to separate before it could take this call.
const v: i64 | string = 7
if v is 7 { print("yes") } else { print("no") }

const w: i64 | string = 8
if w is 7 { print("yes") } else { print("no") }

const s: i64 | string = "s"
if s is 7 { print("num") } else { print("other") }
