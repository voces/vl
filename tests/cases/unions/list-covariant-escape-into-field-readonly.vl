// @run
// @log 1
// @log 1
// @hint redundant type annotation: `a` is inferred as `{r: i32}[]` — remove it to lean on inference
// @hint redundant type annotation: `bx` is inferred as `{xs: Shape[]}` — remove it to lean on inference
// THE UNWRITTEN TWIN of `error-covariant-escape-into-field-written.vl` (D852), and the
// control that says the container edge is only a SOURCE.
//
// The list still escapes into `bx.xs` and still comes back out under `c`. Nothing writes
// it, so the closure's write pass answers `0`, the claim pass then finds `b` unclaimed
// inside the object literal and answers `2` — unknown, exactly as on master — and the
// emitter keeps master's behaviour. No refusal, and the widening it already did still runs.
//
// That asymmetry is deliberate: putting a value into a field is still an unclaimed
// occurrence. The edge names handles well enough to catch a definite WRITE; it does not
// claim to have accounted for every escape, and the whitelist stays a whitelist.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box = { xs: Shape[] }

function f() {
  const a: Circle[] = [{ r: 7 }]
  const b: Shape[] = a
  const bx: Box = { xs: b }
  const c = bx.xs
  print(a.length)
  print(c.length)
}

f()
