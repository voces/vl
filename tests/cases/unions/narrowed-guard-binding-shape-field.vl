// @run
// @log 3
// @log 3
// @log 3
// The ANNOTATED twin of `narrowed-guard-binding-string-field.vl`. Same root cause (see that
// file's header); this pins the half of the family where the ANNOTATION is what BREAKS the
// cell rather than what saves it, because the two halves would otherwise be fixed one at a
// time.
//
// On a STRING field `const nm: string = t.aName` was always GREEN — the annotation pins the
// slot and the classifier never had to resolve the narrowed field type. On a NESTED-SHAPE
// field it was the opposite: the annotation selected the struct slot while the un-narrowed
// init classification disagreed, and the module failed to validate with a DIFFERENT message,
// `expected (ref $type), found (ref null $type)` — a NULLABILITY mismatch rather than the
// string cell's `expected i32, found (ref $type)`. Dropping the annotation turned the SAME
// cell into a LOUD reject instead ("emitProgram: field access receiver is not a struct").
// One root cause, three symptoms; a fix graded on the string message alone would have
// reported two thirds of a result, which is why this cell is pinned separately.
//
// NO `@hint` DIRECTIVE, and that is measured rather than an oversight: the native `vl check`
// reports "redundant type annotation" on the annotated bindings, but the corpus oracle
// adjudicates hints against the LINT pass (`lintSrc`), which reports none — and it is strict
// in both directions, so declaring the hint FAILS the case. The two diagnostic surfaces are
// not the same set.

function mkA(): {aName: {b: i32}} { return { aName: { b: 3 } } }

// THE DEFECT: divergent guard + an ANNOTATED binding of a nested-shape field.
function guardBindAnn(t: {aName: {b: i32}} | {zz: boolean}) {
  if !(t is {aName: {b: i32}}) { return 0 }
  const nm: {b: i32} = t.aName
  return nm.b
}

// CONTROL 1 — the positive narrow, same annotated binding. Lowered correctly before the fix.
function posBindAnn(t: {aName: {b: i32}} | {zz: boolean}) {
  if t is {aName: {b: i32}} {
    const nm: {b: i32} = t.aName
    return nm.b
  }
  return 0
}

// CONTROL 2 — the same guard, field used directly. Lowered correctly before the fix.
function guardDirect(t: {aName: {b: i32}} | {zz: boolean}) {
  if !(t is {aName: {b: i32}}) { return 0 }
  return t.aName.b
}

function go() {
  const v: {aName: {b: i32}} | {zz: boolean} = mkA()
  print(guardBindAnn(v))
  print(posBindAnn(v))
  print(guardDirect(v))
}
go()
