// @run
// @hint redundant type annotation: `y` is inferred as `{[i32]: i32} | null`
// @hint redundant type annotation: `z` is inferred as `{[i32]: i32}`
// @hint redundant type annotation: `w` is inferred as `i32`
// @hint redundant type annotation: `x` is inferred as `{[i32]: i32}`
// @hint redundant type annotation: `l` is inferred as `{[i32]: i32}`
// @hint redundant type annotation: `k` is inferred as `i32`
// @log true
// @log true
// @log 1
// @log 1
// @log 1
// @log 0
// @log true
// @log true
// @log 1
// @log 2
// @log false
// @log 7
// @log 3
// A union whose members are all one map type is that map at every position, nullable or not: its
// `| null` is the map's niche whatever the initializer, and `is` over it is the map's own test.
type A = {[i32]: i32}
type B = {[i32]: i32}
type U = A | B
const a: A = Map()
a.set(1, 2)
const y: U | null = if a.length == 1 { a } else { null }
print(y != null)
const y2: U | null = a
print(y2 != null)
const z: U = a
if z is A { print(z.length) }
print(z.length)
function w(v: U | null): i32 {
  if v == null { return 0 }
  v.length
}
print(w(z))
print(w(null))
function f(): U { a }
print(f() is A)
const x: U = y ?? a
print(x is B)
function g() {
  const l: U = a
  if l is A { print(l.length) }
}
g()
a.set(5, 6)
print(z.length)
const s: U | string = a
print(s is string)
function k(v: U | string): i32 {
  if v is string { return v.length }
  7
}
print(k(a))
print(k("abc"))
