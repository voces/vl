// @run
// @log 102
// @log 100
// @log 102
// @log 100
// @log 102
// @log 100
// @log 102
// @log 100
// `??` over an `if` arm's own nullable local, annotated and inferred, read as a map and
// bound, and a `??` chain whose first link is a loop value, bound and passed (D3391, D3394).
function mk(k: i32): Map<string, i32> {
  const m: Map<string, i32> = Map()
  m["a"] = k
  m
}
function h(n: i32) {
  print(
    (if n > -1 {
      let o: Map<string, i32> | null = null
      if n == 2 { o = mk(100) }
      o ?? mk(102)
    } else {
      mk(0)
    })["a"]
      ?? 0,
  )
}
h(0)
h(2)
function h2(n: i32) {
  const got = (if n > -1 {
    const o = if n == 2 { mk(100) } else { null }
    o ?? mk(102)
  } else {
    mk(0)
  })["a"]
    ?? 0
  print(got)
}
h2(0)
h2(2)
type R = { x: i32 }
function t(n: i32) {
  const w: R = { x: 102 }
  const o: R | null = null
  const v = (for x in [1, 2, 3] {
    if x == n { break { x: 100 } }
  })
    ?? o
    ?? w
  print(v.x)
}
t(0)
t(2)
function show(r: R) { print(r.x) }
function t2(n: i32) {
  const w = { x: 102 }
  const o = if n > 5 { w } else { null }
  show(
    (for x in [1, 2, 3] {
      if x == n { break { x: 100 } }
    })
      ?? o
      ?? w,
  )
}
t2(0)
t2(2)
