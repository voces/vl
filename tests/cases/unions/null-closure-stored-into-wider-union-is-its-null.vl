// @log false
// @log false
// @log false
// @log false
// @log false
// @log false
// @log false
type F = (i32) => i32
type U = F | null | i32
type O = { u: U }
function isNull(w: U) { print(w == null) }
function ret(f: F | null): U { return f }
let g: U = 0
function all(f: F | null) {
  isNull(f)
  const c: U = f
  isNull(c)
  let l: U = 0
  l = f
  isNull(l)
  isNull(ret(f))
  g = f
  isNull(g)
  const o: O = { u: f }
  isNull(o.u)
  const xs: U[] = [f]
  isNull(xs[0])
}
all(null)
all((x: i32) => x)
