// @run
// @log 25
// @log 43
// @log 1
// @log 1
// @log xy
// @log 2
// @log 1
// @log abc
// A union-of-lists walk whose elements convert, one body: inside `is K[]` each element becomes a
// `K` off an arm stored apart, and a literal-union arm beside a string arm widens to its string.
// Positions: argument, record field, the index, string concatenation.
type K = 1 | 2
type C = "x" | "y"
function kv(k: K): i32 { return k }
function len(s: string) { return s.length }
function mk(c: boolean): f64[] | K[] {
  const a: f64[] = [1, 2]
  const b: K[] = [2, 1]
  if c { return a }
  return b
}
function goK(q: f64[] | K[]) {
  if q is K[] {
    let s = 0
    for x, i in q {
      s = s * 10 + kv(x)
      const r = { k: x }
      s = s + kv(r.k) + i
    }
    print(s)
  }
}
function words(a) {
  let t = ""
  for w in a {
    t = t + w
    print(len(w))
  }
  print(t)
}
goK(mk(true))
goK(mk(false))
const one = 1
const cs: C[] = ["x", "y"]
const ss = ["ab", "c"]
words(if one > 0 { cs } else { ss })
words(if one > 5 { cs } else { ss })
