// @run
// @log 1
// @log 5
// @log 7
// @log 2
// @log 6
// @log 3
// @log 4
// @log 0
// @log 5
// @log true
// @log false
// Two arms whose fields hold one record shape under two names (`R`, `S`) are one layout, whether
// the record is the field, a field of it, its nullable inner, a list element or a map value
// (D15150), and `==` compares them by shape. A pair whose records differ (`T`) is still told
// apart.
type R = { r: i32 }
type S = { r: i32 }
type T = { r: string }
type A = { n: i32, g: R }
type B = { n: i32, g: S }
type U = A | B
const b: B = { n: 4, g: { r: 1 } }
print(b.g.r)
function direct(u: U) { u.g.r + u.n }
print(direct(b))
type NA = { n: i32, g: R | null }
type NB = { n: i32, g: S | null }
function nul(u: NA | NB) {
  const g = u.g
  if g != null { return g.r + u.n }
  0
}
print(nul({ n: 4, g: { r: 3 } }))
type LA = { n: i32, g: R[] }
type LB = { n: i32, g: S[] }
function lst(u: LA | LB) { u.g.length }
print(lst({ n: 4, g: [{ r: 1 }, { r: 2 }] }))
type QA = { n: i32, g: (R | null)[] }
type QN = { n: i32, g: (S | null)[] }
function qlst(u: QA | QN) { u.g.length + u.n }
const q: QN = { n: 4, g: [{ r: 1 }, null] }
print(qlst(q))
type MA = { n: i32, g: Map<string, R> }
type MB = { n: i32, g: Map<string, S> }
function mp(u: MA | MB) {
  const v = u.g.get("k")
  if v != null { return v.r }
  0
}
const m: MB = { n: 4, g: Map() }
m.g.set("k", { r: 3 })
print(mp(m))
type C = { n: string }
function three(u: A | B | C) {
  if u is C { return 9 }
  u.n
}
print(three(b))
type D = { n: i32, g: T }
function differ(u: A | D) {
  if u is A { return u.g.r }
  0
}
const d: D = { n: 4, g: { r: "x" } }
print(differ(d))
type P = { x: R }
type Q = { x: S }
type PA = { n: i32, g: P }
type QB = { n: i32, g: Q }
function nest(u: PA | QB) { u.g.x.r + u.n }
print(nest({ n: 4, g: { x: { r: 1 } } }))
function same(u: U, v: U) { u == v }
const a: A = { n: 4, g: { r: 1 } }
print(same(a, b))
print(same(a, { n: 5, g: { r: 1 } }))
