// @run
// @log 1.5
// @log 1.5
// @log 1.5
// @log 9000000000
// @log 9000000000
// @log 1.5
// @log 1.5
// @log a
// @log a
// @log 1.5
// @hint redundant type annotation: `fi64` is inferred as `i64` — remove it to lean on inference

// A negation names no rep, so a binding under one takes its initializer's, and the ladder
// deciding which rep is a family of classifiers that each open with the same annotation
// short-circuit. D1784.
//
// The values are why this fixture exists: its sibling `negation-binding-takes-the-init-rep.vl`
// binds `5`, which shares the i32 default and so cannot see a rep disagreement at all. Every
// value here has a slot that differs from i32 — f64, i64, f32 and an interned atom.
//
// The capture cells are load-bearing. The env field is a second cell for the same value, so
// a local that is an f64 beside a field that is an i32 is check-clean invalid wasm.
type N = !string
type M = !i32
type K = "a" | "b"

function f32v(): f32 { return 1.5 }
function fi64(n: i64): i64 { return n }
function kv(): K { return "a" }

// f64, at all three scopes — a global, a block, and a function body.
const gf: N = 1.5
print(gf)

if true {
  const bf: !string = 1.5
  print(bf)
}

function fnF64() {
  const lf: N = 1.5
  print(lf)
}
fnF64()

// i64, whose cell is the widest of the scalars.
const gi: N = fi64(9000000000)
print(gi)

function fnI64() {
  const li: !string = fi64(9000000000)
  print(li)
}
fnI64()

// f32, whose global READ had no inference fallback of its own.
const g32: N = f32v()
print(g32)

function fn32() {
  const l32: !string = f32v()
  print(l32)
}
fn32()

// An interned literal-union atom: the cell was right and the reader printed the raw id, so
// the member texts have to resolve through the same declaration the kind came from.
const ga: M = kv()
print(ga)

function fnAtom() {
  const la: !i32 = kv()
  print(la)
}
fnAtom()

// The capture, where the env field is a second cell for the same value.
function captured() {
  const c: N = 1.5
  const g = () => c
  print(g())
}
captured()
