// @run
// @log 7
// @log 1
// @log 1
// @log 1
// @hint redundant type annotation: `a` is inferred as `{r: i32}[]` — remove it to lean on inference
// @hint redundant type annotation: `nn` is inferred as `Shape[][]` — remove it to lean on inference
// A read-only covariant list inside a container handed to a function VALUE (D1683).
//
// The container alias edge asks the same callee resolver the argument edge does, so `p(nn)`
// lost the container's second name for one reason rather than two. With the lambda resolved,
// `g` is a name for the same container and `g[0]` is a handle on the list — the read here,
// and the write in the fixture next to it.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq

function f() {
  const a: Circle[] = [{ r: 7 }]
  const b: Shape[] = a
  const nn: Shape[][] = [b]
  const p = (g: Shape[][]) => {
    const e = g[0][0]
    if e is Circle { print(e.r) }
    print(g[0].length)
  }
  p(nn)
  print(a.length)
}

function other() {
  const w: Shape[] = []
  w.push({ s: 3 })
  print(w.length)
}

f()
other()
