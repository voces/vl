// @run
// An un-annotated map whose value is shaped like a union arm with a nullable field (D4636).
type U = { q: i32 | null } | { r: i32 }
type T = { kind: "a", q: i32 | null } | { kind: "b", r: i32 }
const m = Map()
m["k"] = { q: 4 }
m["j"] = { q: 5 }
print(m.length)
const z = m["k"]
if z != null { print(z.q + 1) }
let t = 0
for w in m.values() { t = t + w.q }
print(t)
const tm = Map()
tm["k"] = { kind: "a", q: 4 }
const tz = tm["k"]
if tz != null { print(tz.q) }
function f() {
  const fm = Map()
  fm.set("k", { q: 7 })
  const fz = fm.get("k")
  if fz != null { print(fz.q) }
}
f()
// @log 2
// @log 5
// @log 9
// @log 4
// @log 7
