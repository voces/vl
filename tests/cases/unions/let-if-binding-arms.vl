// @run
// @log 7
// @log true
// @log ab
// @log 9
// @log 3
// @log 5
// @log 7
// @log 5
// @log 0
// @hint redundant type annotation: `u` is inferred as `{meow: i32} | {woof: i32}`
// @hint redundant type annotation: `u` is inferred as `i64 | boolean`
// @hint redundant type annotation: `u` is inferred as `i32?`
// A union-box `let`/`const` initialized by an if-EXPRESSION, in every arm shape the form
// has.
//
// Each arm writes the box's tag and payload into the sink pair and the box is built ONCE
// after the `if`, instead of once per arm plus a pre-seeded null the merge discards.
// Behaviour is what this case pins; `tests/fixtures/opt-melt/union-sink-let-if.vl` pins
// the count.
//
// Two arm shapes DECLINE, and both are here because the transform must not fire for them:
// an arm whose value is itself an if-expression lowers as a value-typed `if` (its last
// instruction is a frame `end`, not a construction), and an arm passing an EXISTING union
// through builds no box at all — routing that one through the pair would unbox and rebuild
// it, trading no site for a new allocation on that path.

type Cat = { meow: i32 }
type Dog = { woof: i32 }

// two arms, scalar members.
function two(i: i32): i64 | boolean {
  const u: i64 | boolean = if i % 2 == 0 then 7 else true
  return u
}

// an `else if` chain — three arms through the chain recursion.
function chain(i: i32): i64 | boolean | string {
  const u: i64 | boolean | string = if i == 0 then 7 else if i == 1 then true else "ab"
  return u
}

// an arm whose value is itself an if-expression: the arm builds no box of its own.
function nested(i: i32): i64 | boolean {
  const u: i64 | boolean = if i < 2 { if i == 0 { 7 } else { 9 } } else { true }
  return u
}

// struct members, so each arm boxes a variant rather than a scalar.
function probe(i: i32): Cat | Dog {
  const u: Cat | Dog = if i % 2 == 0 then { meow: 3 } else { woof: 5 }
  return u
}

// both arms pass an EXISTING union through, so neither constructs.
function passthrough(i: i32): i64 | boolean {
  const a = two(i)
  const b = two(i + 1)
  const u: i64 | boolean = if i % 2 == 0 then a else b
  return u
}

// ONE constructing arm and one passthrough — the mixed cell, which declines as a whole.
function mixed(i: i32): i64 | boolean {
  const a = two(i)
  const u: i64 | boolean = if i % 2 == 0 then a else 5
  return u
}

// an ELSE-LESS chain: the false path is the rep's own null, written into the pair rather
// than built as a box the merge would discard.
function elseLess(i: i32): i32 | null {
  const u: i32 | null = if i > 0 then i
  if u is i32 { return u }
  return 0
}

function go() {
  const a = two(0)
  if a is i64 {
    print(a) // 7
  }

  const b = two(1)
  if b is boolean {
    print(b) // true
  }

  const c = chain(2)
  if c is string {
    print(c) // ab
  }

  const d = nested(1)
  if d is i64 {
    print(d) // 9
  }

  const e = probe(0)
  if e is Cat {
    print(e.meow) // 3
  }

  const f = probe(1)
  if f is Dog {
    print(f.woof) // 5
  }

  const g = passthrough(0)
  if g is i64 {
    print(g) // 7
  }

  const h = mixed(1)
  if h is i64 {
    print(h) // 5
  }

  const k = elseLess(0)
  if k is i32 {
    print(k) // 0
  }
}
go()
