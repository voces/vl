// @run
// @log true
// @log 1
// @log false
// @log true
// @log true
// @log true
// @log false
// @log true
// @log true
// The operand an `&&` evaluates only once a deep `is` passed, or an `||` once its negation
// failed, reads the receiver narrowed through its own converted copy (D16476).
type Json = null | boolean | f64 | string | Json[] | { [string]: Json }

function nonEmpty(r: Json) { r is string[] && r.length > 0 }
function short(r: Json) { !(r is string[]) || r.length < 3 }

const g: Json = ["a"]
print(g is string[] && g.length > 0)
if g is string[] && g.length > 0 { print(g.length) }
const n: Json = 5
print(n is string[] && n.length > 0)
print(nonEmpty(["x"]))
print(short(["x", "y"]))
print(short(4))
print(nonEmpty(3))
const c = nonEmpty(g)
print(c && g is string[] && g[0] == "a" && g.length == 1)
let w: Json = ["a"]
print(w is string[] && (w = null) == null)
