// @run
// @log 3
// @log 1
// @log 16
// @log make
// @log 25
// @log 4
// @log 20
// A union ARM whose OWN field is a struct, read through a struct that HOLDS the arm (D1579,
// reported by the glean session as VL-032). D1518 gave an arm a struct-table row; the
// CROSS-TABLE layout guard still declined any arm carrying a ref the field CODE does not name
// (15 a nested struct, 5 a ref list, 28 its niche), so `S`'s `a: A` field had no rep the
// moment `A` gained `inner: Inner`.
//
// The two sides record the same nested field under different SPELLINGS — the variant row banks
// the declared `Inner`, the arm's minted anon row the structural `{base:i32,length:i32}` — so
// the comparator has to descend to the referenced ROWS, which are layout twins.
//
// BOTH HOLDERS ARE PINNED. `S` is a plain struct, coded from `collectS` where the arm's row
// already exists; `S2` is ITSELF a union arm, coded one phase earlier from `collectU` where it
// does not. Those are two different rungs (`armFieldStructRow` and `armFieldDeferredRowOk`) and
// the fix is order-independent only if both answer.
type Inner = { base: i32, length: i32 }
type A = { n: i32, inner: Inner }
type E = { msg: string }
type S = { a: A, p: i32 }
type S2 = { a: A, q: i32 }
type E2 = { code: i32 }

function make(ok: boolean): A | E {
  if !ok { return { msg: "make" } }
  return { n: 3, inner: { base: 1, length: 16 } }
}

function mk2(ok: boolean): S2 | E2 {
  if !ok { return { code: 7 } }
  return { a: { n: 4, inner: { base: 2, length: 8 } }, q: 6 }
}

function use(s: S) { return s.a.n + s.a.inner.base + s.a.inner.length + s.p }

// BOTH BRANCHES, and both leaves of the nested field READ through the narrowed arm: the
// refusal fired on the declarations alone, so a fixture that only constructs would pass over a
// module whose `a` slot named the wrong heap type.
const m = make(true)
if m is A {
  print(m.n)
  print(m.inner.base)
  print(m.inner.length)
}
const me = make(false)
if me is E { print(me.msg) }

// The narrowed arm delivered INTO the holder's field, then read back through it.
if m is A { print(use({ a: m, p: 5 })) }

const s2 = mk2(true)
if s2 is S2 {
  print(s2.a.n)
  print(s2.a.n + s2.a.inner.base + s2.a.inner.length + s2.q)
}
