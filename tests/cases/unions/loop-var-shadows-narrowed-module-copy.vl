// @run
// @hint redundant type annotation: `xs` is inferred as `(i32 | string)[]`
// @warning `v` shadows the `v` declared at 30:12 in this function; rename one if they are different values
// @log s
// @log false
// @log true
// @log true
// @log false
// @log 1
// @log a
// @log s
// @log 7
// A top-level loop variable and a parameter spelled like a narrowed copy elsewhere in the
// module (`const v = w` under `if w is string`). Each read is its own binding's union box and
// inherits none of the copy's narrowing (D14603).
function pick(n: i32): i32 | string {
  if n > 0 { return n }
  "s"
}

const w = pick(-1)
if w is string {
  const v = w
  print(v)
}
const xs: (i32 | string)[] = [1, "a"]
for v in xs { print(v == "a") }
for v in xs { print(v == 1) }
for v in xs { print(v) }
function f(v: i32 | string) {
  const u = pick(-1)
  if u is string {
    if true {
      const v = u
      print(v)
    }
  }
  print(v)
}
f(7)
