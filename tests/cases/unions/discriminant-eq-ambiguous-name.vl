// @run
// @log 3
// @log 9
// Two structurally-alike unions in one module: `{kind: KC, r: f64}` and `{kind: "circle", r: f64}`
// are the same arena type once `KC` folds, so the surviving type carries two nominal names. A
// discriminant test narrows each receiver to the arm its own checker type names, and the read
// lowers from that arm, never from a name looked up by structure.
type C = { kind: "circle", r: f64 }
type R = { kind: "rect", w: f64 }
type S = C | R
function area(s: S) {
  if s.kind == "circle" { return s.r }
  return 0.0
}

type KC = "circle"
type KR = "rect"
type Ca = { kind: KC, r: f64 }
type Ra = { kind: KR, w: f64 }
function areaA(s: Ca | Ra) {
  if s.kind == "circle" { return s.r }
  return 0.0
}

print(area({ kind: "circle", r: 3.0 }))
print(areaA({ kind: "circle", r: 9.0 }))
