// @run
// `??` over a field whose record is an anonymous union arm, read through a local, a
// parameter, a narrowed union element and a map value (D4667).
type U = { q: i32 | null } | { r: i32 }
const v: { q: i32 | null } = { q: 4 }
print((v.q ?? 0) + 1)
const n: { q: i32 | null } = { q: null }
print(n.q ?? 7)
function f(p: { q: i32 | null }) { print(p.q ?? 0) }
f({ q: 8 })
f({ q: null })
const xs: U[] = [{ q: 2 }, { r: 1 }]
for x in xs {
  if x is { q: i32 | null } { print(x.q ?? 0) } else { print("r") }
}
const m: { [string]: { q: i32 | null } } = Map()
m["k"] = { q: 4 }
const mv = m["k"]
if mv != null { print((mv.q ?? 0) + 1) }
// @log 5
// @log 7
// @log 8
// @log 0
// @log 2
// @log r
// @log 5
