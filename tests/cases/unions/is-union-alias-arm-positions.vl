// Q58 position sweep: `x is U` for a union alias arm `U` of the receiver's box, the tags of `U`
// compared and or-ed: over a parameter, a local, a field and a module global, as an `if`
// condition, a return, a `let` initializer, a call argument, a `&&` operand, a negation, an `if`
// arm value, a record field, a list element, a `while` condition and a lambda body.
type U = i32 | string
type V = U | boolean | f64
type R = { v: V }
type S = { ok: boolean }
const g: V = "g"
function show(x: boolean) { print(x) }
function ret(v: V) { return v is U }
function main(p: V, q: V) {
  if p is U { print("p U") } else { print("p not") }
  print(ret(q))
  const l = q is U
  print(l)
  show(p is U)
  print(p is U && true)
  print(!(q is U))
  print(if q is U { 1 } else { 0 })
  const s: S = { ok: p is U }
  print(s.ok)
  const xs = [p is U, q is U]
  print(xs[0])
  print(xs[1])
  let w: V = 3
  let n = 0
  while w is U {
    n = n + 1
    w = true
  }
  print(n)
  const r: R = { v: q }
  print(r.v is U)
  const f = (v: V) => v is U
  print(f(p))
  print(f(q))
  print(g is U)
}
main(5, false)
main(2.5, "s")
