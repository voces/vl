// @run
// @log 7
// @log 7
// @log 7
// @hint Intentionally-unused parameter `_n` (leading `_` marks it unused)
// @hint redundant type annotation: `c0` is inferred as `{r: i32}`
// @hint redundant type annotation: `s0` is inferred as `{s: i32}`
// The annotations that draw those hints are the CELL: `c`/`lc`/`c0`/`s0` must be the ARM
// nominally, not the inferred structural `{r: i32}` — deleting them to silence the hint
// would delete the defect. Declared, per the fixture rule.
// D196 — a union ARM named inside a function-TYPE annotation, so the `$fnsig` key is
// built from the ANNOTATION rather than from a concrete lambda.
//
// `sigKeyOfTy` walks the arena spine and classifies each leaf with `paramTokOfTy` /
// `retTokOfTy`, falling back to RENDERING the leaf and asking the name classifier. Both
// arena readers declined every object type, so a `Circle` leaf was rendered — and
// `annParamKind`'s last rung is `structIndexOfTypeName`, a FIELD-SET match, which claims
// the arm's plain-struct layout twin. The synthesized `$fnsig` then declared `(ref $Dot)`
// where the lambda's own functype declares `(ref $Circle)`: `vl check` clean, invalid
// wasm at the value call.
//
// A union arm's identity is its DECLARATION, not its field set (`variantRowOfTy`: "NO
// STRUCTURAL RUNG. Two variants with the SAME FIELD SET are different variants"), so the
// question is nominal and only the arena can answer it.
type Shape = Circle | Sq
type Sq = { s: i32 }
type Dot = { r: i32 } // the arm's exact layout twin
type Circle = { r: i32 }

// the closure arrives as a PARAMETER, typed by annotation
function via(f: (Circle) => Circle, c: Circle) {
  const dd = f(c)
  print(dd.r)
}
const c0: Circle = { r: 7 }
via((x: Circle) => x, c0)

// the arm is only the RESULT of the annotated closure type
function viaRet(f: (i32) => Circle) {
  const dd = f(1)
  print(dd.r)
}
viaRet((_n: i32) => c0)

// the annotation names the arm with NO layout twin in scope for it — the loud
// `ref valtype with no interned shape` disguise of the same root
function viaSq(f: (Sq) => Sq, s: Sq) {
  const dd = f(s)
  print(dd.s)
}
const s0: Sq = { s: 7 }
viaSq((x: Sq) => x, s0)
