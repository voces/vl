// @emit-error on a literal field whose two arms rep differently
// THE BOUND OF D1050's UNIFICATION, pinned so a later widening has to move this file.
//
// D1050 lays a mixed-spelling discriminant out under the interned-atom rep, and it may only do
// that when BOTH arms are atom MATERIAL: a 2+-member set every one of whose members is a
// string. `{kind: K1}` beside `{kind: string}` is the pair D1023's "EITHER, not BOTH"
// amendment makes legal — a set beside its own base — and the base arm holds an ARBITRARY
// string, which has no interned id. Promoting it would have to invent a rep for a value that
// has none, so the pair keeps the loud refusal and the message keeps saying what is wrong.
//
// THE OTHER DIRECTION IS THE OPEN QUESTION, not a missing case here: unifying this pair on the
// STRING side would work for the base arm and would then need the mirror of every atom
// consumer — the construct intern, the `is` compare, the read classifier and the widen — for
// the arm whose type is an alias, and would give that alias a rep the rest of the module does
// not use for it. See DECISIONS §"a mixed-spelling variant field carries the ATOM".
type K1 = "circle" | "round"
type A = { kind: K1, r: f64 }
type B = { kind: string, r: f64 }
function f(n: i32): A | B {
  if n == 0 { return { kind: "circle", r: 1.0 } }
  const v: B = { kind: "zz", r: 2.0 }
  return v
}
const a = f(0)
if a is A { print(a.kind) } else { print("notA") }
