// @run
// @hint redundant type annotation: `x` is inferred as `N` — remove it to lean on inference
// @hint redundant type annotation: `y` is inferred as `N` — remove it to lean on inference
// Arithmetic over a numeric union declared by alias is checked as over the inline spelling,
// even when no inline numeric union appears in the program (D3653).
type N = i32 | f64
function h(c: boolean): N {
  if c { return 2 }
  2.5
}
const x: N = h(true)
print(x + 1)
const y: N = h(false)
print(y * 2)
// @log 3
// @log 5
