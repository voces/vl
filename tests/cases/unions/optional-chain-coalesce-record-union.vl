// @run
// @log b
// @log z
// @log a
// @log z
// @log b
// `?.` then `??` over a nullable union of records coalesces, over a binding, an annotated
// parameter and a struct field (D5243).
type N = { tag: "a", v: i32 } | { tag: "b", w: i32 }
type H = { h: N | null }
function f(q: N | null) { q?.tag ?? "z" }
const y: N = { tag: "b", w: 2 }
const q: N | null = y
print(q?.tag ?? "z")
const n: N | null = null
print(n?.tag ?? "z")
print(f({ tag: "a", v: 1 }))
print(f(null))
const hh: H = { h: y }
print(hh.h?.tag ?? "z")
