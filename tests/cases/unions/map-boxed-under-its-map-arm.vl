// @run
// @log 2
// @log 1
// @log 3
// A map delivered into a union box rides it under its map arm's tag: as an argument, a return
// and a binding, beside a scalar arm.
type V = {[string]: i32} | i32
function size(v: V) {
  if v is i32 { return v }
  return v.length
}
function mk(): V {
  const m: {[string]: i32} = Map()
  m["a"] = 1
  m["b"] = 2
  return m
}
function bound() {
  const m: {[string]: i32} = Map()
  m["x"] = 1
  const v: V = m
  return size(v)
}
print(size(mk()))
print(bound())
print(size(3))
