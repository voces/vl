// THE CONTROL for `unions/inline-union-struct-arm-call-positions.vl`: the identical program
// with the union NAMED. This spelling has always lowered, because the `UnionDecl` arm of the
// checker's pass 0b registers `IoError` in `cVariantMemberTyIxs` — the registry the inline
// annotation route never fed (#1803). Pinned in BOTH directions: the fix teaches the
// annotation route the same registration, so a regression that un-teaches it shows up in the
// inline file, and one that changes what a DECLARED union arm lowers to shows up here.
// @run
// @log 1
// @log 2
// @log 3
type IoError = { code: i32, msg: string }
type IoResult = string | IoError
function ioErr(c: i32): IoError { return { code: c, msg: "e" } }
function read(): IoResult { return ioErr(1) }
function bind() {
  const r: IoResult = ioErr(2)
  if r is IoError { return r.code }
  0
}
function take(u: IoResult) {
  if u is IoError { return u.code }
  0
}
const r0 = read()
if r0 is IoError { print(r0.code) } else { print(r0) }
print(bind())
print(take(ioErr(3)))
