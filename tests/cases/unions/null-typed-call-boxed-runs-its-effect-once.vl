// @run
// @log effect
// @log 5
// @log 1
// A `null`-typed call delivered into `i32 | null` is boxed under the null tag with the call as its
// payload, so its effect runs exactly once and the result reads as null.
function mk(): null {
  print("effect")
  return null
}
function f(b: boolean): i32 | null {
  if b { return 1 }
  return mk()
}
print(f(false) ?? 5)
print(f(true) ?? 5)
