// @run
// @log 7
// @log 7
// @log 7
// @log 7
// @hint redundant type annotation: `c` is inferred as `{r: i32}`
// THE TWIN CONTROL FOR `silent-class-inventory` D51 — **not** a graduation, and the
// distinction is measured rather than assumed: every row below already RAN on master
// `8bf0f20f`, and the emitted module is byte-IDENTICAL under both compilers (sha256 checked
// over the whole `tests/cases` corpus, 1,857 files emitting under both and 0 byte-different).
// It is here because D51's fix is gated on the struct table having NO row, and this is the
// declaration state where it HAS one — a file that only pinned the failing state could not
// tell an inert gate from an over-eager one.
//
// It is a separate file because the twin is the axis that decides which of two mechanisms a
// cell meets, and one file cannot carry both declaration states.
//
// `type Dot = { r: i32 }` is an EXACT LAYOUT TWIN of the arm `Circle`, and the twin has been
// the axis for D52, D63, D64 and D75: the struct table's non-kind-gated legs resolve an arm
// to the twin's row, which routes AROUND whatever loud floor the no-twin spelling meets. Here
// it does not, and the reason is that the new rung is asked where `structIndexOfLet` answered
// -1 rather than where it answered a row: with `Dot` declared the field set DOES have a struct
// row, so the rung declines and `mkAlias` below takes the ordinary struct path — the twin's
// row, which is the right answer for a shape the program also declares standalone. Both
// spellings print 7.
//
// THE NAME-DIFFERENT TWIN IS THE CONTROL. `type Dot2 = { q: i32 }` shares the arity and not
// the field set, so it resolves nothing, the rung fires, and the arm's own row is what the
// return carries. Two paths, one answer — which is what says the fix did not make the twin
// load-bearing for correctness.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Dot = { r: i32 }
type Dot2 = { q: i32 }

function mkAlias(n: i32) {
  const c = { r: n }
  const o = c
  return o
}

function mkLocal(n: i32) {
  const c = { r: n }
  return c
}

// The ANNOTATED sibling beside the same twin: D52's own filed witness.
function mkAnnotated(n: i32) {
  const c: Circle = { r: n }
  return c
}

// The name-different twin's shape, which has no standalone row to be resolved to.
function mkQ(n: i32) {
  const c = { q: n }
  const o = c
  return o
}

print(mkAlias(7).r)
print(mkLocal(7).r)
print(mkAnnotated(7).r)
print(mkQ(7).q)
