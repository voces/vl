// @run
// @log 8
// @log 8
// @log 8
// @log 6
// @log 8
// @log 5
// @warning `a[0] == null` is always false here (a[0] is i32)
// An `if` whose arm retires a path's narrowing in place still leaves the code below a live
// answer (D3316, D3317, D3318): a write after it narrows again, even with another narrowed path in
// scope; a loop's write to another literal cell does not reach the narrowed one; and the else arm
// of a null test restates a path it already holds. A loop's non-null write through another
// receiver keeps the narrowing below the loop (D3308).
type Box = { v: i32 | null }

function refill(a: Box, c: boolean) {
  a.v = 1
  if c { a.v = null }
  a.v = 7
  return a.v + 1
}
print(refill({ v: null }, true))

function refillBeside(a: Box, b: Box, c: boolean) {
  a.v = 1
  b.v = 2
  if c { a.v = null } else { b.v = null }
  a.v = 7
  return a.v + 1
}
const o: Box = { v: null }
print(refillBeside(o, o, true))
print(refillBeside(o, o, false))

function otherCell(a: (i32 | null)[]) {
  a[0] = 2
  let s = 0
  let i = 0
  while i < 3 {
    s = s + a[0]
    a[1] = null
    i = i + 1
  }
  return s
}
print(otherCell([null, 1]))

function held() {
  const a: (i32 | null)[] = [null]
  a[0] = 7
  if a[0] == null {
    a[0] = null
    a[0] = 7
  } else {
    if a[0] == null { return 5 }
  }
  return a[0] + 1
}
print(held())

// A non-null write through another receiver in a loop leaves the narrowing below the loop.
function loopAlias(a: Box) {
  const bs = [a]
  a.v = 1
  let i = 0
  while i < 2 {
    bs[0].v = 4
    i = i + 1
  }
  return a.v + 1
}
const lo: Box = { v: null }
print(loopAlias(lo))
