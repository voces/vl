// THE INLINE SPELLING OF A NESTED UNION — `x: Shape | ParseError` written as an annotation
// rather than as a declared `type Parsed = …`. It now lowers and runs, so the two spellings
// of one type finally agree; this file replaces `nested-union-inline-reject.vl`, which
// pinned the type error it used to produce.
//
// WHY IT USED TO FAIL, and why the fix is not here. `registerInlineUnion` splits the
// annotation's SPELLING into atoms, so it saw `Shape` as one atom that `isStructAtom`
// rejects — the nested arms (`Circle`, `Rect`) never reached the variant table, and a value
// built at one of them had no tag. The declared route never had the problem: `collectU`
// resolves member NAMES, so the nested arms are registered for free.
//
// The spelling that reaches `registerInlineUnion` is canon's output, and canon flattens a
// union-ALIAS member of an outer union. It was rendering that member STRUCTURALLY — the
// `TyObj` arm of `tyToEmitNameGo` has no nominal rung — so the flatten produced
// `{kind:string,r:f64}|{…}|{why:string}`: anonymous, tag SOFTENED, and unrelated to the
// declared variants. Rendering the DECLARED member spellings instead
// (`declaredStructUnionMembers`) hands the emitter `Circle|Rect|ParseError`, which is
// exactly what the declared alias produces — so the inline registration now flattens too,
// which is the condition the reject file named for its own removal.
//
// THE CHECKER GATE CAME OFF WITH IT. The ObjLit arm-pick's flatten was gated on the outer
// union being a declared alias, because offering arms for a spelling the emitter could not
// register would have turned a clean type error into a `cast failure` TRAP. That gate's own
// witness — `const r: Rect = {…}` then `const x: Shape | ParseError = r`, recorded as
// "fails to compile" — no longer reproduces, so both halves moved together as it required.
// @run
// @log 3
// @log bad
// @log 5
// @log unknown

type Circle     = { kind: "circle", r: f64 }
type Rect       = { kind: "rect", w: f64 }
type ParseError = { why: string }
type Shape      = Circle | Rect

// The LITERAL straight into the inline nested union, on both sides of the nesting.
const x: Shape | ParseError = { kind: "rect", w: 3.0 }
if x is Rect { print(x.w) } else { print("no") }            // 3
const e: Shape | ParseError = { why: "bad" }
if e is ParseError { print(e.why) } else { print("no") }    // bad

// RETURN position, spelled inline — where a fallible function actually writes it.
function parse(t: string, a: f64): Shape | ParseError {
  if t == "rect" { return { kind: "rect", w: a } }
  { why: "unknown" }
}
const p = parse("rect", 5.0)
if p is Rect { print(p.w) } else { print("no") }            // 5
const q = parse("hex", 1.0)
if q is ParseError { print(q.why) } else { print("no") }    // unknown
