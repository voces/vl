// @run
// @log A
// @log B
// @log nil
// @log A
// @log B
// @log nil
// @log 0
// @log A
// @log nil
// @log A
// @log nil
// @log A
// @log B
// @log nil
// @log A
// @log Z
// @hint redundant type annotation: `w` is inferred as `{f: string | null}`
// `p ?? q` where the DEFAULT `q` is itself `string | null`. The coalesce lowers as a
// value-typed `if` on `ref.is_null`, and its result type must be `(ref null $aTypeIdx)`
// exactly when the default can still be null — otherwise the then-arm's legitimately-null
// value meets a non-null block type. `vl check` was clean for every cell below.
//
// THREE COPIES OF THAT ONE QUESTION had drifted apart:
//   • the re-evaluating (ident / struct-field lhs) arm asked only `pendingRawNullRead`, so it
//     was right for `(p ?? q) != null` and wrong for every `string | null` BINDING /
//     argument / return / field consumer — the read gate is the DISJUNCTION with
//     `pendingNulString`, which is what `nulStrReadStaysRaw` now names;
//   • the stash-based CALL arm (`f() ?? g()`) hard-coded the non-null block;
//   • a chained `p ?? q ?? r` re-associates to `p ?? (q ?? r)` through a SYNTHESIZED node
//     with no banked checker type, so a banked-type test could not see the inner one at all.
// `coalesceNulStrStaysNullable` asks `exprNullableString` of the `??` node itself — the
// classifier whose own `??` arm is already "nullable lhs && nullable default", and structural
// so it covers the synthesized node too.
//
// TWO NULLS ANSWER `!= null` FALSE. That row (`print(0)`) is the wrong-ANSWER half: a
// coalesce of two nulls is null, so the guard must not fire.

function pick(k: i32): string | null {
  if k == 1 { return "A" }
  if k == 2 { return "B" }
  return null
}

// A BINDING consumer over two nullable IDENTS.
function bindIdents(p: string | null, q: string | null) {
  const nv = p ?? q
  if nv != null { print(nv) } else { print("nil") }
}

// A BINDING consumer over two nullable CALLS (the stash arm).
function bindCalls(i: i32, j: i32) {
  const nv = pick(i) ?? pick(j)
  if nv != null { print(nv) } else { print("nil") }
}

// The RAW-consumer spelling, with two nulls.
function testTwoNulls() {
  if (pick(0) ?? pick(0)) != null { print(1) } else { print(0) }
}

// ARGUMENT position.
function take(v: string | null) {
  if v != null { print(v) } else { print("nil") }
}

// RETURN position.
function both(i: i32, j: i32): string | null { return pick(i) ?? pick(j) }

// STRUCT-FIELD position.
function fieldPos(i: i32, j: i32) {
  const w: {f: string | null} = {f: pick(i) ?? pick(j)}
  const g = w.f
  if g != null { print(g) } else { print("nil") }
}

// A 3-CHAIN, all arms nullable — then one with a non-null tail (which must stay `string`).
function chain(i: i32, j: i32, k: i32) {
  const nv = pick(i) ?? pick(j) ?? pick(k)
  if nv != null { print(nv) } else { print("nil") }
}

function chainNonNull(i: i32, j: i32) {
  const nv = pick(i) ?? pick(j) ?? "Z"
  print(nv)
}

function go() {
  bindIdents(pick(1), pick(2)) // A
  bindIdents(pick(0), pick(2)) // B
  bindIdents(pick(0), pick(0)) // nil

  bindCalls(1, 2) // A
  bindCalls(0, 2) // B
  bindCalls(0, 0) // nil

  testTwoNulls() // 0

  take(pick(1) ?? pick(2)) // A
  take(pick(0) ?? pick(0)) // nil

  const r1 = both(1, 2)
  if r1 != null { print(r1) } else { print("nil") } // A
  const r2 = both(0, 0)
  if r2 != null { print(r2) } else { print("nil") } // nil

  fieldPos(1, 2) // A
  fieldPos(0, 2) // B
  fieldPos(0, 0) // nil

  chain(1, 2, 0)        // A
  chainNonNull(0, 0)    // Z
}
go()
