// @log 3
// @hint redundant type annotation: `r` is inferred as `T[] | i32[]`
// A generic's inferred `T[] | i32[]` read in the complement of `is T[]`: `.length`, an index, a
// binding into the written union, and one body instanced at three element types (D5111).
function w<T>(t: T, b: boolean) {
  if b { return [t] }
  [1, 2, 3]
}
function len<T>(t: T, b: boolean) {
  const u = w(t, b)
  if u is T[] { print(0) } else { print(u.length) }
}
function first<T>(t: T, b: boolean) {
  const u = w(t, b)
  if u is T[] { print(0) } else { print(u[0]) }
}
function bound<T>(t: T, b: boolean) {
  const u = w(t, b)
  if u is T[] {
    print(0)
  } else {
    const r: T[] | i32[] = u
    if r is i32[] { print(r.length) }
  }
}
function many<T>(t: T, b: boolean) {
  const u = w(t, b)
  if u is T[] { print(u.length) } else { print(u.length); print(u[2]) }
}
len("s", true)
len("s", false)
first("s", true)
first("s", false)
bound("s", true)
bound("s", false)
many("s", true)
many("s", false)
many(true, false)
many(7, false)
