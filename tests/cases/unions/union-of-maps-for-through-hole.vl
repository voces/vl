// @run
// @log k=x;m=x;
// @log j=b;
// @log 1
// @log 1
// @log 2
// @log 4
// A union of maps handed to an un-annotated parameter is walked per map arm at its pin: the keys,
// the key-value pair with the value boxed into the value union, break and continue, and a
// nested walk over two receivers.
function __pick(p, c: boolean) {
  const s: {[string]: string} = Map()
  s["k"] = p
  s["m"] = p
  const t: {[string]: boolean} = Map()
  t["j"] = true
  return if c { s } else { t }
}
function __show(r: string | boolean): string {
  if r is string { return r }
  return "b"
}
function pairs(v) {
  let out = ""
  for k, x in v { out = out + k + "=" + __show(x) + ";" }
  print(out)
}
pairs(__pick("x", true))
pairs(__pick("x", false))
function keys(v) {
  let n = 0
  for k in v {
    if k == "m" { continue }
    n = n + 1
    if n > 5 { break }
  }
  print(n)
}
keys(__pick("x", true))
keys(__pick("x", false))
function nest(v, w) {
  let n = 0
  for k in v {
    for j in w { n = n + 1 }
  }
  print(n)
}
nest(__pick("x", true), __pick("y", false))
nest(__pick("x", true), __pick("y", true))
