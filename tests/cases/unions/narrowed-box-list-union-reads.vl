// @run
// @log 2
// @log 2
// @log 1.5
// @log 3
// @log 3
// @log 2
// @log 2
// @log 2
// @log 1
// @log 2
// @log 2
// A box narrowed by `is string`'s else to a union of lists, read in place: its length, an element,
// a `for` over it, inside an expression `if` arm and from a global, a capture or a loop.
function mk(k: i32): i32[][] | f64[][] | string {
  if k == 0 { return "s" }
  if k == 1 {
    const a: i32[][] = [[1, 7], [2]]
    return a
  }
  const b: f64[][] = [[1.5]]
  return b
}
function reads(x: i32[][] | f64[][] | string) {
  if x is string {
    print(0)
  } else {
    print(x.length)
    print(x[0].length)
  }
}
reads(mk(1))
function elem(x: i32[][] | f64[][] | string) {
  if x is string { print(0) } else { print(x[0][0]) }
}
elem(mk(2))
function each(x: i32[][] | f64[][] | string) {
  let n = 0
  if x is string {
    print(0)
  } else {
    for e in x { n = n + e.length }
    print(n)
    const m = x.length
    print(m + 1)
  }
}
each(mk(1))
function inArm(x: i32[][] | f64[][] | string) {
  if x is string {
    print(0)
  } else {
    print(
      if x.length > 1 {
        const y = x
        y.length
      } else {
        0
      },
    )
  }
}
inArm(mk(1))
function captured(x: i32[][] | f64[][] | string) {
  const g = () => {
    if x is string { return 0 } else { return x.length }
  }
  print(g())
}
captured(mk(1))
function loop(x: i32[][] | f64[][] | string) {
  if x is string {
    print(0)
  } else {
    let i = 0
    while i < x.length {
      print(x[i].length)
      i = i + 1
    }
  }
}
loop(mk(1))
function recs(x: { a: i32 }[] | i32[][] | string) {
  if x is string { print(0) } else { print(x.length) }
}
const two: i32[][] = [[1], [2]]
recs(two)
const g = mk(1)
if g is string { print(0) } else { print(g.length) }
