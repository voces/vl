// @run
// @log 0
// @log 9
// @log 1
// @log 2
// @log 3
// @log 4
// @log 7
// @log 5
// @log 2
// @log 4
// @log 3
// A `??` (a valued join) whose value takes one-operand numeric steps on its way into a union box:
// legacy writes the box's tag first, then the join and its steps. Q58 sweep of the box: a binding,
// a return, an argument, a record field, a list element and a map store, over a widening, a cast,
// an op with an immediate, and a staged call operand. `pImmFirst` and `pTwoVars` are the shapes
// the lead may not be written below (an immediate before the value, a second var): they still run.
type J = string | f64 | boolean
type R = { j: J }
function show(j: J) { print(j) }
function parse(s: string): i32 | null { return if s == "" { null } else { 7 } }

function pLet(n: i32 | null) {
  const j: J = (n ?? 0) as f64
  print(j)
}
function pRet(n: i32 | null): J { return (n ?? 1) as f64 }
function pArg(n: i32 | null) { show((n ?? 2) as f64) }
function pField(n: i32 | null) {
  const r: R = { j: (n ?? 3) as f64 }
  print(r.j)
}
function pList(n: i32 | null) {
  const js: J[] = [(n ?? 4) as f64]
  print(js[0])
}
function pMap(s: string) {
  const m: { [string]: J } = Map()
  m["x"] = (parse(s) ?? 5) as f64
  print(m["x"] ?? "none")
}
function pDiv(n: i64 | null) {
  const j: J = ((n ?? 2048) / 1024) as f64
  print(j)
}
function pImmFirst(n: i64 | null) {
  const j: J = (4096 / (n ?? 1024)) as f64
  print(j)
}
function pTwoVars(n: i64 | null, m: i64) {
  const j: J = ((n ?? 0) + m) as f64
  print(j)
}

pLet(null)
pLet(9)
print(pRet(null))
pArg(null)
pField(null)
pList(null)
pMap("a")
pMap("")
pDiv(null)
pImmFirst(null)
pTwoVars(null, 3)
