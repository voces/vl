// @check
// @error-at 23:11 member access '.n' on non-object S | null
// @error-at 32:15 cannot assign S | null to 't' of type S
// @error-at 43:11 member access '.n' on non-object S | null — 's' is no longer narrowed to S: the call to 'clear' on line 43 may reassign it
// @error-at 51:11 member access '.n' on non-object S | null — 'g' is no longer narrowed to S: the call to 'clearG' on line 51 may reassign it
// @error-at 58:13 member access '.n' on non-object S | null — 'o.f' is no longer narrowed to S: the call to 'clearF' on line 58 may reassign it
// SP-010 (D3556): the record twin of `error-flow-join-unfilled-path.vl`. Each function leaves
// one path through the fill holding a possible `null` (a fill nested under an unrelated
// condition, a fill in a loop that may not run), or runs a call after the join that may write
// the place back to `null` (a closure, a function that writes the global, a function handed
// the receiver), so every read below the `if` is refused.
type S = { n: i32 }
type O = { f: S | null }
function mk(k: i32): S | null {
  if k < 0 { return null }
  return { n: k }
}

export function oneInner(k: i32, c: boolean): i32 {
  let s = mk(k)
  if s == null {
    if c { s = { n: 1 } }
  }
  return s.n
}

export function inLoop(k: i32) {
  let s = mk(k)
  if s == null {
    let i = 0
    while i < k { s = { n: i }; i = i + 1 }
  }
  const t: S = s
  return t.n
}

export function closureKill(k: i32): i32 {
  let s = mk(k)
  const clear = () => {
    s = null
  }
  if s == null { s = { n: 1 } }
  clear()
  return s.n
}

let g: S | null = null
function clearG() { g = null }
export function globalKill(): i32 {
  if g == null { g = { n: 1 } }
  clearG()
  return g.n
}

function clearF(o: O) { o.f = null }
export function fieldKill(o: O): i32 {
  if o.f == null { o.f = { n: 1 } }
  clearF(o)
  return o.f.n
}
