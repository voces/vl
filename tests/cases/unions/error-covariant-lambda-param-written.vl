// @error WRITTEN THROUGH
// @hint redundant type annotation: `a` is inferred as `{r: i32}[]` — remove it to lean on inference
// The soundness half of the function value (D1683).
//
// A lambda that WRITES its parameter is the read-only fixture one keyword over, and the same
// resolver that lets the read run is what carries the closure into this body: `ys` joins the
// alias set, `ys.push` is found, and the covariant assignment is refused where the rule is
// stated rather than declined at the delivery.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq

function f() {
  const a: Circle[] = [{ r: 7 }]
  const b: Shape[] = a
  const take = (ys: Shape[]) => {
    ys.push({ s: 3 })
  }
  take(b)
  print(a.length)
}

function other() {
  const w: Shape[] = []
  w.push({ s: 3 })
  print(w.length)
}

f()
other()
