// @run
// @log a 9.5
// @log 9.5
// @log b3
// A record literal delivered into a union's record arm whose fields hold one-function records of
// different function types is boxed as that arm, though the nested records share a storage row
// (D16398).
type R = {a: {f: () => string}, b: {f: () => f64}}
function rd(g: R | string): string {
  if g is string { return g }
  "\{g.a.f()} \{g.b.f()}"
}
const g: R | string = { a: { f: () => "a" }, b: { f: () => 9.5 } }
print(rd(g))
function local() {
  const h: R | i32 = { a: { f: () => "a" }, b: { f: () => 9.5 } }
  if h is i32 { print(0) } else { print(h.b.f()) }
}
local()
const p: {a: {f: () => string}, b: {f: (x: i32) => string}} | string = {
  a: {
    f: () => "a",
  },
  b: {
    f: (x: i32) => "b\{x}",
  },
}
if p is string { print(0) } else { print(p.b.f(3)) }
