// @run
// @log 2
// @log 11
// @log true
// @log 3
// @log 9
// @log true
// @log 2
// A union ARM whose own field is a list of a NULLABLE struct, read directly and through a
// struct that holds the arm. The arm's layout gate decides the field off its type; it once
// read the arm's render, whose parenthesised element `({..} | null)` it could not peel, and
// refused the program loudly although the lowering already handled it.
type Inner = { base: i32, length: i32 }
type A = { n: i32, inner: Inner, tag: (Inner | null)[] }
type E = { msg: string }
type S2 = { a: A, q: i32 }
type E2 = { code: i32 }

function make(ok: boolean): A | E {
  if !ok { return { msg: "make" } }
  return {
    n: 3,
    inner: { base: 1, length: 16 },
    tag: [{ base: 5, length: 6 }, null],
  }
}

function mk2(ok: boolean): S2 | E2 {
  if !ok { return { code: 7 } }
  return {
    a: {
      n: 4,
      inner: { base: 2, length: 8 },
      tag: [null, { base: 9, length: 1 }],
    },
    q: 6,
  }
}

const m = make(true)
if m is A {
  print(m.tag.length)
  const t0 = m.tag[0]
  if t0 != null { print(t0.base + t0.length) }
  print(m.tag[1] == null)
  m.tag.push({ base: 100, length: 1 })
  print(m.tag.length)
}
const s2 = mk2(true)
if s2 is S2 {
  const t1 = s2.a.tag[1]
  if t1 != null { print(t1.base) }
  print(s2.a.tag[0] == null)
  const h: S2 = { a: s2.a, q: 1 }
  print(h.a.tag.length)
}
