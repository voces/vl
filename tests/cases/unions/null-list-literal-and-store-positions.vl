// @run
// @info `z` is never reassigned; use `const` instead of `let`
// @log 3
// @log 3
// @log 2
// @log 1
// @log 1
// @log 3
// @log 3
// @log 3
// @log 2
// @log 1
// @log 2
// @log 3
// @log 2
// @log 2
// @log 1
// Q58 position sweep: a `null[]` list, whose i32 storage holds each `null` as the sentinel 2,
// built by a literal of `null`s as a `let` initializer, a call argument, a return, a record field
// and an `if` arm value, then a captured never-filled binding's `null` stored into one, its length
// read each time. An element that reads a `null`-typed name or calls a function returning only
// `null` stays legacy's (`others`).
type R = { xs: null[] }
let gEv = 0
function nul(): null {
  gEv = gEv + 1
  return null
}
function len(xs: null[]) { return xs.length }
function mk(): null[] { return [null, null] }
function main(k: i32) {
  const a: null[] = [null, null, null]
  print(a.length)
  print(len([null, null, null]))
  print(mk().length)
  const r: R = { xs: [null] }
  print(r.xs.length)
  const c: null[] = if k == 0 { [null] } else { [null, null] }
  print(c.length)
  let z = null
  const put = () => {
    a[1] = z
  }
  put()
  print(a.length)
}
function others(n: null) {
  print(len([nul(), null]))
  print(len([n, null]))
  print(gEv)
}
main(0)
main(1)
others(null)
