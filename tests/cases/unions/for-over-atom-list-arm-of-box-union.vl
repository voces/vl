// @run
// @log y
// @log x
// @log x
// @log 0
// @log y
// @log 1
// @log 2
// D4907: a `for` over the narrowed `K[]` arm of a box union, `K` a string literal union,
// walks the atoms as an `i32`-backed list.
type K = "x" | "y"
const top: f64 | K[] = ["x", "y"]
function main() {
  const g: f64 | K[] = ["y", "x"]
  if g is K[] {
    for k in g { print(k) }
  }
  if top is K[] {
    for k, i in top {
      print(k)
      print(i)
    }
  }
  const d: f64[] | K[] = [2.0]
  if d is f64[] {
    for v in d { print(v) }
  }
}
main()
