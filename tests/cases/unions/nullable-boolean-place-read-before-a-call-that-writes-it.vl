// @log false
// @log false
// @log false
// @log false
// @log false
type K = "a" | "b"
type U = i32 | boolean | null
type O = { k: boolean | null }
let g: boolean | null = null
const o: O = { k: null }
const xs: (boolean | null)[] = [null]
function setG(k: boolean | null, r: U): U {
  g = k
  return r
}
function setO(k: boolean | null, r: U): U {
  o.k = k
  return r
}
function setX(k: boolean | null, r: U): U {
  xs[0] = k
  return r
}
function glob() {
  g = null
  print(g == setG(true, true))
  g = false
  print(g != setG(null, false))
  g = true
  print(g == setG(null, null))
  g = null
  print(setG(true, true) == g)
}
function field() {
  o.k = null
  print(o.k == setO(true, true))
  o.k = false
  print(o.k != setO(null, false))
}
function elem() {
  xs[0] = null
  print(xs[0] == setX(true, true))
  xs[0] = false
  print(xs[0] != setX(null, false))
}
function capt() {
  let lk: boolean | null = null
  const f = (k: boolean | null, r: U): U => {
    lk = k
    return r
  }
  print(lk == f(true, true))
  lk = false
  print(lk != f(null, false))
}
glob()
field()
elem()
capt()
