// @run
// @log I32
// @log 7
// @log I32LIST
// @log 9
// @log STR
// @log hey
// @log STRLIST
// @log ok
// @log F64
// @log 2.5
// @log F64LIST
// @log 6.5
// @log I64
// @log 9000000000
// @log I64LIST
// @log 8000000001
// A value union carrying BOTH a primitive atom AND the LIST over that same primitive
// (`i32 | i32[]`, `string | string[]`, `f64 | f64[]`, `i64 | i64[]`). The two arms take
// DISTINCT box tags (`valueAtomKind` 0 vs 7, 2 vs 9, 4 vs 8, 3 vs 10) and distinct
// payload reps (a scalar value box vs a list wrapper riding the box anyref), so every
// `is` and every narrowed read here depends on the union-membership test separating the
// scalar from its own list.
//
// That test is `unionHasAtomTy` (`unMemHasAtom`), and until destringify D-ATOMPAIR it
// received the two as ONE JOINED SPELLING and took them apart again — an
// `atom[n-2] == '['` suffix test plus an `atom.slice(0, n-2)` — i.e. a type-string parse
// living outside the parser. The atom now arrives as a (primitive, is-list) PAIR from
// each caller's own keyword ladder, so nothing joins and nothing peels.
//
// This is the shape that makes the pairing OBSERVABLE: with a union whose scalar and
// list atoms are not both present, dropping the array bit merely misses; with both
// present it selects the OTHER ARM — a wrong tag, a wrong `ref.cast`, and a silently
// wrong branch. No corpus case carried a scalar beside its own list before this one.
function fI32(p: i32 | i32[]) {
  const t = p
  if t is i32 {
    print("I32")
    print(t)
  } else {
    print("I32LIST")
    print(t[0])
  }
}
fI32(7)
fI32([9])

function fStr(p: string | string[]) {
  const t = p
  if t is string {
    print("STR")
    print(t)
  } else {
    print("STRLIST")
    print(t[0])
  }
}
fStr("hey")
fStr(["ok"])

function fF64(p: f64 | f64[]) {
  const t = p
  if t is f64 {
    print("F64")
    print(t)
  } else {
    print("F64LIST")
    print(t[0])
  }
}
fF64(2.5)
fF64([6.5])

function fI64(p: i64 | i64[]) {
  const t = p
  if t is i64 {
    print("I64")
    print(t)
  } else {
    print("I64LIST")
    print(t[0])
  }
}
fI64(9000000000)
fI64([8000000001])
