function mkSN(k: string | null): HSN { return { k: k } }
function callBaseSN(u: USN, k: string | null) { return u == mkSN(k).k }
function lineSNFeq(u: USN) {
  const ks: (string | null)[] = [null, "s", "t"]
  let s = "SNFeq"
  for k in ks {
    const h: HSN = { k: k }
    gSN = k
    const all = argSNFeq(u, h)
    const agree = all == uargSNFeq(u, h)
      && all == nestSNFeq(u, h)
      && all == holeSNFeq(u, h)
      && all == retSNFeq(u, h)
      && all == letSNFeq(u, h)
      && all == armSNFeq(u, h, true)
      && all == coalSNFeq(u, h, null)
      && all == fieldSNFeq(u, h)
    s = s + " " + (if agree { c3(all) } else { "?" })
  }
  print(s)
}
