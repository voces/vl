// @hint Intentionally-unused parameter
// A `string | null` or `boolean | null` operand read from a record field or a global, compared
// with a union box on the operand's null leg, at each value position and as `==` and `!=`: each
// line's cells are every box value against every operand value, all positions agreeing.
type USN = i32 | string | null
type HSN = { k: string | null }
let gSN: string | null = null
type UBN = i32 | boolean | null
type HBN = { k: boolean | null }
let gBN: boolean | null = null
type USX = i32 | string
type HSX = { k: string | null }
let gSX: string | null = null
type R = { ok: boolean }
function takeB(b: boolean) { return b }
function takeU(x: boolean | i32) { return x is boolean && x }
function id(b: boolean) { return b }
function c3(b: boolean) { return if b { "T" } else { "f" } }
function argSNFeq(u: USN, h: HSN) { return takeB(u == h.k) }
function uargSNFeq(u: USN, h: HSN) { return takeU(u == h.k) }
function nestSNFeq(u: USN, h: HSN) { return takeB(id(u == h.k)) }
function holeSNFeq(u: USN, h: HSN) { return "\{u == h.k}" == "true" }
function retSNFeq(u: USN, h: HSN): boolean { return u == h.k }
function letSNFeq(u: USN, h: HSN) {
  const b = u == h.k
  return b
}
function armSNFeq(u: USN, h: HSN, c: boolean) {
  return if c { u == h.k } else { false }
}
function coalSNFeq(u: USN, h: HSN, nb: boolean | null) {
  return nb ?? (u == h.k)
}
function fieldSNFeq(u: USN, h: HSN) {
  const r: R = { ok: u == h.k }
  return r.ok
}
