// @log false
// @log true
// @log false
// `x is S[]` for a string literal set `S` over a box holding a `(string | null)[]` arm: the arm
// shares the string list's tag with a `string[]` one, and fits by its strings, a null no member
// (D17053).
type S = "a" | "b"
function mk(n: i32): string[] | (string | null)[] {
  const a: string[] = ["a"]
  const b: (string | null)[] = [null]
  const c: (string | null)[] = ["a", "b"]
  const d: (string | null)[] = ["a", null]
  const e: string[] = ["q"]
  if n == 0 { return a }
  if n == 1 { return b }
  if n == 2 { return c }
  if n == 3 { return d }
  return e
}
let i = 0
while i < 5 {
  print(mk(i) is S[])
  i = i + 1
}
function mk2(c: boolean): i32[] | (string | null)[] {
  const b: (string | null)[] = ["a"]
  if c { return b }
  return [1]
}
print(mk2(true) is S[])
print(mk2(false) is S[])
