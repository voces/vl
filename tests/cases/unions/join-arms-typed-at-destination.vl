// @run
// @log 1
// @log -2
// @log 3
// @log -4
// @log 5
// @log -6
// @log 7
// @log -8
// @log 9
// @log -10
// @log 11
// @log -12
// Each value of a join — an `if`'s arms, a `match`'s arms, a labelled block's exits — is
// checked against the declared destination, as a bare literal there is, so a record literal
// arm builds its own variant: at a binding, a return, an argument and a record field. A `Sq`
// prints its width negated, so each line shows which variant `is Ci` saw (D2788).
type Ci = { kind: "c", r: i32 }
type Sq = { kind: "s", w: i32 }
type Sh = Ci | Sq
function show(s: Sh) {
  if s is Ci { print(s.r) } else { print(0 - s.w) }
}
function bind(c: boolean) {
  const s: Sh = if c { { kind: "c", r: 1 } } else { { kind: "s", w: 2 } }
  show(s)
}
function ret(c: boolean): Sh {
  return if c { { kind: "c", r: 3 } } else { { kind: "s", w: 4 } }
}
function arg(n: i32) {
  show(
    match n {
      0 => { kind: "c", r: 5 }
      _ => { kind: "s", w: 6 }
    },
  )
}
type Box = { s: Sh }
function field(c: boolean): Box {
  { s: if c { { kind: "c", r: 7 } } else { { kind: "s", w: 8 } } }
}
function label(c: boolean) {
  const s: Sh = @B {
    if c { break @B { kind: "c", r: 9 } }
    { kind: "s", w: 10 }
  }
  show(s)
}
function nested(n: i32): Sh {
  const s: Sh = if n == 0 { { kind: "c", r: 11 } } else if n == 1 { { kind: "s", w: 12 } } else { { kind: "c", r: 0 } }
  s
}
bind(true)
bind(false)
show(ret(true))
show(ret(false))
arg(0)
arg(1)
show(field(true).s)
show(field(false).s)
label(true)
label(false)
show(nested(0))
show(nested(1))
