// @run
// @log str
// @log num
// @log s
// @log 2
// @log s!
// @log 42
// @log str
// @log 3
// @log narrow
// @log wide
// @log false
// @log true
// @log str
// @log num
// @log null
// `is string` and `is i32` over a literal union of a string and integers test the members whose
// base is the named type and narrow to them; the else holds the rest, unboxed at their own base
// (D3522). `is i64` and `is i32` split a two-width set by width. A literal test's else over
// three members narrows the same way.
type T0 = 1 | "s"
type T1 = 1 | 2 | "s"
type T2 = 9000000000 | 1 | "s"
type T3 = 1 | "s" | null
function g(x: T0) {
  if x is string { print("str") } else { print("num") }
}
function h(x: T0) {
  if x is i32 { print(x + 1) } else { print(x) }
}
function k(x: T1) {
  if x is string { print(x + "!") } else { print(x + 40) }
}
function lit(x: T1) {
  if x is "s" { print("str") } else { print(x + 1) }
}
function w(x: T2) {
  if x is i64 { print("wide") }
  else if x is i32 { print("narrow") }
  else { print(x) }
}
function mk(n: i32): T0 {
  if n == 0 { return 1 }
  "s"
}
function nul(x: T3) {
  if x is string { print("str") }
  else if x == null { print("null") }
  else { print("num") }
}
g("s")
g(1)
h("s")
h(1)
k("s")
k(2)
lit("s")
lit(2)
w(1)
w(9000000000)
print(mk(0) is string)
print(mk(0) is i32)
nul("s")
nul(1)
nul(null)
