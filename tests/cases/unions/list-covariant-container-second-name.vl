// @run
// @log 7
// @log 1
// @log 1
// @hint redundant type annotation: `a` is inferred as `{r: i32}[]` — remove it to lean on inference
// @hint redundant type annotation: `sf` is inferred as `{xs: Shape[]}` — remove it to lean on inference
// A read-only covariant list inside a container reached under a second name (D1659).
//
// Nothing writes this list, so the element-converting copy is unobservable and the program
// is legal. It was refused because `other`'s unrelated `Shape[]` write disqualifies the
// destination's element ROW, and the per-value answer that overrides that could not follow
// the value into a container with two names. Delete `other` and this ran either way, which
// is what makes the second name the ingredient.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box = { xs: Shape[] }

function f() {
  const a: Circle[] = [{ r: 7 }]
  const b: Shape[] = a
  const sf: Box = { xs: b }
  const sf2 = sf
  const e = sf2.xs[0]
  if e is Circle { print(e.r) }
  print(a.length)
}

function other() {
  const w: Shape[] = []
  w.push({ s: 3 })
  print(w.length)
}

f()
other()
