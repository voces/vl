// @hint redundant type annotation: `g` is inferred as `A | {r: f64}`
// @hint redundant type annotation: `g` is inferred as `A | B`
// @run
// @log 7
// @log 1.5
// @log 7
// @log 1.5
// @log 7
// @log 1.5
// @log 8
// @log 7
// @log 1.5
// @log 7
// @log 2.5
// @log 7
// @log 2.5
// @log 7
// @log 1.5
// @log 7
// @log q
// A `??` whose left operand is an existing record and whose default is a fresh literal of a
// different field type joins as a union of the two records: the existing record is never
// widened in place, and the literal is built at its own type (D13900). Spelled at a param, a
// field and a call result; the call result's other caller keeps its row.

function atParam(a: {r: i32} | null) {
  const g = a ?? { r: 1.5 }
  print(g.r)
}
atParam({ r: 7 })
atParam(null)

type H = { p: {r: i32} | null }
function atField(h: H) {
  const g = h.p ?? { r: 1.5 }
  print(g.r)
}
atField({ p: { r: 7 } })
atField({ p: null })

function src(b: boolean): {r: i32} | null {
  if b { return { r: 7 } }
  null
}
function keep(): {r: i32} | null { src(true) }
function atCall(b: boolean) {
  const g = src(b) ?? { r: 1.5 }
  print(g.r)
}
atCall(true)
atCall(false)
const k = keep()
if k != null { print(k.r + 1) }

// The same join at a declared union destination, a declared result, and a non-literal default.
type A = { r: i32 }
type B = { r: f64 }
function toBinding(a: A | null) {
  const g: A | B = a ?? { r: 1.5 }
  print(g.r)
}
toBinding({ r: 7 })
toBinding(null)

function toResult(a: A | null): A | B { a ?? { r: 2.5 } }
print(toResult({ r: 7 }).r)
print(toResult(null).r)

function fromBinding(a: A | null) {
  const d: B = { r: 2.5 }
  const g: A | B = a ?? d
  print(g.r)
}
fromBinding({ r: 7 })
fromBinding(null)

// Read inline with no binding, and a default with a different field name.
function inline(a: A | null) { print((a ?? { r: 1.5 }).r) }
inline({ r: 7 })
inline(null)

function otherField(a: A | null) {
  const g = a ?? { s: "q" }
  if g is A { print(g.r) } else { print(g.s) }
}
otherField({ r: 7 })
otherField(null)
