// @run
// @hint redundant type annotation: `o` is inferred as `A` — remove it to lean on inference
// @hint redundant type annotation: `top` is inferred as `A` — remove it to lean on inference
// @log box
// @log 7
// @log lit
// @log box
// @log lit
// @log box
// @log dflt
// @log box
// A value `if` joined at a record arm's own row unboxes a narrowed arm out of its union box in
// that arm: the box holds an `A` built apart from the literal arm's, so a field only `A` has
// shows which record arrived, and a box holding a `B` takes the literal arm.
type A = { k: "a", v: i32, tag: string }
type B = { k: "b", w: i32 }
function pick(x: A | B) {
  const o: A = if x is A { x } else { { k: "a", v: 0, tag: "lit" } }
  return o
}
function pickSwapped(x: A | B) {
  const o: A = if x is B { { k: "a", v: 0, tag: "lit" } } else { x }
  return o
}
function pickDefault(x: A | B, d: A) {
  const o: A = if x is A { x } else { d }
  return o
}
const boxA: A | B = { k: "a", v: 7, tag: "box" }
const boxB: A | B = { k: "b", w: 3 }
const dflt: A = { k: "a", v: 5, tag: "dflt" }
print(pick(boxA).tag)
print(pick(boxA).v)
print(pick(boxB).tag)
print(pickSwapped(boxA).tag)
print(pickSwapped(boxB).tag)
print(pickDefault(boxA, dflt).tag)
print(pickDefault(boxB, dflt).tag)
const top: A = if boxA is A { boxA } else { dflt }
print(top.tag)
