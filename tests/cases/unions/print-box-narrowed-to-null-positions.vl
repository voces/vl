// @run
// @log null
// @log null
// @log null
// @log null
// @log null
// @log null
// @log null
// @log null
// @log 4
// A box an `is` chain narrows to `null` prints its own tag, at each place the read can come from:
// a module binding, a parameter, a record field, a generic instance's result, a loop, a hole read
// before its fill, and union shapes with a record, a string, a float or a boolean arm.
type Rec = { x: i32 }
const m: Rec | i32 | null = null
if m is Rec { print(m.x) }
else if m is i32 { print(m) }
else { print(m) }
function param(v: Rec | string | null) {
  if v is Rec { print(v.x) }
  else if v is string { print(v) }
  else { print(v) }
}
param(null)
function field(o: { h: Rec | i32 | null }) {
  if o.h is Rec { print(o.h.x) }
  else if o.h is i32 { print(o.h) }
  else { print(o.h) }
}
field({ h: null })
function pick<A, B>(k: i32, a: A, b: B): A | B | null {
  return if k == 0 { a } else if k == 1 { b } else { null }
}
const r: Rec = { x: 1 }
const g = pick(2, 5, r)
if g is Rec { print(g.x) }
else if g is i32 { print(g) }
else { print(g) }
function loop(v: f64 | boolean | null) {
  let i = 0
  while i < 1 {
    if v is f64 { print(v) }
    else if v is boolean { print(v) }
    else { print(v) }
    i = i + 1
  }
}
loop(null)
function hole(c: boolean) {
  let x = null
  print(x)
  if c { x = 4 }
}
hole(true)
function strs(v: i32 | string | null) {
  if v is i32 { print(v) }
  else if v is string { print(v) }
  else { print(v) }
}
strs(null)
function recs(v: Rec | f64 | null) {
  if v is Rec { print(v.x) }
  else if v is f64 { print(v) }
  else { print(v) }
}
recs(null)
recs({ x: 4 })
