// A coalesce of two nullable records delivered into an annotated `A | B | null` destination:
// its right operand is boxed at the union the destination holds, its null as that union's null.
// Bound in a list literal, pushed, passed, and read back by an `is` over a list element.
type A = { r: i32 }
type B = { q: string }
function mkA(n: i32): A | null {
  if n == 0 { return null }
  return { r: n }
}
function mkB(s: string): B | null {
  if s == "" { return null }
  return { q: s }
}
function show(x: A | B | null) {
  if x == null { print("null") }
  else if x is A { print(x.r) }
  else { print(x.q) }
}
function annotated(ka: i32, sb: string) {
  const xs: (A | B | null)[] = [mkA(ka) ?? mkB(sb)]
  if xs[0] == null { print("null") }
  else if xs[0] is A { print(xs[0].r) }
  else { print(xs[0].q) }
}
function pushed(ka: i32, sb: string) {
  const xs: (A | B | null)[] = []
  xs.push(mkA(ka) ?? mkB(sb))
  show(xs[0])
}
function elementIs(ka: i32, sb: string) {
  const xs: (A | B | null)[] = [mkA(ka) ?? mkB(sb), mkB("z")]
  let c = 0
  if xs[1] is B { c = c + 1 }
  if xs[0] is A { c = c + 10 }
  print(c)
}
function argument(ka: i32, sb: string) { show(mkA(ka) ?? mkB(sb)) }
annotated(0, "b") // b
annotated(3, "b") // 3
annotated(0, "") // null
pushed(0, "p") // p
pushed(4, "p") // 4
elementIs(5, "e") // 11
elementIs(0, "e") // 1
argument(0, "a") // a
argument(6, "a") // 6
const gx: (A | B | null)[] = [mkA(0) ?? mkB("g")]
if gx[0] is B {
  print(gx[0].q) // g
}
