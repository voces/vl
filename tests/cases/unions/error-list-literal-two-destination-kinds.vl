// @emit-error TWO declared destinations
// ONE UN-ANNOTATED LIST LITERAL, TWO DECLARED DESTINATIONS OF DIFFERENT ELEMENT KINDS
// is a LOUD reject, not a check-clean invalid module (D411).
//
// `const c: Circle[] = lv1` wants a plain struct-row element list; `const c2: Shape[] = lv1`
// wants a union-BOX element list. A list value has ONE element rep, so whichever the literal
// is built at, the OTHER store is a type mismatch — and `letRefListDestSlot` (D381) cannot
// arbitrate, because its gate is a KIND-2 filter: it never sees the `Circle[]` destination at
// all, it steps past it and mints the box. D381's landing moved WHICH binding is wrong (the
// engine's offset went 224 -> 226) and nothing more, which is why D411 was filed as a refusal.
//
// The refusal enumerated three ways to make this RUN and all three still stand refused: a
// variance rule reddens `const c: Shape[] = lv1`, which is D381's own subject and RUNS; a
// store-side coercion is a per-element rebuild loop the emitter has nowhere; splitting the
// binding is a rewrite pass. What it did not enumerate is the fourth answer — say so out
// loud. Measured on `scripts/silent-sweep/d411/`: 68 of the grid's 96 check-clean invalid
// modules become loud rejects, all 7 single-destination controls keep running, and 0 cells
// are lost. The 28 that stay silent are the ones this rung is never ASKED about (`reach=0`,
// probed) and are filed as D501.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function f() {
  const lv1 = [{ r: 7 }]
  const c: Circle[] = lv1
  const c2: Shape[] = lv1
  if c.length > 0 { print(c[0].r) } else { print(0) }
  if c2.length > 0 { print(1) } else { print(0) }
}
f()
