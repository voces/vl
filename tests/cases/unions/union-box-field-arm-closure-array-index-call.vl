// @run
// @log 024
// @log dx
// @log 2.5
// The element lambda ignores its param (it probes the ABI, not the arg):
// @warning Unused parameter
// A union-BOX FIELD read rebound to a local, narrowed to its struct arm, then an INDEXED
// call through that arm's CLOSURE-ARRAY field: `const t0 = v.f; if t0 is {…} {
// t0.f[0](1) }`. The reservation classifier this pins is
// `calleeIsUnionArmCloArrayIndex` — `blockHasCallRef`'s narrowing-blind walk of the
// union's arms to a code-5 reflist field whose element is a function type. Reaching it
// needs the union to arrive as a BOX-FIELD read: when the union local comes straight
// from a call or a literal, `exprIsClosure` already resolves `t0.f[0]` and the
// conservative classifier is never consulted, so no other corpus case exercises it.
// Without the reservation the narrowed `call_ref`'s closure spill lands on an
// unreserved (i32-typed) local — invalid wasm.
type K0 = "bxxd" | "024"

function go() {
  const v: {a: string, f: {a: string, f: ((i32) => K0)[], z: f64} | boolean, z: boolean} = {
    a: "dx",
    f: {
      a: "dx",
      f: [
        (q0) => ("024"),
      ],
      z: 2.5,
    },
    z: true,
  }
  const t0 = v.f
  if t0 is {a: string, f: ((i32) => K0)[], z: f64} {
    print(t0.f[0](1)) // 024 — the fused narrowed indexed call through the box field
    print(t0.a) // dx — decoy sibling through the same box
    print(t0.z) // 2.5
  } else {
    print("OTHER")
  }
}

go()
