// @run
// @log true
// @log true
// @log true
// @log true
// An inline `??` or value `if` joining a union to a nullable record that no declaration
// names as an arm: the record takes a tag in the join's own box, minted from the checker's
// type, and a null record is the join's null (D2260).

type Err = { code: i32 }
type Ok = { v: i32 }

function viaMap(d: Ok | null) {
  const m: {[string]: i32[] | Err} = Map()
  print((m["z"] ?? d) == null)
}
viaMap(null)

function viaMapOk(d: Ok | null) {
  const m: {[string]: i32[] | Err} = Map()
  print((m["z"] ?? d) is Ok)
}
viaMapOk({ v: 3 })

function viaIf(c: boolean, a: i32[] | Err, d: Ok | null) {
  print((if c { a } else { d }) == null)
}
viaIf(false, [1], null)

function viaIfOk(c: boolean, a: i32[] | Err, d: Ok | null) {
  print((if c { a } else { d }) is Ok)
}
viaIfOk(false, [1], { v: 3 })
