// @run
// D1698 / D1699 — the rep a `??` produces, and the slot the binding it flows into is given.
// Both were read off the LEFT OPERAND; both are the type the checker recorded for the `??`
// NODE, which already knew. A fitting default keeps the operand's unboxed atom, a wider one
// widens the whole expression, and one from outside the operand's member set joins to a box.
//
// The operand is null in every default-kind line, so each proves the DEFAULT's own rep reached
// the print rather than a slot shaped for the operand. Tags are global atom codes, which is
// why the boxed shape can re-read the operand's own box in the non-null arm with no re-tagging.
//
// The `while` block is D1698 and is a COLLECTOR case, not a lowering one: `emitWhile` already
// narrowed the body, so the value was emitted unboxed and only the local it was stored into
// was a box. Both scopes are here — module and function — because the replay stood in two
// walks and fixing one left the other, which is what made the first fix read as no fix.

// @log 6
// @log 6
// @log 0
// @log x
// @log 1.5
// @log true
// @log 9
// @log j
// @log q
// @log 3
// @log 0
// @log x
// @log 1.5
// @log true
// @log 9
// @log j
// @log x
// @log 1.5
// @log 4
// @log x
// @log 8
// @log 4
// @log 8
// @log 8
// @log 4
// @log 8
// @log 8
// @log 8
// @log x
// @log 8
// @log s
// @log 8
// @log 7
// @log 5
// @log 8
// @log 8
// @log 7

// The three annotations are DECLARED rather than removed: each is a destination that pins the
// operand's own rep, and this fixture is about the rep a `??` hands to a destination. Dropping
// them would leave inference to pin what the test is measuring.
// @hint redundant type annotation: `p` is inferred as `i32 | null` — remove it to lean on inference
// @hint redundant type annotation: `w` is inferred as `i32 | null` — remove it to lean on inference
// @hint redundant type annotation: `ls` is inferred as `string[]` — remove it to lean on inference
// The mixed-union annotations are DECLARED for the same reason and one more: an inferred mixed
// join has no registered row to name (D1709), so the annotation is what the close needs.
// @hint redundant type annotation: `mb` is inferred as `i32 | A` — remove it to lean on inference
// @hint redundant type annotation: `mp` is inferred as `i32 | A` — remove it to lean on inference

type A = { r: i32 }
type M = i32 | A

function mkP(): i32 | null { return 4 }
function mkN(): i32 | null { return null }
function big(): i64 { return 9 }
function ls(): string[] { return ["q"] }
function nd(): i32 | null { return 3 }
function st(): A { return { r: 8 } }
function mkU(): i32 | string { return 4 }

// D1698 — the loop narrowing reaches the binding's classifier, at module scope…
const p: i32 | null = mkP()
while p != null {
  const q = p ?? 0
  print(q + 2)
  break
}

// …and inside a function, the twin walk.
function inFn() {
  const w: i32 | null = mkP()
  while w != null {
    const q = w ?? 0
    print(q + 2)
    break
  }
}
inFn()

// D1699 — the default's kind decides the result's rep.
const v = mkN()
print(v ?? 0)     // fits: the operand's own unboxed i32
print(v ?? "x")   // joins to `i32 | string`: a box
print(v ?? 1.5)   // widens to f64
print(v ?? true)  // joins to `i32 | boolean`: a box
print(v ?? big()) // widens to i64
const r = if 1 == 1 { v ?? "j" } else { "y" }
print(r)          // the same join reached through an if-expression's own block type
const lw = v ?? ls()
if lw is string[] {
  print(lw[0]) // a list default is a value atom
} else {
  print(0)
}
print(v ?? nd()) // a nullable default keeps `i32 | null`, the box it already was

// D1702 — the same lines through an UN-ANNOTATED parameter, which is the pin. The result type
// is a deferred hole there, so the pin banks it and the readers that route the value read
// through that bank rather than off the operand.
function pinned(a) {
  print(a ?? 0)
  print(a ?? "x")
  print(a ?? 1.5)
  print(a ?? true)
  print(a ?? big())
  const pr = if 1 == 1 { a ?? "j" } else { "y" }
  print(pr)
}
pinned(mkN())

// D1701 — the operand forms that cannot be RE-READ, so they stash the box once instead of
// re-evaluating: a call, an `as?`, and an if-expression. One lowering over one rep with the
// arm above, so all three take the result type's decisions rather than the operand's.
print(mkN() ?? "x")
print(mkN() ?? 1.5)
const uu = mkU()
print((uu as? i32) ?? "x")
print((if 1 == 1 { mkN() } else { mkP() }) ?? "x")

// D1703 — a STRUCT default. The join is a MIXED union, which the language has; the box takes
// the struct member's tag, and the operand's own box stands in the join unchanged because a
// tag is program-global. Declared, since an inferred mixed join has no registered row (D1709).
const mb: M = mkN() ?? st()
if mb is A { print(mb.r) } else { print(0) }
const mp: M = mkP() ?? st()
if mp is A { print(mp.r) } else { print(mp) }
function mixed(): M {
  const mv = mkN()
  return mv ?? st()
}
const mr = mixed()
if mr is A { print(mr.r) } else { print(0) }

// D1709 — the same mixed joins with NO annotation anywhere. The binding's initialiser mints the
// row from its own arena type under the nominal render, which is the mint the inferred RETURN
// already took, so the two spell one union and neither is a second producer.
const ub = mkN() ?? st()
if ub is A { print(ub.r) } else { print(0) }
const up = mkP() ?? st()
if up is A { print(up.r) } else { print(up) }
const ui = if 1 == 1 { st() } else { 7 }
if ui is A { print(ui.r) } else { print(0) }
const uo = (if 1 == 1 { mkN() } else { mkP() }) ?? st()
if uo is A { print(uo.r) } else { print(0) }
function uret() {
  const uv = mkN()
  return uv ?? st()
}
const ur = uret()
if ur is A { print(ur.r) } else { print(0) }

// D1714 — the nullable-REF niches. Their `??` lowers through `br_on_non_null`, whose block
// type is the operand's own heap type, so a joining default had nowhere to land. The operand
// is staged once and both sides box; a FITTING default keeps the branching shape it had.
function mkS(): string | null { return null }
function mkSp(): string | null { return "s" }
function mkL(): i32[] | null { return null }
function mkA(): A | null { return null }
function mkAp(): A | null { return { r: 5 } }

const ns = mkS()
print(ns ?? "x") // fits: the niche keeps the `br_on_non_null` shape, byte for byte
const nsj = ns ?? st()
if nsj is A { print(nsj.r) } else { print(0) }
const nsp = mkSp()
const nsq = nsp ?? st()
if nsq is A {
  print(0) // the operand, boxed under its own atom
} else {
  print(nsq)
}
const nl = mkL()
const nlj = nl ?? st()
if nlj is A { print(nlj.r) } else { print(0) }
const na = mkA()
const naj = na ?? 7
if naj is A { print(0) } else { print(naj) }
const nap = mkAp()
const napj = nap ?? 7
if napj is A { print(napj.r) } else { print(0) }
const aq = (mkU() as? string) ?? st()
if aq is A { print(aq.r) } else { print(0) }

// The same joins inside a FUNCTION, where the slot is a local rather than a global: the
// binding's own classifier has to be told the result is the box too, or it declares the
// niche's ref and stores a box into it.
function niches() {
  const fs = mkS()
  const fj = fs ?? st()
  if fj is A { print(fj.r) } else { print(0) }
  const fa = mkA()
  const fq = fa ?? 7
  if fq is A { print(0) } else { print(fq) }
}
niches()
