// @run
// D1698 / D1699 — the rep a `??` produces, and the slot the binding it flows into is given.
// Both were read off the LEFT OPERAND; both are the type the checker recorded for the `??`
// NODE, which already knew. A fitting default keeps the operand's unboxed atom, a wider one
// widens the whole expression, and one from outside the operand's member set joins to a box.
//
// The operand is null in every default-kind line, so each proves the DEFAULT's own rep reached
// the print rather than a slot shaped for the operand. Tags are global atom codes, which is
// why the boxed shape can re-read the operand's own box in the non-null arm with no re-tagging.
//
// The `while` block is D1698 and is a COLLECTOR case, not a lowering one: `emitWhile` already
// narrowed the body, so the value was emitted unboxed and only the local it was stored into
// was a box. Both scopes are here — module and function — because the replay stood in two
// walks and fixing one left the other, which is what made the first fix read as no fix.

// @log 6
// @log 6
// @log 0
// @log x
// @log 1.5
// @log true
// @log 9
// @log j
// @log q
// @log 3

// The three annotations are DECLARED rather than removed: each is a destination that pins the
// operand's own rep, and this fixture is about the rep a `??` hands to a destination. Dropping
// them would leave inference to pin what the test is measuring.
// @hint redundant type annotation: `p` is inferred as `i32 | null` — remove it to lean on inference
// @hint redundant type annotation: `w` is inferred as `i32 | null` — remove it to lean on inference
// @hint redundant type annotation: `ls` is inferred as `string[]` — remove it to lean on inference

function mkP(): i32 | null { return 4 }
function mkN(): i32 | null { return null }
function big(): i64 { return 9 }
function ls(): string[] { return ["q"] }
function nd(): i32 | null { return 3 }

// D1698 — the loop narrowing reaches the binding's classifier, at module scope…
const p: i32 | null = mkP()
while p != null {
  const q = p ?? 0
  print(q + 2)
  break
}

// …and inside a function, the twin walk.
function inFn() {
  const w: i32 | null = mkP()
  while w != null {
    const q = w ?? 0
    print(q + 2)
    break
  }
}
inFn()

// D1699 — the default's kind decides the result's rep.
const v = mkN()
print(v ?? 0)     // fits: the operand's own unboxed i32
print(v ?? "x")   // joins to `i32 | string`: a box
print(v ?? 1.5)   // widens to f64
print(v ?? true)  // joins to `i32 | boolean`: a box
print(v ?? big()) // widens to i64
const r = if 1 == 1 { v ?? "j" } else { "y" }
print(r)          // the same join reached through an if-expression's own block type
const lw = v ?? ls()
if lw is string[] {
  print(lw[0]) // a list default is a value atom
} else {
  print(0)
}
print(v ?? nd()) // a nullable default keeps `i32 | null`, the box it already was
