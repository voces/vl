// @run
// @hint `A` is contained in `C`, so `is A` tests the value
// @hint `D` is contained in `E`, so `is D` tests the value
// @log A
// @log C
// @log A
// @log C
// @log A
// @log C
// @log A
// @log N
// @log A
// @log N
// @log P
// @log Q
// `is A` over a value whose field is a nested record only some of whose values fit `A`'s reads
// the nested record field by field (D4267): a nested box by its tag, a nested literal set by
// value, two records deep, beside a plain field, over a union and over a single record.
type A = { v: { x: i32 } }
type C = { v: { x: i32 | string } }
function f(u: A | C) {
  if u is A { print("A") } else { print("C") }
}
const c1: C = { v: { x: 1 } }
const c2: C = { v: { x: "s" } }
f(c1)
f(c2)
type D = { v: { w: { x: i32 } }, k: 1 | 2 }
type E = { v: { w: { x: i32 | boolean } }, k: i32 }
function g(u: D | E) {
  if u is D { print("A") } else { print("C") }
}
const e1: E = { v: { w: { x: 3 } }, k: 2 }
const e2: E = { v: { w: { x: true } }, k: 1 }
const e3: E = { v: { w: { x: 3 } }, k: 9 }
g(e1)
g(e2)
const d1: D = { v: { w: { x: 4 } }, k: 1 }
g(d1)
g(e3)
function h(c: C | null) {
  if c is A { print("A") } else { print("N") }
}
h({ v: { x: 2 } })
h(null)
h({ v: { x: 3 } })
h({ v: { x: "t" } })
type P = { v: { x: 1 | 2, y: i32 } }
type Q = { v: { x: i32, y: i32 } }
function k(q: Q) {
  if q is P { print("P") } else { print("Q") }
}
k({ v: { x: 2, y: 0 } })
k({ v: { x: 9, y: 0 } })
