// D1606 — a union-annotated local whose initializer is a call returning one concrete arm.
// The annotation pins the cell to the union box, so `letIsVariant` declines an init under
// one, and the binding boundary boxes an arm value through `emitUnionArmValueBox` — the
// rung the argument and global boundaries already deliver through.
//
// The twin `A`, a declared struct no union claims at the arm's exact layout, is what makes
// the two producers disagree out loud: it donates a struct row, so `emitUnionCoerce` boxes
// where with no twin the value passes raw and happens to fit a variant cell. `withTwin`,
// `noTwin` and `reassign` are those three faces. Every neighbouring delivery is kept here
// too, so a regression in either direction fails this case.
// @run
// @log 5
// @log 5
// @log 5
// @log 7
// @log 5
// @log 5
// @log 6
// @log 5
// @log 5
// @log 5

// ── the twin: a declared struct no union claims, at the arm's exact layout ─────
type A = { q: i32 }
type Q = { q: i32 }
type U = Q | i32
function mkQ(): Q { return { q: 5 } }
function rdU(u: U) {
  if u is Q { return u.q }
  if u is i32 { return u }
  return 0
}

// The disagreement: the annotation names the box, the init is a bare variant ref.
function withTwin() {
  const x: U = mkQ()
  if x is Q { print(x.q) } else { print(0) }
}

// The same binding with the twin gone — the pin that an arm carrying no struct row of its
// own still reaches the box cell as a box.
type Q2 = { q: i32 }
type U2 = Q2 | i32
function mkQ2(): Q2 { return { q: 5 } }
function noTwin() {
  const x: U2 = mkQ2()
  if x is Q2 { print(x.q) } else { print(0) }
}

// The mutable face, which needs the box with the twin and without it: a variant-pinned cell
// has no room for the union's other arm, so the later `x = 7` has nowhere to land.
function reassign() {
  let x: U = mkQ()
  if x is Q { print(x.q) } else { print(0) }
  x = 7
  if x is i32 { print(x) } else { print(0) }
}

// ── the neighbouring deliveries, each already sound ───────────────────────────
function objLit() {
  const x: U = { q: 5 }
  if x is Q { print(x.q) } else { print(0) }
}
function constHop() {
  const t = mkQ()
  const x: U = t
  if x is Q { print(x.q) } else { print(0) }
}
function inlineUnion() {
  const x: Q | i32 = mkQ()
  if x is Q { print(x.q) } else { print(0) }
}
// The un-annotated face of the same delivery: inference binds the concrete arm, the cell
// stays the raw variant ref, and that spelling keeps running unchanged.
function unannotated() {
  const x = mkQ()
  print(x.q)
}

// The twin claimed by a second union — the arm-of-something control.
type V = A | boolean
function claimedTwin(v: V) {
  if v is A { return v.q }
  return 0
}

function main() {
  withTwin()
  noTwin()
  reassign()
  objLit()
  constHop()
  print(claimedTwin({ q: 6 }))
  inlineUnion()
  unannotated()
  print(rdU(mkQ()))
}
main()
