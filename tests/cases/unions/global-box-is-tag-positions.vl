// @log true
// @log true
// @log false
// @log true
// @log 0
// @log false
// @log true
// @log false
// @log 1
// Q58 position sweep: a module global's union box tested at module scope by an arm's tag, its raw
// box read whatever its narrowing: an `if` chain (then reading the narrowed value), a `let`
// initializer, a call argument, a `&&` operand, a negation, an `if` arm value, a record field, a
// list element and a `while` condition.
function q(k: i32): i32 | {a: boolean} | {b: string} {
  if k == 0 { return 5 }
  if k == 1 { return { a: true } }
  return { b: "x" }
}
type R = { ok: boolean }
function show(x: boolean) { print(x) }
const w = q(2)
if w is i32 { print(w) }
else if w is {a: boolean} { print(w.a) }
else { print(w.b) }
const u = q(1)
if u is i32 { print(u) }
else if u is {a: boolean} { print(u.a) }
else { print(u.b) }
const l = w is {b: string}
print(l)
show(u is {a: boolean})
print(w is i32 && true)
print(!(u is i32))
print(if w is {a: boolean} { 1 } else { 0 })
const r: R = { ok: u is {b: string} }
print(r.ok)
const xs = [w is {b: string}, u is i32]
print(xs[0])
print(xs[1])
let n = 0
let v = q(0)
while v is i32 {
  n = n + 1
  v = q(n)
}
print(n)
