// @run
// @log <5>
// @log 2.5
// @log w!
// @log 3.5
// @log 7
// @log 9
// @log 4
// @log 2
// A write into a union list's element or a union map's entry, used as a value, is the value's own
// arm unboxed from the box the store parked, in each position: an argument, a return, an
// initializer, after an operand, an `if` arm, a list element and a record field.
type R = { n: i32 }
function show(n: i32) { return "<\{n}>" }
function half(x: f64) { return x / 2.0 }
function one(k: i32) { return k + 1 }
function arg(us: (i32 | string)[], i: i32) { return show(us[i] = 5) }
function ret(us: (f64 | string)[], i: i32) { return us[i] = 2.5 }
function init(m: {[string]: i32 | string}, k: string) {
  const v = m[k] = "w"
  return v + "!"
}
function after(us: (f64 | string)[], i: i32) {
  return half(1.0) + (us[i] = 3.0)
}
function ifArm(us: (i32 | string)[], c: boolean) {
  const v = if c { us[0] = 7 } else { 0 }
  return v
}
function list(us: (i32 | string)[]) { return [one(1), us[1] = 9] }
function rec(us: (i32 | string)[]) {
  const r: R = { n: us[0] = 4 }
  return r
}
const us = [1, "a"]
const fs = [1.0, "b"]
const m: {[string]: i32 | string} = Map()
print(arg(us, 1))
print(ret(fs, 0))
print(init(m, "k"))
print(after(fs, 1))
print(ifArm(us, true))
print(list(us)[1])
print(rec(us).n)
print(us.length)
