// @run
// @log D:3
// @log C:3
// @log L:3
// @log D:4
// @log NO-nested
// @log NO-lambda
// @log P:3
// @log Q:3
// @log P:4
// @log NO-local
// A STRUCT union (`Cat | Dog`) captured under an `is` narrowing. This was the LOUD floor of
// the same defect — `emitProgram: field access but no struct type declared` — because
// `narrowVariantFor` answered "" inside the lifted body, so the field read never reached
// `emitNarrowedMem` and fell through to the plain struct path with no struct index.
//
// It needs nothing new: with the declaration-site narrowing replayed, `emitNarrowedMem`'s
// existing receiver path (`emitExpr` of the box, `struct.get $box 1`, `ref.cast` to the
// variant) lowers it. That is why this file is GREEN under a sabotage of
// `emitUnionBoxPush`'s capture leg while the scalar-atom cells go red: the struct arm's
// unbox is `emitNarrowedMem`'s own, not that one.
//
// Both BINDING FORMS are pinned, and they resolve through different machinery: a PARAM's
// union-ness comes from its annotation, while a function-scope LOCAL's comes from the
// EMIT-TIME local table, so only the local form needs `emitFuncCode`'s per-frame re-bank.
// Distinct nested-function names throughout — capture analysis is name-keyed module-wide.
type Cat = { meow: i32 }
type Dog = { woof: i32 }

function paramForm(u: Cat | Dog) {
  if u is Cat {
    print("D:" + toString(u.meow))
  } else {
    print("D:" + toString(u.woof))
  }
  if u is Cat {
    function capSuNes() {
      print("C:" + toString(u.meow))
    }
    capSuNes()
  } else {
    print("NO-nested")
  }
  if u is Cat {
    const capSuLam = () => {
      print("L:" + toString(u.meow))
    }
    capSuLam()
  } else {
    print("NO-lambda")
  }
}

function localForm(b: boolean) {
  const u = mk(b)
  if u is Cat {
    print("P:" + toString(u.meow))
  } else {
    print("P:" + toString(u.woof))
  }
  if u is Cat {
    function capSuLoc() {
      print("Q:" + toString(u.meow))
    }
    capSuLoc()
  } else {
    print("NO-local")
  }
}

function mk(b: boolean): Cat | Dog {
  if b { return { meow: 3 } }
  return { woof: 4 }
}

function main() {
  paramForm(mk(true))
  paramForm(mk(false))
  localForm(true)
  localForm(false)
}

main()
