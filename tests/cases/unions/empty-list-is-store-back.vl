// @run
// @log 1 v 0
// @log 1 v 0
// @log 1 v 0
// @log 1 v 0
// @log 1 v 0
// @log 1 v 0
// @log 1 v 0
// @log 1 v 0
// @log 2 3 3
// @log 1 1
// @log 0 0
// D4949: `x is string[]` over an empty `f64[]` stores an empty `string[]` back into the place, so
// a push lands there, while the old `f64[]` list, still held by `e`, stays empty.
type Box = { items: f64[] | string[] }
type Out = { inn: Box }
function show(n: i32, s: string, old: i32) { print("\{n} \{s} \{old}") }
const e: f64[] = []
const gx: f64[] | string[] = e
function main() {
  const x: f64[] | string[] = e
  if x is string[] {
    x.push("v")
    show(x.length, x[0], e.length)
  }
  if gx is string[] {
    gx.push("v")
    show(gx.length, gx[0], e.length)
  }
  const b: Box = { items: e }
  if b.items is string[] {
    b.items.push("v")
    show(b.items.length, b.items[0], e.length)
  }
  const o: Out = { inn: { items: e } }
  if o.inn.items is string[] {
    o.inn.items.push("v")
    show(o.inn.items.length, o.inn.items[0], e.length)
  }
  const arr: (f64[] | string[])[] = [e]
  if arr[0] is string[] {
    arr[0].push("v")
    show(arr[0].length, arr[0][0], e.length)
  }
  const ub = { items: if e.length == 0 { e } else { ["a"] } }
  if ub.items is string[] {
    ub.items.push("v")
    show(ub.items.length, ub.items[0], e.length)
  }
  const cx: f64[] | string[] = e
  const fc = () => {
    if cx is string[] {
      cx.push("v")
      show(cx.length, cx[0], e.length)
    }
  }
  fc()
  const kx: f64[] | string[] = e
  const fk = () => {
    if kx is string[] {
      kx.push("v")
      show(kx.length, kx[0], e.length)
    }
  }
  fk()
  const fs: (() => i32)[] = []
  let k = 0
  while k < 2 {
    k = k + 1
    fs.push(() => {
      if cx is string[] {
        cx.push("w")
        return cx.length
      }
      -1
    })
  }
  print("\{fs[0]()} \{fs[1]()} \{cx.length}")
  print("\{kx.length} \{b.items.length}")
}
main()
// A delivery out of the narrowed place shares the new list.
const d: Box = { items: e }
if d.items is string[] {
  const y: string[] = d.items
  y.push("w")
}
print("\{d.items.length - 1} \{e.length}")
// @hint redundant type annotation: `y` is inferred as `string[]`
