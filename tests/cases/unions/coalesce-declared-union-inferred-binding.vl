// @run
// @log rect
// D1561 — a `??` over a nullable DECLARED struct union delivered into an INFERRED binding,
// read at the shared discriminant. The `??` desugars to an `if` whose recorded type renders
// its arms STRUCTURALLY, so the name-keyed registry scan could not name `Shape` and the
// binding carried no union name: `sharedUnionFieldPlan` found an empty member set and the
// read took `emitProgram: field access but no struct type declared`.
//
// The ANNOTATED spelling (`let v: Shape = …`) always ran, and after the fix both spellings
// emit a byte-identical module — which is what the fixture is for: annotating every
// destination is exactly what hides this defect.
type Circle = { kind: "circle", r: f64 }
type Rect = { kind: "rect", w: f64, h: f64 }
type Shape = Circle | Rect
function mkval(): Shape { return { kind: "rect", w: 2.0, h: 3.0 } }
function passh(x) { return x }
function go() {
  const srcOpt: Shape | null = passh(mkval())
  let v = (srcOpt ?? { kind: "circle", r: 1.0 })
  v = (srcOpt ?? { kind: "circle", r: 1.0 })
  print(v.kind)
}
go()
