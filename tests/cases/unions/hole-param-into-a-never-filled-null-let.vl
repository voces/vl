// @run
// @log 1
// @log 1
// @log 2.5
// @log 1
// @log 1
// A `let x = null` a hole parameter fills holds that union at each instance's type: its value box
// is interned per instance, and the instance re-check's fill of the hole moves no emit memo.
function f(a) {
  let t = null
  t = a
  print(t)
}
f(1)
function g(a) {
  const s = null
  let t = s
  t = a
  print(t)
}
g(1)
f(2.5)
function h(a) {
  let t = null
  t = a
  print(t ?? 0)
}
h(1)
function k(a: i32) {
  let t = null
  t = a
  return t
}
print(k(1))
