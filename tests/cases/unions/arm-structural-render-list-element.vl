// @run
// @log 0
// @log 1
// A union ARM reached by its own STRUCTURAL RENDER as a ref-list element
// (silent-class-inventory D762). `nameIsRefArray` / `refArrElemName` reach an arm only by
// EXACT NAME (`variantIndexOf`), and not every producer spells one nominally: a value CALL's
// parameter type is rendered by canon, which expands the arm's own field types, so the arm
// `Circle = { r: Shape2 }` arrives as `{r:{c2:i32}|{s2:i32}}`. The struct bridge cannot claim
// it either (an arm has no `sNames` row), so the literal fell to the i32-list default and
// `checkArrName` printed "only i32[] arrays and struct/union element arrays are supported"
// over a program whose element is already a `(ref $uVarHeap[Circle])`.
//
// THE KEY IS THE ARM'S NOMINAL NAME, NOT THE RENDER, so the annotated `Circle[]` spelling and
// this one intern ONE ref-list slot and every nominal consumer downstream
// (`rlElemVariantHeap`, the construct, the read) resolves it unchanged. Disassembled on the
// second leg: `(type $9 (array (mut (ref null $2))))` over `$2`, which IS `Circle`.
//
// The rung is `variantIndexOfOwnRender` — canon's render of the arm ITSELF, not
// `variantIndexOfTypeName`'s lenient field-set match. Wired to the lenient one, corpus cell
// `a009962` went from a loud reject to CHECK-CLEAN INVALID WASM: `{r:null}` is field-set
// compatible with `Circle = {r: i32|null}` but is not its render, so the backing was typed
// for the arm while the literal still built its own row.
type Cir2 = { c2: i32 }
type Sq2 = { s2: i32 }
type Shape2 = Cir2 | Sq2
type Shape = Circle | Sq
type Sq = { s: i32 }
type Circle = { r: Shape2 }

function rd() {
  const c: Circle[] = []
  const lamc = (x: Circle[]) => x
  const dd = lamc(c)
  print(dd.length)

  const c2: Circle[] = [{ r: { c2: 1 } }]
  const dd2 = lamc(c2)
  let hit = 0
  for zz in dd2 {
    if zz.r is Cir2 { hit = hit + 1 }
  }
  print(hit)
}
rd()
