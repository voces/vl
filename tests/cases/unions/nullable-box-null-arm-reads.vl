// @run
// @log 5
// @log null
// @log 7
// @log null
// @log null
// @log null
// @log null
// @log null
// @log null
// @log 7
// @log null
// @log 10
// @log 42
// @log 42
// @log 11
// @log -1
// @log 0
// A nullable value box read where a narrowing pins it to `null` is printed and coalesced from
// its box's tag, at a name, a parameter, a field, an element, a reassigned local and a generic
// pin, and so still right after a loop back-edge, a closure or a call writes the place (D2801).
type O = { f: i32 | null }
function param(v: i32 | null) {
  if v == null { print(v) }
}
function pinned<T>(v: T) {
  if v != null { print(v) } else { print(v) }
}
function coal(sel: i32) {
  const v = if sel == 0 { 5 } else if sel == 1 { "s" } else { null }
  if v == null { print(v ?? 7) }
}
const i: i32 | null = 5
if i != null { print(i) } else { print(i) }
const n: i32 | null = null
if n != null { print(n) } else { print(n) }
const f: f64 | null = null
if f == null { print(f ?? 7) }
const s: i32 | string | null = null
if s != null { print(s) } else { print(s) }
param(null)
const pn: i32 | null = null
pinned(pn)
const o: O = { f: null }
if o.f != null { print(1) } else { print(o.f) }
const xs: (i32 | null)[] = [null]
if xs[0] != null { print(1) } else { print(xs[0]) }
let r: f64 | null = 2.5
r = null
if r == null { print(r) }
coal(2)
let z: i32 | null = null
if z == null {
  let i = 0
  while i < 2 {
    print(z)
    z = i + 10
    i = i + 1
  }
}
let q: i32 | null = null
if q == null {
  const g = () => {
    q = 42
  }
  g()
  print(q)
  print(q ?? 1)
}
function setF(p: O) { p.f = 11 }
const o2: O = { f: null }
if o2.f == null {
  setF(o2)
  print(o2.f ?? 9)
}
const ys: (i32 | null)[] = [null]
if ys[0] == null {
  let k = 0
  while k < 2 {
    print(ys[0] ?? -1)
    ys[0] = k
    k = k + 1
  }
}
