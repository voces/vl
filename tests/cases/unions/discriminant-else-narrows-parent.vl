// THE ELSE HALF of the discriminant — and with it the discriminated-union function is
// writable end to end, in the form it takes in every other typed language:
//
//     function area(s: C | R) {
//       if s.kind == "circle" { return s.r }
//       return s.w                             // ← this line needed the complement
//     }
//
// The THEN half shipped first and deliberately withheld this: `setNarrowFromCondElse`
// declines to else-narrow a struct union ("their member reads must not change"), so a
// checker-only complement would have typed `else { s.w }` clean and handed it to an emitter
// still seeing the full union — trading the accurate `field 'w' is not on every member of S`
// for an obscure `field access but no struct type declared`. Both layers land together here,
// so the two agree at every step.
//
// THE COMPLEMENT OF AN EQUALITY IS NOT THE POSITIVE TEST NEGATED, which is the one real
// subtlety. `s.kind == "circle"` being FALSE rules out exactly the arms whose tag can ONLY
// be `"circle"`; an arm whose tag is a WIDER set (`"circle" | "round"`, or plain `string`)
// survives, because it can hold something else and the false branch has not ruled it out.
// So the rule carries a MODE: `"intersect"` for a positive test (and for the complement of
// an `is`, where the fact is already the subtracted remainder), `"exclude"` for the
// complement of an equality, where only an arm pinned to exactly that literal drops.
//
// TWO BANKS, NOT ONE TABLE PLUS A FLAG. Both facts key on the SAME condition node, and the
// emitter reads them from two sites that never run together for one branch; a direction flag
// would be set by whichever site asked last.
//
// The SINGLE-SURVIVOR bound applies to the complement as it does to the positive test, and
// it stays LOUD: a three-arm union whose else keeps two pushes nothing, the emitter keeps the
// full union, and a field on only the survivors takes the shared-field plan's reject. That
// cell is exercised below through its `@error` sibling
// (`discriminant-else-multi-survivor-reject.vl`).
// @run
// @log 3
// @log 4
// @log 3
// @log 4
// @log 3
// @log 4
// @log 3
// @log 4
// @log 4

// a bare literal tag, both branches, with an explicit `else`
type C = { kind: "circle", r: f64 }
type R = { kind: "rect", w: f64 }
type S = C | R
function area(s: S) {
  if s.kind == "circle" { return s.r } else { return s.w }
}
print(area({ kind: "circle", r: 3.0 }))   // 3
print(area({ kind: "rect", w: 4.0 }))     // 4

// the FALL-THROUGH form — no `else` keyword, the complement carried past the `if`
function areaF(s: S) {
  if s.kind == "circle" { return s.r }
  return s.w
}
print(areaF({ kind: "circle", r: 3.0 }))  // 3
print(areaF({ kind: "rect", w: 4.0 }))    // 4

// a NUMERIC tag, both branches
type Ci = { kind: 0, r: f64 }
type Ri = { kind: 1, w: f64 }
type Si = Ci | Ri
function areaI(s: Si) {
  if s.kind == 0 { return s.r } else { return s.w }
}
print(areaI({ kind: 0, r: 3.0 }))         // 3
print(areaI({ kind: 1, w: 4.0 }))         // 4

// the `is` spelling's complement, through the same bank
type KC = "circle"
type KR = "rect"
// (its payload fields are named apart from `C`/`R` above on purpose: `{kind: KC, r: f64}`
// and `{kind: "circle", r: f64}` are the SAME arena type once `KC` folds, and an ambiguous
// surviving name declines to narrow — `discriminant-eq-ambiguous-name-floor.vl`)
type Ck = { kind: KC, radius: f64 }
type Rk = { kind: KR, width: f64 }
function areaK(s: Ck | Rk) {
  if s.kind is KC { return s.radius } else { return s.width }
}
print(areaK({ kind: "circle", radius: 3.0 }))  // 3
print(areaK({ kind: "rect", width: 4.0 }))     // 4

// the bare `s is C` complement is untouched — it never went through this rule
function areaB(s: S) {
  if s is C { return s.r }
  return s.w
}
print(areaB({ kind: "rect", w: 4.0 }))    // 4
