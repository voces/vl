// @run
// @hint redundant type annotation: `ret` is inferred as `string`
// @log b
// @log b
// @log n
// @log a
// @log 2
// @log true
// @log q!
// @log b
// @log 4
// `?.` over a nullable union of records whose receiver is a call evaluates the call once, as
// an argument, a return, off a member of a call, in a function body and in a lambda (D5301).
type N = { tag: "a", v: i32 } | { tag: "b", w: i32 }
type H = { n: N | null, k: i32 }
let calls = 0
function mk(): N | null {
  calls = calls + 1
  { tag: "b", w: 2 }
}
function none(): N | null { null }
function show(s: string) { print(s) }
function ret(): string { mk()?.tag ?? "r" }
const h: H = { n: { tag: "a", v: 1 }, k: 0 }
function getH(): H { h }
show(mk()?.tag ?? "z")
print(ret())
print(none()?.tag ?? "n")
print(getH().n?.tag ?? "m")
print(calls)
const t = mk()?.tag
print(t == "b")
function inner() { print((none()?.tag ?? "q") + "!") }
inner()
const fl = () => mk()?.tag ?? "l"
print(fl())
print(calls)
