// @run
// @log 7
// @log 1
// @hint redundant type annotation: `a` is inferred as `{r: i32}[]` — remove it to lean on inference
// @hint redundant type annotation: `rr` is inferred as `Shape[]` — remove it to lean on inference
// A covariant list delivered out through a return (D1628).
//
// The closure's other edges all carry a list from one name to another; a return has neither
// end of them, since the value leaves `hand` under no name. The fourth edge is the call
// result: `hand` returns a member of the set, so `rr` joins it and the return position is
// then claimed. It is claimed only where every call of `hand` delivers into such a
// destination — `take(hand(b))` hands the value to a parameter no name reaches, and keeps
// the `2` answer that declines the copy.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq

function hand(xs: Shape[]): Shape[] { xs }

function f() {
  const a: Circle[] = [{ r: 7 }]
  const b: Shape[] = a
  const rr: Shape[] = hand(b)
  const e = rr[0]
  if e is Circle { print(e.r) }
}

function other() {
  const w: Shape[] = []
  w.push({ s: 3 })
  print(w.length)
}

f()
other()
