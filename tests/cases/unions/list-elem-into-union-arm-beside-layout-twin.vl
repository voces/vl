// @run
// @log 7
// @log 7
// @log a
// @log 1
// An element of a list of records delivered to a union whose arm has a same-shaped twin is that
// arm's record, read through the list's element row; the twin may be declared before or after.
type C1 = { r: i32 }
type S1 = { z: i32 }
type U1 = C1 | S1
type D1 = { r: i32 }
const x1 = [{ r: 7 }]
const u1: U1 = (x1[0])
if u1 is C1 { print(u1.r) } else { print(0) }
type D2 = { r: i32, s: string }
type U2 = C2 | S2
type S2 = { z: i32 }
type C2 = { r: i32, s: string }
const x2 = [{ r: 7, s: "a" }]
const u2: U2 = (x2[0])
if u2 is C2 { print(u2.r) } else { print(0) }
if u2 is C2 { print(u2.s) } else { print(0) }
type C3 = { r: i32, q: i32 }
type S3 = { z: i32 }
type U3 = C3 | S3
type D3 = { r: i32, q: i32 }
const x3 = [{ r: 7, q: 1 }]
const u3: U3 = (x3[0])
if u3 is C3 { print(u3.q) } else { print(0) }
