// `x as? T` OVER A NUMERIC VALUE-ATOM ARM — `i32`, `i64`, `f64`, `f32`. With the string arm
// (`as-coalesce.vl`) and the variant / sub-union targets
// (`as-coalesce-variant-and-sub-union.vl`), the coalescing member of the trio is complete
// for every target that has a representation. Only a BOOLEAN arm is refused, and that one is
// a genuine rep difference — `as-coalesce-boolean-reject.vl`.
//
// A CORRECTION. These four were refused with the reason "a scalar arm is a value niche (a
// sentinel inside the scalar), which is a different lowering". **That was wrong**, and the
// disassembly says so plainly: `i32 | null` lowers as a BOXED value union whose null rides
// the TAG — `struct.get $box 0` against the null tag, then `ref.cast` + `struct.get` to
// recover the payload — not as a sentinel inside an i32. `isValueUnionName`'s solo rule
// admits exactly the four numeric kinds for that reason. The niche claim is true of
// `boolean | null` (the `i32.const 2` sentinel) and was generalised to every scalar without
// being measured.
//
// SO THEY SHARE THE SUB-UNION'S LOWERING, because they share its rep: the tag registry is
// global, so a box already tagged with the wanted arm IS a value of `T | null`, and the hit
// path hands back the operand's own box with no unbox and no rebuild. The miss builds the
// null-tagged box.
//
// THE BINDING NEEDS THE UNION NAME, which is the part that was actually missing. The
// narrow/unbox tables key on it, and an INFERRED binding (`const c = pick(b) as? i32`) has no
// annotation to read one from — so `if c != null { return c }` left the raw box on the stack
// where the return wanted the arm: `expected i32, found (ref $type)`, at `vl check` rc 0.
// `unionNameOfExpr` now renders the cast node's own recorded type, which is the same name the
// equivalent annotation produces, so both spellings key the same registry row.
// @run
// @log 7
// @log -1
// @log 2.5
// @log -1
// @log 9
// @log -1
// @log 1.5
// @log -1

type Count = { n: i32 }

function pickI32(b: boolean): i32 | Count { if b { return 7 }  { n: 0 } }
function pickF64(b: boolean): f64 | Count { if b { return 2.5 }  { n: 0 } }
function pickI64(b: boolean): i64 | Count { if b { return 9 }  { n: 0 } }
function pickF32(b: boolean): f32 | Count { if b { return 1.5 }  { n: 0 } }

function i32Of(b: boolean) {
  const c = pickI32(b) as? i32
  if c != null { return c }
  -1
}
function f64Of(b: boolean) {
  const c = pickF64(b) as? f64
  if c != null { return c }
  -1.0
}
function i64Of(b: boolean) {
  const c = pickI64(b) as? i64
  if c != null { return c }
  -1
}
function f32Of(b: boolean) {
  const c = pickF32(b) as? f32
  if c != null { return c }
  -1.0
}

print(i32Of(true))     // 7
print(i32Of(false))    // -1
print(f64Of(true))     // 2.5
print(f64Of(false))    // -1
print(i64Of(true))     // 9
print(i64Of(false))    // -1
print(f32Of(true))     // 1.5
print(f32Of(false))    // -1
