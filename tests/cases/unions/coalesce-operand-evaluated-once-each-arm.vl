// @run
// @log s:x
// @log s:none
// @log 7
// @log -1
// @log true
// @log false
// @log b
// @log a
// @log 3
// @log 0
// @log 5
// @log 9
// @log 2
// @log -2
// @log i
// @log s
// @log 4
// @log 1
// @log 6
// @log 0
// @log 1
// @log 2
// @log 22
type K = "a" | "b"
type R = { n: i32 | null, k: K | null }
type H = { r: R | null }
let calls = 0
function str(c: boolean): string | null {
  calls = calls + 1
  return if c { "x" } else { null }
}
function int(c: boolean): i32 | null {
  calls = calls + 1
  return if c { 7 } else { null }
}
function flag(c: boolean): boolean | null {
  calls = calls + 1
  return if c { true } else { null }
}
function atom(c: boolean): K | null {
  calls = calls + 1
  return if c { "b" } else { null }
}
function rec(c: boolean): R {
  calls = calls + 1
  return if c { { n: 3, k: "a" } } else { { n: null, k: null } }
}
function holder(c: boolean): H | null {
  calls = calls + 1
  return if c { { r: { n: 5, k: null } } } else { null }
}
function box(c: boolean): i32 | string | null {
  calls = calls + 1
  return if c { 4 } else { null }
}
function show(v: i32 | string) { return if v is i32 { "i" } else { "s" } }
function map(c: boolean): {[string]: i32} | null {
  calls = calls + 1
  if !c { return null }
  const m: {[string]: i32} = Map()
  m["k"] = 1
  return m
}
function other(): {[i32]: string} {
  const w: {[i32]: string} = Map()
  w[1] = "x"
  w[2] = "y"
  return w
}
function full(): {[string]: i32} {
  calls = calls + 1
  const m: {[string]: i32} = Map()
  m["k"] = 1
  return m
}
function list() {
  calls = calls + 1
  return [6]
}
print("s:" + (str(true) ?? "none"))
print("s:" + (str(false) ?? "none"))
print(int(true) ?? -1)
print(int(false) ?? -1)
print(flag(true) ?? false)
print(flag(false) ?? false)
print(atom(true) ?? "a")
print(atom(false) ?? "a")
print(rec(true).n ?? 0)
print(rec(false).n ?? 0)
print(holder(true)?.r?.n ?? 9)
print(holder(false)?.r?.n ?? 9)
print(1 + (int(false) ?? 1))
print(-(int(false) ?? 2))
print(show(box(true) ?? "d"))
print(show(box(false) ?? "d"))
print(box(true) ?? 0)
print(full()["k"] ?? 0)
print(list().get(0) ?? 0)
print(list().get(3) ?? 0)
const mj = map(true) ?? other()
print(if mj is {[string]: i32} { mj.length } else { -1 })
const mk = map(false) ?? other()
print(if mk is {[string]: i32} { -1 } else { mk.length })
print(calls)
