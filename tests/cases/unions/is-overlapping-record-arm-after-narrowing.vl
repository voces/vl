// @run
// @log C
// @log true
// @log true
// @log D
// @log false
// @log true
// @log true
// @log false
// `is` answers from the value where one record arm's field shares values with the other's: a
// binding narrowed to one arm still tests the other (D4056, D17074).
type C = { v: "a" | "b" | null }
type D = { v: string }
type E = { n: 1 | 2 | null }
type F = { n: i32 }
function g(u: C | D) {
  if u is C { return "C" }
  return "D"
}
let w: C | D = { v: "b" }
print(g(w))
print(w is C)
print(w is D)
w = { v: "zz" }
print(g(w))
print(w is C)
const e: E | F = { n: 2 }
print(e is E)
print(e is F)
const z: E | F = { n: null }
print(z is F)
