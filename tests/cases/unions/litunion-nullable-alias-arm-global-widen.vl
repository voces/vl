// @run
// @log false
// @log false
// @log true
// A module global whose union reaches a nullable literal union only through an alias arm takes
// the literal member into its box as a string, the same as the inline spelling (D7043).
type A = ("a" | "b") | null
type U = A | { tag: i32 }
type V = A | i32
const a: ("a" | "b") | null = "a"
const u: U = a
print(u == null)
const v: V = a
print(v == null)
const n: ("a" | "b") | null = null
const w: U = n
print(w == null)
