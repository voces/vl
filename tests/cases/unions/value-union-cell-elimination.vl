// @run
// @log 5
// @log s!
// @log null
// @log s!
// @log 5
// @log s!
// @log null
// @log 5
// @log s!
// @log 5
// @log s!

// D2586: a value-union map or list cell read by elimination lowers the survivor at its own member,
// whether the null test comes before the `is` or after it, and a missing key reads as null.
function mk(k: i32): i32 | string | null {
  if k == 1 { return 4 }
  if k == 2 { return "s" }
  null
}

function mapNullFirst(k: i32) {
  const p: { [string]: i32 | string | null } = Map()
  if k > 0 { p["k"] = mk(k) }
  if p["k"] == null { print("null") }
  else if p["k"] is i32 { print(p["k"] + 1) }
  else { print(p["k"] + "!") }
}

function mapIsFirst(k: i32) {
  const p: { [string]: i32 | string } = Map()
  if k == 1 { p["k"] = 4 }
  if k == 2 { p["k"] = "s" }
  if p["k"] is i32 { print(p["k"] + 1) }
  else if p["k"] != null { print(p["k"] + "!") }
  else { print("null") }
}

function mapNested(k: i32) {
  const p: { [string]: i32 | string | null } = Map()
  p["k"] = mk(k)
  if p["k"] != null {
    if p["k"] is i32 { print(p["k"] + 1) } else { print(p["k"] + "!") }
  }
}

function listIsFirst(k: i32) {
  const xs = [mk(k)]
  if xs[0] is i32 { print(xs[0] + 1) }
  else if xs[0] != null { print(xs[0] + "!") }
  else { print("null") }
}

mapNullFirst(1)
mapNullFirst(2)
mapNullFirst(0)
mapIsFirst(2)
mapIsFirst(1)
mapNested(2)
mapIsFirst(0)
mapNested(1)
listIsFirst(2)
listIsFirst(1)
mapNullFirst(2)
