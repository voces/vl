// @log false
// @log false
// @log false
// @log false
// @log false
type K = "a" | "b"
type U = i32 | K | null
type O = { k: K | null }
let g: K | null = null
const o: O = { k: null }
const xs: (K | null)[] = [null]
function setG(k: K | null, r: U): U {
  g = k
  return r
}
function setO(k: K | null, r: U): U {
  o.k = k
  return r
}
function setX(k: K | null, r: U): U {
  xs[0] = k
  return r
}
function glob() {
  g = null
  print(g == setG("a", "a"))
  g = "b"
  print(g != setG(null, "b"))
  g = "a"
  print(g == setG(null, null))
  g = null
  print(setG("a", "a") == g)
}
function field() {
  o.k = null
  print(o.k == setO("a", "a"))
  o.k = "b"
  print(o.k != setO(null, "b"))
}
function elem() {
  xs[0] = null
  print(xs[0] == setX("a", "a"))
  xs[0] = "b"
  print(xs[0] != setX(null, "b"))
}
function capt() {
  let lk: K | null = null
  const f = (k: K | null, r: U): U => {
    lk = k
    return r
  }
  print(lk == f("a", "a"))
  lk = "b"
  print(lk != f(null, "b"))
}
glob()
field()
elem()
capt()
