// @run
// @log ok
// @log 2.5
// @log 1.5
// @log 3
// @log 3.5
// @log y
// @log true
// @log 2
// @log 4
// @log 5
// @log 3
// @log s
// Regression (D2391). An assignment is an expression yielding its right side, and the
// checker types `v = e` at `e`'s type. Where `v`'s cell is a value-union box, the value is
// read back from the box at that one member rather than handed on as the box, in every
// position the value reaches: a lambda tail over a module global (the row's witness), a
// function tail, a binding, an argument, and a tail `if` whose arms name one member. A tail
// `if` whose arms name different members still returns the box.
let v: f64[] | string = "a"
const k = () => {
  v = [1.5, 2.5]
}
print("ok")

const r = k()
print(r[1])
if v is f64[] { print(v[0]) }

let n: i32 | string = "x"
function bump() { n = 2 }
print(bump() + 1)

function local() {
  let w: f64 | string = "s"
  const q = (w = 2.5)
  q + 1.0
}
print(local())

function param(p: string[] | i32) { p = ["x", "y"] }
print(param(0)[1])

let flag: boolean | string = "f"
const setFlag = () => {
  flag = true
}
print(setFlag())

function sum(xs: i32[]) { xs[0] + xs[1] }
function arg() {
  let u: i32[] | string = "u"
  sum(u = [0, 2])
}
print(arg())

function same(c: boolean) {
  if c { n = 4 } else { n = 5 }
}
print(same(true))
print(same(false))

function join(c: boolean) {
  if c { n = 3 } else { n = "s" }
}
const j1 = join(true)
if j1 is i32 { print(j1) }
const j2 = join(false)
if j2 is string { print(j2) }
