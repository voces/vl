// @log true
// @log false
// A union compare whose sides cannot both hold a map stays legal (D16611): a scalar against a
// union with a map arm, and a record arm whose field is itself a union.
const u: {[string]: i32} | i32 = 3
print(u == 4)
print(u == 3)
type A = { n: i32 | string }
const w: A | i32 = 3
const x: A = { n: 1 }
print(w == x)
