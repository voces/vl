// @run
// @log 2
// @log 2
// @log b
// @log 7
// @log 5
// @log 9
// `is A` where the union spells A's arm by its shape: a literal list, an annotated shape list,
// an inline literal-set field, a generic join with null, and a mixed literal's element.
type A = { v: i32 }
function lit() {
  const x = [{ v: 2 }, "s"]
  const y = x[0]
  if y is A { print(y.v) }
}
lit()
function ann() {
  const x: ({ v: i32 } | string)[] = [{ v: 2 }, "s"]
  const y = x[0]
  if y is A { print(y.v) }
}
ann()
type L = { x: "a" | "b" } | { y: i32 }
const u: L = { x: "b" }
if u is { x: "a" | "b" } { print(u.x) }
type Rec = { x: i32 }
function two<X, Y>(k: i32, a: X, b: Y) {
  if k == 0 { a }
  else if k == 1 { b }
  else { null }
}
const v = two(1, 1, { x: 7 })
if v is Rec { print(v.x) }
type P = { x: i32 }
const xs = [{ x: 1 }, "s", { x: 5 }]
const w = xs[2]
if w is P { print(w.x) }
const o = { f: xs[0] }
if o.f is P { print(o.f.x + 8) } else { print(o.f) }
