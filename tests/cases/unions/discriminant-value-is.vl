// D1023's ruling, graded at every row of its table in one program: `is A` over struct arms
// that share a field-NAME set is a DISCRIMINANT-VALUE test — true iff the tag names the
// shared shape AND the value's literal-typed fields are members of `A`'s sets.
//
// EACH PRINT IS A VALUE THAT NAMES THE ARM TAKEN, never a bare `true`. A test that printed
// the answer of `is` alone cannot tell "took the right branch" from "took the branch whose
// body happens to print the same thing", which is exactly how the filed row read as fine at
// one spelling for as long as it did.
//
// The overlapping-set rows are the ones worth reading twice. `"x" | "y"` and `"y" | "z"`
// share the member `"y"`, so a `"y"` value IS a member of both arms and both tests answer
// TRUE — truthfully, because under structural typing it really is both. Only `"x"` and `"z"`
// values are exclusive, and the else-branch narrows to the remainder.
// @run
// @log 1.5
// @log 25
// @log eq-circle
// @log eq-square
// @log AX
// @log BP
// @log AX-only
// @log both-Y
// @log BZ-only

type Circle = { kind: "circle", r: f64 }
type Square = { kind: "square", r: f64 }

function mkShape(n: i32): Circle | Square {
  if n == 0 { return { kind: "circle", r: 1.5 } }
  return { kind: "square", r: 2.5 }
}

// SINGLETON literals, the TypeScript idiom: `is` narrows, and the else-branch is the
// remainder with its own field readable.
const s0 = mkShape(0)
if s0 is Circle { print(s0.r) } else { print(s0.r * 10.0) }
const s1 = mkShape(1)
if s1 is Circle { print(s1.r) } else { print(s1.r * 10.0) }

// The `==` spelling must compute the SAME arm set as `is`, at both values.
const e0 = mkShape(0)
if e0.kind == "circle" { print("eq-circle") } else { print("eq-square") }
const e1 = mkShape(1)
if e1.kind == "circle" { print("eq-circle") } else { print("eq-square") }

// DISJOINT multi-member sets — the shape the row was filed on.
type A = { at: i32, kind: "x" | "y", msg: string }
type B = { at: i32, kind: "p" | "q", msg: string }
function mkAB(n: i32): A | B {
  if n == 0 { return { at: 1, kind: "x", msg: "AX" } }
  return { at: 2, kind: "p", msg: "BP" }
}
const d0 = mkAB(0)
if d0 is A { print(d0.msg) } else { print("WRONG-ARM") }
const d1 = mkAB(1)
if d1 is B { print(d1.msg) } else { print("WRONG-ARM") }

// OVERLAPPING sets: a `"y"` value is a member of BOTH arms and both tests answer true.
type P = { kind: "x" | "y", tag: string }
type Q = { kind: "y" | "z", tag: string }
function mkPQ(n: i32): P | Q {
  if n == 0 { return { kind: "x", tag: "AX-only" } }
  if n == 1 { return { kind: "y", tag: "both-Y" } }
  return { kind: "z", tag: "BZ-only" }
}
let i = 0
while i < 3 {
  const v = mkPQ(i)
  let inP = false
  let inQ = false
  if v is P { inP = true }
  if v is Q { inQ = true }
  if inP && inQ {
    print("both-Y")
  } else if inP {
    print("AX-only")
  } else {
    print("BZ-only")
  }
  i = i + 1
}
