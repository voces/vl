// @run
// @log 5
// @log 2.5
// @log 7
// @log 1.5
// A variant literal whose own type holds a narrower number than its union's row is built at the
// row, its field widened as it goes in: an `i32` into an `i64` field and into an `f64` field, and
// an `f32` into an `f64` field.
type A = { n: i64 }
type B = { x: f64, b: boolean }
type C = { y: f64, s: string }
type U = A | B | C
function mkA() {
  const u: U = { n: 5 }
  return u
}
function mkB() {
  const u: U = { x: 2.5, b: true }
  return u
}
function mkI(v: i32) {
  const u: U = { x: v, b: false }
  return u
}
function mkC(v: f32) {
  const u: U = { y: v, s: "" }
  return u
}
function show(u: U) {
  if u is A { print(u.n) }
  if u is B { print(u.x) }
  if u is C { print(u.y) }
}
show(mkA())
show(mkB())
show(mkI(7))
show(mkC(1.5 as f32))
