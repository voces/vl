// @run
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// GRADUATED from `silent-class-inventory` D88 — an ARM-VALUED MAP handed to a HAND-WRITTEN
// GENERIC. `vl check` rc 0 with NO diagnostics at all and a module the engine refuses with
// `type mismatch: expected (ref $type), found (ref $type)`, the two `$type`s being two
// DIFFERENT heap types behind one placeholder. It was the `INVALID_MODULE_SRC` specimen in
// `tests/vl_check_codegen_test.ts` and 20 of D87's 96-cell family; on the 9,450-cell D52
// grid it is 50 cells and it was that grid's LAST silent population.
//
// TWO mv SLOTS FOR ONE MAP, and the divergence is a SPELLING. `monoArgTyName` pins a
// generic's parameter from `nodeTyMapName`, which renders the checker's recorded type —
// and `tyToEmitName` spells a declared union ARM STRUCTURALLY (`{r:i32}`), because an arm
// has no `sNames` row for its nominal-first rung to find (`collectS` SKIPS a
// `type X = {…}` that is a union member). So the instance was cloned with the annotation
// `{[string]:{r:i32}}` while every other channel says `{[string]: Circle}`;
// `collectA`'s `TypeRef` walk resolved that render to a FRESH anonymous arena index,
// `variantRowOfTy` correctly declined it, `mvArmKeyName`'s re-key to the arm's own name
// never fired, and a SECOND mv slot was minted whose vals list holds `(ref null ${r:i32})`
// against the caller's `(ref null $uVarHeap[Circle])`.
//
// THE COMPLEMENT WAS ALREADY WRITTEN, ONE CONTAINER OVER. `shapeNominalOfTy` is the
// arm-aware nominal ladder and it recurses through `TyArray` — the LIST container — so a
// list ELEMENT that is a declared arm is spelled `Circle` wherever a consumer asks
// (`arrElemNominalOfTy`). The MAP was the one container it never grew.
// `nodeMapArmNominalName` is that missing twin, and it asks `variantRowOfTy` and nothing
// else: the ladder's two FIELD-SET rungs are structural, and a map value that is a plain
// declared struct is already correct, so a structural rung here could only re-decide a
// cell that already works — the D33/D75 collapse this seam is nominal to prevent.
//
// THE THREE CONTROLS THAT PLACE IT, all measured, and the two that would put it in a
// neighbouring row are INERT — which is why it was its own root and not D75/D82 or D87:
//
//   delete `idg`, call `thru(c)` directly        RAN even before  <- the axis
//   delete `type Dot` (the layout twin)          still silent     <- NOT the twin family
//   annotate the local `: {[string]: Circle}`    still silent     <- NOT D87's channel
//
// The ARM-ness is what is required, and that control is the one that fires: delete
// `type Shape = Circle | Sq` and the same program ran on master, because `Circle` then has
// an `sNames` row and `tyToEmitName` spells it nominally.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Dot = { r: i32 }

function idg<T>(x: T): T { return x }
function thru(x: {[string]: Circle}) { return x }

// THE FILED WITNESS, verbatim.
function mk(n: i32) {
  const c = Map()
  c["k"] = { r: n }
  return idg(thru(c))
}

// The ANNOTATED local — a control the row measured as still silent, so it is a row here.
function mkAnn(n: i32) {
  const c: {[string]: Circle} = Map()
  c["k"] = { r: n }
  return idg(thru(c))
}

// The generic hop with NO `thru` in front of it: the map reaches the instance directly.
function mkDirect(n: i32) {
  const c: {[string]: Circle} = Map()
  c["k"] = { r: n }
  return idg(c)
}

// One more hop through a LOCAL between the call and the generic.
function mkLocal(n: i32) {
  const c = Map()
  c["k"] = { r: n }
  const d = thru(c)
  return idg(d)
}

// The control the row names as RUNNING before the fix, kept so a later change that breaks
// it is caught here rather than in a grid: no generic at all.
function mkNoGeneric(n: i32) {
  const c = Map()
  c["k"] = { r: n }
  return thru(c)
}

print(idg(((mk(7))["k"] ?? { r: 0 }).r))
print(((mkAnn(7))["k"] ?? { r: 0 }).r)
print(((mkDirect(7))["k"] ?? { r: 0 }).r)
print(((mkLocal(7))["k"] ?? { r: 0 }).r)
print(((mkNoGeneric(7))["k"] ?? { r: 0 }).r)
