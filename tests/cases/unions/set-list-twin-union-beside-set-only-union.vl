// @run
// @log true
// @log true
// @log false
// @log true
// @log false
// A union holding a Set list and its boolean-map twin is its own member set, apart from a union
// holding the Set list alone: the boolean-map list boxes into it, and `is` tells the two apart
// (D16885).
const s: Set<i32> = Set()
const m: {[i32]: boolean} = Map()
const u: Set<i32>[] | i32 = [s]
const w: Set<i32>[] | {[i32]: boolean}[] | i32 = [s]
const x: Set<i32>[] | {[i32]: boolean}[] | i32 = [m]
print(u is Set<i32>[])
print(w is Set<i32>[])
print(x is Set<i32>[])
print(x is {[i32]: boolean}[])
print(w is {[i32]: boolean}[])
