// @run
// @log 3
// @log 3
// @log 6
// @log 6
// @log 1
// @log 2
// @log 9
// @log 9
// @log 7
// @log 7
// @log 4
// @log -1
// @log 18
// @log 18
// sunpa SP-010 (D3556): a map miss filled inside `if s == null { … }` leaves `s` non-null
// below the `if`, so the record reads without a second variable. Each reader takes the
// joined binding as `S`: an inferred and an annotated binding, a field, a method, an
// argument, a local closure. The `else` fill, the early return, and a fill on both arms of
// a nested `if` join the same way.
type S = { n: i32 }
const m: Map<i32, S> = Map()
function val(self: S) { self.n }
function twice(s: S) { s.n * 2 }

// The witness: the fill writes the map and the binding, and the tail returns it as `S`.
function get(k: i32): S {
  let s = m.get(k)
  if s == null {
    const fresh = { n: k }
    m[k] = fresh
    s = fresh
  }
  const t = s
  t
}
print(get(3).n)
print(get(3).n)

function readers(k: i32) {
  let s = m.get(k)
  if s == null { s = { n: k } }
  const a = s
  const q = (): i32 => s.n
  return (a.n + s.n + s.val() + twice(s) + q()) / 6
}
print(readers(6))
print(readers(6))

// A fill on both arms of a nested `if` joins non-null.
function nested(k: i32, c: boolean) {
  let s = m.get(k)
  if s == null {
    if c { s = { n: 1 } } else { s = { n: 2 } }
  }
  return s.n
}
print(nested(100, true))
print(nested(101, false))

// The `else` arm writes a fresh record; the field path `o.f` joins like a name.
type O = { f: S | null }
function viaElse(o: O) {
  if o.f == null { o.f = { n: 9 } } else { o.f = { n: 7 } }
  return o.f.n
}
print(viaElse({ f: null }))
print(viaElse({ f: null }))
print(viaElse({ f: { n: 5 } }))
print(viaElse({ f: { n: 5 } }))

// The early-return form.
function early(k: i32) {
  const s = m.get(k)
  if s == null { return -1 }
  return s.n
}
m[4] = { n: 4 }
print(early(4))
print(early(5))

// A module global, filled and read in the same function.
let g: S | null = null
function global() {
  if g == null { g = { n: 9 } }
  return twice(g)
}
print(global())
print(global())
