// @run
// @log 4
// @log 1
// @log true
// @log 8
// @log 1.5
// D2857: `as!` to a nested-list arm binds without an annotation, at module scope and in a
// function, and the bound list can be grown and read at its own element row.
function nb(c: boolean): boolean[][] | i32[][] {
  if c { return [[true]] }
  [[4]]
}
const u = nb(false) as! i32[][]
print(u[0][0])
print(u.length)
function g() {
  const w = nb(true) as! boolean[][]
  print(w[0][0])
  const v = nb(false) as! i32[][]
  v.push([5, 6])
  print(v[1][1] + v.length)
}
g()
function nf(c: boolean): f64[][] | string[][] {
  if c { return [[1.5]] }
  [["x"]]
}
const f = nf(true) as! f64[][]
print(f[0][0])
