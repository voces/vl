// @run
// @log 0
// @log 7
// @log 5
// @log false
// D1746 — AN INFERRED UNION JOIN REGISTERS ITS STRUCT MEMBERS AS ARMS.
//
// A mixed union the program only ever JOINS is minted in the emitter's variant table and
// spelled in no annotation, so the checker's nominal sidecar never learned its members were
// arms. The two readers of "is this a nullable variant" then disagreed: the name ladder said
// `nulvariant` off `fRetKind`, while `vtKindOfType` went through the arena rung, which sees a
// plain struct because nominality is not in the arena — a kind whose companion column
// answered -1, so the `??` join could not tag the default's own arm.
//
// The `is A` arms read a field, so a box tagged with the wrong arm cannot pass: the payload
// is `ref.cast` to the arm's own heap before the read.
type A = { r: i32 }
function mkA(): A | null { return null }
function mkS(): string | null { return null }
function mkA7(): A | null { return { r: 7 } }

// The row's own witness: both operands null, so the join is null at both faces.
const v = mkS()
const w = v ?? mkA()
if w is string { print(w) } else { print(0) }

// The default's arm actually arrives, and the field read proves the cast holds.
const v2 = mkS()
const w2 = v2 ?? mkA7()
if w2 is A { print(w2.r) } else { print(0) }

// The same join inside a function frame, where the binding is a local rather than a global.
function go() {
  const v3 = mkS()
  const w3 = v3 ?? mkA7()
  if w3 is A { print(w3.r - 2) } else { print(0) }
  print(w3 == null)
}
go()
