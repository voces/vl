// @run
// @log 1
// @log x
// @log 1
// @log z
// @log 7
// @log 8
// `is R` over a type parameter's inferred join with a literal, pinned to a record: the arm is
// found by type when its interned spelling is the shape, at a binding, a field, both faces of
// the record, and when the narrowed value is passed on.
type R = { f: i32 }
type Q = { q: string }
function g<T>(a: T, c: boolean) {
  const r = if c { 5 } else { a }
  return r
}
const u: R = { f: 1 }
const b = g(u, false)
if b is R { print(b.f) } else { print("x") }
const c = g(u, true)
if c is R { print(c.f) } else { print("x") }
const d = g(u, false)
if d is i32 { print("n") } else { print(d.f) }
const z: Q = { q: "z" }
const e = { v: g(z, false) }
if e.v is Q { print(e.v.q) } else { print("x") }
const s = { f: 7 }
const k = g(s, false)
if k is R { print(k.f) } else { print("x") }
function h(x: R) { print(x.f + 1) }
if k is R { h(k) }
