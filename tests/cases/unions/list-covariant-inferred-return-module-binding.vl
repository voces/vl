// @run
// @log 7
// A ref-list value handed back by an INFERRED return and bound at MODULE SCOPE (D1655).
//
// The binding's cell kind is memoised, and the rung that answers it reads `fRetKind` — a
// column `computeRetInference` fills in place, so no arena-shaped staleness test sees it
// move. The `is` narrowing below is what asks the question early: it resolves `e0`'s
// initialiser down to `v`, one pass before the return kind exists. A cached `"i32"` there
// promotes `v` to a start-function local of the wrong valtype, so drop the `is` and this
// program runs either way — which is what makes the narrowing the analysis, not scenery.
// Covariance is not an ingredient: a plain `Circle[]` return fails the same way.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq

function deliver() {
  const b: Shape[] = [{ r: 7 }]
  return b
}

const v = deliver()
const e0 = v[0]
if e0 is Circle { print(e0.r) } else { print(0) }
