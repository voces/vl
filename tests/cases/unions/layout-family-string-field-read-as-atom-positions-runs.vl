// @run
// @hint redundant type annotation: `k` is inferred as `K` — remove it to lean on inference
// @hint `A` is contained in `B`, so `is A` tests the value
// @log 1
// @log circle
// @log circle
// @log circle
// @log circle
// @log circle
// @log circle
// @log hcircle
// @log ccircle!
// @log true
// @log circle
// A literal-set field its layout family stores as its string, read as its atom off a union member
// in each position: the read is the string the field holds, which its consumer takes.
type K = "circle" | "round"
type A = { kind: K, r: i32 }
type B = { kind: string, r: i32 }
function sinkK(k: K) { print(k) }
function sinkS(s: string) { print(s) }
function id<T>(x: T): T { return x }
function retK(a: A): K { return a.kind }
function retS(a: A): string { return a.kind }
function argK(a: A) { sinkK(a.kind) }
function argS(a: A) { sinkS(a.kind) }
function gen(a: A) { print(id(a.kind)) }
function pr(a: A) { print(a.kind) }
function hole(a: A) { print("h\{a.kind}") }
function cat(a: A) { print("c" + a.kind + "!") }
function eqLit(a: A) { print(a.kind == "circle") }
function letK(a: A) {
  const k: K = a.kind
  print(k)
}
function mk(n: i32): A | B {
  if n == 0 {
    const a: A = { kind: "circle", r: 1 }
    return a
  }
  return { kind: "zz", r: 2 }
}
const x = mk(0)
if x is A { print(x.r) }
const a: A = { kind: "circle", r: 1 }
print(retK(a))
print(retS(a))
argK(a)
argS(a)
gen(a)
pr(a)
hole(a)
cat(a)
eqLit(a)
letK(a)
