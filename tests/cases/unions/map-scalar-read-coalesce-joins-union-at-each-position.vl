// @run
// A scalar map read defaulted with another arm of its union boxes a hit at the scalar's own arm and
// a miss at the default's, where the `??` is printed, bound, passed, interpolated, returned, or
// dropped, through a generic receiver and a global (D4643).
function show(x) { print(x) }
function viaPrint(p) { print(p.m[1] ?? true) }
function viaBind(p) {
  const r = p.m[9] ?? true
  print(r)
}
function viaPass(p) { show(p.m[2] ?? false) }
function viaInterp(p) {
  const r = p.m[1] ?? true
  print("v=\{r}")
}
function viaKey(p) { print(p.m["k"] ?? false) }
function viaRet(p) { return p.m[9] ?? "gone" }
function viaDrop(p) {
  const r = p.m[1] ?? true
  print("dropped")
}
const mm: {[i32]: i32} = Map()
mm[1] = 10
mm[2] = 20
const fm: {[string]: f64} = Map()
fm["k"] = 1.5
viaPrint({ m: mm })
viaBind({ m: mm })
viaPass({ m: mm })
viaInterp({ m: mm })
print(viaRet({ m: mm }))
viaDrop({ m: mm })
viaKey({ m: fm })
print(fm["z"] ?? false)
print(fm["k"] ?? false)
// @log 10
// @log true
// @log 20
// @log v=10
// @log gone
// @log dropped
// @log 1.5
// @log false
// @log 1.5
