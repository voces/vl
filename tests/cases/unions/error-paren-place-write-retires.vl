// @check
// @error cannot assign {s: i32} to Circle
// A PARENTHESISED WRITE RETIRES THE NARROWING IT WRITES THROUGH, and this is the SILENT
// half of silent-class-inventory D352 — the half its filed row, a loud check reject, did
// not have.
//
// `placeKeyOf` is the CHECKER's narrowing key and it read `P.nodes[ix]` raw, so `(t).v`
// keyed `""`. Fifteen callers read that key and only two are the member READ; this one is
// the assignment. With no key the write retired no narrowing, the next `t.v.r` read the
// stale `Circle`, and the program was `vl check` rc 0 and a `wasm trap: cast failure` at
// run time. Delete the parens on the WRITE and the same program is this file's diagnostic
// — which is what says the two spellings were a dialect apart rather than a gap.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Holder = { v: Shape }

function f(t: Holder) {
  if t.v is Circle {
    (t).v = { s: 3 }
    print(t.v.r)
  } else { print(0) }
}
f({ v: { r: 7 } })
