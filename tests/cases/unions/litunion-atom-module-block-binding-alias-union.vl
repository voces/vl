// @run
// @log false
// @log false
// A module-scope block's binding typed by a union that reaches a nullable literal union through
// an alias takes the literal member as a string, read in place and from a closure (D7121).
type A = ("a" | "b") | null
type U = A | i32
const ga: ("a" | "b") | null = "a"
if true {
  const c: U = ga
  print(c == null)
}
if true {
  const d: U = ga
  const f = () => {
    print(d == null)
  }
  f()
}
