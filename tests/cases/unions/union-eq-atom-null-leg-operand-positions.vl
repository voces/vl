function lineANPeq(u: UAN) {
  const ks: (K | null)[] = [null, "a", "b"]
  let s = "ANPeq"
  for p in ks {
    const h: HAN = { k: p }
    gAN = p
    const all = argANPeq(u, p, h)
    const agree = all == uargANPeq(u, p, h)
      && all == nestANPeq(u, p, h)
      && all == holeANPeq(u, p, h)
      && all == retANPeq(u, p, h)
      && all == letANPeq(u, p, h)
      && all == armANPeq(u, p, h, true)
      && all == coalANPeq(u, p, h, null)
      && all == fieldANPeq(u, p, h)
    s = s + " " + (if agree { c3(all) } else { "?" })
  }
  print(s)
}
