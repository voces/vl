// A `K | null` operand (a parameter, a record field or a global) compared with a union box on its
// null leg, at each value position and as `==` and `!=`: each line is one box value against the
// operand `null`, "a", "b", all positions agreeing. The id is tested for null, then decoded.
type K = "a" | "b"
type UAN = i32 | K | null
type HAN = { k: K | null }
let gAN: K | null = null
type UAX = i32 | K
type HAX = { k: K | null }
let gAX: K | null = null
type R = { ok: boolean }
function takeB(b: boolean) { return b }
function takeU(x: boolean | i32) { return x is boolean && x }
function id(b: boolean) { return b }
function c3(b: boolean) { return if b { "T" } else { "f" } }
function argANPeq(u: UAN, p: K | null, _h: HAN) { return takeB(u == p) }
function uargANPeq(u: UAN, p: K | null, _h: HAN) { return takeU(u == p) }
function nestANPeq(u: UAN, p: K | null, _h: HAN) { return takeB(id(u == p)) }
function holeANPeq(u: UAN, p: K | null, _h: HAN) {
  return "\{u == p}" == "true"
}
function retANPeq(u: UAN, p: K | null, _h: HAN): boolean { return u == p }
function letANPeq(u: UAN, p: K | null, _h: HAN) {
  const b = u == p
  return b
}
function armANPeq(u: UAN, p: K | null, _h: HAN, c: boolean) {
  return if c { u == p } else { false }
}
function coalANPeq(u: UAN, p: K | null, _h: HAN, nb: boolean | null) {
  return nb ?? (u == p)
}
function fieldANPeq(u: UAN, p: K | null, _h: HAN) {
  const r: R = { ok: u == p }
  return r.ok
}
