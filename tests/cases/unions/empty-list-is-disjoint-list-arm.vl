// @run
// @warning `is` check type 'string[]' can never match a value of type i32[], so this test is always false here
// @log i32
// @log i32
// @log f64
// @log match i32
// @log match i32
// @log ret i32
// @log global i32
// @log let i32
// @log 0
// @log 1
// D4915 under the D16047 refinement: an empty list whose annotation fixes its element type is
// tested by its arm, so over `i32[] | K[]` an empty `i32[]` is not `K[]`, at a parameter, a
// `match`, a return, a global and a `let`.
type K = "x" | "y"
function f(a: i32[] | K[]) {
  if a is K[] { print("K") } else { print("i32") }
}
function g(a: f64[] | string[]) {
  if a is string[] { print(a.length) } else { print("f64") }
}
function viaMatch(a: i32[] | string[]) {
  match a {
    string[] => print("match string")
    i32[] => print("match i32")
  }
}
function mk(): i32[] | K[] {
  const z: i32[] = []
  return z
}
const e: i32[] = []
const one = [1]
const ef: f64[] = []
f(e)
f(one)
g(ef)
viaMatch(e)
viaMatch(one)
const r = mk()
print(if r is K[] { "ret K" } else { "ret i32" })
const w: i32[] | string[] = e
if w is string[] { print(w.length) } else { print("global i32") }
let v: i32[] | string[] = e
if v is string[] {
  v.push("s")
  print(v[0])
} else {
  print("let i32")
}
print(e.length)
v = one
print(v.length)
