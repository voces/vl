// @run
// @log 4
// @log s
// @log s
// @log 2.5
// @log str s
// @log 4
// @log 4
// @log 4
// @log s
// @log 4
// A field the union's members store at different value atoms, read through an un-annotated
// parameter, is the box of the instance's field join: printed, bound, narrowed, returned to a
// function or to module scope (D15605, D15628).
type K = { h: i32 }
type J = { h: string, z: i32 }
type L = { h: f64 }
const k: K = { h: 4 }
const j: J = { h: "s", z: 1 }
const u: K | J = k
const w: K | J = j
function take(a) { print(a.h) }
take(u)
take(w)
function bind(a) {
  const n = a.h
  print(n)
}
bind(w)
const v: K | L = { h: 2.5 }
take(v)
function isy(a) {
  const x = a.h
  if x is string { print("str " + x) } else { print(x) }
}
isy(w)
isy(u)
function ret(a) { a.h }
function g() {
  const r = ret(u)
  print(r)
}
g()
const r = ret(u)
print(r)
print(ret(w))
const r2: i32 | string = ret(u)
print(r2)
