// @run
// @log s
// @log 2
// @log 1.5
// @log true
// @log 10000000000
// @log s
// @log 1.5
// D3031 — a record literal nesting a record whose leaf has another scalar kind is no arm and
// no declared record of the same field names, at any depth, and wherever it is read.
type X = { k: { p: i32 }, n: i32 }
type U = X | { z: i32 }
type Y = { k: { m: { p: boolean } }, n: i32 }
type V = Y | { z: i32 }
type Z = { k: { q: { m: { p: i32 } } }, n: i32 }
const o = { k: { p: "s" }, n: 2 }
print(o.k.p)
print(o.n)
function f(a) { print(a.k.m.p) }
f({ k: { m: { p: 1.5 } }, n: 2 })
const xs = [{ k: { p: true }, n: 2 }]
print(xs[0].k.p)
function mk() { return { k: { q: { m: { p: 10000000000 } } }, n: 2 } }
print(mk().k.q.m.p)
function main() {
  const w = { k: { m: { p: "s" } }, n: 2 }
  const g = () => w.k.m.p
  print(g())
  const z = { k: { q: { m: { p: 1.5 } } }, n: 2 }
  print(z.k.q.m.p)
}
main()
