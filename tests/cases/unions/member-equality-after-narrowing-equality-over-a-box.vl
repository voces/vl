// @run
// @log one
// @log zero
// @log null
// @log 2:two
// @log 2:one
// @log ne:yes
// @log ne:no
// @log nul:one
// @log nul:null
// @log num:seven
// @log num:x
// @log m:one
// @log m:null
// @log loc:one
// A member equality after an equality that narrows a `0 | "one" | null` box compares the box as
// legacy does: its tag, then its payload. After one narrowing test or two, as `!=`, with null
// checked first, a number member after a string one, in a `match`, and over a local cell.
type N = 0 | "one"
type W = 1 | 2 | "one" | "two"
type R = "x" | 7
function one(k: N | null) {
  if k == 0 { return "zero" }
  if k == "one" { return "one" }
  return "null"
}
function two(k: W | null) {
  if k == 1 { return "1" }
  if k == "one" { return "2:one" }
  if k == "two" { return "2:two" }
  return "rest"
}
function ne(k: N | null) {
  if k == 0 { return "zero" }
  if k != "one" { return "ne:no" }
  return "ne:yes"
}
function nul(k: N | null) {
  if k == null { return "nul:null" }
  if k == 0 { return "zero" }
  if k == "one" { return "nul:one" }
  return "rest"
}
function num(k: R | null) {
  if k == "x" { return "num:x" }
  if k == 7 { return "num:seven" }
  return "null"
}
function m(k: N | null) {
  return match k {
    0 => "m:zero"
    "one" => "m:one"
    null => "m:null"
  }
}
function loc(z: i32) {
  let k: N | null = null
  if z > 0 { k = "one" }
  if k == 0 { return "loc:zero" }
  if k == "one" { return "loc:one" }
  return "loc:null"
}
print(one("one"))
print(one(0))
print(one(null))
print(two("two"))
print(two("one"))
print(ne("one"))
print(ne(null))
print(nul("one"))
print(nul(null))
print(num(7))
print(num("x"))
print(m("one"))
print(m(null))
print(loc(1))
