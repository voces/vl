// @run
// @log 3
// @log b
// @log true
// @log b
// @log 3
// @log null
// @log true
// @log 2
// @log s
// @log 2
// @log null
// D16048, D16049: a shared field read through an un-narrowed union of records whose members
// store the field differently beside `null`, boxed into the read's union: a string set at the
// atom niche beside `i32 | null`, and nullable lists of different element types.
type K = "a" | "b"
type A = { v: K | null }
type B = { v: i32 | null }
const b: B = { v: 3 }
const u: A | B = b
print(u.v)
const a: A = { v: "b" }
const ua: A | B = a
print(ua.v)
const an: A = { v: null }
const un: A | B = an
print(un.v == null)
function f(w: B | A) {
  const y = w.v
  if y == null { print("null") } else { print(y) }
}
f(a)
f(b)
f(an)

type L = { v: i32[] | null }
type M = { v: string[] | null }
const m0: M = { v: null }
const lm: L | M = m0
print(lm.v == null)
const l1: L = { v: [1, 2] }
const ll: L | M = l1
const x = ll.v
if x is i32[] { print(x[1]) } else { print("not") }
function g(w: M | L) {
  const y = w.v
  if y == null { print("null") }
  else if y is string[] { print(y[0]) }
  else { print(y.length) }
}
g({ v: ["s"] })
g(l1)
g(m0)
