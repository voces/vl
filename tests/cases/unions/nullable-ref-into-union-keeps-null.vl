// @run
// @log false true
// @log true false
// @log false true
// @log true false
// @log false true
// @log true false
// @log true false
// @log false true
// @log false false
// @log 5
// @log null
// @log true false
// @log false true
// @log true
// @log false
// @log true
// @log true
// @log false
// @log false
// @log false
// A nullable record or string delivered into a value union that admits `null` keeps its null:
// a null record is the union's null, not a box tagged with the record's arm, and a null string
// is read raw rather than recovered non-null, and a null `boolean` (the i32 value 2) is tested
// on its value. Bound, passed, and as an `if` or map `??` arm (D2260).

type Err = { code: i32 }
type Ok = { v: i32 }

function show(y: Err | Ok | null) { print("\{y == null} \{y is Ok}") }

function pass(d: Ok | null) { show(d) }

function bindOk(d: Ok | null) {
  const y: Err | Ok | null = d
  print("\{y == null} \{y is Ok}")
}

function bindStr(d: string | null) {
  const y: i32[] | string | null = d
  print("\{y == null} \{y is string}")
}

function viaIf(c: boolean, a: i32[] | string, d: string | null) {
  print(
    "\{(if c { a } else { d }) == null} \{(if c { a } else { d }) is string}",
  )
}

function viaMap(d: Ok | null) {
  const m: {[string]: i32[] | Err} = Map()
  const y = m["z"] ?? d
  if y is Ok { print(y.v) }
  else if y == null { print("null") }
  else { print("arm") }
}

bindOk({ v: 1 })
bindOk(null)
bindStr("q")
bindStr(null)
pass({ v: 1 })
pass(null)
viaIf(false, "x", null)
viaIf(false, "x", "q")
viaIf(true, [1], "q")
viaMap({ v: 5 })
viaMap(null)

function bindBool(b: boolean | null) {
  const k: boolean | string | null = b
  print("\{k == null} \{k is boolean}")
}

function ifBool(c: boolean, a: i32 | null, b: boolean | null) {
  print((if c { b } else { a }) == null)
}

function mapBool(b: boolean | null) {
  const m: {[string]: boolean | i32} = Map()
  m["a"] = 3
  print((m["z"] ?? b) == null)
  print((m["a"] ?? b) == null)
}

bindBool(null)
bindBool(false)
ifBool(true, null, null)
ifBool(true, 1, true)
ifBool(false, null, null)
mapBool(null)
mapBool(true)
