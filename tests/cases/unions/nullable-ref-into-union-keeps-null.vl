// @run
// @log false true
// @log true false
// @log false true
// @log true false
// @log false true
// @log true false
// @log true false
// @log false true
// @log false false
// @log 5
// @log null
// A nullable record or string delivered into a value union that admits `null` keeps its null:
// a null record is the union's null, not a box tagged with the record's arm, and a null string
// is read raw rather than recovered non-null. Bound, passed, and as an `if` or map `??` arm (D2260).

type Err = { code: i32 }
type Ok = { v: i32 }

function show(y: Err | Ok | null) { print("\{y == null} \{y is Ok}") }

function pass(d: Ok | null) { show(d) }

function bindOk(d: Ok | null) {
  const y: Err | Ok | null = d
  print("\{y == null} \{y is Ok}")
}

function bindStr(d: string | null) {
  const y: i32[] | string | null = d
  print("\{y == null} \{y is string}")
}

function viaIf(c: boolean, a: i32[] | string, d: string | null) {
  print("\{(if c { a } else { d }) == null} \{(if c { a } else { d }) is string}")
}

function viaMap(d: Ok | null) {
  const m: {[string]: i32[] | Err} = Map()
  const y = m["z"] ?? d
  if y is Ok { print(y.v) } else if y == null { print("null") } else { print("arm") }
}

bindOk({ v: 1 })
bindOk(null)
bindStr("q")
bindStr(null)
pass({ v: 1 })
pass(null)
viaIf(false, "x", null)
viaIf(false, "x", "q")
viaIf(true, [1], "q")
viaMap({ v: 5 })
viaMap(null)
