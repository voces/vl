// @run
// @log 42
// @log 7
// The module-scope block-binding fix, with the NAME already asked about during an
// EARLIER emit pass — the case its memo's window guard exists for.
//
// `startStmts` is filled by `collectFns`, the FOURTH emit pass, so the three collect
// passes ahead of it see an EMPTY table (`resetLitAtoms` empties it per program so a
// shared compiler instance cannot read the previous program's node indices — those
// dereference into a re-minted arena and TRAP). A query issued in that window must
// therefore DECLINE, and — because the memo that keeps `parentLetOf`'s one-entry
// block cache from thrashing is keyed by NAME ALONE — it must decline WITHOUT
// recording anything, or the `-1` outlives the window and defeats the fix.
//
// This program forces exactly that collision. The index-WRITE-trap shape below makes
// `collectA` resolve the name `init` (measured: 297 such empty-window queries across
// the corpus, `init` among them) while `startStmts` is still empty; the module-scope
// block then binds a union to that SAME name. Without the guard the memo answers the
// later query from the earlier window and the narrowed read ships its box to
// `__print_i32__` — `failed to compile: wasm[0]::function[7]`, which is also what
// master does.

function cell(init: i32) {
  const store = [init, init, init]
  {
    "[]": (k: i32) => store[k],
    "[]=": (k: i32, v: i32) => {
      store[k] = v
    },
  }
}
const c = cell(7)
c[1] = 42
print(c[1]) // 42

const u: i32 | boolean = 7
if true {
  const init = u
  if init is i32 { print(init) } // 7
}
