// @check
// @error non-exhaustive match — missing null (add the arm or a `_`)
// @hint redundant type annotation: `pri` is inferred as `i32`
// The exhaustiveness half of D1898: `null` is a MEMBER of the scrutinee's set, so a `_`-less
// match that names every literal and not `null` is incomplete and the sentence names it —
// the same shape the bare set's `missing "c"` already had.
type K = "a" | "b"

function pri(k: K | null): i32 {
  match k {
    "a" => {
      return 1
    }
    "b" => {
      return 2
    }
  }
  -1
}

print(pri("a"))
