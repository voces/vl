// @run
// @log true
// @log false
// @log false
// @log true
// @log 2
// @log 0
// `x is L` over a box of list arms: an `i32[]` arm fits a list of `i32` literals by its elements,
// and a `string[]` arm fits a string literal list by its strings. Each arm is tested both ways.
// The string face sits beside a `boolean[]` arm: an `i32[]` one is D17052.
type K = 1 | 2
type S = "a" | "b"
function nums(c: boolean): i32[] | string[] {
  if c { return [1, 2] }
  return ["a", "z"]
}
function strs(c: boolean): boolean[] | string[] {
  if c { return [true] }
  return ["b", "a"]
}
function isK(x: i32[] | string[]) { return x is K[] }
function isS(x: boolean[] | string[]) { return x is S[] }
function len(x: i32[] | string[]) {
  if x is K[] { return x.length }
  return 0
}
print(isK(nums(true)))
print(isK(nums(false)))
print(isS(strs(true)))
print(isS(strs(false)))
print(len(nums(true)))
print(len(nums(false)))
