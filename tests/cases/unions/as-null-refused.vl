// @error `as null` names the absent arm of a nullable
// @error `as? null` names the absent arm of a nullable
// @error `as! null` names the absent arm of a nullable
// `null` is the absent arm of a nullable, not a type a value casts into, so every mode of
// `as null` is refused at check, over every operand rep: a niche `string | null`, a boxed
// `i32 | null`, a wider union, a record, a list, a type parameter, at module scope and over
// a non-nullable operand. The null test is `x == null` (`as-null-refused-neighbour.vl`).
type A = { a: i32 }

function nicheBare(x: string | null): string | null {
  const y = x as null
  return y
}

function nicheOpt(x: string | null): boolean { return (x as? null) == null }

function boxedTrap(x: i32 | null): i32 {
  const y = x as! null
  return 0
}

function wideOpt(x: i32 | string | null): i32 {
  const y = x as? null
  return 0
}

function recordTrap(x: A | null): i32 {
  const y = x as! null
  return 0
}

function listTrap(x: i32[] | null): i32 {
  const y = x as! null
  return 0
}

function generic<T>(x: T | null): i32 {
  const y = x as! null
  return 0
}

const top: string | null = null
const t = top as! null
const n: i32 = 3
const m = n as? null
print(nicheBare("a"))
print(nicheOpt("a"))
print(boxedTrap(null))
print(wideOpt(null))
print(recordTrap(null))
print(listTrap(null))
print(generic<i32>(null))
