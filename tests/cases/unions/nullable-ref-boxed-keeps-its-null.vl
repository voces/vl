// @run
// @log true false
// @log false true
// @log true false
// @log false true
// A nullable record or string boxed into a union that admits `null` keeps its null: a null is
// the union's null box, any other value its arm's box, the value read once.
type Err = { code: i32 }
type Ok = { v: i32 }
function show(y: Err | Ok | null) { print("\{y == null} \{y is Ok}") }
function pass(d: Ok | null) { show(d) }
pass(null)
pass({ v: 1 })
function bindStr(d: string | null) {
  const y: i32[] | string | null = d
  print("\{y == null} \{y is string}")
}
bindStr(null)
bindStr("q")
