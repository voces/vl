// @run
// @log null
// @log null
// @log null
// @log null
// @log null
// @log null
// @log null
// @log null
// @log 2
// A nullable reference whose other arm has no printed form prints `null` wherever its read comes
// from: a module binding, a parameter, a local, a record field, a list element, a loop, and a
// record, list, map or closure arm.
type Rec = { x: i32 }
const g: Rec | null = null
if g is Rec { print(g.x) } else { print(g) }
function param(xs: i32[] | null) {
  if xs is i32[] { print(xs.length) } else { print(xs) }
}
param(null)
function local() {
  const m: Map<string, i32> | null = null
  if m is Map<string, i32> { print(m.length) } else { print(m) }
}
local()
function field(o: { f: Rec | null }) {
  if o.f is Rec { print(o.f.x) } else { print(o.f) }
}
field({ f: null })
function closure(f: ((x: i32) => i32) | null) {
  if f is (x: i32) => i32 { print(f(1)) } else { print(f) }
}
closure(null)
function loop(r: Rec | null) {
  let i = 0
  while i < 2 {
    if r is Rec { print(r.x) } else { print(r) }
    i = i + 1
  }
}
loop(null)
function both(r: Rec | null) {
  if r is Rec { print(r.x) } else { print(r) }
}
both(null)
both({ x: 2 })
