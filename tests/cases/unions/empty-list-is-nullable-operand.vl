// @run
// @log no no no
// @log no no no
// @log no no no
// @log fits fits fits
// @log fits fits fits
// @log map no
// D4953 under the D16047 refinement: `v is string[]` over a nullable list union is false on
// null and on an empty list of another fixed arm, read from a binding, a parameter, a field or
// a map.
type U = f64[] | string[] | null
function pick(n: i32): U {
  if n == 0 { return null }
  if n == 1 { const e: f64[] = []; return e }
  if n == 2 { return [1.5] }
  if n == 3 { const s: string[] = []; return s }
  return ["x"]
}
function test(v: U) {
  return if v is string[] { "fits" } else { "no" }
}
type Box = { v: f64[] | string[] | null }
let n = 0
while n < 5 {
  const v = pick(n)
  const r = if v is string[] { "fits" } else { "no" }
  const bx: Box = { v: pick(n) }
  const r2 = if bx.v is string[] { "fits" } else { "no" }
  print(r + " " + test(pick(n)) + " " + r2)
  n = n + 1
}
const w = pick(1)
if w is string[] {
  w.push("pushed")
  print(w[0])
}
if w is string[] { print(w.length) }
const m: Map<string, f64[] | string[] | null> = Map()
m["a"] = pick(1)
const mv = m["a"]
if mv is string[] { print("map fits") } else { print("map no") }
