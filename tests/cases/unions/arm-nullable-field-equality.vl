// @run
// @log true
// @log false
// @log false
// @log true
// @log true
// @log false
// @log false
// @log true
// @log true
// @log false
// @log true
// @log true
// @log true
// Regression (silent-class-inventory D1293, D1294).
//
// The union-ARM spelling of a nullable field, which is a different table from the declared
// struct's and was blind in two more places:
//
//   * an `S[] | null` ARM field had NO field code at all. `collectU` runs BEFORE `collectS`,
//     and the name test for a nullable ref list resolves its ELEMENT through the struct
//     table — so `Inner[]` answered "not a ref array" and the field refused while the
//     identical field on a plain struct coded fine. The non-null `Inner[]` spelling never
//     had it: its array arm ends in a table-free fall-through. The arena decides it now,
//     and the element NAME is recorded deferred, as the shape-text recorder's already was;
//   * an arm object literal could not write a bare `null` into its own `T[] | null` field
//     for the scalar-backed list reps. The seed that types a bare `null` is set per field
//     CODE, and this ladder carried every code the struct literal's did except that family.
//
// BOTH DIRECTIONS AND THE NULL, at the arm spelling, for the reason the struct twin gives.
type Inner = { p: i32 }
type Rl = { d: Inner[] | null }
type Sl = { d: string[] | null }
type Bx = { d: i32 | null }

function mkRl(k: i32): Rl | i32 {
  if k == 0 { return 5 }
  { d: [{ p: 5 }] }
}
function mkRlNull(k: i32): Rl | i32 {
  if k == 0 { return 5 }
  { d: null }
}
function mkSlNull(k: i32): Sl | i32 {
  if k == 0 { return 5 }
  { d: null }
}
function mkSl(k: i32): Sl | i32 {
  if k == 0 { return 5 }
  { d: ["x"] }
}
function mkBx(k: i32): Bx | i32 {
  if k == 0 { return 5 }
  { d: 3 }
}

// an `S[] | null` ARM field: equal, unequal in the ELEMENT, and against the null
const rlSame: Rl = { d: [{ p: 5 }] }
const rlDiff: Rl = { d: [{ p: 6 }] }
const rlNull: Rl = { d: null }
print(mkRl(1) == rlSame)
print(mkRl(1) == rlDiff)
print(mkRl(1) == rlNull)
print(mkRlNull(1) == rlNull)

// a `string[] | null` ARM field, whose bare `null` is the construction gap
const slSame: Sl = { d: ["x"] }
const slDiff: Sl = { d: ["y"] }
const slNull: Sl = { d: null }
print(mkSl(1) == slSame)
print(mkSl(1) == slDiff)
print(mkSl(1) == slNull)
print(mkSlNull(1) == slNull)

// a value-union BOX ARM field
const bxSame: Bx = { d: 3 }
const bxDiff: Bx = { d: 4 }
print(mkBx(1) == bxSame)
print(mkBx(1) == bxDiff)

// the scalar arm of the same union still discriminates, and `!=` negates
print(mkRl(0) == mkRl(0))
print(mkRl(0) != mkRl(1))
print(mkSlNull(1) == mkSlNull(1))
