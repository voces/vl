// THE NUMERIC TAG — `{ kind: 0, … } | { kind: 1, … }` — the last spelling of the
// discriminated union that did not compile.
//
// `unionArmBoxSafe` admitted the string family through `tyIsLitUnion`, which is string-only
// BY CONSTRUCTION (it requires every member `litKind == "str"` — the workboard's D2 records
// that the litunion machinery is string-only while VL models str/flt/int literals alike). So
// the WHOLE numeric family fell to the closing `return false`: the bare literal (`kind: 0`),
// the named alias (`type K0 = 0`) and the multi-member alias, none of which the string arm
// could see. Every one was `cannot assign {kind: i32, r: f64} to 'c' of type S`.
//
// IT CLAIMS NO NEW FIELD REP. The standalone spelling already lowered — `type C = { kind: 0,
// r: f64 }` with no union in the file runs — and the tag boxes as its BASE SCALAR, which is
// #1866's ruling ("a numeric literal union reps as its BASE SCALAR; its members ARE values,
// so membership is a value test") and the same storage a plain `kind: i32` / `kind: f64`
// field already has. The `TyPrim` arm admits that spelling; this admits the literal one.
//
// THE TWIN-FOLD HAZARD WAS ALREADY COVERED, which is the part worth recording. Two arms
// differing only by a numeric tag share a field-NAME set and would fold as layout-equal
// twins if the variant identity column were blind to the literal — the silent wrong `is`
// the string family took when its arm was admitted. `variantFieldIdText` records EVERY
// `TyLit` kind rather than just `"str"`, so this family arrived already distinguished — and
// when D1023 ruled such a pair LEGAL, that column was what let the ruling read each arm's
// own tag instead of the base both softened to (`same-field-names-numeric-tags.vl`).
// @run
// @log 0
// @log 2
// @log 3
// @log 2
// @log 0
// @log 2
// @log 1
// @log 0

// bare i32 tags
type C = { kind: 0, r: f64 }
type R = { kind: 1, w: f64 }
type S = C | R
const c: S = { kind: 0, r: 2.0 }
if c is C { print(c.kind) print(c.r) }    // 0, 2

// bare FLOAT tags
type Cf = { kind: 0.5, r: f64 }
type Rf = { kind: 1.5, w: f64 }
type Sf = Cf | Rf
const cf: Sf = { kind: 1.5, w: 3.0 }
if cf is Rf { print(cf.w) }               // 3

// a NAMED numeric litunion tag
type K0 = 0
type K1 = 1
type Cn = { kind: K0, r: f64 }
type Rn = { kind: K1, w: f64 }
type Sn = Cn | Rn
const cn: Sn = { kind: 0, r: 2.0 }
if cn is Cn { print(cn.r) }               // 2

// the shared-field read and the `==` discriminant both work over a numeric tag, exactly as
// they do over a string one — neither needed a change for it
function area(s: S) {
  print(s.kind)
  if s.kind == 0 { return s.r }
  return 0.0
}
print(area({ kind: 0, r: 2.0 }))          // 0 then 2
print(area({ kind: 1, w: 5.0 }))          // 1 then 0
