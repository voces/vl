// @run
// @log 7
// @log 1
// @log 1
// @hint redundant type annotation: `a` is inferred as `{r: i32}[]` — remove it to lean on inference
// The un-annotated face of the returned container (D1682).
//
// The container walk reads the arena, not a type, so dropping `mk`'s return annotation moves
// nothing: the literal is still the function's tail statement and still reached through the
// same call destination. A fixture that annotates every destination cannot show that, which
// is why both faces are here. `Box` is declared but unspelled by `mk`, which is what interns
// the shape its inferred return needs (D1688).
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box = { xs: Shape[] }

function mk(v: Shape[]) { { xs: v } }

function f() {
  const a: Circle[] = [{ r: 7 }]
  const b: Shape[] = a
  const sf = mk(b)
  const e = sf.xs[0]
  if e is Circle { print(e.r) }
  print(a.length)
}

function other() {
  const w: Shape[] = []
  w.push({ s: 3 })
  print(w.length)
}

f()
other()
