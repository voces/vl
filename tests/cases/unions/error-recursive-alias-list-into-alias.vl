// @error string[] is not J[] (reached through string[] into J): a container never widens implicitly
// DV-1202 (D4038): a list delivered to a recursive alias that has a list arm needs the same copy
// as one delivered to a non-recursive union. The alias reaching itself is not a type hole.
type J = null | string | J[]
const ys: string[] = ["a"]
const k: J = ys
print(k is J[])
