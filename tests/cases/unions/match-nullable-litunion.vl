// @run
// @log 0
// @log 1
// @log 2
// @log FIRST 0
// @log WILD 0
// @log INFERRED 2
// @log EXPANDED 0
// @log OR 1
// @hint redundant type annotation: `nullLast` is inferred as `i32`
// @hint redundant type annotation: `nullFirst` is inferred as `i32`
// @hint redundant type annotation: `wild` is inferred as `i32`
// @hint redundant type annotation: `inferred` is inferred as `i32`
// @hint redundant type annotation: `expanded` is inferred as `i32`
// @hint redundant type annotation: `orPat` is inferred as `i32`
// A `match` over a NULLABLE literal union (D1898). The bare set already matched at every
// spelling; only `K | null` refused, and its own message said so — it printed `got K | null`.
//
// Both spellings intern the same i32 atom with `null` riding the spare `-1`, so the desugared
// `k is null` / `k == "a"` chain is what already lowered: the gap was the scrutinee gate and
// the pattern vocabulary, not a rep. The `null` arm is legal in any position and the checker
// names it in the exhaustiveness sentence.
import { toString } from "std:fmt"

type K = "a" | "b"

function mk(i: i32): K | null {
  if i == 0 { return null }
  if i == 1 { return "a" }
  "b"
}

function nullLast(k: K | null): i32 {
  match k {
    "a" => {
      return 1
    }
    "b" => {
      return 2
    }
    null => {
      return 0
    }
  }
  -1
}
print(nullLast(mk(0)))
print(nullLast(mk(1)))
print(nullLast(mk(2)))

function nullFirst(k: K | null): i32 {
  match k {
    null => {
      return 0
    }
    "a" => {
      return 1
    }
    "b" => {
      return 2
    }
  }
  -1
}
print("FIRST " + toString(nullFirst(mk(0))))

function wild(k: K | null): i32 {
  match k {
    "a" => {
      return 1
    }
    _ => {
      return 0
    }
  }
  -1
}
print("WILD " + toString(wild(mk(0))))

function inferred(i: i32): i32 {
  const k = mk(i)
  match k {
    "a" => {
      return 1
    }
    "b" => {
      return 2
    }
    null => {
      return 0
    }
  }
  -1
}
print("INFERRED " + toString(inferred(2)))

function mkX(i: i32): "a" | "b" | null {
  if i == 0 { return null }
  "a"
}

function expanded(k: "a" | "b" | null): i32 {
  match k {
    "a" => {
      return 1
    }
    "b" => {
      return 2
    }
    null => {
      return 0
    }
  }
  -1
}
print("EXPANDED " + toString(expanded(mkX(0))))

function orPat(k: K | null): i32 {
  match k {
    "a" | "b" => {
      return 1
    }
    null => {
      return 0
    }
  }
  -1
}
print("OR " + toString(orPat(mk(1))))
