// @run
// @log 1
// @log 107
// @log 8
// @log true
// @log 2
// @hint redundant type annotation: `f` is inferred as `i32`
// An inferred return of a union whose arm holds only a lone literal field names the union the
// annotation does, at an un-annotated binding and through a nullable return into a list (D5156).
type N = { tag: "end" } | { w: i32 }
function mk(e: boolean): N {
  if e { return { w: 1 } }
  { tag: "end" }
}
function d() { return mk(true) }
const v = d()
if v is { w: i32 } { print(v.w) }
type T = { tag: "a", v: i32 } | { tag: "b", v: i32 }
function f(n: T): i32 {
  if n is { tag: "a", v: i32 } { return 100 + n.v } else { return n.v }
}
function mt(k: i32) {
  if k == 0 {
    const r: T = { tag: "a", v: 7 }
    return r
  }
  if k == 1 {
    const r: T = { tag: "b", v: 8 }
    return r
  }
  return null
}
const x = mt(0)
if x != null { print(f(x)) }
const y = mt(1)
if y != null { print(f(y)) }
print(mt(2) == null)
const ns = [mt(0), mt(1)]
print(ns.length)
