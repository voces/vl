// @run
// @log 1
// @log 102
// @log 3
// @log s4
// @log i=5
// @log 6
// @log 7
// @log 8
// @log 9
// @log 10
// @log 3
// Q58 position sweep: an object literal boxed into a union whose arm is itself a union, as the
// variant its context names, delivered as a constant initializer, a scalar and a union call
// argument, a nested call argument, a concat operand, an interpolation hole, a return, a let
// initializer, an if arm, a `??` operand and a record field.
type Circle = { kind: "circle", r: f64 }
type Rect = { kind: "rect", w: f64, h: f64 }
type ParseError = { why: string }
type Shape = Circle | Rect
type Parsed = Shape | ParseError
const x: Parsed = { kind: "rect", w: 3.0, h: 1.0 }
function width(p: Parsed) { return if p is Rect { p.w } else { 0.0 } }
function takeU(p: Parsed | string) {
  if p is string { print(p) } else { print(width(p) + 100.0) }
}
function id(p: Parsed) { return p }
function show(p: Parsed) { return "\{width(p)}" }
function ret(): Parsed { return { kind: "rect", w: 6.0, h: 1.0 } }
function maybe(k: i32): Parsed | null {
  return if k > 0 { { why: "x" } } else { null }
}
function go(c: boolean) {
  print(width({ kind: "rect", w: 1.0, h: 1.0 }))
  takeU({ kind: "rect", w: 2.0, h: 1.0 })
  print(width(id({ kind: "rect", w: 3.0, h: 1.0 })))
  print("s" + show({ kind: "rect", w: 4.0, h: 1.0 }))
  const q: Parsed = { kind: "rect", w: 5.0, h: 1.0 }
  print("i=\{width(q)}")
  print(width(ret()))
  const l: Parsed = { kind: "rect", w: 7.0, h: 1.0 }
  print(width(l))
  const k: Parsed = if c { { kind: "rect", w: 8.0, h: 1.0 } } else { { why: "n" } }
  print(width(k))
  print(width(maybe(0) ?? { kind: "rect", w: 9.0, h: 1.0 }))
  const r: { p: Parsed } = { p: { kind: "rect", w: 10.0, h: 1.0 } }
  print(width(r.p))
}
go(true)
function tail() { print(width(x)) }
tail()
