// @run
// @log true
// @log false
// @log true
// @log false
// @log false
// @log true
// @log true
// @log false
// @log true
// @log false
// @log false
// @log true
// @log true
// @log false
// @log true
// @log false
// @log false
// @log true
// @log true
// @log false
// @log true
// @log false
// @log false
// @log true
// @log true
// @log false
// @log true
// @log false
// @log false
// @log true
// @log true
// @log false
// @log false
// @log false
// @log true
// @log false
// @log true
// @log false
// CONTRACT: `==` / `!=` over a NULLABLE REF NICHE, at every runtime input. The six rows per rep
// are, in order: two separately BUILT equal values (so the pin also states that list/string/
// struct `==` is DEEP, not `ref.eq` — `[1,2] == [1,2]` over distinct references is true), two
// unequal values, the SAME reference twice, left-null, right-null, and BOTH NULL. The closure
// block has FIVE: function `==` is identity, so "separately built but equal" does not exist for
// it and the alias row is the whole of its equal case.
//
// `null == null` is TRUE and `null == v` is FALSE. That is not a free choice: the value-union
// box (`i32 | null`), the `boolean | null` i32 sentinel and the `K | null` atom sentinel all
// already answer exactly this, and `emitCloEqCore`'s `ref.eq` over two null envs is 1 for the
// same reason — so the niches join a rule the language already had.
//
// Before the guard, every one of these rows was reached with the niche lowered as its NON-NULL
// rep: `vl check` clean and then INVALID WASM for the list/closure niches (a `(ref null $l)`
// stored into the compare frame's `(ref $l)` slot) and a `vl check`-clean runtime TRAP for the
// string/struct niches (the recovered read, and the field `struct.get` on a genuine null).
type S = {v: i32}
function cmpList(a: i32[] | null, b: i32[] | null) { print(a == b) }
function cmpStr(a: string | null, b: string | null) { print(a == b) }
function cmpStruct(a: S | null, b: S | null) { print(a == b) }
function cmpStrList(a: string[] | null, b: string[] | null) { print(a == b) }
function cmpRefList(a: i32[][] | null, b: i32[][] | null) { print(a == b) }
function cmpClo(a: ((i32) => i32) | null, b: ((i32) => i32) | null) {
  print(a == b)
}
function neList(a: i32[] | null, b: i32[] | null) { print(a != b) }
function inc(x: i32) { x + 1 }
function dec(x: i32) { x - 1 }
function main() {
  // i32-list niche.
  const l1: i32[] | null = [1, 2]
  const l2: i32[] | null = [1, 2]
  const l3: i32[] | null = [1, 3]
  const lN: i32[] | null = null
  cmpList(l1, l2)
  cmpList(l1, l3)
  cmpList(l1, l1)
  cmpList(lN, l2)
  cmpList(l1, lN)
  cmpList(lN, lN)
  // string niche.
  const s1: string | null = "ab"
  const s2: string | null = "ab"
  const s3: string | null = "ac"
  const sN: string | null = null
  cmpStr(s1, s2)
  cmpStr(s1, s3)
  cmpStr(s1, s1)
  cmpStr(sN, s2)
  cmpStr(s1, sN)
  cmpStr(sN, sN)
  // struct niche (the RE-READ guard: `emitStructEq`'s field compares re-evaluate each root).
  const t1: S | null = {v: 1}
  const t2: S | null = {v: 1}
  const t3: S | null = {v: 2}
  const tN: S | null = null
  cmpStruct(t1, t2)
  cmpStruct(t1, t3)
  cmpStruct(t1, t1)
  cmpStruct(tN, t2)
  cmpStruct(t1, tN)
  cmpStruct(tN, tN)
  // string-list niche (its own distinct backing wrapper).
  const g1: string[] | null = ["a", "b"]
  const g2: string[] | null = ["a", "b"]
  const g3: string[] | null = ["a", "c"]
  const gN: string[] | null = null
  cmpStrList(g1, g2)
  cmpStrList(g1, g3)
  cmpStrList(g1, g1)
  cmpStrList(gN, g2)
  cmpStrList(g1, gN)
  cmpStrList(gN, gN)
  // ref-list niche (`i32[][]`).
  const r1: i32[][] | null = [[1], [2]]
  const r2: i32[][] | null = [[1], [2]]
  const r3: i32[][] | null = [[1], [3]]
  const rN: i32[][] | null = null
  cmpRefList(r1, r2)
  cmpRefList(r1, r3)
  cmpRefList(r1, r1)
  cmpRefList(rN, r2)
  cmpRefList(r1, rN)
  cmpRefList(rN, rN)
  // closure niche — IDENTITY, not structure: the same lifted function is equal to itself.
  const c1: ((i32) => i32) | null = inc
  const c2: ((i32) => i32) | null = dec
  const cN: ((i32) => i32) | null = null
  cmpClo(c1, c1)
  cmpClo(c1, c2)
  cmpClo(cN, c1)
  cmpClo(c1, cN)
  cmpClo(cN, cN)
  // `!=` is the same guard negated ONCE, so both-null is false.
  neList(l1, l2)
  neList(l1, l3)
  neList(lN, lN)
}
main()
