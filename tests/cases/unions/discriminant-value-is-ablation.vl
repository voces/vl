// D1023's ABLATION cells — the shapes a peer's 17-cell grid found that the filed row did not
// mention, and the two things it REFUTED. Kept as a fixture because each one is a way of
// grading this family that scores the wrong answer green.
//
// REFUTED: "the literal SETS differing" was filed as the defect's ingredient. It is not. Two
// IDENTICAL arms with no literal field anywhere also answer `true`/`true` — and there that
// answer is CORRECT, because under structural typing they are ONE type. The defect was only
// ever arms whose types genuinely differ. Row 1 pins the correct `true`/`true`.
//
// REFUTED: field ORDER is not a defence. The arena keeps a `TyObj`'s fields in SOURCE order
// while the emitter's `variantSig` — the tag key — sees them SORTED, so `{at, kind, msg}` and
// `{kind, at, msg}` collide on a tag with their arena rows misaligned. Row 2 pins it; the
// checker's own rule pairs fields BY NAME for the same reason, and paired them by index until
// this grid was run.
//
// THE NUMERIC ROW IS WHY "DOES THE WITNESS TRAP" IS NOT A GRADER. Two numeric arms already
// interned to ONE struct type, so on master row 3 ran CLEAN with no trap and silently answered
// `true`/`true`. A grader watching for the filed row's trap scores it green while it is wrong.
// @run
// @log true
// @log true
// @log b
// @log a
// @log b
// @log true
// @log false
// @log false
// @log true
// @log 2.5
// @log true
// @log false
// @log false
// @log false
// @log true
// @log false
// @log false
// @log false
// @log true

// ROW 1 — two IDENTICAL arms, no literal field. `true`/`true` is the CORRECT answer.
type I1 = { at: i32, msg: string }
type I2 = { at: i32, msg: string }
function mkI(n: i32): I1 | I2 {
  if n == 0 { return { at: 1, msg: "a" } }
  return { at: 2, msg: "b" }
}
const iv = mkI(1)
print(iv is I1)
print(iv is I2)
if iv is I1 { print(iv.msg) }

// ROW 2 — the same field NAMES in a different ORDER, with a discriminant.
type O1 = { at: i32, kind: "x" | "y", msg: string }
type O2 = { kind: "p" | "q", at: i32, msg: string }
function mkO(n: i32): O1 | O2 {
  if n == 0 { return { at: 1, kind: "x", msg: "a" } }
  return { kind: "p", at: 2, msg: "b" }
}
const o0 = mkO(0)
if o0 is O1 { print(o0.msg) } else { print("WRONG-ARM") }
const o1 = mkO(1)
if o1 is O2 { print(o1.msg) } else { print("WRONG-ARM") }

// ROW 3 — a NUMERIC literal set. Ran clean and silently wrong before the ruling.
type N1 = { kind: 0 | 1, r: f64 }
type N2 = { kind: 2 | 3, r: f64 }
function mkN(n: i32): N1 | N2 {
  if n == 0 { return { kind: 0, r: 1.5 } }
  return { kind: 2, r: 2.5 }
}
const na = mkN(0)
print(na is N1)
print(na is N2)
const nb = mkN(1)
print(nb is N1)
print(nb is N2)
if nb is N2 { print(nb.r) }

// ROW 4 — THREE same-shape arms, three disjoint sets: all NINE cells answer by membership.
type T1 = { kind: "a1" | "a2", r: f64 }
type T2 = { kind: "b1" | "b2", r: f64 }
type T3 = { kind: "c1" | "c2", r: f64 }
function mkT(n: i32): T1 | T2 | T3 {
  if n == 0 { return { kind: "a1", r: 1.0 } }
  if n == 1 { return { kind: "b1", r: 2.0 } }
  return { kind: "c1", r: 3.0 }
}
let i = 0
while i < 3 {
  const v = mkT(i)
  print(v is T1)
  print(v is T2)
  print(v is T3)
  i = i + 1
}
