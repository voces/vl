// An `is` over a record field holding a `Rec | i32 | null` box, tested at its storage: the field's
// own `U | null` box, by tag. A parameter's field, a local's, one written first, a nested field,
// a walk variable's and a module global's.
type Rec = { x: i32 }
type H = { h: Rec | i32 | null }
function param(o: H) {
  if o.h is Rec { print(o.h.x) }
  else if o.h is i32 { print(o.h) }
  else { print("none") }
}
function local(k: i32) {
  const o: H = { h: if k == 0 { { x: 4 } } else if k == 1 { 5 } else { null } }
  if o.h is i32 { print(o.h + 1) }
  else if o.h is Rec { print(o.h.x + 1) }
  else { print("none") }
}
function written(k: i32) {
  const o: H = { h: null }
  if k > 0 { o.h = k }
  if o.h is i32 { print(o.h * 2) } else { print("none") }
}
function nested(o: { inner: H }) {
  if o.inner.h is Rec { print(o.inner.h.x) } else { print("other") }
}
function counted(xs: H[]) {
  let c = 0
  for o in xs {
    if o.h is Rec { c = c + 10 }
    else if o.h is i32 { c = c + 1 }
  }
  print(c)
}
param({ h: { x: 1 } }) // 1
param({ h: 2 }) // 2
param({ h: null }) // none
local(0) // 5
local(1) // 6
local(2) // none
written(3) // 6
written(0) // none
nested({ inner: { h: { x: 6 } } }) // 6
nested({ inner: { h: 7 } }) // other
counted([{ h: { x: 1 } }, { h: 2 }, { h: null }]) // 11
const go: H = { h: 8 }
if go.h is i32 {
  print(go.h) // 8
}
