// @check
// @error expected i64 | null, got i64 | IoError
// A bare block that exits only CONDITIONALLY does not narrow the code after the guard: `k`
// may be 0, the block then falls through with `x` still an `IoError`, and the tail returns it.
// The sound twin of post-guard-exit-through-bare-block.vl (D1970).
type IoError = { msg: string }
function f(x: i64 | IoError, k: i32): i64 | null {
  if x is IoError {
    {
      if k > 0 { return null }
    }
  }
  x
}
print(f(3 as i64, 1))
