// @run
// A value `if` joined at a record's row, its arm a union narrowed to the record, compared with a
// record as that record, field by field, at each compare position: the box holds a `P` whose `x`
// differs from `v`'s and one whose `x` matches, so a compare that read the wrong value shows.
type P = { x: i32 }
type Q = { y: string }
type A = { k: "a", x: i32 }
type B = { k: "b", w: i32 }
type S = A | B
function right(u: P | Q, v: P) { return v == (if u is P { u } else { v }) }
function left(u: P | Q, v: P) { return (if u is P { u } else { v }) == v }
function notEq(u: P | Q, v: P) { return v != (if u is P { u } else { v }) }
function nullable(u: P | Q, v: P | null) {
  return v == (if u is P { u } else { null })
}
function nulLeft(u: P | Q, v: P | null) {
  return (if u is P { u } else { null }) == v
}
function both(u: P | Q, w: P | Q, v: P) {
  return (if u is P { u } else { v }) == (if w is P { w } else { v })
}
function litElse(u: P | Q, v: P) {
  return v == (if u is P { u } else { { x: 9 } })
}
function arm(u: S, d: A) { return d == (if u is A { u } else { d }) }
const one: P = { x: 1 }
const two: P | Q = { x: 2 }
const same: P | Q = { x: 1 }
const q: P | Q = { y: "q" }
print(right(two, one))
print(right(same, one))
print(left(two, one))
print(left(same, one))
print(notEq(two, one))
print(notEq(same, one))
print(nullable(two, one))
print(nullable(q, null))
print(nulLeft(same, one))
print(nulLeft(q, one))
print(both(two, same, one))
print(both(same, q, one))
print(litElse(q, { x: 9 }))
print(litElse(two, { x: 9 }))
print(arm({ k: "a", x: 2 }, { k: "a", x: 1 }))
print(arm({ k: "a", x: 1 }, { k: "a", x: 1 }))
print(arm({ k: "b", w: 5 }, { k: "a", x: 1 }))
const top: P | Q = { x: 4 }
const v4: P = { x: 4 }
print(v4 == (if top is P { top } else { v4 }))
// @log false
