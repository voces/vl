// @run
// @log 1
// AN UN-ANNOTATED ARRAY LITERAL OF UNION ELEMENTS COMPILES, AND THE ELEMENT IS A UNION.
//
// `const xs = [pick(true)]` is an un-annotated literal whose ELEMENT is a union.
// `arrLitIsRef` classifies a literal by the SYNTAX of its first element — an `ObjLit`, a
// lambda, a nested literal, or a checker-recorded element name carrying `=>` — and a CALL is
// none of those, so the literal fell through to the i32 list and the union box stored into it
// was `expected i32, found (ref $type)`. The checker's `nodeArrayElemName` had arms for prim /
// obj / func / nullable-closure elements and none for a union, so there was no signal to read
// even if the classifier had asked. It has one now (`arrLitUnionElemName` is where the three
// classifiers share it), and the literal builds the same kind-2 box slot the ANNOTATED
// `(Cat | Dog)[]` spelling interns.
//
// THE RETURN HERE IS UN-ANNOTATED, WHICH IS THE SECOND HALF. An inferred struct union's
// members are the object literals' OWN arena entries, so `tyToNominalName` — whose nominal
// short-circuit keys on arena-index IDENTITY — spells it `{meow:i32}|{woof:i32}`, and no
// union ROW carries that spelling: the emitter registers an inferred return under the
// reverse-mapped composite. `nodeArrayElemName` asks that same producer
// (`structUnionRetName`, bidirectional assignability) where the render has no nominal route,
// and only there — asking it FIRST spells a declared alias by its MEMBERS (`Cat|Dog` for
// `type U = Cat | Dog`, whose row is `U`) and read 20 position-grid cells DOWN.
//
// The `is` is the INLINE SHAPE deliberately: this file was minted to pin the DIAGNOSTIC that
// stood in for the missing capability — a loud reject where the compiler wrote a silently
// invalid module. A reject is what a compiler owes a program it cannot lower; this program is
// lowerable, so the pin is the RUN. Both `is` spellings still agree — see
// `functions/inferred-union-one-row.vl`.
type Cat = { meow: i32 }
type Dog = { woof: i32 }

function pick(c: boolean) {
  if c {
    return { meow: 1 }
  }
  return { woof: 2 }
}

function subject() {
  const xs = [pick(true)]
  const a = xs[0]
  if a is {meow: i32} {
    print(a.meow)
  }
}

subject()
