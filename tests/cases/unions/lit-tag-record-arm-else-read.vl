// @run
// @log 10
// D14540: a narrowed `{k: "b", n: i32}` read finds its arm, since one literal is one type.
type P = { k: "a", n: f64 } | { k: "b", n: i32 }
function mk(b: boolean): P {
  if b { return { k: "b", n: 9 } }
  { k: "a", n: 1.5 }
}
const p = mk(true)
if p.k == "a" { print(p.n) } else { print(p.n + 1) }
