// @run
// @log 1
// @log 1
// @log 1
// @hint redundant type annotation: `a` is inferred as `{r: i32}[]` — remove it to lean on inference
// A read-only covariant list returned and handed straight to a parameter (D1659).
//
// `take(hand(b))` is legal: nothing writes either list and the converting copy cannot be
// observed. The call result is delivered under no name, so the closure had nowhere to root
// and answered unknown while `other`'s unrelated write disqualified the element row. The
// parameter the result reaches is that name, and `take` reading it is what the write scan
// then sees. Its writing twin is the refusal this must not lose.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq

function hand(xs: Shape[]): Shape[] { xs }

function take(ys: Shape[]) { print(ys.length) }

function f() {
  const a: Circle[] = [{ r: 7 }]
  const b: Shape[] = a
  take(hand(b))
  print(a.length)
}

function other() {
  const w: Shape[] = []
  w.push({ s: 3 })
  print(w.length)
}

f()
other()
