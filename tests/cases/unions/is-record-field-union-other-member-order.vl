// @log true
// `is` against a record whose field union names the receiver's member in another order tests that
// member, at a binding, an alias, a parameter, a three-member union, the narrowing form, a generic
// body and a hole parameter (D2781).
type P = { a: i32 | string }
const r: { a: string | i32 } = { a: 1 }
const w: { a: string | i32 } | string = r
print(w is { a: i32 | string })
print(w is P)
const s: { a: string | i32 } | string = "x"
print(s is { a: i32 | string })
function f(v: { a: string | i32 } | string) { v is { a: i32 | string } }
print(f({ a: 1 }))
print(f("s"))
const t: { a: string | i32 | boolean } | string = { a: true }
print(t is { a: boolean | i32 | string })
const n: { a: string | i32 } | string = { a: 7 }
if n is { a: i32 | string } { print(n.a) }
function g<T>(v: { a: T } | string) { v is { a: i32 | string } }
print(g(r))
function h(v) { v is { a: i32 | string } }
print(h(w))
print(w is { a: string | i32 })
type A = { a: string | i32 }
type B = { b: boolean }
const u: A | B | string = { b: true }
print(u is { a: i32 | string })
print(u is B)
