// @run
// @log b
// @log 1
// @log a
// @log none
// `is` naming a union alias of records narrows that alias's nullable, at a binding, a list
// element and an annotated parameter (D5242).
type N = { tag: "a", v: i32 } | { tag: "b", w: i32 }
function f(q: N | null) {
  if q is N { return q.tag }
  "none"
}
const y: N = { tag: "b", w: 2 }
const q: N | null = y
if q is N { print(q.tag) }
const xs: (N | null)[] = [null, { tag: "a", v: 1 }]
const e = xs[1]
if e is N {
  if e is { tag: "a", v: i32 } { print(e.v) }
}
print(f({ tag: "a", v: 3 }))
print(f(null))
