// `x as! T` — THE TRAPPING MEMBER of the ruled `as` trio (`error-handling-design.md` §Trio):
// `as` propagates · `as?` coalesces to null · `as!` TRAPS. Its stated use is "a miss is a bug;
// or there is no caller (`main`)".
//
// The happy-path TYPE is identical to `as`'s — `x as T` and `x as! T` both yield a `T` when
// `x` is a `T` — so they share one node, one checker arm and one lowering. They differ in
// exactly one place: the SAD path. `as` hands the whole box to the caller with a `return`;
// `as!` emits `unreachable` and needs no value at all.
//
// AND IN ONE CHECKER RULE. `as` requires the propagated REMAINDER to fit the enclosing return,
// because that is where it goes. `as!` propagates nothing, so the enclosing return is not
// consulted — which is what makes it the form for a `main` with no caller, and the reason it
// can appear in a function returning a plain `string` where `as` cannot.
//
// THE SUFFIX IS READ RIGHT AFTER THE KEYWORD, before the type, so the happy-path grammar is
// the same in all three. `as !T` — a cast to a NEGATION type — tokenizes identically to
// `as! T` and is read as the trap form. That is not a collision worth a lookahead: a negation
// names "anything but T", which is not a type a value can be cast INTO, and the checker
// rejects it either way, whereas `as!` is a ruled spelling with a stated purpose.
// @run
// The return annotations below are the DEMONSTRATION, not ceremony: each names a plain
// non-union return that `as` could not appear in, because its remainder does not fit. That
// inference reaches the same types is itself the point — `as!` propagates nothing, so it
// constrains the enclosing signature not at all.
// @hint redundant type annotation: `head` is inferred as `string`
// @hint redundant type annotation: `radiusOf` is inferred as `f64`
// @hint redundant type annotation: `areaOf` is inferred as `f64`
// @log hel
// @log 3
// @log 9

type IoError = { code: i32, msg: string }
function readIt(p: string): string | IoError {
  if p == "" { return { code: 44, msg: "missing" } }
  return "hello"
}

// a VALUE-atom arm, in a function returning a plain `string` — which `as` could not do, since
// its remainder (`IoError`) does not fit that return
function head(p: string): string {
  const s = readIt(p) as! string
  return s.slice(0, 3)
}
print(head("f"))                       // hel

// a STRUCT arm
type Circle     = { kind: "circle", r: f64 }
type ParseError = { why: string }
function mk(a: f64): Circle | ParseError {
  if a <= 0.0 { return { why: "bad" } }
  return { kind: "circle", r: a }
}
function radiusOf(a: f64): f64 {
  const c = mk(a) as! Circle
  return c.r
}
print(radiusOf(3.0))                   // 3

// a SUB-UNION arm
type Rect   = { kind: "rect", w: f64, h: f64 }
type Shape  = Circle | Rect
type Parsed = Circle | Rect | ParseError
function area(s: Shape) {
  if s.kind == "circle" { return 3.14159 * s.r * s.r }
  return s.w * s.h
}
function parse(t: string, n: f64): Parsed {
  if t == "rect" { return { kind: "rect", w: n, h: n } }
  return { why: "unknown" }
}
function areaOf(t: string, n: f64): f64 {
  const s = parse(t, n) as! Shape
  return area(s)
}
print(areaOf("rect", 3.0))             // 9
