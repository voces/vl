// @run
// @log false
// @log true
// @log false
// @log false
// @log true
// @log false
// `x is S[]` for a string literal set `S` over `i32[] | string[]`: the `i32[]` arm shares `S[]`'s
// tag only because both store `i32` lists, and never fits; the `string[]` arm fits by its strings
// (D17052).
type S = "a" | "b"
function mk(n: i32): i32[] | string[] {
  if n == 0 { return [3] }
  if n == 1 { return ["b", "a"] }
  if n == 2 { return [99] }
  if n == 3 { return ["q"] }
  return ["a"]
}
function isS(x: i32[] | string[]) { return x is S[] }
print(isS(mk(0)))
print(isS(mk(1)))
print(isS(mk(2)))
print(isS(mk(3)))
print(isS(mk(4)))
const g = mk(0)
print(g is S[])
