// @run
// @log 41
// @log 3
// @log 8
// @log 5
// @log 41
// A lambda returning a fresh `Map()` where the function type's result unions a map with
// records: the map is built at the union's map arm, inline or through an alias of the records.
type Circle = { r: i32 }
type Sq = { s: i32 }
type K = Circle | Sq
function f(h: () => ({[string]: i32} | Circle)) {
  const v = h()
  if v is Circle { return v.r }
  v["a"] = 41
  v["a"] ?? -1
}
function g(h: () => ({[string]: i32} | K)) {
  const v = h()
  if v is Circle { return v.r }
  if v is Sq { return v.s }
  v["b"] = 7
  v.length + (v["b"] ?? -1)
}
print(f(() => Map()))
print(f(() => ({ r: 3 })))
print(g(() => Map()))
print(g(() => ({ s: 5 })))
const h1: () => ({[string]: i32} | Circle) = () => Map()
print(f(h1))
