// @run
// @log 3.5
// @log 3.5
// @log 3.5
// @log u3.5
// @log 3.5
// @log 3.5
// @log 3.5
// @log 3.5
// @log -1
// @log 3.5
// @log 3.5
// @log 1
// @log 1
// @log 1
// @log u1
// @log 1
// @log 1
// @log 1
// @log 1
// @log -1
// @log 1
// @log 1
// A value boxed into a nullable whose own nodes hold a `??` below an earlier operand (a binary's
// left lead staged above the box's head) is written under that head whole: the lead, the `??`,
// the operator, then the box. Q58 positions; "x" misses the parse and takes the default.
import { parseF64 } from "std:fmt"

function show(v: f64 | null) { return v ?? -1.0 }
function takeU(v: f64 | null | string): string {
  if v is string { return v } else { return "u\{v ?? -1.0}" }
}
function wrap(v: f64 | null) { return show(v) }
type Rec = { a: f64 | null }

function asg(s: string) {
  let cpu: f64 | null = null
  cpu = 1.0 + (parseF64(s) ?? 0.0)
  return show(cpu)
}
function both(s: string, t: string) {
  let cpu: f64 | null = null
  cpu = (parseF64(s) ?? 0.0) + (parseF64(t) ?? 0.0)
  return show(cpu)
}
function arg(s: string) { return show(1.0 + (parseF64(s) ?? 0.0)) }
function argU(s: string) { return takeU(1.0 + (parseF64(s) ?? 0.0)) }
function nested(s: string) { return wrap(1.0 + (parseF64(s) ?? 0.0)) }
function ret(s: string): f64 | null { return 1.0 + (parseF64(s) ?? 0.0) }
function bound(s: string) {
  const x: f64 | null = 1.0 + (parseF64(s) ?? 0.0)
  return show(x)
}
function arm(s: string, c: boolean) {
  const y = if c { 1.0 + (parseF64(s) ?? 0.0) } else { null }
  return show(y)
}
function coal(s: string, q: f64 | null) {
  return show(q ?? (1.0 + (parseF64(s) ?? 0.0)))
}
function field(s: string) {
  const r: Rec = { a: 1.0 + (parseF64(s) ?? 0.0) }
  return show(r.a)
}

for s in ["2.5", "x"] {
  print(asg(s))
  print(both(s, "1"))
  print(arg(s))
  print(argU(s))
  print(nested(s))
  print(show(ret(s)))
  print(bound(s))
  print(arm(s, true))
  print(arm(s, false))
  print(coal(s, null))
  print(field(s))
}
