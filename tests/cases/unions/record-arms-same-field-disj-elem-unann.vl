// @run
// @log A i3
// @log B no
// @log A no
// @log B s:b
// @hint redundant type annotation: `toS` is inferred as `string` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// Record arms sharing a field name (D4056): disjoint arms read out of an un-annotated list element.
// `is` tests whether the value fits, field by field.
import { toString } from "std:fmt"

type A = { n: i32 }
type B = { n: string }
function pick(i: i32): A | B {
  if i == 0 {
    const a: A = { n: 3 }
    return a
  }
  const b: B = { n: "b" }
  b
}
function toS(x: i32 | string): string {
  if x is i32 { return "i" + toString(x) }
  "s:" + x
}
function f(i: i32) {
  const xs = [pick(i)]
  if xs[0] is A {
    const got: i32 | string = xs[0].n
    print("A " + toS(got))
  } else {
    print("A no")
  }
  if xs[0] is B {
    const got: i32 | string = xs[0].n
    print("B " + toS(got))
  } else {
    print("B no")
  }
}
f(0)
f(1)
