// @run
// @log true false | true false | true false
// @log false true | false true | false true
// @log true false | true false
// @log false true | false true
// @log true false | true false
// @log false true | false true
// @log true false | true false
// @log false true | false true
// A scalar-nullable first operand (`i32 | null`, `f64 | null`, `string | null`,
// `boolean | null`) joined by `??` to a record, or to a join of one record, types as the box:
// no record row answers for its value, so `is` reads the tag rather than folding to the
// default's row (D2373).

type A = { r: i32 }
function mkA(n: i32): A | null {
  if n == 0 { return null }
  return { r: 1 }
}
function stA(): A { return { r: 5 } }
function mkI(n: i32): i32 | null {
  if n == 0 { return null }
  return 4
}
function mkF(n: i32): f64 | null {
  if n == 0 { return null }
  return 2.5
}
function mkS(n: i32): string | null {
  if n == 0 { return null }
  return "s"
}
function mkT(n: i32): boolean | null {
  if n == 0 { return null }
  return true
}

function viaI32(k: i32) {
  const x = mkI(k) ?? stA()
  print(
    "\{(mkI(k) ?? stA()) is i32} \{(mkI(k) ?? stA()) is A} | \{x is i32} \{x is A} | \{(mkI(k) ?? (mkA(0) ?? mkA(1))) is i32} \{(mkI(k) ?? (mkA(0) ?? mkA(1))) is A}",
  )
}
viaI32(1)
viaI32(0)

function viaF64(k: i32) {
  const x = mkF(k) ?? stA()
  print(
    "\{(mkF(k) ?? stA()) is f64} \{(mkF(k) ?? stA()) is A} | \{x is f64} \{x is A}",
  )
}
viaF64(1)
viaF64(0)

function viaString(k: i32) {
  const x = mkS(k) ?? stA()
  print(
    "\{(mkS(k) ?? stA()) is string} \{(mkS(k) ?? stA()) is A} | \{x is string} \{x is A}",
  )
}
viaString(1)
viaString(0)

function viaBoolean(k: i32) {
  const x = mkT(k) ?? (mkA(0) ?? mkA(1))
  print(
    "\{(mkT(k) ?? (mkA(0) ?? mkA(1))) is boolean} \{(mkT(k) ?? (mkA(0) ?? mkA(1))) is A} | \{x is boolean} \{x is A}",
  )
}
viaBoolean(1)
viaBoolean(0)
