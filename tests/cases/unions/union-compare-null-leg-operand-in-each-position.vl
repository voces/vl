// @run
// @log true
// @log true
// @log false
// @log ne
// @log 2
// @log false
// @log true
// @log false
// @log true
// A union compare's null leg against a call's box: a global, field or element operand read after
// the call (which writes it), a `K` operand narrowed past its null, and a `boolean | null` call
// against a null-free box; in a return, an argument, a binding, an `if`, a loop and a `!=`.
type K = "a" | "b"
type U = i32 | K | null
type V = i32 | boolean
type O = { k: K | null }
let g: K | null = null
const o: O = { k: null }
const xs: (K | null)[] = [null]
let gb: boolean | null = null
function setG(k: K | null, r: U): U {
  g = k
  return r
}
function setO(k: K | null, r: U): U {
  o.k = k
  return r
}
function setX(k: K | null, r: U): U {
  xs[0] = k
  return r
}
function cb(): boolean | null { return gb }
function show(b: boolean) { print(b) }
function ret() { return setG("a", "a") == g }
function arg() { show(setO("b", "b") == o.k) }
function bind() {
  const t = setX(null, null) != xs[0]
  print(t)
}
function cond() {
  if setG("b", "a") == g { print("eq") } else { print("ne") }
}
function loop() {
  let n = 0
  for k in ["a", "b"] {
    const r: U = if k == "a" { "a" } else { 1 }
    if setG(null, r) != g { n = n + 1 }
  }
  return n
}
function narrowed() {
  o.k = "b"
  return o.k != setO(null, "b")
}
function nullFree(u: V) { return u == cb() }
print(ret())
arg()
bind()
cond()
print(loop())
print(narrowed())
gb = true
print(nullFree(true))
gb = null
print(nullFree(false))
print(setG("a", "a") == g)
