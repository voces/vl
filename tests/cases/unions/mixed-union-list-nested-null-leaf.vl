// @run
// A list literal of a record and a string delivered into `(Holder | string)[]` boxes each
// element into the destination's union, so a nested `null` leaf takes the declared field (D4635).
type Holder = { h: { x: i32 | null } }
const xs: (Holder | string)[] = [{ h: { x: null } }, "t"]
print(xs.length)
const a = xs[0]
if a is Holder { print(a.h.x == null) }
const ys: (Holder | string)[] = [{ h: { x: 3 } }, "t"]
const b = ys[0]
if b is Holder { print(b.h.x == null) }
if b is Holder { print(b.h.x ?? 7) }
function mk(): (Holder | string)[] { return [{ h: { x: null } }, "u"] }
const c = mk()[1]
if c is string { print(c) }
// @log 2
// @log true
// @log false
// @log 3
// @log u
