// @run
// @log P f T f | f T f
// @log F f T f | f T f
// @log P f f T | f f T
// @log F f f T | f f T
// @log P f f f | f f f
// @log F f f f | f f f
// @hint redundant type annotation: `retP` is inferred as `boolean`
// @hint redundant type annotation: `retF` is inferred as `boolean`
// A `boolean | null` operand compared with an `i32 | boolean` box that has no `null` arm, at
// each value position: null never equals a bool, and each bool equals only itself.
type UB = i32 | boolean
type H = { b: boolean | null }
type R = { ok: boolean }
function takeB(b: boolean) { return b }
function takeU(x: boolean | i32) { return x is boolean && x }
function id(b: boolean) { return b }
function argP(u: UB, k: boolean | null) { return takeB(u == k) }
function unionArgP(u: UB, k: boolean | null) { return takeU(u == k) }
function nestedP(u: UB, k: boolean | null) { return takeB(id(u == k)) }
function holeP(u: UB, k: boolean | null) { return "\{u == k}" == "true" }
function retP(u: UB, k: boolean | null): boolean { return u == k }
function letP(u: UB, k: boolean | null) {
  const b = u == k
  return b
}
function armP(u: UB, k: boolean | null, c: boolean) {
  return if c { u == k } else { false }
}
function coalP(u: UB, k: boolean | null, nb: boolean | null) {
  return nb ?? (u == k)
}
function fieldP(u: UB, k: boolean | null) {
  const r: R = { ok: u == k }
  return r.ok
}
function argF(u: UB, h: H) { return takeB(u == h.b) }
function unionArgF(u: UB, h: H) { return takeU(h.b == u) }
function nestedF(u: UB, h: H) { return takeB(id(u == h.b)) }
function holeF(u: UB, h: H) { return "\{u == h.b}" == "true" }
function retF(u: UB, h: H): boolean { return u == h.b }
function letF(u: UB, h: H) {
  const b = h.b == u
  return b
}
function armF(u: UB, h: H, c: boolean) {
  return if c { u == h.b } else { false }
}
function coalF(u: UB, h: H, nb: boolean | null) { return nb ?? (u == h.b) }
function fieldF(u: UB, h: H) {
  const r: R = { ok: u == h.b }
  return r.ok
}
function c(b: boolean) { return if b { "T" } else { "f" } }
// Each line: the operand null, true, false at the first eight positions agreeing, then `|`, the
// record field position's three.
function lineP(u: UB) {
  const ks: (boolean | null)[] = [null, true, false]
  let s = "P"
  for k in ks {
    const all = argP(u, k)
    const agree = all == unionArgP(u, k)
      && all == nestedP(u, k)
      && all == holeP(u, k)
      && all == retP(u, k)
      && all == letP(u, k)
      && all == armP(u, k, true)
      && all == coalP(u, k, null)
    s = s + " " + (if agree { c(all) } else { "?" })
  }
  s = s + " |"
  for k in ks { s = s + " " + c(fieldP(u, k)) }
  print(s)
}
function lineF(u: UB) {
  const hs: H[] = [{ b: null }, { b: true }, { b: false }]
  let s = "F"
  for h in hs {
    const all = argF(u, h)
    const agree = all == unionArgF(u, h)
      && all == nestedF(u, h)
      && all == holeF(u, h)
      && all == retF(u, h)
      && all == letF(u, h)
      && all == armF(u, h, true)
      && all == coalF(u, h, null)
    s = s + " " + (if agree { c(all) } else { "?" })
  }
  s = s + " |"
  for h in hs { s = s + " " + c(fieldF(u, h)) }
  print(s)
}
lineP(true)
lineF(true)
lineP(false)
lineF(false)
lineP(1)
lineF(1)
