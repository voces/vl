// @run
// A null test of a hole parameter's field folds when the pin proves the field non-null, in
// either operand order, through a local, and one record further in (D4637).
function direct(v) { print(v.q == null) }
function flipped(v) { print(null == v.q) }
function guarded(v) {
  if v.q != null { print("y") } else { print("n") }
}
function nested(v) { print(v.a.q == null) }
function viaLocal(v) {
  const w = v.q
  print(w == null)
}
type R = { q: i32 }
direct({ q: 4 })
flipped({ q: 4 })
guarded({ q: "s" })
nested({ a: { q: 4 } })
viaLocal({ q: 4 })
const r: R = { q: 1 }
direct(r)
// @log false
// @log false
// @log y
// @log false
// @log false
// @log false
