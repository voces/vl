// @run
// @log 7
// @log -1
// A record parameter whose field is a union of two generic record applications boxes the field
// as that union's row; each arm reads by its own shape (D3938).
type P<T> = { p: T }
type Q<T> = { q: T, r: T }
function g(e: { v: P<i32> | Q<i32> }) {
  const w = e.v
  if w is Q<i32> { return w.q + w.r }
  -1
}
print(g({ v: { q: 3, r: 4 } }))
print(g({ v: { p: 9 } }))
