// @run
// @log true true true true
// @log false false false false
// @log false false false false
// @log false false false false
// A same-record join nested in a record join stays its record's niche, and boxing it tests it
// for null: with every operand null the whole join is the box's null, never an arm with a
// null payload. Right-nested, as a value `if` arm and left-nested (D2373).

type A = { r: i32 }
type B = { q: string }
function mkA(n: i32): A | null {
  if n == 0 { return null }
  return { r: n }
}
function mkB(n: i32): B | null {
  if n == 0 { return null }
  return { q: "b" }
}

function go(p: i32, q: i32, s: i32, f: boolean) {
  const x = mkB(p) ?? (mkA(q) ?? mkA(s))
  const y = mkA(p) ?? (mkB(q) ?? mkB(s))
  const z = if f { mkA(q) ?? mkA(s) } else { mkB(p) }
  const w = (mkA(q) ?? mkB(p)) ?? mkA(s)
  print("\{x == null} \{y == null} \{z == null} \{w == null}")
}
go(0, 0, 0, true)
go(3, 0, 3, true)
go(0, 3, 0, true)
go(3, 3, 3, true)
