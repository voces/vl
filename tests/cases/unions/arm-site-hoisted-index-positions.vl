// @run
// @log 9
// @log 3.5
// @log 109
// @log 1.75
// @log wq
// @log v=9
// @log 3.5
// @log 9
// @log 9
// @log -1
// @log -1
// @log 3
// @log 4.5
// Q58 position sweep (Q57): an arm-site element read whose index calls and writes nothing, built
// once ahead of the tag chain, delivered as a scalar and a union call argument, a nested call
// argument, a concat operand, an interpolation hole, a return, a let initializer, an if arm value,
// a `??` operand and a record-literal field.
function mkS(k: i32): i32[] | f64[] {
  if k == 0 { return [1.5, 2.5, 3.5] }
  const a = [4, 7, 9]
  return a
}
type K = "a" | "b"
function mkW(k: i32): K[] | string[] {
  if k == 0 {
    const n: K[] = ["a", "b"]
    return n
  }
  const s = ["p", "q"]
  return s
}
function mkN(k: i32): (i32 | null)[] | (f64 | null)[] {
  if k == 0 {
    const n: (f64 | null)[] = [1.5, null]
    return n
  }
  const m: (i32 | null)[] = [null, 3]
  return m
}
function takeF(x: f64) { print(x) }
function takeU(x: f64 | string) {
  if x is string { print("s") } else { print(x + 100.0) }
}
function half(x: f64) { return x / 2.0 }
function argScalar(a) { takeF(a[a.length - 1] + 0.0) }
function argUnion(a) { takeU(a[a.length - 1] + 0.0) }
function argNested(a) { takeF(half(a[a.length - 1] + 0.0)) }
function concat(w) { print("w" + w[w.length - 1]) }
function interp(a) { print("v=\{a[a.length - 1]}") }
function ret(a) { return a[a.length - 1] }
function letInit(a) {
  const n = a[a.length - 1]
  print(n)
}
function ifArm(a, c: boolean) {
  const k = if c { a[a.length - 1] + 0.0 } else { -1.0 }
  print(k)
}
function coal(n) { print(n[n.length - 1] ?? -1) }
function rec(a) {
  const r = { n: a[a.length - 1] + 0.0, t: 1.0 }
  print(r.n + r.t)
}
argScalar(mkS(1))
argScalar(mkS(0))
argUnion(mkS(1))
argNested(mkS(0))
concat(mkW(1))
interp(mkS(1))
print(ret(mkS(0)))
letInit(mkS(1))
ifArm(mkS(1), true)
ifArm(mkS(0), false)
coal(mkN(0))
coal(mkN(1))
rec(mkS(0))
