// @run
// @log 2
// @log 2
// @log 2
// @log 1
// @log 20
// @log 2
// A list literal of anonymous records with different fields, its type inferred (D14220). The
// literal's union is registered, so it builds at that union's box rather than the caller's pair.
print([{ a: 1 }, { b: 2 }].length)

const xs = [{ a: 1 }, { b: 2 }]
const e = xs[1]
if e is { b: i32 } { print(e.b) }

function f() { return [{ a: 1 }, { b: 2 }].length }
print(f())

const lv1 = [{ r: { c2: 1 } }, { r: { s2: 2 } }]
for x in lv1 {
  const v = x.r
  if v is { c2: i32 } { print(v.c2) } else { print(v.s2 * 10) }
}
print(lv1.length)
