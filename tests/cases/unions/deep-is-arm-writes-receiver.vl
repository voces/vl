// @run
// @log 3
// @log 32
// @log 7
// @log a
// @log 1
// @log 102
// @warning `r` shadows the `r` declared at 32:12 in this function; rename one if they are different values
// A deep `is` arm reads the converted copy up to the statement that writes or rebinds the
// tested place: the write's own value still reads it, an `if` arm ends it at its own write,
// and the reads after it see the declared type (D1190).
type Json = null | boolean | f64 | string | Json[] | { [string]: Json }
function d(r: Json) {
  if r is string[] {
    const n = r[0].length
    r = null
    return n
  }
  return 0
}
print(d(["xyz"]))
function e(r: Json) {
  if r is string[] {
    const n = r[0].length
    r = ["ab", "c"]
    if r is string[] { return n * 10 + r[0].length }
    return -1
  }
  return 0
}
print(e(["xyz"]))
function f(r: Json) {
  if r is string[] {
    const r = 7
    return r
  }
  return 0
}
print(f(["a"]))
function g(r: Json) {
  if r is string[] {
    const n = r.length
    if n > 0 {
      print(r[0])
      r = null
    }
    return n
  }
  return 0
}
print(g(["a"]))
type R = { j: Json }
function h(o: R) {
  if o.j is string[] {
    const n = o.j[0].length
    o.j = null
    return n + (if o.j == null { 100 } else { 0 })
  }
  return 0
}
print(h({ j: ["xy"] }))
