// @run
// @log 2.5
// @log null
// @log s
// @log true
// @log 2.5
// @log null
// @log true
// @log true
// A union with a nullable member is assignable to a nullable target holding every member, flat
// or nested, alone or as a list element, and as the generic instance `T | f64` at `T = boolean | null`
// builds it (D14656).
const x1: (boolean | null) | f64 = 2.5
const y1: boolean | null | f64 = x1
print(y1)
const x2: (boolean | null) | string = null
const y2: boolean | string | null = x2
print(y2)
const x3: (string | null) | i32 = "s"
const y3: string | i32 | null = x3
print(y3)
const x4: (boolean | null) | f64 = true
const y4: (boolean | f64) | null = x4
print(y4)
const a: ((boolean | null) | f64)[] = [x1, null, true]
const b: (boolean | f64 | null)[] = a
print(b[0])
print(b[1])
print(b[2])
function g<T>(x: T): (T | f64)[] { return [x].map((e): T | f64 => e) }
const tb: boolean | null = true
const r = g(tb)
print(r[0])
