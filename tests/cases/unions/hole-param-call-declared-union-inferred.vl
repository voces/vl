// @run
// @log rect
// @log rect
// D1561's OTHER producer, and the reason the fix is at the type producers rather than at the
// `??`. A HOLE-parameter call (`passh(x)` with no annotation anywhere) delivers the same
// declared struct union into an inferred binding, and the same name-keyed registry scan
// missed it — `nodeUnionName` gates itself to a VALUE union before rendering, so a call
// whose result is a declared STRUCT union reached the Call fallback with no name at all.
//
// The receiver need not be a binding: `passh(mkval()).kind` took the same floor.
type Circle = { kind: "circle", r: f64 }
type Rect = { kind: "rect", w: f64, h: f64 }
type Shape = Circle | Rect
function mkval(): Shape { return { kind: "rect", w: 2.0, h: 3.0 } }
function passh(x) { return x }
function go() {
  const v = passh(mkval())
  print(v.kind)
  print(passh(mkval()).kind)
}
go()
