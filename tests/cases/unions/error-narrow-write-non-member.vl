// @check
// @error cannot assign string to i64 | boolean
// THE WRITE IS STILL CHECKED — against the DECLARATION, which is the whole content of the
// reads-only rule (D1736). `narrow-write-flips-variant.vl` is this program with `true` in
// place of the string: the flip is legal because `boolean` is a member, and this one is
// refused because `string` is not.
//
// The diagnostic names the DECLARED type, not the narrowed one. Naming `i64` here would be
// the old rule's sentence — true of what `x` currently reads as and false of what the place
// accepts, and it sent an author looking for the narrowing rather than at the union.
function f() {
  let x: i64 | boolean = 3
  if x is i64 { x = "s" }
}
f()
