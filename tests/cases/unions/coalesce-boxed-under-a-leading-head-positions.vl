// @log none
// A `??` boxed under a head written ahead of its value: a non-staging arm (an element, a map
// read, an optional leaf) into an atom box, and a nested `??` into a nullable record join's niche
// box, whose stash slot is taken ahead of it. Positions: argument, annotated `let`, return, list
// element, record field and a call's argument inside a nested `??`.
type A = { a: string }
type B = { q: string }
function mkA(n: i32): A | null { return if n == 0 { null } else { { a: "a" } } }
function mkB(n: i32): B | null { return if n == 0 { null } else { { q: "b" } } }
function takeU(v: i32 | f64) { return if v is i32 { "i" } else { "f" } }
function retU(l: (i32 | null)[], k: i32): i32 | f64 { return l[k] ?? 0.5 }
function show(v: A | B | null) { return if v == null { "none" } else if v is A { v.a } else { v.q } }
function atoms() {
  const l: (i32 | null)[] = [null, 4]
  const m: {[string]: i32} = Map()
  m["x"] = 2
  print(takeU(l[1] ?? 0.5))
  print(takeU(l[0] ?? 0.5))
  const u: i32 | f64 = l[0] ?? 1.5
  print(takeU(u))
  print(takeU(retU(l, 1)))
  print(takeU(retU(l, 0)))
  const us: (i32 | f64)[] = [l[1] ?? 2.5, l[0] ?? 2.5]
  print(takeU(us[0]) + takeU(us[1]))
  const r: { v: i32 | f64 } = { v: l[0] ?? 3.5 }
  print(takeU(r.v))
  print(takeU(m["x"] ?? 0.5))
  print(takeU(m["y"] ?? 0.5))
}
atoms()
function viaNiche(p: i32, q: i32, s: i32) {
  const x = mkB(p) ?? (mkA(q) ?? mkA(s))
  print(show(x))
  const y: A | B | null = mkA(p) ?? (mkB(q) ?? mkB(s))
  print(show(y))
  print(show(mkB(p) ?? (mkA(q) ?? mkA(s))))
}
viaNiche(0, 0, 3)
viaNiche(0, 3, 0)
viaNiche(3, 0, 0)
viaNiche(0, 0, 0)
// @hint redundant type annotation: `y`
