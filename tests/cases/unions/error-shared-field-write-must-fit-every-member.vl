// @check
// @error-at 11:31 cannot assign string to `kind` through a union: A stores it as "a" — a write must fit every member, so narrow the receiver first
// @error-at 14:39 cannot assign i32 to `n` through a union: D stores it as 1 | 2 — a write must fit every member, so narrow the receiver first
// @error-at 17:33 `n` is (1 | 2)[] on F and the members' read would join it as i32[]: a container never widens implicitly, so narrow the receiver to one member first
// A read through a union is typed as the members' JOIN, but a write has to fit their MEET:
// every member's field must hold the value (D3562). Each write below fits the join and not
// some member, which the store would otherwise have broken (an `A` whose `kind` is "b").
// A list field the members store differently cannot be read through the union at all,
// the refusal an `if` over the members' reads takes.
type A = { kind: "a", n: i32 }
type B = { kind: "b", n: i32, z: f64 }
export function w1(p: A | B) { p.kind = "b" }
type C = { n: i32, c: string }
type D = { d: f64, n: 1 | 2 }
export function w2(p: C | D, v: i32) { p.n = v }
type E = { n: i32[], e: string }
type F = { f: f64, n: (1 | 2)[] }
export function w3(p: E | F) { p.n.push(5) }
export function fits(p: C | D) { p.n = 1 }
