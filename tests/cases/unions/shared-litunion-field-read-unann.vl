// @run
// @log a
// @log b
// @log a
// @log b
// A literal-union field every arm shares, read through an un-annotated parameter, prints its
// member text, beside an annotated reader and a bound read (D5164).
type M = { k: "a" | "b", v: i32 } | { k: "a" | "b", w: boolean }
function mk(e: boolean): M {
  if e { return { k: "a", w: true } }
  { k: "b", v: 1 }
}
function t(a) {
  const v = a
  print(v.k)
}
function u(m: M) { print(m.k) }
function s(a): string {
  const r: string = a.k
  r
}
t(mk(true))
t(mk(false))
u(mk(true))
print(s(mk(false)))
