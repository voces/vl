// @emit-error object literal is missing a union-variant field
// @hint redundant type annotation: `x` is inferred as `Cat`
// A union-arm literal may leave out a field only when the field admits `null`, which is then
// what it holds. Here the arm annotation on `x` is consumed by the call ARGUMENT, so `{ p: 9 }`
// is built as `Cat` with its `i32` field `c` left out; filling that with `null` emitted a
// module that does not validate (D2302). The refusal is the floor until the hint stops
// reaching the argument, which is `arm-annotation-consumed-by-call-argument.vl`'s gap.
type Cat = { c: i32 }
type Dog = { d: i32 }
type U = Cat | Dog
type P = { p: i32 }
function take(p: P): Cat { { c: p.p } }
const x: Cat = take({ p: 9 })
print(x.c)
