// @run
// @log true
// @log false
// @log true
// @log false
// @log true
// @log false
// @log 4
// @log 6
// A `boolean | null` operand that is no place is read once into its own slot, so its null leg
// runs and the call runs once per compare, with a box that is a call or a parameter (D17065).
type U = i32 | boolean | null
let n = 0
let m = 0
let gu: U = null
let gk: boolean | null = null
function bx(): U {
  n = n + 1
  return gu
}
function ck(): boolean | null {
  m = m + 1
  return gk
}
function byCall() { return bx() == ck() }
function byParam(u: U) { return ck() == u }
print(byCall())
gk = true
print(byCall())
gu = true
print(byCall())
gk = null
print(byCall())
print(byParam(null))
print(byParam(1))
print(n)
print(m)
