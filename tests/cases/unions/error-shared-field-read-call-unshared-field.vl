// @check
// @error field 'w' is not on every member of A | B — narrow with `is` first (no 'w' on A)
// CONTRACT (must-error): making `g(true).v` work must NOT make `g(true).w` work. `w` is on
// `B` only, so the read is unsound on an `A` value and stays a CHECKER reject — the same one
// the binding spelling `const u = g(true); u.w` takes, from the same seam, because the shared
// -field question is asked of the union TYPE and never of how the value was spelled.
//
// The diagnostic now NAMES THE MEMBER that lacks the field. "not on every member of A | B"
// left the reader to diff the arms by hand, which over a four-arm union of inline shapes is
// the whole work of the message; the offending member is a per-member fact this seam already
// has. A refusal that comes from the JOIN instead (`{n: i32} | {n: f64}` — every member HAS
// the field, at reps that do not join) has no single member to name and appends nothing.
type A = { v: i32 }
type B = { v: i32, w: i32 }
function g(flag: boolean): A | B {
  if flag { return { v: 1 } }
  return { v: 2, w: 3 }
}
print(g(false).w)
