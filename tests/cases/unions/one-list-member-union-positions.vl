// A union of lists whose members all spell one list is that list at every position: a
// declared alias in a nullable field, a closure capture, a parameter's un-annotated copy, an
// un-annotated binding of a return, the nullable of the union, and a readonly member
// (D4743, D4744, D4745, D2910).
type K = 0 | 1
type A = i32[] | K[]
type R = { g: A | null }
const a: A = [1]
const r: R = { g: a }
print(r.g == null)
function g() {
  const c: i32[] | K[] = [1, 0, 1]
  const f = () => {
    if c is i32[] { print(c.length) }
  }
  f()
}
g()
function take(p: i32[] | K[]) {
  const v = p
  if v is i32[] { print(v.length) }
}
take([1, 0, 1])
function deliver(): i32[] | K[] { return [1, 0, 1] }
const d = deliver()
if d is i32[] { print(d.length) }
const n: A | null = a
print(n == null)
const m: (i32[] | K[]) | null = [1, 0]
print(m == null)
function k(): K[] | i32[] { return [1, 1, 0] }
const kk = k()
if kk is K[] { print(kk.length) }
function mk(b: boolean): readonly f64[] | f64[] {
  if b {
    const r: readonly f64[] = [1.5]
    return r
  }
  [2.5]
}
print(mk(true)[0])
print(mk(false)[0])
