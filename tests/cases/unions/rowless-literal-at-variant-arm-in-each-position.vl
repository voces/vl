// @run
// @info `cc` is never reassigned; use `const` instead of `let`
// @log -1
// @log 5
// @log 7
// @log -1
// @log 9
// @log -1
// @log 3
// @log -1
// @log -1
// @log -1
// @log -1
// @log 4
// @log -1
// @log -1
// @log -9
// A record literal whose own type has no row, its field coerced into a union arm's row (a `null`
// into `i32 | null`'s box, an `i32` widened to `i64`), at each position the arm is delivered to:
// a binding returned, a direct return, an argument, a list element and a record field; a `let`, a
// reassigned binding, one a lambda captures, and one delivered at a nullable arm.
type Circle = { r: i32 | null }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Wide = { w: i64 }
type Tall = { t: string }
type Form = Wide | Tall
type Hold = { c: Circle }
function rOf(c: Circle) { return if c.r == null { 0 - 1 } else { c.r } }
function rOfN(c: Circle | null) {
  return if c == null { 0 - 9 } else { rOf(c) }
}
function wOf(x: Wide) { return x.w }
function boundNull() {
  const cc = { r: null }
  return cc
}
function boundVal() {
  const cc = { r: 5 }
  return cc
}
function boundWide() {
  const cc = { w: 7 }
  return cc
}
function directNull() { return { r: null } }
function directWide() { return { w: 9 } }
function argNull() { return rOf({ r: null }) }
function argWide() { return wOf({ w: 3 }) }
function listNull() {
  const xs: Circle[] = [{ r: null }]
  return rOf(xs[0])
}
function fieldNull() {
  const h: Hold = { c: { r: null } }
  return rOf(h.c)
}
function letCell() {
  let cc = { r: null }
  return cc
}
function reassigned(k: i32) {
  let cc = { r: null }
  if k > 0 { cc = { r: k } }
  return cc
}
function captured() {
  const cc = { r: null }
  const g = () => cc
  return g()
}
function nullableArm() {
  const cc = { r: null }
  return cc
}
print(rOf(boundNull()))
print(rOf(boundVal()))
print(wOf(boundWide()))
print(rOf(directNull()))
print(wOf(directWide()))
print(argNull())
print(argWide())
print(listNull())
print(fieldNull())
print(rOf(letCell()))
print(rOf(reassigned(0)))
print(rOf(reassigned(4)))
print(rOf(captured()))
print(rOfN(nullableArm()))
print(rOfN(null))
