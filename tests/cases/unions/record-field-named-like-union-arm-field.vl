// A record-valued field named like a scalar field of a union's record arm reads as the record
// (D3461), at scope level, through a local inside a function, and beside two record arms.
const _v: i32 | { a: i32 } = 5
const n = { a: { b: 7 } }
print(n.a.b)
type A = { a: i32 }
function g() {
  const _w: i32 | A = 5
  const m = { a: { a: 7 } }
  const inner = m.a
  print(inner.a)
}
g()
const _x: { a: i32 } | { c: i32 } = { c: 1 }
const p = { a: { b: 7 } }
print(p.a.b)
