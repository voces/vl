// @run
// @log dynx
// @log dynx
// @log a
// A record `{tag: string, v: i32}` built where a union arm `{tag: "a", v: i32}` has a row is
// stored at a row of its own: the arm's row stores `tag` as the atom, so it is not the
// record's row although the two compare equal with the literal softened (D15952).
type N = { tag: "a", v: i32 } | { tag: "b", w: i32 }
const xs: (N | null)[] = [null, { tag: "a", v: 1 }]
const e = xs[1]
if e is N {
  if e is { tag: "a", v: i32 } {
    const s: { tag: string, v: i32 } = { tag: "dyn" + "x", v: e.v }
    print(s.tag)
    const t: { tag: string, v: i32 }[] = [s, { tag: e.tag, v: 2 }]
    for z in t { print(z.tag) }
  }
}
