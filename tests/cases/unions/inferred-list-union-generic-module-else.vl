// @run
// @log 1
// @log 6
// @log 1
// @log 2
// The module-scope `else` of an `is` over a generic instance's returned `T[] | i32[]`, at
// two instances, a `let` and a read of the complement arm (D5119).
function w<T>(t: T, b: boolean) {
  if b { return [t] }
  [1, 2, 3]
}
function rest<T>(t: T, b: boolean) {
  const u = w(t, b)
  if u is T[] { return w(t, false) } else { return u }
}
const v = rest("s", false)
if v is i32[] { print(1) } else { print(9) }
if v is string[] { print(v[0]) } else { print(v.length + v[2]) }
let m = rest("q", false)
m = rest("q", true)
if m is i32[] { print(m[0]) } else { print(m.length) }
const k = rest(7, false)
if k is i32[] { print(k[1]) } else { print(0) }
