// @error match pattern `{[i32]:i32}` is not a JSON shape — `{[i32]: i32}` has a non-string map key; a JSON object's keys are strings
// A `match` type-pattern arm refuses a target with no JSON shape as `is` does, naming the part of
// it that has none (D16478).
type Json = null | boolean | f64 | string | Json[] | { [string]: Json }
function f(g: Json): i32 {
  return match g {
    {[i32]: i32} => 1
    _ => 0
  }
}
print(f(null))
