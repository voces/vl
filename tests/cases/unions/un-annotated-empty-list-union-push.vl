// @run
// @log 3
// @log ok
// AN EMPTY `[]` WHOSE ELEMENT A LATER `.push` PINS TO A UNION.
//
// This one is a THIRD producer, not a third spelling of the same one. `arrLitIsRef` declines an
// empty literal by construction — it has no element to classify, which its own header records
// as the case the binding annotation is supposed to cover. The annotation here is SYNTHESIZED:
// `collectLocals` reads the checker's recorded element type off the binding and writes the
// equivalent `<elem>[]` type for it. Two things had to hold for that to reach a union.
//
// THE SYNTHESIZED ARRAY NAME HAS TO RE-GROUP. `Cat|Dog` + `[]` is `Cat|Dog[]`, which binds the
// `[]` to the last member and is a different type; the annotation the source would have written
// is `(Cat | Dog)[]`. Same rule, same test as `rlCanonLitUnionAtoms`'s array descent and
// `ensureRefElemTy`'s paren branch — the array grammar's one re-wrap, asked wherever a name is
// re-formed.
//
// AND THE SLOT HAS TO EXIST BEFORE THAT SYNTHESIS RUNS. The synthesis postdates `collectA`, so
// it can only RESOLVE a ref-list row, never mint one — a spelling with no row stays uncovered
// and the binding falls back to the i32-list default, which is the same silently invalid module
// by a different route. `collectA` interns the row from the same query, on the empty literal
// itself.
type Cat = { meow: i32 }
type Dog = { woof: i32 }

function pick(b: boolean): Cat | Dog {
  if b {
    return { meow: 3 }
  }
  return { woof: 4 }
}

function pickVal(b: boolean): i32 | string {
  if b {
    return 5
  }
  return "ok"
}

function structUnionPush() {
  const xs = []
  xs.push(pick(true))
  const e = xs[0]
  if e is Cat {
    print(e.meow)
  }
}

function valueUnionPush() {
  const vs = []
  vs.push(pickVal(false))
  const v = vs[0]
  if v is string {
    print(v)
  }
}

structUnionPush()
valueUnionPush()
