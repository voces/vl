// @run
// @log 7
// @log 1
// @log 1
// @hint redundant type annotation: `a` is inferred as `{r: i32}[]` — remove it to lean on inference
// A read-only covariant list inside a container that is never bound to a name (D1682).
//
// `{ xs: v }` initialises no binding, so the escape had no owner to be filed under and the
// delivery was declined. A returned literal is reached through the CALL RESULT instead: the
// containers are the destinations every call of `mk` delivers to, and `sf.xs` is a handle on
// them exactly as it is on a literal bound in place. Delete `other` and this ran either way,
// which is what makes the unnameable container the ingredient.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box = { xs: Shape[] }

function mk(v: Shape[]): Box { { xs: v } }

function f() {
  const a: Circle[] = [{ r: 7 }]
  const b: Shape[] = a
  const sf = mk(b)
  const e = sf.xs[0]
  if e is Circle { print(e.r) }
  print(a.length)
}

function other() {
  const w: Shape[] = []
  w.push({ s: 3 })
  print(w.length)
}

f()
other()
