// @run
// @log green
// @log 1
// @log a
// @log a
// @log 9000000000
// @log green
// @log green
// @log green
// @log green

// D1745 — a join that exists only as an INFERENCE registers no union, and the whole union
// type block — the variant structs, the box, and the per-rep value boxes — is minted only
// under `uDeclared`. So an unregistered join had no box to coerce its atom into, and the
// emitter refused.

// The declared spelling is the control: it opens the same gate through registration, so the
// two must print the same thing.

const c = true

// The witness: a mixed string/i32 join, printed directly.
print(if c { "green" } else { 7 })

// The other arm-kind pairs of the same shape. Each pair mints a different per-rep box, so a
// close that reached only the i32 one would leave three of these refusing.
print(if c { 1 } else { true })
print(if c { "a" } else { 2.5 })
print(if c { "a" } else { true })
print(if c { 9000000000 } else { "a" })

// The three delivery positions D1745's grading list names — a call argument, a return, and
// the bound spelling — each of which runs on master's seed too and must keep running.
function take(v: string | i32) { print(v) }
take(if c { "green" } else { 7 })

function mk(): string | i32 { return if c { "green" } else { 7 } }
print(mk())

const bound = if c { "green" } else { 7 }
print(bound)

// The DECLARED control: with the union spelled, registration opens the gate.
type U = string | i32
function pick(): U { return if c { "green" } else { 7 } }
print(pick())
