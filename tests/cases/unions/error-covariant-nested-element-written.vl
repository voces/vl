// @error WRITTEN THROUGH
// @hint redundant type annotation: `a` is inferred as `{r: i32}[]` — remove it to lean on inference
// @hint redundant type annotation: `nn` is inferred as `Shape[][]` — remove it to lean on inference
// The element escape is what makes the nested-element claim sound (D1628).
//
// Claiming `[b]` as a delivery is safe only because a write through the container's elements
// is found. `nn[0]` roots at no name, so the closure's name-to-name edges miss it entirely;
// the escape is filed under `nn` plus an element key instead, and an index read matches it.
// The refusal is the answer the design owes here: the two element storages cannot both be
// honoured, so the covariant assignment itself is what is wrong.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq

function f() {
  const a: Circle[] = [{ r: 7 }]
  const b: Shape[] = a
  const nn: Shape[][] = [b]
  nn[0].push({ s: 3 })
  print(a.length)
}

f()
