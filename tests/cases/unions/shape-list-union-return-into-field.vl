// @run
// @log 4
// @log 4
// @log 5
// A `{ x: i32 }[] | i32[]` spelled by shape beside a declared `P` of that shape holds one record
// arm: a return delivered into an object field (D4932), and a declared record whose field
// spells the union (D4966), both read back under `is P[]`.
type P = { x: i32 }
function wrapA(t: { x: i32 }): { x: i32 }[] | i32[] { [t] }
const o = { f: wrapA({ x: 4 }) }
const g = o.f
if g is P[] {
  for e in g { print(e.x) }
} else {
  print("N")
}

type W = { f: { x: i32 }[] | i32[] }
const k: { x: i32 }[] | i32[] = [{ x: 4 }]
if k is P[] { print(k[0].x) } else { print("N") }
const w: W = { f: [{ x: 5 }] }
const wf = w.f
if wf is P[] { print(wf[0].x) } else { print("N") }
