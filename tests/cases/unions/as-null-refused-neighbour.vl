// @log true
// @log true
// The neighbour of the refused `as null` (`as-null-refused.vl`): the null test is `x == null`
// or `x is null`, over a niche, a boxed and a wider union operand alike.
function nicheIsNull(x: string | null) { return x == null }

function boxedIsNull(x: i32 | null) { return x is null }

function wideIsNull(x: i32 | string | null) { return x == null }

print(nicheIsNull(null))
print(nicheIsNull("a"))
print(boxedIsNull(null))
print(boxedIsNull(3))
print(wideIsNull(null))
const top: string | null = null
print(top == null)
