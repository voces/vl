// @run
// @log hi
// @log 2
// @log b
// @log 7
// @log circle
// @log ok
// @log none
// @hint redundant type annotation: `ns` is inferred as `i32[]`
// A niche-repped `T | null` carries no tag — `ref.null` IS the absent arm — so the trio's
// arm test is the null test: `as!` is `ref.as_non_null`, whose trap is the ruled sad path,
// and `as?` is the identity, `T | null` being the operand's own rep (D1812).

// The four reps below are graded at every delivery position in both faces
// (`scripts/capability-probes/matrix/as-trap-nullable-*-niche.matrix.vl`); the `ns`
// annotation is the annotated face, so deleting it to quiet the hint deletes the axis.

// A standalone struct, a map and a closure keep a loud refusal, since their consumers read
// the CAST for the rep and cannot — admitting them trades the refusal for invalid wasm.

function name(): string | null { return "hi" }
print(name() as! string)

function nums(): i32[] | null { return [1, 2, 3] }
const ns: i32[] = nums() as! i32[]
print(ns[1])

function words(): string[] | null { return ["a", "b"] }
print((words() as! string[])[1])

type Circle = { kind: "circle", r: i32 }
type Rect = { kind: "rect", w: i32 }
type Shape = Circle | Rect
function circle(): Circle | null { return { kind: "circle", r: 7 } }
const c = circle() as! Circle
print(c.r)
const s: Shape = c
print(s.kind)

// `as?` keeps the null instead of trapping on it, at the same cell and the same rep.
function maybe(present: boolean): string | null {
  if present { return "ok" }
  return null
}
print((maybe(true) as? string) ?? "none")
print((maybe(false) as? string) ?? "none")
