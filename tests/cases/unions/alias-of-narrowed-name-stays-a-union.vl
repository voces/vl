// @run
// @log 1
// @log s
// @log 1
// @log 1
// @log 1
// @log t
// @log 1
// @log 1
// @log 2
// @log s
// @log 1
// @log 2
// @log 3
// @log 1
// @hint redundant type annotation: `av` is inferred as `i32 | string`
// An un-annotated alias `const v = w` of a union value, read while `w` is narrowed by `is`:
// the narrowing belongs to the reads of `w`, so `v` is still the union and lowers as one, at
// module scope and in a function, one or two aliases deep (D9750).
function pick(b: boolean): i32 | string {
  if b { return 1 }
  return "s"
}
function show(x: i32 | string) { print(x) }

// The filed witness, and the string arm.
const w = pick(true)
const v = w
if w is i32 { print(v) }
const ws = pick(false)
const vs = ws
if ws is string { print(vs) }

// Two aliases deep, handed to a union parameter, and the source reassigned in the block.
const u = w
const uu = u
if w is i32 {
  print(uu)
  show(u)
}
let lw = pick(true)
const lv = lw
if lw is i32 {
  print(lv)
  lw = "t"
}
print(lw)

// Function-local, under an early return, and a local narrowed under a module `w`.
function local() {
  const fw = pick(true)
  const fv = fw
  if fw is i32 { print(fv) }
  if !(fw is i32) { return }
  print(fv)
  print(fw + 1)
}
local()
function shadowed() {
  const w = pick(false)
  const sv = w
  if w is string { print(sv) }
}
shadowed()

// A nullable source narrowed by `!= null`.
function maybe(b: boolean): i32 | null {
  if b { return 1 }
  return null
}
const nw = maybe(true)
const nv = nw
if nw != null { print(nv ?? 0) }

// Controls: the alias narrowed itself, declared inside the block, or annotated.
if v is i32 { print(v + 1) }
if w is i32 {
  const iv = w
  print(iv + 2)
}
const av: i32 | string = w
if w is i32 { print(av) }
