// @run
// @log 5
// @log 0
// @log 6
// @log 5
// @log 7
// A `??` over a nullable field of a list element narrowed to its record arm reads the element's
// box at its storage, as legacy unwraps it: printed, bound, in arithmetic, passed and returned.
type J = { r: i32 | null }
function show(n: i32) { print(n) }
function first(xs: (J | string)[]) {
  if xs[0] is J { return xs[0].r ?? 0 }
  return -1
}
const q: J = { r: 5 }
const e: J = { r: null }
const xs = [q, e, "s"]
if xs[0] is J { print(xs[0].r ?? 0) }
if xs[1] is J {
  const v = xs[1].r ?? 0
  print(v)
}
if xs[0] is J { print((xs[0].r ?? 0) + 1) }
if xs[0] is J { show(xs[0].r ?? 0) }
print(first(xs) + 2)
