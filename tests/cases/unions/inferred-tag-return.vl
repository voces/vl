// THE LAST ANNOTATION THE DISCRIMINATED-UNION PROGRAM NEEDED. `function describe(s: Shape) {
// return s.kind }` — returning the tag — was a checker floor:
//
//     'describe' infers the union return type "circle" | "rect" — type-valid, but an
//     inferred return of this shape is not yet supported by codegen; annotate the return type
//
// The floor's own note read *"An INLINE litunion (no alias to record) still floors below — it
// has no name for the emitter to key on."* It needs no name: it reps as a STRING REF, which
// is the rep its ANNOTATED twin `: "circle" | "rect"` already carries and the contract
// `exprIsLitAtom`'s Call arm states in as many words.
//
// AN INVALID-WASM DEFECT WAS UNDER IT, in the ANNOTATED spelling, and had to be fixed first.
// `function describe(s: S): "circle" | "rect"` over arms whose tag is a NAMED litunion was
// `type mismatch: expected (ref $type), found i32` at `vl check` rc 0: the return slot is a
// string ref, the value an interned atom, and no arm claimed the conversion. `retStrWiden`
// fired for `: string`, for `string | null` and for an inferred `string`; the INLINE litunion
// return was claimed by none of them, while the NAMED one (`: K`) was claimed by
// `retLitUnion` and correctly does not widen. The two forms rep differently and now say so
// through one predicate.
//
// THE REP CLIFF IS NOW CLOSED, and the other half is `inferred-tag-return-atom.vl`. The join
// TYPE `"circle" | "rect"` is IDENTICAL whether the arms store the tag as a plain string or
// as an interned atom, so nothing downstream can tell them apart FROM THE TYPE. What the type
// cannot carry, a flag does: `fRetLitAtom` records the one bit `fRetKind` cannot (both reps
// ARE i32, so the kind is `"i32"` either way), and the call site widens an atom before
// `print`. This file is the string-repped half; the atom-repped half used to be a loud
// refusal here and, before that, printed `0` for `circle`.
// @run
// @log circle
// @log rect
// @log <circle>
// @log eq
// @log circle
// @log rect
// @log a

type C = { kind: "circle", r: f64 }
type R = { kind: "rect", w: f64 }
type S = C | R

// the tag returned with NO return annotation
function describe(s: S) { return s.kind }
print(describe({ kind: "circle", r: 1.0 }))
print(describe({ kind: "rect", w: 2.0 }))

// and consumed as the string it is
print("<" + describe({ kind: "circle", r: 1.0 }) + ">")
if describe({ kind: "rect", w: 1.0 }) == "rect" { print("eq") }

// THE ANNOTATED INLINE-LITUNION RETURN over ATOM-repped arms — the invalid-wasm cell. The tag
// fields here are NAMED litunion aliases, so the read yields the interned atom and the return
// widens it into the string-ref slot.
type KC = "circle"
type KR = "rect"
type Ck = { kind: KC, radius: f64 }
type Rk = { kind: KR, width: f64 }
function describeK(s: Ck | Rk): "circle" | "rect" { return s.kind }
print(describeK({ kind: "circle", radius: 1.0 }))
print(describeK({ kind: "rect", width: 2.0 }))

// a NAMED litunion return still reps as the ATOM and must NOT widen — the seam between the
// two forms, and the reason this is one predicate rather than "is it a literal union"
type K = "a" | "b"
function pick(k: K): K { return k }
print(pick("a"))
