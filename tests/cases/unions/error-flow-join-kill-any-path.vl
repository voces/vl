// @check
// @error operator '+' is not defined for i32 | null and i32
// @error operator '+' is not defined for i32 | null and i32 — 'x' is no longer narrowed to i32: the call to 'clr' on line 42 may reassign it; re-test 'x' after the call
// @error operator '+' is not defined for i32 | null and i32 — 'a.v' is no longer narrowed to i32: the assignment to 'b.v' on line 52 may reassign it; re-test 'a.v' after the assignment
// @error operator '+' is not defined for i32 and i32 | null — 'a[0]' is no longer narrowed to i32: the assignment on line 64 in the loop around this read may reassign it; re-test 'a[0]' after the assignment
// @error operator '+' is not defined for i32 | null and i32
// @error operator '+' is not defined for i32 | null and i32
// @error operator '+' is not defined for i32 | null and i32
// @error operator '+' is not defined for i32 | null and i32
// @warning Unused variable `a` (prefix with `_` to suppress, or remove it)
// A kill on any path survives the meet, and inside a loop on every iteration (must-error, D3285,
// D3306, D3307, D3308): an alias write on one arm under a re-narrow on the other, a call that
// writes the outer binding from under an inner one, an alias write under a shadowed root, and a
// computed-index write later in a loop body. A write to a prefix of the key, the root included,
// kills it too (D3315, D3319).
function nn(v: i32): i32 | null {
  if v < 0 { return null }
  return v
}
type Box = { v: i32 | null }

function aliasArm(a: Box, b: Box, c: boolean): i32 {
  a.v = 1
  if c {
    a.v = null
    a.v = 7
  } else {
    const q = b
    q.v = null
  }
  return a.v + 1
}

function hiddenCall(k: i32, c: boolean): i32 {
  let x = nn(k)
  const clr = () => {
    x = null
  }
  if c { x = 3 } else { x = 4 }
  {
    const x = 100
    clr()
    print(x)
  }
  return x + 1
}

function hiddenAlias(a: Box, b: Box, c: boolean): i32 {
  if c { a.v = 3 } else { a.v = 4 }
  {
    const a: Box = { v: 1 }
    b.v = null
  }
  return a.v + 1
}

function loopIndex(k: i32, c: boolean) {
  const a = [nn(k)]
  let s = 0
  let i = 0
  if c { a[0] = 7 } else { a[0] = 8 }
  while i < 3 {
    s = s + a[0]
    a[i % 1] = null
    i = i + 1
  }
  return s
}

function killThenRefill(a: Box, b: Box, c: boolean): i32 {
  a.v = 1
  if c {
    b.v = null
    a.v = 6
  } else {
    a.v = null
  }
  return a.v + 1
}

type Nest = { in: Box }

function prefixWrite(a: Nest, c: boolean): i32 {
  a.in.v = 1
  if c { a.in.v = 6 } else { a.in = { v: null } }
  return a.in.v + 1
}

function rootWrite(c: boolean): i32 {
  let a: Nest = { in: { v: null } }
  a.in.v = 1
  if c { a.in.v = 6 } else { a = { in: { v: null } } }
  return a.in.v + 1
}

function prefixCell(a: (i32 | null)[][], c: boolean): i32 {
  a[0][0] = 1
  if c { a[0][0] = 6 } else { a[0] = [null] }
  return a[0][0] + 1
}

const o: Box = { v: 3 }
print(
  aliasArm(o, o, false)
    + hiddenCall(-1, true)
    + hiddenAlias(o, o, true)
    + loopIndex(-1, true),
)
