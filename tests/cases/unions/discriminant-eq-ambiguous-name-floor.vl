// @run
// @log 3
// @log 9
// Two structurally alike unions in one module: `C = {kind: "circle", r: f64}` and
// `Ca = {kind: KC, r: f64}` are one structure once the alias `KC = "circle"` folds, so a
// nominal name derived from the structure is ambiguous. The discriminant `s.kind == "circle"`
// narrows each receiver to the arm the checker typed the read at, out of the receiver's own
// box, so the ambiguous name no longer matters (D14537). Before, the derived name was refused
// and the read fell to a shared-field plan that refused `r`; before that, a cast-failure trap.
type C = { kind: "circle", r: f64 }
type R = { kind: "rect", w: f64 }
type S = C | R
function area(s: S) {
  if s.kind == "circle" { return s.r }
  return 0.0
}

type KC = "circle"
type KR = "rect"
type Ca = { kind: KC, r: f64 }
type Ra = { kind: KR, w: f64 }
function areaA(s: Ca | Ra) {
  if s.kind == "circle" { return s.r }
  return 0.0
}

print(area({ kind: "circle", r: 3.0 }))
print(areaA({ kind: "circle", r: 9.0 }))
