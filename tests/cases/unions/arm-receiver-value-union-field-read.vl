// @run
// @log true
// @log false
// @log 7
// @log -1
// @log 7
// @log 7
// @log -1
// @log 5
// @log 3
// @log 4
// @log 7
// A code-16 (value-union BOX) field read whose RECEIVER is a DECLARED union ARM, at every
// storage class the arm can arrive through — silent-class-inventory D219, and the root
// under D211's census family.
//
// `Circle` here is a union member, so `collectS` gives it NO row in the standalone struct
// table and `structIndexOfExpr` answers -1 for every one of these receivers.
// `memberUnionFieldName` resolved its field through that table and through a NARROWED arm
// (`memNarrowVariantIndex`), and had no rung for an arm receiver that is one BY
// DECLARATION. So `exprUnion` / `unionNameOfExpr` / `memberUnionReadKind` all said "not a
// union field", the `!= null` test fell out of `emitNulIsNullTest` to the scalar compare,
// and the bare `null` had nothing to type it: `emitProgram: bare null needs a struct-typed
// context`, on a program `vl check` passes.
//
// DELETE `type Shape` AND EVERY LINE HERE ALREADY RAN, which is the shape of the whole
// family: `Circle` re-enters the struct table the moment it is not a union member, the
// first rung answers, and the ARM spelling is the only one that was broken. That is why
// the census cells that moved all carry `union=used`/`union=unused` and never
// `union=nounion`.
//
// THE `is` LINE IS NOT DECORATION. It is the channel that made a narrower fix wrong: the
// member-path narrowing an `is` push installs is lowered by a site that read
// `sHeapIdx[structIndexOfExpr(...)]` with no bound guard, so widening only the READ
// classifiers left `g.r is i32` reaching `sHeapIdx[-1]` — `wasm trap: out of bounds array
// access` from inside the compiler (D220).
//
// AND THE LIST LEG BINDS FIRST (`const e0 = xs[0]`) BECAUSE THE DIRECT `xs[0].r` IS
// DELIBERATELY STILL A LOUD FLOOR. A ref-list ELEMENT receiver is declined: with an
// un-annotated inner list of DISAGREEING anonymous shapes the module is already invalid at
// the outer `array.new_fixed`, and the field read is the only stage that stops emission
// before it is written (D223). A binding is not an element read, so this line is the
// supported half and the decline costs it nothing.
type Circle = { r: i32 | null }
type Sq = { s: i32 }
type Shape = Circle | Sq

function take(p: Circle) {
  if p.r != null { print(p.r) } else { print(-1) }
}

function mk(v: i32 | null): Circle { { r: v } }

const g: Circle = { r: 7 }
const gn: Circle = { r: null }

const xs: Circle[] = [{ r: 3 }]
const m: {[string]: Circle} = Map()
m["k"] = { r: 4 }

print(g.r != null)
print(gn.r != null)
if g.r != null { print(g.r) } else { print(-1) }
if gn.r != null { print(gn.r) } else { print(-1) }
const bound = g.r
if bound != null { print(bound) } else { print(-1) }
take(g)
take(gn)
take(mk(5))
const e0 = xs[0]
if e0.r != null { print(e0.r) } else { print(-1) }
const mv = m["k"] ?? { r: null }
if mv.r != null { print(mv.r) } else { print(-1) }
if g.r is i32 { print(g.r) } else { print(0) }
