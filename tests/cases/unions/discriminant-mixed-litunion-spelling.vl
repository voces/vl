// D1050 — the two arms of a discriminated union spell their literal discriminant DIFFERENTLY:
// one as a named literal-union ALIAS, the other as an inline set. D1023's ruling calls the
// pair legal (both are string literal sets, so `is` is a question about the VALUE) and the
// checker agrees, but the two spellings rep differently — an alias is the interned i32 ATOM,
// an inline set a `(ref $string)` — so the arms had no single heap type to share and the
// emitter refused.
//
// THE ARMS ARE NOW LAID OUT UNDER ONE REP, the atom, by `unifyMixedLitRepArms`. The wasm is
// the check that the fix is a REP change and not a relaxed gate: both arms share
// `(type $0 (struct (field (mut i32)) (field (mut f64))))` — `kind` is the interned id in
// BOTH, where master emitted a `(ref $string)` for the inline arm and could not fold them.
//
// EVERY ROW PRINTS THE MEMBER TEXT, not the id. That is the half a layout change can silently
// lose: the atom rep is only correct if every read widens back through `emitAtomToStr`, so a
// row that printed `0` for `"x"` would be a valid module with the wrong answer.
//
// BOTH FACES OF EVERY SPELLING, because an annotated and an un-annotated face of one gap land
// in different places. The `const v: B = …` construction and the bare `return { … }` are both
// here, as are the annotated and un-annotated rebinds off the promoted field.
// Both annotations below are DECLARED rather than deleted: `takes(s: string)` IS the string
// boundary this fixture grades the promoted field against, and `const ka: K1` is the
// annotated face of the alias arm's read. A hint saying an annotation is redundant is the
// checker agreeing about the TYPE and says nothing about whether the two spellings agree
// about the REP, which is the whole subject here.
// @hint redundant type annotation: `takes` is inferred as `string` — remove it to lean on inference
// @hint redundant type annotation: `ka` is inferred as `K1` — remove it to lean on inference
// @run
// @log 2
// @log 1
// @log true
// @log true
// @log false
// @log false
// @log circle
// @log x
// @log true
// @log true
// @log x
// @log x
// @log x
// @log k=x
// @log circle
// @log circle
// @log 7
// @log circle
// @log x
// @log p

type K1 = "circle" | "round"
type A = { kind: K1, r: f64 }
type B = { kind: "x" | "y", r: f64 }

function f(n: i32): A | B {
  if n == 0 { return { kind: "circle", r: 1.0 } }
  return { kind: "x", r: 2.0 }
}

// The filed witness, and its sibling on the other arm.
print(f(1).r)
print(f(0).r)

// `is` answers by the discriminant's VALUE, in both directions and on both arms.
const a = f(0)
const b = f(1)
print(b is B)
print(a is A)
print(b is A)
print(a is B)

// The READ yields the member text on each arm, not the interned id.
if a is A { print(a.kind) } else { print("notA") }
if b is B { print(b.kind) } else { print("notB") }

// `==` against a member literal, on the promoted arm and on the alias arm.
if a is A { print(a.kind == "circle") } else { print(false) }
if b is B { print(b.kind == "x") } else { print(false) }

// DELIVERY POSITIONS of the promoted arm's field. Each proves the value crossed as a string.
function takes(s: string): string { s }
if b is B {
  const k = b.kind
  print(k)
  print(takes(b.kind))
  const xs: string[] = [b.kind]
  print(xs[0])
  print("k=" + b.kind)
} else {
  print("notB")
}

// The ALIAS arm's field at the same positions — unchanged by the unification.
if a is A {
  const ka: K1 = a.kind
  print(ka)
  print(takes(a.kind))
} else {
  print("notA")
}

// A `B` built OUTSIDE the union, then delivered INTO it: the arm and the declared type share
// one heap type, which is why the DECLARED struct row has to move with the variant row.
function box(v: A | B): A | B { v }
const s: B = { kind: "x", r: 7.0 }
const t = box(s)
if t is B { print(t.r) } else { print(0.0) }

// THREE ARMS mixing all three spellings — alias, inline, alias.
type K3 = "p" | "q"
type C = { kind: K3, r: f64 }
function f3(n: i32): A | B | C {
  if n == 0 { return { kind: "circle", r: 1.0 } }
  if n == 1 { return { kind: "x", r: 2.0 } }
  return { kind: "p", r: 3.0 }
}
const t0 = f3(0)
const t1 = f3(1)
const t2 = f3(2)
if t0 is A { print(t0.kind) } else { print("notA") }
if t1 is B { print(t1.kind) } else { print("notB") }
if t2 is C { print(t2.kind) } else { print("notC") }
