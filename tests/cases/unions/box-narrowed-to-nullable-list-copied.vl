// @run
// @info `w` is never reassigned; use `const` instead of `let`
// @hint redundant type annotation: `w` is inferred as `i32[] | null`
// @log 2
// @log -1
// @log 1
// @log -1
// @log 1
// @log -1
// @log 1
// @log -1
// @log 1
// @log -1
// @log 1
// @log -1
// @log 1
// @log -1
// @log false
// @log true
// @log false
// @log true
// @log false
// @log true
// @log false
// @log true
// @log false
// @log true
// @log false
// @log true
// @log 2
// @log 1
// @log 4
// A union box narrowed to `L[] | null` and copied out (a binding, an argument, a return, a field
// read) is that nullable list: null where the box holds `null`, else its list (D17086).
function ci(e: i32[] | null | string) {
  if e is string { return }
  const w = e
  if w != null { print(w.length) } else { print(-1) }
}
ci([1, 2])
ci(null)
function cf(e: f64[] | null | string) {
  if e is string { return }
  const w = e
  if w != null { print(w.length) } else { print(-1) }
}
cf([1.5])
cf(null)
function cs(e: string[] | null | i32) {
  if e is i32 { return }
  const w = e
  if w != null { print(w.length) } else { print(-1) }
}
cs(["x"])
cs(null)
function cl(e: i64[] | null | string) {
  if e is string { return }
  const w = e
  if w != null { print(w.length) } else { print(-1) }
}
cl([1 as i64])
cl(null)
function cg(e: f32[] | null | string) {
  if e is string { return }
  const w = e
  if w != null { print(w.length) } else { print(-1) }
}
cg([1.5 as f32])
cg(null)
function cb(e: boolean[] | null | string) {
  if e is string { return }
  const w = e
  if w != null { print(w.length) } else { print(-1) }
}
cb([true])
cb(null)
function cu(e: u8[] | null | string) {
  if e is string { return }
  const w = e
  if w != null { print(w.length) } else { print(-1) }
}
cu([1 as u8])
cu(null)
function asLet(e: i32[] | null | string) {
  if e is string { return }
  let w = e
  print(w == null)
}
asLet([1])
asLet(null)
function annotated(e: i32[] | null | string) {
  if e is string { return }
  const w: i32[] | null = e
  print(w == null)
}
annotated([1])
annotated(null)
function take(w: i32[] | null) { print(w == null) }
function asArg(e: i32[] | null | string) {
  if e is string { return }
  take(e)
}
asArg([1])
asArg(null)
function asRet(e: i32[] | null | string): i32[] | null {
  if e is string { return null }
  return e
}
print(asRet([1]) == null)
print(asRet(null) == null)
type H = { v: i32[] | null | string }
function fromField(h: H) {
  if h.v is string { return }
  const w = h.v
  print(w == null)
}
fromField({ v: [1] })
fromField({ v: null })
function direct(e: i32[] | null | string) {
  if e is string { return }
  print(e == null)
}
direct([1])
direct(null)
function coalesced(e: i32[] | null | string) {
  if !(e is string) { print((e ?? [9]).length) }
}
coalesced([1, 2])
coalesced(null)
function walked(e: i32[] | null | string) {
  if e is string { return }
  for x in e ?? [] { print(x) }
}
walked([4])
walked(null)
