// @run
// @log true
// @log N
// @log true
// @log 1.5
// @log s
// @log s
// @log s
// @log 3
// A `??` whose join is a value union spelled nowhere else (`boolean | string`, `f64 | boolean`)
// prints straight from its box: the collection walk registers the union the `??` produces
// (D3185, D3404). A generic's `T` bound from such a `??` is the join, not its left side.
function g(n: i32): boolean | null {
  if n > 0 { return true }
  return null
}
print(g(1) ?? "N")
print(g(0) ?? "N")
function f(x: boolean, o: f64 | null) {
  print(o ?? x)
  return 0
}
f(3 > 2, null)
f(3 > 2, 1.5)
function mx(k: i32): string | null {
  if k == 0 { return null }
  "s"
}
function id<T>(q: T): T { q }
const sx = mx(1)
print(id(sx ?? 3))
const st = sx ?? 3
print(id(st))
const sl = [id(sx ?? 3)]
print(sl[0])
print(id(mx(0) ?? 3))
