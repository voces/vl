// @run
// @log 105
// @log 4
// @log 110
// @log 5
// @log 103
// @log 105
// @log 4
// @hint redundant type annotation: `sum` is inferred as `i32`
// @hint redundant type annotation: `total` is inferred as `i32`
// A union arm whose nullable field holds the union itself: built, read, assigned through a
// narrowed arm, held in a record, and spelled with literal tags (D4615).
type Node = { v: i32, next: Node | null } | { e: i32 }
type H = { f: Node }
function sum(n: Node | null): i32 {
  if n == null { return 0 }
  if n is { e: i32 } { return n.e * 100 }
  return n.v + sum(n.next)
}
const end: Node = { e: 1 }
const b: Node = { v: 2, next: end }
const a: Node = { v: 3, next: b }
const c: Node = { v: 4, next: null }
print(sum(a))
print(sum(c))
const m: Node = { v: 5, next: null }
if m is { v: i32, next: Node | null } {
  m.next = a
  print(sum(m))
  m.next = null
  print(sum(m))
}
const h: H = { f: { v: 3, next: { e: 1 } } }
print(sum(h.f))
type Tagged = { kind: "node", v: i32, next: Tagged | null } | { kind: "end" }
function total(n: Tagged | null): i32 {
  if n == null { return 0 }
  if n.kind == "end" { return 100 }
  return n.v + total(n.next)
}
const ta: Tagged = {
  kind: "node",
  v: 3,
  next: { kind: "node", v: 2, next: { kind: "end" } },
}
const tb: Tagged = { kind: "node", v: 4, next: null }
print(total(ta))
print(total(tb))
