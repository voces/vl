// @run
// @log false
// @log true
// @log true
// @log false
// Two arms sharing a field-name set with no literal-typed field are a legal union: `is` tests
// whether the value's field fits the arm's field type (D4056).
type A = { v: i32 }
type B = { v: boolean }
type S = A | B

function f(n: i32): S {
  if n == 0 { return { v: 1 } }
  return { v: true }
}
print(f(1) is A)
print(f(1) is B)
print(f(0) is A)
print(f(0) is B)
