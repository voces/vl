// @run
// @log 2
// @log 1
// @log 110
// @log 101
// @log 210
// A list literal delivered into a union of lists that its own type is no arm of: it is built at
// the ref-list arm its first element names, each element boxed into that arm's element union,
// under the arm's tag. Returned, passed, bound and at top level.
type NL = (i32 | null)[] | null[]
type SL = (i32 | string)[] | (string | null)[]
function count(a: SL) {
  let c = 0
  for v in a {
    if v is string { c += 100 }
    else if v == null { c += 10 }
    else { c += 1 }
  }
  return c
}
function len(a: NL) { return a.length }
function returned(k: i32): NL {
  if k == 0 { return [1, 2] }
  return [null]
}
function passed() { print(count([null, "b"])) }
function bound() {
  const s: SL = [1, "a"]
  print(count(s))
}
print(len(returned(0)))
print(len(returned(1)))
passed()
bound()
print(count(["x", null, "y"]))
