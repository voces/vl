// @run
// @log true
// @log 1
// @log syntax
// @log m
// @log true
// @log 2
// @log 3
// @log 4
// A UNION ARM CARRYING A BARE LITERAL FIELD, at the two faces that refused (D1031) and at the
// two spellings that split its heap type.
//
// THE FIELD FACE was `emitProgram: a struct field typed as the union ARM `E` has no field rep`
// and the RETURN face `emitProgram: ref valtype with no interned shape` — two messages, and
// NOT one ingredient, which is what the ablation said and the row did not. The field face
// needs the arm to have a struct row: D761 interns the arm's own `tyToEmitName` RENDER on
// demand, and that render SOFTENS `kind: "syntax"` to `kind: string`, so the row it mints
// carried a canon key the arm's own arena type could never equal and the structural find
// answered -1 on a row sitting in the table. The return face needs none of that — it is an
// UNNAMED composing union plus an `E | null` niche, and its ingredient is the nullable-inner
// EXCLUSION in `annCommitVariantMembers`, which the DECLARED spelling never met.
//
// THE HEAP SPLIT UNDER BOTH is one key: `repCanonId` gave a bare `TyLit` the arena-index
// sentinel, so every spelling of `"syntax"` was its own shape. `E` and its identically-spelled
// declared twin `ETwin` are ONE type to the checker and were TWO heap types in the module —
// check-clean invalid wasm with no union in the program at all, which is why the last three
// lines here have no union anywhere near them.
type E = { at: i32, kind: "syntax", msg: string }
type Other = { o: string }
type ETwin = { at: i32, kind: "syntax", msg: string }
type Scan = { i: i32, err: E | null }

// The RETURN face: the composing union is spelled INLINE, which is the half the declared
// spelling (`type U = Other | E`) has always run.
function f(n: i32): Other | E {
  if n == 0 { return { at: 1, kind: "syntax", msg: "m" } }
  { o: "x" }
}
function g(n: i32): E | null {
  if n == 0 { return { at: 2, kind: "syntax", msg: "n" } }
  null
}

// CONSTRUCT the field face, then DISCRIMINATE it three ways: `== null`, `is E`, and a field
// read through the narrowing. A cell that lands the union BOX in the field cannot print `1`,
// `syntax` and `m` here.
const p: Scan = { i: 0, err: null }
print(p.err == null)
const r = f(0)
if r is E { p.err = r }
const e = p.err
if e == null { print(0) } else { print(e.at) }
if e is E { print(e.kind) } else { print("no") }
if e == null { print("no") } else { print(e.msg) }

// The RETURN face at both arms of its niche.
print(g(1) == null)
const gv = g(0)
if gv == null { print(0) } else { print(gv.at) }

// THE HEAP SPLIT, with no union in sight: an `ETwin` value read back at `E`, and an `ETwin`
// value delivered into an `ETwin`-typed field. Two heap types here is
// `expected (ref null $type), found (ref $type)`.
// DECLARED, not deleted: both annotations are the point of these three lines. The hint says
// the CHECKER agrees about the type — which is exactly the claim under test — and says nothing
// about whether the two spellings agree about the REP, which is what split the heap.
// @hint redundant type annotation: `back` is inferred as `ETwin`
// @hint redundant type annotation: `tw2` is inferred as `{t: ETwin}`
type TW = { t: ETwin }
const tw: TW = { t: { at: 3, kind: "syntax", msg: "t" } }
const back: E = tw.t
print(back.at)
const fwd: ETwin = { at: 4, kind: "syntax", msg: "f" }
const tw2: TW = { t: fwd }
print(tw2.t.at)
