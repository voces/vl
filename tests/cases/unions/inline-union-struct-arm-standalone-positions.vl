// THE POSITION SWEEP for #1803: a declared struct that an INLINE union names as an arm, used
// STANDALONE everywhere else. `collectS` refuses such a struct its own row ("a union variant
// `TypeDecl` is owned by the variant table"), so each position below must resolve the VARIANT
// heap type — and each of them classified `"struct"` instead until the checker's
// `cVariantMemberTyIxs` learned the annotation route (`annRegisterVariantMembers`).
//
// The `sink` global is the ONLY thing that makes `E` a union arm. Delete that one line and
// every position below lowers on master, which is what makes this a two-registry disagreement
// rather than a position bug: the positions were always right, they were reading the table the
// other half of the compiler had emptied.
//
// One position is deliberately here and NOT in the call file: `const g = mk(5)`, an
// un-annotated module GLOBAL bound to a variant-returning call. Its cell is the kind-8 raw
// variant, which `globalKind` had no arm for — it answered `"struct"` beside a variant slot,
// the same incoherence one storage class over, and reads of it (`g.code`) picked `sHeapIdx`
// through `exprVariantIndex`'s missing global leg. The ANNOTATED spelling (`const g: E = …`)
// is a different cell and is still floored — `unions/variant-annotated-global-floor.vl`.
// @run
// @log 5
// @log 6
// @log 7
// @log 8
// @log s
// The two annotations below are what the positions ARE — an annotated standalone LOCAL and an
// annotated standalone ARRAY — so the redundancy hints are declared rather than annotated away.
// @hint redundant type annotation: `e` is inferred as `{code: i32, msg: string}`
// @hint redundant type annotation: `arr` is inferred as `{code: i32, msg: string}[]`
type E = { code: i32, msg: string }
// The only union mention of `E` in the module — an INLINE annotation, no `UnionDecl`.
const sink: string | E = "s"
// standalone RETURN
function mk(c: i32): E { return { code: c, msg: "m" } }
// standalone PARAM
function take(e: E) { e.code }
function loc() {
  const e: E = { code: 7, msg: "m" } // standalone LOCAL
  e.code
}
const g = mk(5) // un-annotated module GLOBAL <- variant-returning call
const arr: E[] = [{ code: 8, msg: "m" }] // standalone ARRAY element
print(g.code)
print(take(mk(6)))
print(loc())
print(arr[0].code)
if sink is E { print(sink.code) } else { print(sink) }
