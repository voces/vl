// Regression (silent-class-inventory D40). An array literal whose FIRST ELEMENT is an IDENT
// (`[c]`) or a CALL (`[mkC(n)]`) — neither of which any first-element SYNTAX probe in
// `arrLitIsRef` can see — over an element the checker typed as a union ARM. Every rung
// declined, the literal fell to the i32 list, and a `(ref $type)` element went into an
// `(array (mut i32))` backing.
//
// On master `c0873a06` the witness below (`d40Fn`) was `vl check` rc 0 with no error and
// `type mismatch: expected i32, found (ref $type)` at instantiation; the same body routed
// through `std:array`'s `mapIndexed` was silent too, with a different engine message
// (`expected (ref $type), found (ref $type)`). The two spellings ARE one root, and the
// ablation is what says so rather than the resemblance: one predicate
// (`arrLitNominalElemName`, read by `arrLitIsRef` / `arrLitElemKind` / `arrLitElemName` and
// declined by `arrLitElemHintTy`) moves both, and moves neither of the other two rows closed
// beside it.
//
// The PLAIN-STRUCT half of the same hole is a whole-program property (`Circle` must not be an
// arm), so it lives in `plain-struct-element-list-from-ident.vl` beside this file. It was the
// i32 path's LOUD floor on master — `emitProgram: struct array elements are not supported` —
// the same missing rung one type-class over, failing in the other direction.
//
// The `d40NoAnn` cell drops the return annotation, which on master turned the same body into
// a THIRD outcome (`emitProgram: field access but no struct type declared`); all three
// spellings now build the same kind-1 element list.
// @run
// @log 7
// @log 7
// @log 7
// @log 7
// @hint redundant type annotation
// @hint Intentionally-unused parameter `_i`
import { mapIndexed } from "std:array"

type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq

function mkC(n: i32): Circle { { r: n } }

// The filed witness: an IDENT element under an annotated `Circle[]` result.
function d40Fn(n: i32): Circle[] {
  const c: Circle = { r: n }
  const o = [c]
  return o
}

// The same body with NO return annotation — a different master message, one root.
function d40NoAnn(n: i32) {
  const c: Circle = { r: n }
  const o = [c]
  return o
}

// A CALL element, the sibling `arrLitIsRef`'s own account groups with the ident.
function d40Call(n: i32): Circle[] {
  const o = [mkC(n)]
  return o
}

// `std:array`'s surface: the callback is un-annotated, so the routing test that decides a
// carve-out (is the outcome WORSE through the module than written directly?) has both sides
// here.
function d40Cb(n: i32, _i: i32) {
  const c: Circle = { r: n }
  const o = [c]
  return o
}

print(d40Fn(7)[0].r)
print(d40NoAnn(7)[0].r)
print(d40Call(7)[0].r)
print(mapIndexed([7], d40Cb)[0][0].r)
