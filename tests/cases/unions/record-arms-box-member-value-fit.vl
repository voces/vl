// @run
// @hint `A` is contained in `B`, so `is A` tests the value
// @hint `C` is contained in `D`, so `is C` tests the value
// @log A
// @log B
// @log B
// @log A
// @log A
// @log B
// @log B
// @log A
// `is A` over a `B` value whose shared field is a box with a member only some of whose values
// fit `A` compares the payload against `A`'s literals (D4265): a `string` member against
// `"a" | "b"`, and an `i32` member against `1 | 2` beside a `null` member.
type A = { v: "a" | "b" }
type B = { v: i32 | string }
function f(u: A | B) {
  if u is A { print("A") } else { print("B") }
}
const b1: B = { v: "a" }
const b2: B = { v: 3 }
const b3: B = { v: "z" }
const b4: B = { v: "b" }
f(b1)
f(b2)
f(b3)
f(b4)
type C = { v: 1 | 2 }
type D = { v: i32 | null }
function g(u: C | D) {
  if u is C { print("A") } else { print("B") }
}
const d1: D = { v: 1 }
const d2: D = { v: null }
const d3: D = { v: 5 }
const d4: D = { v: 2 }
g(d1)
g(d2)
g(d3)
g(d4)
