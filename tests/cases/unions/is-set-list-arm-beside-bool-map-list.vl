// @run
// @log true
// @log false
// `is Set<T>[]` over a union that also holds the boolean-map list the Set list shares its element
// with: the test tells the two apart (D16172).
const s: Set<i32> = Set()
const m: {[i32]: boolean} = Map()
const w: Set<i32>[] | {[i32]: boolean}[] | i32 = [s]
print(w is Set<i32>[])
const x: Set<i32>[] | {[i32]: boolean}[] | i32 = [m]
print(x is Set<i32>[])
