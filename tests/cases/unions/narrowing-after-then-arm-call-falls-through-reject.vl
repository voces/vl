// @error operator '+' is not defined for string | i32 | null and string
// D6690: a then arm that calls a writer and falls through reaches the code after the `if`, so
// the narrowing it ended stays ended there.
let x: string | i32 | null = "lp"
function wr() { x = null }
function go(b: boolean) {
  if x is string {
    if b { wr() }
    print(x + "!")
  }
}
go(true)
