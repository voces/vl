// @run
// @log 1
// @log 0
// @log 102
// @log 2
// @log 103
// @log 1
// @log true
// @log false
// The un-annotated face of D13980: the `null[]` arm reaches its union through an inferred
// return and an argument literal, never a binding spelled at the union.
type N = null[]
function pick(k: i32) {
  if k == 0 {
    const n: N = [null]
    return n
  }
  const m: (boolean | null)[] = [false]
  m
}
function f(v: N | (boolean | null)[]) {
  if v is N { 1 } else { 0 }
}
print(f(pick(0)))
print(f(pick(1)))
function g(v: N | i32[]) {
  if v is N { 100 + v.length } else { v.length }
}
print(g([null, null]))
print(g([4, 5]))
function mk(c: boolean) {
  if c {
    const n: N = [null, null, null]
    return n
  }
  const m = [1]
  m
}
print(g(mk(true)))
print(g(mk(false)))
function fit(v: N | (boolean | null)[] | null) { v is N }
print(fit(pick(0)))
print(fit(null))
