// @run
// @log 2
// @log -1
// @log s4
// @log none
// @log 3
// @log -1
// @log <s5>
// @log none
// @log [s6]
// @log none
// @log s7
// @log none
// @log 18
// @log -1
// @log s9
// @log none
// @log other
// @log 10
// @log -1
// @log s11
// @log true
// @log 13
// @log big
// @log true
// @log 17
// @log -1
// The propagating `as` over a `T | null` niche in each position: its present value used as a
// scalar and a union argument, a nested argument, a concat operand, an interpolation hole, a
// return, an initializer, an `if` arm, a `??` operand and a record field; a null returns the
// enclosing function's null, through a plain or a union result.
type P = { a: i32 }
type E = { msg: string }
type W = { s: string }
function ms(k: i32): string | null {
  if k > 0 { return "s\{k}" } else { return null }
}
function mp(k: i32): P | null {
  if k > 0 { return { a: k } } else { return null }
}
function mm(k: i32): {[string]: i32} | null {
  if k > 0 {
    const m: {[string]: i32} = Map()
    m["k"] = k
    return m
  }
  return null
}
function len(s: string) { return s.length }
function show(u: string | i32): string {
  if u is string { return u } else { return "n" }
}
function idS(s: string) { return s }
function argScalar(k: i32): i32 | null { return len(ms(k) as string) }
function argUnion(k: i32): string | null { return show(ms(k) as string) }
function argNested(k: i32): i32 | null { return len(idS(ms(k) as string)) }
function concat(k: i32): string | null { return "<" + (ms(k) as string) + ">" }
function interp(k: i32): string | null { return "[\{ms(k) as string}]" }
function ret(k: i32): string | null { return ms(k) as string }
function letInit(k: i32): i32 | null {
  const p = mp(k) as P
  let q = p.a + 1
  q = q * 2
  return q
}
function ifArm(k: i32, c: boolean): string | null {
  const v = if c { ms(k) as string } else { "other" }
  return v
}
function coal(k: i32): i32 | null {
  return (mm(k) as {[string]:i32})["k"] ?? -9
}
function rec(k: i32): W | null {
  const w: W = { s: ms(k) as string }
  return w
}
function unionRet(k: i32): i32 | E | null {
  const p = mp(k) as P
  if p.a > 100 { return { msg: "big" } }
  return p.a
}
function after(k: i32): i32 | null { return k + len(ms(k) as string) }
print(argScalar(3) ?? -1)
print(argScalar(0) ?? -1)
print(argUnion(4) ?? "none")
print(argUnion(0) ?? "none")
print(argNested(12) ?? -1)
print(argNested(0) ?? -1)
print(concat(5) ?? "none")
print(concat(0) ?? "none")
print(interp(6) ?? "none")
print(interp(0) ?? "none")
print(ret(7) ?? "none")
print(ret(0) ?? "none")
print(letInit(8) ?? -1)
print(letInit(0) ?? -1)
print(ifArm(9, true) ?? "none")
print(ifArm(0, true) ?? "none")
print(ifArm(0, false) ?? "none")
print(coal(10) ?? -1)
print(coal(0) ?? -1)
const w1 = rec(11)
if w1 != null { print(w1.s) }
print(rec(0) == null)
const u1 = unionRet(13)
if u1 is i32 { print(u1) }
const u2 = unionRet(200)
if u2 is E { print(u2.msg) }
print(unionRet(0) == null)
print(after(14) ?? -1)
print(after(0) ?? -1)
