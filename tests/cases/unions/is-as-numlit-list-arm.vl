// @run
// @log 1
// @log 9
// @log 9
// @log 1
// @log 9
// @log 1
// @log 7
// @log 1
// @log 1
// @log 1
// @log 7
// @log 1
// `is` and the `as` trio over a list of `i32` literals beside the `i32[]` arm sharing its tag:
// the test reads every element, and the cast unboxes the list on a hit.
type K = 0 | 1
function own(x: K[] | string | null) {
  if x is K[] { print(x[0]) } else { print(9) }
}
own([1])
own("s")
own(null)
function twin(x: K[] | i32[] | string) {
  if x is K[] { print(x[0]) } else { print(9) }
}
twin([1])
const five: i32[] = [5]
twin(five)
function cast(x: K[] | i32[] | string) {
  const y = x as? K[]
  if y == null { print(7) } else { print(y[0]) }
}
const one: i32[] = [1]
cast(one)
cast(five)
cast([1])
function nested(x: K[][] | i32[][] | string) {
  const y = x as? K[][]
  if y == null { print(7) } else { print(y[0][0]) }
}
const nn: i32[][] = [[1]]
nested(nn)
const kk: K[][] = [[1]]
nested(kk)
const bad: i32[][] = [[1, 5]]
nested(bad)
function inline(x: (0 | 1)[] | string): i32 {
  const y = x as! (0|1)[]
  return y[0]
}
print(inline([1]))
