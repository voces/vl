// @run
// @log 9
// @log 9
// @log 9
// @log 9
// @log 10
// @log 9
// @hint redundant type annotation: `x` is inferred as `Cat`
// @hint redundant type annotation: `xf` is inferred as `Cat`
// @hint redundant type annotation: `xg` is inferred as `Cat`
// @hint redundant type annotation: `xn` is inferred as `Cat`
// @hint Intentionally-unused parameter `_p`
// A binding typed as a union arm whose initialiser is a call: the arm is the call's result,
// so an object-literal argument builds as the parameter's `P`, at a direct call, an
// un-annotated binding, a function value, a call in a nested capturing function and a
// generic callee (D12459).
type Cat = { c: i32 }
type Dog = { d: i32 }
type U = Cat | Dog
type P = { p: i32 }
function take(p: P): Cat { { c: p.p } }
const x: Cat = take({ p: 9 })
print(x.c)
const xu = take({ p: 9 })
print(xu.c)
const f = take
const xf: Cat = f({ p: 9 })
print(xf.c)
function takeG<T>(_p: T, n: i32): Cat { { c: n } }
const xg: Cat = takeG({ p: 9 }, 9)
print(xg.c)
function outer(k: i32) {
  function takeK(p: P): Cat { { c: p.p + k } }
  const xn: Cat = takeK({ p: 9 })
  xn.c
}
print(outer(1))
function back(): Cat { take({ p: 9 }) }
print(back().c)
