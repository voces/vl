// @run
// @log 5
// @log 5
// @log 6
// @log v5
// @log h5
// @log 5
// @log 5
// @log 5
// @log 5
// @log 5
// @log none
// A field read off a narrowed `Node | null` local of an intersection's recursive field, under the
// null test that makes it legal, delivered to each position; the null cell takes the other arm.
type Node = { v: i32, next: Node | null }
type M = Node & { v: i32 }
type R = { v: i32 }
function sink(n: i32) { print(n) }
function sinkU(u: i32 | string) { print(u) }
function add(a: i32, b: i32) { return a + b }
function id(n: i32) { return n }
function pick(n: i32 | null) { return n }
function argScalar(m: M) {
  const nx = m.next
  if nx != null { sink(nx.v) }
}
function argUnion(m: M) {
  const nx = m.next
  if nx != null { sinkU(nx.v) }
}
function argNested(m: M) {
  const nx = m.next
  if nx != null { print(add(1, id(nx.v))) }
}
function concat(m: M) {
  const nx = m.next
  if nx != null { print("v" + "\{nx.v}") }
}
function hole(m: M) {
  const nx = m.next
  if nx != null { print("h\{nx.v}") }
}
function ret(m: M) {
  const nx = m.next
  if nx != null { return nx.v }
  return 0
}
function letInit(m: M) {
  const nx = m.next
  if nx != null {
    const v = nx.v
    print(v)
  }
}
function ifArm(m: M, c: boolean) {
  const nx = m.next
  if nx != null {
    const y = if c { nx.v } else { 0 }
    print(y)
  }
}
function coalesce(m: M) {
  const nx = m.next
  if nx != null { print(pick(null) ?? nx.v) }
}
function field(m: M) {
  const nx = m.next
  if nx != null {
    const r: R = { v: nx.v }
    print(r.v)
  }
}
function nullCell(m: M) {
  const nx = m.next
  if nx != null { print(nx.v) } else { print("none") }
}
const tail: Node = { v: 5, next: null }
const full: M = { v: 1, next: tail }
const empty: M = { v: 2, next: null }
argScalar(full)
argUnion(full)
argNested(full)
concat(full)
hole(full)
print(ret(full))
letInit(full)
ifArm(full, true)
coalesce(full)
field(full)
nullCell(empty)
