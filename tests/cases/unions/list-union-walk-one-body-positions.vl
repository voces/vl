// @run
// @log 1
// @log 1
// @log 1
// @log 2
// @log 2
// @log 2
// @log 3
// @log 3
// @log 3
// @log 3
// @log 1
// @log 9
// @log a
// @log a
// @log a
// @log b
// @log b
// @log b
// @log 1
// @log a
// @log 4
// A walk of a union of lists through a hole parameter reads each element off the arm the box
// holds and boxes it into the element union, the body written once. Positions: argument, record
// field, list element, `return` from inside the walk, the index, `continue`, `break`, and a walk
// nested over the same binding.
type H = { u: i32 | string }
function show(u: i32 | string) {
  if u is i32 { print(u) } else { print(u) }
}
function first(a): i32 | string {
  for v in a { return v }
  return -1
}
function run(a) {
  let n = 0
  for v, i in a {
    show(v)
    const h: H = { u: v }
    show(h.u)
    const l = [v]
    show(l[0])
    n += i
    if i == 0 { continue }
    if i == 2 { break }
  }
  print(n)
  show(first(a))
  let c = 0
  for x in a {
    for y in a { c += 1 }
  }
  print(c)
}
const one = 1
const u = if one > 0 { [1, 2, 3] } else { ["a", "b"] }
run(u)
const s = if one > 5 { [1, 2, 3] } else { ["a", "b"] }
run(s)
