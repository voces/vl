// @run
// @log 3
// @log 18
// @log 2
// @log no
// Q58 position sweep: a global list narrowed out of a union box, the receiver of a loop's hoisted
// `.length` and element reads, which the hoist reads again as the global's read and its unbox
// (`irLReadAgain`): an else arm at module scope with an inner loop's condition, an `i32[]`, a
// function's early return, and the error arm.
type E = { msg: string }
function bytes(n: i32): u8[] | E {
  if n < 0 { return { msg: "no" } }
  return [1, 2, 10, 3, 10, 4]
}
function ints(n: i32): i32[] | E {
  if n < 0 { return { msg: "no" } }
  return [5, 6, 7]
}
const txt = bytes(1)
const xs = ints(1)
const bad = bytes(-1)
if txt is E {
  print(txt.msg)
} else {
  let start = 0
  let lines = 0
  while start < txt.length {
    let end = start
    while end < txt.length && txt[end] != 10 { end = end + 1 }
    lines = lines + 1
    start = end + 1
  }
  print(lines)
}
if xs is E {
  print(xs.msg)
} else {
  let s = 0
  let i = 0
  while i < xs.length {
    s = s + xs[i]
    i = i + 1
  }
  print(s)
}
function inFn() {
  if txt is E { return -1 }
  let k = 0
  let i = 0
  while i < txt.length {
    if txt[i] == 10 { k = k + 1 }
    i = i + 1
  }
  return k
}
print(inFn())
if bad is E { print(bad.msg) } else { print(bad.length) }
