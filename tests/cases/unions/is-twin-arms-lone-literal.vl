// @run
// @log 100
// @log 1
// @log 101
// @log 1
// @log other
// @log a
// @log other
// @hint redundant type annotation: `f` is inferred as `i32`
// @hint redundant type annotation: `g` is inferred as `i32`
// Inline arms that differ only in a lone literal keep distinct tags in one shared row, so
// `is` tests the row and the literal: at a parameter, an alias spelling, an un-annotated
// parameter and a map value of a three-arm union (D5157).
type N = { tag: "a", v: i32 } | { tag: "b", v: i32 }
function f(n: N): i32 {
  if n is { tag: "a", v: i32 } { return 100 }
  1
}
const x: N = { tag: "a", v: 1 }
const y: N = { tag: "b", v: 1 }
print(f(x))
print(f(y))
type A = { tag: "a", v: i32 }
type B = { tag: "b", v: i32 }
type P = A | B
function g(n: P): i32 {
  if n is A { return 100 + n.v }
  1
}
print(g({ tag: "a", v: 1 }))
print(g({ tag: "b", v: 1 }))
type W = { tag: "a", v: i32 } | { tag: "b", v: i32 } | { w: i32 }
function mk(a: boolean): W {
  if a { return { tag: "a", v: 7 } }
  { tag: "b", v: 8 }
}
function take(a) {
  const v = a
  if v is { tag: "a", v: i32 } { print("a") } else { print("other") }
}
take(mk(false))
take(mk(true))
const m = Map()
m["k"] = mk(false)
const mv = m["k"]
if mv != null {
  if mv is { tag: "a", v: i32 } { print("a") } else { print("other") }
}
