// @run
// @log 8
// @log 8
// @log 8
// @hint redundant type annotation: `v` is inferred as `A` — remove it to lean on inference

// D1685 — a narrowed struct arm of an inferred union ASSIGNED to a local or to a list
// element. Both boundaries stored the box whole; each now reads the destination the binding
// boundary reads — the cell's own `(kind, slot)` columns for a local, the element's own
// variant or struct row for a list element.
type A = { r: i32 }

function st(): A { return { r: 8 } }

function mk(b: boolean) {
  if b { return st() }
  7
}

// A local assignment, the destination declared inside the guard.
function inGuard() {
  const p = mk(true)
  if p is A {
    let v: A = p
    v = p
    print(v.r)
  }
}
inGuard()

// The same, declared OUTSIDE the guard — the cell exists before the narrowing does.
function outGuard() {
  const p = mk(true)
  let v: A = st()
  if p is A {
    v = p
    print(v.r)
  }
}
outGuard()

// A list ELEMENT assignment, one container over.
function elemAssign() {
  const p = mk(true)
  const xs = [st()]
  if p is A {
    xs[0] = p
    print(xs[0].r)
  }
}
elemAssign()
