// @run
// @log 7
// @log 7
// @log d
// @log d
// @log 7
// @log 7
// @log 5
// @log 5
// @hint redundant type annotation: `dfltI` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `dfltS` is inferred as `string` — remove it to lean on inference
// D1763 — A `??` WHOSE LEFT OPERAND IS A CALL TAKES THE SAME ARM A PLACE DOES.
//
// The nullable-ref-niche core evaluates its operand ONCE — `br_on_non_null` consumes it, and
// the join arm tees it into a stash the reservation walk already asks for — so a CALL operand
// needs no re-read. The `string | null` arm was nonetheless gated on the operand being a
// re-readable place, a leftover from a re-read shape that is gone, and a call fell past every
// niche arm to a lowering that hands the join a heap the box does not have.
//
// Every pair is the same program written fused and bound, so a spelling that stops agreeing
// with the other is the finding. The defaults are the kinds the join arm serves, and their
// return annotations are declared redundant rather than removed: the default's own type is
// what picks the join, so a fixture that infers them cannot say which kind it graded.
type A = { r: i32 }

function nulS(): string | null { return null }
function someS(): string | null { return "abcde" }
function dfltI(): i32 { return 7 }
function dfltS(): string { return "d" }
function dfltA(): A { return { r: 7 } }

// a SCALAR default — the join is `string | i32`, so the result is the union box
const fusedScalar = nulS() ?? dfltI()
if fusedScalar is i32 { print(fusedScalar) } else { print(0) }
const boundLhs1 = nulS()
const boundScalar = boundLhs1 ?? dfltI()
if boundScalar is i32 { print(boundScalar) } else { print(0) }

// a STRING default — the join is `string`, the niche's own rep, no box
print(nulS() ?? dfltS())
const boundLhs2 = nulS()
print(boundLhs2 ?? dfltS())

// a STRUCT default — the join is `string | A`, the box with a variant arm
const fusedStruct = nulS() ?? dfltA()
if fusedStruct is A { print(fusedStruct.r) } else { print(0) }
const boundLhs3 = nulS()
const boundStruct = boundLhs3 ?? dfltA()
if boundStruct is A { print(boundStruct.r) } else { print(0) }

// and the PRESENT path, which must take the operand rather than the default at both spellings
print((someS() ?? dfltS()).length)
const boundLhs4 = someS()
print((boundLhs4 ?? dfltS()).length)
