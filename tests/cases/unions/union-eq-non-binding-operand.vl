// @run
// @log true
// @log false
// @log false
// @log true
// @log true
// @log 2
// D972 — `==` OVER A UNION VALUE THAT IS NOT A BINDING.
//
// The compare reads the box up to three times — the no-arm fold, the TAG, and the PAYLOAD
// inside the tag-matched arm — and `unionEqOperandOk` (Ident / NumLit / StrLit / Member /
// Index) existed to require an operand that survives that. A CALL operand does not, so
// `mk(true) == 1` refused while `const u = mk(true); u == 1` ran and printed the right answer:
// the lowering was there and only the extra reads were in the way.
//
// TEED AT THE FIRST READ, not pre-emitted at the top. Two earlier attempts trapped: the first
// reused `sharedFieldRecvSlot`, which the operand's own emission already holds, and compiled
// to `(local.set $1 (local.get $1))`; the second gave it a private slot but evaluated the
// operand ahead of the gates, where the surrounding lowering's context is not yet in force.
//
// THE COUNTER IS THE POINT of the last two cells: the whole re-readability rule exists to
// protect evaluate-once, so this measures it rather than asserting it.
let calls = 0

function mk(c: boolean): i32 | string {
  calls = calls + 1
  if c { return 1 }
  "s"
}

print(mk(true) == 1)
print(mk(false) == 1)
print(mk(true) == "s")
print(mk(false) == "s")
print(calls == 4)
print(calls - 2)
