// @run
// @log a-some
// @log a-ne
// @log a-null
// @log c-some
// @log c-ne
// @log c-null
// @log u-some
// @log u-ne
// @log u-null
// `== null` and `!= null` over a union box: a boxed nullable (`i32 | string | null`, a record
// union) and a box whose null is one arm (`U`, through aliases), each with a null and a value.
type A = ("a" | "b") | null
type U = A | i32
function a(v: i32 | string | null) {
  if v == null { print("a-null") } else { print("a-some") }
  if v != null { print("a-ne") }
}
function c(v: {k: i32} | {s: string} | null) {
  if v == null { print("c-null") } else { print("c-some") }
  if v != null { print("c-ne") }
}
function u(v: U) {
  if v == null { print("u-null") } else { print("u-some") }
  if v != null { print("u-ne") }
}
a(1)
a(null)
c({ k: 1 })
c(null)
const x: U = 3
u(x)
const y: U = null
u(y)
