// @log true
// @log 2
// @log 3
// An assignment to the tested place nested in an expression of a deep `is` arm ends the narrowing
// there: the reads evaluated before it, its own right-hand side and a closure made before it see
// the converted copy, and its target and the reads after see the place itself (D16474).
type Json = null | boolean | f64 | string | Json[] | { [string]: Json }

function id(x: null) { return x }
function apply(g: () => i32) { return g() }

function arg(r: Json) {
  if r is string[] {
    const n = r.length
    print(id(r = null) == null)
    print(r == null)
    return n
  }
  return 0
}

function operand(r: Json) {
  if r is string[] {
    const n = r.length
    const b = (r = null) == null
    print(b)
    return n
  }
  return 0
}

function letInit(r: Json) {
  if r is string[] {
    const n = r.length
    const x = (r = null)
    print(x == null)
    return n
  }
  return 0
}

function before(r: Json) {
  if r is string[] {
    const m = r.length + (if (r = null) == null { 10 } else { 20 })
    print(r == null)
    return m
  }
  return 0
}

function rhsRead(r: Json) {
  if r is string[] {
    const x = (r = r[0])
    print(x == "a")
    print(r == "a")
    return 1
  }
  return 0
}

function inTest(r: Json) {
  if r is string[] {
    const n = r.length
    if r.length > 1 && (r = null) == null {
      print(r == null)
    } else {
      print("no")
    }
    return n
  }
  return 0
}

function orTest(r: Json) {
  if r is string[] {
    if r.length > 5 || id(r = null) == null { print(r == null) }
    return 9
  }
  return 0
}

function closureBefore(r: Json) {
  if r is string[] {
    const n = apply(() => r.length)
    print(id(r = null) == null)
    return n
  }
  return 0
}

function closureSame(r: Json) {
  if r is string[] {
    return apply(() => r.length) + (if id(r = null) == null { 1 } else { 0 })
  }
  return 0
}

print(arg(["a", "b"]))
print(operand(["a", "b"]))
print(letInit(["a", "b"]))
print(before(["a", "b"]))
print(rhsRead(["a", "b"]))
print(inTest(["a", "b"]))
print(orTest(["a", "b"]))
print(closureBefore(["a", "b"]))
print(closureSame(["a", "b"]))
