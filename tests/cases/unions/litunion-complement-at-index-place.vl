// @run
// @log 10
// @log 10
// @log 10
// @log 10
// @hint redundant type annotation: `xs` is inferred as `(i32 | "err")[]` — remove it to lean on inference
// @hint redundant type annotation: `w` is inferred as `{xs: (i32 | "err")[]}` — remove it to lean on inference
// The else of `xs[0] is "err"` over an `i32 | "err"` element, read at that place. Canon
// softens the literal to `string` before the emitter's complement rungs subtract from the
// member set, so they pushed the whole set back and left no atom to unbox to (D1729).
//
// Four rows: the element place, its paren spelling, the same place under a struct field,
// and the DIRECT spelling as the control — `is i32` names the surviving atom itself and
// unboxed throughout, which is what makes this the complement's rung rather than the place's.
type W = { xs: (i32 | "err")[] }
function mk(b: boolean): i32 | "err" {
  if b { return "err" }
  return 5
}
const xs: (i32 | "err")[] = [mk(false)]
if xs[0] is "err" { print(0) } else { print(xs[0] * 2) }
if (xs[0]) is "err" { print(0) } else { print((xs[0]) * 2) }
if xs[0] is i32 { print(xs[0] * 2) } else { print(0) }
const w: W = { xs: [mk(false)] }
if w.xs[0] is "err" { print(0) } else { print(w.xs[0] * 2) }
