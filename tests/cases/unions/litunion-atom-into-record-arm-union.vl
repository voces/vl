// @run
// @log true
// @log true
// @log a
// @log 1
// @hint Intentionally-unused variable `_u` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_s` (leading `_` marks it unused)
// A literal-union value stored unread into a union with a record arm, and returned into it,
// takes its member as a string at the module global and at the return (D4042).
type A = "a" | "b"
type U = A | { tag: i32 }
const a: A = "a"
const _u: U = a
function f(x: A): U { return x }
print(f("a") == "a")
const v: U = a
print(v == "a")
if v is { tag: i32 } { print(v.tag) } else { print(v) }
type S = string | { tag: i32 }
const _s: S = a
print(1)
