// D15090: `==` across number widths compares the values at the wider type, through nullable and
// union boxes as for plain numbers: `null == null` is true and a null is no number. Calls (each
// evaluated once), a box against a plain wider number in either order, and a union with another
// arm, compare alike.
function fi(v: i32, n: boolean): i32 | null {
  if n { return null }
  return v
}
function ff(v: f64, n: boolean): f64 | null {
  if n { return null }
  return v
}
function fl(v: i64): i64 | null { return v }
const one: f64 | null = 1.0
const half: f64 | null = 1.5
const x: i32 | null = 1
print(x == one)
print(x == half)
print(fi(1, false) == ff(1.0, false))
print(fi(1, true) == ff(1.0, false))
print(fi(1, true) == ff(1.0, true))
print(ff(2.0, false) == fi(2, false))
print(fl(5) == fi(5, false))
const g: f32 | null = 1.5 as f32
const d = 1.5
print(g == d)
print(g != d)
print(d == g)
const u: i32 | string = 1
const w: f64 | string = 1.0
print(u == w)
const p: i32 | null = 3
print(p == 3.0)
print(p == 3.5)
