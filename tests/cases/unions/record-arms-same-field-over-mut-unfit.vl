// @run
// @log A s:now
// @log B s:now
// @log B before
// @log A s:now
// @log B s:now
// @log B before
// @log A s:now
// @log B s:now
// @hint redundant type annotation: `toS` is inferred as `string` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// @info `u` is never reassigned; use `const` instead of `let`
// @hint redundant type annotation: `u` is inferred as `A | B` — remove it to lean on inference
// @hint `B` is contained in `A`, so `is B` tests the value
// @info `w` is never reassigned; use `const` instead of `let`
// @hint redundant type annotation: `got` is inferred as `i32 | string` — remove it to lean on inference
// @hint `B` is contained in `A`, so `is B` tests the value
// @hint redundant type annotation: `got` is inferred as `i32 | string` — remove it to lean on inference
// Record arms sharing a field name (D4056): a write that moves an `A` value into `B`'s field type is seen by the next `is B`.
// `is` tests whether the value fits, field by field.
import { toString } from "std:fmt"

type A = { n: i32 | string }
type B = { n: string }
function pick(i: i32): A | B {
  if i == 0 {
    const a: A = { n: 3 }
    return a
  }
  if i == 1 {
    const s: string = "s"
    const a: A = { n: s }
    return a
  }
  const b: B = { n: "b" }
  b
}
function toS(x: i32 | string): string {
  if x is i32 { return "i" + toString(x) }
  "s:" + x
}
function f(i: i32) {
  let u: A | B = pick(i)
  if u is B { print("B before") }
  const a: A = { n: 1 }
  let w: A | B = a
  if w is A { w.n = "now" }
  if w is A {
    const got: i32 | string = w.n
    print("A " + toS(got))
  } else {
    print("A no")
  }
  if w is B {
    const got: i32 | string = w.n
    print("B " + toS(got))
  } else {
    print("B no")
  }
}
f(0)
f(1)
f(2)
