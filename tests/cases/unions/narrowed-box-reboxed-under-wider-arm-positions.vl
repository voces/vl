// @run
// @log 5
// @log 5
// @log 5
// @log 5
// @log 5
// @log 5
// A box narrowed to an arm whose record is wider than another union's arm is re-boxed under that
// arm, its payload the same reference: bound, passed, returned, assigned, in a list and at the top
// level.
type A = { k: i32, legs: i32 }
type B = { s: string }
type Pet = A | B
type D = { k: i32, legs: i32, purr: boolean }
function legs(p: Pet | null) {
  if p == null { return -2 }
  if p is A { return p.legs }
  return -1
}
function mk(c: boolean): D | B {
  if c { return { k: 3, legs: 5, purr: true } }
  return { s: "x" }
}
function bound() {
  const u = mk(true)
  if u is D {
    const q: Pet = u
    print(legs(q))
  }
}
function passed() {
  const u = mk(true)
  if u is D { print(legs(u)) }
}
function returned(): Pet {
  const u = mk(true)
  if u is D { return u }
  return { s: "none" }
}
function assigned() {
  const u = mk(true)
  let q: Pet = { s: "before" }
  if u is D { q = u }
  print(legs(q))
}
function listed() {
  const u = mk(true)
  if u is D {
    const ps: Pet[] = [u]
    print(legs(ps[0]))
  }
}
bound()
passed()
print(legs(returned()))
assigned()
listed()
const g = mk(true)
if g is D {
  const gq: Pet = g
  print(legs(gq))
}
