// @run
// @log 6
// @log 7
// @log null
// @log 6
// @log 2
// @log 5
// @log 8
// @log 9
// @hint redundant type annotation: `w` is inferred as `Pa | null`
// Values of `Pa | Pb | null` over same-shape records, the nullable record at every position,
// crossing between a binding and a list element or map value: store, push, list literal, read
// into a binding, a parameter and return, and nested cells.
type Pa = { tag: i32, val: i32 }
type Pb = { tag: i32, val: i32 }
function pick(n: i32): Pa | Pb {
  const b: Pb = { tag: 2, val: n }
  return b
}
function first(xs: (Pa | Pb | null)[]): Pa | Pb | null { return xs[0] }
const v: Pa | Pb | null = pick(6)
const xs: (Pa | Pb | null)[] = [pick(5), null]
const m: { [string]: Pa | Pb | null } = Map()
m["k"] = v
xs.push(v)
const w: Pa | Pb | null = xs[2]
if v != null { print(v.val) }
if xs[0] != null { print(xs[0].val + xs[0].tag) }
if xs[1] == null { print("null") }
if m["k"] != null { print(m["k"].val) }
if w != null { print(w.tag) }
const f = first(xs)
if f != null { print(f.val) }
const nested: (Pa | Pb | null)[][] = [[pick(8)]]
if nested[0][0] != null { print(nested[0][0].val) }
const mm: { [string]: (Pa | Pb | null)[] } = Map()
mm["a"] = [pick(9)]
const ys = mm["a"] ?? []
if ys[0] != null { print(ys[0].val) }
