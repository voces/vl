// @run
// @log 1
// @log 1
// @log 2
// @hint redundant type annotation: `a` is inferred as `{r: i32}[]` — remove it to lean on inference
// @hint redundant type annotation: `bx` is inferred as `{xs: Shape[]}` — remove it to lean on inference
// @hint redundant type annotation: `oz` is inferred as `{xs: i32[]}` — remove it to lean on inference
// THE FALSE REJECT A FIELD-NAME-ONLY KEY BUYS (D852), kept as a fixture because the
// name-only key was built first and this program is what refuted it.
//
// `Box.xs` and `Other.xs` share a field NAME and nothing else. Keyed on the name alone,
// `oz.xs.push(2)` reads as a write to the covariant list `b` and the program is refused —
// measured: `1 1 2` on master, a `WRITTEN THROUGH` check reject with the wider key. Pairing
// the field with the CONTAINER'S BINDING NAME separates them, and this file is the standing
// witness that it has to.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box = { xs: Shape[] }
type Other = { xs: i32[] }

function f() {
  const a: Circle[] = [{ r: 7 }]
  const b: Shape[] = a
  const bx: Box = { xs: b }
  const oz: Other = { xs: [1] }
  oz.xs.push(2)
  print(a.length)
  print(bx.xs.length)
  print(oz.xs.length)
}

f()
