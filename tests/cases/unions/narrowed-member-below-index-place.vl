// @run
// @log 8
// @log 8
// @log 8
// @log 0
// @log 8
// A MEMBER link below an INDEX (`ws[0].xs[0]`). The emitter keys index places and member
// paths with two functions, and the member one answers "" for an index receiver by design —
// a dozen member-shaped readers read that "" as "not a narrowable place". So the checker
// narrowed the place and the emitter did not, and the read unboxed nothing (D1743).
//
// The link is keyed in the INDEX keyer, which is where D451 said it may be: `memberPathKeyOf`
// keeps its contract, and the recursion through an index root is reached only from callers
// that already key index places.

type A = { r: i32 }
type M = i32 | A
type W = { xs: M[] }

function st(): A { return { r: 8 } }
function pick(b: boolean): M {
  if b { return st() }
  return 7
}

const w = { xs: [pick(true)] }

// The link itself.
const ws = [w]
if ws[0].xs[0] is A { print(ws[0].xs[0].r) } else { print(0) }

// Two index links below the member, so the recursion is not one level deep by accident.
const wss = [[w]]
if wss[0][0].xs[0] is A { print(wss[0][0].xs[0].r) } else { print(0) }

// A member link below the member link below the index.
type V = { w: W }
const vs = [{ w: w }]
if vs[0].w.xs[0] is A { print(vs[0].w.xs[0].r) } else { print(0) }

// The negative arm, so a claim is not being made unconditionally.
const wn = { xs: [pick(false)] }
const wns = [wn]
if wns[0].xs[0] is A { print(wns[0].xs[0].r) } else { print(0) }

// A write to the LIST between the narrow and the read: the checker retires the narrowing by
// prefix, so the re-narrowed read is the one that must still find the cell.
const wm = { xs: [pick(false)] }
const wms = [wm]
if wms[0].xs[0] is A {
  print(0)
} else {
  wms[0].xs = [st()]
  if wms[0].xs[0] is A { print(wms[0].xs[0].r) } else { print(0) }
}
