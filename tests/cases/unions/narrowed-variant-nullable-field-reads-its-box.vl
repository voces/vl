// @run
// @log 41
// @log -2
// @log 103
// @log -1
// @log 7
// @log 13
// @log 0
// @log 1
// A field of a union variant stored as a union box and read off a value narrowed to that variant
// is the box itself, as legacy reads it: an `i64 | null` field, a record-or-null field and a
// closure-or-null field, each read at a set value and at `null`.
type P = { n: i32 }
type A = { tag: "a", x: i64 | null, p: P | null, f: ((k: i32) => i32) | null }
type B = { tag: "b", y: i32 }
type U = A | B
function show(u: U) {
  if u is A {
    print(u.x ?? -1)
    const p = u.p
    if p != null { print(p.n) } else { print(-2) }
    const g = u.f ?? ((k: i32) => 100 + k)
    print(g(3))
  }
}
show({ tag: "a", x: 41, p: null, f: null })
show({ tag: "a", x: null, p: { n: 7 }, f: (k: i32) => 10 + k })
show({ tag: "b", y: 9 })
function count(u: U): i32 {
  if u is A { return if u.x != null { 1 } else { 0 } }
  return 0
}
print(count({ tag: "a", x: null, p: null, f: null }))
print(count({ tag: "a", x: 5, p: null, f: null }))
