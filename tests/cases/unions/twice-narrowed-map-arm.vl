// @run
// @log 1
// @log true
// @log 1
// @log 2
// @log hi

// D1864 — a union narrowed to its MAP arm behind a PRIOR narrowing. The second narrowing banks
// the ALIAS the program wrote where the first banked the rendered `{[K]: V}` spelling, and the
// map classifier's last rung is a name test that cannot see through it — while the arena row it
// already consulted says map at both. It renders that row instead.

import { Json, JsonError, parseJson } from "std:json"

type JsonMap = { [string]: Json }

// `.size`, the witness.
const row = parseJson("{\"a\": 1}")
if row is JsonError {
  print("err")
} else {
  if row is JsonMap { print(row.size) } else { print("not an object") }
}

// `.has(k)` and `m[k]` — `std/json.vl`'s header promises both beside each other, so a close
// owes both at the twice-narrowed position, not only the spelling the witness prints.
const r2 = parseJson("{\"a\": 1}")
if r2 is JsonError {
  print("err")
} else {
  if r2 is JsonMap { print(r2.has("a")) } else { print("not an object") }
}

const r3 = parseJson("{\"a\": 1}")
if r3 is JsonError {
  print("err")
} else {
  if r3 is JsonMap {
    const v = r3["a"]
    if v is f64 { print(v) } else { print("not f64") }
  } else {
    print("not an object")
  }
}

// The row's own boundary: the array and string arms behind the same guard ran before and must
// keep running, or the family moved rather than closing.
const r4 = parseJson("[1, 2]")
if r4 is JsonError {
  print("err")
} else {
  if r4 is Json[] { print(r4.length) } else { print("not an array") }
}

const r5 = parseJson("\"hi\"")
if r5 is JsonError {
  print("err")
} else {
  if r5 is string { print(r5) } else { print("not a string") }
}
