// @run
// @log g-f64 yes
// @log alias true
// @log g-i64 yes
// @log g-str yes
// @log g-nul yes
// @log else true
// @log fn-g yes
// @log cell yes
// @log clo-cell yes
// @log local-alias true
// @log loop yes
// @log loop yes
// @log m-null 0
// @log m-sa 7
// @log m-sc 0
// @log m-sb 5
// @info `gf` is never reassigned; use `const` instead of `let`
// @info `gi` is never reassigned; use `const` instead of `let`
// @info `gs` is never reassigned; use `const` instead of `let`
// @info `gn` is never reassigned; use `const` instead of `let`
// @info `u` is never reassigned; use `const` instead of `let`
// @hint redundant type annotation: `nulMatch` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `triMatch` is inferred as `i32` — remove it to lean on inference
// A second `is` inside the narrowing of a value-union place that is not a frame slot: a
// module global, an index cell, a closure-written local (a shared cell), and a `const` alias of
// any of them. Each read is already unboxed to the member, so the test is the checker's
// tautology rather than a tag read (D2447, D2442).
let gf: f64 | boolean = 1.5
let gi: i64 | boolean = 7
let gs: string | i32 = "hi"
let gn: i32 | null = 4
if gf is f64 {
  if gf is f64 { print("g-f64 yes") } else { print("g-f64 no") }
  const w = gf
  print("alias " + (if w is f64 { "true" } else { "false" }))
}
if gi is i64 {
  if gi is i64 { print("g-i64 yes") } else { print("g-i64 no") }
}
if gs is string {
  if gs is string { print("g-str yes") } else { print("g-str no") }
}
if gn != null {
  if gn is i32 { print("g-nul yes") } else { print("g-nul no") }
}

function mk(): i32 | string { return 5 }
const x = mk()
if x is string {
  print("else false")
} else {
  print("else " + (if x is i32 { "true" } else { "false" }))
}

function inFn() {
  if gf is f64 {
    if gf is f64 { print("fn-g yes") } else { print("fn-g no") }
  }
}
inFn()

function cell(xs: (f64 | boolean)[]) {
  if xs[0] is f64 {
    if xs[0] is f64 { print("cell yes") } else { print("cell no") }
  }
}
cell([2.5])

function cloCell() {
  let v: f64 | boolean = 1.5
  const reset = () => {
    v = 1.5
  }
  if v is f64 {
    if v is f64 { print("clo-cell yes") } else { print("clo-cell no") }
  }
  reset()
}
cloCell()

function localAlias() {
  let u: f64 | boolean = 1.5
  if u is f64 {
    const z = u
    print("local-alias " + (if z is f64 { "true" } else { "false" }))
  }
}
localAlias()

let i = 0
while i < 2 {
  if gf is f64 {
    if gf is f64 { print("loop yes") } else { print("loop no") }
  }
  i = i + 1
}

// A `match` scrutinee is one node every arm's test reads, so its recorded type is no single
// test's and the tautology must not answer from it.
type Sa = { v: i32, a: i32 }
type Sb = { v: i32, b: i32 }
type Sc = { v: i32, c: i32 }
function nulMatch(n: Sa | null): i32 {
  match n {
    Sa{a} => a
    _ => 0
  }
}
print("m-null " + (if nulMatch(null) == 0 { "0" } else { "?" }))
print("m-sa " + (if nulMatch({ v: 1, a: 7 }) == 7 { "7" } else { "?" }))
function triMatch(s: Sa | Sb | Sc): i32 {
  match s {
    Sa{a} => a
    Sb{b} => b
    _ => 0
  }
}
print("m-sc " + (if triMatch({ v: 1, c: 3 }) == 0 { "0" } else { "?" }))
print("m-sb " + (if triMatch({ v: 1, b: 5 }) == 5 { "5" } else { "?" }))
