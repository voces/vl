// @run
// @log I
// @log 8
// @log B
// @log true
// @log false
// @log true
// @log 5
// @log false
// @log 9
// @log mi
// @log mb
// @log true
// @log 8
// D2769's nested twin: `boolean[][]` and `i32[][]` share a reflist slot and tag apart, as each
// deeper boolean-leaf list does, beside the flat lists and the map arms that share one struct.
function mk(c: boolean, t: boolean) {
  if c { return [[t, false]] }
  [[7, 8]]
}
function use(v: boolean[][] | i32[][]) {
  if v is boolean[][] {
    print("B")
    for x in v[0] { print(x) }
  } else {
    print("I"); print(v[0][1])
  }
  0
}
use(mk(false, true))
use(mk(true, true))
function depth(k: i32): boolean[] | i32[][] | boolean[][] | i32[] {
  if k == 0 { return [true] }
  if k == 1 { return [[5]] }
  if k == 2 { return [[false]] }
  [9]
}
function show(v: boolean[] | i32[][] | boolean[][] | i32[]) {
  if v is boolean[] { print(v[0]) }
  if v is i32[][] { print(v[0][0]) }
  if v is boolean[][] { print(v[0][0]) }
  if v is i32[] { print(v[0]) }
}
show(depth(0))
show(depth(1))
show(depth(2))
show(depth(3))
function mt(k: i32): {[string]: i32} | {[string]: boolean} | boolean[] | i32[] {
  if k == 0 {
    const m: {[string]: i32} = Map()
    m.set("a", 1)
    return m
  }
  if k == 1 {
    const m: {[string]: boolean} = Map()
    m.set("a", true)
    return m
  }
  if k == 2 { return [true] }
  [8]
}
function showm(v: {[string]: i32} | {[string]: boolean} | boolean[] | i32[]) {
  if v is {[string]: i32} { print("mi") }
  if v is {[string]: boolean} { print("mb") }
  if v is boolean[] { print(v[0]) }
  if v is i32[] { print(v[0]) }
}
showm(mt(0))
showm(mt(1))
showm(mt(2))
showm(mt(3))
