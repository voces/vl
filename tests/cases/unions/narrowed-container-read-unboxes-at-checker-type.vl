// @run
// @log 4
// @log -1
// @log 2
// @log 2
// @log 1
// @log 3
// @log 3
// @log 7
// @log 7
// @log 2
// @log 2
// @log true
// @log 9
// @log 9
// @hint redundant type annotation: `ms` is inferred as `({[string]: R} | i32)[]`
// A union read the checker types as a ref-element list or a map unboxes to that container at
// its identifier, field, element and map-value places, whether the union is annotated or
// inferred, and the unboxed value delivers into a binding, an argument and a return alike.
type P = { n: i32 }
type R = { x: i32 }
type B = { v: P[] | string }
function len(xs: P[]) { xs.length }
function vx(m: {[string]: R}) { (m["a"] ?? { x: 0 }).x }
function f(x: P[] | string) {
  if !(x is P[]) { return -1 }
  x[0].n
}
function back(b: B): P[] {
  if b.v is string { return [] }
  b.v
}
print(f([{ n: 4 }]))
print(f("s"))
const one = 1
const u = if one > 0 { [{ n: 1 }, { n: 2 }] } else { "s" }
if u is string {
  print(0)
} else {
  const xs = u
  print(xs.length)
  print(len(u))
}
const b: B = { v: [{ n: 3 }] }
print(back(b).length)
if !(b.v is string) {
  const fv = b.v
  print(fv[0].n)
  print(len(b.v) + 2)
}
const h: {[string]: R} = Map()
h["a"] = { x: 7 }
const ms: ({[string]: R} | i32)[] = [h, 1]
if !(ms[0] is i32) {
  const m0 = ms[0]
  print(vx(m0))
  print(vx(ms[0]))
}
const ls = [[{ n: 1 }, { n: 1 }], "t"]
if ls[0] is string {
  print(0)
} else {
  const l0 = ls[0]
  print(l0.length)
  print(len(ls[0]))
}
const w: {[string]: R} | boolean = h
if w is boolean { print(false) } else { print(w.has("a")) }
const hm: {[string]: P[] | string} = Map()
hm["k"] = [{ n: 9 }]
const hv = hm["k"]
if hv != null && !(hv is string) { print(hv[0].n) }
if hm["k"] is P[] { print(len(hm["k"] ?? []) + 8) }
