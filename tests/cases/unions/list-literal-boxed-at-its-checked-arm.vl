// @run
// @log 2.5
// @log 1.5
// @log 2
// A list literal passed where a recursive union is expected is built at the union's list arm, its
// type at that position, and boxed under that arm's tag: one level, two levels, and a string list.
type Json = null | boolean | f64 | string | Json[] | { [string]: Json }
function leaf(c: Json): f64 {
  if c is Json[] {
    const e = c[0]
    if e is f64 { return e }
    if e is Json[] {
      const f = e[0]
      if f is f64 { return f }
    }
  }
  return 0.0
}
function count(c: Json): i32 {
  if c is Json[] { return c.length }
  return 0
}
function one() { print(leaf([2.5])) }
function two() { print(leaf([[1.5]])) }
function strs() { print(count(["a", "b"])) }
one()
two()
strs()
