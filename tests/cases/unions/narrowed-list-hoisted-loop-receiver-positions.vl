// @run
// @log 2
// @log 4
// @log 16
// @log 7.5
// @log 3
// @log 0
// Q58 position sweep: a list narrowed out of a union box by an early return, the receiver of a
// loop's hoisted `.length` and element reads, which the hoist reads again as the narrowing read it
// (`irReadAgain`): a `u8[]` split by a separator, an `i32[]` and an `f64[]` summed, an inner loop's
// condition, and the error arm's early return.
type E = { msg: string }
function bytes(n: i32): u8[] | E {
  if n < 0 { return { msg: "no" } }
  return [1, 2, 3, 10, 4]
}
function ints(n: i32): i32[] | E {
  if n < 0 { return { msg: "no" } }
  return [1, 3]
}
function floats(n: i32): f64[] | E {
  if n < 0 { return { msg: "no" } }
  return [2.5, 5.0]
}
function split(n: i32) {
  const b = bytes(n)
  if b is E { return 0 }
  let a = 0
  let c = 0
  while a < b.length {
    let e = a
    while e < b.length && b[e] != 10 { e = e + 1 }
    c = c + 1
    a = e + 1
  }
  return c
}
function sumInts(n: i32) {
  const xs = ints(n)
  if xs is E { return -1 }
  let s = 0
  let i = 0
  while i < xs.length {
    s = s + xs[i]
    i = i + 1
  }
  return s
}
function weighted(n: i32) {
  const b = bytes(n)
  if b is E { return -1 }
  let s = 0
  let i = 0
  while i < b.length {
    if b[i] != 10 { s = s + b[i] * 2 - 1 }
    i = i + 1
  }
  return s
}
function sumFloats(n: i32) {
  const xs = floats(n)
  if xs is E { return -1.0 }
  let s = 0.0
  let i = 0
  while i < xs.length {
    s = s + xs[i]
    i = i + 1
  }
  return s
}
function count(n: i32) {
  const b = bytes(n)
  if b is E { return 0 }
  let k = 0
  let i = 0
  while i < b.length {
    if b[i] < 4 { k = k + 1 }
    i = i + 1
  }
  return k
}
print(split(1))
print(sumInts(1))
print(weighted(1))
print(sumFloats(1))
print(count(1))
print(split(-1))
