// @run
// A record literal joined with a declared record in an inferred list is the anonymous arm of the
// element union, and builds that arm's struct by its shape, nested in a field too (D14511).
type Sq = { s: i32 }
const c: Sq = { s: 1 }
const xs = [{ r: 7 }, c]
for x in xs {
  if x is Sq { print(x.s) } else { print(x.r) }
}
const ps = [{ p: { r: 8 } }, { p: c }]
for x in ps {
  const q = x.p
  if q is Sq { print(q.s) } else { print(q.r) }
}
const qs: { p: { r: i32 } | Sq }[] = [{ p: { r: 9 } }, { p: c }]
for x in qs {
  const q = x.p
  if q is Sq { print(q.s) } else { print(q.r) }
}
const ys = [{ r: 2 }, c]
ys.push({ r: 3 })
ys[0] = { s: 5 }
for y in ys {
  if y is Sq { print(y.s) } else { print(y.r) }
}
// @log 7
// @log 1
// @log 8
// @log 1
// @log 9
// @log 1
// @log 5
// @log 1
// @log 3
