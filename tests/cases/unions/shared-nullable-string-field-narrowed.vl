// @run
// @log hi!
// @log hi
// @log none
// A `string | null` field every arm carries, read off the un-narrowed union after a member null
// test, is the non-null string in every string slot (D16728).
type A = { v: string | null }
type B = { v: string | null, w: i32 }
function f(x: A | B): string {
  if x.v != null { print(x.v + "!") }
  if x.v == null { return "none" }
  return x.v
}
print(f({ v: "hi" }))
print(f({ v: null, w: 3 }))
