// @run
// @log 1
// @log 0
// @log 2
// @log 1
// @log 0
// @log 2
// A deep `is` site anywhere in the module must not re-spell an annotation elsewhere (D1744).
//
// `checkProgram` ends in `canonEmitTypeNames`, which rewrites each annotation into the
// emitter's vocabulary — a union alias member becomes its flattened member set, a different
// arm set. The deep-`is` route re-checks the whole program in a second pass, so unless the
// author's spellings go back first, `d: K | i32` reads as `"aa" | "bb" | i32` and `d is K`
// names no arm the emitter can index.
//
// Both orders, because the effect is whole-program and not sequential: `walkBefore` is
// declared ahead of `armTest` and `walkAfter` behind it, and either one alone reproduces it.

type Json = null | boolean | f64 | string | Json[] | { [string]: Json }
type Cfg = { port: f64 }
type K = "aa" | "bb"

function walkBefore(e: Json) {
  if e is Cfg { return 2 }
  0
}

function armTest(d: K | i32) {
  if d is K { return 1 }
  0
}

function walkAfter(e: Json) {
  if e is Cfg { return 2 }
  0
}

function mkCfg(): Json {
  const m: { [string]: Json } = Map()
  m["port"] = 1.0
  m
}

const k0: K = "aa"
print(armTest(k0))
print(armTest(3))
print(walkBefore(mkCfg()))
print(armTest(k0))
print(armTest(3))
print(walkAfter(mkCfg()))
