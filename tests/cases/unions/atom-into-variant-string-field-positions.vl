// @run
// @log kb
// @log kb!
// @log ka
// @log ka!
// A literal-union atom delivered into a variant record's string field is its member string: at
// the variant's own type and at the union it is an arm of.
type K = "ka" | "kb"
type R = { f: K }
type VA = { s: string }
type VB = { w: i32 }
type VU = VA | VB
function variantCtor(r: R) {
  const a: VA = { s: r.f }
  print(a.s)
  const u: VU = { s: r.f }
  if u is VA { print(u.s + "!") }
}
variantCtor({ f: "kb" })
variantCtor({ f: "ka" })
