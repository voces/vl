// @run
// @log true
// @log false
// @log false
// @log false
// @log true
// @log false
// @log true
// @log false
// D973 — `==` OVER A STRUCT UNION (`A | B` of declared shapes).
//
// It rides the SAME `{tag, payload}` box a value union does, so the dispatch is the value
// union's: tags unequal means different arms and therefore unequal; tags equal selects ONE
// arm. Only the per-arm field compare had to be written.
//
// AND NOT THROUGH `emitStructEqRec`, which already does field-wise struct compares: that is
// keyed on a STRUCT-TABLE row, and `emit_state`'s own header says the table is EMPTY when a
// union is declared — the union path owns the types instead. Measured: `sHeapIdx.length` is 0
// for a program like this one. The arms' fields live in `uFieldNames` / `uFieldTypes`.
type A = { a: i32 }
type B = { b: i32 }

function mk(n: i32): A | B {
  if n > 0 { return { a: n } }
  { b: 2 }
}

const u = mk(1)
const v = mk(1)
print(u == v)
print(u != v)

// DIFFERENT ARMS are unequal without ever comparing fields.
const w = mk(0)
print(u == w)

// SAME arm, different field value.
const x = mk(3)
print(u == x)

// A STRING field, so the compare is not i32-only.
type S = { s: string }
type T = { t: i32 }

function mks(n: i32): S | T {
  if n > 0 { return { s: "x" } }
  { t: 2 }
}

const p = mks(1)
const q = mks(1)
print(p == q)
print(p == mks(0))

// THREE arms, so the tag chain is not a two-arm special case.
type C = { c: i32 }

function mk3(n: i32): A | B | C {
  if n == 1 { return { a: 1 } }
  if n == 2 { return { b: 2 } }
  { c: 3 }
}

print(mk3(3) == mk3(3))
print(mk3(3) == mk3(2))
