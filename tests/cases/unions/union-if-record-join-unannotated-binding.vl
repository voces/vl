// @run
// A value `if` over a union `is` test whose arms are records, bound un-annotated at module scope,
// where legacy writes the join into the global at the binding's row, and inside a function.
type Out = { a: i32 }
type Err = { msg: string }
const r: Out | Err = { a: 3 }
const o = if r is Out { r } else { { a: 0 } }
print(o.a)
const e: Out | Err = { msg: "no" }
const p = if e is Out { e } else { { a: 9 } }
print(p.a)
function inFn(x: Out | Err) {
  const q = if x is Out { x } else { { a: 0 } }
  return q.a
}
print(inFn(r))
print(inFn(e))
// @log 3
// @log 9
// @log 3
// @log 0
