// @run
// @log 2
// @log true
// @log 3
// @log false
// @log 5
// @log 4
// @log 1
// @log 7
// @log none
// An index read the checker narrowed past `null` reads non-null: a nullable string, boolean
// and struct element, a map's string and boolean value, a nested cell and a member's list
// (D14536).
type P = { v: i32 }
type Box = { xs: (string | null)[] }
const xs: (string | null)[] = ["ab", null]
if xs[0] != null { print(xs[0].length) }
const bs: (boolean | null)[] = [true, null]
if bs[0] != null { print(bs[0]) }
const ms: Map<string, string> = Map()
ms["k"] = "abc"
if ms["k"] != null { print(ms["k"].length) }
const mb: Map<string, boolean> = Map()
mb["k"] = false
if mb["k"] != null { print(mb["k"]) }
const ps: (P | null)[] = [null, { v: 5 }]
if ps[1] != null { print(ps[1].v) }
const ys: (string | null)[][] = [["wxyz", null]]
if ys[0][0] != null { print(ys[0][0].length) }
const b: Box = { xs: [null, "q"] }
if b.xs[1] != null { print(b.xs[1].length) }
function f(zs: (P | null)[]) {
  if zs[0] == null { return 0 }
  zs[0].v
}
print(f([{ v: 7 }]))
if xs[1] != null { print(xs[1].length) } else { print("none") }
