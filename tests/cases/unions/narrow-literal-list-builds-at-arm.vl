// D14871: a list of record literals narrower than a union arm is built as the arm's list, as its
// elements are built at the arm.
type Circle = { r: i32 | null }
type Sq = { s: i32 }
type Shape = Circle | Sq
const xs = [{ r: null }]
print(xs.length)
const ys = [{ r: null }, { r: null }]
print(ys[0].r == null)
function mk() {
  return [{ r: null }, { r: null }]
}
print(mk().length)
