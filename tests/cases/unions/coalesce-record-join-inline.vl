// @run
// @hint redundant type annotation: `a` is inferred as `{r: i32}` — remove it to lean on inference
// @hint redundant type annotation: `b` is inferred as `{q: string}` — remove it to lean on inference
// @log true
// @log true
// @log true
// @log true
// @log true
// An inline `??` or value `if` joining records of different types, with no binding and no
// declaration naming the join: the test reads the join's box tag, not the left operand's row,
// and a chain's inner link boxes in the chain's union (D2373).

type A = { r: i32 }
type B = { q: string }
type C = { z: f64 }
function mkA(): A | null { return null }
function mkB(): B | null { return { q: "b" } }
function mkA2(): A | null { return { r: 7 } }
function mkN(): B | null { return null }
function mkC(): C | null { return { z: 1.5 } }

function inline(c: boolean) {
  print((mkA() ?? mkB()) is B)
  print((mkA2() ?? mkB()) is A)
  print((mkA() ?? mkN()) == null)
  print(((mkA() ?? mkN()) ?? mkC()) is C)
  const a: A = { r: 1 }
  const b: B = { q: "z" }
  print((if c { a } else { b }) is B)
}
inline(false)
