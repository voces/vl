// @run
// @hint redundant type annotation: `z` is inferred as `A | B` — remove it to lean on inference
// @log false true | false true | false true | false true | false true
// @log true false | true false | true false | true false | true false
// @log false true | false true | false true | false true | false true
// @log true false | true false | true false | true false | true false
// @log false false true | false false true | false false true
// @log true false false | true false false | true false false
// @log false true false | false true false | false true false
// @log true false false | true false false | true false false
// A left-nested `??` chain over two nullable records whose last default is a non-null record,
// either one of the two or a third: the chain is one box, tested by tag at every null
// combination, inline, bound without an annotation, and as both arms of a value `if` (D2373).

type A = { r: i32 }
type B = { q: string }
type C = { c: i32, z: f64 }
function mkA(n: i32): A | null {
  if n == 0 { return null }
  return { r: n }
}
function mkB(s: string): B | null {
  if s == "" { return null }
  return { q: s }
}
function stB(): B { return { q: "d" } }
function stC(): C { return { c: 9, z: 2.5 } }

function toB(ka: i32, sb: string, flag: boolean) {
  const inl = "\{((mkA(ka) ?? mkB(sb)) ?? stB()) is A} \{((mkA(ka) ?? mkB(sb)) ?? stB()) is B}"
  const x = mkA(ka) ?? mkB(sb) ?? stB()
  const y = if flag { (mkA(ka) ?? mkB(sb)) ?? stB() } else { (mkA(ka) ?? mkB(sb)) ?? stB() }
  const z: A | B = mkA(ka) ?? mkB(sb) ?? stB()
  print(
    inl
      + " | \{x is A} \{x is B} | \{y is A} \{y is B} | \{z is A} \{z is B}"
      + " | \{(if flag { (mkA(ka) ?? mkB(sb)) ?? stB() } else { stB() }) is A} \{(if flag { (mkA(ka) ?? mkB(sb)) ?? stB() } else { stB() }) is B}",
  )
}
toB(0, "", true)
toB(7, "", true)
toB(0, "b", true)
toB(7, "b", true)

function toC(ka: i32, sb: string, flag: boolean) {
  const inl = "\{((mkA(ka) ?? mkB(sb)) ?? stC()) is A} \{((mkA(ka) ?? mkB(sb)) ?? stC()) is B} \{((mkA(ka) ?? mkB(sb)) ?? stC()) is C}"
  const x = mkA(ka) ?? mkB(sb) ?? stC()
  const y = if flag { (mkA(ka) ?? mkB(sb)) ?? stC() } else { (mkA(ka) ?? mkB(sb)) ?? stC() }
  print(
    inl + " | \{x is A} \{x is B} \{x is C} | \{y is A} \{y is B} \{y is C}",
  )
}
toC(0, "", true)
toC(7, "", true)
toC(0, "b", true)
toC(7, "b", true)
