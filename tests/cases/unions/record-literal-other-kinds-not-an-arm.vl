// @run
// @log 2
// @log 1
// @log true
// @log 1.5
// @log 7
// @log 4
// D3024 — an un-annotated record literal whose field NAMES equal a union arm's is not that arm
// when a field's scalar kind cannot be stored there: an `i32` is no `"a"` (a string) slot, a
// `boolean` no `i32` one, an `f64` no `boolean` one. It builds its own record instead.
type A = { kind: "a", n: i32 } | { kind: "b" }
type B = { flag: i32, m: i32 } | { none: i32 }
type C = { f: boolean, g: i32 } | { none: i32 }
const o = { kind: 1, n: 2 }
print(o.n)
print(o.kind)
const p = { flag: true, m: 3 }
print(p.flag)
function mk() { return { f: 1.5, g: 7 } }
const q = mk()
print(q.f)
print(q.g)
const xs = [{ kind: 3, n: 4 }]
print(xs[0].n)
