// @run
// @log z
// @log 0
// @log 7
// @log 7
// A literal whose field is `null` is the union member whose field stores only `null`, even when
// another record with that field name stores a string.

function other() {
  const b = { r: "z" }
  print(b.r)
}

function rd(a: {r: i32} | {r: null}) {
  if a.r != null { print(a.r) } else { print(0) }
}

function rd2() {
  let a: {r: i32} | null = { r: 7 }
  print(a?.r ?? 0)
  const g1 = a ?? { r: null }
  a = null
  const g2 = a ?? { r: null }
  if g2.r != null { print(9) } else { print(g1.r ?? 0) }
}

other()
rd({ r: null })
rd2()
