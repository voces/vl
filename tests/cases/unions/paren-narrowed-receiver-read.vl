// @run
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// A PARENTHESIZED RECEIVER reads a narrowed union arm exactly like the bare spelling
// (silent-class-inventory D222). `paren-is-narrow.vl` beside this pins the parens in the
// CONDITION; these are parens on the READ, which is a different set of readers.
//
// SIX paren-blind reads, not three. `memIsNarrowed`, `memNarrowVariantIndex` and
// `emitNarrowedMem` each did `P.nodes[m.memObj]` and tested `is Ident` / `is Member`, so a
// `Paren` receiver was "not narrowed" and the read fell to the plain-struct path
// (`emitProgram: field access but no struct type declared`). Unwrapping the receiver in
// those three closes the IDENT half — and leaves the nested-PATH half, because all three
// then hand the SAME raw receiver to `memberPathKeyOf`, which peeled a `Paren` off its
// receiver but not off its own node. `(t.v).r` under `if t.v is Circle` stayed loud until
// the key unwrapped too.
//
// Every parenthesized form sits beside its unparenthesized control.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Holder = { v: Shape }
type Wrap = { r: i32, s: string }
type Wsq = { z: i32 }
type Wu = Wrap | Wsq

function bare(v: Shape) { if v is Circle { print(v.r) } }
bare({ r: 7 })

function paren(v: Shape) { if v is Circle { print((v).r) } }
paren({ r: 7 })

function paren2(v: Shape) { if v is Circle { print(((v)).r) } }
paren2({ r: 7 })

function barePath(t: Holder) { if t.v is Circle { print(t.v.r) } }
barePath({ v: { r: 7 } })

function parenPath(t: Holder) { if t.v is Circle { print((t.v).r) } }
parenPath({ v: { r: 7 } })

// THE INNER LINK parenthesized (`(t).v.r`) IS NOT HERE, and it is not an oversight: it is a
// LOUD CHECK reject — `field 'r' is not on every member of Shape` — on the base and on this
// branch alike, because the CHECKER's own path key is paren-blind in the same way the
// emitter's was. Different file, different fix; filed as silent-class-inventory D352 with
// this program as its witness.
//
// A STRING-bearing arm, so the read is not only the i32 field code.
function parenStr(w: Wu) { if w is Wrap { print((w).r) } }
parenStr({ r: 7, s: "a" })
