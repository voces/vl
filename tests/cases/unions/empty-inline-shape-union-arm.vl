// @run
// @log 5
// @log 6
// @log 9
// @log 10
// An EMPTY inline object shape (`{}`) as a union arm. Nothing here is malformed, which was
// the whole complaint: `emitProgram: malformed inline union-variant shape` fired on a `vl
// check`-clean program, and the ALIAS spelling of the same type (`type E = {}` then `E | S`)
// already ran — so the compiler agreed about everything except one split (D1081).
//
// `shapeInnerFieldSplit` runs `tyTopLevelSplit` with `dropEmpty=false`, deliberately, so a
// malformed `{a:i32,,b:i32}` keeps its empty part and is REPORTED rather than silently
// shrunk. On the EMPTY interior of `{}` that same rule pushed ONE part whose `indexOf(":")`
// is -1, so all thirteen callers received a single field named `""` and
// `collectShapeVariantFields`' `fnames[fi] == ""` guard fired on a shape with no fields at
// all. The guard is on the INTERIOR, not on the part list, so the malformed-input contract
// is untouched.
type U = {} | { x: i32 }
type V = { x: i32 } | {}
type W = {} | { x: i32 } | { y: i32 }

function firstArm(u: U) {
  if u is { x: i32 } { return u.x }
  return -1
}

// The empty arm SECOND, so the fix cannot depend on its position in the member set.
function secondArm(v: V) {
  if v is { x: i32 } { return v.x }
  return -1
}

function threeArms(w: W) {
  if w is { x: i32 } { return w.x }
  if w is { y: i32 } { return w.y }
  return -1
}

// The zero-field arm has no value to construct, since a bare `{}` is refused (D2223); the
// shapes still declare, split and discriminate their other arms.
print(firstArm({ x: 5 }))
print(secondArm({ x: 6 }))
print(threeArms({ x: 9 }))
print(threeArms({ y: 10 }))
