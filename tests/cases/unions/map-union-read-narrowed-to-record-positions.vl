// @run
// @log 8
// @log 8
// @log 8
// @log 8
// @log 0
// @log -1
// A read of a union-valued map narrowed to its record member: the value's box is read whole and
// narrowed to the record. Positions: `const`, argument, record field, and a `return` that the
// narrowing inside the function reaches.
type A = { r: i32 }
type M = i32 | A

function mk(b: boolean): M {
  if b { return { r: 8 } }
  return 7
}
function takeA(a: A) { print(a.r) }
function pick(m: {[string]: M}): A {
  if m["k"] is A { return m["k"] }
  return { r: -1 }
}
function run(b: boolean) {
  const m: {[string]: M} = Map()
  m["k"] = mk(b)
  if m["k"] is A {
    const q = m["k"]
    print(q.r)
    takeA(m["k"])
    const box = { a: m["k"] }
    print(box.a.r)
  } else {
    print(0)
  }
  print(pick(m).r)
}
run(true)
run(false)
