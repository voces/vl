// @run
// @log false
// @log 0
// @log 0
// An empty `Map()` delivered to a union with two map arms is built as the first, as an empty `[]`
// is built as a union's first list arm: it is a value of either.
type U = null | f64 | { [string]: f64 } | { [string]: U }
const j: U = Map()
print(j == null)
if j is { [string]: f64 } { print(j.length) }
type V = { [string]: string } | { [string]: i32 } | null
const k: V = Map()
if k is { [string]: string } { print(k.length) }
