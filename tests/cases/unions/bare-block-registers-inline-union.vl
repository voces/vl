// @run
// @log 2
// @log 2
// @log 2
// @log 2
// @log 2
// @log 2
// @log 2
// @hint redundant type annotation: `mkStr` is inferred as `string` — remove it to lean on inference
// @hint redundant type annotation: `mkList` is inferred as `i32[]` — remove it to lean on inference
// A union spelled ONLY inside a bare `{ … }` block. The registration walk's statement ladder
// had arms for the four block-BEARING statements and none for the block that is a statement in
// its own right, so its declarations were never visited and the map arm's `is` test took the
// else branch on a value that IS the map (D1900). The `if` and `while` bodies are the controls
// that already ran, and the `string`/`i32[]` arms are the ones whose reps answer without the
// registry.

function mkMap(): { [string]: i32 } {
  const m: { [string]: i32 } = Map()
  m["a"] = 1
  m["b"] = 2
  m
}

function mkStr(): string { "hi" }

function mkList(): i32[] { [1, 2] }

// The row's own witness: a bare block at MODULE scope.
{
  const v: { [string]: i32 } | i32 = mkMap()
  if v is { [string]: i32 } { print(v.size) } else { print(-1) }
}

// A block nested in a block — one level was not the ingredient.
{
  {
    const v: { [string]: i32 } | i32 = mkMap()
    if v is { [string]: i32 } { print(v.size) } else { print(-1) }
  }
}

// The same bare block inside a FUNCTION. Module scope was not the ingredient either, which is
// what separates this from the module-block family (D1244, D1751, D1861, D1862).
function go() {
  {
    const v: { [string]: i32 } | i32 = mkMap()
    if v is { [string]: i32 } { print(v.size) } else { print(-1) }
  }
}
go()

// The two block-BEARING controls, which had their arms all along.
if true {
  const v: { [string]: i32 } | i32 = mkMap()
  if v is { [string]: i32 } { print(v.size) } else { print(-1) }
}

let n = 0
while n < 1 {
  n = n + 1
  const v: { [string]: i32 } | i32 = mkMap()
  if v is { [string]: i32 } { print(v.size) } else { print(-1) }
}

// The other two arm types in the same bare block: correct before the fix, because their reps
// answer the `is` test without a registry row.
{
  const s: string | i32 = mkStr()
  if s is string { print(s.length) } else { print(-1) }
}

{
  const l: i32[] | i32 = mkList()
  if l is i32[] { print(l.length) } else { print(-1) }
}
