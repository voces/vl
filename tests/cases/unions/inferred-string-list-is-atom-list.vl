// @run
// @log y
// @log no
// @log x
// @log x
// @log y
// @log true
// @log true
// @log x
// D4916: a string list narrowed by `is K[]` still reads its elements as strings, whether the
// parameter is un-annotated, generic, iterated or compared.
type K = "x" | "y"
function t(a) {
  if a is K[] { print(a[0]) } else { print("no") }
}
function u<T>(a: T) {
  if a is K[] { print(a[0]) } else { print("no") }
}
function w(a) {
  if a is K[] {
    for k in a { print(k) }
  }
}
function v(a) {
  if a is K[] {
    const z = a[0]
    print(z == "y")
    print(a[1] == "x")
  }
}
function s(a) {
  if a is K[] { print(a[0]) }
}
t(["y"])
t(["q"])
u(["x"])
w(["x", "y"])
v(["y", "x"])
const ks: K[] = ["x"]
s(ks)
