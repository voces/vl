// @run
// @log 1
// @log -1
// @log 1
// @log 3
// @log 3
// @log 211
// @log 15
// @log 2
// @log ab
// @log 42
// @log z
// @log b
// @log 2
// @log -1
// @log 8
// @log 5
// @log 2
// @log 5
// @log 300
// @log 300
// @log 2
// @log 4
// @log 6
// @log 11
// @log 411.5
// @hint redundant type annotation: `g` is inferred as `{xs: {rva: i32, name: string}[]}`
// The destinations are `readonly`: only a readonly list is covariant, and a mutable one is
// refused (DECISIONS.md "No implicit container widening").
// A struct that is an ARM of a two-struct union (`P` in `P | E`) keeps its fields in the
// variant tables, so its struct-list field `xs` must resolve there at every read: `for-in`,
// `.length`, index, push, element assign, a lambda, a capture, a nullable receiver, a call
// result, a module global, an un-annotated literal, a covariant widen, a map-narrowed
// receiver and two arms of different element layouts (D1960 / D1961 / D1963, plumb).
type S = { rva: i32, name: string }
type P = { xs: S[] }
type E = { msg: string }
function mk(n: i32): P | E {
  const xs: S[] = []
  if n > 5 { return { msg: "no" } }
  xs.push({ name: "a", rva: n })
  { xs: xs }
}
function find(self: P, r: i32) {
  for s in self.xs {
    if s.rva == r { return 1 }
  }
  -1
}
function findIx(self: P, r: i32) {
  for i in 0 until self.xs.length {
    const s = self.xs[i]
    if s.rva == r { return 1 }
  }
  -1
}
function viaLambda(self: P) {
  const f = (q: P) => q.xs.length
  f(self)
}
function viaCapture(self: P) {
  const g = () => self.xs[0].rva
  g()
}
function viaNullable(self: P | null) {
  if self != null {
    for s in self.xs { return s.rva }
  }
  -1
}
function mkP(): P { { xs: [{ rva: 8, name: "m" }] } }
function viaCall() {
  let t = 0
  for s in mkP().xs { t = t + s.rva }
  t
}
function viaPush(self: P) {
  self.xs.push({ rva: 11, name: "b" })
  self.xs.length * 100 + self.xs[self.xs.length - 1].rva
}
function viaTwoNames(self: P) {
  let t = 0
  for s, i in self.xs { t = t + i + s.rva }
  t
}
function viaFilter(self: P) { self.xs.filter((s) => s.rva > 0).length }
function viaLocal(self: P) {
  const ys = self.xs
  let out = ""
  for s in ys { out = out + s.name }
  out
}
function viaAssign(self: P) {
  self.xs[0] = { rva: 42, name: "z" }
  self.xs[0].rva
}
const g: P = { xs: [{ rva: 5, name: "g" }] }
function viaGlobal() {
  let t = 0
  for s in g.xs { t = t + s.rva }
  t
}
const q = { xs: [{ rva: 2, name: "u" }] }
const a = mk(3)
if a is P {
  print(find(a, 3))
  print(find(a, 4))
  print(findIx(a, 3))
  print(viaCapture(a))
  print(viaNullable(a))
  print(viaPush(a))
  print(viaTwoNames(a))
  print(viaFilter(a))
  print(viaLocal(a))
  print(viaAssign(a))
  for s in a.xs { print(s.name) }
  print(viaLambda(a))
}
print(viaNullable(null))
print(viaCall())
print(viaGlobal())
print(find(q, 2) + 1)
for s in g.xs { print(s.rva) }
type Circle = { r: i32 }
type Sq = { side: i32 }
type Shape = Circle | Sq
type C = { cs: Circle[] }
function mkC(n: i32): C | E {
  if n > 5 { return { msg: "no" } }
  { cs: [{ r: n }] }
}
function area(s: Shape) {
  if s is Circle { return s.r * 100 }
  1
}
function look(ys: readonly Shape[]) {
  let t = 0
  for s in ys { t = t + area(s) }
  t
}
function widenLet(self: C) {
  const ys: readonly Shape[] = self.cs
  look(ys)
}
function widenArg(self: C) { look(self.cs) }
const c = mkC(3)
if c is C {
  print(widenLet(c))
  print(widenArg(c))
}
const m: { [string]: P } = Map()
m["k"] = { xs: [{ rva: 4, name: "k" }, { rva: 6, name: "l" }] }
if m["k"] != null {
  print(m["k"].xs.length)
  for s in m["k"].xs { print(s.rva) }
}
type T = { w: f64, k: i32, tag: string }
type Q = { xs: T[], extra: i32 }
function mkPQ(n: i32): P | Q | E {
  if n > 5 { return { msg: "no" } }
  if n > 2 { return { xs: [{ w: 1.5, k: n, tag: "q" }], extra: 1 } }
  { xs: [{ rva: n, name: "p" }] }
}
function sumP(self: P) {
  let t = 0
  for s in self.xs { t = t + s.rva }
  t * 10 + self.xs.length
}
function sumQ(self: Q) {
  let t = 0.0
  for s in self.xs { t = t + s.w }
  t + self.xs.length * 10.0 + self.xs[0].k * 100.0
}
const pp = mkPQ(1)
if pp is P { print(sumP(pp)) }
const qq = mkPQ(4)
if qq is Q { print(sumQ(qq)) }
