// @run
// @log 0
// @log 0
// @log 0
// @log 0
// An empty `Map()` or `[]` delivered to a recursive union holding `null` and a scalar is built as
// its one map or list arm: the alias's members sit one union down, and the pin reads through it.
type Json = null | boolean | f64 | string | Json[] | { [string]: Json }
type U = null | f64 | { [string]: U }
const j: Json = Map()
if j is { [string]: Json } { print(j.length) }
const k: Json = []
if k is Json[] { print(k.length) }
function f(u: U) {
  if u is { [string]: U } { print(u.length) }
}
f(Map())
let w: U = 1.0
w = Map()
if w is { [string]: U } { print(w.length) }
