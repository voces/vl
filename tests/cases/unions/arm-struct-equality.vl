// @hint redundant type annotation: `ga` is inferred as `{r: i32}`
// @hint redundant type annotation: `gb` is inferred as `{r: i32}`
// @hint redundant type annotation: `c1` is inferred as `{r: i32}`
// @hint redundant type annotation: `c2` is inferred as `{r: i32}`
// @hint redundant type annotation: `xs` is inferred as `{r: i32}[]`
// @hint redundant type annotation: `a` is inferred as `{r: i32}`
// @hint redundant type annotation: `b` is inferred as `{r: i32}`
// @hint redundant type annotation: `a` is inferred as `Circle`
// @hint redundant type annotation: `a` is inferred as `Rich`
// @hint redundant type annotation: `b` is inferred as `Circle`
// @hint redundant type annotation: `b` is inferred as `Rich`
// EVERY ONE OF THOSE ANNOTATIONS IS THE TEST. Dropping one infers the INLINE shape
// `{r: i32}` instead of the declared name `Circle`, and an inline shape is a
// standalone struct row — the storage class this file exists to keep OFF.
// GRADUATED from `silent-class-inventory` D57: a STRUCT `==` went check-clean INVALID WASM
// the moment a union CONTAINING that struct was DECLARED, and the union is never used.
//
// THE TRIGGER IS THE DECLARATION, NOT A USE. Delete the `type Shape` line and every compare
// below already ran on master; add it back — touching nothing else, building no `Shape`,
// narrowing nothing — and `vl check` still said rc 0 while the engine refused the module
// with `type mismatch: expected i32, found (ref $type)`. The reason is a STORAGE CLASS, not
// a type: `collectS` SKIPS a `type X = {…}` that is a union member, so declaring the union
// removes `Circle`'s row from the standalone struct table and mints a variant row instead.
// The eq dispatch asked only `structIndexOfExpr`, got -1 for BOTH operands, and fell through
// to the i32 tail at the bottom of the binary lowering — `i32.eq` over two `(ref $Circle)`.
//
// THE COMPLEMENT WAS ALREADY WRITTEN. `exprVariantIndex` is `structIndexOfExpr`'s
// storage-class twin, arm for arm (param / declared local / capture / global / `: T`-returning
// call / ref-list element / map read / `??` / `as`), each leg kind-gated so the two never both
// answer for one binding. Nothing had to be invented; the dispatch had to ask.
//
// `Dot` IS LOAD-BEARING and is why the variant rung is asked FIRST. With an exact layout twin
// in the module, `structIndexOfExpr`'s non-kind-gated legs (the `Index` arena rung, the
// global's `structIndexOfLet`) resolve a VARIANT operand to DOT'S row — a different heap type
// from `uVarHeap[Circle]` — so the struct rung answered, wrongly, where it used to decline.
// Storage class beats a structural twin: `xs[0] == xs[1]` and `ga == gb` below are the two
// cells that proved it, and both stayed invalid wasm with the twin present until the order
// was settled. The mixed pair — an arm against a standalone `Dot` — still REFUSES, and
// `error-arm-struct-equality-mixed.vl` is that control.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Dot = { r: i32 }

const ga: Circle = { r: 1 }
const gb: Circle = { r: 1 }

function mkc(v: i32): Circle { return { r: v } }

function eqc(x: Circle, y: Circle) { return x == y }

function eqT<T>(x: T, y: T) { return x == y }

function cell() {
  const a: Circle = { r: 1 }
  const b: Circle = { r: 1 }
  return a == b
}

// the direct compare, and its `!=` twin over values that differ
print(cell())
const c1: Circle = { r: 1 }
const c2: Circle = { r: 2 }
print(c1 == c2)
print(c1 != c2)

// THE INITIALIZER FORM IS NOT AN AXIS (D57's own wording): an object literal and a
// call result reproduce alike, so both are here.
function cellCall() {
  const a: Circle = mkc(3)
  const b: Circle = mkc(3)
  return a == b
}

print(cellCall())

// a PARAM, a GLOBAL, a REF-LIST ELEMENT and a GENERIC route — four more storage classes
// through the one site
print(eqc(c1, ga))
const xs: Circle[] = [{ r: 4 }, { r: 4 }]
print(xs[0] == xs[1] && ga == gb)

function cellGeneric() {
  const a: Circle = { r: 5 }
  const b: Circle = { r: 5 }
  return eqT(a, b)
}

print(cellGeneric())

// EVERY SUPPORTED FIELD CODE, THROUGH THE VARIANT TABLE — and this is not decoration. The
// compare's field ladder reads `eqRowFieldTypeAt` and its `i32[]` arm stages two backings and
// two counters in the string-op scratch frame, which a RESERVATION scan has to have claimed
// first. D57's first fix taught the emitter the variant table and left `exprIsStructEq`
// asking the struct one, so this arm compiled a loop against locals the function never
// declared: `expected (ref null $type), found i32`, check-clean. A single-`i32`-field arm
// cannot see that, which is why `Rich` carries one of each: i32 · string · `i32[]` ·
// boolean · f64 · nested struct · function value.
type Inner = { v: i32 }
type Rich = {
  n: i32,
  s: string,
  l: i32[],
  bo: boolean,
  g: f64,
  k: Inner,
  fn: (i32) => i32,
}
type Tri = { t: i32 }
type Wide = Rich | Tri

function dbl(x: i32) { return x * 2 }

function trp(x: i32) { return x * 3 }

function mkRich(n: i32, s: string, e: i32, f: (i32) => i32): Rich {
  return { n: n, s: s, l: [1, e], bo: true, g: 1.5, k: { v: 3 }, fn: f }
}

// equal on every field; then one differing field at a time, in FOUR different codes, so no
// single position carries the result
function cellRich() {
  const a: Rich = mkRich(1, "x", 2, dbl)
  const b: Rich = mkRich(1, "x", 2, dbl)
  return a == b
}

function cellRichStr() {
  const a: Rich = mkRich(1, "x", 2, dbl)
  const b: Rich = mkRich(1, "y", 2, dbl)
  return a != b
}

function cellRichList() {
  const a: Rich = mkRich(1, "x", 2, dbl)
  const b: Rich = mkRich(1, "x", 9, dbl)
  return a != b
}

function cellRichClo() {
  const a: Rich = mkRich(1, "x", 2, dbl)
  const b: Rich = mkRich(1, "x", 2, trp)
  return a != b
}

print(cellRich())
print(cellRichStr())
print(cellRichList())
print(cellRichClo())
