// D7442: an un-annotated literal that adopts a declared union's arm row reads its literal-union
// field as that row's atom, whether the read is printed, widened to `string` or compared.
// @run
// @log a
// @log a
// @log true
// @hint redundant type annotation: `s` is inferred as `string`
type U = { kind: "a" | "c", q: i32 | null } | { kind: "b" }
const v = { kind: "a", q: 4 }
print(v.kind)
const s: string = v.kind
print(s)
print(v.kind == "a")
