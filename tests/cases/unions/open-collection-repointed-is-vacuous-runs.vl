// @run
// @warning this `else` can never run (`n` is always `{[_]: _}`)
// @log true
// @log true
// @log 0
// @log true
// @log true
// An open empty set or map re-pointed at another open one holds one hole with it, settled by the
// default together, so `is` matches vacuously as it does for either alone (D16433, D16047).
const a = Set()
let b = Set()
b = a
print(b is Set<string>)
print(b is Set<i32>)
const m = Map()
let n = Map()
n = m
if n is {[string]: i32} { print(0) } else { print(42) }
function inner() {
  const p = Set()
  let q = Set()
  q = p
  print(q is Set<string>)
}
inner()
const xs = []
let ys = []
ys = xs
print(ys is string[])
