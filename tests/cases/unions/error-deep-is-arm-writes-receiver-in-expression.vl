// @error a deep `is` arm that rebinds or writes `r` inside an expression is not supported yet — write it as its own statement, or bind the converted value first
// An assignment nested in an expression of a deep `is` arm gives the rewrite no statement to end
// the converted copy at (D16474).
type Json = null | boolean | f64 | string | Json[] | { [string]: Json }
function id(x: null) { x }
function d(r: Json) {
  if r is string[] {
    const n = r.length
    print(id(r = null) == null)
    return n
  }
  0
}
print(d(["a", "b"]))
