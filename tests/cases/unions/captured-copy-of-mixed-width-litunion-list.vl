// A closure captures an un-annotated copy of a list whose element is a literal union of two
// widths. The copy's synthesized annotation names the literal union, whose list is stored at
// its render's row (`(i64|i32)[]`), so the env field takes that row (D6460). Each capture
// position below is one the matrix grades; a local source, a closure returning the copy, one
// passing it on and a copy of the copy are the other deliveries.
const src: (9000000000 | 1 | 9000000001)[] = [9000000000, 1, 9000000001]
function frame() {
  const c = src
  const f = () => {
    print(c[2])
    print(c.length)
  }
  f()
}
function inIf(k: i32) {
  if k > 0 {
    const c = src
    const f = () => {
      print(c[1])
    }
    f()
  }
}
function inWhile() {
  let i = 0
  while i < 1 {
    const c = src
    const f = () => {
      print(c[0])
    }
    f()
    i = i + 1
  }
}
function inBlock() {
  {
    const c = src
    const f = () => {
      print(c[2])
    }
    f()
  }
}
function fromLocal() {
  const own: (9000000000 | 1 | 9000000001)[] = [1, 9000000001]
  const c = own
  const f = () => {
    print(c.length)
    print(c[1])
  }
  f()
}
function sum(xs: (9000000000 | 1 | 9000000001)[]) {
  let t: i64 = 0
  for x in xs { t = t + x }
  t
}
function deliveries() {
  const c = src
  const g = () => c
  const h = () => sum(c)
  const k = () => {
    const d = c
    const m = () => {
      print(d[0])
    }
    m()
  }
  print(g()[1])
  print(h())
  k()
}
frame()
inIf(1)
inWhile()
inBlock()
fromLocal()
deliveries()
