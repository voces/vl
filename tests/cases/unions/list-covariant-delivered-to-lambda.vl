// @run
// @log 7
// @log 1
// @log 1
// @log 1
// @hint redundant type annotation: `a` is inferred as `{r: i32}[]` — remove it to lean on inference
// A read-only covariant list handed to a function VALUE (D1683).
//
// The argument edge resolved a callee through the name-keyed index of declared functions, and
// a lambda is a nameless `FuncDecl` no index files — so `take(b)` reached no parameter list
// and the delivery was declined. The lambda a once-bound `const` was initialised with is in
// the arena, so the edge reads its parameter directly and `ys` joins the alias set like any
// declared function's would. Writing the same body as `function take(ys: Shape[])` ran all
// along, which is what makes the function value the ingredient.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq

function f() {
  const a: Circle[] = [{ r: 7 }]
  const b: Shape[] = a
  const take = (ys: Shape[]) => {
    const e = ys[0]
    if e is Circle { print(e.r) }
    print(ys.length)
  }
  take(b)
  print(a.length)
}

function other() {
  const w: Shape[] = []
  w.push({ s: 3 })
  print(w.length)
}

f()
other()
