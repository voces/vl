// @run
// @log d
// @log a
// @log J c
// @log K b
// @log JJ
// @log KK
// D4938: two literal-union list arms share one tag, so `is K[]` over `K[] | J[]` tests the
// elements, at every depth.
type K = "a" | "b"
type J = "c" | "d"
function mk(b: boolean): K[] | J[] {
  if b { return ["a"] }
  ["d"]
}
function f(x: K[] | J[]) {
  if x is K[] { print("K " + x[0]) } else { print("J " + x[0]) }
}
function h(x: K[][] | J[][]) {
  if x is K[][] { print("KK") } else { print("JJ") }
}
const w = mk(false)
if w is K[] { print(w[0]) } else { print(w[0]) }
const t = mk(true)
if t is J[] { print(t[0]) } else { print(t[0]) }
const jl: J[] = ["c"]
const kl: K[] = ["b"]
f(jl)
f(kl)
const jj: J[][] = [["d"]]
const kj: K[][] = [["a"]]
h(jj)
h(kj)
