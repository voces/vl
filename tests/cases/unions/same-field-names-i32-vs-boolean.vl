// @run
// @log IS-Q
// @log IS-P
// `i32` and `boolean` share one storage code, and still part two same-name arms: a value built
// through `Q` answers `is Q`, and one built through `P` answers `is P` (D4056).
type P = { a: i32 }
type Q = { a: boolean }
const u: P | Q = { a: true }
if u is P { print("IS-P") } else { print("IS-Q") }
const w: P | Q = { a: 3 }
if w is Q { print("IS-Q") } else { print("IS-P") }
