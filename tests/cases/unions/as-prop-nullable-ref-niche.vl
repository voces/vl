// @run
// @log 3
// @log -1
// @log y
// @log none
// @log 5
// @log -1
// @log 2
// @log -1
// The propagating `as` over a nullable record, list or map: a present value is the cell at its
// non-null type, and a null returns the enclosing function's own null, through a plain return or
// a union one, as the string case does (D16066).
type P = { a: i32 }
type E = { msg: string }
function mp(k: i32): P | null { if k > 0 { return { a: k } } else { return null } }
function ml(k: i32): string[] | null { if k > 0 { return ["x", "y"] } else { return null } }
function mm(k: i32): {[string]: i32} | null {
  if k > 0 {
    const m: {[string]: i32} = Map()
    m["k"] = k
    return m
  }
  return null
}
function rec(k: i32): i32 | null {
  const p = mp(k) as P
  return p.a
}
print(rec(3) ?? 0)
print(rec(0) ?? -1)
function second(k: i32): string | null { return (ml(k) as string[])[1] }
print(second(1) ?? "x")
print(second(0) ?? "none")
function plus(k: i32): i32 | E | null {
  const m = mm(k) as {[string]: i32}
  return (m["k"] ?? 0) + 2
}
const r1 = plus(3)
if r1 is i32 { print(r1) }
const r2 = plus(0)
if r2 == null { print(-1) }
function count(x: string[] | null): i32 | null {
  const xs = x as string[]
  return xs.length
}
print(count(ml(1)) ?? 0)
print(count(null) ?? -1)
