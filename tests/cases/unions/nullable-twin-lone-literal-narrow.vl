// @run
// @log 2
// @log -7
// @log 8
// @log 0
// @log a
// A nullable union whose arms differ only in a lone literal keeps its box once narrowed off
// `null`, at a binding, an annotated parameter and an un-annotated one (D5163).
type N = { tag: "a", v: i32 } | { tag: "b", v: i32 }
function mk(a: boolean): N | null {
  if a { return { tag: "a", v: 7 } }
  { tag: "b", v: 8 }
}
function f(q: N | null) {
  if q == null { return 0 }
  if q.tag == "a" { return 0 - q.v }
  q.v
}
function g(a) {
  const v = a
  if v != null { print(v.tag) }
}
const y: N = { tag: "b", v: 2 }
const q: N | null = y
if q != null { print(q.v) }
print(f(mk(true)))
print(f(mk(false)))
print(f(null))
g(mk(true))
