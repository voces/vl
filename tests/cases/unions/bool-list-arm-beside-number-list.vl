// A boolean list delivered into a union beside a float or integer list is its own arm, never a
// number list to widen into, while an integer list still widens to the float arm (D2796).
function h(c: boolean, t: boolean): boolean[] | f64[] {
  if c { return [t] }
  [2.5]
}
const q = h(true, true)
if q is boolean[] { print(q[0]) } else { print(-1) }
const w: boolean[] | string[] | i64[] = [true]
if w is boolean[] { print(w[0]) } else { print(-1) }
const p = h(false, true)
if p is f64[] { print(p[0]) } else { print(-1) }
const n: boolean[] | f64[] = [1]
if n is f64[] { print(n[0]) } else { print(-1) }
