// @run
// @log a
// @log N
// @log b
// @log 4
// @log -1
// @log 9
// D3133: an un-annotated `let` of a value narrowed out of a wider box takes the narrowed cell,
// so a later store writes that cell's rep: the `K | null` atom niche and the `Circle | null`
// arm niche, reassigned to `null` and to a member.
type K = "a" | "b"
type Circle = { r: i32 }
function skn(k: K | null) {
  if k == null { return "N" }
  return k
}
function scn(w: Circle | null) {
  if w == null { return 0 - 1 }
  return w.r
}
function t(v: K | null | i32) {
  if !(v is i32) {
    let c = v
    print(skn(c))
    c = null
    print(skn(c))
    c = "b"
    print(skn(c))
  }
}
t("a")
function u(v: Circle | null | string) {
  if !(v is string) {
    let c = v
    print(scn(c))
    c = null
    print(scn(c))
    c = { r: 9 }
    print(scn(c))
  }
}
u({ r: 4 })
