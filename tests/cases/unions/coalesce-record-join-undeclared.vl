// @run
// @hint redundant type annotation: `b` is inferred as `{q: string}` — remove it to lean on inference
// @log true
// @log b
// @log true
// @log 7
// @log true false false
// @log true
// @log b
// @log true false false
// @log true
// @log true
// @log 7
// @log true
// @log true
// @log d
// @log true
// @log true
// @log 1.5
// @log true
// A `??` joining records of different types where no declaration names the
// join: the join is the union box, its row minted from the checker's own type. An unused `C`
// is declared so a row minted one slot off would show, and the both-null join is the box's
// null, never an arm. Bound, at module scope, reassigned, and chained (D2373).

type A = { r: i32 }
type B = { q: string }
type C = { z: f64 }
function mkA(): A | null { return null }
function mkB(): B | null { return { q: "b" } }
function mkA2(): A | null { return { r: 7 } }
function mkN(): B | null { return null }
function mkC(): C | null { return { z: 1.5 } }

function bound() {
  const x = mkA() ?? mkB()
  print(x is B)
  if x is B { print(x.q) }
  const y = mkA2() ?? mkB()
  print(y is A)
  if y is A { print(y.r) }
  const z = mkA() ?? mkN()
  print("\{z == null} \{z is A} \{z is B}")
}
bound()

const mx = mkA() ?? mkB()
print(mx is B)
if mx is B { print(mx.q) }
const mz = mkA() ?? mkN()
print("\{mz == null} \{mz is A} \{mz is B}")

function reassigned() {
  let x = mkA() ?? mkB()
  print(x is B)
  x = mkA2()
  print(x is A)
  if x is A { print(x.r) }
  x = null
  print(x == null)
}
reassigned()

function recordDefault() {
  const b: B = { q: "d" }
  const x = mkA() ?? b
  print(x is B)
  if x is B { print(x.q) }
  print((mkA2() ?? b) is A)
}
recordDefault()

function threeRecords() {
  const x = mkA() ?? mkN() ?? mkC()
  print(x is C)
  if x is C { print(x.z) }
  print(((mkA() ?? mkN()) ?? mkC()) is C)
}
threeRecords()
