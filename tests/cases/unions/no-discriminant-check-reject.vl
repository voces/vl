// @error share a field-name set and no literal-typed field distinguishes them
// D1023's other half: the pair no VALUE tells apart is refused, and refused by the CHECKER.
//
// THE STAGE IS THE POINT OF THIS FIXTURE. This was an emit reject, and an emit reject that
// fires on a `vl check`-clean program is a clause-2 violation by construction: check returned
// 0 to reach the emitter, so either the program is legal and should compile, or it is illegal
// and the checker owed the diagnosis. VL's structural unions discriminate on the field-NAME
// set (`docs/guide/unions.md`), so two arms sharing that set with nothing else to part them
// is a DESIGN rule, and the checker is where a design rule belongs. `assignTags` keeps its
// reject as an unreachable floor.
//
// `{v: i32} | {v: boolean}` has no literal-typed field at all. Its two siblings are refused
// by the same sentence for the same reason and are graded beside this file:
// `{v: i32} | {v: "a" | "b"}` has a literal set in ONE arm, and `{k: "a"} | {k: 1}` has one in
// each but with no common base — a string and an integer have no single compare, so no value
// answers `is A` there either.
type A = { v: i32 }
type B = { v: boolean }
type S = A | B

function f(n: i32): S {
  if n == 0 { return { v: 1 } }
  return { v: true }
}
print(f(1) is A)
