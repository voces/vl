// @run
// @log 1
// @log 0
// @log 1
// `is` over a hole parameter bound from a union member's field read answers at the instance's
// own member type (D3311).
type O = { n: i32 }
type P = { m: i32, k: i32 }
type U = O | P
type W = { w: O }
function u(q) {
  if q is O { return 1 }
  return 0
}
const ww: W = { w: { n: 4 } }
print(u(ww.w))
const uu: U = { m: 1, k: 2 }
print(u(uu))
const oo: U = { n: 3 }
print(u(oo))
