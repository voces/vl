// @error is not a JSON shape — field `cb`: `(i32) => i32` is a closure; a JSON shape cannot hold one
// A deep `is` over a `Json` refuses a target `T` that has no JSON shape, and the message
// NAMES THE OFFENDING COMPONENT of `T` rather than the target as a whole — `Cfg.cb` is a
// closure, so the reader is told which field to change and not merely that the type was
// rejected. The refusal blames the `is` site's `T`, never a std file.
//
// A closure has no wire form in any direction, which is why this is a DESIGN rule and not a
// capability gap: `docs/serde-design.md` §"Deep `is` / `as` over a `Json` value" lists
// closures, `Buffer`, non-string map keys and newtype brands as the four the checker owes a
// diagnosis for.
type Json = null | boolean | f64 | string | Json[] | { [string]: Json }
type WithCb = { cb: (i32) => i32 }
const j: Json = null
print(j is WithCb)
