// @run
// @hint redundant type annotation: `k` is inferred as `K` — remove it to lean on inference
// @log m circle
// @log m round
// @log 7
// @log 8
// @log true
// @log false
// @log true
// @log false
// @log true
// @log false
// @log 2
// The positions where a string-stored literal-set field, read at its string, meets a consumer that
// reads the atom: each is built as legacy writes it or declined by name, never claimed wrong.
type K = "circle" | "round"
type A = { kind: K, r: i32 }
type B = { kind: string, r: i32 }
function mk(n: i32): A | B {
  if n == 0 { return { kind: "round", r: 1 } }
  return { kind: "zz", r: 2 }
}
function mat(a: A) {
  match a.kind {
    "circle" => print("m circle")
    "round" => print("m round")
  }
}
function mapKey(a: A) {
  const m: { [K]: i32 } = Map()
  m["circle"] = 7
  m["round"] = 8
  print(m[a.kind] ?? 0)
}
function listElem(a: A) {
  const xs: K[] = [a.kind]
  print(xs[0] == "circle")
}
function eqIn(k: K) { print(k == "circle") }
function paramEq(a: A) { eqIn(a.kind) }
function letEq(a: A) {
  const k: K = a.kind
  print(k == "circle")
}
const c: A = { kind: "circle", r: 1 }
const r: A = { kind: "round", r: 2 }
mat(c)
mat(r)
mapKey(c)
mapKey(r)
listElem(c)
listElem(r)
paramEq(c)
paramEq(r)
letEq(c)
letEq(r)
print(mk(1).r)
