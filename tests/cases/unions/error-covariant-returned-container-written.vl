// @error WRITTEN THROUGH
// @hint redundant type annotation: `a` is inferred as `{r: i32}[]` — remove it to lean on inference
// The soundness half of the returned container (D1682).
//
// `sf.xs.push` writes through the same list `b` names, so the `Writable` refusal is what this
// program is owed. The container the write goes through is the one the return delivers, so
// filing the escape under the call's destination is what makes `sf.xs` a handle the write
// scan matches — the definite 1 the checker refuses on, not the unknown the emitter declined.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box = { xs: Shape[] }

function mk(v: Shape[]): Box { { xs: v } }

function f() {
  const a: Circle[] = [{ r: 7 }]
  const b: Shape[] = a
  const sf = mk(b)
  sf.xs.push({ s: 3 })
  print(a.length)
}

function other() {
  const w: Shape[] = []
  w.push({ s: 3 })
  print(w.length)
}

f()
other()
