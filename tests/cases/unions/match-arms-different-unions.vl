// D2326 matrix — the shared name `u` is bound once per `match` arm body, each to a
// DIFFERENT struct union.
// @run
// @log 5
// @log inner

type A = { x: i32 }
type B = { y: string }
type C = { z: boolean }

function f(n: i32) {
  let out = ""
  match n {
    0 => {
      const u: A | B = { x: 5 }
      if u is A { out = "\{u.x}" } else { out = "\{u.y}" }
    }
    _ => {
      const u: C | B = { z: true }
      if u is C { out = "inner" } else { out = "\{u.y}" }
    }
  }
  out
}
print(f(0))
print(f(1))
