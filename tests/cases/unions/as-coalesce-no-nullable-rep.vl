// @emit-error to have a representation
// `x as? T` REFUSED BY NAMING THE MISSING REP, for a target whose `T | null` has none.
//
// `Circle` here is a union ARM, and a nullable union arm is not representable — which is a
// PRE-EXISTING gap with nothing to do with the cast. The witness needs no `as?` at all:
//
//     type U = Circle | ParseError
//     const sink: U = { why: "x" }
//     function f(c: Circle | null): f64 { … }   // emitProgram: ref valtype with no interned shape
//
// A nullable PLAIN struct — one that is not a union arm — does exist and lowers. That contrast
// is what makes this a hole rather than a category nobody built, and it is why the cast
// refuses instead of guessing: the rep it would need is absent, not merely unwired.
//
// The same message covers the other two shapes with no nullable form: a SUB-UNION target
// (`as? Shape`, since `Shape | null` fails the same way) and a SCALAR arm (`i32 | null` DOES
// exist, but as a value NICHE — a sentinel inside the i32 — which is a different lowering
// from the nullable ref this cast emits, not a missing one).
//
// The STRING arm works and is pinned in `as-coalesce.vl`.
type Circle     = { kind: "circle", r: f64 }
type ParseError = { why: string }

function mk(a: f64): Circle | ParseError {
  if a <= 0.0 { return { why: "bad" } }
  return { kind: "circle", r: a }
}

function radiusOf(a: f64): f64 {
  const c = mk(a) as? Circle
  if c != null { return c.r }
  return -1.0
}
print(radiusOf(3.0))
