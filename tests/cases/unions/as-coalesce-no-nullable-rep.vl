// @emit-error a scalar arm is a value niche
// `x as? T` REFUSED FOR A SCALAR ARM — the one target left with no nullable-REF form, and a
// genuine difference in rep rather than a gap.
//
// `i32 | null` DOES exist. It is a value NICHE — a sentinel inside the i32 — not a
// `(ref null …)`, so it needs a different lowering from the one this cast emits, and
// guessing would put a sentinel where a ref is expected. Naming the reason beats emitting
// the wrong thing.
//
// WHAT THIS FILE USED TO SAY, and why the change is recorded here rather than filed as new
// work: it pinned the refusal for a union ARM (`as? Circle`) and a SUB-UNION (`as? Shape`)
// too, on the measured ground that `Circle | null` and `Shape | null` had no representation
// at all — "a pre-existing gap with nothing to do with the cast", reproducible with no cast
// in the program. Both reps exist now (`nullable-variant-positions.vl`,
// `nullable-union-alias.vl`), so both casts lower and are pinned in
// `as-coalesce-variant-and-sub-union.vl`. The refusal that remains is the one that was
// always about a rep DIFFERENCE rather than a rep absence.
//
// THE REMEDY for a scalar arm is the explicit ladder, which lowers today:
//
//     const n = if v is i32 { v } else { -1 }
type Count = { n: i32 }

function pick(b: boolean): i32 | Count {
  if b { return 7 }
  { n: 3 }
}

function countOf(b: boolean): i32 {
  const c = pick(b) as? i32
  if c != null { return c }
  -1
}
print(countOf(true))
