// @error WRITTEN THROUGH
// @hint redundant type annotation: `a` is inferred as `{r: i32}[]` — remove it to lean on inference
// @hint redundant type annotation: `sf` is inferred as `{xs: Shape[]}` — remove it to lean on inference
// A covariant list delivered into a container reached under a second name (D1658).
//
// `sf2.xs.push` writes through the same list `b` names, so the `Writable` refusal is what
// this program is owed, and `sf.xs.push` has always got it. A container bound to a second
// name is still ONE container: the alias closure files the escaped list under every name
// that reaches it, so the write scan matches `sf2.xs` as a handle and the answer is the
// definite 1 the checker refuses on, not the unknown the emitter used to decline.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box = { xs: Shape[] }

function f() {
  const a: Circle[] = [{ r: 7 }]
  const b: Shape[] = a
  const sf: Box = { xs: b }
  const sf2 = sf
  sf2.xs.push({ s: 3 })
  print(a.length)
}

f()
