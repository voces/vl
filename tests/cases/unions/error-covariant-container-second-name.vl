// @emit-error covariant list delivery
// A covariant list delivered into a container reached under a SECOND NAME (D1656).
//
// `sf2.xs.push` writes through the same list `b` names, so the `Writable` refusal is what
// this program is owed — and `sf.xs.push` gets it. The alias closure files the escaped list
// under the container's own name and cannot claim a container bound twice, so the write
// state stays unknown, the element-converting copy is declined, and the delivery has no
// lowering left. That is a refusal, not an invalid module: the licence's other half is the
// rep-scoped write scan, which is emit-side, so the checker cannot own this one (D1658).
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box = { xs: Shape[] }

function f() {
  const a: Circle[] = [{ r: 7 }]
  const b: Shape[] = a
  const sf: Box = { xs: b }
  const sf2 = sf
  sf2.xs.push({ s: 3 })
  print(a.length)
}

f()
