// @run
// CONTRACT: `if p is N` where `type N = i32` is a TRANSPARENT alias of a scalar atom narrows `p`
// to that atom, so the then-arm's `p` reads UNBOXED — the same lowering `if p is i32` gets, because
// it is the same question spelled two ways.
//
// MASTER'S VERDICT IS CHECK-CLEAN INVALID WASM, and its shape is the tell: the box-tag test was
// correct and the narrowed READ pushed the raw `(ref $uBox)` into the i32 consumer
// (`type mismatch: expected i32, found (ref $type)`), while `is i32` one line away was right.
// `narrowedValueAtomOf` returns the atom a binding is narrowed to, and it took the answer from the
// narrowing's banked SPELLING — which is the tested name `N`, and `valueAtomKind("N")` is -1. The
// arena TYPE the SAME push banks is the `TyPrim` whose `primName` is the canonical spelling; that
// string is literally what `unMemAtomKind` hands `valueAtomKind` two functions down, so reading it
// cannot introduce a second answer about which atom an arm is.
//
// `TyPrim` ONLY, and that bound is the reason this is safe: a closure / list / map arm's SPELLING
// carries information its kind does not (its signature, its element type) and those consumers read
// the spelling, so only the scalar/string leaves take the structural answer.

type N = i32
type S = string
type B = boolean

// ── i32 through an alias, both inputs ──────────────────────────────────────────
// @log 7
// @log none
function i32Present() {
  const p: N | null = 7
  if p is N { print(p) } else { print("none") }
}
function i32Absent() {
  const p: N | null = null
  if p is N { print(p) } else { print("none") }
}
i32Present()
i32Absent()

// ── the same at a PARAM ────────────────────────────────────────────────────────
// @log 9
// @log none
function i32Param(p: N | null) {
  if p is N { print(p) } else { print("none") }
}
i32Param(9)
i32Param(null)

// ── the NEGATED guard ─────────────────────────────────────────────────────────
// @log 4
// @log none
function i32Negated(p: N | null) {
  if !(p is N) { print("none") } else { print(p) }
}
i32Negated(4)
i32Negated(null)

// ── string through an alias (the `string | null` niche, not a box) ─────────────
// @log hi
// @log none
function strParam(p: S | null) {
  if p is S { print(p) } else { print("none") }
}
strParam("hi")
strParam(null)

// ── boolean through an alias (the i32 sentinel-2 niche) ───────────────────────
// @log true
// @log none
function boolParam(p: B | null) {
  if p is B { print(p) } else { print("none") }
}
boolParam(true)
boolParam(null)

// ── CONTROL: the atom's own name at the same positions was already correct ─────
// @log 7
// @log none
function bareName(p: i32 | null) {
  if p is i32 { print(p) } else { print("none") }
}
bareName(7)
bareName(null)
