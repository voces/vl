// @log 1
// @hint redundant type annotation: `useUU` is inferred as `i32`
// @hint redundant type annotation: `p` is inferred as `{x: i32}`
// @hint redundant type annotation: `takeP` is inferred as `i32`
// @hint redundant type annotation: `annArr` is inferred as `P[]`
// @hint redundant type annotation: `bAnn` is inferred as `P`
// @hint redundant type annotation: `inFn` is inferred as `i32`
// D1668 — an if-expression whose arms all denote ONE union ARM.
//
// `ifExprRefKind` classifies the join's blocktype from the deciding arm and carried a
// `variant` rung only inside its nullable half, so a non-null arm answered no to every ref
// predicate and the join fell to `ifExprValtype`: `if (result i32)` over `(ref $uVarHeap)`
// arms, at `vl check` rc 0. The union declaration is the ingredient — it is what makes the
// arm value classify as a variant, so `structIndexOfExpr` declines.
//
// `exprVariantIndex` gains the same arm for the destination side, gated on every arm
// denoting the SAME row: arms denoting different rows join to the union box, which
// `emitUnionCoerce` owns (`tests/cases/unions/union-if-value-variant.vl` is that shape).
type P = { x: i32 }
type Q = { y: i32 }
type UU = P | Q

function useUU(u: UU): i32 {
  if u is P { return u.x }
  0
}

const p: P = { x: 1 }
const seen = useUU(p)

function takeP(v: P): i32 { v.x }

function retInferred() {
  if seen == 1 { p } else { p }
}

// The row's own witness: the array-literal element, both faces.
const arr = [if seen == 1 { p } else { p }]
const annArr: P[] = [if seen == 1 { p } else { p }]
print(arr[0].x)
print(annArr[0].x)

// Binding, un-annotated and annotated.
const b = if seen == 1 { p } else { p }
const bAnn: P = if seen == 1 { p } else { p }
print(b.x)
print(bAnn.x)

// Return with an inferred type, an argument, and an assignment.
print(retInferred().x)
print(takeP(if seen == 1 { p } else { p }))

let cell = p
cell = if seen == 1 { p } else { p }
print(cell.x)

function inFn(): i32 {
  const local = if seen == 1 { p } else { p }
  local.x
}

print(inFn())
