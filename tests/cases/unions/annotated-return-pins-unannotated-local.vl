// Regression (silent-class-inventory D39), the graduation of
// `xfail-miscompile-annotated-list-return-anon-elem-twin.vl` and of the BARE container beside
// it. An ANONYMOUS `{ r: n }` bound to an UN-ANNOTATED local and returned from a function whose
// RESULT is annotated at a union ARM, in a module that also declares a standalone struct of
// that arm's exact layout (`Dot`).
//
// AN ANONYMOUS SHAPE HAS TWO NOMINAL CLAIMANTS AND ONLY THE CONTEXT SEPARATES THEM.
// `structIndexOfObj` scans the STRUCT table by field set and finds `Dot`; `objVariantName`
// scans the VARIANT table and finds `Circle`; the ladder every consumer walks asks the struct
// table first, so the local built `Dot`'s row while the annotated result declared
// `uVarHeap[Circle]`. Neither scan is wrong — with no annotation at all `Dot` IS the right
// answer and the program runs, which is why this could not be fixed by reordering the ladder.
// The annotation is what decides, and the un-annotated local never saw it. `synthRetPinAnn`
// writes it back as one, in the family of `synthEmptyListAnn` / `synthNullableAnn`.
//
// SCOPED TO THE STRUCT/VARIANT SEAM, and `structTwin` below is the control that says why: two
// DECLARED structs of the same layout merge at the heap layer (`sTwin`), so that cell RAN on
// master and is untouched. A union arm does not merge with a struct row and must not —
// `DECISIONS.md` records that seam as nominal.
//
// The `noAnnotation` cell is D39's own filed axis (drop the return annotation → runs), kept so
// the pin is shown NOT firing where nothing asked it to.
// @run
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Dot = { r: i32 }

// The filed witness: the LIST container.
function d39List(n: i32): Circle[] {
  const o = [{ r: n }]
  return o
}

// The BARE container — 12 of the row's 20 cells, and the same root.
function d39Bare(n: i32): Circle {
  const o = { r: n }
  return o
}

// Through an ALIAS: the pin lands on the let that holds the LITERAL, not on the intermediate
// that merely names it — annotating the intermediate would ask for a coercion between two
// heap types that has no adapter.
function d39Alias(n: i32): Circle {
  const o0 = { r: n }
  const o = o0
  return o
}

// The axis control: no return annotation, so nothing pins and the structural ladder's `Dot`
// answer is used consistently at both ends.
function noAnnotation(n: i32) {
  const o = { r: n }
  return o
}

// The struct/struct control: `Dot` and `Ring` are layout twins that DO merge, so this ran on
// master and still runs.
type Ring = { r: i32 }

function structTwin(n: i32): Ring {
  const o = { r: n }
  return o
}

print(d39List(7)[0].r)
print(d39Bare(7).r)
print(d39Alias(7).r)
print(noAnnotation(7).r)
print(structTwin(7).r)
