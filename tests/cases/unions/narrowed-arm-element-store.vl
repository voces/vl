// @run
// @log 3
// @log 4
// @log 4
type A = { r: i32 }
type B = { s: string }
function st(): A { return { r: 8 } }
function mk(b: boolean): A | i32 {
  if b { return { r: 3 } }
  return 7
}
function mk2(b: boolean): A | B {
  if b { return { r: 4 } }
  return { s: "x" }
}
const p = mk(true)
const xs = [st()]
if p is A { xs[0] = p }
print(xs[0].r)
const q = mk2(true)
const ys = [st(), st()]
if q is A { ys[1] = q }
print(ys[1].r)
const zs: (A | null)[] = [null]
if q is A { zs[0] = q }
print(zs[0]?.r ?? -1)
