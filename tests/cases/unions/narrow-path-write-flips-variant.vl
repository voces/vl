// @run
// @log IF-annot 1
// @log IF-infer 1
// @log WHILE-annot 1
// @log WHILE-infer 1
// @log INDEX-field 1
// @log INDEX-bare 1
// @log THREE 1
// @log ADMITTED 6
// @log SIBLING 4
// A WRITE TO A NARROWED PATH RE-NARROWS IT to the member it wrote, exactly as a write to a
// bare name does. Reads-only narrowing (D1736) states one rule for any receiver; D1847 is the
// path following the name, and `narrow-write-flips-variant.vl` is the bare-name half.
//
// EVERY ROW DEMANDS THE MEMBER. `print(o.v)` after the write runs whether the path re-narrowed
// or merely retired — the union box prints the same text — so the proof has to be a read the
// declaration cannot serve: `if o.v` needs a raw boolean, `o.v.length` a raw string. Without
// the emitter half these are check-clean invalid wasm rather than a diagnostic, so the byte
// the `if` consumes is the claim.
//
// The write is still checked against the field's DECLARED type, and a write the narrowing
// ADMITS retires nothing at all — the last two rows are those, and they ran before D1847 too.
import { toString } from "std:fmt"

type O = { v: i64 | boolean }
type X = { xs: (i64 | boolean)[] }
type T = { v: i32 | string | boolean }
type N = { v: i32 | null }
type P = { v: i64 | boolean, w: i64 | boolean }

function mkO(): O { return { v: 3 } }

function ifAnnot(o: O) {
  let r = 0
  if o.v is i64 {
    o.v = true
    if o.v { r = 1 } else { r = 2 }
  }
  return r
}
print("IF-annot " + toString(ifAnnot({ v: 3 })))

function ifInfer() {
  const o = mkO()
  let r = 0
  if o.v is i64 {
    o.v = true
    if o.v { r = 1 } else { r = 2 }
  }
  return r
}
print("IF-infer " + toString(ifInfer()))

// The loop spelling, whose head narrows a path since D1845. The write is what ends the loop.
function whileAnnot(o: O) {
  let r = 0
  while o.v is i64 {
    o.v = true
    if o.v { r = 1 } else { r = 2 }
  }
  return r
}
print("WHILE-annot " + toString(whileAnnot({ v: 3 })))

function whileInfer() {
  const o = mkO()
  let r = 0
  while o.v is i64 {
    o.v = true
    if o.v { r = 1 } else { r = 2 }
  }
  return r
}
print("WHILE-infer " + toString(whileInfer()))

// The INDEX key, over a struct field and over a bare list — the same keyer, two receivers.
function indexField(o: X) {
  let r = 0
  if o.xs[0] is i64 {
    o.xs[0] = true
    if o.xs[0] { r = 1 } else { r = 2 }
  }
  return r
}
print("INDEX-field " + toString(indexField({ xs: [3] })))

function indexBare(xs: (i64 | boolean)[]) {
  let r = 0
  if xs[0] is i64 {
    xs[0] = true
    if xs[0] { r = 1 } else { r = 2 }
  }
  return r
}
print("INDEX-bare " + toString(indexBare([3])))

// A THREE-member union, so the written member is a real choice rather than the complement.
function three(t: T) {
  let r = 0
  if t.v is i32 {
    t.v = "s"
    r = t.v.length
  }
  return r
}
print("THREE " + toString(three({ v: 3 })))

// A write the narrowing ADMITS retires nothing and re-narrows nothing — it ran before D1847.
function admitted(n: N) {
  let r = 0
  if n.v != null {
    n.v = 5
    r = n.v + 1
  }
  return r
}
print("ADMITTED " + toString(admitted({ v: 3 })))

// …and a write to a SIBLING path leaves this one's narrowing alone.
function sibling(p: P) {
  let r: i64 = 0
  if p.v is i64 {
    p.w = true
    r = p.v + 1
  }
  return r
}
print("SIBLING " + toString(sibling({ v: 3, w: 4 })))
