// @run
// @log 7
// @log 7
// @log 7
// The three annotations ARE the destinations the pin reads — the whole subject of the row —
// so they are declared rather than deleted.
// @hint redundant type annotation: `c` is inferred as `{r: i32}[][]`
// @hint redundant type annotation: `cf` is inferred as `{r: i32}[]`
// @hint redundant type annotation: `c3` is inferred as `{r: i32}[][]`
// A `Circle[][]` DESTINATION over an un-annotated `[{ r: 7 }]` local — the ELEMENT half of
// the destination pin, one container depth short (silent-class-inventory D184).
//
// `dstPinPushAnn` has two delivery shapes. A WHOLE-VALUE delivery (`gsto = c`) wants the
// destination's own spelling; an ELEMENT delivery (`const xs: Circle[] = [c]`) wants the
// ELEMENT's, because the binding holds the element and the LIST is built at the destination.
// Its own header calls that cut "`armPinAnnName`'s own ref-list rung, asked for the element
// instead of the container" — and the copy it made was rung ONE (`variantIndexOf`), which
// answers only for a BARE arm name.
//
// So `const c: Circle[][] = [lv1]` cut to the element spelling `Circle[]`, the variant table
// (which holds `Circle`) declined it, and `en` came back `""`. Declining is not neutral
// there: `dstPinAnnIn` records `""` as a destination DISAGREEMENT, so the one delivery vetoes
// the pin. Un-pinned, `lv1`'s object literal resolves through `structIndexOfObj`, which finds
// the layout twin `Dot`, while the annotated destination declares `uVarHeap[Circle]` — `vl
// check` rc 0 and `type mismatch: expected (ref null $type), found (ref $type)`.
//
// THE THREE NOMINAL INGREDIENTS ARE ALL REQUIRED and the flat control is what says the pin
// already handles this element once it is asked the right question: `Circle[]` runs on master
// and `Circle[][]` does not, which is the ONE cut. `pinArmListName` is that question in the
// form the element arm can call, and `arrLeafNameOf` — the exported leaf peel, which had 15
// callers in the monomorphizer and none in this family — is the cut.
//
// EVERY EARLIER GRID FOR THIS CLASS BUILT THE CONTAINER AS A MAP (`d52` `d88` `d94` `d111`
// `d112` `d131` `d139` and the D156 position grid), which is why the list spelling of a
// coordinate seven grids covered was never generated.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Dot = { r: i32 }

// The filed witness.
const lv1 = [{ r: 7 }]
const c: Circle[][] = [lv1]
const g0 = c
if g0.length > 0 {
  const g1 = g0[0]
  if g1.length > 0 {
    if g1[0].r == 7 { print(7) } else { print(0) }
  } else { print(0) }
} else { print(0) }

// THE FLAT CONTROL, which ran before this change and must keep running: the same delivery one
// container in, where rung 1's `variantIndexOf("Circle")` already answers.
const lv2 = { r: 7 }
const cf: Circle[] = [lv2]
if cf[0].r == 7 { print(7) } else { print(0) }

// The same shape inside a FUNCTION, where the pin runs through `dstPinScan` rather than
// `synthGlobalDstPinAnn`.
function inFn() {
  const lv3 = [{ r: 7 }]
  const c3: Circle[][] = [lv3]
  if c3[0][0].r == 7 { print(7) } else { print(0) }
}
inFn()
