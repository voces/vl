// @run
// @log arg null
// @log ret null
// @log let null
// @log field null
// @log elem null
// @log asg null
// @log join null
// @log join s
// Q58 position sweep: a name the checker types `null` delivered into a union box (`U`), whose
// payload is the bottom ref (`emitNulNoneBoxPayload`): an argument, a return, a `let`, a record
// field, a list element, an assignment's value and an `if` arm.
type U = i32 | string | null
type R = { u: U }
function show(tag: string, u: U) {
  if u == null { print(tag + " null") }
  else if u is string { print(tag + " " + u) }
  else { print(tag + " i32") }
}
function asArg() {
  const n = null
  show("arg", n)
}
function asRet(): U {
  const n = null
  return n
}
function asLet() {
  const n = null
  const u: U = n
  show("let", u)
}
function asField() {
  const n = null
  const r: R = { u: n }
  show("field", r.u)
}
function asElem() {
  const n = null
  const xs: U[] = [n]
  show("elem", xs[0])
}
function asAsg() {
  const n = null
  let u: U = 0
  u = n
  show("asg", u)
}
function asJoin(c: boolean) {
  const n = null
  const u: U = if c { n } else { "s" }
  show("join", u)
}
asArg()
show("ret", asRet())
asLet()
asField()
asElem()
asAsg()
asJoin(true)
asJoin(false)
