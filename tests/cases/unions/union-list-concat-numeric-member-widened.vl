// @run
// @log 3
// @log 1.5
// @log q
// @log 3
// @log 1.5
// @log 8
// A union list joined with one whose `i32` member the other holds only as `f64` (or `i64`): each
// such box is rebuilt under the wider member, in `+` either way round and in a spread (D16880).
const a: (string | f64)[] = ["p"]
const b: (string | i32)[] = [1, "q"]
const xs = a + b
print(xs.length)
const e = xs[1]
if e is f64 { print(e + 0.5) }
print(xs[2])
const ys = [...b, ...a]
print(ys.length)
const f = ys[0]
if f is f64 { print(f + 0.5) }
const c: (string | i64)[] = ["p"]
const d: (string | i32)[] = [7]
const zs = c + d
const g = zs[1]
if g is i64 { print(g + (1 as i64)) }
