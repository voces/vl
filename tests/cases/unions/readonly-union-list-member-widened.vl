// @run
// @log 8
// @log b
// @log s
// @log 5000000007
// @log null
// @log 3
// @log 6
// @log 4
// @log 4
// @log 2
// @log 4
// @log 1
// @log 2
// @log 2
// D2999: a list of union boxes delivered as a `readonly` list whose element holds one of their
// scalar members only widened is copied, each box rebuilt under the widened member, so a read
// of that member in the destination sees the widened value.
function view(xs: readonly (string | i64)[]) {
  const v = xs[0]
  if v is i64 { print(v + 1) } else { print(v) }
}
function go(c: boolean) {
  const l: (string | i32)[] = [if c { "b" } else { 7 }]
  view(l)
}
go(false)
go(true)

function j(c: i32): string | i32 | null {
  if c == 0 { return "s" }
  if c == 1 { return 7 }
  return null
}
function viewAll(xs: readonly (string | i64 | null)[]) {
  let i = 0
  while i < xs.length {
    const v = xs[i]
    if v is i64 { print(v + 5000000000) }
    else if v is string { print(v) }
    else { print("null") }
    i = i + 1
  }
}
const all = [j(0), j(1), j(2)]
viewAll(all)

function f(c: boolean): string | f32 {
  if c { return "s" }
  return 1.5 as f32
}
function k(c: boolean): string | i32 {
  if c { return "s" }
  return 3
}
function twice(xs: readonly (string | f64)[]) {
  const v = xs[0]
  if v is f64 { print(v * 2.0) } else { print(v) }
}
const fs = [f(false)]
twice(fs)
const ks = [k(false)]
twice(ks)

function first(xs: readonly (string | i64)[]) {
  const v = xs[0]
  if v is string { print(v) } else { print(v + 1) }
}
function local() {
  const m = [k(false)]
  const n: readonly (string | i64)[] = m
  first(n)
  const box: { [string]: readonly (string | i64)[] } = Map()
  box["k"] = m
  const got = box["k"]
  if got != null { first(got) }
  print(m.length + n.length)
}
local()
const inferred = [k(false)]
first(inferred)

// A source written after the delivery keeps sharing the list with the view.
const grown = [k(true)]
function len(xs: readonly (string | i64)[]) { print(xs.length) }
len(grown)
grown.push(k(true))
len(grown)

// A parameter root is shared too: the caller's later write is seen through the view.
function back(x: (string | i32)[]): readonly (string | i64)[] { return x }
const kept = [k(true)]
const view2 = back(kept)
kept.push(k(true))
print(view2.length)
