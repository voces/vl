// @run
// @hint redundant type annotation: `s` is inferred as `string` — remove it to lean on inference
// @hint redundant type annotation: `u` is inferred as `string` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// @log hi
// @log hi!
// @log hi
// @log hi
// @log c
// @log n
// A `string | null` field every arm of a record union stores, read off the un-narrowed union
// after a null test of the read, is delivered non-null into a string slot (D16728): printed,
// concatenated, after an early return, returned, and over a three-arm union.
type A = { v: string | null }
type B = { v: string | null, w: i32 }
type C = { v: string | null, z: boolean }
function p(x: A | B) {
  if x.v != null { print(x.v) }
}
function q(x: A | B) {
  if x.v != null { print(x.v + "!") }
}
function r(x: A | B) {
  if x.v == null { return }
  const s: string = x.v
  print(s)
}
function t(x: A | B | C) {
  if x.v != null { print(x.v) }
}
function u(x: A | B): string {
  if x.v != null { return x.v }
  return "n"
}
p({ v: "hi" })
p({ v: null, w: 3 })
q({ v: "hi" })
r({ v: null, w: 3 })
r({ v: "hi" })
t({ v: null, z: true })
t({ v: "hi", w: 1 })
t({ v: "c", z: false })
print(u({ v: null, w: 2 }))
