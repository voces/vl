// @run
// @log b
// @log z
// @log b
// @log b
// @log b
// @log b
// An un-annotated join of a record union's field, captured by a closure and coalesced
// there, in a function frame and at module scope, as a statement body and a lambda value,
// through a copy and a null test (D5332).
type N = { tag: "a", v: i32 } | { tag: "b", w: i32 }
function mk(a: boolean): N | null {
  if a { return null }
  { tag: "b", w: 2 }
}
function frame(r: N | null) {
  const c = if r != null { r.tag } else { null }
  const g = () => {
    const v = c
    print(v ?? "z")
  }
  g()
}
frame(mk(false))
frame(mk(true))
const r = mk(false)
const c = if r != null { r.tag } else { null }
const g = () => {
  print(c ?? "z")
}
g()
const h = () => c ?? "z"
print(h())
const k = () => {
  if c != null { print(c) }
}
k()
const q = r?.tag
const p = () => {
  print(q ?? "z")
}
p()
