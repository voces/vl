// @run
// @log 42
// @log notstr
// @log hi
// @log hi!
// @log 42
// @log ok
// @log str
// `is` and `match` over a declared alias with a function-type arm (D3269): the alias's arm
// keeps its parens, so the test reads the arm the box holds, at a binding and a parameter.
type F = ((x: i32) => i32) | string
type T = ((x: i32) => i32) | ((s: string) => string) | string
const f: F = (x: i32) => x + 1
if f is (x: i32) => i32 { print(f(41)) } else { print("else") }
if f is string { print("str") } else { print("notstr") }
function show(g: F) {
  if g is string { print(g) } else { print("fn") }
}
show("hi")
const a: T = (s: string) => s + "!"
const b: T = (x: i32) => x * 2
if a is (s: string) => string { print(a("hi")) } else { print("else") }
if b is (x: i32) => i32 { print(b(21)) } else { print("else") }
if a is (x: i32) => i32 { print("bad") } else { print("ok") }
const s: F = "s"
match s {
  string => print("str")
  _ => print("other")
}
