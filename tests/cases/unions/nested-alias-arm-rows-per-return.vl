// @run
// @log a
// @log b
// @log n
// @log same
// A union alias nested in a union reaches each return boxing as flattened record arms, and two
// record arms with the same field names find their own rows, not the first same-named row.
type A = { a: i32 }
type B = { b: string }
type AB = A | B
type U = AB | i32
function mk(i: i32): U {
  if i == 0 { return { a: 1 } }
  if i == 1 { return { b: "x" } }
  return 7
}
type C = { a: string }
type V = A | C
function pick(i: i32): V {
  if i == 0 { return { a: 1 } }
  return { a: "s" }
}
function show(u: U): string {
  if u is i32 { return "n" }
  if u is A { return "a" }
  return "b"
}
print(show(mk(0)))
print(show(mk(1)))
print(show(mk(2)))
const p = pick(0)
const q = pick(1)
if p is A && q is C { print("same") } else { print("wrong") }
