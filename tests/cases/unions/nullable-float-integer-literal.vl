// @run
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// @hint redundant type annotation: `arg64` is inferred as `f64`
// @hint redundant type annotation: `arg32` is inferred as `f32`
// An INTEGER literal boxed into a union whose only numeric atom is a FLOAT. The f64 half
// is a PRE-EXISTING invalid-wasm bug, reproduced on master before the fix:
//
//   const x: f64 | null = 1     ->  "type mismatch: expected anyref, found i32"
//
// `vl check` clean, in the GLOBAL, LOCAL and ARGUMENT positions alike.
//
// `emitUnionCoerce` settles a value-atom code for the payload. Its i32 default promotes to
// `i64` when the union has no i32 atom — but the LIST arm of the very same ladder promotes
// an i32-element list to i64[] / f64[] / f32[], three targets, on identical reasoning. The
// scalar arm had been taught only the first of the three, so an integer flowing into a
// float-only union kept the i32 code and boxed an i32 into the float value box.
//
// The two spellings that WORKED are what localize it: `i64 | null = 1` took the taught
// half, and `f64 | null = 1.0` classifies as a float up the ladder and never reaches the
// default. Both are controls at the bottom.

// f64 — GLOBAL, LOCAL and ARGUMENT.
const g64: f64 | null = 1
print(g64 ?? 0.0)

function local64() {
  const l: f64 | null = 1
  print(l ?? 0.0)
}
local64()

function arg64(v: f64 | null): f64 { return v ?? 0.0 }
print(arg64(1))

// f32 — the same three, reachable since the P2 integer-literal grant.
const g32: f32 | null = 1
print(g32 ?? 0.0)

function local32() {
  const l: f32 | null = 1
  print(l ?? 0.0)
}
local32()

function arg32(v: f32 | null): f32 { return v ?? 0.0 }
print(arg32(1))

// A float-only union with a NON-null second member takes the same promotion — the rule is
// "no i32 atom, a float atom", not "nullable".
const mixed: f64 | string = 1
if mixed is f64 { print(mixed) }

// CONTROLS — the two spellings that already worked.
const gi64: i64 | null = 1
print(gi64 ?? 0)

const gflt: f64 | null = 1.0
print(gflt ?? 0.0)
