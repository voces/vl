// GRADUATED from `silent-class-inventory` D99 — a VARIANT-typed PARAMETER re-bound to a local
// and returned from an UN-ANNOTATED function, beside an EXACT LAYOUT TWIN. It was `vl check`
// rc 0 and a module the engine refuses (`type mismatch: expected i32, found (ref $type)`);
// found by the ablation grid that closed D45/D51/D53/D58, as the only silent cells that grid
// still held.
//
// THE TWIN IS THE AXIS AND IT ROUTED AROUND A FLOOR THAT WAS ALREADY THERE — D63's sentence,
// one storage class over. Delete `type Dot` and the same program is the LOUD `emitProgram:
// field access but no struct type declared`; give the twin a DIFFERENT field name and it is
// the LOUD `emitProgram: field access receiver is not a struct`. With the exact twin,
// `structIndexOfLet` falls through to `structIndexOfExpr`, whose non-kind-gated legs resolve
// the variant parameter to the TWIN's struct row, so the functype promised `(ref $Dot)` over a
// body yielding `(ref $uVarHeap[Circle])`.
//
// THE FIX IS THE STRUCT TWIN'S OWN TWIN, ASKED FIRST. `criClassify`'s returned-local block
// called `structIndexOfLet` for the struct half and only `letAnnVariantIdx` — the ANNOTATION
// alone — for the variant half, while `variantIndexOfLet` is `structIndexOfLet`'s arm-for-arm
// complement (annotation, then `exprVariantIndex` of the initializer) and was already written
// and exported. Asked before the struct arm, storage class beats a structural twin, which is
// verbatim the ordering D57 measured for `emitStructEq`'s two ladders. Safe by
// `exprVariantIndex`'s own documented property: every arm of it is REP-AUTHORITATIVE and it
// carries NO object-literal field-set leg, so a bare `return { r: n }` still falls to the
// struct arm where `Dot` is the right answer.
//
// THE `direct` ROW IS THE ONE THAT ALREADY RAN — D52's `exprVariantIndex` return-expression
// rung covers `return c` with no local at all. It is here because the difference between it
// and the two rows above is the whole content of this row: one binding hop was enough to
// leave the ladder.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Dot = { r: i32 }

// THE WITNESS: one binding hop.
function mkLocal(c: Circle) {
  const o = c
  return o
}

// Two hops.
function mkAlias(c: Circle) {
  const o = c
  const p = o
  return p
}

// The row that already ran: no local.
function mkDirect(c: Circle) { return c }

// The result ANNOTATED — D39's control, which ran throughout.
function mkAnn(c: Circle): Circle {
  const o = c
  return o
}

print(mkLocal({ r: 7 }).r)
print(mkAlias({ r: 7 }).r)
print(mkDirect({ r: 7 }).r)
print(mkAnn({ r: 7 }).r)
