// @run
// @log notA
// @log B
// @log A
// @log notB
// Record arms whose shared field is `i64` in one and `i32` in the other (D4056). The widths
// widen by assignment, yet no value is both, so `is` reads the arm the value was built as.
type A = { q: i64 }
type B = { q: i32 }
function pick(b: boolean): A | B {
  if b {
    const a: A = { q: 5 as i64 }
    return a
  }
  const v: B = { q: 7 }
  v
}
const u = pick(false)
if u is A { print("A") } else { print("notA") }
if u is B { print("B") } else { print("notB") }
const w = pick(true)
if w is A { print("A") } else { print("notA") }
if w is B { print("B") } else { print("notB") }
