// @run
// @log 0
// @log 1
// @log 1
// @log 0
// @log 10
// @log 1
// @log 0
// `is` with an arm the instance's record can never match, over a hole parameter bound from a
// union member's field read, is false; the same function over the union reads the box (D12520).
type O = { n: i32 }
type P = { m: i32, k: i32 }
type U = O | P
type W = { w: O }
function v(q) {
  if q is P { return 1 }
  return 0
}
function t(q) {
  if q is O { return 1 }
  return 0
}
function g<T>(q: T) {
  if q is P { return 1 }
  return 0
}
const ww: W = { w: { n: 4 } }
const uu: U = { m: 1, k: 2 }
print(v(ww.w))
print(t(ww.w))
print(v(uu))
print(g(ww.w))
const r = v(ww.w) + 10
print(r)
const xs = [v(ww.w), t(ww.w)]
print(xs[0] + xs[1])
// A wider record is no more the arm than a narrower one: `is` over records reads field names.
type Q = { m: i32, k: i32, j: i32 }
type UQ = Q | P
type WQ = { w: Q }
const wq: WQ = { w: { m: 1, k: 2, j: 3 } }
print(v(wq.w))
