// @run
// @log 7
// @log 0
// @log 2
// @log 7
// @hint redundant type annotation: `c` is inferred as `{r: i32}`
// @hint redundant type annotation: `wv` is inferred as `{g: Circle}`
// @hint redundant type annotation: `nv` is inferred as `{g: Nul}`
// @hint redundant type annotation: `l` is inferred as `{xs: i32[]}`
// @hint redundant type annotation: `lv` is inferred as `{g: Lst}`
// A struct FIELD whose declared type is a union ARM (silent-class-inventory D761). Master
// refused this on the DECLARATIONS ALONE — `type Shape = Circle | Sq` beside
// `type GW = { g: Circle }` was a loud emit reject with no value anywhere in the program,
// because `collectS` SKIPS a `type X = {…}` that is a union member, so `nameIsStructDecl`
// declined the field and the code-15 rung declined with it.
//
// It was a lost CLASSIFICATION, not a missing rep: `g: Dot` over a declared layout twin, and
// the inline `g: {r: i32}`, both held a `Circle` value and read it back. The field is coded
// 15 against `variantStructHeapTwinAt` now — the exact row `mAssignTypeIndices` reads when it
// writes `uVarHeap[vi] = sHeapIdx[uVarSTwinAt(vi)]` — so the slot IS the arm's own heap.
// Disassembled: `(type $1 (struct (field (mut i32))))` is both `Circle` and the field's
// target, and `GW` is `(struct (field (mut (ref null $1))))`.
//
// FOUR SPELLINGS, and they must all answer alike: the bare arm, the `arm | null` niche, an
// arm with a LIST field (which is what corpus cell `a007807` carries), and an arm whose own
// field is nullable (`b000095`).
type Sq = { s: i32 }
type Circle = { r: i32 }
type Nul = { n: i32 | null }
type Lst = { xs: i32[] }
type Shape = Circle | Sq
type Shape2 = Nul | Sq
type Shape3 = Lst | Sq

type GW = { g: Circle }
type GN = { g: Nul }
type GL = { g: Lst }
type GO = { g: Circle | null }

function rd() {
  const c: Circle = { r: 7 }
  const wv: GW = { g: c }
  print((wv.g).r)

  const n: Nul = { n: null }
  const nv: GN = { g: n }
  if (nv.g).n != null { print(7) } else { print(0) }

  const l: Lst = { xs: [1, 2] }
  const lv: GL = { g: l }
  print((lv.g).xs.length)

  const ov: GO = { g: c }
  if (ov.g) != null { print(7) } else { print(0) }
}
rd()
