// @log true
// @log false
type F = (i32) => i32
type M = { [string]: i32 }
function mk(): M {
  const m: M = Map()
  m["a"] = 1
  return m
}
function kf(w: F | null | i32) {
  if w is i32 { print(w) } else { print(w == null) }
}
function km(w: M | null | i32) {
  if w is i32 { print(w) } else { print(w == null) }
}
function narrowedF(w: F | null | string) {
  if w is string { return }
  kf(w)
}
function plainF(w: F | null) { kf(w) }
function narrowedM(w: M | null | string) {
  if w is string { return }
  km(w)
}
function plainM(w: M | null) { km(w) }
narrowedF(null)
narrowedF((x: i32) => x)
plainF(null)
plainF((x: i32) => x)
narrowedM(null)
narrowedM(mk())
plainM(null)
plainM(mk())
