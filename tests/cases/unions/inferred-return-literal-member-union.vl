// @run
// @log 10
// @log failed
// @log 9000000000
// @log s
// An un-annotated function returning a union whose leaves are literals and plain scalars over two
// bases lowers as the box its annotated twin does: a callee's `i32 | "err"` (D1194), a two-width
// literal union and a literal of each kind (D3512).
type D = 9000000000 | 1
function mk(b: boolean): i32 | "err" {
  if b { return "err" }
  return 5
}
function wrap(b: boolean) { return mk(b) }
function wide(): D { 9000000000 }
function wrapWide() { return wide() }
function mixed(): 1 | "s" { "s" }
function wrapMixed() { return mixed() }
const r = wrap(false)
if r is "err" { print("failed") } else { print(r * 2) }
const q = wrap(true)
if q is "err" { print("failed") } else { print(q * 2) }
print(wrapWide())
const m = wrapMixed()
if m is string { print(m) } else { print("num") }
