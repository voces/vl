// @run
// @log true
// @log 1
// @log 1
// @log true
// @log a
// @log 1
// @log 1
// @log 1
// @log 5
// @log true
// @log 2
// @log false
// D4896: a list of `string[] | boolean[]` beside a list of `string[] | i32[]` keeps each
// element's own union, so `is`, `match` and `for` answer for the arm that built the value
// whichever of the two the program spells first.
const a: (string[] | boolean[])[] = [["a"], [true]]
const a1 = a[1]
if a1 is boolean[] { print(a1[0]) } else { print("a-miss") }
const z: (string[] | i32[])[] = [["a"], [1]]
const z1 = z[1]
if z1 is i32[] { print(z1[0]) } else { print("z-miss") }

function g(zs: (string[] | i32[])[]) {
  const e = zs[1]
  if e is i32[] { print(e[0]) } else { print("g-miss") }
}
g(z)

function h(bs: (string[] | boolean[])[]) {
  const e = bs[1]
  if e is boolean[] { print(e[0]) } else { print("h-miss") }
}
h(a)

for e in z {
  if e is i32[] { print(e[0]) }
  else if e is string[] { print(e[0]) }
}

match z1 {
  i32[] => print(z1.length)
  string[] => print("s")
}

type Z = { xs: (string[] | i32[])[] }
const zr: Z = { xs: [[1]] }
const zr0 = zr.xs[0]
if zr0 is i32[] { print(zr0[0]) } else { print("field-miss") }

const bn: (string[] | boolean[][])[] = [["a"], [[true]]]
const zn: (string[] | i32[][])[] = [["a"], [[5]]]
const zn1 = zn[1]
if zn1 is i32[][] { print(zn1[0][0]) } else { print("nested-miss") }
const bn1 = bn[1]
if bn1 is boolean[][] { print(bn1[0][0]) } else { print("nested-b-miss") }

const bq: (f64[] | (boolean | null)[])[] = [[1.5], [true, null]]
const bp: (f64[] | boolean[])[] = [[1.5], [false]]
const bq1 = bq[1]
if bq1 is (boolean | null)[] { print(bq1.length) } else { print("nul-miss") }
const bp1 = bp[1]
if bp1 is boolean[] { print(bp1[0]) } else { print("bool-miss") }
