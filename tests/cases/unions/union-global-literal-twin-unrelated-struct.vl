// @run
// @log x
// @log 5
// The fieldset twin that decides a union global's mis-resolution need NOT be the union arm's
// own nested field type: `Other = {n: string}` shares only the field-name SET `{n}` with the arm
// `Outer = {n: Leaf}` and has nothing else to do with it. `structIndexOfLet` resolved the union
// global's object-literal initializer by field-name set and handed back `Other`'s row for `u`,
// which took the whole `{n}` family down with it — the emit stopped at `field access receiver is
// not a struct` on the FIRST `{n}` read in the module (the `Other` param read below), not just
// on the narrowed one.
//
// This is the control that separates the axis from the nesting: the sibling fixture
// `union-global-literal-fieldset-twin-nested-read.vl` collides with its OWN field's type, which
// is what made the defect look like "a union arm carrying a struct-typed field". Delete the
// union here and the identical `Other` / `Outer` / `Leaf` shapes compile and run.
type Leaf = { z: i32 }
type Other = { n: string }
type Outer = { n: Leaf }
type U = Outer | boolean

function useOther(x: Other) { print(x.n) }

const u: U = { n: { z: 5 } }
useOther({ n: "x" })
if u is Outer { print(u.n.z) } else { print(0) }
