// @run
// @log 1
// @log 5
// @log 1
// A field one member of a record union stores as a record and another as `null` reads as that
// record or `null`, dispatched on the box tag, directly and in a hole function (D15717).
function mk(b: boolean) {
  if b { { j: { a: 1 } } } else { { j: null } }
}
function rd(v) { v.j?.a ?? 5 }
const y = mk(true)
print(y.j?.a ?? 0)
print(rd(mk(false)))
const q = y.j
if q != null { print(q.a) }
