// @log 5
// The un-annotated face of D13760: the list's element type is inferred as the arm `A`, and
// its record field's inline literal still builds as `P`, not as `A`.
type P = { x: i32 }
type A = { p: P }
type U = A | { n: i32 }

const xs = [{ p: { x: 5 } }]
print(xs[0].p.x)
const ys = [{ p: { x: 6 } }, { p: { x: 7 } }]
print(ys[0].p.x + ys[1].p.x)
function mk() { [{ p: { x: 5 } }] }
print(mk()[0].p.x)
