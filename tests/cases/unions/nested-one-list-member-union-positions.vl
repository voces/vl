// A union of nested lists that all spell one list (`i32[][] | K[][]`) is that list at every
// position: a binding, a parameter, a return, a capture, a nullable, a map value and a list element.
type K = 1 | 2
type A = i32[][] | K[][]

function first(p: i32[][] | K[][]): i32 { return p[0][0] }
function make(): i32[][] | K[][] { return [[2, 1]] }
function orNull(n: A | null): i32 {
  if n != null { return n[0][0] }
  return 0
}
function mk(): (i32[][] | K[][]) | null { return [[8]] }

const q: i32[][] | K[][] = [[1]]
print(q[0][0])
const kk: K[][] = [[2]]
const r: i32[][] | K[][] = kk
print(r[0][0])
const ii: i32[][] = [[7, 8]]
print(first(ii))
print(make()[0][1])
const a: A = [[1, 2], [2]]
print(a.length)
print(a[1][0])
print(orNull(a))
print(orNull(null))
const w: i32[][] | K[][] = [[1, 2]]
if w is i32[][] { w[0][1] = 9 }
print(w[0][1])
const n: (i32[][] | K[][]) | null = [[4]]
if n != null { print(n[0][0]) }
const z = mk()
if z != null { print(z[0][0]) }
const e: i32[][] | K[][] = []
print(e.length)
const f = (): i32 => q[0][0] + 4
print(f())
const m: {[string]: i32[][] | K[][]} = Map()
m["a"] = [[6]]
const mv = m["a"]
if mv != null { print(mv[0][0]) }
const l: (i32[][] | K[][])[] = [[[7]]]
print(l[0][0][0])
// @log 1
// @log 2
// @log 7
// @log 1
// @log 2
// @log 2
// @log 1
// @log 0
// @log 9
// @log 4
// @log 8
