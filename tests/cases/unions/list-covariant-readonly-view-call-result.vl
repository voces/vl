// @run
// @log 1
// @hint redundant type annotation: `a` is inferred as `{r: i32}[]` — remove it to lean on inference
// @hint Intentionally-unused function `__other` (leading `_` marks it unused)
// THE HINT IS DECLARED, NOT REMOVED: `const a: Circle[]` is the covariant source, so
// deleting the annotation deletes what this fixture pins.
// D1686's shape with the receiving parameter declared as a VIEW. The covariant-write
// closure declined this program because `mk(b).xs` consumes a call result under no name and
// no handle can be filed for it; a `readonly Shape[]` parameter needs no such handle, since
// nothing may write through it, so the closure ends at that edge instead of guessing.
//
// `__other` is the ingredient that makes the rep-scoped scan say "written": without it the
// program ran before this. It stays, so the licence being pinned is the view's.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box = { xs: readonly Shape[] }
function __other() {
  const w: Shape[] = []
  w.push({ s: 3 })
  print(w.length)
}
function mk(v: readonly Shape[]): Box { { xs: v } }
function f() {
  const a: Circle[] = [{ r: 7 }]
  const b: Shape[] = a
  print(mk(b).xs.length)
}
f()
