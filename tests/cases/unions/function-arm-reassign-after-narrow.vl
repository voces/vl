// @run
// @log 11
// @log 12
// @log aa1
// @log ab1
// @log aa
// @log bb
// @log 1
// @log 2
// A FUNCTION-typed union arm REASSIGNED under its own narrowing answered the
// INITIALIZER for every call after the first (#1821). `vl check --codegen` was clean, the
// module loaded, and it ran — a silently WRONG VALUE, the worst outcome class there is.
//
// The narrow is REQUIRED to observe it: a union cannot be called (`called value is not a
// function`), so there is no un-narrowed control to compare against. The write itself was
// never at fault — `let w = v` under the same narrowing read the NEW closure — the CALL was:
// the monomorphizer's registry-hit rename folded `v(10)` into a by-name call to the
// initializer lambda's instance, which no longer describes the cell.
//
// THE TWO NON-FUNCTION ARMS ARE THE ORACLE and are pinned here beside the defect: they always
// wrote back correctly, so a regression in EITHER direction is caught.
type Uz = { qz: i32 }

// (1) The i32-returning closure arm — the reported shape.
function fnArm() {
  let v: ((i32) => i32) | Uz = (n) => n + 1
  if v is Uz {
    print(v.qz)
  } else {
    print(v(10))
    v = (n) => n + 2
  }
  if v is Uz { print(v.qz) } else { print(v(10)) }
}

// (2) The STRING-returning closure arm. A second result rep, because the fold is on the
// CALLEE and nothing about it reads the result type — it answered `aa1 / aa1` too.
function strFnArm() {
  let s: ((i32) => string) | Uz = (n) => "aa" + toString(n)
  if s is Uz {
    print(s.qz)
  } else {
    print(s(1))
    s = (n) => "ab" + toString(n)
  }
  if s is Uz { print(s.qz) } else { print(s(1)) }
}

// (3) CONTROL: the `string` arm, which was always correct.
function strArm() {
  let t: string | Uz = "aa"
  if t is Uz {
    print(t.qz)
  } else {
    print(t)
    t = "bb"
  }
  if t is Uz { print(t.qz) } else { print(t) }
}

// (4) CONTROL: the `i32` arm, which was always correct.
function i32Arm() {
  let u: i32 | Uz = 1
  if u is Uz {
    print(u.qz)
  } else {
    print(u)
    u = 2
  }
  if u is Uz { print(u.qz) } else { print(u) }
}

fnArm()
strFnArm()
strArm()
i32Arm()
