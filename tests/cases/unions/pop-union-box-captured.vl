// @run
// @log 2
// @log 1
// @log 2
// @log 4
// @log 2
// @log 7
// @log 5
// @log 2

// D1883 — a captured un-annotated binding's env field is typed by `letInitCellKind`, and that
// ladder had no arm for a checked read over a value-union list. The arm cannot be
// `letPopUnionBoxElem`: that resolves the receiver through the AMBIENT locals, and this ladder
// runs with the CAPTURING frame's loaded, where the parent's receiver resolves to nothing.

// NOTHING here may annotate a captured binding `V | null` — an annotation types the env field
// through the other channel and hides the defect, as the D1882 fixtures record.

type V = i32 | string

function vs(): V[] { [1, 2] }

// The row's own witness: `.get(i)` bound un-annotated, then captured and narrowed.
function frame() {
  const src = vs()
  const c = src.get(1)
  const f = () => {
    if c is i32 { print(c) } else { print(0) }
  }
  f()
}

frame()

// The `.pop()` spelling of the same capture.
function framePop() {
  const src = vs()
  const c = src.pop()
  const f = () => {
    if c is i32 { print(c - 1) } else { print(0) }
  }
  f()
}

framePop()

// A NESTED closure — the capture crosses two frames, so the env field is built twice.
function frameNested() {
  const src = vs()
  const c = src.get(1)
  const outer = () => {
    const inner = () => {
      if c is i32 { print(c) } else { print(0) }
    }
    inner()
  }
  outer()
}

frameNested()

// The value must arrive UNBOXED under the narrow: a raw box cannot be added to itself.
function frameArith() {
  const src = vs()
  const c = src.get(1)
  const f = () => {
    if c is i32 { print(c + c) } else { print(0) }
  }
  f()
}

frameArith()

// The `!= null` consumer beside the `is` one.
function frameGuard() {
  const src = vs()
  const c = src.get(1)
  const f = () => {
    if c != null { print(2) } else { print(0) }
  }
  f()
}

frameGuard()

// The boundary: a captured non-nullable union keeps its box, and a captured nullable STRUCT
// keeps its own niche rather than reaching the new arm.
function mkv(): V { 7 }

function frameU() {
  const c = mkv()
  const f = () => {
    if c is i32 { print(c) } else { print(0) }
  }
  f()
}

frameU()

type Circle = { r: i32 }

function mkc(): Circle | null { { r: 5 } }

function frameC() {
  const c = mkc()
  const f = () => {
    if c != null { print(c.r) } else { print(0) }
  }
  f()
}

frameC()

// And a captured `i32 | null`, whose inner is no `TyUnion` at all: the new arm must decline it
// so its established cell is untouched.
function mkn(): i32 | null { 2 }

function frameN() {
  const c = mkn()
  const f = () => {
    if c != null { print(c) } else { print(0) }
  }
  f()
}

frameN()
