// @check
// @error member access '.v' on non-object A | B | null
// CONTRACT (must-error): a NULLABLE union return still requires the null check. `g(0)` may be
// `null`, so `g(0).v` is refused before the shared-field seam is reached at all — the read is
// not "a shared field on two of three members", it is a member access on a possibly-absent
// value. Narrowing first (`const u = g(0); if u != null { … }`) is the spelling that types.
type A = { v: i32 }
type B = { v: i32, w: i32 }
function g(n: i32): A | B | null {
  if n == 0 { return { v: 1 } }
  if n == 1 { return { v: 2, w: 3 } }
  return null
}
print(g(0).v)
