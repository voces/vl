// @run
// @log 0
// @log 1
// @log 1
// @log 0
// @log 1
// @log 0
// @log 1
// @log 2
// `x is K[]` over a box union whose list arm is `i32[]…[]` and `K` a set of `i32` literals: the
// arm's tag, then every leaf a member, so an empty list fits (D4778); the nested arm too (D16884).
type K = 0 | 1
function f(x: i32[] | string) {
  if x is K[] { print(1) } else { print(0) }
}
f([5])
f([1, 0])
f([])
f("s")
function g(x: i32[][] | string) {
  if x is K[][] { print(1) } else { print(0) }
}
g([[1]])
g([[3]])
g([])
function h(x: i32[][] | string) {
  if x is K[][] { print(x.length) } else { print(-1) }
}
h([[1], [0, 1]])
