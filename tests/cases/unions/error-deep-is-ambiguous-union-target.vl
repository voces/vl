// @error is not a JSON shape — `{x: i32} | {x: i32, y: i32 | null}` is an ambiguous union of shapes
// THE S3 RULING'S OWN CONSEQUENCE, pinned. An absent key matches a `T | null` field as
// `null`, so a field typed `T | null` is NOT a required key — which means `{x} | {x, y: T |
// null}` has ONE required key set and no walker can tell the two arms apart. The union is
// refused at the `is` site, naming both arms, rather than silently picking the first that
// matches. `T | null` itself stays supported: that is the one union shape whose arms a
// present/absent test separates.
type Json = null | boolean | f64 | string | Json[] | { [string]: Json }
type T1 = { x: i32 }
type T2 = { x: i32, y: i32 | null }
type Amb = T1 | T2
const m: { [string]: Json } = Map()
const j: Json = m
print(j is Amb)
