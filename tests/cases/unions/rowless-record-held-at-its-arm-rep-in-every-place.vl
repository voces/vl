// @run
// @log false
// @log true
// @log true
// @log true
// @log true
// @log 1
// @log true
// A record type with no row of its own (`{r: null}`) narrower than a union arm is held at that arm's
// rep in every place: a returned nullable, a map's default and hit, a chained default, a list
// read off a map beside an annotated twin. Each value keeps its own type.
type Circle = { r: i32 | null }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = {[string]: {r: i32 | null}[]}
const _sp1: Box1 = Map()

// A returned `{r: null} | null`, which ran before the record took the arm's rep.
function g(k: i32): {r: null} | null {
  return if k > 0 { { r: null } } else { null }
}
print(g(1) == null)
print(g(0) == null)

const m = Map()
m["k"] = { r: null }
// The miss arm's default, the hit's read narrowed, and a chained default.
const z = m["j"] ?? { r: null }
print(z.r == null)
const h = m["k"]
if h != null { print(h.r == null) } else { print("miss") }
const c = m["j"] ?? m["k"] ?? { r: null }
print(c.r == null)

// A list of the record read off a map, beside an annotated map of the arm's twin.
const lm = Map()
lm["k"] = [{ r: null }]
const ls = lm["k"] ?? []
print(ls.length)
if ls.length > 0 { print(ls[0].r == null) }
