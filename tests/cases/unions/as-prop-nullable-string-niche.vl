// @run
// @log okay!
// @log none
// @log <okay>
// @log none
// @log 4
// @log -1
// The propagating `as string` over a `string | null`: a present value is the string, and a null
// returns the enclosing function's own null, through a plain return or a union one.
function nm(k: i32): string | null {
  if k > 0 { return "okay" } else { return null }
}
function bang(k: i32): string | null { return (nm(k) as string) + "!" }
print(bang(1) ?? "none")
print(bang(0) ?? "none")
function wrap(k: i32): string | null {
  const s = nm(k) as string
  return "<\{s}>"
}
print(wrap(1) ?? "none")
print(wrap(0) ?? "none")
function len(k: i32): string | i32 | null {
  const s = nm(k) as string
  return s.length
}
print(len(1) ?? -1)
print(len(0) ?? -1)
