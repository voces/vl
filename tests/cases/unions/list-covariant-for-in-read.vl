// @run
// @log 7
// @log 1
// @log 1
// @hint redundant type annotation: `a` is inferred as `{r: i32}[]` — remove it to lean on inference
// A covariant list read by `for … in` (D1659).
//
// The loop binds each ELEMENT, so it takes no handle on the list itself and nothing here
// writes either one — the same reason an index read is claimed, one syntax over. The
// accounting pass had no arm for an iterable, so the answer was unknown and `other`'s
// unrelated write to a `Shape[]` was enough to decline the converting copy.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq

function f() {
  const a: Circle[] = [{ r: 7 }]
  const b: Shape[] = a
  for e in b {
    if e is Circle { print(e.r) }
  }
  print(a.length)
}

function other() {
  const w: Shape[] = []
  w.push({ s: 3 })
  print(w.length)
}

f()
other()
