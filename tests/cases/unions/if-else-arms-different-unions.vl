// D2326 matrix — the shared name `u` is bound once per `if`/`else` ARM, each to a
// DIFFERENT struct union. Both arms compile (only one runs per call), so a fixed `cond`
// cannot tell them apart — call `f` once per arm.
// @run
// @log 5
// @log inner

type A = { x: i32 }
type B = { y: string }
type C = { z: boolean }

function f(cond: boolean) {
  let out = ""
  if cond {
    const u: A | B = { x: 5 }
    if u is A { out = "\{u.x}" } else { out = "\{u.y}" }
  } else {
    const u: C | B = { z: true }
    if u is C { out = "inner" } else { out = "\{u.y}" }
  }
  out
}
print(f(true))
print(f(false))
