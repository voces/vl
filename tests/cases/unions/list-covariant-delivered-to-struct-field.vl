// @run
// @log 7
// @log 1
// @hint redundant type annotation: `a` is inferred as `{r: i32}[]` — remove it to lean on inference
// @hint redundant type annotation: `sf` is inferred as `{xs: Shape[]}` — remove it to lean on inference
// A covariant list delivered into a struct field (D1628).
//
// The `Writable` licence for the element-converting copy is a per-value alias closure whose
// accounting pass is a whitelist: an occurrence in a form with no arm answers `2` (unknown),
// the copy is declined, and the emitter builds a module the engine refuses. Delete `other`
// and its write and this program runs either way, which is what makes it the analysis.
// The claim is granted into a sealed container only — `sf` is bound once and read only by
// projecting out of it, so `sf.xs` is the one handle and the write scan sees every store.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box = { xs: Shape[] }

function f() {
  const a: Circle[] = [{ r: 7 }]
  const b: Shape[] = a
  const sf: Box = { xs: b }
  const e = sf.xs[0]
  if e is Circle { print(e.r) }
}

function other() {
  const w: Shape[] = []
  w.push({ s: 3 })
  print(w.length)
}

f()
other()
