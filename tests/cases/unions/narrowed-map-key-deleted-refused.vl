// @error 'm["k"]' is no longer narrowed to A
// A map key deleted between the test and the read drops the narrowing: the missing key is not reachable.
type A = { r: i32 }
type M = i32 | A
function f() {
  const m: { [string]: M } = Map()
  m["k"] = { r: 3 }
  if m["k"] is A {
    m.delete("k")
    print(m["k"].r)
  }
}
f()
