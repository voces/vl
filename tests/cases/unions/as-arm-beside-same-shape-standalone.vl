// A cast names a union ARM whose type is also a standalone record's, declared first (D15670).
// The type alone answers the first declaration, so the arm's tag is read off the declaration
// the cast names. Each spelling of the cast, and the standalone record beside it, must run.
// @run
// @log 3
// @log 5
// @log 0
// @log 7
// @log 9
// @log 4

type CircleC = { r: i32 }
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq

function trapCast(s: Shape) {
  const c = s as! Circle
  c.r
}
function nullCast(s: Shape) {
  const c = s as? Circle
  if c == null { return 0 }
  c.r
}
function propCast(s: Shape): i32 | Sq {
  const c = s as Circle
  c.r
}
const v: Circle = { r: 3 }
print(trapCast(v))
const w: Circle = { r: 5 }
print(nullCast(w))
const q: Sq = { s: 1 }
print(nullCast(q))
const x: Circle = { r: 7 }
const p = propCast(x)
if p is i32 { print(p) } else { print(-1) }
const standalone: CircleC = { r: 9 }
print(standalone.r)

// A sub-union target: its arm is the member the union's declaration names.
type E = { why: string }
type Parsed = Circle | Sq | E
function area(s: Shape) {
  if s is Circle { return s.r }
  s.s
}
function narrow(p: Parsed): i32 | E {
  const s = p as Shape
  area(s)
}
const pc: Circle = { r: 4 }
const pr = narrow(pc)
if pr is i32 { print(pr) } else { print(pr.why) }
