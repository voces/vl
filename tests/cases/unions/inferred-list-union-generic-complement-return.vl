// @run
// @log true
// @log 3
// The complement arm of a generic's `is T[]` over an inferred `T[] | i32[]` returned from the
// instance, compared at the caller and narrowed inside a function (D5111).
function w<T>(t: T, b: boolean) {
  if b { return [t] }
  [1, 2, 3]
}
function rest<T>(t: T, b: boolean) {
  const u = w(t, b)
  if u is T[] { return w(t, false) } else { return u }
}
const v = rest("s", false)
print(v == v)
function inner() {
  const x = rest("s", false)
  if x is i32[] { print(x.length) } else { print(9) }
}
inner()
