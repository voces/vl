// @run
// @log 2
// @log 42
// @log 4
// @log lex
// THE REPORTER'S OWN SHAPE (D1579, the glean session's VL-032): a lexer answers
// `Tokens | LexError` where `Tokens` carries a `Buf` from `std:buffer`, and the parser wants a
// state struct holding a `Tokens` field. Every std container is a struct, so an arm holding one
// hit the cross-table layout guard and `ParserState`'s `toks` field had no rep — which is what
// made the consumer wrap its payload a second time.
//
// THE PROOF GOES THROUGH THE BUFFER, at two offsets: `loadI32` off the arm's `Buf` field is
// what proves the field's slot names the heap the buffer was built under. A fixture reading
// only `count` would pass over a module whose `toks` slot named a different heap type.
import { Buf, Buffer, loadI32, storeI32 } from "std:buffer"

type Tokens = { buf: Buf, count: i32 }
type LexError = { msg: string, line: i32 }
type ParserState = { toks: Tokens, pos: i32 }

function lex(ok: boolean): Tokens | LexError {
  if !ok { return { msg: "lex", line: 1 } }
  const b = Buffer(16)
  storeI32(b, 0, 40)
  storeI32(b, 4, 2)
  return { buf: b, count: 2 }
}

function peek(st: ParserState) {
  return loadI32(st.toks.buf, st.pos * 4) + st.toks.count
}

const t = lex(true)
if t is Tokens {
  print(t.count)
  print(peek({ toks: t, pos: 0 }))
  print(peek({ toks: t, pos: 1 }))
}
const e = lex(false)
if e is LexError { print(e.msg) }
