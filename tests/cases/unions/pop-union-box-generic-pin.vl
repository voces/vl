// @run
// @log 2
// @log 2
// @log 1
// @log 4
// @log 7
// @log 5

// D1882 — a nullable value union renders FLAT (`i32|string|null`), so the mono pin ladder
// had no name for the checked read's own type: the registry keys the union and not its
// nullable, and no rung peels a `null` off a three-part render. The arena holds both halves.

// NOTHING in this module may annotate a parameter `V | null`. One such annotation registers
// the flat spelling and RESCUES every un-annotated call below, on the pre-fix compiler too —
// measured, not assumed. The annotated face is `pop-union-box-generic-pin-annotated.vl`.

type V = i32 | string

function vs(): V[] { [1, 2] }

// The row's own witness: the read handed to an UN-ANNOTATED parameter, which has no
// annotation to name the union with and so must take the argument-derived pin.
function take(a) {
  if a is i32 { print(a) } else { print(0) }
}

const src = vs()
take(src.get(1))

// The `.pop()` spelling of the same delivery — one row serves both reads.
const src2 = vs()
take(src2.pop())

// The early-return guard, the matrix's second cell for this mechanism.
function guard(v) {
  if v is i32 {
    print(v)
    return
  }
  print(0)
}

const src3 = vs()
guard(src3.get(0))

// The pin has to be the FLAT render and not `V|null`: the alias spelling gives the instance
// the right cell and no unbox, so this prints a boxed atom rather than `4`.
function twice(b) {
  if b is i32 { print(b + b) } else { print(0) }
}

const src4 = vs()
twice(src4.get(1))

// The boundary: a non-nullable union argument still pins through the registry row, and a
// nullable STRUCT argument keeps its own niche rather than reaching the new arm.
function mkv(): V { 7 }

function takeU(u) {
  if u is i32 { print(u) } else { print(0) }
}

takeU(mkv())

type Circle = { r: i32 }

function mkc(): Circle | null { { r: 5 } }

function takeC(c) {
  if c != null { print(c.r) } else { print(0) }
}

takeC(mkc())
