// @run
// @log ok
// @log 1.5
// @log 1.5
// @log -1
// @log 1.5
// A `?.` read as a discarded statement, at module scope and in a function body, and as an
// implicit return of a declared function and of a lambda (D3009, D3706).
type D = { v: f64 }
type V = { x: f64 }
type Q = { v: V }
const c: {[string]: D} = Map()
c["k"] = { v: 1.5 }
const r = c["k"]
r?.v
print("ok")
function drop(m: {[string]: D}) {
  const s = m["k"]
  s?.v
  print(s?.v ?? -1.0)
}
drop(c)
const q: Q | null = { v: { x: 1.5 } }
function f() { q?.v }
print(f()?.x ?? -1.0)
function g(p: Q | null) { p?.v }
print(g(null)?.x ?? -1.0)
const h = (p: Q | null) => p?.v
print(h(q)?.x ?? -1.0)
