// @run
// @log 7
// @log 7
// @log 7
// @log 7
// @log x
// @log 7
// A declared union whose record arms are equal is that one record, as its inline spelling is;
// equal named arms (`A | B`) stay two declared types.
type R = { v: i32 } | { v: i32 }
type K = { k: "x" } | { k: "x" }
type A = { v: i32 }
type B = { v: i32 }
type N = A | B
function getV(r: R) { return r.v }
function readRec(x: { v: i32 }) { return x.v }
const r: R = { v: 7 }
print(r.v)
print(getV({ v: 7 }))
if r is { v: i32 } { print(r.v) }
print(readRec(r))
const kv: K = { k: "x" }
print(kv.k)
const n: N = { v: 7 }
print(n.v)
