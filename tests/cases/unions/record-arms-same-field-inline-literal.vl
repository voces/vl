// @run
// @log A
// @log B
// @log A
// @log B
// @log A
// @log B
// @log B
// @log A
// Inline record literals delivered into arms that share a field name (D4056): each literal is
// built as the arm its own field value fits, so `is` answers by that value.
type A = { v: 1 | 2 }
type B = { v: string }
type C = { v: "a" | "b" | null }
type D = { v: string }
function f(u: A | B) {
  if u is A { return "A" }
  "B"
}
function g(u: C | D) {
  if u is C { return "A" }
  "B"
}
print(f({ v: 2 }))
print(f({ v: "s" }))
print(g({ v: "a" }))
print(g({ v: "zz" }))
const xs: (A | B)[] = [{ v: 1 }, { v: "t" }]
for x in xs { print(f(x)) }
let w: C | D = { v: "q" }
print(g(w))
w = { v: "b" }
print(g(w))
