// @run
// @log 0
// @log 2
// @log 3
// @log 1
// @log 1
// @log 1
// @log 0
// @log 1
// @log 0

// `i32[] | K[]` with `K = 0 | 1` shares one list rep: the outer list is one type, and `is`
// over a member tests the elements (D6732, D6770).

type K = 0 | 1

const e: (i32[] | K[])[] = []
print(e.length)

const p: (i32[] | K[])[] = []
p.push([1, 0, 1])
p.push([1, 2])
print(p.length)

const xs: (i32[] | K[])[] = [[1, 0, 1], [1, 2]]
const v = xs[0]
const u = xs[1]
if v is i32[] { print(v.length) } else { print(-1) }
print(if v is i32[] { 1 } else { 0 })
print(if v is K[] { 1 } else { 0 })
print(if u is i32[] { 1 } else { 0 })
print(if u is K[] { 1 } else { 0 })

const a: i32[] | K[] = [1, 2]
print(if a is i32[] { 1 } else { 0 })
print(if a is K[] { 1 } else { 0 })
