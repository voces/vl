// @check
// @error field 'v' is not on every member of A | i32 — narrow with `is` first (i32 is not an object)
// CONTRACT (must-error): a union of a struct and a SCALAR has no shared field to read, however
// the value was spelled. The scalar member is not an object, so there is no per-member field to
// dispatch to and the read stays a checker reject — `if x is A { x.v }` is the spelling.
//
// The member-naming half of the diagnostic covers this arm too: the blocking member is named
// as a NON-OBJECT rather than as one missing the field, which is the honest distinction.
type A = { v: i32 }
function g(flag: boolean): A | i32 {
  if flag { return { v: 1 } }
  return 9
}
print(g(true).v)
