// @run
// @log 7
// @log s
// @log no
// Inline arms sharing a field name at different types: each literal builds its own arm, and
// `is` answers from the field's value (D4056).
type U = { v: i32 } | { v: string }
const a: U = { v: 7 }
const b: U = { v: "s" }
if a is { v: i32 } { print(a.v) }
if b is { v: string } { print(b.v) }
if b is { v: i32 } { print("yes") } else { print("no") }
