// @run
// @log 5
// @log 5
// @log 6
// @log 1
// @log 5
// @log 5
// @log true
// @hint redundant type annotation: `annotated` is inferred as `i32`
// THE ENCLOSING FUNCTION'S RETURN IS A FACE, and it was the one the deep-`is` matrix did
// not grade. The two-faces rule ("an annotated and an un-annotated spelling of one gap land
// in DIFFERENT clauses") was applied to the RECEIVER and to the ARM BINDING and not to the
// function whose body holds the test — and that is exactly where it bit.
//
// A function with an UN-ANNOTATED return is checked MORE THAN ONCE: the return-inference
// pass re-walks the body. Pass 1 recorded the deep `is` site once per visit, so one `is`
// produced two worklist rows; the rewrite is IN PLACE, so the second row found a `Call`
// where it expected an `IsExpr` and reported `internal: deep `is` site is not an `is`
// expression` — an `internal:` sentence reachable from a perfectly legal program, on a
// program whose annotated twin ran. The site list is now deduped by node index.
//
// The body's reads are SCENERY, and both of these were graded before the fix: one read or
// two, `.length` off an element or off the list, a struct target instead of a list one, a
// lambda instead of a named function. All of them failed un-annotated and all ran
// annotated, which is what says the ingredient is the RETURN and nothing in the arm.
type Json = null | boolean | f64 | string | Json[] | { [string]: Json }
type Cfg = { port: i32, host: string | null }

const lst: Json = ["xyzab"]

// The face that failed: no return annotation.
function inferred(r: Json) {
  if r is string[] { return r[0].length }
  0
}
print(inferred(lst))

// Its control, one annotation apart.
function annotated(r: Json): i32 {
  if r is string[] { return r[0].length }
  0
}
print(annotated(lst))

// Two reads of the narrowed binding, still inferred.
function twoReads(r: Json) {
  if r is string[] { return r[0].length + r.length }
  0
}
print(twoReads(lst))

// A read of the CONVERTED LIST rather than of an element.
function listOnly(r: Json) {
  if r is string[] { return r.length }
  0
}
print(listOnly(lst))

// A STRUCT target, inferred return — the same defect one shape over.
function structTarget(r: Json) {
  if r is Cfg { return r.port + 1 }
  0
}
const m: { [string]: Json } = Map()
m["port"] = 4.0
const asJson: Json = m
print(structTarget(asJson))

// A LAMBDA body, whose return is inferred by a different route and which ran throughout —
// kept so a fix that only taught the named-function path shows up here.
const viaLambda = (r: Json) => {
  if r is string[] { return r[0].length }
  0
}
print(viaLambda(lst))

// And the value position, which never had a return to infer.
const asBool = lst is string[]
print(asBool)
