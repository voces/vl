// D2326 matrix — the VALUE-union (scalar-atom) side of the same defect: two sibling blocks
// bind `v` to different value unions, narrowed and read as a raw scalar rather than a field
// (`emitIdentNode`'s `identReadIsUnionUnbox`/`unionNameOfIdentAt` path in `wasmEmit.vl`,
// distinct from the struct-union member-set complement `sibling-blocks-narrow-else-field-read.vl`
// covers).
// @run
// @log 5|true

function f() {
  let out = ""
  {
    const v: i32 | string = 5
    if v is i32 { out = "\{v}" } else { out = v }
  }
  {
    const v: boolean | string = true
    if v is boolean { out = out + "|\{v}" } else { out = out + "|" + v }
  }
  out
}
print(f())
