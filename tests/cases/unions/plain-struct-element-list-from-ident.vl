// Regression (silent-class-inventory D40, the NO-UNION half) — and it is a separate file for
// the reason `anon-objlit-list-elem-arm-no-twin.vl` is: whether `Circle` is a union ARM is a
// whole-program property, so the two states need two files.
//
// D40's own filed control says `Sq` + `Shape` deleted was LOUD (`emitProgram: struct array
// elements are not supported`), and the row used that to argue the defect needed the arm. The
// grid says otherwise: the same rung is missing in both states, and only WHICH FAILURE the
// cell reaches differs — the i32 list refuses a struct element loudly and swallows a variant
// one. Both cells move on the same one-predicate change, which is what makes the control a
// symptom rather than an axis.
//
// The un-annotated cell is the same body with no return annotation; the call-element cell is
// `arrLitIsRef`'s other blind first-element shape.
// @run
// @log 7
// @log 7
// @log 7
// @hint redundant type annotation
type Circle = { r: i32 }

function mkC(n: i32): Circle { { r: n } }

function plainAnn(n: i32): Circle[] {
  const c: Circle = { r: n }
  const o = [c]
  return o
}

function plainNoAnn(n: i32) {
  const c: Circle = { r: n }
  const o = [c]
  return o
}

function plainCall(n: i32): Circle[] {
  const o = [mkC(n)]
  return o
}

print(plainAnn(7)[0].r)
print(plainNoAnn(7)[0].r)
print(plainCall(7)[0].r)
