// @run
// @log 3
// @log i,s:q,f,s:z,
// @log 2
// A union spelled through a nested layer, `(i32 | string) | f64`, is the flat `i32 | string |
// f64`. A record whose list field holds the nested spelling is handed where the flat one is
// declared: the two records' rows store one element and share one heap type (D15952).
type IS = i32 | string
type U = IS | f64
type W = i32 | string | f64
type R1 = { u: U[] }
type R2 = { u: W[] }
function count(r: R2): i32 { r.u.length }
const r1: R1 = { u: [1, "q", 2.5] }
print(count(r1))
function show(x: W): string {
  if x is i32 { return "i" }
  if x is string { return "s:" + x }
  "f"
}
const r2: R2 = r1
r2.u.push("z")
let s = ""
for x in r1.u { s = s + show(x) + "," }
print(s)

// A literal-union alias as the nested layer.
type K = "a" | "b"
type KU = K | i32
type KW = "a" | "b" | i32
function kcount(r: { u: KW[] }): i32 { r.u.length }
const k1: { u: KU[] } = { u: ["a", 3] }
print(kcount(k1))
