// @run
// @log 0.5
// @log 4500000000
// @log 0.25
// @log 2250000000
// @log 4500000000
// @log 0.5
// @log 5
// @log 1
// @log 9000000000
// @log 7
// @log 9000000000
// @log 2.5
// @log 1
// @log s
// @log 1
// @log 9000000000
// A literal union whose integer members span two widths is delivered into `f64`, where every
// member is a constant `f64` holds exactly, and its `??` join with an `i32` default is delivered
// into `i64` and `f64` (D3523, D3516). Each converts at the member the box holds. A box of a
// literal and a string widens its integer member into `i64 | string` as `i32 | string` does,
// and the two-width box into `i64 | null` retags its `i32` member.
type D = 9000000000 | 1
type E = 9000000000 | 1 | null
type R = { v: f64 }
function pick(n: i32): D {
  if n > 0 { return 9000000000 }
  1
}
function half(a: D) {
  const v: f64 = a
  v / 2
}
function quarter(a: f64) { a / 4 }
function orFive(x: E): i64 { x ?? 5 }
function orFiveF(x: E): f64 { x ?? 5 }
function joined(k: i32): D | i32 {
  if k == 0 { return pick(1) }
  7
}
function mixed(k: i32): 1 | "s" {
  if k == 0 { return 1 }
  "s"
}
print(half(1))
print(half(9000000000))
print(quarter(pick(0)))
print(quarter(pick(1)))
const r: R = { v: pick(1) }
print(r.v / 2)
const xs: f64[] = [pick(0)]
print(xs[0] / 2)
print(orFive(null))
print(orFive(1))
print(orFive(9000000000))
const j: i64 = joined(1)
print(j)
const k: i64 = joined(0)
print(k)
print(orFiveF(null) / 2)
const w: i64 | string = mixed(0)
print(w)
const s: i64 | string = mixed(1)
print(s)
const zn: i64 | null = pick(0)
print(zn)
const zw: i64 | null = pick(1)
print(zw)
