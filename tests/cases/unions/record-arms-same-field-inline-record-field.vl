// @run
// @log B
// @log A
// @log D
// @log C
// @log C
// Inline record literals delivered into arms that share a field name, where that field is a
// record in one arm and a scalar in the other (D4056): the literal is built as the arm whose
// field its own value fits, a record value never as a scalar arm.
type A = { v: i32 }
type B = { v: { x: i32 } }
type C = { v: i32 | string }
type D = { v: { x: string } }
function f(u: A | B) {
  if u is A { return "A" }
  "B"
}
function g(u: C | D) {
  if u is C { return "C" }
  "D"
}
print(f({ v: { x: 1 } }))
print(f({ v: 1 }))
print(g({ v: { x: "s" } }))
print(g({ v: "s" }))
print(g({ v: 3 }))
