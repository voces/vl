// @run
// @log 7
// @log w
// @log 1.5
// @log -1
// @log 8
// @log 3
// A `??` whose operand the checker narrowed to non-null is its operand: the rewrite folds it on
// the read's type, under `!= null`, `== null` else arms, guards, captures and loops (D14535).
function pick(c: boolean): i32 | null {
  if c { return 7 }
  null
}
const x = pick(true)
if x != null { print(x ?? 0) }
let s: string | null = null
if pick(false) == null { s = "w" }
if s != null { print(s ?? "d") }
function f(y: f64 | null) {
  if y == null { return -1.0 }
  y ?? 2.0
}
print(f(1.5))
print(f(null))
function cap(z: i32 | null) {
  if z == null { return 0 }
  const k = () => z ?? 5
  k() + 1
}
print(cap(7))
function loop(w: i32 | null) {
  let n = 0
  if w != null {
    let i = 0
    while i < 3 {
      n = n + (w ?? 100) - w + 1
      i = i + 1
    }
  }
  n
}
print(loop(4))
