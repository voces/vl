// @run
// @log x
// @log y
// @log y
// @log x
// @log 1.5
// @log y
// @log y
// @log x
// @log 2
// @log y
// @log y
// @log not f64
// @log 0.25
// @log y
// @log 0.5
// D4902: a list of string-literal-union atoms delivered into a union beside a numeric list
// arm is built as the atom list, not widened to the numeric arm, at every delivery position.
type K = "x" | "y"
type S = { v: f64[] | K[] }

const m: f64[] | K[] = ["x"]
if m is K[] { print(m[0]) } else { print("m-miss") }

function ret(): f64[] | K[] { return ["y"] }
const r = ret()
if r is K[] { print(r[0]) } else { print("r-miss") }

function arg(a: f64[] | K[]) {
  if a is K[] { print(a[0]) } else { print(a[0]) }
}
arg(["y"])
arg(["x"])
arg([1.5])

const s: S = { v: ["y"] }
const sv = s.v
if sv is K[] { print(sv[0]) } else { print("s-miss") }

function main() {
  let a: f64[] | K[] = [2.5]
  a = ["x", "y"]
  if a is K[] { print(a[1]) } else { print("a-miss") }
  const rev: K[] | f64[] = ["x"]
  if rev is K[] { print(rev[0]) } else { print("rev-miss") }
  const n: f64[] | (K | null)[] = ["x", null]
  if n is (K | null)[] { print(n.length) } else { print("n-miss") }
  const w: i64[] | K[] = ["y"]
  if w is K[] { print(w[0]) } else { print("w-miss") }
  const k: K[] = ["x", "y"]
  const via: f64[] | K[] = k
  if via is K[] { print(via[1]) } else { print("via-miss") }
  let d: f64[] | K[] = ["x"]
  if d is f64[] { print("wrong") } else { print("not f64") }
  d = [0.25]
  if d is f64[] { print(d[0]) } else { print("d-miss") }
  const nl: f64[] | K[] | null = ["y"]
  if nl is K[] { print(nl[0]) } else { print("nl-miss") }
  const h: f64[] | K[] = [1, 2]
  if h is f64[] { print(h[1] / 4) } else { print("h-miss") }
}
main()
