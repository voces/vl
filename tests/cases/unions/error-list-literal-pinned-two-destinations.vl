// @emit-error TWO declared destinations
// THE ARM PIN MUST NOT COMMIT A LIST LITERAL'S ELEMENT ROW WHILE A SECOND DESTINATION
// OF THE OTHER ELEMENT KIND IS STANDING BESIDE IT (D501).
//
// This is D411's class — one un-annotated list literal, two declared destinations whose
// elements are stored differently — and D411's landing does not see it, because
// `letRefListDestSlot` is never CONSULTED here. A `tErr`-channel probe reads all three of
// its callers entered (`letRefListSlot`, `letListBuildKind`, `letListBuildSlot`) and NONE
// of them reaching it: by the time the emitter classifies `lv1` the binding already has an
// annotation, so all three take their `letAnn*` early return.
//
// The pass that wrote it is the ARM PIN (`dstPinAnnIn`, D81/D139/D155). Its safety property
// is "every destination must agree", and a map-value destination whose value spelling names
// no arm was SKIPPED rather than recorded as a disagreement — `dstPinMapValue` pushes only
// when the spelling names one. So the `Shape[]` map never disagreed, `Circle[]` stood alone,
// and the pin aimed the literal at the plain struct row. In the bytes: the literal built
// `struct.new $Circle / array.new_fixed / struct.new` with NO union-box wrap, and the
// `array.set` into the map's `Shape[]` value cell was `expected (ref null $box-list), found
// (ref $struct-list)` — check-clean, and the engine refused the module.
//
// The gate is D411's own predicate asked one pass earlier: a pin over a NON-EMPTY list
// literal is declined when the same binding has both a kind-2 and a kind-1 declared
// destination, which is exactly when `letRefListDestSlot` will refuse it out loud. It
// cannot reach an object-literal pin at all — `letRefListDestSlotK` answers -1 for any
// initializer that is not an `ArrayLit`.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function f() {
  const lv1 = [{ r: 7 }]
  const mU: {[string]: Shape[]} = Map()
  mU["k"] = lv1
  const cS: Circle[] = lv1
  const gU = mU["k"] ?? []
  if gU.length > 0 { print(gU.length) } else { print(0) }
  if cS.length > 0 { print(cS[0].r) } else { print(0) }
}
f()
