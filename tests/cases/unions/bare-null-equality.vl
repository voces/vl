// D1018 — `print(null == null)` was `vl check` rc 0 then `bare null needs a struct-typed
// context`.
//
// Each operand reached `emitNullLitNode`, which can only emit `ref.null <heaptype>` and needs
// a struct-typed context to pick one. With no `T` anywhere in the program there is none. But
// both sides being a bare `null` makes the answer STATIC — no rep is needed at all — so the
// equality emitter now answers it before either operand is lowered.
//
// Distinct from D20's family, which HAS a `T | null` and is asking about that niche; the
// `string | null` cells below are that shape and always ran. Here there is no `T` at all.
const s: string | null = null

const t: string | null = "x"

print(null == null)

print(null != null)

print(s == null)

print(t == null)
