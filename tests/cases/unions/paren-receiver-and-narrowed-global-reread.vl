// @run
// @log true
// @log true
// @log true
// @log 1
// @log true
// @log true
// @log false
// @log false
// @log 5
// @log 5
// @log true
// @log false
// @log true
// @log 9
// @hint redundant type annotation: `gl` is inferred as `i32[]`
// @hint redundant type annotation: `boxCmp` is inferred as `boolean`
// @hint redundant type annotation: `boxNested` is inferred as `boolean`
// @hint redundant type annotation: `boxCall` is inferred as `boolean`
// @hint redundant type annotation: `unionBox` is inferred as `boolean`
// @hint redundant type annotation: `nullLeg` is inferred as `boolean`
// @hint redundant type annotation: `isTest` is inferred as `boolean`
// @hint redundant type annotation: `coal` is inferred as `i32`
// @hint redundant type annotation: `idx` is inferred as `i32`
// @hint redundant type annotation: `globalLeft` is inferred as `boolean`
// @hint redundant type annotation: `globalRight` is inferred as `boolean`
// @hint redundant type annotation: `globalPlain` is inferred as `boolean`
// A field read whose receiver is parenthesized is read again where its consumer re-reads it (a
// union compare's box or operand, an `is` test, a `??`, an index), as the unparenthesized one is;
// a parenthesized call receiver is not. A global narrowed to a smaller union is read again by
// its compare, also beside a call that reassigns it.
type C = { r: f64 | null }
type U = { u: i32 | string, q: i32 | null, k: string | null }
const lv1: C[] = [{ r: 7 }]
const ls: U[] = [{ u: "a", q: null, k: "a" }]
const gl: i32[] = [4, 5]
let calls = 0
function mk(): C {
  calls = calls + 1
  return { r: 7 }
}
function boxCmp(): boolean { return (lv1[0]).r == 7 }
function boxNested(): boolean { return ((lv1[0])).r == 7 }
function boxCall(): boolean { return (mk()).r == 7 }
function unionBox(): boolean { return (ls[0]).u == "a" }
function nullLeg(v: i32 | string | null): boolean { return v == (ls[0]).k }
function isTest(): boolean { return (ls[0]).u is i32 }
function coal(): i32 { return (ls[0]).q ?? 5 }
function idx(): i32 { return (gl)[1] }
let g: "a" | i32 | null = "a"
function bump(): "a" | i32 {
  g = 9
  return 9
}
function globalLeft(): boolean {
  if g != null { return g == bump() }
  return false
}
function globalRight(): boolean { return bump() == g }
function globalPlain(): boolean {
  if g != null { return g == "a" }
  return false
}
print(boxCmp())
print(boxNested())
print(boxCall())
print(calls)
print(unionBox())
print(nullLeg("a"))
print(nullLeg(3))
print(isTest())
print(coal())
print(idx())
print(globalPlain())
print(globalLeft())
g = "a"
print(globalRight())
print(g ?? -1)
