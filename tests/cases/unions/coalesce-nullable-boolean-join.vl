// @run
// @log true
// @log true
// @log 5
// @log d
// @log true
// @log false
// @log false
// @log 7
// @log 0
// @log true
// @log true
// @log true

// D2383 — a `??` over a `boolean | null` with a default of another type joins to the union
// box: the default under its own arm, a present boolean under the boolean arm. The operand
// is evaluated once and the default only when the operand is null.

type A = { r: i32 }
function mkA(): A | null { return { r: 1 } }
function none(): boolean | null { return null }
function no(): boolean | null { return false }

function binding() {
  const x = none() ?? mkA()
  print(x is A)
  const i = none() ?? 5
  print(i is i32)
  if i is i32 { print(i) }
  const s = none() ?? "d"
  if s is string { print(s) }
}
binding()

function present() {
  const b = no()
  const x = b ?? mkA()
  print(x is boolean)
  if x is boolean { print(x) }
}
present()

let calls = 0
function st(): A {
  calls = calls + 1
  return { r: 7 }
}
function once() {
  const x = no() ?? st()
  print(x is A)
  const y = none() ?? st()
  if y is A { print(y.r) }
  print(calls - 1)
}
once()

function show(v: boolean | A | null) { print(v is A) }
show(none() ?? mkA())
function pick() { return none() ?? mkA() }
print(pick() is A)
const g = none() ?? mkA()
print(g is A)
