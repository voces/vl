// @run
// @log 7
// @log true
// @log false
// @log 0
// @log 0
// @log true
// A `boolean | null` `??` joining a record inside a value `if` arm: the join `boolean | A`
// names no declaration, so its row is minted from the checker's type, and the arm lowers as
// the box the `if` is rather than the niche's `i32` (D2417).

type A = { r: i32 }
function st(): A { return { r: 7 } }
function mkB(): boolean | null { return null }
function mkT(): boolean | null { return true }

function go(c: boolean) {
  const x = if c { mkB() ?? st() } else { null }
  if x is A { print(x.r) } else { print(0) }
  const y = if c { mkT() ?? st() } else { null }
  if y is boolean { print(y) } else { print(0) }
  const z = if c { mkB() ?? st() } else { null }
  print(z == null)
}
go(true)
go(false)
