// @run
// @log 3
// @log 3
// @log 4
// @log 4
// @log 5
// A union holding a union alias as one member keys the row of its flat member set, so a module
// binding, a local and a delivered value narrow through it as the spelled-out union does (D14551).
type Circle = { kind: "circle", r: f64 }
type Rect = { kind: "rect", w: f64 }
type ParseError = { why: string }
type Shape = Circle | Rect

const x: Shape | ParseError = { kind: "rect", w: 3.0 }
if x is Rect { print(x.w) } else { print("no") }
const y: Circle | Rect | ParseError = { kind: "rect", w: 3.0 }
if y is Rect { print(y.w) } else { print("no") }

function nested() {
  const a: Shape | ParseError = { kind: "rect", w: 4.0 }
  if a is Rect { return a.w }
  0.0
}
function flat() {
  const a: Circle | Rect | ParseError = { kind: "rect", w: 4.0 }
  if a is Rect { return a.w }
  0.0
}
print(nested())
print(flat())

const r: Rect = { kind: "rect", w: 5.0 }
const d: Shape | ParseError = r
if d is Rect { print(d.w) } else { print("no") }
