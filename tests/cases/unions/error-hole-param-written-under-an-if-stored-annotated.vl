// @emit-error internal: an emit-phase write changed a type an emit memo may hold
// The same conditional write's result stored into an annotated `i32 | null` is refused, never
// stored as `null` (D17850).
function f(a) {
  let t = null
  if a > 5 { t = a }
  return t
}
const x: i32 | null = f(9)
print(x)
