// @warning This branch is never taken: its condition is always `false`
// An else-less value `if` whose condition is a constant (a literal, a folded comparison, a decided
// `is`) is the join of its then arm and the join's null, at a string, boolean, integer, record
// and list join: bound, printed, an argument, returned, and in a function.
type P = { x: i32 }
function show(s: string | null) { print(s ?? "none") }
function ret(): string | null { return if false { "r" } }
const s1 = if true { "a" }
print(s1 ?? "none")
const s2 = if false { "b" }
print(s2 ?? "none")
print(if 1 > 0 { "c" })
show(if false { "d" })
print(ret() ?? "none")
const b1 = if true { true }
print(b1 ?? false)
const n1 = if false { 3 }
print(n1 ?? -1)
const p1 = if true { { x: 4 } }
print(p1 != null)
const l1 = if false { [5] }
print(l1 == null)
const v = 7
const d1 = if v is i32 { "is" }
print(d1 ?? "none")
function inner() {
  const t = if true { "e" }
  print(t ?? "none")
  print(if false { 8 } ?? 9)
}
inner()
