// @run
// @log true
// @log b
// @log null
// @log 1
// @log null
// @log 7
// @log b
// @log null
// @log zz
// @log a
// @log none
// D15882, D16031: a shared field read through an un-narrowed union of records, where the field
// is a literal set beside `null` in one member, in either member order, and its neighbours.
type K = "a" | "b"
type R = { k: K | null, s: string }
type S = { k: K | null, s: string, extra: i32 }
const n: R = { k: null, s: "lo" }
const u: R | S = n
print(u.k == null)
function rk(v: S | R) {
  const y = v.k
  if y == null { print("null") } else { print(y) }
}
rk({ k: "b", s: "x" })
rk({ k: null, s: "x", extra: 1 })

type P = { x: 1 | null }
type Q = { x: i32 | null }
function f(v: P | Q) {
  const y = v.x
  if y == null { print("null") } else { print(y) }
}
const p1: P = { x: 1 }
f(p1)
const p0: P = { x: null }
f(p0)
const pq: P | Q = p0
print(pq.x ?? 7)

type W = { w: K | null }
type Z = { w: string | null, z: i32 }
function g(v: W | Z) {
  const y = v.w
  if y == null { print("null") } else { print(y) }
}
g({ w: "b" })
g({ w: null })
g({ w: "zz", z: 1 })

type A1 = { w: K }
function h(v: A1 | Z) { v.w ?? "none" }
print(h({ w: "a" }))
print(h({ w: null, z: 2 }))
