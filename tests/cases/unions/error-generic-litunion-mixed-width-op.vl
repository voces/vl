// @check
// @error argument 1: unary '-' expects a numeric type, got U (the body of `op` negates this argument)
// @error argument 1: operator '*' is not defined for U and i32 (the body of `twice` applies '*' to this argument)
// A generic body's operator over a two-width literal union is refused at the pin: the direct
// spelling computes at `i64`, which is no `T`, so the pin does not soften the set (D3524).
type U = 1 | 9000000000
function op<T>(x: T) { -x }
function twice<T>(x: T): T { x * 2 }
const u: U = 9000000000
print(op(u))
print(twice(u))
