// @check
// @error return type mismatch: expected U, got i64 (the return of `twice` at the call's argument types)
// A generic body's operator over a two-width literal union computes at `i64`, as the direct
// spelling does, and that is no `T`: an annotated `: T` return refuses it at the pin, while an
// un-annotated one returns the `i64` (D3524, D9523).
type U = 1 | 9000000000
function twice<T>(x: T): T { x * 2 }
const u: U = 9000000000
print(twice(u))
