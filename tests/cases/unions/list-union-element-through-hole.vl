// @run
// @log 4
// @log 2
// @log 7
// @log 2.5
// @log 8
// @log 5
// @log s:x
// @log 7
// An element of a union of lists read through a hole parameter: each pin types it at the element
// union, and its instance reads whichever list arm the box holds and boxes the element.
function mkL(k: i32): i32[][] | f64[][] {
  if k == 0 {
    const b: f64[][] = [[1.5]]
    return b
  }
  const a: i32[][] = [[1, 7], [2]]
  return a
}
function nested(a, i: i32) { print(a[i].length + a.length) }
nested(mkL(1), 0)
nested(mkL(0), 0)
function mkS(k: i32): i32[] | f64[] {
  if k == 0 { return [1.5, 2.5] }
  const a = [4, 7]
  return a
}
function second(a) { print(a[1]) }
second(mkS(1))
second(mkS(0))
second([9, 8])
function mkT(k: i32): string[] | i32[] {
  if k == 0 { return ["x", "y"] }
  const a = [4, 7]
  return a
}
function first(a) {
  const e = a[0]
  if e is string { print("s:" + e) } else { print(e + 1) }
}
first(mkT(1))
first(mkT(0))
function last(a) { print(a[a.length - 1]) }
last(mkS(1))
