// @run
// @log 2
// @log true
// @log 7
// @log -1
// @log 9
// An inline nullable union of arms that differ only in a lone literal keeps its box, at a
// binding, an annotated parameter and a struct field (D5240).
function f(q: { tag: "a", v: i32 } | { tag: "b", v: i32 } | null) {
  if q == null { return 0 - 1 }
  if q.tag == "a" { return q.v }
  0
}
type H = { h: { tag: "a", v: i32 } | { tag: "b", v: i32 } | null }
const q: { tag: "a", v: i32 } | { tag: "b", v: i32 } | null = { tag: "b", v: 2 }
if q != null { print(q.v) }
const z: { tag: "a", v: i32 } | { tag: "b", v: i32 } | null = null
print(z == null)
print(f({ tag: "a", v: 7 }))
print(f(null))
const hh: H = { h: { tag: "b", v: 9 } }
const hv = hh.h
if hv != null { print(hv.v) }
