// @run
// @log 3
// @log 12
// @log 5
// @log iarm
// @log 2.5
// @log 1.5
// @log 0
// @log 41
// @log 9
// The five emitter sites that ask the INLINE-SHAPE grammar (`{…}` that is not a map `{[…]}`)
// through `emit_base.nameIsShapeOpen` / `nameIsShapeSpanEnds`, in one program — the witness
// for D-SHAPEOPEN, which routed each of them off its own hand-written copy of the triple.
//
// Every arm below is an INLINE object shape, never a map, and never a declared name: that is
// exactly the pair of characters the two homes test (`[0] == '{'`, `[1] != '['`) plus the
// closing `}` the SPAN home adds. A map-valued twin rides beside them so a home that dropped
// the `name[1] != '['` conjunct mis-sorts one against the other rather than silently agreeing.
//
//   * `unionStructAliasShape`  — the single-variant struct-alias decl (`A & B` canonicalized)
//   * `isStructAtom`           — an inline shape as a variant-box union member
//   * `collectVariantFields`   — that member's fields parsed from its own text
//   * `collectA`               — a code-5 ref-LIST variant field with an inline-shape element
//   * `funcRetUnrepresentable` — a closure result spelled as an inline shape
type AB = {a: i32} & {b: i32}
type Mixed = {x: i32, y: i32} | i32
type ListArm = {f: {g: f64}[]} | i32
// map-LAST: a map-FIRST alias (`type = {[…`) is a pre-existing PARSER limitation.
type MapTwin = i32 | {[string]: i32}
// The arm that separates the OPEN home from the SPAN home rides below, spelled INLINE in the
// signature (an array-arm ALIAS is a separate pre-existing limitation): `{g: f64}[]` opens with
// `{`, is not a map, and does NOT end in `}` — an inline shape to `nameIsShapeOpen` and NOT one
// to `nameIsShapeSpanEnds`. A span home that dropped its closing-`}` conjunct mis-sorts this
// array arm as a bare struct atom.

function mkAB(): AB { return { a: 1, b: 2 } }
function sumAB(v: AB): i32 { return v.a + v.b }

function armOf(v: Mixed): i32 {
  if (v is {x: i32, y: i32}) { return v.x + v.y }
  if v is i32 { return v }
  return 0
}
function tagOf(v: Mixed): string {
  if v is i32 { return "iarm" }
  return "sarm"
}

function firstG(v: ListArm): f64 {
  if (v is {f: {g: f64}[]}) { return v.f[0].g }
  return 0.0
}

function mapArm(v: MapTwin): i32 {
  if v is i32 { return v }
  return v["k"] ?? -1
}
function firstOfArr(v: {g: f64}[] | f64): f64 {
  if v is {g: f64}[] { return v[0].g }
  return 0.0
}

function mkMap(): MapTwin {
  const h: {[string]: i32} = Map()
  h["k"] = 41
  return h
}

// A closure whose RESULT is an inline shape — the `funcRetUnrepresentable` path decides
// whether this sig is interned at all.
function shapeMaker(): () => {p: i32} { return () => { p: 9 } }

print(sumAB(mkAB()))
print(armOf({ x: 5, y: 7 }))
print(armOf(5))
print(tagOf(3))
const lv: ListArm = { f: [{ g: 2.5 }] }
print(firstG(lv))
const av: {g: f64}[] | f64 = [{ g: 1.5 }, { g: 3.5 }]
print(firstOfArr(av))
const asc: {g: f64}[] | f64 = 0.0
print(firstOfArr(asc))
print(mapArm(mkMap()))
const mk = shapeMaker()
print(mk().p)
