// @run
// @log 4
// @log 3
// @log 5
// @log 3
// @log 6
// @log 3
// @log 8
// @log 9
// @log 10
// @log 12
// @log 12
// @log 13
// @log 14
// @log 2.5
// @log 15
// @log q
// @log 17
// @log 1
// @log 2
// @log 3
// @log 21
// @log 22
// @log 20
// An inferred return set of a record list and a scalar list, which no annotation names, delivered
// into an anonymous object's field (D2891): read back under `is`, as an element, in a `for`, and
// through a return, a list, an argument, a nested record, an assignment and a capture.
type P = { x: i32 }
type Q = { y: string }
function w(t: P, b: boolean) {
  if b { return [t] }
  [1, 2, 3]
}
function wf(t: P, b: boolean) {
  if b { return [t] }
  [1.5, 2.5]
}
function ws(t: P, b: boolean) {
  if b { return [t] }
  ["s"]
}
function wq(t: P, q: Q, b: boolean) {
  if b { return [t] }
  [q]
}

const o = { f: w({ x: 4 }, true) }
if o.f is P[] { print(o.f[0].x) } else { print("N") }
const o1 = { f: w({ x: 4 }, false) }
if o1.f is P[] { print(o1.f[0].x) } else { print(o1.f.length) }

function mk(b: boolean) { { f: w({ x: 5 }, b), n: 1 } }
const m1 = mk(true)
if m1.f is P[] { print(m1.f[0].x) } else { print("N") }
const m2 = mk(false)
if m2.f is i32[] { print(m2.f[2]) } else { print("N") }

const xs = [{ f: w({ x: 6 }, true) }, { f: w({ x: 7 }, false) }]
for x in xs {
  if x.f is P[] { print(x.f[0].x) } else { print(x.f.length) }
}

function show(r: { f: P[] | i32[] }) {
  if r.f is P[] { print(r.f[0].x) } else { print(r.f.length) }
}
show({ f: w({ x: 8 }, true) })
const o2 = { f: w({ x: 9 }, true) }
show(o2)

const n = { g: { f: w({ x: 10 }, true) } }
if n.g.f is P[] { print(n.g.f[0].x) } else { print("N") }

const a = { f: w({ x: 11 }, false) }
a.f = w({ x: 12 }, true)
if a.f is P[] { print(a.f[0].x) } else { print("N") }
const c = () => {
  if a.f is P[] { print(a.f[0].x) }
}
c()

const e = { f: w({ x: 13 }, true) }
const e0 = e.f[0]
if e0 is P { print(e0.x) } else { print(e0) }

const fo = { f: wf({ x: 14 }, true) }
if fo.f is P[] { print(fo.f[0].x) } else { print("N") }
const fz = { f: wf({ x: 14 }, false) }
if fz.f is f64[] { print(fz.f[1]) } else { print("N") }

const so = { f: ws({ x: 15 }, true), k: "k" }
if so.f is P[] { print(so.f[0].x) }

const qo = { f: wq({ x: 16 }, { y: "q" }, false) }
if qo.f is Q[] { print(qo.f[0].y) } else { print("N") }

const it = { f: w({ x: 17 }, true) }
for v in it.f {
  if v is P { print(v.x) } else { print(v) }
}
const it2 = { f: w({ x: 18 }, false) }
for v in it2.f {
  if v is P { print(v.x) } else { print(v) }
}

const jv = if xs.length > 1 { [{ x: 21 }] } else { [1, 2] }
const jo = { f: jv }
if jo.f is P[] { print(jo.f[0].x) } else { print("N") }

const bv = w({ x: 22 }, true)
const bo = { f: bv, n: 2 }
if bo.f is P[] { print(bo.f[0].x) } else { print("N") }

function g(t: P) { return { f: w(t, true) } }
const go = g({ x: 20 })
if go.f is P[] { print(go.f[0].x) } else { print("N") }
