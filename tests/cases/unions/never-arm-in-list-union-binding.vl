// @run
// @log 0
// @log 1
// @hint Intentionally-unused variable `_lu` (leading `_` marks it unused)
// @hint redundant type annotation: `_lu` is inferred as `string[] | i32[]` — remove it to lean on inference
// @hint redundant type annotation: `lu` is inferred as `string[] | i32[]` — remove it to lean on inference
// D10230: a function-local binding typed as a union of lists, initialised by an `if` whose other
// arm never returns, builds and runs the live arm. The binding annotations are the witness's.
const a = ["x"]
const ws: string[] | i32[] = a
function f(c: boolean) {
  const _lu: string[] | i32[] = if c { ws } else { __trap__() }
  0
}
function g(c: boolean) {
  const lu: string[] | i32[] = if c { ws } else { __trap__() }
  if lu is string[] { return lu.length }
  -1
}
print(f(true))
print(g(true))
