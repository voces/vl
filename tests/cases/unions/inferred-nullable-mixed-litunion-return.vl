// @run
// @log false true
// @log 30
// @log a
// @log null
// @log 30
// @log a
// @log null
// @log num lit nul
// @log num lit nul
// @log false true
// @log false true
// @log 31
// @log 7
// @log 2 0 9000000000
// @log two one nul
// D5922: an inferred return of a nullable union beside a literal (`"a" | i32 | null`) boxes as
// its annotation does, delivered from an annotated callee; a nullable numeric literal union
// boxes as its base made nullable (D2568).
function pick(n: i32): "a" | i32 | null {
  if n > 1 { return n * 10 }
  if n < 0 { return null }
  "a"
}
function get(n: i32) { return pick(n) }
function pickF(n: i32): "a" | f64 | null {
  if n > 1 { return 1.5 }
  if n < 0 { return null }
  "a"
}
function getF(n: i32) { return pickF(n) }
function pickN(n: i32): 1 | string | null {
  if n > 1 { return "s" }
  if n < 0 { return null }
  1
}
function getN(n: i32) { return pickN(n) }
function show(v: "a" | i32 | null) {
  if v == null { return "nul" }
  if v == "a" { return "lit" }
  "num"
}
function shown(n: i32) {
  match get(n) {
    "a" => "lit"
    i32 => "num"
    null => "nul"
  }
}
const lit = "a"
const v = get(3)
const w = get(0)
if v != null && w != null { print("\{v == lit} \{w == lit}") }
print(get(3))
print(get(0))
print(get(-1))
const lam = (n: i32) => pick(n)
print(lam(3))
print(lam(0))
print(lam(-1))
print("\{show(get(3))} \{show(get(0))} \{show(get(-1))}")
print("\{shown(3)} \{shown(0)} \{shown(-1)}")
const f1 = getF(3)
const f2 = getF(0)
if f1 != null && f2 != null { print("\{f1 == lit} \{f2 == lit}") }
const n1 = getN(3)
const n2 = getN(0)
if n1 != null && n2 != null { print("\{n1 == 1} \{n2 == 1}") }
let s = 0
if v is i32 { s = v + 1 }
print(s)
print(get(-1) ?? 7)
type LN = 1 | 2
function pickL(n: i32): LN | null {
  if n > 1 { return 2 }
  if n > 0 { return 1 }
  null
}
function getL(n: i32) { return pickL(n) }
function pickW(n: i32): 9000000000 | 1 | null {
  if n > 0 { return 9000000000 }
  null
}
function getW(n: i32) { return pickW(n) }
function namedL(n: i32) {
  match getL(n) {
    1 => "one"
    2 => "two"
    null => "nul"
  }
}
print("\{getL(2) ?? 0} \{getL(0) ?? 0} \{getW(1) ?? 0}")
print("\{namedL(2)} \{namedL(1)} \{namedL(0)}")
