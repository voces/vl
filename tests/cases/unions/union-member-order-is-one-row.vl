// @run
// @log 8
// @log 7
// A union is a SET: the members in either order are one type and one registry row (owner
// ruling, D1712).
//
// The `??` join builds its result from the OPERAND first, so `i32 | null` with an `A` default
// joins to `i32 | A` — and this program declares `A | i32`. Keying the row on the member
// SEQUENCE made those two rows, the name came back "", and the arm fell to the scalar tail
// with the operand's `i32` block type: check-clean invalid wasm.
//
// Only this order is here. Declaring the mirror `type MB = i32 | A` beside it registers the
// join's own sequence and masks the defect, so a fixture carrying both orders runs at both
// seeds and sees nothing.

type A = { r: i32 }
type M = A | i32

function mkN(): i32 | null { return null }
function mkI(): i32 | null { return 7 }
function st(): A { return { r: 8 } }

const w: M = mkN() ?? st()
if w is A { print(w.r) } else { print(0) }

// The scalar arm of the same row, so both tags are read off the row that answers.
const i: M = mkI() ?? st()
if i is A { print(i.r) } else { print(i) }
