// @run
// @log BOTH-annot 1
// @log BOTH-infer 1
// @log WHILE-annot 1
// @log WHILE-infer 1
// @log DIVERGE 1
// @log THREE-both 1
// @log THREE-one true
// @log SAME-LEVEL 1
// @log ONE-ARM refused-by-hoisting
// @hint redundant type annotation: `y` is inferred as `i32 | string` — remove it to lean on inference
// THE ARMS OF AN `if` JOIN THE NARROWING COLUMN, which is what `daJoinArms` already does for
// definite assignment, one table over (D1846). A write inside a nested block retires the
// narrowing, and what the code BELOW the `if` reads at is the join of what its surviving arms
// left the name at — not the declaration.
//
// EVERY ROW DEMANDS THE MEMBER. `print(x)` after the join runs whether the join happened or the
// name simply widened back to its declaration, because the union box renders the same text; so
// each row uses a read the declaration cannot serve — `if x` needs a raw boolean, `x.length` a
// raw string, and the three-member row needs a destination the third arm would not fit.
//
// WHAT THE JOIN DOES NOT BUY is the one-armed shape, and that is the row this file's own
// inventory entry was first filed on: with only one arm writing, the other path still holds the
// entry narrowing, so the sound join IS `i64 | boolean` and `if x` is refused — correctly, and
// with or without this change. The last row pins that.
import { toString } from "std:fmt"

function pick(b: boolean): i64 | boolean {
  if b { return 3 }
  return false
}

// Both arms write the same member: the join is that member.
function bothAnnot(c: boolean) {
  let x: i64 | boolean = 3
  let r = 0
  if x is i64 {
    if c { x = true } else { x = false }
    if x { r = 1 } else { r = 2 }
  }
  return r
}
print("BOTH-annot " + toString(bothAnnot(true)))

function bothInfer(c: boolean) {
  let x = pick(true)
  let r = 0
  if x is i64 {
    if c { x = true } else { x = false }
    if x { r = 1 } else { r = 2 }
  }
  return r
}
print("BOTH-infer " + toString(bothInfer(true)))

// The same join under a `while` head, whose body is a narrowing scope since D1736.
function whileAnnot(c: boolean) {
  let x: i64 | boolean = 3
  let r = 0
  while x is i64 {
    if c { x = true } else { x = false }
    if x { r = 1 } else { r = 2 }
  }
  return r
}
print("WHILE-annot " + toString(whileAnnot(true)))

function whileInfer(c: boolean) {
  let x = pick(true)
  let r = 0
  while x is i64 {
    if c { x = true } else { x = false }
    if x { r = 1 } else { r = 2 }
  }
  return r
}
print("WHILE-infer " + toString(whileInfer(true)))

// An arm that DIVERGES contributes no path, so the surviving arm's own end type stands.
function diverge(c: boolean) {
  let x: i64 | boolean = 3
  let r = 0
  if x is i64 {
    if c { x = true } else { return 0 }
    if x { r = 1 } else { r = 2 }
  }
  return r
}
print("DIVERGE " + toString(diverge(true)))

// A THREE-member union: both arms write `string`, so the join is `string` and not the
// declaration — `.length` needs the raw string.
function threeBoth(c: boolean) {
  let x: i32 | string | boolean = 3
  let r = 0
  if x is i32 {
    if c { x = "s" } else { x = "t" }
    r = x.length
  }
  return r
}
print("THREE-both " + toString(threeBoth(true)))

// …and with only ONE arm writing, the join is a PROPER SUBSET of the declaration: the other
// path still holds `i32`, so `x` is `i32 | string` below and the third member is gone. The
// annotation on `y` is kept and its redundancy hint DECLARED: the hint is the sharpest reading
// of the join there is — inference itself names `i32 | string`, not the declaration.
function threeOne(c: boolean) {
  let x: i32 | string | boolean = 3
  let out = false
  if x is i32 {
    if c { x = "s" }
    const y: i32 | string = x
    out = y is string
  }
  return out
}
print("THREE-one " + toString(threeOne(true)))

// The control the join must not disturb: a write at the guard's OWN level needs no join at all.
function sameLevel() {
  let x: i64 | boolean = 3
  let r = 0
  if x is i64 {
    x = true
    if x { r = 1 } else { r = 2 }
  }
  return r
}
print("SAME-LEVEL " + toString(sameLevel()))

// The one-armed shape, which the join computes and the design still refuses: `if x` below would
// read an `i64` whenever `c` was false. Hoisting the read into the arm is the fix, and that is
// what this row prints.
function oneArm(c: boolean) {
  let x: i64 | boolean = 3
  let r = "refused-by-hoisting"
  if x is i64 {
    if c {
      x = true
      if x { r = "refused-by-hoisting" }
    }
  }
  return r
}
print("ONE-ARM " + oneArm(true))
