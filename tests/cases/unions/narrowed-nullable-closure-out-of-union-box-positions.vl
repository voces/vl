// @run
// @log null
// @log null
// @log null
// @log null
// @log null
// @log null
// @log null
// @log true
// @log 5
// @log 5
// @log 5
// @log 5
// @log 5
// @log 5
// @log 5
// @log false
// @log 2
// @log null
// @log str
// @log str
// @log str
// @log str
// @log null
// @log 40
type F = (i32) => i32
type O = { f: F | null | string }
function show(v: F | null) {
  if v == null { print("null") } else { print(v(4)) }
}
function arg(w: F | null | string) {
  if w is string { return }
  show(w)
}
function cst(w: F | null | i32) {
  if w is i32 { return }
  const c = w
  show(c)
}
function lt(w: F | null | string) {
  if w is string { return }
  const l = w
  show(l)
}
function ret(w: F | null | string): F | null {
  if w is string { return null }
  return w
}
let g: F | null | string = "g"
function glob() {
  if g is string { print("str") } else { show(g) }
}
function field(o: O) {
  if o.f is string {
    print("str")
  } else {
    const c = o.f
    show(c)
  }
}
function capt(w: F | null | string) {
  const f = () => {
    if w is string { print("str") } else { show(w) }
  }
  f()
}
function inplace(w: F | null | string) {
  if w is string {
    print("str")
  } else {
    print(w == null)
    if w != null { print(w(1)) }
  }
}
function walk(fs: (F | null)[]) {
  for f in fs { arg(f) }
}
function all(w: F | null | string) {
  arg(w)
  if !(w is string) { cst(w) }
  lt(w)
  show(ret(w))
  g = w
  glob()
  field({ f: w })
  capt(w)
  inplace(w)
}
all(null)
all((x: i32) => x + 1)
all("s")
walk([null, (x: i32) => x * 10])
