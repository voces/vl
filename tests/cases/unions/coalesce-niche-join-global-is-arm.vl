// @run
// @log false
// @log false
// @log true
// @log false
// @log true
// @log true
// @log false
// @log true
// @log true
// @log false
// @log 5
// @log false
// @log true
// A module global bound to a `??` joining a nullable string to a nullable record is the union
// box, and `is` over it tests the arm's tag: being non-null is not being the arm (D2267). The
// function `go` is the in-function control.

type A = { r: i32 }
function mkA(): A | null { return null }
function mkA2(): A | null { return { r: 5 } }
function mkS(): string | null { return null }
function mkSq(): string | null { return "q" }
const w = mkS() ?? mkA()
const w2 = mkSq() ?? mkA()
const w3 = mkS() ?? mkA2()
print(w is A)
print(w2 is A)
print(w3 is A)
print(w is string)
print(w2 is string)
print(w is null)
print(w3 is null)
print(w == null)
print(w2 !is A)
print(w3 !is A)
if w3 is A { print(w3.r) }
function go() {
  const v = mkS() ?? mkA()
  const v3 = mkS() ?? mkA2()
  print(v is A)
  print(v3 is A)
}
go()
