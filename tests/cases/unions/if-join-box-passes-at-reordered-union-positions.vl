// @run
// @log 8
// @log 3.5
// @log 8
// @log 3.5
// @log 8
// @log 3.5
// @log 8
// @log 3.5
// @log 8
// @log 3.5
// A valued `if` whose join is a nullable union of numbers spelled in one member order, delivered
// where the same members are held in the other order, passes as that box in every position.
function use(r) {
  if r != null { print(r + 1) }
}
function fi(k: i32, a: f64, b: i32) {
  use(if k == 0 { a } else if k == 1 { b } else { null })
}
function arg(k: i32, a: i32, b: f64) {
  use(if k == 0 { a } else if k == 1 { b } else { null })
}
function ret(k: i32, a: i32, b: f64): f64 | i32 | null {
  return if k == 0 { a } else if k == 1 { b } else { null }
}
function bind(k: i32, a: i32, b: f64) {
  const j: f64 | i32 | null = if k == 0 { a } else if k == 1 { b } else { null }
  use(j)
}
function elem(k: i32, a: i32, b: f64) {
  const xs: (f64 | i32 | null)[] = [
    if k == 0 { a } else if k == 1 { b } else { null },
  ]
  use(xs[0])
}
type H = { h: f64 | i32 | null }
function field(k: i32, a: i32, b: f64) {
  const o: H = { h: if k == 0 { a } else if k == 1 { b } else { null } }
  use(o.h)
}
fi(2, 2.5, 7)
arg(0, 7, 2.5)
arg(1, 7, 2.5)
use(ret(0, 7, 2.5))
use(ret(1, 7, 2.5))
bind(0, 7, 2.5)
bind(1, 7, 2.5)
elem(0, 7, 2.5)
elem(1, 7, 2.5)
field(0, 7, 2.5)
field(1, 7, 2.5)
