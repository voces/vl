// @run
// @log a
// @log 7
// @log a
// @log 4
// @log x
// @log 3
// @log a
// @log a
// @log a
// @log a
// A binding typed by a union that nests another (`K | (L | i32)`) is the box of its flattened
// members at a module global and at a local, as the flat spelling is (D7042).
type K = "a" | "b"
type L = "x" | "y"
const a: K | (L | i32) = "a"
print(a)
const b: K | (L | i32) = 7
print(b)
const c: (L | i32) | K = "a"
print(c)
let d: K | (L | i32) = "b"
d = 4
print(d)
function f() {
  let e: K | (L | i32) = "x"
  print(e)
  e = 3
  print(e)
}
f()
function r1<T>(x: T): { v: T | K } { return { v: x } }
function r2<T>(x: T): { v: T } { return { v: x } }
function r3<T>(x: T): T | K { return x }
const s: { v: K | L | i32 } = { v: a }
print(r1(a).v)
print(r2(a).v)
print(r3(a))
print(s.v)
