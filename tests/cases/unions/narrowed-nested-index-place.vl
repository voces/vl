// @run
// @log 8
// @log 8
// @log 8
// @log 10
// @log null
// @log null
// @hint redundant type annotation: `xs` is inferred as `M[]` — remove it to lean on inference
// @hint redundant type annotation: `nys` is inferred as `(i32 | null)[][]` — remove it to lean on inference
// @hint redundant type annotation: `wys` is inferred as `(i32 | null)[][]` — remove it to lean on inference
// @hint redundant type annotation: `rys` is inferred as `(i32 | null)[][]` — remove it to lean on inference
// A NESTED index place (`ys[0][0]`), narrowed and read at that place. The emitter's keyer
// took an `Ident` or a `Member` receiver only, so one subscript level keyed and two keyed
// "" — the checker narrowed and the emitter had no arm narrowed (D1722).
//
// The last two rows are the half the keyer alone gets wrong: a write to a PREFIX of a live
// key must retire it. Without the prefix retire the fifth row TRAPS with `cast failure`,
// because the narrowing outlives the write that falsified it.
type A = { r: i32 }
type M = i32 | A
function st(): A { return { r: 8 } }
function pick(b: boolean): M {
  if b { return st() }
  return 7
}
const xs: M[] = [pick(true)]
if xs[0] is A { print(xs[0].r) } else { print(0) }
const ys = [xs]
if ys[0][0] is A { print(ys[0][0].r) } else { print(0) }
const zs = [ys]
if zs[0][0][0] is A { print(zs[0][0][0].r) } else { print(0) }
const ns: (i32 | null)[] = [5]
const nys: (i32 | null)[][] = [ns]
if nys[0][0] != null { print(nys[0][0] * 2) } else { print(0) }
const wys: (i32 | null)[][] = [ns]
if wys[0][0] != null {
  wys[0] = [null]
  print(wys[0][0])
} else {
  print(0)
}
let rys: (i32 | null)[][] = [ns]
if rys[0][0] != null {
  rys = [[null]]
  print(rys[0][0])
} else {
  print(0)
}
