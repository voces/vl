// @run
// @log 3
// An inline-shape union VARIANT whose field list carries a generic APPLICATION's own
// comma (`{ v: Pair<i32, string>[], q: i32 } | { w: i32 }`). The variant field scanner
// (`collectShapeVariantFields`) splits the arm's field list at top-level commas, so its
// depth alphabet must count the generic brackets — a `<>`-blind scan cuts the FIELD list
// inside `Pair<i32, string>`, the second half (`string>[]`) has no `:`, and the whole arm
// is rejected ("malformed inline union-variant shape" / "only i32 / boolean / string /
// array union-variant fields are supported").
//
// The pin exists because the scanner now has ONE HOME (`shapeInnerFieldSplit`, moved down
// to `emit_base.vl` so both `emit_collect` and `emit_classify` can reach it). Deleting the
// `<` / `>` arms from that one function reddens this file; before the move the same
// semantic edit had to be made in four places for the same effect, which is exactly how
// #1118's `<>` repair came to be applied one scanner at a time.
type Pair<A, B> = { a: A, b: B }
type U = { v: Pair<i32, string>[], q: i32 } | { w: i32 }

const u: U = { v: [{ a: 1, b: "z" }], q: 3 }
if u is { v: Pair<i32, string>[], q: i32 } { print(u.q) }
