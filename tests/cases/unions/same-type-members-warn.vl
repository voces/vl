// @run
// @warning `Denied` is the same type as `NotFound` ({msg: string}); this union has one member. help: add a discriminant field
// @warning `Denied` is the same type as `NotFound` ({msg: string}); this union holds them as one member. help: add a discriminant field
// @warning `is NotFound` also matches `Denied`; this test can't tell them apart
// @warning `is Denied` also matches `NotFound`; this test can't tell them apart
// @log nf x
// @log d
// @log ok
// Two members spelled apart that are one record type make a union of one member there: the
// union warns where it is formed, and a test naming one warns that it matches the other too.
type NotFound = { msg: string }
type Denied = { msg: string }
type Ok = { v: i32 }
type Err = NotFound | Denied
function f(e: Err) {
  if e is NotFound { return "nf " + e.msg }
  return "other"
}
print(f({ msg: "x" }))
function g(e: NotFound | Denied | Ok) {
  return match e {
    Denied => "d"
    Ok => "ok"
  }
}
print(g({ msg: "y" }))
print(g({ v: 1 }))
