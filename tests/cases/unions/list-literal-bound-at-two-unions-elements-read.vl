// @run
// @log 7
// @log 8
// @log 2
// One un-annotated list literal bound at two unions that share its member, never written: each
// binding is the literal's own list, and an element read through either finds the record.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Tri = { t: i32 }
type Animal = Circle | Sq
type Other = Circle | Tri

function f() {
  const xs = [{ r: 7 }]
  const a: Animal[] = xs
  const b: Other[] = xs
  const e = a[0]
  if e is Circle { print(e.r) } else { print(e.s) }
  const g = b[0]
  if g is Circle { print(g.r + 1) } else { print(g.t) }
  print(a.length + b.length)
}

f()
