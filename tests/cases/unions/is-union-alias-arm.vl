// @run
// @log 105
// @log 4
// @log -1
// @log 11
// @log 22
// @log -1
// @log 1
// @log 1
// @log 1
// @log 0
// @log 7
// @log 1
// `x is U` where `U` is a union alias that is an arm of `x`'s union (D1774).
//
// A union alias arm is a subset of the outer box's tags, never a nested box, so the test is
// the tag chain `as? U` emits and `variantIndexOf` — one name, one variant — cannot name.
//
// Every cell discriminates rather than printing a constant: a chain that answers `true` for
// every value is the shape a broken one takes, so each function is called with a value
// inside the alias and one outside it, and the narrowed arms read a field or a length that
// only the right box can produce.

type U = i32 | string
type A = { a: i32 }
type B = { b: i32 }
type AB = A | B
type J = null | boolean | f64 | string | J[] | { [string]: J }

// the value-atom alias: two arms, both scalars, narrowed twice
function fu(d: U | boolean) {
  if d is U {
    if d is i32 { return d + 100 }
    if d is string { return d.length }
    return -3
  }
  -1
}
print(fu(5))
print(fu("abcd"))
print(fu(true))

// the struct-variant alias: the arm tags are `uTags[vi]`, not atom kinds
function fab(d: AB | boolean) {
  if d is AB {
    if d is A { return d.a + 10 }
    if d is B { return d.b + 20 }
    return -3
  }
  -1
}
const av: AB = { a: 1 }
const bv: AB = { b: 2 }
print(fab(av))
print(fab(bv))
print(fab(true))

// a six-arm alias carrying `null`, an array arm and a map arm
function fj(d: J | i32) {
  if d is J { return 1 }
  0
}
const js: J = "zz"
const jn: J = null
print(fj(js))
print(fj(jn))
print(fj(true))
print(fj(9))

// the narrowed binding is the operand's own box, so it delivers as an argument unchanged
function take(u: U) {
  if u is i32 { return u }
  -2
}
function pass(d: U | boolean) {
  if d is U { return take(d) }
  -1
}
print(pass(7))

// the whole-union self-test, the ladder's other floor
function self(d: U) {
  if d is U { return 1 }
  0
}
print(self("q"))
