// @run
// A cast to a list of literals over a box whose list arms share its tag, tested by its elements
// (`as!` and `as?`), in each position: a scalar and a union argument, a nested argument, a concat
// operand, an interpolation hole, a return, an initializer, an `if` arm, a `??` operand and a
// record field; the propagating `as` hands the whole box back through the union result.
import { toString } from "std:fmt"

type K = 0 | 1
type U = K[] | i32[] | string
type R = { ks: K[] }
function first(ks: K[]): i32 { return ks[0] }
function lenU(u: K[] | string): i32 {
  if u is string { return u.length } else { return u.length }
}
function idK(ks: K[]): K[] { return ks }
function argScalar(x: U): i32 { return first(x as! K[]) }
function argUnion(x: U): i32 { return lenU(x as! K[]) }
function argNested(x: U): i32 { return first(idK(x as! K[])) }
function concat(x: U): string { return "n=" + toString((x as! K[]).length) }
function interp(x: U): string { return "[\{(x as! K[]).length}]" }
function ret(x: U): K[] { return x as! K[] }
function letInit(x: U): i32 {
  const ks = x as! K[]
  return ks.length
}
function ifArm(x: U, c: boolean): i32 {
  const ks = if c { x as! K[] } else { [] }
  return ks.length
}
function coal(x: U): i32 {
  const ks = (x as? K[]) ?? [0, 0, 0]
  return ks.length
}
function rec(x: U): R {
  const r: R = { ks: x as! K[] }
  return r
}
function prop(x: U): U {
  const ks = x as K[]
  return [ks[0]]
}
function opt(x: U): i32 {
  const ks = x as? K[]
  if ks == null { return -1 }
  return ks.length
}
const a: K[] = [1, 0]
const five: i32[] = [5]
print(argScalar(a))
print(argUnion(a))
print(argNested(a))
print(concat(a))
print(interp(a))
print(ret(a).length)
print(letInit(a))
print(ifArm(a, true))
print(ifArm(a, false))
print(coal(a))
print(coal(five))
print(coal("s"))
print(rec(a).ks.length)
const p1 = prop(a)
if p1 is K[] { print(p1[0]) }
const p2 = prop(five)
if p2 is i32[] { print(p2[0]) }
print(opt(a))
print(opt(five))
