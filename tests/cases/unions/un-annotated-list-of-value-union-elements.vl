// @run
// @log 1
// @log hi
// @log 2
// A VALUE UNION (`i32 | string`) IS THE HALF THAT HAD NO DIAGNOSTIC AT ALL.
//
// The struct-union spelling of this defect at least stopped at the `is`: a test over an
// element the emitter had classified as an i32 raised ``is` receiver is not a union value`,
// which is a reject. `e is i32` over a VALUE union is a value-ATOM test and reaches no such
// gate, so the same missing classification wrote the module and said nothing —
// `expected i32, found (ref $type)`, `vl check` clean, `vl build` writing bytes that cannot
// instantiate. Twelve of a 252-cell element-source x union-kind x position grid read that way,
// and every one of them was in this kind.
//
// Both kinds take the same route now: the checker names the recorded element type, `isUName`
// confirms the emitter holds that union's row, and the literal builds the kind-2 box list —
// the same slot `const xs: (i32 | string)[] = […]` interns. A bare scalar or string element
// still coerces into the box at the store, exactly as it does under the annotation.
function pick(b: boolean): i32 | string {
  if b {
    return 1
  }
  return "hi"
}

const gs = [pick(false)]

function callResult() {
  const xs = [pick(true)]
  const e = xs[0]
  if e is i32 {
    print(e)
  }
}

function identElement() {
  const w = pick(false)
  const xs = [w]
  const e = xs[0]
  if e is string {
    print(e)
  }
}

function globalRead() {
  const e = gs[0]
  if e is string {
    print(2)
  }
}

callResult()
identElement()
globalRead()
