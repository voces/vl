// Regression (D4555). An UN-ANNOTATED function whose only returned value is a union-typed
// binding narrowed to one record arm: the checker infers the arm (`Out`), but the emitter
// classified the returned identifier by its declared union and declared the box as the result.
// Callers trust the checker, so `vl check` was rc 0 and the build failed (`ref valtype with no
// interned shape`, `field access but no struct type declared`) or produced invalid wasm.
// The narrowing may come from an early exit through a `never` call, from `if … is` around a
// `return`, or from a tail value-`if` with a `never` arm; the annotated spelling is the control.
// Each result is delivered at a binding, an argument, a struct field and a list element.
// @run
// @hint Intentionally-unused parameter `_c`
// @log 1
// @log 2
// @log 3
// @log 4
// @log 5
// @log 6
// @log 7
// @log 8
// @log 9
// @log 9
type Out = { code: i32, out: string }
type Err = { code: i32, msg: string }
type Holder = { o: Out }

function die(_c: i32): never { __trap__() }

function mk(c: i32, ok: boolean): Out | Err {
  if ok { return { code: c, out: "o" } }
  return { code: c, msg: "m" }
}

// Early exit through a `never` call, the value as the tail.
function guardTail(c: i32) {
  const r = mk(c, true)
  if r is Err { die(2) }
  r
}

// The same guard with an explicit `return`.
function guardReturn(c: i32) {
  const r = mk(c, true)
  if r is Err { die(2) }
  return r
}

// The value returned from inside the narrowing `if`, a record literal after it.
function returnInArm(r: Out | Err) {
  if r is Out { return r }
  return { code: 0, out: "d" }
}

// A tail value-`if` whose other arm never returns.
function tailIf(r: Out | Err) {
  if r is Out { r } else { die(3) }
}

// The annotated control.
function annotated(c: i32): Out {
  const r = mk(c, true)
  if r is Err { die(2) }
  r
}

function codeOf(o: Out) { o.code }

const x = guardTail(1)
print(x.code)
print(codeOf(guardReturn(2)))
const h: Holder = { o: returnInArm(mk(3, true)) }
print(h.o.code)
const xs = [tailIf(mk(4, true))]
print(xs[0].code)
print(guardTail(5).code)
print(codeOf(annotated(6)))
print(returnInArm(mk(7, true)).code)
print(tailIf(mk(8, true)).code)
print(guardReturn(9).code)
print(returnInArm(mk(9, false)).code + 9)
