// @run
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log 1
// @log 1000
// An EMPTY `[]` delivered to a `u8[] | S` union, at the five positions a value reaches one:
// argument, annotated binding, return, assignment and struct field. The literal has no
// element to classify, so the union box read it as `i32[]` and — with no `i32[]` arm to
// store it in and no `u8[]` rung in its re-mapping ladder — built the i32 list and tagged
// it for the packed arm; every narrowed read below then trapped on `ref.cast` (D2201).
// `std:fs`'s `writeFile(path, [])` is the spelling that found it.
type B = { base: i32, length: i32 }

function sink(data: u8[] | B) {
  if data is B { return 1000 }
  return data.length
}
print(sink([]))

const d: u8[] | B = []
if d is B { print(-1) } else { print(d.length) }

function r(): u8[] | B { return [] }
const q = r()
if q is B { print(-1) } else { print(q.length) }

let a: u8[] | B = { base: 1, length: 2 }
a = []
if a is B { print(-1) } else { print(a.length) }

type H = { v: u8[] | B }
const h: H = { v: [] }
const v = h.v
if v is B { print(-1) } else { print(v.length) }

// And the packed list it built is a real one: it grows like any other `u8[]`.
const g: u8[] | B = []
if g is B {
  print(-1)
} else {
  g.push(255)
  print(g.length)
}
print(sink({ base: 8, length: 0 }))
