// @run
// @hint redundant type annotation: `f` is inferred as `i32`
// A `(0 | 1) | null` field through `?.` … `??`, on a present and a null receiver.
// The literal type takes its base atom's rep, which the result follows.
type P = { v: (0 | 1) | null }
function f(p: P | null): i32 { return p?.v ?? 5 }
print(f({ v: 1 }))
print(f(null))
// @log 1
// @log 5
