// @run
// @log false
// @log false
// @log true
// @log false
// @log false
// `v is K` over a box whose string arm is a plain `string` is membership over the payload, not a
// tag compare, so a non-member string is not a `K` (D3348); the same at a pin.
type K = "a" | "b"
type P = {x: i32}
function g(a: P, b: string, k: i32) {
  const r = if k == 0 { a } else { b }
  print(r is K)
}
const p = { x: 7 }
g(p, "x", 0)
g(p, "x", 1)
g(p, "a", 1)
function h<T, U>(a: T, b: U, k: i32) {
  const r = if k == 0 { a } else { b }
  print(r is K)
}
h(p, "x", 0)
h(p, "x", 1)
