// @error WRITTEN THROUGH
// @hint redundant type annotation: `a` is inferred as `{r: i32}[]` — remove it to lean on inference
// @hint redundant type annotation: `o` is inferred as `{inn: {xs: Shape[]}}` — remove it to lean on inference
// The soundness half of the nested container (D1682).
//
// `o.inn.xs.push` roots at no name, so the write is read back through the escape key — the
// path `inn.xs` off `o`. The key is built by one join rule that both the filing side and the
// handle test use, so a nested handle cannot be filed one way and matched another.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box = { xs: Shape[] }
type Outer = { inn: Box }

function f() {
  const a: Circle[] = [{ r: 7 }]
  const b: Shape[] = a
  const o: Outer = { inn: { xs: b } }
  o.inn.xs.push({ s: 3 })
  print(a.length)
}

function other() {
  const w: Shape[] = []
  w.push({ s: 3 })
  print(w.length)
}

f()
other()
