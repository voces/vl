// @run
// @log str b
// @log B i32
// @log B null
// Record arms sharing a field name (D4056): a read of the field under an `is` narrowing is the
// narrowed arm's own field, delivered into a union-typed parameter, whatever a sibling arm's
// same-named field stores.
type A = { v: "a" | "b" }
type B = { v: i32 | null }
function sh(x: i32 | string | null) {
  if x == null { return "null" }
  if x is i32 { return "i32" }
  "str " + x
}
function f(u: A | B) {
  if u is A { print(sh(u.v)) } else { print("B " + sh(u.v)) }
}
const a: A = { v: "b" }
f(a)
const b: B = { v: 4 }
f(b)
const c: B = { v: null }
f(c)
