// @run
// @log 3
// @log 3
// @log 2
// @log 2
// @log 2
// @log x
// @log 1
// @log 1
// A list whose element is a union of lists that all spell one list is a ref list of that
// list, annotated or not and at a generic instance, and a closure capturing it reads it so.
type K = 0 | 1
function ann() {
  const c: (i32[] | K[])[] = [[1, 0, 1]]
  const f = () => {
    const e = c[0]
    if e is i32[] { print(e.length) }
  }
  f()
}
function una() {
  const k: K[] = [1, 0, 1]
  const c = [k]
  const f = () => {
    const e = c[0]
    if e is K[] { print(e.length) }
  }
  f()
}
ann()
una()
function gen<T>(x: T) {
  const c: (i32[] | K[])[] = [[1, 0], [1]]
  const f = () => {
    print(c.length)
    print(x)
  }
  f()
}
gen(2)
gen("x")
function len(c: (i32[] | K[])[]) { return c.length }
print(len([[1]]))
const u: (i32[] | K[])[] = [[0]]
print(len(u))
