// @run
// A value `if` or `match` whose every arm is the same anonymous union arm delivers that arm's
// struct into an arm-typed cell, at an assignment and at an initializer, local or global (D4639).
type U = { q: i32 } | { r: i32 }
function pickQ(n: i32) { n > 0 }
function reassign(c: boolean) {
  let v = { q: 4 }
  v = if c { { q: 5 } } else if !c { { q: 6 } } else { { q: 7 } }
  print(v.q)
}
function viaMatch(n: i32) {
  let v = { q: 0 }
  v = match n {
    1 => { q: 11 }
    _ => { q: 12 }
  }
  print(v.q)
}
function initializer(c: boolean) {
  const v = if c { { q: 21 } } else { { q: 22 } }
  const u: U = v
  print(u is { q: i32 })
  print(v.q)
}
const flag = pickQ(1)
let g = { q: 40 }
g = if flag { { q: 41 } } else { { q: 42 } }
const h = if flag { { q: 51 } } else { { q: 52 } }
function readGlobals() {
  print(g.q)
  print(h.q)
}
reassign(true)
viaMatch(2)
initializer(true)
readGlobals()
// @log 5
// @log 12
// @log true
// @log 21
// @log 41
// @log 51
