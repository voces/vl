// @run
// @log 1
// @log 1
// @log 2
// @log 1
// @log 1
// @log 2
// @log 1
// @log 1
// @log 0
// @hint Intentionally-unused variable `_t` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_t` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_t` (leading `_` marks it unused)
// @hint redundant type annotation: `a4` is inferred as `Json | JsonError` — remove it to lean on inference

// D1825/D1824 — a `.pop()` off a list whose element is a value UNION has no nullable niche:
// its `T | null` is the box itself, with `null` riding as the box's tag, which is the rep
// `emitMapGetUnionBox` already gives a union-valued map read. The cell is that box, the miss
// arm builds the null-tagged one, and the element's union name makes a narrowed read unbox.

import { Json, JsonError, parseJson } from "std:json"

// Discarded — the SILENT face: the module used to fail to validate.
const a1 = parseJson("[1, 2]")
if a1 is JsonError {
  print("err")
} else {
  if a1 is Json[] {
    const _t = a1.pop()
    print(a1.length)
  } else {
    print("nolist")
  }
}

// Null-guarded — the LOUD face, `bare null needs a struct-typed context`.
const a2 = parseJson("[1, 2]")
if a2 is JsonError {
  print("err")
} else {
  if a2 is Json[] {
    const t = a2.pop()
    if t != null { print(a2.length) } else { print("no") }
  } else {
    print("nolist")
  }
}

// Bound and USED through a narrowing of the popped value — the third position, which refused
// `is` names a type that is not a union variant.
const a3 = parseJson("[1, 2]")
if a3 is JsonError {
  print("err")
} else {
  if a3 is Json[] {
    const t = a3.pop()
    if t is f64 { print(t) } else { print("notf64") }
  } else {
    print("nolist")
  }
}

// The ANNOTATED face of the binding, which pins the rep where the three above infer it.
const a4: Json | JsonError = parseJson("[1, 2]")
if a4 is JsonError {
  print("err")
} else {
  if a4 is Json[] {
    const _t = a4.pop()
    print(a4.length)
  } else {
    print("nolist")
  }
}

// Depth 1 — one narrowing rather than two.
const a5 = parseJson("[1, 2]")
if a5 is Json[] {
  const t = a5.pop()
  if t != null { print(a5.length) } else { print("no") }
} else {
  print("nolist")
}

// The row's own boundary: a STRUCT element keeps its `nulstruct` niche and its own behaviour.
type Circle = { r: f64 }
type Err = { msg: string }
type U = Circle[] | string | Err

function pick(b: boolean): U {
  if b { return [{ r: 1.0 }, { r: 2.0 }] }
  "s"
}

const c1 = pick(true)
if c1 is Err {
  print("err")
} else {
  if c1 is Circle[] {
    const t = c1.pop()
    if t != null { print(t.r) } else { print("no") }
  } else {
    print("nolist")
  }
}

const c2 = pick(true)
if c2 is Err {
  print("err")
} else {
  if c2 is Circle[] {
    const _t = c2.pop()
    print(c2.length)
  } else {
    print("nolist")
  }
}

// A NESTED-list element and a STRING-list element, the two neighbouring element kinds the new
// arm must not claim: both ran before and must keep running.
type UN = Circle[][] | string

function pickn(b: boolean): UN {
  if b { return [[{ r: 1.0 }], [{ r: 2.0 }]] }
  "s"
}

const n1 = pickn(true)
if n1 is Circle[][] {
  const t = n1.pop()
  if t != null { print(t.length) } else { print("no") }
} else {
  print("nolist")
}

type US = string[] | i32

function picks(b: boolean): US {
  if b { return ["a"] }
  1
}

const s1 = picks(true)
if s1 is string[] {
  const t = s1.pop()
  if t != null { print(s1.length) } else { print("no") }
} else {
  print("noi")
}
