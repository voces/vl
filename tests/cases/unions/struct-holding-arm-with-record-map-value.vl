// @run
// @log 7
// @log 8
// A plain struct holding a union arm whose map value is a declared record, declared before the
// holder, and one whose map value is a nullable arm: the arm's twin row is decided from the
// record-row class before the map slots exist (D15098, D15151).
type R = { r: i32 }
type Q = { o: A }
type A = { n: i32, g: Map<string, R>, p: Map<string, P | null> }
type P = { m: i32 }
type U = A | P
const g: Map<string, R> = Map()
g.set("x", { r: 7 })
const pm: Map<string, P | null> = Map()
pm.set("z", { m: 8 })
const q: Q = { o: { n: 1, g: g, p: pm } }
print(q.o.g.get("x")?.r ?? 0)
print(q.o.p.get("z")?.m ?? 0)
