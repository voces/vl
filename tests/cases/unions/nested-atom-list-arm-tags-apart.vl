// @run
// @log i32
// @log K y
// @log K x
// @log i32
// @log n i32
// @log nullable K
// @log r K x
// @log u K
// @log false
// D4914: a list of literal-union lists keeps its own tag beside a list of `i32` lists, so `is`
// tells `K[][]` from `i32[][]` at every delivery.
type K = "x" | "y"
function f(a: i32[][] | K[][]) {
  if a is K[][] { print("K " + a[0][0]) } else { print("i32") }
}
function n(a: i32[][] | (K | null)[][]) {
  if a is (K | null)[][] { print("nullable K") } else { print("n i32") }
}
function g(): i32[][] | K[][] {
  const z: K[][] = [["y", "x"]]
  z
}
f([[7]])
f([["y"]])
const kk: K[][] = [["x"]]
f(kk)
const ii: i32[][] = [[1, 2]]
f(ii)
n([[7]])
const kn: (K | null)[][] = [["x", null]]
n(kn)
const r = g()
if r is i32[][] { print("r i32") } else { print("r K " + r[0][1]) }
let u: i32[][] | K[][] = kk
match u {
  i32[][] => print("u i32")
  K[][] => print("u K")
}
u = ii
print(u is K[][])
