// D2326 — the value-union member-set ladder (`unionNameOfIdentSid`) resolved a name to
// whichever sibling block's binding the scan visited FIRST, exactly the bug D2316 fixed for
// the closure ladder. Two ordinary sibling blocks bind `u` to DIFFERENT struct unions; the
// second block's `else`-arm read the FIRST block's member set, subtracted a member that
// wasn't even in it, and failed at emit: `field access receiver is not a struct`.
// @run
// @log 5|inner

type A = { x: i32 }
type B = { y: string }
type C = { z: boolean }

function f() {
  let out = ""
  {
    const u: A | B = { x: 5 }
    if u is A { out = "\{u.x}" } else { out = "\{u.y}" }
  }
  {
    const u: C | B = { z: true }
    if u is C { out = out + "|inner" } else { out = out + "|\{u.y}" }
  }
  out
}
print(f())
