// @emit-error field access but no struct type declared
// CONTRACT (must-emit-reject): teaching the shared-field dispatch a CALL receiver widened
// which RECEIVERS it accepts, and must not have widened which FIELD REPS it can spell. The
// dispatch is a chain of `if (result …)` blocks, so the field's rep has to be a blocktype:
// the scalars and `string` are, a LIST is not. `xs` is shared by both members at one code
// and the read is still the loud floor — the same floor the IDENT-receiver spelling takes,
// which is the point. `sharedFieldCodeDispatchable` is the one gate, and it did not move.
type A = { xs: i32[], a: i32 }
type B = { pad: boolean, xs: i32[] }
function g(flag: boolean): A | B {
  if flag { return { xs: [1, 2], a: 3 } }
  return { pad: true, xs: [4] }
}
print(g(true).xs.length)
