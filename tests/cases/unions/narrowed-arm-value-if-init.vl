// @run
// A value `if` whose arm is a union binding narrowed to a record arm initializes an arm-typed
// global or local with that record, beside a literal or a declared record arm (D2907, D4561).
type P = { x: i32 }
type Q = { y: string }
function mk(b: boolean): P | Q {
  if b { return { x: 4 } }
  { y: "q" }
}
const v = mk(true)
const g1: P = if v is P { v } else { { x: 9 } }
print(g1.x)
const g2: P = if v is Q { { x: 9 } } else { v }
print(g2.x)
const d: P = { x: 1 }
const g3: P = if v is P { v } else { d }
print(g3.x)
type Out = { a: i32 }
type Err = { msg: string }
function annotated(r: Out | Err) {
  const o: Out = if r is Out { r } else { { a: 0 } }
  o.a
}
function inferred(r: Out | Err) {
  const o = if r is Out { r } else { { a: 0 } }
  o.a
}
function param(r: Out | Err, dflt: Out) {
  const o: Out = if r is Out { r } else { dflt }
  o.a
}
print(annotated({ a: 3 }))
print(inferred({ msg: "e" }))
print(param({ msg: "e" }, { a: 7 }))
// @log 4
// @log 4
// @log 4
// @log 3
// @log 0
// @log 7
// @hint redundant type annotation: `g3` is inferred as `P`
// @hint redundant type annotation: `o` is inferred as `Out`
