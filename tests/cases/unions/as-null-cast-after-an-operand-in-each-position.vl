// @run
// @log 7
// @log -1
// @log 17
// @log 9
// @log 7
// @log -1
// @log 14
// An `as?` over a union box written after another operand: a closure field's argument, a second
// argument, a binary operand, a record literal's later field and a list literal's later element.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function rad(w: Circle | null) {
  if w == null { return -1 }
  return w.r
}
function two(a: i32, w: Circle | null) { return a + rad(w) }
const mem: { g: (Circle | null) => i32 } = { g: (w) => rad(w) }
function shape(n: i32): Shape {
  if n == 0 { return { r: 7 } }
  return { s: 2 }
}
const sh = shape(0)
const sq = shape(1)
print(mem.g(sh as? Circle))
print(mem.g(sq as? Circle))
print(two(10, sh as? Circle))
print(2 + rad(sh as? Circle))
const pair = { a: rad(sh as? Circle), b: rad(sq as? Circle) }
print(pair.a)
print(pair.b)
const xs = [rad(sh as? Circle), rad(sh as? Circle)]
print(xs[0] + xs[1])
