// @error WRITTEN THROUGH
// THE HALF OF D411's REFUSAL THAT SURVIVES D791, and the file that says where the line is.
//
// This is `list-literal-two-destination-kinds-widen.vl` plus ONE STORE. The element-
// converting copy D791 built gives the union-box destination a PRIVATE list, which is
// exactly D661B's objection — *"a converting copy gives one destination a private list,
// which no other list assignment in the language does"* — and that objection is a statement
// about a WRITABLE destination. Here `c2[0] = { s: 3 }` is a write through one handle whose
// effect an alias would show through the other and a copy would not, so the copy is not
// licensed and the program is refused.
//
// IT IS A CHECK REJECT AND NOT AN EMIT ONE (D821). The refusal used to fire in
// `letRefListDestSlot`, i.e. after `vl check` had returned 0 — a clause-2 violation by
// construction: either the program is legal and should compile, or it is illegal and the
// CHECKER owed the diagnosis. It is illegal, so the checker states it, at the covariant
// assignment the author can change and naming the write that makes it illegal. That is
// A9's `Writable` half, inferred, with no annotation surface.
//
// THE WRITE IS THE ONLY DIFFERENCE. Delete the store line and the program runs, printing 7
// then 1. That is the whole of the Readable/Writable split A9 rules for, reduced to one
// diff. The write question is asked PER VALUE and not per element REP: a store through some
// unrelated list that happens to share an element row does not refuse anything — see
// `list-literal-widen-unrelated-write.vl`, which runs.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function f() {
  const lv1 = [{ r: 7 }]
  const c: Circle[] = lv1
  const c2: Shape[] = lv1
  c2[0] = { s: 3 }
  if c.length > 0 { print(c[0].r) } else { print(0) }
  if c2.length > 0 { print(1) } else { print(0) }
}
f()
