// @run
// @hint redundant type annotation: `a` is inferred as `i32 | null` — remove it to lean on inference
// @log b
// @log 2
// @log 7
// @log 2
// @log b
// @log 8
// @log 7
// @log 3
// @log null
// @log 7
// @log true
// @log 1.5
// @log 7
// A union box delivered where the destination holds one of its scalar members only widened is
// rebuilt under the widened member (D2974): `i32` as `i64` or `f64`, `f32` as `f64`. Passed raw,
// the destination read the `i32` payload as its own member and trapped or printed a wrong arm.
function take(xs: (string | i64)[]) {
  print(xs[0])
  print(xs.length)
}
function go(a: string, c: boolean) {
  const r = if c { a } else { 7 }
  take([r, r])
}
go("b", true)
go("b", false)
function arith(x: string | i64) {
  if x is i64 { print(x + 1) } else { print(x) }
}
function viaArg(a: string, c: boolean) {
  const r = if c { a } else { 7 }
  arith(r)
}
viaArg("b", true)
viaArg("b", false)
function ret(c: boolean): string | f64 {
  const r = if c { "s" } else { 7 }
  return r
}
print(ret(false))
function nul(c: boolean) {
  const a: i32 | null = if c { 3 } else { null }
  const w: i64 | null = a
  print(w)
}
nul(true)
nul(false)
function three(c: i32) {
  const r = if c == 0 { "b" } else if c == 1 { 7 } else { true }
  const w: string | i64 | boolean = r
  print(w)
}
three(1)
three(2)
function fl(c: boolean) {
  const f: f32 = 1.5
  const r = if c { "b" } else { f }
  const w: string | f64 = r
  print(w)
}
fl(false)
const g: string | i32 = 7
const h: string | i64 = g
print(h)
