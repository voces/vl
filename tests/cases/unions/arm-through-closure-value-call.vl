// @run
// @log 7
// @log 7
// @log 7
// @log 7
// D195 — an un-annotated binding of a CLOSURE-VALUE call whose result is a union ARM.
//
// `exprVariantIndex`'s `Call` arm resolved only a DECLARED function (`fnIndexOfSid`),
// while its nullable twin `nulVariantIdxOfExpr` has carried a CLOSURE-VALUE rung
// (`calleeCloSigKeySid` + `sigKeyRetSlot`) and a closure-FIELD rung
// (`fieldClosureFeOfRecv`) since it was written. (The field rung has its own fixture,
// `arm-through-closure-field-call.vl` — a `{ go: … }` literal beside a second lambda is
// a SEPARATE open hole, D199.) A -1 there is not "unknown": it IS the
// kind decision — `globalKind`'s variant arm is `exprVariantIndex(...) >= 0`, and
// `letIsVariant`'s init leg is the same call — so the binding fell through to the
// STANDALONE struct table, which a union arm has no row in (`collectS` skips a
// `type X = {…}` that is a union member).
//
// `Dot` is the arm's exact layout TWIN and is what makes the failure SILENT rather than
// loud: the struct scan matched Dot's row and the cell was declared over Dot's
// `sHeapIdx` heap while the call returned the arm's `uVarHeap` one — `vl check` clean,
// `expected (ref null $type), found (ref $type)` from the engine. Without the twin the
// same root is the loud `ref valtype with no interned shape`, which is why the loud half
// is not evidence the silent half is absent.
type Shape = Circle | Sq
type Sq = { s: i32 }
type Dot = { r: i32 } // the arm's exact layout twin — a STANDALONE struct, its own heap
type Circle = { r: i32 }

const c: Circle = { r: 7 }

// a lambda binding
const lamc = (x: Circle) => x
const viaLambda = lamc(c)
print(viaLambda.r)

// a declared function taken as a VALUE, then called through the binding
function idc(x: Circle): Circle { x }
const fval = idc
const viaFnValue = fval(c)
print(viaFnValue.r)

// a lambda that RETURNS the arm with no parameter of its own
const mk = () => c
const viaRet = mk()
print(viaRet.r)

// the same, at function scope (the local slot ladder reads the same resolver)
function atLocalScope() {
  const lc: Circle = { r: 7 }
  const llam = (x: Circle) => x
  const ld = llam(lc)
  print(ld.r)
}
atLocalScope()
