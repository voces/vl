// @run
// @log 1
// @log 4
// @log null
// @log 1
// @log 2
// @log null
// @log 4
// @log -1
// @hint redundant type annotation: `y` is inferred as `i32 | null`
// D4268: record arms that both store a nullable integer field, one as a literal, read it as the
// box they store, into an annotated binding, an un-annotated one, and a return.
type A = { v: i32 | null }
type B = { v: 1 | null }
function f(u: A | B) {
  const y: i32 | null = u.v
  if y == null { print("null") } else { print(y) }
}
const x1: B = { v: 1 }
f(x1)
const x3: A = { v: 4 }
f(x3)
const x4: A = { v: null }
f(x4)

type C = { v: 1 | null }
type D = { v: 2 | null }
function g(u: C | D) {
  const y = u.v
  if y == null { print("null") } else { print(y) }
}
g({ v: 1 })
g({ v: 2 })
g({ v: null })

type E = { k: "a", v: i32 | null }
type F = { k: "b", v: i32 | null }
function h(u: E | F): i32 {
  const y = u.v
  if y == null { return -1 }
  return y
}
print(h({ k: "a", v: 4 }))
print(h({ k: "b", v: null }))
