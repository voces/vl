// @run
// @log 7000000000
// @log 9000000000000000000
// @log 5000000000
// @log 3.5
// @log 1.25
// @log 1.25
// @log 1.25
// @log 0.375
// @log 9000000000
// @log 1
// @log 9000000000
// @log 7000000000
// @log 7000000000
// @log 5000000000
// @log 5000000000
// @log 5000000000
// @log 7
// @log 5
// @log 9000000000000000000
// @log 5000000000
// A `??` over a nullable union of numbers delivered into a wider number type converts the
// member it holds exactly, and takes the default on null (D3517): at a return, a typed
// binding, an argument, a field, a list element and a module-level binding, and over the
// two-width literal union. The un-annotated binding keeps the union.
type E = 9000000000 | 1 | null
type R = { v: i64 }
function ret(x: i32 | i64 | null): i64 { x ?? 5 }
function half(v: f64) { v / 2 }
function fin(x: i32 | f64 | null) {
  const w: f64 = x ?? 2.5
  return half(w)
}
function fl(x: f32 | f64 | null): f64 { return x ?? 2.5 }
function lit(x: E): i64 { x ?? 9000000000 }
function take(v: i64) { print(v * 1000000000) }
function positions(x: i32 | i64 | null) {
  const r: R = { v: x ?? 5 }
  print(r.v * 1000000000)
  const xs: i64[] = []
  xs.push(x ?? 5)
  print(xs[0] * 1000000000)
}
print(ret(7) * 1000000000)
print(ret(9000000000) * 1000000000)
print(ret(null) * 1000000000)
print(fin(7))
print(fin(2.5))
print(fin(null))
const h: f32 = 2.5
print(fl(h) / 2)
print(fl(0.75) / 2)
print(lit(null))
print(lit(1))
print(lit(9000000000))
positions(7)
positions(null)
const g: i32 | i64 | null = null
const gw: i64 = g ?? 5
print(gw * 1000000000)
const u: i32 | i64 | null = 7
const uw = u ?? 5
print(uw)
const n: i32 | i64 | null = null
const nw = n ?? 5
print(nw)
function arg(x: i32 | i64 | null) { take(x ?? 5) }
arg(9000000000)
arg(null)
