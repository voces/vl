// @run
// @log 3
// @log 7
// @log x
// A union declaration lowers as one struct when its member is one anonymous record that canon
// folds an intersection into, a literal-typed field included.
type AB = { a: i32 } & { b: i32 }
type KV = { k: "x" } & { v: i32 }
function mkAB(): AB { return { a: 1, b: 2 } }
function sumAB(v: AB) { return v.a + v.b }
print(sumAB(mkAB()))
const kv: KV = { k: "x", v: 7 }
print(kv.v)
print(kv.k)
