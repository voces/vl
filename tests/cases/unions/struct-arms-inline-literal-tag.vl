// THE DISCRIMINATED-UNION IDIOM, spelled the way every other typed language spells it: the
// tag is a bare literal in the arm's own field list (`kind: "circle"`), not a named alias.
//
// It did not compile. `unionArmBoxSafe` — the checker's gate on which struct arms may be
// boxed into a value union — had arms for `TyPrim`, a nested `TyObj`, a LITERAL UNION
// (`tyIsLitUnion`, which requires a `TyUnion`), `TyFunc` and `TyNullable`, and a bare
// one-member `TyLit` fell through all of them to the closing `return false`. The whole arm
// was then refused as box-unsafe, the union-arm pick found no arm, and the program was
// rejected at its own construction:
//
//     cannot assign {kind: string, r: f64} to 'c' of type S
//
// A 4-cell control grid isolates the axis exactly — the two-member inline spelling
// (`kind: "circle" | "round"`, a real `TyUnion`), the named-alias spelling
// (`type KC = "circle"`) and the plain `kind: string` spelling all compiled on master. Only
// the ONE-MEMBER inline literal did not, which is the spelling a user reaches for first.
//
// The arm boxes as a plain STRING field (code 3), which is the rep a bare literal annotation
// already has everywhere else — `fieldCodeOfSpelling` reaches `tyScalarBaseIs(fsTy, "string")`
// and codes it exactly as `kind: string`. So this claims no new emitter capability; it admits
// the arm the `TyPrim` arm would already admit if the tag were spelled `string`. Moving these
// values onto the interned ATOM rep is A5c and is deliberately NOT done here.
//
// The pair whose arms differ ONLY by the tag literal is a loud reject, not a cell of this
// file — `same-field-names-literal-tags-reject.vl`. Here every pair also differs by field
// NAME, which is the discriminator VL's structural unions are actually built on.
// @run
// @log circle
// @log 2
// @log 9
// @log 3
// @log rect

type C = { kind: "circle", r: f64 }
type R = { kind: "rect", w: f64 }
type S = C | R

// construct into the union, narrow, read both the tag and the payload
const c: S = { kind: "circle", r: 2.0 }
if c is C { print(c.kind) print(c.r) }   // circle, 2

// the same union through `match`, and through a function boundary
function area(s: S) {
  return match s {
    C => s.r * s.r,
    R => s.w,
  }
}
print(area({ kind: "circle", r: 3.0 }))  // 9

// arms may differ in field COUNT as well as in the tag
type Sq = { kind: "square", side: f64, filled: boolean }
type T = C | Sq
const t: T = { kind: "square", side: 3.0, filled: true }
if t is Sq { print(t.side) }             // 3

// a FACTORY returning the union — the arm is picked at the `return`, not at a binding
function mkRect(w: f64): S { return { kind: "rect", w: w } }
const r = mkRect(4.0)
if r is R { print(r.kind) }              // rect
