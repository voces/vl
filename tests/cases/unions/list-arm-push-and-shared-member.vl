// @run
// @log 3
// @log 7
// @log 5
// @log 1
// @log 1
// @log 2
// @log 9
// @hint redundant type annotation: `grow` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `xs` is inferred as `i32[]` — remove it to lean on inference
// @hint redundant type annotation: `s` is inferred as `string[]` — remove it to lean on inference
// @hint redundant type annotation: `s` is inferred as `string[]` — remove it to lean on inference
// @hint redundant type annotation: `s` is inferred as `string[]` — remove it to lean on inference
// @hint redundant type annotation: `o` is inferred as `{v: i32}` — remove it to lean on inference
// The annotations above are DELIBERATE and the hints are declared rather than removed:
// each one pins the type this fixture is about, and leaning on inference would make the
// case test inference instead of the union lowering.
// TWO list-in-union shapes that were check-clean INVALID WASM, neither of them `u8`.
//
// Both surfaced while sweeping the neighbourhood for the packed-list work and both
// reproduce with `i32[]`/`string[]`, so they are long-standing and were simply invisible:
// `vl check` reports them clean, and only `vl check --codegen` — which validates the
// emitted module — ever objected.
type S = { v: i32 }

// (1) `.push` ON A UNION PARAMETER NARROWED TO ITS LIST ARM.
// The narrowed receiver kept the union's view rather than the arm's, so the push wrote
// through the wrong backing. The `else` arm is here deliberately: a narrowing only
// misbehaves where something READS through it, which is the discriminator the sibling
// `is`-complement bug turned on too.
function grow(x: i32[] | i32): i32 {
  if x is i32[] {
    x.push(7)
    return x.length
  }
  x
}
const xs: i32[] = [1, 2]
print(grow(xs))
print(xs[2])
print(grow(5))

// (2) TWO UNIONS IN ONE MODULE SHARING A LIST MEMBER WITH DIFFERENT PARTNERS.
// `string[]` is a member of both `string[] | i32[]` and `string[] | i32`. Either union
// ALONE lowered; the module holding both did not — the shared member's slot was decided
// once and reused by a union that needed a different one.
function pair(): string[] | i32[] {
  const s: string[] = ["a"]
  s
}
function mixed(): string[] | i32 {
  const s: string[] = ["b"]
  s
}
const p = pair()
if p is i32[] { print(p.length) } else { print(p.length) }
const m = mixed()
if m is i32 { print(m) } else { print(m.length) }

// The same member in a THIRD union, to prove the slot is per-union and not per-member.
function nullable(): string[] | null {
  const s: string[] = ["c", "d"]
  s
}
const n = nullable()
if n != null { print(n.length) } else { print(0) }

// A struct-arm union alongside them, so the list arms cannot be the only thing registered.
function withStruct(): i32[] | S {
  const o: S = { v: 9 }
  o
}
const w = withStruct()
if w is S { print(w.v) } else { print(w.length) }
