// Unions wider than 32 members, each reading through its member set: a field shared by every
// arm, a nullable union narrowed by `== null` and `is`, a `match` over records beside scalar
// and `null` arms, and records beside string literals compared by `==`. A row of any width has
// member sets, so every one of these narrows exactly as a four-arm union does.
// @run
// @log 10
// @log 20
// @log 20
// @log -1
// @log 40
// @log 9
// @log -2
// @log 6
// @log 100
// @log -1
// @log 7
// @log 3
// @log r0
// @log q0
// @log other
// @log last
type R0 = { f0: i32, pos: i32 }
type R1 = { f1: i32, pos: i32 }
type R2 = { f2: i32, pos: i32 }
type R3 = { f3: i32, pos: i32 }
type R4 = { f4: i32, pos: i32 }
type R5 = { f5: i32, pos: i32 }
type R6 = { f6: i32, pos: i32 }
type R7 = { f7: i32, pos: i32 }
type R8 = { f8: i32, pos: i32 }
type R9 = { f9: i32, pos: i32 }
type R10 = { f10: i32, pos: i32 }
type R11 = { f11: i32, pos: i32 }
type R12 = { f12: i32, pos: i32 }
type R13 = { f13: i32, pos: i32 }
type R14 = { f14: i32, pos: i32 }
type R15 = { f15: i32, pos: i32 }
type R16 = { f16: i32, pos: i32 }
type R17 = { f17: i32, pos: i32 }
type R18 = { f18: i32, pos: i32 }
type R19 = { f19: i32, pos: i32 }
type R20 = { f20: i32, pos: i32 }
type R21 = { f21: i32, pos: i32 }
type R22 = { f22: i32, pos: i32 }
type R23 = { f23: i32, pos: i32 }
type R24 = { f24: i32, pos: i32 }
type R25 = { f25: i32, pos: i32 }
type R26 = { f26: i32, pos: i32 }
type R27 = { f27: i32, pos: i32 }
type R28 = { f28: i32, pos: i32 }
type R29 = { f29: i32, pos: i32 }
type R30 = { f30: i32, pos: i32 }
type R31 = { f31: i32, pos: i32 }
type R32 = { f32: i32, pos: i32 }
type R33 = { f33: i32, pos: i32 }
type R34 = { f34: i32, pos: i32 }
type R35 = { f35: i32, pos: i32 }
type R36 = { f36: i32, pos: i32 }
type R37 = { f37: i32, pos: i32 }
type R38 = { f38: i32, pos: i32 }
type R39 = { f39: i32, pos: i32 }
type N = R0
  | R1
  | R2
  | R3
  | R4
  | R5
  | R6
  | R7
  | R8
  | R9
  | R10
  | R11
  | R12
  | R13
  | R14
  | R15
  | R16
  | R17
  | R18
  | R19
  | R20
  | R21
  | R22
  | R23
  | R24
  | R25
  | R26
  | R27
  | R28
  | R29
  | R30
  | R31
  | R32
  | R33
  | R34
  | R35
  | R36
  | R37
  | R38
  | R39
const nodes: N[] = [{ f0: 1, pos: 10 }, { f39: 2, pos: 20 }]
function posAt(x: i32) {
  const n = nodes[x]
  n.pos
}
print(posAt(0))
print(posAt(1))
print(nodes[1].pos)
function g(x: N | null) {
  if x == null { return -1 }
  x.pos
}
function h(x: N | null) {
  if x != null {
    if x is R39 { return x.f39 }
    return x.pos
  }
  -2
}
print(g(null))
print(g({ f3: 1, pos: 40 }))
print(h({ f39: 9, pos: 1 }))
print(h(null))
type M = R0
  | R1
  | R2
  | R3
  | R4
  | R5
  | R6
  | R7
  | R8
  | R9
  | R10
  | R11
  | R12
  | R13
  | R14
  | R15
  | R16
  | R17
  | R18
  | R19
  | R20
  | R21
  | R22
  | R23
  | R24
  | R25
  | R26
  | R27
  | R28
  | R29
  | R30
  | R31
  | R32
  | R33
  | R34
  | R35
  | R36
  | i32
  | string
  | null
function tag(u: M) {
  match u {
    i32 => u + 1
    string => 100
    null => -1
    R0 => u.f0
    _ => u.pos
  }
}
print(tag(5))
print(tag("s"))
print(tag(null))
print(tag({ f0: 7, pos: 2 }))
print(tag({ f36: 7, pos: 3 }))
type Q = R0
  | R1
  | R2
  | R3
  | R4
  | R5
  | R6
  | R7
  | R8
  | R9
  | R10
  | R11
  | R12
  | R13
  | R14
  | R15
  | R16
  | R17
  | R18
  | R19
  | "q0"
  | "q1"
  | "q2"
  | "q3"
  | "q4"
  | "q5"
  | "q6"
  | "q7"
  | "q8"
  | "q9"
  | "q10"
  | "q11"
  | "q12"
  | "q13"
  | "q14"
  | "q15"
  | "q16"
  | "q17"
  | "q18"
  | "q19"
function name(u: Q) {
  if u is R0 { return "r0" }
  if u == "q0" { return "q0" }
  if u is R19 { return "last" }
  "other"
}
print(name({ f0: 1, pos: 2 }))
print(name("q0"))
print(name("q1"))
print(name({ f19: 1, pos: 2 }))
