// @run
// @log 5
// @log 5
// @log 5
// @log 6
// @log 5
// @log true
// @log true
// @log hi
// @log hi
// A negation is a checker-only refinement with no positive type of its own, so it names no
// rep: a binding annotated with one takes the cell its INITIALIZER gives it, exactly as the
// un-annotated binding beside it does. The annotation says which values may arrive, never how
// the one that did is stored. D1773.
//
// Both spellings are graded, because they must agree: `!string` inline and a `type` alias over
// it resolve to the same arena negation, so a cell ladder that reads one must read the other.
// The reader is graded with them — a boolean cell printed `1` where its un-annotated twin
// printed `true`, so cell and print arm move together or the close ships a wrong value.
type N = !string
type M = !i32

// A local, a block-scoped binding, and a re-assignment: the three shapes whose cell the
// annotation does not name.
function inFn() {
  const x: !string = 5
  print(x)
  const y: N = 5
  print(y)
}
inFn()

if true {
  const b: !string = 5
  print(b)
}

function reassign() {
  let z: !string = 5
  z = 6
  print(z)
}
reassign()

// A module global, which D1775 reached for the alias and this keeps.
const g: !string = 5
print(g)

// The boolean face at both scopes: the print arm has to follow the cell.
function boolLocal() {
  const t: !string = true
  print(t)
}
boolLocal()

const tg: N = true
print(tg)

// The string face, which already ran, as the control that must not move.
function strLocal() {
  const s: !i32 = "hi"
  print(s)
}
strLocal()

const sg: M = "hi"
print(sg)
