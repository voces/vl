// @run
// @log 3
// @log 9
// @log 1
// @log 11
// @log 12
// @log 13
// @hint redundant type annotation: `xs` is inferred as `{a: i32}[]`
// @hint redundant type annotation: `xs` is inferred as `{a: i32}[]`
// @hint redundant type annotation: `top` is inferred as `A[]`
// A list literal of a union's record arm whose elements are not all literals or values of the arm
// (an `if` expression, one with a `never` arm) builds each element coerced to the arm's row, as
// legacy's general ref-list path does. Each position is its own function.

type A = { a: i32 }
type B = { b: string }
type U = A | B

function pick(c: boolean): A { return if c { { a: 1 } } else { { a: 2 } } }

function bound(c: boolean) {
  const xs: A[] = [if c { { a: 3 } } else { { a: 4 } }]
  print(xs[0].a)
}
bound(true)

function mixed(c: boolean) {
  const xs: A[] = [{ a: 5 }, if c { { a: 6 } } else { { a: 7 } }, pick(c)]
  print(xs[1].a + xs[2].a)
}
mixed(false)

function count(xs: A[]) { return xs.length }
function argument(c: boolean) {
  print(count([if c { { a: 8 } } else { { a: 9 } }]))
}
argument(true)

function returned(c: boolean): A[] {
  return [if c { { a: 10 } } else { { a: 11 } }]
}
print(returned(false)[0].a)

function fail(): never { return __trap__("no") }
function neverArm(c: boolean) {
  const xs: A[] = [if c { { a: 12 } } else { fail() }]
  print(xs[0].a)
}
neverArm(true)

const u: U = { b: "z" }
const top: A[] = [if u is A { u } else { { a: 13 } }]
print(top[0].a)
