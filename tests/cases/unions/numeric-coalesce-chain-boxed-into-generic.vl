// @run
// @log 9000000001
// @log i64
// @log -3
// @log i32
// @log 5
// @log i32
// A numeric `??` chain whose join is a union, boxed into a generic and into `print`: the box's tag
// leads the chain, as legacy writes it, and each arm's value rides under its own kind.
function kind<T>(v: T) {
  if v is i32 { return "i32" }
  if v is i64 { return "i64" }
  return "other"
}
function run(q: i64 | null, r: i32 | null) {
  print((q ?? (r ?? 5)))
  print(kind((q ?? (r ?? 5))))
}
run(9000000001, null)
run(null, -3)
run(null, null)
