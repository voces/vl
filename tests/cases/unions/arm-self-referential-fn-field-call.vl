// @run
// @log 7
// @log 7
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// A narrowed union arm whose function-typed field names the union itself, called directly
// and through a local. The arm's layout gate once read the field's render and refused it.
type Ev = { kind: "a", cb: (Ev) => i32 } | { kind: "b", n: i32 }
const e: Ev = { kind: "a", cb: (_x: Ev) => 7 }
if e.kind == "a" {
  print(e.cb(e))
  const c = e.cb
  print(c(e))
}
