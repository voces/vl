// @run
// @log 1
// @log 2
// @log 2
// @log true
// @log false
// A union box compared with a concrete literal tests the box's tag for that literal's arm, then
// compares the payload: a string literal over a mixed union, and an `i32` one, by `==` and `!=`.
function f(k: "a" | i32 | null) {
  if k == "a" { return 1 }
  return 2
}
print(f("a"))
print(f(3))
print(f(null))
function g(u: string | i32) { return u != "x" }
print(g(4))
function h(u: string | i32) { return u == 7 }
print(h("7"))
