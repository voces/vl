// @run
// @log 2
// @log 0
// @log 2
// @log 2
// @log 0
// @log 1
// @log 0
// @log 0
// @log true
// @log true
// An `as?` to a list arm used directly as an operand, without a binding: the arm's list or
// null follows each distinct-backing element type (f64, f32, string, u8) and `i32`.
function mf(c: boolean): f64[] | i64[] | i32[] {
  if c { return [1.5, 2.5] }
  [7, 8]
}
function ms(c: boolean): string[] | i32[] {
  if c { return ["a", "b"] }
  [3]
}
function mg(c: boolean): f32[] | u8[] | string {
  if c { return [0.5] }
  "s"
}
print(((mf(true) as? f64[]) ?? []).length)
print(((mf(false) as? f64[]) ?? []).length)
print(((mf(false) as? i32[]) ?? []).length)
print(((ms(true) as? string[]) ?? []).length)
print(((ms(false) as? string[]) ?? []).length)
print(((mg(true) as? f32[]) ?? []).length)
print(((mg(false) as? f32[]) ?? []).length)
print(((mg(false) as? u8[]) ?? []).length)
print((mf(true) as? i64[]) == null)
print((ms(true) as? string[]) != null)
