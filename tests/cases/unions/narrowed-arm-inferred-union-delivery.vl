// @run
// @log 8
// @log 8
// @log 8
// @log 8
// @log 8
// @hint redundant type annotation: `q` is inferred as `A` — remove it to lean on inference

// D1723 — a narrowed struct arm of an INFERRED union, delivered where the destination's own
// row is the answer. `emitCall` unboxed only under the PARAMETER's variant row, and an
// inferred union's arm has no such row, so the box went in whole at `vl check` rc 0. The
// declared spelling is the control: it always ran, and must keep running.
type A = { r: i32 }
type M = i32 | A

function st(): A { return { r: 8 } }

function mkInf(b: boolean) {
  if b { return st() }
  7
}

function mkDecl(b: boolean): M {
  if b { return st() }
  7
}

function takeA(a: A) { print(a.r) }

// The ARGUMENT boundary at both faces — the row's own cell, and its control.
const p = mkInf(true)
if p is A { takeA(p) } else { print(0) }

const d = mkDecl(true)
if d is A { takeA(d) } else { print(0) }

// The RETURN boundary, annotated and inferred, over the same inferred union.
function retAnn(): A {
  const q = mkInf(true)
  if q is A { return q }
  st()
}
print(retAnn().r)

function retInf() {
  const q = mkInf(true)
  if q is A { return q }
  st()
}
print(retInf().r)

// The BINDING boundary, which already ran: the destination cell's own row is what it reads,
// and the two arms above now read the parameter's and the return's the same way.
const b = mkInf(true)
if b is A {
  const q: A = b
  print(q.r)
} else {
  print(0)
}
