// @run
// @log io
// @log null
// @log 3
// @log null
// @log 6
// @log 8
// @log null
// @log 10
// @log 12
// @log 14
// @log 16
// @log 18
// @warning Unreachable code
// A guard whose arm always exits narrows the code after it, wherever the exit sits: inside a
// bare block, before dead code, under an `if`/`else` whose arms both exit, or under a `match`
// whose arms all do. One rule, `stmtAlwaysExits`, answers for the checker and the emitter.
// D1970, reported by plumb (PL-007).
type IoError = { msg: string }

// PL-007's witness.
function f(x: i64 | IoError): i64 | null {
  if x is IoError {
    {
      print(x.msg)
      return null
    }
  }
  x
}
print(f({ msg: "io" }))
print(f(3 as i64))

// The un-annotated spelling of the same guard, and the `== null` direction.
function nested(x: i64 | null) {
  if x == null {
    {
      {
        return null
      }
    }
  }
  x * 2
}
print(nested(null))
print(nested(3 as i64))

function deadAfter(x: i64 | IoError, k: i32) {
  if !(x is i64) {
    {
      return 0 as i64
    }
    print("dead")
  }
  x + (k as i64)
}
print(deadAfter(7 as i64, 1))

function bothArms(x: i64 | IoError, k: i32) {
  if x is IoError {
    {
      if k > 0 { return null } else { return null }
    }
  } else {
    print("kept")
  }
  x * 2
}
print(bothArms({ msg: "e" }, 1))

function everyArm(x: i64 | IoError, k: i32) {
  if x is IoError {
    match k {
      1 => {
        return 0 as i64
      }
      _ => {
        return 1 as i64
      }
    }
  }
  x * 2
}
print(everyArm(5 as i64, 1))

// `break` and `continue` leave the rest of a loop body the same way `return` leaves a function.
function loops(xs: (i64 | null)[]) {
  let i = 0
  while i < xs.length {
    const x = xs[i]
    i = i + 1
    if x == null {
      {
        continue
      }
    }
    if x > 100 {
      {
        break
      }
    }
    print(x * 2)
  }
}
loops([6 as i64, null, 7 as i64, 8 as i64, 9 as i64, 500 as i64, 1 as i64])
