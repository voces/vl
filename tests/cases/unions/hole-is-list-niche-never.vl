// @run
// @warning `is` check type 'i32[]' is not a variant of string[] | null, so this test is always false here
// @warning this branch can never run (its `is` test can never match)
// @log 9
// @log 9
// @log 8
// @log 7
// @log 7
// @log 6
// @log 4
// D16713: an un-annotated parameter bound at `string[] | null` tested `is i32[]`. The niche's
// list fixes its elements, so the test is false even for an empty list, and the arm's read
// of the list, or a `&&`/`||` operand reading it, is dead at this instance.
function arm(a) {
  if a is i32[] { print(a.length) } else { print(9) }
}
function alias(a) {
  const v = a
  if v is i32[] { print(v.length) } else { print(8) }
}
function both(a) {
  if a is i32[] && a.length == 3 { print(3) } else { print(7) }
}
function either(a) {
  if !(a is i32[]) || a.length == 3 { print(6) } else { print(5) }
}
function armAnn(a: string[] | null) {
  if a is i32[] && a.length == 3 { print(3) } else { print(4) }
}
const none: string[] | null = null
const empty: string[] | null = []
const some: string[] | null = ["s"]
arm(none)
arm(empty)
alias(some)
both(none)
both(empty)
either(empty)
armAnn(empty)
