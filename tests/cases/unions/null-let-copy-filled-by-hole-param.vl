// @run
// A copy of a `let x = null` a hole parameter fills is typed by inference per instance: a
// synthesized annotation never spells the open hole (D17845).
function f(a) {
  let s = null
  let t = s
  t = a
  print(t)
  print(t == null)
}
f(1)
f(2.5)
// @log 1
// @log false
// @log 2.5
// @log false
