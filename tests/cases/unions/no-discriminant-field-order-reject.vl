// @error share a field-name set and no literal-typed field distinguishes them
// The no-discriminant refusal must not be dodgeable by SPELLING THE FIELDS IN A DIFFERENT
// ORDER — the second half of the peer ablation's "field order is not a defence".
//
// THE TWO ORDERS ARE NOT THE SAME ORDER, and that is the whole trap. The arena keeps a
// `TyObj`'s fields in SOURCE order; the emitter's `variantSig` — which IS the tag key — sees
// them SORTED. So `{v: i32, w: string}` and `{w: string, v: boolean}` share a tag while their
// arena rows line up `v` against `w`. A checker rule that paired fields BY INDEX called them
// two different signatures, let this program past, and left it to the emit floor: measured
// `vl check` rc 0 then `cannot be discriminated`, which is the clause-2 shape the rule was
// moved to the checker to end. Pairing by NAME is what makes the checker ask the tag's
// question.
type A = { v: i32, w: string }
type B = { w: string, v: boolean }

function f(n: i32): A | B {
  if n == 0 { return { v: 1, w: "a" } }
  return { w: "b", v: true }
}
print(f(1) is A)
