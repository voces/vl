// @run
// @log a
// @log a
// @log a
// @log a
// @log a
// @log true
// The annotation on case 5 is the row's own control and is deliberately kept.
// @hint redundant type annotation: `b` is inferred as `string | null`
// D1766 — an else-less `if` records `string | null`, the nulstr NICHE. `exprNullableString`
// had no typed-IR leg, so the direct `print` fell past every niche and box arm to the plain
// string print over a `(ref null $str)`; and the monomorphization pin read the THEN arm, so a
// hole parameter's cell was the non-null ref the same value could not fill. Both readers take
// the checker's recorded type now, the way their `exprNulBool` and declared-spelling siblings
// already did.

// 1 — the witness: the direct `print` of an else-less `if` with a string arm.
print(if true { "a" })

// 2 — inside a function body, the same route through a different frame.
function h() { print(if true { "a" }) }
h()

// 3 — the HOLE-parameter face: the pin's cell, not the print route. A close at `print`
// alone leaves this one check-clean invalid wasm.
function f(v) { print(v) }
f(if true { "a" })

// 4 — a non-literal condition, so the join is not folded away.
const c = 1 > 0
print(if c { "a" })

// 5 — the ANNOTATED binding, which ran at both seeds and must keep running: it is what says
// the niche route was always there and only the direct spelling could not reach it.
const b: string | null = if true { "a" }
print(b)

// 6 — the `boolean | null` sibling niche, whose `exprNulBool` already had the typed-IR leg
// this change gives its string twin.
print(if true { true })
