// Q58 position sweep: a `f64 | string` box tested against integer literals (one member and a
// set), as an `if` condition, a return, a `let` initializer, a call argument, a `&&` operand, an
// `if` arm value, a negation, a record field, a list element, an interpolation hole, a `while`
// condition and a lambda body, over a parameter, a field read and a call result, which is staged
// (`once`, `staged`).
type R = { v: f64 | string }
function mk(k: i32): f64 | string {
  if k == 0 { return 2.0 }
  if k == 1 { return 3.0 }
  return "s"
}
function ret(v: f64 | string) { return v is 2 }
function show(b: boolean) { print(b) }
function main() {
  const a = mk(0)
  const c = mk(2)
  print(a is 2)
  print(c is 2)
  if a is 2 | 3 { print("yes") } else { print("no") }
  if c is 2 | 3 { print("yes") } else { print("no") }
  print(ret(a))
  print(ret(c))
  const l1 = a is 2 | 3
  const l2 = c is 2 | 3
  print(l1)
  print(l2)
  print(if a is 2 { 1 } else { 0 })
  print(if c is 2 { 1 } else { 0 })
  show(a is 2 && true)
  show(c is 2 && true)
  print(!(c is 2))
  print(!(a is 2))
  const r1: R = { v: a }
  const r2: R = { v: c }
  print(r1.v is 2)
  print(r2.v is 2)
  const xs = [a is 2, c is 2]
  print(xs[0])
  print(xs[1])
  print("\{if a is 2 { "t" } else { "f" }}")
  print("\{if c is 2 { "t" } else { "f" }}")
  let n = 0
  let w = mk(0)
  while w is 2 | 3 {
    n = n + 1
    w = mk(n)
  }
  print(n)
  const f = (v: f64 | string) => v is 2
  print(f(a))
  print(f(c))
}
function once() {
  print(mk(0) is 2)
  print(mk(1) is 2)
}
function staged() {
  print(mk(1) is 2 | 3)
  print(mk(2) is 2 | 3)
}
main()
once()
staged()
