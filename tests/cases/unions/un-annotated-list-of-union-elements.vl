// @run
// @log 1
// @log 2
// @log 4
// @log 5
// THE UN-ANNOTATED ARRAY LITERAL OF UNION ELEMENTS, IN EVERY POSITION IT HAS.
//
// `const xs: (Cat | Dog)[] = [pick(true)]` always worked; `const xs = [pick(true)]` wrote a
// module that did not validate. `arrLitIsRef` asks the SYNTAX of the literal's first element —
// an object literal, a lambda, a nested literal, or a checker-recorded element name carrying
// `=>` — and a CALL (`pick(true)`) and an IDENT (`w`) are none of those, so the literal fell
// through to the i32 list while every element stored into it was a union box:
// `expected i32, found (ref $type)`, with `vl check` clean.
//
// The signal was missing on BOTH sides. The checker's `nodeArrayElemName` — the typed-IR query
// that names a literal's recorded element type — had arms for prim / obj / func /
// nullable-closure elements and none for a union, so there was nothing for the classifier to
// read even if it had asked. It has one now, rendering the NOMINAL composite, which is the
// spelling the union's `unNames` row is registered under AND the table key `refArrElemName`
// yields for the annotated `(Cat | Dog)[]` — so the two spellings of one list intern ONE slot.
//
// THE RULE HAS ONE HOME (`arrLitUnionElemName`) BECAUSE THREE CLASSIFIERS NEED IT: `arrLitIsRef`
// (ref list, yes), `arrLitElemKind` (kind 2, the box) and `arrLitElemName` (the slot key). Its
// second gate is `isUName` — the EMITTER's row must exist, since that is what makes the box
// build and its variant tags available at all; a union the checker knows and the emitter never
// registered keeps its loud failure instead of building against a slot that is not there.
type Cat = { meow: i32 }
type Dog = { woof: i32 }

function pick(b: boolean): Cat | Dog {
  if b {
    return { meow: 1 }
  }
  return { woof: 2 }
}

// GLOBAL position — the literal is a module-level binding's init.
const gs = [pick(true)]

// A CALL RESULT element, in a function-local binding.
function callResult() {
  const xs = [pick(true)]
  const e = xs[0]
  if e is Cat {
    print(e.meow)
  }
}

// An IDENT element whose binding is itself un-annotated.
function identElement() {
  const w = pick(false)
  const xs = [w]
  const e = xs[0]
  if e is Dog {
    print(e.woof)
  }
}

// The literal as an INFERRED RETURN — no annotation anywhere on the path.
function mkList() {
  return [pick(true), pick(false)]
}

function returnedList() {
  const xs = mkList()
  const e = xs[1]
  if e is Dog {
    print(e.woof + 2)
  }
}

function globalRead() {
  const e = gs[0]
  if e is Cat {
    print(e.meow + 4)
  }
}

callResult()
identElement()
returnedList()
globalRead()
