// @run
// A value `if` over a union `is` test whose arms are records, bound un-annotated where the narrowed
// arm names no row of its own: an `else if` chain at module scope, a function, a loop body and a
// lambda. Each join is built at its record's row.
type Out = { a: i32 }
type Err = { msg: string }
const r: Out | Err = { a: 3 }
const e: Out | Err = { msg: "no" }
const chained = if e is Out { e } else if r is Out { r } else { { a: -1 } }
print(chained.a)
function inFn(x: Out | Err, d: i32) {
  const q = if x is Out { x } else if d > 0 { { a: d } } else { { a: -1 } }
  return q.a
}
print(inFn(r, 5))
print(inFn(e, 5))
print(inFn(e, 0))
function inLoop(xs: (Out | Err)[]) {
  let t = 0
  for x in xs {
    const q = if x is Out { x } else { { a: 100 } }
    t = t + q.a
  }
  return t
}
print(inLoop([r, e, r]))
const viaFn = (x: Out | Err) => {
  const q = if x is Out { x } else { { a: 11 } }
  return q.a
}
print(viaFn(e))
print(viaFn(r))
// @log 3
// @log 3
// @log 5
// @log -1
// @log 106
// @log 11
// @log 3
