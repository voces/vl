// D14540: twin arms that differ only in a numeric tag share one spelling, and each position that
// reads a field after narrowing on the tag finds the arm by its own type.
type P = { k: 1, n: i32 } | { k: 2, n: i32 }
function mk(b: boolean): P {
  if b { return { k: 2, n: 9 } }
  { k: 1, n: 4 }
}
function two(n: i32) { n + 1 }
function tag(k: i32) { k * 100 }
function show(p: P) {
  if p.k == 1 { print(p.n) } else { print(p.n + 1) }
  if p.k != 1 { print(p.n + 1) } else { print(p.n) }
  match p.k {
    1 => print(p.n)
    2 => print(p.n + 1)
  }
  if p.k == 2 { print(p.n + 1) }
  else if p.k == 1 { print(p.n) }
  else { print(0) }
  if p is { k: 1, n: i32 } { print(p.k) } else { print(p.k + 10) }
  if p is { k: 1, n: i32 } { print(1) } else { print(p.n) }
  if p.k == 2 { print(two(p.n)) } else { print(p.k) }
  print(tag(p.k))
}
show(mk(true))
show(mk(false))
