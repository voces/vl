// @run
// @log 2
// @log 9000000001
// @log 2147483648
// @log 8999999999
// @log 18000000000
// @log -1
// @log -9000000000
// @log true
// @log false
// @log 9000000001
// @log true
// @log 3
// @log -2
// @log 9000000000
// @log 1
// @log 9000000001
// Arithmetic and ordering over a literal union whose integer members span two widths compute at
// the common width `i64`, so the narrow member widens before the operator and cannot overflow at
// `i32` (D3512). A one-width set keeps its base. An un-annotated function returning the set
// lowers as the box its annotated twin does.
type D = 9000000000 | 1
type E = 1 | 2
function pick(n: i32): D {
  if n > 0 { return 9000000000 }
  1
}
function two(): E { 2 }
function inferred(n: i32) { return pick(n) }
const lo = pick(0)
const hi = pick(1)
print(lo + 1)
print(hi + 1)
print(lo + 2147483647)
print(hi - 1)
print(hi * 2)
print(-lo)
print(-hi)
print(lo < 2)
print(hi < 2)
print(lo + hi)
print(hi > lo)
print(two() + 1)
print(-two())
const r = inferred(1)
print(r)
print(inferred(0))
print(inferred(1) + 1)
