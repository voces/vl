// @run
// @log 7
// @log 1.5
// @log 3
// The COMPOSITE-LEAF frontier of a named variant's INLINE-SHAPE field
// (`variant-inline-shape-field.vl` is the axis; this is its reach).
//
// Whether the shape lowers is decided ENTIRELY by `variantNestedShapeOk`, which recurses the
// shape's own fields through `nameFieldCode` — the same acceptance the INLINE-ARM recorder
// has always applied. So the leaf kinds a named variant's inline shape supports are exactly
// the ones an inline ARM's are, and this file pins the three that carry a REP rather than a
// scalar: a NULLABLE shape field, an f64 leaf, and an i32-list leaf. Each was
// `only i32 / boolean / string / array union-variant fields are supported` before, from the
// OUTER field's -1 — never from the leaf, which is why the leaf kind was measured as its own
// dimension and found not to be the axis.
//
// THE MAP LEAF IS DELIBERATELY ABSENT AND ITS ABSENCE IS A MEASUREMENT, NOT AN OVERSIGHT.
// `{m: {mp: {[string]: i32}}}` CONSTRUCTS here (it floored before), but writing then reading
// through the narrowed arm reports `bare null needs a struct-typed context`. That is not this
// seam: the UNNESTED control `type Mappy = {mp: {[string]: i32}}` — a map field written
// directly on the variant, no inline shape anywhere — reports the identical message, and so
// does the INLINE-ARM spelling, both before this change and after. Adding the cell here would
// pin an unrelated map-in-narrowed-arm floor to this file's name.
type Opt = { a: { b: i32 } | null }
type UO = Opt | i32

type Wide = { f: { g: f64 } }
type UW = Wide | i32

type Listy = { l: { xs: i32[] } }
type UL = Listy | i32

const o: UO = { a: { b: 7 } }
if o is Opt {
  // The field is nullable — guard before the member access.
  const q = o.a
  if q != null { print(q.b) } else { print(-1) }
} else { print(0) }

const w: UW = { f: { g: 1.5 } }
if w is Wide { print(w.f.g) } else { print(0) }

const l: UL = { l: { xs: [1, 2, 3] } }
if l is Listy { print(l.l.xs.length) } else { print(0) }
