// D5921: an un-annotated binding of a value union narrowed to two or more of its members takes
// the narrowed box, at every spelling of the narrowing and every use of the binding; a captured
// copy narrowed to `boolean | null` takes the niche (D5960), a reassigned narrowed `let` read
// by a closure returns its box (D3151), and a copy of a null-narrowed box reads its arms (D2875).
function viaIs(k: string | i32 | f64) {
  if k is string { return 1.0 }
  const rest = k
  if rest is i32 { return 2.0 }
  rest + 0.5
}
function captured(k: string | i32 | f64) {
  if k is string { return 1.0 }
  const rest = k
  const g = (): f64 => {
    if rest is i32 { return 2.0 }
    rest + 0.5
  }
  g()
}
function reassigned(k: string | i32 | f64, j: i32 | f64) {
  if k is string { return 1.0 }
  let rest = k
  rest = j
  if rest is i32 { return 2.0 }
  rest + 0.5
}
function viaLit(k: "a" | i32 | f64) {
  if k == "a" { return 1.0 }
  const rest = k
  if rest is i32 { return 2.0 }
  rest + 0.5
}
function viaNull(k: i32 | f64 | null) {
  if k == null { return 1.0 }
  const rest = k
  if rest is i32 { return 2.0 }
  rest + 0.5
}
function viaMatch(k: string | i32 | f64) {
  match k {
    string => 1.0
    _ => {
      const rest = k
      if rest is i32 { return 2.0 }
      rest + 0.5
    }
  }
}
function four(k: string | i32 | f64 | boolean) {
  if k is string { return 1.0 }
  const rest = k
  if rest is boolean { return 3.0 }
  if rest is i32 { return 2.0 }
  rest + 0.5
}
function coalesce(k: string | i32 | null) {
  if k is string { return 1 }
  const rest = k
  rest ?? 7
}
function coalesceF(k: i32 | f64 | null) {
  if k is i32 { return 2.0 }
  const rest = k
  rest ?? 7.5
}
function negThen(k: string | i32 | f64) {
  if !(k is string) {
    const rest = k
    if rest is i32 { return 2.0 }
    return rest + 0.5
  }
  1.0
}
function copyOfCopy(k: string | i32 | f64) {
  if k is string { return 1.0 }
  const a = k
  const rest = a
  if rest is i32 { return 2.0 }
  rest + 0.5
}
function matchRest(k: string | i32 | f64) {
  if k is string { return 1.0 }
  const rest = k
  match rest {
    i32 => 2.0
    f64 => rest + 0.5
  }
}
const str = "s"
const lit = "a"
print("\{viaIs(1)} \{viaIs(1.25)} \{viaIs(str)}")
print("\{captured(1)} \{captured(1.25)}")
print("\{reassigned(1, 3)} \{reassigned(1.25, 1.25)}")
print("\{viaLit(1)} \{viaLit(1.25)} \{viaLit(lit)}")
print("\{viaNull(1)} \{viaNull(1.25)} \{viaNull(null)}")
print("\{viaMatch(1)} \{viaMatch(1.25)} \{viaMatch(str)}")
print("\{four(1)} \{four(1.25)} \{four(true)}")
print("\{coalesce(3)} \{coalesce(null)}")
print("\{coalesceF(1.75)} \{coalesceF(null)}")
print("\{negThen(1)} \{negThen(1.25)}")
print("\{copyOfCopy(1)} \{copyOfCopy(1.25)}")
print("\{matchRest(1)} \{matchRest(1.25)}")
function mk(n: i32): string | i32 | f64 {
  if n == 0 { return "s" }
  if n == 1 { return 1 }
  1.25
}
const k = mk(2)
if !(k is string) {
  const rest = k
  const g = () => print(rest)
  g()
}
function pickB(n: i32): string | boolean | null {
  if n == 0 { return "s" }
  if n == 1 { return true }
  null
}
function capturedNiche(n: i32) {
  const x = pickB(n)
  if !(x is string) {
    const v = x
    const g = () => print(v == null)
    g()
  }
}
capturedNiche(1)
capturedNiche(2)
function relet(v: i32 | null | string) {
  if !(v is string) {
    let c = v
    c = null
    print(c == null)
    c = 4
    const f = () => c
    print(f())
  }
}
relet(7)
function mkn(b: boolean): string | i32 | null {
  if b { return "a" }
  3
}
const u = mkn(false)
if u != null {
  const t = u
  if t is string { print(t) } else { print(t + 1) }
}
