// @run
// @log true
// @log null
// @log 5
// @log false
// @log null
// A `boolean | null` delivered into a wider union that admits `null` keeps its null: the niche is
// tested on its value (2 is its null), and boxed as the union's null or as its boolean.
function show(y: boolean | i32 | null) {
  if y == null { print("null") }
  else if y is boolean { print(y) }
  else { print(y + 1) }
}
function pass(d: boolean | null) { show(d) }
function bind(d: boolean | null) {
  const k: boolean | string | null = d
  if k == null { print("null") }
  else if k is boolean { print(k) }
  else { print(k) }
}
pass(true)
pass(null)
show(4)
bind(false)
bind(null)
