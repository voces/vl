// @run
// @log hi
// @log 2.5
// @log x
// D1013 — A LOCAL BOUND FROM AN ALREADY-NARROWED UNION READ. `const a = v` inside
// `if v is string` returned 0 from `vl check` and did not load.
//
// The local was correct in the bytes — declared `(ref $4)` and filled by a proper
// `ref.cast` — and `print` took `__print_i32__` anyway. `unionIdentReadKind(a)` answered
// **-2**, meaning "a union binding with no narrowing of its own", and `exprString` read that
// as `-2 == 2`, false. But `a` does not hold a BOX: the init was already narrowed, so it
// holds the atom. It now inherits the init's narrowed atom, one level only.
//
// Annotating the binding (`const a: string = v`) always ran, which is what made this look
// like an annotation defect rather than an inheritance one.
//
// BOTH SCOPES. Inside a function the binding is found through the enclosing body; at MODULE
// scope `const a = v` inside a top-level `if` is neither a global nor in any FuncDecl body —
// it lives in the START function's locals — so the declaration is scanned for directly. The
// function-scoped spelling was fixed first and the module one still failed, which is the same
// split that cost four probes on D1015; keep both here.
//
// TWO THINGS THAT ARE NOT THE FIX, both measured: forcing `emitPrintStrExpr` at the print
// site does NOT work on its own — the string scratch frame is allocated at COLLECTION time
// from the same classifier, so the dispatch and the frame have to agree — and forcing
// `exprString` true for the INIT `v` changes nothing, because the chain from `a` to `v` was
// never walked at all.
type K = f64 | string

function g(v: K) {
  if v is string {
    const a = v
    print(a)
  }
}

function h(v: K) {
  if v is f64 {
    const b = v
    print(b)
  }
}

g("hi")

h(2.5)

type M = f64 | string

const mv: M = "x"

if mv is string {
  const ma = mv
  print(ma)
}
