// @run
// @log 9
// D14540, the bare read: the else arm prints the narrowed field with no arithmetic.
type P = { k: "a", n: f64 } | { k: "b", n: i32 }
function mk(b: boolean): P {
  if b { return { k: "b", n: 9 } }
  { k: "a", n: 1.5 }
}
const p = mk(true)
if p.k == "a" { print(p.n) } else { print(p.n) }
