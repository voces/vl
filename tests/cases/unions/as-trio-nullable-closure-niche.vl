// @run
// @log 9
// @log true
// @log false
// @log 6
// @log -1
// @log 15
// The `as` trio over a nullable function value: `as!` hands back the closure, `as?` keeps the
// nullable, and the propagating `as` returns the enclosing function's null on a miss (D16067).
function mf(k: i32): ((i32) => i32) | null {
  if k > 0 { return (n: i32) => n * k } else { return null }
}
const g = mf(3) as! (i32)=>i32
print(g(3))
function has(k: i32): boolean {
  const h = mf(k) as? (i32)=>i32
  return h != null
}
print(has(1))
print(has(0))
function twice(k: i32): i32 | null {
  const h = mf(k) as (i32)=>i32
  return h(2)
}
print(twice(3) ?? 0)
print(twice(0) ?? -1)
function plusBase(base: i32): i32 | null {
  const h: ((i32) => i32) | null = (n: i32) => n + base
  return (h as (i32)=>i32)(5)
}
print(plusBase(10) ?? 0)
