// @run
// @log 7
// @log 1
// @log 2
// @log 3
// @log 4
// The `: Circle` annotation IS the cell under test — it is what makes the global a kind-8
// variant rather than a box — so its redundancy hint is declared rather than removed.
// @hint redundant type annotation: `v` is inferred as `{r: i32}`
// Regression (silent-class-inventory D200), and the five cells are the five BOX-typed
// destinations one arm-annotated module global reaches. Cell 1 is the row's own filed
// witness and the generated cell `q00017` of `scripts/silent-sweep/d243/genbox.py --block Q`;
// the other four are `q00049`, `q00065`, `q00081` and `q00097` of the same block. All five
// are `check-clean invalid wasm` on `322c07f2`, and the row filed only the first — the
// destination axis had never been crossed against the storage class.
//
// THE ONE READER THAT WAS NOT KIND-GATED. `declaredStructIndex` gates on `localIsRef[slot]`,
// `capturedStructIndex` on `capturedKindOf`, and this reader's own VARIANT sibling
// `globalVariantIndexSid` states the contract for the pair — "gated on the cell actually
// BEING the kind-8 variant so the two never both answer for one binding". With only one half
// gated the two DID both answer: `structIndexOfLet`'s arena rung found `Dot`'s row for a
// `: Circle` cell, `emitUnionBoxArg`'s layout-twin test compared `sHeapIdx[Dot]` against
// `uVarHeap[Circle]` — two namespaces on purpose — and re-emitted the value field by field
// FROM `Dot`'s heap type: `struct.get $Dot 0` applied to a `(ref $uVarHeap[Circle])`.
//
// THE LAYOUT TWIN IS THE DISGUISE, NOT THE ROOT. Delete `type Dot` and every one of these
// five RUNS on the merge base — the struct scan then answers -1 and the raw box is taken —
// which is exactly why the row is silent rather than loud and why a no-twin corpus could
// never contain it.
//
// WHAT IS NOT CLOSED, so this file is not read as covering it: the same five destinations
// fed by a CALL rather than by a global (`mkc(): Circle`) are still `check-clean invalid
// wasm`, because `structIndexOfExpr`'s CALL arm reaches the twin through its own arena rung
// and not through this reader. That residue is filed as D267.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Dot = { r: i32 }

function area(s: Shape) { if s is Circle { return s.r } else { return 0 } }
const v: Circle = { r: 7 }
print(area(v))

let g: Shape = { s: 0 }
g = v
if g is Circle { print(1) } else { print(0) }

const u: Shape = v
if u is Circle { print(2) } else { print(0) }

const xs: Shape[] = [v]
const x0 = (xs)[0]
if x0 is Circle { print(3) } else { print(0) }

const m: {[string]: Shape} = Map()
m["k"] = v
const mv = (m)["k"] ?? { s: 0 }
if mv is Circle { print(4) } else { print(0) }
