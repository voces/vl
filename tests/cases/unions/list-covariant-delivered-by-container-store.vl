// @run
// @log 7
// @log 7
// @log 7
// @log 1
// @hint redundant type annotation: `firstR` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `a` is inferred as `{r: i32}[]` — remove it to lean on inference
// The destinations are `readonly`: only a readonly list is covariant, and a mutable one is
// refused (DECISIONS.md "No implicit container widening").
// A covariant list stored into a container (D1628).
//
// Each literal delivery has an assignment twin — `w.f = b`, `xs[i] = b`, `m[k] = b` — and
// `xs.push(b)` is the element store with no place expression of its own. All four are the
// same escape, filed under the container's once-bound name plus a field or element key, and
// claimed only into a sealed container so the write scan reads every handle back out.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box = { xs: readonly Shape[] }

function firstR(v: readonly Shape[]): i32 {
  const e = v[0]
  if e is Circle { return e.r }
  0
}

function f() {
  const a: Circle[] = [{ r: 7 }]
  const b: readonly Shape[] = a
  const w: Box = { xs: [] }
  w.xs = b
  const nn: (readonly Shape[])[] = []
  nn.push(b)
  const m: { [string]: readonly Shape[] } = Map()
  m["k"] = b
  print(firstR(w.xs))
  print(firstR(nn[0]))
  const mv = m["k"]
  if mv != null { print(firstR(mv)) }
}

function other() {
  const z: Shape[] = []
  z.push({ s: 3 })
  print(z.length)
}

f()
other()
