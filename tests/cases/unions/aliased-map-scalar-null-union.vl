// @run
// @log true
// @log false
// @log 5
// @log true
// @log true
// @log false
// @log true
// D2659: an aliased union of a map, a scalar and `null` is a box at a module and a local
// binding, holding each member.
type Rec = { x: i32 }
type U = {[string]: Rec} | i32 | null
const m0: {[string]: Rec} = Map()
m0["k"] = { x: 5 }
let gl: U = 42
print(gl is i32)
gl = m0
print(gl is i32)
if gl is {[string]: Rec} {
  const e = gl["k"]
  if e != null { print(e.x) }
}
gl = null
print(gl == null)
function h() {
  let l: U = 7
  print(l is i32)
  l = m0
  print(l is i32)
  l = null
  print(l == null)
}
h()
