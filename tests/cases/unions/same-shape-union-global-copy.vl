// @run
// @log 4
// @log 4
// A same-shape `Pa | Pb` is the record `Pa` (D3870), so an un-annotated module global copied
// from it, or read out of an `(Pa | Pb | null)[]`, is that record and its field reads (D4998).
type Pa = { tag: i32, val: i32 }
type Pb = { tag: i32, val: i32 }
function pick(n: i32): Pa | Pb {
  const b: Pb = { tag: 2, val: n }
  return b
}
const g = pick(4)
const v = g
print(v.val)
const xs: (Pa | Pb | null)[] = [pick(4)]
const w = xs[0]
if w != null { print(w.val) }
