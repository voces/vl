// @run
// D1733 — `print` of a DIRECT if-expression join. `exprUnion`'s if-expression arm asked the
// THEN arm alone, and neither arm of `if c { "green" } else { 7 }` is a union, so the value
// classified as a string and reached `__print_i32__` with a ref on the stack.

// The join is the node's own recorded type, which is what the arm now asks. The BOUND
// spelling is the control: it always ran, and is what proves the join has a rep at all.

// @log green
// @log green
// @log 7
// @log green
// @log 7

// The last destination is annotated deliberately: it is the third spelling of the same join,
// and inference would make it the second one over again.
// @hint redundant type annotation: `d` is inferred as `string | i32` — remove it to lean on inference

type U = string | i32

const c = true
const no = false

// the bound spelling, which ran before this and must keep running
const b = if c { "green" } else { 7 }
print(b)

// the direct argument, at both arm orders and with either arm taken
print(if c { "green" } else { 7 })
print(if no { "green" } else { 7 })
print(if no { 7 } else { "green" })

// and through an annotated destination, which pins the same box
const d: U = if no { "green" } else { 7 }
print(d)
