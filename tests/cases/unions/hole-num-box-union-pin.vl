// @run
// @log 5000000001
// @log 5000000000
// @log 3
// @log three
// @log 7
// @log 5000000000
// @log 5000000000
// @log 5000000000
// D16708: an un-annotated parameter bound at numbers of no one base (`5000000000 | i32`) is the
// box an annotation or a type parameter takes, so its reads, `print`, `==` and `+` open it.
type W = 1 | 2 | 5000000000
const wn: W = 5000000000
function orZero(f) { return f() ?? 0 }
function take(a) {
  const v = a
  if v == 5000000000 { print(v + 1) } else { print("miss") }
}
take(orZero(() => wn))
function show(a) { print(a) }
const u: 5000000000 | i32 = 5000000000
const s: 5000000000 | i32 = 3
show(u)
show(s)
function three(a) { if a == 3 { print("three") } else { print(a) } }
const t3: 3 | i64 = 3
const t7: 3 | i64 = 7
three(t3)
three(t7)
function orNone(a) { print(a ?? 0) }
const n: 5000000000 | i32 | null = 5000000000
orNone(n)
function showAnn(a: 5000000000 | i32) { print(a) }
function showGen<T>(a: T) { print(a) }
showAnn(u)
showGen(u)
