// @run
// @log true
// @log false
// @log true
// @log true
// @log false
// @log true
// @log true
// @log false
// @log true
// @log false
// @log true
// @log false
// @log true
// @log false
// @log true
// @log true
// @log true
// @log false
// @log true
// @log false
// @log false
// @log true
// @log false
// @log true
// @log false
// @log true
// @log false
// @log true
// @log false
// @log false
// @log true
// @hint redundant type annotation: `f0` is inferred as `i32`
// @hint redundant type annotation: `g0` is inferred as `i32`
// @hint redundant type annotation: `f1` is inferred as `i32`
// @hint redundant type annotation: `g1` is inferred as `i32`
// @hint redundant type annotation: `f2` is inferred as `i32`
// @hint redundant type annotation: `g2` is inferred as `i32`
// D1098: a union arm that is a closure, compared by function identity (`===`, DECISIONS A15).
// A closure arm tags by signature (`cloArmTagOfTy`, `cloSigSlotTag`): the first signature a
// module interns keeps the kind-11 offset and each further one claims the band above. A compare
// reading the flat offset is right for one closure-armed union per module and wrong for the
// second, a wrong answer or a `ref.cast` trap, so the three-signature and two-closure-arm
// sections below are the pin, each row the same function, another, and the other arm.
function f0(): i32 { 7 }
function g0(): i32 { 8 }
function f1(v: i32): i32 { v }
function g1(v: i32): i32 { v + 1 }
function f2(v: i32, w: i32): i32 { v + w }
function g2(v: i32, w: i32): i32 { v * w }

// ── THREE SIGNATURES across three closure-armed unions in one file: each union's compare
//    has to test the tag its own box writes ─────────────────────────────────────────────
type U01 = (() => i32) | ((i32) => i32)
type U12 = ((i32) => i32) | ((i32, i32) => i32)
type U20 = ((i32, i32) => i32) | (() => i32)
function u01(n: i32): U01 {
  if n == 0 { return f0 }
  if n == 1 { return f1 }
  g1
}
function u12(n: i32): U12 {
  if n == 0 { return f1 }
  if n == 1 { return f2 }
  g2
}
function u20(n: i32): U20 {
  if n == 0 { return f2 }
  if n == 1 { return f0 }
  g0
}
const a = u01(0)
const ab = u01(0)
const a1 = u01(1)
const b = u12(1)
const bb = u12(1)
const b2 = u12(2)
const c = u20(1)
const cb = u20(1)
const c2 = u20(2)
print(a === f0)
print(a === g0)
print(f0 === a)
print(a === ab)
print(a === a1)
print(a !== a1)
print(b === f2)
print(b === g2)
print(b === bb)
print(b === b2)
print(c === f0)
print(c === g0)
print(c === cb)
print(c === c2)
print(c2 === g0)

// ── TWO CLOSURE ARMS IN ONE UNION: the TAG has to pick the arm, and the two
//    signatures claim different slots ────────────────────────────────────────
function pick(n: i32): (() => i32) | ((i32) => i32) {
  if n == 0 { return f0 }
  if n == 1 { return f1 }
  g1
}
const p0 = pick(0)
const p1 = pick(1)
const p2 = pick(2)
const p1b = pick(1)
print(p0 === f0)
print(p1 === f1)
print(p1 === g1)
print(p1 === p1b)
print(p1 === p2)
print(p0 === p1)

// ── A CAPTURING closure: identity is (id, env), so two closures built by ONE
//    lambda from different frames must compare UNEQUAL ─────────────────────────
function mkAdder(k: i32): (i32) => i32 {
  (v: i32) => v + k
}
function boxIt(n: i32, f: (i32) => i32): ((i32) => i32) | (() => i32) {
  if n == 0 { return f0 }
  f
}
const add1 = mkAdder(1)
const add2 = mkAdder(2)
const k1 = boxIt(1, add1)
const k1b = boxIt(1, add1)
const k2 = boxIt(1, add2)
print(k1 === add1)
print(k1 === add2)
print(k1 === k1b)
print(k1 === k2)

// ── A closure arm beside a RECORD arm (D16039): each arm compares by its own identity, the
//    record by `ref.eq`, so a structurally equal record built elsewhere is not identical ──
type CS = { x: i32 }
function mix(n: i32): (() => i32) | CS {
  if n == 0 { return { x: 3 } }
  f0
}
const m0 = mix(0)
const m1 = mix(1)
const csSame: CS = { x: 3 }
print(m1 === f0)
print(m0 === csSame)
print(m0 === m0)
print(m1 === csSame)
print(m0 === m1)
print(m1 === mix(1))
