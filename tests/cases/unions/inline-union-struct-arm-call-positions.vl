// A struct produced by a CALL, lowered into an INLINE union position — return, binding and
// argument. Every one of them was `emitProgram: ref valtype with no interned shape` (#1803);
// the object-LITERAL spelling at the same union site always worked, which is why this read as
// a call-lowering bug rather than a type-interning one.
//
// It is neither. Two registries hold "this declared struct is a union variant" and only one
// route fed both. `collectU` puts `IoError` in the EMITTER's `uVariants` for both spellings (a
// `UnionDecl` directly, an inline annotation through `collectInlineUnions`), and `collectS`
// SKIPS a `TypeDecl` the emitter calls a variant — so `IoError` gets no standalone struct row.
// The CHECKER's `cVariantMemberTyIxs`, which `rtOfObj`'s discriminator and `nodeTyIsVariant`
// both read, was filled by the `UnionDecl` arm alone. So for the inline spelling every
// `IoError` position classified `"struct"` while `retStructIndex` handed back a VARIANT index
// beside it, and `fbValtype` indexed `sHeapIdx` with a `uVariants` row.
//
// The literal control worked because a literal needs no such position: `pendingVariantIdx`
// builds the bare variant from context. `unions/declared-union-struct-arm-call-positions.vl`
// is the same program under `type IoResult = string | IoError`, the spelling that already ran.
// @run
// @log 1
// @log 2
// @log 3
// @log 4
// @log lit
type IoError = { code: i32, msg: string }
function ioErr(c: i32): IoError { return { code: c, msg: "e" } }
// (1) a call into a union RETURN
function read(): string | IoError { return ioErr(1) }
// (2) a call into a union-annotated LOCAL binding
function bind() {
  const r: string | IoError = ioErr(2)
  if r is IoError { return r.code }
  0
}
// (3) a call into a union ARGUMENT
function take(u: string | IoError) {
  if u is IoError { return u.code }
  0
}
// (4) a call into a union-annotated module GLOBAL — #1800's cell, reached through the INLINE
// spelling (its own fixture, `unions/call-struct-arm-into-union-global-cell.vl`, uses a
// declared alias).
const gb: string | IoError = ioErr(4)
// CONTROL — an object LITERAL at the union site, which lowered before the fix too.
function lit(): string | IoError { return { code: 9, msg: "lit" } }
const r0 = read()
if r0 is IoError { print(r0.code) } else { print(r0) }
print(bind())
print(take(ioErr(3)))
if gb is IoError { print(gb.code) } else { print(gb) }
const r1 = lit()
if r1 is IoError { print(r1.msg) } else { print(r1) }
