// @run
// @log z
// @log z
// @log 7
// @log z
// @log w
// @log 1.5
// An un-annotated binding of a value `if` whose arm is a list-union name narrowed to one member
// holds that member's list, as the join is typed, not the union box the name has (D2892).
function mk(b: boolean): string[] | i32[] {
  if b { return ["z"] }
  [7]
}
const v = mk(true)
const q = if v is string[] { v } else { ["w"] }
print(q[0])
const v2 = ["y"]
const e = if v is string[] { v } else { v2 }
print(e[0])
const n = mk(false)
const k = if n is i32[] { n } else { [0] }
print(k[0])
function f(x: string[] | i32[]) {
  const q2 = if x is string[] { x } else { ["w"] }
  print(q2[0])
}
f(["z"])
f([1])
function mf(b: boolean): f64[] | string[] {
  if b { return [1.5] }
  ["s"]
}
const fv = mf(true)
const fq = if fv is f64[] { fv } else { [0.5] }
print(fq[0])
