// @run
// @log 0
// @log 0
// @log 5
// @log 5

// A union of a map arm and a list arm, delivered an empty list literal. The literal's element
// type renders as nothing, so a rep decision that renders the type and parses the spelling sees
// no list where the type has one.

type J = { [string]: i32 } | string[]

function g(u: J) {
  if u is string[] { print(u.length) } else { print(u["k"] ?? 3) }
  if u is { [string]: i32 } { print(u["k"] ?? 4) }
}

function h(u: { [string]: i32 } | i32[]) {
  if u is i32[] { print(u.length) } else { print(u["k"] ?? 0) }
}

g([])
h([])
const m: { [string]: i32 } = Map()
m["k"] = 5
g(m)
