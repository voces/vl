// @run
// @log true
// @log false
// @log true
// @log 2
// The un-annotated face of D4340: the `K | E` value reaches the compare through an inferred
// binding, a record field and a list element, none of them spelling the union at the use.
type E = { code: i32 }
type K = "a" | "b"
type H = { k: K | E }
function mk(n: i32): K | E {
  if n == 0 { return "b" }
  return { code: n }
}
const v = mk(0)
print(v == "b")
const h: H = { k: mk(4) }
print(h.k == "b")
const xs = [mk(4), mk(0)]
print(xs[1] != "a")
let hits = 0
for x in xs {
  if x != "a" { hits = hits + 1 }
}
print(hits)
