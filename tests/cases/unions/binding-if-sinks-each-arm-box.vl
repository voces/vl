// @run
// @log big
// @log int
// @log on
// @log null
// A union binding initialised by an `if` whose every arm builds its box writes each arm into one
// tag-and-payload pair and builds the box once after the `if`: an `else if` chain, and an
// else-less `if` whose missing arm is `null`.
type U = i32 | string
function pick(c: i32): U {
  const r: U = if c > 1 { "big" } else if c > 0 { 1 } else { 0 }
  return r
}
function opt(c: boolean): U | null {
  const r: U | null = if c { "on" }
  return r
}
function show(u: U | null): string {
  if u == null { return "null" }
  if u is string { return u }
  return "int"
}
print(show(pick(2)))
print(show(pick(1)))
print(show(opt(true)))
print(show(opt(false)))
