// @run
// @log b
// @log c
// @log false
// A nullable union of two literal aliases narrows to one alias, delivers into `string | null` at
// a binding, and widens into a union with a record arm (D3134, D3382, D4041).
type K = "a" | "b"
type J = "c" | "d"
type U = "a" | "b" | null | { tag: i32 }
function t(v: K | J | null) {
  if v is K { print(v) }
}
t("b")
function g(): K | J | null { return "c" }
const s: string | null = g()
print(s ?? "n")
const a: ("a" | "b") | null = "a"
const u: U = a
print(u == null)
