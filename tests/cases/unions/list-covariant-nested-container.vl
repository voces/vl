// @run
// @log 7
// @log 1
// @log 1
// @hint redundant type annotation: `a` is inferred as `{r: i32}[]` — remove it to lean on inference
// @hint redundant type annotation: `o` is inferred as `{inn: {xs: Shape[]}}` — remove it to lean on inference
// A read-only covariant list inside a container nested in another literal (D1682).
//
// The inner `{ xs: b }` initialises no binding either; it is reached through the ENCLOSING
// container's own key, so the escape is filed under `o` at the path `inn.xs` and `o.inn.xs`
// matches it. The path is what the write scan reads too — give the intermediate a name of
// its own (`const q = o.inn`) and the container is unmodelled again, which is the residue.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box = { xs: Shape[] }
type Outer = { inn: Box }

function f() {
  const a: Circle[] = [{ r: 7 }]
  const b: Shape[] = a
  const o: Outer = { inn: { xs: b } }
  const e = o.inn.xs[0]
  if e is Circle { print(e.r) }
  print(a.length)
}

function other() {
  const w: Shape[] = []
  w.push({ s: 3 })
  print(w.length)
}

f()
other()
