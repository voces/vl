// @run
// @log true
// @log 2
// @log {"lines":["a","b"]}
// @hint redundant type annotation: `lines` is inferred as `string[]` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// DV-1202 (D4038): the copy the refusal names runs, into a recursive alias and into a map of
// `Json`.
import { Json, toJson } from "std:json"

type J = null | string | J[]

function lines(): string[] { ["a", "b"] }

function optionJson(): Json {
  const o: { [string]: Json } = Map()
  o["lines"] = lines().map((x): Json => x)
  o
}

const ys = ["a", "b"]
const k: J = ys.map((x): J => x)
print(k is J[])
if k is J[] { print(k.length) }
const s = toJson(optionJson())
if s is string { print(s) } else { print(s.msg) }
