// @run
// @log 1
// @log true
// @log 1
// @log false
// @log true
// @log 2
// @log 2
// @log true
// @log b
// @log true
// @log 2
// @log true
// @log true
// @log 3
// A closure in a deep `is` arm that writes the tested place ends the narrowing where the checker
// says it does, at a call that may run the write: reads before it see the converted copy, the
// closure's own body and the reads after see the place itself (D16274).
type Json = null | boolean | f64 | string | Json[] | { [string]: Json }

function run(f: () => null) {
  f()
  1
}

function before(r: Json) {
  if r is string[] {
    const n = r.length
    const clear = () => {
      r = null
    }
    clear()
    return n
  }
  0
}

function made(r: Json) {
  if r is string[] {
    const clear = () => {
      r = null
    }
    const n = r.length
    clear()
    print(r == null)
    return n
  }
  0
}

function readsInWriter(r: Json) {
  if r is string[] {
    const clear = () => {
      print(r == null)
      r = null
    }
    const n = r.length
    clear()
    print(r == null)
    return n
  }
  0
}

function reader(r: Json) {
  if r is string[] {
    const clear = () => {
      r = null
    }
    const f = () => r.length
    print(f())
    clear()
    print(r == null)
  }
  0
}

function aliased(r: Json) {
  if r is string[] {
    const clear = () => {
      r = null
    }
    const g = clear
    print(r[1])
    g()
    print(r == null)
  }
  0
}

function inner(r: Json) {
  if r is string[] {
    const a = () => {
      const b = () => {
        r = null
      }
      b()
    }
    print(r.length)
    a()
    print(r == null)
  }
  0
}

function branch(r: Json) {
  if r is string[] {
    const clear = () => {
      r = null
    }
    if r.length > 1 { clear() }
    print(r == null)
  }
  0
}

function sameStatement(r: Json) {
  if r is string[] {
    const clear = () => {
      r = null
    }
    return r.length + run(clear)
  }
  0
}

print(before(["a"]))
print(made(["a"]))
print(readsInWriter(["a", "b"]))
reader(["a", "b"])
aliased(["a", "b"])
inner(["a", "b"])
branch(["a", "b"])
print(sameStatement(["a", "b"]))
