// D1461 — a literal-union ALIAS discriminant beside its own BASE: `{kind: K1}` next to
// `{kind: string}`. The owner's 2026-09-02 amendment rules the pair legal — `is A` compares
// the value, `is B` is the tag test alone, because B's set is the whole base — and the checker
// agreed; the emitter refused, because an alias reps as the interned atom and an arbitrary
// string has no interned id at all.
//
// UNIFIED ON THE STRING SIDE, which is the direction D1050 left open and the ONLY one this
// pair has: the atom is the rep the two arms cannot share. `demoteLitFieldToString` puts the
// alias arm's row exactly where a declared INLINE set's row already sits — code 3, the
// member-set spelling in the elem-name column, the set's arena type in the sidecar — which is
// why the four mirror consumers needed no new arm. The wasm is the check: both arms share
// `(type $0 (struct (field (mut (ref <the string struct>))) (field (mut f64))))`.
//
// AND `K1` KEEPS THE ATOM EVERYWHERE ELSE. That was the standing objection to this direction —
// that it would give the alias a rep the rest of the module does not use for it. It does not:
// only the FIELD moves, and an atom-typed destination narrows the read back through
// `emitStrToAtom`. `takesK` below is the pin — its param is the i32 atom, so `takesK(a.kind)`
// is a real conversion, and printing `circle` rather than an id is what proves it happened.
// @hint redundant type annotation: `takesS` is inferred as `string` — remove it to lean on inference
// @hint redundant type annotation: `v` is inferred as `{kind: string, r: f64}` — remove it to lean on inference
// @hint redundant type annotation: `ka` is inferred as `K1` — remove it to lean on inference
// @hint redundant type annotation: `ks` is inferred as `K1[]` — remove it to lean on inference
// @hint redundant type annotation: `kk` is inferred as `K1` — remove it to lean on inference
// @run
// @log A:circle
// @log A:round
// @log B:zz
// @log true
// @log true
// @log true
// @log false
// @log circle
// @log circle
// @log circle
// @log circle
// @log true
// @log round
// @log round
// @log 7
// @log zz

type K1 = "circle" | "round"
type A = { kind: K1, r: f64 }
type B = { kind: string, r: f64 }

function f(n: i32): A | B {
  if n == 0 { return { kind: "circle", r: 1.0 } }
  if n == 1 { return { kind: "round", r: 3.0 } }
  const v: B = { kind: "zz", r: 2.0 }
  return v
}

let i = 0
while i < 3 {
  const x = f(i)
  if x is A { print("A:" + x.kind) } else { print("B:" + x.kind) }
  i = i + 1
}

// `is` is asymmetric here and that asymmetry IS the rule: a `circle` is an `A` and also a `B`
// (B's set is the whole base), while `"zz"` is a B and not an A.
const a = f(0)
const b = f(2)
print(a is A)
print(a is B)
print(b is B)
print(b is A)

// The ALIAS arm's field at every ATOM-typed destination — each one a string -> atom narrow.
function takesK(k: K1): K1 { k }
function takesS(s: string): string { s }
if a is A {
  const ka: K1 = a.kind
  print(ka)
  print(takesK(a.kind))
  print(takesS(a.kind))
  const ks: K1[] = [a.kind]
  print(ks[0])
  print(a.kind == "circle")
} else {
  print("notA")
}

// An `A` built OUTSIDE the union, read, and delivered back INTO it: the declared struct row
// moved with the variant row, so the two share one heap type.
const s: A = { kind: "round", r: 7.0 }
print(s.kind)
const kk: K1 = s.kind
print(kk)
function box(v: A | B): A | B { v }
const t = box(s)
if t is A { print(t.r) } else { print(0.0) }

// The BASE arm holds an arbitrary string, which is the value that grades the rule.
if b is B { print(b.kind) } else { print("notB") }
