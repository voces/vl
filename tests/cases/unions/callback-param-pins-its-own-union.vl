// @run
// @log 5
// @log 2
// @log true
// @log false
// @log 1
// @log true
// @log true
// @log 1.5
// An un-annotated callback parameter over a union takes the members of its OWN union, not
// those of another union the module declares first (D3039). `mk` is that other union: under
// it `w is i64` would be impossible and fold to a constant.
function mk(): string | f64 { return 1.5 }
const z: (string | i64)[] = [5, "t"]
for v in z.filter((w) => w is i64) { print(v) }
print(z.length)
for b in z.map((w) => w is i64) { print(b) }
print(z.filter((w) => !(w is string)).length)

function ap<T>(x: T, f: (T) => boolean) { return f(x) }
const u: string | i64 = 5
print(ap(u, (w) => w is i64))
const g: (string | i64) => boolean = (w) => w is i64
print(g(u))
print(mk())
