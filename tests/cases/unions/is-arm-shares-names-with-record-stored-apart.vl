// @run
// @log 7
// @log true
// @log 3
// @log s
// @log 8
// @log 5
// D8320: a union whose record arm another union's record shares field names with, but stores
// a field differently, narrows under `is`: a value stored apart never sits in it. Binding,
// parameter and list-element receivers.
type J = { r: i32 }
type N = { r: i32 | null }
const a: J | string = { r: 5 }
const b: N | string = { r: 7 }
if b is N {
  const v = b.r
  print(v ?? 0)
  print(b.r != null)
}
function f(x: N | string) {
  if x is N { print(x.r ?? 0) } else { print(x) }
}
f({ r: 3 })
f("s")
const xs: (N | string)[] = [{ r: 8 }, "t"]
for x in xs {
  if x is N { print(x.r ?? 0) }
}
if a is J { print(a.r) }
