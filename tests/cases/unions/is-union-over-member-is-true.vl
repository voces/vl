// @run
// @log true
// @log 4
// @log true
// @log 1
// @log 1
// @log 0
// @log 5
// @log true
// @log 7
// `is U` over a value whose type is a member of the union `U` is always true and narrows
// nothing, at the direct spelling and in a generic instance pinned at the member (D3359,
// D3360).
type P = { x: i32 }
type U = P | string
function h(a: P) {
  print(a is U)
  if a is U { print(a.x) } else { print(0) }
}
h({ x: 4 })
function g<T>(a: T) {
  if a is U { print(1) } else { print(0) }
}
const pp: P = { x: 1 }
print(pp is U)
g(pp)
g("s")
g(3)
function k(a: P) {
  if !(a is U) { print(9) } else { print(a.x) }
  print(a is U && a.x > 0)
}
k({ x: 5 })
const ps: P[] = [{ x: 7 }]
if ps[0] is U { print(ps[0].x) }
