// @run
// @log a
// @log none
// @log none
// @log b
// A literal-union alias under a nullable, beside the same set inline: each takes its own rep,
// and null and each member round-trip through a parameter.
type K = "a" | "b"
function na(v: K | null): string {
  if v == null { return "none" }
  v
}
function ni(v: "a" | "b" | null): string {
  if v == null { return "none" }
  v
}
const a: K | null = "a"
const b: "a" | "b" | null = null
print(na(a))
print(ni(b))
print(na(null))
print(ni("b"))
