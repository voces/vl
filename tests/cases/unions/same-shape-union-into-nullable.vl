// @run
// @log 4
// @log 7
// @log 3
// @log 9
// @log null
// @log 3
// @log a null
// @log 10
// @log true
// @log 6
// @hint redundant type annotation: `e` is inferred as `A | null`
// @hint redundant type annotation: `ma` is inferred as `A | null`
// @hint redundant type annotation: `mb` is inferred as `A | null`
// A value of an inline union of two same-shape records, delivered into that union widened by
// `null`, which is the nullable record: global init and assignment, a local, a parameter, a
// return, a list element and a map value. A global annotated so with a `null` init has a cell.
type A = { tag: i32, v: i32 }
type B = { tag: i32, v: i32 }
function pick(n: i32): A | B {
  const b: B = { tag: 2, v: n }
  return b
}
let u: A | B | null = null
u = pick(4)
if u != null { print(u.v) }
const g: A | B | null = pick(7)
if g != null { print(g.v) }
function local() {
  let w: A | null = null
  w = pick(1)
  if w == null { return -1 }
  w.v + w.tag
}
print(local())
function take(x: A | B | null) {
  if x == null { return -1 }
  x.v + x.tag
}
print(take(pick(7)))
function back(n: i32): A | B | null {
  if n < 0 { return null }
  pick(n)
}
const r = back(-1)
if r == null { print("null") }
const xs: (A | B | null)[] = [null]
xs.push(pick(3))
const e: A | B | null = xs[1]
if e != null { print(e.v) }
const m = Map<string, A | B | null>()
m.set("a", null)
m.set("b", pick(8))
const ma: A | B | null = m.get("a") ?? null
const mb: A | B | null = m.get("b") ?? null
if ma == null { print("a null") }
if mb != null { print(mb.v + mb.tag) }
const z: A | B | null = null
print(z == null)
const b2: B = { tag: 1, v: 5 }
let d: A | B | null = null
d = b2
if d != null { print(d.v + d.tag) }
