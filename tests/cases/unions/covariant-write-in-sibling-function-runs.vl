// @run
// @log 1
// @log 1
// @hint redundant type annotation: `a` is inferred as `{r: i32}[]`
// D1611 — a write in a frame that cannot reach the binding is not a write through it.
// D793 refuses a covariant list assignment whose list is written through, because the two
// element storages cannot both be honoured. That question is about THIS list, and matching
// the receiver's name over the whole arena makes `sib`'s own `b` the same value as `f`'s.
// Renaming `sib`'s binding is the single ingredient. `b: Shape[]` in `f` is the covariant
// assignment under test; without it there is no widening to license.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq

function sib() {
  const b: Shape[] = []
  b.push({ s: 3 })
  print(b.length)
}

function f() {
  const a: Circle[] = [{ r: 7 }]
  const b: Shape[] = a
  print(b.length)
}

f()
sib()
