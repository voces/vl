// @run
// @log 7
// @log 1
// @hint redundant type annotation: `c` is inferred as `{r: i32}[]` — remove it to lean on inference
// ONE UN-ANNOTATED LIST LITERAL, TWO DECLARED DESTINATIONS OF DIFFERENT ELEMENT KINDS.
// This was D411's LOUD REJECT and it is now a RUNNING program (D791) — the same file, the
// same source, with the directive flipped from `@emit-error` to `@run`.
//
// `const c: Circle[] = lv1` wants a plain struct-row element list; `const c2: Shape[] = lv1`
// wants a union-BOX element list. D411 refused the pair because *"a list value has ONE
// element rep, so whichever the literal is built at, the OTHER store is a type mismatch"*,
// and the three ways it enumerated to make the program run were each priced and refused.
// That premise held only while the emitter had NO CONVERSION between the two rows.
//
// D791 built the conversion (`emitRefListWiden*`, an element-boxing copy loop) and the
// LICENCE for it: the literal is built at the PLAIN-STRUCT row and every union-box
// destination takes an O(n) copy, which is indistinguishable from the alias exactly when
// nothing writes through either row anywhere in the program. This program writes nothing,
// so the copy is unobservable and it prints what the source says it should.
//
// THE REFUSAL IS NOT GONE — it is now conditional, and its own fixture is
// `error-list-literal-two-destinations-written.vl`, which is this program plus one store.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function f() {
  const lv1 = [{ r: 7 }]
  const c: Circle[] = lv1
  const c2: Shape[] = lv1
  if c.length > 0 { print(c[0].r) } else { print(0) }
  if c2.length > 0 { print(1) } else { print(0) }
}
f()
