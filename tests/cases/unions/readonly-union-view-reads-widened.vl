// @run
// @log 4
// @log 8
// @log s
// @log 10
// @log 7
// @log 9
// @log 8
// @log 10
// @log 10
// @log 10
// @log s
// @log 2.5
// D3026: a list of union boxes shared with a `readonly` view whose union holds one of their
// scalar members only widened keeps the source's boxes, and every read out of the view rebuilds
// such a box under the widened member, so a write after the delivery is seen and never traps.
function k(c: boolean): string | i32 {
  if c { return "s" }
  return 3
}
function first(xs: readonly (string | i64)[]) {
  const v = xs[0]
  if v is string { print(v) } else { print(v + 1) }
}
const m: (string | i32)[] = [k(false)]
m.push(k(true))
first(m)

function mk(c: i32): string | i32 {
  if c == 0 { return "s" }
  return c
}
function show(v: string | i64) {
  if v is string { print(v) } else { print(v + 1) }
}
function back(x: (string | i32)[]): readonly (string | i64)[] { return x }
function num(v: string | i64): i64 {
  if v is string { return 0 }
  return v
}
function reads(r: readonly (string | i64)[]) {
  for v in r { show(v) }
  for n in r.map((v: string | i64) => num(v)) {
    if n > 0 { print(n) }
  }
  for v in r.filter((v: string | i64) => v is i64) { show(v) }
  const c = [...r]
  const p = c.pop()
  if p != null { show(p) }
  const g = r.get(2)
  if g != null { show(g) }
  const s = r.slice(1)
  show(s[0])
}
const l: (string | i32)[] = [mk(7), mk(0)]
const r = back(l)
l.push(mk(9))
reads(r)

function half(c: boolean): string | f32 {
  if c { return "s" }
  return 1.5 as f32
}
function wide(xs: readonly (string | f64)[]) {
  const v = xs[1]
  if v is string { print(v) } else { print(v + 1.0) }
}
const hf: (string | f32)[] = [half(true)]
hf.push(half(false))
wide(hf)
