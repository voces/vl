// Regression (silent-class-inventory D224), the census's block-A cell `a099944` verbatim
// plus a second reader for the non-null payload.
//
// A code-16 field of a DECLARED union arm (`Circle.r`, `i32 | null`) read out of a nested
// un-annotated map, in a module that also declares a SECOND union whose first arm is
// `Circle`'s exact layout twin (`type DotU = Dot | DotB`). On master `474b6a1b` this was
// `vl check` rc 0 with no diagnostics and a module the engine refuses:
//
//   Invalid input WebAssembly code at offset 2217:
//     type mismatch: expected i32, found (ref null $type)
//
// Delete the three `Dot*` lines and the same program already RAN (that is D211's own cell),
// which is the whole signature: a second, unrelated union changed how `Circle.r` compiles.
//
// D219's arm rung is gated on `armLayoutAmbiguousAt`, whose arm-claimant loop asked "is
// there a second ARM of this canonical layout" and treated a yes as a second HEAP TYPE. It
// is not one — `buildVariantTwins` has merged two arms of one canonical key and one emitted
// field layout into a single heap index since D48 — so the gate declined on a pair that
// cannot disagree. The rung now asks `repVariantSlotsTwin`, that column's own pairwise
// relation, and declines only a claimant whose heap actually differs.
// @run
// @log 0
// @log 7
// @hint Intentionally-unused parameter `_x`
type Circle = { r: i32 | null }
type Dot = { r: i32 | null }
type DotB = { db: i32 }
type DotU = Dot | DotB
type Sq = { s: i32 }
type Shape = Circle | Sq
function sink(_x: {[string]: {[string]: Circle}}) {}

// The filed cell, verbatim.
const lv1 = Map()
lv1["k0"] = { r: null }
const c = Map()
c["k0"] = lv1
sink(c)
const g0 = (c)["k0"] ?? Map()
const g1 = (g0)["k0"] ?? { r: null }
if (g1).r != null { print(7) } else { print(0) }

// The same read with a PRESENT payload, so the branch that the null test guards is exercised
// too rather than only the empty one.
const lv2 = Map()
lv2["k0"] = { r: 7 }
const c2 = Map()
c2["k0"] = lv2
sink(c2)
const h0 = (c2)["k0"] ?? Map()
const h1 = (h0)["k0"] ?? { r: null }
if (h1).r != null { print(7) } else { print(0) }
