// @run
// @log 2
// @log 0
// @log 1
// @log 102
// @log 0
// @log s
// @log null
// @log x
// @log other
// @log x
// @log none
// @log 1
// @log 7
// @log 2
// @log no
// A `match` type-pattern arm over a JSON-shaped union accepts the deep shapes `is` accepts and
// walks them as `is` does, reading the scrutinee through a converted copy; it covers no member,
// so the `match` still needs its `_` (D16478).
type Json = null | boolean | f64 | string | Json[] | { [string]: Json }
type Cfg = { name: string }

function strs(g: Json) {
  return match g {
    string[] => g.length
    _ => 0
  }
}

function two(g: Json) {
  return match g {
    string[] => g.length
    f64[] => 100 + g.length
    _ => 0
  }
}

function mixed(g: Json) {
  return match g {
    string => g
    null => "null"
    string[] => g[0]
    _ => "other"
  }
}

function rec(g: Json) {
  return match g {
    Cfg => g.name
    _ => "none"
  }
}

function nums(g: Json) {
  return match g {
    {[string]: f64} => g.length
    _ => 0
  }
}

function made(): Json { return ["a", "b"] }

function onCall() {
  return match made() {
    string[] => 7
    _ => 0
  }
}

function asStatement(g: Json) {
  match g {
    string[] => print(g.length)
    _ => print("no")
  }
}

print(strs(["a", "b"]))
print(strs(null))
print(two(["a"]))
print(two([1.5, 2.5]))
print(two(true))
print(mixed("s"))
print(mixed(null))
print(mixed(["x"]))
print(mixed(3))
const m: {[string]: Json} = Map()
m["name"] = "x"
print(rec(m))
print(rec(null))
const n: {[string]: Json} = Map()
n["a"] = 1.5
print(nums(n))
print(onCall())
asStatement(["a", "b"])
asStatement(1)
