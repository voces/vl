// @run
// A record literal into a union whose tagged arm holds a nullable or value-union field is
// adopted by that arm, and a literal that leaves the nullable field out is that arm with the
// field null, not the narrower arm its written fields also fit (D4601).
type Bi = { v: i32 }
type U = { kind: "a", q: i32 | null } | { kind: "b" }
type S = { kind: "s", q: string | null } | { kind: "t", n: i32 }
type V = { kind: "v", q: i32 | string } | { kind: "w" }
type R = { kind: "r", q: Bi | null, l: i32[] | null } | { kind: "x" }
type F = { kind: "f", q: f32 | null } | { kind: "g" }
type A = { kind: "na", q: i32 | null }
type B = { kind: "nb" }
type N = A | B
function show(u: U) {
  if u.kind == "a" { print(u.q == null) } else { print("b") }
}
function make(n: i32): U { return { kind: "a", q: n } }
// binding, with a value and with null
const u: U = { kind: "a", q: 4 }
if u.kind == "a" { print(u.q == null) }
const z: U = { kind: "a", q: null }
show(z)
// argument, return, the other arm
show({ kind: "a", q: 2 })
show({ kind: "b" })
const m = make(5)
if m.kind == "a" {
  const q = m.q
  if q != null { print(q) }
}
// other nullable and value-union fields
const s: S = { kind: "s", q: "str" }
if s.kind == "s" { print(s.q) }
const v: V = { kind: "v", q: "vu" }
if v.kind == "v" { print(v.q) }
const r: R = { kind: "r", q: { v: 7 }, l: [1, 2] }
if r.kind == "r" {
  const rq = r.q
  if rq != null { print(rq.v) }
}
// list element and reassignment
const xs: U[] = [{ kind: "a", q: 1 }, { kind: "b" }]
let w: U = { kind: "b" }
w = { kind: "a", q: 6 }
show(w)
print(xs.length)
// the nullable field left out, at an inline arm, a named arm and an f32 field
const o: U = { kind: "a" }
show(o)
const on: N = { kind: "na" }
if on is A { print(on.q == null) }
const of: F = { kind: "f" }
if of.kind == "f" { print(of.q == null) }
show({ kind: "a" })
const ys: U[] = [{ kind: "a" }, { kind: "b" }]
show(ys[0])
// a nested record literal leaving out its own nullable field, inside an arm
type X = { x: string | null }
type Holder = { h: X }
const hu: Holder | string = { h: {} }
if hu is Holder { print(hu.h.x == null) }
// @log false
// @log true
// @log false
// @log b
// @log 5
// @log str
// @log vu
// @log 7
// @log false
// @log 2
// @log true
// @log true
// @log true
// @log true
// @log true
// @log true
