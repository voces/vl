// @run
// D1096 — EVERY REP A UNION ARM'S FIELD CAN CARRY, COMPARED.
//
// `variantFieldsComparable` admitted the three field codes the ladder happened to have
// arms for — i32/boolean (0), string (3), a nested shape (15) — and ONE unservable field
// declined the WHOLE compare. So `type A = { d: f64 }` inside an `A | i32` refused
// `p == a` with "`==` over a struct union is not supported yet", while the identical
// field compares fine at its direct spelling and as a plain struct field.
//
// THE FAMILY IS THE FIELD'S REP, NOT THE ARM SET, and it is every code outside those
// three: f64, i64, f32, `i32[]`, `f64[]`, `i64[]`, `f32[]`, `string[]`, `boolean[]`, a
// ref-element list and a function-valued field. One gate serves both callers, so the
// union-vs-concrete and the union-vs-union spellings refused identically and are fixed
// identically — every row below is written at both.
//
// `i64` and `f32` are BUILT here rather than borrowed: the STRUCT table's own field
// ladder does not serve them either (a plain `{d: i64}` struct `==` still refuses with
// "unsupported struct field type in equality"), so "the cores exist" was true of the
// lists and the f64 and false of these two.
//
// THE LIST FIELDS NEED A FRAME, and that is the half that is not the compare: a list
// core writes into a scratch frame reserved at collect time, and the scan reserving it
// walked a union's arm ATOMS, which for a struct arm say nothing about what it carries.
// The closure field needs the same and found it the hard way — with the gate widened
// first, a function-valued field produced check-clean INVALID WASM.
//
// EVERY REP IS CONSTRUCTED AND DISCRIMINATED: one row equal, one row differing in the
// field, and one row where the box holds the OTHER arm so the tag misses. A fixture that
// only ever compares equal values passes while the miss answers a constant.

// THE HINTS ARE DECLARED, NOT ACTED ON (D969): a hint saying an annotation is redundant
// is the checker agreeing about the TYPE, and it says nothing about whether the two
// spellings agree about the REP — which is the whole question this file's compare asks.
// The `f32` pair below draws no hint at all, because there the annotation is what makes
// the literal an f32 rather than an f64.
// @hint redundant type annotation: `f64Same` is inferred as `{d: f64}`
// @hint redundant type annotation: `f64Diff` is inferred as `{d: f64}`
// @hint redundant type annotation: `i64Same` is inferred as `{d: i64}`
// @hint redundant type annotation: `i64Diff` is inferred as `{d: i64}`
// @hint redundant type annotation: `sev` is inferred as `i32`
// @hint redundant type annotation: `eig` is inferred as `i32`
// @hint redundant type annotation: `cfSame` is inferred as `{f: () => i32}`
// @hint redundant type annotation: `cfDiff` is inferred as `{f: () => i32}`
// @hint redundant type annotation: `ilSame` is inferred as `{xs: i32[]}`
// @hint redundant type annotation: `ilDiff` is inferred as `{xs: i32[]}`
// @hint redundant type annotation: `ilLong` is inferred as `{xs: i32[]}`
// @hint redundant type annotation: `flSame` is inferred as `{xs: f64[]}`
// @hint redundant type annotation: `flDiff` is inferred as `{xs: f64[]}`
// @hint redundant type annotation: `slSame` is inferred as `{xs: string[]}`
// @hint redundant type annotation: `slDiff` is inferred as `{xs: string[]}`
// @hint redundant type annotation: `blSame` is inferred as `{xs: boolean[]}`
// @hint redundant type annotation: `blDiff` is inferred as `{xs: boolean[]}`
// @hint redundant type annotation: `mixSame` is inferred as `{n: i32, d: f64, s: string, xs: i64[]}`
// @hint redundant type annotation: `mixDiff` is inferred as `{n: i32, d: f64, s: string, xs: i64[]}`

// ── f64 ──────────────────────────────────────────────────────────────────────
type F64F = { d: f64 }
function mkF64(n: i32): F64F | i32 {
  if n == 0 { return 5 }
  if n == 1 { return { d: 1.5 } }
  { d: 2.5 }
}
const f64Box = mkF64(1)
const f64Box2 = mkF64(2)
const f64Scalar = mkF64(0)
const f64Same: F64F = { d: 1.5 }
const f64Diff: F64F = { d: 2.5 }
// @log true
print(f64Box == f64Same)
// @log false
print(f64Box == f64Diff)
// the box holds the SCALAR arm — the tag misses, so false rather than a trap
// @log false
print(f64Scalar == f64Same)
// reversed operand order, and `!=`
// @log true
print(f64Same == f64Box)
// @log true
print(f64Box != f64Diff)
// union vs union, same arm
// @log true
print(f64Box == mkF64(1))
// @log false
print(f64Box == f64Box2)
// @log false
print(f64Box == f64Scalar)

// ── i64 ──────────────────────────────────────────────────────────────────────
type I64F = { d: i64 }
function mkI64(n: i32): I64F | i32 {
  if n == 0 { return 5 }
  if n == 1 { return { d: 9000000000 } }
  { d: 9000000001 }
}
const i64Box = mkI64(1)
const i64Box2 = mkI64(2)
const i64Scalar = mkI64(0)
const i64Same: I64F = { d: 9000000000 }
const i64Diff: I64F = { d: 9000000001 }
// @log true
print(i64Box == i64Same)
// @log false
print(i64Box == i64Diff)
// @log false
print(i64Scalar == i64Same)
// @log true
print(i64Box == mkI64(1))
// @log false
print(i64Box == i64Box2)

// ── f32 ──────────────────────────────────────────────────────────────────────
type F32F = { d: f32 }
function mkF32(n: i32): F32F | i32 {
  if n == 0 { return 5 }
  if n == 1 { return { d: 1.5 } }
  { d: 2.5 }
}
const f32Box = mkF32(1)
const f32Box2 = mkF32(2)
const f32Scalar = mkF32(0)
const f32Same: F32F = { d: 1.5 }
const f32Diff: F32F = { d: 2.5 }
// @log true
print(f32Box == f32Same)
// @log false
print(f32Box == f32Diff)
// @log false
print(f32Scalar == f32Same)
// @log true
print(f32Box == mkF32(1))
// @log false
print(f32Box == f32Box2)

// ── i32[] — a LIST field, which is where the compare frame matters ───────────
type IL = { xs: i32[] }
function mkIL(n: i32): IL | i32 {
  if n == 0 { return 5 }
  if n == 1 { return { xs: [1, 2] } }
  if n == 2 { return { xs: [1, 3] } }
  { xs: [1, 2, 3] }
}
const ilBox = mkIL(1)
const ilScalar = mkIL(0)
const ilSame: IL = { xs: [1, 2] }
const ilDiff: IL = { xs: [1, 3] }
// a different LENGTH, which the element loop must reject before it reads past the end
const ilLong: IL = { xs: [1, 2, 3] }
// @log true
print(ilBox == ilSame)
// @log false
print(ilBox == ilDiff)
// @log false
print(ilBox == ilLong)
// @log false
print(ilScalar == ilSame)
// @log true
print(ilBox == mkIL(1))
// @log false
print(ilBox == mkIL(2))
// @log false
print(ilBox == mkIL(3))

// ── f64[] ────────────────────────────────────────────────────────────────────
type FL = { xs: f64[] }
function mkFL(n: i32): FL | i32 {
  if n == 0 { return 5 }
  if n == 1 { return { xs: [1.5] } }
  { xs: [2.5] }
}
const flBox = mkFL(1)
const flSame: FL = { xs: [1.5] }
const flDiff: FL = { xs: [2.5] }
// @log true
print(flBox == flSame)
// @log false
print(flBox == flDiff)
// @log true
print(flBox == mkFL(1))
// @log false
print(flBox == mkFL(2))

// ── string[] ─────────────────────────────────────────────────────────────────
type SL = { xs: string[] }
function mkSL(n: i32): SL | i32 {
  if n == 0 { return 5 }
  if n == 1 { return { xs: ["a"] } }
  { xs: ["b"] }
}
const slBox = mkSL(1)
const slSame: SL = { xs: ["a"] }
const slDiff: SL = { xs: ["b"] }
// @log true
print(slBox == slSame)
// @log false
print(slBox == slDiff)
// @log true
print(slBox == mkSL(1))
// @log false
print(slBox == mkSL(2))

// ── boolean[], which shares the i32 backing ──────────────────────────────────
type BL = { xs: boolean[] }
function mkBL(n: i32): BL | i32 {
  if n == 0 { return 5 }
  if n == 1 { return { xs: [true] } }
  { xs: [false] }
}
const blBox = mkBL(1)
const blSame: BL = { xs: [true] }
const blDiff: BL = { xs: [false] }
// @log true
print(blBox == blSame)
// @log false
print(blBox == blDiff)
// @log true
print(blBox == mkBL(1))

// ── a function-valued field: identity (id + env), not a value compare ────────
function sev(): i32 { 7 }
function eig(): i32 { 8 }
type CF = { f: () => i32 }
function mkCF(n: i32): CF | i32 {
  if n == 0 { return 5 }
  if n == 1 { return { f: sev } }
  { f: eig }
}
const cfBox = mkCF(1)
const cfScalar = mkCF(0)
const cfSame: CF = { f: sev }
const cfDiff: CF = { f: eig }
// @log true
print(cfBox == cfSame)
// @log false
print(cfBox == cfDiff)
// @log false
print(cfScalar == cfSame)
// @log true
print(cfBox == mkCF(1))
// @log false
print(cfBox == mkCF(2))

// ── SEVERAL reps in one arm: the row is ANDed field by field, so each rep has to
//    answer for itself and one differing field has to sink the whole compare ───
type Mix = { n: i32, d: f64, s: string, xs: i64[] }
function mkMix(n: i32): Mix | i32 {
  if n == 0 { return 5 }
  if n == 1 { return { n: 1, d: 1.5, s: "a", xs: [9000000000] } }
  { n: 1, d: 1.5, s: "a", xs: [9000000001] }
}
const mixBox = mkMix(1)
const mixSame: Mix = { n: 1, d: 1.5, s: "a", xs: [9000000000] }
// differs ONLY in the last field, so an ANDed row that dropped it would say true
const mixDiff: Mix = { n: 1, d: 1.5, s: "a", xs: [9000000001] }
// @log true
print(mixBox == mixSame)
// @log false
print(mixBox == mixDiff)
// @log true
print(mixBox == mkMix(1))
// @log false
print(mixBox == mkMix(2))
