// @error is not a JSON shape — `Id` is a newtype; a JSON shape carries no brand
// A NEWTYPE is a nominal brand over a shape, and a JSON document carries no brand — nothing
// in the tree distinguishes an `Id` from the `i32` it wraps, so a walk that answered `true`
// would launder every number into the brand. Refused at the `is` site, naming the brand.
type Json = null | boolean | f64 | string | Json[] | { [string]: Json }
type Id = new i32
const j: Json = null
print(j is Id)
