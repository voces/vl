// D2326 matrix — a union-typed PARAMETER shadowed by a block-local `const` of the same name
// binding a DIFFERENT union. `unionNameOfIdentAt` must skip the param rung while a block
// LetDecl covering the read's position shadows it (`fnBlockShadowsAt`, sharing D2325's
// guard), and answer the param again once the shadow's block closes.
// @run
// @log 5|inner|5

type A = { x: i32 }
type B = { y: string }
type C = { z: boolean }

function f(u: A | B) {
  let out = ""
  if u is A { out = "\{u.x}" } else { out = "\{u.y}" }
  {
    const u: C | B = { z: true }
    if u is C { out = out + "|inner" } else { out = out + "|\{u.y}" }
  }
  if u is A { out = out + "|\{u.x}" } else { out = out + "|\{u.y}" }
  out
}
print(f({ x: 5 }))
