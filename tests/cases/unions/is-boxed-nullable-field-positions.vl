// @run
// @warning Unused function `local` (prefix with `_` to suppress, remove it, or `export` it)
// @log a!
// @log true
// @log 2
// @log 5
// @log not i32
// @log fs
// @log none
// @log 6
// @log 5
// @log true
// Q58 position sweep: an `is` over a record field held as a nullable over a union box reads the
// field's box, and the narrowed read after it unboxes that box: a parameter's, a global's, a nested
// and a closure-union field, and a loop element's. The tail is a `?.get` into a wider union at
// module scope; the unused `local` is load-bearing (legacy's start reserves for it).
type F = (i32) => i32
type O = { v: string | i32 | null }
type P = { f: F | null | string }
type N = { o: O }
type K = { x: i32 }
const g: O = { v: "pv" }
function param(o: O) {
  if o.v is string { print(o.v + "!") } else { print(o.v == null) }
}
function glob() {
  if g.v is string { print(g.v.length) } else { print(0) }
}
function nested(n: N) {
  if n.o.v is i32 { print(n.o.v + 1) } else { print("not i32") }
}
function closureField(p: P) {
  if p.f is string { print(p.f) }
  else if p.f == null { print("none") }
  else { print(p.f(2)) }
}
function inLoop(os: O[]) {
  let k = 0
  for o in os {
    if o.v is string { k = k + o.v.length }
  }
  print(k)
}
param({ v: "a" })
param({ v: null })
glob()
nested({ o: { v: 4 } })
nested({ o: { v: "s" } })
closureField({ f: "fs" })
closureField({ f: null })
closureField({ f: (x: i32) => x * 3 })
inLoop([{ v: "ab" }, { v: 1 }, { v: "cde" }])
function local() {}
const kn: {[i32]: K} | null = null
const ocn: i32 | K | null = kn?.get(2)
print(ocn is null)
