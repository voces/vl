// @run
// @log 7
// @log 0
// @log 2.5
// @log 0
// @log 2
// @log 1
// @log 3
// @log 0
// @log 7
// @log 0
// @log 7
// @log 0
// `??` over a read narrowed to `T | null` out of a wider union box reads the box: a scalar, a
// list or a record, behind any narrowing spelling.
function i(e: i32 | null | string) {
  if !(e is string) { print(e ?? 0) }
}
i(7)
i(null)
function f(e: f64 | null | string) {
  if e is string { return }
  print(e ?? 0.0)
}
f(2.5)
f(null)
function l(e: i32[] | null | string) {
  if !(e is string) {
    const w = e ?? [9]
    print(w.length)
  }
}
l([1, 2])
l(null)
function r(e: {a: i32} | null | i32) {
  if e is i32 {
    print(e)
  } else {
    const w = e ?? { a: 0 }
    print(w.a)
  }
}
r({ a: 3 })
r(null)
function m(e: i32 | null | string) {
  match e {
    string => print(e)
    _ => print(e ?? 0)
  }
}
m(7)
m(null)
function two(e: i32 | null | string | boolean) {
  if !(e is string) && !(e is boolean) { print(e ?? 0) }
}
two(7)
two(null)
