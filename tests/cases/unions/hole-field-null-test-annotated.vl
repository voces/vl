// @run
// @warning `v.q == null` is always false here (v.q is i32)
// The annotated face of `hole-field-null-test.vl`, beside a tagged arm reaching a hole (D4637).
type U = { kind: "a", q: i32 | null } | { kind: "b" }
function direct(v: { q: i32 }) { print(v.q == null) }
function nullable(v: { q: i32 | null }) { print(v.q == null) }
function tagged(v) {
  if v.kind == "a" { print(v.q == null) }
}
direct({ q: 4 })
nullable({ q: 4 })
nullable({ q: null })
tagged({ kind: "a", q: 4 })
// @log false
// @log false
// @log true
// @log false
