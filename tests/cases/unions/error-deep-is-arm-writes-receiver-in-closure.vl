// @error a deep `is` arm that rebinds or writes `r` inside an expression is not supported yet — write it as its own statement, or bind the converted value first
// A closure in a deep `is` arm that writes the tested place runs at no statement the arm
// orders, so the reads around it have no one binding to read (D16274).
type Json = null | boolean | f64 | string | Json[] | { [string]: Json }
function d(r: Json) {
  if r is string[] {
    const n = r.length
    const clear = () => {
      return r = null
    }
    clear()
    return n
  }
  return 0
}
print(d(["a"]))
