// D6690: a write in a then arm, by a call or directly, ends the enclosing narrowing in that arm
// only. The else arm, and the code after a then arm that exits, start from the narrowing at the
// condition. Covers a top-level and a function `if`, `return` and `continue`, a value-if, an
// else-if, a closure read, a field path, and v128, f64, i64 and record unions.
// @run
// @log neg!
// @log s!
// @log false
// @log true
// @log lp!
// @log lp
// @log 4
// @log 3
// @log 0
// @log w!
// @log w!
// @log false
// @log true
// @log 2
// @log cap!
// @log pv!
// @log true
// @log b
// @log false
// @log true
function pick(n: i32): v128 | string {
  if n < 0 { return "neg" }
  __splat_i32x4__(n)
}
let x: v128 | string | null = pick(-1)
function wr() { x = null }
const b = false
if x is string {
  if b { wr() } else { print(x + "!") }
}
let y: f64 | string | null = "s"
function wry() { y = null }
function exits() {
  if y != null {
    if y is f64 { wry(); return 1 }
    print(y + "!")
  }
  0
}
exits()
print(y == null)
y = 2.5
exits()
print(y == null)
let z: string | i32 | null = "lp"
function direct(c: boolean) {
  if z is string {
    if c { z = 4 } else { print(z + "!") }
    print(z)
  }
}
direct(false)
direct(true)
let f: f64 | string | null = 1.5
function wrf() { f = null }
function twice(c: boolean) {
  if f is f64 {
    if c { wrf() } else { return f * 2.0 }
  }
  0.0
}
print(twice(false))
print(twice(true))
let w: string | i32 | null = "w"
function wrw() { w = null }
function loop(c: boolean) {
  for i in 0 to 1 {
    if w is string {
      if c { wrw(); continue }
      print(w + "!")
    }
  }
  print(w == null)
}
loop(false)
loop(true)
let q: i64 | string | null = "nn"
function wrq() { q = null }
function value(c: boolean) {
  if q is string {
    const r = if c { wrq(); 0 } else if q == "zz" { 1 } else { q.length }
    print(r)
  }
}
value(false)
let k: string | i32 | null = "cap"
function wrk() { k = null }
function captured(c: boolean) {
  if k is string {
    if c {
      wrk()
    } else {
      const g = (): string => k + "!"
      print(g())
    }
  }
}
captured(false)
type O = { v: string | i32 | null }
const o: O = { v: "pv" }
function wro() { o.v = null }
function field(c: boolean) {
  if o.v is string {
    if c { wro() } else { print(o.v + "!") }
  }
}
field(false)
field(true)
print(o.v == null)
type A = { k: "a", n: i32 }
type B = { k: "b", s: string }
let r: A | B | null = { k: "b", s: "hi" }
function wrr() { r = null }
function rec(c: boolean) {
  if r != null {
    if c { wrr() } else { print(r.k) }
    print(r == null)
  }
}
rec(false)
rec(true)
