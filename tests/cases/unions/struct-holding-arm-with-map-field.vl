// @run
// @log 1
// @log seven
// @log 1
// @log 2
// @log 5
// @log 1
// @log 1
// @log 3
// @log 4
// @log 6
// @log 9
// A plain struct holding a union arm whose own field is a non-mono map (D15097): the arm's
// map slots are interned before the holder's field is coded, so its twin check finds them.
// String, sibling-arm, inline-record and self values; before and after the arm;
// nested; two arms of one field set with a map field (D15099); and the arm moved back into the union.
type Q = { o: A }
type A = { n: i32, g: Map<string, string> }
type P = { m: i32 }
type U = A | P | B | C | D
const ga: Map<string, string> = Map()
ga.set("x", "seven")
const q: Q = { o: { n: 1, g: ga } }
print(q.o.n)
print(q.o.g.get("x") ?? "")

type B = { n: i32, g: Map<string, P> }
type QB = { b: B }
const gb: Map<string, P> = Map()
gb.set("p", { m: 2 })
const qb: QB = { b: { n: 1, g: gb } }
print(qb.b.n)
print(qb.b.g.get("p")?.m ?? 0)

type C = { k: i32, h: Map<string, C> }
type QC = { c: C }
const hc: Map<string, C> = Map()
hc.set("y", { k: 5, h: Map() })
const qc: QC = { c: { k: 1, h: hc } }
print(qc.c.h.get("y")?.k ?? 0)
print(qc.c.k)

type D = { n: i32, g: Map<string, { r: i32 }> }
type QD = { d: D }
type QQ = { qd: QD }
const gd: Map<string, { r: i32 }> = Map()
gd.set("r", { r: 3 })
const qq: QQ = { qd: { d: { n: 1, g: gd } } }
print(qq.qd.d.n)
print(qq.qd.d.g.get("r")?.r ?? 0)

const u: U = q.o
if u is A { print(u.n + 3) }
const us: U[] = [qc.c, q.o]
for e in us {
  if e is C { print(e.k + 5) }
}

type G1 = { n: i32, g: Map<string, string> }
type G2 = { n: i32, g: Map<string, { r: i32 }> }
type UG = G1 | G2 | P
type QG = { g2: G2 }
const g2m: Map<string, { r: i32 }> = Map()
g2m.set("k", { r: 9 })
const qg: QG = { g2: { n: 1, g: g2m } }
print(qg.g2.g.get("k")?.r ?? 0)
