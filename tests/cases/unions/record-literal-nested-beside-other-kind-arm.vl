// @run
// @log 4
// @log s
// @log 4
// @log true
// @log 0
// D2902 — `{ f: v0 }` (an `i32 | null` field) is not the arm `{ f: boolean }` of the union
// below, so the literal nesting it no longer looks for an arm that holds it.
const v0: i32 | null = 4
const r0 = { f: v0 }
const r1: { f: boolean } = { f: true }
const r2 = { f: "s" }
const u: { f: boolean } | i32 = r1
const m: {[string]: { f: string }} = Map()
const e = m["a"] ?? r2
const xs: { f: boolean }[] = []
const n = { h: { g: r0 } }
print(n.h.g.f ?? 0)
print(e.f)
print(r0.f ?? 0)
if u is { f: boolean } { print(u.f) }
print(xs.length)
