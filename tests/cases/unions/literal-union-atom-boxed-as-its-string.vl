// @run
// @log true
// @log a
// @log b
// A literal-union value boxed into a union that takes it as a string rides the box under the
// string tag as its member string: returned, bound and passed.
type A = "a" | "b"
type U = A | { tag: i32 }
function f(x: A): U { return x }
print(f("a") == "a")
function show(u: U) { if u is { tag: i32 } { print(u.tag) } else { print(u) } }
function bound(x: A) {
  const u: U = x
  show(u)
}
bound("a")
function passed(x: A) { show(x) }
passed("b")
