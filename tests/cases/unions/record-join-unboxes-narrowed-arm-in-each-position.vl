// @run
// @hint redundant type annotation: `o` is inferred as `A` — remove it to lean on inference
// @hint redundant type annotation: `o` is inferred as `A` — remove it to lean on inference
// @hint redundant type annotation: `o` is inferred as `A` — remove it to lean on inference
// @hint redundant type annotation: `o` is inferred as `A` — remove it to lean on inference
// @hint redundant type annotation: `o` is inferred as `A` — remove it to lean on inference
// @log box
// @log dflt
// @log [box]
// @log box
// @log dflt
// @log box
// @log box
// @log box
// @log c:box
// @log h:dflt
// @log box
// @log dflt
// A value `if` joined at a record arm's row, its narrowed arm unboxed out of a box, delivered at
// each position: a record and a union parameter, a nested call, a return, a binding, an `if` arm,
// a `??` operand, a record-literal field, its field in a concatenation and an interpolation hole,
// and a field read straight off the join.
type A = { k: "a", v: i32, tag: string }
type B = { k: "b", w: i32 }
type Hold = { a: A }
function tagOf(a: A) { return a.tag }
function uTag(u: A | string) {
  if u is string { return u }
  return u.tag
}
function wrap(s: string) { return "[" + s + "]" }
function pParam(x: A | B, d: A) { print(tagOf(if x is A { x } else { d })) }
function pUnion(x: A | B, d: A) { print(uTag(if x is A { x } else { d })) }
function pNested(x: A | B, d: A) {
  print(wrap(tagOf(if x is A { x } else { d })))
}
function pReturn(x: A | B, d: A): A { return if x is A { x } else { d } }
function pBinding(x: A | B, d: A) {
  const o: A = if x is A { x } else { d }
  print(o.tag)
}
function pIfArm(x: A | B, d: A, c: boolean) {
  const o: A = if c { if x is A { x } else { d } } else { d }
  print(o.tag)
}
function pCoalesce(x: A | B, d: A, m: A | null) {
  const o: A = m ?? (if x is A { x } else { d })
  print(o.tag)
}
function pField(x: A | B, d: A) {
  const h: Hold = { a: if x is A { x } else { d } }
  print(h.a.tag)
}
function pConcat(x: A | B, d: A) {
  const o: A = if x is A { x } else { d }
  print("c:" + o.tag)
}
function pHole(x: A | B, d: A) {
  const o: A = if x is A { x } else { d }
  print("h:\{o.tag}")
}
function pDirect(x: A | B, d: A) { print((if x is A { x } else { d }).tag) }
const boxA: A | B = { k: "a", v: 7, tag: "box" }
const boxB: A | B = { k: "b", w: 3 }
const d: A = { k: "a", v: 5, tag: "dflt" }
pParam(boxA, d)
pUnion(boxB, d)
pNested(boxA, d)
print(pReturn(boxA, d).tag)
pBinding(boxB, d)
pIfArm(boxA, d, true)
pCoalesce(boxA, d, null)
pField(boxA, d)
pConcat(boxA, d)
pHole(boxB, d)
pDirect(boxA, d)
pDirect(boxB, d)
