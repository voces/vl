// @run
// @log 5
// @log 5
// @log 4
// @log 1
// A union `print` of a chained map `??`, and a shared field read of a `??` that joins two records,
// each over an operand written in place: the values print, hit and miss alike.
type R = { a: {[i32]: i32 | null} }
function chain(p: R) { print(p.a[9] ?? p.a[4] ?? p.a[3]) }
function pair(p: R) { print(p.a[3] ?? p.a[4]) }
type J = { f: i32 | null }
type K = { f: i32 | null, g: i32 }
function mk(): K { return { f: 4, g: 0 } }
const m: {[string]: K} = Map()
m.set("a", mk())
function pick(d: J) { return (m.get("a") ?? d).f }
function miss(d: J) { return (m.get("z") ?? d).f }
const a: {[i32]: i32 | null} = Map()
a[3] = 5
chain({ a: a })
pair({ a: a })
print(pick({ f: 1 }) ?? 0)
print(miss({ f: 1 }) ?? 0)
