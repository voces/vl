// @run
// @hint Intentionally-unused parameter `_b` (leading `_` marks it unused)
// @log false
// @log false
// @log false
// @log d
// @log false
// @log d
// A nullable union of two string-literal aliases is one nullable literal atom whether it is
// spelled directly or reached through a generic instance, and an inline spelling of the same
// sets reads back the member it was given.
type K = "a" | "b"
type L = "c" | "d" | "x"
function H<A, B>(a: A, _b: B): A | B { return a }
function Hd(a: K | L | null, _b: string): K | L | null | string { return a }
function Kd(a: K | L | null): K | L | null { return a }
function Gni(
  a: ("a" | "b") | ("c" | "d") | null,
): ("a" | "b") | ("c" | "d") | null {
  return a
}
const kl: K | L | null = "d"
print(H(kl, "q") == null)
print(Hd(kl, "q") == null)
print(Kd(kl) == null)
print(Kd(kl))
print(kl == null)
const v4: ("a" | "b") | ("c" | "d") | null = "d"
print(Gni(v4))
