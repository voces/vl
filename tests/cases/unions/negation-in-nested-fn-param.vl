// @check
// @error is a NEGATION, which says what a value is not
// @error is a NEGATION, which says what a value is not
// @error is a NEGATION, which says what a value is not
// @error `Pair` expects 2 type arguments but got 1
// A written negation, and any other annotation error, is refused in the parameter of a
// function nested in an un-annotated one: the return pre-pass resolves the annotation first
// and rolls its diagnostic back, so the resolution memo may not bank that answer (D2294).

type Pair<A, B> = { a: A, b: B }

function mk(n: i32) {
  process: (_x: Pair<i32, !string>): i32 => {
    n
  },
  base: n,
}

function lam(n: i32) {
  const f = (_x: !string): i32 => {
    n
  }
  f
}

function nest(n: i32) {
  function g(_x: Pair<i32, !boolean>): i32 { n }
  g
}

function arity(n: i32) {
  function h(_x: Pair<i32>): i32 { n }
  h
}

print(mk(3).base)
print(lam(1) == lam(1))
print(nest(1) == nest(1))
print(arity(1) == arity(1))
