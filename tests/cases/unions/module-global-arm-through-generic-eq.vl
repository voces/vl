// Regression (silent-class-inventory D75 and D82 — ONE root, and the ablation says so).
//
// A value whose type is a declared union ARM handed to a GENERIC, in a module that also
// declares a standalone struct of that arm's exact layout (`Dot`). On master `8bf0f20f`
// every cell below was `vl check` rc 0 and a module the engine refuses:
//
//   type mismatch: expected (ref $type), found (ref $type)          (D75, a module global)
//   current function requires result type [(ref (id 1))]
//     but callee returns [(ref (id 0))]                             (D82, a call result)
//
// THE PIN WAS THE TWIN'S NAME. `collectS` SKIPS a `type X = {…}` that is a union member, so
// declaring `type Shape = Circle | Sq` deletes `Circle`'s `sNames` row and mints a VARIANT
// row instead. `monoArgTyName`'s struct arm asked `structIndexOfExpr`, whose `Index` and
// module-global legs are NOT kind-gated, so with `Dot` in the module they answered DOT's
// struct row and the instance was pinned `Dot` — measured directly at the pin, not inferred
// from the message. The disassembly is where the two heap types show:
//
//   master   (global (mut (ref 1)))   eqT$m1 (param (ref 0) (ref 0))   struct.get 0 0
//   branch   (global (mut (ref 1)))   eqT$m1 (param (ref 1) (ref 1))   struct.get 1 0
//     ; three structurally identical `(struct (field (mut i32)))` rows share one rec group;
//     ; type 0 is Dot's standalone row and type 1 is uVarHeap[Circle]. They are NEVER
//     ; merged — DECISIONS.md keeps the struct/variant seam NOMINAL — so the `call` is what
//     ; fails to validate, not the `==` in the body.
//
// THE TWIN IS THE AXIS, AND IT TURNS A LOUD FLOOR OFF. Delete `type Dot` and master gives
// the LOUD `monomorphize: unsupported argument type for `x` in a call to `eqT`` instead;
// give the twin the same arity and a DIFFERENT field name and the loud floor comes back.
// Delete `type Shape = Circle | Sq` and master RUNS. Both the arm-ness and the twin are
// required — D63's sentence one layer up.
//
// THE COMPLEMENT WAS ALREADY WRITTEN, so no channel was needed: `exprVariantIndex` is
// `structIndexOfExpr`'s storage-class twin arm for arm, and this ladder simply never asked
// it. That makes it the ninth rung of the family to close on an un-called complement.
// @run
// @log true
// @log 7
// @log 7
// @log 5
// Every `: Circle` below is LOAD-BEARING — it is what makes the value an arm rather than
// an anonymous shape — so the hints are declared rather than the annotations deleted.
// @hint redundant type annotation: `eqT` is inferred as `boolean`
// @hint redundant type annotation: `c1` is inferred as `{r: i32}`
// @hint redundant type annotation: `c2` is inferred as `{r: i32}`
// @hint redundant type annotation: `c` is inferred as `{r: i32}`
// @hint redundant type annotation: `a` is inferred as `{r: i32}`
// @hint redundant type annotation: `b` is inferred as `{r: i32}`
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Dot = { r: i32 }

function eqT<T>(x: T, y: T): boolean {
  return x == y
}

function idg<T>(x: T): T { return x }
function thru(x: Circle) { return x }

// D75 — two module GLOBALS of an arm type through a generic `==`.
const c1: Circle = { r: 1 }
const c2: Circle = { r: 1 }
print(eqT(c1, c2))

// D82 — a monomorphized hand-written generic instance whose argument is a CALL RESULT.
function mk(n: i32): Circle {
  const c: Circle = { r: n }
  return idg(thru(c))
}
print(idg((mk(7)).r))

// The storage classes either side of the two filed ones: a function LOCAL (which already
// ran, and must keep running) and a PARAMETER.
function viaLocal() {
  const a: Circle = { r: 7 }
  const b: Circle = { r: 7 }
  if eqT(a, b) { return 7 }
  return 0
}
print(viaLocal())

function viaParam(p: Circle) {
  return idg(p).r
}
print(viaParam({ r: 5 }))
