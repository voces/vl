// @run
// @log true
// @log false
// @log 1
// @log true
// `is Set<T>[]` over a union holding a list of Sets and no other member at its slot: the slot's
// tag names the Set list alone (D16172).
const s: Set<i32> = Set()
s.add(4)
const u: Set<i32>[] | i32 = [s]
print(u is Set<i32>[])
const v: Set<i32>[] | i32 = 3
print(v is Set<i32>[])
if u is Set<i32>[] {
  print(u.length)
  print(u[0].has(4))
}
