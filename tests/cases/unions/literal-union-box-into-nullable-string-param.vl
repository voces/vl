// @run
// @log x
// @log x
// @log null
// @log x
// @log z
// A `K | L | null` box passed where the parameter is `string | null` (a `T` pinned at the
// softened literal unions, or a declared one) is converted to that niche at the argument: it
// went in as the box (D3382's argument position).
type K = "a" | "b"
type L = "x" | "y"
function f<T>(x: T): T { x }
function g(s: string | null) { print(s) }
function h<T>(x: T, p: boolean, o: string): T | string {
  if p { return x }
  return o
}
function run(a: K | L | null) {
  print(f(a))
  g(a)
}
run("x")
g(null)
function run2(a: K | L | null) {
  print(h(a, true, "z"))
  print(h(a, false, "z"))
}
run2("x")
