// @error WRITTEN THROUGH
// @hint redundant type annotation: `a` is inferred as `{r: i32}[]` — remove it to lean on inference
// @hint redundant type annotation: `nn` is inferred as `Shape[][]` — remove it to lean on inference
// A covariant list inside a container that is handed to a writing function (D1658).
//
// `poke(nn)` gives the container a second name — the parameter `g` — and the write goes
// through `g[0]`, which roots at no name of its own. Filing the escaped element under the
// parameter as well as under `nn` is what makes `g[0]` match as a handle, so the write is
// definite and the refusal is the checker's rather than the emitter's decline.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq

function poke(g: Shape[][]) { g[0].push({ s: 3 }) }

function f() {
  const a: Circle[] = [{ r: 7 }]
  const b: Shape[] = a
  const nn: Shape[][] = [b]
  poke(nn)
  print(a.length)
}

f()
