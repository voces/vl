// @run
// @log 1
// @log 3
// @log 1
// @log 3
// @log 3
// @log 1
// @log 0
// A generic's inferred `T[] | i32[]` return, pinned to a literal's anonymous row: the union
// names the row's shape, so the list arms read back in a binding, a field, a rewritten `let`
// and an `is T[]` test (D5083).
function w<T>(t: T, b: boolean) {
  if b { return [t] }
  [1, 2, 3]
}
function bind<T>(t: T, b: boolean) {
  const v = w(t, b)
  print(v.length)
}
function fld<T>(t: T, b: boolean) {
  const o = { f: w(t, b) }
  print(o.f.length)
}
function rewritten<T>(t: T) {
  let r = w(t, true)
  r = w(t, false)
  print(r.length)
}
function test<T>(t: T, b: boolean) {
  const v = w(t, b)
  if v is T[] { print(v.length) } else { print(0) }
}
bind({ x: 1 }, true)
bind({ x: 1 }, false)
fld({ x: 1 }, true)
fld({ x: 1 }, false)
rewritten({ x: 1 })
test({ x: 7 }, true)
test({ x: 7 }, false)
