// @run
// @log 100
// @log 1
// @log 100
// @log 1
// @log end
// @log no
// @log end
// @log other
// @log 5
// @log x
// @log 11
// @hint redundant type annotation: `f` is inferred as `i32`
// @hint redundant type annotation: `h` is inferred as `i32`
// `is` naming an inline arm whose field is a lone literal, in a function and over a list's
// elements, with the arm's field read in the narrowed branch and its complement (D5143).
type N = { v: i32 } | { tag: "end" }
function f(n: N): i32 {
  if n is { tag: "end" } { return 100 }
  1
}
const x: N = { tag: "end" }
print(f(x))
print(f({ v: 3 }))
type K = { kind: "a" | "b", v: i32 } | { kind: "end" }
function h(n: K): i32 {
  if n is { kind: "end" } { return 100 }
  1
}
print(h({ kind: "end" }))
print(h({ kind: "a", v: 1 }))
const ks: K[] = [{ kind: "end" }]
for k in ks {
  if k is { kind: "end" } { print(k.kind) }
}
const kb: K = { kind: "b", v: 2 }
if kb is { kind: "end" } { print("yes") } else { print("no") }
type T = { kind: "a" | "b", v: i32 } | { tag: "end" }
const ts: T[] = [{ tag: "end" }, { kind: "a", v: 1 }]
for t in ts {
  if t is { tag: "end" } { print(t.tag) } else { print("other") }
}
type M = { tag: "x" } | { w: i32 }
function g(m: M) {
  if !(m is { tag: "x" }) { print(m.w) } else { print(m.tag) }
}
const ms: M[] = [{ w: 5 }, { tag: "x" }]
for m in ms { g(m) }
const q = h2(false)
if q is { kind: "end" } { print("e") } else { print(q.v + 10) }
function h2(e: boolean): K {
  if e { return { kind: "end" } }
  { kind: "b", v: 1 }
}
