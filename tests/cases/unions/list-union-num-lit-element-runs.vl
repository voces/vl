// @run
// @log 3
// @log 1
// @log 2
// @log s
// A union of lists one of whose members holds a numeric literal union reads `.length`, an index
// and `for … in` through the same rewrite a string literal union takes (D4770).
type K = 0 | 1

const a: i32[] | K[] = [1, 0, 1]
print(a.length)
print(a[2])
function f(b: K[] | string[]) {
  for x in b {
    if x is string { print(x) }
  }
  if b is K[] { print(b.length) }
}
const k: K[] = [1, 0]
f(k)
f(["s"])
