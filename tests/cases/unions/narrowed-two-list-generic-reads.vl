// @run
// @log 1
// @log 3.5
// @log 2.5
// @log 2.5
// @log 2.5
// @log 1
// @log t
// @log -9
// A two-list generic result narrowed by `is` reads as the one list the checker typed the read
// at, in either arm, through every read position (D14534).
function g<U>(u: U, c: boolean) {
  if c { return [u] }
  [2.5]
}
function h<T>(c: boolean, t: T) {
  if !c { return [t] }
  g(t, false)
}
const q = h(true, "s")
if q is f64[] {
  print(q.length)
  print(q[0] + 1.0)
  for x in q { print(x) }
  const f = () => q[0]
  print(f())
} else {
  print(q[0])
}
if !(q is f64[]) { print(-2) } else { print(q[0]) }
function inner(c: boolean) {
  const r = h(c, "t")
  if r is string[] { print(r[0]) } else { print(r.length) }
  if r is f64[] { return r[0] }
  -9.0
}
inner(true)
print(inner(false))
