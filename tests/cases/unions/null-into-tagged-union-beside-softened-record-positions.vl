// @run
// @log true
// @log true
// @log true
// @log true
// @log true
// @log true
// @log dynx
// @log true
// A `null` delivered into `N | null` is the null box, even where a record `S` the literal tags of
// `N`'s arms soften toward makes the null read as a record row: in a list, passed, returned, bound,
// assigned, as a field and at the top level.
type N = { tag: "a", v: i32 } | { tag: "b", w: i32 }
type S = { tag: string, v: i32 }
function show(n: N | null) { print(n == null) }
function listed() {
  const xs: (N | null)[] = [null, { tag: "a", v: 1 }]
  show(xs[0])
}
function passed() { show(null) }
function returned(): N | null { return null }
function bound() {
  const n: N | null = null
  show(n)
}
function assigned() {
  let n: N | null = { tag: "b", w: 2 }
  n = null
  show(n)
}
function fielded() {
  const h: { n: N | null } = { n: null }
  show(h.n)
}
listed()
passed()
show(returned())
bound()
assigned()
fielded()
const gs: (N | null)[] = [null, { tag: "a", v: 3 }]
const e = gs[1]
if e is N {
  if e is { tag: "a", v: i32 } {
    const s: S = { tag: "dyn" + "x", v: e.v }
    print(s.tag)
  }
}
show(gs[0])
