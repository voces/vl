// @run
// @log 10
// @log 1
// D14540: named arms over a numeric tag; a field read in either branch of the tag test.
type A = { k: 1, n: i32 }
type B = { k: 2, n: i32 }
type P = A | B
function mk(b: boolean): P {
  if b { return { k: 2, n: 9 } }
  { k: 1, n: 1 }
}
const p = mk(true)
if p.k == 1 { print(p.n) } else { print(p.n + 1) }
const r = mk(false)
if r.k == 1 { print(r.n) } else { print(r.n + 1) }
