// @run
// @log i64
// @log B i32
// Record arms sharing a field name (D4056): `is` on a field of another record narrows that
// place, and a read through it is the narrowed arm's own field, delivered into a union.
type A = { v: i64 }
type B = { v: i32 | null }
function sh(x: i32 | i64 | null) {
  if x == null { return "null" }
  if x is i32 { return "i32" }
  "i64"
}
const a: A = { v: 5 as i64 }
const h: { u: A | B } = { u: a }
if h.u is A { print(sh(h.u.v)) } else { print("B") }
const b: B = { v: 7 }
const k: { u: A | B } = { u: b }
if k.u is A { print(sh(k.u.v)) } else { print("B " + sh(k.u.v)) }
