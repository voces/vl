// @run
// @log 7
// @log 107
// @log -1
// @hint redundant type annotation: `pickU` is inferred as `i32`
// @hint redundant type annotation: `pickV` is inferred as `i32`
// @hint redundant type annotation: `c` is inferred as `{ns: {[string]: {v: i32}}[]}`
// @hint redundant type annotation: `d` is inferred as `{w: i32}`
// The MAP-element sibling of the ref-list-field variant twin: `Cat = {ns:
// {[string]: A}[]}` and `Kot = {ns: {[string]: B}[]}` key the same canonical
// variant, and the field's ref-list slots hold MAP elements whose value types are
// the declared struct twins `A` / `B`. The layout guard descends into the
// map-VALUE layer, so the two variants share one heap type and a `Cat` read
// through `V`'s `is Kot` arm lands on it.
type A = { v: i32 }
type B = { v: i32 }
type Cat = { ns: { [string]: A }[] }
type Kot = { ns: { [string]: B }[] }
type Dog = { w: i32 }
type Bird = { z: i32 }
type U = Cat | Dog
type V = Kot | Bird

function pickU(u: U): i32 {
  if u is Cat {
    const e = u.ns[0]["k"]
    if e != null { return e.v }
  }
  return -1
}
function pickV(v: V): i32 {
  if v is Kot {
    const e = v.ns[0]["k"]
    if e != null { return e.v + 100 }
  }
  return -1
}

function go() {
  const m: { [string]: A } = Map()
  m["k"] = { v: 7 }
  const c: Cat = { ns: [m] }
  print(pickU(c)) // 7
  print(pickV(c)) // 107 — the map-element twin arm
  const d: Dog = { w: 1 }
  print(pickU(d)) // -1
}
go()
