// @check
// @error operator '+' is not defined for i32 | null and i32 — 'x' is no longer narrowed to i32: the call to 'clr' on line 19 may reassign it; re-test 'x' after the call
// @error operator '+' is not defined for i32 | null and i32 — 'x' is no longer narrowed to i32: the call to 'clr' on line 30 may reassign it; re-test 'x' after the call
// @error operator '+' is not defined for i32 | null and i32
// @error operator '+' is not defined for i32 | null and i32
// A call that may write the place ends the join's narrowing as it ends any other (D2390, the
// transfer function for calls): after the `if`, and inside an arm after the fill (must-error).
function nn(v: i32): i32 | null {
  if v < 0 { return null }
  return v
}

function after(k: i32): i32 {
  let x = nn(k)
  const clr = () => {
    x = null
  }
  if x == null { x = 0 }
  clr()
  return x + 1
}

function inArm(k: i32): i32 {
  let x = nn(k)
  const clr = () => {
    x = null
  }
  if x == null {
    x = 0
    clr()
  }
  return x + 1
}

// The call on one path, a re-narrowing write sequence on the other: each path's end survives
// the meet (review round 2).
let g: i32 | null = null
function clrG() { g = null }
function globalArm(c: boolean): i32 {
  g = 7
  if c {
    g = null
    g = 7
  } else {
    clrG()
  }
  return g + 1
}

function localArm(k: i32, c: boolean): i32 {
  let x = nn(k)
  const clr = () => {
    x = null
  }
  x = 7
  if c {
    x = null
    x = 7
  } else {
    clr()
  }
  return x + 1
}

print(after(1) + inArm(1) + globalArm(true) + localArm(1, true))
