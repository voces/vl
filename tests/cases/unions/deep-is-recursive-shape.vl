// @run
// @log false
// @log true
// @log 6
// @log 3
// @log false
// @log a
// @log b
// @log true
// @log true
// A recursive JSON shape on the right of a deep `is` is walked by a call per level: the target's
// own predicate and builder for a cycle back to it, and a pair of their own for a recursive type
// inside a target that is not (D1198).
type Json = null | boolean | f64 | string | Json[] | { [string]: Json }
type Tree = { v: f64, kids: Tree[] }
type Node = { name: string, next: Node | null }
type Doc = { t: Tree, n: f64 }
function obj2(a: string, x: Json, b: string, y: Json): Json {
  const m: { [string]: Json } = Map()
  m[a] = x
  m[b] = y
  return m
}
function tree(v: Json, kids: Json[]): Json { return obj2("v", v, "kids", kids) }
function depth(t: Tree) {
  let d = 0
  for k in t.kids {
    const x = depth(k)
    if x > d { d = x }
  }
  return d + 1
}
const none: Json = null
print(none is Tree)
const j = tree(1.0, [tree(2.0, []), tree(3.0, [tree(0.0, [])])])
print(j is Tree)
if j is Tree {
  let s = j.v
  for k in j.kids { s = s + k.v }
  print(s)
  print(depth(j))
}
print(tree(1.0, [tree("x", [])]) is Tree)
const l = obj2("name", "a", "next", obj2("name", "b", "next", null))
if l is Node {
  print(l.name)
  const n = l.next
  if n != null { print(n.name) }
}
const d = obj2("t", tree(1.0, [tree(2.0, [])]), "n", 5.0)
print(d is Doc)
if d is Doc { print(d.t.kids[0].v == 2.0) }
