// @run
// @log 7
// @log true
// @log null
// @log false
// @log true
// @log 7
// @log false
// @log null
// @log 2.5
// @log 1
// @log 3
// @log 2.5
// @log 7
// @log true
// @log x
// @log 7
// A standalone `?.` of a non-null scalar field is `T | null`, and a `??` past it can join into
// a value union; neither is spelled anywhere else in this program, and both still print and
// compare (D3513).
type P = { a: i32, b: i32 }
type O = { q: P | null }
type W = {
  f: i64 | null,
  g: boolean | null,
  s: string | null,
  u: i32 | string | null,
}
function f(r: P | null) {
  print(r?.b)
  print(r?.b == 7)
}
f({ a: 1, b: 7 })
f(null)
function nest(o: O | null) {
  print(o?.q?.b != null)
  print(o?.q?.b)
}
nest({ q: { a: 1, b: 7 } })
nest({ q: null })
function joins(w: W | null) {
  print(w?.f ?? 2.5)
  print(w?.g ?? 1)
  print(w?.s ?? 3)
  print(w?.u ?? 2.5)
}
joins(null)
joins({ f: 7, g: true, s: "x", u: 7 })
