// @run
// @log 5
// The SAME root one read-depth shallower, which is why it reported a different message. Binding
// the arm's struct-typed field (`const g = u.v`) rather than chaining through it asks
// `structIndexOfLet` for `g`'s layout, which asks `structIndexOfExpr` for `u.v`'s — the same
// query the chained read makes — so a miss left `g`'s local with no interned shape
// (`ref valtype with no interned shape`) instead of leaving the field read with no receiver
// (`field access receiver is not a struct`). One root, two depths, two messages.
type Inner = { v: i32 }
type Outer = { v: Inner }
type U = Outer | i32

function take(x: Inner) { print(x.v) }

const u: U = { v: { v: 5 } }
if u is Outer {
  const g = u.v
  take(g)
} else { print(0) }
