// @run
// @log 2
// @log 2
// @log 700
// @log 3
// @log 2
// @hint redundant type annotation: `sumU` is inferred as `i32`
// An un-annotated list literal of a call returning a nullable record union holds the union
// box: read directly, read behind a `!= null` test, mixed with a bare `null` (D5103).
type U = { a: i32 } | { b: i32 }
function sumU(n: U | null): i32 {
  if n == null { return 0 }
  if n is { b: i32 } { return n.b * 100 }
  return n.a
}
function mk(k: i32): U | null {
  if k > 50 {
    const tb: U = { b: k / 10 }
    return tb
  }
  const t: U = { a: k }
  return t
}
const xs = [mk(2)]
print(sumU(xs[0]))
const v = xs[0]
if v != null { print(sumU(v)) }
const ys = [mk(70), mk(3), null]
print(sumU(ys[0]))
print(sumU(ys[1]) + sumU(ys[2]))
function local() {
  const zs = [mk(2)]
  print(sumU(zs[0]))
}
local()
