// @log 3
// @warning this `??` default is never used: `i32` is never null — drop the `??` and its default
// @warning this `??` default is never used: `i32` is never null — drop the `??` and its default
// @hint Intentionally-unused variable `_k` (leading `_` marks it unused)
// A member written into a union-typed element or map entry yields its own value, and a record
// written into an `R` or `R | null` place yields the record, in any position.
const us = [1, "a"]
let ui = 1
const r = us[ui] = 5
print(r)
print(if us[1] is i32 { us[1] } else { 0 })
print((us[ui] = "zz") + "!")
const um: {[string]: i32 | string} = Map()
let uk = "a"
print(um[uk] = 7)
print((um[uk] = "q") + "?")
print(if um["a"] is string { um["a"] } else { "-" })

type Node = { v: i32, left: Node | null }
const root: Node = { v: 5, left: null }
function show(n: Node) { print(n.v) }
show(root.left = { v: 3, left: null })
print(root.left?.v ?? 0)
const ns: (Node | null)[] = [null]
const ni = 0
show(ns[ni] = { v: 4, left: null })
print(ns[0]?.v ?? 0)

function src(): i32 | string { return "s" }
function g() {
  let x = src()
  const _k = () => x
  if x is string { x = "t" }
}
print(g())
function v3(n: Node) { return n.v }
const top = v3(root.left = { v: 3, left: null })
print(top)
ui = 0
uk = "b"
