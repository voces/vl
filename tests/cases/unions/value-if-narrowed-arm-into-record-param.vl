// @run
// @log 7
// @log 5
// @log 70
// @log 5
// @log 7
// @log 5
// @log 7
// @log 3
// @log 7
// A value `if` whose arm is a union narrowed to a record, joined at the record's row, delivered
// to a record parameter directly, nested, through a generic and as a `match`; and to a parameter
// taking the union, which keeps its box (D17115).
type A = { k: "a", v: i32 }
type B = { k: "b", w: i32 }
function vOf(a: A) { return a.v }
function vU(u: A | B) { return if u is A { u.v } else { u.w } }
function wrap(n: i32) { return n * 10 }
function idv<T>(t: T): T { return t }
function direct(x: A | B, d: A) { return vOf(if x is A { x } else { d }) }
function nested(x: A | B, d: A) { return wrap(vOf(if x is A { x } else { d })) }
function generic(x: A | B, d: A) { return vOf(idv(if x is A { x } else { d })) }
function matched(x: A | B, d: A) {
  return vOf(
    match x {
      A => x
      B => d
    },
  )
}
function toUnion(x: A | B, d: B) { return vU(if x is A { x } else { d }) }
function bound(x: A | B, d: A) {
  const o = if x is A { x } else { d }
  return vOf(o)
}
const a7: A = { k: "a", v: 7 }
const a5: A = { k: "a", v: 5 }
const b1: B = { k: "b", w: 1 }
const b3: B = { k: "b", w: 3 }
print(direct(a7, a5))
print(direct(b1, a5))
print(nested(a7, a5))
print(generic(b1, a5))
print(matched(a7, a5))
print(matched(b1, a5))
print(toUnion(a7, b3))
print(toUnion(b1, b3))
print(bound(a7, a5))
