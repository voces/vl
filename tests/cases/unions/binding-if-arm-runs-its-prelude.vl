// @run
// @log 7
// @log true
// A union binding initialised by an `if` whose arm runs statements before its value: under the
// binding sink, and into the seeded box.
type U = i32 | string
function pre(c: i32): U {
  const r = if c > 1 {
    const t = c * 2
    t + 1
  } else {
    "small"
  }
  return r
}
function seeded(b: boolean, v: U, w: U) {
  const u = if b {
    const x = v
    x
  } else {
    w
  }
  return u is i32
}
const p = pre(3)
if p is i32 { print(p) }
print(seeded(true, 1, "y"))
