// @run
// @log 111
// @log 1000
// @log 1
// @hint redundant type annotation: `wOf` is inferred as `i32`
// @hint redundant type annotation: `wOf2` is inferred as `i32`
// A self-referential arm built nested (its rolled spelling) and read through the union (its
// unrolled spelling) is one arm with one tag, in a recursive read and an `is` test (D5155).
type Node = { kind: "a" | "b", w: i32, v: i32, next: Node | null }
  | { kind: "end", w: i32 }
function wOf(n: Node | null): i32 {
  if n == null { return 0 }
  return n.w + wOf2(n)
}
function wOf2(n: Node): i32 {
  if n is { kind: "a" | "b", w: i32, v: i32, next: Node | null } {
    return wOf(n.next)
  }
  0
}
const a: Node = {
  kind: "a",
  v: 3,
  w: 1,
  next: { kind: "b", v: 2, w: 10, next: { kind: "end", w: 100 } },
}
const b: Node = { kind: "b", v: 4, w: 1000, next: null }
print(wOf(a))
print(wOf(b))
const c: Node[] = [{ kind: "end", w: 1 }]
for n in c { print(wOf(n)) }
