// `xs ?? d` where the default is a list of lists whose leaf differs from the operand's is
// typed as the union of the two lists, and each arm is boxed under its own tag: the operand
// when it is present, the default built as its own list otherwise (D2819). Every position
// reads the arm back through `is`, so a value boxed under the other arm's tag prints -1.
// @run
// @log 2
// @log t
// @log 8
// @log 42
// @log z
// @log a
// @log 5
// @log 2
// @log 4
// @log 2
function h(xs: string[][] | null) { xs ?? [[1]] }
const q = h(null)
if q is i32[][] { print(q[0][0] + 1) } else { print(-1) }
const r = h([["s", "t"]])
if r is string[][] { print(r[0][1]) } else { print(-1) }

function bound(xs: string[][] | null): string[][] | i32[][] {
  const z = xs ?? [[7]]
  z
}
const bq = bound(null)
if bq is i32[][] { print(bq[0][0] + 1) } else { print(-1) }

function show(v: string[][] | i32[][]) {
  if v is i32[][] { print(v[0][0] * 2) } else { print(v[0][0]) }
}
function arg(xs: string[][] | null) { show(xs ?? [[21]]) }
arg(null)
arg([["z"]])

function flip(xs: i32[][] | null) { xs ?? [["a"]] }
const fq = flip(null)
if fq is string[][] { print(fq[0][0]) } else { print(-1) }
const fr = flip([[5]])
if fr is i32[][] { print(fr[0][0]) } else { print(-1) }

function flat(xs: string[] | null) { xs ?? [[1]] }
const lq = flat(null)
if lq is i32[][] { print(lq[0][0] + 1) } else { print(-1) }

function rebound(xs: string[][] | null) {
  let z = xs ?? [[3]]
  z = z
  z
}
const rq = rebound(null)
if rq is i32[][] { print(rq[0][0] + 1) } else { print(-1) }

function early(xs: string[][] | null, c: boolean) {
  if c { return xs ?? [[1]] }
  [["w"]]
}
const eq = early(null, true)
if eq is i32[][] { print(eq[0][0] + 1) } else { print(-1) }
