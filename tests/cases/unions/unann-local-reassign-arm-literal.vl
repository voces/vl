// @run
// An un-annotated function local whose literal matches a union arm is that arm's struct, and a
// record literal assigned to it later builds the same struct, not the union's box (D4613).
type U = { q: i32 } | { kind: "b" }
type W = { q: i32, s: string } | { r: i32 }
type T = { kind: "t", n: i32 | null } | { kind: "u" }
function plain() {
  let v = { q: 4 }
  v = { q: 5 }
  print(v.q)
}
function twoFields() {
  let v = { q: 1, s: "x" }
  v = ({ s: "y", q: 2 })
  print(v.s)
  print(v.q)
}
function inLoop() {
  let v = { q: 0 }
  let i = 0
  while i < 3 {
    v = { q: v.q + i }
    i = i + 1
  }
  const read = () => v.q
  read()
}
function tagged() {
  let v = { kind: "t", n: 4 }
  v = { kind: "t", n: 9 }
  print(v.n)
}
function delivered() {
  let v = { q: 6 }
  v = { q: 7 }
  const u: U = v
  if u is { q: i32 } { print(u.q) }
}
plain()
twoFields()
print(inLoop())
tagged()
delivered()
// @log 5
// @log y
// @log 2
// @log 3
// @log 9
// @log 7
