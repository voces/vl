// @run
// @log 3
// @log 0
// @log none
// @log s
// @log 5
// @log -1
// A `??` the rewrite desugars to `if l != null { l } else { d }` tests for null and joins: over a
// map read, over a nullable value union and over an optional-chain read.
type R = { r: i32 }
function viaMap(m: {[string]: i32 | null}, k: string) {
  const v = m[k] ?? 0
  return v
}
function viaUnion(u: i32 | string | null) {
  const v = u ?? "none"
  if v is string { return v }
  return "int"
}
function viaChain(x: R | null) {
  const n = x?.r
  return n ?? -1
}
const m: {[string]: i32 | null} = Map()
m["a"] = 3
print(viaMap(m, "a"))
print(viaMap(m, "b"))
print(viaUnion(null))
print(viaUnion("s"))
print(viaChain({ r: 5 }))
print(viaChain(null))
