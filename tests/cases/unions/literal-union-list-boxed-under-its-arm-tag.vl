// @run
// @log x
// @log y
// @log 5
// A list of literal-union members boxed into a union rides the box as itself, under the atom-list
// arm's tag where another list arm sits beside it, else under its list kind's tag.
type K = "x" | "y"
function show(a: i32[] | K[]) {
  if a is K[] { print(a[0]) } else { print(a[0] + 1) }
}
function viaId() {
  const ks: K[] = ["x", "y"]
  show(ks)
}
function viaLit() { show(["y"]) }
viaId()
viaLit()
show([4])
