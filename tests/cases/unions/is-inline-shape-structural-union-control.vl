// @run
// @log 100
// @log 200
// THE ADDITIVITY CONTROL for `is-inline-shape-names-a-nominal-variant.vl`, and it is a file
// of its own because a control that shares a module with its subject is a bystander.
//
// A union spelled with INLINE SHAPES registers those shapes as its `uVariants` rows, so
// `a is {meow: i32}` names a row directly and `isVariantSpelling`'s nominal fallback never
// runs — the author's own spelling always wins when it resolves. This file therefore runs
// identically on both compilers, which is what makes the fallback ADDITIVE rather than a
// rewrite: it can only turn a loud reject into a hit, never move a resolution that worked.
//
// AND IT CANNOT LIVE NEXT TO ITS SUBJECT. The rows this annotation registers are
// module-global: one `{meow: i32} | {woof: i32}` annotation anywhere makes an unrelated
// `nominalUnion is {meow: i32}` compile on the parent commit as well, which is the same
// action-at-a-distance the subject file is pinning the end of. Two files, one claim each.
// (`is Dog` is deliberately absent: a NOMINAL test against a union whose rows are inline
// shapes is a reject on both compilers — the fallback only maps the other direction, an
// inline spelling to the declared name it equals, and only when the raw spelling missed.)
type Cat = { meow: i32 }
type Dog = { woof: i32 }

function structuralAnnotation() {
  const a: {meow: i32} | {woof: i32} = { meow: 100 }
  if a is {meow: i32} {
    print(a.meow)
  }
  const b: {meow: i32} | {woof: i32} = { woof: 200 }
  if b is {woof: i32} {
    print(b.woof)
  }
}

structuralAnnotation()
