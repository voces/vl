// @run
// @log 1
// @log 0
// @log 1
// @log 0
// @log 1
// @log 1
// @log 0
// @log 1
// @log n
// @log i
// @log false
// @log true
// @log 1
// @log 0

// `is` on a parameter an instance binds at `null` tests whether `null` fits the tested type,
// in an un-annotated and a generic parameter, and in an `if`, a value `if` and a return (D8182).
function un(v) {
  if v is i32 { print(0) } else { print(1) }
}
un(null)
un(3)

function gen<T>(v: T) {
  if v is i32 { print(0) } else { print(1) }
}
gen(null)
gen(4)
gen("x")

function isNull(v) {
  if v is null { print(1) } else { print(0) }
}
isNull(null)
isNull(2)

function orNull(v) {
  if v is i32 | null { print(1) } else { print(0) }
}
orNull(null)

function pick(v) { print(if v is i32 { "i" } else { "n" }) }
pick(null)
pick(7)

function ret(v): boolean { return v is i32 }
print(ret(null))
print(ret(2))

function lit(v) {
  if v is 0 { print(0) } else { print(1) }
}
lit(null)
lit(0)
