// @run
// @log 8
// @log no
// @log 8
// @log true
// @log no
// @log 4
// @log 1.5
// @log no
// @log x
// A list arm is an `as?` target: the hit yields the arm's list and the miss `null`, flat or
// nested, bound with or without an annotation; `as!` to a nested arm, annotated.
function mk(c: boolean): f64[] | i32[] {
  if c { return [1.5] }
  [7, 8]
}
const b = mk(false) as? i32[]
if b != null { print(b[1]) } else { print("no") }
const d = mk(true) as? i32[]
if d != null { print(d[1]) } else { print("no") }
function ns(c: boolean): string | i32[][] {
  if c { return "s" }
  [[7, 8]]
}
const e = ns(false) as? i32[][]
if e != null { print(e[0][1]) } else { print("no") }
function nb(c: boolean): boolean[][] | i32[][] {
  if c { return [[true]] }
  [[4]]
}
const v = nb(true)
const g = () => {
  const x = v as? boolean[][]
  if x != null { print(x[0][0]) } else { print("no") }
  const y = v as? i32[][]
  if y != null { print(y[0][0]) } else { print("no") }
  0
}
g()
const w: i32[][] = nb(false) as! i32[][]
print(w[0][0])
function ms(c: boolean): f64[] | string[] | i32[] {
  if c { return [1.5] }
  ["x"]
}
const fa = ms(true) as? f64[]
if fa == null { print("no") } else { print(fa[0]) }
const fb = ms(false) as? f64[]
if fb == null { print("no") } else { print(fb[0]) }
const sa = ms(false) as? string[]
if sa != null { print(sa[0]) } else { print("no") }
