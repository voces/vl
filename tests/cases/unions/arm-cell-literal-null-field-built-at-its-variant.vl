// @run
// @log true
// @log true
// @log true
// @log 2
// A record literal bound at a union member's type is built at that member's variant row, so an
// explicit `null` field is the variant's null: in a local, in a module cell, with a nullable list
// field and a nullable map field, then read back through the union.
type A = { r: i32[] | null }
type Sq = { s: i32 }
type S = A | Sq
type P = { m: { [string]: i32 } | null }
type Q = { q: i32 }
type T = P | Q
function local() {
  const w: A = { r: null }
  print(w.r == null)
  const p: P = { m: null }
  print(p.m == null)
}
local()
const g: A = { r: null }
const u: S = g
if u is A { print(u.r == null) }
const g2: A = { r: [1, 2] }
const r2 = g2.r
if r2 != null { print(r2.length) }
