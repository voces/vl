// @run
// @log 1
// @log 9000000000.5
// @log 16777216
// A two-width integer-literal union delivered into a nullable float holds each member exactly,
// so its box is retagged: the `i64` member arrives as the `f64` it equals (D3530).
type D = 9000000000 | 1
function g(b: boolean): D { if b { 9000000000 } else { 1 } }
const z: f64 | null = g(false)
print(z)
const w: f64 | null = g(true)
if w != null { print(w + 0.5) }
type E = 16777216 | 1
function h(): E { 16777216 }
const f: f32 | null = h()
print(f)
