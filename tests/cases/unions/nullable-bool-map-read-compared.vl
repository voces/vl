// A `boolean | null` map read compared with a bool or another such read, at each operand order
// and through `==` and `!=`: a missing key is null, which equals only null.
let seen: {[string]: boolean} = Map()
seen["t"] = true
seen["f"] = false
function eqLit(k: string): boolean { return seen[k] == true }
function neLit(k: string): boolean { return seen[k] != true }
function litEq(k: string): boolean { return false == seen[k] }
function litNe(k: string): boolean { return false != seen[k] }
function eqVar(k: string, b: boolean): boolean { return seen[k] == b }
function neVar(k: string, b: boolean): boolean { return seen[k] != b }
function eqRead(a: string, b: string): boolean { return seen[a] == seen[b] }
function neRead(a: string, b: string): boolean { return seen[a] != seen[b] }
print(eqLit("t"))
print(eqLit("x"))
print(neLit("t"))
print(neLit("x"))
print(litEq("f"))
print(litEq("x"))
print(litNe("f"))
print(litNe("x"))
print(eqVar("t", true))
print(eqVar("x", false))
print(neVar("x", false))
print(neVar("f", false))
print(eqRead("t", "f"))
print(eqRead("x", "y"))
print(neRead("t", "f"))
print(neRead("x", "y"))
