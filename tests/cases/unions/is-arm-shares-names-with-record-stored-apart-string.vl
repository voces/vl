// @run
// @log s
// @log 0
// @log x
// D8320 over string fields: `J`'s `string` field and `N`'s `string | null` one are stored
// apart, so `is N` still narrows to `N`'s row.
type J = { r: string }
type N = { r: string | null }
const a: J | i32 = { r: "x" }
const b: N | i32 = { r: "s" }
if b is N { print(b.r ?? "-") }
const c: N | i32 = { r: null }
if c is N {
  if c.r == null { print(0) }
}
if a is J { print(a.r) }
