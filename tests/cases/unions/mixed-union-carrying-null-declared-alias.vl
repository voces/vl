// @run
// @log string
// @log s
// @log A
// @log 7
// @log null
// @log i32
// @log 42
// @log A
// @log 9
// @log null
// @log 4
// @log -1
// @log z
// @hint redundant type annotation: `v` is inferred as `i32 | A | null` — remove it to lean on inference
// D1721 — A DECLARED UNION MIXING A STRUCT ARM WITH A VALUE ATOM AND `null` IS THE BOX.
//
// `string | A | null` interns as `TyNullable` over `string | A`, which makes the alias a
// transparent one-member wrapper — so the annotation was spelled by the STRUCTURAL render
// (`string|{r:i32}|null`) while the arena walk registered the row under the declared
// spelling. No name-keyed lookup could join the two, and the `is` refused at both faces.
//
// Both arms print a value, so a box tagged with the wrong arm cannot pass: the `A` arm reads
// its field and the atom arm prints its own value. The last three lines are the delivery
// positions the annotation pins — a non-null arm value, a bare `null`, and a `V | null`
// niche, which has no tag of its own and is boxed by the null test. The `V` annotation is
// declared redundant rather than removed: it is the ANNOTATED face, and a fixture that
// annotates nothing cannot see the half of this row the annotation pins.
type A = { r: i32 }
type U = string | A | null
type V = i32 | A | null

function pickS(k: i32): U {
  if k == 0 { return "s" }
  if k == 1 { return { r: 7 } }
  return null
}

function pickI(k: i32): V {
  if k == 0 { return 42 }
  if k == 1 { return { r: 9 } }
  return null
}

let i = 0
while i < 3 {
  const w = pickS(i)
  if w is string { print("string"); print(w) }
  if w is A { print("A"); print(w.r) }
  if w is null { print("null") }
  i = i + 1
}

let j = 0
while j < 3 {
  const v: V = pickI(j)
  if v is i32 { print("i32"); print(v) }
  if v is A { print("A"); print(v.r) }
  if v is null { print("null") }
  j = j + 1
}

function mkA(): A { return { r: 4 } }
function mkNulS(): string | null { return "z" }

const armed: U = mkA()
if armed is A { print(armed.r) } else { print(0) }

const bare: U = null
if bare is A { print(bare.r) }
else if bare is string { print(bare) }
else { print(-1) }

const niche: U = mkNulS()
if niche is string { print(niche) } else { print(0) }
