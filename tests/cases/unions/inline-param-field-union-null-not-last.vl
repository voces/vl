// @run
// An inline record parameter whose field is a record, `null` and a third member, with `null`
// not spelled last, reads its field as the union box at every position (D10410).
type Circle = { r: i32 }
type Sq = { s: i32 }
function g(h: { f: Circle | null | string }): i32 {
  const v = h.f
  if v is Circle { return v.r }
  -1
}
print(g({ f: { r: 7 } }))
print(g({ f: null }))
print(g({ f: "s" }))
function n(o: { a: { f: null | Circle | Sq } }): i32 {
  const h = o.a
  const v = h.f
  if v is Circle { return v.r }
  -1
}
print(n({ a: { f: { r: 8 } } }))
print(n({ a: { f: { s: 3 } } }))
const l = (h: { f: null | i32 | Circle }): i32 => {
  const v = h.f
  if v is Circle { return v.r }
  -1
}
print(l({ f: { r: 9 } }))
print(l({ f: 5 }))
// @log 7
// @log -1
// @log -1
// @log 8
// @log -1
// @log 9
// @log -1
// @hint redundant type annotation: `g` is inferred as `i32`
// @hint redundant type annotation: `n` is inferred as `i32`
