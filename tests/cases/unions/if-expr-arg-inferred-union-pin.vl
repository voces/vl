// @run
// @log 7
// @log miss
// @log 2.5
// @log 7
// @log miss
// An if-expression or `match` handed straight to an un-annotated or type-parameter parameter
// pins it at the inferred union its arms join to (`i32 | string`), which no annotation spells:
// the pin registers the union, as a binding of the same join does (D2824).
function pick() { true }
function skip() { false }
function take(a) {
  if a is i32 { print(a) } else { print("miss") }
}
function takeF(a) {
  if a is f64 { print(a) } else { print("miss") }
}
function takeT<T>(a: T) {
  if a is i32 { print(a) } else { print("miss") }
}
take(if pick() { 7 } else { "s" })
take(if skip() { 7 } else { "s" })
takeF(if pick() { 2.5 } else { "s" })
takeT(if pick() { 7 } else { "s" })
const k = 1
take(
  match k {
    0 => 7
    _ => "s"
  },
)
