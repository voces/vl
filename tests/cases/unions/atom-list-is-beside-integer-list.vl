// @run
// @log i32
// @log K
// @log i32
// @log KN
// @log y
// @log x
// @log 5
// @log x
// @log y
// @log 6
// @log y
// @log x
// @log y
// @log 10
// @log x
// @log mK
// @log y
// @hint redundant type annotation: `j` is inferred as `i32 | "x" | "y"`
// D4906: a list of string-literal-union atoms beside an `i32[]` arm holds its own tag, so
// `is K[]` tells an atom list from an integer list at every delivery position (D2886 too).
type K = "x" | "y"
function f(a: i32[] | K[]) {
  if a is K[] { print("K") } else { print("i32") }
}
function fn(a: i32[] | (K | null)[]) {
  if a is (K | null)[] { print("KN") } else { print("i32") }
}
const g: f64 | K[] = ["y", "x"]
const h: i32[] | K[] = ["x"]
const n: i32[] | K[] = [4]
function id<T>(v: T): T { v }
function pick(b: boolean): i32[] | K[] {
  if b { return ["y"] }
  [5]
}
type Box = { v: i32[] | K[] }
function show(a: i32[] | K[]) {
  if a is K[] { print(a[0]) } else { print(a[0] + 1) }
}
function main() {
  f([7])
  f(["y"])
  fn([7])
  fn(["x", null])
  if g is K[] { print(g[0]) }
  show(h)
  show(n)
  show(id(h))
  show(pick(true))
  show(pick(false))
  const b: Box = { v: ["y"] }
  show(b.v)
  const m: Map<string, i32[] | K[]> = Map()
  m["a"] = ["x"]
  show(m["a"] ?? [0])
  const xs: (i32[] | K[])[] = [["y"], [9]]
  for e in xs { show(e) }
  const ks: K[] = ["x", "y"]
  const u: i32[] | K[] = ks
  show(u)
  match u {
    K[] => print("mK")
    i32[] => print("mI")
  }
  const w = pick(true)
  const j: i32 | K = if w is i32[] { w[0] } else { w[0] }
  print(j)
}
main()
