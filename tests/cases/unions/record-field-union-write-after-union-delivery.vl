// @run
// @log 104
// @log 105
// @log A str s
// @log 106
// A write to a union-typed field of a record a union binding also holds boxes the value (D4261),
// through the record itself, through the narrowed binding, and through a null-tested one.
type A = { n: i32 | string, k: i32 }
type B = { n: string }
function show(u: A | B) {
  if u is A {
    const n = u.n
    if n is i32 { print(n + 100) } else { print("A str " + n) }
  } else {
    print("B")
  }
}
function viaAlias() {
  const a: A = { n: "q", k: 0 }
  const w: A | B = a
  a.n = 4
  show(w)
}
function viaNarrowed() {
  const w: A | B = { n: "q", k: 0 }
  if w is A { w.n = 5 }
  show(w)
  if w is A { w.n = "s" }
  show(w)
}
function viaNullable(x: A | null) {
  const w: (A | B) | null = x
  if x != null { x.n = 6 }
  if w != null { show(w) }
}
viaAlias()
viaNarrowed()
viaNullable({ n: "q", k: 1 })
