// @run
// @log 1
// @log 0.5
// @log 1
// @log 1
// @log 0
// @hint redundant type annotation: `show` is inferred as `i32`
// @hint redundant type annotation: `show32` is inferred as `i32`
// @hint redundant type annotation: `pass` is inferred as `f64`
// @hint redundant type annotation: `y` is inferred as `f64`
// @hint redundant type annotation: `z` is inferred as `i32`
// D978 — AN f32 DELIVERED INTO A UNION WHOSE ONLY FLOAT ARM IS f64.
//
// The coerce ladder read the VALUE's kind (`exprIsF32` → kind 5) and never asked which arm the
// union stores it in, so it wanted an f32 value box the module never minted:
// `emitProgram: union atom has no value box`, on a program `vl check` accepts. The widening is
// lossless, so clause 2 says it must compile.
//
// ASKED HERE RATHER THAN IN `unionStoreAtomKind`, which is the shared mapper. Widening that
// moved a case it should not have — `d901_fold_f32_dest`, a `{q: f32} | null` whose f32 is a
// FIELD and not an arm, went `runs -> loud emit reject`, which the corpus gate blocks on. The
// test is spelled out at the one site that needed it.
function show(v: i32 | f64): i32 {
  if v is f64 { return 1 }
  0
}

const x: f32 = 0.5
print(show(x))

// The VALUE survives the widening, which a tag-only test would not show.
function pass(v: i32 | f64): f64 {
  if v is f64 { return v }
  0.0
}
print(pass(x))

// A union that DOES have an f32 arm must keep using it.
function show32(v: i32 | f32): i32 {
  if v is f32 { return 1 }
  0
}
print(show32(x))

// And the arms that already worked are unchanged.
const y: f64 = 0.5
print(show(y))
const z: i32 = 3
print(show(z))
