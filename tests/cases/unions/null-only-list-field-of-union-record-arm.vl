// @log 1
// A list of only `null` in a record literal delivered into a union takes its element type from
// the record arm the literal is built at (D16908).
const g: {f: (i64 | null)[]} | string = { f: [null] }
print(g is string)
if g is string { print(g) } else { print(g.f.length) }
const h: {f: (i64 | null)[] | boolean} | string | f64 = { f: [null] }
print(h is string)
function k(v: {f: (i64 | null)[]} | string) {
  if v is string { return 0 }
  return v.f.length
}
print(k({ f: [null] }))
const p: {f: (i64 | null)[]} | string = { f: [null] }
if !(p is string) {
  p.f.push(4)
  print(p.f.length)
}
const two: {f: (i64 | null)[], n: i32} | {h: (string | null)[]} = { h: [null] }
if two is {h: (string | null)[]} { print(two.h.length) }
const pick: {f: (i64 | null)[]} | {f: (string | null)[], k: i32} = { f: [null] }
if pick is {f: (i64 | null)[]} { print(pick.f.length) }
const xs: ({f: (i64 | null)[]} | string)[] = [{ f: [null] }, "x"]
print(xs.length)
function mk(): {f: (i64 | null)[]} | string { return { f: [null] } }
const m = mk()
if m is string { print(m) } else { print(m.f.length) }
type A = {f: (i64 | null)[], k: i32 | null}
const a: A | string = { f: [null], k: 3 }
if a is string { print(a) } else { print(a.f.length) }
