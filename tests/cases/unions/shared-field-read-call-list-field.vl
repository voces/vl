// @run
// @log 2
// @log 1
// A shared field read through a CALL receiver: the receiver is evaluated once into a stash and
// each member's arm reads it. The field is a LIST, which the dispatch's `if` now spells as the
// field's storage type (D3562) where it used to be the loud floor `field access but no struct
// type declared`.
type A = { xs: i32[], a: i32 }
type B = { pad: boolean, xs: i32[] }
function g(flag: boolean): A | B {
  if flag { return { xs: [1, 2], a: 3 } }
  return { pad: true, xs: [4] }
}
print(g(true).xs.length)
print(g(false).xs.length)
