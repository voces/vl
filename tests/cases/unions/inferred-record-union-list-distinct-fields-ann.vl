// @run
// @log 2
// @log 1
// @log 2
// @log 1
// @log 20
// @log 2
// The annotated face of `inferred-record-union-list-distinct-fields.vl` (D14220): the
// destination's union types the literal, and the two faces must agree.
type A = { a: i32 }
type B = { b: i32 }
const xs: (A | B)[] = [{ a: 1 }, { b: 2 }]
print(xs.length)
for x in xs {
  if x is A { print(x.a) } else { print(x.b) }
}

const lv1: ({ r: { c2: i32 } } | { r: { s2: i32 } })[] = [
  { r: { c2: 1 } },
  { r: { s2: 2 } },
]
for x in lv1 {
  const v = x.r
  if v is { c2: i32 } { print(v.c2) } else { print(v.s2 * 10) }
}
print(lv1.length)
