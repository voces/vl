// @emit-error literal-union string widening with no members
// D3140: a `K | null` element of a list literal whose destination is a union-box list boxes into
// that destination instead of typing the list as the atom-niche list, so where the box has no
// widening for the niche the emitter refuses rather than store an i32 list in a box-list slot.
type K = "ka" | "kb"
function kn(b: boolean): K | null {
  if b { return "kb" }
  return null
}
const xs: (K | null | i32)[] = [kn(false)]
const v = xs[0]
if v == null { print("N") } else { print("other") }
