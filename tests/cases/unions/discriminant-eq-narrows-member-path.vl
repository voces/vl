// @run
// @log bee
// @log 42
// @log 41
// @log deep
// @log 1.5
// @log else3
// @log 9
// `x.h.k == "a"` narrows the member path `x.h` as `h.k == "a"` narrows a name: in either
// operand order, at any depth, in both arms, and after a write to the path (D12473).
type A = { k: "a", v: i32 }
type B = { k: "b", s: string }
type C = { k: "c", f: f64 }
const w: { h: A | B } = { h: { k: "b", s: "bee" } }
if w.h.k == "a" { print(w.h.v) } else { print(w.h.s) }
const x: { h: A | B } = { h: { k: "a", v: 41 } }
if x.h.k == "a" { print(x.h.v + 1) } else { print(x.h.s) }
if "b" == x.h.k { print(x.h.s) } else { print(x.h.v) }
const y: { o: { h: A | B } } = { o: { h: { k: "b", s: "deep" } } }
if y.o.h.k == "b" { print(y.o.h.s) }
const z: { h: A | B | C } = { h: { k: "c", f: 1.5 } }
if z.h.k == "c" { print(z.h.f) } else { print("not c") }
if z.h.k == "a" { print(z.h.v) } else { print("else3") }
const m: { h: A | B } = { h: { k: "b", s: "mut" } }
m.h = { k: "a", v: 9 }
if m.h.k == "a" { print(m.h.v) }
