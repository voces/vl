// Regression (silent-class-inventory D87), graduated from
// `soundness/xfail-miscompile-arm-valued-map-local-into-map-param.vl`.
//
// An UN-ANNOTATED map local (`const c = Map()`) whose value is written as an anonymous
// object literal and which is then handed to a parameter annotated `{[string]: Circle}` —
// a map over a union ARM. On master `933e2cbf` every cell below was `vl check` rc 0 with NO
// diagnostics at all and a module the engine refuses:
//
//   type mismatch: expected (ref $type), found (ref $type)
//
// IT WAS A REGRESSION, AND THE BISECT NAMED THE COMMIT. This program RAN, printing 7, on
// `6ac49ac9` (#1951) — a seed rebuilt from that commit's own sources at 1,437,150 bytes,
// which reproduces the size that PR published and is therefore self-verifying — and is
// check-clean invalid wasm from `2ea654d2` (#1952, 1,437,704 bytes) onward. #1952 reported
// "0 backward" truthfully: its 770-cell grid had no map-valued container. It was found by
// re-running D52's own 9,450-cell grid against today's master, which graded 212 silent
// where #1951 had reported 116.
//
// AND THE CONTROL THAT DECIDED WHOSE PROBLEM IT WAS FLIPPED UNDER IT. When it was filed,
// ANNOTATING the local was a different LOUD floor, which is what said "not the destination
// channel". #1954 then taught the arm-valued map to lower under the inline spelling and the
// same control began to RUN — so the annotated spelling works, the un-annotated one did
// not, and that is the ordinary shape of `synthDstPinAnn`'s family: an annotation the
// producer never saw. Two helper widenings, no new leg:
//
//   armPinAnnName   accepts a MAP whose VALUE names an arm, beside the bare arm and the
//                   ref-list of one
//   armPinLitInit   accepts a bare `Map()` / `Set()`, by the rule its header states rather
//                   than by resemblance: an EMPTY map commits no value rep at its
//                   initializer, so its slot is chosen by later use. A map-RETURNING call
//                   is NOT admitted, which is why the test is the constructor name
//
// Both helpers are SHARED with `synthRetPinAnn` and all four destination legs, so the cost
// was measured rather than argued: 0 cells of the 3,144-cell D87 grid move at all (0
// outcome, 0 message), the 9,450-cell D52 grid goes 278 -> 50 silent with 0 backward, and
// the corpus is 1,868 of 1,868 byte-identical.
//
// THE RESIDUE IS FILED AS D88, not left: 20 of the 96 cells need the GENERIC hop
// (`idg(thru(c))`) and are a different root — no twin needed, and annotating the local does
// not help them either.
// @run
// @log 7
// @log 7
// @log 7
// @hint redundant type annotation: `m` is inferred as `{[string]: {r: i32}}`
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Dot = { r: i32 }

function thru(x: {[string]: Circle}) { return x }
function sink(x: {[string]: Circle}) { return (x["k"] ?? { r: 0 }).r }

// D87's own filed repro, byte-for-byte.
function mk(n: i32) {
  const c = Map()
  c["k"] = { r: n }
  return thru(c)
}
print(((mk(7))["k"] ?? { r: 0 }).r)

// The same seam at the other two destinations the channel reaches: a callee whose result
// is an i32 (so the map never leaves), and an annotated LOCAL binding.
function mkSink(n: i32) {
  const c = Map()
  c["k"] = { r: n }
  return sink(c)
}
print(mkSink(7))

function mkBind(n: i32) {
  const c = Map()
  c["k"] = { r: n }
  const m: {[string]: Circle} = c
  return (m["k"] ?? { r: 0 }).r
}
print(mkBind(7))
