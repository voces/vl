// A `T | null` from `x as? Shape`, narrowed by `!= null`, delivered where a plain `Shape` is
// owed: passed, bound, returned, as a list element, and at top level. The narrowed value is
// already the destination union's box, so each delivery hands it over without re-boxing.
// @hint redundant type annotation: `t` is inferred as `Shape`
type Circle = { kind: "circle", r: f64 }
type Rect = { kind: "rect", w: f64 }
type Oops = { why: string }
type Shape = Circle | Rect
type Parsed = Circle | Rect | Oops
function parse(k: i32): Parsed {
  if k == 0 { return { kind: "circle", r: 1.5 } }
  if k == 1 { return { kind: "rect", w: 2.5 } }
  return { why: "no" }
}
function size(s: Shape) {
  if s is Circle { return s.r }
  return s.w
}
function passed(k: i32) {
  const s = parse(k) as? Shape
  if s != null { print(size(s)) } else { print(-1) }
}
function bound(k: i32) {
  const s = parse(k) as? Shape
  if s != null {
    const t: Shape = s
    print(size(t))
  }
}
function returned(k: i32): Shape {
  const s = parse(k) as? Shape
  if s != null { return s }
  return { kind: "rect", w: 0.5 }
}
function listed(k: i32) {
  const s = parse(k) as? Shape
  if s != null {
    const xs: Shape[] = [s]
    print(size(xs[0]))
  }
}
passed(0) // 1.5
passed(2) // -1
bound(1) // 2.5
print(size(returned(2))) // 0.5
listed(0) // 1.5
const gs = parse(1) as? Shape
if gs != null {
  print(size(gs)) // 2.5
}
