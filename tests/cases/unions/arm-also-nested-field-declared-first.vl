// @run
// @log 2
// @log 8
// @log g
// @log 1
// @log 16
// @log 2
// @log f
// THE OTHER DECLARATION ORDER of `arm-also-nested-field-of-another-arm.vl` (D1518). With
// `B | E` registered FIRST, `variantIndexOf("B")` already answers when `collectVariantFields`
// codes `M`'s field, so `nameIsStructDecl` declines and the field had no code —
// `only i32 / boolean / string / array union-variant fields are supported`, a sentence that
// was false of f64, i64, f32, map, nested-struct, struct-list, nullable-struct, union-box and
// closure variant fields, every one of which already ran.
//
// The fix is order-independent by construction: the arm-field mint runs over EVERY
// `TypeDecl`'s fields (a declaration that is itself an arm has the same field TARGETS), and
// the field code is decided by a PURE predicate that obligates it.
type E = { msg: string }
type B = { base: i32, length: i32 }
type M = { a: B, n: i32 }

function g(ok: boolean): B | E {
  if !ok { return { msg: "g" } }
  return { base: 2, length: 8 }
}

function f(ok: boolean): M | E {
  if !ok { return { msg: "f" } }
  return { a: { base: 1, length: 16 }, n: 2 }
}

const b = g(true)
if b is B {
  print(b.base)
  print(b.length)
}
const be = g(false)
if be is E { print(be.msg) }

const m = f(true)
if m is M {
  print(m.a.base)
  print(m.a.length)
  print(m.n)
}
const me = f(false)
if me is E { print(me.msg) }
