// @run
// @log 77
// @log 3
// @log 77
// @log 77
// @log 3
// @log 10
// @log 50
// @log 77
// @log 3
// @log 77
// @log 5
// @log 3
// @log 77
// @log 2
// @log 8
// @log 16
// @warning `b.v == null` is always false here (b.v is i32)
// @warning `x` shadows the `x` declared at
// @warning `b` shadows the `b` declared at
// A join narrows a binding, not a name (D3285): a second binding of the name in an inner block, a
// loop body, a loop variable, a lambda parameter or a path root's shadow reads at its own type,
// and a write to the inner binding neither retires nor narrows the outer one.
function nn(v: i32): i32 | null {
  if v < 0 { return null }
  return v
}

function block(k: i32) {
  let x = nn(k)
  if x == null { x = 2 }
  {
    const x: i32 | null = null
    print(x ?? 77)
  }
  return x + 1
}
print(block(-1))

function loop(k: i32) {
  let x = nn(k)
  if x == null { x = 2 }
  let i = 0
  while i < 2 {
    const x: i32 | null = null
    print(x ?? 77)
    i = i + 1
  }
  return x + 1
}
print(loop(-1))

function inner(k: i32) {
  const x = nn(k)
  {
    let x = nn(k)
    if x == null { x = 9 }
    print(x + 1)
  }
  return x ?? 50
}
print(inner(-1))

function lambda(c: boolean) {
  let x: i32 | null = 4
  if c { x = 2 } else { x = 3 }
  const k = (x: i32 | null) => x ?? 77
  print(k(null))
  return x + 1
}
print(lambda(true))

function forIn(k: i32, xs: (i32 | null)[]) {
  let x = nn(k)
  if x == null { x = 2 }
  for x in xs { print(x ?? 77) }
  return x + 1
}
print(forIn(-1, [null, 5]))

type B = { v: i32 | null }
function path(b: B) {
  if b.v == null { b.v = 1 }
  {
    const b: B = { v: null }
    print(b.v ?? 77)
  }
  return b.v + 1
}
print(path({ v: nn(-1) }))

// A straight-line fill before a loop whose body writes null again: the loop's top reads wide.
function strip() {
  let s = 0
  let x: i32 | null = 4
  x = 8
  let i = 0
  while i < 2 {
    if x != null { s = s + x }
    x = null
    i = i + 1
  }
  return s
}
print(strip())

// Nested joins over a field, both last arms filling.
function nestedField(b: B, c: boolean, d: boolean, k: i32) {
  if d {
    if b.v == null {
      b.v = 7
      b.v = nn(k)
      b.v = 7
    }
  } else {
    b.v = 7
  }
  if c && b.v == null {
    b.v = null
    b.v = 7
  } else {
    b.v = 7
  }
  return b.v + 1
}
print(nestedField({ v: null }, true, true, -1) * 2)
