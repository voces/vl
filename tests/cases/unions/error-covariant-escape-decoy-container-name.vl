// @error written through
// D1610 — the container-field edge survives a binding of the container's name elsewhere.
// D852 keys the escaped-handle edge on the container's binding name plus the field name, and
// guards it with "bound exactly once, never assigned", so the name stands for one container.
// Counting those bindings over the whole program let `decoy`'s own `bx` — a different type in
// a frame that cannot see this one — spend the guard, drop the edge, and lose the refusal to
// check-clean invalid wasm. The count is per frame now; renaming `decoy`'s `bx` is the
// ablation, and `decoy` is never called, so reachability is not what carries this.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box = { xs: Shape[] }

function decoy(): i32 {
  const bx: Box = { xs: [] }
  bx.xs.length
}

function f() {
  const a: Circle[] = [{ r: 7 }]
  const b: Shape[] = a
  const bx: Box = { xs: b }
  const c = bx.xs
  c.push({ s: 3 })
  print(a.length)
  print(b.length)
}

f()
print(decoy())
