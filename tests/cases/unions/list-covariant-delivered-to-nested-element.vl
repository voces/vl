// @run
// @log 7
// @log 1
// @hint redundant type annotation: `a` is inferred as `{r: i32}[]` — remove it to lean on inference
// @hint redundant type annotation: `nn` is inferred as `Shape[][]` — remove it to lean on inference
// A covariant list delivered into a nested element (D1628).
//
// `[b]` is the struct-field escape one container kind over: the list goes inside an array
// literal and `nn[0]` takes it back out under no name at all, so any write anywhere left
// the answer `2` and the module failed to validate on a file `vl check` reported clean.
// The escape is filed under the container's name and an element key no field name can
// spell, so `nn[i]` matches it for any `i` — an over-approximation whose only effect is to
// find more writes, and the sibling refusal fixture is what proves it finds them.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq

function f() {
  const a: Circle[] = [{ r: 7 }]
  const b: Shape[] = a
  const nn: Shape[][] = [b]
  const e = nn[0][0]
  if e is Circle { print(e.r) }
}

function other() {
  const w: Shape[] = []
  w.push({ s: 3 })
  print(w.length)
}

f()
other()
