// @run
// @hint redundant type annotation: `r` is inferred as `i32[]` — remove it to lean on inference
// @log false
// @log 3
// @log false
// @log 2
// @log false
// @log 1
// @log true
// A function's own parameter or local boxed into a union return keeps its own arm when a
// top-level block binds the same name to a nullable record, so `is` answers for the value the
// function returned rather than the block's binding's type (D2245, from consumer plumb PL-024).

type Err = { code: i32, msg: string }

function readAll(): i32[] | Err {
  const r: i32[] = [1, 2, 3]
  r
}

function readParam(r: i32[]): i32[] | Err { r }

function readFor(): i32[] | Err {
  for r in [[4]] {
    const out: i32[] | Err = r
    return out
  }
  { code: 1, msg: "empty" }
}

const a = readAll()
print(a is Err)
if !(a is Err) { print(a.length) }
const b = readParam([5, 6])
print(b is Err)
if !(b is Err) { print(b.length) }
const c = readFor()
print(c is Err)
if !(c is Err) { print(c.length) }

if true {
  const r: Err | null = { code: 2, msg: "block" }
  print(r != null)
}
