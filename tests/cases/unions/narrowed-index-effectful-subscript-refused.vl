// @error field 'r' is not on every member of M
// An effectful subscript names no place the test narrowed, so its read is not narrowed.
type A = { r: i32 }
type M = i32 | A
let k = 0
function next() {
  k = k + 1
  return k - 1
}
function f() {
  const xs: M[] = [{ r: 1 }, { r: 2 }, 7]
  if xs[next()] is A { print(xs[next()].r) }
}
f()
