// @run
// @log a
// @log b
// @log 3
// @log b
// A record field typed by a literal-union alias beside one typed by the same set inline: each
// takes the rep its spelling decides, and each reads back its own member.
type K = "a" | "b"
type RA = { k: K }
type RI = { k: "a" | "b" }
function ka(r: RA): string { r.k }
function ki(r: RI): string { r.k }
const ra: RA = { k: "a" }
const rb: RA = { k: "b" }
const ri: RI = { k: "b" }
print(ka(ra))
print(ki(ri))
const xs = [ra, rb]
const ys = [ri]
print(xs.length + ys.length)
print(xs[1].k)
