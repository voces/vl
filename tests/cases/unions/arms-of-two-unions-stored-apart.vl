// @run
// @log 0
// @log 0
// @log 7
// D14567: two arms of two unions that share a field-name signature and a literal field keep
// their own heap types in a binding annotated at the arm, local or module-level.
type K = "a" | "b"
type Named = { r: i32, k: K }
type NOther = { o: string }
type NShape = Named | NOther
type K3 = "a" | "b" | "c"
type Tri = { r: i32, k: K3 }
type TOther = { o: string }
type TShape = Tri | TOther
type TW2 = { g: Tri }

const t: Tri = { r: 0, k: "a" }
const tp: TW2 = { g: t }
print(tp.g.r)

function f() {
  const u: Tri = { r: 0, k: "b" }
  const up: TW2 = { g: u }
  print(up.g.r)
}
f()

function g(): NShape { { r: 7, k: "b" } }
const n = g()
if n is Named { print(n.r) }
