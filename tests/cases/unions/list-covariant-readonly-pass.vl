// @run
// @log 1
// @log 7
// @log 1
// @log 7
// @hint redundant type annotation: `a` is inferred as `{r: i32}[]` — remove it to lean on inference
// THE HINT IS DECLARED, NOT REMOVED: `const a: Circle[]` is the whole subject of this
// fixture. Deleting the annotation to silence the hint would delete the covariant pass.
// READ-ONLY COVARIANCE: a `Circle[]` reaching a `Shape[]` destination, at the two spellings
// D773 filed (a binding and a parameter). Both were `vl check` rc 0 and an INVALID MODULE
// before D791 — a CLAUSE-1 soundness violation on a program that writes nothing.
//
// `DECISIONS.md` already ruled this legal under "Variance and exactness: inferred, with no
// annotation surface in v1": the `Readable` half of A9 says a read-only covariant pass is
// sound and the checker already agrees. What was missing was the REPRESENTATION — a mutable
// WasmGC array is invariant, so `(array (mut (ref null $Circle)))` and `(array (mut (ref
// null $uBox)))` are unrelated heap types with no `(sub …)` edge available. The lowering is
// an element-converting COPY, and for a read-only destination a copy is indistinguishable
// from the alias: no observation can tell them apart.
//
// THE CONTROL IS `look(b)` ON THE LAST LINE. `b` is already a `Shape[]`, so its delivery
// widens NOTHING and must stay a plain pointer pass; if the widening ever fires on a
// same-row pair this fixture is the one that catches it.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function look(xs: Shape[]) { print(xs.length) }
function f() {
  const a: Circle[] = [{ r: 7 }]
  const b: Shape[] = a
  print(b.length)
  print(a[0].r)
  look(a)
  print(a[0].r)
}
f()
