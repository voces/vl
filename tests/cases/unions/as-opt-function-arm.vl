// @run
// @log 3
// @log 17
// @log 8
// @log false
// @log 12
// @log none
// @log rnone
// @log true
// @log xnone
// @log 3
// @log no
// @log 4
// @log no
// `as?` to the function arm of a union box is the closure on the hit and `null` on the miss
// (D4018): bound, returned, in a record field, compared with `null`, in a list, and over a
// box whose other arm is a string, an `i32` or another function.
type F = (x: i32) => i32
function id(x: i32) { return x }
function mk(k: i32): F { return (x: i32) => x + k }
function pick(v: F | string): F | null { return v as? F }
function show(w: boolean) {
  let v: F | string = "z"
  if w { v = id }
  const g = v as? F
  if g != null { print(g(3)) }
}
function main(v: F | string) {
  const g = pick(v)
  if g != null { print(g(10)) } else { print("none") }
  const r = { f: v as? F }
  const rf = r.f
  if rf != null { print(rf(1)) } else { print("rnone") }
  print((v as? F) == null)
  const xs: (F | null)[] = [v as? F]
  const x0 = xs[0]
  if x0 != null { print(x0(5)) } else { print("xnone") }
}
function viaI32(v: F | i32) {
  const g = v as? F
  if g != null { print(g(3)) } else { print("no") }
}
function viaFn(v: F | ((x: string) => string)) {
  const g = v as? F
  if g != null { print(g(4)) } else { print("no") }
}
function nm(x: string) { return x }
show(true)
show(false)
main(mk(7))
main("s")
viaI32(id)
viaI32(4)
viaFn(id)
viaFn(nm)
