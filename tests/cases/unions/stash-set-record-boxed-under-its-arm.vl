// @run
// @log 9
// @log 18
// A record literal written out of layout order with a valued `if` field (its fields set into
// the order stash) boxed into a union under its own arm: the arm's tag leads the literal.
type A = { a: i32, k: i32 }
type B = { s: string }
type U = A | B
function put(x: i32): U {
  const u: U = { k: x * 2, a: if x > 0 { x } else { 0 } }
  return u
}
const p = put(9)
if p is A {
  print(p.a)
  print(p.k)
}
