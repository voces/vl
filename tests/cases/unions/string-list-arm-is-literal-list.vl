// @run
// @log 1
// @log 1
// @log 1
// @log 102
// @log 1
// @log 1
// @log 1
// @log a
// @log c
// @log fits
// @hint redundant type annotation: `v` is inferred as `string[]`
// @hint redundant type annotation: `c` is inferred as `string[]`
// D4779: over `string[] | S[]`, `is S[]` tests a `string[]` arm's elements, so a `string[]`
// whose every element fits `S` (or that is empty) fits `S[]`.
type S = "a" | "b"
function f(x: string[] | S[]) {
  if x is S[] { print(1) } else { print(x.length + 100) }
}
function g(x: string[] | S[]) {
  if x is string[] { print(1) } else { print(0) }
}
function h(x: string[] | S[]) {
  if x is S[] {
    print("fits")
  } else {
    for s in x { print(s) }
  }
}
const v: string[] = ["a"]
const w: S[] = ["b"]
const e: string[] = []
const es: S[] = []
const c: string[] = ["a", "c"]
f(v)
f(w)
f(e)
f(c)
g(w)
g(es)
g(v)
h(c)
h(v)
