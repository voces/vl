// @run
// @log null
// @log 9
// @log true
// A `let x = null` a hole parameter fills under an `if` keeps the parameter's member through the
// join with `null`, so the reads after it see the write (D17850).
function f(a) {
  let t = null
  if a > 5 { t = a }
  return t
}
print(f(1))
print(f(9))
print(f(1) == null)
