// @run
// @log 6
// @log 16
// @log 2
// @log 5
// @hint redundant type annotation: `area` is inferred as `f64`
// CONTRACT (D1473): a union whose arms are written INLINE narrows on its literal
// discriminant exactly as the same union with NAMED arms does. An inline arm has
// no `type` name, so the discriminant push resolves its variant row by canon's own
// RENDER of the arm; without that the read reaches the emitter un-narrowed and
// takes the `field access but no struct type declared` floor on a check-clean
// program. The `is` spelling cannot be written here — an inline arm has no name to
// test — which is why every other fixture in this family names its arms.
type Shape = { kind: "circle", r: f64 } | { kind: "rect", w: f64, h: f64 }

function area(s: Shape): f64 {
  if s.kind == "rect" { return s.w * s.h }
  return s.r * s.r
}

print(area({ kind: "rect", w: 2.0, h: 3.0 }))
print(area({ kind: "circle", r: 4.0 }))

// Module scope, both arms of one `if` — the wrapper is not an ingredient.
const s: Shape = { kind: "rect", w: 2.0, h: 3.0 }
if s.kind == "rect" { print(s.w) } else { print(s.r) }

const c: Shape = { kind: "circle", r: 5.0 }
if c.kind == "rect" { print(c.w) } else { print(c.r) }
