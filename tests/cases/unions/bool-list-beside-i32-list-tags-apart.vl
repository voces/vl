// @run
// @log -1
// @log true
// @log -2
// @log 1
// @log -1
// @log I
// @log 8
// @log 103
// @log B
// @log true
// @log false
// @log 2
// @log b
// @log i
// @log true
// @log 6
// @log s
// @log nb
// @log 3
// @log 4
// @log true
// D2769, D2813: `boolean[]` and `i32[]` share the i32 list's storage and tag apart in a union
// box, so `is`, `match`, `as?` and the element reads answer for the arm that built the value.
function h(c: boolean, t: boolean) {
  if c { return [t] }
  [1]
}
const q = h(false, true)
if q is boolean[] { print(q[0]) } else { print(-1) }
const r = h(true, true)
if r is boolean[] { print(r[0]) } else { print(-1) }
if r is i32[] { print(r[0]) } else { print(-2) }
if q is i32[] { print(q[0]) } else { print(-2) }
function g(u: boolean, c: boolean) {
  if c { return [u] }
  [1, 2]
}
function relay(c: boolean) { return g(true, c) }
const rq = relay(false)
if rq is boolean[] { print(rq[0]) } else { print(-1) }
function mk(c: boolean): boolean[] | i32[] {
  if c { return [true, false] }
  [7, 8, 9]
}
function use(v: boolean[] | i32[]) {
  match v {
    boolean[] => print("B")
    i32[] => print("I")
  }
  if v is boolean[] {
    for x in v { print(x) }
  } else {
    print(v[1]); print(v.length + 100)
  }
  0
}
use(mk(false))
use(mk(true))
const ab = mk(true) as? boolean[]
if ab != null { print(ab.length) } else { print(0) }
function show(v: i32[] | boolean[]) {
  if v is i32[] { print("i") } else { print("b") }
}
show([true])
show([1])
function three(k: i32): boolean[] | i32[] | string {
  if k == 0 { return [true] }
  if k == 1 { return [5] }
  "s"
}
const xs = [three(0), three(1), three(2)]
for x in xs {
  if x is boolean[] { print(x[0]) }
  else if x is i32[] { print(x[0] + 1) }
  else { print(x) }
}
function nb(c: boolean): (boolean | null)[] | i32[] {
  if c { return [null, true] }
  [3]
}
const n0 = nb(true)
if n0 is i32[] { print(n0[0]) } else { print("nb") }
const n1 = nb(false)
if n1 is i32[] { print(n1[0]) } else { print("nb") }
function get(c: boolean): boolean[] | null {
  if c { return [true] }
  null
}
const y = get(false) ?? [4]
if y is boolean[] { print("B") } else { print(y[0]) }
const z = get(true) ?? [4]
if z is boolean[] { print(z[0]) } else { print("I") }
