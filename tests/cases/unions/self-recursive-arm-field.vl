// @run
// @log 1
// @log 7
// @log 9
// @log O>O
// @log 2
// @log 4
// @log 6
// @log 3
// @log 4
// A union arm whose own field names the arm (`next: O | null` inside `U = O | P`), or a
// sibling arm, codes that field as the struct ref it waits for (D3329): built, read through
// the union, narrowed, walked to its end, mutually recursive with a sibling, held by a
// union-typed field, and the tail-`if` join that makes a recursive struct an arm (D2174).
type O = { n: i32, next: O | null }
type P = { m: i32 }
type U = O | P
type W = { u: U | null }

function sum(u: U) {
  if u is O {
    let t = 0
    let c: O | null = u
    while c != null {
      t = t + c.n
      c = c.next
    }
    return t
  }
  return u.m
}

function walk(u: U) {
  if u is O {
    if u.next != null { return "O>" + walk(u.next) }
    return "O"
  }
  return "P"
}

const one: O = { n: 1, next: null }
print(one.n)
const a: O = { n: 1, next: { n: 2, next: { n: 4, next: null } } }
print(sum(a))
const p: U = { m: 9 }
print(sum(p))
print(walk(a.next ?? one))

type A = { n: i32, b: B }
type B = { m: i32, a: A | null }
type V = A | B
const x: A = { n: 1, b: { m: 2, a: { n: 3, b: { m: 4, a: null } } } }
const v: V = x
if v is A {
  print(v.b.m)
  if v.b.a != null { print(v.b.a.b.m) }
}

const w: W = { u: { n: 5, next: { n: 6, next: null } } }
const wu = w.u
if wu != null {
  if wu is O { print(wu.next?.n ?? 0) }
}

type Node = { v: i32, left: Node | null }
function insert(n: Node, k: i32) {
  const m: Node = { v: k, left: null }
  if n.left == null { n.left = m }
  else if n.v < 0 { n.v = 0 }
  else { insert(n.left, k) }
}
const root: Node = { v: 5, left: null }
insert(root, 3)
insert(root, 4)
print(root.left?.v ?? 0)
print(root.left?.left?.v ?? 0)
