// @run
// @log 105
// @log 4
// @log end
// @log b
// @log is end
// @log end
// @log b
// @log E
// @log 3
// @log zz
// @log b
// @log true
// @hint redundant type annotation: `total` is inferred as `i32`
// @hint redundant type annotation: `sk` is inferred as `string`
// A field every arm shares, stored as a literal-union atom in one arm and as a string in
// another, read in a function, at module scope, as a list element, by `match` and as a map
// key, typed as the literal union or as `string` (D5105).
type Node = { kind: "a" | "b", v: i32, next: Node | null } | { kind: "end" }
function total(n: Node | null): i32 {
  if n == null { return 0 }
  if n.kind == "end" { return 100 }
  return n.v + total(n.next)
}
const a: Node = {
  kind: "a",
  v: 3,
  next: { kind: "b", v: 2, next: { kind: "end" } },
}
const b: Node = { kind: "b", v: 4, next: null }
print(total(a))
print(total(b))
function kindOf(n: Node): "a" | "b" | "end" { n.kind }
const e: Node = { kind: "end" }
print(kindOf(e))
print(kindOf(b))
if e.kind == "end" { print("is end") }
const ns: Node[] = [e, b]
for n in ns { print(n.kind) }
match e.kind {
  "a" => print("A")
  "b" => print("B")
  "end" => print("E")
}
const m = Map<string, i32>()
m.set(b.kind, 3)
print(m.get("b") ?? 0)
type S = { kind: "a" | "b", v: i32 } | { kind: string, w: i32 }
function sk(s: S): string { s.kind }
const x: S = { kind: "zz", w: 2 }
const y: S = { kind: "b", v: 1 }
print(sk(x))
print(sk(y))
print(x.kind == "zz")
