// @run
// @log 11
// @log 20
// @log 42
// @log two
// @log 7
// @log pos
// @log true
// @log null
// @log 100
// @log 64
// SEVEN of the eight emitter sites that ask the PAREN grammar — "does this type name OPEN a
// paren group?" and "does that group's span END at the last character?" — through
// `emit_base.nameIsParenOpen` / `nameIsParenSpanEnds`, in one program. The witness for
// D-PARENHOME, which routed each of them off its own hand-written character compare. The
// eighth is named below, with the measurement that says it is covered elsewhere.
//
// OPEN home (`name[0] == '('`):
//   * `nameIsClosureArray`    — an ARRAY of function types, `((i32) => i32)[]`
//   * `parenUnionArrElemName` — a value-union array, `(string | i32)[]`
//   * `annFnDecompose`        — a GENERIC instantiated with a function-type param
//   * `emit_collect` 3972     — a function type whose RETURN is an inline union
//
// The eighth OPEN site — `emit_mono` 973, the annotated fn-type param that pins an
// UN-ANNOTATED HOF return — is deliberately NOT here. It already has a dedicated regression
// test, `tests/cases/closures/hof-inferred-return-through-callback.vl`, and that test was
// MEASURED load-bearing for it: making the branch unreachable reddens that file and only that
// file, out of 1,414. It also cannot share this file — a generic with a function-type param
// (`ap<T>` below) and such a HOF in ONE program emit invalid wasm ON MASTER ("expected i32,
// found (ref null $type)"), a PRE-EXISTING defect this slice measured, did not introduce, and
// does not fix.
//
// SPAN home (that, plus a final `)`):
//   * `listElemNameOf`   — the niche-nullable list element `(boolean | null)[]`
//   * `peelGroupParens`  — a union member that KEEPS its grouping parens, `(() => i64) | i64`
//   * `normTypeAtom`     — the union-ARM normalization those two arms ride through
//
// The two halves are separated on purpose. `(string | i32)[]` and `((i32) => i32)[]` OPEN with
// `(` and do NOT end with `)` — they end with `]` — so a SPAN home wrongly used at an OPEN site
// mis-sorts them, while `(() => i64) | i64` opens with `(` and does not end with `)` either.
// Only `(() => i64)` as a split union ATOM both opens and spans, which is what makes the arm
// normalization the one site where the closing test is load-bearing.

// ── OPEN: an array whose ELEMENT is a fully-parenthesized function type ──────────────
function closureArray() {
  const fns: ((i32) => i32)[] = [(x: i32) => x + 1, (x: i32) => x * 2]
  print(fns[0](10))
  print(fns[1](10))
}

// ── OPEN: a value-union ARRAY, whose element name is the parenthesized union ─────────
function unionArray() {
  const mixed: (string | i32)[] = [42, "two"]
  const a = mixed[0]
  if a is i32 { print(a) } else { print("notint") }
  const b = mixed[1]
  if b is string { print(b) } else { print("notstr") }
}

// ── OPEN: a GENERIC whose param is a function type — `annFnDecompose` splits the
// pattern AND the actual on every instantiation.
function ap<T>(f: (T) => T, x: T): T {
  return f(x)
}
function addFive(n: i32): i32 {
  return n + 5
}

// ── OPEN: a function type whose RETURN is an inline union — `emit_collect` registers it.
function classify(n: i32): i32 | string {
  if n > 0 {
    return "pos"
  }
  return n
}
function collectUnionRet() {
  const f: (i32) => i32 | string = classify
  const r = f(1)
  if r is string { print(r) } else { print(r) }
}

// ── SPAN: the niche-nullable list element `(boolean | null)[]` — `listElemNameOf` peels
// the element's grouping parens with the deliberately NAIVE strip (no balance walk).
function nulBoolList() {
  const nb: (boolean | null)[] = [true, null]
  const e0 = nb[0]
  if e0 != null { print(e0) } else { print("null") }
  const e1 = nb[1]
  if e1 != null { print(e1) } else { print("null") }
}

// ── SPAN: a union member that keeps its grouping parens through the split, so the
// `is`-test spelling must be paren-peeled to byte-match the atom.
function cloUnion(p: (() => i64) | i64) {
  if p is () => i64 { print(p()) } else { print(p) }
}

closureArray()
unionArray()
print(ap(addFive, 2))
collectUnionRet()
nulBoolList()
cloUnion(() => 100)
cloUnion(64)
