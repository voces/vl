// @emit-error union atom has no value box
// A generic's inferred `T[] | i32[]` return read by `.length` in the complement of `is T[]`:
// the `else` arm's read lowers through the scalar union path (D5111).
function w<T>(t: T, b: boolean) {
  if b { return [t] }
  [1, 2, 3]
}
function ex<T>(t: T, b: boolean) {
  const u = w(t, b)
  if u is T[] { print(0) } else { print(u.length) }
}
ex("s", true)
ex("s", false)
