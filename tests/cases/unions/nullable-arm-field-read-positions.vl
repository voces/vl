// @run
// @log s
// @log s
// @log b
// @log 7
// @log true
// @log hi
// @log true
// @log b
// @log b
// @log b
// @log b
// @log b
// @log b
// READING A FIELD THROUGH AN `Arm | null` RECEIVER (D1094) — the FIFTH receiver shape of the
// member field-code ladder, at every source that can produce one.
//
// THE LADDER HAD FOUR: a NARROWED union identifier, a bare variant-typed expression, a plain
// struct, and an un-narrowed struct union. A `nulvariant` cell is none of them, and
// `structIndexOfExpr` declines it BY DESIGN (D34 — an arm value has no `sNames` row), so every
// classifier reading through the ladder answered -1 and fell back to its i32 default. The
// bytes were always right: `struct.get $S <i>` off the narrowed non-null ref. Only the
// CONSUMER's idea of what came back was missing, which is why the SAME missing rung wore two
// faces — a litunion-alias field printed its raw ATOM ID (`0` where `b` belongs, rc 0 and a
// valid module) while the reads that need a ref (a string field's `print`, a member `==`) were
// check-clean INVALID WASM.
//
// EVERY LINE PRINTS THROUGH THE FIELD, never an id that could coincide: the atom reads print
// the member string, the i32 read prints `n * 7`, and the string read prints its own text.
type K = "a" | "b"
type S = { k: K, n: i32 }
type Str = { t: string, n: i32 }
type Other = { o: string }
type U = S | Other
type SU = Str | Other
type W = { g: S | null }

function mk(): U { { o: "x" } }
function smk(): SU { { o: "y" } }
function g(n: i32): S | null {
  if n == 0 { return { k: "b", n: 1 } }
  null
}
function sg(n: i32): Str | null {
  if n == 0 { return { t: "hi", n: 1 } }
  null
}
// The PARAM source, and the read that has to widen inside a callee.
// @hint redundant type annotation: `readK` is inferred as `string`
function readK(v: S | null): string {
  if v == null { return "none" }
  v.k
}

// `S` and `Str` are arms, which is the whole ingredient — delete these two `is` tests and the
// same reads print their members on master too.
const t = mk()
if t is S { print("s") } else { print("s") }
const st = smk()
if st is Str { print("s") } else { print("s") }

// SOURCE 1 — a CALL returning the niche. The atom read, an i32 read through the same
// receiver, and a member compare.
const v = g(0)
if v == null { print("none") } else { print(v.k) }
if v == null { print(0) } else { print(v.n * 7) }
if v == null { print(false) } else { print(v.k == "b") }

// SOURCE 2 — the same niche over a STRING field: the face that was invalid wasm rather than a
// wrong value.
const sv = sg(0)
if sv == null { print("none") } else { print(sv.t) }
if sv == null { print(false) } else { print(sv.t == "hi") }

// SOURCE 3 — an annotated module GLOBAL.
const gv: S | null = { k: "b", n: 2 }
if gv == null { print("none") } else { print(gv.k) }

// SOURCE 4 — a STRUCT FIELD typed at the niche.
const w: W = { g: { k: "b", n: 3 } }
const we = w.g
if we == null { print("none") } else { print(we.k) }

// SOURCE 5 — a ref-list ELEMENT of `(S | null)[]`.
const xs: (S | null)[] = [{ k: "b", n: 4 }]
const xe = xs[0]
if xe == null { print("none") } else { print(xe.k) }

// SOURCE 6 — a MAP value read, which is `S | null` by construction.
const m: {[string]: S} = Map()
m["z"] = { k: "b", n: 5 }
const me = m["z"]
if me == null { print("none") } else { print(me.k) }

// SOURCE 7 — a PARAM, read inside the callee.
print(readK({ k: "b", n: 6 }))

// SOURCE 8 — a LOCAL of the niche type, inside a function.
// @hint redundant type annotation: `localRead` is inferred as `string`
function localRead(): string {
  const lv: S | null = { k: "b", n: 7 }
  if lv == null { return "none" }
  lv.k
}
print(localRead())
