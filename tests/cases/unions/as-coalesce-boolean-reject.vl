// @emit-error is not supported for a boolean arm
// `x as? boolean` REFUSED — the one target left, and a genuine rep DIFFERENCE rather than a
// missing rep. This file replaces `as-coalesce-no-nullable-rep.vl`, whose refusal covered
// three shapes that all work now.
//
// `boolean | null` is the SENTINEL niche: a plain i32 carrying `2` for null (the host's
// `nullSentinel`), not a box and not a nullable ref. Every other `as?` target is one of those
// two — the string arm a `(ref null $sTypeIdx)`, a variant arm a `(ref null $uVarHeap[vi])`,
// a sub-union and the four NUMERIC arms a box with the null riding the tag — so the boolean
// is the single shape neither existing lowering fits. Emitting one of them anyway would put a
// ref where a scalar is expected.
//
// WHAT THIS FILE USED TO SAY, recorded because the claim was wrong rather than merely
// outdated: it refused every scalar arm on the ground that "a scalar arm is a value niche (a
// sentinel inside the scalar)". That is true of `boolean` and false of `i32`/`i64`/`f64`/
// `f32`, which lower as BOXES — measured in the disassembly, and stated independently by
// `isValueUnionName`'s solo rule, which admits exactly those four. One arm's rep was
// generalised to the whole family without being checked. The four are pinned in
// `as-coalesce-scalar-arms.vl`.
//
// THE REMEDY is the explicit ladder, which lowers today:
//
//     const ok = if v is boolean { v } else { false }
type Count = { n: i32 }

function pick(b: boolean): boolean | Count {
  if b { return true }
  { n: 3 }
}

function okOf(b: boolean) {
  const c = pick(b) as? boolean
  if c != null { return 1 }
  -1
}
print(okOf(true))
