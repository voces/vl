// @emit-error object literal writes a field its union variant does not declare
// @hint redundant type annotation: `x` is inferred as `Cat`
// The nullable-field face of D2302. `Cat`'s only field admits `null`, so leaving it out is
// legal, but the literal reaching the arm builder is the call ARGUMENT `{ p: 9 }`, a `P`:
// building it as `Cat` dropped `p` and handed `take` the wrong struct, which did not validate.
// A literal writing a field the arm does not declare is refused rather than built.
type Cat = { c: i32 | null }
type Dog = { d: i32 }
type U = Cat | Dog
type P = { p: i32 }
function take(p: P): Cat { { c: p.p } }
const x: Cat = take({ p: 9 })
const cv = x.c
if cv != null { print(cv) } else { print(7) }
