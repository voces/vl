// @run
// @log a
// @log a
// @log wa
// @log va
// @log a
// @log true
// @hint redundant type annotation: `h` is inferred as `string`
// A write through the union to a literal-union field every arm shares stores at each arm's
// own atoms, when the arms' sets differ: at a parameter, a list element and a binding (D5158).
type M = { k: "a" | "b", v: i32 } | { k: "a" | "end", w: boolean }
function g(n: M, s: "a") {
  n.k = s
  n.k
}
function h(n: M): string {
  n.k = "a"
  if n is { k: "a" | "b", v: i32 } { return "v" + n.k }
  "w" + n.k
}
const x: M = { k: "end", w: true }
const y: M = { k: "b", v: 1 }
print(g(x, "a"))
print(g(y, "a"))
print(h(x))
print(h(y))
const ms: M[] = [x, y]
ms[1].k = "a"
print(ms[1].k)
const z: M = { k: "b", v: 2 }
z.k = "a"
print(z.k == "a")
