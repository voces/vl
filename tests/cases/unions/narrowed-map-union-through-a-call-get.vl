// @run
// @log 5
// @log none
// @log 5
// @log 5
// @log 5
// @log 5
// @log 5
// @log 1
// @log 5
// @log five
// @log none
// @log five
// @log five
// @log five
// @log five
// @log five
// @log 1
// @log five
type MI = { [string]: i32 }
type MS = { [string]: string }
function mk(k: i32): MI | MS | i32 {
  if k == 0 { return 0 }
  if k == 1 {
    const m: MI = Map()
    m["a"] = 5
    return m
  }
  const s: MS = Map()
  s["a"] = "five"
  return s
}
function id<T>(x: T): T { return x }
function pick(x: MI | MS): MI | MS { return x }
let calls = 0
function loud<T>(x: T): T {
  calls = calls + 1
  return x
}
function show(v: i32 | string | null) { print(v ?? "nothing") }
function g(a) {
  if a is i32 { return }
  print(id(a).get("a") ?? "none")
  print(id(a).get("z") ?? "none")
  print(pick(a).get("a") ?? "none")
  print(id(id(a)).get("a") ?? "none")
  const v = id(a).get("a")
  print(v ?? "none")
  show(id(a).get("a"))
  calls = 0
  print(loud(a).get("a") ?? "none")
  print(calls)
  print(a.get("a") ?? "none")
}
g(mk(1))
g(mk(2))
