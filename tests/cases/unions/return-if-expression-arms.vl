// @run
// @log 7
// @log true
// @log ab
// @log 9
// @log 3
// @log 5
// @log 7
// A union returned as ONE `return` of an if-EXPRESSION, in every arm shape the form has.
//
// This lowers as a void statement-`if` whose arms each terminate as their own return —
// the identical program to `if c { return a } else { return b }` — so that the union box
// is built once at the function's exit instead of once per arm. Behaviour is what this
// case pins; `tests/fixtures/opt-melt/union-sink-if-expression.vl` pins the count.
//
// The NESTED arm (`nested`) is the shape the value-typed lowering rejected outright: an
// arm whose single value is itself an if-expression is not a tail VALUE, so the arm
// classifier called it "not a single value". Per-arm exits recurse through the same
// return path, so it is now just another exit.
//
// `passthrough` is the cell where NO arm builds a box, so no arm sinks and the function
// has no exit block at all. A wasm `if` whose arms both diverge is still REACHABLE at its
// `end`, so without the split's trailing `unreachable` this function falls out of the `if`
// with an empty stack into a non-void `end` — invalid wasm, confirmed by deleting that one
// instruction from the disassembly and re-validating.

type Hit = { dist: i32 }
type Miss = { why: i32 }

// two arms, scalar members.
function two(i: i32): i64 | boolean {
  return if i % 2 == 0 { 7 } else { true }
}

// an `else if` chain — three arms through the chain recursion.
function chain(i: i32): i64 | boolean | string {
  return if i == 0 { 7 } else if i == 1 { true } else { "ab" }
}

// an arm whose value is itself an if-expression.
function nested(i: i32): i64 | boolean {
  return if i < 2 { if i == 0 { 7 } else { 9 } } else { true }
}

// struct members, so each arm boxes a variant rather than a scalar.
function probe(i: i32): Hit | Miss {
  return if i % 2 == 0 { { dist: 3 } } else { { why: 5 } }
}

// both arms pass an EXISTING union through, so neither constructs and neither sinks.
function passthrough(i: i32): i64 | boolean {
  const a = two(i)
  const b = two(i + 1)
  return if i % 2 == 0 { a } else { b }
}

function go() {
  const a = two(0)
  if a is i64 { print(a) } // 7

  const b = two(1)
  if b is boolean { print(b) } // true

  const c = chain(2)
  if c is string { print(c) } // ab

  const d = nested(1)
  if d is i64 { print(d) } // 9

  const e = probe(0)
  if e is Hit { print(e.dist) } // 3

  const f = probe(1)
  if f is Miss { print(f.why) } // 5

  const g = passthrough(0)
  if g is i64 { print(g) } // 7
}
go()
