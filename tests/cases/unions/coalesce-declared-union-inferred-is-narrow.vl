// @run
// @log 2
// D1561's CLAUSE-1 FACE — the same delivery as `coalesce-declared-union-inferred-binding`,
// read through `is` instead of the shared discriminant. That one difference moved the cell
// from a loud emit refusal to `vl check`-clean INVALID WASM: with no union name for the node
// the desugared `??` took an `(if (result i32))` blocktype while both its arms pushed the
// union box `(ref $2)`, which the engine refuses (`expected i32, found (ref $type)`).
//
// Both reads need their own fixture: a fix graded on the loud face alone cannot see the
// silent one.
type Circle = { kind: "circle", r: f64 }
type Rect = { kind: "rect", w: f64, h: f64 }
type Shape = Circle | Rect
function mkval(): Shape { return { kind: "rect", w: 2.0, h: 3.0 } }
function passh(x) { return x }
function go() {
  const srcOpt: Shape | null = passh(mkval())
  let v = (srcOpt ?? { kind: "circle", r: 1.0 })
  v = (srcOpt ?? { kind: "circle", r: 1.0 })
  if v is Rect { print(v.w) } else { print(0) }
}
go()
