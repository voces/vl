// @run
// A `||` CHAIN composes its ELSE-narrowings, the dual of `&&`'s conjunct recursion.
//
// `setNarrowFromCond` recurses through `a && b` so a THEN-arm sees both conjuncts'
// narrowings. Its else-side twin `setNarrowFromCondElse` had no `||` arm, so anything
// past the SECOND disjunct saw nothing: the else-arm ran because BOTH disjuncts were
// false, and `e == null` being false is exactly what makes `e` non-null.
//
// Three spellings reach the same missing recursion, and all three were invalid wasm on
// master for the boxed reps (`type mismatch: expected i32, found (ref $type)`):
//
//   e == null || fill() || e >= 0                      the `||` operand chain
//   if e == null || fill() { return true } … e >= 0     the post-GUARD narrowing
//   if e == null || fill() { … } else { e >= 0 }        the explicit else-arm
//
// So this is NOT a short-circuit-operand-only defect — the guard and else spellings fail
// with it, which is what places the hole in the shared else-narrowing collector rather
// than in either consumer. `string|null`, `i32[]|null`, `S|null` and `K|null` are niches
// and were already clean; they are the oracle rows.
//
// Every row prints the non-null input then the null input. `f(null)` is decided by the
// FIRST disjunct, so it must be `true` without ever reading the third.
//
// @log i32 expr true true
// @log i32 guard true true
// @log i32 ifelse true true
// @log f64 expr true true
// @log f64 guard true true
// @log f64 ifelse true true
// @log bool expr true true
// @log bool guard true true
// @log bool ifelse true true
// @log str expr true true
// @log str guard true true
// @log str ifelse true true
// @log arr expr true true
// @log arr guard true true
// @log arr ifelse true true
// @log struct expr true true
// @log struct guard true true
// @log struct ifelse true true
// @log lit expr true true
// @log lit guard true true
// @log lit ifelse true true

type S = { v: i32 }
type K = "a" | "b"

// A middle disjunct the narrowing must survive: it is always false, so the third
// disjunct always decides the non-null row.
function fill(b: boolean) { return b }

function exprI32(e: i32 | null) { return e == null || fill(false) || e >= 0 }
function guardI32(e: i32 | null) {
  if e == null || fill(false) { return true }
  return e >= 0
}
function elseI32(e: i32 | null) {
  if e == null || fill(false) {
    return true
  } else {
    return e >= 0
  }
}

function exprF64(e: f64 | null) { return e == null || fill(false) || e >= 0.0 }
function guardF64(e: f64 | null) {
  if e == null || fill(false) { return true }
  return e >= 0.0
}
function elseF64(e: f64 | null) {
  if e == null || fill(false) {
    return true
  } else {
    return e >= 0.0
  }
}

function exprBool(e: boolean | null) { return e == null || fill(false) || e }
function guardBool(e: boolean | null) {
  if e == null || fill(false) { return true }
  return e
}
function elseBool(e: boolean | null) {
  if e == null || fill(false) {
    return true
  } else {
    return e
  }
}

function exprStr(e: string | null) {
  return e == null || fill(false) || e.length > 0
}
function guardStr(e: string | null) {
  if e == null || fill(false) { return true }
  return e.length > 0
}
function elseStr(e: string | null) {
  if e == null || fill(false) {
    return true
  } else {
    return e.length > 0
  }
}

function exprArr(e: i32[] | null) { return e == null || fill(false) || e[0] >= 0 }
function guardArr(e: i32[] | null) {
  if e == null || fill(false) { return true }
  return e[0] >= 0
}
function elseArr(e: i32[] | null) {
  if e == null || fill(false) {
    return true
  } else {
    return e[0] >= 0
  }
}

function exprStruct(e: S | null) { return e == null || fill(false) || e.v >= 0 }
function guardStruct(e: S | null) {
  if e == null || fill(false) { return true }
  return e.v >= 0
}
function elseStruct(e: S | null) {
  if e == null || fill(false) {
    return true
  } else {
    return e.v >= 0
  }
}

function exprLit(e: K | null) { return e == null || fill(false) || e == "a" }
function guardLit(e: K | null) {
  if e == null || fill(false) { return true }
  return e == "a"
}
function elseLit(e: K | null) {
  if e == null || fill(false) {
    return true
  } else {
    return e == "a"
  }
}

function say(tag: string, a: boolean, b: boolean) {
  print(tag + " " + toString(a) + " " + toString(b))
  0
}

say("i32 expr", exprI32(5), exprI32(null))
say("i32 guard", guardI32(5), guardI32(null))
say("i32 ifelse", elseI32(5), elseI32(null))
say("f64 expr", exprF64(5.0), exprF64(null))
say("f64 guard", guardF64(5.0), guardF64(null))
say("f64 ifelse", elseF64(5.0), elseF64(null))
say("bool expr", exprBool(true), exprBool(null))
say("bool guard", guardBool(true), guardBool(null))
say("bool ifelse", elseBool(true), elseBool(null))
say("str expr", exprStr("ab"), exprStr(null))
say("str guard", guardStr("ab"), guardStr(null))
say("str ifelse", elseStr("ab"), elseStr(null))
say("arr expr", exprArr([1, 2]), exprArr(null))
say("arr guard", guardArr([1, 2]), guardArr(null))
say("arr ifelse", elseArr([1, 2]), elseArr(null))
say("struct expr", exprStruct({ v: 5 }), exprStruct(null))
say("struct guard", guardStruct({ v: 5 }), guardStruct(null))
say("struct ifelse", elseStruct({ v: 5 }), elseStruct(null))
say("lit expr", exprLit("a"), exprLit(null))
say("lit guard", guardLit("a"), guardLit(null))
say("lit ifelse", elseLit("a"), elseLit(null))
