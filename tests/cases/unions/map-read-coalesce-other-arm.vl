// @run
// A map read defaulted with ANOTHER arm of the union its `??` is typed as builds that union,
// not the map's value type, for a record, scalar, string or list value, hit or miss (D4643).
type R = { q: i32 }
type S = { r: i32 }
type U = R | S
type A = { q: i32 } | { r: i32 }
const recs: Map<string, R> = Map()
recs["k"] = { q: 4 }
const anon: Map<string, { q: i32 }> = Map()
anon["k"] = { q: 5 }
const nums: Map<string, i32> = Map()
nums["k"] = 4
const wide: Map<string, f64> = Map()
wide["k"] = 2.5
const longs: Map<string, i64> = Map()
longs["k"] = 7
const flags: Map<string, boolean> = Map()
flags["k"] = true
const words: Map<string, string> = Map()
words["k"] = "hi"
const lists: Map<string, i32[]> = Map()
lists["k"] = [1, 2]
const s: S = { r: 8 }
let reads = 0
function key(): string {
  reads = reads + 1
  "k"
}
function tail(k: string): U { recs[k] ?? { r: 1 } }
function scalar(k: string): i32 | string { return nums[k] ?? "none" }
const hit: U = recs["k"] ?? { r: 1 }
const miss: U = recs["z"] ?? { r: 1 }
const viaVar: U = recs.get("k") ?? s
const inferred = recs["z"] ?? { r: 2 }
const anonArm: A = anon["k"] ?? { r: 1 }
let assigned: U = { r: 0 }
assigned = recs["k"] ?? { r: 1 }
print(hit is R)
print(miss is R)
print(viaVar is R)
if inferred is S { print(inferred.r) }
print(anonArm is { q: i32 })
print(assigned is R)
print(tail("k") is R)
const sh = scalar("k")
const sm = scalar("z")
if sh is i32 { print(sh + 1) }
if sm is string { print(sm) }
const f = wide["k"] ?? "x"
if f is f64 { print(f * 2.0) }
const l: i64 | string = longs.get("k") ?? "x"
if l is i64 { print(l + 1) }
const b: boolean | string = flags["z"] ?? "x"
print(b is string)
const w: string | i32 = words[key()] ?? 7
print(reads)
if w is string { print(w) }
const li: i32[] | string = lists["k"] ?? "x"
if li is i32[] { print(li.length) }
// @log true
// @log false
// @log true
// @log 2
// @log true
// @log true
// @log true
// @log 5
// @log none
// @log 5
// @log 8
// @log true
// @log 1
// @log hi
// @log 2
