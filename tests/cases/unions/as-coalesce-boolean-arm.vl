// `x as? boolean` — the LAST arm shape, and the third REP this cast has to speak. With the
// string arm (`as-coalesce.vl`), the numeric arms (`as-coalesce-scalar-arms.vl`) and the
// variant / sub-union targets (`as-coalesce-variant-and-sub-union.vl`), `as?` is complete:
// every arm a union can have now coalesces, with no refusal left.
//
// IT NEEDS ITS OWN ARM because `boolean | null` is the SENTINEL niche — an i32 carrying `2`
// for null — so the block's result is a SCALAR where every other target's is a ref:
//
//   · a string arm      → `(ref null $sTypeIdx)`      a nullable ref
//   · a variant arm     → `(ref null $uVarHeap[vi])`  a nullable ref
//   · a sub-union       → the box, null on the TAG
//   · a NUMERIC arm     → the box, null on the TAG
//   · a BOOLEAN arm     → an i32, null as the SENTINEL 2   <- this file
//
// The hit unboxes through `emitUnionUnboxTail`, which already recovers this atom kind from
// the box's i32 value box; the miss pushes the sentinel.
//
// THE CASE THAT MAKES THE REP EARN ITS KEEP is a genuine `false`. With null encoded as `2`
// and false as `0`, a miss and a real `false` must stay distinguishable — a sentinel rep
// that collapsed them would read `false` as absent, which is the silent-wrong-answer shape
// this whole family is prone to. Both are exercised below and they differ.
//
// This file replaces `as-coalesce-boolean-reject.vl`, which pinned the refusal; that file in
// turn replaced `as-coalesce-no-nullable-rep.vl`, whose refusal covered three shapes that
// work now. The refusal that remains names no arm at all — it is reached only by an arm that
// is neither a value atom, a variant, nor a sub-union.
// @run
// @log yes
// @log no
// @log absent

type Count = { n: i32 }

// Returns a REAL `false` for one input, a non-boolean arm for another — so the two ways of
// "not true" are both on the table.
function pick(t: string): boolean | Count {
  if t == "yes" { return true }
  if t == "no" { return false }
  { n: 3 }
}

function describe(t: string) {
  const c = pick(t) as? boolean
  if c != null {
    if c { return "yes" }
    // a genuine `false`, NOT the null sentinel — the distinction the niche has to keep
    return "no"
  }
  "absent"
}

print(describe("yes"))       // yes
print(describe("no"))        // no
print(describe("other"))     // absent
