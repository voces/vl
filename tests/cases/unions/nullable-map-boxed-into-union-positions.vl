// @run
// @log arg null
// @log arg map 1
// @log ret null
// @log ret map 1
// @log let null
// @log let map 1
// @log field null
// @log field map 1
// @log elem null
// @log elem map 1
// @log asg null
// @log asg map 1
// Q58 position sweep: a `M | null` boxed into a union holding `M` and `null` (the box plan's
// `nulMap` arm), as an argument, a return, a `let`, a record field, a list element and an
// assignment's value, each with the null and with a map.
type M = { [string]: i32 }
type U = M | null | i32
type R = { u: U }
function show(tag: string, u: U) {
  if u is i32 { print(tag + " i32") } else if u == null { print(tag + " null") } else {
    print("\{tag} map \{u.length}")
  }
}
function mk(): M {
  const m: M = Map()
  m["a"] = 1
  return m
}
function asArg(w: M | null) { show("arg", w) }
function asRet(w: M | null): U { return w }
function asLet(w: M | null) {
  const u: U = w
  show("let", u)
}
function asField(w: M | null) {
  const r: R = { u: w }
  show("field", r.u)
}
function asElem(w: M | null) {
  const xs: U[] = [w]
  show("elem", xs[0])
}
function asAsg(w: M | null) {
  let u: U = 0
  u = w
  show("asg", u)
}
asArg(null)
asArg(mk())
show("ret", asRet(null))
show("ret", asRet(mk()))
asLet(null)
asLet(mk())
asField(null)
asField(mk())
asElem(null)
asElem(mk())
asAsg(null)
asAsg(mk())
