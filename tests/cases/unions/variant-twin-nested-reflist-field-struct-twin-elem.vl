// @run
// @log 7
// @log 107
// @log 105
// @log -1
// @log -1
// @hint redundant type annotation: `pickU` is inferred as `i32`
// @hint redundant type annotation: `pickV` is inferred as `i32`
// @hint redundant type annotation: `c` is inferred as `{ns: {v: i32}[][]}`
// @hint redundant type annotation: `k` is inferred as `{ns: {v: i32}[][]}`
// @hint redundant type annotation: `d` is inferred as `{w: i32}`
// @hint redundant type annotation: `b` is inferred as `{z: i32}`
// The NESTED (`S[][]`) sibling of the ref-list-field variant twin: `Cat = {ns:
// A[][]}` and `Kot = {ns: B[][]}` key the same canonical variant, and the field's
// ref-list slots are NESTED-array elements (kind 9) whose inner lists carry the
// declared struct twins `A` / `B`. The layout guard descends one level — inner
// slot, then the struct tail — so the variants share one heap type and a `Cat`
// read through `V`'s `is Kot` arm lands on it instead of trapping.
type A = { v: i32 }
type B = { v: i32 }
type Cat = { ns: A[][] }
type Kot = { ns: B[][] }
type Dog = { w: i32 }
type Bird = { z: i32 }
type U = Cat | Dog
type V = Kot | Bird

function pickU(u: U): i32 {
  if u is Cat { return u.ns[0][0].v }
  return -1
}
function pickV(v: V): i32 {
  if v is Kot { return v.ns[0][0].v + 100 }
  return -1
}

function go() {
  const c: Cat = { ns: [[{ v: 7 }]] }
  print(pickU(c)) // 7
  print(pickV(c)) // 107 — the nested-element twin arm
  const k: Kot = { ns: [[{ v: 5 }]] }
  print(pickV(k)) // 105
  const d: Dog = { w: 1 }
  print(pickU(d)) // -1
  const b: Bird = { z: 3 }
  print(pickV(b)) // -1
}
go()
