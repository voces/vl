// D2326 round 2 — `startBlockLetRowOfAt` picked the module-scope `if` block covering a read
// by BINARY SEARCHING `startStmts`, assuming it holds ascending arena indices. `p?.twice()`
// desugars to a freshly minted `IfStmt` (`drwOptGuard`) with a fresh, high index spliced in
// place, so a top-level optional call between two sibling union blocks put the array out of
// order and the search picked the wrong sibling, losing a later block's union binding.
// @run
// @log one
// @log ctrue

type P = { n: i32 }
type A = { x: i32 }
type B = { y: string }
type C = { z: boolean }
function twice(self: P) { self.n * 2 }
function mkP(c: boolean): P | null {
  if c { return { n: 21 } }
  return null
}
const p = mkP(true)
p?.twice()
p?.twice()
p?.twice()
if true {
  const u: A | B = { y: "one" }
  const k = () => {
    if u is A { return "a\{u.x}" }
    u.y
  }
  print(k())
}
p?.twice()
if true {
  const u: C | B = { z: true }
  const k = () => {
    if u is C { return "c\{u.z}" }
    u.y
  }
  print(k())
}
p?.twice()
