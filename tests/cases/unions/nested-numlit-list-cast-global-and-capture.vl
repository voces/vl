// @run
// @log 1
// @log 11
// @log true
// A module-scope binding of `as? K[][]` over a box with an `i32[][]` arm, and a closure capturing
// one in a function: each cell's list row exists before the cast that would mint it is lowered.
type K = 0 | 1
function mk(k: i32): K[][] | i32[][] | string {
  if k == 0 { return "s" }
  const w: i32[][] = if k == 1 { [[1], [0, 1]] } else { [[1, 5]] }
  return w
}
const v = mk(1) as? K[][]
if v != null { print(v[0][0]) } else { print(0) }
function frame() {
  const c = mk(1) as? K[][]
  const f = () => {
    if c != null { print(c[1][1] + 10) } else { print(0) }
  }
  f()
}
frame()
const miss = mk(2) as? K[][]
print(miss == null)
