// @run
// @log true
// @log false
// @log true
// @log false
// @log kbbkkbbk
// A `K | null` call operand is read once, as its id, tested against the null and decoded from its
// slot, in source order beside a call box (D17066).
type K = "a" | "b"
type U = i32 | K | null
let tr = ""
let gu: U = null
let gk: K | null = null
function bx(): U {
  tr = tr + "b"
  return gu
}
function ck(): K | null {
  tr = tr + "k"
  return gk
}
print(ck() == bx())
print(bx() != ck())
gk = "a"
gu = "a"
print(ck() == bx())
gu = 1
print(bx() == ck())
print(tr)
