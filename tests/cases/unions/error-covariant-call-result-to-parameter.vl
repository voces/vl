// @error WRITTEN THROUGH
// @hint redundant type annotation: `a` is inferred as `{r: i32}[]` — remove it to lean on inference
// A covariant list returned and handed straight to a writing parameter (D1658).
//
// `take(hand(b))` delivers the return under no name at all, so the closure's call-result
// edge had no destination to root at and the write inside `take` was invisible. The result
// of a call consumed as an ARGUMENT reaches that call's parameter, which is a name the
// closure follows into the callee's own body — so `ys.push` is found and the covariant
// assignment is refused where the rule is stated.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq

function hand(xs: Shape[]): Shape[] { xs }

function take(ys: Shape[]) { ys.push({ s: 3 }) }

function f() {
  const a: Circle[] = [{ r: 7 }]
  const b: Shape[] = a
  take(hand(b))
  print(a.length)
}

f()
