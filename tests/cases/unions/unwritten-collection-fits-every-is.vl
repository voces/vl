// @log true
// @log true
// @log true
// @log true
// @log 7
// @log true
// @log true
// @log true
// @log false
// D16047 (owner ruling (a1)): an empty `[]`, `Map()` or `Set()` no write pins fits every `is`
// of its kind, in an inferred union return or a local join; a write through an `is` narrowing
// pins it program-wide to the narrowing's element, as a direct write does.
function pick(c: boolean) {
  if c { return [Map()] }
  const m: {[string]: i32} = Map()
  m["a"] = 1
  return m
}
const r = pick(false)
if r is {[string]: i32} { print(r["a"] ?? 0) }
const q = pick(true)
print(q is {[string]: i32}[])
print(q is {[string]: i32})

function c() { return true }
const xs = if c() { [] } else { 1 }
print(xs is i32[])
print(xs is string[])
print(xs is f64[])

function mk(b: boolean) {
  if b { return [] }
  return 1
}
const s = mk(true)
print(s is i32[])
if s is i32[] { s.push(7) }
if s is i32[] { print(s[0]) }

const ms = if c() { Map() } else { 1 }
print(ms is {[string]: i32})
const st = if c() { Set() } else { 1 }
print(st is Set<string>)
function nul(b: boolean) {
  if b { return [Map()] }
  return null
}
print(nul(true) == null || nul(true) is {[i32]: string}[])
print(nul(false) != null)
