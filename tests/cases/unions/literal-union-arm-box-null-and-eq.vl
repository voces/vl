// @run
// @log true
// @log false
// @log 3
// @log false
// @log a
// @log false
// @log null
// @log true
// @log true
// @log false
// @log false
// @log false
// A value box holding a literal-union arm takes a `K | null` parameter, its `-1` under the null
// tag, and compares by `==` against its other arm (D3347), in the direct spelling and at a pin.
type K = "a" | "b"
function g(a: i32 | null, b: K, k: i32) {
  const r = if k == 0 { a } else { b }
  print(r == a)
}
function h(a: i32, b: K | null, k: i32) {
  const r = if k == 0 { a } else { b }
  print(r)
  print(r is null)
}
const xa: i32 | null = null
const xb: K = "b"
g(xa, xb, 0)
g(xa, xb, 1)
const yb: K | null = "a"
const yn: K | null = null
h(3, yb, 0)
h(3, yb, 1)
h(3, yn, 1)
function t<T, U>(a: T, b: U, k: i32) {
  const r = if k == 0 { a } else { b }
  print(r == a)
}
t(xa, xb, 0)
t(xa, xb, 1)
function u<T, U>(a: T, b: U, k: i32) {
  const r = if k == 0 { a } else { b }
  print(r is null)
}
u(3, yb, 0)
u(3, yb, 1)
