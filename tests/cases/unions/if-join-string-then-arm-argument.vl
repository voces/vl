// @run
// @log s
// @log x
// @log s
// @log s
// @log 8
// @log true
// @log s
// @log 2
// An if-expression whose then arm is a string and whose else arm is a record or a number joins
// to the value union box. An un-annotated parameter it reaches pins at that union, not at the
// then arm's string, directly or through an un-annotated binding (D2839).
type Q = { b: string }
function yes() { true }
function take(x) {
  if x is string { print(x) } else { print(x.b) }
}
function takeNum(x) {
  if x is string { print(x) } else { print(x + 1) }
}
function isStr(x) { print(x is string) }
function size(x) {
  if x is string { print(x) } else { print(x.length) }
}
take(if yes() { "s" } else { { b: "x" } })
take(if !yes() { "s" } else { { b: "x" } })
const v = if yes() { "s" } else { { b: "x" } }
take(v)
takeNum(if yes() { "s" } else { 7 })
takeNum(if !yes() { "s" } else { 7 })
isStr(if yes() { "s" } else { { b: "x" } })
function relay() { take(if yes() { "s" } else { { b: "x" } }) }
relay()
size(if !yes() { "s" } else { [1, 2] })
