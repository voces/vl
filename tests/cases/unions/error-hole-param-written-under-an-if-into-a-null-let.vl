// @emit-error emitProgram: union atom has no value box
// A `let x = null` a hole parameter fills under an `if` is refused, never built with its reads after
// the join typed at `null`, which drops the write (D17850).
function f(a) {
  let t = null
  if a > 5 { t = a }
  return t
}
print(f(1))
print(f(9))
print(f(1) == null)
