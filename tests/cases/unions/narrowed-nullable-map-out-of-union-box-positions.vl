// @run
// @log null
// @log null
// @log null
// @log null
// @log null
// @log null
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// @log null
// @log str
// @log str
// @log str
type M = { [string]: i32 }
type O = { f: M | null | string }
function mk(): M {
  const m: M = Map()
  m["a"] = 1
  return m
}
function show(v: M | null) {
  if v == null { print("null") } else { print(v.length) }
}
function arg(w: M | null | string) {
  if w is string { return }
  show(w)
}
function cst(w: M | null | i32) {
  if w is i32 { return }
  const c = w
  show(c)
}
function ret(w: M | null | string): M | null {
  if w is string { return null }
  return w
}
let g: M | null | string = "g"
function glob() {
  if g is string { print("str") } else { show(g) }
}
function field(o: O) {
  if o.f is string {
    print("str")
  } else {
    const c = o.f
    show(c)
  }
}
function capt(w: M | null | string) {
  const f = () => {
    if w is string { print("str") } else { show(w) }
  }
  f()
}
function all(w: M | null | string) {
  arg(w)
  if !(w is string) { cst(w) }
  show(ret(w))
  g = w
  glob()
  field({ f: w })
  capt(w)
}
all(null)
all(mk())
all("s")
