// @run
// @log true
// @log 3
// @log a
// @log m
// @log 9
// @log b
// @log 7
// @log x
// @log zz
// @log y
// A UNION ARM CARRYING AN *INLINE* LITERAL-UNION FIELD (D1093) — the spelling D1031's close
// left refusing, plus the two controls that always ran and the two spellings the fix must NOT
// merge.
//
// THE TWO PRODUCERS DISAGREED ABOUT ONE FIELD. The VARIANT recorder codes `k` from the
// annotation NODE, where an inline literal union is not a registered alias and canon has
// softened it: code 3, a plain string slot, which is what this struct is actually laid out
// with. `internArmShapeOf`'s demand-driven mint codes the SAME field from the arm's RENDER,
// where the NAME ladder claims `"a"|"b"` as the interned i32 ATOM: code 0. The mint exists so
// `armFieldStructRow` has a row to answer with, and `variantStructHeapTwinAt` compares the two
// tables POSITIONALLY — so the row was minted and never recognised, and `g: Circle` had no
// field rep. The NAMED-alias spelling (`Named` below) never had it: `k: K` codes 0 on both
// sides.
//
// AND THE KEY HAD TO FOLLOW THE CODES. `repCanonId` widens a literal RUN to `string` but still
// keys a UNION, so `{r:i32,k:"a"|"b"}` and `{r:i32,k:string}` were two ids for one layout and
// `repRowOfTyStruct` could not find the mint even once its codes matched.
//
// `{kind: "x"|"y"}` AND `{kind: string}` STAY TWO TYPES, which is the acceptance test the
// merge had to pass and the last three lines are: a value of the literal-union type flows INTO
// the base-typed binding (subset), each keeps its own value, and `Base` still accepts a string
// the literal union does not admit.
type Circle = { r: i32, k: "a" | "b" }
type Other = { o: string }
type Shape = Circle | Other
type GW = { g: Circle | null }

// The control that always ran: the same union under a NAMED alias.
type K = "a" | "b"
type Named = { r: i32, k: K }
type NOther = { o: string }
type NShape = Named | NOther
type NW = { g: Named | null }

function mk(): Shape { { r: 3, k: "a" } }
function nmk(): NShape { { r: 9, k: "b" } }

// CONSTRUCT the field face, then DISCRIMINATE three ways — `== null`, a field read through the
// narrowing, and the literal field itself. Reading `k` is what proves the slot: a cell that
// coded it as the atom prints an id here, not `a`.
const p: GW = { g: null }
print(p.g == null)
const s = mk()
if s is Circle { p.g = s }
const e = p.g
if e == null { print(0) } else { print(e.r) }
if e == null { print("no") } else { print(e.k) }

// A DECLARED plain-struct twin of the arm's own layout still merges with it: `m` here comes
// back through a binding annotated at the ARM.
// @hint redundant type annotation: `back` is inferred as `{r: i32, k: K}`
type Twin = { r: i32, k: "a" | "b" }
const tw: Twin = { r: 5, k: "b" }
const back: Circle = { r: 5, k: tw.k }
if back.k == "b" { print("m") } else { print("no") }

// The named-alias control, same three questions.
const np: NW = { g: null }
const ns = nmk()
if ns is Named { np.g = ns }
const ne = np.g
if ne == null { print(0) } else { print(ne.r) }
if ne == null { print("no") } else { print(ne.k) }

// A THREE-member inline union, and the arm-typed field NOT nullable — both refused with the
// two-member nullable one, and neither is the row's own witness.
type Tri = { r: i32, k: "a" | "b" | "c" }
type TOther = { o: string }
type TShape = Tri | TOther
type TW2 = { g: Tri }
function tmk(): TShape { { r: 7, k: "c" } }
const tp: TW2 = { g: { r: 0, k: "a" } }
const ts = tmk()
if ts is Tri { tp.g = ts }
print(tp.g.r)

// THE ACCEPTANCE TEST FOR THE MERGE: two types related by SUBSET, not two spellings of one.
// @hint redundant type annotation: `bv` is inferred as `{kind: string}`
// @hint redundant type annotation: `widened` is inferred as `{kind: string}`
type A = { kind: "x" | "y" }
type Base = { kind: string }
const av: A = { kind: "x" }
const bv: Base = { kind: "zz" }
print(av.kind)
print(bv.kind)
const widened: Base = { kind: "y" }
print(widened.kind)
