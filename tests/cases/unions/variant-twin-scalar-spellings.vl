// @run
// @log 7
// @log 7
// @log yes
// THE TWIN EXEMPTION the same-field-names discriminability reject is FOR, at the three
// spellings that reach it through DIFFERENT text and must still fold to one variant.
//
// `assignTags` rejects two variants of one union that share a field-NAME set unless they are
// the same variant; the exemption keys on the field's own canonical type TEXT, so anything
// that makes two spellings of ONE type arrive as two strings is a false reject. The three
// routes here are exactly those:
//   · TWO DECLARED NAMES, same shape (`Cat`/`Kot`) — both fields recorded from a `FieldDef`;
//   · a declared name beside its INLINE spelling (`Cat | {m: i32}`) — one field recorded
//     from a `FieldDef` and the other from the shape TEXT, the only pair whose two rows come
//     from different recorders;
//   · a TRANSPARENT ALIAS (`type Id = i32`) against the base it aliases. This is the route
//     with no other pin: it is clean only because `canonEmitTypeNames` rewrites every
//     annotation into its canonical emit name before any emit pass, so the field arrives as
//     `"i32"` from both sides. An identity comparison taken off the DECLARED spelling would
//     reject this program.
//
// The `is` answers are the same-shape-union answers `types/struct-union-same-shape.vl`
// states: a twin genuinely IS its twin, so the first arm is taken.
type Cat = { m: i32 }
type Kot = { m: i32 }
type U = Cat | Kot
type V = Cat | { m: i32 }

type Id = i32
type Boxed = { a: Id }
type Plain = { a: i32 }
type W = Boxed | Plain

function pickU(u: U) {
  if u is Cat { u.m } else { -1 }
}
function pickV(v: V) {
  if v is Cat { v.m } else { -1 }
}
function pickW(w: W) {
  if w is Boxed { "yes" } else { "no" }
}
print(pickU({ m: 7 }))
print(pickV({ m: 7 }))
print(pickW({ a: 1 }))
