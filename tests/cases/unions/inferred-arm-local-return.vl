// @run
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @hint redundant type annotation: `c` is inferred as `{r: i32}`
// GRADUATED from `silent-class-inventory` D51 — an un-annotated function returning a bare
// struct-SHAPED local with no `sNames` row. It was `emitProgram: ref valtype with no interned
// shape`, and 34 of the 72 residue cells of the D39/D40/D41 grid.
//
// THE ROOT IS D57'S, ONE CONSUMER OVER. `collectS` SKIPS a `type X = {…}` that is a union
// member, so declaring `type Shape = Circle | Sq` DELETES `Circle`'s standalone struct row and
// mints a variant row instead. `letIsStruct` still claims `const c = { r: n }` (through
// `exprStruct`'s ObjLit arm) while `structIndexOfLet` answers -1, so both the LOCAL's slot and
// the inferred RETURN were minted as the pair `("struct", -1)` — `fbValtype`'s bounds guard.
//
// FOUR EDITS, AND THE FOURTH IS WHY THE FIRST THREE ARE NOT ENOUGH — the shape D52 recorded
// one row up. `letObjLitVariantIdx` is the resolver (the object-literal field-set leg
// `exprVariantIndex` deliberately lacks, asked ONLY where the struct table has no row, so
// D39's two-claimants case is untouched); `criClassify`'s returned-local rung and
// `collectLocals`' struct arm are the two places that mint the pair. With only the RETURN
// fixed the reject moved from the functype to the LOCALS vector and an outcome-class grader
// saw nothing; with both, the object literal still built the union BOX into a
// `(ref $uVarHeap[vi])` cell — check-clean INVALID WASM, strictly worse than the reject it
// replaced. The fourth edit is `wasmEmit`'s variant SEED, which reads the slot kind where it
// had read only the annotation, exactly as the `nulstruct` seed twenty lines above it does.
//
// THE `-1` IS THE GATE AT ALL THREE SITES: the new rung fires only where today's pair is a
// guaranteed loud reject, so no program that emits a module can move.
//
// THE ROWS ARE THE BINDING CHAIN AND THE TWIN AXIS. The `direct` / `local` / `alias` spellings
// are three lengths of the same chain; `Dot` present, absent and same-arity-different-name are
// the twin levels D52 measured. The ANNOTATED sibling (`const c: Circle = { r: n }`) is D52's
// own row and is here as the control that this change did not disturb it.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq

// THE FILED WITNESS, verbatim: un-annotated local, one alias hop, un-annotated result.
function mkAlias(n: i32) {
  const c = { r: n }
  const o = c
  return o
}

// No local at all — the literal is returned straight out.
function mkDirect(n: i32) { return { r: n } }

// One binding, no alias.
function mkLocal(n: i32) {
  const c = { r: n }
  return c
}

// The ANNOTATED sibling: D52's row, and the control that says this change left it alone.
function mkAnnotated(n: i32) {
  const c: Circle = { r: n }
  const o = c
  return o
}

// A SECOND arm of the same union, so the field-set match is choosing between rows rather than
// finding the only one there is.
function mkOther(n: i32) {
  const c = { s: n }
  const o = c
  return o
}

print(mkAlias(7).r)
print(mkDirect(7).r)
print(mkLocal(7).r)
print(mkAnnotated(7).r)
print(mkOther(7).s)
print(mkAlias(7).r)
print(mkLocal(7).r)
