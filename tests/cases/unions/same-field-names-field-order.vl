// @run
// @log false
// @log true
// Arms sharing a field-name set are matched by NAME, not position: `{v: i32, w: string}` and
// `{w: string, v: boolean}` part on `v`'s type whichever order the fields are spelled in (D4056).
type A = { v: i32, w: string }
type B = { w: string, v: boolean }

function f(n: i32): A | B {
  if n == 0 { return { v: 1, w: "a" } }
  return { w: "b", v: true }
}
print(f(1) is A)
print(f(0) is A)
