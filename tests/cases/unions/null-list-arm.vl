// @run
// @log 101
// @log 2
// @log 102
// @log 2
// @log 1
// @log 103
// @log 2
// @log nul
// @log x
// @log true
// @log true
// @log false
// @log true
// @log true
// A `null[]` member of a list union rides the `(boolean | null)[]` list's arm, and a `null[]`
// test against that list tests every element (D13980, by the D4771 ruling).
type N = null[]
function g(v: N | i32[]) {
  if v is N { return 100 + v.length }
  v.length
}
const a: N = [null]
const b = [1, 2]
print(g(a))
print(g(b))
const u: N | string[] = [null, null]
function h(v: N | string[]) {
  if v is (null[]) { 100 + v.length } else { v.length }
}
print(h(u))
const s = ["x", "y"]
print(h(s))
let k = 0
for x in u {
  if x == null { k = k + 1 }
}
print(k - 1)
function r(c: boolean): N | i32[] {
  if c { return [null, null, null] }
  [1, 2]
}
print(g(r(true)))
print(g(r(false)))
function ix(v: N | string[]): string {
  const e = v[0]
  if e == null { return "nul" }
  e
}
print(ix(a))
print(ix(s))
function same(v: N | i32[]) { v == v }
print(same(a))
function fit(v: N | (boolean | null)[]) { v is null[] }
const bn: (boolean | null)[] = [null, null]
const bt: (boolean | null)[] = [true, null]
const be: (boolean | null)[] = []
print(fit(a))
print(fit(bt))
print(fit(bn))
print(fit(be))
