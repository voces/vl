// @run
// @log x
// @log 5
// @log 2
// @log 1
// @log 3
// The complement of a test whose spelling names no member of the set subtracts by type: an
// inline literal set over a mixed union, and `.length` over a list of readonly lists.
function f(m: "x" | "y" | i32) {
  if m is "x" | "y" { print(m) } else { print(m + 1) }
}
f("x")
f(4)
function d(x: (readonly i32[])[] | string[]) { print(x.length) }
d([[1, 2], [3]])
d(["q"])
function g(m: "x" | "y" | i32) {
  const r = { m: m }
  if r.m is "x" | "y" { print(0) } else { print(r.m + 1) }
}
g(2)
