// @run
// @log 9
// @log 1
// @log 2
// @log 2
// @log 2
// CONTRACT (D1473): the four neighbours of the inline-arm discriminant narrowing
// that each reach it by a different route. `P` is the SOUNDNESS cell — two arms
// with the SAME field set, parted only by the literal tag, so a resolver that
// matched arms by field set would take the wrong branch. `A`/`B` share an
// identically-rendered arm across two DIFFERENT unions; the receiver's own member
// set is what keeps each read on its own row. `Rect` is a `type` equal to an inline
// arm and registered under no variant row — the reverse map answers it and the
// variant table does not, which declined the whole union before this closed.
type P = { k: "a", n: i32 } | { k: "b", n: i32 }
const p: P = { k: "b", n: 9 }
if p.k == "a" { print(100) } else { print(p.n) }

type A = { t: "x", v: i32 } | { t: "y", v: i32 }
type B = { t: "x", v: i32 } | { t: "z", v: i32 }
const av: A = { t: "y", v: 1 }
const bv: B = { t: "z", v: 2 }
if av.t == "y" { print(av.v) }
if bv.t == "z" { print(bv.v) }

type Rect = { kind: "rect", w: f64, h: f64 }
type Shape = { kind: "circle", r: f64 } | { kind: "rect", w: f64, h: f64 }
const s: Shape = { kind: "rect", w: 2.0, h: 3.0 }
if s.kind == "rect" { print(s.w) }

// One arm NAMED, the other inline — the narrowed-to arm is the inline one.
type Circle = { kind: "circle", r: f64 }
type Mixed = Circle | { kind: "rect", w: f64, h: f64 }
const m: Mixed = { kind: "rect", w: 2.0, h: 3.0 }
if m.kind == "rect" { print(m.w) }
