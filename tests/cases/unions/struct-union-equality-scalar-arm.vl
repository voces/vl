// D1061 — `==` OVER A UNION CARRYING A STRUCT ARM BESIDE A SCALAR ONE.
//
// THE MIXED ARM IS THE INGREDIENT, NOT THE STRUCT ONE, and the old message ("`==` over a
// struct union is not supported yet") named the arm that was not the problem: `A | B` over
// two struct arms already compared and printed `true` (`struct-union-equality.vl`), while
// `A | i32` and `A | string` refused. Binding did not help either — both operands were
// already `const` locals, which is what separates this from the call-receiver spill.
//
// The arm loop required a VARIANT ROW per arm, and a scalar arm has none: `variantIndexOf`
// answers -1 for `i32`, so a set the lowering can otherwise serve arm for arm declined
// wholesale. The dispatch never had to change — every arm of this box is selected by the
// same tag field, and a scalar arm's tag is `scalarTagOfKind` of its value-atom code, which
// cannot collide with a variant tag (`uVariants.length + k`). Only the per-arm COMPARE
// differs: fields through the variant table for a struct arm, an unboxed payload compare
// for a scalar one.
//
// EVERY ARM IS CONSTRUCTED AND DISCRIMINATED at every scalar rep the box can carry, and each
// row asks the question BOTH ways round the arm boundary — a fixture that only ever compares
// two values of one arm passes while the other arm answers a constant.

type A = { x: i32 }
type B = { y: string }

// i32 beside a struct: the arm the message blamed, and the arm that was missing.
function mkI(n: i32): A | i32 {
  if n == 0 { return 5 }
  if n == 1 { return 6 }
  { x: n }
}

const i5 = mkI(0)
const i5b = mkI(0)
const i6 = mkI(1)
const a2 = mkI(2)
const a2b = mkI(2)
const a3 = mkI(3)
print(i5 == i5b) // same scalar arm, same payload
print(i5 == i6) // same scalar arm, different payload
print(a2 == a2b) // same struct arm, same fields
print(a2 == a3) // same struct arm, different fields
print(i5 == a2) // across the arm boundary, box on the left
print(a2 == i5) // and on the right — the compare is symmetric
print(i5 != i6) // `!=` negates the same answer
print(a2 != a2b)

// string beside a struct: the payload IS the string array, so the arm compares through
// `emitStrEqCore` rather than an `i32.eq`.
function mkS(n: i32): A | string {
  if n == 0 { return "pq" }
  if n == 1 { return "pr" }
  { x: n }
}
print(mkS(0) == mkS(0))
print(mkS(0) == mkS(1))
print(mkS(2) == mkS(2))
print(mkS(2) == mkS(3))
print(mkS(0) == mkS(2))

// f64 and i64 arms: the payload rides a per-rep value box, so the unbox and the opcode both
// come off the arm's kind.
function mkF(n: i32): A | f64 {
  if n == 0 { return 1.5 }
  if n == 1 { return 2.5 }
  { x: n }
}
print(mkF(0) == mkF(0))
print(mkF(0) == mkF(1))
print(mkF(2) == mkF(2))
print(mkF(2) == mkF(3))
print(mkF(0) == mkF(2))

function mkQ(n: i32): A | i64 {
  if n == 0 { return 5000000000 }
  if n == 1 { return 6000000000 }
  { x: n }
}
print(mkQ(0) == mkQ(0))
print(mkQ(0) == mkQ(1))
print(mkQ(2) == mkQ(2))
print(mkQ(2) == mkQ(3))
print(mkQ(0) == mkQ(2))

// THREE ARMS, TWO OF THEM STRUCTS: the scalar arm sits in a chain that still has to select
// between two variant rows, so its tag const cannot be the only one read from the new column.
function mk3(n: i32): A | B | i32 {
  if n == 0 { return 5 }
  if n == 1 { return { x: 1 } }
  if n == 2 { return { y: "q" } }
  { y: "r" }
}
print(mk3(0) == mk3(0))
print(mk3(1) == mk3(1))
print(mk3(2) == mk3(2))
print(mk3(3) == mk3(3))
print(mk3(0) == mk3(1))
print(mk3(1) == mk3(2))
print(mk3(0) == mk3(2))
print(mk3(2) == mk3(3))

// ARM ORDER IS NOT THE BOUND: the scalar arm first reads the same columns.
function mkR(n: i32): i32 | A {
  if n == 0 { return 5 }
  { x: n }
}
print(mkR(0) == mkR(0))
print(mkR(0) == mkR(1))
print(mkR(1) == mkR(2))
print(mkR(1) == mkR(1))
