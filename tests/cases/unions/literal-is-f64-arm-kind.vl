// @run
// @log yes
// @log no
// @log other
// A `v is <FLOAT literal>` test over a MIXED-rep value union (`f64 | string`).
// `emitUnionLitIs` settles the literal's rep from its lexeme: a quoted lexeme is the
// string atom, a float lexeme the f64 atom, an integer the i32 atom (widening to i64 out
// of range). That ladder's answer decides the box TAG the test compares, the payload
// unbox, and which constant-emit arm runs (`fbF64Const` + `f64.eq` here).
//
// Master derived the rep CODE by re-parsing the spelling the ladder had just minted
// (`valueAtomKind(atom)`); destringify D-LITISKIND has the ladder assign the code
// directly. The corpus pinned the STRING arm (three files redden under sabotage
// S-LITISSTR) and the i32 arm, but NOT the f64 one: with the f64 arm's code set to the
// i64 code, all 1,337 corpus files were byte-, message- and run-identical (sabotage
// S-LITISF64). This file is that missing pin — a wrong f64 code compares the box tag
// against the i64 arm's tag, so `v is 1.5` answers FALSE for a value that is 1.5.
const v: f64 | string = 1.5
if v is 1.5 { print("yes") } else { print("no") }

const w: f64 | string = 2.5
if w is 1.5 { print("yes") } else { print("no") }

const s: f64 | string = "s"
if s is 1.5 { print("num") } else { print("other") }
