// @run
// @log 4
// @log 4
// @log 5
// @log v4
// @log w4
// @log 4
// @log 4
// @log 4
// @log -1
// @log 4
// @log 4
// @log -1
// @log -1
// @log 0
// @log v-1
// @log w-1
// @log -1
// @log -1
// @log -1
// @log -1
// @log 4
// @log -1
// @log -2
// @log -2
// @log -2
// @log o
// @log o
// @log -1
// @log -2
// @log -2
// @log -2
// @log -2
// @log -2
// A union box narrowed to `F | null`, the niche delivered at each position: a nullable and a
// union parameter, a nested call, a concatenation, an interpolation hole, a return, a binding,
// an `if` arm, a `??` operand and a record field; each called with a value, `null` and the other member.
import { toString } from "std:fmt"

type F = (a: i32) => i32
type U = F | null | string
type Got = { g: F | null }
function n(a: F | null) { return if a == null { 0 - 1 } else { a(3) } }
function su(w: F | null | boolean) {
  if w is boolean { return 0 - 3 }
  return n(w)
}
function inc(x: i32) { return x + 1 }
function pArg(u: U) {
  if u is string { return 0 - 2 }
  return n(u)
}
function pUnion(u: U) {
  if u is string { return 0 - 2 }
  return su(u)
}
function pNested(u: U) {
  if u is string { return 0 - 2 }
  return inc(n(u))
}
function pConcat(u: U) {
  if u is string { return "o" }
  return "v" + toString(n(u))
}
function pHole(u: U) {
  if u is string { return "o" }
  return "w\{n(u)}"
}
function pReturn(u: U): F | null {
  if u is string { return null }
  return u
}
function pLet(u: U) {
  if u is string { return 0 - 2 }
  const a = u
  return n(a)
}
function pIf(u: U, k: boolean) {
  if u is string { return 0 - 2 }
  const a = if k { u } else { null }
  return n(a)
}
function pCoal(u: U, d: F) {
  if u is string { return 0 - 2 }
  return n(u ?? d)
}
function pRec(u: U) {
  if u is string { return 0 - 2 }
  const r: Got = { g: u }
  return n(r.g)
}
print(pArg((a: i32) => a + 1))
print(pUnion((a: i32) => a + 1))
print(pNested((a: i32) => a + 1))
print(pConcat((a: i32) => a + 1))
print(pHole((a: i32) => a + 1))
print(n(pReturn((a: i32) => a + 1)))
print(pLet((a: i32) => a + 1))
print(pIf((a: i32) => a + 1, true))
print(pIf((a: i32) => a + 1, false))
print(pCoal((a: i32) => a + 1, (a: i32) => a + 1))
print(pRec((a: i32) => a + 1))
print(pArg(null))
print(pUnion(null))
print(pNested(null))
print(pConcat(null))
print(pHole(null))
print(n(pReturn(null)))
print(pLet(null))
print(pIf(null, true))
print(pIf(null, false))
print(pCoal(null, (a: i32) => a + 1))
print(pRec(null))
print(pArg("s"))
print(pUnion("s"))
print(pNested("s"))
print(pConcat("s"))
print(pHole("s"))
print(n(pReturn("s")))
print(pLet("s"))
print(pIf("s", true))
print(pIf("s", false))
print(pCoal("s", (a: i32) => a + 1))
print(pRec("s"))
