// @run
// @log 2
// @log 2
// @log 3
// @log v2
// @log w2
// @log 2
// @log 2
// @log 2
// @log -1
// @log 2
// @log 2
// @log -1
// @log -1
// @log 0
// @log v-1
// @log w-1
// @log -1
// @log -1
// @log -1
// @log -1
// @log 2
// @log -1
// @log -2
// @log -2
// @log -2
// @log o
// @log o
// @log -1
// @log -2
// @log -2
// @log -2
// @log -2
// @log -2
// A union box narrowed to `i32[] | null`, the niche delivered at each position: a nullable and a
// union parameter, a nested call, a concatenation, an interpolation hole, a return, a binding,
// an `if` arm, a `??` operand and a record field; each called with a value, `null` and the other member.
import { toString } from "std:fmt"

type U = i32[] | null | string
type Got = { g: i32[] | null }
function n(a: i32[] | null) { return if a == null { 0 - 1 } else { a.length } }
function su(w: i32[] | null | boolean) {
  if w is boolean { return 0 - 3 }
  return n(w)
}
function inc(x: i32) { return x + 1 }
function pArg(u: U) {
  if u is string { return 0 - 2 }
  return n(u)
}
function pUnion(u: U) {
  if u is string { return 0 - 2 }
  return su(u)
}
function pNested(u: U) {
  if u is string { return 0 - 2 }
  return inc(n(u))
}
function pConcat(u: U) {
  if u is string { return "o" }
  return "v" + toString(n(u))
}
function pHole(u: U) {
  if u is string { return "o" }
  return "w\{n(u)}"
}
function pReturn(u: U): i32[] | null {
  if u is string { return null }
  return u
}
function pLet(u: U) {
  if u is string { return 0 - 2 }
  const a = u
  return n(a)
}
function pIf(u: U, k: boolean) {
  if u is string { return 0 - 2 }
  const a = if k { u } else { null }
  return n(a)
}
function pCoal(u: U, d: i32[]) {
  if u is string { return 0 - 2 }
  return n(u ?? d)
}
function pRec(u: U) {
  if u is string { return 0 - 2 }
  const r: Got = { g: u }
  return n(r.g)
}
print(pArg([1, 2]))
print(pUnion([1, 2]))
print(pNested([1, 2]))
print(pConcat([1, 2]))
print(pHole([1, 2]))
print(n(pReturn([1, 2])))
print(pLet([1, 2]))
print(pIf([1, 2], true))
print(pIf([1, 2], false))
print(pCoal([1, 2], [1, 2]))
print(pRec([1, 2]))
print(pArg(null))
print(pUnion(null))
print(pNested(null))
print(pConcat(null))
print(pHole(null))
print(n(pReturn(null)))
print(pLet(null))
print(pIf(null, true))
print(pIf(null, false))
print(pCoal(null, [1, 2]))
print(pRec(null))
print(pArg("s"))
print(pUnion("s"))
print(pNested("s"))
print(pConcat("s"))
print(pHole("s"))
print(n(pReturn("s")))
print(pLet("s"))
print(pIf("s", true))
print(pIf("s", false))
print(pCoal("s", [1, 2]))
print(pRec("s"))
