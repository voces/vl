// @run
// @info `s` is never reassigned; use `const` instead of `let`
// @log 1
// @log null
// @log 1
// @log true
// @log 2
// @log 9
// A hole parameter written into a copy of an annotated `i32 | null` binding returns the instance's
// result, which the caller reads at that instance's type, at module scope and in a function (D17851).
function f(a) {
  let s: i32 | null = null
  let t = s
  t = a
  return t
}
print(f(1))
print(f(null))
print(f(1) ?? 0)
print(f(1) == 1)
const h: (a: i32 | null) => i32 | null = f
print(h(2))
function g() { print(f(9)) }
g()
