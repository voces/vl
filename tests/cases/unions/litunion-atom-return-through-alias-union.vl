// @run
// @log false
// @log true
// @log true
// @log false
// @log false
// @log false
// A literal-union value returned into a union that reaches its literal arm through an alias
// takes the member as a string, as the inline return spelling does (D7120).
type A = ("a" | "b") | null
type U = A | i32
type R = A | { tag: i32 }
type N = ("a" | "b") | i32
const ga: ("a" | "b") | null = "a"
const gn: ("a" | "b") | null = null
const gk: "a" | "b" = "a"
let gl: ("a" | "b") | null = "b"
function r0(): U { return ga }
function r1(): U { return gn }
function r2(): N { return gk }
function r3(): R { return ga }
function r4(): U { return gl }
function r5(): U {
  const l: ("a" | "b") | null = "a"
  return l
}
gl = "a"
print(r0() == null)
print(r1() == null)
print(r2() == "a")
print(r3() == null)
print(r4() == null)
print(r5() == null)
