// @log 5
// A plain struct whose field is a union arm that recurses through itself (D15095): the arm's
// twin row is minted with the cycle closed on itself, so the holder has a row to point at.
// Declared before and after the arm, at `O` and `O | null`, read, walked, moved back into the
// union, assigned, returned, listed, nested, mutually and three-way recursive.
type Q = { o: O | null }
type O = { n: i32, next: O | null }
type P = { m: i32 }
type U = O | P

const q: Q = { o: { n: 1, next: { n: 5, next: null } } }
const q0 = q.o
if q0 != null {
  if q0.next != null { print(q0.next.n) }
}
const e: Q = { o: null }
print(e.o == null)

const o = q.o
if o != null {
  const u: U = o
  if u is O { print(u.n) }
  const us: U[] = [o, { m: 2 }]
  for x in us {
    if x is O { print(x.n) } else { print(x.m) }
  }
  print(o.next?.n ?? 0)
}
const r: Q = { o: null }
const o2: O = { n: 9, next: null }
r.o = o2
print(r.o.n)
function mk(k: i32): Q { return { o: { n: k, next: null } } }
print(mk(3).o?.n ?? 0)
type Q2 = { q: Q }
const q2: Q2 = { q: mk(6) }
print(q2.q.o?.n ?? 0)

type T = { v: i32, l: T | null, r: T | null }
type L = { s: string }
type UT = T | L
type H = { t: T }
function sum(t: T | null) {
  if t == null { return 0 }
  return t.v + sum(t.l) + sum(t.r)
}
const h: H = {
  t: {
    v: 1,
    l: { v: 2, l: null, r: null },
    r: { v: 4, l: { v: 8, l: null, r: null }, r: null },
  },
}
print(sum(h.t))
const ut: UT = h.t
if ut is T { print(sum(ut.r)) }

type A = { n: i32, b: B | null }
type B = { m: i32, a: A | null }
type UA = A | B
type HA = { a: A | null, k: i32 }
const ha: HA = { a: { n: 1, b: { m: 2, a: { n: 3, b: null } } }, k: 0 }
const a1 = ha.a
if a1 != null {
  const b1 = a1.b
  if b1 != null {
    const a2 = b1.a
    if a2 != null { print(a2.n) }
  }
}
const ua: UA = { m: 7, a: null }
if ua is B { print(ua.m) }

type C1 = { n: i32, c2: C2 | null }
type C2 = { m: i32, c3: C3 | null }
type C3 = { k: i32, c1: C1 | null }
type UC = C1 | C2 | C3
type HC = { c: C1 }
const hc: HC = {
  c: { n: 1, c2: { m: 2, c3: { k: 3, c1: { n: 4, c2: null } } } },
}
const c2 = hc.c.c2
if c2 != null {
  const c3 = c2.c3
  if c3 != null {
    const c1 = c3.c1
    if c1 != null { print(c1.n) }
    print(c3.k)
  }
}

type S2 = { a: A | null, q: i32 }
type E2 = { e: i32 }
type V2 = S2 | E2
const v2: V2 = { a: { n: 5, b: { m: 6, a: null } }, q: 1 }
if v2 is S2 {
  const a3 = v2.a
  if a3 != null {
    print(a3.n)
    print(a3.b?.m ?? 0)
  }
}

const xs: (O | null)[] = [{ n: 4, next: null }, null]
print(xs[0]?.n ?? 0)
const mm: Map<string, O | null> = Map()
mm.set("a", { n: 5, next: null })
print(mm.get("a")?.n ?? 0)
