// @run
// @log 1
// @log 1
// @log 1
// @log 2
// @log 2
// @log 1
// @log 1
// @log 2
// @log 1
// @hint Intentionally-unused variable `_m1` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_m2` (leading `_` marks it unused)
// @hint redundant type annotation: `_m2` is inferred as `Json | null` — remove it to lean on inference
// @hint Intentionally-unused variable `_m5` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_f1` (leading `_` marks it unused)
// @hint redundant type annotation: `_f1` is inferred as `Json | null` — remove it to lean on inference
// @hint redundant type annotation: `f2` is inferred as `Json | null` — remove it to lean on inference
// @hint redundant type annotation: `f3` is inferred as `Json | null` — remove it to lean on inference
// @hint Intentionally-unused variable `_c1` (leading `_` marks it unused)

// D1881 — a checked read over a value-union ref list already yields the box, so a box-typed
// destination must pass it through. `exprUnion` had no arm for it and every such destination
// boxed the box a second time; the module-global cell also had no rung and fell to i32.

import { Json, parseJson } from "std:json"

function mk(): Json[] {
  const r = parseJson("[1, 2]")
  if r is Json[] { return r }
  []
}

// The row's own witness: an un-annotated MODULE-scope binding, popped value discarded.
const xs1 = mk()
const _m1 = xs1.pop()
print(xs1.length)

// The annotated face of the same binding, which pins the cell where the one above infers it.
const xs2 = mk()
const _m2: Json | null = xs2.pop()
print(xs2.length)

// The two consuming positions beside the discard, at module scope.
const xs3 = mk()
const m3 = xs3.pop()
if m3 != null { print(xs3.length) } else { print("none") }

const xs4 = mk()
const m4 = xs4.pop()
if m4 is f64 { print(m4) } else { print("notf64") }

// `.get(i)` reaches the same rep as `.pop()` and never mutates the receiver.
const xs5 = mk()
const _m5 = xs5.get(0)
print(xs5.length)

// The FUNCTION-scope annotated face, which the un-annotated twin never reached: an annotation
// routes the binding through the box-typed destination the module cell always takes.
function fnFaces() {
  const ys = mk()
  const _f1: Json | null = ys.pop()
  print(ys.length)

  const zs = mk()
  const f2: Json | null = zs.pop()
  if f2 != null { print(zs.length) } else { print("none") }

  const ws = mk()
  const f3: Json | null = ws.pop()
  if f3 is f64 { print(f3) } else { print("notf64") }
}

fnFaces()

// The boundary: a STRUCT element at module scope keeps its `nulstruct` niche.
type Circle = { r: f64 }

function mkc(): Circle[] { [{ r: 1.0 }, { r: 2.0 }] }

const cs = mkc()
const _c1 = cs.pop()
print(cs.length)
