// D1460 — a mixed-spelling discriminant whose second arm is a BARE single literal
// (`{kind: K1} | {kind: "a"}`), the one-member spelling of the pair D1050 unified.
//
// THE MEMBER COUNT WAS NEVER THE BOUND, the arena's SHAPE was. `"a"` is a `TyLit` and
// `"a" | "b"` a `TyUnion`, so the atomisable test declined the first while the ALIAS spelling
// of the very same one-member set (`type KC = "a"`) has carried the interned atom all along.
// `tyIsLitUnionOrLit` is the predicate that asks the question the rep actually cares about.
//
// EVERY ROW PRINTS THE MEMBER TEXT, not the id — the half a layout change silently loses. A
// promoted one-member field is a bare `TyLit`, which `nodeLitUnionMemberTexts` declines on
// purpose, so the widen needs `litAtomWidenTexts`' third rung or `print` emits the raw id.
//
// BOTH FACES: the `const v: B = …` construction and the bare `return { … }`, the annotated and
// the un-annotated rebind off the promoted field. `takes(s: string)` IS the string boundary
// the promoted field is graded against, so its annotation is declared rather than deleted.
// @hint redundant type annotation: `takes` is inferred as `string` — remove it to lean on inference
// @run
// @log A:circle
// @log A:round
// @log B:a
// @log true
// @log false
// @log a
// @log a
// @log a
// @log k=a
// @log 5
// @log a
// @log circle

type K1 = "circle" | "round"
type A = { kind: K1, r: f64 }
type B = { kind: "a", r: f64 }

function f(n: i32): A | B {
  if n == 0 { return { kind: "circle", r: 1.0 } }
  if n == 1 { return { kind: "round", r: 3.0 } }
  const v: B = { kind: "a", r: 2.0 }
  return v
}

// The READ yields the member text on each arm, and `is` parts them by the discriminant VALUE.
let i = 0
while i < 3 {
  const x = f(i)
  if x is A { print("A:" + x.kind) } else { print("B:" + x.kind) }
  i = i + 1
}

const b = f(2)
print(b is B)
print(b is A)

// DELIVERY POSITIONS of the promoted one-member arm's field.
function takes(s: string): string { s }
if b is B {
  const k = b.kind
  print(k)
  print(takes(b.kind))
  const xs: string[] = [b.kind]
  print(xs[0])
  print("k=" + b.kind)
} else {
  print("notB")
}

// A `B` built OUTSIDE the union and delivered INTO it: the declared struct row moved with the
// variant row, so the two share one heap type.
function box(v: A | B): A | B { v }
const s: B = { kind: "a", r: 5.0 }
const t = box(s)
if t is B { print(t.r) } else { print(0.0) }
print(s.kind)

// The ALIAS arm is unchanged by the unification.
const a = f(0)
if a is A { print(a.kind) } else { print("notA") }
