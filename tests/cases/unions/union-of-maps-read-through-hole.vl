// @run
// @log xnull
// @log true
// @log 1
// @log x
// @log b
// @log 2
// @log none
// A union of maps handed to an un-annotated parameter is read at its pin and lowered per map
// arm: `.has`, `.get`, an index, `.length`, a string-or-null value and a second instance of one
// hole function.
function __pick(p, c: boolean) {
  const s: {[string]: string} = Map()
  s["k"] = p
  const t: {[string]: boolean} = Map()
  t["k"] = true
  return if c { s } else { t }
}
function __show(r: string | boolean | null): string {
  if r is null { return "null" }
  if r is string { return r }
  return "b"
}
function __take(a) {
  const v = a
  if v.has("k") {
    print(__show(v["k"]) + __show(v.get("zz")))
  } else {
    print("wrong")
  }
}
__take(__pick("x", true))
function has(a) { print(a.has("k")) }
has(__pick("x", false))
function len(a) { print(a.length) }
len(__pick("x", true))
function at(a) { print(__show(a["k"])) }
at(__pick("x", true))
at(__pick("x", false))
function wide(p) {
  const s: {[string]: string} = Map()
  s["k"] = p
  s["j"] = p
  const u: {[string]: string} | {[string]: string | null} = s
  return u
}
len(wide("y"))
function nul(a) { print(a["q"] ?? "none") }
nul(wide("y"))
