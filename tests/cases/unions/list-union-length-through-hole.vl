// @run
// @log 2
// @log 1
// @log 3
// @log 2
// @log 3
// `.length` of a union of lists read through a hole parameter or lambda: each pin types the
// read, and its instance reads the length out of whichever list arm the box holds.
function mk(k: i32): i32[][] | f64[][] {
  if k == 0 {
    const b: f64[][] = [[1.5]]
    return b
  }
  const a: i32[][] = [[1, 7], [2]]
  return a
}
function take(a) { print(a.length) }
take(mk(1))
take(mk(0))
const plain: i32[] = [1, 2, 3]
take(plain)
function mkS(k: i32): i32[] | f64[] | string {
  if k == 0 { return "s" }
  const a: i32[] = [4, 5]
  return a
}
const len = (a) => if a is string { 0 } else { a.length }
print(len(mkS(1)))
const three: f64[] = [1.5, 2.5, 3.5]
print(len(three))
