// @run
// @log 5
// @log 13
// @log 4
// @log 5
// @log 5
// @log 5
// A list literal of a union arm whose field is itself a record written inline: the arm
// builds the element, and the field's literal builds as the field's own type, nested two
// deep, typed as another arm, returned, or pushed (D13760).
type Q = { y: i32 }
type P = { x: i32, q: Q }
type A = { p: P }
type B = { n: i32 }
type C = { b: B }
type U = A | B | C

const xs: A[] = [{ p: { x: 5, q: { y: 7 } } }]
print(xs[0].p.x)
const ys: A[] = [{ p: { x: 5, q: { y: 7 } } }, { p: { x: 6, q: { y: 8 } } }]
print(ys[1].p.x + ys[0].p.q.y)
const cs: C[] = [{ b: { n: 4 } }]
print(cs[0].b.n)
function mk(): A[] { [{ p: { x: 5, q: { y: 1 } } }] }
print(mk()[0].p.x)
const zs: A[] = []
zs.push({ p: { x: 5, q: { y: 1 } } })
print(zs[0].p.x)
const ws: U[] = [{ p: { x: 5, q: { y: 1 } } }]
const w = ws[0]
if w is A { print(w.p.x) }
