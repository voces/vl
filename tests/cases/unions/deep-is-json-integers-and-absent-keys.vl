// @run
// @log S2-RANGE
// @log false
// @log true
// @log S2-FRACTION
// @log false
// @log true
// @log S2-EXACT
// @log 8081
// @log S3-ABSENT
// @log true
// @log true
// @log S3-EXPLICIT-NULL
// @log true
// @log S3-MISSING-REQUIRED
// @log false
// @log S3-PRESENT
// @log 1
// DEEP `is` OVER A `Json` — S2 (integers) and S3 (absent keys), the two sub-rules of
// `docs/serde-design.md` §"Deep `is` / `as` over a `Json` value" that decide MATCHES rather
// than reps, and whose grading list the ruling wrote out.
//
// S2 — a JSON number matches `i32` / `i64` only when it is INTEGRAL and IN RANGE, and that
// is not a second definition: the walk asks `v as? i32`, so it is literally the exact-or-fail
// numeric conversion DECISIONS.md §"Numeric `as` to an INTEGER target is exact-or-fail under
// the trio" rules for the whole language. `f64` matches any number.
//
// S3 (RULED, owner 2026-09-02) — an ABSENT key matches a `T | null` field AS `null`. The
// object level of a `Json` is a MAP and the target is a STRUCT, so "absent" is a fact of the
// source and `null` is the only thing the target can hold for it; VL's own map read already
// says absent is `null`, and a walk that refused the absent key would be STRICTER than
// reading the same map by hand. A missing NON-nullable field is still not a match.

type Json = null | boolean | f64 | string | Json[] | { [string]: Json }
type Cfg = { port: i32, host: string | null }

print("S2-RANGE")
const big: Json = 1000000000000.0
print(big is i32)
print(big is i64)

print("S2-FRACTION")
const frac: Json = 1.5
print(frac is i32)
print(frac is f64)

print("S2-EXACT")
const exact: { [string]: Json } = Map()
exact["port"] = 8080.0
const exactJ: Json = exact
if exactJ is Cfg { print(exactJ.port + 1) } else { print(-1) }

// `{"port": 1} is Cfg` → true, and `cfg.host` reads as `null`.
print("S3-ABSENT")
const absent: { [string]: Json } = Map()
absent["port"] = 1.0
const absentJ: Json = absent
print(absentJ is Cfg)
if absentJ is Cfg { print(absentJ.host == null) } else { print(false) }

// `{"port": 1, "host": null} is Cfg` → true, indistinguishable from the absent key. That
// is the point: the round trip only canonicalises the JSON TEXT, never the VL value.
print("S3-EXPLICIT-NULL")
const explicit: { [string]: Json } = Map()
explicit["port"] = 1.0
explicit["host"] = null
const explicitJ: Json = explicit
if explicitJ is Cfg { print(explicitJ.host == null) } else { print(false) }

// `{"host": "x"} is Cfg` → false: `port` is not nullable, so its absence is a mismatch.
print("S3-MISSING-REQUIRED")
const missing: { [string]: Json } = Map()
missing["host"] = "x"
const missingJ: Json = missing
print(missingJ is Cfg)

print("S3-PRESENT")
const present: { [string]: Json } = Map()
present["port"] = 1.0
present["host"] = "h"
const presentJ: Json = present
if presentJ is Cfg {
  const h = presentJ.host
  if h != null { print(h.length) } else { print(-2) }
} else { print(-1) }
