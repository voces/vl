// @run
// @log 1
// @log 9
// @log 1
// @log 9
// @log 1
// @log 1
// @log 9
// @log 1
// An `i32[][]` value (no literal) delivered into `K[][] | i32[][] | string` once `K[][]` keyed the
// shared list row: it rides the `K[][]` arm's tag, and `is` reads its leaves. Argument, binding,
// return, assignment, record field and list element positions (D16894).
type K = 0 | 1

function own(x: K[][] | string | null) {
  if x is K[][] { print(x[0][0]) } else { print(9) }
}
own([[1]])
function show(x: K[][] | i32[][] | string) {
  if x is K[][] { print(x[0][0]) } else { print(9) }
}
function back(v: i32[][]): K[][] | i32[][] | string { return v }
type H = { u: K[][] | i32[][] | string }
function run() {
  const five: i32[][] = [[5]]
  const one: i32[][] = [[1]]
  show(five)
  show(one)
  const b: K[][] | i32[][] | string = five
  show(b)
  show(back(one))
  let a: K[][] | i32[][] | string = "s"
  a = one
  show(a)
  const h: H = { u: five }
  show(h.u)
  const l: (K[][] | i32[][] | string)[] = [one, five]
  show(l[0])
}
run()
