// A union `==` against a `T | null` operand (D17065). A string or atom operand's null is
// unequal to a union with no `null` arm; a call box is read once; a nullable string call is
// read once; a `boolean | null` field compares under the boolean arm.
type K = "a" | "b"
type US = i32 | string
type UK = i32 | K
type UN = i32 | string | null
type UB = i32 | boolean
type H = { b: boolean | null }
let n = 0
let gs: string | null = null
function mk(): UN {
  n = n + 1
  return "s"
}
function ck(): string | null {
  n = n + 1
  return gs
}
function strNoNull(u: US, k: string | null) { return u == k }
function atomNoNull(u: UK, k: K | null) { return k == u }
function callBox(k: string | null) { return mk() == k }
function callOperand(u: US) { return u != ck() }
function boolField(u: UB, h: H) { return u == h.b }
print(strNoNull("s", null))
print(strNoNull("s", "s"))
print(strNoNull("s", "t"))
print(atomNoNull("a", null))
print(atomNoNull("a", "a"))
print(callBox(null))
print(callBox("s"))
gs = "s"
print(callOperand("s"))
gs = null
print(callOperand("s"))
print(n)
print(boolField(true, { b: null }))
print(boolField(true, { b: true }))
print(boolField(false, { b: false }))
