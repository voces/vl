// @error a deep `is` arm that rebinds or writes `r` is not supported yet — bind the converted value first
// THE ONE CAPABILITY REFUSAL THIS BUILD ADDS, and it is loud and positioned at the `is`
// site (D1190). A deep `is` arm reads the CONVERTED copy through a binding the rewrite
// prepends, and every read of the tested place in the arm is rewritten to it. A write to
// that place — an assignment, or a declaration that shadows it — falsifies the narrowing
// part-way through the arm (`retireNarrowingsForWrite` is the checker's rule for exactly
// this), so the reads before and after the write want DIFFERENT bindings and a blanket
// rewrite would give them the same one.
//
// It is a REFUSAL and not a wrong answer: on master this program ran and printed `0`,
// because `r is string[]` answered `false` for every value. That is the loud→? price this
// build pays, named here rather than left to be discovered.
type Json = null | boolean | f64 | string | Json[] | { [string]: Json }
function d(r: Json): i32 {
  if r is string[] {
    const n = r[0].length
    r = null
    return n
  }
  0
}
const l: Json = ["xyz"]
print(d(l))
