// A `??` written in place (its operand's head re-read in each arm) as the right operand of a
// binary operator whose left operand is read at its use: an immediate, a parameter, a global, a
// local, a loop accumulator, a nested `??`, a subtraction (order matters) and a map read.
type J = { a: i32 }
type P = { j: J, k: i32 }
type Q = { j: null, k: i32 }
function mk(b: boolean): P | Q {
  if b { return { j: { a: 3 }, k: 1 } }
  return { j: null, k: 2 }
}
const g = mk(true)
const h = mk(false)
const base = 2
function two() { return 2 }
function imm() { return 1 + (g.j?.a ?? 5) }
function param(n: i32) { return n + (h.j?.a ?? 5) }
function glob() { return base + (h.j?.a ?? 5) }
function local() {
  const c = two()
  return c * (h.j?.a ?? 5) + 1
}
function loop() {
  let t = 0
  for b in [true, false, true] {
    const v = mk(b)
    t = t + (v.j?.a ?? 7)
  }
  return t
}
function nested() { return 1 + (h.j?.a ?? 20 + (g.j?.a ?? 9) + 2) }
function sub() { return 9 - (g.j?.a ?? 5) }
function sub2() { return 6 - (h.j?.a ?? 5) }
function mapped(n: i32) {
  const m: { [string]: i32 } = Map()
  m["k"] = 2
  return n + (m["k"] ?? 0) + (n + (m["z"] ?? 5))
}
print(imm())
print(param(2))
print(glob())
print(local())
print(loop())
print(nested())
print(sub())
print(sub2())
print(mapped(2))
