// @log 20
// A record list delivered as a `readonly` list of a union holding its record is a view of the
// list, not a copy, so a write through the source after the delivery reads back through it at
// every read (D3041): index, length, walk, map, filter, slice and `.get`. The source is a
// parameter, a nullable-record list, or a field the write analysis cannot follow, each source
// inferred rather than annotated.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq

function view(xs: Circle[]): readonly Shape[] { return xs }

function sumR(xs: readonly Shape[]) {
  let t = 0
  for e in xs {
    if e is Circle { t = t + e.r }
  }
  t
}

const a = [{ r: 1 }, { r: 2 }]
const b = view(a)
a[0] = { r: 7 }
a.push({ r: 5 })
const e0 = b[0]
if e0 is Circle { print(e0.r) }
print(b.length)
print(sumR(b))
let m = 0
for q in b.map((x) => if x is Circle { x.r } else { 0 }) { m = m + q }
print(m)
print(b.filter((x) => x is Circle).length)
print(sumR(b.slice(0)))
const g = b.get(0)
if g != null {
  if g is Circle { print(g.r) }
}

function nview(xs: (Circle | null)[]): readonly (Shape | null)[] { return xs }

const n = [{ r: 1 }, null]
const nb = nview(n)
n[1] = { r: 8 }
n.push(null)
let nt = 0
for e in nb {
  if e is Circle { nt = nt + e.r }
}
print(nt)
print(nb.length)
print(nb.filter((x) => x == null).length)

type H = { cs: Circle[] }
function fview(h: H): readonly Shape[] { return h.cs }

const h = { cs: [{ r: 1 }, { r: 2 }] }
const hb = fview(h)
h.cs[1] = { r: 19 }
print(sumR(hb))
