// @info `a` is never reassigned; use `const` instead of `let`
// @hint redundant type annotation: `g` is inferred as `{r: i32} | {r: null}`
// @hint redundant type annotation: `w` is inferred as `"a" | "b"`
// @run
// @log 7
// @log 5
// @log 3
// @log 0
// @log 3
// @log null
// @log 0
// @log nul
// @log b
// @log null
// @log nul
// @log b
// @log b
// @log b
// @log null
// @log false
// @log null
// @log b
// @log true
// @log b
// A `??` of an existing record and a literal whose field is `null` joins as a union of the two
// records. Which row the join is stored at does not depend on whether another line of the
// program declares `{r: i32 | null}` (D13901).

function declaredElsewhere() {
  let a: {r: i32} | null = { r: 7 }
  const g = a ?? { r: null }
  const b: {r: i32 | null} | null = { r: 5 }
  print(g.r)
  if b != null { print(b.r) }
}
declaredElsewhere()

function readNull(a: {r: i32} | null) {
  const g = a ?? { r: null }
  if g.r == null { print(0) } else { print(g.r) }
}
readNull({ r: 3 })
readNull(null)

function toUnion(a: {r: i32} | null) {
  const g: {r: i32} | {r: null} = a ?? { r: null }
  print(g.r)
}
toUnion({ r: 3 })
toUnion(null)

function literalAtUnion() {
  const g: {r: i32} | {r: null} = { r: null }
  if g.r == null { print(0) } else { print(g.r) }
}
literalAtUnion()

// The field a string literal union.
type K = "a" | "b"
function litRead(a: {r: K} | null) {
  const g = a ?? { r: null }
  if g.r == null { print("nul") } else { print(g.r) }
}
litRead(null)
litRead({ r: "b" })

function litNarrow(a: {r: K} | null) {
  const g = a ?? { r: null }
  const v = g.r
  print(v)
  if v == null { print("nul") } else { print(v) }
  if g.r != null {
    const w: K = g.r
    print(w)
  }
}
litNarrow(null)
litNarrow({ r: "b" })

function litUses(a: {r: K} | null) {
  const g = a ?? { r: null }
  print(g.r)
  print(g.r == "b")
  const xs = [g.r]
  print(xs[0])
}
litUses(null)
litUses({ r: "b" })
