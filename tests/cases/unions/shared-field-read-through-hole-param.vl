// @run
// @log 4
// @log 5
// @log 10
// A field every member of a record union has, read through an un-annotated parameter pinned at
// the union (D15571).
type K = { h: i32 }
type J = { h: i32, z: i32 }
const k: K = { h: 4 }
const u: K | J = k
function take(a) { print(a.h) }
take(u)
function next(a) {
  const n = a.h
  return n + 1
}
print(next(u))
const jj: J = { h: 9, z: 2 }
const v: K | J = jj
print(next(v))
