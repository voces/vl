// @run
// @log true
// @log false
// Two arms of one union with the same layout, compared to each other (D57, D12465). Under the
// structural-records ruling (D3870) they are one type, and a local's cell is the rep of its
// type, so both operands are stored at one row and `==` compares their fields. The mixed twin
// `error-arm-struct-equality-mixed.vl` (an arm beside a record outside the union) still refuses.
type Circle = { r: i32 }
type Ext = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Ext | Sq

function cell() {
  const a: Circle = { r: 1 }
  const e: Ext = { r: 1 }
  return a == e
}

function differ() {
  const a: Circle = { r: 1 }
  const e: Ext = { r: 2 }
  return a == e
}

print(cell())
print(differ())
