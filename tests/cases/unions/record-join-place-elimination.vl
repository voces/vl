// @run
// @hint redundant type annotation: `xs` is inferred as `(A | B | null)[]` — remove it to lean on inference
// @hint redundant type annotation: `h` is inferred as `{f: A | B | null}` — remove it to lean on inference
// @log b
// @log 7
// @log null
// @log b
// @log 3
// @log b
// @log b
// @log b
// A record join read back from a list element, a list cell, a record field and a map cell,
// with the last branch narrowed to `B` only by ruling out `null` and then `A` (D2565).

type A = { r: i32 }
type B = { q: string }
type C = { c: i32, z: f64 }
function mkA(n: i32): A | null {
  if n == 0 { return null }
  return { r: n }
}
function mkB(s: string): B | null {
  if s == "" { return null }
  return { q: s }
}
function mkC(n: i32): C | null {
  if n == 0 { return null }
  return { c: n, z: 1.5 }
}
type H = { f: A | B | null }

function elem(ka: i32, sb: string) {
  const xs = [mkA(ka) ?? mkB(sb)]
  const x = xs[0]
  if x == null { print("null") }
  else if x is A { print(x.r) }
  else { print(x.q) }
}

function three(ka: i32, sb: string, kc: i32) {
  const xs = [mkA(ka) ?? mkB(sb) ?? mkC(kc)]
  const x = xs[0]
  if x == null { print("null") }
  else if x is A { print(x.r) }
  else if x is B { print(x.q) }
  else { print(x.c) }
}

function places() {
  const xs: (A | B | null)[] = [mkA(0) ?? mkB("b")]
  if xs[0] == null { print("null") }
  else if xs[0] is A { print(xs[0].r) }
  else { print(xs[0].q) }
  const h: H = { f: mkA(0) ?? mkB("b") }
  if h.f == null { print("null") }
  else if h.f is A { print(h.f.r) }
  else { print(h.f.q) }
  const m: { [string]: A | B | null } = Map()
  m["k"] = mkA(0) ?? mkB("b")
  if m["k"] == null { print("null") }
  else if m["k"] is A { print(m["k"].r) }
  else { print(m["k"].q) }
}

elem(0, "b")
elem(7, "")
elem(0, "")
three(0, "b", 0)
three(0, "", 3)
places()
