// Regression (silent-class-inventory D52), graduated from
// `soundness/xfail-miscompile-annotated-arm-local-beside-layout-twin.vl`.
//
// A local ANNOTATED AT A UNION ARM (`const c: Circle = { r: n }`) returned from an
// UN-ANNOTATED function, in a module that also declares a standalone struct of that arm's
// exact layout (`Dot`). On master `a97c9ae1` the first cell below was `vl check` rc 0 — one
// redundant-annotation HINT, no error — and a module the engine refuses:
//
//   type mismatch: expected (ref $type), found (ref $type)
//
// The two `$type`s are two DIFFERENT heap types behind one placeholder, and the disassembly
// is where that shows. Master emitted the twin's row as the RESULT over a body that builds
// the arm; the branch emits the arm at both ends and the caller's field read follows:
//
//   master   (result (ref 0))   (local (ref 1))  struct.new 1   struct.get 0 0
//   branch   (result (ref 1))   (local (ref 1))  struct.new 1   struct.get 1 0
//              ; type 0 is Dot's standalone row, type 1 is uVarHeap[Circle]
//
// IT IS D39's SEAM READ FROM THE OTHER END, AND IT NEEDED NO CHANNEL. With the RESULT
// annotated (`d52RetAnn`) the annotation had to be CARRIED to a local that never saw it,
// because an anonymous `{ r: n }` has two nominal claimants and only the context separates
// them — that is D39 and `synthRetPinAnn`. Here the annotation is ON the local, the pass
// that decides the result valtype is already handed that very binding by `criRetLocalLet`,
// and `letAnnVariantIdx` reads one unambiguous nominal answer straight off it. The call was
// simply not made.
//
// THE TWIN IS THE AXIS for the bare cell — `Dot` deleted, a same-arity different-NAME twin,
// or `Sq`/`Shape` deleted all RUN on master. The PARAM cell (`d52Thru`) needs no twin at
// all: nothing claimed a returned arm-typed param, so its result valtype was the i32
// default over a body pushing a ref.
// @run
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @hint redundant type annotation: `c` is inferred as `{r: i32}`
// @hint Intentionally-unused parameter `_i`
import { mapIndexed } from "std:array"

type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Dot = { r: i32 }

// The filed witness, verbatim below its declarations.
function d52Fn(n: i32) {
  const c: Circle = { r: n }
  return c
}

// The ALIAS hop — an annotated local handed back through an un-annotated `let`. This is
// D66's body, which stops being a `std:array` carve-out with the same rung.
function d52Alias(n: i32) {
  const c: Circle = { r: n }
  const o = c
  return o
}

// The RESULT-annotated control, which is D39 and already ran: both ends agree on
// `uVarHeap[Circle]` because the annotation reaches the local through `synthRetPinAnn`.
function d52RetAnn(n: i32): Circle {
  const c = { r: n }
  return c
}

// The PARAMETER storage class of the same seam — six lines, no local, no twin needed. The
// result valtype was the i32 default over a body pushing `(ref $type)`.
function d52Thru(x: Circle) { return x }

// `std:array`'s surface, so the routing test that decides a carve-out (is the outcome WORSE
// through the module than written directly?) has both sides in one file.
function d52Cb(n: i32, _i: i32) {
  const c: Circle = { r: n }
  const o = c
  return o
}

print(d52Fn(7).r)
print(d52Alias(7).r)
print(d52RetAnn(7).r)
print(d52Thru(d52Fn(7)).r)
print(mapIndexed([7], d52Cb)[0].r)
