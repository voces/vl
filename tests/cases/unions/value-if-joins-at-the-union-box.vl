// @run
// @log big
// @log int
// @log on
// @log null
// @log int
// @log small
// A value `if` whose arms join at a union is boxed per arm, passed as an argument: an `else if`
// chain, an else-less `if` whose missing arm is `null`, and an arm with statements before its value.
type U = i32 | string
function show(u: U | null) {
  if u == null { return "null" }
  if u is string { return u }
  return "int"
}
function arg(c: i32) {
  print(show(if c > 1 { "big" } else if c > 0 { c } else { 0 }))
}
function argOpt(c: boolean) { print(show(if c { "on" })) }
function argPre(c: i32) {
  print(
    show(
      if c > 5 {
        const t = c * 2
        t
      } else {
        "small"
      },
    ),
  )
}
arg(2)
arg(1)
argOpt(true)
argOpt(false)
argPre(9)
argPre(1)
