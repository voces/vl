// @emit-error is a struct arm
// A FLOOR PIN with a workaround in the message. `x as T` propagates a VALUE-union arm
// (`string`, a scalar, a closure, a map, a list) and refuses a STRUCT one — which is the
// shape a fallible function usually returns, so it is worth saying exactly why.
//
// A struct arm is a VARIANT: its box tag lives in `uTags[vi]`, keyed by the variant table,
// not in `isArmTagOfTy`. Giving it one is NOT the hard part — that was built and measured. The
// hard part is that every rep CLASSIFIER reads the `AsExpr` node and defaults to i32, so with
// only the tag wired the cast lowers a correct `ref.cast` into a slot the caller still types
// i32: `type mismatch: expected i32, found (ref $type)`, one layer out from the cast. The same
// wall as `exprString`, which needed its own arm to see through `as`, but across the whole
// classifier family rather than one function.
//
// So the arm is refused until the family learns the cast, and the message names the spelling
// that works today — which is not a lesser mechanism, it is the same union:
//
//     function areaOf(a: f64): f64 | ParseError {
//       const c = mk(a)
//       if c is ParseError { return c }     // re-raise, unchanged
//       return c.r                          // `c` is a Circle here
//     }
//
// TWO NEIGHBOURING GAPS, measured the same day and recorded here because they share a root —
// the emitter's per-shape ladders each need their own arm, and `as` is a new consumer of all
// of them:
//   - a SUB-UNION target (`as Shape` over `Circle | Rect | ParseError`, where
//     `type Shape = Circle | Rect`) is the cheaper lowering — the result IS the box, no unbox
//     at all — and it needs the same struct-arm tags this one does;
//   - a NESTED union (`Shape | ParseError` as a return type) cannot take an object literal at
//     all: the checker-side flatten alone makes it a `wasm trap: cast failure`, because the
//     emitter's variant registration does not flatten either.
type Circle     = { kind: "circle", r: f64 }
type ParseError = { why: string }

function mk(a: f64): Circle | ParseError {
  if a <= 0.0 { return { why: "radius must be positive" } }
  return { kind: "circle", r: a }
}

function radiusOf(a: f64): f64 | ParseError {
  const c = mk(a) as Circle
  return c.r
}
print(1)
