// @run
// @log 2.5
// @log 152.5
// @log 152.5
// @log 152.5
// A record that is also a declared union's arm, read as `B | null` and narrowed, delivers into
// a `B` argument and a `B`-typed `if` join, whichever niche its source classified it at (D3593).
type B = { x: f64, lean: f64 }
type U = B | f64
const L: B[] = [{ x: 2.5, lean: 1.5 }]
const u: U = 0.5
function take(b: B) { b.x + b.lean * 100.0 }
function viaList(k: i32) {
  const got = L.get(k)
  if got != null { return take(got) }
  -1.0
}
function viaJoin(p: B | null, c: boolean) {
  const got = p
  if got != null {
    const t: B = if c { got } else { { x: 0.0, lean: 0.0 } }
    return take(t)
  }
  -1.0
}
if u is f64 { print(u + 2.0) }
print(viaList(0))
print(viaJoin(L[0], true))
print(viaJoin({ x: 2.5, lean: 1.5 }, true))
