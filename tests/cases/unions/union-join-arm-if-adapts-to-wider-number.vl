// @run
// @hint redundant type annotation: `k` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `wk` is inferred as `f64 | string` — remove it to lean on inference
// @hint redundant type annotation: `wj` is inferred as `f64 | string` — remove it to lean on inference
// @log 3
// @log 2.5
// A union join's arm whose value is an `if` typed one wider number than a tail is built at that
// number and boxed once, on either inner path.
function pick(n: i32) { return n > 1 }
const k: i32 = 3
const wk: f64 | string = if pick(2) { if pick(3) { k } else { 2.5 } } else { "s" }
print(wk)
const wj: f64 | string = if pick(2) { if pick(0) { k } else { 2.5 } } else { "s" }
print(wj)
