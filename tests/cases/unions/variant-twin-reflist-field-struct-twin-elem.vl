// @run
// @log 7
// @log 107
// @log 105
// @log -1
// @log -1
// @hint redundant type annotation: `pickU` is inferred as `i32`
// @hint redundant type annotation: `pickV` is inferred as `i32`
// @hint redundant type annotation: `c` is inferred as `{ns: {v: i32}[]}`
// @hint redundant type annotation: `k` is inferred as `{ns: {v: i32}[]}`
// @hint redundant type annotation: `d` is inferred as `{w: i32}`
// @hint redundant type annotation: `b` is inferred as `{z: i32}`
// VARIANT twin dedup through a REF-LIST field whose ELEMENT types are declared
// struct twins (`rlSlotsLayoutTwin`'s struct tail). `Cat = {ns: A[]}` and
// `Kot = {ns: B[]}` have the SAME canonical variant key (the key expands a
// declared struct structurally, so `A` and `B` collapse), but the ref-list layer
// interns `A[]` and `B[]` on NOMINAL element keys — two DISTINCT slots. The
// per-field layout guard therefore compares two distinct struct-element slots and
// must answer "twin", or the two variants mint separate heap types and a `Cat`
// flowing through `V`'s `is Kot` arm casts to the wrong one: a runtime TRAP.
type A = { v: i32 }
type B = { v: i32 }
type Cat = { ns: A[] }
type Kot = { ns: B[] }
type Dog = { w: i32 }
type Bird = { z: i32 }
type U = Cat | Dog
type V = Kot | Bird

function pickU(u: U): i32 {
  if u is Cat { return u.ns[0].v }
  return -1
}
function pickV(v: V): i32 {
  if v is Kot { return v.ns[0].v + 100 }
  return -1
}

function go() {
  const c: Cat = { ns: [{ v: 7 }] }
  print(pickU(c)) // 7 — Cat through U
  print(pickV(c)) // 107 — Cat through V's structural twin arm
  const k: Kot = { ns: [{ v: 5 }] }
  print(pickV(k)) // 105
  const d: Dog = { w: 1 }
  print(pickU(d)) // -1
  const b: Bird = { z: 3 }
  print(pickV(b)) // -1
}
go()
