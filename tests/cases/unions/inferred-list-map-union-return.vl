// @run
// @log 5
// @log 1
// @log true
// @log y
// @log 9
// @log null
// An un-annotated function returning a list or a map (or `Set`) infers their union, which
// lowers as its annotated twin does (D16024).
function k(n: i32) { n }

function pick(c: i32) {
  if c == 1 { return [k(1), 2] }
  const m: {[string]: i32} = Map()
  m["a"] = k(5)
  return m
}
const a = pick(0)
if a is i32[] { print(a[0]) } else { print(a["a"] ?? 0) }
const b = pick(1)
if b is i32[] { print(b[0]) } else { print(0) }

function pickSet(c: i32) {
  if c == 1 { return ["x", "y"] }
  const s: Set<i32> = Set()
  s.add(k(5))
  return s
}
const c = pickSet(0)
if c is string[] { print(c[1]) } else { print(c.has(5)) }
const d = pickSet(1)
if d is string[] { print(d[1]) } else { print(false) }

function pickThree(c: i32) {
  if c == 1 { return [k(1)] }
  if c == 2 { return 9 }
  if c == 3 { return null }
  const m: {[string]: i32} = Map()
  return m
}
const e = pickThree(2)
if e is i32 { print(e) } else { print(-1) }
const f = pickThree(3)
if f == null { print("null") } else { print("set") }
