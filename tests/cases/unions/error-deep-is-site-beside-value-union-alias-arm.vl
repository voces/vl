// @emit-error `is` names a declared union member with no interned arm representation
// D1744's own witness, one stage on: `f` alone reaches this same emitter refusal, and the
// deep-`is` site in `g` used to move it to a checker one that named a union the author never
// wrote (`'J' is not a variant of boolean | f64 | string | J[] | {[string]: J} | i32 | null`).
// The refusal that stands is the emitter's, and lifting it is D1774.

type J = null | boolean | f64 | string | J[] | { [string]: J }
type Cfg = { port: f64 }

function f(d: J | i32) {
  if d is J { print(1) }
}
function g(e: J) {
  if e is Cfg { print(2) }
}
f(1)
g(null)
