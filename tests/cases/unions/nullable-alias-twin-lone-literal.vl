// @run
// @log 2
// @log true
// @log 7
// @log -1
// An alias `N | null` over arms that differ only in a lone literal names its union row, at a
// binding and an annotated parameter (D5241).
type N = { tag: "a", v: i32 } | { tag: "b", v: i32 }
type NN = N | null
function f(q: NN) {
  if q == null { return 0 - 1 }
  if q.tag == "a" { return q.v }
  0
}
const y: N = { tag: "b", v: 2 }
const q: NN = y
if q != null { print(q.v) }
const z: NN = null
print(z == null)
print(f({ tag: "a", v: 7 }))
print(f(null))
