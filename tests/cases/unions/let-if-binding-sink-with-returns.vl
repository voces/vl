// @run
// @log 7
// @log true
// @log 9
// @log 3
// BOTH union-box sinks inside ONE function, which is what makes them share a frame.
//
// The tag/payload pair is reserved once and used by each position in turn: a binding's
// if-arms write it and the construction after the `if` reads it, while the function's own
// `return`s write it on their way to the exit block. The two live ranges cannot interleave
// — a sunk `return` branches straight to the exit and a sunk binding arm falls straight to
// the `if`'s `end`, and an arm's value is an expression, so no `return` can be emitted
// between an arm's write and the construction that reads it. If they ever could, this case
// reads a value from the wrong producer rather than failing to validate, which is why it is
// pinned behaviourally.
//
// `k` is the same claim with the nesting reversed: the binding lives INSIDE an arm of the
// `if` whose other path returns.

function h(i: i32): i64 | boolean {
  const u: i64 | boolean = if i % 2 == 0 then 7 else true
  if i > 5 { return u }
  if i == 1 { return true }
  return 9
}

function k(i: i32): i64 | boolean {
  if i > 5 {
    const u: i64 | boolean = if i % 2 == 0 then 3 else true
    return u
  }
  return true
}

function go() {
  const a = h(6)
  if a is i64 {
    print(a) // 7
  }
  const b = h(1)
  if b is boolean {
    print(b) // true
  }
  const c = h(2)
  if c is i64 {
    print(c) // 9
  }
  const d = k(6)
  if d is i64 {
    print(d) // 3
  }
}
go()
