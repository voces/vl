// @check
// @error operator '+' is not defined for i32 | null and i32
// @error operator '+' is not defined for i32 | null and i32
// @error operator '+' is not defined for i32 | null and i32
// @error operator '+' is not defined for i32 | null and i32
// The join is the meet of the paths, never the most hopeful one (must-error, D3285). Each
// function below leaves one path through the `if` holding a possible `null`: a one-armed fill
// with no test, a fill nested under an unrelated condition, a fill inside a loop body that may
// not run, and a fill followed by a wider write.
function nn(v: i32): i32 | null {
  if v < 0 { return null }
  return v
}

function oneArm(k: i32, c: boolean): i32 {
  let x = nn(k)
  if c { x = 0 }
  return x + 1
}

function nestedPartial(k: i32, c: boolean): i32 {
  let x = nn(k)
  if c {
    if x == null { x = 0 }
  }
  return x + 1
}

function loopBody(k: i32, n: i32): i32 {
  let x = nn(k)
  let i = 0
  while i < n {
    if x == null { x = 0 }
    i = i + 1
  }
  return x + 1
}

function widerAfter(k: i32, j: i32): i32 {
  let x = nn(k)
  if x == null { x = 0 }
  x = nn(j)
  return x + 1
}

print(
  oneArm(1, true) + nestedPartial(1, true) + loopBody(1, 1) + widerAfter(1, 1),
)
