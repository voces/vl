// @run
// @log 9
// @hint redundant type annotation: `x` is inferred as `Cat`
// The nullable-field face of D12459. `Cat`'s only field admits `null`, and the call ARGUMENT
// `{ p: 9 }` is still the parameter's `P`, not a `Cat` with `c` left out.
type Cat = { c: i32 | null }
type Dog = { d: i32 }
type U = Cat | Dog
type P = { p: i32 }
function take(p: P): Cat { { c: p.p } }
const x: Cat = take({ p: 9 })
const cv = x.c
if cv != null { print(cv) } else { print(7) }
