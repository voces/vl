// @run
// @log 7
// @log 8
// @log 1
// @log 7
// @log 7
// @log 7
// @log true
// @log hi
// @log 1.5
// @log 9
// @log 7
// @log 7
// @log 7
// @log 7
// @log 2
// A union-typed binding declared inside a TOP-LEVEL BLOCK is a START-FUNCTION
// LOCAL, not a wasm global — so `unionNameOfIdent`'s module leg, which resolved a
// module-scope binding only through `globalLetOf` (the wasm-GLOBAL name table),
// answered "" for it and EVERY union classifier declined. The narrowed read then
// skipped its unbox and handed the `(ref $box)` straight to `__print_i32__`:
// `failed to compile: wasm[0]::function[N]`, at `vl check` clean.
//
// The two typed-IR nets that already patch this shape twice
// (`identChainTyBoxedUnion`, `identChainTyMapArmUnion`) both open with
// `if depth <= 0 || fnIx < 0 { return false }` — function-only, so neither can
// cover module scope.
//
// NB neither a closure nor a `| null` is an ingredient: the IDENTICAL body inside
// a `function` has always worked, which is the control every cell below carries in
// `tests/cases/unions/function-block-union-binding.vl`. The cells span the read
// POSITION (print / arithmetic / comparison / rebind / call-arg / assign), the atom
// ARM (i32 / boolean / string / f64 / i64), the union-returning CALL init, the
// BLOCK kind (if / else / while / for / nested) and the ref-array arm.

function idf(x: i32) { return x }
function g(): i32 | boolean { return 7 }
// An opaque `false` — a literal one makes the else-arm cell a never-taken branch.
function no() { return false }

// ── read position ────────────────────────────────────────────────────────────
const u: i32 | boolean = 7
if true {
  const r = u
  if r is i32 { print(r) } // 7
}
if true {
  const r = u
  if r is i32 { print(r + 1) } // 8
}
if true {
  const r = u
  if r is i32 {
    if r == 7 { print(1) } // 1
  }
}
if true {
  let r = u
  r = g()
  if r is i32 { print(r) } // 7
}
if true {
  const r = u
  if r is i32 { print(idf(r)) } // 7
}
if true {
  const r = u
  let out = 0
  if r is i32 { out = r }
  print(out) // 7
}

// ── atom arm ─────────────────────────────────────────────────────────────────
const ub: boolean | i32 = true
if true {
  const r = ub
  if r is boolean { print(r) } // true
}
const us: string | i32 = "hi"
if true {
  const r = us
  if r is string { print(r) } // hi
}
const uf: f64 | boolean = 1.5
if true {
  const r = uf
  if r is f64 { print(r) } // 1.5
}
const ul: i64 | boolean = 9
if true {
  const r = ul
  if r is i64 { print(r) } // 9
}

// ── a union-returning CALL as the init (no union-typed ident in sight) ────────
if true {
  const r = g()
  if r is i32 { print(r) } // 7
}

// ── block kind ───────────────────────────────────────────────────────────────
let n = 0
while n < 1 {
  const r = u
  if r is i32 { print(r) } // 7
  n = n + 1
}
if no() {
  print(0)
} else {
  const r = u
  if r is i32 { print(r) } // 7
}
if true {
  if true {
    const r = u
    if r is i32 { print(r) } // 7
  }
}

// ── the ref-array arm ────────────────────────────────────────────────────────
const ua: i32[] | boolean = [1, 2]
if true {
  const r = ua
  if r is i32[] { print(r.length) } // 2
}
