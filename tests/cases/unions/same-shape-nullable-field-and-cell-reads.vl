// @run
// @log 4
// @log 4
// @log 4
// @log true
// @log 11
// A field read off a map value and a list element of `Pa | Pb | null` over same-shape records
// (D5461), and a record field of that type (D5541): each is the nullable record `Pa | null`.
type Pa = { tag: i32, val: i32 }
type Pb = { tag: i32, val: i32 }
type H = { p: Pa | Pb | null }
function pick(n: i32): Pa | Pb {
  const b: Pb = { tag: 2, val: n }
  return b
}
const m: { [string]: Pa | Pb | null } = Map()
m["k"] = pick(4)
if m["k"] == null { print("null") } else { print(m["k"].val) }
const ys: (Pa | Pb | null)[] = [pick(4), null]
if ys[0] != null { print(ys[0].val) }
const h: H = { p: pick(4) }
const p = h.p
if p != null { print(p.val) }
const g: H = { p: null }
print(g.p == null)
const xs: (Pa | Pb | null)[] = [h.p, g.p, pick(7)]
let s = 0
for x in xs {
  if x != null { s = s + x.val }
}
print(s)
