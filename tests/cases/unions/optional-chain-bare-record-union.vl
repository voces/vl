// @run
// @hint redundant type annotation: `pick` is inferred as `string`
// @log b
// @log z
// @log true
// @log kk
// @log nk
// @log a
// A bare `?.` read over a nullable union of records, bound un-annotated and coalesced later,
// in a function body, and over a nullable field read then coalesced (D5300).
type N = { tag: "a", v: i32 } | { tag: "b", w: i32 }
type K = { tag: "a", v: i32, k: string | null }
  | { tag: "b", w: i32, k: string | null }
const y: N = { tag: "b", w: 2 }
const q: N | null = y
const t = q?.tag
print(t ?? "z")
const n: N | null = null
const u = n?.tag
print(u ?? "z")
function inner(p: N | null) {
  const s = p?.tag
  print(s == null)
}
inner(null)
const ky: K = { tag: "b", w: 2, k: "kk" }
const kq: K | null = ky
print(kq?.k ?? "nk")
const kn: K | null = { tag: "a", v: 1, k: null }
print(kn?.k ?? "nk")
function pick(p: N | null): string { p?.tag ?? "d" }
print(pick({ tag: "a", v: 1 }))
