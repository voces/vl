// @run
// @log 2
// @log 2
// @log s
// @log true
// @log a5
// @log bq
// @log none
// `as? (A | B)` out of a nullable union of records, with the binding left un-annotated: the
// narrowed field read finds its struct rows at module scope, with same-field arms, and inside
// a function over a parameter (D4260).
import { toString } from "std:fmt"

type A = { v: i32 }
type B = { w: string }
function pick(f: boolean): A | B {
  if f { return { v: 1 } }
  { w: "s" }
}
const o: (A | B) | null = pick(true)
const u = o as? (A|B)
if u != null {
  if u is A { print(u.v + 1) } else { print(u.w) }
}

type C = { v: i32 }
type D = { v: string }
function pick2(f: boolean): C | D {
  if f { return { v: 1 } }
  { v: "s" }
}
const p: (C | D) | null = pick2(true)
const q = p as? (C|D)
if q != null {
  if q is C { print(q.v + 1) } else { print(q.v) }
}
const p2: (C | D) | null = pick2(false)
const q2 = p2 as? (C|D)
if q2 != null {
  if q2 is C { print(q2.v + 1) } else { print(q2.v) }
}
const p3: (C | D) | null = null
const q3 = p3 as? (C|D)
print(q3 == null)

function show(o: (A | B) | null) {
  const u = o as? (A|B)
  if u != null {
    if u is A { return "a" + (u.v + 1).toString() }
    return "b" + u.w
  }
  "none"
}
const a: A = { v: 4 }
const b: B = { w: "q" }
print(show(a))
print(show(b))
print(show(null))
