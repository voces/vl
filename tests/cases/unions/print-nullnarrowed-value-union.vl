// @run
// @log s
// @log 5
// @log s
// @hint redundant type annotation: `t` is inferred as `string | i32 | null`
// D968 — `print` of a `!= null`-NARROWED value union. The narrow drops the null ARM and the
// remaining two still ride the box, so the tag dispatch is what prints it. `printUnionRecvIsBox`
// used to decline every narrowed receiver, which sent the box through `__print_i32__`:
// `vl check` rc 0 and INVALID WASM (`expected i32, found (ref $type)`).
//
// The one-arm case below is the reason the gate existed and must keep declining: `is string`
// leaves the value at the string's own rep, not in a box.
function mk(b: boolean): string | i32 | null {
  if b { return "s" }
  null
}

const t: string | i32 | null = mk(true)
if t != null { print(t) }

function mk2(b: boolean): i32 | boolean | null {
  if b { return 5 }
  null
}
const u = mk2(true)
if u != null { print(u) }

// Narrowed to ONE atom — the older ladder, not the tag dispatch.
const w = mk(true)
if w is string { print(w) }
