// @error is not on every member
// THE DISCRIMINANT REQUIRES A SYNTACTIC LITERAL. `s.kind == t`, where `t` is a variable that
// merely happens to hold `"circle"`, proves nothing about `s`: the comparison is about the
// VALUE `t` carries at runtime, not about the type of the place. Narrowing on it would let
// `t` be reassigned — or be a parameter — and still claim the arm.
//
// So this stays the accurate loud reject it always was, and the pin exists because the
// literal rule (`discriminant-eq-narrows-parent.vl`) is one `litTyOfExpr` call away from
// admitting it: that reader answers -1 for an Ident, and this file is what notices if some
// later widening makes it answer otherwise.
type C = { kind: "circle", r: f64 }
type R = { kind: "rect", w: f64 }
type S = C | R

const t = "circle"
function area(s: S) {
  if s.kind == t { return s.r }
  return 0.0
}
print(area({ kind: "circle", r: 3.0 }))
