// @run
// @log 3
// @log 0
// @log 5
// @log k
// A `??` over a nullable field of a top-level union binding narrowed to its record arm reads the
// binding's box again on the present path and casts it to the arm, on either side of the null test.
type J = { r: i32 | null, g: i32 }
type K = { s: string }
function mk(n: i32): J | K {
  if n > 0 { return { r: n, g: 0 } }
  if n == 0 { return { r: null, g: 0 } }
  return { s: "k" }
}
const u = mk(3)
if u is J { print(u.r ?? 0) }
const z = mk(0)
if z is J { print(z.r ?? 0) }
let w = mk(5)
if w is J { print(w.r ?? 0) }
w = mk(-1)
if w is J { print(w.r ?? 0) } else { print(w.s) }
