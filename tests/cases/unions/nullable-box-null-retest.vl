// @run
// @log 8
// @log nil
// @log 8
// @log 2.5
// @log 8
// @log q
// @log 8
// @log end
// A null test nested under one that pinned the place to `null` re-reads the box: the pin is a
// hint a call, a closure or a write may have falsified, so the re-test strips `null` from the
// declared set, at a global, a local, a parameter and a field, in every spelling (D2815).
type W = { f: f64 | null }
let z: i32 | null = null
function wr() { z = 7 }
if z == null {
  wr()
  if z != null { print(z + 1) }
}
function local() {
  let y: i32 | null = null
  if y == null {
    if y == null { print("nil") } else { print(y + 1) }
  }
  const set = () => {
    y = 7
  }
  if !(y != null) {
    set()
    if !(y == null) { print(y + 1) }
  }
}
local()
function param(p: f64 | null) {
  if p != null {
    print("no")
  } else {
    p = 2.5
    if p != null { print(p) }
  }
}
param(null)
const w: W = { f: null }
if w.f == null {
  if w.f != null { print("no") }
}
let u: i32 | string | null = null
function wu(s: boolean) {
  if s { u = "q" } else { u = 7 }
}
if u == null {
  wu(false)
  if u != null {
    if u is i32 { print(u + 1) } else { print(u) }
  }
}
u = null
if u == null {
  wu(true)
  if u != null {
    if u is i32 { print(u + 1) } else { print(u) }
  }
}
let k: i32 | null = null
while k == null {
  wr(); k = z
  if k != null { print(k + 1) }
}
print("end")
