// @error is not a JSON shape — field `kids`: `Tree` is recursive; a recursive JSON shape has no walker yet
// A RECURSIVE target is the one JSON shape this build refuses, and it is a CAPABILITY gap
// rather than a design rule — a `{v: f64, kids: Tree[]}` document is perfectly good JSON.
// The walker is generated by INLINING each level (`compiler/json_walk.vl`), which a cycle
// makes unbounded; the fix is a real per-target function whose recursive call is a call, and
// that needs the narrowed-nullable delivery defect D1197 closed first (a walker returning
// `T | null` cannot deliver its result anywhere today). Filed as D1198.
type Json = null | boolean | f64 | string | Json[] | { [string]: Json }
type Tree = { v: f64, kids: Tree[] }
const j: Json = null
print(j is Tree)
