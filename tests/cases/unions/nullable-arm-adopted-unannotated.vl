// @run
// A nullable value whose record a union arm adopts keeps the arm's nullable rep: an inferred
// `return` beside `return null`, and a `.pop()` / `.get(i)` of an arm-element list (D4668).
type U = { q: i32 } | { r: i32 }
type N = { q: i32 | null } | { s: i32 }
type K = { kind: "a", q: i32 | null } | { kind: "b", r: i32 }
function g(b: boolean) {
  if b { return { q: 4 } }
  return null
}
function gn(b: boolean) {
  if b { return { q: 6 } }
  return null
}
const z = g(true)
if z != null { print(z.q + 1) }
print(g(false) == null)
const zn = gn(true)
if zn != null { print(zn.q ?? 0) }
print(gn(false) == null)
const xs = [{ q: 7 }]
const p = xs.pop()
if p != null { print(p.q + 1) }
print(xs.pop() == null)
const ks = [{ kind: "a", q: 9 }]
const k = ks.get(0)
if k != null { print(k.q ?? 0) }
function inFrame() {
  const ys = [{ q: 2 }, { q: 3 }]
  let t = 0
  while true {
    const y = ys.pop()
    if y == null { break }
    t = t + y.q
  }
  return t
}
print(inFrame())
// @log 5
// @log true
// @log 6
// @log true
// @log 8
// @log true
// @log 9
// @log 5
