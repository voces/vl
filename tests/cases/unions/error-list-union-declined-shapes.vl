// @error-at 8:9 for-in expects an array, a map or a string, got i32[] | ("x" | "y")[]
// @error-at 14:2 field 'length' is not on every member of string[] | i32[]
// A union of lists with a literal element (D2886) keeps its refusal, and so does a write to
// `.length`, which no member's length takes.
function z1(b: boolean): i32[] | ("x" | "y")[] {
  if b { return [1] }
  ["y"]
}
for v in z1(false) { print(v) }
function m1(b: boolean): string[] | i32[] {
  if b { return ["a"] }
  [1, 2]
}
const u = m1(false)
u.length = 0
