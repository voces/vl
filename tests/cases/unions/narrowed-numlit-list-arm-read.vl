// @run
// @log 7
// @log 1
// @log 7
// @log 1
// A union-box read narrowed to a list of a numeric literal union unboxes to that list, whether
// the union is annotated or inferred, read by index or delivered into a binding.
type Z = 0 | 1
function rd(c: Z[] | i32) {
  if c is i32 {
    print(0)
  } else {
    if c[0] == 1 { print(7) } else { print(0) }
  }
}
rd([1])
function bind(c: Z[] | i32) {
  if c is i32 {
    print(0)
  } else {
    const d = c
    print(d.length)
  }
}
bind([1])
function inferred(n: i32) {
  const z: Z[] = [1]
  const c = if n > 0 { z } else { n }
  if c is i32 {
    print(0)
  } else {
    if c[0] == 1 { print(7) } else { print(0) }
  }
  if c is i32 {
    print(0)
  } else {
    const d = c
    print(d.length)
  }
}
inferred(1)
