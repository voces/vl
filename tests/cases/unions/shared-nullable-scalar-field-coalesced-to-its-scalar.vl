// @run
// @log 3
// @log -1
// @log 2.5
// @log 0.5
// A field every record of a union stores as a `scalar | null` box, read under `??`: a present
// value unboxes, widening to the default's number where it is wider, and a null takes the default.
type A = { k: i32 | null, x: i32 }
type B = { k: i32 | null, y: string }
function f(u: A | B) { return u.k ?? -1 }
function g(u: A | B) { return u.k ?? 0.5 }
type C = { k: f64 | null, x: i32 }
type D = { k: f64 | null, y: string }
function h(u: C | D) { return u.k ?? 0.5 }
print(f({ k: 3, x: 1 }))
print(f({ k: null, y: "s" }))
print(h({ k: 2.5, x: 1 }))
print(g({ k: null, y: "t" }))
