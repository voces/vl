// @error is not a JSON shape — `{[i32]: i32}` has a non-string map key; a JSON object's keys are strings
// A JSON object's member names are STRINGS by the grammar, so an `{[i32]: V}` target has no
// shape to walk — refused at the `is` site, naming the map rather than the whole target.
type Json = null | boolean | f64 | string | Json[] | { [string]: Json }
type IKey = { [i32]: i32 }
const j: Json = null
print(j is IKey)
