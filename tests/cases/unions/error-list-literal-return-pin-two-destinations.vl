// @emit-error TWO declared destinations
// THE RETURN PIN'S TWIN OF `error-list-literal-pinned-two-destinations.vl` — the same
// class through the OTHER pin, and it needs its own witness because the two rungs are
// separate gates (D501).
//
// `synthRetPinAnn` (D39) reads ONLY the enclosing function's return annotation. It has no
// destination-agreement gate at all, so `const cU: Shape[] = lv1` standing beside
// `return lv1` from a `(): Circle[]` cannot make it disagree — and `dstPinAnnIn`, which
// DOES have that gate and declines this program on it, runs earlier: the late
// `collectLocals` pass then pins the binding anyway.
//
// Ablated: with only `dstPinAnnIn`'s gate this cell stays check-clean invalid wasm, and
// with only this one the map/struct-field spellings do. 4 of D501's 28 cells need BOTH
// (a `ret` kind-1 destination paired with a map or struct-field kind-2 one), because each
// pin claims them the moment the other declines.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function f(): Circle[] {
  const lv1 = [{ r: 7 }]
  const cU: Shape[] = lv1
  if cU.length > 0 { print(cU.length) } else { print(0) }
  return lv1
}
const rr = f()
print(rr.length)
