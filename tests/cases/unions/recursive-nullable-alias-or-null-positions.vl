// @run
// @log let hi
// @log let none
// @log ret hi
// @log arg hi
// @log arg none
// @log if hi
// @log elem hi
// @log asg hi
// Q58 position sweep: `T | null` over a recursive `T` that already holds `null`, which the checker
// does not fold, held at `T`'s own rep: a map read's `?? null` bound by a `let`, returned, passed
// as an argument and joined by an `if`, a list element's, and an assignment's value.
type U = null | string | U[]
function show(tag: string, u: U) {
  if u is string { print(tag + " " + u) } else { print(tag + " none") }
}
function asLet(co: { [string]: U }, a: string) {
  const v = co[a] ?? null
  show("let", v)
}
function asRet(co: { [string]: U }, a: string): U { return co[a] ?? null }
function asIf(co: { [string]: U }, a: string, c: boolean) {
  const v = if c { co[a] ?? null } else { null }
  show("if", v)
}
function asElem(xs: U[], i: i32) {
  const v = xs[i] ?? null
  show("elem", v)
}
function asAsg(co: { [string]: U }, a: string) {
  let v: U = null
  v = co[a] ?? null
  show("asg", v)
}
const m: { [string]: U } = Map()
m["x"] = "hi"
asLet(m, "x")
asLet(m, "y")
show("ret", asRet(m, "x"))
show("arg", m["x"] ?? null)
show("arg", m["y"] ?? null)
asIf(m, "x", true)
asElem(["hi"], 0)
asAsg(m, "x")
