// @run
// A field, element or map-value read narrowed by a guard unboxes at the type the checker gave
// that read, in an annotated and an un-annotated spelling, delivered as an argument and as a
// return value or binding.
type Box = { v: i32 | string }
type Ba = { a: i32, v: i32 | string }
type Bb = { b: i32, v: i32 | string }
function fieldArg(b: Box) {
  if b.v is i32 { print(b.v + 1) } else { print(b.v) }
}
function fieldRet(b: Box): i32 {
  if b.v is i32 { return b.v * 10 }
  0
}
function fieldInfer(b: Box) {
  if b.v is i32 { return b.v }
  -1
}
fieldArg({ v: 4 })
fieldArg({ v: "s" })
print(fieldRet({ v: 3 }))
print(fieldInfer({ v: 6 }) + 1)
function mk(n: i32): i32 | string {
  if n > 0 { return n }
  "neg"
}
const lit = { v: mk(8) }
if lit.v is i32 {
  const w = lit.v
  print(w + 2)
}
function shared(x: Ba | Bb) {
  if x.v is i32 { print(x.v + 100) } else { print("other") }
}
shared({ a: 1, v: 5 })
shared({ b: 2, v: "t" })
function sharedBind(x: Ba | Bb | null) {
  if x != null && x.v is i32 {
    const k: i32 = x.v
    print(k)
  } else {
    print("no")
  }
}
sharedBind({ a: 1, v: 6 })
sharedBind(null)
function sharedRet(x: Ba | Bb): string {
  if x.v is string { return x.v + "!" }
  "int"
}
print(sharedRet({ b: 1, v: "s" }))
const arms: (Ba | Bb)[] = [{ a: 1, v: 4 }, { b: 2, v: "w" }]
for x in arms {
  if x.v is i32 { print(x.v * 2) } else { print(x.v) }
}
const xs: (i32 | string)[] = [1, "a"]
if xs[0] is i32 {
  print(xs[0] + 1)
  const e = xs[0]
  print(e * 3)
}
const ys = [mk(2), "b"]
if ys[0] is i32 { print(ys[0] + 40) }
function elemRet(zs: (f64 | string)[]): f64 {
  if zs[0] is f64 { return zs[0] / 2.0 }
  0.0
}
print(elemRet([3.0]))
const m: Map<string, i32 | string> = Map()
m["a"] = 3
m["b"] = "x"
if m["a"] is i32 { print(m["a"] + 1) }
if m["b"] is string {
  const s = m["b"]
  print(s + "!")
}
function coalesce<T>(p: { a: (T | null)[] }, d: T): T { p.a[0] ?? d }
print(coalesce({ a: [7, null] }, 0) + 1)
const na: (i32 | null)[] = [null]
print(coalesce({ a: na }, 9) + 1)
// @log 5
// @log s
// @log 30
// @log 7
// @log 10
// @log 105
// @log other
// @log 6
// @log no
// @log s!
// @log 8
// @log w
// @log 2
// @log 3
// @log 42
// @log 1.5
// @log 4
// @log x!
// @log 8
// @log 10
// @hint redundant type annotation: `fieldRet` is inferred as `i32` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// @hint redundant type annotation: `k` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `sharedRet` is inferred as `string` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// @hint redundant type annotation: `xs` is inferred as `(i32 | string)[]` — remove it to lean on inference
// @hint redundant type annotation: `elemRet` is inferred as `f64` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
