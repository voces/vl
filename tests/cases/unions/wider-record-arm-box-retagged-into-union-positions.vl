// @run
// @log 5
// @log x
// @log 5
// @log 5
// @log 5
// @log 5
// @log 5
// @log 5
// @log 2
// A `D | B` box delivered into `Pet = A | B`, where `D` is a record wider than arm `A`: the box's
// `D` arm is re-boxed under `A`, and `B` keeps its tag. Declaration, argument, return,
// assignment, record field, list element and map value positions (D15057).
type A = { k: i32, legs: i32 }
type B = { s: string }
type Pet = A | B
type D = { k: i32, legs: i32, purr: boolean }
function mk(c: boolean): D | B {
  if c { return { k: 3, legs: 5, purr: true } }
  return { s: "x" }
}
function legs(p: Pet) { return if p is A { p.legs } else { -1 } }
function back(c: boolean): Pet { return mk(c) }
type Holder = { pet: Pet }
const p: Pet = mk(true)
if p is A { print(p.legs) }
const q: Pet = mk(false)
if q is B { print(q.s) }
print(legs(mk(true)))
print(legs(back(true)))
let r: Pet = { s: "y" }
r = mk(true)
print(legs(r))
const h: Holder = { pet: mk(true) }
print(legs(h.pet))
const xs: Pet[] = [mk(true), mk(false)]
print(legs(xs[0]))
const m: {[string]: Pet} = Map()
m["a"] = mk(true)
const got = m["a"]
if got != null { print(legs(got)) }
let n = 0
for x in xs { if x is B { n = n + 2 } }
print(n)
