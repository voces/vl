// @run
// @log 1
// @log 7
// @log 12
// @log 24
// @log 3
// @log 9
// @log 5
// @log b
// @log i
// @log 2.5
// @log f
// A field every member of a record union carries is readable on the union, and the read
// dispatches on the box tag to each member's own field index (D3562, sunpa SP-019). Only the
// scalar and string field reps lowered before: a list, record or map field was a loud
// `field access receiver is not a struct`, and a write through the union was its
// `field-assignment` twin. Members storing the field at different value atoms box each one,
// so the read is the union of their types, numbers kept apart as an `if` over the arms would.
type A = { kind: string, n: i32[], q: Q, w: i32 }
type B = { kind: string, n: i32[], extra: f64, w: i32, q: Q }
type Q = { m: i32[], s: i32 }
function first(p: A | B) { p.n[0] }
function deep(p: A | B) { p.q.m[1] + p.q.s }
function bump(p: A | B, v: i32) {
  p.w = p.w + v
  p.n.push(v)
}
const a = { kind: "a", n: [1], q: { m: [1, 2], s: 10 }, w: 2 }
const b = { kind: "b", n: [7, 8], extra: 1.5, w: 4, q: { m: [3, 4], s: 20 } }
print(first(a))
print(first(b))
print(deep(a))
print(deep(b))
bump(a, 1)
bump(b, 5)
print(a.w)
print(b.w)
print(b.n[2])
// Two atoms sharing the i32 storage are still two members of the join.
type C = { kind: string, v: boolean }
type D = { kind: string, v: i32, extra: f64 }
function show(p: C | D) {
  const v = p.v
  if v is boolean { return "b" }
  "i"
}
const c = { kind: "c", v: true }
const d = { kind: "d", v: 3, extra: 1.0 }
print(show(c))
print(show(d))
// An i32 and an f64 field read as `i32 | f64`.
type E = { kind: string, v: i32 }
type F = { kind: string, v: f64, extra: boolean }
function num(p: E | F) {
  const x = p.v
  if x is i32 { return "i" }
  "f"
}
const f = { kind: "f", v: 2.5, extra: true }
const g: E | F = f
print(g.v)
print(num(f))
