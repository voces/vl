// @error DIFFERENT element union
// TWO DECLARED UNIONS OVER ONE WRITTEN-THROUGH LIST (D853), and the reason it is not
// D821's sentence.
//
// D821 refuses a covariant assignment whose value needs TWO ELEMENT STORAGES — a plain
// `Circle` row and a `{tag, payload}` box — because the destination would have to hold a
// converted copy and a store through either handle would be invisible to the other. Here
// both `Shape[]` and `Other[]` are BOXES: the program mints one box type, `assignTags`
// ranks the arms program-globally, nothing is copied, and every handle aliases one list.
// Nothing about storage is wrong.
//
// What is wrong is that the two declared views disagree about which ARMS the elements may
// be. `b[0] = { t: 3 }` is admitted by `Other`, and the element it leaves behind is a
// `Tri`, which `Shape` has no arm for. Read it back through `a` and there is no correct
// value to produce: with a field read the bare `ref.cast` in `match`'s untested final arm
// TRAPS (`d741_w0_base`), and without one the `Sq` arm just runs and prints `200` —
// check-clean, exit 0, silently wrong (D832, the corpus's only `runs but wrong value`).
//
// THE SIBLING THAT MUST KEEP RUNNING IS ONE LINE AWAY, and it is why the rule asks whether
// an element is READ: `list-two-unions-no-elem-read.vl` is this program with the read
// deleted, it prints `1`, and refusing it would be refusing a program the compiler runs
// correctly.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Tri = { t: i32 }
type Shape = Circle | Sq
type Other = Circle | Tri

function f() {
  const xs = [{ r: 7 }]
  const a: Shape[] = xs
  const b: Other[] = xs
  b[0] = { t: 3 }
  const e = a[0]
  match e {
    Circle => print(100 + e.r),
    Sq => print(200 + e.s),
  }
}

f()
