// @run
// @log 7
// @log -1
// @log 7.25
// @log -1.5
// @log a
// @log z
// @log 5
// @log -1
// @log 3
// @log -1
// @log true
// @log -1
// @log 1
// @log -1
// @log 2
// @log -1
// CONTRACT (must-RUN): `x ?? null` — the `??` DEFAULT position at a BARE `null`.
//
// A bare `null` has no rep of its own; it takes the one the enclosing position seeds (the
// table at `emitNullLitNode`). Every `T | null` boundary in the emitter seeds one — a field,
// a variant field, an array element, a param, a return, a `let`, an assign — and the `??`
// DEFAULT seeded NONE, so five spellings fell to the bottom of that table and took the loud
// `emitProgram: bare null needs a struct-typed context` reject on a `vl check`-clean program
// (`silent-class-inventory` D801, filed as D784).
//
// TWO SEEDS CLOSE ALL FIVE, and each is the decision its own family already makes:
//   • the three BOXED value-union arms (an ident LHS, a CALL LHS, a value-union FIELD LHS)
//     emit the default through `emitUnionCoerce`, whose `NullLit` arm IS the null-tagged
//     box the `(ref $uBox)` block type wants. A non-null default passes through unchanged.
//   • the `string | null` NICHE arm asks `coalesceDefaultNullable` — THE nullability
//     decision the boxed, nullable-struct and nullable-collection arms all take — instead of
//     a narrower "is the default itself a nullable STRING", which read `s ?? null` as
//     non-null and then declared a `(ref $aTypeIdx)` block around an unseeded `null`.
//
// THE THREE THAT ALREADY RAN are kept as controls, and they are why this is a SEED gap and
// not a missing rep: `boolean | null` (the sentinel-2 niche), `S | null` (a live
// `pendingStructIdx` from the binding) and `i32[] | null` (the nullable-list wrapper) each
// reach `emitNullLitNode` with a seed already set, at the same expression in the same
// position, one rep over.

// ---- i32 | null: the ident LHS, the boxed value union ----
function gI32(c: i32 | null) {
  const g = c ?? null
  if g != null { print(g) } else { print(-1) }
  0
}
gI32(7)
gI32(null)

// ---- f64 | null: the other scalar box rep ----
function gF64(c: f64 | null) {
  const g = c ?? null
  if g != null { print(g) } else { print(-1.5) }
  0
}
gF64(7.25)
gF64(null)

// ---- string | null: the nullable-string NICHE ----
function gStr(c: string | null) {
  const g = c ?? null
  if g != null { print(g) } else { print("z") }
  0
}
gStr("a")
gStr(null)

// ---- a CALL LHS: the stashed box ----
function mk(b: boolean): i32 | null {
  if b { return null }
  return 5
}
function gCall(b: boolean) {
  const g = mk(b) ?? null
  if g != null { print(g) } else { print(-1) }
  0
}
gCall(false)
gCall(true)

// ---- a value-union FIELD LHS ----
type W = { v: i32 | null }
function gField(o: W) {
  const g = o.v ?? null
  if g != null { print(g) } else { print(-1) }
  0
}
gField({ v: 3 })
gField({ v: null })

// ---- CONTROL: boolean | null, the i32 sentinel-2 niche (ran before) ----
function gBool(c: boolean | null) {
  const g = c ?? null
  if g != null { print(g) } else { print(-1) }
  0
}
gBool(true)
gBool(null)

// ---- CONTROL: S | null, the nullable-struct niche (ran before) ----
type S = { n: i32 }
function gStruct(c: S | null) {
  const g = c ?? null
  if g != null { print(g.n) } else { print(-1) }
  0
}
gStruct({ n: 1 })
gStruct(null)

// ---- CONTROL: i32[] | null, the nullable-list wrapper (ran before) ----
function gList(c: i32[] | null) {
  const g = c ?? null
  if g != null { print(g[0]) } else { print(-1) }
  0
}
gList([2, 3])
gList(null)
