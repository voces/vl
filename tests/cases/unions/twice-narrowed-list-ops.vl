// @run
// @log 2
// @log 0
// @log 1
// @log 2
// @log 2
// @log 3
// @log 0
// @log 3
// @log 2

// D1823 — the scratch-frame collect pass walks an `if` chain's arms with no narrowing, so a
// receiver narrowed to a ref-element list arm inside a SECOND `if` classifies as its whole
// union, reserves no frame, and the emit-time lookup has no row. Each arm is now walked under
// its own pin, as `emitStmt` lowers it and `startScanIf` already scanned the top level.

import { Json, JsonError, parseJson } from "std:json"

type Circle = { r: f64 }
type Err = { msg: string }
type U = Circle[] | string | Err

function pick(b: boolean): U {
  if b { return [{ r: 1.0 }] }
  "s"
}

// `.push` behind a second narrowing.
const a1 = pick(true)
if a1 is Err {
  print("err")
} else {
  if a1 is Circle[] {
    a1.push({ r: 2.0 })
    print(a1.length)
  } else {
    print("not a list")
  }
}

// `.clear` and `.pop` take the same frame, so they are the same gap and the same close.
const a2 = pick(true)
if a2 is Err {
  print("err")
} else {
  if a2 is Circle[] {
    a2.clear()
    print(a2.length)
  } else {
    print("not a list")
  }
}

const a3 = pick(true)
if a3 is Err {
  print("err")
} else {
  if a3 is Circle[] {
    const t = a3.pop()
    if t != null { print(t.r) } else { print("no") }
  } else {
    print("not a list")
  }
}

// Inside a FUNCTION body, not only the start function — the two walks are shared.
function go(v: U) {
  if v is Err {
    print("err")
  } else {
    if v is Circle[] {
      v.push({ r: 2.0 })
      print(v.length)
    } else {
      print("not a list")
    }
  }
}

go(pick(true))

// The arm reached through a `while` body, which walks into the same `if` collector.
const a4 = pick(true)
let n = 0
if a4 is Err {
  print("err")
} else {
  while n < 1 {
    if a4 is Circle[] { a4.push({ r: 2.0 }) } else { print("no") }
    n = n + 1
  }
  if a4 is Circle[] { print(a4.length) } else { print("no") }
}

// `std:json`'s own shape — the row was found grading it.
const a5 = parseJson("[1, 2]")
if a5 is JsonError {
  print("err")
} else {
  if a5 is Json[] {
    a5.push(3.0)
    print(a5.length)
  } else {
    print("not an array")
  }
}

const a6 = parseJson("[1, 2]")
if a6 is JsonError {
  print("err")
} else {
  if a6 is Json[] {
    a6.clear()
    print(a6.length)
  } else {
    print("not an array")
  }
}

// …and through the alias spelling D1822 taught the classifiers to read.
type JsonArr = Json[]

const a7 = parseJson("[1, 2]")
if a7 is JsonError {
  print("err")
} else {
  if a7 is JsonArr {
    a7.push(3.0)
    print(a7.length)
  } else {
    print("not an array")
  }
}

// The depth-1 control, which ran before this close and must keep running.
const a8 = pick(true)
if a8 is Circle[] {
  a8.push({ r: 2.0 })
  print(a8.length)
} else {
  print("not a list")
}
