// @emit-error receiver is not a union value
// A LOUD REJECT WHERE MASTER WROTE A SILENTLY INVALID MODULE (#1310).
//
// `const xs = [pick(true)]` is an UN-ANNOTATED array literal whose element is a union.
// `arrLitIsRef` classifies an array literal by the SYNTAX of its first element (an `ObjLit`,
// a lambda, a nested literal, or a checker-recorded element name carrying `=>`), and a CALL
// is none of those — so the literal falls through to the i32 list and the union box stored
// into it is `expected i32, found (ref $type)`. That defect is master's, is independent of
// this slice, and is filed in `docs/internals/destringify-types-program.md`: the whole family
// (`[pick(c)]`, `[w]` for any union-typed binding, even a plainly DECLARED `type U = A | B`
// value) writes an invalid module on master with no diagnostic at all.
//
// What this file pins is the DIAGNOSTIC. The `is` on such an element is the last gate before
// the bad store, and which way it went used to depend on which SPELLING happened to be
// registered: `monoStaticIsResult`'s exclusion asked the RAW tested string, so an inline-shape
// test that named the inferred union's DUPLICATE structural row was excluded (reject), and one
// that did not was claimed as a monomorphized static guard and CONST-FOLDED TO FALSE — after
// which nothing stopped the invalid module. With the duplicate row gone that exclusion resolves
// the spelling first (`isVariantSpelling`, scoped by `nodeTyIsUnion` — the CHECKER's view of the
// receiver, since the EMITTER's `exprUnion` is exactly what has the gap here), so the test is a
// union test either way and the program is rejected by name.
//
// The nominal spelling (`a is Cat`) already rejected on master, and still does. The two
// spellings agreeing is the point — see `functions/inferred-union-one-row.vl`.
type Cat = { meow: i32 }
type Dog = { woof: i32 }

function pick(c: boolean) {
  if c {
    return { meow: 1 }
  }
  return { woof: 2 }
}

function subject() {
  const xs = [pick(true)]
  const a = xs[0]
  if a is {meow: i32} {
    print(a.meow)
  }
}

subject()
