// @log 2
// @log 3
// @log bc
// @log 2
// @log a
// @log bc
// @log 1
// @log 2
// @log 3
// @log 2.5
// @log 1
// @log true
// @log 1
// @log null
// @log 1
// @log 3
// @log 2
// @log p
// @log 6
// @log 2
// @log 1
// @log 2
// @log 3
// @log 4
// @log 2
// @log s
// @log 5
// @log 1
// @log 1
// @log 2
// @log S
// @log N
// @hint redundant type annotation: `o` is inferred as `{xs: string[] | i32[]}` — remove it to lean on inference
// @hint redundant type annotation: `viaParam` is inferred as `i32` — remove it to lean on inference
// `.length`, `u[i]` and `for v in u` over a union whose every member is a list: the read
// is the element union, kept apart rather than widened, in every position the union reaches.
function mk(b: boolean): string[] | i32[] {
  if b { return ["a", "bc"] }
  [1, 2, 3]
}
const u = mk(true)
print(u.length)
print(mk(false).length)
print(u[1])
print(mk(false)[1])
for v in u { print(v) }
for v in mk(false) { print(v) }
function fi(b: boolean): f64[] | i32[] {
  if b { return [2.5] }
  [1]
}
print(fi(true)[0])
print(fi(false)[0])
function nb(): (boolean | null)[] | i32[] { [true, null] }
for v, i in nb() {
  print(v ?? i)
  if v == null { print(v) }
}
type Box = { xs: string[] | i32[] }
const o: Box = { xs: mk(false) }
print(o.xs[0])
print(o.xs.length)
function viaParam(p: string[] | i32[] | null): i32 {
  if p != null { return p.length }
  -1
}
print(viaParam(u))
function three(k: i32): string[] | f64[] | i32[] {
  if k == 0 { return ["p"] }
  if k == 1 { return [1.5, 2.5, 3.5, 4.5, 5.5, 6.5] }
  [7, 8]
}
print(three(0)[0])
print(three(1).length)
print(three(2).length)
const nested: string[][] | i32[][] = [["x"], ["y", "z"]]
print(nested[0].length)
print(nested[nested.length - 1].length)
const run = () => {
  const f = () => u.length + 1
  print(f())
  0
}
run()
print(u.length + fi(false).length + 1)
function w<T>(t: T, b: boolean) {
  if b { return [t, t] }
  [5]
}
print(w("s", true).length)
print(w("s", true)[0])
print(w("s", false)[0])
let n = 0
for v in w("s", false) {
  n = n + 1
  if n > 1 { break }
}
print(n)
for v in u {
  if v is string {
    print(v.length)
    continue
  }
}
const tag = (x: string | i32) => if x is string { "S" } else { "N" }
print(tag(u[0]))
print(tag(mk(false)[0]))
