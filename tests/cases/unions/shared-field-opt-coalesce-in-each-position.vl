// @run
// @log 3
// @log 9
// @log 8
// @log 3
// @log big
// @log small
// @log 16
// @log 4
// @log 6
// `v.j?.a ?? d` where `j` is a field one member of a record union stores as a record and another
// as `null`, read on the box tag each time: a global, a local, a parameter, in a return, an
// argument, a binding, an `if`, a loop and inside arithmetic.
type J = { a: i32 }
type P = { j: J, k: i32 }
type Q = { j: null, k: i32 }
function mk(b: boolean): P | Q {
  return if b { { j: { a: 3 }, k: 1 } } else { { j: null, k: 2 } }
}
function show(x: i32) { print(x) }
const g = mk(true)
function ret(v: P | Q) { return v.j?.a ?? 9 }
function arg(v: P | Q) { show(v.j?.a ?? 8) }
function bind(v: P | Q) {
  const r = v.j?.a ?? 7
  return r
}
function cond(v: P | Q) {
  if (v.j?.a ?? 0) > 2 { print("big") } else { print("small") }
}
function loop() {
  let t = 0
  for b in [true, false, true] {
    const v = mk(b)
    t = t + (v.j?.a ?? 10)
  }
  return t
}
function glob() { return 1 + (g.j?.a ?? 5) }
print(ret(mk(true)))
print(ret(mk(false)))
arg(mk(false))
print(bind(mk(true)))
cond(mk(true))
cond(mk(false))
print(loop())
print(glob())
const l = mk(false)
print(l.j?.a ?? 6)
