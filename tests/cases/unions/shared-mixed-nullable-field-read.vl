// @log z
// D13361: a field the records of a union store at different nullable reps (`i32 | null` beside
// `string | null`, `i32` or `f64`) reads as the box of their `null`-holding join, and so does
// a `string | null` member, through a read, `??`, `is`, a return, an argument, three members,
// a record field, `== null` and a hole receiver.
type A = { k: i32 | null, x: i32 }
type B = { k: string | null, y: string }
function F(u: A | B) { print(u.k) }
F({ k: 3, x: 1 })
F({ k: null, y: "s" })
F({ k: "z", y: "s" })

type C = { k: i32, x: i32 }
function G(u: C | B) { print(u.k) }
G({ k: 3, x: 1 })
G({ k: null, y: "s" })
G({ k: "z", y: "s" })

type D = { k: f64, y: string }
function H(u: A | D) { print(u.k) }
H({ k: 3, x: 1 })
H({ k: null, x: 1 })
H({ k: 2.5, y: "s" })

function Q(u: A | B) {
  const v = u.k ?? -1
  print(v)
}
Q({ k: 3, x: 1 })
Q({ k: null, y: "s" })
Q({ k: "z", y: "s" })

function N(u: A | B) {
  const k = u.k
  if k is string { print("s:" + k) }
  else if k is i32 { print(k + 1) }
  else { print("n") }
}
N({ k: 3, x: 1 })
N({ k: null, x: 1 })
N({ k: null, y: "s" })
N({ k: "z", y: "s" })

function R(u: A | B) { return u.k }
print(R({ k: 3, x: 1 }))
print(R({ k: null, y: "s" }))
print(R({ k: "z", y: "s" }))

function show(v: i32 | string | null) { print(v) }
function S(u: A | B) { show(u.k) }
S({ k: 3, x: 1 })
S({ k: null, y: "s" })
S({ k: "z", y: "s" })

type E = { k: f64, z: boolean }
function T(u: A | B | E) { print(u.k) }
T({ k: 3, x: 1 })
T({ k: null, y: "s" })
T({ k: "z", y: "s" })
T({ k: 1.5, z: true })

type Hold = { v: i32 | string | null }
function U(u: A | B) {
  const h: Hold = { v: u.k }
  print(h.v)
}
U({ k: 3, x: 1 })
U({ k: null, y: "s" })
U({ k: "z", y: "s" })

function V(u: A | B) { print(u.k == null) }
V({ k: 3, x: 1 })
V({ k: null, y: "s" })
V({ k: "z", y: "s" })

function W(u) { print(u.k) }
const wa: A = { k: 3, x: 1 }
const wb: B = { k: null, y: "s" }
const wc: B = { k: "z", y: "s" }
W(wa)
W(wb)
W(wc)

type I = { k: i32 | null, x: i32 }
type J = { k: string, y: string }
function X(u: I | J) { print(u.k) }
X({ k: 3, x: 1 })
X({ k: "z", y: "s" })
