// @run
// @log false
// @log empty
// @log empty
// @log 1
// @log empty
// @log 1
// Regression (silent-class-inventory D1021).
//
// A RECURSIVE union alias composed into a wider union — the `T | Error` shape every std
// module's fallible API has, with `T` the JSON value tree. Check rc 0, and the return landed
// the raw error struct in a slot typed for the composed box: invalid wasm. Three more
// spellings that NARROW were loud, and they are the same missing rep seen from four angles.
//
// THE ALIAS WAS KEPT AS AN OPAQUE ATOM, AND THE REASON WAS A CYCLE GUARD ANSWERING "".
// `unionAliasMembers` flattens a union-alias member into the outer union — that is why the
// NON-recursive twin, with the same six arm kinds, always ran. For a recursive alias the
// flatten asked `tyToEmitName`, whose cycle guard hit `Json` inside `Json[]`, answered `""`,
// and took the whole render down with it. With no members, the composition never registered
// a member table, `is` could find no arm, and the return had nowhere to box.
//
// `Json` IS A PERFECTLY GOOD NAME FOR ITS OWN SELF-REFERENCE. The emitter already handles
// `Json[]` and `{[string]: Json}` — the value tree runs at 51 of 60 positions — so the fix
// is to render a revisit as the ALIAS NAME instead of "". The name is threaded from the one
// caller that holds it and restored around the render, so every anonymous shape keeps the
// "" answer it needs.
//
// THE NAMED COMPOSITION IS STILL OPEN and is deliberately not in this file: `type JR = Json
// | E` used as a return type remains invalid wasm. It is NOT the cycle guard — naming any
// revisited declared alias, not just the outermost, was built and measured and does not move
// it — so it is a separate residue rather than a missed position of this one.
//
// RECURSION THROUGH EITHER ARM, measured with `null` out of the picture: `type K = f64 |
// K[]` and `type K = f64 | {[string]: K}` composed with a struct both refused at `is E`
// while `type K = f64 | f64[]` ran. The ingredient was self-reference itself, not the list
// arm the first witness happened to use — both are pinned below.
type Json = null | boolean | f64 | string | Json[] | { [string]: Json }
type E = { at: i32, kind: "syntax" | "depth", msg: string }

// 1 — the row's own witness: the fs-shaped `T | Error` return
function p(self: string): Json | E {
  if self.length == 0 { return { at: 0, kind: "syntax", msg: "empty" } }
  return 2.5
}
const r = "".p()
print(r == null)

// 2 — the same composition NARROWED, which was a separate loud refusal
function q(self: string): Json | E {
  if self.length == 0 { return { at: 0, kind: "syntax", msg: "empty" } }
  return 2.5
}
const r2 = "".q()
if r2 is E { print(r2.msg) }

// 4 — recursion through the LIST arm only, no `null` anywhere
type KL = f64 | KL[]
type E2 = { at: i32, msg: string }
function kl(self: string): KL | E2 {
  if self.length == 0 { return { at: 0, msg: "empty" } }
  return 2.5
}
const r4 = "".kl()
if r4 is E2 { print(r4.msg) }
print(1)

// 5 — recursion through the MAP arm only
type KM = f64 | { [string]: KM }
function km(self: string): KM | E2 {
  if self.length == 0 { return { at: 0, msg: "empty" } }
  return 2.5
}
const r5 = "".km()
if r5 is E2 { print(r5.msg) }
print(1)
