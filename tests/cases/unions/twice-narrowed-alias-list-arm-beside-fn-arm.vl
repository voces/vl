// @run
// @log 2
// @log 1
// @log 2

// An index read off a binding narrowed to a list ALIAS, at module scope, from a union that also
// carries a function arm returning a list. That read decides "list, not map" by asking whether
// the narrowed type is a list. A function returning `u8[]` renders with a trailing `[]` and is not
// one. The function arm sits in the outer union, not inside `V`, because a `type`-declared union
// with a function member is D3269.

type V = { [string]: V } | VArr | f64 | null
type VArr = V[]
type E = { err: string }

function mk(): u8[] { [7, 8] }

function pick(n: i32): V | E | (() => u8[]) {
  if n == 0 { return [1.0, 2.0] }
  if n == 1 { return mk }
  { err: "bad" }
}

const a = pick(0)
if a is E {
  print(a.err)
} else {
  if a is VArr {
    print(a.length)
    const v = a[0]
    if v is f64 { print(v) } else { print("not f64") }
  } else {
    print("other")
  }
}

const b = pick(1)
if b is () => u8[] { print(b().length) } else { print("other") }
