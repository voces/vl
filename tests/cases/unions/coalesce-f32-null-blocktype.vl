// @run
// @log 1.5
// @log 0.5
// @log 1.5
// @log 7.5
// @log 3.5
// @log 0.25
// An `f32 | null` value union met by `??`. The residual member is value-atom KIND 5, and
// the coalesce lowers as a value-typed `if` whose BLOCKTYPE must be `0x7d f32` (not the
// i32 default) with the DEFAULT emitted at the f32 rep — the two halves of the same code
// (`valBlockTypeOfKind` / `emitExprAsKind`, destringify D-BLOCKTY).
//
// The corpus pinned the i64 (`types/i64-value-union.vl`) and f64 arms of that ladder and
// NOT the f32 one: with the f32 arm of the blocktype table deleted, every corpus file was
// byte-, message- and run-identical (sabotage S-F32, 1,330 files). This file is that
// missing pin — it fails to instantiate against a build whose f32 arm is wrong
// ("type mismatch: expected f32, found i32" at the `if` result).

function pickF32(a: i32): f32 | null {
  if a > 0 { return 1.5 }
  null
}

function go() {
  // an IDENT `??` over `f32 | null` — the ident arm's blocktype + default rep.
  const x: f32 | null = 1.5
  print(x ?? 0.5)
  const y: f32 | null = null
  print(y ?? 0.5)

  // a CALL `??` — the stashed-box arm.
  print(pickF32(1) ?? 2.5)
  print(pickF32(0) ?? 7.5)

  // a struct FIELD `??` — the code-16 field arm.
  const s: {f: f32 | null} = {f: 3.5}
  print(s.f ?? 0.25)
  const t: {f: f32 | null} = {f: null}
  print(t.f ?? 0.25)
}
go()
