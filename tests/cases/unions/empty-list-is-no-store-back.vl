// @log 1
// @log 2
// @log 9
// D4939: a capture, a record field and a list element cannot be re-boxed when `is` fits an
// empty list of another arm, so their narrowed reads see an empty list of the tested arm.
type Box = { items: i32[] | string[] }
function cap(a: f64[] | string[]) {
  const f = () => if a is string[] { a.length } else { 9 }
  print(f())
}
function probe(v: i32[] | string[]) {
  const b: Box = { items: v }
  if b.items is string[] { print(b.items.length) } else { print(-1) }
  const arr = [v]
  if arr[0] is string[] {
    let n = 0
    for it in arr[0] { n = n + 1 }
    print(n)
  } else {
    print(-1)
  }
  const o = { box: { items: v } }
  if o.box.items is string[] {
    if o.box.items.length > 0 { print(o.box.items[0].length) } else { print(0) }
  } else {
    print(-1)
  }
}
const ef: f64[] = []
const ei: i32[] = []
cap(ef)
probe(ei)
const g: (i32[] | string[])[] = [ei]
const h = (): i32 => if g[0] is string[] { g[0].length } else { -1 }
print(h())
probe(["ab"])
const one = [1.5]
cap(one)
