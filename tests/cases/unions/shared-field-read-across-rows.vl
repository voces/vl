// @run
// @log 7
// @log 0
// @log true
// @log null
// @log true
// @log null
// @log true
// @log false
// A field read over a union whose members store that field differently reads it as the type
// the read is checked at: two records stored at different rows ride the box of their union,
// and `boolean` beside `null` reads as the `boolean | null` niche.

type Cir2 = { c2: i32 }
type Sq2 = { s2: i32 }
type Shape2 = Cir2 | Sq2

function viaMap(hit: boolean) {
  const c = Map()
  if hit { c["k0"] = { r: { c2: 1 } } }
  const g = c["k0"] ?? { r: { s2: 1 } }
  if g.r is Cir2 { print(7) } else { print(0) }
}
viaMap(true)
viaMap(false)

function src(b: boolean): {r: boolean} | null {
  if b { return { r: true } }
  null
}
function nulField(b: boolean) {
  const g = src(b) ?? { r: null }
  print(g.r)
}
nulField(true)
nulField(false)

function atParam(g: {r: boolean} | {r: null}) { print(g.r) }
atParam({ r: true })
atParam({ r: null })

type W = { c: Cir2 }
type V = { c: Sq2 }
function viaUnion(w: W | V) { print(w.c is Cir2) }
viaUnion({ c: { c2: 3 } })
viaUnion({ c: { s2: 3 } })
