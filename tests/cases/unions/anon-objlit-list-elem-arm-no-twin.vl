// Regression (silent-class-inventory D38), and the NO-TWIN half of
// `anon-objlit-list-elem-beside-arm.vl` beside it. A twin is a whole-program property, so the
// two twin states need two files; this one declares NO standalone struct of `Circle`'s layout
// at all, which is what makes D38's "no twin needed" a shown fact rather than an assertion.
//
// D38 verbatim is twelve lines and reaches `std:array`'s own surface: `mapIndexed`'s minted
// `U[]` supplies the struct row the anonymous `{ r: n }` resolves onto, so nothing else has to
// be declared. On master `f2064bec` the array literal keyed the row `Shape$m0` and built a
// kind-2 BOX list while `U` bound to `Circle[]` — `vl check` rc 0, and
// `mapIndexed$m1` refused at load with "type mismatch: expected (ref $type), found
// (ref $type)".
//
// THE SECOND CELL IS THE TWIN THAT IS ITSELF AN ARM. `Ring` has `Circle`'s exact layout and is
// an arm of a DIFFERENT union, so it has no `sNames` row either — the element resolves onto a
// variant row rather than a struct one, and the read follows. That cell was a LOUD emit
// refusal on master (`emitProgram: field access but no struct type declared`), not a silent
// one, which is why the grid's `armtwin` column moved from `loudemit` rather than from
// `silentinvalid`. Pinned running so the twin axis is covered at both ends.
// @run
// @log 7
// @log 7
// @log 7
// @hint Intentionally-unused parameter `_i`
import { mapIndexed } from "std:array"

type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq

// An exact-layout twin that is an ARM of a second union, never a standalone struct.
type Ring = { r: i32 }
type Blob = { z: i32 }
type Other = Ring | Blob

function mk(n: i32, _i: i32) {
  const o = [{ r: n }]
  return o
}

function d38() {
  const out = mapIndexed([7], mk)
  return out[0][0].r
}

function armTwinOnly() {
  const o = [{ r: 7 }]
  return o[0].r
}

print(d38())
print(armTwinOnly())
print(mk(7, 0)[0].r)
