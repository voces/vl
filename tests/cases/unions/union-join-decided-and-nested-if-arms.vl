// @run
// @warning This branch is never taken: a preceding condition is always `true`
// @log 5000000000
// @log 0
// @log 2
// @log 5000000000
// @log s
// @log 1
// @log 2
// @log t
// @log 3
// @log 4
// @log 0
// @log 1
// @log t
// A union join whose condition is a literal `true`, written by the rewrite (a coalesce over an
// instance that is never null) or by hand, keeps its live arm and never runs its else. An arm
// whose value is another `if` joins into the same union box.
type W = 1 | 2 | 5000000000
const wa: W = 5000000000
const wb: W = 2
function orZero(f) { print(f() ?? 0) }
orZero(() => wa)
const wz: W | null = null
orZero(() => wz)
orZero(() => wb)
function orZeroR(f) { return f() ?? 0 }
print(orZeroR(() => wa))
function flip(a: boolean, b: boolean): i32 | string {
  return if a { if b { 1 } else { "s" } } else { 2 }
}
print(flip(true, false))
print(flip(true, true))
print(flip(false, true))
function pick(n: i32) { return n > 1 }
const w = if !pick(0) { if pick(0) { 1 } else { "t" } } else { 2 }
print(w)
type H = { v: i32 | string }
const h: H = { v: if pick(2) { if pick(3) { 3 } else { "u" } } else { 4 } }
print(h.v)
let calls = 0
function bump() {
  calls = calls + 1
  return calls
}
const d = if true { 4 } else { print("dead"); bump(); "s" }
print(d)
print(calls)
const wd = if pick(2) { if pick(3) { 1 } else { 2.5 } } else { "s" }
print(wd)
const wn = if pick(2) { if pick(0) { 1 } else { "t" } } else { false }
print(wn)
