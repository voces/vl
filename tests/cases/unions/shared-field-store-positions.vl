// @run
// @log 11
// @log 22
// @log 7
// @log 0
// @log 9
// @log 4
// @log a
// @log a
// @log true
// A field write through an un-narrowed union of records stores at each member's own field: one
// value for every member, or a literal written at each member's own atoms, through a parameter,
// a module binding, a local, an element and a field, in a start body and in functions.
type A = { kind: string, w: i32, n: i32[] }
type B = { kind: string, extra: f64, w: i32, n: i32[] }
type M = { k: "a" | "b", v: i32 } | { k: "a" | "end", w: boolean }
type H = { u: A | B }
function bump(p: A | B, d: i32) { p.w = p.w + d }
function reset(p: A | B) {
  const q = p
  q.w = 0
}
function tag(n: M) { n.k = "a" }
const a: A = { kind: "a", w: 1, n: [] }
const b: B = { kind: "b", extra: 1.5, w: 2, n: [] }
bump(a, 10)
bump(b, 20)
print(a.w)
print(b.w)
const g: A | B = b
g.w = 7
print(b.w)
reset(a)
print(a.w)
const ps: (A | B)[] = [g, g]
ps[1].w = 9
print(b.w)
const h: H = { u: a }
h.u.w = 4
print(a.w)
const x: M = { k: "end", w: true }
const y: M = { k: "b", v: 1 }
tag(x)
tag(y)
print(x.k)
print(y.k)
const ms: M[] = [x, y]
ms[0].k = "a"
print(ms[0].k == "a")
