// @run
// @log 70
// @log 2
// @log 40
// @log yy
// @log null
// A narrowed read is decided by the type the binding it reads is stored at (D14537): an inner
// binding of the same name is its own storage, whether it repeats the outer narrowed type or
// re-declares the full union, and a null peel under a union arm keeps the arm's own rep.
type A = { k: "a", x: i32 }
type B = { k: "b", y: string }
function f(n: A | B, m: A | B): i32 {
  if n is A {
    if m is A {
      const n = m
      return n.x * 10
    }
    return n.x
  }
  return -1
}
print(f({ k: "a", x: 1 }, { k: "a", x: 7 }))
print(f({ k: "a", x: 2 }, { k: "b", y: "q" }))
function g(n: A | B): i32 {
  if n is A {
    {
      let n: A | B = { k: "a", x: 40 }
      if n is A { return n.x }
    }
  }
  return 0
}
print(g({ k: "a", x: 1 }))
function h(n: A | B | null): string {
  if n != null {
    if n is B { return n.y }
    return "a"
  }
  return "null"
}
print(h({ k: "b", y: "yy" }))
print(h(null))
