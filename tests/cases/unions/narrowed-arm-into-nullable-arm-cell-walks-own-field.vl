// @run
// @log 7
// @log 6
// @log 0
// An arm narrowed out of a union is bound into a cell of that arm or `null`, then walked through
// the arm's own nullable field to its end; the other arm reads its own field.
type O = { n: i32, next: O | null }
type P = { m: i32 }
type U = O | P
function total(u: U) {
  if u is O {
    let t = 0
    let c: O | null = u
    while c != null {
      t = t + c.n
      c = c.next
    }
    return t
  }
  return u.m
}
print(total({ n: 3, next: { n: 4, next: null } }))
print(total({ m: 6 }))
print(total({ m: 0 }))
