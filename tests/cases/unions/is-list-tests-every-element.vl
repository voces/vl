// @run
// @log 3
// @log -1
// @log 0
// @log true
// @log false
// @log false
// @log true
// @log true
// @log false
// `is` over a list tests every element (the owner's ruling (a) on D4771, extending D3885):
// `xs is K[]` is true when each element fits `K`, at every nesting depth, and an empty list
// fits. The then-branch sees the narrowed list.
type K = 0 | 1
type S = "a" | "b"
function f(b: i32[] | K[]) {
  if b is K[] {
    const k: K[] = b
    return k.length
  }
  -1
}
print(f([0, 1, 1]))
print(f([0, 2]))
print(f([]))
function g(v: string[]) { v is S[] }
print(g(["a", "b"]))
print(g(["a", "c"]))
function h(m: i32[][]) { !(m is K[][]) }
print(h([[0], [1, 0]]))
print(h([[0], [3]]))
function both(x: i32[], y: i32[]) { x is K[] && y is K[] }
print(both([1], [0]))
print(both([1], [5]))
