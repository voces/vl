// @log true
// `==` / `!=` against a string literal over a union whose literal arm is a declared alias
// beside a record arm (D4340): it compares the member the box holds, from either side.
type E = { code: i32 }
type K = "a" | "b"
function mk(n: i32): K | E {
  if n == 0 { return "a" }
  return { code: n }
}
const v: K | E = "a"
print(v == "a")
print(v == "b")
print(v != "a")
print("a" == v)
print(mk(0) == "a")
print(mk(7) != "b")
const r: K | E = { code: 3 }
print(r == "a")
const n: K | E | null = null
print(n == "a")
const m: K | E | null = "b"
print(m == "b")
