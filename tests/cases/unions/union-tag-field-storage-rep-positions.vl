// A field read whose rep follows the atom-or-string storage legacy gives it, in each position:
// a lone literal tag every arm of an un-narrowed union stores as an atom, and an alias field
// stored as a string beside its base's arm.
// @run
// @hint `A` is contained in `B`, so `is A` tests the value
// @log circle
// @log true
// @log circle
// @log circle!
// @log circle
// @log circle
// @log circle
// @log circle
// @log round
// @log true
// @log round
// @log round!
// @log round
// @log round
// @log round
// @log zz
type KC = "circle"
type Cs = { kind: KC, r: f64 }
type Rs = { kind: KC, w: f64 }
function show(k: KC) { print(k) }
function back(s: Cs | Rs): KC { return s.kind }
function tagS(s: Cs | Rs, n: i32) {
  print(s.kind)
  print(s.kind == "circle")
  const k = s.kind
  print(k)
  print(s.kind + "!")
  show(s.kind)
  print(back(s))
  const j = if n == 0 { s.kind } else { s.kind }
  print(j)
}
tagS({ kind: "circle", r: 1.0 }, 0)
function tagW(s: Cs | Rs) { print(s.kind) }
tagW({ kind: "circle", w: 2.0 })

type K1 = "circle" | "round"
type A = { kind: K1, r: f64 }
type B = { kind: string, r: f64 }
function f(n: i32): A | B {
  if n == 0 { return { kind: "round", r: 1.0 } }
  const v: B = { kind: "zz", r: 2.0 }
  return v
}
function one(k: K1) { print(k) }
function mixed(x: A | B) {
  if x is A {
    print(x.kind)
    print(x.kind == "round")
    const k = x.kind
    print(k)
    print(x.kind + "!")
    one(x.kind)
    const j = if x.r == 0.0 { x.kind } else { x.kind }
    print(j)
    print("\{x.kind}")
  } else {
    print(x.kind)
  }
}
mixed(f(0))
mixed(f(1))
