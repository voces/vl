// @run
// @log true
// @log 4
// @log 4
// A write that re-narrows a nullable value union with no row of its own (an un-annotated `let`
// bound out of a narrowed box) takes `null` out of the binding's type, so a closure reading it
// returns the box the print can classify (D3151), whether the read is printed or handed on.
function printed(v: i32 | null | string) {
  if !(v is string) {
    let c = v
    c = null
    print(c == null)
    c = 4
    const f = () => c
    print(f())
  }
}
function handedOn(v: i32 | null | string) {
  if v is string { return 0 }
  let c = v
  c = 4
  const f = () => c
  print(f() + 0)
  0
}
printed(7)
handedOn(7)
