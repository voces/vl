// @run
// @log 7
// @log 0
// @log 2
// @log r
// @log n
// @log a
// @log 1
// A field `??` reads its receiver again on the present path: a nullable local narrowed past its
// null, and a loop variable narrowed to an anonymous arm. A generic instance whose pin decides the
// `??`'s null test writes that test as a constant with both arms.
type C = { r: i32 | null }
function sink(x: {[string]: C}, k: string) {
  const v = x[k]
  if v != null { print(v.r ?? 0) }
}
const m: {[string]: C} = Map()
m["a"] = { r: 7 }
m["b"] = { r: null }
sink(m, "a")
sink(m, "b")
type U = { q: i32 | null } | { r: i32 }
const xs: U[] = [{ q: 2 }, { r: 1 }]
for x in xs {
  if x is { q: i32 | null } { print(x.q ?? 0) } else { print("r") }
}
type M = "a" | 1
function pick<T>(x: T) {
  let s: M | null = null
  s = x
  print(s ?? "n")
}
const mn: M | null = null
const ma: M = "a"
const m1: M = 1
pick(mn)
pick(ma)
pick(m1)
