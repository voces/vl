// The statements after a guard whose failing arm exits read a deep `is` receiver narrowed,
// through a converted copy bound after the guard, as they read a shallow one (D16477).
type Json = null | boolean | f64 | string | Json[] | { [string]: Json }

function ret(g: Json) {
  if !(g is string[]) { return 0 }
  g.length
}

function retAfter(g: Json) {
  if !(g is string[]) {
    print("not")
    return 0
  }
  g.length
}

function orTest(g: Json) {
  if !(g is string[]) || g.length == 0 { return 0 }
  g.length
}

function elseExits(g: Json) {
  if g is string[] { print("ok") } else { return 0 }
  g.length
}

function loopContinue(g: Json) {
  let t = 0
  for i in 0 until 2 {
    if !(g is string[]) { continue }
    t = t + g.length
  }
  t
}

function loopBreak(g: Json) {
  let t = 0
  while true {
    if !(g is string[]) { break }
    t = g.length
    break
  }
  t
}

function notAnd(g: Json) {
  if !(g is string[] && g.length > 1) { return 0 }
  g.length
}

function inLambda(g: Json) {
  const f = () => {
    if !(g is string[]) { return 0 }
    g.length
  }
  f()
}

function elseIf(g: Json, c: boolean) {
  if c { print("c") }
  else if !(g is string[]) { return 0 }
  if g == null { 1 } else { 2 }
}

function writesAfter(g: Json) {
  if !(g is string[]) { return 0 }
  const n = g.length
  g = null
  print(g == null)
  n
}

function shadowAfter(g: Json) {
  if !(g is string[]) { return 0 }
  {
    const g = 1
    print(g)
  }
  g.length
}

print(ret(["a", "b"]))
print(ret(null))
print(retAfter(null))
print(retAfter(["a", "b"]))
print(orTest(["a", "b"]))
print(elseExits(["a", "b"]))
print(loopContinue(["a", "b"]))
print(loopBreak(["a", "b"]))
print(notAnd(["a", "b"]))
print(inLambda(["a", "b"]))
print(elseIf(["a"], true))
print(writesAfter(["a", "b"]))
print(shadowAfter(["a", "b"]))
