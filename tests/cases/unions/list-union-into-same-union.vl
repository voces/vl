// @run
// @log 1.5
// @log 3
// @log 8
// @hint redundant type annotation: `x` is inferred as `f64[] | i32[]` — remove it to lean on inference
// @hint redundant type annotation: `o` is inferred as `{xs: f64[] | i32[]}` — remove it to lean on inference
// @hint redundant type annotation: `s` is inferred as `{r: i32, s: i32}[]` — remove it to lean on inference
// @hint redundant type annotation: `c` is inferred as `Sq[] | Circ[]` — remove it to lean on inference
// A union of lists delivered into a destination of the same union keeps each member at its
// own member, so `i32[]` is not refused for meeting `f64[]` first (D2877).
type Sq = { r: i32, s: i32 }
type Circ = { r: i32 }
function mk(b: boolean): f64[] | i32[] {
  if b { return [1.5] }
  [1, 2]
}
function pass(u: f64[] | i32[]): f64[] | i32[] { u }
type Box = { xs: f64[] | i32[] }
const x: f64[] | i32[] = mk(true)
if x is f64[] { print(x[0]) }
const o: Box = { xs: pass(mk(false)) }
const y = o.xs
if y is i32[] { print(y[1] + 1) }
function mc(): Sq[] | Circ[] {
  const s: Sq[] = [{ r: 7, s: 8 }]
  s
}
const c: Sq[] | Circ[] = mc()
if c is Sq[] { print(c[0].s) }
