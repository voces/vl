// @run
// @log D
// @log C
// A module global of a union of records, reassigned to one arm's literal, is read at that arm by
// the next call.
type C = { v: "a" | "b" | null }
type D = { v: string }
function g(u: C | D) {
  if u is C { return "C" }
  return "D"
}
let w: C | D = { v: "q" }
print(g(w))
w = { v: "b" }
print(g(w))
