// @run
// @log 10
// @log 1
// D14540: twin arms over a string tag with the same field type; a read after the tag test.
type P = { k: "a", n: i32 } | { k: "b", n: i32 }
function mk(b: boolean): P {
  if b { return { k: "b", n: 9 } }
  { k: "a", n: 1 }
}
const p = mk(true)
if p.k == "a" { print(p.n) } else { print(p.n + 1) }
const r = mk(false)
if r.k == "a" { print(r.n) } else { print(r.n + 1) }
