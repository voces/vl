// @run
// D1095 — `==` OVER A UNION ARM WHOSE ATOM IS A LIST.
//
// A list member of a value union is a REF atom: the box's `value` field holds the list
// WRAPPER ref directly, with no scalar value box. Every union-`==` lowering nevertheless
// unboxed a payload by asking `vbHeapIdxOfKind`, which answers -1 for a list code, so
// `i32 | i32[]` compared against another `i32 | i32[]` refused with `union `==` atom has no
// value box`, and a struct union carrying a list arm declined the whole arm loop and took
// `==` over a struct union is not supported yet. Both are `vl check` rc 0.
//
// The unbox is `emitUnionUnboxTail`'s ladder — `listWrapHeapOfKind` then a `ref.cast` — and
// the compare is the ordinary list core over the two wrappers, reached through the same
// `emitListEqAnyRep` entry a direct `xs == ys` takes. The frame that core writes into is
// reserved by the scan for EVERY list arm of the union, because which arm's core runs is a
// runtime tag test.
//
// EVERY LIST REP THE BOX CAN CARRY IS CONSTRUCTED AND DISCRIMINATED — equal, one element
// different, and (for the i32 rep) a different LENGTH — and each is also asked with the box
// holding the OTHER arm, so a lowering that answered a constant would fail here.

// ── i32[]: the rep whose core is the hand-written `emitListEqICore` ──────────
function mkI(n: i32): i32 | i32[] {
  if n == 0 { return 5 }
  if n == 1 { return [1, 2] }
  [1, 3]
}

const pi = mkI(1)
const iSame = [1, 2]
const iDiff = [1, 3]
const iShort = [1]
// @log true
print(pi == iSame)
// @log false
print(pi == iDiff)
// @log false
print(pi == iShort)
// @log true
print(pi != iDiff)
// the box holds the SCALAR arm — a tag miss, so false rather than a bad unbox
// @log false
print(mkI(0) == iSame)
// reversed operand order
// @log true
print(iSame == pi)

// union vs union over the same set, both arms exercised
const q1 = mkI(1)
const q2 = mkI(2)
const q0 = mkI(0)
// @log true
print(pi == q1)
// @log false
print(pi == q2)
// @log false
print(pi == q0)
// @log true
print(q0 == q0)

// ── f64[] ────────────────────────────────────────────────────────────────────
function mkF(n: i32): i32 | f64[] {
  if n == 0 { return 5 }
  [1.5, 2.5]
}
const pf = mkF(1)
const fSame = [1.5, 2.5]
const fDiff = [1.5, 2.75]
// @log true
print(pf == fSame)
// @log false
print(pf == fDiff)
// @log false
print(mkF(0) == fSame)

// ── string[] — each element pair rides the shared string helper ──────────────
function mkS(n: i32): i32 | string[] {
  if n == 0 { return 5 }
  ["a", "b"]
}
const ps = mkS(1)
const sSame = ["a", "b"]
const sDiff = ["a", "c"]
// @log true
print(ps == sSame)
// @log false
print(ps == sDiff)
// @log false
print(mkS(0) == sSame)

// ── i64[] ────────────────────────────────────────────────────────────────────
const one: i64 = 1
const two: i64 = 2
const three: i64 = 3
function mkL(n: i32): i32 | i64[] {
  if n == 0 { return 5 }
  [one, two]
}
const pl = mkL(1)
const lSame = [one, two]
const lDiff = [one, three]
// @log true
print(pl == lSame)
// @log false
print(pl == lDiff)

// ── f32[] — its own wrapper, distinct from the f64 list's ────────────────────
const g1: f32 = 1.5
const g2: f32 = 2.5
const g3: f32 = 3.5
function mkG(n: i32): i32 | f32[] {
  if n == 0 { return 5 }
  [g1, g2]
}
const pg = mkG(1)
const gSame = [g1, g2]
const gDiff = [g1, g3]
// @log true
print(pg == gSame)
// @log false
print(pg == gDiff)

// ── boolean[] — shares the i32 list's backing and therefore its atom code ────
function mkB(n: i32): i32 | boolean[] {
  if n == 0 { return 5 }
  [true, false]
}
const pb = mkB(1)
const bSame = [true, false]
const bDiff = [true, true]
// @log true
print(pb == bSame)
// @log false
print(pb == bDiff)

// ── u8[] — the PACKED byte list, its own wrapper over an `(array (mut i8))` ──
function mkU(n: i32): i32 | u8[] {
  if n == 0 { return 5 }
  const bs = "ab".bytes()
  bs
}
const pu = mkU(1)
const uSame = "ab".bytes()
const uDiff = "ac".bytes()
// @log true
print(pu == uSame)
// @log false
print(pu == uDiff)

// ── A LIST ARM BESIDE A STRUCT ARM: the arm loop had to admit it, and the two
// arms compare by different cores under one tag dispatch.
type A = { x: i32 }
function mkAL(n: i32): A | i32[] {
  if n == 0 { return [1, 2] }
  if n == 1 { return [1, 3] }
  { x: n }
}
const al0 = mkAL(0)
const al1 = mkAL(1)
const al2 = mkAL(2)
const al3 = mkAL(3)
const al0b = mkAL(0)
const al2b = mkAL(2)
const alList = [1, 2]
const alA = { x: 2 }
// @log true
print(al0 == alList)
// @log false
print(al1 == alList)
// @log true
print(al2 == alA)
// @log false
print(al3 == alA)
// union vs union across the two arms
// @log true
print(al0 == al0b)
// @log false
print(al0 == al1)
// @log false
print(al0 == al2)
// @log true
print(al2 == al2b)

// ── TWO LIST ARMS IN ONE UNION: the tag, not the operand's spelling, picks the
// core, so a box holding the string list must answer false against an i32 list.
function mkTwo(n: i32): i32[] | string[] {
  if n == 0 { return [1, 2] }
  ["a", "b"]
}
const t0 = mkTwo(0)
const t1 = mkTwo(1)
const t0b = mkTwo(0)
const tI = [1, 2]
const tS = ["a", "b"]
// @log true
print(t0 == tI)
// @log true
print(t1 == tS)
// @log false
print(t0 == tS)
// @log false
print(t1 == tI)
// @log true
print(t0 == t0b)
// @log false
print(t0 == t1)

// ── the compare INSIDE a function, beside an ordinary list compare: each level
// needs its own frame, and the union arm's is reserved by the same scan.
function bothKinds() {
  const p = mkI(1)
  const a = [1, 2]
  const b = [1, 2]
  const nested = [[1, 2]]
  const nested2 = [[1, 2]]
  return (a == b) && (p == a) && (nested == nested2)
}
// @log true
print(bothKinds())
