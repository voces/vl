// @log -2
// @log -2
// @log -2
// @log -2
// @log -2
// A union box narrowed to `M | null`, the niche delivered at each position: a nullable and a
// union parameter, a nested call, a concatenation, an interpolation hole, a return, a binding,
// an `if` arm, a `??` operand and a record field; each called with a value, `null` and the other member.
import { toString } from "std:fmt"

type M = {[string]: i32}
type U = M | null | i32
type Got = { g: M | null }
function n(a: M | null) { return if a == null { 0 - 1 } else { a.length } }
function su(w: M | null | boolean) {
  if w is boolean { return 0 - 3 }
  return n(w)
}
function inc(x: i32) { return x + 1 }
function pArg(u: U) {
  if u is i32 { return 0 - 2 }
  return n(u)
}
function pUnion(u: U) {
  if u is i32 { return 0 - 2 }
  return su(u)
}
function pNested(u: U) {
  if u is i32 { return 0 - 2 }
  return inc(n(u))
}
function pConcat(u: U) {
  if u is i32 { return "o" }
  return "v" + toString(n(u))
}
function pHole(u: U) {
  if u is i32 { return "o" }
  return "w\{n(u)}"
}
function pReturn(u: U): M | null {
  if u is i32 { return null }
  return u
}
function pLet(u: U) {
  if u is i32 { return 0 - 2 }
  const a = u
  return n(a)
}
function pIf(u: U, k: boolean) {
  if u is i32 { return 0 - 2 }
  const a = if k { u } else { null }
  return n(a)
}
function pCoal(u: U, d: M) {
  if u is i32 { return 0 - 2 }
  return n(u ?? d)
}
function pRec(u: U) {
  if u is i32 { return 0 - 2 }
  const r: Got = { g: u }
  return n(r.g)
}
const mm: M = Map()
mm["a"] = 1
mm["b"] = 2
print(pArg(mm))
print(pUnion(mm))
print(pNested(mm))
print(pConcat(mm))
print(pHole(mm))
print(n(pReturn(mm)))
print(pLet(mm))
print(pIf(mm, true))
print(pIf(mm, false))
print(pCoal(mm, mm))
print(pRec(mm))
print(pArg(null))
print(pUnion(null))
print(pNested(null))
print(pConcat(null))
print(pHole(null))
print(n(pReturn(null)))
print(pLet(null))
print(pIf(null, true))
print(pIf(null, false))
print(pCoal(null, mm))
print(pRec(null))
print(pArg(7))
print(pUnion(7))
print(pNested(7))
print(pConcat(7))
print(pHole(7))
print(n(pReturn(7)))
print(pLet(7))
print(pIf(7, true))
print(pIf(7, false))
print(pCoal(7, mm))
print(pRec(7))
