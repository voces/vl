// @run
// @log 2
// @log 12
// @log 1
// @log 9
// @log 306
// A union global narrowed by `is` and read in a loop whose header hoists its receiver (a string's
// length and bytes, a list's elements, a map's keys) is read again from the global at each hoisted
// read: each line prints the sum or count the loop takes. Q58 positions: a `while` condition, an
// index read in the body, a `for` over the receiver's length, a nested `if`, at top level and in a
// function over the same globals.
type Bad = { code: i32 }
function pick(k: i32): string | Bad {
  if k > 0 { return "abca" }
  return { code: k }
}
function pickList(k: i32): i32[] | string {
  if k > 0 { return [3, 4, 5] }
  return "none"
}
const s = pick(1)
const l = pickList(1)
if s is string {
  let i = 0
  let n = 0
  while i < s.length {
    if s[i] == 97 { n = n + 1 }
    i = i + 1
  }
  print(n)
}
if l is i32[] {
  let i = 0
  let t = 0
  while i < l.length {
    t = t + l[i]
    i = i + 1
  }
  print(t)
}
if s is string {
  let n = 0
  for i in 0 to s.length - 1 {
    if s[i] == 98 { n = n + 1 }
  }
  print(n)
}
if l is i32[] {
  let t = 0
  if t == 0 {
    let i = 0
    while i < l.length {
      if l[i] > 3 { t = t + l[i] }
      i = i + 1
    }
  }
  print(t)
}
function inFn() {
  let n = 0
  if s is string && l is i32[] {
    let i = 0
    while i < s.length && i < l.length {
      n = n + s[i] + l[i]
      i = i + 1
    }
  }
  return n
}
print(inFn())
