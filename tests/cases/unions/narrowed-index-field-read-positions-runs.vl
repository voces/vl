// @run
// @log 5
// @log 5
// @log 6
// @log v5
// @log h5
// @log 5
// @log 5
// @log 5
// @log 5
// @log 5
// @log 3
// @log 0
// A field read off an element narrowed through its index place, delivered to each position, a map
// index place, and the narrowing's other arm.
type A = { r: i32 }
type M = i32 | A
type R = { v: i32 }
function sink(n: i32) { print(n) }
function sinkU(u: i32 | string) { print(u) }
function add(a: i32, b: i32) { return a + b }
function id(n: i32) { return n }
function pick(n: i32 | null) { return n }
function argScalar(xs: M[]) {
  if xs[0] is A { sink(xs[0].r) }
}
function argUnion(xs: M[]) {
  if xs[0] is A { sinkU(xs[0].r) }
}
function argNested(xs: M[]) {
  if xs[0] is A { print(add(1, id(xs[0].r))) }
}
function concat(xs: M[]) {
  if xs[0] is A { print("v" + "\{xs[0].r}") }
}
function hole(xs: M[]) {
  if xs[0] is A { print("h\{xs[0].r}") }
}
function ret(xs: M[]) {
  if xs[0] is A { return xs[0].r }
  return 0
}
function letInit(xs: M[]) {
  if xs[0] is A {
    const v = xs[0].r
    print(v)
  }
}
function ifArm(xs: M[], c: boolean) {
  if xs[0] is A {
    const y = if c { xs[0].r } else { 0 }
    print(y)
  }
}
function coalesce(xs: M[]) {
  if xs[0] is A { print(pick(null) ?? xs[0].r) }
}
function field(xs: M[]) {
  if xs[0] is A {
    const r: R = { v: xs[0].r }
    print(r.v)
  }
}
function mapPlace(m: { [string]: M }) {
  if m["k"] is A { print(m["k"].r) }
}
function otherArm(xs: M[]) {
  if xs[0] is A { print(xs[0].r) } else { print(0) }
}
const xs: M[] = [{ r: 5 }]
argScalar(xs)
argUnion(xs)
argNested(xs)
concat(xs)
hole(xs)
print(ret(xs))
letInit(xs)
ifArm(xs, true)
coalesce(xs)
field(xs)
const m: { [string]: M } = Map()
m["k"] = { r: 3 }
mapPlace(m)
otherArm([7])
