// @run
// @log A
// @log C
// @log E
// @log notC
// @log isC
// @log P
// @log Q
// @log C
// @log A
// Record arms that store alike and differ only in a literal set one record deeper are told
// apart by the value's own row and its nested field, in both directions and over three arms
// (D16939); a binding of one arm boxes under that arm, not the first row of its shape.
type A = { v: { x: 1 | 2 } }
type C = { v: { x: 3 | 4 } }
type E = { v: { x: 5 } }
function f(u: A | C | E) {
  if u is A { print("A") }
  else if u is C { print("C") }
  else { print("E") }
}
function g(u: A | C) {
  if u is C { print("isC") } else { print("notC") }
}
const a: A = { v: { x: 2 } }
const c: C = { v: { x: 4 } }
const e: E = { v: { x: 5 } }
f(a)
f(c)
f(e)
g(a)
g(c)
type P = { v: { x: "a", y: i32 } }
type Q = { v: { x: "b", y: i32 } }
function h(u: P | Q) {
  if u is Q { print("Q") } else { print("P") }
}
const p: P = { v: { x: "a", y: 1 } }
const q: Q = { v: { x: "b", y: 2 } }
h(p)
h(q)
function k(u: A | C) {
  if u is A { print("A") } else { print("C") }
}
const c2: C = { v: { x: 3 } }
k(c2)
k({ v: { x: 1 } })
