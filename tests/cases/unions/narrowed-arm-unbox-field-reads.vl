// @run
// @hint redundant type annotation: `p` is inferred as `P` — remove it to lean on inference
// @hint redundant type annotation: `p` is inferred as `P | null` — remove it to lean on inference
// @log a
// @log 1
// @log none
// @log 0
// @log b
// @log 20
// @log null
// @log null
// @log c
// @log 3
// @log d
// @log 40
// @log null
// @log 6
// @log f
// @log -
// @log g!
// @log ~
// A union box narrowed to a record or nullable record arm is unboxed at a record destination:
// a return, an argument and a binding each read the record's fields afterwards.
type P = { x: i32, y: string }
function retArm(e: P | string): P {
  if e is string { return { x: 0, y: "none" } }
  return e
}
function retNul(e: P | null | i32): P | null {
  if e is i32 { return null }
  return e
}
function show(p: P) {
  print(p.y)
  print(p.x)
}
function showNul(p: P | null) {
  if p == null {
    print("null")
  } else {
    print(p.y)
    print(p.x * 10)
  }
}
function argArm(e: P | string) {
  if !(e is string) { show(e) }
}
function argNul(e: P | null | i32) {
  if !(e is i32) { showNul(e) }
}
function bindArm(e: P | string) {
  if !(e is string) {
    const p: P = e
    print(p.x + 1)
  }
}
function bindNul(e: P | null | i32) {
  if !(e is i32) {
    const p: P | null = e
    print(if p == null { "-" } else { p.y })
  }
}
function bindBare(e: P | null | i32) {
  if !(e is i32) {
    const p = e
    print(if p == null { "~" } else { p.y + "!" })
  }
}
show(retArm({ x: 1, y: "a" }))
show(retArm("s"))
showNul(retNul({ x: 2, y: "b" }))
showNul(retNul(null))
showNul(retNul(5))
argArm({ x: 3, y: "c" })
argNul({ x: 4, y: "d" })
argNul(null)
bindArm({ x: 5, y: "e" })
bindNul({ x: 6, y: "f" })
bindNul(null)
bindBare({ x: 7, y: "g" })
bindBare(null)
