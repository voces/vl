// @run
// The annotated face of `arm-cell-value-join.vl`: an arm-typed local declared with the arm's
// own spelling takes a value `if` of arm literals the same way (D4639).
type U = { q: i32 } | { r: i32 }
function reassign(c: boolean) {
  let v: { q: i32 } = { q: 4 }
  v = if c { { q: 5 } } else { { q: 6 } }
  const u: U = v
  print(u is { q: i32 })
  print(v.q)
}
reassign(false)
// @log true
// @log 6
