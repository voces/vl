// @run
// @log 1
// @log s
// @log 1
// @log 7
// D970/D964 — AN INFERRED VALUE-UNION RETURN whose PARAM is also un-annotated.
//
// The monomorphizer minted the instance's return annotation from `fnRetExprOf` — the return
// EXPRESSION, singular — so this function was pinned to `string` (the tail) while its
// FUNCTYPE, computed independently, said the union box. The returns then went out UNBOXED
// under a box result. Alone that was a loud refusal (no i32 box existed); add any other value
// union to the module and the same program became `vl check` rc 0 and INVALID WASM, which is
// the `by` cell below.
//
// The same mistake D626 named, one rung over: an inferred return read off ONE return rather
// than the whole return SET.
function pick(b) {
  if b { return 1 }
  "s"
}

print(pick(true))
print(pick(false))

// THE BYSTANDER CELL. It only has to mint the same i32 box — the registry is module-wide —
// and on the parent that is what turned the loud refusal into a miscompile.
const by: i32 | string = 7
print(pick(true))
print(by)
