// Regression (silent-class-inventory D26): an UN-ANNOTATED binding whose init is a
// `: Circle`-returning call, where `Circle` is a MEMBER of a declared union — beside ONE
// standalone struct anywhere in the module.
//
// `letIsVariant` asked `letInitReboxesToVariant`, which compared the two heap tables:
//
//     const ssi = structIndexOfExpr(init)        // for a variant-returning call this is
//     if ssi < 0 || ssi >= sHeapIdx.length { … } // the VARIANT index (`fRetStructIdx` is
//     return sHeapIdx[ssi] != uVarHeap[vi]       // the polymorphic companion slot)
//
// The two tables share ONE integer namespace, so that reads a VARIANT index through the
// STRUCT table. The `< sHeapIdx.length` test is a BOUNDS check, not a namespace check: it
// declined every variant index only while `sHeapIdx` was EMPTY — which is exactly a program
// whose object types are ALL union arms, because `collectS` skips a `TypeDecl` that
// `variantIndexOf` claims. `Pre` below is the ONE line that makes the table non-empty, and
// with it the guard said "rebox", the binding took the plain-struct row, and the local was
// declared `(ref $sHeapIdx[0])` while the call returned `(ref $uVarHeap[0])`.
//
// BOTH OUTCOMES CAME FROM THAT ONE ROOT, and which one you got depended on whether the
// struct row the variant index landed on happened to carry the field being read:
//   · `Pre = {p,q}` has no `r`  → LOUD "emitProgram: unknown struct field in field access";
//   · a row that does have `r` (e.g. the anonymous `{r:i32}` a monomorphized closure
//     annotation spelling the union structurally mints) → `vl check` rc 0 and an invalid
//     module, which is how D26 was filed.
// This file pins the loud spelling because it needs no generic at all; the silent one is
// `std/array-reduce-narrowed-variant-init.vl`'s member-struct accumulator.
//
// THE INLINE CONTROL (d) RAN THROUGHOUT — with no binding there is no second resolution to
// disagree with — which is why the axis is here rather than one witness.
// @run
// @log 8
// @log 8
// @log 8
// @log 8
// @log 1
// @log 3
// Every `: i32` return below is DECLARED rather than deleted: an un-annotated return takes
// `computeRetInference` instead of the annotation ladder, which is a different classifier
// and not the one under test here.
// @hint redundant type annotation: `takeC` is inferred as `i32`
// @hint redundant type annotation: `bindCall` is inferred as `i32`
// @hint redundant type annotation: `passCall` is inferred as `i32`
// @hint redundant type annotation: `chainCall` is inferred as `i32`
// @hint redundant type annotation: `inlineCall` is inferred as `i32`
// @hint redundant type annotation: `useShape` is inferred as `i32`
type Pre = { p: i32, q: i32 }
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq

function mkPre(): Pre { return { p: 3, q: 4 } }
function mkC(): Circle { return { r: 8 } }
function takeC(c: Circle): i32 { return c.r }

// (a) the un-annotated BINDING of a `: Circle`-returning call — the failing cell.
function bindCall(): i32 {
  const out = mkC()
  return out.r
}

// (b) the same binding PASSED ONWARD to a variant-typed parameter.
function passCall(): i32 {
  const out = mkC()
  return takeC(out)
}

// (c) a second un-annotated binding CHAINED off the first (the ident arm of
// `exprVariantIndex`, reached only once the first binding is a variant local).
function chainCall(): i32 {
  const a = mkC()
  const b = a
  return b.r
}

// (d) the INLINE control — no binding, so no second resolution.
function inlineCall(): i32 { return mkC().r }

// The union instance itself, so `Circle` really is a registered variant.
function useShape(): i32 {
  const s: Shape = { r: 1 }
  if s is Circle { return s.r }
  return -2
}

print(bindCall())
print(passCall())
print(chainCall())
print(inlineCall())
print(useShape())
print(mkPre().p)
