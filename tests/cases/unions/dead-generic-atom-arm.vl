// @run
// @log o
// @log L
// @hint redundant type annotation: `g` is inferred as `string`
// @hint redundant type annotation: `f` is inferred as `string`
// D947/D955 — A CONSTANT-FALSE GENERIC `is`-ATOM ARM READS `unreachable`.
//
// `f<T>(x: T) { if x is i64 { … x … } }` instantiated at `T = i32 | string` type-checks — a
// type parameter may be narrowed to anything — and the arm cannot run. The parent reached the
// arm's READ and refused the whole program (`narrowed union atom has no value box`), because
// no module union had minted an i64 box, for an arm that never executes.
//
// THE PREDICATE IS ON SPELLINGS, and that is what four earlier candidates got wrong: they
// derived an ABI kind per member and inverted the answer, killing the LIVE arm. The narrowed
// atom and the set's members come from ONE producer, so it is a plain membership test —
// `i64` against `i32|string` (dead) versus `i64|string` (live).
//
// BOTH INSTANCES ARE HERE ON PURPOSE. A candidate that elides the dead arm by breaking the
// live one passes a dead-only fixture.
function g(v: i64): string {
  if v == 0 { return "z" }
  "L"
}

function f<T>(x: T): string {
  if x is i64 { return g(x) }
  "o"
}

const u: i32 | string = 4
print(f(u))

const w: i64 | string = 9
print(f(w))
