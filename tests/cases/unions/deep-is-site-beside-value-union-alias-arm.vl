// @run
// @log 1
// D1744's own witness, both stages on. A deep-`is` site in `g` used to re-spell `f`'s
// annotation and refuse `is J` as naming a union the author never wrote; the arm test itself
// then had no interned arm representation, because a union alias arm is a subset of the outer
// box's tags rather than one variant (D1774). With both built, `f` prints.

type J = null | boolean | f64 | string | J[] | { [string]: J }
type Cfg = { port: f64 }

function f(d: J | i32) {
  if d is J { print(1) }
}
function g(e: J) {
  if e is Cfg { print(2) }
}
const j0: J = "s"
f(j0)
g(null)
