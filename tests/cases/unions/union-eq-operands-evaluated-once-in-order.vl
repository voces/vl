// @run
// @log left
// @log right
// @log true
// @log left
// @log right
// @log true
// @log left
// @log right
// @log false
// @log true
// @log false
// Each operand of a union `==`/`!=` runs once, left before right, whether the operand is a call,
// an element read or a field read, and inside a function the IR may claim.
type U = i32 | string

function left(v: U): U {
  print("left")
  return v
}

function right(v: U): U {
  print("right")
  return v
}

function same(a: U, b: U): boolean {
  return left(a) == right(b)
}

const xs: U[] = [1, "a"]
const r: { u: U } = { u: "a" }
print(left(1) == right(1))
print(left("a") != right(1))
print(same(1, "1"))
print(xs[1] == r.u)
print(xs[0] == r.u)
