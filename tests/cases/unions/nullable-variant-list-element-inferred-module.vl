// @run
// @log 7
// THE MODULE-SCOPE TWIN of `nullable-variant-list-element-inferred.vl` (D814/D851).
//
// Both niche classifiers read the ref-list slot and no frame, so the two scopes answer
// identically — but that is a claim to CHECK rather than assume: D822 is the day a
// covariance rung that looked frame-free needed an eighth delivery form to reach a module
// global, and three fixes in one session had missed their module-scope twin.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq

const a: (Circle | null)[] = [{ r: 7 }]
const e0 = a[0]
if e0 != null { print(e0.r) }
