// @run
// @log a
// @log a
// @log z
// A box local narrowed by a discriminant compare reads its atom field at the field's storage and
// decodes it at a string destination: a return, a list element, a binding (D17048).
type A = { kind: "circle" | "round", r: f64 }
type B = { kind: "a" | "z", r: f64 }
function f(n: i32): A | B {
  if n == 0 { return { kind: "circle", r: 1.0 } }
  if n == 1 { return { kind: "z", r: 3.0 } }
  return { kind: "a", r: 2.0 }
}
function h(b: A | B): string {
  if b.kind == "a" { return b.kind }
  return "x"
}
function g(b: A | B): string {
  if b.kind == "a" {
    const xs: string[] = [b.kind]
    return xs[0]
  }
  return "x"
}
function k(b: A | B): string {
  if b.kind == "z" {
    const s: string = b.kind
    return s
  }
  return "x"
}
print(h(f(2)))
print(g(f(2)))
print(k(f(1)))
