// @run
// @log i
// @log notA
// @log s
// Two arms sharing a field name whose maps differ only in the key are a legal union, and `is`
// tells them apart by the value's own map type (D4056).
type A = { f: {[i32]: string} }
type B = { f: {[string]: string} }
type U = A | B
function go() {
  const ma: {[i32]: string} = Map()
  const mb: {[string]: string} = Map()
  const a: U = { f: ma }
  if a is A {
    a.f[11] = "i"
    print(a.f[11] ?? "-")
  } else {
    print("notA")
  }
  const b: U = { f: mb }
  if b is A { print("A") } else { print("notA") }
  if b is B {
    b.f["k"] = "s"
    print(b.f["k"] ?? "-")
  } else {
    print("notB")
  }
}
go()
