// @run
// @log x
// @log y
// @log 3
// @log 1.5
// A list of literal-union members boxed into a union whose other arm is a record or a number rides
// the box as itself under its list kind's tag.
type K = "x" | "y"
type W = { w: i32 }
function show(a: K[] | W) {
  if a is K[] { print(a[0]) } else { print(a.w) }
}
function viaId() {
  const ks: K[] = ["x", "y"]
  show(ks)
}
function viaF(a: f64 | K[]) {
  if a is K[] { print(a[0]) } else { print(a) }
}
function viaG() {
  const ks: K[] = ["y"]
  viaF(ks)
}
viaId()
viaG()
show({ w: 3 })
viaF(1.5)
