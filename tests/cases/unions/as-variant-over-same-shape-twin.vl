// @run
// @log 3
// @log 3
// @log 4
// D4036: `Solo` and the variant `A` are one record type, and their `kind: "a"` tags are one
// literal type, so `as! A`, `as? A` and `is A` over `Solo | null` name a member.
type A = { kind: "a", f: i32 }
type B = { kind: "b", g: i32 }
type U = A | B
type Solo = { kind: "a", f: i32 }
function mk(): Solo | null { return { kind: "a", f: 3 } }
const t = mk() as! A
print(t.f)
const o = mk() as? A
if o != null { print(o.f) }
const v = mk()
if v is A { print(v.f + 1) }
