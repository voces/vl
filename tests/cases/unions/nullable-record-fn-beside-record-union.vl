// @run
// @log 4
// @log null
// @log b
// @log c null
// @log null
// @log true
// A nullable-record function emitted right after another one's `return { … }`, in a program
// that spells a union of two records: each bare `null` takes its own function's heap, and a
// `const c: C | null = null` inside a `B | null` function takes `C`'s (D2564).

type A = { r: i32 }
type B = { q: string }
type C = { c: i32, z: f64 }
function mkB(s: string): B | null {
  if s == "" { return null }
  return { q: s }
}
function mkC(n: i32): C | null {
  if n == 0 { return null }
  return { c: n, z: 1.5 }
}
function mkB2(s: string): B | null {
  if s != "" { return { q: s } }
  const c: C | null = null
  if c == null { print("c null") }
  return null
}
function stB(): B { return { q: "d" } }
function spell(u: B | A | null) { return u is B }

function go() {
  const c = mkC(4)
  if c == null { print("null") } else { print(c.c) }
  const n = mkC(0)
  if n == null { print("null") } else { print(n.c) }
  const b = mkB("b")
  if b == null { print("null") } else { print(b.q) }
  const b2 = mkB2("")
  if b2 == null { print("null") } else { print(b2.q) }
  const x: A | B = stB()
  print(spell(x))
}
go()
