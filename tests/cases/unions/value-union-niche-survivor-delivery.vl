// @run
// @log false
// @log true
// @log s!
// @log N!
// @log null
// @log false
// @log s!
// @log N!
// @log s
// @log true
// @log s
// @log true
// @log N
// @log true
// @log N
// @log false

// D2590: a value union narrowed to `boolean | null` or `string | null` is delivered as that
// niche: to a binding, an argument, a return, a field and a list, from a name, a field or a cell.
function pickB(n: i32): string | boolean | null {
  if n == 0 { return "s" }
  if n == 1 { return true }
  null
}
function pickS(n: i32): i32 | string | null {
  if n == 0 { return 4 }
  if n == 1 { return "s" }
  null
}
function takeB(b: boolean | null) {
  if b == null { print("null") } else { print(!b) }
}
function rs(x: i32 | string | null): string | null {
  if x is i32 { return "i" }
  x
}
function hole(a) { print(a ?? false) }

function name(n: i32) {
  const x = pickB(n)
  if !(x is string) {
    takeB(x)
    const h = { b: x }
    print(h.b ?? false)
  }
  print((rs(pickS(1)) ?? "N") + "!")
  print((rs(pickS(2)) ?? "N") + "!")
}

function places(n: i32) {
  const p = { f: pickS(n) }
  if !(p.f is i32) {
    const y = p.f
    print(y ?? "N")
  }
  const xs = [pickB(n)]
  if !(xs[0] is string) {
    const ys = [xs[0]]
    print(ys[0] ?? true)
  }
  const m: { [string]: string | i32 | null } = Map()
  m["k"] = pickS(n)
  if !(m["k"] is i32) { print(m["k"] ?? "N") }
  const x = pickB(n)
  if !(x is string) { hole(x) }
}

name(1)
name(2)
places(1)
places(2)
