// @log true
// Regression (silent-class-inventory: the `recursive-union-eq-literal` capability probe).
//
// `==` between a value of a MIXED union — value atoms beside container arms — and a scalar
// literal took `emitProgram: \`==\` over a struct union is not supported yet`. `type Json =
// null | boolean | f64 | string | Json[] | {[string]: Json}` carries a list and a map arm, so
// the gate declined the whole union and `v == "b"` refused. That is on the critical path of
// every JSON round-trip a consumer writes, and it is why the usability critique's programs
// hand-roll a `deepEquals`.
//
// THE GATE WAS STRONGER THAN THE LOWERING NEEDS. The compare it guards is arm-AGNOSTIC: it
// reads the box's TAG, compares it against the tag of the atom the OTHER operand names, and
// on a match compares that one payload. The union's remaining arms are never touched — a
// container arm simply has a tag that does not match, which is the right answer and needs no
// compare core of its own.
//
// WIDENED ONLY WHERE THE OTHER OPERAND NAMES A SCALAR ATOM THE UNION CARRIES.
// `valueAtomKind` answers -1 for a container or closure atom, so struct-vs-struct and
// list-vs-list keep the refusal; and the membership test is the same `unionHasAtomK` the
// static-false rung immediately below already trusts, so nothing is admitted that the next
// rung would not have to answer for anyway.
//
// GRADED AS A VALUE TABLE, never as a compile. An equality that answers `true` for
// everything passes a naive fixture, so every arm is compared once matching and once not,
// the container-valued box is compared against two scalars it can never equal, and `!=` is
// checked in both directions.
type Json = null | boolean | f64 | string | Json[] | { [string]: Json }

function mk(c: i32): Json {
  if c == 0 { return "b" }
  if c == 1 { return 2.5 }
  if c == 2 { return true }
  if c == 3 { return null }
  const a: Json[] = [1.5]
  a
}

const s = mk(0)
const f = mk(1)
const b = mk(2)
const n = mk(3)
const l = mk(4)

// each scalar arm, matching then not
print(s == "b")
print(s == "z")
print(f == 2.5)
print(f == 9.5)
print(b == true)
print(b == false)

// a value in one arm against a literal of another — a tag mismatch, never a payload compare
print(s == 2.5)
print(f == "b")

// the CONTAINER-valued box against scalars: the arms the widening does not touch
print(l == "b")
print(l == 2.5)

// the null arm still answers, and `!=` negates
print(n == null)
print(s != "b")
print(s != "z")
