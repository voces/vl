// @run
// @log 8
// @log 8
// @log 8
// @log 8
// @log 8
// @log 8
// @log 8
// @log 8

// D1741 — an UN-ANNOTATED binding of a narrowed struct arm. The initializer hands over the
// union box while the checker types the binding at the arm, so the cell was the box and every
// consumer read it as the arm: a loud refusal at a field read, invalid wasm everywhere else.
// Every binding here is deliberately un-annotated — the annotated spelling always ran, and
// annotating a destination is exactly what hides this defect.
type A = { r: i32 }
type M = i32 | A

function st(): A { return { r: 8 } }

function mkInf(b: boolean) {
  if b { return st() }
  7
}

function mkDecl(b: boolean): M {
  if b { return st() }
  7
}

function takeA(a: A) { print(a.r) }

function idA(a: A): A { a }

// The field read: the refusal the un-annotated cell used to give.
const p = mkInf(true)
if p is A {
  const q = p
  print(q.r)
} else {
  print(0)
}

// The same over a DECLARED union, whose arm has its own variant row.
const d = mkDecl(true)
if d is A {
  const q = d
  print(q.r)
} else {
  print(0)
}

// The consumers that were invalid wasm: argument, return, capture, assignment, element store.
function fromArg() {
  const v = mkInf(true)
  if v is A {
    const q = v
    takeA(q)
  } else {
    print(0)
  }
}
fromArg()

function fromReturn() {
  const v = mkInf(true)
  if v is A {
    const q = v
    print(idA(q).r)
  } else {
    print(0)
  }
}
fromReturn()

function fromCapture() {
  const v = mkInf(true)
  if v is A {
    const q = v
    const f = () => print(q.r)
    f()
  } else {
    print(0)
  }
}
fromCapture()

function fromAssign() {
  const v = mkInf(true)
  if v is A {
    const q = v
    let z = st()
    z = q
    print(z.r)
  } else {
    print(0)
  }
}
fromAssign()

// A receiver whose rung sits above the union one: a bare map read is nullable, so its cell
// came from the map ladder rather than from `letIsUnion`.
function fromMapRead() {
  const m: {[string]: M} = Map()
  m["k"] = mkDecl(true)
  if m["k"] is A {
    const q = m["k"]
    print(q.r)
  } else {
    print(0)
  }
}
fromMapRead()

// A nested element, whose place the emitter's own narrowing stack does not key: the cell and
// the boundary have to agree from the checker's answer alone.
function fromNestedElement() {
  const ys = [[mkInf(true)]]
  if ys[0][0] is A {
    const q = ys[0][0]
    takeA(q)
  } else {
    print(0)
  }
}
fromNestedElement()
