// @error cannot write through an index of string[] | i32[]: the value would have to fit every member's element
// A union of lists is read through an index, but not written: the stored value would have to
// fit every member's element at once, so a write needs the `is` narrowing that picks one.
function mk(b: boolean): string[] | i32[] {
  if b { return ["a"] }
  [1, 2, 3]
}
const u = mk(false)
print(u[0])
u[0] = 5
