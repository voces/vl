// @run
// @log 2
// @log 101
// @log 103
// @log false
// @log false
// @log true
// @log 102
// D13981: `(string | null)[]` rides `string[]`'s arm, so `is string[]` against it tests that no
// element is null (the D4771 ruling); the un-annotated face passes an argument literal.
function f(v: string[] | (string | null)[]) {
  if v is string[] { return v.length + 100 }
  v.length
}
const b: (string | null)[] = ["b", null]
const c: (string | null)[] = ["c"]
const s = ["a", "b", "c"]
print(f(b))
print(f(c))
print(f(s))
function g(v: (string | null)[] | string[] | null) { v is string[] }
print(g(null))
print(g(b))
print(g(c))
print(f(["p", "q"]))
