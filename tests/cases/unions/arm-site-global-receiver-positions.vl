// @run
// @log 2
// @log 2
// @log at 2
// @log 2
// @log two
// @log 4
// @log 2
// @log 1
// Q58 position sweep: a module global holding `u8[] | K[]`, narrowed by `is K[]` and read through
// an arm site (an element, at the literal set's rep, D17001), whose box each arm reads again from
// the global: at module scope as a call argument, a `let` and an interpolation hole, and in a
// function as a return, an `if` operand, an arithmetic operand and a `print` argument.
type K = 1 | 2
const a: u8[] = [1, 2]
const q: u8[] | K[] = a
if q is K[] { print(q[1]) }
if q is K[] {
  const x = q[1]
  print(x)
}
if q is K[] { print("at \{q[1]}") }
function ret(): K | i32 {
  if q is K[] { return q[1] }
  return -1
}
print(ret())
function cmp(): string {
  if q is K[] {
    if q[1] == 2 { return "two" }
  }
  return "other"
}
print(cmp())
function add(): i32 {
  if q is K[] { return q[1] + q[1] }
  return -1
}
print(add())
function show() {
  if q is K[] {
    print(q[1])
    print(q[0])
  }
}
show()
