// `Circle | null` WHERE `Circle` IS A UNION ARM — the `nulvariant` kind, at every position
// a binding can hold one: param, local, return, module global.
//
// THE CLIFF THIS CLOSES was action at a distance. `Circle | null` compiled and ran on its
// own; adding `type Shape = Circle | Rect` ELSEWHERE in the file deleted its representation:
//
//     emitProgram: ref valtype with no interned shape
//
// Nothing at the use site changed — only whether `Circle` was a member of some union
// somewhere else. `collectS` refuses a variant its own struct row ("a variant is owned by
// the variant table"), so the kind-9 nullable-struct niche had no `sHeapIdx` entry to name,
// while the identical annotation over a NON-member struct lowered fine.
//
// A NICHE, NOT A BOX: the cell is `(ref null $uVarHeap[vi])`, so a non-null value costs no
// allocation, exactly as a plain `S | null` does not. Boxing it instead would have made
// `Circle | null` allocate where the same spelling over a non-member struct does not — a
// performance cliff switched on by a declaration in another part of the file, which is the
// same invisible coupling as the original bug wearing different clothes.
// @run
// @log 1
// @log 2
// @log -1
// @log 2
// @log 2
// @log 2
// @log -1

type Circle = { kind: "circle", r: f64 }
type Rect   = { kind: "rect", w: f64 }
// The declaration that USED to delete the representations below.
// THE DECLARATION that used to delete every representation below, kept with a live value
// at the union type so the fixture provably exercises the variant path: `Circle` is a
// member of `Shape`, so `collectS` refuses it a standalone struct row and the nullable
// forms must resolve through `uVarHeap`. Drop this union and the same annotations lower as
// ordinary kind-9 nullable structs, which is the contrast the whole file is about.
type Shape  = Circle | Rect
const shape: Shape = { kind: "rect", w: 1.0 }
if shape is Rect { print(shape.w) } else { print(-1.0) }

// PARAM, both ways
function radius(c: Circle | null) {
  if c != null { return c.r }
  -1.0
}
const one: Circle = { kind: "circle", r: 2.0 }
print(radius(one))                       // 2
print(radius(null))                      // -1

// LOCAL
function localForm() {
  const c: Circle | null = { kind: "circle", r: 2.0 }
  if c != null { return c.r }
  -1.0
}
print(localForm())                       // 2

// RETURN — and the INFERRED binding on the caller's side, which reads its slot from the
// callee's recorded return kind rather than from an annotation it does not have.
function mk(b: boolean): Circle | null {
  if b { return { kind: "circle", r: 2.0 } }
  null
}
function returnForm() {
  const c = mk(true)
  if c != null { return c.r }
  -1.0
}
print(returnForm())                      // 2

// MODULE GLOBAL
const g: Circle | null = { kind: "circle", r: 2.0 }
if g != null { print(g.r) } else { print(-1.0) }   // 2
const gn: Circle | null = null
if gn != null { print(gn.r) } else { print(-1.0) } // -1
