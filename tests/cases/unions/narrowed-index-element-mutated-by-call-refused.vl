// @error 'xs[0]' is no longer narrowed to A
// A call that may reassign the narrowed element drops the narrowing before the read.
type A = { r: i32 }
type M = i32 | A
function mut(xs: M[]) { xs[0] = 9 }
function f() {
  const xs: M[] = [{ r: 1 }]
  if xs[0] is A {
    mut(xs)
    print(xs[0].r)
  }
}
f()
