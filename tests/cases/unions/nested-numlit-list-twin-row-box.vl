// @run
// @log 1
// @log 9
// @log 7
// @log 1
// @log 2
// An `i32[][]` value boxed into `K[][] | i32[][] | string` once `K[][] | string | null` keyed
// the shared row first: it rides the `K[][]` arm's tag, and `is` and `as?` read its leaves.
type K = 0 | 1
function own(x: K[][] | string | null) {
  if x is K[][] { print(x[0][0]) } else { print(9) }
}
own([[1]])
function twin(x: K[][] | i32[][] | string) {
  if x is K[][] { print(x[0][0]) } else { print(9) }
  const y = x as? K[][]
  if y == null { print(7) } else { print(y.length) }
}
const five: i32[][] = [[5]]
twin(five)
const fits: i32[][] = [[1], [0]]
twin(fits)
