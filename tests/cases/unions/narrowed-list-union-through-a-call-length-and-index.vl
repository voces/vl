function mkT(k: i32): i32[] | f64[] | string {
  if k == 0 { return "s" }
  if k == 1 { return [2.5, 3.5, 4.5] }
  return [4, 5]
}
function mkS(k: i32): string[] | i32[] | boolean {
  if k == 0 { return true }
  if k == 1 { return ["x"] }
  return [7, 8, 9, 10]
}
function id<T>(x: T): T { return x }
function pick(x: i32[] | f64[]): i32[] | f64[] { return x }
function loud<T>(x: T): T {
  print("call")
  return x
}
function show(n: i32) { print(n) }
function generic(a) {
  if a is string { return -1 }
  return id(a).length
}
function plain(a: i32[] | f64[] | string) {
  if a is string { return -1 }
  return pick(a).length
}
function nested(a) {
  if a is string { return -1 }
  return id(id(a)).length
}
function paren(a) {
  if a is string { return -1 }
  return (id(a)).length
}
function effect(a) {
  if a is string { return -1 }
  return loud(a).length
}
function positions(a) {
  if a is string { return }
  const c = id(a).length
  show(c)
  show(id(a).length)
  if id(a).length > 2 { print("long") } else { print("short") }
  let n = 0
  for i in 0 until id(a).length { n = n + 1 }
  print(n)
}
function other(b) {
  if b is boolean { return -1 }
  return id(b).length
}
print(generic(mkT(1)))
print(generic(mkT(2)))
print(plain(mkT(1)))
print(plain(mkT(2)))
print(nested(mkT(1)))
print(paren(mkT(2)))
print(effect(mkT(1)))
positions(mkT(1))
positions(mkT(2))
print(other(mkS(1)))
print(other(mkS(2)))
function idx(a) {
  if a is string { return }
  print(id(a)[0])
  print(pick(a)[1])
}
idx(mkT(1))
idx(mkT(2))
let calls = 0
function counted<T>(x: T): T {
  calls = calls + 1
  return x
}
function walk(a) {
  if a is string { return }
  calls = 0
  for i in 0 until 2 { print(counted(a)[i]) }
  print(calls)
  calls = 0
  let n = 0
  for i in 0 until counted(a).length { n = n + 1 }
  print(n)
  print(calls)
}
walk(mkT(1))
walk(mkT(2))
