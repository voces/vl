// @run
// @log 1
// @log 2
// @log 3
// @log 4
// @hint redundant type annotation: `p` is inferred as `{x: i32}`
// @hint redundant type annotation: `useUU` is inferred as `i32`
// @hint Intentionally-unused variable `_seen`
// @hint redundant type annotation: `declared` is inferred as `{f: P}`
// @hint redundant type annotation: `rebound` is inferred as `P`
// @hint redundant type annotation: `armX` is inferred as `i32`
// @hint redundant type annotation: `held` is inferred as `{f: P}`

// CONTRACT (D1672): a holder whose FIELD carries a union arm builds and reads at every
// spelling of the holder — an inferred literal, a declared alias, an inline shape — and an
// annotated rebind of the field read is a receiver like any other. An arm has no
// struct-table row of its own, so the row a code-15 field stores through is minted on demand.
type P = { x: i32 }
type Q = { y: i32 }
type UU = P | Q
type W = { f: P }

const p: P = { x: 1 }

function useUU(u: UU): i32 {
  if u is P { return u.x }
  0
}

const _seen = useUU(p)

// the inferred holder: nothing but the field value names the arm
const inferred = { f: p }

print(inferred.f.x)

// the declared alias, and the annotated rebind of its field read
const declared: W = { f: p }
const rebound: P = declared.f

print(rebound.x + 1)

// the same rebind delivered somewhere that demands the non-null arm
function armX(a: P): i32 { a.x }

print(armX(rebound) + 2)

// the inline-shape holder, written to and read back
const held: { f: P } = { f: p }

held.f = p

print(held.f.x + 3)
