// @log 1
// Flow narrowing's first slice: each path through an `if` carries its own narrowing facts, and
// below the `if` a place reads at the meet of the paths that reach it (D3285). A fill on the
// miss arm and a null test on the other arm meet at the non-null type, which is plumb's PL-064.
// Every row reads the place as its non-null type, which the declaration alone would refuse.
function nn(v: i32): i32 | null {
  if v < 0 { return null }
  return v
}

// The then path assigned, the fall-through tested non-null.
function name(k: i32) {
  let x = nn(k)
  if x == null { x = 0 }
  return x + 1
}
print(name(5))
print(name(-1))

// A lazily filled cache field, read through a local.
type Cache = { m: Map<string, i32> | null }
function lookup(c: Cache) {
  let m = c.m
  if m == null {
    const built = Map<string, i32>()
    built.set("x", 7)
    c.m = built
    m = built
  }
  return m.get("x") ?? 0
}
const cache: Cache = { m: null }
print(lookup(cache))
print(lookup(cache))

// A field, an element and a module global as the place.
type Box = { v: i32 | null }
function field(b: Box) {
  if b.v == null { b.v = 0 }
  return b.v + 1
}
print(field({ v: nn(-1) }))
print(field({ v: 6 }))
function elem(xs: (i32 | null)[]) {
  if xs[0] == null { xs[0] = 0 }
  return xs[0] + 1
}
print(elem([nn(-1)]))
print(elem([2]))
let g: i32 | null = null
function global(k: i32) {
  g = nn(k)
  if g == null { g = 0 }
  return g + 1
}
print(global(-1))
print(global(3))

// An `is` test over a union, and an `else if` chain whose arms fill the rest.
function mk(k: i32): i32 | string | null {
  if k < 0 { return null }
  if k == 0 { return "z" }
  return k
}
function chain(k: i32) {
  let v = mk(k)
  if v == null { v = 0 }
  else if v is string { v = 1 }
  return v + 1
}
print(chain(-1))
print(chain(5))
print(chain(0))

// Joins nested inside an arm, meeting again at the outer `if`.
function nested(k: i32, c: boolean) {
  let x = nn(k)
  if x == null {
    if c { x = 1 } else { x = 2 }
  }
  return x + 1
}
print(nested(7, true))
print(nested(-1, false))
print(nested(-1, true) + 2)

// An `if` in value position joins when its statement ends.
function value(k: i32) {
  let x = nn(k)
  const y = if x == null { x = 0; 10 } else { 20 }
  return x + y
}
print(value(-1))
print(value(4))

// A record fill, read by member.
type P = { n: i32 }
function rec(k: i32) {
  let p: P | null = null
  if k >= 0 { p = { n: k } }
  if p == null { p = { n: 0 } }
  return p.n + 1
}
print(rec(4))
print(rec(-1))
