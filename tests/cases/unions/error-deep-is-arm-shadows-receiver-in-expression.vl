// @error a deep `is` arm that rebinds or writes `r` inside an expression is not supported yet — write it as its own statement, or bind the converted value first
// A `const` of the tested place's name in a block nested in an expression of a deep `is` arm
// shadows it for that block only, which the rewrite's substitution does not scope (D16475).
type Json = null | boolean | f64 | string | Json[] | { [string]: Json }
function d(r: Json, c: boolean) {
  if r is string[] {
    const n = r.length
    const x = if c {
      const r = 5
      r + 1
    } else {
      0
    }
    print(x)
    return n
  }
  0
}
print(d(["a", "b"], true))
