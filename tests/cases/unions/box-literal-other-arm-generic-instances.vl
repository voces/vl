// @run
// @log s
// @log 4
// @log 2
// @log 5
// A record literal boxed into a nullable union of records in a generic function's two instances:
// the box plan boxes it as the union's arm, built at that arm's row.
type A = { t: i32, a: i32 }
type B = { t: i32, b: i32 }
type AB = A | B
function f<T>(x: i32, tag: T): AB | null {
  print(tag)
  const u: AB | null = { t: 1, b: x }
  return u
}
const u = f(4, "s")
if u != null && u is B { print(u.b) }
const w = f(5, 2)
if w != null && w is B { print(w.b) }
