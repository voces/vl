// @run
// A value `if` whose arm is a union narrowed to a record, passed straight to a record parameter,
// through a nested call and through a generic identity: a box holding a `P` whose `x` differs from
// the `else` arm's, so the wrong record arriving shows.
type P = { x: i32 }
type Q = { y: string }
function vOf(p: P) { return p.x }
function wrap(n: i32) { return n * 10 }
function idv<T>(v: T): T { return v }
function direct(u: P | Q, d: P) { return vOf(if u is P { u } else { d }) }
function nested(u: P | Q, d: P) { return wrap(vOf(if u is P { u } else { d })) }
function generic(u: P | Q, d: P) { return vOf(idv(if u is P { u } else { d })) }
const boxP: P | Q = { x: 7 }
const boxQ: P | Q = { y: "q" }
const d: P = { x: 5 }
print(direct(boxP, d))
print(direct(boxQ, d))
print(nested(boxP, d))
print(nested(boxQ, d))
print(generic(boxP, d))
print(generic(boxQ, d))
// @log 7
// @log 5
// @log 70
// @log 50
// @log 7
// @log 5
