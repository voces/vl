// D1023's POSITION MATRIX: the discriminant test has to answer the same way wherever the
// union value is delivered from, and each row prints a value that proves which arm was taken.
//
// WHY A MATRIX AND NOT ONE CASE. A capability served in many syntactic positions is enforced
// in one place and wired in several; the emitter's `is` ladder alone reaches a union value as
// an Ident, a struct-field read, a narrowed member, an element read, an optional chain and a
// bare expression. The first draft of this fix passed a two-arm union at every one of them
// and still trapped on the THREE-arm case, because the membership compare was conjoined onto
// the tag test with `i32.and` — whose operands are both evaluated, so the `ref.cast` inside
// the discriminant read ran on arms of every other shape too. Only the three-arm row saw it.
//
// The `built under no name` row is the ruling's own words: a `{ kind: "circle", r: 1.0 }`
// built under no name at all IS a Circle, so `is` must not answer by the row a value was
// constructed through.
// The `area` return annotation is kept and its hint DECLARED rather than deleted: the
// parameter position is one of the rows being graded, and an annotated signature is what a
// caller writes.
// @hint redundant type annotation: `area` is inferred as `f64` — remove it to lean on inference
// @run
// @log 1.5
// @log 2.5
// @log 2.5
// @log 9
// @log 1.5
// @log 25
// @log 1
// @log 2
// @log 3
// @log 4
// @log 1.5
// @log 25
// @log 300

type Circle = { kind: "circle", r: f64 }
type Square = { kind: "square", r: f64 }

// BUILT UNDER NO NAME — an object literal straight into the union annotation.
const n1: Circle | Square = { kind: "circle", r: 1.5 }
if n1 is Circle { print(n1.r) } else { print(0.0) }
const n2: Circle | Square = { kind: "square", r: 2.5 }
if n2 is Circle { print(0.0) } else { print(n2.r) }

// WIDENED THROUGH THE UNION AND BACK: a Square that spent time as the union is still a Square.
function widen(s: Circle | Square): Circle | Square { return s }
const sq: Square = { kind: "square", r: 2.5 }
const w = widen(sq)
if w is Square { print(w.r) } else { print(0.0) }
if w is Circle { print(-1.0) } else { print(9.0) }

// LIST ELEMENT.
const xs: (Circle | Square)[] = [
  { kind: "circle", r: 1.5 },
  { kind: "square", r: 2.5 },
]
let i = 0
while i < xs.length {
  const e = xs[i]
  if e is Circle { print(e.r) } else { print(e.r * 10.0) }
  i = i + 1
}

// STRUCT FIELD holding the union.
type Box = { shape: Circle | Square, tag: i32 }
const b1: Box = { shape: { kind: "circle", r: 1.5 }, tag: 1 }
const b2: Box = { shape: { kind: "square", r: 2.5 }, tag: 2 }
if b1.shape is Circle { print(b1.tag) } else { print(-1) }
if b2.shape is Circle { print(-1) } else { print(b2.tag) }

// FUNCTION PARAMETER.
function area(s: Circle | Square): f64 {
  if s is Circle { return s.r * 3.0 }
  return s.r * 4.0
}
print(area({ kind: "circle", r: 1.0 }))
print(area({ kind: "square", r: 1.0 }))

// THREE ARMS, two sharing a shape and one not — the tag test must still do its half, and the
// discriminant read must NOT run on the arm whose heap type it would fail to cast to.
type Tri = { base: f64, height: f64 }
function mk3(n: i32): Circle | Square | Tri {
  if n == 0 { return { kind: "circle", r: 1.5 } }
  if n == 1 { return { kind: "square", r: 2.5 } }
  return { base: 3.0, height: 4.0 }
}
let j = 0
while j < 3 {
  const s = mk3(j)
  if s is Circle { print(s.r) }
  if s is Square { print(s.r * 10.0) }
  if s is Tri { print(s.base * 100.0) }
  j = j + 1
}
