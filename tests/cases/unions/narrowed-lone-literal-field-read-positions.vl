// @run
// @log end
// @log end
// @log end
// @log <end>
// A field narrowed to an arm whose type is a lone literal, stored as the union's atom, read where a
// string is wanted: printed in a function, over a list's elements, off a module binding, bound to a
// string, and concatenated.
type K = { kind: "a" | "b", v: i32 } | { kind: "end" }
function show(n: K) {
  if n is { kind: "end" } { print(n.kind) }
}
show({ kind: "end" })
show({ kind: "a", v: 1 })
const ks: K[] = [{ kind: "end" }, { kind: "b", v: 2 }]
for k in ks {
  if k is { kind: "end" } { print(k.kind) }
}
const e: K = { kind: "end" }
if e is { kind: "end" } {
  const s: string = e.kind
  print(s)
  print("<" + e.kind + ">")
}
