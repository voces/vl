// @run
// @log 1
// @log 1
// @log 1
// @hint redundant type annotation: `a` is inferred as `{r: i32}[]` — remove it to lean on inference
// The destinations are `readonly`: only a readonly list is covariant, and a mutable one is
// refused (DECISIONS.md "No implicit container widening").
// A read-only covariant list inside an UN-ANNOTATED container handed to a function (D1659).
//
// The container is inferred rather than declared, so the annotation pins nothing and the
// closure has to name it by itself. `poke(nn)` hands it a second name — the parameter `g` —
// and `g[0]` is a read, not a store, so nothing writes either list and the converting copy
// is unobservable. Its writing twin is the refusal this face must not lose.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq

function poke(g: (readonly Shape[])[]) { print(g[0].length) }

function f() {
  const a: Circle[] = [{ r: 7 }]
  const b: readonly Shape[] = a
  const nn = [b]
  poke(nn)
  print(a.length)
}

function other() {
  const w: Shape[] = []
  w.push({ s: 3 })
  print(w.length)
}

f()
other()
