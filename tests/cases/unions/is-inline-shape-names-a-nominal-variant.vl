// @run
// @log 100
// @log 200
// @log 1
// @log 300
// @log 400
// @log 2
// An `is` test spelled as an INLINE SHAPE (`x is {meow: i32}`) resolves to the variant that
// shape DENOTES, even when the union spells its members NOMINALLY.
//
// THE EMITTER RESOLVES AN `is` BY AN EXACT STRING COMPARE against `uVariants`
// (`variantIndexOf`), so which spellings work is decided by which spellings got REGISTERED.
// A union declared `Cat | Dog` registers the rows `Cat` and `Dog`, so on the parent commit
// every function below was a loud reject —
//
//     emitProgram: `is` names a type that is not a union variant
//
// — EXCEPT when the module happened to contain an unrelated function with an INFERRED
// struct-union return. Such a return was registered TWICE (the arena walk spelled the
// anonymous inferred type structurally, `{meow:i32}|{woof:i32}`, and the checker's
// reverse-mapped name spelled it `Cat|Dog`), and the duplicate's rows are what an inline
// test elsewhere in the module matched. *Deleting an unrelated function changed whether
// this test compiled* — action at a distance through a duplicate registration. The sibling
// pin `functions/inferred-union-one-row.vl` is the same program WITH that function, and it
// is where the duplicate's removal is entombed; this file is the half that never had one.
//
// The spelling is resolved where it is CONSUMED instead of depending on a registration
// accident: `isVariantSpelling` (`emit_classify.vl`) reads the checker's banked type for the
// `is` node (`isVarTyIxOf`) and asks the same reverse map that spelled the union's members
// in the first place (`nominalStructNameOfTy` → `nominalNameOfObj`, bidirectional
// assignability). Strictly additive — the author's own spelling wins whenever it names a
// row, so a union ANNOTATED with inline shapes, whose rows genuinely are `{meow:i32}` /
// `{woof:i32}`, is untouched (`structuralAnnotation` below, which runs on both compilers).
//
// TWO GATES READ THE RULE, and they are two rather than one: the `is` test's own
// `variantIndexOf` and the narrowing PUSH, whose spelling every narrowed receiver inherits.
// Fixing only the first moved the failure one site over, to `emitProgram: narrowed receiver
// names no union variant` — which is why every case below READS A FIELD through the
// narrowing instead of stopping at the test.
type Cat = { meow: i32 }
type Dog = { woof: i32 }
type U = Cat | Dog

// ── A NOMINAL union annotation. On the parent commit this function is an emit reject.
function nominal() {
  const a: Cat | Dog = { meow: 100 }
  if a is {meow: i32} {
    print(a.meow)
  }
  const b: Cat | Dog = { woof: 200 }
  if b is {woof: i32} {
    print(b.woof)
  }
  if b is Dog {
    print(1)
  }
}

// ── The same through a DECLARED union alias.
function throughAlias() {
  const a: U = { meow: 300 }
  if a is {meow: i32} {
    print(a.meow)
  }
  const b: U = { woof: 400 }
  if b is {woof: i32} {
    print(b.woof)
  }
  if b is Dog {
    print(2)
  }
}

// THE CONTROL FOR THE ADDITIVITY CLAIM IS A SEPARATE FILE, AND THAT IS NOT TIDINESS. A union
// spelled with inline shapes (`{meow: i32} | {woof: i32}`) registers those shapes as its
// rows, so its own `is {meow: i32}` already resolves and the fallback never runs — but a
// single such annotation anywhere in THIS module would put those rows in `uVariants` and make
// the two functions above compile on the parent commit too, exactly as the inferred return
// does. It lives in `is-inline-shape-structural-union-control.vl`, alone.
nominal()
throughAlias()
