// @run
// @log 7
// @log s
// @log 7
// @log s
// @log 6
// The un-annotated face of D3269: the alias's value reaches `is` through an inferred binding,
// an annotated list's elements and a record field, none spelling the union at the test.
type F = (() => i32) | string
type H = { f: F }
function mk(b: boolean): F {
  if b { return () => 7 }
  return "s"
}
const f = mk(true)
if f is () => i32 { print(f()) } else { print("else") }
const s = mk(false)
if s is string { print(s) } else { print("else") }
const xs: F[] = [mk(true), mk(false)]
for x in xs {
  if x is string { print(x) } else { print(x()) }
}
const h: H = { f: mk(true) }
if h.f is string { print("else") } else { print(6) }
