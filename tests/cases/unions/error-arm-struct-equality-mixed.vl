// @emit-error emitProgram: struct equality is not supported yet
// THE CONTROL FOR D57'S FIX, and it is the half that must NOT move. The variant rung added
// to the `==` dispatch fires ON AGREEMENT ONLY — both operands resolving to the SAME variant
// row — so a MIXED pair keeps the refusal it always had: `Circle` is a union arm whose values
// live at `uVarHeap[vi]`, `Dot2` is a standalone struct at `sHeapIdx[si]`, and the two are
// distinct heap types however alike their field sets look.
//
// WITHOUT THIS FILE THE FIX IS UNFALSIFIABLE. A variant rung asked unconditionally, or asked
// on "either side answered", would take this pair and read one operand through the other's
// heap type — check-clean invalid wasm, which is the class D57 was filed under. The refusal
// here is the evidence that widening stopped at agreement.
//
// IT IS ALSO THE ANSWER ON MASTER, at the same site and with the same sentence: the mixed
// pair was already refused before `type Shape` existed (`Circle` and `Dot2` are two struct
// rows, and `eqLsi != eqRsi`), so this is a refusal PRESERVED across a namespace being added,
// not one invented for it.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Dot2 = { r: i32 }

function cell(): boolean {
  const a: Circle = { r: 1 }
  const d: Dot2 = { r: 1 }
  return a == d
}

print(cell())
