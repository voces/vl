// A union arm compared with a same-shape record declared outside the union (D12465). Both are
// stored at the one heap type their shape shares, so `==` is the field-wise struct compare; the
// cells cover both orders, `!=`, a list element, a nested field and a record holding each.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Dot2 = { r: i32 }

function cell() {
  const a: Circle = { r: 1 }
  const d: Dot2 = { r: 1 }
  return a == d
}

function differ() {
  const a: Circle = { r: 1 }
  const d: Dot2 = { r: 2 }
  return d == a
}

function params(a: Circle, d: Dot2) { a != d }

type Hold = { c: Circle }
type Hold2 = { c: Dot2 }
type P = { a: Circle, n: string }
type Q = { a: Dot2, n: string }

print(cell())
print(differ())
print(params({ r: 1 }, { r: 2 }))
print(params({ r: 3 }, { r: 3 }))
const xs: Circle[] = [{ r: 1 }, { r: 2 }]
const d: Dot2 = { r: 2 }
print(d == xs[1])
const h: Hold = { c: { r: 4 } }
const k: Hold2 = { c: { r: 5 } }
print(k.c != h.c)
const p: P = { a: { r: 1 }, n: "x" }
const q: Q = { a: { r: 1 }, n: "x" }
print(p != q)
print(p == q)
print(xs[0] != d)
