// @run
// @log 2
// @log 1
// @log 2
// @log 1
// @log 2
// @log 1
// @log 1
// @log 1
// @log hi
// @hint redundant type annotation: `a2` is inferred as `Json | JsonError` — remove it to lean on inference

// D1822 — the list twin of D1864. A second narrowing over one binding banks the ALIAS the
// program wrote (`JsonArr`) where the first banked the rendered `Json[]` spelling, and two name
// tests cannot read through it: `nameIsRefArray` in `narrowedRefArrayOf` (the `.length` route)
// and `nameIsArray` in `mapReadMvSlot`'s D1012 guard (the index route). Both re-ask the row.

import { Json, JsonError, parseJson } from "std:json"

type JsonArr = Json[]

// The alias, inferred face: `.length` then the index read.
const a1 = parseJson("[1, 2]")
if a1 is JsonError {
  print("err")
} else {
  if a1 is JsonArr {
    print(a1.length)
    const v = a1[0]
    if v is f64 { print(v) } else { print("not f64") }
  } else {
    print("not an array")
  }
}

// The same at the ANNOTATED face — an annotation pins the rep, so a fixture that only infers
// cannot see a defect the annotation would hide, or the other way round.
const a2: Json | JsonError = parseJson("[1, 2]")
if a2 is JsonError {
  print("err")
} else {
  if a2 is JsonArr {
    print(a2.length)
    const v = a2[0]
    if v is f64 { print(v) } else { print("not f64") }
  } else {
    print("not an array")
  }
}

// The inline control, which ran before this close and must keep running.
const a3 = parseJson("[1, 2]")
if a3 is JsonError {
  print("err")
} else {
  if a3 is Json[] {
    print(a3.length)
    const v = a3[0]
    if v is f64 { print(v) } else { print("not f64") }
  } else {
    print("not an array")
  }
}

// An alias whose ELEMENT is itself an alias-of-array, on a plain user union — ran before and
// must keep running, so the render cannot be reading the outer spelling only.
type Circle = { r: f64 }
type CircleArr = Circle[]
type CircleArrArr = CircleArr[]
type U = CircleArrArr | string

function pick(b: boolean): U {
  if b { return [[{ r: 1.0 }]] }
  "s"
}

const u = pick(true)
if u is CircleArrArr { print(u.length) } else { print("not a list") }

// D1864's map arm and the string arm behind the same guard: the row's own boundary.
type JsonMap = { [string]: Json }

const m1 = parseJson("{\"a\": 1}")
if m1 is JsonError {
  print("err")
} else {
  if m1 is JsonMap { print(m1.size) } else { print("not an object") }
}

const s1 = parseJson("\"hi\"")
if s1 is JsonError {
  print("err")
} else {
  if s1 is string { print(s1) } else { print("not a string") }
}
