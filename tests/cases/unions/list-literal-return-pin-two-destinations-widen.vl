// @run
// @log 1
// @log 1
// D501's RETURN-PIN witness, now RUNNING (D791). `synthRetPinAnn`'s gate still declines the
// pin; `letRefListDestSlot` then builds the literal at the plain `Circle[]` row that the
// function's own `: Circle[]` result wants, and the `const cU: Shape[] = lv1` binding takes
// the element-converting copy.
//
// The pair of destinations here is the one that separates the two pin rungs: a `ret` kind-1
// destination beside a `bind` kind-2 one. Both had to decline before this program could
// reach the classifier at all, and both still do.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function f(): Circle[] {
  const lv1 = [{ r: 7 }]
  const cU: Shape[] = lv1
  if cU.length > 0 { print(cU.length) } else { print(0) }
  return lv1
}
const rr = f()
print(rr.length)
