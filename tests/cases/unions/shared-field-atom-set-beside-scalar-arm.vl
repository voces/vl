// @run
// @log b
// @log 7
// @log true
// @log y
// @log 2.5
// @log x
// @log 9
// @log lit b
// @log int
// @log 4
// A shared field one record stores as a literal set at the atom and another as a scalar reads as
// the box of their join: the atom arm is widened to the string it names, never read as its id
// (D14750), and an f64 arm beside it has a read too (D14751).
type K = "a" | "b"
type P = { k: K } | { k: i32 }
const u1: P = { k: "b" }
print(u1.k)
const u2: P = { k: 7 }
print(u2.k)
const u3: { k: "x" | "y" } | { k: boolean } = { k: true }
print(u3.k)
const u4: { k: "x" | "y" } | { k: boolean } = { k: "y" }
print(u4.k)
const u5: { k: "x" | "y" } | { k: f64 } = { k: 2.5 }
print(u5.k)
function mk(b: boolean): { k: "x" | "y", n: i32 } | { k: i32, m: string } {
  if b { return { k: "x", n: 1 } }
  { k: 9, m: "z" }
}
print(mk(true).k)
print(mk(false).k)
function show(v: K | i32) {
  if v is i32 {
    print("int")
    print(v)
  } else {
    print("lit " + v)
  }
}
const ps: P[] = [{ k: "b" }, { k: 4 }]
for p in ps {
  const v: K | i32 = p.k
  show(v)
}
