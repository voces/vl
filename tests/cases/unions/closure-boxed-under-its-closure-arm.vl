// @run
// @log 7
// @log 3
// @log 5
// A closure delivered into a union box rides it under its closure arm's tag: a lambda literal and a
// closure binding, as an argument and as a return, beside a scalar arm.
type F = ((x: i32) => i32) | i32
function run(f: F, x: i32) {
  if f is i32 { return f }
  return f(x)
}
function mk(k: i32): F { return (x: i32) => x + k }
function bound(k: i32) {
  const g = (x: i32) => x * k
  return run(g, 1)
}
print(run(mk(4), 3))
print(bound(3))
print(run(5, 0))
