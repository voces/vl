// @run
// @log 1.5
// @log f32
// @log 6.75
// @log f64
// @log 4
// @log i64
// A numeric union delivered into a union box passes as its own box where no member widens; legacy
// re-boxes member by member only when one must (`emitNumUnionRebox`).
function kind<T>(v: T) {
  if v is i32 { return "i32" }
  if v is i64 { return "i64" }
  if v is f32 { return "f32" }
  if v is f64 { return "f64" }
  return "other"
}
function floats(q: f32 | null, r: f64 | null, b: f32) {
  print((q ?? (r ?? b)))
  print(kind((q ?? (r ?? b))))
}
function ints(q: i64 | null, b: i32) {
  print(q ?? b)
  print(kind(q ?? b))
}
floats(1.5, null, 0.5)
floats(null, 6.75, 0.5)
ints(4, 2)
