// @run
// @log 1
// @log hi
// @log true
// @log 7
// @log 9
// @log z
// A NAMED union variant (`type Outer = {…}` used as an arm) whose field's type is written as
// an INLINE SHAPE (`a: { b: boolean }`) rather than as a declared name.
//
// THE AXIS IS THE FIELD TYPE'S SPELLING — inline shape vs declared name — AND NOTHING ELSE.
// The two recorders that fill the variant-field table part on exactly that question and on
// no other. `collectU` is the FIRST emit pass, so the struct table does not exist yet, and an
// inline shape's only resolution (`structIndexOfTypeName`) needs it; a DECLARED name resolves
// off the arena instead (`nameIsStructDecl`), which does exist. So `fieldTypeCode` answered
// code 15 for `a: Inner` and -1 for `a: {b: i32}`, and the -1 was the floor. The INLINE-SHAPE
// ARM recorder (`{a: {b: i32}} | i32`, no `type` declaration) never had the floor: it carries
// its own intern-free acceptance check (`variantNestedShapeOk`) and defers the intern to
// `collectA`. The named-variant recorder now takes the same fallback, so the two spellings of
// one variant agree.
//
// DIMENSIONS MOVED, each measured as its own cell against the pre-fix compiler:
//   - field IDENTIFIERS: all-`v` and all-distinct both floored (the `v` spelling is not it);
//   - field-set CARDINALITY: 1 and 3 both floored (set size is not it);
//   - NESTING DEPTH: 2 and 3 both floored, and depth 3 lowers here;
//   - LEAF TYPE: i32 / string / boolean / f64 / `i32[]` / `{[string]: i32}` all floored, all
//     lower here (the floor was never about which leaf);
//   - ARM COUNT and the other arm's kind: `Outer | i32` and `A1 | B1` both floored;
//   - NULLABILITY of the shape field (`a: {b: i32} | null`) — floored, lowers here.
// DIMENSION HELD: the variant is reached through a `type` DECLARATION in every cell, because
// that IS the axis — the inline-arm spelling of each cell already worked before and after.
//
// THE NOMINAL CONTROL IS IN THIS FILE AND IT IS INVERTED: `Nom`'s field `n: Leaf` names a
// declared struct and has ALWAYS lowered. Reading the floor as "a struct-typed field on a
// union variant is unsupported" is what that control refutes — `Nom` is exactly that and it
// worked, so the collector's restriction was never about struct-typed fields at all.
//
// The residual floor this fix does NOT lift, and does not introduce: an inline shape whose
// field-name SET twins a DECLARED struct's (`type Inner = {b: i32}` beside `a: {b: i32}`)
// still reports `nested-struct field element type is not interned` — byte-for-byte the same
// verdict the INLINE-ARM spelling gives it, before this change and after. That is
// `internInlineShape`'s dedup, a separate seam; parity with the arm recorder is the claim
// here, not its repair.
type Outer = { n: i32, s: string, a: { b: boolean } }
type U = Outer | i32

type A1 = { p: { q: { r: i32 } } }
type B1 = { w: { y: string } }
type V = A1 | B1

type Leaf = { d: i32 }
type Nom = { n2: Leaf }
type W = Nom | i32

const u: U = { n: 1, s: "hi", a: { b: true } }
if u is Outer {
  print(u.n)
  print(u.s)
  print(u.a.b)
} else { print(0) }

const v1: V = { p: { q: { r: 7 } } }
if v1 is A1 { print(v1.p.q.r) } else { print(0) }

// The nominal control: a DECLARED-name field on a named variant, which never floored.
const w: W = { n2: { d: 9 } }
if w is Nom { print(w.n2.d) } else { print(0) }

const v2: V = { w: { y: "z" } }
if v2 is A1 { print(v2.p.q.r) } else if v2 is B1 { print(v2.w.y) } else { print(0) }
