// @emit-error cannot be discriminated
// The `same-field-names-different-types-reject.vl` rule, one COLUMN in: two variants
// whose map fields agree on the field NAME, the field CODE (19) and the map's VALUE
// (`string`), and differ only in the map's KEY REP.
//
// `variantFieldCodesEq` — the `collectU`-time half of the discrimination reject — decides
// "do these two variants STORE the same thing" from the field-code column plus the elem-NAME
// column. A map field records only its VALUE there, so before B6b's key column these two
// rows were byte-identical in everything the comparison could see, and the union was
// ACCEPTED. It should not have been: the two variants then rank identically, `b` builds
// `A`'s struct, and the `is B` read casts an i32-keyed map struct to the string-keyed one.
// Measured on the branch with the key comparison deleted: `vl check` rc 0, `vl run` a
// `wasm trap: cast failure` — a silent runtime trap, which is exactly the class this reject
// exists to convert into a message.
//
// It was unreachable until now only because an i32-keyed map could not BE a variant field.
type A = { f: {[i32]: string} }
type B = { f: {[string]: string} }
type U = A | B
function go() {
  const a: U = { f: Map() }
  if a is A {
    a.f[11] = "i"
    print(a.f[11] ?? "-")
  } else {
    print("notA")
  }
  const b: U = { f: Map() }
  if b is B {
    b.f["k"] = "s"
    print(b.f["k"] ?? "-")
  } else {
    print("notB")
  }
}
go()
