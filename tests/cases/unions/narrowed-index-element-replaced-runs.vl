// @run
// @log 5
// An element narrowed through an index place, then replaced by another arm and read: the read
// re-reads the element, as legacy's emitExpr(memObj) does, at the arm the assignment narrowed.
type A = { r: i32 }
type B = { r: i32, s: i32 }
type M = A | B
function f() {
  const xs: M[] = [{ r: 1 }]
  if xs[0] is A {
    xs[0] = { r: 5, s: 6 }
    print(xs[0].r)
  }
}
f()
