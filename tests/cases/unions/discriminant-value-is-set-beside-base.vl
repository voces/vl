// D1023's AMENDMENT (owner, 2026-09-02): a literal set beside its OWN BASE is a legal
// discriminated pair. `type A = { kind: "x" | "y" }` next to `type B = { kind: string }` is
// the overlapping-set case with B's set being the WHOLE base — so `v is A` asks whether
// `v.kind ∈ {"x","y"}`, `v is B` is true for every value of the shared shape, and `else`
// after `is A` narrows to B.
//
// THE ASYMMETRY IS THE POINT AND IT IS WHY BOTH DIRECTIONS ARE HERE. The lowering emits a
// membership compare only for the arm that HAS a set: `is A` is the tag test AND
// `kind == "x" || kind == "y"`, while `is B` is the tag test alone. A fixture that only built
// A values would score identically if `is A` were wrongly compiled to the bare tag test, so
// the `"z"` value — a B that is not an A — is the cell that actually grades the change.
//
// The un-annotated destination is graded beside the annotated one: an annotation pins a
// value's rep, so a fixture that annotates every destination cannot see a defect whose
// ingredient is inference doing the pinning instead.
//
// The numeric face is the same rule at the other base (`1 | 2` beside `i32`), and it is here
// because the compare is picked off the field's STORAGE — an `i32.eq` there where the string
// arm gets a string comparison.
// Both annotations are DECLARED rather than deleted: the annotated destination is one of the
// two spellings being graded, so removing it to silence the hint would delete the cell.
// @hint redundant type annotation: `av` is inferred as `A | B` — remove it to lean on inference
// @hint redundant type annotation: `bv` is inferred as `A | B` — remove it to lean on inference
// @run
// @log true
// @log true
// @log false
// @log true
// @log true
// @log true
// @log false
// @log true
// @log 1.5
// @log 25
// @log z
// @log true
// @log true
// @log false
// @log true

type A = { kind: "x" | "y", r: f64 }
type B = { kind: string, r: f64 }

function pick(n: i32): A | B {
  if n == 0 { return { kind: "x", r: 1.5 } }
  return { kind: "z", r: 2.5 }
}

// ANNOTATED destination, both directions.
const av: A | B = pick(0)
print(av is A)
print(av is B)
const bv: A | B = pick(1)
print(bv is A)
print(bv is B)

// UN-ANNOTATED destination — inference pins the rep, and the answers must not move.
const au = pick(0)
print(au is A)
print(au is B)
const bu = pick(1)
print(bu is A)
print(bu is B)

// `else` after `is A` narrows to B, and the B field is readable there.
if au is A { print(au.r) } else { print(au.r * 10.0) }
if bu is A { print(bu.r) } else { print(bu.r * 10.0) }
// the discriminant itself survives the narrowing
if bu is A { print("WRONG-ARM") } else { print(bu.kind) }

// The NUMERIC face: a numeric set beside its own base.
type N = { kind: 1 | 2, r: f64 }
type M = { kind: i32, r: f64 }
function pickN(n: i32): N | M {
  if n == 0 { return { kind: 1, r: 1.5 } }
  return { kind: 9, r: 2.5 }
}
const na = pickN(0)
print(na is N)
print(na is M)
const nb = pickN(1)
print(nb is N)
print(nb is M)
