// @run
// @log c
// @log c
// @log n
// A `K | L | null` box returned through a `string | null` result converts to that niche: the
// null tag is `null`, any other arm's payload is the string (D3382's return position, D3208).
type K = "a" | "b"
type L = "c" | "d"
function g(): K | L | null { return "c" }
function w(): string | null { return g() }
print(w() ?? "n")
const h: () => K | L | null = () => "c"
function v(): string | null { return h() }
print(v() ?? "n")
function z(): K | L | null { return null }
function y(): string | null { return z() }
print(y() ?? "n")
