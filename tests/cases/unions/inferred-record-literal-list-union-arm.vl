// @run
// @log 19
// @log 19
// @log 3
// @log 3
// An inferred `{x: i32}[] | i32[]` return whose record arm is a literal's anonymous row: the
// box names the shape, so either arm reads back out of a binding, a field, and a rewritten let.
function w(b: boolean) {
  if b { return [{ x: 19 }] }
  [1, 2, 3]
}
const p = w(true)
if p is i32[] { print(p.length) } else { print(p[0].x) }
const o = { f: w(true) }
if o.f is i32[] { print(o.f.length) } else { print(o.f[0].x) }
const q = w(false)
if q is i32[] { print(q[2]) } else { print(0) }
let r = w(true)
r = w(false)
if r is i32[] { print(r.length) } else { print(r[0].x) }
