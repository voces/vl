// @run
// A box delivered into a union declared by alias re-tags a member the alias holds only
// widened, exactly as the inline spelling does: `is` answers for the wide member (D3543).
type D = i64 | string
type F = f64 | string
type B = i64 | boolean
const s: i32 | string = 7
const d: D = s
print(d is i64)
print(d)
function f(x: F) {
  print(x is f64)
  print(x)
}
f(s)
const t: i32 | boolean = 9
function r(x: i32 | boolean): B { x }
const b = r(t)
print(b is i64)
print(b)
type R = { v: D }
const rr: R = { v: s }
print(rr.v is i64)
// @log true
// @log 7
// @log true
// @log 7
// @log true
// @log 9
// @log true
