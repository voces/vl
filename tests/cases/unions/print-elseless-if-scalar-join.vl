// @run
// @log 1
// @log null
// @log 1.5
// @log null
// @log 9000000000
// @log null
// @log 1
// @log 1
// @log 7
// D1767 — an else-less `if` joins its arm with `null`, and for the four scalars a declared
// `X | null` boxes, that join reps as the value-union box too. D1745's mint opens the union
// type block for an inferred `TyUnion` join; the `T | null` an else-less `if` records is a
// `TyNullable`, so it declined by construction. The inner rep is what decides: `string` and
// `boolean` are niches and stay on their own routes.

// 1/2 — the i32 arm, both arms taken. The null side is what says the box carries the join
// and not just its value.
const t = 1 > 0
const f = 1 < 0
print(if t { 1 })
print(if f { 1 })

// 3/4 — f64, both sides.
print(if t { 1.5 })
print(if f { 1.5 })

// 5/6 — i64, both sides.
print(if t { 9000000000 })
print(if f { 9000000000 })

// 7 — inside a function body, the second position the row's sweep found.
function h() { print(if t { 1 }) }
h()

// 8/9 — the bound spelling and its coalesce, which ran at both seeds and must keep running:
// they are what say the box is read back correctly, not merely minted.
const b = if t { 1 }
if b != null { print(b) } else { print(0) }
const b2 = if f { 1 }
print(b2 ?? 7)
