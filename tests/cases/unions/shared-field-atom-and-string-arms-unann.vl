// @run
// @log end
// @log b
// @log end
// @log true
// @log end
// @log b
// @log end-b
// @log zz
// @log b
// The un-annotated face of the shared field read by an atom arm and a string arm: an inferred
// return, an inferred binding and an interpolation deliver the read (D5105).
type N = { kind: "a" | "b", v: i32 } | { kind: "end" }
function g(n: N) { n.kind }
function mk(e: boolean): N {
  if e { return { kind: "end" } }
  { kind: "b", v: 1 }
}
const x = mk(true)
const y = mk(false)
print(g(x))
print(g(y))
const k = x.kind
print(k)
print(k == "end")
print(mk(true).kind)
print(mk(false).kind)
print("\{x.kind}-\{y.kind}")
type S = { kind: "a" | "b", v: i32 } | { kind: string, w: i32 }
function ms(z: boolean): S {
  if z { return { kind: "zz", w: 2 } }
  { kind: "b", v: 1 }
}
const sk = ms(true).kind
print(sk)
print(ms(false).kind)
