// @run
// @log A circle
// @log A round
// @log B:zz
// @log round
// @log circle
// @hint `A` is contained in `B`, so `is A` tests the value
// A literal-set field beside its string base, in arms another field keeps under two tags (D4056):
// a value built as `B` whose `kind` is in `K1` and whose `r` is an `i32` is an `A`.
type K1 = "circle" | "round"
type A = { kind: K1, r: i32 }
type B = { kind: string, r: i32 | string }
function f(n: i32): A | B {
  if n == 0 {
    const a: A = { kind: "circle", r: 1 }
    return a
  }
  if n == 1 {
    const b: B = { kind: "round", r: 2 }
    return b
  }
  const v: B = { kind: "zz", r: "s" }
  return v
}
let i = 0
while i < 3 {
  const x = f(i)
  if x is A { print("A " + x.kind) } else { print("B:" + x.kind) }
  i = i + 1
}
print(f(1).kind)
print(f(0).kind)
