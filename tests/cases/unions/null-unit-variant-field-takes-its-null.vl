// @run
// @log 3
// @log -4
// @log 5
// A record field of the `null` unit type holds its one value, given as `null` in a union arm's
// literal and as a name in a plain record's.
type A = { tag: i32, n: null }
type B = { tag: i32, s: string }
type U = A | B
type H = { n: null, k: i32 }
function mkA(t: i32): U { return { tag: t, n: null } }
function mkB(t: i32): U { return { tag: t, s: "b" } }
function mkH(k: i32): H {
  const z = null
  return { n: z, k: k }
}
function tagOf(u: U) {
  if u is A { return u.tag }
  return 0 - u.tag
}
print(tagOf(mkA(3)))
print(tagOf(mkB(4)))
print(mkH(5).k)
