// @run
// @log t
// @log t
// @log is a
// @log t
// @log i32
// @log t
// @log t
// @log 7
// @log 7
// @log b
// @log 5
// @hint Intentionally-unused parameter `_p`
// @hint Intentionally-unused parameter `_q`
// D15170: a generic parameter annotated with a type parameter beside a literal member is a union
// the instance registers, so a literal `is`, a type `is` and a `print` of it run at every binding,
// inline, through a one-member alias, and beside another generic's `T | AB`.
type AB = "a" | "b"
type A1 = "a"
function f<T>(p: T | "a" | "b") {
  if p is "a" { print("is a") } else { print("t") }
}
function one<T>(p: T | "a") {
  if p is "a" { print("is a") } else { print("t") }
}
function isI<T>(p: T | "a" | "b") {
  if p is i32 { print("i32") } else { print("t") }
}
function al<T>(p: T | A1) {
  if p is "a" { print("is a") } else { print("t") }
  print(p)
}
function g<T>(_p: T | AB, _q: T) {}
function pr<T>(p: T | "a" | "b") { print(p) }
function r<T>(x: T, bad: boolean): T | "err" {
  if bad { return "err" }
  x
}
f<i32>(7)
f(7)
f<i32>("a")
f<boolean>(true)
isI<i32>(7)
one<i32>(7)
g(5, 3)
al<i32>(7)
pr<i32>(7)
pr<i32>("b")
const v = r(5, false)
if v is "err" { print("e") } else { print(v) }
