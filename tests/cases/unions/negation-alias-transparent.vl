// @run
// @log 5
// @log 5
// @log 5
// @log 5
// @log 7

// D1773 — a `type` alias whose body is a NEGATION. `singleAliasMemberTyIx` walks the member's
// arena kind and had no `TyNeg` arm, so the alias was not transparent: it registered as a
// one-variant union and the cell became the union BOX while the value stayed a bare scalar —
// `vl check` rc 0 and `(global $global$0 (mut (ref $1)) (i32.const 5))`. A negation is a
// checker-only refinement with no rep of its own, so the alias denotes its member and the
// value keeps the rep its own type gives it. The INLINE spelling is the control.
type N = !string

// The module global, which is the row's own witness.
const x: N = 5
print(x)

// The inline spelling of the same type, which always ran.
const y: !string = 5
print(y)

// A global ASSIGNMENT into the alias-typed cell.
let z: N = 5
z = 5
print(z)

// The alias through a capture, whose env field takes the same rep.
function viaCapture() {
  const f = () => print(x)
  f()
}
viaCapture()

// The refinement is still a refinement: a non-string value of another width passes, and the
// alias is not silently collapsed to its negated operand.
const w: N = 7
print(w)
