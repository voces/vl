// @check
// @error is a NEGATION, which says what a value is not
// @error is a NEGATION, which says what a value is not
// A WRITTEN negation type is refused by the checker, in every annotation position, with one
// sentence (owner ruling, 2026-09-06). This file was the transparency fixture for the
// opposite behaviour — a `type N = !string` alias denoting its member so a binding kept its
// initializer's rep — and it is kept, re-spelled, because the positions it enumerates are
// exactly the ones the refusal has to reach. `x !is T` narrowing is untouched: there the
// "not T" is subtracted from a known union and is never written as a type.

// The alias body, where the negation is the alias's whole type.
type N = !string

// The alias used as a binding's type. The alias is reported ONCE, at its own body, and its
// uses do not re-report — `resolveAnnot` memoises on the spelling — so the two errors above
// are the alias body and the inline spelling below, not one per position.
const x: N = 5
print(x)

// The negation written inline at the binding.
const y: !string = 5
print(y)

// A `let` rather than a `const` — the same annotation position, the mutable cell.
let z: N = 5
z = 5
print(z)

// An intersection operand is the ONE place a written negation stays legal, since it is
// subtracted from the operand beside it and the annotation's own type is the positive
// remainder. This line must keep checking, and `tests/cases/types/intersection-annotation.vl`
// runs the same shape end to end.
const ok: (0 | 1 | 2) & !2 = 1
print(ok)
