// @run
// @log 7
// @log 7
// @log 4
// @log 4
// @log 9
// @log 2
// D1764 / D1765 — A `??` THAT JOINS TO THE UNION BOX IS THE BOX AT BOTH ENDS.
//
// Two ends, two defects, one shape. The RESULT NAME: an all-variant join (`A | B`) is the box,
// and the fused face named it through a producer that excludes an all-variant union by design,
// so the box arm declined and refused loudly. The CELL: the module-global kind ladder asks its
// niche rungs before its union rung, and those read the OPERAND alone — a `i32[] | null`
// operand took the list cell while the lowering built the box, check-clean invalid wasm.
//
// Every arm reads a field or a length, so a box tagged with the wrong arm cannot pass, and the
// module-scope and function-frame spellings are both here because only the module one was wrong.
type A = { r: i32 }
type B = { s: i32 }
type Sh = A | B

function nulSh(): Sh | null { return null }
function dfltA(): A { return { r: 7 } }
function nulList(): i32[] | null { return null }
function nulA(): A | null { return { r: 4 } }

// the RESULT NAME: a call operand over a nullable struct-union box, fused and bound
const fusedSh = nulSh() ?? dfltA()
if fusedSh is A { print(fusedSh.r) } else { print(0) }
const boundShLhs = nulSh()
const boundSh = boundShLhs ?? dfltA()
if boundSh is A { print(boundSh.r) } else { print(0) }

// the CELL: a nullable-collection operand joined with a nullable-variant default, at module
// scope, where the niche rungs used to claim the global before the union rung was asked
const boundListLhs = nulList()
const boundList = boundListLhs ?? nulA()
if boundList is A { print(boundList.r) } else { print(0) }
const fusedList = nulList() ?? nulA()
if fusedList is A { print(fusedList.r) } else { print(0) }

// the same join in a FUNCTION frame, which was already right and must stay right
function inFrame() {
  const v = nulList()
  const w = v ?? nulA()
  if w is A { print(w.r + 5) } else { print(0) }
}
inFrame()

// and the PRESENT path: the operand survives, so the list arm is what the join carries
function someList(): i32[] | null { return [1, 2] }
const present = someList() ?? nulA()
if present is i32[] { print(present.length) } else { print(0) }
