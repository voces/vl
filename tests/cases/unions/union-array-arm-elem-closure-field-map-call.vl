// @run
// @log ok
// `t0[0].f()` where `t0`'s union has a REF-ARRAY arm whose ELEMENT struct carries a
// CLOSURE field returning a map — the `calleeIsUnionElemFieldClosure` frame-pre-pass
// shape. NO corpus case reached that classifier before this one (the D-UNION member-set
// probe's sabotage leg fired on nothing until this program existed), so the arm test
// that reserves `callRefSlot` for the narrowed `call_ref` was untested here.
function useIt(p: {f: () => {[string]: string}}[] | f64) {
  const t0 = p
  if t0 is {f: () => {[string]: string}}[] {
    const m = t0[0].f()
    print(m["k"] ?? "no")
  } else {
    print(t0)
  }
}
function go() {
  const h: {[string]: string} = Map()
  h["k"] = "ok"
  useIt([{ f: () => h }])
}
go()
