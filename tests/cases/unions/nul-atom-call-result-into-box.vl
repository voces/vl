// @run
// @log N
// @log kb
// @log N
// @log kb
// @log 2
// @log N
// A `K | null` call result, which the callee hands back as the atom niche, delivered into a box
// that also holds an `i32` boxes the atom as its member string and `null` under the null tag
// (D12466): a list literal element, a scalar binding, a record field and a push.
type K = "ka" | "kb"
function kn(b: boolean): K | null {
  if b { return "kb" }
  return null
}
const xs: (K | null | i32)[] = [kn(false), kn(true)]
const v0 = xs[0]
if v0 == null { print("N") } else { print("other") }
const v1 = xs[1]
if v1 is "kb" { print("kb") } else { print("other") }
const b: K | null | i32 = kn(false)
if b == null { print("N") } else { print("other") }
type R = { v: K | null | i32 }
const r: R = { v: kn(true) }
if r.v is "kb" { print("kb") } else { print("other") }
const ys: (K | null | i32)[] = [3]
ys.push(kn(false))
print(ys.length)
const y1 = ys[1]
if y1 == null { print("N") } else { print("other") }
