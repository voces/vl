// @run
// @log 7
// @log 7
// @log 8
// @log x
// @log 1.5
// @log 9
// @log 10
// @log 11
// @log 12
// @log 13
// @log 0
// `x as! S` over a `S | null` where `S` is a standalone struct: `ref.as_non_null`, as for
// the string, list and variant niches (D1812). Each delivery is written un-annotated, where
// the binding takes its rep from the cast, and the first is also written annotated.
type Affix = { hi: i32, tag: string }
type Twin = { hi: i32, tag: string }
function affixById(id: i32): Affix | null {
  if id > 0 { return { hi: id, tag: "x" } }
  null
}

const annotated: Affix = affixById(7) as! Affix
print(annotated.hi)
const a = affixById(7) as! Affix
print(a.hi)
const t = affixById(8) as! Twin
print(t.hi)
print(t.tag)

function shape(): { q: f64 } | null { return { q: 1.5 } }
const s = shape() as! {q:f64}
print(s.q)

const list = [affixById(9) as! Affix]
print(list[0].hi)

function ret(): Affix { affixById(10) as! Affix }
print(ret().hi)

function frame() {
  const local = affixById(11) as! Affix
  print(local.hi)
  const read = () => {
    const inner = local
    print(inner.hi + 1)
  }
  read()
}
frame()

let assigned = affixById(1) as! Affix
assigned = affixById(13) as! Affix
print(assigned.hi)

// `as?` still keeps the null rather than trapping.
const missing = affixById(0) as? Affix
print(missing?.hi ?? 0)
