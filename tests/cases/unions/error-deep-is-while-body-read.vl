// @error cannot index non-array Json
// A LOOP CONDITION gives the boolean and NO narrowing, and that is the language's standing
// rule rather than anything deep `is` introduces: `checkWhileStmt` carries only NULL STRIPS
// into a loop body, never an `is T` variant pin, because a pin would reject the assignment
// that FLIPS the variant — and that is how a loop over a union terminates.
//
// The control is `unions/paren-is-narrow.vl`'s ordinary twin: `while x is Circle { x.r }`
// over a plain union is refused with `field 'r' is not on every member` today. This is the
// same refusal one type over, so the deep route MATCHES the language rather than extending
// it. The boolean half runs — `unions/deep-is-json-shape-walk.vl` §WHILE.
type Json = null | boolean | f64 | string | Json[] | { [string]: Json }
function d(r: Json): i32 {
  while r is string[] { return r[0].length }
  0
}
const l: Json = ["xyz"]
print(d(l))
