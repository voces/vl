// @run
// @hint redundant type annotation: `su` is inferred as `i32` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// @log false
// @log true
// @log false
// @log false
// @log true
// @log 7
// Structural `==` of records of a declared type that is also a union arm, at a nullable scalar
// field (D17112).
type J = { f: i32 | null, g: i32 }
function su(j: J | string): i32 { return if j is string { 0 } else { j.g } }
const a: J = { f: null, g: 7 }
const b: J = { f: 3, g: 7 }
const c: J = { f: 3, g: 7 }
const d: J = { f: 4, g: 7 }
const e: J = { f: null, g: 8 }
print(a == b)
print(b == c)
print(b == d)
print(a == e)
print(a != b)
print(su(a))
