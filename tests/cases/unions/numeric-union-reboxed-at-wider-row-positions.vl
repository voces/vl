// @run
// @log 1.5
// @log 2
// @log 3.5
// @log 4
// @log 5.5
// @hint redundant type annotation: `t` is inferred as `i32 | f32`
// @hint redundant type annotation: `t` is inferred as `i32 | f32`
// @hint redundant type annotation: `gt` is inferred as `i32 | f32`
// A numeric union stored in a record built at a wider record's row is re-boxed member by member
// (`i32` as `i64`, `f32` as `f64`) and read back rebuilt at its own members: bound, passed,
// returned, from a parameter and at the top level.
type D = { v: i64 | f64 }
function take(t: i32 | f32) { print(t) }
function annotated() {
  const x: i32 | f32 = 1.5
  const o = { v: x }
  const c: {[string]: D} = Map()
  c["k"] = o
  const t: i32 | f32 = o.v
  print(t)
}
function passed() {
  const x: i32 | f32 = 2
  const o = { v: x }
  const c: {[string]: D} = Map()
  c["k"] = o
  take(o.v)
}
function returned(): i32 | f32 {
  const x: i32 | f32 = 3.5
  const o = { v: x }
  const c: {[string]: D} = Map()
  c["k"] = o
  return o.v
}
function fromParam(x: i32 | f32) {
  const o = { v: x }
  const c: {[string]: D} = Map()
  c["k"] = o
  const t: i32 | f32 = o.v
  print(t)
}
annotated()
passed()
print(returned())
fromParam(4)
const gx: i32 | f32 = 5.5
const go = { v: gx }
const gc: {[string]: D} = Map()
gc["k"] = go
const gt: i32 | f32 = go.v
print(gt)
