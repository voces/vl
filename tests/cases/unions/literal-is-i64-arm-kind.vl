// @run
// @log yes
// @log no
// @log other
// A `v is <OUT-OF-i32-RANGE integer literal>` test over a mixed-rep value union
// (`i64 | string`). The `emitUnionLitIs` ladder's third arm: an integer lexeme that does
// not fit i32 settles the i64 atom, so the box tag compared is the i64 arm's and the
// payload unboxes through the i64 value box (`fbI64Const` + `i64.eq`).
//
// The sibling pin of `literal-is-f64-arm-kind.vl`, and the same hole: with that arm's rep
// CODE set to the i32 code, all 1,337 corpus files were byte-, message- and run-identical
// (sabotage S-LITISI64). Destringify D-LITISKIND made each arm's code separately
// perturbable for the first time — before it, the code came from re-parsing the arm's own
// spelling, so the arm and its code could not disagree and neither could be pinned alone.
const v: i64 | string = 5000000000
if v is 5000000000 { print("yes") } else { print("no") }

const w: i64 | string = 4000000000
if w is 5000000000 { print("yes") } else { print("no") }

const s: i64 | string = "s"
if s is 5000000000 { print("num") } else { print("other") }
