// @run
// @log 2
// @log 2
// @log true
// @log false
// @log call
// @log 2
// @log many
// @log 2
// @log 5
// @log none
// @log 1
// @log 1
// @log true
// @log false
// @log call
// @log 1
// @log one
// @log 1
// @log five
// @log none
type MI = { [string]: i32 }
type MS = { [string]: string }
function mk(k: i32): MI | MS | i32 {
  if k == 0 { return 0 }
  if k == 1 {
    const m: MI = Map()
    m["a"] = 5
    m["b"] = 6
    return m
  }
  const s: MS = Map()
  s["a"] = "five"
  return s
}
function id<T>(x: T): T { return x }
function pick(x: MI | MS): MI | MS { return x }
function loud<T>(x: T): T {
  print("call")
  return x
}
function g(a) {
  if a is i32 { return }
  print(id(a).length)
  print(pick(a).length)
  print(id(a).has("a"))
  print(id(a).has("z"))
  print(loud(a).length)
  const n = id(a).length
  if id(a).length > 1 { print("many") } else { print("one") }
  print(n)
  print(id(a)["a"] ?? "none")
  print(id(a)["z"] ?? "none")
}
g(mk(1))
g(mk(2))
