// @run
// @log 8
// @log 8
// @log 8
// @log 7
// @hint redundant type annotation: `xs` is inferred as `M[]` — remove it to lean on inference
// @hint redundant type annotation: `w` is inferred as `{xs: M[]}` — remove it to lean on inference
// A union cell narrowed by `if xs[0] is A` and then READ at that place, rather than through
// a binding of it. The narrowed-arm receiver ladder resolved a key for an `Ident` and a
// `Member` receiver only, so the box reached `struct.get` whole (D1719).
//
// Four receivers, because they key through different rungs and only the first is the row's
// own witness: a list element, its paren-wrapped spelling, a map value, and a list element
// under a struct field. The scalar arm is the control — it unboxed at this place already.
type A = { r: i32 }
type M = i32 | A
type W = { xs: M[] }
function st(): A { return { r: 8 } }
function pick(b: boolean): M {
  if b { return st() }
  return 7
}
const xs: M[] = [pick(true)]
if xs[0] is A { print(xs[0].r) } else { print(0) }
if (xs[0]) is A { print((xs[0]).r) } else { print(0) }
const m: { [string]: M } = Map()
m["k"] = pick(true)
if m["k"] is A { print(m["k"].r) } else { print(0) }
const w: W = { xs: [pick(false)] }
if w.xs[0] is i32 { print(w.xs[0]) } else { print(0) }
