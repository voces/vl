// @run
// @log s
// @log 4
// @log X
// @log Z
// Arms sharing field names, told apart by a literal discriminant and differing in another
// field's type (D3033): the discriminant narrows, and `is` answers by the value.
type X = { t: "x" | "y", a: i32 }
type Z = { t: "z", a: string }
type U = X | Z
const u: U = { t: "z", a: "s" }
if u.t == "z" { print(u.a) }
const w: U = { t: "y", a: 3 }
if w.t == "y" { print(w.a + 1) }
if w is X { print("X") } else { print("Z") }
if u is Z { print("Z") } else { print("X") }
