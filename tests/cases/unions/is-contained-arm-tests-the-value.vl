// @run
// @log B
// @log true
// @log false
// @log A
// @hint `B` is contained in `A`, so `is B` tests the value
// @hint `B` is contained in `A`, so `is B` tests the value
// @hint `B` is contained in `A`, so `is B` tests the value
// `is` tests whether the value fits the type (the owner's ruling on D3885): an `A` whose `x` is
// in `B`'s set tests as a `B`, so the checker hints that `B` is contained in `A`. Disjoint
// literal sets are a real discriminant and get no hint.
type A = { x: i32 }
type B = { x: 1 | 2 }
type C = { x: 3 | 4 }
function f(v: A | B) {
  if v is B { return "B" }
  "A"
}
const a: A = { x: 1 }
print(f(a))
const v: A | B = a
print(v is B)
const b: A = { x: 7 }
const w: A | B = b
print(w is B)
function g(v: C | B) {
  if v is B { return "B" }
  "A"
}
const c: C = { x: 3 }
print(g(c))
