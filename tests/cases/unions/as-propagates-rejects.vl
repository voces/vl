// @error names a type that is not a member
// @error cannot return
// @error annotate the enclosing function's return type
// @error at module scope
// @error cannot infer a return type
// THE FOUR WAYS `x as T` IS REFUSED, each with its own sentence, because they are four
// different mistakes and one message for all of them would name the wrong fix.
//
//   1. `as` names a type that is not an ARM. A cast to a type the value can never have is a
//      mistake, not a propagation — there is nothing to propagate TO.
//
//   2. The propagated REMAINDER does not fit the enclosing return. This is the rule that
//      makes the short form as total as the hand-written ladder: `as` early-returns the
//      remainder, so the function must be able to return it. The message names both types.
//
//   3. The enclosing return is INFERRED. Refused rather than joined into: a cast that
//      silently widens its own function's signature is the opposite of what an explicit cast
//      is for, and the annotation is one word. (`checkFnDeclNode` also reports its own
//      "cannot infer" for the same function; both point at the annotation.)
//
//   4. MODULE SCOPE — there is no enclosing function at all. Worth its own sentence because
//      the "enclosing function cannot return it" wording names a function that does not
//      exist; it used to render "it returns _". Here the remedy is a different spelling, not
//      a different annotation, so the message says `is`.
//
// The numeric `as` is untouched by all of this and is disjoint by OPERAND: a union is not
// `isNumeric`, so every program that compiled before takes the same arm it did. That
// disjointness is also the ruling's own no-migration argument — union-`as` was a clean compile
// error before, so all three trio spellings were unclaimed.
type IoError = { code: i32, msg: string }
function readIt(p: string): string | IoError {
  if p == "" { return { code: 44, msg: "missing" } }
  return "hello"
}

// 1 — not an arm
function notAnArm(p: string): string | IoError {
  const v = readIt(p) as! i32
  return "x"
}

// 2 — the remainder does not fit `string`
function noRoom(p: string): string {
  const v = readIt(p) as string
  return v
}

// 3 — the enclosing return is inferred
function inferred(p: string) {
  const v = readIt(p) as string
  return v
}

// 4 — module scope
const top = readIt("a") as string
print(top)
