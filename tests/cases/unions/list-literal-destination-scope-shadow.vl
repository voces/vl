// @run
// @log 1
// @log 0
// @log 7
// Both annotations are DECLARED redundant rather than deleted: `cS` is the kind-1
// destination and `cI` is what makes `inner`'s parameter a rebinding of the name, i.e. the
// two coordinates this fixture exists to hold. Removing either removes the defect.
// @hint redundant type annotation: `cS` is inferred as `{r: i32}[]`
// @hint redundant type annotation: `cI` is inferred as `Shape[]`
// A SHADOWING LOCAL AND ITS GLOBAL ARE TWO BINDINGS, AND A NESTED FRAME REBINDS (D661).
//
// Expected output, derived rather than recorded: the module-level list holds one element so
// `gU.length` is `1`; `inner` is called with an EMPTY list so its guard takes the else arm
// and prints `0`; `fs`'s own list holds `{r: 7}` so the last line is `7`.
//
// Three scopes, three `lv1`s, one declared destination each — the two halves of the scope
// rule the whole-arena NAME scan could not state.
//
//   · the module-level `lv1` is delivered to the union-box map value. Its scope is the
//     module ROOT, and the walk must not enter `fs`, which declares its own `lv1`.
//   · `fs`'s local `lv1` SHADOWS it and is delivered to `Circle[]`. Its scope is `fs`'s
//     body, so the module-level map store is not its destination.
//   · `inner`'s PARAMETER `lv1` shadows `outer`'s local. A shadow test built only on
//     `parentLetOf` cannot see a parameter, and the walk would attribute `inner`'s
//     `Shape[]` binding to `outer`'s literal.
//
// All three were the D411 emit reject on master. Ablated: the module-scope arm is worth 48
// cells of the D661 grid and every one of them ALSO needs the local arm — the two scopes
// are one landing, because a cell is only correct once BOTH of its bindings are scoped.
// The parameter arm is worth exactly one cell here and is the second of the two binding
// forms a function introduces.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
const lv1 = [{ r: 7 }]
const mU: {[string]: Shape[]} = Map()
mU["k"] = lv1
const gU = mU["k"] ?? []
function fs() {
  const lv1 = [{ r: 7 }]
  const cS: Circle[] = lv1
  function inner(lv1: Shape[]) {
    const cI: Shape[] = lv1
    if cI.length > 0 { print(0) } else { print(0) }
  }
  inner([])
  if cS.length > 0 { print(cS[0].r) } else { print(0) }
}
if gU.length > 0 { print(gU.length) } else { print(0) }
fs()
