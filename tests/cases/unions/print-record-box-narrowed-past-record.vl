// @run
// @hint redundant type annotation: `r7` is inferred as `{x: i32}`
// @log 5
// @log null
// @log 5
// @log null
// @log 7
// @log 5
// @log null
// @log null
// @log 3
// @log z
// @log s
// A `Rec | i32 | null` value narrowed past its record arm (the `else` of `is Rec`) prints from the
// arms it can still hold: the plan declined the whole box for its record arm, and the read
// reached `__print_i32__` as the box (D3231). A box an `is` chain narrows to `null` plans
// without its record arm, and a list arm narrowed away no longer refuses the dispatch (D2885).
type Rec = { x: i32 }
const a: Rec | i32 | null = 5
if a is Rec { print(a.x) } else { print(a) }
const b: Rec | i32 | null = null
if b is Rec { print(b.x) } else { print(b) }
function f(v: Rec | i32 | null) {
  if v is Rec { print(v.x) } else { print(v) }
}
f(5)
f(null)
f({ x: 7 })
function F<A, B>(k: i32, a: A, b: B): A | B | null {
  if k == 0 { a }
  else if k == 1 { b }
  else { null }
}
const r7: Rec = { x: 7 }
const c = F(0, 5, r7)
if c is Rec { print(c.x) } else { print(c) }
const d = F(2, 5, r7)
if d is Rec { print(d.x) } else { print(d) }
function g(v: Rec | i32 | null) {
  if v is Rec { print(v.x) }
  else if v is i32 { print(v) }
  else { print(v) }
}
g(null)
g(3)
const z: f64[] | string | boolean = "z"
if z is f64[] { print(1) } else { print(z) }
type A = { v: i32 }
function H(o: { h: A | i32 | string }) {
  if o.h is A { print(o.h.v) } else { print(o.h) }
}
const x: { h: A | i32 | string } = { h: "s" }
H(x)
