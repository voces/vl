// @run
// @log 7n -1s -1n
// @log 7n -1s -1n
// @log 14
// @log cs
// @log <s>
// @log 7n -1s -1n
// @log 7n -1s -1n
// @log 7n -1s -1n
// @log 7n -5s -5n
// @log 7n -1s -1n
// A cast over a boxed `T | null` union reads the null as a box carrying the null tag, so the tag
// test fails every arm on it: a hit, a wrong arm and a null in each position a cast's value goes,
// each tagged by its string cast (`n` for none) so the null reads apart from the wrong arm.
type U = i32 | string | null
function mk(k: i32): U {
  if k == 0 { return 7 }
  if k == 1 { return "s" }
  return null
}
function sN(x: i32 | null) { return if x == null { -1 } else { x } }
function takeI(x: i32) { return x * 2 }
function idN(x: i32 | null) { return x }
function argUnion(u: U) { return sN(u as? i32) }
function argNested(u: U) { return sN(idN(u as? i32)) }
function argScalar(u: U) { return takeI(u as! i32) }
function concat(u: U) { return "c" + (u as! string) }
function hole(u: U) { return "<\{u as! string}>" }
function ret(u: U): i32 | null { return u as? i32 }
function letInit(u: U) {
  const x = u as? i32
  return sN(x)
}
function ifArm(u: U, f: boolean) {
  const x = if f { u as? i32 } else { null }
  return sN(x)
}
function coalesce(u: U) { return (u as? i32) ?? -5 }
function recField(u: U) {
  const r = { a: u as? i32 }
  return sN(r.a)
}
function tag(u: U) { return (u as? string) ?? "n" }
function three(f: (u: U) => i32) {
  print(
    "\{f(mk(0))}\{tag(mk(0))} \{f(mk(1))}\{tag(mk(1))} \{f(mk(2))}\{tag(mk(2))}",
  )
}
three(argUnion)
three(argNested)
print(argScalar(mk(0)))
print(concat(mk(1)))
print(hole(mk(1)))
three((u: U): i32 => sN(ret(u)))
three(letInit)
three((u: U): i32 => ifArm(u, true))
three(coalesce)
three(recField)
