// @run
// @log 1
// @log 2
// @log 1071
// @log 2072
// A valued `if` whose arms are one variant of a union, passed where the union is expected, boxes
// the join as that variant: the tag, then the `if`, then the box. An earlier argument that is
// itself a valued `if` is written first.
type OVar = { ov: i32 }
type OImm = { oiRep: i32, oiBits: i64 }
type Opnd = OVar | OImm
function num(o: Opnd): i32 {
  if o is OVar { return o.ov }
  return 100 + o.oiRep
}
function show(op: string, i: i32, o: Opnd): i32 {
  const k = if op == "gt" { 1000 } else { 2000 }
  return k + i * 10 + num(o)
}
function local(n: i32): OVar { return { ov: n } }
function pick(w: i32): i32 {
  const a = local(1)
  const b = local(2)
  return num(if w == 4 { a } else { b })
}
function test(w: i32, i: i32): i32 {
  const lim = local(1)
  const n = local(2)
  return show(if w == 4 { "gt" } else { "ge" }, i, if w == 4 { lim } else { n })
}
print(pick(4))
print(pick(3))
print(test(4, 7))
print(test(1, 7))
