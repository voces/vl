// @run
// @hint redundant type annotation: `side` is inferred as `boolean`
// @hint redundant type annotation: `inner` is inferred as `boolean`
// @log L1
// @log R1
// @log and
// @log L2
// @log R2
// @log or
// @log L3
// @log skipped
// @log W
// @log W
// @log 2
// @log F
// @log b
// @log X
// @log b
// @log L4
// @log R4
// @log true
// @log L5
// @log true
// @log S
// @log b
// @log L6
// @log R6
// @log true
// @log L7
// @log R7
// @log true
// `?.` over a call receiver behind `&&`, `||`, a `while` condition and a place assignment:
// the receiver runs once, in source order, and only when the left operand lets it (D5331).
type N = { tag: "a", v: i32 } | { tag: "b", w: i32 }
type W = { f: "a" | "b" | null }
function mk(t: string): N | null {
  print(t)
  { tag: "b", w: 2 }
}
function side(t: string): boolean {
  print(t)
  true
}
if side("L1") && (mk("R1")?.tag ?? "z") == "b" { print("and") }
if !side("L2") || (mk("R2")?.tag ?? "z") == "b" { print("or") }
if !side("L3") && (mk("R3")?.tag ?? "z") == "b" {
  print("x")
} else {
  print("skipped")
}
let n = 0
while n < 2 && (mk("W")?.tag ?? "z") == "b" { n = n + 1 }
print(n)
const w: W = { f: null }
w.f = mk("F")?.tag
print(w.f ?? "z")
const xs: ("a" | "b" | null)[] = [null]
xs[0] = mk("X")?.tag
print(xs[0] ?? "z")
const c = side("L4") && (mk("R4")?.tag ?? "z") == "b"
print(c)
const d = side("L5") || (mk("R5")?.tag ?? "z") == "b"
print(d)
let s: "a" | "b" | null = null
s = mk("S")?.tag
print(s ?? "z")
function inner(): boolean { side("L6") && (mk("R6")?.tag ?? "z") == "b" }
print(inner())
const g = () => side("L7") && (mk("R7")?.tag ?? "z") == "b"
print(g())
