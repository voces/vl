// @run
// @log null
// @log null
// @log null
// @log s
// @log 3
// A `Rec | string | null` box an `is` chain narrows to `null` prints from its tag: with the record
// arm left out of the plan only `string | null` remained, which alone is a niche, so the plan
// declined the box and it reached `__print_i32__` (D3500).
type Rec = { x: i32 }
const v: Rec | string | null = null
if v is Rec { print(v.x) }
else if v is string { print(v) }
else { print(v) }
if v is string { print(v) }
else if v is Rec { print(v.x) }
else { print(v) }
function f(p: Rec | string | null) {
  if p is Rec { print(p.x) }
  else if p is string { print(p) }
  else { print(p) }
}
f(null)
f("s")
f({ x: 3 })
