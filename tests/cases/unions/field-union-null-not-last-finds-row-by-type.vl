// @run
// @log true
// @log 7
// @log s
// @log true
// @log 9
// A declared record field typed `Circle | null | string`, `null` not spelled last, codes as the
// union box: its field code asks the row by the field's type, which keys alike in every member
// order (D3138).
type Circle = { r: i32 }
type H = { f: Circle | null | string }
const h: H = { f: { r: 7 } }
print(h.f is Circle)
const f = h.f
if f is Circle { print(f.r) }
const g: H = { f: "s" }
const gf = g.f
if gf is string { print(gf) }
const n: H = { f: null }
print(n.f == null)
function mk(): H { { f: { r: 9 } } }
const m = mk().f
if m is Circle { print(m.r) }
