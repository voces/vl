// @run
// @log 4
// @log true
// @log 1
// @log 4
// @log 4
// @log 4
// @log 1.5
// @log 4
// @log 4
// @log 4
// @log 4
// @log 4
// @log 9
// @log 4
// @hint redundant type annotation: `r` is inferred as `i32[]`
// D2857: the value of `as!` (and of a propagating `as`) to a nested-list arm is read in place,
// indexed, measured and iterated with no binding, and delivered at every destination, at its
// own element row.
function nb(c: boolean): boolean[][] | i32[][] {
  if c { return [[true]] }
  [[4]]
}
print((nb(false) as! i32[][])[0][0])
print((nb(true) as! boolean[][])[0][0])
print((nb(false) as! i32[][]).length)
const r: i32[] = (nb(false) as! i32[][])[0]
print(r[0])
const a: i32[][] = nb(false) as! i32[][]
print(a[0][0])
for row in nb(false) as! i32[][] { print(row[0]) }
function nf(c: boolean): f64[][] | string[][] {
  if c { return [[1.5]] }
  [["x"]]
}
print((nf(true) as! f64[][])[0][0])
type Box = { rows: i32[][] }
function head(xs: i32[][]) { xs[0][0] }
function pass(): i32[][] { nb(false) as! i32[][] }
print(head(nb(false) as! i32[][]))
print(pass()[0][0])
const bx: Box = { rows: nb(false) as! i32[][] }
print(bx.rows[0][0])
let g: i32[][] = []
g = nb(false) as! i32[][]
print(g[0][0])
const u = nb(false) as! i32[][]
print(u[0][0])
const both = [nb(false) as! i32[][], [[5]]]
print(both[1][0][0] + both[0][0][0])
function viaAs(): boolean[][] | i32 {
  const v = (nb(false) as i32[][])[0][0]
  v
}
const va = viaAs()
if va is i32 { print(va) }
