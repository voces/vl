// @run
// @hint redundant type annotation: `f` is inferred as `f64`
// A `(0 | 1) | null` field through `?.`, defaulted to an f64, on both receivers.
// The literal type takes its base atom's rep, which the result follows.
type P = { v: (0 | 1) | null }
function f(p: P | null): f64 { return p?.v ?? 2.5 }
print(f({ v: 1 }))
print(f(null))
// @log 1
// @log 2.5
