function f_loop_coal(a) {
  let t = null
  let i = 0
  while i < a {
    if i == 7 { t = a }
    i = i + 1
  }
  print(t ?? -1)
}
f_loop_coal(1)
f_loop_coal(9)
function f_loop_eqnull(a) {
  let t = null
  let i = 0
  while i < a {
    if i == 7 { t = a }
    i = i + 1
  }
  print(t == null)
}
