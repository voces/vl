// A `let x = null` a hole parameter fills, written under an `if`, an `else`, a loop, a `match`
// arm, unconditionally or not at all, read by `print`, `??`, `== null`, a caller and an
// annotated store: each read takes the instance's `T | null` (D17850, D17846).
function f_always_coal(a) {
  let t = null
  t = a
  print(t ?? -1)
}
f_always_coal(1)
f_always_coal(9)
function f_always_eqnull(a) {
  let t = null
  t = a
  print(t == null)
}
f_always_eqnull(1)
f_always_eqnull(9)
function f_always_print(a) {
  let t = null
  t = a
  print(t)
}
f_always_print(1)
f_always_print(9)
function f_always_ret(a) {
  let t = null
  t = a
  return t
}
print(f_always_ret(1))
print(f_always_ret(1) == null)
print(f_always_ret(9))
print(f_always_ret(9) == null)
function f_always_store(a) {
  let t = null
  t = a
  return t
}
const x_always_store_1: i32 | null = f_always_store(1)
print(x_always_store_1)
const x_always_store_9: i32 | null = f_always_store(9)
print(x_always_store_9)
function f_else_coal(a) {
  let t = null
  if a < 5 {} else { t = a }
  print(t ?? -1)
}
f_else_coal(1)
f_else_coal(9)
function f_else_eqnull(a) {
  let t = null
  if a < 5 {} else { t = a }
