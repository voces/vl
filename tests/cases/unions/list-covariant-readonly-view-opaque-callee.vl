// @run
// @log 1
// @hint redundant type annotation: `a` is inferred as `{r: i32}[]` — remove it to lean on inference
// @hint Intentionally-unused function `__other` (leading `_` marks it unused)
// THE HINT IS DECLARED, NOT REMOVED: `const a: Circle[]` is the covariant source, so
// deleting the annotation deletes what this fixture pins.
// D1687's shape with the receiving parameter declared as a VIEW. `fn` is a function-typed
// parameter, so no one parameter list answers for it and the closure could not follow the
// value into the body; declaring `xs` a `readonly Shape[]` means the value never enters that
// body as a writable handle, and the walk ends at the argument edge.
//
// `__other` is the ingredient that makes the rep-scoped scan say "written"; it stays, so
// the licence being pinned is the view's and not an empty write set.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function __other() {
  const w: Shape[] = []
  w.push({ s: 3 })
  print(w.length)
}
function apply(fn: (readonly Shape[]) => void, xs: readonly Shape[]) { fn(xs) }
function f() {
  const a: Circle[] = [{ r: 7 }]
  const b: Shape[] = a
  const take = (ys: readonly Shape[]): void => {
    print(ys.length)
  }
  apply(take, b)
}
f()
