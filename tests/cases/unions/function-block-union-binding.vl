// @run
// @log 7
// @log 8
// @log 1
// @log 7
// @log 7
// @log 7
// @log true
// @log hi
// @log 1.5
// @log 9
// @log 7
// @log 7
// @log 7
// @log 7
// @log 2
// THE CONTROL for `tests/cases/unions/module-block-union-binding.vl`, and the one
// that MUST pass on both sides of that fix: the identical bodies, cell for cell,
// with the ONLY variable changed being the SCOPE — every binding here lives inside
// a `function`, where `parentLetOf` has always resolved it. These cells have always
// printed these values; they are here so a future change to the module-scope leg
// cannot "fix" module scope by breaking function scope, and so the pair documents
// that neither the closure nor the `| null` that the bug was originally filed with
// is an ingredient.

function idf(x: i32) { return x }
function g(): i32 | boolean { return 7 }
// An opaque `false` — a literal one makes the else-arm cell a never-taken branch.
function no() { return false }

function positions() {
  const u: i32 | boolean = 7
  if true {
    const r = u
    if r is i32 { print(r) } // 7
  }
  if true {
    const r = u
    if r is i32 { print(r + 1) } // 8
  }
  if true {
    const r = u
    if r is i32 {
      if r == 7 { print(1) } // 1
    }
  }
  if true {
    let r = u
    r = g()
    if r is i32 { print(r) } // 7
  }
  if true {
    const r = u
    if r is i32 { print(idf(r)) } // 7
  }
  if true {
    const r = u
    let out = 0
    if r is i32 { out = r }
    print(out) // 7
  }
}
positions()

function arms() {
  const ub: boolean | i32 = true
  if true {
    const r = ub
    if r is boolean { print(r) } // true
  }
  const us: string | i32 = "hi"
  if true {
    const r = us
    if r is string { print(r) } // hi
  }
  const uf: f64 | boolean = 1.5
  if true {
    const r = uf
    if r is f64 { print(r) } // 1.5
  }
  const ul: i64 | boolean = 9
  if true {
    const r = ul
    if r is i64 { print(r) } // 9
  }
}
arms()

function callInit() {
  if true {
    const r = g()
    if r is i32 { print(r) } // 7
  }
}
callInit()

function blocks() {
  const u: i32 | boolean = 7
  let n = 0
  while n < 1 {
    const r = u
    if r is i32 { print(r) } // 7
    n = n + 1
  }
  if no() {
    print(0)
  } else {
    const r = u
    if r is i32 { print(r) } // 7
  }
  if true {
    if true {
      const r = u
      if r is i32 { print(r) } // 7
    }
  }
}
blocks()

function refArray() {
  const ua: i32[] | boolean = [1, 2]
  if true {
    const r = ua
    if r is i32[] { print(r.length) } // 2
  }
}
refArray()
