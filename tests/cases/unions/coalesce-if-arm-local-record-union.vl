// @run
// @info `live` is never reassigned; use `const` instead of `let`
// @hint redundant type annotation: `a` is inferred as `string`
// @hint redundant type annotation: `ret` is inferred as `string`
// @log b
// @log b
// @log b
// @log n
// @log b
// @log 3
// @log hi
// @log 3
// @log -1
// `??` over an `if` whose arm declares a local and ends in that local's field read or `?.`,
// as an argument, a binding, a return and in a lambda (D5333). A plain record's `?.` ending
// an arm or a function body is a value too.
type N = { tag: "a", v: i32, k: string | null }
  | { tag: "b", w: i32, k: string | null }
type S = { v: i32, s: string }
function mk(): N | null { { tag: "b", w: 2, k: null } }
function none(): N | null { null }
let live = true
function ms(): S | null { { v: 3, s: "hi" } }
print(
  (if live { const r = mk(); if r != null { r.tag } else { null } } else { null })
    ?? "z",
)
const a: string = (if live { const r = mk(); r?.tag } else { null }) ?? "z"
print(a)
{
  const a2 = (if live { const r = mk(); r?.tag } else { null }) ?? "z"
  print(a2)
}
{
  const b = if live { const r = none(); r?.tag } else { null }
  print(b ?? "n")
}
function ret(): string {
  (if live { const r = mk(); r?.tag } else { null }) ?? "r"
}
print(ret())
const f = () => (if live { const t = ms(); t?.v } else { null }) ?? 0
print(f())
{
  const e = if live { const t = ms(); t?.s } else { null }
  print(e ?? "")
}
function tail(x: S | null) { x?.v }
print(tail(ms()) ?? 0)
print(tail(null) ?? -1)
