// @run
// A `!=` on a literal discriminant narrows both branches as the `==` test's else and then arms
// do, at inline arms (where no `is` rescue exists) and with two survivors (D1486).
type Shape = { kind: "circle", r: f64 } | { kind: "rect", w: f64, h: f64 }
function a(s: Shape) {
  if s.kind != "rect" { return s.r }
  return s.h
}
function b(s: Shape) {
  if s.kind != "circle" { return s.h } else { return s.r }
}
type Circle = { kind: "circle", r: f64 }
type Rect = { kind: "rect", w: f64, h: f64 }
type Tri = { kind: "tri", b: f64, h: f64 }
type Fig = Circle | Rect | Tri
function c(s: Fig) {
  if s.kind != "circle" { return s.h }
  return s.r
}
print(a({ kind: "rect", w: 2.0, h: 3.0 }))
print(a({ kind: "circle", r: 1.5 }))
print(b({ kind: "rect", w: 2.0, h: 3.0 }))
print(b({ kind: "circle", r: 1.5 }))
print(c({ kind: "tri", b: 4.0, h: 5.0 }))
print(c({ kind: "circle", r: 1.5 }))
// @log 3
// @log 1.5
// @log 3
// @log 1.5
// @log 5
// @log 1.5
