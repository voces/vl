// @run
// @log 5
// @log nothing
// @log 5
// @log none
// @log 5
// @log 5
// @log none
// @log five
// @log nothing
// @log five
// @log none
// @log five
// @log five
// @log none
// A union of scalar-valued maps read by `get` inside a hole function: each arm's read is the
// probe's own box at its value's kind, delivered at an annotated `let`, an argument, a return, a
// record field and a list element, key present and missing.
type MI = { [string]: i32 }
type MS = { [string]: string }
function mk(k: i32): MI | MS | i32 {
  if k == 0 { return 0 }
  if k == 1 {
    const m: MI = Map()
    m["a"] = 5
    return m
  }
  const s: MS = Map()
  s["a"] = "five"
  return s
}
function id<T>(x: T): T { return x }
function show(v: i32 | string | null) { print(v ?? "nothing") }
function ret(a: MI | MS, k: string): i32 | string | null { return id(a).get(k) }
function g(a) {
  if a is i32 { return }
  const v: i32 | string | null = id(a).get("a")
  print(v ?? "none")
  show(id(a).get("z"))
  print(ret(a, "a") ?? "none")
  print(ret(a, "z") ?? "none")
  const r = { v: id(a).get("a") }
  print(r.v ?? "none")
  const l = [id(a).get("a"), id(a).get("z")]
  print(l[0] ?? "none")
  print(l[1] ?? "none")
}
g(mk(1))
g(mk(2))
