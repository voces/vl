// @log 3
// A `for` over a union of lists read through a hole parameter: each pin binds the loop variable
// at the element union, and its instance walks whichever list arm the box holds.
function sum(a) {
  let t = 0
  for v in a {
    if v is i32 { t += v } else if v is string { t += v.length } else { t += 100 }
  }
  return t
}
function idx(a) {
  let n = 0
  for v, i in a { n += i }
  return n
}
function nest(a) {
  let c = 0
  for x in a {
    for y in a { c += 1 }
  }
  return c
}
function br(a) {
  let k = 0
  for v in a {
    if k == 2 { break }
    k += 1
    if k == 1 { continue }
  }
  return k
}
function cnt(a) {
  let c = 0
  for v in a {
    if v == null { c += 10 } else { c += 1 }
  }
  return c
}
function cap(a) {
  const fs: (() => i32)[] = []
  for v, i in a { fs.push(() => i) }
  let t = 0
  for f in fs { t += f() }
  return t
}
const p: i32[] | string[] = [1, 2, 3]
const q: i32[] | string[] = ["ab", "c"]
const r: boolean[] | f64[] = [true, false]
print(sum(p))
print(sum(q))
print(sum(r))
print(idx(p))
print(nest(q))
print(br(p))
const n1: (string | null)[] | i32[] = ["a", null, "b"]
print(cnt(n1))
const c1: i32[] | string[] = ["x", "y", "z"]
print(cap(c1))
function mk(k: i32): i32[][] | f64[][] {
  if k == 0 {
    const b: f64[][] = [[1.5]]
    return b
  }
  const a: i32[][] = [[1, 7], [2]]
  return a
}
function take(a) {
  let n = 0
  for e in a { n = n + e.length }
  return n
}
print(take(mk(1)))
