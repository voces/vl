// @error `.push()` writes the list
// CONTRACT (must-error): the writing twin of the two view fixtures beside this one. The
// view licenses the covariant copy precisely because no write can reach it, so the same
// program with a write in the callee's body must not print a value — if it ever does, the
// copy has become observable and the licence is wrong.
//
// A VERDICT pin: the program must not type-check, so there is no run to compare against.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function __other() {
  const w: Shape[] = []
  w.push({ s: 3 })
  print(w.length)
}
function apply(fn: (readonly Shape[]) => void, xs: readonly Shape[]) { fn(xs) }
function f() {
  const a: Circle[] = [{ r: 7 }]
  const b: Shape[] = a
  const take = (ys: readonly Shape[]): void => {
    ys.push({ s: 1 })
  }
  apply(take, b)
}
f()
