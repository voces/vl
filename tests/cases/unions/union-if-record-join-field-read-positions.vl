// @run
// A field read straight off a value `if` over a union `is` test whose arms are records, and a
// join whose record arm comes first and narrowed arm second: at module scope and in functions, an
// `i32` and a `string` field, an `else if` chain, and each scalar field printed. Each reads the
// record's row the join is built at.
type P = { x: i32 }
type Q = { y: string }
type R = { x: i32, s: string }
function mk(b: boolean): P | Q {
  if b { return { x: 4 } }
  return { y: "q" }
}
const v = mk(true)
const q = if v is P { v } else { { x: 9 } }
print(q.x)
print((if v is P { v } else { { x: 9 } }).x)
const w = mk(false)
print((if w is Q { { x: 12 } } else { w }).x)
function direct(u: P | Q) { return (if u is P { u } else { { x: 1 } }).x + 100 }
print(direct(v))
print(direct(w))
function strField(u: R | Q) {
  return (if u is R { u } else { { x: 0, s: "dflt" } }).s
}
print(strField({ x: 1, s: "own" }))
print(strField({ y: "z" }))
function chained(u: P | Q, d: i32) {
  return (if u is P { u } else if d > 0 { { x: d } } else { { x: -2 } }).x
}
print(chained(w, 6))
print(chained(w, 0))
type F = { k: "f", x: f64, y: i64, ok: boolean, s: string }
type G = { k: "g" }
function printed(u: F | G, d: F) {
  print((if u is F { u } else { d }).x)
  print((if u is F { u } else { d }).y)
  print((if u is F { u } else { d }).ok)
  print((if u is F { u } else { d }).s)
}
printed(
  { k: "f", x: 1.5, y: 9000000000, ok: true, s: "fs" },
  { k: "f", x: 0.0, y: 0, ok: false, s: "" },
)
printed({ k: "g" }, { k: "f", x: 2.5, y: 7, ok: false, s: "dflt" })
// @log 4
// @log 4
// @log 12
// @log 104
// @log 101
// @log own
// @log dflt
// @log 6
// @log -2
