// D13280: a field every record of a union stores as one `scalar | null` box reads as that box
// through `?.`, a plain read, a binding, an argument, a list element, a nested field, a call
// result, a widening default, an `f64` field, a hole receiver, and a non-null box union field.
type A = { k: i32 | null, x: i32 }
type B = { k: i32 | null, y: string }
function F(u: A | B | null) {
  const r = u?.k
  print(r ?? -1)
}
const a: A | B | null = { k: 3, x: 1 }
const b: A | B | null = null
F(a)
F(b)

function P(u: A | B) { print(u.k) }
P({ k: 3, x: 1 })
P({ k: null, y: "s" })

function G(v: i32 | null) { print(v ?? -1) }
function Q(u: A | B) { G(u.k) }
Q({ k: 3, x: 1 })
Q({ k: null, y: "s" })

function R(u: A | B) {
  const r = u.k
  print(r ?? -1)
}
R({ k: 3, x: 1 })
R({ k: null, y: "s" })

function S(xs: (A | B)[]) {
  for e in xs { print(e.k ?? -2) }
}
S([{ k: 3, x: 1 }, { k: null, y: "s" }])

type H = { u: A | B }
function T(h: H) { print(h.u.k ?? -1) }
T({ u: { k: 3, x: 1 } })
T({ u: { k: null, y: "s" } })

function mk(i: i32): A | B {
  if i > 0 { return { k: i, x: 1 } }
  return { k: null, y: "s" }
}
print(mk(3).k ?? -1)
print(mk(0).k ?? -1)

function U(u: A | B) { print(u.k ?? 2.5) }
U({ k: 3, x: 1 })
U({ k: null, y: "s" })

type C = { k: f64 | null, x: i32 }
type D = { k: f64 | null, y: string }
function V(u: C | D) { print(u.k ?? 0.5) }
V({ k: 3.5, x: 1 })
V({ k: null, y: "s" })

function X(u) {
  const r = u?.k
  print(r ?? -1)
}
X(a)
X(b)

function Y(u) { print(u.k ?? -1) }
const e: A | B = { k: 3, x: 1 }
const f: A | B = { k: null, y: "s" }
Y(e)
Y(f)

type I = { k: i32 | string, x: i32 }
type J = { k: i32 | string, y: string }
function Z(xs: (I | J)[]) {
  for v in xs { print(v.k) }
}
Z([{ k: 3, x: 1 }, { k: "n", y: "s" }])
function W(u) { print(u.k) }
const g: I | J = { k: 3, x: 1 }
const h: I | J = { k: "n", y: "s" }
W(g)
W(h)
