// @run
// @log true
// @log true
// @log false
// @log true
// @log true
// @hint redundant type annotation: `a` is inferred as `Circle | null`
// @hint redundant type annotation: `b` is inferred as `Circle | null`
// @hint redundant type annotation: `ga` is inferred as `Circle | null`
// @hint redundant type annotation: `gb` is inferred as `Circle | null`
// The two annotations are the test — see `arm-struct-equality.vl`'s note.
// D57's NULLABLE HALF, and it is here because leaving it out is how the two halves of one
// rep drift apart. `emitEqNonNullCore`'s header states the rule — "two ladders is how the
// nullable half of a rep drifts out of the non-null half's capability" — and the nullable
// struct compare had exactly that shape: `emitNulStructEq` asked `structIndexOfExpr` and
// nothing else, so with `Circle` a union arm it answered `emitProgram: struct equality over
// a non-struct operand` while the identical NON-null compare one screen down had just
// learned to run.
//
// `nulVariantIdxOfExpr` IS THAT LADDER'S TWIN and was already written arm for arm (its own
// header carries the table). The nullable dispatch now asks the same two namespaces in the
// same order, on the same AGREEMENT condition, so the two halves cannot diverge again
// without one of them losing a rung the other kept.
//
// `Dot` AND THE TWO GLOBALS ARE THE ORDER TEST. `structIndexOfLet` is not kind-gated, so a
// `Circle | null` MODULE GLOBAL beside an exact layout twin resolves to DOT's row and the
// compare reads a `(ref null $uVarHeap[vi])` through `sHeapIdx` — `expected (ref null $type),
// found (ref null $type)`, check-clean, and the reason the niche rung is asked FIRST rather
// than as a fallback. Delete `type Dot` and `ga == gb` was already fine; keep it and only the
// ordering saves it.
//
// THE NULL GUARD IS UNCHANGED: two `null`s compare equal, one `null` against a value is
// false, and only the both-non-null path reaches the field-wise core — the same three-way
// shape the standalone-struct niche has always had, now over `(ref null $uVarHeap[vi])`
// instead of `(ref null $sHeapIdx[si])`.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Dot = { r: i32 }

function mkn(v: i32): Circle | null {
  if v > 0 { return { r: v } }
  return null
}

function cell() {
  const a: Circle | null = mkn(1)
  const b: Circle | null = mkn(1)
  return a == b
}

function oneNull() {
  const a: Circle | null = mkn(1)
  const b: Circle | null = mkn(0)
  return a == b
}

function bothNull() {
  const a: Circle | null = mkn(0)
  const b: Circle | null = mkn(0)
  return a == b
}

function differing() {
  const a: Circle | null = mkn(1)
  const b: Circle | null = mkn(2)
  return a != b
}

const ga: Circle | null = mkn(1)
const gb: Circle | null = mkn(1)

print(cell())
print(ga == gb)
print(oneNull())
print(bothNull())
print(differing())
