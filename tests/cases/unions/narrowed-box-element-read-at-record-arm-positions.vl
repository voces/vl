// @run
// @log 7
// @log 7
// @log 8
// @log 9
// @log 0
// @log 7
// A list element held as a union box (`i32 | A`), narrowed by `is A` and read at the arm's record:
// a nested element bound, a one-level element bound, an element passed straight on, read twice,
// the other arm, and at the top.
type A = { r: i32 }
function mk(b: boolean, r: i32) { return if b { { r: r } } else { 3 } }
function takeA(a: A) { return a.r }
function nested() {
  const ys = [[mk(true, 7)]]
  if ys[0][0] is A {
    const q = ys[0][0]
    return takeA(q)
  }
  return 0
}
function flat() {
  const xs = [mk(true, 7)]
  if xs[0] is A {
    const q = xs[0]
    return takeA(q)
  }
  return 0
}
function passed() {
  const xs = [mk(true, 8)]
  if xs[0] is A { return takeA(xs[0]) }
  return 0
}
function twice() {
  const xs = [mk(true, 4), mk(true, 5)]
  if xs[1] is A {
    const q = xs[1]
    return takeA(q) + 4
  }
  return 0
}
function other() {
  const xs = [mk(false, 1)]
  if xs[0] is A {
    const q = xs[0]
    return takeA(q)
  }
  return 0
}
print(nested())
print(flat())
print(passed())
print(twice())
print(other())
const ts = [mk(true, 7)]
if ts[0] is A {
  const q = ts[0]
  print(takeA(q))
}
