// @run
// @log true
// @log true
// @log false
// @log true
// @log true
// @hint `A` is contained in `B`, so `is A` tests the value
// @hint `A` is contained in `B`, so `is A` tests the value
// @hint `A` is contained in `B`, so `is A` tests the value
// Overlapping record arms spelled in a different field order (D4056): `B`'s `v: i32 | boolean`
// holds every `A` value whose `v` is an `i32`, so `is A` reads the value, not the arm.
type A = { v: i32, w: string }
type B = { w: string, v: i32 | boolean }
function f(n: i32): A | B {
  if n == 0 {
    const a: A = { v: 1, w: "a" }
    return a
  }
  if n == 1 {
    const b: B = { w: "b", v: 5 }
    return b
  }
  const c: B = { w: "c", v: true }
  c
}
print(f(0) is A)
print(f(1) is A)
print(f(2) is A)
print(f(0) is B)
print(f(2) is B)
