// @emit-error cannot be discriminated
// A union whose two variants carry the SAME field names with DIFFERENT field types
// (`{v: i32} | {v: string}`). VL's structural unions discriminate on the field-NAME set —
// `variantSig`, the tag key, IS that set — so two such variants rank identically and every
// `is` test on either answers for both. Worse, the literal → variant resolution matches by
// field-name set alone, so the second member's literal builds the FIRST member's struct:
// this program emitted a module whose global initializer pushed a string-array ref into an
// i32 field, and both `is` tests compared against tag 0. Silent INVALID WASM, with no
// generics anywhere in it.
//
// There is no sound representation to give this union under name-set discrimination, so it
// is a loud reject naming the union and both offending variants. Layout-EQUAL same-name
// variants (one shape reached through two spellings) stay legal — they are one variant, and
// the twin machinery already folds them; `union-variant-twin-*.vl` pin that side.
type U = { v: i32 } | { v: string }
const a: U = { v: 7 }
const b: U = { v: "s" }
if a is { v: i32 } { print(a.v) }
if b is { v: string } { print(b.v) }
