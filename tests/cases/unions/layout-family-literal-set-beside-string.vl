// @run
// @log useA circle
// @log circle
// @log B zz
// @log useA round
// @log round
// @log a circle
// @hint `A` is contained in `B`, so `is A` tests the value
// @hint redundant type annotation: `y` is inferred as `A` — remove it to lean on inference
// A literal-set field beside its `string` base in a same-tag twin is stored at the string by the
// whole layout family, so a value narrowed by `is A` reads, passes and binds at `A`'s one layout
// whichever arm built it, and a standalone `A` is laid out the same (D14752).
type K = "circle" | "round"
type A = { kind: K, r: i32 }
type B = { kind: string, r: i32 }
function useA(a: A) { print("useA " + a.kind) }
function f(n: i32): A | B {
  if n == 0 {
    const a: A = { kind: "circle", r: 1 }
    return a
  }
  if n == 1 { return { kind: "zz", r: 2 } }
  const b: B = { kind: "round", r: 3 }
  b
}
let i = 0
while i < 3 {
  const x = f(i)
  if x is A {
    useA(x)
    const y: A = x
    print(y.kind)
  } else {
    print("B " + x.kind)
  }
  i = i + 1
}
const s: A = { kind: "circle", r: 4 }
print("a " + s.kind)
