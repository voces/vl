// @run
// A `K | null` parameter delivered into a union with a record arm widens to the box at every
// position inside a function: return, binding, assignment, argument and field (D4041).
type A = ("a" | "b") | null
type U = A | { tag: i32 }
function r(a: A): U { return a }
function b(a: A): U {
  const u: U = a
  return u
}
function s(a: A): U {
  let u: U = { tag: 1 }
  u = a
  return u
}
function t(x: A): U {
  const a: A = x
  let u: U = { tag: 1 }
  u = a
  return u
}
function id(u: U): U { return u }
function c(a: A): U { return id(a) }
function o(a: A): U {
  const w: { u: U } = { u: a }
  return w.u
}
print(r("a") == null)
print(r(null) == null)
print(b("b") == "b")
print(s("a") == null)
print(s(null) == null)
print(t("b") == "b")
print(c("a") == "a")
print(o(null) == null)
// @log false
// @log true
// @log true
// @log false
// @log true
// @log true
// @log true
// @log true
// @hint redundant type annotation: `a` is inferred as
