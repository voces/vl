// @run
// @info `v` is never reassigned; use `const` instead of `let`
// @log true
// @log false
// @log true
// @log false
// @log true
// @log true
// @log false
// @log true
// @log true
// @log false
// @log true
// @log true
// A union compared with an operand legacy reads at its use: a nullable global beside a global box
// (both read again on the null leg), a function's closure beside a closure arm, and a module
// `let` its initializer narrowed, compared at the box it is stored as.
type A = { a: i32 }
type B = { b: i32 }
function f0() { return 7 }
function f1(v: i32) { return v }
function pick(k: i32, s: string | null) {
  const r = if k == 0 { s } else if k == 1 { false } else { 5 }
  return r
}
function arm(n: i32): (() => i32) | ((i32) => i32) {
  if n == 0 { return f0 }
  return f1
}
const sn: string | null = null
const sv: string | null = "x"
const un = pick(0, sn)
const uv = pick(0, sv)
const ub = pick(1, sv)
function nulLeg() { return un == sn }
function valLeg() { return ub == sv }
const ca = arm(0)
function cloLocal() {
  const c = arm(0)
  return c === f0
}
function cloGlobal() { return ca === f1 }
const src: A = { a: 1 }
const held: A | B = src
let v: A | B = src
const other: A | B = { b: 1 }
print(nulLeg())
print(valLeg())
print(uv == sv)
print(cloGlobal())
print(cloLocal())
print(f0 === ca)
print(ca !== f0)
print(v == held)
print(held == v)
print(v == other)
print(v != other)
print(un == sn)
