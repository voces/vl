// @run
// @log s
// @log s
// @log s
// @log s
// @log 3
// @log 2
// @log 3
// @log 15
// @log 15
// The `else` of `is P[]` over an inferred `{x: i32}[] | string[]` reads the arm left over, at a
// binding and a field, beside a `for` that walks the same list; the type names the arm the
// shape-spelled set does not.
type P = { x: i32 }
function ws(t: P, b: boolean) {
  if b { return [t] }
  ["s"]
}
const so = ws({ x: 15 }, false)
if so is P[] { print(so[0].x) } else { print(so[0]) }
for v in so {
  if v is P { print(v.x) } else { print(v) }
}
const fo = { f: ws({ x: 15 }, false), k: "k" }
if fo.f is P[] { print(fo.f[0].x) } else { print(fo.f[0]) }
for v in fo.f {
  if v is P { print(v.x) } else { print(v) }
}
function wi(t: P, b: boolean) {
  if b { return [t] }
  [2, 3]
}
const io = wi({ x: 15 }, false)
if io is P[] { print(io[0].x) } else { print(io[1]) }
for v in io {
  if v is P { print(v.x) } else { print(v) }
}
const ip = wi({ x: 15 }, true)
if ip is P[] { print(ip[0].x) } else { print(ip[0]) }
for v in ip {
  if v is P { print(v.x) } else { print(v) }
}
