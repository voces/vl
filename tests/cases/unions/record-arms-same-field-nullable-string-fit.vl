// @run
// @log Q
// @log R
// @log R
// @log A
// @log B
// @log A
// @log B
// @log A
// @hint `A` is contained in `B`, so `is A` tests the value
// @hint `C` is contained in `B`, so `is C` tests the value
// `is` reads a nullable string field null-first (D4056): its null fits only a field that
// admits null, and a non-null string is compared against the target's literal set.
type R = { v: string | null }
type Q = { v: "a" | "b" }
function onR(r: R) {
  if r is Q { print("Q") } else { print("R") }
}
onR({ v: "a" })
onR({ v: null })
onR({ v: "z" })
type A = { v: "a" | "b" }
type B = { v: string | null }
function onAB(u: A | B) {
  if u is A { print("A") } else { print("B") }
}
const b1: B = { v: "a" }
const b2: B = { v: null }
onAB(b1)
onAB(b2)
type C = { v: string }
function onCB(u: C | B) {
  if u is C { print("A") } else { print("B") }
}
const c: C = { v: "z" }
onCB(b1)
onCB(b2)
onCB(c)
