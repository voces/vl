// @run
// @log y
// @log N
// @log a
// @log N
// D3174: a copy of a value narrowed out of a wider box to two literal unions and `null` converts
// the box to that set's atom niche, so the copy's cell and the read that fills it agree.
type K = "a" | "b"
type L = "x" | "y"
function t(e: K | L | null | i32) {
  if !(e is i32) {
    const c = e
    if c == null { print("N") } else { print(c) }
  }
}
t("y")
t(null)
function u(e: K | L | null | f64) {
  if !(e is f64) {
    const c = e
    if c == null { print("N") } else { print(c) }
  }
}
u("a")
u(null)
