// @run
// @log y
// @log N
// @log y
// @log N
// @log y
// @log x
// @log a
// @log y
// @log N
// @hint redundant type annotation: `c` is inferred as `"a" | "b" | "x" | "y" | null` — remove it to lean on inference
// @hint redundant type annotation: `s` is inferred as `string` — remove it to lean on inference
// D3174: `K | L | null` over two literal unions is the atom niche `KL | null` is, so a copy of a
// value narrowed to it out of a wider box converts to that niche, and the set spelled on its own
// prints, holds `null` and widens to `string` like any nullable literal union.
type K = "a" | "b"
type L = "x" | "y"
function t(e: K | L | null | i32) {
  if !(e is i32) {
    const c = e
    if c == null { print("N") } else { print(c) }
  }
}
t("y")
t(null)
function u(e: K | L | null | i32) {
  if !(e is i32) {
    const c: K | L | null = e
    if c == null { print("N") } else { print(c) }
  }
}
u("y")
u(null)
function p(e: K | L | null) {
  if e != null { print(e) }
}
p("y")
const q: K | L | null = "x"
print(q)
let w: K | L | null = null
w = "a"
if w != null { print(w) }
function s(e: K | L | null): string {
  if e == null { return "N" }
  return e
}
print(s("y"))
print(s(null))
