// @run
// @log null
// @log 4
// @log null
// @log 3
// @log null
// @log null
// @log null
// @log null
// @log null
// A nullable record, list, map or closure narrowed to `null` (the `else` of `is Rec`) prints
// `null`: no rung of `print` claimed the niche, which reached `__print_i32__` as a ref (D3498).
type Rec = { x: i32 }
type O = { f: Rec | null }
const v: Rec | null = null
if v is Rec { print(v.x) } else { print(v) }
const w: Rec | null = { x: 4 }
if w is Rec { print(w.x) } else { print(w) }
function f(p: Rec | null) {
  if p is Rec { print(p.x) } else { print(p) }
}
f(null)
f({ x: 3 })
const o: O = { f: null }
if o.f is Rec { print(o.f.x) } else { print(o.f) }
const xs: i32[] | null = null
if xs is i32[] { print(xs.length) } else { print(xs) }
const m: Map<string, i32> | null = null
if m is Map<string, i32> { print(m.length) } else { print(m) }
const g: ((x: i32) => i32) | null = null
if g is (x: i32) => i32 { print(g(1)) } else { print(g) }
const q: Rec | null = null
if q is Rec {
  print(q.x)
} else {
  const z = q
  print(z)
}
