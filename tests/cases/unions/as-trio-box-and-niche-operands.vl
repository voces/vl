// @run
// @log 3
// @log 0
// @log 4
// @log -1
// @log 5
// @log ok
// @log none
// @log ab
// The `as` trio over a union box tests the arm's tag: `as?` yields the arm or `null`, `as!` the arm
// (trapping on a miss) and `as` the arm or the whole box back to the caller. Over a `T | null` niche,
// `as?` is the operand itself and `as!` its non-null reference.
type Circle = { r: i32 }
type Square = { side: i32 }
type Shape = Circle | Square

function radiusOr(s: Shape) {
  const c = s as? Circle
  return if c == null { 0 } else { c.r }
}

function side(s: Shape) { return (s as! Square).side }

function circleOnly(s: Shape): Circle | Square {
  const c = s as Circle
  return { r: c.r + 1 }
}

function count(v: i32 | string) {
  const n = v as? i32
  return n ?? -1
}

function name(s: string | null) {
  const t = s as? string
  return t ?? "none"
}

function both(s: string | null) { return (s as! string) + "b" }

print(radiusOr({ r: 3 }))
print(radiusOr({ side: 2 }))
print(side({ side: 4 }))
print(count("x"))
print(count(5))
const back = circleOnly({ side: 1 })
print(if back is Square { "ok" } else { "no" })
print(name(null))
print(both("a"))
