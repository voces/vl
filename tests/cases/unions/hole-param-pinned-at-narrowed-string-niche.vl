// @run
// @log 2
// @log null
// CONTRACT: an un-annotated parameter handed `string | null` narrowed out of a wider union
// takes the niche, so the body reads it as a string or null.
function pickS(n: i32): string | i32 | null {
  if n == 1 { return "hi" }
  if n == 2 { return 3 }
  null
}
function take(b) {
  if b == null { print("null") } else { print(b.length) }
}
function go() {
  const x = pickS(1)
  if !(x is i32) { take(x) }
  const y = pickS(3)
  if !(y is i32) { take(y) }
}
go()
