// @run
// @log 3
// @log 0
// @log a
// @log z
// @log 7
// @log s
// A field every member of a union declares, stored differently by each, is read as the type it
// was narrowed to: a nested record arm, a string beside `null`, a string beside an `i32`.

type Cir2 = { c2: i32 }
type Sq2 = { s2: i32 }
type W = { c: Cir2 }
type V = { c: Sq2 }

function nestedArm(w: W | V) {
  if w.c is Cir2 { print(w.c.c2) } else { print(0) }
}
nestedArm({ c: { c2: 3 } })
nestedArm({ c: { s2: 3 } })

function strOrNull(g0: {r: string} | {r: null}) {
  if g0.r != null { print(g0.r) } else { print("z") }
}
strOrNull({ r: "a" })
strOrNull({ r: null })

function intOrStr(g0: {r: i32} | {r: string}) {
  if g0.r is string { print(g0.r) } else { print(g0.r) }
}
intOrStr({ r: 7 })
intOrStr({ r: "s" })
