// @run
// @log 3
// @log a
// @log b
// @log 3
// @log a
// @log x
// @log q
// @log x
// @log zz
// AN INLINE LITERAL-UNION FIELD SPELLED IN A DECLARATION AND IN AN INLINE-SHAPE
// ANNOTATION IS ONE LAYOUT (D1110) — with no union anywhere in the first half.
//
// THREE PRODUCERS ANSWERED THE FIELD'S CODE AND TWO OF THEM DISAGREED. The DECLARED and
// VARIANT recorders read the annotation NODE, where an inline set is not a registered alias
// and canon has softened it: code 3, a string ref, which is what the struct is laid out with.
// The inline-shape annotation is interned from its rendered member TEXT and asked
// `nameIsLitUnionType`, which is true for `"a"|"b"` registered or not: code 0, the interned
// i32 atom. So the two spellings of one shape interned two rows with different layouts, and
// passing the declared value into the inline-shape parameter was `vl check` rc 0 over a module
// the engine refuses.
//
// THE ATOM REP BELONGS TO A REGISTERED ALIAS. `tyIsLitUnionAlias` is the one home of that
// rule, and `type K = "a" | "b"` + `k: K` — the control below — has always coded 0 on every
// ladder. The name and arena ladders now make the same split the node ladder made.
//
// `type K` IS DECLARED FIRST ON PURPOSE: declaring it AFTER the inline-spelled `C` and its
// inline-shape parameter is check-clean invalid wasm on this seed and on master alike, an
// order dependence filed separately as D1151. This file pins D1110, not that.
type K = "a" | "b"

type C = { r: i32, k: "a" | "b" }
function f(c: { r: i32, k: "a" | "b" }) { c.r }
const c: C = { r: 3, k: "a" }
print(f(c))
print(c.k)

// The field is WRITABLE at the shared layout, and reads back as the member string.
function bump() {
  const w: C = { r: 1, k: "a" }
  w.k = "b"
  print(w.k)
}
bump()

// THE NAMED-ALIAS CONTROL, which always ran: same two spellings, the atom rep.
type NC = { r: i32, k: K }
function nf(v: { r: i32, k: K }) { v.r }
const nc: NC = { r: 3, k: "a" }
print(nf(nc))
print(nc.k)

// THE IDENTITY COLUMN. Code 3 is layout-shared with a plain `string` field and with every
// other inline set, so the fix records the member SET on a code-3 inline field for the same
// reason the atom arm records its union name. Without that column these three inline shapes
// share one field-name set and one code, and the second and third dedup onto the first — each
// losing its own `sNames` entry. They must stay three rows.
function px(v: { kind: "x" | "y" }): string { v.kind }
function pq(v: { kind: "p" | "q" }): string { v.kind }
function ps(v: { kind: string }) { v.kind }
print(px({ kind: "x" }))
print(pq({ kind: "q" }))

// DECLARED, not deleted: `bv`'s annotation is what makes it a value of the DECLARED
// `{kind: string}` type rather than an inferred inline shape, which is the half of the pair
// under test. The hint says the CHECKER agrees about the type; it says nothing about whether
// the two spellings agree about the REP.
// @hint redundant type annotation: `bv` is inferred as `{kind: string}` — remove it to lean on inference
// AND THE OWNER RULING STAYS: `{kind: "x"|"y"}` and `{kind: string}` are two types related by
// SUBSET, each keeping its own value — see `discriminant-value-is-set-beside-base.vl` for the
// `is` half of the same ruling.
type A = { kind: "x" | "y" }
type Base = { kind: string }
const av: A = { kind: "x" }
const bv: Base = { kind: "zz" }
print(av.kind)
print(ps(bv))
