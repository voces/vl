// @run
// @log 1
// @log 7
// @hint redundant type annotation: `cS` is inferred as `{r: i32}[]` — remove it to lean on inference
// D501's ARM-PIN witness, now RUNNING (D791). The pin is still declined — that half is
// unchanged and is what routes the binding to `letRefListDestSlot` — but that function no
// longer refuses the pair: it returns the PLAIN-STRUCT row and the map-value delivery takes
// an element-converting copy.
//
// The map store is the delivery form this file exists for. `mU["k"] = lv1` over a
// `{[string]: Shape[]}` was `expected (ref null $box-list), found (ref $struct-list)`
// before D501 made it loud; it now boxes each element into the map's own row on the way in,
// and `cS` keeps the plain `Circle[]` the literal was built at.
//
// A map store is not a LIST mutation, which is why the write scan licenses this program:
// `mU["k"] = lv1` stores the list INTO a map — a destination delivery, not a mutation of
// either list — and `listWriteReaches` answers FALSE for a `TyMap` receiver.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function f() {
  const lv1 = [{ r: 7 }]
  const mU: {[string]: Shape[]} = Map()
  mU["k"] = lv1
  const cS: Circle[] = lv1
  const gU = mU["k"] ?? []
  if gU.length > 0 { print(gU.length) } else { print(0) }
  if cS.length > 0 { print(cS[0].r) } else { print(0) }
}
f()
