// @error is not a JSON shape — field `me`: `Loop` is recursive with no list, map or `null` on its cycle, so it has no finite value
// A cycle that passes no list, map or `null` describes no finite document, so no walk can match one.
type Json = null | boolean | f64 | string | Json[] | { [string]: Json }
type Loop = { me: Loop }
const j: Json = null
print(j is Loop)
