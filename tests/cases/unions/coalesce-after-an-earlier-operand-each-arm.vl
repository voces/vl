// A `??` built after an earlier operand still waiting to be read, along each arm whose value the
// lowering writes in place: an optional record field, a map's optional field, a list `.get`, a
// `.pop`, a boxed operand and a `boolean | null` read twice; in arithmetic, a call argument, a
// comparison, a string concatenation, a returned value and a nested `if`.
// @run
// @log 11
// @log 6
// @log 14
// @log 5
// @log 13
// @log 7
// @log 22
// @log 10
// @log 4
// @log 1
// @log true
// @log x:9
// @log x:1
// @log 1
// @log 0
// @log 7
// @log -1
// @log 2i4
// @log 4sq
// @log 6sd
type P = { n: i32, ok: boolean }
type H = { p: P | null }
function two(a: i32, b: i32) { return a * 2 + b }
function optField(h: H) { return 10 + (h.p?.n ?? 1) }
function mapField(m: {[string]: P}, k: string) { return 5 + (m[k]?.n ?? 1) }
function getAt(xs: i32[], i: i32) { return two(3, xs.get(i) ?? 8) }
function popped(xs: i32[]) { return 3 + (xs.pop() ?? 2) }
function show(a: i32, v: i32 | string) {
  return if v is i32 { "\{a}i\{v}" } else { "\{a}s\{v}" }
}
function boxArg(k: i32, u: i32 | string | null) { return show(k * 2, u ?? "d") }
function flag(m: {[string]: P}, k: string) {
  if m[k]?.ok ?? false { return 1 }
  return 0
}
function nested(m: {[string]: P}, c: boolean) {
  if c {
    if m["x"]?.ok ?? false { return m["x"]?.n ?? 0 }
  }
  return -1
}
const m: {[string]: P} = Map()
m["x"] = { n: 7, ok: true }
print(optField({ p: { n: 1, ok: true } }))
print(mapField(m, "z"))
print(getAt([1, 8], 1))
print(popped([2]))
print(getAt([], 0) - 1)
print(10 - (m["z"]?.n ?? 3))
print(optField({ p: { n: 12, ok: false } }))
print(optField({ p: null }) - 1)
print(popped([]) - 1)
print(flag(m, "x"))
print(1 < (m["x"]?.n ?? 0))
print("x:" + "\{[9].get(0) ?? 0}")
print("x:" + "\{flag(m, "x") + (m["q"]?.n ?? 0)}")
print(two(0, 1) + flag(m, "z") + (if m["x"]?.ok ?? false { 0 } else { 5 }))
print(flag(m, "z"))
print(nested(m, true))
print(nested(m, false))
print(boxArg(1, 4))
print(boxArg(2, "q"))
print(boxArg(3, null))
