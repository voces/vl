// @run
// @log 1.5
// @log 2.5
// @log s
// @log s
// @log 3
// @log t
// @log 7
// @log 2
// @log 2
// @log s
// @log y
// @log 9.5
// @log 0.5
// D2887: a union with a `readonly` list member narrows to it, rules it out of an `else` and
// after an early return, and reads it without narrowing at all: the view and its list are one
// rep and one box atom.
function mk(b: boolean): readonly f64[] | string[] {
  if b { return [1.5, 2.5] }
  ["s"]
}
const w = mk(true)
if w is readonly f64[] { print(w[0]) }
function g(u: readonly f64[] | string[]) {
  if u is readonly f64[] { print(u[1]) } else { print(u[0]) }
}
g(w)
g(mk(false))
function h(u: readonly f64[] | string[]) {
  if u is readonly f64[] { return 0 }
  print(u[0])
  0
}
h(mk(false))
function k(u: readonly i32[] | string[] | i32) {
  if u is readonly i32[] { print(u.length) }
  else if u is string[] { print(u[0]) }
  else { print(u) }
}
k([4, 5, 6])
k(["t"])
k(7)
const c = () => {
  if w is readonly f64[] { print(w.length) }
  0
}
c()
print(w.length)
for v in mk(false) { print(v) }
const r: readonly i32[] | readonly string[] = ["x", "y"]
print(r[1])
type B = { u: readonly f64[] | string }
const b: B = { u: [9.5] }
const bu = b.u
if bu is string { print(bu) } else { print(bu[0]) }
const m: {[string]: readonly f64[] | string} = Map()
m.set("a", [0.5])
const mv = m.get("a")
if mv is readonly f64[] { print(mv[0]) }
