// @run
// @log isA
// @log 200
// @log 200
// @log 200
// @log 2
// @hint redundant type annotation: `b` is inferred as `B`
// @hint redundant type annotation: `xs` is inferred as `A[]`
// An inline union of two same-shape records, whose arena type is the one record they share:
// the binding is still the union its annotation spells, so `is` has a union to test.
type A = { tag: i32, v: i32 }
type B = { tag: i32, v: i32 }
function mkB(): B { return { tag: 2, v: 200 } }
const b: A | B = mkB()
if b is A { print("isA") }
let c: A | B = { tag: 1, v: 3 }
c = mkB()
print(c.v)
function f(x: A | B): A | B { return x }
print(f(b).v)
const xs: (A | B)[] = [b, c]
print(xs[1].v)
function g(): A | B { return mkB() }
const r = g()
print(r.tag)
