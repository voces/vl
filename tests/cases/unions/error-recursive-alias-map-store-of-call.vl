// @error string[] is not Json[] (reached through string[] into Json): a container never widens implicitly
// DV-1202 (D4038): a call's list stored into a map of `Json` refuses in its own module, as it
// already did once an importer checked it.
import { Json, toJson } from "std:json"

function lines(): string[] { ["a", "b"] }

function optionJson(): Json {
  const o: { [string]: Json } = Map()
  o["lines"] = lines()
  o
}

const s = toJson(optionJson())
if s is string { print(s) } else { print(s.msg) }
