// @run
// @log false
// @log true
// @log true
// @log false
// An element of a list of a nullable union with a ref and a scalar member is a union box that
// holds `null` as a tag, so a read binds a non-null local inside a function (D16312).
function useIt(p: (string[] | i32 | null)[]) {
  const t0 = p[0]
  print(t0 == null)
  const t1 = p[1]
  print(t1 == null)
  print(t0 is string[])
}
useIt([["ftr"], null])
function f() {
  const p: ({[string]: i64} | f64 | null)[] = [null, 2.5]
  return p
}
const q = f()
function g() {
  const b = q[1]
  print(b == null)
}
g()
