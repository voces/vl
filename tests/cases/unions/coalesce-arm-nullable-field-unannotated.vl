// @run
// The un-annotated face of `coalesce-arm-nullable-field.vl`: a tagged arm narrowed by its
// tag, and an un-annotated map's value (D4667).
type U = { kind: "a", q: i32 | null } | { kind: "b", r: i32 }
const v: U = { kind: "a", q: 3 }
if v.kind == "a" { print(v.q ?? 0) }
function g() {
  const m = Map()
  m["k"] = { kind: "a", q: 4 }
  const z = m["k"]
  if z != null { print((z.q ?? 0) + 1) }
}
g()
// @log 3
// @log 5
