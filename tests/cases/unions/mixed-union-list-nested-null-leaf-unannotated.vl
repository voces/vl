// @run
// The un-annotated face of `mixed-union-list-nested-null-leaf.vl`: an element pushed into the
// annotated list, and a list literal assigned into one (D4635).
type Holder = { h: { x: i32 | null } }
const xs: (Holder | string)[] = ["t"]
xs.push({ h: { x: 3 } })
const a = xs[1]
if a is Holder { print(a.h.x == null) }
let ys: (Holder | string)[] = []
ys = [{ h: { x: null } }, "t"]
const b = ys[0]
if b is Holder { print(b.h.x == null) }
// @log false
// @log true
