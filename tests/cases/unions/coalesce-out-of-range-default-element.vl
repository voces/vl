// @run
// @log 2
// @log 9000000001
// @log 2
// @log 9000000001
// @log 5
// @log 9000000001
// @log 9000000002
// @hint redundant type annotation: `ys` is inferred as `i64[]`
// @hint redundant type annotation: `y` is inferred as `i64`
// A `??` over a nullable i32 whose default only fits i64 joins to i64 (the literal adapts), as
// a list element un-annotated and annotated `i64[]`, inside a function, beside a second element,
// and as a field. A wider-than-i32 default is never truncated.
function pick(n: i32): i32 | null {
  if n > 1 { return n }
  return null
}
const xs = [pick(2) ?? 9000000001]
print(xs[0])
const ys: i64[] = [pick(0) ?? 9000000001]
print(ys[0])
function inner() {
  const zs = [pick(2) ?? 9000000001]
  for e in zs { print(e) }
}
inner()
const pair = [pick(0) ?? 9000000001, 5]
print(pair[0])
print(pair[1])
const m = { a: pick(0) ?? 9000000001 }
print(m.a)
const y: i64 = xs[0] + 9000000000
print(y - xs[0] + ys[0] - 9000000000 + 1)
