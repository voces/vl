// R
// The numeric twin of `same-field-names-literal-tags.vl` — D1023's ruling reaches a numeric
// discriminant through exactly the same column, and needed no separate arm.
//
// ALSO AN `@emit-error` FIXTURE UNTIL THE RULING. `variantFieldIdText` had always recorded
// every `TyLit` kind rather than only `"str"`, so the identity column parted `kind: 0` from
// `kind: 1` before anything could use the difference; what was missing was the compare, and
// the compare is picked off the field's STORAGE rather than the lexeme's looks. A numeric
// literal set reps as the plain scalar holding its own value, so `c is C` is one `i32.eq`
// against `0` under the tag guard — the same shape the string arm gets, with `strEq` swapped
// for the scalar compare.
//
// The value is built through `R`, so the answer is `R`.
type C = { kind: 0, size: f64 }
type R = { kind: 1, size: f64 }
type S = C | R

const c: S = { kind: 1, size: 2.0 }
if c is C { print("C") } else { print("R") }
