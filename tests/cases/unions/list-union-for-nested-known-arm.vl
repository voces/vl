// @run
// @log 15
// @log 2
// @log 2
// @log 2
// @log 2
// A walk nested in a walk of the same union-of-lists binding knows the arm and walks that arm
// alone; a binding the body rebinds, directly or through a closure it calls, walks every arm.
function mk(k: i32): i32[] | f64[] {
  const a = [1, 2]
  const b = [1.5]
  if k == 0 { return a }
  return b
}
function deep(a) {
  let c = 0
  for x in a {
    for y in a {
      for z in a { c = c + 1 }
    }
  }
  return c
}
print(deep(mk(0)) * 2 - deep(mk(1)))
function rebind(a, other) {
  let c = 0
  let x = a
  for p in x {
    x = other
    for q in x { c = c + 1 }
  }
  return c
}
print(rebind(mk(0), mk(1)))
print(rebind(mk(1), mk(0)))
function viaClosure(a, other) {
  let c = 0
  let x = a
  const swap = () => {
    x = other
  }
  for p in x {
    swap()
    for q in x { c = c + 1 }
  }
  return c
}
print(viaClosure(mk(0), mk(1)))
print(viaClosure(mk(1), mk(0)))
