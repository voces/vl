// @run
// @log bee
// @log 4
// An `is A` test over a record field in a hole instance built from a literal tests the field's
// own record, so a `B` that also fits `A` structurally still takes the arm its value is (D3235).
type A = { v: i32 }
type B = { v: i32, s: string }
function F(z) {
  if z.h is A { print(z.h.v) } else { print(z.h.s) }
}
F({ h: { v: 4, s: "bee" } })
function G(z) {
  if z.h is A { print(z.h.v) } else { print(z.h.s) }
}
G({ h: { v: 4 } })
