// @run
// @log 1
// @log 16
// @log 2
// @log f
// @log 2
// @log 8
// @log g
// A struct that is BOTH a union ARM and the nested-struct FIELD of another union's arm
// (D1518, reported by the glean session as VL-024). `B` is an arm of `B | E` and the type of
// `M`'s field `a`, with `M` an arm of `M | E` — and `collectS` SKIPS a `type X = {…}` that is
// a union member, so `B` had no struct-table row for the field to target.
//
// The declaration ORDER is this family's second face and both are pinned: `f` first refused
// in the TYPE SECTION (`nested-struct field element type is not interned` — the field coded
// 15 against a row that never existed), `g` first refused in `collectU`
// (`nameIsStructDecl` declines an arm, so the field had no code at all). One missing intern,
// two sentences. `arm-also-nested-field-declared-first.vl` is the other order.
type E = { msg: string }
type B = { base: i32, length: i32 }
type M = { a: B, n: i32 }

function f(ok: boolean): M | E {
  if !ok { return { msg: "f" } }
  return { a: { base: 1, length: 16 }, n: 2 }
}

function g(ok: boolean): B | E {
  if !ok { return { msg: "g" } }
  return { base: 2, length: 8 }
}

// BOTH BRANCHES OF BOTH FUNCTIONS, and the nested field READ through the narrowed arm: the
// refusal fired on the declarations alone, so a fixture that only constructs would pass
// without proving the field's storage is the arm's own heap type.
const m = f(true)
if m is M {
  print(m.a.base)
  print(m.a.length)
  print(m.n)
}
const me = f(false)
if me is E { print(me.msg) }

const b = g(true)
if b is B {
  print(b.base)
  print(b.length)
}
const be = g(false)
if be is E { print(be.msg) }
