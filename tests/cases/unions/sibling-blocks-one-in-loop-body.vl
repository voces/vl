// D2326 matrix — one binding of the shared name `u` sits inside a `for` loop body, its
// sibling in a plain block; the loop-body walk has to feed the same owner-tracked table as
// every other block kind (`plScanStmt`'s existing ForRange arm — shared with D2316).
// @run
// @log 5|inner

type A = { x: i32 }
type B = { y: string }
type C = { z: boolean }

function f() {
  let out = ""
  for i in [0] {
    const u: A | B = { x: 5 }
    if u is A { out = "\{u.x}" } else { out = "\{u.y}" }
  }
  {
    const u: C | B = { z: true }
    if u is C { out = out + "|inner" } else { out = out + "|\{u.y}" }
  }
  out
}
print(f())
