// D2326 matrix — a union local declared at the function's own top level, shadowed by a
// DIFFERENT union inside a nested block, then read again after the block closes. The
// resolver must answer the OUTER binding's member set both before and after the shadow,
// and the INNER binding's set only while inside its own block.
// @run
// @log 5|inner|5

type A = { x: i32 }
type B = { y: string }
type C = { z: boolean }

function f() {
  const u: A | B = { x: 5 }
  let out = ""
  if u is A { out = "\{u.x}" } else { out = "\{u.y}" }
  {
    const u: C | B = { z: true }
    if u is C { out = out + "|inner" } else { out = out + "|\{u.y}" }
  }
  if u is A { out = out + "|\{u.x}" } else { out = out + "|\{u.y}" }
  out
}
print(f())
