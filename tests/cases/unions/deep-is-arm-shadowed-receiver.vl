// A binding of the tested place's name in a block nested in a deep `is` arm hides the place to
// the end of that block only: the reads around the block still see the converted copy (D16475).
type Json = null | boolean | f64 | string | Json[] | { [string]: Json }

function inExpr(r: Json, c: boolean) {
  if r is string[] {
    const n = r.length
    const x = if c {
      const q = 5
      const r = q
      r + 1
    } else {
      0
    }
    print(x)
    return n
  }
  return 0
}

function inArm(r: Json, c: boolean) {
  if r is string[] {
    if c {
      const r = 5
      print(r)
    }
    print(r.length)
    print(r[1])
  }
  return 0
}

function inElse(r: Json, c: boolean) {
  if r is string[] {
    if !c {
      print("no")
    } else {
      const r = 9
      print(r)
    }
    print(r.length)
  }
  return 0
}

function inBlock(r: Json) {
  if r is string[] {
    {
      const r = 5
      print(r)
    }
    print(r.length)
  }
  return 0
}

function writesShadow(r: Json) {
  if r is string[] {
    {
      let r = 5
      r = 6
      print(r)
    }
    print(r[1])
  }
  return 0
}

function readBefore(r: Json) {
  if r is string[] {
    print(r[0])
    {
      const r = "x"
      print(r)
    }
    print(r.length)
  }
  return 0
}

function loopVar(r: Json) {
  if r is string[] {
    for r in [7, 8] { print(r) }
    print(r[0])
  }
  return 0
}

function rangeVar(r: Json) {
  if r is string[] {
    for r in 0 until 2 { print(r) }
    print(r.length)
  }
  return 0
}

print(inExpr(["a", "b"], true))
inArm(["a", "b"], true)
inElse(["a", "b"], true)
inBlock(["a", "b"])
writesShadow(["a", "b"])
readBefore(["a", "b"])
loopVar(["a", "b"])
rangeVar(["a", "b"])
