// @run
// @log 2
// @log a
// @log a
// @log c
// @log 1
// @log b
// @log b
// @log 11
// @log 1
// @log 7
// @log 1
// @log b
// @log 1
// @log 2
// @hint redundant type annotation: `v` is inferred as `string[]`
// D4917: a read over a union of lists with one literal-union element list (`.length`, an index,
// a `for`) dispatches on the stored arm, so each arm reads at its own rep; `is S[]` still tests
// a `string[]` arm's elements (D4779), and its then-branch keeps the union.
type S = "a" | "b"
function f(x: string[] | S[]) {
  print(x.length)
  print(x[0])
  for s in x { print(s) }
  if x is S[] { print(x.length + 10) }
}
function g(x: i32[] | S[]) {
  print(x.length)
  for s in x { print(s) }
}
function h(x: string[][] | S[][]) {
  for r in x { print(r.length) }
}
const v: string[] = ["a", "c"]
const w: S[] = ["b"]
const n: S[][] = [["a", "b"]]
f(v)
f(w)
g([7])
g(w)
h([["q"]])
h(n)
