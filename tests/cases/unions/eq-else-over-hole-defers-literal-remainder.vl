// @run
// An `==` test's else over an un-annotated parameter reads the parameter's type minus the tested
// literal at the pin, so a literal demand there does not pin the parameter itself (D16005).
type Color = "red" | "green"
function mkC(): Color { return "green" }
function onlyGreen(g: "green") { print(g) }
function take(p) {
  if p == "red" { print(1) } else { onlyGreen(p) }
}
function takeNe(p) {
  if p != "red" { onlyGreen(p) } else { print(1) }
}
type N = 1 | 2
function mkN(): N { return 2 }
function onlyTwo(g: 2) { print(g) }
function takeN(p) {
  if p == 1 { print(0) } else { onlyTwo(p) }
}
take(mkC())
takeNe(mkC())
takeN(mkN())
// @log green
// @log green
// @log 2
