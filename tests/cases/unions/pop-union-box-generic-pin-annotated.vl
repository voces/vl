// @run
// @log 2
// @log 2
// @hint redundant type annotation: `held` is inferred as `V | null` — remove it to lean on inference

// D1882's annotated face, in its own module because an annotated `V | null` parameter
// registers the flat spelling and rescues an un-annotated call in the same file — which is
// what would have made `pop-union-box-generic-pin.vl` green on the pre-fix compiler.

type V = i32 | string

function vs(): V[] { [1, 2] }

// The annotation names the union, so this pinned correctly before the fix and must keep to it.
function takeAnn(a: V | null) {
  if a is i32 { print(a) } else { print(0) }
}

const src = vs()
takeAnn(src.get(1))

// The same annotation on a BINDING, whose value then reaches an un-annotated parameter: the
// pin comes from the annotation channel here, not from the argument's arena row.
function take(a) {
  if a is i32 { print(a) } else { print(0) }
}

const src2 = vs()
const held: V | null = src2.get(1)
take(held)
