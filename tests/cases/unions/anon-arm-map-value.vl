// @run
// A map whose value type is an anonymous union arm, annotated or inferred from its first store,
// keeps one value slot for the arm across its declaration and every read and write (D4638).
type U = { q: i32 } | { r: i32 }
const empty: Map<string, { q: i32 }> = Map()
const annotated: Map<string, { q: i32 }> = Map()
annotated["k"] = { q: 4 }
const inferred = Map()
inferred["k"] = { r: 3 }
function local() {
  const m: Map<string, { q: i32 }> = Map()
  m["a"] = { q: 1 }
  m["b"] = { q: 2 }
  let s = 0
  for k in m.keys() { s = s + (m[k] ?? { q: 0 }).q }
  print(s)
  const u: U = m["a"] ?? { q: 9 }
  print(u is { q: i32 })
}
function fromParam(m: Map<string, { q: i32 }>) { (m["k"] ?? { q: 0 }).q }
print(empty.length)
print((annotated["k"] ?? { q: 0 }).q)
print((inferred["k"] ?? { r: 0 }).r)
local()
print(fromParam(annotated))
// @log 0
// @log 4
// @log 3
// @log 3
// @log true
// @log 4
