// @run
// @log 2
// @log 2
// @log a
// @log true
// @log 3
// @log z
// D4153: the `.map((x): J => x)` copy of a `J[][]` into a `J[]`, where each element is a whole
// inner list delivered into the recursive alias's own list arm. The reads prove the inner list
// kept its members (a string and a null) and the copy accepts a pushed string arm.
type J = null | string | J[]
const xs: J[][] = [["a", null], ["b"]]
const y: J[] = xs.map((x): J => x)
print(y.length)
const e = y[0]
if e is J[] {
  print(e.length)
  const s = e[0]
  if s is string { print(s) }
  print(e[1] == null)
}
y.push("z")
print(y.length)
const l = y[2]
if l is string { print(l) }
