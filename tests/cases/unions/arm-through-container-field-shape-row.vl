// @run
// @log 0
// @log 7
// @hint redundant type annotation: `gp` is inferred as `Circle`
// @hint redundant type annotation: `gp2` is inferred as `Circle`
// An ARM reached only THROUGH A CONTAINER in a field's type (silent-class-inventory D763):
// `type GW = { g: {[string]: Circle[]} }` where `Circle` is an arm of `Shape`. The field
// itself codes fine — it is the map — but the arm inside it still has no struct-table row,
// and the un-annotated CARRIER that fills the map renders its own value type structurally:
// `mvSlotOfValNameFind` was asked for `{r:null}[]` while the declared side had interned
// `Circle[]`, and the two never met ("map value type has no interned slot").
//
// THE ABLATION IS THE FIX. Declaring a plain-struct twin of the arm (`type Dot = { r: i32 |
// null }`) makes the program run on master, and so does deleting the union — both because
// they give the arm's layout a struct row for the render to field-set match. So the shape
// intern peels the field type's COMPOSITION wrappers (nullable, `[]` runs, map value) the way
// `internShapeDeep` already does, and mints the arm's own render at the leaf.
//
// It costs the module no heap type: `variantStructHeapTwinAt`'s anonymous-claimant rung
// merges the arm onto the row it just minted, so `mAssignTypeIndices` allocates once and the
// arm reuses it (`uVarHeap[vi] = sHeapIdx[uVarSTwinAt(vi)]`).
type Shape = Circle | Sq
type Sq = { s: i32 }
type Circle = { r: i32 | null }
type GW = { g: {[string]: Circle[]} }

function mkcall() {
  const lv1 = [{ r: null }]
  const cc = Map()
  cc["k0"] = lv1
  return cc
}

function mkhit() {
  const lv2 = [{ r: 7 }]
  const cc = Map()
  cc["k0"] = lv2
  return cc
}

const wv: GW = { g: mkcall() }
const g0 = (wv.g)["k0"] ?? []
if g0.length > 0 {
  const gp: Circle = g0[0]
  if gp.r != null { print(7) } else { print(0) }
} else { print(0) }

const wv2: GW = { g: mkhit() }
const g1 = (wv2.g)["k0"] ?? []
if g1.length > 0 {
  const gp2: Circle = g1[0]
  if gp2.r != null { print(7) } else { print(0) }
} else { print(0) }
