// @run
// @log s!
// @log null
// @log false
// @log false
// @log null
// @log 5
// @log null
// @log true
// @log false
// @log null
// @log false
// @log null
// @log false
// @log null
// @log true
// @log null

// D2588: once an `is` test leaves a value union at `boolean | null`, the null test reads the
// union's own tag. The survivor is still the box, not the `boolean | null` niche its type names.
function param(x: string | boolean | null) {
  if x is string { print(x + "!") }
  else if x == null { print("null") }
  else { print(!x) }
}

function notNull(x: string | boolean | null) {
  if x is string { print(x) }
  else if x != null { print(!x) }
  else { print("null") }
}

function wide(x: i32 | boolean | string | null) {
  if x is i32 { print(x + 1) }
  else if x is string { print(x) }
  else if x == null { print("null") }
  else { print(x) }
}

function coalesce(x: string | boolean | null) {
  if x is string { print(x) } else { print(x ?? false) }
}

function local(k: i32) {
  let x: f64 | boolean | null = 1.5
  if k == 1 { x = true }
  if k == 2 { x = null }
  if x is f64 { print(x) }
  else if x == null { print("null") }
  else { print(!x) }
}

function field(k: i32) {
  const p: { f: string | boolean | null } = { f: null }
  if k == 1 { p.f = true }
  if p.f is string { print(p.f) }
  else if p.f == null { print("null") }
  else { print(!p.f) }
}

function cell(k: i32) {
  const xs: (i64 | boolean | null)[] = [null]
  if k == 1 { xs[0] = true }
  if xs[0] is i64 { print(xs[0]) }
  else if xs[0] != null { print(!xs[0]) }
  else { print("null") }
}

function mapCell(k: i32) {
  const m: { [string]: string | boolean | null } = Map()
  if k == 1 { m["k"] = false }
  if m["k"] is string { print(m["k"]) }
  else if m["k"] == null { print("null") }
  else { print(!m["k"]) }
}

param("s")
param(null)
param(true)
notNull(true)
notNull(null)
wide(4)
wide(null)
wide(true)
coalesce(false)
local(2)
local(1)
field(0)
field(1)
cell(0)
mapCell(1)
mapCell(0)
