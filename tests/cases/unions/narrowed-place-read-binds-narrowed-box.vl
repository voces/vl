// @run
// @log 10
// @log 9
// @log 10
// @log 4
// @log 10
// @log 4
// @log 10
// An un-annotated `let` bound from a field or element read narrowed to a smaller box holds that
// box, so a write or a `!= null` test leaves `i32` and every read after it unboxes (D11160).
function field(w: { f: i32 | null | string }) {
  if !(w.f is string) {
    let c = w.f
    c = 9
    const f = () => c
    print(f() + 1)
    print(f())
  }
}
function fieldDirect(w: { f: i32 | null | string }) {
  if w.f is string { return 0 }
  let c = w.f
  c = 9
  print(c + 1)
  0
}
function fieldTest(w: { f: i32 | null | string }) {
  if !(w.f is string) {
    const c = w.f
    if c != null { print(c + 1) } else { print(0) }
  }
}
function nested(w: { g: { f: i32 | null | string } }) {
  if !(w.g.f is string) {
    let c = w.g.f
    c = 9
    const f = () => c
    print(f() + 1)
  }
}
function element(xs: (i32 | null | string)[]) {
  if !(xs[0] is string) {
    let c = xs[0]
    if c != null { print(c + 1) } else { print(0) }
    c = 9
    print(c + 1)
  }
}
field({ f: 3 })
fieldDirect({ f: 3 })
fieldTest({ f: 3 })
nested({ g: { f: 3 } })
element([3])
