// @run
// @log A
// @log B
// @warning Unused function `toS` (prefix with `_` to suppress, remove it, or `export` it)
// @hint redundant type annotation: `toS` is inferred as `string` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// @hint redundant type annotation: `f` is inferred as `string` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// Record arms sharing a field name (D4056): two arms that share one field and differ in another.
// `is` tests whether the value fits, field by field.
import { toString } from "std:fmt"

type A = { n: i32, k: i32 }
type B = { n: i32, k: string }
function pick(i: i32): A | B {
  if i == 0 {
    const a: A = { n: 1, k: 3 }
    return a
  }
  const b: B = { n: 2, k: "b" }
  b
}
function toS(x: i32): string { toString(x) }
function f(u: A | B): string {
  match u {
    A => "A"
    B => "B"
  }
}
print(f(pick(0)))
print(f(pick(1)))
