// @check
// KNOWN-BAD — xfail, the ANNOTATED twin of `xfail-narrowed-guard-binding-string-field.vl`.
// Same root cause (see that file's header for the full diagnosis and the 440-cell grid);
// this file pins the half of the family where the annotation is what BREAKS the cell rather
// than what saves it, because the two halves would otherwise be fixed one at a time.
//
// On the STRING field, `const nm: string = t.aName` is GREEN — the annotation pins the slot
// and the classifier never has to resolve the narrowed field type. On a NESTED-SHAPE field
// it is the opposite: `const nm: {b: i32} = t.aName` selects the struct slot from the
// annotation while the un-narrowed init classification disagrees, and the module fails to
// validate — `vl check` clean but for the redundant-annotation hint. THE VALIDATION MESSAGE
// IS A DIFFERENT ONE, and that is the point of keeping this cell separate:
// `expected (ref $type), found (ref null $type)`, a NULLABILITY mismatch rather than the
// string cell's `expected i32, found (ref $type)`. Drop the annotation and the SAME cell
// becomes a LOUD reject instead ("emitProgram: field access receiver is not a struct") —
// the same defect wearing a third face: the i32 default reaching an operator that can see
// it is wrong. One root cause, three symptoms; a fix graded on the string message alone
// would report two thirds of a result.
//
// Its controls are green and are carried below: the positive narrow with the identical
// annotated binding, and the direct read.
//
// NO `@hint` DIRECTIVE, and that is measured, not an oversight: the native `vl check` reports
// "redundant type annotation" on both annotated bindings, but the corpus oracle adjudicates
// hints against the LINT pass (`lintSrc`), which reports none — and it is strict in both
// directions, so declaring the hint FAILS the case. The two diagnostic surfaces are not the
// same set.
//
// TODO(emit-completeness): fixed by the same two edits — `pushPostGuardNarrow` in
// `emit_collect.collectLocals` and `setNarrowFromCondElse` in `collectLocalsIf`. When it
// lands, flip to `// @run` + three `// @log 3` and drop this note.

function mkA(): {aName: {b: i32}} { return { aName: { b: 3 } } }

// THE DEFECT: divergent guard + an ANNOTATED binding of a nested-shape field.
function guardBindAnn(t: {aName: {b: i32}} | {zz: boolean}) {
  if !(t is {aName: {b: i32}}) { return 0 }
  const nm: {b: i32} = t.aName
  return nm.b
}

// CONTROL 1 — the positive narrow, same annotated binding. Lowers correctly today.
function posBindAnn(t: {aName: {b: i32}} | {zz: boolean}) {
  if t is {aName: {b: i32}} {
    const nm: {b: i32} = t.aName
    return nm.b
  }
  return 0
}

// CONTROL 2 — the same guard, field used directly. Lowers correctly today.
function guardDirect(t: {aName: {b: i32}} | {zz: boolean}) {
  if !(t is {aName: {b: i32}}) { return 0 }
  return t.aName.b
}

function go() {
  const v: {aName: {b: i32}} | {zz: boolean} = mkA()
  print(guardBindAnn(v))
  print(posBindAnn(v))
  print(guardDirect(v))
}
go()
