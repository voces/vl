// @run
// @log 7
// AN UN-ANNOTATED LOCAL BOUND TO A NULVARIANT LIST ELEMENT (D814/D851).
//
// `(Circle | null)[]` interns as a kind-1 struct ref list whose element is a `(ref null
// $elem)` niche — and when `Circle` is a declared union's MEMBER, that element's heap is
// `uVarHeap[vi]`, not `sHeapIdx`, because `collectS` withholds an `sNames` row from a
// `type X = {…}` that a union names (D771's rung in `refArrShapeKind`).
//
// Both nullable-niche classifiers read that one slot, and only the STRUCT one had an
// `Index` arm. So this binding was claimed by `exprNullableStruct`, bound a kind-9
// `nulstruct` local whose struct row does not exist, and floored: `emitProgram: field
// access but no struct type declared` at `e0.r`, and `ref valtype with no interned shape`
// at the binding itself with no field read at all. `emitMem`'s nulvariant arm was present
// and correct the whole time — annotate the local (`const e0: Circle | null = a[0]`) and
// the same program ran, which is what said the gap was the LOCAL's rep and not the niche.
//
// The complement is the one `rlElemStructRow`'s nominal floor and `rlElemVariantRow`
// already state as a pair: a registered variant that is not a registered struct has no
// struct row, and `rlElemVariantRow` says which row it does have.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq

function f() {
  const a: (Circle | null)[] = [{ r: 7 }]
  const e0 = a[0]
  if e0 != null { print(e0.r) }
}

f()
