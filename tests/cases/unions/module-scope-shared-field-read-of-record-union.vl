// @run
// @log 1
// @log 7
// A module-scope binding of the field both arms of a record union share holds that field's own
// record union, and narrows like the same binding inside a function (D14221).
const a: { r: { c2: i32 } } | { r: { s2: i32 } } = { r: { c2: 1 } }
const x = a.r
if x is { c2: i32 } { print(x.c2) }
const b: { r: { c2: i32 } } | { r: { s2: i32 } } = { r: { s2: 7 } }
const y = b.r
if y is { s2: i32 } { print(y.s2) }
