// `Shape | null` WHERE `Shape` IS A DECLARED UNION ALIAS — the box with the null riding the
// tag, which is what `collectU` already documented for a `null` member ("a `null` atom rides
// the tag") and what the INLINE spelling of the same type always produced.
//
// THE TWO SPELLINGS DISAGREED. `Circle | Rect | null` written out compiled and ran; the
// identical type spelled `Shape | null` did not:
//
//     type mismatch: expected (ref null $type), found (ref $type)
//
// Canon flattens a union-ALIAS member of an outer union (`AB | null` → `A | B | null`) so the
// emitter sees one union rather than a nested one — but it rendered each member through
// `tyToEmitNameGo`'s `TyObj` arm, which has no NOMINAL rung: it spells a member as its SHAPE
// (`{kind:string,r:f64}`), anonymous and with the literal tag SOFTENED. So the alias spelling
// registered two ANONYMOUS shape variants unrelated to `Circle` and `Rect`. Two spellings of
// one type carrying two reps is the exact split the flatten exists to prevent, reintroduced
// one level down.
//
// The flatten now renders the DECLARED member spellings (`declaredStructUnionMembers`), which
// the declaration already holds in `udVariants`. That is a parser fact, not a shape match:
// reverse-mapping through `nominalNameOfObj` returns the FIRST structurally-equal user type,
// which is the wrong tag the moment two variants share a field set.
// @run
// @log 2
// @log -1
// @log 3
// @log -1

type Circle = { kind: "circle", r: f64 }
type Rect   = { kind: "rect", w: f64 }
type Shape  = Circle | Rect

// PARAM — `is` still dispatches on the box TAG here, because a nullable union has two or more
// non-null members and "not null" does not name which one.
function radius(s: Shape | null) {
  if s is Circle { return s.r }
  -1.0
}
const c: Circle = { kind: "circle", r: 2.0 }
print(radius(c))                     // 2
print(radius(null))                  // -1

// The INLINE spelling of the same type, which has always worked and must keep agreeing with
// the alias one above — same reps, same answers.
function radius2(s: Circle | Rect | null) {
  if s is Circle { return s.r }
  -1.0
}
const c2: Circle = { kind: "circle", r: 3.0 }
print(radius2(c2))                   // 3
print(radius2(null))                 // -1
