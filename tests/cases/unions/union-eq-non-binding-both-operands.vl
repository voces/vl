// @run
// @log true
// @log false
// @log true
// @log true
// @log true
// @log true
// @log true
// @log false
// @log true
// @log true
// @log true
// @log false
// @log true
// @log true
// @log true
// @log 2
// @hint redundant type annotation: `p` is inferred as `boolean`
// @hint redundant type annotation: `q` is inferred as `boolean`
// `==` over union values that are not bindings — if-expressions and call results: each operand
// is evaluated once and compared tag first, then payload, over the left union's arms (D2823).
function p(): boolean { true }
function q(): boolean { false }
function g(): i32 | string {
  if q() { 3 } else { "s" }
}
function h(): i32 | string | boolean {
  if q() { true } else { "s" }
}
function g3(): i32 | string {
  if p() { 3 } else { "s" }
}
print((if p() { 1 } else { "s" }) == (if p() { 1 } else { "t" }))
print((if p() { 1 } else { "s" }) == (if q() { 1 } else { "t" }))
print((if q() { 1 } else { "t" }) == (if q() { 2 } else { "t" }))
print((if q() { 1 } else { "t" }) != (if q() { 2 } else { "u" }))
print(g() == g())
print(g() == h())
print(h() == g())
print(g3() == h())
const a: i32 | string = 3
print(g3() == a)
print(a == g3())
type A = { a: i32 }
type B = { b: string }
type U = A | B
function mu(n: i32): U {
  if n == 0 { { a: 1 } } else { { b: "x" } }
}
print(mu(0) == mu(0))
print(mu(0) == mu(1))
print(mu(1) == mu(1))
print((if p() { 1.5 } else { "z" }) == (if p() { 1.5 } else { "z" }))
let calls = 0
function counted(): i32 | string {
  calls = calls + 1
  if p() { 3 } else { "s" }
}
print(counted() == counted())
print(calls)
