// @run
// @log BOTH-annot 1
// @log BOTH-infer 1
// @log WHILE 1
// @log DIVERGE 1
// @log THREE-both 1
// @log THREE-one true
// @log INDEX 1
// @log SIBLING 4
// @hint redundant type annotation: `y` is inferred as `i32 | string` — remove it to lean on inference
// THE ARM JOIN READS A PROPERTY PATH TOO (D1849). `narrow-arm-join.vl` is the bare-name half;
// a path's fact is an `npKeys` OVERLAY entry rather than a scope shadow, so the join installs a
// fresh overlay entry where the name half writes through `lookupDepth`.
//
// EVERY ROW DEMANDS THE MEMBER. `print(o.v)` after a join runs whether the join happened or the
// path widened back to its declaration, because the union box renders the same text — so each
// row uses a read the declaration cannot serve: `if o.v` needs a raw boolean, `t.v.length` a raw
// string, and the three-member row a destination the third arm would not fit.
//
// THE INDEX ROW IS NOT DECORATION. A member read's unbox follows the CHECKER's banked node type
// (`memReadCheckerAtomKind`), so the checker's join alone serves it; an INDEX read asks the
// EMITTER's narrowing stack (`indexUnionReadKind`), so it needs the emitter's own push and was
// check-clean invalid wasm until it got one.
import { toString } from "std:fmt"

type O = { v: i64 | boolean }
type T = { v: i32 | string | boolean }
type X = { xs: (i64 | boolean)[] }
type P = { v: i64 | boolean, w: i64 | boolean }

function mkO(): O { return { v: 3 } }

// Both arms write the same member: the join is that member.
function bothAnnot(o: O, c: boolean) {
  if o.v is i64 {
    if c { o.v = true } else { o.v = false }
    if o.v { return 1 }
    return 2
  }
  return 0
}
print("BOTH-annot " + toString(bothAnnot({ v: 3 }, true)))

function bothInfer(c: boolean) {
  const o = mkO()
  if o.v is i64 {
    if c { o.v = true } else { o.v = false }
    if o.v { return 1 }
    return 2
  }
  return 0
}
print("BOTH-infer " + toString(bothInfer(true)))

// The same join under a `while` head, whose body narrows a path since D1845.
function whileHead(o: O, c: boolean) {
  let r = 0
  while o.v is i64 {
    if c { o.v = true } else { o.v = false }
    if o.v { r = 1 } else { r = 2 }
  }
  return r
}
print("WHILE " + toString(whileHead({ v: 3 }, true)))

// An arm that DIVERGES contributes no path, so the surviving arm's own end type stands.
function diverge(o: O, c: boolean) {
  if o.v is i64 {
    if c { o.v = true } else { return 0 }
    if o.v { return 1 }
    return 2
  }
  return 0
}
print("DIVERGE " + toString(diverge({ v: 3 }, true)))

// A THREE-member field union: both arms write `string`, so the join is `string`, not the
// declaration — `.length` needs the raw string.
function threeBoth(t: T, c: boolean) {
  if t.v is i32 {
    if c { t.v = "s" } else { t.v = "tt" }
    return t.v.length
  }
  return 0
}
print("THREE-both " + toString(threeBoth({ v: 3 }, true)))

// …and with only ONE arm writing, the join is the PROPER SUBSET `i32 | string`: the other path
// still holds `i32`, and the third member is gone. The annotation is kept and its redundancy
// hint declared — inference naming `i32 | string` is the sharpest reading of the join there is.
function threeOne(t: T, c: boolean) {
  if t.v is i32 {
    if c { t.v = "s" }
    const y: i32 | string = t.v
    return y is string
  }
  return false
}
print("THREE-one " + toString(threeOne({ v: 3 }, true)))

// The INDEX key: the same join over `o.xs[0]`, which the emitter's own push is what serves.
function indexPath(o: X, c: boolean) {
  if o.xs[0] is i64 {
    if c { o.xs[0] = true } else { o.xs[0] = false }
    if o.xs[0] { return 1 }
    return 2
  }
  return 0
}
print("INDEX " + toString(indexPath({ xs: [3] }, true)))

// A SIBLING path written in both arms leaves this one's fact alone — the ledger is keyed by the
// path string, so `p.w` never joins `p.v`.
function sibling(p: P, c: boolean) {
  let r: i64 = 0
  if p.v is i64 {
    if c { p.w = true } else { p.w = false }
    r = p.v + 1
  }
  return r
}
print("SIBLING " + toString(sibling({ v: 3, w: 4 }, true)))
