// @emit-error internal: an emit-phase write changed a type an emit memo may hold
// A call returning a `let x = null` a hole parameter fills, compared with `null`, is refused, never
// folded at the checker's `null` to a wrong `true` (D17850).
function f(a) {
  let t = null
  t = a
  return t
}
print(f(1) == null)
