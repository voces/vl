// @run
// @log 2
// @log 2
// @log 2
// @log 0
// @log 105
// @hint redundant type annotation: `sumNode` is inferred as `i32`
// An inferred return of a self-referential union, plain and nullable: a call's result passed
// on, a join of a `Node` with `null`, and a chain read back through the field (D5104).
type Node = { v: i32, next: Node | null } | { e: i32 }
function sumNode(n: Node | null): i32 {
  if n == null { return 0 }
  if n is { e: i32 } { return n.e * 100 }
  return n.v + sumNode(n.next)
}
function mk(k: i32): Node | null {
  const t: Node = { v: k, next: null }
  return t
}
function mkPlain(k: i32): Node {
  const t: Node = { v: k, next: null }
  return t
}
function deliver() { return mk(2) }
function deliverPlain() { return mkPlain(2) }
function pick(k: i32) {
  if k > 5 { return null }
  const t: Node = { v: k, next: null }
  return t
}
function chain() {
  const tail: Node = { e: 1 }
  const top: Node = { v: 5, next: tail }
  return top
}
print(sumNode(deliver()))
print(sumNode(deliverPlain()))
print(sumNode(pick(2)))
print(sumNode(pick(7)))
print(sumNode(chain()))
