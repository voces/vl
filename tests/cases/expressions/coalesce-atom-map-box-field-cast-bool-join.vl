// @run
// @log b
// @log 6
// @log 0
// @log s
// @log 5
// @log false
// `??` shapes the IR builds by legacy's writers: an atom map read into a hole union, a field read
// off a box narrowed to one record arm, and a `boolean | null` whose default joins a union box.
type AB = "a" | "b"
function use(p) { print(p.m[9] ?? 3) }
const mm: {[i32]: AB} = Map()
mm[1] = "a"
mm[9] = "b"
use({ m: mm })
type J = { r: i32 | null }
function take(u: J | string) {
  if u is J { print(u.r ?? 0) } else { print(u) }
}
take({ r: 6 })
take({ r: null })
take("s")
function none(): boolean | null { return null }
function no(): boolean | null { return false }
function joined(f: () => boolean | null) {
  const i = f() ?? 5
  if i is i32 { print(i) } else { print(i) }
}
joined(none)
joined(no)
