// @run
// @log 6
// @log 66
// @log 7
// @log 77
// @log 2.5
// @log 2.5
// @log ab
// @log ab
// @log 9
// @log 999
// @log 6
// @log cd
// A store whose value is another field or element store writes both places with the one value:
// one row per pair of places and per position such a chain is written in, a map entry among them.
type R = { n: i32, f: f64, s: string }
const xs = [0, 0]
const r: R = { n: 0, f: 0.0, s: "" }
// an element into a field
r.n = xs[1] = 6
print(r.n)
print(xs[1] * 11)
// a field into an element
xs[0] = r.n = 7
print(xs[0])
print(r.n * 11)
// an f64 field from an f64 element
const fs = [0.0]
r.f = fs[0] = 2.5
print(fs[0])
print(r.f)
// a string field from a string element
const ss = [""]
r.s = ss[0] = "ab"
print(r.s)
print(ss[0])
// three places in one chain, in a function body
function chain(ys: i32[], q: R) {
  q.n = ys[0] = ys[1] = 9
  print(q.n)
  print(ys[0] * 100 + ys[1] * 10 + q.n)
}
chain([0, 0], r)
// a map entry from an element store
const mi: {[i32]: i32} = Map()
const ik = 3
mi[ik] = xs[1] = 6
print(mi[3] ?? 0)
// a string map entry keyed by a local, from a field store
const ms: {[string]: string} = Map()
let sk = "x"
sk = "k"
ms[sk] = r.s = "cd"
print(ms["k"] ?? "-")
