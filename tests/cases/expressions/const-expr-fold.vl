// @run
// @log 24
// @log 0
// @log 0
// @log -2147483648
// @log -9223372036854775808
// @log -1206248790
// A module `const` whose initializer is an integer constant expression over literals and
// other such consts is folded at compile time (plumb PL-069). Each folded const is compared
// with the same expression computed at run time from parameters, so a fold that wraps, masks
// a shift count or rounds a division differently from the runtime prints a mismatch.
const A = 16
const B = A + 8
const MAX = 2147483647
const MIN = -2147483647 - 1
const S = 33
const N7 = -7

const ADD = MAX + 1
const SUB = MIN - 1
const MUL = MAX * 3
const NEG = -MIN
const NOT = ~A
const AND = N7 & 0xff
const OR = A | 3
const XOR = N7 ^ A
const SHL = 1 << S
const SHR = N7 >> S
const USHR = N7 >>> 1
const DIV = N7 / 2
const REM = N7 % 2
const MINREM = MIN % 3
const MIX = ((A << 4) - B * 3 + (MAX >>> 28)) ^ ~(N7 % 4)

const A64 = 16 as i64
const B64 = A64 + (8 as i64)
const MAX64 = 9223372036854775807
const MIN64 = -MAX64 - (1 as i64)
const S64 = 65 as i64
const N64 = (N7 as i64) * (1000000000000 as i64)

const ADD64 = MAX64 + (1 as i64)
const SUB64 = MIN64 - (1 as i64)
const MUL64 = MAX64 * (3 as i64)
const NEG64 = -MIN64
const NOT64 = ~A64
const AND64 = N64 & 0xffffffff
const OR64 = A64 | (3 as i64)
const XOR64 = N64 ^ A64
const SHL64 = (1 as i64) << S64
const SHR64 = N64 >> S64
const USHR64 = N64 >>> (1 as i64)
const DIV64 = N64 / (7 as i64)
const REM64 = N64 % (3000000000 as i64)
const WIDE = (MIN as i64) - (1 as i64)
const LOW = 0xb81a1aaa as% i32
const HEX = (0 as i64) + 0xFFFFFFFF
const HEXC = 0xFFFFFFFF as i64
const NARROW = (A64 + (1 as i64)) as! i32
const NEGC = (-0xffffffff) as i64
const NEGP = ((-(0xffffffff))) as! i64
const NEGW = (-0x1ffffffff) as% i32

function add(a: i32, b: i32) { a + b }
function sub(a: i32, b: i32) { a - b }
function mul(a: i32, b: i32) { a * b }
function neg(a: i32) { -a }
function not(a: i32) { ~a }
function and(a: i32, b: i32) { a & b }
function or(a: i32, b: i32) { a | b }
function xor(a: i32, b: i32) { a ^ b }
function shl(a: i32, b: i32) { a << b }
function shr(a: i32, b: i32) { a >> b }
function ushr(a: i32, b: i32) { a >>> b }
function div(a: i32, b: i32) { a / b }
function rem(a: i32, b: i32) { a % b }

function add64(a: i64, b: i64) { a + b }
function sub64(a: i64, b: i64) { a - b }
function mul64(a: i64, b: i64) { a * b }
function neg64(a: i64) { -a }
function not64(a: i64) { ~a }
function and64(a: i64, b: i64) { a & b }
function or64(a: i64, b: i64) { a | b }
function xor64(a: i64, b: i64) { a ^ b }
function shl64(a: i64, b: i64) { a << b }
function shr64(a: i64, b: i64) { a >> b }
function ushr64(a: i64, b: i64) { a >>> b }
function div64(a: i64, b: i64) { a / b }
function rem64(a: i64, b: i64) { a % b }
function widen(a: i32) { a as i64 }
function low(a: i64) { a as% i32 }

function miss(k: i32, got: i32, want: i32) {
  if got == want { return 0 }
  print("i32 mismatch \{k}: folded \{got}, runtime \{want}")
  1
}

function miss64(k: i32, got: i64, want: i64) {
  if got == want { return 0 }
  print("i64 mismatch \{k}: folded \{got}, runtime \{want}")
  1
}

function check32(a: i32, b: i32, max: i32, min: i32, s: i32, n7: i32) {
  let m = 0
  m = m + miss(0, B, add(a, 8))
  m = m + miss(1, ADD, add(max, 1))
  m = m + miss(2, SUB, sub(min, 1))
  m = m + miss(3, MUL, mul(max, 3))
  m = m + miss(4, NEG, neg(min))
  m = m + miss(5, NOT, not(a))
  m = m + miss(6, AND, and(n7, 0xff))
  m = m + miss(7, OR, or(a, 3))
  m = m + miss(8, XOR, xor(n7, a))
  m = m + miss(9, SHL, shl(1, s))
  m = m + miss(10, SHR, shr(n7, s))
  m = m + miss(11, USHR, ushr(n7, 1))
  m = m + miss(12, DIV, div(n7, 2))
  m = m + miss(13, REM, rem(n7, 2))
  m = m + miss(14, MINREM, rem(min, 3))
  const mix = xor(sub(shl(a, 4), mul(b, 3)) + ushr(max, 28), not(rem(n7, 4)))
  m = m + miss(15, MIX, mix)
  m = m + miss(16, LOW, low(0xb81a1aaa))
  m = m + miss(17, NARROW, low(add64(a as i64, 1 as i64)))
  m = m + miss(18, NEGW, low(neg64(0x1ffffffff)))
  m
}

function check64(a: i64, max: i64, min: i64, s: i64, n: i64) {
  let m = 0
  m = m + miss64(0, B64, add64(a, 8 as i64))
  m = m + miss64(1, ADD64, add64(max, 1 as i64))
  m = m + miss64(2, SUB64, sub64(min, 1 as i64))
  m = m + miss64(3, MUL64, mul64(max, 3 as i64))
  m = m + miss64(4, NEG64, neg64(min))
  m = m + miss64(5, NOT64, not64(a))
  m = m + miss64(6, AND64, and64(n, 0xffffffff))
  m = m + miss64(7, OR64, or64(a, 3 as i64))
  m = m + miss64(8, XOR64, xor64(n, a))
  m = m + miss64(9, SHL64, shl64(1 as i64, s))
  m = m + miss64(10, SHR64, shr64(n, s))
  m = m + miss64(11, USHR64, ushr64(n, 1 as i64))
  m = m + miss64(12, DIV64, div64(n, 7 as i64))
  m = m + miss64(13, REM64, rem64(n, 3000000000 as i64))
  m = m + miss64(14, WIDE, sub64(widen(-2147483647 - 1), 1 as i64))
  m = m + miss64(15, HEX, add64(0 as i64, 0xFFFFFFFF))
  m = m + miss64(16, HEXC, widen(0) + 0xFFFFFFFF)
  m = m + miss64(17, NEGC, neg64(0xffffffff))
  m = m + miss64(18, NEGP, neg64(0xffffffff))
  m
}

function show() { __load_i64__(B) }

print(B)
print(check32(16, 24, 2147483647, -2147483647 - 1, 33, -7))
print(
  check64(
    16 as i64,
    9223372036854775807,
    -9223372036854775807 - (1 as i64),
    65 as i64,
    (-7 as i64) * (1000000000000 as i64),
  ),
)
print(ADD)
print(ADD64)
print(LOW)
show()
