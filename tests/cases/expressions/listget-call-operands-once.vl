// @run
// @log 7
// @log 1
// @log 3
// @log 1
// @log 8
// @log 2
// @log 3
// @log 2
// @log 4
// @log 1
// @hint redundant type annotation: `base` is inferred as `{w: i32}[]` — remove it to lean on inference

// D1677/D1681 — `.get` evaluates its index and its receiver ONCE. Both are emitted twice, for
// the bounds compare and again for the element read, so an operand that is not a re-readable
// place is staged in the frame's `.get` stash. Every cell calls its helper ONCE in the source
// and prints the counter, so the pin is the COUNT: a re-evaluation prints 2 and this reds.
type S = { w: i32 }
type B = { y: S[] }

let n = 0

const iv = [7, 8]
const base: S[] = [{ w: 3 }, { w: 5 }]

function ix() {
  n = n + 1
  0
}

function ix1() {
  n = n + 1
  1
}

function ivr() {
  n = n + 1
  iv
}

function recv(): S[] {
  n = n + 1
  base
}

function mk(): B | null { { y: [{ w: 4 }] } }

// A scalar list, a CALL index — the gate `takeIdxRefusal` used to own.
function idxCall() {
  n = 0
  print(iv.get(ix()) ?? 0)
  n
}
print(idxCall())

// A ref list, a CALL receiver — the shared resolver's `local or struct field` gate.
function recvCall() {
  n = 0
  const e = recv().get(0)
  if e != null { print(e.w) } else { print(0) }
  n
}
print(recvCall())

// Both at once on a scalar list, and again through the fused arm: two calls each, one
// evaluation each, so the counter reads 2.
function bothCall() {
  n = 0
  print(ivr().get(ix1()) ?? 0)
  n
}
print(bothCall())

// The fused `xs.get(i)?.f ?? d` arm, which carries its own copy of both gates.
function fused() {
  n = 0
  print(recv().get(ix())?.w ?? 0)
  n
}
print(fused())

// D1681 — the un-annotated CELL of a `?.` whose leaf is a ref list. The annotated spelling
// already ran; this is the binding whose inner ref-list row had no resolver.
function refLeaf() {
  n = 0
  const b = mk()
  const v = b?.y
  if v != null { print(v[0].w) } else { print(0) }
  n + 1
}
print(refLeaf())
