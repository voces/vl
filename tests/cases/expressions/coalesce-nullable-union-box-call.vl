// @run
// @log s
// @log 1
// @log d
// @log 2
// @log s
// @log 0
// @log d
// @log 1
// @log 9
// @hint redundant type annotation: `dflt` is inferred as `string`
// D960 — THE CALL-OPERAND HALF. A re-readable operand is REWRITTEN to an `if` (D962); a call
// operand cannot be, because the desugaring names the operand twice and evaluating a call
// twice is a different program. So it keeps its `??` node and takes a real emit arm.
//
// THE COUNTERS ARE THE POINT. The whole re-readability rule exists to protect
// evaluate-once, so this fixture measures it rather than asserting it: `calls` proves the
// operand runs exactly once per `??`, and `defs` proves the default runs only when the value
// is null.
let calls = 0
function mk(b: boolean): string | i32 | null {
  calls = calls + 1
  if b { return "s" }
  null
}

print(mk(true) ?? "d")
print(calls)
print(mk(false) ?? "d")
print(calls)

let defs = 0
function dflt(): string {
  defs = defs + 1
  "d"
}

print(mk(true) ?? dflt())
print(defs)
print(mk(false) ?? dflt())
print(defs)

// An i32 default, so a fix returning the box payload at one fixed rep cannot pass.
print(mk(false) ?? 9)
