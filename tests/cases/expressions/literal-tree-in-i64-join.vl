// @run
// @log 2147483648
// @log 2147483648
// @log 2147483648
// @log 2147483648
// @log 2147483648
// A tree of literals beside an `i64` in a join is its exact value, 2^31, whether the join is a
// list, a value `if`, a `match` or a nullable list (D3054).
function f(x: i64, c: boolean, k: i32) {
  const xs = [x, -(-0x80000000)]
  print(xs[1])
  const b = if c { x } else { 2147483647 + 1 }
  print(b)
  const a = match k {
    1 => x
    _ => 2147483647 + 1
  }
  print(a)
  const ns = [x, null, 2147483647 + 1]
  print(ns[2] ?? 0)
  const ys = [x, 2147483647 + 1]
  print(ys[1])
}
f(1, false, 0)
