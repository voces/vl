// @run
// @log 5 5
// @log 2
// @log 3
// @log 11
// @log 9
// @log 3
// @log 4
// @log 2
// @log 6
// @log 2
// @log 3.5
// @hint redundant type annotation: `a` is inferred as `f64`
// @hint redundant type annotation: `f` is inferred as `string`
// @hint redundant type annotation: `g` is inferred as `f64`
// @hint redundant type annotation: `seven` is inferred as `i32`
// @hint redundant type annotation: `q` is inferred as `i32`
// @hint redundant type annotation: `src` is inferred as `i32[]`
// @hint redundant type annotation: `t` is inferred as `{n: i32}`
// @hint redundant type annotation: `bump` is inferred as `i32`
// @hint redundant type annotation: `m` is inferred as `f64`
// D2398: an assignment to a name whose storage is wider than the right side yields the right
// side, at its own type. The name is re-read at its storage, so the write moves ahead of the
// statement that uses its value and that statement reads the value it stored.
type S = { n: i32 }
function f(): string {
  let a: f64 = 1.5
  const r = (a = 5)
  "\{a} \{r}"
}
print(f())
function half(v: i32) { v / 2 }
let g: f64 = 0.5
print(half(g = 5))
let big: i64 = 1
const seven: i32 = 7
const q: i32 = (big = seven)
print(q / 2)
let xs: i32[] | null = null
const src: i32[] = [4, 6]
const ys = (xs = src)
ys[0] = 9
print(src[0] + ys.length)
let s: S | null = null
const t: S = { n: 7 }
const u = (s = t)
u.n = 9
print(t.n)
let k: i32 | string = "s"
const w = [(k = seven)]
print(w[0] / 2)
function bump(): i32 { g = 9 }
print(bump() / 2)
function arm(c: boolean) {
  if c { g = 4 } else { g = 5 }
}
print(arm(true) / 2)
let m: f64 = 0.5
let local = 0
local = (m = 13)
print(local / 2)
const box: { [string]: i32 } = Map()
box["k"] = (m = 5)
print((box["k"] ?? 0) / 2)
if (m = 7) == 7 { print(m / 2.0) }
