// @run
// @log d
// @log s
// @log 7
// CONTRACT (D962, closing half of D960): `x ?? d` where `x` is a nullable VALUE-UNION box
// (`string | i32 | null`). Every piece already worked — `v == null` lowers over this rep,
// `if v != null` narrows, the default boxes — and only the `??` dispatch did not reach them:
// the hand-written `if v != null { return v }; "d"` ran while the `??` spelling refused.
//
// IT IS A REWRITE, NOT AN EMIT ARM, AND THAT WAS MEASURED THE HARD WAY. Two emit arms were
// built (D960). The second emitted a perfectly correct `(if (result (ref $box)) …)` and the
// RETURN PATH wrapped it in a second `struct.new $box` — because, as `emit_rewrite`'s own
// `??` header says, "every consumer classifier dispatches on the `??` NODE". Desugaring
// leaves no node to classify, so the question cannot arise.
//
// RE-READABLE OPERANDS ONLY, and here that is a CORRECTNESS bound: the desugaring names the
// operand twice. A CALL left operand keeps the refusal, which D960 stays open for — and
// `coalesce-over-nullable-union.vl` in the probe directory is that remaining half.
//
// Three cells: the null branch takes the default, the non-null branch keeps a STRING arm, and
// the non-null branch keeps an I32 arm — the last because a fix that returned the box's
// payload at one fixed rep would pass the first two.
function mk(b: boolean, n: boolean): string | i32 | null {
  if !b { return null }
  if n { return 7 }
  "s"
}

function pick(b: boolean, n: boolean): string | i32 {
  const v = mk(b, n)
  v ?? "d"
}

function show(b: boolean, n: boolean) {
  const r = pick(b, n)
  if r is string { print(r) } else { print(r) }
}

show(false, false)
show(true, false)
show(true, true)
