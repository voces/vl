// @run
// @log -4294967295
// @log -4294967295
// @log -4294967295
// @log 1
// @hint redundant type annotation: `n` is inferred as `i32` — remove it to lean on inference
// A chain of negations over a hex literal is a constant, so every negation parity under `as% i64`
// reads the same value, -0xFFFFFFFF; at an `i32` the pattern keeps its 32-bit reading (D3053).
const b = (-(-(-0xFFFFFFFF))) as% i64
print(b)
print((-0xFFFFFFFF) as% i64)
function lw() { (-(-(-0xFFFFFFFF))) as% i64 }
print(lw())
const n: i32 = -(-(-0xFFFFFFFF))
print(n)
