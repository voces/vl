// @run
// @log 3
// @log -1
// @log 15
// @log 7
// @log 8
// A standalone `?.` whose leaf field is a function value yields the closure's own nullable ref
// (D16036): the function is called through it, captured environment and all.
type B = { y: () => i32 }
function mk(): B | null { { y: () => 3 } }
function none(): B | null { null }
const v = mk()?.y
if v != null { print(v()) } else { print(-1) }
const w = none()?.y
if w != null { print(w()) } else { print(-1) }
type C = { y: (n: i32) => i32 }
function mkC(k: i32): C | null { { y: (n: i32) => n + k } }
const c = mkC(10)?.y
if c != null { print(c(5)) }
type A = { b: B | null }
const a: A | null = { b: { y: () => 7 } }
const deep = a?.b?.y
if deep != null { print(deep()) }
function callOr(f: (() => i32) | null) {
  if f != null { return f() + 1 }
  0
}
const e: B | null = { y: () => 7 }
print(callOr(e?.y))
