// @log false
// @log false
// @log false
// @hint redundant type annotation: `gAnn` is inferred as `() => B | null`
// @hint Intentionally-unused variable `_done` (leading `_` marks it unused)
// D1667 — the `?.` receiver, one cell per emitter pre-pass that walks a `.` receiver.
//
// `emitOptChainIsNull` lowers a `?.` receiver exactly as `emitMem` lowers a `.` one, so the
// frame the receiver needs is the enclosing function's. Seven pre-passes claimed `Member`
// and not `OptMember`, and four of them have no "frame not reserved" floor: the body ran
// `local.set` against a local the vector never declared, at `vl check` rc 0.
//
// One cell per pre-pass — a function-value call, `__array_new__`, `.slice`, `.pop()`,
// `m.keys()`, `.map`, a lambda argument — each the only use of its own frame in its own
// frame, so nothing else reserves it. Both spellings of the function-value binding are
// pinned, since an annotation is what the inferred face cannot rely on.
type B = { y: i32 }

function pick(n: i32): B | null { { y: n } }

function pickS(s: string): B | null { { y: s.length } }

function pickF(f: (i32) => i32): B | null { { y: f(1) } }

function sv() { "abcd" }

function inc(v: i32) { v + 1 }

function mkB(): B | null { { y: 7 } }

const g = mkB
const gAnn: () => B | null = mkB
const nums = [1, 2]
const popper = [1, 2]
const m: {[string]: i32} = Map()
m["a"] = 1

// The start function's own frame.
print(g()?.y == null)
print(gAnn()?.y == null)
print(pick(__array_new__(2, 5).length)?.y == null)
print(pickS(sv().slice(1, 3))?.y == null)
print(pick(popper.pop() ?? 0)?.y == null)
print(pick(m.keys().length)?.y == null)
print(pick(nums.map(inc).length)?.y == null)
print(pickF((v: i32) => v + 1)?.y == null)

// A user function's frame, reserved by `fnDetectScratch` through the same pre-passes.
function inFn() {
  const gf = mkB
  const xs = [1, 2]
  const mm: {[string]: i32} = Map()
  mm["b"] = 2
  print(gf()?.y == null)
  print(pick(__array_new__(3, 6).length)?.y == null)
  print(pickS(sv().slice(0, 2))?.y == null)
  print(pick(xs.pop() ?? 0)?.y == null)
  print(pick(mm.keys().length)?.y == null)
  print(pick(xs.map(inc).length)?.y == null)
  print(pickF((v: i32) => v * 2)?.y == null)
  true
}

const _done = inFn()
