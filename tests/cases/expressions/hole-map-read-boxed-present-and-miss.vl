// @run
// @log 5
// @log null
// @log true
// @log false
// @log null
// @log null
// @log b
// @log null
// @log 7
// @log true
// @log true
// @log false
// @log null
// A map read boxed into a hole union carries its value, or `null` on a miss, for every value kind:
// a scalar, a `boolean | null` (its `true`, its `false` and its own `null`), an atom and a record.
type AB = "a" | "b"
type P = { k: i32 }
function show(x) { print(x) }
function reads(p) {
  show(p.i[1])
  show(p.i[9])
  show(p.b[1])
  show(p.b[2])
  show(p.b[3])
  show(p.b[9])
  show(p.n[1])
  show(p.n[9])
}
const i: {[i32]: i32} = Map()
i[1] = 5
const b: {[i32]: boolean | null} = Map()
b[1] = true
b[2] = false
b[3] = null
const n: {[i32]: AB} = Map()
n[1] = "b"
reads({ i: i, b: b, n: n })
function rec(q) {
  const r = q.r[1]
  show(if r != null { r.k } else { 0 })
  show(q.r[9] == null)
}
const rm: {[i32]: P | null} = Map()
rm[1] = { k: 7 }
rec({ r: rm })
function joined(p) {
  show(p.b[1] ?? 3)
  show(p.b[2] ?? 3)
  show(p.b[3])
}
joined({ b: b })
