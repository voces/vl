// @run
// @log 4
// @log 7
// @log 2
// @log x
// @log dflt
// @log dflt
// A union-field `??` read off a call, once, and a `string | null` `??` over an if-expression with
// a literal default, each run for its value.
type J = { r: i32 | null, g: i32 }
let calls = 0
function mk(v: i32 | null): J {
  calls = calls + 1
  return { r: v, g: 1 }
}
function readOff() {
  print(mk(4).r ?? 0)
  print(mk(null).r ?? 7)
  print(calls)
}
readOff()
function pick(c: boolean, s: string | null) {
  print((if c { s } else { null }) ?? "dflt")
}
pick(true, "x")
pick(true, null)
pick(false, "y")
