// @log -2
// @log -2
// @log -2
// @log -2
// @log 7
// @log 2
// @log 5
// @log hi
// A field or element assignment used as a value yields its right side, as a name's does: the
// place keeps the stored width and the value is read back at the right side's (D14820).
type R = { v: i64, n: i32, f: f64, s: string }
const o: R = { v: 0, n: 0, f: 0, s: "" }
const a: i64[] = [0]
function take(z: i32) { print(z) }

const r1 = (o.v = 0xfffffffe)
print(r1)
print(o.v)
const r2 = (a[0] = 0xfffffffe)
print(r2)
print(a[0])

function retField() { return (o.v = 0xfffffffe) }
print(retField())
function retElem() { return (a[0] = 0xfffffffe) }
print(retElem())

take(o.v = 0xfffffffe)
print(o.v)
take(a[0] = 0xfffffffe)

function bindField() {
  const b = (o.v = 0xfffffffe)
  print(b)
}
bindField()
function bindElem() {
  const b = (a[0] = 0xfffffffe)
  print(b)
}
bindElem()
print(a[0] = 0xfffffffe)

print(o.n = 7)
print((o.f = 5) / 2)
print(o.f)
function strField() {
  const t = (o.s = "hi")
  print(t)
}
strField()
