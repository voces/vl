// @run
// @log y
// @log 5000000000
// @log 2
// @log ran
// @log 16
// @log a!
// @log b
// @log q
// @log x
// @log null
// @log x
// @log r
// @log 2
// @log 5
// `??` arms whose answer the operand's type decides, string defaults that compute or decode an
// atom, and module-scope places over a global receiver, each run for its value.
type K = "x" | "y"
type W = 1 | 2 | 5000000000
const wa: W = 5000000000
const wb: W = 2
function strOr(f) { print(f() ?? "q") }
strOr(() => "y")
function orZero(f) { print(f() ?? 0) }
orZero(() => wa)
orZero(() => wb)
function nothing() {
  print("ran")
  return null
}
function viaNothing() { return nothing() ?? 16 }
print(viaNothing())
function fill(s: string | null, t: string) { return s ?? t + "!" }
print(fill(null, "a"))
print(fill("b", "a"))
function g(sn: string | null, kn: K | null) {
  const v = sn ?? kn
  print(v)
}
const kn0: K | null = "x"
g("q", kn0)
g(null, kn0)
g(null, null)
function one(f: () => "x" | null, d: string) { return f() ?? d }
print(one(() => "x", "r"))
print(one(() => null, "r"))
type T = { v: i32, left: T | null }
const kept: T = { v: 1, left: { v: 2, left: null } }
print(kept.left?.v ?? 0)
const m: i32 | null = 4
print((m ?? (1 << 40)) + 1)
