// @run
// @log 3
// @log 9
// @warning this `??` default is never used: the `stack.length` test guarantees this first `stack.pop()` returns a value — drop the `??` and its default
// diderven DV-301 — under a `.length` test the first `pop()` yields the element (D3558), so the
// `??` default is dead; the warning names that guard rather than calling `i32` never null.
const stack = [3]
while stack.length > 0 {
  const i = stack.pop() ?? 0
  print(i)
}
const t = [9]
if t.length >= 1 { print(t.pop() as! i32) }
