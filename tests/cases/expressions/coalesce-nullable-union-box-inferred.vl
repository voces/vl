// @run
// @log s
// @log d
// @log 9
// @log s
// @log d
// @log 1
// @hint redundant type annotation: `f` is inferred as `i32`
// D969 — THE UN-ANNOTATED TWIN of `coalesce-nullable-union-box.vl`, and the reason it exists:
// that fixture routes every cell through an annotated `pick(): string | i32`, so the
// annotation pins the cell and seeds the coercion. Remove the annotation and the same
// program was `vl check` rc 0 and INVALID WASM — D962 traded a clause-2 loud refusal for a
// clause-1 miscompile, and its own fixture structurally could not see it.
//
// A fixture that annotates every destination cannot see a defect whose ingredient is the
// MISSING annotation. Every binding below is deliberately un-annotated.
function mk(b: boolean): string | i32 | null {
  if b { return "s" }
  null
}

// The binding form, both branches.
const t = mk(true)
const v = t ?? "d"
print(v)

const t2 = mk(false)
const v2 = t2 ?? "d"
print(v2)

// An i32 default, so a fix that returned the box payload at one fixed rep cannot pass.
const t3 = mk(false)
const v3 = t3 ?? 9
print(v3)

// The bare argument form — no binding at all, so `print` itself has to coerce the `if`.
const t4 = mk(true)
print(t4 ?? "d")

// The same inside a function, where the cell is a LOCAL rather than a global.
function f(b: boolean): i32 {
  const t5 = mk(b)
  const v5 = t5 ?? "d"
  print(v5)
  1
}
print(f(false))
