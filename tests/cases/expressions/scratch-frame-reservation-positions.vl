// @run
// @log 3
// @log 2
// @log 5
// @log true
// @log true
// @log 4
// @log 7
// @log 0
// @log 3
// @log 3
// @log 2
// @log 3
// @log 3
// @log 2
// @log 3
// @log 0
// THE START FUNCTION'S SCRATCH-FRAME RESERVATION, pinned by POSITION — the
// call-LHS `??` stash (`coalesceCallSlot`/`StrSlot`/`BoolSlot`), the array-intrinsic
// length slot (`arrNewScratchBase`), the string-op frame (`strScratchBase`), the
// map frame and the push/pop quad — plus the position family that used to be
// missing and is now taught.
//
// None of these handlers has a "frame not reserved" floor (only the ref-list
// compare arm does), so a position the scan does not walk emits `local.set`
// against a local the locals vector never declared: INVALID WASM with
// `vl check` rc 0.
//
// NOW TAUGHT — a TOP-LEVEL `while` CONDITION or `for`-RANGE BOUND.
// `startFnDetectScratch` handed a `WhileStmt` and a `ForRange` only their BODY to
// `startScanBlock`; `whileCond`, `frFrom` and `frTo` were scanned by nobody. The
// `ForIn` arm beside them compensated by hand-scanning `st.fiIter` with four of
// the walkers and the `IfStmt` arm hand-scanned `st.ifCond` with five — so of the
// four header positions one got five walkers, one got four, and two got none. The
// in-function twins ARE covered (`blockHasArrNew` / `blockHasCoalesceCall` /
// `blockHasMapOp` / `blockPushPopBits` / `blockHasStrOp` all walk `whileCond` /
// `frFrom` / `frTo`), which is why this hid.
//
// All four headers now run through ONE helper, `startScanHeaderExpr`, with the
// full walker set — which also adds `exprPopBits` + `collectMemberPopRefSlotsExpr`
// to the `for`-in iterable and `collectMemberPopRefSlotsExpr` to the `if`
// condition. A `for`-range `step` is deliberately not scanned: a non-constant step
// is a clean emit reject ("for-range step must be a constant integer").
//
// 13 cells measured over position {`while` cond, `for`-range `from`, `for`-range
// `to`} x frame {call-LHS `??`, `__array_new__`, map, string-op, push/pop}, each
// invalid wasm alone and correct with one more use of the same frame beside it.
//
// STILL NOT WALKED — measured on 6746f12:
//
//   1. AN if-EXPRESSION ARM. An if-expression is an `IfStmt` node sitting in a
//      value slot (`exprIsIfStmt`); `emitExpr` lowers its arms through the
//      ordinary path. `exprHasArrNew`, `exprHasCoalesceCall` and `leqScanExpr`
//      have no `IfStmt` arm and fall off the end of their dispatch.
//      `blockHasCallRef` HAS one — same family, one member taught.
//
//          const v = if c then g(n) ?? 0 else 0      // g(): i32 | null
//
//   2. THE MIDDLE OPERAND OF A `??` CHAIN. `a ?? b ?? d` parses as `(a ?? b) ?? d`
//      and `emitCoalesce` RE-ASSOCIATES it to `a ?? (b ?? d)`, minting a new
//      `BinExpr` in which `b` is a `??` LHS. `exprHasCoalesceCall` only ever asks
//      whether a `??`'s `binLeft` is a Call — it never asks about `binRight`, and
//      the re-associated node does not exist when the scan runs. The rewrite is
//      the scan's blind spot, not a member of any enumeration it could have been
//      taught.
function maybe(n: i32): i32 | null {
  if n > 0 { return n }
  null
}
function maybeS(n: i32): string | null {
  if n > 0 { return "s" }
  null
}

// ── THE TAUGHT HALF: the in-function twins ───────────────────────────────────
// call-LHS `??` in a LetDecl init — walked (`blockHasCoalesceCall`'s `LetDecl` arm).
function coalInLet(n: i32) {
  const v = maybe(n) ?? -1
  v
}
print(coalInLet(3)) // 3

// call-LHS `??` in a while CONDITION inside a FUNCTION — walked
// (`blockHasCoalesceCall`'s `WhileStmt` arm scans `whileCond`).
function coalInWhileCond(n: i32) {
  let k = n
  while (maybe(k) ?? 0) > 2 {
    k = k - 1
  }
  k
}
print(coalInWhileCond(5)) // 2

// call-LHS `??` in a for-range BOUND inside a FUNCTION — walked (`ForRange` arm).
function coalInForBound() {
  let n = 0
  for i in 0 to (maybe(4) ?? 0) {
    n = n + 1
  }
  n
}
print(coalInForBound()) // 5

// the string|null rep of the same stash, in a return position — walked.
function coalStr(n: i32) {
  return (maybeS(n) ?? "z") == "s"
}
print(coalStr(1)) // true

// list `==` in a LetDecl init — walked (`leqScanStmt`'s `LetDecl` arm).
function listEqInLet() {
  const xs = [1, 2]
  const ys = [1, 2]
  const b = xs == ys
  b
}
print(listEqInLet()) // true

// `__array_new__` in a LetDecl init — walked (`blockHasArrNew`'s `LetDecl` arm).
function arrNewInLet(n: i32) {
  const a = __array_new__(n, 0)
  a.length
}
print(arrNewInLet(4)) // 4

// A TOP-LEVEL for-in ITERABLE holding the frame's only use — walked, because the
// `ForIn` arm of `startFnDetectScratch` hand-scans `st.fiIter`.
const src = [3, 4]
let total = 0
for v in __array_new__(2, 0) {
  total = total + v
}
total = total + src[0] + src[1]
print(total) // 7

// ── NOW TAUGHT: the TOP-LEVEL `while` condition ──────────────────────────────
// Each header below holds the ONLY use of its frame in the start function, so
// each is a real regression pin — and because they all share the start function's
// ONE frame set, each frame appears exactly once across the whole file.
let wc = 3
while (maybe(wc) ?? 0) > 0 {
  wc = wc - 1
}
print(wc) // 0 — the call-LHS `??` stash

let wa = 3
while __array_new__(wa, 0).length > 3 {
  wa = wa - 1
}
print(wa) // 3 — the `__array_new__` length slot

const wm: {[string]: i32} = Map()
let wn = 3
while (wm["a"] ?? 0) > 0 {
  wn = wn - 1
}
print(wn) // 3 — the map frame

const wp = [1, 2]
let wq = 0
while (wp.pop() ?? -1) > 0 {
  wq = wq + 1
}
print(wq) // 2 — the push/pop quad; the loop drains `wp`

// ── NOW TAUGHT: the TOP-LEVEL `for`-range bounds ─────────────────────────────
let fa = 0
for i in (maybe(1) ?? 0) to 3 {
  fa = fa + 1
}
print(fa) // 3 — `frFrom`, the `??` stash again

let fb = 0
for i in 0 to __array_new__(2, 0).length {
  fb = fb + 1
}
print(fb) // 3 — `frTo`, the `__array_new__` slot

const fm: {[string]: i32} = Map()
let fc = 0
for i in 0 to (fm["a"] ?? 1) {
  fc = fc + 1
}
print(fc) // 2 — `frTo`, the map frame

const fp = [1, 2]
let fd = 0
for i in 0 to (fp.pop() ?? 0) {
  fd = fd + 1
}
print(fd) // 3 — `frTo`, the pop frame

// The string-op frame, reached through `.slice` — a `+`-then-`.length` shape does
// NOT need it (the concat's length folds and the string never materialises), so
// `.slice` is the honest probe for this frame in a header.
const fs = "abcd"
let fe = 0
while fs.slice(0, 2) == "zz" {
  fe = fe + 1
}
print(fe) // 0 — the string-op frame
