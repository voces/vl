// @run
// @log 2
// @log false
// @log 7
// @log b
// `??` over hole map reads joined into a union box: each arm of the null-test `if` boxed into the
// join's union, a `boolean | null` read under the boolean atom and an atom read as its string.
type AB = "a" | "b"
type R = { a: {[i32]: boolean | null}, b: {[i32]: i32} }
type S = { a: {[i32]: i32 | null}, b: {[i32]: AB} }
function show(x) { print(x) }
function mkR(): R {
  const a: {[i32]: boolean | null} = Map()
  a[3] = false
  a[5] = null
  const b: {[i32]: i32} = Map()
  b[3] = 2
  return { a: a, b: b }
}
function mkS(): S {
  const a: {[i32]: i32 | null} = Map()
  a[3] = 7
  const b: {[i32]: AB} = Map()
  b[4] = "b"
  return { a: a, b: b }
}
function useR(p) {
  print(p.a[9] ?? p.b[3])
  print(p.a[3] ?? p.b[3])
}
function useS(p) {
  show(p.a[3] ?? p.b[4])
  show(p.a[8] ?? p.b[4])
}
useR(mkR())
useS(mkS())
