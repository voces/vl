// @run
// @log 3
// @log -1
// @log 1.5
// @log 0
// CONTRACT (D1517): `u as? i32 ?? d` over a value union. The cast's result is `i32 | null`,
// which is a value-union BOX — a scalar has no spare null niche — and that spelling exists
// NOWHERE else in the program: no annotation, no `type` declaration, no inferred binding.
//
// D1041 registers the box row for a NUMERIC-operand `as?`, and `asExprNumFallible` excludes a
// UNION operand by construction, so this shape reached neither rung and the `??` asked an
// unregistered row for its atoms. THE `??` IS THE INGREDIENT: `const r = u as? i32` plus a
// `!= null` test ran at every scope before the fix, and so did `as? string` / `as? boolean`,
// whose `T | null` is a NICHE and needs no row at all.
//
// NOTHING HERE MAY SPELL `i32 | null`. Any use of that annotation registers the row and is
// the rescue the row records, which would make every cell pass for the wrong reason.
type Val = i32 | string
type FVal = f64 | string

function mkval(hit: boolean): Val {
  if hit { return 3 }
  "s"
}

function mkf(hit: boolean): FVal {
  if hit { return 1.5 }
  "s"
}

function show(hit: boolean) {
  const v = mkval(hit)
  print(v as? i32 ?? -1)
}

function showf(hit: boolean) {
  const v = mkf(hit)
  print(mkfOr(v))
}

// The f64 arm of the same ladder — `unionStoreAtomKind`'s promotion rungs are what reach the
// unregistered row, and they are entered at i32 and at f64.
function mkfOr(v: FVal) {
  v as? f64 ?? 0.0
}

show(true)
show(false)
showf(true)
showf(false)
