// @run
// @log 1
// @log 1
// @log 1
// @log 7
// @log false
// @log 1
// @log 1
// @log 1
// @log 1
// @log false
// @log 1
// @log 1
// @log 1
// @log 1

// D1671/D1670 — a `?.` receiver that is not a re-readable place is evaluated ONCE, staged in
// the frame's `?.` stash and re-read by the null test, the field read and the fused `?? d`
// arms. Every cell calls `mk*` once in the source and prints the call counter, so the pin is
// the COUNT: a cell that re-evaluates prints 2 and this fixture reds.
type I = { z: i32 }
type B = { y: I | null }
type C = { y: i32 }
type U = { y: i32 | string }
type D = { inner: B | null }
type E = { b: B | null }

let n = 0

function mkB(): B | null {
  n = n + 1
  { y: { z: 3 } }
}

function mkC(): C | null {
  n = n + 1
  { y: 7 }
}

function mkU(): U | null {
  n = n + 1
  { y: 5 }
}

function mkD(): D | null {
  n = n + 1
  { inner: { y: { z: 4 } } }
}

function mkE(): E {
  n = n + 1
  { b: { y: { z: 5 } } }
}

// A nullable-struct leaf: the arm that read the receiver a second time.
function nulStructLeaf() {
  n = 0
  mkB()?.y == null
  n
}
print(nulStructLeaf())

// A value-union leaf (code 16) — the box-tag test reads the receiver again too.
function unionLeaf() {
  n = 0
  mkU()?.y == null
  n
}
print(unionLeaf())

// `?? d` over a call receiver, the fused arm that reads it three times.
function coalesceCount() {
  n = 0
  mkC()?.y ?? 0
  n
}
print(coalesceCount())

function coalesceValue() { mkC()?.y ?? 0 }
print(coalesceValue())

// The standalone value position, whose own gate the stash replaced.
function standalone() {
  n = 0
  const v = mkC()?.y
  v == null
}
print(standalone())
print(n)

// A two-link chain: one stash for the base every link reads through.
function nested() {
  n = 0
  mkD()?.inner?.y == null
  n
}
print(nested())

// The base is a field read OFF a call, so the whole `.b` member stages.
function memberOfCall() {
  n = 0
  mkE().b?.y == null
  n
}
print(memberOfCall())

// A `?.` chain in the `??` default lowers inside the exclusive arm, so it may share the
// stash with the chain on the left.
function defaultChain() {
  n = 0
  mkC()?.y ?? (mkC()?.y ?? 0)
  n
}
print(defaultChain())

// The start function's own frame reserves the stash through the same pre-pass.
print(mkD()?.inner?.y == null)

// A re-readable receiver keeps its in-place lowering — the control that must not move.
function reReadable() {
  n = 0
  const b = mkB()
  b?.y == null
  n
}
print(reReadable())

// D1826 — the `?? d` arm of a chain TWO OR MORE links deep re-entered the chain lowering per
// link, and each re-entry restored the marker with its tee cleared, so the base ran once per
// entry. The count is the pin at every depth, at both spellings, and over an INDEX base.
function coalesceTwoLinks() {
  n = 0
  mkD()?.inner?.y ?? { z: 0 }
  n
}
print(coalesceTwoLinks())

function coalesceThreeLinks() {
  n = 0
  mkD()?.inner?.y?.z ?? 0
  n
}
print(coalesceThreeLinks())

function mkDList(): (D | null)[] {
  n = n + 1
  [{ inner: { y: { z: 4 } } }]
}

function coalesceIndexBase() {
  n = 0
  mkDList()[0]?.inner?.y ?? { z: 0 }
  n
}
print(coalesceIndexBase())
