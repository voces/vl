// @run
// @hint redundant type annotation: `g` is inferred as `In | null` — remove it to lean on inference
// @hint redundant type annotation: `x` is inferred as `i32 | null` — remove it to lean on inference
// @log 1 2 -1
// @log a n n
// @log 1 2 -1
// @log 1 2 -1
// @log 1 2 -1
// @log 1 2 -1
// @log 1 2 -1
// @log 1 2 -5
// @log 1 2 -1
// @log ok
// @log 1 2 -1
// @log a n n
// @log 1 2 -1
// @log 1 2 -1
// @log 1 2 -1
// @log 1 2 -5
// @log 1 2 -1
// @log 1 2 -1
// A standalone `?.` whose base is a module global or a field read writes that read again after
// its null test, as legacy does: in each position a value goes, over a base holding a record, a
// record whose string field is null, and null.
type In = { v: i32, s: string | null }
type H = { p: In | null }
function mk(k: i32): In | null {
  if k == 0 { return { v: 1, s: "a" } }
  if k == 1 { return { v: 2, s: null } }
  return null
}
let g: In | null = mk(0)
const hold: H = { p: mk(0) }
function sN(x: i32 | null) { return if x == null { -1 } else { x } }
function sS(x: string | null) { return x ?? "n" }
function idN(x: i32 | null) { return x }
function gArg() { return sN(g?.v) }
function gStr() { return sS(g?.s) }
function gNested() { return sN(idN(g?.v)) }
function gRet(): i32 | null { return g?.v }
function gConst() {
  const x: i32 | null = g?.v
  return sN(x)
}
function gInfer() {
  const x = g?.v
  return sN(x)
}
function gArm(c: boolean) {
  const x = if c { g?.v } else { null }
  return sN(x)
}
function gCoal() { return g?.v ?? -5 }
function gRec() {
  const r = { a: g?.v }
  return sN(r.a)
}
function gStmt() {
  g?.v
  return "ok"
}
function fArg() { return sN(hold.p?.v) }
function fStr() { return sS(hold.p?.s) }
function fNested() { return sN(idN(hold.p?.v)) }
function fRet(): i32 | null { return hold.p?.v }
function fInfer() {
  const x = hold.p?.v
  return sN(x)
}
function fCoal() { return hold.p?.v ?? -5 }
function fRec() {
  const r = { a: hold.p?.v }
  return sN(r.a)
}
function local(h: H) { return sN(h.p?.v) }
function three(f: () => i32) {
  g = mk(0)
  hold.p = mk(0)
  const a = f()
  g = mk(1)
  hold.p = mk(1)
  const b = f()
  g = mk(2)
  hold.p = mk(2)
  const c = f()
  print("\{a} \{b} \{c}")
}
function threeS(f: () => string) {
  g = mk(0)
  hold.p = mk(0)
  const a = f()
  g = mk(1)
  hold.p = mk(1)
  const b = f()
  g = mk(2)
  hold.p = mk(2)
  const c = f()
  print("\{a} \{b} \{c}")
}
three(gArg)
threeS(gStr)
three(gNested)
three((): i32 => sN(gRet()))
three(gConst)
three(gInfer)
three((): i32 => gArm(true))
three(gCoal)
three(gRec)
print(gStmt())
three(fArg)
threeS(fStr)
three(fNested)
three((): i32 => sN(fRet()))
three(fInfer)
three(fCoal)
three(fRec)
print("\{local({ p: mk(0) })} \{local({ p: mk(1) })} \{local({ p: mk(2) })}")
