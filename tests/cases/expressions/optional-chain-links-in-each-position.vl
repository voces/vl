// @run
// @log 107
// @log 100
// @log seven
// @log none
// @log 101
// @log <seven>
// @log [2]
// @log 7
// @log -1
// @log 6
// @log 7
// @log 5
// @log 7
// @log 7
// @log 8
// @log 8
// @log seven
// A `?.` chain of two and three links over a local, a parameter, a field and a global, read
// standalone and under `?? d`, in each position: a scalar and a union argument, a nested argument,
// a concat operand, an interpolation hole, a return, an initializer, an `if` arm, a `??` operand
// and a record field; one middle link null in one run.
type C = { v: i32, s: string }
type B = { c: C | null }
type A = { b: B | null }
type H = { a: A | null }
type R = { v: i32 }
const full: A = { b: { c: { v: 7, s: "seven" } } }
const mid: A = { b: { c: null } }
const g: A | null = full
function plus(n: i32) { return n + 100 }
function show(u: i32 | string) {
  if u is string { return u } else { return "n" }
}
function id(n: i32) { return n }
function argScalar(a: A) { return plus(a.b?.c?.v ?? 0) }
function argUnion(a: A) { return show(a.b?.c?.s ?? "none") }
function argNested(a: A) { return plus(id(a.b?.c?.v ?? 1)) }
function concat(a: A) { return "<" + (a.b?.c?.s ?? "x") + ">" }
function interp(a: A) { return "[\{a.b?.c?.v ?? 2}]" }
function ret(a: A) { return a.b?.c?.v }
function letInit(a: A) {
  const v = a.b?.c?.v ?? 3
  return v * 2
}
function ifArm(a: A, k: boolean) {
  const v = if k { a.b?.c?.v ?? 4 } else { 0 }
  return v
}
function coal(a: A) { return (a.b?.c?.v ?? null) ?? 5 }
function rec(a: A) {
  const r: R = { v: a.b?.c?.v ?? 6 }
  return r
}
function three(h: H) { return h.a?.b?.c?.v ?? 8 }
function glob() { return g?.b?.c?.s ?? "g" }
print(argScalar(full))
print(argScalar(mid))
print(argUnion(full))
print(argUnion(mid))
print(argNested(mid))
print(concat(full))
print(interp(mid))
print(ret(full) ?? -1)
print(ret(mid) ?? -1)
print(letInit(mid))
print(ifArm(full, true))
print(coal(mid))
print(rec(full).v)
print(three({ a: full }))
print(three({ a: mid }))
print(three({ a: null }))
print(glob())
