// @run
// @log 7 -1 -1
// @log 7 -1 -1
// @log 7 -5 -5
// @log 7 -1 -1
// @log 7 -1 -1
// @log 7 -1 -1
// @log 1 2
// @log 2 2
// A linked `o.f?.g?.h` reads its base again at each link, the middle link null in one run and
// the base's own field null in another; a single `o.f?.g` over a nullable field reads its base a
// third time for the field's own null test; and a global base read beside a sibling argument whose
// call reassigns that global reads it where the argument stands.
type C = { h: i32 }
type B = { g: C | null }
type A = { f: B | null }
function mkA(k: i32): A {
  if k == 0 { return { f: { g: { h: 7 } } } }
  if k == 1 { return { f: { g: null } } }
  return { f: null }
}
function sN(x: i32 | null) { return if x == null { -1 } else { x } }
function chainArg(o: A) { return sN(o.f?.g?.h) }
function chainConst(o: A) {
  const x = o.f?.g?.h
  return sN(x)
}
function chainCoal(o: A) { return o.f?.g?.h ?? -5 }
print("\{chainArg(mkA(0))} \{chainArg(mkA(1))} \{chainArg(mkA(2))}")
print("\{chainConst(mkA(0))} \{chainConst(mkA(1))} \{chainConst(mkA(2))}")
print("\{chainCoal(mkA(0))} \{chainCoal(mkA(1))} \{chainCoal(mkA(2))}")
function hOf(c: C | null) { return if c == null { -1 } else { c.h } }
function linkArg(o: A) { return hOf(o.f?.g) }
function linkConst(o: A) {
  const c = o.f?.g
  return hOf(c)
}
function linkRet(o: A): C | null { return o.f?.g }
print("\{linkArg(mkA(0))} \{linkArg(mkA(1))} \{linkArg(mkA(2))}")
print("\{linkConst(mkA(0))} \{linkConst(mkA(1))} \{linkConst(mkA(2))}")
print("\{hOf(linkRet(mkA(0)))} \{hOf(linkRet(mkA(1)))} \{hOf(linkRet(mkA(2)))}")

type In = { v: i32 }
let gl: In | null = { v: 1 }
function setG() {
  gl = { v: 2 }
  return 0
}
function h2(a: i32 | null, b: i32) { return sN(a) + b }
function h3(a: i32, b: i32 | null) { return a + sN(b) }
function before() { return h2(gl?.v, setG()) }
function after() { return h3(setG(), gl?.v) }
const r1 = before()
gl = { v: 1 }
const r2 = after()
print("\{r1} \{r2}")
print("\{sN(gl?.v)} \{r2}")
