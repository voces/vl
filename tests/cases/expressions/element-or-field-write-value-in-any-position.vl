// An element or field write used as a value yields the stored value in any position — an operand,
// a call argument, a module-level initializer — with its siblings evaluated in source order.
function bump(xs: i32[], i: i32) { return (xs[i] = 8) + 1 }
const xs = [1, 2, 3]
print(bump(xs, 2))
print(xs[2])

let k = 0
function next() {
  k = k + 1
  return k
}
function three(a: i32, b: i32, c: i32) { print(a * 100 + b * 10 + c) }
const ys = [0, 0, 0]
const yi = 1
three(next(), ys[yi] = next() + 4, next())
print(ys[1])

const zi = 2
const top = xs[zi] = 8
print(top)

const ss = ["a", "b"]
const si = 0
print((ss[si] = "z") + "!")
print(ss[0])

type P = { v: i32 }
const ps: P[] = [{ v: 1 }, { v: 2 }]
const pi = 1
print((ps[pi] = { v: 7 }).v)
print(ps[1].v)

const ll = [[1], [2]]
const li = 0
print((ll[li] = [7, 8]).length)
print(ll[0][1])

type Q = { x: i32, s: string }
const q: Q = { x: 1, s: "a" }
let calls = 0
function getQ(): Q {
  calls = calls + 1
  return q
}
print(getQ().x = 5)
print(calls)
print(getQ().s = "zz")
print(q.x)
print(q.s)

// A write nested in another's value, two in one expression, and a write inside a callee each
// yield their own stored value.
const na = [0, 0]
const nb = [0, 0]
const ni = 1
const nj = 0
print(na[ni] = nb[nj] = 5)
print(na[1] * 10 + nb[0])
print((na[nj] = 8) + (nb[ni] = 9))
const dbl = (v: i32) => {
  return nb[nj] = v * 2
}
type R = { x: i32 }
const ro: R = { x: 0 }
function getR(): R { return ro }
print(getR().x = (na[nj] = 4) + dbl(1))
print(ro.x * 100 + na[0] * 10 + nb[0])
