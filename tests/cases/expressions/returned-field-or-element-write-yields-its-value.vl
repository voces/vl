// A `return` or `let` that yields a field or element write stores the value once, with the
// receiver and index evaluated once and in source order, and yields the stored value.
type Node = { v: i32, left: Node | null }
function insert(n: Node, v: i32) {
  if n.left == null { return n.left = { v: v, left: null } }
  insert(n.left, v)
}
const root: Node = { v: 5, left: null }
insert(root, 3)
print(root.left?.v ?? 0)

function put(xs: i32[], i: i32) { return xs[i + 1] = 5 }
const xs = [1, 2, 3]
print(put(xs, 0))
print(xs[1])

let k = 0
function next() {
  k = k + 1
  return k
}
function putNext(ys: i32[]) { return ys[next()] = 50 + k }
const ys = [1, 2, 3]
print(putNext(ys))
print(ys[1])
print(k)

type O = { x: i32 }
let calls = 0
const o: O = { x: 1 }
function mk(): O {
  calls = calls + 1
  return o
}
function viaCall() { return mk().x = 5 }
print(viaCall())
print(calls)
print(o.x)

function findSet(zs: i32[]) {
  let i = 0
  while i < zs.length {
    if zs[i] == 2 { return zs[i] = 9 }
    i = i + 1
  }
  return -1
}
print(findSet([1, 2, 3]))

const ws = [1, 2, 3]
const g = (i: i32) => { return ws[i] = i * 10 }
print(g(2))
print(ws[2])

function bound(vs: i32[], i: i32) {
  const y = vs[i] = 5
  return y + 1
}
const vs = [1, 2, 3]
print(bound(vs, 1))
print(vs[1])
