// @run
// @log 3
// @log 1
// @log -1
// @log 2
// @log 2.5
// @log 3
// @log true
// @log 4
// @log s
// @log 5
// @log 7
// @log 6
// A `??` over a nullable field read off a call evaluates the call once on either path: the
// present arm reads the value the null test tested (D17059).
type R = { m: i32, f: i32 | null }
type F = { m: i32, g: f64 | null }
type B = { m: i32, h: boolean | null }
type U = { m: i32, u: i32 | string | null }
let calls = 0
function mk(v: i32 | null): R {
  calls = calls + 1
  return { m: 1, f: v }
}
function mf(v: f64 | null): F {
  calls = calls + 1
  return { m: 1, g: v }
}
function mb(v: boolean | null): B {
  calls = calls + 1
  return { m: 1, h: v }
}
function mu(v: i32 | string | null): U {
  calls = calls + 1
  return { m: 1, u: v }
}
print(mk(3).f ?? -1)
print(calls)
print(mk(null).f ?? -1)
print(calls)
print(mf(2.5).g ?? 0.5)
print(calls)
print(mb(true).h ?? false)
print(calls)
print(mu("s").u ?? 0)
print(calls)
print(mu(7).u ?? 0)
print(calls)
