// @run
// @log 7
// @log 0
// @log ok
// @log none
// @log 7
// @log 7
// @log 3
// @log 3
// @log 7
// @log 1
// @hint redundant type annotation: `items` is inferred as `({y: {z: i32, s: string}} | null)[]` — remove it to lean on inference
// @hint redundant type annotation: `a` is inferred as `{i: {y: {z: i32, s: string}}}` — remove it to lean on inference

// D1815 — one `?.` guards everything to its right, so `o?.y.z` reads as
// `o == null ? null : o.y.z` and carries the `| null` once, at the chain's end. The last
// three cells are the controls: the double-`?.` spelling is unchanged, a non-nullable
// receiver folds back to the plain read, and the base is evaluated once.
type Leaf = { z: i32, s: string }
type Inner = { y: Leaf }
type Deep = { i: Inner }

function mkI(c: boolean): Inner | null {
  if c { return { y: { z: 7, s: "ok" } } }
  return null
}

const o = mkI(true)
const q = mkI(false)

// A scalar leaf and a string leaf: the two nullable reps the chain's guard joins on.
print(o?.y.z ?? 0)
print(q?.y.z ?? 0)
print(o?.y.s ?? "none")
print(q?.y.s ?? "none")

// A map read and a list element as the chain's base.
const m: {[string]: Inner} = Map()
m["k"] = { y: { z: 7, s: "ok" } }
print(m["k"]?.y.z ?? 0)
const items: (Inner | null)[] = [{ y: { z: 7, s: "ok" } }, null]
print(items[0]?.y.z ?? 0)

// A NON-nullable receiver: the guard is unreachable, so both spellings are the plain read.
const a: Deep = { i: { y: { z: 3, s: "x" } } }
print(a?.i.y.z)
print(a?.i?.y?.z)

// The double-`?.` spelling, which must be unchanged.
print(o?.y?.z ?? 0)

// The base is evaluated ONCE however many links read through it — the guarded `.` link is
// staged exactly as the `?.` one it normalises to (D1671). The `?? d` arm of a two-link chain
// still reads it twice at BOTH spellings, which is D1826 and not this row's.
let n = 0
function mkCount(): Inner | null {
  n = n + 1
  { y: { z: 7, s: "ok" } }
}
function baseOnce() {
  n = 0
  mkCount()?.y.z == null
  n
}
print(baseOnce())
