// @run
// @log 1 1
// @log 2 -1
// @log 1 3
// @log -1 4
// @log 1 5
// @log -1 6
// A `?.` over a base with an effect, a call, an index whose index calls, or an assignment,
// runs the effect once whether the base is a record or null: the counter climbs by one per read.
type In = { v: i32 }
let n = 0
function next(k: i32): In | null {
  n = n + 1
  return if k == 0 { { v: 1 } } else { null }
}
function at(k: i32) {
  n = n + 1
  return k
}
const xs: (In | null)[] = [{ v: 1 }, null]
function sN(x: i32 | null) { return if x == null { -1 } else { x } }
function viaCall(k: i32) { return sN(next(k)?.v) }
function viaIndex(k: i32) { return sN(xs[at(k)]?.v) }
function viaAssign(k: i32) {
  let o: In | null = null
  return sN((o = next(k))?.v)
}
const a = viaCall(0)
print("\{a} \{n}")
const b = viaCall(1)
print("\{n} \{b}")
const c = viaIndex(0)
print("\{c} \{n}")
const d = viaIndex(1)
print("\{d} \{n}")
const e = viaAssign(0)
print("\{e} \{n}")
const f = viaAssign(1)
print("\{f} \{n}")
