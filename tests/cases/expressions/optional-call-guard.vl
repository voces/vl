// @run
// @log 42
// @log 0
// @log 42
// @log 0
// @log 42
// @log 42
// @log ok
// @log none
// @log 1
// @log 42
// @hint redundant type annotation: `items` is inferred as `({n: i32} | null)[]` — remove it to lean on inference
// @hint redundant type annotation: `lp` is inferred as `L | null` — remove it to lean on inference
// @hint redundant type annotation: `lq` is inferred as `L | null` — remove it to lean on inference

// D1814 — `p?.f(args)` is one guard over the receiver with the whole call inside it, so the
// callee resolves against the non-null type and the result is the call's own return behind a
// single `| null`. Every receiver kind the guard may read twice is a cell here, and the last
// pair pins the receiver being evaluated ONCE.
type P = { n: i32 }
type Fld = { f: () => i32 }
type Box = { inner: P | null }
type L = { s: string }

function twice(self: P) { self.n * 2 }
function bump(self: P, d: i32) { self.n + d }
function label(self: P): L {
  if self.n > 0 { return { s: "ok" } }
  { s: "zero" }
}

function mkP(c: boolean): P | null {
  if c { return { n: 21 } }
  return null
}

function mkFld(c: boolean): Fld | null {
  if c { return { f: () => 42 } }
  return null
}

// A free `self`-function through a nullable binding, both arms.
const p = mkP(true)
const q = mkP(false)
print(p?.twice() ?? 0)
print(q?.twice() ?? 0)

// A callable FIELD, the spelling the old refusal named.
const fp = mkFld(true)
const fq = mkFld(false)
print(fp?.f() ?? 0)
print(fq?.f() ?? 0)

// Arguments are evaluated on the non-null arm and bind to the callee's parameters.
print(p?.bump(21) ?? 0)

// A list element as the receiver: a place the guard may re-read. (A MAP read is the one place
// form the guard declines — see D1827 and its matrix.)
const items: (P | null)[] = [{ n: 21 }, null]
print(items[0]?.twice() ?? 0)

// A struct RESULT, so the guard's arms join on a nullable struct ref, not the scalar box.
const lp: L | null = p?.label()
print(lp?.s ?? "none")
const lq: L | null = q?.label()
print(lq?.s ?? "none")

// A nullable struct FIELD receiver, read once. The counter is the pin: the guard names the
// receiver twice in the desugar, and a receiver with effects must not run twice.
let n = 0
function mkBox(): Box {
  n = n + 1
  { inner: { n: 21 } }
}
function fieldRecvOnce() {
  n = 0
  const o = mkBox()
  o.inner?.twice()
  n
}
print(fieldRecvOnce())

// The same receiver in VALUE position, so the guard's two arms are read as well as taken.
const bx = mkBox()
print(bx.inner?.twice() ?? 0)
