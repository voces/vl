// @run
// @log 7
// @log 7
// @log aa
// @log p
// @log 3
// @log 5
// @hint redundant type annotation: `mkI` is inferred as `i32`
// @hint redundant type annotation: `mkS` is inferred as `string`
// @warning this `??` default is never used: `i32` is never null — drop the `??` and its default
// @warning this `??` default is never used: `string` is never null — drop the `??` and its default
// @warning this `??` default is never used: `K` is never null — drop the `??` and its default
// @warning this `??` default is never used: `S` is never null — drop the `??` and its default
// CONTRACT: `x ?? d` where `x` CANNOT be null IS `x` — the default is unreachable, the
// expression yields the left operand at the left operand's own rep, and the compiler SAYS
// SO once per site (`dead-coalesce-default`, a warning).
//
// Every leg prints the coalesce and then the same value WITHOUT the `??`; the twin is the
// assertion, because a fold that changed the rep could not agree with the plain read.
//
// Before this, all four legs were `vl check` rc 0 and a loud EMIT reject naming a rule that
// has nothing to do with them: ``emitProgram: `??` is only supported on a map index get``.
// It was the single most common emit message in the 9,126-cell nullability sweep, 204 cells,
// and the map-index rule was not the reason for one of them.
//
// THE FOLD IS A REWRITE, NOT AN EMIT ARM, and the `string` / `K` legs are why. Lowering the
// identity inside `emitCoalesce` gives the right bytes and leaves the `??` NODE in the tree
// for `exprString` / `exprIsLitAtom` / the print-import chooser to classify — and each of
// their `??` arms answers only for a NULLABLE left operand, so they fell through to the i32
// default over a string ref (invalid wasm) and over an atom id (`0` printed for `"p"`).
type K = "p" | "q"
type S = { w: i32 }

function mkI(): i32 { return 7 }
function mkS(): string { return "aa" }
function mkK(): K { return "p" }
function mkStruct(): S { return { w: 3 } }

print(mkI() ?? 0)
print(mkI())
print(mkS() ?? "DD")
print(mkK() ?? "q")
print((mkStruct() ?? { w: 9 }).w)

// A NARROWED place is exempt from the warning and always was from the fold's intent: the
// STORAGE still admits null, so a defensive `??` there is a deliberate spelling (pinned at
// ten sites by soundness/narrowed-read-coalesce-lowers.vl). This leg carries no directive.
function guarded(p: i32 | null) {
  if p != null { print(p ?? 0) }
}
guarded(5)
