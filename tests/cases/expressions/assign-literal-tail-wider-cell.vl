// @log 1
// @log 9
// @log 7
// @log 3
// @hint redundant type annotation: `g` is inferred as `f64`
// An un-annotated function whose tail assigns a number literal to a wider cell returns the
// literal at the checker's type (`i32`), not the cell, in every tail shape: straight, `if`/`else`,
// nested `if`, `else if`, `match` arms with and without braces, a labelled block, `return` in an
// arm, and arms mixing a literal with a name (D14490).
let g: f64 = 0.5
let h: i64 = 1
let k: f32 = 0.5
function straight() { g = 5 }
function ifElse(c: boolean) {
  if c { g = 5 } else { g = 7 }
}
function nested(c: boolean, d: boolean) {
  if c {
    if d { g = 5 } else { g = 9 }
  } else {
    g = 7
  }
}
function elseIf(n: i32) {
  if n == 0 { g = 5 }
  else if n == 1 { g = 9 }
  else { g = 7 }
}
function matchArms(n: i32) {
  match n {
    0 => {
      g = 5
    }
    _ => {
      g = 7
    }
  }
}
function matchBare(n: i32) {
  match n {
    0 => g = 5
    _ => g = 7
  }
}
function labelled(c: boolean) {
  @B {
    if c { break @B (g = 5) }
    g = 7
  }
}
function retStraight() { return g = 5 }
function retArm(c: boolean) {
  if c { return g = 5 } else { return g = 7 }
}
function mixed(c: boolean) {
  const v = 9
  if c { g = 5 } else { g = v }
}
function ai(c: boolean) {
  if c { h = 5 } else { h = 7 }
}
function af(c: boolean) {
  if c { k = 5 } else { k = 7 }
}
function mixedF(c: boolean) {
  const v = 3
  if c { k = 5 } else { k = v }
}
print(straight() / 2)
print(ifElse(true) / 2)
print(ifElse(false) / 2)
print(nested(true, true) / 2)
print(nested(true, false) / 2)
print(nested(false, true) / 2)
print(elseIf(0) / 2)
print(elseIf(1) / 2)
print(elseIf(2) / 2)
print(matchArms(0) / 2)
print(matchArms(1) / 2)
print(matchBare(0) / 2)
print(matchBare(1) / 2)
print(labelled(true) / 2)
print(labelled(false) / 2)
print(retStraight() / 2)
print(retArm(true) / 2)
print(retArm(false) / 2)
print(mixed(true) / 2)
print(mixed(false) / 2)
print(ai(true) / 2)
print(ai(false) * 3)
print(af(true) / 2)
print(af(false) / 2)
print(mixedF(true) / 2)
print(mixedF(false) / 2)
print(g)
print(h)
print(k)
