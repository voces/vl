// @run
// @hint redundant type annotation: `v` is inferred as `{[string]: i32} | null` — remove it to lean on inference
// @hint redundant type annotation: `kv` is inferred as `{[i32]: string} | null` — remove it to lean on inference
// @log 0
// @log 7
// @log null
// @log 5
// @log true
// @log s
// @log 2
// @log s
// @log 9
// @log 4
// @log d
// @log 0
// A standalone `?.` whose leaf field is a map yields the map struct's own nullable ref (D1680).
// An un-annotated binding takes its shape from the field, and `??` with a map default joins at it
// (D16035).
type B = { y: {[string]: i32} }
function mk(n: i32): B | null {
  if n < 0 { return null }
  const m: {[string]: i32} = Map()
  if n > 0 { m["a"] = n }
  return { y: m }
}
const e = mk(0)?.y
if e != null { print(e.keys().length) } else { print(-1) }
const v: {[string]: i32} | null = mk(7)?.y
if v != null { print(v["a"] ?? -1) } else { print("null") }
const n = mk(-1)?.y
if n != null { print(n["a"] ?? -1) } else { print("null") }
type A = { b: B | null }
const a: A | null = { b: mk(5) }
const deep = a?.b?.y
if deep != null { print(deep["a"] ?? -1) } else { print("null") }
type S = { y: Set<string> }
function mkS(): S | null {
  const s: Set<string> = Set()
  s.add("q")
  return { y: s }
}
const sv = mkS()?.y
if sv != null { print(sv.has("q")) }
type K = { y: {[i32]: string} }
function mkK(): K | null {
  const m: {[i32]: string} = Map()
  m[3] = "s"
  return { y: m }
}
const kv: {[i32]: string} | null = mkK()?.y
if kv != null { print(kv[3] ?? "-") }
function size(m: {[string]: i32} | null) {
  if m != null { return m.keys().length }
  -1
}
const two: {[string]: i32} = Map()
two["p"] = 1
two["q"] = 2
const holder: B | null = { y: two }
print(size(holder?.y))
const ku = mkK()?.y
if ku != null { print(ku[3] ?? "-") }
const dflt: {[string]: i32} = Map()
dflt["z"] = 9
print((mk(-1)?.y ?? dflt)["z"] ?? -1)
print((mk(4)?.y ?? dflt)["a"] ?? -1)
const kd: {[i32]: string} = Map()
kd[1] = "d"
function noK(): K | null { null }
print((noK()?.y ?? kd)[1] ?? "-")
print((mk(-1)?.y ?? Map()).keys().length)
