// @run
// @log 1
// @log bc
// @log bc
// @log 2
// @log bc
// @log bc
// @log c
// @log bc
// @log 2
// @log 2
// @log 4
// @log true
// @log b
// @log bc
// @log 0
// @log 1
// @log empty
// @log 1
// @log 0
// @log 1
// @log 2
// @log 2
// @log 2
// @hint redundant type annotation: `f` is inferred as `i32`
// @hint redundant type annotation: `ret` is inferred as `string`
// @hint redundant type annotation: `r` is inferred as `{s: string}`
// CONTRACT (must-run, D1992, reported by plumb (PL-008)): a builtin member call the checker
// types non-void — `s.slice(a, b)`, `s.indexOf(x)`, `xs.map(f)`, `xs.push(v)`, `m.has(k)` — is
// a VALUE when it is the tail of an if-expression arm, in every position the if-expression
// can be delivered.

// the filed witness, verbatim
function f(s: string): i32 {
  const sp = s.indexOf(" ")
  const n = if sp < 0 { s.slice(1, s.length) } else { s.slice(1, sp) }
  n.length
}
print(f("#1 a"))

function ret(s: string, c: boolean): string {
  return if c { s.slice(1, s.length) } else { "x" }
}
print(ret("abc", true))

function arg(s: string, c: boolean) {
  print(if c { s.slice(1, s.length) } else { "x" })
}
arg("abc", true)

function argI32(s: string, c: boolean) {
  print(if c { s.indexOf("c") } else { 9 })
}
argI32("abc", true)

function assign(s: string, c: boolean) {
  let n = "q"
  n = if c { s.slice(1, s.length) } else { "x" }
  n
}
print(assign("abc", true))

type R = { s: string }
function field(s: string, c: boolean) {
  const r: R = { s: if c { s.slice(1, s.length) } else { "x" } }
  r.s
}
print(field("abc", true))

function nested(s: string, c: boolean, d: boolean) {
  const n = if c { if d { s.slice(1, s.length) } else { s.slice(2, s.length) } } else { "x" }
  n
}
print(nested("abc", true, false))

function viaMatch(s: string, k: i32) {
  const n = match k {
    1 => s.slice(1, s.length)
    _ => "x"
  }
  n
}
print(viaMatch("abc", 1))

function mapArm(xs: i32[], c: boolean) {
  const n = if c { xs.map((x) => x * 2) } else { xs }
  n[0]
}
print(mapArm([1, 2, 3], true))

// `.push` yields the new length; its grow frame must be reserved inside the arm too
function pushArm(xs: i32[], c: boolean) {
  const n = if c { xs.push(1) } else { 0 }
  n
}
print(pushArm([1], true))

function pushNested(xs: i32[], c: boolean, d: boolean) {
  const n = if c { if d { xs.push(1) } else { xs.push(2) } } else { 0 }
  n + xs[1]
}
print(pushNested([1], true, false))

function hasArm(c: boolean) {
  const m: {[string]: i32} = Map()
  m.set("a", 4)
  const n = if c { m.has("a") } else { false }
  n
}
print(hasArm(true))

// a function-tail `if` whose every arm is a method call
function tailBoth(s: string, c: boolean) {
  if c { s.slice(0, 1) } else { s.slice(1, 2) }
}
print(tailBoth("abc", false))

// the binding position inside a lambda body
const lam = (s: string, c: boolean) => {
  const n = if c { s.slice(1, s.length) } else { "x" }
  n
}
print(lam("abc", true))

// Controls: a function-tail `if` with ONE member-call arm beside a void arm stays a void
// function; only an if whose every arm is a value makes the function return one.
function mixedPush(flag: boolean) {
  const xs: i32[] = []
  if flag { xs.push(8) } else { print(0) }
}
mixedPush(false)
mixedPush(true)
print(1)

function note(s: string) { print(s) }
function addNonEmpty(xs: string[], s: string) {
  if s.length > 0 { xs.push(s) } else { note("empty") }
}
const names: string[] = []
addNonEmpty(names, "x")
addNonEmpty(names, "")
print(names.length)

function mixedPop(xs: i32[], c: boolean) {
  if c { print(0) } else { xs.pop() }
}
const popped = [1, 2]
mixedPop(popped, true)
mixedPop(popped, false)
print(popped.length)

// both arms member calls in a lambda tail: the lambda returns the arm's value
const popOrPush = (xs: i32[], c: boolean) => {
  if c { xs.pop() } else { xs.push(7) }
}
const pp = [1, 2]
print(popOrPush(pp, true))
print(popOrPush(pp, false))
print(pp.length)
