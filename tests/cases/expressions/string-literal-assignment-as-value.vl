// @run
// @log q
// @log q
// @hint redundant type annotation: `a` is inferred as `string` — remove it to lean on inference
// An assignment of a string literal to a `string` place, used as a value, is the place's string,
// not the literal's atom (D2452).
function main() {
  let a: string = "x"
  const r = (a = "q")
  print(r)
  let b: string | null = null
  const s = (b = "q")
  print(s)
}
main()
