// An optional chain built once as its value, then tested: against `null` (its own null test at the
// value's rep) and against a nullable record (the value written once to a fresh local, then the
// field-wise compare), at a `let`, an argument, a return value, an `if` condition, an
// interpolation and under a `!`.
// @run
// @log true
// @log false
// @log false
// @log true
// @log false
// @log yes
// @log no
// @log v=true
// @log false
// @log true
// @log true
// @log true
// @log false
// @log true
// @log false
// @log yes
// @log v=false
// @log true
type S = { a: i32 }
type T = { f: S | null, n: i32 | null, s: string | null }
function mk(k: i32): S | null { return if k > 1 { null } else { { a: k } } }
function show(b: boolean) { print(b) }
function nulls(o: T | null) {
  const e = o?.f == null
  print(e)
  show(o?.n != null)
}
function retNull(o: T | null) { return o?.s == null }
function condNull(o: T | null) {
  if o?.f == null { print("yes") } else { print("no") }
}
function interpNull(o: T | null) { print("v=\{o?.n == null}") }
function eqs(o: T | null, c: i32) {
  const y = mk(c)
  const e = o?.f == y
  print(e)
  show(o?.f != y)
}
function retEq(o: T | null, c: i32) { return o?.f == mk(c) }
function condEq(o: T | null, c: i32) {
  if o?.f == mk(c) { print("yes") } else { print("no") }
}
function interpEq(o: T | null, c: i32) { print("v=\{o?.f == mk(c)}") }
const full: T = { f: { a: 1 }, n: 3, s: "s" }
const none: T = { f: null, n: null, s: null }
nulls(none)
print(retNull(full))
print(retNull(null))
print(full?.n == null)
condNull(null)
condNull(full)
interpNull(null)
eqs(full, 2)
print(retEq(full, 1))
eqs(full, 1)
print(retEq(null, 2))
print(retEq(full, 2))
condEq(full, 1)
interpEq(full, 0)
print(!(full?.f != mk(1)))
