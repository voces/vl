// @run
// @log string nn
// @log none
// @log string nn
// @log string g
// @log nn!
// @log nn?
// @log nn
// @log ab
// @log string m
// @log string n
// @log none
// @log inner
// @log y
// A `string | null` narrowed to `string` inside the left operand of a `??`, handed to a `string`
// parameter: the argument recovers its non-null ref however the call is spelled (D3816). The
// `??` arm reads its own nullable strings raw, and that must not reach an argument's slot.
function describe(self: string) { "string " + self }
function both(self: string, t: string) { self + t }
function id<T>(x: T): T { x }
function keep(s: string | null) { s ?? "inner" }

// The row's witness: an optional `self`-function call.
function f(n: string | null) { n?.describe() ?? "none" }
print(f("nn"))
print(f(null))

// The same guard written out, at a binding and at module scope.
function fb(n: string | null) {
  const s = (if n != null { describe(n) } else { null }) ?? "none"
  print(s)
}
fb("nn")
const g: string | null = "g"
print((if g == null { null } else { describe(g) }) ?? "none")

// A nested function, a function value, a generic and a two-receiver call.
function fc(n: string | null, k: string) {
  function cat(s: string) { s + k }
  (if n == null { null } else { cat(n) }) ?? "none"
}
print(fc("nn", "!"))
function fv(n: string | null, h: (s: string) => string) {
  (if n == null { null } else { h(n) }) ?? "none"
}
print(fv("nn", (s) => s + "?"))
function fg(n: string | null) {
  (if n == null { null } else { id(n) }) ?? "none"
}
print(fg("nn"))
function f2(n: string | null, m: string | null) {
  (if n == null || m == null { null } else { n.both(m) }) ?? "none"
}
print(f2("a", "b"))

// A chain of two, and a `string | null` parameter that keeps its null.
function fch(n: string | null, m: string | null) {
  n?.describe() ?? m?.describe() ?? "none"
}
print(fch(null, "m"))
print(fch("n", null))
print(fch(null, null))
function fk(n: string | null) {
  (if n == "x" { null } else { keep(n) }) ?? "none"
}
print(fk(null))
print(fk("y"))
