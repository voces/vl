// @run
// @log 3
// @log 4
// @log 6
// @log 9
// @log true
// @log false
// @log 7
// @log 4
// @warning this `??` default is never used: `i32` is never null — drop the `??` and its default
// @warning this `??` default is never used: `i32` is never null — drop the `??` and its default
// A row-less record written into a record field or element, read straight off the assignment's
// value, and a null test of its `null` field.
type Node = { v: i32, left: Node | null }
const root: Node = { v: 1, left: null }
print((root.left = { v: 3, left: null }).v)
const ns: Node[] = [{ v: 2, left: null }]
print((ns[0] = { v: 4, left: null }).v)
const x = root.left = { v: 6, left: { v: 9, left: null } }
print(x.v)
print(x.left?.v ?? 0)
print((root.left = { v: 7, left: null }).left == null)
let q: Node | null = null
print((q = { v: 5, left: null }).left != null)
print(root.left?.v ?? 0)
print(ns[0].v)
