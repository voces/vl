// @run
// @log mk
// @log 103
// @log mk
// @log 100
// @log mk
// @log s
// @log mkB
// @log 102
// @log mkB
// @log 101
// @log mk
// @log <x>
// @log mk
// @log [7]
// @log mk
// @log 8
// @log mk
// @log -1
// @log mkB
// @log 6
// @log mk
// @log 9
// @log mk
// @log 5
// @log mk
// @log 10
// A `?.` over a call root, which legacy stages in its `?.` stash (read once, teed, read back cast to
// its record), standalone and under `?? d`, one and two links, in each position: a scalar and a
// union argument, a nested argument, a concat operand, an interpolation hole, a return, an
// initializer, an `if` arm, a `??` operand and a record field. Each call runs once.
type C = { v: i32, s: string }
type B = { c: C | null }
type R = { v: i32 }
function mkC(k: i32): C | null {
  print("mk")
  if k > 0 { return { v: k, s: "s" } }
  return null
}
function mkB(k: i32): B | null {
  print("mkB")
  if k > 1 { return { c: { v: k, s: "b" } } }
  if k > 0 { return { c: null } }
  return null
}
function plus(n: i32) { return n + 100 }
function show(u: i32 | string) {
  if u is string { return u } else { return "n" }
}
function id(n: i32) { return n }
function argScalar(k: i32) { return plus(mkC(k)?.v ?? 0) }
function argUnion(k: i32) { return show(mkC(k)?.s ?? "none") }
function argNested(k: i32) { return plus(id(mkB(k)?.c?.v ?? 1)) }
function concat(k: i32) { return "<" + (mkC(k)?.s ?? "x") + ">" }
function interp(k: i32) { return "[\{mkC(k)?.v ?? 2}]" }
function ret(k: i32) { return mkC(k)?.v }
function letInit(k: i32) {
  const v = mkB(k)?.c?.v ?? 3
  return v * 2
}
function ifArm(k: i32, c: boolean) {
  const v = if c { mkC(k)?.v ?? 4 } else { 0 }
  return v
}
function coal(k: i32) { return (mkC(k)?.v ?? null) ?? 5 }
function rec(k: i32) {
  const r: R = { v: mkC(k)?.v ?? 6 }
  return r
}
print(argScalar(3))
print(argScalar(0))
print(argUnion(1))
print(argNested(2))
print(argNested(1))
print(concat(0))
print(interp(7))
print(ret(8) ?? -1)
print(ret(0) ?? -1)
print(letInit(0))
print(ifArm(9, true))
print(coal(0))
print(rec(10).v)
