// @run
// @log 7
// @log 7
// @log 7
// @log 8
// @log 7
// @log 1.5
// @log 7
// @log 7
// @log 7
// @log 5
// An assignment's value is its right side at the right side's own type, even where the write
// widens into the target (`i32` into `f64` or `i64`, `f32` into `f64`) and a call on the right
// keeps it from moving ahead of an operand already evaluated.
type Q = { v: f32 }
type S = { x: i32 }

let wf = 0.0
let wl: i64 = 0
let wd = 0.0
function g() { return 7 }
function h(): f32 { return 1.5 }
function add(a: i32, b: i32) { return a + b }

const mp: {[string]: i32} = Map()
mp["w"] = (wf = g())
print(mp["w"] ?? 0)

const xs = [0]
xs[0] = (wl = g())
print(xs[0])

const b = { v: 0 }
b.v = (wf = g() + 0)
print(b.v)

const one = 1
print(add(one, (wf = g())))

function inner() {
  const ys = [0]
  ys[0] = (wf = g())
  return ys[0]
}
print(inner())

const q: Q = { v: 0.0 }
q.v = (wd = h())
print(q.v)
print(wf)

let ns: S | null = null
function takeS(p: i32, s: S) { return p + s.x }
print(takeS(g() - 4, ns = { x: 4 }))

let nl: i32[] | null = null
function takeL(p: i32, l: i32[]) { return p + l[0] }
print(takeL(g() - 4, nl = [4]))

type C = { v: i32 }
let gq: i64 = 0
function set(y: C) {
  if y.v > 0 { gq = 5 }
}
set({ v: 7 })
print(gq)
