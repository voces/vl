// @run
// @log 1.5
// @log 6000000000
// @log 1.5
// @log 7
// @log a
// @log 1.5
// @log 6000000000
// @log 1.5
// @log 3
// @log 7

// D1676 — a standalone `?.` builds its leaf's own `F | null` rep, one arm per rep family:
// the wide scalars ride the `{tag, payload}` box `i32 | null` already rides, and every list
// leaf is the wrapper's own nullable ref, the shape the nested-struct arm speaks one table
// over. Both faces, since only the un-annotated one exercises the classifiers.
type Bf = { y: f64 }
type Bi = { y: i64 }
type B3 = { y: f32 }
type Bl = { y: i32[] }
type Bs = { y: string[] }
type Bd = { y: f64[] }
type B6 = { y: i64[] }
type Bg = { y: f32[] }
type Bu = { y: u8[] }
type Bn = { y: i32[] | null }

function mki() { 6000000000 }

function mkf(): f32 { 1.5 }

function mku(): u8[] {
  const u: u8[] = [3, 4]
  u
}

// The box family: the leaf's own tag, not `i32`'s.
const bf: Bf | null = { y: 1.5 }
const vf = bf?.y
print(vf ?? 0.0)

const bi: Bi | null = { y: mki() }
const vi = bi?.y
print(vi ?? mki())

const b3: B3 | null = { y: mkf() }
const v3 = b3?.y
print(v3 ?? mkf())

// The list family: the wrapper's own nullable ref, read through the narrow so the heap type
// is proved rather than assumed.
const bl: Bl | null = { y: [7, 8] }
const vl = bl?.y
if vl != null { print(vl[0]) } else { print(0) }

const bs: Bs | null = { y: ["a"] }
const vs = bs?.y
if vs != null { print(vs[0]) } else { print("z") }

const bd: Bd | null = { y: [1.5] }
const vd = bd?.y
if vd != null { print(vd[0]) } else { print(0.0) }

const b6: B6 | null = { y: [mki()] }
const v6 = b6?.y
if v6 != null { print(v6[0]) } else { print(mki()) }

const bg: Bg | null = { y: [mkf()] }
const vg = bg?.y
if vg != null { print(vg[0]) } else { print(mkf()) }

const bu: Bu | null = { y: mku() }
const vu = bu?.y
if vu != null { print(vu[0]) } else { print(0) }

// A field that is ALREADY nullable takes the same blocktype — null from either end.
const bn: Bn | null = { y: [7] }
const vn = bn?.y
if vn != null { print(vn[0]) } else { print(0) }
