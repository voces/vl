// @run
// @log 1
// @log 9
// @log 2.5
// @log 0.5
// @log s
// @log d
// @log true
// @log false
// @log 4
// @log 9
// A `??` over a nullable field of a top-level list's element reads the element again on the
// present path, at the index it tested, for an immediate and a variable index.
type J = { r: i32 | null, g: i32 }
type F = { f: f64 | null }
type S = { s: string | null }
type B = { b: boolean | null }
const xs: J[] = [{ r: 1, g: 2 }, { r: null, g: 3 }]
print(xs[0].r ?? 9)
print(xs[1].r ?? 9)
const fs: F[] = [{ f: 2.5 }, { f: null }]
print(fs[0].f ?? 0.5)
print(fs[1].f ?? 0.5)
const ss: S[] = [{ s: "s" }, { s: null }]
print(ss[0].s ?? "d")
print(ss[1].s ?? "d")
const bs: B[] = [{ b: true }, { b: null }]
print(bs[0].b ?? false)
print(bs[1].b ?? false)
let k = 0
const ys: J[] = [{ r: 4, g: 0 }, { r: null, g: 0 }]
print(ys[k].r ?? 9)
k = 1
print(ys[k].r ?? 9)
