// @run
// @log 5
// @log 6
// @log 7
// @log 8
// @log 9
// @log b
// A PARENTHESISED assignment target (`(x) = 5`). `emitAssign` applied `unwrapParen` to the
// RHS and not to the target, so a `Paren` LHS matched none of its Ident / Index / Member
// arms and fell to `assignment target is not a simple name` — a sentence true about the
// node and false about the program, on a `vl check`-clean file (D1089).
//
// SIX DELIVERY POSITIONS, because the peel is at the top of `emitAssign` rather than in one
// arm: a local, the nested `((x))` spelling, a compound `+=`, a module GLOBAL (whose
// `globalIndexOfSid` was asking about the wrapper's own sid), an INDEX target and a MEMBER
// target. The string local is here because the target's rep is decided after the peel, not
// before it.
//
// THE LINT HAD THE IDENTICAL OMISSION, and this file is what found it: every rule asking
// "which binding does this assignment write" read the LHS node raw, so `(x) = 5` marked
// nothing and prefer-const reported ``x` is never reassigned` about a binding that is. The
// peel now lives in `plainIdentName` and at the `bindMark` site, so no `@info` is declared
// here — there is none to declare.
let g = 8

function localTarget() {
  let x = 1
  (x) = 5
  return x
}

function doubleParen() {
  let x = 1
  ((x)) = 6
  return x
}

function compound() {
  let x = 1
  (x) += 6
  return x
}

function globalTarget() {
  (g) = 8
  return g
}

function indexTarget() {
  const xs = [1, 2]
  (xs[0]) = 9
  return xs[0]
}

function memberTarget() {
  const s = { tag: "a" }
  (s.tag) = "b"
  return s.tag
}

print(localTarget())
print(doubleParen())
print(compound())
print(globalTarget())
print(indexTarget())
print(memberTarget())
