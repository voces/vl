// @run
// @log 2
// @log 1
// @log 2
// @log 1
// @log 6
// @log 5
// @log 9
// @log 4
// @log 30
// @log 30
// @warning this `??` default is never used: `i32` is never null — drop the `??` and its default
// @warning this `??` default is never used: `i32` is never null — drop the `??` and its default
// @hint redundant type annotation: `yOf` is inferred as `i32` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// A record written into a field or element of a narrower record, used as a value, yields the
// value at its own record; the store goes into the receiver read before the right-hand side.
type A = { x: i32 }
type B = { x: i32, y: i32 }
type H = { p: A | null }
const h: H = { p: null }
const b: B = { x: 1, y: 2 }
function yOf(q: B): i32 { return q.y }
print(yOf(h.p = b))
print(h.p?.x ?? 0)
const as: A[] = [{ x: 0 }, { x: 0 }]
print((as[0] = b).y)
print(as[0].x)
function mkB(): B { return { x: 5, y: 6 } }
print((h.p = mkB()).y)
print(h.p?.x ?? 0)
let h2: H = { p: null }
const keep = h2
function sw(): B { h2 = { p: null }; return { x: 9, y: 4 } }
print((keep.p = sw()).x)
print(yOf(h2.p = sw()))
let j = 0
function nj(): B { j = 1; return { x: 3, y: 30 } }
print((as[j] = nj()).y)
print(as[0].x * 10 + as[1].x)
