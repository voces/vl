// @run
// @log 3
// @log 3
// @log g
// @log h
// @log 12
// @hint redundant type annotation: `h2` is inferred as `i32`
// @hint redundant type annotation: `a` is inferred as `f64`
// @hint redundant type annotation: `b` is inferred as `f64`
// @hint redundant type annotation: `g` is inferred as `i32`
// @hint redundant type annotation: `h` is inferred as `i32`
// @hint redundant type annotation: `two` is inferred as `i32`
// D2398 moves a value-position write ahead of its statement only where nothing it could
// change has been evaluated yet. A callee a binding holds is read before the arguments, so a
// write after it stays put; named arguments run in parameter order (D2343), so none moves.
function h2(): i32 {
  fv = (x) => x * 100.0
  3
}
let fv: (f64) => f64 = (x) => x
let a: f64 = 0.5
print(fv(a = h2()))
function main() {
  let f: (f64) => f64 = (x) => x
  let b: f64 = 0.5
  const k = () => {
    f = (x) => x * 100.0
    3
  }
  print(f(b = k()))
}
main()
function g(): i32 {
  print("g")
  1
}
function h(): i32 {
  print("h")
  2
}
function two(x: i32, y: i32): i32 { x * 10 + y }
function named() {
  let c: i32 | null = null
  print(two(y: c = h(), x: g()))
}
named()
