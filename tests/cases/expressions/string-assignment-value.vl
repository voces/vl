// @run
// @log hi
// @log hi
// @log hi
// @log hi
// @log yo
// @log hey
// @log 3
// A string assignment used as a value is its target cell, a string, wherever it is read: a
// module-scope binding, a `print` argument, a field target, a method receiver (D14821).
let s = ""
const q = (s = "hi")
print(q)
print(s = "hi")
function g() {
  let t = ""
  const u: string = "hi"
  print(t = u)
}
g()
type R = { f: string }
const o: R = { f: "" }
print(o.f = "hi")
const w = (o.f = "yo")
print(w)
const h = (s = "hey")
print(h)
print(h.length)
