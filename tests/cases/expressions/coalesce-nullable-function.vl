// @log 9
// @log 3
// `??` over a nullable function value takes the value when present, else the default (D3373).
function h(n: i32) {
  const v = (if n == 2 { (q: i32) => q + 100 } else { null })
    ?? (q: i32) => q + 102
  print(v(1))
}
h(0)
h(2)
let g: ((q: i32) => i32) | null = null
print((g ?? (q: i32) => q + 1)(1))
g = (q: i32) => q * 10
print((g ?? (q: i32) => q + 1)(2))
type B = { y: () => i32 }
function mk(c: boolean): B | null {
  if c { return { y: () => 5 } }
  return null
}
print((mk(false)?.y ?? (() => 4))())
print((mk(true)?.y ?? (() => 4))())
function f(c: boolean): ((q: i32) => i32) | null {
  if c { return (q: i32) => q + 100 }
  return null
}
function dflt(q: i32) { q - 1 }
print((f(false) ?? dflt)(5))
print((f(true) ?? dflt)(5))
function mkK(k: i32): (() => i32) | null {
  if k < 0 { return null }
  return () => k
}
const base = 9
print((mkK(-1) ?? (() => base))())
print((mkK(3) ?? (() => base))())
