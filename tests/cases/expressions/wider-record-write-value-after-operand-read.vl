// @run
// @log 10
// @log 20
// @log 1
// @log 31
// @log 23
// @log 18
// @log 55
// @warning this `??` default is never used: `i32` is never null — drop the `??` and its default
// @hint redundant type annotation: `yOf` is inferred as `i32` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// A wider record written into a narrower name or field, used as a value after an operand its
// right-hand side changes: the operand is read first, the value is the record at its own type.
type A = { x: i32 }
type B = { x: i32, y: i32 }
type H = { p: A | null }
const h: H = { p: null }
function yOf(q: B): i32 { return q.y }
let k = 0
function nb(): B {
  k = k + 1
  return { x: k, y: k * 10 }
}
print(k + yOf(h.p = nb()))
let a: A = { x: 0 }
print(k + yOf(a = nb()) - k + 1)
print(h.p?.x ?? 0)
const xs = [5, 6, 7, 8, 9]
print(xs[k] + yOf(a = nb()) - xs[k] + xs[0] - 3)
let c: A = { x: 3 }
print(c.x + yOf(c = nb()) - 30 + c.x + 6)
let ys = [1, 2]
function nb2(): B {
  ys = [7, 8]
  return { x: 1, y: 10 }
}
print(ys[0] + yOf(c = nb2()) + ys[0])
const v = k + yOf(a = nb())
print(v + 1)
