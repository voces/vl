// @run
// @info `L` is never reassigned; use `const` instead of `let`
// @hint redundant type annotation: `sum` is inferred as `i64` — remove it to lean on inference
// @hint redundant type annotation: `neg2` is inferred as `i64` — remove it to lean on inference
// @log 2147483653
// @log 0
// @log 2147483653
// @log 2147483648
// @log 2147483648
// @log 2147483648
// @log -2147483648
// @log 4294967295
// @log 4294967295
// @log 4294967295
// @log 4294967295
// @log -4294967295
// @log -1
// @log -1
// @log 2147483648
// @log 2147483653
// @hint redundant type annotation: `K` is inferred as `i64` — remove it to lean on inference
// @hint redundant type annotation: `C0` is inferred as `i64` — remove it to lean on inference
// A negation chain over one integer literal is a literal tree: delivered to a 64-bit
// destination, operand or `as i64`, it computes at 64 bits, as one negation already did
// (D3043, D3049, D3050). With no destination a decimal chain is its exact value, so the last
// two are 2^31 and 2^31 + 5 (DECISIONS.md, "Exact constant arithmetic").
const K: i64 = 5 + -(-2147483648)
const C0: i64 = (-(-2147483648))
const C3: i64 = -(-(-2147483648))
const H = (-(-0xffffffff)) as i64
let L = (-(-0xffffffff)) as i64
const HA: i64 = -(-0xffffffff)
const H1 = (-0xffffffff) as i64
const W = (-(-0xffffffff)) as% i32
const N = -(-0xffffffff)
const M = -(-2147483648)

function sum(): i64 { 5 + -(-2147483648) }
function quot(): i64 { 5 / -(-2147483648) }
function neg2(): i64 { -(-2147483648) }
function peer(p: i64) { p + -(-2147483648) }
function peerHex(p: i64) { p + -(-0xffffffff) }
function narrow() { 5 + -(-2147483648) }

function show() {
  print(sum())
  print(quot())
  print(K)
  print(C0)
  print(neg2())
  print(peer(0))
  print(C3)
  print(H)
  print(L)
  print(HA)
  print(peerHex(0))
  print(H1)
  print(W)
  print(N)
  print(M)
  print(narrow())
}
show()
