// @check
// @error-at 14:8 argument 1: expected PlayerSlot, got EntityId
// The BUG CLASS, in the position it actually occurs: two `i32` ids, one passed
// where the other belongs. Under pure structural typing `EntityId`, `PlayerSlot`
// and `i32` are ONE type and this call is silent; that is the whole of webcraft
// P1.5's ask (`docs/webcraft-requirements.md` §P1.5).
//
// The diagnostic names both brands because `tyToStr` renders a newtype as its
// name. Without that arm the message would read "expected i32, got i32", which
// states the distinction and then hides it.
type EntityId = new i32
type PlayerSlot = new i32
function damage(who: PlayerSlot) { print(who) }
const e: EntityId = 3
damage(e)
