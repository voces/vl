// @run
// @log ok
// @log 5
// @log hi
// @log 2.5
// @log 1
// @warning Unused function `holeStr`
// @warning Unused function `holeMap`
// CONTRACT (D1092): a CLOSURE spelled as a struct FIELD reserves the heap types its
// signature needs, at every depth of an annotation spelling and whether or not anything
// calls the function that carries it.
//
// A presence flag is a RESERVATION: `mAssignTypeIndices` mints a heap type only where the
// flag is set, and an unminted index falls through to `mNextType` — whatever heap type
// happens to sit there. `function holeStr(z: {f: () => string})` in a program with no other
// string left `$aTypeIdx`/`$sBackIdx` unallocated, so the body read a closure struct as a
// string: `vl check` rc 0, `type mismatch: expected (ref null $type), found structref`. The
// list and map results were the same reservation seen from the emitter's side — `emitProgram:
// index access but list type not collected`, `… map op but map type not collected`.
//
// THE ALIAS SPELLING RAN ONLY BY ACCIDENT, which is what located this. `type Fs = {f: () =>
// string}` mints a SECOND `TypeRef` for the alias body's arrow (`<()=>string>` beside
// `<Fs>`), which the top-level `annRetNameOf` rung then sees; the inline spelling mints ONE
// node (`<{f:()=>string}>`) and nothing looked inside it. Both build the SAME struct row
// (one field, code 14), so no type table can tell them apart. One nesting level deeper the
// accident stops paying — `{g: {f: () => …}}` failed at BOTH spellings — which is why
// `forceNestedCloSigReps` walks the spelling instead of special-casing the alias.
//
// THE UNCALLED FUNCTIONS ARE THE POINT, NOT AN OVERSIGHT: a call site pins the shape from the
// ARGUMENT and hides the defect, so `holeStr` and `holeMap` carry the spelling that has to
// build on its own. The called paths below CONSTRUCT values at the same shapes and
// DISCRIMINATE on them (`2.5`, not `2`), so a reservation resolving to the wrong heap type
// prints the wrong thing rather than merely validating.
type Fs = {f: () => string}

// UNCALLED, inline, string result — the witness.
function holeStr(z: {f: () => string}) {
  print(z.f())
}

// UNCALLED, inline, MAP result — the reservation the emitter refused outright.
function holeMap(m: {f: () => {[string]: i32}}) {
  print(m.f()["k"])
}

// The ALIAS control: the path that already worked and must keep working.
function viaAlias(a: Fs) {
  a.f()
}

// The nested-shape spelling, one level in — the depth at which the alias accident stops.
function viaNested(n: {g: {f: () => i32}}) {
  n.g.f()
}

// A string-list result, whose wrapper/backing pair the same walk has to reserve.
function viaList(l: {f: () => string[]}) {
  l.f()[0]
}

// An f64-list result: `2.5` and not `2` is what proves the element rep, not just the type.
function viaF64(d: {f: () => f64[]}) {
  d.f()[0]
}

function rd() {
  print(viaAlias({ f: () => "ok" }))
  print(viaNested({ g: { f: () => 5 } }))
  print(viaList({ f: () => ["hi"] }))
  print(viaF64({ f: () => [2.5] }))
  print(1)
}

rd()
