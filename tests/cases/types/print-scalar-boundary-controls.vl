// @run
// @log a
// @log b
// @log 7
// @log 1
// @log 2
// @log 3
// @log 2
// @log 1.5
// @log 5000000000
// @log true
// @log 12
// CONTRACT (must-RUN): the exact boundary of what `print` CAN lower — the FALSE side of the
// `print(<reference>)` gate. `print` renders ONE scalar or string rep; every value whose rep
// is a WasmGC REFERENCE (an array, a struct, a map/set, a function value, a union carrying
// one of those, and any of them behind `| null`) has no scalar rep, and the emitter's print
// ladder ends in an unguarded `call __print_i32__` — it hands that import a `(ref $t)` and the
// module fails to VALIDATE ("expected i32, found (ref $type)") while `vl check` reports the
// program clean. The rejection for that family belongs beside `tyPrintsAsUnionBox` in the
// checker's `print` arm; `types/print-union-rejected.vl` is the same admission for a boxed
// value union, and this file is its complement.
//
// THESE ELEVEN are the cells such a rejection must NOT touch, gathered in one place because
// the predicate's boundary is exactly where a too-wide gate would silently break working
// programs: a `string` IS a reference but routes to the string streaming printer; a literal
// union is an i32/string ATOM widened to its member text; a NULLABLE string is a niche that
// still prints; and every read OUT of a reference (element, field, `.length`, a map value) is
// a scalar again.
type K = "a" | "b"

// 1-2. a literal union, and a nullable string that holds a value: both print.
const k: K = "a"
print(k)
const s: string | null = "b"
print(s)

// 3-6. reads OUT of references are scalars: struct field, array element, `.length`.
type S = { v: i32 }
function fieldOf(st: S) {
  print(st.v)
}
fieldOf({ v: 7 })
const xs = [1, 2, 3]
let i = 0
while i < xs.length {
  print(xs[i])
  i = i + 1
}

// 7. a map's `.length`. Built inside a function: a top-level `.set` on a string-keyed map is
// a SEPARATE, pre-existing miscompile (the start function's local frame is not sized for the
// map-op scratch — `const m: {[string]: i32} = Map()` + `m.set("p", 1)` alone emits
// `unknown local N: local index out of bounds` while `vl check` reports it clean).
function mapLen() {
  const m: {[string]: i32} = Map()
  m.set("p", 1)
  m.set("q", 2)
  print(m.length)
}
mapLen()

// 8-10. the non-i32 scalar print imports each keep their own route.
const f = 1.5
print(f)
const n = 5000000000
print(n)
print(true)

// 11. a string built at runtime still streams.
print(toString(12))
