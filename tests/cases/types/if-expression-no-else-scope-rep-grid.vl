// @hint redundant type annotation: `mki32` is inferred as `i32`
// @hint redundant type annotation: `mkboolean` is inferred as `boolean`
// @hint redundant type annotation: `mkstring` is inferred as `string`
// @hint redundant type annotation: `mkf64` is inferred as `f64`
// @hint redundant type annotation: `mki64` is inferred as `i64`
// @hint redundant type annotation: `mklist` is inferred as `i32[]`
// @hint redundant type annotation: `mkstringlist` is inferred as `string[]`
// @hint redundant type annotation: `mi32T` is inferred as `i32 | null`
// @hint redundant type annotation: `mi32F` is inferred as `i32 | null`
// @hint redundant type annotation: `mbooleanT` is inferred as `boolean | null`
// @hint redundant type annotation: `mbooleanF` is inferred as `boolean | null`
// @hint redundant type annotation: `mstringT` is inferred as `string | null`
// @hint redundant type annotation: `mstringF` is inferred as `string | null`
// @hint redundant type annotation: `mf64T` is inferred as `f64 | null`
// @hint redundant type annotation: `mf64F` is inferred as `f64 | null`
// @hint redundant type annotation: `mi64T` is inferred as `i64 | null`
// @hint redundant type annotation: `mi64F` is inferred as `i64 | null`
// @hint redundant type annotation: `mf32T` is inferred as `f32 | null`
// @hint redundant type annotation: `mf32F` is inferred as `f32 | null`
// @hint redundant type annotation: `mstructT` is inferred as `P | null`
// @hint redundant type annotation: `mstructF` is inferred as `P | null`
// @hint redundant type annotation: `munionT` is inferred as `i32 | string | null`
// @hint redundant type annotation: `munionF` is inferred as `i32 | string | null`
// @hint redundant type annotation: `mlitunionT` is inferred as `K | null`
// @hint redundant type annotation: `mlitunionF` is inferred as `K | null`
// @hint redundant type annotation: `mlistT` is inferred as `i32[] | null`
// @hint redundant type annotation: `mlistF` is inferred as `i32[] | null`
// @hint redundant type annotation: `mstringlistT` is inferred as `string[] | null`
// @hint redundant type annotation: `mstringlistF` is inferred as `string[] | null`
// @hint redundant type annotation: `mmapT` is inferred as `{[string]: i32} | null`
// @hint redundant type annotation: `mmapF` is inferred as `{[string]: i32} | null`
// @hint redundant type annotation: `x` is inferred as `i32 | null`
// @hint redundant type annotation: `x` is inferred as `boolean | null`
// @hint redundant type annotation: `x` is inferred as `string | null`
// @hint redundant type annotation: `x` is inferred as `f64 | null`
// @hint redundant type annotation: `x` is inferred as `i64 | null`
// @hint redundant type annotation: `x` is inferred as `f32 | null`
// @hint redundant type annotation: `x` is inferred as `P | null`
// @hint redundant type annotation: `x` is inferred as `i32 | string | null`
// @hint redundant type annotation: `x` is inferred as `K | null`
// @hint redundant type annotation: `x` is inferred as `i32[] | null`
// @hint redundant type annotation: `x` is inferred as `string[] | null`
// @hint redundant type annotation: `x` is inferred as `{[string]: i32} | null`
// CONTRACT (must-RUN): the SCOPE x REP grid of an else-less `if` used as a VALUE
// (DECISIONS, "An else-less `if` used as a VALUE is `T | null` in every position"). Twelve
// then-arm reps, crossed with a MODULE-scope binding and a FUNCTION-scope one, each taken
// and each missed.
//
// MODULE SCOPE IS NOT A SUBSET OF FUNCTION SCOPE, which is why both halves are here and
// why the grid is the grading list. The two storage classes reach different lowerings — a
// local slot's void `if` writes the slot, a global cell's runs in the synthetic start
// function — and before the ruling was built the grid graded 14 of 48 cells running with
// module scope refusing at EVERY rep, including four scalar reps that ran one nesting
// level in.
//
// AND EVERY CELL IS HERE TWICE, ANNOTATED (`m*`/`fn*`) AND INFERRED (`i*`/`inf*`). An
// annotation PINS the rep, so a grid that annotates every destination cannot see the
// defect whose ingredient is inference doing the pinning instead — measured on the way in:
// with the annotated half green, five composite reps (struct, litunion, i32-list,
// string-list, map) still classified an un-annotated slot neither arm could fill, one of
// them silently (an i32 local holding a `(ref null $lTypeIdx)`, `vl check` rc 0).
//
// EVERY CELL DISCRIMINATES: the `…T` binding takes the arm and prints its own value, the
// `…F` binding misses and prints -1. A synthesized null that produced the arm's value
// anyway — or an arm whose value never reached the slot — moves a line here.
type P = { a: i32 }
type K = "a" | "b"
function mki32(): i32 {
  7
}

function mkboolean(): boolean {
  true
}

function mkstring(): string {
  "hi"
}

function mkf64(): f64 {
  1.5
}

function mki64(): i64 {
  6000000000
}

function mkf32(): f32 {
  1.5
}

function mkstruct(): P {
  { a: 7 }
}

function mkunion(): i32 | string {
  7
}

function mklitunion(): K {
  "a"
}

function mklist(): i32[] {
  [7]
}

function mkstringlist(): string[] {
  ["hi"]
}

function mkmap(): {[string]: i32} {
  const m: {[string]: i32} = Map()
    m["k"] = 7
    m
}

const mi32T: i32 | null = if 1 == 1 { mki32() }
if mi32T != null { print(mi32T) } else { print(-1) }
const mi32F: i32 | null = if 1 == 2 { mki32() }
if mi32F != null { print(mi32F) } else { print(-1) }

const mbooleanT: boolean | null = if 1 == 1 { mkboolean() }
if mbooleanT != null { print(if mbooleanT { 1 } else { 0 }) } else { print(-1) }
const mbooleanF: boolean | null = if 1 == 2 { mkboolean() }
if mbooleanF != null { print(if mbooleanF { 1 } else { 0 }) } else { print(-1) }

const mstringT: string | null = if 1 == 1 { mkstring() }
if mstringT != null { print(mstringT) } else { print(-1) }
const mstringF: string | null = if 1 == 2 { mkstring() }
if mstringF != null { print(mstringF) } else { print(-1) }

const mf64T: f64 | null = if 1 == 1 { mkf64() }
if mf64T != null { print(mf64T) } else { print(-1) }
const mf64F: f64 | null = if 1 == 2 { mkf64() }
if mf64F != null { print(mf64F) } else { print(-1) }

const mi64T: i64 | null = if 1 == 1 { mki64() }
if mi64T != null { print(mi64T) } else { print(-1) }
const mi64F: i64 | null = if 1 == 2 { mki64() }
if mi64F != null { print(mi64F) } else { print(-1) }

const mf32T: f32 | null = if 1 == 1 { mkf32() }
if mf32T != null { print(mf32T) } else { print(-1) }
const mf32F: f32 | null = if 1 == 2 { mkf32() }
if mf32F != null { print(mf32F) } else { print(-1) }

const mstructT: P | null = if 1 == 1 { mkstruct() }
if mstructT != null { print(mstructT.a) } else { print(-1) }
const mstructF: P | null = if 1 == 2 { mkstruct() }
if mstructF != null { print(mstructF.a) } else { print(-1) }

const munionT: i32 | string | null = if 1 == 1 { mkunion() }
if munionT != null { print(if munionT is i32 { munionT } else { 0 }) } else { print(-1) }
const munionF: i32 | string | null = if 1 == 2 { mkunion() }
if munionF != null { print(if munionF is i32 { munionF } else { 0 }) } else { print(-1) }

const mlitunionT: K | null = if 1 == 1 { mklitunion() }
if mlitunionT != null { print(mlitunionT) } else { print(-1) }
const mlitunionF: K | null = if 1 == 2 { mklitunion() }
if mlitunionF != null { print(mlitunionF) } else { print(-1) }

const mlistT: i32[] | null = if 1 == 1 { mklist() }
if mlistT != null { print(mlistT[0]) } else { print(-1) }
const mlistF: i32[] | null = if 1 == 2 { mklist() }
if mlistF != null { print(mlistF[0]) } else { print(-1) }

const mstringlistT: string[] | null = if 1 == 1 { mkstringlist() }
if mstringlistT != null { print(mstringlistT[0]) } else { print(-1) }
const mstringlistF: string[] | null = if 1 == 2 { mkstringlist() }
if mstringlistF != null { print(mstringlistF[0]) } else { print(-1) }

const mmapT: {[string]: i32} | null = if 1 == 1 { mkmap() }
if mmapT != null { print(mmapT["k"] ?? 0) } else { print(-1) }
const mmapF: {[string]: i32} | null = if 1 == 2 { mkmap() }
if mmapF != null { print(mmapF["k"] ?? 0) } else { print(-1) }

function fni32(c: boolean): void {
  const x: i32 | null = if c { mki32() }
  if x != null { print(x) } else { print(-1) }
}
fni32(true)
fni32(false)

function fnboolean(c: boolean): void {
  const x: boolean | null = if c { mkboolean() }
  if x != null { print(if x { 1 } else { 0 }) } else { print(-1) }
