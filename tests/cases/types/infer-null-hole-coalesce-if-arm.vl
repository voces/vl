// @run
// @log 0
// D1576 — A NEVER-FILLED A-INFER-NULL HOLE IS THE `null` TYPE, AND IT HAS A REP.
// `x = null` binds `mkNullableTy(-1)`, a `TyNullable` whose inner is the open hole; when no
// assignment ever fills it the binding's only value is `null`, so the checker banks that at
// scope close and the emitter gives the cell `nullref` — the GC bottom (D1567's `nulnone`).
// `x ?? 0` is then statically the default, and the if-EXPRESSION over two `null`-typed arms
// is `null`-typed too. D1575 made this program a loud reject instead of a compiler trap;
// this row makes it run. Every reader of `.nInner` still bound-tests before indexing the
// arena — `scripts/capability-probes/infer-null-hole-if-coalesce.vl` is the same program
// kept as the probe.
function go(c: boolean) {
  const x = null
  const y = (if c { x } else { x }) ?? 0
  print(y)
}
go(true)
