// @emit-error `??` over this nullable value is not supported yet
// D1575 — THE A-INFER-NULL HOLE MUST NOT TRAP THE COMPILER. `x = null` binds
// `mkNullableTy(-1)`: a `TyNullable` whose inner is still the OPEN hole. Every reader of
// `.nInner` in `compiler/typecheck.vl` therefore bound-tests before indexing the arena —
// unguarded, `nodeTyIsNulScalarBox` (and four siblings) read `T.tys[-1]` and the COMPILER
// died with an anonymous `out of bounds array access` on this `vl check`-clean program.
//
// What it pins is a STAGE and a message, not a capability: the hole has no rep, so `??`
// over it is the loud emit reject it already owes. `scripts/capability-probes/
// infer-null-hole-if-coalesce.vl` is the same program filed as the GAP (it should print 0).
function go(c: boolean) {
  const x = null
  const y = (if c { x } else { x }) ?? 0
  print(y)
}
go(true)
