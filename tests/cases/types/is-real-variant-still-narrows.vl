// @run
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 0
// D228's CONTROL — every `is` whose check type really IS a variant of the receiver keeps
// narrowing. `isWidenNotVariant` adds a case to the soundness gate; it must not take one
// away, and these are the spellings a name-keyed test could plausibly have caught by
// mistake: the same primitive on both sides of a nullable, of a two-member union, and of
// a union whose other member is a different numeric.
const a: f64 | null = 7.0
if a is f64 { print(7) } else { print(0) }

const b: i64 | null = 7
if b is i64 { print(7) } else { print(0) }

const c: i32 | null = 7
if c is i32 { print(7) } else { print(0) }

const d: i32 | string = 7
if d is i32 { print(7) } else { print(0) }

const e: f64 | i32 = 7
if e is i32 { print(7) } else { print(0) }

// …and the ELSE side really is taken when the value is the other member, so the tag test
// is a test and not a constant.
const f: f64 | i32 = 7.5
if f is i32 { print(1) } else { print(0) }
