// fixture becomes a `@run` of `3` — the local `P` shadowing the module one.
type P = { x: i32 }
function f(): i32 {
  type P = { x: i32, y: i32 }
  const p: P = { x: 1, y: 2 }
  return p.x + p.y
}
print(f())
