// @check
// @error-at 11:6 A is not B: they store field `n` differently
// @error-at 17:6 C is not D: they store field `v` differently
// Two recursive records that differ in a field's storage are refused at a shared delivery, whichever
// field comes first (D16736: with the recursive field first, the storage comparison restarted its
// budget at every record and exhausted the compiler's call stack).

type A = { n: A | null, v: i32 }
type B = { n: B | null, v: i32 | null }
function showB(x: B) { print(x.v ?? 0) }
const a: A = { n: null, v: 3 }
showB(a)

type C = { v: i32, n: C | null }
type D = { v: i32 | null, n: D | null }
function showD(x: D) { print(x.v ?? 0) }
const c: C = { v: 3, n: null }
showD(c)
