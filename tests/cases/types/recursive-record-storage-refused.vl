// @check
// @error-at 16:6 A is not B: they store field `n` differently
// @error-at 23:6 C is not D: they store field `v` differently
// @error-at 32:6 P is not Q: they store field `n` differently
// @error-at 42:6 R is not T: they store field `b` differently
// A recursive record pair that stores a field differently is refused at a shared delivery,
// whichever field comes first and however deep the cycle runs (D16736: with the recursive field
// first, the storage comparison restarted its budget at every record and exhausted the compiler's
// call stack). A pair met again on its own cycle is stored alike so far, never a pair that merely
// shares a type, and a recursive pair stored alike still runs.

// The recursive field first.
type A = { n: A | null, v: i32 }
type B = { n: B | null, v: i32 | null }
function showB(x: B) { print(x.v ?? 0) }
const a: A = { n: null, v: 3 }
showB(a)

// The differing field first.
type C = { v: i32, n: C | null }
type D = { v: i32 | null, n: D | null }
function showD(x: D) { print(x.v ?? 0) }
const c: C = { v: 3, n: null }
showD(c)

// Mutually recursive, the difference two records in.
type P = { n: P2 | null }
type P2 = { m: P | null, v: i32 }
type Q = { n: Q2 | null }
type Q2 = { m: Q | null, v: i32 | null }
function showQ(x: Q) { print(x.n == null) }
const p: P = { n: null }
showQ(p)

// One record type under two fields, only one of which differs.
type S = { x: i32 }
type R = { a: S | null, b: S | null }
type U = { x: i32 }
type V = { x: i32 | null }
type T = { a: U | null, b: V | null }
function showT(x: T) { print(x.a == null && x.b == null) }
const r: R = { a: null, b: null }
showT(r)
print(r.a == null && r.b == null)

// A recursive pair stored alike is not refused.
type E = { n: E | null, v: i32 }
type F = { n: F | null, v: i32 }
function showF(x: F) { print(x.v) }
const e: E = { n: null, v: 5 }
showF(e)
