// @run
// @log 1
// @log 1
// @log 2
// @log 2
// @hint redundant type annotation: `wf` is inferred as `{f: {a: i32, b: i32}}`
// @hint redundant type annotation: `wb` is inferred as `{f: {a: i32, b: i32}}`
// A FORWARD-REFERENCED STRUCT DECLARATION, which needs the referenced declaration's
// BODY and not merely its arena slot — so it is not fixed by minting placeholders
// early, only by filling one on demand. `intersectTy` merges the operands FIELD-WISE,
// so two still-empty placeholders merged to the empty object `{}` and the field's type
// became `{}`: `no field 'a' on {}` at every read, a loud reject for a program whose
// declaration-swapped twin runs.
//
// This is the leg that registers a `TypeDecl` (a `{ … }`-bodied declaration) for
// on-demand filling, as distinct from the alias leg that registers a `UnionDecl`
// (`alias-declared-after-use.vl`, `-litunion-chain.vl`). Neither leg covers the other:
// removing the `UnionDecl` registration leaves this file green.
//
// AGREEMENT IS THE ASSERTION: each value is printed once through the forward-declared
// spelling and once through the identical back-declared one. The oracle is the LOG, so a
// regression that restores the old resolution order shows up as a wrong or missing line
// whichever way it degrades — not as a build verdict.
//
// The two hints are kept on purpose: the annotation is the only thing naming `WFwd` /
// `WBack`, and the hint fires precisely BECAUSE the forward-declared intersection now
// infers to the same merged `{a, b}` as its back-declared twin. Before, it inferred
// `{f: {}}` and there was no hint to declare.

// ── forward: every referenced declaration sits BELOW its reference ────────────
type WFwd = { f: SFwd & TFwd }
type SFwd = { a: i32 }
type TFwd = { b: i32 }

// ── back: the identical declarations, in the order that always worked ─────────
type SBack = { a: i32 }
type TBack = { b: i32 }
type WBack = { f: SBack & TBack }

function go() {
  const wf: WFwd = { f: { a: 1, b: 2 } }
  const wb: WBack = { f: { a: 1, b: 2 } }
  print(wf.f.a)
  print(wb.f.a)
  print(wf.f.b)
  print(wb.f.b)
}

go()
