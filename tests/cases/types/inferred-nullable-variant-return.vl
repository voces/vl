// @run
// @log 7
// @log -1
// @log 7
// D1562 — an INFERRED return that delivers `Hit | null`, `Hit` being an arm of a declared
// union. The name ladder's `nulstruct` arm has no struct row to find (`collectS` skips a
// `TypeDecl` that `variantIndexOf` claims), so before its `nulvariant` twin the whole ladder
// fell through and `criClassify`'s `exprNullableStruct` — whose per-node fallback cannot tell
// a union ARM from a standalone struct — stamped (`"nulstruct"`, -1) over it.
//
// THE ANNOTATED FACE IS THE CONTROL and is the third print: it ran throughout, so the two
// spellings must now agree rather than one of them merely working.
type Hit = { v: i32 }
type Miss = { m: string }
type R = Hit | Miss

function mkA(ok: boolean): Hit | null {
  if ok { return null }
  return { v: 7 }
}

// UN-ANNOTATED — the row. Both a call result and a bare `return null` flow out of it, so the
// return-site null seed is graded beside the signature.
function inferred(ok: boolean) {
  if ok { return null }
  return mkA(false)
}

// ANNOTATED — the control.
function annotated(ok: boolean): Hit | null {
  if ok { return null }
  return mkA(false)
}

const a = inferred(false)
if a != null { print(a.v) } else { print(-1) }
const b = inferred(true)
if b != null { print(b.v) } else { print(-1) }
const c = annotated(false)
if c != null { print(c.v) } else { print(-1) }
