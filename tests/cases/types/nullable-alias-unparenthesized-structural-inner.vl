// @run
// @log 15
// @log nilS
// @log 25
// @log nilI
// @log 33
// @log nilL
// @log 45
// @log nilIs
// @log 52
// @log nilR
// @log 65
// @log nilG
// @log 80
// @log nilF
// @log true
// @log nilU
// @log 89
// @log nilC
// AN UN-PARENTHESIZED `type T = X | null` DENOTES THE NICHE FOR EVERY INNER, including
// the ones the emit render spells STRUCTURALLY: a declared struct, an inline struct, a
// list, a generic application, a closure, a declared union. `types/nullable-alias-map-
// inner-unparenthesized.vl` carries the MAP inner, which cannot share a module with a
// narrowed nullable struct.
//
// WHY IT IS A FIXTURE. The declaration route's `| null` fold was gated on the inner
// being a primitive or a string litunion, so every inner below interned a TWO-VARIANT
// `TyUnion[X, null]` for this spelling while the parenthesized declaration
// `type T = (X | null)` and the inline annotation `x: (X | null)` interned `X?`. Naming
// the type then removed a capability: the checker kept the wrapper and every program
// here was a loud check reject (`field 'v' is not on every member of {v: i32} | null`,
// `field 'length' is not on every member of i32[] | null`, `called value is not a
// function`). The fold is `annUnionTy` — the same shared annotation home the other two
// spellings climb — so all three spellings now intern one arena shape and emit one
// module, byte for byte.
//
// THE GATE COULD NOT BE NARROWED INSTEAD OF REMOVED, and that is the invariant this
// file guards. `singleAliasMemberTyIx`'s nullable arm claims a one-member wrapper over
// a niche for EVERY inner, so an inner the declaration declined got a union ROW from
// `collectU` that no read of the value lowered as — a `vl check` rc 0 and an invalid
// module, or a loud narrow-first reject, depending on the inner's rep. The two
// questions are one question.
//
// REDDENS ON A LOG MISMATCH AS WELL AS ON A VERDICT. Every function is called at BOTH
// runtime inputs, and the non-null call prints a VALUE READ THROUGH THE NARROW plus a
// per-inner offset rather than a marker — so a ruling that claims the wrapper but lowers
// the wrong rep is a wrong number here, not a silent pass. The offsets differ per inner
// so a crossed lowering cannot print the right total.
//
// WHAT THIS FILE DELIBERATELY DOES NOT REACH. Passing the narrowed value onward to a
// NON-NULL parameter is a pre-existing invalid module in the INLINE spelling for a list,
// a map or a closure inner (`type mismatch: expected (ref $type), found (ref null
// $type)`), and a declared-struct inner at a module `const`, a list ELEMENT or a generic
// INSTANTIATION is a pre-existing loud emit reject there. Both are the alias-free
// spelling's holes, reached identically through the alias, and are filed for the
// emitter.

type Box<A> = {b: A}
type S = {v: i32}
type L = i32[]
type FN = (i32) => i32
type U = {a: i32} | {b2: i32}

type TS = S | null
type TI = {v: i32} | null
type TL = L | null
type TG = Box<i32> | null
type TF = FN | null
type TU = U | null

// A DECLARED STRUCT inner, narrowed with `!= null` and read through the field.
function fS(x: TS) {
  if x != null { print(x.v + 10) } else { print("nilS") }
}
fS({ v: 5 })
fS(null)

// The same inner spelled INLINE inside the declaration.
function fI(x: TI) {
  if x != null { print(x.v + 20) } else { print("nilI") }
}
fI({ v: 5 })
fI(null)

// A LIST inner: a second rep, reached the same way.
function fL(x: TL) {
  if x != null { print(x.length + 30) } else { print("nilL") }
}
fL([1, 2, 3])
fL(null)

// `is <Inner>` on the alias. This is the form the two-member union carried and the
// niche did not while `collectU` still minted the alias a variant row.
function iS(x: TS) {
  if x is S { print(x.v + 40) } else { print("nilIs") }
}
iS({ v: 5 })
iS(null)

// RETURNED through an alias-typed return and re-narrowed at the call site.
function rL(x: TL): TL { return x }
function jL(x: TL) {
  const y = rL(x)
  if y != null { print(y.length + 50) } else { print("nilR") }
}
jL([1, 2])
jL(null)

// A GENERIC APPLICATION inner.
function fG(x: TG) {
  if x != null { print(x.b + 60) } else { print("nilG") }
}
fG({ b: 5 })
fG(null)

// A CLOSURE inner, called through the narrow.
function addSeven(n: i32) { return n + 7 }
function fF(x: TF) {
  if x != null { print(x(3) + 70) } else { print("nilF") }
}
fF(addSeven)
fF(null)

// A DECLARED UNION inner, discriminated through the narrow.
function fU(x: TU) {
  if x != null { print(x is {a: i32}) } else { print("nilU") }
}
fU({ a: 5 })
fU(null)

// A module `const` and a function-local `let` at the same spelling — the two-member
// union reached these through a different lowering than the parameter did, so the niche
// has to be the same type at all three.
const gI: TI = { v: 9 }
const gN: TL = null
if gI != null { print(gI.v + 80) } else { print("nilC") }
if gN != null { print(gN.length) } else { print("nilC") }
