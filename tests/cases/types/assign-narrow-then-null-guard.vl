// @run
// @log 1
// @log 3
// @log hi
// @log 7
// @log 9
// @log 2
// A straight-line `x = e` with a non-null `e` NARROWS `x` for the rest of the
// block, and the narrowing used to be recorded by re-`declare`-ing the name — with
// no scope of its own, so in the scope that HOLDS the declaration it did not shadow
// the binding, it REPLACED it. Every question that must ask what the binding was
// DECLARED as then got the narrowed answer instead, and the guarded spelling below
// stopped compiling:
//
//   cannot compare {n: i32}[] with null
//
// The narrowing is a correct flow fact; the declared type is the STORAGE contract.
// Both live now: reads stay narrowed (the `.n` / `.length` reads here need no
// guard), while a null TEST and a null WRITE keep asking the declaration.
//
// Not module-scope-only, which is how it was filed: the identical failure occurred
// inside a function body, where the declaration and the assignment also share a
// scope. `fnScope()` below is that half.
type S = { n: i32 }

let xs: S[] | null = []
xs = [{ n: 1 }]
if xs != null { print(xs[0].n) }

let ys: i32[] | null = null
ys = [1, 2, 3]
if ys != null { print(ys.length) }

let s: string | null = null
s = "hi"
if s != null { print(s) }

function fnScope() {
  let v: S | null = null
  v = { n: 7 }
  if v != null { print(v.n) }
  // The narrowing itself, unguarded — the pattern the flow fact exists for. A
  // slice that "fixed" the guard by dropping the narrowing would break this line.
  v = { n: 9 }
  print(v.n)
}

fnScope()

// THE WRITE THAT ENDS THE PATH. Storing null back into a narrowed name is legal
// again (it was "cannot assign null to {n: i32}[]"), and it un-narrows the binding
// for the reads after it — a flow fact must not outlive the flow.
xs = null
if xs == null { print(2) }
