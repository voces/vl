// @run
// @log 5
// @log N
// @log 3
// @log N
// @log 7
// @log N
// @log 12
// @log N
// A ONE-MEMBER ALIAS OVER A NULLABLE whose INNER the emit render spells STRUCTURALLY —
// a declared struct, a list, a map — and the `!= null` NARROW through it. The inline
// spelling (`x: S | null`) runs every one of these programs, so an alias that rejected
// them made NAMING a type remove a capability.
//
// `type TS = (S | null)` interns `TyUnion[S?]`, and whether that one-member wrapper
// DENOTES its member is `singleAliasMemberTyIx`'s single ruling, read by the checker
// (`declaredTyOfName`) and by the emitter (`singleMemberAliasTyIx`). Its nullable arm
// was gated on the inner being a PRIMITIVE or a LITUNION, so all three inners below
// stayed opaque on both sides: the checker kept the wrapper (`field 'v' is not on every
// member of {v: i32}? — narrow with `is` first`, `field 'length' is not on every member
// of i32[]?`, `cannot index non-array {[string]: i32}?`) and the emitter minted the
// alias a one-variant union ROW.
//
// WHY THE FIX IS NOT IN `nonNullTy`, which is where the symptom points. Peeling the
// one-member wrapper in the narrow is the CHECKER moving without the emitter: the value
// still lowers as a union box, and a 1,020-cell alias grid reads 47 loud emit rejects,
// 15 check-clean-invalid-wasm cells and ZERO new running programs for that shape. The
// wrapper never reaches `nonNullTy` once the transparency arm claims it, because the
// ANNOTATION already resolved `TS` to `S?`.
//
// THIS FILE REDDENS ON A LOG MISMATCH AS WELL AS ON A VERDICT, and both halves are
// load-bearing. Every function is called at BOTH runtime inputs, and each prints a
// VALUE read through the narrowed member (`x.v`, `x.length`, the map get) rather than a
// marker — so a ruling that claims the wrapper but lowers the wrong rep is a wrong
// number here, not a silent pass.
//
// WHAT THIS FILE DELIBERATELY DOES NOT REACH. Passing the narrowed value onward to a
// non-null parameter is a PRE-EXISTING invalid module in the INLINE spelling for a ref
// inner (`useL(y: L)` fed a narrowed `L | null` is `type mismatch: expected (ref $type),
// found (ref null $type)` on master with no alias in the program), and a nullable-MAP
// parameter standing beside a NARROWED nullable-struct parameter is a second shape of it
// — which is why `types/nullable-alias-opaque-inner-is-and-return.vl` carries the `is`
// and return-round-trip halves with no map in the program. Both are filed for the
// emitter, and the alias spelling's failure SET on those shapes is identical to the
// inline spelling's, cell for cell.

type S = {v: i32}
type L = i32[]
type M = {[string]: i32}

type TS = (S | null)
type TL = (L | null)
type TM = (M | null)

// FIELD READ through the narrow — the witness.
function fS(x: TS) {
  if x != null { print(x.v) } else { print("N") }
}
fS({ v: 5 })
fS(null)

// `.length` on a LIST inner: a second rep, reached the same way.
function fL(x: TL) {
  if x != null { print(x.length) } else { print("N") }
}
fL([1, 2, 3])
fL(null)

// INDEX READ on a MAP inner — `cannot index non-array` was the wrapper leaking.
function fM(x: TM) {
  if x != null { print(x["k"] ?? 0) } else { print("N") }
}
const mv: M = Map()
mv["k"] = 7
fM(mv)
fM(null)

// The `== null` EARLY-RETURN spelling of the same narrow, post-guard, with arithmetic on
// the narrowed read.
function hL(x: TL) {
  if x == null {
    print("N")
    return 0
  }
  print(x.length + 10)
  return 0
}
hL([1, 2])
hL(null)
