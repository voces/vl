// @run
// @log 3
// @log 6
// @log NULL
// @log 2
// @log 5
// @log 4
// @hint redundant type annotation: `ann` is inferred as `(i32 | null)[]`
// An UN-ANNOTATED array literal whose element is a BOXED nullable scalar (`i32 | null`):
// the one element rep left after D1340. `i32` has no null representation, so the element
// is a union BOX rather than a niche, and `arrLitNulRefElemName` used to refuse kind 2
// outright — the literal fell to the mono i32 list with a `(ref $uBox)` stored into an
// i32 backing (`vl check` rc 0, invalid wasm). D1372.
//
// The ANNOTATED spelling is the control, and it must intern the SAME row: `push`ing a
// value read out of one list into the other is what proves there is one slot, not two.
function f(n: i32): i32 | null {
  if n == 0 { return 5 }
  return null
}
const inf = [f(0), f(1), f(2)]
print(inf.length)
const a = inf[0]
if a != null { print(a + 1) } else { print("NULL") }
const b = inf[1]
if b != null { print(b + 1) } else { print("NULL") }
const ann: (i32 | null)[] = [f(0)]
ann.push(a)
print(ann.length)
const c = ann[1]
if c != null { print(c) } else { print("NULL") }
inf.push(c)
print(inf.length)
