// @run
// @log 3
// @log a
// @log null
// @log 1
// A value that may be absent is `T | null`, the spelling a written `T | void` is pointed to (D12467).
function f(x: i32 | null) { x ?? 0 }
function r(c: boolean): string | null {
  if c { return "a" }
  return null
}
type R = { a: i32 | null }
const v: R = { a: 1 }
print(f(3))
print(r(true))
print(r(false))
print(v.a ?? 0)
