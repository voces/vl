// @run
// @log null
// @log null
// @log null
// @log null
// @log hi
// @log false
// @log true
// @log a
// CONTRACT (must-RUN): `print` of the two NULLABLE NICHE reps renders `null` when the
// value actually is null, and is unchanged when it is not.
//
// Both were ACCEPTED by `vl check` and MIS-LOWERED on the parent commit:
//
//   `string | null` — the niche is a `(ref null $aTypeIdx)` and the string arm streamed
//   it unconditionally, so `array.len` ran on a null ref: `wasm trap: null reference`.
//   `types/print-scalar-boundary-controls.vl` filed this in prose and pinned the
//   value-holding cell around it — "the ladder's nullable-string arm has no null path.
//   That is a MISSING ARM, not a gate question." This is that arm.
//
//   `boolean | null` — the niche is an i32 whose null value is the SENTINEL 2, and the
//   fallback ladder ended in `__print_bool__`, which renders any non-zero as `true`. So a
//   null printed **true**: silently wrong, which is worse than the trap.
//
// Both arms evaluate the argument EXACTLY ONCE and need no scratch frame: the string arm
// recovers the non-null ref with `br_on_null` (there is no nullable string local to stash
// it in — `strScrA` is declared non-null), and the boolean arm uses `br_table` on the
// niche value, which is already the arm index (0 false / 1 true / 2 null). Re-evaluating
// instead would call a `… | null`-returning function twice.
//
// A WIDER GATE WAS BUILT FIRST AND REJECTED BY THIS CORPUS: rejecting every null-bearing
// `print` at `vl check` turned the trap into a clean error but ALSO rejected four working
// programs, including two corpus files — one of them the boundary-controls file above,
// whose whole purpose is to pin what `print` must keep accepting.
function fs(): string | null { return null }
function fb(): boolean | null { return null }
const s = fs()
print(s) // null — was a trap
const b = fb()
print(b) // null — was `true`

// the same two spelled directly, no call in the way
const s2: string | null = null
print(s2)
const b2: boolean | null = null
print(b2)

// …and the value-holding cells, unchanged
const s3: string | null = "hi"
print(s3)
const b3: boolean | null = false
print(b3)
const b4: boolean | null = true
print(b4)

// a NARROWED nullable is not a nullable — the supported spelling still works and still
// takes the plain string path
function fs2(): string | null { return "a" }
const s4 = fs2()
if s4 != null { print(s4) }
