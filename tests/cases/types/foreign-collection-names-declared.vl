// @run
// @log 4
// @log 9
// @log 102
// @hint redundant type annotation: `a` is inferred as `{v: i32}` — remove it to lean on inference
// @hint redundant type annotation: `r` is inferred as `{k: string, v: i32}` — remove it to lean on inference
// A program's own `Array`, `Record` and `len` resolve as declared; the redirects in
// error-foreign-collection-spellings.vl fire only when nothing named them.
type Array<T> = { v: T }
type Record<K, V> = { k: K, v: V }
const a: Array<i32> = { v: 4 }
const r: Record<string, i32> = { k: "x", v: 9 }
print(a.v)
print(r.v)
const len = (xs: i32[]) => xs.length + 100
print(len([1, 2]))
