// @run
// @log x
// @log y
// D1015 — A `for in` OVER A NARROWED UNION ARM AT MODULE SCOPE. `vl check` returned 0 and the
// module did not load.
//
// For `type K = string | K[]` the arm `K[]` is an array of `K`, and `K` is a union, so its
// elements are BOXES. The narrowing casts to a box list; `forInElemKind` answered from the
// values the literal happened to contain and typed the `#l` temp as a STRING list. The cast
// then stored a box list into a string-list local — the disassembly shows
// `ref.cast (ref $5)` into a `(ref $7)`.
//
// FOUR THINGS THAT ARE NOT THE CAUSE, all measured, because each looks like it. The narrowing
// machinery works at module scope: `is string`, `.length` and an INDEXED read-back all run,
// and forcing `setNarrowFromCond` to push changes nothing because the push already happened.
// The timing is fine too: a flag set at push time reads TRUE inside `forInElemKind`. What
// fails is the LOOKUP — `narrowedValueAtomOf` answers "" for a module-level receiver, so the
// rung is keyed off `narrowSlotOf` instead.
//
// The same program inside a function always ran, because its receiver is a local. Both scopes
// are pinned here.
type K = string | K[]

const c: K = ["x"]

function inFn() {
  const d: K = ["y"]
  if d is K[] {
    for e in d {
      if e is string { print(e) }
    }
  }
}

if c is K[] {
  for e in c {
    if e is string { print(e) }
  }
}

inFn()
