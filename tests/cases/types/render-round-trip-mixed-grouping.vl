// @run
// CONTRACT: GROUPING PARENS SURVIVE THE RENDER wherever a suffix or a separator would
// otherwise re-bind. The display renderer wrote none at all, so four shapes that differ only
// by where a grouper sits all collapsed onto one spelling — or onto a spelling that denotes
// something else entirely.
//
// The four legs, with master's render beside each. Every one of them is a DIFFERENT type
// from what master's string says:
//   L1 an array of FUNCTIONS   `((i32) => i32)[]`      master: `(i32) -> i32[]`
//                              — a function RETURNING a list of i32.
//   L2 an array of NULLABLES   `(i32 | null)[]`        master: `i32?[]`
//                              — ambiguous for two reasons at once (`?` is unwritable, and
//                                bare it would read as a nullable LIST).
//   L3 a union with a FUNCTION member  `((i32) => i32) | W`   master: `(i32) -> i32 | W`
//                              — a function returning `i32 | W`; the closure's result
//                                swallows the union's sibling member.
//   L4 a NULLABLE function     `((i32) => i32) | null` master: `(i32) -> i32?`
//                              — a function returning a nullable i32.
//   L5 an array of an ANONYMOUS UNION  `({meow: i32} | {woof: i32})[]`
//                              master: `{meow: i32} | {woof: i32}[]`, which PARSES, to a
//                              union of a struct with a LIST of structs. That leg's headline
//                              is `render-array-group-self-assign.vl`.
//
// ONE HOME FOR L1 AND L5: `arrElemRender`, which both EMIT renderers already shared and this
// one did not — a shortened mirror. L3 and L4 are its union-member and nullable-inner
// siblings, and the TyFunc-result sibling is in `render-round-trip-fn-arrow.vl`.
//
// PIN 1 — the render.
// @hint redundant type annotation: `fs` is inferred as `((i32) => i32)[]`
// @hint redundant type annotation: `ns` is inferred as `(i32 | null)[]`
// @hint redundant type annotation: `uv` is inferred as `((i32) => i32) | W`
// @hint redundant type annotation: `nf` is inferred as `((i32) => i32) | null`
// @hint redundant type annotation: `xs` is inferred as `({meow: i32} | {woof: i32})[]`
//
// PIN 2 — the ROUND TRIP. Each `*r` binding is annotated with the render VERBATIM; `xs`'s
// render is written back and then assigned onward to the DECLARED `Animal[]` spelling, so
// both directions of assignability hold and in a structural language that is type identity.
// @hint redundant type annotation: `fsr` is inferred as `((i32) => i32)[]`
// @hint redundant type annotation: `nsr` is inferred as `(i32 | null)[]`
// @hint redundant type annotation: `uvr` is inferred as `((i32) => i32) | W`
// @hint redundant type annotation: `nfr` is inferred as `((i32) => i32) | null`
// @hint redundant type annotation: `xsr` is inferred as `Animal[]`
// @hint redundant type annotation: `xsb` is inferred as `({meow: i32} | {woof: i32})[]`
// @log 2
// @log 2
// @log 4
// @log 6
// @log 2
// @log 5
// @log 2
// @log 4
// @log 9
// @log 2

type W = { w: i32 }
type Cat = { meow: i32 }
type Dog = { woof: i32 }
type Animal = Cat | Dog

function mkFns(): ((i32) => i32)[] { [(x: i32) => x + 1] }
function mkNul(): (i32 | null)[] { [3, null] }
function mkUni(): ((i32) => i32) | W { { w: 4 } }
function mkNulFn(): ((i32) => i32) | null { (x: i32) => x * 3 }

function main() {
  const fs: ((i32) => i32)[] = mkFns()
  const ns: (i32 | null)[] = mkNul()
  const uv: ((i32) => i32) | W = mkUni()
  const nf: ((i32) => i32) | null = mkNulFn()
  const xs: Animal[] = [{ meow: 1 }, { woof: 2 }]
  print(fs[0](1))
  print(ns.length)
  if uv is W { print(uv.w) } else { print(0) }
  if nf != null { print(nf(2)) } else { print(0) }
  print(xs.length)

  // PIN 2 — the render, verbatim.
  const fsr: ((i32) => i32)[] = fs
  const nsr: (i32 | null)[] = ns
  const uvr: ((i32) => i32) | W = uv
  const nfr: ((i32) => i32) | null = nf
  const xsr: ({meow: i32} | {woof: i32})[] = xs
  const xsb: Animal[] = xsr
  print(fsr[0](4))
  print(nsr.length)
  if uvr is W { print(uvr.w) } else { print(0) }
  if nfr != null { print(nfr(3)) } else { print(0) }
  print(xsb.length)
}
main()
