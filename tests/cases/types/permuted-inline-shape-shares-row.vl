// @run
// @log 7
// @log 7
// @hint redundant type annotation: `q` is inferred as `{b: string, a: i32}` — remove it to lean on inference
// THE HALF OF THE 2026-08 STRUCTURAL-EQUIVALENCE RULING THAT ALREADY WORKS, pinned so the
// other half has something to be measured against.
//
// The ruling is that `{a: i32, b: string}` and `{b: string, a: i32}` are the SAME TYPE —
// field order carries no meaning for an ordinary object type. Written INLINE, the emitter
// agrees completely: the permuted annotation is looked up by its FIELD SET and lands on the
// row `P` already has, so the module carries ONE struct type and the call runs.
//
// The identical permutation written as a NAMED alias does not
// (`soundness/xfail-miscompile-permuted-struct-fields.vl`): `internShapeAs` mints a row
// keyed by the alias name without that lookup, and the two rows collide at the call as
// check-clean invalid wasm.
//
// So this file is the control that says the canonicalisation EXISTS. Whatever fixes the
// named half must not regress this one, and the fix is plausibly "route the named
// declaration through the lookup the inline path already uses" rather than any new sorting.
type P = { a: i32, b: string }

function f(x: P) {
  x.a
}

// Same order — the trivially-equal case.
print(f({ a: 7, b: "s" }))

// PERMUTED, inline. One row, not two.
const q: { b: string, a: i32 } = { b: "s", a: 7 }
print(f(q))
