// @check
// @error unknown type 'nope' within '{bar:nope}'
// @warning Unused variable `x`
// CONTRACT (must-error): an UNRESOLVED type name in an inline-object FIELD is reported,
// not swallowed. Storing the unresolved -1 in `objFieldTypes` left the binding typed
// `{bar: <none>}` — a shape the checker accepted in silence and the emitter happily
// lowered, so a typo'd field type compiled and ran with no diagnostic at all.
const x: {bar: nope} = { bar: 1 }
print(0)
