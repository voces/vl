// @run
// @log 1
// @log 3
// @log 2
// @log 30
// @log 1
// @log 5
// @log 7
// An alias-spelled ARRAY type denotes its element type — in every position.
//
// The parser encodes every non-`{…}`-bodied `type N = …` as a one-member `UnionDecl`, so
// before D-ALIASARR `type L = i32[]` denoted `TyUnion[TyArray]` — and a union is not
// indexable. EVERY use of the alias was a checker error on the parent commit:
// `xs[0]` read ``cannot index non-array i32[]`` and `.length` / `.push` read
// ``field '…' is not on every member of i32[] — narrow with `is` first``, both of which
// read as nonsense precisely because `tyToStr` renders a one-member union as its member.
// The inline spelling `i32[]` ran in all of them.
//
// `singleAliasMemberTyIx` now admits a `TyArray` member whose spine bottoms out at a
// primitive — the condition under which `tyToEmitName` renders the member name-faithfully,
// so the checker's transparency and the emitter's `singleMemberAliasName` cannot disagree
// about the same annotation. An array of a DECLARED struct (`type L = Cat[]`) stays opaque
// and is pinned separately (`array-alias-nominal-element-stays-opaque.vl`): its render
// drops the nominal element name.
type L = i32[]

const g: L = [1, 2, 3]
print(g[0])
print(g.length)

function first(xs: L) {
  return xs[0]
}
print(first([2, 4]))

function make(): L {
  return [30, 40]
}
print(make()[0])

type S = { xs: L }
const s: S = { xs: [1] }
print(s.xs[0])

const grow: L = []
grow.push(5)
print(grow[0])

function firstOrZero(xs: L | null) {
  if xs != null {
    return xs[0]
  }
  return 0
}
print(firstOrZero([7, 8]))
