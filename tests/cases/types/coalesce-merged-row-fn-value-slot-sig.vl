// @run
// @log 9
// @log 4
// @log 3
// @log 7
// CONTRACT (D940): when a `??` merge moves a function's own param/return ROWS, the
// closure-typed SLOT that function is delivered to moves with it.
//
// `src`'s rows follow the merge (`anonLeafParamMoved` / `anonLeafRetMoved`), so its wasm
// functype is `(structref, (ref $merged)) -> (ref null $merged)`. The callback parameter
// keys its `$fnsig` off the ANNOTATION, which still names the pre-merge row — and the
// closure struct carries only a function INDEX, so the `call_indirect` signature-checks the
// moved callee against the un-moved functype. `vl check` rc 0, the module VALIDATES, and the
// program traps at run time with `indirect call type mismatch`. `anonLeafCloSlotFn` marks the
// slot; `anonLeafCloSlotSigKey` hands `paramCloSigKey` the callee's own key.
//
// AND THE ARGUMENT IS THE SECOND HALF. Moving the key alone leaves an object-literal argument
// resolving its OWN row by field set — `struct.new $narrow` into a `(ref $merged)` slot, which
// trades a trap for invalid wasm. The value-call arm seeds `pendingStructIdx` from the resolved
// key exactly as the direct call seeds it from `paramStructIdxOf`.
//
// THREE DELIVERY POSITIONS, and `useOther` is the control that keeps the mark honest: the SAME
// annotation, fed a function no merge moved, must keep the annotation's own key. A rewrite of
// the row wherever it is spelled would move that slot too and break it.
//
// NOTHING HERE IS ANNOTATED ON THE HOF's RETURN. That is deliberate: an annotated `: i32`
// return lets `monoSpecializeConcrete` bake the callback into a DIRECT call, which never
// reaches the `call_indirect` this pins — the hint recommending that annotation's deletion is
// how the defect was found.
function src(p: {r: i32}): {r: i32} | null {
  p
}

function other(p: {r: i32}): {r: i32} | null {
  p
}

// The ARGUMENT position: an object literal built at the call.
function useLit(cb: ({r: i32}) => {r: i32} | null) {
  const v = cb({ r: 9 })
  const w = v ?? { r: 0 }
  w.r
}

// The BINDING-then-argument position: the literal exists before the call.
function useVar(cbv: ({r: i32}) => {r: i32} | null) {
  const a = { r: 4 }
  const v = cbv(a)
  const w = v ?? { r: 0 }
  w.r
}

// The CONTROL: same annotation, a callee the merge never touched.
function useOther(cbo: ({r: i32}) => {r: i32} | null) {
  const v = cbo({ r: 3 })
  const w = v ?? { r: 0 }
  w.r
}

function rd() {
  print(useLit(src))
  print(useVar(src))
  print(useOther(other))
  const g1 = src({ r: 7 }) ?? { r: "s" }
  print(g1.r)
}

rd()
