// @run
// @log 3
// @log 0
// @log 4
// @log 8
// @log 20
// @log 21
// THE TWO THINGS THE GENERIC-APPLICATION TWIN MERGE MUST NOT TOUCH — the control for
// `generics/genapp-instance-twins-declared.vl`, which makes a concrete `Box<i32>` row and a
// declared `{ v: i32 }` row ONE heap type by giving the application row the canonical key it
// had been banking as -1.
//
// A `flat type` IS THE RULING'S OWN EXCEPTION: its field ORDER is its layout
// (`memory/flat-layout-grid.vl`: "order is layout, and nothing is reordered to pack
// better"), so a flat record is never laid out in some other row's order and never shares a
// heap type with a row whose field SEQUENCE differs. `collectS` skips the canonicalising
// reorder on `tdFlat`, and `buildStructTwins`' second gate (`structFieldCodesEq`, which
// compares field codes POSITIONALLY) refuses the merge — the widened key only decides
// whether a pair is COMPARED, never whether it merges.
flat type FRev = { w: i32, v: i32 }
type Box2<T> = { v: T, w: T }

// @hint redundant type annotation: `b` is inferred as `{v: i32, w: i32}`
const b: Box2<i32> = { v: 1, w: 2 }
print(b.v + b.w)

// The flat record keeps ITS declared order: `w` first, `v` second — the opposite of the
// application's, and unmoved by it.
print(FRev.w)    // 0
print(FRev.v)    // 4
print(FRev.size) // 8

// A `new` BRAND is a nominal distinction the CHECKER enforces, not a layout one: the brand
// and its base have always shared one row and one heap type, and `assignable` is what keeps
// a base value out of a brand-typed slot (`types/newtype-base-value-rejected.vl` pins that
// reject). Widening the application key changes neither side — the application simply joins
// the equivalence class the brand and its base were already in.
type NB = new { v: i32 }
type Box<T> = { v: T }

function useNB(x: NB) { x.v }
const n: NB = { v: 20 }
print(useNB(n))

// @hint redundant type annotation: `q` is inferred as `{v: i32}`
const q: Box<i32> = { v: 21 }
print(q.v)
