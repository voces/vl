// @check
// @error print expects one scalar or string value (i32 | i64 | f32 | f64 | boolean | string), got In | null — print the elements or fields individually, e.g. `print(xs[0])`
// A value `if` joining an inferred-null binding with a record is `In | null`, which `print` refuses as
// it refuses any nullable record (D17130).
type In = { v: i32 }
const rec: In = { v: 9 }
const n = null
function c(f: boolean) {
  print(if f { n } else { rec })
  return 0
}
print(c(false))
