// @run
// @log 11
// @log 12
// @log 13
// @log 14
// @log 15
// @log 16
// @warning Unused variable `f`
// @warning Unused parameter `n`
// @warning Unused variable `h`
// THE THREE WARNINGS ARE DECLARED, NOT DELETED. `f` is the function VALUE this file exists to
// admit — deleting it deletes the case; `n` is `srcn`'s first parameter, which is what makes
// the second argument NAMED rather than positional; and `h` is the `null`-argument call site,
// which has to exist for the parameter to have a `null` source at all.
// CONTRACT (must-RUN): D911. D891 moved a returned PARAMETER's slot onto D804's merged row by
// reading the ARGUMENTS at every call site — and could only name an argument that is an object
// literal or `null` written in place. Every other CARRIER refuted the whole callee, and the four
// it refused were filed whole as `distilled/named/d891_bound_*`. This file is those four
// running.
//
// A NAMED ARGUMENT is a source position, not a parameter slot. `orderArgsByParamNames` is the
// one binder the checker and the emitter already share, so the call-site scan asks it rather
// than indexing `callArgs[pos]` and refusing the moment a name appears.
//
// A NESTED ARGUMENT is one more frame of the callee read — the same question
// `anonLeafRetPathOk`'s Call arm asks of a returned expression — which is why `fns`/`depth`
// came back into `anonLeafParamArgsOk`. It needed a second half in the EMITTER: the nested
// callee's return is a plain `{r: i32}`, and the two annotated return-row sites gated their
// merge redirect on `retNulRefFlag` because `S | null` was the only shape a `??` LEFT OPERAND
// can have. One frame in it is not, so both now read the same KIND the result valtype is
// written with — and `fnRetStructIndexSid`, which was ungated all along, stops disagreeing with
// them at the seam.
//
// AN IDENT ARGUMENT is D842's reader asked of an argument: the literals that reach `q` are the
// ones bound to it. STRICT where that one is lenient, for `anonLeafJoinCallee`'s reason — a
// write this cannot name is a value that reaches the moved slot at the row the merge left
// behind.
//
// THE NAME AS A VALUE was refused for a `call_ref`'s sake, and a program with no indirect call
// contains no `call_ref`. The guard is now its own stated reason: a function value refutes only
// where the program can CALL one. `distilled/named/d911_fn_value_called` is the bound, and
// `d915_fn_value_beside_merge` is the PRE-EXISTING defect one shape over — a function value of
// a DIFFERENT same-shaped callee beside a merged family is check-clean invalid wasm on master
// too, which is why the value here is of the family's OWN callee.
//
// THE HAZARD CONTROL FOR THE WIDENED KIND GATE — a plain `{r: i32}` return with no `??`
// anywhere near it, which must keep its narrow row — is
// `distilled/named/d911_plain_struct_ret_unmoved`, graded one program per process.
//
// THIS FILE'S NAME IS LOAD-BEARING AND THAT IS A DEFECT, NOT A CONVENTION. `cases_wasm_test.ts`
// compiles the whole directory through ONE compiler instance in sorted order, and a program
// that declares a union beside a field-permuted struct twin (`canonical-field-order.vl`) leaves
// `uTags` / `uVarTwin` / `uVarSTwin` behind it: their only writers are gated on `if uDeclared`,
// while every reader bounds-checks against the COLUMN's length rather than `uVariants`'. The
// NEXT program whose signature mentions a struct then TRAPS THE COMPILER. That is D864, whose
// own filed witness is a module-scope `??` global — the re-ablation recorded on that row is far
// wider: two programs of 8 and 6 lines with no `??` anywhere, reproducing on master
// `3f2ebc40`'s own seed. It is why these four files are `coalesce-merged-row-*` rather than
// `coalesce-default-row-*`: the latter sorts IMMEDIATELY after `canonical-field-order.vl`,
// where the standing successor (`coalesce-default-row-litunion-annotation.vl`) is immune only
// because it declares a union and so rebuilds the three columns. D901's own two fixtures share
// the `coalesce-merged-row-` prefix for unrelated reasons and sort safely among these.

// ---- an IDENT argument, beside a function VALUE of the same callee ----
function srci(p: { r: i32 }): { r: i32 } | null { p }

function ri() {
  const f = srci
  const q = { r: 11 }
  const g1 = srci(q) ?? { r: "s" }
  print(g1.r)
}
ri() // 11

// ---- a NAMED argument, out of source order ----
function srcn(n: i32, p: { r: i32 }): { r: i32 } | null { p }

function rn() {
  const g1 = srcn(p: { r: 12 }, n: 1) ?? { r: "s" }
  print(g1.r)
}
rn() // 12

// ---- a NESTED argument: the literal is one frame further in, behind a plain struct return ----
function srcc(p: { r: i32 }): { r: i32 } | null { p }

function mk(): { r: i32 } { { r: 13 } }

function rc() {
  const g1 = srcc(mk()) ?? { r: "s" }
  print(g1.r)
}
rc() // 13

// ---- a `null` argument alongside a literal one: `ref.null` is valid at every row ----
function srcz(p: { r: i32 } | null): { r: i32 } | null { p }

function rz() {
  const h = srcz(null)
  const g1 = srcz({ r: 14 }) ?? { r: "s" }
  print(g1.r)
}
rz() // 14

// ---- and the same carriers at MODULE scope, where `fnIx` is -1 ----
function srcm(p: { r: i32 }): { r: i32 } | null { p }

const qm = { r: 15 }
const gm = srcm(qm) ?? { r: "s" }
print(gm.r) // 15

function srcmk(): { r: i32 } { { r: 16 } }

function srcmn(p: { r: i32 }): { r: i32 } | null { p }

const gn = srcmn(srcmk()) ?? { r: "s" }
print(gn.r) // 16
