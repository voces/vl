// @run
// @log 4
// @log true
// @log true
// @log 3
// A null-unit value stored into a `null[]` element (a literal, a read, a call, through a generic and
// std's `insert`) is the list's sentinel, the value read for its effects; into a `null` field, that
// field's bottom ref.
import { insert } from "std:array"

type Box = { a: null, n: i32 }
function nothing(): null { return null }
function cp<T>(xs: T[]) { xs[0] = xs[1] }
function cpNull(xs: null[]) { xs[0] = xs[1] }
const a: null[] = [null, null]
a[0] = null
a[1] = a[0]
a[0] = nothing()
cp(a)
cpNull(a)
a.push(nothing())
insert(a, 1, null)
print(a.length)
print(a[0] == null)
const b: Box = { a: null, n: 3 }
b.a = nothing()
print(b.a == null)
print(b.n)
