// @run
// @log 7
// @log 7
// @log 7
// @log 9
// @log 7
// @log 7
// @log 7
// @log 7
// @hint redundant type annotation: `ann` is inferred as `V`
// CONTRACT (must-RUN): an if-EXPRESSION whose ARMS are struct-typed FIELD READS joins to the
// NON-NULL struct, and each arm recovers the nullable ref its field STORAGE hands back
// (D1577, reported by the glean session as VL-035). Every cell below was check-clean INVALID
// WASM — `expected (ref $type), found (ref null $type)` — at BOTH the annotated and the
// un-annotated spelling, because the annotation agrees about the TYPE and the disagreement
// was about the REP.
//
// A nested-struct field interns as `(field (mut (ref null $V)))` so that a struct is
// defaultable; the TYPE is not nullable, so the join blocktype is `(ref $V)` and the ARM owes
// `ref.as_non_null` — the same recover the return, argument and binding boundaries make.
//
// Each cell DISCRIMINATES on the VALUE: `mk()` yields `{ i: 9 }`, so a cell that took the
// wrong arm prints 9 where the contract says 7.

type V = { i: i32 }
type S = { ret: V, flag: boolean }

function mk(): V { { i: 9 } }

// The row's own witness, un-annotated: both arms are the SAME field read.
function pick(s: S) {
  const out = if s.flag { s.ret } else { s.ret }
  out.i
}

// The annotated face — identical bytes, and the hint above says why.
function pickAnn(s: S) {
  const ann: V = if s.flag { s.ret } else { s.ret }
  ann.i
}

// ONE field-read arm is enough: the other may be a CALL, in either order…
function mixedThen(s: S) {
  const out = if s.flag { s.ret } else { mk() }
  out.i
}
function mixedElse(s: S) {
  const out = if s.flag { mk() } else { s.ret }
  out.i
}

// …or an object LITERAL.
function mixedLit(s: S) {
  const out = if s.flag { s.ret } else { { i: 9 } }
  out.i
}

// The if-expression delivered straight into an ARGUMENT, with no binding to pin it.
function take(v: V) { print(v.i) }
function bareArgument(s: S) {
  take(if s.flag { s.ret } else { s.ret })
  s.ret.i
}

// An `else if` CHAIN: every rung writes its own blocktype, so every rung's arms recover.
function chain(s: S, other: boolean) {
  const out = if s.flag { s.ret } else if other { s.ret } else { mk() }
  out.i
}

function mkS(): S { { ret: { i: 7 }, flag: true } }
const src = mkS()
print(pick(src))
print(pickAnn(src))
print(mixedThen(src))
print(mixedElse(src))
print(mixedLit(src))
print(bareArgument(src))
print(chain(src, true))
