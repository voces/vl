// @log s
// Records that share a field-name set and differ in a field's type join as ONE record whose
// fields are the per-field joins (`{f: i32 | string}`), the type the annotated spelling names,
// and each literal arm is built at that row in every position the join is delivered to (D2731).
// Before, the join was a union no rep can tell apart, and the arms built their own rows.
function show(v: i32 | string) {
  if v is string { print(v) } else { print(v + 1) }
}
function bind(sel: i32) {
  const sx = if sel == 0 { { f: 1 } } else { { f: "s" } }
  show(sx.f)
}
function mutable(sel: i32) {
  let sx = if sel == 0 { { f: 1 } } else { { f: "s" } }
  show(sx.f)
  if sel == 1 {
    sx = { f: "t" }
    print(sx.f)
  }
}
function elseIf(sel: i32) {
  const sx = if sel == 0 { { f: 1 } } else if sel == 1 { { f: "s" } } else { { f: 3 } }
  show(sx.f)
}
function arm(sel: i32) {
  const sx = match sel {
    0 => {
      { f: 1 }
    }
    _ => {
      { f: "s" }
    }
  }
  show(sx.f)
}
function list() {
  const xs = [{ f: 1 }, { f: "s" }]
  for x in xs { show(x.f) }
}
function mk(sel: i32) {
  if sel == 0 { { f: 1 } } else { { f: "s" } }
}
function mk2(sel: i32) {
  if sel == 0 { return { f: 1 } }
  return { f: "s" }
}
function ret(sel: i32) { show(mk(sel).f) }
function ret2(sel: i32) { show(mk2(sel).f) }
function id<T>(x: T): T { x }
function generic(sel: i32) {
  const sx = id(if sel == 0 { { f: 1 } } else { { f: "s" } })
  show(sx.f)
}
function capture(sel: i32) {
  const sx = if sel == 0 { { f: 1 } } else { { f: "s" } }
  const k = () => show(sx.f)
  k()
}
function field(sel: i32) {
  const w = { h: if sel == 0 { { f: 1 } } else { { f: "s" } } }
  show(w.h.f)
}
function direct(sel: i32) {
  show((if sel == 0 { { f: 1 } } else { { f: "s" } }).f)
}
function nested(sel: i32) {
  const sx = if sel == 0 { { o: { f: 1 } } } else { { o: { f: "s" } } }
  show(sx.o.f)
}
function widen(sel: i32) {
  const sx = if sel == 0 { { f: 1 } } else { { f: 2.5 } }
  print(sx.f)
}
function boolField(sel: i32) {
  const sx = if sel == 0 { { f: 1, g: 2 } } else { { f: 3, g: true } }
  print(sx.g)
}
function twoFields(sel: i32) {
  const sx = if sel == 0 { { a: 1, b: "x" } } else { { a: "s", b: 2 } }
  print(sx.a)
  print(sx.b)
}
function vars(sel: i32) {
  const a = { f: 1 }
  const b = { f: "s" }
  const sx = if sel == 0 { a } else { b }
  show(sx.f)
}
function nullable(sel: i32) {
  const sx = if sel == 0 { { f: 1 } } else if sel == 1 { { f: "s" } } else { null }
  if sx != null { show(sx.f) } else { print("null") }
}
const gsel = 1
const gx = if gsel == 0 { { f: 1 } } else { { f: "s" } }
bind(0)
bind(1)
mutable(0)
mutable(1)
elseIf(0)
elseIf(1)
elseIf(2)
arm(0)
arm(1)
list()
ret(0)
ret(1)
ret2(0)
ret2(1)
generic(0)
generic(1)
capture(0)
capture(1)
field(0)
field(1)
direct(0)
direct(1)
nested(0)
nested(1)
widen(0)
widen(1)
boolField(0)
boolField(1)
twoFields(0)
twoFields(1)
vars(0)
vars(1)
nullable(0)
nullable(2)
show(gx.f)
