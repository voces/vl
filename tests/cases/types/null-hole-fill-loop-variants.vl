// @run
// @warning Unreachable code: this can never execute
// @log nv vv
// @log n v
// @log nn vv
// @log nv vv
// @log nv vv
// @log nv
// @log nn
// An inferred-null binding `let m = null` written in a loop is read at the loop's top as `null`
// only on a pass no write has reached (D17206): a write of the same type, a write then `break`, a
// write a `break` never reaches, a nested loop, a write in an inner `if`, an alias, and `null`.
type In = { v: i32 }
type Out = { w: string, k: i32 }
const rec: In = { v: 9 }
function sameType(f: boolean) {
  let m = null
  let out = ""
  let i = 0
  while i < 2 {
    const j = if f { m } else { rec }
    out = out + (if j == null { "n" } else { "v" })
    m = { v: 4 }
    i = i + 1
  }
  return out
}
function writeThenBreak(f: boolean) {
  let m = null
  let out = ""
  while true {
    const j: In | Out | null = if f { m } else { rec }
    out = out + (if j == null { "n" } else { "v" })
    m = { w: "z", k: 4 }
    break
  }
  return out
}
function breakBeforeWrite(f: boolean) {
  let m = null
  let out = ""
  let i = 0
  while i < 2 {
    const j: In | Out | null = if f { m } else { rec }
    out = out + (if j == null { "n" } else { "v" })
    i = i + 1
    if i == 1 { continue }
    break
    m = { w: "z", k: 4 }
  }
  return out
}
function nested(f: boolean) {
  let m = null
  let out = ""
  let i = 0
  while i < 2 {
    let k = 0
    while k < 1 {
      const j: In | Out | null = if f { m } else { rec }
      out = out + (if j == null { "n" } else { "v" })
      k = k + 1
    }
    m = { w: "z", k: 4 }
    i = i + 1
  }
  return out
}
function innerIf(f: boolean) {
  let m = null
  let out = ""
  let i = 0
  while i < 2 {
    const j: In | Out | null = if f { m } else { rec }
    out = out + (if j == null { "n" } else { "v" })
    if i == 0 { m = { w: "z", k: 4 } }
    i = i + 1
  }
  return out
}
function alias() {
  let m = null
  let out = ""
  let i = 0
  while i < 2 {
    const x = m
    out = out + (if x == null { "n" } else { "v" })
    m = { v: 4 }
    i = i + 1
  }
  return out
}
function backToNull() {
  let m = null
  let out = ""
  let i = 0
  while i < 2 {
    const j: In | null = m
    out = out + (if j == null { "n" } else { "v" })
    m = null
    i = i + 1
  }
  return out
}
print("\{sameType(true)} \{sameType(false)}")
print("\{writeThenBreak(true)} \{writeThenBreak(false)}")
print("\{breakBeforeWrite(true)} \{breakBeforeWrite(false)}")
print("\{nested(true)} \{nested(false)}")
print("\{innerIf(true)} \{innerIf(false)}")
print(alias())
print(backToNull())
