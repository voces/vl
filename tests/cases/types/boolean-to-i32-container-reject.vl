// @check
// @error cannot assign boolean[] to '_a' of type i32[]
// @error cannot assign boolean[] to '_lits' of type i32[]
// @error cannot assign boolean to '_n' of type i32 | null
// @error cannot assign boolean to '_u' of type i32 | string
// The A7 boolean→i32 coercion's BOUNDARY — the positions it deliberately does
// NOT reach. It lives at the expression seam (`assignableExpr`), so it adapts a
// boolean-typed VALUE meeting an `i32` slot, and a LITERAL container recursing
// element-wise / field-wise into one. It is not a type-level rule: `assignable`
// itself never relates `boolean` to `i32`, so nothing that has to go through the
// TYPE gets the coercion.
//
// The accepted side is `boolean-to-i32.vl` (the scalar boundaries) and
// `boolean-to-i32-container-positions.vl` (the container positions). Bindings are
// `_`-prefixed so the unused-variable lint stays out of the way of the pins.

// A `boolean[]` VALUE into `i32[]`. The element-wise adaptation is a property of
// an array LITERAL, not of the array TYPE — a value already carries its element
// type, and `assignable` compares the two element types with no coercion in reach.
const flags = [true, false]
const _a: i32[] = flags

// A bare `true`/`false` LITERAL stays excluded INSIDE the container too: the
// element-wise recursion re-applies the same per-expression rule, and that is the
// rule which excludes a literal.
const _lits: i32[] = [true]

// A NULLABLE or UNION target is not an `i32` slot: the coercion asks for the
// destination to BE the `i32` prim, and neither of these is.
const t = true
const _n: i32 | null = t
const _u: i32 | string = t
