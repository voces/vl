// @run
// @log 2
// @log 3
// @hint redundant type annotation: `f` is inferred as `i32`
// @hint redundant type annotation: `g` is inferred as `i32`
// @hint redundant type annotation: `x` is inferred as `{a: i32, b: i32}`
// @hint redundant type annotation: `y` is inferred as `{a: i32, b: i32}`
// A VALUE OF AN INTERSECTION ALIAS HANDED TO A STRUCTURALLY-SPELLED STRUCT PARAM
// (silent-class-inventory D443). Was a loud emit reject, `emitProgram: ref valtype with no
// interned shape`. The REVERSE direction (`y`, spelled structurally, into a `v: AB` param)
// always ran, which is the asymmetry that named the root: the alias's row and the inline
// shape's row are one layout the emitter kept as two heap types, so only one direction had
// a shape to intern.
//
// Third face of one root, closed by the same landing as D402 / D441 / D442: `type X = A & B`
// is a one-variant `UnionDecl`, and the D0 recorder banked the union's arena type for the
// row, which every "is this an object" gate then declines. Both directions are pinned here
// because a fix that only opens one is a fix that has not found the root.
type AB = {a: i32} & {b: i32}
function f(v: {a: i32, b: i32}): i32 { return v.b }
function g(v: AB): i32 { return v.a }
const x: AB = { a: 1, b: 2 }
const y: {a: i32, b: i32} = { a: 3, b: 4 }
print(f(x))
print(g(y))
