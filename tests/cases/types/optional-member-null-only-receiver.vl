// @check
// @info `a` is never reassigned; use `const` instead of `let`
// @info `?.f` here is always null: its receiver is only ever `null`
// @info `?.g` here is always null: its receiver is only ever `null`
// `?.` over a receiver whose type is only `null` reads `null`, in every spelling (owner ruling
// 2026-11-16), so the check accepts it. Written so in the program's own text it is almost
// certainly a slip, and a hint says so; an instance a generic body is checked at gets none.
let a = null
const x = a?.f
const y = null?.g
print(x == y)
