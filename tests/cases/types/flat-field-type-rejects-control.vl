// @run
// @log 1
// THE INVERTED CONTROL for `flat-field-type-rejects.vl`: the same record, with
// `flat` deleted. It checks clean and runs, so every reject next door is
// attributable to `flat` and to nothing else about the declaration.
//
// This control earned its keep. A `Map` field was in the reject grid during
// development and the control caught it: `flat type F = { a: Map }` rejects with
// "unknown type 'Map'", and so does the non-flat twin — `Map` is not spellable as
// a field type in VL at all. That reject was PRE-EXISTING and had nothing to do
// with this feature, and only the control could say so.
type Plain = { p: i32 }
type Bad = {
  a: string,
  b: i32[],
  c: boolean,
  d: i32 | null,
  e: (i32) => i32,
  f: Plain,
  g: { q: i32 },
}
const ok: Bad = {
  a: "x",
  b: [1],
  c: true,
  d: null,
  e: (n: i32) => n,
  f: { p: 1 },
  g: { q: 1 },
}
print(ok.f.p)
