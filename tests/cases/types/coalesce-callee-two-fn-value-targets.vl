// @run
// @log 7
// @hint Intentionally-unused variable `_h`
// CONTRACT (D948): a binding that may hold TWO known functions is still an ATTRIBUTABLE call
// site, and a merge that moves one of their return rows moves the whole set.
//
// `anonLeafFnValueTarget` answers only for a binding written with ONE function name, because
// its callers wanted A name. The question they actually need is weaker — "is the set of
// functions this call can reach fully KNOWN" — and a set of two known functions is as
// attributable as a set of one. `anonLeafFnValueNames` asks that; `anonLeafCallMayTarget` is
// the membership form of the `== fname` test every argument reader in the file was spelling.
//
// AND THE RETURN ROWS ARE COUPLED, which is the half that is not a reader. One binding holds
// one wasm signature, so moving `src`'s row while `other`'s stays narrow leaves `f` unable to
// hold both — invalid wasm, and exactly what this cell was. `anonLeafCoMoveFnRets` moves the
// siblings, bounded by `anonLeafMarkRetMoved`'s own already-marked test rather than by a
// separate visited set: the second visit finds the mark and stops.
//
// `other` IS LOAD-BEARING. Delete the reassignment and the binding has one target, which is
// D925's case and was already working — the pair is what makes the set bigger than one.
function src(p: {r: i32}): {r: i32} | null {
  p
}

function other(p: {r: i32}): {r: i32} | null {
  p
}

function rd(n: i32) {
  let f = src
  if n > 0 { f = other }
  const _h = f({ r: 9 })
  const g1 = src({ r: 7 }) ?? { r: "s" }
  print(g1.r)
}

rd(0)
