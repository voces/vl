// @run
// @log hi
// @log bob
// @log hi
// @log bob
// @log hi
// @log bob
// @log NONE
// @log SOME
// @log NONE
// @log SOME
// @log NONE
// @log SOME
// The `is null` guard is a property of the receiver's REP, not of where the receiver is
// bound, so the SCOPE axis is pinned beside the rep axis: a param, a local, a module-level
// binding and a struct FIELD all reach the same niche null test (`emitNulIsNullTest`).
// The remaining ref niches are here too — a nullable ref-ARRAY (`i32[][] | null`), a
// nullable distinct-backing scalar list (`f64[] | null`) and a nullable CLOSURE — each a
// `(ref null …)` whose only runtime distinction is null vs present.

// ── scope: a LOCAL ───────────────────────────────────────────────────────────
function localRecv(flag: boolean) {
  let v: string | null = null
  if flag { v = "bob" }
  if v is null { print("hi") } else { print(v) }
}
localRecv(false)
localRecv(true)

// ── scope: a struct FIELD ────────────────────────────────────────────────────
type B = {n: string | null}
const bNull: B = {n: null}
const bSet: B = {n: "bob"}

function fieldRecv(b: B) {
  if b.n is null { print("hi") } else { print(b.n) }
}
fieldRecv(bNull)
fieldRecv(bSet)

// ── scope: a MODULE-level binding ────────────────────────────────────────────
const modNull: string | null = null
const modSet: string | null = "bob"
if modNull is null { print("hi") } else { print(modNull) }
if modSet is null { print("hi") } else { print(modSet) }

// ── rep: a nullable REF ARRAY (`i32[][] | null`) ─────────────────────────────
const nested: i32[][] = [[1], [2, 3]]

function refArrRecv(xs: i32[][] | null) {
  if xs is null { print("NONE") } else { print("SOME") }
}
refArrRecv(null)
refArrRecv(nested)

// ── rep: a nullable DISTINCT-backing scalar list (`f64[] | null`) ────────────
const floats: f64[] = [1.5, 2.5]

function f64ListRecv(xs: f64[] | null) {
  if xs is null { print("NONE") } else { print("SOME") }
}
f64ListRecv(null)
f64ListRecv(floats)

// ── rep: a nullable CLOSURE ──────────────────────────────────────────────────
function inc0(x: i32) { x + 1 }

function cloRecv(f: ((i32) => i32) | null) {
  if f is null { print("NONE") } else { print("SOME") }
}
cloRecv(null)
cloRecv(inc0)
