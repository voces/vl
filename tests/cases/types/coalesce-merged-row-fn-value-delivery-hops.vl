// @run
// @log 1
// @log 2
// @log 3
// @log 4
// @log 5
// @log 6
// @log 7
// @hint redundant type annotation
// @hint redundant type annotation
// @info `ga` is never reassigned
// CONTRACT (D1090): a `??` merge that moves a function's rows must still recognise that
// function when it is delivered through a HOP — a local binding, a module global, an
// assignment between two module globals, or a call that hands it back.
//
// THE ATTRIBUTION DECIDES WHETHER THE MERGE HAPPENS AT ALL, not just how it lowers.
// `anonLeafAnyIndirectCall` declines the whole family the moment a call site names a function
// it cannot resolve, and the decline is NOT neutral: with the merge refused, `?? { r: "s" }`
// still resolves the `{r: i32}` row by field-name set and stores a string ref into an i32
// slot. `vl check` rc 0, invalid wasm, one message for every position below.
//
// `anonLeafArgFnName` is the one home for "which function does this argument name": a
// declaration, a binding written with one (`anonLeafFnValueTarget`, which now chases a write
// that names another binding), or a CALL of a function that hands one back.
//
// EVERY PRINT DISCRIMINATES. Each line prints the `.r` of a value that went THROUGH the
// delivery, so a lowering that silently used the pre-merge row cannot print the right number;
// the last line is the merge's own wide value, whose field is a union box holding a STRING.
//
// `useOther` IS THE CONTROL AND IT IS DELIVERED THROUGH A HOP TOO — same annotation shape, a
// callee no merge moved, reached through its own binding. A rewrite of the row wherever the
// annotation spells it would move that slot as well.
function src(p: {r: i32}): {r: i32} | null {
  p
}

function other(p: {r: i32}): {r: i32} | null {
  p
}

function pick(): ({r: i32}) => {r: i32} | null {
  src
}

function useLit(cb: ({r: i32}) => {r: i32} | null) {
  const v = cb({ r: 1 })
  const w = v ?? { r: 0 }
  w.r
}

// The CONTROL's own slot: a distinct parameter name, fed only by a function the merge never
// touched, so the mark has to be per-slot rather than per-annotation.
function useOther(cbo: ({r: i32}) => {r: i32} | null) {
  const v = cbo({ r: 3 })
  const w = v ?? { r: 0 }
  w.r
}

let ga: ({r: i32}) => {r: i32} | null = src
let gb: ({r: i32}) => {r: i32} | null = src
const gh = src

function rd() {
  // 1 — the LOCAL BINDING hop, into a closure-typed parameter.
  const h = src
  print(useLit(h))
  // 2 — the same binding CALLED DIRECTLY, which is the other half of the same hop.
  const h2 = src
  const r2 = h2({ r: 2 }) ?? { r: 0 }
  print(r2.r)
  // 3 — the CONTROL, also through a binding.
  const ho = other
  print(useOther(ho))
  // 4 — the RETURN hop: the argument is a call that hands the function back.
  print(useLit4(pick()))
  // 5 — a MODULE GLOBAL holding the function value.
  const r5 = gh({ r: 5 }) ?? { r: 0 }
  print(r5.r)
  // 6 — ASSIGNMENT between two module globals (`emitAssign`'s `global.set` arm), so `gb`'s
  // set is reached by two hops and the ANNOTATION on it spells the pre-merge row.
  gb = ga
  const r6 = gb({ r: 6 }) ?? { r: 0 }
  print(r6.r)
  // …and the merge itself LAST, so every delivery above is read before the family is known.
  const g1 = src({ r: 7 }) ?? { r: "s" }
  print(g1.r)
}

function useLit4(cb4: ({r: i32}) => {r: i32} | null) {
  const v = cb4({ r: 4 })
  const w = v ?? { r: 0 }
  w.r
}

rd()
