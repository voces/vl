// @run
// @log 1
// @log 2
// @log 3
// @log 4
// @log 5
// @log 6
// @log 7
// CONTRACT (D1090): a `??` merge that moves a function's rows must still recognise that
// function when it is delivered through a HOP — a local binding, a module global, an
// assignment between two globals, or a call that hands it back.
//
// The attribution is what decides whether the merge happens AT ALL, not just how it lowers:
// `anonLeafAnyIndirectCall` vetoes the whole family the moment a call site names a function
// it cannot resolve, and the veto's fall-through is NOT neutral — with the merge declined,
// `?? { r: "s" }` still resolves the `{r: i32}` row by field-name set and stores a string ref
// into an i32 slot. `vl check` rc 0, invalid wasm, one message for every position here.
//
// `anonLeafArgFnName` is the one home for "which function does this argument name": a
// declaration, a binding written with one (`anonLeafFnValueTarget`, now chasing a write that
// names another binding), or a CALL of a function that hands one back.
//
// `useOther` IS THE CONTROL AND IT IS DELIVERED THROUGH A HOP TOO — same annotation, a callee
// no merge moved, reached through its own binding. A rewrite of the row wherever the
// annotation spells it would move that slot as well and print `0` instead of `3`.
function src(p: {r: i32}): {r: i32} | null {
  p
}

function other(p: {r: i32}): {r: i32} | null {
  p
}

function pick(): ({r: i32}) => {r: i32} | null {
  src
}

function useLit(cb: ({r: i32}) => {r: i32} | null) {
  const v = cb({ r: 1 })
  const w = v ?? { r: 0 }
  w.r
}

// The CONTROL's own slot: a distinct parameter name, so the mark is per-slot rather than
// per-annotation, fed only by a function the merge never touched.
function useOther(cbo: ({r: i32}) => {r: i32} | null) {
  const v = cbo({ r: 3 })
  const w = v ?? { r: 0 }
  w.r
}

let ga: ({r: i32}) => {r: i32} | null = src
let gb: ({r: i32}) => {r: i32} | null = src
const gh = src

function rd() {
  // 1 — the LOCAL BINDING hop.
  const h = src
  print(useLit(h))
  // 2 — the same hop with the merge's own literal already built once.
  const h2 = src
  const r2 = h2({ r: 2 }) ?? { r: 0 }
  print(r2.r)
  // 3 — the CONTROL, also through a binding.
  const ho = other
  print(useOther(ho))
  // 4 — the RETURN hop: the argument is a call that hands the function back.
  const r4 = pick()({ r: 4 }) ?? { r: 0 }
  print(r4.r)
  // 5 — a MODULE GLOBAL holding the function value.
  const r5 = gh({ r: 5 }) ?? { r: 0 }
  print(r5.r)
  // 6 — ASSIGNMENT between two module globals, so `gb`'s set is reached by two hops.
  gb = ga
  const r6 = gb({ r: 6 }) ?? { r: 0 }
  print(r6.r)
  // …and the merge itself, LAST, so every delivery above is read before the family is known.
  const g1 = src({ r: 7 }) ?? { r: "s" }
  print(g1.r)
}

rd()
