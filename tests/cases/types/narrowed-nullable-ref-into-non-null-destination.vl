// @run
// @log 2
// @log b
// @log 2.5
// @log 2
// @log false
// @log 2
// @log 2
// @log 2
// @log b
// @log 2
// @log y
// @log 12
// @log 2
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @hint redundant type annotation
// CONTRACT (D1115): a NARROWED nullable ref delivered into a destination whose valtype is a
// NON-NULL ref owes a `ref.as_non_null`, at EVERY rep and at every delivery this file names.
//
// A nullable niche READ deliberately keeps its raw `(ref null $H)` — narrowing is type-level,
// and the rule is "the USE site recovers". D131 built the recover at the RETURN boundary and
// stated the criterion exactly ("the result valtype is a non-null ref" AND "the value
// classifies as the nullable niche"); the two hand-written kind lists implementing it named
// two reps of thirteen, so a narrowed nullable LIST, MAP, ref-list, scalar-list or closure
// parameter returned into its own non-null result pushed `(ref null $H)` under a `(ref $H)`
// result — `vl check` rc 0, `type mismatch: expected (ref $type), found (ref null $type)`.
//
// `vkNulNicheOf` is the `nul<K>`-over-`K` table stated ONCE, so the destination half and the
// value half cannot drift apart again; `nulNicheRecoverOwed` is the single question each
// delivery asks.
//
// THE VARIANT SPELLING WAS AMONG THEM despite `variant` being one of the two kinds D131 named:
// a `: Circle` result routes through `emitVariantCoerce`, not through the return guard at all,
// and that pass-through owed the same recover.
//
// EVERY CELL PRINTS THE NARROWED VALUE'S OWN PAYLOAD, never the fallback's, so a delivery that
// silently took the `else` arm cannot pass.
type C = { v: i32 }
type Ca = { r: i32 }
type Sq = { s: i32 }
type Sh = Ca | Sq

function mkStrMap(s: string): {[string]: string} {
  const m: {[string]: string} = Map()
  m["k"] = s
  m
}

function mkm(n: i32): {[string]: i32} {
  const m: {[string]: i32} = Map()
  m["k"] = n
  m
}

// ── the RETURN boundary, one function per rep ────────────────────────────────
function retI32List(x: i32[], y: i32[] | null): i32[] { if y is i32[] { return y } x }
function retStrList(x: string[], y: string[] | null): string[] { if y != null { return y } x }
function retF64List(x: f64[], y: f64[] | null): f64[] { if y != null { return y } x }
function retI64List(x: i64[], y: i64[] | null): i64[] { if y != null { return y } x }
function retBoolList(x: boolean[], y: boolean[] | null): boolean[] {
  if y != null { return y }
  x
}
function retRefList(x: C[], y: C[] | null): C[] { if y != null { return y } x }
function retNested(x: i32[][], y: i32[][] | null): i32[][] { if y != null { return y } x }
function retMap(x: {[string]: i32}, y: {[string]: i32} | null): {[string]: i32} {
  if y != null { return y }
  x
}
// the tail-`if` delivery, not the `return` one
function tailStrMap(
  x: {[string]: string},
  y: {[string]: string} | null,
): {[string]: string} {
  if y != null { y } else { x }
}
function retStruct(x: C, y: C | null): C { if y != null { return y } x }
function retString(x: string, y: string | null): string { if y != null { return y } x }
function retClosure(
  x: ((i32) => i32),
  y: ((i32) => i32) | null,
): ((i32) => i32) {
  if y != null { return y }
  x
}
// the INFERRED result — `fRetKind` carries no closure producer, so the result kind is read
// off `fnReturnsClosure` exactly as `emitOneFuncType` reads it
function retCloInferred(x: ((i32) => i32), y: ((i32) => i32) | null) {
  if y != null { return y }
  x
}
// a nullable VARIANT: the `: Ca` result routes through `emitVariantCoerce`
function retVariant(x: Ca, y: Ca | null): Ca { if y != null { return y } x }

const nested2: i32[][] = [[2]]
const nested1: i32[][] = [[1]]
const one: i64 = 1
const two: i64 = 2
const inc: (i32) => i32 = (q: i32) => q + 1
const add2: (i32) => i32 = (q: i32) => q + 2

print(retI32List([1], [2])[0])
print(retStrList(["a"], ["b"])[0])
print(retF64List([1.5], [2.5])[0])
print(retI64List([one], [two])[0])
print(retBoolList([true], [false])[0])
print(retRefList([{v: 1}], [{v: 2}])[0].v)
print(retNested(nested1, nested2)[0][0])
print(retMap(mkm(1), mkm(2))["k"])
print(tailStrMap(mkStrMap("a"), mkStrMap("b"))["k"])
print(retStruct({v: 1}, {v: 2}).v)
print(retString("x", "y"))
print(retClosure(inc, add2)(10))
print(retCloInferred(inc, add2)(0))
print(retVariant({r: 1}, {r: 7}).r)

// ── the other deliveries: BINDING, local ASSIGNMENT, global ASSIGNMENT ───────
function viaBinding(y: i32[] | null, d: i32[]): i32[] {
  if y != null {
    const z: i32[] = y
    return z
  }
  d
}
function viaLocalAssign(y: i32[] | null, d: i32[]): i32[] {
  let z: i32[] = d
  if y != null { z = y }
  z
}
let gl: i32[] = [0]
function viaGlobalAssign(y: i32[] | null): i32 {
  if y != null { gl = y }
  gl[0]
}
function viaBindingMap(y: {[string]: i32} | null, d: {[string]: i32}): {[string]: i32} {
  if y != null {
    const z: {[string]: i32} = y
    return z
  }
  d
}
function viaLocalAssignVariant(y: Ca | null, d: Ca): Ca {
  let z: Ca = d
  if y != null { z = y }
  z
}

print(viaBinding([7], [0])[0])
print(viaLocalAssign([7], [0])[0])
print(viaGlobalAssign([7]))
print(viaBindingMap(mkm(7), mkm(0))["k"])
print(viaLocalAssignVariant({r: 7}, {r: 0}).r)
print(retI32List([0], [7])[0])
