// @emit-error emitProgram: this function value returns records that join into one whose fields hold records
// A function value whose un-annotated result joins records with a record-valued field, handed to
// a generic, would be read at another row of those field names than the join's (D2765). The
// annotated return runs, and so does the same join called where it is bound.
function ap<T>(g: () => T): T { g() }
function go(sel: i32) {
  const r = ap(() => if sel == 0 { { o: { f: 1 } } } else { { o: { f: "s" } } })
  print(r.o.f)
}
go(0)
