// @run
// @log 107
// @log s
// @log 7
// @log 204
// @log 5
// @warning Unused function `sink` (prefix with `_` to suppress, remove it, or `export` it)
// @warning Unused variable `g1` (prefix with `_` to suppress, or remove it)
// @warning Unused variable `g1` (prefix with `_` to suppress, or remove it)
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// CONTRACT (must-RUN): D804's merged row reaches a `??` whose left operand is a plain
// BINDING, and the binding's own CELL is what takes the merged row.
//
// D841 closed the same defect one DELIVERY FORM over — a map's value slot — and filed this
// one as D842. The two halves here are read in the other order:
//   · the READER (`anonLeafJoinSources`' bare-identifier arm) marks the literals that reach
//     the binding — its declaration's initializer and any later `a = { … }` — as members of
//     the `??`'s join, so D804's leaf merge has two disagreeing atoms to mint a row from.
//   · the CELL (`anonLeafSupersedeOf` at `nulRefStructIdxOfLet` / `globalCellStructIdx` /
//     `globalStructIndexSid`) points the `{r: i32} | null` binding at the row that merge
//     minted. Without it the row exists and nothing names it — which is exactly why D841
//     built the reader, measured it to close nothing, and removed it.
// Neither half moves a cell alone; the ablation grades them separately in D842's row.
//
// THE COMPETING `type R` IS SCENERY HERE, AND THAT IS THE DIFFERENCE FROM D833. There the
// unused declaration was the whole mechanism. Here the BINDING'S OWN ANNOTATION mints the
// narrow `{r: i32}` row in `collectAnnShapes` — before `collectAnonShapes` ever runs — so
// the defect reproduces with no `type` in the file at all. Ablated: nothing / an unused
// `type` alias / an inline parameter annotation all grade identically at every default
// value, at function scope and at module scope alike.
//
// THE REDIRECT IS PER-BINDING, NOT PER-ROW, and the blocks below are what say so: a
// `{r: i32}` PARAMETER and a declared `R` destination both keep the narrow layout beside the
// merged binding. A row-wide redirect would take each of them from `runs` to invalid wasm.
// The nested-struct-field, list-element and map-value destinations are pinned the same way,
// in `distilled/named/d842_hazard_*`.

// ---- the merged binding reads its STORED i32 back through the box ----
function rd() {
  const a: { r: i32 } | null = { r: 7 }
  const g1 = a ?? { r: "s" }
  const v = g1.r
  if v is i32 { print(100 + v) } else { print(0) }
}
rd() // 107

// ---- and the DEFAULT's own atom, when the left operand is null ----
function rs() {
  let a: { r: i32 } | null = { r: 7 }
  a = null
  const g1 = a ?? { r: "s" }
  print(g1.r)
}
rs() // s

// ---- the `null` corner: master's loud `bare null needs a struct-typed context` ----
type R = { r: i32 }

function rn() {
  const a: { r: i32 } | null = { r: 7 }
  const g1 = a ?? { r: null }
  if g1.r != null { print(7) } else { print(0) }
}
rn() // 7

// A NESTED-STRUCT field of the narrow shape (`type Box = { inner: { r: i32 } }`) also keeps
// its own layout beside a merged family — `distilled/named/d842_hazard_field_dest.vl` pins
// that — but it is NOT in this file, because a nested row claiming `{r: i32}` beside TWO
// `??` families that land on DIFFERENT merged sets (`i32|string` here and `i32|null`) is a
// loud reject on master and here alike. That is D863, found by this fixture.

// ---- a `{r: i32}` PARAMETER keeps the narrow layout beside the merged family ----
function sink(_x: { r: i32 }) { print(1) }

function rp(x: { r: i32 }) { print(200 + x.r) }

function rq() {
  const a: { r: i32 } | null = { r: 7 }
  const g1 = a ?? { r: "s" }
  rp({ r: 4 })
}
rq() // 204

// ---- and a DECLARED destination `R`, used narrowly in the same program ----
function useR(x: R) { print(x.r) }

function ru() {
  const a: { r: i32 } | null = { r: 7 }
  const g1 = a ?? { r: null }
  useR({ r: 5 })
}
ru() // 5

// MODULE SCOPE takes the same redirect, through `globalCellStructIdx` and
// `globalStructIndexSid` — twelve cells in `distilled/named/d842_module_*`, and NOT a block
// here. The reason is D864: a module-scope `??` over a nullable-struct global reaches an
// out-of-bounds read in `emitGlobalSection` when the compiler INSTANCE has already compiled
// a program with a variant/struct layout twin, which is exactly what this suite's shared
// wasm instance does. It traps identically on master; the corpus cells grade in a fresh
// process each, so they carry the coverage without carrying the trap.
