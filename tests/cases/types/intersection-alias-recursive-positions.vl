// @run
// @log 1
// @log 5
// @log 10
// @log 7
// @log 3
// @log 4
// @log 8
// A named intersection over a recursive record (D14162) has no row of its own: its type is a
// one-member union over `Node`'s record, and every position asked by type reads `Node`'s row.
type Node = { v: i32, next: Node | null }
type M = Node & { v: i32 }
const tail: Node = { v: 5, next: null }
const n: M = { v: 1, next: tail }
print(n.v)
const nx = n.next
if nx != null { print(nx.v) }
function f(m: M) { m.v * 10 }
print(f(n))
function mk(k: i32): M { return { v: k, next: null } }
print(mk(7).v)
const xs: M[] = [n, mk(3)]
print(xs[1].v)
let s = 0
for x in xs { s = s + x.v }
print(s)
const mp: {[string]: M} = Map()
mp["a"] = { v: 8, next: null }
print((mp["a"] ?? mk(0)).v)
