// A free index operator over a GENERIC container is a template, and `x[i]` is
// typed at the SITE: `Box<i32>` indexes to `i32` and `Box<string>` to `string`,
// from one `"[]"` (B14, `index-operator-design.md`).
//
// The element types are deliberately not both scalars — `.length` on the string
// arm only compiles if the site really got `string`, where taking the operator's
// declared return verbatim would have handed it the bare type parameter.
//
// The write mirror is here for the same reason the read is: `"[]="` checks the
// value against its VALUE parameter, which is equally a template.
// @log 7
// @log ok
// @log 2
// @log 41
// @log hi
// @hint Intentionally-unused parameter `_i`
// @hint Intentionally-unused parameter `_i`

type Box<T> = { v: T }

function "[]"<T>(self: Box<T>, _i: i32): T { return self.v }

function "[]="<T>(self: Box<T>, _i: i32, v: T) { self.v = v }

const bi = { v: 7 }
const bs = { v: "ok" }

print(bi[0])
print(bs[0])
print(bs[0].length)

bi[0] = 41
bs[0] = "hi"
print(bi[0])
print(bs[0])
