// @run
// @log 7
// @log 3
// @log 9
// @log 4
// @log 99
// @log 99
// @hint redundant type annotation: `holder` is inferred as `{flat: i32}`
// @hint redundant type annotation: `Row` is inferred as `{a: i32, b: f64}`
// `flat` is a CONTEXTUAL keyword — it is the flat-record modifier only immediately
// before the `type` keyword, and stays an ordinary identifier everywhere else
// (webcraft P1.2, `docs/internals/flat-records-design.md` §1).
//
// The guard is EXACT rather than heuristic, because `type` is a hard lexer
// keyword: an IDENT followed by `type` is not a legal statement in VL under any
// parse. On master, `flat type X = { … }` parses as the expression statement
// `flat` plus the declaration and dies at `undeclared identifier 'flat'` — so the
// widening is TOTAL. Every token sequence this feature newly accepts was
// previously a hard error, and no existing program can change meaning.
//
// That is a stronger guarantee than P1.5's `new` got, which needed a second-token
// lookahead to keep `type N = new` meaning "alias of the type named `new`".
flat type Row = { a: i32, b: f64 }

// `flat` as a VARIABLE, as a FUNCTION name, as a PARAMETER, as a FIELD name, and
// as a TYPE name — all still legal.
const flat = 7
print(flat)
function flatten(flat: i32) { return flat + 1 }
print(flatten(2))
type flatty = { flat: i32 }
const holder: flatty = { flat: 9 }
print(holder.flat)
print(Row.b)

// A VALUE binding shadows the layout constants: the interception requires the
// receiver NOT to resolve as a value, so a binding named after a flat type wins
// and `.a` is its FIELD. This is what makes the fold unreachable from any program
// that compiles today — every existing `x.f` has a value `x` by construction.
//
// The shadow is SCOPE-WIDE, not position-based, because VL hoists declarations:
// a `const Row` anywhere in a scope shadows `Row`'s layout constants throughout
// that scope, including textually above itself (a read before the declaration is
// the ordinary "used before it is assigned" error, not a layout constant). So the
// demo lives in a function, where the shadow is contained and the top-level
// `Row.b` above still folds.
function shadowed() {
  const Row: Row = { a: 99, b: 1.0 }
  return Row.a
}
print(shadowed())
print(99)
