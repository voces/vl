// @log 2
// @log x
// @log 2
// @log 1
// @log true
// An alias whose body is a list of a union denotes that list: of a nullable record (also through
// an alias of the element), of two records, of a record and a scalar, of two scalars and of a
// nullable scalar, read by index, `.length`, `for` and `is`, also beside a generic pin (D3298).
type H = { v: i32 }
type R = (H | null)[]
function F(z: R) {
  const e = z[0]
  if e != null { print(e.v) }
}
F([{ v: 4 }, null])
const z: R = [{ v: 4 }, null]
print(z.length)
for e in z {
  if e != null { print(e.v) } else { print(0) }
}
function mk(): R { return [null, { v: 9 }] }
const w = mk()
const e1 = w[1]
if e1 != null { print(e1.v) }

type E = H | null
type RE = E[]
function G(q: RE) {
  const e = q[0]
  if e != null { print(e.v) }
}
G([{ v: 5 }])

type A = { a: i32 }
type B = { b: i32 }
type AB = (A | B)[]
const ab: AB = [{ a: 1 }, { b: 2 }]
print(ab.length)
for e in ab {
  if e is A { print(e.a) } else { print(e.b) }
}

type AI = (A | i32)[]
const ai: AI = [{ a: 1 }, 3]
print(ai.length)
for e in ai {
  if e is A { print(e.a) } else { print(e) }
}

type IS = (i32 | string)[]
function walk(xs: IS) {
  print(xs.length)
  for x in xs {
    if x is i32 { print(x + 1) } else { print(x) }
  }
}
walk([1, "a"])

type SN = (string | null)[]
const sn: SN = ["x", null]
print(sn.length)
const q0 = sn[0]
if q0 != null { print(q0) }

type IN = (i32 | null)[]
const inl: IN = [1, null]
print(inl.length)

type AS = (string | null)[]
const asn: AS | null = null
function gen<T>(t: T): T[] { return [t] }
const as1: AS = ["a"]
print(gen(as1).length)
print(asn == null)
