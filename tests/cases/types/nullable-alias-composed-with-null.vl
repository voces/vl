// @run
// @log true
// @log false
// @log true
// @log true
// @log true
// Regression (silent-class-inventory D1026).
//
// `type P = null | f64` composed as `P | null` in a function SIGNATURE was `vl check` rc 0
// and `emitProgram: bare null needs a struct-typed context`. The inline spelling of the very
// same type — `null | f64 | null` — always ran.
//
// NULLABLE IS IDEMPOTENT, and nothing was enforcing it. `null | f64` is stored as
// `TyNullable(f64)`, not as a union, so `P | null` minted `TyNullable(TyNullable(f64))` — a
// shape no arm of the return-seed ladder recognizes. `return null` then fell through every
// seed to the bare-null floor and refused. The inline spelling escaped because its members
// arrive flat and collapse in the member split before a nullable is ever minted; only the
// ALIAS route could nest one.
//
// The language has no second null and no way to write one, so the fold belongs at the one
// home every `T | null` is minted through (`mkNullableTy`), which makes the two spellings the
// same type again — the rule the rest of the checker keeps for every other pair of spellings.
//
// WHAT THE NAME LOOKED LIKE WAS A RED HERRING, recorded because it cost two builds: canon
// already rendered the return as `f64|null`, correctly deduped. The nesting is in the ARENA
// TYPE, not the spelling, and the seeds read the type. A dedupe added to canon's member loop
// changed nothing, twice.
type P = null | f64

// 1 — the row's own witness
function g(): P | null { return null }
print(g() == null)

// 2 — the non-null side of the same signature, so the fold cannot be hiding a wrong answer
function h(): P | null { return 1.5 }
print(h() == null)

// 3 — alias OF the composition, one level further out
type Q = P | null
function q(): Q { return null }
print(q() == null)

// 4 — the inline spelling, which always ran and must keep running
function inl(): null | f64 | null { return null }
print(inl() == null)

// 5 — a nullable alias composed with a NON-null arm still behaves: `P | string` is a
// genuine three-atom union and must not be folded away with the duplicate.
type R = f64 | string
function r(): R | null { return null }
print(r() == null)
