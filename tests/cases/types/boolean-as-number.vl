// @run
// @log 1
// @log 0
// @log 1
// @log 6
// @log 0.5
// @log 0.25
// @log 1
// @log 0
// @log 1
// @log 1
// @log 2
// @log 3
// @log 2
// @log 11
// `as` converts a `boolean` to every numeric target as 1 or 0: `i32` and `u8` read the
// boolean's own i32, `i64` extends it, `f32` and `f64` convert it. The conversion is exact, so
// `as!` never traps and `as?` never yields null — all three modes give the number. A literal
// converts as a value does, and the result is an ordinary number in any position.
const t = 3 > 2
const f = 3 < 2
print(t as i32)
print(f as i32)
print(t as u8)
print((t as i64) + 5)
print((t as f64) / 2.0)
print((t as f32) / 4.0)
print(true as i32)
print(false as i64)
print(t as! i32)
print(t as? i32)
print(t as i32 + t as i32)

// Counting through a loop, the use the conversion exists for.
let c = 0
for fl in [true, false, true, true] { c = c + fl as i32 }
print(c)

const bytes: u8[] = [t as u8, true as u8]
print(bytes[0] + bytes[1])
print(if t { 10 } else { 20 } + (t as i32))
