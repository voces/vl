// @run
// CONTRACT: the DISPLAY renderer (`tyToStr` — hover, inlay hints, completion detail,
// the redundant-annotation hint and every `tErr` message) spells a type the way the
// SOURCE spells it. It carries the same three nominal legs, in the same order, that
// `tyToNominalNameGo` and `transparentMemberEmitName` do: a declared struct renders as
// its name, a generic APPLICATION as the application, a declared union alias as the
// alias. Before those legs existed this renderer had only the newtype arm, so every
// declared type reached the reader as its structural expansion — `Cat` as
// `{meow: i32}`, `Box<i32>` as `{v: i32}`, `K` as `"a" | "b"`.
//
// THE HINTS BELOW ARE THE PIN, AND THEY ARE ORDER-INDEPENDENT SUBSTRINGS: each names
// one leg. Every group spells a DISJOINT lexeme so no pin can be satisfied by another
// group's diagnostic.
//
// The struct leg
// @hint redundant type annotation: `c` is inferred as `Cat`
// The generic-application leg, one type parameter and two
// @hint redundant type annotation: `y` is inferred as `Box<i32>`
// @hint redundant type annotation: `p` is inferred as `Pair<i32,string>`
// A generic application nested in an application, and one under a list
// @hint redundant type annotation: `n` is inferred as `Box<Box<i32>>`
// @hint redundant type annotation: `l` is inferred as `Box<i32>[]`
// The declared-union-alias leg, a value union and a literal union
// @hint redundant type annotation: `u` is inferred as `Shape`
// @hint redundant type annotation: `k` is inferred as `Kind`
// A NUMERIC literal-union alias renders as the ALIAS, not as its base scalar: the
// base-scalar soften is the EMIT renderer's rule (the emitter cannot classify `Nz`),
// and a reader's question is what the source calls the type.
// @hint redundant type annotation: `z` is inferred as `Nz`
// @log 1
// @log 2
// @log 3
// @log 4
// @log 5
// @log 6
// @log 7
// @log 8
type Cat = { meow: i32 }
type Sq = { side: i32 }
type Shape = Cat | Sq
type Kind = "kk" | "jj"
type Nz = 7 | 8
type Box<T> = { v: T }
type Pair<A, B> = { a: A, b: B }

function mkCat(): Cat { return { meow: 1 } }
function mkBox(): Box<i32> { return { v: 2 } }
function mkPair(): Pair<i32, string> { return { a: 3, b: "pr" } }
function mkNest(): Box<Box<i32>> { return { v: { v: 4 } } }
function mkList(): Box<i32>[] { return [{ v: 5 }] }
function mkShape(): Shape { return { side: 6 } }
function mkKind(): Kind { return "kk" }
function mkNz(): Nz { return 8 }

function main() {
  const c: Cat = mkCat()
  print(c.meow)
  const y: Box<i32> = mkBox()
  print(y.v)
  const p: Pair<i32, string> = mkPair()
  print(p.a)
  const n: Box<Box<i32>> = mkNest()
  print(n.v.v)
  const l: Box<i32>[] = mkList()
  print(l[0].v)
  const u: Shape = mkShape()
  if u is Sq { print(u.side) }
  const k: Kind = mkKind()
  if k == "kk" { print(7) }
  const z: Nz = mkNz()
  print(z)
}
main()
