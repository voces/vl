// @check
// @error argument 1: expected WriteHp, got ReadHp
// The REJECT half of `newtype-read-write-brands.vl`. Two brands over one shape are distinct
// types in argument position, which is the whole mechanism behind the read-only-view pattern
// that answers webcraft's "readonly fields / A9 variance" ask.
type ReadHp = new { base: i32, length: i32 }
type WriteHp = new { base: i32, length: i32 }

function writeHp(v: WriteHp, i: i32, x: f32) { __store_f32__(v.base + (i << 2), x) }

const r: ReadHp = { base: 16, length: 4 }
writeHp(r, 0, 1.0 as! f32)
