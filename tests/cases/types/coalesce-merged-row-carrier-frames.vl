// @run
// @log 11
// @log 12
// @log 13
// @log s
// @log 1.5
// @info `a` is never reassigned
// THE INFO IS DECLARED, NOT SILENCED: `let a: S | null = null` with no reassignment is the
// exact shape D872's IDENT arm reads an annotation for — a `??` left operand whose
// non-null value NO literal in the program supplies. `const` would be the same program and
// the same defect; the lint is right and the case needs the spelling it flags.
// CONTRACT (must-RUN): D921 and D922. Two more carriers the D911 argument reader could not
// reach, and a spelling of the `??` left operand's own annotation that it declined — none of
// the three needed a new reader.
//
// THE DEPTH CAP WAS A REFUSAL WITH A NUMBER IN IT. `anonLeafCalleeRead`'s `depth > 1` was
// documented as "the second, independent bound and the only one a fresh name meets", and it is
// not a bound at all: every recursive entry to that reader goes through the `fns` gate, a name
// already on the path answers without re-reading, and each fresh name is pushed exactly once —
// so the frames one read can open are bounded by the count of DISTINCT function names whatever
// `depth` says. `distilled/named/d921_nested_arg_cycle` is the mutual recursion that says so,
// and it is a program master cannot compile at all.
//
// AND `body = -1` WAS NOT THE ONLY FRAME THERE IS. `anonLeafArgIdentOk` read an argument's
// binding by name over the whole program and then handed the bound VALUE no frame, on the
// stated ground that "a bound value that is itself an identifier has no frame to resolve
// against here". The frame is the BINDING SITE's — not the call site's and not the callee's —
// and with it an argument written from the caller's own parameter composes D842's reader with
// D891's. `distilled/named/d921_arg_ident_module_chain` is the standing bound: module scope has
// neither bindings nor a parameter list for `anonLeafRetIdentOk` to resolve against.
//
// A DECLARED RETURN NAME IS THE SAME OPERAND WRITTEN DOWN ONCE. `anonLeafAnnAtomOf` read the
// shape off the annotation TEXT, so `type R = {r: i32}` with `: R | null` declined where the
// inline `{r: i32} | null` answered. The fields come off the declaration's own `FieldDef` nodes
// when there is no spelling to split. `d922_ann_alias_f64_narrower` is a SECOND cell master
// gets wrong at that spelling — D918's annotation-WIDTH question asked through an alias.

// ---- a nested argument TWO frames in: the depth cap allowed exactly one ----
function srcf(p: { a: i32 }): { a: i32 } | null { p }

function innerf(): { a: i32 } { { a: 11 } }

function mkf(): { a: i32 } { innerf() }

function rf() {
  const g1 = srcf(mkf()) ?? { a: "s" }
  print(g1.a)
}
rf() // 11

// ---- an argument bound from the CALLER'S OWN PARAMETER ----
function srcz(p: { b: i32 }): { b: i32 } | null { p }

function rz(z: { b: i32 }) {
  const q = z
  const g1 = srcz(q) ?? { b: "s" }
  print(g1.b)
}
rz({ b: 12 }) // 12

// ---- and two hops of the same chain, which the name-visited set bounds ----
function srch(p: { c: i32 }): { c: i32 } | null { p }

function rh(z: { c: i32 }) {
  const q = z
  const w = q
  const g1 = srch(w) ?? { c: "s" }
  print(g1.c)
}
rh({ c: 13 }) // 13

// ---- a DECLARED return name, where the atom lives only in the annotation ----
type R = { d: i32 }

function srcr(): R | null {}

function rr() {
  const g1 = srcr() ?? { d: "s" }
  print(g1.d)
}
rr() // s

// ---- the same alias on the IDENT arm, at the numeric pair D918's width gate decides ----
type S = { e: i32 }

function rw() {
  let a: S | null = null
  const g1 = a ?? { e: 1.5 }
  print(g1.e)
}
rw() // 1.5
