// @run
// @log 1
// @log s
// @log 2
// @hint Intentionally-unused parameter `_v`
// @hint redundant type annotation: `arrOfUnion` is inferred as `(i32 | string)[]`
// @hint redundant type annotation: `show` is inferred as `i32`
// CONTRACT (D954): a UNION whose last member is an array is not an array. `nameIsArray` was a
// pure two-character SUFFIX test, so `string | i32[]` read as a list type — the two characters
// it looked at belong to the last MEMBER, not to the whole name.
//
// THE TWO SPELLINGS OF ONE TYPE DISAGREED, which is what makes this a defect rather than a
// missing feature: `{ a: string | i32[] }` stored a string ref into a list-typed field and was
// check-clean INVALID WASM, while `{ a: i32[] | string }` — same type, members swapped — boxed
// correctly and ran. Both spellings are pinned here for that reason; a one-spelling fixture
// would pass on master.
//
// THE ARRAY OF A UNION IS STILL AN ARRAY, and that is the line the fix must not cross:
// `(i32 | string)[]` ends in `[]` too, and its `|` sits inside the parens where
// `unionMemberCount`'s depth-aware scan does not see it. That is why the guard asks the
// top-level atom COUNT rather than merely whether a `|` occurs.
type B = { a: string | i32[] }
type C = { a: i32[] | string }

const b: B = { a: "s" }
const c: C = { a: "s" }

const arrOfUnion: (i32 | string)[] = [1, "a"]

function show(_v: string | i32[]): i32 {
  1
}

print(show(b.a))
if c.a is string { print(c.a) } else { print("?") }
print(arrOfUnion.length)
