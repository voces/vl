// @run
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log 7
// ASSIGNING `null` TO A NULLABLE BINDING — the reps `emitAssign` never seeded.
//
// A bare `null` has no rep of its own: it takes the one the enclosing position seeds (the
// table at `emitNullLitNode`). `emitAssign`'s local arm seeded the boolean, string,
// closure and `i32[]` niches; it did NOT seed a nullable STRUCT, a DISTINCT-backing
// nullable scalar list (`string[]`/`f64[]`/`i64[]`/`f32[]` — `exprNullableList` covers
// only the i32-backed `i32[] | null`) or a nullable MAP. Each of those rejected the whole
// module with `emitProgram: bare null needs a struct-typed context` — even though the very
// same binding INITIALIZED to `null` lowered fine, which is what made the gap survive: the
// `let` ladder was complete and only the re-assignment was not.
//
// The last group is the CONTROL: a NON-null value assigned to the same bindings must still
// lower to its own rep, so the added seeds cannot be claiming a non-null RHS.

type S = { v: i32 }

function nulStruct(): i32 {
  let a: S | null = { v: 7 }
  a = null
  if a == null { return 0 }
  return 1
}
print(nulStruct())

function nulF64List(): i32 {
  let a: f64[] | null = [7.5]
  a = null
  if a == null { return 0 }
  return 1
}
print(nulF64List())

function nulStrList(): i32 {
  let a: string[] | null = ["a"]
  a = null
  if a == null { return 0 }
  return 1
}
print(nulStrList())

function nulI64List(): i32 {
  let a: i64[] | null = [7]
  a = null
  if a == null { return 0 }
  return 1
}
print(nulI64List())

function nulF32List(): i32 {
  let a: f32[] | null = [7.5]
  a = null
  if a == null { return 0 }
  return 1
}
print(nulF32List())

function nulMap(): i32 {
  let a: {[string]: i32} | null = Map()
  a = null
  if a == null { return 0 }
  return 1
}
print(nulMap())

// CONTROL — the same binding taking a real value back after the `null`, so the added
// seeds cannot be claiming a NON-null RHS. (The checker narrows `a` to the struct at the
// assignment, so it is read directly rather than re-tested against `null`.)
function reassignBack(): i32 {
  let a: S | null = null
  a = { v: 7 }
  return a.v
}
print(reassignBack())
