// @run
// @log 5000000000000
// @hint redundant type annotation
// A named function value of `i32` result delivered at a `() => i64` slot is wrapped in an adapter
// that widens its result (D3073), so the product is computed in `i64` and does not wrap.
function g(): i32 { return 5 }

const v: () => i64 = g
print(v() * 1000000000000)
