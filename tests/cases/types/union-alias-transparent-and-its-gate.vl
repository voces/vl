// @run
// @log 7
// @log s
// @log a
// @log f
// @log 9
// @log s
// @log 3
// @log 99
// A ONE-MEMBER ALIAS OVER A UNION, in both directions of its gate — the DECLARED value
// union and the INLINE mixed union are transparent, and the INLINE STRUCT union is
// deliberately NOT.
//
// WHY IT IS A FIXTURE. `singleAliasMemberTyIx` claims a union member two ways, and the
// pair is `transparentMemberEmitName`'s two legs read backwards:
//   - a DECLARED union renders as its own NAME (`unionAliasDeclNameOfTy`), so nothing
//     nominal is dropped — `type AU = U` behaves as `U`;
//   - an INLINE union has no declared name to lose, but its MEMBERS may, so the claim is
//     gated on `unionAliasMembersFaithful`: a `TyLit` renders as its base scalar (or its
//     registered litunion alias) and a `TyPrim` as its own name, and both `(K | f64)` and
//     `(i32 | string)` qualify.
//
// THE GATE'S OWN WITNESS is `Sc | Dg` here. With `unionAliasMembersFaithful` absent — i.e.
// the union arm ungated — that alias renders `{n:i32}|{m:i32}`, the variant names `emitIs`
// dispatches on are dropped, and `x is Sc` becomes ``emitProgram: `is` receiver is not a
// union`` where the alias-free spelling below runs. Measured in both positions. So the
// LAST pair of lines is not decoration: it is the only thing standing between this arm and
// a loud regression on struct unions.

type K = "a" | "b"
type U = i32 | string
type Sc = { n: i32 }
type Dg = { m: i32 }

// DECLARED value union behind an alias — claimed by the nominal leg.
type AU = U
function showAU(x: AU) {
  if x is i32 { print(x) } else { print("s") }
}

// INLINE mixed union with a litunion arm — claimed by the member gate.
type AM = (K | f64)
function showAM(x: AM) {
  if x is K { print(x) } else { print("f") }
}

// INLINE value union — claimed by the member gate, and it agreed with its control before.
type AV = (i32 | string)
function showAV(x: AV) {
  if x is i32 { print(x) } else { print("s") }
}

// INLINE STRUCT union — NOT claimed. The alias keeps its union row and its variant names.
// The MODULE CELL is the position that reads it; the alias-spelled PARAMETER is a separate
// pre-existing reject (``emitProgram: `is` receiver is not a union value``, unmoved by any
// of this), so it is deliberately not spelled here.
type AS = (Sc | Dg)

const au: AU = 7
const am: AM = "a"
const av: AV = 9
const as1: AS = { n: 3 }

showAU(au)
showAU("t")
showAM(am)
showAM(1.5)
showAV(av)
showAV("t")
if as1 is Sc { print(as1.n) } else { print(0) }
// The alias-free control on the adjacent line, which is what the gate protects.
const bare: Sc | Dg = { m: 4 }
if bare is Sc { print(bare.n) } else { print(99) }
