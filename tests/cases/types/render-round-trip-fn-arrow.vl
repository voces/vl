// @run
// CONTRACT: the DISPLAY renderer spells a FUNCTION type the way VL source spells it —
// `(params) => ret`. A hint that says "`f` is inferred as X — remove the annotation" is an
// instruction, so X must parse, denote the same type and compile. `->` is a spelling no VL
// program can contain: the hint's own suggestion was a parse error
// (`expected an expression but found GT`).
//
// MASTER'S FAILURE MODE FOR THIS FILE IS THE HINT TEXT, and PIN 2 is what makes it more
// than wording. Master renders these five `(i32) -> i32`, `() -> f64`,
// `(i32, string) -> boolean`, `(i32) -> (i32) -> i32` and `{f: (i32) -> i32}`.
//
// PIN 1 — the render.
// @hint redundant type annotation: `f` is inferred as `(i32) => i32`
// @hint redundant type annotation: `g` is inferred as `() => f64`
// @hint redundant type annotation: `c` is inferred as `(i32, string) => boolean`
// @hint redundant type annotation: `m` is inferred as `(i32) => ((i32) => i32)`
// @hint redundant type annotation: `b` is inferred as `{f: (i32) => i32}`
//
// PIN 2 — the ROUND TRIP, and the reason this is a run tier rather than a wording pin.
// Each `*r` binding below is annotated with the render VERBATIM and assigned from the
// source's own spelling; each `*b` assigns back. Both directions of assignability hold, and
// in a structural language that is type identity. On master these annotations do not parse,
// so the file produces NO output at all for the `@log`s below to disagree with. Their own
// hints are the FIXPOINT: the render of a binding annotated with the render is the render.
// @hint redundant type annotation: `fr` is inferred as `(i32) => i32`
// @hint redundant type annotation: `fb` is inferred as `(i32) => i32`
// @hint redundant type annotation: `gr` is inferred as `() => f64`
// @hint redundant type annotation: `cr` is inferred as `(i32, string) => boolean`
// @hint redundant type annotation: `mr` is inferred as `(i32) => ((i32) => i32)`
// @hint redundant type annotation: `br` is inferred as `{f: (i32) => i32}`
//
// THE NESTED RESULT IS ITS OWN LEG. `m`'s result is itself a function, and it renders
// GROUPED — `(i32) => ((i32) => i32)`. That grouping is the TyFunc-result sibling of the
// array-element rule `arrElemRender` carries and of the union-member rule beside it; the two
// EMIT renderers already hold it and this one did not.
// @log 2
// @log 2.5
// @log 1
// @log 15
// @log 8
// @log 3
// @log 4.5
// @log 0
// @log 25
// @log 12

function mkAdd(): (i32) => i32 { (x: i32) => x + 1 }
function mkNil(): () => f64 { () => 2.5 }
function mkCmp(): (i32, string) => boolean { (n: i32, s: string) => n > s.length }
function mkMk(): (i32) => ((i32) => i32) { (n: i32) => (x: i32) => x + n }
function mkBox(): { f: (i32) => i32 } { { f: (x: i32) => x * 2 } }

function main() {
  const f: (i32) => i32 = mkAdd()
  const g: () => f64 = mkNil()
  const c: (i32, string) => boolean = mkCmp()
  const m: (i32) => ((i32) => i32) = mkMk()
  const b: { f: (i32) => i32 } = mkBox()
  print(f(1))
  print(g())
  if c(3, "ab") { print(1) } else { print(0) }
  print(m(10)(5))
  print(b.f(4))

  // PIN 2 — the render, verbatim, in both directions.
  const fr: (i32) => i32 = f
  const fb: (i32) => i32 = fr
  const gr: () => f64 = g
  const cr: (i32, string) => boolean = c
  const mr: (i32) => ((i32) => i32) = m
  const br: {f: (i32) => i32} = b
  print(fb(2))
  print(gr() + 2.0)
  if cr(1, "abc") { print(1) } else { print(0) }
  print(mr(20)(5))
  print(br.f(6))
}
main()
