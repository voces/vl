// @run
// @log 1
// @log 3
// @log 9
// @log 9
// @log 2
// @log 7
// CONTRACT (D1090): THREE higher-order functions may spell their callback `cb`, and a
// closure-typed slot may receive TWO different functions. Neither is an ambiguity.
//
// `anonLeafParamFnTarget` was keyed by NAME and bailed on `seen != 1` — a name does not
// scope, so the resolver refused outright the moment two functions in one module used the
// same parameter name. That refusal declined the whole `??` family, and the decline stores
// `{ r: "s" }` into the pre-merge `{r: i32}` row: check-clean invalid wasm. RENAMING one
// parameter made the identical program run, which is how the keying was told from a real
// ambiguity. Every `Param` of the name is now answered on its OWN declaration and the answers
// must AGREE — the rule the call-site loop already applied one level down.
//
// AND A SLOT FED TWO KNOWN FUNCTIONS IS ATTRIBUTABLE (`anonLeafParamFnNames`), because
// `anonLeafCoMoveFnParamSlots` moves the whole set together: one slot is one wasm signature,
// so `src` and `mate` cannot be at two rows. Reading only the single-target answer left
// `apply(src)` beside `apply(mate)` unattributed.
//
// CALL ORDER IS SWEPT, not just shape: `useC` is called before the `??` that moves the rows
// and `useB` after it, so a pass that read the marks at the wrong moment shows up as one
// wrong number rather than as a whole-program failure.
function src(p: {r: i32}): {r: i32} | null {
  p
}

function mate(p: {r: i32}): {r: i32} | null {
  p
}

function useA(cb: ({r: i32}) => {r: i32} | null) {
  const v = cb({ r: 1 })
  const w = v ?? { r: 0 }
  w.r
}

function useB(cb: ({r: i32}) => {r: i32} | null) {
  const v = cb({ r: 2 })
  const w = v ?? { r: 0 }
  w.r
}

function useC(cb: ({r: i32}) => {r: i32} | null) {
  const v = cb({ r: 3 })
  const w = v ?? { r: 0 }
  w.r
}

// The TWO-TARGET slot: its own parameter name, fed by two different functions whose rows must
// therefore move together.
function useTwo(cbt: ({r: i32}) => {r: i32} | null) {
  const v = cbt({ r: 9 })
  const w = v ?? { r: 0 }
  w.r
}

function rd() {
  print(useA(src))
  print(useC(src))
  print(useTwo(src))
  print(useTwo(mate))
  const g1 = src({ r: 7 }) ?? { r: "s" }
  print(useB(src))
  print(g1.r)
}

rd()
