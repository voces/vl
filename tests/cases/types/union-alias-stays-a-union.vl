// @run
// @log 1
// @log 7
// The CONTROL for `struct-alias-transparent.vl`'s widening: a one-member alias whose member
// is itself a declared UNION (`type V = U` over `type U = Cat | Dog`) must stay a union box —
// it is not an object, so the transparency rule's `TyObj` arm never claims it, and `V` keeps
// resolving to `U`'s own union type. This already worked; it is pinned because the rule that
// fixed the struct case runs over EVERY one-member alias and could have collapsed this one.
type A = { a: i32 }
type B = { b: i32 }
type AB = A & B
const ab: AB = { a: 1, b: 2 }
print(ab.a)

type Cat = { meow: i32 }
type Dog = { bark: i32 }
type U = Cat | Dog
type V = U
const v: V = { meow: 7 }
if v is Cat { print(v.meow) }
