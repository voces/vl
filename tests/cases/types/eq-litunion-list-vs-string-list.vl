// @log false
// @log true
// @log false
// @log true
// @log true
// @log 2
// `==` over a list of a string literal union and a list of `string` reads the literal list as
// strings, so the two compare by value; the read is a copy, so the original keeps its own
// storage (D16393).
const a: ("a" | "b")[] = ["a"]
const b = ["a"]
print(a == b)
print(b == a)
print(a != b)
const c = ["b"]
print(a == c)
const na: ("a" | "b" | null)[] = ["a", null]
const nb: (string | null)[] = ["a", null]
print(na == nb)
const nc: (string | null)[] = ["a", "b"]
print(na == nc)
function f(x: ("a" | "b")[], y: string[]) { return x == y }
print(f(["b"], ["b"]))
print(a == b)
a.push("b")
print(a.length)
