// @run
// @log x
// @log u1
// @log 3
// @log c-1
// @log h1
// @log x
// @log 0
// @log x
// @log 1
// @log 1
// @log 1
// @log x
// @log 1
// Q58 position sweep: `m[k] as? V` over a read already at `V | null` is the read itself
// (`mapOptRead`), and a `boolean` cast to a wider number widens its 0 or 1, in every delivery
// position.
import { toString } from "std:fmt"

type U = f64 | string
type R = { s: string | null, v: i64 }
function sc(x: i64) { return x + 1 }
function un(u: U) { return if u is string { u } else { "u" + toString(u) } }
function os(s: string | null) { return s ?? "-" }
function none(): i64 | null { return null }
function rd(m: {[string]: string}, k: string): string | null {
  return m[k] as? string
}
function rw(b: boolean) { return b as f64 }
const m: {[string]: string} = Map()
m["a"] = "x"
const t = 3 > 2
print(os(m["a"] as? string))
print(un(t as f64))
print(sc(sc(t as i64)))
print("c" + os(m["b"] as? string) + toString(t as f32))
print("h\{t as i64}")
print(os(rd(m, "a")))
print(rw(false))
const s = m["a"] as? string
const w = t as i64
print(os(s))
print(w)
print(if t { t as i64 } else { 0 })
print(none() ?? (t as i64))
const r: R = { s: m["a"] as? string, v: t as i64 }
print(os(r.s))
print(r.v)
