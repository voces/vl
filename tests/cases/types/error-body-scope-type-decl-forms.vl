// @check
// @error-at 27:3 move `S` to module scope
// @error-at 31:3 move `R` to module scope
// @error-at 35:3 move `K` to module scope
// @error-at 39:3 move `N` to module scope
// @error-at 43:3 move `Pair<A>` to module scope
// @error-at 47:3 move `Id` to module scope
// @error-at 51:3 move `TV` to module scope
// @error-at 56:5 move `L` to module scope
// @error-at 63:5 move `Q` to module scope
// D1045's INTERIM, over every DECLARATION FORM and every nested POSITION the parser
// admits in a body. `parseStmt` is shared between module and block scope and dispatches
// `TYPE` to the one `parseTypeDecl` production wherever it stands, so the refusal is
// about WHERE the declaration is, never which arm it took — this file is what says so.
//
// The ten rows are the whole grammar plus the two nesting positions: the `{`-bodied
// struct, a union over module-scope names, a literal union, a recursive self-reference, a
// generic alias, a nominal `new`, a `flat` record, then the same declaration inside an
// arrow-lambda body and inside a nested NAMED function. The parser splits the first into
// a `TypeDecl` and the rest into a `UnionDecl`, so both node kinds are covered here.
//
// Each directive names only its OWN tail (`move \`X\` to module scope`) — the shared
// half of the sentence is pinned once, verbatim, by the shadowing fixture beside this
// one, and repeating it ten times would make a wording change a ten-line edit.
type A = { a: i32 }
type B = { b: i32 }
function fStruct(): i32 {
  type S = { x: i32, y: i32 }
  return 1
}
function fUnion(): i32 {
  type R = A | B
  return 2
}
function fLitUnion(): i32 {
  type K = "a" | "b"
  return 3
}
function fRecursive(): i32 {
  type N = { next: N | null }
  return 4
}
function fGeneric(): i32 {
  type Pair<A> = { a: A, b: A }
  return 5
}
function fNominal(): i32 {
  type Id = new i32
  return 6
}
function fFlat(): i32 {
  flat type TV = { a: i32 }
  return 7
}
function fLambda(): i32 {
  const g = (): i32 => {
    type L = { x: i32 }
    return 8
  }
  return g()
}
function fNestedFn(): i32 {
  function h(): i32 {
    type Q = { x: i32 }
    return 9
  }
  return h()
}
print(fStruct() + fUnion() + fLitUnion() + fRecursive() + fGeneric())
print(fNominal() + fFlat() + fLambda() + fNestedFn())
