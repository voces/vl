// @run
// @log 7
// @log 2
// @hint redundant type annotation: `wv` is inferred as `{g: {r: N}}`
// A DECLARED struct alias and the INLINE spelling of the same shape, whose one field is a
// NUMERIC literal union. `canonEmitTypeNames` rewrites the annotation `{r: N}` to
// `{r:i32}` and banks the REWRITTEN spelling's type, which is what the inline shape row
// records; the declared `Box1` keeps the pre-canon `cUserTypes` entry `{r: N}`, which canon
// never revisits. So `buildStructTwins` saw one shape under two arena types with two canon
// ids, `keys[j] == keys[i]` failed before `structFieldCodesEq` was ever asked, and two heap
// types minted for one shape: `vl check` rc 0, `vl run` "expected (ref null $type), found
// (ref $type)" (D611). `repCanonFieldTy` softens a numeric literal union to its base scalar
// in the FIELD position of both canon walks, which is canon's own rule.
type N = 1 | 2
type Box1 = {r: N}
type GW = { g: {r: N} }
function rd(c: {r: N}) {
  const wv: GW = { g: c }
  if (wv.g).r == 1 { print(7) } else { print(0) }
}
rd({ r: 1 })
// The alias spelling still reaches the same row from the other side.
const b: Box1 = { r: 2 }
print(b.r)
