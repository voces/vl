// @run
// @log true
// @log false
// @log true
// @log true
// @log true
// Regression (silent-class-inventory D1027).
//
// `function first(self: Json): Json | null` — the accessor shape every JSON consumer writes
// first, "the element, or nothing" — was `vl check` rc 0 and `emitProgram: bare null needs a
// struct-typed context`, reported at the SIGNATURE.
//
// THE TWO SPELLINGS DISAGREED ABOUT THEIR OWN REP WHILE RENDERING THE SAME NAME. `Json |
// null` answered `vtKindOfType` = `"i32"`; the INLINE flattened spelling of the identical
// type — same rendered name, character for character — answered `"union"`. An i32 return slot
// has nowhere to put a box, so `return null` fell through every seed to the bare-null floor.
//
// THREE EARLIER CANDIDATES ALL ATTACKED THE NAME and none moved the witness: a `mkNullableTy`
// idempotence fold, a canon collapse back to the alias, and a member-SET match in
// `unionRowOf`. The name was already right — flattened and deduped — and the disagreement is
// in the arena TYPE the annotation resolves to. Probing `vtKindOfType` on both spellings is
// what separated them, after three builds spent on the wrong layer.
//
// AND THE PEEL HAS TO ALTERNATE. `nodeTyIsUnionAlias` excludes a `TyNullable` on purpose —
// right for a NICHE (`S | null`, `string | null`) and wrong the moment the inner is a value
// union box. But one unwrap is not enough: `Json | null` interns as `TyNullable( TyUnion[
// TyNullable(rest) ] )` — the outer `| null`, the alias's one-member wrapper, and the alias's
// own `null` folded into a niche. Measured: the inner reads `union1` at the first look, and
// only the second nullable reaches the five-member box the inline spelling shows directly.
type Json = null | boolean | f64 | string | Json[] | { [string]: Json }

// 1 — the row's witness: the null path
function firstNull(self: Json): Json | null {
  if self is Json[] {
    if self.length > 0 { return self[0] }
  }
  return null
}
const empty: Json[] = []
print(firstNull(empty) == null)

// 2 — and the NON-null path of the same signature, so the fix cannot be hiding a wrong answer
const one: Json[] = [1.5]
print(firstNull(one) == null)

// 3 — recursion through the LIST arm only, and 4 — through the MAP arm only: both refused
// before, and `null` in the alias was the second ingredient either way.
type KL = null | f64 | KL[]
function kl(): KL | null { return null }
print(kl() == null)

type KM = null | f64 | { [string]: KM }
function km(): KM | null { return null }
print(km() == null)

// 5 — a nullable over a union with NO null of its own still behaves (it always did): the peel
// must not change a composition that was already correct.
type V = f64 | string
function v(): V | null { return null }
print(v() == null)
