// @run
// @log 7
// @log 3
// CONTRACT (D953): the merged row NESTED one layer down. `src` returns a field of its
// parameter, and that field's value is the literal a `??` merges — so the CARRIER
// `{ r: { r: 7 } }` has to build its inner at the merged row while remaining, itself, no
// member of any family.
//
// THE SECOND `keep({ r: { r: 3 } })` IS THE POINT OF THE FILE, not padding. D923 predicted
// that moving the nested field would make "a second `{r: {r: 3}}` literal whose inner is not
// a family member mint narrow into a merged field". It does not, and the reason is rung 4:
// `paramStructIdxFinal` takes the supersede only for a MARKED param, so `keep`'s parameter
// keeps the narrow row and its literal builds against that. Delete this line and the file
// stops testing the hazard the fix was most likely to cause.
function src(p: {r: {r: i32}}): {r: i32} | null {
  const v = p.r
  v
}

function keep(q: {r: {r: i32}}): i32 {
  (q.r).r
}

function rd() {
  const g1 = src({ r: { r: 7 } }) ?? { r: "s" }
  print(g1.r)
  print(keep({ r: { r: 3 } }))
}

rd()
