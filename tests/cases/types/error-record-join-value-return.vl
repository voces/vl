// @check
// @error {f: i32} is not {f: i32 | string}: they store field `f` differently
// @error {f: string} is not {f: i32 | string}: they store field `f` differently
// Two returned record VALUES of the same field names and different field types join as one
// record (D2731), and a value built at its own row would need a converting copy to be returned
// at the joined one, so each returned value is refused at the checker (D2765): only a fresh
// record widens. Handed over, the two returns would build one result from two structs.
function mkA(): { f: i32 } { return { f: 5 } }
function mkB(): { f: string } { return { f: "s" } }
function pick(c: boolean) {
  if c { return mkA() }
  return mkB()
}
print(pick(true).f)
