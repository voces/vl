// @emit-error emitProgram: this branch hands over a record whose field types differ from the record the branches join to
// Two returned record VALUES of the same field names and different field types join as one
// record (D2731), and a value built at its own row would need a converting copy to be returned
// at the joined one, so the returned value is refused rather than handed over (D2765). Handed
// over, the two returns build one function result from two unrelated structs: invalid wasm.
function mkA(): { f: i32 } { return { f: 5 } }
function mkB(): { f: string } { return { f: "s" } }
function pick(c: boolean) {
  if c { return mkA() }
  return mkB()
}
print(pick(true).f)
