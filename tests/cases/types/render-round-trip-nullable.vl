// @run
// CONTRACT: the DISPLAY renderer spells a NULLABLE the way VL source spells it — `T | null`.
// VL has no `T?` suffix at all, so master's render of these five (`i32?`, `S?`, `string[]?`,
// `{[string]: i32}?`, `{f: i32?}`) is a spelling no VL program can contain: acting on the
// hint's "remove the annotation" instruction by writing the offered type back is
// `expected an expression but found QUESTION`.
//
// PIN 1 — the render, and it IS the pin. A `@log` form is unavailable for this leg, and the
// reason is worth stating rather than working around: `T | null` is the ONLY spelling VL
// accepts, so every program that compiles at all already writes it. There is no source text
// whose meaning differs between master and here — this slice moves diagnostic text and
// nothing else, and the emitted corpus is byte-identical. The strongest available form is
// therefore the message, plus PIN 2's demonstration that the message is usable.
// @hint redundant type annotation: `i` is inferred as `i32 | null`
// @hint redundant type annotation: `s` is inferred as `S | null`
// @hint redundant type annotation: `l` is inferred as `string[] | null`
// @hint redundant type annotation: `m` is inferred as `{[string]: i32} | null`
// @hint redundant type annotation: `b` is inferred as `{f: i32 | null}`
//
// PIN 2 — the ROUND TRIP, green on master too by construction, exactly like
// `display-render-round-trips.vl`'s: it pins that the string PIN 1 shows is USABLE, not that
// the renderer changed. Each `*r` binding is annotated with the render VERBATIM and assigned
// from the source's own spelling, and each hint below is the FIXPOINT — the render of a
// binding annotated with the render is the render.
// @hint redundant type annotation: `ir` is inferred as `i32 | null`
// @hint redundant type annotation: `sr` is inferred as `S | null`
// @hint redundant type annotation: `lr` is inferred as `string[] | null`
// @hint redundant type annotation: `mr` is inferred as `{[string]: i32} | null`
// @hint redundant type annotation: `br` is inferred as `{f: i32 | null}`
//
// THE ARRAY LEG IS THE ONE TO READ TWICE. `string[] | null` is a NULLABLE LIST and
// `(i32 | null)[]` — the cross shape, in `render-round-trip-mixed-grouping.vl` — is a LIST OF
// NULLABLES. Master spelled the first `string[]?` and the second `i32?[]`, which differ by
// where a suffix sits; the source spelling tells them apart by a grouper.
// @log 7
// @log 3
// @log 1
// @log 0
// @log 5
// @log 7
// @log 3
// @log 1
// @log 0
// @log 5

type S = { v: i32 }

function mkI(): i32 | null { 7 }
function mkS(): S | null { { v: 3 } }
function mkL(): string[] | null { ["a"] }
function mkM(): {[string]: i32} | null { Map() }
function mkF(): { f: i32 | null } { { f: 5 } }

function main() {
  const i: i32 | null = mkI()
  const s: S | null = mkS()
  const l: string[] | null = mkL()
  const m: {[string]: i32} | null = mkM()
  const b: { f: i32 | null } = mkF()
  if i != null { print(i) } else { print(0) }
  if s != null { print(s.v) } else { print(0) }
  if l != null { print(l.length) } else { print(0) }
  if m != null { print(m.size) } else { print(0) }
  if b.f != null { print(b.f) } else { print(0) }

  // PIN 2 — the render, verbatim.
  const ir: i32 | null = i
  const sr: S | null = s
  const lr: string[] | null = l
  const mr: {[string]: i32} | null = m
  const br: {f: i32 | null} = b
  if ir != null { print(ir) } else { print(0) }
  if sr != null { print(sr.v) } else { print(0) }
  if lr != null { print(lr.length) } else { print(0) }
  if mr != null { print(mr.size) } else { print(0) }
  if br.f != null { print(br.f) } else { print(0) }
}
main()
