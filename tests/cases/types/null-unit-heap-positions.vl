// @run
// @hint redundant type annotation: `q` is inferred as `null`
// @log true
// @log 3
// @log true
// @log 3
// @log 4
// @log true
// @log 3
// @log 5
// @log 2
// @log 2
// @log 2
// @log 6
// @log true
// @log a
// @log b
// @log 7
// @log 2
// @log true
// @log true
// @log 1
// @log true
// @log 2
// The `null` unit type in a struct field, a list element, a map value and `null[] | null`: the
// field is a `nullref` slot and the element and value ride the i32 sentinel, so each read is `null`.
import { filled, insert } from "std:array"

type Box = { a: null, n: i32 }
function nothing(): null { return null }
function id<T>(x: T): T { return x }
function at0<T>(self: T[]): T { return self[0] }
function put<T>(self: T[], v: T) { self[0] = v }
const b: Box = { a: null, n: 3 }
b.a = nothing()
print(b.a == null)
print(b.a ?? b.n)
print(b == { a: null, n: 3 })
const xs: null[] = [null, null]
xs.push(nothing())
xs[1] = null
print(xs.length)
print(xs[2] ?? 4)
print(xs.pop() == null)
put(xs, null)
insert(xs, 0, null)
print(xs.length)
print(at0(xs) ?? 5)
const ys = filled(2, id(xs[0]))
print(ys.length)
let seen = 0
for v in ys {
  if v == null { seen = seen + 1 }
}
print(seen)
const m: {[string]: null} = Map()
m.set("a", null)
m["b"] = nothing()
print(m.length)
print(m["a"] ?? 6)
print(m.get("z") == null)
for k, v in m { print(k) }
type N = null | null
const q: N = null
print(q ?? 7)
function maybe(on: boolean): null[] | null {
  if on { return [null, null] }
  null
}
const r = maybe(true)
if r != null { print(r.length) }
print(maybe(false) == null)
type Holder = { a: null[] | null }
const h: Holder = { a: null }
print(h.a == null)
const h2: Holder = { a: [null] }
const ha = h2.a
if ha != null { print(ha.length) }
const nested: null[][] = [[null], [null, null]]
print(nested[0][0] == null)
print(nested[1].length)
