// @run
// @log 101
// @log u
// @log 103
// @log <c>
// @log [5]
// @log then
// @log 6
// @log else
// @log 6
// @log 14
// @log 8
// @log 0
// @log 9
// @log 10
// @log 12
// A `??` whose left is a `null`-typed if-expression over a never-filled `const x = null`: the
// `if` runs for its effects (its arms' preludes included), then the default is the value, in each
// position: a scalar and a union argument, a nested argument, a concat operand, an interpolation
// hole, a return, an initializer, an `if` arm, a `??` operand, a record field and after an operand.
type R = { v: i32 }
function show(u: i32 | string): string {
  if u is string { return u } else { return "n" }
}
function plus(n: i32) { return n + 100 }
function id(n: i32) { return n }
function note(s: string) { print(s) }
function argScalar(c: boolean) {
  const x = null
  return plus((if c { x } else { x }) ?? 1)
}
function argUnion(c: boolean) {
  const x = null
  return show((if c { x } else { x }) ?? "u")
}
function argNested(c: boolean) {
  const x = null
  return plus(id((if c { x } else { x }) ?? 3))
}
function concat(c: boolean) {
  const x = null
  return "<" + ((if c { x } else { x }) ?? "c") + ">"
}
function interp(c: boolean) {
  const x = null
  return "[\{(if c { x } else { x }) ?? 5}]"
}
function ret(c: boolean) {
  const x = null
  return (if c {
    note("then")
    x
  } else {
    note("else")
    x
  })
    ?? 6
}
function letInit(c: boolean) {
  const x = null
  const y = (if c { x } else { x }) ?? 7
  return y * 2
}
function ifArm(c: boolean, d: boolean) {
  const x = null
  const y = if d { (if c { x } else { x }) ?? 8 } else { 0 }
  return y
}
function coal(c: boolean) {
  const x = null
  return ((if c { x } else { x }) ?? null) ?? 9
}
function rec(c: boolean): R {
  const x = null
  const r: R = { v: (if c { x } else if !c { x } else { x }) ?? 10 }
  return r
}
function after(k: i32, c: boolean) {
  const x = null
  return k + ((if c { x } else { x }) ?? 11)
}
print(argScalar(true))
print(argUnion(false))
print(argNested(true))
print(concat(false))
print(interp(true))
print(ret(true))
print(ret(false))
print(letInit(true))
print(ifArm(true, true))
print(ifArm(true, false))
print(coal(false))
print(rec(true).v)
print(after(1, true))
