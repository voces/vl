// @run
// @log 1
// @log 2
// @log 3
// @log 9
// @log b
// @log none
// @log 4
// A `??` chain `a ?? b ?? d` parses left-associative and lowers re-associated, `a ?? (b ?? d)`:
// the first non-null link wins, and the default only when every link is null.
function num(a: i32 | null, b: i32 | null, c: i32 | null) {
  return a ?? b ?? c ?? 9
}

function pick(a: string | null, b: string | null) { return a ?? b ?? "none" }

function grouped(a: i32 | null, b: i32 | null) { return (a ?? b) ?? 4 }

print(num(1, 2, 3))
print(num(null, 2, 3))
print(num(null, null, 3))
print(num(null, null, null))
print(pick(null, "b"))
print(pick(null, null))
print(grouped(null, null))
