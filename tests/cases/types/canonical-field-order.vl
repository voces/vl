// @run
// @log 7
// @log 9
// @log 7
// @hint redundant type annotation: `takeAB` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `y` is inferred as `{b: f64, a: i32}` — remove it to lean on inference
// @hint redundant type annotation: `takeInline` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `p` is inferred as `{c: string, a: i32}` — remove it to lean on inference
// @hint redundant type annotation: `d` is inferred as `{s: i32, r: i32}` — remove it to lean on inference
// THE FIVE HINTS ARE DECLARED, NOT DELETED. Each of the three shape annotations is the whole
// of what its program tests — `y: BA`, `p: CA` and `d: Dot` are what pin the value to the
// PERMUTED spelling, and deleting one makes the program stop crossing the seam and run for a
// reason that has nothing to do with the ordering. The two return annotations are declared
// for the same reason the shapes are: they are what makes the hint list complete rather than
// curated. Note what the second hint SAYS — the checker's view of `y` is `{b: f64, a: i32}`,
// the source spelling, while the emitter lays that binding out as `[a, b]`. That gap is the
// whole subject of this file.
// A SHAPE'S WASM FIELD ORDER IS A FUNCTION OF THE SHAPE, NOT OF DECLARATION ORDER (D622).
//
// `permuted-named-alias-shares-row.vl` pins that a field-permuted pair is ONE type all the
// way down; this pins WHICH order that one type gets. Until 2026-08-30 the answer was "the
// first row with this field-name set" (`rowWithFieldNameSet`), so the SAME two declarations
// laid out two different ways depending on which came first: `AB` then `BA` emitted
// `(struct (mut i32) (mut f64))`, `BA` then `AB` emitted `(struct (mut f64) (mut i32))`.
// Now both emit the name-sorted `[a, b]`, whatever the source says.
//
// WHY A LANGUAGE CARES WHICH ARBITRARY ORDER IT PICKS. The checker's view of a shape is its
// SOURCE SPELLING — the hint above says `y` is `{b: f64, a: i32}` — so any checker rule about
// field POSITION computes an answer the emitter has to honour. Structural width subtyping is
// that rule ("is `Narrow`'s field list a prefix of `Wide`'s"), and under declaration order
// the two ends disagreed: D622's refusal is a program where a shape-only lift emits
// WELL-TYPED wasm that reads the wrong field. A canonical order is what makes the question
// answerable at all.
//
// THE VARIANT TABLE TAKES THE SAME ORDER AND THAT IS NOT COSMETIC. `variantStructHeapTwinAt`
// (D280's cross-table merge) and `variantFieldLayoutEq` compare field CODES POSITIONALLY, so
// an arm in declaration order beside a canonically-ordered declared twin is either a merge
// missed or — when the codes line up while the names do not — a merge taken with the fields
// in opposite slots. Measured on the distilled corpus: sorting the STRUCT rows alone moves
// 12 behavioural classes `runs -> runs but wrong value`, and sorting the VARIANT rows alone
// moves 13. Together, zero. The third program below is that pair.
//
// `flat` records are the standing exception — their field order IS their byte layout
// (`memory/flat-layout-grid.vl`) — and their recorders pass the canonical order by.

// PROGRAM 1 — the permuted pair, declared WIDE-FIRST.
type AB = { a: i32, b: f64 }
type BA = { b: f64, a: i32 }
function takeAB(v: AB): i32 { return v.a }
const y: BA = { b: 3.5, a: 7 }
print(takeAB(y))

// PROGRAM 2 — the same pair with a THIRD spelling in between and an inline shape, so the
// row every spelling lands on is the sorted one rather than whichever was interned first.
type CA = { c: string, a: i32 }
type AC = { a: i32, c: string }
function takeInline(v: { a: i32, c: string }): i32 { return v.a }
const p: CA = { c: "x", a: 9 }
const q: AC = p
print(takeInline(q))

// PROGRAM 3 — an ARM beside a declared struct twin of its exact layout, spelled in the
// OPPOSITE order, read back out of a box. This is the pair the two halves of the ordering
// have to agree on: it is D280's cross-table merge, and it reads the wrong field if only one
// of the two tables is canonical.
type Circle = { r: i32, s: i32 }
type Sq = { z: i32 }
type Shape = Circle | Sq
type Dot = { s: i32, r: i32 }
const d: Dot = { s: 1, r: 7 }
const c: Circle = d
const sh: Shape = c
if sh is Circle { print(sh.r) } else { print(0) }
