// @run
// @log 5
// @log 1
// @log 0
// @log 7
// CONTRACT (must-RUN): D914. `anonLeafParamArgsOk` requires every argument at the parameter's
// position to be nameable, and a RECURSIVE call passing the parameter to itself is an
// identifier — so the scan refuted and the whole callee was declined.
//
// A SELF-PASS CONTRIBUTES NOTHING. The value handed on is the very parameter whose slot the
// merge is moving, so there is no unmoved value behind it and skipping it is sound. That is
// D885's answer one position over: there a call to a name already on the path ANSWERED rather
// than refuting, because that frame's return row is already being moved.
//
// SHADOWING IS WHAT MAKES IT A QUESTION RATHER THAN A SPELLING, and both halves are here. The
// skip is taken only when the call is inside the parameter's OWN frame (`anonLeafInFrame`,
// which never crosses a nested `FuncDecl`) and nothing in that frame rebinds the name
// (`anonLeafFrameRebinds`, over every binder a frame can introduce). `other` below is a
// DIFFERENT function whose own local is spelled `p`: the skip is refused there and the argument
// goes through the ident READER instead, which is why the two arms are asked in that order —
// the reader would resolve the parameter's own name against the program's bindings, find none,
// and refute.

// ---- the self-pass itself ----
function src(n: i32, p: { r: i32 }): { r: i32 } | null {
  if n <= 0 { return p }
  src(n - 1, p)
}

function rd() {
  const g1 = src(2, { r: 5 }) ?? { r: "s" }
  print(g1.r)
}
rd() // 5

// ---- a recursion that passes a DIFFERENT local: read, not skipped ----
function srcq(n: i32, p: { r: i32 }): { r: i32 } | null {
  if n <= 0 { return p }
  const q = { r: 1 }
  srcq(n - 1, q)
}

function rq() {
  const g1 = srcq(2, { r: 5 }) ?? { r: "s" }
  print(g1.r)
}
rq() // 1

// ---- a caller whose OWN local is spelled like the parameter ----
function srco(p: { r: i32 }): { r: i32 } | null { p }

function other() {
  const p = { r: 9 }
  const h = srco(p)
  if h != null { print(0) } else { print(0) }
}

function ro() {
  const g1 = srco({ r: 7 }) ?? { r: "s" }
  print(g1.r)
}
other() // 0
ro() // 7
