// @log 2
// A never-filled `null` local, global or capture read where a `boolean | null` or `string | null`
// is wanted is that type's null. Positions: annotated binding, argument, `return`, record field,
// global read and a closure's capture.
type H = { b: boolean | null, s: string | null }
const g = null
function tb(v: boolean | null) { return v ?? false }
function ts(v: string | null) { return v ?? "d" }
function rb(): boolean | null {
  const x = null
  return x
}
function run(k: i32) {
  const x = null
  const vb: boolean | null = x
  print(vb ?? true)
  const vs: string | null = x
  print(vs ?? "s")
  print(tb(x))
  print(ts(x))
  print(rb() ?? true)
  const h: H = { b: x, s: x }
  print(h.b ?? true)
  print(h.s ?? "f")
  const gb: boolean | null = g
  print(gb ?? true)
  const f = () => {
    const c: string | null = x
    return c ?? "c"
  }
  print(f())
  print(k)
}
run(1)
run(2)
