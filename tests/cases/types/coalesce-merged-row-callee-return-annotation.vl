// @run
// @log s
// @log s
// @log s
// @log 2.5
// @log 41
// @warning Unused parameter `p`
// CONTRACT (must-RUN): D912. The `??` family with NO LITERAL AT ALL. An empty callee body has
// no return path to refuse, so `anonLeafCalleeRead` succeeds with an empty literal list; a
// parameter every call site passes `null` to answers the same way through D891's arm. The set
// is then the DEFAULT's atom alone, `atoms.length < 2` ends `anonLeafPolyUnionSetOpen`, and the
// pair falls to D804's `i32`/`string` corner as check-clean invalid wasm.
//
// THE MISSING ATOM IS THE CALLEE'S DECLARED RETURN, and D872 refused to read one for a CALL
// operand on a MEASURED loud→silent: taking the atom while `anonLeafJoinCallee` was declining
// to move that callee mints the merged row with the callee's literals left at the narrow one.
// The interlock is the reader itself — the atom is taken only where the read SUCCEEDED, so
// every literal the callee hands back is already a member and its return row is already marked.
// Where the read handed back literals this arm is a no-op: the checker made those literals
// agree with the annotation, so the atom is in the set already and the dedup drops it.
//
// AND THE FALL-THROUGH `null` IS A FOURTH OWNER. An empty body's whole result is
// `emitNullForRet`'s `ref.null`, which read `retNulRefIndex` un-redirected: `(ref null $narrow)`
// under a `(result (ref null $merged))`. Removing that line alone reddens four of this file's
// five reads and nothing else.
//
// THE BOUND is `distilled/named/d912_ann_named_ret`: a return annotated through a type ALIAS
// (`R | null`) is a spelling `anonLeafAnnAtomOf` declines — it reads the SHAPE off the
// annotation text — and it is still check-clean invalid wasm.

// ---- an EMPTY callee body: nothing at all reaches the reader ----
function srce(): { r: i32 } | null {
}

function re() {
  const g1 = srce() ?? { r: "s" }
  print(g1.r)
}
re() // s

// ---- an empty body with a PARAMETER, whose argument is a literal nobody returns ----
function srcp(p: { r: i32 }): { r: i32 } | null {
}

function rp() {
  const g1 = srcp({ r: 7 }) ?? { r: "s" }
  print(g1.r)
}
rp() // s

// ---- every call site passes `null`: D891's arm answers with no literal ----
function srcn(p: { r: i32 } | null): { r: i32 } | null { p }

function rn() {
  const g1 = srcn(null) ?? { r: "s" }
  print(g1.r)
}
rn() // s

// ---- the atom is read off the annotation, so it is the annotation's TYPE that decides ----
function srcf(): { r: f64 } | null {
}

function rf() {
  const g1 = srcf() ?? { r: "s" }
  if g1.r is f64 { print(g1.r) } else { print(2.5) }
}
rf() // 2.5

// ---- and the reader still licences a callee that DOES hand back a literal ----
function srcl(): { r: i32 } | null { { r: 41 } }

function rl() {
  const g1 = srcl() ?? { r: "s" }
  print(g1.r)
}
rl() // 41
