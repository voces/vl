// @run
// @log 7.5
// READ-ONLY VIEWS OUT OF NEWTYPE BRANDS — webcraft's "readonly fields / A9 variance" ask,
// answered without either feature (`docs/webcraft-requirements.md`, P2).
//
// Brand the SAME shape twice and hand the consumer the read brand: the direction
// ("renderer/systems read, commands write") is then enforced by the checker at every call,
// with no readonly-field syntax and no container variance. The reject half is pinned in
// `error-newtype-read-brand-into-writer.vl`.
//
// A struct-shaped newtype is CONSTRUCTED by an annotated object literal and READ by plain
// field access — `as` is numeric-only and is not involved. This is exactly how `std:buffer`
// builds `F32View`/`I32View`, so the pattern is already load-bearing in the std lib.
//
// ADVISORY, NOT AIRTIGHT, and that is the honest ceiling: a holder of `ReadHp` can forge
// `{ base: r.base, length: r.length }` as a `WriteHp` and write through it. That is the same
// strength TypeScript's `readonly` gives — it catches the accident, not the determined
// caller, and defeating it is an explicit, greppable act.
type ReadHp = new { base: i32, length: i32 }
type WriteHp = new { base: i32, length: i32 }

function readHp(v: ReadHp, i: i32) { __load_f32__(v.base + (i << 2)) }
function writeHp(v: WriteHp, i: i32, x: f32) { __store_f32__(v.base + (i << 2), x) }

const w: WriteHp = { base: 16, length: 4 }
writeHp(w, 0, 7.5 as f32)
const r: ReadHp = { base: 16, length: 4 }
print(readHp(r, 0))
