// @check
// @error this `if` was typed In | null — the assignment below makes the binding {w: string, k: i32} | null, so the join is {w: string, k: i32} | In | null; annotate the binding
// @warning Field `In.v` is never read (remove it)
// A loop's write followed by a conditional `break` reaches the back edge when the condition is
// false, so the read at the loop's top is the binding's open hole, and the value `if` over it typed
// before the write is refused at the fill (D17207, D17203).
type In = { v: i32 }
type Out = { w: string, k: i32 }
const rec: In = { v: 9 }
function run(f: boolean) {
  let m = null
  let out = ""
  let i = 0
  while i < 2 {
    const j = if f { m } else { rec }
    out = out + (if j == null { "n" } else { "v" })
    m = { w: "z", k: 4 }
    if i == 5 { break }
    i = i + 1
  }
  return out
}
print(run(true))
print(run(false))
