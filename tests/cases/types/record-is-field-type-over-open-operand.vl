// A record `is` over a type-parameter or un-annotated operand tests each field the record
// narrows at the instance's type: by a literal set, or by the field box's arms (D16325), and a
// null the instance hands it is not the record (D16847).
type A = { x: i32 | string | boolean, y: string }
type B = { x: i32 | boolean, y: string }
type C = { x: string, y: string }
function g<T>(a: T) { return a is B }
function h(a) { return a is C }
const p: A = { x: 1, y: "a" }
const q: A = { x: "s", y: "b" }
const r: A = { x: true, y: "c" }
print(g(p))
print(g(q))
print(g(r))
print(h(p))
print(h(q))
print(g(5))
type Z = { z: i32 }
type N = { x: Z | string | null }
type S = { x: string | null }
type W = { x: Z }
function s(a) { return a is S }
function w<T>(a: T) { return a is W }
const n1: N = { x: "t" }
const n2: N = { x: null }
const n3: N = { x: { z: 1 } }
print(s(n1))
print(s(n2))
print(s(n3))
print(w(n1))
print(w(n3))
type L = { x: i32 }
type M = { x: 1 | 2 }
function m(a) { return a is M }
function pick(k: i32): L | null {
  if k > 0 { return { x: k } }
  return null
}
print(m(pick(1)))
print(m(pick(5)))
print(m(pick(0)))
function first<T>(xs: T[]) { return xs[0] is C }
const xs: A[] = [{ x: "a", y: "b" }, { x: 2, y: "c" }]
print(first(xs))
print(s(null))
