// @run
// @log 7
// @log 7
// @log 7
// @hint redundant type annotation: `s` is inferred as `{x: i32, y: i32}`
// D1045's SECOND sub-ruling — a local STRUCTURAL type escapes freely as its shape, because
// the shape IS the type and the caller can spell it. The nominal sibling
// (`error-body-scope-nominal-escapes-return`) is refused at the return; this is the half
// that must keep running, and it is the asymmetry `new` exists to draw.
//
// THREE ESCAPE ROUTES, matching the reject fixture's three: an inferred `return`, a returned
// CLOSURE, and a value stored into an OUTER-SCOPE container. Each caller reads a field of a
// type whose declaration is two scopes away and has no name out here — and each works,
// because the value's type is `{x: i32, y: i32}` and that is writable anywhere.
const sink: {x: i32, y: i32}[] = []
function mk() {
  type S = { x: i32, y: i32 }
  const s: S = { x: 3, y: 4 }
  return s
}
function mkFn() {
  type S = { x: i32, y: i32 }
  return () => { x: 3, y: 4 }
}
function stash() {
  type S = { x: i32, y: i32 }
  sink.push({ x: 3, y: 4 })
}
const a = mk()
print(a.x + a.y)
const b = mkFn()()
print(b.x + b.y)
stash()
print(sink[0].x + sink[0].y)
