// @check
// @error the join is type-valid but cannot build after the fill yet
// A binding filled after a function's `if` joined it with a record, with a record the join was
// not settled at, is refused rather than built with the arm unconverted (D17208).
type In = { v: i32 }
type Sub = { v: i32, k: i32 }
const rec: In = { v: 9 }
const sub: Sub = { v: 4, k: 1 }
let m = null
function pick(flag: boolean) { return if flag { m } else { rec } }
m = sub
print(pick(false)?.v ?? -1)
print(pick(true)?.v ?? -1)
