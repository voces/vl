// @run
// @log 3
// @log 5
// @log 7
// @log 3
// @log uv
// @log 9
// @log 11
// @log 8
// @log 12
// @log 13
// @hint redundant type annotation: `s` is inferred as `{x: i32, y: i32}`
// @hint redundant type annotation: `fStruct` is inferred as `i32`
// @hint redundant type annotation: `fUnion` is inferred as `i32`
// @hint redundant type annotation: `fLitUnion` is inferred as `i32`
// @hint redundant type annotation: `fRecursive` is inferred as `i32`
// @hint redundant type annotation: `p` is inferred as `{a: i32, b: i32}`
// @hint redundant type annotation: `q` is inferred as `{a: string, b: string}`
// @hint redundant type annotation: `fGeneric` is inferred as `i32`
// @hint redundant type annotation: `i` is inferred as `Id`
// @hint redundant type annotation: `fNominal` is inferred as `i32`
// @hint redundant type annotation: `fFlat` is inferred as `i32`
// @hint redundant type annotation: `l` is inferred as `{x: i32}`
// @hint redundant type annotation: `fLambda` is inferred as `i32`
// @hint redundant type annotation: `q` is inferred as `{x: i32}`
// @hint redundant type annotation: `h` is inferred as `i32`
// @hint redundant type annotation: `fNestedFn` is inferred as `i32`
// THE HINTS ARE PART OF THE ASSERTION, not noise to be silenced by deleting the
// annotations. Each one renders the type the reference RESOLVED TO — `{a: i32, b: i32}` and
// `{a: string, b: string}` for the two applications of the local generic alias, `Id` for the
// local nominal (demangled: the declaration is minted as `Id$b6`) — so the file pins the
// resolution twice over, once by what the program prints and once by what the checker says
// the annotation means. Declared rather than deleted, per CLAUDE.md.
// D1045 — EVERY `type` DECLARATION FORM, DECLARED IN A BODY, AND EVERY NESTED POSITION.
// `parseStmt` is one production shared by module and block scope and dispatches `TYPE` to
// the one `parseTypeDecl` production wherever it stands, so the ruling is about WHERE the
// declaration is and never which arm it took — this file is what says so.
//
// The rows are the whole grammar plus the two nesting positions: the `{`-bodied struct, a
// union over module-scope names, a literal union, a recursive self-reference, a generic
// alias at two arguments, a nominal `new`, a `flat` record (whose `TV.size` fold is a
// VALUE-position use of the declared name), then the same declaration inside an arrow-lambda
// body and inside a nested NAMED function. The parser splits the first into a `TypeDecl` and
// the rest into a `UnionDecl`, so both node kinds are covered.
//
// EACH ROW PRINTS A VALUE ONLY ITS OWN RESOLUTION CAN PRODUCE — `fUnion` reads the `B` arm's
// field through an `is`, `fRecursive` walks a self-referential link, `fGeneric` prints from
// BOTH instantiations of the local alias. A row that resolved to some other declaration
// would not type-check, and one that resolved to nothing would not build.
type A = { a: i32 }
type B = { b: i32 }
function fStruct(): i32 {
  type S = { x: i32, y: i32 }
  const s: S = { x: 1, y: 2 }
  return s.x + s.y
}
function fUnion(): i32 {
  type R = A | B
  const r: R = { b: 5 }
  if r is B { return r.b }
  return 0
}
function fLitUnion(): i32 {
  type K = "a" | "b"
  const k: K = "b"
  if k == "b" { return 7 }
  return 0
}
function fRecursive(): i32 {
  type N = { v: i32, next: N | null }
  const tail: N = { v: 2, next: null }
  const head: N = { v: 1, next: tail }
  const nx = head.next
  if nx == null { return head.v }
  return head.v + nx.v
}
function fGeneric(): i32 {
  type Pair<X> = { a: X, b: X }
  const p: Pair<i32> = { a: 4, b: 5 }
  const q: Pair<string> = { a: "u", b: "v" }
  print(q.a + q.b)
  return p.a + p.b
}
function fNominal(): i32 {
  type Id = new i32
  const i: Id = 11 as Id
  return i as i32
}
function fFlat(): i32 {
  flat type TV = { a: i32, b: i32 }
  return TV.size
}
function fLambda(): i32 {
  const g = (): i32 => {
    type L = { x: i32 }
    const l: L = { x: 12 }
    return l.x
  }
  return g()
}
function fNestedFn(): i32 {
  function h(): i32 {
    type Q = { x: i32 }
    const q: Q = { x: 13 }
    return q.x
  }
  return h()
}
print(fStruct())
print(fUnion())
print(fLitUnion())
print(fRecursive())
print(fGeneric())
print(fNominal())
print(fFlat())
print(fLambda())
print(fNestedFn())
