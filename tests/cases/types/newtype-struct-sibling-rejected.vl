// @check
// @error-at 15:14 argument 1: expected FView, got IView
// The cross-width view confusion, rejected — the cell webcraft P1.5 exists to
// flip. `FView` and `IView` are the SAME shape; without `new` on both this program
// checks clean and `readF` reinterprets four integer bytes as a float, silently.
// That is the inverted control, and it is measured, not feared:
// `buffer-design.md` §L2 ran it before the field names were chosen.
//
// Note that the message names the two ALIASES. Its structural predecessor, with
// no nominal identity to lean on, could only render `{base: i32, length: i32}`
// twice — a diagnostic that states a mismatch between a type and itself.
type FView = new { base: i32, length: i32 }
type IView = new { base: i32, length: i32 }
function readF(v: FView) { return v.base }
const iv: IView = { base: 1024, length: 4 }
print(readF(iv))
