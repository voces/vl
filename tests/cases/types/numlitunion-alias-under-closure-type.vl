// @run
// @log 3
// @log 1
// @log 7
// A NUMERIC literal-union ALIAS (`type Z = 0 | 1`) standing INSIDE a FUNCTION TYPE keeps
// its alias NAME in every producer of an emit-time type spelling. The GATE on
// `RC_UNDER_FUNC`, pinned from the side that breaks if it is removed or narrowed.
//
// Outside a function type the alias denotes its BASE SCALAR — `numLitUnionAliasName` /
// `numLitUnionBaseName`, the rule `tests/cases/literal-unions/numeric-litunion-alias.vl`
// exists for: untouched, `Z` reaches the emitter, `collectU` has registered it in
// `unNames` (a `UnionDecl` whose single variant is not a `{…}` shape is not skipped), and
// `isUName` claims the annotation for the `{tag, value}` UNION BOX while every read lowers
// as the plain i32 the checker's algebra says it is. Silent invalid wasm.
//
// INSIDE a function type the same softening is the DEFECT, because `canonEmitName` leaves
// a top-level function type VERBATIM (it recurses into the params only when the RESULT is
// parenthesized). So the annotation pipeline's `$fnsig` key for `run`'s parameter is
// `(Z)=>i32`, alias name and all, and a second producer that answers `(i32)=>i32` forks
// the two spellings of ONE closure: `type mismatch: expected i32, found (ref $type)`, an
// invalid module for a program that builds and runs. `emit_collect.reachRegisterName`
// states this rule from the consumer side ("everything inside a function type is the
// `canonEmitName` VERBATIM region"); `RC_UNDER_FUNC` is that rule at the producer.
//
// THE TWO CELLS BELOW ARE NOT THE SAME PIN, and the second is why the bit ACCUMULATES
// rather than naming an immediate position:
//
//   `first`  — `(Z) => i32`. The alias is the function's own PARAMETER, so its immediate
//              render position IS `RC_FN_PARAM`. An immediate-position gate catches it.
//   `second` — `({ a: Z }) => i32`. The alias is a FIELD of an inline shape that is the
//              parameter, so its immediate position is `RC_FIELD`, which says nothing
//              about the function overhead. Only an ANCESTRY bit catches it, and this
//              cell is exactly the one-character difference between the two designs.
//
// The near-miss that is NOT a witness, and is worth recording so it is not mistaken for
// one: `(i32) => Row` with `type Row = { a: Z }` never renders the field at all — the
// declared struct short-circuits to `Row` first — so a DECLARED shape cannot pin this and
// the INLINE one must.
type Z = 0 | 1

function first(m: (Z) => i32): i32 {
  const v = m(1)
  v
}

function firstImpl(x: Z): i32 { x + 2 }

function second(m: ({ a: Z }) => i32): i32 {
  const v = m({ a: 1 })
  v
}

function secondImpl(r: { a: Z }): i32 { r.a }

// The base-scalar rule itself, in the same program, so the two halves are pinned against
// each other: OUTSIDE any function type `Z` is plain i32 and arithmetic on it lowers.
function plain(z: Z): i32 { z + 6 }

print(first(firstImpl))
print(second(secondImpl))
print(plain(1))
