// @run
// @log 3
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// @log 7
// @hint Intentionally-unused parameter `_x`
// @hint Intentionally-unused parameter `_x`
// @hint Intentionally-unused parameter `_x`
// @hint redundant type annotation: `first` is inferred as `i32`
// @hint redundant type annotation: `firstImpl` is inferred as `i32`
// @hint redundant type annotation: `second` is inferred as `i32`
// @hint redundant type annotation: `retBare` is inferred as `i32`
// @hint redundant type annotation: `retObj` is inferred as `i32`
// @hint redundant type annotation: `retList` is inferred as `i32`
// @hint redundant type annotation: `roundBoth` is inferred as `i32`
// @hint redundant type annotation: `plain` is inferred as `i32`
// @hint redundant type annotation: `asValue` is inferred as `(Z) -> i32`
// A NUMERIC literal-union ALIAS (`type Z = 0 | 1`) standing INSIDE a FUNCTION TYPE. The
// alias denotes its BASE SCALAR here exactly as it does everywhere else — and the reason
// that is not a special case is the point of this fixture.
//
// THE INTERIOR OF A FUNCTION TYPE IS THE SIGNATURE OF SOME DECLARATION. `(i32) => Z` is a
// type for `function mk(x: i32): Z`, whose OWN return annotation is a top-level `Z` and
// canons to `i32` (`numLitUnionAliasName` — the rule
// `tests/cases/literal-unions/numeric-litunion-alias.vl` exists for: untouched, `Z` reaches
// the emitter, `collectU` has registered it in `unNames`, and `isUName` claims the
// annotation for the `{tag, value}` UNION BOX while every read lowers as the plain i32 the
// checker's algebra says it is). So the two `$fnsig` spellings of one closure agree only if
// the function TYPE canons its params and result the same way. `canonEmitNameAt`'s
// function-type arm does exactly that, for a bare result and a parenthesized one alike.
//
// IT USED TO CANON NEITHER (bar an accident), AND BOTH DIRECTIONS OF THE FORK WERE FILED.
// The arm carried a `nameIsParenSpanEnds(name) &&` conjunct, so it claimed only a name that
// happens to END in `)` — one whose RESULT is a parenthesized function. Everything else was
// left VERBATIM:
//
//   * #1271 hit the fork from the PARAM side (`first` below). `annParamKind` saw the raw
//     `Z`, keyed the union box, and the callee was declared `(structref, i32)`. It fixed
//     that by gating the OTHER producer — `tyToNominalNameGo`'s numeric-alias arm — on a new
//     `RC_UNDER_FUNC` ancestry bit, so both sides kept `Z`.
//   * that gate could not close the eight shapes that fork the other way (`(i32) => Z`,
//     `(i32) => Z[]`, `(i32) => Z|null`, `(i32) => {a:Z}`, `(i32) => {a:Z}[]`,
//     `(Z[]) => i32`, `(Z|null) => i32`, `() => Z|null`), because on THEIR far side is a
//     declaration canon'd at `RC_ROOT`, which softens. #1271 filed them, measured: under
//     its own sabotage "not one turns green".
//
// One rule closes both: canon the function type's interior like the declaration it
// describes. `RC_UNDER_FUNC` came back out with the verbatim region it was gating against.
//
// THE CELLS, and what each one pins:
//
//   `first`    — `(Z) => i32`. The alias is the function type's PARAMETER. GREEN on master;
//                it is what `RC_UNDER_FUNC` bought, and it must stay green now that the bit
//                is gone. Restoring the gate WITHOUT the canon arm is the inverted control:
//                this cell and `second` are two of the six grid cells it reddens.
//   `second`   — `({ a: Z }) => i32`. The alias is a FIELD of an inline shape that is the
//                parameter, so its own render position is `RC_FIELD`. The pair
//                `first`/`second` is why an immediate-position gate was never the right
//                shape.
//   `retBare`  — `(i32) => Z`. #1271's filed family, head of the list. INVALID WASM on
//                master: `type mismatch: expected i32, found (ref $type)`.
//   `retObj`   — `(i32) => { a: Z }`. Invalid wasm on master. The alias is a field of an
//                INLINE shape in the RESULT — the near-miss that is NOT a witness is
//                `(i32) => Row` with `type Row = { a: Z }`, because the declared struct
//                short-circuits before the field is ever rendered.
//   `retList`  — `(i32) => { a: Z }[]`. Invalid wasm on master.
//   `roundBoth`— `(Z) => Z`. Invalid wasm on master: the param half was right and the
//                result half was not, in ONE type.
//   `asValue`  — `(Z) => i32` reached as a function VALUE rather than as a parameter. A
//                `wasm trap: cast failure` on master, while the parameter form above builds
//                and runs — the same type, two routes, one of them wrong.
//   `plain`    — `Z` outside any function type. The base-scalar rule itself, so the two
//                halves are pinned against each other in one program.
type Z = 0 | 1

function first(m: (Z) => i32): i32 {
  const v = m(1)
  v
}

function firstImpl(x: Z): i32 { x + 2 }

function second(m: ({ a: Z }) => i32): i32 {
  const v = m({ a: 1 })
  v
}

function secondImpl(r: { a: Z }): i32 { r.a }

function retBare(m: (i32) => Z): i32 {
  const v = m(0)
  v + 0
}

function retBareImpl(_x: i32): Z { 1 }

function retObj(m: (i32) => { a: Z }): i32 {
  const v = m(0)
  v.a + 0
}

function retObjImpl(_x: i32): { a: Z } { { a: 1 } }

function retList(m: (i32) => { a: Z }[]): i32 {
  const v = m(0)
  v.length
}

function retListImpl(_x: i32): { a: Z }[] { [{ a: 1 }] }

function roundBoth(m: (Z) => Z): i32 {
  const v = m(1)
  v + 0
}

function roundBothImpl(z: Z): Z { z }

// The base-scalar rule itself, in the same program: OUTSIDE any function type `Z` is plain
// i32 and arithmetic on it lowers.
function plain(z: Z): i32 { z + 6 }

print(first(firstImpl))
print(second(secondImpl))
print(retBare(retBareImpl))
print(retObj(retObjImpl))
print(retList(retListImpl))
print(roundBoth(roundBothImpl))
const asValue: (Z) => i32 = firstImpl
print(asValue(1) - 2)
print(plain(1))
