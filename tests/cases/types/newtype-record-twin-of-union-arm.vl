// @run
// @log 5
// @log 8
// @log 1
// @hint redundant type annotation: `pick` is inferred as `i32`
// @hint redundant type annotation: `getv` is inferred as `i32`
// @hint redundant type annotation: `srt` is inferred as `i32`
// A `new` record shaped like a union arm is its own struct, not that arm: a function taking it
// keeps a struct parameter, so a closure signature interned beside it still has a heap type.
type B = { base: i32, length: i32 }
type V = new { base: i32, length: i32 }
function pick(d: i32[] | B): i32 {
  if d is B { return d.base }
  d.length
}
function mkv(n: i32): V { return { base: n, length: 1 } }
function getv(v: V, i: i32): i32 { v.base + i }
function srt(xs: string[], less: (string, string) => boolean): i32 {
  if less(xs[0], xs[1]) { return 1 }
  0
}
print(pick({ base: 5, length: 2 }))
print(getv(mkv(7), 1))
print(srt(["a", "b"], (a: string, b: string): boolean => a < b))
