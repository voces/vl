// @run
// @log 1
// @log 1
// @log 1
// @log 1
// @log 7
// @log 3
// @hint redundant type annotation: `take1` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `w1` is inferred as `{a: i32, b: i32}` — remove it to lean on inference
// @hint redundant type annotation: `w2` is inferred as `{b: i32, a: i32}` — remove it to lean on inference
// @hint redundant type annotation: `take3` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `w3` is inferred as `{a: i32, x: i32, c: i32}` — remove it to lean on inference
// @hint redundant type annotation: `w4` is inferred as `{a: i32, b: i32}` — remove it to lean on inference
// @hint redundant type annotation: `w5` is inferred as `{a: i32, b: i32}` — remove it to lean on inference
// @hint redundant type annotation: `t1` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `t2` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `x6` is inferred as `{a: i32, b: i32, c: i32}` — remove it to lean on inference
// STRUCTURAL WIDTH SUBTYPING — a value with MORE fields flowing into a shape with fewer
// (D622). Every one of these was `vl check` rc 1 with "not yet supported by codegen — a
// struct's wasm type is its own field list, so these are unrelated types and no
// field-dropping conversion exists" before 2026-08-30.
//
// IT COSTS NOTHING AND IT COPIES NOTHING. `emitTypeSection` declares
// `(type $Wide (sub $Narrow …))`, so the reference fits the slot as it stands — no
// conversion, no allocation, and REFERENCE IDENTITY intact, which program 5 pins. A
// field-dropping copy was the obvious alternative and it is the wrong one: VL struct values
// alias uniformly (a write through any binding, parameter, element or named layout twin is
// seen by every other holder), so a copy here would make width subtyping the single place in
// the language where `const y: T = x` stops aliasing.
//
// THE PREFIX IS TAKEN IN THE CANONICAL ORDER, not the spelled one, which is why program 2
// works: `{b, a}` lays out as `[a, b]`, so `{a}` is its prefix even though `b` is written
// first. `types/canonical-field-order.vl` is that ordering.

// PROGRAM 1 — the extra field last, across a parameter.
type Wide1 = { a: i32, b: i32 }
type Narrow1 = { a: i32 }
function take1(n: Narrow1): i32 { return n.a }
const w1: Wide1 = { a: 1, b: 2 }
print(take1(w1))

// PROGRAM 2 — the extra field FIRST in the source. Under declaration-order layout this
// pair had no prefix relation at all; under the canonical order it does.
type Wide2 = { b: i32, a: i32 }
type Narrow2 = { a: i32 }
const w2: Wide2 = { b: 2, a: 1 }
const n2: Narrow2 = w2
print(n2.a)

// PROGRAM 3 — the extra field in the MIDDLE, two shared fields.
type Wide3 = { a: i32, x: i32, c: i32 }
type Narrow3 = { a: i32, c: i32 }
function take3(n: Narrow3): i32 { return n.a }
const w3: Wide3 = { a: 1, x: 9, c: 3 }
print(take3(w3))

// PROGRAM 4 — the anonymous destination shape, through a `return`.
type Wide4 = { a: i32, b: i32 }
function mk4(): { a: i32 } {
  const w4: Wide4 = { a: 1, b: 2 }
  return w4
}
print(mk4().a)

// PROGRAM 5 — REFERENCE IDENTITY. A write through the NARROW view reaches the wide
// original, and the field the narrow view cannot see is untouched. A copy would print 3.
type Wide5 = { a: i32, b: i32 }
type Narrow5 = { a: i32 }
const w5: Wide5 = { a: 1, b: 2 }
const n5: Narrow5 = w5
n5.a = 5
print(w5.a + w5.b)

// PROGRAM 6 — A CHAIN. wasm allows ONE declared supertype, and that is enough because a
// row's required parents are all prefixes of its own field list and prefixes are totally
// ordered by length: `S6a <: S6b <: S6c` links up on its own.
type S6a = { a: i32 }
type S6b = { a: i32, b: i32 }
type S6c = { a: i32, b: i32, c: i32 }
function t1(v: S6a): i32 { return v.a }
function t2(v: S6b): i32 { return v.b }
const x6: S6c = { a: 1, b: 2, c: 3 }
print(t1(x6) + t2(x6))
