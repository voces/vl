// @run
// @log la
// @log la
// @log lc
// @log lc
// A TWO-HOP ALIAS CHAIN into a literal union, so the on-demand fill has to recurse:
// `CFwd`'s field names `IFwd`, whose body names `KFwd`, and both sit below their use.
// Subtracting from an unfilled union subtracts from NOTHING, so the chain collapsed to
// `never` and the checker reported ``Type `IFwd` is `never` `` AT THE DECLARATION — a
// hard error invented entirely by declaration order — followed by
// `cannot assign {f: string} to 'cf' of type {f: }`, whose right-hand side renders as a
// type with no spelling at all.
//
// This is the leg that registers a `UnionDecl` for on-demand filling, reached
// TRANSITIVELY: `IFwd` is filled on demand from `CFwd`'s field, and filling `IFwd`
// demands `KFwd` in turn. Removing the `TypeDecl` registration leaves this file green,
// which is what separates it from `-struct-intersection.vl`.
//
// AGREEMENT IS THE ASSERTION, and BOTH RUNTIME INPUTS are exercised: `la` and `lc` are
// the two members that SURVIVE `& !"lb"`, so each arm of the narrowed union is
// constructed and printed.

// ── forward: every referenced declaration sits BELOW its reference ────────────
type CFwd = { f: IFwd }
type IFwd = KFwd & !"lb"
type KFwd = "la" | "lb" | "lc"

// ── back: the identical declarations, in the order that always worked ─────────
type KBack = "la" | "lb" | "lc"
type IBack = KBack & !"lb"
type CBack = { f: IBack }

function go() {
  const cf: CFwd = { f: "la" }
  const cb: CBack = { f: "la" }
  print(cf.f)
  print(cb.f)

  const cf2: CFwd = { f: "lc" }
  const cb2: CBack = { f: "lc" }
  print(cf2.f)
  print(cb2.f)
}

go()
