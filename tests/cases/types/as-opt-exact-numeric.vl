// @run
// @log 7
// @log -1
// @log 300
// @log -1
// @log 2
// @log -1
// A numeric `as?` that can fail is exact-or-null: the value when the target holds it exactly,
// else `null`, from an i64, an f64 and into a `u8`.
function fromWide(x: i64) {
  const n = x as? i32
  return if n == null { -1 } else { n }
}

function fromFloat(x: f64) {
  const n = x as? i32
  return if n == null { -1 } else { n }
}

function toByte(x: i32) {
  const b = x as? u8
  return if b == null { -1 } else { b as i32 }
}

print(fromWide(7))
print(fromWide(5000000000))
print(fromFloat(300.0))
print(fromFloat(2.5))
print(toByte(2))
print(toByte(999))
