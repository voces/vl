// @run
// @log yes
// @log no
// @log 2
// A literal-union member whose TEXT carries an ESCAPED QUOTE. The parser stores the
// raw lexeme — quotes kept, escapes unresolved — into both `TypeRef.tyName` and the
// spelling tree's `tsText`, so the rendered type name for `Q` is the six characters
// `"a\"b"` followed by ` | ` and `"c"`. Every type-name scanner that walks this name
// has to agree on where that member ENDS.
//
// PINNED BY W8 (the identifier-run family). `tyname.skipQuotedName` — the leaf's ONE
// quote rule, which every depth-aware scanner in the grammar calls — honours the `\`
// and skips to the CLOSING quote. `driver.modTypeRenamed`'s module-merge segment
// scanner carries a second, NAIVE rule ("no escapes in type names") that stops at the
// escaped quote and treats the `b` after it as a renameable identifier segment.
//
// The two rules disagree, this file is the shape they disagree on, and W8 declined to
// unify them inside a refactor. What is pinned here is the TAUGHT half: the member
// round-trips through the checker and the emitter in a single module. The UNTAUGHT
// half — the same type in a module whose merge rename map contains a top-level
// binding named `b`, where the naive scanner would rewrite the literal's TEXT — needs
// a multi-module fixture the corpus has no vocabulary for, and is filed in
// `docs/internals/destringify-types-program.md` instead.
type Q = "a\"b" | "c"

function pick(q: Q): string {
  if q is "a\"b" { return "yes" }
  return "no"
}

function count(qs: Q[]): i32 {
  return qs.length
}

const hit: Q = "a\"b"
const miss: Q = "c"
print(pick(hit))
print(pick(miss))
print(count([hit, miss]))
