// @run
// @log 7
// @log 70
// @log 9
// @log 1
// @log 3
// A single-member type alias whose member is a STRUCT (`type MyCat = Cat`) is TRANSPARENT,
// the object half of `primitive-type-alias.vl`'s scalar rule. That file deferred this half
// with "the emitter resolves those through its named-struct path" — it does NOT: the parser
// encodes `type MyCat = Cat` as a one-member `UnionDecl`, `collectU` registers `MyCat` in
// `unNames` (its variant `Cat` is not a `{…}` shape, so `unionStructAliasShape` does not skip
// it), and every classifier that consults `isUName` then reads the alias as a value-union BOX.
// The result was `emitProgram: field access but no struct type declared` /
// `ref valtype with no interned shape` — a checker-accepts / emitter-rejects hole.
//
// Resolving the alias to its member's own vocabulary is STRUCTURAL on purpose: routing it to
// the declared NAME `Cat` instead re-enters the poisoned row above (`collectU` pushes `Cat`
// into `uVariants`, so the name classifies as a union VARIANT) and regresses both cases.
type Cat = { meow: i32 }
type MyCat = Cat

const c: MyCat = { meow: 7 }
print(c.meow)

function loud(k: MyCat) { k.meow * 10 }
print(loud(c))

function mk(n: i32): MyCat { return { meow: n } }
print(mk(9).meow)

// The one-member OBJECT alias that already worked keeps working, and it is the reason the
// transparency rule is gated on a PLAIN alias REFERENCE rather than on the member's kind: a
// canonicalized object INTERSECTION is also a one-member union over one merged shape, but its
// alias name IS interned as a named struct (`unionStructAliasShape`), so it stays opaque.
type A = { a: i32 }
type B = { b: i32 }
type AB = A & B
const ab: AB = { a: 1, b: 2 }
print(ab.a)

type CD = { c: i32 } & { d: i32 }
const cd: CD = { c: 3, d: 4 }
print(cd.c)
