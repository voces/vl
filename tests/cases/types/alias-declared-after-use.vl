// @run
// @log true
// @log true
// @log false
// @log false
// @log T
// @log T
// @log true
// @log true
// @hint redundant type annotation: `fwd` is inferred as `{f: boolean}`
// @hint redundant type annotation: `back` is inferred as `{f: boolean}`
// @hint redundant type annotation: `fwdF` is inferred as `{f: boolean}`
// @hint redundant type annotation: `backF` is inferred as `{f: boolean}`
// THE FOUR HINTS ARE KEPT ON PURPOSE. The annotation is the whole experiment: it is the
// only thing in the program that NAMES `WrapFwd` / `WrapBack`, and the hint fires
// precisely BECAUSE the fix makes the two spellings infer to the same `{f: boolean}`.
// Deleting the annotations to silence the hint deletes the test.
// AGREEMENT IS THE ASSERTION. Every value below is printed twice — once through an
// alias declared AFTER the struct that names it, once through the identical alias
// declared BEFORE it — so the pair of `@log` lines pins the two spellings to each
// other, not merely to a value someone typed out. VL orders nothing else by
// declaration (functions hoist, recursive and mutually-recursive aliases already
// resolve), and a forward reference used to be resolved against the EMPTY placeholder
// the declaration pre-pass mints: `declaredTyOfName`'s transparency collapse needs the
// alias's one member to be present, so `type FlagFwd = boolean` handed back the
// one-member `TyUnion` WRAPPER and the field kept it.
//
// WHY THIS IS A LOG FIXTURE AND NOT A BUILD PIN: the failure was `vl check` rc 0,
// VALID wasm, and a WRONG PRINTED VALUE. The SPELLING channel never had the bug —
// `canonEmitTypeNames` runs after the fill pass and rewrote `FlagFwd` to `boolean`
// either way — so field STORAGE was already correct and the two modules differed in
// nothing but the print import they called. Only the run value moves, so only the run
// value can pin it: `print(fwd.f)` emitted `call __print_i32__` and printed `1` where
// its control printed `true`.
//
// The `if` / `==` lines are here because the value CONSUMERS were the half of this
// defect that stayed correct for `boolean`: storage is decided by the spelling channel,
// so `fwd.f == true` was already right while `print(fwd.f)` was already wrong. They
// pin that the fix moves the arena channel onto the spelling channel's answer and not
// the reverse — a repair that "fixed" print by changing the storage would redden these.

// ── forward: the alias is declared BELOW the struct that names it ─────────────
type WrapFwd = { f: FlagFwd }
type FlagFwd = boolean

// ── back: the identical declarations, in the order that always worked ─────────
type FlagBack = boolean
type WrapBack = { f: FlagBack }

function go() {
  const fwd: WrapFwd = { f: true }
  const back: WrapBack = { f: true }

  // print at the TRUE runtime input — the silently-wrong cell: `1` vs `true`.
  print(fwd.f)
  print(back.f)

  // print at the FALSE runtime input — `0` vs `false`, the same cell's other input.
  const fwdF: WrapFwd = { f: false }
  const backF: WrapBack = { f: false }
  print(fwdF.f)
  print(backF.f)

  // truthiness and `==`: correct on both spellings before and after.
  if fwd.f { print("T") } else { print("F") }
  if back.f { print("T") } else { print("F") }
  print(fwd.f == true)
  print(back.f == true)
}

go()
