// @run
// @log 4
// @log s
// @log 4
// @log 4
// An un-annotated function reading a field its record-union argument's members share returns
// the join of their field types, as a receiver written at that union reads it.
type K = { h: i32 }
type J = { h: string, z: i32 }
const k: K = { h: 4 }
const u: K | J = k
const w: K | J = { h: "s", z: 1 }
function ret(a) { return a.h }
function wrap(x) { return x }
function show(v: i32 | string) { print(v) }
const r = ret(u)
show(ret(u))
show(ret(w))
show(wrap(r))
const o = { f: r }
show(o.f)
