// @run
// @log 7
// @log 0
// @log 5
// @log 0
// @log 1.5
// @log 0
// @log 9
// @log 0
// THE LOUD HALF of `types/nullable-alias-unparenthesized.vl`: for a NUMERIC inner, an
// un-parenthesized `type T = i32 | null` did not build an invalid module — it failed the
// CHECKER, at `print of a union value (i32 | null) … narrow it first`, because the
// `!= null` narrow peels a `TyNullable` and cannot see a `null` SIBLING VARIANT
// (`nonNullTy`). The rendered type in that message is the whole tell: the parenthesized
// declaration and the inline annotation both read `i32?`.
//
// Split from its sibling so neither failure class masks the other — a check reject is
// raised before any module is built, so a fixture carrying both inners reddens on the
// numeric one alone and says nothing about the silent class.
//
// The `(i32)`-parenthesized MEMBER spelling is the same two-variant declaration (the parens
// wrap the member, not the union), so it fails with its sibling and is pinned beside it;
// `(i32 | null)` is the one-variant control that always worked.

type TI = i32 | null
type TIP = (i32) | null
type TIA = (i32 | null)

type TF = f64 | null
type TFP = (f64) | null

function takesI(v: TI) {
  if v != null { print(v) } else { print(0) }
}
function takesIP(v: TIP) {
  if v != null { print(v) } else { print(0) }
}
function takesIA(v: TIA) {
  if v != null { print(v) } else { print(0) }
}
function takesF(v: TF) {
  if v != null { print(v) } else { print(0) }
}

takesI(7)
takesIP(null)
takesIA(5)
takesI(null)
takesF(1.5)
takesF(null)

const gi: TI = 9
const gf: TFP = null

if gi != null { print(gi) } else { print(0) }
if gf != null { print(gf) } else { print(0) }
