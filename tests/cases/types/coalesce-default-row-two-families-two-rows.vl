// @run
// @log 7
// @log s
// @log 4
// @log 11
// @log 12
// @info `a` is never reassigned; use `const` instead of `let`
// @info `b` is never reassigned; use `const` instead of `let`
// @hint redundant type annotation: `q` is inferred as `{r: i32}` — remove it to lean on inference
// @hint redundant type annotation: `bx` is inferred as `{inner: {r: i32}}` — remove it to lean on inference
// CONTRACT (must-RUN, D881): TWO `??` families over ONE field set, beside TWO competing rows.
//
// `anonLeafSupersede` is ONE SLOT PER NARROW ROW, and `collectAnonShapes` records the CARRIER
// supersede (`coalesce-default-row-two-competing-rows.vl`, D873) only where the literal's own
// mint actually APPENDED a row. A second family over the same field set finds the merged row
// already standing, so `anonLeafMergeField` takes its serving-row branch, nothing mints, and
// the post-mint rung never runs — leaving that family's carrier pointing at a row nobody
// merged. The branch records the carrier's supersede too.
//
// TWO COMPETING ROWS ARE WHAT MAKE IT VISIBLE. With one row per field set the carrier IS the
// literal's row and the serving branch's existing line already covered it; `type R` beside
// `Box`'s instantiated inline `{r: i32}` is what parts them. At the counters, before: the
// annotation family's literal reports `nar=3 mf=[] car=2` while row 2 (`R`) reports `sup=2` —
// the merged row 3 minted, the carrier never told.
//
// FOUR INGREDIENTS AND EVERY ONE-OUT CONTROL RAN ALREADY (`distilled/named/d874_ctl_*`): a
// CALL-carried family, an ANNOTATION-ONLY family, `type R`, and `Box`'s inline shape. Only the
// conjunction reproduced, which is why the row was filed rather than folded into D873.

type Box = { inner: { r: i32 } }

type R = { r: i32 }

// ---- family 1: the left operand is a CALL (D871's delivery form) ----
function src(): { r: i32 } | null { { r: 7 } }

function rd() {
  const g1 = src() ?? { r: "s" }
  const v = g1.r
  if v is i32 { print(v) } else { print(0) }
}
rd() // 7

// ---- family 2: annotation-only, and the one the carrier supersede was losing ----
function ra() {
  let a: { r: i32 } | null = null
  const g1 = a ?? { r: "s" }
  print(g1.r)
}
ra() // s

// ---- family 2 again with a non-null left operand, so both legs of the niche are read ----
function rb() {
  let b: { r: i32 } | null = { r: 4 }
  const g2 = b ?? { r: "t" }
  const v = g2.r
  if v is i32 { print(v) } else { print(0) }
}
rb() // 4

// ---- and both competing rows still resolve narrowly for destinations of their own ----
function rc() {
  const q: R = { r: 11 }
  print(q.r)
  const bx: Box = { inner: { r: 12 } }
  print(bx.inner.r)
}
rc() // 11, 12
