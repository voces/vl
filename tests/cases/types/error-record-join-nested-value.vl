// @emit-error emitProgram: this branch hands over a record whose field types differ from the record the branches join to
// A record VALUE nested in a literal arm's field is held to the same rule as one at the top of
// the arm (D2765): the literal is built at the join's row, whose field holds a wider record.
function go(sel: i32) {
  const a: { f: i32 } = { f: 1 }
  const w = if sel == 0 { { h: a } } else { { h: { f: "s" } } }
  print(w.h.f)
}
go(0)
