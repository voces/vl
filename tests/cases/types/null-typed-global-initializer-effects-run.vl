// @run
// @log ffghghf
// @log 223
// @log true true true true
// @log 3 3
// @log true true
// A `null`-typed module global's initializer runs every effect legacy runs, in order: a call is its
// own value, and `a ?? b` runs `a` for effect then `b`, along a chain too.
let trace = ""
let sum = 0
function f() {
  trace = trace + "f"
  sum = sum + 1
  return null
}
function g() {
  trace = trace + "g"
  sum = sum + 10
  return null
}
function h() {
  trace = trace + "h"
  sum = sum + 100
  return null
}
const viaCall = f()
const viaCoal = f() ?? g()
const viaCoalNull = h() ?? null
const viaCoal3 = g() ?? h() ?? f()
print(trace)
print(sum)
print(
  "\{viaCall == null} \{viaCoal == null} \{viaCoalNull == null} \{viaCoal3 == null}",
)
let k = 0
let marks = ""
function nul() {
  k = k + 1
  marks = marks + "x"
  return null
}
const e1 = nul() ?? nul()
const e2 = (nul())
print("\{k} \{marks.length}")
print("\{e1 == null} \{e2 == null}")
