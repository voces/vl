// @check
// @error unknown type '{foo:string}|{[string]:nope}'
// CONTRACT (must-error): an UNRESOLVED MAP VALUE type is reported. `mkMapTy(string, -1)`
// is indistinguishable from the empty-`Map()` inference hole, so the annotation read as
// "value type not yet known" rather than "no such type": the checker accepted it and the
// emitter produced a module that fails to parse as WebAssembly.
function f(): {foo: string} | {[string]: nope} { return { foo: "a" } }
print(0)
print(f)
