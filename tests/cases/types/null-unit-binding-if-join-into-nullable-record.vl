// A value `if` joining a `null`-typed binding with a record, delivered as `T | null` at a binding,
// an argument, a record field and a `return`, the binding global or local and on either side, the
// record arm a literal, a record binding, a call, a field read or a nested `if` (D17124). Each
// prints `== null` for the binding's arm, then the record's. The argument at a union parameter
// is D17130's, and so is every read of the join's own type.
type In = { v: i32 }
type A = { a: i32 }
type B = { b: string }
type H = { p: In | null }
const n = null
const rec: In = { v: 9 }
const hold: H = { p: { v: 9 } }
function mkIn(): In { return { v: 9 } }
function isN(x: In | null) { return x == null }
function c1(f: boolean) {
  const a: In | null = if f { n } else { { v: 9 } }
  return a == null
}
function c2(f: boolean) {
  let a: In | null = if f { n } else { { v: 9 } }
  if a == null { a = null }
  return a == null
}
function c3(f: boolean) { return isN(if f { n } else { { v: 9 } }) }
function c4(f: boolean) {
  const h: H = { p: if f { n } else { { v: 9 } } }
  return h.p == null
}
function c5r(f: boolean): In | null { return if f { n } else { { v: 9 } } }
function c5(f: boolean) { return isN(c5r(f)) }
function c6(f: boolean) {
  const a: In | null = if f { { v: 9 } } else { n }
  return a == null
}
function c7(f: boolean) {
  let a: In | null = if f { { v: 9 } } else { n }
  if a == null { a = null }
  return a == null
}
function c8(f: boolean) { return isN(if f { { v: 9 } } else { n }) }
function c9(f: boolean) {
  const h: H = { p: if f { { v: 9 } } else { n } }
  return h.p == null
}
function c10r(f: boolean): In | null { return if f { { v: 9 } } else { n } }
function c10(f: boolean) { return isN(c10r(f)) }
function c11(f: boolean) {
  const n = null
  const a: In | null = if f { n } else { { v: 9 } }
  return a == null
}
