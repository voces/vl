  const n = null
  let a: In | null = if f { { v: 9 } } else { n }
  if a == null { a = null }
  return a == null
}
function c18(f: boolean) {
  const n = null
  return isN(if f { { v: 9 } } else { n })
}
function c19(f: boolean) {
  const n = null
  const h: H = { p: if f { { v: 9 } } else { n } }
  return h.p == null
}
function c20r(f: boolean): In | null {
  const n = null
  return if f { { v: 9 } } else { n }
}
function c20(f: boolean) { return isN(c20r(f)) }
function c21(f: boolean) {
  const a: In | null = if f { n } else { rec }
  return a == null
}
function c22(f: boolean) { return isN(if f { n } else { rec }) }
function c23(f: boolean) {
  const a: In | null = if f { rec } else { n }
  return a == null
}
function c24(f: boolean) { return isN(if f { rec } else { n }) }
function c25(f: boolean) {
  const a: In | null = if f { n } else { mkIn() }
  return a == null
}
function c26(f: boolean) { return isN(if f { n } else { mkIn() }) }
function c27(f: boolean) {
  const a: In | null = if f { mkIn() } else { n }
  return a == null
}
function c28(f: boolean) { return isN(if f { mkIn() } else { n }) }
function c29(f: boolean) {
  const a: In | null = if f { n } else { hold.p }
  return a == null
}
function c30(f: boolean) { return isN(if f { n } else { hold.p }) }
function c31(f: boolean) {
  const a: In | null = if f { hold.p } else { n }
  return a == null
}
function c32(f: boolean) { return isN(if f { hold.p } else { n }) }
function c33(f: boolean) {
  const a: In | null = if f { n } else { if f { rec } else { mkIn() } }
  return a == null
}
function c34(f: boolean) {
  return isN(if f { n } else { if f { rec } else { mkIn() } })
}
function c35(f: boolean) {
  const a: In | null = if f { if f { rec } else { mkIn() } } else { n }
  return a == null
}
function c36(f: boolean) {
  return isN(if f { if f { rec } else { mkIn() } } else { n })
}
function c37(f: boolean) {
  const a: A | B | null = if f { n } else { { a: 1 } }
  return a == null
}
function c38(f: boolean) {
  const a: A | B | null = if f { { a: 1 } } else { n }
  return a == null
}
