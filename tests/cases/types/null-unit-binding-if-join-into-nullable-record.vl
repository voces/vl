  const n = null
  return if f { n } else { { v: 9 } }
}
function c15(f: boolean) { return isN(c15r(f)) }
function c16(f: boolean) {
  const n = null
  const a: In | null = if f { { v: 9 } } else { n }
  return a == null
}
