// @run
// @log 9
// @log 7
// @log 8
// @log 7
// @log 6
// @log 7
// @log 4
// @log 7
// @log true
// @log 7
// A `??` MERGE THAT MOVED A FUNCTION'S ROWS, DELIVERED THROUGH A CONTAINER. D1090 closed
// every position where the value's identity is knowable from a binding, a parameter, a
// global or a return; these are the four where it is knowable only from a CONTAINER read —
// a struct FIELD, an array ELEMENT, an array of STRUCTS, and the value a CALL hands back.
//
// TWO HALVES PER POSITION, and neither alone is enough (D1100). The GATE
// (`anonLeafCalleeIsFnValue`) has to stop reading the callee as an unattributable indirect
// call, or the family never mints and the default literal lands in the PRE-merge row; and
// the DELIVERY has to be wired, or the call keys the annotation's `$fnsig` and the `??`
// binds its local at the declaration's row. Admitting the gate first turns one invalid
// module into a differently invalid one.
//
// EACH CELL CARRIES ITS OWN MERGE, in its own frame: the merge is what moves the row, and a
// cell that borrowed a sibling's would not be testing its own delivery. Every cell reads a
// value the `??`'s default could not produce, so a merge that silently kept the narrow row
// prints the default instead of the value.
//
// THE CONTAINER BINDINGS CARRY DISTINCT NAMES ON PURPOSE. The gate's resolver runs in the
// collect pass, where there is no scope to key on, so it answers per NAME and requires every
// binding of that name to deliver the SAME function — D1090's rule for a callback parameter,
// one holder over. Two same-named bindings holding DIFFERENT containers answer "" and the
// whole family declines, which is the safe direction and is why a fixture that reused `a`
// for both the closure array and the array of holders pinned nothing.
function src(p: {r: i32}): {r: i32} | null {
  p
}

function pick(): ({r: i32}) => {r: i32} | null {
  src
}

// A struct FIELD holding the function, called through it.
function viaField() {
  const o = { f: src }
  const v = o.f({ r: 9 }) ?? { r: 0 }
  print(v.r)
  const g = src({ r: 7 }) ?? { r: "s" }
  print(g.r)
}

// An array ELEMENT.
function viaElem() {
  const fns = [src]
  const v = fns[0]({ r: 8 }) ?? { r: 0 }
  print(v.r)
  const g = src({ r: 7 }) ?? { r: "s" }
  print(g.r)
}

// An array of STRUCTS: the receiver of the field read is itself an index.
function viaArrStruct() {
  const holders = [{ f: src }]
  const v = holders[0].f({ r: 6 }) ?? { r: 0 }
  print(v.r)
  const g = src({ r: 7 }) ?? { r: "s" }
  print(g.r)
}

// The value a CALL hands back, invoked directly.
function viaRetCall() {
  const v = pick()({ r: 4 }) ?? { r: 0 }
  print(v.r)
  const g = src({ r: 7 }) ?? { r: "s" }
  print(g.r)
}

// THE FIELD CALL WHOSE RESULT IS NOT THE `??`'s LEFT OPERAND — the cell that separates the
// gate from the delivery, since only the gate stands between it and running.
function viaFieldBeside() {
  const o = { f: src }
  print(o.f({ r: 3 }) != null)
  const g = src({ r: 7 }) ?? { r: "s" }
  print(g.r)
}

viaField()
viaElem()
viaArrStruct()
viaRetCall()
viaFieldBeside()
