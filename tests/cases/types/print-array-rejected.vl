// @check
// @error print expects one scalar or string value (i32 | i64 | f32 | f64 | boolean | string), got i32[] — print the elements or fields individually, e.g. `print(xs[0])`
// @error print expects one scalar or string value (i32 | i64 | f32 | f64 | boolean | string), got i32 | i32[] — print the elements or fields individually, e.g. `print(xs[0])`
// @error print expects one scalar or string value (i32 | i64 | f32 | f64 | boolean | string), got i32 | string[] — print the elements or fields individually, e.g. `print(xs[0])`
// CONTRACT (must-error): `print(<array>)` was SILENT invalid wasm — `vl check` reported
// the program clean and the emitted module failed to VALIDATE ("expected i32, found
// (ref $type)"), because the emitter's print ladder is a run of positive scalar tests
// ending in an unguarded `call __print_i32__`. An array's rep is a WasmGC reference, so it
// reached that arm and was handed to an `(i32) -> ()` import. Now a DOMAIN rejection —
// a plain type error with NO `unsupported-lowering` code, because `print` takes one value
// of `(i32 | i64 | f32 | f64 | boolean | string)` and an array is not one of them. That is
// a narrower claim than the boxed-union arm beside it (`types/print-union-runs.vl`), whose
// arms ARE in the domain — which is why that one is not a rule at all and now RUNS (D712).
// The ruling and its measurement are `silent-class-inventory` D711.
//
// A CONTAINER ARM INSIDE A UNION IS THIS RULE TOO, and it used to say otherwise: `i32 |
// i32[]` reached the CAPABILITY channel and conceded "not yet supported by codegen", while
// `i32 | (() => i32)` — the same rule, one arm over — printed this sentence. The split was
// an accident of whether the box ABI gives the arm an atom code, not a difference in the
// language. The domain question is asked FIRST now, so both read alike; the cells are
// below.
// `types/print-scalar-boundary-controls.vl` is the FALSE side — every read OUT of a
// reference is a scalar again and still prints.
const xs = [1, 2, 3]
print(xs)

// The union with a CONTAINER arm. Every value here is inside a box the emitter builds and
// every one of these unions has a printable arm too — and that is exactly the point: one
// un-renderable arm is enough, because `print` has to answer for the value it is HANDED.
function pickL(c: boolean): i32 | i32[] {
  if c { return 1 }
  return [1, 2]
}
function goL() { print(pickL(true)) }
goL()

function pickS(c: boolean): i32 | string[] {
  if c { return 1 }
  return ["a"]
}
function goS() { print(pickS(true)) }
goS()
