// @run
// @log 0
// @log 1
// @log 0
// @warning `xs != null` is always true here (xs is S[])
// @warning `v != null` is always true here (v is S[])
// A null test of a value whose type admits no `null` is dead: a warning that names the type,
// and a constant in the emitted code (owner ruling 2026-09-26, DECISIONS.md). Declared `S[]`,
// nothing about `xs` can be null, so `xs != null` is always true and the arm runs.
//
// The scope lifetime of the assignment narrowing's bank still holds: `narrowed`'s `v` is
// assignment-narrowed and its null test is a real question; `sibling` declares a DIFFERENT `v`
// that is never null, and its guard must be the dead-test warning, not the narrowed name's
// silence. Without the unwind the bank leaks across the sibling scopes.
type S = { n: i32 }

const xs: S[] = []
if xs != null { print(xs.length) }

function narrowed() {
  let v: S | null = null
  v = { n: 1 }
  print(v.n)
}

function sibling() {
  const v: S[] = []
  if v != null { print(0) }
}

narrowed()
sibling()
