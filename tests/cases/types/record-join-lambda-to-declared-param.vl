// @run
// @log 1
// @log s
// A function value whose un-annotated result joins records with a record-valued field runs when
// the callee declares the parameter's type: the join is built at that declared row (D2765).
type O = { o: { f: i32 | string } }
function ap(g: () => O): O { g() }
function go(sel: i32) {
  const r = ap(() => if sel == 0 { { o: { f: 1 } } } else { { o: { f: "s" } } })
  print(r.o.f)
}
go(0)
go(1)
