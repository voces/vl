// @check
// @error cannot compare {n: i32}[] with null
// @error cannot compare {n: i32}[] with null
// THE DELIBERATE NON-WIDENING, AND THE SIDECAR'S SCOPE LIFETIME. Two decisions,
// one file, because both are "the null test stays an error HERE".
//
// `assign-narrow-then-null-guard.vl` makes `if xs != null` legal after an
// assignment narrowed `xs` away from its declared `S[] | null`. The rule that used
// to reject it — a null test against a non-nullable type is an ERROR, not a
// warning-plus-true — is NOT what was wrong, and it still fires below, where the
// bindings are declared `S[]` and NOTHING about them can ever be null. A guard that
// can never be false is worth naming.
//
// The exact difference between the two files is whether the operand's DECLARED type
// admits null. Relaxing the rule to "any non-nullable operand" instead would have
// been the wrong repair twice over: it would not have fixed the null WRITE half of
// the same defect at all, and reaching it would have required making `null`
// assignable to a non-nullable type, which is a soundness hole rather than a
// diagnostic change.
type S = { n: i32 }

const xs: S[] = []
if xs != null { print(xs[0].n) }

// THE SCOPE LIFETIME. The banked declared types unwind with `popScope`, exactly as
// the narrowings they shadow do. `narrowed`'s `v` is assignment-narrowed; `sibling`
// declares a DIFFERENT `v` that is not nullable at all, and its guard must still be
// the error above. Without the unwind the bank leaks across the sibling scopes, the
// second guard is silently accepted, and the file compiles clean and dies in the
// emitter instead — 0 of 1,508 corpus files tell the two apart.
function narrowed() {
  let v: S | null = null
  v = { n: 1 }
  print(v.n)
}

function sibling() {
  const v: S[] = []
  if v != null { print(0) }
}

narrowed()
sibling()
