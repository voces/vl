// @check
// @error-at 8:5 Type `N` is a member of itself — a type can refer to itself only inside a list, a map, a record field or a function
// @error-at 9:5 Type `U` is a member of itself — a type can refer to itself only inside a list, a map, a record field or a function
// @error-at 10:5 Type `A` is a member of itself — a type can refer to itself only inside a list, a map, a record field or a function
// @error-at 11:5 Type `B` is a member of itself — a type can refer to itself only inside a list, a map, a record field or a function
// A union alias whose member is itself, directly or through another union's bare member, would
// contain itself, so it is refused at its declaration (D16733: each of these exhausted the
// compiler's call stack). A self-reference inside a record field, a list or a map still runs.
type N = N | null
type U = U | i32
type A = B | null
type B = A | null
type T = { v: i32, next: T | null }
type J = i32 | string | J[]
