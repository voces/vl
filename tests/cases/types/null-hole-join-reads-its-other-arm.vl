// @run
// @warning this `??` default is never used: `In` is never null — drop the `??` and its default
// @warning this `??` default is never used: `i32` is never null — drop the `??` and its default
// @warning `the value == null` is always false here (the value is In)
// @log false true
// @log false true
// @log 9 -1
// @log false true
// @log 9
// @log false
// @log true 3
// @log false 3
// @log true true
// A value `if` joining an inferred-null binding (`const n = null`) with a record is `In | null`, so
// every reader of the join sees the record arm: `== null` in either arm order, `?.`, an
// un-annotated binding, a `??` either way round, a binding filled later, and two such bindings.
type In = { v: i32 }
const rec: In = { v: 9 }
const n = null
function eqThen(f: boolean) { return (if f { rec } else { n }) == null }
function eqElse(f: boolean) { return (if f { n } else { rec }) == null }
function opt(f: boolean) { return (if f { rec } else { n })?.v ?? -1 }
function bound(f: boolean) {
  const a = if f { rec } else { n }
  return a == null
}
function left() { return (n ?? rec).v }
function right() { return rec ?? n }
function fillLater(f: boolean) {
  let m = null
  const j = if f { m } else { rec }
  m = { v: 3 }
  return "\{j == null} \{m?.v ?? -1}"
}
const n1 = null
const n2 = null
function twoHoles(f: boolean) {
  const x = if f { n1 } else { n2 }
  return x == null
}
print("\{eqThen(true)} \{eqThen(false)}")
print("\{eqElse(false)} \{eqElse(true)}")
print("\{opt(true)} \{opt(false)}")
print("\{bound(true)} \{bound(false)}")
print(left())
print(right() == null)
print(fillLater(true))
print(fillLater(false))
print("\{twoHoles(true)} \{twoHoles(false)}")
