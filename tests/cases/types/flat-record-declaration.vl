// @run
// @log 24
// @log 0
// @log 4
// @log 16
// @log 12
// @log 16
// @log 0
// @log 4
// @log 12
// @log 3
// @log 3
// @log 3
// @log 7
// @hint redundant type annotation: `w` is inferred as `{a: i32, b: i64}`
// @hint redundant type annotation: `one` is inferred as `{a: i32, b: i64}`
// @hint redundant type annotation: `nest` is inferred as `{x: i32, k: Inner, y: f64}`
// @hint redundant type annotation: `many` is inferred as `Inner[]`
// A `flat type` is an ORDINARY record that has additionally been VALIDATED and
// MEASURED (webcraft P1.2, `docs/internals/flat-records-design.md`).
//
// That is the ruling this file pins, and it is what keeps the feature small:
// **`flat` ADDS validation and layout constants; it SUBTRACTS nothing.** A flat
// type is still usable as a struct literal, a parameter, a return type, a nested
// field and an array element — and it emits BYTE-IDENTICALLY to the same
// declaration with `flat` deleted, because the marker is read by one consumer (the
// checker's declaration pass) and the constants are folded to literals before the
// emitter runs. No file in `emit_*.vl` or `wasmEmit.vl` knows this feature exists.
//
// The alternative — `flat` marks a layout descriptor that cannot be a value — was
// rejected: it would make a new kind of declaration that four emitter dispatch
// sites must learn, forbid the perfectly reasonable staging struct below, and buy
// nothing, since nothing is unsound about a flat type also being a GC struct.

// NESTED flat records INLINE, and their sizes resolve in dependency order — note
// `Outer` is declared BEFORE the `Inner` it contains, so the resolver is a
// fixpoint over the declaration list rather than a single forward pass. Only
// acyclicity matters, not source order.
flat type Outer = { x: i32, k: Inner, y: f64 }
flat type Inner = { a: i32, b: i64 }
print(Outer.size) // 4 + 12 + 8
print(Outer.x)
print(Outer.k)
print(Outer.y)
print(Inner.size) // 4 + 8, no padding
print(Inner.b - Inner.a + 12)

// A NEWTYPE over a scalar is a flat field, at its base's width, and this costs the
// feature NO code: a brand is a second index over the same `Ty` payload, so
// `is TyPrim` answers exactly as the base answers (`newtype-design.md` §3.1).
// P1.5's representation choice paying a feature it was not designed for.
type EntityId = new i32
type Ticks = new i64
flat type Slot = { id: EntityId, when: Ticks, hp: i32 }
print(Slot.id)
print(Slot.when)
print(Slot.hp)

// ── and it is still an ordinary record ──────────────────────────────────────
function bump(v: Inner): Inner {
  const w: Inner = { a: v.a + 1, b: v.b }
  return w
}
const one: Inner = { a: 2, b: 9 as i64 }
const two = bump(one)
print(two.a)                                  // parameter + return + literal
const nest: Outer = { x: 0, k: two, y: 1.5 }
print(nest.k.a)                               // nested field read
const many: Inner[] = [one, two]
print(many[1].a)                              // array element
print(Slot.size - 9)                          // 16 - 9
