// @run
// @hint redundant type annotation: `m` is inferred as `{a: i32}`
// @hint redundant type annotation: `s` is inferred as `{a: i32}`
// @log 3
// @log 5
// D1582's control. `Map`/`Set` are not reserved words — `emit_base.isBuiltinFnName`
// already grants a program the freedom to declare its own `Map`, and the type side has
// to match. So the "not a type name" hint is reached only AFTER the declared-name rung
// misses. Both doors are pinned: the leaf ladder (a bare `Map`) and the generic-alias
// application (`Set<i32>`), which is where the `Map<string, i32>` spelling enters. The
// annotations are load-bearing — they ARE the type position under test — so the
// redundancy hints are declared rather than removed.
type Map = { a: i32 }
type Set<T> = { a: T }

const m: Map = { a: 3 }
print(m.a)

const s: Set<i32> = { a: 5 }
print(s.a)
