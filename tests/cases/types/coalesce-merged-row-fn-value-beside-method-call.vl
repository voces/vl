// @run
// @log 1
// @log true
// @log 7
// A `??` merge that moves `src`'s rows, a function VALUE (`const h = src`), and ONE ordinary
// method call on a list. The method call is the whole ingredient: without `xs.push(1)` this
// program ran, with it the merge was refused and the default literal `{r: "s"}` landed in the
// PRE-MERGE `{r: i32}` row — a string ref into an i32 slot, `vl check` rc 0 and invalid wasm.
//
// `anonLeafAnyIndirectCall` asks "could any call here go through a function VALUE", and its
// non-`Ident` arm answered YES for every `Member` callee — so a built-in method, whose target
// is as knowable as a named call's, vetoed the whole family. A LIST / MAP / PRIMITIVE receiver
// is now admitted; a STRUCT receiver (a closure-typed field) keeps the veto, which is D1100's
// own cell and must stay refused. D1401.
function src(p: {r: i32}): {r: i32} | null {
  p
}
function rd() {
  const h = src
  const xs: i32[] = []
  xs.push(1)
  print(xs.length)
  print(h({ r: 3 }) != null)
  const g1 = src({ r: 7 }) ?? { r: "s" }
  print(g1.r)
}
rd()
