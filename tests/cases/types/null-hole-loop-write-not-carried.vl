// @run
// @warning Unreachable code: this can never execute
// @log n v
// @log -1 9
// @log nn vv
// @log nv vv
// @log nv vv
// @log nv vv
// @log nv vv
// @log nv vv
// @log n v
// @log n v
// A loop's write to an inferred-null binding `let m = null` ends the `null` its read at the loop's
// top is narrowed to only where the back edge carries it (D17207): not before a `break` or
// `return`, nor where no pass reaches it; a conditional `break`, a `continue` to an enclosing loop
// and a `break` leaving only an inner loop still carry it.
type In = { v: i32 }
type Out = { w: string, k: i32 }
const rec: In = { v: 9 }
function breakAfterWrite(f: boolean) {
  let m = null
  let out = ""
  while true {
    const j = if f { m } else { rec }
    out = out + (if j == null { "n" } else { "v" })
    m = { w: "z", k: 4 }
    break
  }
  return out
}
function optAfterWrite(f: boolean) {
  let m = null
  let out = -1
  while true {
    const j = if f { m } else { rec }
    out = j?.v ?? -1
    m = { w: "z", k: 4 }
    break
  }
  return out
}
function unreachedWrite(f: boolean) {
  let m = null
  let out = ""
  let i = 0
  while i < 2 {
    const j = if f { m } else { rec }
    out = out + (if j == null { "n" } else { "v" })
    i = i + 1
    if i == 1 { continue }
    break
    m = { w: "z", k: 4 }
  }
  return out
}
function conditionalBreak(f: boolean) {
  let m = null
  let out = ""
  let i = 0
  while i < 2 {
    const j: In | Out | null = if f { m } else { rec }
    out = out + (if j == null { "n" } else { "v" })
    m = { w: "z", k: 4 }
    if i == 5 { break }
    i = i + 1
  }
  return out
}
function continueOuter(f: boolean) {
  let m = null
  let out = ""
  let i = 0
  @outer while i < 2 {
    const j: In | Out | null = if f { m } else { rec }
    out = out + (if j == null { "n" } else { "v" })
    i = i + 1
    while true {
      m = { w: "z", k: 4 }
      continue @outer
    }
  }
  return out
}
function continueOuterDirect(f: boolean) {
  let m = null
  let out = ""
  let i = 0
  @outer while i < 2 {
    const j: In | Out | null = if f { m } else { rec }
    out = out + (if j == null { "n" } else { "v" })
    i = i + 1
    m = { w: "z", k: 4 }
    continue @outer
  }
  return out
}
function breakInner(f: boolean) {
  let m = null
  let out = ""
  let i = 0
  while i < 2 {
    const j: In | Out | null = if f { m } else { rec }
    out = out + (if j == null { "n" } else { "v" })
    i = i + 1
    while true {
      m = { w: "z", k: 4 }
      break
    }
  }
  return out
}
function breakInnerLabelled(f: boolean) {
  let m = null
  let out = ""
  let i = 0
  while i < 2 {
    const j: In | Out | null = if f { m } else { rec }
    out = out + (if j == null { "n" } else { "v" })
    i = i + 1
    @inner while true {
      m = { w: "z", k: 4 }
      break @inner
    }
  }
  return out
}
function breakOuterLabelled(f: boolean) {
  let m = null
  let out = ""
  let i = 0
  @outer while i < 2 {
    const j: In | Out | null = if f { m } else { rec }
    out = out + (if j == null { "n" } else { "v" })
    i = i + 1
    while true {
      m = { w: "z", k: 4 }
      break @outer
    }
  }
  return out
}
function returnAfterWrite(f: boolean) {
  let m = null
  let out = ""
  while out.length < 2 {
    const j: In | Out | null = if f { m } else { rec }
    out = out + (if j == null { "n" } else { "v" })
    m = { w: "z", k: 4 }
    return out
  }
  return out
}
print("\{breakAfterWrite(true)} \{breakAfterWrite(false)}")
print("\{optAfterWrite(true)} \{optAfterWrite(false)}")
print("\{unreachedWrite(true)} \{unreachedWrite(false)}")
print("\{conditionalBreak(true)} \{conditionalBreak(false)}")
print("\{continueOuter(true)} \{continueOuter(false)}")
print("\{continueOuterDirect(true)} \{continueOuterDirect(false)}")
print("\{breakInner(true)} \{breakInner(false)}")
print("\{breakInnerLabelled(true)} \{breakInnerLabelled(false)}")
print("\{breakOuterLabelled(true)} \{breakOuterLabelled(false)}")
print("\{returnAfterWrite(true)} \{returnAfterWrite(false)}")
