// @run
// @log 1
// @log 2
// @log 13
// @log v=3
// @log true
// @log 14
// @log 56
// @log 7
// @log 8.5
// @log 9
// @log dflt
// @log 10
// @log 3
// `x ?? d` over an inferred-null hole read before the assignment that fills it, at each delivery
// position: the operand is the box at its storage, its tag tested, and the default runs only
// on the null arm.
function show(n: i32) { print(n) }
function back(n: i32): i32 { return n + 10 }
type Pt = { a: i32 }
let calls = 0
function dflt(n: i32): i32 {
  calls = calls + 1
  return n
}

function positions(c: boolean) {
  let x = null
  const k = x ?? 1
  print(k)
  show(x ?? 2)
  print(back(x ?? 3))
  print("v=\{x ?? 3}")
  print((x ?? 4) == 4)
  print(10 + (x ?? 4))
  const xs = [x ?? 5, 6]
  print(xs[0] * 10 + xs[1])
  const p: Pt = { a: x ?? 7 }
  print(p.a)
  let y = null
  print(y ?? 8.5)
  if c { x = 0 }
  if c { y = 0.5 }
}

function returned(c: boolean): i32 {
  let x = null
  const r = x ?? 9
  if c { x = 1 }
  return r
}

function lazy(c: boolean) {
  let x = null
  print(x ?? dflt(10))
  if c { x = 1 }
}

positions(true)
print(returned(true))
print("dflt")
lazy(true)
let g = null
print(calls + (g ?? 2))
g = 5
