// @run
// @log 5
// @log 2
// SAME-SHAPE UNION COLLAPSE, at the STRUCT-FIELD annotation slot.
// `A | B` with identical shapes resolves to a PLAIN STRUCT in the type arena —
// `nameToTy`'s union arm dedups the two members (`sameVariantTy`) and the union
// collapses — so the arena register walk never sees a union here and the emitter has
// to drive the registration from the annotation SPELLING (`registerCollapsedUnionName`).
// The count of top-level atoms in that spelling is banked on the annotation node by
// `canonEmitTypeNames` (`annUnionAtomsOf`, #1055) rather than re-split at the consumer.
//
// types/struct-union-same-shape.vl covers the PARAM slot; this covers the struct-FIELD
// slot (`type W = { s: A | B }`) alongside a same-shape union RETURN. With the
// registration suppressed the field has no union rep and the program is a LOUD reject
// ("only i32 / boolean / string / array struct fields are supported"), which is what
// makes this file the entombment pin for that decision.
type A = { tag: i32, v: i32 }
type B = { tag: i32, v: i32 } // identical shape to A
type W = { s: A | B }

function mk(n: i32): A | B {
  if n > 0 { return { tag: 1, v: n } }
  { tag: 2, v: 0 }
}
function useField(w: W) {
  if w.s is B { return w.s.v }
  -1
}
print(useField({ s: mk(5) })) // 5 — a same-shape A IS a B
print(useField({ s: mk(0) }) + 2) // 2 — the else arm's `{tag: 2, v: 0}`
