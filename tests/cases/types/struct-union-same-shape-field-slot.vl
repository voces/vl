// @run
// @log 5
// @log 2
// SAME-SHAPE UNION COLLAPSE, at the STRUCT-FIELD annotation slot.
// `A | B` with identical shapes is one type, the record `A` (D3870): the field holds the
// record itself, with no union box, and `w.s is B` holds for every value of it.
//
// types/struct-union-same-shape.vl covers the PARAM slot; this covers the struct-FIELD
// slot (`type W = { s: A | B }`) alongside a same-shape union RETURN.
type A = { tag: i32, v: i32 }
type B = { tag: i32, v: i32 } // identical shape to A
type W = { s: A | B }

function mk(n: i32): A | B {
  if n > 0 { return { tag: 1, v: n } }
  { tag: 2, v: 0 }
}
function useField(w: W) {
  if w.s is B { return w.s.v }
  -1
}
print(useField({ s: mk(5) })) // 5 — a same-shape A IS a B
print(useField({ s: mk(0) }) + 2) // 2 — the else arm's `{tag: 2, v: 0}`
