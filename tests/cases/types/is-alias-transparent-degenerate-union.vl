// @run
// @log yes
// @log yes
// @log yes
// @log yes
// @log yes
// @log yes
// @log yes
// @log yes
// @log yes
// @log yes
// @log yes
// @log yes
// @log yes
// @log no
// @log yes
// @log yes
// @log no
// @log no

// A `type` alias is TRANSPARENT, so `x is A` over a value of type `A` is TRUE — and so is
// every same-base twin union `A | B`, which the arena collapses to ONE member because
// `sameVariantTy` makes two aliases of one shape the same variant. That is the same rule
// `types/struct-union-same-shape.vl` states for struct shapes, and the struct and
// literal-union spellings already answered it that way; the scalar / array / map spellings
// answered a silent FALSE.
//
// The static `is` fold compared the receiver's CANONICAL type name against the RAW tested
// SPELLING, so an alias never matched the very type it denotes — with no union anywhere in
// the program (`function p(x: A) { if x is A … }` printed `no`). Resolving the tested
// spelling through the type the checker banked at the node is what makes the BASE and ALIAS
// spellings of one program agree, which is what `genericAliasTest` / `genericBaseTest`
// below pin as a pair.
//
// The fold DECLINES a tested type carrying a LITERAL: its emit render softens to the base,
// so `("pp" | "qq")` and `string` render alike while only one of them holds `"zz"`. Those
// shapes belong to the membership lowerings, and `litUnionOverBase` at the bottom is the
// control that they are not folded — its own wrong answer for a MEMBER is a separately
// filed gap, deliberately not pinned here.

type A = i32
type B = i32

function twinUnionIsA(x: A | B) {
  if x is A { print("yes") } else { print("no") }
  0
}
twinUnionIsA(5)

function twinUnionIsB(x: A | B) {
  if x is B { print("yes") } else { print("no") }
  0
}
twinUnionIsB(5)

// No union at all: the alias tested against its own binding.
function bareAliasIsAlias(x: A) {
  if x is A { print("yes") } else { print("no") }
  0
}
bareAliasIsAlias(5)

// The two mixed directions of the same question.
function bareAliasIsBase(x: A) {
  if x is i32 { print("yes") } else { print("no") }
  0
}
bareAliasIsBase(5)

function bareBaseIsAlias(x: i32) {
  if x is A { print("yes") } else { print("no") }
  0
}
bareBaseIsAlias(5)

// An alias beside its own base, and a three-way twin: both collapse to one member.
function aliasBesideBase(x: A | i32) {
  if x is A { print("yes") } else { print("no") }
  0
}
aliasBesideBase(5)

type C = i32

function threeWayTwin(x: A | B | C) {
  if x is C { print("yes") } else { print("no") }
  0
}
threeWayTwin(5)

// The other reps the collapse reaches: every one of these answered `no`.
type SA = string
type SB = string

function stringTwin(x: SA | SB) {
  if x is SA { print("yes") } else { print("no") }
  0
}
stringTwin("hi")

type FA = f64
type FB = f64

function floatTwin(x: FA | FB) {
  if x is FB { print("yes") } else { print("no") }
  0
}
floatTwin(2.5)

type IA = i64
type IB = i64

function longTwin(x: IA | IB) {
  if x is IA { print("yes") } else { print("no") }
  0
}
longTwin(7)

type BA = boolean
type BB = boolean

function boolTwin(x: BA | BB) {
  if x is BB { print("yes") } else { print("no") }
  0
}
boolTwin(true)

type LA = i32[]
type LB = i32[]

function listTwin(x: LA | LB) {
  if x is LA { print("yes") } else { print("no") }
  0
}
listTwin([1, 2])

// A monomorphized generic instance: the alias spelling and the base spelling of ONE program
// must decide the same instances the same way.
function genericAliasTest<T>(v: T) {
  if v is A { print("yes") } else { print("no") }
  0
}
genericAliasTest(5)
genericAliasTest("hi")

function genericBaseTest<T>(v: T) {
  if v is i32 { print("yes") } else { print("no") }
  0
}
genericBaseTest(5)

// Controls. A twin whose arms are genuinely DISTINCT still discriminates by value, and a
// LITERAL-carrying tested type is declined by the fold — `"zz"` is not a member of `K`, and
// `s is K` over a plain `string` receiver stays the constant FALSE it was (a separately
// filed gap, pinned here only so the fold cannot start answering it TRUE by accident).
type D = string

function distinctArms(x: A | D) {
  if x is A { print("yes") } else { print("no") }
  0
}
distinctArms(5)
distinctArms("hi")

type K = "aa" | "bb"

function litUnionOverBase(s: string) {
  if s is K { print("yes") } else { print("no") }
  0
}
litUnionOverBase("zz")
