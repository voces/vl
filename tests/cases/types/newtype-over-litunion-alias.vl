// @run
// @log a
// @log a
// @log a
// @log a
// @log a
// @log a
// @log b
// @log b
// @log b
// @log b
// @log b
// @log b
// @log a
// @log a
// @log a
// @log true
// @log true
// @log a
// @log a!
// @log a
// @log isA
// @log mA
// @log a
// @log a
// @log a
// @log b
// @log b
// @log b
// A NOMINAL NEWTYPE OVER A NAMED LITERAL UNION, and its two oracles on the adjacent
// lines: the un-branded one-member ALIAS (`type A = K`) and the BARE litunion (`K`).
// All three spell one type, so all three must produce one module.
//
// WHY IT IS A FIXTURE. `type K = "a" | "b"` reps as an interned i32 ATOM. A one-member
// alias over it — which is what `type NK = new K` is, the brand being incidental — was
// OPAQUE to `singleAliasMemberTyIx`, so `collectU` minted it a one-variant union ROW and
// `isUName` claimed every `NK`-annotated slot for the `{tag, anyref}` BOX while every
// READ classified from the arena and lowered the atom. The witness was
// `call __print_i32__` on a `global.get` of a `(ref $box)`: INVALID WASM with `vl check`
// rc 0, at EVERY position (global, local, param, return, struct field, list element, map
// value) and for every use (`print`, `==`, `is`, `match`, assignment, argument passing).
//
// The BRAND is what this file adds over `alias-over-litunion-positions.vl`: a newtype is
// erased before codegen (`newtype-design.md` ss3), so the branded and un-branded spellings
// must reach the emitter as the SAME name — and they do, byte for byte.
//
// The non-member `"z"` is NOT here on purpose: it is a checker reject, pinned by
// `newtype-over-litunion-non-member-rejected.vl` so this file can stay a `@run`.

type K = "a" | "b"
type NK = new K
type AK = K

type HoldN = { c: NK }
type HoldA = { c: AK }
type HoldK = { c: K }

function takesN(x: NK) { print(x) }
function takesA(x: AK) { print(x) }
function takesK(x: K) { print(x) }

function mkN(): NK { return "b" }
function mkA(): AK { return "b" }
function mkK(): K { return "b" }

const gN: NK = "a"
const gA: AK = "a"
const gK: K = "a"

const xsN: NK[] = ["a", "b"]
const xsA: AK[] = ["a", "b"]
const xsK: K[] = ["a", "b"]

const mN: {[string]: NK} = Map()
const mA: {[string]: AK} = Map()
const mK: {[string]: K} = Map()

function locals() {
  // A LOCAL, and the atom-vs-string reads off it.
  const lN: NK = "a"
  print(lN)
  print(lN == "a")
  print(lN != "b")
  const sN: string = lN
  print(sN)
  print(lN + "!")
  // An UN-ANNOTATED binding off an atom local stays an atom.
  const iN = lN
  print(iN)
  // `is` and `match` over the members.
  if lN is "a" { print("isA") } else { print("notA") }
  match lN {
    "a" => print("mA")
    _ => print("mOther")
  }
  // A struct FIELD and a MAP value, all three spellings.
  const hN: HoldN = { c: "a" }
  const hA: HoldA = { c: "a" }
  const hK: HoldK = { c: "a" }
  print(hN.c)
  print(hA.c)
  print(hK.c)
  mN["k"] = "b"
  mA["k"] = "b"
  mK["k"] = "b"
  print(mN["k"] ?? "a")
  print(mA["k"] ?? "a")
  print(mK["k"] ?? "a")
}

// The three spellings, one line apart, at the module level.
print(gN)
print(gA)
print(gK)
takesN(gN)
takesA(gA)
takesK(gK)
print(mkN())
print(mkA())
print(mkK())
print(xsN[1])
print(xsA[1])
print(xsK[1])
// A BRANDED value flows into a slot typed by the BASE and back — the erasure, observed.
const backK: K = gN
const backN: NK = gK
print(backK)
print(backN)
locals()
