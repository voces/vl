// @run
// @log 1
// @log s
// @log 5
// @log 2.5
// @log 1
// @log s
// @warning Unused function `mkA` (prefix with `_` to suppress, remove it, or `export` it)
// A join of record literals handed straight to a parameter or a generic is built at the join's
// own row, even where a declared row matches one arm's field names (D2790): the argument's row
// is the join's, not the first arm's, so the arms and the pin name one struct.
function mkA(): { f: i32 } { return { f: 1 } }
function id<T>(x: T): T { x }
function use(r) { print(r.f) }
function go(sel: i32) {
  const r = id(if sel == 0 { { f: 1 } } else { { f: "s" } })
  print(r.f)
}
function widen(sel: i32) { use(if sel == 0 { { f: 5 } } else { { f: 2.5 } }) }
function arg(sel: i32) { use(if sel == 0 { { f: 1 } } else { { f: "s" } }) }
go(0)
go(1)
widen(0)
widen(1)
arg(0)
arg(1)
