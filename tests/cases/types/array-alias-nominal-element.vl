// @run
// @log 1
// @log 7
// @log 7
// @log 1
// @log 9
// @log 2
// @log 5
// @log 3
// @hint redundant type annotation: `c` is inferred as `{n: i32}`
// @hint redundant type annotation: `l` is inferred as `Cat[]`
// @hint redundant type annotation: `c` is inferred as `{r: i32}`
// @hint redundant type annotation: `l` is inferred as `Circle[]`
// @hint redundant type annotation: `h` is inferred as `{xs: {n: i32}[]}`
// The NOMINAL-element half of D-ALIASARR: `type C = Cat[]` denotes `Cat[]`, in every
// position, exactly as `type L = i32[]` denotes `i32[]` (`array-alias-transparent.vl`).
//
// The arm was gated on `arrSpineIsScalar` — an array whose LEAF is a primitive — and that
// gate's own header states what it is a property of: "the exact condition under which
// `tyToEmitName` renders the type name-faithfully". `tyToEmitName` re-renders an array's
// element, so `Cat[]` came out `{n:i32}[]` and the declared name the emitter's element
// tables key on was dropped. The gate protected a real route (`array-alias-nominal-element-
// stays-opaque.vl` pins it) — and it protected it against a RENDERER, not against the
// widening. `tyToNominalName` is that renderer's name-faithful twin, was already written
// and already documented correct, and had no consumer in emitted output at all. Under it
// the member renders `Cat[]`, which is character for character the DIRECT spelling — the
// one that compiles and runs. So the route is kept rather than lost.
//
// WHAT THE GATE COST, on both sides of the alias:
//   * a PLAIN declared-struct element was the LOUD `emitProgram: struct array elements are
//     not supported` where the direct spelling `Cat[]` runs;
//   * a UNION-ARM element was CHECK-CLEAN INVALID WASM (`expected i32, found (ref $type)`
//     — the i32-list catch-all taking a `(ref $uVarHeap[Circle])` element), filed as
//     silent-class-inventory D49;
//   * every READING use through the alias was a checker reject that read as nonsense
//     (`field 'length' is not on every member of C`), the same LID `array-alias-return-
//     unread.vl` describes: remove the read and the silent miscompile is what is left.
// All three are one predicate, because `declaredTyOfName` (the checker) and
// `singleMemberAliasTyIx` (the emitter) read the SAME arm.

type Cat = { n: i32 }
type C = Cat[]

// A PLAIN declared-struct element — the loud `struct array elements are not supported` half.
function mkPlain(i: i32): C {
  const c: Cat = { n: i }
  const l: C = [c]
  return l
}
print(mkPlain(7).length)
print(mkPlain(7)[0].n)

// …and read through the alias in a PARAMETER position, the checker half.
function firstN(xs: C) { return xs[0].n }
print(firstN(mkPlain(7)))
print(firstN([{ n: 1 }]))

// A UNION-ARM element — D49's own witness, whose two annotations are the alias in the
// RESULT position and the alias at the BINDING. Either alone reproduced it.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type CircleList = Circle[]

function mkArm(i: i32): CircleList {
  const c: Circle = { r: i }
  const l: CircleList = [c]
  return l
}
print(mkArm(9)[0].r)

// An ALIAS OF AN ALIAS resolves through the same rung — canon renders the member of the
// inner alias and the outer one is a plain reference to it.
type CircleList2 = CircleList
function mkArm2(i: i32): CircleList2 {
  const c: Circle = { r: i }
  const l: CircleList2 = [c]
  return l
}
print(mkArm2(2)[0].r)

// A NESTED spine (`Cat[][]`) — `arrSpineIsNominal` peels the whole spine, as its scalar
// twin does, so the two-deep alias is not a separate arm.
type CC = Cat[][]
function mkNest(i: i32): CC {
  const c: Cat = { n: i }
  return [[c]]
}
print(mkNest(5)[0][0].n)

// The alias standing as a STRUCT FIELD's type, the position `transparentMemberEmitName`'s
// object arm reaches through a different rung.
type Holder = { xs: C }
const h: Holder = { xs: [{ n: 3 }] }
print(h.xs[0].n)
