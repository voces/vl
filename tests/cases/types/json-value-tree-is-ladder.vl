// @run
// @log hi
// @log 1
// @log 2
// @log ok
// D982 / D985 — THE JSON VALUE TREE'S `is` LADDER. `is` against a self-referential container
// arm was a loud check refusal that printed the arm inside the very union it said the arm was
// not in; `is` against a PLAIN arm of the same union was check-clean invalid wasm, which is
// the one that shipped.
//
// One root, two faces. `type J = null | string | J[]` interns as `TyUnion[ TyNullable(rest) ]`
// — the `null` folded into the niche, the alias left as a ONE-MEMBER wrapper around it. The
// non-recursive spelling `null | string | i32` interns as a BARE `TyNullable` and reaches the
// nullable branch of `nodeTyIsUnionAlias`, which is exactly why that one always worked.
//
// The fix unwraps that wrapper in TWO predicates, and both are required: `nodeTyIsUnionAlias`
// (the LOWERING, via `vtKindOfParam` -> `vtKindOfType` -> `retUnionFlag`) and
// `nodeTyIsUnionish` (the parameter GATE). Fixing only the gate admits the parameter and then
// lowers it as `i32` — check-clean invalid wasm, measured. Fixing only the lowering leaves the
// gate refusing. They have to agree.
type J = null | string | J[]

type Json = null | boolean | f64 | string | Json[] | {[string]: Json}

function plainArm(j: J) {
  if j is string { print(j) } else { print(0) }
}

function containerArm(j: J) {
  if j is J[] { print(1) } else { print(0) }
}

function jsonPlain(j: Json) {
  if j is string { print(j) } else { print(0) }
}

function jsonContainer(j: Json) {
  if j is Json[] { print(2) } else { print(0) }
}

plainArm("hi")

containerArm(["a"])

jsonContainer(["a"])

jsonPlain("ok")
