// @run
// @log id
// @log 7
// @log name
// @log bob
// The INVERTED CONTROL for `newtype-base-union-rejected.vl`: a newtype in a union whose
// other arm has a DIFFERENT runtime representation is a perfectly good type, and both
// arms narrow. The reject fires on the rep COLLISION, not on "a newtype in a union" —
// without this pairing the reject would be unattributable.
//
// `EntityId | string` boxes an i32 arm beside a string arm, so the box tag separates them
// and `is` answers each correctly. The same holds for two newtypes over DIFFERENT bases.
type EntityId = new i32
type Name = new string

function show(u: EntityId | string) {
  if u is EntityId {
    print("id")
    print(u as i32)
  } else {
    print("name")
    print(u)
  }
}

function showN(u: Name | i32) {
  if u is Name {
    print("name")
    print(u)
  } else {
    print("id")
    print(u)
  }
}

show(7 as EntityId)
const nv: Name = "bob"
showN(nv)
