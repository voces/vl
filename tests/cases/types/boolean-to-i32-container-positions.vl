// @run
// @log 1
// @log 0
// @log 1
// @log 1
// @log 1
// @log 0
// @log 1
// @log 1
// @hint redundant type annotation: `elems` is inferred as `i32[]`
// @hint redundant type annotation: `nested` is inferred as `i32[][]`
// @hint redundant type annotation: `rec` is inferred as `{v: i32}`
// The container positions of `b as i32`: an array-literal element at any depth, an
// object-literal field, a push, an index store, a map value, and a `u8` element through
// `b as u8`. Each is the explicit conversion, so every read below is an ordinary number. The
// unconverted value refuses at each of these positions, pinned in
// `boolean-to-i32-container-reject.vl`.

const t = true
const f = false

const elems: i32[] = [t as i32, f as i32]
print(elems[0]) // 1
print(elems[1]) // 0

const nested: i32[][] = [[t as i32]]
print(nested[0][0]) // 1

const rec: { v: i32 } = { v: t as i32 }
print(rec.v) // 1

const xs = [0]
xs.push(t as i32)
print(xs[1]) // 1
xs[0] = f as i32
print(xs[0]) // 0

const m = Map<string, i32>()
m.set("k", t as i32)
print(m["k"] ?? 9) // 1

const bytes: u8[] = [t as u8]
print(bytes[0]) // 1
