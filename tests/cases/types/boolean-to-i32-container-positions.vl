// @run
// @log 1
// @log 0
// @log 1
// @log 1
// @log 1
// @log 0
// The A7 boolean→i32 coercion's REACH. `boolean-to-i32.vl` pins the three scalar
// boundaries (binding, argument, return); the coercion lives at `assignableExpr`,
// which is the seam EVERY binding / argument / return / field / element / store /
// push flows through, so it reaches the container positions here too. They are
// pinned because the reach is the part a reader cannot derive from the scalar
// fixture, and because widening or narrowing it should be a loud edit.
//
// Every accepted position is a boolean-typed VALUE (never a bare `true`/`false`
// literal — that stays rejected everywhere, see `boolean-literal-to-i32-reject.vl`)
// meeting an `i32` slot spelled by the DESTINATION. The lowering is a no-op: a
// boolean already rides in an i32 as 1/0, so every read below is an ordinary i32.
// The positions this does NOT reach — a `boolean[]` VALUE into `i32[]`, an `i32?`
// slot, an `i32 | string` slot — are pinned in
// `boolean-to-i32-container-reject.vl`.

const t = true
const f = false

// ARRAY-LITERAL ELEMENT: the element-wise recursion re-applies the coercion per
// element, so a boolean-typed element fits an `i32[]` destination.
const elems: i32[] = [t, f]
print(elems[0]) // 1
print(elems[1]) // 0

// …and at any nesting depth, because that recursion is depth-agnostic.
const nested: i32[][] = [[t]]
print(nested[0][0]) // 1

// OBJECT-LITERAL FIELD: the field-wise recursion likewise re-applies it.
const rec: { v: i32 } = { v: t }
print(rec.v) // 1

// PUSH (the argument boundary against an array's element type) and INDEX STORE
// (the store boundary against the same).
const xs = [0]
xs.push(t)
print(xs[1]) // 1
xs[0] = f
print(xs[0]) // 0
