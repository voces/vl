// @check
// @error cannot assign string to 'v' of type NK
// THE INVERTED CONTROL for `newtype-over-litunion-alias.vl`: making a newtype over a
// literal union WORK must not cost the union's CLOSED SET. `"z"` is not a member of
// `K`, so it is not a member of `NK` either — the brand narrows the type, it cannot
// widen it.
//
// Without this pairing the transparency arm that fixed the composition would be
// unattributable: an arm that made the annotation transparent by making it MEAN
// `string` would pass the `@run` twin and fail here.
type K = "a" | "b"
type NK = new K
const v: NK = "z"
print(v)
