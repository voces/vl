// @run
// @log 3
// @log 5
// @log z
// @log y
// @log 12
// @log g
// @log 8
// @log n 2
// @hint redundant type annotation: `r` is inferred as `{ty: i32}`
// @hint redundant type annotation: `a` is inferred as `i32`
// @hint redundant type annotation: `b` is inferred as `{v: string}`
// @hint redundant type annotation: `c` is inferred as `{c: T}`
// The hints are part of the assertion: each renders what the block-scoped annotation resolved to.
// D3022 — a body-scoped `type` used as an annotation in a program that imports std (the
// interpolation below is enough). The merge renames the minted `P$b<n>` declaration and every
// reference to it apart from std's own names, and the two renames have to agree on the name.
function local() {
  type R = { ty: i32 }
  const r: R = { ty: 3 }
  print(r.ty)
  type A = i32
  const a: A = 4
  print(a + 1)
  type U = { k: "a", n: i32 } | { k: "b", s: string }
  const u: U = { k: "b", s: "z" }
  if u.k == "b" { print(u.s) }
  type L = "x" | "y"
  const l: L = "y"
  print(l)
  {
    {
      type D = { deep: i32 }
      function twice(d: D): D { return { deep: d.deep * 2 } }
      print(twice({ deep: 6 }).deep)
    }
  }
}
local()
{
  type B<T> = { v: T }
  const b: B<string> = { v: "g" }
  print(b.v)
}
function gen<T>(v: T): T {
  type C = { c: T }
  const c: C = { c: v }
  c.c
}
print(gen(8))
print("n \{2}")
