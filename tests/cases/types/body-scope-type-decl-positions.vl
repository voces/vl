// @run
// @log 3
// @log 3
// @log 7
// @log 7
// @log 12
// @log 12
// @log b
// @log b
// @log 20
// @log 20
// @log 30
// @log 30
// @log 3
// @log 5
// @log inner
// @log mod
// @hint redundant type annotation: `s` is inferred as `{x: i32, y: i32}`
// @hint redundant type annotation: `s` is inferred as `{x: i32, y: i32}`
// @hint redundant type annotation: `proto` is inferred as `{x: i32, y: i32}`
// @hint redundant type annotation: `s` is inferred as `{x: i32, y: i32}`
// @hint redundant type annotation: `s` is inferred as `{x: i32, y: i32}`
// @hint redundant type annotation: `s` is inferred as `{x: i32, y: i32}`
// @hint redundant type annotation: `s` is inferred as `{x: i32, y: i32}`
// @hint redundant type annotation: `o` is inferred as `{x: i32, y: i32}`
// @hint redundant type annotation: `l` is inferred as `{n: i32}`
// @hint redundant type annotation: `l` is inferred as `{s: string}`
// @hint redundant type annotation: `modOuter` is inferred as `{tag: string}`
// D1045 — THE POSITION MATRIX for a block-scoped `type`. A capability gap is enforced in
// ONE place and served in MANY (CLAUDE.md §"A CAPABILITY GAP HAS A POSITION MATRIX"), and
// name resolution is exactly such a capability: the parser substitutes the local name at
// ONE site (`parseTypeAtom`'s IDENT arm), and this file is the check that every syntactic
// position a type can be delivered in really goes through it.
//
// EVERY ROW IS WRITTEN TWICE, annotated and UN-ANNOTATED. An annotation pins a
// destination's rep, so a fixture that annotates every destination cannot see a
// missing-annotation defect (CLAUDE.md); the `*Inf` half of each pair takes the same value
// through inference instead, and prints the same number. The declared RETURN types are left
// off throughout for the same reason — none of them is load-bearing here, and the hints the
// remaining annotations raise ARE part of the assertion: each renders the shape the local
// name resolved to.
//
// The positions: a `const` BINDING, an ARGUMENT, an annotated RETURN, an `is` TEST over a
// local union, a use inside a NESTED LAMBDA, a use inside a NESTED NAMED FUNCTION, a local
// name SHADOWING a module-scope one of a different shape, and TWO functions declaring the
// same local name at different shapes.
type Outer = { tag: string }

// ── binding ────────────────────────────────────────────────────────────────────
function posBinding() {
  type S = { x: i32, y: i32 }
  const s: S = { x: 1, y: 2 }
  return s.x + s.y
}
function posBindingInf() {
  type S = { x: i32, y: i32 }
  const s = { x: 1, y: 2 }
  return s.x + s.y
}

// ── argument ───────────────────────────────────────────────────────────────────
function posArg() {
  type S = { x: i32, y: i32 }
  function take(s: S) { return s.x * s.y }
  const s: S = { x: 1, y: 7 }
  return take(s)
}
function posArgInf() {
  type S = { x: i32, y: i32 }
  function take(s: S) { return s.x * s.y }
  return take({ x: 1, y: 7 })
}

// ── annotated return ───────────────────────────────────────────────────────────
function posRet() {
  type S = { x: i32, y: i32 }
  function mk(): S { return { x: 5, y: 7 } }
  return mk().x + mk().y
}
function posRetInf() {
  type S = { x: i32, y: i32 }
  const proto: S = { x: 5, y: 7 }
  function mk() { return proto }
  return mk().x + mk().y
}

// ── `is` over a local union ────────────────────────────────────────────────────
function posIs() {
  type L = { a: i32 }
  type R = { b: string }
  type E = L | R
  const e: E = { b: "b" }
  if e is R { return e.b }
  return "?"
}
function posIsInf() {
  type L = { a: i32 }
  type R = { b: string }
  type E = L | R
  let e: E = { a: 1 }
  e = { b: "b" }
  if e is R { return e.b }
  return "?"
}

// ── nested lambda ──────────────────────────────────────────────────────────────
function posLambda() {
  type S = { x: i32, y: i32 }
  const f = (s: S) => s.x + s.y
  const s: S = { x: 8, y: 12 }
  return f(s)
}
function posLambdaInf() {
  type S = { x: i32, y: i32 }
  const s: S = { x: 8, y: 12 }
  const f = () => s.x + s.y
  return f()
}

// ── nested named function ──────────────────────────────────────────────────────
function posNested() {
  type S = { x: i32, y: i32 }
  function g(s: S) { return s.x + s.y }
  const s: S = { x: 10, y: 20 }
  return g(s)
}
function posNestedInf() {
  type S = { x: i32, y: i32 }
  const s: S = { x: 10, y: 20 }
  function g() { return s.x + s.y }
  return g()
}

// ── shadowing, and two functions at one local name ─────────────────────────────
function posShadow() {
  type Outer = { x: i32, y: i32 }
  const o: Outer = { x: 1, y: 2 }
  return o.x + o.y
}
function posSameNameA() {
  type Local = { n: i32 }
  const l: Local = { n: 5 }
  return l.n
}
function posSameNameB() {
  type Local = { s: string }
  const l: Local = { s: "inner" }
  return l.s
}
const modOuter: Outer = { tag: "mod" }
print(posBinding())
print(posBindingInf())
print(posArg())
print(posArgInf())
print(posRet())
print(posRetInf())
print(posIs())
print(posIsInf())
print(posLambda())
print(posLambdaInf())
print(posNested())
print(posNestedInf())
print(posShadow())
print(posSameNameA())
print(posSameNameB())
print(modOuter.tag)
