// @check
// @error `as%` wraps between integer widths, and a boolean is not one — convert it with `as`
// @error `as%` wraps between integer widths, and a boolean is not one — convert it with `as`
// `as%` keeps the low bits of one integer width in another; a `boolean` has no width to wrap
// from, so the wrap cast refuses it and names the exact `as`. The pin of a type parameter
// bound to `boolean` refuses in the same words.
function w<T>(x: T) { return x as% i32 }
const t = 3 > 2
print(t as% i32)
print(w(t))
