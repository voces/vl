// @check
// @error cannot assign i32 to 'b' of type boolean
// The boolean→i32 coercion (A7) is ONE-directional: a `boolean` fits an `i32`
// (true→1, false→0), but an arbitrary `i32` is NOT a `boolean` — that direction
// stays rejected (an i32 other than 0/1 has no boolean meaning).
const n: i32 = 5
const b: boolean = n
print(b)
