// @log 1
// An alias whose body is a list of a function type denotes that list, at a binding, a `for`, a
// nested list, a parameter, a return, a field, a nullable result, a push and a hole parameter;
// the function type may be inline or name a declared record (D9960).
type FF = (x: i32) => i32
type L = FF[]
const fs: L = [(x: i32): i32 => x]
print(fs.length)

type LI = ((x: i32) => i32)[]
const fi: LI = [(x: i32): i32 => x + 1]
print(fi[0](4))
for f in fi { print(f(13)) }

type LL = FF[][]
const fl: LL = [[(x: i32): i32 => x + 7]]
print(fl[0][0](3))

function run(xs: L) { return xs[0](1) + xs.length }
print(run([(x: i32): i32 => x * 2, (x: i32): i32 => x]))

function mk(): L { return [(x: i32): i32 => x * 3] }
print(mk().length)

type Box = { fs: L }
const b: Box = { fs: [(x: i32): i32 => x - 1] }
print(b.fs.length)

function pick(c: boolean): L | null {
  if c { return [(x: i32): i32 => x * 4] }
  return null
}
const p = pick(true)
if p != null { print(p[0](3)) }

type Cat = { n: i32 }
type LC = ((c: Cat) => i32)[]
const fc: LC = [(c: Cat): i32 => c.n * 2]
print(fc[0]({ n: 21 }))

function g(xs) { return xs[0](2) }
const gs: L = [(x: i32): i32 => x * 4]
print(g(gs))

const ps: L = []
ps.push((x: i32): i32 => x + 100)
print(ps[0](1))
function add(xs: L) { xs.push((x: i32): i32 => x * 9) }
add(ps)
print(ps.length)
print(ps[1](2))
let m: L = ps
m = [(x: i32): i32 => x + 1]
print(m[0](0))
