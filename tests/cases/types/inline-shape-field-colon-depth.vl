// @run
// @log 7
// @log 6
// @log 9
// @log 3
// @hint redundant type annotation: `addOne` is inferred as `i32`
// @hint redundant type annotation: `sumInner` is inferred as `i32`
// @hint redundant type annotation: `s` is inferred as `{a: {b: i32, c: i32}, z: i32}`
// @hint redundant type annotation: `c` is inferred as `{f: (i32) => i32, z: i32}`
// @hint redundant type annotation: `t` is inferred as `{q: i32}`
// THE FIELD-COLON CUT AT DEPTH (W14's pin). An inline shape annotation is a
// `{name:type,name:type}` text, and five functions across three modules split each
// field at its colon INDEX. This program is the witness that the split is the FIELD's
// colon and not the first colon anywhere: every field type below carries colons and
// commas of its OWN, one level down.
//
//   `a: {b:i32,c:i32}`        a nested inline SHAPE — colons and a comma at depth 1
//   `m: {[string]:i32}`       a MAP-valued field — the `]:` the map grammar owns
//   `f: (i32) => i32`         a CLOSURE field — parens the depth walk must balance
//
// The two finders in front of the cut are deliberately NOT unified: the checker asks
// `tyTopIndexOf(field, ':', 0, 0)` (first TOP-LEVEL colon) and the three emitter copies
// ask a depth-blind `indexOf(":")` over an already-flattened name. They agree on every
// well-formed field — a field NAME cannot contain a colon, so the first colon IS the
// top-level one — and this fixture is what makes that agreement observable rather than
// asserted: a cut that took the WRONG colon would name the field `a` with the type
// `{b` (unparseable) or the field `a:{b` with the type `i32,c:i32}`.
//
// It also pins the DELIMITER-KEEPING spelling. `canonShapeName` rebuilds the shape text
// and takes the name half WITH its colon (`fieldNameOf(field, colonAt + 1)`); every
// annotation below goes through that rewrite, so an off-by-one there drops or doubles a
// separator and the rebuilt name no longer keys the interned struct row.

function addOne(n: i32): i32 { return n + 1 }

function sumInner(s: { a: { b: i32, c: i32 }, z: i32 }): i32 {
  return s.a.b + s.a.c + s.z
}

function go() {
  // A nested inline SHAPE field: the outer field `a`'s type carries its own colons.
  const s: { a: { b: i32, c: i32 }, z: i32 } = { a: { b: 1, c: 2 }, z: 4 }
  print(sumInner(s)) // 1 + 2 + 4 = 7

  // A MAP-valued field beside a scalar one — the `]:` inside the field type.
  const m: { m: { [string]: i32 }, z: i32 } = { m: Map(), z: 5 }
  m.m["k"] = 36
  // The map's VALUE is read through `.size` rather than `m.m["k"]`: an inline shape with
  // a map field cannot narrow the nullable index read — `emitProgram: bare null needs a
  // struct-typed context` — which reproduces identically on master and is NOT this
  // family's. The annotation is what this fixture is pinning, and the annotation is the
  // same either way.
  print(m.m.size + m.z) // 1 + 5 = 6

  // A CLOSURE field: the field type carries parens and the `=>` arrow.
  const c: { f: (i32) => i32, z: i32 } = { f: addOne, z: 8 }
  print(c.f(c.z)) // 8 + 1 = 9

  // A field whose name is a single character and whose type is the shortest there is —
  // the cut at index 1, the smallest non-degenerate split.
  const t: { q: i32 } = { q: 3 }
  print(t.q) // 3
}
go()
