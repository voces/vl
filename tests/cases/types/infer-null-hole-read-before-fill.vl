// @run
// @log 0
// @log false
// @log true
// @log null
// @log 0
// @log 0
// @log 0
// @log 0.5
// @log 2.5
// @log 0
// @log 7
// @log 5
// @log 0
// @hint redundant type annotation: `ra` is inferred as `i32` — remove it to lean on inference
// D1589 — A HOLE READ BEFORE ITS FILL. `let x = null` binds the A-infer-null hole and the
// first non-null assignment fills `nInner` IN PLACE, so a read that comes EARLIER in program
// order was typed against a `-1` inner: `nonNullTy` handed the NULLABLE back and the bank
// aliased the very node the fill mutates. `??` now answers with the DEFAULT's type — the one
// answer it can always give, since a non-null default is what the null path yields — and the
// fill re-derives the bank against the resolved inner.
// The tail `if c { x = 5 }` in `readsThenFills` is the second half: an else-less tail `if` is
// a valued return, an assignment's value is its TARGET CELL, and that cell is the box.
function readsThenFills(c: boolean) {
  let x = null
  print(x ?? 0)
  print(x != null)
  print(x == null)
  print(x)
  if c { x = 5 }
}

function bindThenFill(c: boolean) {
  let x = null
  const r = x ?? 0
  print(r)
  const ra: i32 = x ?? 0
  print(ra)
  if c { x = 5 }
}

function fillInLoop() {
  let x = null
  print(x ?? 0)
  let i = 0
  while i < 2 {
    x = 5
    i = i + 1
  }
}

function floatFill(c: boolean) {
  let x = null
  print(x ?? 0.5)
  if c { x = 1.5 }
  print(x ?? 2.5)
}

function readsAcrossTheFill(c: boolean) {
  let x = null
  print(x ?? 0)
  print(x ?? 7)
  if c { x = 5 }
  print(x ?? 9)
}

readsThenFills(true)
bindThenFill(true)
fillInLoop()
floatFill(false)
readsAcrossTheFill(true)

// The MODULE storage class: the hole is a global, the read is a start-function statement.
let g = null
print(g ?? 0)
g = 5
