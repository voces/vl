// @run
// @log 5
// @log 5
// @log 5
// @hint redundant type annotation: `id` is inferred as `i32`
// @hint redundant type annotation: `idn` is inferred as `i32`
// `as?` at a HOLE parameter, delivered as a call ARGUMENT. `as?` yields `T | null`
// (`docs/error-handling-design.md` §Trio), so the destination has to admit the null — and
// three spellings that do must all lower to the same value. D1371.
//
// THE PARENTHESISED `??` IS THE ONE THAT WAS BROKEN, and the un-parenthesised twin beside it
// is the assertion: a `Paren` banks a copy of its inner's checked type, and the re-record the
// pin performs (`castPinNullResult`) lands on the inner node only — so the dead-`??` fold read
// a stale non-nullable operand, folded the coalesce away, and handed the box to an `i32`
// parameter. The nullable-parameter leg is the third destination the trio's rule admits.
function id(x: i32): i32 { return x }
function idn(x: i32 | null): i32 {
  if x != null { return x }
  return 0 - 1
}
const u: i32 | null = 5

function take(a) {
  print(id((a as? i32) ?? 0))
  print(id(a as? i32 ?? 0))
  print(idn(a as? i32))
}

take(u)
