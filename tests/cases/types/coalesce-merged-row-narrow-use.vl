// @run
// @log 21
// @log 21
// @log 22
// @log 3
// @log 23
// @log 9
// CONTRACT (must-RUN): D924 and D925 — the EIGHTH owner of D804's merged row, and the call that
// reaches a slot through one binding hop.
//
// EVERY READER SINCE D804 MAKES A LITERAL A FAMILY MEMBER, AND A MEMBER IS BUILT AT THE MERGED
// ROW. Nothing until now asked where else that value goes. A member handed to a SECOND callee
// whose parameter is annotated with the narrow shape arrives as `(ref $merged)` under a
// `(ref $narrow)` functype — check-clean invalid wasm, on master too. D916 filed that as "the
// real answer is a per-DESTINATION coercion, which is a rung of its own"; it is not a coercion,
// it is a SLOT, and D891 already built the machinery for moving one. This marks the slots that
// receive a member and the seventh owner's own redirect does the rest.
//
// THE POSITION HAS TO BE *ALL* MEMBERS, WHICH IS WHAT KEEPS THE CONTROL RUNNING. A slot fed by a
// member at one call site and an ordinary literal at another cannot be at both rows.
// `narrowSib` below is that control — a same-shaped parameter fed only by non-members, which
// keeps its narrow row here exactly as on master — and
// `distilled/named/d924_narrow_use_mixed_sites` is the standing bound, where ONE callee is fed
// both and the mark is refused.
//
// AND A CALL THROUGH A BINDING THIS CAN RESOLVE IS NOT AN INDIRECT ONE. D911 narrowed the
// name-as-a-value guard to its own stated reason — "a value refutes only where the program can
// CALL one" — and left the call itself unread. `const f = srcv; f(w)` puts its argument at a
// call site as plainly as `srcv(w)` does; the callee is spelled with one binding hop and the hop
// is a `LetDecl` the same scan already reads. The BOUNDS are
// `distilled/named/d925_fn_value_two_targets` (a name bound to two functions is not one
// function) and `d925_fn_value_param_callback` (a callback PARAMETER's value is whatever the
// caller passed, which is at no write this can read).

// ---- a family member with a second, NARROW destination ----
function srck(p: { r: i32 }): { r: i32 } | null { p }

function keep(q: { r: i32 }) { q.r }

function rk() {
  const q = { r: 21 }
  const g1 = srck(q) ?? { r: "s" }
  print(g1.r)
  print(keep(q))
}
rk() // 21, 21

// ---- the CONTROL: a same-shaped parameter fed by a literal that is NOT a member ----
function srcs(p: { r: i32 }): { r: i32 } | null { p }

function narrowSib(q: { r: i32 }) { q.r }

function rs() {
  const g1 = srcs({ r: 22 }) ?? { r: "s" }
  print(g1.r)
  print(narrowSib({ r: 3 }))
}
rs() // 22, 3

// ---- a call through a FUNCTION VALUE, whose argument is a binding ----
function srcv(p: { r: i32 }): { r: i32 } | null { p }

function rv() {
  const f = srcv
  const w = { r: 9 }
  const hv = f(w) ?? { r: 0 }
  const g1 = srcv({ r: 23 }) ?? { r: "s" }
  print(g1.r)
  print(hv.r)
}
rv() // 23, 9
