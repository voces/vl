// @run
// @log ok
// @log b
// @log a
// @log b
// @log a
// @log b
// @log 1
// @log 3
// @log 0
// @log h
// @log i
// @log ok
// @log a
// @log ok
// @hint redundant type annotation: `e` is inferred as `E | null`
// CONTRACT (must-RUN): an if-EXPRESSION whose ARMS are themselves `T | null` is `T | null`,
// and the INFERRED binding gets the same rep the annotation gives it (D1560, reported by the
// glean session as VL-025). Every cell below was a refusal or invalid wasm before that row:
// the un-annotated plain-struct face said `bare null needs a struct-typed context`, the
// annotated container faces were check-clean INVALID WASM, and the union-member face said
// `ref valtype with no interned shape` at BOTH spellings.
//
// Each cell DISCRIMINATES — the taken branch prints the arm's own payload, so a cell that
// lost the value to the null half prints `null` and the line moves.

type E = { msg: string }

function a(ok: boolean): E | null {
  if ok { return null }
  return { msg: "a" }
}

function b(ok: boolean): E | null {
  if ok { return null }
  return { msg: "b" }
}

// The reported witness, verbatim: un-annotated, both arms calls, both branches exercised.
function pick(flag: boolean, ok: boolean) {
  const e = if flag { a(ok) } else { b(ok) }
  if e != null { return e.msg }
  "ok"
}

print(pick(true, true))
print(pick(false, false))
print(pick(true, false))

// The ANNOTATED face of the same value — it ran before and must keep running.
function pickAnn(flag: boolean, ok: boolean) {
  const e: E | null = if flag { a(ok) } else { b(ok) }
  if e != null { return e.msg }
  "ok"
}

print(pickAnn(false, false))

// BOTH ARMS THE SAME FUNCTION — one callee, two call sites, still `E | null`.
function pickSame(flag: boolean, ok: boolean) {
  const e = if flag { a(ok) } else { a(ok) }
  if e != null { return e.msg }
  "ok"
}

print(pickSame(true, false))

// A `while` BLOCK's scope, which no other cell here opens.
function pickLoop(flag: boolean, ok: boolean) {
  let i = 0
  let seen = "ok"
  while i < 1 {
    const e = if flag { a(ok) } else { b(ok) }
    if e != null { seen = e.msg }
    i = i + 1
  }
  seen
}

print(pickLoop(false, false))

// A NULLABLE CONTAINER arm — the annotated spelling of this was check-clean invalid wasm,
// because every predicate the join asked was the NON-null one.
function la(ok: boolean): i32[] | null {
  if ok { return null }
  return [1, 2]
}

function lb(ok: boolean): i32[] | null {
  if ok { return null }
  return [3, 4]
}

function pickList(flag: boolean, ok: boolean) {
  const l = if flag { la(ok) } else { lb(ok) }
  if l != null { return l[0] }
  0
}

print(pickList(true, false))
print(pickList(false, false))
print(pickList(true, true))

// THE OTHER SENTENCE: the arm's struct is a MEMBER of a declared union, so its heap lives in
// `uVarHeap` and the struct fallback had no row — `ref valtype with no interned shape`, at
// the annotated spelling as much as the inferred one. `R` is never used; declaring it is the
// whole ablation.
type Hit = { msg: string }
type Miss = { why: string }
type R = Hit | Miss

function ha(ok: boolean): Hit | null {
  if ok { return null }
  return { msg: "h" }
}

function hb(ok: boolean): Hit | null {
  if ok { return null }
  return { msg: "i" }
}

function pickVariant(flag: boolean, ok: boolean) {
  const v = if flag { ha(ok) } else { hb(ok) }
  if v != null { return v.msg }
  "ok"
}

print(pickVariant(true, false))
print(pickVariant(false, false))
print(pickVariant(true, true))

// THE BARE-`null` ARM whose OTHER arm is itself nullable — the spelling `nulArmIfThenValueIx`
// answered with its NON-null predicate, so it declined a `T | null` value.
function pickNullArm(flag: boolean, ok: boolean) {
  const e = if flag { a(ok) } else { null }
  if e != null { return e.msg }
  "ok"
}

print(pickNullArm(true, false))
print(pickNullArm(false, false))
