// @run
// @log s
// @log nilS
// @log p
// @log nilS
// @log true
// @log nilB
// @log g
// @log nilG
// AN UN-PARENTHESIZED `type T = X | null` DENOTES THE NICHE, exactly as the inline
// annotation `X | null` and the parenthesized declaration `type T = (X | null)` do — three
// spellings of one type, at the PARAMETER position and at a module `const`, each at BOTH
// runtime inputs. A REF-NICHE (`string`) inner and a SCALAR-NICHE (`boolean`) one, which
// are the two whose failure is SILENT; `nullable-alias-unparenthesized-scalar.vl` carries
// the `i32` / `f64` inner, whose failure is loud, so neither can mask the other.
//
// WHY IT IS A FIXTURE. `parseTypeDecl` reads `X | null` as a TWO-variant `UnionDecl`, and
// the declaration route resolved each variant independently and pushed them all into the
// alias's member list, `null` among them — so the alias interned as `TyUnion[X, null]`
// while both annotation routes wrap a `null` member into `TyNullable(X)`. The two-member
// arity then minted a union ROW for the alias and registered both members as variant
// boxes, while every read of the value classified from the arena and lowered the NICHE:
// `vl check` rc 0 and an INVALID MODULE (`type mismatch: expected i32, found (ref $type)`)
// at every position and for every use. The PARENTHESIZED declaration on line three of each
// trio is ONE variant, resolved through the annotation route, and is the spelling that
// always worked — it is the control that makes this a defect of the DECLARATION route and
// not of the niche.
//
// The fold lives at `annUnionTy` — the shared annotation home, which is why all three
// spellings intern one arena shape — and is UNGATED ON THE INNER: a member the emitter
// renders structurally (a declared struct, a list, a map, a generic application, a
// closure, a declared union) folds too, because the transparency arm one layer up claims
// the niche for every inner and a declining fold would leave the alias a union ROW that no
// read of the value lowers as. `types/nullable-alias-unparenthesized-structural-inner.vl`
// and `types/nullable-alias-map-inner-unparenthesized.vl` carry those inners;
// `types/alias-over-nullable-null-test.vl` is the parenthesized family's own pin;
// `literal-unions/nullable-litunion-alias-sites.vl` carries the litunion inner.
//
// A LOG MISMATCH IS NOT AVAILABLE FOR THIS DEFECT: a 480-cell position grid and a 224-cell
// use grid, both graded against the inline spelling at both runtime inputs, found ZERO
// cells that ran and printed the wrong thing. Every reachable failure is a build or check
// verdict, so that is what this fixture reddens on — here the BUILD one, unmasked.

type TS = string | null
type TSP = (string) | null
type TSA = (string | null)

type TB = boolean | null
type TBP = (boolean) | null

function takesS(v: TS) {
  if v != null { print(v) } else { print("nilS") }
}
function takesSP(v: TSP) {
  if v != null { print(v) } else { print("nilS") }
}
function takesSA(v: TSA) {
  if v != null { print(v) } else { print("nilS") }
}
function takesB(v: TB) {
  if v != null { print(v) } else { print("nilB") }
}

// The parameter position, both runtime inputs, every spelling in at least one direction
// each — so no spelling is pinned in only one direction.
takesS("s")
takesSP(null)
takesSA("p")
takesS(null)
takesB(true)
takesB(null)

// A module `const`, which the two-member union reached through a different lowering than
// the parameter did — the niche has to be the same type at both.
const gs: TS = "g"
const gn: TBP = null

if gs != null { print(gs) } else { print("nilG") }
if gn != null { print(gn) } else { print("nilG") }
