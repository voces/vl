// @run
// @log 25
// @log N
// @log 37
// @log N
// @log 43
// @log N
// THE OTHER TWO NARROWING FORMS of `types/nullable-alias-opaque-inner-narrow.vl`'s
// ruling, on the same one-member alias over a structurally-rendered nullable inner: the
// `is <Inner>` test — the very form the old diagnostic told the reader to use — and a
// round trip through an alias-typed RETURN before the narrow.
//
// NO MAP IN THIS PROGRAM, ON PURPOSE. A nullable-map parameter standing beside a
// NARROWED nullable-struct parameter is a PRE-EXISTING invalid module (`type mismatch:
// expected (ref null $type), found (ref null $type)`) that reproduces on master in the
// INLINE spelling with no alias anywhere — so mixing the two here would pin an emitter
// defect this file has no claim on. The failure SET over the six-section powerset is
// identical for the alias spelling here and for the inline spelling on master, which is
// what "the alias stopped being a dialect" means for a shape that is broken in both.
//
// Reddens on a log mismatch as well as on a verdict: every value printed is read back
// through the narrowed member at BOTH runtime inputs.

type S = {v: i32}
type L = i32[]

type TS = (S | null)
type TL = (L | null)

// `is <Inner>` on the alias. This form CHECKS against the opaque wrapper (`is S` pins the
// type without consulting `nonNullTy`) and then fails at the EMITTER, which is why it is
// the half that shows the ruling is not a checker-only one: standalone on master it is
// `emitProgram: field access receiver is not a struct` for the struct inner and
// `emitProgram: bare null needs a struct-typed context` for the list inner.
function iS(x: TS) {
  if x is S { print(x.v + 20) } else { print("N") }
}
iS({ v: 5 })
iS(null)

// RETURNED through an alias-typed return and re-narrowed at the call site.
function rS(x: TS): TS { return x }
function jS(x: TS) {
  const y = rS(x)
  if y != null { print(y.v + 30) } else { print("N") }
}
jS({ v: 7 })
jS(null)

// The same round trip on the LIST inner, so the pin is not struct-only.
function rL(x: TL): TL { return x }
function jL(x: TL) {
  const y = rL(x)
  if y != null { print(y.length + 40) } else { print("N") }
}
jL([1, 2, 3])
jL(null)
