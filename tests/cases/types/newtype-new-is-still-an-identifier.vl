// @run
// @log 5
// @log 12
// @log 7
// @log true
// `new` IS NOT A RESERVED WORD. It is a CONTEXTUAL keyword, recognized only
// immediately after the `=` of a `type` declaration and only when a type follows
// it — so adding the newtype form cannot break a program that already spells a
// variable, a parameter, a field or a function `new`.
//
// The alternative was a hard lexer keyword. It would have been free against this
// repository (zero occurrences of `new` as an identifier in `std`, `tests/cases`
// or `compiler`), but reserving a common word language-wide to mark one
// declaration form is a cost every future program pays. One token of lookahead
// buys the same syntax. `docs/internals/newtype-design.md` §1.
type Tick = new i32

const new = 5
print(new)

function twice(new: i32) { return new + new }
print(twice(6))

type Holder = { new: i32 }
const h = { new: 7 }
print(h.new)

const t: Tick = 1
print(t == 1)
