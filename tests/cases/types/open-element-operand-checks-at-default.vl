// @check
// @error-at 17:12 member access '.r' on non-object i32
// A read of an element no write fixes is checked as if the list were annotated at the default:
// `xs[0] + 1` type-checks as over `i32[]` (and traps at run time, as the annotated twin
// does), and `zs[0].r` refuses as over `i32[]`. Never a compiler trap on the open hole. D1462.
const xs = []
print(xs[0] + 1)
const ys = []
print(ys[0] is i32)
const m = Map()
print(m["a"] ?? 1)
const zs = []
print(zs.length)
print(zs[0] is i32)
print(zs[0] + 1)
print(m["b"] == null)
print(xs[1])
print(zs[0].r)
