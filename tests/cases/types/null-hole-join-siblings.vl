// @run
// @hint redundant type annotation: `a` is inferred as `S | null` — remove it to lean on inference
// @hint redundant type annotation: `a` is inferred as `i32[] | null` — remove it to lean on inference
// @log null a
// @log true true
// @log true false
// @log none lit
// The null-unit join's siblings, found by V1 verifying D17124: a tagged-variant arm (a compiler trap
// on master), two inferred-null bindings at an annotated record (invalid wasm), a list arm and a
// string literal arm at a nullable parameter (invalid wasm). Each runs.
type S = { k: "a", v: i32 } | { k: "b", w: i32 }
type In = { v: i32 }
const sv: S = { k: "a", v: 6 }
const n = null
const m = null
function tagged(f: boolean) {
  const a: S | null = if f { n } else { sv }
  if a == null { return "null" }
  return a.k
}
function twoHoles(f: boolean) {
  const a: In | null = if f { n } else { m }
  return a == null
}
function list(f: boolean) {
  const a: i32[] | null = if f { n } else { [1, 2] }
  return a == null
}
function sN(x: string | null) { return x ?? "none" }
function str(f: boolean) { return sN(if f { n } else { "lit" }) }
print("\{tagged(true)} \{tagged(false)}")
print("\{twoHoles(true)} \{twoHoles(false)}")
print("\{list(true)} \{list(false)}")
print("\{str(true)} \{str(false)}")
