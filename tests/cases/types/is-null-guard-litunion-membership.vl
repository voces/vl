// @run
// @log SUB
// @log OTHER
// @log OTHER
// @log MEMBER
// @log MEMBER
// @log OTHER
// @log NULL
// @log SOMESTR
// @log SOMEI32
// Over a `K | null` niche the two `is` DIRECTIONS ask different questions and only one of
// them is the null test. `k is null` IS the null test (the `-1` sentinel compare, shared
// with `k == null`), but `k is <litunion>` is a MEMBERSHIP test over the tested type's
// members — and a SUB-alias (`K2 = "aa"` under `K = "aa" | "bb" | "cc"`) is FALSE for a
// member outside it, which "not null" cannot express. The membership ladder owns that
// direction; the null test claims only `is null`.
//
// The value-union CONTROL below is the other boundary: over a BOX (`string | i32 | null`)
// "not null" does not identify which arm is present, so `is string` stays the box-tag
// compare rather than a null test.

type K = "aa" | "bb" | "cc"
type K2 = "aa"
const kAa: K = "aa"
const kBb: K = "bb"

function subAlias(k: K | null) {
  if k is K2 { print("SUB") } else { print("OTHER") }
}
subAlias(kAa)
subAlias(kBb)
subAlias(null)

function wholeSet(k: K | null) {
  if k is K { print("MEMBER") } else { print("OTHER") }
}
wholeSet(kAa)
wholeSet(kBb)
wholeSet(null)

// A three-member BOX: `is null` reads the box TAG, `is string` reads the arm tag — the
// tag compare, not a null test.
const boxStr: string | i32 | null = "s"
const boxI32: string | i32 | null = 4

function boxArm(v: string | i32 | null) {
  if v is null {
    print("NULL")
  } else if v is string {
    print("SOMESTR")
  } else {
    print("SOMEI32")
  }
}
boxArm(null)
boxArm(boxStr)
boxArm(boxI32)
