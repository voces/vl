// @run
// @log true
// @log 0
// @log -1 -1 -1
// @log -1 -1 -1
// @log -1 -1 -1
// @log -1 -1 -1
// @log 5 5 5
// @log -1 -1 -1
// @log true true true
// @log 1
// @log a
// A module global of the `null` type is initialized as legacy writes it: a `null` literal is the
// bottom null, a call is its own value (run once), and an assignment yielding `null` runs, then the
// bottom null; each global then read in the positions a value goes, and once before it is set.
// The `if` arm position is D17124's (a `null`-unit binding joined into `T | null`).
type In = { v: i32 }
let hits = 0
function nothing() {
  hits = hits + 1
  return null
}
function early() { return fromCall == null }
print(early())
print(hits)
let gs: string | null = "z"
const fromLit = null
const fromCall = nothing()
const fromAsg = (gs = null)
function sN(x: In | null) { return if x == null { -1 } else { x.v } }
function idN(x: In | null) { return x }
function arg() { return "\{sN(fromLit)} \{sN(fromCall)} \{sN(fromAsg)}" }
function nested() {
  return "\{sN(idN(fromLit))} \{sN(idN(fromCall))} \{sN(idN(fromAsg))}"
}
function retLit(): In | null { return fromLit }
function retCall(): In | null { return fromCall }
function retAsg(): In | null { return fromAsg }
function ret() { return "\{sN(retLit())} \{sN(retCall())} \{sN(retAsg())}" }
function bind() {
  const a: In | null = fromLit
  const b: In | null = fromCall
  const c: In | null = fromAsg
  return "\{sN(a)} \{sN(b)} \{sN(c)}"
}
function coal() {
  const d: In = { v: 5 }
  return "\{(fromLit ?? d).v} \{(fromCall ?? d).v} \{(fromAsg ?? d).v}"
}
function rec() {
  const r: { a: In | null, b: In | null, c: In | null } = {
    a: fromLit,
    b: fromCall,
    c: fromAsg,
  }
  return "\{sN(r.a)} \{sN(r.b)} \{sN(r.c)}"
}
function isNull() {
  return "\{fromLit == null} \{fromCall == null} \{fromAsg == null}"
}
print(arg())
print(nested())
print(ret())
print(bind())
print(coal())
print(rec())
print(isNull())
print(hits)
print(gs ?? "a")
