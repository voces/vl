// @run
// @log row
// @log 4
// @log str
// @log hi
// @log cat
// @log kit
// @log dog
// @log 7
// @log fish
// @log 3
// @log l-cat
// @log l-dog
// @log l-fish
// @log obj
// @log 2
// @log s
// @log x
// @log arr
// @log 3
// @log s2
// @log y
// THE THREE READERS OF AN `is` NODE, ACROSS BOTH HALVES OF THE SPELLING POPULATION.
// `checkIsExprNode` resolves the tested type and banks it on the node (`isVarTyIx`);
// the two narrowing collectors and the if-chain exhaustiveness scan then read that
// bank for a bare NAME (`isTypeTyRead`) and resolve for a composite one.
//
// The two halves are here together because they are separated by the ARENA, not by
// the answer: a bare name resolves to an index somebody else minted, so the reader's
// resolution was pure duplicate work; a composite spelling MINTS a fresh `T.tys` row
// per resolution, so the reader's index differs from the banked one by construction
// and skipping it would delete an arena row. Each of the four spellings below carries
// a mechanism the bare-name half has to survive:
//
//   `RowAddr`  a NEWTYPE — `declaredTyOfName` brands it, minting once per (name, base)
//              and memoizing after, so the reader's read is mint-free only because the
//              node's own check already paid for it
//   `MyCat`    a TRANSPARENT single-member alias — the name the declaration table holds
//              is not the type the annotation resolves to
//   `{w: i32}` / `i32[]`   the minting half, which must keep resolving
type RowAddr = new i32
type Cat = { name: string }
type Dog = { bark: i32 }
type Fish = { fin: i32 }
type MyCat = Cat

function pick(v: RowAddr | string) {
  if v is RowAddr {
    print("row")
    print(v as i32)
  } else {
    print("str")
    print(v)
  }
}

// The if-CHAIN reader: `ifChainExhausts` re-resolves every arm's tested type to decide
// coverage, and each of these three is a bare declared name.
function chain(v: MyCat | Dog | Fish) {
  if v is MyCat {
    print("cat")
    print(v.name)
  } else if v is Dog {
    print("dog")
    print(v.bark)
  } else if v is Fish {
    print("fish")
    print(v.fin)
  }
}

// The EXHAUSTIVENESS reader: a chain with no `else` type-checks as total only if
// `ifChainExhausts` can resolve every arm's tested type and cover the union with them.
function label(v: MyCat | Dog | Fish): string {
  if v is MyCat { return "l-cat" }
  else if v is Dog { return "l-dog" }
  else if v is Fish { return "l-fish" }
}

function shape(v: { w: i32 } | string) {
  if v is { w: i32 } {
    print("obj")
    print(v.w)
  } else {
    print("s")
    print(v)
  }
}

function arr(v: i32[] | string) {
  if v is i32[] {
    print("arr")
    print(v.length)
  } else {
    print("s2")
    print(v)
  }
}

pick(4 as RowAddr)
pick("hi")
chain({ name: "kit" })
chain({ bark: 7 })
chain({ fin: 3 })
print(label({ name: "kit" }))
print(label({ bark: 7 }))
print(label({ fin: 3 }))
shape({ w: 2 })
shape("x")
arr([1, 2, 3])
arr("y")
