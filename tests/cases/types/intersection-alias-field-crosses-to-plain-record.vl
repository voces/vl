// @run
// @log 12
// @log 34
// @log 56
// @log 78
// A declared intersection alias is a one-member wrapper over its merged record, and keys as
// that record: a record whose field holds `AB`, or a list of `AB`, is handed where the field
// is declared as the plain record, and both rows share one heap type (D15953).
type AB = { a: i32 } & { b: i32 }
type P = { a: i32, b: i32 }
type R1 = { u: AB }
type R2 = { u: P }
function f(r: R2) { r.u.a * 10 + r.u.b }
const r1: R1 = { u: { a: 1, b: 2 } }
print(f(r1))
type S1 = { u: AB[] }
type S2 = { u: P[] }
function g(r: S2) { r.u[0].a * 10 + r.u[0].b }
const s1: S1 = { u: [{ a: 3, b: 4 }] }
print(g(s1))
function h(p: P) { p.a * 10 + p.b }
const ab: AB = { a: 5, b: 6 }
print(h(ab))
const m: {[string]: AB} = Map()
m["k"] = { a: 7, b: 8 }
function k(mm: {[string]: P}) {
  const v = mm["k"] ?? { a: 0, b: 0 }
  v.a * 10 + v.b
}
print(k(m))
