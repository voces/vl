// @run
// @log 0
// @log null
// @log true
// @log false
// @log d
// @log 9
// @log false
// @log none
// @log none
// @log none
// @log none
// @log 0
// @log none
// @log 7
// @log 5
// @log 0
// D1576 — A NEVER-FILLED `let x = null` IS THE `null` TYPE, AND IT HAS A REP. The
// A-infer-null hole is filled in place by the first non-null assignment; with none the
// binding's only value is `null`, so its cell is `nullref` — the GC bottom (D1567's
// `nulnone`), a subtype of every nullable ref valtype. `??` yields the default, `== null` is
// true, `print` writes the word, and every ref destination takes the value with no coercion.
// Both storage classes are here (a function local and a module global), because the global
// cell's null is decided in the START function and not in the constexpr arm.
type C = { a: i32, b: i32 }
type W = { f: C | null }

function consumers() {
  const x = null
  print(x ?? 0)
  print(x)
  print(x == null)
  print(x != null)
  print(x ?? "d")
  const vi: i32 | null = x
  print(vi ?? 9)
  const vb: boolean | null = x
  print(vb ?? false)
}

function deliveries(c: boolean) {
  const x = null
  const vs: C | null = x
  if vs != null { print(vs.a) } else { print("none") }
  const w: W = { f: x }
  if w.f != null { print(w.f.a) } else { print("none") }
  const w2: W = { f: { a: 1, b: 2 } }
  w2.f = x
  if w2.f != null { print(w2.f.a) } else { print("none") }
  take(x)
  const j = (if c { x } else { x }) ?? 0
  print(j)
}

function take(v: C | null) {
  if v != null { print(v.a) } else { print("none") }
}

function ret(): C | null {
  const x = null
  return x
}

function captured() {
  const x = null
  const f = () => x ?? 7
  print(f())
}

// A `null` ASSIGNED to the cell keeps it the `null` type — the hole is not filled by a null.
function assigned(c: boolean) {
  let x = null
  if c { x = null }
  print(x ?? 5)
}

// The module-GLOBAL storage class: the cell's `ref.null none` is written by the start fn.
const g = null

consumers()
deliveries(true)
if ret() != null { print("some") } else { print("none") }
captured()
assigned(true)
print(g ?? 0)
