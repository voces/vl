// @run
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @hint Intentionally-unused variable `_sp1` (leading `_` marks it unused)
// @hint redundant type annotation: `ca` is inferred as `{a: i32, b: i32}[]` — remove it to lean on inference
// AN ARRAY ALIAS WHOSE LEAF IS ITSELF A DECLARED ALIAS is the FIFTH `arrSpineIs*` twin
// (silent-class-inventory D362) — `arrSpineIsUnionAlias`, and the one
// `arrSpineIsNominal`'s header had left unclaimed by name: *"a UNION-ALIAS leaf
// (`type L = Shape[]`) is deliberately NOT claimed here."*
//
// THE LEAF IS A `TyUnion`, NOT ITS OWN CONSTRUCTOR, WHICH IS WHY FOUR LEAF KINDS FELL
// THROUGH FOUR PREDICATES. `parseTypeDecl` encodes every non-struct-bodied `type N = …` as
// a one-member `UnionDecl`, so a declared alias standing at an array leaf sits in the arena
// as a `TyUnion` carrying the alias's registered name. A `reach=1 ans=0` probe at
// `singleAliasMemberTyIx`'s array arm reads the identical row for all four:
// `leaf=TyUnion struct=[] uname=[<the alias>] ans=0`.
//
// `array-alias-map-element.vl` beside this is the MAP leaf (D181) and
// `array-alias-return-unread.vl` the scalar one; this file is the alias leaf, and every
// spelling here was a distinct dialect from its alias-free control before D362.

// A STRING LITUNION leaf. The alias renders `K0[]` nominally, which is the direct
// spelling character for character.
type K0 = "a" | "b"
type LK = K0[]
const ck: LK = ["a"]
if ck[0] == "a" { print(7) } else { print(0) }

// A NUMERIC LITUNION leaf needs NO exception here, and that is the measured half. The
// renderer owns the rule: `tyToNominalNameGo` short-circuits such an alias to its BASE
// SCALAR (`numLitUnionBaseName`), so `LZ` renders `i32[]` — never `Z[]` — and a second
// copy of the exception in `arrSpineIsUnionAlias` would be a second home for one rule.
type Z = 0 | 1
type LZ = Z[]
const cz: LZ = [1]
if cz[0] == 1 { print(7) } else { print(0) }

// A DECLARED VALUE UNION leaf, read through a bound element (an `is` on `cu[0]` directly
// is index-place narrowing, which is inventory-2 D11 and a different row).
type Circle = { r: i32 }
type Sq = { s: i32 }
type U1 = Circle | Sq
type LU = U1[]
const cu: LU = [{ r: 7 }]
const e0 = cu[0]
if e0 is Circle { print(e0.r) } else { print(0) }

// A CANONICALIZED INTERSECTION leaf. `arrSpineIsObj`'s header claimed this one and the
// claim was false at an array leaf: `structNameOfTy` answers `""` for it, so
// `arrSpineIsNominal` declined, and the leaf's inner member is an ANONYMOUS `TyObj` — had
// the one-member wrapper been peeled it would have been `arrSpineIsObj`'s, not the nominal
// predicate's.
type AB = { a: i32 } & { b: i32 }
type LA = AB[]
const ca: LA = [{ a: 7, b: 1 }]
print(ca[0].a)

// THE SILENT CELL, and it needs no twin binding to reach. An UNREAD `_`-prefixed binding
// of the alias was `vl check` rc 0 and a module the engine refuses — `(global $global$0
// (mut (ref $1)) (struct.new $5 …))`, the union BOX declared and the i32-list wrapper
// stored: D181's landing at the one leaf kind D181's fix and D188's both left unclaimed.
type LA2 = AB[]
const _sp1: LA2 = []
print(7)

// A PARAMETER position, the one that carries the alias across a call boundary.
function takes(xs: LK) {
  if xs[0] == "b" { print(7) } else { print(0) }
}
takes(["b"])
