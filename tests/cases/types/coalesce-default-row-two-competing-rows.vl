// @run
// @log 4
// @log 1
// @log 107
// @log 5
// @info `a` is never reassigned; use `const` instead of `let`
// @info `a` is never reassigned; use `const` instead of `let`
// @hint redundant type annotation: `b` is inferred as `{inner: {r: i32}}` — remove it to lean on inference
// CONTRACT (must-RUN): D804's merged row supersedes the row the `??`'s left operand's own
// CARRIER resolves to, which is not always the row its LITERALS matched.
//
// Both resolvers match a field-name SET, so with ONE row per set they agree and the supersede
// recorded against `structIndexOfObj`'s answer is the one `nulRefStructIdxOfLet` reads back.
// Two same-fieldset rows part them: `type R` and the inline `{ r: i32 }` inside `Box`'s field
// are separate rows, the literals land on one and the binding's annotation on the other, and
// the merged row is minted with nothing naming it. `anonLeafCarrierRowOf` records the
// supersede against the carrier's row too.
//
// THE ABLATION IS THE THREE INGREDIENTS AND THE FILED ROW HAD IT WRONG. D863 read "two `??`
// families over one field set, plus a nested-struct row" and named the second family as an
// ingredient; it is SCENERY. What the defect needs is `type R`, `Box`'s inline shape
// INSTANTIATED (a bare declaration mints no competing row), and ONE `??` family whose atoms
// disagree. Graded over the carrier x default grid: `none`, `R` alone, `Box` declared alone
// and `Box` instantiated alone all RUN at every default; only `Box` instantiated + `R`
// reproduces, loud at `null` and check-clean invalid wasm at `string` and `f64`.

type Box = { inner: { r: i32 } }

type R = { r: i32 }

// The nested row has to be BUILT, not merely declared — a `Box` nobody instantiates leaves
// one `{ r: i32 }` row and the two resolvers agree again.
function ub() {
  const b: Box = { inner: { r: 4 } }
  print(b.inner.r)
}
ub() // 4

// ---- the `null` corner: master's loud `bare null needs a struct-typed context` ----
function rn() {
  let a: { r: i32 } | null = { r: 7 }
  const g1 = a ?? { r: null }
  if g1.r != null { print(1) } else { print(0) }
}
rn() // 1

// ---- the `string` corner, which was check-clean invalid wasm, reading both atoms back ----
function rs() {
  let a: { r: i32 } | null = { r: 7 }
  const g1 = a ?? { r: "s" }
  const v = g1.r
  if v is i32 { print(100 + v) } else { print(0) }
}
rs() // 107

// ---- and `R` itself still resolves narrowly for a destination of its own ----
function useR(x: R) { print(x.r) }

function ru() { useR({ r: 5 }) }
ru() // 5
