// @check
// @error-at 15:0 union members 'EntityId' and 'PlayerSlot' have the same runtime representation, so `is` cannot tell them apart — a nominal newtype is erased to its base at run time in union 'Either'
// Two newtypes over ONE base are the same collision as a newtype beside its base
// (`newtype-base-union-rejected.vl`): both erase to `i32`, so the union box's single tag
// cannot say which arm a value came from and `u is EntityId` answers TRUE for a
// `PlayerSlot` value.
//
// Reported at the DECLARATION, which is the second of the rule's two homes — a `type`
// alias builds its member list in the union-declaration loop and never reaches the shared
// annotation home that the inline spelling goes through.
//
// The brands themselves stay perfectly usable apart: `newtype-scalar-distinctness.vl`
// keeps both ids distinct in every non-union position.
type EntityId = new i32
type PlayerSlot = new i32
type Either = EntityId | PlayerSlot
const u: Either = 5 as EntityId
if u is EntityId { print("e") } else { print("p") }
