// @check
// @error this `if` was typed In | null — the assignment below makes the binding {w: string} | null, so the join is {w: string} | In | null; annotate the binding
// A function's value `if` over a module binding `let m = null` is typed while `m` is the open hole;
// a later write filling it with another record is refused there, since `?.v` was already checked
// at `In | null` (D17203).
type In = { v: i32 }
const rec: In = { v: 9 }
let m = null
function pick(flag: boolean) { return if flag { m } else { rec } }
m = { w: "z" }
print(pick(false)?.v ?? -1)
print(pick(true)?.v ?? -1)
