// @run
// @log 6
// @log 3
// @log inner
// @log 9
// @log 4.5
// @log mapped
// @log 22
// @log 7
// @log 8
// @log 5
// COVERAGE PIN for the four type-name-grammar HOMES in `emit_base` / `emit_collect`
// (D-ARROWHOME / D-GROUPEND / D-MONOHOME / D-FIELDROW). It is GREEN ON MASTER TOO — the
// slice that added it is byte-identical over the whole corpus, so this file pins no new
// behaviour. Its job is per-site COVERAGE: every one of the four homes has at least one
// reacher here, so a future edit that breaks a home fails a named case instead of only a
// corpus sweep. What proves the homes LIVE is the sabotage table in the program doc
// (S1 reddens 168 files, S2 33, S5 202, S6 203); what this file adds is a durable,
// human-readable reacher for each.
//
//   `tyTopLevelIndexOf` + its `'='` ARROW token  — every `(params) => ret` name below
//   `tyGroupWrapsWhole` via `nameIsSingleShape`  — the nested inline shape `{ q: i32 }`
//   `tyGroupWrapsWhole` via `normTypeAtom`       — the WRAPPED closure union arm
//   `pushFieldRow` (struct table)                — `type Rec`'s declared fields
//   `pushFieldRow` (variant table, NODE)         — `type VA`'s declared variant fields
//   `pushFieldRow` (variant table, SHAPE TEXT)   — the inline `{ s: i32, u: i32 | null }` arm
//   `isVariantBoxUnionAtoms`                     — the map-armed variant-box union
//   `annFnDecompose` (emit_mono)                 — the annotated function-typed binding

// ── the ARROW token: a top-level `(params) => ret` name, and one NESTED in a group ──
function apply2(f: (i32) => i32, x: i32): i32 { f(x) }
print(apply2((n) => n * 2, 3)) // 6

// `annFnDecompose` in `emit_mono`: a GENERIC function value pinned by an annotated
// function-typed binding — the mono coercion parses the annotation's param list.
function idOf(a) { a }
const pinned: (i32) => i32 = idOf
print(pinned(3)) // 3

// ── the GROUP-WRAPS walk via `nameIsSingleShape`: a nested inline shape field ────────
type Rec = { name: string, inner: { q: i32 } }
function readInner(r: Rec): string { r.name }
print(readInner({ name: "inner", inner: { q: 1 } })) // inner

// ── the GROUP-WRAPS walk via `normTypeAtom`: a union arm that keeps its GROUPING
// parens (`(() => i32) | i32` splits to the atom `(() => i32)`, which the arm-key
// normalization peels before keying).
function callOrAdd(v: (() => i32) | i32): i32 {
  const t0 = v
  if t0 is () => i32 { return t0() }
  t0 + 1
}
print(callOrAdd(() => 9))  // 9

// ── `pushFieldRow` at the STRUCT table, with a code-16 VALUE-UNION field ────────────
type Cell = { tag: string, val: f64 | null }
const c: Cell = { tag: "c", val: 4.5 }
function cellVal(x: Cell): f64 {
  const v = x.val
  if v is null { return 0.0 }
  v
}
print(cellVal(c)) // 4.5

// ── `pushFieldRow` at the VARIANT table, NODE recorder (a declared variant) ─────────
type VA = { k: string, n: i32 }
type VB = { m: i32 }
type Either = VA | VB
function readEither(e: Either): string {
  const t0 = e
  if t0 is VA { return t0.k }
  "other"
}
print(readEither({ k: "mapped", n: 2 })) // mapped

// ── `pushFieldRow` at the VARIANT table, SHAPE-TEXT recorder (an INLINE shape arm
// carrying its own value-union field) ───────────────────────────────────────────────
function readInline(v: { s: i32, u: i32 | null } | boolean): i32 {
  const t0 = v
  if t0 is { s: i32, u: i32 | null } {
    const uu = t0.u
    if uu is null { return t0.s }
    return t0.s + uu
  }
  0
}
print(readInline({ s: 20, u: 2 })) // 22

// ── `isVariantBoxUnionAtoms`: a variant-box union with a MAP arm alongside a struct ──
function readBoxed(v: { [string]: i32 } | { w: i32 }): i32 {
  const t0 = v
  if t0 is { [string]: i32 } { return t0["a"] ?? 0 }
  t0.w
}
print(readBoxed({ w: 7 })) // 7

// A union of TWO INLINE SHAPES: its synthetic name `{x:i32}|{y:i32}` also starts `{`,
// is not `{[`, and ends `}` — so ONLY the depth walk tells it apart from a single
// shape. A home that answers "single shape" here declines the whole registration.
function pick(v: { x: i32 } | { y: i32 }): i32 {
  const t0 = v
  if t0 is { x: i32 } { return t0.x }
  1
}
print(pick({ x: 8 })) // 8

// A closure RESULT that is a single inline shape, reached through a value call — the
// `wideShape` arm of the closure result-spine walk, the second `nameIsSingleShape`
// consumer (`internCloResultSpine`).
const mk: () => { p: i32 } = () => ({ p: 5 })
print(mk().p) // 5
