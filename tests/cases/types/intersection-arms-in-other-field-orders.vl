// @run
// @log p
// @log 1.5
// @log true
// @log 3
// @log 4
// @log q
// @log false
// @log 0.5
// @log 9
// @log e
// @log f
// @log 8
// @log true
// @log 3.5
// An intersection whose arms declare their fields in different orders reads each field by name,
// whatever order the record it builds keeps them in: a local, a parameter, a list element, a field.
type P = { z: i32, a: string } & { m: boolean, b: f64 }
type Q = { b: f64, m: boolean } & { a: string, z: i32 }
function show(p: P) {
  print(p.a)
  print(p.b)
  print(p.m)
  print(p.z)
}
function mk(): Q { return { z: 4, a: "q", m: false, b: 0.5 } }
const p: P = { a: "p", b: 1.5, m: true, z: 3 }
show(p)
const q = mk()
print(q.z)
print(q.a)
print(q.m)
print(q.b)
const ps: P[] = [{ m: false, z: 9, b: 2.5, a: "e" }]
print(ps[0].z)
print(ps[0].a)
const h: { inner: Q } = { inner: { a: "f", z: 8, b: 3.5, m: true } }
print(h.inner.a)
print(h.inner.z)
print(h.inner.m)
print(h.inner.b)
