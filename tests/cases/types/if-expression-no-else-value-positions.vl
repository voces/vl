// @run
// @log 7
// @log -1
// @log 7
// @log -1
// @log 7
// @log -1
// @log 7
// @log -1
// @log 7
// @log -1
// @log 7
// @log -1
// @log 7
// @log -1
// @log 7
// @log -1
// @log 7
// @log -1
// @log 7
// @log -1
// @log 7
// @log -1
// @hint redundant type annotation: `b` is inferred as `{v: i32 | null}`
// @hint redundant type annotation: `xs` is inferred as `(i32 | null)[]`
// @hint redundant type annotation: `xs` is inferred as `(i32 | null)[][]`
// CONTRACT (must-RUN): an else-less `if` used as a VALUE is `T | null` in EVERY value
// position, and lowers there (DECISIONS, "An else-less `if` used as a VALUE is `T | null`
// in every position"). The false path yields `null`; the true path yields the arm.
//
// ONE RULE, NOT A POSITION TABLE. The checker gives the same answer wherever the value is
// consumed, and the emitter's synthesized else arm is the rep's own null — so the list
// below is a POSITION MATRIX proving the delivery, not eleven separate features. It is
// written the way D965 says a lifted capability has to be graded: every syntactic position
// the value can reach, each CONSTRUCTING and DISCRIMINATING (the taken branch prints 7,
// the untaken prints -1), so a position nobody wired shows up as a wrong value or an
// invalid module rather than as a gap no fixture visits.
//
// The four that already ran before the ruling — a `let`/`const` binding, a return TAIL, a
// lambda result — are here too: a matrix that only holds the newly-built rows cannot see a
// build that breaks the rows it grew from.
function take(v: i32 | null): void {
  if v != null { print(v) } else { print(-1) }
}

// 1. binding, function scope
function bindFn(c: boolean): void {
  const x = if c { 7 }
  take(x)
}
bindFn(true)
bindFn(false)

// 2. binding, MODULE scope (a global cell, not a local slot)
const gTrue = if 1 == 1 { 7 }
const gFalse = if 1 == 2 { 7 }
take(gTrue)
take(gFalse)

// 3. explicit `return`
function retExplicit(c: boolean): i32 | null {
  return if c { 7 }
}
take(retExplicit(true))
take(retExplicit(false))

// 4. return TAIL (the implicit return)
function retTail(c: boolean): i32 | null {
  if c { 7 }
}
take(retTail(true))
take(retTail(false))

// 5. call ARGUMENT
take(if 1 == 1 { 7 })
take(if 1 == 2 { 7 })

// 6. struct FIELD init
type Box = { v: i32 | null }
function fieldInit(c: boolean): void {
  const b: Box = { v: if c { 7 } }
  take(b.v)
}
fieldInit(true)
fieldInit(false)

// 7. array ELEMENT
function listElem(): void {
  const xs: (i32 | null)[] = [if 1 == 1 { 7 }, if 1 == 2 { 7 }]
  take(xs[0])
  take(xs[1])
}
listElem()

// 8. assignment RHS, a LOCAL
function assignLocal(): void {
  let x: i32 | null = 0
  x = if 1 == 1 { 7 }
  take(x)
  x = if 1 == 2 { 7 }
  take(x)
}
assignLocal()

// 9. assignment RHS, a module GLOBAL (`emitAssign`'s `global.set` arm — the delivery
// reading the call sites misses, per D965)
let gAssign: i32 | null = 0
gAssign = if 1 == 1 { 7 }
take(gAssign)
gAssign = if 1 == 2 { 7 }
take(gAssign)

// 10. MAP value
function mapValue(): void {
  const m: {[string]: i32 | null} = Map()
  m["a"] = if 1 == 1 { 7 }
  m["b"] = if 1 == 2 { 7 }
  take(m["a"] ?? -1)
  take(m["b"] ?? -1)
}
mapValue()

// 11. NESTED element, and a CLOSURE result
function nestedAndClosure(): void {
  const xs: (i32 | null)[][] = [[if 1 == 1 { 7 }], [if 1 == 2 { 7 }]]
  take(xs[0][0])
  const f: (boolean) => i32 | null = (c: boolean) => if c { 7 }
  take(f(false))
}
nestedAndClosure()
