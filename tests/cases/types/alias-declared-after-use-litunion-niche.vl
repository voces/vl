// @run
// @log la
// @log la
// @log null
// @log null
// @log true
// @log true
// @log false
// @log false
// The same root at a different REP, and the reason a fix aimed at `boolean` is not
// enough: a NULLABLE LITERAL UNION field whose alias is declared BELOW the struct
// printed its INTERNED ATOM ID (`0`) instead of the member text (`la`). The atom is
// stored correctly — `!= null` and the narrowing both answer right — so this is the
// rendering classifier reading an arena entry the declaration order left as a
// one-member `TyUnion` wrapper instead of the `TyNullable` the alias denotes.
//
// AGREEMENT IS THE ASSERTION: each value is printed once through the forward-declared
// alias and once through the identical back-declared one.
//
// BOTH RUNTIME INPUTS, because the null input travels the niche's other arm: a present
// atom (`la`) and an absent one (`null`), and the `!= null` test at each.

// ── forward: the alias is declared BELOW the struct that names it ─────────────
type BoxFwd = { n: NicheFwd }
type NicheFwd = ("la" | "lb") | null

// ── back: the identical declarations, in the order that always worked ─────────
type NicheBack = ("la" | "lb") | null
type BoxBack = { n: NicheBack }

function go() {
  const fwd: BoxFwd = { n: "la" }
  const back: BoxBack = { n: "la" }
  if fwd.n != null { print(fwd.n) } else { print("null") }
  if back.n != null { print(back.n) } else { print("null") }

  const fwdN: BoxFwd = { n: null }
  const backN: BoxBack = { n: null }
  if fwdN.n != null { print(fwdN.n) } else { print("null") }
  if backN.n != null { print(backN.n) } else { print("null") }

  print(fwd.n != null)
  print(back.n != null)
  print(fwdN.n != null)
  print(backN.n != null)
}

go()
