// @run
// @log 8
// @log 2
// @log 1
// @log 5
// A TRANSPARENT one-member alias used as a UNION ARM and narrowed with `is` — for every
// arm of the transparency rule at once (D-ISALIAS).
//
// `canonEmitTypeNames` rewrites a union's members into the emitter's vocabulary, so a
// transparent alias member `L` becomes its member's emit name. The `is` type on the SAME
// annotation was not following: `is L` stayed spelled `L` and named a variant the emitter
// no longer had. The consequence was not a uniform clean miss — it depended on the arm:
//
//   type Id = i32        (the OLDEST arm)  -> INVALID MODULE  `failed to compile: wasm[0]`
//   type F = (i32)=>i32  (D-ALIASFN)       -> emit reject
//   type MyCat = Cat     (the TyObj arm)   -> emit reject ``is` names a type that is not
//                                             a union variant`
//   type L = i32[]       (D-ALIASARR)      -> INVALID MODULE
//
// All four are fixed by one rewrite, written against the transparency PREDICATE
// (`singleMemberAliasName`) rather than against any one arm — so the `is` spelling and the
// variant spelling are produced by the same function and cannot diverge. The rewrite is
// deliberately NOT a blanket `canonEmitName`: that softens a literal member to its base
// scalar (`"a"` -> `string`) and would destroy a literal-union `is` test that works today.
type Id = i32
type F = (i32) => i32
type Cat = { n: i32 }
type MyCat = Cat
type L = i32[]

const a: Id | string = 7
if a is Id {
  print(a + 1)
}

const inc = (n: i32) => n + 1
const b: F | i32 = inc
if b is F {
  print(b(1))
}

const c: L | i32 = [1, 2, 3]
if c is L {
  print(c[0])
}

const d: MyCat | i32 = { n: 5 }
if d is MyCat {
  print(d.n)
}
