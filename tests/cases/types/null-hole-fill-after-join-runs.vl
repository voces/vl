// @run
// @warning `j == null` is always false here (j is {w: string, k: i32} | In)
// @log true false
// @log true false
// @log true 2
// @log true false
// @log true false
// @log false false
// @log true false
// @log 9 4
// @log false false
// A binding `let m = null` read before a later write fills it with another record: inside a function
// the read is `null`, delivered as each destination's own null (D17203, D17204). A same-type fill,
// a write first and an annotated binding keep running, and so does a module join whose fill fits.
type In = { v: i32 }
type Out = { w: string, k: i32 }
type W = { w: string }
const rec: In = { v: 9 }
function id<T>(t: T): T { return t }
function joined(f: boolean) {
  let m = null
  const j = if f { m } else { rec }
  m = { w: "z", k: 4 }
  return j == null
}
function intoUnion(f: boolean) {
  let m = null
  const j: In | Out | null = if f { m } else { rec }
  m = { w: "z", k: 4 }
  return j == null
}
function typedRead() {
  let m = null
  const x: In | null = m
  m = { w: "z", k: 4 }
  return x == null
}
function listed() {
  let m = null
  const j = [m, rec]
  m = { w: "z", k: 4 }
  return j.length
}
function throughGeneric(f: boolean) {
  let m = null
  const j = id(if f { m } else { rec })
  m = { w: "z", k: 4 }
  return j == null
}
function sameFill(f: boolean) {
  let m = null
  const j = if f { m } else { rec }
  m = { v: 4 }
  return j == null
}
function writeFirst(f: boolean) {
  let m = null
  m = { w: "z", k: 4 }
  const j = if f { m } else { rec }
  return j == null
}
function annotated(f: boolean) {
  let m: Out | null = null
  const j = if f { m } else { rec }
  m = { w: "z", k: 4 }
  return j == null
}
let g = null
function pick(flag: boolean) { return if flag { g } else { rec } }
let h = null
function pickWide(flag: boolean): In | W | null { return if flag { h } else { rec } }
g = { v: 4 }
h = { w: "z" }
print("\{joined(true)} \{joined(false)}")
print("\{intoUnion(true)} \{intoUnion(false)}")
print("\{typedRead()} \{listed()}")
print("\{throughGeneric(true)} \{throughGeneric(false)}")
print("\{sameFill(true)} \{sameFill(false)}")
print("\{writeFirst(true)} \{writeFirst(false)}")
print("\{annotated(true)} \{annotated(false)}")
print("\{pick(false)?.v ?? -1} \{pick(true)?.v ?? -1}")
print("\{pickWide(false) == null} \{pickWide(true) == null}")
