// @check
// @error call `pick` after the assignment, or annotate the binding as Sub | null
// A call that reads the returned join before the fill typed it at the record the fill widens.
type In = { v: i32 }
type Sub = { v: i32, k: i32 }
const rec: In = { v: 9 }
const sub: Sub = { v: 4, k: 1 }
let m = null
function pick(flag: boolean) { return if flag { m } else { rec } }
print(pick(false)?.v ?? -1)
m = sub
print(pick(true)?.v ?? -1)
