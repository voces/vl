// @run
// @log hi
// @log bob
// @log HI
// @log BOB
// @log HI
// @log BOB
// @log false
// @log true
// @log NO
// @log YES
// @log bb
// @log aa
// @log NONE
// @log SOME
// @log NONE
// @log SOME
// @log NONE
// @log SOME
// @log 0
// @log 5
// A nullable NICHE answers `is null` at RUNTIME. Its rep is a `(ref null …)` (the string
// array, the i32-list backing, a scalar list's wrapper, the struct / map / closure ref) or
// an i32 SENTINEL (`boolean | null` → 2, `K | null` → -1) — never a union box — so the guard
// is the niche's own null test, the one `x == null` has always lowered
// (`emitNulIsNullTest`). Without that shared home the `is` side carried a nullable-STRUCT
// arm alone and every other niche fell to `monoStaticIsResult`, which names a receiver by
// the member it REPS as (`string`, `boolean`, `i32[]`, `K`) and so CONST-FOLDED the guard
// to FALSE: `vl check` clean, the WRONG BRANCH in statement position and a
// `ref.as_non_null` trap wherever the narrowed arm was the value.
//
// Both directions are covered per rep: `is null` (the test) and `is <member>` (its
// inverse). `i32 | null` and `f64 | null` are the CONTROLS that were never affected —
// they rep as a union box, which the static fold already declined.

// ── string | null ────────────────────────────────────────────────────────────
function strTail(name: string | null) {
  if name is null { "hi" } else { name }
}
print(strTail(null))
print(strTail("bob"))

function strStmt(name: string | null) {
  if name is null { print("HI") } else { print("BOB") }
}
strStmt(null)
strStmt("bob")

function strStmtIsT(name: string | null) {
  if name is string { print("BOB") } else { print("HI") }
}
strStmtIsT(null)
strStmtIsT("bob")

// ── boolean | null (the i32 sentinel 2) ──────────────────────────────────────
function boolTail(b: boolean | null) {
  if b is null { false } else { b }
}
print(boolTail(null))
print(boolTail(true))

function boolStmtIsT(b: boolean | null) {
  if b is boolean { print("YES") } else { print("NO") }
}
boolStmtIsT(null)
boolStmtIsT(true)

// ── K | null (the i32 sentinel -1) ───────────────────────────────────────────
type K = "aa" | "bb"
const kAa: K = "aa"

// The value-position (`if … { } else { }` as the function's value) form of this rep is a
// SEPARATE, pre-existing defect in the if-expression arm join, so the litunion guard is
// pinned in statement position here.
function litunStmt(k: K | null) {
  if k is null { print("bb") } else { print(k) }
}
litunStmt(null)
litunStmt(kAa)

// ── i32[] | null / string[] | null / {[string]: i32} | null (ref niches) ─────
const someInts: i32[] = [1, 2, 3]
const someStrs: string[] = ["a", "b"]

function listStmt(xs: i32[] | null) {
  if xs is null { print("NONE") } else { print("SOME") }
}
listStmt(null)
listStmt(someInts)

function strListStmt(xs: string[] | null) {
  if xs is null { print("NONE") } else { print("SOME") }
}
strListStmt(null)
strListStmt(someStrs)

const someMap: {[string]: i32} = Map()

function mapStmt(m: {[string]: i32} | null) {
  if m is null { print("NONE") } else { print("SOME") }
}
mapStmt(null)
mapStmt(someMap)

// ── the CONTROL that was never affected: `i32 | null` reps as a union box ────
function i32Tail(n: i32 | null) {
  if n is null { 0 } else { n }
}
print(i32Tail(null))
print(i32Tail(5))
