// The CORRECT half of `s?.f is T`: every field type whose rep is a real union BOX
// discriminates through an optional chain, at any chain depth.
//
// This is the column that identifies the mechanism, so it is pinned on its own. A boxed
// field makes `exprUnion` true for the chain receiver, which short-circuits the static
// `is` fold (`monoArgTyName` returns "" and `monoStaticIsResult` declines) and hands the
// guard to the box-tag compare, which decides it exactly.
//
// A NICHE-nullable field (`string | null`, `T[] | null`, `K | null`, a nullable struct or
// closure) and a ref-ELEMENT array union (`string[] | i32[]`) reach no such classifier, so
// the chain receiver falls to `monoArgTyName`'s `"i32"` CATCH-ALL DEFAULT and the guard
// const-folds FALSE — silently, `vl check` rc 0. Those cells are filed in
// `docs/internals/overlapping-arm-defects.md` (D9) and deliberately NOT pinned here: a
// pinned wrong answer becomes an invariant. This file is what stops a future fix for them
// from being bought by breaking the arms that already discriminate.
//
// `types/optional-chain.vl` pins the same contract for the `string | i32` field; the four
// rows here are the boxed shapes it does not carry, plus the nullable-STRUCT field whose
// chain NULL TEST is correct today and which the same fix must not disturb.

type A = { f: i32 | null }

function intField(s: A | null) {
  if s?.f is i32 { print("yes") } else { print("no") }
  0
}
intField({ f: 7 })
intField({ f: null })
intField(null)

type B = { f: i64 | null }

function longField(s: B | null) {
  if s?.f is i64 { print("yes") } else { print("no") }
  0
}
longField({ f: 7 })
longField({ f: null })
longField(null)

type C = { f: f64 | null }

function floatField(s: C | null) {
  if s?.f is f64 { print("yes") } else { print("no") }
  0
}
floatField({ f: 2.5 })
floatField({ f: null })
floatField(null)

type D = { f: i32[] | string }

function listOrStringField(s: D | null) {
  if s?.f is i32[] { print("yes") } else { print("no") }
  0
}
listOrStringField({ f: [1, 2] })
listOrStringField({ f: "hi" })

function listOrStringFieldStr(s: D | null) {
  if s?.f is string { print("yes") } else { print("no") }
  0
}
listOrStringFieldStr({ f: "hi" })
listOrStringFieldStr({ f: [1, 2] })

// The chain depth axis is FLAT for the boxed shapes, so the nested spelling gets one row.
type Outer = { g: A | null }

function nestedIntField(o: Outer | null) {
  if o?.g?.f is i32 { print("yes") } else { print("no") }
  0
}
nestedIntField({ g: { f: 7 } })
nestedIntField({ g: { f: null } })
nestedIntField(null)

// The one NICHE field whose chain NULL TEST is already correct — a nullable STRUCT field.
// It is the control for the other direction: the `?.` read itself is right here, so a fix
// for the `is` cells cannot be bought by disturbing it. (The string- and litunion-niche
// spellings of this same test are NOT correct today, which is why the `is` cells have no
// working sibling lowering to route into — see the filing.)
type Q = { a: i32 }
type E = { f: Q | null }

function structFieldNullTest(s: E | null) {
  if s?.f != null { print("yes") } else { print("no") }
  0
}
structFieldNullTest({ f: { a: 1 } })
structFieldNullTest({ f: null })
structFieldNullTest(null)
