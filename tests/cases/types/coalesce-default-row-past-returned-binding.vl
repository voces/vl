// @run
// @log 7
// @log 7
// @log 8
// @log 3
// @log 3
// @log 5
// CONTRACT (must-RUN, D882/D883/D885/D886): the callee-return reader reaches a returned
// BINDING, a returned CALL, a SELF-CALL and a binding bound FROM a call — and the literal it
// moves lands on the merged row.
//
// `anonLeafJoinCallee` refutes AS A WHOLE (its own header says why: one unmoved return path
// handed back through a moved return row is invalid wasm, not a lost member), so before this
// every one of these four shapes left the family as the default alone.
//
// READING THE BINDING IS ONLY HALF. The merged row had five named readers — the map's value
// slot (D841), the binding's cell (D842) and three return-row resolvers (D871) — and the
// SIXTH is the literal itself. `{ const v = { r: 7 }; v }` hands its literal to a plain local
// whose row is `structIndexOfObjCtx`'s answer, so with the return row moved and the literal
// left behind the callee built the narrow struct and returned it as the merged one: the loud
// reject became CHECK-CLEAN INVALID WASM. The redirect sits at that resolver now, keyed on the
// literal being a join MEMBER and armed only from `emitModule` on — `collectAnonShapes`' own
// mint loop needs the pre-merge answer to decide what to mint.
//
// A SELF-CALL IS NOT AN UNNAMEABLE PATH (D885): the frame that pushed the name is being read,
// so its return row is already marked and the recursive call hands back that same row. The
// read's visited set therefore ANSWERS on a repeat rather than refuting.
//
// A RETURNED PARAMETER STILL REFUSES and that is filed, not forgotten — see D888 and
// `distilled/named/d888_ret_param`. The literals reaching a parameter are the ARGUMENTS at
// every call site, and the parameter's slot row comes from its annotation, so it needs a
// seventh OWNER of the merged row rather than an eighth reader.

// ---- D882: the callee returns a BINDING ----
function srcb(): { r: i32 } | null {
  const v = { r: 7 }
  v
}

function rb() {
  const g1 = srcb() ?? { r: "s" }
  const v = g1.r
  if v is i32 { print(v) } else { print(0) }
}
rb() // 7

// The same callee used OUTSIDE any `??` keeps working — the row moved for both readers.
function keep() {
  const q = srcb()
  if q != null { print((q).r) }
}
keep() // 7

// A REASSIGNED binding: every store has to be nameable, and both are.
function srcr(f: boolean): { r: i32 } | null {
  let v = { r: 7 }
  if f { v = { r: 8 } }
  v
}

function rr() {
  const g2 = srcr(true) ?? { r: "s" }
  const v = g2.r
  if v is i32 { print(v) } else { print(0) }
}
rr() // 8

// ---- D883/D886: the callee returns a CALL, and a binding bound FROM a call ----
function mid(): { r: i32 } | null { { r: 3 } }

function srcc(): { r: i32 } | null { mid() }

function rc() {
  const g3 = srcc() ?? { r: "s" }
  const v = g3.r
  if v is i32 { print(v) } else { print(0) }
}
rc() // 3

function srcbc(): { r: i32 } | null {
  const w = mid()
  w
}

function rbc() {
  const g4 = srcbc() ?? { r: "t" }
  const v = g4.r
  if v is i32 { print(v) } else { print(0) }
}
rbc() // 3

// ---- D885: a SELF-RECURSIVE return path ----
function srcs(n: i32): { r: i32 } | null {
  if n <= 0 { return { r: 5 } }
  srcs(n - 1)
}

function rs() {
  const g5 = srcs(2) ?? { r: "u" }
  const v = g5.r
  if v is i32 { print(v) } else { print(0) }
}
rs() // 5
