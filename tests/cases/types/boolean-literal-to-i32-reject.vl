// @check
// @error cannot assign boolean to 'x' of type i32 — a `boolean` is not a number; convert it with `b as i32`
// A bare boolean LITERAL in an `i32` slot is refused like any other boolean value; the
// refusal names the conversion, and `true as i32` is the spelling that runs
// (`boolean-as-number.vl`).
const x: i32 = true
print(x)
