// @run
// @log 1
// @log 0
// @log 1
// @log 0
// @log 1
// @hint redundant type annotation: `t` is inferred as `boolean`
// @hint redundant type annotation: `f` is inferred as `boolean`
// @hint redundant type annotation: `asI32` is inferred as `i32`
// @hint redundant type annotation: `n` is inferred as `i32`
// @hint redundant type annotation: `z` is inferred as `i32`
// @hint redundant type annotation: `isEq` is inferred as `i32`
// A `boolean` is not an `i32`, and the conversion is written where it happens: `b as i32` is
// 1 for `true` and 0 for `false`. This file pins the three SCALAR boundaries, binding,
// argument and return; `boolean-to-i32-container-positions.vl` pins the containers, and
// `boolean-to-i32-container-reject.vl` pins every position refusing the unconverted value.

// boolean variable into an i32-annotated binding.
const t: boolean = true
const n: i32 = t as i32
print(n) // 1

const f: boolean = false
const z: i32 = f as i32
print(z) // 0

// boolean value into an i32 parameter (the call-argument boundary).
function asI32(x: i32): i32 { x + 0 }
const one = asI32(t as i32)
print(one) // 1
const two = asI32(f as i32)
print(two) // 0

// A `boolean` comparison result converted at an `i32` return (the return boundary).
function isEq(a: i32, c: i32): i32 { (a == c) as i32 }
const eq = isEq(5, 5)
print(eq) // 1
