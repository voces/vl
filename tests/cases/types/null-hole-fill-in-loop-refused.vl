// @check
// @error this `if` was typed In | null — the assignment below makes the binding {w: string, k: i32} | null, so the join is {w: string, k: i32} | In | null; annotate the binding
// @warning Field `In.v` is never read (remove it)
// In a loop, an inferred-null binding's write reaches the read at the loop's top again, so the
// read is the open hole; a value `if` over it typed before the write is refused at the fill, as
// at module scope (D17203, D17206).
type In = { v: i32 }
const rec: In = { v: 9 }
function run(f: boolean) {
  let m = null
  let out = ""
  let i = 0
  while i < 2 {
    const j = if f { m } else { rec }
    out = out + (if j == null { "n" } else { "v" })
    m = { w: "z", k: 4 }
    i = i + 1
  }
  return out
}
print(run(true))
