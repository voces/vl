// @run
// @log 7
// @log 8
// @log 9
// @log 10
// CONTRACT (must-RUN): D913. `anonLeafBoundValOk` splits ONE value written to a returned
// binding three ways — a literal is a member, a `null` is neither, a CALL is the next frame
// (D886) — and refuted everything else. So D882's binding arm and D891's parameter arm could
// not compose: `{ const v = p; v }` was check-clean invalid wasm while `{ p }` and
// `{ const v = { r: 7 }; v }` both ran.
//
// THE IDENT ARM NEEDED `body`, because a returned name resolves against the frame that returned
// it — the same argument `anonLeafCalleeRets` already carries for D882's own scan.
//
// AND IT NEEDED A NAME-VISITED SET, which is the half that is not obvious. `fns` bounds the
// CALL recursion and `depth` caps it at one frame; an identifier chain opens neither, so
// `let a = p; let b = p; a = b; b = a; a` re-entered the resolver for ever. `ids` answers a
// name already on the path exactly as `fns` answers a function already on it: the frame that
// pushed it is being read, so its sources are already in the family.
//
// THE BOUND is `distilled/named/d913_ret_binding_of_field`: a binding written from a FIELD READ
// is still a path this cannot name, and it still refutes the whole callee.

// ---- a returned binding whose value is the PARAMETER ----
function srcp(p: { r: i32 }): { r: i32 } | null {
  const v = p
  v
}

function rp() {
  const g1 = srcp({ r: 7 }) ?? { r: "s" }
  print(g1.r)
}
rp() // 7

// ---- a returned binding whose value is another LOCAL ----
function srcl(): { r: i32 } | null {
  const w = { r: 8 }
  const v = w
  v
}

function rl() {
  const g1 = srcl() ?? { r: "s" }
  print(g1.r)
}
rl() // 8

// ---- a CHAIN of them, ending at the parameter ----
function srcc(p: { r: i32 }): { r: i32 } | null {
  const v = p
  const w = v
  w
}

function rc() {
  const g1 = srcc({ r: 9 }) ?? { r: "s" }
  print(g1.r)
}
rc() // 9

// ---- THE CYCLE the visited set exists for ----
function srcy(p: { r: i32 }): { r: i32 } | null {
  let a = p
  let b = p
  a = b
  b = a
  a
}

function ry() {
  const g1 = srcy({ r: 10 }) ?? { r: "s" }
  print(g1.r)
}
ry() // 10
