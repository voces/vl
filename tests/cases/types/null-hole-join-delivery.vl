// @run
// @log 5 9
// @log 9 5
// @log 5 9
// @log 9 5
// @log true false
// @log false true
// @log true false
// @log false true
// @log 5 0 7 1
// @log true 1 false 2
// A value `if` joining a `null` (a literal, or an inferred-null binding `const n = null`) with a
// record is delivered as `In | null` / `{ a: i32 } | null`: under a `??` and into an `A | B | null`
// parameter, in both arm orders, and a counted call in the other arm runs once per evaluation.
type In = { v: i32 }
type A = { a: i32 }
type B = { b: string }
const rec: In = { v: 9 }
const n = null
let calls = 0
function mk(): In {
  calls = calls + 1
  return { v: 7 }
}
function mkA(): A {
  calls = calls + 1
  return { a: 2 }
}
function isNU(x: A | B | null) { return x == null }
function coalHoleThen(f: boolean) { return ((if f { n } else { rec }) ?? { v: 5 }).v }
function coalHoleElse(f: boolean) { return ((if f { rec } else { n }) ?? { v: 5 }).v }
function coalLitThen(f: boolean) { return ((if f { null } else { rec }) ?? { v: 5 }).v }
function coalLitElse(f: boolean) { return ((if f { rec } else { null }) ?? { v: 5 }).v }
function argHoleThen(f: boolean) { return isNU(if f { n } else { { a: 1 } }) }
function argHoleElse(f: boolean) { return isNU(if f { { a: 1 } } else { n }) }
function argLitThen(f: boolean) { return isNU(if f { null } else { { a: 1 } }) }
function argLitElse(f: boolean) { return isNU(if f { { a: 1 } } else { null }) }
function coalCall(f: boolean) { return ((if f { n } else { mk() }) ?? { v: 5 }).v }
function argCall(f: boolean) { return isNU(if f { n } else { mkA() }) }
print("\{coalHoleThen(true)} \{coalHoleThen(false)}")
print("\{coalHoleElse(true)} \{coalHoleElse(false)}")
print("\{coalLitThen(true)} \{coalLitThen(false)}")
print("\{coalLitElse(true)} \{coalLitElse(false)}")
print("\{argHoleThen(true)} \{argHoleThen(false)}")
print("\{argHoleElse(true)} \{argHoleElse(false)}")
print("\{argLitThen(true)} \{argLitThen(false)}")
print("\{argLitElse(true)} \{argLitElse(false)}")
print("\{coalCall(true)} \{calls} \{coalCall(false)} \{calls}")
print("\{argCall(true)} \{calls} \{argCall(false)} \{calls}")
