// @run
// @log 5
// @log 5
// @log true
// @log true
// @warning `x` shadows the `x` declared at
// @info `x` is never reassigned; use `const` instead of `let`
// @info `g` is never reassigned; use `const` instead of `let`
// A `let x = null` whose only later writes go to an inner `let x` that shadows it: the outer
// hole is never filled, so it is the `null` type, at function and at module scope alike. A
// statement scan that does not stop at the inner declaration would read `x = 5` as the outer
// binding's fill and give it a `i32 | null` box.
function local() {
  let x = null
  if true {
    let x = 1
    x = 5
    print(x)
  }
  print(x == null)
}

let g = null
{
  let g = 1
  g = 5
  print(g)
}

local()
print(g == null)
