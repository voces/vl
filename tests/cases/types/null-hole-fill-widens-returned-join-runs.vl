// @run
// @log 9
// @log 4
// @log 9
// @log 4
// A binding inferred `null` and filled, after a function returned an `if` joining it with a
// record, by a wider record: the function's return follows the fill, so the join is a box of
// both records (D17208, D17209).
type In = { v: i32 }
type Sub = { v: i32, k: i32 }
const rec: In = { v: 9 }
const sub: Sub = { v: 4, k: 1 }
let m = null
function pick(flag: boolean) { return if flag { m } else { rec } }
m = sub
print(pick(false)?.v ?? -1)
print(pick(true)?.v ?? -1)
let w = null
function wide(flag: boolean) { return if flag { w } else { rec } }
w = { v: 4, k: 1 }
print(wide(false)?.v ?? -1)
print(wide(true)?.v ?? -1)
