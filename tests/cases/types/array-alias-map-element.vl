// @run
// @log 9
// @log 9
// @log 1
// @log 9
// @log 1
// @log 4
// @log 1
// @log 7
// @log 2
// @log 5
// @log 3
// @log 1
// @hint redundant type annotation: `g` is inferred as `{[string]: i32}[]`
// @hint redundant type annotation: `c` is inferred as `{[string]: i32}[]`
// @hint redundant type annotation: `h` is inferred as `{xs: {[string]: i32}[]}`
// @hint redundant type annotation: `ll` is inferred as `{[string]: i32}[][]`
// @hint redundant type annotation: `c` is inferred as `{[string]: i32}[][]`
// @hint redundant type annotation: `c` is inferred as `{[string]: i32[]}[]`
// @hint redundant type annotation: `c` is inferred as `{[string]: Cat}[]`
// @hint redundant type annotation: `which` is inferred as `i32`
// @hint redundant type annotation: `c1` is inferred as `{[string]: i32}[]`
// @hint Intentionally-unused variable `_sp1`
// THE MAP-LEAF half of D-ALIASARR: `type L = {[string]: i32}[]` denotes `{[string]: i32}[]`,
// in every position — the third leaf kind beside `array-alias-transparent.vl` (a primitive
// leaf) and `array-alias-nominal-element.vl` (a declared-struct leaf).
//
// The array arm of `singleAliasMemberTyIx` had exactly two leaf tests, and both are named
// for the RENDERER that is faithful for that leaf: `arrSpineIsScalar` (`tyToEmitName`) and
// `arrSpineIsNominal` (`tyToNominalName`). A MAP leaf answered neither, so `type L =
// {[string]: i32}[]` stayed OPAQUE and `collectU` minted it a one-variant union ROW — which
// sets `uDeclared`, mints the shared `{tag: i32, value: anyref}` box, and makes `isUName("L")`
// claim every `L`-annotated cell for that box while the initializer lowers a list wrapper.
// `vl check` rc 0 and a module the engine refuses: `expected (ref $type), found (ref $type)`.
//
// The question was already answered ONE ARM BELOW, for the same construction with no array on
// top of it: the bare `TyMap` member is claimed with NO GATE AT ALL, because `tyToEmitNameGo`'s
// map arm emits `{[K]:V}` for every value there is — "a map alias has no nominal route to lose
// because a map name is never a route" (`alias-positions-and-value-kinds.vl`). Array layers
// re-render their element, so putting one or three on top of a map creates no name to drop.
//
// `{[string]: Cat}[]` — a DECLARED-STRUCT map value — is the one value kind where the two
// renderers disagree (`{[string]:{n:i32}}[]` vs `{[string]:Cat}[]`), and it renders NOMINALLY
// for the same reason the declared-struct LEAF does. Without that leg the alias spelling at
// `f(x: L | i32)` is `emitProgram: array value does not match any array member of the union`
// where the direct spelling runs — three cells of the 544-pair alias-vs-inline twin table,
// and the only three that moved backward when the claim landed alone.
type L = {[string]: i32}[]

// A BINDING, and the read through it.
function mkOne(v: i32): L {
  const m: {[string]: i32} = Map()
  m["k"] = v
  const c: L = [m]
  return c
}
const g: L = mkOne(9)
print((g[0])["k"] ?? 0)

// A PARAMETER…
function firstK(xs: L) { return (xs[0])["k"] ?? 0 }
print(firstK(mkOne(9)))

// …a RETURN annotation (`mkOne` above) read for its length…
print(mkOne(1).length)

// …and a function LOCAL.
function localRead() {
  const c: L = mkOne(9)
  print((c[0])["k"] ?? 0)
}
localRead()

// A STRUCT FIELD.
type Holder = { xs: L }
function fieldRead() {
  const h: Holder = { xs: mkOne(1) }
  print(h.xs.length)
}
fieldRead()

// UNDER `| null`, the position that was CHECK-CLEAN INVALID WASM rather than a loud reject
// on the parent: the cell took the union box and the initializer built the list wrapper.
function nullableRead() {
  const nv: L | null = mkOne(4)
  if nv != null { print((nv[0])["k"] ?? 0) } else { print(0) }
}
nullableRead()

// An ARRAY ELEMENT — the alias one container further out.
function elemRead() {
  const ll: L[] = [mkOne(1)]
  print(ll.length)
}
elemRead()

// A NESTED SPINE (`{[string]: i32}[][]`): `arrSpineIsMap` peels the whole spine, as both its
// twins do, so a two-deep body is not a separate arm.
type LL = {[string]: i32}[][]
function nested() {
  const m: {[string]: i32} = Map()
  m["k"] = 7
  const c: LL = [[m]]
  print(((c[0])[0])["k"] ?? 0)
}
nested()

// A MAP-OF-LIST VALUE inside the list (`{[string]: i32[]}[]`) — the leaf is still the map.
type LML = {[string]: i32[]}[]
function mapOfList() {
  const m: {[string]: i32[]} = Map()
  m["k"] = [1, 2]
  const c: LML = [m]
  print(((c[0])["k"] ?? []).length)
}
mapOfList()

// A DECLARED-STRUCT map value, and the UNION-MEMBER position that needs the nominal render.
type Cat = { n: i32 }
type LC = {[string]: Cat}[]
function mkCat(v: i32): LC {
  const m: {[string]: Cat} = Map()
  m["k"] = { n: v }
  const c: LC = [m]
  return c
}
print(((mkCat(5)[0])["k"] ?? { n: 0 }).n)
function which(x: LC | i32): i32 {
  if x is i32 { return 0 }
  return 3
}
print(which(mkCat(1)))

// D181's own shape: the alias and ONE UNREAD binding of it standing beside a structurally-
// spelled list of maps that carries the reads. That is the SILENT form — the alias must be
// USED for anything to happen (an alias nothing is annotated with runs), and the binding
// that uses it must be one nobody reads, or the same defect is a LOUD check reject
// (`field 'length' is not on every member of Box1`). `_sp1` is unread because the language
// forbids reading a `_`-prefixed binding. The census's `claim` axis is the only spelling in
// that grid that uses a container alias, which is why its 2,254-cell rescue set reads as a
// claimant count and is not one.
type Box1 = {[string]: i32}[]
const _sp1: Box1 = []
const lv1: {[string]: i32} = Map()
lv1["k0"] = 7
const c1: {[string]: i32}[] = [lv1]
print(c1.length)
