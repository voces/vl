// @check
// @error print of S is type-valid but not yet supported by codegen
// CONTRACT (must-error): the same admission for a STRUCT. This cell is why the fix is not
// "teach `print` to lower arrays": 14 of the 25 silently-invalid cells are not arrays —
// structs, maps, sets, function values, nullable arrays and struct unions all failed with
// the SAME validator message from the SAME instruction.
type S = { v: i32 }
const s: S = { v: 1 }
print(s)
