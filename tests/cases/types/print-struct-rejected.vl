// @check
// @error print expects one scalar or string value (i32 | i64 | f32 | f64 | boolean | string), got S — print the elements or fields individually, e.g. `print(xs[0])`
// CONTRACT (must-error): the same DOMAIN rejection for a STRUCT. This cell is why the fix
// is not "teach `print` to lower arrays": 14 of the 25 silently-invalid cells are not arrays —
// structs, maps, sets, function values, nullable arrays and struct unions all failed with
// the SAME validator message from the SAME instruction.
type S = { v: i32 }
const s: S = { v: 1 }
print(s)
