// @run
// @log 17
// @log nilM
// @log 27
// @log nilR
// @log 37
// @log nilIs
// THE MAP INNER of `types/nullable-alias-unparenthesized-structural-inner.vl`'s ruling,
// on its own: an un-parenthesized `type TM = M | null` over a declared map denotes the
// niche, like the parenthesized declaration and the inline annotation, at both runtime
// inputs.
//
// NO NARROWED NULLABLE STRUCT IN THIS PROGRAM, ON PURPOSE. A nullable-map parameter
// standing beside a narrowed nullable-struct parameter is a pre-existing invalid module
// (`type mismatch: expected (ref null $type), found (ref null $type)` — two distinct
// `$type` indices the engine prints identically) that reproduces with no alias anywhere,
// in the alias-free INLINE spelling. Mixing the two here would pin an emitter defect
// this file has no claim on.
//
// Reddens on a log mismatch as well as on a verdict: every value printed is read back
// through the narrowed map at BOTH runtime inputs, with a distinct offset per form.

type M = {[string]: i32}
type TM = M | null

// The INDEX READ through the narrow — the witness. `cannot index non-array
// {[string]: i32} | null` was the two-member wrapper leaking into the checker.
function fM(x: TM) {
  if x != null { print((x["k"] ?? 0) + 10) } else { print("nilM") }
}
const mv: M = Map()
mv["k"] = 7
fM(mv)
fM(null)

// RETURNED through an alias-typed return and re-narrowed at the call site.
function rM(x: TM): TM { return x }
function jM(x: TM) {
  const y = rM(x)
  if y != null { print((y["k"] ?? 0) + 20) } else { print("nilR") }
}
jM(mv)
jM(null)

// `is <Inner>` on the alias, the form the two-member union carried through its variant
// row while every read of the value lowered the niche.
function iM(x: TM) {
  if x is M { print((x["k"] ?? 0) + 30) } else { print("nilIs") }
}
iM(mv)
iM(null)
