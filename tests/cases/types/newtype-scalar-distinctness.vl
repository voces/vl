// @run
// @log 1
// @log 2
// @log 3
// @log 2
// @log true
// @log false
// @log 7
// @log 7
// A NOMINAL NEWTYPE is distinct from its base and from a sibling, and it is FREE.
//
// `type N = new B` (webcraft P1.5 / A14, `docs/internals/newtype-design.md`) mints
// an identity a structural checker otherwise cannot express: `EntityId`,
// `PlayerSlot` and `i32` are one type without it, so a generation-tagged entity id
// passed where a player index goes is silent. The rejects live beside this file in
// `newtype-scalar-rejects.vl`; this one pins what still WORKS, which is the half a
// nominal type is usually accused of taking away.
//
// `new` is a CONTEXTUAL keyword — recognized only immediately after a `type`
// declaration's `=`, so it is still an ordinary identifier everywhere else
// (`newtype-new-is-still-an-identifier.vl` pins that).
type EntityId = new i32
type PlayerSlot = new i32

// A LITERAL is brand-polymorphic: it has no prior identity, so it adopts the
// destination's brand in every binding position. That is what keeps sentinel
// constants writable, and it is the same contextual-literal rule VL already
// applies to a float literal reaching an `f32` slot.
const a: EntityId = 1
const b: EntityId = 2
print(a)
print(b)

// Same-brand arithmetic is allowed and the result KEEPS the brand — the WC3 ids
// this type exists for do arithmetic. A literal operand adopts, so `a + 1` is an
// `EntityId` too.
// (The annotation is left off deliberately: the redundant-annotation hint reports
// `sum` as inferred `EntityId`, which is the brand-preservation proof.)
const sum = a + b
print(sum)
print(a + 1)
print(a == b - 1)
print(a == 9)

// `as` is BOTH the construction and the unwrap form; it already resolved through
// an alias, and a branded scalar answers `primNameOf` with its base, so the cast
// ladder needed no new arm.
const raw = 7
const made = raw as EntityId
print(made as i32)

function ident(v: EntityId): EntityId { return v }
print(ident(made) as i32)
