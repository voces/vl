// @run
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 3
// @log 7
// @log 1
// @hint redundant type annotation: `c` is inferred as `{n: i32}[]`
// @hint redundant type annotation: `lc` is inferred as `{n: i32}[]`
// @hint redundant type annotation: `h` is inferred as `{xs: {n: i32}[]}`
// @hint redundant type annotation: `which` is inferred as `i32`
// @hint redundant type annotation: `cc` is inferred as `{p: {n: i32}}[]`
// @hint redundant type annotation: `whichC` is inferred as `i32`
// @hint redundant type annotation: `n2` is inferred as `{n: i32}[][]`
// @hint Intentionally-unused variable `_sp1`
// @hint redundant type annotation: `c1` is inferred as `{n: i32}[]`
// D188 — THE INLINE-OBJECT-SHAPE LEAF of an array alias, and the FOURTH and last leaf kind
// of the array spine beside `array-alias-transparent.vl` (a primitive leaf),
// `array-alias-nominal-element.vl` (a declared struct) and `array-alias-map-element.vl`
// (a map).
//
// IT IS TWO RUNGS AND THE FIRST OF THEM IS IN THE PARSER, which is what the row filed as
// D188 had wrong. `type L = {n: i32}[]` never reached the alias transparency rule at all: a
// `{`-leading declaration body took `parseTypeDecl`'s STRUCT path, no continuation arm
// claimed the `[]` after the closing brace, and the declaration completed as the plain
// struct `{n: i32}` with the two bracket tokens re-lexed as the NEXT statement — an empty
// array literal. `vl fmt` printed the parse back verbatim: `type L = {n: i32}; []`.
// A counter build read `reach=0` at the transparency arm the row had blamed.
//
// BOTH READINGS OF THE MISPARSE ARE WRONG AND ONE IS SILENT. Using `L` as the array it says
// it is was a loud check reject at every position (`cannot assign {n: i32}[] to 'c' of type
// L`); using it as the STRUCT it was misparsed into COMPILED AND PRINTED. The loud half is
// what got filed because it is the half an author writing an array alias hits first.
//
// THE SECOND RUNG IS `arrSpineIsObj`, AND WITHOUT IT THE FIRST ONE IS A REGRESSION. With the
// parser fixed and the transparency arm absent, the nine `unread`-position programs of this
// family go from a loud check reject to CHECK-CLEAN INVALID WASM — the parser starts
// producing an array alias `singleAliasMemberTyIx` has no arm for, `collectU` mints it a
// one-variant union row, and the cell takes the union box while the initializer lowers a
// list wrapper. That is D181's shape exactly. The nine are kept whole as the named set
// `d188-rung-price`.
//
// THE MODULE IS BYTE-IDENTICAL TO THE DIRECT SPELLING'S. `type L = {n: i32}[]` with
// `const c: L = [{n: 7}]` and the alias-free `const c: {n: i32}[] = [{n: 7}]` build to the
// same 226 bytes, `cmp` clean — the alias stops being a dialect rather than acquiring a
// better one.
type L = {n: i32}[]

// A BINDING, and the read through it.
const c: L = [{ n: 7 }]
print(c[0].n)

// A PARAMETER…
function firstN(xs: L) { return xs[0].n }
print(firstN([{ n: 7 }]))

// …a RETURN annotation…
function mkL(): L { [{ n: 7 }] }
print(mkL()[0].n)

// …and a function LOCAL.
function localRead() {
  const lc: L = [{ n: 7 }]
  print(lc[0].n)
}
localRead()

// A STRUCT FIELD.
type Holder = { xs: L }
function fieldRead() {
  const h: Holder = { xs: [{ n: 7 }] }
  print((h.xs)[0].n)
}
fieldRead()

// A UNION MEMBER — the position `array-alias-map-element.vl` needed the nominal render for.
function which(x: L | i32): i32 {
  if x is i32 { return 0 }
  return x[0].n
}
print(which([{ n: 7 }]))

// A LEAF WHOSE FIELD NAMES A DECLARED STRUCT. This one takes the NOMINAL leg of
// `transparentMemberEmitName`, and the prediction that an inline shape would not need it
// was built and refuted: the shape has no name of its own to drop but its FIELD does, and
// `tyToEmitNameAt` re-renders `{p: Cat}[]` to `{p:{n:i32}}[]` while canon leaves the direct
// spelling `{p:Cat}[]` — the name the emitter's element tables key on.
type Cat = { n: i32 }
type LC = {p: Cat}[]
const cc: LC = [{ p: { n: 7 } }]
print(cc[0].p.n)
function whichC(x: LC | i32): i32 {
  if x is i32 { return 0 }
  return x[0].p.n
}
print(whichC([{ p: { n: 7 } }]))

// A NESTED SPINE. `type L2 = {n: i32}[][]` was `expected an expression but found RBRACK` on
// master — the same misparse one bracket further on, and the bound
// `scripts/silent-sweep/census/README.md` recorded under *What the census could NOT reach*.
type L2 = {n: i32}[][]
function nested() {
  const n2: L2 = [[{ n: 7 }], [{ n: 1 }], [{ n: 2 }]]
  print(n2.length)
  print((n2[0])[0].n)
}
nested()

// D181's own shape — the alias and ONE UNREAD binding of it beside a structurally-spelled
// twin that carries the reads. This is the coordinate the `d188-rung-price` set is built
// from: it is the SILENT form of the same gap, and the one that reappears if the parser
// rung lands without the transparency arm.
const _sp1: L = []
const c1: {n: i32}[] = [{ n: 7 }]
print(c1.length)
