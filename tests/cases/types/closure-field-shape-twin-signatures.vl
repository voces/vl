// @run
// @log s
// @log 7
// @log 7
// @log s
// @log 1
// CONTRACT (D1092, the twin face): two struct shapes with the SAME field name and DIFFERENT
// closure signatures are two rows, and one shape spelled twice is still one row.
//
// `annShapeIndexOf` matches on field names, codes and ELEMENT names — and a closure field's
// element name is "". So `{f: () => string}` and `{f: () => i32}` matched, the second
// annotation resolved the FIRST's row, its own spelling then resolved no row at all
// (`structIndexByName` → -1) and the parameter's valtype was `emitProgram: ref valtype with no
// interned shape`, on a program `vl check` accepts. `sFieldCloSig` banks the `$fnsig` KEY per
// field — a KEY and not the text, because two closure fields with one rep spine really are
// interchangeable in a row. "" is UNKNOWN, never "no signature", so any recorder that cannot
// resolve one leaves the pair's behaviour exactly as it was.
//
// THE MIXED SPELLING IS THE HALF A DECLARED-ROW SPECIAL CASE WOULD MISS: `type Fn = {f: () =>
// i32}` beside an inline `{f: () => string}` failed too, so the DECLARED recorder has to bank
// the column as well. It reads it off the ARENA (`sigKeyOfTy`) rather than re-rendering the
// field text #1615 deleted as dead.
//
// CONSTRUCT AND DISCRIMINATE, AND SWEEP CALL ORDER: each shape is built and called, the two
// signatures return distinguishable values, `same2` proves the same-signature pair still
// SHARES one row (it takes the value `same1` built), and `takeStr` is called both before and
// after `takeNum` so a row minted in the wrong order shows up as a wrong value.
type Fn = {f: () => i32}

function takeStr(z: {f: () => string}) {
  z.f()
}

function takeNum(y: Fn) {
  y.f()
}

// A THIRD spelling with the SAME signature as `takeStr`'s: it must keep sharing that row.
function same1(w: {f: () => string}) {
  w
}

function same2(v: {f: () => string}) {
  v.f()
}

// A DIFFERENT ARITY at the same field name is a distinct row too.
function takeArity(a: {f: (i32) => i32}) {
  a.f(7)
}

function rd() {
  const sv = { f: () => "s" }
  const nv = { f: () => 7 }
  print(takeStr(sv))
  print(takeNum(nv))
  print(takeArity({ f: (n: i32) => n }))
  print(same2(same1(sv)))
  print(1)
}

rd()
