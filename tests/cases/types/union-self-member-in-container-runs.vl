// @run
// @log 1
// @log 2
// A union that refers to itself inside a list or a record field is not D16733's self-member: it
// runs.
type J = i32 | string | J[]
type T = { v: i32, next: T | null }
const j: J = [1, "a"]
const t: T = { v: 1, next: { v: 2, next: null } }
if j is J[] { print(j.length - 1) }
print(t.next?.v ?? 0)
