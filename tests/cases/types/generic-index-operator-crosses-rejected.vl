// @check
// The half of `generic-index-operator-binds.vl` that a wrong answer also passes.
//
// A site that types `x[i]` at the operator's DECLARED return hands back the bare
// type parameter, and an UNBOUND type variable is assignable to everything — so
// both lines below type-check, and the module that comes out cannot instantiate
// (`type mismatch: expected (ref $type), found i32`). `vl check` clean and
// invalid wasm is the pair this repo treats as a defect class, and the positive
// file cannot see it: every binding it asserts is one the wrong answer accepts
// too.
//
// The write mirror is pinned with the read because `"[]="`'s VALUE parameter is
// a template in exactly the same way, and a rule taught to one is half a rule.
// @error-at 26:17 argument 1: expected string, got i32
// @error-at 27:8 index write: expected i32, got string

type Box<T> = { v: T }

function "[]"<T>(self: Box<T>, _i: i32): T { return self.v }

function "[]="<T>(self: Box<T>, _i: i32, v: T) { self.v = v }

function shout(s: string) { return s.length }

const bi = { v: 7 }

print(shout(bi[0]))
bi[0] = "nope"
// @hint Intentionally-unused parameter `_i`
// @hint Intentionally-unused parameter `_i`
