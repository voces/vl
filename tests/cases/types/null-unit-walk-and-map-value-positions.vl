// @run
// @log 3
// @log 3
// @log true
// @log true
// @log a
// @log b
// @log 2
// A `for` over a `null[]` walks its i32 sentinels, at module scope and in a function; a
// `null`-valued map stores `null` as its sentinel, by `.set` and by an index store.
const ys: null[] = [null, null, null]
let seen = 0
for v in ys {
  if v == null { seen = seen + 1 }
}
print(seen)
function walk(xs: null[]) {
  let n = 0
  for x in xs { n = n + 1 }
  return n
}
print(walk(ys))
const m: {[string]: null} = Map()
m.set("a", null)
m["b"] = null
print(m.has("a") && m.has("b"))
print(m["a"] == null)
for k, v in m { print(k) }
let c = 0
for k, v in m {
  if v == null { c = c + 1 }
}
print(c)
