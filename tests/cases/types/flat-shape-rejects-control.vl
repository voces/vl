// @run
// @log 5
// @hint redundant type annotation: `g` is inferred as `{a: i32}`
// @hint redundant type annotation: `s` is inferred as `i32`
// @hint redundant type annotation: `i` is inferred as `{a: i32, b: i32}`
// @hint redundant type annotation: `n` is inferred as `{size: i32}`
// THE INVERTED CONTROL for `flat-shape-rejects.vl`: every declaration next door,
// with `flat` deleted. All of them check clean.
//
// The RECURSIVE pair is the one worth looking at. `type Cycle = { other: Loop }`
// and its partner are perfectly ordinary VL — a non-flat record field is a
// REFERENCE, so the cycle is finite at runtime and the types are fine. The reject
// next door is not "recursion is bad", it is "an INLINE record cannot contain
// itself", and only this control makes that distinction visible.
type Gen<T> = { a: T }
type Scalar = i32
type Isect = { a: i32 } & { b: i32 }
type Named = { size: i32 }
type Also = { me: Also | null }
const g: Gen<i32> = { a: 1 }
const s: Scalar = 1
const i: Isect = { a: 1, b: 1 }
const n: Named = { size: 1 }
const m: Also = { me: null }
let tail = 0
if m.me == null { tail = 1 }
print(g.a + s + i.a + n.size + tail)
