// @run
// @log a
// @log a
// @log b
// @log a
// @log a
// @log emptyN
// @log emptyS
// A ONE-MEMBER ALIAS OVER A NULLABLE, and the null TEST on it — three spellings of one
// type on adjacent lines (`new (T | null)`, `(T | null)` behind an alias, and the bare
// `T | null`), for a litunion inner and a primitive inner.
//
// WHY IT IS A FIXTURE, PART ONE — the alias's own rep. Such an alias was OPAQUE, so
// `collectU` minted it a one-variant union ROW and `isUName` claimed every slot for the
// `{tag, anyref}` box while every read lowered the NICHE: `vl check` rc 0 and invalid
// wasm. `nulAliasMemberFaithful` is the gate, and it is a property of the INNER (the
// litunion niche, or a primitive) because `tyToEmitNameGo`'s `TyNullable` arm spells
// only those two position-free — a declared-struct inner renders structurally under the
// `| null` and must stay opaque.
//
// PART TWO — the BRAND against `null`. `nomBinMixes` reported a branded operand meeting
// a `null` operand as a brand MIX, so `v != null` on a newtype over a nullable read
// `cannot compare T1 and null`: the value could be neither tested nor narrowed, and
// there is no other spelling of the test. The gate there is `tyAdmitsNull`, and
// `null-test-on-non-nullable-newtype-rejected.vl` is its inverted control — that gate is
// read a SECOND time as the equality arm's `nomEqLit` escape, so an ungated version
// suppressed the general `cannot compare … with null` reject as well.

type K = "a" | "b"
type NNK = new (K | null)
type ANK = (K | null)
type NNS = new (string | null)
type ANS = (string | null)

function testN(x: NNK) {
  if x != null { print(x) } else { print("nullN") }
}
function testA(x: ANK) {
  if x != null { print(x) } else { print("nullA") }
}
function testBare(x: K | null) {
  if x != null { print(x) } else { print("nullB") }
}

const gN: NNK = "a"
const gA: ANK = "a"
const gS: NNS = "a"
const gT: ANS = "a"

testN(gN)
testA(gA)
testBare("b")
if gS != null { print(gS) } else { print("nullS") }
if gT != null { print(gT) } else { print("nullT") }

function nulls() {
  const eN: NNK = null
  const eS: NNS = null
  if eN != null { print(eN) } else { print("emptyN") }
  if eS != null { print(eS) } else { print("emptyS") }
}
nulls()
