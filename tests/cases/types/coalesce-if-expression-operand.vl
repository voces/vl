// @run
// @log 7
// @log -1
// @log -1
// @log 7
// @log 8
// @log 1.5
// @log true
// @log false
// @log 7
// @log 1
// @log 8
// @hint redundant type annotation: `bump` is inferred as `boolean` — remove it to lean on inference
// @hint redundant type annotation: `chain` is inferred as `i32` — remove it to lean on inference
// CONTRACT (must-RUN): `??` whose LEFT OPERAND is an if-EXPRESSION written IN PLACE (D1250).
// An if-expression is the third source of a nullable value that CANNOT be re-read — a CALL
// and `as?` are the other two — so it takes the same stash-once lowering, and its box comes
// from `emitUnionCoerce` (whose `IfStmt` arm gives the missing `else` a null-tagged box)
// rather than from the scalar blocktype ladder.
//
// THE MISSING `else` IS NOT THE INGREDIENT: the explicit `else { null }` spelling is here at
// both truth values and behaves identically.
//
// `bump` IS THE SINGLE-EVALUATION PIN, and it is the clause-1 half of the row: the operand's
// condition must run ONCE. Before D1250 the `boolean | null` niche re-read the operand in the
// present arm, so `n` came out 2.
let n = 0

function bump(): boolean {
  n = n + 1
  return true
}

function take(v: i32) {
  print(v)
}

function chain(): i32 {
  return (if 1 == 2 { 7 }) ?? ((if 1 == 1 { 8 }) ?? -1)
}

print((if 1 == 1 { 7 }) ?? -1)
print((if 1 == 2 { 7 }) ?? -1)
print((if 1 == 2 { 7 } else { null }) ?? -1)
print((if 1 == 1 { 7 } else { null }) ?? -1)
print((if 1 == 2 { 7 } else if 1 == 1 { 8 }) ?? -1)
print((if 1 == 1 { 1.5 }) ?? -1.0)
print((if 1 == 1 { true }) ?? false)
print((if 1 == 2 { true }) ?? false)

take((if bump() { 7 }) ?? -1)
print(n)
print(chain())
