// @check
// @error cannot assign i32 | string to 'x' of type boolean
// The field read's join is the call's type, so a destination it does not fit is refused.
type K = { h: i32 }
type J = { h: string, z: i32 }
const k: K = { h: 4 }
const u: K | J = k
function ret(a) { return a.h }
const x: boolean = ret(u)
print(x)
