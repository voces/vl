// @check
// @error unknown type 'nope' within 'nope[][]'
// @error unknown type 'nope' within '(nope)=>i32'
// @error unknown type 'nope' within '{a:{b:nope}}'
// @error unknown type 'nope' within '{[string]:nope}'
// @error unknown type '{[boolean]:i32}'
// CONTRACT (must-error): the `unknown type` diagnostic names the OFFENDING COMPONENT and
// keeps the whole annotation as context, at every nesting depth.
//
// It used to degrade as the type nested — `any` gave `unknown type 'any'`, `{bar: any}`
// gave `unknown type '{bar:any}'` (blaming the shape), and a union of the two blamed the
// whole union — because both resolvers answer -1 and -1 propagates out of every composite
// arm by design, so the caller only ever held the composite. The resolver wrappers now
// bank the INNERMOST failing spelling (`unkTyPart`); the leaf case is byte-identical to
// before, because the part IS the whole name there.
//
// The four shapes here are the composites whose recursion the bank has to survive: an
// array SPINE (two hops), a function-type PARAMETER (past the arrow), a nested inline
// SHAPE (two field hops), and a map VALUE. Union / inline-object / intersection /
// generic-argument members are pinned by the four pre-existing `unknown-type-*` and
// `union-unknown-member-reject` files, whose messages moved the same way.
function a(v: nope[][]) { print(1) }
function b(v: (nope) => i32) { print(1) }
function c(v: {a: {b: nope}}) { print(1) }
function d(v: {[string]: nope}) { print(1) }
// …and the LIFETIME boundary. An UNSUPPORTED map KEY (`string` and `i32` are the two the
// map rep hashes) fails at a NON-leaf rung — no leaf resolution failed inside it — so the
// message must fall back to the whole annotation and must NOT inherit the `nope` banked by
// the four failures above. That is what the outermost-frame reset (`unkTyDepth == 1`)
// buys, and this is its only witness: the sabotage of removing the reset is INERT on the
// whole pre-existing corpus (0 files) and reddens exactly this cell.
function e(v: {[boolean]: i32}) { print(1) }
