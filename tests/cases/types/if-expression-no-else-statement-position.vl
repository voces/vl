// @run
// @log 9
// @log 2
// @log 5
// @log 8
// @log 3
// @hint redundant type annotation: `side` is inferred as `i32`
// CONTRACT (must-RUN): an else-less `if` in STATEMENT position stays `void` — the other
// half of the ruling that made it `T | null` as a value (DECISIONS, "An else-less `if`
// used as a VALUE is `T | null` in every position": *"In STATEMENT position it stays
// `void`, as today"*).
//
// THE HAZARD THIS PINS is the widening leaking one node too far. Every `if` below has an
// arm whose last statement is a call yielding a VALUE, so each is exactly one rule away
// from being read as an `i32 | null` expression — and if it were, a `: void` function's
// tail would stop meeting its annotation, a non-tail statement would start demanding a
// destination, and a `while` body would acquire a type. All four shapes are here: a
// non-tail statement, a `: void` function's TAIL, a loop body's tail, and an if-ARM's.
//
// It must keep RUNNING, not keep REFUSING: the pin is that the value is DISCARDED, which
// only a program that compiles can show.
function side(n: i32): i32 {
  print(n)
  n
}

// A non-tail statement inside a void function: the value is discarded and the statement
// after it still runs.
function nonTail(): void {
  if 1 == 1 { side(9) }
  print(2)
}
nonTail()

// The TAIL of a `: void` function: still a statement, so it meets the void annotation.
function voidTail(): void {
  if 1 == 1 { side(5) }
}
voidTail()

// A loop body's tail, and a statement `if` nested in another `if`'s ARM — neither is a
// value position either.
function loopAndArm(): void {
  let i = 0
  while i < 1 {
    if 1 == 1 { side(8) }
    i = i + 1
  }
  if 1 == 1 {
    if 1 == 1 { side(3) }
  }
}
loopAndArm()
