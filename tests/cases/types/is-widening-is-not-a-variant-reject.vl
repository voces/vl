// @check
// @error `is` check type 'i32' is not a variant of f64 | null
// @error `is` check type 'f32' is not a variant of f64 | null
// @error `is` check type 'i32' is not a variant of i64 | null
// @error `is` check type 'i32' is not a variant of f64 | string
// D228 — AN `is` WHOSE CHECK TYPE REACHES THE RECEIVER ONLY BY A NUMERIC WIDENING.
//
// The soundness gate on `x is T` asks `assignable(T, x's non-null part)`, and `assignable`
// permits the implicit widening lattice (`numWidensName`: i32→i64, i32→f64, f32→f64). That
// is the right question for a STORE and the wrong one for a TAG TEST: a widening is a
// CONVERSION — codegen emits a real instruction at the boundary — so the value in the slot
// is not of the source type and no runtime tag says it is. The test can never hold, and the
// then-branch narrows the binding to the check type VERBATIM, which is the LAUNDER the
// gate's own header says it exists to prevent.
//
// THE HOLE IS THE LATTICE, NOT ONE SPELLING. D228 filed it as "`is i32` is the ONE non-arm
// spelling the checker admits"; it is one edge of three and every edge is admitted, on a
// nullable inner and on a union member alike. The three spellings that do NOT widen — `i64`,
// `boolean`, `string` on an `f64 | null` — were already rejected, which is what made one
// edge look like a special case.
const g: f64 | null = 5.0
if g is i32 { print(g) } else { print(0) }
if g is f32 { print(0) } else { print(0) }

const h: i64 | null = 5
if h is i32 { print(0) } else { print(0) }

const u: f64 | string = 5.0
if u is i32 { print(0) } else { print(0) }
