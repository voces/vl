// @run
// @hint redundant type annotation: `word` is inferred as `string`
// @hint redundant type annotation: `g` is inferred as `null`
// @hint redundant type annotation: `k` is inferred as `null`
// @log true
// @log n
// @log true
// @log 7
// @log null
// @log 7
// @log 7
// @log 8
// @log 1.5
// @log 9
// @log 2.5
// @log s
// @log true
// @log 3
