// @log false
// The `null` unit type, annotated in every value position and pinned through a generic, is the
// `nulnone` cell: each read is statically `null`, so `??` is its default at the default's rep.
type N = null
function same(x: null): N { return x }
function word(x: null): string {
  if x == null { return "n" }
  return "v"
}
let g: null = null
const k: null = same(null)
print(k == null)
print(word(g))
g = same(k)
print(g == null)
print(g ?? 7)
print(g)
const cap = () => k ?? 7
print(cap())
function pick<T>(a: T) { print(a ?? 7) }
pick(null)
function bump<T>(a: T) {
  const r = a ?? 7
  print(r + 1)
}
bump(null)
function wide<T>(a: T) {
  const z: i64 = 9
  const h: f32 = 2.5
  print(a ?? 1.5)
  print(a ?? z)
  print(a ?? h)
  print(a ?? "s")
  print(a ?? true)
}
wide(null)
function isNull<T>(a: T) { print(a == null) }
pick(3)
isNull(null)
isNull(3)
