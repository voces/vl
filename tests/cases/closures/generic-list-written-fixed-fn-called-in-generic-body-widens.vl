// @run
// @log 1
// @hint Intentionally-unused parameter `_b` (leading `_` marks it unused)
// A list of a generic written with a fixed-type function takes that function's signature, so a
// call through it inside a generic body converts its argument as the annotated list does (D12238).
function pick<A, B>(a: A, _b: B): A { a }
function k(a: i32, _b: f64) { a }
const fs = [pick]
fs[0] = k
function g<T>(v: T): T { fs[0](v, v) }
print(g(1))
