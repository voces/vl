// @run
// A call through a set of un-annotated functions declared after it checks each member it needs
// first, so a set whose members return different types is dispatched by member (D16381).
const c = true
let f = inc0
if c { f = half }
print(f(3))
let g = inc0
g = half
print(g(4))
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
// @log 1.5
// @log 2
