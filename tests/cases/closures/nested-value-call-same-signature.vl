// @run
// @log 17
// @log 25
// @log 80604
// @log 17
// @log 112
// A function-value call nested in another's arguments at the SAME signature (D2330): each
// call must run its own callee, not the innermost one. With one shared closure slot every
// outer call ran the innermost closure, which passed the signature check and printed 4, 6
// and 50403 for the first three lines.
const a = (x: i32) => x + 1
const b = (x: i32) => x * 10
const c = (x: i32) => x - 3
print(c(b(a(1))))

const sq = (x: i32) => x * x
print(sq(a(1) + a(2)))

const dbl = (x: i32) => x * 2
const ys = [1, 2, 3].map((x: i32) => dbl(a(x)))
print(ys[0] + ys[1] * 100 + ys[2] * 10000)

function mk(n: i32): (i32) => i32 {
  (x: i32) => x + n
}
const one = mk(1)
print(mk(10)(one(one(5))))

function run(f: ((i32) => i32) | null, g: (i32) => i32): i32 {
  if f != null { return f(g(4)) }
  0
}
print(run((x: i32) => x + 100, (x: i32) => x * 3))
