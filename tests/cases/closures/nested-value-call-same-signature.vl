// @run
// @log 17
// @log 25
// @log 80604
// @log 24
// @log 112
// A function-value call nested in another's arguments at the SAME signature (D2330): each
// call must run its own callee. With one shared closure slot an outer call ran the code of
// the last closure its arguments stashed, which passed the signature check: 4, 6, 50403, 28
// and 36.
const a = (x: i32) => x + 1
const b = (x: i32) => x * 10
const c = (x: i32) => x - 3
print(c(b(a(1))))

const sq = (x: i32) => x * x
print(sq(a(1) + a(2)))

const dbl = (x: i32) => x * 2
const ys = [1, 2, 3].map((x: i32) => dbl(a(x)))
print(ys[0] + ys[1] * 100 + ys[2] * 10000)

function pick(k: i32): (i32) => i32 {
  if k == 0 { return (x: i32) => x + 10 }
  (x: i32) => x * 2
}
print(pick(0)(pick(1)(7)))

function run(f: ((i32) => i32) | null, g: (i32) => i32): i32 {
  if f != null { return f(g(4)) }
  0
}
const fs = [(x: i32) => x + 100, (x: i32) => x * 3]
print(run(fs[0], fs[1]))
