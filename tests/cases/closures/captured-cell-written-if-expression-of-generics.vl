// @run
// @log O
// @log 1
// @log T
// @log 1
// A capture cell runs with a writer storing an if-expression choosing between two generics, each value instanced at the cell's type
// (D3939, `rv3498/s01`).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function third<Z>(z: Z) { print("T"); print(z) }
function main(c: boolean) {
  let k = inner
  const toO = () => {
    k = if c { other } else { third }
  }
  toO()
  k(1)
}
main(true)
main(false)
