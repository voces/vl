// @run
// @log 2
// @log s
// @log 3
// @log 7
// A record a call makes fresh is delivered at a wider or instanced field type, as the literal
// itself would be: no other handle holds it, nullable or not (D4576).
function id<T>(x: T): T { x }
function d() { return { f: id } }
const v: { f: (x: i32) => i32 } = d()
print(v.f(2))
function r() { return { x: 1 } }
const o: { x: i32 | string } = r()
o.x = "s"
print(o.x)
function pick(n: i32) { return if n > 0 { { x: n } } else { { x: 0 } } }
const q: { x: i32 | string } = pick(3)
print(q.x)
function dn() { return { f: id } }
const n: { f: (x: i32) => i32 } | null = dn()
print(n?.f(7) ?? 0)
