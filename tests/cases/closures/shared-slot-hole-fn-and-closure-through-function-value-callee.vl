// @run
// @log 1
// @log s
// @log 3
// @log 4
// @log 3
// @log 7
// @log 8
// A parameter called once is reached by a hole function called elsewhere at two types and by a
// closure, through a callee that is a function value: each argument is built at the one call.
function id(x) { return x }
function useBoth(f) {
  print(f(1))
  print(f("s"))
}
useBoth(id)
function once(h) { print(h(3)) }
const runner = once
runner(id)
runner((x) => x + 1)
for r in [once] { r(id) }
function twice(x) { return x * 2 + 1 }
const rs = [once]
rs[0](twice)
rs[0]((x) => x + 5)
