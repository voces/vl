// @run
// @log ok
// @log 7
// @log true
// @log 7
// @log ok
// @log yes
// @log no
// CONTRACT (D988): a hole parameter is instantiated per RECEIVER SHAPE, not once per function.
//
// D987 disambiguated a hole param's receiver through the CALL-SITE ARGUMENT, but a resolver
// answers per FUNCTION and there was one `hole` for every call: whichever receiver it did not
// resolve trapped with `indirect call type mismatch`. `{f: () => string}` and `{f: () => i32}`
// share a struct row — same field NAMES — so one `call_indirect` type was emitted for both.
//
// THE ARENA ALREADY KNEW THEY DIFFER. A hole param pins the argument's type NAME, and an
// object literal's name is the synthetic ROW name `#anon0`, which is per field-set. The pin's
// own TYPE column reads two different arena types for the two receivers; the instance key was
// built from the half that cannot tell them apart. `monoAnonPinDiscrim` appends the pin's
// RENDERED type for an `#anon` pin, and the module carries one `hole` per shape.
//
// THE CALL-ORDER SWEEP IS THE POINT. Every earlier state of this defect was order-sensitive —
// first-DECLARED before D987, first-CALLED after it — so the fixture calls the shapes in both
// orders and each printed value names which lambda ran.
//
// AND `same1`/`same2` ARE THE CONTROL. Two literals of the SAME shape have DISTINCT arena
// types, so keying on the type INDEX would mint an instance per call site; they render
// identically and must keep sharing one. Their two `@log` lines are what a per-call-site split
// would still pass, so read them with the module: the pin is the render, not the index.
const s = { f: () => "ok" }
const b = { f: () => 7 }
const t = { f: () => true }
const same1 = { f: () => "yes" }
const same2 = { f: () => "no" }

function hole(z) {
  print(z.f())
}

hole(s)
hole(b)
hole(t)
hole(b)
hole(s)
hole(same1)
hole(same2)
