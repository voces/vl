// @run
// @log 41
// @log 42
// @log 43
// @log 44
// @log 45
// @log 46
// @log 2.5
// A generic returned bare by a maker with an inferred result, used at `f64` through one binding,
// then relayed by a second inferred return and delivered at `(x: i32) => i32`: the relay's
// maker call is built at the result the relay's calls take, so the call reaches the `i32`
// instance. Two hops, an argument, a record field, and a relay with a parameter and two returns
// (D16710).
function k<T>(x: T): T { return x }
function mk() { return k }
const o = mk()
const of = o(2.5)
function deliver() { return mk() }
function relay() { return deliver() }
function withArg(n: i32) {
  if n > 0 { return mk() }
  return mk()
}
function use(f: (x: i32) => i32) { print(f(42)) }
type H = { h: (x: i32) => i32 }
const v: (x: i32) => i32 = deliver()
print(v(41))
use(deliver())
const r: H = { h: deliver() }
print(r.h(43))
const w: (x: i32) => i32 = relay()
print(w(44))
const a: (x: i32) => i32 = withArg(1)
print(a(45))
const u: (x: i32) => i32 = deliver()
print(u(46))
print(of)
