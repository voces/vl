// @run
// @log 6
// @log 6
// A record bound to a const before it is pushed runs when every function written to the
// place returns one type, directly and nested in a record literal (D9470's control).
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
const p = []
p.push({ f: inc0 })
const r0 = { f: dbl }
p.push(r0)
print(p[1].f(3))
const q = []
q.push({ g: { f: inc0 } })
const r1 = { f: dbl }
q.push({ g: r1 })
print(q[1].g.f(3))
