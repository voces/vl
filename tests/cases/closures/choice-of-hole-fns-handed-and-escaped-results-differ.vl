// @run
// @hint Intentionally-unused parameter `_a` (leading `_` marks it unused)
// @log s
// @log s
// @log 4
// @log 5
// A choice handed to an open parameter that a closed function type also reads is a tagged set:
// each call dispatches to the member chosen, so members whose results differ run (D16094).
function inc(a) { return a + 1 }
function str(_a) { return "s" }
function ap(g, x) { return g(x) }
function run(c: boolean) {
  const g = if c { str } else { inc }
  print(ap(g, 3))
  const k: (a: i32) => i32 | string = g
  print(k(4))
}
run(true)
run(false)
