// @error cannot write 'half' to 'f': called at (i32) it returns f64, where 'inc0', also written to it, returns i32
// Delivered at `(a: i32) => i32` or handed to a generic, the binding is called at the
// destination's parameters, where the bodies give two results (D9003).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function w(h: (a: i32) => i32) { return h(3) }
let f = inc0
f = half
print(w(f))
