// @run
// @log 6
// @log 4
// @log false
// @log 6
// @log 4
// @log true
// @log 4
// A popped element of a list of lambdas whose set another list tags, narrowed and called: for its
// value, as a statement, with the null arm read, and twice until the list is empty.
const f = (a) => a + 1
const d = (a) => a * 2
const two = [f, d]
const s = two.pop()
if s != null { print(s(3)) }
const m = [f]
print(m[0](3))
const c = (a) => a + 1
const e = (a) => a * 2
const xs = [c, e]
const ys = [c]
const p = xs.pop()
print(p == null)
if p != null {
  p(1)
  print(p(3))
}
const q = xs.pop()
if q != null { print(q(3)) }
print(xs.pop() == null)
print(ys[0](3))
