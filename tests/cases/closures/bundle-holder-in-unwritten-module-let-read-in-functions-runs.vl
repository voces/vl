// @run
// @info `c` is never reassigned; use `const` instead of `let`
// @log 5
// @log 4
// @log 5
// @log 8
// @log 3.5
// @log 4
// A module-scope `let` bundle holder nothing writes is one record whichever function reads it, as
// a `const` is (D15774): annotated reads at each member, beside a call through it, and a copy.
function lap(f) {
  f(2.5)
  f(3)
  return f
}
let c = lap((a) => a + 1)
function main() {
  const m: (f64) => f64 = c
  print(m(4))
  print(c(3))
}
main()
function one() {
  const m: (f64) => f64 = c
  print(m(4))
}
function two() {
  const n: (i32) => i32 = c
  print(n(7))
}
one()
two()
function copy() {
  const v = c
  print(v(2.5))
  print(v(3))
}
copy()
