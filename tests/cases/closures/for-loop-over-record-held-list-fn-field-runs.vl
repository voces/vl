// @run
// @log 4
// @log 1.5
// @log 5.5
// @log 4
// @log 1.5
// @log 6
// @log 2.5
// @log 1
// @log 0.5
// @log 5.5
// A `for` loop over a list a record's field holds, of records whose function field holds
// functions returning different types, calls through each element's field (D15804).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function mk() { return { a: [{ f: inc0 }, { f: half }] } }
function deep() { return { b: { a: [{ f: inc0 }, { f: half }] } } }
for e in mk().a { print(e.f(3)) }
const r = mk()
let t = 0.0
for e in r.a { t = t + e.f(3) }
print(t)
for e in deep().b.a { print(e.f(3)) }
const fs = []
for e in mk().a { fs.push(() => e.f(5)) }
for g in fs { print(g()) }
for e, i in mk().a { print(e.f(i)) }
function fr() {
  let acc = 0.0
  for e in mk().a { acc = acc + e.f(3) }
  acc
}
print(fr())
