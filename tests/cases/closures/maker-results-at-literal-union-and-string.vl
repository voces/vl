// @run
// @log x
// @log q
// @log y
// @log r
// A maker's result at a string-literal union and at `string` builds the generic it returns once
// per rep, in either order (D14941).
type K = "x" | "y"
function same<T>(k: T): T { k }
function d9() { return same }
const v: (k: K) => K = d9()
const w: (k: string) => string = d9()
print(v("x"))
print(w("q"))
function d10() { return same }
const w2: (k: string) => string = d10()
const v2: (k: K) => K = d10()
print(v2("y"))
print(w2("r"))
