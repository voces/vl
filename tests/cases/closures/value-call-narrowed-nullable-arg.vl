// @run
// @log 4
// @log 9
// @log 3
// @hint redundant type annotation: `xs` is inferred as `({w: i32} | null)[]` — remove it to lean on inference
// D2537: a narrowed `S | null` value keeps its nullable rep, and a direct call recovers it with
// `ref.as_non_null` at a `(ref $S)` parameter. A call through a function value did not, so
// `f(v)` under `if v != null` was invalid wasm in every position the call was written in.
type Tex = { w: i32 }
function one(v: Tex | null, f: (Tex) => i32) {
  if v != null { return f(v) }
  return 0
}
function total(xs: (Tex | null)[], f: (Tex) => i32) {
  let s = 0
  let i = 0
  while i < xs.length {
    const v = xs[i]
    if v != null { s += f(v) }
    i += 1
  }
  return s
}
function firstLen(ls: i32[] | null, f: (i32[]) => i32) {
  if ls != null { return f(ls) }
  return -1
}
print(one({ w: 4 }, (x: Tex) => x.w))
const xs: (Tex | null)[] = [null, { w: 4 }, { w: 5 }]
print(total(xs, (x: Tex) => x.w))
print(firstLen([1, 2, 3], (l: i32[]) => l.length))
