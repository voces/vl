// @check
// @error-at 12:37 a `(() => Circle)[]` cannot be used as `readonly (() => Shape)[]` here: a call through that type would reach a function it holds at a signature the function does not have, and the functions inside a value are not converted on the way. Build the value at `readonly (() => Shape)[]`, or wrap each function in a lambda of the wider type where it is stored
// @error-at 14:32 a `(() => Circle) | null` cannot be used as `(() => Shape) | null` here: a call through that type would reach a function it holds at a signature the function does not have, and the functions inside a value are not converted on the way. Build the value at `(() => Shape) | null`, or wrap each function in a lambda of the wider type where it is stored
// A function value is adapted where it is delivered (D3073); one already stored in a list or
// behind a `| null` is not, so taking the container at a wider function type is refused
// rather than calling the function at a signature it does not have.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function mkC(): Circle { return { r: 7 } }

const fs = [mkC]
const gs: readonly (() => Shape)[] = fs
let h: (() => Circle) | null = mkC
const g: (() => Shape) | null = h
print(gs.length)
if g != null { print(1) }
