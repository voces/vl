// @run
// @log 4
// @log 4
// @log 3
// A record holding a map of un-annotated or generic functions, aliased inside a closure, takes
// the map's value type from the calls through the alias (D9102).
function inc0(a) { return a + 1 }
function id<T>(a: T): T { return a }
const m = Map()
m["k"] = inc0
const r = { m: m }
const f = () => {
  const v = r
  const x = v.m["k"]
  if x != null { print(x(3)) }
}
f()
const q = { m: Map() }
q.m["k"] = inc0
const g = () => {
  const v = q
  const x = v.m["k"]
  if x != null { print(x(3)) }
}
g()
const gm = Map()
gm["k"] = id
const gr = { m: gm }
const h = () => {
  const v = gr
  const x = v.m["k"]
  if x != null { print(x(3)) }
}
h()
