// @run
// @log 2
// @log 20
// @log 2
// @log 7
// A re-pointed `let` of un-annotated functions, called at its own type and then handed to a
// closed function-typed parameter, is delivered as the closure of the function it holds.
function twice(f: (n: i32) => i32, n: i32): i32 { return f(f(n)) }
function inc(a) { return a + 1 }
function dbl(a) { return a * 2 }
function run(c: boolean) {
  let f = inc
  if c { f = dbl }
  print(f(1))
  print(twice(f, 5))
}
run(true)
run(false)
