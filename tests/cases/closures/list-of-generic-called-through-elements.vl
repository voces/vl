// @run
// @log I
// @log 1
// @log O
// @log 2
// @log 4
// @log I
// @log 1
// @log I
// @log true
// @log I
// @log 1.5
// A list of generic functions called only through its elements takes the type those calls give
// it, as an annotation would (D3977).
function inner<U>(u: U) {
  print("I")
  print(u)
}
function other<V>(v: V) {
  print("O")
  print(v)
}
function id<T>(t: T): T { t }
function twoElements() {
  const fs = [inner, other]
  fs[0](1)
  fs[1](2)
}
function returns() {
  const fs = [id]
  print(fs[0](4))
}
function run<T>(x: T) {
  const fs = [inner]
  fs[0](x)
}
function float() {
  const fs = [inner]
  fs[0](1.5)
}
twoElements()
returns()
run(1)
run(true)
float()
