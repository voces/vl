// @run
// @log 2
// @log 3
// @log 7
// @log pos
// @log s0
// A lambda handing back a list literal into a union result with a list member builds it at that
// member, as its annotated twin does (D16888).
function makeIt(): (i32, i32) => (string | i32)[] | f64 {
  return (q0, q1) => ["r", q0 + q1]
}
const t0 = makeIt()(1, 2)
if t0 is (string | i32)[] {
  print(t0.length)
  const e = t0[1]
  if e is i32 { print(e) }
}
const f: (i32) => (string | i32)[] | f64 = (q0) => [q0]
const t1 = f(7)
if t1 is (string | i32)[] { print(t1[0]) }
const g: (i32) => (string | i32)[] | f64 = (q0) => {
  if q0 > 0 { return ["pos"] }
  return [q0]
}
const t2 = g(1)
if t2 is (string | i32)[] { print(t2[0]) }
const h: (i32) => string[] | f64 = (q0) => ["s\{q0}"]
const t3 = h(0)
if t3 is string[] { print(t3[0]) }
