// @run
// @log 14.5
// @log 3000000006
// @log true
// @log 3
// @hint Intentionally-unused parameter `_x`
// @hint redundant type annotation: `two` is inferred as `i32`
// An un-annotated lambda delivered to a closed function type is built at the delivered result,
// as its annotated twin is (D16310); a generic parameter's binding still joins (D2459).
const f: () => {z: f64[] | i32} = () => { z: [14.5] }
const r = f()
if r.z is f64[] { print(r.z[0]) }
const g: {a: i64[], f: () => i64} | f64 = { a: [367], f: () => 6 }
if g is {a: i64[], f: () => i64} { print(g.f() + 3000000000) }
const h: {f: (() => boolean | i32) | {w: i32}} | i64 = { f: () => true }
if h is {f: (() => boolean | i32) | {w: i32}} {
  print(h.f is () => boolean | i32)
}
function j<T>(_x: T, k: (i32) => T) { return k(2) }
const two: i32 = 2
print(j(two, (i) => i * 1.5))
