// @run
// @log 101
// @log 202
// @log 303
// @log 120
// @log 405
// @log 506
// @log 607
// @log 708
// @hint redundant type annotation: `factVal` is inferred as `i32`
// @hint redundant type annotation: `fact5` is inferred as `i32`
// @hint redundant type annotation: `lv` is inferred as `(i32) => i32`

// A function carries the closure-env parameter only when its body reads one; every other
// function taken as a value is reached through a table thunk. Each line prints a value only its
// own callee produces, and each callee is ALSO called directly, so the plain signature and the
// thunk are both exercised.

function plusOne(n: i32) { return n + 1 }
function plusTwo(n: i32) { return n + 2 }
function plusThree(n: i32) { return n + 3 }

// A struct field holding a function value, called through the field.
type Op = { run: (i32) => i32 }

// Passed to a generic, whose instance calls it.
function applyTwice<T>(fn: (T) => T, v: T): T { return fn(fn(v)) }

// Returned from a function.
function choose(k: i32): (i32) => i32 {
  if k == 0 { return plusOne }
  return plusThree
}

// Recursion through a value: the function reaches itself only through the binding it was
// handed, so a wrong table slot recurses into the wrong body.
function factVal(n: i32, f: (i32) => i32): i32 {
  if n <= 1 { return 1 }
  return n * f(n - 1)
}
function fact5(n: i32): i32 { return factVal(n, fact5) }

// An exported function in a program that takes function values: its signature stays plain.
export function exported(n: i32) { return n + 405 }

function go() {
  const op: Op = { run: plusOne }
  print(op.run(100) + plusOne(0) - 1)              // 101 — struct field
  print(applyTwice(plusOne, 200) + plusTwo(0) - 2) // 202 — generic pin
  print(choose(1)(300) + plusThree(0) - 3)         // 303 — returned value
  print(fact5(5))                                  // 120 — recursion through a value
  print(exported(0))                               // 405 — exported, called directly
  // A block-local function taken as a value.
  function local(n: i32) { return n + 6 }
  const lv: (i32) => i32 = local
  print(lv(500) + local(0) - 6) // 506
  // A capturing closure beside the thunked ones.
  const base = 600
  const cap = (n: i32) => n + base
  print(cap(7))                // 607
  const fs: ((i32) => i32)[] = [plusOne, cap]
  print(fs[0](7) + fs[1](100)) // 708
}
go()
