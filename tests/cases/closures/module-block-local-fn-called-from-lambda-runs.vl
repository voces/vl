// @run
// @log loc!
// @log 43
// @log 2
// @log one!
// @log two?
// @log b!
// @log kept!
// @log ax!
// @log bx!
// A module-scope block's local function that captures the block's bindings, called from a
// lambda, has its captures folded into the lambda's, as one declared in a function body does
// (D3633).
type R = { a: i32 }
let keep = (): string => ""
if true {
  const s = "loc"
  function k() { s + "!" }
  print((() => k())())
}
if true {
  let c = 40
  c = c + 1
  const xs = [1, 2]
  function k() { c + 2 }
  function j() { xs.length }
  print((() => k())())
  print((() => j())())
}
if true {
  const s = "one"
  function k() { s + "!" }
  print((() => k())())
}
{
  const s = "two"
  function k() { s + "?" }
  print((() => k())())
}
if true {
  let s = "a"
  function k() { s + "!" }
  const g = () => k()
  s = "b"
  print(g())
}
if true {
  const s = "kept"
  function k() { s + "!" }
  keep = () => k()
}
print(keep())
let i = 0
let tag = "a"
while i < 2 {
  const s = tag + "x"
  function k() { s + "!" }
  print((() => k())())
  tag = "b"
  i = i + 1
}
