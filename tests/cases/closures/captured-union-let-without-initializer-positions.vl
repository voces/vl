// @run
// @log 7
// @log 5
// @log x
// @log none
// @log 9
// A union `let` with no initializer that a closure captures starts as its cell's null box, which
// the IR writes as legacy writes a bare `null`: a record union, a value union, read twice, and at
// the top level.
type U = { a: i32 } | { b: string }
function recordUnion() {
  let u: U
  const g = () => if u is { a: i32 } { u.a } else { 0 }
  u = { a: 7 }
  print(g())
}
function valueUnion() {
  let n: i32 | string
  const g = () => if n is i32 { n } else { -1 }
  n = 5
  print(g())
}
function twoReads() {
  let n: i32 | string
  const g = () => if n is string { n } else { "none" }
  n = "x"
  print(g())
  n = 3
  print(g())
}
recordUnion()
valueUnion()
twoReads()
let gu: U
const gg = () => if gu is { a: i32 } { gu.a } else { 0 }
gu = { a: 9 }
print(gg())
