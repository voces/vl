// @run
// @hint Intentionally-unused parameter
// THE MIRROR of `closure-union-param-pin-litunion-first.vl`, and the reason the fix there is
// a SELECTION rule rather than a filter: reverse the declaration order and the SAME
// `unNames[0]` pin breaks the other direction.
//
//     type V = i32 | string
//     type K = "a" | "b"
//     function apply(f: (K) => i32): i32 { return f("a") }
//     print(apply((_k) => 7))
//   → vl check rc=0, clean; vl build rc=0; vl run → "wasm trap: cast failure"
//
// A litunion-ALIAS param reps as the interned i32 ATOM; pinned to the first declared alias
// — here the BOXED `V` — the lambda declared the `{tag, payload}` box where the annotation
// keyed the atom. With the lambda body USING its param it is invalid wasm instead
// ("expected i32, found (ref $type)", `applyK((k) => sinkK(k))`). Both are correct in the
// other order, on
// master, unchanged — which is the A/B that says the input was the file's declaration order
// and not the program.
//
// So neither rep may be "the" pin: `unionParamPinName` asks the PARAM which one it is. The
// boxed half keeps the arm's shortcut (any boxed row will do — one `$uBox`, program-global
// variant tags); the litunion half cannot, because a litunion's atom ids are its own member
// strings, so it takes the param's OWN spelling.
//
// AND THE SPELLING IS THE ANSWER, NOT THE REP: `nodeTyIsLitUnionAlias` — the alias's own
// arena INDEX — is what separates the two litunion spellings, and it has to be that rather
// than a member-set match, which an inline spelling satisfies just as well. A DECLARED alias
// is preserved by `canonEmitTypeNames` and reps as the atom; an INLINE `("a"|"b")` is
// SOFTENED to `string` and reps as the string ref (`tyToEmitNameGo`'s union arm states the
// invariant). Pinning either name to the other spelling's context is a trap in one direction
// and invalid wasm in the other — both measured, both were on the 140-cell grid.
//
// `applyL` is why "any litunion alias" is not the litunion half's shortcut either: two
// litunion aliases with DIFFERENT member sets, and the param is the second.

type V = i32 | string
type Cat = { c: i32 }
type Dog = { d: i32 }
type Pet = Cat | Dog
type K = "a" | "b"
type L = "x" | "y" | "z"

function sinkK(_v: K): i32 { return 2 }

function sinkL(_v: L): i32 { return 4 }

// ── the litunion-ALIAS param, with a BOXED alias sitting at `unNames[0]` ─────────────────
function applyK(f: (K) => i32): i32 { return f("a") }

// @log 1
print(applyK((_k) => 1))
// @log 2
print(applyK((k) => sinkK(k)))

// The SECOND litunion alias, member set disjoint from the first.
function applyL(f: (L) => i32): i32 { return f("y") }

// @log 3
print(applyL((_k) => 3))
// @log 4
print(applyL((k) => sinkL(k)))

// ── the boxed params in this order: already correct on master, byte-identical after ──────
function applyV(f: (i32 | string) => i32): i32 { return f(1) }

// @log 5
print(applyV((_k) => 5))

function applyP(f: (Cat | Dog) => i32): i32 {
  const p0: Cat = { c: 1 }
  return f(p0)
}

// @log 6
print(applyP((_k) => 6))

// The INLINE litunion spelling in this order — the `string` soften, reached with a boxed row
// at 0 rather than a litunion one.
function applyI(f: ("a" | "b") => i32): i32 { return f("a") }

// @log 7
print(applyI((_k) => 7))

// ── CONTROLS: the annotated twins ────────────────────────────────────────────────────────
// @log 1
print(applyK((_k: K) => 1))
// @log 2
print(applyK((k: K) => sinkK(k)))
// @log 4
print(applyL((k: L) => sinkL(k)))
// @log 5
print(applyV((_k: i32 | string) => 5))
