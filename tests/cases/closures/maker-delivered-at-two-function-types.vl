// A maker (a function returning a hole lambda) delivered at two function types builds a fresh
// closure per call at each type: named or a `const`-bound lambda, with a captured counter that
// every call advances, and with an annotated parameter (D12234).
let calls = 0
function counted() {
  calls = calls + 1
  const k = calls
  const l = (x) => {
    print(k); x
  }
  return l
}
const f: (x: i32) => i32 = counted()
const g: (x: string) => string = counted()
const h: (x: i32) => i32 = counted()
print(f(1))
print(g("s"))
print(h(3))
print(f(5))
print(calls)
const tagged = (n: i32) => {
  const l = (x) => {
    print(n); x
  }
  return l
}
const a: (x: i32) => i32 = tagged(10)
const b: (x: string) => string = tagged(20)
print(a(1))
print(b("s"))
const id = (u) => u
const deliver = () => {
  return id
}
const v: (n: i32) => i32 = deliver()
const w: (n: string) => string = deliver()
print(v(7))
print(v(3) + 1)
print(w("q"))
