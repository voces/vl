// @run
// @log 5 2.5
// @log 6 3.5
// @log true
// @log 7 4.5
// @log 5 2.5
// @log 6 3.5
// @hint Intentionally-unused variable `_a`
// @hint Intentionally-unused variable `_b`
// @hint Intentionally-unused variable `_t`
// A record of one closure per signature stored as a map's value is held there whole: a read by
// index or `get`, tested for null, is that record, and a call through it or a copy takes its member.
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
function gen<T>(t: T, k: i32) {
  const r = lap((a) => a + k)
  const _t = t
  return r
}
const m = Map()
m["a"] = lap((a) => a + 1)
m.set("b", gen("s", 2))
const x = m["a"]
if x != null {
  const v = x
  print("\{v(4)} \{v(1.5)}")
}
const y = m.get("b")
if y != null { print("\{y(4)} \{y(1.5)}") }
print(m.has("a"))
function run(k: i32) {
  const n = Map()
  n["k"] = lap((a) => a + k)
  const g = n["k"]
  if g != null { print("\{g(4)} \{g(1.5)}") }
}
run(3)
const xs = [lap((a) => a + 1)]
print("\{xs[0](4)} \{xs[0](1.5)}")
const zs = [lap((a) => a + 2)]
print("\{zs[0](4)} \{zs[0](1.5)}")
