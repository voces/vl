// @run
// @log 1.5
// @log 1.5
// @log 4
// @log 2.5
// A list of maps whose function values are a tagged set holds each map as the i32-valued map,
// so the list has a row and a map read back out of it calls its members (D15187).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const fnMap = Map()
fnMap.set("a", inc0)
fnMap.set("b", half)
const xs = [fnMap]
const v = xs[0]
const g = v.get("b")
if g != null { print(g(3)) }
for m in xs {
  const h = m.get("b")
  if h != null { print(h(3)) }
}
const ys = [fnMap, fnMap]
const k = ys[1].get("a")
if k != null { print(k(3)) }
function run() {
  const zs = [fnMap]
  const q = zs[0].get("b")
  if q != null { return q(5) }
  0.0
}
print(run())
