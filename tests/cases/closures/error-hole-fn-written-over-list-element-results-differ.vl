// @error cannot write 'half' to an element of 'xs': called at (i32) it returns f64, where 'inc0', also written to it, returns i32
// A list element of un-annotated functions called at `i32` runs whichever was written last, so a
// write of one whose body gives another result there is refused at the write (D9060).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const xs = [inc0]
xs[0] = half
print(xs[0](3))
