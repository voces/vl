// @run
// @log aC
// @log aE
// @log aE
// @log bE
// @log cE
// @log dE
// @log dG
// @log eC
// @info `d4` is never reassigned; use `const` instead of `let`
// @hint redundant type annotation: `w1` is inferred as `i32`
// @info `d5` is never reassigned; use `const` instead of `let`
// A hole lambda written into a binding through a capture cell's read (`d1 = d2[0]`) takes the
// signature of the lambda the binding already holds, so the cell's other lambdas pin with it;
// the cell is written in a called closure or a nested function, and read before and after. A
// binding written from such a read and holding nothing settled leaves the binding the lambda
// seeds to give the signature (D3855).
function review(x: string) {
  const c = (y) => y + "C"
  const e = (y) => y + "E"
  const g = (y) => y + "G"
  let d1 = c
  let d2 = e
  print(d1(x))
  d1 = d2
  const w4 = (): i32 => {
    d2 = g
    0
  }
  w4()
  let d4 = d1
  const d5 = d4
  print((() => d1(x))())
  print(d5(x))
}
review("a")
function closureWriter(x: string) {
  const c = (y) => y + "C"
  const e = (y) => y + "E"
  const g = (y) => y + "G"
  let d1 = c
  let d2 = e
  d1 = d2
  const w4 = (): i32 => {
    d2 = g
    0
  }
  w4()
  print(d1(x))
}
closureWriter("b")
function nestedWriter(x: string) {
  const c = (y) => y + "C"
  const e = (y) => y + "E"
  const g = (y) => y + "G"
  let d1 = c
  let d2 = e
  d1 = d2
  function w4() { d2 = g }
  w4()
  print(d1(x))
}
nestedWriter("c")
function readBoth(x: string) {
  const c = (y) => y + "C"
  const e = (y) => y + "E"
  const g = (y) => y + "G"
  let d1 = c
  let d2 = e
  d1 = d2
  const w4 = (): i32 => {
    d2 = g
    0
  }
  w4()
  print(d1(x))
  print(d2(x))
}
readBoth("d")
function seedAnswers(x: string) {
  const c = (y) => y + "C"
  const e = (y) => y + "E"
  const g = (y) => y + "G"
  let d1 = g
  function w1(): i32 {
    d1 = d1
    0
  }
  let d3 = e
  d3 = d1
  let d5 = c
  d1 = c
  print(d5(x))
}
seedAnswers("e")
