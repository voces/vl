// @run
// @log aC
// @log aE
// @log aE
// @log bE
// @log cE
// @log dE
// @log dG
// @info `d4` is never reassigned; use `const` instead of `let`
// A hole lambda written into a binding through a capture cell's read (`d1 = d2[0]`) takes the
// signature of the lambda the binding already holds, so the cell's other lambdas pin with it;
// the cell is written in a called closure or a nested function, and read before and after (D3855).
function review(x: string) {
  const c = (y) => y + "C"
  const e = (y) => y + "E"
  const g = (y) => y + "G"
  let d1 = c
  let d2 = e
  print(d1(x))
  d1 = d2
  const w4 = (): i32 => {
    d2 = g
    0
  }
  w4()
  let d4 = d1
  const d5 = d4
  print((() => d1(x))())
  print(d5(x))
}
review("a")
function closureWriter(x: string) {
  const c = (y) => y + "C"
  const e = (y) => y + "E"
  const g = (y) => y + "G"
  let d1 = c
  let d2 = e
  d1 = d2
  const w4 = (): i32 => {
    d2 = g
    0
  }
  w4()
  print(d1(x))
}
closureWriter("b")
function nestedWriter(x: string) {
  const c = (y) => y + "C"
  const e = (y) => y + "E"
  const g = (y) => y + "G"
  let d1 = c
  let d2 = e
  d1 = d2
  function w4() { d2 = g }
  w4()
  print(d1(x))
}
nestedWriter("c")
function readBoth(x: string) {
  const c = (y) => y + "C"
  const e = (y) => y + "E"
  const g = (y) => y + "G"
  let d1 = c
  let d2 = e
  d1 = d2
  const w4 = (): i32 => {
    d2 = g
    0
  }
  w4()
  print(d1(x))
  print(d2(x))
}
readBoth("d")
