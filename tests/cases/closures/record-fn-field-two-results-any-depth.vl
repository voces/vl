        c: { d: { e: { g: { h: { i: { j: { k: { l: { m: { f: half } } } } } } } } } },
      },
    },
  },
)
for p in ps { print(p.a.b.c.d.e.g.h.i.j.k.l.m.f(3)) }
function mk() {
  return [
    {
      a: {
        b: {
          c: {
            d: { e: { g: { h: { i: { j: { k: { l: { m: { f: inc0 } } } } } } } } },
          },
        },
      },
    },
    {
      a: {
        b: {
          c: {
            d: { e: { g: { h: { i: { j: { k: { l: { m: { f: half } } } } } } } } },
          },
        },
      },
    },
  ]
}
const ms = mk()
print(ms[0].a.b.c.d.e.g.h.i.j.k.l.m.f(3))
