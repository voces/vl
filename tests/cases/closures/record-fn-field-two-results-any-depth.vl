// Records holding un-annotated functions of different results, nested past any fixed depth: a
// list literal, a value `if`, a rewritten `let`, a push and a returned list each read the field
// through the set's id (D16731, D16732).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const x7 = [
  { a: { b: { c: { d: { e: { g: { h: { f: inc0 } } } } } } } },
  { a: { b: { c: { d: { e: { g: { h: { f: half } } } } } } } },
]
print(x7[0].a.b.c.d.e.g.h.f(3))
print(x7[1].a.b.c.d.e.g.h.f(3))
const x8 = [
  { a: { b: { c: { d: { e: { g: { h: { i: { f: inc0 } } } } } } } } },
  { a: { b: { c: { d: { e: { g: { h: { i: { f: half } } } } } } } } },
]
print(x8[0].a.b.c.d.e.g.h.i.f(3))
print(x8[1].a.b.c.d.e.g.h.i.f(3))
function pick(c: boolean) {
  return if c { {
    a: {
      b: {
        c: { d: { e: { g: { h: { i: { j: { k: { l: { m: { f: inc0 } } } } } } } } } },
      },
    },
  } } else { {
    a: {
      b: {
        c: { d: { e: { g: { h: { i: { j: { k: { l: { m: { f: half } } } } } } } } } },
      },
    },
  } }
}
print(pick(true).a.b.c.d.e.g.h.i.j.k.l.m.f(3))
print(pick(false).a.b.c.d.e.g.h.i.j.k.l.m.f(3))
let r = {
  a: {
    b: {
      c: {
        d: { e: { g: { h: { i: { j: { k: { l: { m: { f: inc0 } } } } } } } } },
      },
    },
  },
}
print(r.a.b.c.d.e.g.h.i.j.k.l.m.f(3))
r = {
  a: {
    b: {
      c: { d: { e: { g: { h: { i: { j: { k: { l: { m: { f: half } } } } } } } } } },
    },
  },
}
print(r.a.b.c.d.e.g.h.i.j.k.l.m.f(3))
const ps = [
  {
    a: {
      b: {
        c: {
          d: { e: { g: { h: { i: { j: { k: { l: { m: { f: inc0 } } } } } } } } },
        },
      },
