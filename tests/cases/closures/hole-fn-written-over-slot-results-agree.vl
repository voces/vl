// @run
// @log 6
// @log 6
// @log 6
// @log 6
// @log 6
// @log 6
// @log 6
// @log 6
// @log 4
// @log 6
// @log 1.5
// @log 4
// @log 10
// A list element or record field written with un-annotated functions that agree at each type it
// is called at runs whichever the write left there, read at a computed index, by `for`, into a
// binding or through an alias; a literal's functions agreeing at the call's types run too.
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function half(a) { return a / 2.0 }
const xs = [inc0]
xs[0] = dbl
print(xs[0](3))
const r = { f: inc0 }
r.f = dbl
print(r.f(3))
const ys = [inc0]
ys.push(dbl)
print(ys[1](3))
const zs = [inc0]
zs[0] = (a) => a * 2
print(zs[0](3))
const ws = [inc0]
function put() { ws[0] = dbl }
put()
print(ws[0](3))
const s = { f: inc0 }
function putF() { s.f = dbl }
putF()
print(s.f(3))
const vs = [inc0]
if vs.length > 0 { vs[0] = dbl }
print(vs[0](3))
const ls = [inc0, dbl]
const j = ls.length - 1
print(ls[j](3))
for f in ls { print(f(3)) }
const fs = [inc0, half]
print(fs[1](3.0))
const g = fs[0]
print(g(3.0))
const al = ls
al[0] = dbl
print(ls[0](5))
