// @run
// @log 6
// @log 6
// @log 6
// @log 6
// @log 6
// @log 6
// @log 6
// @log 4
// @log 1.5
// @log 4
// @log 4
// A list element or record field written with un-annotated functions that agree at each type it
// is called at runs whichever the write left there; a literal holding functions of different
// results is not a write and keeps running where it ran (D9060's legal neighbours).
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function half(a) { return a / 2.0 }
const xs = [inc0]
xs[0] = dbl
print(xs[0](3))
const r = { f: inc0 }
r.f = dbl
print(r.f(3))
const ys = [inc0]
ys.push(dbl)
print(ys[1](3))
const zs = [inc0]
zs[0] = (a) => a * 2
print(zs[0](3))
const ws = [inc0]
function put() { ws[0] = dbl }
put()
print(ws[0](3))
const s = { f: inc0 }
function putF() { s.f = dbl }
putF()
print(s.f(3))
const vs = [inc0]
if vs.length > 0 { vs[0] = dbl }
print(vs[0](3))
const ls = [inc0, half]
print(ls[0](3))
print(ls[1](3))
const ms = [inc0, half]
ms[1] = inc0
print(ms[1](3))
const j = ms.length - 2
print(ms[j](3))
