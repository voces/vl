// @run
// @log 0.75
// @log 0.75
// @log 1
// @log 4
// @log 0.75
// @log 1.5
// A flat list of a set handed to an un-annotated parameter and called through an element at one
// type holds member ids, and the call has its members' one result: a single member, two members
// agreeing, a result bound and used, and a lambda in a const list.
function run0(fs) { return fs[0](1.5) }
function half0(u) { return u * 0.5 }
print(run0([half0]))

function run1(fs) { print(fs[0](1.5)) }
function half1(u) { return u * 0.5 }
function dbl1(u) { return u * 2 }
run1([half1, dbl1])

function run2(fs) {
  const x = fs[0](1.5)
  print(x + 0.25)
}
function half2(u) { return u * 0.5 }
run2([half2])

function run3(fs) { return fs[0](3) }
const h3 = (u) => u + 1
const ls3 = [h3]
print(run3(ls3))

function run4(fs) {
  print(fs[0](1.5))
  print(fs[0](3))
}
function half4(u) { return u * 0.5 }
run4([half4])
