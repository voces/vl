// @run
// @log 3
// @log 3
// @log 12
// @log 5
// @log 8
// A tagged function handed to an un-annotated parameter is keyed at its set, the id the call
// delivers, and a lambda handed to the same parameter at its own signature (D15177).
function fw(f) { return f }
function ap(f, x) { return f(x, 1) }
function add(a, b) { return a + b }
function sub(a, b) { return a - b }
const p = fw(add)
print(p(1, 2))
const q = fw(sub)
print(q(5, 2))
const l = fw((a: i32, b: i32) => a * b)
print(l(3, 4))
print(ap(add, 4))
print(ap((a: i32, b: i32) => a - b, 9))
