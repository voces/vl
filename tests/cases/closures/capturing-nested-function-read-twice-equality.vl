// @log 6
// @log 4
// Each execution of a capturing nested function's declaration is one function value: reads of it
// in that activation compare equal, a later execution or another call's is a different value, and
// a lambda evaluated twice is two values (D7480).
function outer(n: i32) {
  function inner(x: i32) { return x + n }
  const a = inner
  const b = inner
  print(a == b)
}
outer(3)
function written(n: i32) {
  let m = n
  function inner(x: i32) { return x + m }
  const a = inner
  m = 10
  const b = inner
  print(a(1))
  print(b(1))
  print(a == b)
}
written(3)
function mk(n: i32) {
  function inner(x: i32) { return x + n }
  return inner
}
print(mk(1) == mk(1))
function looped(n: i32) {
  const fs: ((x: i32) => i32)[] = []
  const ls: ((x: i32) => i32)[] = []
  let i = 0
  while i < 2 {
    const k = i
    function inner(x: i32) { return x + n + k }
    fs.push(inner)
    fs.push(inner)
    ls.push((x: i32): i32 => x + n + k)
    i = i + 1
  }
  print(fs[0] == fs[1])
  print(fs[1] == fs[2])
  print(fs[3](2))
  print(ls[1](0))
}
looped(3)
