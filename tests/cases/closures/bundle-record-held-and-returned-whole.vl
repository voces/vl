// @run
// @log s
// @log 5 2.5
// @log 7
// @log 7 4.5
// @log 3
// @log 5 2.5
// A binding holding a returned bundle's record, returned whole: from a generic function's two
// instances and from a plain one, called inside the function before it is returned.
function lap(f) {
  f(2.5)
  f(3)
  return f
}
function gen<T>(t: T, k: i32) {
  const r = lap((a) => a + k)
  print(t)
  return r
}
function mk(k: i32) {
  const r = lap((a) => a + k)
  print(r(2))
  return r
}
const v = gen("s", 1)
print("\{v(4)} \{v(1.5)}")
const w = gen(7, 3)
print("\{w(4)} \{w(1.5)}")
const u = mk(1)
print("\{u(4)} \{u(1.5)}")
