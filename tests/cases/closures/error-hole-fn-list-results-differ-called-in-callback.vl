// @error cannot write 'half' to an element of 'xs': called at (i32) it returns f64, where 'inc0', also written to it, returns i32
// A `.map` callback calling its element runs whichever function the list holds, so a write of
// one whose body gives another result there is refused at the write, as a direct call's is (D9172).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const xs = [inc0]
xs[0] = half
print(xs.map((f) => f(3))[0])
