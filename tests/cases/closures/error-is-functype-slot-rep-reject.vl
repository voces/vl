// @check
// @error `is` check type '(i32)=>i32' can never match a value of type (i32) => i32 | null
// @error `is` check type '(i32)=>i32' can never match a value of type (i32) => i32 | null
// @error `is` check type '(i32)=>i32' can never match a value of type (i32) => i32 | string
// CONTRACT (must-error): `v is <functype>` may not narrow to a function type whose SLOTS
// rep differently from the value's own — the `is` face of the invariance
// `error-fn-slot-rep-differs-reject.vl` pins for an assignment.
//
// A closure carries NO RUNTIME TYPE TAG: its rep is `{env, table-index}` and its signature
// is fixed at creation, so `is` over a function-typed value can only ever answer the type
// it already has. The narrow was gated on `assignable(tested, receiver)`, which is
// variance-aware — `(i32) => i32` IS assignable to `(i32) => (i32 | null)` by return
// covariance — so the THEN branch bound `v` at the UNBOXED-result type while the value
// still repped BOXED. `vl check` reported rc 0 and the module did not validate: the call
// lowered to a `call_indirect` at the value's real (boxed) `$fnsig` while `print` had been
// resolved against the narrowed `i32`, leaving `expected i32, found (ref $type)`.
//
// THE SPELLING IS THE POINT OF THE FIRST TWO RUNGS, and it is a documented probe trap
// (`docs/internals/silent-class-inventory.md` §4d): `(i32) => i32 | null` is NOT a nullable
// closure. `|` binds INTO the return, so it denotes a function RETURNING `i32 | null`, and
// the genuinely nullable closure needs the parens `((i32) => i32) | null`. Both spellings
// appear below and only one of them errors, which is the pin. A silent-class sweep wrote
// the unparenthesised form at seven positions and in two spellings and produced 17 cells of
// `vl check`-clean invalid wasm; the alias rung is that sweep's second spelling.
//
// The third rung drops null entirely (`(i32) => (i32 | string)`), because nullability was
// never the discriminator — the rep change in the result slot is.
type F = (i32) => i32
type NulRet = (i32) => i32 | null

// A function RETURNING `i32 | null`, tested against one returning a bare `i32`.
export function inlineSpelling(v: (i32) => i32 | null) {
  if v is (i32) => i32 { return v(3) }
  0
}

// The same type behind an ALIAS — the tested type resolves structurally, so the alias
// spelling must reject identically rather than falling through to a different rung.
export function aliasSpelling(v: NulRet) {
  if v is (i32) => i32 { return v(3) }
  0
}

// No null anywhere: the result slot alone changes rep (a boxed value union vs a bare i32).
export function noNullAtAll(v: (i32) => (i32 | string)) {
  if v is (i32) => i32 { return v(3) }
  0
}

// CONTROL — the GENUINELY nullable closure. `is` there is the null test, the narrowed
// binding reps identically, and it must keep narrowing to something callable.
export function control(v: F | null) {
  if v is F { return v(3) }
  0
}

// CONTROL — a generic operand stays opaque and freely testable (`TyVar` is assignable in
// both directions by construction), exactly as `soundness/is-disjoint-plain-operand-
// reject.vl` requires of the scalar gate.
export function generic<T>(v: T) {
  if v is (i32) => i32 { return 1 }
  0
}
