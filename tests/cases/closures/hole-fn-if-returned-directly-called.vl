// @run
// @log a!
// @log b?
// @log c!
// @log d?
// @log e?
// @log aa
// @log 8
// @log gg
// @log 10
// An `if` expression of hole functions returned directly and called by the caller instances each
// arm at the call: returned, as the body's last statement, through an `else if` chain, and, at
// two call types, as a copy of the function per result type, bound or direct (D7011).
function exclaim(s) { return s + "!" }
function ask(s) { return s + "?" }
function twice(s) { return s + s }
const on = [1].length == 1
function pick(c: boolean) { return if c { exclaim } else { ask } }
function tail(c: boolean) {
  if c { exclaim } else { ask }
}
function chain(n: i32) {
  return if n == 0 { exclaim } else if n == 1 { ask } else { exclaim }
}
print(pick(on)("a"))
print(pick(!on)("b"))
print(tail(on)("c"))
print(tail(!on)("d"))
print(chain(1)("e"))
function two(c: boolean) { return if c { twice } else { twice } }
print(two(on)("a"))
print(two(!on)(4))
function bound(c: boolean) {
  const f = if c { twice } else { twice }
  return f
}
print(bound(on)("g"))
print(bound(!on)(5))
