// @run
// @log I
// @log true
// @log O
// @log 1
// A binding of the same name written in another scope does not make a never-written binding's
// call refuse (D4016).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function a() {
  let f = other
  f = inner
  f(true)
}
function b() {
  let f = other
  f(1)
}
a()
b()
