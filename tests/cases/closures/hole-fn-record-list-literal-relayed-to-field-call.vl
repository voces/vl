// @run
// @log 4
// @log 2.5
// @log 4
// @log 30
// A list literal of records of un-annotated functions, handed to an un-annotated parameter that
// relays an element to another one calling the field, instances each function at that call's
// arguments: i32 at one field, f64 at another (D9647). A record of an annotated lambda beside it
// keeps its own function (D9950). Each field name is its own: D9951 is two list literals sharing one.
function inc5(a) { return a + 1 }
function inc6(a) { return a + 1 }
function inc8(a) { return a + 1 }
function t5(a) { print(a.f(3)) }
function t6(a) { print(a.g(1.5)) }
function t8(a) { print(a.h(3)) }
function use5(v) { t5(v[0]) }
use5([{ f: inc5 }])
function use6(v) { t6(v[0]) }
use6([{ g: inc6 }])
function use8(v) {
  t8(v[0])
  t8(v[1])
}
use8([{ h: inc8 }, { h: (x: i32): i32 => x * 10 }])
