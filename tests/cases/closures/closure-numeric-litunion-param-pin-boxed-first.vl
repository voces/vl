// @run
// @hint Intentionally-unused parameter
// @hint redundant type annotation: `applyZ` is inferred as `i32`
// @hint redundant type annotation: `applyW` is inferred as `i32`
// @hint redundant type annotation: `applyV` is inferred as `i32`
// @hint redundant type annotation: `applyM` is inferred as `i32`
// THE MIRROR of `closure-numeric-litunion-param-pin.vl`, and the reason the numeric fix is a
// SELECTION rule and not just a skip: reverse the declaration order and the SAME `unNames`
// walk breaks the other direction.
//
//     type V = i32 | string
//     type Z = 0 | 1
//     function apply(f: (Z) => i32): i32 { return f(1) }
//     print(apply((z) => sinkZ(z)))
//   → vl check rc=0, clean; vl build writes the module then rejects it:
//     "type mismatch: expected i32, found (ref $type)"
//
// A numeric-litunion param reps as its BASE SCALAR. Falling past the string-only litunion arm
// (`tyIsLitUnion` rejects any member whose `litKind != "str"`) into the boxed loop, it was
// pinned to the first declared BOXED alias — here `V` — so the lambda declared the
// `{tag, value}` box where every reader of the value, `sinkZ` included, takes the plain i32.
// With the lambda's param UNUSED the same program is a cast-failure TRAP instead, and with the
// numeric alias declared FIRST (the mirror file) both are correct on master: the input is the
// file's declaration order, not the program.
//
// So the pin is the param's OWN base scalar (`numLitUnionBaseName` — canon's own home for the
// rule, reached through the type ARENA, with no name and no second parse), which is exactly
// what the annotation side keys since `#1273` made `canonEmitName` canon a function type's
// interior. The two `$fnsig` producers agree by construction rather than by which alias the
// file happened to declare first. `#1273` is why `applyZ`'s UNUSED cell here is a trap rather
// than the invalid module it was before it: the annotation now says `i32`, so the wrong pin is
// the only remaining disagreement.
//
// THE FLOAT BASE IS THE CELL THAT PROVES THE PIN CARRIES THE BASE and not merely "not the
// box": `1.5 | 2.5` softens to `f64`, an `i32` pin feeds `sinkW`'s f64 parameter an i32, and
// — unlike the `0|1` cells — it is wrong in EVERY declaration order, including with no boxed
// row declared at all, because the un-pinned default is i32. It is the one numeric cell a skip
// alone could never fix.
//
// `applyM` is the row this skip must NOT swallow: a value union with a numeric-litunion ARM
// (`type M = Z | string`) really IS boxed, `registerValueUnionName` registers it, and
// `numLitUnionAliasName` returns "" for it — so it stays a legal boxed pin.

type V = i32 | string
type Z = 0 | 1
type W = 1.5 | 2.5
type M = Z | string

function sinkZ(_v: Z) { 2 }

function sinkW(_v: W) { 4 }

// ── the numeric litunion param, with a BOXED alias sitting at `unNames[0]` ──────────────────
function applyZ(f: (Z) => i32): i32 { return f(1) }

// @log 1
print(applyZ((_z) => 1))
// @log 2
print(applyZ((z) => sinkZ(z)))

function applyW(f: (W) => i32): i32 { return f(1.5) }

// @log 3
print(applyW((_z) => 3))
// @log 4
print(applyW((z) => sinkW(z)))

// ── the boxed rows the skip must leave alone ───────────────────────────────────────────────
function applyV(f: (i32 | string) => i32): i32 { return f(1) }

// @log 5
print(applyV((_k) => 5))

// A boxed union whose first ARM is the numeric litunion alias: still a box, still a legal pin.
function applyM(f: (M) => i32): i32 { return f(1) }

// @log 7
print(applyM((_k) => 7))

// ── CONTROLS: the annotated twins, correct on master and unchanged ─────────────────────────
// @log 1
print(applyZ((_z: Z) => 1))
// @log 5
print(applyV((_k: i32 | string) => 5))
