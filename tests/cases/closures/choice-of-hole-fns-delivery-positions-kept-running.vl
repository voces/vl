// Delivery positions a choice of un-annotated functions reached before D17097: bindings, returns,
// fields, an explicit type argument, a lambda parameter, a nullable binding, a re-pointed `let`,
// members returning one type, and no call through an open parameter. An alias of the set called
// directly beside the `{ k: id(g) }` field is refused (D17107), so it is a case of its own.
function inc(a) { return a + 1 }
function str(_a) { return "s" }
function dbl(a) { return a * 2 }
function ap(g, x) { return g(x) }
function id<T>(t: T): T { return t }
function inc2(a: i32): i32 | string { return a + 1 }
function str2(_a: i32): i32 | string { return "t" }
function useK(k: (a: i32) => i32 | string) { print(k(4)) }
function useI(k: (a: i32) => i32) { print(k(4)) }
function useR(r: { k: (a: i32) => i32 | string }) { print(r.k(4)) }
function mk(c: boolean): (a: i32) => i32 | string {
  const g = if c { str } else { inc }
  print(ap(g, 3))
  return g
}
function mkId(c: boolean): (a: i32) => i32 | string {
  const g = if c { str } else { inc }
  print(ap(g, 3))
  return id(g)
}
function letK(c: boolean) {
  const g = if c { str } else { inc }
  print(ap(g, 3))
  const k: (a: i32) => i32 | string = g
  print(k(5))
}
function fieldId(c: boolean) {
  const g = if c { str } else { inc }
  print(ap(g, 3))
  const r: { k: (a: i32) => i32 | string } = { k: id(g) }
  print(r.k(6))
}
function fieldArg(c: boolean) {
  const g = if c { str } else { inc }
  print(ap(g, 3))
  useR({ k: g })
}
function explicitT(c: boolean) {
  const g = if c { str } else { inc }
  print(ap(g, 3))
  useK(id<(a: i32) => i32 | string>(g))
}
function lambdaParam(c: boolean) {
  const g = if c { str } else { inc }
  print(ap(g, 3))
  const f = (k: (a: i32) => i32 | string) => print(k(7))
  f(g)
}
function nullableLet(c: boolean) {
  const g = if c { str } else { inc }
  print(ap(g, 3))
  const o: ((a: i32) => i32 | string) | null = g
  if o != null { print(o(8)) }
}
function repointed(c: boolean) {
  let g = str
  if !c { g = inc }
  print(ap(g, 3))
  useK(g)
}
function sameResult(c: boolean) {
  const g = if c { dbl } else { inc }
  print(ap(g, 3))
  useI(g)
  useI(id(g))
}
function sameResultUncalled(c: boolean) {
  const h = if c { dbl } else { inc }
  useI(h)
  useI(id(h))
}
function single() {
  const s = inc
  print(ap(s, 3))
  useI(id(s))
}
function untaggedLetId(c: boolean) {
  const g = if c { str } else { inc }
  const k: (a: i32) => i32 | string = id(g)
  print(k(4))
}
function untaggedInline(c: boolean) {
  const d: (a: i32) => i32 | string = if c { str } else { inc }
  print(d(5))
}
function annotatedMembers(c: boolean) {
  const e = if c { str2 } else { inc2 }
  print(ap(e, 3))
  useK(e)
  useK(id(e))
}
single()
for c in [true, false] {
  print(mk(c)(4))
  print(mkId(c)(5))
  letK(c)
  fieldId(c)
  fieldArg(c)
  explicitT(c)
  lambdaParam(c)
  nullableLet(c)
  repointed(c)
  sameResult(c)
  sameResultUncalled(c)
  untaggedLetId(c)
  untaggedInline(c)
  annotatedMembers(c)
}
