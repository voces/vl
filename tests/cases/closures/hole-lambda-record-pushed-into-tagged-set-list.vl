// @run
// @log 4
// @log 1.5
// @log 9
// @log 15
// @log 2
// A record literal holding an un-annotated lambda, written into a list whose functions return
// different types, stores the lambda as an id of the list's set, captures included (D16937).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const k = 5
const xs = [{ f: inc0 }, { f: half }]
xs.push({ f: (x) => x * 3 })
xs.push({ f: (x) => x * k })
const ys = [{ f: inc0 }, { f: half }]
ys[1] = { f: (x) => x - 1 }
for r in xs { print(r.f(3)) }
print(ys[1].f(3))
