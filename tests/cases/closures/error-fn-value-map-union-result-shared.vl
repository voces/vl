// @error-at 11:19 a {[string]: string} | {[string]: string | null} cannot be delivered as {[string]: string | null} here: a handle to it reaches a function literal on line 12, which this check cannot follow. A record is shared, not copied, so a wider value stored through the {[string]: string | null} would sit in the {[string]: string} | {[string]: string | null} it came from. Declare the source as {[string]: string | null}, pass a fresh copy, or drop the write
// D2715: a function returning `A | B` taken as one returning `B` is adapted, and the adapter's
// result shares a map that may be an `A` at the wider value type, which only a fresh value may.
type A = {[string]: string}
type B = {[string]: string | null}
function uA(): A | B {
  const a: A = Map()
  a["k"] = "x"
  a
}
const f: () => B = (): A | B => uA()
print(f().length)
