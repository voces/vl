// @run
// @log v
// @log 3
// A `let` copy of a hole parameter that is re-pointed is not the parameter: a `const` record
// literal holding it keeps the copy's own set, decided with the parameter's (D15404, D15409).
function same<T>(k: T): T { k }
function dbl(x) { x }
function mid2(a) {
  let b = a
  b = dbl
  const r = { f: b }
  print(r.f("v"))
  print(a(3))
}
mid2(same)
