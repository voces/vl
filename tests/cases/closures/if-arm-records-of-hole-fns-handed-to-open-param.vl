// @run
// @log 2
// @log 2
// @log 2.5
// @log 5
// @log 2
// @log 2
// @log 4
// A value `if` of record literals whose function fields are un-annotated, handed to an
// un-annotated parameter, takes the parameter's instance type at every arm: two members or one,
// an `else if` chain, a `match`, a list field, and calls at two types through two callees (D15301).
function id1(a) { return a }
function id2(a) { return a }
const c = 1 > 0
const n = 3
function g(r) { return r.f(2) }
function h(r) { return r.f(2.5) }
function twice(r) { return r.f(2) + r.f(3) }
function first(r) { return r.f[0](4) }
print(g(if c { { f: id1 } } else { { f: id2 } }))
print(g(if c { { f: id1 } } else { { f: id1 } }))
print(h(if c { { f: id1 } } else { { f: id2 } }))
print(twice(if c { { f: id1 } } else { { f: id2 } }))
print(
  g(if n > 5 { { f: id1 } } else if n > 1 { { f: id2 } } else { { f: id1 } }),
)
print(
  g(
    match n {
      1 => { f: id1 }
      _ => { f: id2 }
    },
  ),
)
print(first(if c { { f: [id1] } } else { { f: [id2] } }))
