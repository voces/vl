// @emit-error the captured binding `k` is written with a function inside a closure that every instance of
// A lambda annotated `(u: i32)` written into a cell the instance wants at string (review of #3498, `rv3498/round5/f16_annotated_concrete_lambda_into_cell_string`).
function inner<U>(u: U) { print("I"); print(u) }
function a<T>(x: T) {
  let k = inner
  const w = () => {
    k = (u: i32) => {
      print("L"); print(u)
    }
  }
  w()
  k(x)
}
a("s")
