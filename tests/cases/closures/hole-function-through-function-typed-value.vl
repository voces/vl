// @run
// @log 2
// @log 2
// @log 2
// @log 6
// @log s
// @log 2.5
// @log 9
// A hole function named as an argument of a call through a function value of a concrete type is
// instanced at that value's parameter type (D6531): an annotated parameter, a `const`, a written
// `let`, and the `string`, `f64` and parenthesised spellings.
function id(a) { return a }
function dbl(a) { return a * 2 }
function idS(a) { return a }
function idF(a) { return a }
const lap = (g: (x: i32) => i32): i32 => {
  return g(1) + 1
}
function use(k: (g: (x: i32) => i32) => i32) { return k(id) }
print(use(lap))
const k: (g: (x: i32) => i32) => i32 = lap
print(k(id))
let w: (g: (x: i32) => i32) => i32 = (g) => g(1) + 1
print(w(id))
w = (g) => g(3)
print(w(dbl))
function useS(k: (g: (x: string) => string) => string) { return k(idS) }
print(useS((g) => g("s")))
function useF(k: (g: (x: f64) => f64) => f64) { return k(idF) }
print(useF((g) => g(2.5)))
function useP(k: (g: (x: i32) => i32) => i32) { return k((id)) }
print(useP((g) => g(9)))
