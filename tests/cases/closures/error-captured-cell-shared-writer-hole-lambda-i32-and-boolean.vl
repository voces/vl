// @emit-error the captured binding `k` is written with a function inside a closure that every instance of
// A hole lambda written by a closure every instance shares is one lambda, refused at two types (review of #3498, `rv3498/e02_shared_writer_hole_lambda_i32_bool`).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function third<Z>(z: Z) { print("T"); print(z) }
function a<T>(x: T) {
  let k = inner
  const w = () => {
    k = (u) => {
      print("L"); print(u)
    }
  }
  k(x)
  w()
  k(x)
}
a(1)
a(true)
