// @error cannot hand this `if` to 'r.f' inline: its arms store functions there that do not return one type at this call — bind the `if` to a name first
// The same `if` handed to a parameter whose call through the field passes another parameter:
// the call's types are known only at the call site, where its functions are judged (D15807).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function two() { [1, 2].length }
function take2(n, r) { return r.f(n) }
print(take2(3, if two() > 5 { { f: half } } else { { f: inc0 } }))
