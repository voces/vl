// @run
// @log 3
// @log 8
// A hole function parameter a nested lambda hands on to a hole called at two argument types is
// instanced at each, as handing it on directly is (D13860).
function add(a, b) { return a + b }
function apply2(g, s) { print(g(s, s)) }
function outer(h) {
  const run = (x) => {
    apply2(h, x)
  }
  run(1.5)
  run(4)
}
outer(add)
