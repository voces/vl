// @run
// @info `lv` is never reassigned; use `const` instead of `let`
// @log 5
// @log 2.5
// @log 5
// @log 2.5
// @log 5
// @log 5
// @log 2.5
// @log 5
// A two-signature bundle stored in a record field and read back through `const` copies of the
// read, from module scope and a function body, and a `let` nothing reassigns stored in the field:
// each copy holds the record whole and each call takes its member (D17174, D17175).
function lap(f) {
  f(2.5)
  f(3)
  return f
}
const w = { f: lap((a) => a + 1) }
const v = w.f
const u = v
print(u(4))
print(u(1.5))
function g() {
  const w2 = { f: lap((a) => a + 1) }
  const v2 = w2.f
  const u2 = v2
  print(u2(4))
  print(u2(1.5))
}
g()
let lv = lap((a) => a + 1)
const w3 = { f: lv }
print(w3.f(4))
const k = w3.f
print(k(4))
print(k(1.5))
const w4 = { f: lap((a) => a + 1) }
const z = w4.f
const z2 = z
const z3 = z2
print(z3(4))
