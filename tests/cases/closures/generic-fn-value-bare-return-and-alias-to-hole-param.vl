// @run
// @log 1
// @log 6
// @log str
// @log 2
// @log 3
// @log 8
// @log x
// @log x
// @log 7
// @log x
// @log y
// @log 9
// A generic named bare in an un-annotated function's `return` is instanced at the call that fixes
// its type, past the return (D5360); an alias of a generic handed to an un-annotated parameter is
// instanced at the calls the body makes, as the generic's own name is (D5361).
// A non-generic function returned bare is called through its interned signature (D3384).
function k<T>(x: T): T { return x }
function mk() { return k }
function mks() { return k }
function mkp() { return (k) }
function pick(b: boolean) {
  if b { return k }
  return k
}
function nine() { return 9 }
function deliver() { return nine }
function apply(f: (x: i32) => i32) { print(f(6)) }
function take(a) { print(a("x")) }
function takeN(a) { print(a(7)) }
const top = mk()
function main() {
  const h = mk()
  print(h(1))
  apply(mk())
  print(mks()("str"))
  print(mkp()(2))
  print(pick(true)(3))
  print(top(8))
  const g = k
  const j = g
  take(g)
  take(k)
  takeN(j)
  take((g))
  print(j("y"))
  const v = deliver()
  print(v())
}
main()
