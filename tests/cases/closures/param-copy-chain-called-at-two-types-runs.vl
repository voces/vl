// @run
// @info `v` is never reassigned; use `const` instead of `let`
// @info `w` is never reassigned; use `const` instead of `let`
// @log abc
// @log 8
// @log dup
// @log abc
// @log dup
// @log 8
// @log x
// @log 3
// @log true
// @log y
// @log 4
// @log dup
// @log z
// @log dup
// @log 5
// A parameter's generic value copied through a chain of bindings, `const` or `let` never
// re-pointed, and called at two types runs each call at its own instance, from two callers.
function id<T>(x: T): T { x }
function dup<T>(x: T): T {
  print("dup")
  x
}
function take(a) {
  const v = a
  const w = v
  print(w("abc"))
  print(w(7) + 1)
}
take(id)
take(dup)
function three(a) {
  const v = a
  const w = v
  const u = w
  print(u("x"))
  print(u(2) + 1)
}
three(id)
function both(a) {
  const v = a
  const w = v
  print(v(true))
  print(w("y"))
  print(w(3) + 1)
}
both(id)
function lets(a) {
  let v = a
  let w = v
  print(w("z"))
  print(w(4) + 1)
}
lets(dup)
