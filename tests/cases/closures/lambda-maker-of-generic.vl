// @run
// @log 1
// @log 2
// @log 3
// @log s
// @log 4
// @log 5
// @log 6
// @log 7
// @log t
// A lambda returning a generic, or a function whose body ends in one, is followed to the
// binding its result initializes, so a call through that binding fixes the generic's type
// (D6340, D6370). Also with a block body, at two types, and a named function's tail.
function k<T>(x: T): T { return x }
const mk = () => k
const a = mk()
print(a(1))
const mkb = () => {
  return k
}
const b = mkb()
print(b(2))
const mkc = () => k
const c = mkc()
print(c(3))
print(c("s"))
function id(x: i32) { x }
const mkd = () => id
const d = mkd()
print(d(4))
function mke() { id }
const e = mke()
print(e(5))
function mkf() { k }
const f = mkf()
print(f(6))
print(f(7))
print(f("t"))
