// @run
// @log 2
// @log b
// @log 2.5
// @log 2
// @log y
// @log 1
// @log x
// A written `let` of functions taking a list, called directly with list literals at several
// element types: every member takes the literal at its own type, so the binding holds an id.
function fst<T>(xs: T[]): T { return xs[0] }
function lst<T>(xs: T[]): T { return xs[xs.length - 1] }
let fc = fst
if [1].length > 0 { fc = lst }
print(fc([1, 2]))
print(fc(["a", "b"]))
print(fc([1.5, 2.5]))
print(fc([[1], [2, 3]])[0])
function hfst(xs) { return xs[0] }
function hlst(xs) { return xs[xs.length - 1] }
let fh = hlst
if [1].length > 5 { fh = hfst }
print(fh(["x", "y"]))
fh = hfst
print(fh([1, 2]))
print(fh(["x", "y"]))
