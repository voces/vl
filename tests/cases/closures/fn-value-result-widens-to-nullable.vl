// @run
// @hint Intentionally-unused parameter
// @hint Intentionally-unused parameter
// @hint Intentionally-unused parameter
// @hint Intentionally-unused parameter
// @hint Intentionally-unused parameter
// @hint Intentionally-unused parameter
// @hint Intentionally-unused parameter
// @log 4
// @log ab
// @log 6
// @log 42
// @log s!
// @log 2.5
// @log 1.5
// @log 0
// @log 1.5
// @log 2
// @log a
// @log zz
// @log 2.5
// @log 2
// @log 2
// @log 11
// @log 3
// @log 0
// @log 4
// A function value delivered at a function type whose result is its own result or `null` is
// called through an adapter that widens the result (D9781), at a binding, an argument and the
// tails of a join, annotated or not (D9881), and the elements of a list literal (D9882).
type R = {x: i32, y: string}
function n(_x: i32): f64[] { return [1.5, 2.5] }
function z(_x: i32): f64[] | null { return null }
function sl(_x: i32) { return ["a", "b"] }
function rec(x: i32): R { return { x: x, y: "p" } }
function iv(x: i32) { return x + 1 }
function sv(_x: i32) { return "s" }

const v: (x: i32) => f64[] | null = n
const r = v(1)
if r != null { print(r[0] + r[1]) } else { print(0) }

const vs: (x: i32) => string[] | null = sl
const rs = vs(1)
if rs != null { print(rs[0] + rs[1]) } else { print(0) }

const vr: (x: i32) => R | null = rec
const rr = vr(5)
if rr != null { print(rr.x + rr.y.length) } else { print(0) }

const vi: (x: i32) => i32 | null = iv
const ri = vi(40)
if ri != null { print(ri + 1) } else { print(0) }

const vstr: (x: i32) => string | null = sv
const rstr = vstr(1)
if rstr != null { print(rstr + "!") } else { print(0) }

function g(f: (x: i32) => f64[] | null) {
  const a = f(1)
  if a != null { return a[1] }
  0.0
}
print(g(n))

const c = [1].length > 0
const j: (x: i32) => f64[] | null = if c { n } else { z }
const rj = j(1)
if rj != null { print(rj[0]) } else { print(0) }
print(g(if c { z } else { n }))

// An un-annotated join of the two takes the wider type, and each tail is adapted to it.
const k = if c { n } else { z }
const rk = k(1)
if rk != null { print(rk[0]) } else { print(0) }
const rk2 = k(2)
if rk2 != null { print(rk2.length) } else { print(0) }

function lit(_x: i32): "a" | "b" { return "a" }
function str(_x: i32) { return "zz" }
const ls = if c { lit } else { str }
print(ls(1))
const ls2 = if c { str } else { lit }
print(ls2(1))

// An un-annotated list literal of the two holds each element adapted to the joined type (D9882).
const xs = [n, z]
const xa = xs[0]
const rx = xa(1)
if rx != null { print(rx[1]) } else { print(0) }
const xss = [[z], [n]]
const xb = xss[1][0]
const rxb = xb(1)
if rxb != null { print(rxb.length) } else { print(0) }

// An unboxed scalar into a boxed result, and a closure into a nullable closure result.
type F = (i32) => i32
function idf(x: i32): F { return (y) => y + x }
function takeBox(f: (i32) => (i32 | null)) {
  const b = f(1)
  if b == null { print("N") } else { print(b) }
}
function takeNulClo(f: (i32) => (F | null)) {
  const h = f(1)
  if h == null { print("N") } else { print(h(10)) }
}
takeBox(iv)
takeNulClo(idf)

// Controls: a lambda written at the slot, and a function declared at the slot's result.
const lam: (x: i32) => f64[] | null = (_x: i32) => [1.0, 2.0, 3.0]
const rl = lam(1)
if rl != null { print(rl.length) } else { print(0) }
const vz: (x: i32) => f64[] | null = z
const rz = vz(1)
if rz != null { print(rz.length) } else { print(0) }
const vn: (x: i32) => f64[] = n
print(vn(1)[0] + vn(1)[1])
