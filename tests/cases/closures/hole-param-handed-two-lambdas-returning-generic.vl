// @run
// @log 84
// @log 124
// A hole parameter handed two lambdas, each returning a generic function, calls the one returned:
// each generic is instanced at that call's arguments (D16130).
function inc(x) { return x + 1 }
function dbl(x) { return x + x }
function run(f) { return f()(41) }
print(run(() => inc) + run(() => inc))
function run2(f) { return f()(41) }
print(run2(() => inc) + run2(() => dbl))
