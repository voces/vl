// @run
// @log 6
// @log 4
// @log 4
// @log 6
// @log 4
// @log 6
// @log 6
// A bound list of records holding un-annotated functions, returned beside a literal of another
// set, keeps running: its ids are shared with the joined set, so one list row builds both.
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function last(b) {
  const a = [{ fs: [inc0] }]
  if b { return a }
  return [{ fs: [dbl] }]
}
function first(b) {
  const a = [{ fs: [inc0] }]
  if b { return [{ fs: [dbl] }] }
  return a
}
function three(n) {
  const a = [{ fs: [inc0] }]
  const c = [{ fs: [dbl] }]
  if n == 0 { return a }
  if n == 1 { return c }
  return [{ fs: [inc0, dbl] }]
}
print(last(false)[0].fs[0](3))
print(last(true)[0].fs[0](3))
print(first(false)[0].fs[0](3))
print(first(true)[0].fs[0](3))
print(three(0)[0].fs[0](3))
print(three(1)[0].fs[0](3))
print(three(2)[0].fs[1](3))
