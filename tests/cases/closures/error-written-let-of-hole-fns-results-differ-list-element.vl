// @error cannot write 'half' to 'f': called at (i32) it returns f64, where 'inc0', also written to it, returns i32
// An element of a list literal holding a re-pointed `let` may be either function the binding
// held, so a call through the element judges the writes as a call through the binding does.
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
let f = inc0
f = half
const xs = [f]
print(xs[0](3))
