// @run
// @log 3
// @log s
// A list of a generic function written with a fixed-type function through a parameter of a
// function that only writes it, beside a call of the generic at another type that cannot
// reach the list (D10083).
function id<T>(x: T): T { x }
function inc(x: i32) { x + 1 }
const ys = [id]
function fill(a) { a.push(inc) }
fill(ys)
print(ys[1](2))
print(id("s"))
