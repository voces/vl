// @run
// @log 6
// @log 6
// @log 6
// A `const` holding an `if` choice of two functions keeps its set's id when it is pushed onto, or
// stored into, a list of that set and called through it (D15063).
function inc0(a) { return a + 1 }
function dbl0(a) { return a * 2 }
const b = true
const fs = [dbl0]
const g = if b { inc0 } else { dbl0 }
fs.push(g)
print(fs[1](5))
const gs = [dbl0]
const h = if b { inc0 } else { dbl0 }
gs[0] = h
print(gs[0](5))
function main() {
  const ks = [dbl0]
  const k = if b { inc0 } else { dbl0 }
  ks.push(k)
  print(ks[1](5))
}
main()
