// @run
// @log 1.5
// @log 4
// A writer's result handed back through another function and called runs the written function
// (D16230).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function put(ys) { ys[0] = half }
function hand(zs) { put(zs) }
const xs = [inc0]
const g = hand(xs)
print(xs[0](3))
print(g(8))
