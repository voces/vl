// @run
// @log 2
// @log 3
// @log 2
// @log 8
// @log 1
// @log 6
// @log 1.5
// @log 4.25
// A hole parameter of a lambda is framed at the closure type its callers bind, and a hole-typed
// argument it is called with (a captured un-annotated parameter) is written as its slot holds it.
function snd(a, b) { return b + a * 0 }
function fst(a, b) { return a + b * 0 }
function apply2(g) { print(g(1, 2)) }
// a lambda pushed onto a list of hole functions, called through the loop variable
const fs = [apply2]
function add(k) {
  fs.push((g) => {
    print(g(k, 3))
  })
}
add(9)
for f in fs { f(snd) }
// the captured argument in the second position
const hs = [apply2]
function more(k) {
  hs.push((g) => {
    print(g(4, k))
  })
}
more(8)
for f in hs { f(snd) }
// a constant argument beside it, and another bound function
const ls = [apply2]
function other(k) {
  ls.push((g) => {
    print(g(k, 7))
  })
}
other(6)
for f in ls { f(fst) }
// a float captured argument at an `f64` key slot
function apply2f(g) { print(g(1.5, 2.5)) }
const ws = [apply2f]
function wide(k) {
  ws.push((g) => {
    print(g(k, 0.5))
  })
}
wide(4.25)
for f in ws { f(fst) }
