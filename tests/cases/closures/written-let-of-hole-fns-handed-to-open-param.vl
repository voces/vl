// @run
// @hint Intentionally-unused parameter `_a` (leading `_` marks it unused)
// @log s
// @log 4
// @log s
// @log 4
// @log 6
// @log 4
// D16009: a re-pointed `let` of un-annotated functions whose results differ, handed to an open
// parameter, dispatches in the callee's instance on the member it holds, and the caller reads the
// members' join: handed directly, forwarded twice, and with members that agree.
function inc(a) { return a + 1 }
function str(_a) { return "s" }
function dbl(a) { return a * 2 }
function ap(g, x) { return g(x) }
function ap2(g, x) { return ap(g, x) }
function handed(c: boolean) {
  let f = inc
  if c { f = str }
  print(ap(f, 3))
}
function fwd(c: boolean) {
  let f = inc
  if c { f = str }
  print(ap2(f, 3))
}
function agree(c: boolean) {
  let f = inc
  if c { f = dbl }
  print(ap(f, 3))
}
handed(true)
handed(false)
fwd(true)
fwd(false)
agree(true)
agree(false)
