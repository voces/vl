// @error cannot store 'half' in an element of 'xs': called at (i32) it returns f64, where 'inc0', also stored in it, returns i32
// A call through an element of a list literal of un-annotated functions with different results
// is refused, as a call through its annotated twin's union element is (D9092).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const xs = [inc0, half]
const i = xs.length - 1
print(xs[i](3))
