// @run
// @log 4
// @log 13
// @log 6
// @log 4
// @log 6
// @log 0.75
// @log a!
// @log 3
// A list literal of un-annotated lambdas or hole functions handed to an un-annotated parameter
// that calls an element is delivered at the type that call gives it, as the function alone is
// (D6601).
function run(fs) { return fs[0](3) }
function runCopy(fs) {
  const g = fs[0]
  return g(3)
}
function runF(fs) { return fs[0](1.5) }
function runS(fs) { return fs[0]("a") }
const h = (u) => u + 1
print(run([h]))
const k = (u) => u + 10
print(run([k]))
print(h(5))
print(runCopy([h]))
function twice(u) { return u * 2 }
print(run([twice]))
function half(u) { return u * 0.5 }
print(runF([half]))
const bang = (u) => u + "!"
print(runS([bang]))
function idT<T>(a: T): T { return a }
print(run([idT]))
