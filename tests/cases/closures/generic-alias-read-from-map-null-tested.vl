// @run
// @log 41
// @log 41
// A generic read out of a map through an alias or a call result may be absent: its null test
// reads the map's value, and only the narrowed call names the generic.
function k<T>(x: T): T { return x }
function mk() { return k }
const g = k
const m = Map()
m["a"] = g
const mv = m["a"]
if mv != null { print(mv(41)) }
const n = Map()
n.set("b", mk())
const nv = n.get("b")
if nv != null { print(nv(41)) }
