// @run
// @log 4
// @log 3
// @log 30
// D7842's join called once at each arm, its result delivered to `print` instead of discarded.
function add(a, b) { return a + b }
function p(g) {
  print(g(1.5, 2.5))
  return g(1, 2)
}
function q(g) { return g(10, 20) }
function main(c: boolean) {
  const f = if c { p } else { q }
  print(f(add))
}
main(true)
main(false)
