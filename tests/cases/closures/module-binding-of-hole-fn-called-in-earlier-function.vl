// @run
// @info `l` is never reassigned; use `const` instead of `let`
// @log 3
// @log v
// @log w
// @log 5
// @log 3
// @log ab
// @log x
// @log y!
// @log z
// @log u
// A module binding of a function returned through a hole is typed before a function declared
// above it reads it, so the call there is lowered at the binding's own instance (D6000).
function fw(f) { return f }
function id(x) { return x }
function add(a, b) { return a + b }
function k<T>(x: T): T { return x }
function mk() { return k }
print(id(3))
function g() {
  print(q("v"))
  print(q("w"))
  print(q(5))
}
function h() {
  print(p(1, 2))
  print(p("a", "b"))
}
function r() { return q("x") }
function s() {
  const t = l("y")
  print(t + "!")
}
function u() { print(m("z")) }
const lam = () => {
  print(q("u"))
}
const q = fw(id)
const p = fw(add)
let l = fw(id)
const m = mk()
g()
h()
print(r())
s()
u()
lam()
