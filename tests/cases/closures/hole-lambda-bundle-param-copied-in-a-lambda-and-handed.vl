// @run
// @log 5
// @log 2.5
// @log 10
// @log 8
// @log 3
// @log 7
// @log 4.5
// A `const` copy, inside a lambda, of a parameter holding a hole lambda's bundle, handed on: called
// there too, two lambdas deep, and in a lambda handed to another function (D15911).
function lap(f) {
  f(2.5)
  f(3)
  return f
}
function take(b) {
  print(b(4))
  print(b(1.5))
}
function run2(h) { h() }
function fw(a) {
  const k = () => {
    const v = a
    take(v)
    print(v(9))
  }
  k()
}
function deep(a) {
  const k = () => {
    const j = () => {
      const v = a
      take(v)
    }
    j()
  }
  k()
}
function via(a) {
  run2(() => {
    const v = a
    take(v)
  })
}
fw(lap((a) => a + 1))
deep(lap((a) => a * 2))
via(lap((a) => a + 3))
