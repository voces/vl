// @run
// @log 30
// @log xy
// D10793: the element hands its parameter on to another hole function, and a string lambda.
function call(h, x, y) { return h(x, y) }
function apply2(g) { print(g(1, 2)) }
function apply3(g) { print(call(g, 10, 20)) }
const gs = [apply2, apply3]
gs[1]((a, b) => a + b)
function s2(g) { print(g("a", "b")) }
function s3(g) { print(g("x", "y")) }
const ss = [s2, s3]
ss[1]((a, b) => a + b)
