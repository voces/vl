// @run
// @log v
// @log 5
// @log 4
// @log j
// @log w
// A generic returned by one maker and by one arm of a second, whose results are called at two
// types: the first maker's result is decided with the second's wider set.
function k<T>(x: T): T { return x }
function j<T>(x: T): T {
  print("j")
  return x
}
function mkOne() { return k }
function mkPick(f: boolean) {
  if f { return k }
  return j
}
function main() {
  const l = mkOne()
  print(l("v"))
  print(mkOne()(5))
  const m = mkPick(true)
  print(m(4))
  const n = mkPick(false)
  print(n("w"))
}
main()
