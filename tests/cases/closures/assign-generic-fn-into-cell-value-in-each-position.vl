// @run
// @hint Intentionally-unused variable `_a`
// @hint Intentionally-unused variable `_b`
// @hint Intentionally-unused variable `_c`
// @hint Intentionally-unused variable `_e`
// @log O
// @log 1
// @log O
// @log 1
// @log I
// @log 1
// @log I
// @log 1
// @log O
// @log s
// @log I
// @log s
// @log I
// @log s
// @log I
// @log s
// A generic function assigned into a closure cell whose type leaves a part open, the assignment
// used as a value, in each position: a return, an `if` arm, an initializer and a record field; the
// cell holds the new function after each.
function inner<U>(u: U) {
  print("I")
  print(u)
}
function other<V>(v: V) {
  print("O")
  print(v)
}
type H<T> = { f: (t: T) => void }
function go<T>(x: T, w: boolean) {
  let k: (t: T) => void = inner
  const ret = () => {
    return k = other
  }
  const arm = () => {
    return if w { k = other } else { k = inner }
  }
  const init = () => {
    const g = k = inner
    return g
  }
  const rec = () => {
    const h: H<T> = { f: k = inner }
    return h
  }
  const _a = ret()
  k(x)
  const _b = arm()
  k(x)
  const _c = init()
  k(x)
  const _e = rec()
  k(x)
}
go(1, true)
go("s", false)
