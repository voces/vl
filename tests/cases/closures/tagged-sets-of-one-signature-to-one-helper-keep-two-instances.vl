// @run
// @log g1
// @log 10
// @log g3
// @log 20
// One helper that calls its parameter, handed two tagged sets of one signature, dispatches over
// each set apart: the set is part of the instance key, though both reps are an id (§3.4).
function g1<T>(y: T): T {
  print("g1")
  y
}
function g2<T>(y: T): T {
  print("g2")
  y
}
function g3<T>(y: T): T {
  print("g3")
  y
}
function app(f, x) { f(x) }
const a = if [1].length > 0 { g1 } else { g2 }
const b = if [1].length > 1 { g1 } else { g3 }
print(app(a, 10))
print(app(b, 20))
