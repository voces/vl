// @run
// @hint Intentionally-unused parameter `_u`
// @log R
// @log 7
// @log R
// @log t
// @log I
// @log 1
// @log R
// @log 2
// @log R
// @log true
// @log H
// @log H
// @log L
// @log 5
// A `let` seeded with a function that returns nothing, written one returning a value, is called
// at two types and at one, each call dropping the result (owner ruling B2; D15449, D15031,
// D15448): at module scope, in a function, with declared generics, a record and a lambda.
function inner(u) { print("I"); print(u) }
function retV(v) { print("R"); print(v); v }
let m = inner
m = retV
m(7)
m("t")
function local() {
  let k = inner
  k(1)
  k = retV
  k(2)
  k(true)
}
local()
function ginner<U>(_u: U) { print("G") }
function gret<V>(v: V): V { print("H"); v }
function rec() {
  let k = ginner
  k = gret
  k({ a: 1 })
  k(3)
}
rec()
const h = (x) => {
  print("L"); print(x); x
}
let q = inner
q = h
q(5)
