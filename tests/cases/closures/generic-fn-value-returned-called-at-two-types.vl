// @run
// @log 1
// @log s
// @log 2
// @log t
// @log 7
// @log 3
// @log 8
// @log u
// @log 9
// @log 2.5
// @log 0
// @log 1
// @log v
// @log 5
// @log 4
// @log j
// @log w
// @log 6
// @log x
// @log fw
// @log 7
// @log y
// A generic returned bare from an un-annotated function, whose results are called at two types,
// is a copy of that function per result type; through an identity call, one value is (D5531).
function k<T>(x: T): T { return x }
function j<T>(x: T): T {
  print("j")
  return x
}
function mk() { return k }
function mkAlias() {
  const g = k
  return g
}
function mkArg(n: i32) {
  print(n)
  return k
}
function mkLoop() { return k }
function mkPick(f: boolean) {
  if f { return k }
  return j
}
function fw(f) { return f }
function fwSay(f) {
  print("fw")
  return f
}
function main() {
  const a = mk()
  print(a(1))
  const b = mk()
  print(b("s"))
  const c = mkAlias()
  print(c(2))
  const d = mkAlias()
  print(d("t"))
  const e = mkArg(7)
  print(e(3))
  const f = mkArg(8)
  print(f("u"))
  const g = mkArg(9)
  print(g(2.5))
  let i = 0
  while i < 2 {
    const h = mkLoop()
    print(h(i))
    i = i + 1
  }
  const l = mkLoop()
  print(l("v"))
  print(mkLoop()(5))
  const m = mkPick(true)
  print(m(4))
  const n = mkPick(false)
  print(n("w"))
  const o = fw(k)
  print(o(6))
  print(o("x"))
  const q = fwSay(k)
  print(q(7))
  print(q("y"))
}
main()
