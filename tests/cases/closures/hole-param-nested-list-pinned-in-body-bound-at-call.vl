// @run
// @log 0.5
// @log 0.5
// @log 0.5
// A list the body pushes onto an un-annotated parameter's argument, then writes to, is pinned at
// the call, so an un-annotated binding of the call's result reads the pinned element (D16421).
function f(a) { a.push([]); a[0].push(0.5); return a[0][0] }
const v = f([])
print(v)
function g(a) {
  a.push({ ys: [] }); a.push({ ys: [] }); a[0].ys.push(0.5); return a[0].ys[0]
}
const w = g([])
print(w)
function h(a) {
  a.push([]); a[0].push([]); a[0][0].push(0.5); return a[0][0][0]
}
const x = h([])
print(x)
