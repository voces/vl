// @error cannot write 'half' to 'f': called at (i32) it returns f64, where 'inc0', also written to it, returns i32
// A re-pointed `let` handed to a parameter called at another un-annotated parameter is judged
// at the type the outer call gives that parameter, so a write whose body differs there is
// refused (D9009).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function w(h, x) { return h(x) }
let f = inc0
f = half
print(w(f, 3))
