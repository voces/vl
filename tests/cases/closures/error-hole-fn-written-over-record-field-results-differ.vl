// @error cannot write 'half' to 'r.f': called at (i32) it returns f64, where 'inc0', also written to it, returns i32
// A record field written with an un-annotated function of another result than the one it held is
// refused at the write, as a list element is (D9060).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const r = { f: inc0 }
r.f = half
print(r.f(3))
