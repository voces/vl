// @error cannot write 'half' to 'f': called at (i32) it returns f64, where 'inc0', also written to it, returns i32
// A re-pointed `let` of un-annotated functions called at `i32` runs either one, so a write of
// one whose body gives another result there is refused at the write (D9003).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
let f = inc0
if [1].length > 0 { f = half }
print(f(3))
