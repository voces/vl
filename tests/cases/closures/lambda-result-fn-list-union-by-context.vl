// @run
// @log z
// @log z
// @log z
// @log 2.5
// @log z
// A lambda whose result is a value union of a list of functions and a scalar, typed only by the
// function type it is delivered to: at a parameter, a binding, a returned lambda, a declared
// `f64` arm, and handed on to a generic's open result (D9970).
function take(v: () => (() => string)[] | i32) {
  const t = v()
  if t is i32 { print(t) } else { print(t[0]()) }
}
take(() => [() => "z"])
const b: () => (() => string)[] | i32 = () => [() => "z"]
take(b)
function mk(): () => (() => string)[] | i32 { return () => [() => "z"] }
take(mk())
const n: () => (() => f64)[] | i32 = () => [() => 2.5]
const tn = n()
if tn is i32 { print(tn) } else { print(tn[0]()) }
function pass<T>(g: () => T): T { g() }
const tp = pass(b)
if tp is i32 { print(tp) } else { print(tp[0]()) }
