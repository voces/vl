// @run
// @log 6
// @log 6
// @log 2
// Lists of hole functions that share members join into one set, so a callback calling through
// any of them reaches each member's instance.
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function sq(a) { return a * a }
function take(a) { print(a.map((f) => f(3))[1]) }
const g = [inc0, dbl]
take(g)
const h = [sq, inc0]
function last(a) { print(a.map((f) => f(5))[1]) }
last(h)
function keep(a) { print(a.filter((f) => f(2) > 3).length) }
keep([inc0, dbl, sq])
