// @run
// @log ab
// @log 3
// @log ab
// @log 5
// @log 7
// @log 2
// A function type that differs only where the rep does not, a single literal for its base or a
// union's member order, needs no adapter: the value is delivered as it is, bare or in a container.
type Circle = { r: i32 }
type Sq = { s: i32 }
function S(): "ab" { return "ab" }
function N(): 3 { return 3 }
function F(): Circle | Sq { return { s: 5 } }
function G(): Circle | Sq { return { r: 7 } }
function show(q: Sq | Circle) {
  if q is Sq { print(q.s) } else { print(q.r) }
}
function L(x: string) { return x.length }
function main() {
  let s = S
  const ss: () => string = s
  s = S
  print(ss())
  const ns: readonly (() => i32)[] = [N]
  print(ns[0]())
  const sl = [S]
  const ts: readonly (() => string)[] = sl
  print(ts[0]())
  const fs = [F, G]
  const gs: (() => Sq | Circle)[] = fs
  show(gs[0]())
  show(gs[1]())
  const ls = [L]
  const lt: readonly ((x: "ab") => i32)[] = ls
  print(lt[0]("ab"))
}
main()
