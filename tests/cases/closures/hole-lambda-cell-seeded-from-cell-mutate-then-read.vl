// @run
// @log 0G
// @log 1G
// @log 1C
// @log 2G
// @log 2C
// @log 3C
// @log 3G
// @log 4G
// @log 4C
// Mutate-then-read over a cell seeded from another cell's read (`let d2 = d1`, both boxed because
// a nested function writes each): each link reassigned in the same function, in a nested
// function, in a loop and in a closure before the read, beside an unmutated control (D3851).
function control(x: string) {
  const c = (y) => y + "C"
  const g = (y) => y + "G"
  let d1 = g
  let d2 = d1
  function w1() {
    d1 = c
    0
  }
  function w2() {
    d2 = c
    0
  }
  print(d2(x))
}
control("0")
function seedSameFn(x: string) {
  const c = (y) => y + "C"
  const g = (y) => y + "G"
  let d1 = g
  let d2 = d1
  function w1() {
    d1 = g
    0
  }
  function w2() {
    d2 = g
    0
  }
  d1 = c
  print(d2(x))
  d2 = d1
  print(d2(x))
}
seedSameFn("1")
function seedNested(x: string) {
  const c = (y) => y + "C"
  const g = (y) => y + "G"
  let d1 = g
  let d2 = d1
  function w1() {
    d1 = c
    0
  }
  function w2() {
    d2 = d1
    0
  }
  w1()
  print(d2(x))
  w2()
  print(d2(x))
}
seedNested("2")
function seedLoop(x: string) {
  const c = (y) => y + "C"
  const g = (y) => y + "G"
  let d1 = g
  let d2 = d1
  function w1() {
    d1 = g
    0
  }
  function w2() {
    d2 = g
    0
  }
  let i = 0
  while i < 2 {
    d2 = c
    i = i + 1
  }
  print(d2(x))
  print(d1(x))
}
seedLoop("3")
function seedClosure(x: string) {
  const c = (y) => y + "C"
  const g = (y) => y + "G"
  let d1 = g
  let d2 = d1
  function w1() {
    d1 = g
    0
  }
  const w2 = (): i32 => {
    d2 = c
    0
  }
  print(d2(x))
  w2()
  print(d2(x))
}
seedClosure("4")
