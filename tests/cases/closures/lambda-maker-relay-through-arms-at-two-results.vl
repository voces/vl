// @run
// @log 4
// @log 0.5
// @log 4
// @log 0.75
// @log 4
// @log 0.75
// Two makers' hole lambdas relayed through the arms of a `match` or an `if`, delivered at two
// function types whose results differ: each relay twin returns its own copy of each arm's call
// (D16779).
function inc() { return (a) => a + 1 }
function dbl() { return (a) => a * 2 }
function pick(n: i32) {
  return match n {
    0 => inc()
    _ => dbl()
  }
}
function choose(n: i32) { return if n == 0 { inc() } else { dbl() } }
let k = true
function flip() {
  if k { return inc() }
  return dbl()
}
const v: (a: i32) => i32 = pick(0)
const w: (a: i32) => f64 = pick(1)
print(v(3))
print(w(2) / 8.0)
const v2: (a: i32) => i32 = choose(0)
const w2: (a: i32) => f64 = choose(1)
print(v2(3))
print(w2(3) / 8.0)
const v3: (a: i32) => i32 = flip()
k = false
const w3: (a: i32) => f64 = flip()
print(v3(3))
print(w3(3) / 8.0)
