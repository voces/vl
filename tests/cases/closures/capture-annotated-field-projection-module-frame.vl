// @run
// @log 1
// @log 2
// @log 3
// @log 4
// @log 5
// @log 6
// @log 7
// @log 8

// @hint redundant type annotation: `h1` is inferred as `Rec`
// @hint redundant type annotation: `h2` is inferred as `Rec`
// @hint redundant type annotation: `h3` is inferred as `Rec`
// @hint redundant type annotation: `h4` is inferred as `Rec`

// @hint redundant type annotation: `h6` is inferred as `Rec`
// @hint redundant type annotation: `h7` is inferred as `{name: string, n: i32}`
// @hint redundant type annotation: `h8` is inferred as `{name: string, n: i32}`

// D1759 / D1771 — an ANNOTATED binding of a nested-struct FIELD read, captured, at a
// MODULE-level block. The env field must take the field slot's nullable rep, not the
// annotation's non-null one; the ladder that knows this is un-annotated-only and the rung
// that would have answered needs a frame, which a module-frame block has none of.

// Every cell prints a different number, so a capture reading a neighbouring env is a wrong
// value rather than a pass. The annotation is the ingredient, so every hint is declared.

type Rec = { name: string, n: i32 }
function mk1(): Rec { return { name: "ada", n: 1 } }
function mk2(): Rec { return { name: "ada", n: 2 } }
function mk3(): Rec { return { name: "ada", n: 3 } }
function mk4(): Rec { return { name: "ada", n: 4 } }
function mk5(): Rec { return { name: "ada", n: 5 } }
function mk6(): Rec { return { name: "ada", n: 6 } }

// D1759's witness: an INFERRED holder, in a module-level `if` block.
if true {
  const box = { it: mk1() }
  const h1: Rec = box.it
  const g1 = () => h1
  print(g1().n)
}

// The same in a module-level `while`, the other module-frame block kind.
let w = 0
while w < 1 {
  const box = { it: mk2() }
  const h2: Rec = box.it
  const g2 = () => h2
  print(g2().n)
  w = w + 1
}

// D1771's witness: a DECLARED holder type fed by a helper, so the row is resolvable and the
// projection is still the thing that decides the slot.
type Boxed = { it: Rec }
function mkbox(): Boxed { return { it: mk3() } }
if true {
  const box = mkbox()
  const h3: Rec = box.it
  const g3 = () => h3
  print(g3().n)
}

// A field of a field, two hops down.
if true {
  const inner = { it: mk4() }
  const box = { inner: inner }
  const h4: Rec = box.inner.it
  const g4 = () => h4
  print(g4().n)
}

// The controls the close owes, each of which ran before and must keep running.

// The un-annotated twin at a module-level block.
if true {
  const box = { it: mk5() }
  const h5 = box.it
  const g5 = () => h5
  print(g5().n)
}

// The annotated spelling inside a FUNCTION body, where the frame-taking rung answers.
function inFn() {
  const box = { it: mk6() }
  const h6: Rec = box.it
  const g6 = () => h6
  print(g6().n)
}
inFn()

// An INDEX projection, whose slot is NOT nullable — the annotation's non-null rep is right
// there and must stay.
if true {
  const xs = [{ name: "ada", n: 7 }]
  const h7: Rec = xs[0]
  const g7 = () => h7
  print(g7().n)
}

// A CALL initialiser, which commits its own rep and never reached the projection rung.
if true {
  const h8: Rec = { name: "ada", n: 8 }
  const g8 = () => h8
  print(g8().n)
}
