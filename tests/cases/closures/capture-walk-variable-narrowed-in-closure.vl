// @run
// @log 4
// @log -1
// @log 100
// @log -1
// @log 200
// D2523, D3139: a closure narrowing a captured walk variable, or an un-annotated copy of one,
// finds its member set through the loop: an `i32 | null` box and a `K | null` atom niche, at
// module scope and in a function.
type K = "a" | "b"
const xs = [3, null]
for v in xs {
  const w = v
  const g = () => {
    if w != null { return w + 1 }
    return 0 - 1
  }
  print(g())
}
function t(ks: (K | null)[]) {
  for k in ks {
    const c = k
    const g = () => {
      if k == null { return 0 - 1 }
      if c == "a" { return 100 }
      return 200
    }
    print(g())
  }
}
t(["a", null, "b"])
