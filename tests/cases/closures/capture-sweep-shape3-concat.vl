// @run
// @log ax
// @log ay
// A closure capturing a binding held as the atom reads it at a string at a concat operand: the
// captured atom, decoded (capture binding shape 3, Q58 position sweep).
const A = "x"
const B = "y"
function main(c: boolean) {
  const M = if c { A } else { B }
  const f = () => "a" + M
  print(f())
}
main(true)
main(false)
