// @run
// @log 1.5
// @log 1.5
// @log 4
// @log 1.5
// @log 8
// @log 5
// @log 2
// @log 1.5
// @log 4
// A list of lists of un-annotated functions beside a list of lists of a wider set holding the
// same set's literal: the smaller set is decided with the wider one, whichever is written first
// (D16804).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function dbl(a) { return a * 2 }
function mk() { return [[inc0], [half]] }
const zs = mk()
print(zs[1][0](3))
const ys = [[dbl], [inc0, half]]
print(ys[1][1](3))
const bs = [[inc0], [half]]
for b in bs { print(b[0](3)) }
for y in ys {
  for f in y { print(f(4)) }
}
const cs = [[[inc0]], [[half]]]
print(cs[1][0][0](3))
const ds = [[[dbl]], [[half, inc0]]]
print(ds[1][0][1](3))
