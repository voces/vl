// @run
// @log S
// @log S
// @hint Intentionally-unused parameter `_a`
// @hint Intentionally-unused parameter `_b`
// A written `let` initialised with a generic whose first parameter is a fixed union, then written
// with another generic, is called at one type, in a function and at module scope (D5159).
function s<A, B>(_a: A, _b: B) { print("S") }
function w<B>(a: i32 | string, b: B) {
  print("W")
  print(a)
  print(b)
}
function main() {
  let k = w
  k = s
  k(5, true)
}
main()
let m = w
m = s
m("x", 2)
