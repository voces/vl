// @run
// @log 2
// @log 2.5
// @warning Unused parameter `x`
// A hole function's nested function, held in a list and called through it, returns the capture
// at each instance's pin (D1816).
function o(n) {
  function k(x: i32) { return n }
  const fs = [k]
  return fs[0](1)
}
print(o(2))
print(o(2.5))
