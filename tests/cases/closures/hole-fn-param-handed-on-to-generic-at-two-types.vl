// @run
// @log 3
// @log 8
// A hole function parameter handed on to a hole called at two argument types is instanced at
// each, as handing the function itself is (D13860).
function add(a, b) { return a + b }
function apply2(g, s) { print(g(s, s)) }
function outer(h) {
  apply2(h, 1.5)
  apply2(h, 4)
}
outer(add)
