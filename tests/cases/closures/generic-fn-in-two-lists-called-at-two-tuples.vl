// @run
// @log 1
// @log 2.5
// @log s
// @log 3.5
// @log a
// @log b
// @log q
// @log 4.25
// A generic function held in two list literals, each called at its own tuple, is one set: each
// list holds its ids and each call reaches the instance at its own argument types.
function idT<T>(a: T): T { return a }
const ts = [idT]
const t = ts[0]
print(t(1))
const tf = [idT]
const u = tf[0]
print(u(2.5))
const gs = [idT]
print(gs[0]("s"))
const hs = [idT]
print(hs[0](2.5) + 1.0)
function sa(a: i32) {
  if a > 0 { return "a" }
  return "z"
}
function sb(a: i32) {
  if a > 0 { return "b" }
  return "z"
}
const ss = [sa, sb]
print(ss[0](1))
print(ss[1](2))
const qs = [idT]
print(qs[0]("q"))
const rs = [idT]
print(rs[0](4.25))
