// @run
// @log 4
// @log 42
// @log NUL
// A three-arm union's closure arm narrowed by its type alias (`v is F`) and then called. The
// call takes its signature from the narrowed read's own type, so the alias in the test, the
// third arm and the call together lower like the inline spelling. Each arm is exercised.
type F = (i32) => i32

function pick(k: i32): F | i32 | null {
  if k == 0 { return (x) => x + 1 }
  if k == 1 { return 42 }
  null
}

function reader(v: F | i32 | null) {
  if v is F { print(v(3)) }
  else if v is i32 { print(v) }
  else { print("NUL") }
}

reader(pick(0))
reader(pick(1))
reader(pick(2))
