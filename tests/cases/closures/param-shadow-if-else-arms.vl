// @run

// D2325 — a closure-typed PARAMETER shadowed independently in the `then` AND `else` arms of
// an `if`, by different `const`s of the same name. Neither arm's shadow leaks into the
// other, and reading the param again after the `if` sees the param.

function f(g: () => i32, flag: boolean) {
  let out = ""
  if flag {
    const g = () => "then"
    out = "\{g()}"
  } else {
    const g = () => "else"
    out = "\{g()}"
  }
  out = out + "|" + "\{g()}"
  out
}
print(f(() => 9, true))
// @log then|9
print(f(() => 9, false))
// @log else|9
