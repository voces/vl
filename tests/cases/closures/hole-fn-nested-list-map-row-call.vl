// @run
// @log 6
// @log 6
// @log 1
// @log 6
// `.map` and `.filter` over a nested list of an un-annotated function, the callback calling the
// row's element, run at the top level and inside a function (D9712). The last case, a loop over
// the same list, is a control that ran before.
function inc0(a) { return a + 1 }
const v0 = [[inc0]]
print(v0.map((r) => r[0](5))[0])

function inc1(a) { return a + 1 }
function dbl1(a) { return a * 2 }
function go1() {
  const v = [[inc1], [dbl1, inc1]]
  print(v.map((r) => r[0](3))[1])
  print(v.filter((r) => r.length == 2).length)
}
go1()

function inc2(a) { return a + 1 }
const v2 = [[inc2]]
for r in v2 { print(r[0](5)) }
