// @emit-error a generic function taken as a value reaches no call that fixes its type
// A record field read delivered to an annotated function binding would call the stub at a
// signature it lacks, so the un-annotated record is refused (D4125).
function inner<U>(u: U) { print(u) }
const r = { f: inner }
const j: (u: i32) => void = r.f
j(3)
