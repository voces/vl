// @error-at 8:2 operator '+' is not defined for boolean and i32
// A call through a list element re-asks every generic written to the list at the call's
// argument types, as a call through a written `let` does (D4010).
function inner<U>(u: U) { print("I"); print(u) }
function plus<V>(v: V) { print(v + 1) }
function main() {
  const fs = [inner]
  fs[0] = plus
  fs[0](true)
}
main()
