// @run
// @log 7
// @log s
// @log 8
// @log 3
// @log 7
// @log s
// @log 8
// @log 3
// @log 7
// @log s
// @log 8
// @log 3
// An alias of a capturing hole lambda, called first at another type, put into an annotated list
// or record literal runs with the binding's own signature (D3934). Also two aliases deep.
type R = { f: (n: i32) => void }
function inList<T>(x: T, y: T) {
  let v = x
  const h = (u) => {
    print(v); print(u)
  }
  h("s")
  const k = h
  const fs: ((n: i32) => void)[] = [k]
  v = y
  fs[0](3)
}
function inRecord<T>(x: T, y: T) {
  let v = x
  const h = (u) => {
    print(v); print(u)
  }
  h("s")
  const k = h
  const r: R = { f: k }
  v = y
  r.f(3)
}
function twoDeep<T>(x: T, y: T) {
  let v = x
  const h = (u) => {
    print(v); print(u)
  }
  h("s")
  const k = h
  const k2 = k
  const fs: ((n: i32) => void)[] = [k2]
  v = y
  fs[0](3)
}
inList(7, 8)
inRecord(7, 8)
twoDeep(7, 8)
