// @run
// @log 5
// @log 2.5
// @log 7
// @log 4.25
// A function returning a `const` copy of a module-scope bundle holder hands the record back
// whole, as returning the holder does (D15747).
function lap(f) {
  f(2.5)
  f(3)
  return f
}
const c = lap((a) => a + 1)
function g() {
  const v = c
  return v
}
const w = g()
print(w(4))
print(w(1.5))

function lap2(f) {
  f(1.5)
  f(2)
  return f
}
const d = lap2((a) => a * 2 + 1)
function h() {
  const u = d
  return u
}
print(h()(3))
print(h()(1.625))
