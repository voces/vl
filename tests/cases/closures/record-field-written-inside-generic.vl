// @run
// @log A
// @log true
// @log 1
// @log A
// @log true
// @log s
// A record field written with a generic inside a generic function's body takes the type its
// calls give in each instance (D4241).
function gA<U>(u: U) {
  print("A")
  print(u)
}
function gC<W>(w: W) {
  print("C")
  print(w)
}
function main<Q>(q: Q) {
  const y = { h: gC }
  y.h = gA
  y.h(true)
  print(q)
}
main(1)
main("s")
