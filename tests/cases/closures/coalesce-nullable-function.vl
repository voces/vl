// @run
// @log 3
// @log 20
// @log 5
// @log false
// @log 7
// @log 12
// `??` over a nullable function value: a parameter, called inline or bound first, with a lambda
// or a named function default, a record field written back, and a captured list's element read
// inside a closure (D3170, D3245, D4341).
type R = { v: i32, f: (() => i32) | null }
function inc(q: i32): i32 { q + 1 }
function f1(v: ((q: i32) => i32) | null): i32 {
  return (v ?? ((q: i32) => q + 1))(2)
}
function f2(v: ((q: i32) => i32) | null): i32 {
  const g = v ?? inc
  return g(4)
}
function F(z: R) {
  z.f = z.f ?? (() => 5)
  print(z.f == null)
}
function cap() {
  const e: (((n: i32) => i32) | null)[] = [null]
  const k = () => (e[0] ?? inc)(6)
  print(k())
  e[0] = (n: i32) => n * 2
  print(k())
}
print(f1(null))
print(f1((q: i32) => q * 10))
print(f2(null))
const r: R = { v: 1, f: null }
F(r)
cap()
