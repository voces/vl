// @run
// @info `b` is never reassigned; use `const` instead of `let`
// @log x
// @log 4
// @log dup
// @log x
// @log dup
// @log 4
// An unassigned `let` copy of a type-parameter parameter, called at another type than the parameter, is the parameter's value, as a `const` copy is (D15120).
function id<T>(x: T): T { x }
function dup<T>(x: T): T {
  print("dup")
  x
}
function one<F>(a: F) {
  let b = a
  print(a("x"))
  print(b(3) + 1)
}
one(id)
one(dup)
