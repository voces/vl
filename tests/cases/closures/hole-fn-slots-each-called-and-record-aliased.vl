// @run
// @log 30
// @log 31
// @log 3
// @log 4
// @log 2
// @log 3
// @log 4
// Each element of a list of hole functions called through its own literal index, and a record
// field called through a `const` alias of the record, each handed a generic at two types (D6880).
function add(a, b) { return a + b }
function apply2(g) {
  print(g(1, 2))
  print(g(1.5, 2.5))
}
function apply3(g) {
  print(g(10, 20))
  print(g(10.5, 20.5))
}
const fs = [apply2, apply3]
fs[1](add)
fs[0](add)
print(fs.length)
const rs = { k: apply2 }
const t = rs
t.k(add)
