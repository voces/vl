// @run
// @log 1.5
// @log 1.5
// @log 6
// @log ss
// @log 2.5
// @log 2
// @log 1.5
// @log 1.25
// A record literal's list field of generics written a generic of another result type: the field
// widens over its writes as a list binding does, so the element called through the field, a
// copy of the record, or a record a function returns runs the written function (D15166).
function id<T>(x: T): T { return x }
function half<T>(x: T): f64 { return x / 2.0 }
function twice<T>(x: T): T { return x + x }
function mk() {
  const r = { fs: [id] }
  r.fs[0] = half
  return r
}
const v = mk()
print(v.fs[0](3))
print(mk().fs[0](3))
const t = { fs: [id] }
t.fs[0] = twice
print(t.fs[0](3))
print(t.fs[0]("s"))
const c = { fs: [id], n: 2 }
c.fs[0] = half
for f in c.fs { print(f(5)) }
print(c.n)
const w = { fs: [id] }
w.fs[0] = half
const q = w
print(q.fs[0](3))
print(w.fs[0](2.5))
