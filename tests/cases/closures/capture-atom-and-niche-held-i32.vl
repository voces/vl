// @run
// @log b
// @log none
// @log a
// @log yes
// @log unset
// A closure captures a literal-union atom, a `K | null` and a `boolean | null` as the i32 each
// is held in, and reads back the member, the null and the flag.
type K = "a" | "b"

function pick(k: K) {
  const f = () => k
  return f()
}

function orNone(k: K | null) {
  const f = () => k ?? "none"
  return f()
}

function flag(v: boolean | null) {
  const f = () => if v == null { "unset" } else if v { "yes" } else { "no" }
  return f()
}

print(pick("b"))
print(orNone(null))
print(orNone("a"))
print(flag(true))
print(flag(null))
