// @run
// @log 5
// @log 5
// A bound list of an un-annotated function delivered at a wider `readonly` view takes a converting
// copy, so its function is called at the view's result (D16996's neighbour).
function half(a) { return a + 2 }
function run(m: readonly ((a: i32) => f64)[]) { print(m[0](3)) }
const m = [half]
run(m)
run([half])
