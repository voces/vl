// @run
// @log 4
// @log 4
// @log 1.25
// A record holding one function, beside records sharing it handed to un-annotated parameters at
// two types: with no `if` join there is one function per record, and every call runs (D15809).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function take(r) { return r.f(3) }
function take2(n, r) { return r.f(n) }
const p = { f: inc0 }
print(take(p))
print(take2(3, { f: inc0 }))
print(take2(2.5, { f: half }))
