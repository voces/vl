// @error cannot write a lambda to an element of 'fs': a call through it at (i32, i32) runs it, and it is (i32, string) => i32
// A lambda that annotates every parameter, written where a generic is held, is judged like the
// named function it could have been: a call at a type it cannot take is refused (D10120, D12217).
function pick<A, B>(a: A, _b: B): A { a }
const fs = [pick]
fs[0] = (x: i32, _y: string) => x
print(fs[0](1, 2))
