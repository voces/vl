// @run
// @log I
// @log 1
// @log O
// @log 2
// @log I
// @log s
// @log O
// @log t
// A capture cell in a generic body, called at `T` by one closure and written with a generic by another, is built at each instance's type (D3939, D3957, `rv3498/u13`).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function run<T>(x: T, y: T) {
  let k = inner
  const rd = (t: T) => {
    k(t)
  }
  const flip = () => {
    k = other
  }
  rd(x)
  flip()
  rd(y)
}
run(1, 2)
run("s", "t")
