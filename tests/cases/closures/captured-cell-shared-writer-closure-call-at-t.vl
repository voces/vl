// @emit-error is written with a generic function inside a closure that every instance of the enclosing generic function shares
// A capture cell in a generic body is refused, not built at one instance's type, when a closure calling the cell at `T` beside a shared writer
// wants it at two function types (D3939, `rv3498/u13`).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function run<T>(x: T, y: T) {
  let k = inner
  const rd = (t: T) => {
    k(t)
  }
  const flip = () => {
    k = other
  }
  rd(x)
  flip()
  rd(y)
}
run(1, 2)
run("s", "t")
