// @run
// @warning Unused variable `g` (prefix with `_` to suppress, or remove it)
// @log 1.5
// A function written into a record's list field through a parameter is also the writer's result,
// held and never called (D16230).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function put(o) { o.xs[0] = half }
const r = { xs: [inc0] }
const g = put(r)
print(r.xs[0](3))
