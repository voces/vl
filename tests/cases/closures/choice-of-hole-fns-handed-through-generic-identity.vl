// @run
// @hint Intentionally-unused parameter `_a` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_n` (leading `_` marks it unused)
// @log s
// @log s
// @log s
// @log s
// @log s
// @log s
// @log 6
// @log 8
// @log 4
// @log 5
// @log 5
// @log 5
// @log 5
// @log 6
// @log 4
// @log 5
// A choice of un-annotated functions called through an open parameter, handed through a generic
// that hands its argument back to a closed function type, is delivered there (D17097).
function inc(a) { return a + 1 }
function str(_a) { return "s" }
function dbl(a) { return a * 2 }
function ap(g, x) { return g(x) }
function id<T>(t: T): T { return t }
function fst<T>(t: T, _n: i32): T { return t }
function id2<T>(t: T): T {
  const u = t
  return u
}
function useK(k: (a: i32) => i32 | string) { print(k(4)) }
function useI(k: (a: i32) => i32) { print(k(4)) }
function run(c: boolean) {
  const g = if c { str } else { inc }
  print(ap(g, 3))
  useK(id(g))
  useK(id(id(g)))
  useK(fst(g, 1))
  useK(id2(g))
  const k: (a: i32) => i32 | string = id(g)
  print(k(5))
  const h = if c { dbl } else { inc }
  print(ap(h, 3))
  useI(id(h))
}
run(true)
run(false)
