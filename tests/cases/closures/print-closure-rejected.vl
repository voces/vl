// @check
// @error print expects one scalar or string value (i32 | i64 | f32 | f64 | boolean | string), got (i32) => i32 — print the elements or fields individually, e.g. `print(xs[0])`
// CONTRACT (must-error): the same DOMAIN rejection for a FUNCTION VALUE — a named-function
// binding, a lambda, and `((i32) => i32) | null` all reached the unguarded
// `call __print_i32__` arm. This is the cell that most clearly makes the refusal a design
// rule rather than a lowering gap: at runtime a function value is a table index plus a
// captured environment, so there is no rendering to emit even in principle — any output
// would be an invented token (`[Function]`) or a lie about identity.
function id(x: i32): i32 { x }
const g: (i32) => i32 = id
print(g)
