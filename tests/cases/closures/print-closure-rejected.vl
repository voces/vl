// @check
// @error print of (i32) -> i32 is type-valid but not yet supported by codegen
// CONTRACT (must-error): the same admission for a FUNCTION VALUE — a named-function
// binding, a lambda, and `((i32) => i32) | null` all reached the unguarded
// `call __print_i32__` arm.
function id(x: i32): i32 { x }
const g: (i32) => i32 = id
print(g)
