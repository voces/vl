// @run
// @log 4
// @log 0.5
// @log 7
// @log 1
// A relay of a maker returning a hole lambda, delivered at `(a: i32) => i32` and at
// `(a: i32) => f64`, is built per delivered result, as the maker is: each twin's lambda returns its
// twin's result (D16770).
function deliver() { return (a) => a + 1 }
function relay() { return deliver() }
const v: (a: i32) => i32 = relay()
const w: (a: i32) => f64 = relay()
print(v(3))
print(w(3) / 8.0)
function use(p: (a: i32) => i32, q: (a: i32) => f64) {
  print(p(6))
  print(q(7) / 8.0)
}
use(relay(), relay())
