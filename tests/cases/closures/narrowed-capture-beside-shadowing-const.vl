// @run
// @log 5
// @log 2
// @warning `c` shadows the `c` declared at 10:11 in this function; rename one if they are different values
// A closure reading a narrowed field keeps its narrowing when an inner block declares
// a same-name `const`: the inner binding is a different declaration, not a call of `c`.
type O = { v: string | null }
function shadowed(o: O) {
  if o.v != null {
    const c = (): i32 => o.v.length
    if o.v.length < 100 {
      const c = 5
      print(c)
    }
    return c()
  }
  0
}
print(shadowed({ v: "ab" }))
