// @run
// @log 6
// @log 20
// @log 4
// @log 1.75
// @log 6
// @log 1.75
// @log 0.5
// @log 12
// @log 5
// @log 6
// @log 1.75
// @log 24
// @log 10.5
// A re-pointed `let` handed to a parameter called at another un-annotated parameter runs when
// its functions agree at the type each outer call gives that parameter (D9009).
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function half(a) { return a / 2.0 }
function w(h, x) { return h(x) }
let f = inc0
f = dbl
print(w(f, 3))
print(w(f, 10))
// Two call sites, each with its own function: each call is its own copy.
print(w(inc0, 3))
print(w(half, 3.5))
// An annotated parameter.
function wa(h: (a: i32) => i32, x) { return h(x) }
print(wa(f, 3))
// Functions that differ at i32 agree at the only type the outer call gives.
function inc1(a) { return a + 1 }
let g = inc1
g = half
print(w(g, 3.5))
print(w(g, 1.0))
// Three arguments, and the parameter handed on to a second function.
function add0(a, b) { return a + b }
function mul0(a, b) { return a * b }
function w3(h, x, y) { return h(x, y) }
let m = add0
m = mul0
print(w3(m, 3, 4))
function add1(a, b) { return a + b }
function addh(a, b) { return a + b / 2.0 }
let n = add1
n = addh
print(w3(n, 3.0, 4.0))
function v(k, y) { return k(y) }
function wv(h, x) { return v(h, x) }
print(wv(f, 3))
print(wv(g, 3.5))
function v3(k, p, q) { return k(p, q) }
function wv3(h, x, y) { return v3(h, x, y) + v3(h, y, x) }
print(wv3(m, 3, 4))
print(wv3(n, 3.0, 4.0))
