// @run
// @log 4
// @log 5
// D9571: with a declared record type of the same field name that no value is built at, an
// empty list a bound record of an un-annotated function is pushed onto is not typed at the
// declared row, whose f64 result the function does not give.
type R = { f: (a: i32) => f64 }
function inc0(a) { return a + 1 }
const p = []
p.push({ f: inc0 })
print(p[0].f(3))
const q = { f: inc0 }
const p2 = []
p2.push(q)
print(p2[0].f(4))
