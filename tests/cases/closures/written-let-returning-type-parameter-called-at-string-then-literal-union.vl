// @run
// @log p
// @log z
// A generic that returns its type parameter, called through a written `let` with a string literal
// union and with a `string`, hands each call back its own type (D4244, D3975).
function idg<T>(t: T): T { return t }
type S = "p" | "q"
const a: S = "p"
const s: string = "z"
let x = idg
x = idg
const r2 = x(s)
const r1 = x(a)
print(r1)
print(r2)
