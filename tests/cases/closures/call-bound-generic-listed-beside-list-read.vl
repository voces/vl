// @run
// @log mk
// @log 12
// @log 5
// @log 5
// @log true
// @log mk
// @log 12
// @log 12
// A list of a call-bound generic and a generic read out of another list, both called at their
// own types beside direct calls of the call-bound `const`, calls each element at its own
// instance; the generic named directly is the control (D9652).
function id<T>(x: T): T { x }
function mk() {
  print("mk")
  return id
}
function mk2() { return id }
const xs = [id]
const v = xs[0]
const c = mk()
const ys = [c, v]
const s = ys[0]("abc")
print(s.length + ys[1](2) + c(1) + c("ab").length + c(4))
const zs = [id, v]
const t = zs[0]("abc")
print(t.length + zs[1](2))
const w = v
const ws = [id, w]
const r = ws[0]("abc")
print(r.length + ws[1](2))
print(xs[0](true))
function run() {
  const as = [id]
  const a = as[0]
  const d = mk()
  const bs = [d, a]
  const q = bs[0]("abc")
  print(q.length + bs[1](2) + d(1) + d("ab").length + d(4))
}
run()
const e = mk2()
const fs = [e, id]
const p = fs[0]("abc")
print(p.length + fs[1](2) + e(1) + e("ab").length + e(4))
