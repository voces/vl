// @emit-error emitProgram: an assignment used as a value whose type is not its target's has no value lowering
// A write used as a value into a captured never-filled `let x = null` whose right side is a call
// keeps the hole's type and is refused, not built as an invalid module; the `null` literal's
// spelling runs (D17221). It must stay loud until D17223, its uncaptured family, is closed.
function same<T>(v: T): T {
  return v
}
function f() {
  let x = null
  const g = () => x
  print(x = same(null))
  print(g())
}
f()
