// @emit-error emitProgram: the compiler cannot yet lower this statement (assignment value built apart from its store)
// A write used as a value into a captured never-filled `let x = null` whose right side is a call
// keeps the hole's type and is refused, not built as an invalid module; the `null` literal's
// spelling runs (D17221), and so does this write uncaptured (D17223); until the captured one is
// lowered it must stay loud.
function same<T>(v: T): T { return v }
function f() {
  let x = null
  const g = () => x
  print(x = same(null))
  print(g())
}
f()
