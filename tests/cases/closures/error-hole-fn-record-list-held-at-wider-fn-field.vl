// @error a `{f: (_) => _}[]` cannot be used as `{f: (i32) => i32 | null}[]` here
// A held list of records whose field holds an un-annotated function is refused at a wider
// function field type, as a held record is: each function would need an adapter, which is a
// copy (D15895). The literal list delivered directly adapts each element.
function inc0(a) { return a + 1 }
const xs = [{ f: inc0 }]
const rs: { f: (a: i32) => i32 | null }[] = xs
print(rs[0].f(3) ?? 0)
