// @emit-error ref valtype with no interned shape
// Two records whose list fields hold different sets of functions, listed together, are refused
// at emit as two such lists are; the build is not attempted at one of the records' types
// (D15195).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const r = { xs: [inc0] }
r.xs[0] = half
const q = { xs: [inc0] }
const rs = [r, q]
print(rs[0].xs[0](3))
print(rs[1].xs[0](3))
