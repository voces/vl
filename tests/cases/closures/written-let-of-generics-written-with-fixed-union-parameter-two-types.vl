// @run
// @log W
// @log 5
// @log true
// @log W
// @log x
// @log 2
// @log S
// @log 6
// @log false
// A written `let` given a generic with a fixed union parameter and called at two types: each
// slot adapts the write at its own call type, and a later write of the other generic fills both
// (D4892).
function s<A, B>(a: A, b: B) {
  print("S")
  print(a)
  print(b)
}
function w<B>(a: i32 | string, b: B) {
  print("W")
  print(a)
  print(b)
}
function main() {
  let k = s
  k = w
  k(5, true)
  k("x", 2)
  k = s
  k(6, false)
}
main()
