// @run
// @log 9
// @log 3.5
// @log 3.5
// @log 9.5
// A record of un-annotated functions joined by an `if` and handed to an un-annotated parameter
// is called through an alias of that parameter as through the parameter itself (D15920).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function dbl(a) { return a * 2 }
function two() { [1, 2].length }
function viaConst(a) {
  const v = a
  print(v.f(3) + v.f(4))
}
function viaChain(a) {
  const v = a
  const w = v
  print(w.f(3) + v.f(4))
}
function viaTwo(a) {
  const v = a
  print(v.f(3) + v.g(4))
}
const r = if two() > 5 { { f: half } } else { { f: inc0 } }
viaConst(r)
const h = if two() < 5 { { f: half } } else { { f: inc0 } }
viaChain(h)
const h2 = if two() < 5 { { f: half } } else { { f: inc0 } }
viaConst(h2)
const k = if two() < 5 { { f: half, g: dbl } } else { { f: inc0, g: inc0 } }
viaTwo(k)
