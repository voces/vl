// @run
// @log 3
// @log 1
// @log 30
// @log 0.75
// D10700's loop at module scope, its value argument a literal.
function add(a, b) { return a + b }
function apply2(g, s) {
  print(g(1, 2))
  print(g(s, s))
}
function apply3(g, s) {
  print(g(10, 20))
  print(g(s, 0.25))
}
for f in [apply2, apply3] { f(add, 0.5) }
