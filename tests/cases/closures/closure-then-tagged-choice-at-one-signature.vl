// @run
// @log s
// @log s
// @hint Intentionally-unused parameter `_a`
// @hint Intentionally-unused parameter `_a`
// The other call order of D17863: a closure at a tagged choice's signature, then the choice.
function bo(_a) { return true }
function str(_a) { return "s" }
function ap(g, x) { return g(x) }
function flag() { return 1 > 0 }
const g = if flag() { str } else { bo }
const w: (a: i32) => string | boolean = g
print(ap(w, 4))
print(ap(g, 3))
