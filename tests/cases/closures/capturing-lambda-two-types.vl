// @run
// @log 7
// @log 7
// @log 43
// @log 43
// @log 100
// @log 100
// @log 100
// @hint Intentionally-unused parameter `_v` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_v` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_v` (leading `_` marks it unused)
// D971 — A CAPTURING LAMBDA CALLED AT MORE THAN ONE ARGUMENT TYPE.
//
// The monomorphizer refused this, on the grounds that a second-type call "can be neither a
// `call_ref` through it (wrong functype) nor a by-name call (drops the env)". The `call_ref`
// half is right and is why the rename to a by-name call exists at all. The by-name half was
// FALSE: a lifted capturing instance takes the env as its LEADING `structref` param, and
// `emitDirectCall` already pushes it. The refusal described a convention the emitter does not
// use, and removing it was the whole fix.
//
// TWO CAPTURES ARE HERE ON PURPOSE. A single capture of 7 cannot tell a correctly-read env
// from a zeroed one; `a + b == 43` can.
function twoTypes() {
  const n = 7
  const f = (_v) => {
    return n
  }
  print(f(1))
  print(f("s"))
}
twoTypes()

function twoCaptures() {
  const a = 3
  const b = 40
  const g = (_v) => {
    return a + b
  }
  print(g(1))
  print(g("s"))
}
twoCaptures()

// THREE distinct instantiation types, so the fix is not a two-instance special case.
function threeTypes() {
  const n = 100
  const h = (_v) => {
    return n
  }
  print(h(1))
  print(h("s"))
  print(h(true))
}
threeTypes()
