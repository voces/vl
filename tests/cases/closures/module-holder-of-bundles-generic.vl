// @run
// The holder called through inside a generic function at two instances (D17111).
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
const m = Map()
m["a"] = lap((a) => a + 1)
const x = m["a"]
function gen<T>(t: T): T {
  if x != null { print(x(4)) }
  return t
}
print(gen(1))
print(gen("s"))
// @log 5
// @log 1
// @log 5
// @log s
// @hint Intentionally-unused variable `_a`
// @hint Intentionally-unused variable `_b`
