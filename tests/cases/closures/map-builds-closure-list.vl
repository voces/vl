// @run
// @log 9
// @log 2
// @log 23
// @log 9
// @log 9
// @log 9
// @log 8
// @log 5
// @log b!
// @log 90
// @log 1
// @log 9
// @hint Intentionally-unused parameter `_k`
// A `.map` whose callback builds a function gives a list of functions that nothing else in the
// program spells, so the `.map` itself interns its element row; no annotation or list literal of
// these function types may appear here, or the fixture cannot see the defect (D9231).
function inc(y: i32) { return y + 1 }

function mk(xs: i32[]) { return xs.map((k) => (y: i32): i32 => y + k) }

function use(gs) { return gs[1](7) }

function main() {
  const xs = [1, 2]
  const gs = xs.map((k) => (y: i32): i32 => y + k)
  print(gs[1](7))
  print(gs.length)
  let t = 0
  for g in gs { t = t + g(10) }
  print(t)
  print(mk([1, 2])[1](7))
  print(use(xs.map((k) => (y: i32): i32 => y + k)))
  const g1 = gs[1]
  print(g1(7))
  print(xs.map((_k) => inc)[0](7))
  const ds = [1.5, 2.5]
  print(ds.map((k) => (y: f64): f64 => y * k)[1](2.0))
  const ss = ["a", "b"]
  print(ss.map((s) => (): string => s + "!")[1]())
  const hs = gs.map((g) => (y: i32): i32 => g(y) * 10)
  print(hs[1](7))
  const fs = gs.filter((g) => g(0) > 1)
  print(fs.length)
  print(fs[0](7))
}
main()
