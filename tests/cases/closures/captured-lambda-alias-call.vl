// @run
// @log 1
// @log t
// @log s
// @log s
// @log 3
// @log r!
// @log u
// @log v
// @log w!
// A call through a `const` alias of an un-annotated lambda, made from a function nested in
// the frame holding the alias: the call is re-spelled to the lambda and instantiated at its
// own argument, as the same call in the alias's frame is (D3825).
type A = { v: i32 }

// The reviewed witness: a hole function instantiated at two types.
function mk(x) {
  const c = (y) => y
  const d = c
  const f = () => d(x)
  return f()
}
print(mk(1))
print(mk("t"))

// A concrete frame, from an arrow and from a nested named function.
function mkS(x: string) {
  const c = (y) => y
  const d = c
  const f = () => d(x)
  function g() { d(x) }
  print(f())
  g()
}
print(mkS("s"))

// A record argument, a returned closure, and a lambda with a capture of its own.
function mkA(x: A) {
  const c = (y) => y
  const d = c
  const f = () => d(x)
  f().v
}
print(mkA({ v: 3 }))
function mkR(x: string) {
  const c = (y) => y
  const d = c
  () => d(x) + "!"
}
print(mkR("r")())

// An alias of the alias, one frame further in.
function mkC(x: string) {
  const c = (y) => y
  const d = c
  const f = () => {
    const e = d
    const g = () => e(x)
    g()
  }
  f()
}
print(mkC("u"))
function mkK(x: string, k: string) {
  const c = (y) => y + k
  const d = c
  const f = () => d(x)
  f()
}
print(mkK("v", ""))
print(mkK("w", "!"))
