// @run
// @log 2
// @log 11
// @log s
// @log 11
// @log 5
// @log s
// @log 3
// @log n
// @log 8
// An un-annotated list literal whose element is a value union with a function arm keys its
// element as the union's box, as the annotated `(F | string)[]` does, so `is` finds the arm
// and a narrowed element can be called (D4347). Two function arms, and a nullable third.

function mk(n: i32): ((x: i32) => i32) | string {
  if n == 0 { return "s" }
  return (x: i32) => x + n
}
function mk2(n: i32): (() => i32) | ((x: i32) => i32) {
  if n == 0 { return () => 5 }
  return (x: i32) => x + n
}
function mk3(n: i32): ((x: i32) => i32) | string | null {
  if n == 0 { return null }
  if n == 1 { return "s" }
  return (x: i32) => x + n
}

const xs = [mk(1)]
if xs[0] is (x: i32) => i32 { print(2) } else { print(9) }
xs.push(mk(0))
for y in xs {
  if y is string { print(y) } else { print(y(10)) }
}
const ys = [mk2(1), mk2(0)]
for y in ys {
  if y is () => i32 { print(y()) } else { print(y(10)) }
}
const zs = [mk3(1), mk3(2), mk3(0)]
for z in zs {
  if z is string { print(z) }
  else if z == null { print("n") }
  else { print(z(1)) }
}
const ns = [[mk(4)]]
const e = ns[0][0]
if e is string { print(e) } else { print(e(4)) }
