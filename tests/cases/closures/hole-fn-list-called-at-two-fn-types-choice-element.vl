// @run
// @warning Unused parameter
// @log x2
// @log y20
// @log 2
// @log 20
// @log 3
// @log 30
// D10701 with an element that is a choice of functions.
import { toString } from "std:fmt"

function cat(a, b) { return a + b.toString() }
function snd(a, b) { return b }
function apply2(g) { print(g("x", 2)) }
function apply3(g) { print(g("y", 20)) }
const k = 1 > 0
const fs = [apply2, if k { apply3 } else { apply2 }]
for f in fs { f(cat) }
for f in fs { f(snd) }
for f in fs { f((a, b) => b * 1.5) }
