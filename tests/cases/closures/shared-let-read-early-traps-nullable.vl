// @trap
// A closure that reads a shared `let` of a type that admits `null`, with no initializer, before its first write
// traps and names the binding (D2340).
type P = { x: i32 }
function go() {
  let u: P | null
  const g = () => if u == null { 0 } else { u.x }
  print(g())
  u = { x: 7 }
}
go()
