// @run
// @log 4
// @log 3.5
// @log 2
// @log 4
// @log 5
// @log 0
// A nested list of a set handed to an un-annotated parameter whose length the body reads holds
// member ids: a length read hands on no element, so it leaves the set whole (D14781).
function inc4(a) { return a + 1 }
function take4(v) {
  if v.length == 2 {
    print(v[0][1](3))
    print(v[1][0](2.5))
    return
  }
  print(0)
}
take4([[inc4, inc4], [inc4]])

function inc5(a) { return a + 1 }
function dbl5(a) { return a * 2 }
function take5(v) {
  print(v.length)
  print(v[0][0](3))
  print(v[1][0](2.5))
}
take5([[inc5, dbl5], [dbl5]])

function inc6(a) { return a + 1 }
function take6(v) {
  if v.length > 5 { print(v[0][0](1)) }
  print(0)
}
take6([[inc6]])
