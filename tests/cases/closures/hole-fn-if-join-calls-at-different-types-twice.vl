// @run
// @log 3
// @log 4
// @log 3
// @log 4
// The D7842 witness: a `const` joining two hole functions by `if`, whose bodies call the handed
// hole function at different sets of types, called twice.
function add(a, b) { return a + b }
function apply2(g) {
  print(g(1, 2))
  print(g(1.5, 2.5))
}
function apply3(g) {
  print(g(10, 20))
  print(g(0.5, 0.25))
}
function main(c: boolean) {
  const f = if c { apply2 } else { apply3 }
  f(add)
  f(add)
}
main(true)
