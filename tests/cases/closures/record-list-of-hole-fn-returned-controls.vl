// @run
// Controls beside D15900: a variable index at top level, an un-annotated binding of the one call,
// a constant index, and a function called twice whose returned literal keeps the joined result.
function id(a) { return a }
const xs = [{ f: id }]
function deliverA() { return [{ f: id }] }
const va: { f: (a: f64) => f64 }[] = deliverA()
let k = 0
const n: i32 = xs[k].f(2)
print(n + xs[k].f(2.5) + va[0].f(2.5))
const ys = [{ f: id }]
function deliverB() { return [{ f: id }] }
const vb = deliverB()
let j = 0
print(ys[j].f(2))
print(ys[j].f(2.5))
const zs = [{ f: id }]
function deliverC() { return [{ f: id }] }
const vc: { f: (a: f64) => f64 }[] = deliverC()
print(zs[0].f(2) + zs[0].f(2.5) + vc[0].f(2.5))
function deliverD() { return [{ f: id }] }
const u = deliverD()
const w = deliverD()
let i = 0
const m: i32 = u[i].f(2)
print(m + u[i].f(2.5) + w[0].f(2))
// @log 7
// @log 2
// @log 2.5
// @log 7
// @log 6.5
