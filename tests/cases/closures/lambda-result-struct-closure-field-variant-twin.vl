// @run
// @log 082
// A lambda returning a record whose closure field returns a union sharing the record's field
// set `{f}`: the outer literal builds at its own row, not at the union's `{f: string}` arm, and
// the closure's result reads back through the arm it does land on (D12463).
function go() {
  const v: () => {f: () => {f: string} | string} = () => ({ f: () => ({ f: "082" }) })
  const r = v().f()
  if r is string { print(r) } else { print(r.f) }
}
go()
