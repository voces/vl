// @run
// @log a
// @log 4
// @log 2.5
// @log 4
// Lambda members seeded through a `const` into a captured written `let`, in a generic body at two
// instances, build as the `let`-seeded spelling does (D15434).
function mk<T>(x: T, n: i32) {
  const g = (y) => y
  const h = (y) => y + y
  let d1 = g
  function w1() { d1 = d1 }
  let d3 = h
  d3 = d1
  print(d1(x))
  print(d3(n))
}
mk("a", 4)
mk(2.5, 4)
