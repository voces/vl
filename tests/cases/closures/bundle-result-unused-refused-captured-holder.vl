// Such a result stored in a function's map and read back into a holder a lambda captures: refused
// at the call (D17585).
// @emit-error emitProgram: a function returning a parameter called at two signatures is called where its result is not used at one of them
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
function inFn() {
  const k = Map()
  k["a"] = lap((a) => a + 1)
  const g = k["a"]
  const seen = () => g != null
  print(seen())
}
inFn()
