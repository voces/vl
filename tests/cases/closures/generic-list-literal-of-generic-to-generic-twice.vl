// @run
// @log 5
// @log 6
// A list literal holding only a generic function, passed straight to a generic function whose
// result is its type parameter, twice at one type, runs (D10204).
function id<T>(x: T): T { x }
function run<U>(a: ((x: U) => U)[], u: U): U { a[0](u) }
print(run([id], 5))
print(run([id], 6))
