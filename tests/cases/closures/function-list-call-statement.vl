// @run
// @log a
// @log b
// @log 11
// @log 12
// @log g:a
// @log g:b
// @log c:a
// @log c:b
// @log 13
// @log s!
// @log 4
// @log 8
// @log 14
// @log 22
// @log none
// @log 101
// @log 5
// @log 5
// @log 40961
// @log miss
// @log 1721
// @log 1
// @log 1
// @log 9
// @log 1
// @log 1
// @log 9
// @hint redundant type annotation: `fs` is inferred as `(() => void)[]`
// @hint redundant type annotation: `ps` is inferred as `((string) => void)[]`
// @hint redundant type annotation: `vs` is inferred as `((i32) => i32)[]`
// @hint redundant type annotation: `slots` is inferred as `(((i32) => i32) | null)[]`
// @hint redundant type annotation: `vslots` is inferred as `((() => void) | null)[]`
// @hint redundant type annotation: `table` is inferred as `((i32) => i32)[]`
// @hint redundant type annotation: `cb` is inferred as `(i32) => void`
// @hint redundant type annotation: `es` is inferred as `((i32) => i32)[]`
// @hint redundant type annotation: `ls` is inferred as `((i32) => i32)[]`
// D2110/D2111/D2112: a list of function values iterated and called for effect. A `for f in fs`
// loop variable calls through its iterable's element signature, so a void element leaves nothing
// to drop; a valued element called for effect through an index drops its result; and a
// `(F | null)[]` loop variable keeps its null for the body to test.

function a(): void { print("a") }
function b(): void { print("b") }

// The witness: module scope, then a function frame, then a loop var bound to a copy.
const fs: (() => void)[] = [a, b]
for f in fs { f() }

function inc1(x: i32): void { print(x + 1) }
function inc2(x: i32): void { print(x + 2) }
function run(hs: ((i32) => void)[]): void {
  for h in hs { h(10) }
}
run([inc1, inc2])

function viaCopy(): void {
  const gs = [
    (): void => {
      print("g:a")
    },
    (): void => {
      print("g:b")
    },
  ]
  for g in gs {
    const h = g
    h()
  }
}
viaCopy()

// A loop var captured by a closure that calls it later.
function later(): void {
  const out: (() => void)[] = []
  const tags = ["c:a", "c:b"]
  const ps: ((string) => void)[] = [
    (t: string): void => {
      print(t)
    },
  ]
  for t in tags {
    for p in ps {
      out.push((): void => {
        p(t)
      })
    }
  }
  for o in out { o() }
}
later()

// A generic instance: the loop var's signature is the pin's, not the generic's.
function each<T>(ks: ((T) => void)[], x: T): void {
  for k in ks { k(x) }
}
each([inc2], 11)
each(
  [
    (s: string): void => {
      print(s + "!")
    },
  ],
  "s",
)

// A valued element called for effect, through an index and a computed index.
function loud(x: i32) {
  print(x)
  return x
}
const vs: ((i32) => i32)[] = [loud, loud]
vs[0](4)
const k = 1
vs[k](8)

// A function-valued map walked by key and value.
const byAddr: {[i32]: (i32) => void} = Map()
byAddr[12] = inc2
byAddr[20] = inc2
for addr, fn in byAddr { fn(addr) }

// A nullable element keeps its null for the body to test.
function hundred(x: i32) { return x + 100 }
const slots: (((i32) => i32) | null)[] = [null, hundred]
for s in slots {
  if s != null { print(s(1)) } else { print("none") }
}
const vslots: ((() => void) | null)[] = [
  null,
  (): void => {
    print(5)
  },
  null,
  (): void => {
    print(5)
  },
]
for s in vslots {
  if s != null { s() }
}

// A dispatch table in a hot loop, and a sparse address-to-handler map.
function op0(x: i32) { return x + 1 }
function op1(x: i32) { return x ^ 0x5a }
function op2(x: i32) { return (x * 3) & 0xffff }
function op3(x: i32) { return x - 7 }
const table: ((i32) => i32)[] = [op0, op1, op2, op3]
let acc = 1
for i in 0 to 999999 { acc = table[i & 3](acc) }
print(acc)

let trace = 0
function f401000(x: i32): void { trace = trace * 10 + (x & 1) }
function f401020(x: i32): void { trace = trace * 10 + (x & 2) }
function f402000(x: i32): void { trace = trace * 10 + x }
const guest: {[i32]: (i32) => void} = Map()
guest[0x401000] = f401000
guest[0x401020] = f401020
guest[0x402000] = f402000
for pc in [0x401000, 0x402000, 0x401020, 0x401000, 0x999] {
  const h = guest[pc]
  if h != null { h(7) } else { print("miss") }
}
print(trace)

// A closed loop's name means the outer binding again: `cb(9)` after the loop calls the
// module `cb` at its own signature, not the element's.
function one(x: i32): void { print(x) }
function echo(x: i32) {
  print(x)
  return x
}
const cb: (i32) => void = one
const es: ((i32) => i32)[] = [echo]
for cb in es { print(cb(1)) }
cb(9)
function afterLoop(): void {
  const ls: ((i32) => i32)[] = [echo]
  for cb in ls { print(cb(1)) }
  cb(9)
}
afterLoop()
