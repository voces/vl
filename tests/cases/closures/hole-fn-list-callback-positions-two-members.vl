// @run
// @log 7
// @log 10
// @log 7
// @log 10
// @log 7
// @log 10
// @log 7
// @log 7
// A list of two un-annotated functions mapped through an annotated callback held in a `const`,
// returned by a function or read from a record field: each element is built at the callback's
// parameter type and called there (D14438).
function inc2(a) { return a + 2 }
function dbl(a) { return a * 2 }
const v = [inc2, dbl]
const k = (r: (a: i32) => i32) => r(5)
const a = v.map(k)
print(a[0])
print(a[1])
function mk(): (r: (a: i32) => i32) => i32 {
  return (r: (a: i32) => i32) => r(5)
}
const b = v.map(mk())
print(b[0])
print(b[1])
const o = { k: (r: (a: i32) => i32) => r(5) }
const c = v.map(o.k)
print(c[0])
print(c[1])
const one = [inc2]
print(one.map(mk())[0])
print(one.map(o.k)[0])
