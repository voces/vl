// @run
// @log true
// A hole function no call instances, handed to a parameter the callee compares with itself: the
// comparison reads the declaration's identity and calls nothing, so no defaulted signature is
// observed (D4551, D7180). The callee that only prints, or holds the value unread, runs:
// `uncalled-hole-fn-to-unread-param.vl` (D6881).
function apply3(g) { print(g(1, 2)) }
function run(f) { print(f == f) }
run(apply3)
