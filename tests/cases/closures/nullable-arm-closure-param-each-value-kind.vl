// @run
// @log 3
// @log 5
// @log -1
// @log 9
// @log -1
// @log 3
// @log 5
// A function value whose parameter is a nullable union arm takes, through a closure call, a value
// narrowed out of a wider box, an object literal, a null, and a nullable list element.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function run(
  rd: (Circle | null) => i32,
  zz: (Circle | null | string)[],
  z: (Circle | null)[],
) {
  const e = zz[0]
  if !(e is string) { print(rd(e)) }
  print(rd({ r: 5 }))
  print(rd(null))
  print(rd(z[0]))
  print(rd(z[1]))
  const o: { g: (Circle | null) => i32 } = { g: rd }
  const d = zz[0]
  if !(d is string) { print(o.g(d)) }
  print(o.g({ r: 5 }))
}
const rd = (w: Circle | null): i32 => if w == null { 0 - 1 } else { w.r }
run(rd, [{ r: 3 }, null, "x"], [{ r: 9 }, null])
