// @run
// @log L
// @log 3
// @log O
// @log true
// A lambda written into a `let` a generic initialized, read into a list beside another instance
// of the generic, gives the list's slot the one type its call makes (D7103).
function other<V>(v: V) { print("O"); print(v) }
function main() {
  let k = other
  k = (n) => {
    print("L"); print(n)
  }
  const fs = [k]
  fs[0](3)
  other(true)
}
main()
