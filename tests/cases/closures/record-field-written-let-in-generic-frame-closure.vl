// @run
// @log 5
// @log t
// @log 5
// @log t
// @log true
// @log 5
// @log t
// A record field holding a written `let` of a generic, called through the field from a closure
// inside a generic function: the closure reads at the instance enclosing it, through a nested
// closure, and through a lambda handed to another generic (D5112).
function k<T>(x: T): T { return x }
function apply<A>(f: () => A): A { return f() }
function use<U>(u: U): U {
  let g = k
  g = k
  const r = { q: g }
  const f = () => r.q(u)
  return f()
}
function nested<U>(u: U): U {
  let g = k
  g = k
  const r = { q: g }
  const f = (v: U) => {
    const z = () => r.q(v)
    return z()
  }
  return f(u)
}
function handed<U>(u: U): U {
  let g = k
  g = k
  const r = { q: g }
  return apply(() => r.q(u))
}
print(use(5))
print(use("t"))
print(nested(5))
print(nested("t"))
print(nested(true))
print(handed(5))
print(handed("t"))
