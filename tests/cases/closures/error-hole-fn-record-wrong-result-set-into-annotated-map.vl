// @error cannot assign {f: (_) => _} to R
// An un-annotated function of i32 result inside a record literal set into a map whose record
// type's field returns f64 is refused, as `const r: R = { f: inc0 }` is (D9471).
type R = { f: (a: i32) => f64 }
function inc0(a) { return a + 1 }
const m: Map<string, R> = Map()
m.set("a", { f: inc0 })
const x = m.get("a")
if x != null { print(x.f(3)) }
