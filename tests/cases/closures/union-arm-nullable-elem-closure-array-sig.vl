// @run
// @log 7
// A union whose ARM is a NULLABLE-ELEMENT closure array (`(((i32) => i32) | null)[] | i32`),
// with no lambda anywhere — the value is only ever the scalar arm. The arm's element still
// rides the shared closure fat-pointer, so the narrowed indexed call (`u[0]`, then `e(2)`
// after the `!= null` narrow) `ref.cast`s to the ELEMENT's `$fnsig`, and `collectCloSigs`
// has to intern it from the arm's type.
//
// The pin: that element is read by `cloArrElemFuncTyOf`, which peels the element's `| null`
// before asking for a function type; the plain-element sibling
// (`closure-array-union-arm-field-nolambda.vl`) pins the other arm.
function go() {
  const u: (((i32) => i32) | null)[] | i32 = 7
  if u is (((i32) => i32) | null)[] {
    const e = u[0]
    if e != null { print(e(2)) } else { print(1) }
  } else {
    print(u)
  }
}

go()
