// @run
// @log 7
// A union whose ARM is a NULLABLE-ELEMENT closure array (`(((i32) => i32) | null)[] | i32`),
// with no lambda anywhere — the value is only ever the scalar arm. The arm's element still
// rides the shared closure fat-pointer, so the narrowed indexed call (`u[0]`, then `e(2)`
// after the `!= null` narrow) `ref.cast`s to the ELEMENT's `$fnsig`, and `collectCloSigs`
// has to intern it from the arm's spelling.
//
// The pin: reaching that element name is `cloArrElemNameOf`, the ONE HOME of an idiom six
// call sites used to carry by hand (`nullClosureArrElem` first, then `nameIsClosureArray`'s
// `[]` peel). Deleting its NULLABLE-element arm — one edit, in one function — turns this
// program into "function-value call arity has no interned signature"; the plain-element
// sibling (`closure-array-union-arm-field-nolambda.vl`) pins the other arm.
function go() {
  const u: (((i32) => i32) | null)[] | i32 = 7
  if u is (((i32) => i32) | null)[] {
    const e = u[0]
    if e != null { print(e(2)) } else { print(1) }
  } else {
    print(u)
  }
}

go()
