// @run
// @log 5
// A top-level choice between un-annotated functions, delivered to a parameter whose result is a
// wider union, holds one type and is called through an adapter at that signature.
function inc(a) { return a + 1 }
function dec(a) { return a - 1 }
function useK(k: (a: i32) => i32 | string) { print(k(4)) }
const c = 1 < 2
const top = if c { inc } else { dec }
useK(top)
