// A capturing lambda a hole parameter calls at two or more signatures is handed as one value
// holding a closure per signature (D14841): in a function, in a block at module scope, at three
// signatures, with two parameters, returning nothing, with its results computed with, and in each
// instance of a generic, capturing a value of its type parameter. A same-shaped record written by
// hand, and a declared twin of it, keep their own fields.
type B = { c0: (n: i32) => i32, c1: (n: f64) => f64 }
function lapFn(f) {
  print(f(3))
  print(f(2.5))
}
function lapTop(f) {
  print(f(3))
  print(f(2.5))
}
function lap3(f) {
  print(f(3))
  print(f(2.5))
  print(f("s"))
}
function lap2(f) {
  print(f(1, 2))
  print(f(0.5, 0.25))
}
function lapVoid(f) {
  f(4)
  f("v")
}
function lapMath(f) {
  print(f(3) + 1)
  print(f(2.5) * 2.0)
}
function useRec(r) {
  print(r.c0(10))
  print(r.c1(0.5))
}
function useB(r: B) {
  print(r.c0(20))
  print(r.c1(1.5))
}
function lapGen(f) {
  print(f(3))
  print(f(2.5))
}
function lapT(f) {
  print(f(3))
  print(f(2.5))
}
function inFn(k: i32) { lapFn((a) => a + k) }
function inGen<T>(k: T, d: i32) {
  lapGen((a) => a + d)
  print(k)
}
function capT<T>(k: T) {
  lapT((a) => {
    print(k)
    return a
  })
}
function three(k: i32) {
  lap3((a) => {
    print(k)
    return a + a
  })
}
function two(k: i32) { lap2((a, b) => a + b + k) }
function noValue(k: i32) {
  lapVoid((a) => {
    print(a)
    print(k)
  })
}
function math(k: i32) { lapMath((a) => a + k) }
inFn(1)
if true {
  const z = 3
  lapTop((a) => a * z)
}
three(9)
two(1)
noValue(5)
math(1)
inGen(7, 1)
inGen("g", 2)
capT(7)
capT("g")
const u = { c0: (n: i32) => n + 1, c1: (n: f64) => n + 1.0 }
useRec(u)
const nb: B = { c0: (n: i32) => n * 2, c1: (n: f64) => n * 2.0 }
useB(nb)
useRec(nb)
