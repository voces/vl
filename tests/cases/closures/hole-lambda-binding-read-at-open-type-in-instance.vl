// @run
// @info `u` is never reassigned; use `const` instead of `let`
// @hint Intentionally-unused parameter `_n`
// @log 3.5
// @log 3.5
// @log 6
// @log 4
// @log S
// @log 3
// @log S
// @log s
// @log 5
// @log 2
// @log u
// @log 2
// A binding of a hole lambda, or of a list of un-annotated functions, read where its type is still
// open in an instance: returned, put in a record or a list, read through an element, or bound in
// two instances sharing one local. Each runs at its instance's types.
function adder(n) {
  const f = (a) => a + n
  return f
}
function gadder<T>(n: T) {
  const f = (a) => a + n
  return f
}
function inc0(a) { return a + 1 }
function dbl0(a) { return a * 2 }
function nested(_n) {
  let u = [[inc0], [dbl0]]
  return u
}
function takeNested(a) { print(a[1][0](3)) }
function flat(_n) {
  let u = [inc0, dbl0]
  return u
}
function takeFlat(a) { print(a[0](3)) }
function inList<T>(x: T) {
  let k = (n) => {
    print("R")
    print(n)
  }
  k = (n) => {
    print("S")
    print(n)
  }
  const fs = [k]
  fs[0](x)
}
function inRecord<T>(x: T) {
  let k = (n) => {
    print(n)
    return 1
  }
  k = (n) => {
    print(n)
    return 2
  }
  const o = { f: k }
  print(o.f(x))
}
const x = adder(1.5)
print(x(2.0))
const g = gadder(1.5)
print(g(2.0))
takeNested(nested(1))
takeFlat(flat(1))
inList(3)
inList("s")
inRecord(5)
inRecord("u")
