// @run
// @info `ws` is never reassigned; use `const` instead of `let`
// @info `us` is never reassigned; use `const` instead of `let`
// @log 7
// @log w
// @log 3
// @log 3
// @log 9
// @log ab
// A `let` list of a generic, pushed the same generic and never assigned whole, calls the pushed
// element at each type it is called at, as the `const` list does; so does a loop over it and a
// list pushed from a nested function (D10300).
function id<T>(x: T): T { x }
let ws = [id]
ws.push(id)
print(ws[1](7))
print(ws[1]("w"))
for w in ws { print(w(3)) }
let us = [id]
function more() { us.push(id) }
more()
print(us[1](9))
print(us[1]("ab"))
