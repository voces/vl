// @run
// @log L
// @log 1
// @log O
// @log true
// A cell seeded with a hole lambda and called at `i32` and then at `boolean`, which share a
// representation, holds one closure per call type (D3950, D3975).
function other<V>(v: V) { print("O"); print(v) }
function main() {
  let k = (x) => {
    print("L"); print(x)
  }
  const flip = () => {
    k = other
  }
  k(1)
  flip()
  k(true)
}
main()
