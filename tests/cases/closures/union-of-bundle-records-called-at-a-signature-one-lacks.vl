// @run
// @log 3.5
// @log 4
// @log 2.5
// @log 3
// @hint Intentionally-unused variable `_a`
// @hint Intentionally-unused variable `_b`
// @hint Intentionally-unused variable `_a`
// @hint Intentionally-unused variable `_b`
// A map holding two makers' bundle records, read and called at a signature one record has no
// member for, joins that signature to the record's bundle: its lambda is built there too (D17727).
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
function lap2(f) {
  const _a = f(true)
  const _b = f(3)
  return f
}
const m = Map()
m["a"] = lap((a) => a + 1)
m["b"] = lap2((a) => a)
const g = m["a"]
if g != null {
  print(g(2.5))
  print(g(3))
}
const h = m["b"]
if h != null {
  print(h(2.5))
  print(h(3))
}
