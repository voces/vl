// @run
// @log 1
// @log 2
// @log 3
// @log 4
// @log 5
// @log 6
// @log 7
// @log 8
// @log 9
// @log 10
// @log 11
// @log 12
// @log 13
// @hint redundant type annotation: `readInside` is inferred as `i32`

// A function value whose result is a record nesting another record twice over ten levels, at
// each place a function value is called: the call's function type and the receiver of the read
// after it name `A10`'s own row, not the shallower row its long spelling matches (D9784). `A9`
// through `viaParam9` is the control at nine levels and `mk(12)` the control without a
// function value. The record-field position is its own fixture, since declaring a record with
// a field of type `F` let every position here run before the fix.

type A0 = {x: i32}
type A1 = {l: A0, r: A0}
type A2 = {l: A1, r: A1}
type A3 = {l: A2, r: A2}
type A4 = {l: A3, r: A3}
type A5 = {l: A4, r: A4}
type A6 = {l: A5, r: A5}
type A7 = {l: A6, r: A6}
type A8 = {l: A7, r: A7}
type A9 = {l: A8, r: A8}
type A10 = {l: A9, r: A9}

function mk(x: i32): A10 {
  const a0 = { x: x }
  const a1 = { l: a0, r: a0 }
  const a2 = { l: a1, r: a1 }
  const a3 = { l: a2, r: a2 }
  const a4 = { l: a3, r: a3 }
  const a5 = { l: a4, r: a4 }
  const a6 = { l: a5, r: a5 }
  const a7 = { l: a6, r: a6 }
  const a8 = { l: a7, r: a7 }
  const a9 = { l: a8, r: a8 }
  return { l: a9, r: a9 }
}

function mk9(x: i32): A9 { mk(x).r }

type F = (x: i32) => A10

function viaParam(f: F, n: i32): A10 { f(n) }
function readInside(f: F, n: i32): i32 { f(n).l.l.l.l.l.l.l.l.l.l.x }
function viaList(fs: F[], n: i32): A10 { fs[0](n) }
function viaNullable(f: F | null, n: i32): A10 {
  if f != null { return f(n) }
  mk(0)
}
function viaUnion(f: F | string, n: i32): A10 {
  if f is string { return mk(0) }
  f(n)
}
function factory(): F { mk }
function viaParam9(f: (x: i32) => A9, n: i32): A9 { f(n) }

print(viaParam(mk, 1).l.l.l.l.l.l.l.l.l.l.x)
print(readInside(mk, 2))
print(viaParam((x: i32) => mk(x), 3).r.l.l.l.l.l.l.l.l.r.x)
print(viaParam((x) => mk(x), 4).l.l.l.l.l.l.l.l.l.l.x)
const bound: F = mk
print(bound(5).l.l.l.l.l.l.l.l.l.l.x)
const fromFactory = factory()(6)
print(fromFactory.l.l.l.l.l.l.l.l.l.l.x)
const fs: F[] = [mk]
const fromList = fs[0](7)
print(fromList.r.r.r.r.r.r.r.r.r.r.x)
print(viaList([mk], 8).l.l.l.l.l.l.l.l.l.l.x)
const m: {[string]: F} = Map()
m["a"] = mk
const fm = m["a"]
if fm != null { print(fm(9).l.l.l.l.l.l.l.l.l.l.x) }
print(viaNullable(mk, 10).l.l.l.l.l.l.l.l.l.l.x)
print(viaUnion(mk, 11).l.l.l.l.l.l.l.l.l.l.x)
print(mk(12).l.l.l.l.l.l.l.l.l.l.x)
print(viaParam9(mk9, 13).l.l.l.l.l.l.l.l.l.x)
