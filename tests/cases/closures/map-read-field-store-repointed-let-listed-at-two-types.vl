// @run
// @log 4
// A map storing a record field's generic, read into a re-pointed `let` handed in list literals at
// two types: every read of the map is rewritten, so its slot is called through nothing (D10400).
function id<T>(x: T): T { x }
function run<U>(a: ((x: U) => U)[], u: U): U { a[0](u) }
const w0 = { f: id }
const m = Map()
m["k"] = w0.f
const r = m["k"]
if r != null {
  let w = r
  w = r
  print(run([w], 2) + run([w], "ab").length)
}
