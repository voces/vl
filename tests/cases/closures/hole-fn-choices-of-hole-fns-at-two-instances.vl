// @run
// @log a
// @log 1
// @log aa
// @log 2
// One hole parameter handed two different if-choices of hole functions, at two instances: each
// member is instanced only through the choice's arms.
function both(f) {
  print(f("a"))
  print(f(1))
}
function inner(s) { return s }
function ask(s) { return s }
function twice(s) { return s + s }
function a1(c: boolean) { both(if c { inner } else { ask }) }
function a2(c: boolean) { both(if c { twice } else { inner }) }
a1(false)
a2(true)
