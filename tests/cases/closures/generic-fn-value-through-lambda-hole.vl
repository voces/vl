// @run
// @log x
// @log 3
// @log q
// @log 41
// A generic handed to a `const`-bound lambda's un-annotated parameter is instanced at the
// lambda's own call of it, once per call (D5403).
function same<T>(k: T): T { k }
const t = (a) => print(a("x"))
t(same)
const u = (a, b) => print(a(b))
u(same, 3)
u(same, "q")
const ap = (f) => f(41)
print(ap(same))
