// @run
// @log x
// @log y
// A closure capturing a binding held as the atom reads it at a string at an annotated `let`: the
// captured atom, decoded (capture binding shape 3, Q58 position sweep).
const A = "x"
const B = "y"
function main(c: boolean) {
  const M = if c { A } else { B }
  const f = () => {
    const s: string = M
    return s
  }
  print(f())
}
main(true)
main(false)
