// @run
// @log 4
// @log 4
// @log 4
// An inline list of un-annotated functions as a record field, returned from a function or a
// lambda rather than bound by a `const`, takes its element's pin (D9254).
function inc0(a) { return a + 1 }
function mk() { return { xs: [inc0] } }
const v = mk()
print(v.xs[0](3))
const mk2 = () => {
  return { xs: [inc0] }
}
const v2 = mk2()
print(v2.xs[0](3))
function use() {
  const w = mk()
  print(w.xs[0](3))
}
use()
