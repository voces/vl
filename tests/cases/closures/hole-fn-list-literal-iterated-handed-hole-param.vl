// @run
// @log 3
// A one-element list literal of a function, iterated inside a hole function and handed that
// function's own parameter, is a holder there, so the element's set is tagged (D15068).
function add(a, b) { return a + b }
function apply2(g) { print(g(1, 2)) }
function viaFor(h) {
  for f in [apply2] { f(h) }
}
viaFor(add)
