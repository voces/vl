// @run
// @log a
// @log 1
// @log aa
// @log 2
// @log top
// A choice of capture-free functions nested in the caller, handed to a parameter the callee calls
// at two types, dispatches to the nested members even where a module function or another
// frame's nested function shares a member's name.
function both(f) {
  print(f("a"))
  print(f(1))
}
function inner(_s) { return "top" }
function one(c: boolean) {
  function inner(s) { return s }
  function ask(s) { return s }
  both(if c { inner } else { ask })
}
function two(c: boolean) {
  function inner(s) { return s + s }
  function ask(s) { return s }
  both(if c { inner } else { ask })
}
one(true)
two(true)
print(inner(0))
