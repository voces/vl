// @run
// @log 6
// @log 42
// @hint redundant type annotation: `go` is inferred as `i32`
// @hint redundant type annotation: `param` is inferred as `i32`
// THE OTHER BUG THE POSITIONAL FIX CLOSES, and it has nothing to do with memory.
//
// `isBuiltinFnName` was consulted in `capRecord` — at EVERY identifier, in every
// position — so a local that merely SHARES a builtin's spelling was silently
// dropped from the capture list and the closure had nothing to read. On master
// `go()` below failed to emit with
// `identifier is not a parameter, local, or global`.
//
// A name denotes instructions only where it is being CALLED, so the exemption is
// now asked in CALLEE position alone (`capScan`'s `Call` arm). `toString` here is
// a value, so it is captured like any other local.
//
// The second half is the shape that must NOT regress: a PARAMETER named after a
// dunder intrinsic. #1167's intrinsic-name reservation covers `function` /
// `const` / `let` but NOT parameters, so this is legal VL today and worked on
// master — a name-list fix (adding the intrinsics to the exemption list without
// moving it into callee position) would have broken it.
function go(): i32 {
  const toString = 5
  const f = () => toString + 1
  f()
}
function param(__load_i32__: i32): i32 {
  const g = () => __load_i32__ + 1
  g()
}
print(go())
print(param(41))
