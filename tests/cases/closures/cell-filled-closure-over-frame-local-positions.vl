// @log 18
// @log hi!hi!
// @log 203
// @log 7
// @log 7
// A capturing nested function read as a value from a lambda too (so its value lives in a cell),
// capturing a binding of the frame that fills the cell.
// a while-loop local, pushed
function w1(n: i32) {
  const fs: ((x: i32) => i32)[] = []
  let i = 0
  while i < 2 {
    const k = i * 10
    function inner(x: i32) { return x + n + k }
    fs.push(inner)
    const get = () => inner
    print(get() === inner)
    i = i + 1
  }
  print(fs[0](1) + fs[1](1))
}
w1(1)
// a for-in loop variable
function w2() {
  for v in [5, 6] {
    function inner(x: i32) { return x * v }
    const get = () => inner
    const f = inner
    print(f(2) + get()(1))
  }
}
w2()
// an if-block local, bound to a let then called
function w3(flag: boolean) {
  if flag {
    const s = "hi"
    function inner() { return s + "!" }
    const get = () => inner
    let h = inner
    print(h() + get()())
  }
}
w3(true)
// a function-body local, passed as an argument
function apply(f: (x: i32) => i32, x: i32) { return f(x) }
function w4() {
  const base = 100
  function inner(x: i32) { return base + x }
  const get = () => inner
  print(apply(inner, 1) + apply(get(), 2))
}
w4()
// a local record, returned
function w5(): () => i32 {
  const r = { a: 7 }
  function inner() { return r.a }
  const get = () => inner
  print(get()())
  return inner
}
print(w5()())
