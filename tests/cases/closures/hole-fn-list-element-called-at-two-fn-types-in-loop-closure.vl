// @run
// @warning Unused parameter `a`
// @log x2
// @log 2
// @log y20
// @log 20
// @log x2
// @log y20
// @log 2
// @log 20
// The D12705 witness and an escaping closure: a call through the loop variable inside a
// closure in the loop reads the copy at the index the closure captures.
import { toString } from "std:fmt"

function cat(a, b) { return a + b.toString() }
function snd(a, b) { return b }
function apply2(g) { print(g("x", 2)) }
function apply3(g) { print(g("y", 20)) }
const fs = [apply2, apply3]
for f in fs {
  const k = () => {
    f(snd)
  }
  f(cat)
  k()
}
const ks: (() => void)[] = []
for f in fs {
  function k() { f(snd) }
  ks.push(k)
  f(cat)
}
for k in ks { k() }
