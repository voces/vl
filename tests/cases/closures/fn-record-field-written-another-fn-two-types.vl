// @run
// @log 2
// @log 2.5
// @log 3
// @log s
// @log 2
// @log 2.5
// A record field holding one un-annotated function and written another holds both, so a read of
// it called at two types runs, through an alias and inside a function too (D15119).
function id0(a) { return a }
function id1(a) { return a }
function id2(a) { return a }
const r = { f: id1 }
r.f = id0
const g = r.f
print(g(2))
print(g(2.5))
function run() {
  const q = { f: id1, n: 1 }
  q.f = id0
  print(q.f(3))
  print(q.f("s"))
}
run()
const w = { f: id1 }
const al = w
al.f = id2
print(w.f(2))
print(w.f(2.5))
