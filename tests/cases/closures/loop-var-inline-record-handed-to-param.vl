// @run
// @log 4
// @log 14
// @log 26
// @log 4
// @log 3.5
// @log hi
// @log yo
// @log 1
// @log 4
// A `for` variable over a list of inline records handed to an un-annotated parameter pins the
// parameter at the record's shape (D9641), a function field, a nested record or a string alike.
function inc0(a: i32) { return a + 1 }
function inc1(a: i32) { return a + 1 }
function dbl1(a: i32) { return a * 2 }
function take(a) { print(a.f(3)) }
const xs0 = [{ f: inc0 }]
for x in xs0 { take(x) }
function takeN(a) { print(a.f(3) + a.n) }
const xs1 = [{ f: inc1, n: 10 }, { f: dbl1, n: 20 }]
for x in xs1 { takeN(x) }
function takeP(a) { print(a.n + 1) }
const xs2 = [{ n: 3 }]
for x in xs2 { takeP(x) }
function takeQ(a) { print(a.p.x + a.s) }
const xs3 = [{ p: { x: 1.5 }, s: 2.0 }]
for x in xs3 { takeQ(x) }
function takeS(a) { print(a.s) }
const xs4 = [{ s: "hi" }, { s: "yo" }]
for x in xs4 { takeS(x) }
const xs5 = [{ s: 1 }]
for y in xs5 { takeS(y) }
// Control: the element read by index.
function inc6(a: i32) { return a + 1 }
const xs6 = [{ f: inc6 }]
take(xs6[0])
