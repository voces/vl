// @error cannot choose 'inc' here: called at (i32) it returns i32, where 'str', also chosen here, returns string — every function a call through the choice may run must return one type
// A choice handed to an open parameter that a closed function type also reads keeps an untagged
// set, which the second check refuses (D16094).
function inc(a) { return a + 1 }
function str(_a) { return "s" }
function ap(g, x) { return g(x) }
function run(c: boolean) {
  const g = if c { str } else { inc }
  print(ap(g, 3))
  const k: (a: i32) => i32 | string = g
  print(k(4))
}
run(true)
