// @run
// @log 20
// @log 11
// @log 20
// @log 5
// @log 20
// @log 6
// @log 6
// @log 6
// @log 4
// @log 1.5
// Functions written to one `let` whose bodies give one result at each type the binding is
// called at run whichever the write left there (D9003's legal neighbours).
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function half(a) { return a / 2.0 }
let f = inc0
if [1, 2].length > 1 { f = dbl }
print(f(10))
let g = inc0
if [1].length > 1 { g = dbl }
print(g(10))
// Called at two types, where both agree at each.
let h = inc0
if [1, 2].length > 1 { h = dbl }
print(h(10))
print(h(2.5))
// A write in a loop's nested block.
let k = inc0
let i = 0
while i < 3 {
  if i == 1 { k = dbl }
  i = i + 1
}
{
  print(k(10))
}
// Delivered as an argument, returned, and handed to a generic.
function w(q: (a: i32) => i32) { return q(3) }
print(w(f))
function get() {
  let m = inc0
  if [1].length > 0 { m = dbl }
  return m
}
print(get()(3))
function ap<T, R>(k: (a: T) => R, x: T): R { return k(x) }
print(ap(f, 3))
// A parameter's functions are per call: each call of `p` instances its own.
function p(x) {
  let y = x
  if [1].length > 5 { y = x }
  return y(3)
}
print(p(inc0))
print(p(half))
