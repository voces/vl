// @run
// @log 3
// @log 4
// @log 7
// @log 3
// @log 4
// @log 8
// @log 3
// @log 4
// @log big
// A list of one hole function called at a computed index, the call read as a value: the read runs
// first as a statement of its own, for its index and its bounds check (D7385).
function add(a, b) { return a + b }
function apply2(g) {
  print(g(1, 2))
  print(g(1.5, 2.5))
  return 7
}
const fs = [apply2]
const i = fs.length - 1
print(fs[i](add))
function main() {
  const gs = [apply2]
  const j = gs.length - 1
  const v = gs[j](add)
  print(v + 1)
  if gs[j](add) > 6 { print("big") }
}
main()
