// @run
// @log 1.5
// @log 4
// @log 1.5
// @log 2
// @log 2.5
// @log 4
// @log 1.5
// A list literal of maps whose function values are a set and a smaller set within it decides the
// two sets together, so each map holds the wider set's ids and the list stores both (D15234).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const fnMap = Map()
fnMap.set("a", inc0)
fnMap.set("b", half)
const m2 = Map()
m2.set("a", half)
const xs = [fnMap, m2]
const g = xs[1].get("a")
if g != null { print(g(3)) }
for m in xs {
  const k = m.get("a")
  if k != null { print(k(3)) }
}
m2.set("b", half)
const b = xs[1].get("b")
if b != null { print(b(4)) }
const d = m2.get("a")
if d != null { print(d(5)) }
const m3 = Map()
m3.set("a", inc0)
const ys = [fnMap, m2, m3]
const e = ys[2].get("a")
if e != null { print(e(3)) }
function pick(i) { return [fnMap, m2][i] }
const p = pick(1).get("a")
if p != null { print(p(3)) }
