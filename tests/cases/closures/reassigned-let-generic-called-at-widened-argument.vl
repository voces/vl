// @run
// @log W
// @log 1
// @log true
// @log W
// @log 3
// @log s
// @warning Unused parameter `a`
// @warning Unused parameter `b`
// D4300: a `let` holding a generic and rewritten with a generic whose first parameter is a named
// record is called at the instance the written function has, both at an argument that fits by
// widening and at one that fits exactly.
type P = { x: i32 }
function s<A, B>(a: A, b: B) { print("S") }
function w<B>(a: P, b: B) { print("W"); print(a.x); print(b) }
function main() {
  let k = s
  k = w
  k({ x: 1, y: 2 }, true)
  k({ x: 3 }, "s")
}
main()
