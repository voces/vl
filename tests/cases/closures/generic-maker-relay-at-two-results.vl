// @run
// @log 41
// @log s
// @log 2.5
// @log 43
// @log t
// @log 7
// @log 2.5
// A relay of a generic maker delivered at several function types whose results differ is built
// per delivered result, as the maker is: each delivery reaches its own instance of the generic,
// as bindings, as arguments, and as an un-annotated `const` that is only called (D16755).
function k<T>(x: T): T { return x }
function mk() { return k }
const o = mk()
const of = o(2.5)
function deliver() { return mk() }
const v: (x: i32) => i32 = deliver()
const w: (x: string) => string = deliver()
const u: (x: f64) => f64 = deliver()
print(v(41))
print(w("s"))
print(u(2.5))
function use(f: (x: i32) => i32, g: (x: string) => string) {
  print(f(43))
  print(g("t"))
}
use(deliver(), deliver())
const z = deliver()
print(z(7))
print(of)
