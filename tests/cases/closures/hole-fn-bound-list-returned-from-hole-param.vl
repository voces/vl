// @run
// @log 4
// @log 4
// @log 6
// @log 3.5
// @log 4
// @log 6
// @log 4
// @log 6
// @log 6
// @log 6
// @log 3.5
// @log 4
// @log 4
// @log 6
// @log 4
// @log 5
// @log 4
// @log 4
// @log 6
// @log 4
// @info `u` is never reassigned; use `const` instead of `let`
// @hint Intentionally-unused parameter `_n`
// A list of un-annotated functions bound to a local and returned from a function with an
// un-annotated parameter runs, nested or flat, at one or two instances, wrapped at the return,
// and handed on to an un-annotated parameter; a list of a bound list runs too, at the top level or
// in the function, handed on or held in a record (D9600, D9660, D9661, D9662). The cases
// numbered 6, 7, 8 and 10 are controls that ran before.
function inc0(a) { return a + 1 }
function deliver0(_n) {
  const u = [[inc0]]
  return u
}
const v0 = deliver0(1)
print(v0[0][0](3))
print(deliver0(1)[0][0](3))

function inc1(a) { return a + 1 }
function deliver1(_n) {
  const u = [[inc1]]
  return u
}
const v1 = deliver1(1)
const w1 = deliver1("s")
print(v1[0][0](5))
print(w1[0][0](2.5))

function inc2(a) { return a + 1 }
function dbl2(a) { return a * 2 }
function deliver2(_n) {
  const u = [[inc2], [dbl2]]
  return u
}
function take2(a) { print(a[1][0](3)) }
const v2 = deliver2(1)
print(v2[0][0](3))
take2(deliver2(1))

function inc3(a) { return a + 1 }
function dbl3(a) { return a * 2 }
function deliver3(_n) {
  const w = [inc3, dbl3]
  return [w]
}
const v3 = deliver3(1)
print(v3[0][0](3))
print(v3[0][1](3))

function inc4(a) { return a + 1 }
function dbl4(a) { return a * 2 }
function deliver4(_n) {
  const w = [inc4, dbl4]
  return w
}
const v4 = deliver4(1)
const x4 = deliver4("s")
print(v4[1](3))
print(v4.map((f) => f(3))[1])
print(x4[0](2.5))

function inc5(a) { return a + 1 }
const w5 = [inc5]
const v5 = [w5]
print(v5[0][0](3))

function inc6(a) { return a + 1 }
function deliver6(_n) { return [[inc6]] }
print(deliver6(1)[0][0](3))

function inc7(a) { return a + 1 }
function dbl7(a) { return a * 2 }
function deliver7() {
  const w = [inc7, dbl7]
  return w
}
print(deliver7()[1](3))

function inc9(a) { return a + 1 }
function deliver9(_n) {
  let u = [[inc9]]
  return u
}
const v9 = deliver9(1)
print(v9[0][0](3))

function h10(u) { return u }
function guard10(v) {
  if v.length == 2 {
    const n = v[0](2)
    const s = v[1]("abc")
    print(s.length + n)
    return
  }
  print(0)
}
guard10([h10, h10])

function inc8(a) { return a + 1 }
const v8 = [[inc8]]
print(v8[0][0](3))

function inc11(a) { return a + 1 }
function deliver11(_n) {
  const w = [inc11]
  const u = [w]
  return u
}
print(deliver11(1)[0][0](3))

function inc12(a) { return a + 1 }
function dbl12(a) { return a * 2 }
const w12 = [inc12, dbl12]
const v12 = [w12]
function take12(a) { print(a[0][1](3)) }
take12(v12)
const x12 = { f: v12 }
print(x12.f[0][0](3))
