// @run
// @log O
// @log 1
// @log O
// @log 2
// @log O
// @log true
// @log O
// @log 3
// @info `c` is never reassigned; use `const` instead of `let`
// A call through an un-annotated alias of a written `let` calls what was last written to the
// `let`, whose seed and writes are instanced at the call's signature (D4156).
function inner<U>(u: U) {
  print("I")
  print(u)
}
function other<V>(v: V) {
  print("O")
  print(v)
}
let k = inner
k = other
const a = k
a(1)
const b = a
let c = b
c(2)
let lam = (x) => {
  print("L")
  print(x)
}
lam = other
const viaLam = lam
viaLam(true)
function main() {
  let m = inner
  m = other
  const h = m
  h(3)
}
main()
