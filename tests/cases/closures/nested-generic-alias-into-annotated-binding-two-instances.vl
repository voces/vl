// @run
// @log 7
// @log 2
// @log s
// @log 2
// @log true
// @log 2
// @log 7
// @log 3
// @log 7
// @log 4
// @log s
// @log 3
// @log s
// @log 4
// @info `h` is never reassigned; use `const` instead of `let`
// D3926: a capturing nested generic read through an alias into an annotated binding, in a
// generic instanced more than once, calls each instance's own copy with its own captures.
function outer<T>(x: T) {
  function inner<U>(u: U) { print(x); print(u) }
  const k = inner
  const k2 = k
  const h: (n: i32) => void = k2
  h(2)
}
function held<T>(x: T) {
  function inner<U>(u: U) { print(x); print(u) }
  const k = inner
  let h: (n: i32) => void = k
  const hs = [h]
  hs[0](3)
  h(4)
}
outer(7)
outer("s")
outer(true)
held(7)
held("s")
