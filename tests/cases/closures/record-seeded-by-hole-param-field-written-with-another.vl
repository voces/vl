// @run
// @log 3
// @log x
// A record literal a hole parameter initialises inside the function, its field written with a
// second parameter and called, while the first parameter is called directly at another type: the
// field's widened set holds the parameter's ids (D15455).
function go(a, b) {
  const r = { f: a }
  r.f = b
  print(r.f(3))
  print(a("x"))
}
function same<T>(k: T): T { k }
function dbl(x) { x }
go(same, dbl)
