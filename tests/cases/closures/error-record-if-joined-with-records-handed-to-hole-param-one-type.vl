// @emit-error this call runs a function value that may hold any of a set of functions returning different types
// A record `if` bound and called through, beside record literals sharing its functions handed to
// un-annotated parameters at one argument type: the literals put them at another signature, so
// the call through the handed records is refused at emit (D16220, D16878).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function two() { return [1, 2].length }
function take(r) { return r.f(3) }
function take2(n, r) { return r.f(n) }
const q = if two() > 5 { { f: half } } else { { f: inc0 } }
print(take(q))
print(take2(3, { f: inc0 }))
print(take2(3, { f: half }))
