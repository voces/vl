// @run
// @log 7
// @log 7
// @hint redundant type annotation: `n` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `twoSigs` is inferred as `f64` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// @hint redundant type annotation: `n` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `twoSigs2` is inferred as `f64` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// A list literal of records holding a function of a set called at two signatures elsewhere,
// handed straight to an un-annotated parameter: the hole is keyed and pinned at the set's id rows,
// and the literal is built at them (D15900).
function id(a) { return a }
const xs = [{ f: id }]
function twoSigs(k: i32): f64 {
  const n: i32 = xs[k].f(2)
  return n + xs[k].f(2.5)
}
function take(a) {
  const v = a
  print(twoSigs(0) + v[0].f(2.5))
}
take([{ f: id }])

function id2(a) { return a }
const ys = [{ g: id2 }]
function twoSigs2(k: i32): f64 {
  const n: i32 = ys[k].g(2)
  return n + ys[k].g(2.5)
}
function takeDirect(a) { print(twoSigs2(0) + a[0].g(2.5)) }
takeDirect([{ g: id2 }])
