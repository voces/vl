import { toString } from "std:fmt"

// A closure built in a global's initializer block over that block's own local: the start body
// builds the initializer, so the local is its frame's. Q58 sweep of the captured read: a scalar
// and a union argument, a nested argument, a concat operand, an interpolation hole, a return, a
// binding, an `if` arm, a `??` operand and a record field; and the closure itself as a global's
// value, an argument, an `if` arm and a record field.
function takeS(s: string) { return s.length }
function takeU(p: i32 | string) {
  return if p is string { p.length } else { p }
}
function id<T>(t: T): T { return t }
function use(f: (s: string) => string) { return f("u") }
const a = @B {
  const w = "q"
  const f = (s: string) => {
    print(takeS(w))
    print(takeU(w))
    print(takeS(id(w)))
    print(s + w)
    print("\{w}!")
    const k: string = w
    print(k)
    print(if s == "" { w } else { s })
    const n: string | null = if s == "" { null } else { w }
    print(n ?? "z")
    const r = { w: w }
    return r.w
  }
  f
}
print(a("x"))
print(
  use(
    @C {
      const w = "r"
      const f = (s: string) => s + w
      f
    },
  ),
)
const pick = if a("") == "q" {
  const w = 3
  const f = (s: string) => s + toString(w)
  f
} else {
  a
}
print(pick("p"))
const rec = {
  f: @D {
    const w = [1, 2]
    const f = (s: string) => s + toString(w.length)
    f
  },
}
print(rec.f("n"))
