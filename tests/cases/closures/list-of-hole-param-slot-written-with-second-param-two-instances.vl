// @log 1
// @log 5
// The same list taken at two instances, each binding both parameters to one generic (D15568).
function id<T>(x: T): T { x }
function use(ys) { print(ys.length) }
function take(a, b) {
  const xs = [a]
  xs[0] = b
  use(xs)
  print(xs[0]("abc").length + xs[0](2))
}
take(id, id)
take(id, id)
