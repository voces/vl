// @log s
// An `if` choosing hole functions, called in place and handed a function: as a statement, as a
// binding's and a call's value, through `else if`, at module scope and inside a generic (D7848).
function add(a, b) { return a + b }
function addI(a: i32, b: i32) { return a + b }
function apply2(g) { print(g(1, 2)) }
function apply3(g) { print(g(10, 20)) }
function ret2(g) { return g(1, 2) }
function ret3(g) { return g(10, 20) }
function main(c: boolean, d: boolean) {
  (if c { apply2 } else { apply3 })(addI)
  const r = (if c { ret2 } else { ret3 })(add)
  print(r)
  print((if c { ret2 } else { ret3 })(add))
  (if c { apply2 } else if d { apply3 } else { apply2 })(add)
}
function gen<T>(x: T, c: boolean) {
  (if c { apply2 } else { apply3 })(add)
  print(x)
}
main(true, false)
main(false, true)
(if 1 > 0 { apply2 } else { apply3 })(add)
gen("s", false)
