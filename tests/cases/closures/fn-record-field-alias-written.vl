// @run
// @info `ts` is never reassigned; use `const` instead of `let`
// @log 1.5
// @log 6
// @log 6
// @log 1.5
// @log 4
// @log 10
// @log 1.5
// @log 4
// @log 6
// A record literal's list field written or pushed through a `const` or once-bound `let` alias of
// the field: the write is the field's own, so a call through the field, or through the alias
// and then the field, runs the written function (D15165).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function dbl(a) { return a * 2 }
function inner() {
  const r = { xs: [inc0] }
  const ys = r.xs
  ys[0] = half
  return r.xs[0](3)
}
const r = { xs: [inc0] }
const ys = r.xs
ys[0] = half
print(r.xs[0](3))
const q = { xs: [inc0] }
const qs = q.xs
qs[0] = dbl
print(qs[0](3))
print(q.xs[0](3))
const p = { xs: [inc0] }
const ps = p.xs
ps.push(half)
print(p.xs[1](3))
print(p.xs[0](3))
const t = { xs: [inc0] }
let ts = t.xs
ts[0] = dbl
for f in t.xs { print(f(5)) }
print(inner())
const w = { xs: [inc0], zs: [inc0] }
const wz = w.zs
wz[0] = dbl
print(w.xs[0](3))
print(w.zs[0](3))
