// @run
// @log tt
// @log uu
// @log 4
// @log 6
// @log ss
// @log xx
// @log ss
// A choice of generics held in a list or a record inside a generic body dispatches at each
// instance's own tuple (D14429, D14431).
function idg<T>(t: T): T { return t }
function kg<T>(t: T): T { return t + t }
const c = [1].length > 0
const k = if c { 1 } else { 2 }
function f<T>(s: T) { print({ h: if c { kg } else { idg } }.h(s)) }
f("t")
function g<S>(s: S) {
  print(
    {
      h: match k {
        1 => kg
        _ => idg
      },
    }.h(s),
  )
}
g("u")
g(2)
function listedAtV<T>(v: T): T {
  const fs = [if c { kg } else { idg }]
  print(fs[0](v))
  return v
}
function field<T>(v: T): T {
  const r = { h: if c { kg } else { idg } }
  print(r.h("s"))
  return v
}
listedAtV(3)
field(1)
listedAtV("x")
field(true)
