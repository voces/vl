// @error called value is not a function (((string) => string) | ((string) => i32))
// The annotated spelling of D13740: the choice is a union of two function types, and a call
// through it is refused.
function only(n, f) { return f(n) }
function twice(s: string) { return s + s }
function lenOf(s: string) { return s.length }
const k = [1].length > 1
print(only("abc", if k { twice } else { lenOf }))
