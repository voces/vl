// @run
// @log true
// @log false
// @log null
// @log 4
// @log 2
// @log 11
// @log null
// @log null
// @log 4
// A list of joins of a tagged set's member and `null` holds each as the nullable id: a null
// element reads back as null, and a call through a member element after it runs (D17854).
function inc(a) { return a + 1 }
function two() { return [1, 2].length }
const xs = [
  if two() > 5 { inc } else { null },
  if two() > 1 { inc } else { null },
]
print(xs[0] == null)
print(xs[1] == null)
const f0 = xs[0]
if f0 != null { print(f0(1)) } else { print("null") }
const f1 = xs[1]
if f1 != null { print(f1(3)) } else { print("null") }
print(xs.length)
const ys = [
  if two() > 1 { inc } else { null },
  if two() > 5 { inc } else { null },
]
for y in ys {
  if y != null { print(y(10)) } else { print("null") }
}
function call(g) {
  if g != null { print(g(3)) } else { print("null") }
}
call(xs[0])
call(xs[1])
