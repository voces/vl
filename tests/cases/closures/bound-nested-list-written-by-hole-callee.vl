// @run
// @log 0.5
// @log 0.5
// @log 0.5
// @log 0.5
// A bound list's own inner list, written by an un-annotated callee, takes the callee's element at
// scope close, as a record field's list does (D16427, D16425).
function t(a) { a[0].push(0.5); print(a[0][0]) }
const l = [[]]
t(l)
function t2(a) { a[0][0].push(0.5); print(a[0][0][0]) }
const m = [[[]]]
t2(m)
function t3(a) {
  a.push({ ys: [] })
  a[0].ys.push(0.5)
  print(a[0].ys[0])
}
const r = [{ ys: [] }]
t3(r)
const k = [[]]
t(k)
