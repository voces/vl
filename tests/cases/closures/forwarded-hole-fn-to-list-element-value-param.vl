// @run
// @log 1
// @log 0.75
// @log 1
// @log 3
// @log 2
// @log 1
// @log 4
// @log 2.25
// @log 1
// @log 7
// A hole function forwarded to the elements of a list literal, each calling it at one key that
// names the element's own value parameter, is taken at the type that parameter is handed: from a
// hole parameter, from a literal, at two outer calls, through a reassigned binding, and from a
// generic caller (D13102).
function add(a, b) { return a + b }
function mul(a, b) { return a * b }
function same(g, s) { print(g(s, s)) }
function quarter(g, s) { print(g(s, 0.25)) }
function inner(k, h) {
  for f in [same, quarter] { f(h, k) }
}
inner(0.5, add)

function lit(h) {
  for f in [same] { f(h, 0.5) }
}
lit(add)

function twoCalls(g, s) {
  print(g(1, 2))
  print(g(s, 1.5))
}
function once(k, h) {
  for f in [twoCalls] { f(h, k) }
}
once(0.5, add)

function each(k, h) {
  for f in [same] { f(h, k) }
}
each(0.5, add)
each(2, add)

function swap(k, h) {
  let hh = h
  hh = mul
  for f in [same] { f(hh, k) }
}
swap(1.5, add)

function run<T>(x: T, h) {
  each(0.5, h)
  print(x)
}
run(7, add)
