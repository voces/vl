// @run
// @log 0
// @log 0
// @hint Intentionally-unused variable
// A function type's parameter list is a list type the module has to declare, even where the
// program builds no such list: `k.length` reads the wrapper, and a bare `null` argument is
// that wrapper's null. The whole annotation is one type name, so its parameters are forced
// by name, as its result always was (D2399).
const byValue: (u8[] | null) => i32 = (k) => {
  if k != null { return k.length }
  0
}
print(byValue(null))
const _lenOf: (f64[]) => i32 = (k) => k.length
print(0)
