// @run
// @warning Unused parameter `a`
// @log 2
// @log 9
// @log 9
// @log 2
// @log 5
// @log 15
// A closed function handed through a list to a hole lambda a closed function pushed onto it,
// capturing its parameter, builds the lambda at the type the elaboration gives it (D15582).
function snd(a: string, b: i32) { return b }
function apply2(g) { print(g("x", 2)) }
const fs = [apply2]
function add(k: i32) {
  fs.push((g) => { print(g("z", k)) })
}
add(9)
for f in fs { f(snd) }
fs[1](snd)

function inc(n: i32): i32 { return n + 1 }
function apply1(g) { print(g(1)) }
const gs = [apply1]
function more(k: i32) {
  gs.push((g) => { print(g(k)) })
  gs.push((h) => { print(h(k + 10)) })
}
more(4)
for g in gs { g(inc) }
