// @run
// @log 2
// @log 5
// @log s
// @log 3
// @log 3
// A literal of generics a call returns, bound at an annotated type, is instanced at that type:
// at two bindings of one annotation, at a string type, and inside a function (D4575).
function id<T>(x: T): T { x }
function d() { return [id] }
const v: ((x: i32) => i32)[] = d()
print(v[0](2))
const u: ((x: i32) => i32)[] = d()
print(u[0](3) + 2)
function ds() { return [id] }
const w: ((x: string) => string)[] = ds()
const g = w[0]
print(g("s"))
function di() { return [id, id] }
function main() {
  const xs: ((x: i32) => i32)[] = di()
  for f in xs { print(f(3)) }
}
main()
