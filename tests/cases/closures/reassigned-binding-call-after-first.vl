// @run
// @log 11
// @log 12
// @log 12
// @log 3
// @log 12
// @log 12
// @log 11
// @log 15
// @log 15
// @log 11
// @log 12
// @log 12
// @log 11
// @log 11
// @log 11
// @log 3
// @log 7
// @log 6
// @log 999
// @log 999
// @log 6
// @log 15
// @hint Intentionally-unused parameter `_xs` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_f` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_init` (leading `_` marks it unused)
// @hint redundant type annotation: `reduce1` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `reduce2` is inferred as `i32` — remove it to lean on inference
// The annotation on `d` is DELIBERATE and its hint is declared rather than removed: an
// arrow-annotated binding is the one spelling the fold never claimed, so it is the control.
// THE UNION-FREE HALF OF #1821, and the reason the fix is not scoped to unions: a
// function-valued binding that is REASSIGNED answered its INITIALIZER for every call after
// the FIRST, with no union anywhere in sight.
//
// One rung of `monoInstantiate`'s registry-hit rename folded the call into a by-name call to
// the initializer lambda's instance. The FIRST call escaped because it MINTS the instance
// (count 0 keeps the bare name and never renames); every later call is a registry HIT, and
// that is the rung that renamed. So the shape needs TWO calls after the write to be visible,
// which is why an ordinary-looking one-call program never showed it.
//
// The trigger is a binding whose annotation names no bare `(…) => R` — an UN-annotated one
// here, and the union arm in `unions/function-arm-reassign-after-narrow.vl`. A binding
// annotated with the arrow itself was never folded and is the control at the bottom.

// The module-scope binding case (4) uses this; declared up here so the assignment's lambda
// has the cell's type to infer its parameter from.
let gf = (n) => n + 1

// (1) Un-annotated local, two calls after the write.
function unannotated() {
  let f = (n) => n + 1
  print(f(10))
  f = (n) => n + 2
  print(f(10))
  print(f(10))
}

// (2) Two parameters — the fold is on the callee and does not read arity.
function twoArg() {
  let g = (a, b) => a + b
  print(g(1, 2))
  g = (a, b) => a * b
  print(g(3, 4))
  print(g(3, 4))
}

// (3) A CAPTURING lambda assigned OVER a non-capturing one. The rename's existing arm only
// asks whether the ORIGINAL is capturing, so this direction was unguarded and the captured
// `k` was dropped along with the write.
function capturingSecond() {
  const k = 5
  let h = (n) => n + 1
  print(h(10))
  h = (n) => n + k
  print(h(10))
  print(h(10))
}

// (4) A MODULE-SCOPE binding, written from inside a function.
function globalWrite() {
  print(gf(10))
  gf = (n) => n + 2
  print(gf(10))
  print(gf(10))
}

// (5) CONTROL: never assigned — the fold is correct here and stays.
function neverAssigned() {
  const c = (n) => n + 1
  print(c(10))
  print(c(10))
  print(c(10))
}

// (6) CONTROL: assigned, but annotated with the bare arrow — never folded, always correct.
function arrowAnnotated() {
  let d: (i32, i32) => i32 = (a, b) => a + b
  print(d(1, 2))
  d = (a, b) => a + b + 1
  print(d(3, 3))
}

// (7) THE SIBLING RUNG, a CONCRETE higher-order function reached through a reassigned
// binding. Its callee rename lives in `monoSpecializeConcrete`, not `monoInstantiate`, and
// it baked `reduce1`'s callback specialization into EVERY call — `6 / 6 / 6`.
//
// THE `: i32` RETURN ANNOTATIONS BELOW ARE LOAD-BEARING, not style: `monoSpecializeConcrete`
// specializes an ANNOTATED return only (its own gate), so dropping them makes this case test
// nothing — it silently passes on the compiler that has the bug. Their hints are declared.
function hofBinding() {
  let r = reduce1
  print(r([1, 2, 3], add, 0))
  r = reduce2
  print(r([1, 2, 3], add, 0))
  print(r([1, 2, 3], add, 0))
}

// (8) CONTROL: the same HOF called BY NAME twice. The rename is the specialization this
// feature exists for and it stays — the name is the declaration's, not a binding's.
function hofByName() {
  print(reduce1([1, 2, 3], add, 0))
  print(reduce1([4, 5, 6], add, 0))
}

function reduce1(xs: i32[], f: (i32, i32) => i32, init: i32): i32 {
  let acc = init
  let i = 0
  while i < xs.length {
    acc = f(acc, xs[i])
    i = i + 1
  }
  return acc
}

function reduce2(_xs: i32[], _f: (i32, i32) => i32, _init: i32): i32 {
  return 999
}

function add(a: i32, b: i32) { return a + b }

unannotated()
twoArg()
capturingSecond()
globalWrite()
neverAssigned()
arrowAnnotated()
hofBinding()
hofByName()
