// Missing-key variant of `module-holder-of-bundles-test-and-hand`: the holder reads key `z`, so it holds null.
// The holder tested in one function and handed whole to a parameter called at both signatures in another (D17111).
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
const m = Map()
m["a"] = lap((a) => a + 1)
const x = m["z"]
function has() { return x != null }
function take(b) {
  print(b(4))
  print(b(1.5))
}
function g() {
  if x != null { take(x) }
}
print(has())
g()
// @hint Intentionally-unused variable `_a`
// @hint Intentionally-unused variable `_b`
