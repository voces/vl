// @run
// @warning Unused parameter `b` (prefix with `_` to suppress, or remove it)
// @log 3
// @log x
// A closed function taking a union every call through the shared type parameter fits (D15464).
function go<F>(a: F, b: F) {
  print(a(3))
  print(a("x"))
}
function same<T>(k: T): T { k }
function con(x: string | i32) { x }
go(same, con)
