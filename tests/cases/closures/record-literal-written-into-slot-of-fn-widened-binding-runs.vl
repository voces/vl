// @log 4
// @log 2
// @log 2.5
// A record literal written whole into a field or element slot of a binding whose function fields
// the writes widen is built at the slot's record, so each write's function is a member of the
// field's set (D15307): nested slots, a loop, a write inside a function and a reassigned binding.
function id1(a) { return a }
function id2(a) { return a }
function id3(a) { return a }
const h = { r: { f: id1 } }
h.r = { f: id2 }
print(h.r.f(2))
print(h.r.f(2.5))
const xs = [{ f: id1 }]
xs[0] = { f: id2 }
print(xs[0].f(2))
print(xs[0].f(2.5))
const g = { r: { f: id1 }, q: { f: id1 } }
g.r = { f: id2 }
print(g.q.f(3))
const n = { a: { r: { f: id1 } } }
n.a.r = { f: id2 }
print(n.a.r.f(2))
print(n.a.r.f(2.5))
const ys = [{ f: id1 }, { f: id1 }]
let i = 0
while i < 2 {
  ys[i] = { f: id2 }
  i = i + 1
}
print(ys[0].f(2))
print(ys[1].f(2.5))
const w = { r: { f: id1 } }
function put() { w.r = { f: id2 } }
put()
print(w.r.f(2))
print(w.r.f(2.5))
let v = { r: { f: id1 } }
v.r = { f: id2 }
v = { r: { f: id3 } }
print(v.r.f(2))
print(v.r.f(2.5))
const s = { r: { f: id1, n: 1 } }
s.r = { f: id2, n: 2 }
print(s.r.n)
const k = s.r
print(k.f(4))
const zs = [{ f: id1 }]
zs[0] = { f: id2 }
for z in zs { print(z.f(2)) }
print(zs[0].f(2.5))
