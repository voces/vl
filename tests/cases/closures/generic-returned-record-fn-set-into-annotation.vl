// @run
// @log 5
// @log q
// A generic function's returned record holding a set, bound at an annotated closure list, calls
// the function its instance demanded (D15548).
function inc0(a) { return a + 1 }
function mk<T>(x: T) { return { fs: [inc0], x: x } }
const r: { fs: ((a: i32) => i32)[], x: string } = mk("q")
print(r.fs[0](4))
print(r.x)
