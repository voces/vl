// @run
// @log I
// @log 3
// @log I
// @log true
// @warning Unused function `ci` (prefix with `_` to suppress, remove it, or `export` it)
// @warning Unused function `q` (prefix with `_` to suppress, remove it, or `export` it)
// @warning Unused variable `flip` (prefix with `_` to suppress, or remove it)
// A list element called at the index spelled `00` is the element at 0, and runs (D7102).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function cb(f: (b: boolean) => void, b: boolean) { f(b) }
function ci(f: (n: i32) => void, n: i32) { f(n) }
function q(n: i32) { print("Q"); print(n) }
function main() {
  let k = inner
  const flip = () => {
    k = other
  }
  const r = k
  const fs = [r]
  fs[00](3)
  cb(r, true)
}
main()
