// @run
// @warning Unused parameter `b` (prefix with `_` to suppress, or remove it)
// @log 3
// @log x
// One generic handed to both parameters of a shared type parameter called at two types (D15464).
function go<F>(a: F, b: F) {
  print(a(3))
  print(a("x"))
}
function same<T>(k: T): T { k }
go(same, same)
