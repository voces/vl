// @run
// @log 3
// @log 0
// @log 7
// @log 7
// @log 0
// @log r
// @log hi!
// @log 30
// @log 18
// @log 0
// Calls through `const` bindings of lambdas that capture nothing, at module scope and in a
// function: an empty list whose element only the lambda's own signature closes is the direct call's
// (D14901), and a binding also read as a value keeps its closure.
type P = { a: i32, b: string }
const add = (x: i32, y: i32) => x + y
const mk = () => { return [] }
const rec = (n: i32): P => { return { a: n, b: "r" } }
const s = (t: string) => t + "!"
function useAll(k: i32) {
  print(add(k, 2))
  print(mk().length)
  print(rec(k).b)
  print(s("hi"))
}
const keep = add
print(add(1, 2))
print(mk().length)
print(rec(7).a)
useAll(5)
print(keep(10, 20))
const twice = (f: (x: i32) => i32, v: i32) => f(f(v))
print(twice((x: i32) => x * 3, 2))
function local() {
  const fu = () => { return [] }
  print(fu().length)
}
local()
