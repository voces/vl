// @run
// @log 6
// @log 6
// @log 6
// @log 6
// @log 6
// @log 4
// @log 1.5
// @log 1.75
// @log 6
// A re-pointed `let` whose functions agree at each type it is called at runs when handed to
// an un-annotated parameter, returned, aliased or held in a list (D9007, D9008).
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function half(a) { return a / 2.0 }
function w(h) { return h(3) }
function v(h) { return w(h) }
let f = inc0
f = dbl
print(w(f))
print(v(f))
function get() {
  let m = inc0
  m = dbl
  return m
}
print(get()(3))
const g = f
print(w(g))
const xs = [f]
print(xs[0](3))
// One parameter called with a different function from each call site: each call is its own.
print(w(inc0))
print(w(half))
// The binding's functions agree at the only type the parameter calls them at.
function u(h) { return h(3.5) }
let k = inc0
k = half
print(u(k))
// Handed back to the parameter's own function before the call.
function r(h, n) {
  if n > 0 { return r(h, n - 1) }
  return h(3)
}
print(r(f, 2))
