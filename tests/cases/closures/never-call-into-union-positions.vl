// @run
// @log 1
// @log 2
// @log 4
// @log 5
// A call that never returns, direct or through a function value, delivered into a union stands
// in for the value with no box around it: an argument, a binding and an interpolation hole.
type B = (s: string) => never
function fail(s: string): never { __trap__(s) }
function takeU(x: i32 | string) { return if x is i32 { x } else { x.length } }
function argValue(bail: B, c: boolean) {
  if c { return 1 }
  return takeU(bail("argValue"))
}
function argDirect(c: boolean) {
  if c { return 2 }
  return takeU(fail("argDirect"))
}
function bound(bail: B, c: boolean) {
  if c { return 4 }
  const u: i32 | string = bail("bound")
  return takeU(u)
}
function holed(bail: B, c: boolean) {
  if c { return "5" }
  return "<\{bail("holed")}>"
}
function bail(s: string): never { __trap__(s) }
print(argValue(bail, true))
print(argDirect(true))
print(bound(bail, true))
print(holed(bail, true))
