// @run
// @log 30
// @log 3
// @log 4
// D7841 with the elements called through constant indices instead of a `for`.
function add(a, b) { return a + b }
function apply2(g) {
  print(g(1, 2))
  print(g(1.5, 2.5))
}
function apply3(g) { print(g(10, 20)) }
const fs = [apply3, apply2]
fs[0](add)
fs[1](add)
