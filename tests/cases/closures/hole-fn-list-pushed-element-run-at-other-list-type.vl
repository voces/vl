// @run
// @warning Unused parameter `a`
// @log x2
// @log y20
// @log 2
// @log 20
// @log 2
// The D12700 witness: a function pushed onto a list is part of that list's elements, so the
// loop over it runs the pushed function at the list's own call type, not at the type an
// earlier list called it at.
import { toString } from "std:fmt"

function cat(a, b) { return a + b.toString() }
function snd(a, b) { return b }
function apply2(g) { print(g("x", 2)) }
function apply3(g) { print(g("y", 20)) }
const fs = [apply2, apply3]
const fs2 = [apply2, apply3]
fs2.push(apply2)
for f in fs { f(cat) }
for f in fs2 { f(snd) }
