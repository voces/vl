// @run
// @log -10
// @log 30
// D10793: the element's result through an index past 0, and an index named by a `const`.
function apply2(g) { return g(1, 2) }
function apply3(g) { return g(10, 20) }
const gs = [apply2, apply3]
const r = gs[1]((a, b) => a - b)
print(r)
const i = 1
print(gs[i]((a, b) => a + b))
