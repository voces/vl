// A hole lambda's bundle in an un-annotated record field, both handed whole and called through:
// read off the record, through a `const`, beside a scalar field, and inside a function (D15910).
function lap(f) {
  f(2.5)
  f(3)
  return f
}
function take(b) {
  print(b(4))
  print(b(1.5))
}
const o = { f: lap((a) => a + 1) }
take(o.f)
print(o.f(9))
const w = { f: lap((a) => a + 2) }
const v = w.f
take(v)
print(v(9))
const r = { f: lap((a) => a * 2), n: 3 }
take(r.f)
print(r.f(2.5))
print(r.n)
function g(k: i32) {
  const q = { f: lap((a) => a + k) }
  take(q.f)
  print(q.f(9))
}
g(1)
