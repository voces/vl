// @run
// @log a
// @log 1
// @log 9
// @log a
// @log 9
// @log 1
// @log a
// @log 1
// A top-level generic handed alone to a parameter called at two types, and in a choice with a
// capturing nested function to the same parameter: one set is tagged and one bundled (D15446).
function both(f) {
  print(f("a"))
  print(f(1))
}
function top(s) { return s }
function nested(c: boolean, n: i32) {
  function inner(s) {
    print(n)
    return s
  }
  both(if c { inner } else { top })
}
both(top)
nested(true, 9)
nested(false, 9)
