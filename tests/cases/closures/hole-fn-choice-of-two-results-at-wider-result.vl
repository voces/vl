// @run
// @log s
// @log 5
// @log s
// @log 5
// A bound choice between un-annotated functions returning different types, delivered to a
// closed function type whose result admits both, is called through an adapter at that type.
function inc(a) { return a + 1 }
function str(_a) { return "s" }
function useK(k: (a: i32) => i32 | string) { print(k(4)) }
function run(c: boolean) {
  const g = if c { str } else { inc }
  useK(g)
}
run(true)
run(false)
function held(c: boolean) {
  const g = if c { str } else { inc }
  const k: (a: i32) => i32 | string = g
  print(k(4))
}
held(true)
held(false)
