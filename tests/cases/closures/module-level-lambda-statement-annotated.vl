// @warning This expression has no effect: it is not the final statement of its block, so its value is discarded

// The control for D1643: the same module-level anonymous lambda WITH a return annotation.
// The annotation resolves the return at the hoist, so this spelling never reached the
// sentinel read — the two spellings must grade the same, and this one is the neighbour
// that says so.
(x: i32): i32 => x

