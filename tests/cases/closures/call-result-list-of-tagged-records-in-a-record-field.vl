// @run
// @log 4
// @log 4
// @log 1.5
// @log 4
// @log 2
// @log 6
// A call's list of records holding un-annotated functions with differing results, stored in a
// record literal's field, is built at the row its own literals build at (D15923).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function dbl(a: i32) { return a * 2 }
function mk() { return { a: [{ f: inc0 }, { f: half }] } }
function mkList() { return [{ f: inc0 }, { f: half }] }
function mk2() { return { a: [{ f: dbl }] } }
const w = { f: mk().a }
print(w.f[0].f(3))
const u = { f: mkList() }
print(u.f[0].f(3))
print(u.f[1].f(3))
function run() {
  const z = { f: mk().a }
  print(z.f[0].f(3))
  print(z.f[1].f(4))
}
run()
const v = { f: mk2().a }
print(v.f[0].f(3))
