// @run
// @info `a` is never reassigned; use `const` instead of `let`
// @log 1
// @log 1
// @log 1
// @log s
// @log 1
// @log 1
// @log s
// @log true
// @log 1
// @log s
// @log 2
// @log 1
// @log s
// @log z
// @log 1
// @log 1
// @log 1
// @log q
// A function returning a generic, called inside a generic or hole-parameter function, is
// typed at its results' calls in every instance of that function (D5970).
function k<T>(x: T): T { return x }
function mk() { return k }
function hole(u) {
  const a = mk()
  print(a(1))
  print(u)
}
function gen<U>(u: U) {
  const a = mk()
  print(a(1))
  const b = mk()
  print(b("s"))
  print(u)
}
function holeTwo(u) {
  const a = mk()
  print(a(1))
  const b = mk()
  print(b("s"))
  print(u)
}
function localGen<U>(u: U) {
  function mkL() { return k }
  const a = mkL()
  print(a(1))
  const b = mkL()
  print(b("s"))
  print(u)
}
function letHole(u) {
  let a = mk()
  print(a(1))
  print(u)
}
hole(1)
gen(1)
gen(true)
holeTwo(2)
localGen("z")
letHole(1)
hole("q")
