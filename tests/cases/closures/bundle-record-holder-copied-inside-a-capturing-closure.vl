// @run
// @log 5 2.5
// @log 6 3.5
// @log s
// @log 5 2.5
// @log 7
// @log 6 3.5
// @log 7 4.5
// @log 1.5
// A holder of a returned bundle's record, copied inside a closure that captures it: the copy holds
// the record, at the top level, in a plain function, in a generic function's two instances, and
// in a closure the function returns. An annotated holder keeps its one member.
function lap(f) {
  f(2.5)
  f(3)
  return f
}
function fr(k: i32) {
  const c = lap((a) => a + k)
  const g = () => {
    const v = c
    print("\{v(4)} \{v(1.5)}")
  }
  g()
}
function gen<T>(t: T, k: i32) {
  const c = lap((a) => a + k)
  const g = () => {
    const v = c
    print("\{v(4)} \{v(1.5)}")
  }
  print(t)
  g()
}
function mk(k: i32) {
  const c = lap((a) => a + k)
  return () => {
    const v = c
    print("\{v(4)} \{v(1.5)}")
  }
}
const c = lap((a) => a + 1)
const g = () => {
  const v = c
  print("\{v(4)} \{v(1.5)}")
}
g()
fr(2)
gen("s", 1)
gen(7, 2)
const h = mk(3)
h()
const d: (x: f64) => f64 = lap((a) => a / 2)
const e = () => {
  const v = d
  print(v(3))
}
e()
