// @log null
// A never-filled `let x = null` a closure captures is read and written at the `null` type: a
// statement write after the capture, and a write used as a value inside the closure, in its
// frame, or as the closure's body, store and yield `null` (D17222, D17221).
function readAfterWrite() {
  let x = null
  const g = () => x
  x = null
  print(g())
}
function blockBody() {
  let x = null
  const g = () => {
    return x
  }
  x = null
  print(g())
}
function valueInClosure() {
  let x = null
  const g = () => {
    print(x = null)
    print((x = null) == null)
  }
  g()
}
function valueAsBody() {
  let x = null
  const g = () => x = null
  print(g())
}
function valueInFrame() {
  let x = null
  const g = () => x
  print(x = null)
  print(g())
}
function boundFirst() {
  let x = null
  const g = () => x
  x = null
  const r = g()
  print(r)
}
function twoClosures() {
  let x = null
  const w = () => {
    x = null
  }
  const r = () => {
    print(x)
  }
  w()
  r()
  x = null
  r()
}
function same<T>(v: T): T { return v }
function genericWrite() {
  let x = null
  const g = () => x
  x = same(null)
  print(g())
}
readAfterWrite()
blockBody()
valueInClosure()
valueAsBody()
valueInFrame()
boundFirst()
twoClosures()
genericWrite()
