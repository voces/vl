// @run
// @log 3
// @log x
// A written `let` seeded from a hole parameter and assigned another parameter holding a closed
// function, the first also called directly at another type (D15456).
function go(a, b) {
  let hh = a
  hh = b
  print(hh(3))
  print(a("x"))
}
function same<T>(k: T): T { k }
function dbl(x: i32) { x }
go(same, dbl)
