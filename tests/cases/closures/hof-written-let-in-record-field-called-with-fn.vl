// @run
// @log 3
// A record field holding a generic higher-order function from a `let` written afterwards is
// called with a function at the field's own call type (D7145).
function apply3<F>(g: F) { print(g(1, 2)) }
function apply4<F>(g: F) { print(g(3, 4)) }
function add(a: i32, b: i32) { a + b }
let h = apply3
const r = { f: h }
h = apply4
r.f(add)
