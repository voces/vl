// @run
// @log 4
// @log 5
// @log 4
// @log 4
// A record of un-annotated function containers returned through a `const` types the caller's
// binding as a record literal returned directly would, with other fields beside it (D9251).
function inc0(a) { return a + 1 }
const hm = Map()
hm["k"] = inc0
function mk() { const r = { m: hm }; return r }
const v = mk()
const x = v.m["k"]
if x != null { print(x(3)) }
function mk2() { const r = { m: hm, n: 5 }; print(r.n); return r }
const v2 = mk2()
const x2 = v2.m["k"]
if x2 != null { print(x2(3)) }
const hl = [inc0]
function mk3() { const r = { m: hl }; return r }
const v3 = mk3()
print(v3.m[0](3))
