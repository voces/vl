// A list parameter of un-annotated functions with different results, walked by `for`: each
// element is called through the set, directly, through a copy, through an inner loop, as an
// element chain's root, or from a record field's list (D16744).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function direct(xs) {
  for x in xs { print(x(3)) }
}
function viaConst(xs) {
  for x in xs {
    const y = x
    print(y(3))
  }
}
function viaLet(xs) {
  for x in xs {
    let y = x
    print(y(3))
  }
}
function nested(xss) {
  for xs in xss {
    for x in xs { print(x(3)) }
  }
}
function chain(xss) {
  for xs in xss { print(xs[0](3)) }
}
function field(r) {
  for x in r.fs { print(x(3)) }
}
function twice(xs) {
  for x in xs { print(x(4)) }
}
direct([inc0, half])
viaConst([inc0, half])
viaLet([inc0, half])
nested([[inc0, half], [half]])
chain([[inc0], [half]])
field({ fs: [inc0, half] })
twice([inc0, half])
