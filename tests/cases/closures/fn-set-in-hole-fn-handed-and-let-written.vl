// @run
// @log -3
// @log 4
// @log -3
// A choice inside an un-annotated function, called there, handed on as a let one branch
// rewrites, and handed on as an `if`, calls the member it holds at that function's instance.
function inc(x) { return x + 1 }
function neg(x) { return 0 - x }
const k = [1].length > 1
function num(z) {
  const f = if k { inc } else { neg }
  print(f(z))
}
num(3)
function only(z, g) { return g(z) }
function numHanded(z) {
  let h = inc
  if k { h = neg }
  print(only(z, h))
  print(only(z, if k { inc } else { neg }))
}
numHanded(3)
