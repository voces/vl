// @run
// @log 3
// @log 20
// @log -3
// @log 4
// @log 5
// Twin declared records holding a function, an inline one, and a list pushed from a list of a
// record that captures, each read back through its own list.
type R = { f: (i32) => i32 }
type Q = { f: (i32) => i32 }
type P = { f: (i32) => i32, n: i32 }
const xs: R[] = [{ f: (x: i32): i32 => x + 1 }]
const ys: Q[] = [{ f: (x: i32): i32 => x * 10 }]
const zs: { f: (i32) => i32 }[] = [{ f: (x: i32): i32 => x - 5 }]
print(xs[0].f(2))
print(ys[0].f(2))
print(zs[0].f(2))
const k = 4
const ps: P[] = [{ f: (x: i32): i32 => x + k, n: 1 }]
const qs: P[] = []
qs.push({ f: (x: i32): i32 => x * 2, n: 2 })
for p in ps { qs.push(p) }
for p in qs { print(p.f(p.n)) }
