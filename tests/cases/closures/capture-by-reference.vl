// Closures capture variables by reference (D2339; DECISIONS.md "Closures capture variables by
// reference"): a closure sees a binding's current value, and a write through a closure is
// seen by the frame that declared it. A binding declared inside a loop body, and a loop
// variable, is a fresh one per iteration, as JS `let` and `for … of` are.

// The witness: a write after the capture is seen by the closure.
function witness() {
  let k = 1
  const g = () => k
  k = 5
  print(g()) // 5
}
witness()

// A write before the capture is captured by value, which is the same thing.
function writeBefore() {
  let k = 1
  k = 2
  const g = () => k
  print(g()) // 2
}
writeBefore()

// One binding outside a loop, written inside it: the closure sees the last write.
function outerLetLoop() {
  let total = 0
  const g = () => total
  for i in 0 to 3 { total = total + i }
  print(g()) // 6
  let s = "a"
  const h = () => s
  let j = 0
  while j < 3 {
    s = s + "b"
    j = j + 1
  }
  print(h()) // abbb
}
outerLetLoop()

// A `let` inside a loop body is one binding per iteration; each closure keeps its own.
function perIterationLet() {
  const fs: (() => i32)[] = []
  for i in 0 to 2 {
    let j = i
    fs.push(() => j)
    j = j * 10
  }
  for f in fs {
    print(f()) // 0 10 20
  }
}
perIterationLet()

// A `let` outside the loop is ONE binding: every closure made in the loop shares it, whether
// the write comes after the capture in the body or before it.
function sharedAcrossIterations() {
  const fs: (() => i32)[] = []
  let n = 0
  for i in 0 to 2 {
    fs.push(() => n)
    n = n + 1
  }
  for f in fs {
    print(f()) // 3 3 3
  }
  const gs: (() => i32)[] = []
  let m = 0
  for i in 0 to 2 {
    m = i * 2
    gs.push(() => m)
  }
  for g in gs {
    print(g()) // 4 4 4
  }
}
sharedAcrossIterations()

// A `let` in a `while` body, and one in an outer loop shared by an inner one.
function nestedLoops() {
  const fs: (() => i32)[] = []
  let i = 0
  while i < 3 {
    let j = i
    fs.push(() => j)
    j = j + 100
    i = i + 1
  }
  for f in fs {
    print(f()) // 100 101 102
  }
  const gs: (() => i32)[] = []
  for a in 0 to 1 {
    let acc = a * 10
    for b in 0 to 1 {
      gs.push(() => acc)
      acc = acc + 1
    }
  }
  for g in gs {
    print(g()) // 2 2 12 12
  }
}
nestedLoops()

// A for-in variable is per iteration; writing it after the capture is seen by that
// iteration's closure only, and a closure may write it.
function forInVariable() {
  const fs: (() => i32)[] = []
  for x in [1, 2, 3] { fs.push(() => x) }
  for f in fs {
    print(f()) // 1 2 3
  }
  const gs: (() => i32)[] = []
  for x in [1, 2, 3] {
    gs.push(() => x)
    x = x * 10
  }
  for g in gs {
    print(g()) // 10 20 30
  }
}
forInVariable()

// A range variable is per iteration too. A write to it, from the body or through a closure,
// is where the next iteration steps from, and `continue` carries it over.
function rangeVariable() {
  const fs: (() => i32)[] = []
  for i in 0 to 2 { fs.push(() => i * 100) }
  for f in fs {
    print(f()) // 0 100 200
  }
  for i in 0 to 9 {
    const skip = () => {
      i = i + 3
    }
    print(i) // 0 4 8
    skip()
  }
  const gs: (() => i32)[] = []
  for i in 0 to 9 {
    gs.push(() => i)
    i = i + 1
    if i > 4 { continue }
    print(i) // 1 3
  }
  for g in gs {
    print(g()) // 1 3 5 7 9
  }
}
rangeVariable()

// A parameter written after the capture, or through a closure.
function paramAfter(p: i32) {
  const g = () => p
  p = p + 1
  g()
}
function paramThroughClosure(p: i32) {
  const w = () => {
    p = p * 3
  }
  w()
  p
}
function optionalParam(p?: i32) {
  const g = () => p ?? 0
  p = 7
  g()
}
print(paramAfter(4)) // 5
function lambdaParam() {
  const f = (p: i32) => {
    const g = () => p
    p = p * 2
    g()
  }
  print(f(21)) // 42
}
lambdaParam()
print(paramThroughClosure(4)) // 12
print(optionalParam()) // 7
print(optionalParam(1)) // 7

// Compound assignment and increments are writes like any other.
function compound() {
  let a = 1
  const ga = () => a
  a += 10
  print(ga()) // 11
  let b = 1
  const gb = () => b
  const old = b++
  print(old) // 1
  print(gb()) // 2
  let c = 1
  const gc = () => c
  ++c
  print(gc()) // 2
}
compound()

// Nested closures, a closure capturing another closure's local, and a returned closure.
function nested() {
  let k = 1
  const g = () => () => k
  const h = g()
  k = 7
  print(h()) // 7
  const mk = () => {
    let n = 0
    const get = () => n
    n = 4
    get()
  }
  print(mk()) // 4
}
nested()
function maker(): () => i32 {
  let v = 1
  const g = () => v
  v = 2
  g
}
print(maker()()) // 2
function counterRead(): () => i32 {
  let n = 0
  const get = () => n
  n = n + 10
  n = n + 1
  get
}
print(counterRead()()) // 11

// A `let` with no initializer takes its zero value in the shared cell.
function noInit() {
  let u: i32
  const g = () => u
  u = 5
  print(g()) // 5
  let s: string
  const h = () => s
  s = "set"
  print(h()) // set
  let d: f64
  const gd = () => d
  d = 2.5
  print(gd()) // 2.5
}
noInit()

// Every value kind shares the same way.
function kinds() {
  let p = { x: 1 }
  let s = "one"
  const g = () => p.x
  const h = () => s
  p = { x: 9 }
  s = "two"
  print(g()) // 9
  print(h()) // two
  let v: i32 | string = 1
  const gv = () => v
  v = "s"
  const r = gv()
  if r is string { print("str " + r) } else { print(r) }
  let xs = [1, 2]
  const gx = () => xs.length
  xs = [1, 2, 3, 4]
  print(gx()) // 4
  let f = () => 1
  const gf = () => f()
  f = () => 2
  print(gf()) // 2
  let x: i32 | null = null
  const gn = () => x ?? -1
  x = 4
  print(gn()) // 4
  x = null
  print(gn()) // -1
  let b = false
  let c = 'a'
  const gb = () => b
  const gc = () => c
  b = true
  c = 'z'
  print(gb()) // true
  print(gc()) // 122
}
kinds()

// A narrowing the closure is written under stays the closure's: every later write keeps it.
function narrowed() {
  let x: i32 | null = 3
  if x != null {
    const g = () => x + 1
    x = 10
    print(g()) // 11
  }
}
narrowed()

// A write in the other arm of an `if` cannot follow the capture in one pass, unless a loop
// runs the `if` again over the same binding.
function arms(c: boolean) {
  let x = 1
  if c {
    const g = () => x
    print(g()) // 1
  } else if x > 0 {
    x = 2
  } else {
    x = 3
  }
  print(x) // 1, then 2
  const fs: (() => i32)[] = []
  let y = 0
  for i in 0 to 3 {
    if i % 2 == 0 { fs.push(() => y) } else { y = y + 10 }
  }
  for f in fs {
    print(f()) // 20 20
  }
}
arms(true)
arms(false)

// Both bindings of a for-in pair are per iteration.
function pairs() {
  const fs: (() => string)[] = []
  for v, k in ["a", "b"] {
    fs.push(() => "\{v}\{k}")
    k = k + 10
  }
  for f in fs {
    print(f()) // a10 b11
  }
}
pairs()

// Named arguments run in parameter order, so the closure below is created before the write
// in the argument written ahead of it (D2343).
function call2(a: () => i32, b: i32) { a() }
function namedArgs() {
  let x = 1
  const r = call2(b: x = 5, a: () => x)
  print(r) // 5
  print(x) // 5
  let y = 1
  const q = call2(b: y++, a: () => y)
  print(q) // 2
  print(y) // 2
}
namedArgs()
