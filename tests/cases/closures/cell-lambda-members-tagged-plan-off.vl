// @run
// @log a
// @log 4
// @log b
// @log 6
// Lambda members of a written `let` a nested function writes hold the tagged set's id, so the
// binding is not counted per signature under the capture cell, seeded at the `let` or through a
// `const` (D15433, D15435).
function mk(x: string, n: i32) {
  let d1 = (y) => y
  function w1() { d1 = d1 }
  let d3 = (y) => y + y
  d3 = d1
  print(d1(x))
  print(d3(n))
}
mk("a", 4)
function mk2(x: string, n: i32) {
  const g = (y) => y
  const h = (y) => y + y
  let d1 = g
  function w1() { d1 = d1 }
  let d3 = h
  d3 = d1
  print(d1(x))
  print(d3(n) + 2)
}
mk2("b", 4)
