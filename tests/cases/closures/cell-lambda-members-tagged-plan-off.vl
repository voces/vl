// @run
// @log a
// @log 4
// Lambda members of a written `let` a nested function writes hold the tagged set's id, so the
// binding is not counted per signature under the capture cell (D15433).
function mk(x: string, n: i32) {
  let d1 = (y) => y
  function w1() { d1 = d1 }
  let d3 = (y) => y + y
  d3 = d1
  print(d1(x))
  print(d3(n))
}
mk("a", 4)
