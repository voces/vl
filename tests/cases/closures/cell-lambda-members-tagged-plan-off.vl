// @run
// @log a
// @log 4
// @log b
// @log 6
// @log 4
// @log 7.5
// Lambda members of a written `let` a nested function writes hold the tagged set's id, whether
// written at the binding or seeded through a `const`, in a function or at module scope (D15433).
function mk(x: string, n: i32) {
  let d1 = (y) => y
  function w1() {
    d1 = d1
  }
  let d3 = (y) => y + y
  d3 = d1
  print(d1(x))
  print(d3(n))
}
mk("a", 4)
function mk2(x: string, n: i32) {
  const g = (y) => y
  const h = (y) => y + y
  let d1 = g
  function w1() {
    d1 = d1
  }
  let d3 = h
  d3 = d1
  print(d1(x))
  print(d3(n) + 2)
}
mk2("b", 4)
const k = 3
const g = (y) => y + k
const h = (y) => y * k
let d1 = g
function w1() { d1 = h }
print(d1(1))
w1()
print(d1(2.5))
