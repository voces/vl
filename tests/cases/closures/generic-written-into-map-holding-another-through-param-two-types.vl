// @run
// @log id2
// @log 7
// @log id2
// @log w
// @log id2
// @log 8
// @log id2
// @log v
// A helper writes a second generic into a map that already holds one, by index or by `set`, and
// the map is read back at two types: the write is the member's leaf in the map's set (D15531).
function id<T>(x: T): T { x }
function id2<T>(x: T): T {
  print("id2")
  x
}
function bare(mm) { mm["k"] = id2 }
function put(mm) { mm.set("k", id2) }
const h = Map()
h["k"] = id
bare(h)
const hr = h["k"]
if hr != null {
  print(hr(7))
  print(hr("w"))
}
const q = Map()
q["k"] = id
put(q)
const qr = q["k"]
if qr != null {
  print(qr(8))
  print(qr("v"))
}
