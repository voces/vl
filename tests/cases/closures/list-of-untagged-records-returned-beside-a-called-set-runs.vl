// A function returning a list of records over a function set nothing calls, beside a binding of a
// set it calls through, builds its result at the closure row its return is built at.
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function useL(r) { return r[0].fs[0](10) }
function passed() {
  const c = [{ fs: [dbl] }]
  print(c[0].fs[0](10))
  return [{ fs: [inc0] }]
}
function handed() {
  const c = [{ fs: [dbl] }]
  print(useL(c))
  return [{ fs: [inc0] }]
}
passed()
print(handed().length)
print(useL([{ fs: [dbl] }]))
