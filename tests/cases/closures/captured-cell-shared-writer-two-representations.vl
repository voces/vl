// @run
// @log O
// @log 1
// @log O
// @log s
// A capture cell in a generic body, written with a generic by a closure the instances share, is built at two instances of different representations (D3939, D3957, `rv3498/v06`).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function a<T>(x: T) {
  let k = inner
  const toO = () => {
    k = other
  }
  toO()
  k(x)
}
a(1)
a("s")
