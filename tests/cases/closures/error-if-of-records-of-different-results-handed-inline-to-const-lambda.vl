// @error cannot store 'inc0' in 'r.f': called at (i32) it returns i32, where 'half', also stored in it, returns f64 — every function a call through 'r.f' may run must return one type
// An `if` of records whose field holds functions returning different types, handed to a `const`
// lambda's un-annotated parameter, is judged at its calls as a named function's is (D15808).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function two() { [1, 2].length }
const take = (r) => r.f(3)
print(take(if two() > 5 { { f: half } } else { { f: inc0 } }))
