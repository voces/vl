// @run
// @log 3
// @log 4
// @log 3
// @log 4
// @log 1
// A list of a hole function called through its element and iterated by a `for` that never reads
// its loop variable takes the generic the call hands it at both signatures (D7101).
function add(a, b) { return a + b }
print(add(1, 2))
print(add(1.5, 2.5))
function apply2(g) {
  print(g(1, 2))
  print(g(1.5, 2.5))
}
const fs = [apply2]
fs[0](add)
for f in fs { print(1) }
