// @check
// @error-at 6:6 argument 2: expected (i32) => string, got (i32) => i32 (the call of `g` at the call's argument types)
// D5842: a lambda handed through a hole is checked against the function type the callee's body
// hands it to, so a body of the wrong type is refused at the call that hands it.
function two(a: i32, b: (n: i32) => string): string { b(a) }
function apply(g, x, y) { return g(x, y) }
print(apply(two, 3, (n) => n * 2))
