// @run
// @log 4
// @log true
// @log 4
// @log 4
// @log 5
// A map or list of un-annotated lambdas held in a record an expression-bodied lambda returns,
// read through the call by a `const` or in place, at module scope and in a function body.
const f = (a) => a + 1
const hm = Map()
hm["k"] = f
const mk = () => ({ m: hm })
const v = mk()
const x = v.m["k"]
if x != null { print(x(3)) }
print(mk().m["k"] != null)
function use() {
  const mk2 = () => ({ m: hm })
  const y = mk2().m["k"]
  if y != null { print(y(3)) }
}
use()
const hl = [f]
const mkl = () => ({ xs: hl })
print(mkl().xs[0](3))
const mkn = () => ({ r: { m: hm }, n: 5 })
print(mkn().n)
