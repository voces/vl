// @run
// @log s
// @log 1
// @log t
// @log 8
// @log u
// @log 3
// @log v
// @log 4
// A written `let` of a generic whose write already took the instance at the binding's pin is
// still a binding of generics, so its seed takes that instance too, while another binding takes
// the same generic at another type first: a list element, two of them, a capture and an argument
// (D4891).
function k<T>(x: T): T { return x }
function ap(h: (n: i32) => i32) { return h(4) }
function listElem() {
  let f = k
  f = k
  print(f("s"))
  let g = k
  g = k
  const fs = [g]
  print(fs[0](1))
}
listElem()
function twoElems() {
  let f = k
  f = k
  print(f("t"))
  let g = k
  g = k
  const fs = [g, g]
  print(fs[1](7) + fs[0](1))
}
twoElems()
function captured() {
  let f = k
  f = k
  print(f("u"))
  let g = k
  g = k
  const h = () => g(3)
  print(h())
}
captured()
function argument() {
  let f = k
  f = k
  print(f("v"))
  let g = k
  g = k
  print(ap(g))
}
argument()
