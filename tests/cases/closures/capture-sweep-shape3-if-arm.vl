// @run
// @log x
// @log w
// A closure capturing a binding held as the atom reads it at a string at an `if` arm: the captured
// atom, decoded (capture binding shape 3, Q58 position sweep).
const A = "x"
const B = "y"
function main(c: boolean) {
  const M = if c { A } else { B }
  const f = () => if c { M } else { "w" }
  print(f())
}
main(true)
main(false)
