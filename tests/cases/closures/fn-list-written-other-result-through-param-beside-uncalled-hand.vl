// @run
// @warning Unused function `hand` (prefix with `_` to suppress, remove it, or `export` it)
// @log 1.5
// A list of an un-annotated function written one of another result through a parameter, which an
// uncalled function also hands its own parameter to: the uncalled body builds no instance (D15136).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function put(ys) { ys[0] = half }
function hand(zs) { put(zs) }
const xs = [inc0]
put(xs)
print(xs[0](3))
