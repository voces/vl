// @run
// @log 2
// @log s
// A capture cell runs with a writer storing a parameter typed by the enclosing `T`, each value instanced at the cell's type
// (D3939, `rv3498/g02`).
function inner<U>(u: U) { print("I"); print(u) }
function a<T>(x: T, p: (t: T) => void) {
  let k = inner
  const toO = () => {
    k = p
  }
  toO()
  k(x)
}
a(1, (t: i32) => {
  print(t + 1)
})
a("s", (t: string) => {
  print(t)
})
