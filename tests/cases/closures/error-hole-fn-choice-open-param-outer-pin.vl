// @error cannot choose 'lenOf' here: called at (string) it returns i32
// When the caller's parameter is itself only pinned by its own caller, the choice is judged at
// that outer pin (D13782).
function twice(s) { return s + s }
function lenOf(s) { return s.length }
const k = [1].length > 1
function bad(z) {
  const f = if k { twice } else { lenOf }
  print(f(z))
}
function outer(y) { bad(y) }
outer("ab")
