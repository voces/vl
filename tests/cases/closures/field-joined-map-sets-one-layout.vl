// @run
// @log 4
// @log 6
// @log 4
// @log 9
// @log 3
// Two records of one field-name set, a call's result each, holding in field `m` maps of different
// sets of un-annotated lambdas, one of them tagged: the field has one layout, so both maps hold
// the tagged set's ids and each read dispatches on its member. A list in the field joins too.
const f = (a) => a + 1
const hm = Map()
hm["k"] = f
function mk() { return { m: hm } }
const y = mk().m["k"]
if y != null { print(y(3)) }
const g1 = (a) => a + 1
const g2 = (a) => a * 2
const tm = Map()
tm["k"] = g1
tm["j"] = g2
function mkt() { return { m: tm } }
const yt = mkt().m["j"]
if yt != null { print(yt(3)) }
const h1 = (a) => a + 1
const h2 = (a) => a * 3
const ha = [h1]
const hb = [h1, h2]
function la() { return { xs: ha } }
function lb() { return { xs: hb } }
print(la().xs[0](3))
print(lb().xs[1](3))
print(hb.length + ha.length)
