// @run
// @log 6
// @log 6
// @log 6
// @hint Intentionally-unused variable `_a`
// @hint Intentionally-unused variable `_b`
// A maker's called-and-returned lambda stored in two maps, each beside a hole function, puts
// the two maps' function sets in one family; the family is planned together (D17739).
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
function dbl(x) { return x * 2.0 }
const m = Map()
m["a"] = lap((a) => a + 1)
m["b"] = dbl
const h = m["b"]
if h != null { print(h(3)) }
const tw = (x) => x * 2.0
const n = Map()
n["a"] = lap((a) => a + 1)
n["b"] = tw
const t = n["b"]
if t != null { print(t(3)) }
const g = n["a"]
if g != null { print(g(5)) }
