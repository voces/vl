// @run
// @log 2
// @log 3
// @log 8
// @log 1.5
// Functions written into a map read out of a list's element join one set, as writes through a
// bound map do, so the set is tagged and the list's map holds its ids (D15118).
function id0(a) { return a }
function id1(a) { return a }
const ms = [Map()]
ms[0].set("k", id0)
ms[0].set("j", id1)
const g = ms[0]["k"]
if g != null { print(g(2)) }
const ns = [Map()]
ns[0]["k"] = id0
ns[0]["j"] = id1
const h = ns[0]["j"]
if h != null { print(h(3)) }
function run() {
  const xs = [Map()]
  xs[0].set("k", id0)
  xs[0].set("j", id1)
  const q = xs[0].get("k")
  if q != null { return q(8) }
  0
}
print(run())
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const ws = [Map()]
ws[0].set("a", inc0)
ws[0].set("b", half)
const w = ws[0].get("b")
if w != null { print(w(3)) }
