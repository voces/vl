// @emit-error the captured binding `k` is written with a function inside a closure that every instance of
// A hole lambda written through a const alias is refused at two types like the literal (review of #3498, `rv3498/e20_hole_lambda_alias_shared_writer_i32_bool`).
function inner<U>(u: U) { print("I"); print(u) }
function a<T>(x: T) {
  let k = inner
  const h = (u) => {
    print("L"); print(u)
  }
  const w = () => {
    k = h
  }
  k(x)
  w()
  k(x)
}
a(1)
a(true)
