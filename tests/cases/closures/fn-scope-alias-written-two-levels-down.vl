// @run
// @log 8
// @log 12
// @log sss
// A module-scope hole lambda written into a function's `let` two nested functions down takes
// the alias's signature, and keeps its own instance for a direct call at another type (D3865).
const c = (y) => y + y
const e = (y) => y + y + y
function mk(n: i32) {
  let d = c
  function mid() {
    function inner() { d = e; 0 }
    inner()
  }
  print(d(n))
  mid()
  print(d(n))
}
mk(4)
print(e("s"))
