// @run
// @log 5
// @log xx
// @log b
// @log a
// @log 9
// @log a
// @log b
// @log b
// @log n5
// @log N
// @log N
// @log N
// D3139: a capture is resolved at the loop and the `let` that enclose the closure, not at the
// first binding of its name: two walks under one name, two copies named alike, a local
// iterable, a copy of a copy, and a generic called on the second of two same-named copies.
type K = "a" | "b"
function g(ks: K[], ns: i32[]) {
  for e in ks {}
  for e in ns {
    const c = e
    const f = () => c
    print(f())
  }
}
g(["a"], [5])
function h() {
  const ks: K[] = ["b", "a"]
  const ss = ["xx"]
  for e in ss {
    const c = e
    print(c)
  }
  for e in ks {
    const c = e
    const f = () => c
    print(f())
  }
}
h()
function sk(x: K) { return x }
function u() {
  const pn = [9]
  for e in pn {
    const c = e
    print(c)
  }
  const vs: (K | i32)[] = ["a", 3, "b"]
  for e in vs {
    if !(e is i32) {
      const c = e
      const d = c
      const f = () => sk(d)
      print(f())
    }
  }
}
u()
function id<X>(a: X): X { return a }
function si(x: i32 | null) {
  if x == null { return "N" }
  return "n\{x}"
}
function w() {
  const pk: K[] = ["b"]
  for e in pk {
    const c = e
    print(c)
  }
  const vs = [5, null]
  for e in vs {
    let c = e
    print(si(id(c)))
    c = null
    const f = () => c
    print(si(f()))
  }
}
w()
