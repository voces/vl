// @check
// @error ((T) => T)[] is not ((i32) => i32)[]: a container never widens implicitly, and only a readonly list is covariant. A store through ((i32) => i32)[] could put in an element that ((T) => T)[] does not allow. Declare the destination `readonly ((i32) => i32)[]` for a read-only view, or copy it with `.map((x): (i32) => i32 => x)`
// A mutable list sharing an inferred list of a function set at a closed function type is refused
// at check: only a readonly list may take that list's elements through adapters (D15133).
function id<T>(x: T): T { return x }
function dbl<T>(x: T): T { return x + x }
let f = id
f = dbl
print(f("s"))
print(f(1))
const zs = [f]
const ys: ((x: i32) => i32)[] = zs
print(ys[0](41))
