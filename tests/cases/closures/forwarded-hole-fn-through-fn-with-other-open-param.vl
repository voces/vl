// @run
// @log 3
// @log 2
// @log 1
// @log 7
// @log 2
// @log 3.75
// @log 2.25
// @log b
// A hole function forwarded through a function that has another open parameter, beside a call that
// makes its set an id, is taken at the set there: the other parameter a hole, then generic.
function add(a, b) { return a + b }
function mul(a, b) { return a * b }
function same(g, s) { print(g(s, s)) }
function twoCalls(g, s) {
  print(g(1, 2))
  print(g(s, 1.5))
}
function once(k, h) {
  for f in [twoCalls] { f(h, k) }
}
once(0.5, add)
function each(k, h) {
  for f in [same] { f(h, k) }
}
function run(x, h) {
  each(0.5, h)
  print(x)
}
run(7, add)

function bOnce(k, h) {
  for f in [twoCalls] { f(h, k) }
}
bOnce(2.5, mul)
function bEach(k, h) {
  for f in [same] { f(h, k) }
}
function bRun<T>(x: T, h) {
  bEach(1.5, h)
  print(x)
}
bRun("b", mul)
