// @log 5.5
// @log 1.5
// @log 11.5
// @log 5.5
// @log 1.5
// Returns whose list literals hold records of different sets of un-annotated functions, of
// different results, are built at the joined result, the smaller set decided with it (D15924).
function two() { [1, 2].length }
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function pick(b: boolean) {
  if b { return [{ f: inc0 }, { f: half }] }
  return [{ f: half }]
}
const l = pick(two() > 1)
print(l[0].f(3) + l[1].f(3))
print(pick(false)[0].f(3))
for e in pick(true) { print(e.f(5)) }
function inc1(a) { return a + 1 }
function half1(a) { return a / 2.0 }
function pickSwapped(b: boolean) {
  if b { return [{ f: half1 }] }
  return [{ f: inc1 }, { f: half1 }]
}
const s = pickSwapped(two() > 5)
print(s[0].f(3) + s[1].f(3))
print(pickSwapped(true)[0].f(3))
function inc2(a) { return a + 1 }
function half2(a) { return a / 2.0 }
function dbl2(a) { return a * 2 }
function pickThree(b: boolean) {
  if b { return [{ f: inc2 }, { f: half2 }, { f: dbl2 }] }
  return [{ f: half2 }]
}
const t = pickThree(two() > 1)
print(t[0].f(3) + t[1].f(3) + t[2].f(3))
function inc3(a) { return a + 1 }
function half3(a) { return a / 2.0 }
function pickNested(b: boolean) {
  if b { return [{ r: { f: inc3 } }, { r: { f: half3 } }] }
  return [{ r: { f: half3 } }]
}
const n = pickNested(two() > 1)
print(n[0].r.f(3) + n[1].r.f(3))
print(pickNested(false)[0].r.f(3))
