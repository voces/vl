// @run
// @log abcabc
// @log 3
// A `for` over an inline list literal of un-annotated functions whose results differ calls
// each element's own member at the loop's argument (D13783).
function twice(s) { return s + s }
function lenOf(s) { return s.length }
for g in [twice, lenOf] { print(g("abc")) }
