// @run
// @log 4
// @log 4
// @log 6
// @log 3
// @log 4
// @log 5
// @log 6
// @log 4
// @log 4
// @log 7
// A map or list of un-annotated or generic functions held by a record nested in a field takes
// its value type from the calls through the field path (D9103).
function inc0(a) { return a + 1 }
function id<T>(a: T): T { return a }
const m = Map()
m["k"] = inc0
const w = { f: { m: m } }
const x = w.f.m["k"]
if x != null { print(x(3)) }
const w2 = { f: { xs: [inc0] } }
print(w2.f.xs[0](3))
const w3 = { f: { g: { m: m } }, n: 2 }
const x3 = w3.f.g.m["k"]
if x3 != null { print(x3(3) + w3.n) }
const im = Map()
im["k"] = id
const w4 = { f: { m: im } }
const v4 = w4
const x4 = v4.f.m["k"]
if x4 != null { print(x4(3)) }
const w5 = { f: { m: Map() } }
w5.f.m["k"] = inc0
const x5 = w5.f.m["k"]
if x5 != null { print(x5(3)) }
for k, g in w.f.m { print(g(4)) }
const c = () => {
  const x7 = w.f.m["k"]
  if x7 != null { print(x7(5)) }
}
c()
const v8 = w.f
const x8 = v8.m["k"]
if x8 != null { print(x8(3)) }
const w9 = { f: { g: { xs: [inc0] } } }
const v9 = w9.f
const q9 = v9.g
print(q9.xs[0](3))
const v10 = w4.f
const h = () => {
  const x10 = v10.m["k"]
  if x10 != null { print(x10(7)) }
}
h()
