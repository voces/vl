// @run
// @log 9
// @hint Intentionally-unused parameter `_q0`
// A closure-result struct whose field is itself a closure, fed a nested lambda literal
// (`(i32) => {f: () => {f: i64}}` fed `{f: () => ({f: 9})}`): three `{f}` shapes of one
// field-name set, the outer closure field, the inner `i64` field and the literal's own. The
// literal holding a function keeps its own row rather than the `i64` one, so it builds
// (D6373; once a loud floor, fuzz-nightly seed 4797042 d5).
function go() {
  const v: (i32) => {f: () => {f: i64}} = (_q0) => ({ f: () => ({ f: 9 }) })
  print(v(1).f().f)
}
go()
