// @run
// @log 5
// @log 5
// @log 5
// @log 5
// A `const` holding a hole function handed back by a generic identity, delivered where the result
// is wider, is read once into an adapter at the function's own instance (D17815).
function inc(a) { return a + 1 }
function id<T>(t: T): T { return t }
const g = id(inc)
const k: (a: i32) => i32 | string = g
print(k(4))
function useK(k2: (a: i32) => i32 | string) { print(k2(4)) }
useK(g)
const h = inc
const g2 = id(h)
const k3: (a: i32) => i32 | string = g2
print(k3(4))
function f() {
  const g3 = id(inc)
  const k4: (a: i32) => i32 | string = g3
  print(k4(4))
}
f()
