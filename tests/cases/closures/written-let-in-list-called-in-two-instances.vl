// @run
// @log L
// @log 3
// @log L
// @log s
// A `let` first bound to a generic and written with a lambda, put in a list inside a generic
// called at two types, calls each instance's own lambda at that instance's type (D7142).
function other<V>(v: V) { print("O"); print(v) }
function g<T>(x: T) {
  let k = other
  k = (n) => {
    print("L"); print(n)
  }
  const fs = [k]
  fs[0](x)
}
g(3)
g("s")
