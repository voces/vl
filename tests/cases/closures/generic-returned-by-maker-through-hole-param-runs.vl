// @run
// @log 6
// @log 7
// @log 84
// A lambda returning a generic, handed to a hole parameter whose result is called: the
// elaboration closes the lambda at the generic's delivery, and the call site builds the closure
// that instance takes, with one callee or two (D16077, D16133).
function inc(x) { x + 1 }
function run(f) { print(f()(5)) }
run(() => inc)
function run2(f) { print(f()(6)) }
run2(() => inc)
function twice(f) {
  const a = f()(41)
  const b = f()(41)
  return a + b
}
print(twice(() => inc))
