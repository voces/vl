// @log 6
// @log 1
// @log 6
// A record re-pointed at a literal whose function list holds fewer of its set's members is built at
// the binding's record, its list holding the set's ids (D16916).
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function sq(a) { return a * a }
let r = { f: [inc0, dbl] }
r = { f: [dbl] }
print(r.f[0](3))
let s = { f: [inc0, dbl] }
s = { f: [inc0] }
print(s.f[0](3))
let t = { f: [inc0, dbl, sq] }
t = { f: [dbl, sq] }
print(t.f[1](3))
let u = { f: [inc0, dbl, sq] }
u = { f: [sq] }
print(u.f[0](3))
let v = { f: [inc0, dbl], n: 1 }
v = { f: [dbl], n: 2 }
print(v.f[0](3) + v.n)
let w = { f: [inc0, dbl] }
w = { f: [dbl] }
print(w.f[0](3))
print(w.f.length)
function go() {
  let x = { f: [inc0, dbl] }
  x = { f: [dbl] }
  return x.f[0](3)
}
print(go())
