// @log 1
// @log 2.5
// A `const` choice between a capturing nested function and a plain one, handed twice to hole
// parameters, runs as the choice written at each hand does (D15773): to one callee twice, and to
// two callees called at different types, taken both ways.
function both(f) {
  print(f("a"))
  print(f(1))
}
function one(f) { print(f(2.5)) }
function twice(c: boolean, n: i32) {
  function inner(s) {
    print(n)
    return s
  }
  function ask(s) { return s }
  const g = if c { inner } else { ask }
  both(g)
  both(g)
}
twice(true, 9)
function apart(c: boolean, n: i32) {
  function inner(s) {
    print(n)
    return s
  }
  function ask(s) { return s }
  const g = if c { inner } else { ask }
  both(g)
  one(g)
}
apart(true, 9)
apart(false, 4)
