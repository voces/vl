// @run
// @log 77
// @log s
// A function value returned by a call, whose result is a nullable value union with a list-of-
// functions arm, narrows to either arm at its call (D9783).
function makeIt(): () => (() => string | null)[] | i32 | null {
  return () => (77)
}
function makeList(): () => (() => string | null)[] | i32 | null {
  return () => [() => "s"]
}
function show(v: () => (() => string | null)[] | i32 | null) {
  const t0 = v()
  if t0 is i32 { print(t0) }
  else if t0 != null { print(t0[0]() ?? "N") }
  else { print("NULL") }
}
function go() {
  show(makeIt())
  show(makeList())
}
go()
