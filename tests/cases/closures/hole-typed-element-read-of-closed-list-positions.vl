// @run
// @log 6
// @log 10
// @log 16
// @log 10
// @log 8
// An element read whose own type is a hole (a hole function's result mapped into a list) reads at
// the element of the list the IR holds closed.
function inc(a) { return a + 1 }
function dbl(a) { return a * 2 }
function apU(r) { return r(5) }
// a mapped list bound, then indexed
const fs = [inc, dbl]
const out = fs.map(apU)
print(out[0])
print(out[1])
// indexed in arithmetic
print(out[0] + out[1])
// indexed inside a function over its parameter list
function first(xs) { return xs.map(apU)[0] }
print(first([dbl]))
// a nested list's element called
const nested = [[inc]]
function apN(r) { return r[0](7) }
print(nested.map(apN)[0])
