// @emit-error the reassigned function binding `k` holds functions called at more than one argument type
// A call through an alias of a cell's read is a call through the cell, so it and a delivery at another type are one cell's two signatures, refused (D3948) (review of #3501, `rv3501/r08j_min_alias_i32_then_bool_return`).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function mk(): (b: boolean) => void {
  let k = inner
  const flip = () => {
    k = other
  }
  const r = k
  r(3)
  return r
}
mk()(true)
