// @run
// @log 84
// @log 11
// A hole function handed out by a lambda and called through it: the closure's thunk forwards a
// result whose type is the hole's, open until a call binds it, at the result its function returns.
function inc(x) { return x + 1 }
function run(f) { return f()(41) }
print(run(() => inc) + run(() => inc))
function twice(x) { return x * 2 }
function pick(f) { return f()(5) + 1 }
print(pick(() => twice))
