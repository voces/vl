// @run
// @log 4
// @log 3.5
// @log 6
// @log 3.5
// @log 4
// @log 3.5
// @log 6
// @log 3.5
// @log 4
// @log 6
// @log 3
// @log s
// @log 6
// @log 3.5
// @log 7
// @log 1.5
// A list of inner list literals of un-annotated functions holds their ids at both levels, and
// each call through an element dispatches at its own types, at the top level, in a function and
// returned from one, with an inner list written as a name, with generic members, and with inner
// lists of other rows or of fewer members.
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
const u0 = [[inc0]]
print(u0[0][0](3))
print(u0[0][0](2.5))
const ws = [[inc0, dbl]]
print(ws[0][1](3))
print(ws[0][0](2.5))
function go() {
  const u = [[inc0]]
  print(u[0][0](3))
}
go()
const vs = [[dbl, inc0]]
print(vs[0][1](2.5))
function deliver() { return [[inc0, dbl]] }
const rv = deliver()
print(rv[0][1](3))
print(rv[0][0](2.5))
const w0 = [inc0]
const nv = [w0]
print(nv[0][0](3))
function viaName() {
  const w = [inc0, dbl]
  return [w]
}
print(viaName()[0][1](3))
function idg<T>(x: T): T { return x }
function twg<T>(x: T): T { return x }
const gw = [[idg, twg]]
print(gw[0][1](3))
print(gw[0][0]("s"))
const ws2 = [[inc0, dbl], [dbl, inc0]]
print(ws2[1][0](3))
print(ws2[0][0](2.5))
const fewer = [[inc0, dbl], [dbl]]
print(fewer[0][1](3) + fewer[0][0](0))
print(fewer[1][0](0.75))
