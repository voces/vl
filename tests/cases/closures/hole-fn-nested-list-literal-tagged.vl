// @run
// @log 4
// @log 3.5
// @log 6
// @log 3.5
// @log 4
// @log 3.5
// A list of inner list literals of un-annotated functions holds their ids at both levels, and
// each call through an element dispatches at its own types, at the top level and in a function.
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
const u0 = [[inc0]]
print(u0[0][0](3))
print(u0[0][0](2.5))
const ws = [[inc0, dbl]]
print(ws[0][1](3))
print(ws[0][0](2.5))
function go() {
  const u = [[inc0]]
  print(u[0][0](3))
}
go()
const vs = [[dbl, inc0]]
print(vs[0][1](2.5))
