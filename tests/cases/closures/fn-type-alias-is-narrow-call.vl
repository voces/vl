// @run
// @log 2
// @log 2
// Narrowing a nullable closure with `is <alias>` produces something CALLABLE.
//
// `h is F` resolved `F` to the one-member `TyUnion[TyFunc]`, so the narrowed binding was a
// union and `h(1)` failed the checker with `called value is not a function ((i32) => i32)`.
// The alias-of-an-alias (`type G = F`) chained the same wrapper. Only the fully inline
// `h is (i32) => i32` narrowed to a callable. All three spellings now agree.
//
// The `is` type itself is resolved from the parser's SPELLING TREE (D-ISVARTY) — `annTsOf`
// on the `IsExpr` node — so this also exercises the tree route for an alias leaf and for a
// leaf that only the module-merge rename could have produced.

type F = (i32) => i32
type G = F

function inc(a: i32) { a + 1 }

const h: F | null = inc
if h is F { print(h(1)) } else { print(0) }

const k: G | null = inc
if k is G { print(k(1)) } else { print(0) }
