// @run
// @log 41
// @log s
// @log 3
// @log 1
// @log z
// @log 1
// @log z
// @log 3
// @log 4
// @log q
// A generic handed to an un-annotated identity function, directly or through a second one, is
// delivered at the type the calls through the result fix; each call takes its own instance (D5530).
function k<T>(x: T): T { return x }
function fw(f) { return f }
function fw2(f) { return fw(f) }
const v = fw(k)
print(v(41))
function viaTwo() {
  const w = fw2(k)
  print(w("s"))
}
viaTwo()
function annotated() {
  const w: (x: i32) => i32 = fw(k)
  print(w(3))
}
annotated()
const a = fw(k)
const b = fw(k)
print(a(1))
print(b("z"))
function twoHops() {
  const c = fw2(k)
  const d = fw2(k)
  print(c(1))
  print(d("z"))
}
twoHops()
// The same through a generic identity, whose type parameter binds the open signature (D4121,
// D4122).
function id<T>(x: T) { x }
function sel<F>(f: F) { f }
const m = sel(id)
print(m(3))
const n: (x: i32) => i32 = sel(id)
print(n(4))
const o = sel(id)
print(o("q"))
