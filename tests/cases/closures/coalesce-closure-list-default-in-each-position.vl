// @run
// @log 4
// @log 4
// @log 1
// @log n
// @log 1
// @log <n>
// @log [10]
// @log 3
// @log 1
// @log 12
// A `??` over a map read of a list of un-annotated functions, whose default list is built at a
// rep with a hole left open and retagged to the result, in each position: a scalar and a union
// argument, a nested argument, a concat operand, an interpolation hole, a return, an initializer,
// an `if` arm, a `??` operand and a record field.
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
const m = Map()
m["k"] = [inc0, dbl]
function first(k: string) {
  const got = m[k] ?? [inc0]
  return got[0](3)
}
function count(k: string) { return (m[k] ?? [dbl]).length }
function show(u: i32 | string) {
  if u is string { return u } else { return "n" }
}
function id(n: i32) { return n }
function inLet(k: string) {
  const fs = m[k] ?? [dbl, dbl, inc0]
  return fs.length
}
function inIf(k: string, c: boolean) {
  const n = if c { (m[k] ?? [inc0]).length } else { 0 }
  return n
}
print(first("k"))
print(first("z"))
print(count("z"))
print(show(count("k")))
print(id(count("z")))
print("<" + show((m["z"] ?? [inc0])[0](4)) + ">")
print("[\{(m["z"] ?? [dbl])[0](5)}]")
print(inLet("z"))
print(inIf("z", true))
print(((m["z"] ?? null) ?? [dbl])[0](6))
