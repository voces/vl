// @run
// @log 3
// @log s
// The D7840 witness: a list of hole functions returning their own parameter, built and called
// inside a generic at two types.
function a(v) { return v }
function b(v) { return v }
function g<T>(x: T, c: boolean) {
  const fs = [if c { a } else { b }]
  print(fs[0](x))
}
g(3, true)
g("s", false)
