// @run
// @log 3
// @log x
// A list a hole parameter seeds, its slot written with another parameter, called through its
// element while the first parameter is called directly at another type: the list's wider set is
// decided with the parameter's (D15453).
function go(a, b) {
  const r = [a]
  r[0] = b
  print(r[0](3))
  print(a("x"))
}
function same<T>(k: T): T { k }
function dbl(x) { x }
go(same, dbl)
