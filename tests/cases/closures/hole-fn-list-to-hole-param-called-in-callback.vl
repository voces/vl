// @run
// @log 6
// @log 6
// @log 6
// @log 10
// @log 2
// @log 5
// A list of un-annotated functions handed to an un-annotated parameter, whose `.map` / `.filter`
// callback calls its element, instances each function at the callback's call (D9230): handed
// by a `const`, inline, by a re-pointed `let`, forwarded through a second parameter, and read
// behind an early return.
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function sq(a) { return a * a }
function take(a) { print(a.map((f) => f(3))[1]) }
const g = [inc0, dbl]
take(g)
take([inc0, dbl])
let h = [sq, inc0]
h = [sq, dbl]
function fwd(b) { take(b) }
fwd(g)
function last(a) { print(a.map((f) => f(5))[1]) }
last(h)
function keep(a) { print(a.filter((f) => f(2) > 3).length) }
keep([inc0, dbl, sq])
function early(a) {
  if a.length == 0 { return 0 }
  return a.map((f) => f(4))[0]
}
print(early(g))
