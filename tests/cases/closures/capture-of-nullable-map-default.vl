// @run
// @log 102
// @log 100
// A closure reads its capture of an un-annotated `??` over a nullable map as the map (D3392).
function mk(k: i32): Map<string, i32> {
  const m: Map<string, i32> = Map()
  m["a"] = k
  m
}
function h(n: i32) {
  let o: Map<string, i32> | null = null
  if n == 2 { o = mk(100) }
  const v = o ?? mk(102)
  const c = () => (v["a"] ?? 0)
  print(c())
}
h(0)
h(2)
