// @run
// @log 1
// @log 1
// @log 2.5
// @log 2.75
// @log 1
// @log 2.5
// A forwarded hole function handed to a one-element list whose element another list shares at
// a different key: the slot the element never calls takes the type of the slot handed the same
// read (D13200).
function add(a, b) { return a + b }
function apply2(g, s) { print(g(s, s)) }
function apply4(g, s) { print(g(s, 2)) }
function inner(k, h) {
  for f in [apply2] { f(h, k) }
}
inner(0.5, add)
function innerThree(k, h) {
  for f in [apply2, apply4] { f(h, k) }
}
innerThree(0.5, add)

// The other element alone.
function inner4(k, h) {
  for f in [apply4] { f(h, k) }
}
inner4(0.75, add)
function innerBoth(k, h) {
  for f in [apply2, apply4] { f(h, k) }
}
innerBoth(0.5, add)
