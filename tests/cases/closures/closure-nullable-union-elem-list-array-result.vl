// @run
// @log OTHER
// @log 7
// @log NULL
// @log 1.5
// @log NULL
// @log 2
// @log 13131313131
// @log NULL
// @log 5
// @hint redundant type annotation: `v` is inferred as `() => ((i32 | boolean)[] | null)[]`
// @hint redundant type annotation: `d` is inferred as `((i32 | boolean)[] | null)[]`
// A closure whose RESULT is an array of NULLABLE BOX-ELEMENT LISTS
// (`() => ((i32 | boolean)[] | null)[]`) — the inner list's elements ride the union
// `{tag, payload}` box (element kind 2), so the OUTER element is that box-list's
// wrapper kept nullable (`nullArrayArrElem`'s kind-9 nested-ref-array inner). The bare
// lambda `() => ([[false]])` self-classified a plain `boolean[][]` reflist keyed on a
// DIFFERENT `$fnsig` slot than the annotation-side value call's `(…|null)[]` box-list
// slot — divergent reflist tokens, a cast-failure TRAP in the narrow. Fixed by widening
// `nulListElemListRetName` past its scalar-PRIM leaf gate to admit a value-union
// (`elemValueUnionListRetName`) or variant-box (`elemVariantBoxListRetName`) inner
// element; the existing adoption / recorder / `synthRetAnnots` (`parenUnionArrElemName`)
// arms then pin the lambda's `fnRet`. The named-fn value spelling and the direct
// `((i32|boolean)[]|null)[]` binding already lowered this rep. Fuzz post-#1063 sweep
// branching leg. The value-union sibling of closure-nullable-list-elem-array-result.vl.
function makeIt(): () => ((i32 | boolean)[] | null)[] {
  return () => ([[false]])
}

function useB(p: () => ((i32 | boolean)[] | null)[]) {
  const t0 = p()[0]
  if t0 != null {
    const t1 = t0[0]
    if t1 is i32 { print(t1) } else { print("OTHER") }
  } else {
    print("NULL")
  }
}

function useF(p: () => ((f64 | string)[] | null)[]) {
  const t0 = p()[0]
  if t0 != null {
    const t1 = t0[0]
    if t1 is f64 { print(t1) } else { print("STR") }
  } else {
    print("NULL")
  }
}

// A VARIANT-BOX inner element (an inline-struct arm + scalar/string siblings) shares the
// same kind-2 box, so it rides the same pin.
function useV(p: () => ((i64 | string | {q: i64})[] | null)[]) {
  const t0 = p()[1]
  if t0 != null {
    const t1 = t0[0]
    if t1 is i64 { print(t1) } else { print("OTHER") }
  } else {
    print("NULL")
  }
}

function go() {
  // The fuzz draw's shape: a named factory RETURNING the bare lambda, read back through
  // the `!= null` / `is i32` narrow.
  const v: () => ((i32 | boolean)[] | null)[] = makeIt()
  const t0 = v()[0]
  if t0 != null {
    const t1 = t0[0]
    if t1 is i32 { print(t1) } else { print("OTHER") }
  } else {
    print("NULL")
  }
  // Param position: non-null, all-`[null]`, and a mixed body.
  useB(() => ([[7, true]]))
  useB(() => ([null]))
  useF(() => ([[1.5], null]))
  useF(() => ([null, ["s"]]))
  // The nullable element's non-null arm keeps its `.length`.
  const w: {a: () => ((i32 | boolean)[] | null)[], z: i64} = {
    a: () => ([[1, false], null]),
    z: 3,
  }
  const t = w.a()[0]
  if t != null { print(t.length) } else { print("NULL") }
  useV(() => ([null, [13131313131, "hi"]]))
  useV(() => ([null, null]))
  // A DIRECT binding of the same shape (the already-lowering spelling) stays sound.
  const d: ((i32 | boolean)[] | null)[] = [[1, 2, 3, true, false], null]
  const d0 = d[0]
  if d0 != null { print(d0.length) } else { print("NULL") }
}

go()
