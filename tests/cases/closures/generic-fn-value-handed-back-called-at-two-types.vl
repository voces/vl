// @run
// @log 41
// @log s
// @log 1.5
// @log true
// @log 3
// @log q
// @log 4
// @log 7
// @log t
// A generic handed back through hole functions or a generic identity, and called through the
// result at two types: each call takes the generic's own instance (D15490).
function k<T>(x: T): T { return x }
function fw(f) { return f }
function fw2(f) { return fw(f) }
function fw3(f) { return fw2(f) }
// Two hops, then three.
const v = fw2(k)
print(v(41))
print(v("s"))
const w = fw3(k)
print(w(1.5))
print(w(true))
// Through a generic identity, beside a binding that annotates its own instance.
function id<T>(x: T) { x }
function sel<F>(f: F) { f }
const m = sel(id)
print(m(3))
print(m("q"))
const n: (x: i32) => i32 = sel(id)
print(n(4))
// One hop at two types, beside a two-hop delivery into an annotated binding.
const u = fw(k)
print(u(7))
const a: (x: string) => string = fw2(k)
print(a("t"))
