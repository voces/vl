// @run
// @log 6
// @log 2.5
// @log 6
// @log 2.5
// @log 1
// @log 2
// One list of two un-annotated functions mapped at two argument types: each call through an
// element calls that member at the call's own arguments, bound, returned or filtered (D9500).
function inc(a) { return a + 1 }
function dbl(a) { return a * 2 }
const fs = [inc, dbl]
print(fs.map((f) => f(3))[1])
print(fs.map((f) => f(1.25))[1])
function deliver() { return [inc, dbl] }
const v = deliver()
print(v.map((f) => f(3))[1])
print(v.map((f) => f(1.25))[1])
print(fs.filter((f) => f(3) > 5).length)
print(fs.filter((f) => f(1.25) > 2.0).length)
