// @emit-error unsupported argument type for `f` in a call to `run`
// A hole function no call instances, handed to a parameter the callee compares with itself: a
// comparison reads the value, so a stub served there would be observed, and the default a
// defaulted parameter would take is never observable (D4551). The callee that only prints, or
// holds the value unread, runs: `uncalled-hole-fn-to-unread-param.vl` (D6881).
function apply3(g) { print(g(1, 2)) }
function run(f) { print(f == f) }
run(apply3)
