// @error cannot assign (i32) => void to `k`: it keeps the generic type of its initializer
// A nullable function narrowed by a test is refused as a cell's value rather than stored with its nullable representation (review of #3498, `rv3498/round5/f05_nullable_fn_narrowed_into_cell_main`).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function third<Z>(z: Z) { print("T"); print(z) }
function main() {
  let k = inner
  const f: ((n: i32) => void) | null = other
  const w = () => {
    if f != null { k = f }
  }
  k(1)
  w()
  k(1)
}
main()
