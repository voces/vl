// @run
// @log 4
// @warning Unused variable `r1`
// @log 12
// @log 4
// @log 4
// A nested function or `const` lambda nothing names, whose call through a binding takes a
// signature the live calls do not, never runs: it is not lowered, so the binding keeps the one
// signature its live calls give it (D3864).
const e = (y) => y + y + y
const g = (y) => y
function byFunction(x: string, n: i32) {
  let d1 = e
  function r1() { d1(x) }
  d1 = g
  print(d1(n))
}
byFunction("a", 4)
function readerWriter(x: string, n: i32) {
  let d1 = e
  function r1() { d1(x) }
  function rw() {
    const r = d1(n)
    d1 = g
    r
  }
  print(rw())
}
readerWriter("a", 4)
function byLambda(x: string, n: i32) {
  let d1 = e
  const r1 = () => d1(x)
  d1 = g
  print(d1(n))
}
byLambda("a", 4)
function deadInDead(x: string, n: i32) {
  let d1 = e
  function o() {
    function r1() { d1(x) }
    r1()
  }
  d1 = g
  print(d1(n))
}
deadInDead("a", 4)
