// @error cannot infer type parameter `U`: `pr`'s return type names it and no parameter does
// A `.filter` predicate whose result is a type parameter no parameter names is refused as its
// direct call is, even over an empty list (D9073).
function pr<T, U>(t: T): U {
  while true {}
}
const e: i32[] = []
print(e.filter(pr).length)
