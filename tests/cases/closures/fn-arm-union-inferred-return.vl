// @run
// @log 8
// @log s
// @log 3
// @log 2
// @log 11
// @log 0
// @log 8
// @log n
// @log 8
// @log s
// @log 6
// A function whose inferred return is a union with a function member, or a function type
// with `null`, lowers as its annotated spelling does: called, forwarded, collected, passed
// to an un-annotated parameter, and through a generic identity (D4349).

function r(b: boolean) {
  if b { return (x: i32) => x + 1 }
  return "s"
}
function two(b: boolean) {
  if b { return (x: i32) => x + 1 }
  return (x: string) => x.length
}
function cap(n: i32) {
  if n > 0 { return (x: i32) => x + n }
  return n
}
function nul(b: boolean) {
  if b { return (x: i32) => x + 1 }
  return null
}
function fwd(b: boolean) { return r(b) }
function t(a) {
  if a is (x: i32) => i32 { print(a(7)) } else { print(a) }
}
function idT<T>(x: T): T { x }

const v = r(true)
if v is (x: i32) => i32 { print(v(7)) }
const w = r(false)
if w is (x: i32) => i32 { print(w(7)) } else { print(w) }
const s = two(false)
if s is (x: string) => i32 { print(s("abc")) }
const i = two(true)
if i is (x: i32) => i32 { print(i(1)) }
for f in [cap(1), cap(0)] {
  if f is (x: i32) => i32 { print(f(10)) } else { print(f) }
}
const n = nul(true)
if n != null { print(n(7)) }
if nul(false) == null { print("n") }
t(fwd(true))
t(fwd(false))
const g = idT(r(true))
if g is (x: i32) => i32 { print(g(5)) }
