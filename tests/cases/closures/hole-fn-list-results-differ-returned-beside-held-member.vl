// @run
// @log 4
// @log 4
// @log 4.5
// A returned list's records hold functions of different results, and a module `const` copy of
// one of them is called: the call is direct, and the copy holds the member's id where the set is
// tagged (D15926).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function pick(b: boolean) {
  if b { return [{ f: inc0 }] }
  return [{ f: half }]
}
print(pick(true)[0].f(3))
const g = inc0
print(g(3))
print(g(3.5))
