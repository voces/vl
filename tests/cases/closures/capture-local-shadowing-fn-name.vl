// @run
// @log 11
// @log 11
// @log 11
// @log 100
// @hint redundant type annotation: `tag` is inferred as `i32`
// @hint redundant type annotation: `viaLambda` is inferred as `i32`
// @hint redundant type annotation: `nestedAddTag` is inferred as `i32`
// @hint redundant type annotation: `viaNested` is inferred as `i32`
// @hint redundant type annotation: `viaParam` is inferred as `i32`
// @hint redundant type annotation: `control` is inferred as `i32`
// THE FUNCTION-NAME HALF of the capture-shadowing defect — the sibling of
// `capture-local-shadowing-global.vl`, and the louder one: on master these emit an INVALID
// MODULE (`failed to compile: wasm[0]::function[N]::inner`), not a wrong answer.
//
// `capRecord` exempted a name from capture whenever `fnIndexOf(name) >= 0`, because a
// top-level function name denotes a function index and is addressable directly. True —
// unless an enclosing frame binds a LOCAL of that name, in which case the identifier
// denotes the local, and dropping it left the lifted body reading a function reference
// where the local's value type belonged.
//
// This half was already on the record from the other side: `compiler/lint.vl` spells its
// `stmtDiverges` helper uniquely and says why — a bare `diverges` would collide with a
// LOCAL of that name in `typecheck.vl`, and the seed's capture analysis then failed with
// "captured variable not found in enclosing frame". The compiler was routing around its own
// bug in its own source.
//
// The last case is the CONTROL that keeps the guard honest: when the name is actually
// CALLED and no enclosing frame binds it, it is still the function, and the exemption must
// still fire.
//
// The closures are named distinctly for the reason spelled out in the sibling case: lifted
// functions are keyed by name FIRST-WINS in `buildFnMap`, a separate live defect that a
// shared `inner` would trip.
function tag(): i32 { return 99 }

function viaLambda(): i32 {
  const tag = 10
  const addTag = (x: i32) => x + tag
  return addTag(1)
}
print(viaLambda()) // 11

function viaNested(): i32 {
  const tag = 10
  function nestedAddTag(x: i32): i32 { return x + tag }
  return nestedAddTag(1)
}
print(viaNested()) // 11

function viaParam(tag: i32): i32 {
  const paramAddTag = (x: i32) => x + tag
  return paramAddTag(1)
}
print(viaParam(10)) // 11

// CONTROL — nothing shadows `tag`, so the lambda CALLS the function and captures nothing.
function control(): i32 {
  const callTag = (x: i32) => x + tag()
  return callTag(1)
}
print(control()) // 100
