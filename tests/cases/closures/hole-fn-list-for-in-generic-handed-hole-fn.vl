// @log z
// @log 30
// @log 0.75
// @log 3
// @log 4
// @log true
// @log 2.5
// A list, an `if` join and an alias of hole functions inside a generic, each handed a hole
// function: every instance of the generic types the callee at the elements' one signature (D7843).
function add(a, b) { return a + b }
function apply2(g) {
  print(g(1, 2))
  print(g(1.5, 2.5))
}
function apply3(g) {
  print(g(10, 20))
  print(g(0.5, 0.25))
}
function run<T>(x: T) {
  const fs = [apply2, apply3]
  for f in fs { f(add) }
  const c = if x == x { apply2 } else { apply3 }
  c(add)
  print(x)
}
function both<A, B>(a: A, b: B) {
  const gs = [apply3, apply2]
  const hs = gs
  for f in hs { f(add) }
  print(a)
  print(b)
}
run(1)
run("z")
both(true, 2.5)
