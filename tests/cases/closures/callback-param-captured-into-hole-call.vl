// @run
// @log 1
// @warning Unused variable `dA` (prefix with `_` to suppress, or remove it)
// @warning Unused variable `h` (prefix with `_` to suppress, or remove it)
// A `filter` callback keyed at the row `J` its list's build is stored at hands its parameter,
// captured by a closure, to an un-annotated function: the read is stored at the row, so the
// callee is instanced there (D17660).
type J = { f: i32 | null }
function mk2() { return { f: null } }
const dA: J = mk2()
const src = [mk2()]
function takeAny(x) { return x.f == null }
const r = src.filter((y) => {
  const b = () => takeAny(y)
  b()
  const h = { w: y }
  return true
})
print(r.length)
