// @run
// @log 1
// @log 5
// @log 2
// @log 3
// @log 6
// @log 8
// @log 4
// @hint Intentionally-unused variable `_clr` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_clr` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_clr` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_clr` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_rb` (leading `_` marks it unused)
// A name a closure writes lives in a shared cell, so a write to it stores through `cell[0]`. The
// null strip a non-null write gives the name, and the join after an `if` that fills it, both
// have to land on the cell's read key, or the reads after them take the box for the value
// (D3288, D3285). The closures are never called, so each narrowing stands.
function nn(v: i32): i32 | null {
  if v < 0 { return null }
  return v
}

// A straight-line write.
function line(k: i32) {
  let x = nn(k)
  const _clr = () => {
    x = null
  }
  x = 0
  return x + 1
}
print(line(3))

// A captured parameter.
function param(x: i32 | null) {
  const _clr = () => {
    x = null
  }
  x = 4
  return x + 1
}
print(param(null))

// Both arms fill.
function both(k: i32, c: boolean) {
  let x = nn(k)
  const _clr = () => {
    x = null
  }
  if c { x = 1 } else { x = 2 }
  return x + 1
}
print(both(3, true))
print(both(3, false))

// A fill on the miss arm.
function miss(k: i32) {
  let x = nn(k)
  const _clr = () => {
    x = null
  }
  if x == null { x = 5 }
  return x + 1
}
print(miss(-1))
print(miss(7))

// A field of a captured receiver.
function path(o: { v: i32 | null }) {
  let b = o
  const _rb = () => {
    b = { v: null }
  }
  if b.v == null { b.v = 3 }
  return b.v + 1
}
print(path({ v: null }))
