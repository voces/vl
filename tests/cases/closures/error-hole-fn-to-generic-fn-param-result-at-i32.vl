// @error f64 doesn't fit in i32
// `R` bound by an un-annotated function's body at the call is that body's result, so `half`'s
// `f64` does not fit an `i32` destination (D8943).
function half(a) { return a / 2.0 }
function apply<T, R>(h: (T) => R, x: T): R { return h(x) }
const r: i32 = apply(half, 3)
print(r)
