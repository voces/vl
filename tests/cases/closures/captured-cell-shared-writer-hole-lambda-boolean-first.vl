// @run
// @log I
// @log true
// @log L
// @log true
// @log I
// @log 1
// @log L
// @log 1
// A hole lambda declared in a writer closure inside a generic body is each instance's own: every
// instance gets its own writer, lambda body and dispatch (per-instance-identity-2026-11.md, 4b-i).
function inner<U>(u: U) { print("I"); print(u) }
function a<T>(x: T) {
  let k = inner
  const w = () => {
    k = (u) => {
      print("L"); print(u)
    }
  }
  k(x)
  w()
  k(x)
}
a(true)
a(1)
