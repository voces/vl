// @run
// A list literal no binding holds, mapped by a callback, is an anonymous binding: the
// elaboration's stamp is the one answer for its elements' instance and its callback's
// parameter, as a bound list's binding is (D17771).
function inc6(a) { return a + 1 }
function apN(r) { return r[0](5) }
print([[inc6]].map(apN)[0])
print([[inc6]].map((r) => apN(r))[0])
const ys = [[inc6]].map(apN)
print(ys[0])
const xs = [[inc6]]
print(xs.map(apN)[0])
// @log 6
// @log 6
// @log 6
// @log 6
