// @run
// A list literal of a hole function no binding holds, mapped by a callback, is read at the value
// its holder class closes, and the callback's parameter at its element, as a bound list is.
function inc6(a) { return a + 1 }
function apN(r) { return r[0](5) }
print([[inc6]].map(apN)[0])
print([[inc6]].map((r) => apN(r))[0])
const ys = [[inc6]].map(apN)
print(ys[0])
const xs = [[inc6]]
print(xs.map(apN)[0])
// @log 6
// @log 6
// @log 6
// @log 6
