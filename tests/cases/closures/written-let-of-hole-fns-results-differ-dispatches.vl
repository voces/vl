// @run
// @hint Intentionally-unused parameter `_a` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_t` (leading `_` marks it unused)
// @log s
// @log 4
// @log s
// @log 4
// @log 4
// @log s
// @log 6
// @log s!
// @log 5
// @log 1
// @log s
// @log s
// @log s
// @log 4
// @log s
// @log 1
// D16064: a call through a re-pointed `let` of un-annotated functions whose results differ
// dispatches on the function the binding holds, and its result is the join of theirs: called
// directly, returned and called, with three members, narrowed with `is`, inside a loop, from a
// closure that captured the binding, and over generic members.
function inc(a) { return a + 1 }
function str(_a) { return "s" }
function dbl(a) { return a * 2 }
function idg<T>(t: T) { return t }
function one<T>(_t: T) { return 1 }
function run(c: boolean) {
  let f = inc
  if c { f = str }
  print(f(3))
}
function sel(c: boolean) {
  let f = inc
  if c { f = str }
  return f
}
function three(n: i32) {
  let f = inc
  if n == 1 { f = str }
  if n == 2 { f = dbl }
  print(f(3))
}
function narrow(c: boolean) {
  let f = inc
  if c { f = str }
  const r = f(3)
  if r is string { print(r + "!") } else { print(r + 1) }
}
function loop() {
  let f = inc
  for i in 0 until 3 {
    print(f(i))
    f = str
  }
}
function captured(c: boolean) {
  let f = inc
  const k = () => f(3)
  if c { f = str }
  print(k())
}
function gen(c: boolean) {
  let h = idg
  if c { h = one }
  print(h("s"))
}
run(true)
run(false)
print(sel(true)(3))
print(sel(false)(3))
three(0)
three(1)
three(2)
narrow(true)
narrow(false)
loop()
captured(true)
captured(false)
gen(false)
gen(true)
