// @run
// @log 95
// A function value returned by a call, whose result is a value union of a list of functions
// and a scalar, narrows at its call (D9783).
function n(): (() => i32)[] | i32 { 95 }
function mk(): () => (() => i32)[] | i32 { return n }
const v = mk()
const t = v()
if t is i32 { print(t) } else { print("OTHER") }
