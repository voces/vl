// @error cannot store 'half' in 'rs[].f': called at (i32) it returns f64, where 'inc0', also stored in it, returns i32
// A record field reached through a `.map` callback's element is judged as `rs[i].f(…)` is (D9172).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const rs = [{ f: inc0 }, { f: half }]
print(rs.map((r) => r.f(3))[0])
