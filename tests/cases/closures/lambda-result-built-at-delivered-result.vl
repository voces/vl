// @run
// @log 14.5
// @log 6
// @log true
// @log 6
// An un-annotated lambda delivered to a closed function type builds its result at the delivered
// result, as its annotated twin does: a record field union, an `i64` result in a record arm of a
// union, a union of function types, and an `i64` result returned directly (D16310).
const f: () => {z: f64[] | i32} = () => { z: [14.5] }
const r = f().z
if r is f64[] { print(r[0]) } else { print("OTHER") }
const g: {a: i64[], f: () => i64} | f64 = { a: [367], f: () => 6 }
if g is {a: i64[], f: () => i64} { print(g.f()) }
const h: {f: (() => boolean | i32) | {w: i32}} | i64 = { f: () => true }
if h is {f: (() => boolean | i32) | {w: i32}} {
  const t1 = h.f
  print(t1 is () => boolean | i32)
}
const k: () => i64 = () => 6
print(k())
