// @run
// @log 3
// @log 4
// A record field read of a generic, delivered to an annotated function binding, takes the
// binding's instance, from a bound record and straight from a literal (D4125).
function inner<U>(u: U) { print(u) }
const r = { f: inner }
const j: (u: i32) => void = r.f
j(3)
const k: (u: i32) => void = { f: inner }.f
k(4)
