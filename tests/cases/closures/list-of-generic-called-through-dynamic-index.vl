// @run
// @log I
// @log 3
// @log 1
// @log I
// @log true
// @info `i` is never reassigned; use `const` instead of `let`
// A second list of the same generic, called through a non-constant index beside a length read,
// takes its own instance rather than the first list's (D4301).
function inner<U>(u: U) { print("I"); print(u) }
function main() {
  const gs = [inner]
  gs[0](3)
  const fs = [inner]
  print(fs.length)
  let i = 0
  fs[i](true)
}
main()
