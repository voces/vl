// @run
// @warning Unused parameter
// @log x2
// @log 2
// D10701 through a choice of hole functions on a parameter, called at two function types.
import { toString } from "std:fmt"

function cat(a, b) { return a + b.toString() }
function snd(a, b) { return b }
function apply2(g) { print(g("x", 2)) }
function apply3(g) { print(g("y", 20)) }
function main(k: boolean) {
  const h = if k { apply3 } else { apply2 }
  h(cat)
  h(snd)
}
main(false)
