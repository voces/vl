// @run
// A call through a value-`if` of two hole relays, handed a hole function, is typed through both
// sets: each relay's body calls the handed function through its own set (D16209).
function add(a, b) {
  a + b
}
function ap2(g) {
  g(1, 2) + g("ab", "c").length
}
function ap3(g) {
  g(10, 20) + g("x", "y").length
}
function pick(c: boolean) {
  const f = if c { ap2 } else { ap3 }
  f(add)
}
const m = Map()
m["k"] = pick(true) + pick(false)
const mv = m["k"]
if mv != null { print(mv) }
const n: i32 = pick(false)
print(n)
// @log 38
// @log 32
