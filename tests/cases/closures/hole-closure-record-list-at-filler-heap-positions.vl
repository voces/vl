// @run
// @log 5
// @log 6
// @log s
// @log 7
// @log t
// A list of records, each holding closures whose parameter a generic leaves open, bound and
// returned at its hole rep, stands on the heap of the concrete record that fills it: at one
// instance, at two, and with two closures in the field.
function inc0(a) { return a + 1 }
function one<T>(x: T) {
  const rs = [{ fs: [inc0], x: x }]
  return rs
}
function two<T>(x: T) {
  const rs = [{ fs: [inc0], x: x }]
  return rs
}
function pair<T>(x: T) {
  const rs = [{ fs: [inc0, inc0], x: x }]
  return rs
}
print(one(5)[0].x)
print(two(6)[0].x)
print(two("s")[0].x)
print(pair(7)[0].x)
print(pair("t")[0].x)
