// @run
// @log true|false
// @log 30
// @log 30
// @log got
// @log 9
// @log 42
// @log 25
// @log 7
// @log 12
// @log true
// @log -1
// @log 42
// @log true
// @hint Intentionally-unused parameter
// @hint redundant type annotation
// A closure writes a local of every init kind (D2285): each is boxed into a length-1 cell
// whatever its init, typed at the binding's declared or inferred type, so a read after the
// call sees the write. `??` over a boxed nullable reads the declared type, since the closure
// may have written the cell after any narrowing the maker saw.
type P = { x: i32, y: i32 }
type Q = { x: i32 }
function f(g: (i32) => i32): i32 { g(1) }

function mk(): () => boolean {
  let on = false
  return () => {
    on = !on
    on
  }
}
const t = mk()
print("\{t()}|\{t()}")

function structAnn(): i32 {
  let p: P = { x: 1, y: 2 }
  f((_k) => {
    p = { x: 10, y: 20 }
    0
  })
  p.x + p.y
}
print(structAnn())

function structInferred(): i32 {
  let p = { x: 1, y: 2 }
  f((_k) => {
    p = { x: 10, y: 20 }
    0
  })
  p.x + p.y
}
print(structInferred())

function nulString(): string {
  let s: string | null = null
  f((_k) => {
    s = "got"
    0
  })
  s ?? "none"
}
print(nulString())

function nulStruct(): i32 {
  let q: Q | null = null
  f((_k) => {
    q = { x: 9 }
    0
  })
  if q != null { q.x } else { -1 }
}
print(nulStruct())

function nulInt(): i32 {
  let n: i32 | null = null
  f((_k) => {
    n = 42
    0
  })
  n ?? -1
}
print(nulInt())

function listReassign(): i32 {
  let xs: i32[] = [1]
  f((_k) => {
    xs = [4, 5]
    0
  })
  xs.length * 10 + xs[1]
}
print(listReassign())

function closureLocal(): i32 {
  let op = (x: i32) => x + 1
  f((_i) => {
    op = (x: i32) => x + 5
    0
  })
  op(2)
}
print(closureLocal())

function fromParam(a: i32): i32 {
  let n = a
  f((_k) => {
    n = n * 3
    0
  })
  n
}
print(fromParam(4))

function namedNested(): boolean {
  let done = false
  function mark() { done = true }
  mark()
  done
}
print(namedNested())

function unwritten(): i32 {
  let q: Q | null = null
  f((k) => {
    if k > 5 { q = { x: 9 } }
    0
  })
  if q != null { q.x } else { -1 }
}
print(unwritten())

// a closure whose value is the write into a boxed value-union cell.
function tailWrite(): i32 {
  let n: i32 | null = null
  const set = () => {
    n = 42
  }
  set()
  n ?? -1
}
print(tailWrite())

if true {
  let hit = false
  f((_k) => {
    hit = true
    0
  })
  print(hit)
}
