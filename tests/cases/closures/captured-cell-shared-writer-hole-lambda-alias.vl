// @run
// @log I
// @log 1
// @log L
// @log 1
// @log I
// @log true
// @log L
// @log true
// A hole lambda declared in the generic body and written from a closure runs at two types: each
// walk of `a` banks the lambda's pins under its own instance (per-instance-identity-2026-11.md, M5).
function inner<U>(u: U) { print("I"); print(u) }
function a<T>(x: T) {
  let k = inner
  const h = (u) => {
    print("L"); print(u)
  }
  const w = () => {
    k = h
  }
  k(x)
  w()
  k(x)
}
a(1)
a(true)
