// @run
// @warning Unused variable `flip` (prefix with `_` to suppress, or remove it)
// @log I
// @log 1
// @log I
// @log s
// A capture cell seeded with a generic function and called at two argument types holds one
// closure per call type (D3939, D3975).
function inner<U>(u: U) {
  print("I")
  print(u)
}
function other<V>(v: V) {
  print("O")
  print(v)
}
function main() {
  let k = inner
  const flip = () => {
    k = other
  }
  k(1)
  k("s")
}
main()
