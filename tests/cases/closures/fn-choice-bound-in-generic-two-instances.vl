// @run
// @log 6
// @log abab
// @log 2.5
// @log 6
// @log abab
// @log 8
// @log xx
// A `const` choosing generic functions inside a generic body, handed to a generic parameter,
// takes each instance's own type when the body is instanced at two types (D9220).
function idg<T>(t: T): T { return t }
function kg<T>(t: T): T { return t + t }
function app<T>(g: (x: T) => T, v: T): T { return g(v) }
function run<U>(v: U, c: boolean): U {
  const h = if c { kg } else { idg }
  return app(h, v)
}
function runm<U>(v: U, n: i32): U {
  const h = match n {
    0 => kg
    _ => idg
  }
  return app(h, v)
}
function mapped<U>(v: U): U {
  const h = if [1].length > 0 { kg } else { idg }
  return [v].map(h)[0]
}
print(run(3, true))
print(run("ab", true))
print(run(2.5, false))
print(runm(3, 0))
print(runm("ab", 0))
print(mapped(4))
print(mapped("x"))
