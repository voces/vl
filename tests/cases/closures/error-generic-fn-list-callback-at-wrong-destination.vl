// @error cannot assign i32[] to 'ys' of type string[]
// A declared generic handed to `.map` gives the list of its result at the element, so an `i32`
// list mapped by an identity is refused at a `string[]` destination (D9070).
function idg<T>(t: T): T { return t }
const ys: string[] = [3].map(idg)
print(ys.length)
