// @run
// @log 3
// @log 1.5
// @log 3
// @log 1.5
// @log 3
// @log 1.5
// @log 7
// An un-annotated map of generic functions with different results, delivered whole at a closed map
// whose value's result is their union, holds each function at that slot (D17756): pushed, in a
// list literal, and bound to an annotated `let`. A single member of the same shape is built there too.
function __id<T>(x: T): T { return x }
function __half<T>(x: T): f64 { return x / 2.0 }
type FM = {[string]: (x: i32) => i32 | f64}
const a = Map()
a.set("a", __id)
a.set("b", __half)
const xs: FM[] = []
xs.push(a)
const ga = xs[0].get("a")
if ga != null { print(ga(3)) }
const gb = xs[0].get("b")
if gb != null { print(gb(3)) }
const b = Map()
b.set("a", __id)
b.set("b", __half)
const ys: FM[] = [b]
const ha = ys[0].get("a")
if ha != null { print(ha(3)) }
const hb = ys[0].get("b")
if hb != null { print(hb(3)) }
const c = Map()
c.set("a", __id)
c.set("b", __half)
const z: FM = c
const za = z.get("a")
if za != null { print(za(3)) }
const zb = z.get("b")
if zb != null { print(zb(3)) }
const d = Map()
d.set("a", __id)
const ws: FM[] = []
ws.push(d)
const wa = ws[0].get("a")
if wa != null { print(wa(7)) }
