// @run
// @log w
// @log 3
// @log w
// @log v
// @log 3
// @info `b` is never reassigned; use `const` instead of `let`
// @info `b2` is never reassigned; use `const` instead of `let`
// @info `b` is never reassigned; use `const` instead of `let`
// @info `b2` is never reassigned; use `const` instead of `let`
// A parameter's un-annotated copy stored in a record and called through the field, beside a
// second copy called at another type, takes the field's call key (D6884).
function same<T>(k: T): T { k }
function mid<F, G>(a: G) {
  let b = a
  let b2: G = a
  const r = { f: b }
  print(r.f("w"))
  print(b2(3))
}
mid(same)
function mid2<F, G>(a: G) {
  let b = a
  let b2: G = a
  const r = { f: b }
  print(r.f("w"))
  print(r.f("v"))
  print(b2(3))
}
mid2(same)
