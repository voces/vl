// @run
// @log 7
// @log -5
// @log 7
// @log 7
// @log 7.5
// @log 2
// @log 8
// @hint redundant type annotation: `viaGet` is inferred as `i32` — remove it to lean on inference

// An un-annotated `const g = m.get(k)` (or `m[k]`) over a scalar-valued map, captured by a
// lambda and narrowed inside it, reads the unboxed scalar there: the lambda's result is the
// scalar, not the box the binding holds. D3757.
const m: Map<i32, i32> = Map()
m[3] = 7

function viaGet(x: i32): i32 {
  const g = m.get(x)
  const f = () => if g == null { -5 } else { g }
  f()
}
print(viaGet(3))
print(viaGet(4))

function viaIndex(x: i32) {
  const g = m[x]
  const f = () => if g != null { g } else { -5 }
  f()
}
print(viaIndex(3))

const ms: Map<string, i32> = Map()
ms["a"] = 7
function viaStringKey(k: string) {
  const g = ms.get(k)
  const f = () => {
    if g == null { return -5 }
    return g
  }
  f()
}
print(viaStringKey("a"))

const mf: Map<i32, f64> = Map()
mf[3] = 7.5
function viaF64(x: i32) {
  const g = mf.get(x)
  const f = () => if g == null { -5.0 } else { g }
  f()
}
print(viaF64(3))

// A lambda that escapes its frame, and one nested inside another.
function mk(x: i32) {
  const g = m.get(x)
  () => if g == null { -5 } else { g }
}
const a = mk(3)
const b = mk(9)
print(a() + b())

function nested(x: i32) {
  const g = m.get(x)
  const f = () => {
    const h = () => if g == null { -5 } else { g }
    h() + 1
  }
  f()
}
print(nested(3))
