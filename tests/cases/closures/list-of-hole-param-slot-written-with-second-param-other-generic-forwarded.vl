// @run
// @log 1
// @log 5
// The first generic handed on through a forwarding hole parameter: the forwarder binds it at the
// set the list joins, not at one instance per signature, and the call dispatches by tag (D15573).
function id<T>(x: T): T { x }
function id2<U>(x: U): U { x }
function use(ys) { print(ys.length) }
function take(a, b) {
  const xs = [a]
  xs[0] = b
  use(xs)
  print(xs[0]("abc").length + xs[0](2))
}
function fwd(f) { take(f, id2) }
fwd(id)
