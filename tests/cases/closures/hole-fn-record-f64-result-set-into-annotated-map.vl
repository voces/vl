// @run
// @log 0.5
// A record literal holding an un-annotated function of `i32` result, set into a map whose record
// type's field returns `f64`, adapts its field as `const r: R = { f: inc0 }` does (D3073).
type R = { f: (a: i32) => f64 }
function inc0(a) { return a + 1 }
const m: Map<string, R> = Map()
m.set("a", { f: inc0 })
const x = m.get("a")
if x != null { print(x.f(3) / 8) }
