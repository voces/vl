// @check
// @hint redundant type annotation: `a` is inferred as `i32[]` — remove it to lean on inference
// D2394: only a literal built at the place's type makes an assignment yield the place's type.
// A named list accepted through the readonly converting copy keeps its own, so `(c = a)` is
// an `i32[]` here: `h` accepts it, and `r[0] / 2` is integer division. Emitting both is D2398.
let c: readonly f64[] = [1.5]
const a: i32[] = [1, 2]
function h(v: i32[]) { v.length }
print(h(c = a))
const r = (c = a)
print(r[0] / 2)
