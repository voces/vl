// @run
// @log ww
// @log ww
// @log L
// @log 7
// @log L
// @log 9
// A captured cell's assignment used as a value yields the value stored: a literal-union cell and a
// cell of functions, the value printed or called.
type K = "zz" | "ww"
function lit() {
  let k: K = "zz"
  const set = () => {
    return k = "ww"
  }
  print(set())
  print(k)
}
lit()
function fns() {
  let f = (n: i32) => n + 1
  const set = () => {
    return f = (n: i32) => {
      print("L")
      return n + 2
    }
  }
  const g = set()
  print(g(5))
  print(f(7))
}
fns()
