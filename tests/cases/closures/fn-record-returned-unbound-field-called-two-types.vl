// @run
// @log 7
// @log 7.5
// @log 8.5
// @log 8
// @log x
// @log 1
// @log 9
// @log 9.5
// @log 3
// @log 3.5
// @log 2
// @log 2.5
// @log 4
// A record a call returns, its function field called at two types straight off the call: each
// call takes the member at its own types. Either order, a string, a bound reader beside it,
// inside a function, two fields, and beside a binding whose field another function was written
// to (D15279, D15275).
function id0(a) { return a }
function id1(a) { return a }
function mkA() { return { f: id1 } }
print(mkA().f(7))
print(mkA().f(7.5))
function mkB() { return { f: id1 } }
print(mkB().f(8.5))
print(mkB().f(8))
function mkC() { return { f: id1 } }
print(mkC().f("x"))
const rc = mkC()
print(rc.f(1))
function mkD() { return { f: id1 } }
function run() {
  print(mkD().f(9))
  print(mkD().f(9.5))
}
run()
function mkE() { return { f: id1, g: id1 } }
print(mkE().f(3))
print(mkE().g(3.5))
function mkF() { return { f: id1 } }
const rf = mkF()
rf.f = id0
print(rf.f(2))
print(rf.f(2.5))
print(mkF().f(4))
