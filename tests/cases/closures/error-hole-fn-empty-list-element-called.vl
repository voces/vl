// @error cannot infer a type for this empty list — `early` calls its element, and an empty array literal has no element type
// An empty list handed to an un-annotated parameter whose element is called names no result
// type for that call, as `const e = []` names none; an annotated empty list runs (D9281).
function early(a) {
  if a.length == 0 { return 0 }
  return a[0](4)
}
print(early([]))
