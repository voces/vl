// @error cannot write 'half' to an element of 'ys': a call through it at (i32) runs it, and it is (f64) => f64
// A list of a generic function pushed an f64 function refuses a call through an un-annotated
// parameter with an integer literal, which instances the generic at i32 (D10152).
function id<T>(x: T): T { x }
function half(x: f64): f64 { x / 2.0 }
const ys = [id]
ys.push(half)
function run(a) { print(a[1](3)) }
run(ys)
