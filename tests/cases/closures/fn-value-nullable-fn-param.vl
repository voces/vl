// @run
// @log 3
// @log 0
// @log 65
// @log 129
// @log 37
// @log 5
// @log 37
// @log 3
// @log 0
// @log 3
// @log false
// @log true
// @log 5
// @log false
// @hint redundant type annotation: `g` is inferred as `i32`
// D9772: a function whose parameter is a nullable function type, taken as a value, keys that
// parameter with the nullable-closure token its result position already used. Calls through the
// value pass a closure and `null`; the direct call and the non-null parameter are the controls.
// D2571 is the lambda spelling.
function g(f: ((x: i32) => i32) | null): i32 {
  if f != null { return f(2) }
  0
}
const gg = g
print(gg((x: i32) => x + 1))
print(gg(null))

function g5(f: ((x: i32) => i32) | null) {
  if f != null { return f(2) }
  5
}
function pass(h: (f: ((x: i32) => i32) | null) => i32) {
  h((x: i32) => x * 3) * 10 + h(null)
}
print(pass(g5))
print(
  pass((f: ((x: i32) => i32) | null) => {
    if f != null { return f(4) }
    9
  }),
)

// The nullable function type takes a nullable function itself.
function outer(f: ((h: ((x: i32) => i32) | null) => i32) | null) {
  if f != null { return f((x: i32) => x + 1) * 10 + f(null) }
  5
}
function k(h: ((x: i32) => i32) | null) {
  if h != null { return h(2) }
  7
}
const oo = outer
print(oo(k))
print(oo(null))
const kk = k
print(outer(kk))

// Controls: the direct call, and the parameter without `| null` taken as a value.
print(g((x: i32) => x + 1))
print(g(null))
function plain(f: (x: i32) => i32) { f(2) }
const pp = plain
print(pp((x: i32) => x + 1))

// D2571: a lambda whose parameter is a nullable function type, bound and called in place.
function inc(n: i32) { return n + 1 }
const lf = (p: ((i32) => i32) | null) => p
print(lf(inc) == null)
print(lf(null) == null)
const q = lf(inc)
if q != null { print(q(4)) }
print(((p: ((i32) => i32) | null) => p)(inc) == null)
