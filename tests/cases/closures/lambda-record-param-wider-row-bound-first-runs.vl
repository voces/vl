// @run
// @log a
// @log b
// A wider record handed to a lambda whose parameter is a declared record type, the lambda bound
// before the record: the check restart the width rewrite runs clears the types its first pass
// noted, so the second pass reads none of the old arena (D16215).
type P = { name: string }
const show = (p: P) => print(p.name)
const v = { age: 3, name: "a" }
show(v)
const w = { name: "b", tag: 1 }
show(w)
