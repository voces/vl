// @run
// @log 4
// @log 10
// @log 7
// @log -1
// @log 14
// @log 14
// @log 8
// @log -2
// A start body is built once, so a value whose type still holds a hole function's variable is held
// at the rep it is built at: one row per position a top-level value of such a type reaches.
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function mk(f) { return { r: { f: f } } }
function pick(k: i32) { return if k > 0 { { r: { g: inc0 } } } else { null } }
// a let initializer, then a call through its field
const a = mk(inc0)
print(a.r.f(3))
// a print argument, a field call off a maker call
print(mk(dbl).r.f(5))
// an optional call through a nested field, both arms
print(pick(1)?.r.g(6) ?? 0)
print(pick(0)?.r.g(6) ?? -1)
// a map value read with a `??` default
const m = Map()
m["k"] = [inc0, dbl]
const got = m["absent"] ?? [dbl]
print(got[0](7))
const hit = m["k"] ?? [dbl]
print(hit[1](7))
// a map of records holding hole functions, read through `?.`
const n = Map()
n.set("a", { r: { fm: inc0 } })
n.set("b", { r: { fm: dbl } })
print(n.get("b")?.r.fm(4) ?? 0)
print(n.get("z")?.r.fm(4) ?? -2)
