// @run
// @log s1,2

// D2316 matrix — sibling function-scope blocks, closure return types string then struct.

type Point = { x: i32, y: i32 }

function f() {
  let out = ""
  {
    const g = () => "s"
    out = g()
  }
  {
    const g = () => { x: 1, y: 2 }
    const p = g()
    out = out + "\{p.x},\{p.y}"
  }
  out
}
print(f())
