// @run
// @log 21
// @log a
// @log same
// @log 22
// @log same
// @log b
// @log 23
// @log c
// @log 31
// @log d
// @log same
// @log 32
// @log same
// @log e
// @log same
// @log 41
// @log same
// @log f
// @log 42
// @log g
// A `let` bound to a call returning one of two generics and written with another such call: each
// write runs its call once, as the index of the generic it returned, and each type selects its
// instance (D10192).
function id<T>(x: T): T { x }
function same<T>(x: T): T {
  print("same")
  x
}
function pick(n: i32) {
  if n > 1 { return id }
  return same
}
function flip(n: i32) {
  if n > 1 { return same }
  return id
}
let k = pick(5)
print(k(21))
print(k("a"))
k = pick(0)
print(k(22))
print(k("b"))
k = flip(0)
print(k(23))
print(k("c"))

// Inside a function, written under an `if`.
function run() {
  let j = pick(5)
  print(j(31))
  print(j("d"))
  if true { j = pick(0) }
  print(j(32))
  print(j("e"))
}
run()

// Written from another function.
let w = pick(0)
print(w(41))
print(w("f"))
function reset() { w = pick(5) }
reset()
print(w(42))
print(w("g"))
