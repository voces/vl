// @run
// @log 4
// @log 2.25
// @log 6
// @log 2.5
// @log 4
// A returned list of functions read through `.map` inside a hole parameter's body: the call
// through the callback's element is a per-instance fact, so the set is tagged (D14886).
function inc0(a) { return a + 1 }
function dbl0(a) { return a * 2 }
function deliver0() { return [inc0] }
function deliver1() { return [inc0, dbl0] }
function take0(a) { print(a.map((f) => f(3))[0]) }
function take1(a) { print(a.map((f) => f(3))[1]) }
function take2(a) { print(a.map((f) => [1].map((y) => f(y + 2))[0])[0]) }
take0(deliver0())
print(deliver0().map((f) => f(1.25))[0])
take1(deliver1())
print(deliver1().map((f) => f(1.25))[1])
take2(deliver0())
