// @run
// @log 4
// @log 10
// @log 6
// @log 4
// An element of a returned local nested list of un-annotated functions, handed to an
// un-annotated parameter, runs at the top level and inside a function, and beside a read of the
// same list called directly (D9710). The last case, the element of a flat list, is a control that
// ran before.
function inc0(a) { return a + 1 }
function use0(f) { return f(3) }
function deliver0() {
  const u = [[inc0]]
  return u
}
const v0 = deliver0()
print(use0(v0[0][0]))

function inc1(a) { return a + 1 }
function dbl1(a) { return a * 2 }
function use1(f) { return f(5) }
function deliver1() {
  const u = [[inc1], [dbl1]]
  return u
}
function go1() {
  const v = deliver1()
  print(use1(v[1][0]))
  print(v[0][0](5))
}
go1()

function inc2(a) { return a + 1 }
function use2(f) { return f(3) }
function deliver2() {
  const u = [inc2]
  return u
}
const v2 = deliver2()
print(use2(v2[0]))
