// Missing-key variant of `module-holder-of-bundles-return`: the holder reads key `z`, so it holds null.
// A module const holding a map read of two-signature bundles, called through from a function's return (D17111).
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
const m = Map()
m["a"] = lap((a) => a + 1)
const x = m["z"]
function get() {
  if x != null { return x(4) }
  return 0
}
print(get())
// @hint Intentionally-unused variable `_a`
// @hint Intentionally-unused variable `_b`
