// @run
// @log 6
// A choice of hole functions stored in a record field and called through it. The record is
// pinned at the call's closed type, so the field is a closure; the set must not be tagged on
// the account of the earlier check that typed the call through the set (D14427).
function idg(t) { return t }
function kg(t) { return t + t }
const c = [1].length > 0
const r = { h: if c { kg } else { idg } }
print(r.h(3))
