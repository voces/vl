// @run
// @log 1.5
// @log 4
// @log 2
// An un-annotated lambda returning a list literal, at a list result whose element union holds a
// list-of-records arm, takes that result as its annotated twin does, bound and handed to a
// parameter alike (D16912).
const x: () => ({a: i32}[] | f64)[] = () => [1.5]
const r2 = x()[0]
if r2 is f64 { print(r2) } else { print(r2.length) }
const y: () => ({a: i32}[] | f64)[] = () => [[{ a: 4 }], 2.5]
const r3 = y()[0]
if r3 is f64 { print(r3) } else { print(r3[0].a) }
function ap(f: () => ({a: i32}[] | f64)[]) { print(f().length) }
ap(() => [1.5, 2.5])
