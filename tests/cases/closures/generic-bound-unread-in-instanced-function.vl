// @run
// @log 1
// @log z
// @log 1
// @log 1
// @log 2
// @log 0
// @hint Intentionally-unused variable `_q` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_k`
// @hint Intentionally-unused parameter `_x`
// A hole function no call instances, bound or listed unread or returned unread inside a generic
// or hole function that is instanced, is built as no body: the instances' reads are the
// template's, and the template body no slot emits holds no use (D6930).
function exclaim(s) { return s + "!" }

function hold<T>(x: T) {
  const _k = exclaim
  print(x)
}
function holdHole(x) {
  const _k = exclaim
  print(x)
}
function listed<T>(_x: T) {
  const xs = [exclaim]
  print(xs.length)
}
function get<T>(_x: T) { return exclaim }

hold(1)
holdHole("z")
holdHole(1)
listed(1)
const _q = get(1)
print(2)
print(0)
