// @run
// @log 1
// @log 2
// @log 3
// @log 4
// @hint Intentionally-unused parameter `_b` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_y` (leading `_` marks it unused)
// A lambda written into an element or field holding a generic runs when every call through it
// gives its annotated parameters the types they take, whether it annotates one or all (D12217).
function pick<A, B>(a: A, _b: B): A { a }
const fs = [pick]
fs[0] = (x, _y: string) => x
print(fs[0](1, "s"))
const r = { f: pick }
r.f = (x, _y: string) => x
print(r.f(2, "t"))
const gs = [pick]
gs[0] = (x: i32, _y: string) => x
print(gs[0](3, "u"))
const ks = [pick, (x: i32, _y: string) => x + 1]
print(ks[1](3, "v"))
