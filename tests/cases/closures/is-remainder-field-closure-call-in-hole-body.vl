// @run
// @log 11
// @log 4
// @log 11
// @log 11
// A function field read through an `is` remainder and called in a body whose parameter is a
// hole, a type parameter, or a lambda's: the call's scratch slot is minted where it lowers,
// so no spelling indexes a local its frame never declared (D3232).
type A = { v: i32 }
type B = { g: () => i32 }
function F(z) {
  if z.h is A { print(z.h.v) } else { print(z.h.g()) }
}
function G<Z>(z: Z) {
  if z.h is A { print(z.h.v) } else { print(z.h.g()) }
}
const L = (z) => {
  if z.h is A { print(z.h.v) } else { print(z.h.g()) }
}
const x: { h: A | B } = { h: { g: () => 11 } }
const y: { h: A | B } = { h: { v: 4 } }
F(x)
F(y)
G(x)
L(x)
