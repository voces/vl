// A hole function reading its parameter at two types, read as a value five ways: an alias in
// and outside a function, an `if` choice, a module list and a `for` over a literal (D15062).
function add(a, b) { return a + b }
function mul(a, b) { return a * b }
function apply2(g) {
  print(g(1, 2))
  print(g(1.5, 2.5))
}
function apply3(g) {
  print(g(10, 20))
  print(g(0.5, 0.25))
}
function viaAlias(h) {
  const k = apply2
  k(h)
}
viaAlias(add)
viaAlias(mul)
const k = apply2
k(add)
k(mul)
function viaIf(h, b: boolean) {
  const j = if b { apply2 } else { apply3 }
  j(h)
}
viaIf(add, true)
viaIf(mul, false)
viaIf(mul, true)
const fs = [apply2, apply3]
fs[0](add)
fs[1](mul)
fs[0](mul)
function viaFor(h) {
  for f in [apply2] { f(h) }
}
viaFor(add)
viaFor(mul)
