// @run
// @log 1
// @log 2
// @log 3
// @log 4
// @log a!
// @log b!
// @log 5
// @warning This expression has no effect: it is not the final statement of its block, so its value is discarded
// A hole function's bare name whose value nothing reads is no use: as a statement, in
// parentheses, through an alias, in a literal, as the last statement of an `if` or a loop body,
// and inside a generic body, it emits nothing and the function is built as no body (D6960). A
// function also called by name keeps its body and the discarded name still emits nothing, as does
// any annotated function's, whose closure nothing builds (D6980).
function exclaim(s) { return s + "!" }
function shout(s) { return s + "!" }
function bang(s: string) { return s + "!" }
function ping() { print(5) }

function g<T>(x: T) {
  exclaim
  print(x)
}

exclaim
(exclaim)
const h = exclaim
h
[exclaim]
{ a: exclaim }
let c = 0
while c < 1 {
  c = c + 1
  exclaim
}
if c > 0 {
  print(c)
  exclaim
} else {
  (exclaim)
}
g(2)
g("3")
for i in 0 to 1 { exclaim }
print(4)
shout
print(shout("a"))
bang
(ping)
print(bang("b"))
ping()
