// @run
// @log 3
// @log 4
// @log 30
// @log 0.75
// The D7183 witness: a `for` over a list of two hole functions, each handed a hole function it
// calls at two types, is typed at the one closed type their calls give it.
function add(a, b) { return a + b }
function apply2(g) {
  print(g(1, 2))
  print(g(1.5, 2.5))
}
function apply3(g) {
  print(g(10, 20))
  print(g(0.5, 0.25))
}
const fs = [apply2, apply3]
for f in fs { f(add) }
