// @run
// @log 2
// @log s
// @log id2
// @log 3
// @log 4
// @log t
// @log 5
// @log u
// @log 6
// @log id2
// @log 7
// A generic function stored into an un-annotated `Map()` by a function the map is handed to, or
// through a `const` alias of it, is a value of the map's own, so the map's reads run (D9440).
function id<T>(x: T): T { x }
function id2<T>(x: T): T { print("id2"); x }
function fill(mm) { mm["k"] = { f: id } }
function put(mm) { mm.set("k", id) }
function over(mm) { mm["k"] = { f: id2 } }
function bare(mm) { mm["k"] = id2 }
const a = Map()
a["k"] = { f: id }
fill(a)
const ar = a["k"]
if ar != null {
  print(ar.f(2))
  print(ar.f("s"))
}
const b = Map()
b["k"] = { f: id }
over(b)
const br = b["k"]
if br != null { print(br.f(3)) }
const c = Map()
c["k"] = { f: id }
const cc = c
cc["k"] = { f: id }
const cr = c["k"]
if cr != null {
  print(cr.f(4))
  print(cr.f("t"))
}
const d = Map()
d.set("j", id)
put(d)
const dr = d.get("k")
if dr != null {
  print(dr(5))
  print(dr("u"))
}
const e: {[string]: (x: i32) => i32} = Map()
e["k"] = id
const er = e["k"]
if er != null { print(er(6)) }
const h = Map()
h["k"] = id
bare(h)
const hr = h["k"]
if hr != null { print(hr(7)) }
