// @error set: expected (string) => string, got (i32) => i32
// A map of a generic function set over with a fixed-type function still refuses a call of its
// read at another type, directly or through an alias of the read (D10023).
function id<T>(x: T): T { x }
function inc(x: i32): i32 { x + 1 }
const m = Map()
m.set("k", id)
m.set("k", inc)
const r = m.get("k")
const q = r
if q != null { print(q("s")) }
