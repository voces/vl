// @run
// @log 14
// @log 14
// @log 8
// @log 8
// A choice of un-annotated functions that is both called through and handed where a declared
// function type is expected is chosen once, where it is handed: flipping the condition
// afterwards does not change which function a later call through the handed value reaches.
function twice(x) { return x * 2 }
function plus1(x) { return x + 1 }
let c = true
function keep(g: (x: i32) => i32): (x: i32) => i32 { return g }
const f = if c { twice } else { plus1 }
print(f(7))
const k = keep(f)
c = false
print(k(7))
const m = keep(if c { twice } else { plus1 })
c = true
print(m(7))
print(f(7) - 6)
