// @run
// @log 4
// @log 4
// @log 4
// @log 6
// @log 9
// A function with an un-annotated parameter builds its list and record literals of un-annotated
// functions once per instance: a local list of a local list, a record of a list, and two literal
// returns written into a global that also holds a tagged set.
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function sq(a) { return a * a }
function nested(_n) {
  const w = [inc0]
  const u = [w]
  return u
}
print(nested(1)[0][0](3))
function boxed(_n) {
  const w = [inc0]
  return { fs: w }
}
print(boxed(1).fs[0](3))
function pick(b) {
  if b { return [{ fs: [inc0] }] }
  return [{ fs: [dbl] }]
}
let g = [{ fs: [dbl] }]
g = pick(true)
print(g[0].fs[0](3))
g = pick(false)
print(g[0].fs[0](3))
function sqs(_n) {
  const a = [{ fs: [sq] }]
  return a
}
print(sqs(0)[0].fs[0](3))
