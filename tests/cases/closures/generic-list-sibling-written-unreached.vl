// @log 7
// A list or map of a generic function written with a fixed-type function, beside calls at other
// types that the written value cannot reach: another list's element, an alias of the generic,
// the generic itself, and another map's read (D10020).
function id<T>(x: T): T { x }
function inc(x: i32) { x + 1 }

const xs = [id]
const ys = [id]
ys.push(inc)
print(ys[1](2))
print(xs[0](2))
print(xs[0]("s"))

// The generic called directly, and through an alias.
const zs = [id]
zs.push(inc)
print(zs[1](2))
const f = id
print(f("s"))

// A map set over with a fixed-type function, and another map's read called at f64 (D10023).
const m = Map()
m.set("k", id)
m.set("k", inc)
const n = Map()
n.set("a", id)
const r4 = n.get("a")
if r4 != null { print(r4(1.5)) }
const r = m.get("k")
if r != null { print(r(2)) }

// A spread copy written with the fixed-type function, inside a function (D10024).
function main() {
  const as = [id]
  const bs = [...as]
  bs[0] = inc
  print(as[0](2))
  print(bs.length * 2)
  print(as[0]("s"))
  print(bs[0](2))
  print(id("s"))
}
main()

// A list a function only writes into, its length read.
const ws = [id]
function fill(a) { a.push(inc) }
fill(ws)
print(ws[1](2))
print(ws.length - 1)
print(id(7))
