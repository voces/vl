// @run
// @log 6
// A user list's element 0 written and called in a generic body is the list's element, not a
// capture cell's read (D15454).
function same<T>(k: T): T { return k }
function dbl(x: i32) { return x * 2 }
function go<F>(g: F, f: F) {
  const r = [g]
  r[0] = f
  print(r[0](3))
}
go(same, dbl)
