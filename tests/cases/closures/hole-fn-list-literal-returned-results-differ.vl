// @run
// @log abab
// @log 2
// @log 3
// @log 1.5
// A list literal of un-annotated functions whose results differ, returned by a call and bound or
// read in place, is read at each call's own tuple, as its inline spelling is (D14648).
function twice(s) { return s + s }
function lenOf(s) { return s.length }
function mk() { return [twice, lenOf] }
const fs = mk()
for g in fs { print(g("ab")) }
print(mk()[1]("xyz"))
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function mk2() { return [inc0, half] }
const xs = mk2()
print(xs[1](3))
