// @emit-error a list holding a generic function is called through its elements at more than one type
// A list with two generic sources has no single function its calls can be instanced from, so
// calls through it at two types are refused even though each element meets one type.
function id<T>(x: T): T { x }
function k<T>(x: T): T { x }
const fs = [id, k]
print(fs[0](1))
print(fs[1]("s"))
