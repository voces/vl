// @run
// @log 1
// @log 2
// @log 3
// @log 4
// @log 5!
// @log <6>
// @log 7
// @log 8
// @log 9
// @log 10
// @log 11
// @log 12
// A function value called with `null`, or with a nullable value, at a nullable record, a
// nullable list, a `null` and a `boolean | null` parameter. Each call's result is delivered to a
// position: a scalar and a union parameter, a nested call, a concat operand, an interpolation
// hole, a `return`, a `let`, an `if` arm, a `??` operand, a record field and module scope.
import { toString } from "std:fmt"

type P = { a: i32 }
type R = { n: i32 }
function onRec(p: P | null) {
  if p == null { return 1 }
  return p.a
}
function onList(xs: i32[] | null) {
  if xs == null { return 2 }
  return xs.length
}
function onNull(p: null) { return if p == null { 3 } else { 0 } }
function onBool(b: boolean | null) {
  if b == null { return 4 }
  return 0
}
function id(x: i32) { return x }
function show(u: i32 | string) {
  if u is i32 { print(u) } else { print(u) }
}
function atScalar(f: (p: P | null) => i32) { print(id(f(null))) }
function atUnion(f: (xs: i32[] | null) => i32) { show(f(null)) }
function nested(f: (p: null) => i32) { print(id(id(f(null)))) }
function viaReturn(f: (b: boolean | null) => i32) { return f(null) }
function concat(f: (p: P | null) => i32, q: P | null) {
  print(toString(f(q)) + "!")
}
function interp(f: (xs: i32[] | null) => i32, l: i32[] | null) {
  print("<\{f(l)}>")
}
function viaLet(f: (p: P | null) => i32) {
  const v = f({ a: 7 })
  print(v)
}
function ifArm(c: boolean, f: (xs: i32[] | null) => i32) {
  print(if c { f([1, 2, 3, 4, 5, 6, 7, 8]) } else { 0 })
}
function coalesce(m: Map<string, i32>, f: (p: P | null) => i32) {
  print(m["k"] ?? f({ a: 9 }))
}
function field(f: (b: boolean | null) => i32) {
  const r: R = { n: f(null) + 6 }
  print(r.n)
}
const g = onRec
atScalar(g)
atUnion(onList)
nested(onNull)
print(viaReturn(onBool))
const q: P | null = { a: 5 }
concat(g, q)
const l: i32[] | null = [1, 2, 3, 4, 5, 6]
interp(onList, l)
viaLet(g)
ifArm(true, onList)
coalesce(Map(), g)
field(onBool)
const h = onRec
print(h(null) + h({ a: 10 }))
const k = onBool
print(k(null) * 3)
