// @emit-error this record `if` stores functions of different signatures in one field
// A record `if` whose arms store functions of different results, called through, beside other
// records sharing those functions handed to un-annotated parameters at two types: the joined
// record would be called at one signature and hold a closure of another, so it is refused at
// emit rather than trapping (D15809).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function dbl(a) { return a * 2 }
function two() { [1, 2].length }
function take(r) { return r.f(3) }
function take2(n, r) { return r.f(n) }
const q = if two() > 5 { { f: half } } else { { f: inc0 } }
print(take(q))
print(take2(3, if two() > 5 { { f: dbl } } else { { f: inc0 } }))
print(take2(2.5, if two() > 5 { { f: half } } else { { f: half } }))
