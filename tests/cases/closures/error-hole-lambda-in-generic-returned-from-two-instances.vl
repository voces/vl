// @emit-error this lambda is written inside a generic function and is one value for every instance of it
// A hole lambda in a generic body that no instance keys is one value for every instance, so calls
// through it at two types are refused rather than run at the first instance's type (D15110).
function inner<U>(u: U) { print("I"); print(u) }
function a<T>(x: T) {
  let k = inner
  k = (u) => {
    print(u)
  }
  return k
}
a(1)(2)
a(true)(false)
