// @run
// @log a!
// A hole function bound through an `if` expression and returned, then called by the caller,
// instances each arm at the call (D7001).
function exclaim(s) { return s + "!" }
const on = [1].length == 1
function pick() {
  const x = if on { exclaim } else { exclaim }
  return x
}
print(pick()("a"))
