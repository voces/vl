// @run
// @log 4
// @log 6
// @log 6
// @log 5
// @log 4
// @log 4
// @log 6
// @log 4
// @log 6
// @log 6
// A value `if` or `match` choosing between record literals that hold lists of different
// un-annotated functions decides the arms' sets with the join's, so every arm's list holds the
// join's ids (D15303).
function inc0(x) { return x + 1 }
function dbl(x) { return x * 2 }
const c = 1 > 0
const r = if c { { fs: [inc0] } } else { { fs: [dbl] } }
print(r.fs[0](3))
function run(b: boolean) {
  const q = if b { { fs: [inc0] } } else { { fs: [dbl] } }
  print(q.fs[0](3))
}
run(false)
function pick(k: i32) {
  const m = match k {
    0 => { fs: [inc0] }
    _ => { fs: [dbl] }
  }
  print(m.fs[0](3))
}
pick(1)
function extra(b: boolean) {
  const e = if b { { fs: [inc0], n: 1 } } else { { fs: [dbl], n: 2 } }
  print(e.fs[0](3) + e.n)
}
extra(true)
function deep(b: boolean) {
  const d = if b { { fs: [[inc0]] } } else { { fs: [[dbl]] } }
  print(d.fs[0][0](3))
}
deep(true)
function mixed(b: boolean) {
  const x = if b { { fs: [inc0, dbl] } } else { { fs: [dbl] } }
  print(x.fs[0](3))
}
mixed(true)
function mixedRev(b: boolean) {
  const y = if b { { fs: [dbl] } } else { { fs: [inc0, dbl] } }
  print(y.fs[0](3))
}
mixedRev(true)
function mk(b: boolean) {
  return if b { { fs: [inc0] } } else { { fs: [dbl] } }
}
print(mk(true).fs[0](3))
const s = { fs: [inc0, dbl] }
print(s.fs[1](3))
function cross(b: boolean) {
  const z = if b { { fs: [inc0] } } else { { fs: [dbl] } }
  print(z.fs[0](3))
}
cross(false)
