// @run
// @log 4
// @log 6
// @log 10
// A function whose tail is a value `if` of list literals holding un-annotated functions builds
// each list as its arms written as `return`s do (D15925).
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function pick(b: boolean) {
  if b { [{ f: inc0 }] } else { [{ f: dbl }] }
}
print(pick(true)[0].f(3))
print(pick(false)[0].f(3))
function pick2(b: boolean) {
  if b { [{ f: inc0 }, { f: dbl }] } else { [{ f: dbl }] }
}
const xs = pick2(true)
print(xs[0].f(3) + xs[1].f(3))
