// @run
// @log 3.5
// @log 4
// @log 5 2.5
// @log 3.5
// @log 4
// @log 5 2.5
// @log 3.5
// @log 4
// @log 5 2.5
// @log 3.5
// @log 4
// @log 5 2.5
// @log 8
// @log 4.5
// @log 5
// @log 6
// A parameter called at two signatures and returned is a record its caller can hold: a
// `const` holding it is called at both signatures, from its own body or a closure, and handed
// on whole to a parameter called at both, or as one member to a parameter that takes one.
function lap(f) {
  print(f(2.5))
  print(f(3))
  return f
}
function take(a) { print("\{a(4)} \{a(1.5)}") }
function keep(g) { print(g(4)) }
function held(k: i32) {
  const r = lap((a) => a + k)
  print("\{r(4)} \{r(1.5)}")
}
function captured(k: i32) {
  const r = lap((a) => a + k)
  const h = () => print("\{r(4)} \{r(1.5)}")
  h()
}
function handedCall(k: i32) { take(lap((a) => a + k)) }
function handedHolder(k: i32) {
  const r = lap((a) => a + k)
  take(r)
  print(r(7))
}
function handedMember(k: i32) {
  const r = lap((a) => a + k)
  keep(r)
}
held(1)
captured(1)
handedCall(1)
handedHolder(1)
handedMember(2)
