// @log 6
// @log z
// @log 7
// @log false
// A written binding every value of which is a parameter of one type parameter, called at a
// type other than the parameters' own calls, runs each call at its own instance; so does a
// type parameter two parameters share when the call hands both the same function.
function id<T>(x: T): T { x }
function dup<T>(x: T): T {
  print("dup")
  x
}
function one<F>(a: F, c: boolean) {
  let b = a
  if c { b = a }
  print(a("x"))
  print(b(3) + 1)
}
one(id, true)
one(dup, false)
function two<F>(a: F, a1: F, c: boolean) {
  let b = a1
  if c { b = a }
  print(a("y"))
  print(b(4) + 1)
}
two(id, id, true)
two(dup, dup, false)
function typed<F>(a: F, a1: F) {
  let b: F = a1
  b = a
  print(a(true))
  print(b(5) + 1)
}
typed(id, id)
function shared<F>(a: F, a1: F) {
  print(a("z"))
  print(a(6) + 1)
  print(a1(false))
}
shared(id, id)
