// @run
// @log 1
// @log 1
// @log true
// @log 4
// @log 9
// @log 7
// @hint redundant type annotation: `c` is inferred as `{r: i32}`
// A CAPTURED, UN-ANNOTATED BINDING WHOSE INITIALIZER IS NOT AN OBJECT LITERAL — D731, and
// the whole of what `emitProgram: ref valtype with no interned shape` refused at this seam.
//
// `captureValStructIdx` resolves the env field's SLOT for a capture, and its un-annotated leg
// ended in a single peep-hole — `if iv is ObjLit { return structIndexOfExpr(...) }` — where
// the eight rungs above it are `letIs*` CLASSIFIERS (`letIsNulMap`, `letIsMap`,
// `letIsNulVariant`, `letIsNulRef`, `letIsNulRefArray`, `letIsRefArray`, `letIsVariant`). Its
// KIND twin `letInitCellKind` types the field `"struct"` for EVERY struct-valued initializer,
// so a `: Circle`-returning CALL minted the pair `("struct", -1)` and `fbValtype`'s bounds
// guard printed the message — on five lines with no union, no generic and one frame of
// nesting. Annotating the binding ran, not capturing ran, an object-LITERAL init ran, and a
// module GLOBAL of the same shape ran (`globalCellStructIdx` already asks the full ladder).
//
// The rung is now `letIsStruct` + `structIndexOfLet`, which is the ladder `collectLocals` runs
// for the same binding one storage class over, so the env field and the local agree by
// construction rather than by two hand-written peep-holes.
//
// LEG 3 IS D51's PAIR AND IT NEEDS THE KIND FLIP AS WELL AS THE SLOT. `const c = { r: 7.5 }`
// beside `type Shape = Cf | Sq` has NO struct row for its field set (`collectS` skips a union
// member), `letIsVariant` declines (its init leg is `exprVariantIndex`, which carries no
// object-literal field-set arm by design), and the arm is the only claimant —
// `letObjLitVariantIdx`. The index is a VARIANT row, so `letInitCellKind` has to answer
// `"variant"` too or `fbValtype` reads it out of `sHeapIdx`, the wrong table.
//
// NOT COVERED HERE, AND STILL OPEN: an initializer the SLOT ladder now answers for but whose
// READ classifier does not — `const c = w.inner` (a struct-valued MEMBER read) and
// `const c = xs[0]` (an INDEX read) captured are `emitProgram: field access receiver is not a
// struct` on master and on this branch alike, and the ANNOTATED member-read spelling is
// check-clean INVALID WASM on both. That is `capturedKindOf`, one function over, and it is a
// different defect.
type Circle = { r: i32 }
type Cf = { r: f64 }
type Sq = { s: i32 }
type Shape = Cf | Sq

function mkc(): Circle { return { r: 1 } }

// 1. the nested-FUNCTION spelling.
function leg1() {
  const c = mkc()
  function inner() { print(c.r) }
  inner()
}
leg1()

// 2. the LAMBDA spelling of the same capture.
function leg2() {
  const c = mkc()
  const inner = () => { print(c.r) }
  inner()
}
leg2()

// 3. an ARM-shaped object literal captured, with no plain struct row for its field set.
function leg3() {
  const c = { r: 7.5 }
  function inner() { print(c.r > 7.0) }
  inner()
}
leg3()

// 4. the capture crossing TWO frames, with a paren-wrapped init.
function leg4() {
  const c = (mkc())
  function mid() {
    function inner() { print(c.r + 3) }
    inner()
  }
  mid()
}
leg4()

// 5. a WRITE through the captured env field, which needs the same heap type as the read.
function leg5() {
  const c = mkc()
  function inner() {
    c.r = 9
    print(c.r)
  }
  inner()
}
leg5()

// 6. the ANNOTATED control, which ran before this change and must keep running.
function leg6() {
  const c: Circle = { r: 7 }
  function inner() { print(c.r) }
  inner()
}
leg6()
