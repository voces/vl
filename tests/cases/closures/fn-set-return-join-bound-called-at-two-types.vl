// @run
// @log 6
// @log 5
// A binding of a function set, called at two types, dispatches on the member it holds at each.
function inc(a) { return a + 1 }
function dbl(a) { return a * 2 }
function sel(c: boolean) {
  if c { return inc }
  return dbl
}
const g = sel(false)
print(g(3))
print(g(2.5))
