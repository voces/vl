// @run
// @log 12
// @log 12
// @log 12
// @log 12
// @log sss
// A function-scope binding of a module-scope hole lambda, written in the function, by a
// nested function or by a nested lambda, then delivered to a typed parameter (D3862, D3865).
const c = (y) => y + y
const e = (y) => y + y + y
function mk(f: (y: i32) => i32, n: i32) { print(f(n)) }
function direct() {
  let d = c
  d = e
  mk(d, 4)
}
direct()
function byLambda() {
  let d = c
  const w = () => {
    d = e
  }
  w()
  mk(d, 4)
}
byLambda()
function byFunction() {
  let d = c
  function w() { d = e }
  w()
  mk(d, 4)
}
byFunction()
function localLambdas() {
  const c1 = (y) => y + y
  const e1 = (y) => y + y + y
  let d = c1
  const w = () => {
    d = e1
  }
  w()
  mk(d, 4)
  print(e1("s"))
}
localLambdas()
