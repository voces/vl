// @run
// @log 3
// @log 4
// @log 5
// @log 6
// @log 7

// @hint redundant type annotation: `v1` is inferred as `{name: string, n: i32}`
// @hint redundant type annotation: `v2` is inferred as `{name: string, n: i32}`
// @hint redundant type annotation: `v5` is inferred as `{name: string, n: i32}`

// D1632 — an ANNOTATED rebind of a NARROWED struct-valued map read, then captured. The
// annotation types the cell non-null while the value arriving is the map read's nullable
// niche, so the env field declared `(ref $S)` over a `(ref null $S)`.

// The annotation is the INGREDIENT here and the whole fix in D1476 — the same seam read from
// opposite ends, which is why both rows' cells belong in one table.

// All three annotations below carry `@hint redundant type annotation`, declared above, and
// two of them are what broke the program: the hint is the checker agreeing about the TYPE,
// and it says nothing about the REP in either direction.

// The witness: an annotated rebind under the narrowing, captured.
const m1: { [string]: { name: string, n: i32 } } = Map()

m1["k"] = { name: "ada", n: 3 }

const mv1 = m1["k"]

if mv1 != null {
  const v1: { name: string, n: i32 } = mv1
  const g1 = () => v1
  print(g1().n)
}

// A value stored by PROJECTION rather than as a literal — D1476's shape feeding this one.
const src = [{ name: "ada", n: 4 }]

const m2: { [string]: { name: string, n: i32 } } = Map()

m2["k"] = src[0]

const mv2 = m2["k"]

if mv2 != null {
  const v2: { name: string, n: i32 } = mv2
  const g2 = () => v2
  print(g2().n)
}

// ── the neighbours that already ran, kept as controls ────────────────────────

// The rebind UN-annotated, which is the spelling that ran before.
const m3: { [string]: { name: string, n: i32 } } = Map()

m3["k"] = { name: "ada", n: 5 }

const mv3 = m3["k"]

if mv3 != null {
  const v3 = mv3
  const g3 = () => v3
  print(g3().n)
}

// The narrowed value captured directly, with no rebind at all.
const m4: { [string]: { name: string, n: i32 } } = Map()

m4["k"] = { name: "ada", n: 6 }

const mv4 = m4["k"]

if mv4 != null {
  const g4 = () => mv4
  print(g4().n)
}

// No map — an annotated struct bound and captured, the rep this row must not disturb.
const v5: { name: string, n: i32 } = { name: "ada", n: 7 }

const g5 = () => v5

print(g5().n)
