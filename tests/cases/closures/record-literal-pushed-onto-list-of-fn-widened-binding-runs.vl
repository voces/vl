// @run
// @log 2
// @log 2.5
// @log 2.5
// @log 2
// @log 2.5
// @log 2.5
// @log 2
// @log 2.5
// @log 2.5
// @log 1
// @log 2
// @log 2.5
// @log 7
// @log 2
// @log s
// A record literal pushed onto a list of records whose function fields the pushes widen is built
// at the list's element record, so each push's function is a member of the field's set (D15336):
// several arguments, a loop, a push inside a function, a nested list and a member written back.
function id1(a) { return a }
function id2(a) { return a }
function id3(a) { return a }
const xs = [{ f: id1 }]
xs.push({ f: id2 })
print(xs[0].f(2))
print(xs[1].f(2.5))
const ys = [{ f: id1 }]
ys.push({ f: id2 }, { f: id3 })
print(ys[2].f(2.5))
const zs = [{ f: id1 }]
let i = 0
while i < 2 {
  zs.push({ f: id2 })
  i = i + 1
}
print(zs[2].f(2))
print(zs[0].f(2.5))
const ws = [{ f: id1 }]
function add() { ws.push({ f: id2 }) }
add()
print(ws[1].f(2.5))
const h = { xs: [{ f: id1 }] }
h.xs.push({ f: id2 })
print(h.xs[1].f(2))
print(h.xs[0].f(2.5))
const vs = [{ f: id1 }]
vs.push({ f: id2 })
vs.push({ f: id1 })
print(vs[2].f(2.5))
const us = [{ f: id1, n: 1 }]
us.push({ f: id2, n: 2 })
for u in us { print(u.f(u.n)) }
print(us[1].f(2.5))
const ts = [{ f: id1 }]
ts.push({ f: id2 })
function g(qs) { return qs[1].f(7) }
print(g(ts))
const rs = [{ g: { f: id1 } }]
rs.push({ g: { f: id2 } })
print(rs[1].g.f(2))
print(rs[0].g.f("s"))
