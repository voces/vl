// @emit-error holds functions called at more than one argument type
// A copy called with a string literal union and the binding it copies called with a `string`:
// the copy would run the other call's instance, so the binding is still refused (D4244, D4893).
function gA<U>(u: U) {
  print("A")
  print(u)
}
function gB<V>(v: V) {
  print("B")
  print(v)
}
function gC<W>(w: W) {
  print("C")
  print(w)
}
type S = "p" | "q"
const a: S = "q"
let x = gA
x = gB
let y = gC
y = x
x("r")
y(a)
