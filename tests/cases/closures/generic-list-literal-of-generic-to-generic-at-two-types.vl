// @run
// @log s
// @log 5
// @log 22
// A list literal holding only a generic function, passed straight to a generic function at two
// types, runs, and so does one holding a `const` bound to it (D10250).
function id<T>(x: T): T { x }
function run<U>(a: ((x: U) => U)[], u: U): U { a[0](u) }
print(run([id], "s"))
print(run([id], 5))
const v = id
print(run([v], "ab").length * 10 + run([v], 2))
