// @emit-error a generic function is passed to a function value whose parameter type names a type parameter this closure
// A generic passed from a shared closure through a list element's T-typed parameter has no instance (D3956) (review of #3498, `rv3498/round5/h08_list_of_T_fn_from_closure`).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function a<T>(x: T) {
  const fs: ((g: (t: T) => void) => void)[] = [
    (g: (t: T) => void) => {
      g(x)
    },
  ]
  const w2 = () => {
    fs[0](other)
  }
  w2()
}
a(1)
a(true)
