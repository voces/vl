// @run
// @hint redundant type annotation: `r` is inferred as `i32[]` — remove it to lean on inference
// @log false 3 false hey false 42 false 7 true
// A closure reading an enclosing function's parameter, local or loop variable keeps that
// binding's rep when a top-level block binds the same name at another type, at every nesting
// depth, so `is` answers for the value the closure returned (D2252, consumer plumb PL-024).

type Err = { code: i32, msg: string }

function viaLocal(): () => i32[] | Err {
  const r: i32[] = [4, 5, 6]
  () => r
}

function viaParam(r: string): () => string | Err {
  () => r
}

function viaDeep(): () => i32 | Err {
  const r = 41
  () => (() => (() => r)())()
}

function viaLoop(): () => i32 | Err {
  let f: () => i32 | Err = () => 0
  for r in 7 to 7 { f = () => (() => r)() }
  f
}

const a = viaLocal()()
let out = "\{a is Err}"
if !(a is Err) { out = out + " \{a.length}" }
const b = viaParam("hey")()
out = out + " \{b is Err}"
if !(b is Err) { out = out + " " + b }
const c = viaDeep()()
out = out + " \{c is Err}"
if !(c is Err) { out = out + " \{c + 1}" }
const d = viaLoop()()
out = out + " \{d is Err}"
if !(d is Err) { out = out + " \{d}" }

if true {
  const r: Err | null = { code: 2, msg: "block" }
  out = out + " \{r != null}"
}
print(out)
