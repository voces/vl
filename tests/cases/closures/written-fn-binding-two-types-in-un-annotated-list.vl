// @run
// @log 1
// @log s
// A binding called at two types delivered into an un-annotated list: the list's element is the
// instance its element call fixes, and the binding's own call takes another (D3975).
function id<T>(x: T): T { return x }
function k<T>(x: T): T { return x }
function main() {
  let f = id
  f = k
  const fs = [f]
  print(fs[0](1))
  print(f("s"))
}
main()
