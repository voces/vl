// @run
// @log 2
// A `.filter` callback's call through an element of a list literal of un-annotated functions with
// different results runs each element's own member (D9172, D14435).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const xs = [inc0, half]
print(xs.filter((f) => f(3) > 1).length)
