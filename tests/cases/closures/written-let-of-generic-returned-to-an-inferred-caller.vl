// @run
// @log 1
// @log 6
// @log str
// @log 3
// @log 7
// A written `let` of a generic returned from a function with an inferred result: the caller's
// call through the result, a delivery of it to an annotated parameter, a call of the result in
// place, and a module-scope caller each pin it (D5062). Each returns its own generic, since two
// open results spelled alike share their type parameter (D5290).
function k<T>(x: T): T { return x }
function ks<S>(x: S): S { return x }
function km<M>(x: M): M { return x }
function mk() {
  let g = k
  g = k
  return g
}
function mks() {
  let g = ks
  g = ks
  return g
}
function mkm() {
  let g = km
  g = km
  return g
}
function apply(f: (x: i32) => i32) { print(f(6)) }
function main() {
  const h = mk()
  print(h(1))
  apply(h)
  print(mks()("str"))
}
main()
const m = mkm()
print(mk()(3))
print(m(7))
