// @log 3
// @log 1
// @log 0.75
// @log 30
// @log xy
// A hole function forwarded through a hole parameter to a list of functions that each call it at
// closed argument types is taken once per type, whatever order each element calls them in.
// Pins naming an element's own value parameter stay refused (D12701).
function add(a, b) { return a + b }
function apply2(g, s) {
  print(g(1, 2))
  print(g(0.5, 0.5))
}
function apply3(g, s) {
  print(g(10, 20))
  print(g(0.5, 0.25))
}
function inner(k, h) {
  for f in [apply2, apply3] { f(h, k) }
}
inner(0.5, add)

function both(g, s) {
  print(g(1, 2))
  print(g(0.5, 0.5))
}
function three(g, s) {
  print(g(0.5, 0.25))
  print(g(10, 20))
  print(g("x", "y"))
}
function outer(k, h) {
  for f in [both, three] { f(h, k) }
}
outer(0.5, add)
