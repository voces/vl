// @emit-error the reassigned function binding `k` holds functions called at more than one argument type
// The same, with the alias delivered to a parameter of another type after the cell is written (review of #3501, `rv3501/r08_alias_called_and_delivered_differ`).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function cb(f: (b: boolean) => void, b: boolean) { f(b) }
function main() {
  let k = inner
  const flip = () => {
    k = other
  }
  flip()
  const r = k
  r(3)
  cb(r, true)
}
main()
