// @run
// @log 30
// @log 60
// @log 90
// @log 35
// @log 4
// @log 5
// @log 4
// @log 6
// @log 2
// A list literal of records handed to an un-annotated parameter keeps its function field's type
// when an earlier record of an un-annotated function shares the field name, so the two meet at
// one row: called in place, bound first, relayed, returned and beside another field (D9951).
function inc5(a) { return a + 1 }
const r = { f: inc5, n: 1 }
function use1(v) { print(v[0].f(3)) }
use1([{ f: (x: i32): i32 => x * 10, n: 0 }])
function use2(v) { print(v[0].f(3)) }
const l = [{ f: (x: i32): i32 => x * 20, n: 0 }]
use2(l)
function t(e) { print(e.f(3)) }
function use3(v) { t(v[0]) }
use3([{ f: (x: i32): i32 => x * 30, n: 0 }])
function use4(v) { return v[0].f(3) + v[0].n }
print(use4([{ f: (x: i32): i32 => x * 10, n: 5 }]))

function inc6(a) { return a + 2 }
function use5(v) { print(v[0].f(3)) }
use5([{ f: inc5, n: 0 }])
use5([{ f: inc6, n: 0 }])
function t5(e) { print(e.f(3)) }
function t6(e) { print(e.f(4)) }
function use6(v) { t5(v[0]) }
function use7(v) { t6(v[0]) }
use6([{ f: inc5, n: 0 }])
use7([{ f: inc6, n: 0 }])
print(r.f(1))
