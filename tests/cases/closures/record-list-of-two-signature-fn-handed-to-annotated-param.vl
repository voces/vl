// @run
// @log 7
// A list of records of a function called at two signatures elsewhere, handed to a parameter annotated with closures.
// The literal is built at its stamped closure rep, so the list holds closures, not the set's ids.
function ident(a) { return a }
const recs = [{ f: ident }]
function twoSigs(k: i32) {
  const n = recs[k].f(2)
  return n + recs[k].f(2.5)
}
function take(a: { f: (a: f64) => f64 }[]) {
  const v = a
  print(twoSigs(0) + v[0].f(2.5))
}
take([{ f: ident }])
