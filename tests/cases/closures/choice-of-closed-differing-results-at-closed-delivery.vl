// @run
// @log s
// @log s
// @log 5
// @log 7
// @hint Intentionally-unused parameter `_a`
// A choice of two un-annotated functions whose closed results differ, delivered to a closed
// function type whose result admits both and called through nowhere else, dispatches (D17104).
function inc(a) { return a + 1 }
function str(_a) { return "s" }
function useK(k: (a: i32) => i32 | string) { print(k(6)) }
function run(c: boolean) {
  const g = if c { str } else { inc }
  const k: (a: i32) => i32 | string = g
  print(k(4))
  useK(g)
}
run(true)
run(false)
