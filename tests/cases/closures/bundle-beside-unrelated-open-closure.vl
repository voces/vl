// @run
// @log 2
// @log 3
// @log ss
// @log 5
// @log 7
// A module bundle (a parameter called at two types and returned) beside an unrelated open closure
// in a generic function: the closure is held as the uniform closure, whatever else the build holds
// as a record of closures, and the bundle's member is picked at its call (D17767).
function nest<T>(x: T) {
  let k = (u) => {
    print(u + u)
  }
  const rd = () => {
    k(x)
  }
  rd()
}
nest(1)
nest(1.5)
nest("s")
function lap(f) {
  f(2.5)
  f(3)
  return f
}
const c = lap((a) => a + 1)
print(c(4))
function hold(g) {
  const h = (y) => g(y)
  return h(6)
}
print(hold((z: i32) => z + 1))
