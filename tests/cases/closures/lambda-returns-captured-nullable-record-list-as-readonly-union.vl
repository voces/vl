// @run
// @log 1
// @log 3
// @log 4
// @log 9
// A lambda returning a captured list of a nullable record as a readonly list of a nullable union
// holding it takes the view its non-null twin takes: a write to the source after the delivery shows
// through it (D3088).
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function mkf(l: (Circle | null)[]): () => readonly (Shape | null)[] {
  return (): readonly (Shape | null)[] => l
}
print(mkf([null])().length)
const src: (Circle | null)[] = [null, { r: 4 }]
const f = mkf(src)
src.push({ r: 9 })
const v = f()
print(v.length)
const e = v[1]
if e != null && e is Circle { print(e.r) }
const e2 = v[2]
if e2 != null && e2 is Circle { print(e2.r) }
