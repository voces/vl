// @run
// @log 1
// @log 2
// @log 4
// @warning Unused variable `fs` (prefix with `_` to suppress, or remove it)
// A module-scope `for` variable is in scope only inside its own loop's body: a closure written
// after the loop, or inside a named function, that calls the same spelling calls the intrinsic
// (D2010).
const fs: (() => f64)[] = []
for sqrt in [1.0, 2.0] { print(sqrt) }
const h = () => sqrt(16.0)
print(h())
