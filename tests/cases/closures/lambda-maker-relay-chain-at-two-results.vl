// @run
// @log 4
// @log 0.5
// @log 7
// @log 1.125
// A relay of a relay of a maker's hole lambda, two or three deep, delivered at two function types
// whose results differ: each relay in the chain is twinned with the one returning its call (D16790).
function deliver() { return (a) => a + 1 }
function relay() { return deliver() }
function outer() { return relay() }
function inc() { return (a) => a + 1 }
function inner() { return inc() }
function mid() { return inner() }
function top() { return mid() }
const v: (a: i32) => i32 = outer()
const w: (a: i32) => f64 = outer()
print(v(3))
print(w(3) / 8.0)
const v2: (a: i32) => i32 = top()
const w2: (a: i32) => f64 = top()
print(v2(6))
print(w2(8) / 8.0)
