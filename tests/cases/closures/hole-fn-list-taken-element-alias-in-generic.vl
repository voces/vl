// @run
// @log 4
// @log 1
// @log 4
// @log s
// @log 4
// @log 1
// @log 4
// @log s
// @log 2
// @log 1
// @log t
// @log s
// A `const` bound to an element a list of un-annotated lambdas hands by `pop` or `get` in a
// generic's body, narrowed and called, at a type its instances share, and at the instance's own
// parameter type through an annotated lambda.
function run<T>(x: T) {
  const f = (a) => a + 1
  const m = [f]
  const g = m.pop()
  if g != null { print(g(3)) }
  print(x)
}
run(1)
run("s")
function run2<T>(x: T) {
  const f = (a) => a + 1
  const m = [f]
  const g = m.get(0)
  if g != null { print(g(3)) }
  print(x)
}
run2(1)
run2("s")
function run3<T>(x: T, y: T) {
  const f = (a: T) => a
  const m = [f]
  const g = m.pop()
  if g != null { print(g(y)) }
  print(x)
}
run3(1, 2)
run3("s", "t")
