// @run
// @log 4
// @log a
// @log a
// @log true
// @log <b>
// @log z
// @log z
// D3160: a closure returning a generic call over a literal union narrowed out of a box returns
// the atom the instance hands back, beside another instance of the same generic. D2219: a
// closure over a literal atom narrowed to a set another declaration names returns the atom.
type K = "a" | "b"
function id<X>(a: X): X { return a }
function t(e: K | i32) {
  if !(e is i32) {
    const f = () => id(e)
    print(f())
    const g = () => id(id(e))
    print(g())
    const h = () => id(e)
    print(h() == "a")
  }
}
function u(e: K | null | f64) {
  if e != null && !(e is f64) {
    const f = () => id(e)
    print("<\{f()}>")
  }
}
print(id(3) + 1)
t("a")
u("b")
function takeYZ(k: "y" | "z") { print(k) }
function v(m: "x" | "y" | "z") {
  if m is "y" | "z" | "q" {
    takeYZ(m)
    const g = () => m
    print(g())
  }
}
v("z")
