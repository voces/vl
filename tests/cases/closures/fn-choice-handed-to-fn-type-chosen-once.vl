// @run
// @log 14
// @log 14
// @log 8
// @log 14
// @log 8
// A choice of un-annotated functions handed where a declared function type is expected is
// chosen once, where it is handed: flipping the condition afterwards does not change which
// function a later call through the handed value reaches.
function twice(x) { return x * 2 }
function plus1(x) { return x + 1 }
let c = true
function keep(g: (x: i32) => i32): (x: i32) => i32 { return g }
const k = keep(if c { twice } else { plus1 })
c = false
print(k(7))
function pick(on) { return if on { twice } else { plus1 } }
c = true
const m = keep(pick(c))
c = false
print(m(7))
print(keep(pick(c))(7))
const held: (x: i32) => i32 = if !c { twice } else { plus1 }
c = true
print(held(7))
print(keep(if c { plus1 } else { twice })(7))
