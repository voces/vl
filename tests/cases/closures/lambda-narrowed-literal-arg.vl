// @run
// @log true
// @log false
// @log true
// D3076: a literal-union value narrowed out of a `K | i32` box and handed to an un-annotated
// lambda arrives as the literal's atom, from a walk variable and from a copy of one.
type K = "a" | "b"
const zz: (K | i32)[] = ["a", "b", 3]
const f = (w) => w == "a"
for e in zz {
  if !(e is i32) { print(f(e)) }
}
for e in zz {
  if !(e is i32) {
    const q = e
    if q == "a" { print(f(q)) }
  }
}
