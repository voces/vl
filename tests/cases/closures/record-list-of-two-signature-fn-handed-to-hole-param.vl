// @run
// @log 7
// A list of records of a function called at two signatures elsewhere, handed to a hole parameter.
// The hole's instance is keyed after the check, so the check's stamp is not where it is built.
function ident(a) { return a }
const recs = [{ f: ident }]
function twoSigs(k: i32) {
  const n = recs[k].f(2)
  return n + recs[k].f(2.5)
}
function take(a) {
  const v = a
  print(twoSigs(0) + v[0].f(2.5))
}
take([{ f: ident }])
