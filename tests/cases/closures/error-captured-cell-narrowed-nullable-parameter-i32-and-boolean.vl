// @emit-error the captured binding `k` is written with a function value whose type at this binding is not settled
// A nullable parameter typed over `T`, narrowed and written into a cell seeded with a generic, keeps its nullable representation, so it is refused (review of #3498, `rv3498/round6/n10_narrowed_param_into_generic_seeded_cell_two_inst`).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function third<Z>(z: Z) { print("T"); print(z) }
function a<T>(x: T, q: ((t: T) => void) | null) {
  let k = inner
  const w = () => {
    if q != null { k = q }
  }
  k(x)
  w()
  k(x)
}
a(1, (n: i32) => {
  print("Q"); print(n)
})
a(true, (b: boolean) => {
  print("Q"); print(b)
})
