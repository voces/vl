// @error-at 8:2 operator '+' is not defined for boolean and i32
// The price of D4010's close: this program printed `I` and `true` before it, correctly, because
// `plus` is written after the only call. The re-ask is flow-insensitive, as for a written `let`,
// so the later write is checked at the call's types and refused. Flow-sensitivity would run it.
function inner<U>(u: U) { print("I"); print(u) }
function plus<V>(v: V) { print(v + 1) }
function main() {
  const fs = [inner]
  fs[0](true)
  fs[0] = plus
}
main()
