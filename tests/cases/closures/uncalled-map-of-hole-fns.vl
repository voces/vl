// @run
// @log k
// @log j
// @log true
// @log 1
// @log 1
// @log 3
// @log 1
// @log k
// A map or list of un-annotated or generic functions that no read calls takes a value type
// of its own, through a record field too (D9100).
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function id<T>(a: T): T { return a }
const m = Map()
m["k"] = inc0
m["j"] = dbl
for k in m { print(k) }
const s = Map()
s.set("k", id)
print(s.has("k"))
const xs = [inc0]
const r = { xs: xs }
print(r.xs.length)
const ys = [id]
print(ys.length)
const n = Map()
n["k"] = inc0
print(inc0(2))
print(n.length)
const g = Map()
g["k"] = id
for k in g { print(k) }
