// @run
// @log 6
// @log 6
// @log 8
// @log 6
// @log 6
// @log 4
// @log 6
// A `let` list of un-annotated functions re-pointed to another list binding holds that binding's
// functions too: both literals are instanced at the one type the calls through it give, wherever
// the source is declared and whether it is annotated or generic (D9170).
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function ginc<T>(a: T): T { return a }
function dblA(a: i32) { return a * 2 }

const y1 = [dbl]
let x1 = [inc0]
x1 = y1
print(x1[0](3))

let x2 = [inc0]
const y2 = [dbl]
x2 = y2
print(x2[0](3))
print(y2[0](4))

const y3: ((a: i32) => i32)[] = [dblA]
let x3 = [inc0]
x3 = y3
print(x3[0](3))

const y4 = [dbl]
let x4 = [ginc]
x4 = y4
print(x4[0](3))

function main() {
  const ys = [dbl]
  let xs = [inc0]
  print(xs[0](3))
  xs = ys
  print(xs[0](3))
}
main()
