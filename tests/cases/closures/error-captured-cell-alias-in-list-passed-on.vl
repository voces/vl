// @emit-error an alias of a captured, reassigned function binding is stored in a list
// A list holding an alias of a cell's read that is read other than by an element call is refused: its calls cannot be held to the cell's one signature.
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function cb(f: (b: boolean) => void, b: boolean) { f(b) }
function callI(fs: ((n: i32) => void)[]) { fs[0](3) }
function main() {
  let k = inner
  const flip = () => {
    k = other
  }
  const r = k
  const fs = [r]
  callI(fs)
  cb(r, true)
}
main()
