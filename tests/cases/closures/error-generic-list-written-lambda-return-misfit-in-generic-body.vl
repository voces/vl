// @error a call through `fs[_]` returns string, and a function written there returns `i32` (the call's argument types)
// A written function's return is judged at each instance of the generic body that calls
// it, as its parameters are: `g("a")` expects `string` back and gets `i32` (D12331).
function pick<A, B>(a: A, b: B): A { a }
const fs = [pick]
fs[0] = (x: string, y: string) => 5
function g<T>(v: T): T { fs[0](v, v) }
print(g("a"))
