// @run
// @log 1.5
// @log 4
// @log 1.5
// @log 4
// The same two storages handed to one readonly-list parameter in the other order give the same
// two instances (D17816): a wide argument's call first, then a narrow one's, each handed on.
function inc(a: i32) { return a + 1 }
type W = (x: i32) => i32 | f64
function inner(z: readonly W[]) { print(z[0](3)) }
function outer(z: readonly W[]) { inner(z) }
const w: readonly W[] = [(x: i32): i32 | f64 => x / 2.0]
const b = [inc]
inner(w)
inner(b)
outer(w)
outer(b)
