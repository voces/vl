// @run
// @log 1.5
// @log 4
// A record's list field of two un-annotated functions, one overwritten through a parameter with a
// function of another result: each element runs its own function (D15190).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function put(o) { o.xs[0] = half }
const r = { xs: [inc0, inc0] }
put(r)
print(r.xs[0](3))
print(r.xs[1](3))
