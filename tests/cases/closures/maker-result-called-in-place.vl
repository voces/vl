// @run
// @log 3
// @log s
// @log 4
// @log 5
// A maker's open result called in place is built at the signature that call passes, as a `const`
// holding it and only called is: a returned binding, a returned literal, and each call's own type.
const lam = (x) => x
function mk() { return lam }
print(mk()(3))
print(mk()("s"))
function mkL() { return (x) => x + 1 }
print(mkL()(3))
function main() { print(mkL()(4)) }
main()
