// @run
// @log 3
// @log s
// @log 4
// @log 5
// @log a!
// A maker's open result is built at the signature its reach asks for: called in place, called
// through a `const` that holds it, each call at its own type, and a returned labelled block.
const lam = (x) => x
function mk() { return lam }
print(mk()(3))
print(mk()("s"))
function mkL() { return (x) => x + 1 }
print(mkL()(3))
function main() { print(mkL()(4)) }
main()
const xs = [1, 2, 3]
function ask(s) { return s + "?" }
function pick(t: i32) {
  return @B {
    for v in xs {
      function inner(s) { return s + "!" }
      function other(s) { return s + "#" }
      if v == t { break @B inner }
      if v == t + 10 { break @B other }
    }
    ask
  }
}
const q = pick(2)
print(q("a"))
