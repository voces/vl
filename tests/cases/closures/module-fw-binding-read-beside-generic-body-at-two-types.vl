// @run
// @info `q3` is never reassigned; use `const` instead of `let`
// @log 7
// @log s
// @log 2
// @log t
// @log 3
// @log 8
// @log 9
// @log u
// @log 4
// A module binding of `fw(id)` read by a module call beside a generic body that calls it at
// two types runs (D6321): read before the body, read from another function, and as a `let`.
function fw(f) { return f }
function id(x) { return x }
const q = fw(id)
print(q(7))
function g<T>(x: T) { print(q(x)) }
g("s")
g(2)
const q2 = fw(id)
function h2() { print(q2(8)) }
function g2<T>(x: T) { print(q2(x)) }
g2("t")
g2(3)
h2()
let q3 = fw(id)
print(q3(9))
function g3<T>(x: T) { print(q3(x)) }
g3("u")
g3(4)
