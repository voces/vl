// @run
// @log 1
// @log s
// @log loud
// @log 3
// @log 9
// A written binding of two generics called at two types, delivered through a list literal nested in a record literal at a
// closed function type, is delivered through an adapter and keeps the value it held there.
function id<T>(x: T): T { return x }
function loud<T>(x: T): T {
  print("loud")
  return x
}
type L = { gs: ((x: i32) => i32)[] }
function main() {
  let f = id
  print(f(1))
  print(f("s"))
  const l: L = { gs: [f] }
  f = loud
  print(f(3))
  print(l.gs[0](9))
}
main()
