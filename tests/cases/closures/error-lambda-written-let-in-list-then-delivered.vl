// @emit-error the reassigned function binding `k` holds functions called at more than one argument type
// A `let` written with an un-annotated lambda keeps one slot when its list read reaches one call
// type, since that write's lambda takes no instance per slot (D7102).
function other<V>(v: V) { print("O"); print(v) }
function cb(f: (b: boolean) => void, b: boolean) { f(b) }
function main() {
  let k = other
  const fs = [k]
  k = (n) => {
    print("L"); print(n)
  }
  fs[0](3)
  cb(k, true)
}
main()
