// @run
// @log 4
// @log 3.5
// @log 3.5
// @log 4
// @log 3
// @log s
// @log s
// @log 3
// Two record literals no binding holds name one un-annotated function, and each call through the
// field runs at its own signature, in either order and with a string beside a number (D15113).
function inc0(a) { return a + 1 }
function id0(a) { return a }
print({ f: inc0, n: 1 }.f(3))
print({ f: inc0, n: 1 }.f(2.5))
print({ f: inc0, n: 2 }.f(2.5))
print({ f: inc0, n: 2 }.f(3))
print({ f: id0, n: 1 }.f(3))
print({ f: id0, n: 1 }.f("s"))
function run() {
  const s = { f: id0, n: 3 }.f("s")
  const x = { f: id0, n: 3 }.f(3)
  print(s)
  print(x)
}
run()
