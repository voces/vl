// @check
// @error argument 1: expected (i32) => i32 | null, got (i32) => i32
// @error argument 1: expected (i32) => string | null, got (i32) => string
// @error argument 1: expected (i32) => ((i32) => i32) | null, got (i32) => ((i32) => i32)
// @hint Intentionally-unused parameter
// @hint Intentionally-unused parameter
// CONTRACT (must-error): a function type's param/result SLOTS are REP-INVARIANT, so a
// function VALUE may not flow into a slot whose wasm valtype differs from the one it was
// built at — even where the two types are ordinarily assignable.
//
// `fnSlotAssignable`'s header has stated the rule since the numeric pair (`() => i32` must
// not reach a `() => i64` slot): a function value's wasm functype fixes each param/result
// rep and NO ADAPTER THUNK EXISTS. Only the numeric half was enforced. The three rungs here
// are the same rule at three other valtype boundaries, and all three were `vl check`-clean
// before it, each reaching `wasm trap: indirect call type mismatch` at the first call —
// the callee's `call_indirect` names a `$fnsig` the value was never built at:
//
//   * an UNBOXED scalar into a BOXED one (`i32` result into an `i32 | null` result). The two
//     land in different STORAGE CLASSES — `elemStoreClassOf` already separates them for an
//     array element and a map value — so `containerElemClassDiffers` is the rung, asked of a
//     function slot for the first time rather than reimplemented for it.
//   * a plain REF into a NULLABLE ref (`string` into `string | null`), and
//   * the closure-valued twin (`(i32) => i32` into `((i32) => i32) | null`).
//     These two ride the SAME storage class on both sides, because a niche-nullable value
//     reps exactly as its base does INSIDE the container it sits in — which is true of an
//     array element and false of a function slot, where `(ref null $str)` and `(ref $str)`
//     are two valtypes and two `$fnsig`s. That difference is `fnSlotNulDiffers`, kept beside
//     the class rung rather than folded into the shared classifier, so arrays and maps keep
//     the collapse they need.
//
// A lambda LITERAL in any of these positions is unaffected and must stay so: the checker
// seeds the expected return and the body ADOPTS it, so the lambda reaches the comparison
// already at the destination type. That is the `control` rung, and it is why the reject
// here costs no expressiveness — the fix for a named function is to wrap it.
type F = (i32) => i32

function inc(x: i32) { x + 1 }
function s1(_x: i32) { "a" }
function idf(x: i32): F { return (y) => y + x }

function takeBox(f: (i32) => (i32 | null)) {
  const r = f(1)
  if r == null { print("N") }
}
function takeNulStr(f: (i32) => (string | null)) {
  const r = f(1)
  if r == null { print("N") }
}
function takeNulClo(f: (i32) => (F | null)) {
  const r = f(1)
  if r == null { print("N") }
}

export function boxRung() { takeBox(inc) }
export function nulStrRung() { takeNulStr(s1) }
export function nulCloRung() { takeNulClo(idf) }

// CONTROL — a lambda literal adopts the destination slot's type and must NOT error.
export function control() {
  takeBox((x) => x + 1)
  takeNulStr((_x) => "a")
  takeNulClo((x) => (y) => y + x)
}
