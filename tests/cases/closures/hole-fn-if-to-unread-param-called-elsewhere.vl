// @run
// @hint Intentionally-unused parameter `_p`
// @log 1
// @log z!
// An `if` expression of a hole function handed to a parameter nothing reads, while another use
// calls the function through a binding, gives the parameter the closure of that instance (D7000).
function exclaim(s) { return s + "!" }
function unread(_p) { print(1) }
const on = [1].length == 1
const f = exclaim
unread(if on { exclaim } else { exclaim })
print(f("z"))
