// @run
// @log 5
// @log t
// A record field holding a `const` alias of a generic inside a generic function instanced at
// two types: each instance calls through its own field (D5061).
function k<T>(x: T): T { return x }
function use<U>(u: U): U {
  const g = k
  const r = { q: g }
  return r.q(u)
}
print(use(5))
print(use("t"))
