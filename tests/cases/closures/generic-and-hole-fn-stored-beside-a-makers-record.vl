// @run
// @log 4
// @log 3.5
// @log 3
// @log 2.5
// @log 3
// @log 2.5
// @log 8
// @log 1.5
// @hint Intentionally-unused variable `_a` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_b` (leading `_` marks it unused)
// A generic or hole-parameter function stored where a maker's record of two signatures is held is
// that record, its own instance at each signature (D17737).
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
function dbl<T>(x: T): T { return x }
function idh(x) { return x }
const m = Map()
m["a"] = lap((a) => a + 1)
m["b"] = dbl
m["c"] = idh
for k in ["a", "b", "c"] {
  const h = m[k]
  if h != null {
    print(h(3))
    print(h(2.5))
  }
}
const xs = [lap((a) => a * 2), dbl]
print(xs[0](4))
print(xs[1](1.5))
