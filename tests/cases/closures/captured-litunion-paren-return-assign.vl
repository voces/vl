// @run
// @log b
// @log b
// @log b
// @log b
// A parenthesized `return (c = e)` over a literal-union cell a closure writes yields the string
// it stores, as the unparenthesized spelling does; the closure's printed value failed validation.
type K = "a" | "b"
function outer() {
  let c: K = "a"
  const set = () => {
    return (c = "b")
  }
  print(set())
  const r: string = set()
  print(r)
  print(c)
}
outer()
let k: K = "a"
function setK() { return (k = "b") }
print(setK())
