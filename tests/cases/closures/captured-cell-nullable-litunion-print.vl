// @run
// @log c
// @log c
// @log b
// @log a
// @log none
// @log b
// @log c
// @log none
// A nullable literal-union binding a closure writes prints its member text when read through
// its cell, bare, under a null check and as a list element (D3356).
type AB = "a" | "b" | "c"
function pick(n: i32): AB {
  if n == 1 {
    "a"
  } else {
    if n == 2 { "b" } else { "c" }
  }
}
function bare(n: i32) {
  let y: AB | null = null
  if n == 1 { y = pick(n) }
  const cf = () => {
    y = pick(3)
    0
  }
  cf()
  print(y)
}
function narrowed(n: i32) {
  let y: AB | null = null
  if n == 1 { y = pick(n) }
  const cf = () => {
    y = pick(2)
  }
  cf()
  if y != null { print(y) }
  let ys: (AB | null)[] = [y]
  const cg = () => {
    ys = [pick(n), null]
  }
  cg()
  for z in ys { print(z ?? "none") }
}
bare(1)
bare(7)
narrowed(1)
narrowed(3)
