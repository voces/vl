// @run
// @log 4
// @log 2.25
// @log 6
// A member of a function list read at two types is pushed onto a list of its set through a hole
// helper: the helper is built at the signature the list's calls give it, which the elaboration
// mints before it returns (D15062).
function inc0(a) { return a + 1 }
function dbl0(a) { return a * 2 }
function deliver0() { return [inc0] }
function take0(a) { print(a[0](3)) }
take0(deliver0())
print(deliver0()[0](1.25))
function addTo(xs, f) { xs.push(f) }
const fs = [dbl0]
addTo(fs, inc0)
print(fs[1](5))
