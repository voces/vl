// @run
// @log 1.5
// The map's records written by index and called through `?.` dispatch on the member each entry
// holds, as a `.get` read does (D9370, D16743).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const m = Map()
m["a"] = { f: inc0 }
m["b"] = { f: half }
print(m["b"]?.f(3) ?? 0)
