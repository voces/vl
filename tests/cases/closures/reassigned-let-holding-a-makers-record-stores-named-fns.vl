// @run
// @log 4
// @log 3
// @log 2.5
// @log 3
// @log 2.5
// @log 3
// @log 3
// @hint Intentionally-unused variable `_a` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_b` (leading `_` marks it unused)
// A `let` a maker's two-signature record initialises holds that record whole when a later write
// stores a generic or hole-parameter function: each is built as the record (D17804).
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
function dbl<T>(x: T): T { return x }
function idh(x) { return x }
let k = lap((a) => a + 1)
print(k(3))
k = dbl
print(k(3))
print(k(2.5))
let j = lap((a) => a + 1)
j = idh
print(j(3))
print(j(2.5))
function f() {
  let q = lap((a) => a + 1)
  q = dbl
  print(q(3))
}
f()
let c = lap((a) => a + 1)
if true { c = dbl }
print(c(3))
