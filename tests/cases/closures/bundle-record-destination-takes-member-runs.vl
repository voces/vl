// @run
// @log 5 2.5
// @log 7 4.5
// @log 6
// @log 5
// @info `g` is never reassigned; use `const` instead of `let`
// @hint Intentionally-unused variable `_a`
// @hint Intentionally-unused variable `_b`
// @hint Intentionally-unused variable `_t`
// A record of one closure per signature, held in a generic and handed back, delivered to an
// annotated binding of one of those signatures takes that member (D15146).
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
function gen<T>(t: T, k: i32) {
  const r = lap((a) => a + k)
  const _t = t
  return r
}
const v: (x: f64) => f64 = gen("s", 1)
print("\{v(4)} \{v(1.5)}")
let g: (x: f64) => f64 = gen(7, 3)
const w = g
print("\{w(4)} \{w(1.5)}")
if true {
  const b: (x: f64) => f64 = gen("t", 2)
  print(b(4))
}
const c: (x: f64) => f64 = gen("u", 1)
const z = 0
if z == 1 { print("unreached") }
else if c(4) == 5 { print(c(4)) }
