// @emit-error a list holding a generic function is called through its elements at more than one type
// A written `let` lists as its one generic only while every write names that generic (D9791); a
// write of a second generic leaves two functions the list's one instance would have to be.
function id<T>(x: T): T { x }
function dup<T>(x: T): T {
  print("dup")
  x
}
function la(n: i32) {
  let v = id
  if n > 0 { v = dup }
  const xs = [v]
  print(xs[0]("abc").length * 100 + xs[0](7))
}
la(0)
la(1)
