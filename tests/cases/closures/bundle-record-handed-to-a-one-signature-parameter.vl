// @run
// @hint redundant type annotation: `half` is inferred as `f64`
// @log 5
// @log 5
// @log s
// @log 5
// @log 7
// @log 8
// @log 3.5
// A returned bundle's record handed as an argument to a parameter annotated with one of its
// signatures: the argument is that member, at either signature, in a generic callee's two
// instances and in a callee with an annotated return.
function lap(f) {
  f(2.5)
  f(3)
  return f
}
function useF(g: (x: f64) => f64) { g(4) }
function useI(g: (x: i32) => i32) { g(4) }
function gen<T>(g: (x: f64) => f64, t: T) {
  print(t)
  g(4)
}
function half(g: (x: f64) => f64): f64 { g(1.5) }
function both(k: i32) { print(half(lap((a) => a + k))) }
print(useF(lap((a) => a + 1)))
print(useI(lap((a) => a + 1)))
print(gen(lap((a) => a + 1), "s"))
print(gen(lap((a) => a * 2), 7))
both(2)
