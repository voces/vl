// @run
// @log 1.5
// A list element written by index with a function of another result, read into a binding and
// called through it, runs that function (D9090, D14646).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const xs = [inc0]
xs[0] = half
const g = xs[0]
print(g(3))
