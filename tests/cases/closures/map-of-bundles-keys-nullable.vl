// @run
// A bundle whose closure returns a nullable value, walked by its keys then called (D17095).
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
const m = Map()
m["a"] = lap((a) => if a > 2 { a } else { null })
for k in m.keys() {
  const h = m[k]
  if h != null { print(h(4) ?? 0) }
}
// @log 4
// @hint Intentionally-unused variable `_a`
// @hint Intentionally-unused variable `_b`
