// @run
// @log ss
// @log 82
// @log 6
// @log 42
// The spellings D15133's refusal leaves alone: a readonly view, a source annotated at the closed
// type, and a list of one non-generic function shared by a mutable list.
function id<T>(x: T): T { return x }
function dbl<T>(x: T): T { return x + x }
function inc(x: i32) { return x + 1 }
let f = id
f = dbl
print(f("s"))
const zs = [f]
const view: readonly ((x: i32) => i32)[] = zs
print(view[0](41))
const typed: ((x: i32) => i32)[] = [f]
const shared: ((x: i32) => i32)[] = typed
print(shared[0](3))
const incs = [inc]
const plain: ((x: i32) => i32)[] = incs
print(plain[0](41))
