// @run
// @log aC
// @log bE
// @log cC
// @log dC
// @log eE
// @log fC
// @log gC
// @log hE
// @log iG
// @info `k1` is never reassigned; use `const` instead of `let`
// @warning Unused function `never`
// @hint redundant type annotation: `never` is inferred as `i32`
// @info `m1` is never reassigned; use `const` instead of `let`
// @info `p` is never reassigned; use `const` instead of `let`
// A chain of module-scope aliases of a hole lambda: each call reaches the lambda its link holds
// at that moment, with links reassigned in the same scope, in a function nothing calls, in a
// called function, and in a loop that copies one link into the next (D3854, D3856).
const c = (y) => y + "C"
const e = (y) => y + "E"
const g = (y) => y + "G"
let d = c
const d2 = d
print(d2("a"))
d = e
print(d("b"))
print(d2("c"))
let k1 = c
let k2 = k1
function never(): i32 {
  k2 = e
  0
}
let k3 = g
let i = 0
while i < 2 {
  k3 = k2
  i = i + 1
}
print(k3("d"))
let m1 = c
let m2 = m1
function setM2() { m2 = e }
setM2()
print(m2("e"))
print(m1("f"))
let n1 = c
let n2 = n1
n2 = n2
print(n2("g"))
n1 = e
print(n1("h"))
let p = g
const q = p
print(q("i"))
