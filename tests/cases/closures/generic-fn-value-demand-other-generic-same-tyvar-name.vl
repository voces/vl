// A function value whose type carries one generic's `T`, delivered at a concrete function type,
// is not re-asked when another generic's `T` takes a pin, nor when its own generic is called
// or delivered again at another type (D5290, D3946, D4017, D4159).
function j<T>(x: T): T { return x }
function k<T>(x: T): T { return x }
function apply(f: (x: i32) => i32) { print(f(6)) }
function dbl(x: i32) { return x * 2 }
function viaGen<T>(g: (x: T) => T) {
  apply(g)
  print(j("str"))
  const h: (x: i32) => i32 = g
  print(h(6) + 6)
}
function id<T>(x: T): T {
  print("I")
  return x
}
function call2(f: (x: i32) => i32, g: (x: string) => string) {
  print(f(1))
  print(g("s"))
}
function ci(f: (n: i32) => void, n: i32) { f(n) }
function inner<U>(u: U) { print(u) }
function gA<U>(u: U) { print(u) }
function gB<V>(v: V) { print(v) }
function cb(g: (x: boolean) => void) { g(true) }
function main() {
  viaGen(dbl)
  const h = k
  print(h(1))
  apply(h)
  print(j("str"))
  const i = id
  call2(i, i)
  const n = inner
  ci(n, 1)
  inner("s")
}
main()
const f = gA
cb(f)
let z = gB
z = gA
z(9)
