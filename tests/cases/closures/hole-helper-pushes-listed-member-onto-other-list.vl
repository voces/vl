// @run
// @log 2.25
// @log 6
// A function read out of one list and handed to a hole helper that pushes it onto another list
// is stored there as that list holds it (D15065).
function inc0(a) { return a + 1 }
function dbl0(a) { return a * 2 }
function deliver0() { return [inc0] }
print(deliver0()[0](1.25))
function addTo(xs, f) { xs.push(f) }
const fs = [dbl0]
addTo(fs, inc0)
print(fs[1](5))
