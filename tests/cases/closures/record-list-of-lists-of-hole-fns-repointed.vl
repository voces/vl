// @log 6
// @log 6
// A record holding un-annotated functions in a list of lists, re-pointed whole at a literal of
// another such function, joins both into one set at every depth (D16834).
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
let r = { f: [[inc0]] }
r = { f: [[dbl]] }
print(r.f[0][0](3))
let r3 = { f: [[[inc0]]] }
r3 = { f: [[[dbl]]] }
print(r3.f[0][0][0](3))
let rn = { a: { f: [[inc0]] } }
rn = { a: { f: [[dbl]] } }
print(rn.a.f[0][0](3))
let rk = { f: [[inc0]] }
rk = { f: [[dbl]] }
const k = rk.f[0][0]
print(k(3))
