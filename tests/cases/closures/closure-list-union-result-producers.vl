// @run
// @log 1
// @log 9
// @log 5
// @log 2
// @log true
// @log 1
// @log 4
// @log 8
// @log 1
// @log 22
// @log 21
// @log 1
// @log 32
// @log 31
// A list of closures whose result is a scalar-plus-list value union, called by index: each
// producer (pushed, stored by index, returned from a function, bound, or a named function of a
// narrower result) is converted to the union result where it is stored (D16889).
type R = (i64 | boolean)[] | i32
function useIt(f: (() => R)[]) {
  for g in f {
    const t0 = g()
    if t0 is (i64 | boolean)[] { print(t0.length) } else { print(t0) }
  }
  const t1 = f[0]()
  if t1 is (i64 | boolean)[] { print(t1[0]) } else { print(t1) }
}
const pushed: (() => R)[] = []
pushed.push((): R => [5])
pushed.push((): R => 9)
useIt(pushed)
const stored: (() => R)[] = [(): R => 3]
stored[0] = (): R => [true, 6]
useIt(stored)
function mk(c: boolean): () => R {
  if c { return (): R => [8 as i64] }
  return (): R => 4
}
useIt([mk(true), mk(false)])
const lst: (i64 | boolean)[] = [21]
const k = () => lst
useIt([k, () => 22])
const lst2: (i64 | boolean)[] = [31]
function named(): (i64 | boolean)[] { return lst2 }
function scalar() { return 32 }
useIt([named, scalar])
