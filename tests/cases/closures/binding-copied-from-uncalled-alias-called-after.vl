// The value copied from an alias no call goes through is called after the copy, at the
// copying binding's signature, from module scope and from a function called twice.
const c = (y) => y + y
const g = (y) => y
let d1 = g
const d2 = c
print(d2("a"))
let d3 = c
let i1 = 0
while i1 < 2 { d3 = d3; i1 = i1 + 1 }
function rw() { const r = d1(4); d1 = d3; r }
print(rw())
print(rw())
print(d1(4))
let p = g
let q = g
print(p(1))
print(q(3))
p = d3
q = d3
print(p(2))
print(q(4))
print(c("s"))
