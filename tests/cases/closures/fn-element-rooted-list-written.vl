// @run
// @log 1.5
// @log 1.5
// @log 1.5
// @log 4
// @log 1.5
// @log 1.5
// A list of functions inside a list literal's element, written through an alias of the element or
// directly: the writes join the slot's element set as a binding's own field's do, so a read through
// the container runs the written function (D15201, D15193).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function dbl(a) { return a * 2 }
const rs = [{ fs: [inc0] }]
const a = rs[0].fs
a[0] = half
print(rs[0].fs[0](3))
const ts = [{ fs: [inc0] }]
const e = ts[0]
e.fs[0] = half
print(ts[0].fs[0](3))
const xss = [[inc0]]
const b = xss[0]
b.push(half)
print(xss[0][1](3))
const two = [{ fs: [inc0] }, { fs: [dbl] }]
const c = two[1].fs
c[0] = half
print(two[0].fs[0](3))
print(two[1].fs[0](3))
const ds = [{ fs: [inc0] }]
ds[0].fs[0] = half
print(ds[0].fs[0](3))
