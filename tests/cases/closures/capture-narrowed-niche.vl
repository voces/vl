// @run
// @log a
// @log hi
// @log hi
// @log 1
// @hint redundant type annotation: `nulStringNeg` is inferred as `i32`
// The `: i32` the hint names is LOAD-BEARING and stays: `nulStringNeg` exists to spell the
// negated guard, a bare `return` is not supported, and a void function cannot carry the early
// `return 0` that spelling needs.
// A closure capturing a value the ENCLOSING FRAME narrowed off a NICHE — the other route to
// the same two misses, and a different route because nothing here is annotated with the
// narrowed type.
//
// `nulLitunion` is the niche twin of `capture-litunion-atom.vl`: a `K | null` capture rides the
// SAME i32 env field (`vtKindOfType` answers "i32" for both spellings), so `exprNulLitUnion`
// needed the capture channel too — one of the two classifiers seeing the capture and the other
// not would split one field.
//
// `nulString` / `nulStringNeg` are the `string | null` cell. Its env field is a
// `(ref null $array)` and EVERY other read of that cell recovers the non-null value type
// codegen expects (a param/local through `paramNulString`/`declaredNulString`, a global through
// `globalCellKind`); the capture read did a bare `struct.get` and stopped, so the closure
// returned `(ref null $array)` where its own `(ref $array)` result was declared. The recovery
// is decided by `captureValKind` — the function that CHOSE the field's type — under the
// `pendingRawNullRead`/`pendingNulString` gates the local and global reads use, which is why
// the closure-side `!= null` test in `capture-nullable-guards.vl` still reads the raw cell.
//
// The two guard spellings are kept apart on purpose: the `!= null` block and the `== null`
// early return reach the emitter through different narrowing state.
type K = "a" | "b"

function nulLitunion(k: K | null) {
  if k != null {
    const gk = () => k
    print(gk())
  }
}

nulLitunion("a")

function nulString(s: string | null) {
  if s != null {
    const gs = () => s
    print(gs())
  }
}

nulString("hi")

function nulStringNeg(s: string | null): i32 {
  if s == null { return 0 }
  const gn = () => s
  print(gn())
  return 1
}

print(nulStringNeg("hi"))
