// @run
// @log 2
// @log true
// @warning Unused parameter `f` (prefix with `_` to suppress, or remove it)
// An alias of a hole function no call instances, handed on and compared: the comparison reads
// the declaration's identity and calls nothing, so the stub the function prunes to is never
// observed (D6913, D7180).
function apply3(g) { print(g(1, 2)) }
function run(f) { print(2) }
const h = apply3
run(h)
print(h == h)
