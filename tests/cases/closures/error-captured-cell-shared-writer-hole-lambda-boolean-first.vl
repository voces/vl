// @emit-error the captured binding `k` is written with a function inside a closure that every instance of
// The same, with the boolean instance compiled first (review of #3498, `rv3498/e14_shared_writer_hole_lambda_bool_first`).
function inner<U>(u: U) { print("I"); print(u) }
function a<T>(x: T) {
  let k = inner
  const w = () => {
    k = (u) => {
      print("L"); print(u)
    }
  }
  k(x)
  w()
  k(x)
}
a(true)
a(1)
