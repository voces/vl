// @run
// @warning Unused parameter
// @log 3
// @log 1
// @log 30
// @log 0.75
// D10700's frame reached from a generic function that forwards its own hole parameter.
function add(a, b) { return a + b }
function apply2(g, s) {
  print(g(1, 2))
  print(g(s, s))
}
function apply3(g, s) {
  print(g(10, 20))
  print(g(s, 0.25))
}
function inner(k, h) {
  for f in [apply2, apply3] { f(add, k) }
}
function run<T>(x: T, h) { inner(0.5, h) }
run(1, add)
