// @emit-error the reassigned function binding `k` holds functions called at more than one argument type
// A cell seeded with a hole lambda and called at two argument types holds one closure signature,
// so it is refused rather than built at one of them (D3951).
function other<V>(v: V) {
  print("O")
  print(v)
}
function main() {
  let k = (x) => {
    print("L")
    print(x)
  }
  const flip = () => {
    k = other
  }
  k(1)
  flip()
  k("b")
}
main()
