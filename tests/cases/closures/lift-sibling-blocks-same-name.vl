// @run
// @log 10
// @log 20
// @log 8
// @log 4
// @log 6
// @log 15
// Lambdas bound to one name in sibling blocks are separate bindings: each is lifted on its own
// calls, and a binding of that name holding a value is not one of them.
for v in [1, 2] {
  const f = () => v * 10
  print(f())
}
if true {
  const w = 7
  const f = () => w + 1
  print(f())
}
{
  const f = 3
  const g = () => f + 1
  print(g())
}
function twice(n: i32) {
  if n > 0 {
    const f = () => n * 2
    print(f())
  }
  {
    const m = n * 5
    const f = () => m
    print(f())
  }
}
twice(3)
