// @error cannot write 'inc' to an element of 'ys': a call through it at (string) runs it, and it is (i32) => i32
// The same write refuses when the list reaches the call through an un-annotated function's return
// and an inferred binding (D10122).
function id<T>(x: T): T { x }
function inc(x: i32): i32 { x + 1 }
const ys = [id, id]
ys[1] = inc
function deliver() { return ys }
const v = deliver()
print(v[1]("s"))
