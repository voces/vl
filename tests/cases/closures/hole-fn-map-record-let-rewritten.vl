// @run
// @log 4
// @log 6
// @log 4
// @log 6
// @log 1
// @log 0
// @log 5
// A `let` record holding a map of un-annotated functions, reassigned with a fresh literal,
// keeps its field type, read at top level or inside a function; a `let` map reassigned with a
// fresh `Map()` keeps its value type (D9182).
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
const hm = Map()
hm["k"] = inc0
const hm2 = Map()
hm2["k"] = dbl
let v = { m: hm }
v = { m: hm }
const x = v.m["k"]
if x != null { print(x(3)) }
let u = { m: hm }
u = { m: hm2 }
const y = u.m["k"]
if y != null { print(y(3)) }
function show() {
  const z = v.m["k"]
  if z != null { print(z(3)) }
}
show()
let fm = Map()
fm["k"] = inc0
fm = Map()
fm["k"] = dbl
const fx = fm["k"]
if fx != null { print(fx(3)) }
print(fm.length)
function f() {
  let q = Map()
  q["a"] = inc0
  q = Map()
  print(q.length)
  q["b"] = inc0
  const qy = q["b"]
  if qy != null { print(qy(4)) }
}
f()
