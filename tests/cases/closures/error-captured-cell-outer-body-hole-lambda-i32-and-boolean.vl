// @emit-error the reassigned function binding `k` holds functions called at more than one argument type
// A hole lambda written in the generic body itself is still one lambda for both instances (review of #3498, `rv3498/e18_outer_body_hole_lambda_i32_bool`).
function inner<U>(u: U) { print("I"); print(u) }
function a<T>(x: T) {
  let k = inner
  const rd = () => {
    k(x)
  }
  rd()
  k = (u) => {
    print("L"); print(u)
  }
  rd()
}
a(1)
a(true)
