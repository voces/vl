// D3302: a null test of a closure-written name in the else arm, after the then arm called the
// writer, reads the narrowing standing at the condition. The field form writes through an alias.
// @run
// @log 2
// @log 2
// @log 5
// @warning Unused parameter `c1`
// @warning `bx.v == null` is always false here (bx.v is i32)
// @hint redundant type annotation: `f` is inferred as `i32`
// @hint redundant type annotation: `g` is inferred as `i32`
function nn(v: i32): i32 | null {
  if v < 0 { return null }
  return v
}
function f(k: i32, c1: boolean): i32 {
  let x = nn(k)
  const clr = () => {
    x = null
  }
  x = 7
  if x == null {
    clr()
  } else {
    if x == null { return 5 }
  }
  return 2
}
print(f(1, true))
type B = { v: i32 | null }
function g(c1: boolean): i32 {
  const bx: B = { v: 7 }
  const by = bx
  if bx.v == null {
    by.v = null
  } else {
    if c1 || bx.v == null { return 5 }
  }
  return 2
}
print(g(false))
print(g(true))
