// @run
// @hint Intentionally-unused parameter `_p`
// @log 1
// @log 1
// A list literal of an uncalled hole function handed to a parameter nothing reads is a list of
// the function's no-body stub (D7002).
function exclaim(s) { return s + "!" }
function g(_p) { print(1) }
g([exclaim])
g([exclaim, exclaim])
