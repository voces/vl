// @run
// @log a!q
// @log a?
// @log a!q
// @log b?
// @log a!qp
// @log a?
// @log a!q
// @log 13
// @log 20
// @log a!q
// @log a!q
// @log a?
// D13082: a labelled block hands over a hole function that reads the loop variable of the loop
// it is declared in, or the hole function declared before the block, as a binding, a returned
// value, from a nested loop, from a `while`, from a `const` lambda, at another type, and to a
// hole parameter.
function ask(s) { return s + "?" }
function g(xs: string[]) {
  const x = @B {
    for v in xs {
      function inner(s) { return s + "!" + v }
      if v == "q" { break @B inner }
    }
    ask
  }
  print(x("a"))
}
g(["p", "q"])
g(["p", "z"])

function h(xs: string[]) {
  return @B {
    for v in xs {
      function inner(s) { return s + "!" + v }
      if v == "q" { break @B inner }
    }
    ask
  }
}
print(h(["p", "q"])("a"))
print(h(["p"])("b"))

function nest(xs: string[]) {
  const x = @B {
    for v in xs {
      for w in xs {
        function inner(s) { return s + "!" + v + w }
        if v == "q" && w == "p" { break @B inner }
      }
    }
    ask
  }
  print(x("a"))
}
nest(["p", "q"])
nest(["p"])

function wh(xs: string[]) {
  const x = @B {
    let i = 0
    while i < xs.length {
      const v = xs[i]
      function inner(s) { return s + "!" + v }
      if v == "q" { break @B inner }
      i = i + 1
    }
    ask
  }
  print(x("a"))
}
wh(["p", "q"])

function dbl(s) { return s * 2 }
function num(xs: i32[]) {
  const x = @B {
    for v in xs {
      function step(s) { return s + v }
      if v == 3 { break @B step }
    }
    dbl
  }
  print(x(10))
}
num([1, 3])
num([1])

const lam = (s) => s + "?"
function cl(xs: string[]) {
  const x = @B {
    for v in xs {
      function inner(s) { return s + "!" + v }
      if v == "q" { break @B inner }
    }
    lam
  }
  print(x("a"))
}
cl(["p", "q"])

function apply(f, s: string) { return f(s) }
function arg(xs: string[]) {
  const x = @B {
    for v in xs {
      function inner(s) { return s + "!" + v }
      if v == "q" { break @B inner }
    }
    ask
  }
  print(apply(x, "a"))
}
arg(["p", "q"])
arg(["z"])
