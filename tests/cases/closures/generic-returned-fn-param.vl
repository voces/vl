// @run
// @log 42
// @log 42
// @log 7
// @log 42
// @log 8
// D9381: a generic over a function-typed parameter, returned from an un-annotated function, is
// instanced at the destination's function type, written inline or through an alias, and when an
// un-annotated parameter it is handed to calls it with an annotated lambda.
type F = (x: i32) => i32
function app<T>(f: (x: T) => T, x: T): T { f(x) }
function deliver() { return app }
const v: (f: (x: i32) => i32, x: i32) => i32 = deliver()
print(v((n) => n * 2, 21))
const va: (f: F, x: i32) => i32 = deliver()
print(va((n) => n * 2, 21))
function call<T>(f: () => T): T { f() }
function deliver2() { return call }
const c: (f: () => i32) => i32 = deliver2()
print(c(() => 7))
function app2<T>(f: (x: T) => T, x: T): T { f(x) }
function deliver3() { return app2 }
function take(g) {
  const h = g
  print(h((n: i32) => n * 2, 21))
}
take(deliver3())
function twice<T>(f: (x: T) => T, x: T): T { f(f(x)) }
function deliver4() { return twice }
const t: (f: F, x: i32) => i32 = deliver4()
print(t((n) => n * 2, 2))
