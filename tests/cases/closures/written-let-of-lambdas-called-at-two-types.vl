// @run
// @log 2
// @log 6
// @log 4.5
// @log 1
// @log s
// @log B
// @log 2
// @log B
// @log t
// A `let` written only lambdas, each called at two argument types, holds a set's id: a call
// reaches the lambda the binding holds at that call's own type, a call before the second lambda
// is checked included.
let f = (a) => a + 1
print(f(1))
f = (a) => a * 3
print(f(2))
print(f(1.5))
function bump1<T>(x: T): T { return x }
function bump2<T>(x: T): T {
  print("B")
  return x
}
let g = (a) => bump1(a)
print(g(1))
print(g("s"))
g = (a) => bump2(a)
print(g(2))
print(g("t"))
