// @run
// @log 1.5
// @log 3
// Two maps each filled with one generic through its own helper and read at different types,
// one also written a fixed-type function: each helper is instanced at its own map's closed
// type in the elaboration's run, not at the type the two maps share (D10023).
function id<T>(x: T): T { return x }
function inc(x: i32) { return x + 1 }
function fill(mm) { mm.set("k", id) }
function fillAt(mm) { mm.set("a", id) }
const m = Map()
fill(m)
m.set("k", inc)
const m4 = Map()
fillAt(m4)
const r4 = m4.get("a")
if r4 != null { print(r4(1.5)) }
const r = m.get("k")
if r != null { print(r(2)) }
