// @run
// @log 10
// @log 12
// @log 14
// @log 16
// @info `dbl2` is never reassigned
// An un-annotated lambda whose only use is a function slot of a wider result is called through
// the closure it was built at, its `i32` result widened by the delivery's adapter (D15897).
const dbl = (a) => a * 2
const v: (a: i32) => i32 | null = dbl
print(v(5) ?? 0)

let dbl2 = (a) => a * 2
const v2: (a: i32) => i32 | null = dbl2
print(v2(6) ?? 0)

const dbl3 = (a) => a * 2
function w(f: (a: i32) => i32 | null) { return f(7) ?? 0 }
print(w(dbl3))

const dbl4 = (a) => a * 2
const v4: (a: i32) => i32 | string = dbl4
print(v4(8))
