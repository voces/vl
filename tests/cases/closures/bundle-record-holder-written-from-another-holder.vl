// @run
// @log 6 3.5
// @log 5 2.5
// @log 5 2.5
// @log 5 2.5
// @log 11 2.5
// @log 5 2.5
// @hint Intentionally-unused variable `_a`
// @hint Intentionally-unused variable `_b`
// A `let` holding a returned record of one closure per signature, written from another such
// holder, holds that record whole: each call through it, or through its copy, takes its member.
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
const a = lap((x) => x + 1)
let b = lap((x) => x + 2)
print("\{b(4)} \{b(1.5)}")
b = a
print("\{b(4)} \{b(1.5)}")
print("\{a(4)} \{a(1.5)}")
function run(k: i32) {
  let p = lap((x) => x + k)
  let q = lap((x) => x + 2)
  q = p
  const v = q
  print("\{v(4)} \{v(1.5)}")
  p = lap((x) => x + 7)
  print("\{p(4)} \{q(1.5)}")
}
run(1)
const c = lap((x) => x + 1)
let d = lap((x) => x + 2)
if c(1) > 1.0 { d = c }
print("\{d(4)} \{d(1.5)}")
