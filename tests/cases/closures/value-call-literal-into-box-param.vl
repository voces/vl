// @run
// @log false
// @log true
// @log false
// @log true
// @log 5
// D3074: a literal-union value passed to a function value whose parameter is a box holding it
// (`K | i32`) reserves the string frame the box build stages the atom in, at the top level, in a
// lambda capturing the value and in a named function taken as a value.
type K = "a" | "b"
const q: K = "b"
const f = (w: K | i32) => w == "a"
print(f(q))
const h = (x: K) => f(x)
print(h("a"))
function f0(w: K | i32) { return w == "a" }
const f1 = f0
print(f1(q))
print(f1("a"))
const g = (w: K | i32) => if w is i32 { w + 1 } else { 0 }
print(g(4))
