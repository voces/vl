// @error cannot store 'half' in 'l[].f': called at (i32) it returns f64, where 'inc0', also stored in it, returns i32 — every function a call through 'l[].f' may run must return one type
// A list literal's record bound before its field is called is judged as the in-place read
// `l[1].f(3)` is (D9370).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const l = [{ f: inc0 }, { f: half }]
const r = l[1]
print(r.f(3))
