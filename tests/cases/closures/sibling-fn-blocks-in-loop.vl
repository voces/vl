// @run
// @log 1.5s

// D2316 matrix — one binding of the shared name sits inside a `for` loop body, its sibling
// in a plain block; the loop-body walk has to feed the same owner-tracked table as every
// other block kind.

function f() {
  let out = ""
  for i in [0] {
    const g = () => 1.5
    out = "\{g()}"
  }
  {
    const g = () => "s"
    out = out + g()
  }
  out
}
print(f())
