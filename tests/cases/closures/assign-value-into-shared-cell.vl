// @run
// @log 10
// @log 7
// @log 10
// @log 7
// A closure's value-position write to a binding it shares with its frame writes the shared cell,
// and when an operand before it is a call the cell is re-read and taken back to the right side's
// rep, exactly as the binding's own write is (D2557).
function k() { 3 }
function h(p: i32, q: i32) { p + q }
function wide() {
  let a = 0.0
  const cl = () => {
    print(h(k(), a = 7))
  }
  cl()
  print(a)
}
wide()
function wideI64() {
  let a: i64 = 0
  const cl = () => {
    print(h(k(), a = 7))
  }
  cl()
  print(a)
}
wideI64()
