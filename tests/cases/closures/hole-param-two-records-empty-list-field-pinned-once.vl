// @run
// @log 0.5
// @log 0.5
// @log 0
// Records written to an un-annotated list parameter share their empty list fields' element, so
// one push pins every record's field, by a push or an index store (D16365).
function take(a) {
  a.push({ ys: [] })
  a.push({ ys: [] })
  a[0].ys.push(0.5)
  print(a[0].ys[0])
}
take([])
function second(a) {
  a.push({ ys: [] })
  a[0] = { ys: [] }
  a.push({ ys: [] })
  a[1].ys.push(0.5)
  print(a[1].ys[0])
  print(a[0].ys.length)
}
second([])
