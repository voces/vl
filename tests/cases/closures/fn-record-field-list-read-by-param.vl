// @run
// @log 1.5
// @log 1.5
// @log 1.5
// @log 2.5
// @log 1.5
// A record's list field of functions written a function of another result type, handed to an
// un-annotated parameter that calls the element: the parameter reads the field's widened set,
// whether its function is declared before or after the call, through an alias of the element,
// a pushed member, or a parameter handed on (D15167).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function show(o) { print(o.xs[0](3)) }
function alias(o) {
  const f = o.xs[0]
  print(f(3))
}
function second(o) { print(o.xs[1](5)) }
function hand(o) { show(o) }
const r = { xs: [inc0] }
r.xs[0] = half
show(r)
alias(r)
after(r)
const p = { xs: [inc0] }
p.xs.push(half)
second(p)
hand(r)
function after(o) { print(o.xs[0](3)) }
