// @run
// @log 3
// @log 4
// @log 5
// @log 6
// @log 7

// D1933 — a closure capturing a FIELD-sourced nullable binding inside a module-scope BLOCK,
// then narrowed. The block binding's receiver resolves through no syntactic rung, so the
// capture's `nulstruct` env field takes its struct row from the recorded `S | null` type;
// absent that, the field has a kind with no shape. All four ingredients are load-bearing.

// Each control removes one ingredient and must keep running, printing a distinct value so a
// capture that reads another block's env prints a wrong one rather than passing.

type Rec = { name: string, n: i32 }
type MaybeRec = Rec | null

// The nullable field source is the ingredient: a `Rec | null` maker, the value in the arg.
function mkval(k: i32): MaybeRec { return { name: "ada", n: k } }

// A non-null maker for the `??` default, so the coalesced read is on a present value.
function mkrec(k: i32): Rec { return { name: "ada", n: k } }

// The witness: field-sourced nullable, captured, in a block, narrowed.
if true {
  const srcBox = { it: mkval(3) }
  const held = srcBox.it
  const get = () => held
  const v = get()
  if v != null { print(v.n) } else { print(0) }
}

// ── the ablation controls: each removes one ingredient and must keep running ──

// Hoisted to module top — no block. The healthy half of the pair.
const topBox = { it: mkval(4) }
const topHeld = topBox.it
const topGet = () => topHeld
const topV = topGet()
if topV != null { print(topV.n) } else { print(0) }

// No field source — the binding is the call directly.
if true {
  const held = mkval(5)
  const get = () => held
  const v = get()
  if v != null { print(v.n) } else { print(0) }
}

// No closure — the field read is bound and narrowed directly.
if true {
  const srcBox = { it: mkval(6) }
  const v = srcBox.it
  if v != null { print(v.n) } else { print(0) }
}

// No narrowing — a `??` default instead of an `if != null`.
if true {
  const srcBox = { it: mkval(7) }
  const held = srcBox.it
  const get = () => held
  const v = get()
  print((v ?? mkrec(0)).n)
}
