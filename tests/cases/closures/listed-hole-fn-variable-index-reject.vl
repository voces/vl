// @emit-error monomorphize: `a` is called at two instances of the function handed to it
// A list of a hole parameter called at two types splits only while every read of the list is a
// call at a literal index (D9653); a variable index cannot name one parameter per call.
function id<T>(x: T): T { x }
function take(a) {
  const xs = [a]
  let i = 0
  print(xs[i]("abc").length + xs[i](2))
}
take(id)
