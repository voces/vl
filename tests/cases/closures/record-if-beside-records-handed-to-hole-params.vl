// @run
// @log 4
// @log 4
// @log 1.25
// Records of un-annotated functions handed to un-annotated parameters beside a record `if` whose
// arms share none of their functions still run: the floor refuses only a join that shares its
// functions with records built at another signature (D15809).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function inc2(a) { return a + 1 }
function half2(a) { return a / 2.0 }
function two() { [1, 2].length }
function take(r) { return r.f(3) }
function take2(n, r) { return r.f(n) }
const q = if two() > 5 { { f: half } } else { { f: inc0 } }
print(take(q))
print(take2(3, { f: inc2 }))
print(take2(2.5, { f: half2 }))
