// @run
// @info `top` is never reassigned; use `const` instead of `let`
// @info `gs` is never reassigned; use `const` instead of `let`
// @info `hs` is never reassigned; use `const` instead of `let`
// @log 1
// @log 2.5
// @log 1
// @log 2.5
// @log 2
// @log 1
// @log 2.5
// @log 2
// @log 3
// @log 10
// @log 10
// @log 12
// @log 3
// A forwarded hole called through a `let`-bound list that nothing writes takes the same
// split as a `const` list (D13521); a list that is written keeps its own elements.
function add(a, b) { return a + b }
function apply2(g, s) { print(g(s, s)) }
function apply4(g, s) { print(g(s, 2)) }
function innerThree(k, h) {
  let gs = [apply2, apply4]
  for f in gs { f(h, k) }
}
innerThree(0.5, add)
// The list bound at the top level.
let top = [apply2, apply4]
function viaTop(k, h) {
  for f in top { f(h, k) }
}
viaTop(0.5, add)
// The list read before the loop.
function counted(k, h) {
  let gs = [apply2, apply4]
  print(gs.length)
  for f in gs { f(h, k) }
}
counted(0.5, add)
// Lists reassigned, pushed and written before the loop print what was written.
function a(x: i32) { print(x) }
function b(x: i32) { print(x + 1) }
function c(x: i32) { print(x + 2) }
let ws = [a, b]
ws = [b, c]
for f in ws { f(1) }
function m() {
  let hs = [a, b]
  hs.push(c)
  hs[1] = a
  for f in hs { f(10) }
  print(hs.length)
}
m()
