// @run
// @log 4
// @log 3
// @log 4
// @log 3
// The `i32` call of a hole also called at `f64` delivered to an annotated binding and to an
// `i32` parameter, the two other positions of D8061.
function add(a, b) { return a + b }
function need(x: i32) { print(x) }
function p(g) {
  print(g(1.5, 2.5))
  const r: i32 = g(1, 2)
  print(r)
}
function q(g) {
  print(g(1.5, 2.5))
  need(g(1, 2))
}
p(add)
q(add)
