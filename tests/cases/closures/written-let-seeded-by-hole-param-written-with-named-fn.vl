// @run
// @log 3
// @log 2
// @log 2.25
// A `let` initialised with a hole parameter and written with a named function holds the
// parameter's function and the written one, each called at its own instance (D15018).
function add(a, b) { return a + b }
function mul(a, b) { return a * b }
function two(g) {
  print(g(1, 2))
  print(g(0.5, 1.5))
}
two(add)
function swap(h) {
  let hh = h
  hh = mul
  print(hh(1.5, 1.5))
}
swap(add)
