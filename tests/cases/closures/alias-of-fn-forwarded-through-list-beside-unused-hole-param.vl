// @run
// @log 2.25
// @log 2.25
// @log 4
// @info `hh` is never reassigned; use `const` instead of `let`
// @hint Intentionally-unused parameter `_h` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_h` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_h` (leading `_` marks it unused)
// A local alias of a function, forwarded through a list call beside an unused hole parameter
// handed that function, hands the function as its id, as the name itself does (D15046).
function mul(a, b) { return a * b }
function same(g, s) { print(g(s, s)) }
function viaConst(k, _h) {
  const hh = mul
  for f in [same] { f(hh, k) }
}
viaConst(1.5, mul)
function viaLet(k, _h) {
  let hh = mul
  for f in [same] { f(hh, k) }
}
viaLet(1.5, mul)
function viaChain(k, _h) {
  const a = mul
  const b = a
  for f in [same] { f(b, k) }
}
viaChain(2.0, mul)
