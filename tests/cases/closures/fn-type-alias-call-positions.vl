// @run
// @log 2
// @log 2
// @log 2
// @log 2
// An alias-spelled FUNCTION type is CALLABLE — in every position.
//
// The parser encodes every non-`{…}`-bodied `type N = …` as a one-member `UnionDecl`, so
// before D-ALIASFN an arrow-bodied alias denoted `TyUnion[TyFunc]` — and a union is not
// callable. Every call through `F` was a CHECKER error in every position, with the message
// `called value is not a function ((i32) -> i32)`, which reads as nonsense precisely
// because `tyToStr` renders a one-member union as its member. The inline spelling
// `((i32) => i32)` ran in all four. `singleAliasMemberTyIx` now admits a `TyFunc` member,
// so the alias denotes its member and the two spellings are indistinguishable.
//
// `g` and `h` earn a redundant-annotation HINT (below the wasm lint tier's threshold, so
// undeclared). It is pre-existing and spelling-independent: the inline annotation and the
// already-transparent `type Id = i32` earn the identical hint on the parent commit.

type F = (i32) => i32

function inc(a: i32) { a + 1 }

const g: F = inc
print(g(1))

function useLocal() {
  const h: F = inc
  h(1)
}
print(useLocal())

function takes(f: F) { f(1) }
print(takes(inc))

function makes(): F { inc }
const m = makes()
print(m(1))
