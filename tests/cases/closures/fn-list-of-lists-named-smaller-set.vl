// @run
// @log 2
// @log 4
// @log 1.5
// @log 3
// @log 1.5
// @log 6
// @log 4
// @log 1.5
// @log 1.5
// @log 1.5
// A named or returned list of un-annotated functions, of a set within a wider list of lists'
// set, as an element of that list or pushed onto it: its ids are the wider set's (D16812).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function dbl(a) { return a * 2 }
const q = [half]
print(q[0](4))
const xs = [[inc0], q]
for x in xs { print(x[0](3)) }
print(q[0](6))
const ys = [[dbl], q]
print(ys[1][0](3))
print(ys[0][0](3))
function mk() { return [half] }
const zs = [[inc0], mk()]
print(zs[0][0](3))
print(zs[1][0](3))
const ws = [[inc0]]
ws.push(q)
print(ws[1][0](3))
const vs = [[inc0]]
vs.push(mk())
print(vs[1][0](3))
