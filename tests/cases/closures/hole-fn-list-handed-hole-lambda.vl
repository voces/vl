// @run
// @log 3
// @log 30
// @log 4
// @log 31
// @log 2
// @log -1
// @log 10
// @log 2
// @log 200
// A list of hole functions, iterated, indexed or joined by an `if`, handed an un-annotated lambda
// or a `const` of one, takes the lambda at the type the elements' own calls give it (D7846).
function apply2(g) { print(g(1, 2)) }
function apply3(g) { print(g(10, 20)) }
const fs = [apply2, apply3]
for f in fs { f((a, b) => a + b) }
function run(k: i32) {
  const ks = [apply2, apply3]
  for f in ks { f((a, b) => a + b + k) }
  ks[0]((a, b) => a * b)
  const c = k > 0
  const h = if c { apply2 } else { apply3 }
  h((a, b) => a - b)
  (if c { apply3 } else { apply2 })((a, b) => b - a)
}
run(1)
function viaConst() {
  const ls = [apply2, apply3]
  const l = (a, b) => a * b
  for f in ls { f(l) }
}
viaConst()
