// @run
// @log 4
// @log 3.5
// A generic helper over a map of its type parameter, handed a map of un-annotated functions, calls
// the value it reads at the set's member signatures (D17014).
function inc(x) { return x + 1 }
function dbl(x) { return x + x }
function callAt<V>(m: {[string]: V}, k: string) {
  const f = m.get(k)
  if f != null { print(f(2)) }
}
const m = Map()
m["a"] = inc
m["b"] = dbl
callAt(m, "b")
const h = m.get("a") ?? dbl
print(h(2.5))
