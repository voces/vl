// @run
// @log -4
// @log a!
// @log -4
// @log b!
// @log -5
// @log c!
// A written `let` of lambdas that call their parameter, called at two types: every call of each
// lambda is the set's arm, so each takes its own instance per call. The last write is in a
// function the binding's frame calls.
function negT(a: i32) { return 0 - a }
function up(s: string) { return s + "!" }
let l3 = (g, x) => g(x)
l3 = (g, x) => g(x)
print(l3(negT, 4))
print(l3(up, "a"))
let l4 = (g, x) => g(x)
l4 = (g, x) => g(x)
l4 = (g, x) => g(x)
print(l4(negT, 4))
print(l4(up, "b"))
let l5 = (g, x) => g(x)
function setIt() { l5 = (g, x) => g(x) }
setIt()
print(l5(negT, 5))
print(l5(up, "c"))
