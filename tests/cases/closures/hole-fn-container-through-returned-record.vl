// @log 5
// @log 4
// A map or list of un-annotated lambdas held in a record a function or lambda returns, read
// through the call in place or by a `const`, at module scope or in a function body, beside a
// scalar field, and through a nested record.
const f = (a) => a + 1
const hm = Map()
hm["k"] = f
function use() {
  const mk3 = () => {
    return { m: hm }
  }
  const w = mk3()
  const y = w.m["k"]
  if y != null { print(y(3)) }
}
use()
const mk1 = () => {
  return { m: hm }
}
const w1 = mk1()
const y1 = w1.m["k"]
if y1 != null { print(y1(3)) }
function mk() { return { m: hm } }
function use2() {
  const y = mk().m["k"]
  if y != null { print(y(3)) }
}
use2()
const hl = [f]
function mkl() { return { xs: hl } }
print(mkl().xs[0](3))
let c = 1
const cf = (a) => a + c
c = 2
const cm = Map()
cm["k"] = cf
function mkc() { return { m: cm, n: 5 } }
const yc = mkc().m.get("k")
if yc != null { print(yc(3)) }
print(mkc().n)
function mkn() { return { r: { m: hm } } }
const yn = mkn().r.m["k"]
if yn != null { print(yn(3)) }
