// @emit-error the function binding `g`, a copy of a reassigned binding, is called at more than one argument type
// A `const` copy of a written `let` of generics, called at a type the `let` is not, is named as
// the copy it is (D4240).
function gA<U>(u: U) {
  print("A")
  print(u)
}
function gB<V>(v: V) {
  print("B")
  print(v)
}
let f = gA
f = gB
const g = f
f(2)
g(true)
