// @emit-error the reassigned function binding `f` holds functions called at more than one argument type
// A `const` copy of a written `let` of generics, called at a type the `let` is not: the copy's
// call is one of the pins the `let`'s value flows to, so the `let` is refused whichever call
// comes first (D4240).
function gA<U>(u: U) {
  print("A")
  print(u)
}
function gB<V>(v: V) {
  print("B")
  print(v)
}
let f = gA
f = gB
const g = f
f(2)
g(true)
