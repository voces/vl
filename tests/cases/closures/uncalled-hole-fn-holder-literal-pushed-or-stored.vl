// @run
// @log 9
// @log 9
// @log 8
// @log 2
// @log 3
// A list or record literal holding a list of an uncalled hole function's closures, pushed or
// stored into a holder, is delivered at the type its declaration lays it out at: a push, an
// element store, a field store, a push of a list, and a push of a record of lists (D17742).
function inc0(a) { return a + 1 }
const r0 = [[{ n: 7, fs: [inc0] }]]
r0[0].push({ n: 9, fs: [inc0] })
print(r0[0][1].n)

function inc1(a) { return a + 1 }
const r1 = [[{ n: 7, fs: [inc1] }]]
r1[0][0] = { n: 9, fs: [inc1] }
print(r1[0][0].n)

function inc2(a) { return a + 1 }
const r2 = { a: [{ n: 7, fs: [inc2] }] }
r2.a = [{ n: 8, fs: [inc2] }]
print(r2.a[0].n)

function inc3(a) { return a + 1 }
const r3 = [[[inc3]]]
r3.push([[inc3]])
print(r3.length)

function inc4(a) { return a + 1 }
const r4 = [{ g: [[inc4]] }]
r4.push({ g: [[inc4], [inc4]] })
r4.push({ g: [[inc4]] })
print(r4.length)
