// @run
// @log 6
// @log 4
// Un-annotated functions of one result written into one un-annotated `Map()` are not refused
// (D9311's control).
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
const m = Map()
m.set("a", inc0)
m["b"] = dbl
const x = m.get("b")
if x != null { print(x(3)) }
const y = m["a"]
if y != null { print(y(3)) }
