// @run
// @log 1.5
// @log 2
// @log 3
// @log 4
// A record holding a generic function is not built at an annotated record row of the same field
// names whose function signature no binding of its type parameter gives: `(T) => T` is no
// `(a: i32) => f64`, so the map slot it is written into and the literal agree on one row.
function half(a: i32) { return a / 2.0 }
function inc(a: i32) { return a + 1 }
function id<T>(x: T): T { x }
const b: {f: (a: i32) => f64} = { f: half }
print(b.f(3))
const j = Map()
j["k"] = { f: inc }
const g = Map()
g["k"] = { f: id }
print(g["k"]?.f(2) ?? 0)
const s = Map()
s.set("k", { f: inc })
s.set("m", { f: id })
const c = s.get("m")
if c != null { print(c.f(3)) }
const r = { f: id }
print(r.f(4))
