// @run
// @log 9
// @log 9
// @log 3
// @log 3
// @log 2
// @log 2
// @log 7
// @log 7
// @log 1
// @log 1
// @log 4
// @log 4
// @log 9
// @log 9
// @log 9
// @log 9
// @log 9
// @log 9
// @log 3
// @log 3
// @log E
// @log E
// @info `t2` is never reassigned; use `const` instead of `let`
// @hint redundant type annotation: `c3` is inferred as `i32[][][]`
// @hint redundant type annotation: `t2` is inferred as `i32[][]`
// @hint redundant type annotation: `rb2` is inferred as `{a: i32}[][]`
// Those three hints are ACCURATE for the non-null `reflist` reps — dropping the annotation
// keeps these programs working, because the un-annotated classifier reaches the same ref-list
// row through the initializer. They are declared, not acted on, because the ANNOTATED spelling
// is the one that used to be rejected, so it is the one worth pinning. (The nullable sibling
// case carries the same hints for annotations that are genuinely load-bearing.)
// The `let` on `t2` is deliberate: `let` and `const` are separate BINDING FORMS at a capture
// position and both are exercised here, so the info stands rather than being silenced.
//
// A REF-ELEMENT array (`VKind` `reflist`) captured by a nested function or a lambda. The
// deciding axis is the captured value's REP, not the array's nesting depth: a depth-ONE
// `S[]`, `U[]`, `((i32) => i32)[]` and `{[string]: V}[]` are `reflist` exactly as `i32[][]`
// is, and all five failed identically while the scalar-backed arrays (`i32[]`, `string[]`,
// `f64[]`, …) were always fine — those are the `list` / `strlist` / `f64list` kinds.
//
// TWO ENDS, one mechanism. The env FIELD's valtype needs the ref-list TABLE SLOT beside its
// kind (`captureValStructIdx` -> `annValtypeSlotOf`), and the READ inside the callee needs
// the same slot to know it is indexing a ref list at all (`exprRefArray` /
// `refListElemNameOfExpr` -> `capturedRefListSlot`). Fixing only the field types a
// `(ref $wrapper)` cell the body then reads as something else; fixing only the read asks for
// a slot the field never got. Each PAIR below prints the captured read and then the
// IDENTICAL uncaptured read, so their agreement is the assertion.

type S = { a: i32 }
type U = i32 | string
type K = "p" | "q"

function mkClos(): ((i32) => i32)[] { return [(n: i32) => n + 8] }
function mkMaps(): {[string]: i32}[] {
  const m: {[string]: i32} = Map()
  m["k"] = 4
  return [m]
}
function sinkNest(q: i32[][]) { print(q[0][0]) }

// A ref-list PARAMETER captured by a nested named function.
function pDepth2(xs: i32[][]) {
  function inNest() { print(xs[0][0]) }
  inNest()
}
function pDepth2Ctl(xs: i32[][]) { print(xs[0][0]) }

// A depth-ONE struct-element array — `reflist` at nesting depth 1.
function pStructArr(xs: S[]) {
  function inStruct() { print(xs[0].a) }
  inStruct()
}
function pStructArrCtl(xs: S[]) { print(xs[0].a) }

// A union-box element array.
function pUnionArr(xs: U[]) {
  function inUnion() { print(xs.length) }
  inUnion()
}
function pUnionArrCtl(xs: U[]) { print(xs.length) }

// A closure-element array: `xs[0](…)` through the env field.
function pCloArr(xs: ((i32) => i32)[]) {
  function inClo() { print(xs[0](-1)) }
  inClo()
}
function pCloArrCtl(xs: ((i32) => i32)[]) { print(xs[0](-1)) }

// A map-element array.
function pMapArr(xs: {[string]: i32}[]) {
  function inMapA() { print(xs.length) }
  inMapA()
}
function pMapArrCtl(xs: {[string]: i32}[]) { print(xs.length) }

// A literal-union element, two deep.
function pLitU(xs: K[][]) {
  function inLitU() { print(xs[0].length) }
  inLitU()
}
function pLitUCtl(xs: K[][]) { print(xs[0].length) }

function locals() {
  // An ANNOTATED `const` local, read three deep.
  const c3: i32[][][] = [[[9, 8]]]
  function inC3() { print(c3[0][0][0]) }
  inC3()
  print(c3[0][0][0])

  // An UN-ANNOTATED local, captured through an ARROW lambda.
  const u2 = [[9, 8]]
  const inU2 = () => {
    print(u2[0][0])
  }
  inU2()
  print(u2[0][0])

  // TWO frames deep, and passed ON to a ref-list parameter from the inner frame.
  let t2: i32[][] = [[9, 8]]
  function outT2() {
    function inT2() { sinkNest(t2) }
    inT2()
  }
  outT2()
  sinkNest(t2)

  // REBINDING the capture to an un-annotated local inside the callee, then indexing that.
  const rb2: S[][] = [[{ a: 3 }]]
  function inRb2() {
    const t = rb2
    print(t[0][0].a)
  }
  inRb2()
  const tCtl2 = rb2
  print(tCtl2[0][0].a)

  // An EMPTY outer array is the same rep and the same answer.
  const e2: S[][] = []
  function inE2() {
    if e2.length > 0 { print(e2[0].length) } else { print("E") }
  }
  inE2()
  if e2.length > 0 { print(e2[0].length) } else { print("E") }
}

pDepth2([[9, 8]])
pDepth2Ctl([[9, 8]])
pStructArr([{ a: 3 }])
pStructArrCtl([{ a: 3 }])
pUnionArr([1, "z"])
pUnionArrCtl([1, "z"])
pCloArr(mkClos())
pCloArrCtl(mkClos())
pMapArr(mkMaps())
pMapArrCtl(mkMaps())
pLitU([["p", "q", "p", "q"]])
pLitUCtl([["p", "q", "p", "q"]])
locals()
