// @run
// @log 5
// @log v
// A maker's generic result stored in a record field and called in a generic body at its type
// parameter runs when the body is called at two types.
function k<T>(x: T): T { return x }
function mk() { return k }
function g<U>(u: U) {
  const r = { f: mk() }
  print(r.f(u))
}
g(5)
g("v")
