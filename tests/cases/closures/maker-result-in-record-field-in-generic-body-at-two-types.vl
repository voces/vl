// @run
// @log 5
// @log v
// @log 1
// @log z
// @log 6
// @log w
// A maker's generic result stored in a record field and called in a generic body at its type
// parameter runs when the body is called at two types, also beside another body binding the
// same maker's result (D6341).
function k<T>(x: T): T { return x }
function mk() { return k }
function g<U>(u: U) {
  const r = { f: mk() }
  print(r.f(u))
}
g(5)
g("v")
function mk2() { return k }
function g2<U>(u: U) {
  const r = { f: mk2() }
  print(r.f(u))
}
function g3<U>(u: U) {
  const a = mk2()
  print(a(u))
}
g2(1)
g2("z")
g3(6)
g3("w")
