// An empty `Map()` or `Set()` a hole template allocates is fresh per instance, as `[]` is: two
// instances at different value, key or element types each build their own (D16602, D16968, D17005).
function ef(a: i32, b: Map<string, f64>) { return a + b.length }
function es(a: i32, b: Map<string, string>) { return a * 2 + b.length }
function ek(a: i32, b: Map<i32, f64>) { return a * 3 + b.length }
function empty(h) { return h(3, Map()) }
print(empty(ef) + empty(es))
print(empty(ef) + empty(ek))
function bound(h) {
  const m = Map()
  return h(3, m)
}
print(bound(ef) + bound(es))
function si(a: i32, b: Set<i32>) { return a + b.length }
function ss(a: i32, b: Set<string>) { return a * 2 + b.length }
function emptySet(h) { return h(3, Set()) }
print(emptySet(si) + emptySet(ss))
// @log 9
// @log 12
// @log 9
// @log 9
