// @run
// @log a
// @log zz
// @log b
// @log N
// @log zz
// @log D
// @log a
// @log null
// D3161: an un-annotated copy of a value narrowed to a nullable string out of a wider box, and a
// copy of that copy, captured by a closure, reads the nullable string the copy holds.
type K = "a" | "b"
function t(e: K | string | null | i32) {
  if !(e is i32) {
    const c = e
    const f = () => c
    const r = f()
    if r == null { print("N") } else { print(r) }
  }
}
t("a")
t("zz")
t("b")
t(null)
function u(e: string | null | boolean) {
  if !(e is boolean) {
    const c0 = e
    const c = c0
    const f = () => c
    print(f() ?? "D")
  }
}
u("zz")
u(null)
function w(e: K | string | null | f64) {
  if !(e is f64) {
    const c = e
    const f = () => c
    print(f())
  }
}
w("a")
w(null)
