// @run
// @log 5
// @log t
// @log 5
// @log t
// @log 7
// @log u
// A record field holding a written `let` of a generic, inside a generic function instanced at
// two types: each instance calls through the field, directly, through a `const` alias of the
// read, and with the field written from a branch (D5079).
function k<T>(x: T): T { return x }
function k2<T>(x: T): T { return x }
function use<U>(u: U): U {
  let g = k
  g = k
  const r = { q: g }
  return r.q(u)
}
function alias<U>(u: U): U {
  let g = k
  g = k
  const r = { q: g }
  const h = r.q
  return h(u)
}
function branch<U>(u: U, b: boolean): U {
  let g = k
  if b { g = k2 }
  const r = { q: g, n: 3 }
  if r.n > 2 { return r.q(r.q(u)) }
  u
}
print(use(5))
print(use("t"))
print(alias(5))
print(alias("t"))
print(branch(7, true))
print(branch("u", false))
