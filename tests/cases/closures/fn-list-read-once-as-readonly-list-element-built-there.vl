// @run
// A bound list of one generic function delivered as the element of a list of readonly closed
// function lists is already built at that element's type, so no copy is made (D17753).
function __id<T>(x: T): T { return x }
const __zs = [__id]
const xs: (readonly ((x: i32) => i32)[])[] = [__zs]
print(xs[0][0](41) * 2)
function main() {
  const zs = [__id]
  const ys: (readonly ((x: i32) => i32)[])[] = [zs]
  print(ys[0][0](20) + 1)
}
main()
const __ws = [__id]
const vs: (readonly ((x: i32) => i32)[])[] = [__ws, __ws]
print(vs[1][0](3))
const __us = [__id]
const us = [__us]
print(us[0][0](5))
// @log 82
// @log 21
// @log 3
// @log 5
