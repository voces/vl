// @emit-error emitProgram: the function written to this element returns another type than the element's, at the arguments its calls pass — a list holds functions of one type
// A record's list field of an un-annotated function, read before a helper writes one returning
// another type: the field's one call signature is not a fact, because the function the field
// already holds does not return that result there, so the write is refused where it is made.
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function put(o) { o.xs[0] = half }
const r = { xs: [inc0] }
print(r.xs[0](3))
put(r)
print(r.xs[0](3))
