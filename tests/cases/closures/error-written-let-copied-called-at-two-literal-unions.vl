// @emit-error holds functions called at more than one argument type
// A copy called with one string literal union and the binding it copies called with another
// would read one union's tag as the other's (D4244).
function gA<U>(u: U) {
  print("A")
  print(u)
}
function gB<V>(v: V) {
  print("B")
  print(v)
}
function gC<W>(w: W) {
  print("C")
  print(w)
}
type S = "p" | "q"
type R = "p" | "r"
const a: S = "q"
const b: R = "r"
let x = gA
x = gB
let y = gC
y = x
x(b)
y(a)
