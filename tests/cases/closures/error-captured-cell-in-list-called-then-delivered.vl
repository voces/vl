// @emit-error the reassigned function binding `k` holds functions called at more than one argument type
// @warning Unused variable `flip` (prefix with `_` to suppress, or remove it)
// A written capture cell placed directly in a list and called through it at one type is a call through the cell, so a delivery at another type is refused (D3977, `rv3501/round2/q05a`).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function cb(f: (b: boolean) => void, b: boolean) { f(b) }
function main() {
  let k = inner
  const flip = () => {
    k = other
  }
  const fs = [k]
  fs[0](3)
  cb(k, true)
}
main()
