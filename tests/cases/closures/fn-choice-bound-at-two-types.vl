// A `const` bound to an `if` or `match` choosing between generic functions, used at more than
// one type: called directly, handed to a generic parameter, or read as a `.map` callback. Each
// type gets a binding of its own, the condition being a pure read evaluated again (D9120,
// D9121).
function idg<T>(t: T): T { return t }
function kg<T>(t: T): T { return t + t }
function tg<T>(t: T): T { return t + t + t }
function app<T>(g: (x: T) => T, v: T): T { return g(v) }
const c = [1].length > 0
const k = [1, 2].length
const h1 = if c { kg } else { idg }
print(h1(3))
print(h1("x"))
print(h1(1.5))
const h2 = if c { kg } else { idg }
print(app(h2, 3))
print(app(h2, "y"))
const h3 = if !c { idg } else { kg }
print([3].map(h3)[0])
print(["z"].map(h3)[0])
const h4 = match k {
  2 => kg
  _ => idg
}
print(h4(4))
print(app(h4, "w"))
const h5 = if c { kg } else { idg }
const h6 = h5
const h7 = h6
print(h7(5))
print(app(h7, "v"))
const h8 = if k == 1 { idg } else if k == 2 { tg } else { kg }
print(h8(2))
print(h8("u"))
const h9 = if c { kg } else { idg }
print(h9(3))
print(app(h9, "t"))
print([1.5].map(h9)[0])
function run(b: boolean) {
  const h = if b { kg } else { idg }
  print(h(3))
  print(app(h, "s"))
}
run(true)
run(false)
function f<S>(v: S): S {
  const h = if c { kg } else { idg }
  print(h("r"))
  return h(v)
}
print(f(3))
const h10 = if c { kg } else { idg }
print(h10(6))
print(app(h10, 7))
