// @run
// @log 6
// @log 5
// A function returning an `if` of two un-annotated functions returns a set its caller dispatches.
function inc(a) { return a + 1 }
function dbl(a) { return a * 2 }
function sel(c: boolean) { return if c { inc } else { dbl } }
const g = sel(false)
print(g(3))
print(g(2.5))
