// @run
// @log 4
// @log 1.5
// @log 4
// @log 1.5
// @log 6
// @log 6
// @log 0.75
// @log 4
// @log 1.5
// @log 1.5
// A list of lists of lists of un-annotated functions whose results differ: each inner literal
// holds a smaller set, built at the whole set's ids at every level (D16742).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function dbl(a) { return a * 2 }
function quart(a) { return a / 4.0 }
const xs = [[[inc0]], [[half]]]
print(xs[0][0][0](3))
print(xs[1][0][0](3))
for x in xs {
  for y in x { print(y[0](3)) }
}
const ys = [[[[dbl]]], [[[dbl, quart]]]]
print(ys[0][0][0][0](3))
print(ys[1][0][0][0](3))
print(ys[1][0][0][1](3))
function mk() { return [[[inc0]], [[half]]] }
const zs = mk()
print(zs[0][0][0](3))
print(zs[1][0][0](3))
const w = xs[1][0]
print(w[0](3))
