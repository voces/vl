// @run
// @log 7
// @log 8.5
// A list of records of a function called at two signatures elsewhere, bound and written into
// another binding whose one read is at f64: the first list is built where its one read delivers it.
function ident(a) { return a }
const recs = [{ f: ident }]
function twoSigs(k: i32) {
  const n = recs[k].f(2)
  return n + recs[k].f(2.5)
}
const a = [{ f: ident }]
let b = [{ f: ident }]
b = a
print(twoSigs(0) + b[0].f(2.5))
function inner() {
  const c = [{ f: ident }]
  let d = [{ f: ident }]
  if recs.length > 0 { d = c }
  print(twoSigs(0) + d[0].f(4))
}
inner()
