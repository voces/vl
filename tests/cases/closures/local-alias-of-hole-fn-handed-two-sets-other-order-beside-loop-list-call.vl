// D15443's witness with the alias calls in the other order (D15444).
function add(a, b) { return a + b }
function mul(a, b) { return a * b }
function apply2(g) { print(g(1, 2)) }
function m() {
  const k = apply2
  k(mul)
  k(add)
}
m()
function viaFor(h) {
  for f in [apply2] { f(h) }
}
viaFor(add)
