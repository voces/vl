// @emit-error cannot take the generic function `exclaim` as a value
// A hole function no call instantiates, bound through an `if`'s branches and compared, is not
// inert: the stub it would prune to must never be observed, so the comparison still refuses
// (D6981).
function exclaim(s) { return s + "!" }
const on = [1].length == 1
const x = if on { exclaim } else { exclaim }
print(x == exclaim)
