// @run
// @log L
// @log 1
// @log O
// @log 1
// @log L
// @log s
// @log O
// @log s
// A capture cell seeded with a hole lambda and flipped to a generic in a body called at two
// types runs: the body is copied per instance, each with a lambda of its own (D3971).
function other<V>(v: V) { print("O"); print(v) }
function run<T>(x: T) {
  let k = (y) => {
    print("L"); print(y)
  }
  const flip = () => {
    k = other
  }
  k(x)
  flip()
  k(x)
}
run(1)
run("s")
