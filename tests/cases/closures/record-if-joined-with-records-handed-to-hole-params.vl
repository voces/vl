// @run
// @log 4
// @log 4
// @log 1.25
// @log 1.5
// A record `if` whose arms store functions of different results, bound and called through,
// beside inline record `if`s sharing those functions handed to un-annotated parameters at two
// types: each join's set is decided as a binding's is, and each runs (D15809).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function two() { return [1, 2].length }
function dbl(a) { return a * 2 }
function take(r) { return r.f(3) }
function take2(n, r) { return r.f(n) }
const q = if two() > 5 { { f: half } } else { { f: inc0 } }
print(take(q))
print(take2(3, if two() > 5 { { f: dbl } } else { { f: inc0 } }))
print(take2(2.5, if two() > 5 { { f: half } } else { { f: half } }))
const p = if two() > 1 { { f: half } } else { { f: inc0 } }
print(take(p))
