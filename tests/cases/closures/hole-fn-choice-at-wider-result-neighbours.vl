// @run
// @log 5
// @log 2
// @log 5
// @log 5
// @log 5
// The neighbours of a bound choice delivered at a wider result: called directly too, delivered
// at its own result, inline, and one member in both arms.
function inc(a) { return a + 1 }
function dec(a) { return a - 1 }
function useK(k: (a: i32) => i32 | string) { print(k(4)) }
function useJ(k: (a: i32) => i32) { print(k(4)) }
function direct(c: boolean) {
  const h = if c { inc } else { dec }
  useK(h)
  print(h(1))
}
direct(true)
function narrow(c: boolean) {
  const h = if c { inc } else { dec }
  useJ(h)
}
narrow(true)
function inline(c: boolean) { useK(if c { inc } else { dec }) }
inline(true)
function one(c: boolean) {
  const h = if c { inc } else { inc }
  useK(h)
}
one(true)
