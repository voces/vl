// @run
// @log 1
// @log 1
// A closure capturing a binding held as the atom reads it at a string at a union argument: the
// captured atom, decoded (capture binding shape 3, Q58 position sweep).
const A = "x"
const B = "y"
function takeU(p: i32 | string) {
  return if p is string { p.length } else { p }
}
function main(c: boolean) {
  const M = if c { A } else { B }
  const f = () => takeU(M)
  print(f())
}
main(true)
main(false)
