// @run
// @log 6
// Sibling records holding different hole functions, `s.f` called:
// returned from a closure, functions annotated.
function inc0(a: i32) { return a + 1 }
function dbl(a: i32) { return a * 2 }
function go() {
  const k = () => {
    return { r: { f: inc0 }, s: { f: dbl } }
  }
  print(k().s.f(3))
}
go()
