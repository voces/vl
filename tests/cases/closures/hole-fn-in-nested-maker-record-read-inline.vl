// @run
// @log 4
// @log 5
// @log 6
// @log 4
// A maker's nested record holding an un-annotated function, read through its fields without
// binding the maker's result: two levels, five levels, a field read bound before the call, and a
// maker built on another maker's call (D16826: the record solve found no source for a field read
// of a call's result, so the literal kept an open row no struct matched).

function inc0(a) { return a + 1 }
function mk2(f) { return { r: { f: f } } }
function mk5(f) { return { a: { b: { c: { d: { f: f } } } } } }
function mkm(f) { return { r: mk2(f).r } }

print(mk2(inc0).r.f(3))
print(mk5(inc0).a.b.c.d.f(4))
const r = mk2(inc0).r
print(r.f(5))
print(mkm(inc0).r.f(3))
