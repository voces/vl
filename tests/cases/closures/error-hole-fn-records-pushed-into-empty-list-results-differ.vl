// @error cannot write 'half' to 'l[].f': called at (i32) it returns f64, where 'inc0', also written to it, returns i32 — every function a call through 'l[].f' may run must return one type
// Records whose function field holds un-annotated functions returning different types, pushed
// into an un-annotated empty list: the list's element is typed at the first push's record alone,
// so the call through the second is refused, not run at the first's signature (D15929).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const l = []
l.push({ f: inc0 })
l.push({ f: half })
print(l[1].f(3))
