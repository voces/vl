// @run
// @log L
// @log 1
// @log L
// @log b
// @log O
// @log 2
// @log O
// @log c
// @log M
// @log 3
// @log M
// @log d
// A `let` seeded with a lambda and written a generic from a closure holds a set's id: each call
// dispatches to the member the binding holds, at that call's argument type, before and after
// the write.
function other<V>(v: V) { print("O"); print(v) }
function main() {
  let k = (x) => {
    print("L")
    print(x)
  }
  const flip = () => {
    k = other
  }
  k(1)
  k("b")
  flip()
  k(2)
  k("c")
}
main()
let m = (x) => {
  print("M")
  print(x)
}
if [1].length > 5 { m = other }
m(3)
m("d")
