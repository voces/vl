// @log 4
// @log 6
// A list literal of lists of a tagged function set's ids, three levels and more, names its element
// at its own depth rather than sharing its middle list's row (D15204).
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
print([[[inc0]]][0][0][0](3))
const x = [[[inc0, dbl]]][0]
print(x[0][1](3))
const xsss = [[[inc0]]]
print(xsss[0][0][0](3))
print([[[[dbl]]]][0][0][0][0](3))
