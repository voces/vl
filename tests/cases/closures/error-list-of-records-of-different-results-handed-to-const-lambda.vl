// @error cannot store 'half' in 'v[].f': called at (i32) it returns f64, where 'inc0', also stored in it, returns i32 — every function a call through 'v[].f' may run must return one type
// A list literal of such records handed to a `const` lambda's un-annotated parameter is judged
// at its calls as a named function's is (D15808).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function two() { [1, 2].length }
const take = (v) => v[two() - 1].f(3)
print(take([{ f: inc0 }, { f: half }]))
