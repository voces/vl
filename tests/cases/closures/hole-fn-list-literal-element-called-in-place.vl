// @log s
// An element of a list literal written in place and called there, a closure whose parameter has
// no annotation, takes the call's argument types: one element or two, a constant or a variable
// index, at a scalar, string or float, in a function body and in a generic's instances.
const p = (a) => a + 1
print([p][0](3))
let k = 1
const f = (a) => a + k
const g = (a) => a * k
k = 2
print([f][0](3))
function inc0(a) { return a + 1 }
const w = (a) => inc0(a)
print([w][0](3))
print([f, g][1](3))
let i = 0
print([f][i](3))
function main() {
  let j = 1
  const h = (a, b) => a + b + j
  j = 2
  print([h][0](3, 4))
}
main()
let s = "!"
const sf = (a) => a + s
s = "?"
print([sf][0]("x"))
let m = 1.5
const mf = (a) => a * m
m = 2.0
print([mf][0](3.0))
print(([w])[0](3))
print([w][0](3) + [w][0](4))
const r = [f][0](3)
print(r + 1)
function run<T>(x: T) {
  print([f][0](3))
  print(x)
}
run(1)
run("s")
