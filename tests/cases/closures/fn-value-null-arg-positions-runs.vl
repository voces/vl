// @run
// @log 7
// @log 7
// @log 8
// @log v7
// @log h7
// @log 7
// @log 7
// @log 7
// @log 3
// @log 7
// @log 11
// A function value called with `null` at a nullable closure or map parameter, in each position the
// call's value is delivered to: the callee sees its null.
type R = { v: i32 }
function onFn(x: ((n: i32) => i32) | null): i32 {
  if x == null { return 7 }
  return x(1)
}
function onFnStr(x: ((n: i32) => i32) | null): string {
  if x == null { return "7" }
  return "x"
}
function onMap(x: {[string]: i32} | null): i32 | null {
  if x == null { return null }
  return x.length
}
function onMapCount(x: {[string]: i32} | null): i32 {
  if x == null { return 11 }
  return x.length
}
function sink(n: i32) { print(n) }
function sinkU(u: i32 | string) { print(u) }
function add(a: i32, b: i32) { return a + b }
function id(n: i32) { return n }
function argScalar() {
  const f = onFn
  sink(f(null))
}
function argUnion() {
  const f = onFn
  sinkU(f(null))
}
function argNested() {
  const f = onFn
  print(add(1, id(f(null))))
}
function concat() {
  const f = onFnStr
  print("v" + f(null))
}
function hole() {
  const f = onFn
  print("h\{f(null)}")
}
function ret(): i32 {
  const f = onFn
  return f(null)
}
function letInit() {
  const f = onFn
  const x = f(null)
  print(x)
}
function ifArm(c: boolean) {
  const f = onFn
  const y = if c { f(null) } else { 0 }
  print(y)
}
function coalesce() {
  const m = onMap
  print(m(null) ?? 3)
}
function field() {
  const f = onFn
  const r: R = { v: f(null) }
  print(r.v)
}
function mapArg() {
  const m = onMapCount
  print(m(null))
}
argScalar()
argUnion()
argNested()
concat()
hole()
print(ret())
letInit()
ifArm(true)
coalesce()
field()
mapArg()
