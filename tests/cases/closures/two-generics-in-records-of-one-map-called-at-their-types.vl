// @run
// @log 2
// @log s
// @log true
// Two different generics held in record fields of one un-annotated map, written by index: the
// map's record field joins every function written into it, so each read dispatches to the generic
// its record holds, called at two types (D15493).
function id<T>(x: T): T { x }
function k2<T>(x: T): T { x }
const a = Map()
a["k"] = { f: id }
a["j"] = { f: k2 }
const ar = a["k"]
if ar != null {
  print(ar.f(2))
  print(ar.f("s"))
}
const aj = a["j"]
if aj != null { print(aj.f(true)) }
