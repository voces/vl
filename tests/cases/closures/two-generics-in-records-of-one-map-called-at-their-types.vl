// @run
// @log 2
// @log s
// @log true
// @log id2
// @log 2
// @log id2
// @log s
// Two different generics held in record fields of one un-annotated map, written by index, directly
// or by a helper: the map's record field joins every function written into it, so each read
// dispatches to the generic its record holds, called at two types (D15493, D9440).
function id<T>(x: T): T { x }
function k2<T>(x: T): T { x }
const a = Map()
a["k"] = { f: id }
a["j"] = { f: k2 }
const ar = a["k"]
if ar != null {
  print(ar.f(2))
  print(ar.f("s"))
}
const aj = a["j"]
if aj != null { print(aj.f(true)) }
function id2<T>(x: T): T {
  print("id2")
  x
}
function fill(mm) { mm["k"] = { f: id2 } }
const m = Map()
m["k"] = { f: id }
fill(m)
const r = m["k"]
if r != null {
  print(r.f(2))
  print(r.f("s"))
}
