// @run
// @log 5
// A map of functions annotated at the parameter's own function type is delivered as it is: the
// fix D16996's refusal names.
function half(a: i32): f64 { return a + 2 }
function run(m: {[string]: (a: i32) => f64}) {
  const g = m.get("b")
  if g != null { print(g(3)) }
}
const m = Map()
m.set("b", half)
run(m)
