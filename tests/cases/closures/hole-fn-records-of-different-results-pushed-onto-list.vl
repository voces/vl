// @run
// @log 1.5
// A record pushed onto a list of records holding un-annotated functions is one more value of
// the element's field (D9370); the call through it runs the member stored there (D15801).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const l = [{ f: inc0 }]
l.push({ f: half })
print(l[1].f(3))
