// @run
// @hint redundant type annotation: `ss` is inferred as `(string | i32)[]` — remove it to lean on inference
// @log b
// @log b
// @log a
// @log a
// @log a
// @log s!
// @log a
// @log b
// D3119, D3136, D3139: a closure over a `for-in` variable, or over a bare copy of one, reads it at
// the loop's own rep: the atom of a literal-union list, of a `K | null` list narrowed to `K`,
// and a box element narrowed at module scope.
type K = "a" | "b"
function show(k: K) { return k }
const zz: K[] = ["b", "a"]
for e in zz {
  const f = () => e
  print(f())
  const c = e
  const g = () => show(c)
  print(g())
}
const ws: (K | i32)[] = ["a", 3]
for w in ws {
  if !(w is i32) {
    const h = () => show(w)
    print(h())
  }
}
const ss: (string | i32)[] = ["s", 3]
for s in ss {
  if s is string {
    const h = () => s + "!"
    print(h())
  }
}
function t(ns: (K | null)[]) {
  for n in ns {
    if n != null {
      const c = n
      const f = () => show(c)
      print(f())
    }
  }
}
t(["a", null, "b"])
