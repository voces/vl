// @run
// @log I
// @log 3
// @log O
// @log true
// A written `let` read into a list and rewritten before a delivery: the list's element keeps the
// instance its element call fixes, and the delivery takes the rewritten value's (D3978).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function cb(f: (b: boolean) => void, b: boolean) { f(b) }
function main() {
  let r = inner
  const fs = [r]
  fs[0](3)
  r = other
  cb(r, true)
}
main()
