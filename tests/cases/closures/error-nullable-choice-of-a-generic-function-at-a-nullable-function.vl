// @emit-error emitProgram: a generic function taken as a value reaches no call that fixes its type
// A binding of `if c { id } else { null }` for a generic `id`, delivered at a closed nullable
// function type, is refused, never built at a type that drops its `null` (D17829).
function id<T>(x: T): T { return x }
function two() { return [1, 2].length }
const h = if two() > 1 { id } else { null }
const z: ((x: i32) => i32) | null = h
if z != null { print(z(3)) }
