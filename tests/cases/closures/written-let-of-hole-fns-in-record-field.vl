// @run
// @log 6
// @log 6
// @log 4
// @log 6
// @log 6
// @log 6
// @log 6
// A re-pointed `let` of un-annotated functions runs when held in an un-annotated record
// field, and when an alias of it is written to another `let` (D9010).
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
let f = inc0
f = dbl
const b = { g: f }
print(b.g(3))
const c = b.g
print(c(3))
const d = { g: f }
d.g = inc0
print(d.g(3))
function inner() {
  let m = inc0
  m = dbl
  const o = { g: m, n: 1 }
  return o.g(3)
}
print(inner())
const a = f
let e = f
e = a
print(e(3))
let h = a
h = a
print(h(3))
let x = f
if [1].length > 0 { x = a }
print(x(3))
