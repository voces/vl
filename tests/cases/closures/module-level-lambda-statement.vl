// @run
// @log 8
// @log 7
// @warning This expression has no effect: it is not the final statement of its block, so its value is discarded

// D1643 — an anonymous lambda as a bare module-level statement hoists into the top-level
// signature table carrying the pending return sentinel, and return inference never patches
// it. The checker's inferred-return export reads the arena at that sentinel, so the index
// has to be tested before the read or `vl check` traps inside the compiler.
(x: i32) => x

// The neighbours: the same shape inside a body, and a lambda that is bound and called.
function body() {
  (n: i32) => n
  0
}
const call = (n: i32) => n + 1
print(call(7))
print(7 + body())
