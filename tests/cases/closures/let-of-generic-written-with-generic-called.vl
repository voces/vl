// @run
// @log O
// @log 1
// @log I
// @log true
// @log I
// @log 2
// @log O
// @log 3
// @log I
// @log 4
// @log O
// @log 5
// @log O
// @log 6
// @log I
// @log 7
// @log O
// @log 8
// A `let` seeded with a generic function and written with another is called at whatever was last
// written: each generic written to it is instanced at the call's signature (D3961).
function inner<U>(u: U) {
  print("I")
  print(u)
}
function other<V>(v: V) {
  print("O")
  print(v)
}
function local() {
  let k = inner
  k = other
  k(1)
}
local()
let top = other
top = inner
top(true)
let before = inner
before(2)
before = other
before(3)
let viaClosure = inner
function closure() {
  const set = () => {
    viaClosure = other
  }
  viaClosure(4)
  set()
  viaClosure(5)
}
closure()
let fromMain = inner
fromMain = other
function main() { fromMain(6) }
main()
let held = inner
const alias = held
held = other
alias(7)
held(8)
