// @run
// @log 4
// @log 1.5
// A `for` loop over a bound list literal of un-annotated functions with different results calls
// each element's own member at the loop's argument (D9092, D14435).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const xs = [inc0, half]
for f in xs { print(f(3)) }
