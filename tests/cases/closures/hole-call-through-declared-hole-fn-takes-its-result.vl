// @run
// @log 11
// @log 11
// @log 11
// @log 44
// A call through an un-annotated parameter bound to a declared un-annotated function, handed a
// lambda whose parameter only that function's body fixes, is typed as the direct call is: its `i32`
// result reads back from a map, a record and a loop (D16334).
function lap(g) { return g(1) + 1 }
function use(k) { return k((a) => a * 10) }
const m = Map()
m["k"] = use(lap)
const mv = m["k"]
print(mv)
const r = { x: use(lap) }
print(r.x)
function use2(k) { return use(k) }
print(use2(lap))
let acc = 0
for i in 0 to 3 { acc = acc + use(lap) }
print(acc)
