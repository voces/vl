// @run
// @log true
// A list literal handed to an un-annotated parameter is judged at the call through its element,
// as the same literal bound to a name is (D9092, D9280): the call runs the member it reads, so
// the parameter's function returns that member's result (D15363, D15364).
function inc0(a) { return a + 1 }
function big(a) { return a > 1 }
function run(fs) { return fs[1](3) }
print(run([inc0, big]))
