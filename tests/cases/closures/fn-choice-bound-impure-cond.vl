// @run
// @info `p` is never reassigned; use `const` instead of `let`
// @log pick
// @log 6
// @log xx
// @log 1
// @log before
// @log pick
// @log after
// @log 3
// @log x
// @log 2
// @log 6
// @log xx
// @log false
// @log which
// @log 6
// @log xx
// @log 3
// @log pick
// @log 6
// @log xx
// @log 9
// @log 4
// @log 0
// @log yy
// @log 1
// @log y
// @log 4
// @log yy
// @log 7
// A `const` or `let` bound to an `if` or `match` choosing between generic functions, used at
// more than one type, whose condition or scrutinee calls a function that writes: the condition
// runs once, where the binding is, and every type's use reads that one result (D9161).
function idg<T>(t: T): T { return t }
function kg<T>(t: T): T { return t + t }
function app<T>(f: (t: T) => T, x: T): T { return f(x) }
let n = 0
function pick(want: boolean) {
  n = n + 1
  print("pick")
  return want
}
const h = if pick(true) { kg } else { idg }
print(h(3))
print(h("x"))
print(n)

// Inside a function body, the condition runs at the binding, between the prints.
function run(w: boolean) {
  print("before")
  const g = if pick(w) { kg } else { idg }
  print("after")
  print(g(3))
  print(g("x"))
}
run(false)
print(n)

// A condition reading a `let` written after the binding.
let flag = true
const f = if flag { kg } else { idg }
flag = false
print(f(3))
print(f("x"))
print(flag)

// A `match` whose scrutinee calls, and a `let` delivered to a generic parameter.
function which() {
  n = n + 1
  print("which")
  return 2
}
const m = match which() {
  1 => idg
  2 => kg
  _ => idg
}
print(m(3))
print(m("x"))
print(n)
let p = (if !pick(false) { kg } else { idg })
print(app(p, 3))
print(app(p, "x"))
print(p(4.5))
print(n)

// In a loop, once per iteration.
let i = 0
let k = 0
function odd() {
  k = k + 1
  return k % 2 == 1
}
while i < 3 {
  const q = if odd() { kg } else { idg }
  print(q(i))
  print(q("y"))
  i = i + 1
}
print(k + n)
