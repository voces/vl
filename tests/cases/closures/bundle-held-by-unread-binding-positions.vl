// @run
// @log 1
// @log 2
// @log 3
// @log 4
// @log 5
// @hint Intentionally-unused variable `_held` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_l` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_p` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_a` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_b` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_h` (leading `_` marks it unused)
// A call of a function returning its parameter, called at two signatures, whose result is bound to
// a name nothing reads keeps the bundle whole, as a dropped call does: a module `const`, one inside
// a function, a `let`, the `f64`/`i32` spelling, and beside a holder that is read.
function lap2(f) {
  const _a = f(true)
  const _b = f(3)
  return f
}
function lap(f) {
  f(2.5)
  f(3)
  return f
}
const _held = lap2((a) => a)
print(1)
function inner() {
  const _h = lap2((a) => a)
  print(2)
}
inner()
let _l = lap2((a) => a)
print(3)
const _p = lap((a) => a)
print(4)
const read = lap2((a) => a)
print(read(5))
