// @run
// @log 4
// @log 1.5
// @log 4
// @log 9
// @log 11.5
// @log 5.5
// @log 4
// A record whose function field holds un-annotated functions returning different types, returned
// by a call that builds it at one of several returns: a call through the field runs the member
// stored there, whichever return built it. Read directly, at each return, bound, summed, at three
// returns, with two such fields, and with the field bound out (D15801).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function dbl(a) { return a * 2 }
function two() { [1, 2].length }
function pick(b: boolean) { if b { return { f: half } } return { f: inc0 } }
print(pick(two() > 5).f(3))
print(pick(two() > 1).f(3))
const r = pick(two() > 5)
print(r.f(3))
print(r.f(3) + r.f(4))
function pick3(n: i32) { if n > 5 { return { f: half } } if n > 1 { return { f: inc0 } } return { f: dbl } }
print(pick3(two()).f(3) + pick3(0).f(3) + pick3(9).f(3))
function mk2(b: boolean) { if b { return { f: half, g: inc0 } } return { f: inc0, g: half } }
const m = mk2(two() > 5)
print(m.f(3) + m.g(3))
const g = r.f
print(g(3))
