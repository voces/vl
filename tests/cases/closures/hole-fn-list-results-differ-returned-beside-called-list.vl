// @run
// @log 4
// @log 4
// A returned list's records hold functions of different results, and a bound list elsewhere
// holds one of them and is called through: the bound list's lone use builds it at that use's
// closures, so the set is tagged beside it and both calls run (D15928, D15338).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function pick(b: boolean) {
  if b { return [{ f: inc0 }] }
  return [{ f: half }]
}
print(pick(true)[0].f(3))
const bs = [{ f: inc0 }]
print(bs[0].f(3))
