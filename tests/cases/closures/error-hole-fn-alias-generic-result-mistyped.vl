// @error cannot assign f64 to 's' of type string
// @error cannot assign f64 to 't' of type string
// A `const` lambda or alias handed to a generic's `(T) => R` gives `R` its body's result at the
// bound `T`, as the function named directly does, so a destination of another type is refused
// (D8981).
const half = (a) => a / 2.0
function half0(a) { return a / 2.0 }
const hh = half0
function apply<T, R>(h: (T) => R, x: T): R { return h(x) }
const s: string = apply(half, 3)
const t: string = apply(hh, 3)
print(s + t)
