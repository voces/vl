// @error argument 1: operator '+' is not defined for boolean and i32
// Inside a generic body the re-ask defers to the instance, so `g(true)` is refused and the
// `g(3)` instance would not be (D4010).
function inner<U>(u: U) { print("I"); print(u) }
function plus<V>(v: V) { print(v + 1) }
function g<T>(t: T) {
  const fs = [inner]
  fs[0] = plus
  fs[0](t)
}
g(true)
