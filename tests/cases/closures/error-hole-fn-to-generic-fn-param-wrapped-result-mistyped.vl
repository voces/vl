// @error cannot assign f64[] to 'ys' of type i32[]
// A wrapped result closed by an un-annotated function's body is that body's type, so `half`'s
// `f64[]` does not fit an `i32[]` destination (D9000).
function half(a) { return a / 2.0 }
function m<T, U>(xs: T[], k: (a: T) => U): U[] { return xs.map(k) }
const ys: i32[] = m([3], half)
print(ys[0])
