// @run
// @log 1
// @log 2
// @log s
// @log 2
// @log true
// @log 15
// @log 2.5
// @log 9
// @log m
// @log 8
// @log 7
// @log 2
// @log 11

// A frame that monomorphization or callback specialisation clones after the capture pass keeps
// its shared `let` in a cell, since the clone's capturer may not be lifted: a host with an
// un-annotated parameter (called at two types), the same with a block-local capturer, a lambda
// host, a host with one annotated and one un-annotated parameter, and hosts whose parameter
// type reaches a function (nullable, or a record field) while a generic is in the program.

type H = { f: () => i32 }

function unann(p) {
  let k = 0
  const w = () => {
    k += 1
  }
  w()
  w()
  print(p)
  k
}

function unannLocalFn(p) {
  let k = 10
  function w() { k += 5 }
  w()
  print(p)
  k
}

const lam = (p) => {
  let k = 1
  const w = () => {
    k *= 3
  }
  w()
  w()
  print(p)
  k
}

function mixed(p, q: i32) {
  let k = q
  const w = () => {
    k += q
  }
  w()
  print(p)
  k
}

function optFn(g: (() => i32) | null) {
  let k = 0
  const w = () => {
    k += 1
  }
  w()
  w()
  if g != null { k = k + g() }
  k
}

function recFn(h: H) {
  let k = 0
  const w = () => {
    k += 2
  }
  w()
  k + h.f()
}

print(unann(1))
print(unann("s"))
print(unannLocalFn(true))
print(lam(2.5))
print(mixed("m", 4))
print(optFn(() => 5))
print(optFn(null))
print(recFn({ f: () => 9 }))
