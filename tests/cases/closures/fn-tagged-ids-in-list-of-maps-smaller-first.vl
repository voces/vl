// @run
// @log 1.5
// @log 4
// @log 2
// @log 5
// A list literal of maps of un-annotated functions holds every map's set, whichever map comes
// first: each read reaches the function its own map holds (D15352).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const fnMap = Map()
fnMap.set("a", inc0)
fnMap.set("b", half)
const m2 = Map()
m2.set("a", half)
const xs = [m2, fnMap]
const g = xs[0].get("a")
if g != null { print(g(3)) }
const h = xs[1].get("a")
if h != null { print(h(3)) }
for m in xs {
  const k = m.get("a")
  if k != null { print(k(4)) }
}
