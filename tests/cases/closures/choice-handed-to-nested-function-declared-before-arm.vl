// @run
// @log a
// A choice handed to a nested function declared before one of the choice's nested members calls
// that member by its declaration, not by a name the callee cannot see (D15037).
function inner(s) { return s }
function nested(c: boolean) {
  function both(f) { print(f("a")) }
  function ask(s) { return s }
  both(if c { inner } else { ask })
}
nested(true)
