// @run
// @log 6
// @log 10
// @log 6
// @log 6
// @log 4
// @log 6
// @log 6
// @log 6
// A list binding of un-annotated functions handed to an un-annotated parameter that reads it by
// `pop()` or `get(i)`, narrowed and called: the read is one of the argument's slot reads, so the
// function is built at the call's types rather than as an uncalled stub (D15175). One function
// per position, so no other call builds it: `pop`, `get` of the last, a parameter handed on, two
// lists into one parameter, the function declared first, and a list and a map into one parameter.
function h1(a) { return a * 2 }
function h2(a) { return a * 2 }
function i2(a) { return a + 1 }
function h3(a) { return a * 2 }
function h4(a) { return a * 2 }
function i4(a) { return a + 1 }
function h5(a) { return a * 2 }
function h6(a) { return a * 2 }
function popped(m) {
  const g = m.pop()
  if g != null { print(g(3)) }
}
const a1 = [h1]
popped(a1)
const a2 = [i2, h2]
last(a2)
const a3 = [h3]
handOn(a3)
const a4 = [h4]
const b4 = [i4]
first(a4)
first(b4)
const a5 = [h5]
popped5(a5)
const a6 = [h6]
both(a6)
const m6 = Map()
m6.set(0, h6)
both(m6)
function last(m) {
  const g = m.get(m.length - 1)
  if g != null { print(g(5)) }
}
function handOn(m) { popped3(m) }
function popped3(m) {
  const g = m.pop()
  if g != null { print(g(3)) }
}
function first(m) {
  const g = m.get(0)
  if g != null { print(g(3)) }
}
function popped5(m) {
  const g = m.pop()
  if g != null { print(g(3)) }
}
function both(m) {
  const g = m.get(0)
  if g != null { print(g(3)) }
}
