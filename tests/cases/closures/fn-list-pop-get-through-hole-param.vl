// @run
// @log 6
// @log 6
// @log 6
// @log 6
// @log 6
// @log 6
// An un-annotated function read off a list by `pop()` or `get(i)` through an un-annotated
// parameter, narrowed and called: the read is one of the argument's slot reads, so the function is
// built at the call's types rather than as an uncalled stub (D15175). Two lists handed to the
// parameter, one handed on, and a list and a map handed to the same parameter.
function half(a) { return a * 2 }
function inc(a) { return a + 1 }
const xs = [half]
popped(xs)
got([half])
got([inc, half])
handOn([half])
both([half])
const mm = Map()
mm.set(0, half)
both(mm)
function popped(m) {
  const g = m.pop()
  if g != null { print(g(3)) }
}
function got(m) {
  const g = m.get(m.length - 1)
  if g != null { print(g(5) - 4) }
}
function handOn(m) { popped(m) }
function both(m) {
  const g = m.get(0)
  if g != null { print(g(3)) }
}
