// A list, or a list of lists, of un-annotated functions handed to an un-annotated parameter whose
// body calls through its elements holds their ids: one call, two calls at one type, a list of one
// function called at two types, and nested lists of one and of two functions at one and two types.
function inc0(a) { return a + 1 }
function dbl0(a) { return a * 2 }
function run0(r) { print(r[1](3)) }
run0([inc0, dbl0])

function inc1(a) { return a + 1 }
function dbl1(a) { return a * 2 }
function take1(v) {
  print(v[0](3))
  print(v[1](4))
}
take1([inc1, dbl1])

function inc2(a) { return a + 1 }
function take2(v) {
  print(v[0](3))
  print(v[0](2.5))
}
take2([inc2])

function inc3(a) { return a + 1 }
function take3(v) {
  print(v[0][0](3))
  print(v[1][0](2.5))
}
take3([[inc3], [inc3]])

function inc4(a) { return a + 1 }
function dbl4(a) { return a * 2 }
function take4(v) {
  print(v[0][0](3))
  print(v[0][1](2.5))
}
take4([[inc4, dbl4]])

function inc5(a) { return a + 1 }
function dbl5(a) { return a * 2 }
function take5(v) {
  print(v[0][0](3))
  print(v[1][0](2.5))
}
take5([[inc5, dbl5], [dbl5]])

function inc6(a) { return a + 1 }
function dbl6(a) { return a * 2 }
function take6(v) {
  print(v[0][0](3))
  print(v[0][1](2.5))
}
const u6 = [[inc6, dbl6]]
take6(u6)
