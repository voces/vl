// @run
// @log a
// @log 4
// @log 2.5
// @log 4
// @log b
// @log 6
// Lambda members of a written `let` in a generic body, written from a nested function declared
// there and called at two types, dispatch to each instance's own lambda (D15436).
function mk<T>(x: T, n: i32) {
  let d1 = (y) => y
  let d3 = (y) => y + y
  function w1() { d1 = d1 }
  d3 = d1
  print(d1(x))
  print(d3(n))
}
mk("a", 4)
mk(2.5, 4)
function mk2<T>(x: T, n: i32) {
  let d1 = (y) => y
  let d3 = (y) => y + y
  function w1() { d1 = d1 }
  w1()
  print(d1(x))
  print(d3(n + 1))
}
mk2("b", 2)
