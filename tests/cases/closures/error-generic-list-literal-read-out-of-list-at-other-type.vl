// @error a function of type `(i32) => i32` cannot be used as `(string) => string` here
// A list literal holding a generic read out of a list and a fixed-type `i32` function, passed to a
// generic function called at `string`, refuses: the fixed function cannot take a string (D10251).
function id<T>(x: T): T { x }
function inc(x: i32) { x + 1 }
function run<U>(a: ((x: U) => U)[], u: U): U { a[1](u) }
const xs = [id]
const v = xs[0]
print(run([v, inc], "s"))
