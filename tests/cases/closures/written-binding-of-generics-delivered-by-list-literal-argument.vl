// @run
// @log 1
// @log s
// @log 7
// @log loud
// @log 3
// A written binding of two generics called at two types, delivered through a list literal handed to a closed list parameter at a
// closed function type, is delivered through an adapter and keeps the value it held there.
function id<T>(x: T): T { return x }
function loud<T>(x: T): T {
  print("loud")
  return x
}
function takeL(xs: ((x: i32) => i32)[]) { return xs[0](7) }
function main() {
  let f = id
  print(f(1))
  print(f("s"))
  print(takeL([f]))
  f = loud
  print(f(3))
}
main()
