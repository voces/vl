// @run
// @log 11
// @log 22
// @log 33
// @log 44
// @log 0
// @log 55
// @log 66
// @log 77
// @log 88

// @hint redundant type annotation: `two` is inferred as `((i32) => i32) | null`

// D1622 — a NULLABLE closure handed back through INFERRED returns. `retKindPri` ranks the
// niche so `criSetRetKind` can record it, and `exprNulClosure` asks the arena so the read
// side agrees. Each block adds a different constant, so a call reaching another block's
// closure prints a wrong number rather than passing.

// The non-null closure never uses this column — its channel is `fnReturnsClosure`, a boolean
// read ahead of the inferred kind — so the two arms cannot both claim one return.

// The witness: two inferred hops, an un-annotated receiver.
function mkOne(): ((i32) => i32) | null { return (n: i32) => n + 1 }

function deliverOne() { return mkOne() }

const one = deliverOne()

if one != null { print(one(10)) }

// The same chain with the receiver ANNOTATED — the clause-1 face, against the un-annotated
// clause-2 one above: one missing tier put the two spellings in different clauses.
function mkTwo(): ((i32) => i32) | null { return (n: i32) => n + 2 }

function deliverTwo() { return mkTwo() }

const two: ((i32) => i32) | null = deliverTwo()

if two != null { print(two(20)) }

// THREE inferred hops.
function mkThree(): ((i32) => i32) | null { return (n: i32) => n + 3 }

function midThree() { return mkThree() }

function deliverThree() { return midThree() }

const three = deliverThree()

if three != null { print(three(30)) }

// The value really null at runtime, so the niche round-trips rather than merely type-checks.
function mkMaybe(p: boolean): ((i32) => i32) | null {
  if p { return (n: i32) => n + 4 }
  return null
}

function deliverMaybe(p: boolean) { return mkMaybe(p) }

const present = deliverMaybe(true)

if present != null { print(present(40)) } else { print(0) }

const absent = deliverMaybe(false)

if absent != null { print(absent(40)) } else { print(0) }

// The chain inside a FUNCTION, where the binding is a local rather than a global.
function inFunction() {
  const v = deliverOne()
  if v != null { print(v(54)) }
}

inFunction()

// ── the neighbours the priority table's other rulings own ────────────────────

// The ONE-hop control this row's grading list names — it ran before and must keep running.
function mkSix(): ((i32) => i32) | null { return (n: i32) => n + 6 }

const six = mkSix()

if six != null { print(six(60)) }

// D937's rep at the same shape: a nullable MAP through two inferred hops, whose tier this
// change shares rather than outranks.
function mkMap(): { [string]: i32 } | null {
  const m: { [string]: i32 } = Map()
  m["k"] = 77
  return m
}

function deliverMap() { return mkMap() }

const mp = deliverMap()

if mp != null { print(mp["k"]) }

// D1562's rep at the same shape: a nullable VARIANT through two inferred hops.
type Circle = { r: i32 }

type Sq = { s: i32 }

type Shape = Circle | Sq

export function area(sh: Shape) {
  if sh is Circle { return sh.r }
  0
}

function mkCircle(): Circle | null { return { r: 88 } }

function deliverCircle() { return mkCircle() }

const c = deliverCircle()

if c != null { print(c.r) }
