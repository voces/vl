// @run
// @log 7
// @log 14
// @log 7
// @log 8
// @log 8
// @log 9
// @warning Unused parameter `x`
// @warning Unused parameter `x`
// @warning Unused parameter `x`
// @warning Unused parameter `x`
// @warning Unused parameter `x`
// A lifted function CALLING A SIBLING that captures. `j` calling `k` builds `k`'s env inside
// `j`, so every name `k` needs from an outer frame must ride `j`'s env too — and `capRecord`
// dropped `k` as a lifted function name, so `j`'s capture set was empty and the env build had
// no `n` to read (D1761).
//
// Depth was never the ingredient: a nested function DECLARED inside another already folds its
// frees upward through `capScan`'s `FuncDecl` arm. The sibling direction is the hole, and the
// fold is transitive, so a chain of three reaches the capture through two hops.

function o(n: i32) {
  function k(x: i32) { return n }
  function j(y: i32) { return k(y) }
  return j(1)
}
print(o(7))

// The caller reading the captured name ITSELF always worked — it is what makes the difference
// a capture-set question rather than an env-layout one.
function o2(n: i32) {
  function k(x: i32) { return n }
  function j(y: i32) { return k(y) + n }
  return j(1)
}
print(o2(7))

// Depth rather than siblings: `k` declared inside `j`.
function o3(n: i32) {
  function j(y: i32) {
    function k(x: i32) { return n }
    return k(y)
  }
  return j(1)
}
print(o3(7))

// Two siblings where the caller does NOT call the capturing one: nothing to fold.
function o4(n: i32) {
  function k(x: i32) { return n }
  function j(y: i32) { return y }
  return j(1) + k(2)
}
print(o4(7))

// A chain of three, so the fold is exercised transitively: `h` reaches `n` through `j`
// through `k`.
function o5(n: i32) {
  function k(x: i32) { return n + x }
  function j(y: i32) { return k(y) }
  function h(z: i32) { return j(z) }
  return h(1)
}
print(o5(7))

// The sibling captures TWO names, and the caller folds both.
function o6(a: i32, b: i32) {
  function k(x: i32) { return a + b }
  function j(y: i32) { return k(y) }
  return j(1)
}
print(o6(4, 5))
