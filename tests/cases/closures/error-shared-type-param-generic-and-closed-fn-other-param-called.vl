// @error-at 9:9 `con` is passed as `F`, but `go` calls `F` with `string` (line 6); `con` takes `i32`
// A call through the second parameter of the shared type is asked of the argument the first
// did not pin; it was check-clean invalid wasm (D15464).
function go<F>(a: F, b: F) {
  print(a(3))
  print(b("x"))
}
function same<T>(k: T): T { k }
function con(x: i32) { x }
go(same, con)
