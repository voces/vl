// @run
// @log 4
// @log 6
// @log 4
// @log 4
// @log 4
// @hint Intentionally-unused parameter `_n`
// A record field initialised by a call returning a list of un-annotated functions, from a function
// with an un-annotated parameter, runs at the top level, inside a function beside other fields,
// and when the call returns a nested list (D9714). The last case, the call bound before the
// record, is a control that ran before.
function inc0(a) { return a + 1 }
function give0(_n) { return [inc0] }
const w0 = { f: give0(1) }
print(w0.f[0](3))

function inc1(a) { return a + 1 }
function dbl1(a) { return a * 2 }
function give1(_n) { return [inc1, dbl1] }
function go1() {
  const w = { f: give1(1), g: [dbl1], n: 2 }
  print(w.f[1](3))
  print(w.g[0](w.n))
}
go1()

function inc2(a) { return a + 1 }
function give2(_n) { return [[inc2]] }
const w2 = { f: give2(1) }
print(w2.f[0][0](3))

function inc3(a) { return a + 1 }
function give3(_n) { return [inc3] }
const g3 = give3(1)
const w3 = { f: g3 }
print(w3.f[0](3))
