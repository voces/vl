// @log 2
// @log 1
// @log s
// @log 1
// @log 2
// @log s
// A nested generic written into a captured cell from a closure, in a generic instanced at two
// types: each instance's closure builds its own instance's copy of the nested function, though
// the read naming it is one node every instance's clone shares (D12213).
function outer<T>(x: T) {
  function inner<U>(u: U) { print(x); print(u) }
  function inner2<U>(u: U) { print(u); print(x) }
  let k = inner
  const flip = () => {
    k = inner2
  }
  k(1)
  flip()
  k(2)
}
outer(1)
outer("s")
