// @run
// @log true
// @log null
// @log 3
// @log 4
// @log 7
// @log true
// @log true
// @log 0
// @log 3
// @log 0
// @log 9
// @info `?.f` here is always null
// @info `?.h` here is always null
// @info `?.b` here is always null
// A `?.` read or call off a receiver only ever `null` reads `null`, evaluating no argument, bound,
// printed, under `??` or as a statement (D16841).
function t(x: i32) {
  print(x)
  return x
}
function inc(x: i32) { return x + 1 }
const a = null
const v = a?.f
print(v == null)
print(a?.f)
a?.f
const o = { d: null }
print(o.d?.h ?? 3)
print(o.d?.h(1) ?? 4)
print(a?.h(t(5)) ?? 7)
a?.h(t(6))
const r = a?.h(1)
print(r == null)
const w = a?.b?.c
print(w == null)
const n: { f: (x: i32) => i32 } | null = null
print(n?.f(2) ?? 0)
function take(b) { print(b?.f(2) ?? 0) }
take({ f: inc })
take(null)
function stmt(b) { b?.f(2) }
stmt(null)
stmt({ f: inc })
print(9)
