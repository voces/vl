// @run
// @log 4
// A function handed to a hole parameter that a returned record holds one record down:
// passed to an annotated parameter.
function inc0(a) { return a + 1 }
function mk2(f) { return { r: { f: f } } }
function use(q: { r: { f: (i32) => i32 } }) { return q.r.f(3) }
print(use(mk2(inc0)))
