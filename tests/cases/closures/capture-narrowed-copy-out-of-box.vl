// @run
// @log a
// @log c6
// @log b
// @log c7
// A closure captures an un-annotated copy of a value narrowed to `K | Circle` out of a
// three-member box, in a function and over a walk variable at module scope (D3153).
type K = "a" | "b"
type Circle = { r: i32 }
function sh(x: K | Circle): string {
  if x is Circle { return "c\{x.r}" }
  return x
}
function t(e: K | Circle | i32) {
  if !(e is i32) {
    const c = e
    const f = () => sh(c)
    print(f())
  }
}
t("a")
t({ r: 6 })
const ms: (K | Circle | i32)[] = ["b", 4, { r: 7 }]
for m in ms {
  if !(m is i32) {
    const c = m
    const f = () => sh(c)
    print(f())
  }
}
