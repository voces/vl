// A LAMBDA whose result is a ref-list of a NULLABLE struct with a CLOSURE-ONLY field
// (`() => ({f: () => string} | null)[]`): the element resolves to the record's row by its field
// set even though the lambda's annotation spells the shape differently, so the element's closure
// field is callable (D1921). rep-fuzz post-#1029, seed 361 case_00011 (multiobs leg p0r).
function go() {
  const v: () => ({f: () => string} | null)[] = () => ([{ f: () => ("frb") }])
  const t0 = v()[0]
  if (t0 != null) { print(t0.f()) } else { print("NULL") }
}
go()
