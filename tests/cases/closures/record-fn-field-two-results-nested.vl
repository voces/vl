// @run
// @log 9
// @log 1.5
// @log 9
// @log 4
// @log 4
// @log 1.5
// @log 7.5
// A record nested in records, whose function field holds un-annotated functions returning
// different types: a call through the field runs the member stored there, whichever arm or
// return built it. Two levels, three levels, the inner record bound out, returned, a nested
// field written, and a mixed record with a number beside the functions (D15805).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function two() { [1, 2].length }
const o = if two() > 5 { { a: { f: half } } } else { { a: { f: inc0 } } }
print(o.a.f(3) + o.a.f(4))
const p = if two() > 1 { { a: { f: half } } } else { { a: { f: inc0 } } }
print(p.a.f(3))
const d = if two() > 5 { { a: { b: { f: half } } } } else { { a: { b: { f: inc0 } } } }
print(d.a.b.f(3) + d.a.b.f(4))
const inner = o.a
print(inner.f(3))
function mk(b: boolean) {
  if b { return { a: { f: half } } }
  return { a: { f: inc0 } }
}
print(mk(two() > 5).a.f(3))
const w = { a: { f: inc0 } }
if two() > 1 { w.a.f = half }
print(w.a.f(3))
const m = if two() > 5 { { n: 1, a: { f: half, g: inc0 } } } else { { n: 2, a: { f: inc0, g: half } } }
print(m.a.f(3) + m.a.g(3) + m.n)
