// @emit-error cannot take the generic function `inc` as a value
// A lambda returning a generic function at a type its binding declares keeps that value reached:
// the refusal, where the prune used to stub `inc` and the call trapped (D16075).
function inc(x) { x + 1 }
const m: () => (x: i32) => i32 = () => inc
print(m()(5))
