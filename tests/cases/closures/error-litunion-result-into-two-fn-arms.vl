// @error it converts into more than one function arm of the union
// D4351: a function value whose literal-union result converts into two function arms of a union
// has no one adapter to build, so the delivery is refused rather than boxed unconverted.
type K = "x" | "y"
function t(k: K): K { k }
const u: ((k: K) => string) | ((k: K) => string | null) = t
if u is (k: K) => string { print(u("x")) }
