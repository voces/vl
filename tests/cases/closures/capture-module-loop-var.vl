// @run
// @log 11
// @log 12
// @log a
// @log b
// @log 3
// @log 5
// @log 17
// A closure written in a module-scope `for` body captures the loop variable, which is a local
// of the start function and not a global. Its env field takes the element's own type (a
// function, a string, an f64), and a loop variable spelled like a numeric intrinsic is the
// variable when called, never the opcode (D2010).
const fns = [(x: i32) => x + 1, (x: i32) => x + 2]
for q in fns {
  const h = () => q(10)
  print(h())
}

for s in ["a", "b"] {
  const h = () => s
  print(h())
}

const xs = [1.5, 2.5]
for v in xs {
  const h = () => v * 2.0
  print(h())
}

const ffs = [(x: f64) => x + 1.0]
for sqrt in ffs {
  const h = () => sqrt(16.0)
  print(h())
}
