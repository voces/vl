// @run
// @log q
// @log 2
// A pushed list of a generic function, one element bound to a `const` and called at a string
// while another element is called at an integer: each call instances the member at its own
// arguments (D9720).
function id<T>(x: T): T { x }
const xs = [id, id]
xs.push(id)
const f = xs[2]
print(f("q"))
print(xs[1](2))
