// @run
// @log 4
// @log 3
// @log 3
// @log 2.5
// @log 6
// @log 4.5
// One hole parameter handed two if-choices of members that take a set of functions, at two
// instances: each instance dispatches through its own set's arms.
function add(a, b) { return a + b }
function inner(s, g) { return g(s, s) }
function ask(s, g) { return g(s, 1) }
function twice(s, g) { return g(g(s, s), s) }
function both(f) {
  print(f(2, add))
  print(f(1.5, add))
}
function a1(c: boolean) { both(if c { inner } else { ask }) }
function a2(c: boolean) { both(if c { inner } else { twice }) }
a1(true)
a1(false)
a2(false)
