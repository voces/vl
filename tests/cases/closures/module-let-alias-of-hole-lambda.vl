// @run
// @log aC
// @log bE
// @log cC
// @log dE
// @log 2
// @log 20
// @log eC
// @log fE
// @log gC
// A module-scope `let` alias of a hole lambda, called, then reassigned in the same scope, in a
// function and in a closure, and read from a function: each call reaches the lambda the alias
// holds at that moment (D3847).
const c = (y) => y + "C"
const e = (y) => y + "E"
let d = c
print(d("a"))
d = e
print(d("b"))
let w1 = c
function writeW1() { w1 = e }
print(w1("c"))
writeW1()
print(w1("d"))
const inc = (y) => y + 1
const ten = (y) => y * 10
let n = inc
print(n(1))
n = ten
print(n(2))
let r = c
function readR(s: string) { r(s) }
print(readR("e"))
const setR = () => {
  r = e
}
setR()
print(readR("f"))
const k = c
print(k("g"))
