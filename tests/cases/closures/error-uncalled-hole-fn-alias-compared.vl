// @emit-error unsupported argument type for `f` in a call to `run`
// @warning Unused parameter `f` (prefix with `_` to suppress, or remove it)
// An alias of a hole function no call instances is no inert use when it is compared: the stub
// it would prune to must never be observed, so the call handing it on still refuses (D6913).
function apply3(g) { print(g(1, 2)) }
function run(f) { print(2) }
const h = apply3
run(h)
print(h == h)
