// D2393/D2397: a nullable local a closure assigns lives in a cell, a one-element list of the
// niche. A `null` stored into a `(string | null)[]` element had no typed context, a narrowed
// `i32[]` read out of the cell could not be classified, and a `boolean | null` cell read
// printed `0` or refused at `!= null`.
// @run
// @log other
// @log t
// @log other
// @log 2 2
// @log other
// @log false
// @log other
// @log true
// @log other
// @log done

// D2393's filed witness.
function strNull() {
  let v: string | null = "s"
  const k = () => {
    v = null
  }
  k()
  if v is string { v } else { "other" }
}
print(strNull())

function strValue() {
  let v: string | null = null
  const k = () => {
    v = "t"
  }
  k()
  if v != null { v } else { "other" }
}
print(strValue())

function strNullNe() {
  let v: string | null = "s"
  const k = () => {
    v = null
  }
  k()
  if v != null { v } else { "other" }
}
print(strNullNe())

function listValue() {
  let v: i32[] | null = null
  const k = () => {
    v = [1, 2]
  }
  k()
  if v is i32[] { "\{v.length} \{v[1]}" } else { "other" }
}
print(listValue())

function listNull() {
  let v: i32[] | null = [1]
  const k = () => {
    v = null
  }
  k()
  if v != null { "\{v.length}" } else { "other" }
}
print(listNull())

// D2397: the boolean niche's cell.
function boolValue() {
  let v: boolean | null = null
  const k = () => {
    v = false
  }
  k()
  if v is boolean { "\{v}" } else { "other" }
}
print(boolValue())

function boolNull() {
  let v: boolean | null = true
  const k = () => {
    v = null
  }
  k()
  if v != null { "\{v}" } else { "other" }
}
print(boolNull())

// The element store needs no closure: `xs[0] = null` over `(string | null)[]`.
function elemStore() {
  const xs: (string | null)[] = ["a", "b"]
  xs[0] = null
  "\{xs[0] == null}"
}
print(elemStore())

let out = ""
{
  let v: string | null = "s"
  const k = () => {
    v = null
  }
  k()
  out = if v is string { v } else { "other" }
}
print(out)
print("done")
