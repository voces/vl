// @run
// @log 7
// @log 7
// @log 7
// @log 3.5
// @log 7.5
// @log 7
// @log 7.5
// A list literal of one hole function received by a list method's typed callback is built at the
// callback's parameter type, as a binding of it is (F2); the function's other uses keep theirs,
// and a binding read at two signatures pins nothing (coordinator ruling).
function inc2(a) { return a + 2 }
function ap(r: (a: i32) => i32): i32 { return r(5) }
function apf(r: (a: f64) => f64): f64 { return r(5.5) }
print([inc2].map(ap)[0])
print([inc2].map((r: (a: i32) => i32) => r(5))[0])
print([inc2].map(ap)[0])
print(inc2(1.5))
print([inc2].map(apf)[0])
const xs = [inc2]
print(xs.map(ap)[0])
print(xs.map(apf)[0])
