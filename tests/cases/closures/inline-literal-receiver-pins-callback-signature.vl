// @run
// @log 7
// @log 8
// @log 9
// @log 4.5
// @log 10
// @log 10.5
// A list literal of one hole function received by a list method's typed callback is built at the
// callback's parameter type, as a binding of it is (F2); a call of the function elsewhere keeps its
// own instance (coordinator ruling).
function ap(r: (a: i32) => i32): i32 { return r(5) }
function apf(r: (a: f64) => f64): f64 { return r(5.5) }
function inc2(a) { return a + 2 }
print([inc2].map(ap)[0])
function inc3(a) { return a + 3 }
print([inc3].map((r: (a: i32) => i32) => r(5))[0])
function inc4(a) { return a + 4 }
print([inc4].map(ap)[0])
print(inc4(0.5))
function inc5(a) { return a + 5 }
const xs = [inc5]
print(xs.map(ap)[0])
print(xs.map(apf)[0])
