// @run
// @log 4
// @log 1.5
// A choice of functions returned and called by the caller, one giving `i32` and the other `f64`
// at the call's argument, gives the call the joined `f64` whichever it runs (D14421).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function get(c: boolean) { return if c { inc0 } else { half } }
const on = [1].length == 1
print(get(on)(3))
print(get(!on)(3))
