// @run
// @log 2
// @log s
// Each instance of a generic function builds its returned record holding a called set at its own
// row, though the instances share the literal's field values (D15549).
function inc0(a) { return a + 1 }
function mk<T>(x: T) { return [{ fs: [inc0], x: x }] }
print(mk(5)[0].fs[0](1))
print(mk("s")[0].x)
