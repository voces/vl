// @run
// @log -1
// @log -1
// @log i-1
// @log -1
// @log cnone
// @log h -1
// @log -1
// @log -1
// @log -1
// @log -1
// @log none
// @log 3
// @log w
// A `null` literal handed to a closure whose parameter is a nullable scalar list is that list's
// null: the closure reads it as absent. Q58 positions for the call's value, in the start body.
const n = (xs: i32[] | null) => if xs == null { -1 } else { xs.length }
const s = (xs: string[] | null) => if xs == null { "none" } else { xs[0] }
function takeI(v: i32) { return v }
function takeU(v: i32 | string): string {
  if v is i32 { return "i\{v}" } else { return v }
}
type Rec = { a: i32, t: string }
print(n(null))
print(takeI(n(null)))
print(takeU(n(null)))
print(takeI(takeI(n(null))))
print("c" + s(null))
print("h \{n(null)}")
const k = n(null)
print(k)
const c = if k < 0 { n(null) } else { n([1, 2]) }
print(c)
const q: i32 | null = null
print(q ?? n(null))
const r: Rec = { a: n(null), t: s(null) }
print(r.a)
print(r.t)
print(n([4, 5, 6]))
print(s(["w"]))
