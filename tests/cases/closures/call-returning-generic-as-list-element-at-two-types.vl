// @run
// @log mk
// @log 2
// @log abc
// @log mk
// @log 3
// @log de
// A call returning a generic, written as a list's element, runs once and its result is called
// at each type; the call bound to a `const` first is the control (D9592).
function id<T>(x: T): T { x }
function mk() {
  print("mk")
  return id
}
const xs = [mk()]
print(xs[0](2))
print(xs[0]("abc"))
const v = mk()
const ys = [v]
print(ys[0](3))
print(ys[0]("de"))
