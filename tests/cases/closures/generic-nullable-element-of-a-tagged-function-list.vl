// @run
// @log 4
// A generic helper returning a list element as `V | null`, handed a list of un-annotated functions,
// returns the member's id or null, called past the null test (D17017).
function inc0(x) { return x + 1 }
function pick<V>(xs: V[], i: i32): V | null { return xs[i] }
const xs = [inc0]
const h = pick(xs, 0)
if h != null { print(h(3)) }
