// @run
// @log 1
// @hint Intentionally-unused parameter
// The NICHE half of the un-annotated nullable lambda-param pin
// (`closure-nullable-param-lambda-pin.vl`). `synthParamAnnots` pins the real nullable map
// onto `_k`; the parameter then keys its `$fnsig` with the nullable-map token (D9822), and
// the map struct that token names is reserved even though no map is ever constructed.
// Before D9822 this payload had no token and the floor refused it.
const f: ({[string]: i32} | null) => i32 = (_k) => 1
print(f(null))
