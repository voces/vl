// @run
// @log y
// @log y
// @log x
// @log y
// @log y!
// @log x
// @log y
// @log none
// @log y
// @log y!
// @log x
// D4352: a member literal passed through a local alias of a function-valued parameter, the
// parameter un-annotated or typed by a type parameter, is the atom the pinned callee takes.
type K = "x" | "y"
function t(k: K): string { k }
function u(s: string) { s + "!" }
function nt(k: K | null) { k ?? "none" }
function take(a) {
  const v = a
  print(v("y"))
}
take(t)
function takeLet(a) {
  let w = a
  w = a
  print(w("y"))
}
takeLet(t)
function takeChain(a) {
  const v = a
  const w = v
  print(w("x"))
}
takeChain(t)
function takeTwo(a) {
  const v = a
  print(v("y"))
}
takeTwo(t)
takeTwo(u)
function takeCaptured(a) {
  const v = a
  const g = () => v("x")
  print(g())
}
takeCaptured(t)
function takeNul(a) {
  const v = a
  print(v("y"))
  print(v(null))
}
takeNul(nt)
function takeGeneric<F>(a: F) {
  const v = a
  print(v("y"))
}
takeGeneric(t)
takeGeneric(u)
function takeAnn(a: (k: K) => string) {
  const v = a
  print(v("x"))
}
takeAnn(t)
