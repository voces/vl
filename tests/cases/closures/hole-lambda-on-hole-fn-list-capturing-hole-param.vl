// @run
// @log 2
// @log 9
// @log 2
// @log 7
// @log 2
// @log 5
// @log 2
// @log 5
// @log 6
// @warning Unused parameter `a`
// @warning Unused parameter `a`
// @warning Unused parameter `a`
// The D12880 witness: a lambda pushed onto a list of hole functions from inside a hole function
// captures that function's parameter, read at its one instance's type; then an index write in
// place of the push, and the loop in a function called again after a second push.
function snd(a, b) { return b }
function apply2(g) { print(g("x", 2)) }
const fs = [apply2]
function add(k) {
  fs.push((g) => {
    print(g("z", k))
  })
}
add(9)
for f in fs { f(snd) }

function second(a, b) { return b }
function call2(g) { print(g("x", 2)) }
const gs = [call2, call2]
function put(k) {
  gs[1] = (g) => {
    print(g("z", k))
  }
}
put(7)
for f in gs { f(second) }

function last(a, b) { return b }
function run2(g) { print(g("x", 2)) }
const hs = [run2]
function more(k) {
  hs.push((g) => {
    print(g("z", k))
  })
}
function go() {
  for f in hs { f(last) }
}
more(5)
go()
more(6)
go()
