// @run
// @log 1
// @log 1
// An alias-spelled NULLABLE closure as a LOCAL and as a PARAM.
//
// #1133 fixed the global and the struct field by peeling the degenerate one-member union
// at `nulCloFlag`'s two `emit_classify` callers; the local (`letIsNulClosure`) and the
// param (`paramNulClosure`) read the flag through `emit_query.vl`, which cannot import
// that peel without a module cycle, so both stayed clean emit rejects —
// "bare null needs a struct-typed context" and "only i32, i64, f64, f32, boolean, struct,
// union, array, or string parameters are supported". D-ALIASFN removes the wrapper at the
// source instead: the annotation resolves to `TyNullable(TyFunc)`, so every reader of the
// arena agrees without a per-caller peel.

type F = (i32) => i32

function inc(a: i32) { a + 1 }

function useLocal() {
  const h: F | null = inc
  if h != null { return 1 }
  0
}
print(useLocal())

function takes(h: F | null) {
  if h != null { return 1 }
  0
}
print(takes(inc))
