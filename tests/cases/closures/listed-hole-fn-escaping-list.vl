// @run
// @log 1
// @log 5
// A list of a hole parameter handed on whole, its element called at two types: the element is
// read through a literal index of a `const` the parameter's one argument fills, so each call
// instances that generic at its own arguments (D15010).
function id<T>(x: T): T { x }
function use(ys) { print(ys.length) }
function take(a) {
  const xs = [a]
  use(xs)
  print(xs[0]("abc").length + xs[0](2))
}
take(id)
