// @run
// @log 5
// @log 10
// @log 6
// @log 2.5
// @hint Intentionally-unused parameter
// A closure whose rep leaves a hole open, or fills one, stored into a list element, a record
// field (in the start and in a generic body) or pushed as a map of them, is the slot's closure
// struct retagged, as a list literal's element is.
function id<T>(x: T): T { return x }
function inc(x: i32) { return x + 1 }
const ps = []
ps.push(id)
ps[0] = inc
print(ps[0](4))
const r = { f: id }
r.f = (x: i32) => x + x
print(r.f(5))
function setIn<T>(_t: T) { r.f = (x: i32) => x * 3 }
setIn("t")
print(r.f(2))
function inc0(a) { return a + 1 }
const m3 = Map()
m3.set("a", inc0)
const ys: ({ [string]: (a: f64) => f64 })[] = []
ys.push(m3)
const g = ys[0].get("a")
if g != null { print(g(1.5)) }
