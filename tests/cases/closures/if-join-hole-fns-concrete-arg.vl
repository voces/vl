// @run
// @log 3
// @log 30
// @log 2
// @log 200
// @log xy
// @log pq
// D7847: a `const` joining two hole functions by `if` and handed a function of a concrete type
// takes that function's type at the call: a declared function, an annotated lambda, a string one.
function add(a: i32, b: i32) { return a + b }
function apply2(g) { print(g(1, 2)) }
function apply3(g) { print(g(10, 20)) }
function main(c: boolean) {
  const f = if c { apply2 } else { apply3 }
  f(add)
}
main(true)
main(false)
function main2(c: boolean) {
  const f = if c { apply2 } else { apply3 }
  f((a: i32, b: i32) => a * b)
}
main2(true)
main2(false)
function cat(a: string, b: string) { return a + b }
function applyS(g) { print(g("x", "y")) }
function applyT(g) { print(g("p", "q")) }
function main3(c: boolean) {
  const f = if c { applyS } else { applyT }
  f(cat)
}
main3(true)
main3(false)
