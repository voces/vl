// @run
// @log ss
// @log ss
// A record literal whose field is an `if` or `match` choice between generic functions, called in
// place, calls the chosen member at the call's own type, as it does when a binding holds the
// record (D9191).
function idg<T>(t: T): T { return t }
function kg<T>(t: T): T { return t + t }
const c = [1].length > 0
print({ h: if c { kg } else { idg } }.h("s"))
const n = [1].length
print(
  {
    h: match n {
      1 => kg
      _ => idg
    },
  }.h("s"),
)
