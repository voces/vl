// @run
// @log 11
// @log 22
// @log 33
// @log 44
// @log 55
// @log 66
// @log 77
// @log 88
// @log 0

// @hint redundant type annotation: `g7` is inferred as `(i32) => i32`
// @hint redundant type annotation: `fs` is inferred as `((i32) => i32)[]`
// @hint redundant type annotation: `b` is inferred as `{op: (i32) => i32}`
// @hint redundant type annotation: `local` is inferred as `(i32) => i32`

// Every position a function's address can be taken from, one call per line, each printing a
// value only its own callee produces: the element segment carries exactly the functions these
// positions name, so an id with no table entry traps instead of answering.
// `scripts/fn-table-audit.py` checks the other half — that `dead`'s index never reaches it.

function f1(n: i32) { return n + 1 }
function f2(n: i32) { return n + 2 }
function f3(n: i32) { return n + 3 }
function f4(n: i32) { return n + 4 }
function f6(n: i32) { return n + 6 }
function f7(n: i32) { return n + 7 }
function f8(n: i32) { return n + 8 }

// Called only by name, never used as a value: its index must not reach the table.
function dead(n: i32) { return n + 99 }

// A module global holding a function value.
const g7: (i32) => i32 = f7

// An argument.
function callArg(fn: (i32) => i32) { return fn(10) }

// A struct field.
type Box = { op: (i32) => i32 }

// A list element.
const fs: ((i32) => i32)[] = [f3]

// A return value.
function pick(): (i32) => i32 { return f4 }

// A capture by a closure that itself captures a closure's frame: `mk` captures `base`, and
// the `inner` it returns captures both `k` and `base`, so two lifted functions are values.
function nested(base: i32) {
  const mk = (k: i32) => {
    const inner = (n: i32) => n + k + base
    return inner
  }
  const h = mk(5)
  return h(45)
}

// A generic pin: the callback's type is the instance's, not a written annotation.
function applyG<T>(fn: (T) => T, v: T): T { return fn(v) }

function go() {
  print(callArg(f1))    // 11 — argument
  const b: Box = {op: f2}
  print(b.op(20))       // 22 — struct field
  print(fs[0](30))      // 33 — list element
  const p = pick()
  print(p(40))          // 44 — return
  print(nested(5))      // 55 — a closure capturing a closure's frame
  print(applyG(f6, 60)) // 66 — generic pin
  print(g7(70))         // 77 — module global
  const local: (i32) => i32 = f8
  print(local(80))      // 88 — local binding
  print(dead(0) - 99)   // 0 — called by name only, never a value
}
go()
