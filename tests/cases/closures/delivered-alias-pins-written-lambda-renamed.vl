// @run
// @log 12
// @log sss
// The receiving parameter named apart from the binding: the delivery alone pins the written
// lambda at the parameter's signature, beside its own call at another type (D3862).
const c = (y) => y + y
const e = (y) => y + y + y
let d = c
function mk(f: (y: i32) => i32, n: i32) { print(f(n)) }
function w() { d = e }
w()
mk(d, 4)
print(e("s"))
