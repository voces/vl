// @run
// @log 2
// @log 2.5
// D9531: a record literal of an un-annotated function pushed onto an un-annotated list, beside a
// record literal set into a map of a declared record type of the same field name, is built at its
// own row; the map's record keeps the declared row's f64.
type R = { f: (a: i32) => f64 }
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const m: Map<string, R> = Map()
m.set("a", { f: half })
const p = []
p.push({ f: inc0 })
print(p[0].f(4) / 2)
const h = m.get("a")
if h != null { print(h.f(5)) }
