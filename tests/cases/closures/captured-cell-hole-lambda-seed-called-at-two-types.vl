// @run
// @log L
// @log 1
// @log O
// @log b
// A cell seeded with a hole lambda and called at two argument types holds one closure per call
// type, and the write fills both (D3951, D3975).
function other<V>(v: V) {
  print("O")
  print(v)
}
function main() {
  let k = (x) => {
    print("L")
    print(x)
  }
  const flip = () => {
    k = other
  }
  k(1)
  flip()
  k("b")
}
main()
