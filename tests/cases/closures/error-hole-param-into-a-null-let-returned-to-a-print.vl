// @emit-error internal: an emit-phase write changed a type an emit memo may hold
// A function returning a `let x = null` a hole parameter fills stays refused at the emit seal,
// never built to a wrong value, until the null-join keeps its open hole (D17844, D17850).
function f(a) {
  let t = null
  t = a
  return t
}
print(f(1))
