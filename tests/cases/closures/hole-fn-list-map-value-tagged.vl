// @run
// @log 6
// @log 6
// @log 10
// @log 8
// @log 2
// @log true
// @log false
// @log 16
// @log 1
// A map whose value is a list, or a list of lists, of un-annotated functions holds their ids:
// written by index and by `.set`, read back narrowed, walked, probed and deleted, and written
// through a narrowed read.
function inc0(a) { return a + 1 }
function dbl0(a) { return a * 2 }
const m0 = Map()
m0["k"] = [inc0, dbl0]
const x0 = m0["k"]
if x0 != null { print(x0[1](3)) }

function inc1(a) { return a + 1 }
function dbl1(a) { return a * 2 }
const m1 = Map()
m1["k"] = [[inc1, dbl1]]
const x1 = m1["k"]
if x1 != null { print(x1[0][1](3)) }

function inc2(a) { return a + 1 }
function dbl2(a) { return a * 2 }
const m2 = Map()
m2.set("k", [[inc2, dbl2]])
const y2 = m2["k"]
if y2 != null { print(y2[0][1](5)) }

function inc3(a) { return a + 1 }
function dbl3(a) { return a * 2 }
const m3 = Map()
m3["k"] = [inc3, dbl3]
for k, v in m3 { print(v[1](4)) }

function inc4(a) { return a + 1 }
function dbl4(a) { return a * 2 }
const m4 = Map()
m4.set("k", [inc4, dbl4])
const z4 = m4["k"]
if z4 != null { print(z4[0](1)) }
print(m4.has("k"))
m4.delete("k")
print(m4.has("k"))

function inc5(a) { return a + 1 }
function dbl5(a) { return a * 2 }
const m5 = Map()
m5["k"] = [inc5, dbl5]
const x5 = m5["k"]
if x5 != null {
  x5[0] = dbl5
  print(x5[0](8))
}
print(m5.length)
