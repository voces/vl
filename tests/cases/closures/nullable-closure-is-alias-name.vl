// @run
// @log 1
// @log 41
// @hint redundant type annotation: `inc` is inferred as `i32`
// `f is F` where `type F = (i32) => i32` — the closure-typed `is` over a NULLABLE-closure
// operand, named through a declared ALIAS instead of spelled with an arrow.
//
// The non-null lowering (`ref.is_null` + `eqz`) was gated on scanning the tested SPELLING for
// `=>`, so an alias-named test fell past it into the union-variant ladder and rejected with
// `emitProgram: `is` names a type that is not a union variant` — a program the checker accepts.
// The gate now asks the CHECKER's banked type for the `is` node (destringify D-ISTY): `F`
// resolves to a one-member `TyUnion` over a `TyFunc` (an arrow-bodied alias is a one-member
// `UnionDecl`, and #1122's transparency collapse covers only plain-NAME members), which
// `tyDenotesFunc` peels — so the alias and the inline arrow decide the same way.
//
// The inline-arrow control (`h is (i32) => i32`) is in the same file: the arrow spelling must
// keep lowering exactly as before.

type F = (i32) => i32

function inc(a: i32): i32 { a + 1 }

function go() {
  const h: ((i32) => i32) | null = inc

  if h is F { print(1) } else { print(0) }

  // The same operand, tested through the arrow spelling: unchanged.
  if h is (i32) => i32 { print(h(40)) } else { print(0) }
}

go()
