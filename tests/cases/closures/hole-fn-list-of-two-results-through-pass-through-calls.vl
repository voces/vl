// @run
// A list of un-annotated functions of two result types handed through calls that hand it back
// is held as the set's ids: each element, called at a constant or a dynamic index or in a loop,
// runs at its own result type.
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function id(x) { return x }
function snd(a, b) { return b }
const r = id(id([half, inc0]))
print(r[0](3))
print(r[1](3))
let i = 0
print(r[i](5))
i = 1
print(r[i](5))
for f in r { print(f(2)) }
print(snd(1, [inc0, half])[1](7))
print(snd(1, [inc0, half])[0](7))
const l = snd(1, [inc0, half])
let k = 1
print(l[k](7))
print(id(snd(1, [half, inc0]))[1](3))
// @log 1.5
// @log 4
// @log 2.5
// @log 6
// @log 1
// @log 3
// @log 3.5
// @log 8
// @log 3.5
// @log 4
