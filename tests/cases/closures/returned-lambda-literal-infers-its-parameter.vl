// @run
// @log 6
// @log 7
// @log 6
// @log 3
// A lambda literal an un-annotated function returns, or leaves as its tail, has its open parameter
// typed by the calls through the result, as a lambda bound to a `const` and returned does (D16291).
function mk() { return (x) => x + 1 }
function tail() { return (x) => x * 2 + 1 }
function adder(n) { return (x) => x + n }
function pick(b: boolean) { return if b { (x) => x + 1 } else { (x) => x + 2 } }
const k = mk()
print(k(5))
const a = adder(2)
print(a(5))
const t: (x: i32) => i32 = tail()
print(t(2) + 1)
const p = pick(true)
print(p(2))
