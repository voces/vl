// @run
// @log 2
// @log 2
// @log 5
// @log 3.5
// @log 2
// @log 4
// @hint Intentionally-unused variable `_k`
// @hint Intentionally-unused parameter `_y`
// A hole function called by name, also handed to a parameter that only aliases it or returned
// unread: the parameter takes the closure of the instance its calls build, which nothing calls
// there, so the value's signature is never observed (D6931).
function inc(x) { x + 1 }

function run(f) {
  const _k = f
  print(2)
}
function get() { return inc }
function outer<T>(_y: T) {
  run(inc)
  print(inc(3))
}

run(inc)
get()
print(2)
print(inc(4))
print(inc(2.5))
outer(1)
