// @run
// @log 1
// @hint Intentionally-unused variable `_h`
// The SILENT form of the alias-blind nullable-closure global: the binding is written and
// never read, so nothing downstream can reject it and the only observable is the module's
// own validity.
//
// `globalCellKind` classified `F | null` (an arrow-bodied alias behind `| null`) as the
// default i32 cell while the start function stored the closure struct into it —
// `type mismatch: expected i32, found (ref $type)` at instantiation. Every richer program
// in this family (`nullable-closure-alias-global.vl`) reaches an emit REJECT first, so this
// four-line file is the one that pins the miscompile itself.

type F = (i32) => i32

function inc(a: i32): i32 { a + 1 }

const _h: F | null = inc

print(1)
