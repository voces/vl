// @run
// @log 5
// @log 2.5
// @log 10
// @log 8
// @log 3
// @log 7
// @log 4.5
// A parameter holding a hole lambda's bundle handed on from a lambda in its function: called there,
// nested two deep, handed to another function to call, and beside a call of its own (D15909).
function lap(f) {
  f(2.5)
  f(3)
  return f
}
function take(b) {
  print(b(4))
  print(b(1.5))
}
function run2(h) { h() }
function fw(a) {
  const k = () => take(a)
  k()
  print(a(9))
}
function deep(a) {
  const k = () => {
    const j = () => take(a)
    j()
  }
  k()
}
function via(a) { run2(() => take(a)) }
fw(lap((a) => a + 1))
deep(lap((a) => a * 2))
via(lap((a) => a + 3))
