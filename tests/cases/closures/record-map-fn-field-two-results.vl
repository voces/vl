// @run
// @log 5.5
// @log 5.5
// @log 5.5
// @log 1.5
// @log 5.5
// @log 1.5
// A map whose entries are record literals, or lists of them, with a function field holding
// un-annotated functions returning different types: a call through an entry's field runs the
// member stored there. Entries written by index and by `set`, read by index, by `get` and over
// `keys()`, at module scope and in a function (D15801, D15806).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const m = Map()
m["a"] = { f: inc0 }
m["b"] = { f: half }
let acc = 0.0
for k in m.keys() {
  const r = m[k]
  if r != null { acc = acc + r.f(3) }
}
print(acc)
const ls = Map()
ls["k"] = [{ f: inc0 }, { f: half }]
const v = ls["k"]
if v != null {
  let t = 0.0
  for e in v { t = t + e.f(3) }
  print(t)
}
const ss = Map()
ss.set("k", [{ f: half }, { f: inc0 }])
const w = ss.get("k")
if w != null { print(w[0].f(3) + w[1].f(3)) }
const q = m.get("b")
if q != null { print(q.f(3)) }
function local() {
  const lm = Map()
  lm.set("a", { f: inc0 })
  lm.set("b", { f: half })
  let t = 0.0
  for k in lm.keys() {
    const r = lm[k]
    if r != null { t = t + r.f(3) }
  }
  print(t)
  const lv = lm["b"]
  if lv != null { print(lv.f(3)) }
}
local()
