// @log 2
// @log 3.75
// A hole parameter bound to a different function in each instance, read by a function nested in
// it and handed on through a list there: the nested body is one for every instance, so it must
// not take the parameter as one instance's set id (D14842).
function add(a, b) { return a + b }
function mul(a, b) { return a * b }
function apply2(g) {
  print(g(1, 2))
  print(g(1.5, 2.5))
}
function viaNested(h) {
  function inner() {
    for f in [apply2] { f(h) }
  }
  inner()
}
viaNested(add)
viaNested(mul)
function viaLambda(h) {
  const go = () => {
    for f in [apply2] { f(h) }
  }
  go()
}
viaLambda(add)
viaLambda(mul)
function viaTwoDeep(h) {
  function a() {
    function b() {
      for f in [apply2] { f(h) }
    }
    b()
  }
  a()
}
viaTwoDeep(add)
viaTwoDeep(mul)
function viaReturned(h) {
  function inner() {
    for f in [apply2] { f(h) }
  }
  return inner
}
viaReturned(add)()
viaReturned(mul)()
