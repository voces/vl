// @error cannot write 'half' to an element of 'r.xs': called at (i32) it returns f64, where 'inc0', also written to it, returns i32
// A list held in a record field is one slot per element too (D9060).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const r = { xs: [inc0] }
r.xs[0] = half
print(r.xs[0](3))
