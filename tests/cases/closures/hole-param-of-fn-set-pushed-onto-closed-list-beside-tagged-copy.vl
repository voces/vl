// @run
// @log ss
// @log 6
// @log 10
// A hole parameter handed a function set and pushed onto a list of a closed function type is
// pinned at that slot, so its caller delivers it through an adapter while a top-level readonly
// copy keeps the set tagged (D15134).
function id<T>(x: T): T { return x }
function dbl<T>(x: T): T { return x + x }
function h(a) {
  const xs: ((x: i32) => i32)[] = []
  xs.push(a)
  print(xs[0](5))
}
let f = id
f = dbl
print(f("s"))
const zs = [f]
const view: readonly ((x: i32) => i32)[] = zs
print(view[0](3))
h(f)
