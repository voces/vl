// @run
// @log abc
// @log 8
// A generic handed to an un-annotated parameter, copied into a `const` and listed through the
// copy, runs at each call's type through the list's elements.
function id<T>(x: T): T { x }
function copied(a) {
  const v = a
  const xs = [v]
  print(xs[0]("abc"))
  print(xs[0](7) + 1)
}
copied(id)
