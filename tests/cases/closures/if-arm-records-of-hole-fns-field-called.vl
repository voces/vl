// @log 8
// @log 8.5
// @log 4
// A value `if` or `match` choosing between record literals that hold un-annotated functions in
// a field: the choice holds each arm's functions, so its field is called at the call's types.
// Different members, one call, the same member, an `else if`, a `match`, inside a function, a
// record field holding the choice, and a list field (D15300, D15290).
function id1(a) { return a }
function id2(a) { return a }
function inc0(a) { return a + 1 }
const c = 1 > 0
const b = 1 < 0
const r = if c { { f: id1 } } else { { f: id2 } }
print(r.f(2))
print(r.f(2.5))
const r1 = if b { { f: id1 } } else { { f: id2 } }
print(r1.f(3))
const r2 = if c { { f: id1 } } else { { f: id1 } }
print(r2.f(4))
print(r2.f(4.5))
const r3 = if b { { f: id1 } } else if c { { f: id2 } } else { { f: id1 } }
print(r3.f(5))
print(r3.f(5.5))
const k = "a"
const r4 = match k {
  "a" => { f: id1 }
  _ => { f: id2 }
}
print(r4.f(6))
print(r4.f(6.5))
function run(x: boolean) {
  const q = if x { { f: id1 } } else { { f: id2 } }
  print(q.f(7))
}
run(true)
const o = { r: if c { { f: id1 } } else { { f: id2 } } }
print(o.r.f(8))
print(o.r.f(8.5))
const l = if b { { fs: [inc0] } } else { { fs: [inc0] } }
print(l.fs[0](3))
