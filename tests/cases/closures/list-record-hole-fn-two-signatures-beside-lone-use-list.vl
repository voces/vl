// @log 2
// @log 2.5
// @log s
// @log 2
// @log 2.5
// @log 2.5
// A list of records of an un-annotated function, called at two signatures through a variable index
// or a loop, beside another list of such a record whose one use builds it at that use's closures
// (an `f64`, a `string`, or an annotated list): the set is tagged and the other list holds closures
// (D15338).
function id1(a) { return a }
const xs = [{ f: id1 }]
const i = 0
print(xs[i].f(2))
print(xs[i].f(2.5))
const ys = [{ f: id1 }]
print(ys[0].f(2.5))

function id2(a) { return a }
const as = [{ f: id2 }]
for x in as {
  print(x.f(2))
  print(x.f(2.5))
}
const bs = [{ f: id2 }]
print(bs[0].f("s"))

function id3(a) { return a }
const cs = [{ f: id3 }]
print(cs[i].f(2))
print(cs[i].f(2.5))
const ds: { f: (a: f64) => f64 }[] = [{ f: id3 }]
print(ds[0].f(2.5))
