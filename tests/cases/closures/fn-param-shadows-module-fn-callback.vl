// @run
// @log 30
// @log 1
// @log 30
// @log 30
// @log 1
// @log 30
// @log 30
// @log 4
// @log 6
// @log 30
// @log 4
// @log ab
// A parameter, binding or capture named like a module function is the value a `.map` /
// `.filter` callback or a higher-order argument of that name reads, whatever the module
// function's signature (D9110).
function k(s: string) { return s }
function inc(a: i32) { return a + 1 }
function d(x: i32) { return x + 1 }
function app<T>(g: (x: T) => T, v: T): T { return g(v) }
function pm(k: (x: i32) => i32) { return [3].map(k)[0] }
function pf(k: (x: i32) => boolean) { return [3, 4].filter(k).length }
function ph(k: (x: i32) => i32) { return app(k, 3) }
function lm() {
  const k = (x: i32): i32 => x * 10
  return [3].map(k)[0]
}
function cf(k: (x: i32) => boolean): () => i32 {
  return (): i32 => [3, 4].filter(k).length
}
function cm(k: (x: i32) => i32): () => i32 { return (): i32 => [3].map(k)[0] }
function gm<T>(k: (x: T) => T, v: T): T { return [v].map(k)[0] }
function ch(k: (x: i32) => i32, c: boolean) {
  return [3].map(if c { k } else { d })[0]
}
const ten = (x: i32): i32 => x * 10
const three = (x: i32): boolean => x == 3
print(pm(ten))
print(pf(three))
print(ph(ten))
print(lm())
print(cf(three)())
print(cm(ten)())
print(gm(ten, 3))
print([3].map(inc)[0])
print(app(d, 5))
print(ch(ten, true))
print(ch(ten, false))
print(k("ab"))
