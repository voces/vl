// @run
// @log 2
// @log s
// @log 3
// @log t
// A generic stored by `.set` through an un-annotated map parameter and read back by `.get` is
// called at each type it is read at; the indexed store is the control (D9591).
function id<T>(x: T): T { x }
function fill(mm) { mm.set("k", id) }
function put(mm) { mm["k"] = id }
const m = Map()
fill(m)
const r = m.get("k")
if r != null {
  print(r(2))
  print(r("s"))
}
const m2 = Map()
put(m2)
const q = m2["k"]
if q != null {
  print(q(3))
  print(q("t"))
}
