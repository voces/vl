// @run
// @log 2
// @log 3
// @log 10
// @log 3
// @log 1
// @log two!
// @log 4
// @log bb
// Q58 position sweep: a captured union box tested with `is` and read narrowed inside the closure,
// its box read raw as its lifted parameter or its environment field (`capturedBoxRaw`): a lifted
// lambda, an escaping closure, a nested closure two frames down, and a record union.
type V = i32 | string
type R = { a: i32 } | { b: string }
function vs(): V[] { return [1, "two"] }
function lifted(i: i32) {
  const c = vs()[i]
  const f = () => {
    if c is i32 { print(c + 1) } else { print(c.length) }
  }
  f()
}
function escaping(i: i32): () => i32 {
  const c = vs()[i]
  return () => if c is i32 { c * 10 } else { c.length }
}
function nested(i: i32) {
  const c = vs()[i]
  const f = () => {
    const g = () => {
      if c is string { print(c + "!") } else { print(c) }
    }
    g()
  }
  f()
}
function record(k: i32) {
  const r: R = if k > 0 { { a: k } } else { { b: "bb" } }
  const f = () => {
    if r is { a: i32 } { print(r.a) } else { print(r.b) }
  }
  f()
}
lifted(0)
lifted(1)
print(escaping(0)())
print(escaping(1)())
nested(0)
nested(1)
record(4)
record(0)
