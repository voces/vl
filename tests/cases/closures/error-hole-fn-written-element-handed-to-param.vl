// @error cannot write 'half' to an element of 'xs': called at (i32) it returns f64, where 'inc0', also written to it, returns i32
// A list element written with a function of another result, handed to an un-annotated parameter
// the callee calls, is refused at the write (D9090).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function apply(f, v) { return f(v) }
const xs = [inc0]
xs[0] = half
print(apply(xs[0], 3))
