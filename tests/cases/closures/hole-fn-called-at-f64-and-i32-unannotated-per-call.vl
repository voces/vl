// @run
// @log 4
// @log 1
// @log 3
// @log 1
// The un-annotated spelling of D8061: `g(1, 2)` is the `i32` call `add(1, 2)` is, so `r / 2`
// divides integers, whether the arguments are literals or typed bindings.
function add(a, b) { return a + b }
function p(g) {
  print(g(1.5, 2.5))
  const r = g(1, 2)
  print(r / 2)
}
function q(g) {
  const x: f64 = 1.5
  const y: i32 = 1
  print(g(x, x))
  const r = g(y, 2)
  print(r / 2)
}
p(add)
q(add)
