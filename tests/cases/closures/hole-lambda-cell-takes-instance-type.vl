// @run
// @log aC
// @log bG
// @log bC
// @log bC
// @log cG
// @log d
// @log e
// A capture cell seeded by a hole lambda holds that lambda's instance, whatever pinned it: a
// call, or the signature of a lambda written into the same cell; a cell seeded from another
// cell's read takes that cell's type; and a lambda written only into bindings nothing reads,
// itself included, is not lowered at all (D3851).
function peerPinned(x: string) {
  const c = (y) => y + "C"
  const e = (y) => y + "E"
  let d2 = e
  const w = (): i32 => {
    d2 = c
    0
  }
  w()
  print(c(x))
}
peerPinned("a")
function seededFromCell(x: string) {
  const c = (y) => y + "C"
  const g = (y) => y + "G"
  let d1 = g
  let d2 = d1
  print(d1(x))
  d2 = c
  print(d2(x))
  function w5() {
    d1 = d2
    0
  }
  w5()
  function w7() {
    d2 = g
    0
  }
  print(d1(x))
}
seededFromCell("b")
function constFromCell(x: string) {
  const c = (y) => y + "C"
  const g = (y) => y + "G"
  let d1 = g
  let d2 = c
  const d3 = d1
  const w3 = (): i32 => {
    d1 = d1
    0
  }
  w3()
  function w5() {
    d2 = d3
    0
  }
  d2 = d3
  print(d2(x))
}
constFromCell("c")
function unreadTwice(x: string) {
  const c = (y) => y + "C"
  const g = (y) => y + "G"
  let d1 = c
  let i = 0
  while i < 2 {
    d1 = g
    i = i + 1
  }
  d1 = c
  print(x)
}
unreadTwice("d")
function selfAssigned(x: string) {
  const c = (y) => y + "C"
  const g = (y) => y + "G"
  let d2 = c
  d2 = g
  d2 = d2
  print(x)
}
selfAssigned("e")
