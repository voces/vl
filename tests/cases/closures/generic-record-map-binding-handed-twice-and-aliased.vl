// @run
// @log 2
// @log s
// @log 3
// @log t
// @log true
// A map of records holding a generic, handed to the same helper twice, written directly between
// the two calls, and handed again through a `const` alias: every literal is built at the one
// record its binding holds, whichever write made it.
function id<T>(x: T): T { x }
function fill(mm) { mm["k"] = { f: id } }
const a = Map()
fill(a)
a["j"] = { f: id }
fill(a)
const b = a
fill(b)
const ar = a["j"]
if ar != null {
  print(ar.f(2))
  print(ar.f("s"))
}
const br = b["k"]
if br != null {
  print(br.f(3))
  print(br.f("t"))
}
const c = Map()
fill(c)
const cr = c["k"]
if cr != null { print(cr.f(true)) }
