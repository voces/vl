// @log aaa
// @log 4
// @log 12
// @info `d4` is never reassigned; use `const` instead of `let`
// @info `d5` is never reassigned; use `const` instead of `let`
// @info `d5` is never reassigned; use `const` instead of `let`
// A binding that hole lambdas are written into holds one signature: a lambda written by its own
// name, or through bindings never written after their initializer, is instantiated at that
// signature, so a call through the binding never reaches it at another (D3857).
function settlesLater(x: string) {
  const c = (y) => y + "C"
  const g = (y) => y + "G"
  let d1 = g
  function w1() {
    d1 = d1
    0
  }
  let d3 = c
  d3 = d1
  let d4 = d3
  print(d4(x))
  print(d1(x))
}
settlesLater("a")
function seedUnusedPeer(n: i32) {
  const c = (y) => y + 1
  const g = (y) => y * 2
  let d1 = g
  function w1() {
    d1 = d1
    0
  }
  let d3 = c
  d3 = d1
  let d5 = c
  d1 = c
  print(d5(n))
  print(d3(n))
}
seedUnusedPeer(5)
function float(f: f64) {
  const g = (y) => y + y
  let d1 = g
  function w1() {
    d1 = d1
    0
  }
  let d3 = g
  d3 = d1
  print(d3(f))
  print(d1(f))
}
float(1.25)
function seededChain(x: i32) {
  const c = (y) => y + 1
  const e = (y) => y + 2
  const g = (y) => y + 3
  let d1 = g
  function w1() {
    d1 = d1
    0
  }
  let d3 = e
  d3 = d1
  let d5 = c
  d1 = c
  print(d5(x))
  print(d3(x))
  print(d1(x))
}
seededChain(10)
function writtenByName(x: string, n: i32) {
  const e = (y) => y + y + y
  const g = (y) => y
  const d1 = g
  print(d1(x))
  let d2 = e
  print(d1(x))
  print((() => d1(x))())
  function w5() {
    d2 = g
    0
  }
  print(d2(n))
}
writtenByName("a", 4)
function loopWritesName(x: string, n: i32) {
  const c = (y) => y + y
  const e = (y) => y + y + y
  const g = (y) => y
  const d1 = g
  let d2 = d1
  let d3 = c
  function w3() {
    d2 = e
    0
  }
  w3()
  print(d2(x))
  print(d1(n))
  let i8 = 0
  while i8 < 2 {
    d3 = e
    i8 = i8 + 1
  }
  const d5 = d3
  print(d5(n))
}
loopWritesName("a", 4)
