// @run
// A local map of bundles walked by its keys, each value read and called (D17095).
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
function go() {
  const m = Map()
  m["a"] = lap((a) => a + 1)
  for k in m.keys() {
    const h = m[k]
    if h != null { print(h(1.5)) }
  }
}
go()
// @log 2.5
// @hint Intentionally-unused variable `_a`
// @hint Intentionally-unused variable `_b`
