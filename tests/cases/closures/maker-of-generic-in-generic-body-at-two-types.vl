// @run
// @log 1
// @log z
// @log 2
// @log y
// @log 2.5
// @log 3
// @log x
// @log 4
// @log w
// @log 5
// @log v
// @log true
// @log 6
// A function returning a generic, whose result a generic body calls at its own type parameter,
// runs when the body is called at two types: each instance of the body has its own copy of the
// maker (D6205), also through a generic left open and with two bodies sharing one maker.
function k<T>(x: T): T { return x }
function mk() { return k }
function g<U>(u: U) {
  const a = mk()
  print(a(u))
}
g(1)
g("z")
function mk2() { return k }
function g2<U>(u: U) { print(mk2()(u)) }
g2(2)
g2("y")
g2(2.5)
function mk3() { return k }
function g3<U>(u: U): U {
  const a = mk3()
  return a(u)
}
print(g3(3))
print(g3("x"))
function mk4() { return k }
function g4<U>(u: U) {
  const a = mk4()
  print(a(u))
}
function h4<V>(v: V) { g4(v) }
h4(4)
h4("w")
function mk5() { return k }
function g5<U>(u: U) {
  const a = mk5()
  print(a(u))
}
function g6<U>(u: U) {
  const a = mk5()
  print(a(u))
}
g5(5)
g5("v")
g6(true)
g6(6)
