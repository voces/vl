// @run
// @log O
// @log 1
// A capture cell in a generic body with one writer closure and one instance runs at each instance's own
// type (D3939, `rv3498/v11`).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function a<T>(x: T) {
  let k = inner
  const toO = () => {
    k = other
  }
  toO()
  k(x)
}
a(1)
