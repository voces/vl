// @run
// @log 1.5
// A record's list field of an un-annotated function written one of another result through a
// parameter runs the written function (D15190).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function put(o) { o.xs[0] = half }
const r = { xs: [inc0] }
put(r)
print(r.xs[0](3))
