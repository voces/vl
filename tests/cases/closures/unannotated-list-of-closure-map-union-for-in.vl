// @run
// @log 1
// @log 3
// @log 5
// @log 5
// @log 3
// An un-annotated list of a union whose map arm holds closures keys its element as the union's
// box, so the narrowed element is a map a for-in can walk (D2699), at three key reps.

const m: {[string]: (i32) => i32} = Map()
m["a"] = (a: i32) => a + 1
const u: {[string]: (i32) => i32} | string = m
const xs = [u]
const v = xs[0]
if v is {[string]: (i32) => i32} {
  let c = 0
  for k in v { c = c + 1 }
  print(c)
}

const n: {[i32]: ((i32) => i32) | null} = Map()
n[1] = (a: i32) => a + 1
n[2] = null
const un: {[i32]: ((i32) => i32) | null} | string = n
const ys = [un]
const w = ys[0]
if w is {[i32]: ((i32) => i32) | null} {
  let c = 0
  for k in w { c = c + k }
  print(c)
  const f = w[1]
  if f != null { print(f(4)) }
}

const p: {[i64]: () => string} = Map()
p[5 as i64] = () => "hi"
const up: {[i64]: () => string} | i32 = p
const zs = [up, 3]
for e in zs {
  if e is {[i64]: () => string} {
    for k in e { print(k) }
  } else {
    print(e)
  }
}
