// @emit-error a function-value call has no interned signature
// A record field holding a written `let` of a generic, called through the field from a closure
// inside a generic function: the closure is one function every instance shares, so the read has
// no per-instance type to key (D5112).
function k<T>(x: T): T { return x }
function use<U>(u: U): U {
  let g = k
  g = k
  const r = { q: g }
  const f = () => r.q(u)
  return f()
}
print(use(5))
print(use("t"))
