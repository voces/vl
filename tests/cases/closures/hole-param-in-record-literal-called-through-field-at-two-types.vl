// @run
// @log v
// @log 3
// @log w
// @log 7
// A hole parameter held in a `const` record literal and called through the field at one type and
// directly at another builds the record at the set's id; so does a field called at one type (D15445).
function same<T>(k: T): T { k }
function mid2(a) {
  const r = { f: a }
  print(r.f("v"))
  print(a(3))
}
mid2(same)
function once(a) {
  const r = { f: a }
  print(r.f("w"))
}
once(same)
function both<G>(a: G) {
  const r = { f: a }
  const s: string = r.f("abc")
  print(r.f(4) + s.length)
}
both(same)
