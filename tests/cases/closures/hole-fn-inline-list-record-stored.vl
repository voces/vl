// @log 4
// An inline list of un-annotated functions in a record literal stored as a list element or a
// map value, reassigned to a `let` or handed to an un-annotated parameter, takes its element's
// pin (D9301); a call's record result read in place takes the callee's record (D9302).
function inc0(a) { return a + 1 }
function inc1(a) { return a + 1 }
function inc2(a) { return a + 1 }
function inc3(a) { return a + 1 }
function inc4(a) { return a + 1 }
function inc5(a) { return a + 1 }
function inc6(a) { return a + 1 }
const a = [{ xs: [inc0] }]
const v = a[0]
print(v.xs[0](3))
const m = Map()
m["k"] = { xs: [inc1] }
const mv = m["k"]
if mv != null { print(mv.xs[0](3)) }
let r = { xs: [inc2] }
r = { xs: [inc2] }
print(r.xs[0](3))
function take(p) { print(p.xs[0](3)) }
take({ xs: [inc3] })
const hl = [inc4]
take({ xs: hl })
const hm = Map()
hm["k"] = inc5
function mk() { return { m: hm } }
const x = mk().m["k"]
if x != null { print(x(3)) }
function inPlace() {
  const mk2 = () => {
    return { r: { m: hm } }
  }
  const y = mk2().r.m["k"]
  if y != null { print(y(3)) }
}
inPlace()
const hl6 = [inc6]
function mk6() { return { xs: hl6 } }
print(mk6().xs[0](3))
