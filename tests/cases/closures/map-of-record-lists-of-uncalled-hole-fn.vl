// @run
// @log true
// @log true
// @log false
// @log 1
// @log a
// @log true
// @log 10
// A map whose value is a list of records holding un-annotated functions nothing calls takes the
// functions' default instance, as the same records stored bare do: entries by index and `set`,
// at an i32 key, read for another field, and beside a call that does pin it (D16161).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function dbl(a) { return a * 2 }
const m = Map()
m["k"] = [{ f: inc0 }]
print(m.has("k"))
const two = Map()
two.set("k", [{ f: inc0 }, { f: half }])
print(two.has("k"))
print(two.has("z"))
print((m["k"] ?? []).length)
const s = Map()
s[1] = [{ f: inc0, s: "a" }]
const v = s[1]
if v != null { print(v[0].s) }
function local() {
  const lm = Map()
  lm.set("k", [{ f: inc0 }, { f: dbl }])
  print(lm.has("k"))
}
local()
const c = Map()
c["k"] = [{ f: inc0 }, { f: dbl }]
for k in c.keys() {
  const w = c[k]
  if w != null { print(w[1].f(5)) }
}
