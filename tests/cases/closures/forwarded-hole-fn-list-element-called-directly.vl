// @run
// @log 1
// @log 2.5
// @log 1
// @log 2.5
// A list element that is also called directly elsewhere, with a hole parameter that splits
// only at keys its list sibling calls: the direct call hands its argument to every slot
// (D13200).
function add(a, b) { return a + b }
function apply2(g, s) { print(g(s, s)) }
function apply4(g, s) { print(g(s, 2)) }
function inner(k, h) { apply2(h, k) }
inner(0.5, add)
function inner4(k, h) { apply4(h, k) }
inner4(0.5, add)
function innerThree(k, h) {
  for f in [apply2, apply4] { f(h, k) }
}
innerThree(0.5, add)
