// @run
// @log 6
// @log 3
// @log 5
// A choice kept as its set's id beside a list of the set is still delivered to a closed function
// type, as a binding and as an argument, through its adapter (D15063).
function inc0(a) { return a + 1 }
function dbl0(a) { return a * 2 }
function apply(f: (x: i32) => i32) { return f(4) }
const b = true
const fs = [dbl0]
const g = if b { inc0 } else { dbl0 }
fs.push(g)
print(fs[1](5))
const h: (x: i32) => i32 = g
print(h(2))
print(apply(g))
