// @run
// @log b
// @hint redundant type annotation: `x` is inferred as `A | B` — remove it to lean on inference
// The witness of D2630, which runs since the tail-assignment return is read off the checker's type.
type A = { r: i32 }
type B = { s: string }
function src(): A | B { return { r: 3 } }
let x: A | B = src()
function go() {
  const k = () => {
    x = { s: "b" }
  }
  k()
  if x is B { print(x.s) }
}
go()
