// @run
// @log 41
// @log 41
// @log s
// @log 41
// @log 42
// A generic function held in a record field is a tagged set when the field is called at two
// tuples. A record of a plain function beside it keeps its own row, a nullable scalar row of the
// same field name takes neither, and a function body's record of the same member is built and
// stored at the row its id fills, even when that body calls it at one tuple only.
function k<T>(x: T): T { return x }
function m(x: i32) { return x }
type W4 = { f: i32 | null }
const r1 = { f: k }
print(r1.f(41))
const r2 = { f: m }
print(r2.f(41))
print(r1.f("s"))
function main() {
  const r4 = { f: k }
  print(r4.f(41))
}
main()
const w: W4 = { f: 42 }
print(w.f ?? 0)
