// @run
// @hint Intentionally-unused parameter `_t`
// @hint Intentionally-unused parameter `_t`
// @hint Intentionally-unused parameter `_t`
// @log 2
// @log s
// @log 2
// @log true
// @log q
// @log 3
// @log 2
// @log s
// A lambda calling its parameter at two types, called from a function with a type parameter whose
// result is inferred from that call: the function's instance is built, and the lambda's calls
// take their own types inside it.
function id(a) { return a }
const lap = (g) => {
  print(g(1) + 1)
  return g("s")
}
function w<T>(_t: T) { return lap(id) }
print(w(1))
const lapB = (g) => {
  print(g(1) + 1)
  return g(true)
}
function wb<T>(_t: T) { return lapB(id) }
print(wb(1))
const lapF = (g) => {
  print(g("q"))
  return g(2) + 1
}
function wf<T>(_t: T) { return lapF(id) }
print(wf(1))
print(w("x"))
