// @run
// @log I
// @log 1
// @log I
// @log true
// A written `let` holding generic functions and called at `i32` and at `boolean` holds one
// instance per call type, so each call runs its own (D3979, D3975).
function inner<U>(u: U) {
  print("I")
  print(u)
}
function other<V>(v: V) {
  print("O")
  print(v)
}
function main() {
  let f = other
  f = inner
  f(1)
  f(true)
}
main()
