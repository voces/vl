// @run
// @log a3
// @log b4
// @log c5
// @log a6
// @log b7
// @log g8
// @log a9
// @log c10
// @log b11
// @log g12
// @log a13
// @log c14
// @log a15
// @log b16
// @log a17
// @log a18
// @log c19
// A hole lambda, a capturing one and a generic function value delivered into a function list in
// each position: a list literal, a push, an index write, a spread, a nested list, a record in a
// list, at module scope and in a function. Each call prints the closure's own tag.
function gen<T>(x: T) { print("g" + "\{x}") }
const ha = (u) => {
  print("a" + "\{u}")
}
const hb = (u) => {
  print("b" + "\{u}")
}
const tag = "c"
const hc = (u) => {
  print(tag + "\{u}")
}
const fs: ((n: i32) => void)[] = [ha, hb, hc]
fs[0](3)
fs[1](4)
fs[2](5)
const gs: ((n: i32) => void)[] = []
gs.push(ha)
gs.push(hb)
gs.push(gen)
gs[0](6)
gs[1](7)
gs[2](8)
const ws: ((n: i32) => void)[] = [hb, hb]
ws[0] = ha
ws[1] = hc
ws[0](9)
ws[1](10)
const sp: ((n: i32) => void)[] = [...[hb], gen]
sp[0](11)
sp[1](12)
const nested: ((n: i32) => void)[][] = [[ha], [hc]]
nested[0][0](13)
nested[1][0](14)
const recs: { f: (n: i32) => void }[] = [{ f: ha }, { f: hb }]
recs[0].f(15)
recs[1].f(16)
function inFn() {
  const la = (u) => {
    print("a" + "\{u}")
  }
  const k = "c"
  const lc = (u) => {
    print(k + "\{u}")
  }
  const l: ((n: i32) => void)[] = [la]
  l.push(la)
  l[0](17)
  l[1](18)
  const m: ((n: i32) => void)[] = [lc]
  m[0](19)
}
inFn()
