// @run
// @log 1.5
// @log 4
// @log 1.5
// @log 6
// @log 2.5
// @log 6
// @log 1.5
// @log 5
// A map's `set` of records nesting a record whose function field holds un-annotated functions
// of different results joins every store's functions at the nested field (D16829).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function dbl(a) { return a * 2 }
const m = Map()
m.set("a", { r: { f0: inc0 } })
m.set("b", { r: { f0: half } })
const t = m.get("b")
if t != null { print(t.r.f0(3)) }
const c = Map()
c.set("a", { r: { f0: inc0 } })
c.set("b", { r: { f0: half } })
c.set("c", { r: { f0: dbl } })
for k in ["a", "b", "c"] {
  const v = c.get(k)
  if v != null { print(v.r.f0(3)) }
}
const d = Map()
d.set("a", { p: { q: { f: inc0 } } })
d.set("b", { p: { q: { f: half } } })
const w = d.get("b")
if w != null { print(w.p.q.f(5)) }
const x = d.get("a")
if x != null { print(x.p.q.f(5)) }
const n = Map()
n.set("a", { f0: inc0 })
n.set("b", { f0: half })
const y = n.get("b")
if y != null { print(y.f0(3)) }
const z = c.get("a")
if z != null { print(z.r.f0(4)) }
