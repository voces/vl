// @run
// @log 6
// @log 60
// The join's result bound and computed with, each arm returning the argument's result (D7183).
function add(a, b) { return a + b }
function apply2(g) { return g(1, 2) }
function apply3(g) { return g(10, 20) }
function main(c: boolean) {
  const f = if c { apply2 } else { apply3 }
  const r = f(add)
  print(r * 2)
}
main(true)
main(false)
