// @run
// @log 7
// @log 3
// @log 8
// @log 15
// @log 11
// @log hi
// @log o!
// A call to a local closure, a parameter or a lambda's parameter named `w` is classified by that
// binding, not by a `function w` nested in a SIBLING frame the call cannot see (D2289). `b`'s
// string-returning `w` is first in the file so the flat name map answers with it.

function b() {
  function w() { "hi" }
  print(w())
}
function a() {
  const w = () => {
    7
  }
  print(w() + 0)
}
function p(w: () => i32) { print(w() + 1) }
function c() {
  let w = () => {
    3
  }
  w = () => {
    4
  }
  print(w() * 2)
}
function d() {
  const f = (w: () => i32) => {
    w() + 10
  }
  print(
    f(() => {
      5
    }),
  )
}
function e() {
  function w() { 11 }
  print(w() + 0)
}
function outer() {
  function w() { "o" }
  function inner() { print(w() + "!") }
  inner()
}
a()
p(() => {
  2
})
c()
d()
e()
b()
outer()
