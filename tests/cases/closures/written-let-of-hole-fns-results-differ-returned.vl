// @run
// @log 1.5
// A re-pointed `let` returned and called by the caller runs the function it last held, its
// result the join of the functions' results (D9008, D16064).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function get() {
  let f = inc0
  f = half
  return f
}
print(get()(3))
