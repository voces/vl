// @run
// @log 1
// @log 2.5
// @log 2.5
// @log 2.5
// @log 2.5
// @log 2.5
// @log 2.5
// @log 2.5
// @log 2.5
// @log 3
// @hint redundant type annotation: `b` is inferred as `Clip[]` — remove it to lean on inference
// @hint redundant type annotation: `xs` is inferred as `Clip[][]` — remove it to lean on inference
// @hint redundant type annotation: `c` is inferred as `Clip` — remove it to lean on inference
// @hint redundant type annotation: `hs` is inferred as `f64[]` — remove it to lean on inference
// @hint redundant type annotation: `us` is inferred as `f64[]` — remove it to lean on inference
// @hint this 3-element `f64[]` is returned
// A literal argument of a function-value call builds at the callee's parameter type, never
// at the type the enclosing position expects of the call (D3605, sunpa SP-033): `[0]` into
// an `i32[]` parameter stays an `i32[]` inside a `Clip[]` field, binding, element or return.
// The annotated bindings are the destinations under test, so their hints are expected.
type Clip = { duration: f64 }
type Set = { idle: Clip | null, fidgets: Clip[] }
type Pt = { x: i32 }
const clips = [{ duration: 1.0 }]

// The filed witness.
export function ready() {
  const clipsOf = (roles: i32[]): Clip[] => {
    const out: Clip[] = []
    for r in roles { out.push(clips[r]) }
    out
  }
  const armed: Set = { idle: null, fidgets: clipsOf([0]) }
  armed.fidgets.length
}
print(ready())

function positions(): f64[] {
  const f = (a: i32[]): Clip[] => [{ duration: a[0] as f64 + 0.5 }]
  const g = (a: i32[]): f64[] => [a[0] as f64 + 0.5]
  const b: Clip[] = f([2])
  const xs: Clip[][] = [f([2])]
  const m: {[string]: f64[]} = Map()
  m["k"] = g([2])
  const got = m["k"]
  let mv = 0.0
  if got != null { mv = got[0] }
  [b[0].duration, xs[0][0].duration, mv]
}
for v in positions() { print(v) }

// A record and an empty map argument, each under a destination of another shape.
function shapes() {
  const f = (p: Pt): Clip => { duration: p.x as f64 + 0.5 }
  const h = (m: {[string]: i32}): f64[] => [(m["z"] ?? 2) as f64 + 0.5]
  const c: Clip = f({ x: 2 })
  const hs: f64[] = h(Map())
  c.duration + hs[0] - 2.5
}
print(shapes())

// A closure parameter, a closure field and a capturing nested function.
function viaParam(f: (a: i32[]) => Clip[]): Clip[] { f([2]) }
print(
  viaParam((a: i32[]): Clip[] => [{ duration: a[0] as f64 + 0.5 }])[0].duration,
)
const o = { f: (a: i32[]): Clip[] => [{ duration: a[0] as f64 + 0.5 }] }
const ow: Set = { idle: null, fidgets: o.f([2]) }
print(ow.fidgets[0].duration)
function nested() {
  let k = 0
  function f(a: i32[]): Clip[] {
    k = k + 1
    return [{ duration: a[0] as f64 + 0.5 }]
  }
  const s: Set = { idle: null, fidgets: f([2]) }
  s.fidgets[0].duration
}
print(nested())

// Nested value calls: the inner call's literal is its own callee's `f64[]`.
function chain() {
  const g = (a: f64[]): i32[] => [a.length + 1]
  const f = (a: i32[]): Clip[] => [{ duration: a[0] as f64 + 0.5 }]
  const s: Set = { idle: null, fidgets: f(g([1.0])) }
  s.fidgets[0].duration
}
print(chain())
const u = (a: (i32 | string)[]): f64[] => [a.length as f64]
const us: f64[] = u([2, "x", 3])
print(us[0])
