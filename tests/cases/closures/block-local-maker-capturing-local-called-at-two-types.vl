// @run
// @info `y` is never reassigned; use `const` instead of `let`
// @log 7
// @log 1
// @log 7
// @log s
// @log 8
// @log 1
// @log 9
// @log s
// @log 1
// @log s
// @log 3
// @log 5
// @log 1
// @log 5
// @log true
// @log 1
// @log s
// A block-local function returning a generic, called at two types through two results, gets a
// copy beside it in its block, sharing the cells it captures (D5971).
function k<T>(x: T): T { return x }
function a() {
  let y = 7
  function mk() {
    print(y)
    return k
  }
  const p = mk()
  print(p(1))
  const q = mk()
  print(q("s"))
}
function b() {
  let y = 7
  function mk() {
    print(y)
    return k
  }
  y = 8
  const p = mk()
  print(p(1))
  y = 9
  const q = mk()
  print(q("s"))
}
function c() {
  let y = 1
  function mk() {
    y = y + 1
    return k
  }
  const p = mk()
  print(p(1))
  const q = mk()
  print(q("s"))
  print(y)
}
function d(y: i32) {
  if y > 0 {
    function mk() {
      print(y)
      return k
    }
    const p = mk()
    print(p(1))
    print(mk()(true))
  }
}
function e() {
  function mk() { return k }
  const p = mk()
  print(p(1))
  const q = mk()
  print(q("s"))
}
a()
b()
c()
d(5)
e()
