// @run
// @warning Unused parameter `p`
// @warning Unused parameter `p`
// @warning Unused parameter `p`
// @warning Unused parameter `p`
// @log 1
// @log 2
// @log 3
// @log 3
// @log 4
// @log z!
// @log a!
// @log b?
// @log 9
// @log z!
// @log c!
// @log c!
// @log s
// @log 3
// An `if` naming a hole function in every arm, handed to an un-annotated parameter: one nothing
// reads takes the stub (D6992), through a binding, `else if` and a call's result, the function
// also called by name; one the callee calls takes the type the checker binds it at, forwarded or
// not, at two callees' types.
function bang(s) { return s + "!" }
function hush(s) { return s + "." }
function exclaim(s) { return s + "!" }
function shout(s) { return s + "?" }
function twice(v) { return v * 2 }
function id(v) { return v }
const on = [1].length == 1

function unread(p) { print(1) }
function unread2(p) { print(2) }
function unread3(p) { print(3) }
function unread4(p) { print(4) }
unread(if on { bang } else { bang })
const x = if on { bang } else { bang }
unread2(x)
unread3(if !on { bang } else if on { hush } else { bang })
unread3(if !on { bang } else { bang })
function pick() { return if on { bang } else { bang } }
unread4(pick())
print(bang("z"))

function callsS(p) { print(p("a")) }
callsS(if on { exclaim } else { exclaim })
function callsS2(p) { print(p("b")) }
callsS2(if !on { exclaim } else { shout })
function callsI(p) { print(p(4) + 1) }
callsI(if on { twice } else { twice })
function inner(q) { print(q("z")) }
function fwd(p) { inner(p) }
fwd(if on { exclaim } else { exclaim })
function callsC(p) { print(p("c")) }
callsC(if on { exclaim } else if !on { exclaim } else { exclaim })
callsC(exclaim)
function callsStr(p) { print(p("s")) }
function callsNum(p) { print(p(3)) }
callsStr(if on { id } else { id })
callsNum(if on { id } else { id })
