// @run
// @log 0
// @log 5
// @hint Intentionally-unused function `_viaField`
// @hint Intentionally-unused function `_viaParam`
// @hint Intentionally-unused function `_viaList`
// A closure parameter, a record field and a list element whose result is a scalar-plus-record
// or scalar-plus-list value union, in functions no producer ever reaches: the call keys the
// union box from the annotation alone (D16889).
function _viaField(p: {f: (i32) => {a: i32} | f64} | f64) {
  if p is {f: (i32) => {a: i32} | f64} {
    const t1 = p.f(1)
    if t1 is {a: i32} { print(t1.a) }
  }
}
function _viaParam(f: (i32) => {a: i32} | f64) {
  const t1 = f(1)
  if t1 is {a: i32} { print(t1.a) } else { print(t1) }
}
function _viaList(fs: (() => (i64 | boolean)[] | i32)[]) {
  const t0 = fs[0]()
  if t0 is (i64 | boolean)[] { print(t0.length) } else { print(t0) }
}
function called(f: (i32) => {b: i32} | f64) {
  const t1 = f(4)
  if t1 is {b: i32} { print(t1.b) } else { print(t1) }
}
print(0)
called((x) => ({ b: x + 1 }))
