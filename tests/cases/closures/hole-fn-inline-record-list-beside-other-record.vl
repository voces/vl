// @run
// @hint Intentionally-unused parameter `_a` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_a` (leading `_` marks it unused)
// @log 4
// @log 0.5
// @log 4
// @log 1.5
// @log 4
// @log 4
// @log 4
// @log 4
// @log 2.5
// @log 3
// @log 4
// A list of inline records of an un-annotated function, its element handed to an un-annotated
// parameter that also takes another record, instances the function at the field call (D9644).
type R = { f: (a: i32) => f64 }
function inc0(a) { return a + 1 }
function inc1(a) { return a + 1 }
function inc2(a) { return a + 1 }
function inc3(a) { return a + 1 }
function inc4(a: i32) { return a + 1 }
function inc5(a) { return a + 1 }
function inc6(a) { return a + 1 }
function take(a) { print(a.f(3)) }
const xs0 = [{ f: inc0 }]
take(xs0[0])
const ys0: R[] = [{ f: (_a: i32): f64 => 0.5 }]
take(ys0[0])
function takeU(a) { print(a.f(3)) }
const xs1 = [{ f: inc1 }]
takeU(xs1[0])
const ys1 = [{ f: (_a: i32): f64 => 1.5 }]
takeU(ys1[0])
function takeA(a) { print(a.f(3)) }
const e4 = { f: inc4 }
const xs4 = [e4]
takeA(xs4[0])
const xs5 = [{ f: inc5 }]
takeA(xs5[0])
function takeB(a) { print(a.f(3)) }
const e2 = { f: inc2 }
const xs2 = [e2]
takeB(xs2[0])
const xs3 = [{ f: inc3 }]
takeB(xs3[0])
function takeF(a) { print(a.f(1.5)) }
const xs6 = [{ f: inc6 }]
takeF(xs6[0])
// Controls: an element handed alone, and an annotated function's record listed inline.
function takeC(a) { print(a.f(2)) }
const xs7 = [{ f: inc0 }]
takeC(xs7[0])
const xs8 = [{ f: inc4 }]
take(xs8[0])
