// A re-pointed `let` holding un-annotated functions, handed to a generic's arrow parameter or
// to `.map`, closes the result at the body's type and runs whichever it holds (D9001).
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function ap<T, R>(k: (a: T) => R, x: T): R { return k(x) }
let f = inc0
if [1].length > 0 { f = dbl }
print(ap(f, 3))
function pick(b: boolean) {
  let g = inc0
  if b { g = dbl }
  return ap(g, 5)
}
print(pick(true))
print(pick(false))
print([3].map(f)[0])
function run(b: boolean) {
  let g = inc0
  if b { g = dbl }
  const ys = [5, 6].map(g)
  print(ys[0] + ys[1])
}
run(true)
run(false)
print([3].map(f).length)
function incF(a) { return a + 1.0 }
function dblF(a) { return a * 2.0 }
let e = incF
if [1].length > 5 { e = dblF }
print(ap(e, 2.5))
function m<T, U>(xs: T[], k: (a: T) => U): U[] { return xs.map(k) }
print(m([3], f)[0])
function shout(s) { return s + "!" }
function twice(s) { return s + s }
let w = shout
if [1].length > 0 { w = twice }
print(ap(w, "ab"))
print(["x"].map(w)[0])
const xs = [ap(f, 5)]
print(xs[0] + 1)
