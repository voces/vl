// @run
// @log 5
// @log 2.5
// @log 5 2.5
// @log 6
// @log 3.5
// @log 5
// @hint Intentionally-unused variable `_a`
// @hint Intentionally-unused variable `_b`
// A field holding a record of one closure per signature, copied and called at one signature
// beside a call through the field at the other: the copy's call is a use of the field too, so
// no one signature is adopted for it.
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
const u = lap((a) => a + 1)
const w = { f: u }
const v = w.f
print(v(4))
print(w.f(1.5))
const p = lap((a) => a + 1)
const q = { f: p }
const c = q.f
print("\{c(4)} \{q.f(1.5)}")
function run(k: i32) {
  const t = lap((a) => a + k)
  const o = { f: t }
  const d = o.f
  print(d(4))
  print(o.f(1.5))
}
run(2)
// The copy as the field's only call adopts it at that one signature.
const y = lap((a) => a + 1)
const z = { f: y }
const n = z.f
print(n(4))
