// @run
// @log 1.5
// @log 1.5
// A map binding of un-annotated functions reassigned under an `if` (D15354), or written a function
// outside the set of the map it is then reassigned (D15355), reads the joined set.
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function dbl(a) { return a * 2 }
const fnMap = Map()
fnMap.set("a", inc0)
fnMap.set("b", half)
const c = 1 > 0
let m1 = fnMap
if c { m1 = fnMap }
const g1 = m1.get("b")
if g1 != null { print(g1(3)) }
let m2 = Map()
m2.set("a", dbl)
m2 = fnMap
const g2 = m2.get("b")
if g2 != null { print(g2(3)) }
