// @run
// @log 2
// @log 2.5
// @log 2.5
// @log 2
// @log 2.5
// @log 2.5
// @log 3
// @log s
// @log 7
// A record literal of the initialiser's own function, written back into a binding whose function
// fields the writes widen, is built at the binding's record like any other write: its type spells
// as the binding's, and it still takes the set's storage (D15306).
function id1(a) { return a }
function id2(a) { return a }
function id3(a) { return a }
const c = 1 > 0
let a = { f: id1 }
a = { f: id2 }
a = { f: id1 }
print(a.f(2))
print(a.f(2.5))
let b = { f: id1 }
b = { f: id1 }
b = { f: id2 }
print(b.f(2.5))
let d = { g: { f: id1 } }
d = { g: { f: id2 } }
d = { g: { f: id1 } }
print(d.g.f(2))
print(d.g.f(2.5))
let e = { f: id1, n: 1 }
e = { f: id2, n: 2 }
if c { e = { f: id1, n: 3 } }
print(e.f(2.5))
print(e.n)
let h = { f: id1 }
h = { f: id2 }
h = { f: id3 }
h = { f: id1 }
print(h.f("s"))
function g(x) { return x.f(7) }
print(g(h))
