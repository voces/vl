// @run
// @log ok
// @log ok
// @log ok
// @log 1
// @hint redundant type annotation: `tailCall` is inferred as `string`
// @hint redundant type annotation: `retCall` is inferred as `string`
// D980 — A CLOSURE-FIELD CALL IN TAIL POSITION IS A VALUE.
//
// `stmtIsTailValue` returned false for EVERY member callee, so `x.f()` as a function's tail
// expression lowered as a STATEMENT — `drop` then `unreachable` under a
// `(result (ref $string))` functype, which TRAPS at run time. `return x.f()` ran, which is
// what made this look like an annotation problem rather than a POSITION one.
//
// NARROW ON PURPOSE. Every member call is arguably a tail value when the checker types it
// non-void, and widening that far is measurably wrong: `xs.push(1)` and std/array's in-place
// helpers are tail member calls in VOID functions, and claiming them puts a result on the
// stack under a `()`-result functype (`type error in return[0]`, caught by the harness's V8
// and not by the native host).
const a = { f: () => "ok" }

// The tail form — the defect.
function tailCall(x: { f: () => string }): string {
  x.f()
}
print(tailCall(a))

// The explicit return always worked; pinned so a fix cannot trade one for the other.
function retCall(x: { f: () => string }): string {
  return x.f()
}
print(retCall(a))

// The method-shorthand construction spelling is field-equivalent and must behave the same.
const b = {
  f() {
    "ok"
  },
}
print(tailCall(b))

// A VOID function's tail member call stays a statement — the control the narrow gate protects.
function fill(xs: i32[]) {
  xs.push(1)
}
const l: i32[] = []
fill(l)
print(l.length)
