// @run
// @log 6hi!

// D2316 matrix — two sibling blocks INSIDE A FUNCTION binding one closure name `g` with
// DIFFERENT PARAMETER types. Every closure-resolution rung (identClosureFeAt,
// calleeCloSigKeyAt) has to answer per call site, not per name: `parentLetOfSid`'s
// function-scope table was first-wins with no duplicate-name handling at all.

function f() {
  let out = ""
  {
    const g = (x: i32) => x + 1
    out = "\{g(5)}"
  }
  {
    const g = (x: string) => x + "!"
    out = out + g("hi")
  }
  out
}
print(f())
