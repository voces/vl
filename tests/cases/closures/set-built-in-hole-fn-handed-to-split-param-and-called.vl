// @log 2
// @log 1
// @log 1
// A set built in a function's body, handed to a parameter called at two tuples and also called
// directly, dispatches each call on the member's id at that call's own types (D14740).
function wrap(a) { return [a] }
function wrap2(a) { return [a, a, a] }
function pair(a) { return [a, a] }
function lapBack(g, h, x) {
  print(h(g(x)).length)
  print(g(h(x)).length)
  return 0
}
function go(c: boolean) {
  const s = if c { wrap } else { wrap2 }
  lapBack(s, pair, 4)
  print(s(4).length)
}
go(true)
go(false)
function goConst() {
  const c = true
  const s = if c { wrap } else { wrap2 }
  lapBack(s, pair, 4)
  print(s(4).length)
}
goConst()
