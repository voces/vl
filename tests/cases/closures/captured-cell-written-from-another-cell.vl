// @run
// @log O
// @log 1
// @log I
// @log 2
// A capture cell runs with a writer storing another capture cell's read, each value instanced at the cell's type
// (D3939, `rv3498/p25`).
function ci(f: (n: i32) => void, n: i32) { f(n) }
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function main() {
  let k = other
  let j = inner
  const flip = () => {
    k = j; j = other
  }
  ci(k, 1)
  flip()
  ci(k, 2)
}
main()
