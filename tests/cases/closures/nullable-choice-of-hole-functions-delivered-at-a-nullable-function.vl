// @run
// @log 4
// @log 4
// @log 4
// @log 4
// @log none
// @log 6
// A binding of an `if` choosing un-annotated functions or `null`, delivered at a closed nullable
// function type, instances each function arm at that type's function, as the non-null choice does.
function inc(a) { return a + 1 }
function dbl(a) { return a * 2 }
function two() { return [1, 2].length }
const h = if two() > 1 { inc } else { null }
const z: ((x: i32) => i32) | null = h
if z != null { print(z(3)) }
function f() {
  const h2 = if two() > 1 { inc } else { null }
  const z2: ((x: i32) => i32) | null = h2
  if z2 != null { print(z2(3)) }
}
f()
function use(u: ((x: i32) => i32) | null) {
  if u != null { print(u(3)) } else { print("none") }
}
const h3 = if two() > 1 { inc } else { null }
use(h3)
const h4 = if two() > 5 { null } else { inc }
use(h4)
const h5 = if two() > 5 { inc } else { null }
use(h5)
const h6 = if two() > 5 { inc } else if two() > 0 { dbl } else { null }
use(h6)
