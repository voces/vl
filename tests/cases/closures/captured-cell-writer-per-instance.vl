// @run
// @log I
// @log 1
// @log O
// @log 2
// @log I
// @log true
// @log O
// @log false
// A capture cell in a generic body with a writer each instance holds its own copy of runs at each instance's own
// type (D3939, `rv3498/v13`).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function run<T>(x: T, y: T) {
  let k = inner
  const flip = () => {
    k = other
  }
  k(x)
  flip()
  k(y)
}
run(1, 2)
run(true, false)
