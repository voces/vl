// @run
// @log B
// @log r
// @log B
// @log p
// A written `let` copied into another, one called with a `string` and the other with a string
// literal union, holds the `string` signature whichever call comes first (D4244).
function gA<U>(u: U) {
  print("A")
  print(u)
}
function gB<V>(v: V) {
  print("B")
  print(v)
}
function gC<W>(w: W) {
  print("C")
  print(w)
}
type S = "p" | "q"
const a: S = "p"
let x = gA
x = gB
let y = gC
y = x
y("r")
x(a)
