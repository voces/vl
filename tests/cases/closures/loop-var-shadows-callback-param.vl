// @run
// @log a
// A `for` loop variable named like a function-typed parameter is the loop variable, not the
// parameter callback specialization rewrites (D2114).
function a(): void { print("a") }
function go(f: (i32) => i32): void {
  const fs: (() => void)[] = [a]
  for f in fs { f() }
}
function v(x: i32) { return x }
go(v)
