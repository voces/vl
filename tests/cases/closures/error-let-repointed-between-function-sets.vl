// @error cannot store 'half' in an element of 'v': called at (i32) it returns f64, where 'inc0', also stored in it, returns i32
// A module `let` re-pointed between a list written another result type and one that was not holds
// two lists of different sets, so a call through its element is refused as before (D15196).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const xs = [inc0]
xs[0] = half
const ys = [inc0]
let v = xs
v = ys
print(v[0](3))
