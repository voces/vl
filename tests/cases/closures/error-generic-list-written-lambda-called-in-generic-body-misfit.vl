// @error a call through `fs[_]` passes i32 to a function written there that takes `string` (the call's argument types)
// A call through an element inside a generic body is judged at each instance, as a direct call
// of the same lambda through a `let` there is: `g(1)` passes `i32` where it takes `string` (D12238).
function pick<A, B>(a: A, b: B): A { a }
const fs = [pick]
fs[0] = (x, y: string) => x
function g<T>(v: T): T { fs[0](v, v) }
print(g(1))
