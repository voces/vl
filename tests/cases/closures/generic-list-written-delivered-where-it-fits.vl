// @run
// @log 3
// @log 5
// @log 5
// @log s
// A list of a generic function written with a fixed-type function, delivered where every
// element fits, runs: a parameter and a return at the written type, and a `let` rebound
// before it is handed on at another type (D10080).
function id<T>(x: T): T { x }
function inc(x: i32) { x + 1 }

const ys = [id]
ys.push(inc)
function run(a: ((x: i32) => i32)[]) { print(a[1](2)) }
run(ys)
print(ys[0](5))
function get(): (x: i32) => i32 { ys[0] }
print(get()(5))

let zs = [id]
zs.push(inc)
zs = [id, id]
function runS(a: ((x: string) => string)[]) { print(a[1]("s")) }
runS(zs)
