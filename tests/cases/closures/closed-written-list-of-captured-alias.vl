// @run
// @log 5
// @log 1
// A list written with a closed function takes that signature only when every element names a
// function: a captured alias of a generic is listed at its own representation.
function id<T>(x: T): T { x }
function inc(x: i32) { x + 1 }
function fr() {
  const c = id
  const f = () => {
    const ys = [c, c]
    ys[1] = inc
    print(ys[0](5))
  }
  f()
  print(id("s").length)
}
fr()
