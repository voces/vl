// @run
// @log ss
// @log 6
// A hole lambda stored by `.set` into a map of `(i32) => i32`, then called directly at `string`,
// takes an instance per signature, as a list store does (D3897).
const tw = (y) => y + y
const ms: {[string]: (y: i32) => i32} = Map()
ms.set("a", tw)
print(tw("s"))
const g = ms.get("a")
if g != null { print(g(3)) }
