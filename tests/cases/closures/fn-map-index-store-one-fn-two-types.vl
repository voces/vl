// @run
// @log 3
// @log 3.5
// @log 2
// @log s
// @log 3
// @log 3.5
// One un-annotated function written into a map through an index store, read back and called at
// two types, is held as its set's id as the `set` spelling of that write is (D15116).
function inc(a) { return a + 1 }
function id0(a) { return a }
const mp = Map()
mp["k"] = inc
const g = mp["k"]
if g != null {
  print(g(2))
  print(g(2.5))
}
function run() {
  const m = Map()
  m["k"] = id0
  const h = m["k"] ?? id0
  print(h(2))
  print(h("s"))
}
run()
const xs = [inc]
xs[0] = inc
print(xs[0](2))
print(xs[0](2.5))
