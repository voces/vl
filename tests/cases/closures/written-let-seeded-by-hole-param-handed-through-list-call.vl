// @run
// @log 3
// @log 2
// @log 2.25
// The written `let` a hole parameter initialises is handed on through a list's call.
function add(a, b) { return a + b }
function mul(a, b) { return a * b }
function two(g) {
  print(g(1, 2))
  print(g(0.5, 1.5))
}
two(add)
function same(g, s) { print(g(s, s)) }
function swap(k, h) {
  let hh = h
  hh = mul
  for f in [same] { f(hh, k) }
}
swap(1.5, add)
