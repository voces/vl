// @run
// @hint Intentionally-unused parameter `_a` (leading `_` marks it unused)
// @log s
// @log 4
// @log s
// @log 4
// @log s
// @log 4
// A list element or a record field written with un-annotated functions whose results differ,
// handed to a generic `(x: T) => R` parameter, dispatches on the member it holds (D16093, D16097).
function inc(a) { return a + 1 }
function str(_a) { return "s" }
function app<T, R>(g: (x: T) => R, v: T): R { return g(v) }
function elem(c: boolean) {
  const fs = [inc]
  if c { fs[0] = str }
  print(app(fs[0], 3))
}
function field(c: boolean) {
  const o = { f: inc }
  if c { o.f = str }
  print(app(o.f, 3))
}
function lit(c: boolean) {
  const fs = [inc, str]
  print(app(fs[if c { 1 } else { 0 }], 3))
}
elem(true)
elem(false)
field(true)
field(false)
lit(true)
lit(false)
