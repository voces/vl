// @run
// @log false
// @log 3
// @log s
// @log true
// @log true
// @log false
// Two bindings each written with generics and called at two types compare by the function they
// hold, `!=` as `==` does: unequal once one is rewritten, equal again once both hold one, and a
// copy is never unequal to its source.
function id<T>(x: T): T { return x }
function k<T>(x: T): T { return x }
function main() {
  let f = id
  f = k
  let g = id
  g = k
  print(f != g)
  print(f(3))
  print(g("s"))
  g = id
  print(f != g)
  f = id
  print(f == g)
  const h = f
  print(h != f)
}
main()
