// @run
// @info `hh` is never reassigned; use `const` instead of `let`
// @log 3
// @log 2
// @log 3
// @log 1
// A binding copying a hole parameter read both as an argument through a set and as a list
// element does not forward the parameter: the set stays a closure where the alias is stored.
function add(a, b) { return a + b }
function same(g, s) { print(g(s, s)) }
function twoCalls(g, s) {
  print(g(1, 2))
  print(g(s, 1.5))
}
function once(k, h) {
  for f in [twoCalls] { f(h, k) }
}
once(0.5, add)
function stored(k, h) {
  let hh = h
  for f in [same] { f(hh, k) }
  const xs = [hh]
  print(xs.length)
}
stored(1.5, add)
