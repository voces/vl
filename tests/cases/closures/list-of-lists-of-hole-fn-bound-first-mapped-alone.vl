// @run
// The bound-first spelling of `list-of-lists-literal-of-hole-fn-mapped-alone.vl`: the same
// list-of-lists of a hole function no other call pins, bound to a `const`, then mapped.
function inc6(a) { return a + 1 }
function apN(r) { return r[0](5) }
const xs = [[inc6]]
print(xs.map(apN)[0])
// @log 6
