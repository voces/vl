// @run
// @log 1.5
// @log 2.5
// A tagged set's value arm a site keeps across the checker's runs re-takes its arguments' types
// with its callee's, so a lambda converting a record field beside a loop converting it runs.
function id(a) { return a }
function deliver() { return [{ f: id }] }
const k = (r): { f: (a: f64) => f64 } => ({ f: r.f })
print(k(deliver()[0]).f(1.5))
for r in deliver() {
  const h: { f: (a: f64) => f64 } = { f: r.f }
  print(h.f(2.5))
}
