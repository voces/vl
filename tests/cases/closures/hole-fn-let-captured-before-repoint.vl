// @run
// @log 6
// @log 5
// @log 4
// @log 8
// @log 4
// A written `let` of two hole functions, read by a closure taken BEFORE the write, calls the
// value the binding holds when the closure runs, at the type each call site hands it: the
// capture at module scope, the same inside a function, and the closure run before the write.
function inc(a) { return a + 1 }
function dbl(a) { return a * 2 }
let f = inc
const h = () => f(3)
f = dbl
print(h())
print(f(2.5))
function run() {
  let g = inc
  const k = () => g(4)
  const before = k()
  g = dbl
  print(before - 1)
  return k()
}
print(run())
let m = dbl
const n = () => m(2)
print(n())
m = inc
