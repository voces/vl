// @run
// @log 5
// @log 2.5
// @log 3
// A maker one of whose calls is handed to a parameter, beside a holder calling it at two
// signatures, is not converted to a record (all or nothing per maker, coordinator ruling Q2): it
// keeps the lowering it had, which runs.
function mk() { return (a) => a + 1 }
const v = mk()
print(v(4))
print(v(1.5))
function take(a) { return a(2) }
print(take(mk()))
