// @run
// @log 1
// @log 1
// @log 1
// @log xC
// A lambda with an open parameter that is stored but never called has no instance and is
// not emitted, wherever it is stored; one called through the list still runs (D12301).
const c = (y) => y + "C"
const fs = [c]
print(fs.length)
const c2 = (y) => y + "C"
const r = { f: c2, n: 1 }
print(r.n)
function main() {
  const c3 = (y) => y + "C"
  const gs = [c3]
  print(gs.length)
}
main()
const c4 = (y) => y + "C"
const hs = [c4]
for f in hs { print(f("x")) }
