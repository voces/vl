// @emit-error cannot take the generic function `exclaim` as a value
// @warning This expression has no effect: it is not the final statement of its block, so its value is discarded
// A hole function no call instances, discarded as a statement and also compared, is not inert:
// the stub it would prune to must never be observed, so the comparison still refuses (D6960).
function exclaim(s) { return s + "!" }
exclaim
print(exclaim == exclaim)
