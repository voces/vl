// @run
// @log 3
// @log 1.5
// @log 1.5
// @log 6
// @log 3.75
// Second delivery positions of a hole call's widened `f64` result: beside a second handed
// function, returned, held in a list and passed to an `f64` parameter (D8100).
function add(a, b) { return a + b }
function half(a) { return a / 2.0 }
function two(g, h) {
  print(g(1, 2))
  print(h(3))
}
function ret(h) { return h(3) }
function listed(h) { return [h(5), h(7)] }
function take(x: f64) { print(x * 1.5) }
function pass(h) { take(h(5)) }
two(add, half)
print(ret(half))
const xs = listed(half)
print(xs[0] + xs[1])
pass(half)
