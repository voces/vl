// @run
// @log 0.75
// @log 1.5
// @log 2.5
// @log 0.75
// @log 1.5
// @log 2.5
// @log 1
// @log 2
// @log 5
// @log 10
// @log 1
// @log 2
// @log 5
// @log 10
// @log a=1
// @log b=2
// @log a=1
// @log b=2
// A closure created inside a loop over a captured `for-in` element or range counter sees that
// iteration's value whether it is called during the loop or after it.
function walk(xs: f64[]) {
  const late: (() => f64)[] = []
  for z in xs {
    const half = () => z / 2.0
    print(half())
    late.push(half)
  }
  for f in late { print(f()) }
}
function count(n: i32) {
  const late: (() => i32)[] = []
  for i in 0 to n {
    const sq = () => i * i + 1
    print(sq())
    late.push(sq)
  }
  for f in late { print(f()) }
}
function keys(m: {[string]: i32}) {
  const late: (() => string)[] = []
  for k, v in m {
    const tag = () => "\{k}=\{v}"
    print(tag())
    late.push(tag)
  }
  for f in late { print(f()) }
}
walk([1.5, 3.0, 5.0])
count(3)
const m: {[string]: i32} = Map()
m["a"] = 1
m["b"] = 2
keys(m)
