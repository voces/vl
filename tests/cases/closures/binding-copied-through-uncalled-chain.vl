// @run
// @log a
// @log a
// @log 4
// @log aa
// @log 4
// @log 4
// @log 8
// @hint redundant type annotation: `w8` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `w8` is inferred as `i32` — remove it to lean on inference
// Bindings no call goes through, written by name with several lambdas and read into one
// another, take the signature of the called binding they feed, in a function.
function mk(x: string, n: i32) {
  const c = (y) => y + y
  const g = (y) => y
  const d1 = g
  print(d1(x))
  let d2 = c
  const w3 = (): i32 => {
    d2 = c; 0
  }
  w3()
  print((() => d1(x))())
  d2 = g
  let d3 = g
  function w8(): i32 { d3 = d2; 0 }
  w8()
  print(d3(n))
}
mk("a", 4)
function chain(x: string, n: i32) {
  const c = (y) => y + y
  const g = (y) => y
  print(c(x))
  let d2 = c
  const w3 = (): i32 => {
    d2 = c; 0
  }
  w3()
  d2 = g
  let d5 = c
  d5 = d2
  let d3 = g
  function w8(): i32 { d3 = d5; 0 }
  print(d3(n))
  w8()
  print(d3(n))
  d2 = c
  d5 = d2
  w8()
  print(d3(n))
}
chain("a", 4)
