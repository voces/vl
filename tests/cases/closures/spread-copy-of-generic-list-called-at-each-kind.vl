// @run
// @log 2
// @log 2.5
// @log 7
// @log s
// @log true
// @log 4
// A list a generic function was pushed into, spread into a copy and called through the copy's
// element at several types: the instance runs a copy of each index read as its own statement,
// and that copy reads at the read's type.
type P = { n: i32 }
function id<T>(x: T): T { return x }
function f() {
  const xs = []
  xs.push(id)
  const ys = [...xs]
  print(ys[0](2))
  print(ys[0](2.5))
  print(ys[0](7 as i64))
  print(ys[0]("s"))
  print(ys[0](true))
  const p: P = { n: 4 }
  print(ys[0](p).n)
}
f()
