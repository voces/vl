// @error cannot write a lambda to an element of 'fs': a call through it at (i32, i32) runs it, and it takes `string` at parameter 2
// A write through a list holding the list writes the list's own element (D12239).
function pick<A, B>(a: A, b: B): A { a }
const fs = [pick]
const gs = [fs]
gs[0][0] = (x, y: string) => x
print(fs[0](1, 2))
