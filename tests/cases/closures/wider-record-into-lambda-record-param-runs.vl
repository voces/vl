// @run
// @log a
// @log b
// @log q
// @log ab
// @log a!
// A record wider than a lambda's declared record parameter is passed at its own row, each call
// at its own, as a function's parameter is (D16400).
type P = { name: string }
const v: { age: i32, name: string } = { age: 3, name: "a" }
const w: { name: string, k: boolean } = { name: "b", k: true }
const show = (p: P) => print(p.name)
show(v)
show(w)
const q: P = { name: "q" }
show(q)
const nm = (p: P) => p.name
print(nm(v) + nm(w))
const bump = (p: P) => {
  return p.name = p.name + "!"
}
bump(v)
print(v.name)
