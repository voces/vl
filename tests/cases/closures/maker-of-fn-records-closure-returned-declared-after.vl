// @run
// @log 11.5
// A top-level call of an annotated function declared below it whose callees take un-annotated
// parameters: the function is checked first, as an early function's body checks its callee.
const h = frReturned()
print(h(7))
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function mk() { return { a: [{ f: inc0 }, { f: half }] } }
function frReturned() {
  const c = mk().a
  return (x: i32) => c[0].f(x) + c[1].f(x)
}
