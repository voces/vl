// @run
// @log 4
// @log 4
// @log 4
// @log 4
// @log 6
// D17127: an un-annotated function handed through one, two or three forwarding parameters into a
// record literal built with a closure field stays a closure, as handed straight in it does (D16738).
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function mk(f) { return { f: f } }
function mk2(f) { return { r: { f: f } } }
function o1(f) { return mk(f) }
function o2(f) { return o1(f) }
function o3(f) { return o2(f) }
function n1(f) { return mk2(f) }
print(o1(inc0).f(3))
print(o2(inc0).f(3))
print(o3(inc0).f(3))
print(n1(inc0).r.f(3))
print(o1(dbl).f(3))
