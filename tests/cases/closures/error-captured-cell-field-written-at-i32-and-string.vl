// @error cannot assign string to i32
// A record field's concrete function type written into a cell wanted at string (review of #3498, `rv3498/c06_cell_field_i32_str`).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function third<Z>(z: Z) { print("T"); print(z) }
type R = { f: (n: i32) => void }
function a<T>(x: T) {
  let k = inner
  const r: R = { f: other }
  const w = () => {
    k = r.f
  }
  w()
  k(x)
}
a(1)
a("s")
