// @run
// @log x
// @log y!
// @log x!
// @log y?
// @log x!
// @log y
// @log none
// D4351: a function value whose result is a string literal union is delivered at a function type
// returning `string`, or that union made nullable, through an adapter at each position.
type K = "x" | "y"
function t(k: K): K { k }
const h: (k: K) => string = t
print(h("x"))
function call(f: (k: K) => string, k: K): string { f(k) + "!" }
print(call(t, "y"))
const fs: ((k: K) => string)[] = [t]
print(fs[0]("x") + "!")
const lam: (k: K) => string = (k: K) => k
print(lam("y") + "?")
const u: ((k: K) => string) | i32 = t
if u is (k: K) => string { print(u("x") + "!") }
const n: (k: K) => K | null = t
print(n("y") ?? "n")
const m: (k: K) => K | null = (_k: K): K | null => null
print(m("x") ?? "none")
