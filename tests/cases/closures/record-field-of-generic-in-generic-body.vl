// @run
// @log 7
// @log 7
// @log s
// A record literal in a generic body, holding a generic called through the field, instances it
// at each enclosing instance's type (D4080).
function twice<T>(x: T): T { x }
function g<T>(x: T): T {
  const ops = { run: twice }
  ops.run(x)
}
print(g(7))
const ops2 = { run: twice }
print(ops2.run(7))
print(g("s"))
