// @run
// @log 1
// @log true
// @log true
// @log O
// @hint Intentionally-unused variable `_r` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_rr` (leading `_` marks it unused)
// A closure's recorded result is what its signature lowers, so binding the value of a tail
// write is a value: a bare `null` written to a field, read or not (D8880), and an `else`-less
// `if` writing a function cell in a generic body (D14791).
type O = { v: string | null }
const o: O = { v: "a" }
const c = () => {
  o.v = null
}
const _r = c()
print(1)
const r2 = c()
print(r2 == null)
const s: (string | null)[] = ["a"]
const e = () => {
  s[0] = null
}
const r3 = e()
print(r3 == null)

function inner<U>(u: U) { print(u) }
function other<V>(_v: V) { print("O") }
function g<T>(x: T) {
  let k: (t: T) => void = inner
  const toO = () => {
    if x == x { k = other }
  }
  const _rr = toO()
  k(x)
}
g(1)
