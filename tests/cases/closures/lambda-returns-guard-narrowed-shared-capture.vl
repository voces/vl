// @run
// @log 2
// @log -2
// A lambda returning a guard-narrowed capture its frame writes later returns the narrowed
// scalar, not the shared cell's box (D2532).
function main() {
  let v: i32 | null = 1
  if v != null {
    const h = () => v
    print(h() + 1)
  }
  v = null
  print(v ?? -2)
}
main()
