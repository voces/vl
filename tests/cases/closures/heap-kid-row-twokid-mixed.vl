// @run
// @log 4
// @log 8
// A function handed to a hole parameter that a returned record holds one record down:
// beside a sibling holding another function.
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function mk2(f) { return { r: { f: f }, s: { f: dbl } } }
const q = mk2(inc0)
print(q.r.f(3))
print(q.s.f(4))
