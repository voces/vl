// @run
// @log aE
// @log 3.5
// @log 2.5
// @log 3.5
// @log bE
// @log cC
// @log dC
// A function-scope `let` alias of a module-scope hole lambda, written with a second module-scope
// hole lambda nothing else calls: the written lambda takes the alias's signature from the call
// through it, in the same function or a nested writer, conditionally, or with no read after
// (D3865, D3859).
const c = (y) => y + "C"
const e = (y) => y + "E"
const cf = (y) => y + 1.5
const ef = (y) => y + 2.5
function written(x: string) {
  let d = c
  d = e
  print(d(x))
}
written("a")
function writtenF64(x: f64) {
  let d = cf
  d = ef
  print(d(x))
}
writtenF64(1.0)
function nestedWriterF64(x: f64) {
  let d = cf
  function w() { d = ef }
  print(d(x))
  w()
  print(d(x))
}
nestedWriterF64(1.0)
function conditional(x: string, f: boolean) {
  let d = c
  if f { d = e }
  print(d(x))
}
conditional("b", true)
conditional("c", false)
function noReadAfter(x: string) {
  let d = c
  print(d(x))
  d = e
}
noReadAfter("d")
