// @error-at 6:2 operator '+' is not defined for boolean and i32
// A write after the call in source order is re-asked too, as for a written `let` (D4010).
function inner<U>(u: U) { print("I"); print(u) }
function plus<V>(v: V) { print(v + 1) }
function main() {
  const fs = [inner]
  fs[0](true)
  fs[0] = plus
}
main()
