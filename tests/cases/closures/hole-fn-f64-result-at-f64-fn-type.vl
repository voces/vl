// Should print:
// 4.5
// 4.5
// 4
// An un-annotated function whose body gives `f64` fits `(a: i32) => f64`, and so does a lambda
// judged at that type, whose `i32` result converts inside its own body (D9011's neighbours).
function scale(a) { return a * 1.5 }
const f: (a: i32) => f64 = scale
print(f(3))
const g: (a: i32) => f64 = (a) => a * 1.5
print(g(3))
const h: (a: i32) => f64 = (a) => a + 1
print(h(3))
