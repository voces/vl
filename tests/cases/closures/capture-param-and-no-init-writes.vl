// @run
// @log 9
// @log 42
// @log 12
// @log 6
// A closure writing its maker's PARAMETER, and a `let` with no initializer (D2287). Both are
// shared cells under capture by reference (D2339): a parameter's cell is seeded from the
// argument at the top of the body, and an uninitialized `let` starts at its type's zero value.
function f(g: (i32) => i32): i32 { g(1) }
function h(p: i32): i32 {
  f((i) => { p = 9; 0 })
  p
}
print(h(1))
function named(p: i32): i32 {
  function inner() { p = p + 40 }
  inner()
  p
}
print(named(2))
function ret(p: i32): () => i32 {
  return () => {
    p = p + 1
    p
  }
}
const r = ret(10)
r()
print(r())
function noinit(): i32 {
  let n: i32
  n = 1
  const w = () => { n = n + 5 }
  w()
  n
}
print(noinit())
