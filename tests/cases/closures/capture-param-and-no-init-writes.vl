// @run
// @log 9
// @log 42
// @log 12
// @log 6
// @hint Intentionally-unused parameter
// @hint redundant type annotation
// A closure writing its maker's PARAMETER, and a `let` with no initializer (D2287). Both are
// shared cells under capture by reference (D2339): a parameter's cell is seeded from the
// argument at the top of the body, and an uninitialized `let` starts at its type's zero value.
function f(g: (i32) => i32): i32 { return g(1) }
function h(p: i32): i32 {
  f((_i) => {
    p = 9; return 0
  })
  return p
}
print(h(1))
function named(p: i32): i32 {
  function inner() { return p = p + 40 }
  inner()
  return p
}
print(named(2))
function ret(p: i32): () => i32 {
  return () => {
    p = p + 1
    return p
  }
}
const r = ret(10)
r()
print(r())
function noinit(): i32 {
  let n: i32
  n = 1
  const w = () => {
    return n = n + 5
  }
  w()
  return n
}
print(noinit())
