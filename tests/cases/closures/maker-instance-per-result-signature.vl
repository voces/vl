// @run
// @log s
// @log 3
// @log 1
// @log t
// @log 2
// @log v
// @log 4
// @log u
// A maker, a function returning a generic, gets an instance per result signature a use closes
// (D14825): one read as a value at a declared function type beside one whose result a binding
// calls at another type, a maker nested in a function whose results two bindings call at two
// types, the same in a block at module scope, and a maker whose results are only called, which
// returns the set's tag.
function k<T>(x: T): T { return x }
function mk() { return k }
function valueAndCall() {
  const b = mk()
  print(b("s"))
  const h: () => (x: i32) => i32 = mk
  print(h()(3))
}
function nested() {
  function mkL() { return k }
  const a = mkL()
  print(a(1))
  const b = mkL()
  print(b("t"))
}
function tagged() {
  const a = mk()
  print(a(4))
  const b = mk()
  print(b("u"))
}
valueAndCall()
nested()
if true {
  function mkB() { return k }
  const a = mkB()
  print(a(2))
  const b = mkB()
  print(b("v"))
}
tagged()
