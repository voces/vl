// @run
// @info `p` is never reassigned; use `const` instead of `let`
// @info `q` is never reassigned; use `const` instead of `let`
// @log 5
// @log 2.5
// @log 8
// @log 3
// @log 5
// @log 2.5
// @log 10
// @log 5
// @log 2.5
// @log 6
// @log 3.5
// @log 5
// @log 2.5
// @log 5
// @log 2.5
// @log 3
// @log 5
// @log 2.5
// @log 5
// @log 2.5
// A hole lambda's bundle handed on through un-annotated parameters and their `const` copies, held
// in a never-assigned `let` copy or a `let` written from another holder, read off a field or an
// element and handed whole, and dropped at the top level or by a `void` function (D15902, D15903,
// D15904). `lap`'s parameter shares the name of the function `f` (D15905).
function lap(f) {
  f(2.5)
  f(3)
  return f
}
function take(b) {
  print(b(4))
  print(b(1.5))
}
function fw(a) { take(a) }
function fw2(a) { fw(a) }
function fwc(a) {
  const v = a
  take(v)
  print(v(9))
}
fw(lap((a) => a + 1))
fw2(lap((a) => a * 2))
fwc(lap((a) => a + 1))
let p = lap((a) => a + 1)
let q = p
take(q)
let r = lap((a) => a + 2)
take(r)
r = p
take(r)
const o = { f: lap((a) => a + 1), n: 3 }
take(o.f)
print(o.n)
const xs = [lap((a) => a + 1)]
take(xs[0])
lap((a) => a + 1)
function quiet(n: i32): void { lap((a) => a + n) }
quiet(1)
function f(n: i32) { take(lap((a) => a + n)) }
f(1)
