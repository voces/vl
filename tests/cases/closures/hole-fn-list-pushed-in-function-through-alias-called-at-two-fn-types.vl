// @run
// @warning Unused parameter `a`
// @log x2
// @log y20
// @log y20
// @log 4
// @log 2
// @log 20
// @log 20
// @log 2
// D10792 at two other delivery positions: a push inside a function, and a push through a
// `const` alias between the loops, reach the copy too.
import { toString } from "std:fmt"

function cat(a, b) { return a + b.toString() }
function snd(a, b) { return b }
function apply2(g) { print(g("x", 2)) }
function apply3(g) { print(g("y", 20)) }
const fs = [apply2, apply3]
const gs = fs
function more() { fs.push(apply3) }
more()
for f in fs { f(cat) }
gs.push(apply2)
print(fs.length)
for f in gs { f(snd) }
