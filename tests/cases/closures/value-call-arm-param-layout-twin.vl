// @run
// @log 7
// @log 7
// @log 7
// @log 7
// A VALUE CALL WHOSE ARM-TYPED PARAMETER IS GIVEN THE ARM'S DECLARED LAYOUT TWIN — D732, and
// the whole of what `emitProgram: value-call union-ARM parameter given a value that is not
// that arm` refused.
//
// THE DIRECT SPELLING RAN THE WHOLE TIME. `function lamc(x: Circle): Circle { return x }` plus
// the identical `lamc(c)` runs on master — `emitCall` has no floor here at all; it seeds
// `argCtx.variantIdx` and pushes the value. So does deleting `Dot` (with no twin the literal
// is claimed by the arm and `exprVariantIndex` answers) and so does annotating `c`. What
// decided the outcome was which spelling of the CALLEE was written.
//
// THE FLOOR'S OWN HEADER CARVED THIS CASE OUT AND DID NOT IMPLEMENT IT. It refutes an `ObjLit`
// EXEMPTION with a witness — `f({ r: 7 })` "with an arm-typed closure parameter AND NO LAYOUT
// TWIN" fell from a loud reject into check-clean invalid wasm — and the clause it turns on is
// exactly the predicate that was missing. WITH a declared twin the arm and the struct are ONE
// heap type in the emitted module (`uVarSTwin`, D280), so the raw push is valid by
// construction, and the guard now asks the HEAPS (`sHeapIdx[row] == uVarHeap[vi]`) rather than
// any one of the three twin columns — verbatim the test `emitUnionBoxArg` already runs at the
// box boundary. Where the heaps DIFFER the floor stands unchanged.
//
// `Dot` IS LOAD-BEARING IN EVERY LEG: it is the declared struct whose layout `Circle`'s arm
// heap merges with. Deleting it does not test this predicate — it removes the need for it.
type Circle = { r: i64 }
type Dot = { r: i64 }
type Sq = { s: i32 }
type Shape = Circle | Sq

function useShape(s: Shape) {
  if s is Sq { return 1 }
  return 0
}

// 1. the lambda BINDING spelling.
function leg1() {
  const c = { r: 7 }
  const lamc = (x: Circle) => x
  const dd = lamc(c)
  if dd.r == 7 { print(7) } else { print(0) }
}
leg1()

// 2. module scope, same shape.
const c2 = { r: 7 }
const lamc2 = (x: Circle) => x
const dd2 = lamc2(c2)
if dd2.r == 7 { print(7) } else { print(0) }

// 3. the argument is a CALL result rather than a binding, inside a lambda inside a function.
function mkcall() {
  const cc = { r: 7 }
  return cc
}
function leg3() {
  const lam = () => {
    const lamc = (x: Circle) => x
    const dd = lamc(mkcall())
    if dd.r == 7 { print(7) } else { print(0) }
  }
  lam()
}
leg3()

// 4. the CONTROL that keeps the floor honest: the union itself is still reachable, and a
//    genuine union VALUE still routes through the box.
function leg4() {
  const sv: Shape = { s: 1 }
  if useShape(sv) == 1 { print(7) } else { print(0) }
}
leg4()
