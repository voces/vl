// @run
// @log 3
// @log 1
// @log 30
// @log 0.75
// @log 3
// @log 4
// @log 30
// @log 2.25
// D10700 through an indexed `const` list in a hole function instanced twice: each instance types
// the elements at its own `k`.
function add(a, b) { return a + b }
function apply2(g, s) {
  print(g(1, 2))
  print(g(s, s))
}
function apply3(g, s) {
  print(g(10, 20))
  print(g(s, 0.25))
}
function inner(k) {
  const fs = [apply2, apply3]
  let i = 0
  while i < fs.length {
    fs[i](add, k)
    i = i + 1
  }
}
inner(0.5)
inner(2.0)
