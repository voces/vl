// @emit-error cannot take the generic function `inc` as a value
// A hole function called by name, handed to a parameter whose alias is compared with itself: a
// comparison reads the value, so its signature would be observed (D4551). The alias read
// nowhere runs: `hole-fn-called-by-name-and-aliased-by-param.vl` (D6931).
function inc(x) { x + 1 }
function run(f) {
  const k = f
  print(k == k)
}
run(inc)
print(inc(4))
