// @run
// @log L
// @log s
// @log L
// @log true
// The written `let` delivered to an un-annotated parameter is called there at a boolean.
function other<V>(v: V) { print("O"); print(v) }
function via(fv, b: boolean) { fv(b) }
function main() {
  let k = other
  k = (n) => {
    print("L"); print(n)
  }
  k("s")
  via(k, true)
}
main()
