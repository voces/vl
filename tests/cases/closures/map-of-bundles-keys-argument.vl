// @run
// The keys handed as an argument (D17095).
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
const m = Map()
m["a"] = lap((a) => a + 1)
function count(ks) { return ks.length }
print(count(m.keys()))
// @log 1
// @hint Intentionally-unused variable `_a`
// @hint Intentionally-unused variable `_b`
