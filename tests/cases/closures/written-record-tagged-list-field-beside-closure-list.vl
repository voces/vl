// @run
// @log 6
// @log 6
// @log 4
// @log 6
// @log 1
// @log 8
// A written `let` record whose write widens one list field to a tagged set's ids, beside a field
// holding a list of closures, is built at the binding's joined set at its initializer and its
// write: an uncalled sibling, a sibling of a function the set holds, a read between the
// initializer and the write, and inside a function (D17778).
function inc0(a) { return a + 1 }
function dbl0(a) { return a * 2 }
function half0(a) { return a / 2.0 }
let t0 = { f: [inc0], g: [half0] }
t0 = { f: [dbl0], g: [half0] }
print(t0.f[0](3))

function inc1(a) { return a + 1 }
function dbl1(a) { return a * 2 }
let t1 = { f: [inc1], g: [inc1] }
t1 = { f: [dbl1], g: [inc1] }
print(t1.f[0](3))

function inc2(a) { return a + 1 }
function dbl2(a) { return a * 2 }
function half2(a) { return a / 2.0 }
let t2 = { f: [inc2], g: [half2] }
print(t2.f[0](3))
t2 = { f: [dbl2], g: [half2] }
print(t2.f[0](3))
print(t2.g.length)

function inc3(a) { return a + 1 }
function dbl3(a) { return a * 2 }
function half3(a) { return a / 2.0 }
function m3() {
  let t = { f: [inc3], g: [half3] }
  t = { f: [dbl3], g: [half3] }
  print(t.f[0](4))
}
m3()
