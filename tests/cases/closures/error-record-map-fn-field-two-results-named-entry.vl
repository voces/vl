// @error cannot write 'half' to 'm[].f': called at (i32) it returns f64, where 'inc0', also written to it, returns i32
// A map entry written from a named record rather than a literal, whose function field holds
// functions of different results with another entry's, is refused at check: only an entry's own
// literal is built at the map's value row (D15801).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const m = Map()
const r1 = { f: inc0 }
m["a"] = r1
m["b"] = { f: half }
const r = m["a"]
if r != null { print(r.f(3)) }
