// @run
// @log 8
// @log 8
// @log 8
// @log 1
// @log 8
// @log 8
// @log 8
// @log 9
// @log 8
// @log 8
// @log 1
// @log 8
// @log 8
// @log 8
// @log 8
// @log 8
// @log 1
// @log 6
// @log 8
// @log 6
// @info `ge` is never reassigned; use `const` instead of `let`
// @hint redundant type annotation: `takG` is inferred as `i32`
// @hint redundant type annotation: `go` is inferred as `i32`
// @hint redundant type annotation: `gp` is inferred as `i32`
// @hint redundant type annotation: `usesP` is inferred as `i32`
// D1602 — a call through a closure-typed BINDING whose name a module function also carries
// is a `call_ref` through the binding, not a direct `call` on the function. The emitter's
// call arm resolved the callee by NAME (`fnIndexOfInScopeChain`, a walk over DECLARATIONS)
// before asking whether a param or a local of that name is in scope, so the checker's
// lexical answer and the emitted instruction disagreed.
//
// The loud face is an arity or valtype mismatch inside the caller; the `gb` case below is
// the SILENT one, where the direct call was valid wasm and printed 800.
//
// Lifted functions are keyed by name first-wins in `buildFnMap`, so every nested function
// and every module function here is spelled distinctly.

// The witness: a closure-typed parameter named like a module function, called in the body's
// tail. The module function takes no argument, so the direct call did not validate.
function ga() { 6 }
function takA(ga: (i32) => void) { ga(8) }
takA((n) => { print(n) })

// SAME ARITY, and this one ran: the direct call was valid wasm over the wrong function and
// printed 800. A value proves the conversion, not merely that the module builds.
function gb(x: i32) { print(x * 100) }
function takB(gb: (i32) => void) { gb(8) }
takB((n) => { print(n) })

// Statement position rather than the body's tail.
function gc() { 6 }
function takC(gc: (i32) => void) {
  gc(8)
  print(1)
}
takC((n) => { print(n) })

// The binding is a local `const`, then a `let`, then one with no annotation at all: the
// shadow's storage class is not an ingredient.
function gd() { 6 }
function takD() {
  const gd: (i32) => void = (n) => { print(n) }
  gd(8)
}
takD()

function ge() { 6 }
function takE() {
  let ge: (i32) => void = (n) => { print(n) }
  ge(8)
}
takE()

function gf() { 6 }
function takF() {
  const gf = (n: i32) => { print(n) }
  gf(8)
}
takF()

// The call's value is USED, so the frame's result valtype is the closure's, not the module
// function's.
function gg() { 6 }
function takG(gg: (i32) => i32): i32 { gg(8) }
print(takG((n) => { n + 1 }))

// A NULLABLE closure parameter, narrowed before the call.
function gh() { 6 }
function takH(gh: ((i32) => void) | null) {
  if gh != null { gh(8) }
}
takH((n) => { print(n) })

// The shadowing parameter belongs to a NESTED function.
function gi() { 6 }
function outerI() {
  function innerI(gi: (i32) => void) { gi(8) }
  innerI((n) => { print(n) })
}
outerI()

// A nested function declared beside the shadowed call: the frame's own declarations are
// still resolved by name, so the nested call must keep working.
function gj() { 6 }
function takJ(gj: (i32) => void) {
  function innerJ() { print(1) }
  innerJ()
  gj(8)
}
takJ((n) => { print(n) })

// A LAMBDA's own parameter does the shadowing.
function gk() { 6 }
function applyK(f: ((i32) => void, i32) => void) { f((n) => { print(n) }, 8) }
applyK((gk, v) => { gk(v) })

// An `i64` parameter, so the closure's signature differs from the module function's in the
// argument width as well.
function gl() { 6 }
function takL(gl: (i64) => void) { gl(8 as i64) }
takL((n) => { print(n as! i32) })

// The module function CAPTURES, which is a different direct-call arm.
const kM = 5
function gm() { kM }
function takM(gm: (i32) => void) { gm(8) }
takM((n) => { print(n) })

// The binding is in a module-scope BLOCK, so the shadowed call is in the start function.
function gn() { 6 }
if true {
  const gn: (i32) => void = (n) => { print(n) }
  gn(8)
}

// CONTROL, and the direction the fix must not break: the block's binding covers the call
// inside it, and the call after the block is the module function's.
function go(): i32 { 6 }
function takO() {
  if true {
    const go: (i32) => void = (n) => { print(n) }
    go(1)
  }
  print(go())
}
takO()

// CONTROL — a second frame calls the module function by name while the first shadows it.
function gp(): i32 { 6 }
function usesP(): i32 { gp() }
function takP(gp: (i32) => void) {
  gp(8)
  print(usesP())
}
takP((n) => { print(n) })
