// @run
// @log 6
// @log 3.5
// @hint Intentionally-unused variable `_a`
// @hint Intentionally-unused variable `_b`
// A list element holding a record of one closure per signature, in a function body: the copy and
// the element's place each take their own member.
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
function run(k: i32) {
  const u = lap((a) => a + k)
  const xs = [u]
  const v = xs[0]
  print(v(4))
  print(xs[0](1.5))
}
run(2)
