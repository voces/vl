// @run
// @log 1.5
// @log true
// @log 4
// @log 4
// @log 1.5
// @log 2.5
// @log 1.5
// @log 5
// @log 2
// A map written two functions of different result types, read by index: the read is the
// nullable value `get` reads, a missing key reads `null`, and `??` supplies a default (D15139).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const m = Map()
m.set("a", inc0)
m.set("b", half)
const g = m["b"]
if g != null { print(g(3)) }
print(m["z"] == null)
const h = m["a"]
if h != null { print(h(3)) }
const d = m["z"] ?? inc0
print(d(3))
function look(k) {
  const f = m[k]
  if f != null { print(f(3)) }
}
look("b")
const n = Map()
n[1] = inc0
n[2] = half
const t = n[2]
if t != null { print(t(5)) }
const c = () => {
  const r = m["b"]
  if r != null { print(r(3)) }
}
c()
for k in ["a", "b"] {
  const e = m[k]
  if e != null { print(e(4)) }
}
