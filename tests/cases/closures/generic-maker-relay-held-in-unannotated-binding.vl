// @run
// @log 41
// @log 7
// @log 8
// @log 2.5
// A relay of a generic maker whose result one binding takes at `(x: i32) => i32` and an
// un-annotated `const` holds and only calls, at `i32`: the relay is built at that one result,
// as the maker's own `const` binding would be, so neither call reaches the `f64` instance
// another binding of the maker took (D16756).
function k<T>(x: T): T { return x }
function mk() { return k }
const o = mk()
const of = o(2.5)
function deliver() { return mk() }
const v: (x: i32) => i32 = deliver()
const z = deliver()
print(v(41))
print(z(7))
print(z(8))
print(of)
