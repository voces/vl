// A list element or record field holding one generic takes an instance per call: inside each
// instance of a generic function, with a returned `T[]`, at two type parameters, and at a
// string literal union beside `string` or another union (D4242).
function wrap<U>(u: U) {
  function id<T>(x: T): T { x }
  const fs = [id]
  print(fs[0](u))
  print(fs[0](2.5))
  "ok"
}
print(wrap(7))
print(wrap("w"))
function twice<T>(x: T): T[] { [x, x] }
const ts = [twice]
print(ts[0](3).length)
print(ts[0]("q")[1])
const tr = { g: twice }
print(tr.g(true)[0])
print(tr.g(2.5)[1])
function pair<A, B>(a: A, b: B) {
  print("P")
  print(a)
  print(b)
}
const ps = [pair]
ps[0](3, true)
ps[0](true, 4)
function same<W>(w: W): W { w }
type S = "p" | "q"
type R = "r" | "s"
const sa: S = "q"
const rb: R = "r"
const sy = { h: same }
print(sy.h(sa))
print(sy.h("str"))
const sl = [same]
print(sl[0](sa))
print(sl[0](rb))
