// @run
// @log 3
// @log true
// A map of an un-annotated function, read through a list handed to an un-annotated parameter,
// gives the member or null (D17123).
function half(a) { return a / 2.0 }
const m = Map()
m.set("a", half)
function take(xs) {
  const g = xs[0].get("a")
  if g != null { print(g(6)) }
  const z = xs[0].get("zz")
  print(z == null)
}
take([m])
