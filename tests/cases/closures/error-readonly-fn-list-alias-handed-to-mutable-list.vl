// @check
// @error-at 10:4 argument 1: expected ((i32) => i32)[], got readonly ((i32) => i32 | f64)[]
// A storage alias keeps its declared readonly type for every delivery of it: handing it to a
// mutable list of the narrower functions would let a write through the alias land in storage
// typed wider, so it is refused (D17816).
type W = (x: i32) => i32 | f64
function inc(a: i32) { return a + 1 }
function bad(q: ((x: i32) => i32)[]) { q.push(inc) }
const b = [inc]
const z: readonly W[] = b
bad(z)
