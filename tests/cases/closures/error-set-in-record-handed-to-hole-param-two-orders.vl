// @emit-error this call runs a function value that may hold any of a set of functions returning different types
// A set of functions with different results, left closures by a generic's hand, and handed to an
// un-annotated parameter inside a record field is refused at emit, not called at one signature
// (D16878).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function id2(x) { return x }
function app(o) { return o.l[0](3) }
const ll = id2([half, inc0])
print(app({ l: [inc0, half] }))
print(app({ l: [half, inc0] }))
