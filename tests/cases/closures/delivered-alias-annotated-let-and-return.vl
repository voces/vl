// @run
// @log 12
// @log 12
// @log sss
// The other two typed deliveries of a binding a lambda is written into: an annotated
// function-typed binding, and an annotated function-typed return (D3862).
const c = (y) => y + y
const e = (y) => y + y + y
let d = c
function w() { d = e }
w()
const g: (y: i32) => i32 = d
print(g(4))
function get(): (y: i32) => i32 { d }
print(get()(4))
print(e("s"))
