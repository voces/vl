// D2395/D2396: a closure whose tail stores a literal into an element of a captured
// `(i32 | f64)[][]` yields the element, re-read from the place the literal was built for. It
// yielded the literal's own `f64[]`, a type the closure could not produce, and trapped. A
// function returning an element of a local ref list was invalid wasm (D2396).
// @run
// @log 2 3.5 4
// @log 2 3.5
// @log 2 s 4
// @log 2 2.5 true
// @log 1 3.5
// @log 2 3.5
// @log 2 2.5
// @log 2 3.5 4

// D2395's filed witness, printing the elements.
function witness() {
  const c: (i32 | f64)[][] = [[1, 2.5]]
  const k = () => {
    c[0] = [3.5, 4]
  }
  k()
  "\{c[0].length} \{c[0][0]} \{c[0][1]}"
}
print(witness())

// The closure's value is the stored element.
function used() {
  const c: (i32 | f64)[][] = [[1, 2.5]]
  const k = () => {
    c[0] = [3.5, 4]
  }
  const r = k()
  "\{r.length} \{r[0]}"
}
print(used())

function strMember() {
  const c: (i32 | string)[][] = [[1]]
  const k = () => {
    c[0] = ["s", 4]
  }
  k()
  const a = c[0][0]
  const b = c[0][1]
  if a is string && b is i32 { "\{c[0].length} \{a} \{b}" } else { "?" }
}
print(strMember())

// A literal whose member order differs from the element's.
function order() {
  const c: (boolean | f64)[][] = [[true]]
  const k = () => {
    c[0] = [2.5, true]
  }
  k()
  const a = c[0][0]
  const b = c[0][1]
  if a is f64 && b is boolean { "\{c[0].length} \{a} \{b}" } else { "?" }
}
print(order())

function depth3() {
  const c: (i32 | f64)[][][] = [[[1]]]
  const k = () => {
    c[0] = [[3.5]]
  }
  k()
  "\{c[0][0].length} \{c[0][0][0]}"
}
print(depth3())

function named() {
  const c: (i32 | f64)[][] = [[1]]
  function g() { c[0] = [3.5, 4] }
  g()
  "\{c[0].length} \{c[0][0]}"
}
print(named())

// D2396: an element of a local ref list as a function's value.
function elem() {
  const c: (i32 | f64)[][] = [[1, 2.5]]
  c[0]
}
const e = elem()
print("\{e.length} \{e[1]}")

const g: (i32 | f64)[][] = [[1]]
const kg = () => {
  g[0] = [3.5, 4]
}
kg()
print("\{g[0].length} \{g[0][0]} \{g[0][1]}")
