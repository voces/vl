// @run
// @log 2
// @log 2.5
// @log 3
// @log 4
// @log 4.5
// @log 5
// @log 5.5
// @log 6.5
// @log 6
// @log 1
// A list of lists of records whose field is an un-annotated function called at two types holds
// its id, through a binding of an inner list, a written slot, a push, beside a second such list
// and beside a record of the same shape that holds a number (D15350).
function id1(a) { return a }
function id2(a) { return a }
function id3(a) { return a }
const xs = [[{ f: id1 }]]
print(xs[0][0].f(2))
print(xs[0][0].f(2.5))
const row = xs[0]
print(row[0].f(3))
const ws = [[{ f: id1 }]]
ws[0][0] = { f: id2 }
print(ws[0][0].f(4))
print(ws[0][0].f(4.5))
const ps = [[{ f: id1 }]]
ps[0].push({ f: id2 })
print(ps[0][1].f(5))
print(ps[0][0].f(5.5))
const ys = [[{ f: id3 }]]
print(ys[0][0].f(6.5))
print(ys[0][0].f(6))
const zs = [[{ f: 1 }]]
print(zs[0][0].f)
