// @run
// @log y!
// @log 42
// @log 10
// @log y!
// @log 5
// @log 4
// @log s!
// @log a b!
// @log 4
// @log 6
// @log 10
// @log 5
// D9381: a generic over a record parameter, returned from an un-annotated function, is instanced
// at the destination's record: named by a declaration, spelled inline, nested, at two types, and
// fixed by an un-annotated binding's first call.
type K = "x" | "y"
type R = { k: K }
function pick<T>(r: { k: T }): T { r.k }
function deliver() { return pick }
const v: (r: R) => K = deliver()
print(v({ k: "y" }) + "!")
type R2 = { k: i32, n: string }
function pick2<T>(r: { k: T, n: string }): T { r.k }
function deliver2() { return pick2 }
const v2: (r: R2) => i32 = deliver2()
print(v2({ k: 41, n: "a" }) + 1)
type In = { k: i32 }
type N = { inner: In }
function deep<T>(r: { inner: { k: T } }): T { r.inner.k }
function deliver3() { return deep }
const v3: (r: N) => i32 = deliver3()
print(v3({ inner: { k: 9 } }) + 1)
const v4: (r: { k: K }) => K = deliver()
print(v4({ k: "y" }) + "!")
function pickI<T>(r: { k: T }): T { r.k }
function deliverI() { return pickI }
const a: (r: { k: i32 }) => i32 = deliverI()
const b: (r: { k: string }) => string = deliverI()
print(a({ k: 4 }) + 1)
print(a({ k: 3 }) + 1)
print(b({ k: "s" }) + "!")
type S = "a b" | "c"
function pickS<T>(r: { k: T }): T { r.k }
function deliverS() { return pickS }
const vs: (r: { k: S }) => S = deliverS()
print(vs({ k: "a b" }) + "!")
function pickU<T>(r: { k: T, n: string }): T { r.k }
function deliverU() { return pickU }
const u = deliverU()
print(u({ k: 3, n: "z" }) + 1)
print(u({ k: 5, n: "w" }) + 1)
function deepU<T>(r: { inner: { k: T } }): T { r.inner.k }
function deliverD() { return deepU }
const d = deliverD()
print(d({ inner: { k: 9 } }) + 1)
function pickR<T>(r: { k: T }): T { r.k }
function deliverR() { return pickR }
const w = deliverR()
const r: In = { k: 4 }
print(w(r) + 1)
