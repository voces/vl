// @run
// @log true
// @log false
// @log -1
// @log 3
// D3075: a lambda whose parameter is `Circle | Sq | null`, a union spelled nowhere else, is
// given the union box, so a bare `null` argument and a record argument both reach it.
type Circle = { r: i32 }
type Sq = { s: i32 }
const f = (w: Circle | Sq | null) => w == null
print(f(null))
print(f({ r: 1 }))
const g = (w: Circle | Sq | null): i32 => if w == null { 0 - 1 } else if w is Sq { w.s } else { w.r }
print(g(null))
print(g({ s: 3 }))
