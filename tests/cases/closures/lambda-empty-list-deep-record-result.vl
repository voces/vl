// @run
// @log 0
// @log 1
// A lambda returning `[]` handed to a parameter whose result is a list of a record that nests
// another record twice per level, eleven levels deep, takes the parameter's result as its own,
// as a named function returning `[]` does. The second call's element is nullable.
type A0 = {x: i32}
type A1 = {l: A0, r: A0}
type A2 = {l: A1, r: A1}
type A3 = {l: A2, r: A2}
type A4 = {l: A3, r: A3}
type A5 = {l: A4, r: A4}
type A6 = {l: A5, r: A5}
type A7 = {l: A6, r: A6}
type A8 = {l: A7, r: A7}
type A9 = {l: A8, r: A8}
type A10 = {l: A9, r: A9}
type A11 = {l: A10, r: A10}
function g(f: () => A11[]) { f().length }
print(g(() => []))
function gn(f: () => (A11 | null)[]) {
  const r = f()
  r.push(null)
  r.length
}
print(gn(() => []))
