// @run
// @log c8
// @log n5
// @log m6
// @log q7
// @log 102
// A closure calling a captured parameter that shadows a module-block binding of the same name
// with a different function type. The call resolves to the parameter, the read's own
// declaration, never the block's `f` (D14603).
{
  const f = (x: string) => x.length + 100
  const use = (f: (x: i32) => string) => {
    const c = () => f(8)
    return c()
  }
  print(use((x: i32) => "c\{x}"))
  const apply = (f: (x: i32) => string, v: i32) => f(v)
  print(apply((x: i32) => "n\{x}", 5))
  function app2(f: (x: i32) => string, v: i32) { return f(v) }
  print(app2((x: i32) => "m\{x}", 6))
  const fs: ((x: i32) => string)[] = [(x: i32) => "q\{x}"]
  for f in fs { print(f(7)) }
  print(f("ab"))
}
