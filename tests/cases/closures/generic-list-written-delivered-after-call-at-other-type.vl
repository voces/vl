// @run
// @log s
// @log 3
// A list of a generic function written with a fixed-type function and delivered where it fits
// runs when a call of the generic at another type comes first in the source (D10123).
function id<T>(x: T): T { x }
function inc(x: i32) { x + 1 }
function run(a: ((x: i32) => i32)[]) { a[1](2) }
const ys = [id]
ys.push(inc)
print(id("s"))
print(run(ys))
