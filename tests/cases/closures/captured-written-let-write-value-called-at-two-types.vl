// @run
// @log I
// @log 1
// @log O
// @log 2
// @log O
// @log x
// @log O
// @log s
// @log I
// @log true
// @log O
// @log 4
// A write inside a closure to a `let` of generics, whose value the closure returns, is the
// binding's own value: the returned function is called at two types, as the binding is.
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function main() {
  let k = inner
  const flip = () => {
    k = other
  }
  const back = () => {
    k = inner
  }
  k(1)
  const r = flip()
  r(2)
  r("x")
  k("s")
  back()
  k(true)
  const z = (k = other)
  z(4)
}
main()
