// @run
// @log 6
// @log 4
// @log 10
// @log 2
// @log 6
// @log 1.5
// @log 2
// Records holding un-annotated functions of one result, or a single function, are not refused
// in a map or a list, read through a binding, `?.` or a push (D9370's control).
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function half(a) { return a / 2.0 }
const m = Map()
m["a"] = { f: inc0 }
m.set("b", { f: dbl })
print(m["b"]?.f(3) ?? 0)
const r = m.get("a")
if r != null { print(r.f(3)) }
const l = [{ f: inc0 }, { f: dbl }]
const q = l[1]
print(q.f(5))
const t = q
print(t.f(1))
l.push({ f: dbl })
print(l[2].f(3))
const h = [{ f: half }]
const s = h[0]
print(s.f(3))
h.push({ f: half })
print(h[1].f(4))
