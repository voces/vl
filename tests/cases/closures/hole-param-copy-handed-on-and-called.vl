// A hole parameter's copy that is both handed on and called carries the parameter's per-call
// binding: in either order, at a second signature, and read inside a nested function (D15581).
function add(a, b) { return a + b }
function mul(a, b) { return a * b }
function apply2(g) {
  print(g(1, 2))
  print(g(1.5, 2.5))
}
function run(h) {
  const hh = h
  apply2(hh)
  print(hh(10, 20))
}
run(add)
run(mul)
function run2(h) {
  const hh = h
  print(hh(10, 20))
  for f in [apply2] { f(hh) }
}
run2(add)
run2(mul)
function run3(h) {
  const hh = h
  apply2(hh)
  print(hh(1.5, 2))
}
run3(add)
function run4(h) {
  const hh = h
  function inner() {
    for f in [apply2] { f(hh) }
    print(hh(10, 20))
  }
  inner()
}
run4(add)
run4(mul)
