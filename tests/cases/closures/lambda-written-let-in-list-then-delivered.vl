// @run
// @log O
// @log 3
// @log L
// @log true
// A `let` written with an un-annotated lambda after its list read splits per call type and runs
// (D7102).
function other<V>(v: V) { print("O"); print(v) }
function cb(f: (b: boolean) => void, b: boolean) { f(b) }
function main() {
  let k = other
  const fs = [k]
  k = (n) => {
    print("L"); print(n)
  }
  fs[0](3)
  cb(k, true)
}
main()
