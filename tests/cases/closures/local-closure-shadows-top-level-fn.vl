// @run
// @log 7
// @log 3
// @log 6
// @log top!
// @log top?
// @log 1
// @log 2
// @log 18
// @log top
// @log 9
// @log top
// A local closure, a parameter or a captured binding named `w` shadows a top-level `function w`
// when the call's result is classified, and a block-local `w` in a sibling block or a later loop
// variable does not hide the top-level function from a call outside it (D2289).

function w() { return "top" }
function a() {
  const w = () => {
    return 7
  }
  print(w() + 0)
}
function p(w: () => i32) { print(w() + 1) }
function blk(c: boolean) {
  if c {
    const w = 5
    print(w + 1)
  }
  print(w() + "!")
}
function later() {
  print(w() + "?")
  for w in [1, 2] { print(w) }
}
function cap() {
  const w = () => {
    9
  }
  const g = () => {
    w() * 2
  }
  print(g())
}
function stmtBlk(c: boolean) {
  if c {
    const w = () => {
      return 8
    }
    print(w() + 1)
  }
  print(w())
}

a()
p(() => {
  2
})
blk(true)
later()
cap()
print(w())
stmtBlk(true)
