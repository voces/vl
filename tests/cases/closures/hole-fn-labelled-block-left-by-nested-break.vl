// @run
// @hint Intentionally-unused variable `_unread`
// @log 1
// @log a!
// @log b?
// @log c!
// @log d.
// @log e!
// @log f!
// @log g!
// @log h!
// @log i!
// A labelled block left by a `break` inside a nested loop, whose value is an uncalled hole
// function, is that value: bound unread, called, from the tail, out of a `while`, from two
// depths, returned, passed on, generic and annotated (D7080).
function exclaim(s) { return s + "!" }
function ask(s) { return s + "?" }
function dot(s) { return s + "." }
function shout<S>(s: S) { return s + "!" }
function query<S>(s: S) { return s + "?" }
const xs = [1, 2, 3]

const _unread = @B {
  for v in xs {
    if v == 2 { break @B exclaim }
  }
  ask
}
print(1)

const called = @B {
  for v in xs {
    if v == 2 { break @B exclaim }
  }
  ask
}
print(called("a"))

const tail = @B {
  for v in xs {
    if v == 9 { break @B exclaim }
  }
  ask
}
print(tail("b"))

const looped = @B {
  let i = 0
  while i < 3 {
    if i == 1 { break @B exclaim }
    i = i + 1
  }
  ask
}
print(looped("c"))

const deep = @B {
  for v in xs {
    for w in xs {
      if w == 3 && v == 2 { break @B dot }
    }
    if v == 9 { break @B exclaim }
  }
  ask
}
print(deep("d"))

function pick() {
  const x = @B {
    for v in xs {
      if v == 2 { break @B exclaim }
    }
    ask
  }
  return x
}
print(pick()("e"))

function apply(f, s: string) { return f(s) }
const passed = @B {
  for v in xs {
    if v == 2 { break @B exclaim }
  }
  ask
}
print(apply(passed, "f"))

const generic = @B {
  for v in xs {
    if v == 2 { break @B shout }
  }
  query
}
print(generic("g"))

const annotated: (s: string) => string = @B {
  for v in xs {
    if v == 2 { break @B exclaim }
  }
  ask
}
print(annotated("h"))

for i in 0 until 1 {
  const ranged = @B {
    for j in 0 until 3 {
      if j == 1 { break @B exclaim }
    }
    ask
  }
  print(ranged("i"))
}
