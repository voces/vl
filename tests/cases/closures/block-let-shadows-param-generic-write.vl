// @run
// @log I
// @log 3
// @log I
// @log true
// @log 9
// @warning `f` shadows the `f` declared at 12:12 in this function; rename one if they are different values
// A block `let` shadowing a parameter is its own binding, so a generic written into it keeps its
// own instance (D4011).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function h(f: i32) {
  inner(3)
  if true {
    let f = other
    f = inner
    f(true)
  }
  print(f)
}
h(9)
