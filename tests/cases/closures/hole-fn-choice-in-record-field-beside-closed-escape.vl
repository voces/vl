// The same choice of hole functions delivered to a closed annotated binding and stored in a
// record field called at another type. Each position reads the set's one rep, decided from the
// calls of the check that types the program (D14427).
function idg(t) { return t }
function kg(t) { return t + t }
const c = [1].length > 0
const f: (x: i32) => i32 = if c { kg } else { idg }
print(f(3))
const r = { h: if c { kg } else { idg } }
print(r.h("s"))
