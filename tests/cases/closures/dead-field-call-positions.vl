// @run
// @log printed
// @log argument
// @log 4
// @log statement
// @log 6
// @log optional
// @log 7
// @info `?.f` here is always null
// @info `?.f` here is always null
// A call through a field that no function reaches, because its receiver or the field is typed
// `null` (or `never`) where a guard leaves it dead, writes `unreachable` and the code goes on. Each
// position is its own function.

type R = { v: i32, f: (() => i32) | null }

function printed(z) {
  if z.f != null { print(z.f()) } else { print("printed") }
}
printed({ v: 1, f: null })

function show(x: i32) { print(x) }
function argument(z) {
  if z.f != null { show(z.f()) }
  print("argument")
}
argument({ v: 3, f: null })

function returned(z) {
  if z.f != null { return z.f() }
  return 4
}
print(returned({ v: 4, f: null }))

function statement(z) {
  if z.f != null { z.f() }
  print("statement")
}
statement({ v: 5, f: null })

function optional() {
  const a = null
  print(a?.f(1) ?? 6)
  a?.f(2)
  print("optional")
}
optional()

const r: R = { v: 7, f: null }
function declared(x: R) {
  if x.f != null { print(x.f()) } else { print(x.v) }
}
declared(r)
