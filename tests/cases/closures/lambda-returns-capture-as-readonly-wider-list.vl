// @run
// @log 1
// @log 7
// @log 7
// @log 3
// @log 3
// @log 1
// An un-annotated lambda returning a captured `i32[]` where its delivered result is a readonly
// `i64[]` or `f64[]` takes the view its annotated twin takes, at a returned function, a typed
// `const`, an argument and a parameter's callback, and through a value `if` joining two lists
// (D3087).
function mkf(x: i32[]): () => readonly i64[] {
  return () => {
    return x
  }
}
print(mkf([1])()[0])
const xs = [7]
const f: () => readonly i64[] = () => xs
print(f()[0])
function take(g: () => readonly i64[]) { print(g()[0]) }
take(() => xs)
function pick(x: i32[], y: i64[], c: boolean): () => readonly i64[] {
  return () => if c { x } else { y }
}
print(pick([1], [2], true)()[0] + pick([1], [2], false)()[0])
function pick2(x: i32[], y: i64[], c: boolean): () => readonly i64[] {
  return () => {
    if c { return x }
    return y
  }
}
print(pick2([1], [2], true)()[0] + pick2([1], [2], false)()[0])
function mkd(x: i32[]): () => readonly f64[] { return () => x }
print(mkd([1])()[0])
