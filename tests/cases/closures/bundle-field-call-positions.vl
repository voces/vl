// @run
// @log 5
// @log 2.5
// @log 10
// @log 0.5
// @log 11
// @log 16
// @log 107
// @log 100.5
// @log 1001
// @log 1000.5
// A record field holding a lambda's bundle (one closure per signature it is called at), called
// through the field at each signature. Each position is its own function.

function lap(f) {
  f(2.5)
  f(3)
  return f
}

function printed() {
  const o = { f: lap((a) => a + 1) }
  print(o.f(4))
  print(o.f(1.5))
}
printed()

function bound() {
  const o = { f: lap((a) => a * 2) }
  const x = o.f(5)
  const y = o.f(0.25)
  print(x)
  print(y)
}
bound()

function show(n: i32) { print(n) }
function argument() {
  const o = { f: lap((a) => a + 10) }
  show(o.f(1))
}
argument()

function returned(k: i32) {
  const o = { f: lap((a) => a - k) }
  return o.f(20)
}
print(returned(4))

function besideScalar() {
  const o = { n: 7, f: lap((a) => a + 100) }
  print(o.f(o.n))
  print(o.f(0.5))
}
besideScalar()

const m = { f: lap((a) => a + 1000) }
print(m.f(1))
print(m.f(0.5))
