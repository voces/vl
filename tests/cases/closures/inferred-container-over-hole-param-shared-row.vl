// A record over a hole parameter, instanced with closures whose returns share a rep (`i32` and
// `boolean`) beside one that does not (`f64`): the two rep-equal shapes share one struct row,
// and each instance's own shape type must still find it.
// @run
// @log 55
// @log true
// @log 1.5
// @log 55
// @log 1.5
// @log true
function field(a) {
  const s = { f: a }
  print(s.f(54))
}
field((n: i32) => n + 1)
field((n: i32) => n > 3)
field((n: i32): f64 => if n > 3 { 1.5 } else { 0.5 })
function later(a) {
  const s = { f: a }
  print(s.f(54))
}
later((n: i32) => n + 1)
later((n: i32): f64 => if n > 3 { 1.5 } else { 0.5 })
later((n: i32) => n > 3)
