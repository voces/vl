// @run
// The holder called through in an if arm (D17111).
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
const m = Map()
m["a"] = lap((a) => a + 1)
const x = m["a"]
function pick(c: boolean) { return if c && x != null { x(4) } else { 0 } }
print(pick(true))
// @log 5
// @hint Intentionally-unused variable `_a`
// @hint Intentionally-unused variable `_b`
