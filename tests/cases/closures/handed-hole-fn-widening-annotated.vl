// @run
// @log 1.5
// @log 1.5
// @hint redundant type annotation: `half` is inferred as `f64`
// The annotated spelling of a handed function widening `i32` to `f64`, and its hole result
// held at an annotated `f64` binding (D8100).
function half(a: i32): f64 { return a / 2.0 }
function p(h) {
  const r: f64 = h(3)
  print(r)
}
function w(h: (i32) => f64) { print(h(3)) }
p(half)
w(half)
