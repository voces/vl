// @run
// @log 10941
// @log NULL
// @log 7
// @log 4242
// @hint redundant type annotation: `v` is inferred as `() => {f: ({f: i32} | null)[]}`
// @hint redundant type annotation: `h` is inferred as `() => {f: ({f: i32} | null)[]}`
// @hint redundant type annotation: `p` is inferred as `() => {f: {f: i32}[]}`
// A closure whose RESULT is a STRUCT one of whose fields is an ARRAY of NULLABLE
// STRUCTS (`{f: ({f: i32} | null)[]}`). The closure-result shape gate
// (`funcTypeShapeLowerable` → `structElemArrayLowerable`) read the field's element
// text AS WRITTEN, so the grouping parens the nullable element REQUIRES
// (`({f: i32} | null)[]`) — and the ones a plain element MAY carry (`({f: i32})[]`) —
// made the whole result struct un-lowerable, so it never interned. The body literal
// then fieldset-matched onto its OWN element row (`{f: …}` on both) and `struct.new`'d
// the ref-list wrapper into the element's i32 field — INVALID WASM inside the lambda
// itself (`expected i32, found (ref $type)`), even with no read at all. The annotated
// named-function VALUE spelling (`mk(): {f: ({f: i32} | null)[]}`) lowers this rep
// already — the element is the kind-1 struct NICHE (`(ref null $S)`) in the very same
// ref-list wrapper the non-null element uses — so peeling the grouping pair (and the
// `| null` wrapper) only removes the annotation. Fuzz report-only branching leg.
function go() {
  const v: () => {f: ({f: i32} | null)[]} = () => ({ f: [{ f: 10941 }] })
  const t0 = v().f[0]
  if t0 != null { print(t0.f) } else { print("NULL") }
  // A `null` element hole + a non-null sibling under the same niche.
  const h: () => {f: ({f: i32} | null)[]} = () => ({ f: [null, { f: 7 }] })
  const h0 = h().f[0]
  if h0 != null { print(h0.f) } else { print("NULL") }
  const h1 = h().f[1]
  if h1 != null { print(h1.f) } else { print("NULL") }
  // The paren-GROUPED plain-struct element sibling (`({f: i32})[]`) — the same
  // fieldset twin, the same INVALID WASM before the peel.
  const p: () => {f: ({f: i32})[]} = () => ({ f: [{ f: 4242 }] })
  print(p().f[0].f)
}
go()
