// @run
// @hint Intentionally-unused parameter `_a` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_b` (leading `_` marks it unused)
// @log s
// @log 4
// @log s!
// @log 5
// @log 1.5
// @log 7
// A call through a re-pointed `let` of un-annotated lambdas whose results differ dispatches on
// the lambda the binding holds and types the members' join (D16090).
function run(c: boolean) {
  let f = (a) => a + 1
  if c { f = (_a) => "s" }
  print(f(3))
}
function narrow(c: boolean) {
  let f = (a) => a + 1
  if c { f = (_a) => "s" }
  const r = f(3)
  if r is string { print(r + "!") } else { print(r + 1) }
}
function two(c: boolean) {
  let f = (a, b) => a + b
  if c { f = (a, _b) => a * 0.5 }
  print(f(3, 4))
}
run(true)
run(false)
narrow(true)
narrow(false)
two(true)
two(false)
