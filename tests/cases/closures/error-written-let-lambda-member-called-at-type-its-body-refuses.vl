// @error argument 1: operator '*' is not defined for string and i32 (the body of `k` applies '*' to this argument)
// A written `let` holding a lambda is judged at every type it is called at, whichever member a
// call reaches, so no instance is minted for a call the lambda's body cannot take.
function other<V>(v: V) { print(v) }
function main() {
  let k = (x) => {
    print(x * 2)
  }
  const flip = () => {
    k = other
  }
  k(1)
  flip()
  k("s")
}
main()
