// @run
// @log 3
// @log 4
// @log 3
// @log 3
// @log 4
// A `const` bound to a call its frame types open, through a lifted lambda over a captured hole
// function, holds the width the call is built at; a copy and arithmetic read it there too.
function add(a, b) { return a + b }
function app(g, s) { return g(s, s) }
function p5(h) {
  const run = (x) => app(h, x)
  const v = run(1.5)
  print(v)
  print(v + 1.0)
  const w = v
  print(w)
}
p5(add)
function p6(h) {
  const run = (x) => app(h, x)
  const v: f64 = run(1.5)
  print(v)
}
p6(add)
function p7(h) {
  const run = (x) => app(h, x)
  const n = run(2)
  print(n)
}
p7(add)
