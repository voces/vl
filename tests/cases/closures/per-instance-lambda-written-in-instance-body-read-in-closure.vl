// @run
// @log 1
// @log true
// @log I
// @log 1
// @log L
// @log 1
// @log L
// @log 1
// @log I
// @log s
// @log L
// @log s
// @log L
// @log s
// A hole lambda written to a `let` in a generic body, where the binding is written only in that
// body and every read is a call, is each instance's own member: its id is made and dispatched in
// that instance (per-instance-identity-2026-11.md, M3; D15102).
function inner<U>(u: U) { print("I"); print(u) }
function a<T>(x: T) {
  let k = inner
  const rd = () => {
    k(x)
  }
  k = (u) => {
    print(u)
  }
  rd()
}
a(1)
a(true)
function b<T>(x: T) {
  let k = inner
  k(x)
  const rd = () => {
    k(x)
  }
  k = (u) => {
    print("L"); print(u)
  }
  k(x)
  rd()
}
b(1)
b("s")
