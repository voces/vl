// @run
// @log 2
// @log 3
// @log 4
// @log 5
// A value `if` of record literals holding un-annotated functions, assigned to a binding first
// bound to such a choice, in a function and at module scope: the assignment is a statement whose
// value nothing reads, and the binding's storage takes the choice as it is (D15301).
function id1(a) { return a }
function id2(a) { return a }
const c = 1 > 0
function run() {
  let v = if c { { f: id1 } } else { { f: id1 } }
  v = if c { { f: id1 } } else { { f: id1 } }
  print(v.f(2))
  let w = if c { { f: id1 } } else { { f: id2 } }
  w = if c { { f: id1 } } else { { f: id2 } }
  print(w.f(3))
}
run()
let g = if c { { f: id1 } } else { { f: id1 } }
g = if c { { f: id1 } } else { { f: id1 } }
print(g.f(4))
let h = if c { { f: id1 } } else { { f: id2 } }
h = if c { { f: id1 } } else { { f: id2 } }
print(h.f(5))
