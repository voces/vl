// @error cannot assign (i32) => void to `k`: it keeps the generic type of its initializer
// A parameter typed `(n: i32) => void` written into a cell the instance wants at boolean (review of #3498, `rv3498/d08_param_concrete_into_cell_bool`).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function third<Z>(z: Z) { print("T"); print(z) }
function a<T>(x: T, f: (n: i32) => void) {
  let k = inner
  const w = () => {
    k = f
  }
  w()
  k(x)
}
a(1, other)
a(true, other)
