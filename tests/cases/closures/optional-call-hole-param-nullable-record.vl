// @run
// @log 0
// @log 0
// @log 3
// @log 7
// @log 9
// @log 3
// A `?.` call on an un-annotated parameter handed a nullable record: the call is owed only on
// the present receiver, and an absent one takes the fallback (D16339).
function inc(x: i32) { return x + 1 }
function take(a) { print(a?.f(2) ?? 0) }
const n: { f: (x: i32) => i32 } | null = null
take(n)
function takeTyped(a: { f: (x: i32) => i32 } | null) { print(a?.f(2) ?? 0) }
takeTyped(n)
const m: { f: (x: i32) => i32 } | null = { f: inc }
take(m)
function bound(a) { const r = a?.f(2); print(r ?? 7) }
const s: { f: (x: i32) => string } | null = null
bound(s)
function ret(a: { f: (x: i32) => i32 } | null) { return a?.f(2) }
print(ret(null) ?? 9)
print(ret(m) ?? 9)
