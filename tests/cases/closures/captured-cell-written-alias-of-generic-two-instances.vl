// @run
// @log I
// @log 7
// @log I
// @log true
// A capture cell runs with a writer storing a `const` alias of a generic, two instances of one representation, each value instanced at the cell's type
// (D3939, `rv3498/y12`).
function inner<U>(u: U) { print("I"); print(u) }
function a<T>(x: T) {
  let k = inner
  const al = inner
  const toI = () => {
    k = al
  }
  toI()
  k(x)
}
a(7)
a(true)
