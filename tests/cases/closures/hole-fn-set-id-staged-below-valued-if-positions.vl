// @run
// @log 3
// @log 30
// @log 3
// @log 30
// @log 30
// @log 3
// A hole function's set id staged below a valued `if` beside it, at each delivery position.
function add(a, b) { return a + b }
function a2(g) { print(g(1, 2)) }
function a3(g) { print(g(10, 20)) }
const k = 1 > 0
// a list literal, walked
const fs = [a2, if k { a3 } else { a2 }]
for f in fs { f(add) }
// a call's arguments
function both(p, q) {
  p(add)
  q(add)
}
both(a2, if k { a3 } else { a2 })
// inside a function body, indexed
function local() {
  const gs = [a3, if k { a2 } else { a3 }]
  gs[0](add)
  gs[1](add)
}
local()
