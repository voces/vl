// @run
// @log 11
// @log ab
// @log 3
// @log 7
// @log 42
// @log 5
// @hint redundant type annotation: `frame1` is inferred as `i32`
// @hint redundant type annotation: `frame2` is inferred as `string`
// @hint redundant type annotation: `frame3` is inferred as `i32`
// @hint redundant type annotation: `frame4` is inferred as `i32`
// @hint redundant type annotation: `frame5` is inferred as `i32`
// @hint redundant type annotation: `p` is inferred as `{x: i32, y: i32}`
// @hint redundant type annotation: `frame6` is inferred as `i32`
// A LADDER OF FRAMES, each declaring its own nested function that captures its own local —
// and each capturing a DIFFERENT kind. This is the population the emitter's per-function
// classifiers are asked about one frame at a time: `capturedKindOf`,
// `capturedStructIndex` and `retCapturedMapShape` all resolve a capture against the
// `fnStmts` position of the frame currently being lowered, so a ladder where consecutive
// frames disagree about the capture's kind is what separates "resolved against THIS frame"
// from "resolved against whichever frame answered last".
//
// The nested functions have DISTINCT names on purpose: capture analysis is name-keyed
// module-wide, so two same-named nested functions in different outer frames report
// `captured variable not found in enclosing frame` and would mask what this pins.

// frame 1 — captures an i32.
function frame1(): i32 {
  const base = 4
  const addBase = (n: i32) => base + n
  return addBase(7)
}

// frame 2 — captures a string.
function frame2(): string {
  const head = "a"
  const withHead = (t: string) => head + t
  return withHead("b")
}

// frame 3 — captures an i32 LIST.
function frame3(): i32 {
  const xs = [10, 20, 30]
  const count = () => xs.length
  return count()
}

// frame 4 — captures a MAP and reads through it.
function frame4(): i32 {
  const m: {[string]: i32} = Map()
  m["k"] = 7
  const readK = () => m["k"] ?? 0
  return readK()
}

// frame 5 — RETURNS the captured map itself, so the closure's result type is the captured
// map's shape rather than the frame's own. (`retCapturedMapShape`'s witness: without it the
// result infers as i32 over a map-ref body and the return fails validation.)
function frame5(): i32 {
  const h: {[string]: i32} = Map()
  h["v"] = 42
  const giveH = () => h
  const got = giveH()
  return got["v"] ?? 0
}

// frame 6 — captures a struct and reads a field, one frame after a map frame.
type Pt = { x: i32, y: i32 }
function frame6(): i32 {
  const p: Pt = { x: 5, y: 6 }
  const takeX = () => p.x
  return takeX()
}

print(frame1())
print(frame2())
print(frame3())
print(frame4())
print(frame5())
print(frame6())
