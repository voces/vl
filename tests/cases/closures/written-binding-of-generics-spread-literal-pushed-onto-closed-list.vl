// @run
// @log 1
// @log s
// @log 40
// @log 2
// @log t
// @log 42
// @log 3
// @log 3.5
// @log 7
// @log 3
// A spread list literal holding a written binding of generics, pushed onto a list of a closed
// function type, delivers each element through its adapter as a direct push does (D15067).
function id<T>(x: T): T { return x }
function loud<T>(x: T): T {
  print("loud")
  return x
}
function one() {
  let f = id
  print(f(1))
  print(f("s"))
  const ys: ((x: i32) => i32)[] = []
  ys.push(...[f])
  f = loud
  print(ys[0](40))
}
one()
function two() {
  let f = id
  print(f(2))
  print(f("t"))
  const ys: ((x: i32) => i32)[] = []
  ys.push(...[f, id])
  f = loud
  print(ys[0](41) + ys[1](1))
}
two()
function add<T>(a: T, b: T): T { return a + b }
function mul<T>(a: T, b: T): T { return a * b }
function three() {
  let g = add
  print(g(1, 2))
  print(g(1.5, 2.0))
  const ys: ((a: i32, b: i32) => i32)[] = []
  ys.push(...[g])
  g = mul
  print(ys[0](3, 4))
}
three()
const xs = [1]
xs.push(...[2, 3])
print(xs.length)
