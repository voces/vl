// @run
// @log 6
// @log 4
// @log 4
// @log 4
// @log 6
// @log 4
// A list of lists of functions reassigned from a literal or a call of another set holds both
// sets, as a global and as a local.
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
let a = [[dbl]]
a = [[dbl]]
print(a[0][0](3))
let b = [[dbl]]
b = [[inc0]]
print(b[0][0](3))
function local() {
  let c = [[dbl]]
  c = [[inc0]]
  print(c[0][0](3))
}
local()
function pick(t) {
  if t { return [[inc0]] }
  return [[dbl]]
}
let d = [[dbl]]
d = pick(true)
print(d[0][0](3))
d = pick(false)
print(d[0][0](3))
function mk() { return [[inc0]] }
let e = [[dbl]]
e = mk()
const f = e
print(f[0][0](3))
