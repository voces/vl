// @run
// @log 3
// @log 4
// @log 4
// @log 3
// @log 5
// @log 6
// Two `const`s bound to calls of one lifted lambda at two widths in one frame each hold their own
// call's width: the i32 call is built at the lambda's i32 clone, the f64 one at its f64 slot.
function add(a, b) { return a + b }
function app(g, s) { return g(s, s) }
function p5(h) {
  const run = (x) => app(h, x)
  const v = run(1.5)
  print(v)
  const u = run(2)
  print(u)
}
p5(add)
function p6(h) {
  const run = (x) => app(h, x)
  const v = run(1.5)
  const u = run(2)
  const w = u
  const z = v
  print(w)
  print(z)
  print(u + 1)
  print(v * 2.0)
}
p6(add)
