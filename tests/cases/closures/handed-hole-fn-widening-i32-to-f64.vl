// @run
// @log 1.5
// @log 1.75
// @log 0.75
// @log 2.5
// A handed un-annotated function whose result widens its `i32` argument: `h(3)` is `f64`, as
// the direct call `half(3)` is, whether the function is declared, a const lambda or inline (D8100).
function half(a) { return a / 2.0 }
const quarter = (a) => a / 4.0
function p(h) { print(h(3)) }
function q(h) { print(h(3.5)) }
p(half)
q(half)
p(quarter)
p((a) => (a + 2) * 0.5)
