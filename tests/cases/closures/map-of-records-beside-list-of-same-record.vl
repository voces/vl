// @log 4
// A map of records holding a list of functions, written only directly, beside a list of records
// of the same type: the map's literal is built at the row the list's records share (D15532).
function inc0(a) { return a + 1 }
function inc1(a) { return a + 1 }
const a = [{ xs: [inc0] }]
const v = a[0]
print(v.xs[0](3))
const m = Map()
m["k"] = { xs: [inc1] }
const mv = m["k"]
if mv != null { print(mv.xs[0](3)) }
