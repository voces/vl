// @run
// @info `b` is never reassigned; use `const` instead of `let`
// @info `b` is never reassigned; use `const` instead of `let`
// @log v
// @log 3
// @log w
// @log 4
// An un-annotated `let` copy of a hole parameter that nothing re-points is the parameter, as a
// `const` copy is, when a `const` record or list literal holds it (D15404).
function same<T>(k: T): T { k }
function viaRecord(a) {
  let b = a
  const r = { f: b }
  print(r.f("v"))
  print(a(3))
}
viaRecord(same)
function viaList(a) {
  let b = a
  const r = [b]
  print(r[0]("w"))
  print(a(4))
}
viaList(same)
