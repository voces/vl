// @run
// @log null
// @log null
// @log null
// @log true
// @log true
// @log 1
// @warning Unused variable `dA` (prefix with `_` to suppress, or remove it)
// A `filter` callback instanced at the row `J` its list's build is stored at captures its
// parameter, whose reads are typed `{ f: null }`, in nested closures at each delivery position:
// a field read, a record field, a list element, a nested declaration, two deep. A closure that
// returns the parameter whole beside the record is D17660's.
type J = { f: i32 | null }
function mk2() { return { f: null } }
const dA: J = mk2()
const src = [mk2()]
const r = src.filter((y) => {
  const a = () => print(y.f)
  a()
  const c = () => {
    const h = { w: y }
    print(h.w.f)
  }
  c()
  const d = () => print([y][0].f)
  d()
  function k() { return y.f == null }
  print(k())
  const n = () => {
    const m = () => y.f == null
    return m()
  }
  print(n())
  return true
})
print(r.length)
