// @run
// @log 4
// @log -1
// @log 3
// @log none
// @log 5
// @log true
// @log 1
// @log 5
// @log -1
// @log 0.5
// @log none
// @log 2
// @log none
// @log 1
// @log 5
// @log 2.5
// @log 5
// @log -5
// @log 2
// @log s
// @log 2
// @log -1
// @log false
// A function value whose parameter or result is a nullable map, `null` or `boolean | null`
// carries that type in its signature, reached by a name, an index, a record field, a returned
// function and an argument; a nullable-list result of such a call compares with `null`
// (D9780, D9822, D9823, D9824, D9880). The bare-map and `string | null` lines are controls; the
// last three deliver a declared function at a wider nullable-map type and pin an un-annotated
// parameter at a `boolean | null` result (D2718, D2828, D3173, D4672).
function mkm(): {[string]: i32} {
  const m: {[string]: i32} = Map()
  m["a"] = 3
  m
}
function pm(p: {[string]: i32} | null) {
  if p == null { return -1 }
  p.length + (p["a"] ?? 0)
}
function rm(b: boolean): {[string]: i32} | null {
  if b { return mkm() }
  null
}
function rim(b: boolean): {[i32]: f64} | null {
  if b {
    const m: {[i32]: f64} = Map()
    m[4] = 0.5
    return m
  }
  null
}
function pn(p: null) {
  if p == null { return 5 }
  6
}
function rn(x: i32): null {
  if x > 99 { print(x) }
  return null
}
function pb(p: boolean | null) {
  if p == null { return 5 }
  if p { return 1 }
  0
}
function rl(x: i32): f64[] | null {
  if x > 0 { return [1.5, 2.5] }
  null
}
function rs(x: i32): string | null {
  if x > 0 { return "s" }
  null
}
function bare(x: i32): {[string]: i32} {
  const m = mkm()
  m["b"] = x
  m
}

// By a name.
const fpm = pm
print(fpm(mkm()))
print(fpm(null))
const frm = rm
const m1 = frm(true)
if m1 != null { print(m1["a"] ?? 0) }
if frm(false) == null { print("none") }
const fpn = pn
print(fpn(null))
const frn = rn
print(frn(1) == null)
const fpb = pb
print(fpb(true))
print(fpb(null))

// By an index.
const pms = [pm]
print(pms[0](null))
const rims = [rim]
const im = rims[0](true)
if im != null { print(im[4] ?? 9.0) }
if rims[0](false) == null { print("none") }
const rls: ((x: i32) => f64[] | null)[] = [rl]
const l1 = rls[0](1)
if l1 != null { print(l1.length) }
if rls[0](0) == null { print("none") }

// By a record field.
type Box = {
  f: (b: boolean) => {[string]: i32} | null,
  g: (p: boolean | null) => i32,
}
const bx: Box = { f: rm, g: pb }
const m2 = bx.f(true)
if m2 != null { print(m2.length) }
print(bx.g(null))

// By a returned function.
function getRl(): (x: i32) => f64[] | null { return rl }
const l2 = getRl()(1)
if l2 != null { print(l2[1]) }
function getPn(): (p: null) => i32 { return pn }
print(getPn()(null))

// By an argument.
function run(f: (p: {[string]: i32} | null) => i32, g: (p: null) => i32) {
  f(null) * 10 + g(null)
}
print(run(pm, pn))

// Controls: a bare map result and a `string | null` result.
const fb = [bare]
print(fb[0](1).length)
const frs = [rs]
const s1 = frs[0](1)
if s1 != null { print(s1) }

// A declared function delivered at a wider nullable-map result or parameter type.
const wide: (x: i32) => {[string]: i32} | null = bare
const m3 = wide(4)
if m3 != null { print(m3.length) }
const wideP: (p: {[string]: i32} | null) => i32 = pm
print(wideP(null))

// A `boolean | null` result pins an un-annotated parameter.
function callIt(h) { return h() }
print(callIt((): boolean | null => false))
