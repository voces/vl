// @run
// @log I
// @log s
// @log I
// @log 7
// A hole function reached only through another function's parameter that is only ever called:
// each call through that parameter hands the function what the caller was handed, so the binding
// its parameter is written to holds that set's id (D15017).
function id<T>(x: T): T {
  print("I")
  x
}
function take(a) {
  let b = id
  b = a
  print(b("s"))
  print(b(7))
}
function via(f, g) { f(g) }
via(take, id)
