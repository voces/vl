// @run
// @log 4
// @log 2.25
// @log 4
// @log 2.25
// @log 6
// @log 2.5
// A list of an un-annotated function returned from an un-annotated function, read through an
// index call at two types, one read in a hole parameter's body: the list holds the function's id,
// and each call reaches its own instance (D14823).
function inc0(a) { return a + 1 }
function deliver0() { return [inc0] }
function take0(a) { print(a[0](3)) }
take0(deliver0())
print(deliver0()[0](1.25))

function inc1(a) { return a + 1 }
function deliver1() { return [inc1] }
function take1(a) { print(a[0](3)) }
take1(deliver1())
print(deliver1().map((f) => f(1.25))[0])

function inc2(a) { return a + 1 }
function dbl2(a) { return a * 2 }
function deliver2() { return [inc2, dbl2] }
function take2(a) { print(a[1](3)) }
take2(deliver2())
const u2 = deliver2()
print(u2[1](1.25))
