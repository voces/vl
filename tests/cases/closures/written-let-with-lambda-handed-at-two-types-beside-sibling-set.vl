// @run
// @log 20
// @log 9
// @log 4.5
// A `let` written with a lambda, handed from module scope to a hole helper at two types, beside
// a sibling binding that calls a set of the same function directly.
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function w(h, x) { return h(x) }
let f = inc0
f = dbl
print(f(10))
let fx = inc0
if [1].length > 0 { fx = (a) => a * 3 }
print(w(fx, 3))
print(w(fx, 1.5))
