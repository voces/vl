// @run
// @log 6
// @hint Intentionally-unused variable `_a` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_b` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_u` (leading `_` marks it unused)
// D17736's member as a `const` hole lambda used once at `f64`: it does not fill the maker's
// `(i32)` signature with the lambda's result either, so the family takes ids.
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
const tw = (x) => x * 2.0
const _u = tw(1.5)
const n = Map()
n["a"] = lap((a) => a + 1)
n["b"] = tw
const t = n["b"]
if t != null { print(t(3)) }
