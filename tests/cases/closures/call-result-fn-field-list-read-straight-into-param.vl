// @run
// @log 5.5
// @log 5.5
// @log 5.5
// @log 5.5
// A list of records of un-annotated functions of different results, read straight off a call, off
// a binding of the call or as the call's whole result, handed to un-annotated parameters that call
// each element's field by index and by `for`: each call dispatches per member (D16278).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function mk() { return { a: [{ f: inc0 }, { f: half }] } }
function mk2() { return [{ f: inc0 }, { f: half }] }
function take(v) {
  let acc = 0.0
  let i = 0
  while i < v.length {
    acc = acc + v[i].f(3)
    i = i + 1
  }
  print(acc)
}
function takeF(v) {
  let acc = 0.0
  for e in v { acc = acc + e.f(3) }
  print(acc)
}
take(mk().a)
takeF(mk().a)
take(mk2())
const r = mk()
take(r.a)
