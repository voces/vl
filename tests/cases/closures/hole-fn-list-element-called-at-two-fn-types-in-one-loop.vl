// @run
// @warning Unused parameter
// @log x2
// @log 2
// @log y20
// @log 20
// The D10791 witness: one loop variable called at two function types; the second call reads a
// copy of the list holding the elements at its own type, at the loop's index.
import { toString } from "std:fmt"

function cat(a, b) { return a + b.toString() }
function snd(a, b) { return b }
function apply2(g) { print(g("x", 2)) }
function apply3(g) { print(g("y", 20)) }
const fs = [apply2, apply3]
for f in fs {
  f(cat)
  f(snd)
}
