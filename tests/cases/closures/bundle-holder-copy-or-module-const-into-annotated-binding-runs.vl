// @run
// @log 5
// @log 8
// @log 4
// @log 5
// @log 4
// @log 5
// @log 8
// @log 4
// An annotated binding of a bundle holder's copy, or of a module-scope `const` holder read in a
// named function, takes the member its type names (D15862, D15863), at each of two members.
function lap(f) {
  f(2.5)
  f(3)
  return f
}
function local() {
  const k = lap((a) => a + 1)
  const v = k
  const m: (f64) => f64 = v
  const n: (i32) => i32 = v
  print(m(4))
  print(n(7))
  print(v(3))
}
local()
function deep() {
  const k = lap((a) => a + 1)
  const v = k
  const w = v
  const m: (f64) => f64 = w
  print(m(4))
  print(k(3))
}
deep()
const c = lap((a) => a + 1)
function one() {
  const m: (f64) => f64 = c
  print(m(4))
}
function two() {
  const n: (i32) => i32 = c
  print(n(7))
}
one()
two()
print(c(3))
