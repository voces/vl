// @run
// @log 4
// @log 3
// @log 3.5
// @log 4
// @log 1.25
// An `if` joining records whose function field holds un-annotated functions, handed inline to an
// un-annotated parameter: functions that return one type at the call run, the call's types read
// at the call site where the parameter's own type leaves them open (D15807).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function dbl(a) { return a * 2 }
function id1(a) { return a }
function id2(a) { return a }
function two() { [1, 2].length }
function take2(n, r) { return r.f(n) }
print(take2(3, if two() > 5 { { f: dbl } } else { { f: inc0 } }))
print(take2(3, if two() > 5 { { f: id1 } } else { { f: id2 } }))
print(take2(2.5, if two() > 5 { { f: half } } else { { f: inc0 } }))
print(take2(3, if two() > 5 { { f: inc0 } } else { { f: inc0 } }))
print(take2(2.5, if two() > 5 { { f: half } } else { { f: half } }))
