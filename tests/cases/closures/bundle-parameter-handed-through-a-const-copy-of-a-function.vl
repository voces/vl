// @run
// @log 3.5
// @log 8
// @log 3.5
// @log 8
// @log 3.5
// @log 5
// @log 6
// @log 3.5
// @log 8
// @log 3.5
// @log 8
// A parameter called at two signatures and handed whole through a `const` copy of a named
// function, local or module-level, from the function's body or a closure: the copy's call hands
// the record on, or the member at its type to a callee that copies its parameter.
function keep(g) { print(g(7)) }
function keepCopy(g) {
  const q = g
  print(q(7))
}
function keepAt(g, n: i32) { print(g(n)) }
function keepTop(g) { print(g(7)) }
function keepCap(g) { print(g(7)) }
const top = keepTop
function lap(f) {
  print(f(2.5))
  const kk = keep
  kk(f)
}
function lapCopy(f) {
  print(f(2.5))
  const kk = keepCopy
  kk(f)
}
function lapTwice(f) {
  print(f(2.5))
  const kk = keepAt
  kk(f, 4)
  kk(f, 5)
}
function lapTop(f) {
  print(f(2.5))
  top(f)
}
function lapCap(f) {
  print(f(2.5))
  const kk = keepCap
  const h = () => kk(f)
  h()
}
function go(k: i32) {
  lap((a) => a + k)
  lapCopy((a) => a + k)
  lapTwice((a) => a + k)
  lapTop((a) => a + k)
  lapCap((a) => a + k)
}
go(1)
