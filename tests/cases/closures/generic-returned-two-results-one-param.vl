// @run
// @log x!y
// @log x!y
// @log x!y
// @log x!y
// @log x!y
// @log 5
// @log x!y
// D9380: one un-annotated function returning a generic, delivered at two results over the same
// literal-union parameter, gets a copy per result at every delivery position.
type K = "x" | "y"
function same<T>(k: T): T { k }
function deliver() { return same }
const v: (k: K) => string = deliver()
const w: (k: K) => K = deliver()
const z = w("y")
print(v("x") + "!" + v(z))
function d1() { return same }
function useS(f: (k: K) => string) { f("x") }
function useK(f: (k: K) => K): K { f("y") }
print(useS(d1()) + "!" + useK(d1()))
function d2() { return same }
function r2(): (k: K) => string { return d2() }
const w2: (k: K) => K = d2()
print(r2()("x") + "!" + w2("y"))
function d3() { return same }
type Box = { f: (k: K) => string, g: (k: K) => K }
const b3: Box = { f: d3(), g: d3() }
print(b3.f("x") + "!" + b3.g("y"))
function d4() { return same }
let v4: (k: K) => string = same
v4 = d4()
const w4: (k: K) => K = d4()
print(v4("x") + "!" + w4("y"))
function d5() { return same }
const v5: (k: i32) => i32 = d5()
const w5: (k: K) => string = d5()
const u5: (k: K) => K = d5()
print(v5(5))
print(w5("x") + "!" + u5("y"))
