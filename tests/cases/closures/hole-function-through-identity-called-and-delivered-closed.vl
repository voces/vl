// @run
// @log 5
// @log 5
// @log 5
// @log 5
// @log 5
// A `const` holding a hole function a generic identity hands back, called directly and also
// delivered to a closed function type, is called through its set at the delivery's adapter.
function inc(a) { return a + 1 }
function id<T>(t: T): T { return t }
const g = id(inc)
print(g(4))
const k: (a: i32) => i32 = g
print(k(4))
function use(u: (a: i32) => i32) { print(u(4)) }
use(g)
const w: (a: i32) => i32 | string = g
print(w(4))
print(g(4))
