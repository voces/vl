// @run
// @log 4
// @log 6
// @log 4
// @log 6
// @log 6
// @hint Intentionally-unused parameter `_n` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// A `let` list of lists of un-annotated functions, re-pointed whole, returned, and called through
// by an un-annotated callee or in a generic's instances, runs at the one type its functions take
// (D14782).
function inc(a) { return a + 1 }
function dbl(a) { return a * 2 }
function deliverNested(_n) {
  let u = [[inc, dbl]]
  u = [[dbl, inc]]
  return u
}
function take2(a) { print(a[0][1](3)) }
take2(deliverNested(1))
const r = deliverNested(2)
print(r[0][0](3))
print(r[0][1](3))
function g<T>(_x: T) {
  let u = [[inc]]
  u = [[dbl]]
  print(u[0][0](3))
}
g(1)
g("s")
