// @error cannot assign (i32) => void to `k`: it keeps the generic type of its initializer
// An annotated `(n: i32) => void` written into a cell the instance wants at string (review of #3498, `rv3498/z21_concrete_const_i32_str`).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function a<T>(x: T) {
  let k = inner
  const f: (n: i32) => void = other
  const w = () => {
    k = f
  }
  w()
  k(x)
}
a(1)
a("s")
