// @run
// @hint redundant type annotation: `inc` is inferred as `i32`
// @log 2
// @log s
// @log 5
// @log q
// @log 2
// @log s
// @log 6
// @log 3
// @log 1
// @log 3
// @log 2
// @log a
// @log b
// @log 3
// @log x!!
// A whole `slice(0)` copy of a list holding a generic is a list of its own, as the spread copy
// `[...xs]` is (D10190, D10191): the copy is called at two types, written by index with a
// fixed-type function that the source never sees, and copied inside a generic.
function id<T>(x: T): T { x }
function inc(x: i32): i32 { x + 1 }

const xs = [id]
const ys = xs.slice(0)
print(xs[0](2))
print(xs[0]("s"))
print(ys[0](5))
print(ys[0]("q"))

const as = [id]
const bs = as.slice(0)
bs[0] = inc
print(as[0](2))
print(as[0]("s"))
print(bs[0](5))
print(as[0](3))
print(bs.length)

function run<T>(v: T, w: T): T {
  const ps = [id]
  const qs = ps.slice(0)
  print(ps[0](v))
  qs[0](w)
}
print(run(3, 2))
print(run("a", "b"))

function twice<T>(f: (x: T) => T, a: T): T {
  const fs = [f]
  const gs = fs.slice(0)
  gs[0](fs[0](a))
}
print(twice(id, 3))
print(twice((s: string) => s + "!", "x"))
