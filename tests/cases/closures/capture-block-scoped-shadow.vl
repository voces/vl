// @run
// @log inner
// @log 6
// @log 2.5
// @log 5
// @log 7
// @log out!
// @log 1.5
// @log 5
// @log 9
// @log 5
// @log u
// @log 6
// @log p
// @log 15
// @log 15
// @log x
// @log 6
// @log 2.5
// @log 6
// @log s
// @log 6
// @log 3
// @log 6
// @log inner
// @log 7
// @log inner
// @log t
// @log 1.5
// @log 15
// @log 15
// @log 102
// @log 2
// @log 9
// @hint redundant type annotation: `lv` is inferred as `(i32) => void`
// @hint redundant type annotation: `vs` is inferred as `((i32) => i32)[]`

// D2068 — a binding scoped to an inner block, loop or nested function shadows a name only
// there: once the scope closes, the enclosing binding is the one a closure reads, captures,
// types and assigns. Each case prints the shadow and then the outer value, so a closure that
// reads the wrong binding prints a wrong value rather than failing to build.

type Circle = { kind: "c", r: i32 }
type Square = { kind: "s", side: i32 }
type Shape = Circle | Square

// A bare block and an `if` arm, the shadow a different type from the capture.
function bareBlock() {
  const y = 5
  const g = () => {
    {
      const y = "in" + "ner"; print(y)
    }
    print(y + 1)
  }
  g()
  const h = () => {
    if y > 0 { const y = 2.5; print(y) }
    print(y)
  }
  h()
}
bareBlock()

// The far arm of an `else if` chain, over a string capture.
function elseIfArm(k: i32) {
  const y = "out"
  const g = () => {
    if k == 0 { print(0) }
    else if k == 1 { print(1) }
    else { const y = 7; print(y) }
    print(y + "!")
  }
  g()
}
elseIfArm(2)

// A loop variable, and a struct shadow inside a `match` arm.
function loopAndMatch(s: Shape) {
  const y = 5
  const g = () => {
    const zs = [1.5]
    for y in zs { print(y) }
    print(y)
    match s {
      Circle => {
        const y = { a: 9 }; print(y.a)
      }
      Square => {
        print(0)
      }
    }
    print(y)
  }
  g()
}
loopAndMatch({ kind: "c", r: 2 })

// A nested lambda's local and parameter, then an assignment to the maker's `let`.
function nestedLambda() {
  let y = 5
  const g = () => {
    const k = () => {
      const y: i32 | string = "u"; print(y)
    }
    k()
    print(y + 1)
    const m = (y: string) => {
      print(y)
    }
    m("p")
    y = y + 10
    print(y)
  }
  g()
  print(y)
}
nestedLambda()

// A module global the closure assigns after an inner block shadowed it.
let gy = 5
function globalAfterShadow() {
  const g = () => {
    {
      const gy = "x"; print(gy)
    }
    gy = gy + 1
  }
  g()
  print(gy)
}
globalAfterShadow()

// The maker's own inner block binds the name: before the captured binding, and around a
// closure while a second closure outside it reads the outer one.
function makerSide() {
  {
    const y = 2.5; print(y)
  }
  const y = 5
  const g = () => {
    print(y + 1)
  }
  g()
  if true {
    const y = "s"
    const h = () => {
      print(y)
    }
    h()
  }
  const j = () => {
    print(y + 1)
  }
  j()
}
makerSide()

// A capture spread into a list inside the closure.
function spreadCapture() {
  const xs = [1, 2]
  const y = 5
  const g = () => {
    {
      const y = [...xs, 3]; print(y.length)
    }
    print(y + 1)
  }
  g()
}
spreadCapture()

// A generic instance, the shadow's type fixed while the capture's varies.
function generic<T>(y: T) {
  const g = () => {
    {
      const y = "in" + "ner"; print(y)
    }
    print(y)
  }
  g()
}
generic(7)
generic("t")

// A module-scope block: the closure assigns the block's `let` after a shadow.
if true {
  let my = 5
  const g = () => {
    if true { const my = 1.5; print(my) }
    my = my + 10
    print(my)
  }
  g()
  print(my)
}

// A loop variable shadowing a module binding: a closure inside the loop reads the variable,
// one written after it reads the module binding (D2115).
function hundred(x: i32): void { print(x) }
function plus(x: i32) {
  print(x + 100)
  return x
}
const lv: (i32) => void = hundred
function loopShadowsModule(): void {
  const vs: ((i32) => i32)[] = [plus]
  for lv in vs {
    const h = (): void => {
      print(lv(2))
    }
    h()
  }
  const g = (): void => {
    lv(9)
  }
  g()
}
loopShadowsModule()
