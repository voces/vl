// @run
// @log 35
// @log h
// @log h
// @log 35
// A written `let` of two generics called with two lambdas of one type: the call through the
// binding bakes neither lambda, so both calls share the one instance the binding holds (D12219).
function g<T>(f: (x: T) => T, x: T): T { f(x) }
function h<T>(f: (x: T) => T, x: T): T {
  print("h")
  f(x)
}
function la(n: i32) {
  let v = g
  if n > 0 { v = h }
  print(v((x: i32) => x + 1, 2) * 10 + v((x: i32) => x, 5))
}
la(0)
la(1)
