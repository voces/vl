// @run
// @log 4
// @log 4
// @log 4
// Held lists of records of a tagged set's ids, one whose field is a list and one whose field is
// a list of lists, and a record bound first and then held, each build and read at their own rows.
function inc0(a) { return a + 1 }
const rss = [[{ fs: [inc0] }]]
print(rss[0][0].fs[0](3))
const lists = [[{ fs: [[inc0]] }]]
print(lists[0][0].fs[0][0](3))
const r = { fs: [inc0] }
const viaRecord = [[r]]
print(viaRecord[0][0].fs[0](3))
