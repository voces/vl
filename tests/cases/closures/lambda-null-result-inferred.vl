// A lambda whose un-annotated result is `null`, handed to an un-annotated parameter, left
// uncalled, and called through a binding (D9565, D9921).
function take(f) {
  const r = f()
  print(r)
}
take(() => null)
function orQ(f) {
  const r = f()
  print(r ?? "q")
}
orQ(() => null)
const _unused = (_x: i32) => null
const v = (_x: i32) => null
print(v(1) == null)
