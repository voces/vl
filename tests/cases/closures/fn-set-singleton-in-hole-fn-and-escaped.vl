// @run
// @log d!
// @log q!
// @log a!
// @log c?
// A one-member choice called inside an un-annotated function, the same choice handed to a
// declared function type, and a one-member choice beside a two-member one: each member call is
// a direct call, and the escaped value calls the member it holds.
function exclaim(s) { return s + "!" }
function shout(s) { return s + "?" }
const on = [1].length == 1
function wrap(t) {
  const x = if on { exclaim } else { exclaim }
  return x(t)
}
print(wrap("d"))
function run(f: (s: string) => string) { print(f("q")) }
const g = (if on { exclaim } else { exclaim })
run(g)
const a = if on { exclaim } else { exclaim }
print(a("a"))
function inFn() {
  const x = if !on { exclaim } else { shout }
  print(x("c"))
}
inFn()
