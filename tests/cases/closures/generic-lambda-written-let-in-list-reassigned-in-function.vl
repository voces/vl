// @run
// @log 4
// A local list of a generic-initialized, lambda-written module `let`, reassigned, is checked
// once per call it makes (D7184).
function __other<V>(v: V) { print(v) }
let __k = __other
__k = (n) => {
  print(n + 1)
}
function __la() {
  let v = [__k]
  v = [__k]
  v[0](3)
}
__la()
