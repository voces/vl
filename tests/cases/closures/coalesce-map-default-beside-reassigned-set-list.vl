// @run
// @log 4
// @log none
// @warning Container `b2` is written but never read (remove it)
// A `??` default beside an unrelated reassigned list of the same functions keeps the module's
// own decision for the map's lists, and the join still runs (the D17055 grading list).
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
let b2 = [inc0, dbl]
b2 = [dbl]
const m4 = Map()
m4["k"] = [inc0, dbl]
const mv4 = m4["absent"]
const got = mv4 ?? [inc0]
print(got.map((f) => f(3))[0])
if mv4 == null { print("none") }
