// @log 4
// A hole function in a list, called through an index and through a loop variable, takes a
// generic function argument once per type its body calls it at (D7140).
function add(a, b) { return a + b }
print(add(1, 2))
print(add(1.5, 2.5))
function apply2(g) {
  print(g(1, 2))
  print(g(1.5, 2.5))
}
const fs = [apply2]
fs[0](add)
for f in fs { f(add) }
