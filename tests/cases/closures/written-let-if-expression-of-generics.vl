// @run
// @log I
// @log 3
// @log I
// @log true
// @log O
// @log 1
// @log I
// @log 2
// @log O
// @log 5
// A `let` written with an `if` expression whose arms all name generic functions holds the chosen generic's instance at the type of the call or delivery through it (D4013, D3941).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function ci(f: (n: i32) => void, n: i32) { f(n) }
function main() {
  inner(3)
  const c = true
  let f = other
  f = if c { inner } else { other }
  f(true)
}
function run(b: boolean, n: i32) {
  let k = inner
  k = if b { other } else { inner }
  ci(k, n)
}
main()
run(true, 1)
run(false, 2)
run(true, 5)
