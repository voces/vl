// @run
// @info `lv` is never reassigned; use `const` instead of `let`
// @log s
// @log 4
// @log 4
// @log 4
// @log 4
// @log 4
// @log 4
// @log 4
// A hole lambda called at one type and returned by an un-annotated function into a destination
// of another function type is built at that type (D6522): an annotated binding, a `let`, a
// write, an argument, a returned call, a return through a further call, and a recursive one.
const h = (u) => {
  return u
}
print(h("s"))
function deliver() { return h }
function viaInner() { return deliver() }
function viaRec(k: i32) {
  if k > 0 { return viaRec(k - 1) }
  return h
}
function use(f: (n: i32) => i32) { return f(3) + 1 }
function outer(): (n: i32) => i32 { return deliver() }
const v: (n: i32) => i32 = deliver()
print(v(3) + 1)
let lv: (n: i32) => i32 = deliver()
print(lv(3) + 1)
let wv: (n: i32) => i32 = (n) => n
wv = deliver()
print(wv(3) + 1)
print(use(deliver()))
print(outer()(3) + 1)
const iv: (n: i32) => i32 = viaInner()
print(iv(3) + 1)
const rv: (n: i32) => i32 = viaRec(2)
print(rv(3) + 1)
