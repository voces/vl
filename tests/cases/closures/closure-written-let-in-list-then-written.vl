// @run
// @log I
// @log 3
// @log I
// @log true
// @warning Unused variable `flip` (prefix with `_` to suppress, or remove it)
// A `let` a closure writes, read into a list called at one type and called itself at another,
// splits per call type and runs (D7102).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function main() {
  let k = inner
  const flip = () => {
    k = other
  }
  const fs = [k]
  k = inner
  fs[0](3)
  k(true)
}
main()
