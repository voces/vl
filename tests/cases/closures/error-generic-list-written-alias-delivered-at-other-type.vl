// @error argument 1: expected ((string) => string)[], got ((i32) => i32)[]
// A list of a generic function pushed a fixed-type function refuses when an alias of it is
// delivered to a parameter whose element type the fixed function cannot take (D10201).
function id<T>(x: T): T { x }
function inc(x: i32): i32 { x + 1 }
const ys = [id]
ys.push(inc)
const zs = ys
function run(a: ((x: string) => string)[], u: string): string { a[1](u) }
print(run(zs, "s"))
