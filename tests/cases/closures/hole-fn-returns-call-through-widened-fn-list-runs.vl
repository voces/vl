// @run
// @log 1.5
// @log true
// @log 2
// An un-annotated function returning a call through an element of a widened list of functions of
// different results returns the join of what its members return, as the call does at module
// scope (D15364).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function big(a) { return a > 1 }
function run(xs) { return xs[1](3) }
const xs = [inc0]
xs.push(half)
print(run(xs))
const ys = [inc0]
ys.push(big)
print(run(ys))
const r = run(xs)
print(r + 0.5)
