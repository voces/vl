// @run
// @log dup
// @log 4
// @log x
// @log dup
// @log 4
// @log dup
// @log x
// A `let` seeded from one parameter and reassigned from another holds either function, so it
// keeps the written binding's own set: the negative control of D15120's unassigned copy.
function id<T>(x: T): T { x }
function dup<T>(x: T): T {
  print("dup")
  x
}
function one<F>(a: F, c: F, k: boolean) {
  let b = a
  if k { b = c }
  print(b(3) + 1)
  print(a("x"))
}
one(id, dup, true)
one(dup, id, false)
