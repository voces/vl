// @run
// @log L
// @log hi
// @log O
// @log 1
// The same list called at a string, beside the generic's i32 instance (D7103).
function other<V>(v: V) { print("O"); print(v) }
function main() {
  let k = other
  k = (n) => {
    print("L"); print(n)
  }
  const fs = [k]
  fs[0]("hi")
  other(1)
}
main()
