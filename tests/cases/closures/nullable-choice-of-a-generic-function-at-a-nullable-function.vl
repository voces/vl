// @run
// @log 3
// @log 3
// @log 3
// @log 3
// @log 3
// @log false
// @log some
// @log false
// @log 3
// @log 0
// @log false
// @log 3
// @log 0.5
// @log 3
// @log 3
// @log none
// A binding of `if c { id } else { null }` for a generic `id`, delivered at a closed nullable
// function type or a wider one, holds the nullable of `id`'s instance there, in every phase,
// at module scope and in an instanced frame (D17829).
function id<T>(x: T): T { return x }
function two() { return [1, 2].length }
type B = { f: ((x: i32) => i32) | null }
function useW(f: ((x: i32) => i32 | f64) | null) {
  if f != null { print(f(3)) } else { print("none") }
}
const h = if two() > 1 { id } else { null }
const z: ((x: i32) => i32) | null = h
if z != null { print(z(3)) }
const w: ((x: i32) => i32 | f64) | null = h
if w != null { print(w(3)) }
useW(h)
const b: B = { f: h }
const bf = b.f
if bf != null { print(bf(3)) }
const xs: (((x: i32) => i32) | null)[] = [h]
const x0 = xs[0]
if x0 != null { print(x0(3)) }
print(z is null)
print(
  match z {
    null => "none"
    _ => "some"
  },
)
function f<U>(u: U) {
  const hf = if two() > 1 { id } else { null }
  print(hf == null)
  const zf: ((x: i32) => i32) | null = hf
  if zf != null { print(zf(3)) }
  print(u)
}
f(0)
f(0.5)
function g<U>(u: U) {
  const hg = if two() > 1 { id } else { null }
  const bg: B = { f: hg }
  const gf = bg.f
  if gf != null { print(gf(3)) }
}
g(1)
g("s")
const hn = if two() > 5 { id } else { null }
const zn: ((x: i32) => i32) | null = hn
if zn != null { print(zn(3)) } else { print("none") }
