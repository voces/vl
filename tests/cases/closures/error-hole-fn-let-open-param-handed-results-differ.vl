// @error cannot write 'lenOf' to 'h': called at (string) it returns i32
// A re-pointed `let` of un-annotated functions whose results differ, handed beside a caller's
// un-annotated parameter to a callee that calls it there, is refused at the write (D13782).
function twice(s) { return s + s }
function lenOf(s) { return s.length }
function only(z, g) { return g(z) }
function bad(z) {
  let h = twice
  if z.length > 5 { h = lenOf }
  print(only(z, h))
}
bad("ab")
