// @log 6
// @log 6
// @log 6
// @log 4
// @log 2
// @log 2
// @log 10
// @log 18
// A record field holding a nested list of un-annotated functions holds their ids: read through
// the field, through a binding of it, from an inner list of fewer members, in loops, through a
// nested record, and written by slot.
function inc0(a) { return a + 1 }
function dbl0(a) { return a * 2 }
const r0 = { fs: [[inc0, dbl0]] }
print(r0.fs[0][1](3))

function inc1(a) { return a + 1 }
function dbl1(a) { return a * 2 }
const r1 = { fs: [[inc1, dbl1]] }
const a1 = r1.fs
print(a1[0][1](3))

function inc2(a) { return a + 1 }
function dbl2(a) { return a * 2 }
const r2 = { fs: [[inc2, dbl2], [inc2]] }
print(r2.fs[0][1](3))
print(r2.fs[1][0](3))

function inc3(a) { return a + 1 }
function dbl3(a) { return a * 2 }
const r3 = { n: 1, fs: [[inc3, dbl3]] }
for row in r3.fs {
  for f in row { print(f(r3.n)) }
}

function inc4(a) { return a + 1 }
function dbl4(a) { return a * 2 }
const o4 = { r: { fs: [[inc4, dbl4]] } }
print(o4.r.fs[0][1](5))

function inc5(a) { return a + 1 }
function dbl5(a) { return a * 2 }
const r5 = { fs: [[inc5, dbl5]] }
r5.fs[0][0] = dbl5
print(r5.fs[0][0](9))
