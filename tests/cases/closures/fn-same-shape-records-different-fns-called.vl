// @run
// @log 4
// @log a!
// @log 4
// @log a!
// @log a!
// @log 4
// Two records of one shape holding different un-annotated functions, called through the field:
// each call prints at the type the checker gave it, not at the first record's closure (D15114).
function inc0(a) { return a + 1 }
function ex(s) { return s + "!" }
const a = { f: inc0, n: 1 }
const b = { f: ex, n: 1 }
print(a.f(3))
print(b.f("a"))
const c = { f: inc0 }
const d = { f: ex }
print(c.f(3))
print(d.f("a"))
print({ f: ex, n: 2 }.f("a"))
print({ f: inc0, n: 2 }.f(3))
