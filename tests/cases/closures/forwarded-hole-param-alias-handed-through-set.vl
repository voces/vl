// @run
// @log 3
// @log 2
// @log 3
// A hole parameter copied into a binding read only as an argument of a call through a set of
// functions forwards it there as the parameter would.
function add(a, b) { return a + b }
function same(g, s) { print(g(s, s)) }
function twoCalls(g, s) {
  print(g(1, 2))
  print(g(s, 1.5))
}
function once(k, h) {
  for f in [twoCalls] { f(h, k) }
}
once(0.5, add)
function swap(k, h) {
  let hh = h
  for f in [same] { f(hh, k) }
}
swap(1.5, add)
