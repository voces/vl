// @run
// @log I
// @log 1
// @log I
// @log s
// A capture cell runs with a writer storing an alias, two instances of different representations, each value instanced at the cell's type
// (D3939, `rv3498/y10`).
function inner<U>(u: U) { print("I"); print(u) }
function a<T>(x: T) {
  let k = inner
  const al = inner
  const toI = () => {
    k = al
  }
  toI()
  k(x)
}
a(1)
a("s")
