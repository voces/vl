// @run
// @log 1
// @log s
// @log loud
// @log 3
// @log 40
// A written binding of two generics called at two types, delivered through a push (control) at a
// closed function type, is delivered through an adapter and keeps the value it held there.
function id<T>(x: T): T { return x }
function loud<T>(x: T): T {
  print("loud")
  return x
}
function main() {
  let f = id
  print(f(1))
  print(f("s"))
  const ys: ((x: i32) => i32)[] = []
  ys.push(f)
  f = loud
  print(f(3))
  print(ys[0](40))
}
main()
