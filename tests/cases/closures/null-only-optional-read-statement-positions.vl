// @run
// @log 1
// @log 2
// @info `?.f` here is always null: its receiver is only ever `null`
// @info `?.g` here is always null: its receiver is only ever `null`
// @info `?.h` here is always null: its receiver is only ever `null`
// @info `?.r` here is always null: its receiver is only ever `null`
// A `?.` read off a name only ever `null`, written as a statement, is the null its destination
// seeds, dropped, at each statement position.
const a = null
// at the top level
a?.f
// in an `if` arm and a loop body
if 1 > 0 { a?.g }
for i in 0 to 1 { a?.h }
// inside a function, off a local
function inFn() {
  const z = null
  z?.r
  print(1)
}
inFn()
print(2)
