// @run
// @log 2
// @log 2.5
// @log 2
// @log 2.5
// @log 2
// @log 2.5
// @log 2.5
// @log 2
// @log x
// @log 2
// @log 7
// @log 2.5
// @log 2
// @log 2.5
// A value `if` or `match` of record literals written into a binding whose function fields the
// writes widen, or into a field or element slot of one, widens the field by every arm's function
// and builds each arm at the place's record (D15335).
function id1(a) { return a }
function id2(a) { return a }
function id3(a) { return a }
const c = 1 > 0
const n = 3
let r = { f: id1 }
r = if c { { f: id2 } } else { { f: id3 } }
print(r.f(2))
print(r.f(2.5))
let m = { f: id1 }
m = match n {
  1 => { f: id2 }
  _ => { f: id3 }
}
print(m.f(2))
print(m.f(2.5))
const h = { r: { f: id1 } }
h.r = if c { { f: id2 } } else { { f: id3 } }
print(h.r.f(2))
print(h.r.f(2.5))
const xs = [{ f: id1 }]
xs[0] = if c { { f: id2 } } else { { f: id3 } }
print(xs[0].f(2.5))
let t = { g: { f: id1 } }
t = if c { { g: { f: id2 } } } else { { g: { f: id3 } } }
print(t.g.f(2))
print(t.g.f("x"))
let k = { f: id1, n: 1 }
k = if c { { f: id2, n: 2 } } else { { f: id3, n: 3 } }
print(k.n)
function g(x) { return x.f(7) }
print(g(k))
print(k.f(2.5))
let w = { f: id1 }
let i = 0
while i < 2 {
  w = if i == 0 { { f: id2 } } else { { f: id3 } }
  i = i + 1
}
print(w.f(2))
print(w.f(2.5))
