// @run
// @log <a>
// @log <b>
// A `continue` guard's narrowing of a module-scope loop variable reaches a lambda written in an
// interpolation hole, as it does one written as a statement (D3162).
type K = "a" | "b"
function sk(x: K) { return x }
const vs: (K | i32)[] = ["a", 3, "b"]
for e in vs {
  if e is i32 { continue }
  print("<\{(() => sk(e))()}>")
}
