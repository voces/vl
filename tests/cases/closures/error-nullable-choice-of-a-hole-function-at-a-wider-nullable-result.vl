// @emit-error emitProgram: cannot take the generic function `inc` as a value
// A binding of `if c { inc } else { null }` delivered at a nullable function of a wider result is
// refused, never built at the arm's own signature and called at the wider one (D17828).
function inc(a) { return a + 1 }
function two() { return [1, 2].length }
const h = if two() > 1 { inc } else { null }
const z: ((x: i32) => i32 | f64) | null = h
if z != null { print(z(3)) }
