// @run
// @log 1.542

// D2316 matrix — the shared name binds a CLOSURE in the first block and a plain (non-
// closure) value in the second, so the resolver's closure-shaped rungs must decline
// cleanly for the second block rather than answering through the first block's closure.

function f() {
  let out = ""
  {
    const g = () => 1.5
    out = "\{g()}"
  }
  {
    const g = 42
    out = out + "\{g}"
  }
  out
}
print(f())
