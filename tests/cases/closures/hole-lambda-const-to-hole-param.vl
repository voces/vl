// @run
// @log x
// @log y
// @log z
// A `const` hole lambda handed to an un-annotated parameter is instanced at the call the body
// makes (D6070). The typed lambda, and a delivery through a second forwarding hole.
function mid(a) { print(a("x")) }
const h = (k) => k
mid(h)

function midS(a) { print(a("y")) }
const hs = (k: string) => k
midS(hs)

function outer(b) { mid2(b) }
function mid2(a) { print(a("z")) }
const h2 = (k) => k
outer(h2)
