// D17127's forward spellings: a named argument, a local alias, mutual recursion through the
// forward, a generic, a list push and a bare return behind a forward.
function inc0(a) { return a + 1 }
function mk(f) { return { f: f } }
function byName(f) { return mk(f: f) }
function byAlias(f) {
  const g = f
  return mk(g)
}
function mk2(f, n: i32) {
  if n > 0 { return outer(f, n - 1) }
  return { f: f }
}
function outer(f, n: i32) { return mk2(f, n) }
function viaGen<T>(f: T) { return mk(f) }
function mkl(f) {
  const xs = [inc0]
  xs.push(f)
  return xs
}
function intoList(f) { return mkl(f) }
function id(f) { return f }
function bare(f) { return id(f) }
print(byName(inc0).f(3))
print(byAlias(inc0).f(3))
print(outer(inc0, 3).f(3))
print(viaGen(inc0).f(3))
print(intoList(inc0)[1](3))
print(bare(inc0)(3))
