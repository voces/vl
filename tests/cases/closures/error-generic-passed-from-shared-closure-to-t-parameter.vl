// @emit-error a generic function is passed to a function value whose parameter type names a type parameter this closure
// A generic passed from a closure every instance shares to another closure's T-typed parameter has no instance, with no cell involved (D3956).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function a<T>(x: T) {
  const w = (g: (t: T) => void) => {
    g(x)
  }
  const w2 = () => {
    w(other)
  }
  w2()
}
a(1)
a(true)
