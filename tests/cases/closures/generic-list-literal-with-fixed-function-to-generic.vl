// @run
// @log 3
// @log 3
// A list literal holding a generic function and a fixed-type function, passed straight to a
// generic function, binds its type parameter at the fixed function's type, whichever parameter
// the list is (D10204).
function id<T>(x: T): T { x }
function inc(x: i32) { x + 1 }
function run<U>(a: ((x: U) => U)[], u: U): U { a[1](u) }
function runLast<U>(u: U, a: ((x: U) => U)[]): U { a[1](u) }
print(run([id, inc], 2))
print(runLast(2, [id, inc]))
