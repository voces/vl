// @run
// @log 4
// @log 1.5
// An `if` joining records whose function field holds functions of different results, bound to a
// name first and then handed to an un-annotated parameter, runs whichever arm is taken (D15807).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function two() { [1, 2].length }
function take(r) { return r.f(3) }
const q = if two() > 5 { { f: half } } else { { f: inc0 } }
print(take(q))
const p = if two() > 1 { { f: half } } else { { f: inc0 } }
print(take(p))
