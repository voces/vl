// @error cannot assign (_) => _ to 'f' of type (a: i32) => f64
// An un-annotated function whose body gives `i32` does not fit a function type returning `f64`:
// a function value is not converted, as with the annotated `inc0(a: i32)` (D9011).
function inc0(a) { return a + 1 }
let f: (a: i32) => f64 = inc0
print(f(3))
