function opt(n: i32): i32 | null { return if n > 0 { n } else { null } }
function outer(c: boolean, k: i32) {
  function add(a: i32, b: i32) { return a * 10 + b + k }
  print(add(if c { 1 } else { 2 }, 3))
  print(add(4, if c { 5 } else { 6 }))
  print(add(opt(0) ?? 7, opt(8) ?? 0))
  print(add(1, add(2, opt(0) ?? 3)))
}
outer(true, 100)
outer(false, 0)
