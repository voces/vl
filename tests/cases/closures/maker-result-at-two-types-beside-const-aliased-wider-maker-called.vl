// @run
// @log z
// @log j
// @log 4
// @log j
// @log w
// @log v
// @log 5
// A generic a maker returns, called at two types, beside a wider maker a `const` aliases and the
// alias is called, at module scope and inside a function, each branch's result called (D15471).
function k<T>(x: T): T { return x }
function j<T>(x: T): T {
  print("j")
  return x
}
function mkLoop() { return k }
function mkPick(f: boolean) {
  if f { return k }
  return j
}
function main() {
  const l = mkLoop()
  print(l("v"))
  print(mkLoop()(5))
}
const q = mkPick
print(q(true)("z"))
print(q(false)(4))
function local() {
  const r = mkPick
  print(r(false)("w"))
}
local()
main()
