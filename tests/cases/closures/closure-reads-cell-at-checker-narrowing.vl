// @run
// @log 7
// @log 0
// @log d
// @log 0
// @log 0
// @log d
// @log 0
// A closure reads a list cell at the narrowing the checker gave it in the body: a narrowing a
// write made, or one a guard made around a closure that escapes, is not inherited, so a later
// write of `null` reads as the default rather than as the old member (D3419).
const g: (i32 | null)[] = [null]
g[0] = 7
const h = () => g[0] ?? 0
print(h())

const a: (i32 | null)[] = [null]
a[0] = 5
const f = () => a[0] ?? 0
a[0] = null
print(f())

const s: (string | null)[] = [null]
s[0] = "x"
const fs = () => s[0] ?? "d"
s[0] = null
print(fs())

function inFn() {
  const b: (i32 | null)[] = [null]
  b[0] = 5
  const fb = () => b[0] ?? 0
  b[0] = null
  print(fb())
}
inFn()

function escapes(xs: (i32 | null)[]): () => i32 {
  if xs[0] != null { return () => xs[0] ?? 0 }
  () => 1
}
const e: (i32 | null)[] = [4]
const ce = escapes(e)
e[0] = null
print(ce())

function escapesStr(xs: (string | null)[]): () => string {
  if xs[0] != null { return () => xs[0] ?? "d" }
  () => "o"
}
const es: (string | null)[] = ["x"]
const cs = escapesStr(es)
es[0] = null
print(cs())

const k0: (i32 | null)[] = [4]
let k = () => 0
if k0[0] != null { k = () => k0[0] ?? 0 }
k0[0] = null
print(k())
