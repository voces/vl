// @log 9
// A call of a function returning one of several generic functions, handed to an un-annotated
// parameter its callee calls at more than one type: the call runs once, where the argument is,
// and each type's parameter takes the generic it returned (D9596).
function id<T>(x: T): T { x }
function same<T>(x: T): T {
  print("same")
  x
}
function twice<T>(x: T): T { x + x }
let calls = 0
function deliver(n: i32) {
  calls = calls + 1
  print("deliver")
  if n > 5 { return id }
  if n > 1 { return twice }
  if n < 0 { return id }
  return same
}
function take(a) {
  print(a(21))
  print(a("a"))
}
function take3(k: i32, a) {
  print(a(k))
  print(a(1.5))
  a("z")
}
take(deliver(9))
take(deliver(3))
take(deliver(0))
print(calls)

// Bound by a `const`, after a parameter read, inside a function body.
function run(n: i32) {
  const r = take3(n, deliver(n))
  print(r)
  take3(7, deliver(n + 4))
}
run(2)
run(0)

// Once per loop iteration.
let i = 0
while i < 2 {
  take(deliver(i * 2))
  i = i + 1
}
print(calls)
