// @run
// @log -1
// @log 6
// @log -2
// @log 8
// @log -4
// @log 12
// @log 0
// @log 15
// A `?.` call on an un-annotated parameter handed a nullable record, at each delivery position.
function dbl(x: i32) { return x * 2 }
const none: { f: (x: i32) => i32 } | null = null
const some: { f: (x: i32) => i32 } | null = { f: dbl }
// printed through `??`
function p1(a) { print(a?.f(3) ?? -1) }
p1(none)
p1(some)
// bound to a const, then coalesced
function p2(a) {
  const r = a?.f(4)
  print(r ?? -2)
}
p2(none)
p2(some)
// as an argument to another call
function show(v: i32) { print(v) }
function p4(a) { show(a?.f(6) ?? -4) }
p4(none)
p4(some)
// tested with `!= null`
function p5(a) {
  const r = a?.f(7)
  if r != null { print(r + 1) } else { print(0) }
}
p5(none)
p5(some)
// Returned whole, the chain is D17662.
