// @run
// @hint redundant type annotation: `v` is inferred as `null` — remove it to lean on inference
// @log true
// @log true
// A `null` local storing an assignment of `null` to a list cell stores both (D17090).
let g: i32[] | null = [1]
function f() {
  let v: null = null
  v = (g = null)
  print(v == null)
  print(g == null)
}
f()
