// @run
// @log 4
// @log 6
// @log 1
// @log 2
// @log 32
// @log 7
// @log 2
// A `.map` / `.filter` whose callback is an expression that writes a statement (an `if` or a
// `match` choosing a function): over a parameter, a literal and a computed list, a callback
// holding its own `.map`, inside a lambda, and bound.
function inc(a: i32) { return a + 1 }
function dbl(a: i32) { return a + a }
function big(a: i32) { return a > 2 }
function small(a: i32) { return a < 2 }
function pick(xs: i32[], c: boolean) {
  return xs.map(if c { inc } else { dbl })[0]
}
function lit(c: i32) {
  return [3].map(
    match c {
      0 => inc
      _ => dbl
    },
  )[0]
}
function keep(xs: i32[], c: boolean) {
  return xs.filter(if c { big } else { small }).length
}
function nested(xs: i32[], c: boolean) {
  return [1].map(if c { (a: i32) => xs.map(inc)[0] + a } else { inc })[0]
}
function inLam(c: boolean) {
  const f = () => [3, 4].map(if c { dbl } else { inc })[1]
  return f()
}
print(pick([3], true))
print(lit(1))
print(keep([1, 3], false))
print(keep([1, 3, 2], true) + 1)
print(nested([30], true))
print(inLam(false) + 2)
const flag = pick([1], true) == 2
const bound = [1, 2].filter(if flag { small } else { big }).length + 1
print(bound)
