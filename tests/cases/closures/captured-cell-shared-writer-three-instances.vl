// @emit-error is written with a generic function inside a closure that every instance of the enclosing generic function shares
// A capture cell in a generic body is refused, not built at one instance's type, when three instances
// wants it at two function types (D3939, `rv3498/u02`).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function third<Z>(z: Z) { print("T"); print(z) }
function a<T>(x: T, w: i32) {
  let k = inner
  const toO = () => {
    k = other
  }
  const toT = () => {
    k = third
  }
  if w == 1 { toO() }
  if w == 2 { toT() }
  k(x)
}
a(1, 1)
a("s", 2)
a(1.5, 0)
