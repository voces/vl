// @run
// @log 0
// @log 1
// @log 2
// @log 3
// @log 4
// @log 5
// @log 6
// @log 7
// @log a?
// @log 8
// @hint Intentionally-unused variable
// A hole function's name ending a branch of an `if` flows wherever the `if` does: bound and never
// read (D6981), ending a function nothing reads the result of, else-less or not (D6982), or ending
// a `void` function, it is no use, through `else if`, nested `if`s, `match` arms and literals.
// A function also called by name keeps its body.
function exclaim(s) { return s + "!" }
function shout(s) { return s + "?" }
const on = [1].length == 1

const _a = if on { exclaim } else { exclaim }
let _b = if !on { exclaim } else if on { exclaim } else { exclaim }
const _c = if on {
  print(0)
  if !on { exclaim } else { exclaim }
} else {
  exclaim
}
const _d = match [2, 2].length {
  1 => exclaim
  _ => {
    print(1)
    exclaim
  }
}
const e = if on { [exclaim] } else { [exclaim, exclaim] }
print(e.length + 1)
const _f = if on { { k: exclaim } } else { { k: exclaim } }
const _g = if on { exclaim } else { shout }

function tailIf() {
  if on {
    print(3)
    exclaim
  }
}
function tailIfElse() {
  if on { exclaim } else { exclaim }
}
function returnsIf() { return if on { exclaim } else { exclaim } }
function voidTail(): void {
  print(6)
  exclaim
}
function voidTailIf(): void {
  if on {
    print(7)
    exclaim
  }
}
function local() {
  const _x = if on { exclaim } else { exclaim }
  print(5)
}

tailIf()
tailIfElse()
print(4)
returnsIf()
local()
voidTail()
voidTailIf()
print(shout("a"))
print(8)
