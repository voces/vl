// @run
// @log 2
// @log 4
// @log 6
// @log 8
// A module binding copying an element of an un-annotated list that holds a `let` written with two
// generics is called as a statement at the element's void signature, with nothing to drop (D7485).
function gA<U>(u: U) { print(u) }
function gB<V>(v: V) { print(v) }
let x = gA
x = gB
const xs = [x]
const v = xs[0]
v(2)
if true { v(4) }
function inner() {
  const w = xs[0]
  w(6)
}
inner()
for f in xs { f(8) }
