// @run
// @log 11
// @log 7
// @log 30
// @log 5
// @log 50
// @warning `c` shadows the `c` declared at
// A capture's name declared again in a nested function, or in a sibling block, is another
// binding: the lambda capturing the block's own is lifted and reads that one. A parameter the
// block shadows keeps the closure path and reads the block's binding all the same.
function w() {
  const c = 10
  const f = () => c + 1
  print(f())
}
w()
if true {
  const c = 7
  const f = () => c
  print(f())
}
{
  const c = 30
  const g = () => c
  print(g())
}
function shadow(c: i32) {
  print(c)
  {
    const c = 50
    const f = () => c
    print(f())
  }
}
shadow(5)
