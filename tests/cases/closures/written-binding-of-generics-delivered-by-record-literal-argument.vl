// @run
// @log 1
// @log s
// @log 8
// @log loud
// @log 3
// A written binding of two generics called at two types, delivered through a record literal handed to a closed record parameter at a
// closed function type, is delivered through an adapter and keeps the value it held there.
function id<T>(x: T): T { return x }
function loud<T>(x: T): T {
  print("loud")
  return x
}
type R = { g: (x: i32) => i32 }
function takeR(r: R) { return r.g(8) }
function main() {
  let f = id
  print(f(1))
  print(f("s"))
  print(takeR({ g: f }))
  f = loud
  print(f(3))
}
main()
