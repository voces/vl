// @run
// @log 1
// @log 1
// @log 1
// @log 2
// A call of an un-annotated maker returning list literals of records holding functions is read
// at the type the maker builds its literals at, beside another global of that shape written a
// two-return maker's result: a global, a function body's local, a lambda maker, and repeated
// writes and a `const` of the same call.
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function pick(b) {
  const a = [{ fs: [inc0] }]
  if b { return a }
  return [{ fs: [dbl] }]
}
let g = [{ fs: [dbl] }]
g = pick(true)
function mk2() { return [{ fs: [inc0] }] }
let w = [{ fs: [dbl] }]
w = mk2()
print(w.length)
function mk3() { return [{ fs: [inc0] }] }
function main() {
  let v = [{ fs: [dbl] }]
  v = mk3()
  print(v.length)
}
main()
const mk4 = () => [{ fs: [inc0] }]
let u = [{ fs: [dbl] }]
u = mk4()
print(u.length)
let t = [{ fs: [dbl] }]
t = mk2()
t = mk2()
const z = mk2()
print(t.length + z.length)
