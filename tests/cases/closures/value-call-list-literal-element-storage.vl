// @run
// @log 10
// @log 10
// @log 2
// @log 5
// @log 5.5
// @log 1
// A list literal written directly as a function value's argument builds at the parameter's
// element storage — a union arm, a nullable atom, a nullable scalar — and an all-`null`
// literal takes its element from the parameter too (D2702, D3219, D3337, D3390; D3605).
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type N = 1 | 2
function sum(xs: Shape[]) {
  let t = 0
  for e in xs {
    if e is Circle { t = t + e.r } else { t = t + e.s * 10 }
  }
  t
}
function viaLocal() {
  const k = (xs: Shape[]) => sum(xs)
  print(k([{ s: 1 }]))
}
viaLocal()
function viaParam(k: (xs: Shape[]) => i32) { print(k([{ s: 1 }])) }
viaParam((xs: Shape[]) => sum(xs))
print(((x: (N | null)[]) => x.length)([1, 2]))
function rowWrite(a: (i32 | null)[][], c: boolean) {
  const kl = (y: (i32 | null)[]) => {
    a[0] = y
  }
  if c { kl([5]) }
  a[0][0] = 4
  return a[0][0] + 1
}
print(rowWrite([[3]], true))
function firstOr() {
  const kl = (y: (f64 | null)[]) => y[0] ?? 0.0
  return kl([5.5])
}
print(firstOr())
function allNull() {
  const kl = (y: (i32 | null)[]) => y.length
  return kl([null])
}
print(allNull())
