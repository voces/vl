// @run
// @log 1
// @log 7
// @log 1
// A function value is adapted where it is delivered (D3073), a nullable one too; a list bound once
// and aliased at a readonly list of a wider function type is held at its own storage and read
// through it (D17816).
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function mkC(): Circle { return { r: 7 } }

const fs = [mkC]
const gs: readonly (() => Shape)[] = fs
const h: (() => Circle) | null = mkC
const g: (() => Shape) | null = h
print(gs.length)
const s = gs[0]()
if s is Circle { print(s.r) }
if g != null { print(1) }
