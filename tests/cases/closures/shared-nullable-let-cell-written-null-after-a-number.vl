// @run
// @log 5
// @log -1
// @log -1
// A shared `i32 | null` `let` written a number and then `null`, through a closure and directly,
// reads back the last value each time.
function go(k: i32) {
  let u: i32 | null
  const set = (x: i32 | null) => {
    u = x
  }
  const get = () => if u == null { -1 } else { u }
  set(k)
  print(get())
  set(null)
  print(get())
  u = null
  print(get())
}
go(5)
