// @run
// @log 3
// @log 4
// An element read of an un-annotated list of a generic, delivered to an annotated function
// binding, takes the binding's instance, from a bound list and straight from a literal (D4125).
function inner<U>(u: U) { print(u) }
const fs = [inner]
const k: (u: i32) => void = fs[0]
k(3)
const j: (u: i32) => void = [inner][0]
j(4)
