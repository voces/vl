// @run
// @log B
// @log 2
// @log B
// @log true
// A `const` copy of a written `let` of generics, called at a type the `let` is not: the copy
// reads the slot of its own call (D4240, D3975).
function gA<U>(u: U) {
  print("A")
  print(u)
}
function gB<V>(v: V) {
  print("B")
  print(v)
}
let f = gA
f = gB
const g = f
f(2)
g(true)
