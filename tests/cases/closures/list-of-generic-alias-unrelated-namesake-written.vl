// @run
// @log I
// @log 3
// @log I
// @log true
// @log 1
// @info `r` is never reassigned; use `const` instead of `let`
// @hint redundant type annotation: `noise` is inferred as `i32` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// A write to a `let` named alike in another function does not make this list's alias a
// written binding: writes are matched by binding, not by name (review of #3505, `rv3505/r6/s11`).
function inner<U>(u: U) { print("I"); print(u) }
function cb(f: (b: boolean) => void, b: boolean) { f(b) }
function noise(): i32 {
  let r = 0
  r = 1
  r
}
function main() {
  let r = inner
  const fs = [r]
  fs[0](3)
  cb(r, true)
}
main()
print(noise())
