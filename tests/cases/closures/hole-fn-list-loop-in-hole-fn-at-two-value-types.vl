// @log 3
// @log 2
// @log 3
// @log 8
// The D12702 witness: a loop over hole functions inside a hole function called at two value
// types, each instance calling the elements at its own type; then one element, the loop
// nested under a `while` and an `if`.
function add(a, b) { return a + b }
function apply2(g, s) {
  print(g(1, 2))
  print(g(s, s))
}
function apply3(g, s) {
  print(g(10, 20))
  print(g(s, 0.25))
}
function inner(k) {
  for f in [apply2, apply3] { f(add, k) }
}
inner(0.5)
inner(3)

function nested(k) {
  let i = 0
  while i < 1 {
    if k > 0 {
      for f in [apply2] { f(add, k) }
    }
    i = i + 1
  }
}
nested(1.0)
nested(4)
