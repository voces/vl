// A hole lambda that calls a nested generic at two types, inside a generic instanced at two
// types, calls its own frame's instance of it (D15014): as a statement, for its value, as an
// argument, through a second nested generic, and from two lambdas of one frame.
function outer<T>(x: T) {
  function inner<U>(u: U) { print(x); print(u) }
  const g = (v) => {
    inner(v)
  }
  g(3)
  g("q")
}
function valued<T>(x: T) {
  function wrap<U>(_u: U) { return [x, x] }
  const g = (v) => wrap(v).length
  print(g(1))
  print(g("a"))
}
function show(n: i32) { print(n) }
function asArg<T>(_x: T) {
  function size<U>(_u: U): i32 { return 7 }
  const g = (v) => {
    show(size(v))
  }
  g(true)
  g(2.5)
}
function chain<T>(_x: T) {
  function last<U>(u: U) { print(u) }
  function first<U>(u: U) { last(u) }
  const g = (v) => {
    first(v)
  }
  g(4)
  g("z")
}
function two<T>(_x: T) {
  function say<U>(u: U) { print(u) }
  const g = (v) => {
    say(v)
  }
  const h = (w) => {
    say(w)
  }
  g(5)
  h("w")
}
outer(1)
outer("s")
valued(1)
valued("s")
asArg(1)
asArg("s")
chain(1)
chain("s")
two(1)
two("s")
