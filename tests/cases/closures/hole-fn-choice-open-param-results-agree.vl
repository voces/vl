// @run
// @log ab!
// @log cd!
// @log -3
// @log -4.5
// @log cdcd
// @log ab!
// @log abab
// @log 4
// @log -3
// @log 3.5
// @log -2.5
// A choice or a re-pointed `let` of un-annotated functions whose results agree at each type the
// caller's un-annotated parameter is pinned to runs the arm it took, called there or handed to a
// callee calling it there; one caller's choice is not judged at another caller's types
// (D13782's neighbours).
function twice(s) { return s + s }
function dup(s) { return s + "!" }
function inc(x) { return x + 1 }
function neg(x) { return 0 - x }
const k = [1].length > 1
function ok(z) {
  const f = if k { twice } else { dup }
  print(f(z))
}
ok("ab")
ok("cd")
function num(z) {
  const f = if k { inc } else { neg }
  print(f(z))
}
num(3)
num(4.5)
function re(z) {
  let f = dup
  if z.length > 1 { f = twice }
  print(f(z))
}
re("cd")
function only(z, g) { return g(z) }
function okHanded(z) {
  const h = if k { twice } else { dup }
  print(only(z, h))
  print(only(z, if k { dup } else { twice }))
}
okHanded("ab")
function numHanded(z) {
  let h = inc
  if k { h = neg }
  print(only(z, h))
  print(only(z, if k { inc } else { neg }))
}
numHanded(3)
numHanded(2.5)
