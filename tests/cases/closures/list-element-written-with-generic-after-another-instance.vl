// @run
// @log I
// @log 3
// @log I
// @log true
// A list of generics written through an element and called through it is pinned at the call's
// type, so the generic written in is instanced there rather than reusing an existing instance
// (D3979).
function inner<U>(u: U) {
  print("I")
  print(u)
}
function other<V>(v: V) {
  print("O")
  print(v)
}
function main() {
  inner(3)
  const fs = [other]
  fs[0] = inner
  fs[0](true)
}
main()
