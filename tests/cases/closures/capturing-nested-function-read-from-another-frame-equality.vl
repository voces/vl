// @log 7
// A capturing nested function read as a value from a lambda, a sibling, a frame nested deeper,
// its own body or a recursive call is the value its declaring frame reads; a later execution of
// the declaration, or another call of the declaring function, is still a new value (D7700).
function outer(n: i32) {
  function inner(x: i32) { return x + n }
  function sib() { return inner }
  function self() { return inner == inner }
  const a = inner
  const c = () => inner
  print(a == c())
  print(a == sib())
  const mk = () => () => inner
  print(mk()() == a)
  print(self())
  function via(): (x: i32) => i32 {
    const t = () => sib()
    return t()
  }
  print(via() == a)
}
outer(3)
function recursed(n: i32) {
  function inner(x: i32): boolean {
    if x > 0 { return inner(x - 1) }
    return n > 0
  }
  function me(k: i32): (x: i32) => boolean {
    if k > 0 { return me(k - 1) }
    return inner
  }
  print(inner == me(3))
  print(me(1)(2))
}
recursed(3)
function looped(n: i32) {
  const fs: ((x: i32) => i32)[] = []
  const gs: ((x: i32) => i32)[] = []
  let i = 0
  while i < 2 {
    const k = i
    function inner(x: i32) { return x + n + k }
    fs.push(inner)
    const get = () => inner
    gs.push(get())
    i = i + 1
  }
  print(fs[0] == gs[0])
  print(fs[0] == fs[1])
  print(fs[1] == gs[1])
  print(gs[0] == gs[1])
  print(gs[0](10))
}
looped(3)
function made(n: i32): (x: i32) => i32 {
  function inner(x: i32) { return x + n }
  const c = () => inner
  return c()
}
print(made(1) == made(1))
print(made(1)(2) + made(2)(2))
