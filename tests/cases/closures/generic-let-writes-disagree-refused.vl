// @check
// @error cannot write 'one' to 'f': called at (string) it returns i32, where 'idg', also written to it, returns string
// @error cannot write 'one' to 'g': called at (string) it returns i32, where 'idg', also written to it, returns string
// @error cannot write 'one' to 'h': called at (string) it returns i32, where 'idg', also written to it, returns string
// D12214: a `let` holding generics whose results disagree at the call's argument types is
// refused at the write, through a generic parameter or called directly, whichever it holds.
function idg<T>(t: T) { return t }
function one<T>(t: T) { return 1 }
function app<T, R>(g: (x: T) => R, v: T): R { return g(v) }

let f = idg
f = one
print(app(f, "s"))

let g = idg
if "ab".length > 5 { g = one }
print(app(g, "s"))

let h = idg
if "ab".length > 5 { h = one }
print(h("s"))
