// @error cannot store 'half' in 'xs[].f': called at (i32) it returns f64, where 'inc0', also stored in it, returns i32 — every function a call through 'xs[].f' may run must return one type
// A list of records holding un-annotated functions of different results, bound in a maker and
// returned in a record, is refused as the same list returned bare is (D15883).
function inc0(a) { return a + 1 }
function half(a) { return a * 0.5 }
function mk() {
  const xs = [{ f: inc0 }, { f: half }]
  return { a: xs }
}
print(mk().a[1].f(3))
