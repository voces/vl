// @emit-error emitProgram: the function written to this element returns another type than the element's, at the arguments its calls pass — a list holds functions of one type
// A list of an un-annotated function read before a helper writes one returning another type: the
// elaboration delivers the list at the written function's type, which the element does not
// return, so the list keeps its element's type and the write is refused where it is made.
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function put(ys) { ys[0] = half }
function hand(zs) { put(zs) }
const xs = [inc0]
print(xs[0](3))
put(xs)
print(xs[0](3))
