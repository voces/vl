// @log 9
// @log 13
// @log 22.5
// @log 23
// @log 21
// @log 23.5
// @log 24
// @log 22
// @log s

// A returned bundle's record used at one of its signatures: a `const` holding it takes that
// member, and so does the call straight off the result; each prints a value only that member's
// closure produces.
function lap(f) {
  print(f(2.5))
  print(f(3))
  return f
}
function plain(k: i32) {
  const r = lap((a) => a + k)
  print(r(4))
  print(lap((a) => a + k + 1)(7))
}
function gen<T>(x: T, k: i32) {
  const r = lap((a) => a + k)
  print(r(1))
  print(lap((a) => a + k + 1)(1))
  print(x)
}
plain(5)
gen("s", 20)
