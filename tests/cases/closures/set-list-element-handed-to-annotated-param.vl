// @run
// @log 4
// A list of a function set's members reaches an annotated parameter only through an element read
// handed on, so only the annotation pins the slot (`fnFlowCallPathAnnPinTys`).
function inc(a) { return a + 1 }
function dbl(a) { return a * 2 }
function sel(c: boolean) {
  if c { return inc }
  return dbl
}
function ap(f: (x: i32) => i32, x: i32) { return f(x) }
const fs = [sel(true), sel(false)]
print(ap(fs[0], 3))
