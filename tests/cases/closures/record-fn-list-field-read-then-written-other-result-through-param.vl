// @run
// @log 4
// @log 1.5
// A record's list field of an un-annotated function read, then written one of another result
// through a parameter: each read runs the function the element holds then (D15190).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function put(o) { o.xs[0] = half }
const r = { xs: [inc0] }
print(r.xs[0](3))
put(r)
print(r.xs[0](3))
