// @run
// @log 6
// @log 7
// @log 8
// @log 9
// @log 2.5
// A lambda returning a generic function where a written function type closes its result delivers
// the generic at that result: a binding, a block body, a parameter and a binding of its call, at
// `i32` and at `f64` (D16075).
function inc(x) { x + 1 }
const m: () => (x: i32) => i32 = () => inc
print(m()(5))
const mb: () => (x: i32) => i32 = () => {
  return inc
}
print(mb()(6))
function run(f: () => (x: i32) => i32) { print(f()(7)) }
run(() => inc)
function run2(f: () => (x: i32) => i32) {
  const g = f()
  print(g(8))
}
run2(() => inc)
const mf: () => (x: f64) => f64 = () => inc
print(mf()(1.5))
