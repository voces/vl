// @run
// @log 7
// @log 9
// @log 1.5
// @log 2.5
// A `let` with no initializer that one closure writes and another reads is shared through a
// `T | null` cell: each write boxes the value into the cell, and each read sees the last one.
function goI(k: i32) {
  let u: i32
  const set = (x: i32) => {
    u = x
  }
  const get = () => u
  set(k)
  print(get())
  set(9)
  print(get())
}
goI(7)
function goF(k: f64) {
  let u: f64
  const set = (x: f64) => {
    u = x
  }
  const get = () => u
  set(k)
  print(get())
  set(2.5)
  print(get())
}
goF(1.5)
