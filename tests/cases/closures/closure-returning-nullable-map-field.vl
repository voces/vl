// @run
// @log 7
// @log false
// @log 9
// A closure returning a nullable-map record field takes its result's map shape from the field's
// type, so the map's i32 key survives the call and the null test (D3131).
type H = { m: {[i32]: i32} | null }
function f(): H {
  const v: {[i32]: i32} = Map()
  v[3] = 7
  { m: v }
}
const r = f()
const g = () => r.m
const e = g()
if e != null { print(e[3] ?? -1) } else { print("null") }

type R = { m: {[i32]: i32} | null }
function h() {
  const mm: {[i32]: i32} = Map()
  mm[3] = 9
  const q: R = { m: mm }
  const k = () => q.m
  const x = k()
  print(x == null)
  if x != null { print(x[3] ?? -1) }
}
h()
