// @run
// @log 1.5
// @log 4
// @log 1.5
// @log 6
// A bound list of records whose function field holds un-annotated functions with different
// results, handed to an un-annotated parameter that calls through an element's field, dispatches
// on the member each element holds; another such list through the same parameter does too, and
// a list of agreeing members keeps its closures (D16160).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function dbl(a) { return a * 2 }
function take(v) { print(v[1].f(3)) }
function first(v) { print(v[0].f(3)) }
function other(v) { print(v[1].f(3)) }
const l = [{ f: inc0 }, { f: half }]
take(l)
first(l)
const k = [{ f: dbl }, { f: half }]
take(k)
const m = [{ f: inc0 }, { f: dbl }]
other(m)
