// @run
// @log 6
// @log 6
// @log 6
// @log 6
// @log 6
// @log 6
// @log 8
// @log 1
// @log 6
// @log 5
// @log 3
// @log 6
// @log 10
// A list of un-annotated functions called inside a `.map` / `.filter` callback over a binding
// initialised from it, an element of a list of such lists, a record field or a map value runs
// at the one type the calls give, as a callback over the list's own binding does (D9173).
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function id<T>(a: T): T { return a }
function incF(a) { return a + 1.5 }
function dblF(a) { return a * 2.0 }

const g1 = [inc0, dbl]
const v1 = g1
print(v1.map((f) => f(3))[1])

const a2 = [inc0, dbl]
let b2 = [inc0, dbl]
b2 = a2
const v2 = b2
print(v2.map((f) => f(3))[1])

const w3 = { f: [inc0, dbl] }
const v3 = w3.f
print(v3.map((f) => f(3))[1])

const m4 = Map()
m4["k"] = [inc0, dbl]
const mv4 = m4["k"]
if mv4 != null {
  const v4 = mv4
  print(v4.map((f) => f(3))[1])
}

const c5 = [inc0, dbl]
const f5 = () => {
  const v5 = c5
  print(v5.map((f) => f(3))[1])
}
f5()

const ws6 = [[inc0, dbl]]
print(ws6[0].map((f) => f(3))[1])
print(ws6[0][1](4))
const v6 = ws6[0]
print(v6.filter((f) => f(3) > 4).length)

const ws7 = [[inc0], [dbl, inc0]]
print(ws7[1][0](3))
print(ws7[0].map((f) => f(4))[0])

const ws8 = [[inc0, id]]
print(ws8[0][1](3))

const ws9 = [[incF]]
ws9[0][0] = dblF
print(ws9[0][0](3.0))

function main() {
  const ws = [[inc0, dbl]]
  for w in ws { print(w[1](5)) }
}
main()
