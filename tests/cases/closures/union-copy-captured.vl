// @run
// @log s
// @log 7
// @log s!
// @log 5
// @log hi!
// @log 4
// @log 2
// @log red
// @hint Intentionally-unused variable `_w` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_clear` (leading `_` marks it unused)
// @hint redundant type annotation: `x` is inferred as `i32 | string`
// @hint redundant type annotation: `u` is inferred as `string | boolean`
// @hint redundant type annotation: `n` is inferred as `i32[] | null`
// @hint redundant type annotation: `p` is inferred as `({r: i32} | null)[]`

// D2606: a closure capturing an un-annotated COPY of a local typed its env field from the
// copy's initializer in a frame whose locals are not registered, so a value union's box, and a
// string or list narrowed off a nullable, fell to the `i32` default. A binding a closure also
// writes is read through a shared cell, whose read keeps the narrowing only in a side table.
function src(): i32 | string { return "s" }
function srcI(): i32 | string { return 7 }
function mkS(n: i32): string | null {
  if n == 0 { return null }
  "s"
}
function mkL(n: i32): i32[] | null {
  if n == 0 { return null }
  [4, 5]
}
function pick(): string | boolean { return "hi" }

function main() {
  const x: i32 | string = src()
  const y = x
  const f = () => y
  print(f())
  const x2 = srcI()
  const y2 = x2
  const g = () => y2
  print(g())
  const s = mkS(1)
  if s != null {
    const t = s
    const h = () => t + "!"
    print(h())
  }
  const l = mkL(1)
  if l != null {
    const m = l
    const k = () => m[1]
    print(k())
  }
  let u: string | boolean = pick()
  const _w = () => {
    u = true
  }
  if u is string {
    const c = u
    const p = () => {
      print(c + "!")
    }
    p()
  }
  let n: i32[] | null = mkL(1)
  const _clear = () => {
    n = null
  }
  if n != null {
    const c2 = n
    const q = () => c2[0]
    print(q())
  }
}
main()

// D2587: an alias of a record-element list, captured.
type A = { r: i32 }
function alias() {
  const p: (A | null)[] = [{ r: 1 }, null]
  const q = p
  const k = () => {
    print(q.length)
  }
  k()
}
alias()

// D2011: a copy of a module-scope loop variable, captured.
for name in ["red"] {
  const g = name
  const f = () => g
  print(f())
}
