// @run
// @log 4
// @log 1.5
// @log 1.5
// @log 1.5
// @log 4
// A list of records held in a record's field, whose function fields hold un-annotated functions
// returning different types: a call through an element's field runs the member stored there,
// chosen at run time, through a returned record, a bound one and a literal (D15801).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function two() { [1, 2].length }
function mk() { return { a: [{ f: inc0 }, { f: half }] } }
let i = 0
while i < two() {
  print(mk().a[i].f(3))
  i = i + 1
}
const r = mk()
print(r.a[two() - 1].f(3))
const o = { a: [{ f: inc0 }, { f: half }], n: 1 }
print(o.a[two() - 1].f(3))
const g = o.a[two() - 2].f
print(g(3))
