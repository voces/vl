// @run
// @log 2.25
// @log 2.5
// @log 2.25
// @log 3
// @log v
// @log 3
// A written `let` seeded from a hole parameter the body also calls directly: the let's wider set
// is decided with the parameter's, so both calls dispatch through the tagged sets (D15460).
function add(a, b) { return a + b }
function mul(a, b) { return a * b }
function swap(h) {
  let hh = h
  hh = mul
  print(hh(1.5, 1.5))
  print(h(0.5, 2.0))
}
swap(add)
function swapTwo(h) {
  let hh = h
  hh = mul
  print(hh(1.5, 1.5))
  print(h(1, 2))
}
swapTwo(add)
function same<T>(k: T): T { k }
function dbl(x) { x }
function mid(a, k: boolean) {
  let b = a
  if k { b = dbl }
  print(b("v"))
  print(a(3))
}
mid(same, true)
