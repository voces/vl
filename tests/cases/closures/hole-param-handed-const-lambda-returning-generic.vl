// @run
// @log 43
// @log 124
// A hole parameter handed a `const` bound to a lambda returning a generic function calls the one
// returned, as it does a lambda written in place (D16131).
function inc(x) { return x + 1 }
function dbl(x) { return x + x }
const m = () => inc
function run(f) { return f()(41) }
print(run(m) + 1)
const n = () => dbl
function run2(f) { return f()(41) }
print(run2(m) + run2(n))
