// @run
// @log 3
// @log -1
// @log 6
// @log -3
// @log 1
// @log 1
// @log -1
// @log -1
// A capture of a union box narrowed to a niche-repped `A | null` (a closure's or a map's), read
// inside a closure at each position.
type F = (i32) => i32
type M = {[string]: i32}
function show(f: F | null) { print(if f != null { f(2) } else { -1 }) }
function count(m: M | null) { print(if m != null { m.length } else { -1 }) }
// a lambda reading the closure niche
function lam(w: F | null | string) {
  const g = () => {
    if w is string { print("s") } else { show(w) }
  }
  g()
}
lam((x: i32) => x + 1)
lam(null)
// a nested named function reading it
function named(w: F | null | string) {
  function g() {
    if w is string { print("s") } else { show(w) }
  }
  g()
}
named((x: i32) => x * 3)
// two lambdas deep
function deep(w: F | null | string) {
  const outer = () => {
    const inner = () => {
      if w is string { print("s") } else { show(w) }
    }
    inner()
  }
  outer()
}
deep((x: i32) => x - 5)
// the map niche, read in a loop inside a lambda
function maps(w: M | null | string) {
  const g = () => {
    for i in 0 to 1 {
      if w is string { print("s") } else { count(w) }
    }
  }
  g()
}
const m: M = Map()
m["a"] = 1
maps(m)
maps(null)
