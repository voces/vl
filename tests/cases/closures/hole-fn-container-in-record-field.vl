// @run
// @log 4
// @log 4
// @log 4
// @log 4
// @log 4
// @log 4
// @log 4
// @log 4
// @log 3
// @log 3
// @log 3
// @log 20
// A map or list of un-annotated or generic functions held in a record field, and a map read
// by a `for k, v` loop, take their value type from the calls (D9061, D9062, D9063).
function inc0(a) { return a + 1 }
function id<T>(a: T): T { return a }
const m = Map()
m["k"] = inc0
const r = { m: m }
const x = r.m["k"]
if x != null { print(x(3)) }
const r2 = { m: Map() }
r2.m["k"] = inc0
const x2 = r2.m["k"]
if x2 != null { print(x2(3)) }
const m3 = Map()
m3["k"] = inc0
for k, v in m3 { print(v(3)) }
const xs = [inc0]
const r4 = { xs: xs }
print(r4.xs[0](3))
const r5 = { xs: [inc0] }
print(r5.xs[0](3))
function mk() {
  const mm = Map()
  mm["k"] = inc0
  return mm
}
const r6 = { m: mk() }
const x6 = r6.m["k"]
if x6 != null { print(x6(3)) }
for k, v in r.m { print(v(3)) }
const ys = []
ys.push(inc0)
const r8 = { ys: ys }
print(r8.ys[0](3))
const g = Map()
g["k"] = id
for k, v in g { print(v(3)) }
const rg = { m: g }
const xg = rg.m["k"]
if xg != null { print(xg(3)) }
const rl = { xs: [id] }
print(rl.xs[0](3))
const f = () => {
  const y = r.m["k"]
  if y != null { print(y(19)) }
}
f()
