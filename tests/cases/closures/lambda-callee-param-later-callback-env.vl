// @run
// @log 3
// @log 6
// @log ab
// @log abab
// @log 3
// @log 6
// @log 9
// @log 13
// @log 26
// @log 3
// @log 6
// @log 3
// @log 6
// A capturing lambda whose un-annotated parameter is the callee is specialised once per
// callback it is handed, and every specialisation after the first keeps the lambda's frame, so
// its closure environment stores each capture at the capture's own type (D2749). Before, the
// later copies hung off module scope and typed a captured list or string as `i32`.
function s1(xs: i32[]) { xs.length * 3 }
function s2(xs: i32[]) { xs.length * 6 }
function s3(xs: i32[]) { xs.length * 9 }
function t1(x: string) { x }
function t2(x: string) { x + x }
function u1(xs: i32[], n: i32) { xs.length * 3 + n }
function u2(xs: i32[], n: i32) { (xs.length * 3 + n) * 2 }
function list() {
  const out = [7]
  const ap = (g) => g(out)
  print(ap(s1))
  print(ap(s2))
}
function str() {
  const out = "ab"
  const ap = (g) => g(out)
  print(ap(t1))
  print(ap(t2))
}
function three() {
  const out = [7]
  const ap = (g) => g(out)
  print(ap(s1))
  print(ap(s2))
  print(ap(s3))
}
function twoCaptures() {
  const out = [7]
  const k = 10
  const ap = (g) => g(out, k)
  print(ap(u1))
  print(ap(u2))
}
function lambdaCallbacks() {
  const out = [7]
  const ap = (g) => g(out)
  print(ap((xs: i32[]): i32 => xs.length * 3))
  print(ap((xs: i32[]): i32 => xs.length * 6))
}
function nestedFrame() {
  const out = [7]
  const inner = () => {
    const ap = (g) => g(out)
    print(ap(s1))
    print(ap(s2))
  }
  inner()
}
list()
str()
three()
twoCaptures()
lambdaCallbacks()
nestedFrame()
