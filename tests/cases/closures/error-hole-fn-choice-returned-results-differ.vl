// @error cannot choose 'lenOf' here: called at (string) it returns i32
// A choice of un-annotated functions a function returns is judged at the type its caller
// calls the result at (D13740).
function twice(s) { return s + s }
function lenOf(s) { return s.length }
function pick(k: boolean) { return if k { twice } else { lenOf } }
print(pick([1].length > 1)("abc"))
