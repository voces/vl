// @run
// @log s
// @log 2
// @log t
// @log 3
// @log true
// @log u
// @log 4
// @log r
// @log 5
// A module binding of `fw(id)` called in a generic body at its type parameter runs when the body
// is called at two types: each instance of the body reads a binding of its own (D6206), also
// with three types, in return position and through a generic left open.
function fw(f) { return f }
function id(x) { return x }
const q = fw(id)
function g<T>(x: T) { print(q(x)) }
g("s")
g(2)
const q2 = fw(id)
function g2<T>(x: T) { print(q2(x)) }
g2("t")
g2(3)
g2(true)
const q3 = fw(id)
function g3<T>(x: T): T { return q3(x) }
print(g3("u"))
print(g3(4))
const q4 = fw(id)
function g4<T>(x: T) { print(q4(x)) }
function h4<V>(v: V) { g4(v) }
h4("r")
h4(5)
