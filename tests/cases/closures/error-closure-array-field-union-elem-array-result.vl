// @run
// @log 2307
// A record field holding a list of closures whose result is a scalar-plus-list value union,
// called by index through a parameter: the element lambda takes the union result, so the call
// reads the box and the narrow takes the list arm (D16889).
function useIt(p: {a: f64, f: (() => (i64 | boolean)[] | i32)[], z: i32}) {
  const t0 = p.f[0]()
  if (t0 is (i64 | boolean)[]) {
    const t1 = t0[0]
    if (t1 is i64) { print(t1) } else { print("OTHER") }
  } else {
    print("OTHER")
  }
}
function go() { useIt({ a: 2.5, f: [() => ([2307])], z: 11 }) }
go()
