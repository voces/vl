// @run
// @log 7
// @log 9
// @log 8
// @log hi
// @log 7
// @log 7
// @log 1.5
// @log 7
// @log 42
// @hint redundant type annotation: `p` is inferred as `{x: i32}`
// @hint redundant type annotation: `xs` is inferred as `i32[]`
// @hint redundant type annotation: `rdp` is inferred as `i32`
// @hint redundant type annotation: `p2` is inferred as `{x: i32}`
// @hint redundant type annotation: `f` is inferred as `f64`
// @hint redundant type annotation: `esc` is inferred as `() => i32`
// @hint redundant type annotation: `p3` is inferred as `{x: i32}`
// @hint redundant type annotation: `p4` is inferred as `{x: i32}`
// A closure capturing a local declared in a MODULE-SCOPE BLOCK (D1244). The module's top
// level is not a lifted frame, so `parentBindingFrameOf`'s walk ran off the `fnParent` chain
// and every capture of such a local took `captureValKind`'s i32 default: a loud
// `field access receiver is not a struct` on a struct, check-clean INVALID WASM on a list, a
// string and a struct passed THROUGH the closure. `parentBindingOf` now resolves the module
// frame's block-locals (`moduleLocalLetOf`), which are start-function locals and not globals.
//
// The second half is D1350: a closure BOUND in such a block resolved no `$fnsig` either
// (`identClosureFeSid` knew only a `fnBody` and the globals), so a VOID one was `drop`ped at
// its statement call — `expected a type but nothing on stack`, with no capture involved.

type P = { x: i32 }

if true {
  const p: P = { x: 7 }
  const rd = () => p.x
  print(rd()) // 7
  const wr = () => { p.x = 9 return p.x }
  print(wr()) // 9
}

// D1350 — a VOID closure bound and called in a module-scope block, no capture at all.
if true {
  const shout = () => { print(8) }
  shout() // 8
}

{
  const s = "hi"
  const sf = () => s
  print(sf()) // hi
  const xs: i32[] = [7, 8]
  const xf = () => xs[0]
  print(xf()) // 7
}

function rdp(q: P): i32 { return q.x }

let i = 0
while i < 1 {
  i = i + 1
  const p2: P = { x: 7 }
  const thru = () => rdp(p2) // the struct crosses the closure as an ARGUMENT
  print(thru()) // 7
  const f: f64 = 1.5
  const ff = () => f
  print(ff()) // 1.5
}

// A closure inside a closure over the same block-local, and a closure that ESCAPES the block.
let esc: () => i32 = () => 0
for j in 0 to 0 {
  const p3: P = { x: 7 }
  const outer = () => {
    const inner = () => p3.x
    return inner()
  }
  print(outer()) // 7
  const p4: P = { x: 42 }
  esc = () => p4.x
}
print(esc()) // 42
