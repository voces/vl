// @run
// @log 55
// @log 55
// @log 56
// @log 1
// @log 55
// An INFERRED nested list whose leaf is a closure. The outer element is a LIST that merely
// CONTAINS a closure, so it reps as the inner list's wrapper and not as a closure cell — the
// third container that decline covers, beside a struct and a map (D1749).
//
// Every line below reads the inner list back before calling, which is where the wrong kind
// surfaced: the outer list was keyed as a closure list, so `xs[0]` handed back something the
// call site could not resolve as a function. NO ANNOTATION may be added — the annotated
// spelling ran throughout and cannot see this.

const xs = [[(n: i32) => n + 1]]

// Bound inner list, then index and call.
const v = xs[0]
const viaBound = (m: i32) => v[0](m)
print(viaBound(54))

// The direct double index, which never binds the inner list at all.
const viaDirect = (m: i32) => xs[0][0](m)
print(viaDirect(54))

// A second element in the inner list, so the read is not index 0 by accident.
const two = [[(n: i32) => n + 1, (n: i32) => n + 2]]
const w = two[0]
const viaSecond = (m: i32) => w[1](m)
print(viaSecond(54))

// The inner list is a real list: its length is readable without calling anything.
print(v.length)

// The same shape as a STRUCT FIELD, which refused at BOTH faces before this rung.
const holder = { g: [[(n: i32) => n + 1]] }
const h = holder.g[0]
const viaField = (m: i32) => h[0](m)
print(viaField(54))
