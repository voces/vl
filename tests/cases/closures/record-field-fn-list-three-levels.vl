// @run
// @log 4
// @log 1.5
// @log 1.5
// @log 6
// @log 1.5
// @log 4
// @log 1.5
// @log 7
// @log 8
// A bound record whose fields hold lists of lists of lists of un-annotated functions with
// different results: each field is built at its rep, as a bound list of lists is (D16806).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function dbl(a) { return a * 2 }
const r = { f: [[[inc0]], [[half]]] }
print(r.f[0][0][0](3))
print(r.f[1][0][0](3))
const s = { f: [[[[inc0]]], [[[half]]]], g: [[dbl]] }
print(s.f[1][0][0][0](3))
print(s.g[0][0](3))
const o = { inner: { f: [[[inc0, half]]] } }
print(o.inner.f[0][0][1](3))
const x = r.f
for y in x { print(y[0][0](3)) }
const t = { f: [[[inc0]], [[half]]], n: 7 }
print(t.n)
print(t.f[0][0][0](t.n))
