// @run
// @log 4
// @log 4
// @log t
// A list of a `let` copy of a type-parameter parameter that a closure writes holds no function
// at an instance that binds a non-function type, so it is stored like any list (D7200).
function mid<H>(a: H, c: H) {
  let b = a
  const w = () => {
    b = c
  }
  w()
  const r = [b]
  print(r[0])
}
mid(3, 4)
function viaCopy<H>(a: H, c: H) {
  let b: H = a
  const w = () => {
    b = c
  }
  w()
  const v = b
  const r = [v]
  print(r[0])
}
viaCopy(3, 4)
viaCopy("s", "t")
