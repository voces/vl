// @run
// @log 5.5
// @log 5.5
// @log 5.5
// @log 5.5
// @log 5.5
// A list of records of un-annotated functions whose results differ, built by a call and bound,
// dispatches per member when a parameter calls each element's field, by index and by `for`
// (D16279).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function mk() { return { a: [{ f: inc0 }, { f: half }] } }
function take(v) {
  let acc = 0.0
  let i = 0
  while i < v.length {
    acc = acc + v[i].f(3)
    i = i + 1
  }
  print(acc)
}
function takeF(v) {
  let acc = 0.0
  for e in v { acc = acc + e.f(3) }
  print(acc)
}
const L = mk().a
take(L)
takeF(L)
const M = [{ f: inc0 }, { f: half }]
takeF(M)
function main() {
  const N = mk().a
  take(N)
  takeF(N)
}
main()
