// @run
// @log 3
// A `match` choosing between un-annotated functions whose results differ at the call's type
// dispatches on the arm taken (D16064).
function twice(s) { return s + s }
function inner(s) { return s }
function lenOf(s) { return s.length }
const k = [1, 2].length
const f = match k {
  0 => twice
  1 => inner
  _ => lenOf
}
print(f("abc"))
