// @run
// @log hi x
// @log hi y!
// @log bye x
// @log bye y!
// One hole parameter handed two if-choices of string-returning functions, at two instances, the
// call's value printed and bound: the arms classify the result as a string.
function both(f) {
  print(f("x"))
  const r = f("y")
  print(r + "!")
}
function hi(s) { return "hi " + s }
function yo(s) { return "yo " + s }
function bye(s) { return "bye " + s }
function a1(c: boolean) { both(if c { hi } else { yo }) }
function a2(c: boolean) { both(if c { yo } else { bye }) }
a1(true)
a2(false)
