// @run
// @log 3
// @log 3
// @log b
// @log 10
// @log 3
// An un-annotated alias of a written `let` of functions, handed to a generic higher-order
// parameter, hands the `let`: directly, at two pins, through two aliases, with hole functions,
// and inside a function (D9130).
function fst<T>(xs: T[]): T { return xs[0] }
function lst<T>(xs: T[]): T { return xs[xs.length - 1] }
function app<T>(g: (x: T[]) => T, v: T[]): T { return g(v) }
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function ap<T, R>(k: (a: T) => R, x: T): R { return k(x) }
let f = fst
if [1].length > 0 { f = lst }
const g = f
const h = g
print(app(g, [1, 2, 3]))
print(app(h, [1, 2, 3]))
print(app(g, ["a", "b"]))
let p = inc0
if [1].length > 0 { p = dbl }
const q = p
print(ap(q, 5))
function main(): void {
  let m = fst
  if [1].length > 0 { m = lst }
  const n = m
  print(app(n, [1, 2, 3]))
}
main()
