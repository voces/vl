// @error cannot assign i32 to 'r' of type string
// A declared un-annotated function read from a list parameter and called gives its own result
// at the caller, so a mistyped destination is refused rather than built (D9280).
function inc0(a) { return a + 1 }
function run(fs) { return fs[0](3) }
const r: string = run([inc0])
print(r)
