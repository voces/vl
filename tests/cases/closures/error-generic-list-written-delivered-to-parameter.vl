// @error argument 1: expected ((string) => string)[], got ((i32) => i32)[]
// A list of a generic function written with a fixed-type function refuses when the list is
// handed to a parameter whose element type the written value does not fit (D10080).
function id<T>(x: T): T { x }
function inc(x: i32): i32 { x + 1 }
const ys = [id]
ys.push(inc)
function run(a: ((x: string) => string)[]) { print(a[1]("s")) }
run(ys)
