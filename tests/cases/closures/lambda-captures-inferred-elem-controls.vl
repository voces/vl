// @run
// @log 1
// @log 2
// @log 1.5
// @log 2
// @log 1.5
// @log 2
// THE THREE CONTROLS for `soundness/xfail-miscompile-lambda-captures-inferred-nonI32-elem.vl`,
// where a lambda capturing an inference-HOLE parameter and indexing it emits invalid wasm once
// the call site pins the element to a non-i32 scalar.
//
//   · i32 element, captured read — fine;
//   · f64 element, read OUTSIDE the lambda — fine;
//   · f64 element, captured read, param ANNOTATED — fine.
//
// Only the un-annotated + non-i32 + captured combination breaks. All three live here in the
// PASSING corpus so the xfail's argument cannot quietly stop being true: if any of them starts
// failing, the defect is wider than that file claims and it has to be rewritten rather than kept.
function viaI32(self) {
  const g = () => {
    const z = self[0]
    return z
  }
  print(g())
  return self.length
}

function outsideLambda(self) {
  const z = self[0]
  print(z)
  return self.length
}

function annotated(self: f64[]) {
  const g = () => {
    const z = self[0]
    return z
  }
  print(g())
  return self.length
}

print(viaI32([1, 2]))
print(outsideLambda([1.5, 2.5]))
print(annotated([1.5, 2.5]))
