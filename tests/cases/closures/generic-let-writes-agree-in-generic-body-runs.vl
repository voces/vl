// @run
// @log h
// @log 5
// @log h
// @log s
// @log 2
// @log 2
// @hint Intentionally-unused parameter `_t` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_t` (leading `_` marks it unused)
// D14722's neighbours: generics written to one `let` in a generic body whose results agree at
// each instance's argument types still run.
function idg<T>(t: T) { return t }
function idh<T>(t: T) { print("h"); return t }
function one<T>(_t: T) { return 1 }
function two<T>(_t: T) { return 2 }
function run<U>(x: U) {
  let f = idg
  if "ab".length < 5 { f = idh }
  print(f(x))
}
function count<U>(x: U) {
  let f = one
  if "ab".length < 5 { f = two }
  print(f(x))
}
run(5)
run("s")
count(5)
count("s")
