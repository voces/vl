// @run
// @log on
// @log on
// @log on
// @log on
// @log 1
// D3416: a function value of single-literal result type that is not a stable name (a field, a
// `let`, a parameter) is delivered at a function type returning the literal union.
type K = "on" | "off"
function F(): "on" { return "on" }
function use(g: () => K): K { return g() }
const o = { f: F }
print(use(o.f))
let fv = F
print(use(fv))
function via(h: () => "on"): K { return use(h) }
print(via(F))
type R = { f: () => "on" }
const r: R = { f: F }
print(use(r.f))
type N = 1 | 2
function G(): 1 { return 1 }
function useN(g: () => N): N { return g() }
const p = { g: G }
print(useN(p.g))
