// @run
// @warning Unused parameter `a`
// @log x2
// @log y20
// @log x2
// @log 2
// @log 20
// @log 2
// The D10792 witness: a list that is pushed onto is copied per function type, and each push
// is repeated on the copy, so both loops see three elements.
import { toString } from "std:fmt"

function cat(a, b) { return a + b.toString() }
function snd(a, b) { return b }
function apply2(g) { print(g("x", 2)) }
function apply3(g) { print(g("y", 20)) }
const fs = [apply2, apply3]
fs.push(apply2)
for f in fs { f(cat) }
for f in fs { f(snd) }
