// @run
// @hint Intentionally-unused parameter `_a` (leading `_` marks it unused)
// @log s
// @log s
// @log s
// @log 4
// @log 4
// @log 5
// A choice delivered to a closed function type at a return is an adapter dispatching on the
// captured id, each arm boxed at its union (capture binding shape 2, Q58 position sweep).
function inc(a) { return a + 1 }
function str(_a) { return "s" }
type K = (a: i32) => i32 | string
function ap(g, x) { return g(x) }
function mk(c: boolean): K {
  const g = if c { str } else { inc }
  print(ap(g, 3))
  return g
}
function run(c: boolean) {
  const g = if c { str } else { inc }
  print(ap(g, 3))
  print(mk(c)(4))
}
run(true)
run(false)
