// @run
// @log 3
// A `const` bound to an `if` of un-annotated functions whose results differ at the call's type
// holds the chosen one, and the call dispatches on it and gives the join of their results (D16064).
function twice(s) { return s + s }
function lenOf(s) { return s.length }
const k = [1].length > 1
const f = if k { twice } else { lenOf }
print(f("abc"))
