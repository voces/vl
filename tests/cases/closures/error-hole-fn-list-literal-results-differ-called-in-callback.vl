// @error cannot store 'half' in an element of 'xs': called at (i32) it returns f64, where 'inc0', also stored in it, returns i32
// A literal's own elements are judged at a `.filter` callback's call too (D9172).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const xs = [inc0, half]
print(xs.filter((f) => f(3) > 1).length)
