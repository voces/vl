// @run
// @log 1.5
// A list literal of records of un-annotated functions of different results, handed to a `const`
// lambda's un-annotated parameter, dispatches each element's field per member (D15808, D15802).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function two() { return [1, 2].length }
const take = (v) => v[two() - 1].f(3)
print(take([{ f: inc0 }, { f: half }]))
