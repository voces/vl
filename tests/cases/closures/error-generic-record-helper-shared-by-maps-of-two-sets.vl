// @emit-error emitProgram: monomorphize: unsupported argument type for `mm` in a call to `fill`
// Two maps of records holding different function sets, one also holding a second generic `k2`,
// each handed to the same helper: the helper is one instance whose ids are each member's own, and
// the map holding two generics refuses loudly rather than dispatch a wrong id (D15493).
function id<T>(x: T): T { x }
function k2<T>(x: T): T {
  print("k2")
  x
}
function fill(mm) { mm["k"] = { f: id } }
const a = Map()
fill(a)
const b = Map()
b["z"] = { f: k2 }
fill(b)
const ar = a["k"]
if ar != null {
  print(ar.f(2))
  print(ar.f("s"))
}
const bz = b["z"]
if bz != null { print(bz.f(3)) }
const bk = b["k"]
if bk != null {
  print(bk.f(4))
  print(bk.f("t"))
}
