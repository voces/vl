// @run
// @log s
// @log 3
// @log 2
// @log 2
// @log s
// @hint Intentionally-unused parameter `_t` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_t` (leading `_` marks it unused)
// D12214's neighbours: generics written to one `let` whose results agree at each call's
// argument types still run, called directly or through a generic parameter.
function idg<T>(t: T) { return t }
function idh<T>(t: T): T { t }
function one<T>(_t: T) { return 1 }
function two<T>(_t: T) { return 2 }
function app<T, R>(g: (x: T) => R, v: T): R { return g(v) }

let f = idg
f = idh
print(f("s"))
print(f(3))

let k = one
if "a".length > 0 { k = two }
print(k("s"))
print(k(2.5))
print(app(f, "s"))
