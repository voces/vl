// @run
// @log 6
// @log 14
// @log 10
// @log 25
// @log 1.5
// An un-annotated map of un-annotated functions handed to an un-annotated parameter that reads
// it by `get`, narrowed and called: the parameter takes the map the elaboration binds it to, of
// the set's ids, and the read boxes the id (D15174). One function per position: one member, two
// members, two maps of two sets through one function, and two members of different results.
function h1(a) { return a * 2 }
function h2(a) { return a * 2 }
function i2(a) { return a + 1 }
function d3(a) { return a + a }
function s3(a) { return a * a }
function n3(a) { return 0 - a }
function t3(a) { return a + 2 }
function i4(a) { return a + 1 }
function f4(a) { return a / 2.0 }
const m1 = Map()
m1.set("b", h1)
one(m1)
const m2 = Map()
m2.set("a", i2)
m2.set("b", h2)
two(m2)
const ma = Map()
ma.set("x", t3)
ma.set("y", d3)
const mb = Map()
mb.set("x", n3)
mb.set("y", s3)
sets(ma)
sets(mb)
const m4 = Map()
m4.set("a", i4)
m4.set("b", f4)
mixed(m4)
function one(m) {
  const g = m.get("b")
  if g != null { print(g(3)) }
}
function two(m) {
  const g = m.get("b")
  if g != null { print(g(7)) }
}
function sets(m) {
  const g = m.get("y")
  if g != null { print(g(5)) }
}
function mixed(m) {
  const g = m.get("b")
  if g != null { print(g(3)) }
}
