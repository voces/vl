// @run
// @log 6
// @log 32
// A map store of a call through a set of hole relays, with the functions declared after it: the
// call checks the callee whose result the module's pre-pass left holding a hole (D16369).
const m = Map()
m["k"] = pick(true)
const mv = m["k"]
if mv != null { print(mv) }
const n = pick(false)
print(n)
function add(a, b) { a + b }
function ap2(g) { g(1, 2) + g("ab", "c").length }
function ap3(g) { g(10, 20) + g("x", "y").length }
function pick(c: boolean) {
  const f = if c { ap2 } else { ap3 }
  f(add)
}
