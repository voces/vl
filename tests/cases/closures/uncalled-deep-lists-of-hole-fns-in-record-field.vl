// @log 6
// A list of lists of un-annotated functions nothing calls, written whole at a record field, held
// three lists deep, or re-pointed as a record of one, takes the type its functions hold at no
// call; a called one keeps its pin (D16921).
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
const r = { f: [[inc0]] }
r.f = [[dbl]]
print(r.f.length)
const q = { f: [[[inc0]]] }
print(q.f.length)
let p = { f: [[[inc0]]] }
p = { f: [[[dbl]]] }
print(p.f.length)
let b = [[[inc0]]]
b = [[[dbl]]]
print(b.length)
const c = { f: [[inc0]] }
c.f = [[dbl]]
print(c.f[0][0](3))
