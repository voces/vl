// @log true
// @log 5
// @log true
// @log 5
// @log 2
// @log false
// @log P
// @log 1
// @log Q
// @log 2
// @log 5
// @warning Unused parameter `n` (prefix with `_` to suppress, or remove it)
// @hint redundant type annotation: `gv` is inferred as `() => i32` — remove it to lean on inference
// @warning Unused parameter `n` (prefix with `_` to suppress, or remove it)
// @warning Unused variable `a` (prefix with `_` to suppress, or remove it)
// @warning Unused variable `b` (prefix with `_` to suppress, or remove it)
// @hint redundant type annotation: `gl` is inferred as `() => i32` — remove it to lean on inference
// A nullable-closure return whose body can fall off its end returns `null` there: annotated or
// inferred, named or a lambda, including an else-less tail `if` that writes a closure to a
// global or captured cell (D2499, D2645, D2647, D3973, D4349).

function f(c: boolean) {
  if c { return () => 5 }
}
function fa(c: boolean): (() => i32) | null {
  if c { return () => 5 }
}
let g: (i32) => i32 = (n) => 0
function set(flag: boolean) {
  if flag { g = (n) => n + 1 }
}
let gv: () => i32 = () => 0
function setv(c: boolean, n: i32) {
  if c { gv = () => 5 }
}

print(f(false) == null)
const q = f(true)
if q != null { print(q()) }
print(fa(false) == null)
const qa = fa(true)
if qa != null { print(qa()) }
const a = set(true)
const b = set(false)
print(g(1))
const r = setv(true, 0)
print(r == null)
function main() {
  let k: ((n: i32) => void) | null = (n: i32) => {
    print("P"); print(n)
  }
  const fq: ((n: i32) => void) | null = (n: i32) => {
    print("Q"); print(n)
  }
  const w = () => {
    if fq != null { k = fq }
  }
  if k != null { k(1) }
  w()
  if k != null { k(2) }
}
main()
let gl: () => i32 = () => 0
const fl = (c: boolean) => {
  if c { gl = () => 5 }
}
fl(true)
print(gl())
