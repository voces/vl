// @run
// @log I
// @log 1
// @log I
// @log s
// @warning Unused variable `flip` (prefix with `_` to suppress, or remove it)
// A capture cell in a generic body with a writer closure nothing names, beside two instances runs at each instance's own
// type (D3939, `rv3498/v02`).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function run<T>(x: T) {
  let k = inner
  const rd = (t: T) => {
    k(t)
  }
  const flip = () => {
    k = other
  }
  rd(x)
}
run(1)
run("s")
