// @emit-error a lambda with an un-annotated parameter is stored in a list, or in a variable a nested function writes, and no call fixes its parameter types
// A list the program wrote holding a hole lambda, reassigned whole: `d = [e]` is a write the
// alias resolver does not follow (D3845), so no call pins either lambda and the list element is
// refused, not stored at the hole's `i32` default (D3851). Only the rewrite's own cell is read
// through.
function f(x: string) {
  const c = (y) => y + "C"
  const e = (y) => y + "E"
  let d = [c]
  print(d[0](x))
  d = [e]
  print(d[0](x))
}
f("a")
