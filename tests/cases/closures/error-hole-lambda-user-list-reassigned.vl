// @emit-error a function-value call has no interned signature
// A list the program wrote holding a hole lambda, reassigned whole: `d = [e]` is a write the
// alias resolver does not follow, so it declines and the call is refused, not lowered at the
// lambdas' `i32` default (D3845). Only the rewrite's own capture cell is read through.
function f(x: string) {
  const c = (y) => y + "C"
  const e = (y) => y + "E"
  let d = [c]
  print(d[0](x))
  d = [e]
  print(d[0](x))
}
f("a")
