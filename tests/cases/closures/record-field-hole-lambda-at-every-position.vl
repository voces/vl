// @log 12
// @log 4
// @log 12
// @log 9
// @info `w` is never reassigned; use `const` instead of `let`
// An un-annotated lambda written in an un-annotated binding's record literal infers its
// parameters as a bare binding of it does, at every position its field is read (D17009, D17010).
function call2(o) { return o.f(2) }
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const v = { f: (x) => x * 3 }
print(v.f(2))
let w = { f: (x) => x * 3 }
print(w.f(2))
const g = v.f
print(g(2))
print(call2(v))
function run() {
  const u = { f: (x) => x * 3 }
  print(u.f(2))
  print(u.f(1.5))
}
run()
const o = { f: (x) => x + 1, g: (y) => y * 2 }
print(o.f(1))
print(o.g(2.5))
const r = { f: (x) => x * 3, n: 4 }
print(r.f(r.n))
print(r.n)
function loop() {
  let s = 0
  for k in [1, 2, 3] {
    const c = { f: (x) => x * k }
    s = s + c.f(2)
  }
  print(s)
}
loop()
const xs = [{ f: inc0 }, { f: half }]
const p = { f: (x) => x * 3 }
xs.push(p)
print(xs[2].f(3))
