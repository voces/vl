// @run
// @log 5 2.5
// @log 2.5
// @log 5
// @log x
// @log 5 2.5
// @log 2.5
// @log 5
// @log 2
// @log 5 2.5
// @log s
// @hint Intentionally-unused variable `_a`
// @hint Intentionally-unused variable `_b`
// @hint Intentionally-unused variable `_t`
// A plain function handing back a record of one closure per signature, called inside each
// instance of a generic or hole-parameter function: a holder, a hand and a direct call each take
// their member there.
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
function gen<T>(t: T, k: i32) {
  const r = lap((a) => a + k)
  const _t = t
  return r
}
function deliver() { return gen("s", 1) }
function use(g: (x: f64) => f64) { print(g(1.5)) }
function run<T>(t: T) {
  const u = deliver()
  print("\{u(4)} \{u(1.5)}")
  use(deliver())
  print(deliver()(4))
  print(t)
}
run("x")
run(2)
function hole(t) {
  const u = deliver()
  print("\{u(4)} \{u(1.5)}")
  print(t)
}
hole("s")
