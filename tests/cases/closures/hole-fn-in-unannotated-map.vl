// @run
// @log 4
// @log 4
// @log 4
// @log 4
// @log 4
// @log 4
// @log 4
// @log 4
// @log 4
// @log 4
// @log 10
// An un-annotated function written into an un-annotated `Map()` gives the map its value
// type, at every write and read, and in a list or record held as the value (D9040).
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function zero(a: i32) { a - a }
const m = Map()
m["k"] = inc0
const x = m["k"]
if x != null { print(x(3)) }
if m["k"] != null { print(m["k"](3)) }
print((m["k"] ?? zero)(3))
const s = Map()
s.set("k", inc0)
const y = s.get("k")
if y != null { print(y(3)) }
print((s.get("k") ?? zero)(3))
function mk() {
  const r = Map()
  r["k"] = inc0
  return r
}
const mm = mk()
const z = mm["k"]
if z != null { print(z(3)) }
const w = Map()
function fill() { w.set("k", inc0) }
fill()
const u = w.get("k")
if u != null { print(u(3)) }
const l = Map()
l["k"] = [inc0]
const lv = l["k"]
if lv != null { print(lv[0](3)) }
const o = Map()
o["k"] = { f: inc0 }
const ov = o["k"]
if ov != null { print(ov.f(3)) }
const xs = []
xs.push(inc0)
print(xs[0](3))
const two = Map()
two["a"] = inc0
two["b"] = dbl
print((two["a"] ?? zero)(3) + (two["b"] ?? zero)(3))
