// @run
// @hint redundant type annotation: `inc` is inferred as `i32`
// @log true
// @log 1
// @log s
// @log 2
// @log t
// @log true
// @log true
// @log true
// @log false
// `==` on a binding called at two types compares the function it holds, as it does for a plain
// function binding: equal after writes of the same function, unequal once one is rewritten
// (D3975).
function id<T>(x: T): T { return x }
function k<T>(x: T): T { return x }
function inc(x: i32): i32 { return x + 1 }
function main() {
  const a = inc
  const b = inc
  print(a == b)
  let f = id
  f = k
  print(f(1))
  print(f("s"))
  let g = id
  g = k
  print(g(2))
  print(g("t"))
  print(f == f)
  print(f == g)
  const h = f
  print(h == f)
  f = id
  print(h == f)
}
main()
