// @run
// @log L
// @log 3
// @log L
// @log 3
// @log L
// @log s
// @log L
// @log s
// @log L
// @log true
// @log L
// @log true
// Both elements of a list of a lambda-written `let` are called at each of three instances'
// own type (D7142).
function other<V>(v: V) { print("O"); print(v) }
function g<T>(x: T) {
  let k = other
  k = (n) => {
    print("L"); print(n)
  }
  const fs = [k, k]
  fs[1](x)
  fs[0](x)
}
g(3)
g("s")
g(true)
