// @run
// @log 3
// @log u3
// @log 4
// @log v3
// @log w3
// @log 3
// @log 3
// @log 3
// @log 3
// @log 3
// @log 5
// A closure call whose nullable union-arm parameter takes a value narrowed out of a wider box,
// its result delivered at each position: a scalar and a union parameter, a nested call, a
// concatenation, an interpolation hole, a return, a binding, an `if` arm, a `??` operand and a
// record-literal field.
import { toString } from "std:fmt"

type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Got = { n: i32 }
function sh(x: i32): i32 { return x }
function su(x: i32 | string): string {
  if x is string { return x }
  return "u" + toString(x)
}
function inc(x: i32): i32 { return x + 1 }
function pScalar(rd: (Circle | null) => i32, e: Circle | null | string) {
  if !(e is string) { print(sh(rd(e))) }
}
function pUnion(rd: (Circle | null) => i32, e: Circle | null | string) {
  if !(e is string) { print(su(rd(e))) }
}
function pNested(rd: (Circle | null) => i32, e: Circle | null | string) {
  if !(e is string) { print(sh(inc(rd(e)))) }
}
function pConcat(rd: (Circle | null) => i32, e: Circle | null | string) {
  if !(e is string) { print("v" + toString(rd(e))) }
}
function pHole(rd: (Circle | null) => i32, e: Circle | null | string) {
  if !(e is string) { print("w\{rd(e)}") }
}
function pReturn(rd: (Circle | null) => i32, e: Circle | null | string): i32 {
  if e is string { return 0 }
  return rd(e)
}
function pBinding(rd: (Circle | null) => i32, e: Circle | null | string) {
  if !(e is string) {
    const v = rd(e)
    print(v)
  }
}
function pIfArm(rd: (Circle | null) => i32, e: Circle | null | string, k: i32) {
  if !(e is string) {
    const v = if k > 0 { rd(e) } else { 0 }
    print(v)
  }
}
function pCoalesce(
  rd: (Circle | null) => i32,
  e: Circle | null | string,
  m: i32 | null,
) {
  if !(e is string) { print(m ?? rd(e)) }
}
function pField(rd: (Circle | null) => i32, e: Circle | null | string) {
  if !(e is string) {
    const g: Got = { n: rd(e) }
    print(g.n)
  }
}
function pArgKinds(rd: (Circle | null) => i32) { print(rd({ r: 5 })) }
const rd = (w: Circle | null): i32 => if w == null { 0 - 1 } else { w.r }
const zz: (Circle | null | string)[] = [{ r: 3 }, null, "x"]
pScalar(rd, zz[0])
pUnion(rd, zz[0])
pNested(rd, zz[0])
pConcat(rd, zz[0])
pHole(rd, zz[0])
print(pReturn(rd, zz[0]))
pBinding(rd, zz[0])
pIfArm(rd, zz[0], 1)
pCoalesce(rd, zz[0], null)
pField(rd, zz[0])
pArgKinds(rd)
