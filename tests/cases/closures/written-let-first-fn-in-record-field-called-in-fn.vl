// @run
// @log 3
// @log 7
// The same inside a function, through a record with another field (D6885).
function apply3(g) { print(g(1, 2)) }
function apply4(g) { print(g(3, 4)) }
function add(a: i32, b: i32) { a + b }
function main() {
  let h = apply3
  const r = { f: h, n: 7 }
  h = apply4
  r.f(add)
  print(r.n)
}
main()
