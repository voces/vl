// @run
// @log 4
// @log 6
// A choice of two functions handed to a hole parameter called through it is the member's id,
// dispatched at the call, with no instance of the callee at the choice's closure rep.
function inc0(a) { return a + 1 }
function dbl0(a) { return a * 2 }
function run0(f) { print(f(3)) }
const b0 = inc0(1) > 1
run0(if b0 { inc0 } else { dbl0 })
run0(if !b0 { inc0 } else { dbl0 })
