// @run
// @log 6
// @log 4
// @log 4
// @log 6
// @log 4
// @log 6
// @log 2
// @log 4
// A map value holding nested lists of un-annotated functions, written at two shapes, read back
// narrowed by index at its element list: called, bound, passed on, iterated, read at its own
// element, counted, and the first element list. The element list is read as the list stores it.
function inc1(a) { return a + 1 }
function dbl1(a) { return a * 2 }
function apply(f, v) { return f(v) }
function atCall() {
  const m = Map()
  m.set("k", [[inc1], [dbl1, inc1]])
  m["j"] = [[dbl1]]
  const x = m["k"]
  if x != null { print(x[1][0](3)) }
}
function atBind() {
  const m = Map()
  m.set("k", [[inc1], [dbl1, inc1]])
  m["j"] = [[dbl1]]
  const x = m["k"]
  if x != null {
    const r = x[1]
    print(r[1](3))
  }
}
function atPass() {
  const m = Map()
  m.set("k", [[inc1], [dbl1, inc1]])
  m["j"] = [[dbl1]]
  const x = m["k"]
  if x != null { print(apply(x[1][1], 3)) }
}
function atIter() {
  const m = Map()
  m.set("k", [[inc1], [dbl1, inc1]])
  m["j"] = [[dbl1]]
  const x = m["k"]
  if x != null {
    for f in x[1] { print(f(3)) }
  }
}
function atElem() {
  const m = Map()
  m.set("k", [[inc1], [dbl1, inc1]])
  m["j"] = [[dbl1]]
  const x = m["k"]
  if x != null {
    const e = x[1][0]
    print(e(3))
  }
}
function atLen() {
  const m = Map()
  m.set("k", [[inc1], [dbl1, inc1]])
  m["j"] = [[dbl1]]
  const x = m["k"]
  if x != null { print(x[1].length) }
}
function atFirst() {
  const m = Map()
  m.set("k", [[inc1], [dbl1, inc1]])
  m["j"] = [[dbl1]]
  const x = m["k"]
  if x != null { print(x[0][0](3)) }
}
atCall()
atBind()
atPass()
atIter()
atElem()
atLen()
atFirst()
