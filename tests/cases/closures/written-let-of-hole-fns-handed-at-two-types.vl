// @run
// @log 6
// @log 7
// @log 20
// @log 1
// @log 2
// @log 3
// @log 4
// @log 7
// @log 20
// @log 9
// @log 4.5
// A re-pointed `let` of un-annotated functions, handed to an un-annotated parameter at two
// argument types, runs whichever function it holds at each hand (D9030).
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function w(h, x) { return h(x) }
let f = inc0
f = dbl
print(w(f, 3))
print(w(f, 3.5))
print(f(10))
let fl = inc0
let i = 0
while i < 2 {
  print(w(fl, i))
  fl = dbl
  i = i + 1
}
print(w(fl, 1.5))
let fb = inc0
print(w(fb, 3))
if [1].length > 0 { fb = dbl }
print(w(fb, 3.5))
print(fb(10))
let fx = inc0
if [1].length > 0 { fx = (a) => a * 3 }
print(w(fx, 3))
print(w(fx, 1.5))
