// @emit-error call to unknown function
// D14842's nested-function spelling through a binding copying the parameter: the nested body is
// one for every instance, so the alias forward is not taken and the call stays refused, never
// built at one instance's set.
function add(a, b) { return a + b }
function mul(a, b) { return a * b }
function apply2(g) {
  print(g(1, 2))
  print(g(1.5, 2.5))
}
function run(h) {
  let hh = h
  function inner() {
    for f in [apply2] { f(hh) }
  }
  inner()
}
run(add)
run(mul)
