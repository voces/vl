// @run
// @log O
// @log 1
// @log O
// @log true
// A generic passed from a closure every instance shares to another closure's T-typed parameter is instanced at the instance's type, with no cell involved (D3956).
function other<V>(v: V) { print("O"); print(v) }
function a<T>(x: T) {
  const w = (g: (t: T) => void) => {
    g(x)
  }
  const w2 = () => {
    w(other)
  }
  w2()
}
a(1)
a(true)
