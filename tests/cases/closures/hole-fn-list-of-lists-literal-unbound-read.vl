// @run
// @log 1
// @log 1
// @log 2
// @log 2
// An unbound list literal of lists of an un-annotated function, read without calling through
// it: an inner list's length, the outer length, two inner elements, and a second inner list.
function dbl(a) { return a * 2 }
print([[dbl]][0].length)
print([[dbl]].length)
print([[dbl, dbl]][0].length)
print([[dbl], [dbl, dbl]][1].length)
