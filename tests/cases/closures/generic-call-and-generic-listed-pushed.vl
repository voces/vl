// @run
// @log mk
// @log 2
// @log abc
// @log true
// @log 3
// @log mk
// @log 2
// @log 7
// @log 7
// @log 7
// @log abc
// @log mk
// @log 2
// @log abc
// @log true
// A list whose elements are a call returning a generic and the generic itself, pushed to and
// called through each element at its own type, runs the call once; the call bound to a
// `const` first is the control (D9650).
function id<T>(x: T): T { x }
function mk() {
  print("mk")
  return id
}
const xs = [mk(), id]
print(xs[0](2))
print(xs[1]("abc"))
xs.push(id)
print(xs[2](true))
print(xs.length)
const ys = [mk(), id]
print(ys[0](2))
ys.push(id)
for f in ys { print(f(7)) }
print(ys[1]("abc"))
const w = mk()
const zs = [w, id]
print(zs[0](2))
print(zs[1]("abc"))
zs.push(id)
print(zs[2](true))
