// @run
// @log 3
// A record field holding a hole higher-order function from a `let` rewritten afterwards is
// called with a function at the field's own call type (D7146).
function apply3(g) { print(g(1, 2)) }
function add(a: i32, b: i32) { a + b }
let h = apply3
const r = { f: h }
h = apply3
r.f(add)
