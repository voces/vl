// A hole-typed `let` holding a union box, written from a closure with another value of the same
// union: from a lambda, a nested lambda and a lambda's branch, over a list union and a value
// union. The written value is already the cell's box and is stored as it stands.
function mk(k: i32): i32[] | f64[] {
  if k == 0 { return [1, 2] }
  return [1.5]
}
function pick(k: i32): i32 | string {
  if k == 0 { return 3 }
  return "s"
}
function listInLambda(a, other) {
  let x = a
  const swap = () => {
    x = other
  }
  swap()
  let c = 0
  for q in x { c = c + 1 }
  return c
}
function listInNested(a, other) {
  let x = a
  const outer = () => {
    const inner = () => {
      x = other
    }
    inner()
  }
  outer()
  let c = 0
  for q in x { c = c + 1 }
  return c
}
function listInBranch(a, other, k: i32) {
  let x = a
  const swap = () => {
    if k > 0 { x = other }
  }
  swap()
  let c = 0
  for q in x { c = c + 1 }
  return c
}
function valueInLambda(a, other) {
  let x = a
  const swap = () => {
    x = other
  }
  swap()
  return x is string
}
print(listInLambda(mk(0), mk(1))) // 1
print(listInNested(mk(1), mk(0))) // 2
print(listInBranch(mk(0), mk(1), 1)) // 1
print(listInBranch(mk(0), mk(1), 0)) // 2
print(valueInLambda(pick(0), pick(1))) // true
