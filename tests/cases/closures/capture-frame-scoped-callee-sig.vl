// @run
// @log 8
// @log 8
// @log 8
// @log 8
// @log 9
// @log 3

// @hint redundant type annotation: `v` is inferred as `i32`
// @hint redundant type annotation: `c` is inferred as `(i32) => void`
// @hint redundant type annotation: `g` is inferred as `(i32) => void`

// D1634 — the closure-value sig resolver reads `fnIx`'s own params and body, the globals
// registry and the module frame. A CAPTURED callee's binding lives in an enclosing frame,
// which none of those reaches, so the call resolved no `>v` sig: the lambda's own result
// type came out i32 over a void body, and a statement call dropped a value it never made.

// The module-scope twin has always run — `__c` is a global there and the globals registry
// is durable — which is what makes the enclosing FRAME the axis rather than the capture.

function tailCall() {
  const c = (n: i32) => {
    print(n)
  }
  const f = () => {
    c(8)
  }
  f()
}

tailCall()

// The capture rebound first, under a name a module function also carries: the shadow is
// scenery here, and the ablation is what says so.
function v(): i32 { 6 }

function rebindShadowingFnName() {
  const c: (i32) => void = (n: i32) => {
    print(n)
  }
  const f = () => {
    const v = c
    v(8)
  }
  f()
}

rebindShadowingFnName()

// The captured callee a PARAMETER of the enclosing frame rather than its `let`: the same
// channel, one storage class over.
function fromParam(c: (i32) => void) {
  const f = () => {
    c(8)
  }
  f()
}

fromParam((n: i32) => {
  print(n)
})

// The call NOT in tail position, so the failure is the statement form's `drop` rather than
// the lambda's result type. One resolver, two symptoms.
function notTail() {
  const c = (n: i32) => {
    print(n)
  }
  const f = () => {
    c(8)
    print(9)
  }
  f()
}

notTail()

// D1662 — a void closure read out of a MAP, narrowed and called. The binding's recorded
// type is `TyFunc | null`, which the sig ladder's arena rung did not peel, so the statement
// call dropped a result the callee never pushed.
const m: { [string]: (i32) => void } = Map()

m["k"] = (n: i32) => {
  print(n)
}

const mv = m["k"]

if mv != null {
  const g: (i32) => void = mv
  g(3)
}
