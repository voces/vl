// @run
// @log 4
// @log 4
// @log 3
// @log 2.5
// @log 1.5
// @log t
// A record field read from a `let` copy of a type-parameter parameter that a closure writes,
// directly or through a second copy, takes the instance's type (D7144).
function mid<H>(a: H, c: H) {
  let b = a
  const w = () => {
    b = c
  }
  w()
  const r = { f: b }
  print(r.f)
}
mid(3, 4)
function viaCopy<H>(a: H, c: H) {
  let b = a
  const w = () => {
    b = c
  }
  w()
  const v = b
  const r = { f: v, g: a }
  print(r.f)
  print(r.g)
}
viaCopy(3, 4)
viaCopy(1.5, 2.5)
function named<H>(a: H, c: H) {
  let b: H = a
  const w = () => {
    b = c
  }
  w()
  const r = { f: b }
  print(r.f)
}
named("s", "t")
