// @error cannot write 'half' to an element of 'xs': called at (i32) it returns f64, where 'inc0', also written to it, returns i32
// A write through an alias of a list of functions writes the list the alias names (D9091).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const xs = [inc0]
const ys = xs
ys[0] = half
print(xs[0](3))
