// @log via f
// @log 6
// D9820: a generic whose parameter is `((x: T) => T) | null` binds `T` from a lambda, a named
// function, a generic function value or a capture, and takes `null`. D9821, D9850: taken as a
// value and returned by an un-annotated function, into an annotated or an un-annotated
// destination. D9851, D9852: held by a written `let`. The non-null parameter is the control.
function g<T>(f: ((x: T) => T) | null, x: T): T {
  if f != null { return f(x) }
  x
}
function g2<T>(f: ((x: T, y: T) => T) | null, x: T, y: T): T {
  if f != null { return f(x, y) }
  x
}
function h<T>(f: (x: T) => T, x: T): T { f(x) }
function inc(x: i32) { x + 1 }
function dbl<U>(x: U): U {
  print("via f")
  x
}
function direct() {
  const k = 100
  print(g((x: i32) => x + 1, 2))
  print(g(inc, 2))
  print(g(null, 5))
  print(g(dbl, 6))
  print(g((x: i32) => x + k, 7))
  print(g((s: string) => s + "!", "ab"))
  print(g2((x: i32, y: i32) => x * y, 3, 4))
  print(g2(null, 3, 4))
  print(g((x: f64) => x * 2.0, 1.25))
}
direct()

function deliver() { return g }
const va: (f: ((x: i32) => i32) | null, x: i32) => i32 = deliver()
print(va((x: i32) => x + 1, 2) * 10 + va(null, 5))
const vu = deliver()
print(vu((x: i32) => x + 1, 2) * 10 + vu(null, 5))
function deliverH() { return h }
const vh: (f: (x: i32) => i32, x: i32) => i32 = deliverH()
print(vh((x: i32) => x + 1, 2) * 10 + vh((x: i32) => x, 5))

function sk<T>(x: T, y: string | null): T {
  if y != null { print(y) } else { print("none") }
  x
}
type P = { a: i32 }
function rk<T>(x: T, y: P | null): T {
  if y != null { print(y.a) } else { print("none") }
  x
}
function deliverS() { return sk }
function deliverR() { return rk }
const vs = deliverS()
const vr = deliverR()
print(vs(1, "s"))
print(vs(2, null))
print(vr(3, { a: 9 }))

function written() {
  let w = h
  w = h
  print(w((x: i32) => x + 1, 2))
  let n = g
  n = g
  print(n((x: i32) => x + 1, 2))
  let m = g
  m = g
  print(m((x: i32) => x + 1, 2) * 10 + m(null, 5))
  let t = g
  t = g
  print(t((x: i32) => x + 1, 2))
  print(t((s: string) => s + "!", "ab"))
}
written()
print(g(dbl, 6) + 0)
