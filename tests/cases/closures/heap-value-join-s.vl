// @run
// @log 6
// @log 4
// Sibling records holding different hole functions, `s.f` called:
// joined from two if arms into one binding, then returned.
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function mk(c: boolean) {
  const v = if c { { r: { f: inc0 }, s: { f: dbl } } } else { { r: { f: dbl }, s: { f: inc0 } } }
  return v
}
print(mk(true).s.f(3))
print(mk(false).s.f(3))
