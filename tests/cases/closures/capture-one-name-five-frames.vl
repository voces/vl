// @run
// @log 0.75
// @log 1.25
// @log s!
// @log true
// @log 101
// @log inner?
// @log 21
// @log 0.75
// @log 1.25
// @log s!
// ONE NAME, FIVE FRAMES, FIVE STORAGE CLASSES — the block-keying of `parentLetOf`'s cache.
//
// `emit_base.vl`'s `plCacheBlock` holds ONE block's `name -> binding` plan at a time, and
// `parentLetOf` / `parentLoopVarOf` rebuild it whenever the caller asks about another block.
// Every capture below resolves through that plan, so a plan served for the wrong block gives
// a capture the wrong frame's binding — and every frame here binds `v`, at a different
// storage class and a different type, so the wrong answer cannot type-check by accident.
//
// The five: a `for` loop VARIABLE (f64 element), a body `let` (string), a PARAMETER
// (boolean), the MODULE-scope `const` (i32) seen from a frame that binds no `v` of its own,
// and a nested frame whose own `v` shadows its parent's. `loopV` and `letV` run twice, after
// the frames between them have evicted the plan, so a plan that is never re-keyed is read
// rather than rebuilt.
//
// Every line proves the VALUE, not the shape: `v / 2.0` over the f64 element prints 0.75,
// which an i32 or a string field cannot produce; the module-scope cell adds 1 to 100; the
// shadowed cell multiplies 7. Sabotaged so that the cache serves the first block it ever
// built, this file is `expected (ref $type), found f64` inside `loopV` — while
// `unions/list-literal-destination-scope.vl` and its shadow twin, the two fixtures that look
// closest to this question, both still pass.

const v = 100

// The loop-variable half of the plan (`plLoopSidVal`), which shares the block key.
function loopV() {
  for v in [1.5, 2.5] {
    const f = () => v / 2.0
    print(f())
  }
}

// The `LetDecl` half, at a type no f64 field can hold.
function letV() {
  const v = "s"
  const f = () => v + "!"
  print(f())
}

// A parameter — a binding the plan does not hold at all, so the frame must answer before it.
function paramV(v: boolean) {
  const f = () => v
  print(f())
}

// No local `v`: the capture has to walk out to the module frame.
function globalV() {
  const f = () => v + 1
  print(f())
}

// Two frames one inside the other, the inner one shadowing.
function outerV() {
  const v = 7
  function innerV() {
    const v = "inner"
    const f = () => v + "?"
    print(f())
  }
  innerV()
  const g = () => v * 3
  print(g())
}

loopV()
letV()
paramV(true)
globalV()
outerV()
loopV()
letV()
