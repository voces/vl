// @run
// @warning Unused variable `flip` (prefix with `_` to suppress, or remove it)
// @log I
// @log 3
// @log I
// @log true
// A call through an alias of a cell's read and a return at another type: the return stores the
// instance at the function's declared return type (D3948, D3975).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function mk(): (b: boolean) => void {
  let k = inner
  const flip = () => {
    k = other
  }
  const r = k
  r(3)
  return r
}
mk()(true)
