// @error member access '.length' on non-object i32 (the body of `bad` at the call's argument types)
// @error member access '.length' on non-object i32 (the body of `bad` at the call's argument types)
// @error member access '.length' on non-object i32 (the body of `bad` at the call's argument types)
// @error member access '.length' on non-object i32 (the body of `bl` at the call's argument types)
// @error member access '.length' on non-object i32 (the body of `bl` at the call's argument types)
// An un-annotated function or lambda delivered at a function type is judged at that type's
// parameters, as a direct call is: a member read the parameter type lacks is refused at the
// delivery (D8980), and a delivery of the same lambda at a type that has it is not.
function bad(s) { return s.length > 1 }
const _f: (a: i32) => boolean = bad
const g = bad
print([1, 2].filter(g).length)
function h(k: (a: i32) => boolean): boolean { return k(3) }
print(h(bad))
const bl = (s) => s.length > 1
const _b: (a: i32) => boolean = bl
print(["ab"].filter(bl).length)
print(h(bl))
