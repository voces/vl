// @run
// @log 2
// @log 6
// @log 10
// @log 10
// @log 6
// @log 10
// @log 3
// @log 6
// @log 12
// A list of two functions handed to a callback taking a closed function type, by `.map`, by
// an element argument or by a `for` loop, calls the member each element holds; un-annotated
// and annotated members alike.
function inc(a) { return a + 1 }
function dbl(a) { return a * 2 }
function ap(r: (a: i32) => i32) { return r(5) }
const fs = [inc, dbl]
print(fs[0](1))
const ys = fs.map(ap)
print(ys[0])
print(ys[1])
print(ap(fs[1]))
for f in fs { print(ap(f)) }
function inc2(a: i32) { return a + 2 }
function tri(a: i32) { return a * 3 }
function ap4(r: (a: i32) => i32) { return r(4) }
const gs = [inc2, tri]
print(gs[0](1))
const zs = gs.map(ap4)
print(zs[0])
print(zs[1])
