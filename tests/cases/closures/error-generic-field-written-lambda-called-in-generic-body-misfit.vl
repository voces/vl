// @error a call through `r.f` passes i32 to a function written there that takes `string` (parameter `v` of `g`)
// A call through a record field inside a generic body is judged at each instance (D12238).
function pick<A, B>(a: A, b: B): A { return a }
const r = { f: pick }
r.f = (x, y: string) => x
function g<T>(v: T): T { return r.f(v, v) }
print(g(1))
