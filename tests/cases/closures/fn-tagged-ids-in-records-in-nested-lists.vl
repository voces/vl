// A list of lists of records whose field is a list of un-annotated functions holds their ids, at
// any depth, inline or through a `const`, beside other lists and records of the set (D15220).
function inc0(a) { return a + 1 }
function inc2(a) { return a + 2 }
const rss = [[{ fs: [inc0] }]]
print(rss[0][0].fs[0](3))
const deep = [[[{ fs: [inc0] }]]]
print(deep[0][0][0].fs[0](3))
const lists = [[{ fs: [[inc0]] }]]
print(lists[0][0].fs[0][0](3))
const r = { fs: [inc0] }
const viaRecord = [[r]]
print(viaRecord[0][0].fs[0](3))
const rs = [{ fs: [inc0] }]
const viaList = [rs]
print(viaList[0][0].fs[0](3))
const two = [[{ fs: [inc0] }], [{ fs: [inc2, inc0] }]]
print(two[1][0].fs[0](3))
print(two[0][0].fs[0](3))
const inner = [{ xs: [{ fs: [inc0] }] }]
print(inner[0].xs[0].fs[0](3))
function local() {
  const ls = [[{ fs: [inc0] }]]
  print(ls[0][0].fs[0](3))
}
local()
