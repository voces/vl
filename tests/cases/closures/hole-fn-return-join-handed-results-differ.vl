// @run
// @hint Intentionally-unused parameter `_a` (leading `_` marks it unused)
// @log 4
// The result of a function whose returns join un-annotated functions, handed to a callee that
// calls it, dispatches in the callee's instance (D13965, D16094).
function inc(a) { return a + 1 }
function str(_a) { return "s" }
function sel(c: boolean) {
  if c { return str }
  return inc
}
function ap(f, x) { return f(x) }
print(ap(sel(false), 3))
