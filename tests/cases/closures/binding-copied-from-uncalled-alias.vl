// @run
// @log aa
// @log 4
// @log 8
// @info `d2` is never reassigned; use `const` instead of `let`
// @info `d4` is never reassigned; use `const` instead of `let`
// @hint redundant type annotation: `rw2` is inferred as `i32` — remove it to lean on inference
// @warning Unused variable `d5` (prefix with `_` to suppress, or remove it)
// A binding's signature comes from the calls through it. `d1` is called only at `i32`, and the
// value written to it is read through `d3`, which no call goes through: `d3`'s lambda `c` takes
// `d1`'s signature there, though `c` is called at `string` through `d2` (review of #3465).
const x = "a"
const n = 4
const c = (y) => y + y
const g = (y) => y
let d1 = g
let d2 = c
print(d2(x))
let d3 = c
let i1 = 0
while i1 < 2 { d3 = d3; i1 = i1 + 1 }
function rw2(): i32 { const r = d1(n); d1 = d3; r }
print(rw2())
let d4 = d2
let d5 = d1
print(d4(n))
