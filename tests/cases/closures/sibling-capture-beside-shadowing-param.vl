// @run
// @log a
// @log 5
// @log a
// @log a
// @log b
// @log a
// @log z
// @log 5
// @log z
// @log a
// @log 7
// @hint Intentionally-unused parameter `_a` (leading `_` marks it unused)
// D3025 — a nested function calling a sibling that captures a name forwards the sibling's
// binding, not its own parameter of that name, whether the outer binding is a local or a
// parameter and whatever the parameter's type.
function main() {
  const g = "a"
  function k() { print(g) }
  function inner(g: i32) {
    k()
    print(g)
  }
  inner(5)
  print(g)
}
main()
function viaParam(g: string) {
  function k() { print(g) }
  const inner = (g: string) => {
    k()
    print(g)
  }
  inner("b")
  print(g)
}
viaParam("a")
function writes() {
  let g = "a"
  function k() { g = "z" }
  function inner(g: i32) {
    function m() { k() }
    m()
    print(g)
  }
  function show() { print(g) }
  k()
  show()
  inner(5)
  print(g)
}
writes()
function loop() {
  for g in ["a"] {
    function k() { print(g) }
    function inner(_a: i32, g: i32) {
      k()
      print(g)
    }
    inner(0, 7)
  }
}
loop()
