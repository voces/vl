// @run
// @hint redundant type annotation: `inc` is inferred as `i32` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// @log 3
// @log 3
// @log s
// @log t
// @log 6
// @log 3
// A list of a generic pushed a fixed-type function and handed back by an un-annotated function
// into a binding that fixes its element, beside calls of the generic itself at another type that
// cannot reach the list, runs; so does a closed binding of one element (D10151).
function id<T>(x: T): T { x }
function inc(x: i32): i32 { x + 1 }
const ys = [id]
ys.push(inc)
function deliver() { return ys }
print(id("s").length + 2)
const v: ((x: i32) => i32)[] = deliver()
print(v[1](2))
print(id("s"))
const zs = [id]
zs.push(inc)
const f: (x: i32) => i32 = zs[0]
print(id("t"))
print(f(6))
const xs: ((x: i32) => i32)[] = zs
print(xs[1](2))
