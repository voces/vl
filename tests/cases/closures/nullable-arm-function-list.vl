// @run
// @log -1
// @log 3
// @log 3
// @log 5
// @log true
// @log -1
// D3108: an un-annotated list of function values over a union arm is called at the arm's
// signature, nullable or not, at the parameter, at the result and held in a record field.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
const f = (w: Circle | null): i32 => if w == null { 0 - 1 } else { w.r }
const fs = [f]
print(fs[0](null))
print(fs[0]({ r: 3 }))
const h = (w: Circle): i32 => w.r
const hs = [h]
print(hs[0]({ r: 3 }))
const mk = (n: i32): Circle | null => if n == 0 { null } else { { r: n } }
const ms = [mk]
const x = ms[0](5)
if x != null { print(x.r) }
print(ms[0](0) == null)
const o = { hs: [f] }
print(o.hs[0](null))
