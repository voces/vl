// @error a list is passed as the same storage, so its element type cannot differ between `zs` and this destination
// A rebind keeps the binding's one storage type, so deliveries at two closed element types on
// either side of it are refused by the container contract (D17735).
function id<T>(x: T): T { return x }
function inc(x: i32) { return x + 1 }
function runS(a: ((x: string) => string)[]) { print(a[1]("s")) }
function runI(a: ((x: i32) => i32)[]) { print(a[1](2)) }
function f() {
  let zs = [id]
  zs.push(inc)
  runI(zs)
  zs = [id, id]
  runS(zs)
}
f()
