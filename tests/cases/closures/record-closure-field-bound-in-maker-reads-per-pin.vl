// @run
// @log true
// @log 7
// @log y
// @log 7
// D2853: a record with a closure field, bound to a `const` in a hole-parameter maker and
// returned, reads the closure's result at each pin's own type; a literal-set pin's plain
// field prints its member.
function mk(x) {
  const r = { f: x, g: () => x }
  return r
}
print(mk(true).g())
print(mk(7).g())
type K = "x" | "y"
const k: K = "y"
print(mk(k).f)
print(mk(7).f)
