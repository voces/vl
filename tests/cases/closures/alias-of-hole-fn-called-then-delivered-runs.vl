// @run
// @log 4
// @log 5
// @log 4
// @log 3.5
// An un-annotated alias of an un-annotated function, called directly before it is handed on as a
// value, calls the function's instance by name, as it does when the hand-on comes first (D16420).
function inc(t) { return t + 1 }
function app(g, v) { return g(v) }
const f = inc
print(f(3))
print(app(f, 4))
const k = inc
print(k(3))
print(k(2.5))
