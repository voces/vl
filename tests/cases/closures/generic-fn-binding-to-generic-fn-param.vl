// @run
// @log 3
// @log 4
// @log s
// @info `f` is never reassigned; use `const` instead of `let`
// A `let` or `const` bound once to a generic function and handed to a generic higher-order
// parameter takes the instance the value arguments bind (D4310).
function idg<T>(t: T): T { return t }
function app<T>(g: (x: T) => T, v: T): T { return g(v) }
let f = idg
const c = idg
print(app(f, 3))
print(app(c, 4))
print(app(c, "s"))
