// @run
// @log B
// @log true
// @log B
// @log false
// A list holding a written `let` of generics takes the type its element calls give it, and so
// does every value of the `let`, though no call of the `let` itself fixes one (D3978).
function gA<U>(u: U) {
  print("A")
  print(u)
}
function gB<V>(v: V) {
  print("B")
  print(v)
}
function main() {
  let x = gA
  x = gB
  const y = [x]
  y[0](true)
  y[0](false)
}
main()
