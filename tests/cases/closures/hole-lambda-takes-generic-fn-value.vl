// @run
// @log -4
// @log -4
// @log -5
// @log -2.5
// @log 8
// @log s
// @log 3
// @log -9
// @log -4
// @log -4
// D5751: a generic handed to an un-annotated parameter of a `const` lambda is instanced at the
// arguments that lambda's body calls it with, once per call of the lambda: through a second
// lambda, at two types, two functions, two calls in one body, an alias and a local binding.
function neg(a) { return 0 - a }
function dbl(a) { return a + a }
function id(a) { return a }
const lap = (g, x) => g(x)
const via = (h, y) => lap(h, y)
const both = (g, x, y) => g(x) + g(y)
print(lap(neg, 4))
print(via(neg, 4))
print(lap(neg, 5))
print(lap(neg, 2.5))
print(lap(dbl, 4))
print(lap(id, "s"))
print(lap(id, 3))
print(both(neg, 4, 5))
const n = neg
print(lap(n, 4))
function main() {
  const lapIn = (g, x) => g(x)
  print(lapIn(neg, 4))
}
main()
