// @run
// @log 6
// @log 6
// @log 2
// @log 6
// @log 1.5
// @log hi?
// A `?.` call through a record nested in a map's entry, beside a declared record of the field's
// name, runs at the call's own signature (D16830).
type G = { f0: (a: i32) => i32 }
function dbl(a) { return a * 2 }
function inc1(a) { return a + 1 }
const m = Map()
m.set("a", { r: { f0: inc1 } })
m.set("b", { r: { f0: dbl } })
const t = m.get("b")?.r
print(t?.f0(3) ?? 0)
print(m.get("b")?.r.f0(3) ?? 0)
function inc0(a: i32) { return a + 1 }
const q = { f0: inc0 }
print(q.f0(1))
type H = { g: (a: f64) => f64 }
function twice(a) { return a * 2.0 }
function halve(a) { return a / 2.0 }
const n = Map()
n.set("a", { r: { g: halve } })
n.set("b", { r: { g: twice } })
print(n.get("b")?.r.g(3.0) ?? 0.0)
print(n.get("z")?.r.g(3.0) ?? 1.5)
type S = { h: (a: string) => string }
function ex(a) { return a + "!" }
function qu(a) { return a + "?" }
const o = Map()
o.set("a", { r: { h: ex } })
o.set("b", { r: { h: qu } })
print(o.get("b")?.r.h("hi") ?? "none")
