// @run
// @log 1
// @log 3
// @log 0
// @hint redundant type annotation: `inc` is inferred as `i32`
// A module-GLOBAL nullable closure whose annotation names the closure through a declared
// ALIAS (`type F = (i32) => i32`, then `F | null`) — the DECLARATION half of the alias
// blindness whose `is`-TEST half `nullable-closure-is-alias-name.vl` pins.
//
// `globalCellKind`'s kind-19 arm asked `nulCloFlag`, whose arena leg wants `TyNullable` over
// a `TyFunc` and whose name leg wants an arrow in the spelling. An arrow-bodied `type N = …`
// is parsed as a ONE-MEMBER `UnionDecl`, so the annotation arrives as
// `TyNullable(TyUnion[TyFunc])` and BOTH legs answered no: the cell fell through to the
// default i32 while the start function stored a closure struct into it — a silent
// `type mismatch: expected i32, found (ref $type)` at instantiation, for a program with no
// read of the binding at all. `tyDenotesFunc` peels the degenerate one-member wrapper (a
// one-member union has nothing to discriminate; it denotes its member), so the alias and the
// inline arrow classify the same.
//
// The three observations are the three shapes that reached the cell: a write with no read
// (the miscompile's minimal form), a narrowed CALL through the global, and a null cell.

type F = (i32) => i32

function inc(a: i32): i32 { a + 1 }

const h: F | null = inc

// No read of `h` at all — the cell's valtype is the whole defect.
print(1)

if h is (i32) => i32 { print(h(2)) } else { print(0) }

const g: F | null = null
if g != null { print(1) } else { print(0) }
