// @run
// @log 2
// @log 2.5
// @log 3
// @log s
// @log 2
// @log 2.5
// @log 3
// @log 3.5
// A record field holding one un-annotated function, written that function again, is read back and
// called at two types: the field is a slot whose type holds the set, as a list's element is (D15117).
function id0(a) { return a }
function inc(a) { return a + 1 }
const r = { f: id0 }
r.f = id0
const g = r.f
print(g(2))
print(g(2.5))
function run() {
  const q = { f: id0, n: 1 }
  q.f = id0
  print(q.f(3))
  print(q.f("s"))
}
run()
const rs = [{ f: id0 }]
rs[0].f = id0
print(rs[0].f(2))
print(rs[0].f(2.5))
const w = { a: { f: inc } }
const al = w
al.a.f = inc
print(w.a.f(2))
print(w.a.f(2.5))
