// @run
// @warning Unused parameter `a`
// @warning Unused parameter `a`
// @log 2
// @log 9
// @log 2
// @log 5
// @log 2
// @log 5
// @log 6
// @log 2
// @log 2
// @log 4
// A hole function handed to a list of functions that a later call pushes a lambda onto takes the
// type every call binds its hole to, at a loop the walk reaches first and at one it reaches
// after the push: in a function, and at the top level between two loops (D12940).
function snd(a, b) { return b }
function apply2(g) { print(g("x", 2)) }
const fs = [apply2]
function add(k) {
  fs.push((g) => {
    print(g("z", k))
  })
}
add(9)
for f in fs { f(snd) }

const hs = [apply2]
function more(k) {
  hs.push((g) => {
    print(g("z", k))
  })
}
function go() {
  for f in hs { f(snd) }
}
more(5)
go()
more(6)
go()

function last(a, b) { return b }
function applyLast(g) { print(g("x", 2)) }
const ls = [applyLast]
for f in ls { f(last) }
function put(k) {
  ls.push((g) => {
    print(g("z", k))
  })
}
put(4)
for f in ls { f(last) }
