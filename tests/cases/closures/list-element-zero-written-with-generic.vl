// @run
// @log I
// @log 3
// @log I
// @log true
// A list of one generic whose element 0 is written with another generic: the written value is
// instanced at the element's one call, not at an instance another list's call made.
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
const gs = [inner]
gs[0](3)
const fs = [other]
fs[0] = inner
fs[0](true)
