// @run
// @log 5 2.5
// @log 5 2.5
// @log 5 2.5
// @log 5 2.5
// @log 5 3.5
// @log 9 6.5
// @log 5 2.5
// @log 6 3.5
// @hint Intentionally-unused variable `_a`
// @hint Intentionally-unused variable `_b`
// A `const` holding a returned record of one closure per signature, stored into a field, an
// element or a map value: the slot holds the record whole, as a call stored there directly does.
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
const u = lap((a) => a + 1)
print("\{u(4)} \{u(1.5)}")
const w = { f: u }
print("\{w.f(4)} \{w.f(1.5)}")
const p = lap((a) => a + 1)
const xs = [p]
const v = xs[0]
print("\{v(4)} \{xs[0](1.5)}")
const q = lap((a) => a + 1)
const m = Map()
m["a"] = q
const x = m["a"]
if x != null { print("\{x(4)} \{x(1.5)}") }
const r = lap((a) => a + 1)
const z = { f: r, g: lap((a) => a + 2) }
print("\{z.f(4)} \{z.g(1.5)}")
const s = lap((a) => a + 1)
const y = { f: s }
y.f = lap((a) => a + 5)
print("\{y.f(4)} \{y.f(1.5)}")
const t = lap((a) => a + 1)
const o = { f: t }
const c = o.f
print("\{c(4)} \{c(1.5)}")
function run(k: i32) {
  const h = lap((a) => a + k)
  const hs = [h, h]
  print("\{hs[0](4)} \{hs[1](1.5)}")
}
run(2)
