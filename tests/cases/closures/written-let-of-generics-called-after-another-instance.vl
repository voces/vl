// @run
// @log I
// @log 3
// @log I
// @log true
// @log I
// @log 3
// @log I
// @log s
// @log O
// @log 1
// @log I
// @log 2
// @log I
// @log 3
// @log I
// @log 1.5
// A written `let` holding generic functions, called after another instance of one of them exists,
// instances each function written at the call's type rather than reusing that instance (D3979).
function inner<U>(u: U) {
  print("I")
  print(u)
}
function other<V>(v: V) {
  print("O")
  print(v)
}
function boolAfterI32() {
  inner(3)
  let f = other
  f = inner
  f(true)
}
function stringAfterI32() {
  inner(3)
  let f = other
  f = inner
  f("s")
}
function mutateThenRead() {
  let f = other
  f(1)
  f = inner
  f(2)
}
function floatAfterI32() {
  inner(3)
  let f = other
  f = inner
  f(1.5)
}
boolAfterI32()
stringAfterI32()
mutateThenRead()
floatAfterI32()
