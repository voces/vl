// @emit-error monomorphize: `a` is called at two instances of the function handed to it
// A list of a hole parameter handed on whole escapes the split (D9653): what reads it there is
// not a call at a literal index, so the parameter keeps one instance and the two calls refuse.
function id<T>(x: T): T { x }
function use(ys) { print(ys.length) }
function take(a) {
  const xs = [a]
  use(xs)
  print(xs[0]("abc").length + xs[0](2))
}
take(id)
