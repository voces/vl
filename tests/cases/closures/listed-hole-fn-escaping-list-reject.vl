// @emit-error on a receiver the emitter cannot classify
// A list of a hole parameter handed on whole is not the parameter's per-instance set: what reads
// it there is not a call at a literal index, so the list holds closures of one signature and the
// two calls refuse (D15010).
function id<T>(x: T): T { x }
function use(ys) { print(ys.length) }
function take(a) {
  const xs = [a]
  use(xs)
  print(xs[0]("abc").length + xs[0](2))
}
take(id)
