// @run
// @warning Unused parameter `a`
// @warning Unused variable `i`
// @log x2
// @log 2
// @log y20
// @log 20
// @log 0
// @log x2
// @log 2
// @log 1
// @log y20
// @log 20
// The D12703 witness and a shadowed index: a loop that names its index reads the copy at that
// index, even where the body declares another binding of the same name.
import { toString } from "std:fmt"

function cat(a, b) { return a + b.toString() }
function snd(a, b) { return b }
function apply2(g) { print(g("x", 2)) }
function apply3(g) { print(g("y", 20)) }
const fs = [apply2, apply3]
for f, i in fs {
  f(cat)
  f(snd)
}
for f, i in fs {
  print(i)
  if true {
    const i = 0
    f(cat)
  }
  f(snd)
}
