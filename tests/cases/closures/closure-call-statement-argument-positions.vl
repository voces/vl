// @log 30
// A closure call whose argument writes a statement (a valued `if`, a `??` or an assignment) stages
// the call's head ahead of it, as legacy writes the callee and its env first. Each argument index
// and callee kind is its own function.

function mk() {
  print("mk")
  return 2
}
function three(k: i32) {
  return (a: i32, b: i32, d: i32) => a * 100 + b * 10 + d + k
}
function two(k: i32) { return (a: i32, b: i32) => a * 10 + b + k }

function byIndex(c: boolean) {
  const f = three(0)
  print(f(if c { 1 } else { 2 }, 3, 4))
  print(f(5, if c { 6 } else { 7 }, 8))
  print(f(1, 2, if c { 3 } else { 4 }))
}
byIndex(true)

function coalesced(n: i32 | null) {
  const f = two(0)
  print(f(n ?? 9, 1))
  print(f(1, n ?? 3))
}
coalesced(null)
coalesced(4)

function assigned() {
  const f = two(0)
  let x = 0
  print(f(x = mk(), 1))
  print(f(1, x = mk()))
  print(x)
}
assigned()

function param(f: (a: i32, b: i32) => i32, c: boolean) {
  print(f(1, if c { 2 } else { 3 }))
}
param(two(100), false)

function captured(c: boolean) {
  const f = two(5)
  const g = () => f(if c { 1 } else { 2 }, if c { 3 } else { 4 })
  print(g())
}
captured(true)

type H = { f: (a: i32, b: i32) => i32 }
function field(h: H, c: boolean) { print(h.f(7, if c { 8 } else { 9 })) }
field({ f: two(0) }, true)

function result(c: boolean) { print(two(1)(4, if c { 5 } else { 6 })) }
result(false)

const top = two(0)
const flag = mk() > 1
print(top(1, if flag { 20 } else { 30 }))
