// @run
// @log 1
// @log 2
// @log 7
// @log true
// @log 7
// @log -1
// @log true
// @log false
// @log true
// @log false
// @log 7
// @log -1
// @log 7
// @log -1
// @log 4
// @log 14
// @log -2
// @log 99
// @log 7
// A context-typed lambda whose parameter is `Circle | null`, with `Circle` a union arm, takes the
// declared spelling's nullable-variant rep: its parameter is stored and read back, passed on,
// compared, tested with `is`, read through a field and handed an `as?` result.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function rad(w: Circle | null) {
  if w == null { return -1 }
  return w.r
}
function app<A>(x: A, h: (A) => i32) { return h(x) }
const keep: (Circle | null)[] = []
const st: { g: (Circle | null) => i32 } = {
  g: (w) => {
    keep.push(w)
    return keep.length
  },
}
const c: Circle = { r: 7 }
print(st.g(c))
print(st.g(null))
const k0 = keep[0]
if k0 != null { print(k0.r) }
print(keep[1] == null)
const ps: { g: (Circle | null) => i32 } = { g: (w) => rad(w) }
print(ps.g(c))
print(ps.g(null))
const eq: { g: (Circle | null) => boolean } = { g: (w) => w == c }
print(eq.g(c))
print(eq.g({ r: 8 }))
const isn: { g: (Circle | null) => boolean } = { g: (w) => w is Circle }
print(isn.g(c))
print(isn.g(null))
const mem: { g: (Circle | null) => i32 } = {
  g: (w) => if w == null { 0 - 1 } else { w.r },
}
print(mem.g(c))
print(mem.g(null))
function mkid(): (Circle | null) => Circle | null { return (w) => w }
const back = mkid()(c)
if back != null { print(back.r) }
const sh: Shape = { s: 3 }
const sc: Shape = { r: 4 }
print(mem.g(sh as? Circle))
print(mem.g(sc as? Circle))
const z: (Circle | null)[] = [{ r: 7 }, null]
for e in z {
  print(app<Circle | null>(e, (w) => if w == null { 0 - 2 } else { w.r * 2 }))
}
const fs: ((Circle | null) => i32)[] = [(w) => rad(w) + 100]
print(fs[0](z[1]))
const hs: ((Circle | null) => (Circle | null)[])[] = [(w) => [w, w]]
const t1 = hs[0](z[0])[1]
if t1 != null { print(t1.r) }
