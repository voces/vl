// @run
// @log 2
// @log 103
// @log 13
// @log s
// @log 5
// @log 4
// @log 108
// @log s
// A list element or map value of `((x: i32) => i32) | string` narrowed to its function arm is the
// closure, unboxed from its box: called, in arithmetic, passed, returned, and its string arm read.
function mk(n: i32): ((x: i32) => i32) | string {
  if n == 0 { return "s" }
  return (x: i32) => x + n
}
function call(g: (x: i32) => i32) { return g(2) + 100 }
function back(xs: (((x: i32) => i32) | string)[]) {
  if xs[0] is (x: i32) => i32 { return xs[0](10) + 2 }
  return 0
}
const xs = [mk(1), mk(0)]
if xs[0] is (x: i32) => i32 { print(xs[0](1)) }
if xs[0] is (x: i32) => i32 { print(call(xs[0])) }
print(back(xs))
if xs[1] is (x: i32) => i32 { print(xs[1](1)) } else { print(xs[1]) }
const m: {[string]: ((x: i32) => i32) | string} = Map()
m["a"] = mk(3)
m["b"] = mk(0)
if m["a"] is (x: i32) => i32 { print(m["a"](2)) }
if m["a"] is (x: i32) => i32 { print(m["a"](0) + 1) }
if m["a"] is (x: i32) => i32 { print(call(m["a"]) + 3) }
if m["b"] is (x: i32) => i32 { print(m["b"](1)) } else { print(m["b"]) }
