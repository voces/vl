// @run
// @log 1.5
// @log 1.5
// @log 1.5
// @log 1.5
// A module `let` bound and re-pointed only to a list, map or record field the check widened over
// its writes, directly or through another `let` bound to one, reads the widened element, so a call
// through it runs the written function (D15196).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const xs = [inc0]
xs[0] = half
let v = xs
v = xs
print(v[0](3))
const zs = xs
let w = xs
w = zs
print(w[0](3))
const m = Map()
m.set("a", inc0)
m.set("b", half)
let n = m
n = m
const g = n.get("b")
if g != null { print(g(3)) }
const r = { fs: [inc0] }
r.fs[0] = half
let q = r
q = r
function show() { print(q.fs[0](3)) }
show()
