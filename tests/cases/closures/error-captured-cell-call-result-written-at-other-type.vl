// @emit-error the captured binding `k` is written with a function inside a closure that every instance of
// A call result typed `(n: i32) => void` written into a cell the instance wants at boolean (review of #3498, `rv3498/z08_call_result_concrete`).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function third<Z>(z: Z) { print("T"); print(z) }
function mkf(): (n: i32) => void { return other }
function a<T>(x: T) {
  let k = inner
  const w = () => {
    k = mkf()
  }
  w()
  k(x)
}
a(1)
a(true)
