// @run
// @log 2
// @log s
// A map of records holding a generic, filled by a helper and read through `?.` as well as by a
// guarded read: a `?.` call of an entry's field is built only as a closure call, so the map is
// not a holder of the generic's ids.
function id<T>(x: T): T { x }
function fill(mm) { mm["k"] = { f: id } }
const a = Map()
fill(a)
print(a["k"]?.f(2) ?? 0)
const ar = a["k"]
if ar != null { print(ar.f("s")) }
