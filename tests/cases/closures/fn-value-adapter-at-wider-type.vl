// @run
// @log 1
// @log 7
// @log 8
// @log 9
// @log 12
// @log 7
// @log 7
// @log 5
// D3073: a function value delivered where a function type of another rep is expected is
// called through an adapter at that type, which converts its result and its arguments. A
// `let` is read once at the delivery, so a later store does not reach the adapter.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function mkf(x: Circle[]): () => readonly Shape[] {
  const g = () => x
  return g
}
function mkC(): Circle { return { r: 7 } }
function mkC2(): Circle { return { r: 8 } }
function area(s: Shape) {
  if s is Circle { return s.r }
  0
}
function add(a: Shape, n: i32) { return area(a) + n }
function outer(): () => Circle { return mkC }
function run(f: () => Shape) { return area(f()) }
type Holder = { get: () => Shape }

print(mkf([{ r: 1 }])().length)
const f1: () => Shape = mkC
print(area(f1()))
const hs: (() => Shape)[] = [mkC2]
print(area(hs[0]()))
const byCircle: (c: Circle) => i32 = area
print(byCircle({ r: 9 }))
const plus: (c: Circle, n: i32) => i32 = add
print(plus({ r: 9 }, 3))
const nested: () => () => Shape = outer
print(area(nested()()))
function snapshot() {
  let h = mkC
  const held: Holder = { get: h }
  h = mkC2
  print(area(held.get()))
}
snapshot()
print(run(() => ({ r: 5 })))
