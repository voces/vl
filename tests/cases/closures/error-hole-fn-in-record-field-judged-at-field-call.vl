// @error member access '.length' on non-object i32 (the body of `len0` at the call's argument types)
// D13969: a record field's un-annotated function is judged at the instance the callee's call
// through that field asks, as the function handed directly is. Inline, bound to a const, as a
// list element and handed directly, each refuses `len0` at i32.
function len0(a) { return a.length }
function take0(a) { print(a.f(3)) }
function take1(a) { print(a(3)) }
function each0(v) { print(v[0].f(3)) }
take0({ f: len0 })
const r = { f: len0 }
take0(r)
each0([{ f: len0 }])
take1(len0)
