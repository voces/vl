// @run
// @log 4
// @log 1.5
// @log 5.5
// @log 1.5
// @log 4
// A function returning one of two list literals of records, whose function fields hold
// un-annotated functions returning different types: a call through the field of the returned
// list runs the member stored there, chosen at run time, directly, bound, walked and with a
// second field (D15801).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function pick(b: boolean) { if b { return [{ f: inc0 }] } return [{ f: half }] }
function pick2(b: boolean) { if b { return [{ f: inc0, n: 1 }] } return [{ f: half, n: 2 }] }
function on(i: i32) { [1, 2].length > i }
print(pick(on(1))[0].f(3))
const rs = pick(on(2))
print(rs[0].f(3))
let acc = 0.0
for b in [true, false] { for e in pick(b) { acc = acc + e.f(3) } }
print(acc)
print(pick2(on(2))[0].f(3))
print(pick2(on(1))[0].f(3))
