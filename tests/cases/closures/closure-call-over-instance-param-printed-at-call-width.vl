// @run
// @log 4
// @log 1.5
// A local closure reading an instanced function's un-annotated parameter, called with a record
// whose field is one of two functions, prints at the width its call returns (D17782).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function two() { return [1, 2].length }
function main(k, n) {
  const take = (r) => r.f(k)
  const q = if two() > n { { f: half } } else { { f: inc0 } }
  print(take(q))
}
main(3, 5)
main(3, 1)
