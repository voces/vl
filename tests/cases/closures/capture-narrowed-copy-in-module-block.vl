// @run
// @log 3
// @log 3
// @log 3
// @log 4
// @log 1.5
// @log 3
// @log 3
// @log 3

// @hint redundant type annotation: `r` is inferred as `i32`

// A lambda capturing a copy of a narrowed binding stores the copy at its narrowed type, in a
// block at module scope and in a function frame, for a record and for a scalar (D6730, D6771).

function q(): { n: i32 } | null { return { n: 3 } }
function qi(): i32 | null { return 3 }
function qf(): f64 | boolean { return 1.5 }

if true {
  const mw = q()
  if mw != null {
    const v = mw
    const g = () => v
    print(g().n)
  }
}

if true {
  const mw = qi()
  if mw != null {
    const v = mw
    const g = () => v
    print(g())
  }
}

function inFrame() {
  const mw = qi()
  if mw != null {
    const v = mw
    const g = () => v
    print(g())
  }
}
inFrame()

if true {
  const mw = qi()
  if mw != null {
    const v = mw
    const g = () => v
    const r: i32 = g()
    print(r + 1)
  }
}

function mk(): () => f64 {
  const u = qf()
  if u is f64 {
    const v = u
    return () => v
  }
  return () => 0.0
}
print(mk()())

function mkG<T>(u: T | null, d: T): () => T {
  if u != null {
    const v = u
    return () => v
  }
  return () => d
}
print(mkG(3, 0)())

if true {
  const w = qf()
  if w is f64 {
    const v = w
    const g = () => v
    print(g() * 2.0)
  }
}

type R = { name: string, n: i32 }
function getR(): R | null { { name: "ada", n: 3 } }
if true {
  const mw = getR()
  if mw != null {
    const v = mw
    const g = () => v
    print(g().n)
  }
}
