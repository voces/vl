// @run
// @log null
// @log null
// @log null
// @log null
// A write used as a value into a captured never-filled `let x = null` whose right side is a call
// typed `null` yields that `null`, read back from the cell, as the literal's spelling does.
function same<T>(v: T): T { return v }
function nul() { return null }
function f() {
  let x = null
  const g = () => x
  print(x = same(null))
  print(g())
}
function h() {
  let y = null
  const k = () => y
  print(y = nul())
  print(k())
}
f()
h()
