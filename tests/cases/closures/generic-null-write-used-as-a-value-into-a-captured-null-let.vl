// @run
// @log null
// @log null
// A write used as a value into a captured never-filled `let x = null` whose right side is a
// `null`-returning call stores and yields that `null`, as the `null` literal's spelling does
// (D17221, D17303).
function same<T>(v: T): T { return v }
function f() {
  let x = null
  const g = () => x
  print(x = same(null))
  print(g())
}
f()
