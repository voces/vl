// @emit-error the captured binding `k` is written with a function inside a closure that every instance of
// The same, at i32 and string (review of #3498, `rv3498/e17_shared_writer_hole_lambda_i32_str`).
function inner<U>(u: U) { print("I"); print(u) }
function a<T>(x: T) {
  let k = inner
  const w = () => {
    k = (u) => {
      print("L"); print(u)
    }
  }
  k(x)
  w()
  k(x)
}
a(1)
a("s")
