// @run
// @log 6
// @log 4
// @log 8
// A returned binding of a call's record, beside a record of another set decided with it, shares
// the joined row, while a declared record of the same layout keeps its own (D15560).
type R = { fs: i32[] }
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function mk() { return { fs: [dbl] } }
function pick(b) {
  const c = mk()
  const a = { fs: [inc0] }
  if b { return a }
  return c
}
const r: R = { fs: [7, 8] }
print(pick(false).fs[0](3))
print(pick(true).fs[0](3))
print(r.fs[1])
