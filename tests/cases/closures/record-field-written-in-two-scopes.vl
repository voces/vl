// @run
// @log A
// @log 3
// @log A
// @log 4
// @log 2
// @log A
// @log x
// A record field written with a generic under an `if`, read through an alias, and a second
// record's field written from another function each take the type their own calls give (D4700).
function gA<U>(u: U) {
  print("A")
  print(u)
}
function gC<W>(w: W) {
  print("C")
  print(w)
}
function main() {
  const y = { h: gC, n: 2 }
  if y.n > 1 { y.h = gA }
  y.h(3)
  const z = y
  z.h(4)
  print(y.n)
}
main()
const t = { h: gC }
function set() { t.h = gA }
set()
t.h("x")
