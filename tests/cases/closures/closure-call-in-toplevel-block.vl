// @run
// @log 2
// @log 3
// @log 4
// @log 5
// @hint redundant type annotation: `inc` is inferred as `i32`
// @hint redundant type annotation: `h` is inferred as `(i32) -> i32`
// A function-VALUE call nested inside a TOP-LEVEL `if` / `while` body.
//
// A `call_ref` stages its fat pointer in `callRefSlot`, and the start function reserved that
// frame only for a call it found in a BARE top-level statement: `startFnDetectScratch`'s
// statement loop ran `blockHasCallRef` in the `else` arm alone, while an `if`/`while`/`for`
// statement went to `startScanIf`/`startScanBlock` — walkers that carry every OTHER scratch
// detector and not this one. So the start function emitted `local.set 0` against a local it
// never declared: `unknown local 0: local index out of bounds`, silent invalid wasm for a
// program the checker accepts. The detector now runs over the WHOLE statement, which is where
// it belongs — `blockHasCallRef` recurses into an `if`/`while`/`for` body itself.
//
// Four shapes, one per way the frame can be reached from a top-level block: a declared
// closure binding, a lambda, a nullable closure narrowed by `is` (whose narrowing form is
// exactly the one `!= null` does NOT cover, because `!=` on a closure reserves a DIFFERENT
// two-slot frame that happened to make the bad index in-bounds), and a `while` body.

function inc(a: i32): i32 { a + 1 }

const h: (i32) => i32 = inc
if 1 == 1 { print(h(1)) }

const lam = (x: i32) => x + 1
if 1 == 1 { print(lam(2)) }

const n: ((i32) => i32) | null = inc
if n is (i32) => i32 { print(n(3)) }

let i = 0
while i < 1 {
  print(h(4))
  i = i + 1
}
