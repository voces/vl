// @run
// @warning Unused parameter `b` (prefix with `_` to suppress, or remove it)
// @log 3
// @log x
// A generic and a closed function sharing a function type parameter, the generic's parameter
// called at two types (D15464).
function go<F>(a: F, b: F) {
  print(a(3))
  print(a("x"))
}
function same<T>(k: T): T { k }
function con(x: i32) { x }
go(same, con)
