// @run
// @hint Intentionally-unused parameter `_a` (leading `_` marks it unused)
// @log s
// @log s
// @log s
// @log s
// @log s
// @log s
// @log 4
// @log 5
// @log 5
// @log 8
// @log 5
// @log 7
// A choice of un-annotated functions whose results differ, called through an open parameter and
// handed to a parameter whose function type admits each result, dispatches there (D17098).
function inc(a) { return a + 1 }
function str(_a) { return "s" }
function ap(g, x) { return g(x) }
function idk(t: (a: i32) => i32 | string): (a: i32) => i32 | string { return t }
function useK(k: (a: i32) => i32 | string) { print(k(4)) }
function useK2(n: i32, k: (a: i32) => i32 | string) { print(k(n)) }
function useO(k: ((a: i32) => i32 | string) | null) {
  if k != null { print(k(6)) }
}
function run(c: boolean) {
  const g = if c { str } else { inc }
  print(ap(g, 3))
  useK(g)
  useK(g)
  useK2(7, g)
  useK(idk(g))
  useO(g)
}
run(true)
run(false)
