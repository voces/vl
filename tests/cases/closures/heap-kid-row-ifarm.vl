// @run
// @log 4
// @log 6
// A function handed to a hole parameter that a returned record holds one record down:
// returned from either branch of an if.
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function mk2(f, c: boolean) {
  if c { return { r: { f: f } } }
  return { r: { f: f } }
}
print(mk2(inc0, true).r.f(3))
print(mk2(dbl, false).r.f(3))
