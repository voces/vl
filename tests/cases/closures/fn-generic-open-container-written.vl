// @run
// @log 1.5
// @log 3
// @log 6
// @log ss
// @log 1.5
// @log 3
// @log 4
// @log 2
// An open map or list written generics of different result types, by `set`, by index or by
// `push`: the writes join the container's set as non-generic functions' do, so a value read back
// and called runs the generic stored there (D15160).
function id<T>(x: T): T { return x }
function half<T>(x: T): f64 { return x / 2.0 }
function twice<T>(x: T): T { return x + x }
const m = Map()
m.set("a", id)
m.set("b", half)
const g = m.get("b")
if g != null { print(g(3)) }
const h = m.get("a")
if h != null { print(h(3)) }
const n = Map()
n["a"] = id
n["b"] = twice
const t = n.get("b")
if t != null {
  print(t(3))
  print(t("s"))
}
const xs = []
xs.push(id)
xs.push(half)
print(xs[1](3))
print(xs[0](3))
const w = Map()
w.set("a", id)
w.set("b", half)
for k, v in w { print(v(4)) }
