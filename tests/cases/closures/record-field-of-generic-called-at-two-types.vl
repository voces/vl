// @log 10
// @log 1
// @log 10
// @log s
// A record field holding one generic is called through the field at each call's own
// instance (D4242), at top level, inside a function beside a concrete field, and when the
// generic captures a local.
function gC<W>(w: W) {
  print("C")
  print(w)
}
const y = { h: gC }
y.h(2)
y.h(true)
function id<T>(x: T): T { x }
const r = { f: id }
print(r.f(1))
print(r.f("s"))
function local() {
  const q = { f: id, n: 3 }
  print(q.f(41) + q.n)
  print(q.f("a") + "b")
}
local()
function captures() {
  const base = 10
  function add<T>(x: T): T {
    print(base)
    x
  }
  const c = { f: add }
  print(c.f(1))
  print(c.f("s"))
}
captures()
