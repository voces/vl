// @run
// @log 6
// @log 4
// @log 4
// @log 4
// @log 6
// @log 10
// @warning Container `b2` is written but never read (remove it)
// A `??` over a global copy of a map read of a list of un-annotated functions holds the copy's
// closed type, so an element of the joined list is called at that signature (D17057, D17058).
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
let b2 = [inc0, dbl]
b2 = [dbl]
const m4 = Map()
m4["k"] = [inc0, dbl]
const mv4 = m4["k"]
if mv4 != null {
  const v4 = mv4
  print(v4.map((f) => f(3))[1])
} else {
  print("none")
}
const got = mv4 ?? [inc0]
print(got[0](3))
const absent = m4["absent"]
const dflt = absent ?? [inc0]
print(dflt[0](3))
const chained = absent ?? mv4 ?? [dbl]
print(chained[0](3))
const paren = (mv4) ?? [inc0]
print(paren[1](3))
for f in got {
  if f(5) > 6 { print(f(5)) }
}
