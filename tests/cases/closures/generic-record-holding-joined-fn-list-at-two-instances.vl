// A generic function's record holding a tagged set beside a field at its type parameter is built
// at a row per instance, which a binding of each call reads, and shared by a second maker of the same record (D15554).
function id(a) { return a }
function mk<T>(x: T) { return { fs: [id], x: x } }
const r = mk(1)
const s = mk("s")
print(r.fs[0](2))
print(s.fs[0]("q"))
function mkF<T>(x: T) { return { f: id, x: x } }
const t = mkF(1)
print(t.f(3))
print(t.f("q"))
print(t.x)
function mkH(x) { return { fs: [id], x: x } }
const u = mkH(1)
const v = mkH("s")
print(u.fs[0](2))
print(v.fs[0]("q"))
print(v.x)
function mkG(x) { return { fs: [id], x: x } }
const w = mkG(1)
const z = mkG("s")
print(w.fs[0](2))
print(z.fs[0]("q"))
