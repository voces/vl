// @run
// @log 4
// @log 3
// @log 4
// @log 3.5
// @log 3
// @log 4
// @log k
// @info `m` is never reassigned
// @info `gm` is never reassigned
// @info `r` is never reassigned
// @info `a` is never reassigned
// @info `ra` is never reassigned
// @info `c` is never reassigned
// @info `u` is never reassigned
// A `let` map or record of un-annotated or generic functions takes its value type from the
// calls, when nothing reassigns it or each write stores another binding of the same type (D9101).
function inc0(a) { return a + 1 }
function id<T>(a: T): T { return a }
let m = Map()
m["k"] = inc0
const x = m["k"]
if x != null { print(x(3)) }
let gm = Map()
gm["k"] = id
const gx = gm["k"]
if gx != null { print(gx(3)) }
let r = { m: Map() }
r.m["k"] = inc0
const rx = r.m["k"]
if rx != null { print(rx(3)) }
let a = Map()
a["k"] = inc0
let b = Map()
b["j"] = inc0
b = a
const bx = b["k"]
if bx != null { print(bx(2.5)) }
const hm = Map()
hm["k"] = id
let ra = { m: hm }
let rb = { m: hm }
rb = ra
const v = rb
const vx = v.m["k"]
if vx != null { print(vx(3)) }
let c = Map()
c["k"] = inc0
const f = () => {
  const cx = c["k"]
  if cx != null { print(cx(3)) }
}
f()
let u = Map()
u["k"] = inc0
for k in u { print(k) }
