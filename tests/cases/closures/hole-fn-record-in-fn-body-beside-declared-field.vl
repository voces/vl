// @run
// @log 1.5
// @log 2.5
// @log 3.5
// @log 4
// A record of an un-annotated function bound inside a function body, beside a declared record
// type of the same field name, runs as it does at module scope (D9532). `m` and `ri` are the
// controls.
type R = { f: (a: i32) => f64 }
function half(a) { return a / 2.0 }
function fr() {
  const v = { f: half }
  print(v.f(3))
}
fr()
function fc() {
  const v = { f: half }
  const g = () => print(v.f(5))
  g()
}
fc()
const m = { f: half }
print(m.f(7))
function inc(a) { return a + 1 }
function ri() {
  const v = { f: inc }
  print(v.f(3))
}
ri()
