// @run
// @log 2
// @log t
// @log true
// @log 2
// @log 2
// @log t
// @log t
// A `const` bound to an element a list of un-annotated lambdas hands by `pop` or `get` in a
// generic's body, called at the instance's own type parameter: each instance pins the element at
// its own signature, and the alias reads take that instance's.
function run<T>(y: T) {
  const f = (a) => a
  const m = [f]
  const g = m.pop()
  if g != null { print(g(y)) }
}
run(2)
run("t")
run(true)
function both<T>(y: T) {
  const f = (a) => a
  const m = [f]
  const g = m.get(0)
  if g != null { print(g(y)) }
  print(m[0](y))
}
both(2)
both("t")
