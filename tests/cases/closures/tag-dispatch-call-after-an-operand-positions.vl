// @run
// @log i=6
// @log j=7
// @log k=<x>
// @log 1
// @log 8
// @log 10
// @log 10
// @log z
// @log 11
// @log 13
// @log top=13
// A call through a function read from a `Map()` (a tagged set of one member), after an earlier
// operand: legacy writes that operand first, then the call's set-id stash. Where a box over the
// call leads its stash the IR declines; elsewhere it stages the operand first (D17564).
import { toString } from "std:fmt"

function inc(a) { return a + 1 }
function sh(a) { return "<" + a + ">" }
const m = Map()
m["k"] = inc
const s = Map()
s["k"] = sh

function hole() {
  const f = m["k"]
  if f != null { print("i=\{f(5)}") }
}
hole()

function concatBoxed() {
  const f = m["k"]
  if f != null { print("j=" + toString(f(6))) }
}
concatBoxed()

function concatString() {
  const f = s["k"]
  if f != null { print("k=" + f("x")) }
}
concatString()

function both(a: i32, b: i32 | string) {
  print(a)
  print(b)
}
function unionArgument() {
  const f = m["k"]
  if f != null { both(1, f(7)) }
}
unionArgument()

function sum(a: i32, b: i32) { print(a + b) }
function plainArgument() {
  const f = m["k"]
  if f != null { sum(1, f(8)) }
}
plainArgument()

function listElement() {
  const f = m["k"]
  if f != null {
    const xs: (i32 | string)[] = ["a", f(9)]
    print(xs[1])
  }
}
listElement()

type R = { a: string, b: i32 | string }
function recordField() {
  const f = m["k"]
  if f != null {
    const r: R = { a: "z", b: f(10) }
    print(r.a)
    print(r.b)
  }
}
recordField()

function rightOperand() {
  const f = m["k"]
  if f != null { print(1 + f(11)) }
}
rightOperand()

const g = m["k"]
if g != null { print("top=\{g(12)}") }
