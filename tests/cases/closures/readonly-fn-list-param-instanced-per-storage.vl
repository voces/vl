// @run
// @log 4
// @log 4
// @log 2
// @log 1.5
// @log 2.5
// A function whose parameter is a readonly list of functions with a wider result is instanced per
// argument storage, so a list built at the narrower functions is read through, not copied
// (D17816): a push to the argument after a call shows through the next, beside a wide argument.
function inc(a: i32) { return a + 1 }
function dec(a: i32) { return a - 1 }
function half(a: i32) { return a / 2.0 }
type W = (x: i32) => i32 | f64
function take(z: readonly W[]) {
  for f in z { print(f(3)) }
}
const b = [inc]
take(b)
b.push(dec)
take(b)
const w: readonly W[] = [(x: i32): i32 | f64 => x / 2.0]
take(w)
type V = (x: i32) => f64 | string
function takeV(z: readonly V[], k: i32) { print(z[0](k)) }
const h = [half]
takeV(h, 5)
