// @error cannot write 'half' to 'l[].g.f': called at (i32) it returns f64, where 'inc0', also written to it, returns i32 — every function a call through 'l[].g.f' may run must return one type
// A record bound to a const and pushed inside another record literal is judged with the
// list's other records (D9470).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const l = []
l.push({ g: { f: inc0 } })
const r0 = { f: half }
l.push({ g: r0 })
print(l[1].g.f(3))
