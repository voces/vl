// @run
// @log 2
// @log 3
// @log 2
// A list literal whose element is a generic read out of a list, out of a record field or through
// a `const`, beside a fixed-type function, passed straight to a generic function, runs (D10251).
function id<T>(x: T): T { x }
function inc(x: i32) { x + 1 }
function run<U>(a: ((x: U) => U)[], u: U): U { a[0](u) }
function second<U>(a: ((x: U) => U)[], u: U): U { a[1](u) }
const xs = [id]
print(run([xs[0], inc], 2))
const w = { f: id }
print(second([w.f, inc], 2))
const g = xs[0]
print(run([g, inc], 2))
