// @run
// @log 3
// @log 4
// @log 5
// @log 6
// @log 7

// @hint redundant type annotation: `v` is inferred as `{name: string, n: i32}`
// @hint redundant type annotation: `v` is inferred as `{name: string, n: i32}`
// @hint redundant type annotation: `v` is inferred as `{name: string, n: i32}`

// D1633 — the capture classifiers resolve a name through the emit-time declared-locals
// table, the param arena, the capture set and the globals registry. A FUNCTION frame's own
// `let` is in none of them, and the env struct is typed in the type section, before any
// frame declares its locals, so every cross-frame question about one declined.

// The module-scope twin of each function below has run since D1632, which is what makes the
// scope the axis rather than the shape. Both faces are here: the annotated rebind and the
// un-annotated one failed together, so a fixture carrying only one would grade half of it.

function annotatedRebind() {
  const m: { [string]: { name: string, n: i32 } } = Map()

  m["k"] = { name: "ada", n: 3 }

  const mv = m["k"]

  if mv != null {
    const v: { name: string, n: i32 } = mv
    const g = () => v
    print(g().n)
  }
}

annotatedRebind()

function inferredRebind() {
  const m: { [string]: { name: string, n: i32 } } = Map()

  m["k"] = { name: "ada", n: 4 }

  const mv = m["k"]

  if mv != null {
    const v = mv
    const g = () => v
    print(g().n)
  }
}

inferredRebind()

// The narrowed value captured with no rebind at all: the same classifier declining one rung
// earlier, so its env field is an i32 unless the frame's own `let` resolves.
function noRebind() {
  const m: { [string]: { name: string, n: i32 } } = Map()

  m["k"] = { name: "ada", n: 5 }

  const mv = m["k"]

  if mv != null {
    const g = () => mv
    print(g().n)
  }
}

noRebind()

// A map PARAMETER rather than a frame-local one: the param arena answers for the map, and
// the READ's own binding is still a frame `let`, so the parameter is not the missing half.
function fromParam(m: { [string]: { name: string, n: i32 } }) {
  const mv = m["k"]

  if mv != null {
    const v: { name: string, n: i32 } = mv
    const g = () => v
    print(g().n)
  }
}

const src: { [string]: { name: string, n: i32 } } = Map()

src["k"] = { name: "ada", n: 6 }

fromParam(src)

// One frame inside another, so the resolver is asked about a frame that is not the module's
// immediate child.
function outer() {
  function inner() {
    const m: { [string]: { name: string, n: i32 } } = Map()

    m["k"] = { name: "ada", n: 7 }

    const mv = m["k"]

    if mv != null {
      const v: { name: string, n: i32 } = mv
      const g = () => v
      print(g().n)
    }
  }

  inner()
}

outer()
