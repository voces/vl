// @run
// @log false
// @log false
// A closure capturing a `for-in` variable over an annotated nullable-scalar list reads it at the
// list's element box (D2258), for an `i32` and an `f64` element.
function mk() {
  const xs: (i32 | null)[] = [41]
  for r in xs {
    const g = () => r
    print(g() == null)
  }
  const ys: (f64 | null)[] = [1.5]
  for r in ys {
    const g = () => r
    print(g() == null)
  }
}
mk()
