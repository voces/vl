// @run
// @log 2
// @log 1
// @log 2
// D9531: a record literal of an un-annotated function pushed onto an un-annotated list, beside a
// built value of a declared record type of the same field name whose function returns f64, is
// built at its own row, so the call through the element returns the function's i32; then the
// value of the declared type, and the list literal twin.
type R = { f: (a: i32) => f64 }
function inc0(a) { return a + 1 }
const r: R = { f: (a: i32): f64 => a / 3.0 }
const p = []
p.push({ f: inc0 })
print(p[0].f(4) / 2)
print(r.f(3))
function inc1(a) { return a + 1 }
const p1 = [{ f: inc1 }]
print(p1[0].f(4) / 2)
