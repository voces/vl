// @run
// @log 4
// @log 1
// @log 11
// @log 4
// @log 2
// @log 2
// @log 11
// @log 1.5
// An element of a readonly function-list parameter delivered at the parameter's own function type
// goes through an adapter, so the instance a narrower storage keys calls it at its own signature
// and widens the result (D17816); the wide instance's adapter is the identity.
function inc(a: i32) { return a + 1 }
function dec(a: i32) { return a - 1 }
type W = (x: i32) => i32 | f64
function take(z: readonly W[]) {
  for f in z { print(f(3)) }
  print(z.length)
  const g: W = z[0]
  print(g(10))
}
const b = [inc]
take(b)
b.push(dec)
take(b)
const w: readonly W[] = [(x: i32): i32 | f64 => x / 2.0]
const first: W = w[0]
print(first(3))
