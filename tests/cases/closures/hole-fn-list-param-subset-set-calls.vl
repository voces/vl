// A function with an un-annotated list parameter, called with lists of functions whose sets nest
// one inside another, in either order: each smaller literal is built at the larger set's ids, and
// its instance is pinned there too (D16745).
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function tri(a) { return a * 3 }
function half(a) { return a / 2.0 }
function run(xs) { print(xs[0](3)) }
function walk(xs) {
  let i = 0
  while i < xs.length {
    print(xs[i](3))
    i = i + 1
  }
}
function first(xs) { return xs[0](3) }
run([inc0, dbl])
run([dbl])
run([dbl])
run([inc0, dbl])
walk([inc0, half])
walk([half])
run([inc0, dbl, tri])
run([dbl, tri])
run([tri])
print(first([inc0, dbl]))
print(first([dbl]))
