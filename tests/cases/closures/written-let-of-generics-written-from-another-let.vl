// @run
// @hint Intentionally-unused parameter `_a`
// @hint Intentionally-unused parameter `_b`
// @log W
// @log 6
// @log false
// @log W
// @log y
// @log 3
// @log W
// @log 4
// @log true
// A written `let` given a copy of another written binding holding a generic with a fixed union
// parameter: its calls at two types and a call from a closure each take the adapted write
// (D5161).
function s<A, B>(_a: A, _b: B) { print("S") }
function w<B>(a: i32 | string, b: B) {
  print("W")
  print(a)
  print(b)
}
function main() {
  let k = s
  k = w
  let k2 = s
  k2 = k
  k2(6, false)
  k2("y", 3)
  const f = () => k2(4, true)
  f()
}
main()
