// @run
// @info `gs` is never reassigned; use `const` instead of `let`
// @log 1
// @log 2.5
// @log 2.5
// @log 3.5
// @log 3
// @log 3.5
// @log 3.5
// @log 4.5
// @log 0
// @log 3.5
// @log 1
// @log 3.5
// @log 4.5
// Two lists sharing an element, each called with a forwarded hole at its own keys: a key of
// the shared group that no element of one list calls takes that call's first slot (D13520).
function add(a, b) { return a + b }
function apply2(g, s) { print(g(s, s)) }
function apply4(g, s) { print(g(s, 2)) }
function apply5(g, s) { print(g(3, s)) }
function innerThree(k, h) {
  for f in [apply2, apply4] { f(h, k) }
}
innerThree(0.5, add)
function three(k, h) {
  for f in [apply4, apply5] { f(h, k) }
}
three(0.5, add)
// The same lists bound to a `const`, one result delivered to a binding.
function cOne(k, h) {
  const gs = [apply2, apply4]
  for f in gs { f(h, k) }
}
function cTwo(k, h) {
  const gs = [apply4, apply5]
  for f in gs { f(h, k) }
  return 0
}
cOne(1.5, add)
const r = cTwo(1.5, add)
print(r)
// A third list, bound to a `let`, sharing an element with each.
function lOne(k, h) {
  let gs = [apply5, apply2]
  for f in gs { f(h, k) }
}
lOne(0.5, add)
three(1.5, add)
