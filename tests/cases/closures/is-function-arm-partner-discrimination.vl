// @run
// @log str:fn
// @log str:other
// @log i32:fn
// @log i32:other
// @log st:fn
// @log st:other
// @log nul:fn
// @log nul:other
// @log arr:F
// @log arr:G
// @log arrstr:F
// @log arrstr:other
// @log arrfn:F
// @log arrfn:G
// A union box discriminates a FUNCTION-typed arm from every partner arm that reps
// differently, and from a second closure-ARRAY arm whose element signature differs.
//
// A function type is value-atom KIND 11 (`unMemAtomKind`), and its box tag is that kind's
// slot in the shared atom band refined by the arm's own SIGNATURE (`cloArmTagOfTy`). That
// separates it exactly from a string (kind 2), an i32 (kind 0), `null` (kind 6), a struct
// variant (a dense rank below the band) and a ref-element array (the band above), which is
// every row below.
//
// The closure-ARRAY rows are the ones worth naming: `F[] | G[]` discriminates because a
// ref-array arm tags on its interned REFLIST SLOT (`refArrSlotTag`) and a distinct element
// type interns a distinct slot, so the ELEMENT signature reaches the tag through a table of
// its own. Two BARE closure arms (`F | G`) reach the same answer through the
// signature-slot table (`cloSigTagSlot`); their pins are
// `is-two-function-arms-both-directions.vl` and
// `is-function-arm-signature-tag-receivers.vl`. THIS file is the partner-arm half those
// must not buy their answer by breaking — every row here reps differently from a closure
// and must stay decided by the atom band alone.

type F = (i32) => i32
type G = (string) => i32
type St = { a: i32 }

function pStr(x: F | string) {
  if x is F { print("str:fn") } else { print("str:other") }
  0
}

function pI32(x: F | i32) {
  if x is F { print("i32:fn") } else { print("i32:other") }
  0
}

function pStruct(x: F | St) {
  if x is F { print("st:fn") } else { print("st:other") }
  0
}

function pNul(x: F | null) {
  if x is F { print("nul:fn") } else { print("nul:other") }
  0
}

function pArr(x: F[] | G[]) {
  if x is F[] { print("arr:F") } else { print("arr:G") }
  0
}

function pArrStr(x: F[] | string) {
  if x is F[] { print("arrstr:F") } else { print("arrstr:other") }
  0
}

function pArrFn(x: F[] | G) {
  if x is F[] { print("arrfn:F") } else { print("arrfn:G") }
  0
}

pStr((n: i32) => n + 1)
pStr("zz")
pI32((n: i32) => n + 1)
pI32(7)
pStruct((n: i32) => n + 1)
pStruct({ a: 1 })
pNul((n: i32) => n + 1)
pNul(null)
pArr([(n: i32) => n + 1])
pArr([(s: string) => s.length])
pArrStr([(n: i32) => n + 1])
pArrStr("zz")
pArrFn([(n: i32) => n + 1])
pArrFn((s: string) => s.length)
