// @run
// @log 6
// @log 3
// @log 3
// @log 1
// @log 4
// @log 0
// @log 5
// @log true
// @log false
// A `?.` read of a ref field on an un-annotated parameter handed a present record, bound to a
// name, holds the field as it is (D16857).
function inc(x: i32) { return x + 1 }
function rec(a) { const r = a?.p; print(r.q) }
rec({ p: { q: 6 } })
function lst(a) { const r = a?.p; print(r.length) }
lst({ p: [1, 2, 3] })
function clo(a) { const g = a?.f; print(g(2)) }
clo({ f: inc })
function mp(a) { const r = a?.m; print(r.length) }
const mm = Map()
mm.set("k", 1)
mp({ m: mm })
function both(a) { const r = a?.p ?? { q: 0 }; print(r.q) }
both({ p: { q: 4 } })
both(null)
function gen<T>(a: T) { const r = a?.p; return r }
print(gen({ p: { q: 5 } }).q)
type R = { p: { q: i32 } }
function ann(a: R | null) { const r = a?.p; print(r == null) }
ann(null)
ann({ p: { q: 1 } })
