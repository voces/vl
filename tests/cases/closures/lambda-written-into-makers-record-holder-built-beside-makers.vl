// @run
// @log 3
// @log 3
// @hint Intentionally-unused variable `_a`
// @hint Intentionally-unused variable `_b`
// A lambda written into a `let` a maker's call initialises is the maker's record's member, built
// beside the maker's own lambda, never an instance at the binding's call types (D17814).
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
let k = lap((a) => a + 1)
k = (a) => a
print(k(3))
let j = lap((a) => a + 1)
if true { j = (a) => a }
print(j(3))
