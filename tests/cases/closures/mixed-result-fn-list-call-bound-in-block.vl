// @log 5.5
// A call through a list of un-annotated functions of two result types, handed through a generic,
// that the value-flow rewrite resolves to one member, lands in a local laid out at the joined
// result widened to it, each member alike (D16872).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function id(x) { return x }
function idt<T>(x: T): T { return x }
const xs = id([inc0, half])
const a0 = xs[0](3)
const b0 = xs[1](3)
print(a0)
print(b0)
{
  const a = xs[0](3)
  const b = xs[1](3)
  print(a)
  print(b)
}
function f() {
  const a = xs[0](3)
  const b = xs[1](3)
  print(a)
  print(b)
}
f()
const ys = idt([inc0, half])
{
  const a = ys[0](3)
  const b = ys[1](3)
  print(a)
  print(b)
}
{
  let u = 0.5
  u = xs[0](3)
  print(u)
  print(xs[0](3) + xs[1](3))
}
