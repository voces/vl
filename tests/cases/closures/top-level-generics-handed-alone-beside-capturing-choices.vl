// @run
// @log a
// @log 1
// @log 9
// @log z
// @log z
// @log t2
// @log a
// @log t2
// @log 1
// @log 10
// @log a
// @log 10
// @log 1
// @log a
// @log 1
// A top-level generic handed alone to a parameter called at two types is bundled there as it is
// beside a capturing nested function elsewhere, whether that choice goes to a parameter called at
// one type or at two (D15446).
function both(f) {
  print(f("a"))
  print(f(1))
}
function top(s) { return s }
function top2(s) {
  print("t2")
  return s
}
function once(f) { print(f("z")) }
function single(c: boolean, n: i32) {
  function inner(s) {
    print(n)
    return s
  }
  once(if c { inner } else { top })
}
both(top)
single(true, 9)
single(false, 9)
function pick(c: i32, n: i32) {
  function inner(s) {
    print(n)
    return s
  }
  function inner2(s) {
    print(n + 1)
    return s
  }
  both(if c == 0 { inner } else if c == 1 { inner2 } else { top })
}
both(top2)
pick(1, 9)
pick(2, 9)
