// @run
// @log 7.5
// @log 4
// @log 4
// @log 7.5
// @log 7.5
// @log 4
// @log 10
// @log 6
// @log 7.5
// @log 4
// @hint redundant type annotation: `ann0` is inferred as `f64`
// Records of one shape whose un-annotated functions are pinned at different types, each reached
// through a call result, a list element or a record literal, and handed to one un-annotated
// parameter: each call gets its own instance, keyed and typed at its record's pinned row (D9952).
function inc0(a) { return a + 1 }
function dbl0(a) { return a * 2.5 }
function ann0(a: i32): f64 { return a * 2.5 }
function take(a) { return a.f(3) }
function take2(a) { return a.f(3) + a.g(1) }
function mk() { return { f: dbl0 } }
function mk2() { return { f: inc0 } }
function mkA() { return { f: ann0 } }
print(take(mk()))
print(take(mk2()))
print(take(mk2()))
print(take(mkA()))
print(take([mk()][0]))
print(take([mk2()][0]))
print(take2({ f: dbl0, g: dbl0 }))
print(take2({ f: inc0, g: inc0 }))
print(take({ f: dbl0 }))
print(take({ f: inc0 }))
