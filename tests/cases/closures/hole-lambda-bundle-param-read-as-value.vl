// @run
// @log 4
// @log 3.5
// @log 8
// @log 4
// @log 3.5
// A lambda a hole parameter calls at two signatures is no bundle where the parameter is read
// other than as a callee: handed on, or captured by a nested function (D14841).
function other(g) { print(g(7)) }
function lapHanded(f) {
  print(f(3))
  print(f(2.5))
  other(f)
}
function lapCaptured(f) {
  print(f(3))
  const h = () => f(2.5)
  print(h())
}
function handed(k: i32) { lapHanded((a) => a + k) }
function captured(k: i32) { lapCaptured((a) => a + k) }
handed(1)
captured(1)
