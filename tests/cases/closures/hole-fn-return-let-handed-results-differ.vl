// @run
// @hint Intentionally-unused parameter `_a` (leading `_` marks it unused)
// @log s
// @log 4
// A re-pointed `let` a function returns, handed to a callee that calls it, is a tagged set the
// callee's instance dispatches on, so members whose results differ run (D16094).
function inc(a) { return a + 1 }
function str(_a) { return "s" }
function sel(c: boolean) {
  let f = inc
  if c { f = str }
  return f
}
function ap(f, x) { return f(x) }
print(ap(sel(true), 3))
print(ap(sel(false), 3))
