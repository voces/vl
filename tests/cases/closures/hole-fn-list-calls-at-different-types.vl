// @run
// @log 3
// @log 4
// @log 30
// The D7841 witness: a list of hole functions whose bodies call the handed hole function at
// different sets of types, iterated by `for`.
function add(a, b) { return a + b }
function apply2(g) {
  print(g(1, 2))
  print(g(1.5, 2.5))
}
function apply3(g) { print(g(10, 20)) }
const fs = [apply2, apply3]
for f in fs { f(add) }
