// @run
// @warning Unused parameter
// @log aa
// @log 10
// @log aa
// @log 14
// A hole function handed a generic it calls at two types, inside another hole function's
// instance, gives its result to a third hole function once the generic is a set's id (D14840).
function both2(n, f) {
  print(f("a"))
  return f(n)
}
function twice(s) { return s + s }
function two(a, b) { return b }
function go(z) { print(two(1, both2(z, twice))) }
go(5)
function bound(z) {
  const q = both2(z, twice)
  print(two(0, q))
}
bound(7)
