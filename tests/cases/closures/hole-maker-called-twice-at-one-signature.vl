// @run
// @log 4
// @log 5
// @log 4
// @log 5
// @log 6
// @log 4
// @log 5
// A maker handed the same un-annotated function by several calls, each result's field called at
// one closed type, delivers that function at the one signature its calls agree on.
function inc0(a) { return a + 1 }
function mk(f) { return { f: f } }
print(mk(inc0).f(3))
print(mk(inc0).f(4))
const a = mk(inc0)
print(a.f(3))
print(mk(inc0).f(4))
print(mk(inc0).f(5))
function two(f) { return { r: f, s: f } }
print(two(inc0).r(3))
print(two(inc0).s(4))
