// @run
// @log null7

// D2316 matrix — sibling function-scope blocks, closure return types a nullable
// (annotated) string then i32 — completing the ret-type ring (i32/f64/string/struct/
// list/nullable, each adjacent pair covered by this and its five sibling fixtures).

function f() {
  let out = ""
  {
    const g: () => string | null = () => null
    const n = g()
    out = n ?? "null"
  }
  {
    const g = () => 7
    out = out + "\{g()}"
  }
  out
}
print(f())
