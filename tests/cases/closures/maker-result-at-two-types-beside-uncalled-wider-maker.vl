// @run
// @hint Intentionally-unused function `_mkPick` (leading `_` marks it unused)
// @log v
// @log 5
// A generic a maker returns, called at two types, while a function nothing calls returns it in a
// wider choice: the uncalled function's result joins nothing (D15070).
function k<T>(x: T): T { return x }
function j<T>(x: T): T {
  print("j")
  return x
}
function mkLoop() { return k }
function _mkPick(f: boolean) {
  if f { return k }
  return j
}
function main() {
  const l = mkLoop()
  print(l("v"))
  print(mkLoop()(5))
}
main()
