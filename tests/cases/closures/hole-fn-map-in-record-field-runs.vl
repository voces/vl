// @run
// @log 1.5
// @log 4
// @log 2
// @log 2.5
// @log 1.5
// A map whose function values are a tagged set is stored as the i32-valued map, so a record
// holding it has a row, and the map read back out of the field calls its members (D15186).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const fnMap = Map()
fnMap.set("a", inc0)
fnMap.set("b", half)
const w = { f: fnMap }
const v = w.f
const g = v.get("b")
if g != null { print(g(3)) }
const h = w.f.get("a")
if h != null { print(h(3)) }
print(w.f.length)
function run() {
  const r = { f: fnMap }
  const k = r.f.get("b")
  if k != null { return k(5) }
  0.0
}
print(run())
const n = { r: { f: fnMap } }
const q = n.r.f.get("b")
if q != null { print(q(3)) }
