// Two such results stored in one map, a bundle beside another shape: refused at the store (D17106).
// @emit-error emitProgram: a function returning a parameter called at two signatures is called where its result is not used at one of them
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
function lap2(f) {
  const _a = f(true)
  const _b = f(3)
  return f
}
const m = Map()
m["a"] = lap((a) => a + 1)
m["b"] = lap2((a) => a)
print(m.has("b"))
