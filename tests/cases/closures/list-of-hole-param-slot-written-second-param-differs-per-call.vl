// @log 5
// A list of one hole parameter slot-written with a second, the second bound to a different generic at
// each of two calls: both join at the list's element set, which holds all three (D15574).
function id<T>(x: T): T { x }
function id2<U>(x: U): U { x }
function id3<V>(x: V): V { x }
function take(a, b) {
  const xs = [a]
  xs[0] = b
  print(xs[0]("abc").length + xs[0](2))
}
take(id2, id)
take(id2, id3)
