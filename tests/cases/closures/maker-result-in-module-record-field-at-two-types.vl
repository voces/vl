// @run
// @log 1
// @log z
// @log made
// @log 2
// @log y
// @log 7
// @log 3
// @log 4
// @log x
// @log true
// @log 5
// @log w
// @log 6
// @log 8
// @log v
// @log false
// @log 9
// @log u
// @log 10
// @log t
// A record field holding a maker's generic result, called at two types, takes the type its
// binding is called at, and a call at any other type calls the generic directly (D6342). Also
// through a `const` the field holds, a lambda maker, a maker with an effect it runs once, a
// tail-returning maker, inside a function, and with the `const` called first or last.
function k<T>(x: T): T { return x }
function mk() { return k }
const r = { f: mk() }
print(r.f(1))
print(r.f("z"))
function mk1() {
  print("made")
  return k
}
const r1 = { f: mk1(), g: 7 }
print(r1.f(2))
print(r1.f("y"))
print(r1.g)
print(r1.f(3))
function mk2() { k }
const r2 = { f: mk2() }
print(r2.f(4))
print(r2.f("x"))
print(r2.f(true))
function mk3() { return k }
const q3 = mk3()
const r3 = { f: q3 }
print(r3.f(5))
print(r3.f("w"))
print(q3(6))
function mk4() { return k }
const q4 = mk4()
const r4 = { f: q4 }
print(q4(8))
print(r4.f("v"))
print(r4.f(false))
const mk5 = () => k
const r5 = { f: mk5() }
print(r5.f(9))
print(r5.f("u"))
function mk6() { return k }
function main() {
  const r6 = { f: mk6() }
  print(r6.f(10))
  print(r6.f("t"))
}
main()
