// @log x
// @log 6
// @log 7
// @log 2
// @log s
// A generic function pushed into an un-annotated list, empty or holding the same generic, runs
// when called through an element at two types, by a literal or computed index or a loop (D9441).
function id<T>(x: T): T { x }
function inc(x: i32) { x + 1 }
const a = []
a.push(id)
print(a[0](2))
print(a[0]("s"))
const b = [id]
b.push(id)
print(b[1](3))
print(b[0]("t"))
const c = []
c.push(id)
c.push(id)
for f in c { print(f(3)) }
print(c[1]("u"))
const d = []
d.push(id)
d.push(id)
let i = 0
while i < 2 {
  print(d[i](i))
  i = i + 1
}
print(d[0]("v"))
const e = []
e.push(id)
print(e.length)
print(e[0](4))
print(e[0]("w"))
const g: ((x: i32) => i32)[] = []
g.push(id)
g.push(inc)
print(g[0](5))
const h = [id]
print(h[0]("x"))
print(h[0](6))
const k = []
k.push(inc)
print(k[0](6))
function main() {
  const q = []
  q.push(id)
  print(q[0](2))
  print(q[0]("s"))
}
main()
