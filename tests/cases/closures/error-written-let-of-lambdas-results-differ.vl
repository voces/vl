// @error cannot assign (i32) => f64 to (i32) => i32 (the body of `f` at the call's argument types)
// A call through a `let` of lambdas typed before a later write's lambda is checked cannot type
// that lambda's result, and the later call still refuses the write (D16096).
let f = (a) => a + 1
print(f(1))
f = (a) => a / 2.0
print(f(3))
