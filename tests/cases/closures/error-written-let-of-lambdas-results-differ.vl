// @error cannot write a lambda to 'f': called at (i32) it returns f64, where a lambda, also written to it, returns i32
// @error cannot assign (i32) => f64 to (i32) => i32 (the body of `f` at the call's argument types)
// The lambdas written to one `let` give a call through it one result, so a lambda whose body
// returns another type at a call's arguments is refused at the write.
let f = (a) => a + 1
print(f(1))
f = (a) => a / 2.0
print(f(3))
