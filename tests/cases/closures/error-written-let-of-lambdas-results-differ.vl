// @error cannot assign (i32) => f64 to (i32) => i32 (the body of `f` at the call's argument types)
// The lambdas written to one `let` whose results differ at a call's arguments are still refused
// at the call (D16064 covers declared functions only).
let f = (a) => a + 1
print(f(1))
f = (a) => a / 2.0
print(f(3))
