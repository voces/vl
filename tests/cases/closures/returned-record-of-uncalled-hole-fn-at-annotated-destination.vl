// @run
// @log 1
// @log 1
// @log 3.5
// @log 2
// @log 1
// A record or list of a hole function a call returns, bound or handed at an annotated closed
// type, is built at that type: a bare field, a nested record, an `f64` signature called through,
// two call sites at one type, and an annotated parameter (D17744).
function inc0(a) { return a + 1 }
function d0() { return { f: inc0, n: 1 } }
const v0: { f: (a: i32) => i32, n: i32 } = d0()
print(v0.n)

function inc1(a) { return a + 1 }
function d1() { return { r: { f: inc1 }, n: 1 } }
const v1: { r: { f: (a: i32) => i32 }, n: i32 } = d1()
print(v1.n)

function inc2(a) { return a + 1 }
function d2() { return { f: inc2, n: 1 } }
const v2: { f: (a: f64) => f64, n: i32 } = d2()
print(v2.f(2.5))

function inc3(a) { return a + 1 }
function d3() { return { f: inc3, n: 1 } }
const v3: { f: (a: i32) => i32, n: i32 } = d3()
const w3: { f: (a: i32) => i32, n: i32 } = d3()
print(v3.n + w3.n)

function inc4(a) { return a + 1 }
function d4() { return { f: inc4, n: 1 } }
function take4(x: { f: (a: i32) => i32, n: i32 }) { return x.n }
print(take4(d4()))
