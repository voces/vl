// @run
// @log 3
// @log 3
// @log 20
// @log 19
// @log 14
// @log 1
// A record holding a function keys its list and map-value rows by its type: one declared type
// read through a map value, an annotated list, two lists of different lambdas and a maker.
type R = { f: (i32) => i32 }
function mk(g: (i32) => i32): R { { f: g } }
const m = Map()
m["a"] = { f: (x: i32): i32 => x + 1 }
const r = m["a"]
if r != null { print(r.f(2)) }
const xs: R[] = [{ f: (x: i32): i32 => x + 1 }]
print(xs[0].f(2))
const ys: R[] = [{ f: (x: i32): i32 => x * 10 }]
print(ys[0].f(2))
const zs: R[] = [mk((x: i32): i32 => x * 10), mk((x: i32): i32 => x - 3)]
print(zs[0].f(2) + zs[1].f(2))
const n = Map()
n["b"] = { f: (x: i32): i32 => x * 7 }
const s = n["b"]
if s != null { print(s.f(2)) }
const ws: R[] = [{ f: (x: i32): i32 => x - 1 }]
print(ws[0].f(2))
