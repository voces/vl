// @log 1
// @log 5
// A forwarder hands a list join's parameters a different generic at each call: the call under
// each forwarder instance binds both at the union of what all calls hand them (D15578).
function id<T>(x: T): T { x }
function id2<U>(x: U): U { x }
function id3<V>(x: V): V { x }
function use(ys) { print(ys.length) }
function take(a, b) {
  const xs = [a]
  xs[0] = b
  use(xs)
  print(xs[0]("abc").length + xs[0](2))
}
function fwd(f) { take(f, id2) }
function fwdB(f) { take(id2, f) }
function fwdC(f) {
  const g = f
  take(g, id2)
}
fwd(id)
fwd(id3)
fwdB(id)
fwdB(id3)
fwdC(id)
fwdC(id3)
