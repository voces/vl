// @run
// @log 6
// @log 4
// Sibling records holding different hole functions, `s.f` called:
// returned as a value if.
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function mk(c: boolean) {
  return if c { { r: { f: inc0 }, s: { f: dbl } } } else { { r: { f: dbl }, s: { f: inc0 } } }
}
print(mk(true).s.f(3))
print(mk(false).s.f(3))
