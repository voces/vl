// @run
// @log 1
// @log s
// @log 3
// A function whose result is a generic, read as a value into a declared function type, hands
// that slot a closure, while its direct calls are each called at their own type.
function k<T>(x: T): T { return x }
function mk() { return k }
function main() {
  const a = mk()
  print(a(1))
  const b = mk()
  print(b("s"))
  const h: () => (x: i32) => i32 = mk
  print(h()(3))
}
main()
