// @run
// @log 1
// @log 1
// A generic an un-annotated function stores into a map it is handed, with nothing calling the
// entry, compiles at its uncalled slot type; the second map is the module-level control (D9590).
function id<T>(x: T): T { x }
function fill(mm) { mm["k"] = id }
const m = Map()
fill(m)
print(m.length)
const m2 = Map()
m2["k"] = id
print(m2.length)
