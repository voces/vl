// @run
// @log true
// @log 7
// @log 7
// @info `r` is never reassigned; use `const` instead of `let`
// D2862: a record with a closure field bound by `let` in a hole-parameter maker and returned
// on the next statement reads the closure's result at each pin's own type.
function mk(x) {
  let r = { f: x, g: () => x }
  return r
}
print(mk(true).g())
print(mk(7).g())
const m = mk(7)
print(m.g())
