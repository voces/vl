// @run
// @log L
// @log s
// @log L
// @log true
// The control for delivering the written `let` itself: a hand-written wrapper calls it.
function other<V>(v: V) { print("O"); print(v) }
function cb(f: (b: boolean) => void, b: boolean) { f(b) }
function main() {
  let k = other
  k = (n) => {
    print("L"); print(n)
  }
  k("s")
  cb((b: boolean) => k(b), true)
}
main()
