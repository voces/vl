// @run
// @log 4
// @log 0
// @log 4
// @log -1
// @log 7
// @log 1
// @log 4
// @log 1
// @log 6
// A `?.` call through a chain more than one field deep: the guard tests the bound receiver,
// evaluated once, and a null anywhere in the chain takes the fallback (D16809). The map's field
// is named apart from `G`'s, which D16830 trips on.
type G = { f0: (a: i32) => i32 }
type F = { g: G, h: (a: i32) => void }
type R = { r: F }
function inc0(a: i32) { return a + 1 }
function say(a: i32) { print(a) }
function pick(k: i32): R | null {
  if k > 0 { return { r: { g: { f0: inc0 }, h: say } } } else { return null }
}
const e = pick(1)
print(e?.r.g.f0(3) ?? 0)
const z = pick(0)
print(z?.r.g.f0(3) ?? 0)
function run(x: R | null) { return x?.r.g.f0(3) ?? -1 }
print(run(e))
print(run(null))
e?.r.h(7)
z?.r.h(8)
let n = 0
function pickCounted(k: i32): R | null {
  n = n + 1
  return pick(k)
}
print(n + 1)
print(pickCounted(1)?.r.g.f0(3) ?? 0)
print(n)
function dbl(a) { return a * 2 }
function inc1(a) { return a + 1 }
const m = Map()
m.set("a", { r: { fm: inc1 } })
m.set("b", { r: { fm: dbl } })
print(m.get("b")?.r.fm(3) ?? 0)
