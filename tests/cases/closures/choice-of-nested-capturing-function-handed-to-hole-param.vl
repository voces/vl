// @run
// @log 9
// @log a
// @log 9
// @log 1
// A choice whose nested member reads a binding of the caller is not dispatched by id: the member
// is called through its closure, once per type.
function both(f) {
  print(f("a"))
  print(f(1))
}
function nested(c: boolean, n: i32) {
  function inner(s) {
    print(n)
    return s
  }
  function ask(s) { return s }
  both(if c { inner } else { ask })
}
nested(true, 9)
