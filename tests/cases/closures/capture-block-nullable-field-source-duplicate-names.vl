// @run
// @log 3
// @log 9

// D1935 — the SAME field-source-capture shape as capture-block-nullable-field-source.vl, but
// the two sibling blocks reuse every name (`srcBox`/`held`/`get`/`v`). `letInitCellKind`
// resolved the closure-return chain `get -> held -> srcBox` by bare name, so the collision
// flipped the second block's `nulstruct` classification to non-null `struct` and its read
// skipped `ref.as_non_null`. Closed by D2316's function-scope positioned resolution.

type Rec = { name: string, n: i32 }
type MaybeRec = Rec | null
type Two = { label: string, m: i32 }
function mkval(k: i32): MaybeRec { return { name: "ada", n: k } }
function mktwo(k: i32): Two { return { label: "z", m: k } }
if true {
  const srcBox = { it: mkval(3) }
  const held = srcBox.it
  const get = () => held
  const v = get()
  if v != null { print(v.n) } else { print(0) }
}
if true {
  const srcBox = { it: mktwo(9) }
  const held = srcBox.it
  const get = () => held
  const v = get()
  print(v.m)
}
