// @run
// @log 6
// @log 4
// @log 6
// @log 6
// @log 3.5
// @log 6
// @log 4
// A list of inner lists of un-annotated functions whose first inner list holds fewer of them
// types at every function its inner lists hold, bound, with a middle inner list of another member,
// and in a record field.
function inc0(a) { return a + 1 }
function dbl0(a) { return a * 2 }
const fs0 = [[inc0], [inc0, dbl0]]
print(fs0[1][1](3))
print(fs0[0][0](3))

function inc1(a) { return a + 1 }
function dbl1(a) { return a * 2 }
const fs1 = [[inc1], [dbl1], [inc1, dbl1]]
print(fs1[2][1](3))
print(fs1[1][0](3))
print(fs1[0][0](2.5))

function inc2(a) { return a + 1 }
function dbl2(a) { return a * 2 }
const r2 = { fs: [[inc2], [inc2, dbl2]] }
print(r2.fs[1][1](3))
print(r2.fs[0][0](3))
