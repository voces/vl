// @emit-error is written with a generic function inside a closure that every instance of the enclosing generic function shares
// An alias of a generic written by a closure the instances share is refused like the generic
// itself, not passed through (D3939, `rv3498/y02`).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function a<T>(x: T) {
  let k = inner
  const al = other
  const toO = () => {
    k = al
  }
  toO()
  k(x)
}
a(true)
a(1)
