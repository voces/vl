// @run
// @log O
// @log true
// @log O
// @log 1
// An alias of a generic, written into a capture cell by a closure the instances share, is called at each instance's type (D3939, D3957, `rv3498/y02`).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function a<T>(x: T) {
  let k = inner
  const al = other
  const toO = () => {
    k = al
  }
  toO()
  k(x)
}
a(true)
a(1)
