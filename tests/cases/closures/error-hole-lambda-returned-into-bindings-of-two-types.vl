// @emit-error `deliver` returns one function value and its calls deliver it at two function types
// A hole lambda returned by one un-annotated function into destinations of two function types
// is refused: the one value the function returns has one signature (D6522).
const h = (u) => {
  return u
}
function deliver() { return h }
const v: (n: i32) => i32 = deliver()
const w: (n: string) => string = deliver()
print(v(3) + 1)
print(w("q"))
