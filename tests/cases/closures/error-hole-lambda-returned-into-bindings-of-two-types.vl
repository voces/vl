// @run
// @log 4
// @log q
// A hole lambda returned by one un-annotated function into destinations of two function types
// runs: the function is a maker, and each call builds its own instance at the type its result is
// delivered at (D12234). The file keeps its name from when this was refused (D6522).
const h = (u) => {
  return u
}
function deliver() { return h }
const v: (n: i32) => i32 = deliver()
const w: (n: string) => string = deliver()
print(v(3) + 1)
print(w("q"))
