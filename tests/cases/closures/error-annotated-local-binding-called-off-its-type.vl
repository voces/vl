// @error argument 1: expected i32, got string
// The annotated binding is still checked at its own type when a same-named binding elsewhere
// holds a function through a hole (D5972).
function fw(f) { return f }
function id(x) { return x }
function g() {
  const h: (x: i32) => i32 = id
  print(h("w"))
}
g()
const h = fw(id)
print(h("v"))
