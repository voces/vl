// @log 0.75
// A list of hole functions, iterated, indexed or joined by an `if`, handed a hole function the
// frame received as its own parameter, types the callee at what that parameter holds (D7845).
function add(a, b) { return a + b }
function mul(a, b) { return a * b }
function apply2(g) {
  print(g(1, 2))
  print(g(1.5, 2.5))
}
function apply3(g) {
  print(g(10, 20))
  print(g(0.5, 0.25))
}
function run(h) {
  const fs = [apply2, apply3]
  for f in fs { f(h) }
}
run(add)
run(mul)
function pick(h) {
  const fs = [apply2, apply3]
  fs[1](h)
}
pick(add)
function join(c: boolean, h) {
  (if c { apply2 } else { apply3 })(h)
  const f = if c { apply3 } else { apply2 }
  f(h)
}
join(true, add)
