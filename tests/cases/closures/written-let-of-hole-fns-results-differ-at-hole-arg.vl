// @run
// @log 1.5
// A re-pointed `let` handed to a parameter called at another un-annotated parameter dispatches
// on the function it holds, and the caller reads the members' join (D9009, D16009).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function w(h, x) { return h(x) }
let f = inc0
f = half
print(w(f, 3))
