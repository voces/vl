// @run
// @log 5
// @log 2.5
// @log 5
// @log 2.5
// @log 5
// @log 2.5
// A maker returns a hole lambda it creates, and one call's value is held and called at two
// signatures: the call returns the record of one closure per signature its holders call it at,
// held by a binding, captured by a closure, and returned whole by another function (D16845,
// D17045).
function mk() { return (a) => a + 1 }
const v = mk()
print(v(4))
print(v(1.5))

const c = mk()
const f = () => {
  const w = c
  print(w(4))
  print(w(1.5))
}
f()

function deliver() { return mk() }
const d = deliver()
print(d(4))
print(d(1.5))
