// @run
// @log 8
// @log 8
// @log 8
// @log 6
// @log 8
// @log 6
// D1602 — the default-argument face. `drwFillDefaults` normalizes a direct call to its
// callee's full arity before monomorphization, and it resolved the callee by name too, so
// a call through a closure binding was handed the module function's default: `q(8)` became
// `q(8, 5)` and printed 13 through a signature with one parameter.
//
// This face RAN and printed the wrong number, which is what makes the proving values here
// load-bearing. The rewrite pass has no locals registry, so the binding is resolved by the
// walk's own block scope; the two controls are what that scope has to get right.

// The shadow is a PARAMETER, whose extent is the whole frame.
function qa(a: i32, b: i32 = 5) { print(a + b) }
function takA(qa: (i32) => void) { qa(8) }
takA((n) => { print(n) })

// The shadow is a local declared directly in the frame body.
function qb(a: i32, b: i32 = 5) { print(a + b) }
function takB() {
  const qb: (i32) => void = (n) => { print(n) }
  qb(8)
}
takB()

// CONTROL — the shadow is in a BLOCK, so it covers the call inside it and the call after it
// is the module function's, which still takes its default.
function qc(a: i32, b: i32 = 5) { print(a + b) }
function takC() {
  if true {
    const qc: (i32) => void = (n) => { print(n) }
    qc(8)
  }
  qc(1)
}
takC()

// CONTROL — a sibling block's binding covers nothing outside itself, so both calls below
// are the module function's and both take the default.
function qd(a: i32, b: i32 = 5) { print(a + b) }
function takD() {
  if true {
    const qd: (i32) => void = (n) => { print(n) }
    qd(8)
  }
  if true { qd(1) }
}
takD()
