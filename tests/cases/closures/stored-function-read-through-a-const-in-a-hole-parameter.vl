// @run
// @log 4
// @log 6
// @log 4
// @log 4
// @hint redundant type annotation: `dbl` is inferred as `f64` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// A function read out of a list inside the hole parameter it was handed to, through a
// `const`, is called at the slot's stored signature: the read instances nothing (D17817).
function dbl(a: f64): f64 { return a * 2.0 }
const g = (a) => a + 1
const xs = [g, dbl]
function walk(ys) { const v = ys[0]; print(v(3)) }
function walk2(ys) { const v = ys[1]; print(v(3)) }
walk(xs)
walk2(xs)
function inline(ys) { print(ys[0](3)) }
inline(xs)
const w = xs[0]
print(w(3))
