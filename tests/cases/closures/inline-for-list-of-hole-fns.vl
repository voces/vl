// @run
// @log 1
// @log 1
// @log 0.5
// @log 1
// @log 1
// @log y
// @log 4
// @log 0.5
// @log 0.5
// @log 2
// @log 3
// @log 1
// @log 1.5
// @log 4
// @log 6
// @log 1
// @log 3
// A hole function in a list literal written in a `for` header is taken at the type its loop
// variable is called at: inside a hole function at either of its instances, at the top level,
// and inside a plain function (D13100); and at the type of the hole parameter handed to the
// call, one instance per call type (D13101).
function apply2(s) { print(s + s) }
function apply3(s) { print(s * 3) }
function inner(k) {
  let n = 0
  for f in [apply2] {
    f(0.5)
    n = n + 1
  }
  print(n)
  print(k)
}
inner(0.5)
inner("y")

function whole(k) {
  for f in [apply2] { f(2) }
  print(k)
}
whole(0.5)

for f in [apply2] { f(0.25) }

function plain() {
  for f in [apply2, apply3] { f(1) }
}
plain()

function fwd(k) {
  for f in [apply2, apply3] { f(k) }
}
fwd(0.5)
fwd(2)

function first(g, s) {
  print(g)
  print(s + s)
}
function mixed(k) {
  for f in [first] { f(1, k) }
}
mixed(1.5)
