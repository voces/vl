// @run
// @log aE
// @log aE
// @log aE
// A hole lambda nothing calls, delivered through a `const` alias to a typed parameter or
// returned at an annotated function-typed result, is pinned at that type (D3852).
function callIt(f: (y: string) => string, s: string) { f(s) }
function mk(x: string) {
  const e = (y) => y + "E"
  const d1 = e
  print(callIt(d1, x))
  function get1(): (y: string) => string { e }
  print(get1()(x))
}
mk("a")
function viaReturn(x: string) {
  const e = (y) => y + "E"
  function get1(): (y: string) => string { e }
  print(get1()(x))
}
viaReturn("a")
