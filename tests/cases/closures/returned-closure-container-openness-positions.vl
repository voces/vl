// @run
// @hint Intentionally-unused parameter `_n` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// @log 7
// @log 3
// @log 6
// @log 1.5
// @log 8
// @log 5
// A returned list, nested list or map of functions whose closure types the result leaves open,
// or fills, where the value's do the other: the value returned as it stands, at a `return`, a
// tail expression, a tail `if`'s arms and a generic instance's result.
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function half(a) { return a / 2.0 }
const fs = [inc0]
function viaReturn() { return fs }
const r1: ((a: i32) => i32)[] = viaReturn()
print(r1[0](6))
const viaTail = () => fs
const r2: ((a: i32) => i32)[] = viaTail()
print(r2[0](2))
function give(_n) {
  const w = [[inc0], [dbl]]
  return w
}
function nested(): ((a: i32) => i32)[][] { return give(1) }
print(nested()[1][0](3))
const m1 = Map()
m1.set("a", half)
const m2 = Map()
m2.set("a", half)
const pick = [1].length > 0
function viaArms() { return if pick { m1 } else { m2 } }
const v: { [string]: (a: f64) => f64 } = viaArms()
const g = v.get("a")
if g != null { print(g(3)) }
function id<T>(x: T): T { return x }
function ofId<T>(_x: T) {
  const src = [id]
  return src
}
const ids: ((x: i32) => i32)[] = ofId(0)
print(ids[0](8))
print(give("s")[0][0](4))
