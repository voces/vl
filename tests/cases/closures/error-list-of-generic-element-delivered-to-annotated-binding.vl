// @emit-error a generic function taken as a value reaches no call that fixes its type
// An element read delivered to an annotated function binding would call the stub at a
// signature it lacks, so the unpinned list is refused (D4125).
function inner<U>(u: U) { print(u) }
const fs = [inner]
const k: (u: i32) => void = fs[0]
k(3)
