// @hint redundant type annotation: `r` is inferred as `string`
// @hint redundant type annotation: `tops` is inferred as `K[]`
// @hint redundant type annotation: `fieldWrite` is inferred as `string`
// @hint redundant type annotation: `elemWrite` is inferred as `string`
// @hint redundant type annotation: `aw` is inferred as `string`
// Regression (D2168). A literal-union `let` a closure writes lives in a boxed cell, which
// holds the atom, so a member written through it stores the atom, and the closure's value is
// that atom, widened where its checked type is `string`. Each case failed validation or trapped.
type K = "zz" | "ww"

function plain() {
  let k: K = "zz"
  const set = () => {
    k = "ww"
  }
  set()
  print(k)
}
plain()

// The value used, bound and printed.
function used() {
  let k: K = "zz"
  const set = () => {
    k = "ww"
  }
  print(set())
  const r: string = set()
  print(r)
}
used()

// A named nested function, a `const` member on the right, and a parameter on the right.
function named() {
  let k: K = "zz"
  function set() { k = "ww" }
  set()
  print(k)
}
named()
function fromConst() {
  const W = "ww"
  let k: K = "zz"
  const set = () => {
    k = W
  }
  set()
  print(k)
}
fromConst()
function fromParam() {
  let k: K = "zz"
  const set = (v: K) => {
    k = v
  }
  set("ww")
  print(k)
}
fromParam()

// An inline member set, a second closure reading the cell, and a compare after the write.
function inline() {
  let k: "zz" | "ww" = "zz"
  const set = () => {
    k = "ww"
  }
  const get = () => k
  set()
  print(get())
  const isW = () => {
    k = "ww"
    k == "ww"
  }
  print(isW())
}
inline()

// A module block, and a generic frame at two types.
if true {
  let k: K = "zz"
  const set = () => {
    k = "ww"
  }
  set()
  print(k)
}
function gen<T>(x: T) {
  let k: K = "zz"
  const set = () => {
    k = "ww"
  }
  set()
  print(k)
  x
}
print(gen(1))
print(gen("s"))

// A module global written by a function whose value is printed, and an element built from it.
let top: K = "zz"
function setTop() { top = "ww" }
print(setTop())
const tops: K[] = [top]
print(tops[0])

// A write to a literal-union local, field or element that is a function's value yields the
// atom, widened where the result is `string` (D2170's spill meeting the atom rep).
function localWrite() {
  let k: K = "zz"
  k = "ww"
}
print(localWrite())
print(localWrite() == "ww")
type KR = { k: K }
const kr: KR = { k: "zz" }
function fieldWrite(r: KR): string { r.k = "ww" }
print(fieldWrite(kr))
print("d=" + fieldWrite(kr))
function elemWrite(ks: K[]): string { ks[0] = "ww" }
const ks: K[] = ["zz"]
print(elemWrite(ks))
function armWrite(r: KR, c: boolean) {
  if c { r.k = "ww" } else { r.k }
}
print(armWrite(kr, true))
print(armWrite(kr, false))
const aw: string = armWrite(kr, true)
print(aw)
