// @log 1
// @log ww
// @log s
// @log ww
// @log ww
// @hint redundant type annotation: `r` is inferred as `string`
// @hint redundant type annotation: `tops` is inferred as `K[]`
// Regression (D2168). A literal-union `let` a closure writes lives in a boxed cell, which
// holds the atom, so a member written through it stores the atom, and the closure's value is
// that atom, widened where its checked type is `string`. Each case used to fail validation.
type K = "zz" | "ww"

function plain() {
  let k: K = "zz"
  const set = () => {
    k = "ww"
  }
  set()
  print(k)
}
plain()

// The value used, bound and printed.
function used() {
  let k: K = "zz"
  const set = () => {
    k = "ww"
  }
  print(set())
  const r: string = set()
  print(r)
}
used()

// A named nested function, a `const` member on the right, and a parameter on the right.
function named() {
  let k: K = "zz"
  function set() { k = "ww" }
  set()
  print(k)
}
named()
function fromConst() {
  const W = "ww"
  let k: K = "zz"
  const set = () => {
    k = W
  }
  set()
  print(k)
}
fromConst()
function fromParam() {
  let k: K = "zz"
  const set = (v: K) => {
    k = v
  }
  set("ww")
  print(k)
}
fromParam()

// An inline member set, a second closure reading the cell, and a compare after the write.
function inline() {
  let k: "zz" | "ww" = "zz"
  const set = () => {
    k = "ww"
  }
  const get = () => k
  set()
  print(get())
  const isW = () => {
    k = "ww"
    k == "ww"
  }
  print(isW())
}
inline()

// A module block, and a generic frame at two types.
if true {
  let k: K = "zz"
  const set = () => {
    k = "ww"
  }
  set()
  print(k)
}
function gen<T>(x: T) {
  let k: K = "zz"
  const set = () => {
    k = "ww"
  }
  set()
  print(k)
  x
}
print(gen(1))
print(gen("s"))

// A module global written by a function whose value is printed, and an element built from it.
let top: K = "zz"
function setTop() { top = "ww" }
print(setTop())
const tops: K[] = [top]
print(tops[0])
