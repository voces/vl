// @run
// @log 4
// @log 5
// @log 6
// @log 10
// @log 4
// @log n
// @log 9
// @log 19
// @log 2
// @log 8
// @log 3
// A maker binds a list of records holding a function, then returns it in a record (D15922).
function inc0(a) { return a + 1 }
function mk0() {
  const xs = [{ f: inc0 }]
  return { a: xs }
}
print(mk0().a[0].f(3))

function inc1(a: i32) { return a + 1 }
function dbl1(a: i32) { return a * 2 }
function mk1() {
  const xs = [{ f: inc1 }]
  return { a: xs }
}
const m1 = mk1()
print(m1.a[0].f(4))
function mk2() {
  const xs = [{ f: inc1 }, { f: dbl1 }]
  return { a: xs }
}
for r in mk2().a { print(r.f(5)) }

function name3(a: i32) { return if a > 0 { "n" } else { "z" } }
function mk3() {
  const xs = [{ f: inc1 }]
  const ys = [{ g: name3 }]
  return { a: xs, b: ys }
}
const m3 = mk3()
print(m3.a[0].f(3))
print(m3.b[0].g(3))

function mk4(k: i32) {
  const xs = [{ f: inc1, k: k }]
  xs.push({ f: (x: i32): i32 => x * k, k: k + 1 })
  return { a: xs, n: xs.length }
}
const m4 = mk4(3)
for r in m4.a { print(r.f(5) + r.k) }
print(m4.n)

type R5 = { f: (n: i32) => i32 }
function mk5(): { o: { a: R5[] } } {
  const xs: R5[] = [{ f: dbl1 }]
  return { o: { a: xs } }
}
print(mk5().o.a[0].f(4))

function inc6(a) { return a + 1 }
function dec6(a) { return a - 1 }
function mk6() {
  const xs = [{ f: inc6 }]
  xs.push({ f: dec6 })
  return { a: xs }
}
print(mk6().a[1].f(4))
