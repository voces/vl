// @run
// @log 9
// @log 3.5
// @log 3
// @log 14
// One instance hands its parameter whole to two hole callees that call it at different
// signatures, in either order: the record it passes holds both, not only the first one reached.
function other(g) { print(g(7)) }
function other2(g) { print(g(1.5)) }
function handTwo(f) {
  other(f)
  other2(f)
}
function handTwoRev(f) {
  other2(f)
  other(f)
}
function go(k: i32) {
  handTwo((a) => a + k)
  handTwoRev((a) => a * k)
}
go(2)
