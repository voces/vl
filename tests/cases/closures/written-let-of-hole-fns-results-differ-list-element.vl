// @run
// @log 1.5
// An element of a list literal holding a re-pointed `let` may be either function the binding
// held, and a call through the element dispatches on the one it holds (D16064).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
let f = inc0
f = half
const xs = [f]
print(xs[0](3))
