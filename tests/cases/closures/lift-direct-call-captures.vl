// @run
// @log 6
// @log 30
// @log 31
// @log 132
// @log 45
// @log 10
// @log 11
// @log 8
// @log 998
// @log 8
// @log hi bo/1
// @log 7
// @log 23
// @log 29
// @log 103
// @log 10

// @warning `o` shadows the `o` declared at
// @hint redundant type annotation: `depth` is inferred as `i32`

// Local functions whose every use is a direct call in the frame that declares them are
// lambda-lifted: their captures travel as parameters. Each line prints a value only the right
// capture produces — a constant, a `let` the closure shares because it is written after the
// closure is made, a loop variable, a parameter, a string, a record, a capture read by a nested
// lifted lambda, a recursive block-local function, and a capture shadowed at the call site.

type P = { a: i32, b: i32 }

function host(p: i32, name: string) {
  const c = p * 2
  const f = (x: i32): i32 => x + c
  print(f(0))
  let w = p * 10
  const g = (x: i32): i32 => x + w
  print(g(0))
  print(g(1))
  w = w + 100
  print(g(2))
  let sum = 0
  for i in 0 until 3 {
    const h = (x: i32): i32 => x * i + p
    sum += h(5)
  }
  print(sum + 21)
  const k = (x: i32): i32 => x + p + 7
  print(k(0))
  print(k(1))
  const r: P = { a: p, b: 5 }
  const fr = (x: i32): i32 => r.a + r.b - x
  print(fr(0))
  const outer = (x: i32): i32 => {
    const d = x + c
    const inner = (y: i32): i32 => y + d + c
    inner(1) + inner(2) + 993 - 2 * c - 2 * d + 2 * x
  }
  print(outer(1))
  function depth(n: i32): i32 {
    if n <= 0 { c + 2 } else { depth(n - 1) }
  }
  print(depth(4))
  const pre = "hi " + name
  const greet = (n: string): string => pre + "/" + n
  print(greet("1"))
  const o = p + 4
  const fo = (x: i32): i32 => o + x
  if p > 0 {
    const o = 16
    print(fo(0))
    print(fo(o))
  }
  print(fo(22))
  let acc = 0
  const bump = (d: i32) => {
    acc += d
  }
  for j in 0 until 5 { bump(j) }
  print(acc + 93)
  print(f(4))
}
host(3, "bo")
