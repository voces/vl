// @run
// @log 3
// @log 4
// @log 3
// @log pq
// @log x
// @log 5
// A generic handed to an un-annotated parameter with no checker binding there is instanced at
// the one signature the flow table pins it at past the hole: `apply`'s `g(x, y)` (D5612).
function add(a, b) { return a + b }
function apply(g, x, y) { return g(x, y) }
function same<T>(v: T): T { v }
function call1(f, v) { return f(v) }
function main() {
  print(apply(add, 1, 2))
  print(apply(add, 1.5, 2.5))
  const g = add
  print(apply(g, 1, 2))
  print(apply(add, "p", "q"))
  print(call1(same, "x"))
  print(call1(same, 5))
}
main()
