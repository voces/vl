// @run
// @log 3
// @log 4
// @log 3
// @log pq
// @log x
// @log 5
// @log x
// @log 7
// @log 3
// A generic handed to an un-annotated parameter with no checker binding there is instanced at
// the one signature the flow table pins it at past the hole: `apply`'s `g(x, y)` (D5612), a
// lambda's call (D5403), and an annotated binding past a generic identity (D4122).
function add(a, b) { return a + b }
function apply(g, x, y) { return g(x, y) }
function same<T>(v: T): T { v }
function call1(f, v) { return f(v) }
function id<T>(x: T) { x }
function sel<F>(f: F) { f }
const t = (a) => print(a("x"))
const u = (a) => print(a(7))
const k: (x: i32) => i32 = sel(id)
function main() {
  print(apply(add, 1, 2))
  print(apply(add, 1.5, 2.5))
  const g = add
  print(apply(g, 1, 2))
  print(apply(add, "p", "q"))
  print(call1(same, "x"))
  print(call1(same, 5))
  t(same)
  u(same)
  print(k(3))
}
main()
