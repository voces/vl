// @error a `{f: (_) => _}[]` cannot be used as `{f: (i32) => f64}[]` here
// The `f64`-result spelling of D15895: a held list of records of an un-annotated function giving
// `i32` stays refused at an `f64`-result field, though a literal list adapts (D15896).
function inc0(a) { return a + 1 }
const xs = [{ f: inc0 }]
const rs: { f: (a: i32) => f64 }[] = xs
print(rs[0].f(3) / 8)
