// @log 2
// @log 3
// @log 3
// @log 3
// @log 2
// D15442's witness with the alias calls in the other order: which set the first alias call
// instances does not decide which set the loop's call through the element can take.
function add(a, b) { return a + b }
function mul(a, b) { return a * b }
function apply2(g) { print(g(1, 2)) }
const k = apply2
k(mul)
apply2(add)
k(add)
function viaFor(h) {
  for f in [apply2] { f(h) }
}
viaFor(add)
viaFor(mul)
