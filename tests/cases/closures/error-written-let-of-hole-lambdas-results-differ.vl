// @error-at 9:6 cannot assign (i32) => f64 to (i32) => i32
// A re-pointed `let` of un-annotated lambdas whose results differ, the write inside a loop, is
// still refused at the call (D16064 covers declared functions only).
let f = (a) => a + 1
let i = 0
while i < 3 {
  if i == 1 { f = (a) => a / 2.0 }
  i = i + 1
}
print(f(3))
