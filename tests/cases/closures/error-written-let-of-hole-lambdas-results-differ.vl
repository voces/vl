// @error cannot write a lambda to 'f': called at (i32) it returns f64, where a lambda, also written to it, returns i32
// The same refusal over un-annotated lambdas, the write inside a loop (D9003).
let f = (a) => a + 1
let i = 0
while i < 3 {
  if i == 1 { f = (a) => a / 2.0 }
  i = i + 1
}
print(f(3))
