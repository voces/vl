// @run
// @log z
// @log a
// @log b
// @log true
// D2552: a value call whose callee is a lambda literal or a closure-list element over a niche
// signature (`string | null`, a literal union) keyed no `$fnsig` from the callee's type, so it
// took an unrelated arity functype, and a `null` argument into a nullable closure parameter was
// recovered as non-null. The callee is keyed by its own lambda, and the argument is not.
import { toString } from "std:fmt"

type LI = "a" | "b"
function pickS(): string | null { return "z" }
function none(): string | null { return null }
function pickL(): LI { return "a" }
function viaParen(r: string | null): string | null {
  return ((x: string | null) => x)(r)
}
function viaList(r: LI): LI {
  const fs = [(x: LI) => x, (y: LI): LI => if y == "a" { "b" } else { "a" }]
  print(fs[0](r))
  return fs[1](r)
}
function viaBinding(r: string | null) {
  const f = (x: string | null) => x == null
  if f(r) { return "none" }
  return "some"
}
print(viaParen(pickS()) ?? "none")
print(viaList(pickL()))
print(toString(viaBinding(none()) == "none"))
