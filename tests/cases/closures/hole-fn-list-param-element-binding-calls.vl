// @run
// @log 1.5
// @log 4
// @log 1.5
// @log 1.5
// @log 1.5
// @log 4
// @log 1.5
// @log 6
// A function with an un-annotated list parameter of lists of functions whose results differ, read
// through a binding of an element, or of a loop's element, before the call: each call dispatches
// on the member the id names (D16748).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function dbl(a) { return a * 2 }
function bound(xs) {
  const y = xs[1]
  print(y[0](3))
}
function looped(xs) {
  for x in xs {
    const y = x
    print(y[0](3))
  }
}
function deep(xs) {
  const y = xs[1][0]
  print(y[0](3))
}
function deepBound(xs) {
  const y = xs[1]
  print(y[0][0](3))
}
function deepLooped(xs) {
  for x in xs {
    const y = x[0]
    print(y[0](3))
  }
}
bound([[inc0], [half]])
looped([[inc0], [half]])
deep([[[inc0]], [[half]]])
deepBound([[[inc0]], [[half]]])
deepLooped([[[inc0]], [[half]]])
bound([[inc0], [dbl]])
