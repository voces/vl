// @run
// @log 3
// @log 3
// @log 6
// @log 3
// @log 6
// @log 2
// @log 3
// @log 6
// @log 2.5
// @log 1
// @log 6
// @log abab
// @log 2.5
// @log 7
// @log 14
// @log 6
// @log 8
// @log 6
// @log 24
// @log 8
// @hint redundant type annotation: `loc` is inferred as `i32`
// A `const` bound to an `if` or `match` choosing between two generic or un-annotated functions
// is that choice wherever it is read: handed to a generic or concrete higher-order parameter,
// as a `.map` / `.filter` callback, or returned, each arm instanced at the type that pins the
// binding (D9080).
function idg<T>(t: T): T { return t }
function kg<T>(t: T): T { return t + t }
function idu(t) { return t }
function ku(t) { return t + t }
function pg<T>(t: T) { return t > 2 }
function qg<T>(t: T) { return t > 100 }
function app<T>(g: (x: T) => T, v: T): T { return g(v) }
function ap<T, R>(g: (x: T) => R, v: T): R { return g(v) }
function use(g: (x: i32) => i32) { return g(3) }
const c = [1].length > 0
const n = [1].length - 1
const h1 = if c { idg } else { kg }
print(app(h1, 3))
const h2 = match n {
  0 => idg
  _ => kg
}
print(ap(h2, 3))
const h3 = if c { kg } else { idg }
print([3].map(h3)[0])
const h4 = if c { idu } else { ku }
print(use(h4))
const h5 = match n {
  1 => idu
  _ => ku
}
print(app(h5, 3))
const h6 = if c { pg } else { qg }
print([1, 3, 5].filter(h6).length)
function pick(c: boolean): (x: i32) => i32 {
  const h = if c { idg } else { kg }
  return h
}
print(pick(true)(3))
print(pick(false)(3))
const h7 = if c { kg } else { idg }
print(app(h7, 1.25))
print([0.5].map(h7)[0])
function run<T>(v: T, c: boolean): T {
  const h = if c { kg } else { idg }
  return app(h, v)
}
print(run(3, true))
print(run("ab", true))
print(run(2.5, false))
function loc(c: boolean): i32 {
  const h = if c { idg } else { kg }
  return app(h, 3) + [4].map(h)[0]
}
print(loc(true))
print(loc(false))
const h8 = if c { kg } else { idg }
const h9 = h8
print(app(h9, 3))
print([4].map(h9)[0])
const h10 = if c { kg } else { idg }
print(app(h10, 3))
print(app(h10, 5) + [7].map(h10)[0])
print(h10(4))
