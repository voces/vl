// @run
// @log 3
// An `if` of un-annotated functions whose bodies give different results, handed to a callee that
// calls it, dispatches in the callee's instance on the arm it holds (D16094).
function only(n, f) { return f(n) }
function twice(s) { return s + s }
function lenOf(s) { return s.length }
const k = [1].length > 1
print(only("abc", if k { twice } else { lenOf }))
