// Missing-key variant of `module-holder-of-bundles-both-members`: the holder reads key `z`, so it holds null.
// Each member of the holder called from its own function (D17111).
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
const m = Map()
m["a"] = lap((a) => a + 1)
const x = m["z"]
function g() {
  if x != null { return x(4) }
  return 0
}
function h() {
  if x != null { return x(1.5) }
  return 0.0
}
print(g())
print(h())
// @hint Intentionally-unused variable `_a`
// @hint Intentionally-unused variable `_b`
