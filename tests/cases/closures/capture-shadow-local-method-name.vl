// @run
// @log 3
// @log 12
// @log x!
// @log hi!
// @log 1001
// @log 101
// @log 105
// @log 5
// @log 2
// @log 6
// @log 3
// @log 5
// @log 2.5
// @log 6
// @log 7
// @hint redundant type annotation: `pt` is inferred as `{v: i32}`
// @hint redundant type annotation: `q` is inferred as `{w2: () => i32}`

// D2068 — a local closure named like a module function is what a method call `v.name()`
// in its scope reaches, because a lexical binding wins. Respelling shadowing bindings must
// not move such a call onto the module function: each case prints the local's answer.

function twice(self: i32) { return self * 2 }
function tag(self: i32) { return self * 2 }
function inc(self: i32) { self + 1 }

function methodOnLocal() {
  const twice = (x: i32) => x * 3
  const g = () => twice(1)
  print(g())
  print(4.twice())
}
methodOnLocal()

function methodOnLocalOtherType() {
  const tag = (s: string) => s + "!"
  const g = () => tag("x")
  print(g())
  print("hi".tag())
}
methodOnLocalOtherType()

function methodAfterInnerShadow() {
  const inc = (x: i32) => x + 100
  const fs: (() => i32)[] = []
  {
    const inc = (x: i32) => x + 1000; fs.push(() => inc(1))
  }
  fs.push(() => inc(1))
  print(fs[0]())
  print(fs[1]())
  print(5.inc())
}
methodAfterInnerShadow()

// A method call elsewhere in the module does not stop a shadow inside a function from being
// told apart: a UFCS call `p.v2()` and a field call `q.w2()`.
type Pt = { v: i32 }
type Q = { w2: () => i32 }
function v2(self: Pt) { return self.v }
function unrelatedUfcs() {
  const v2 = 5
  const g = () => {
    print(v2)
    if true { const v2 = 2; print(v2) }
    print(v2 + 1)
  }
  g()
}
unrelatedUfcs()
const pt: Pt = { v: 3 }
print(pt.v2())
function unrelatedField() {
  const w2 = 5
  const g = () => {
    print(w2)
    if true { const w2 = 2.5; print(w2) }
    print(w2 + 1)
  }
  g()
}
unrelatedField()
const q: Q = { w2: () => 7 }
print(q.w2())
