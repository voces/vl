// @run
// @log 1
// @log 5
// @log 1
// @log 5
// @log 1
// @log 5
// A list of one hole parameter slot-written with a second, the listed one bound to a different generic
// at each call: every call binds both at the union of what all calls hand them (D15577).
function id<T>(x: T): T { x }
function id2<U>(x: U): U { x }
function id3<V>(x: V): V { x }
function use(ys) { print(ys.length) }
function take(a, b) {
  const xs = [a]
  xs[0] = b
  use(xs)
  print(xs[0]("abc").length + xs[0](2))
}
take(id, id2)
take(id3, id2)
take(id3, id)
