// @run
// @log 4
// @log 2
// @log 2
// @log 9
// @log 4
// @log 6
// A `const` aliasing a list at a readonly list of a wider function type is held at the list's own
// storage and read through it, not copied (D17816): a push to the source shows through the alias,
// an element is delivered at the wide type, the alias is handed to a readonly-list parameter, and
// a function's local alias is walked.
function inc(a: i32) { return a + 1 }
function dec(a: i32) { return a - 1 }
type W = (x: i32) => i32 | f64
const b = [inc]
const z: readonly W[] = b
b.push(dec)
print(z[0](3))
print(z[1](3))
print(z.length)
const g: W = z[1]
print(g(10))
function take(q: readonly W[]) { print(q[0](3)) }
take(z)
function f() {
  const c = [inc]
  const y: readonly W[] = c
  for h in y { print(h(5)) }
}
f()
