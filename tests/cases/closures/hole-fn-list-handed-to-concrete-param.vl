// @run
// @hint Intentionally-unused parameter `_n` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_n` (leading `_` marks it unused)
// @log 6
// @log 4
// @log 10
// @log 6
// @log 7
// @log 8
// A list handed at its parameter's storage is the same list: a list of un-annotated functions
// at a concrete closure parameter, a list of such lists, and a record list at its record-or-null
// twin, each called or read in the callee.
type C = { n: i32 }
function inc(a) { return a + 1 }
function dbl(a) { return a * 2 }
function flat(_n) {
  let u = [inc, dbl]
  u = [dbl, inc]
  return u
}
function nested(_n) {
  let w = [[inc], [dbl]]
  w = [[dbl], [inc]]
  return w
}
function take(fs: ((a: i32) => i32)[]) {
  print(fs[0](3))
  print(fs[1](3))
}
function takeNested(ws: ((a: i32) => i32)[][]) {
  print(ws[0][0](5))
  print(ws[1][0](5))
}
function readTwins(cs: readonly (C | null)[]) {
  for c in cs {
    if c == null { print("null") } else { print(c.n) }
  }
}
take(flat(1))
takeNested(nested(1))
const cs: C[] = [{ n: 7 }, { n: 8 }]
readTwins(cs)
