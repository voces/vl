// @run
// @log x!
// @log y!
// @log x!
// @log x!
// @log y!
// @log x!
// @log x!y
// @log x!
// D9282: a generic returned from an un-annotated function and bound at a literal-union
// parameter with a `string` result is built returning the string, at every delivery.
type K = "x" | "y"
function same<T>(k: T): T { k }
function first<T>(xs: T[]): T { xs[0] }
function d1() { return same }
const v1: (k: K) => string = d1()
print(v1("x") + "!")
function d2() { return same }
function use(f: (k: K) => string) { f("y") }
print(use(d2()) + "!")
function d3() { return same }
function relay(): (k: K) => string { return d3() }
print(relay()("x") + "!")
function d4() { return same }
function zed(k: K): string { k }
let v4: (k: K) => string = zed
v4 = d4()
print(v4("x") + "!")
function d5() { return same }
type Box = { f: (k: K) => string }
const b5: Box = { f: d5() }
print(b5.f("y") + "!")
function d6() { return same }
const v6: (k: K) => string | null = d6()
print((v6("x") ?? "n") + "!")
function d7() { return same }
const v7: (k: K) => string = d7()
const u7: (k: K) => K = same
print(v7("x") + "!" + v7(u7("y")))
function d8() { return first }
const v8: (xs: K[]) => string = d8()
print(v8(["x", "y"]) + "!")
