// @run
// @log 4
// @log qC
// @log xC
// @log 2
// @log 1
// A hole function's closure retagged between an open and a closed closure rep is the same
// function: called through a module cell, a narrowed local and a list element, it computes the
// same. A map of an uncalled hole function retags too; calling through it would pin the hole.
function other<V>(v: V) { print(v) }
let gk = other
gk = (n) => {
  print(n + 1)
}
function viaGlobal() {
  let v = [gk]
  v = [gk]
  v[0](3)
}
function viaLocalList(x: string) {
  const c = (y) => y + "C"
  print(c("q"))
  const fs = [c, c]
  print(fs[1](x))
}
function half(a) { return a / 2.0 }
function viaUncalledMap() {
  const m5 = Map()
  m5.set("a", half)
  const zs = [m5, m5]
  print(zs.length)
  print(zs[1].length)
}
viaGlobal()
viaLocalList("x")
viaUncalledMap()
