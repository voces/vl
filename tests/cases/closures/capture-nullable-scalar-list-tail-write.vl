// @run
// @log x
// @log 2 2
// @log 1 1
// @log 2
// @log 2
// @log 1
// @log 2
// @log 0
// @log 0
// @log q
// @hint redundant type annotation: `f` is inferred as `string`
// @hint redundant type annotation: `g` is inferred as `string`
// @hint redundant type annotation: `h` is inferred as `string`
// @hint redundant type annotation: `read` is inferred as `i32`
// @hint redundant type annotation: `readF32` is inferred as `i32`
// @hint redundant type annotation: `viaParam` is inferred as `i32`
// @hint redundant type annotation: `passes` is inferred as `i32`
// D2399: a closure whose value is a write to a captured `string[] | null` or `f64[] | null`
// returns that nullable list, as a named function does. Its result and the value call that
// reads it take the list's own nullable wrapper, as a function value's parameter does.
function f(): string {
  let v: string[] | null = ["a"]
  const q = () => {
    v = v
  }
  q()
  "x"
}
print(f())
function g(): string {
  let v: f64[] | null = [1.5]
  const w: f64[] | null = [2.5, 3.5]
  const q = () => {
    v = w
  }
  const got = q()
  let n = 0
  if got != null { n = got.length }
  let m = 0
  if v != null { m = v.length }
  "\{n} \{m}"
}
print(g())
function h(): string {
  let v: i64[] | null = [1]
  const q = (): i64[] | null => {
    v = v
  }
  const got = q()
  let n = 0
  if got != null { n = got.length }
  let m = 0
  if v != null { m = v.length }
  "\{n} \{m}"
}
print(h())
function read(): i32 {
  const v: string[] | null = ["a", "b"]
  const q = () => {
    v
  }
  const got = q()
  if got != null { return got.length }
  0
}
print(read())
function readF32(): i32 {
  const v: f32[] | null = [1.5, 2.5]
  const q = () => {
    v
  }
  const got = q()
  if got != null { return got.length }
  0
}
print(readF32())
function viaParam(p: string[] | null): i32 {
  if p != null { return p.length }
  0
}
function passes(): i32 {
  let v: string[] | null = ["a"]
  const q = () => {
    v = v
  }
  viaParam(q())
}
print(passes())
function len(x: f64[] | null) {
  if x != null { return x.length }
  0
}
function apply(g: (f64[] | null) => i32, v: f64[] | null) { g(v) }
print(apply(len, [1.5, 2.5]))
print(apply(len, null))
const byValue: (u8[] | null) => i32 = (k) => {
  if k != null { return k.length }
  0
}
print(byValue(null))
function mks(): string[] | null { ["q"] }
function call(g: () => string[] | null) { g() }
const got = call(mks)
if got != null { print(got[0]) }
