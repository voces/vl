// @run
// @log O
// @log 1
// A capture cell in a generic body with two writer closures and one instance runs at each instance's own
// type (D3939, `rv3498/v08`).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function third<Z>(z: Z) { print("T"); print(z) }
function a<T>(x: T, w: i32) {
  let k = inner
  const toO = () => {
    k = other
  }
  const toT = () => {
    k = third
  }
  if w == 1 { toO() }
  if w == 2 { toT() }
  k(x)
}
a(1, 1)
