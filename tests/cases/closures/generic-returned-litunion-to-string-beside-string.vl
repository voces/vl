// @run
// @log x!q
// D9282: one un-annotated function returning a generic, bound at a literal-union parameter
// with a `string` result and at a `string` parameter, gets one copy per destination.
type K = "x" | "y"
function same<T>(k: T): T { k }
function deliver() { return same }
const v: (k: K) => string = deliver()
const w: (k: string) => string = deliver()
print(v("x") + "!" + w("q"))
