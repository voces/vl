// @run
// @log 30
// @log 2
// @log 30
// @log 1.75
// A forwarded hole function its callee calls at two argument types, each of which the
// function's body types, binds once per call (D13201).
function add(a, b) { return a + b }
function apply3(g, s) {
  print(g(10, 20))
  print(g(s, 1.5))
}
function inner(k, h) { apply3(h, k) }
inner(0.5, add)
function innerList(k, h) {
  for f in [apply3] { f(h, k) }
}
innerList(0.25, add)
