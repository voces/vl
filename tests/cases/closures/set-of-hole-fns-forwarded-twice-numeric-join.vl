// @run
// @log 3.5
// @log 4
// @log 3.5
// @log 4
// A set of hole functions whose results join i32 with f64, handed through two un-annotated
// functions before the call, reads the join at each member: a written `let` and a choice alike,
// with the f64 member or the i32 member running (D17863's numeric controls).
function add0(a, b) { return a + b }
function addh(a, b) { return a + b / 2.0 }
function v(k, p, q) { return k(p, q) }
function w(h, x, y) { return v(h, x, y) }
let f = add0
f = addh
print(w(f, 3, 1))
let e = addh
e = add0
print(w(e, 3, 1))
function flag() { return 1 > 0 }
const c = if flag() { addh } else { add0 }
print(w(c, 3, 1))
const d = if flag() { add0 } else { addh }
print(w(d, 3, 1))
