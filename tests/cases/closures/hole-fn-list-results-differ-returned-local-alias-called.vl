// @run
// @log 4
// @log 4
// @log 1.5
// @log 4
// @info `k` is never reassigned; use `const` instead of `let`
// A returned list's records hold functions of different results, and a function-local binding
// of one of them is called: the call is direct, and the binding holds the member's id where the
// set is tagged (D15927). A `const` of each member and a `let`.
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function pick(b: boolean) {
  if b { return [{ f: inc0 }] }
  return [{ f: half }]
}
print(pick(true)[0].f(3))
function go() {
  const g = inc0
  print(g(3))
}
go()
function go2() {
  const h = half
  print(h(3))
}
go2()
function go3() {
  let k = inc0
  print(k(3))
}
go3()
