// @run
// @hint redundant type annotation: `l` is inferred as `{r: i32}[]` — remove it to lean on inference
// @log 2
// @log 9
// @log 2
// D3058: a lambda returning a captured record list as `readonly Shape[]` delivers it as a view,
// in both faces and from a block body, and reads the source's later growth.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function mkf(x: Circle[]): () => readonly Shape[] { return () => x }
function mkb(x: Circle[]): () => readonly Shape[] {
  return () => {
    return x
  }
}
function mka(x: Circle[]): () => readonly Shape[] {
  return (): readonly Shape[] => x
}
const l: Circle[] = [{ r: 1 }]
const f = mkf(l)
const b = mkb(l)
const a = mka(l)
l.push({ r: 9 })
print(f().length)
const k = b()[1]
if k is Circle { print(k.r) }
print(a().length)
