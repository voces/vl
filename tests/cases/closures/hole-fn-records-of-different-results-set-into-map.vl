// @run
// @log 1.5
// Records holding un-annotated functions of different results, written into one un-annotated
// `Map()` and read back through a binding, run the member stored in the entry read, as the same
// pair in a list does (D9370, D15801).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const m = Map()
m.set("a", { f: inc0 })
m.set("b", { f: half })
const r = m.get("b")
if r != null { print(r.f(3)) }
