// @error cannot write 'inc' to an element of 'ys': a call through it at (string) runs it, and it is (i32) => i32
// A list of a generic function written with a fixed-type function refuses when it is handed to an
// un-annotated parameter that calls through the written element at a type it cannot take (D10120).
function id<T>(x: T): T { x }
function inc(x: i32): i32 { x + 1 }
const ys = [id]
ys.push(inc)
function run(a) { print(a[1]("s")) }
run(ys)
