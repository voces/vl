// @run
// @warning Unused parameter `n`
// @log 6
// @log 6
// @log 5
// @log 1
// @log 5
// @log 6
// @log 6
// @log 6
// @log 2.5
// @log 4
// @log 4
// @log 2
// @log 3
// @log ab
// @log 2.5
// @log 6
// @log 2.5
// A list literal of un-annotated functions returned from an un-annotated function keeps the type
// its caller's pin gives it when the call is the receiver of `.map` or `.filter` itself, when the
// literal is nested under a function with an un-annotated parameter, and when its elements are
// the function's own un-annotated parameter (D9550-D9552).
function inc0(a) { return a + 1 }
function dbl0(a) { return a * 2 }
function deliver0(n) { return [inc0, dbl0] }
print(deliver0(1).map((f) => f(3))[1])

function inc1(a) { return a + 1 }
function dbl1(a) { return a * 2 }
function deliver1(n) { return [inc1, dbl1] }
print(deliver1(1).map((f) => f(3))[1])
print(deliver1(2).map((f) => f(4))[0])

function inc2(a) { return a + 1 }
function dbl2(a) { return a * 2 }
function deliver2(n) { return [inc2, dbl2] }
print(deliver2(1).filter((f) => f(3) > 5).length)
const v2 = deliver2(2)
print(v2.map((f) => f(4))[0])

function inc3(a) { return a + 1 }
function dbl3(a) { return a * 2 }
function deliver3(n) { return [[inc3, dbl3]] }
const v3 = deliver3(1)
print(v3[0][1](3))

function inc4(a) { return a + 1 }
function dbl4(a) { return a * 2 }
function deliver4(n) { return [[inc4, dbl4]] }
print(deliver4(1)[0].map((f) => f(3))[1])

function inc5(a) { return a + 1 }
function dbl5(a) { return a * 2 }
function deliver5(n) { return [[inc5, dbl5]] }
const v5 = deliver5(1)
print(v5[0][1](3))
const w5 = deliver5("s")
print(w5[0][0](1.5))

function inc6(a) { return a + 1 }
function deliver6(g) { return [g, g] }
const v6 = deliver6(inc6)
print(v6.map((f) => f(3))[1])

function inc7(a) { return a + 1 }
function deliver7(g) { return [g, g] }
print(deliver7(inc7).map((f) => f(3))[1])
const u7 = deliver7(inc7).filter((f) => f(1) > 1)
print(u7.length)

function deliver8(g) { return [g, g] }
const v8 = deliver8(2)
print(v8.map((x) => x + 1)[1])
const w8 = deliver8("a")
print(w8.map((x) => x + "b")[0])

function half9(a) { return a / 2.0 }
function deliver9(g) { return [g, g] }
const w9 = deliver9(half9)
print(w9.map((f) => f(5.0))[0])

function inc10(a) { return a + 1 }
function dbl10(a) { return a * 2 }
function deliver10(n) { return [inc10, dbl10] }
print(deliver10(1).map((f) => f(3))[1])
const w10 = deliver10("s")
print(w10[0](1.5))
