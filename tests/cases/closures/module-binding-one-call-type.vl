// @warning Unused function `w1`
// @hint redundant type annotation: `w1` is inferred as `i32`
// A module-scope binding called at one argument type through a lambda with two instances, and
// written only in a function nothing calls, holds the instance its calls want (D3857).
const c = (y) => y + y
const e = (y) => y + y + y
print(c(4))
print(c("a"))
let d2 = c
print(d2("a"))
function w1(): i32 { d2 = e; 0 }
