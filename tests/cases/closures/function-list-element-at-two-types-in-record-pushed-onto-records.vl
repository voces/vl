// @run
// @log 4
// @log 2.25
// @log 6
// A function set called at two types and pushed inside a record onto a list of records is not one
// closure called at both: the split plan types each use (D15062).
function inc0(a) { return a + 1 }
function dbl0(a) { return a * 2 }
function deliver0() { return [inc0] }
function take0(a) { print(a[0](3)) }
take0(deliver0())
print(deliver0()[0](1.25))
const r = { f: dbl0 }
const rs = [r]
rs.push({ f: inc0 })
print(rs[1].f(5))
