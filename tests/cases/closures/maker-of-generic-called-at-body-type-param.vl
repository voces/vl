// @run
// @info `a` is never reassigned; use `const` instead of `let`
// @log 1
// @log z
// @log 2
// @log 3
// @log 4
// @log 5
// @log 6
// A function returning a generic, whose result is called in a generic body at the body's own
// type parameter, is typed at the one pin every instance agrees on (D6003).
function k<T>(x: T): T { return x }
function kH(x) { return x }
function mk1() { return k }
function mk2() { return k }
function mk3() { return kH }
function mk4() { return k }
function mk5() { return k }
function mk6() { return k }
function mk7() { return k }
function g1<U>(u: U) {
  const a = mk1()
  print(a(u))
}
function g2<U>(u: U) {
  const a = mk2()
  print(a(u))
}
function g3<U>(u: U) {
  const a = mk3()
  print(a(u))
}
function g4(u) {
  const a = mk4()
  print(a(u))
}
function g5<U>(u: U) {
  let a = mk5()
  print(a(u))
}
function g6<U>(u: U) { print(mk6()(u)) }
function g7<U>(u: U): U {
  const a = mk7()
  return a(u)
}
g1(1)
g2("z")
g3(2)
g4(3)
g5(4)
g6(5)
print(g7(6))
