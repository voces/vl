// @run
// @log 5
// @log 8
// @log 5
// @log 8
// @log 5
// @log 8
// @log 5
// @log 8
// The element of an inline list handed beside an annotated one is pinned at its own call when the
// body reads it through `.map`, a record field, a relaying parameter, or an annotation of another
// width (D9360).
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function viaMap(a) {
  if a.length == 0 { return 0 }
  return a.map((f) => f(4))[0]
}
const e: ((x: i32) => i32)[] = [dbl]
print(viaMap([inc0, dbl]))
print(viaMap(e))
function viaField(r) { return r.xs[0](4) }
const re: { xs: ((x: i32) => i32)[] } = { xs: [dbl] }
print(viaField({ xs: [inc0] }))
print(viaField(re))
function early(a) { return a[0](4) }
function mid(a) { return early(a) }
print(mid([inc0]))
print(mid(e))
const wide: ((x: i64) => i64)[] = [(x: i64) => x * 2]
print(early([inc0]))
print(early(wide))
