// @run
// @log 2
// @log 2.5
// @log 3
// @log 3.5
// @log 4
// @log 4.5
// @log 6
// @log 6.5
// A record a function returns, its function field written another function, called directly at
// two types through the field: top level, inside a function, through a `const` copy, and written by
// another function (D15270).
function id0(a) { return a }
function id1(a) { return a }
function mk() { return { f: id1 } }
const r = mk()
r.f = id0
print(r.f(2))
print(r.f(2.5))
function run() {
  const q = mk()
  q.f = id0
  print(q.f(3))
  print(q.f(3.5))
}
run()
const w = mk()
const al = w
al.f = id0
print(al.f(4))
print(w.f(4.5))
const t = mk()
function setIt() { t.f = id0 }
setIt()
print(t.f(6))
print(t.f(6.5))
