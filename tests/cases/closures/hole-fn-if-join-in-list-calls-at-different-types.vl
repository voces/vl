// @run
// @log 3
// @log 4
// @log 30
// D7841 with an `if` join as one of the list's elements.
function add(a, b) { return a + b }
function apply2(g) {
  print(g(1, 2))
  print(g(1.5, 2.5))
}
function apply3(g) { print(g(10, 20)) }
function main(c: boolean) {
  const fs = [if c { apply2 } else { apply3 }, apply3]
  for f in fs { f(add) }
}
main(true)
