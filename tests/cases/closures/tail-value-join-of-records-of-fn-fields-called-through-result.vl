// @run
// @log 6
// @log 4
// @log 1.5
// @log 4
// @log 5
// @log 6
// @log 4
// A function whose tail is a value `if` or `match` of records holding un-annotated functions is
// called through its result as the same arms returned are (D15925). Each maker has its own pair.
function two() { [1, 2].length }
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function pick(b: boolean) {
  if b { { f: inc0 } } else { { f: dbl } }
}
print(pick(two() > 5).f(3))
print(pick(true).f(3))
function inc1(a) { return a + 1 }
function half(a) { return a / 2.0 }
function pickHalf(b: boolean) {
  if b { { f: inc1 } } else { { f: half } }
}
print(pickHalf(two() > 5).f(3))
print(pickHalf(true).f(3))
function inc2(a) { return a + 1 }
function dbl2(a) { return a * 2 }
function pickN(b: boolean) {
  if b { { f: inc2, n: 1 } } else { { f: dbl2, n: 2 } }
}
const r = pickN(two() > 1)
print(r.f(3) + r.n)
function inc3(a) { return a + 1 }
function dbl3(a) { return a * 2 }
function pickM(k: i32) {
  match k {
    0 => {
      { f: inc3 }
    }
    _ => {
      { f: dbl3 }
    }
  }
}
print(pickM(two()).f(3))
print(pickM(0).f(3))
