// A closed list written through element 0 inside a generic instanced twice (D15454).
function inc(x: i32) { x + 1 }
function dbl(x: i32) { x * 2 }
function go<T>(v: T, f: (x: i32) => i32) {
  const r = [inc]
  r[0] = f
  print(r[0](3))
  print(v)
}
go("a", dbl)
go(1, inc)
