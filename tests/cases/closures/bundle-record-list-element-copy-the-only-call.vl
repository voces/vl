// @run
// @log 1
// @hint Intentionally-unused variable `_a`
// @hint Intentionally-unused variable `_b`
// A list element holding a record of one closure per signature, read only through a copy called
// at one signature.
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
const u = lap((a) => a / 2)
const xs = [u]
const v = xs[0]
print(v(3))
