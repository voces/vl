// A `??` default naming an un-annotated or generic function, over a map read of another, is the
// join's function at each position the joined value reaches: called at once, parenthesised, bound,
// passed on, returned then bound (called straight off the call is D17669), inside a function, in a
// loop, at an f64 call and as a generic's instance.
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function id<T>(x: T): T { return x }
function apply(f: (n: i32) => i32, v: i32) { return f(v) }
const m = Map()
m["k"] = inc0
print((m["j"] ?? dbl)(3))
print(((m["j"]) ?? (dbl))(4))
const h = m["j"] ?? dbl
print(h(5))
print(apply(m["j"] ?? dbl, 6))
function pick(key: string) { return m[key] ?? dbl }
const pj = pick("j")
print(pj(7))
const pk = pick("k")
print(pk(7))
function inner() { print((m["j"] ?? dbl)(8)) }
inner()
let s = 0
for i in 1 to 3 { s = s + (m["j"] ?? dbl)(i) }
print(s)
print((m["j"] ?? id)(9))
const f = Map()
f["k"] = inc0
print((f["j"] ?? dbl)(2.5))
