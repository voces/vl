// @run
// @log abcabc
// @log xy
// @log 20
// @log 9
// @log 20
// @log 5
// @log 6
// @log 6
// @log 4
// An `if` or `match` choosing between un-annotated functions whose bodies give one result at
// each type a call through the choice passes runs whichever arm it took (D13740's neighbours).
function only(n, f) { return f(n) }
function twice(s) { return s + s }
function inner(s) { return s }
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function dec(a) { return a - 1 }
const yes = [1, 2].length > 1
// Handed to a callee that calls it, and bound to a name.
print(only("abc", if yes { twice } else { inner }))
const g = if yes { inner } else { twice }
print(g("xy"))
// An `else if` chain and a `match`, called at two types where every arm agrees at each.
const pick = [1, 2, 3].length
const h = if pick == 0 { inc0 } else if pick == 1 { dbl } else { dec }
print(only(10, if yes { dbl } else { inc0 }))
print(h(10))
const m = match pick {
  0 => inc0
  3 => dbl
  _ => dec
}
print(m(10))
print(m(2.5))
// Called directly, returned, and delivered at an annotated function type.
print((if yes { dbl } else { inc0 })(3))
function get(b: boolean) { return if b { dbl } else { inc0 } }
print(get(yes)(3))
function w(q: (a: i32) => i32) { return q(3) }
print(w(if yes { inc0 } else { dbl }))
