// @run
// @log 6
// @log 3
// @log -1.5
// @log 4!
// @log <8>
// @log 12
// @log 9
// @log 10
// @log 11
// @log 5.5
// @log 5.5
// @log 2.5
// @log 1.5
// @log 3.5!
// @log <7.5>
// @log 8.5
// @log 10.5
// @log 4.5
// @hint Intentionally-unused variable `_a`
// @hint Intentionally-unused variable `_b`
// The call of a returned bundle record's member, straight off the call that returns it
// (`lap(f)(4)`) in a function per position, and through a module list's element that holds the
// record whole (`xs[0](4)`), each delivered to a position: a scalar and a union parameter, a
// nested call, a concat operand, an interpolation hole, a `return`, a `let`, an `if` arm (the
// call off the result only: legacy refuses the element's call there), a `??` operand and a
// record field. `lap` calls its parameter at two signatures, so it returns one closure per
// signature. A list local to a function has an open type, so the element's positions are at
// module scope.
type R = { n: f64 }
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
function id(x: f64) { return x }
function show(u: f64 | string) {
  if u is f64 { print(u) } else { print(u) }
}
function atScalar(k: i32) { print(id(lap((a) => a + k)(4))) }
function atUnion(k: i32) { show(lap((a) => a * k)(1.5)) }
function nested(k: i32) { print(id(id(lap((a) => a - k)(0.5)))) }
function concat(k: i32) { print("" + "\{lap((a) => a + k)(2)}" + "!") }
function interp(k: i32) { print("<\{lap((a) => a + k)(6)}>") }
function viaReturn(k: i32) { return lap((a) => a + k)(10) }
function viaLet(k: i32) {
  const w = lap((a) => a + k)(7)
  print(w)
}
function ifArm(c: boolean, k: i32) {
  print(if c { lap((a) => a + k)(8) } else { 0.0 })
}
function coalesce(m: Map<string, f64>, k: i32) {
  print(m["k"] ?? lap((a) => a + k)(9))
}
function field(k: i32) {
  const q: R = { n: lap((a) => a + k)(3.5) }
  print(q.n)
}
atScalar(2)
atUnion(2)
nested(2)
concat(2)
interp(2)
print(viaReturn(2))
viaLet(2)
ifArm(true, 2)
coalesce(Map(), 2)
field(2)
const xs = [lap((a) => a + 1)]
print(id(xs[0](4.5)))
show(xs[0](1.5))
print(id(id(xs[0](0.5))))
print("" + "\{xs[0](2.5)}" + "!")
print("<\{xs[0](6.5)}>")
const v = xs[0](7.5)
print(v)
const m: Map<string, f64> = Map()
print(m["k"] ?? xs[0](9.5))
const r: R = { n: xs[0](3.5) }
print(r.n)
