// @error cannot write 'name' to an element of 'ys': a call through it at (i32) runs it, and it is (i32) => string
// A list of a generic function pushed a function whose parameter fits the call but whose result
// type is another refuses a call through an un-annotated parameter (D10200).
function id<T>(x: T): T { x }
function name(x: i32): string { "n" }
const ys = [id]
ys.push(name)
function run(a) { print(a[1](3)) }
run(ys)
