// @run
// @log 3
// @log xy
// @log 30
// @log pq
// A second delivery: the list read at a computed index, the argument called at `i32` and at
// `string` (D7183).
function add(a, b) { return a + b }
function apply2(g) {
  print(g(1, 2))
  print(g("x", "y"))
}
function apply3(g) {
  print(g(10, 20))
  print(g("p", "q"))
}
const fs = [apply2, apply3]
let i = 0
while i < fs.length {
  fs[i](add)
  i = i + 1
}
