// @run
// @log 1
// @log s
// A generic handed to an un-annotated identity function whose result is called at two types: no
// one closed type fixes the parameter, so the binding declines and each call takes its own
// instance as before (D5530's control).
function k<T>(x: T): T { return x }
function fw(f) { return f }
const v = fw(k)
print(v(1))
print(v("s"))
