// @run
// @log 1
// @log s
// @log loud
// @log 3
// @log 50
// A written binding of two generics called at two types, delivered through a map set (control) at a
// closed function type, is delivered through an adapter and keeps the value it held there.
function id<T>(x: T): T { return x }
function loud<T>(x: T): T {
  print("loud")
  return x
}
function main() {
  let f = id
  print(f(1))
  print(f("s"))
  const m: Map<string, (x: i32) => i32> = Map()
  m.set("k", f)
  f = loud
  print(f(3))
  const mg = m.get("k")
  if mg != null { print(mg(50)) }
}
main()
