// @run
// @log mk
// @log 2
// @log abc
// @log 5
// @log true
// @log mk
// @log 7
// @log x
// A `const` bound to a call returning a generic, both listed and called directly, is called at
// each type through both, and the call runs once; the list alone is the control (D9594).
function id<T>(x: T): T { x }
function mk() {
  print("mk")
  return id
}
const v = mk()
const xs = [v]
print(xs[0](2))
print(xs[0]("abc"))
print(v(5))
print(v(true))
const u = mk()
const ys = [u]
print(ys[0](7))
print(ys[0]("x"))
