// @run
// @log 1
// @log 2
// @log 3
// @log 2
// @log 1
// @warning Unused parameter `f` (prefix with `_` to suppress, or remove it)
// @warning Unused variable `k` (prefix with `_` to suppress, or remove it)
// A hole function no call instances is built as no body wherever every use of it is inert,
// through the value it reaches: a parameter annotated by a type parameter nothing else names
// (D6910), a call result handed on (D6911), a callee that aliases a function whose default
// builds (D6912), an alias handed on (D6913), and a list measured in place (D6914).
function apply3(g) { print(g(1, 2)) }
function exclaim(s) { return s + "!" }
function inc(x) { x + 1 }

function runT<F>(f: F) { print(1) }
function get() { return exclaim }
function run(f) { print(2) }
function keep(f) {
  const k = f
  print(3)
}

runT(apply3)
run(get())
keep(inc)
const h = apply3
run(h)
print([exclaim].length)
