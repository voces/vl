// @run
// @log L
// @log 3
// @log O
// @log true
// A `let` first bound to a generic and then written with a lambda, delivered in a list to a
// hole parameter and called there, calls the lambda at the call's type (D7141).
function other<V>(v: V) { print("O"); print(v) }
function run(fs) { fs[0](3) }
function main() {
  let k = other
  k = (n) => {
    print("L"); print(n)
  }
  run([k])
  other(true)
}
main()
