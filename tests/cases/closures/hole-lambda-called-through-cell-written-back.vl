// @hint redundant type annotation: `w` is inferred as `i32` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// @hint redundant type annotation: `w` is inferred as `i32` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// @hint redundant type annotation: `w` is inferred as `i32` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// @hint redundant type annotation: `w` is inferred as `i32` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// A hole lambda called through a capture cell and then written back into the cell, directly or
// by a nested writer, keeps the signature the call gave it; each read sees the latest write.
function f(n: i32) {
  const c = (y) => y + 1
  const g = (y) => y * 2
  let d = c
  print(d(n))
  function w(): i32 { d = g; 0 }
  w()
  d = c
  print(d(n))
}
f(5)
function alias(n: i32) {
  const c = (y) => y + 1
  const g = (y) => y * 2
  let d = c
  const k = d
  print(d(n))
  function w(): i32 { d = g; 0 }
  d = c
  print(k(n))
  w()
  print(d(n))
  print(k(n))
  d = c
  print(d(n))
}
alias(7)
function branch(n: i32, flip: boolean) {
  const c = (y) => y + 1
  const g = (y) => y * 2
  let d = c
  print(d(n))
  function w(): i32 { d = g; 0 }
  if flip { w() } else { d = c }
  print(d(n))
  d = c
  print(d(n))
}
branch(5, true)
branch(5, false)
function text(x: string) {
  const c = (y) => y + "!"
  const g = (y) => y + y
  let d = c
  print(d(x))
  function w(): i32 { d = g; 0 }
  w()
  print(d(x))
  d = c
  print(d(x))
  w()
  print(d(x))
}
text("hi")
