// @run
// @log 1
// @log 2
// @log 3
// @hint Intentionally-unused variable `_h` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_g` (leading `_` marks it unused)
// A hole function no call instances, returned by a function whose every call drops its result
// or binds it unread, is built as no body: returned by name, through an alias, or as a body's
// tail, the value never reaches a place that could observe its signature (D6882).
function exclaim(s) { return s + "!" }

function get() { return exclaim }
function viaAlias() {
  const f = exclaim
  return f
}
function tail() { exclaim }

const _h = get()
print(1)
const _g = viaAlias()
print(2)
tail()
print(3)
