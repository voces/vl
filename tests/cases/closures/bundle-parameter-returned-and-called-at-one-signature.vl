// @run
// @warning `r` shadows the `r` declared at
// @log 3.5
// @log 4
// @log 5
// @log 4.5
// @log 5
// @log 6
// @log 5
// @log 6
// @log 10
// @log 0.5
// @log 1
// @log 1
// @log 4.5
// @log 5
// @log 10
// @log 6
// @log 4.5
// @log 5
// @log 5
// @log 6
// @log 6
// @log 3
// A parameter called at two signatures and returned whole: each caller takes the closure at the
// one signature its use of the result calls it at, whether the result is held by a `const`
// called later or from a closure, called at once, dropped, or shadowed.
function lap(f) {
  print(f(2.5))
  print(f(3))
  return f
}
function lapTail(f) {
  print(f(2.5))
  print(f(3))
  f
}
function held(k: i32) {
  const r = lap((a) => a + k)
  print(r(4))
}
function heldInClosure(k: i32) {
  const r = lap((a) => a + k)
  const h = () => print(r(4))
  h()
}
function calledAtOnce(k: i32) { print(lap((a) => a * k)(5)) }
function dropped(k: i32) {
  lap((a) => a - k)
  print(1)
}
function shadowed(k: i32) {
  const r = lapTail((a) => a + k)
  if k > 0 {
    const r = 10
    print(r)
  }
  print(r(4))
}
function twoHolders(k: i32) {
  const r = lap((a) => a + k)
  const q = lap((a) => a * k)
  print(r(4))
  print(q(1.5))
}
held(1)
heldInClosure(2)
calledAtOnce(2)
dropped(2)
shadowed(2)
twoHolders(2)
