// @run
// @hint redundant type annotation: `next` is inferred as `i32`
// @log 21
// @log a
// @log pick
// @log same
// @log 21
// @log same
// @log a
// @log same
// @log true
// @log pick
// @log 1.5
// @log b
// @log 21
// @log a
// @log same
// @log 21
// @log same
// @log a
// @log 1
// @log 21
// @log a
// @log 4
// @log z
// @log same
// @log 21
// @log same
// @log a
// @log 22
// @log b
// A binding of a call returning one of two generics, called at two types: the call runs once,
// as the index of the generic it returned, and each type selects its instance (D10021).
function id<T>(x: T): T { x }
function same<T>(x: T): T {
  print("same")
  x
}
function pick(n: i32) {
  if n > 1 { return id }
  return same
}
const k = pick(3)
print(k(21))
print(k("a"))

function pickLoud(n: i32) {
  print("pick")
  if n > 1 { return id }
  return same
}
const j = pickLoud(0)
print(j(21))
print(j("a"))
print(j(true))
const i = pickLoud(5)
print(i(1.5))
print(i("b"))

function main(n: i32) {
  const h = pick(n)
  print(h(21))
  print(h("a"))
}
main(3)
main(0)

// The argument runs once, ahead of the binding, and an alias of the binding selects too.
let c = 0
function next(): i32 {
  c = c + 1
  c
}
const g = pick(next() + 1)
print(c)
print(g(21))
print(g("a"))
const m = g
print(m(4))
print(m("z"))

// A `let` later written with a generic by name.
let w = pick(0)
print(w(21))
print(w("a"))
w = id
print(w(22))
print(w("b"))
