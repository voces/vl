// @error cannot infer type parameter `U`: `cnst`'s return type names it and no parameter does
// A generic handed to a generic `(x: T) => R` parameter is called with the callee's argument,
// so a type parameter only its result names is refused as at `cnst(3)`, whatever `R` is
// bound to at the destination (D9073).
function cnst<T, U>(t: T): U[] { return [] }
function ap<T, R>(x: T, f: (x: T) => R): R { return f(x) }
const r: string[] = ap(3, cnst)
print(r.length)
