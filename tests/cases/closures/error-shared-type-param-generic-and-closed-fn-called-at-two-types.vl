// @error-at 11:9 `con` is passed as `F`, but `go` calls `F` with `string` (line 3); `con` takes `i32`
// @warning Unused parameter `b` (prefix with `_` to suppress, or remove it)
// A generic and a closed function sharing a function type parameter fix it to the closed one's
// signature, so a call the body makes through it at another type is refused at the closed
// function's argument (D15464, ruling A).
function go<F>(a: F, b: F) {
  print(a(3))
  print(a("x"))
}
function same<T>(k: T): T { k }
function con(x: i32) { x }
go(same, con)
