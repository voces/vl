// @error-at 11:0 argument 1: expected i32, got string (the call of `a` at the call's argument types)
// @warning Unused parameter `b` (prefix with `_` to suppress, or remove it)
// A generic and a closed function sharing a function type parameter fix it to the closed one's
// signature, which the generic fits, so the generic's parameter called at another type is
// refused (D15464, ruling A).
function go<F>(a: F, b: F) {
  print(a(3))
  print(a("x"))
}
function same<T>(k: T): T { k }
function con(x: i32) { x }
go(same, con)
