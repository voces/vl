// @run
// @log 3
// @log x
// @log 5
// @log z
// A two-element list of a hole parameter read at index 1, and a slot written back with the same
// generic the parameter holds (D15453).
function same<T>(k: T): T { k }
function dbl(x) { x }
function go(a, b) {
  const r = [a, a]
  r[1] = b
  print(r[1](3))
  print(a("x"))
}
go(same, dbl)
function goSame(a, b) {
  const r = [a]
  r[0] = b
  print(r[0](5))
  print(a("z"))
}
goSame(same, same)
