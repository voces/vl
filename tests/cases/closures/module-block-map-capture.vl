// @run
// @log 3.5
// @log 2
// @log 3.5
// @log 1
// @log y
// @log 2
// @log 3.5

// A map declared in a module-level block and captured by a closure. The block's binding lives
// in the start function's frame, which has no `fnStmts` position, so the shape resolver reads
// the owning frame as an ARENA index — the conversion the env field's own resolver makes — and
// the two tables answer with one slot (D1861).

// Only a map whose value INTERNS a slot exercises it: an `i32`- or `boolean`-valued map rides
// the shared mono vals list, where the mono answer is also the right one. Every map below
// interns. The closure names are distinct across blocks on purpose — sharing one is D1862, a
// different table.
if true {
  const c1: {[string]: f64} = Map()
  c1.set("a", 2.5)
  const f1 = () => {
    c1.set("b", 3.5)
    print(c1.get("b") ?? 0.0)
    print(c1.length)
  }
  f1()
}

// The UN-ANNOTATED face, whose shape comes from the initialiser rather than the annotation.
if true {
  const c2 = Map()
  c2.set("a", 2.5)
  const f2 = () => {
    c2.set("b", 3.5)
    print(c2.get("b") ?? 0.0)
  }
  f2()
}

// An i32 key: the emitter reaches its own key check first, so this face is loud.
if true {
  const c3: {[i32]: f64} = Map()
  const f3 = () => {
    c3.set(1, 2.5)
    print(c3.length)
  }
  f3()
}

// A nested block inside a `while`, and a string value.
let once = true
while once {
  once = false
  if true {
    const c4: {[string]: string} = Map()
    const f4 = () => {
      c4.set("a", "y")
      print(c4.get("a") ?? "")
      print(c4.length + 1)
    }
    f4()
  }
}

// Two maps of different value reps in ONE block: each keeps its own slot.
if true {
  const c5: {[string]: f64} = Map()
  const d5: {[string]: i32} = Map()
  d5.set("n", 1)
  const f5 = () => {
    c5.set("b", 3.5)
    print(c5.get("b") ?? 0.0)
  }
  f5()
}
