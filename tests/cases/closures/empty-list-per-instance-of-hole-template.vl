// @run
// @log 4.5
// @log yz!
// @log 0
// @log 4.5
// @log 7
// An empty list a hole template allocates and hands to its own parameter is a fresh list per call:
// each instance builds it at its callee's element type, one instance writing nothing (D16603).
function ef(b: f64[]) {
  b.push(1.5)
  b.push(2.25)
  return b[1] * 2.0
}
function es(b: string[]) {
  b.push("x")
  b.push("yz")
  return b[1] + "!"
}
function en(b: boolean[]) { return b.length }
function ei(b: i32[]) {
  b.push(7)
  return b[0]
}
function mk(h) {
  const a = []
  return h(a)
}
print(mk(ef))
print(mk(es))
print(mk(en))
print(mk(ef))
print(mk(ei))
