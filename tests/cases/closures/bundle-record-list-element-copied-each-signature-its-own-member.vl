// @run
// @log 1
// @log 0.75
// @hint Intentionally-unused variable `_a`
// @hint Intentionally-unused variable `_b`
// The list element's copy called at i32 and the element's place at f64 each run their own
// signature's member: `3 / 2` at i32 is 1.
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
const u = lap((a) => a / 2)
const xs = [u]
const v = xs[0]
print(v(3))
print(xs[0](1.5))
