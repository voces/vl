// @run
// @log 3,4123

// D2316 matrix — sibling function-scope blocks, closure return types struct then list.

type Point = { x: i32, y: i32 }

function f() {
  let out = ""
  {
    const g = () => { x: 3, y: 4 }
    const p = g()
    out = "\{p.x},\{p.y}"
  }
  {
    const g = () => [1, 2, 3]
    const xs = g()
    out = out + "\{xs[0]}\{xs[1]}\{xs[2]}"
  }
  out
}
print(f())
