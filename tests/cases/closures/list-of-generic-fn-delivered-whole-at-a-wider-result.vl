// @run
// @log 1.5
// @log 1.5
// @log 1.5
// @log 3
// @log 1.5
// An un-annotated list of generic functions, delivered whole at a list whose function's result is
// wider than theirs, holds each at that slot (D17810): bound to an annotated `let`, at a second
// widening, handed to a parameter, and with two members of different results.
function __id<T>(x: T): T { return x }
function __half<T>(x: T): f64 { return x / 2.0 }
const a = [__half]
const za: ((x: i32) => i32 | f64)[] = a
print(za[0](3))
const b = [__half]
const zb: ((x: i32) => f64 | string)[] = b
print(zb[0](3))
const c = [__half]
function take(z: ((x: i32) => i32 | f64)[]) { print(z[0](3)) }
take(c)
const d = [__id, __half]
const zd: ((x: i32) => i32 | f64)[] = d
print(zd[0](3))
print(zd[1](3))
