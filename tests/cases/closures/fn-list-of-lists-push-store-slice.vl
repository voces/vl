// @run
// @log 4
// @log 1.5
// @log 4
// @log 1.5
// @log 6
// @log 1.5
// @log 4
// @log 1.5
// @log 1.5
// @log 1.5
// @log 1
// A list of lists of un-annotated functions whose results differ, grown by `push`, written by
// index, copied by `slice` and shortened by `pop`: each inner list holds the set's ids (D16805).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function dbl(a) { return a * 2 }
const xs = [[inc0]]
xs.push([half])
for x in xs { print(x[0](3)) }
const ys = [[inc0], [half]]
ys.push([dbl])
for y in ys { print(y[0](3)) }
const zs = [[inc0]]
zs[0] = [half]
print(zs[0][0](3))
const ws = [[[inc0]]]
ws.push([[half]])
for w in ws { print(w[0][0](3)) }
const vs = [[inc0], [half]]
const cs = vs.slice(1, 2)
print(cs[0][0](3))
const last = vs.pop()
if last != null { print(last[0](3)) }
print(vs.length)
