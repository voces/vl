// @run
// @log 9
// @log a
// @log 9
// @log 1
// @log a
// @log 1
// @log 0
// @log a
// @log 0
// @log 1
// A `const` choice between a capturing nested function and a plain one, handed once to a hole
// parameter called at two types, runs as the choice written at the hand does (D15451): taken
// both ways, and a three-way choice.
function both(f) {
  print(f("a"))
  print(f(1))
}
function nested(c: boolean, n: i32) {
  function inner(s) {
    print(n)
    return s
  }
  function ask(s) { return s }
  const g = if c { inner } else { ask }
  both(g)
}
nested(true, 9)
nested(false, 4)
function three(c: boolean, d: boolean, n: i32) {
  function inner(s) {
    print(n)
    return s
  }
  function ask(s) { return s }
  function tell(s) {
    print(0)
    return s
  }
  const g = if c { inner } else if d { ask } else { tell }
  both(g)
}
three(false, false, 9)
