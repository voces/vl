// @run
// @log 1.25
// @log 1.25
// @log 10000000000000
// An un-annotated `const` lambda whose only use is a function slot returning a wider number is
// called through the closure it is built at, and the adapter widens its `i32` result (D15898).
const dbl = (a) => a * 2
const v: (a: i32) => f64 = dbl
print(v(5) / 8)

const dbl2 = (a) => a * 2
function w(f: (a: i32) => f64) { return f(5) / 8 }
print(w(dbl2))

const dbl3 = (a) => a * 2
const v3: (a: i32) => i64 = dbl3
print(v3(5) * 1000000000000)
