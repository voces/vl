// @run
// @log 1
// @log 2
// @log 0.75
// @log 1.25
// @log 3000000000
// @log 6000000000
// @log 0.625
// @log 1.125
// @log a!
// @log b!
// @log true
// @log false
// @log 98
// @log 99
// @log 30
// @log 70
// @log 11
// @log 33
// @log a
// @log c
// @hint redundant type annotation: `xs` is inferred as `{r: i32}[]`
// D1142: a captured `for-in` LOOP VARIABLE is typed off the iterated ELEMENT, not off the
// i32 default. The env field used to be i32 for every rep — `struct.new $env` then pushed a
// `(ref $str)` / an `f64` into an i32 field: `vl check` rc 0, invalid wasm, with NO name
// collision anywhere (which is what separates it from D1130).
//
// THE i32 LOOP VARIABLE IS WHY IT HID. `for q in 1 to 3 { () => q }` is i32 and the default
// is right, which is every `for-in` capture the corpus and D1130's own witness contained.
// The i32 block below is kept as that control: if a future edit reverts the arm, it alone
// keeps passing, and that asymmetry is exactly what the original filing looked like.
//
// EVERY CELL PROVES THE VALUE, NOT THE SHAPE. `z / 2.0` over an f64 element prints `0.75`,
// which an i32 field cannot produce; the i64 cell multiplies past 2^32; the u8 cell adds to
// a byte read; the struct and nested-list cells read through the ref. A `.length`-only
// assertion would pass on a mis-typed field that happened to validate.
//
// THE MECHANISM: `parentBindingOf` answers a `Param` or a `LetDecl` and has nothing to
// return for a loop variable (the one storage class with NO declaration node), so
// `captureValKind` fell to its i32 default while `declareForInLocals` typed the loop-var
// LOCAL off `forInElemKind`. Both now read `forInElemKind` / `forInVarStructIdx` — one home,
// so the env field and the local it is built from cannot disagree.
//
// Nested function names and loop-variable names are distinct per frame on purpose; the
// loop-variable half of the parent-binding plan is FIRST-wins by name within one frame.

type Cell = { r: i32 }

// i32 — THE CONTROL. The default was already right here.
function i32Loop() {
  for zi in [1, 2] {
    const f = () => zi
    print(f())
  }
}

i32Loop()

// f64 — `expected i32, found f64` before the arm. `/ 2.0` proves the element is the float.
function f64Loop() {
  for zf in [1.5, 2.5] {
    const f = () => zf / 2.0
    print(f())
  }
}

f64Loop()

// i64 — the product runs past 2^32, so a truncated i32 field cannot fake it.
function i64Loop() {
  const xs: i64[] = [3, 6]
  for zl in xs {
    const f = () => zl * 1000000000
    print(f())
  }
}

i64Loop()

// f32 — the fourth scalar valtype, and the one no earlier capture fixture reached.
function f32Loop() {
  const xs: f32[] = [1.25, 2.25]
  for zg in xs {
    const f = () => zg / 2.0
    print(f())
  }
}

f32Loop()

// string — `expected i32, found (ref $type)`, the other spelling in the filed row.
function strLoop() {
  for zs in ["a", "b"] {
    const f = () => zs + "!"
    print(f())
  }
}

strLoop()

// boolean — an i32-valtype element whose PRINT formatting is the thing that must survive.
function boolLoop() {
  for zb in [true, false] {
    const f = () => zb
    print(f())
  }
}

boolLoop()

// u8 — the packed byte list: an i32 VALUE kind over a one-byte backing.
function u8Loop() {
  for zu in "ab".bytes() {
    const f = () => zu + 1
    print(f())
  }
}

u8Loop()

// A STRUCT element — the companion table slot (`forInVarStructIdx`), not just the kind. A
// kind without its slot is `ref valtype with no interned shape`, a different reject.
//
// THE ANNOTATION IS KEPT AGAINST ITS OWN HINT (declared above) because it pins the NOMINAL
// element: an un-annotated `[{ r: 3 }, { r: 7 }]` resolves through the anonymous shape and
// is a different rung. Both spellings run; this file takes the one a hint would remove.
function structLoop() {
  const xs: Cell[] = [{ r: 3 }, { r: 7 }]
  for zc in xs {
    const f = () => zc.r * 10
    print(f())
  }
}

structLoop()

// A NESTED i32 LIST element — the inner list wrapper, read through for its first element.
function nestLoop() {
  for zn in [[11, 12], [33]] {
    const f = () => zn[0]
    print(f())
  }
}

nestLoop()

// A NESTED STRING LIST element, captured TRANSITIVELY (two lifted frames deep) — the
// capture flows env-to-env while the TYPE stays at the owning frame's loop variable.
function nestStrLoop() {
  for zq in [["a", "b"], ["c"]] {
    const f = () => {
      const h = () => zq[0]
      h()
    }
    print(f())
  }
}

nestStrLoop()
