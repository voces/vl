// @run
// @log 1
// D15459's legal twin: a named function handed to a hole parameter and called there with a
// generic (D15480).
import { toString } from "std:fmt"

function id(a) { return a }
function lap(g) { const x = g(1); return x.toString() }
function use(k) { return k(id) }
print(use(lap))
