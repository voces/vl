// @run
// @log 3
// @log 3
// Regression (D2810). A value call may not fall back to the all-i32 functype of its arity,
// which `h`'s lambda interns here: the argument is a map reference, so that call would build
// invalid wasm. The `{[string]: i32} | null` position used to have no `$fnsig` token and was
// refused; since D9822 it carries the nullable-map token, so the module validates and runs.
function run(fn: (i32, {[string]: i32} | null) => i32, m: {[string]: i32}) {
  fn(2, m)
}
function h(f: (i32, i32) => i32) { f(1, 2) }
function count(a: i32, m: {[string]: i32} | null) {
  if m == null { return a }
  a + m.length
}
print(h((a: i32, b: i32): i32 => a + b))
const m0: {[string]: i32} = Map()
m0["x"] = 1
print(run(count, m0))
