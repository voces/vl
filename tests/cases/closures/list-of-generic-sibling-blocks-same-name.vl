// @run
// @log I
// @log 3
// @log I
// @log true
// Two lists named alike in sibling blocks are two bindings, so each one's element calls give it
// its own type (D3977, review of #3505, `rv3505/a16_sibling_blocks_same_name`).
function inner<U>(u: U) { print("I"); print(u) }
function main() {
  if true {
    const fs = [inner]
    fs[0](3)
  }
  if true {
    const fs = [inner]
    fs[0](true)
  }
}
main()
