// @error push: cannot add (i32) => i32 to ((string) => string)[] (written into `zs`, delivered at ((string) => string)[])
// A `let` list of a generic function pushed a fixed-type function refuses where it is delivered at
// another type, though it is assigned a fresh list afterwards: the push still reaches that
// delivery (D10202).
function id<T>(x: T): T { x }
function inc(x: i32) { x + 1 }
let zs = [id]
zs.push(inc)
function runS(a: ((x: string) => string)[]) { print(a[1]("s")) }
runS(zs)
zs = [id, id]
