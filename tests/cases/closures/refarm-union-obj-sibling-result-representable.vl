// THE THREE REPRESENTABLE NEIGHBOURS of what used to be the one shape that was NOT — the
// sibling of `narrow-reflist-arm-of-closure-result-union.vl`, which pinned the reject and
// now pins the RUN.
//
// That reject was for a ref-arm value union `{f: boolean}[] | {w: i32}` reached through a
// closure RESULT whose element shape is ANONYMOUS: `refArmUnionRetName` declined an
// anonymous array element beside an OBJ sibling, so the producer lambda stayed un-pinned,
// self-inferred the bare list arm, and the union's array arm never got an interned rep. It
// is CLOSED — `internFuncTypeShapesTy`'s composite-union arm interns such a result's arms,
// and the decline came off behind it. These three cells therefore no longer bound a floor;
// they bound a REGRESSION, and that is why they are still worth running: each differs from
// the once-rejected program in exactly one place, and a change that breaks one of them has
// broken the ordinary path, not an edge:
//   1. the SAME shape with a NAMED element type (`type S = {g: boolean}`) — the pin fires;
//   2. the SAME union through a NAMED producer function, which really boxes its return;
//   3. the SAME union bound DIRECTLY, no closure in the way.
// A change that turns any of these back into a reject has over-rejected.
//
// The named element deliberately uses a DIFFERENT field (`{g: boolean}`) from cells 2 and 3.
// A `type S = {f: boolean}` declaration in the same file makes the structurally-spelled
// `{f: boolean}[] | {w: i32}` return of cell 2 reject with `array value does not match any
// array member of the union` — a PRE-EXISTING interaction (it reproduces on master, with no
// closure involved), unrelated to what this file pins. Kept apart so this case measures the
// three neighbours and not that.
// @run
// @log true
// @log true
// @log true
// @hint Intentionally-unused parameter `_q0`
// @hint redundant type annotation: `v` is inferred as `((i32) => S[] | {w: i32}) | f64`
// @hint redundant type annotation: `f` is inferred as `() => {f: boolean}[] | {w: i32}`
type S = {g: boolean}

// 1. NAMED element type, the full `p2r` fuzzer shape (outer `| f64` decoy included).
function makeIt(): ((i32) => S[] | {w: i32}) | f64 {
  return (_q0) => ([{ g: true }])
}

// 2. NAMED producer: `mk`'s declared return IS the union, so the closure value carries the
//    `>u` box functype the value call casts to.
function mk(): {f: boolean}[] | {w: i32} { return [{ f: true }] }

function go() {
  const v: ((i32) => S[] | {w: i32}) | f64 = makeIt()
  if v is (i32) => S[] | {w: i32} {
    const r = v(1)
    if r is S[] { print(r[0].g) } else { print("OTHER") }
  } else {
    print("OTHER")
  }

  const f: () => {f: boolean}[] | {w: i32} = mk
  const r2 = f()
  if r2 is {f: boolean}[] { print(r2[0].f) } else { print("OTHER") }

  // 3. the DIRECT binding of the anonymous-element union — no closure result involved.
  const d: {f: boolean}[] | {w: i32} = [{ f: true }]
  if d is {f: boolean}[] { print(d[0].f) } else { print("OTHER") }
}
go()
