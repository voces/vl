// @run
// @log O
// @log 1
// A capture cell runs with a writer storing an alias of another generic, in a non-generic function, each value instanced at the cell's type
// (D3939, `rv3498/y06`).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function main() {
  let k = inner
  const al = other
  const toO = () => {
    k = al
  }
  toO()
  k(1)
}
main()
