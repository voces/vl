// @run
// @log 0.5
// @log 1.5
// @log 0.5
// @log 0.5
// @log 0
// A record the body pushes onto an un-annotated parameter shares its empty list field's element
// with the records the call's own list literal holds, as the direct spelling does (D16422).
function t(a) {
  a.push({ ys: [] })
  a[0].ys.push(0.5)
  print(a[0].ys[0])
}
t([{ ys: [] }])
t([{ ys: [1.5] }])
function t3(a) {
  a[0] = { ys: [] }
  a[1] = { ys: [] }
  a[0].ys.push(0.5)
  print(a[0].ys[0])
}
t3([{ ys: [] }, { ys: [] }])
function second(a) {
  a.push({ ys: [] })
  a[1].ys.push(0.5)
  print(a[1].ys[0])
  print(a[0].ys.length)
}
second([{ ys: [] }])
