// @emit-error is called at more than one argument type
// @warning Unused function `w5`
// @hint redundant type annotation: `w5` is inferred as `i32`
// @warning Unused function `w7`
// @hint redundant type annotation: `w7` is inferred as `i32`
// @info `d2` is never reassigned; use `const` instead of `let`
// A module-scope binding that a loop reassigns, called at a string and, through a closure, at
// an i32: one binding holds one closure signature, so it is refused. It printed a value of the
// initializer's lambda instead of the written one (D3858).
const x = "a"
const n = 4
const e = (y) => y + y + y
const g = (y) => y
let d1 = e
let i3 = 0
while i3 < 2 {
  d1 = g
  i3 = i3 + 1
}
function w5(): i32 {
  d1 = d1
  0
}
function w7(): i32 {
  d1 = d1
  0
}
print(d1(x))
let d2 = e
print((() => d1(n))())
print(d2(n))
