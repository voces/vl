// @run
// @log 3
// @log 2
// @log 3
// The `let` a hole parameter initialises, written with the function the parameter is handed.
function add(a, b) { return a + b }
function two(g) {
  print(g(1, 2))
  print(g(0.5, 1.5))
}
two(add)
function swap(h) {
  let hh = h
  hh = add
  print(hh(1.5, 1.5))
}
swap(add)
