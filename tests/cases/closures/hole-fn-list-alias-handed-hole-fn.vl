// @log 0.75
// A chain of `const` aliases of a list of hole functions, iterated or indexed and handed a hole
// function, types the callee at the list's elements, at module scope and in a function (D7844).
function add(a, b) { return a + b }
function apply2(g) {
  print(g(1, 2))
  print(g(1.5, 2.5))
}
function apply3(g) {
  print(g(10, 20))
  print(g(0.5, 0.25))
}
const fs = [apply2, apply3]
const g = fs
const h = g
for f in h { f(add) }
g[1](add)
function inner() {
  const ks = [apply2, apply3]
  const k = ks
  for f in k { f(add) }
}
inner()
