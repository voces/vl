// @run
// @log 5.5
// A call above the functions it reaches, an un-annotated maker whose closure reads a list of two
// un-annotated functions of different results, checks those bodies first, so the list's call
// boxes each result as it does with the declarations first (D16301).
const h = mk()
print(h(3))
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function mk() {
  const c = [inc0, half]
  return (x: i32) => c[0](x) + c[1](x)
}
