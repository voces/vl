// @run
// @log 4
// @log 1.5
// @log abab
// @log 8
// @log 0
// @log 1
// @log 2
// An un-annotated function handed to `.map` / `.filter` takes its instance at the list's element,
// and `.map`'s result is the list of what its body gives there (D8944).
function inc(a) { return a + 1 }
function half(a) { return a / 2.0 }
function dup(s) { return s + s }
type P = { x: i32 }
function gx(p) { return p.x * 2 }
function orz(a) { return a ?? 0 }
function pos(a) { return a > 0 }
print([3].map(inc)[0])
print([3].map(half)[0])
print(["ab", "c"].map(dup)[0])
const ps: P[] = [{ x: 4 }]
print(ps.map(gx)[0])
const xs: (i32 | null)[] = [1, null]
print(xs.map(orz)[1])
print([3, -1].filter(pos).length)
print([0, 1].map(inc).filter(pos).length)
