// @run
// @log 1
// @log 2.5
// @log 0.5
// @log 2.25
// @log 1.5
// @log 2.75
// @log 1
// A named generic handed to list elements that call it at two argument type lists takes one
// instance per list, each element calling its own (D13261).
function add(a, b) { return a + b }
function apply2(g, s) { print(g(s, s)) }
function apply4(g, s) { print(g(s, 2)) }
for f in [apply2, apply4] { f(add, 0.5) }

// Inside a function, reading the value through a parameter.
function t(k) {
  for f in [apply2, apply4] { f(add, k) }
}
t(0.25)

// Second delivery position: a `const` list.
const fs = [apply2, apply4]
for f in fs { f(add, 0.75) }

// A sibling list of one element beside the two-element one.
for f in [apply2] { f(add, 0.5) }
