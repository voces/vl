// @run
// @log 1.5
// @log 2.5
// A function written into one list through a parameter and into another directly: the direct
// write's leaf does not stand for the callee's, so each write stores the member's id (D16231).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function put(ys) { ys[0] = half }
const xs = [inc0]
put(xs)
const ws = [inc0]
ws[0] = half
print(xs[0](3))
print(ws[0](5))
