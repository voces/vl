// @run
// @info `a1` is never reassigned; use `const` instead of `let`
// @info `a8` is never reassigned; use `const` instead of `let`
// @log 6
// @log 6
// @log 6
// @log 3
// @log 6
// @log 6
// @log 3
// @log 3
// @log 6
// @log 1
// @log 2
// @log 5
// The generic face of `hole-fn-list-written-then-called.vl`: a list holding a generic function
// beside an un-annotated one is instanced at the type its calls give the element, wherever it
// is written or read (D9094, D9140, D9093).
function ginc<T>(a: T): T { return a }
function dbl(a) { return a * 2 }
function put(ys) { ys[0] = dbl }

let a1 = [ginc]
a1[0] = dbl
print(a1[0](3))

const a2 = [ginc]
put(a2)
print(a2[0](3))

let a4 = [ginc]
a4 = [dbl]
print(a4[0](3))

const rs = [{ f: ginc }, { f: dbl }]
for r in rs { print(r.f(3)) }
print(rs[1].f(3))
print(rs[0].f(3))

const a7 = [ginc]
print(a7.map((f) => f(3))[0])

let a8 = [ginc]
a8[0] = dbl
print(a8.map((f) => f(3))[0])

const a9 = [ginc, dbl]
print(a9.filter((f) => f(3) > 4).length)

const a10 = [ginc]
print([1, 2].map((n) => a10[0](n))[1])

const a12 = [ginc]
print(a12.map((f) => f(5))[0])
