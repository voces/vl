// @run
// @log 6
// @log 15
// @hint Intentionally-unused variable `_a`
// @hint Intentionally-unused variable `_b`
// A function with one instance holds an open local at the rep it is built at, even in a build that
// makes records of closures: one row per position such a local is written in.
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
// a list literal of a hole function, read by index
function inList(k: i32) {
  const u = lap((a) => a + k)
  const xs = [u]
  print(xs[0](4))
}
// the element copied into a binding, then called
function copied(k: i32) {
  const u = lap((a) => a * k)
  const xs = [u, u]
  const v = xs[1]
  print(v(5))
}
// a top-level caller of both
inList(2)
copied(3)
