// @run
// @log 4
// @log 4
// @log 6
// @log 6
// A `??` over a map read whose value is a list of a function set takes a default list literal
// naming fewer of the set's members at the set's own list type, so the join is one list (D17055).
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
const m4 = Map()
m4["k"] = [inc0, dbl]
const got = m4["absent"] ?? [inc0]
print(got[0](3))
const mv4 = m4["absent"]
const g1 = mv4 ?? [inc0]
print(g1.map((f) => f(3))[0])
function run() {
  const m5 = Map()
  m5["k"] = [inc0, dbl]
  const a = m5["k"] ?? [dbl]
  print(a[1](3))
  const b = m5["z"] ?? [dbl]
  print(b[0](3))
}
run()
