// @run
// @log true
// @warning This expression has no effect: it is not the final statement of its block, so its value is discarded
// A hole function no call instances, discarded as a statement and also compared: the comparison
// reads the declaration's identity and calls nothing (D6960, D7180).
function exclaim(s) { return s + "!" }
exclaim
print(exclaim == exclaim)
