// @error cannot assign {r: {f: (_) => _}} to W
// The record holding an un-annotated function of i32 result is refused when pushed onto a list
// whose element type reaches it at an f64-result field, nested one record down (D9471).
type R = { f: (a: i32) => f64 }
type W = { r: R }
function inc0(a) { return a + 1 }
const l: W[] = []
l.push({ r: { f: inc0 } })
print(l[0].r.f(3))
