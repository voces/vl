// @run
// @log true
// @log 5
// A hole function called by name, handed to a parameter whose alias is compared with itself: a
// comparison reads the function's identity, its declaration, and calls nothing, so it pins no
// signature (D7180). The alias read nowhere runs too:
// `hole-fn-called-by-name-and-aliased-by-param.vl` (D6931).
function inc(x) { x + 1 }
function run(f) {
  const k = f
  print(k == k)
}
run(inc)
print(inc(4))
