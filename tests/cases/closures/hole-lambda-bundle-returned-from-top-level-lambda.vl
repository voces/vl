// @log 3.5
// @log 2.5
// @log 8
// @log 1.5
// A top-level `const` bound to a lambda returning a hole lambda's bundle: its call held, handed on,
// called directly, and delivered at one member's type into an argument, a field, an element, a
// push, a map and a return (D15744).
function lap(f) {
  f(2.5)
  f(3)
  return f
}
function take(b) {
  print(b(4))
  print(b(1.5))
}
const c = lap((a) => a + 1)
const g = () => lap((a) => a + 1)
const h = () => {
  return lap((a) => a + 1)
}
const r = () => c
const w = g()
print(w(4))
print(w(1.5))
take(h())
take(r())
print(g()(3))
function one(x: (f64) => f64) { print(x(9)) }
one(g())
type W = { f: (f64) => f64 }
const o: W = { f: g() }
o.f = g()
print(o.f(0.5))
const xs: ((f64) => f64)[] = []
xs.push(g())
print(xs[0](2.5))
const m: {[string]: (f64) => f64} = Map()
m["k"] = g()
print((m["k"] ?? one2)(1.5))
function one2(x: f64) { x }
function back(): (f64) => f64 { return g() }
print(back()(7))
function two() {
  const v = g()
  print(v(0.5))
}
two()
