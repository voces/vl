// @run
// @log 9
// @log 9
// @log 3
// @log 3
// @log NUL
// @log NUL
// @log 1
// @log 1
// @log 3
// @log 3
// @log E
// @log E
// @hint redundant type annotation: `s1` is inferred as `S[] | null`
// @hint redundant type annotation: `n0` is inferred as `i32[][] | null`
// @hint redundant type annotation: `l1` is inferred as `S[] | null`
// @hint redundant type annotation: `rb` is inferred as `S[] | null`
// @hint redundant type annotation: `e1` is inferred as `S[][] | null`
// EVERY ONE OF THOSE FIVE HINTS IS WRONG ABOUT A LOAD-BEARING ANNOTATION, and that is the
// point of the sibling reject case: drop the annotation and the capture's kind is classified
// from the INITIALIZER instead, through a ladder with no `nulreflist` arm — the program stops
// compiling. The hint sees a type it can infer; it does not see which resolver the emitter
// then has to ask.
//
// A NULLABLE ref-element array (`VKind` `nulreflist` — `i32[][] | null`, `S[] | null`)
// captured by a nested function, narrowed with `!= null` inside the callee.
//
// The `(ref null $wrapper)` niche needs the SAME ref-list table slot the non-null
// `reflist` capture does, at both ends: the env field takes it from
// `captureValStructIdx` -> `annValtypeSlotOf`, and the narrow takes it from
// `exprNullableRefArray` / `nulRefArrayInnerSlot` -> `capturedRefListSlot`. Without the
// read end the compare's bare `null` reaches `emitNullLitNode` with no seed, which is the
// `bare null needs a struct-typed context` reject — the same message the nullable-MAP
// capture still carries, and a reminder that message identity is not root identity: that
// one is the map rep's own floor and is NOT fixed by this slot.
//
// Each PAIR prints the captured narrow and then the IDENTICAL uncaptured narrow.

type S = { a: i32 }

function mkNest(): i32[][] | null { return [[9, 8]] }
function mkStructs(): S[] | null { return [{ a: 3 }] }
function mkNull(): i32[][] | null { return null }
function mkEmpty(): S[][] | null { return [] }

function pNest(xs: i32[][] | null) {
  function inNulNest() {
    if xs != null { print(xs[0][0]) } else { print("NUL") }
  }
  inNulNest()
}
function pNestCtl(xs: i32[][] | null) {
  if xs != null { print(xs[0][0]) } else { print("NUL") }
}

function locals() {
  // A depth-ONE nullable struct array, ANNOTATED `const`.
  const s1: S[] | null = mkStructs()
  function inNulS1() {
    if s1 != null { print(s1[0].a) } else { print("NUL") }
  }
  inNulS1()
  if s1 != null { print(s1[0].a) } else { print("NUL") }

  // The `null` input takes the else arm, captured and not.
  const n0: i32[][] | null = mkNull()
  function inNulN0() {
    if n0 != null { print(n0[0][0]) } else { print("NUL") }
  }
  inNulN0()
  if n0 != null { print(n0[0][0]) } else { print("NUL") }

  // `.length` over the narrowed niche, captured two frames deep.
  const l1: S[] | null = mkStructs()
  function outNulL1() {
    function inNulL1() {
      if l1 != null { print(l1.length) } else { print("NUL") }
    }
    inNulL1()
  }
  outNulL1()
  if l1 != null { print(l1.length) } else { print("NUL") }

  // REBINDING the capture to an UN-ANNOTATED local inside the callee, then narrowing that.
  // The new local's own kind-18 slot comes from `nulRefArrayInnerSlot`'s capture arm — the
  // one leg the direct reads above never ask for, because they resolve their row by ELEMENT
  // NAME instead. Without it the rebound local takes slot -1 and `fbValtypeNullable` has no
  // shape to name.
  const rb: S[] | null = mkStructs()
  function inNulRb() {
    const t = rb
    if t != null { print(t[0].a) } else { print("NUL") }
  }
  inNulRb()
  const tCtl = rb
  if tCtl != null { print(tCtl[0].a) } else { print("NUL") }

  // An EMPTY outer array is non-null, so the guard passes and the length test decides.
  const e1: S[][] | null = mkEmpty()
  function inNulE1() {
    if e1 != null {
      if e1.length > 0 { print(e1[0].length) } else { print("E") }
    } else {
      print("NUL")
    }
  }
  inNulE1()
  if e1 != null {
    if e1.length > 0 { print(e1[0].length) } else { print("E") }
  } else {
    print("NUL")
  }
}

pNest(mkNest())
pNestCtl(mkNest())
locals()
