// @error cannot write 'half' to an element of 'r.fs': called at (i32) it returns f64, where 'inc0', also written to it, returns i32
// A record's list field read directly into an annotated list is judged as its alias and the bare
// list are: every function written to it must return one type (D15199).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const r = { fs: [inc0] }
const a = r.fs
a[0] = half
const v: readonly ((x: i32) => i32 | f64)[] = r.fs
print(v[0](3))
