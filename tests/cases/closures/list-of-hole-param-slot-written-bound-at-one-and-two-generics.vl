// @run
// @log 1
// @log 5
// @log 1
// @log 5
// A list of one hole parameter slot-written with a second, bound at one call to one generic and at
// another to two: both calls join at the list's element set, as the calls through it are typed (D15574).
function id<T>(x: T): T { x }
function id2<U>(x: U): U { x }
function use(ys) { print(ys.length) }
function take(a, b) {
  const xs = [a]
  xs[0] = b
  use(xs)
  print(xs[0]("abc").length + xs[0](2))
}
take(id, id)
take(id, id2)
