// @run
// @log 4
// @log none
// @log 5
// @log none
// @log 4
// @log 4
// @log 1.5
// A nullable function delivered at a nullable function type with a wider result is adapted where
// it is delivered, and stays null where it was null (D17816): bound, handed to a parameter, in a
// record field, returned, from a rebound `let`, a choice of two functions, and an `f64` result.
function inc(a: i32) { return a + 1 }
function dec(a: i32) { return a - 1 }
function half(a: i32) { return a / 2.0 }
function two() { return [1, 2].length }
const h = if two() > 1 { inc } else { null }
const z: ((x: i32) => i32 | f64) | null = h
if z != null { print(z(3)) } else { print("none") }
const g = if two() > 5 { inc } else { null }
const y: ((x: i32) => i32 | f64) | null = g
if y != null { print(y(3)) } else { print("none") }
function take(w: ((x: i32) => i32 | f64) | null) { if w != null { print(w(4)) } else { print("none") } }
take(h)
take(g)
const r: { f: ((x: i32) => i32 | f64) | null } = { f: h }
const rf = r.f
if rf != null { print(rf(3)) }
let lh = if two() > 1 { inc } else if two() > 5 { dec } else { null }
const lz: ((x: i32) => i32 | f64) | null = lh
lh = null
if lz != null { print(lz(3)) }
const hh = if two() > 1 { half } else { null }
const hz: ((x: i32) => f64 | string) | null = hh
if hz != null { print(hz(3)) }
