// @error cannot write 'half' to 'm[].f': called at (i32) it returns f64, where 'inc0', also written to it, returns i32
// A map of record literals whose function field holds functions of different results, called
// through `?.` on an entry read, is refused at check: the guarded call has no member call to
// dispatch on, so the set would stay closures of two signatures (D15801).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const m = Map()
m["a"] = { f: inc0 }
m["b"] = { f: half }
print(m["b"]?.f(3))
