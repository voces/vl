// @run
// @log 4
// @log 4
// @log 4
// @log 4
// @log 6
// @log true
// @log a!
// @log 4
// A binding of an `if` choosing an un-annotated function or `null`, delivered at a nullable function
// of a wider result, is delivered through the check's nullable adapter over the arm's own
// instance, as the non-null binding and the inline choice are (D17828).
function inc(a) { return a + 1 }
function nm(a) { return a + "!" }
function two() { return [1, 2].length }
const h = if two() > 1 { inc } else { null }
const z: ((x: i32) => i32 | f64) | null = h
if z != null { print(z(3)) }
function f() {
  const h2 = if two() > 1 { inc } else { null }
  const z2: ((x: i32) => i32 | f64) | null = h2
  if z2 != null { print(z2(3)) }
}
f()
function useN(u: ((x: i32) => i32 | f64) | null) {
  if u != null { print(u(3)) } else { print("none") }
}
const h3 = if two() > 1 { inc } else { null }
useN(h3)
const z4 = ((fv: ((x: i32) => i32) | null) => if fv != null { (p: i32): i32 | f64 => fv(p) } else { null })(
  h3,
)
if z4 != null { print(z4(3)) }
const y: ((x: i32) => i32) | null = h3
if y != null { print(y(5)) }
const h5 = if two() > 5 { inc } else { null }
const z5: ((x: i32) => i32 | f64) | null = h5
print(z5 == null)
const h6 = if two() > 1 { nm } else { null }
const z6: ((x: string) => string | i32) | null = h6
if z6 != null { print(z6("a")) }
const h7 = match two() {
  2 => inc
  _ => null
}
const z7: ((x: i32) => i32 | f64) | null = h7
if z7 != null { print(z7(3)) }
