// @run
// @log 2
// @log 2.5
// @log 3
// @log 3.5
// @log 4
// @log 4.5
// @log 5
// @log 5.5
// @log 6
// @log 6.5
// A function returning one of two record literals that hold un-annotated functions in a field:
// the result holds each return's functions, so its field is called at the call's types. Different
// members, the same member, written another function after the call, a returned value `if`, and a
// parameter annotated to decide which (D15277).
function id1a(a) { return a }
function id2a(a) { return a }
function mkA() {
  if 1 > 0 { return { f: id1a } }
  return { f: id2a }
}
const ra = mkA()
print(ra.f(2))
print(ra.f(2.5))
function id1b(a) { return a }
function mkB() {
  if 1 > 0 { return { f: id1b } }
  return { f: id1b }
}
const rb = mkB()
print(rb.f(3))
print(rb.f(3.5))
function id0c(a) { return a }
function id1c(a) { return a }
function id2c(a) { return a }
function mkC() {
  if 1 > 0 { return { f: id1c } }
  return { f: id2c }
}
const rc = mkC()
rc.f = id0c
print(rc.f(4))
print(rc.f(4.5))
function id1d(a) { return a }
function id2d(a) { return a }
function mkD() { return if 1 > 0 { { f: id1d } } else { { f: id2d } } }
print(mkD().f(5))
print(mkD().f(5.5))
function id1e(a) { return a }
function id2e(a) { return a }
function mkE(c: boolean) {
  if c { return { f: id1e } }
  return { f: id2e }
}
print(mkE(true).f(6))
print(mkE(false).f(6.5))
