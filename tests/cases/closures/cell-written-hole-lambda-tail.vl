// @run
// @log a!
// @log a?
// @log a.
// @log aC
// @log a#
// A nested lambda or function whose body ends in writing a capturing hole lambda into a
// captured binding of a module-scope hole lambda yields the value it wrote rather than
// falling through to a trap: the cell's re-read is the closure written (D3860).
const c = (y) => y + "C"
function byLambda(x: string) {
  let d = c
  const g = (s: string) => {
    d = (y) => y + s
  }
  g("!")
  print(d(x))
}
byLambda("a")
function shadowing(x: string) {
  let d = c
  const g = (c: string) => {
    d = (y) => y + c
  }
  g("?")
  print(d(x))
}
shadowing("a")
function byFunction(x: string) {
  let d = c
  function g(s: string) { d = (y) => y + s }
  g(".")
  print(d(x))
}
byFunction("a")
function readBefore(x: string) {
  let d = c
  print(d(x))
  const g = (s: string) => {
    d = (y) => y + s
  }
  g("#")
  print(d(x))
}
readBefore("a")
