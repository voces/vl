// @run
// @log 1.5
// @log 4
// @log 1.5
// @log 4
// A function returning lists of records whose list field holds un-annotated functions of
// different results returns the join of their sets, as one level up does (D15510): through two
// returns and through a returned value `if`.
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function pick(b: boolean) {
  if b { return [{ fs: [inc0] }] }
  return [{ fs: [half] }]
}
function choose(b: boolean) { return if b { [{ fs: [inc0] }] } else { [{ fs: [half] }] } }
print(pick(false)[0].fs[0](3))
print(pick(true)[0].fs[0](3))
print(choose(false)[0].fs[0](3))
print(choose(true)[0].fs[0](3))
