// @run
// @log 0.5
// A record literal holding an un-annotated function of `i32` result, pushed onto a list whose
// element reaches it at an `f64`-result field one record down, adapts its field (D3073).
type R = { f: (a: i32) => f64 }
type W = { r: R }
function inc0(a) { return a + 1 }
const l: W[] = []
l.push({ r: { f: inc0 } })
print(l[0].r.f(3) / 8)
