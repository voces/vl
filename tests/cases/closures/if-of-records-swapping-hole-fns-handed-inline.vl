// @run
// @log 3.5
// @log 3.5
// A value `if` of records whose arms swap two un-annotated functions between two fields called
// at two types, handed inline to an un-annotated parameter, runs as it does bound (D15333).
function id1(a) { return a }
function id2(a) { return a }
function g(r) { return r.f(2) + r.g(1.5) }
const c = 1 > 0
print(g(if c { { f: id1, g: id2 } } else { { f: id2, g: id1 } }))
print(g(if !c { { f: id1, g: id2 } } else { { f: id2, g: id1 } }))
