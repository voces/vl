// @emit-error bare null needs a struct-typed context
// THE SOUNDNESS BOUNDARY of the captured ref-array slot, on the ANNOTATION axis: an
// ANNOTATED `nulreflist` capture works (`capture-nullable-ref-array-narrow.vl`), an
// UN-ANNOTATED one is still a loud reject.
//
// `captureValKind` classifies an un-annotated binding from its INITIALIZER through
// `letInitCellKind`, whose ladder has a `letIsRefArray -> "reflist"` arm and NO
// `letIsNulRefArray -> "nulreflist"` arm — while `collectLocals`, the ladder its own header
// says it mirrors "in the same order", tests `letIsNulRefArray` FIRST. So the kind comes back
// as something that is not the nullable niche, `exprNullableRefArray` declines the capture,
// and the compare's bare `null` reaches `emitNullLitNode` with no seed.
//
// Not merely a missing arm: `captureValStructIdx`'s un-annotated arm is handed an `fnStmts`
// POSITION where the `letIs*` family wants an ARENA index (its own header records this as
// FILED, not fixed, because correcting it moves bytes), so the slot side would decline even
// with the kind arm added. Pinned as a REJECT until that frame-index question is settled;
// the ANNOTATED spelling is the workaround and is exercised in the sibling case.

type S = { a: i32 }

function mkStructs(): S[] | null { return [{ a: 3 }] }

function body() {
  const u = mkStructs()
  function inUnann() {
    if u != null { print(u[0].a) } else { print("NUL") }
  }
  inUnann()
}
body()
