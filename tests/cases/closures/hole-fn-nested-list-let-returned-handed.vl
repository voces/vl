// @run
// @log 6
// @log 4
// @log 6
// @info `u` is never reassigned; use `const` instead of `let`
// @hint Intentionally-unused parameter `_n`
// A `let` bound to a nested list of un-annotated functions, never written, returned and handed to
// an un-annotated parameter runs, at the top level and from inside a function, and so does its
// flat twin (D9716). The last case, the same binding as a `const`, is a control that ran before.
function inc0(a) { return a + 1 }
function dbl0(a) { return a * 2 }
function deliver0(_n) {
  let u = [[inc0], [dbl0]]
  return u
}
function take0(a) { print(a[1][0](3)) }
take0(deliver0(1))

function inc1(a) { return a + 1 }
function dbl1(a) { return a * 2 }
function deliver1(_n) {
  let u = [inc1, dbl1]
  return u
}
function take1(a) { print(a[0](3)) }
function go1() { take1(deliver1(1)) }
go1()

function inc2(a) { return a + 1 }
function dbl2(a) { return a * 2 }
function deliver2(_n) {
  const u = [[inc2], [dbl2]]
  return u
}
function take2(a) { print(a[1][0](3)) }
take2(deliver2(1))
