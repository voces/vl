// @run
// @log z
// @log 1
// Inside a function the checker adapts the write to the type of the list's first call; the
// written `let` only ever holds `idg`, so the list is planned as a list of `idg` is and each
// call takes its own instance (D4246, D9791).
function idg<T>(t: T): T { return t }
function main() {
  let x = idg
  x = idg
  const y = [x]
  print(y[0]("z"))
  print(y[0](1))
}
main()
