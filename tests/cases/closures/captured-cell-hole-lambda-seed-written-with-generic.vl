// @run
// @log L
// @log 1
// @log O
// @log 2
// @log L
// @log a
// @log O
// @log b
// @log L
// @log 1
// @log O
// @log 2
// @log T
// @log 3
// @log L
// @log 5
// @log O
// @log 5
// A capture cell seeded with a hole lambda and written with generic functions: a call pins the
// lambda, and each generic written into the cell is instanced at the lambda's signature (D3951).
function other<V>(v: V) {
  print("O")
  print(v)
}
function third<Z>(z: Z) {
  print("T")
  print(z)
}
function ints() {
  let k = (x) => {
    print("L")
    print(x)
  }
  const flip = () => {
    k = other
  }
  k(1)
  flip()
  k(2)
}
ints()
function strings() {
  let k = (x) => {
    print("L")
    print(x)
  }
  const flip = () => {
    k = other
  }
  k("a")
  flip()
  k("b")
}
strings()
function twoWriters() {
  let k = (x) => {
    print("L")
    print(x)
  }
  const f1 = () => {
    k = other
  }
  const f2 = () => {
    k = third
  }
  k(1)
  f1()
  k(2)
  f2()
  k(3)
}
twoWriters()
function inClosure() {
  let k = (x) => {
    print("L")
    print(x)
  }
  const flip = () => {
    k = other
  }
  const rd = () => {
    k(5)
  }
  rd()
  flip()
  rd()
}
inClosure()
