// @emit-error the captured binding `k` is written with a function inside a closure that every instance of
// A lambda annotated `(u: i32)` written into a cell the instance wants at boolean (review of #3498, `rv3498/round5/f09_annotated_concrete_lambda_into_cell_bool`).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function third<Z>(z: Z) { print("T"); print(z) }
function a<T>(x: T) {
  let k = inner
  const w = () => {
    k = (u: i32) => {
      print("L"); print(u)
    }
  }
  w()
  k(x)
}
a(true)
