// @run
// @log 5
// @log 2.5
// @hint Intentionally-unused variable `_a`
// @hint Intentionally-unused variable `_b`
// A list element holding a record of one closure per signature, copied and called at one
// signature beside a call through the element at the other: each call takes its own member.
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
const u = lap((a) => a + 1)
const xs = [u]
const v = xs[0]
print(v(4))
print(xs[0](1.5))
