// @run
// @log T
// @log 1
// @log O
// @log 1
// @log T
// @log 2.5
// @log O
// @log 2.5
// @log 3
// @log 1
// @log 3
// @log s
// @log O
// @log 1
// A capture cell annotated with a function type over the enclosing type parameter, written with a generic by a closure every instance shares, holds the generic's instance at each instance's type (D3957).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function third<Z>(z: Z) { print("3"); print(z) }
function tee<Z>(z: Z) { print("T"); print(z) }
function a<T>(x: T, f: (t: T) => void) {
  let k: (t: T) => void = f
  const w = () => {
    k = other
  }
  k(x)
  w()
  k(x)
}
function b<T>(x: T) {
  let k: (t: T) => void = inner
  const toO = () => {
    k = other
    k = third
  }
  toO()
  k(x)
}
function c<T>(x: T) {
  let k: (t: T) => void = inner
  const toO = () => {
    if x == x { k = other }
  }
  toO()
  k(x)
}
a(1, tee)
a(2.5, tee)
b(1)
b("s")
c(1)
