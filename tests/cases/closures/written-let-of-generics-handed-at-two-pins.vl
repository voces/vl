// A re-pointed `let` holding generics, handed to a generic's arrow parameter at several pins,
// runs whichever function it holds at each hand, instanced at that hand's pin (D9006).
function fst<T>(xs: T[]): T { return xs[0] }
function lst<T>(xs: T[]): T { return xs[xs.length - 1] }
function app<T>(g: (x: T[]) => T, v: T[]): T { return g(v) }
let f = fst
if [1].length > 0 { f = lst }
print(app(f, [1, 2, 3]))
print(app(f, ["a", "b"]))
let f3 = fst
if [1].length > 0 { f3 = lst }
print(app(f3, [1, 2, 3]))
print(app(f3, ["a", "b"]))
print(app(f3, [1.5, 2.5]))
let fb = fst
print(app(fb, [1, 2, 3]))
if [1].length > 0 { fb = lst }
print(app(fb, ["a", "b"]))
let fl = fst
let i = 0
while i < 2 {
  print(app(fl, [i, 10]))
  fl = lst
  i = i + 1
}
print(app(fl, ["a", "b"]))
let fc = fst
if [1].length > 0 { fc = lst }
print(app(fc, [1, 2, 3]))
print(fc(["a", "b"]))
print(fc([1.5, 2.5]))
function main(): void {
  let fm = fst
  if [1].length > 0 { fm = lst }
  print(app(fm, [1, 2, 3]))
  print(app(fm, ["a", "b"]))
}
main()
let fw = fst
const set = () => {
  fw = lst
}
set()
print(app(fw, [1, 2, 3]))
print(app(fw, ["a", "b"]))
function idg<T>(t: T): T { return t }
function kg<T>(t: T): T { return t }
function appI<T>(g: (x: T) => T, v: T): T { return g(v) }
function w(h, x) { return h(x) }
let fi = idg
fi = kg
print(appI(fi, 3))
print(appI(fi, "s"))
print(w(fi, 2.5))
print(w(fi, true))
