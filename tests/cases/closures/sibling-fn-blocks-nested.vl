// @run
// @log 1x

// D2316 matrix — the two sibling blocks are themselves nested inside a third block, so the
// walk that records function-scope bindings has to track the OWNING block at every depth,
// not just the function's own top-level body.

function f() {
  let out = ""
  {
    {
      const g = () => 1
      out = "\{g()}"
    }
    {
      const g = () => "x"
      out = out + g()
    }
  }
  out
}
print(f())
