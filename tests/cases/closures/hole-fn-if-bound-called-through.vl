// @run
// @info `d` is never reassigned; use `const` instead of `let`
// @log a!
// @log b!
// @log 9
// @log c?
// @log d!
// @log e!
// @log f?
// @log 42
// @log 15
// @log 11
// @log g!
// @log q!
// @log h!
// @log 1
// @log s
// A hole function bound through an `if` and called through the binding is instanced at the call,
// each arm at the type the call takes the first one at: through `let`, aliases, parentheses,
// `else if`, a written `let`, a capture, inside a generic, and an `if` called directly (D6991).
function exclaim(s) { return s + "!" }
function shout(s) { return s + "?" }
function twice(v) { return v * 2 }
function thrice(v) { return v * 3 }
function id(v) { return v }
const on = [1].length == 1

const a = if on { exclaim } else { exclaim }
print(a("a"))
print(a("b"))
const b = if !on { twice } else { twice }
print(b(4) + 1)
function inFn() {
  const x = if !on { exclaim } else { shout }
  print(x("c"))
}
inFn()
function wrap(t) {
  const x = if on { exclaim } else { exclaim }
  return x(t)
}
print(wrap("d"))
const c = if !on { shout } else if on { exclaim } else { shout }
const c2 = c
const c3 = c2
print(c3("e"))
print((if !on { exclaim } else { shout })("f"))
let d = if on { twice } else { twice }
print(d(21))
let e = if on { twice } else { thrice }
e = thrice
print(e(5))
function mk(n) {
  function addn(v) { return v + n }
  const x = if on { addn } else { addn }
  return x(1)
}
print(mk(10))
function run(f: (s: string) => string) { print(f("q")) }
const g = (if on { exclaim } else { exclaim })
print(g("g"))
run(g)
print(g("h"))
const i = if on { id } else { id }
const j = if on { id } else { id }
print(i(1))
print(j("s"))
