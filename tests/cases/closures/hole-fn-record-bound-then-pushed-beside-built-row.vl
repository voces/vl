// @run
// @log 5
// @log 2
// @log 1
// D9531: a record of an un-annotated function bound to a const and then pushed onto an
// un-annotated list, beside a built value of a declared record type of the same field name whose
// function returns f64, is built at its own row and called at the function's i32.
type R = { f: (a: i32) => f64 }
function inc0(a) { return a + 1 }
const r: R = { f: (a: i32): f64 => a / 3.0 }
const q = { f: inc0 }
const p2 = []
p2.push(q)
print(p2[0].f(4))
print(p2[0].f(4) / 2)
print(r.f(3))
