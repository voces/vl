// @run
// @log 3
// @log abab
// @log 4
// @log 3
// @log xyzxyz
// @log 5
// @log 3
// @log 2
// An un-annotated function delivered at a function type whose result is a union is boxed into
// that union at each delivery: an argument, a called function's result, a list element, a
// return and a choice of two such functions (D13781).
function only(n: string, f: (s: string) => string | i32) { return f(n) }
function lenOf(s) { return s.length }
function twice(s) { return s + s }
function deliver() { return lenOf }
print(only("abc", lenOf))
print(only("ab", twice))
print(only("abcd", deliver()))
const fs: ((s: string) => string | i32)[] = [lenOf, twice]
print(fs[0]("xyz"))
print(fs[1]("xyz"))
function box(): (s: string) => string | i32 { return lenOf }
print(box()("hello"))
function pass(n, f: (s: string) => string | i32) { return f(n) }
const k = [1].length > 1
print(pass("abc", if k { twice } else { lenOf }))
const v: (s: string) => string | i32 = if k { twice } else { lenOf }
print(v("ab"))
