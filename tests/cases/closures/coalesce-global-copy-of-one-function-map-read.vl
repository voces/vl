// @run
// @log 4
// @log 6
// A `??` over a global copy of a map read holding one un-annotated function's list holds the
// copy's closed type, with no set of functions in play (D17057).
function inc0(a) { return a + 1 }
const m4 = Map()
m4["k"] = [inc0]
const mv4 = m4["k"]
const got = mv4 ?? [inc0]
print(got[0](3))
let again = mv4 ?? [inc0]
again = [inc0]
print(again[0](5))
