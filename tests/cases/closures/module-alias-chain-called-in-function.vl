// @run
// @log aaa
// @log aaa
// @log aaa
// @log aaa
// @log aaa
// @log aa
// @info `d1` is never reassigned
// @info `d2` is never reassigned
// @info `k2` is never reassigned
// @info `m1` is never reassigned
// @info `w1` is never reassigned
// A module-scope chain of aliases of a hole lambda, `let` or `const`, called inside a function
// resolves at module scope, as the same call outside the function does (D3868).
const e = (y) => y + y + y
const c = (y) => y + y
let d1 = e
let d2 = d1
function viaLets() { d2("a") }
print(viaLets())
const k1 = e
let k2 = k1
function viaConstLet() { k2("a") }
print(viaConstLet())
let m1 = e
const m2 = m1
function viaLetConst() { m2("a") }
print(viaLetConst())
let w1 = e
let w2 = w1
function readThenWrite() {
  const r = w2("a")
  w2 = c
  r
}
print(readThenWrite())
print(d2("a"))
print(w2("a"))
