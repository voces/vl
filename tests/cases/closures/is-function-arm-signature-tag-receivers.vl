// @run
// @log glb A no
// @log glb B yes
// @log loc A no
// @log loc B yes
// @log par A no
// @log par B yes
// @log fld A no
// @log fld B yes
// @log ret A no
// @log ret B yes
// @log passthru A no
// @log passthru B yes
// @log three A no
// @log three B no
// @log three C yes
// @log str A no
// @log str B yes
// @log strval A no
// @log strval B no
// @log nul A no
// @log nul B yes
// @log st A no
// @log st B yes
// @log inline A no
// @log inline B yes
// @log mixspell A yes
// @log aliasparam A yes
// The SIGNATURE tag a bare function-typed union arm carries is a property of the TYPE, so
// every receiver, carrier form, arm count, partner arm and spelling reads the same answer.
//
// WHAT THIS FIXTURE MOVES, on top of `is-two-function-arms-both-directions.vl`'s two-arm
// axis: the RECEIVER (module global / local / parameter / struct field / call result), the
// CARRIER (a named-function reference here, a lambda literal there, and a box passed
// THROUGH a second union-typed position without being re-boxed — the `passthru` row), the
// ARM COUNT (three function arms), the PARTNER arm beside two function arms (a `string`,
// a `null`, a struct), and the SPELLING.
//
// WHAT IT HOLDS FIXED: every guard is an `if` condition, and every union carries at most
// one non-function arm. The receiver axis is where a wrong ANSWER and a wrong LOWERING
// look alike — each receiver form reads the same box field-0 tag, so a row that disagreed
// with its siblings would be about that form's own read rather than about the tag.
//
// THE `passthru` ROW IS THE SUB-UNION STABILITY CHECK. A box built at one site and handed
// to another union-typed position keeps the tag it was built with, so the signature slot
// has to be a MODULE-wide intern (`cloSigTagSlot`) and not a per-union rank; a per-union
// numbering would answer this row from the wrong table.
//
// THE TWO SPELLING ROWS ARE THE INTERNING CONTRACT. The tag's key is the canonical
// structural render (`tyToEmitName`), not the author's spelling, so `type F = (i32) => i32`
// and a bare `(i32) => i32` share one slot (`mixspell`), and so do `(I) => i32` and
// `(i32) => i32` for `type I = i32` (`aliasparam`). Two renders that agree MUST share a
// tag, or a value boxed through one spelling answers FALSE to its own type.

type A = (i32) => i32
type B = (i32) => string
type C = (i32, i32) => i32
type I = i32
type AI = (I) => i32
type St = { w: i32 }
type Holder = { g: A | B }

function bFn(n: i32) {
  if n > 0 { return "s" }
  "t"
}

const gU: A | B = bFn

function say(lbl: string, isA: boolean, isB: boolean) {
  if isA { print(lbl + " A yes") } else { print(lbl + " A no") }
  if isB { print(lbl + " B yes") } else { print(lbl + " B no") }
  0
}

function pPar(x: A | B) {
  say("par", x is A, x is B)
  0
}

function pPassthru(x: A | B) {
  say("passthru", x is A, x is B)
  0
}

function mkB(): A | B {
  bFn
}

function pThree(x: A | B | C) {
  if x is A { print("three A yes") } else { print("three A no") }
  if x is B { print("three B yes") } else { print("three B no") }
  if x is C { print("three C yes") } else { print("three C no") }
  0
}

function pStr(lbl: string, x: A | B | string) {
  say(lbl, x is A, x is B)
  0
}

function pNul(x: A | B | null) {
  say("nul", x is A, x is B)
  0
}

function pSt(x: A | B | St) {
  say("st", x is A, x is B)
  0
}

function pInline(x: ((i32) => i32) | ((i32) => string)) {
  say("inline", x is (i32) => i32, x is (i32) => string)
  0
}

function pMixSpell(x: A | B) {
  if x is (i32) => i32 {
    print("mixspell A yes")
  } else {
    print("mixspell A no")
  }
  0
}

function pAliasParam(x: AI | B) {
  if x is (i32) => i32 {
    print("aliasparam A yes")
  } else {
    print("aliasparam A no")
  }
  0
}

function main() {
  say("glb", gU is A, gU is B)
  const lU: A | B = bFn
  say("loc", lU is A, lU is B)
  pPar(bFn)
  const h: Holder = { g: bFn }
  say("fld", h.g is A, h.g is B)
  const rU = mkB()
  say("ret", rU is A, rU is B)
  pPassthru(rU)
  pThree((n: i32, m: i32) => n + m)
  pStr("str", bFn)
  pStr("strval", "zz")
  pNul(bFn)
  pSt(bFn)
  pInline(bFn)
  pMixSpell((n: i32) => n + 1)
  pAliasParam((n: i32) => n + 1)
  0
}

main()
