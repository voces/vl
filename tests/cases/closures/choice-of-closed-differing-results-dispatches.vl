// @run
// @log s
// @log s
// @log s
// @log true
// @log true
// @log true
// @log s
// @log 0
// @hint Intentionally-unused parameter `_a`
// @hint Intentionally-unused parameter `_a`
// A choice of two un-annotated functions whose closed results differ is one function type at the
// join of their results, carrying both, so a call through it dispatches (D17100).
function str(_a) { return "s" }
function bo(_a) { return true }
function ap(g, x) { return g(x) }
function run(c: boolean) {
  const g = if c { str } else { bo }
  print(g(3))
  print(ap(g, 4))
  const k: (a: i32) => string | boolean = g
  print(k(5))
}
run(true)
run(false)
function pick(c: boolean) {
  const g = if c { str } else { bo }
  const r = g(1)
  if r is string { print(r) } else { print(if r { 0 } else { 1 }) }
}
pick(true)
pick(false)
