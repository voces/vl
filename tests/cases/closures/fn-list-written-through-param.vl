// @run
// @log 1.5
// @log 1.5
// @log 2.5
// @log 4
// @log 1.5
// @log 1.5
// An inferred list of functions handed to an un-annotated parameter that writes or pushes
// another function into it, directly or through a second call: the write joins the list's
// element set, so a later call through the element runs the written function (D14648).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function put(ys) { ys[0] = half }
function hand(zs) { put(zs) }
function add(ys) { ys.push(half) }
function local() {
  const ws = [inc0]
  put(ws)
  return ws[0](3)
}
const xs = [inc0]
put(xs)
print(xs[0](3))
const vs = [inc0]
hand(vs)
print(vs[0](3))
const us = [inc0]
add(us)
print(us[1](5))
print(us[0](3))
const ts = [inc0, inc0]
put(ts)
print(ts[0](3))
print(local())
