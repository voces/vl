// @run
// @log 4
// @log 6
// @log 4
// @log 4
// @log 4
// The local twins: a `let` of a list or record literal holding a list of functions, reassigned
// from a call, in a loop or not, holds the joined set of its literal and the call's results.
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function pick(b) {
  const a = [{ fs: [inc0] }]
  if b { return a }
  return [{ fs: [dbl] }]
}
function mk() { return [{ fs: [inc0] }] }
function mkr() { return { fs: [inc0] } }
function viaPick() {
  let g = [{ fs: [dbl] }]
  g = pick(true)
  print(g[0].fs[0](3))
}
function readThenCall() {
  let g = [{ fs: [dbl] }]
  print(g[0].fs[0](3))
  g = mk()
  print(g[0].fs[0](3))
}
function record() {
  let g = { fs: [dbl] }
  g = mkr()
  print(g.fs[0](3))
}
function inLoop() {
  let g = [{ fs: [dbl] }]
  for i in [0, 1] {
    g = mk()
  }
  print(g[0].fs[0](3))
}
viaPick()
readThenCall()
record()
inLoop()
