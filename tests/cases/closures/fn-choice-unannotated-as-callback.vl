// @run
// @log 4
// @log 6
// @log 2
// @log 1
// @log 4
// @log 6
// @log 4
// @log 6
// An `if` choosing between two un-annotated functions, inline as a `.map` / `.filter` callback
// or handed to a generic higher-order parameter, takes the type its destination pins (D9005).
function ui(a) { return a + 1 }
function ud(a) { return a + a }
function ub(a) { return a > 2 }
function us(a) { return a < 2 }
function ap<T, R>(k: (x: T) => R, v: T): R { return k(v) }
function app<T>(g: (x: T) => T, v: T): T { return g(v) }
const c = [1].length > 0
const d = [1].length > 5
print([3].map(if c { ui } else { ud })[0])
print([3].map(if d { ui } else { ud })[0])
print([1, 3, 5].filter(if c { ub } else { us }).length)
print([1, 3, 5].filter(if d { ub } else { us }).length)
print(ap(if c { ui } else { ud }, 3))
print(ap(if d { ui } else { ud }, 3))
print(app(if c { ui } else { ud }, 3))
print(app(if d { ui } else { ud }, 3))
