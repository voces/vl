// @run
// @log done
// @log 42
// @log i
// @log 42
// @log i
// @log 5
// @log 3
// @log 10
// @log 10
// @log 42
// Regression (D2392). An un-annotated binding whose initializer infers a value union (an
// `if` expression, an optional chain) is boxed into a cell when a closure assigns it. The
// cell holds the union as its element; the binding's inferred union no longer names the
// cell itself, so the cell literal is built as a list and not coerced into the union.
function f(c: boolean) {
  let v = if c { 1 } else { "s" }
  const k = () => {
    v = 2
  }
  k()
  "done"
}
print(f(true))

function g(c: boolean) {
  let v = if c { 1 } else { "s" }
  const k = () => {
    v = 2
  }
  k()
  if v is i32 { print(v + 40) }
  const r = () => {
    if v is string { v } else { "i" }
  }
  r()
}
print(g(true))
print(g(false))

function h(c: boolean) {
  let v = if c { 1.5 } else { "s" }
  const k = () => {
    v = 2.5
  }
  k()
  if v is f64 { return v * 2.0 }
  0.0
}
print(h(false))

function lists(c: boolean) {
  let v = if c { [1, 2] } else { "s" }
  const k = () => {
    v = [3, 4, 5]
  }
  k()
  if v is i32[] { return v.length }
  0
}
print(lists(false))

type W = { w: i32 }
function chain(a: W | null) {
  let t = a?.w
  const k = () => {
    t = 9
  }
  k()
  if t != null { return t + 1 }
  0
}
print(chain(null))
print(chain({ w: 3 }))

if true {
  let v = if 1 > 0 { 1 } else { "s" }
  const k = () => {
    v = 7
  }
  k()
  if v is i32 { print(v * 6) }
}
