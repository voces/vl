// @run
// @log 307
// @log dup
// @log dup
// @log 307
// A written `let` of two generics reads as the set of both, so the list holds that set and each
// call through its element dispatches to the member the binding holds, at the call's types.
function id<T>(x: T): T { x }
function dup<T>(x: T): T {
  print("dup")
  x
}
function la(n: i32) {
  let v = id
  if n > 0 { v = dup }
  const xs = [v]
  print(xs[0]("abc").length * 100 + xs[0](7))
}
la(0)
la(1)
