// @run
// @log true
// @log 3
// @log 3
// @log s
// @log 3
// @log 5
// @log 3
// @log true
// Two records of one row hold one un-annotated function, and each call through the field is
// printed at the type the checker gave that call, not at another instance's result (D15115).
function g(a) { return a }
const a = { f: g, n: 1 }
const b = { f: g, n: 1 }
print(a.f(true))
print(b.f(3))
const u: i32 | string = "s"
print(a.f(3))
print(b.f(u))
const q: i32 | null = 5
print(a.f(3))
print(b.f(q) ?? 0)
print({ f: g, n: 2 }.f(3))
print({ f: g, n: 2 }.f(true))
