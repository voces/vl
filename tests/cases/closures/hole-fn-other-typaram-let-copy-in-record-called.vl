// @run
// @log w
// @info `b` is never reassigned; use `const` instead of `let`
// A parameter's `let` copy into a binding of another type parameter, held in a record and
// called through it, takes the parameter's instance (D6883).
function same<T>(k: T): T { k }
function mid<F, G>(a: G) {
  let b: F = a
  const r = { f: b }
  print(r.f("w"))
}
mid(same)
