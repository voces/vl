// @run
// @log A
// @log r
// @log B
// @log 3
// @log B
// @log q
// A written `let` stored into one written with more functions is tagged with it or not at all:
// here the smaller binding is captured, so neither is, and both still run at each call's type.
function gA<U>(u: U) {
  print("A")
  print(u)
}
function gB<V>(v: V) {
  print("B")
  print(v)
}
function gC<W>(w: W) {
  print("C")
  print(w)
}
let x = gA
const peek = () => x(3)
x("r")
x = gB
let y = gC
y = x
peek()
y("q")
