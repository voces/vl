// @run
// @log 8
// @log 8
// @log 12
// @log 8
// @log 4
// @log s
// @log 8
// @log 8
// A list or record literal of un-annotated functions written whole to an annotated `let` takes
// the binding's function type (D9670). The last two are controls that ran before: a bare function
// written to an annotated `let`, and the literal as the initializer.
function dbl(a) { return a * 2 }
function id(a) { return a }
function local() {
  let k: ((x: i32) => i32)[] = []
  k = [dbl]
  return k[0](4)
}
print(local())
let k: ((x: i32) => i32)[] = []
k = [dbl]
print(k[0](4))
function lam() {
  let w: ((x: i32) => i32)[] = []
  w = [(x) => x * 3]
  return w[0](4)
}
print(lam())
let r: { fs: ((x: i32) => i32)[] } = { fs: [] }
r = { fs: [dbl] }
print(r.fs[0](4))
let ki: ((x: i32) => i32)[] = []
let ks: ((x: string) => string)[] = []
ki = [id]
ks = [id]
print(ki[0](4))
print(ks[0]("s"))
let b: (x: i32) => i32 = (x) => x
b = dbl
print(b(4))
const init: ((x: i32) => i32)[] = [dbl]
print(init[0](4))
