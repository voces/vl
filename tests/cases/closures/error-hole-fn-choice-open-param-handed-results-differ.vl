// @error cannot choose 'lenOf' here: called at (string) it returns i32
// A choice of un-annotated functions whose results differ, handed beside a caller's
// un-annotated parameter to a callee that calls it there, is judged at the caller's pin (D13782).
function twice(s) { return s + s }
function lenOf(s) { return s.length }
function only(z, g) { return g(z) }
const k = [1].length > 1
function bad(z) { print(only(z, if k { twice } else { lenOf })) }
bad("ab")
