// @log 3
// A function nested in non-generic functions and capturing them, or a choice between such
// functions, handed to a parameter called at two types is delivered as one closure per
// signature (D15450).
function both(f) {
  print(f("a"))
  print(f(1))
}
function pick(c: i32, n: i32) {
  function inner(s) {
    print(n)
    return s
  }
  function ask(s) { return s }
  function third(s) {
    print(n + 1)
    return s
  }
  both(if c == 0 { inner } else if c == 1 { ask } else { third })
}
pick(0, 9)
pick(1, 9)
pick(2, 9)
function moved(n0: i32) {
  let n = n0
  function inner(s) {
    print(n * 2)
    return s
  }
  n = n + 0
  function twice(f) {
    print(f("v"))
    print(f(2))
  }
  twice(inner)
}
moved(9)
function outer(n: i32) {
  function mid(m: i32) {
    function inner(s) {
      print(n + m)
      return s
    }
    function show(f) {
      print(f("b"))
      print(f(3))
    }
    show(inner)
  }
  mid(1)
}
outer(10)
