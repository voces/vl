// @run
// @log 3
// An un-annotated alias of a narrowed record-arm binding, captured by a closure, keeps the arm's
// record (D4562).
type Out = { a: i32 }
type Err = { msg: string }
function mkOut(): Out | Err { return { a: 3 } }
function frame() {
  const r = mkOut()
  if r is Out {
    const c = r
    const f = () => { print(c.a) }
    f()
  }
}
frame()
