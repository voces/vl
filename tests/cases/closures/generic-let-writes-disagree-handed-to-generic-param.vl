// @run
// @warning Unused parameter `t` (prefix with `_` to suppress, or remove it)
// @log 1
// @log s
// A `let` holding generics whose results disagree at the call's argument types, handed through a
// generic parameter whose result is their join, dispatches on the one it holds (D12214, D16098);
// called directly it dispatches too (D16064).
function idg<T>(t: T) { return t }
function one<T>(t: T) { return 1 }
function app<T, R>(g: (x: T) => R, v: T): R { return g(v) }

let f = idg
f = one
print(app(f, "s"))

let g = idg
if "ab".length > 5 { g = one }
print(app(g, "s"))
