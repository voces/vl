// @run
// @log 1.5
// Un-annotated functions of different results written into one un-annotated `Map()` join its
// value set, as the same pair in a list does: a call through a value `get` reads runs the
// function stored there (D9311, D15137).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const m = Map()
m.set("a", inc0)
m.set("b", half)
const x = m.get("b")
if x != null { print(x(3)) }
