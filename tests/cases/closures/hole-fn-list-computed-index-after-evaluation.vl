// @run
// @hint redundant type annotation: `side` is inferred as `i32` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// @log side
// @log 3
// @log 4
// @log 8
// @log side
// @log 3
// @log 4
// @log true
// @log false
// A computed-index call handed a hole function, after other evaluation in its statement (D7483).
function add(a, b) { return a + b }
function apply2(g) {
  print(g(1, 2))
  print(g(1.5, 2.5))
  return 7
}
function side(): i32 { print("side"); return 1 }
const fs = [apply2]
const i = fs.length - 1
print(side() + fs[i](add))
const ok = side() > 0
print(ok && fs[i](add) > 0)
print(false && fs[i](add) > 0)
