// @log 4
// A function with an un-annotated parameter, stored by a maker into a record and called through
// the field of the call's result, directly and through nested fields (D17163).
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function mk(f) { return { f: f } }
function mk2(f) { return { r: { f: f } } }
function mk3(f) { return { a: { b: { f: f } } } }
function mk5(f) { return { a: { b: { c: { d: { f: f } } } } } }
function mkn(f, b: boolean) { return if b { { r: { f: f } } } else { null } }
print(mk(inc0).f(3))
print(mk(dbl).f(3))
print(mk2(inc0).r.f(3))
print(mk3(dbl).a.b.f(4))
print(mk5(inc0).a.b.c.d.f(8))
print(mk2(inc0)?.r.f(3))
print(mkn(inc0, true)?.r.f(3))
