// @run
// @log 5
// @log 4
// @log 4
// Records of a tagged set's ids in nested lists, at a top-level binding whose set was widened
// and in a function-local one whose set was not, share one list slot and read back correctly.
function inc0(a) { return a + 1 }
function inc2(a) { return a + 2 }
const two = [[{ fs: [inc0] }], [{ fs: [inc2, inc0] }]]
print(two[1][0].fs[0](3))
print(two[0][0].fs[0](3))
function local() {
  const ls = [[{ fs: [inc0] }]]
  print(ls[0][0].fs[0](3))
}
local()
