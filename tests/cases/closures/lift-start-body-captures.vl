// @run
// @log red!/3
// @log red?/3
// @log green!/3
// @log green?/3
// @log 2
// @log 10
// @log 11
// @log 121
// @log 121
// Lambdas in the start body's blocks that capture its locals are lifted: each call passes the
// captures, a local the host writes between calls is read at the call, and a local two lambdas
// share stays one cell that the lifted caller is passed.
for name in ["red", "green"] {
  const k = "3"
  const f = (s: string) => name + s + "/" + k
  print(f("!"))
  print(f("?"))
}
if true {
  let x = 1
  const dbl = () => x * 2
  print(dbl())
  x = 5
  print(dbl())
}
if true {
  let n = 1
  const bump = () => {
    n = n + 10
  }
  const show = () => {
    bump()
    print(n)
  }
  show()
  n = n + 100
  show()
  print(n)
}
