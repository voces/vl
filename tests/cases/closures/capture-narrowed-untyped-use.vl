// @run
// @log a
// @log <b>
// @log a
// @log 0
// @log null
// @log 0
// D3120, D3139: a closure that uses a narrowed capture itself (returns, prints or interpolates
// it) rather than handing it to a typed function: a literal union read out of a box returns at
// its atom, and a `K | null` copy of a walk variable prints its member.
type K = "a" | "b"
function t(e: K | i32) {
  if !(e is i32) {
    const f = () => e
    print(f())
    let c = e
    c = "b"
    const g = () => "<\{c}>"
    print(g())
  }
}
t("a")
function u(zz: (K | null | i32)[]) {
  for e in zz {
    if !(e is i32) {
      const c = e
      const f = () => {
        print(c)
        return 0
      }
      print(f())
    }
  }
}
u(["a", null, 3])
