// @run
// @log aC
// @log aE
// A list the program wrote holding a hole lambda, reassigned whole: `d = [e]` puts `e` in the
// class `c` is in, so both are pinned at the one signature the call through `d[0]` gives them,
// rather than at the hole's `i32` default (D3845).
function f(x: string) {
  const c = (y) => y + "C"
  const e = (y) => y + "E"
  let d = [c]
  print(d[0](x))
  d = [e]
  print(d[0](x))
}
f("a")
