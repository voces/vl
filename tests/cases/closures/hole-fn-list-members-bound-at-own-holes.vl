// @run
// @log 2.5
// @log 3.5
// @log 2.5
// @log 3.5
// A call through a list of two hole functions binds each member at its own holes and body, not
// at the first member's, whether the function handed on is named or a hole parameter.
function add(a, b) { return a + b }
function apply4(g, s) { print(g(s, 2)) }
function apply5(g, s) { print(g(3, s)) }
for f in [apply4, apply5] { f(add, 0.5) }
function three(k, h) {
  for f in [apply4, apply5] { f(h, k) }
}
three(0.5, add)
