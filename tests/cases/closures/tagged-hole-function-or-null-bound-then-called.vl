// @run
// @log 4
// @log 2
// @log true
// @log null
// @log fn
// A binding of a tagged set's member or `null`, chosen at run time, holds the member's id or null:
// a call through the non-null arm runs the member, and the null arm reads back as null.
function inc(a) { return a + 1 }
function two() { return [1, 2].length }
const g = if two() > 1 { inc } else { null }
if g != null { print(g(3)) }
const h = if two() > 5 { inc } else { null }
print(inc(1))
print(h == null)
print(if h == null { "null" } else { "fn" })
print(if g == null { "null" } else { "fn" })
