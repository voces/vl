// @run
// @log 2
// @log 3
// @log 2
// @log 3
// @log 3
// @log 4
// @log 2
// @log 3
// @log 4
// @log 3
// @log 4
// @log 2
// @log 3
// @log 4
// A `u8[]` binding a closure writes is read through its cell by `.length`, by index and by a
// `for … in`, plain and under a null check (D2413).
function plain() {
  let v: u8[] = [1]
  const q = () => {
    v = [2, 3]
  }
  q()
  print(v.length)
  print(v[1])
  for b in v { print(b) }
}
function nullable(n: i32) {
  let v: u8[] | null = null
  if n > 0 { v = [1] }
  const q = () => {
    v = [2, 3, 4]
  }
  q()
  if v != null {
    print(v.length)
    print(v[2])
    for b in v { print(b) }
  }
}
plain()
nullable(1)
nullable(0)
