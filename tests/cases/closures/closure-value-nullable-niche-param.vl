// @run
// @log 2
// @log 7
// @log 3
// @log 2
// @log 7
// @log 3
// @log 2
// @log 7
// @log 3
// @hint redundant type annotation: `fs` is inferred as `(string?) -> i32`
// @hint redundant type annotation: `fb` is inferred as `({w: i32}?) -> i32`
// @hint redundant type annotation: `fl` is inferred as `(i32[]?) -> i32`
// @hint redundant type annotation: `gs` is inferred as `(string?) -> i32`
// @hint redundant type annotation: `gb` is inferred as `({w: i32}?) -> i32`
// @hint redundant type annotation: `gl` is inferred as `(i32[]?) -> i32`
// @hint redundant type annotation: `hs` is inferred as `{fn: (string?) -> i32}`
// @hint redundant type annotation: `hb` is inferred as `{fn: ({w: i32}?) -> i32}`
// @hint redundant type annotation: `hl` is inferred as `{fn: (i32[]?) -> i32}`
// The annotations the hints name are LOAD-BEARING: each is what pins the value's signature
// (a lambda's param type, a named function's binding shape, a field closure's functype), and
// removing one is how a param falls back to the i32 default. Declared, not deleted.
// A function VALUE whose PARAMETER is a nullable-REF niche, called through its interned
// `$fnsig` — the general value-call dual of `.map`/`.filter` over a nullable-element array
// (`arrays/map-filter-nullable-element.vl`). Both go through one table: `repSigTokOfKind`
// gives `string | null` the token `N`, `S | null` the token `n<slot>;` and `i32[] | null` the
// token `o`, and `cloParamTok` admits them at the PARAM position, so the `call_indirect`
// functype declares the same `(ref null …)` the callee's own functype does.
//
// Until the param position admitted them, `cloSigKeyExt` keyed "" for every one of these and
// `emitClosureValueCore`'s floor rejected the VALUE
// (`error-nullable-niche-param-lambda-floor.vl`, which still pins that floor on the payloads
// with no token character).
//
// Three POSITIONS per payload, because the key has to be resolvable from each: an annotated
// binding holding a lambda, an annotated binding holding a named function, and a struct
// FIELD closure. The argument is a non-null value of the payload in every cell, so the
// `@log` lines pin the VALUE the callee read — a wrong param valtype shows up as a wrong
// number, not as a build failure.
type S = { w: i32 }
type HS = { fn: (string | null) => i32 }
type HB = { fn: (S | null) => i32 }
type HL = { fn: (i32[] | null) => i32 }

function slen(k: string | null) {
  if k == null { return 0 }
  return k.length
}
function bw(k: S | null) {
  if k == null { return 0 }
  return k.w
}
function llen(k: i32[] | null) {
  if k == null { return 0 }
  return k.length
}

const sv: string | null = "ab"
const bv: S | null = { w: 7 }
const lv: i32[] | null = [4, 5, 6]

// The lambda spelling — its param is pinned from the binding's annotation.
const fs: (string | null) => i32 = (k) => if k == null { 0 } else { k.length }
const fb: (S | null) => i32 = (k) => if k == null { 0 } else { k.w }
const fl: (i32[] | null) => i32 = (k) => if k == null { 0 } else { k.length }
print(fs(sv)) // 2
print(fb(bv)) // 7
print(fl(lv)) // 3

// The NAMED-function spelling through the same annotated binding.
const gs: (string | null) => i32 = slen
const gb: (S | null) => i32 = bw
const gl: (i32[] | null) => i32 = llen
print(gs(sv)) // 2
print(gb(bv)) // 7
print(gl(lv)) // 3

// A struct FIELD closure — the field's own valtype is the shared fat pointer, so the param
// token is the only thing that decides which functype the call `ref.cast`s to.
const hs: HS = { fn: slen }
const hb: HB = { fn: bw }
const hl: HL = { fn: llen }
print(hs.fn(sv)) // 2
print(hb.fn(bv)) // 7
print(hl.fn(lv)) // 3
