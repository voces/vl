// @run
// @log 1
// @log 2
// @log 3
// D3380: the result of a call through a function value, delivered as a `readonly` list of a
// union holding its record, is the view of the list the call returns: from a parameter, a
// local and a lambda's captured parameter.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function viaParam(fv: () => Circle[]): readonly Shape[] { return fv() }
function viaLocal(): readonly Shape[] {
  const fv = (): Circle[] => [{ r: 1 }, { r: 2 }]
  return fv()
}
function wrap(fv: () => Circle[]): () => readonly Shape[] {
  return (): readonly Shape[] => fv()
}
print(viaParam(() => [{ r: 1 }]).length)
print(viaLocal().length)
const e = wrap(() => [{ r: 4 }, { r: 3 }])()[1]
if e is Circle { print(e.r) }
