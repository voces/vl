// @run
// @log 3
// @log 2
// @log 2.25
// The control for D15018: the hole parameter is handed the function the `let` is written with.
function add(a, b) { return a + b }
function mul(a, b) { return a * b }
function two(g) {
  print(g(1, 2))
  print(g(0.5, 1.5))
}
two(add)
function swap(h) {
  let hh = h
  hh = mul
  print(hh(1.5, 1.5))
}
swap(mul)
