// @run
// @log 1
// @log 5
// A list of one hole parameter slot-written with a second, the two bound to different generics: the
// list holds the set of both, and a call through it dispatches to each member at its own types (D15572).
function id<T>(x: T): T { x }
function id2<U>(x: U): U { x }
function use(ys) { print(ys.length) }
function take(a, b) {
  const xs = [a]
  xs[0] = b
  use(xs)
  print(xs[0]("abc").length + xs[0](2))
}
take(id, id2)
