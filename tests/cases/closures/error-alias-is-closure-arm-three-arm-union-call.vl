// @emit-error emitProgram: call to unknown function
// CONTRACT (must-error, PRE-EXISTING FLOOR): narrowing a THREE-arm union's closure arm by
// its type ALIAS (`v is F`) and then CALLING the narrowed binding is refused at emit. The
// same program with the arm's INLINE spelling in the test lowers correctly, which is the
// whole content of the gap — it is the alias in the TEST that is not resolved to the arm's
// interned signature at the call, not the alias in the annotation.
//
// Measured on the same day this file was written, and each cell is one line away from the
// next (see the `nullable-closure-is-narrow-positions.vl` sibling for the two-arm grid):
//   · `v: F | i32 | null`, `if v is F { v(3) }`         — THIS FILE, refused;
//   · `v: F | i32 | null`, `if v is (i32) => i32 { … }`  — prints 4 (alias in the
//     annotation only, inline in the test);
//   · `v: ((i32) => i32) | i32 | null`, inline both      — prints 4;
//   · `v: F | null`, `if v is F { v(3) }`                — prints 4 (two arms);
//   · `v: F | i32 | null`, `if v is F { print("FN") }`   — prints FN/42/NUL (no call).
// So neither the alias, nor the three arms, nor the call is sufficient alone; the refusal
// needs the alias IN THE TEST together with the third arm and the call.
//
// THE MESSAGE IS WRONG FOR THIS PROGRAM and is recorded here as-is rather than improved:
// "call to unknown function" sends the reader to look for a missing declaration, when what
// is missing is the narrowed arm's `$fnsig` at the indirect call. Pinning it keeps the
// boundary honest — the shape is refused, loudly, and no `vl check`-clean invalid module
// escapes — and makes the message's own defect visible the day someone fixes the lowering.
//
// This floor is UNRELATED to the function-slot rep invariance that
// `error-is-functype-slot-rep-reject.vl` pins: it reproduces identically on the base commit
// of that change.
type F = (i32) => i32

function pick(k: i32): F | i32 | null {
  if k == 0 { return (x) => x + 1 }
  if k == 1 { return 42 }
  null
}

function reader(v: F | i32 | null) {
  if v is F { print(v(3)) }
  else if v is i32 { print(v) }
  else { print("NUL") }
}

reader(pick(0))
