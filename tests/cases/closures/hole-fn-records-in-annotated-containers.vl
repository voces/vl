// @run
// @log 1.5
// @log 1.5
// Records holding functions of different bodies run when the field type is annotated, since
// the annotation is the one type every call through the field returns (D9370's control).
type R = { f: (a: i32) => f64 }
function inc0(a: i32) { return a + 1.0 }
function half(a: i32) { return a / 2.0 }
const m: Map<string, R> = Map()
m.set("a", { f: inc0 })
m.set("b", { f: half })
const r = m.get("b")
if r != null { print(r.f(3)) }
const l: R[] = [{ f: inc0 }]
l.push({ f: half })
print(l[1].f(3))
