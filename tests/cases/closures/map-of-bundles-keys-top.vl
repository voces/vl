// @run
// A module map of two-signature bundles walked by its keys at top level keeps each bundle whole (D17095).
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
const m = Map()
m["a"] = lap((a) => a + 1)
for k in m.keys() { print(k) }
// @log a
// @hint Intentionally-unused variable `_a`
// @hint Intentionally-unused variable `_b`
