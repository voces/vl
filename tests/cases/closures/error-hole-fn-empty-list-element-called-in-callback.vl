// @error cannot infer a type for this empty list — `outer` calls its element, and an empty array literal has no element type
// The same floor when the element is called inside a `.map` callback and the list is relayed
// through a second un-annotated parameter (D9281).
function early(a) { return a.map((f) => f(4)).length }
function outer(b) { return early(b) }
print(outer([]))
