// @run
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// @log 1
// @log s
// @log 1.5
// @log true
// @log 5000000000
// @log 2
// @log t
// @log 3
// @log u
// A hole function whose tail is a call through a list element of lambdas returning the hole
// parameter returns the instance's type at every instance (D12300).
function outer(a) { const fs = [() => a]; fs[0]() }
function bound(a) { const f = () => a; const fs = [f]; fs[0]() }
function withArg(a) { const fs = [(_x: i32) => a]; fs[0](1) }
print(outer(1))
print(outer("s"))
print(outer(1.5))
print(outer(true))
print(outer(5000000000))
print(bound(2))
print(bound("t"))
print(withArg(3))
print(withArg("u"))
