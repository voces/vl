// @emit-error is written with a generic function inside a closure that every instance of the enclosing generic function shares
// A capture cell in a generic body is refused, not built at one instance's type, when the instances reached by recursion
// wants it at two function types (D3939, `rv3498/v12`).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function run<T>(x: T, y: T, again: boolean) {
  let k = inner
  const flip = () => {
    k = other
  }
  k(x)
  if again { run(true, false, false) }
  flip()
  k(y)
}
run(1, 2, true)
