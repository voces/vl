// @run
// @log I
// @log 1
// @log I
// @log true
// @log O
// @log false
// @log O
// @log 2
// A capture cell in a generic body runs when the instances reached by recursion want it at two
// function types (D3939, `rv3498/v12`).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function run<T>(x: T, y: T, again: boolean) {
  let k = inner
  const flip = () => {
    k = other
  }
  k(x)
  if again { run(true, false, false) }
  flip()
  k(y)
}
run(1, 2, true)
