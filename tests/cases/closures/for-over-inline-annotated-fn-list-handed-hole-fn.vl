// @run
// @log 3
// @log 4
// @log 30
// The annotated spelling of D8062: the list's functions declare their parameter's type, so the
// handed hole function is pinned by the declaration rather than by the calls.
function add(a, b) { return a + b }
function apply2(g: (a: i32, b: i32) => i32) {
  print(g(1, 2))
  print(g(1, 3))
}
function apply3(g: (a: i32, b: i32) => i32) { print(g(10, 20)) }
for f in [apply2, apply3] { f(add) }
