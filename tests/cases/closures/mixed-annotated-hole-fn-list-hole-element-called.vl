// @run
// @log 20
// The hole element of a list an annotated sibling closed, called at that type (D10790).
function apply2(g: (a: string, b: i32) => i32) { print(g("x", 2)) }
function apply3(g) { print(g("y", 20)) }
function snd(a: string, b: i32) { return b + a.length - 1 }
const fs = [apply2, apply3]
fs[1](snd)
