// @run
// @log 1
// @log 2
// @log 3
// @log concat
// @log hole
// @log 6
// @log 7
// @log 9
// @log 10
// A call through a function value whose result is `never` stands in every value position the
// design gives it: an argument (a scalar and a union parameter, nested), a concat operand, an
// interpolation hole, a `return`, an annotated binding, an `if` arm and a `??` operand.
type B = (s: string) => never
function takeI(x: i32) { return x * 2 }
function takeU(x: i32 | string) { return if x is i32 { x } else { x.length } }
function argScalar(bail: B, c: boolean) {
  if c { return 1 }
  return takeI(bail("argScalar"))
}
function argUnion(bail: B, c: boolean) {
  if c { return 2 }
  return takeU(bail("argUnion"))
}
function argNested(bail: B, c: boolean) {
  if c { return 3 }
  return takeI(takeI(bail("argNested")))
}
function concat(bail: B, c: boolean) {
  if c { return "concat" }
  return "a" + bail("concat")
}
function hole(bail: B, c: boolean) {
  if c { return "hole" }
  return "a\{bail("hole")}b"
}
function ret(bail: B, c: boolean) {
  if c { return 6 }
  return bail("ret")
}
function letInit(bail: B, c: boolean) {
  if c { return 7 }
  const v: i32 = bail("letInit")
  return v + 1
}
function ifArm(bail: B, c: boolean) {
  const v = if c { 9 } else { bail("ifArm") }
  return v
}
function coalesce(bail: B, n: i32 | null) {
  const v = n ?? bail("coalesce")
  return v
}
const bail = (s: string): never => {
  print(s)
  __trap__()
}
print(argScalar(bail, true))
print(argUnion(bail, true))
print(argNested(bail, true))
print(concat(bail, true))
print(hole(bail, true))
print(ret(bail, true))
print(letInit(bail, true))
print(ifArm(bail, true))
print(coalesce(bail, 10))
