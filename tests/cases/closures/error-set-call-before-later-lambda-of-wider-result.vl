// @error this call is typed `i32` by the functions it may run that come before it, and a lambda written into its set later returns `f64` at its arguments
// A call typed before a later lambda member cannot take that lambda's wider result, so it is refused
// where it was built invalid wasm; the lambda written before the call runs (D17000).
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
const xs = [inc0, dbl]
print(xs[1](3))
xs.push((x) => x / 2.0)
