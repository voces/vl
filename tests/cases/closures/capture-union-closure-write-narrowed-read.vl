// D2387/D2388: a value-union local a closure assigns lives in a cell, and each read of it is
// a synthetic `cell[0]` with no recorded type. Narrowed by `is`, that read must classify as
// the narrowed member: it printed a boolean as `0` and an i32 as `true`, and an f64 or i64
// member was check-clean invalid wasm.
// @run
// @log false
// @log false
// @log 2.5
// @log 7
// @log 2.5
// @log 5000000001
// @log 5
// @log 9.5,9.5,
// @log 2.5
// @log 2.5

// D2387's filed witness: the `for ... in` loop variable is scenery.
function forIn() {
  let out = ""
  const ys: (boolean | string)[] = [true]
  for v in ys {
    const k = () => {
      v = false
    }
    k()
    if v is boolean { out = out + "\{v}" }
  }
  out
}
print(forIn())

function boolFromString() {
  let v: boolean | string = "a"
  const k = () => {
    v = false
  }
  k()
  if v is boolean { "\{v}" } else { "?" }
}
print(boolFromString())

// D2388's filed witness.
function f64Write() {
  let out = ""
  let v: boolean | f64 = 1.5
  const g = () => {
    v = 2.5
  }
  g()
  if v is f64 { out = out + "\{v}" } else { out = out + "other" }
  out
}
print(f64Write())

// An i32 member written over a `true` initializer printed as `true`.
function i32FromBool() {
  let v: boolean | i32 = true
  const k = () => {
    v = 7
  }
  k()
  if v is i32 { "\{v}" } else { "?" }
}
print(i32FromBool())

// The complement narrowing reads the same cell.
function elseArm() {
  let v: boolean | f64 = true
  const k = () => {
    v = 2.5
  }
  k()
  if v is boolean { "b" } else { "\{v}" }
}
print(elseArm())

// An early-return guard, and arithmetic on the narrowed read.
function guardI64() {
  let v: boolean | i64 = true
  const k = () => {
    v = 5000000000
  }
  k()
  if !(v is i64) { return "no" }
  "\{v + 1}"
}
print(guardI64())

function nullableF64() {
  let v: f64 | null = null
  const k = () => {
    v = 2.5
  }
  k()
  if v != null { "\{v * 2.0}" } else { "null" }
}
print(nullableF64())

function forInF64() {
  let out = ""
  const ys: (f64 | string)[] = ["x", 1.5]
  for v in ys {
    const k = () => {
      v = 9.5
    }
    k()
    if v is f64 { out = out + "\{v}," }
  }
  out
}
print(forInF64())

// A captured parameter is boxed the same way.
function param(p: boolean | f64) {
  const k = () => {
    p = 2.5
  }
  k()
  if p is f64 { "\{p}" } else { "no" }
}
print(param(true))

// Read from a second closure rather than the frame that owns the cell.
function nestedRead() {
  let v: boolean | f64 = true
  const k = () => {
    v = 2.5
  }
  k()
  const r = () => {
    if v is f64 { "\{v}" } else { "no" }
  }
  r()
}
print(nestedRead())
