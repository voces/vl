// @run
// @log abc
// @log 7
// @log 2.5
// @log true
// @log 3
// @log 4
// @log 3
// @log ab
// @log 21
// @log abab
// @log 42
// @log abc
// @log 8
// A generic handed to an un-annotated parameter that the body lists in a `const` and calls only
// as `xs[k](...)` at a literal index runs at each call's type, through the parameter, a copy
// of it, and beside a direct call (D9653).
function id<T>(x: T): T { x }
function dbl<T>(x: T): T { x + x }
function take(a) {
  const xs = [a]
  print(xs[0]("abc"))
  print(xs[0](7))
  print(xs[0](2.5))
  print(xs[0](true))
}
take(id)
function both(a) {
  const xs = [a, a]
  print(xs[0]("abc").length)
  print(xs[1](3) + 1)
  print(a(1.5) * 2.0)
}
both(id)
function twice(a) {
  const xs = [a]
  print(xs[0]("ab"))
  print(xs[0](21))
}
twice(id)
twice(dbl)
function copied(a) {
  const v = a
  const xs = [v]
  print(xs[0]("abc"))
  print(xs[0](7) + 1)
}
copied(id)
