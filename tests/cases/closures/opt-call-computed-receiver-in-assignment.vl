// @run
// @log 1.5
// @log recv
// @log arg
// @log 3
// @log 1
// @log 13
// A `?.` call whose receiver is a call, inside an assignment's operand: the receiver is bound
// where the call stands, evaluated once and before the arguments, and a null one skips them
// (D15803).
function half(a: i32) { return a / 2.0 }
const rs = [{ f: half }]
let acc = 0.0
acc = acc + (rs.get(0)?.f(3) ?? 0.0)
print(acc)
let n = 0
function get(): { f: (a: i32) => f64 } | null {
  n = n + 1
  print("recv")
  return { f: half }
}
function arg() {
  print("arg")
  return 3
}
acc = acc + (get()?.f(arg()) ?? 0.0)
print(acc)
print(n)
function none(): { f: (a: i32) => f64 } | null { return null }
acc = acc + (none()?.f(arg()) ?? 10.0)
print(acc)
