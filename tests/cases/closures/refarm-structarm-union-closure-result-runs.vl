// @run
// @log OTHER
// @hint Intentionally-unused parameter `_q0`
// A closure whose result is a composite-only variant-box union (`(f32 | string)[] | {w: i32}`),
// returning only the list arm, is built at the delivered union, so its narrowed call reads the
// box it was built at (D16310). Its narrowed element is a string, so it prints OTHER.
function go() {
  const v: (i32) => (f32 | string)[] | {w: i32} = (_q0) => (["other"])
  const t0 = v(1)
  if (t0 is (f32 | string)[]) {
    const t1 = t0[0]
    if (t1 is f32) { print(t1) } else { print("OTHER") }
  } else {
    print("OTHER")
  }
}
go()
