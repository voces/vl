// @emit-error emitProgram: this call runs a function value that may hold any of a set of functions returning different types
// A set of functions returning different types, handed to an un-annotated list parameter and left
// closures, is held in the instance at one member's signature; a call through a copy re-pointed to
// another member would run it there, so the emitter refuses (D16747, open: dispatch per member).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function run(xs) {
  for x in xs {
    let y = x
    y = half
    print(y(3))
  }
}
run([inc0, half])
