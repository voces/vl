// @run
// @log 1.5
// @log abab
// @log 2
// @log ab!
// @log q!
// @log qq
// A list of un-annotated functions grown by `push` holds a set joined over its pushes, so a call
// through an element runs the member it holds at that call's tuple (D9060, D14645).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const xs = [inc0]
xs.push(half)
print(xs[1](3))
function twice(s) { return s + s }
function lenOf(s) { return s.length }
function shout(s) { return s + "!" }
function main() {
  const fs = [twice]
  fs.push(lenOf)
  fs.push(shout)
  for g in fs { print(g("ab")) }
}
main()
const gs = [shout]
gs.push(twice)
for h in gs { print(h("q")) }
