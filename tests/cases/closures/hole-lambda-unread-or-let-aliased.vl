// @warning Unused variable `top` (prefix with `_` to suppress, or remove it)
// @warning Unused variable `c` (prefix with `_` to suppress, or remove it)
// @warning Unused variable `l` (prefix with `_` to suppress, or remove it)
// @warning Unused variable `c` (prefix with `_` to suppress, or remove it)
// @warning Unused variable `c` (prefix with `_` to suppress, or remove it)
// @info `d` is never reassigned; use `const` instead of `let`
// @info `d` is never reassigned; use `const` instead of `let`
// @info `d` is never reassigned; use `const` instead of `let`
// @info `d` is never reassigned; use `const` instead of `let`
// An un-annotated lambda's parameter is typed by the calls that reach it. One that nothing reads
// has none and is not lowered (D3832); one called through a `let` initialized from its `const` is
// instantiated at that call, whether or not the `let` is reassigned (D3833).

// Never read, whatever its body needs of the parameter.
function unread(x: string) {
  const c = (y) => y + "C"
  const l = (y) => y.length
  x
}
print(unread("a"))
type A = { v: i32 }
function unreadField(x: string) {
  const c = (y) => y.v
  x
}
print(unreadField("a"))
const top = (y) => y + "T"
print("a")
function oneOfTwo(x: string) {
  const c = (y) => y + "C"
  const e = (y) => y + "E"
  e(x)
}
print(oneOfTwo("a"))

// Through a `let`, reassigned or not, and read from a nested lambda and a nested function.
function viaLet(x: string) {
  const c = (y) => y + "C"
  const e = (y) => y + "E"
  let d = c
  if x == "b" { d = e }
  d(x)
}
print(viaLet("a"))
print(viaLet("b"))
function plainLet(x: string) {
  const c = (y) => y + "C"
  let d = c
  d(x)
}
print(plainLet("a"))
function fromLambda(x: string) {
  const c = (y) => y + "C"
  let d = c
  const f = () => d(x)
  f()
}
print(fromLambda("a"))
function fromNamed(x: string) {
  const c = (y) => y + "C"
  let d = c
  function g() { d(x) }
  g()
}
print(fromNamed("a"))

// A record and an `f64` argument, and a lambda returned as a value.
function rec(a: A) {
  const c = (y) => y.v + 1
  let d = c
  d(a)
}
print(rec({ v: 4 }))
function num(x: f64) {
  const c = (y) => y * 2.0
  let d = c
  if x > 100.0 { d = (y) => y }
  d(x)
}
print(num(1.25))
function mk(): (s: string) => string {
  const c = (y) => y + "C"
  c
}
print(mk()("q"))
