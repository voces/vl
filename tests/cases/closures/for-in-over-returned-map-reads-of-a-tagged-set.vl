// @run
// @log none
// @log 4
// @log none
// @log 6
// A walk over a returned list of a tagged set's map reads, a missing key's null kept: the pin that
// closes the list keeps the set, so the loop variable and its calls hold the set's one rep (D17725).
function inc(a) { return a + 1 }
function dbl(a) { return a * 2 }
const m = Map()
m["k"] = inc
m["d"] = dbl
function missing() { return [m["zz"]] }
for f in missing() {
  if f != null { print(f(3)) } else { print("none") }
}
function three() { return [m["k"], m["q"], m["d"]] }
for g in three() {
  if g != null { print(g(3)) } else { print("none") }
}
