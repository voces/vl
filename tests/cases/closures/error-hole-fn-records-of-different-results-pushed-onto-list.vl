// @error cannot write 'half' to 'l[].f': called at (i32) it returns f64, where 'inc0', also written to it, returns i32 — every function a call through 'l[].f' may run must return one type
// A record pushed onto a list of records holding un-annotated functions is one more value of
// the element's field (D9370).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const l = [{ f: inc0 }]
l.push({ f: half })
print(l[1].f(3))
