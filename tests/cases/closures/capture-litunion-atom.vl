// @run
// @log a
// @log a
// @log a
// @log b
// A closure CAPTURING a NAMED literal-union value. No narrowing, no generics, no nesting —
// `type K = "a" | "b"` is the whole repro:
//
//     type K = "a" | "b"
//     function f(k: K) { const g = () => k
//       print(g()) }
//     f("a")
//   → `vl check` rc 0, clean; `vl run` → "type mismatch: expected (ref $type), found i32"
//
// A named litunion is an interned i32 ATOM and `captureValKind` sizes the env field i32,
// correctly. `exprIsLitAtom` resolved an identifier through three storage classes — the
// reader's own declared locals, its own params, the module globals — and a CAPTURE is a fourth
// none of them covers. So the READ answered "not an atom", `strReppedLitUnionAt` claimed a
// string-repped literal union, and `emitStrToAtom` handed the env field's i32 to `__str_eq__`.
// Both sides now come off `capturedBindingOf`, the same `parentBindingOf` answer
// `captureValKind` uses, so "what does this field hold" and "what rep does this read have" are
// one question about one node.
//
// `viaPrint` and `viaRebind` are the SILENT half of the same miss: no conversion was reached
// there, so the atom→member widen was simply SKIPPED and the read printed its RAW INTERNED ID
// (`0` where `a` is expected) — `vl check` clean, runs, wrong answer.
//
// `viaInline` is the CONTRAST that localises it, and it must stay working: an UN-NAMED literal
// union keeps its member `(ref $array)` string, so the env field and the read already agreed
// and the inline spelling was never broken. (A numeric litunion `1 | 2` and a `K[]` element
// were clean for the same reason — nothing string-repped to mistake.)
type K = "a" | "b"

function viaValue(k: K) {
  const gv = () => k
  print(gv())
}

function viaPrint(k: K) {
  const gp = () => {
    print(k)
  }
  gp()
}

function viaRebind(k: K) {
  const gr = () => {
    const kk = k
    print(kk)
  }
  gr()
}

viaValue("a")
viaPrint("a")
viaRebind("a")

function viaInline(k: "a" | "b") {
  const gi = () => k
  print(gi())
}

viaInline("b")
