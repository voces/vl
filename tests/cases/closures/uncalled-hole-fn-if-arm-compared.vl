// @run
// @log true
// @log false
// A hole function no call instantiates, bound through an `if`'s branches and compared: both
// sides of the first comparison are the one declaration, so they are equal, a different
// declaration is not, and neither comparison calls anything (D6981, D7180).
function exclaim(s) { return s + "!" }
function shout(s) { return s + "?" }
const on = [1].length == 1
const x = if on { exclaim } else { exclaim }
print(x == exclaim)
print(x == shout)
