// @run
// @hint Intentionally-unused parameter `_a`
// @log x2
// @log z5
// @log 2
// @log 5
// @log v3
// @log 3
// @log w9
// @log 9
// A lambda that calls its parameter, held only as a list element (pushed, or stored by index),
// called through the list at two function types: each call reaches its own instance.
import { toString } from "std:fmt"

function cat(a, b) { return a + b.toString() }
function snd(_a, b) { return b }
function apply2(g) { print(g("x", 2)) }
const gs = [apply2]
gs.push((g) => {
  print(g("z", 5))
})
for f in gs { f(cat) }
for f in gs { f(snd) }
const hs = [apply2]
hs[0] = (g) => {
  print(g("v", 3))
}
for f in hs { f(cat) }
for f in hs { f(snd) }
function main() {
  const n = 9
  const ks = [apply2]
  ks[0] = (g) => {
    print(g("w", n))
  }
  for f in ks { f(cat) }
  for f in ks { f(snd) }
}
main()
