// @run
// @log ok
// @log 7
// @log 2.5
// @log ok
// @log 7
// @log 2.5
// @log 7
// @log ok
// Two records that differ only in a function field's type keep one layout, and each instance
// of a function taking them calls through its own record's signature, inside a lambda too (D3110).
const s = { f: () => "ok" }
const b = { f: () => 7 }
const c = { f: () => 2.5 }
function hole(z) {
  const k = () => z.f()
  print(k())
}
hole(s)
hole(b)
hole(c)
function gen<Z>(z: Z) {
  const k = () => {
    const j = () => z.f()
    return j()
  }
  print(k())
}
gen(s)
gen(b)
gen(c)
function ret(z) {
  const k = () => z
  print(k().f())
}
ret(b)
ret(s)
