// @run
// @log 5
// @log 2
// @log u
// @log 2
// A record of a written let of two hole lambdas, built in a generic, called at each instance's type: the slot closes to the lambdas' agreeing instance there.
function inR<T>(x: T) {
  let k = (n) => {
    print(n)
    return 1
  }
  k = (n) => {
    print(n)
    return 2
  }
  const o = { f: k }
  print(o.f(x))
}
inR(5)
inR("u")
