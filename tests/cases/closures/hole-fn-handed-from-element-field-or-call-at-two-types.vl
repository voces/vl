// @log ab
// A hole function read from a list element, a record field or a call result, handed to a hole
// parameter that calls it at two types, is instanced at each call's own types (D12231).
function add(a, b) { return a + b }
function apply2(g) {
  print(g(1, 2))
  print(g(1.5, 2.5))
}
const fs = [add]
apply2(fs[0])
const r = { f: add }
apply2(r.f)
function addT<T>(a: T, b: T): T { return a + b }
function pickIt() { addT }
apply2(pickIt())
function applyS(g) {
  print(g(1, 2))
  print(g("a", "b"))
}
const gs = [addT]
applyS(gs[0])
