// @run
// @log 1
// @log loud
// @log s
// @log 10
// @log loud
// @log m
// @log loud
// @log true
// Two written bindings of one generic set, each delivered through an adapter at its own closed
// function type: a call through the set's value owns its members' constraints, not every
// generic's (D15066).
function id<T>(x: T): T { return x }
function loud<T>(x: T): T {
  print("loud")
  return x
}
function mk(): (x: boolean) => boolean {
  let h = id
  h = loud
  print(h("m"))
  return h
}
function main() {
  let f = id
  print(f(1))
  const u: (x: i32) => i32 = f
  f = loud
  print(f("s"))
  print(u(10))
  print(mk()(true))
}
main()
