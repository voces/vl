// @run
// @log I
// @log 3
// @log I
// @log true
// @warning Unused variable `flip` (prefix with `_` to suppress, or remove it)
// A written capture cell placed in a list and called through it at one type, then delivered at
// another, runs (D7102).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function cb(f: (b: boolean) => void, b: boolean) { f(b) }
function main() {
  let k = inner
  const flip = () => {
    k = other
  }
  const fs = [k]
  fs[0](3)
  cb(k, true)
}
main()
