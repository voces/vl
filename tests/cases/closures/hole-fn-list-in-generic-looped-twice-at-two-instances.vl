// @log 9
// D10702 with two loops handed different lambdas, in a generic at two instances.
function apply2(g) { print(g(1, 2)) }
function apply3(g) { print(g(10, 20)) }
function gen<T>(x: T) {
  const gs = [apply2, apply3]
  for f in gs { f((a, b) => a + b) }
  for f in gs { f((a, b) => a * b) }
}
gen("z")
gen(1)
function tick() { print(9) }
tick()
