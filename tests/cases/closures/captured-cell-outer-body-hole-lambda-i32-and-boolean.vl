// @run
// @log I
// @log 1
// @log L
// @log 1
// @log I
// @log true
// @log L
// @log true
// A hole lambda written to a captured `let` in a generic body called at two types runs: the body
// is copied per instance, so each copy's binding holds functions of one signature (D6322).
function inner<U>(u: U) { print("I"); print(u) }
function a<T>(x: T) {
  let k = inner
  const rd = () => {
    k(x)
  }
  rd()
  k = (u) => {
    print("L"); print(u)
  }
  rd()
}
a(1)
a(true)
