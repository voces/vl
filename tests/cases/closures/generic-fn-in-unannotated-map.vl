// @run
// @log 3
// @log 3
// @log 3
// @log 3
// @log 3
// @log 3
// @log 3
// @log 3
// @log 3
// @log 3
// @log s
// A generic function written into an un-annotated `Map()` gives the map its value type at
// the one instance its calls agree on, in a list or record held as the value too (D4579).
function id<T>(x: T): T { x }
function zero(a: i32) { a - a }
const m = Map()
m["k"] = id
const x = m["k"]
if x != null { print(x(3)) }
if m["k"] != null { print(m["k"](3)) }
print((m["k"] ?? zero)(3))
const s = Map()
s.set("k", id)
const y = s.get("k")
if y != null { print(y(3)) }
print((s.get("k") ?? zero)(3))
function mk() {
  const r = Map()
  r["k"] = id
  return r
}
const mm = mk()
const z = mm["k"]
if z != null { print(z(3)) }
const w = Map()
function fill() { w.set("k", id) }
fill()
const u = w.get("k")
if u != null { print(u(3)) }
const l = Map()
l["k"] = [id]
const lv = l["k"]
if lv != null { print(lv[0](3)) }
const o = Map()
o["k"] = { f: id }
const ov = o["k"]
if ov != null { print(ov.f(3)) }
const xs = []
xs.push(id)
print(xs[0](3))
function go() {
  const g = Map()
  g.set("k", id)
  const v = g.get("k")
  if v != null { print(v("s")) }
}
go()
