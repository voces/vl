// @run
// @log 4
// @log 6
// @log 10
// @log 4
// A nested list of un-annotated functions stored into an un-annotated map runs, by index and by
// `.set`, at the top level and inside a function, read back narrowed or through `??` (D9715). The
// last case, a flat list as the value, is a control that ran before.
function inc0(a) { return a + 1 }
const m0 = Map()
m0["k"] = [[inc0]]
const x0 = m0["k"]
if x0 != null { print(x0[0][0](3)) }

function inc1(a) { return a + 1 }
function dbl1(a) { return a * 2 }
function go1() {
  const m = Map()
  m.set("k", [[inc1], [dbl1, inc1]])
  m["j"] = [[dbl1]]
  const x = m["k"]
  if x != null { print(x[1][0](3)) }
  const y = m["j"] ?? []
  print(y[0][0](5))
}
go1()

function inc2(a) { return a + 1 }
const m2 = Map()
m2["k"] = [inc2]
const x2 = m2["k"]
if x2 != null { print(x2[0](3)) }
