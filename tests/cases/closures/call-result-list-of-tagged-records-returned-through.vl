// @run
// @log 4
// @log 4
// A function returning a call's list of records holding un-annotated functions with differing
// results, un-bound, returns it at the row its literals build (D17006); stored in a record field.
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function mk() { return { a: [{ f: inc0 }, { f: half }] } }
function via() { return mk().a }
const xs = via()
print(xs[0].f(3))
const w = { f: via() }
print(w.f[0].f(3))
