// @run
// @log 3
// @log s
// A list of one un-annotated lambda, called through a hole parameter's elements at two types,
// reads each element as the lambda itself, so each call is its own instance (D6603).
function run(fs) {
  print(fs[0](3))
  return fs[1]("s")
}
const h = (u) => u
print(run([h, h]))
