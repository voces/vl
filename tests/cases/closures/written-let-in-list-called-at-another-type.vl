// @run
// @log B
// @log 2
// @log B
// @log true
// A list holding a written `let` of generics is called at the type its element call gives it,
// and a call of the `let` itself at another type takes its own instance (D3978).
function gA<U>(u: U) {
  print("A")
  print(u)
}
function gB<V>(v: V) {
  print("B")
  print(v)
}
let x = gA
x = gB
const y = [x]
x(2)
y[0](true)
