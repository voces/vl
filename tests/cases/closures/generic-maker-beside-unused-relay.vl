// @run
// @log 41
// @log 42
// @log 43
// @log 2.5
// @warning Unused function `relay`
// @warning Unused function `twice`
// A generic maker used at `f64` and delivered at `(x: i32) => i32` keeps one instance per result
// beside relays of it that nothing calls: an unused relay, a chain of them, and one with two
// returns. Their bodies never run, so their reads of the maker ask for no instance (D16757).
function k<T>(x: T): T { return x }
function mk() { return k }
const o = mk()
const of = o(2.5)
function deliver() { return mk() }
function relay() { return deliver() }
function twice(n: i32) {
  if n > 0 { return mk() }
  return mk()
}
const v: (x: i32) => i32 = mk()
print(v(41))
const w: (x: i32) => i32 = mk()
print(w(42))
function use(f: (x: i32) => i32) { print(f(43)) }
use(mk())
print(of)
