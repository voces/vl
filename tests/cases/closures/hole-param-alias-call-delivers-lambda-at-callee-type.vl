// @run
// A call through a never-written `const` alias of a hole parameter calls the function the
// instance binds the parameter to, as a call through the parameter does, so a hole lambda handed
// there takes that function's parameter type (D12216).
function twof(a: f64, b: (n: f64) => f64) { b(a) }
function twoi(a: i32, b: (n: i32) => i32) { b(a) }
function outer(h, x) {
  const f = h
  const g = f
  return g(x, (n) => n * 2)
}
print(outer(twof, 1.5))
print(outer(twoi, 4))
// @log 3
// @log 8
