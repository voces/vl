// @run
// @log 6
// @log none
// @log 3
// @log 17
// @log gone
// @log before
// @log 3
// A captured `i32 | null`, which rides the union box, narrowed inside the closure or where the
// closure is written, reads unboxed at the member, as legacy's `unbox` arm reads it.
function inBody(u: i32 | null) {
  const f = () => {
    if u != null { print(u + 1) } else { print("none") }
  }
  f()
}
inBody(5)
inBody(null)
function atSite(u: i32 | null) {
  if u != null {
    const g = () => {
      print(u * 3)
    }
    g()
  }
}
atSite(1)
function reassigned() {
  let u: i32 | null = 1
  const g = () => {
    if u != null { print(u + 10) } else { print("gone") }
  }
  u = 7
  g()
  u = null
  g()
}
reassigned()
function readLater(u: i32 | null) {
  if u != null {
    const h = () => {
      print(u - 1)
    }
    print("before")
    h()
  }
}
readLater(4)
