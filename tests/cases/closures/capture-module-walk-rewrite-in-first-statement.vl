// @run
// @hint redundant type annotation: `p` is inferred as `{x: i32}` — remove it to lean on inference
// @log 3
// @log 2
// D3139: a module-scope loop over a rewritten header (`hk?.ks`) whose first statement holds a
// rewrite (a user `+`) enclosing the capture still scopes its variable over the closure.
type K = "a" | "b"
type V = { x: i32 }
type H = { ks: K[] }
function "+"(self: V, other: V) { return self.x + other.x }
function mk(f: () => K): V {
  if f() == "a" { return { x: 1 } }
  return { x: 2 }
}
const hk: H = { ks: ["b", "a"] }
const p: V = { x: 1 }
for e in hk?.ks {
  const s = mk(() => e) + p
  print(s)
}
