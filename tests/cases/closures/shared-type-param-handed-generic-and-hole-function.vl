// @log x
// @log 3
// @log x
// @log 4
// @log 3
// @log x
// One type parameter shared by a generic and a hole function binds the union of their sets in
// either order, so the parameter called at two types dispatches on the id it holds (D15458).
function go<F>(a: F, b: F) {
  print(a(3))
  print(a("x"))
}
function both<F>(a: F, b: F) {
  print(a(3))
  print(a("x"))
  print(b(4))
}
function viaLet<F>(a: F, b: F) {
  let hh = a
  hh = b
  print(hh(3))
  print(a("x"))
}
function same<T>(k: T): T { k }
function dbl(x) { x }
go(same, dbl)
go(dbl, same)
both(same, dbl)
viaLet(same, dbl)
