// @run
// @log 2
// @log s
// @log 2
// @log s
// @log 2
// @log true
// @log s
// @log 11
// @log s
// A hole lambda calling its parameter at several signatures, handed to a parameter that only
// calls it with a generic, takes the generic's closure at each signature in one bundle.
function id(a) { return a }
function dup(a) { return a }
const lap = (g) => {
  print(g(1) + 1); return g("s")
}
function use(k) { print(k(id)); return k(dup) }
print(use(lap))
const lap3 = (g) => {
  print(g(1) + 1); print(g(true)); return g("s")
}
function use3(k) { return k(id) }
print(use3(lap3))
function main() {
  const n = 10
  const cap = (g) => {
    print(g(n) + 1); print(g("s"))
  }
  function useCap(k) { k(id) }
  useCap(cap)
}
main()
