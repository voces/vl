// @run
// @log 3
// @log 4
// @log 30
// D7841 with every destination of the handed function's results annotated.
function add(a, b) { return a + b }
function apply2(g): void {
  const x: i32 = g(1, 2)
  const y: f64 = g(1.5, 2.5)
  print(x)
  print(y)
}
function apply3(g): void {
  const z: i32 = g(10, 20)
  print(z)
}
const fs = [apply2, apply3]
for f in fs { f(add) }
