// @run
// @log O
// @log 1
// @log O
// @log true
// @log O
// @log s
// @log O
// @log 2.5
// @log I
// @log 1
// @log I
// @log true
// A capture cell seeded with a generic function and written with another by a closure every instance shares holds the written generic's instance at each instance's type, whether or not the writer runs (D3953, D3954).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function a<T>(x: T) {
  let k = inner
  const toO = () => {
    k = other
  }
  toO()
  k(x)
}
function b<T>(x: T, w: boolean) {
  let k = inner
  const toO = () => {
    k = other
  }
  if w { toO() }
  k(x)
}
a(1)
a(true)
a("s")
a(2.5)
b(1, false)
b(true, false)
