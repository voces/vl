// @run
// @log -4
// @log -4
// @log 8
// @log x!
// @log -5
// @log -4
// @info `lap` is never reassigned; use `const` instead of `let`
// @info `lapIn` is never reassigned; use `const` instead of `let`
// D5791: a generic handed to an un-annotated parameter of a `let` lambda the program never
// writes is instanced at the arguments that lambda's body calls it with, as for a `const`: two
// calls, two functions, a string, a read inside a function and a local binding.
function neg(a) { return 0 - a }
function dbl(a) { return a * 2 }
function hi(a) { return a + "!" }
let lap = (g, x) => g(x)
print(lap(neg, 4))
print(lap(neg, 4))
print(lap(dbl, 4))
print(lap(hi, "x"))
function run() { return lap(neg, 5) }
print(run())
function main() {
  let lapIn = (g, x) => g(x)
  print(lapIn(neg, 4))
}
main()
