// @run
// @log 4
// @log 1.5
// @log 4
// @log 4
// @log 4
// @log 4
// @log 4
// @log 9
// @log 3
// @info `lali` is never reassigned; use `const` instead of `let`
// @info `linc` is never reassigned; use `const` instead of `let`
// A `const` or once-bound `let` holding an un-annotated lambda, or naming an un-annotated
// function, is handed to `.map` or a generic function parameter as the function itself is: its
// instance is taken at the element or the bound type (D8981).
function inc0(a) { return a + 1 }
const inc = (a) => a + 1
const half = (a) => a / 2.0
const ali = inc0
let lali = inc0
let linc = (a) => a + 1
function ap<T, R>(k: (a: T) => R, x: T): R { return k(x) }
print([3].map(inc)[0])
print([3].map(half)[0])
print([3].map(ali)[0])
print([3].map(lali)[0])
print([3].map(linc)[0])
print(ap(inc, 3))
print(ap(lali, 3))
let s = 0
for y in [1, 2].map(inc) { s = s + y }
print(s + 4)
const hs = [ap(half, 3)]
print(hs[0] * 2.0)
