// @run
// @log 4
// @log 1.5
// @log 9
// @log 9
// A `const` naming a record literal of an un-annotated function, pushed into a list of records
// whose functions return different types, is built at the list's record as its literal pushed in
// place is (D16998).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function trip(x) { return x * 3 }
const xs = [{ f: inc0 }, { f: half }]
const v = { f: trip }
xs.push(v)
for r in xs { print(r.f(3)) }
print(v.f(3))
