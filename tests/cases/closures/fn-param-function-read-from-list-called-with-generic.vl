// @run
// @log 3
// @log 30
// @log 3
// @log 30
// @log 3
// @log 30
// A function whose parameter is a declared function type, read out of a list as an element, an
// alias of an element or a loop variable, takes a generic function at that parameter's type (D7280).
function add(a, b) { return a + b }
function apply2(g: (a: i32, b: i32) => i32) { print(g(1, 2)) }
function apply3(g: (a: i32, b: i32) => i32) { print(g(10, 20)) }
const fs = [apply2, apply3]
fs[0](add)
fs[1](add)
const h = fs[0]
h(add)
const k = fs[1]
k(add)
for f in fs { f(add) }
