// @run
// @log w
// A parameter's `const` copy annotated with another type parameter, stored in a record and
// called through the field, takes the parameter's type (D6883).
function same<T>(k: T): T { k }
function mid<F, G>(a: G) {
  const b: F = a
  const r = { f: b }
  print(r.f("w"))
}
mid(same)
