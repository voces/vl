// @run
// @log null
// @log null
// @log null
// @log null
// @log null
// @log null
// @log true
// @log false
// A `null`-typed binding a closure shares by reference (a never-filled `let x = null`, or one
// annotated `null`) takes writes of `null` inside the closure and in its frame after the capture;
// a stamped store into a `(boolean | null)[]` is unchanged (D17300).
function inside() {
  let n = null
  const f = () => {
    n = null
    print(n)
  }
  f()
  print(n)
}
function annotated() {
  let n: null = null
  const f = () => {
    n = null
  }
  f()
  print(n)
}
function outside() {
  let n = null
  const f = () => {
    print(n)
  }
  n = null
  f()
}
function twice() {
  let n = null
  const f = () => {
    n = null
  }
  const g = () => {
    print(n)
  }
  f()
  g()
  f()
  g()
}
function nulBools() {
  const p: (boolean | null)[] = [true, false]
  p[0] = null
  print(p[0] == null)
  print(p[1])
}
inside()
annotated()
outside()
twice()
nulBools()
