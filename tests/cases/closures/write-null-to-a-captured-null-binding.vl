// @run
// @hint redundant type annotation: `n` is inferred as `null`
// @hint redundant type annotation: `m` is inferred as `null`
// @log null
// @log null
// @log null
// @log null
// @log null
// @log null
// @log true
// @log false
// @log eff
// @log null
// @log eff
// @log null
// A `null`-typed binding a closure shares by reference (a never-filled `let x = null`, or one
// annotated `null`) takes writes of `null` inside the closure and in its frame after the capture,
// a call's effect running once; a stamped store into a `(boolean | null)[]` is unchanged (D17300).
function nothing(): null {
  print("eff")
  return null
}
function inside() {
  let n = null
  const f = () => {
    n = null
    print(n)
  }
  f()
  print(n)
}
function annotated() {
  let n: null = null
  const f = () => {
    n = null
  }
  f()
  print(n)
}
function outside() {
  let n = null
  const f = () => {
    print(n)
  }
  n = null
  f()
}
function twice() {
  let n = null
  const f = () => {
    n = null
  }
  const g = () => {
    print(n)
  }
  f()
  g()
  f()
  g()
}
function nulBools() {
  const p: (boolean | null)[] = [true, false]
  p[0] = null
  print(p[0] == null)
  print(p[1])
}
function effects() {
  let n = null
  const f = () => {
    n = nothing()
  }
  f()
  print(n)
  let m: null = null
  const g = () => {
    print(m)
  }
  m = nothing()
  g()
}
inside()
annotated()
outside()
twice()
nulBools()
effects()
