// @run
// @log B
// @log z
// @log B
// @log 1
// The same instance whichever call comes first (D4244).
function gA<U>(u: U) {
  print("A")
  print(u)
}
function gB<V>(v: V) {
  print("B")
  print(v)
}
function gC<W>(w: W) {
  print("C")
  print(w)
}
type M = "p" | 1
const m: M = 1
const s: string = "z"
let x = gA
x = gB
let y = gC
y = x
x(s)
y(m)
