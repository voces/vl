// @run
// @log 5
// @log null
// A hole function or `null` bound at an annotated nullable function type is a nullable closure at
// the annotation's signature, null in the arm that gives it.
function inc(a) { return a + 1 }
function two() { return [1, 2].length }
const k: ((x: i32) => i32) | null = if two() > 1 { inc } else { null }
if k != null { print(k(4)) }
const m: ((x: i32) => i32) | null = if two() > 5 { inc } else { null }
print(if m == null { "null" } else { "fn" })
