// @run
// @log a
// A hole lambda nothing calls, stored in the capture cell of a binding a nested function writes
// and nothing reads, is dead: its cell needs no signature (D3851).
function mk(x: string) {
  const c = (y) => y + "C"
  let d1 = c
  function w3() {
    d1 = c
    return 0
  }
  print(x)
}
mk("a")
