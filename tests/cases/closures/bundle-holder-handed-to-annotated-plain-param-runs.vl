// A bundle holder handed to a plain function's parameter annotated at one member's type hands
// that member (D15861): beside a call through the holder, at two members, and at module scope.
function lap(f) {
  f(2.5)
  f(3)
  return f
}
function u(f: (f64) => f64) { print(f(4)) }
function w(f: (i32) => i32) { print(f(7)) }
function main() {
  const k = lap((a) => a + 1)
  u(k)
  print(k(3))
}
main()
function two() {
  const k = lap((a) => a + 1)
  u(k)
  w(k)
  print(k(3))
}
two()
const m = lap((a) => a + 1)
u(m)
print(m(3))
