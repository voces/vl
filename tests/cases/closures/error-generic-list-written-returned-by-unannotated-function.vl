// @error push: cannot add (i32) => i32 to ((string) => string)[] (written into `ys`, delivered at ((string) => string)[])
// A list of a generic function written with a fixed-type function refuses when an un-annotated
// function hands it back into a binding whose element the written value does not fit (D10121).
function id<T>(x: T): T { x }
function inc(x: i32): i32 { x + 1 }
const ys = [id]
ys.push(inc)
function deliver() { return ys }
const v: ((x: string) => string)[] = deliver()
print(v[1]("s"))
