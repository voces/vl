// @run
// @log 4
// @log 1.5
// @log 1.5
// @log 1.5
// @log 5.5
// @log 5.5
// @log 5.5
// @log 5.5
// @log 1.5
// @log 5.5
// A list of record literals whose function field holds un-annotated functions returning different
// types: a call through the field runs the member stored there, its result the join of theirs.
// Indexed at runtime, bound, walked, returned, sliced, a returned list sliced and bound, and an
// element of a call (D15791, D15790).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function two() { [1, 2].length }
function mk() { return [{ f: inc0 }, { f: half }] }
const rs = [{ f: inc0 }, { f: half }]
let i = 0
while i < two() {
  print(rs[i].f(3))
  i = i + 1
}
const g = rs[two() - 1].f
print(g(3))
print(rs[1].f(3))
let acc = 0.0
for r in rs { acc = acc + r.f(3) }
print(acc)
let acc2 = 0.0
i = 0
while i < two() {
  acc2 = acc2 + mk()[i].f(3)
  i = i + 1
}
print(acc2)
const s = rs.slice(0, two())
print(s[0].f(3) + s[1].f(3))
const ms = mk().slice(0, two())
print(ms[0].f(3) + ms[1].f(3))
const e = mk()[two() - 1]
print(e.f(3))
const b = mk()
print(b[0].f(3) + b[1].f(3))
