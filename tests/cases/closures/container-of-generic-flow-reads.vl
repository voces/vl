// @run
// @log 2
// @log s
// @log t
// @log 3
// @log 4
// @log u
// @log 5
// @log v
// @log 6
// @log w
// @log 7
// @log x
// @warning this `??` default is never used: `i32` is never null
// @warning this `??` default is never used: `string` is never null
// A literal slot holding one generic, reached through a written `let` in a function and at
// module scope, through a call returning the literal, and through `?.`. Each read takes its own
// instance (D4515).
function id<T>(x: T): T { x }
function la() {
  let v = [id]
  v = [id]
  print(v[0](2))
  print(v[0]("s"))
  const a = v[0]
  print(a("t"))
  print(a(3))
}
la()
let mv = [id]
mv = [id]
print(mv[0](4))
print(mv[0]("u"))
function pick() { return { f: id } }
const r = pick()
print(r.f(5))
print(r.f("v"))
function pickList(b: boolean) {
  if b { return [id] }
  [id, id]
}
const pl = pickList(true)
print(pl[0](6))
print(pl[0]("w"))
const o = { g: { f: id } }
print(o.g?.f(7) ?? 0)
print(o.g?.f("x") ?? "")
