// @run
// @log 1
// @log 2
// @log 3
// @log 4
// @log 5
// @log 6
// @log 7
// @info `f` is never reassigned; use `const` instead of `let`

// Two sibling module-level blocks binding one CLOSURE name. The drop decision for a call
// STATEMENT asks whether the callee's `$fnsig` is void, and it asked by NAME with no position:
// the module rung declines on a name two sibling blocks bind, and an empty key reads as
// "returns a value", so a void call took a `drop` with nothing to drop (D1862).

// Every block prints a DIFFERENT value on purpose — a fixture printing the same value twice
// cannot tell the two blocks' closures apart, which is the thing being pinned.
if true {
  const f = () => {
    print(1)
  }
  f()
}
if true {
  const f = () => {
    print(2)
  }
  f()
}

// A third sibling, and a `let` binding: the name is what is shared, not the storage class.
if true {
  let f = () => {
    print(3)
  }
  f()
}

// A void EXPRESSION body, not a block — the body shape is not an ingredient.
if true {
  const g = () => print(4)
  g()
}
if true {
  const g = () => print(5)
  g()
}

// One void and one value-returning closure under one name: the mixed pair the ladder has to
// answer per block rather than per name.
if true {
  const h = () => {
    print(6)
  }
  h()
}
if true {
  const h = () => 7
  print(h())
}
