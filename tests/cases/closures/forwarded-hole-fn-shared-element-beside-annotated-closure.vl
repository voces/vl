// @run
// @log 1
// @log 2.5
// @log 2.5
// @log 3.5
// @log 3
// @log -0.5
// @log 5
// A hole function listed beside a caller's parameter annotated with a closed function type and
// beside a forwarded hole is built once per binding: the closure at the annotated caller, the
// set's id at the forwarding one, whichever comes first.
function add(a, b) { return a + b }
function apply2(g, s) { print(g(s, s)) }
function apply4(g, s) { print(g(s, 2)) }
function apply5(g, s) { print(g(3, s)) }
function annotated(k: f64, h: (a: f64, b: f64) => f64) {
  for f in [apply2, apply4] { f(h, k) }
}
annotated(0.5, add)
function forwarded(k, h) {
  for f in [apply4, apply5] { f(h, k) }
}
forwarded(0.5, add)

function mul(a, b) { return a * b }
function bApply4(g, s) { print(g(s, 2)) }
function bForwarded(k, h) {
  const gs = [bApply4]
  for f in gs { f(h, k) }
}
function bAnnotated(k: f64, h: (a: f64, b: f64) => f64) {
  for f in [bApply4] { f(h, k) }
}
bForwarded(1.5, mul)
bAnnotated(1.5, (a: f64, b: f64) => a - b)
bAnnotated(2.5, mul)
