// @run

// D2325 — a closure-typed PARAMETER shadowed by a block-local `const` whose return kind
// DIFFERS from the param's, cycling every pairing over i32/f64/string/struct/list so no
// (param kind, shadow kind) pair is untested.

type Pt = { x: i32, y: i32 }

function fA(g: () => i32) {
  let out = "\{g()}"
  {
    const g = () => 2.5
    out = out + "|" + "\{g()}"
  }
  out
}
print(fA(() => 1))
// @log 1|2.5

function fB(g: () => f64) {
  let out = "\{g()}"
  {
    const g = () => "shadow"
    out = out + "|" + g()
  }
  out
}
print(fB(() => 1.5))
// @log 1.5|shadow

function fC(g: () => string) {
  let out = g()
  {
    const g = () => { x: 4, y: 5 }
    const p = g()
    out = out + "|" + "\{p.x},\{p.y}"
  }
  out
}
print(fC(() => "outer"))
// @log outer|4,5

function fD(g: () => Pt) {
  let out = "\{g().x},\{g().y}"
  {
    const g = () => [1, 2, 3]
    const xs = g()
    out = out + "|" + "\{xs[0]}\{xs[1]}\{xs[2]}"
  }
  out
}
print(fD(() => ({ x: 6, y: 7 })))
// @log 6,7|123

function fE(g: () => i32[]) {
  const xs0 = g()
  let out = "\{xs0[0]}\{xs0[1]}"
  {
    const g = () => 42
    out = out + "|" + "\{g()}"
  }
  out
}
print(fE(() => [8, 9]))
// @log 89|42
