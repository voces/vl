// @error cannot assign (T) => void to `k`: it keeps the generic type of its initializer
// A generic passed from a shared closure to a closure's T-typed parameter has no instance (review of #3498, `rv3498/d04_nested_closure_param_called_from_shared_closure_i32_bool`).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function third<Z>(z: Z) { print("T"); print(z) }
function a<T>(x: T) {
  let k = inner
  const w = (g: (t: T) => void) => {
    k = g
  }
  const w2 = () => {
    w(other)
  }
  k(x)
  w2()
  k(x)
}
a(1)
a(true)
