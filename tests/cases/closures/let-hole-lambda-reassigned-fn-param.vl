// @run
// @log -3
// @log -4
// @log -3
// @log -4
// @log a!
// @log -3
// @log -3
// @log 9
// @log -2
// D5841: a `let` bound to a lambda whose function parameter is un-annotated, then reassigned
// another such lambda, is called at the function it is handed: a generic, a typed function, two
// call types, a write in a branch or in a function, and a lambda argument.
function neg(a) { return 0 - a }
function negT(a: i32) { return 0 - a }
function up(s: string) { return s + "!" }
function dbl(a) { return a * 2 }
let lap = (g, x) => g(x)
lap = (g, x) => g(x) + 1
print(lap(neg, 4))
let l2 = (g, x) => g(x)
print(l2(negT, 4))
l2 = (g, x) => g(x) + 1
print(l2(negT, 4))
let l3 = (g, x) => g(x)
l3 = (g, x) => g(x)
print(l3(negT, 4))
print(l3(up, "a"))
let l4 = (g, x) => g(x)
if negT(1) < 0 { l4 = (g, x) => g(x) + 1 }
print(l4(negT, 4))
let l5 = (g, x) => g(x)
function setIt() { l5 = (g, x) => g(x) + 1 }
setIt()
print(l5(neg, 4))
let l6 = (g, x) => g(x)
l6 = (g, x) => g(x) + 1
print(l6(dbl, 4))
let l7 = (g, x) => g(x)
l7 = (g, x) => g(x) + 2
l7 = (g, x) => g(x) + 3
print(l7(neg, 5))
