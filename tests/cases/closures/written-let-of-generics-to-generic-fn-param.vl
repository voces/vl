// @run
// @log 3
// @log idg
// @log 3
// @log kg
// @log 4
// @log 1
// @log 3
// @log 1
// @log 9
// @log 7
// @log 5
// A re-pointed `let` holding generics, handed to a generic's arrow parameter, runs whichever
// function it holds at run time, each instanced at the parameter's type (D9001).
function idg<T>(t: T): T { return t }
function kg<T>(t: T): T { return t }
function app<T>(g: (x: T) => T, v: T): T { return g(v) }
let f = idg
f = kg
print(app(f, 3))
function idm<T>(t: T): T { print("idg"); return t }
function km<T>(t: T): T { print("kg"); return t }
let h = idm
print(app(h, 3))
h = km
print(app(h, 4))
function fst<T>(xs: T[]): T { return xs[0] }
function lst<T>(xs: T[]): T { return xs[xs.length - 1] }
function appL<T>(g: (x: T[]) => T, v: T[]): T { return g(v) }
let p = fst
print(appL(p, [1, 2, 3]))
if [1].length > 0 { p = lst }
print(appL(p, [1, 2, 3]))
let q = fst
if [1].length > 5 { q = lst }
print(appL(q, [1, 2, 3]))
function pick(b: boolean) {
  let r = fst
  if b { r = lst }
  return appL(r, [7, 8, 9])
}
print(pick(true))
print(pick(false))
function appV<T>(v: T[], g: (x: T[]) => T): T { return g(v) }
let s = fst
if [1].length > 0 { s = lst }
print(appV([3, 5], s))
