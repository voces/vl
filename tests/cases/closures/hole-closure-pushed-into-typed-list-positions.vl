// @run
// @log aC
// @log uaC
// @log [aC]
// @log saC
// @log i=aC
// @log aC
// @log aC
// @log aC
// @log aC
// Q58 position sweep: a module hole closure pushed into a local list of closures of a closed
// signature, retagged at the list's element, then read and called as a scalar and a union call
// argument, a nested call argument, a concat operand, an interpolation hole, a let
// initializer, an if arm, a `??` operand and a record field.
const c = (y) => y + "C"
function takeS(s: string) { print(s) }
function takeU(s: string | i32) {
  if s is string { print("u" + s) } else { print(s) }
}
function wrap(s: string) { return "[" + s + "]" }
function maybe(k: i32): string | null { return if k > 0 { "m" } else { null } }
function m(x: string) {
  const fs: ((y: string) => string)[] = []
  fs.push(c)
  takeS(fs[0](x))
  takeU(fs[0](x))
  takeS(wrap(fs[0](x)))
  print("s" + fs[0](x))
  print("i=\{fs[0](x)}")
  const l = fs[0](x)
  print(l)
  print(if x == "a" { fs[0](x) } else { "no" })
  print(maybe(0) ?? fs[0](x))
  const r = { v: fs[0](x) }
  print(r.v)
}
m("a")
