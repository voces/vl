// @run
// @log 1
// @log z
// @log 2
// @log y
// @log 3
// @log x
// @log 4
// @log w
// A block-local maker returning a generic function, inside a body called at two types, runs
// (D6322): at the body's top, inside a nested block, in return position and in a hole function.
function k<T>(x: T): T { return x }
function g<U>(u: U) {
  function mk() { return k }
  const a = mk()
  print(a(u))
}
g(1)
g("z")
function g2<U>(u: U) {
  if true {
    function mk() { return k }
    const a = mk()
    print(a(u))
  }
}
g2(2)
g2("y")
function g3<U>(u: U): U {
  function mk() { return k }
  const a = mk()
  return a(u)
}
print(g3(3))
print(g3("x"))
function g4(u) {
  function mk() { return k }
  const a = mk()
  print(a(u))
}
g4(4)
g4("w")
