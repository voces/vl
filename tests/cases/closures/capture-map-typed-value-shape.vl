// @run
// @log 1
// @log 2
// @log 0
// @log 1
// @log 2
// @log 3
// MASTER'S FAILURE MODE FOR THIS FILE IS "THE COMPILER DIED" — worth stating, because it is
// not the usual shape of a red fixture. On master `vl build`/`vl run` on this file exits 1
// having printed a wasm backtrace through `vl-compiler.wasm` and `wasm trap: out of bounds
// array access`; `vl check` says "no errors". No diagnostic, no source location, and NO MODULE
// IS WRITTEN, so there is no output at all for a `@log` to disagree with. This file pins that
// a value exists to read.
//
// A MAP CAPTURED BY A CLOSURE, where the map's VALUE type has its own `$mapStruct`.
// `captureValStructIdx` is the `fbValtype` COMPANION slot and is polymorphic in the capture's
// kind — for a map capture it is the value type's `mv` SHAPE slot, not a struct-table row —
// and `capturedStructIndex` handed it back as a struct index, so `sFieldIndex` indexed
// `sFieldStart` past its end. A MONO map value (`i32` / `boolean`) answers `-1` / `-4` and was
// declined by the existing `si < 0` arm, which is why the axis reads as the map's VALUE type
// and not its key: the KEY is flat, both spellings trapped.
//
// The legs, each independently load-bearing:
//   L1 a captured `{[string]: string}` PARAM — the kind gate in `capturedStructIndex`.
//   L2 the same capture's map SHAPE at the read (`mapShapeOfExpr`'s `Param` arm). Covering
//      only `LetDecl` there left the read on the mono `$mapStruct` while the env field carried
//      the typed one: `(ref $mapStruct)` stored, `(ref null $mapStruct)` expected —
//      check-clean INVALID WASM. L2 is what the `m[k]` value read below exercises.
//   L3 a captured `{[string]: i32}` MONO control, which must stay correct.
//   L4 a captured map LOCAL (`LetDecl`), the other binding form.
//   L5 an UNCAPTURED read of the same map type, the control that was always correct.

function mkS(): {[string]: string} {
  const m: {[string]: string} = Map()
  m["a"] = "xyz"
  m["b"] = "pq"
  return m
}

function mkI(): {[string]: i32} {
  const m: {[string]: i32} = Map()
  m["a"] = 41
  return m
}

// L1 + L2: the captured map is a PARAM, and the nested function reads both its size and a
// VALUE out of it (the value read is what needs the shape to agree with the env field).
function bodyStr(m: {[string]: string}) {
  function innerStr() {
    print(m.size - 1)
    const v = m["a"] ?? "z"
    print(v.length - 1)
  }
  innerStr()
}

// L3: a mono-valued map through the same capture route.
function bodyI32(m: {[string]: i32}) {
  const g = () => {
    print(m.size - 1)
    0
  }
  g()
}

// L4: the captured map is a LOCAL of the enclosing frame.
function bodyLocal() {
  const m: {[string]: string} = Map()
  m["k"] = "v"
  function innerLocal() { print(m.size) }
  innerLocal()
}

// L5: no capture at all.
function bodyPlain(m: {[string]: string}) { print(m.size) }

bodyStr(mkS())
bodyI32(mkI())
bodyLocal()
bodyPlain(mkS())
print(mkS().size + 1)
