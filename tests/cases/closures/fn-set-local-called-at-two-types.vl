// @run
// @log 4
// @log 2.5
// @log 6
// @log 3
// A function-local binding of a function set dispatches on the member each call chose.
function inc(a) { return a + 1 }
function dbl(a) { return a * 2 }
function sel(c: boolean) {
  if c { return inc }
  return dbl
}
function run(c: boolean, x: i32) {
  const f = sel(c)
  print(f(x))
  print(f(1.5))
}
run(true, 3)
run(false, 3)
