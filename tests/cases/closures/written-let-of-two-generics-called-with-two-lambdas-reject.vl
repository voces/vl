// @emit-error the reassigned function binding `v` is called at more than one argument type
// A written `let` called with two callbacks takes the generic's own instance per call only while
// every write names that one generic (D9853); writing a second leaves one binding for both.
function g<T>(f: (x: T) => T, x: T): T { f(x) }
function h<T>(f: (x: T) => T, x: T): T {
  print("h")
  f(x)
}
function la(n: i32) {
  let v = g
  if n > 0 { v = h }
  print(v((x: i32) => x + 1, 2) * 10 + v((x: i32) => x, 5))
}
la(0)
la(1)
