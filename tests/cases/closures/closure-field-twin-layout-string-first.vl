// @run
// @log ok
// @log 7
// D987 — TWO CLOSURE FIELDS OF THE SAME LAYOUT, string literal declared FIRST.
//
// `{f: () => string}` and `{f: () => i32}` collapse to the same struct row, so
// `fieldClosureFeOf` — which scans nodes for an ObjLit with a matching struct index —
// returned the FIRST one's `fe` regardless of which receiver the call actually had. Right
// exactly when declaration order happened to match; a trap otherwise. Two of the four
// order/receiver combinations ran and two did not, so the two orders are pinned in two files.
//
// REFUSING WHEN THE SCAN IS AMBIGUOUS WOULD HAVE BEEN A REGRESSION: two of those four cells
// already ran, and a refusal turns them into `runs -> not-runs`. The fix disambiguates — for
// a receiver that is a hole PARAM, resolve the call-site ARGUMENT and read the field off the
// object literal that actually arrives.
//
// ONE receiver shape per hole function, deliberately: calling ONE hole function with two
// different receiver shapes resolves per-FUNCTION, not per-call, and is still open (D988).
const sFirst = { f: () => "ok" }

const bSecond = { f: () => 7 }

function holeStr(z) { print(z.f()) }

function holeNum(z) { print(z.f()) }

holeStr(sFirst)

holeNum(bSecond)
