// @hint Intentionally-unused parameter `_n` (leading `_` marks it unused)
// @hint redundant type annotation: `ap` is inferred as `i32`
// @run
// @log 6
// @log 6
// @log 6
// @log 1
// @log 6
// @log 8
// @log 4
// @log 3.5
// @log 4
// @log 3.5
// @log 4
// @log 3.5
// @log 4
// @log 3.5
// @log 6
// @log 4
// @log 3.5
// @log 4
// @log 3.5
// @log 1
// @log z
// @log w
// A list literal of un-annotated functions that no annotation names takes its element type
// where that type is decided: the callback of an inline `.map` receiver, a declared callback
// reached through an un-annotated parameter, each call of a returned local, and each row read
// of a loop over a nested list (D9863, D9861, D9763, D9760).
function inc(a) { return a + 1 }
print([inc].map((r) => r(5))[0])

function inc2(a) { return a + 1 }
function ap(r: (a: i32) => i32): i32 { return r(5) }
print([inc2].map(ap)[0])

function inc3(a) { return a + 1 }
function apU(r) { return r(5) }
print([inc3].map(apU)[0])

function inc4(a) { return a + 1 }
function pos(r) { return r(5) > 0 }
print([inc4].filter(pos).length)

function inc5(a) { return a + 1 }
function run(xs) { return xs.map(ap) }
print(run([inc5])[0])

function inc6(a) { return a + 1 }
function keep(xs) { return xs.filter(pos) }
print(keep([inc6])[0](7))

function inc7(a) { return a + 1 }
function deliver(_n) {
  const u = [inc7]
  return u
}
const w = deliver("s")
print(w[0](3))
print(w[0](2.5))

function inc8(a) { return a + 1 }
function deliver2() {
  const u = [inc8]
  u.push(inc8)
  return u
}
const w2 = deliver2()
print(w2[1](3))
print(w2[0](2.5))

function inc9(a) { return a + 1 }
const rows = [[inc9]]
for r in rows { print(r[0](3)) }
print(rows[0][0](2.5))

function incA(a) { return a + 1 }
const rows2 = [[incA]]
for r in rows2 {
  for f in r { print(f(3)) }
}
print(rows2[0][0](2.5))

// Controls: the same lists bound to a name, returned inline, and flat in the loop.
function incB(a) { return a + 1 }
const vB = [incB]
print(vB.map(ap)[0])
function incC(a) { return a + 1 }
function deliver3(_n) { return [incC] }
print(deliver3("s")[0](3))
print(deliver3(1)[0](2.5))
function incD(a) { return a + 1 }
const flat = [incD]
for f in flat { print(f(3)) }
print(flat[0](2.5))

// Control: a module record returned whole keeps its own field-slot plan (D6700).
function kE<T>(x: T): T { return x }
function mkE() { return kE }
const rE = { f: mkE(), g: 7 }
function getE() { return rE }
print(rE.f(1))
print(rE.f("z"))
print(getE().f("w"))
