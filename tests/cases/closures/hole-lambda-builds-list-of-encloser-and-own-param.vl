// @run
// @log 2
// @log 2
// @log 2
// @log 2
// A hole lambda calls a nested generic that builds a list of its encloser's parameter and its
// own, inside a generic instanced at two types, so each instance's list is its own element union
// (D15014's neighbour): a frame-less instance typed at another encloser's `T` builds invalid wasm.
function valued<T>(x: T) {
  function wrap<U>(u: U) { return [x, u] }
  const g = (v) => wrap(v).length
  print(g(1))
  print(g("a"))
}
valued(1)
valued("s")
