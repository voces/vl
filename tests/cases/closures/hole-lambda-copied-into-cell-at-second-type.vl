// @run
// @log aa
// @log 4
// @log aa
// @log 4
// @log 4
// @log 8
// @hint redundant type annotation: `w8` is inferred as `i32` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// A hole lambda called at one type and copied through written lets into a binding called at
// another gets a second instance, whether the last copy is a capture cell's store or a direct
// write (D4842). The mutate-then-read tail proves the cell holds what the last write put there.
function chain(x: string, n: i32) {
  const c = (y) => y + y
  const g = (y) => y
  print(c(x))
  let d2 = c
  d2 = g
  let d5 = c
  d5 = d2
  let d3 = g
  function w8(): i32 { d3 = d5; 0 }
  w8()
  print(d3(n))
}
chain("a", 4)
function direct(x: string, n: i32) {
  const c = (y) => y + y
  const g = (y) => y
  print(c(x))
  let d2 = c
  d2 = g
  let d5 = c
  d5 = d2
  let d3 = g
  d3 = d5
  print(d3(n))
}
direct("a", 4)
function mutated(n: i32) {
  const c = (y) => y + y
  const g = (y) => y
  let d3 = g
  let d5 = g
  function w8(): i32 { d3 = d5; 0 }
  w8()
  print(d3(n))
  d5 = c
  w8()
  print(d3(n))
}
mutated(4)
