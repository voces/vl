// @error a call through `fs[_]` passes i32 to a function written there that takes `string` (the call's argument types)
// An un-annotated function's call through an element is judged at each call's argument types,
// as a generic body's is (D12238).
function pick<A, B>(a: A, b: B): A { a }
const fs = [pick]
fs[0] = (x, y: string) => x
function g(v) { fs[0](v, v) }
print(g(1))
