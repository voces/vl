// @run
// @log 1
// @log 2.5
// @log 1
// @log 2.5
// @log 1
// @log 2.5
// @log 0
// @log 1
// @log 2.5
// @log 3.5
// @log 3
// @log 3.5
// @log 4.5
// A forwarded hole called through a `const`-bound list, whose elements call it at different
// keys, takes the same split as the list written in the `for` header (D13320).
function add(a, b) { return a + b }
function apply2(g, s) { print(g(s, s)) }
function apply4(g, s) { print(g(s, 2)) }
function innerThree(k, h) {
  const gs = [apply2, apply4]
  for f in gs { f(h, k) }
}
innerThree(0.5, add)
// The list bound at the top level.
const top = [apply2, apply4]
function viaTop(k, h) {
  for f in top { f(h, k) }
}
viaTop(0.5, add)
// The function's result delivered to a binding.
function withResult(k, h) {
  const gs = [apply2, apply4]
  for f in gs { f(h, k) }
  return 0
}
const r = withResult(0.5, add)
print(r)
// Three elements at three keys, called from two frames.
function sq(g, s) { print(g(s, s)) }
function right(g, s) { print(g(s, 2)) }
function left(g, s) { print(g(3, s)) }
function three(k, h) {
  const gs = [sq, right, left]
  for f in gs { f(h, k) }
}
three(0.5, add)
three(1.5, add)
