// @run
// @log 4
// @log 1.5
// @log 5.5
// @log 1.5
// @log 1.5
// @log 7.5
// @log 1.5
// A returned list whose elements hold records nested in them, whose function field holds
// un-annotated functions returning different types: a call through the field runs the member
// stored there. Each return, three levels deep, bound, walked, a mixed record, and a maker binding
// the record it returns (D15805).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function two() { [1, 2].length }
function pick(b: boolean) {
  if b { return [{ r: { f: inc0 } }] }
  return [{ r: { f: half } }]
}
print(pick(true)[0].r.f(3))
print(pick(false)[0].r.f(3))
function deep(b: boolean) {
  if b { return [{ r: { s: { f: inc0 } } }] }
  return [{ r: { s: { f: half } } }]
}
print(deep(two() > 5)[0].r.s.f(3) + deep(two() > 1)[0].r.s.f(3))
const l = pick(two() > 5)
print(l[0].r.f(3))
let acc = 0.0
for e in pick(two() > 5) { acc = acc + e.r.f(3) }
print(acc)
function mixed(b: boolean) {
  if b { return [{ n: 1, r: { f: inc0, g: half } }] }
  return [{ n: 2, r: { f: half, g: inc0 } }]
}
print(
  mixed(two() > 5)[0].r.f(3) + mixed(two() > 5)[0].r.g(3) + mixed(two() > 5)[0].n,
)
function viaBound(b: boolean) {
  const r0 = { f: half }
  if b { return [{ r: { f: inc0 } }] }
  return [{ r: r0 }]
}
print(viaBound(two() > 5)[0].r.f(3))
