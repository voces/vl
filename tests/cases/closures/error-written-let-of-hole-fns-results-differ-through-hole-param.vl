// @error cannot write 'half' to 'f': called at (i32) it returns f64, where 'inc0', also written to it, returns i32
// A re-pointed `let` handed to an un-annotated parameter runs either function where the
// parameter is called, so a write whose body gives another result there is refused (D9007).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function w(h) { return h(3) }
let f = inc0
f = half
print(w(f))
