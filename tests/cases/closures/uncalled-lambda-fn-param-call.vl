// @run
// @log 1
// @log 2
// @log 3
// @log 4
// @log 5
// @log 6
// @log 7
// @log 8
// @log 9
// @log 10
// @log 11

// @warning Unused variable `apply1` (prefix with `_` to suppress, or remove it)
// @warning Unused variable `apply2` (prefix with `_` to suppress, or remove it)
// @warning Unused variable `apply3` (prefix with `_` to suppress, or remove it)
// @warning Unused variable `apply4` (prefix with `_` to suppress, or remove it)
// @warning Unused variable `holder` (prefix with `_` to suppress, or remove it)
// @warning Unused variable `bag` (prefix with `_` to suppress, or remove it)
// @warning Unused variable `apply8` (prefix with `_` to suppress, or remove it)
// @warning Unused variable `apply9` (prefix with `_` to suppress, or remove it)
// @warning Unused variable `apply10` (prefix with `_` to suppress, or remove it)
// @warning Unused variable `apply11` (prefix with `_` to suppress, or remove it)
// @warning Unused function `mkApply` (prefix with `_` to suppress, remove it, or `export` it)

// D1474 — a lambda whose body CALLS a function-typed parameter, with nothing else in the
// module calling that arity. `cloSigWalkRoots` carries a declaration's parameter and result
// annotations, so a `function` whose parameter is function-typed interned that parameter's
// `$fnsig`; a lambda is an expression and its parameters reached no root, so the value call
// had no signature to dispatch through and the emitter refused.

// Every cell prints a different number, so a call dispatched through a neighbouring
// signature is a wrong value rather than a pass. Each lambda below is UNCALLED — calling one
// mints the sig from the call site and is a different program.

// The witness: a module-scope binding.
const apply1 = (f: (i32) => i32) => f(1)
print(1)

// The same lambda inside a function body, and inside each module-level block, since the
// refusal was about what the MODULE contains and not about where the lambda sits.
function inFnBody() {
  const apply2 = (f: (i32) => i32) => f(2)
  print(2)
}
inFnBody()

if true {
  const apply3 = (f: (i32) => i32) => f(3)
  print(3)
}

let w = 0
while w < 1 {
  const apply4 = (f: (i32) => i32) => f(4)
  print(4)
  w = w + 1
}

// A lambda in a position that is not a binding at all: an object field, a list element, and
// the result of a function. None of these is a `LetDecl`, so a fix at the binding alone
// leaves all three refusing.
const holder = { ap: (f: (i32) => i32) => f(5) }
print(5)

const bag = [(f: (i32) => i32) => f(6)]
print(6)

function mkApply() { return (f: (i32) => i32) => f(7) }
print(7)

// A lambda nested inside another lambda's body — the inner one is reached by no statement
// walk of the outer.
const outer = () => {
  const apply8 = (f: (i32) => i32) => f(8)
  return 8
}
print(outer())

// The parameter's own shape, one cell each: arity 0, arity 2, and a non-i32 parameter type.
// The interned key is per signature, so each is its own `$fnsig`.
const apply9 = (f: () => i32) => f()
print(9)

const apply10 = (f: (i32, i32) => i32) => f(1, 2)
print(10)

const apply11 = (f: (f64) => f64) => f(1.0)
print(11)
