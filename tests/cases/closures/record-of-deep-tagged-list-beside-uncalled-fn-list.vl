// @run
// @log 4
// @log 4
// @log 4
// A record holding a list three or more deep of un-annotated functions beside a list of an
// uncalled one is built with the deep list at its own id rep.
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function half(a) { return a / 2.0 }
const s = { f: [[[inc0]]], g: [dbl] }
print(s.f[0][0][0](3))
const u = { f: [[[inc0, half]]], g: [dbl] }
print(u.f[0][0][0](3))
function m() {
  const t = { f: [[[[inc0]]]], g: [[dbl]] }
  print(t.f[0][0][0][0](3))
}
m()
