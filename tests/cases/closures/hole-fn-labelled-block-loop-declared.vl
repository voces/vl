// @run
// @log a!
// @log b?
// @log a!
// @log a?
// @log a!
// @log b#
// @log c?
// D12841: a labelled block left by a `break` inside a loop hands over a hole function declared
// inside that loop, as a binding, from a function body, and as a returned value.
const xs = [1, 2, 3]
function ask(s) { return s + "?" }
const x = @B {
  for v in xs {
    function inner(s) { return s + "!" }
    if v == 2 { break @B inner }
  }
  ask
}
print(x("a"))
const y = @B {
  for v in xs {
    function inner(s) { return s + "!" }
    if v == 9 { break @B inner }
  }
  ask
}
print(y("b"))

function run(ns: i32[], t: i32) {
  function ask2(s) { return s + "?" }
  const z = @B {
    for v in ns {
      function inner(s) { return s + "!" }
      if v == t { break @B inner }
    }
    ask2
  }
  print(z("a"))
}
run([1, 2, 3], 2)
run([1, 2, 3], 5)

function pick(t: i32) {
  return @B {
    for v in xs {
      function inner(s) { return s + "!" }
      function other(s) { return s + "#" }
      if v == t { break @B inner }
      if v == t + 10 { break @B other }
    }
    ask
  }
}
print(pick(2)("a"))
print(pick(-8)("b"))
print(pick(9)("c"))
