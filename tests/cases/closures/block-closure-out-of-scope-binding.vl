// @run
// @hint redundant type annotation: `w` is inferred as `f64` — remove it to lean on inference
// @log 3
// @log 0.75
// A closed block's closure `w` does not type a later call of the top-level `w` it cannot see: the
// call's f64 result binds and divides as f64 (D2384's scalar neighbour; D2384 keeps the string arm).

function w(): f64 { return 1.5 }

function blk(c: boolean) {
  if c {
    const w = () => {
      return 3
    }
    print(w())
  }
  const r = w()
  print(r / 2.0)
}

blk(true)
