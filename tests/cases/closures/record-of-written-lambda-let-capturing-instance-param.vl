// @run
// @log B
// @log 2
// @log 1
// @log B
// @log b
// @log a
// The same record whose lambdas capture a parameter of the enclosing instance: each instance's slot reads its own capture.
function inC<T>(x: T, y: T) {
  let k = (n) => {
    print("A")
    print(n)
    print(y)
  }
  k = (n) => {
    print("B")
    print(y)
    print(n)
  }
  const o = { f: k }
  o.f(x)
}
inC(1, 2)
inC("a", "b")
