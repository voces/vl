// @run
// @log I
// @log 1
// @log I
// @log s
// @log O
// @log t
// @log O
// @log 2
// A capture cell in a generic body runs when one instance calling another wants it at two function
// types: each call has its own cell, holding the set's id (D3939, `rv3498/u17`).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function run<T>(x: T, y: T, again: boolean) {
  let k = inner
  const flip = () => {
    k = other
  }
  k(x)
  if again { run("s", "t", false) }
  flip()
  k(y)
}
run(1, 2, true)
