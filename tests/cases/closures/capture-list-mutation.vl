// @run
// A closure that MUTATES a list captured from an enclosing function's local (D1965). A list is a
// reference value, so the env field holds the maker's own wrapper: `.push`/`.pop`/`.clear` staged
// through it grow the SAME list, and every read below is taken in the maker, after the call.
type P = { x: i32 }

function bytesOf(s: string): u8[] {
  const out: u8[] = []
  const put = (t: string) => {
    const b = t.bytes()
    for i in 0 until b.length { out.push(b[i]) }
  }
  put(s)
  out
}

function takeOwn(out: i32[]) {
  const add = () => {
    out.push(30)
  }
  add()
}

function makePusher(out: string[]): (string) => void {
  (s: string) => {
    out.push(s)
  }
}

function go() {
  // the filed witness: a u8 list built by a closure over `s.bytes()`.
  const bs = bytesOf("hi")
  print(bs.length)
  // @log 2
  print(bs[1])
  // @log 105

  // push / pop / clear / index-assign on a captured i32 list, seen by the maker.
  const xs: i32[] = []
  const push = (v: i32) => {
    xs.push(v)
  }
  push(10)
  push(20)
  takeOwn(xs)
  print(xs.length)
  // @log 3
  print(xs[2])
  // @log 30
  const pop = () => {
    xs.pop()
  }
  pop()
  pop()
  print(xs.length)
  // @log 1
  const clr = () => {
    xs.clear()
  }
  clr()
  print(xs.length)
  // @log 0
  // growth past the initial backing, twice over.
  const many = () => {
    for i in 0 until 9 { xs.push(i) }
  }
  many()
  print(xs.length)
  // @log 9
  const setAt = () => {
    xs[0] = 2
  }
  setAt()
  print(xs[0])
  // @log 2

  // a string list, two levels of closure deep, and through an escaping closure.
  const ss: string[] = []
  const outer = () => {
    const inner = () => {
      ss.push("c")
    }
    inner()
  }
  outer()
  const pushS = makePusher(ss)
  pushS("d")
  print(ss[0])
  // @log c
  print(ss.length)
  // @log 2

  // a struct list, from a named nested function.
  const ps: P[] = []
  function addP(v: i32) { ps.push({ x: v }) }
  addP(7)
  addP(3)
  print(ps[0].x)
  // @log 7
  print(ps[1].x + ps.length - 2)
  // @log 3

  // an f64 list and a nullable list narrowed inside the closure.
  const fs = [1.5]
  const addF = () => {
    fs.push(2.5)
  }
  addF()
  print(fs[1])
  // @log 2.5
  const ns: i32[] | null = [1]
  const addN = () => {
    if ns != null { ns.push(8) }
  }
  addN()
  if ns != null {
    print(ns.length)
    // @log 2
    print(ns[1])
    // @log 8
  }

  // two closures sharing one captured list.
  const log: i32[] = []
  const a = () => {
    log.push(1)
  }
  const b = () => {
    log.push(2)
  }
  a()
  b()
  a()
  print(log.length)
  // @log 3
  print(log[0] + log[1] + log[2])
  // @log 4
}

go()
