// @run
// @log s
// @log 5
// @log 6
// @log 7
// @log 8
// A `const` copy of a parameter holding a written binding of generics, pushed or set into a
// holder of a closed function type, keeps the set a closure as the parameter itself does (D15130).
function id<T>(x: T): T { return x }
function k<T>(x: T): T { return x }
function pushCopy(a) {
  const v = a
  const ys: ((x: i32) => i32)[] = []
  ys.push(v)
  print(ys[0](5))
}
function pushCopyOfCopy(a) {
  const v = a
  const w = v
  const ys: ((x: i32) => i32)[] = []
  ys.push(w)
  print(ys[0](6))
}
function pushCopyInBlock(a) {
  const v = a
  const ys: ((x: i32) => i32)[] = []
  if true { ys.push(v) }
  print(ys[0](7))
}
function setCopy(a) {
  const v = a
  const m: Map<i32, (x: i32) => i32> = Map()
  m.set(1, v)
  const g = m.get(1)
  if g != null { print(g(8)) }
}
let f = id
f = k
print(f("s"))
pushCopy(f)
pushCopyOfCopy(f)
pushCopyInBlock(f)
setCopy(f)
