// @run
// @log abcabc
// @log 3
// @log xyzxyz
// @log 3
// A bound list of un-annotated functions whose results differ runs as its inline literal does:
// each call through an element fixes its own member's tuple (D14435).
function twice(s) { return s + s }
function lenOf(s) { return s.length }
const fs = [twice, lenOf]
for g in fs { print(g("abc")) }
function run(i: i32) { print(fs[i]("xyz")) }
run(0)
run(1)
