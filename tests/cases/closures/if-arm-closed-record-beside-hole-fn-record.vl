// @run
// @log 3
// @log 2
// @log 3
// @log 3
// @log 3
// @log 3
// @log 2
// @log 3
// @log q
// A value `if` whose one arm is a record or list literal holding an annotated function and
// whose other holds an un-annotated one takes the closed arm's type at both: handed to an
// un-annotated parameter, bound to a `const`, listed, and in an `else if` chain (D15331).
function id1(a) { return a }
function inc(x: i32) { return x + 1 }
function cat(s: string) { return s + "!" }
const c = 1 > 0
function g(r) { return r.f(2) }
function gs(r) { return r.f("q") }
function h(xs) { return xs[0](2) }
print(g(if c { { f: inc } } else { { f: id1 } }))
print(g(if c { { f: id1 } } else { { f: inc } }))
const r = if c { { f: inc } } else { { f: id1 } }
print(r.f(2))
print([if c { { f: inc } } else { { f: id1 } }][0].f(2))
print(g(if c { { f: inc, n: 1 } } else { { f: id1, n: 2 } }))
print(h(if c { [inc] } else { [id1] }))
function pick(n: i32) {
  return if n > 1 { { f: inc } } else if n > 0 { { f: id1 } } else { { f: inc } }
}
print(g(pick(1)))
print(g(pick(5)))
print(gs(if !c { { f: cat } } else { { f: id1 } }))
