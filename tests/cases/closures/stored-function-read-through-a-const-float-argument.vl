// @run
// @log 4
// @hint redundant type annotation: `dbl` is inferred as `f64` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// The read through a `const` in a hole parameter, called at the stored signature's own type
// (D17817's neighbour).
function dbl(a: f64): f64 { return a * 2.0 }
const g = (a) => a + 1
const xs = [g, dbl]
function walk(ys) { const v = ys[0]; print(v(3.0)) }
walk(xs)
