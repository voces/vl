// @run
// @log 1.5
// @log 0.75
// @log 4
// @log 1.5
// @log 1.5
// Records holding un-annotated functions whose results the field type accepts run when set,
// pushed or nested into an annotated container (D9471's control).
type R = { f: (a: i32) => f64 }
type W = { r: R }
function half(a) { return a / 2.0 }
const m: Map<string, R> = Map()
m.set("a", { f: half })
const x = m.get("a")
if x != null { print(x.f(3)) }
const l: R[] = []
l.push({ f: (a) => a / 4.0 })
l.push({ f: (a) => a + 1 })
print(l[0].f(3))
print(l[1].f(3))
const w: W[] = []
w.push({ r: { f: half } })
print(w[0].r.f(3))
const ml: Map<string, R[]> = Map()
ml.set("a", [{ f: half }])
const y = ml.get("a")
if y != null { print(y[0].f(3)) }
