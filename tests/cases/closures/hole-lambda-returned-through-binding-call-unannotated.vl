// @run
// @log 42
// @log 42
// @log 9
// A hole lambda returned by a call through a binding (a `const` lambda, or an alias of a named
// function) into an un-annotated binding takes the one signature the binding is called at, as
// a call naming the function directly does (D16072).
const outer = () => {
  const l = (x) => x
  return l
}
const v = outer()
print(v(41) + 1)
function named() {
  const l = (x) => x
  return l
}
const alias = named
const w = alias()
print(w(41) + 1)
function inBody() {
  const u = outer()
  print(u(8) + 1)
}
inBody()
