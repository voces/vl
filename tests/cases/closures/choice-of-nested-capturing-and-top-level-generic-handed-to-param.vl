// @run
// @log 9
// @log a
// @log 9
// @log 1
// @log a
// @log 1
// @log t2
// @log a
// @log t2
// @log 1
// A choice between a capturing nested function and top-level generics, handed to a parameter
// called at two types, is one bundle: the nested member's set is never a tagged set's (D15450).
function both(f) {
  print(f("a"))
  print(f(1))
}
function top(s) { return s }
function top2(s) {
  print("t2")
  return s
}
function nested(c: i32, n: i32) {
  function inner(s) {
    print(n)
    return s
  }
  both(if c == 0 { inner } else if c == 1 { top } else { top2 })
}
nested(0, 9)
nested(1, 9)
nested(2, 9)
