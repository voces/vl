// @run
// @log 4
// @log 1.5
// A field of a list's records holding functions of different results, called through a `for`
// loop's element, runs each record's member, as a call through the element itself does (D15791).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const rs = [{ f: inc0 }, { f: half }]
for r in rs { print(r.f(3)) }
