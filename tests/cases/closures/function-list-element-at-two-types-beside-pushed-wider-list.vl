// D15060: a member pushed onto a wider list of functions is decided with that list's set, as
// its literal's elements are (D15036).
function inc0(a) { return a + 1 }
function dbl0(a) { return a * 2 }
function deliver0() { return [inc0] }
function deliver1() { return [inc0, dbl0] }
function take0(a) { print(a[0](3)) }
take0(deliver0())
print(deliver0()[0](1.25))
const fs = deliver1()
fs.push(inc0)
print(fs[2](5))
