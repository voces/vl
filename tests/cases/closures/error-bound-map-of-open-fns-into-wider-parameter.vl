// @error a `{[string]: (_) => _}` cannot be used as `{[string]: (i32) => f64}` here: a map is passed as the same storage
// A bound map of an un-annotated function is the parameter's own storage, so its function is not
// converted on the way to a wider result, as its closed-function twin is not (D16996).
function half(a) { return a + 2 }
function run(m: {[string]: (a: i32) => f64}) {
  const g = m.get("b")
  if g != null { print(g(3)) }
}
const m = Map()
m.set("b", half)
run(m)
