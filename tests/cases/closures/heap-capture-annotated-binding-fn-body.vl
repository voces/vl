// @run
// @log 8
// @hint Intentionally-unused variable `_dA` (leading `_` marks it unused)
// Neighbour: a capture bound at its row's annotated record inside the closure.
type J = { f: i32 | null }
function mk2() { return { f: null } }
const _dA: J = mk2()
function fr() {
  const __c = mk2()
  const __f = () => {
    const v: J = __c
    print(v.f ?? 8)
  }
  __f()
}
fr()
