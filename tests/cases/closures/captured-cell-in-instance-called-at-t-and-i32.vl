// @emit-error holds functions called at more than one argument type
// A capture cell in a generic body is refused, not built at one instance's type, when one instance calling its cell at `T` and at `i32`
// wants it at two function types (D3939, `rv3498/u11`).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function run<T>(x: T) {
  let k = inner
  const flip = () => {
    k = other
  }
  k(x)
  k(5)
}
run(1)
run("s")
