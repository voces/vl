// @run
// @warning Unused variable `flip` (prefix with `_` to suppress, or remove it)
// @log I
// @log 1
// @log I
// @log 5
// @log I
// @log s
// @log I
// @log 5
// A capture cell in a generic body, called at `T` and at `i32` in each instance, holds one
// closure per call type in every instance (D3939, D3975, `rv3498/u11`).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function run<T>(x: T) {
  let k = inner
  const flip = () => {
    k = other
  }
  k(x)
  k(5)
}
run(1)
run("s")
