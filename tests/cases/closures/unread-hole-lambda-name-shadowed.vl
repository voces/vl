// @run
// @log z
// @log z!
// @log p
// @log q
// @log y!
// @log inner
// @log w
// @log v
// @log u
// @log t!
// @log s?
// @log o
// @warning Unused variable `c`
// A top-level hole lambda nothing reads, whose name a nearer binding reuses: a parameter, a
// block's `const`, a loop variable, a lambda's parameter or a nested function. Each use reads
// that binding, so the lambda stays unread and is not lowered at its parameter's default (D3843).
const c = (y) => y + "C"
function param(c: string) { c }
print(param("z"))
function block(s: string) {
  if true {
    const c = s + "!"
    print(c)
  }
}
block("z")
function loop() {
  for c in ["p", "q"] { print(c) }
}
loop()
const lam = (c: string) => c + "!"
print(lam("y"))
function nested() {
  function c() { "inner" }
  c()
}
print(nested())
function aliased(c: string) {
  const d = c
  d
}
print(aliased("w"))
function listed(c: string) {
  const xs = [c]
  xs[0]
}
print(listed("v"))
function captured(c: string) {
  let r = c
  const g = () => {
    r = r + ""
  }
  g()
  r
}
print(captured("u"))
function written(c: string) {
  c = c + "!"
  c
}
print(written("t"))
function outer() {
  const c = (y) => y + "C"
  function inner(c: string) { c + "?" }
  print(inner("s"))
}
outer()
function shadowLet(s: string) {
  let c = s
  c = c + ""
  c
}
print(shadowLet("o"))
