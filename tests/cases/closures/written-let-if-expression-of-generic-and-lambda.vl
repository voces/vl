// @run
// @log I
// @log 4
// @log L
// @log 4
// @log O
// @log 5
// A `let` written with an `if` expression whose arms are a generic function and a concrete
// lambda takes the generic's instance at the lambda's signature, and a later write replaces it
// (D4307).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function main(c: boolean) {
  let f = other
  f = if c { inner } else { (n: i32) => {
    print("L"); print(n)
  } }
  f(4)
}
main(true)
main(false)
function rewrite(c: boolean) {
  let f = other
  f = if c { inner } else { (n: i32) => {
    print("L"); print(n)
  } }
  f = other
  f(5)
}
rewrite(false)
