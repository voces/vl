// @run
// @log true
// @log true
// @log cleared
// @log true
// @log true
// @log -1
// @log true
// @log true
// @log true
// @log true
// An assignment of `null` the checker types `null`, used as a value, stores the null: each cell
// is read back after the write, for a captured local of each null kind, a captured parameter, a
// module global written in a tail, and a deep `is` arm's tested place written in an expression.
type Json = null | boolean | f64 | string | Json[] | { [string]: Json }

function capI32() {
  let x: i32 | null = 1
  const clr = () => {
    return x = null
  }
  print(clr() == null)
  return x == null
}
print(capI32())

function capStr() {
  let v: string | null = "s"
  const clr = () => {
    return v = null
  }
  clr()
  return if v is string { v } else { "cleared" }
}
print(capStr())

function capList() {
  let v: i32[] | null = [1]
  const clr = () => {
    return v = null
  }
  clr()
  return v == null
}
print(capList())

function capBool() {
  let v: boolean | null = true
  const clr = () => {
    return v = null
  }
  clr()
  return v == null
}
print(capBool())

function capParam(x: i32 | null) {
  const clr = () => {
    return x = null
  }
  clr()
  return x ?? -1
}
print(capParam(7))

let xs: i32[] | null = [1, 2]
function clearXs() { return xs = null }
print(clearXs() == null)
print(xs == null)

let w: Json = ["a"]
print(w is string[] && (w = null) == null)
print(w == null)
