// @run
// @log 1
// @log 3
// @log 1
// @log 1
// @log 2
// @log 1
// @warning Field `c.r` is never read (remove it)
// A record nesting a record of an uncalled hole function's closure, bound and then stored into an
// un-annotated map, is laid out once at its declaration: stored at top level, beside a field read
// back, inside a function, three records deep, captured by a lambda in a block and in a function
// (D17755).
function inc0(a) { return a + 1 }
const m0 = Map()
const b0 = { r: { f: inc0 } }
m0["k"] = b0
print(m0.length)

function inc1(a) { return a + 1 }
const m1 = Map()
const b1 = { r: { f: inc1 }, n: 3 }
m1["k"] = b1
print(m1["k"]?.n)

function inc2(a) { return a + 1 }
function f2() {
  const m = Map()
  const b = { r: { f: inc2 } }
  m["k"] = b
  print(m.length)
}
f2()

function inc3(a) { return a + 1 }
const m3 = Map()
const b3 = { r: { r2: { f: inc3 } } }
m3["k"] = b3
print(m3.length)

function inc4(a) { return a + 1 }
{
  const c = { r: { f: inc4 }, n: 2 }
  const g = () => {
    print(c.n)
  }
  g()
}

function inc5(a) { return a + 1 }
function h5() {
  const c = { r: { f: inc5 }, n: 1 }
  const g = () => {
    const v = c
    print(v.n)
  }
  g()
}
h5()
