// @error cannot choose 'str' here: called at (i32) it returns string, where 'inc', also chosen here, returns i32
// A function whose returns join un-annotated functions is refused at the return when the
// members' results differ at the type its result is called at, as an `if` of them is (D13965).
function inc(a) { return a + 1 }
function str(_a) { return "s" }
function sel(c: boolean) {
  if c { return inc }
  return str
}
print(sel(false)(3))
