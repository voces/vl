// @run
// @log q
// @log q
// A list of a written `let` inside a function, called through its element and through the `let`
// at one string literal union, is instanced at it (D4246).
function idg<T>(t: T): T { return t }
type S = "p" | "q"
function main() {
  const a: S = "q"
  let x = idg
  x = idg
  const y = [x]
  const r2 = y[0](a)
  const r1 = x(a)
  print(r1)
  print(r2)
}
main()
