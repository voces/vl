// @run
// @log 3
// @log 1
// A module `let` seeded with one generic and reassigned to another, called through a function
// before and after the write, takes each written generic's instance at the call's type (D3979).
function addT<T>(a: T, b: T) { a + b }
function first<T>(a: T, b: T) { if b == b { a } else { a } }
function useK() { print(k(1, 2)) }
let k = addT
useK()
k = first
useK()
