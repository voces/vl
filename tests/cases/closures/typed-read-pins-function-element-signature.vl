// @run
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7.5
// @log 6
// A typed read of a list's function element pins the hole function's signature, as it pins a
// scalar's: an argument, a loop variable's argument and a `map` callback's annotated parameter.
// Two reads at different signatures pin nothing; the tagged set serves both (F2, coordinator ruling).
function inc2(a) { return a + 2 }
function ap(r: (a: i32) => i32) { return r(5) }
function apf(r: (a: f64) => f64) { return r(5.5) }
const v = [inc2]
print(ap(v[0]))
const w = [inc2]
for r in w { print(ap(r)) }
const v2 = [inc2]
print(v2.map((r: (a: i32) => i32) => r(5))[0])
const u = [inc2]
print(ap(u[0]))
print(apf(u[0]))
function id<T>(t: T): T { return t }
function useK(k: (a: i32) => i32 | string) { print(k(4)) }
const h = inc2
useK(id(h))
