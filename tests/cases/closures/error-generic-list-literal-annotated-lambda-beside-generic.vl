// @error cannot store a lambda in an element of 'fs': a call through it at (i32, i32) runs it, and it is (i32, string) => i32
// A list literal holding a generic and a lambda is called through as one function type, so a call
// the lambda cannot take is refused, as it is for a named function or a `const` lambda (D10120, D12217).
function pick<A, B>(a: A, _b: B): A { a }
const fs = [pick, (x: i32, _y: string) => x]
print(fs[0](1, 2))
