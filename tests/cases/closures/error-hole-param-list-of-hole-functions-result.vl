// @error cannot assign i32 to 's' of type boolean
// @error cannot assign i32 to 't' of type boolean
// The result of calling an element of a hole list bound to a list of un-annotated lambdas is that
// lambda's at the call's arguments, in place or through a copy of the element, so a wrong
// annotation on it is refused rather than built (D6601).
function run(fs) { return fs[0](3) }
function runCopy(fs) {
  const g = fs[0]
  return g(3)
}
const h = (u) => u + 1
const s: boolean = run([h])
print(s)
const t: boolean = runCopy([h])
print(t)
