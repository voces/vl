// @log 3
// @log 4
// @log 3
// @log w
// @log 3
// @log 4
// @log s
// A lambda returned through a hole parameter, and a hole function handed through one to a
// second hole parameter, take their pin from the call that finally makes them (D6001, D6002).
function fw(f) { return f }
function id(x) { return x }
function ap(f, x) { return f(x) }
function m(h) { print(h(3)) }
function n(h) { print(h("w")) }
const lam = (x) => x
const inc = (x) => x + 1
const q = fw(lam)
print(q(3))
print(q(4))
function g() {
  const r = fw(inc)
  print(r(3))
}
g()
print(fw(lam)(3))
print(ap(fw(lam), 3))
print(ap(fw(inc), 3))
const qi = fw(id)
m(qi)
m(fw(inc))
m(fw(id))
n(fw(id))
function o() { m(fw(id)) }
o()
m(fw(inc))
function t(h) { print(h("s")) }
t(fw(id))
