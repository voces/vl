// @run
// @log 5.5
// @log 5.5
// @log 2.5
// @log 5
// @log 2
// @log 5.5
// @log 11.5
// @log 10
// @log 4.5
// A list a function frame binds from a call's record, of records whose function field holds
// functions returning different types, read by a closure that captures it (D15921).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function mk() { return { a: [{ f: inc0 }, { f: half }] } }
function fr() {
  const c = mk().a
  const f = () => {
    print(c[0].f(3) + c[1].f(3))
  }
  f()
}
fr()
function frNested() {
  const c = mk().a
  const f = () => {
    const g = () => {
      print(c[0].f(3) + c[1].f(3))
    }
    g()
  }
  f()
}
frNested()
function frLet() {
  let c = mk().a
  c = mk().a
  const f = () => {
    print(c[1].f(5))
  }
  f()
}
frLet()
function frLoop() {
  const c = mk().a
  const f = () => {
    for e in c { print(e.f(4)) }
  }
  f()
}
frLoop()
function frReturned() {
  const c = mk().a
  return (x: i32) => c[0].f(x) + c[1].f(x)
}
const h = frReturned()
print(h(3))
print(h(7))
function frElem(k: i32) {
  const c = mk().a
  const f = (i: i32) => {
    const e = c[i]
    print(e.f(k))
  }
  f(0)
  f(1)
}
frElem(9)
