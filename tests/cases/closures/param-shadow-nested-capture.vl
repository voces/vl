// @run
// @log 7|inner|inner|7|7

// D2325 — a nested closure defined inside the shadow's block captures the SHADOW; a nested
// closure defined outside (after the block) captures the PARAM. Both must call the closure
// their own definition site actually sees.

function f(g: () => i32) {
  let out = "\{g()}"
  {
    const g = () => "inner"
    out = out + "|" + g()
    const cap = () => g()
    out = out + "|" + cap()
  }
  out = out + "|" + "\{g()}"
  const cap2 = () => g()
  out = out + "|" + "\{cap2()}"
  out
}
print(f(() => 7))
