// @run
// Missing-key variant of `module-holder-of-bundles-closure`: the holder reads key `z`, so it holds null.
// The holder called through in a closure (D17111).
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
const m = Map()
m["a"] = lap((a) => a + 1)
const x = m["z"]
const c = () => {
  if x != null { print(x(4)) }
}
c()
// @hint Intentionally-unused variable `_a`
