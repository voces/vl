// @hint redundant type annotation: `k` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `m` is inferred as `i32 | null` — remove it to lean on inference
import { toString } from "std:fmt"

// A range loop inside a function instanced at its un-annotated parameter: the instance clones the
// loop, and its body's reads of the loop variable still name the source's declaration. Q58 sweep of
// that read: a scalar and a union argument, a nested argument, a concat operand, an interpolation
// hole, a return, a binding, an `if` arm, a `??` operand and a record field.
function takeU(p: i32 | string) {
  return if p is i32 { p * 10 } else { p.length }
}
function id<T>(t: T): T { return t }
function firstOver(xs, n) {
  for i in 0 until xs.length {
    if xs[i] > n { return i }
  }
  return -1
}
function walk(xs) {
  for i in 0 until 2 {
    print(xs[i] + i)
    print(takeU(i))
    print(id(id(i)))
    print("i" + toString(i))
    print("at \{i}")
    const k: i32 = i
    print(k + xs[0])
    print(if i > 0 { i } else { 100 })
    const m: i32 | null = if i == 0 { null } else { i }
    print(m ?? 7)
    const r = { at: i, v: xs[i] }
    print(r.at + r.v)
  }
}
walk([1, 2])
walk([5.5, 6.5])
print(firstOver([1, 5, 9], 4))
print(firstOver([1.5, 2.5], 2.0))
