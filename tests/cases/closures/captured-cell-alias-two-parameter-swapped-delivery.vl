// @run
// @log L
// @log 1
// @log true
// @log L
// @log false
// @log 2
// A two-parameter hole-lambda seed called through an alias at one order of types and delivered at
// the swapped order; the alias is a copy taken before the write, so both print `L` (D3975).
function other<A, B>(a: A, b: B) { print("O"); print(a); print(b) }
function c2(f: (b: boolean, n: i32) => void) { f(false, 2) }
function main() {
  let k = (x, y) => {
    print("L"); print(x); print(y)
  }
  const flip = () => {
    k = other
  }
  const r = k
  r(1, true)
  flip()
  c2(r)
}
main()
