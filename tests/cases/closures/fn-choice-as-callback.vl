// @log 60
// @log bb
// @log 4
// An `if` or `match` choosing between two functions is a closure value of its own type when it
// is written inline as a `.map` / `.filter` callback or handed to a generic higher-order
// parameter, each generic arm instanced where the element or argument pins it (D9005, D9072).
function inc(a: i32) { return a + 1 }
function dbl(a: i32) { return a + a }
function big(a: i32) { return a > 2 }
function small(a: i32) { return a < 2 }
function idg<T>(t: T): T { return t }
function kg<T>(t: T): T { return t + t }
function yes<T>(t: T) { return [t].length > 0 }
function no<T>(t: T) { return [t].length > 1 }
function ap<T, R>(k: (x: T) => R, v: T): R { return k(v) }
function app<T>(g: (x: T) => T, v: T): T { return g(v) }
const c = [1].length > 0
const d = [1].length > 5
const kc = [1].length
const kd = [1].length - 1
print([3].map(if c { inc } else { dbl })[0])
print([3].map(if d { inc } else { dbl })[0])
print([1, 3, 5].filter(if c { big } else { small }).length)
print([1, 3, 5].filter(if d { big } else { small }).length)
print(
  [3].map(
    match kc {
      1 => inc
      _ => dbl
    },
  )[0],
)
print([3].map(if d { inc } else { (a: i32) => a * 3 })[0])
print([3].map(if c { inc } else { (a: i32) => a * 3 })[0])
print(
  [3].map(
    match kd {
      1 => inc
      _ => dbl
    },
  )[0],
)
print([3].map(if c { idg } else { kg })[0])
print([3].map(if d { idg } else { kg })[0])
print([1, 3, 5].filter(if c { yes } else { no }).length)
print([1, 3, 5].filter(if d { yes } else { no }).length)
print(ap(if c { idg } else { kg }, 3))
print(ap(if d { idg } else { kg }, 3))
print(app(if c { idg } else { kg }, 3))
print(app(if d { idg } else { kg }, 3))
function h<T>(xs: T[], b: boolean): T[] {
  return xs.map(if b { idg } else { kg })
}
print(h([3], true)[0])
print(h([1.5], false)[0])
function loc(b: boolean) {
  const ys = [5, 6].map(if b { inc } else { (a: i32) => a * 10 })
  return ys[1]
}
print(loc(true))
print(loc(false))
print(["a", "bb"].map(if loc(true) > 0 { idg } else { kg })[1])
const r = { f: inc }
print([3].map(if c { r.f } else { dbl })[0])
