// @run
// @log ss
// @log tt
// @log uu
// @log 8
// @hint Intentionally-unused parameter `_b` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_y` (leading `_` marks it unused)
// A call through an element or field inside a generic or un-annotated body runs at every
// instance that passes the written function the types it takes (D12238). Each written function
// doubles its argument, so a call that reaches `pick` instead prints the argument once (D15012).
function pick<A, B>(a: A, _b: B): A { a }
const fs = [pick]
fs[0] = (x, _y: string) => x + x
function g<T>(v: T): T { fs[0](v, v) }
function h<U>(u: U): U { g(u) }
print(h("s"))
const r = { f: pick }
r.f = (x, _y: string) => x + x
function gr(v) { r.f(v, v) }
print(gr("t"))
function k(a: string, _b: string) { a + a }
const ks = [pick]
ks[0] = k
function gk<T>(v: T): T { ks[0](v, v) }
print(gk("u"))
const ws = [pick]
ws[0] = (x, _y: string) => x + x
function gi<T>(v: T): T { ws[0](v, "w") }
print(gi(4))
