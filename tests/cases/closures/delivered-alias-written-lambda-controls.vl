// @run
// @log 12
// @log c
// @log 8
// @info `d2` is never reassigned; use `const` instead of `let`
// Controls for D3862: a written lambda nothing else calls, and an unwritten binding whose
// initializer the delivery pins.
const c = (y) => y + y
const e = (y) => y + y + y
let d = c
function mk(d: (y: i32) => i32, n: i32) { print(d(n)) }
function w() { d = e }
w()
mk(d, 4)
const c2 = (y) => {
  print("c")
  y + y
}
let d2 = c2
mk(d2, 4)
