// @run
// @log L
// @log 3
// @log L
// @log true
// A `let` seeded with a generic and written with an un-annotated lambda, called and then
// delivered to a closed function-typed parameter, runs the lambda at each type.
function other<V>(v: V) { print("O"); print(v) }
function cb(f: (b: boolean) => void, b: boolean) { f(b) }
function main() {
  let k = other
  k = (n) => {
    print("L"); print(n)
  }
  k(3)
  cb(k, true)
}
main()
