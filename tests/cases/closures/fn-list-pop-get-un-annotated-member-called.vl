// @run
// @log 6
// @log 6
// @log 4
// @log 8
// @log true
// @log 6
// @log 9
// A list of un-annotated functions read by `pop()` or `get(i)`, narrowed and called: the read is
// one of the list's slot reads, so its set is tagged and the read yields a member id boxed as a
// nullable `i32` (D15176). One member or two, at module scope or in a function body.
function half(a) { return a * 2 }
function inc(a) { return a + 1 }
const m = [half]
const g = m.pop()
if g != null { print(g(3)) }
const n = [inc, half]
const h = n.get(1)
if h != null { print(h(3)) }
const p = n.get(0)
if p != null { print(p(3)) }
const q = n.pop()
if q != null { print(q(4)) }
print(n.get(5) == null)
function local() {
  const xs = [half, inc]
  const f = xs.get(0)
  if f != null { print(f(3)) }
  const e = xs.pop()
  if e != null { return e(8) }
  return 0
}
print(local())
