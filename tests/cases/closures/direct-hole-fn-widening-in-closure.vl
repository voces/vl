// @run
// @log 1.5
// @log 4.5
// @log 2.5
// A closure calling an un-annotated function widening `i32` to `f64` directly returns the
// body's `f64`, captured or handed on (D8161).
function half(a) { return a / 2.0 }
const g = () => half(3)
print(g())
const k = 3
const m = (x: i32) => half(x) * k
print(m(3))
function run(f: () => f64) { print(f()) }
run(() => half(5))
