// @run
// @log 3
// @log 4
// @log 3
// @log 4
// @log 1
// A hole function in a list element, called through its slot with a generic called at two
// types, while the list's `length` is read too (D6880).
function add(a, b) { return a + b }
print(add(1, 2))
print(add(1.5, 2.5))
function apply2(g) {
  print(g(1, 2))
  print(g(1.5, 2.5))
}
const fs = [apply2]
fs[0](add)
print(fs.length)
