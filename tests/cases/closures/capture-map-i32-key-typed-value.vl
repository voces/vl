// @run
// @log 1
// @log 0
// @log 2
// @log 1
// MASTER'S FAILURE MODE FOR THIS FILE IS "THE COMPILER DIED" — worth stating, because it is
// not the usual shape of a red fixture. On master `vl check` reports "no errors" and then
// `vl build`/`vl run` exits 1 with a wasm backtrace through `vl-compiler.wasm` and `wasm trap:
// out of bounds array access`, writing NO MODULE. There is nothing to read: no diagnostic, no
// source location, no artefact. This file pins that a value exists to read.
//
// THE `docs/internals/silent-class-inventory.md` D4 PROGRAM, verbatim in shape. The inventory
// filed it as "an i32-keyed map captured by a nested function TRAPS INSIDE THE COMPILER" and
// named the KEY as the axis; the key is FLAT (a string-keyed map with the same VALUE traps
// identically, and a mono-VALUED i32-keyed map does not trap at all). The axis is the map's
// VALUE type, because `mapAnnShape` answers a real `mv` slot only for a value that needs its
// own `$mapStruct`, and that slot was returned where a STRUCT TABLE row was expected.
//
// The legs, each independently load-bearing:
//   L1 the capture is a PARAM — the `capturedStructIndex` kind gate, and `mapShapeOfExpr`'s
//      `Param` arm for the read's shape.
//   L2 the capture is a LOCAL of the enclosing frame, the inventory's second cell.
//   L3 the EMPTY-map runtime input, which the inventory measured separately (the trap is
//      input-independent; the correct answers are not).
//   L4 an UNCAPTURED read of the same map type, the control.

function mkFull(): {[i32]: string} {
  const m: {[i32]: string} = Map()
  m[1] = "x"
  return m
}

function mkEmpty(): {[i32]: string} {
  const m: {[i32]: string} = Map()
  return m
}

// L1 — the inventory's own program.
function body(m: {[i32]: string}) {
  function inner() { print(m.size) }
  inner()
}

// L2 — a captured LOCAL, two frames deep.
function bodyLocal() {
  const m: {[i32]: string} = Map()
  m[7] = "aa"
  m[8] = "bb"
  function mid() {
    function deepest() { print(m.size) }
    deepest()
  }
  mid()
}

// L4 — no capture.
function bodyPlain(m: {[i32]: string}) { print(m.size) }

body(mkFull())
body(mkEmpty())
bodyLocal()
bodyPlain(mkFull())
