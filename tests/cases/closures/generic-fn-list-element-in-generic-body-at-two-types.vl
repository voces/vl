// @run
// @log a
// @log 3
// @log b
// @log s
// @log a
// @log 1.5
// @log b
// @log t
// @log a
// @log 7
// @log b
// @log u
// An un-annotated list of generic functions inside a generic called at several types: each
// instance types the element reads at its own type parameter (D7381).
function a<V>(v: V) { print("a"); print(v) }
function b<V>(v: V) { print("b"); print(v) }
function g<T>(x: T, c: boolean) {
  const fs = [if c { a } else { b }]
  fs[0](x)
}
function each<T>(x: T, c: boolean) {
  const fs = [if c { a } else { b }]
  for f in fs { f(x) }
}
function copy<T>(x: T, c: boolean) {
  const fs = [a, b]
  const h = fs[if c { 0 } else { 1 }]
  h(x)
}
g(3, true)
g("s", false)
each(1.5, true)
each("t", false)
copy(7, true)
copy("u", false)
