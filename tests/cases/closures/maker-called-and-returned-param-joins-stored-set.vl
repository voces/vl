// @run
// @log 6
// @log 6
// @log 3.5
// @log 3
// @log 9
// @log 4
// @hint Intentionally-unused variable `_a` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_b` (leading `_` marks it unused)
// @hint redundant type annotation: `dbl` is inferred as `f64` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// A maker that calls its parameter and hands it back gives each call its argument's set: a lambda
// made through it joins the set a typed function stored beside it is of, called by id (D17726),
// at module scope and in a function, at each member's own signature, and through a second maker
// call at another argument type.
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
function dbl(a: f64): f64 { return a * 2.0 }
const m = Map()
m["a"] = lap((a) => a + 1)
m["b"] = dbl
const h = m["b"]
if h != null { print(h(3)) }
function body() {
  const hb = m["b"]
  if hb != null { print(hb(3)) }
}
body()
const g = m["a"]
if g != null { print(g(2.5)) }
if h != null { print(h(1.5)) }
m["c"] = lap((a) => a * 3.0)
const c = m["c"]
if c != null { print(c(3)) }
if g != null { print(g(3)) }
