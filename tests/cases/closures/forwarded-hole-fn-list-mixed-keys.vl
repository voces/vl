// @log 2.5
// A forwarded hole function called by list elements under keys that mix a closed call with
// one naming an element's value parameter: each element's calls bind the caller's hole, so
// every slot of the forwarded function takes its own instance (D12701). An element shared by
// two lists of different keys is D13200's.
function add(a, b) { return a + b }
function apply2(g, s) {
  print(g(1, 2))
  print(g(s, s))
}
function apply3(g, s) {
  print(g(10, 20))
  print(g(s, 0.25))
}
function apply4(g, s) { print(g(s, 2)) }
function inner(k, h) {
  for f in [apply2, apply3] { f(h, k) }
}
inner(0.5, add)

function innerLit(h) {
  for f in [apply2, apply3] { f(h, 0.5) }
}
innerLit(add)

function run<T>(x: T, h) {
  print(x)
  inner(0.5, h)
}
run(7, add)

function twin2(g, s) {
  print(g(1, 2))
  print(g(s, s))
}
function twin3(g, s) {
  print(g(10, 20))
  print(g(s, 0.25))
}
function innerThree(k, h) {
  for f in [twin2, twin3, apply4] { f(h, k) }
}
innerThree(0.5, add)
