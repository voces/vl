// @run
// @log a!
// @log a!
// @log b!
// @log a?
// @log b?
// @log a!
// @log c!
// A value `if` arm block ending in a `const` it declares holding a hole function delivers that
// function: bound at the top level, in either arm of a function called at both, and returned
// from a function (D12840).
function exclaim(s) { return s + "!" }
function ask(s) { return s + "?" }
const on = [1].length == 1
const x = if on {
  const lv = exclaim
  lv
} else {
  ask
}
print(x("a"))

function use(on) {
  const y = if on {
    const lv = exclaim
    lv
  } else {
    const lw = ask
    lw
  }
  print(y("a"))
  print(y("b"))
}
use([1].length == 1)
use([1].length == 2)

function pick(on: boolean) {
  return if on {
    const lv = exclaim
    lv
  } else {
    ask
  }
}
print(pick([1].length == 1)("a"))

const z = if [1].length == 2 {
  ask
} else {
  const lz = exclaim
  lz
}
print(z("c"))
