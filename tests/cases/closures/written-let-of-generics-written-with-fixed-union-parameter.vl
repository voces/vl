// @run
// @log W
// @log 5
// @log true
// @log W
// @log 9
// @log false
// A written `let` of generics given one whose first parameter is a fixed union: the write is
// adapted at the binding's call type, so the call and a delivery into an annotated parameter
// both reach it at that signature (D4892).
function s<A, B>(a: A, b: B) {
  print("S")
  print(a)
  print(b)
}
function w<B>(a: i32 | string, b: B) {
  print("W")
  print(a)
  print(b)
}
function run(f: (a: i32, b: boolean) => void) { f(9, false) }
function main() {
  let k = s
  k = w
  k(5, true)
  run(k)
}
main()
