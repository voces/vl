// @run
// @log none
// @log hi
// @log -1
// @log 7
// @log 0
// The closure NARROWS the captured nullable itself, run with the null value as well as the
// present one — the population that keeps the env-field read recovery honest.
//
// `twoDeep` is the two-frame case and the one that decided the shape: a transitive capture
// flows env-to-env, and the COPY that builds the inner frame's env must read the outer field
// RAW, because its destination field is the SAME nullable cell. Recovering there
// `ref.as_non_null`s a legitimately-null capture on its way into the next env and TRAPS — with
// the value never read. `emitCaptureRead`'s local and global legs are raw for exactly that
// reason, so the need is the caller's to state, not `emitCapturedRead`'s to assume.
//
// The one-frame `!= null` / `.length` cases pin the other side of the same gate: inside the
// closure the test itself must still see the raw cell (`pendingRawNullRead`), or the compare
// would be against an already-recovered ref.
function twoDeep(s: string | null) {
  const outer = () => {
    const inner = () => if s != null { s } else { "none" }
    return inner()
  }
  print(outer())
}

twoDeep(null)
twoDeep("hi")

function listGuard(xs: i32[] | null) {
  const gl = () => if xs != null { xs[0] } else { -1 }
  print(gl())
}

listGuard(null)
listGuard([7, 8])

function listLen(xs: i32[] | null) {
  const gn = () => if xs != null { xs.length } else { 0 }
  print(gn())
}

listLen(null)
