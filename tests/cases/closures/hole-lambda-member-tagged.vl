// @run
// @log 3
// @log 2.5
// @log 4
// @log 3.5
// @log 10
// @log 9.5
// @log 14
// @log 13
// @log 12.5
// A lambda handed to an un-annotated parameter, or bound to a const that is, is a member of the
// set its calls go through, called by its declaration; one reading a binding of the function it
// is nested in keeps its closure, whose environment an id cannot carry.
function lap0(f) { print(f(3)); print(f(2.5)) }
lap0((a) => a)

function lap1(f) { print(f(3)); print(f(2.5)) }
const g1 = (a) => a + 1
lap1(g1)

const k2 = 7
function lap2(f) { print(f(3)); print(f(2.5)) }
lap2((a) => a + k2)

function lap3(f) { return f(3) + f(4) }
print(lap3((a) => a * 2))

function lap4(f) { print(f(3)); print(f(2.5)) }
function mk4(k: i32) { lap4((a) => a + k) }
mk4(10)
