// @log 20
// @log 3.5
// A whole literal written into a held container is built at the holder's row, its inner
// literals at the holder's element or field: a list of records pushed onto a list of lists
// (D15357), and a record whose list field a binding read only there fills (D15392).
function id1(a) { return a + 1 }
function id2(a) { return a * 10 }
function id3(a) { return a + 100 }
const xs = [[{ f: id1 }]]
xs.push([{ f: id2 }])
print(xs[1][0].f(2))
print(xs[0][0].f(2.5))
const ys = [[{ f: id1 }]]
ys.push([{ f: id2 }, { f: id3 }])
ys.push([{ f: id1 }])
print(ys[1][1].f(2))
print(ys[1][0].f(2.5))
print(ys[2][0].f(3.5))
print(ys.length)
const fs = [id1]
let r = { f: fs }
print(r.f[0](1))
r = { f: [id2] }
print(r.f[0](2))
print(r.f[0](2.5))
const gs = [id1, id3]
let t = { f: gs, n: 5 }
print(t.f[1](1))
t = { f: [id2, id1], n: 6 }
print(t.f[0](2))
print(t.f[1](2.5))
