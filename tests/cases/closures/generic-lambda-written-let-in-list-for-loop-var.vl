// @run
// @log L
// @log 3
// @log L
// @log 4
// @log O
// @log true
// The list's elements read through a `for`'s loop variable reach the same one call type (D7103).
function other<V>(v: V) { print("O"); print(v) }
function main() {
  let k = other
  k = (n) => {
    print("L"); print(n)
  }
  const fs = [k]
  for f in fs { f(3) }
  for f in fs { f(4) }
  other(true)
}
main()
