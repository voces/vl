// @run
// @warning Unused variable `q` (prefix with `_` to suppress, or remove it)
// @log v
// @log 5
// A generic a maker returns, called at two types, beside a wider maker returning it with another
// generic that a `const` names and nothing calls (D15457).
function k<T>(x: T): T { return x }
function j<T>(x: T): T {
  print("j")
  return x
}
function mkLoop() { return k }
function mkPick(f: boolean) {
  if f { return k }
  return j
}
function main() {
  const l = mkLoop()
  print(l("v"))
  print(mkLoop()(5))
}
const q = mkPick
main()
