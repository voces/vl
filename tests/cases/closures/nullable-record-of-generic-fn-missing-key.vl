// @run
// @log none
// @log 2
// @log none
// @log 4
// A binding of a nullable record holding a generic function value is the nullable cell: a
// missing key reads `null`, a present one calls through the record's row (D15543).
function id<T>(x: T): T { x }
const a = Map()
a["k"] = { f: id }
const ar = a["z"]
if ar != null { print(ar.f(2)) } else { print("none") }
const br = a["k"]
if br != null { print(br.f(2)) } else { print("none") }
const xs = [{ f: id }]
const cr = if xs.length > 5 { xs[0] } else { null }
if cr != null { print(cr.f(3)) } else { print("none") }
const dr = if xs.length > 0 { xs[0] } else { null }
if dr != null { print(dr.f(4)) } else { print("none") }
