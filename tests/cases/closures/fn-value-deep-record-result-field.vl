// @run
// @log 1
// @log 2
// @log 3

// A function value held in a record field whose result is a record nesting another record
// twice over ten levels: the call read through the field, bound or returned, names `A10`'s own
// row (D9784). The nine-level `B` field is the control.

type A0 = {x: i32}
type A1 = {l: A0, r: A0}
type A2 = {l: A1, r: A1}
type A3 = {l: A2, r: A2}
type A4 = {l: A3, r: A3}
type A5 = {l: A4, r: A4}
type A6 = {l: A5, r: A5}
type A7 = {l: A6, r: A6}
type A8 = {l: A7, r: A7}
type A9 = {l: A8, r: A8}
type A10 = {l: A9, r: A9}

function mk(x: i32): A10 {
  const a0 = { x: x }
  const a1 = { l: a0, r: a0 }
  const a2 = { l: a1, r: a1 }
  const a3 = { l: a2, r: a2 }
  const a4 = { l: a3, r: a3 }
  const a5 = { l: a4, r: a4 }
  const a6 = { l: a5, r: a5 }
  const a7 = { l: a6, r: a6 }
  const a8 = { l: a7, r: a7 }
  const a9 = { l: a8, r: a8 }
  return { l: a9, r: a9 }
}

function mk9(x: i32): A9 { mk(x).l }

type R = {f: (x: i32) => A10, g: (x: i32) => A9}

function viaField(rr: R, n: i32): A10 { rr.f(n) }

const rr: R = { f: mk, g: mk9 }
const r = rr.f(1)
print(r.l.l.l.l.l.l.l.l.l.l.x)
print(viaField(rr, 2).r.r.r.r.r.r.r.r.r.r.x)
print(rr.g(3).l.l.l.l.l.l.l.l.l.x)
