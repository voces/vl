// @run
// @log 3
// @log 4
// @log s
// @log 6
// @log 7
// @log 8
// @log 3
// A parenthesised function name taken as a value is the name: a generic one is instanced where it
// is called, through a binding, a direct call, a record field or a list element (D4120).
function id<T>(x: T): T { x }
function inc(x: i32) { x + 1 }
const k = (id)
print(k(3))
print((id)(4))
print(((id))("s"))
let m = (id)
print(m(6))
function inner() {
  const g = (id)
  print(g(7))
}
inner()
print((inc)(7))
const o = { f: (id) }
print(o.f(3))
