// @run
// @log zC
// @log wC
// @log yC
// @log xC
// @info `dl` is never reassigned
// A call through a module-scope alias of a hole lambda, inside a function whose parameter
// rebinds the lambda's own name, pins the lambda through the alias and calls it through the
// alias, not the parameter (D3861).
const c = (y) => y + "C"
const d = c
function k(c: string) { d(c) }
print(k("z"))
function k2(c: string, s: string) { d(s + c) }
print(k2("", "w"))
let dl = c
function k3(c: string) { dl(c) }
print(k3("y"))
const d1 = c
const d2 = d1
function k4(d1: string) { d2(d1) }
print(k4("x"))
