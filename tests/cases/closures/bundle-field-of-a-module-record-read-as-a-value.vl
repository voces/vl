// @run
// @log 5
// @log 2.5
// @log 8
// @log 3
// @log 3
// @hint Intentionally-unused variable `_q` (leading `_` marks it unused)
// A module record holding a function called at two signatures, its field read as a value: copied
// and called at both, handed to a function, and copied uncalled (D17164).
function lap(f) {
  f(2.5)
  f(3)
  return f
}
function take(b) {
  print(b(4))
  print(b(1.5))
}
const w = { f: lap((a) => a + 1) }
const v = w.f
print(v(4))
print(v(1.5))
const o = { f: lap((a) => a * 2) }
take(o.f)
const p = { f: lap((a) => a - 1), n: 3 }
const _q = p.f
print(p.n)
