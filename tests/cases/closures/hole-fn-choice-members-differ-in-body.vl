// @log 8
// A choice between two un-annotated functions whose bodies differ runs the arm it chose, called
// directly and handed to a function beside each member on its own: the choice's value is typed
// apart from either member, so neither member's instance answers for it.
function inc(a) { return a + 1 }
function dbl(a) { return a * 2 }
function half(a) { return a / 2 }
function ap(f, x) { return f(x) }
function choose(c: boolean) {
  const g = if c { inc } else { dbl }
  print(g(3))
}
choose(true)
choose(false)
function hand(c: boolean) {
  const g = if c { inc } else { dbl }
  print(ap(g, 3))
}
hand(true)
hand(false)
print(ap(dbl, 4))
print(ap(inc, 4))
function pickHalf(c: boolean) {
  const g = if c { half } else { inc }
  print(g(7))
}
pickHalf(true)
pickHalf(false)
