// @run
// @log 7 4.5
// @log 5 2.5
// @log 6 3.5
// @log 7 4.5
// @log 5 2.5
// @log 6 3.5
// @hint Intentionally-unused variable `_a`
// @hint Intentionally-unused variable `_b`
// @hint Intentionally-unused variable `_t`
// A record of one closure per signature, held in a generic and handed back, takes the member
// its destination names at a field, an element, an assignment, a capture and a return (D15242).
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
function gen<T>(t: T, k: i32) {
  const r = lap((a) => a + k)
  const _t = t
  return r
}
type W = { f: (x: f64) => f64 }
const w: W = { f: gen("s", 1) }
w.f = gen(7, 3)
const wf = w.f
print("\{wf(4)} \{wf(1.5)}")
const xs: ((x: f64) => f64)[] = [gen("s", 1)]
const x0 = xs[0]
print("\{x0(4)} \{x0(1.5)}")
xs[0] = gen("t", 2)
const x1 = xs[0]
print("\{x1(4)} \{x1(1.5)}")
let g: (x: f64) => f64 = (x) => x
g = gen(1, 3)
print("\{g(4)} \{g(1.5)}")
const c: (x: f64) => f64 = gen("u", 1)
const k = () => print("\{c(4)} \{c(1.5)}")
k()
function back(): (x: f64) => f64 { return gen("v", 2) }
const b = back()
print("\{b(4)} \{b(1.5)}")
