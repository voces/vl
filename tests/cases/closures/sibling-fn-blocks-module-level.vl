// D2316 matrix — the MODULE-level twin of this row's function-scope witness, kept running
// as a control: D1751/D1862 already positioned the module-scope table, and this fix adds a
// separate function-scope table beside it without touching that one.

let out = ""
{
  const g = () => 1.5
  out = "\{g()}"
}
{
  const g = () => "s"
  out = out + g()
}
print(out)
