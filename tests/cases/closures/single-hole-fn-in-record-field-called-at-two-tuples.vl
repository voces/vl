// @run
// @log 4
// @log 2.5
// @log 4
// @log 2.5
// @log 4
// @log 2.5
// A record field holding one hole function, bare, parenthesised or through a binding, is a
// one-member set: each call through the field reaches the instance at its own tuple.
function inc(a) { return a + 1 }
const r = { f: inc }
print(r.f(3))
print(r.f(1.5))
const p = { f: (inc) }
print(p.f(3))
print(p.f(1.5))
const g = inc
const b = { f: g }
print(b.f(3))
print(b.f(1.5))
