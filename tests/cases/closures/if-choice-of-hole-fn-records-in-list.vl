// @run
// @log 2
// @log 7
// @log 1
// A value `if` choosing between records of different un-annotated functions, listed, is read
// at the row the global binding keeps rather than one its element name keys (D15301).
function id1(a) { return a }
function id2(a) { return a }
const c = 1 > 0
const xs = [if c { { f: id1 } } else { { f: id2 } }]
print(xs[0].f(2))
const d = 1 < 0
const ys = [if d { { f: id1 } } else { { f: id2 } }]
print(ys[0].f(7))
print(ys.length)
