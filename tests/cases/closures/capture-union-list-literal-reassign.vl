// D2394: an assignment whose right side is a literal built at the place's type, such as
// `[3.5, 4]` into `(i32 | f64)[]`, yields the place's type. Its value was typed at the
// literal's own `f64[]`, so a closure whose tail is that write was invalid wasm, and so was the
// write used as a value.
// @run
// @log 2 3.5 4
// @log 2 3.5 4
// @log 1 3.5
// @log 2 2 3.5
// @log 2 s true
// @log 2 3.5 4

// D2394's filed witness, printing the elements.
function tail() {
  let c: (i32 | f64)[] = [1, 2.5]
  const k = () => {
    c = [3.5, 4]
  }
  k()
  "\{c.length} \{c[0]} \{c[1]}"
}
print(tail())

// The closure's value is the list it stored.
function used() {
  let c: (i32 | f64)[] = [1, 2.5]
  const k = () => {
    c = [3.5, 4]
  }
  const r = k()
  "\{r.length} \{r[0]} \{r[1]}"
}
print(used())

function nested() {
  let c: (i32 | f64)[][] = [[1, 2.5]]
  const k = () => {
    c = [[3.5]]
  }
  k()
  "\{c[0].length} \{c[0][0]}"
}
print(nested())

// The value position with no closure: `r` and `c` are one list.
function value() {
  let c: (i32 | f64)[] = [1, 2.5]
  const r = (c = [3.5, 4])
  r[1] = 9
  "\{c.length} \{r.length} \{c[0]}"
}
print(value())

// A union element's member order differs from the literal's.
function order() {
  let c: (boolean | string)[] = ["a"]
  const k = () => {
    c = ["s", true]
  }
  k()
  const a = c[0]
  const b = c[1]
  if a is string && b is boolean { "\{c.length} \{a} \{b}" } else { "?" }
}
print(order())

let out = ""
{
  let c: (i32 | f64)[] = [1, 2.5]
  const k = () => {
    c = [3.5, 4]
  }
  k()
  out = "\{c.length} \{c[0]} \{c[1]}"
}
print(out)
