// A module-scope alias called at an `i32` and, in a module-scope function nothing calls, at a
// `string`: the dead call keeps its own slot and the live ones run (D3868, D3975).
const x = "a"
const n = 4
const c = (y) => y + y
const e = (y) => y + y + y
let d1 = e
print(d1(x))
print(d1(n))
let d3 = d1
let d4 = d3
function rw2(): string {
  const r = d4(x)
  d4 = c
  r
}
print(d4(n))
