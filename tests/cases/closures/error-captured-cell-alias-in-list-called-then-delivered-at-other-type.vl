// @emit-error the reassigned function binding `k` holds functions called at more than one argument type
// The same after the cell is written, with the alias delivered at another type (review of #3501, `rv3501/round2/q05d_alias_list_after_writer`).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function cb(f: (b: boolean) => void, b: boolean) { f(b) }
function main() {
  let k = inner
  const flip = () => {
    k = other
  }
  flip()
  const r = k
  const fs = [r]
  fs[0](3)
  cb(r, true)
}
main()
