// @run
// @log ss
// @log 4
// @log 6
// A hole lambda called directly at `string` and stored into a list and a map of `(i32) => i32`
// takes an instance per signature in both stores (D3881).
const tw = (y) => y + y
print(tw("s"))
const ls: ((y: i32) => i32)[] = []
ls.push(tw)
print(ls[0](2))
const ms: {[string]: (y: i32) => i32} = Map()
ms.set("a", tw)
const g = ms.get("a")
if g != null { print(g(3)) }
