// @run
// @log 4
// @log 1.5
// @log abab
// @log 8
// An un-annotated function handed to a generic's `(T) => R` parameter binds `R` to the result
// its body gives at the bound `T`, as the direct call does (D8943).
function inc(a) { return a + 1 }
function half(a) { return a / 2.0 }
function dup(s) { return s + s }
type P = { x: i32 }
function gx(p) { return p.x * 2 }
function apply<T, R>(h: (T) => R, x: T): R { return h(x) }
print(apply(inc, 3))
print(apply(half, 3))
print(apply(dup, "ab"))
const p: P = { x: 4 }
print(apply(gx, p))
