// @log 30
// @log O
// @log 4
// A `let` seeded from a function-typed parameter and written with a generic function holds the generic's instance at each enclosing instance's type, written in a closure, in the body, or under an `if` (D3957, D3958).
function other<V>(v: V) { print("O"); print(v) }
function third<Z>(z: Z) { print("T"); print(z) }
function viaClosure<T>(x: T, inner: (t: T) => void) {
  let k = inner
  const w = () => {
    k = other
  }
  k(x)
  w()
  k(x)
}
function viaParamF<T>(x: T, f: (t: T) => void) {
  let k = f
  const w = () => {
    k = other
  }
  k(x)
  w()
  k(x)
}
function inBody<T>(x: T, f: (t: T) => void) {
  let k = f
  k(x)
  k = other
  k(x)
  k = f
  k(x)
}
function underIf<T>(x: T, g: (t: T) => void, w: boolean) {
  let k = g
  if w { k = other }
  k(x)
}
function pr(i: i32) { print(i * 10) }
viaClosure(1, third)
viaParamF(1, (n: i32) => {
  print("P"); print(n)
})
viaClosure(true, third)
inBody(1, third)
inBody("q", third)
underIf(3, pr, false)
underIf(4, pr, true)
