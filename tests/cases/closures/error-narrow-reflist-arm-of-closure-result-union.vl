// @emit-error `is` names a type that is not a union variant
// THE SHAPE THAT CAUGHT AN UNSOUND INTERNER MERGE (rep-fuzz seed 99, case_00243,
// `p2r ((i32) => {f: boolean}[] | {w: i32}) | f64`). A closure-arm value union whose
// RESULT is itself a union of a ref-list and a struct; the narrowing reads the ref-list
// arm out of the called result.
//
// It is a clean loud REJECT here, and that is the POINT of pinning it. Enabling the shape
// interner's element dedup (unifying the refinement's two vocabularies through
// `shapeFieldElemName`) makes this composition resolve — and it then compiles to a wrong
// answer: the `t1 is {f: boolean}[]` test takes the else branch and prints `OTHER` where
// `false` is correct. REJECT -> MISMATCH is the "silently worsen" transition
// `rep-fuzz-check.sh` exists to refuse, and MISMATCH is never baselineable.
//
// Nothing else saw it: 2,010 corpus files byte-identical, 2,159 suite cases green, 1,939
// wasm cases green, native fixpoint byte-exact. The rep fuzzer alone caught it. This file
// is the corpus-side pin so the next attempt at that merge fails here first.
function makeIt(): ((i32) => {f: boolean}[] | {w: i32}) | f64 {
  return (q0) => ([{ f: false }])
}
function go() {
  const v: ((i32) => {f: boolean}[] | {w: i32}) | f64 = makeIt()
  const t0 = v
  if t0 is (i32) => {f: boolean}[] | {w: i32} {
    const t1 = t0(1)
    if t1 is {f: boolean}[] { print(t1[0].f) } else { print("OTHER") }
  } else {
    print("OTHER")
  }
}
go()
