// @log 4.5
// @log 12
// A hole lambda's bundle in an un-annotated slot, read through a `const` and handed whole: a
// field's, an element's both handed and called, and a map value's under a null test (D15907).
function lap(f) {
  f(2.5)
  f(3)
  return f
}
function take(b) {
  print(b(4))
  print(b(1.5))
}
const w = { f: lap((a) => a + 1) }
const v = w.f
take(v)
const xs = [lap((a) => a + 2)]
const e = xs[0]
take(e)
print(e(9))
take(xs[0])
const m = Map()
m["k"] = lap((a) => a + 3)
const mv = m["k"]
if mv != null { take(mv) }
if mv != null { print(mv(9)) }
