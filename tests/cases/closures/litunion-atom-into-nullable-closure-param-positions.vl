// @log b
// @log none
// A literal-union atom handed to a closure whose parameter is that union or null is the
// nullable atom's present value: the closure reads it. Q58 positions for the call's value, in
// the start body.
type K = "a" | "b"
const kv: K = "b"
const n = (k: K | null) => if k == null { "none" } else { k }
function takeS(v: string) { return v }
function takeU(v: i32 | string): string {
  if v is i32 { return "i\{v}" } else { return v }
}
type Rec = { t: string }
print(n(kv))
print(takeS(n(kv)))
print(takeU(n(kv)))
print(takeS(takeS(n(kv))))
print("c" + n(kv))
print("h \{n(kv)}")
const k = n(kv)
print(k)
const c = if k == "b" { n(kv) } else { n(null) }
print(c)
const q: string | null = null
print(q ?? n(kv))
const r: Rec = { t: n(kv) }
print(r.t)
print(n(null))
