// @run
// @log 5.5
// A list a call returns, read straight off the call into an un-annotated parameter, dispatches each
// element's field per member, as the same list read through a binding does (D16278).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function mk() { return { a: [{ f: inc0 }, { f: half }] } }
function take(a) {
  let acc = 0.0
  for e in a { acc = acc + e.f(3) }
  print(acc)
}
take(mk().a)
