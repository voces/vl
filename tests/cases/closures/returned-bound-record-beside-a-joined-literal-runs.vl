// @log 5
// @log 6
// A bound record holding un-annotated functions, returned beside a record of another set, is
// held and built at the function's result: its ids are shared with the joined set.
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function last(b) {
  const a = { fs: [inc0] }
  if b { return a }
  return { fs: [dbl] }
}
function first(b) {
  const a = { fs: [dbl] }
  if b { return { fs: [inc0] } }
  return a
}
function two(b) {
  const a = { fs: [inc0] }
  const c = { fs: [dbl] }
  if b { return a }
  return c
}
function arms(b) {
  const a = { fs: [inc0] }
  const c = { fs: [dbl] }
  return if b { a } else { c }
}
function wide(b) {
  const a = { fs: [inc0], n: 1 }
  const c = { fs: [dbl], n: 2 }
  c.n = 5
  if b { return a }
  print(c.n)
  return c
}
print(last(false).fs[0](3))
print(last(true).fs[0](3))
print(first(true).fs[0](3))
print(first(false).fs[0](3))
print(two(true).fs[0](3))
print(two(false).fs[0](3))
print(arms(false).fs[0](3))
print(arms(true).fs[0](3))
print(wide(false).fs[0](3))
