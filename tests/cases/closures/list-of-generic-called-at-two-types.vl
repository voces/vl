// @run
// @log I
// @log 1
// @log I
// @log true
// @log 1
// @log s
// @log 42
// @log ab
// @log I
// @log 3
// @log I
// @log true
// A list whose elements all hold one generic is called through them at each call's own
// instance, so `i32` and `boolean` calls through `fs[0]` both run (D3977). Its single source
// is what decides it: a list of two generics, or one written to, is still refused.
function inner<U>(u: U) {
  print("I")
  print(u)
}
function id<T>(x: T): T { x }
function main() {
  const fs = [inner]
  fs[0](1)
  fs[0](true)
}
main()
const gs = [id]
print(gs[0](1))
print(gs[0]("s"))
function local() {
  const hs = [id, id]
  print(hs[1](41) + 1)
  print(hs[0]("a") + "b")
}
local()
const ks = [inner]
function first() { ks[0](3) }
function second() { ks[0](true) }
first()
second()
