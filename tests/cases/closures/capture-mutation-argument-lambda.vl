// @run
// @log true
// @log true
// @log 5
// @log 4
// @hint Intentionally-unused parameter
// @hint redundant type annotation
// A lambda passed INLINE as a call argument writes a local of its maker (D2285, plumb
// PL-033). Closures capture by value, so the written local is boxed into a shared cell; the
// box used to be taken only for a numeric or string literal init, so a `false` init (or a
// call, a struct, a `null`) left the write with no slot and the emitter refused it.
import { reduce } from "std:array"

// plumb's shape: a boolean flag set inside a callback.
function f(g: (i32) => i32): i32 { g(1) }
function h(): boolean {
  let bad = false
  f((_i) => {
    bad = true
    0
  })
  bad
}
print(h())

// the same flag through a generic callee and a callback called more than once.
function app<T>(x: T, g: (T) => T): T { g(x) }
function viaGeneric(): boolean {
  let hit = false
  app(4, (v: i32) => {
    hit = true
    v
  })
  hit
}
print(viaGeneric())

function start(): i32 { 5 }
function twice(g: () => i32): i32 { g() + g() }
function fromCall(): i32 {
  let n = start()
  twice(() => {
    n = n - 1
    n
  })
  n + 2
}
print(fromCall())

// a count kept by a std callback.
function counted(): i32 {
  let calls = 0
  const xs = [1, 2, 3, 4]
  xs.reduce(
    (a: i32, x: i32) => {
      calls = calls + 1
      a + x
    },
    0,
  )
  calls
}
print(counted())
