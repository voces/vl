// @run
// @log z
// @log aC
// @log bC
// @log 1
// @log dC
// The controls for a shadowed hole-lambda name: beside the uses a nearer binding owns, the
// lambda's own reads, before a block's shadowing `const` and inside an unshadowed nested
// function, still lower it at the type they call it with (D3843).
const c = (y) => y + "C"
function param(c: string) { c }
print(param("z"))
print(c("a"))
function before(s: string) {
  print(c(s))
  if true {
    const c = 1
    print(c)
  }
}
before("b")
function viaInner(s: string) {
  function h(t: string) { c(t) }
  h(s)
}
print(viaInner("d"))
