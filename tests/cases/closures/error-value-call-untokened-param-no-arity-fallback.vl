// @emit-error a function-value call has no interned signature — parameter 2 of type `{[string]:i32}|null` has no representation in the function-value ABI
// Regression (D2810). A value call whose function type has a position with no `$fnsig` token
// may not fall back to the all-i32 functype of its arity, which `h`'s lambda interns here: the
// argument is a map reference, so that call builds invalid wasm. The refusal names
// the position; the nullable-map token itself is D2718's gap.
function run(
  fn: (i32, {[string]: i32} | null) => i32,
  m: {[string]: i32},
): i32 {
  fn(2, m)
}
function h(f: (i32, i32) => i32): i32 { f(1, 2) }
print(h((a: i32, b: i32): i32 => a + b))
print(1)
