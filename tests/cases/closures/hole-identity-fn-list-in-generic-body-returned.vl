// @run
// @log 3
// @log s
// A second delivery: the element's result returned at the generic's type parameter (D7840).
function a(v) { return v }
function b(v) { return v }
function g<T>(x: T, c: boolean): T {
  const fs = [if c { a } else { b }]
  return fs[0](x)
}
print(g(3, true))
print(g("s", false))
