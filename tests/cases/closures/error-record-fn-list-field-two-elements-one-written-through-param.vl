// @emit-error emitProgram: the function written to this element returns another type than the element's, at the arguments its calls pass — a list holds functions of one type
// A record's list field of two un-annotated functions, one overwritten through a parameter with a
// function of another result type: the element left alone still returns its own type, so the
// field's call signature is not a fact and the write is refused where it is made.
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function put(o) { o.xs[0] = half }
const r = { xs: [inc0, inc0] }
put(r)
print(r.xs[0](3))
print(r.xs[1](3))
