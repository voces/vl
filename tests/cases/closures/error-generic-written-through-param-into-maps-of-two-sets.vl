// @emit-error emitProgram: indexed-assignment target is not an array
// A helper writing a generic into maps of two different sets, only one of which holds it: the
// write is no leaf of either set, so neither map holds ids and the store refuses loudly (D15531).
function id<T>(x: T): T { x }
function id2<T>(x: T): T {
  print("id2")
  x
}
function k3<T>(x: T): T {
  print("k3")
  x
}
function bare(mm) { mm["k"] = id2 }
const h = Map()
h["k"] = id
bare(h)
const g = Map()
g["k"] = k3
bare(g)
const hr = h["k"]
if hr != null {
  print(hr(7))
  print(hr("w"))
}
const gr = g["j"]
if gr != null { print(gr(1)) }
const gk = g["k"]
if gk != null {
  print(gk(8))
  print(gk("v"))
}
