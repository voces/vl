// @run
// @log 4
// Sibling records holding different hole functions, `r.f` called:
// returned through a second function.
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function mk() { return { r: { f: inc0 }, s: { f: dbl } } }
function outer() { return mk() }
print(outer().r.f(3))
