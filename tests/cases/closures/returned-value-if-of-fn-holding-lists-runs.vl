// @run
// @log 6
// @log 4
// @log 6
// @log 6
// A returned value `if` whose arms are list or record literals holding different un-annotated
// functions is built at the function's joined result, as two returns are.
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function pick(b: boolean) {
  return if b { [{ fs: [inc0] }] } else { [{ fs: [dbl] }] }
}
function flat(b: boolean) {
  return if b { [{ f: inc0 }] } else { [{ f: dbl }] }
}
function rec(b: boolean) {
  return if b { { fs: [inc0] } } else { { fs: [dbl] } }
}
print(pick(false)[0].fs[0](3))
print(pick(true)[0].fs[0](3))
print(flat(false)[0].f(3))
print(rec(false).fs[0](3))
