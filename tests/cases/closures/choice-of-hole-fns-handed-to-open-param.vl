// @run
// @hint Intentionally-unused parameter `_a` (leading `_` marks it unused)
// @log s
// @log s
// @log 4
// @log 4
// @log s
// @log 4
// @log s
// @log s
// @log 3
// @log 2.5
// A choice of un-annotated functions whose results differ, handed to an open parameter, bound
// first or returned from a call, dispatches in the callee's instance (D16094).
function inc(a) { return a + 1 }
function str(_a) { return "s" }
function idv(a) { return a }
function ap(g, x) { return g(x) }
function sel(c: boolean) { return if c { str } else { inc } }
function both(g) {
  print(g(3))
  print(g(2.5))
}
function run(c: boolean) {
  const g = if c { str } else { inc }
  print(ap(g, 3))
  print(ap(if c { str } else { inc }, 3))
}
run(true)
run(false)
print(ap(sel(true), 3))
print(ap(sel(false), 3))
both(str)
both(idv)
