// @run
// @log 7
// @log 2
// @hint redundant type annotation: `xs` is inferred as `i32[][]`
// A nested function that ASSIGNS a captured ref array (D2285). Closures capture by value, so
// `captureBoxRewrite` boxes the written local into a length-1 cell whatever its init: an
// array-literal init boxes like a scalar one, and the write lands where the maker reads it.
// This pinned an emit refusal while only scalar-literal inits were boxed.

function body() {
  let xs: i32[][] = [[9, 8]]
  function inAssign() {
    xs = [[7]]
    print(xs[0][0])
  }
  inAssign()
  print(xs.length + xs[0].length)
}
body()
