// @run
// @log 1.5
// @log s

// D2316 matrix — the shared name is bound once per `if`/`else` ARM. Both arms compile
// (only one runs per call), so a fixed `cond` cannot tell them apart — call `f` once per
// arm instead.

function f(cond: boolean) {
  let out = ""
  if cond {
    const g = () => 1.5
    out = "\{g()}"
  } else {
    const g = () => "s"
    out = out + g()
  }
  out
}
print(f(true))
print(f(false))
