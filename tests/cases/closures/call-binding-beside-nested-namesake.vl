// @run
// @log 6
// @log 13
// @log 13
// @log 6
// A call through a local binding resolves to that binding even when another function nests a
// function of the same name: the monomorphizer asks the scope at the call, as the emitter does
// (D2759). Before, the nested `ap` answered and the two-argument call was refused for arity.
function s1(xs: i32[]) { xs.length * 3 }
function one() {
  function ap(g) { g([1, 2]) }
  print(ap(s1))
}
function two() {
  const out = [7]
  const ap = (k, g) => g(out) + k
  print(ap(10, s1))
}
function three() {
  const out = [7]
  const ap = (k, g) => g(out) + k
  print(ap(10, s1))
}
function four() {
  function ap(g) { g([1, 2]) }
  print(ap(s1))
}
one()
two()
three()
four()
