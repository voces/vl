// @run
// @log abc
// @log 8
// @log abc
// @log 8
// @log abc
// @log 8
// @log true
// @log abc
// @log 8
// @log abc
// @log 8
// @log dup
// @log abc
// @log dup
// @log 8
// @log abc
// @log 8
// @info `v` is never reassigned; use `const` instead of `let`
// @info `w` is never reassigned; use `const` instead of `let`
// A copy of a copy of an un-annotated function parameter, called at two types, takes a slot per
// call type from the copy before it; so does the chain listed, three copies long, beside a call
// of the first copy, through `let`s, and at two generics (D9790).
function id<T>(x: T): T { x }
function dup<T>(x: T): T {
  print("dup")
  x
}
function take(a) {
  const v = a
  const w = v
  print(w("abc"))
  print(w(7) + 1)
}
take(id)
function listed(a) {
  const v = a
  const w = v
  const xs = [w]
  print(xs[0]("abc"))
  print(xs[0](7) + 1)
}
listed(id)
function three(a) {
  const v = a
  const w = v
  const u = w
  print(u("abc"))
  print(u(7) + 1)
}
three(id)
function both(a) {
  const v = a
  const w = v
  print(v(true))
  print(w("abc"))
  print(w(7) + 1)
}
both(id)
function lets(a) {
  let v = a
  let w = v
  print(w("abc"))
  print(w(7) + 1)
}
lets(id)
take(dup)
take((x) => x)
