// @run
// @log 1.5
// @log 1.5
// @log 1.5
// @log 2.5
// @log 2
// @log 2
// @log 2
// @log 5
// @log 1.5
// An un-annotated function whose result differs from its parameter, read back from an
// un-annotated `Map()`, runs at its own result (D9064); a generic in a record held as the
// map's value runs when called through `?.` on the read (D9065).
function half(a) { return a / 2.0 }
function id<T>(x: T): T { x }
const m = Map()
m.set("b", half)
const x = m.get("b")
if x != null { print(x(3)) }
const n = Map()
n.set("b", half)
print((n.get("b") ?? half)(3))
const l = Map()
l.set("b", half)
for k, f in l { print(f(3)) }
function run() {
  const q = Map()
  q.set("b", half)
  const y = q.get("b")
  if y != null { print(y(5)) }
}
run()
const g = Map()
g["k"] = { f: id }
print(g["k"]?.f(2) ?? 0)
const h = Map()
h["k"] = { f: id }
const r = h.get("k")
print(r?.f(2) ?? 0)
const j = Map()
j["k"] = { f: id }
print(j["k"]?.f(2) ?? 0)
if j["k"] != null { print(j["k"].f(5)) }
const o = Map()
o["k"] = { f: half }
const v = o["k"]?.f(3)
if v != null { print(v) }
