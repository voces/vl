// @run
// @log 11
// @log 22
// @log 33
// @log 44
// @log 55
// @log 66
// @log 77
// @log 88
// @log 99
// @log 110
// @log 121
// @log 132

// D1623 — a call in STATEMENT position whose callee is neither a bare name nor a member: an
// element read, a map read, a call result, a parenthesised value. Each block adds a different
// constant, so a call reaching a neighbouring block's closure prints a wrong number.

// The two ingredients are the callee SHAPE and statement position, and the blocks below say
// so from both sides: the same call with no capture anywhere is here, and so is a plain
// `(f)(n)` with no container in the program at all.

// The witness: an element read called in a lambda's tail.
function atElement() {
  const xs = [(n: i32) => n + 1]
  const g = (n: i32) => xs[0](n)
  print(g(10))
}

atElement()

// The same shape with no capture at all — the lambda is gone and the call is the tail.
function noCapture() {
  const xs = [(n: i32) => n + 2]
  xs[0](20)
}

print(noCapture())

// A parenthesised plain closure: no container anywhere in the program, same outcome.
function atParen() {
  const f = (n: i32) => n + 3
  const g = (n: i32) => (f)(n)
  print(g(30))
}

atParen()

// A call result as the callee — `mk()(n)`.
function mk(): (i32) => i32 { return (n: i32) => n + 4 }

function atCallResult() {
  const g = (n: i32) => mk()(n)
  print(g(40))
}

atCallResult()

// A map read, narrowed, then called as the tail.
function atMapValue() {
  const m: { [string]: (i32) => i32 } = Map()
  m["k"] = (n: i32) => n + 5
  const mv = m["k"]
  if mv != null {
    const g = (n: i32) => mv(n)
    print(g(50))
  }
}

atMapValue()

// The element called for effect, over a void closure — the genuine discard, which must emit
// the call and leave the stack alone rather than drop a result the functype never promised.
function atVoidDiscard() {
  const xs = [(n: i32) => print(n + 6)]
  const g = (n: i32) => {
    xs[0](n)
    return 0
  }
  g(60)
}

atVoidDiscard()

// A non-i32 signature through the same tail.
function atStringSig() {
  const xs = [(s: string) => s + "7"]
  const g = (s: string) => xs[0](s)
  print(g("7"))
}

atStringSig()

// The array arriving as an annotated parameter rather than a local.
function atParamArray(xs: ((i32) => i32)[]) {
  const g = (n: i32) => xs[0](n)
  print(g(80))
}

atParamArray([(n: i32) => n + 8])

// The array at module scope, its element called in a module-level lambda's tail.
const moduleXs = [(n: i32) => n + 9]

const moduleG = (n: i32) => moduleXs[0](n)

print(moduleG(90))

// ── the neighbours that already ran, kept as controls ────────────────────────

// The element BOUND first, then called by name — an `Ident` callee, which had its own arm.
function boundFirst() {
  const xs = [(n: i32) => n + 10]
  const g = (n: i32) => {
    const e = xs[0]
    return e(n)
  }
  print(g(100))
}

boundFirst()

// The same element call in expression position, under an explicit `return`.
function exprPosition() {
  const xs = [(n: i32) => n + 11]
  const g = (n: i32) => {
    return xs[0](n)
  }
  print(g(110))
}

exprPosition()

// A struct field callee, which has a `Member` arm all along and must keep it.
function atField() {
  const w = { f: (n: i32) => n + 12 }
  const g = (n: i32) => w.f(n)
  print(g(120))
}

atField()
