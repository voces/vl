// @run
// @log 0
// @log a
// @log a
// @log 1
// @log 0
// @hint redundant type annotation: `f` is inferred as `i32`
// @hint redundant type annotation: `ownLocal` is inferred as `i32`
// @hint redundant type annotation: `captured` is inferred as `string`
// @hint redundant type annotation: `bound` is inferred as `string`
// @hint redundant type annotation: `p` is inferred as `{x: i32}`
// @hint redundant type annotation: `structArm` is inferred as `i32`
// @hint redundant type annotation: `inLoop` is inferred as `i32`
// An un-annotated lambda whose body holds an `if` STATEMENT ending in an assignment (D2286).
// Only an `if` in tail position yields the lambda's value, so its arms' last statements are
// statements everywhere else; classifying them as returns typed the lambda by the assigned
// value (a `string` result for an `i32` body) and the module failed validation.
function f(g: (i32) => i32): i32 { g(1) }

function ownLocal(): i32 {
  f((k) => {
    let t = "a"
    if k > 5 { t = "b" } else { t = "c" }
    t.length - 1
  })
}
print(ownLocal())

function captured(): string {
  let s = "a"
  f((k) => {
    if k > 5 { s = "b" }
    0
  })
  s
}
print(captured())

function bound(): string {
  let s = "a"
  const g = (k: i32) => {
    if k > 5 { s = "b" }
    0
  }
  g(1)
  s
}
print(bound())

type P = { x: i32 }
function structArm(): i32 {
  f((k) => {
    let p: P = { x: 1 }
    if k > 5 { p = { x: 2 } }
    p.x
  })
}
print(structArm())

function inLoop(): i32 {
  f((k) => {
    let t = "a"
    let i = 0
    while i < k {
      t = "bb"
      i = i + 1
    }
    t.length - 2
  })
}
print(inLoop())
