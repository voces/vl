// @run
// @log 42
// @log s
// @log 1.5
// @log 2.5
// @log 42
// @log 42
// A maker's result bound at module scope and called through an alias inside a top-level lambda:
// a quiet probe of the lambda's body, before its alias has a type, notes no call that would refuse
// the slot's signature (D16076). Each case has its own maker, so none is delivered at two types.
function outer() {
  const l = (x) => x
  return l
}
function outer2() {
  const l = (x) => x
  return l
}
function outer3() {
  const l = (x) => x
  return l
}
const c = outer()
const f = () => {
  const v = c
  print(v(41) + 1)
}
f()
const c2 = outer2()
const g = () => {
  const v = c2
  print(v("s"))
}
g()
const c3 = outer3()
const h = () => {
  const v = c3
  print(v(1.5))
}
h()
print(c3(2.5))
const c4 = outer()
const k = () => {
  const v = c4
  const w = v
  print(w(41) + 1)
}
k()
const c5 = outer()
const m = (n: i32) => {
  const v = c5
  print(v(n) + 1)
}
m(41)
