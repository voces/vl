// @run
// @log 1
// @log 101
// @log 2
// @log 3
// @log end
// @warning Unused function `uncalled` (prefix with `_` to suppress, remove it, or `export` it)
// A function whose last statement calls a record field's `void` function has no result, whether
// it is exported, reached by no call, or called: the tail is a statement (D3917). A field whose
// function returns a value is still the result.
type R = { f: (v: i32) => void }
type N = { a: R }
type V = { f: (v: i32) => i32 }
const g: R = { f: (v: i32) => print(v) }
function q<U>(y: U) { print(y) }
export function useLib(k: i32) {
  const r: { f: (v: i32) => void } = { f: q }
  r.f(k)
}
export function useMut(k: i32) {
  const r: R = { f: (v: i32) => print(v) }
  r.f = (v: i32) => print(v + 100)
  r.f(k)
}
function useNested(k: i32) {
  const n: N = { a: { f: (v: i32) => print(v) } }
  n.a.f(k)
}
function uncalled(k: i32) { g.f(k) }
function valued(k: i32) {
  const r: V = { f: (v: i32) => v + 2 }
  r.f(k)
}
useLib(1)
useMut(1)
useNested(2)
print(valued(1))
print("end")
