// @error-at 7:6 print expects a value, got void | i32
// A `let` seeded with a function that returns nothing takes one returning a value (owner ruling
// 2026-11-05, B2), but its calls give nothing, so reading a call's result is refused (D15015).
function inner<U>(u: U) { print(u) }
function retV<V>(v: V): V { v }
let m = inner
m = retV
print(m(7))
