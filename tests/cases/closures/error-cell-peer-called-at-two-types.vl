// @emit-error holds lambdas called at more than one argument type
// A hole lambda reached through a capture cell at a string and through a binding the cell's
// read is written into at an i32: the read is that cell's own instance, and no instance holds
// both signatures, so it is refused. It printed the first value and then trapped on an indirect
// call type mismatch (D3857).
function mk(x: string, n: i32) {
  const g = (y) => y
  const h = (y) => y + y
  let d1 = g
  function w1() {
    d1 = d1
    0
  }
  let d3 = h
  d3 = d1
  print(d1(x))
  print(d3(n))
}
mk("a", 4)
