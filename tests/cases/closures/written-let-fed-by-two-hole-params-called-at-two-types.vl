// @log 2.25
// @log 2.5
// A written `let` seeded from one parameter and written from another, each parameter also called
// at another type: both parameters' sets are decided with the let's wider set, so each call
// dispatches on the value the let holds there (D15409).
function id<T>(x: T): T { x }
function dup<T>(x: T): T {
  print("dup")
  x
}
function one(a, c, k: boolean) {
  let b = a
  if k { b = c }
  print(b(3) + 1)
  print(a("x"))
}
one(id, dup, true)
one(dup, id, false)
function two<F, G>(a: F, c: G, k: boolean) {
  let b = a
  if k { b = c }
  print(b(3) + 1)
  print(a("x"))
}
two(id, dup, true)
two(dup, id, false)
function add(x, y) { return x + y }
function mul(x, y) { return x * y }
function swap(h, k: boolean) {
  let hh = h
  if k { hh = mul }
  print(hh(1.5, 1.5))
  print(h(0.5, 2.0))
}
swap(add, false)
swap(add, true)
