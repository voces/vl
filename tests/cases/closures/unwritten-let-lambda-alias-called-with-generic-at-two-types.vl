// @run
// @info `k` is never reassigned; use `const` instead of `let`
// @info `twice` is never reassigned; use `const` instead of `let`
// @info `t` is never reassigned; use `const` instead of `let`
// @log 2
// @log s
// @log 4
// A `let` alias of a lambda that nothing writes is the lambda, so a generic handed through it is
// called at both of the lambda's types (D6472).
function id(a) { return a }
const lap = (g) => {
  print(g(1) + 1)
  return g("s")
}
let k = lap
print(k(id))
let twice = (g) => g(g(2))
let t = twice
print(t((n) => n * 2) / 2)
