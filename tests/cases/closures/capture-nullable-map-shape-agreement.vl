// @run
// @log 2
// @log NUL
// @log 2
// @log NUL
// @log 2
// @log NUL
// @log 2
// @log NUL
// @log x
// A CAPTURED `{[K]: V} | null`, narrowed and read — the map half of the nullable-niche
// capture storage class, and the half where getting only the NULL TEST right is a severity
// REGRESSION rather than a fix.
//
// TWO SITES, AND THE SECOND ONE IS THE POINT. Teaching `exprNullableMap` the capture storage
// class lets the `!= null` compare lower, but the narrowed READ then resolves its map SHAPE
// through `mapShapeOfExpr`, whose capture arm answered for the non-null `map` kind only. A
// `nulmap` capture fell past it to the mono `-1` string-keyed `$mapStruct` while
// `captureValStructIdx` had typed the env FIELD with the i32-keyed one — `struct.get` over
// two different heap types, i.e. check-clean INVALID WASM at the `.size`, which is strictly
// worse than the loud reject it replaced. Measured: closing the test alone moved 22 cells
// from `loud emit reject` to `check-clean invalid wasm`.
//
// So the shape arm reads the env field's OWN companion slot (`capturedNulMapShape` →
// `captureValStructIdx`), the number that MINTED the field's heap type, rather than
// re-deriving it. The three maps below are the three shapes that can disagree: mono
// string-keyed (`-1`), mono i32-keyed (`-4`), and a ref-VALUED map (a real mv slot). A mono
// string-keyed map alone cannot catch this — its wrong answer and its right answer are the
// same number.

function mkStrI32(): {[string]: i32} {
  const m: {[string]: i32} = Map()
  m["k"] = 5
  m["j"] = 6
  return m
}

function mkI32Str(): {[i32]: string} {
  const m: {[i32]: string} = Map()
  m[1] = "x"
  m[2] = "y"
  return m
}

function mkStrStr(): {[string]: string} {
  const m: {[string]: string} = Map()
  m["k"] = "x"
  m["j"] = "y"
  return m
}

// mono string-keyed: shape -1 either way, the control that agrees by accident.
function monoStrCap(p: {[string]: i32} | null) {
  function readMonoStr() {
    if p != null { print(p.size) } else { print("NUL") }
  }
  readMonoStr()
}

monoStrCap(mkStrI32())
monoStrCap(null)

// mono i32-keyed: shape -4, the one the mono default gets wrong.
function monoI32Cap(p: {[i32]: string} | null) {
  function readMonoI32() {
    if p != null { print(p.size) } else { print("NUL") }
  }
  readMonoI32()
}

monoI32Cap(mkI32Str())
monoI32Cap(null)

// a ref-VALUED map: an interned mv slot, the third index the read can land on.
function refValCap(p: {[string]: string} | null) {
  function readRefVal() {
    if p == null { print("NUL") } else { print(p.size) }
  }
  readRefVal()
}

refValCap(mkStrStr())
refValCap(null)

// the same i32-keyed map narrowed by `is` — the other caller of the one null-test home.
function isNarrowCap(p: {[i32]: string} | null) {
  function readIsNarrow() {
    if p is {[i32]: string} { print(p.size) } else { print("NUL") }
  }
  readIsNarrow()
}

isNarrowCap(mkI32Str())
isNarrowCap(null)

// an INDEX read through the narrowed capture, not just `.size`: the value rep has to come off
// the same shape the field was typed with, or the read pulls a string out of an i32 column.
function indexCap(p: {[i32]: string} | null) {
  function readIndexed() {
    if p != null { print(p[1] ?? "NUL") } else { print("NUL") }
  }
  readIndexed()
}

indexCap(mkI32Str())
