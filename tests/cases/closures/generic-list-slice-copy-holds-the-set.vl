// @run
// @log 2
// @log a
// @log 1
// @log 7
// A `slice` of a list of generics is a list of the same function set, so the source and the copy
// are each called through the set at the types their calls take, the uncalled member included
// (D14931).
function id<T>(x: T): T { x }
function same<T>(x: T): T { x }
const gs = [id, same]
const hs = gs.slice(1)
print(gs[0](2))
print(hs[0]("a"))
print(hs.length)
for h in hs { print(h(7)) }
