// @run
// @log 3
// @log 2
// @log s
// @log 3
// @log 2
// @log s
// A list of a generic spread into a copy that is then written with a fixed-type function, inside a
// function, while the source list is called through at two types: the copy and its source share
// the slot's functions (D9595, D10020).
function id<T>(x: T): T { x }
function inc(x: i32) { x + 1 }
function viaPush() {
  const xs = []
  xs.push(id)
  const ys = [...xs]
  ys[0] = inc
  print(ys[0](2))
  print(xs[0](2))
  print(xs[0]("s"))
}
viaPush()

function viaLiteral() {
  const as = [id]
  const bs = [...as]
  bs[0] = inc
  print(bs[0](2))
  print(as[0](2))
  print(as[0]("s"))
}
viaLiteral()
