// @run
// @log 3
// @log 3
// @log 7
// @log 3
// @log 3.5
// A list of functions that each call a forwarded hole function at one signature is held as its
// set's ids inside the open function that hands the function on; a member calling it at two keeps
// the list closures (D15068).
function add(a, b) { return a + b }
function apply2(g) { print(g(1, 2)) }
function apply3(g) { print(g(3, 4)) }
function twice(g) {
  print(g(1, 2))
  print(g(1.5, 2))
}
function viaFor(h) {
  for f in [apply2] { f(h) }
}
viaFor(add)
function viaIndex(h) {
  const fs = [apply2, apply3]
  let i = 0
  while i < fs.length {
    fs[i](h)
    i = i + 1
  }
}
viaIndex(add)
function viaTwice(h) {
  for f in [twice] { f(h) }
}
viaTwice(add)
