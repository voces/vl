// @run
// @log 1
// @log 2
// @log 1
// @log 2
// @log 2
// @log 2
// @log 4
// @info `r4` is never reassigned; use `const` instead of `let`
// @info `r6` is never reassigned; use `const` instead of `let`
// A record field holding a list of lists of un-annotated functions nothing calls is pinned at the
// signature every inner element is instanced at, as a list of them is (D16915).
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
let r = { f: [[inc0]] }
r = { f: [[dbl]] }
print(r.f.length)
const r2 = { f: [[inc0], [dbl]] }
print(r2.f.length)
let r3 = { f: [[inc0]] }
r3 = { f: [[dbl]] }
print(r3.f[0].length)
let r4 = { f: [[inc0]], g: 1 }
print(r4.f.length + r4.g)
const r5 = { f: [[inc0]] }
const q5 = { f: [[dbl]] }
print(r5.f.length + q5.f.length)
let r6 = { f: [[inc0, dbl]] }
print(r6.f[0].length)
const r7 = { f: [[inc0], [dbl]] }
print(r7.f[1][0](2))
