// @emit-error the captured binding `k` is written with a function inside a closure that every instance of
// The same, with no call through the cell before the write (review of #3498, `rv3498/e19_shared_writer_hole_lambda_no_seed_call_i32_bool`).
function inner<U>(u: U) { print("I"); print(u) }
function a<T>(x: T) {
  let k = inner
  const w = () => {
    k = (u) => {
      print("L"); print(u)
    }
  }
  w()
  k(x)
}
a(1)
a(true)
