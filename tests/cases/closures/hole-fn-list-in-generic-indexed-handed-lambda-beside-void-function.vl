// @run
// @warning Unused parameter
// @log 3
// @log 30
// @log 9
// D10702 at an indexed read in place of the loop variable.
function apply2(g) { print(g(1, 2)) }
function apply3(g) { print(g(10, 20)) }
function gen<T>(x: T) {
  const gs = [apply2, apply3]
  let i = 0
  while i < gs.length {
    gs[i]((a, b) => a + b)
    i = i + 1
  }
}
gen("z")
function tick() { print(9) }
tick()
