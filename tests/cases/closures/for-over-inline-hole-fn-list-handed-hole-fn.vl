// @run
// @log 3
// @log 4
// @log 30
// A `for` over an inline list literal of hole functions, each handed a hole function, types
// each call through the literal's elements as it does through a `const` one (D8062).
function add(a, b) { return a + b }
function apply2(g) {
  print(g(1, 2))
  print(g(1, 3))
}
function apply3(g) { print(g(10, 20)) }
for f in [apply2, apply3] { f(add) }
