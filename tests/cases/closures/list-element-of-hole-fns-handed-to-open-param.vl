// @run
// @hint Intentionally-unused parameter `_a` (leading `_` marks it unused)
// @log s
// @log 4
// @log s
// @log 4
// @log 4
// @log s
// @log 6
// @log 4
// @log s
// @log s!
// @log 5
// D16091: a list element of un-annotated functions whose results differ, handed to an open
// parameter, dispatches in the callee's instance, and the caller reads the members' join, as a
// direct call through the element does: one handed on, forwarded twice, a literal of three, a
// loop's element, and the result narrowed.
function inc(a) { return a + 1 }
function str(_a) { return "s" }
function dbl(a) { return a * 2 }
function ap(g, x) { return g(x) }
function ap2(g, x) { return ap(g, x) }
function one(c: boolean) {
  const fs = [inc]
  if c { fs[0] = str }
  print(ap(fs[0], 3))
}
function fwd(c: boolean) {
  const fs = [inc]
  if c { fs[0] = str }
  print(ap2(fs[0], 3))
}
function lit3(n: i32) {
  const fs = [inc, str, dbl]
  print(ap(fs[n], 3))
}
function loopEl() {
  for f in [inc, str] { print(ap(f, 3)) }
}
function narrow(c: boolean) {
  const fs = [inc]
  if c { fs[0] = str }
  const r = ap(fs[0], 3)
  if r is string { print(r + "!") } else { print(r + 1) }
}
one(true)
one(false)
fwd(true)
fwd(false)
lit3(0)
lit3(1)
lit3(2)
loopEl()
narrow(true)
narrow(false)
