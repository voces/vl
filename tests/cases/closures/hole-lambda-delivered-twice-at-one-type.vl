// @run
// @log xx
// @log 4
// @log 1
// @log 6
// @log 14
// @log 16
// A hole lambda delivered at one function type twice, after a delivery at another, reaches the
// instance at that type from both: two pushes, two element stores (D3892).
const tw = (y) => y + y
const a: ((y: string) => string)[] = []
a.push(tw)
const b: ((y: i32) => i32)[] = []
b.push(tw)
const c: ((y: f64) => f64)[] = []
c.push(tw)
const d: ((y: i32) => i32)[] = []
d.push(tw)
print(a[0]("x"))
print(b[0](2))
print(c[0](0.5))
print(d[0](3))
const gs: ((y: i32) => i32)[] = [(y) => y]
gs[0] = tw
const hs: ((y: i32) => i32)[] = [(y) => y]
hs[0] = tw
print(gs[0](7))
print(hs[0](8))
