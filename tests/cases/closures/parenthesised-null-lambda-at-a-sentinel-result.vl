// @run
// @log NULL
// @log NULL
// @log true
// A lambda whose body is a parenthesised `null`, passed where a `boolean | null` or `K | null`
// result is expected, returns that result's null.
type K = "a" | "b"
function useB(p: () => boolean | null) {
  const t = p()
  if t != null { print(t) } else { print("NULL") }
}
function useK(p: () => K | null) {
  const t = p()
  if t != null { print(t) } else { print("NULL") }
}
useB(() => (null))
useK(() => (null))
useB(() => true)
