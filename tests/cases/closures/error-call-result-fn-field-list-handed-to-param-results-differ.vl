// @check
// @error cannot store 'half' in 'a[].f': called at (i32) it returns f64, where 'inc0', also stored in it, returns i32 — every function a call through 'a[].f' may run must return one type
// A list a call returns, read straight off the call into an un-annotated parameter, is judged
// through the call's returned values as the same list read through a binding is (D16278).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function mk() { return { a: [{ f: inc0 }, { f: half }] } }
function take(a) {
  let acc = 0.0
  for e in a { acc = acc + e.f(3) }
  print(acc)
}
take(mk().a)
