// @run
// @log 1
// @log zC
// @log 2
// @log zzC
// @log zzzzC
// @log s
// @log 8
// A call through a module-scope alias of a hole lambda, inside a function whose own local
// rebinds the lambda's name or a link of the chain, calls the module's lambda (D3880).
const c = (y) => y + "C"
const d = c
function k(s: string) {
  const c = 1
  print(c)
  return d(s)
}
print(k("z"))
const e = c
const f = e
function twice(s: string) {
  const e = 2
  print(e)
  print(f(s + s))
  return f(s + s + s + s)
}
print(twice("z"))
const dbl = (y) => y * 2
const g = dbl
function num(n: i32) {
  const dbl = "s"
  print(dbl)
  return g(n)
}
print(num(4))
