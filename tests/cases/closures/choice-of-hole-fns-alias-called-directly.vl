// @run
// @hint Intentionally-unused parameter `_a` (leading `_` marks it unused)
// @log s
// @log s
// @log 4
// @log 10
// An un-annotated alias of a choice called through an open parameter is called directly. Beside
// a delivery of `id(g)` to a closed function type it is refused (D17107).
function inc(a) { return a + 1 }
function str(_a) { return "s" }
function ap(g, x) { return g(x) }
function run(c: boolean) {
  const g = if c { str } else { inc }
  print(ap(g, 3))
  const h = g
  print(h(9))
}
run(true)
run(false)
