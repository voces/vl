// @error cannot choose 'lenOf' here: called at (string) it returns i32
// A choice of un-annotated functions called where it is written is refused at the arm when the
// results differ (D13740).
function twice(s) { return s + s }
function lenOf(s) { return s.length }
const k = [1].length > 1
print((if k { twice } else { lenOf })("abc"))
