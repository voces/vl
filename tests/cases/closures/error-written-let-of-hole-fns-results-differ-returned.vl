// @error cannot write 'half' to 'f': called at (i32) it returns f64, where 'inc0', also written to it, returns i32
// A re-pointed `let` returned and called by the caller runs either function, so a write whose
// body gives another result at the caller's argument types is refused (D9008).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function get() {
  let f = inc0
  f = half
  return f
}
print(get()(3))
