// @run
// @log 300000
// @log 3

// A block-local function that captures `step` and recurses in tail position. Every use is a
// direct call, so it is lambda-lifted: `step` travels as a parameter and the recursive call is a
// plain `return_call`. As a closure each level rebuilt its environment and recursed through the
// table, and 100000 levels overflowed the stack (SP-037).

function host(p: i32) {
  const step = p
  function go(n: i32, acc: i32): i32 {
    if n == 0 { return acc }
    return go(n - 1, acc + step)
  }
  print(go(100000, 0))
  print(go(1, 0))
}
host(3)
