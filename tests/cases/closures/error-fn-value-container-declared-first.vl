// @error-at 8:39 a `(() => Circle)[]` cannot be used as `readonly (() => Shape)[]` here: a call through that type would reach a function it holds at a signature the function does not have, and the functions inside a value are not converted on the way. Build the value at `readonly (() => Shape)[]`, or wrap each function in a lambda of the wider type where it is stored
// @error-at 11:71 a `(() => Circle)[]` cannot be used as `readonly (() => Shape)[]` here: a call through that type would reach a function it holds at a signature the function does not have, and the functions inside a value are not converted on the way. Build the value at `readonly (() => Shape)[]`, or wrap each function in a lambda of the wider type where it is stored
// The container refusal holds in functions declared before any function value, and at a return.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function useAll(xs: (() => Circle)[]) {
  const ys: readonly (() => Shape)[] = xs
  print(ys.length)
}
function retIt(x: (() => Circle)[]): readonly (() => Shape)[] { return x }
function F(): Circle { return { r: 7 } }
const fs: (() => Circle)[] = []
fs.push(F)
useAll(fs)
print(retIt(fs).length)
