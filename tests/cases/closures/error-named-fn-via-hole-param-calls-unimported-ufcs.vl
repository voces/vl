// @error 'toString' is not imported
// A named function handed to a hole parameter and called there with a generic is checked at the
// call's instance, and its body's error is the program's (D15459).
function id(a) { return a }
function lap(g) { const x = g(1); return x.toString() }
function use(k) { return k(id) }
print(use(lap))
