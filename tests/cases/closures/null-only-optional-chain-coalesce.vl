// @run
// @log 0
// @log 7
// @log 8
// @log s
// A `?.` read or call over a binding only ever `null`, under `??`, takes the fallback; the call's
// arguments are never evaluated (D16828).
const a = null
print(a?.f ?? 0)
print(a?.f(2) ?? 7)
function t(k: i32) {
  print(k)
  return k
}
print(a?.g(t(5)) ?? 8)
print(a?.f ?? "s")
