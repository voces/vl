// @run
// @log 1.5s

// D2316's own witness — sibling function-scope blocks, closure return types f64 then
// string. `vl check` rc 0; the emitted module used to fail with `type mismatch: expected
// (ref $type), found f64` because the second block's call classified with the first
// block's return kind.

function f() {
  let out = ""
  {
    const g = () => 1.5
    out = "\{g()}"
  }
  {
    const g = () => "s"
    out = out + g()
  }
  out
}
print(f())
