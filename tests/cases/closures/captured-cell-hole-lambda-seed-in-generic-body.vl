// @run
// @log L
// @log true
// @log F
// @log true
// @log O
// @log true
// @log L
// @log 1
// @log O
// @log 1
// @log L
// @log 2
// @log O
// @log 2
// A capture cell in a generic body seeded with a hole lambda and called at the type parameter is
// retyped to the lambda the call pins; instances that agree on that type share it.
function other<V>(v: V) { print("O"); print(v) }
function run<T>(t: T) {
  let k = (x) => {
    print("L"); print(x)
  }
  const flip = () => {
    k = other
  }
  const back = () => {
    k = (y) => {
      print("F"); print(y)
    }
  }
  k(t)
  back()
  k(t)
  flip()
  k(t)
}
function twice<T>(t: T) {
  let k = (x) => {
    print("L"); print(x)
  }
  const flip = () => {
    k = other
  }
  k(t)
  flip()
  k(t)
}
run(true)
twice(1)
twice(2)
