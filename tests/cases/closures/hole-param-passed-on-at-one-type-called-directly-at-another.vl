// @run
// @log 2
// @log 2
// @log 2
// @log 3
// A hole parameter handed a generic, passed on to a generic's function parameter at one type and
// called directly at another, is a generic used at two instances, bound per call (D15576).
function id<T>(x: T): T { x }
function run<U>(f: (x: U) => U, u: U): U { f(u) }
function take(a) {
  print(run(a, 2))
  print(a("ab").length)
}
function take2(a) {
  print(run(a, 2))
  const s = "abc"
  print(a(s).length)
}
take(id)
take2(id)
