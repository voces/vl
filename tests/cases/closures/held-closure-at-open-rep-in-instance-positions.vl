// @run
// @log 1
// @log a
// @log true
// @log 2
// @log b
// @log false
// @log 3
// @log c
// @log true
// @log 4
// @log d
// @log false
// A closure a generic's instance holds at an open type's uniform closure rep is typed at that
// rep's own type: one row per position such a held closure is read in, each at three instances.
function other<V>(v: V) { print(0) }
// an element of a list literal, called by index
function inList<T>(x: T) {
  let k = other
  k = (n) => {
    print(n)
  }
  const fs = [k, k]
  fs[1](x)
}
// a record field, read into a binding and called
function inField<T>(x: T) {
  let k = other
  k = (n) => {
    print(n)
  }
  const o = { f: k }
  const h = o.f
  h(x)
}
// an argument handed on, called by the callee
function callIt<U>(f: (u: U) => void, u: U) { f(u) }
function asArg<T>(x: T) {
  let k = other
  k = (n) => {
    print(n)
  }
  callIt(k, x)
}
// a capture of a lambda the instance calls
function inLambda<T>(x: T) {
  let k = other
  k = (n) => {
    print(n)
  }
  const q = () => k(x)
  q()
}
inList(1)
inList("a")
inList(true)
inField(2)
inField("b")
inField(false)
asArg(3)
asArg("c")
asArg(true)
inLambda(4)
inLambda("d")
inLambda(false)
