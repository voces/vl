// @emit-error a function-value call has no interned signature
// A record field holding a written `let` of a generic, inside a generic function instanced at
// two types: the instances share the field read, so the call stays refused rather than typed at
// one instance's signature (D5079).
function k<T>(x: T): T { return x }
function use<U>(u: U): U {
  let g = k
  g = k
  const r = { q: g }
  return r.q(u)
}
print(use(5))
print(use("t"))
