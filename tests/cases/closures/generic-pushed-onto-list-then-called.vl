// @run
// @log O
// @log 3
// @log O
// @log true
// A generic pushed onto a list and called through its index is instanced at that call's type
// (D7143).
function other<V>(v: V) { print("O"); print(v) }
function main() {
  let k = other
  k = (n) => {
    print("L"); print(n)
  }
  const fs = [k]
  fs.push(other)
  fs[1](3)
  other(true)
}
main()
