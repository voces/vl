// @run
// @log 11
// @log 30
// @log aa
// @log none
// @log atom
// @log 7
// @log 8
// @log nomap
// @log nolist
// @log pos
// @log NULL
// The SEVEN sites in `emit_classify.vl` that ask the PAREN grammar — "does this type name
// OPEN a paren group?" and "does that group's span END at the last character?" — now
// through `emit_base.nameIsParenOpen` / `nameIsParenSpanEnds`, the two homes #1190 built.
// This is the witness for D-PARENCLASSIFY, which routed each of them off its own
// hand-written character compare.
//
// EVERY CELL IS MEASURED REACHED, not argued from the type's meaning (method note 136): a
// poison probe at each site in turn — `emitFail` when the routed predicate answers TRUE —
// fires on this file for all 7. It is OUTPUT-load-bearing for 3 of them: making
// `internShapeDeep` / `forceCloResultMapTypes` / `forceCloResultListTypes` decline
// unconditionally FAILS this file (and 41 / 2 / 6 corpus files respectively). The other four
// are reached and answer-invariant on every program measured — `cloArrSlotRetName`,
// `rlCanonLitUnionAtoms` and `unionRetOfFnType` produce a value that DIFFERS from declining
// on 19 / 23 / 28 corpus files and none of those differences reaches the emitted bytes, and
// `rlElemCloSigKey`'s fall-through answers `""` on both files that reach it. Those cells pin
// the reach; they do not pin an output, and that is said out loud rather than implied.
//
// SPAN home (first char `(`, last char `)`, NO balance walk):
//   * `rlElemCloSigKey`       — the `$fnsig` key of a closure-element ref-list slot
//   * `cloArrSlotRetName`     — that slot's closure RESULT name, for `p[i]()`
//   * `rlCanonLitUnionAtoms`  — the paren-group descent of the element canonicalizer
//
// OPEN home (first char `(`, no close test — the group closes before the `=>`):
//   * `internShapeDeep`          — inline shapes buried in a function-type annotation
//   * `forceCloResultMapTypes`   — a closure-ARM result map
//   * `forceCloResultListTypes`  — a closure-ARM result list
//   * `unionRetOfFnType`         — a fn-type-annotated callee whose result is a union
//
// The two halves are separated deliberately, exactly as #1190's fixture separates them:
// `((i32) => i32)[]` and `(K0 | i32)[]` OPEN with `(` and end with `]`, so a SPAN home
// wrongly used at an OPEN site mis-sorts them; only the ELEMENT name, after the `[]` cut,
// both opens and spans. And no site here tests the CLOSE at an offset other than the last
// character — the three spellings that do (`[arrowAt - 1]`, `[length - 3]`, close-only)
// live in `emit_base`/`typecheck`, and their close test stays inline there.

type K0 = "aa" | "bb"

// ── SPAN: `rlElemCloSigKey` — an INDEXED call over an array of parenthesized function
// types casts to the ELEMENT's real functype via the slot's `$fnsig` key, which is read
// off the element name `((i32) => i32)` after its grouping parens are stripped.
function cloArrIndexedCall() {
  const fs: ((i32) => i32)[] = [(x: i32) => x + 1, (x: i32) => x * 3]
  print(fs[0](10))
  print(fs[1](10))
}

// ── SPAN: `cloArrSlotRetName` — the same slot's closure RESULT name, so `ps[i]()` binds
// the `K0 | null` litunion NICHE (an i32) instead of the softened `string | null` ref.
function cloArrNulLitUnionRet() {
  const ps: (() => K0 | null)[] = [() => "aa", () => null]
  const t0 = ps[0]()
  if t0 != null { print(t0) } else { print("none") }
  const t1 = ps[1]()
  if t1 != null { print(t1) } else { print("none") }
}

// ── SPAN: `rlCanonLitUnionAtoms` — the element `(K0 | i32)` keeps its grouping parens
// through the `[]` cut, and the canonicalizer descends INTO them to soften the litunion
// alias atom to its boxed `string` atom.
function litUnionValueUnionList() {
  const xs: (K0 | i32)[] = ["aa", 7]
  const e0 = xs[0]
  if e0 is i32 { print(e0) } else { print("atom") }
  const e1 = xs[1]
  if e1 is i32 { print(e1) } else { print("atom") }
}

// ── OPEN: `internShapeDeep` — the inline shape `{f: i32}` sits in the RESULT of a
// function-type PARAM annotation, where `internInlineShape` cannot see it.
function useShapeClo(g: (i32) => {f: i32}) {
  print(g(4).f)
}

// ── OPEN: `forceCloResultMapTypes` — the closure ARM's result map is the program's ONLY
// map mention, so nothing else forces the shared map machinery.
function useMapArm(p: (() => {[string]: f64}) | {w: i32}) {
  const t0 = p
  if t0 is () => {[string]: f64} {
    print(t0()["k"] ?? 1.5)
  } else {
    print("nomap")
  }
}

// ── OPEN: `forceCloResultListTypes` — the list dual of the map arm above, and likewise
// the program's only f32-list mention.
function useListArm(p: (() => f32[]) | {w: i32}) {
  const t0 = p
  if t0 is () => f32[] {
    print(t0()[0])
  } else {
    print("nolist")
  }
}

// ── OPEN: `unionRetOfFnType` — an Ident callee whose FUNCTION-TYPE annotation returns a
// union, so the call result narrows through the union box rather than a scalar.
function classify(n: i32): i32 | string {
  if n > 0 {
    return "pos"
  }
  return n
}
function unionRetCall(g: (i32) => i32 | string) {
  const r = g(1)
  if r is string { print(r) } else { print(r) }
}

// ── SPAN: `rlElemCloSigKey` — a closure-element ref list reached through a MAP VALUE. The
// slot's ARENA leg (`rlElemCloSigKeyAt` → the recorded `TyFunc` spine) declines for this
// stored element spelling, so the `$fnsig` key falls through to the grouping-paren strip
// of the element NAME `(() => boolean | null)` and an `annSigKey` re-parse.
function cloListThroughMap() {
  const h: {[string]: (() => boolean | null)[]} = Map()
  h["k"] = [() => (null)]
  const t0 = h["k"] ?? [() => (true)]
  const t1 = t0[0]()
  if t1 != null { print(t1) } else { print("NULL") }
}

cloArrIndexedCall()
cloArrNulLitUnionRet()
litUnionValueUnionList()
useShapeClo((x: i32) => { f: x * 2 })
useMapArm({w: 5})
useListArm({w: 6})
unionRetCall(classify)
cloListThroughMap()
