// @emit-error the reassigned function binding `k` holds functions called at more than one argument type
// A two-parameter hole-lambda seed called through an alias at one order of types and delivered at the swapped order is refused (review of #3501, `rv3501/a17_two_param_alias_call_swapped_delivery`).
function other<A, B>(a: A, b: B) { print("O"); print(a); print(b) }
function c2(f: (b: boolean, n: i32) => void) { f(false, 2) }
function main() {
  let k = (x, y) => {
    print("L"); print(x); print(y)
  }
  const flip = () => {
    k = other
  }
  const r = k
  r(1, true)
  flip()
  c2(r)
}
main()
