// @run
// @log 1.5
// @log s
// @log s
// @log 4
// @log 5
// The un-annotated twin: a hole frame, its result bound, returned and computed with (D7840).
function a(v) { return v }
function b(v) { return v }
function g(x, c: boolean) {
  const fs = [if c { a } else { b }]
  const y = fs[0](x)
  print(y)
  return y
}
g(1.5, true)
print(g("s", false))
print(g(4, true) + 1)
