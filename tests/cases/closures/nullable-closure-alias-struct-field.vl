// @run
// @log 3
// @log 10
// @log q
// @log 0
// @hint redundant type annotation: `inc` is inferred as `i32`
// A struct FIELD typed as a nullable closure through a declared ALIAS (`op: F | null`) —
// `fieldTypeCode`'s kind-22 arm, the field twin of `nullable-closure-alias-global.vl`.
//
// The field code came from `nulCloFlag`, blind to an arrow-bodied alias for the reason that
// file records, so the field fell off the end of the code ladder and the whole struct was
// rejected with `emitProgram: only i32 / boolean / string / array struct fields are
// supported`. The field sits between an i32 and a string field so the layout is exercised,
// not just the classification.

type F = (i32) => i32

type S = { a: i32, op: F | null, z: string }

function inc(a: i32): i32 { a + 1 }

function go() {
  const s: S = { a: 3, op: inc, z: "q" }
  print(s.a)
  if s.op is (i32) => i32 { print(s.op(9)) } else { print(0) }
  print(s.z)

  const n: S = { a: 0, op: null, z: "" }
  if n.op != null { print(1) } else { print(0) }
}

go()
