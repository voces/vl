// @run
// @log 4
// @log 6
// @log 4
// @log 6
// @log 4
// @log 15
// A module global initialised with a list or record literal holding a list of functions, then
// reassigned from a call, holds the joined set of its literal and of what the call returns.
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function sq(a) { return a * a }
function pick(b) {
  const a = [{ fs: [inc0] }]
  if b { return a }
  return [{ fs: [dbl] }]
}
let g = [{ fs: [dbl] }]
g = pick(true)
print(g[0].fs[0](3))
function mk() { return [{ fs: [dbl] }] }
let h = [{ fs: [dbl] }]
h = mk()
print(h[0].fs[0](3))
function mkr() { return { fs: [inc0] } }
let r = { fs: [dbl] }
r = mkr()
print(r.fs[0](3))
function mkl() { return [{ fs: [inc0] }] }
let k = [{ fs: [dbl] }]
for i in [0, 1] {
  print(k[0].fs[0](3))
  k = mkl()
}
function mk2() { return [{ fs: [inc0, sq] }] }
let w = [{ fs: [dbl] }]
w = mk2()
w[0].fs[0] = dbl
print(w[0].fs[0](3) + w[0].fs[1](3))
