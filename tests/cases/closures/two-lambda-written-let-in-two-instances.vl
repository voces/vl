// @run
// @log S
// @log 3
// @log S
// @log s
// @log T
// @log 4
// @log T
// @log t
// @log V
// @log 5
// @log V
// @log u
// A `let` bound to one hole lambda and written with another inside a generic called at two
// types runs at each instance's type, called directly, through a list element or through a
// record field (D7281, D7282).
function inList<T>(x: T) {
  let k = (n) => {
    print("R"); print(n)
  }
  k = (n) => {
    print("S"); print(n)
  }
  const fs = [k]
  fs[0](x)
}
function direct<T>(x: T) {
  let k = (n) => {
    print("R"); print(n)
  }
  k = (n) => {
    print("T"); print(n)
  }
  k(x)
}
function inRecord<T>(x: T) {
  let k = (n) => {
    print("R"); print(n)
  }
  k = (n) => {
    print("V"); print(n)
  }
  const o = { f: k }
  o.f(x)
}
inList(3)
inList("s")
direct(4)
direct("t")
inRecord(5)
inRecord("u")
