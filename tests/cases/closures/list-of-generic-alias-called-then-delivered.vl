// @run
// @log I
// @log 3
// @log I
// @log true
// A list of an alias of a generic called through its element at `i32` holds the `i32` instance, while the alias delivered at `boolean` is its own instance (D3977, `rv3501/round2/q05j`).
function inner<U>(u: U) { print("I"); print(u) }
function cb(f: (b: boolean) => void, b: boolean) { f(b) }
function main() {
  const r = inner
  const fs = [r]
  fs[0](3)
  cb(r, true)
}
main()
