// @run
// @log true
// @log true
// @log true
// @warning Unused variable `dA`
// @warning Unused variable `h`
// A hole function's parameter keyed at a wider record's row (a later view at `J`), captured by a
// closure: the capture is read at the row its slot stores, and that read reaches another hole
// function's parameter, a nested function's call, and a field test (D17578).
type J = { f: i32 | null }
function mk2() { return { f: null } }
const dA: J = mk2()
function takeAny(x) { return x.f == null }
function viaArg(y) {
  const b = () => takeAny(y)
  const h = { w: y }
  return b()
}
function viaNested(y) {
  function inner() { return takeAny(y) }
  const h = { w: y }
  return inner()
}
function viaField(y) {
  const b = () => y.f == null
  const h = { w: y }
  return b()
}
print(viaArg(mk2()))
print(viaNested(mk2()))
print(viaField(mk2()))
