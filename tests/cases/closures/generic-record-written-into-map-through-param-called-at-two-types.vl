// @run
// @log 2
// @log s
// @log 3
// @log t
// A record holding a generic, written into an un-annotated map by a helper the map is handed to,
// read back and called at two types: the helper's literal and the caller's own are built at the
// map's record, so both land in it (D15493's one-generic face).
function id<T>(x: T): T { x }
function fill(mm) { mm["k"] = { f: id } }
const a = Map()
fill(a)
const ar = a["k"]
if ar != null {
  print(ar.f(2))
  print(ar.f("s"))
}
const b = Map()
b["k"] = { f: id }
fill(b)
const br = b["k"]
if br != null {
  print(br.f(3))
  print(br.f("t"))
}
