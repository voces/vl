// @run
// @log true
// @log 3
// @log none
// @log false
// @log 7
// @log true
// @log 9
// @log true
// @log 5
// Q58 position sweep: a closure of the one closure struct, delivered plainly into a slot that
// holds a closure or `null`, where the slot's closure names another signature of that struct (a
// `boolean` result beside an `i32` one, beside a record whose field returns `i32`, both read through a hole function): a record
// field and a generic's argument, in the start body and in a function.
type R = { v: i32, f: (() => boolean) | null }
function call(r: R) {
  if r.v < 0 { print("negative") }
  if r.f != null { print(r.f()) } else { print("none") }
}
function ap<T>(f: (() => T) | null, d: T): T {
  if f != null { return f() }
  return d
}
const y: R = { v: 2, f: () => true }
call(y)
print(ap(() => 3, 0))
call({ v: 1, f: null })
function inFn(k: i32) {
  const z: R = { v: k, f: () => k > 9 }
  call(z)
  print(ap(() => k, 0))
  print(ap(() => true, false))
  print(ap(null, 9))
}
inFn(7)
function onField(z) {
  if z.f != null { print(z.f()) }
}
onField(y)
type W = { v: i32, f: (() => i32) | null }
const w: W = { v: 5, f: () => 5 }
onField(w)
