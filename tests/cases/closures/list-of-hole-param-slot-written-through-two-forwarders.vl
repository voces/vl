// @run
// @log 1
// @log 5
// @log 1
// @log 5
// A list joining two hole parameters, reached through a chain of forwarders, binds at the union
// of what every call hands it (D15579).
function id<T>(x: T): T { x }
function id2<U>(x: U): U { x }
function id3<W>(x: W): W { x }
function use(ys) { print(ys.length) }
function take(a, b) {
  const xs = [a]
  xs[0] = b
  use(xs)
  print(xs[0]("abc").length + xs[0](2))
}
function fwd(f) { take(f, id2) }
function fwd2(g) { fwd(g) }
function fwd3(h) { fwd2(h) }
fwd2(id)
fwd3(id3)
