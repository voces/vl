// @run
// @log d
// @log 2
// @hint redundant type annotation: `mk` is inferred as `i32[]`
// A call through a function parameter that a lambda argument bakes into a direct call answers
// the parameter's result type: a nullable literal union widened at the return (D3209), and an
// `__array_new__` fill (D3548).
function wide(f: () => "c" | "d" | null): string | null { return f() }
print(wide(() => "d") ?? "n")

function mk(xs: i32[], f: (i32) => i32): i32[] {
  const out = __array_new__(xs.length, f(xs[0]))
  out
}
print(mk([1, 2, 3], (v: i32) => v * 2)[2])
