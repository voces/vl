// @run
// @log B
// @log r
// @log B
// @log q
// @log B
// @log 3
// @log B
// @log p
// @info `y` is never reassigned; use `const` instead of `let`
// @hint redundant type annotation: `t` is inferred as `S | null`
// A written `let` of generics called with a nullable string literal union and, through a copy,
// with a nullable `string` runs each at its own instance, as a call at `i32 | null` and a call
// result delivered into an annotated nullable binding do (D5170).
function gA<U>(u: U): U {
  print("A")
  u
}
function gB<V>(v: V): V {
  print("B")
  v
}
type S = "p" | "q"
const a: S | null = "q"
const b: string | null = "r"
let x = gA
x = gB
let y = x
print(y(b) ?? "-")
print(x(a) ?? "-")
function inner() {
  const n: i32 | null = 3
  const p: S | null = "p"
  let f = gA
  f = gB
  print(f(n) ?? 0)
  const t: S | null = f(p)
  print(t ?? "-")
}
inner()
