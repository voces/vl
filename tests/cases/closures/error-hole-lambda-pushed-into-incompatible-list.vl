// @error cannot assign (_) => _ to (string) => string
// A hole lambda pushed into a list of functions takes the element's type, as an element store
// `fs[0] = tw` does, so a body that cannot (`y * 3` over a `string`) is refused at the push
// rather than lowered at the hole's default (D3867).
const tw = (y) => y * 3
const fs: ((y: string) => string)[] = []
fs.push(tw)
print(fs.length)
