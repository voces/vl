// @run
// @log 1
// @log z
// @hint redundant type annotation: `outer` is inferred as `i32`
// @hint redundant type annotation: `arm` is inferred as `string`
// A closure writing a local whose annotation is a COMPOSITE type (D2285). The capture box
// turns `let u: T` into a length-1 list, and a composite `T` is spelled `(T)[]`: a bare
// `T + "[]"` would bind to the last atom (`i32 | string[]`). This pinned an emit refusal.
function outer(): i32 {
  let u: i32 | string = 1
  const f = () => {
    u = "z"
  }
  f()
  if u is string { 1 } else { 0 }
}
print(outer())

function arm(): string {
  let u: i32 | string = 1
  const f = () => {
    u = "z"
  }
  f()
  if u is string { u } else { "int" }
}
print(arm())
