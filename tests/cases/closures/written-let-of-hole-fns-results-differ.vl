// @run
// @log 1.5
// A re-pointed `let` of un-annotated functions called at `i32` dispatches on the one it holds,
// so a write of one giving another result there runs (D9003's trap, now D16064).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
let f = inc0
if [1].length > 0 { f = half }
print(f(3))
