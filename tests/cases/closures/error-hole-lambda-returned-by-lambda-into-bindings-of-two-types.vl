// @run
// @log 4
// @log q
// A `const`-bound lambda returning one hole lambda into destinations of two function types runs
// like its named twin (`error-hole-lambda-returned-into-bindings-of-two-types.vl`): each call is
// its own maker instance (D12234). The file keeps its name from when this was refused (D16070).
const h = (u) => {
  return u
}
const deliver = () => {
  return h
}
const v: (n: i32) => i32 = deliver()
const w: (n: string) => string = deliver()
print(v(3) + 1)
print(w("q"))
