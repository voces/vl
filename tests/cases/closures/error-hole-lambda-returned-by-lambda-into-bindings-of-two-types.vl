// @emit-error `deliver` returns one function value and its calls deliver it at two function types
// A hole lambda returned by a `const`-bound lambda into destinations of two function types is
// refused like its named twin (`error-hole-lambda-returned-into-bindings-of-two-types.vl`), and
// the sentence names the binding. It used to pass check and trap on an indirect call (D16070).
const h = (u) => {
  return u
}
const deliver = () => {
  return h
}
const v: (n: i32) => i32 = deliver()
const w: (n: string) => string = deliver()
print(v(3) + 1)
print(w("q"))
