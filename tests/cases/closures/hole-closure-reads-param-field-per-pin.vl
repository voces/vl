// @run
// @log true
// @log 3
// @log false
// @log null
// @log true
// D2864: a closure in a hole-parameter function that returns a field of the parameter reads
// the field at each instance's own pin, whether its result is printed or bound.
function R(o) {
  const c = () => o.f
  print(c())
}
R({ f: true })
R({ f: 3 })
function B(o) {
  const c = () => o.f
  const t = c()
  print(t)
}
B({ f: false })
const nb: { f: boolean | null } = { f: null }
R(nb)
const tb: { f: boolean | null } = { f: true }
R(tb)
