// @run
// @log 4
// @log 4
// @log 6
// @hint Intentionally-unused parameter `_n`
// A returned `let` list of un-annotated functions, written whole before the return, unconditionally
// or in a branch, is handed to an un-annotated parameter that calls an element (D9764).
function inc(a) { return a + 1 }
function dbl(a) { return a * 2 }
function deliver(_n) {
  let u = [inc, dbl]
  u = [dbl, inc]
  return u
}
function take(a) { print(a[1](3)) }
take(deliver(1))
function deliverIf(n) {
  let u = [inc, dbl]
  if n > 0 { u = [dbl, inc] }
  return u
}
take(deliverIf(1))
take(deliverIf(0))
