// @run
// @log 4
// @log 1.5
// @log 4
// A record `if` of functions returning different types, bound first, then handed to a
// module-scope `const` lambda's un-annotated parameter, runs as the named function's does
// (D15775): each arm taken, and beside another parameter.
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function two() { [1, 2].length }
const take = (r) => r.f(3)
const q = if two() > 5 { { f: half } } else { { f: inc0 } }
print(take(q))
const p = if two() < 5 { { f: half } } else { { f: inc0 } }
print(take(p))
const take2 = (n, r) => r.f(n)
print(take2(3, q))
