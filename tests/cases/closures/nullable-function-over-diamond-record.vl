// @run
// @log 6
// @log -1
// @log 7
// @log true
// @log 4
// @log 13
// @hint redundant type annotation: `apply` is inferred as `i32`
// @hint redundant type annotation: `either` is inferred as `i32`
// A nullable function type and a function-or-string union over a diamond-shaped record, as a
// parameter and as a result, called with a lambda and with null (D9743).
type A0 = {x: i32}
type A1 = {l: A0, r: A0}
type A2 = {l: A1, r: A1}
type A3 = {l: A2, r: A2}
type A4 = {l: A3, r: A3}
type A5 = {l: A4, r: A4}
type A6 = {l: A5, r: A5}
type A7 = {l: A6, r: A6}
type A8 = {l: A7, r: A7}
type A9 = {l: A8, r: A8}
type A10 = {l: A9, r: A9}
type A11 = {l: A10, r: A10}
type A12 = {l: A11, r: A11}

function apply(f: ((x: A12) => i32) | null, a: A12): i32 {
  if f != null { return f(a) }
  -1
}

function pick(n: i32): ((x: A12) => i32) | null {
  if n > 0 { return (a: A12) => a.l.r.l.r.l.r.l.r.l.r.l.r.x + n }
  null
}

function either(f: ((x: A12) => i32) | string, a: A12): i32 {
  if f is string { return f.length }
  f(a)
}

const a0: A0 = { x: 3 }
const a1: A1 = { l: a0, r: a0 }
const a2: A2 = { l: a1, r: a1 }
const a3: A3 = { l: a2, r: a2 }
const a4: A4 = { l: a3, r: a3 }
const a5: A5 = { l: a4, r: a4 }
const a6: A6 = { l: a5, r: a5 }
const a7: A7 = { l: a6, r: a6 }
const a8: A8 = { l: a7, r: a7 }
const a9: A9 = { l: a8, r: a8 }
const a10: A10 = { l: a9, r: a9 }
const a11: A11 = { l: a10, r: a10 }
const a12: A12 = { l: a11, r: a11 }

print(apply((a: A12) => a.l.l.l.l.l.l.l.l.l.l.l.l.x * 2, a12))
print(apply(null, a12))
print(apply(pick(4), a12))
print(pick(0) == null)
print(either("four", a12))
print(either((a: A12) => a.r.r.r.r.r.r.r.r.r.r.r.r.x + 10, a12))
