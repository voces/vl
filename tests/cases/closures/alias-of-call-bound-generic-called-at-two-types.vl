// @run
// @log mk
// @log 2
// @log abc
// @log mk
// @log 3
// @log de
// A `const` alias of a `const` bound to a call returning a generic is called at each type, and
// the call runs once; the `const` called directly is the control (D9593).
function id<T>(x: T): T { x }
function mk() {
  print("mk")
  return id
}
const v = mk()
const w = v
print(w(2))
print(w("abc"))
const u = mk()
print(u(3))
print(u("de"))
