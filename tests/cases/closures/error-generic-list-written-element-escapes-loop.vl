// @error push: cannot add (i32) => i32 to ((string) => string)[]
// A list of a generic function written with a fixed-type function still refuses a call that
// reaches the written element at another type, through a loop over the list (D10020).
function id<T>(x: T): T { x }
function inc(x: i32): i32 { x + 1 }
const ys = [id]
ys.push(inc)
for g in ys { print(g("s")) }
