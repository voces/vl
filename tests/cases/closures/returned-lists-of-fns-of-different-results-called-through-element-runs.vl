// @run
// @log 4
// @log 1.5
// @log 1.5
// @log 1.5
// @log 1.5
// @log 1.5
// @log 1.5
// A function returning lists of un-annotated functions of different results returns the join of
// their sets, so a call through an element runs the member it holds (D15227): through either
// return, a loop, a hole parameter, a value `if`, a nested list and a record's list field.
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function pick(b: boolean) {
  if b { return [inc0] }
  return [half]
}
function nest(b: boolean) {
  if b { return [[inc0]] }
  return [[half]]
}
function held(b: boolean) {
  if b { return { fs: [inc0] } }
  return { fs: [half] }
}
function run(xs) { print(xs[0](3)) }
print(pick(true)[0](3))
print(pick(false)[0](3))
for f in pick(false) { print(f(3)) }
run(pick(false))
const b = false
const fs = if b { [inc0] } else { [half] }
print(fs[0](3))
print(nest(false)[0][0](3))
print(held(false).fs[0](3))
