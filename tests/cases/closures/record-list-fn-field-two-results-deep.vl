// @run
// @log 4
// @log 1.5
// @log 4
// @log 1.5
// @log 4
// @log 1.5
// A bound list of records whose function field, four, five and six records deep, holds
// un-annotated functions returning different types: each element is read through the set's id
// at every depth, as at three (D16730).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const x4 = [
  { a: { b: { c: { d: { f: inc0 } } } } },
  { a: { b: { c: { d: { f: half } } } } },
]
print(x4[0].a.b.c.d.f(3))
print(x4[1].a.b.c.d.f(3))
const x5 = [
  { a: { b: { c: { d: { e: { f: inc0 } } } } } },
  { a: { b: { c: { d: { e: { f: half } } } } } },
]
print(x5[0].a.b.c.d.e.f(3))
print(x5[1].a.b.c.d.e.f(3))
const x6 = [
  { a: { b: { c: { d: { e: { g: { f: inc0 } } } } } } },
  { a: { b: { c: { d: { e: { g: { f: half } } } } } } },
]
print(x6[0].a.b.c.d.e.g.f(3))
print(x6[1].a.b.c.d.e.g.f(3))
