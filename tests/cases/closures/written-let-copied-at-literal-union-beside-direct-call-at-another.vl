// @run
// @log B
// @log r
// @log B
// @log q
// @log B
// @log p
// A copy of a written `let` called at one literal union, while the generic it holds is called
// directly at another: each instance spells its own union's members, at the call and through a
// delivery into an annotated parameter (D4893).
function gA<U>(u: U) {
  print("A")
  print(u)
}
function gB<V>(v: V) {
  print("B")
  print(v)
}
function gC<W>(w: W) {
  print("C")
  print(w)
}
type S = "p" | "q"
type R = "p" | "r"
function run(f: (s: S) => void) {
  const p: S = "p"
  f(p)
}
const a: S = "q"
const b: R = "r"
let x1 = gA
x1 = gB
let y = gC
y = x1
gB(b)
y(a)
run(y)
