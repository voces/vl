// @run
// @log 6
// @log 1
// @log 4
// @log 6
// @log 6
// @log 6
// @log 5
// @log 6
// @log 6
// @log 20
// A list literal of un-annotated functions returned from an un-annotated function is instanced
// at the pin its element takes in the caller, so a `.map` or `.filter` callback or a loop can
// call each element (D9410).
function inc0(a) { return a + 1 }
function dbl0(a) { return a * 2 }
function deliver0() { return [inc0, dbl0] }
const v0 = deliver0()
print(v0.map((f) => f(3))[1])

function inc1(a) { return a + 1 }
function dbl1(a) { return a * 2 }
function deliver1() { return [inc1, dbl1] }
const v1 = deliver1()
print(v1.filter((f) => f(3) > 4).length)

function inc2(a) { return a + 1 }
function dbl2(a) { return a * 2 }
function deliver2() { return [inc2, dbl2] }
const v2 = deliver2()
for f in v2 { print(f(3)) }

function inc3(a) { return a + 1 }
function dbl3(a) { return a * 2 }
function deliver3() { return [inc3, dbl3] }
function relay3() { return deliver3() }
const v3 = relay3()
print(v3.map((f) => f(3))[1])

function inc4(a) { return a + 1 }
function dbl4(a) { return a * 2 }
function deliver4() {
  const fs = [inc4, dbl4]
  return fs
}
const v4 = deliver4()
print(v4.map((f) => f(3))[1])

function id5<T>(a: T): T { return a }
function dbl5(a) { return a * 2 }
function deliver5() { return [id5, dbl5] }
const v5 = deliver5()
print(v5.map((f) => f(5))[0])

function inc6(a) { return a + 1 }
function dbl6(a) { return a * 2 }
function deliver6() { return [inc6, dbl6] }
print(deliver6().map((f) => f(3))[1])

function inc7(a) { return a + 1 }
function dbl7(a) { return a * 2 }
function deliver7() { return [inc7, dbl7] }
function use7() {
  const v = deliver7()
  return v.map((f) => f(3))[1]
}
print(use7())

function inc8(a) { return a + 1 }
function dbl8(a) { return a * 2 }
function deliver8() { return [inc8, dbl8] }
const v8 = deliver8()
const big8 = v8.filter((f) => f(3) > 4)
print(big8[0](10))
