// @error a `((_) => _)[]` cannot be used as `((i32) => f64)[]` here: a mutable list is passed as the same storage
// A bound list of an un-annotated function is the parameter's own storage, so its function is not
// converted on the way to a wider result, as its closed-function twin is not (D16996).
function half(a) { return a + 2 }
function run(m: ((a: i32) => f64)[]) { print(m[0](3)) }
const m = [half]
run(m)
