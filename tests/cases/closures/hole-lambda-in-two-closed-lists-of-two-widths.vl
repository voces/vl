// @run
// @log 4
// @log 4
// @log 4
// @log 4
// @hint redundant type annotation: `dbl` is inferred as `f64` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// A `const` hole lambda stored in a list the checker closes at `(f64) => f64` and in a list of its
// own default width is built at each list's element type, so each call reads the build it holds.
function dbl(a: f64): f64 { return a * 2.0 }
const g = (a) => a + 1
const xs = [g, dbl]
function walk(ys) { const v = ys[0]; print(v(3)) }
walk(xs)
const one = [g]
walk(one)
// A record beside the lists holds the hole lambda at its own field's width.
const r = { f: g, h: dbl }
function wr(o) { print(o.f(3)) }
wr(r)
walk(xs)
