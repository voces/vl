// Two bindings of one function's returned record, one written another function: the unwritten
// one's field holds both too, so either is called at two types. Top level, the other binding in
// another function, the write in another function, both written, and a `const` copy (D15273).
function id0(a) { return a }
function id1(a) { return a }
function id2(a) { return a }
function id3(a) { return a }
function id4(a) { return a }
function mkA() { return { f: id1 } }
const r = mkA()
r.f = id0
const s = mkA()
print(r.f(2))
print(r.f(2.5))
print(s.f(7))
print(s.f(3))
print(s.f("x"))
function mkB() { return { f: id1 } }
const rb = mkB()
rb.f = id0
print(rb.f(4))
print(rb.f(4.5))
function other() {
  const sb = mkB()
  print(sb.f(8))
}
other()
function mkC() { return { f: id1 } }
function writer() {
  const rc = mkC()
  rc.f = id0
  print(rc.f(5))
  print(rc.f(5.5))
}
writer()
const sc = mkC()
print(sc.f(9))
print(sc.f(9.5))
function mkD() { return { f: id2 } }
const rd = mkD()
rd.f = id3
const sd = mkD()
sd.f = id4
print(rd.f(6))
print(sd.f(6.5))
function mkE() { return { f: id1 } }
const re = mkE()
re.f = id0
const se = mkE()
const al = se
print(re.f(1))
print(al.f(1.5))
