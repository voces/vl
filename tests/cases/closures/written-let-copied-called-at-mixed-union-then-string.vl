// @run
// @log B
// @log 1
// @log B
// @log z
// A union of a string literal and a number holds a `string` in its box, so a copy called with it
// and the binding called with a `string` share the union's instance (D4244).
function gA<U>(u: U) {
  print("A")
  print(u)
}
function gB<V>(v: V) {
  print("B")
  print(v)
}
function gC<W>(w: W) {
  print("C")
  print(w)
}
type M = "p" | 1
const m: M = 1
const s: string = "z"
let x = gA
x = gB
let y = gC
y = x
y(m)
x(s)
