// @run
// @log O
// @log 1
// @log T
// @log s
// A capture cell in a generic body, written with two generics by two closures, is built at two instances of different representations (D3939, D3957, `rv3498/v05`).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function third<Z>(z: Z) { print("T"); print(z) }
function a<T>(x: T, w: i32) {
  let k = inner
  const toO = () => {
    k = other
  }
  const toT = () => {
    k = third
  }
  if w == 1 { toO() }
  if w == 2 { toT() }
  k(x)
}
a(1, 1)
a("s", 2)
