// @run
// @warning shadows the `k` declared
// @log L
// @log 2
// @log A
// @log 7
// @log 0
// @log L
// @log 2
// @log B
// @log true
// @log 0
// An alias of a capturing nested generic, beside an inner block's own binding of its name, is
// called through at each instance of the enclosing generic with that instance's captures (D3906).
function call(f: (n: i32) => void, n: i32) { f(n) }
function outer<T>(x: T, tag: string) {
  function inner<U>(u: U) { print(tag); print(x); print(u) }
  const k = inner
  if true {
    const k = (n: i32) => {
      print("L"); print(n)
    }
    call(k, 2)
  }
  k(0)
}
outer(7, "A")
outer(true, "B")
