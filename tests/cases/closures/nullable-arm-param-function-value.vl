// @run
// @hint redundant type annotation: `app` is inferred as `i32` — remove it to lean on inference
// @log -1
// @log 7
// @log 7
// @log -1
// @log 7
// @log -1
// @log 7
// @log -1
// @log true
// D3074: a function value whose parameter is `Circle | null`, with `Circle` a union arm, has a
// signature, at a value-bound lambda, a record field, a list element, a generic and a returned
// lambda, given a `null`, an object literal, a list element, a walk variable and a value
// narrowed out of a wider box.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
const f = (w: Circle | null): i32 => if w == null { 0 - 1 } else { w.r }
print(f(null))
print(f({ r: 7 }))
const o: { g: (Circle | null) => i32 } = {
  g: (w) => if w == null { 0 - 1 } else { w.r },
}
const z: (Circle | null)[] = [{ r: 7 }, null]
print(o.g(z[0]))
const fs: ((Circle | null) => i32)[] = [f]
print(fs[0](z[1]))
function app<A>(x: A, h: (A) => i32): i32 { return h(x) }
for e in z { print(app<Circle | null>(e, f)) }
function mk(): (Circle | null) => i32 {
  return (w) => if w == null { 0 - 1 } else { w.r }
}
const zz: (Circle | null | string)[] = [{ r: 7 }, null, "x"]
for e in zz {
  if !(e is string) { print(mk()(e)) }
}
const h = (w: Circle | null) => w == null
print(h(null))
