// @error cannot write 'lenOf' to 'f': called at (string) it returns i32
// A re-pointed `let` of un-annotated functions whose results differ, called at a caller's
// un-annotated parameter, is judged at the caller's pin and refused at the write (D13782).
function twice(s) { return s + s }
function lenOf(s) { return s.length }
function bad(z) {
  let f = twice
  if z.length > 5 { f = lenOf }
  print(f(z))
}
bad("ab")
