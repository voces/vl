// @run
// @log 4.5
// @log 5
// @log 6
// @log s
// @log 4.5
// @log 5
// @log 6 3.5
// @log 7
// @log 2.5
// @log 3
// @log 4
// @log 2.5
// A returned bundle's record held by a `const` in a generic function's body: each instance
// takes the member its own use calls, or keeps the record for calls at both signatures.
function lap(f) {
  print(f(2.5))
  print(f(3))
  return f
}
function one<T>(x: T, k: i32) {
  const r = lap((a) => a + k)
  print(r(4))
  print(x)
}
function both<T>(x: T, k: i32) {
  const r = lap((a) => a + k)
  print("\{r(4)} \{r(1.5)}")
  print(x)
}
one("s", 2)
both(7, 2)
one(2.5, 0)
