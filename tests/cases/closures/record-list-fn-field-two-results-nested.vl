// @run
// @log 5.5
// @log 5.5
// @log 5.5
// @log 1.5
// @log 1.5
// @log 1.5
// @log 10
// A bound list whose elements hold records nested in them, whose function field holds
// un-annotated functions returning different types: a call through the field runs the member
// stored there. Indexed at run time, three levels deep, walked, an element bound out, the inner
// record bound out, a record pushed, and a mixed record (D15805).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function two() { [1, 2].length }
const rs = [{ r: { f: inc0 } }, { r: { f: half } }]
let acc = 0.0
let i = 0
while i < two() {
  acc = acc + rs[i].r.f(3)
  i = i + 1
}
print(acc)
const ds = [{ r: { s: { f: inc0 } } }, { r: { s: { f: half } } }]
print(ds[two() - 1].r.s.f(3) + ds[two() - 2].r.s.f(3))
let acc2 = 0.0
for e in rs { acc2 = acc2 + e.r.f(3) }
print(acc2)
const e1 = rs[two() - 1]
print(e1.r.f(3))
const inr = rs[two() - 1].r
print(inr.f(3))
const ps = [{ r: { f: inc0 } }]
ps.push({ r: { f: half } })
print(ps[two() - 1].r.f(3))
const ms = [
  { n: 1, r: { f: inc0, g: half } },
  { n: 2, r: { f: half, g: inc0 } },
]
print(ms[0].r.f(3) + ms[1].r.g(3) + ms[two() - 1].n)
