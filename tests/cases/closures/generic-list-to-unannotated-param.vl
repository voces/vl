// @run
// @log 2
// @log 2
// @log s
// @log 2
// @log 2
// @log 4
// @log 4
// @log z
// @log 2
// A literal of generics passed to an un-annotated parameter is read as the generic it holds,
// at each call's own type, through a second call and through a record field (D4577).
function id<T>(x: T): T { x }
function use(v) { print(v[0](2)) }
use([id])
function both(v) {
  print(v[0](2))
  print(v[0]("s"))
}
both([id])
function inner(w) { print(w[0](2)) }
function outer(v) { inner(v) }
outer([id])
function rec(r) { print(r.f(2)) }
rec({ f: id })
function len(v) {
  const n = v.length
  print(v[0](3) + n)
}
len([id])
function at(v, k) { print(v[0](k)) }
at([id], 4)
at([id], "z")
function guard(v) {
  if v == null { print(0) } else { print(v[0](2)) }
}
guard([id])
