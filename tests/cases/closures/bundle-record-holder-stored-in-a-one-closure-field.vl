// @run
// @log 5
// @log 2.5
// @log 5 2.5
// @log 5
// @log 8
// @log 6
// @hint Intentionally-unused variable `_a`
// @hint Intentionally-unused variable `_b`
// A `const` holding a returned record of one closure per signature, stored into a field called
// at one signature only: the field holds one closure, and the store takes the record's member of
// that closure's type.
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
const u = lap((a) => a + 1)
const w = { f: u }
print(w.f(4))
const p = lap((a) => a + 1)
const q = { f: p }
print(q.f(1.5))
const r = lap((a) => a + 1)
print("\{r(4)} \{r(1.5)}")
const s = { f: r }
print(s.f(4))
const t = lap((a) => a + 1)
const o = { f: t, g: 3 }
print(o.f(4) + o.g)
function run(k: i32) {
  const h = lap((a) => a + k)
  const x = { f: h }
  print(x.f(4))
}
run(2)
