// @run
// @log 1
// @log 2
// @log 3
// @log 4
// @log 5
// @log 6
// @log 7
// @log 8
// @hint redundant type annotation: `held` is inferred as `i32 | null`
// A CAPTURED PROJECTION AT THE REPS D1476's CLOSE DID NOT REACH (D1758).
//
// A binding whose initialiser is a projection commits no rep the syntactic ladder reads, so
// the capture fell to the i32 default and the closure's env field declared an i32 where a box,
// a niche or a map arrives. D1476 built the pair for the STRUCT rep; the arena rung here is
// `vtKindOfType`'s own first leg asked of the initialiser, so every other rep answers from the
// same derivation the annotated face uses.
//
// Each line prints its own number, so a capture reading a neighbouring env field is a wrong
// value rather than a pass. The scopes differ on purpose: the index face refused in a function
// body and the field face only inside a module-level block, and both are here.
type MaybeN = i32 | null
type Circle = { r: i32 }
type Rect = { w: i32 }
type Shape = Circle | Rect
type VU = i32 | string
type Rec = { n: i32 }
type BoxedMap = { it: { [string]: Rec } }
type BoxedShape = { it: Shape }

function mkNul(n: i32): MaybeN { return n }
function mkShape(n: i32): Shape { return { r: n } }
function mkVU(n: i32): VU { return n }
function mkMap(n: i32): { [string]: Rec } {
  const m: { [string]: Rec } = Map()
  m["k"] = { n: n }
  return m
}
function mkBoxMap(n: i32): BoxedMap { return { it: mkMap(n) } }
function mkBoxShape(n: i32): BoxedShape { return { it: mkShape(n) } }

function nulInFn() {
  const xs = [mkNul(1)]
  const held = xs[0]
  const get = () => held
  print(get() ?? 0)
}
function unionInFnWhile() {
  let i = 0
  while i < 1 {
    const xs = [mkShape(2)]
    const held = xs[0]
    const get = () => held
    const v = get()
    if v is Circle { print(v.r) } else { print(0) }
    i = i + 1
  }
}
function valueUnionInFnBlock() {
  if true {
    const xs = [mkVU(3)]
    const held = xs[0]
    const get = () => held
    const v = get()
    if v is i32 { print(v) } else { print(0) }
  }
}
nulInFn()
unionInFnWhile()
valueUnionInFnBlock()

// The same three at a module-level BLOCK, the scope the field face needs.
if true {
  const xs4 = [mkNul(4)]
  const held4 = xs4[0]
  const get4 = () => held4
  print(get4() ?? 0)
}
if true {
  const box5 = mkBoxShape(5)
  const held5 = box5.it
  const get5 = () => held5
  const v5 = get5()
  if v5 is Circle { print(v5.r) } else { print(0) }
}
if true {
  const box6 = mkBoxMap(6)
  const held6 = box6.it
  const get6 = () => held6
  print((get6()["k"] ?? { n: 0 }).n)
}
let j = 0
while j < 1 {
  const xs7 = [mkVU(7)]
  const held7 = xs7[0]
  const get7 = () => held7
  const v7 = get7()
  if v7 is i32 { print(v7) } else { print(0) }
  j = j + 1
}

// The annotated binding, which fixed every line above before this row and must keep running.
function annotatedStillRuns() {
  const xs = [mkNul(8)]
  const held: MaybeN = xs[0]
  const get = () => held
  print(get() ?? 0)
}
annotatedStillRuns()
