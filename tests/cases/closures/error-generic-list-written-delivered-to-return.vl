// @error push: cannot add (i32) => i32 to ((string) => string)[] (written into `ys`, delivered at (string) => string)
// A written element of a list of a generic function, returned where the return type fixes
// the generic's type variable to one the written value does not fit, refuses (D10080).
function id<T>(x: T): T { x }
function inc(x: i32): i32 { x + 1 }
const ys = [id]
ys.push(inc)
function get(): (x: string) => string { ys[1] }
print(get()("s"))
