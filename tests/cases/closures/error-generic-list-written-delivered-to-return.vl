// @error expected (string) => string, got (i32) => i32
// A written element of a list of a generic function, returned where the return type fixes
// the generic's type variable to one the written value does not fit, refuses (D10080).
function id<T>(x: T): T { return x }
function inc(x: i32): i32 { return x + 1 }
const ys = [id]
ys.push(inc)
function get(): (x: string) => string { return ys[1] }
print(get()("s"))
