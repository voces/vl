// @run
// @log a
// @log 3
// @log b
// @log 3
// @log 3
// An un-annotated list whose element is an `if` choosing between generic functions takes the one
// type the calls through its element give it, as an annotation would (D7380).
function a<V>(v: V) { print("a"); print(v) }
function b<V>(v: V) { print("b"); print(v) }
function choose(c: boolean) {
  const fs = [if c { a } else { b }]
  fs[0](3)
}
choose(true)
choose(false)
function id<V>(v: V): V { return v }
const c = 1 > 0
const gs = [if c { id } else { id }]
print(gs[0](2) + 1)
