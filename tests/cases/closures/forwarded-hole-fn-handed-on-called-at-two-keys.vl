// @run
// @log 30
// @log 2
// @log 7
// @log 2.5
// A hole function handed on by a function that only forwards it, to a parameter called at two
// argument types, is instanced at each call's own types through the forward (D6210).
function add(a, b) { return a + b }
function apply3(g, s) {
  print(g(10, 20))
  print(g(s, 1.5))
}
function inner(k, h) { apply3(h, k) }
inner(0.5, add)
function both(g, s) {
  print(g(3, 4))
  print(g(s, 2.0))
}
function viaBoth(k, h) { both(h, k) }
viaBoth(0.5, add)
