// @run
// @info `lap3` is never reassigned; use `const` instead of `let`
// @hint Intentionally-unused parameter `_g` (leading `_` marks it unused)
// @log 7
// @log 2
// @log 7
// @log 7
// @log 5
// @log 2
// A hole function handed through a `const` alias of a `let`, written or not, to a parameter
// the callee calls at one type runs as the `let` itself does (D6480): the alias taken after
// the write, before it, through a chain, inside a function, and a written value that calls it.
function id(a) { return a }
function other(_g) { return 7 }
function apply5(g) { return g(5) }
let lap = (g) => {
  return g(1) + 1
}
const early = lap
lap = other
const k = lap
print(k(id))
print(early(id))
const k2 = k
print(k2(id))
function run() {
  let l2 = (g) => {
    return g(1) + 1
  }
  l2 = other
  const a = l2
  return a(id)
}
print(run())
let lap2 = (g) => {
  return g(1) + 1
}
lap2 = apply5
const k3 = lap2
print(k3(id))
let lap3 = (g) => {
  return g(1) + 1
}
const k4 = lap3
print(k4(id))
