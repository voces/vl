// @run
// @log 40
// @log 2
// A function whose hole parameter is handed a tagged set at one call, and that is also read as
// a closure value, keeps one instance of each: the closure instance calls through its parameter.
function apply2(g: (a: i32) => i32) { print(g(2)) }
function apply3(g) { print(g(20)) }
function dbl(x) { return x * 2 }
apply3(dbl)
const fs = [apply3, apply2]
const m = match 1 {
  _ => apply2
}
m((a: i32) => a)
