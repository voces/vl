// @run
// @log 5
// @log 2
// @log 3
// @log y!
// @log 12
// @log 6
// @log 8
// @log 7
// @log 4
// @log 7
// @log p
// @log 9
// @log 5
// @log u!
// A declared generic handed to `.map` / `.filter` takes its type parameters from the list's
// element, so `.map`'s result is a list of what its declared result is there, also inside a
// generic instance whose receiver is a `T[]` (D9004, D9070).
function idg<T>(t: T): T { return t }
function wrap<T>(t: T): T[] { return [t, t] }
function keep<T>(t: T) { return [t].length > 0 }
function fst<A, B>(a: A): A { return a }
type P = { x: i32, y: i32 }
const ys = [3, 4].map(idg)
print(ys[1] + 1)
print(ys.length)
print([1.5].map(idg)[0] * 2.0)
print(["x", "y"].map(idg)[1] + "!")
const ps: P[] = [{ x: 1, y: 2 }]
print(ps.map(idg)[0].y + 10)
print([3, 4].map(wrap)[1][0] + 2)
print([7].map(fst)[0] + 1)
print([3, 4].map(idg).map(idg)[0] + 4)
print([3, 4, 5].filter(keep).map(idg).length + 1)
function h<T>(xs: T[]): T[] { return xs.map(idg) }
print(h([5, 6])[1] + 1)
print(h(["p", "q"])[0])
function hw<T>(xs: T[]): T[][] { return xs.filter(keep).map(idg).map(wrap) }
print(hw([8])[0][1] + 1)
print(hw([2.5])[0][1] * 2.0)
print(hw(["u"])[0][0] + "!")
