// @log 35
// A written `let` that only ever holds one generic, or a `const` read of a map that holds one,
// listed or put in a record and called through it at two types, runs at each call's type; so
// does such a `let` called directly with two different callbacks (D9791, D9792, D9853).
function id<T>(x: T): T { x }
function g<T>(f: (x: T) => T, x: T): T { f(x) }
function written() {
  let v = id
  v = id
  const xs = [v]
  print(xs[0]("abc").length * 100 + xs[0](7))
}
written()
function chained() {
  let v = id
  v = id
  let u = v
  u = v
  const xs = [u]
  print(xs[0]("abc").length * 100 + xs[0](7))
}
chained()
function cycled() {
  let v = id
  let u = v
  v = u
  u = v
  const xs = [u]
  print(xs[0]("abc").length * 100 + xs[0](7))
}
cycled()
function recorded() {
  let v = id
  v = id
  const r = { f: v, n: 1 }
  print(r.f("abc").length * 100 + r.f(7) + r.n)
}
recorded()
function nested() {
  let v = id
  v = id
  const xs = [[v]]
  print(xs[0][0]("abc").length * 100 + xs[0][0](7))
}
nested()
function useList(ys) { print(ys.length) }
function handedOn() {
  let v = id
  v = id
  const xs = [v]
  useList(xs)
  print(xs[0]("abc").length * 100 + xs[0](7))
}
handedOn()
function mapRead() {
  const m = Map()
  m["k"] = id
  const mv = m["k"]
  if mv != null {
    const xs = [mv]
    print(xs[0]("abc").length * 100 + xs[0](7))
  }
}
mapRead()
function mapGet() {
  const m = Map()
  m.set("k", id)
  const mv = m.get("k")
  if mv != null {
    const xs = [mv]
    print(xs[0]("abc").length * 100 + xs[0](7))
  }
}
mapGet()
function mapRecord() {
  const m = Map()
  m["k"] = id
  const mv = m["k"]
  if mv != null {
    const r = { f: mv }
    print(r.f("abc").length * 100 + r.f(7))
  }
}
mapRecord()
function mapRecordWide() {
  const m = Map()
  m["k"] = id
  const mv = m["k"]
  if mv != null {
    const r = { f: mv, n: 2 }
    print(r.f("abc").length * 100 + r.f(7) + r.n)
  }
}
mapRecordWide()
function mapAbsent() {
  const m = Map()
  m["k"] = id
  const mv = m["q"]
  if mv != null {
    const xs = [mv]
    print(xs[0]("abc").length * 100 + xs[0](7))
  } else {
    print("absent")
  }
}
mapAbsent()
function twoLambdas() {
  let v = g
  v = g
  print(v((x: i32) => x + 1, 2) * 10 + v((x: i32) => x, 5))
  print(v((s: string) => s + "!", "a") + v((s: string) => s + "?", "b"))
}
twoLambdas()
let top = g
top = g
print(top((x: i32) => x + 1, 2) * 10 + top((x: i32) => x, 5))
