// @run
// @log 8
// A call-bound `const` of a generic, listed beside the generic itself, is one set with it: the
// list holds the set's ids, and each element call reaches the instance at its own tuple (D9722).
function id<T>(x: T): T { x }
function mk() { return id }
const c = mk()
const ys = [c, id]
const s = ys[0]("abc")
print(s.length + ys[1](2) + c("ab").length + c("x").length)
