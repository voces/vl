// @run
// @log L
// @log 3
// @log L
// @log s
// A list of a `let` first bound to a generic and written with a lambda, iterated by `for`
// inside a generic called at two types, calls the loop variable at each instance's type (D7202).
function other<V>(v: V) { print("O"); print(v) }
function g<T>(x: T) {
  let k = other
  k = (n) => {
    print("L"); print(n)
  }
  const fs = [k]
  for f in fs { f(x) }
}
g(3)
g("s")
