// @emit-error the reassigned function binding `k` holds functions called at more than one argument type
// A list element called at the index spelled `00` is the element at value 0, so its call is through the cell (review of #3501, `rv3501/round3/t13_index_spelling_00`).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function cb(f: (b: boolean) => void, b: boolean) { f(b) }
function ci(f: (n: i32) => void, n: i32) { f(n) }
function q(n: i32) { print("Q"); print(n) }
function main() {
  let k = inner
  const flip = () => {
    k = other
  }
  const r = k
  const fs = [r]
  fs[00](3)
  cb(r, true)
}
main()
