// @log 4
// A record binding returned beside a record of another function set is typed at the joined set,
// so a call, a closure or a `let` reading it reads the function's result type.
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function tri(a) { return a * 3 }
function use(r) { return r.fs[0](10) }
function passed(b) {
  const c = { fs: [dbl] }
  print(use(c))
  const a = { fs: [inc0] }
  if b { return a }
  return c
}
function captured(b) {
  const c = { fs: [tri] }
  const g = () => c.fs[0](5)
  print(g())
  const a = { fs: [inc0] }
  if b { return a }
  return c
}
function lets(b) {
  let c = { fs: [dbl] }
  let a = { fs: [inc0] }
  if b { return a }
  return c
}
function sameSet(b) {
  const c = { fs: [dbl, inc0] }
  print(use(c))
  const a = { fs: [inc0, dbl] }
  if b { return a }
  return c
}
function tailArm(b) {
  const c = { fs: [dbl] }
  if b { { fs: [inc0] } } else { c }
}
function tailArmPassed(b) {
  const c = { fs: [dbl] }
  print(use(c))
  if b { { fs: [inc0] } } else { c }
}
print(passed(false).fs[0](3))
print(passed(true).fs[0](3))
print(captured(false).fs[0](3) - 3)
print(captured(true).fs[0](3))
print(lets(false).fs[0](3))
print(lets(true).fs[0](3))
print(sameSet(false).fs[0](3))
print(sameSet(true).fs[0](3))
print(tailArm(false).fs[0](3))
print(tailArm(true).fs[0](3))
print(tailArmPassed(false).fs[0](3))
print(tailArmPassed(true).fs[0](3))
