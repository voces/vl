// @run
// @log 1.5
// @log 9
// @log 1.5
// @log 9
// @log 1.5
// A call through a list of un-annotated functions with different results, made before a lambda
// is written into the list, is typed by the functions already checked, and the lambda's arm
// joins it (D17000): a bare list, a list of records, a bound lambda, and a lambda written in place.
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const xs = [inc0, half]
print(xs[1](3))
xs.push((x) => x * 3)
print(xs[2](3))
const rs = [{ f: inc0 }, { f: half }]
print(rs[1].f(3))
rs.push({ f: (x) => x * 3 })
print(rs[2].f(3))
const bs = [{ f: inc0 }, { f: half }]
print(bs[1].f(3))
const g = (x) => x * 3
bs.push({ f: g })
