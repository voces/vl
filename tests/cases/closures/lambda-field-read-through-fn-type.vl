// @run
// A lambda returning a record field is called through its declared function type, whose
// result is the non-null record: returned from a function, passed as an argument, held in a
// record field, and a named un-annotated function used as the value (D3682).
type V = { x: f64, y: f64 }
type P = { a: V, n: i32 }
type H = { f: () => V }
const p: P = { a: { x: 1.0, y: 2.0 }, n: 0 }
function getter(): () => V {
  () => p.a
}
function call(f: () => V) { f().y }
function h() { p.a }
function named(): () => V { h }
const hh: H = { f: () => p.a }
print(getter()().y)
print(call(() => p.a))
print(hh.f().x)
print(named()().y)
// @log 2
// @log 2
// @log 1
// @log 2
