// @run
// @log 1
// @log 10
// A module-scope `for` variable is in scope only inside its own loop's body: a closure written
// after the loop, or inside a named function, that calls the same spelling calls the intrinsics
// (D2010).
const xs = [3, 1, 2]
let best = 100
for min in xs {
  if min < best { best = min }
}
const clamp = (v: i32) => min(max(v, 0), 10)
print(clamp(best))
print(clamp(42))
