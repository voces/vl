// @run
// @log 3
// @log 2
// @log 3
// A function-local `const` alias of a hole function called with two functions, beside a call
// through a loop over a one-element list of it inside a hole function: a call through the alias
// calls the function it names directly (D15441, D15443).
function add(a, b) { return a + b }
function mul(a, b) { return a * b }
function apply2(g) { print(g(1, 2)) }
function m() {
  const k = apply2
  k(add)
  k(mul)
}
m()
function viaFor(h) {
  for f in [apply2] { f(h) }
}
viaFor(add)
