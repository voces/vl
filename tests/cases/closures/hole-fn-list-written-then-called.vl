// @run
// @info `a1` is never reassigned; use `const` instead of `let`
// @info `a3` is never reassigned; use `const` instead of `let`
// @info `a8` is never reassigned; use `const` instead of `let`
// @log 6
// @log 6
// @log 6
// @log 6
// @log 4
// @log 6
// @log 6
// @log 4
// @log 4
// @log 6
// @log 1
// @log 3
// @log 13
// @log 2
// @log 4
// A list of un-annotated functions that agree is a list of one function type wherever it is
// written or read: a `let` written then called, written through a parameter, re-pointed to
// another literal, a list of records called through `r.f` and `rs[i].f`, and an element called
// inside a `.map` / `.filter` callback over the list (D9094, D9140, D9093).
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function put(ys) { ys[0] = dbl }

let a1 = [inc0]
a1[0] = dbl
print(a1[0](3))

const a2 = [inc0]
put(a2)
print(a2[0](3))

let a3 = [inc0]
put(a3)
print(a3[0](3))

let a4 = [inc0]
a4 = [dbl]
print(a4[0](3))

const rs = [{ f: inc0 }, { f: dbl }]
for r in rs { print(r.f(3)) }
print(rs[1].f(3))
print(rs[0].f(3))

const a7 = [inc0]
print(a7.map((f) => f(3))[0])

let a8 = [inc0]
a8[0] = dbl
print(a8.map((f) => f(3))[0])

const a9 = [inc0, dbl]
print(a9.filter((f) => f(3) > 4).length)

const a10 = [inc0]
print([1, 2].map((n) => a10[0](n))[1])

const k = 10
const a11 = [inc0]
print(a11.map((f) => f(k) + f(1))[0])

const a12 = [inc0]
print(a12[0](1))
print(a12.map((f) => f(3))[0])
