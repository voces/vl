// @run
// @log B
// @log r
// @log B
// @log q
// Two string literal unions number their members apart, and a written `let` called at both holds
// one instance per union (D4244, D3975).
function gB<V>(v: V) {
  print("B")
  print(v)
}
type S = "p" | "q"
type R = "p" | "r"
const a: S = "q"
const b: R = "r"
let x = gB
x = gB
x(b)
x(a)
