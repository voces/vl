// @log 6
// A list literal of un-annotated functions returned from an un-annotated function and read at two
// types runs when one call is handed to an un-annotated parameter, when the two calls take two
// instances of the function, and when the two calls take one instance whose list is built from its
// parameter (D9553, D9601, D9602). The last cases are controls that ran before.
function inc0(a) { return a + 1 }
function dbl0(a) { return a * 2 }
function deliver0() { return [inc0, dbl0] }
function take0(a) { print(a.map((f) => f(3))[1]) }
take0(deliver0())
const u0 = deliver0()
print(u0.map((f) => f(1.25))[1])

function inc1(a) { return a + 1 }
function dbl1(a) { return a * 2 }
function deliver1() { return [inc1, dbl1] }
function take1(a) { print(a.map((f) => f(3))[1]) }
const u1 = deliver1()
print(u1.map((f) => f(1.25))[1])
take1(deliver1())

function inc2(a) { return a + 1 }
function dbl2(a) { return a * 2 }
function deliver2(n) { return [inc2, dbl2] }
const v2 = deliver2(1)
print(v2.map((f) => f(3))[1])
const w2 = deliver2("s")
print(w2.map((f) => f(1.5))[0])

function inc3(a) { return a + 1 }
function dbl3(a) { return a * 2 }
function deliver3(n) { return [inc3, dbl3] }
print(deliver3("s").map((f) => f(1.5))[0])
print(deliver3(1).map((f) => f(3))[1])

function inc4(a) { return a + 1 }
function dbl4(a) { return a * 2 }
function deliver4(n) { return [inc4, dbl4] }
const v4 = deliver4(1)
print(v4.map((f) => f(3))[1])
const w4 = deliver4("s")
print(w4.map((f) => f(1.5)).length)

function inc5(a) { return a + 1 }
function deliver5(g) { return [g, g] }
const v5 = deliver5(inc5)
print(v5.map((f) => f(3))[1])
const w5 = deliver5(inc5)
print(w5.map((f) => f(1.5))[0])

function inc6(a) { return a + 1 }
function deliver6(g) { return [g, g] }
print(deliver6(inc6).map((f) => f(3))[1])
print(deliver6(inc6).map((f) => f(1.5))[0])

function inc7(a) { return a + 1 }
function half7(a) { return a / 2.0 }
function deliver7(g) { return [g, g] }
const v7 = deliver7(inc7)
print(v7.map((f) => f(3))[1])
const w7 = deliver7(half7)
print(w7.map((f) => f(1.5))[0])

function id8<T>(x: T): T { return x }
function sel8(g) { return [g, g] }
const v8 = sel8(id8)
print(v8.map((f) => f(3))[1])
const w8 = sel8(id8)
print(w8.map((f) => f("x"))[0])

function id9<T>(x: T): T { return x }
function sel9(g) { return [g, g] }
print(sel9(id9).map((f) => f(3))[1])
print(sel9(id9).map((f) => f("x"))[0])

function inc10(a) { return a + 1 }
function deliver10(g) { return [g, g] }
const v10 = deliver10(inc10)
print(v10[1](3))
const w10 = deliver10(inc10)
print(w10[0](1.5))

function inc11(a) { return a + 1 }
function dbl11(a) { return a * 2 }
function deliver11() { return [inc11, dbl11] }
function take11(a) { print(a.map((f) => f(3))[1]) }
take11(deliver11())
