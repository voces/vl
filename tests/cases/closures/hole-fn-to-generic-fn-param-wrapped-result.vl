// @run
// @log 4
// @log 4
// @log 4
// @log 2.5
// @log 2
// @log 1.5
// @log 3
// @log true
// @log 3
// @log 1
// An un-annotated function handed to a generic whose result wraps the arrow's result (`U[]`,
// `U | null`, a record field) closes that result at the body's type, in every spelling (D9000).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function m<T, U>(xs: T[], k: (a: T) => U): U[] { return xs.map(k) }
function loopM<T, U>(xs: T[], k: (a: T) => U): U[] {
  const out: U[] = []
  for x in xs { out.push(k(x)) }
  return out
}
function opt<T, U>(x: T, k: (a: T) => U): U | null { return k(x) }
type Box<V> = { v: V, n: i32 }
function boxed<T, U>(x: T, k: (a: T) => U): Box<U> { return { v: k(x), n: 1 } }
const lam = (a) => a + 1
const alias = inc0
print(m([3], inc0)[0])
print(m([3], lam)[0])
print(m([3], alias)[0])
const ys = loopM([5, 4], half)
print(ys[0])
print(ys.length)
function first() { return m([3], half)[0] }
print(first())
const o = opt(2, inc0)
if o != null { print(o) }
print(o != null)
const b = boxed(2, inc0)
print(b.v)
print(b.n)
