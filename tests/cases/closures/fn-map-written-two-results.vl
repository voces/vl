// @run
// @log 1.5
// @log 4
// @log 3.5
// @log 1.5
// @log 1.5
// @log 2.5
// @log 4
// @log 6
// @log 2.5
// An un-annotated map written two functions of different result types, by `set`, by index or at
// integer keys, and a list built from `[]` pushed both: the writes join the container's set, so
// a value read by `get` or an element read by index and called runs the function stored there
// (D15137).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const m = Map()
m.set("a", inc0)
m.set("b", half)
const g = m.get("b")
if g != null { print(g(3)) }
const h = m.get("a")
if h != null { print(h(3)) }
function readLater() {
  const r = m.get("b")
  if r != null { print(r(3)) }
}
const p = m.get("a")
if p != null { print(p(2.5)) }
readLater()
const w = Map()
w["a"] = inc0
w["b"] = half
const q = w.get("b")
if q != null { print(q(3)) }
const n = Map()
n.set(1, inc0)
n.set(2, half)
const t = n.get(2)
if t != null { print(t(5)) }
const xs = []
xs.push(inc0)
xs.push(half)
print(xs[0](3))
for f in xs { print(f(5)) }
