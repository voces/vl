// @run
// @log 8
// @log 9
// A `let` of a record whose field is a list of lists of un-annotated functions, reassigned a
// record literal, holds both literals in one layout (D16806).
function inc(a) { return a + 1 }
function dbl(a) { return a * 2 }
function la() {
  let v = { xs: [[inc], [dbl]] }
  v = { xs: [[inc], [dbl]] }
  print(v.xs[1][0](3) + v.xs[0][0](1))
}
la()
let w = { xs: [[inc], [dbl]] }
w = { xs: [[dbl], [inc]] }
print(w.xs[0][0](4) + w.xs[1][0](0))
