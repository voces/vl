// @run
// @log 2
// @log s
// @log 3
// @log 3
// @log 3
// @log 3
// A list a generic is pushed into, spread into an un-annotated list, lets its element be called
// at two types; a spread of a list also written or grown with a non-generic keeps its type (D9482).
function id<T>(x: T): T { x }
function inc(x: i32) { x + 1 }
const xs = []
xs.push(id)
const ys = [...xs]
print(ys[0](2))
print(ys[0]("s"))
const ps = []
ps.push(id)
ps[0] = inc
const bs = [...ps]
print(bs[0](2))
function add(l) { l.push(inc) }
const cs = []
cs.push(id)
add(cs)
const ds = [...cs]
print(ds[1](2))
print(ds[0](3))
print(ds.length + 1)
