// @run
// @log 9
// @log 4
// @log 0.75
// @log 9
// A lambda with an annotated signature, pushed into a list of un-annotated functions, is one of the
// set a call through an element dispatches on, by the name the lift gives it (D16999).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const xs = [inc0]
xs.push((x: i32): i32 => x * 3)
print(xs[1](3))
print(xs[0](3))
const ys = [inc0, half]
ys.push((x: i32): f64 => x / 4.0)
print(ys[2](3))
const rs = [{ f: inc0 }, { f: half }]
rs.push({ f: (x: i32): i32 => x * 3 })
print(rs[2].f(3))
