// @run
// @hint redundant type annotation: `keep` is inferred as `i32`
// @log 1
// @log s
// @log 3
// A binding called at two types and delivered to a parameter of one function type passes the
// instance at the parameter's type (D3975).
function id<T>(x: T): T { return x }
function keep(g: (x: i32) => i32): i32 { return g(3) }
function main() {
  let f = id
  print(f(1))
  print(f("s"))
  print(keep(f))
  f = id
}
main()
