// @run
// @log 2
// @log false
// @warning Unused parameter `x`
// A hole lambda in a generic body returned from two instances is keyed under each, at the pins the
// call through the returned value gives it, so each instance's closure runs at its own type (D15110).
function inner<U>(u: U) { print("I"); print(u) }
function a<T>(x: T) {
  let k = inner
  k = (u) => {
    print(u)
  }
  return k
}
a(1)(2)
a(true)(false)
