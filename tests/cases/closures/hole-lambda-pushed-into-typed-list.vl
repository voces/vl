// @run
// @log aC
// @log aC
// @log 2.5
// @log aa
// @log 8
// @log aL
// @log 1
// A module-scope hole lambda pushed into, or stored as an element of, a list of functions is
// delivered at the element's type, as building the list with it is; pushed into two lists of
// two types, the name takes one instance per type (D3867).
const c = (y) => y + "C"
const cf = (y) => y + 1.5
const twice = (y) => y + y
function pushed(x: string) {
  const fs: ((y: string) => string)[] = []
  fs.push(c)
  print(fs[0](x))
}
pushed("a")
function stored(x: string) {
  const fs: ((y: string) => string)[] = [(y: string) => y]
  fs[0] = c
  print(fs[0](x))
}
stored("a")
function pushedF64(x: f64) {
  const fs: ((y: f64) => f64)[] = []
  fs.push(cf)
  print(fs[0](x))
}
pushedF64(1.0)
function twoLists(x: string, n: i32) {
  const fs: ((y: string) => string)[] = []
  const gs: ((y: i32) => i32)[] = []
  fs.push(twice)
  gs.push(twice)
  print(fs[0](x))
  print(gs[0](n))
}
twoLists("a", 4)
function local(x: string) {
  const l = (y) => y + "L"
  const fs: ((y: string) => string)[] = []
  fs.push(l)
  print(fs[0](x))
}
local("a")
const top: ((y: string) => string)[] = []
top.push(c)
print(top.length)
