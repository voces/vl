// @run
// @log 1
// @log false
// @log true
// @log 2
// @log 2
// D3071, D3072: an un-annotated lambda or parameter called with a `for` walk's variable over a
// union list pins at the element union, not at one member's rep, so its `is` sees the box.
type Circle = { r: i32 }
type Sq = { s: i32 }
const z: (i64 | string)[] = [5, "t"]
let c = 0
const f = (w) => w is i64
for e in z {
  if f(e) { c = c + 1 }
}
print(c)

function g(w) { return w is string }
for e in z { print(g(e)) }

const shapes: (Sq | Circle)[] = [{ s: 2 }, { r: 3 }, { r: 4 }]
const isC = (w) => w is Circle
let rs = 0
for sh in shapes {
  if isC(sh) { rs = rs + 1 }
}
print(rs)

function app<T>(x: T, p: (T) => boolean) { return p(x) }
const mixed: (string | i64 | boolean)[] = [5, "t", true, 6]
let n = 0
for e in mixed {
  if !(e is boolean) {
    if app(e, (w) => w is i64) { n = n + 1 }
  }
}
print(n)
