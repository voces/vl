// @run
// @log 0.5
// @log 0.5
// @log 0.5
// @log 0.5
// @log 0.5
// @log 0.5
// @log 0.5
// @log 4
// @warning Unused function `unused`
// An un-annotated lambda returned by an un-annotated function, delivered at `(a: i32) => f64`
// through that function's inferred return, converts its `i32` result to `f64` in every position:
// directly, through a second inferred return, and with an unused relay reading the maker
// (D16711). Bound un-annotated, it keeps `i32`.
function deliver() { return (a) => a + 1 }
function relay() { return deliver() }
function unused() { return deliver() }
function ap(g: (a: i32) => f64) { return g(3) }
type H = { h: (a: i32) => f64 }
const v: (a: i32) => f64 = deliver()
print(v(3) / 8.0)
print(ap(deliver()) / 8.0)
const r: H = { h: deliver() }
print(r.h(3) / 8.0)
const xs: ((a: i32) => f64)[] = [deliver()]
print(xs[0](3) / 8.0)
function ret(): (a: i32) => f64 { return deliver() }
print(ret()(3) / 8.0)
const w: (a: i32) => f64 = relay()
print(w(3) / 8.0)
let g: (a: i32) => f64 = deliver()
g = deliver()
print(g(3) / 8.0)
function plain() { return (a) => a + 1 }
const u = plain()
print(u(3))
