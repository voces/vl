// @run
// @log 6
// @log 4
// @log 6
// @log 3
// @log 5
// A `??` default that is an un-annotated or generic function, over a map read of another
// un-annotated function, is instanced at the join's function type, as an `if` arm is (D15463).
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function id<T>(x: T): T { x }
const m = Map()
m["k"] = inc0
print((m["j"] ?? dbl)(3))
print((m["k"] ?? dbl)(3))
const h = m["j"] ?? dbl
print(h(3))
print((m["j"] ?? id)(3))
const f = Map()
f["k"] = inc0
print((f["j"] ?? dbl)(2.5))
