// @error cannot store 'half' in an element of 'v.xs': called at (i32) it returns f64, where 'inc0', also stored in it, returns i32
// A module `let` re-pointed between a record whose list field was written another result type and
// one whose field was not holds two records of different field sets, D15195's shape, so a call
// through the field is refused (D15196).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const r = { xs: [inc0] }
r.xs[0] = half
const q = { xs: [inc0] }
let v = r
v = q
print(v.xs[0](3))
