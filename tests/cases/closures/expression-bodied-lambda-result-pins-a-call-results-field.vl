// @run
// @log 1.5
// @log 1.5
// @log 1.5
// An expression-bodied lambda's annotated result pins the function a call result's record holds,
// as a block body's `return` and a named function do, so the record's `id` is built at f64.
function id(a) { return a }
function deliver() { return [{ f: id }] }
const k = (r): { f: (a: f64) => f64 } => ({ f: r.f })
print(k(deliver()[0]).f(1.5))
const x = deliver()[0]
print(k(x).f(1.5))
const kf = (r): (a: f64) => f64 => r.f
print(kf(deliver()[0])(1.5))
