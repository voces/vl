// @run
// @log 4
// @log 4
// @log 4
// @log 4
// @log 2.5
// @log 4
// @log 4
// @hint Intentionally-unused parameter `_a`
// @hint redundant type annotation: `inc4` is inferred as `i32`
// A list literal's element record of an un-annotated function, read at an index and handed to an
// un-annotated parameter that calls the field, runs at the parameter's own row: alone, at the
// second of two elements, pushed, beside a declared record type whose field returns another
// type, and with the function annotated (D9570).
function inc0(a) { return a + 1 }
function take0(a) { print(a.f(3)) }
const xs0 = [{ f: inc0 }]
take0(xs0[0])

function inc1(a) { return a + 1 }
function take1(a) { print(a.f(3)) }
const xs1 = [{ f: inc1 }, { f: inc1 }]
take1(xs1[1])

function inc2(a) { return a + 1 }
function take2(a) { print(a.f(3)) }
const xs2 = [{ f: inc2 }]
xs2.push({ f: inc2 })
take2(xs2[1])

type R3 = { f: (a: i32) => f64 }
function useR3(r: R3) { print(r.f(1)) }
function inc3(a) { return a + 1 }
function take3(a) { print(a.f(3)) }
const xs3 = [{ f: inc3 }]
take3(xs3[0])
useR3({ f: (_a: i32): f64 => 2.5 })

function inc4(a: i32): i32 { return a + 1 }
function take4(a) { print(a.f(3)) }
const xs4 = [{ f: inc4 }]
take4(xs4[0])

function inc5(a) { return a + 1 }
function take5(a) { print(a.f(3)) }
take5({ f: inc5 })
