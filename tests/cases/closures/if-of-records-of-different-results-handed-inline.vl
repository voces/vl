// @run
// @log 4
// @log 1.5
// @log 4
// @log 1.5
// An `if` or `match` joining records whose function field holds functions of different results,
// handed inline to an un-annotated parameter, runs whichever arm is taken, as it does bound to a
// name first (D15807).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function two() { return [1, 2].length }
function take(r) { return r.f(3) }
print(take(if two() > 5 { { f: half } } else { { f: inc0 } }))
print(take(if two() > 1 { { f: half } } else { { f: inc0 } }))
print(
  take(
    match two() {
      5 => { f: half }
      _ => { f: inc0 }
    },
  ),
)
print(
  take(
    match two() {
      2 => { f: half }
      _ => { f: inc0 }
    },
  ),
)
