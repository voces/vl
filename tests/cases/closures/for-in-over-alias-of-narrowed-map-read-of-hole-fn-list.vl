// @run
// @log 4
// @log 4
// @log 3.5
// @log 1
// A `for` over an alias of a map read narrowed past null, holding a list of lists of a hole
// function, walks the non-null list the alias holds (D17751).
function __inc(a) { return a + 1 }
const __m = Map()
__m["k"] = [[__inc]]
const __mv = __m["k"]
if __mv != null {
  const v = __mv
  for __r in v { print(__r[0](3)) }
  let n = 0
  for __q in v { n = __q[0](3) }
  print(n)
  print(v[0][0](2.5))
  print(v.length)
}
