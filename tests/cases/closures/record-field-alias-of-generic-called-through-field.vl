// A record field holding an un-annotated alias of a generic, called through the field: a
// `const` alias, a written `let`, a second read through a binding, a chain of aliases, two
// fields called at two types, a top-level record and the list twin (D5061).
function k<T>(x: T): T { return x }
function j<T>(x: T): T {
  print("j")
  return x
}
const tg = k
const tr = { q: tg }
print(tr.q(10))
function viaConst() {
  const g = k
  const r = { q: g }
  print(r.q(1))
}
function viaWritten() {
  let g = k
  g = k
  const r = { q: g }
  print(r.q(2))
}
function viaWrittenOther() {
  let g = k
  g = j
  const r = { q: g }
  print(r.q(3))
}
function secondRead() {
  const g = k
  const r = { q: g }
  const h = r.q
  print(h(4))
  print(r.q(5))
}
function writtenSecondRead() {
  let g = k
  g = k
  const r = { q: g }
  const h = r.q
  print(h(6))
}
function chained() {
  const g = k
  const h = g
  const r = { q: h }
  print(r.q(7))
}
function twoTypes() {
  const g = k
  const r = { q: g, w: g, n: "n" }
  print(r.q(8))
  print(r.w("w"))
  print(r.q("q"))
  print(r.n)
}
function afterOtherCall() {
  let s = k
  s = k
  print(s("z"))
  const g = k
  const r = { q: g }
  print(r.q(9))
}
function listTwoTypes() {
  const g = k
  const fs = [g]
  print(fs[0](11))
  print(fs[0]("l"))
}
viaConst()
viaWritten()
viaWrittenOther()
secondRead()
writtenSecondRead()
chained()
twoTypes()
afterOtherCall()
listTwoTypes()
