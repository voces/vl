// @run
// @log 0.75
// @log 1
// @log 0.125
// @log 0.25
// @log 7
// @log 0.75
// @log 1
// @log 0.75
// @log a!
// @log aa
// A named generic handed to list elements whose calls each name the element's own value
// parameter: each element binds the generic at its own calls, not at a sibling's (D13202).
function add(a, b) { return a + b }
function mul(a, b) { return a * b }
function apply2(g, s) { print(g(s, s)) }
function apply3(g, s) { print(g(s, 0.25)) }
for f in [apply3, apply2] { f(add, 0.5) }

const fs = [apply3, apply2]
for f in fs { f(mul, 0.5) }

function run<T>(x: T) {
  print(x)
  for f in [apply3, apply2] { f(add, 0.5) }
}
run(7)

function pick(c: boolean) { return c }
const f1 = if pick(true) { apply3 } else { apply2 }
f1(add, 0.5)

function cat2(g, s) { print(g(s, s)) }
function cat3(g, s) { print(g(s, "!")) }
for f in [cat3, cat2] { f(add, "a") }
