// @run
// @log 32 a
// @log true
// @log 64 b
// @log true
// @log false
// @log 32 a1
// @log 22
// @log 35
// @log xx:3
// @log >hihi
// @log 16
// @log <g6><<g7>>
// @log n42
// A function-value call whose argument is another function-value call, with the two
// callees at different signatures (D2329, plumb PL-036). The outer call's closure is read
// twice, before and after its arguments, so an inner call must not replace it in between.
import { toString } from "std:fmt"
import { repeat } from "std:str"

type O = { k: i32 }
function a32(o: O): string { "a" }
function a64(o: O): string { "b" }
function s32(r: i32, e: string) { print("32 " + e) }
function s64(r: i32, e: string) { print("64 " + e) }

// plumb's shape: void if-expression bodies, captures, inside a loop, early return.
function f(m: string, w: string, o: O): boolean {
  for a in ["add", "mul"] {
    if m == a + "ss" {
      const lo = (op: O) => if w == "32" { a32(op) } else { a64(op) }
      const set = (e: string) => if w == "32" { s32(1, e) } else { s64(1, e) }
      set(lo(o))
      return true
    }
  }
  false
}
print(f("mulss", "32", { k: 1 }))
print(f("addss", "64", { k: 1 }))
print(f("subss", "32", { k: 1 }))

// through function-typed parameters, a `match` body annotated `void`.
function via(g: (string) => void, h: (O) => string, o: O) { g(h(o)) }
const w = 32
via(
  (e: string): void => match w {
    32 => print("32 " + e)
    _ => print("64 " + e)
  },
  (op: O) => "a" + toString(op.k),
  { k: 1 },
)

// siblings, a nested sibling tree, mixed parameter and result types.
const a = (x: i32) => x + 1
const b = (x: i32) => x * 10
const add = (x: i32, y: i32) => x + y
print(add(a(1), b(2)))
print(add(add(a(1), b(2)), add(b(1), a(2))))
const len = (s: string) => s.length
const rep = (n: i32): string => repeat("x", n)
const tag = (n: i32, s: string) => s + ":" + toString(n)
print(tag(len(rep(3)), rep(len("ab"))))
const say = (s: string) => print(s)
const twice = (s: string) => s + s
const pre = (s: string) => ">" + s
say(pre(twice("hi")))

// capturing nested functions called by name, alone and mixed with a lambda.
function outer(k: i32): i32 {
  function g(x: i32): i32 { x + k }
  function h(x: string): i32 { x.length * k }
  h(toString(g(2)) + "zz") + g(g(1))
}
print(outer(3))
function outer2(k: i32): string {
  function g(x: i32): string { "g" + toString(x + k) }
  const show = (s: string) => "<" + s + ">"
  show(g(1)) + show(show(g(2)))
}
print(outer2(5))

// closures read from struct fields.
type T = { f: (i32) => i32, g: (i32) => string }
const t: T = { f: (x: i32) => x * 2, g: (x: i32) => "n" + toString(x) }
print(t.g(t.f(21)))
