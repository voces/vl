// @run
// @log a!
// @log true
// @log b!
// @log true
// @log c!
// @log d!
// @log true
// @log e!
// @log true
// A hole function bound through an `if`, or handed through one to a parameter, and called
// compares as the name bound directly does: equal to the instance the call took (D6991, D6992).
function exclaim(s) { return s + "!" }
const on = [1].length == 1

const plain = exclaim
print(plain("a"))
print(plain == exclaim)
const x = if on { exclaim } else { exclaim }
print(x("b"))
print(x == exclaim)
const y = if on { exclaim } else { exclaim }
print(x("c"))
print(y("d"))
print(x == y)
function g(p) {
  print(p("e"))
  print(p == exclaim)
}
g(if on { exclaim } else { exclaim })
