// @run
// @log 1
// @log 2.5
// @log 2.5
// @log 3.5
// @log 1
// @log 2.5
// @log 2.5
// @log 3.5
// @log 1
// @log 2.5
// @log 2.5
// @log 3.5
// @log 1
// @log 2.5
// @log 2.25
// @log 3
// @log 2.5
// @log 3.5
// @hint redundant type annotation: `r` is inferred as `f64`
// A list element shared by two lists, one handed a function of a declared type and one a
// forwarded hole, takes each caller's own signature (D13661).
function add(a, b) { return a + b }
function apply2(g, s) { print(g(s, s)) }
function apply4(g, s) { print(g(s, 2)) }
function apply5(g, s) { print(g(3, s)) }
function innerThree(k: f64, h: (a: f64, b: f64) => f64) {
  for f in [apply2, apply4] { f(h, k) }
}
innerThree(0.5, add)
function three(k, h) {
  for f in [apply4, apply5] { f(h, k) }
}
three(0.5, add)
// The other caller annotated.
function bApply2(g, s) { print(g(s, s)) }
function bApply4(g, s) { print(g(s, 2)) }
function bApply5(g, s) { print(g(3, s)) }
function bInner(k, h) {
  for f in [bApply2, bApply4] { f(h, k) }
}
bInner(0.5, add)
function bThree(k: f64, h: (a: f64, b: f64) => f64) {
  for f in [bApply4, bApply5] { f(h, k) }
}
bThree(0.5, add)
// `const` lists, and a result delivered to an annotated binding and to a print.
function cApply2(g, s) { return g(s, s) }
function cApply4(g, s) { return g(s, 2) }
function cApply5(g, s) { return g(3, s) }
function cInner(k: f64, h: (a: f64, b: f64) => f64) {
  const fs = [cApply2, cApply4]
  for f in fs {
    const r: f64 = f(h, k)
    print(r)
  }
}
cInner(0.5, add)
function cThree(k, h) {
  const gs = [cApply4, cApply5]
  for f in gs { print(f(h, k)) }
}
cThree(0.5, add)
// The annotated caller called twice, the second time with a lambda.
function dApply2(g, s) { print(g(s, s)) }
function dApply4(g, s) { print(g(s, 2)) }
function dApply5(g, s) { print(g(3, s)) }
function dInner(k: f64, h: (a: f64, b: f64) => f64) {
  for f in [dApply2, dApply4] { f(h, k) }
}
function dThree(k, h) {
  for f in [dApply4, dApply5] { f(h, k) }
}
dInner(0.5, add)
dInner(1.5, (a: f64, b: f64) => a * b)
dThree(0.5, add)
