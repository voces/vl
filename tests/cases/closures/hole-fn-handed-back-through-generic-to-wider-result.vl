// @run
// @hint Intentionally-unused parameter `_a` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_n` (leading `_` marks it unused)
// @log 5
// @log s
// @log 5
// @log 5
// @log 5
// @log 9
// @log 10
// @log 6
// @log 7
// @log 8
// @log 11
// A lone un-annotated function handed through a generic that hands it back, delivered to a closed
// function type whose result is wider than the function's own, is built by the check's adapter
// at every position (D17099).
function inc(a) { return a + 1 }
function str(_a) { return "s" }
function id<T>(t: T): T { return t }
function fst<T>(t: T, _n: i32): T { return t }
function useK(k: (a: i32) => i32 | string) { print(k(4)) }
function useN(k: (a: i32) => i32 | null) { print(k(5)) }
function useF(k: (a: i32) => f64) { print(k(6)) }
function useI(k: (a: i32) => i32) { print(k(7)) }
function mk(): (a: i32) => i32 | string { return id(inc) }
useK(id(inc))
useK(id(str))
const g = inc
useK(id(g))
useK(fst(inc, 1))
useK(id(id(inc)))
print(mk()(8))
const r: { k: (a: i32) => i32 | string } = { k: id(inc) }
print(r.k(9))
useN(id(inc))
useF(id(inc))
useI(id(inc))
const k: (a: i32) => i32 | string = id(inc)
print(k(10))
