// @run
// @log 5
// @log 5 2.5
// @log 5 2.5
// @log 5
// @log 3.5
// @hint Intentionally-unused variable `_a`
// @hint Intentionally-unused variable `_b`
// @hint Intentionally-unused variable `_t`
// A maker handing back a record of one closure per signature is built returning the record, so
// a use or a destination at one signature takes that member (D15243).
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
function gen<T>(t: T, k: i32) {
  const r = lap((a) => a + k)
  const _t = t
  return r
}
function deliver() { return gen("s", 1) }
const u = deliver()
print(u(4))
const w = deliver()
print("\{w(4)} \{w(1.5)}")
const v: (x: f64) => f64 = deliver()
print("\{v(4)} \{v(1.5)}")
function take(g: (x: i32) => i32) { print(g(4)) }
take(deliver())
function inc() { return lap((a) => a + 2) }
const z: (x: f64) => f64 = inc()
print(z(1.5))
