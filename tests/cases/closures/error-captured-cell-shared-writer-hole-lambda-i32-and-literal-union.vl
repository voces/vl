// @emit-error the captured binding `k` is written with a function inside a closure that every instance of
// The same, at i32 and a literal union that shares its representation (review of #3498, `rv3498/e16_shared_writer_hole_lambda_i32_litunion`).
function inner<U>(u: U) { print("I"); print(u) }
type AB = "a" | "b"
function a<T>(x: T) {
  let k = inner
  const w = () => {
    k = (u) => {
      print("L"); print(u)
    }
  }
  k(x)
  w()
  k(x)
}
const v: AB = "b"
a(1)
a(v)
