// @emit-error emitProgram: this call runs functions that return different types, and one of them is also held where it cannot be stored as one of the functions this value may hold
// A returned list's records hold functions of different results, and a binding elsewhere holds
// one of them as a function value: the set is left closures, so the call has no one signature
// and is refused, not built at one member's (D15926).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function pick(b: boolean) {
  if b { return [{ f: inc0 }] }
  return [{ f: half }]
}
print(pick(true)[0].f(3))
const g = inc0
print(g(3))
