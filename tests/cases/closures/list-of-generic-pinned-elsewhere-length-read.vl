// @run
// @log I
// @log true
// @log I
// @log false
// @log 1
// A list of a generic that a delivery already pins, read by its length rather than by element
// calls, keeps master's path and runs (D3977, review of #3505, `rv3505/d01_pinned_by_delivery_length_read`).
function inner<U>(u: U) { print("I"); print(u) }
function cb(f: (b: boolean) => void, b: boolean) { f(b) }
function main() {
  const r = inner
  cb(r, true)
  const fs = [r]
  fs[0](false)
  print(fs.length)
}
main()
