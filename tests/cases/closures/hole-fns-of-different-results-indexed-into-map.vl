// @run
// @log 1.5
// The index writes of a map join its value set as `.set` does, and the index read of such a map
// is the `.get` read's box (D9311, D15139).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const m = Map()
m["a"] = inc0
m["b"] = half
const x = m["b"]
if x != null { print(x(3)) }
