// @log z
// @log 7
// @log 1
// @log z
// @log 7
// @log 1
// @log z
// @log 7
// @log 7
// @log 1
// @log z
// @log 7
// A maker's generic result in a record field, called at two types, runs when the whole record
// is also returned or put in a `const` list where that field is never read (D6424). Also the
// result handed on and bound, and the list inside a function.
function k<T>(x: T): T { return x }
function mk() { return k }
const r = { f: mk(), g: 7 }
function get() { return r }
print(r.f(1))
print(r.f("z"))
print(get().g)
const r2 = { f: mk(), g: 7 }
const xs = [r2]
print(r2.f(1))
print(r2.f("z"))
print(xs[0].g)
const r3 = { f: mk(), g: 7 }
function get3() { return r3 }
function show(o) { print(o.g) }
print(r3.f(1))
print(r3.f("z"))
show(get3())
const q = get3()
print(q.g)
function main() {
  const r4 = { f: mk(), g: 7 }
  const ys = [r4]
  print(r4.f(1))
  print(r4.f("z"))
  print(ys[0].g)
}
main()
