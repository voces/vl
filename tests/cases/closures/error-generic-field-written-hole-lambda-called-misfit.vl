// @error cannot write a lambda to 'r.f': a call through it at (i32, i32) runs it, and it takes `string` at parameter 2
// The record-field spelling of `error-generic-list-written-hole-lambda-called-misfit.vl` (D12217).
function pick<A, B>(a: A, b: B): A { a }
const r = { f: pick }
r.f = (x, y: string) => x
print(r.f(1, 2))
