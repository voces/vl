// @run
// @log 7
// @log ht
// @hint Intentionally-unused parameter `_i` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_q` (leading `_` marks it unused)
// An un-annotated function whose tail calls a local closure that a nested lambda reassigns
// returns that call's value, keyed by the cell's element type (D3812, D3846). A module-scope
// `const` annotated with a union holding a function arm keeps its union representation.
function f(g: (i32) => i32) { g(0) }
function h() {
  let op = (x: i32) => x + 1
  f((_i) => {
    op = (x: i32) => x + 5
    0
  })
  op(2)
}
print(h())
const u: ((i32) => {f: () => string}) | f64 | null = (_q) => ({ f: () => ("ht") })
function go() {
  const t0 = u
  if t0 != null {
    const t1 = t0
    if t1 is (i32) => {f: () => string} {
      print(t1(1).f())
    } else {
      print("OTHER")
    }
  } else {
    print("NULL")
  }
}
go()
