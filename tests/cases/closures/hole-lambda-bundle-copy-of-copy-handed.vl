// @run
// @log 5
// @log 2.5
// @log 8
// @log 5
// @log 2.5
// @log 10
// A copy of a copy of a hole lambda's bundle holds the record as its holder does: handed to a
// parameter called at both signatures, to one called at one, called directly, and inside a
// function and a lambda (D15746).
function lap(f) {
  f(2.5)
  f(3)
  return f
}
function take(b) {
  print(b(4))
  print(b(1.5))
}
function take1(b) { print(b(7)) }
const c = lap((a) => a + 1)
const v = c
const u = v
const t = u
take(t)
take1(u)
function main() {
  const k = lap((a) => a + 1)
  const w = k
  const run = () => {
    const x = w
    take(x)
  }
  run()
  print(c(9))
}
main()
