// A `?.` chain on an un-annotated parameter, in the instance whose argument is `null`: the chain
// is that instance's `null`, boxed as the destination's null. Bound, a field, assigned, a list
// element and tested, each beside the instance that reads a value.
type R = { f: (x: i32) => i32, n: i32 }
function dbl(x: i32) { return x * 2 }
const none: R | null = null
const some: R | null = { f: dbl, n: 5 }
function bound(a) {
  const r = a?.f(4)
  print(r ?? -1)
}
function field(a) {
  const r = a?.n
  print(r ?? -2)
}
function assigned(a) {
  let r: i32 | null = 0
  r = a?.f(5)
  print(r ?? -3)
}
function listed(a) {
  const xs = [a?.f(6)]
  print(xs[0] ?? -4)
}
function tested(a) {
  const r = a?.n
  if r == null { print("none") } else { print(r) }
}
bound(none) // -1
bound(some) // 8
field(none) // -2
field(some) // 5
assigned(none) // -3
assigned(some) // 10
listed(none) // -4
listed(some) // 12
tested(none) // none
tested(some) // 5
