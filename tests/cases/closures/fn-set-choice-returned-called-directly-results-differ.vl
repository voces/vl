// @run
// @log 3
// A choice of un-annotated functions with different results, returned and called directly,
// dispatches on the member it holds, here `lenOf` (D13740).
function twice(s) { return s + s }
function lenOf(s) { return s.length }
function pick(k: boolean) { return if k { twice } else { lenOf } }
print(pick([1].length > 1)("abc"))
