// A list literal of un-annotated functions returned from an un-annotated function keeps the type
// its caller's pin gives it when the callee has an un-annotated parameter, when it is read back
// through a reassigned `let`, a list element or a map value, when it is nested or stored in a
// record field, and when the call is handed to an un-annotated parameter (D9501-D9504).
function inc0(a) { return a + 1 }
function dbl0(a) { return a * 2 }
function deliver0(n) { return [inc0, dbl0] }
const v0 = deliver0(1)
print(v0.map((f) => f(3))[1])

function inc1(a) { return a + 1 }
function dbl1(a) { return a * 2 }
function deliver1(n) { return [inc1, dbl1] }
const v1 = deliver1(1)
print(v1.map((f) => f(3))[1])
const w1 = deliver1(2)
print(w1.map((f) => f(1.25))[1])

function inc2(a) { return a + 1 }
function dbl2(a) { return a * 2 }
function deliver2() { return [inc2, dbl2] }
let v2 = deliver2()
v2 = deliver2()
print(v2.map((f) => f(3))[1])

function inc3(a) { return a + 1 }
function dbl3(a) { return a * 2 }
function deliver3() { return [inc3, dbl3] }
const xs3 = [deliver3()]
const v3 = xs3[0]
print(v3.map((f) => f(3))[1])

function inc4(a) { return a + 1 }
function dbl4(a) { return a * 2 }
function deliver4() { return [inc4, dbl4] }
const m4 = Map()
m4["k"] = deliver4()
const v4 = m4["k"] ?? []
print(v4.map((f) => f(3))[1])

function inc5(a) { return a + 1 }
function dbl5(a) { return a * 2 }
function deliver5() { return [inc5, dbl5] }
const m5 = Map()
m5["k"] = deliver5()
const v5 = m5["k"] ?? []
print(v5[1](3))

