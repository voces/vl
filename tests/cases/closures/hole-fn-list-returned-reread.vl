function inc11(a) { return a + 1 }
function dbl11(a) { return a * 2 }
function deliver11() { return [inc11, dbl11] }
let v11 = deliver11()
function re11() { v11 = deliver11() }
re11()
print(v11.map((f) => f(3))[1])

function inc12(a) { return a + 1 }
function dbl12(a) { return a * 2 }
function deliver12(n) { return [inc12, dbl12] }
for f in deliver12(true) { print(f(1) * 2) }

function h13(u) { return u }
function deliver13() { return [h13, h13] }
