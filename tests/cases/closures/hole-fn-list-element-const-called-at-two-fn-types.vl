// @run
// @warning Unused parameter `a`
// @log x2
// @log 2
// @log y20
// @log 20
// @log x2
// @log 2
// @log y20
// @log 20
// @log 2
// @log x2
// The D12704 witness: a `const` bound to an element read is called at two function types,
// so the list is copied per type; then inside a function with the index stepped between the
// binding and the calls, and at the top level through a constant index.
import { toString } from "std:fmt"

function cat(a, b) { return a + b.toString() }
function snd(a, b) { return b }
function apply2(g) { print(g("x", 2)) }
function apply3(g) { print(g("y", 20)) }
const fs = [apply2, apply3]
let i = 0
while i < fs.length {
  const f = fs[i]
  f(cat)
  f(snd)
  i = i + 1
}

function run() {
  const gs = [apply2, apply3]
  let j = 0
  while j < gs.length {
    const f = gs[j]
    j = j + 1
    f(cat)
    f(snd)
  }
}
run()
const hs = [apply3, apply2]
const h = hs[1]
h(snd)
h(cat)
