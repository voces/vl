// @error cannot write 'half' to an element of 'xs': called at (i32) it returns f64, where 'inc0', also written to it, returns i32
// A `let` re-pointed to a literal holding a function of another result is refused at the
// re-point when a `.map` callback calls its element (D9172).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
let xs = [inc0]
xs = [half]
print(xs.map((f) => f(3))[0])
