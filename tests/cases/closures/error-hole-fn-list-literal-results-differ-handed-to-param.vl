// @error cannot store 'big' in an element of 'fs': called at (i32) it returns boolean, where 'inc0', also stored in it, returns i32
// A list literal handed to an un-annotated parameter is judged at the call through its element,
// as the same literal bound to a name is (D9092, D9280).
function inc0(a) { return a + 1 }
function big(a) { return a > 1 }
function run(fs) { return fs[1](3) }
print(run([inc0, big]))
