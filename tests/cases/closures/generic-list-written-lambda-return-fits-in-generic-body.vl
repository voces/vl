// @run
// @log aa
// @log 8
// @log aaz
// @hint Intentionally-unused parameter `_b` (leading `_` marks it unused)
// Controls for D12331: a written function whose return fits the instance's runs.
function pick<A, B>(a: A, _b: B): A { a }
const fs = [pick]
fs[0] = (x: string, y: string) => x + y
function g<T>(v: T): T { fs[0](v, v) }
print(g("a"))
const gs = [pick]
gs[0] = (x: i32, y: string) => x + y.length
function h<T>(v: T): T { gs[0](v, "q") }
print(h(7))
const ks = [pick]
ks[0] = (x: string, y: string) => x + y + "z"
function m<T>(v: T): T { ks[0](v, v) }
print(m("a"))
