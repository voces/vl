// @log 0
// @log 9
// @log 1
// A parameter read by a nested function that is reached through another taking a parameter of the
// same name is copied into its own spelling (D3025): the caller passes that copy to each lifted
// callee and reads it itself, through a lambda, a named function, two deep, at `i32`, after a
// write to a reference-typed one (D17674), and in a loop.
function viaLambda(g: string) {
  function k() { print(g) }
  const inner = (g: string) => {
    k()
    print(g)
  }
  inner("b")
  print(g)
}
viaLambda("a")
function viaNamed(g: i32) {
  function k() { print(g) }
  function inner(g: i32) {
    k()
    print(g)
  }
  inner(2)
  print(g + 10)
}
viaNamed(1)
function twoDeep(g: string) {
  function k() { print(g) }
  function inner(g: string) {
    function m() { k() }
    m()
    print(g)
  }
  inner("d")
}
twoDeep("c")
function written(g: string) {
  function k() { print(g) }
  const inner = (g: string) => {
    k()
    print(g)
  }
  g = "w"
  inner("x")
  print(g)
}
written("v")
function looped(g: i32) {
  function k() { print(g) }
  function inner(g: i32) {
    k()
    print(g)
  }
  for i in 0 to 1 { inner(i) }
}
looped(9)
