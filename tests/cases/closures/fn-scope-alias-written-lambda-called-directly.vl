// @run
// @log aa
// @log aaa
// @log 12
// A module-scope hole lambda written into a function's `let` by a nested writer is lowered at
// the alias's signature and, separately, at a direct call's (D3865).
const c = (y) => y + y
const e = (y) => y + y + y
function mk(x: string) {
  let d = c
  function w() { d = e; 0 }
  print(d(x))
  w()
  print(d(x))
}
mk("a")
print(e(4))
