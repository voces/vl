// @log 2
// @log 3
// @log 3
// @log 1
// @log 3
// @log 3
// @log x
// @log 3
// @log x
// D13969: a record field's un-annotated function is judged at the instance the callee's call
// through that field asks, so the field spellings run where the direct one does: inline,
// directly, as a list element, a bound list, a const read through an alias, and annotated. A
// binding two calls read at different instances keeps its open type and runs at each.
function len0(a) { return a.length }
function take0(a) { print(a.f("x")) }
function take1(a) { print(a("xy")) }
function each0(v) { print(v[0].f("xyz")) }
take0({ f: len0 })
take1(len0)
each0([{ f: len0 }])
const l = [{ f: len0 }]
each0(l)
const r = { f: len0 }
const r2 = r
take0(r2)
const ann: { f: (a: string) => i32 } = { f: len0 }
take0({ f: (s: string): i32 => ann.f(s) + 2 })
function id0(a) { return a }
function takeI(a) { print(a.f(3)) }
function takeS(a) { print(a.f("x")) }
const c = { f: id0 }
takeI(c)
takeS(c)
const d = c
takeI(d)
takeS(c)
