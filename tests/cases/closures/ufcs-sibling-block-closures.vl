// @run
// @log 6
// @log hi!
// @hint redundant type annotation: `w` is inferred as `i32` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// Two sibling blocks each bind a UFCS closure of one name at different signatures; each call
// reads its own block's binding (D2479).
function w(self: i32): i32 { self }
function main() {
  {
    const w = (self: i32): i32 => self + 1
    print(5.w())
  }
  {
    const w = (self: string): string => self + "!"
    print("hi".w())
  }
}
main()
