// @run
// @log 4
// @log 2.5
// @log 4
// @log 3.5
// @log 4
// @log 1.5
// @log 4
// @log 2.5
// A record field holding a set of hole functions holds the set's id: each call through the
// field reaches the chosen member's instance at its own tuple, whether the field is read at the
// top level, through a nested record, out into a binding, or inside a function body.
function inc(a) { return a + 1 }
function dbl(a) { return a * 2 }
const r = { f: if [1].length > 0 { inc } else { dbl } }
print(r.f(3))
print(r.f(1.5))
const n = { o: { f: if [1].length > 0 { inc } else { dbl } } }
print(n.o.f(3))
print(n.o.f(2.5))
const g = r.f
print(g(3))
print(g(0.5))
function main() {
  const q = { f: if [1].length > 0 { inc } else { dbl } }
  print(q.f(3))
  print(q.f(1.5))
}
main()
