// @run
// @warning Unused parameter
// @log 2
// @log 20
// @log x2
// @log 2
// @log y20
// @log 20
// D10791's loop after a loop calling the list at one type: the two-type loop iterates the list
// and reads the copy only for its call at the other type.
import { toString } from "std:fmt"

function cat(a, b) { return a + b.toString() }
function snd(a, b) { return b }
function apply2(g) { print(g("x", 2)) }
function apply3(g) { print(g("y", 20)) }
const fs = [apply2, apply3]
for f in fs { f(snd) }
for f in fs {
  f(cat)
  f(snd)
}
