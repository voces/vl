// @run
// @log 1
// @log s
// @log loud
// @log 3
// @log loud
// @log t
// @log 10
// @log 20
// @log 30
// @log 40
// @log 50
// @log loud
// @log m
// @log loud
// @log true
// A binding called at two types delivered to a list, a field, an annotated binding, a push, a map
// and a return stores the instance at the destination's type by value, so the later write of
// `loud` reaches none of the stored values (D3975).
function id<T>(x: T): T { return x }
function loud<T>(x: T): T {
  print("loud")
  return x
}
type R = { g: (x: i32) => i32 }
function mk(): (x: boolean) => boolean {
  let h = id
  h = loud
  print(h("m"))
  return h
}
function main() {
  let f = id
  print(f(1))
  print(f("s"))
  const xs: ((x: i32) => i32)[] = [f]
  const r: R = { g: f }
  const u: (x: i32) => i32 = f
  const ys: ((x: i32) => i32)[] = []
  ys.push(f)
  const m: Map<string, (x: i32) => i32> = Map()
  m.set("k", f)
  f = loud
  print(f(3))
  print(f("t"))
  print(xs[0](10))
  print(r.g(20))
  print(u(30))
  print(ys[0](40))
  const mg = m.get("k")
  if mg != null { print(mg(50)) }
  print(mk()(true))
}
main()
