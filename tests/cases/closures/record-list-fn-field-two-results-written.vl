// @run
// @log 5.5
// @log 5.5
// @log 5.5
// @log 5.5
// @log 5.5
// @log 11.5
// @log 1.5
// @log 7
// A list of record literals whose function field holds un-annotated functions returning
// different types, written after its initialiser: a call through the field still runs the member
// stored there. A `let` assigned a whole list, taken or skipped, an element assigned, a record
// pushed, a field assigned, and a field read into a binding (D15801).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function dbl(a) { return a * 2 }
function two() { [1, 2].length }
function three() { [1, 2, 3].length }
let a = [{ f: inc0 }, { f: half }]
if two() > 1 { a = [{ f: half }, { f: inc0 }] }
let acc = 0.0
let i = 0
while i < two() {
  acc = acc + a[i].f(3)
  i = i + 1
}
print(acc)
let b = [{ f: inc0 }, { f: half }]
if two() > 5 { b = [{ f: half }, { f: inc0 }, { f: half }] }
acc = 0.0
i = 0
while i < two() {
  acc = acc + b[i].f(3)
  i = i + 1
}
print(acc)
const c = [{ f: inc0 }, { f: inc0 }]
c[1] = { f: half }
acc = 0.0
i = 0
while i < two() {
  acc = acc + c[i].f(3)
  i = i + 1
}
print(acc)
const d = [{ f: inc0 }]
d.push({ f: half })
acc = 0.0
i = 0
while i < two() {
  acc = acc + d[i].f(3)
  i = i + 1
}
print(acc)
const e = [{ f: inc0 }, { f: inc0 }]
e[1].f = half
acc = 0.0
i = 0
while i < two() {
  acc = acc + e[i].f(3)
  i = i + 1
}
print(acc)
const g = [{ f: inc0 }, { f: dbl }]
g.push({ f: half })
acc = 0.0
i = 0
while i < three() {
  const x: f64 = g[i].f(3)
  acc = acc + x
  i = i + 1
}
print(acc)
const h = [{ f: inc0, n: 1 }, { f: inc0, n: 2 }]
h[1] = { f: half, n: 3 }
const k = h[1].f
print(k(3))
print(h[two() - 2].f(3) + h[1].n)
