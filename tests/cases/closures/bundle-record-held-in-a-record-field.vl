// @run
// @log 5 2.5
// @log 5 2.5
// @log 3
// @log 7 4.5
// @log 6 3.5
// @log 5 2.5
// @info `p` is never reassigned; use `const` instead of `let`
// @hint Intentionally-unused variable `_a`
// @hint Intentionally-unused variable `_b`
// @hint Intentionally-unused variable `_t`
// A record of one closure per signature written into a field of an un-annotated record is held
// there whole: a copy of the field and a call through the field's place each take their member.
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
function gen<T>(t: T, k: i32) {
  const r = lap((a) => a + k)
  const _t = t
  return r
}
const w = { f: lap((a) => a + 1) }
const v = w.f
print("\{v(4)} \{v(1.5)}")
print("\{w.f(4)} \{w.f(1.5)}")
const o = { f: gen("s", 3), n: 3 }
print(o.n)
print("\{o.f(4)} \{o.f(1.5)}")
let p = { f: lap((a) => a + 1) }
p.f = lap((a) => a + 2)
print("\{p.f(4)} \{p.f(1.5)}")
function run(k: i32) {
  const q = { f: lap((a) => a + k) }
  const u = q.f
  print("\{u(4)} \{u(1.5)}")
}
run(1)
