// @run
// @log 5
// The same when the parameter and its arguments are handed on to a second un-annotated function
// before the call (D9009, D16009).
function add0(a, b) { return a + b }
function addh(a, b) { return a + b / 2.0 }
function v(k, p, q) { return k(p, q) }
function w(h, x, y) { return v(h, x, y) }
let f = add0
f = addh
print(w(f, 3, 4))
