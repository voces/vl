// @run
// @log 4
// @log 4.5
// @log 7
// @log 2.5
// A hole lambda's bundle held in a module-scope `const` and returned from a function, where the
// result is used as one member, by a binding called at one signature or an annotated parameter,
// and beside it by a holder called at both (D15748).
function lap(f) {
  f(2.5)
  f(3)
  return f
}
const c = lap((a) => a + 1)
function g() { return c }
const w = g()
print(w(3))
function u(f: (f64) => f64) { print(f(3.5)) }
u(g())
const k = g()
print(k(6))
print(k(1.5))
