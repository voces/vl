// @run
// @log 2
// @log 0.5
// @log 2
// @log 2.5
// A record the body pushes onto an un-annotated parameter's bound list shares its empty list
// field's element with the list's own records, so the caller's later write types both (D16425).
function t(a) {
  a.push({ ys: [] })
  print(a.length)
}
const l = [{ ys: [] }]
t(l)
l[0].ys.push(0.5)
print(l[0].ys[0])
const m = [{ ys: [] }]
t(m)
m[1].ys.push(2.5)
print(m[1].ys[0])
