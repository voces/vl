// @run
// @log 6
// @log 6
// @log 8
// @log 6
// @log 6
// @log 6
// @info `q2` is never reassigned; use `const` instead of `let`
// A record binding re-pointed at another record binding of a different function set stores that
// record at its own row: the written binding's list holds the joined set's ids (D16919).
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
let r = { f: [inc0] }
const q = { f: [dbl] }
r = q
print(r.f[0](3))
let r2 = { f: [inc0] }
let q2 = { f: [dbl] }
r2 = q2
print(r2.f[0](3))
let r3 = { f: [inc0], n: 1 }
const q3 = { f: [dbl], n: 2 }
r3 = q3
print(r3.f[0](3) + r3.n)
let r4 = { f: [inc0, dbl] }
const q4 = { f: [dbl] }
r4 = q4
print(r4.f[0](3))
let r5 = { f: [inc0] }
const q5 = { f: [dbl] }
r5 = q5
print(r5.f[0](3))
print(q5.f[0](3))
