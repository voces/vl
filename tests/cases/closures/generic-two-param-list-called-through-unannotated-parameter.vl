// @run
// @log 4
// @log 4
// @log 3.5
// @log 4
// @log 8
// @hint Intentionally-unused parameter `_y`
// @hint Intentionally-unused parameter `_y`
// A list of a two-parameter generic pushed a fixed-type function and called through an
// un-annotated parameter: an argument at the element type's closed `f64` is read there, so the
// slot has one pin and the generic one instance (D10203, D10320).
function k<T>(x: f64, _y: T) { x }
function h(x: f64, _y: i32) { x + 1.0 }
const ys = [k]
ys.push(h)
function run(a) { print(a[1](3, 2)) }
run(ys)

const zs = [k]
zs.push(h)
function both(a) {
  print(a[1](3, 2))
  print(a[0](3.5, 2))
}
both(zs)

// Beside a list handed to an annotated parameter, a runtime `i32` argument is read at `f64` too.
const vs = [k]
vs.push(h)
function annotated(a: ((x: f64, y: i32) => f64)[]) {
  const z = 3
  print(a[1](z, 2))
}
annotated(vs)
function g(n: i32) {
  const ws = [k]
  ws.push(h)
  function run2(a) { print(a[1](n, 2)) }
  run2(ws)
}
g(7)
