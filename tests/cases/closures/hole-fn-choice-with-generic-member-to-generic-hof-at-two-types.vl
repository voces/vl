// @run
// @log 4
// @log 2.5
// @log 5
// @log 3.5
// @log 4
// @log 2.5
// A choice holding a generic member handed to a generic higher-order function at two types and
// called inside it: each instance coerces the id at its own parameter type, as for the
// un-annotated members alone (D16832).
function same<T>(g: (x: T) => T, v: T): T { return g(v) }
function gid<U>(x: U): U { return x }
function hinc(x) { return x + 1 }
const h = if 3 > 2 { gid } else { hinc }
print(same(h, 4))
print(same(h, 2.5))
let k = gid
if 3 > 2 { k = hinc }
print(same(k, 4))
print(same(k, 2.5))
function go() {
  const m = if 3 > 2 { gid } else { hinc }
  print(same(m, 4))
  print(same(m, 2.5))
}
go()
