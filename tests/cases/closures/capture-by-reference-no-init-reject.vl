// @emit-error is assigned after a closure captures it, so the closure shares it
// A closure shares a binding assigned after it captures it (D2339), and the share is a cell
// holding a value from the start. A `let` with no initializer gets its type's zero value; a
// struct has none, so this is refused rather than captured by value (D2340).
type P = { x: i32 }
function main() {
  let p: P
  const g = () => p.x
  p = { x: 7 }
  print(g())
}
main()
