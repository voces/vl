// @run
// @log 1.5
// @log 3
// @log 2
// @log 3
// @log 3
// @log 6
// @log 3
// A record of an un-annotated function read back from an un-annotated `Map()` runs its own
// function, not that of an earlier same-shaped record literal called at a guessed signature
// (D9312); a generic in such a record runs when called through `?.` (D9313).
function half(a) { return a / 2.0 }
function inc(a) { return a + 1 }
function id<T>(x: T): T { x }
const b = { f: half }
print(b.f(3))
const j = Map()
j["k"] = { f: inc }
const a = j["k"]
if a != null { print(a.f(2)) }
const g = Map()
g["k"] = { f: id }
print(g["k"]?.f(2) ?? 0)
const s = Map()
s.set("k", { f: inc })
const c = s.get("k")
if c != null { print(c.f(2)) }
function main() {
  const q = Map()
  q["k"] = { f: inc }
  const d = q["k"]
  if d != null { print(d.f(2)) }
  print(q["k"]?.f(5) ?? 0)
}
main()
let t = 0
for k in j.keys() {
  const e = j[k]
  if e != null { t = t + e.f(2) }
}
print(t)
