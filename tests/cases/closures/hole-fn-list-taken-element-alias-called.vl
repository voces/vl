// @run
// @log 4
// @log 4
// @log 6
// @log 6
// @log x?
// @log 0
// @log false
// @log 4
// @log true
// @log 4
// @log 7
// @log 4
// A `const` bound to an element a list of un-annotated lambdas hands by `pop` or `get`, narrowed
// and called, takes the list's pinned element: at one element or two, through an alias of the
// alias, at a string, with the null arm read, and in a function body.
const f = (a) => a + 1
const m = [f]
const g = m.pop()
if g != null { print(g(3)) }
const m2 = [f]
const g2 = m2.get(0)
if g2 != null { print(g2(3)) }
const c = (a) => a + 1
const d = (a) => a * 2
const two = [c, d]
const h = two.get(1)
if h != null { print(h(3)) }
const s = two.pop()
if s != null { print(s(3)) }
let k = "!"
const sf = (a) => a + k
k = "?"
const ms = [sf]
const gs = ms.pop()
if gs != null { print(gs("x")) }
print(ms.length)
const m3 = [f]
const g3 = m3.pop()
print(g3 == null)
if g3 != null { print(g3(3)) }
print(m3.pop() == null)
const m4 = [f]
const g4 = m4.get(0)
const h4 = g4
if h4 != null { print(h4(3)) }
const add = (a, b) => a + b
const m5 = [add]
const g5 = m5.pop()
if g5 == null { print(0) } else { print(g5(3, 4)) }
function main() {
  const lf = (a) => a + 1
  const lm = [lf]
  const lg = lm.pop()
  if lg != null { print(lg(3)) }
}
main()
