// @run
// @log 4
// @log zz
// @log 5
// @log z
// @log 6
// @log 4
// @log zz
// @log 12
// @log 4
// @log 14
// @log zz
// A call returning one of two generics, handed to a split parameter after arguments that read a
// module `let`, a member and an element the call writes: those arguments are read first (D10022).
function id<T>(x: T): T { x }
function twice<T>(x: T): T { x + x }
let m = 2
function deliver(n: i32) {
  m = m + 1
  if n > 1 { return id }
  return twice
}
function take3(k: i32, a) {
  print(a(k))
  print(a("z"))
}
take3(m, deliver(1))
take3(5, deliver(3))

function deliver10(n: i32) {
  m = m + 10
  if n > 1 { return id }
  return twice
}
function take4(k: i32, j: i32, a) {
  print(a(k))
  print(a(j))
  print(a("z"))
}
function main() {
  m = 2
  take4(m + 1, m, deliver10(1))
  print(m)
}
main()

const box = { v: 2 }
const xs = [7]
function deliverW(n: i32) {
  xs[0] = 99
  if n > 1 { return id }
  return twice
}
take4(box.v, xs[0], deliverW(1))
