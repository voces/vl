// @run
// @log 11
// @log 22
// @log 33
// @log 44
// @log 55
// @log 66
// @log 77
// @log 88

// D1621 — an UN-ANNOTATED binding initialised from a field, element or map read, then
// captured and called. Every block adds a different constant, so a call that reached another
// block's closure prints a wrong number rather than passing.

// `captureValKind` types an annotated env field from the annotation and an un-annotated one
// through `letInitCellKind`, whose syntactic arms cannot resolve a container read during a
// pass that runs before the locals registry is built. The arena carries the answer, and its
// test is structural, so a func ARRAY and a NULLABLE closure take their own reps.

// Not one annotation below: an annotated spelling of each of these already ran, so a fixture
// that annotated them could not see this defect at all.

// A struct field read.
function atStructField() {
  const w = { f: (n: i32) => n + 1 }
  const v = w.f
  const g = (n: i32) => v(n)
  print(g(10))
}

atStructField()

// A closure-array element read.
function atArrayElement() {
  const xs = [(n: i32) => n + 2]
  const v = xs[0]
  const g = (n: i32) => v(n)
  print(g(20))
}

atArrayElement()

// A function-valued map read — the NULLABLE rep, since `m[k]` is `V | null`.
function atMapValue() {
  const m: { [string]: (i32) => i32 } = Map()
  m["k"] = (n: i32) => n + 3
  const mv = m["k"]
  if mv != null {
    const g = (n: i32) => mv(n)
    print(g(30))
  }
}

atMapValue()

// A nested field read, two hops down.
function atNestedField() {
  const w = { inner: { f: (n: i32) => n + 4 } }
  const v = w.inner.f
  const g = (n: i32) => v(n)
  print(g(40))
}

atNestedField()

// The binding read back and captured TWO frames deep.
function atTwoFrames() {
  const w = { f: (n: i32) => n + 5 }
  const v = w.f
  const outer = (n: i32) => {
    const g = (m: i32) => v(m)
    return g(n)
  }
  print(outer(50))
}

atTwoFrames()

// ── the neighbours that already ran, kept as controls ────────────────────────

// The field called directly in the lambda, with no intermediate binding.
function atFieldDirect() {
  const w = { f: (n: i32) => n + 6 }
  const g = (n: i32) => w.f(n)
  print(g(60))
}

atFieldDirect()

// A binding from a container read that is NOT captured — called in its own frame.
function atOwnFrame() {
  const w = { f: (n: i32) => n + 7 }
  const v = w.f
  print(v(70))
}

atOwnFrame()

// The closure LIST itself captured, its element read inside the lambda and bound before the
// call: the element rep is a ref list and the binding is the closure, which is what the
// structural arena test keeps apart.
function atClosureList() {
  const xs = [(n: i32) => n + 8]
  const g = (n: i32) => {
    const e = xs[0]
    return e(n)
  }
  print(g(80))
}

atClosureList()
