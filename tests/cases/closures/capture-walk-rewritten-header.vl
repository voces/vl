// @run
// @log a
// @log 1
// @log 2
// @log 10
// @log b
// @log a
// D3139: a loop whose header a rewrite replaces (a user `+`, a `?.` on a non-null receiver)
// still scopes its variable over its body, so a closure capturing it, or a copy of it, finds
// its loop and not an earlier or enclosing one of the same name.
type K = "a" | "b"
type V = { x: i32 }
type H = { ks: K[] }
function "+"(self: V, other: V) { return self.x + other.x }
function g(ks: K[], p: V) {
  for e in ks {
    const c = e
    print(c)
  }
  for e in 0 until p + p {
    const c = e
    const f = () => c + 1
    print(f())
  }
  for e in 0 until p?.x {
    const f = () => e + 10
    print(f())
  }
}
g(["a"], { x: 1 })
function h(hk: H, ns: i32[]) {
  for e in ns {
    for e in hk?.ks {
      const c = e
      const f = () => c
      print(f())
    }
  }
}
h({ ks: ["b", "a"] }, [1])
