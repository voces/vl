// @run
// @log L
// @log 4
// @log O
// @log true
// A result that names the type parameter takes the type the call through the list gives (D7103).
function other<V>(v: V): V { print("O"); v }
function main() {
  let k = other
  k = (n) => {
    print("L"); n
  }
  const fs = [k]
  print(fs[0](3) + 1)
  print(other(true))
}
main()
