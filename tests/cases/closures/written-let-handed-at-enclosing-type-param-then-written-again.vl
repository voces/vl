// @run
// @warning Unused parameter `v`
// @log 7
// @log 8
// @log x
// @log 7
// @log 8
// @log 1.5
// @log 7
// @log 8
// @log y
// @log 7
// @log 8
// @log 2.5
// @log 7
// @log 8
// @log x
// @log 7
// @log 8
// @log 1.5
// @log y
// @log 2.5
// A `let` of generics handed at the enclosing generic's own type parameter and written again
// afterwards, in a loop around the hand, or from a closure: each hand delivers the value the
// `let` held there (D15408).
function fst<T>(xs: T[]): T { return xs[0] }
function lst<T>(xs: T[]): T { return xs[xs.length - 1] }
function app<T>(g: (x: T[]) => T, v: T[]): T { return g(v) }
function keep<T>(g: (x: T[]) => T, v: T[]): (x: T[]) => T { return g }
function after<U>(u: U[]): U {
  let f = fst
  print(app(f, [7, 8]))
  const k = keep(f, u)
  f = lst
  print(app(f, [7, 8]))
  k(u)
}
print(after(["x", "y"]))
print(after([1.5, 2.5]))
function looped<U>(u: U[]): U {
  let f = fst
  let r = u[0]
  let i = 0
  while i < 2 {
    i = i + 1
    print(app(f, [7, 8]))
    r = app(f, u)
    f = lst
  }
  r
}
print(looped(["x", "y"]))
print(looped([1.5, 2.5]))
function flipped<U>(u: U[]): U {
  let f = fst
  const flip = () => {
    f = lst
  }
  print(app(f, [7, 8]))
  const r = app(f, u)
  flip()
  print(app(f, [7, 8]))
  r
}
print(flipped(["x", "y"]))
print(flipped([1.5, 2.5]))
function closureOnly<U>(u: U[]): U {
  let f = fst
  const flip = () => {
    f = lst
  }
  flip()
  app(f, u)
}
print(closureOnly(["x", "y"]))
print(closureOnly([1.5, 2.5]))
