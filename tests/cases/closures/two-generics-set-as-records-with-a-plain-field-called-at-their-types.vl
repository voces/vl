// @run
// @log 3
// @log t
// @log 2
// @log b
// @log true
// @log a
// Generics written by `.set` as a function field beside plain fields of one un-annotated map's
// records join the field's set, and the plain fields read back their own values (D15627).
function id<T>(x: T): T { x }
function k2<T>(x: T): T { x }
const b = Map()
b.set("k", { n: 1, f: id, s: "a" })
b.set("j", { s: "b", f: k2, n: 2 })
const bj = b.get("j")
if bj != null {
  print(bj.f(3))
  print(bj.f("t"))
  print(bj.n)
  print(bj.s)
}
const bk = b.get("k")
if bk != null {
  print(bk.f(true))
  print(bk.s)
}
