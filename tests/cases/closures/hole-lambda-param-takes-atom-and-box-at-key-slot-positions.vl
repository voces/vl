// @run
// @log true
// @log false
// @log 2
// @log 1
// @log false
// @log true
// A hole lambda's parameter its closure leaves unset takes the argument at the call key's slot as
// it stands: an atom's id at an `i32` slot, a union box at a union slot.
type K = "a" | "b"
const ks: (K | i32)[] = ["a", "b", 3]
// an atom narrowed out of a union, at an `i32` slot
const isA = (w) => w == "a"
for e in ks {
  if !(e is i32) { print(isA(e)) }
}
// a union box, at a union slot
const lenOf = (w) => w.length
const ls: (i32[] | string[])[] = [[1, 2], ["x"]]
for l in ls { print(lenOf(l)) }
// the same in a function body
function inFn(xs: (K | i32)[]) {
  const same = (w) => w == "b"
  for e in xs {
    if !(e is i32) { print(same(e)) }
  }
}
inFn(ks)
