// @run
// @log 3
// @log 4
// @log false
// @log true
// A hole function the split gives a parameter per instance of its hole compares by its
// declaration, as written, not by the signature the split gave it (D7384).
function add(a, b) { return a + b }
function apply2(g) {
  print(g(1, 2))
  print(g(1.5, 2.5))
}
function other(g) { print(g(1, 2)) }
apply2(add)
print(apply2 == other)
print(other != apply2)
