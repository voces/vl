// @run
// @log 7
// @log 5
// @log hi
// @log 2.5
// @log 11
// A closure nested in a closure bound in a module-scope block, reading a block-local, at
// each delivery position: return, call argument, record field, list element, two captures.

type P = { x: i32 }

// for-loop block: inner closure nested in outer, capturing a block-local struct
for j in 0 to 0 {
  const p: P = { x: 7 }
  const outer = () => {
    const inner = () => p.x
    return inner()
  }
  print(outer())
}

// if block: capture of a list, read through a nested closure as a call argument
if true {
  const xs = [3, 4]
  const outer = () => {
    const inner = () => xs[1]
    print(inner() + 1)
  }
  outer()
}

// while block: string capture, inner closure result stored in a record field
let i = 0
while i < 1 {
  i = i + 1
  const s = "hi"
  const outer = () => {
    const inner = () => s
    const r = { v: inner() }
    print(r.v)
  }
  outer()
}

// bare block: f64 capture, inner result in a list literal
{
  const f = 2.5
  const outer = () => {
    const inner = () => f
    print([inner()][0])
  }
  outer()
}

// two captures at different reps through one inner closure
{
  const p: P = { x: 5 }
  const n = 6
  const outer = () => {
    const inner = () => p.x + n
    return inner()
  }
  print(outer())
}
