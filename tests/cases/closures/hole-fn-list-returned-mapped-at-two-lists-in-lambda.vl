// @run
// @log 2.25
// @log 4
// @log 4
// @log 6
// D15049's witness: a returned list read through `.map` in a lambda and in a hole function
// handed two lists. The lambda's call keeps its sets partial, so each call is typed per use.
function inc0(a) { return a + 1 }
function dbl0(a) { return a * 2 }
function deliver0() { return [inc0] }
function take2(a) { print(a.map((f) => [1].map((y) => f(y + 2))[0])[0]) }
print(deliver0().map((f) => f(1.25))[0])
take2(deliver0())
function take3(a) { return a.map((f) => f(3)) }
print(take3([inc0])[0])
print(take3([dbl0])[0])
