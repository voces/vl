// @run
// @info `q5` is never reassigned; use `const` instead of `let`
// @log s
// @log 2
// @log t
// @log 3
// @log 1.5
// @log u
// @log 4
// @log v
// @log 5
// @log 7
// @log w
// @log 6
// A module binding of a hole function, without `fw`, called in a generic body at its type
// parameter runs when the body is called at two types (D6320): through a chain, in return
// position, at three types, beside a module call, and as a never-written `let`.
function id(x) { return x }
const q = id
function g<T>(x: T) { print(q(x)) }
g("s")
g(2)
const q2 = id
const q2b = q2
function g2<T>(x: T) { print(q2b(x)) }
g2("t")
g2(3)
g2(1.5)
const q3 = id
function g3<T>(x: T): T { return q3(x) }
print(g3("u"))
print(g3(4))
const q4 = id
function g4<T>(x: T) { print(q4(x)) }
g4("v")
g4(5)
print(q4(7))
let q5 = id
function g5<T>(x: T) { print(q5(x)) }
g5("w")
g5(6)
