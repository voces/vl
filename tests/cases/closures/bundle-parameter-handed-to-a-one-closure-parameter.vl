// @run
// @log 3.5
// @log 4
// @log 8
// @log 3.5
// @log 4
// @log 2.5
// @log 1
// @log 2.5
// @log 1
// @log 3
// @log 1
// @log true
// @log 3.5
// @log 4
// @log 8
// @log 9
// @log 14
// A parameter called at two signatures and handed whole to a callee that copies, stores or
// otherwise reads its own parameter as one closure: the callee takes the record's member at
// its type, including a type the forwarder never calls and a nested function's parameter.
function keep(g) { const q = g; print(q(7)) }
function keepInList(g) { const xs = [g]; print(xs[0](1.5)) }
function keepBool(g) { const q = g; print(q(true)) }
function lap(f) {
  print(f(2.5))
  print(f(3))
  keep(f)
}
function lapList(f) {
  print(f(2.5))
  print(f(3))
  keepInList(f)
}
function lapBool(f) {
  print(f(2.5))
  print(f(3))
  keepBool(f)
}
function lapNested(f) {
  function inner(g) { const q = g; print(q(7)) }
  print(f(2.5))
  print(f(3))
  inner(f)
}
function go(k: i32) {
  lap((a) => a + k)
  lapList((a) => a + k)
  lapBool((a) => {
    print(k); a
  })
  lapNested((a) => a + k)
  keep((x) => x + k + 1)
  keep((x) => x * k * 2)
}
go(1)
