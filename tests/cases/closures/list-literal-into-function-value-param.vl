// @run
// @log 252
// @log 1.5
// @log 7
// @log true

// A list literal passed to a function VALUE builds at the parameter's rep: `[250, 1]` types
// `i32[]` and `[1.5]` types `f64[]`, so the parameter's `u8[]` or `f32[]` is the only thing
// that can say which list to build (D2296). A closure returning `u8[]` is callable through a
// list element (D2297), and a nested byte list compares element-wise (D2298).
const f = (xs: u8[]): i32 => xs[0] + xs.length
print(f([250, 1]))
const g = (xs: f32[]): f32 => xs[0]
print(g([1.5]))
const b: u8[] = [250, 7]
const h = () => b
const hs = [h]
print(hs[0]()[1])
const a: u8[][] = [[1, 2], [3]]
const c: u8[][] = [[1, 2], [3]]
print(a == c)
