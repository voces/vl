// @run
// @log aq
// @log br
// @log ct
// @log 13
// @log 22
// @log 6
// @log rz
// @log bm
// @log 8
// @log ax
// @log dq
// @log 10
// @log e!
// @log h!
// @log 6
// @hint redundant type annotation: `w` is inferred as `i32[]`
// A closure handed out of a module-scope VALUE block (a labelled block or a value `if` in a
// top-level initializer or argument) over that block's own local (D13081). The module-frame
// scan skipped a top-level `const`'s initializer and every expression, so the capture took the
// i32 default: invalid wasm at a string or list, a loud emit refusal at a record. Each type is
// delivered as a binding, as an argument, and as a return from a function that calls it, with
// the local inferred and annotated.

type P = { a: i32, b: string }

function useS(f: (s: string) => string) { return f("b") }
function useK(f: (k: i32) => i32) { return f(20) }

// string
const s1 = @B {
  const w = "q"
  const inner = (s: string) => s + w
  inner
}
print(s1("a"))
print(
  useS(
    @B {
      const w: string = "r"
      const inner = (s: string): string => s + w
      inner
    },
  ),
)
const s3 = @B {
  const w = "t"
  function inner(s: string) { return s + w }
  inner
}
function g3() { return s3("c") }
print(g3())

// i32[]
const l1 = @B {
  const w = [1, 2, 3]
  const inner = (k: i32) => w.length + k
  inner
}
print(l1(10))
print(
  useK(
    @B {
      const w: i32[] = [1, 2]
      const inner = (k: i32): i32 => w[1] + k
      inner
    },
  ),
)
const l3 = @B {
  const w = [4, 5]
  w.push(6)
  function inner(k: i32) { return w[k] }
  inner
}
function gl() { return l3(2) }
print(gl())

// a record
const r1 = @B {
  const w = { a: 3, b: "z" }
  const inner = (s: string) => s + w.b
  inner
}
print(r1("r"))
print(
  useS(
    @B {
      const w: P = { a: 4, b: "m" }
      const inner = (s: string): string => s + w.b
      inner
    },
  ),
)
const r3 = @B {
  const w: P = { a: 7, b: "k" }
  function inner(n: i32) { return w.a + n }
  inner
}
function gr() { return r3(1) }
print(gr())

// A value `if`, and a block called where it stands beside a sibling binding the same name.
const v1 = if s1("") == "q" {
  const w = "x"
  const inner = (s: string) => s + w
  inner
} else {
  const u = "y"
  const other = (s: string) => s + u
  other
}
print(v1("a"))
print(
  @C {
    const w = "q"
    const inner = (s: string) => s + w
    inner
  }("d"),
)
const y = @D {
  const w = [9]
  const inner = (k: i32) => w[0] + k
  inner
}
print(y(1))

// A function value captured from the block.
function exclaim(s: string) { return s + "!" }
const fx = @E {
  const lv = exclaim
  const g = (s: string) => lv(s)
  g
}
print(fx("e"))

// A value `if` arm's reassigned `let` of hole functions (D13103), and an arm's captured
// function value (D3383).
function shout(s) { return s + "!" }
function query(s) { return s + "?" }
const hx = if [1].length == 1 {
  let lv = query
  lv = shout
  lv
} else {
  query
}
print(hx("h"))
function mk(): () => i32 { return () => 5 }
const mv = if [1].length == 1 { const fv = mk(); () => fv() + 1 } else { mk() }
print(mv())
