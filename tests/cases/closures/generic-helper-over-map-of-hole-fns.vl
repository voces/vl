// @run
// @log 3
// @log 3.5
// @log 1.5
// @log 1.5
// @log 3
// A map of un-annotated functions handed to a generic helper whose parameter is a map of its type
// parameter is read at the map of ids the set is stored as, called at two signatures, with
// different results, and narrowed instead of coalesced (D14433, D17011).
function inc(x) { return x + 1 }
function dbl(x) { return x + x }
function inc0(x) { return x + 1 }
function half(x) { return x / 2.0 }
function pick<V>(m: {[string]: V}, k: string): V | null { return m.get(k) }
const m = Map()
m["a"] = inc
m["b"] = dbl
const h = pick(m, "a") ?? dbl
print(h(2))
print(h(2.5))
const n = Map()
n["a"] = inc0
n["b"] = half
const g = pick(n, "b") ?? inc0
print(g(3))
const q = pick(n, "b")
if q != null { print(q(3)) }
const o = Map()
o["a"] = inc0
const r = pick(o, "a") ?? inc0
print(r(2))
