// @run
// @log 2
// @log true
// @log r
// @log q
// A written `let` of generics declared below it is narrowed by each write as one declared above
// is: the read after `f = gB` calls `gB`, and its copy is called at its own type (unfiled: D16281).
let f = gA
let g = gB
f = gB
g = f
f(2)
g(true)
type S = "p" | "q"
type R = "p" | "r"
const a: S = "q"
const b: R = "r"
let x = hA
x = hB
let y = hC
y = x
x(b)
y(a)
function gA<U>(u: U) { print(u) }
function gB<V>(v: V) { print(v) }
function hA<U>(u: U) { print(u) }
function hB<V>(v: V) { print(v) }
function hC<W>(w: W) { print(w) }
