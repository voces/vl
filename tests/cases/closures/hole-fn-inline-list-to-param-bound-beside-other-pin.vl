// @run
// @log 5
// @log 2.5
// @log 5.5
// An inline list of an un-annotated function handed to a parameter the body binds to an
// annotated local takes the local's type, not the one instance another annotation pins the
// function at elsewhere, which trapped as an indirect call type mismatch (D9671); and an
// annotation of another type than the function's own default is followed (D9610).
function inc0(a) { return a + 1 }
function early(a) {
  const k: ((x: i32) => i32)[] = a
  return k[0](4)
}
const e: ((x: f64) => f64)[] = [inc0]
print(early([inc0]))
print(e[0](1.5))
function wide(a) {
  const k: ((x: f64) => f64)[] = a
  return k[0](4.5)
}
print(wide([inc0]))
