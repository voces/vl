// @error a `{fs: ((_) => _)[]}` cannot be used as `{fs: readonly ((i32) => i32 | f64)[]}` here
// A bound record whose list field holds an un-annotated function is not converted on the way into
// an annotated record whose function result is wider, as its closed-function twin is not (D15198).
function inc0(a) { return a + 1 }
const r = { fs: [inc0] }
const v: { fs: readonly ((x: i32) => i32 | f64)[] } = r
print(v.fs[0](3))
