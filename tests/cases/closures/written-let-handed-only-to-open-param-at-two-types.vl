// @run
// @log 6
// @log 7
// @log 2.5
// @log true
// @log 3
// @log s
// A written `let` read only as an argument to a parameter the callee leaves open, at two types:
// each instance of the callee is bound to the binding's whole set and calls through its id.
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function w(h, x) { return h(x) }
let f = inc0
f = dbl
print(w(f, 3))
print(w(f, 3.5))

function idg<T>(t: T): T { return t }
function kg<T>(t: T): T { return t }
let fi = idg
fi = kg
print(w(fi, 2.5))
print(w(fi, true))

function idh<T>(t: T): T { t }
function app(g, v) { return g(v) }
let fg = idg
fg = idh
print(fg(3))
print(app(fg, "s"))
