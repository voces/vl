// @run
// @log assigned
// @log G
// @log 1
// @log assigned
// @log G
// @log s
// A generic function written into a slot whose type is a union of a function and `string` is
// instanced at the slot's function signature in each enclosing instance (D3944).
function b<U>(y: U) { print("G"); print(y) }
// The write is conditional, so the test after it is a real question: a straight-line write
// narrows `h` to the function member, and testing it for `string` is refused.
function a<T>(x: T, w: boolean) {
  let h: ((t: T) => void) | string = "q"
  if w { h = b }
  print("assigned")
  if h is string { print("str") } else { h(x) }
}
a(1, true)
a("s", true)
