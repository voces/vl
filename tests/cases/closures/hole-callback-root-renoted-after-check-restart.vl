// @run
// @log 6
// @log 6
// @log 6
// @log 6
// A set tagged by an annotated callback restarts the check; a later un-annotated callback over
// a list of lists is keyed at its element in the restarted check's arena, in both orders (D17772).
function ap(r: (a: i32) => i32) { return r(5) }
function inc7(a) { return a + 1 }
print([inc7].map(ap)[0])
function inc6(a) { return a + 1 }
const nested = [[inc6]]
function apN(r) { return r[0](5) }
print(nested.map(apN)[0])
function inc5(a) { return a + 1 }
const nested2 = [[inc5]]
function apM(r) { return r[0](5) }
print(nested2.map(apM)[0])
function inc4(a) { return a + 1 }
print([inc4].map(ap)[0])
