// @run
// The keys bound to a const, then walked (D17095).
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
const m = Map()
m["a"] = lap((a) => a + 1)
m["b"] = lap((a) => a * 2)
const ks = m.keys()
for k in ks { print(k) }
// @log a
// @log b
// @hint Intentionally-unused variable `_a`
// @hint Intentionally-unused variable `_b`
