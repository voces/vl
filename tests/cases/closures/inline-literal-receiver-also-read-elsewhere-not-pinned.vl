// @log 11
// @log 11
// @log 7
// A hole function read as a value in two list literals is neither literal's alone, so neither
// receiver is pinned at its callback's type: each is built as an un-pinned list (coordinator ruling).
function ap(r: (a: i32) => i32): i32 { return r(5) }
function inc6(a) { return a + 6 }
print([inc6].map(ap)[0])
print([inc6].map(ap)[0])
function inc2(a) { return a + 2 }
const ys = [inc2]
print([inc2].map(ap)[0])
