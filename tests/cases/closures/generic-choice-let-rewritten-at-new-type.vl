// @run
// @log 21
// @log same
// @log b
// @log 1.5
// @log same
// @log c
// @log same
// @log 2.5
// @log 31
// @log same
// @log 32
// @log same
// @log d
// A `let` of a choice between two generics, written with another choice, is called after the
// write at a type it was not called at before it, while a peer holds one generic at another type
// (D10321, D10322).
function id<T>(x: T): T { x }
function same<T>(x: T): T {
  print("same")
  x
}
function pick(n: i32) {
  if n > 1 { return id }
  return same
}

// An `if` choosing the generic, written with the same `if`.
let kc = 0
const k = id
let k1 = if kc == 0 { id } else { same }
print(k(21))
kc = 1
k1 = if kc == 0 { id } else { same }
print(k1("b"))
k1 = if kc == 0 { same } else { id }
print(k1(1.5))
kc = 0
k1 = if kc == 0 { same } else { id }
print(k1("c"))
print(k1(2.5))

// A call returning the generic, written with another such call.
let j = pick(5)
print(j(31))
j = pick(0)
print(j(32))
print(j("d"))
