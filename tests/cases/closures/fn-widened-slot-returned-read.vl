// @run
// @log 1.5
// @log 1.5
// A map, or a record's list field, written a function of another result type inside a function
// and returned: the caller's read of the returned container takes the slot's widened set
// (D15162, D15169).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function mkMap() {
  const m = Map()
  m.set("a", inc0)
  m.set("b", half)
  return m
}
function mkRec() {
  const r = { xs: [inc0] }
  r.xs[0] = half
  return r
}
const m = mkMap()
const g = m.get("b")
if g != null { print(g(3)) }
const r = mkRec()
print(r.xs[0](3))
