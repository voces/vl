// @run
// @log 11
// @log 22
// @log 33
// @log 44
// @log ok!
// @log 55
// @log 66

// @hint redundant type annotation: `annotated` is inferred as `((i32) => i32)[]`

// D1625 — a closure ARRAY handed back by an un-annotated inferred return and bound at MODULE
// scope. `globalKind`'s ref-array rung resolves such an element only from a return
// ANNOTATION, so the cell fell to its `i32` guess while the element read wants a ref; the
// arena records the array type either way, and this asks it.

// The distinct wrappers below are the point: with more than one closure-array wrapper in the
// module, a slot that fell back to 0 would read another block's element and print its value.

// The witness: an un-annotated inferred return, a module global, the element called.
function deliverOne() { return [(n: i32) => n + 1] }

const one = deliverOne()

const callOne = (m: i32) => one[0](m)

print(callOne(10))

// A SECOND closure-array wrapper of the same signature: each global must keep its own.
function deliverTwo() { return [(n: i32) => n + 2] }

const two = deliverTwo()

const callTwo = (m: i32) => two[0](m)

print(callTwo(20))

// A THIRD at a different signature, so the wrapper tables cannot be conflated.
function deliverStr() { return [(s: string) => s + "!"] }

const strs = deliverStr()

const callStr = (t: string) => strs[0](t)

// A struct-element array beside them, whose own wrapper must stay distinct.
function deliverStructs() { return [{ a: 33 }] }

const structs = deliverStructs()

print(structs[0].a)

// The element read into a binding rather than called through the index.
function deliverFour() { return [(n: i32) => n + 4] }

const four = deliverFour()

const fourElem = four[0]

print(fourElem(40))

print(callStr("ok"))

// ── the neighbours that already ran, kept as controls ────────────────────────

// The identical program inside a FUNCTION, where the binding is a local rather than a global.
function inFunction() {
  const v = deliverOne()
  const g = (m: i32) => v[0](m)
  print(g(54))
}

inFunction()

// The global ANNOTATED, which resolved through the annotation all along.
const annotated: ((i32) => i32)[] = deliverTwo()

const callAnnotated = (m: i32) => annotated[0](m)

print(callAnnotated(64))
