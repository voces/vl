// @run
// @log 5
// @log 5
// @log 7
// @log 8
// @log 9
// @log 10
// @log f11
// @log 12
// @log 13
// @hint redundant type annotation: `w` is inferred as `J` — remove it to lean on inference
// @hint redundant type annotation: `o` is inferred as `J | null` — remove it to lean on inference
// A module block's binding of a record whose annotated type has no struct row of its own (`J`,
// built only as `mk2()`'s `{ f: null }`), captured by a closure: the environment slot takes the
// binding's own row. Q58 sweep of the captured record: a record argument, a nested argument, a
// return, a binding, an `if` arm, a `??` operand and a record field; its field at concat and
// interpolation. A union argument stores the binding at a variant row instead, which stays a miss.
import { toString } from "std:fmt"

type J = { f: i32 | null }
function mk2() { return { f: null } }
const dA: J = mk2()
function take(j: J) { return j.f ?? 5 }
function id<T>(t: T): T { return t }
{
  const c = mk2()
  const f = (k: boolean): J => {
    print(take(c))
    print(take(id(c)))
    const v: J = c
    print(v.f ?? 7)
    const w: J = if k { c } else { dA }
    print(w.f ?? 8)
    const o: J | null = if k { v } else { null }
    print((o ?? dA).f ?? 9)
    const r: { j: J } = { j: c }
    print(r.j.f ?? 10)
    print("f" + toString(c.f ?? 11))
    print("\{c.f ?? 12}")
    return c
  }
  print(f(true).f ?? 13)
}
