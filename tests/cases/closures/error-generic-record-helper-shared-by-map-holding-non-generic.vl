// @emit-error emitProgram: monomorphize: unsupported argument type for `mm` in a call to `fill`
// Two maps of records holding different function sets, one also holding a non-generic `inc`,
// each handed to the same helper: the map whose set holds `inc` refuses loudly rather than
// dispatch through a shared instance it cannot serve.
function id<T>(x: T): T { x }
function inc(x: i32): i32 { x + 1 }
function fill(mm) { mm["k"] = { f: id } }
const a = Map()
fill(a)
const b = Map()
b["z"] = { f: inc }
fill(b)
const ar = a["k"]
if ar != null {
  print(ar.f(2))
  print(ar.f("s"))
}
const bz = b["z"]
if bz != null { print(bz.f(3)) }
const bk = b["k"]
if bk != null { print(bk.f(4)) }
