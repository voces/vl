// @run
// @log 0
// @log 8
// @log 8
// @log 4
// @log 3
// @log 5
// @log 0
// @log 72
// @log 1
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// @hint redundant type annotation: `g4` is inferred as `i32`
// @hint redundant type annotation: `g7` is inferred as `i32`
// @hint redundant type annotation: `ga` is inferred as `i32`
// @hint redundant type annotation: `gn` is inferred as `i32`
// A lambda returning `[]` builds a list of records nested deeper than four levels, a
// diamond-shaped record and a nullable-record element list, beside the named function and the
// record literal that already ran (D9582).
type B0 = {x: i32, s: string}
type B1 = {l: B0, n: i32}
type B2 = {l: B1}
type B3 = {l: B2}
type B4 = {l: B3}
type B5 = {l: B4, k: boolean}
type B6 = {l: B5}
type B7 = {l: B6}

function g4(f: (x: i32) => B4[]): i32 { f(1).length }
print(g4((_x: i32) => []))

function g7(f: (x: i32) => B7[]): i32 {
  const r = f(1)
  r.push(
    {
      l: { l: { l: { l: { l: { l: { l: { x: 3, s: "deep" }, n: 4 } } } }, k: true } },
    },
  )
  r[0].l.l.l.l.l.l.l.x + r[0].l.l.l.l.l.l.n + r.length
}
function h7(_x: i32): B7[] { return [] }
print(g7((_x: i32) => []))
print(g7(h7))
print(
  g7(
    (x: i32) => [
      {
        l: { l: { l: { l: { l: { l: { l: { x: x, s: "a" }, n: 1 } } } }, k: false } },
      },
    ],
  ),
)

type A0 = {x: i32}
type A1 = {l: A0, r: A0}
type A2 = {l: A1, r: A1}
type A3 = {l: A2, r: A2}
type A4 = {l: A3, r: A3}
function ga(f: (x: A4) => A4[]): i32 {
  const a0: A0 = { x: 2 }
  const a1: A1 = { l: a0, r: a0 }
  const a2: A2 = { l: a1, r: a1 }
  const a3: A3 = { l: a2, r: a2 }
  const a4: A4 = { l: a3, r: a3 }
  const r = f(a4)
  r.push(a4)
  r.length + r[0].l.r.l.r.x
}
print(ga((_x: A4) => []))
print(ga((x: A4) => [x, x]))

type N0 = {x: i32}
type N1 = {l: N0}
type N2 = {l: N1}
type N3 = {l: N2}
type N4 = {l: N3}
function gn(f: (x: i32) => (N4 | null)[]): i32 {
  const r = f(1)
  let n = 0
  for e in r {
    if e != null { n = n + e.l.l.l.l.x }
  }
  n * 10 + r.length
}
print(gn((_x: i32) => []))
print(gn((x: i32) => [null, { l: { l: { l: { l: { x: x + 6 } } } } }]))
function hn(_x: i32): (N4 | null)[] { return [null] }
print(gn(hn))
