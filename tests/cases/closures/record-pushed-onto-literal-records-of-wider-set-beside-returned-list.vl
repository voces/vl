// @run
// @log 4
// @log 2.25
// A record literal pushed onto a list of records whose function field holds a wider set is built
// at the list's record, so its member there is a closure, and the member's set read through a
// returned list is called at two types (D15062).
function inc0(a) { return a + 1 }
function dbl0(a) { return a * 2 }
function deliver0() { return [inc0] }
function take0(a) { print(a[0](3)) }
take0(deliver0())
print(deliver0()[0](1.25))
const rs = [{ f: dbl0 }]
rs.push({ f: inc0 })
