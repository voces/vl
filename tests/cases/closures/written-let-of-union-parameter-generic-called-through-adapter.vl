// @run
// @log W
// @log 5
// @log true
// A generic with a union parameter written to a binding seeded with another generic and called
// at `(i32, boolean)`: the binding is banked at that signature, so the write adapts it (D4892).
function s<A, B>(a: A, b: B) {
  print(a)
  print(b)
}
function w<B>(a: i32 | string, b: B) {
  print("W")
  print(a)
  print(b)
}
function main() {
  let k = s
  k = w
  k(5, true)
}
main()
