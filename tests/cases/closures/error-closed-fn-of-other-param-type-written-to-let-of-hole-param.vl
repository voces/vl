// @error-at 9:11 argument 1: expected string, got i32
// @hint redundant type annotation
// A closed function whose parameter type the call through the `let` it is written to does not
// give is refused at that call (D15470).
function same(x) { return x }
function dbl(x: string): string { return x + x }
function go(a, b) {
  let hh = a
  hh = b
  print(hh(3))
  print(a("x"))
}
go(same, dbl)
