// @run
// @log false
// @log 8
// @log 1.5
// @log s
// @log s!
// @log false

// D2598: a closure capturing an un-annotated binding set from a narrowed union read holds the
// arm, not the box. Neither the env field nor the closure's inferred result replays the read's
// narrowing, so both typed the binding at the union: invalid wasm at module scope for every
// scalar arm, and in a function too for a `string` arm yielded by the closure.
function pickB(n: i32): string | boolean {
  if n == 0 { return "s" }
  true
}
function pickI(n: i32): string | i32 {
  if n == 0 { return "s" }
  7
}
function pickF(n: i32): string | f64 {
  if n == 0 { return "s" }
  1.5
}

const b = pickB(1)
if b is boolean {
  const c = b
  const f = () => !c
  print(f())
}
const i = pickI(1)
if i is i32 {
  const c = i
  const f = () => c + 1
  print(f())
}
const d = pickF(1)
if d is f64 {
  const c = d
  const f = () => c
  print(f())
}
const s = pickI(0)
if s is string {
  const c = s
  const f = () => c
  print(f())
}

function inFunction() {
  const t = pickI(0)
  if t is string {
    const c = t
    const f = () => c + "!"
    print(f())
  }
  const u = pickB(1)
  let g = () => true
  if u is boolean {
    const c = u
    g = () => !c
  }
  print(g())
}
inFunction()
