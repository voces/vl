// @run
// @log 2
// @log s
// @log 2
// @log s
// @log k2
// @log 3
// @log 2
// @log s
// A generic written into an un-annotated map through a helper's parameter, read back and called
// at two types: the helper's write lands as one of the map's function set, as a direct write does,
// beside a map that holds another generic, and beside a write of a parameter (D15492).
function id<T>(x: T): T { x }
function k2<T>(x: T): T {
  print("k2")
  x
}
function fill(mm) { mm["k"] = id }
const m = Map()
fill(m)
const r = m["k"]
if r != null {
  print(r(2))
  print(r("s"))
}
const a = Map()
const b = Map()
b["z"] = k2
fill(a)
fill(b)
const ra = a["k"]
if ra != null {
  print(ra(2))
  print(ra("s"))
}
const rb = b["z"]
if rb != null { print(rb(3)) }
function fillWith(mm, f) {
  mm["z"] = id
  mm["k"] = f
}
const c = Map()
fillWith(c, id)
const rc = c["k"]
if rc != null {
  print(rc(2))
  print(rc("s"))
}
