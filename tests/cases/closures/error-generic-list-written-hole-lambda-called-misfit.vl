// @error cannot write a lambda to an element of 'fs': a call through it at (i32, i32) runs it, and it takes `string` at parameter 2
// A lambda written into an element holding a generic takes what its annotated parameter says,
// so a call through the element at another type is refused, as through a `let` (D12217).
function pick<A, B>(a: A, b: B): A { a }
const fs = [pick]
fs[0] = (x, y: string) => x
print(fs[0](1, 2))
