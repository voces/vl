// @run
// @log 12
// @log sss
// A hole lambda written into a binding is pinned when the binding is delivered to a typed
// function parameter, as a call through it would pin it, even where the receiving
// parameter shares the binding's name (D3862).
const c = (y) => y + y
const e = (y) => y + y + y
let d = c
function mk(d: (y: i32) => i32, n: i32) { print(d(n)) }
function w() { d = e }
w()
mk(d, 4)
print(e("s"))
