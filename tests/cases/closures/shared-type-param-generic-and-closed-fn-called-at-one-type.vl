// @run
// @warning Unused parameter `b` (prefix with `_` to suppress, or remove it)
// @log 3
// A closed function sharing a function type parameter the body calls at one type it takes (D15464).
function go<F>(a: F, b: F) { print(a(3)) }
function same<T>(k: T): T { k }
function con(x: i32) { x }
go(same, con)
