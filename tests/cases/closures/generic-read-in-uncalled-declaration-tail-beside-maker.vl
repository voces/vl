// @run
// @log s
// @log 1
// @warning Unused function `other`
// @warning Unused variable `g`
// A function whose last statement declares a binding of a generic returns nothing, so that
// binding hands the generic's set nowhere; a maker's result is still called at two types.
function k<T>(x: T): T { return x }
function other() { const g = k }
function mk() { return k }
const b = mk()
print(b("s"))
print(b(1))
