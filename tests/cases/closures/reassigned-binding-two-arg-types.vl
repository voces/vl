// @run
// @log 1
// @log 1.5
// A reassigned function binding whose calls pin two argument types holds one closure per call
// type, and each call reads its own slot after the write (D3975).
function bump1<T>(x: T): T { return x }
function bump2<T>(x: T): T { return x }
let f = (a) => bump1(a)
print(f(1))
f = (a) => bump2(a)
print(f(1.5))
