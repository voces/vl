// @run
// @log I
// @log 1
// @log R
// @log 7
// @log I
// @log 2
// @log R
// @log 3
// @log I
// @log 4
// @log L
// @log 5
// A `let` seeded with a function that returns nothing takes one returning a value, and each call
// through it drops the result (owner ruling 2026-11-05, B2; D15015): at module scope, in a
// function written back to the seed, and with a declared function returning its argument.
function inner(u) { print("I"); print(u) }
function retV(v) { print("R"); print(v); v }
function h(x) { print("L"); print(x); x }
let m = inner
m(1)
m = retV
m(7)
function main() {
  let k = inner
  k(2)
  k = retV
  k(3)
  k = inner
  k(4)
}
main()
let q = inner
q = h
q(5)
