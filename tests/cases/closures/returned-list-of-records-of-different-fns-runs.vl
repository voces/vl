// @run
// @log 6
// @log 4
// @log 6
// @log 4
// A returned list literal of records holding different un-annotated functions joins their sets
// in its element type (D15228), and two returns of such lists join a list a record holds too
// (D15226), so a call through a field runs the member it holds.
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function mk() { return [{ f: inc0 }, { f: dbl }] }
function pick(b: boolean) {
  if b { return [{ fs: [inc0] }] }
  return [{ fs: [dbl] }]
}
print(mk()[1].f(3))
print(mk()[0].f(3))
print(pick(false)[0].fs[0](3))
print(pick(true)[0].fs[0](3))
