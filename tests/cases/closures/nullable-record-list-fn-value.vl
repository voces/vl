// @run
// @log 1
// @log 2
// @log 0
// D2414, D2501: a function value whose result is a nullable record list has a signature, both as
// a closure's result and as a parameter's type, and the call through it returns the list or null.
type R = { n: i32 }
function f() {
  const v: R[] | null = [{ n: 1 }]
  const q = (): R[] | null => {
    v
  }
  const got = q()
  if got != null { return got.length }
  0
}
function runN(cb: () => R[] | null): R[] | null { cb() }
function count(xs: R[] | null) {
  if xs != null { return xs.length }
  0
}
print(f())
print(count(runN((): R[] | null => [{ n: 1 }, { n: 2 }])))
print(count(runN((): R[] | null => null)))
