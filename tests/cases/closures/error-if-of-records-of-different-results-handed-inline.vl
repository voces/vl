// @error cannot store 'inc0' in 'r.f': called at (i32) it returns i32, where 'half', also stored in it, returns f64
// An `if` joining records whose function field holds functions of different results, handed
// inline to an un-annotated parameter and called through, is refused at check rather than
// trapping when the arm taken is not the first; bound to a name first, it runs (D15807).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function two() { [1, 2].length }
function take(r) { return r.f(3) }
print(take(if two() > 5 { { f: half } } else { { f: inc0 } }))
