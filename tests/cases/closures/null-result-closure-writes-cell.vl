// @run
// @log other
// @log true
// @log other
// @log other
// @log true
// @log other
// A closure whose only value is a `null` it writes into a captured `string | null` cell returns
// the `null` unit type's own null, whether its result is inferred or annotated, read or not
// (D14798).
function inferredUnread() {
  let v: string | null = "s"
  const k = () => {
    v = null
  }
  k()
  if v is string { v } else { "other" }
}
print(inferredUnread())

function inferredRead() {
  let v: string | null = "s"
  const k = () => {
    v = null
  }
  const r = k()
  print(r == null)
  if v is string { v } else { "other" }
}
print(inferredRead())

function annotatedUnread() {
  let v: string | null = "s"
  const k = (): null => {
    v = null
  }
  k()
  if v is string { v } else { "other" }
}
print(annotatedUnread())

function annotatedRead() {
  let v: string | null = "s"
  const k = (): null => {
    v = null
  }
  const r = k()
  print(r == null)
  if v is string { v } else { "other" }
}
print(annotatedRead())
