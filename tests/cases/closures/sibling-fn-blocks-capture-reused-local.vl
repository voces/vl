// @run
// @log 6hi!

// D2316 matrix — a closure capturing a LOCAL that is itself reused by name in a sibling
// block (`x` as well as `g`), compounding the name collision on the captured binding and
// the closure binding at once.

function f() {
  let out = ""
  {
    const x = 5
    const g = () => x + 1
    out = "\{g()}"
  }
  {
    const x = "hi"
    const g = () => x + "!"
    out = out + g()
  }
  out
}
print(f())
