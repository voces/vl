// @run
// @log 3
// @log 3

// @hint redundant type annotation: `w` is inferred as `{f: {name: string, n: i32}}`
// @hint redundant type annotation: `v` is inferred as `{name: string, n: i32}`
// @hint redundant type annotation: `lit` is inferred as `{f: {name: string, n: i32}}`

// D1636 — a struct field fed by a narrowed MAP read is interned `(ref null $S)`, so the
// read-back local takes the nullable niche while the annotation names the bare struct. The
// receiver `w` is a module-scope BLOCK binding: no frame's `fnBody` holds it and it is not
// a global, so only the emit-time declared-locals table answered for it — and that table
// speaks solely while the start function's body is emitted, not while the env struct is
// typed in the type section.

// The field fed by a struct LITERAL instead is the control: it ran throughout, which is
// what makes the map-read SOURCE the ingredient rather than the annotation.

type W = { f: { name: string, n: i32 } }

const m: { [string]: { name: string, n: i32 } } = Map()

m["k"] = { name: "ada", n: 3 }

const mv = m["k"]

if mv != null {
  const w: W = { f: mv }

  w.f = mv

  const v: { name: string, n: i32 } = w.f
  const g = () => v

  print(g().n)
}

// The field fed by a literal, same rebind and capture.
const lit: W = { f: { name: "ada", n: 3 } }

const lv = lit.f
const lg = () => lv

print(lg().n)
