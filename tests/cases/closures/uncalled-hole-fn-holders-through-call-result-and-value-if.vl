// @run
// @log 1
// @log 1
// @log 4
// @log 2
// @log 5
// @log 6
// An uncalled hole function's closure held in a list that a call returns, or that a value `if`
// joins, is laid out at its uncalled default (D9100): a call result as a field and as an element,
// read through a binding, a value `if` of lists of lists and one of records (D17743).
function inc0(a) { return a + 1 }
function g0() { return [inc0] }
const w0 = { f: g0() }
print(w0.f.length)

function inc1(a) { return a + 1 }
function g1() { return [inc1] }
const w1 = [g1()]
print(w1.length)

function inc2(a) { return a + 1 }
function g2() { return [inc2, inc2] }
const w2 = { n: 2, f: g2() }
print(w2.n + w2.f.length)

function inc3(a) { return a + 1 }
const b3 = 1 < 0
const w3 = if b3 { [[inc3]] } else { [[inc3], [inc3]] }
print(w3.length)

function inc4(a) { return a + 1 }
const b4 = 1 > 0
const w4 = if b4 { { n: 5, f: [[inc4]] } } else { { n: 6, f: [[inc4]] } }
print(w4.n)

function inc5(a) { return a + 1 }
function g5() { return [[inc5]] }
const w5 = [g5(), g5()]
print(w5.length + 4)
