// @error cannot write a lambda to an element of 'fs': a call through it at (i32, i32) runs it, and it takes `f64` at parameter 2
// The call reaches the written element through an un-annotated parameter, and an annotated
// `f64` parameter takes an `i32` call no more than a fixed function would (D10152, D12217).
function pick<A, B>(a: A, b: B): A { a }
const fs = [pick]
fs[0] = (x, y: f64) => x
function run(xs) { xs[0](1, 2) }
print(run(fs))
