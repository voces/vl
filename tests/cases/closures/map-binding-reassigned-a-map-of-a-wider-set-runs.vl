// @run
// @log 4
// @log 1.5
// @log 5
// @log 4
// A map binding first written one function, then reassigned a map of a wider set it is within,
// is a map of that set like its source, so the write's ids are read back through it (D15233).
// The reassigned binding aliases its source: a write through one is read through the other.
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const fnMap = Map()
fnMap.set("a", inc0)
fnMap.set("b", half)
let m2 = Map()
m2.set("a", inc0)
const g0 = m2.get("a")
if g0 != null { print(g0(3)) }
m2 = fnMap
const g = m2.get("b")
if g != null { print(g(3)) }
m2.set("c", inc0)
const k = fnMap.get("c")
if k != null { print(k(4)) }
function f() {
  let m3 = Map()
  m3.set("a", half)
  m3 = fnMap
  const h = m3.get("a")
  if h != null { print(h(3)) }
}
f()
