// @run
// @log 11
// @log 21
// @log 31
// @log 41
// @log 51
// @log 61
// @log 21
// @log 51
// @log 41
// @log 61
// @log true
// @log false
// @log 31
// @log 107
// @hint redundant type annotation: `f0` is inferred as `i32`
// @hint redundant type annotation: `f1` is inferred as `i32`
// @hint redundant type annotation: `f2` is inferred as `i32`
// @hint redundant type annotation: `f3` is inferred as `i32`
// @hint redundant type annotation: `f4` is inferred as `i32`
// @hint redundant type annotation: `f5` is inferred as `i32`
// @hint redundant type annotation: `v0` is inferred as `(i32) -> i32`
// @hint redundant type annotation: `v1` is inferred as `(i32) -> i32`
// @hint redundant type annotation: `v2` is inferred as `(i32) -> i32`
// @hint redundant type annotation: `v3` is inferred as `(i32) -> i32`
// @hint redundant type annotation: `v4` is inferred as `(i32) -> i32`
// @hint redundant type annotation: `v5` is inferred as `(i32) -> i32`
// @hint redundant type annotation: `fs` is inferred as `(i32) -> i32[]`
// @hint redundant type annotation: `hs` is inferred as `{op: (i32) -> i32, tag: i32}[]`
// @hint redundant type annotation: `g` is inferred as `(i32) -> i32`
// A function value carries its callee as a wasm function INDEX, and that one field is
// read by BOTH the call and the `==` identity compare. Six SAME-SIGNATURE functions are
// each reached through a value, so a dispatch that landed on the wrong slot reaches a
// function the signature check accepts and the program keeps running with wrong numbers
// — the failure mode no validator can see. The offsets are 10 apart and every call
// passes 1, so each printed value names exactly which function ran. Verified sensitive:
// biasing the dispatch mapping by the import count makes the first two lines print
// 51 and 61 instead of 11 and 21.
//
// The same six are then reached through an array element and a struct field (the other
// two lowerings that read the field), and the identity compare is checked against a call
// on the SAME binding, so a change that broke the id's meaning for one use and not the
// other cannot pass. The last line closes over a local, which is the env field.

function f0(x: i32): i32 {
  return x + 10
}
function f1(x: i32): i32 {
  return x + 20
}
function f2(x: i32): i32 {
  return x + 30
}
function f3(x: i32): i32 {
  return x + 40
}
function f4(x: i32): i32 {
  return x + 50
}
function f5(x: i32): i32 {
  return x + 60
}

type Holder = { op: (i32) => i32, tag: i32 }

function go() {
  // Each function reached through a value binding: the printed value names the callee.
  const v0: (i32) => i32 = f0
  const v1: (i32) => i32 = f1
  const v2: (i32) => i32 = f2
  const v3: (i32) => i32 = f3
  const v4: (i32) => i32 = f4
  const v5: (i32) => i32 = f5
  print(v0(1)) // 11
  print(v1(1)) // 21
  print(v2(1)) // 31
  print(v3(1)) // 41
  print(v4(1)) // 51
  print(v5(1)) // 61

  // The same callees as ARRAY elements, indexed out of order so position and identity
  // cannot be confused.
  const fs: ((i32) => i32)[] = [f0, f1, f2, f3, f4, f5]
  print(fs[1](1)) // 21
  print(fs[4](1)) // 51

  // ...and as a STRUCT FIELD.
  const hs: Holder[] = [{ op: f3, tag: 3 }, { op: f5, tag: 5 }]
  print(hs[0].op(1)) // 41
  print(hs[1].op(1)) // 61

  // Identity and dispatch read the same field: the compare must agree with the call.
  const g: (i32) => i32 = f2
  print(g == v2) // true
  print(g == v3) // false
  print(g(1)) // 31

  // A capturing lambda — the env is the other field of the same record.
  const k = 100
  const c = (x: i32) => x + k
  print(c(7)) // 107
}

go()
