// @log 4
// A hole lambda called first at one type, put into an un-annotated list or record literal and
// called through it at another, runs with its copy at the container's call type (D6474). Top
// level, in a plain body, and in a generic body with a captured binding, at two instances.
function inList<T>(x: T, y: T) {
  let v = x
  const h = (u) => {
    print(v); print(u)
  }
  h("s")
  const fs = [h]
  v = y
  fs[0](3)
}
function plain() {
  const h = (u) => {
    print(u)
  }
  h("s")
  const fs = [h]
  fs[0](3)
}
function twoInstances<T>(x: T) {
  const h = (u) => {
    print(x); print(u)
  }
  h("s")
  const fs = [h]
  fs[0](3)
}
function inRecord<T>(x: T, y: T) {
  let v = x
  const h = (u) => {
    print(v); print(u)
  }
  h("s")
  const r = { f: h }
  v = y
  r.f(3)
}
inList(7, 8)
plain()
twoInstances(7)
twoInstances("q")
const top = (u) => {
  print(u)
}
top("s")
const tr = { f: top }
tr.f(3)
inRecord(7, 8)
const id = (u) => {
  return u
}
print(id("s"))
const ids = [id]
print(ids[0](3) + 1)
function throughAliases<T>(x: T, y: T) {
  let v = x
  const h = (u) => {
    print(v); print(u)
  }
  h("s")
  const k = h
  const k2 = k
  const fs = [k2]
  const r = { f: k }
  v = y
  fs[0](3)
  r.f(4)
}
throughAliases(7, 8)
