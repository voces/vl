// @run
// @log 3.5
// @log 5
// @log 1
// @log 5.5
// @log 3
// A closure built at one closure rep and stored into a global, passed as an argument and read from
// a global at another, both the uniform closure, is the value it holds at each step.
function adder(n) { return (a) => a + n }
const x = adder(1.5)
print(x(2.0))
const v = adder(2)
print(v(3))
function id(a) { return a }
const lap = (g) => g(1)
function use(k) { return k(id) }
print(use(lap))
function mk() { return (a) => a + 2.5 }
function take(a: (a: i32) => f64) { print(a(3)) }
function half(a: (a: f64) => f64) { print(a(0.5)) }
take(mk())
const z = mk()
half(z)
