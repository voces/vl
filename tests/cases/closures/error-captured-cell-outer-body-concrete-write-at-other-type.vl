// @emit-error the reassigned function binding `k` holds functions called at more than one argument type
// A concrete function written in the generic body into a cell wanted at boolean (review of #3498, `rv3498/z22_concrete_const_outer_body_write_bool`).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function a<T>(x: T) {
  let k = inner
  const f: (n: i32) => void = other
  const rd = () => {
    k(x)
  }
  k = f
  rd()
}
a(1)
a(true)
