// @run
// @log 1
// @log s
// @log 1
// @log s
// @log 2
// @log 2.5
// @log t
// @log 2.5
// @log t
// @log 1
// @log 3
// @log u
// @log 4
// @log v
// @log 5
// @log w
// A list element or record field holding one generic, read other than by a direct call: bound to
// a name, through a nested record, by `for … in`, beside a `length` read, spread into another
// list, and inside a function body. Each read takes its own instance (D4124).
function id<T>(x: T): T { x }
const fs = [id]
const g = fs[0]
print(g(1))
print(g("s"))
const nr = { a: { f: id } }
print(nr.a.f(1))
print(nr.a.f("s"))
const ls = [id, id]
print(ls.length)
for f in ls {
  print(f(2.5))
  print(f("t"))
}
const ra = { f: id, n: 3 }
const h = ra.f
print(h(1))
print(ra.n)
print(h("u"))
const sp = [...fs]
print(sp[0](4))
print(sp[0]("v"))
function go() {
  const fl = [id]
  for k in fl {
    print(k(5))
    print(k("w"))
  }
}
go()
