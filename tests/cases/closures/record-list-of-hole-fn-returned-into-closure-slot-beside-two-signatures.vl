// @run
// A list of records holding an un-annotated function, returned by a function called once into a
// binding typed at closures, beside another list of it called at two signatures (D15900).
function id(a) { return a }
const xs = [{ f: id }]
function twoSigs(k: i32): f64 {
  const n: i32 = xs[k].f(2)
  return n + xs[k].f(2.5)
}
function deliver() {
  return [{ f: id }]
}
const v: { f: (a: f64) => f64 }[] = deliver()
print(twoSigs(0) + v[0].f(2.5))
function main() {
  const ys = [{ f: id }]
  const n: i32 = ys[0].f(2)
  const w: { f: (a: f64) => f64 }[] = deliver2()
  print(n + ys[0].f(2.5) + w[0].f(2.5))
}
function deliver2() {
  return [{ f: id }]
}
main()
// @log 7
// @log 7
