// @run
// @log 0
// @hint Intentionally-unused function `_withRecord`
// @hint Intentionally-unused function `_withList`
// A closure parameter whose result unions a string literal-union alias with a record or a list,
// called in functions no producer of that closure type reaches: the alias is one scalar atom of
// the mixed union, so the call keys the union box from the annotation (D16910).
type K0 = "6" | "x"
function _withRecord(f: () => K0 | {w: i32}) {
  const t1 = f()
  if t1 is {w: i32} { print(t1.w) } else { print(t1) }
}
function _withList(f: () => K0 | i32[]) {
  const t1 = f()
  if t1 is i32[] { print(t1.length) } else { print(t1) }
}
print(0)
