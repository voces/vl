// @run
// @hint Intentionally-unused parameter `_gb` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_g` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_g` (leading `_` marks it unused)
// @log 1
// @log 2.5
// @log 4
// @log 4
// @log 1
// @log 2.5
// @log 1
// @log 2
// @log 2.5
// One read of a forwarded hole handed to two hole parameters of list elements, each element
// calling its own parameter at its own key, is handed a slot per key (D13321).
function add(a, b) { return a + b }
function apply2(g, _gb, s) { print(g(s, s)) }
function apply4(_g, gb, s) { print(gb(s, 2)) }
function innerThree(k, h) {
  for f in [apply2, apply4] { f(h, h, k) }
}
innerThree(0.5, add)
innerThree(2, add)
// The list bound to a `const`.
function viaConst(k, h) {
  const gs = [apply2, apply4]
  for f in gs { f(h, h, k) }
}
viaConst(0.5, add)
// One element calling both parameters, the second at a third key.
function both(g, gb, s) {
  print(g(s, s))
  print(gb(1, 1))
}
function second(_g, gb, s) { print(gb(s, 2)) }
function viaBoth(k, h) {
  for f in [both, second] { f(h, h, k) }
}
viaBoth(0.5, add)
