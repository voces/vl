// @run
// @log B
// @log r
// @log B
// @log p
// A written `let` of generics called with a string literal union and with a `string` holds one
// signature: the union's values are strings, so the call passes it as one (D4244).
function gA<U>(u: U) {
  print("A")
  print(u)
}
function gB<V>(v: V) {
  print("B")
  print(v)
}
type S = "p" | "q"
const a: S = "p"
let x = gA
x = gB
x("r")
x(a)
