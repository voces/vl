// @run
// @log s
// @log 3
// @log 2.5
// @log t
// A generic function declared inside another, held in a local record or list and called through
// it at two types, is a member of the set its calls go through, dispatched by its declaration.
function main() {
  function add<T>(x: T): T { x }
  const c = { f: add }
  print(c.f("s"))
  print(c.f(3))
}
main()

function other() {
  function id<T>(x: T): T { x }
  const gs = [id]
  print(gs[0](2.5))
  print(gs[0]("t"))
}
other()
