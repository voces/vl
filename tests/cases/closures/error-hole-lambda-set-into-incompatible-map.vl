// @error cannot assign (_) => _ to (string) => string
// A hole lambda stored by `.set` into a map of a function type its body cannot take is refused,
// as `m[k] = v` and `push` refuse it (D3881).
const tw = (y) => y * 3
const ms: {[string]: (y: string) => string} = Map()
ms.set("a", tw)
print("x")
