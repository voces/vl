// @run
// @log 7
// @log 8
// @log 9
// @log 6
// @log 10
// @log 2.5
// A lambda handed to `.map` over a list of un-annotated functions, annotated or not, calls each
// element directly at the lambda's own arguments, inline or through a named function (D14438).
function inc2(a) { return a + 2 }
const v2 = [inc2]
print(v2.map((r: (a: i32) => i32) => r(5))[0])
function inc3(a) { return a + 3 }
const v3 = [inc3]
function ap(r: (a: i32) => i32) { return r(5) }
print(v3.map((r: (a: i32) => i32) => ap(r))[0])
function inc4(a) { return a + 4 }
function main() {
  const v = [inc4]
  print(v.map((r: (a: i32) => i32) => r(5))[0])
}
main()
function inc1(a) { return a + 1 }
const v1 = [inc1]
print(v1.map((r) => r(5))[0])
function dbl(a) { return a * 2 }
const two = [inc1, dbl]
print(two.map((r) => r(5))[1])
function half(a) { return a / 2.0 }
const hs = [half]
print(hs.map((r) => r(5.0))[0])
