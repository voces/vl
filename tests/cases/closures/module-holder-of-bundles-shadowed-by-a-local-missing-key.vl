// Missing-key variant of `module-holder-of-bundles-shadowed-by-a-local`: the holder reads key `z`, so it holds null.
// A local `x` in the reading function shadows the module holder and is no use of it (D17111).
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
const m = Map()
m["a"] = lap((a) => a + 1)
const x = m["z"]
function g() {
  const x = 7
  return x + 1
}
function h() {
  if x != null { return x(4) }
  return 0
}
print(g())
print(h())
function g2() {
  const x = (a: f64): f64 => a * 10.0
  return x(1.5)
}
function h2() {
  if x != null { return x(4) }
  return 0
}
print(g2())
print(h2())
// @hint Intentionally-unused variable `_a`
// @hint Intentionally-unused variable `_b`
