// @emit-error the reassigned function binding `x` holds functions called at more than one argument type
// A list holding a written `let` of generics is called at the type the list's element calls
// give it, so a call of the `let` at another type is refused (D3978, D4240).
function gA<U>(u: U) {
  print("A")
  print(u)
}
function gB<V>(v: V) {
  print("B")
  print(v)
}
let x = gA
x = gB
const y = [x]
x(2)
y[0](true)
