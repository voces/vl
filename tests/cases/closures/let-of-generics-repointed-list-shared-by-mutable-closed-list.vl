// @run
// @log ss
// @log 2
// @log 82
// A re-pointed `let` read after its last write holds that one generic, so a list of it shares
// a mutable list of a closed function type as a list naming the generic does (D15956).
function id<T>(x: T): T { return x }
function dbl<T>(x: T): T { return x + x }
let f = id
f = dbl
print(f("s"))
print(f(1))
const zs = [f]
const ys: ((x: i32) => i32)[] = zs
print(ys[0](41))
