// @run
// @log 4
// @log 1.5
// @log 0
// @log 1.5
// @log 4
// @log 6
// @log 9
// @log 0.75
// @log 9
// @log -1
// @log 9
// A map written records whose function fields hold un-annotated functions of different results,
// each called through `?.` on a `.get`: each entry's call runs the member it holds, and an absent
// key takes the fallback (D16743).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function dbl(a) { return a * 2 }
function tri(a) { return a * 3 }
function quart(a) { return a / 4.0 }
function sq(a) { return a * a }
const m = Map()
m.set("a", { f0: inc0, g: dbl })
m.set("b", { f0: half, g: inc0 })
print(m.get("a")?.f0(3) ?? 0)
print(m.get("b")?.f0(3) ?? 0)
print(m.get("z")?.f0(3) ?? 0)
const r = m.get("b")
print(r?.f0(3) ?? 0)
print(m.get("b")?.g(3) ?? 0)
print(m.get("a")?.g(3) ?? 0)
const n = Map()
n.set("a", { f0: tri })
n.set("b", { f0: quart })
n.set("c", { f0: sq })
for k in ["a", "b", "c", "d"] { print(n.get(k)?.f0(3) ?? -1) }
const e = n.get("b")
if e != null { e.f0 = tri }
print(n.get("b")?.f0(3) ?? 0)
