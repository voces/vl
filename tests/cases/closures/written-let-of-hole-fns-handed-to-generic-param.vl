// @run
// @hint Intentionally-unused parameter `_a` (leading `_` marks it unused)
// @log s
// @log 4
// A re-pointed `let` of un-annotated functions whose results differ, handed to a generic
// `(x: T) => R` parameter whose result is their join, dispatches on the function it holds
// (D16098).
function inc(a) { return a + 1 }
function str(_a) { return "s" }
function app<T, R>(g: (x: T) => R, v: T): R { return g(v) }
function run(c: boolean) {
  let f = inc
  if c { f = str }
  print(app(f, 3))
}
run(true)
run(false)
