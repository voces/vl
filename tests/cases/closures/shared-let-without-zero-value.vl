// @run
// @log 7
// @log 8
// @log 9
// @log 10
// @log 11
// @log 12
// @log 13
// A `let` with no initializer whose type has no zero value, captured by a closure and assigned
// after the capture, is shared through a `T | null` cell the first write fills (D2340, D3371).
type P = { x: i32 }
type U = { a: i32 } | { b: string }
function go() {
  let r: P
  const gr = () => r.x
  r = { x: 7 }
  print(gr())
  let u: U
  const gu = () => {
    if u is { a: i32 } { return u.a }
    0
  }
  u = { a: 8 }
  print(gu())
  let f: (n: i32) => i32
  const gf = () => f(9)
  f = (n: i32) => n
  print(gf())
  let xs: i32[]
  const gx = () => {
    xs.push(10)
  }
  xs = []
  gx()
  print(xs[0])
  let m: { [string]: i32 }
  const gm = () => m.get("a") ?? 0
  m = Map()
  m.set("a", 11)
  print(gm())
  let v: i32 | string
  const sv = () => {
    v = 12
  }
  sv()
  v = 12
  if v is i32 { print(v) }
  let n: P | null
  const gn = () => if n == null { 0 } else { n.x }
  n = { x: 13 }
  print(gn())
}
go()
