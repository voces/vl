// @run
// @log 6
// @log 7
// @log 1
// @log 11
// @log 16
// @log 10
// @log 6
// @log 6
// @log 6
// @log 6
// @log 2.5
// @log hi!
// @log 107
// @log 6
// @log 6
// A named function handed to `.map` / `.filter` over a list of un-annotated functions gives
// each element the type of its own parameter, declared or inferred, so the elements are built
// at that signature and the result reads at the callback's result (D9766, D9761).
function inc(a) { return a + 1 }
function ap(r: (a: i32) => i32) { return r(5) }
const v = [inc]
print(v.map(ap)[0])

function inc2(a) { return a + 2 }
function apU(r) { return r(5) }
const v2 = [inc2]
const o2 = v2.map(apU)
print(o2[0])

function inc3(a) { return a + 1 }
function p(r) { return r(5) == 6 }
const v3 = [inc3]
const k = v3.filter(p)
print(k.length)
print(k[0](10))

function add(a) { return a + 11 }
function dbl(a) { return a * 2 }
const two = [add, dbl]
function apT(r) { return r(5) }
const o3 = two.map(apT)
print(o3[0])
print(o3[1])

function inc4(a) { return a + 1 }
const pushed = []
pushed.push(inc4)
print(pushed.map(ap)[0])

function inc5(a) { return a + 1 }
const m = Map()
m["k"] = [inc5]
const l = m["k"] ?? []
function apM(r) { return r(5) }
print(l.map(apM)[0])

function inc6(a) { return a + 1 }
const nested = [[inc6]]
function apN(r) { return r[0](5) }
print(nested.map(apN)[0])

function inc7(a) { return a + 1 }
const rec = { fs: [inc7] }
print(rec.fs.map(ap)[0])

function half(a) { return a / 2.0 }
function apF(r) { return r(5.0) }
const hs = [half]
print(hs.map(apF)[0])

function ex(a) { return a + "!" }
function apS(r) { return r("hi") }
const es = [ex]
print(es.map(apS)[0])

function inc8(a) { return a + 1 }
function twice(r: (a: i32) => i32) { return r(5) + r(100) }
const v8 = [inc8]
print(v8.map(twice)[0])

// Controls: a lambda callback, and an annotated element.
function inc9(a) { return a + 1 }
const v9 = [inc9]
print(v9.map((r) => r(5))[0])
function incA(a: i32) { return a + 1 }
const vA = [incA]
print(vA.map(apU)[0])
