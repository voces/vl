// @error cannot write 'half' to 'm[].f': called at (i32) it returns f64, where 'inc0', also written to it, returns i32 — every function a call through 'm[].f' may run must return one type
// Records holding un-annotated functions of different results, written into one un-annotated
// `Map()` and read back through a binding, are refused as the same pair in a list is (D9370).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const m = Map()
m.set("a", { f: inc0 })
m.set("b", { f: half })
const r = m.get("b")
if r != null { print(r.f(3)) }
