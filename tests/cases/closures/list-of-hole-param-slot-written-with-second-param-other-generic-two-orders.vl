// @log 1
// @log 5
// D15572 at two instances, the two generics in either order.
function id<T>(x: T): T { x }
function id2<U>(x: U): U { x }
function use(ys) { print(ys.length) }
function take(a, b) {
  const xs = [a]
  xs[0] = b
  use(xs)
  print(xs[0]("abc").length + xs[0](2))
}
take(id, id2)
take(id2, id)
