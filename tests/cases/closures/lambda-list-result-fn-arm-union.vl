// @run
// @log 1
// @log 3
// @log false
// @log 4
// @log 1
// @log 9
// @log 1
// @log true
// @log 2
// @log 6
// @log 1
// @log 8
// @log 7
// A lambda returning a list literal, at a list result whose element union holds a function arm,
// builds its list at that union (D16905).
const v: () => ((() => i32) | boolean)[] = () => [false]
print(v().length)
const w: () => ((() => i32) | boolean)[] = () => [() => 3]
const w0 = w()[0]
if w0 is boolean { print(0) } else { print(w0()) }
const m: () => ((() => i32) | boolean)[] = () => [false, () => 4]
for x in m() {
  if x is boolean { print(x) } else { print(x()) }
}
function ap(f: () => ((() => i32) | boolean)[]) { return f().length }
print(ap(() => [false]))
function call0(f: () => ((() => i32) | boolean)[]) {
  const x = f()[0]
  if x is boolean { return 0 }
  return x()
}
print(call0(() => [() => 9]))
const n: () => ((() => i32[]) | boolean)[] = () => [false]
print(n().length)
const t: () => ((() => i32) | boolean)[] = () => [true]
const t0 = t()[0]
if t0 is boolean { print(t0) } else { print(t0()) }
function mk(): () => ((() => i32) | boolean)[] { return () => [false, false] }
print(mk()().length)
type H = {g: () => ((() => i32) | boolean)[]}
const h: H = { g: () => [() => 6] }
const h0 = h.g()[0]
if h0 is boolean { print(0) } else { print(h0()) }
const q: (() => ((() => i32) | boolean)[]) | null = () => [false]
if q != null { print(q().length) }
const nest: () => ((() => i32) | boolean)[][] = () => [[false], [() => 8]]
const n1 = nest()[1][0]
if n1 is boolean { print(0) } else { print(n1()) }
const fs: (() => ((() => i32) | boolean)[])[] = [() => [false], () => [() => 7]]
const f1 = fs[1]()[0]
if f1 is boolean { print(0) } else { print(f1()) }
