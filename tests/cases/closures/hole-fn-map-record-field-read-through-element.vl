// @run
// @log 4
// @log 4
// @log 4
// A map of un-annotated functions read straight through the record field of a map value or a
// list element, without a binding for the record, carries the functions' signature (D9252, D9253).
function inc0(a) { return a + 1 }
const hm = Map()
hm["k"] = inc0
const mm = Map()
mm["k"] = { m: hm }
if mm["k"] != null {
  const x = mm["k"].m["k"]
  if x != null { print(x(3)) }
}
const xs = [{ m: hm }]
const y = xs[0].m["k"]
if y != null { print(y(3)) }
function use() {
  const ys = [{ m: hm }]
  const z = ys[0].m["k"]
  if z != null { print(z(3)) }
}
use()
