// @run
// @log 4
// @log 3.5
// @log 4
// @log 3.5
// @log 4
// @log 3.5
// @log 13
// @log 12.5
// @log 30
// @log 25
// @log 13
// @log 12.5
// @log s
// @log 30
// @log 25
// @log true
// A lambda called at two signatures through a parameter, one of the calls made from a closure
// nested two or three deep that captures the parameter: each frame on the way re-captures the
// one record, at each instance of the function that binds it.
function two(f) {
  print(f(3))
  const h = () => {
    const j = () => f(2.5)
    return j()
  }
  print(h())
}
function three(f) {
  print(f(3))
  const h = () => {
    const j = () => {
      const m = () => f(2.5)
      return m()
    }
    return j()
  }
  print(h())
}
function middle(f) {
  const h = () => {
    print(f(3))
    const j = () => f(2.5)
    return j()
  }
  print(h())
}
function go(k: i32) {
  two((a) => a + k)
  three((a) => a + k)
  middle((a) => a + k)
}
go(1)
function twice(k: i32) {
  two((a) => a + k)
  two((a) => a * k)
}
twice(10)
function deepIn<T>(f, t: T) {
  print(f(3))
  const h = () => {
    const j = () => f(2.5)
    return j()
  }
  print(h())
  print(t)
}
function generic(k: i32) {
  deepIn((a) => a + k, "s")
  deepIn((a) => a * k, true)
}
generic(10)
