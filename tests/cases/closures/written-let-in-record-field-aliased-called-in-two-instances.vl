// @run
// @log R
// @log 3
// @log R
// @log s
// @log A
// @log 4
// @log A
// @log t
// @log L
// @log 5
// @log L
// @log 5
// @log L
// @log u
// @log L
// @log u
// A record field holding a `let` first bound to a generic and written with a lambda, read into
// an alias inside a generic called at two types, is called through the alias at each instance's
// own type: a `const`, an alias of the alias, an unwritten `let`, and inside a lambda (D7283).
function other<V>(v: V) { print("O"); print(v) }
function viaConst<T>(x: T) {
  let k = other
  k = (n) => {
    print("R"); print(n)
  }
  const o = { f: k }
  const h = o.f
  h(x)
}
function viaAliasOfAlias<T>(x: T) {
  let k = other
  k = (n) => {
    print("A"); print(n)
  }
  const o = { f: k }
  let h = o.f
  const h2 = h
  h2(x)
}
function inLambda<T>(x: T) {
  let k = other
  k = (n) => {
    print("L"); print(n)
  }
  const o = { f: k }
  const h = o.f
  h(x)
  const q = () => h(x)
  q()
}
viaConst(3)
viaConst("s")
viaAliasOfAlias(4)
viaAliasOfAlias("t")
inLambda(5)
inLambda("u")
