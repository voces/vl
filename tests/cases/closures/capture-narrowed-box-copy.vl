// @run
// @hint redundant type annotation: `zz` is inferred as `({r: i32} | string | null)[]` — remove it to lean on inference
// @hint redundant type annotation: `qs` is inferred as `(i32 | string | null)[]` — remove it to lean on inference
// @log true
// @log false
// @log 4
// @log -1
// @log 5
// @log -1
// @log 6
// @log -1
// D3120, D3135, D3139: a closure capturing an un-annotated copy of a value narrowed out of a
// box types its env field as the copy's own cell: `K` from a parameter, `Circle | null` and
// `i32 | null` from a walk variable, in a function and at module scope.
type K = "a" | "b"
type Circle = { r: i32 }
function showC(w: Circle | null) {
  if w == null { return 0 - 1 }
  return w.r
}
function showI(x: i32 | null) {
  if x == null { return 0 - 1 }
  return x
}
function t(e: K | i32) {
  if !(e is i32) {
    const c = e
    const f = () => c == "b"
    print(f())
  }
}
t("b")
t("a")
const zz: (Circle | null | string)[] = [{ r: 4 }, null, "s"]
for e in zz {
  if !(e is string) {
    const c = e
    const f = () => showC(c)
    print(f())
  }
}
function u(ys: (i32 | null | string)[]) {
  for y in ys {
    if !(y is string) {
      const c = y
      const f = () => showI(c)
      print(f())
    }
  }
}
u([5, null, "s"])
const qs: (i32 | null | string)[] = [6, null, "s"]
for q in qs {
  if !(q is string) {
    const c = q
    const f = () => showI(c)
    print(f())
  }
}
