// @run
// @log 5
// @log 5 2.5
// @log 2
// @log 5
// @log 5 2.5 x
// @log x
// @log 5 2.5
// @log 4
// @log 5
// @log 5 2.5 2
// @log 2
// @log 2
// @log 3
// @hint Intentionally-unused variable `_a`
// @hint Intentionally-unused variable `_b`
// @hint Intentionally-unused variable `_t`
// A plain function handing back a record of one closure per signature, called inside a lambda:
// the lambda's body runs under the keys of the function enclosing it, at the top level, in each
// instance of a generic function, nested, capturing, or handed away.
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
function gen<T>(t: T, k: i32) {
  const r = lap((a) => a + k)
  const _t = t
  return r
}
function deliver() { return gen("s", 1) }
const top = () => {
  const u = deliver()
  print(u(4))
}
top()
function call(f: () => f64) { print(f()) }
function run<T>(t: T, k: i32) {
  const g = () => {
    const h = () => {
      const u = deliver()
      print("\{u(4)} \{u(1.5)}")
    }
    h()
  }
  g()
  const c = () => {
    const u = deliver()
    print(u(k))
  }
  c()
  call(() => {
    const u = deliver()
    return u(4)
  })
  // Each instance's own key: the lambda captures `t`, so the two bodies differ.
  const own = () => {
    const u = deliver()
    print("\{u(4)} \{u(1.5)} \{t}")
  }
  own()
  print(t)
}
run("x", 1)
run(2, 3)
const xs = [1, 2]
for x in xs {
  const g = () => {
    const u = deliver()
    print(u(x))
  }
  g()
}
