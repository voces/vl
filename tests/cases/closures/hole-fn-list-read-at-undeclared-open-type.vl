// @run
// @log 6
// @log 2.5
// @log 4
// @log 8
// @log 8
// @log 8
// @log 8
// @hint Intentionally-unused parameter `_n` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_n` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_n` (leading `_` marks it unused)
// A `let` list of un-annotated functions, or of lists of them, read in an instance body at the
// open type its holes leave: returned whole, indexed, and re-pointed through one slot.
function inc(a) { return a + 1 }
function dbl(a) { return a * 2 }
function nested(_n) {
  let w = [[inc], [dbl]]
  w = [[dbl], [inc]]
  return w
}
print(nested(1)[0][0](3))
print(nested("s")[1][0](1.5))
function flat(_n) {
  let u = [inc, dbl]
  u = [dbl, inc]
  return u
}
function take(a) { print(a[1](3)) }
take(flat(1))
function inner(_n) {
  let w = [[inc, dbl]]
  const row = w[0]
  print(row[1](4))
  w = [[dbl, inc]]
  print(w[0][0](4))
}
inner(1)
inner("s")
