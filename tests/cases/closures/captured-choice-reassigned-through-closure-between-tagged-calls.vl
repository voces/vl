// @run
// @log I
// @log true
// @log O
// @log false
// A captured choice of functions kept as its set's id, called through a closed function type before
// and after a closure reassigns it, runs the member it holds at each call.
function inner<U>(u: U) {
  print("I")
  print(u)
}
function other<V>(v: V) {
  print("O")
  print(v)
}
function cb(f: (b: boolean) => void, b: boolean) { f(b) }
function main() {
  let k = inner
  const flip = () => {
    return k = other
  }
  const r = k
  cb(r, true)
  flip()
  const s = k
  cb(s, false)
}
main()
