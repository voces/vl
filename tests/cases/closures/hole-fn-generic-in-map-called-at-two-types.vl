// @run
// @log 2
// @log s
// @log 2
// @log s
// @log 4
// @log true
// @log none
// @log 3
// @log t
// @log true
// @log 1
// @log 7
// @log 3
// @log q
// @log 4
// @log 2.5
// @log 2
// @log x
// @log 2
// @log s
// A generic function held in an un-annotated `Map()`, bare or in a record value, written
// by index or `.set` and read by index or `.get`, runs when called at two types (D9310).
function id<T>(x: T): T { x }
function dup<T>(x: T): T[] { [x, x] }
const m = Map()
m["k"] = { f: id }
const r = m["k"]
if r != null {
  print(r.f(2))
  print(r.f("s"))
}
const b = Map()
b.set("k", id)
const g = b.get("k")
if g != null {
  print(g(2))
  print(g("s"))
}
const n = Map()
n["k"] = { f: id }
const s = n.get("k")
if s != null {
  print(s.f(4))
  print(s.f(true))
}
const z = Map()
z["k"] = { f: id }
const zr = z["z"]
if zr != null {
  print(zr.f(2))
  print(zr.f("s"))
} else {
  print("none")
}
const zq = z["k"]
if zq != null {
  print(zq.f(3))
  print(zq.f("t"))
}
print(z.has("k"))
print(z.length)
const o = Map()
o["k"] = { f: id }
print(o["z"]?.f(2) ?? 7)
print(o["k"]?.f(3) ?? 7)
print(o["k"]?.f("q") ?? "w")
const ov = o["k"]?.f(4)
if ov != null { print(ov) }
const ot = o["k"]
const ou = ot?.f(2.5)
if ou != null { print(ou) }
const d = Map()
d.set(1, dup)
const dg = d.get(1)
if dg != null {
  print(dg(5).length)
  print(dg("x")[1])
}
function main() {
  const q = Map()
  q.set("k", { f: id })
  const e = q.get("k")
  if e != null {
    print(e.f(2))
    print(e.f("s"))
  }
}
main()
