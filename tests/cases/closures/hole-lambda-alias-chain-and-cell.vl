// @run
// @log aC
// @log aC
// @log aC
// @log aC
// @log aE
// @log aE
// @log aE
// @log 5
// @log b2
// @log aC
// @log aE
// @log aC
// @log set
// @log aE
// @info `d` is never reassigned; use `const` instead of `let`
// @info `d` is never reassigned; use `const` instead of `let`
// @info `d2` is never reassigned; use `const` instead of `let`
// @info `d` is never reassigned; use `const` instead of `let`
// @info `d3` is never reassigned; use `const` instead of `let`
// A hole lambda reached through a chain of aliases with a `let` in it is instantiated at the
// call (D3844), and so is one reached through the capture cell of a `let` written after a
// closure captured it, where each read is `d[0]` (D3845).
type A = { v: i32 }

// `const` then `let`, and `let` then `let`.
function chain(x: string) {
  const c = (y) => y + "C"
  const c2 = c
  let d = c2
  d(x)
}
print(chain("a"))
function letOfLet(x: string) {
  const c = (y) => y + "C"
  let d = c
  let d2 = d
  d2(x)
}
print(letOfLet("a"))
function threeLinks(x: string) {
  const c = (y) => y + "C"
  let d = c
  const d2 = d
  let d3 = d2
  d3(x)
}
print(threeLinks("a"))

// Captured, then written: the closure's call and the frame's own call both go through the cell.
function cell(x: string) {
  const c = (y) => y + "C"
  const e = (y) => y + "E"
  let d = c
  const g = () => d(x)
  print(g())
  d = e
  print(g())
  const r = d(x)
  r
}
print(cell("a"))
function cellNamed(x: string) {
  const c = (y) => y + "C"
  const e = (y) => y + "E"
  let d = c
  function g() { d(x) }
  d = e
  g()
}
print(cellNamed("a"))
function cellRecord(a: A) {
  const c = (y) => y.v + 1
  const e = (y) => y.v + 2
  let d = c
  const g = () => d(a)
  d = e
  g()
}
print(cellRecord({ v: 3 }))

// Two functions with a cell of one name: each assignment pins its own frame's lambda.
function other(x: string) {
  const c = (y) => y + "1"
  const e = (y) => y + "2"
  let d = c
  const g = () => d(x)
  d = e
  g()
}
print(other("b"))

// Written from a nested function, and read and written from two closures.
function flipper(x: string) {
  const c = (y) => y + "C"
  const e = (y) => y + "E"
  let d = c
  function flip() { d = e }
  print(d(x))
  flip()
  const r = d(x)
  r
}
print(flipper("a"))
function twoClosures(x: string) {
  const c = (y) => y + "C"
  const e = (y) => y + "E"
  let d = c
  const g1 = () => d(x)
  const g2 = () => {
    d = e
    "set"
  }
  print(g1())
  print(g2())
  g1()
}
print(twoClosures("a"))
