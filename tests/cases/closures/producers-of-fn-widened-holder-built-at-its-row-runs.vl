// Every producer of a holder whose function field a write widens is built at the holder's row:
// a sibling maker's record holding a widened member (D15274), a value `if`'s arm literals
// (D15302), and a binding read only where it is written, record or bare (D15308).
function id0(a) { return a * 10 }
function id1(a) { return a + 1 }
function id2(a) { return a + 100 }
function id3(a) { return a + 101 }
function mk() { return { f: id1 } }
function mk2() { return { f: id1 } }
const r = mk()
r.f = id0
const s = mk2()
print(r.f(2))
print(r.f(2.5))
print(s.f(7))
const c = 0 > 1
const w = if c { { f: id1 } } else { { f: id2 } }
w.f = id0
print(w.f(2))
print(w.f(2.5))
const q = { f: id2 }
let t = { f: id1 }
t = q
print(t.f(2))
print(t.f(2.5))
const b0 = id2
let b = id1
b = b0
print(b(2))
print(b(2.5))
const q0 = { f: id3 }
const q1 = q0
let u = { f: id1 }
u = q1
print(u.f(2))
print(u.f(2.5))
