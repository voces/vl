// @run
// @log 3
// @log a
// @log b
// @log 1.5
// @log a
// @log a
// @log b
// D4854: a closure capturing the walk variable of a local box-element list literal, whose
// first element is not a string, types its env field as the box.
type K = "a" | "b"
function u() {
  const vs: (string | i32)[] = [3, "a", "b"]
  for e in vs {
    const f = () => e
    print(f())
  }
}
u()
function w() {
  const vs: (string | f64)[] = [1.5, "a"]
  for e in vs {
    const f = () => e
    print(f())
  }
}
w()
function sk(x: K) { return x }
function v() {
  const vs: (K | i32)[] = [3, "a", "b"]
  for e in vs {
    if !(e is i32) {
      const c = e
      const d = c
      const f = () => sk(d)
      print(f())
    }
  }
}
v()
