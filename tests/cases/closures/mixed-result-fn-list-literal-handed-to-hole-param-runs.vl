// @run
// @log 1.5
// @log 1.5
// @log 4
// @log 5.5
// A list literal of un-annotated functions of different results, handed to an un-annotated
// parameter that calls an element, runs: each call through an element runs its own member
// (D15363).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function one(xs) { print(xs[1](3)) }
function both(xs) {
  print(xs[0](3))
  print(xs[1](3))
}
function sum(xs) {
  const t = xs[0](3) + xs[1](3)
  print(t)
}
const xs = [inc0, half]
one(xs)
both([half, inc0])
sum([inc0, half])
