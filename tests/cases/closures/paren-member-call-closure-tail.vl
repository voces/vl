// @run
// @log true
// @log true
// @log true
// A closure whose expression body is a parenthesized member call returns that call's value:
// over a narrowed capture through `?.`, inside a function, and a plain `.` call (D3466).
let a: string | null = null
a = "abc"
const f = () => (a?.includes("b"))
print(f())
function g() {
  let b: string | null = null
  b = "xbz"
  const h = () => (b?.includes("b"))
  print(h())
}
g()
const s = "abc"
const k = () => (s.includes("b"))
print(k())
