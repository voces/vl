// @run
// @log hi
// @log 5
// @log 2.5
// @log hi
// D2867: a function whose inferred return is a call through a function-typed parameter or local
// returns the map that call's type names, not the `i32`-valued map, so a `string`, list or `f64`
// valued map comes back at its own row.
type M = {[string]: string}
const v: M = Map()
v["k"] = "hi"
function hof(f: () => M) { return f() }
const w = hof(() => v)
print(w["k"] ?? "miss")
const l: {[string]: i32[]} = Map()
l["k"] = [4, 5]
function hofl(f: () => {[string]: i32[]}) { f() }
const wl = hofl(() => l)
const e = wl["k"]
if e != null { print(e[1]) }
const d: {[string]: f64} = Map()
d["k"] = 2.5
function loc() {
  const f = () => d
  return f()
}
print(loc()["k"] ?? 0.0)
function viaField(o: {f: () => M}) { return o.f() }
print(viaField({ f: () => v })["k"] ?? "miss")
