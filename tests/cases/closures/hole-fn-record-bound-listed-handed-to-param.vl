// @run
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// @log 4
// @log 2.5
// @log 6
// @log 4
// @log 1.5
// @log 2.5
// @log 3
// @log 4
// @log 4
// A `const` record of an un-annotated function, listed and the element handed to an
// un-annotated parameter that calls the field (D9640), or handed directly beside a record of
// an annotated lambda (D9645), instances the function at the field call's arguments.
function inc0(a) { return a + 1 }
function inc1(a) { return a + 1 }
function inc2(a) { return a + 1 }
function dbl2(a) { return a * 2 }
function inc3(a) { return a + 1 }
function inc4(a) { return a + 1 }
function inc5(a: i32) { return a + 1 }
function inc6(a) { return a + 1 }
function take(a) { print(a.f(3)) }
function takeF(a) { print(a.f(1.5)) }
const e0 = { f: inc0 }
const xs0 = [e0]
take(xs0[0])
const e1 = { f: inc1 }
const xs1 = [e1]
takeF(xs1[0])
const e2a = { f: inc2 }
const e2b = { f: dbl2 }
const xs2 = [e2a, e2b]
take(xs2[1])
function beside(a) { print(a.f(3)) }
const r3 = { f: inc3 }
beside(r3)
beside({ f: (_x: i32): f64 => 1.5 })
function besideF(a) { print(a.f(1.5)) }
const r4 = { f: inc4 }
besideF(r4)
besideF({ f: (x: f64): f64 => x * 2.0 })
// Controls: an annotated function, and the literal written inside the list.
const e5 = { f: inc5 }
const xs5 = [e5]
take(xs5[0])
const xs6 = [{ f: inc6 }]
take(xs6[0])
