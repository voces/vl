// D9383: a second un-annotated function returning the same generic leaves the first one's copy
// per destination in place, at module scope, in a nested function and
// through a `const` alias of the generic.
function same<T>(k: T): T { k }
function d9() { return same }
const v9: (k: i32) => i32 = d9()
const w9: (k: string) => string = d9()
print(w9("q"))
print(v9(2))
function d1() { return same }
const v1: (k: i32) => i32 = d1()
print(v1(3))
function main() {
  function d8() { return same }
  const a: (k: i32) => i32 = d8()
  const b: (k: string) => string = d8()
  print(a(1))
  print(b("b"))
}
main()
function d7() { return same }
const v7: (k: i32) => i32 = d7()
const w7: (k: string) => string = d7()
print(v1(4))
print(w7("w"))
print(v7(9))
function d6() {
  const s = same
  return s
}
const v6: (k: i32) => i32 = d6()
const w6: (k: string) => string = d6()
print(w6("a"))
print(v6(6))
