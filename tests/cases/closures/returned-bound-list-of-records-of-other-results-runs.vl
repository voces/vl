// @run
// @log 1.5
// @log 4
// A bound list of records holding an `i32` function, returned beside a literal holding an `f64`
// one, runs at the joined result.
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function mixed(b) {
  const a = [{ fs: [inc0] }]
  if b { return a }
  return [{ fs: [half] }]
}
print(mixed(false)[0].fs[0](3))
print(mixed(true)[0].fs[0](3))
