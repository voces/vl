// @run
// @log 4
// @log 1.5
// @log 1.5
// @log 1.5
// @log 0
// @log 4
// A `?.` call through the function field of a list's records whose functions return different
// types runs the member stored there, chosen at run time: an element by index, by `.get`, a
// `.get` bound first, a returned list, and a `.get` past the end giving the default (D15801).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function two() { [1, 2].length }
function mk() { return [{ f: inc0 }, { f: half }] }
const rs = [{ f: inc0 }, { f: half }]
print(rs[two() - 2]?.f(3))
print(rs.get(two() - 1)?.f(3) ?? 0.0)
const e = rs.get(two() - 1)
print(e?.f(3) ?? 0.0)
print(mk().get(two() - 1)?.f(3) ?? 0.0)
print(rs.get(two() + 5)?.f(3) ?? 0.0)
print(mk()[two() - 2]?.f(3))
