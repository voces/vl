// @run
// @log 4
// @log ran
// @log 4
// @log 4
// A hole lambda called inside a labelled block's break value, and one stored in a list a call
// goes through, both run at the call's types. The labelled block leaves a binding with no
// initializer, which the capture-cell retyping walks past (D3851).
function apply(f: (y: i32) => i32, v: i32) { f(v) }
function inBreak(x: i32) {
  const c = (y) => y + 1
  const r = @B { break @B c(x) }
  print(r)
}
inBreak(3)
function throughList(x: i32) {
  const c = (y) => {
    print("ran")
    y + 1
  }
  const fs = [c]
  print(fs[0](x))
}
throughList(3)
const k = (y) => y + 1
const r = @B { break @B apply(k, 3) }
print(r)
