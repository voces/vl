// @error operator '+' is not defined for f64 and string
// A forwarded hole function called by its callee with arguments its body cannot type is
// refused at the call, as the direct call is (D13201).
function add(a, b) { return a + b }
function apply3(g, s) {
  print(g(10, 20))
  print(g(s, "x"))
}
function inner(k, h) { apply3(h, k) }
inner(0.5, add)
