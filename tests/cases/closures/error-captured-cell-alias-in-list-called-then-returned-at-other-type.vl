// @emit-error the reassigned function binding `k` holds functions called at more than one argument type
// A list element that aliases a cell's read is called through the cell, so a call at one type and a return at another are one cell's two signatures, refused (review of #3501, `rv3501/round2/q05c_alias_list_return`).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function cb(f: (b: boolean) => void, b: boolean) { f(b) }
function mk(): (b: boolean) => void {
  let k = inner
  const flip = () => {
    k = other
  }
  const r = k
  const fs = [r]
  fs[0](3)
  return r
}
mk()(true)
