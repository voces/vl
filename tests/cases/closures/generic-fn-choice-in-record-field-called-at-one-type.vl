// @run
// @log ss
// @log ss
// @log ss
// @log ss
// @log 6
// A record field holding an `if` or `match` choice between generic functions keeps the set's
// id, so a call through it reaches the chosen member at the call's own type, whether the field
// holds the choice itself or a binding of it, and at one type or two.
function idg<T>(t: T): T { return t }
function kg<T>(t: T): T { return t + t }
const c = [1].length > 0
const n = [1].length
const r = { h: if c { kg } else { idg } }
print(r.h("s"))
const m = {
  h: match n {
    1 => kg
    _ => idg
  },
}
print(m.h("s"))
const g = if c { kg } else { idg }
const b = { h: g }
print(b.h("s"))
const w = { h: if c { kg } else { idg } }
print(w.h("s"))
print(w.h(3))
