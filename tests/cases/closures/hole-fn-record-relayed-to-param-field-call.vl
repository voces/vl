// @run
// @log 4
// @log 4
// @log 4
// @log 4
// @log 4
// @log 4
// @log 4
// @log 1.5
// @log 4
// @log 30
// @log 4
// @log 4
// @hint Intentionally-unused parameter `_x`
// @hint redundant type annotation: `inc10` is inferred as `i32`
// A record of an un-annotated function reaching an un-annotated parameter that calls the field,
// directly or through a relay (another un-annotated parameter, a loop variable, a call result or
// an alias), instances the function at that field call's arguments (D9642, D9643, D9731, D9732,
// D9733), and a list mixing it with an annotated lambda's record calls each (D9950).
function inc0(a) { return a + 1 }
function inc1(a) { return a + 1 }
function inc2(a) { return a + 1 }
function inc3(a) { return a + 1 }
function inc4(a) { return a + 1 }
function inc7(a) { return a + 1 }
function inc9(a) { return a + 1 }
function inc10(a: i32): i32 { return a + 1 }
function t0(a) { print(a.f(3)) }
function t1(a) { print(a.f(3)) }
function t2(a) { print(a.f(3)) }
function t3(a) { print(a.f(3)) }
function t4(a) { print(a.f(3)) }
function t7(a) { print(a.f(3)) }
function t9(a) { print(a.f(3)) }
// D9731: a `const` record both listed and handed directly.
const e0 = { f: inc0 }
const xs0 = [e0]
t0(xs0[0])
t0(e0)
// D9732: a `for` loop over a list of records.
const xs1 = [{ f: inc1 }, { f: inc1 }]
for x in xs1 { t1(x) }
// D9642: a list element built by a call.
function mk() { return { f: inc2 } }
const xs2 = [mk()]
t2(xs2[0])
// D9643: an element read through a function's inferred result.
const xs3 = [{ f: inc3 }]
function g3(i: i32) { return xs3[i] }
t3(g3(0))
// D9733: an alias of a `const` record, beside an annotated lambda's record.
const r4 = { f: inc4 }
const v4 = r4
t4(v4)
t4({ f: (_x: i32): f64 => 1.5 })
// D9950: a list mixing the record with an annotated lambda's, read by index.
const xs7 = [{ f: inc7 }, { f: (x: i32): i32 => x * 10 }]
t7(xs7[0])
t7(xs7[1])
// Controls: the relay alone, and an annotated function through the same relay.
function relay9(v) { t9(v) }
relay9({ f: inc9 })
relay9({ f: inc10 })
