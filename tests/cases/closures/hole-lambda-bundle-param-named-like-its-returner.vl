// @run
// @log 5
// @log 2.5
// A function returning a hole lambda's bundle, named like the bundle maker's parameter: the
// parameter's calls are not calls of the function (D15908).
function lap(f) {
  f(2.5)
  f(3)
  return f
}
function f(n: i32) { lap((a) => a + n) }
const w = f(1)
print(w(4))
print(w(1.5))
