// @run
// @log 6.25
// @log 4
// @log 1
// @log 6.25
// A reassigned `let` of lambdas capturing a hole function's parameter, called at that parameter,
// holds each instance's clone of the lambdas, never the template at a default pin.
function f(a) {
  let c = (x) => x + a
  c = (x) => x * a
  print(c(a))
}
f(2.5)
f(2)
f(1)
function g(a) {
  let c = (x) => x + a
  c = (x) => x * a
  return c(a)
}
print(g(2.5))
