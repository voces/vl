// @run
// @log 3
// @log 1
// @log 3
// @log s
// A one-member hole-lambda set delivered from an inferred-return call inside a generic called at
// two pins: the closure-coercion record is written once, in the generic pass.
function fw(f) { return f }
const lam = (x) => x
function deliver() { return fw(lam) }
function g<T>(t: T) {
  const v: (x: i32) => i32 = deliver()
  print(v(3))
  print(t)
}
g(1)
g("s")
