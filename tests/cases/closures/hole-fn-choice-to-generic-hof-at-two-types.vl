// @run
// @log 5
// @log 3.5
// @log 5
// @log 3.5
// @log 5
// @log 3.5
// @log 5
// @log 3.5
// A choice of un-annotated functions, an `if` binding or a re-pointed `let`, handed to a generic
// higher-order function at two types: the set is tagged and each instance coerces the id at its
// own parameter type (D16832, D16833).
function app<A, B>(f: (x: A) => B, x: A): B { return f(x) }
function hinc(x) { return x + 1 }
function hid(x) { return x }
const c = 3 > 2
const h = if c { hinc } else { hid }
print(app(h, 4))
print(app(h, 2.5))
let g = hinc
if !c { g = hid }
print(app(g, 4))
print(app(g, 2.5))
function go() {
  const k = if c { hinc } else { hid }
  print(app(k, 4))
  print(app(k, 2.5))
  let m = hinc
  if !c { m = hid }
  print(app(m, 4))
  print(app(m, 2.5))
}
go()
