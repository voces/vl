// @run
// @log 5
// @log 2.5
// @log 5
// @log 11
// @log 7.5
// A hole lambda's bundle, held whole in a module-scope `const` and returned from a function, is
// called at both signatures through the result, as the `const` itself is (D15740).
function lap(f) {
  f(2.5)
  f(3)
  return f
}
const c = lap((a) => a + 1)
function g() { return c }
const w = g()
print(w(4))
print(w(1.5))
print(g()(4))

function lap2(f) {
  f(1.5)
  f(2)
  return f
}
const d = lap2((a) => a * 2 + 1)
function h() { return d }
print(h()(5))
print(h()(3.25))
