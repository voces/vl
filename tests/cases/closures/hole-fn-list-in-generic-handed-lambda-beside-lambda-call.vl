// @run
// @warning Unused parameter
// @log 3
// @log 30
// @log 2
// D10702: a loop over hole functions inside a generic, handed a lambda, beside another call
// handed a lambda.
function apply2(g) { print(g(1, 2)) }
function apply3(g) { print(g(10, 20)) }
function gen<T>(x: T) {
  const gs = [apply2, apply3]
  for f in gs { f((a, b) => a + b) }
}
gen("z")
function v2() { apply2((a, b) => a * b) }
v2()
