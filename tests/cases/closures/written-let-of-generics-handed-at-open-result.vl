// @run
// @log 3
// @log s
// @log 3
// @log s
// @log 4
// A written `let` of generics handed to `(x: T) => R` binds `R` from what the members return at
// the call's `T`, not from one member's own type parameter.
function idg<T>(t: T): T { t }
function idh<T>(t: T): T { t }
function app<T, R>(g: (x: T) => R, v: T): R { return g(v) }
let f = idg
f = idh
print(app(f, 3))
print(app(f, "s"))
print(f(3))
print(app(f, "s"))
function len<T>(xs: T[]) { xs.length }
function first<T>(xs: T[]) { xs.length * 0 + 4 }
let k = len
if [1].length > 5 { k = first }
print(app(k, [1, 2, 3, 4]))
