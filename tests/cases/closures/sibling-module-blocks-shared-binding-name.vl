// @run
// @log 4
// @log 6
// @log 7
// @log 8
// @log 4
// @log 6
// @log 4
// @log 7
// @log 6
// D1751 — every block below binds `held` and `get`, so the module frame's name-keyed
// tables hold several bindings for each. The reader's own arena node is what picks among
// them; first-wins gave the second block the first block's cell, and the two readers that
// must agree are the capture's env FIELD (`parentBindingOf`) and the value call's `$fnsig`
// (`identClosureFeAt`). One of them alone leaves the other keying the wrong signature: with
// the field fixed and the call not, the struct pair traps `indirect call type mismatch`.

type MaybeN = i32 | null
type Rec = { n: i32 }
type BoxedMap = { it: { [string]: Rec } }
type Circle = { r: i32 }
type Sq = { s: i32 }
type BoxC = { it: Circle }
type BoxS = { it: Sq }

function mkNul(): MaybeN { return 4 }
function mkMap(): { [string]: Rec } {
  const m: { [string]: Rec } = Map()
  m["k"] = { n: 6 }
  return m
}
function mkBox(): BoxedMap { return { it: mkMap() } }
function mkC(): Circle { return { r: 7 } }
function mkS(): Sq { return { s: 8 } }
function mkBC(): BoxC { return { it: mkC() } }
function mkBS(): BoxS { return { it: mkS() } }

// 1 — the MIXED pair, the row's filed witness: a nullable-scalar capture beside a map one.
// Check-clean invalid wasm before, because the map block's env field was declared at the
// nullable scalar's union box.
if true {
  const xs = [mkNul()]
  const held = xs[0]
  const get = () => held
  print(get() ?? 0)
}
if true {
  const box = mkBox()
  const held = box.it
  const get = () => held
  print((get()["k"] ?? { n: 0 }).n)
}

// 2 — the STRUCT pair, the same defect's loud spelling: two struct reps reached
// `emitProgram: unknown struct field in field access` rather than invalid wasm.
if true {
  const bc = mkBC()
  const held = bc.it
  const get = () => held
  print(get().r)
}
if true {
  const bs = mkBS()
  const held = bs.it
  const get = () => held
  print(get().s)
}

// 3 — a THIRD sibling of a name two blocks already bind: the pick is the LAST binding
// before the reader, not the second one.
if true {
  const xs = [mkNul()]
  const held = xs[0]
  const get = () => held
  print(get() ?? 0)
}

// 4 — `while` bodies rather than `if` arms, the other module-frame block form.
let once1 = true
while once1 {
  const box = mkBox()
  const held = box.it
  const get = () => held
  print((get()["k"] ?? { n: 0 }).n)
  once1 = false
}

// 5 — a NESTED block shadowing an outer binding of the same name: the inner reader takes
// the inner cell and the outer reader keeps its own.
if true {
  const bc = mkBC()
  const held = bc.it
  const get = () => held
  if true {
    const xs = [mkNul()]
    const held = xs[0]
    const get = () => held
    print(get() ?? 0)
  }
  print(get().r)
}

// 6 — the control the name reuse is measured against: distinct names ran at both seeds and
// must keep running.
if true {
  const box = mkBox()
  const held9 = box.it
  const get9 = () => held9
  print((get9()["k"] ?? { n: 0 }).n)
}
