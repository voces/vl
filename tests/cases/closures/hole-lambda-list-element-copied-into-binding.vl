// @run
// @info `l` is never reassigned; use `const` instead of `let`
// @log 3
// @log s
// @log 1.5
// @log 4
// @log 6
// @log 4
// @log 3
// @log 7
// @log 8
// @log s
// @log 3.5
// An un-annotated lambda, or a declared generic, read out of an un-annotated list into an
// un-annotated binding is called at the type the call gives it, as a call straight off the
// element is (D6524).
const h = (u) => u
const fs = [h]
const g = fs[0]
print(g(3))
const hs = (u) => u
const ss = [hs]
const gs = ss[0]
print(gs("s"))
const hf = (u) => u
const ff = [hf]
const gf = ff[0]
print(gf(1.5))
const ws = [h]
ws[0] = (u) => u + 1
const w = ws[0]
print(w(3))
const k = (u) => u * 2
const two = [h, k]
const second = two[1]
print(second(3))
print(two[0](4))
let l = fs[0]
print(l(3))
const i = 1
const k2 = (u) => u + 5
const pair = [k, k2]
const pi = pair[i]
print(pi(2))
print(pi(3))
function idT<T>(a: T): T { return a }
const ts = [idT]
const t = ts[0]
print(t("s"))
const tf = [idT]
const u = tf[0]
print(u(2.5) + 1.0)
