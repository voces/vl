// @run
// @log 4
// @log 6
// Sibling records holding different hole functions, `r.f` called:
// returned from either branch of an if.
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function mk(c: boolean) {
  if c { return { r: { f: inc0 }, s: { f: dbl } } }
  return { r: { f: dbl }, s: { f: inc0 } }
}
print(mk(true).r.f(3))
print(mk(false).r.f(3))
