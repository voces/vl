// @run
// @log aC
// @log aG
// @log aG
// @log aC
// @log aG
// @log aG
// @log aE
// @log aC
// @log aC
// @log aE
// @log aC
// @log aC
// @log aE
// @log aG
// @log aE
// @info `d` is never reassigned; use `const` instead of `let`
// @info `d` is never reassigned; use `const` instead of `let`
// @hint Intentionally-unused variable `_unused` (leading `_` marks it unused)
// @hint redundant type annotation: `w` is inferred as `i32` — remove it to lean on inference
// A mutate-then-read matrix over `let` aliases of hole lambdas: each link is written in the same
// function, a nested function, a loop or a closure before the read, beside the no-write control
// (D3850). Each line prints the lambda the alias holds at that read.

// The control: nothing written.
function control(x: string) {
  const c = (y) => y + "C"
  let d = c
  print(d(x))
}
control("a")

// Written in a loop, more than once, then read directly and through a closure.
function loop(x: string) {
  const c = (y) => y + "C"
  const g = (y) => y + "G"
  let d = c
  let i = 0
  while i < 2 {
    d = g
    i = i + 1
  }
  print(d(x))
  print((() => d(x))())
}
loop("a")

// Written back to itself from a nested function, and from the same function.
function selfWrite(x: string) {
  const c = (y) => y + "C"
  const g = (y) => y + "G"
  let d = c
  print(d(x))
  function w(): i32 {
    d = d
    0
  }
  w()
  d = g
  d = d
  print(d(x))
  print((() => d(x))())
}
selfWrite("a")

// One lambda written into two bindings, read through each.
function twoTargets(x: string) {
  const c = (y) => y + "C"
  const e = (y) => y + "E"
  let d = e
  const g = () => d(x)
  print(g())
  d = c
  let k = e
  k = c
  print(g())
  print(k(x))
  k = e
  print(k(x))
}
twoTargets("a")

// A lambda only ever stored in aliases nothing calls, beside one that is called.
function stored(x: string) {
  const c = (y) => y + "C"
  const g = (y) => y + "G"
  const _unused = g
  let d = c
  print(d(x))
  print((() => d(x))())
}
stored("a")

// Initialized with one lambda that nothing calls directly, written with one that is.
function initPeer(x: string) {
  const c = (y) => y + "C"
  const e = (y) => y + "E"
  const g = (y) => y + "G"
  let d = g
  const d2 = c
  d = d2
  let d4 = d2
  d4 = e
  print(d4(x))
  d = g
  print(d(x))
  print((() => d4(x))())
}
initPeer("a")
