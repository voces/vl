// @run
// @log 5
// @log 2.5
// @log 8
// @log 3
// @log 5
// @log 2.5
// @log 2.5
// @log 5 2.5
// @log s
// @log 8 3
// @log 7
// @log 7
// @log 4.5
// A parameter handed a returned bundle's record whole and copied into a `const`: the copy holds
// the record and each call through it takes its signature's member, beside a lambda argument.
function lap(f) {
  f(2.5)
  f(3)
  return f
}
function take(a) {
  const v = a
  print(v(4))
  print(v(1.5))
}
function both(a) {
  print(a(4))
  const v = a
  print(v(1.5))
  print(a(1.5))
}
function gen<T>(a, x: T) {
  const v = a
  print("\{v(4)} \{v(1.5)}")
  print(x)
}
function go(k: i32) {
  const r = lap((a) => a + k)
  take(r)
}
take(lap((a) => a + 1))
take((x) => x * 2)
both(lap((a) => a + 1))
gen(lap((a) => a + 1), "s")
gen(lap((a) => a * 2), 7)
go(3)
