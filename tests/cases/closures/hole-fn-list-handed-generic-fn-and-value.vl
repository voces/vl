// @run
// @warning Unused parameter
// @log 3
// @log 1
// @log 30
// @log 0.75
// The D10700 witness: list elements handed a generic function and a frame's hole parameter take
// the value parameter's type from the instance before choosing the function's instance.
function add(a, b) { return a + b }
function apply2(g, s) {
  print(g(1, 2))
  print(g(s, s))
}
function apply3(g, s) {
  print(g(10, 20))
  print(g(s, 0.25))
}
function inner(k, h) {
  for f in [apply2, apply3] { f(add, k) }
}
inner(0.5, add)
