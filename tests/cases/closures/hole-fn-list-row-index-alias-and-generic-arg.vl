// @info `i` is never reassigned; use `const` instead of `let`
// @info `q` is never reassigned; use `const` instead of `let`
// @hint Intentionally-unused parameter `_n` (leading `_` marks it unused)
// @run
// @log 4
// @log 3.5
// @log 4
// @log 4
// @log 3.5
// @log 4
// @log 3.5
// @log 4
// @log 3.5
// @log 4
// @log 3.5
// @log 310
// @log 310
// @log 310
// @log 10
// A list literal of un-annotated functions read at two types names its generic at each read: a
// row read through a computed index, a loop variable's alias, a returned local nested list of a
// function that takes an argument, and an element handed straight to a generic's `T` argument
// (D9900, D9901, D9902, D9890).
import { fill, insert } from "std:array"

function inc(a) { return a + 1 }
const u = [[inc]]
let i = 0
print(u[i][0](3))
print(u[0][0](2.5))

function inc2(a) { return a + 1 }
const u2 = [[inc2], [inc2]]
let j = 0
while j < u2.length {
  print(u2[j][0](3))
  j = j + 1
}
print(u2[1][0](2.5))

function inc3(a) { return a + 1 }
const u3 = [inc3]
for f in u3 {
  const q = f
  print(q(3))
}
print(u3[0](2.5))

function inc4(a) { return a + 1 }
const u4 = [inc4]
for f in u4 {
  let q = f
  print(q(3))
}
if u4.length == 1 {
  const q = u4[0]
  print(q(2.5))
}

function inc5(a) { return a + 1 }
function deliver(_n) {
  const r = [[inc5]]
  return r
}
const w = deliver("s")
print(w[0][0](3))
print(w[0][0](2.5))

function put<T>(xs: T[], x: T) { xs.push(x) }
function hinc(a) { a + 1 }
function hdbl(a) { a * 2 }
const v = [hinc, hdbl]
put(v, v[1])
print(v.length * 100 + v[2](5))

function putU(xs, x) { xs.push(x) }
function hinc2(a) { a + 1 }
function hdbl2(a) { a * 2 }
const v2 = [hinc2, hdbl2]
putU(v2, v2[1])
print(v2.length * 100 + v2[2](5))

function hinc3(a) { a + 1 }
function hdbl3(a) { a * 2 }
const v3 = [hinc3, hdbl3]
v3.insert(0, v3[1])
print(v3.length * 100 + v3[0](5))

function hinc4(a) { a + 1 }
function hdbl4(a) { a * 2 }
const v4 = [hinc4, hdbl4]
v4.fill(v4[1])
print(v4[0](5))
