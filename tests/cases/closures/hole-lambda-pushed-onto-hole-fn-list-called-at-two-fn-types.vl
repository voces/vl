// @run
// @warning Unused parameter `a`
// @log 2
// @log 5
// @log x2
// @log z5
// @log 2
// @log 5
// @log 2
// @log 7
// The D12800 witness: a hole lambda pushed onto a list of hole functions takes the list's
// function type, as a named function pushed there does; then the same push called at two
// function types, and a lambda index-written into the list.
import { toString } from "std:fmt"

function cat(a, b) { return a + b.toString() }
function snd(a, b) { return b }
function apply2(g) { print(g("x", 2)) }
const fs = [apply2]
fs.push((g) => {
  print(g("z", 5))
})
for f in fs { f(snd) }

const gs = [apply2]
gs.push((g) => {
  print(g("z", 5))
})
for f in gs { f(cat) }
for f in gs { f(snd) }

const hs = [apply2, apply2]
hs[1] = (g) => {
  print(g("w", 7))
}
for f in hs { f(snd) }
