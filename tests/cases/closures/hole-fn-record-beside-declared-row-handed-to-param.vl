// @run
// @hint redundant type annotation: `inc2` is inferred as `i32`
// @hint redundant type annotation: `half` is inferred as `f64`
// @log 2
// @log 2
// @log 2
// @log 2.5
// D9530: a record literal of an un-annotated function, handed to an un-annotated parameter
// beside a declared record type of the same field name whose function returns f64, is built at
// its own row, so the call returns the function's i32; then the bound twin, the annotated twin,
// and a literal whose function does return f64 at the declared row.
type R = { f: (a: i32) => f64 }
function inc0(a) { return a + 1 }
function take(a) { print(a.f(4) / 2) }
take({ f: inc0 })
function inc1(a) { return a + 1 }
function take1(a) { print(a.f(4) / 2) }
const b1 = { f: inc1 }
take1(b1)
function inc2(a: i32): i32 { return a + 1 }
function take2(a) { print(a.f(4) / 2) }
take2({ f: inc2 })
function half(a: i32): f64 { return a + 1.0 }
function take3(a) { print(a.f(4) / 2) }
take3({ f: half })
