// @run
// @log 3.5
// @log 8
// @log 4
// @log 2.5
// @log 8
// @log 2.5
// @log 3.5
// @log 8
// @log 2.5
// @log 1.5
// @log 7
// @log 4.5
// @log 9
// @log 14
// A parameter handed whole to hole parameters that each call it at one signature, beside a
// capture or a call of its own, or to two such callees at different signatures in either order:
// every callee's signature joins the record the chain holds, and a callee reached by another call
// at its own type keeps its one closure there.
function other(g) { print(g(7)) }
function other2(g) { print(g(1.5)) }
function capAndHand(f) {
  const h = () => f(2.5)
  print(h())
  other(f)
}
function callAndHand(f) {
  print(f(3))
  other2(f)
}
function handTwo(f) {
  other(f)
  other2(f)
}
function handTwoRev(f) {
  other2(f)
  other(f)
}
function capAndHandTwo(f) {
  const h = () => f(2.5)
  print(h())
  other(f)
  other2(f)
}
function go(k: i32) {
  capAndHand((a) => a + k)
  callAndHand((a) => a + k)
  handTwo((a) => a + k)
  capAndHandTwo((a) => a + k)
  handTwoRev((a) => a * k)
}
go(1)
function shared(k: i32) {
  capAndHand((a) => a + k)
  other((x) => x * k)
}
shared(2)
