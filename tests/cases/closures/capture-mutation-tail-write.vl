// @run
// @log 5
// @log 5
// @log 2
// @log hi
// @log z
// @log 105
// @log 105
// @log 2
// @log hi
// @log hi
// @log hi
// @log 7
// @log 3
// @log hi
// @log ww
// @log 2.5
// @log true
// @log 5
// @hint redundant type annotation
// A closure whose LAST statement writes a boxed local is valued by that write (D2285). The
// value is the assigned one, at the assignment's type, which may be narrower than the cell's
// (`Q` into `Q | null`). The function must yield that value even when its caller discards
// it, and a plain element write `v[0] = e` as the tail yields its value the same way.
type Q = { x: i32 }
type K = "zz" | "ww"

function structCell() {
  let v: Q = { x: 1 }
  const w = () => {
    v = { x: 5 }
  }
  print(w().x)
}
structCell()

function nulStructCell() {
  let v: Q | null = null
  const w = () => {
    v = { x: 5 }
  }
  print(w().x)
}
nulStructCell()

function listCell() {
  let v = [1]
  const w = () => {
    v = [4, 5]
  }
  print(w().length)
}
listCell()

function nulStringCell() {
  let v: string | null = null
  const w = () => {
    v = "hi"
  }
  print(w())
}
nulStringCell()

function unionCell() {
  let v: i32 | string = 1
  const w = () => {
    v = "z"
  }
  const r = w()
  if r is string { print(r) } else { print("int") }
}
unionCell()

// A closure-typed cell, the write's value discarded and then used.
function closureCellDiscarded() {
  let v = (x: i32) => x
  const w = () => {
    v = (x: i32) => x + 100
  }
  w()
  print(v(5))
}
closureCellDiscarded()

function closureCellUsed() {
  let v = (x: i32) => x
  const w = () => {
    v = (x: i32) => x + 100
  }
  print(w()(5))
}
closureCellUsed()

// A tail `if` whose arms both write the cell.
function ifArms() {
  let v: Q | null = null
  const w = (c: boolean) => {
    if c { v = { x: 1 } } else { v = { x: 2 } }
  }
  print(w(false).x)
}
ifArms()

// A void context, the value then read back, and a named nested function.
function run(g: () => void) { g() }
function voidContext() {
  let v: string | null = null
  run(() => {
    v = "hi"
  })
  print(v ?? "none")
}
voidContext()

function thenRead() {
  let v: string | null = null
  const w = () => {
    v = "hi"
  }
  print(w())
  print(v ?? "none")
}
thenRead()

function unionInt() {
  let v: i32 | string = "a"
  const w = () => {
    v = 7
  }
  print(w() + 0)
}
unionInt()

function app(g: () => Q): i32 { g().x }
function inlineArg() {
  let v: Q | null = null
  print(
    app(() => {
      v = { x: 3 }
    }),
  )
}
inlineArg()

function namedNested() {
  let v: string | null = null
  function setIt() { v = "hi" }
  print(setIt())
}
namedNested()

// Literal writes keep their store, which encodes a literal-union atom.
function nulLitUnion() {
  let k: K | null = null
  const set = () => {
    k = "ww"
  }
  print(set())
}
nulLitUnion()

function nulFloat() {
  let v: f64 | null = null
  const set = () => {
    v = 2.5
  }
  print(set())
}
nulFloat()

function nulBool() {
  let v: boolean | null = null
  const set = () => {
    v = true
  }
  print(set())
}
nulBool()

function listElem() {
  const v: Q[] = [{ x: 1 }]
  const w = () => {
    v[0] = { x: 5 }
  }
  print(w().x)
}
listElem()
