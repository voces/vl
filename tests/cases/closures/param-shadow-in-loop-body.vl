// @run
// @log inner|1.5|inner|1.5|

// D2325 — a closure-typed PARAMETER shadowed by a block-local `const` inside a loop BODY,
// re-entered every iteration. Each iteration's shadow read must not leak into the param read
// that follows it in the same iteration.

function f(g: () => f64, xs: i32[]) {
  let out = ""
  for x in xs {
    {
      const g = () => "inner"
      out = out + g() + "|"
    }
    out = out + "\{g()}" + "|"
  }
  out
}
print(f(() => 1.5, [0, 0]))
