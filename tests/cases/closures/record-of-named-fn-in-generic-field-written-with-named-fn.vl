// @run
// @log 3
// @log x
// A record literal of named functions in a function with a hole parameter, its field written with
// another named function, beside a call of the parameter that tags the first's set (D15472).
function go(a) {
  const r = { f: same }
  r.f = dbl
  print(r.f(3))
  print(a("x"))
}
function same<T>(k: T): T { k }
function dbl(x) { x }
go(same)
