// @run
// @log 5
// @log g
// @log 5
// @log 8
// @log 5
// @log 5
// @log g
// @log 6
// @log 8
// @log 6
// @log 5
// @log 6
// @log 1
// @log 2
// @log g
// @log 1
// @log 2
// @log 8
// @log 1
// @log 2
// @log 5
// A local `w` whose scope does not reach the call (a closed block, a later `const`, an ended
// loop) leaves the top-level generic `function w` callable there: the shadow test is positional,
// and a generic has no fallback that recovers from a declined resolution (D2289).

function w<T>(x: T): T { return x }

function blkS(c: boolean) {
  if c {
    const w = 5
    print(w)
  }
  print(w("g"))
}

function blkI(c: boolean) {
  if c {
    const w = 5
    print(w)
  }
  print(w(7) + 1)
}

function blkF(c: boolean) {
  if c {
    const w = 5
    print(w)
  }
  print(w(2.5) * 2.0)
}

function laterS() {
  print(w("g"))
  const w = 6
  print(w)
}

function laterI() {
  print(w(7) + 1)
  const w = 6
  print(w)
}

function laterF() {
  print(w(2.5) * 2.0)
  const w = 6
  print(w)
}

function loopS() {
  for w in [1, 2] { print(w) }
  print(w("g"))
}

function loopI() {
  for w in [1, 2] { print(w) }
  print(w(7) + 1)
}

function loopF() {
  for w in [1, 2] { print(w) }
  print(w(2.5) * 2.0)
}

blkS(true)
blkI(true)
blkF(true)
laterS()
laterI()
laterF()
loopS()
loopI()
loopF()
