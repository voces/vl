// @run
// @log 42
// @log 42
// @log 42
// @log 18
// @log 42
// @log a!
// @log 42
// D9432: a generic over a function-typed parameter, returned from an un-annotated function and
// handed to an un-annotated parameter, is called there with an un-annotated lambda, a block
// lambda, a lambda bound to a const, or through a const alias; the last call is the direct twin.
function app<T>(f: (x: T) => T, x: T): T { f(x) }
function deliver() { return app }
function take(a) {
  const v = a
  print(v((n) => n * 2, 21))
}
take(deliver())
function app2<T>(f: (x: T) => T, x: T): T { f(x) }
function deliver2() { return app2 }
function take2(a) {
  print(
    a(
      (n) => {
        const k = n + 1
        return k * 2
      },
      20,
    ),
  )
}
take2(deliver2())
function app3<T>(f: (x: T) => T, x: T): T { f(x) }
function deliver3() { return app3 }
function take3(a) {
  const v = a
  const f = (n) => n * 2
  print(v(f, 21))
}
take3(deliver3())
function twice<T>(f: (x: T) => T, x: T): T { f(f(x)) }
function deliver4() { return twice }
function take4(a) {
  const v = a
  print(v((n) => n * 3, 2))
}
take4(deliver4())
function app5<T>(f: (x: T) => T, x: T): T { f(x) }
function deliver5() { return app5 }
function take5(a) { print(a((n) => n * 2, 21)) }
const d5 = deliver5()
take5(d5)
function app6<T>(f: (x: T) => T, x: T): T { f(x) }
function deliver6() { return app6 }
function take6(a) { print(a((n) => n + "!", "a")) }
take6(deliver6())
function app7<T>(f: (x: T) => T, x: T): T { f(x) }
function take7(a) {
  const v = a
  print(v((n) => n * 2, 21))
}
take7(app7)
