// @run
// @log 4
// @log 0.5
// @log 0.5
// @log 0.5
// @log 0.5
// @log 0.5
// @log 0.5
// @log 0.5
// @log 3
// @log 4
// @log 2.5
// An un-annotated lambda whose body relays an un-annotated function's `i32`, delivered at
// `(a: i32) => f64`, converts its result to `f64` in every position (D9020).
function inc0(a) { return a + 1 }
function ap(g: (a: i32) => f64) { return g(3) }
function mk(): (a: i32) => f64 { return (a) => inc0(a) }
function viaT<T>(g: (a: i32) => T): T { return g(3) }
const f: (a: i32) => f64 = (a) => inc0(a)
print(f(3))
print(f(3) / 8.0)
print(ap((a) => inc0(a)) / 8.0)
print(mk()(3) / 8.0)
const fs: ((a: i32) => f64)[] = [(a) => inc0(a)]
print(fs[0](3) / 8.0)
const blk: (a: i32) => f64 = (a) => {
  return inc0(a) * 2
}
print(blk(3) / 16.0)
print(viaT(f) / 8.0)
print([1, 2, 3].map(f)[2] / 8.0)
// The same lambda with no target type stays the hole function it was.
const g = (a) => inc0(a)
print(g(2))
print(g(3))
print(g(1.5))
