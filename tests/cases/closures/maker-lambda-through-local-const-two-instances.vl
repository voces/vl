// A maker instanced at two parameter types returns its lambda through a local `const`, and each
// call's binding is called at its own signature: each instance builds the lambda at its own (D16819).
// @run
// @log 5
// @log 3.5
function adder(n) {
  const f = (a) => a + n
  return f
}
const v = adder(2)
print(v(3))
const x = adder(1.5)
print(x(2.0))
