// @run
// @log 6
// @log 10
// @log 6
// @log 10
// @log 11
// @log 20
// A choice of functions kept as its set's id in a module global, read at a closed function type,
// calls the member the choice picked: once for each member of the set.
function inc0(a) { return a + 1 }
function dbl0(a) { return a * 2 }
function apply(f: (x: i32) => i32) { return f(10) }
const pickInc = true
const pickDbl = false
const fs = [dbl0]
const gi = if pickInc { inc0 } else { dbl0 }
const gd = if pickDbl { inc0 } else { dbl0 }
fs.push(gi)
fs.push(gd)
print(fs[1](5))
print(fs[2](5))
const hi: (x: i32) => i32 = gi
const hd: (x: i32) => i32 = gd
print(hi(5))
print(hd(5))
print(apply(gi))
print(apply(gd))
