// @run
// @log 3
// @log 2
// @log 2
// @log 3
// @log 2
// A module `const` alias of a hole function, called with two functions, beside a `for` over a
// one-element list of that function inside a hole function: the alias calls go through the
// function's set, so a call through the loop's element dispatches to each instance (D15442).
function add(a, b) { return a + b }
function mul(a, b) { return a * b }
function apply2(g) { print(g(1, 2)) }
const k = apply2
k(add)
apply2(mul)
k(mul)
function viaFor(h) {
  for f in [apply2] { f(h) }
}
viaFor(add)
viaFor(mul)
