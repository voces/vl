// @run
// @log 0.5
// @log 0.5
// @log 0.5
// @log 0.5
// @log 0.5
// @log 0.5
// A maker's hole lambda delivered at a closed function type inside a generic or hole-parameter
// function: each instance builds the maker's twin at that result, as a delivery at module scope
// does (D16791).
function deliver() { return (a) => a + 1 }
function wrap<T>(t: T) {
  const w: (a: i32) => f64 = deliver()
  print(t)
  return w(3) / 8.0
}
function hole(t) {
  const w: (a: i32) => f64 = deliver()
  print(t)
  return w(3) / 8.0
}
print(wrap(0.5))
print(hole(0.5))
print(wrap(0.5) + 0.0)
