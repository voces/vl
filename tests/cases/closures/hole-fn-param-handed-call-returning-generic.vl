// @log 21
// @log a
// @log 3
// @log 7
// @log a
// @log true
// @log 21
// @log a
// @log 21
// @log a
// @log 22
// @log 2
// An un-annotated parameter called at two types, handed a call that always returns one generic,
// runs the call once per call site (D9540).
function id<T>(x: T): T { x }
function inc(x: i32) { x + 1 }
function deliver0() { return id }
function take(a) {
  print(a(21))
  print(a("a"))
}
take(deliver0())
function deliver() {
  print("deliver")
  return id
}
take(deliver())
take(deliver())
function deliverN(n: i32) {
  print(n)
  if n > 1 { return id }
  return id
}
function take3(a, n: i32) {
  print(a(n))
  print(a("a"))
  print(a(true))
}
function main() { take3(deliverN(3), 7) }
main()
take(id)
take((x) => x)
function deliverInc() { return inc }
function takeI(a) {
  print(a(21))
  print(a(1))
}
takeI(deliverInc())
