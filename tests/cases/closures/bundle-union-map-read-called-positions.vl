// @hint Intentionally-unused variable `_b` (leading `_` marks it unused)
// A map whose value slot holds a union of two bundle records, read into a `const` by index or
// `get` and called at a signature both records have: each call tests the box for each record and
// calls that record's member (D17573). A call at a signature one record lacks is D17727.
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
function lap2(f) {
  const _a = f(true)
  const _b = f(3)
  return f
}
const m = Map()
m["a"] = lap((a) => a + 1)
m["b"] = lap2((a) => a)
const g = m["a"]
if g != null { print(g(3)) }
function main() {
  const n = Map()
  n["a"] = lap((a) => a + 1)
  n["b"] = lap2((a) => a)
  const k = n["b"]
  if k != null { print(k(3)) }
  const h = n["a"]
  if h != null { print(h(5)) }
  const z = n["zz"]
  if z != null { print(z(1)) } else { print("none") }
  const s = n["a"]
  if s != null { print(s(3) + 10) }
}
main()
const o = Map()
o["a"] = lap((a) => a + 1)
o["b"] = lap2((a) => a)
const q = o.get("a")
if q != null { print(q(3)) }
const r = o["b"]
if r != null { print(r(7)) }
print(o.has("b"))
