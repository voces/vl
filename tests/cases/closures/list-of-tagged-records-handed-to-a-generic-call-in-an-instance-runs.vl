// @run
// @log 20
// @log 6
// @log 20
// @log 4
// @log 1
// @log 6
// @hint Intentionally-unused parameter
// A list of records holding a function set, bound inside a generic function and handed to
// another generic one, pins that call at the row it is built at.
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function useL(r) { return r[0].fs[0](10) }
function useNone(_r) { return 1 }
function passed(b) {
  const c = [{ fs: [dbl] }]
  print(useL(c))
  const a = [{ fs: [inc0] }]
  if b { return a }
  return c
}
function kept(_b) {
  const c = [{ fs: [dbl] }]
  print(useNone(c))
  return c
}
print(passed(false)[0].fs[0](3))
print(passed(true)[0].fs[0](3))
print(kept(false)[0].fs[0](3))
