// @run
// @log 3
// @log 2
// @log s
// @log 3
// @log 2
// @log s
// @log 3
// @log 2
// @log 2
// @log s
// @log 7.5
// @log t
// @log true
// @log 10
// @log 11
// @log 0
// @log 1
// @log z
// @hint redundant type annotation: `inc` is inferred as `i32` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// @hint redundant type annotation: `dbl` is inferred as `f64` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// A list holding a generic function, spread into a second list that is then written with or
// built beside a fixed-type function, while the source list is called through at two types:
// the copy is typed at what it holds and the source keeps its generic (D9595).
function id<T>(x: T): T { x }
function inc(x: i32): i32 { x + 1 }
function dbl(x: f64): f64 { x * 2.0 }

// A pushed list, its copy written.
const xs = []
xs.push(id)
const ys = [...xs]
ys[0] = inc
print(ys[0](2))
print(xs[0](2))
print(xs[0]("s"))

// A list literal, its copy written.
const as = [id]
const bs = [...as]
bs[0] = inc
print(bs[0](2))
print(as[0](2))
print(as[0]("s"))

// A copy built beside a fixed-type function, never written.
const cs = [id]
const ds = [...cs, inc]
print(ds[1](2))
print(ds[0](2))
print(cs[0](2))
print(cs[0]("s"))

// A copy written and read by a computed index in a loop.
const es = [id, id]
const fs = [...es, dbl]
fs[1] = dbl
let s = 0.0
let i = 0
while i < fs.length {
  s = s + fs[i](1.5)
  i = i + 1
}
print(s)
print(es[1]("t"))
print(es[0](true))

// Two pushes, the copy iterated, the source read by a loop index.
const gs = []
gs.push(id)
gs.push(id)
const hs = [...gs]
hs[1] = inc
for f in hs { print(f(10)) }
let j = 0
while j < gs.length {
  print(gs[j](j))
  j = j + 1
}
print(gs[1]("z"))
