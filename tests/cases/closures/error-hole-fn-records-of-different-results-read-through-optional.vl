// @error cannot write 'half' to 'm[].f': called at (i32) it returns f64, where 'inc0', also written to it, returns i32 — every function a call through 'm[].f' may run must return one type
// The map's records written by index and called through `?.` are judged as a `.get` read is
// (D9370).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const m = Map()
m["a"] = { f: inc0 }
m["b"] = { f: half }
print(m["b"]?.f(3) ?? 0)
