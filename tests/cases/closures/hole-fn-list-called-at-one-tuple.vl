// @run
// @log 5
// @log 7
// @log 6
// @log 9
// An un-annotated list of hole functions whose element calls agree on one argument tuple is
// built at that tuple: indexed, handed to a callback, held in a record field, and looped over.
function inc(a) { return a + 1 }
const xs = [inc]
print(xs[0](4))
function inc2(a) { return a + 2 }
function apU(r) { return r(5) }
const v2 = [inc2]
print(v2.map(apU)[0])
function inc7(a) { return a + 1 }
function ap(r: (a: i32) => i32) { return r(5) }
const rec = { fs: [inc7] }
print(rec.fs.map(ap)[0])
function inc8(a) { return a * 3 }
const ys = [inc8]
for g in ys { print(g(3)) }
