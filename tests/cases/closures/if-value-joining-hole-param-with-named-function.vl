// @run
// @log 2
// @log 2
// @log 3
// @log 2.5
// @log 2
// @log 2
// @log 6
// A value `if` choosing between an un-annotated parameter and a named function is called at
// the type the instance gives the parameter, in either arm, whether the named function is
// un-annotated or annotated, and called in place (D15462).
function inc(x) { x + 1 }
function dbl(x) { x * 2 }
function go(k: boolean, f) {
  const h = if k { dbl } else { f }
  print(h(1))
}
go(true, inc)
go(false, inc)
function goF(k: boolean, f) {
  const h = if k { f } else { dbl }
  print(h(1.5))
}
goF(false, inc)
goF(true, inc)
function twice(x: i32) { x * 2 }
function goA(k: boolean, f) {
  const h = if k { f } else { twice }
  print(h(1))
}
goA(false, twice)
function goC(k: boolean, f) { print((if k { f } else { dbl })(1)) }
goC(false, inc)
function goT(k: boolean, f) {
  const h = if k { twice } else { f }
  print(h(3))
}
goT(true, inc)
