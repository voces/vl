// @log 1.5
// @log 4
// @log 6
// @log 20
// @log 6
// @log 20
// @log 4
// @log 6
// @log 4
// Each returned list of records of an un-annotated function is typed at one list whose
// records' function lists carry every leaf's functions, in a function of each result type.
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function half(a) { return a / 2.0 }
function last(b) {
  const a = [{ fs: [inc0] }]
  if b { return a }
  return [{ fs: [dbl] }]
}
function mixed(b) {
  const a = [{ fs: [inc0] }]
  if b { return a }
  return [{ fs: [half] }]
}
function read(b) {
  const c = [{ fs: [dbl] }]
  print(c[0].fs[0](10))
  const a = [{ fs: [inc0] }]
  if b { return a }
  return c
}
function picked(n: i32) {
  return match n {
    0 => [{ fs: [inc0] }]
    _ => [{ fs: [dbl] }]
  }
}
print(mixed(false)[0].fs[0](3))
print(last(true)[0].fs[0](3))
print(last(false)[0].fs[0](3))
print(read(false)[0].fs[0](3))
print(read(true)[0].fs[0](3))
print(picked(1)[0].fs[0](3))
print(picked(0)[0].fs[0](3))
