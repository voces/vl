// @run
// @log 7
// @log w
// @log 7
// @log w
// @log 307
// @log 9
// @log ab
// A list of a generic written the same generic at an element, pushed it through a `const`
// alias, or called through the pushed element as both operands of one expression calls each
// type's instance (D10340, D10341, D10342).
function id<T>(x: T): T { x }
const ws = [id]
ws[0] = id
print(ws[0](7))
print(ws[0]("w"))
const xs = [id]
const al = xs
al.push(id)
print(xs[1](7))
print(xs[1]("w"))
const ys = [id]
ys.push(id)
print(ys[1]("abc").length * 100 + ys[1](7))
const zs = [id]
const k = 0
zs[k] = id
print(zs[0](9))
print(zs[0]("ab"))
