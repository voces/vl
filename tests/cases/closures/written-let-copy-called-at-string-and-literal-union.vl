// @run
// @log B
// @log r
// @log B
// @log q
// @log B
// @log s
// @log B
// @log p
// @log B
// @log t
// @log B
// @log q
// @info `y` is never reassigned; use `const` instead of `let`
// @info `z` is never reassigned; use `const` instead of `let`
// A copy of a written `let` of generics, itself called with a `string` and with a string literal
// union, holds one instance per call type: a `let` copy at module scope, a `const` copy inside a
// function, and a copy of the copy (D5171).
function gA<U>(u: U) {
  print("A")
  print(u)
}
function gB<V>(v: V) {
  print("B")
  print(v)
}
type S = "p" | "q"
const a: S = "q"
let x = gA
x = gB
let y = x
y("r")
y(a)
function inner() {
  let f = gA
  f = gB
  const g = f
  const p: S = "p"
  g("s")
  g(p)
}
inner()
let z = y
z("t")
z(a)
