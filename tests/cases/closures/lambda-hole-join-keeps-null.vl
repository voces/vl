// @run
// @log true
// @log false
// @log 7
// @log nil
// @log false
// @log false
// @log true
// @log 2.5
// @log nil
// A lambda body joining two parameter holes and `null` keeps the null at every pin, as the
// declaring function's own body does: a record pin returns a nullable record, a scalar pin
// boxes, and the lambda may be called in place, returned, or passed on (D3506).
const r7 = { x: 7 }
function F(k: i32, a, b) {
  const g = () => {
    if k == 0 { a }
    else if k == 1 { b }
    else { null }
  }
  g()
}
print(F(2, r7, r7) == null)
print(F(0, r7, r7) == null)
const v = F(1, r7, r7)
if v != null { print(v.x) } else { print("nil") }
const w = F(2, r7, r7)
if w != null { print(w.x) } else { print("nil") }
function G(k: i32, a, b) {
  () => {
    if k == 0 { a }
    else if k == 1 { b }
    else { null }
  }
}
print(G(0, 3, "t")() == null)
print(G(1, 3, "t")() == null)
print(G(2, 3, "t")() == null)
function run(h) { h() }
function H(k: i32, a, b) {
  run(() => {
    if k == 0 { null }
    else if k == 1 { a }
    else { b }
  })
}
const x = H(2, 1.5, 2.5)
if x != null { print(x) } else { print("nil") }
const y = H(0, 1.5, 2.5)
if y != null { print(y) } else { print("nil") }
