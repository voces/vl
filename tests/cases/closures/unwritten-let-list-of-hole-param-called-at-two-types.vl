// @run
// @info `r` is never reassigned; use `const` instead of `let`
// @log 3
// @log x
// A `let` list literal of an un-annotated parameter, never re-pointed, called at two types
// (D15452).
function same<T>(k: T): T { k }
function go(g) {
  let r = [g]
  print(r[0](3))
  print(r[0]("x"))
}
go(same)
