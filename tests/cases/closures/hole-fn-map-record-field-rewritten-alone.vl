// @run
// @log 6
// A `let` record whose map-of-functions field is rewritten with a map of another function
// holds both maps' functions at that field, with no other write deciding their sets (D15534).
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
const hm = Map()
hm["k"] = inc0
const hm2 = Map()
hm2["k"] = dbl
let u = { m: hm }
u = { m: hm2 }
const y = u.m["k"]
if y != null { print(y(3)) }
