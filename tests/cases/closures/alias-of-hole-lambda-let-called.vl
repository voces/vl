// @run
// @log L
// @log true
// @log L
// @log 2
// @log cap
// @log true
// @log cap
// @log s
// @info `f` is never reassigned; use `const` instead of `let`
// @info `g` is never reassigned; use `const` instead of `let`
// A call through an un-annotated alias of an unwritten `let` holding a hole lambda instances the
// lambda at that call, as a call through the `let` does (D4157).
let f = (x) => {
  print("L")
  print(x)
}
const h = f
h(true)
h(2)
function main() {
  const t = "cap"
  let g = (x) => {
    print(t)
    print(x)
  }
  const j = g
  j(true)
  j("s")
}
main()
