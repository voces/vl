// @run
// @hint Intentionally-unused parameter `_gb` (leading `_` marks it unused)
// @log 1
// @log 1
// @log 2.5
// @log 1.5
// @log 2.25
// @log 3.125
// @log 0.5
// @log 6
// @log 2.5
// @log 2.75
// A named generic handed to a hole the callee calls with an un-annotated parameter of the
// caller is instanced at the type the caller's frame gives that parameter, even when another
// call site already instanced the generic at another type (D13260).
function add(a, b) { return a + b }
function apply2(g, s) { print(g(s, s)) }
function apply4(g, s) { print(g(s, 2)) }
function inner(k) { apply2(add, k) }
inner(0.5)
function innerThree(k, h) {
  for f in [apply2, apply4] { f(h, k) }
}
innerThree(0.5, add)

// An uncalled sibling hole handed the same generic does not choose the called one's instance.
function applyBeside(g, s, _gb) { print(g(s, s)) }
function besideInner(k) { applyBeside(add, k, add) }
besideInner(0.75)

// Second delivery position: two calls in one frame, each callee its own instance.
function twoCalls(k) {
  apply2(add, k)
  apply4(add, k)
}
twoCalls(0.125 + 1.0)

// Annotated twin of `inner`, and an integer frame beside a float one.
function innerAnn(k: f64) { apply2(add, k) }
innerAnn(0.25)
function innerInt(k) { apply2(add, k) }
innerInt(3)
function innerFour(k) { apply4(add, k) }
innerFour(0.5)
innerFour(0.75)
