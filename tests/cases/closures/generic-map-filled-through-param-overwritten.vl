// @run
// @log 3
// @log 3
// @log 3
// @log 6
// @log 4
// @hint redundant type annotation: `inc` is inferred as `i32` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// An un-annotated `Map()` that an un-annotated function fills with a generic function through
// its parameter, beside a store of a fixed-type function: the map's values are typed at that
// store and the stored generic is instanced there (D9651).
function id<T>(x: T): T { x }
function inc(x: i32): i32 { x + 1 }

function fill(mm) { mm.set("k", id) }
function put(mm) { mm["k"] = id }
function fillAt(mm, k: string) { mm.set(k, id) }

// At module scope, the key overwritten by `.set`.
const m = Map()
fill(m)
m.set("k", inc)
const r = m.get("k")
if r != null { print(r(2)) }

// Inside a function body.
function main() {
  const m2 = Map()
  fill(m2)
  m2.set("k", inc)
  const r2 = m2.get("k")
  if r2 != null { print(r2(2)) }
}
main()

// Through an index write, read by index and by `.get` with `??`.
const m3 = Map()
put(m3)
m3["k"] = inc
const r3 = m3["k"]
if r3 != null { print(r3(2)) }
const q3 = m3.get("k") ?? id
print(q3(5))

// Filled at two keys around a store at a third, each read in a loop.
const m4 = Map()
fillAt(m4, "a")
m4.set("b", inc)
fillAt(m4, "c")
let s = 0
for k in ["a", "b", "c"] {
  const r4 = m4.get(k)
  if r4 != null { s = s + r4(1) }
}
print(s)
