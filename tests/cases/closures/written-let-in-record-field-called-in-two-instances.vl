// @run
// @log R
// @log 3
// @log R
// @log s
// @log L
// @log 4
// @log L
// @log t
// A `let` first bound to a generic and written with a lambda, held in a record field or read
// out of a list into an alias inside a generic called at two types, is called through it at each
// instance's own type (D7201).
function other<V>(v: V) { print("O"); print(v) }
function inRecord<T>(x: T) {
  let k = other
  k = (n) => {
    print("R"); print(n)
  }
  const o = { f: k }
  o.f(x)
}
function throughAlias<T>(x: T) {
  let k = other
  k = (n) => {
    print("L"); print(n)
  }
  const fs = [k]
  const h = fs[0]
  h(x)
}
inRecord(3)
inRecord("s")
throughAlias(4)
throughAlias("t")
