// @error cannot assign (i32) => void to `k`: it keeps the generic type of its initializer
// A lambda annotated `(u: i32)` written in the generic body into a cell called at boolean (review of #3498, `rv3498/round5/f17_annotated_concrete_lambda_outer_body_bool`).
function inner<U>(u: U) { print("I"); print(u) }
function a<T>(x: T) {
  let k = inner
  const rd = () => {
    k(x)
  }
  k = (u: i32) => {
    print("L"); print(u)
  }
  rd()
}
a(true)
