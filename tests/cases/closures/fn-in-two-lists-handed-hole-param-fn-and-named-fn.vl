// @run
// @log 1
// @log 2.25
// A function in two list literals, handed a hole parameter's function through one and a named
// function through the other, takes each at its own instance (D15019).
function add(a, b) { return a + b }
function mul(a, b) { return a * b }
function same(g, s) { print(g(s, s)) }
function inner(h) {
  for f in [same] { f(h, 0.5) }
}
inner(add)
function swap() {
  for f in [same] { f(mul, 1.5) }
}
swap()
