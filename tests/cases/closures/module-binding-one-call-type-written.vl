// @run
// @log 8
// @log aa
// @log aa
// @log bbb
// @hint redundant type annotation: `w1` is inferred as `i32`
// The same binding with its writer called: the call after the write reaches the written lambda,
// instantiated at the binding's one signature (D3857).
const c = (y) => y + y
const e = (y) => y + y + y
print(c(4))
print(c("a"))
let d2 = c
print(d2("a"))
function w1(): i32 { d2 = e; 0 }
w1()
print(d2("b"))
