// @run
// @log 20
// A bound list an annotated element closed, handed to a parameter that calls its hole
// element (D10790).
function apply2(g: (a: i32) => i32) { print(g(2)) }
function apply3(g) { print(g(20)) }
function id(a: i32) { return a }
function run(xs: ((g: (a: i32) => i32) => void)[]) { xs[1](id) }
const fs = [apply2, apply3]
run(fs)
