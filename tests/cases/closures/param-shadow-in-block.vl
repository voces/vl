// @run
// @log 1.5|inner|1.5

// D2325 — a closure-typed PARAMETER shadowed by a block-local `const` of the same name.
// The unshadowed reads (before and after the block) resolve the param; the read inside the
// block resolves the shadow.

function f(g: () => f64) {
  let out = "\{g()}"
  {
    const g = () => "inner"
    out = out + "|" + g()
  }
  out = out + "|" + "\{g()}"
  out
}
print(f(() => 1.5))
