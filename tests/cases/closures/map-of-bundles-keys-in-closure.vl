// @run
// The same map walked by its keys inside a closure (D17095).
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
const m = Map()
m["a"] = lap((a) => a + 1)
const walk = () => { for k in m.keys() { print(k) } }
walk()
// @log a
// @hint Intentionally-unused variable `_a`
// @hint Intentionally-unused variable `_b`
