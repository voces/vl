// @run
// @log 3
// @log 49
// @log v=2.5
// @log 6
// @log 3
// @log 3
// @log 5
// @log 6
// @log 5
// @log 6
// @info `g` is never reassigned; use `const` instead of `let`
// @info `gi` is never reassigned; use `const` instead of `let`
// @info `gs` is never reassigned; use `const` instead of `let`
// @info `ab` is never reassigned; use `const` instead of `let`
// @hint redundant type annotation: `cellI32` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `viaGuard` is inferred as `f64` — remove it to lean on inference
// @hint redundant type annotation: `cellF64` is inferred as `f64` — remove it to lean on inference
// A closure written under a narrowing of a value-union module global or index cell reads it
// in the lifted body as the member, because the declaration-site narrowing is replayed for any
// key rooted at a global or a capture, not only for a captured name (D2448, D2450).
let g: f64 | boolean = 1.5
let gi: i64 | boolean = 7
let gs: f64 | string = 2.5
if g is f64 {
  const c1 = (): f64 => g * 2.0
  print(c1())
}
function atI64() {
  if gi is i64 {
    const c2 = (): i64 => gi * gi
    print(c2())
  }
}
atI64()
if gs is f64 {
  const c3 = (): string => "v=\{gs}"
  print(c3())
}

function cellI32(xs: (i32 | null)[]): i32 {
  if xs[0] != null {
    const c4 = (): i32 => xs[0] + 2
    return c4()
  }
  0
}
print(cellI32([4]))

function viaGuard(): f64 {
  if g is boolean { return 0.0 }
  const c5 = (): f64 => g * 2.0
  c5()
}
print(viaGuard())

if g is boolean {
  print(0)
} else {
  const c6 = (): f64 => {
    const d6 = (): f64 => g + 0.0
    d6() * 2.0
  }
  print(c6())
}

type P = { x: i32 }
type Box = { v: P | f64 }
const o: Box = { v: { x: 4 } }
if o.v is P {
  const c7 = (): i32 => o.v.x + 1
  print(c7())
}

function mapCell(xs: (i32 | null)[]): i32[] {
  if xs[0] != null { return [1, 2].map((k: i32): i32 => xs[0] + k) }
  []
}
print(mapCell([4])[1])

type A = { a: i32 }
type B = { b: string }
let ab: A | B = { a: 4 }
if ab is A {
  const c8 = (): i32 => ab.a + 1
  print(c8())
}

function cellF64(ys: (f64 | boolean)[]): f64 {
  if ys[0] is f64 {
    const c9 = (): f64 => ys[0] * 2.0
    return c9()
  }
  0.0
}
print(cellF64([3.0]))
