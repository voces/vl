// @error argument 1: expected string[], got f64[]
// A module-level empty list is one value: each call of a hole function handing it to a callback
// sees the type the first call pinned, so a second callback at another element type refuses.
const xs = []
function ef(b: f64[]) {
  b.push(1.5)
  return b.length
}
function es(b: string[]) {
  b.push("x")
  return b.length
}
function add(h) { return h(xs) }
print(add(ef))
print(add(es))
