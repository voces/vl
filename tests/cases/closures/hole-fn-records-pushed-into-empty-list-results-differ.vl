// @run
// @log 1.5
// @log 4
// @log 11.5
// @log 5.5
// @log 3.5
// @log 1.5
// Records whose function field holds un-annotated functions returning different types, pushed
// into an un-annotated empty list: each later push joins its functions into the element's set,
// so a call through any element runs the function stored there (D15929). The second and first
// called, three pushes, a walk, a mixed record, and the field bound out.
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function dbl(a) { return a * 2 }
const l = []
l.push({ f: inc0 })
l.push({ f: half })
print(l[1].f(3))
print(l[0].f(3))
const l3 = []
l3.push({ f: inc0 })
l3.push({ f: half })
l3.push({ f: dbl })
print(l3[0].f(3) + l3[1].f(3) + l3[2].f(3))
let acc = 0.0
for e in l { acc = acc + e.f(3) }
print(acc)
const lm = []
lm.push({ n: 1, f: inc0 })
lm.push({ n: 2, f: half })
print(lm[1].f(3) + lm[1].n)
const g = l[1].f
print(g(3))
