// @run
// @log 7
// @log 1
// @log 8
// @log s
// @log 2
// A block-local maker capturing a local, written between its calls, hands back the generic it
// returns as one id; the id reads no environment, so its calls see none of the writes (D5971).
function k<T>(x: T): T { return x }
function main() {
  let y = 7
  function mk() {
    print(y)
    return k
  }
  const p = mk()
  y = 8
  print(p(1))
  const q = mk()
  print(q("s"))
  y = 9
  print(p(2))
}
main()
