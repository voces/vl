// A hole function no call through a holder reaches is a closure, and a holder of a list of it is
// laid out at the type the elaboration holds it at: records in lists, in a function, a value `if`,
// a bound record listed, a written binding, two pushes, a loop, an element read (D17384).
function inc0(a) { return a + 1 }
print(inc0(3))
const r0 = [[{ n: 7, fs: [inc0] }]]
print(r0[0][0].n)
print(r0[0][0].fs.length)

function inc1(a) { return a + 1 }
function m1() {
  const r = [[{ n: 7, fs: [inc1] }]]
  return r[0][0].n
}
print(m1())

function inc2(a) { return a + 1 }
const b2 = 1 < 0
const w2 = if b2 { { n: 1, f: [inc2] } } else { { n: 2, f: [inc2] } }
print(w2.n)

function inc3(a) { return a + 1 }
const v3 = { n: 3, fs: [inc3] }
const w3 = [[v3]]
print(w3[0][0].n)

function inc4(a) { return a + 1 }
let r4 = [[{ n: 7, fs: [inc4] }]]
r4 = [[{ n: 8, fs: [inc4] }]]
print(r4[0][0].n)

function inc5(a) { return a + 1 }
const r5 = [[{ n: 7, fs: [inc5] }]]
r5.push([{ n: 9, fs: [inc5] }])
print(r5[1][0].n)

function inc6(a) { return a + 1 }
const r6 = [[{ n: 7, fs: [inc6] }]]
const x6 = { n: 9, fs: [inc6] }
r6[0].push(x6)
print(r6[0][1].n)

function inc7(a) { return a + 1 }
const r7 = [[{ n: 7, fs: [inc7] }]]
for row in r7 {
  for c in row { print(c.n) }
}

function inc8(a) { return a + 1 }
const r8 = [[{ n: 7, fs: [inc8] }]]
const q8 = r8[0]
print(q8[0].n)

function inc9(a) { return a + 1 }
function mk9(x: i32) {
  const rs = [{ fs: [inc9], x: x }]
  print(rs[0].x)
}
mk9(5)
