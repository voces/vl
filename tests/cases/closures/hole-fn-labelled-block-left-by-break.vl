// @run
// @hint Intentionally-unused variable `_x`
// @log 1
// @log a!
// @log b?
// @log c!
// @log past 0
// @log in 1
// @log d?
// @log past 0
// @log e.
// @log ff
// @log 6
// A labelled block a `break` leaves, whose value is an uncalled hole function, is that value when
// every `break` ends a branch: bound unread, called, through an `else if` chain, guarded by an
// `if` with no `else`, and returned at two types (D7010).
function exclaim(s) { return s + "!" }
function ask(s) { return s + "?" }
function dot(s) { return s + "." }
function twice(s) { return s + s }
const on = [1].length == 1
const _x = @B { break @B exclaim }
print(1)
const y = @B { break @B exclaim }
print(y("a"))
function pick(n: i32) {
  const x = @B {
    if n == 0 { break @B ask }
    else if n == 1 { break @B exclaim }
    else { ask }
  }
  return x
}
print(pick(0)("b"))
print(pick(1)("c"))
function guard(n: i32) {
  const x = @B {
    if n == 0 { break @B ask }
    print("past 0")
    if n == 1 {
      print("in 1")
      break @B ask
    }
    dot
  }
  return x
}
print(guard(1)("d"))
print(guard(2)("e"))
function both(c: boolean) {
  return @B {
    if c { break @B twice }
    twice
  }
}
print(both(on)("f"))
print(both(!on)(3))
