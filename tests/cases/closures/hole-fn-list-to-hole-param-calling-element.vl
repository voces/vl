// @run
// @log 3
// @log 7
// A list of a function whose own parameter is a hole, handed to a hole parameter that calls its
// element: the list's element is typed at the signature that call pins, so the parameter has a
// valtype (D6886). The `<F>` spelling takes the same path.
function apply3(g) { print(g(1, 2)) }
function apply4<F>(g: F) { print(g(3, 4)) }
function add(a: i32, b: i32) { a + b }

const xs = [apply3]
function run(ys) { ys[0](add) }
run(xs)

const zs = [apply4]
function run2(ys) { ys[0](add) }
run2(zs)
