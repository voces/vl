// @run
// @log I
// @log s
// @log I
// @log 7
// @log I
// @log s
// @log I
// @log 7
// A function also stored in a `const` list read only as the callee of calls through an element:
// those calls hand its parameter what the direct call does, so the binding the parameter is
// written to holds that set's id.
function id<T>(x: T): T {
  print("I")
  x
}
function take(a) {
  let b = id
  b = a
  print(b("s"))
  print(b(7))
}
take(id)
const fs = [take]
fs[0](id)
