// A function also stored in a list is reached by calls the check does not see, so what its direct
// calls hand its parameter does not decide the binding the parameter is written to.
function id<T>(x: T): T {
  print("I")
  x
}
function take(a) {
  let b = id
  b = a
  print(b("s"))
  print(b(7))
}
take(id)
const fs = [take]
fs[0](id)
