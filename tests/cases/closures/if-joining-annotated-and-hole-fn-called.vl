// @run
// @log 2
// An `if` value joining an annotated function with a hole function, the annotated arm
// first (D10790).
function apply2(g: (a: i32) => i32) { print(g(2)) }
function apply3(g) { print(g(20)) }
function id(a: i32) { return a }
const b = true
const f = if b { apply2 } else { apply3 }
f(id)
