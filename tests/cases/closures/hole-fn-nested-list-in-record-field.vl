// @run
// @log 4
// @log 6
// @log 9
// @log 1.5
// @log 4
// A record literal whose field is an inline nested list of un-annotated functions runs at the top
// level, inside a function beside another field, at f64, and read through a bound element
// (D9713). The last case, the field initialised from a bound list, is a control that ran before.
function inc0(a) { return a + 1 }
const w0 = { f: [[inc0]] }
print(w0.f[0][0](3))

function inc1(a) { return a + 1 }
function dbl1(a) { return a * 2 }
function go1() {
  const w = { f: [[inc1, dbl1], [dbl1]], n: 1 }
  print(w.f[0][1](3))
  print(w.f[1][0](4) + w.n)
}
go1()

function half2(a) { return a / 2.0 }
const w2 = { f: [[half2]] }
const g2 = w2.f[0][0]
print(g2(3.0))

function inc3(a) { return a + 1 }
const u3 = [[inc3]]
const w3 = { f: u3 }
print(w3.f[0][0](3))
