// @run
// @log 7
// @log 7
// @log 2
// @log 42
// @log 5
// @log 7
// @log 5
// D9430, D9431: a generic over a function-typed or record parameter, stored directly or through
// an un-annotated function's return into an un-annotated `Map()` or an empty list, is read back
// and called.
function call<T>(f: () => T): T { f() }
function deliverCall() { return call }
const m = Map()
m["k"] = call
const mv = m["k"]
if mv != null {
  const v = mv
  print(v(() => 7))
}
const m2 = Map()
m2["k"] = deliverCall()
const mv2 = m2["k"]
if mv2 != null { print(mv2(() => 7)) }
function call2<T>(f: () => T): T { f() }
const m3 = Map()
m3["k"] = call2
const mv3 = m3["k"]
if mv3 != null { print(mv3(() => "ab").length) }
function app<T>(f: (x: T) => T, x: T): T { f(x) }
const m4 = Map()
m4["k"] = app
const mv4 = m4["k"]
if mv4 != null { print(mv4((n) => n * 2, 21)) }
function pick<T>(r: { k: T }): T { r.k }
function deliverPick() { return pick }
const m5 = Map()
m5["k"] = deliverPick()
const mv5 = m5["k"]
if mv5 != null {
  const v5 = mv5
  print(v5({ k: 4 }) + 1)
}
function call3<T>(f: () => T): T { f() }
const xs = []
xs.push(call3)
print(xs[0](() => 7))
function pick2<T>(r: { k: T }): T { r.k }
function deliverPick2() { return pick2 }
const ys = []
ys.push(deliverPick2())
print(ys[0]({ k: 4 }) + 1)
