// @run
// @log O
// @log 2.5
// @log O
// @log s
// A `const` alias of a top-level generic, called inside a closure at the enclosing generic's
// type parameter, runs when the enclosing body is called at two types (D4308).
function other<V>(v: V) { print("O"); print(v) }
function a<T>(x: T) {
  const w = () => {
    const h = other
    h(x)
  }
  w()
}
a(2.5)
a("s")
