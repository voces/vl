// A hole parameter's copy read by a function nested two or three levels in its owner, directly
// or through a copy made in a middle function, is handed through a set at each instance of the
// owner (D15580).
function add(a, b) { return a + b }
function mul(a, b) { return a * b }
function apply2(g) {
  print(g(1, 2))
  print(g(1.5, 2.5))
}
function run(h) {
  const hh = h
  function mid() {
    function inner() {
      for f in [apply2] { f(hh) }
    }
    inner()
  }
  mid()
}
run(add)
run(mul)
function run2(h) {
  const hh = h
  function mid() {
    const h3 = hh
    function inner() {
      for f in [apply2] { f(h3) }
    }
    inner()
  }
  mid()
}
run2(add)
run2(mul)
function run3(h) {
  const hh = h
  function mid() {
    function low() {
      const h4 = hh
      function inner() {
        for f in [apply2] { f(h4) }
      }
      inner()
    }
    low()
  }
  mid()
}
run3(add)
run3(mul)
