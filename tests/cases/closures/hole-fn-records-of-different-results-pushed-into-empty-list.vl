// @run
// @log 1.5
// @log 4
// @log 1.5
// @log 1.5
// @log 4
// @log 1.5
// @log 1.5
// @log 3.5
// @info `w` is never reassigned
// Records of un-annotated functions returning different types, pushed one by one into an
// un-annotated empty list: the pushes join the element's set as a literal's records do, and each
// call runs its own record's function (D15929). Either order, a loop, a `let`, a function body,
// and a record with a second field.
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const l = []
l.push({ f: inc0 })
l.push({ f: half })
print(l[1].f(3))
print(l[0].f(3))

const o = []
o.push({ f: half })
o.push({ f: inc0 })
print(o[0].f(3))

let w = []
w.push({ f: inc0 })
w.push({ f: half })
print(w[1].f(3))

for r in l { print(r.f(3)) }

function go() {
  const g = []
  g.push({ f: inc0 })
  g.push({ f: half })
  print(g[1].f(3))
}
go()

const t = []
t.push({ f: inc0, n: 1 })
t.push({ f: half, n: 2 })
print(t[1].f(3) + t[1].n)
