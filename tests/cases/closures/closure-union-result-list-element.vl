// @run
// @log 1.5
// @log true
// @log 2.5
// @log 1.5
// @hint redundant type annotation: `fs` is inferred as `(i32) -> f64 | boolean[]`
// @hint redundant type annotation: `use` is inferred as `f64`
// A LIST whose ELEMENT is a top-level FUNCTION TYPE with a UNION RESULT —
// `((i32) => f64 | boolean)[]`, as a binding annotation, as a PARAMETER
// annotation, and value-called through both. The element's grouping parens are
// what keep the `[]` binding the whole function instead of its result: without
// them the name spells `(i32) => f64|boolean[]`, a function whose result is a
// union with a LIST arm, which mints a different ref-list slot and a different
// `$fnsig` key from the annotation's.
//
// D-ELEMWIDTH pins this shape because it is the ONE spelling on which the two
// grouping tests in `canonEmitName`'s array arm disagree. The element is ONE
// top-level atom — its `|` sits behind the top-level `=>`, where the atom count
// stops — and it DOES carry a top-level `|`, so the WIDTH test declines it and
// the FUNCTION-TYPE test claims it. Both return the identical parenthesized
// name, which is what makes moving this population from the first test to the
// second unobservable; 287 such names were measured over corpus + fuzz and this
// is their named witness, because a construction proof is not a regression test.
//
// The PARAMETER cell is the loud one: with the function-type test removed, the
// binding cells keep running and only their BYTES change, while `use`'s param
// annotation fails `emitProgram: callee is not a function name`.

function pick(n: i32): f64 | boolean {
  if n > 0 { return 1.5 }
  false
}

function flip(n: i32): f64 | boolean {
  if n > 0 { return true }
  2.5
}

const fs: ((i32) => f64 | boolean)[] = [pick, flip]

const a = fs[0](1)
if a is f64 { print(a) }

const b = fs[1](1)
if b is boolean { print(b) }

const c = fs[1](0)
if c is f64 { print(c) }

function use(xs: ((i32) => f64 | boolean)[]): f64 {
  const v = xs[0](1)
  if v is f64 { return v }
  0.0
}

print(use(fs))
