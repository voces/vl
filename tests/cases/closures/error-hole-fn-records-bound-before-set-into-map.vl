// @error cannot write 'half' to 'm[].f': called at (i32) it returns f64, where 'inc0', also written to it, returns i32 — every function a call through 'm[].f' may run must return one type
// A record bound to a const before it is set into the map is judged with the map's other
// records, as the same record written inline is (D9470).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const m = Map()
m.set("a", { f: inc0 })
const r0 = { f: half }
m.set("b", r0)
const r = m.get("b")
if r != null { print(r.f(3)) }
