// @run
// @log L
// @log s
// @log L
// @log true
// The lambda written over a generic seed is called at a string, then delivered where a boolean
// is passed: the delivered arm binds its own type from its argument, not the caller's frame.
function other<V>(v: V) { print("O"); print(v) }
function cb(f: (b: boolean) => void, b: boolean) { f(b) }
function main() {
  let k = other
  k = (n) => {
    print("L"); print(n)
  }
  k("s")
  cb(k, true)
}
main()
