// @run
// @log O
// @log 3
// @log O
// @log true
// An alias of a cell read is called at one type and delivered to a parameter of another after the
// cell is written; the delivery stores the parameter's instance (D3975,
// `rv3501/r08_alias_called_and_delivered_differ`).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function cb(f: (b: boolean) => void, b: boolean) { f(b) }
function main() {
  let k = inner
  const flip = () => {
    k = other
  }
  flip()
  const r = k
  r(3)
  cb(r, true)
}
main()
