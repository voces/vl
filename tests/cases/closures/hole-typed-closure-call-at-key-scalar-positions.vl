// @run
// @log 6
// @log 9
// @log 9
// @log 17
// @log 10
// @log 25
// @log 3
// A call through a local closure over a captured hole function, typed at a hole, read at the scalar
// the call's key names, in a function instanced at two generics.
function add(a, b) { return a + b }
function mul(a, b) { return a * b }
function app(g, s) { return g(s, s) }
// printed
function p1(h) {
  const run = (x) => app(h, x)
  print(run(3))
}
p1(add)
p1(mul)
// bound, then used in arithmetic
function p2(h) {
  const run = (x) => app(h, x)
  const v = run(4)
  print(v + 1)
}
p2(add)
p2(mul)
// returned from the instance
function p3(h) {
  const run = (x) => app(h, x)
  return run(5)
}
print(p3(add))
print(p3(mul))
// a float argument, printed at the width the call returns (D17664)
function p4(h) {
  const run = (x) => app(h, x)
  print(run(1.5))
}
p4(add)
