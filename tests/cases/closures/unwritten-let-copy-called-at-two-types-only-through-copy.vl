// @run
// @info `b` is never reassigned; use `const` instead of `let`
// @log x
// @log 4
// @log dup
// @log x
// @log dup
// @log 4
// An unassigned `let` copy called at two types, the parameter itself never called, holds one function for both calls (D15120).
function id<T>(x: T): T { x }
function dup<T>(x: T): T {
  print("dup")
  x
}
function one<F>(a: F) {
  let b = a
  print(b("x"))
  print(b(3) + 1)
}
one(id)
one(dup)
