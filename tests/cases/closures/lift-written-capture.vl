// @warning `k` shadows the `k` declared at

// A `let` a lifted local function assigns stays a local of its frame: the function takes it
// as a parameter and hands the new value back after its result, and each call writes it back.
// Every line prints a value that depends on when the write lands: a write then a read by the
// caller, a caller's write between calls, a call inside another call's arguments and behind a
// short circuit, recursion (deep tail recursion too), two writers, several captures written by
// one function, a host re-entered from inside the writer, scalars of every width, and a
// closure that escapes, which must keep sharing the binding.

function count(n: i32) {
  let k = 0
  const bump = (d: i32) => {
    k += d
  }
  for i in 0 until n { bump(i) }
  k
}

function writeThenRead() {
  let k = 0
  const set = (v: i32) => {
    k = v
  }
  set(5)
  print(k)
  set(7)
  print(k)
}

function callerWrites() {
  let k = 1
  const dbl = () => {
    k = k * 2
  }
  dbl()
  k = k + 10
  dbl()
  k
}

function show(a: i32, b: i32) { print(a * 100 + b) }

function inArguments() {
  let k = 0
  const bump = (d: i32): i32 => {
    k += d
    k
  }
  print(bump(3))
  show(bump(1), bump(2))
  show(k, bump(10))
  show(bump(10), k)
}

function shortCircuit(flag: boolean) {
  let k = 0
  const inc = (): i32 => {
    k += 1
    k
  }
  if flag && inc() > 0 { print(k) }
  print(k > 100 || inc() > 1)
  print(k < 0 && inc() > 0)
}

function recurse(n: i32) {
  let k = 0
  function rec(m: i32) {
    if m > 0 {
      k += m
      rec(m - 1)
    }
  }
  rec(n)
  k
}

function tailDeep(n: i32) {
  let k = 0
  function go(m: i32) {
    if m == 0 { return k }
    k += 1
    return go(m - 1)
  }
  go(n)
}

function tailValue(n: i32) {
  let acc = 0
  function go(m: i32) {
    acc += m
    if m <= 0 { return acc }
    return go(m - 1)
  }
  go(n) + acc
}

function twoWriters() {
  let k = 10
  const inc = (d: i32) => {
    k += d
  }
  const dec = (d: i32) => {
    k -= d
  }
  inc(5)
  dec(3)
  inc(k)
  dec(1)
  k
}

function valueAndWrite() {
  let k = 0
  const next = (): i32 => {
    k += 1
    return k * 10
  }
  print(next() + next())
  print(next() * 2 + k)
  print(k + next())
}

function multiWritten() {
  let a = 0
  let b = 100
  const go = (d: i32): i32 => {
    a += d
    b -= d
    a * b
  }
  print(go(1))
  print(go(2))
  a + b
}

function reenter(n: i32) {
  let k = n
  const b = (d: i32) => {
    k += d
    if n > 0 { k += reenter(n - 1) }
    k += 1
  }
  b(1)
  b(2)
  k
}

function apply(g: () => i32) { g() }

function escapes() {
  let k = 0
  const bump = () => {
    k += 1
  }
  const get = (): i32 => k
  bump()
  bump()
  print(apply(get))
  bump()
  apply(get)
}

function widths() {
  let a: i64 = 1
  let b = 0.25
  let c: f32 = 0.25
  let d = false
  const step = () => {
    a = a * 3
    b = b * 2.0
    c = c + 0.5
    d = !d
  }
  step()
  step()
  step()
  print(a * 3)
  print(b / 4.0)
  print(c)
  print(if d { 9 } else { 0 })
}

function shadowed() {
  let k = 1
  const inc = () => {
    k += 5
  }
  {
    const k = 100
    inc()
    print(k)
  }
  inc()
  k - 8
}

print(count(10))
writeThenRead()
print(callerWrites())
inArguments()
shortCircuit(true)
shortCircuit(false)
print(recurse(10))
print(tailDeep(100000))
print(tailValue(10))
print(twoWriters())
valueAndWrite()
print(multiWritten())
print(reenter(3))
print(escapes())
widths()
print(shadowed())
