// @emit-error a generic function taken as a value reaches no call that fixes its type
// A list holds the value its element had when it was built, so a hole parameter written after
// it is listed is not the list's per-instance set, and its two calls refuse (D15011).
function id<T>(x: T): T { x }
function dbl<T>(x: T): T { x + x }
function take(a) {
  const xs = [a]
  a = dbl
  print(xs[0]("ab"))
  print(xs[0](7))
}
take(id)
