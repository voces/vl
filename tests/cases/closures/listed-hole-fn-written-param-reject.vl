// @emit-error monomorphize: `a` is called at two instances of the function handed to it
// A list holds the value its element had when it was built, so a hole parameter written after
// it is listed cannot be split by renaming the calls through the list (D9653).
function id<T>(x: T): T { x }
function dbl<T>(x: T): T { x + x }
function take(a) {
  const xs = [a]
  a = dbl
  print(xs[0]("ab"))
  print(xs[0](7))
}
take(id)
