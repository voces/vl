// @run
// @log 3
// @log 4
// @log 2
// @log 3.75
// @log 3
// @log 4
// @log 2
// @log 3.75
// @log 3
// @log 4
// @log 2
// @log 3.75
// A copy of a hole parameter read by a function nested in its owner holds the parameter's value:
// the nested function is built per instance of its owner, and the copy forwards there (D14843).
function add(a, b) { return a + b }
function mul(a, b) { return a * b }
function apply2(g) {
  print(g(1, 2))
  print(g(1.5, 2.5))
}
function run(h) {
  const hh = h
  function inner() {
    for f in [apply2] { f(hh) }
  }
  inner()
}
function runNamed(h) {
  const hh = h
  function inner() { apply2(hh) }
  inner()
}
function runLambda(h) {
  const hh = h
  const inner = () => {
    for f in [apply2] { f(hh) }
  }
  inner()
}
run(add)
run(mul)
runNamed(add)
runNamed(mul)
runLambda(add)
runLambda(mul)
