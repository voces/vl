// @run
// A module-scope map of two-signature bundles nothing reassigns holds each bundle whole whichever
// function reads it: a `has` test, an index read called, a `get` read called, a store from a
// function, a lambda's read, and a second map that is a `let` (D17094).
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
const m = Map()
m["a"] = lap((a) => a + 1)
let n = Map()
n["x"] = lap((a) => a * 2)
function has() { return m.has("a") }
function viaIndex() {
  const h = m["a"]
  if h != null { print(h(1.5)) }
}
function viaGet() {
  const h = m.get("a")
  if h != null { print(h(4)) }
}
function store() { m["b"] = lap((a) => a - 1) }
const seen = () => m.has("b")
print(has())
viaIndex()
viaGet()
store()
print(seen())
function fromLet() {
  const h = n["x"]
  if h != null { print(h(3)) }
}
fromLet()
// @log true
// @log 2.5
// @log 5
// @log true
// @log 6
// @hint Intentionally-unused variable `_a`
// @hint Intentionally-unused variable `_b`
// @info `n` is never reassigned; use `const` instead of `let`
