// @run
// @log 2
// @log 2.5
// @log 3
// @log 3.5
// @log 4
// @log 4.5
// @log 5
// @log 5.5
// A record a function returns, its function field written another function, holds both, so a
// read of it called at two types runs: top level, inside a function, through an alias, and for a
// field holding a list of functions (D15270).
function id0(a) { return a }
function id1(a) { return a }
function mk() { return { f: id1 } }
function mkl() { return { fs: [id1] } }
const r = mk()
r.f = id0
const g = r.f
print(g(2))
print(g(2.5))
function run() {
  const q = mk()
  q.f = id0
  const h = q.f
  print(h(3))
  print(h(3.5))
}
run()
const w = mk()
const al = w
al.f = id0
const k = w.f
print(k(4))
print(k(4.5))
const l = mkl()
l.fs[0] = id0
const e = l.fs[0]
print(e(5))
print(e(5.5))
