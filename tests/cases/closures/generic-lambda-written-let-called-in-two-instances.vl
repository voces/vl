// @run
// @log L
// @log 3
// @log L
// @log s
// @log null
// @log 7
// @log 1.5
// A lambda written into a generic-initialized `let` inside a generic is lifted once per
// instance, called directly or returned, so each instance calls it at its own type (D7181).
function other<V>(v: V) { print("O"); print(v) }
function g<T>(x: T) {
  let k = other
  k = (n) => {
    print("L"); print(n)
  }
  k(x)
}
g(3)
g("s")
function idv<V>(v: V): V { return v }
function h<T>(x: T): T {
  let k = idv
  k = (n) => n
  return k(x)
}
const sn: string | null = null
const f = h(sn)
if f != null { print(f) } else { print("null") }
print(h(7))
print(h(1.5))
