// @run
// @log done
// @info `d1` is never reassigned; use `const` instead of `let`
// @hint redundant type annotation: `w4` is inferred as `i32`
// A hole lambda no call pins, reaching a capture cell through another binding nothing reads, is
// dead, as one stored there by name is (D3851), so its cell needs no type (D3864).
function mk() {
  const c = (y) => y + y
  let d1 = c
  let d2 = d1
  function w4(): i32 {
    d2 = d1
    return 0
  }
}
mk()
print("done")
