// @run
// @log 5 2.5
// @log 4 true
// @log 5 false
// @log 5 2.5
// @log 4 true
// @log 6 false
// @log 7 4.5
// @log 4 true
// @hint Intentionally-unused variable `_a`
// @hint Intentionally-unused variable `_b`
// Two records of one closure per signature, apart only in their closures' types, share one row:
// each holder, field, list element, map value and returned record calls the member its own record holds.
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
function lap2(f) {
  const _a = f(true)
  const _b = f(3)
  return f
}
function mk() { lap2((a) => a) }
const k = lap((a) => a + 1)
print("\{k(4)} \{k(1.5)}")
const j = lap2((a) => a)
print("\{j(4)} \{j(true)}")
const m = mk()
print("\{m(5)} \{m(false)}")
function run(n: i32) {
  const p = { f: lap((a) => a + n) }
  print("\{p.f(4)} \{p.f(1.5)}")
  const q = [lap2((a) => a)]
  print("\{q[0](4)} \{q[0](true)}")
  const v = q[0]
  print("\{v(6)} \{v(false)}")
}
run(1)
const ma = Map()
ma["a"] = lap((a) => a + 3)
const x = ma["a"]
if x != null { print("\{x(4)} \{x(1.5)}") }
const mb = Map()
mb.set("b", lap2((a) => a))
const y = mb.get("b")
if y != null { print("\{y(4)} \{y(true)}") }
