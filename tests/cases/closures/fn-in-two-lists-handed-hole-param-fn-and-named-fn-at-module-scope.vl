// @run
// @log 1
// @log 2.25
// The named function's list call at module scope, beside the hole parameter's in a function.
function add(a, b) { return a + b }
function mul(a, b) { return a * b }
function same(g, s) { print(g(s, s)) }
function inner(h) {
  for f in [same] { f(h, 0.5) }
}
inner(add)
for f in [same] { f(mul, 1.5) }
