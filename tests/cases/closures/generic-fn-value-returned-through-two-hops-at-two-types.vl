// @run
// @log 1
// @log s
// A generic handed back through two un-annotated identity functions, the outer returning the
// inner's call, and the result called at two types: each call takes its own instance (D5530).
function k<T>(x: T): T { return x }
function fw(f) { return f }
function fw2(f) { return fw(f) }
const v = fw2(k)
print(v(1))
print(v("s"))
