// @run
// @log 1
// @log 2
// @log 7
// @log 7
// @log s
// A type parameter only a generic's body names is default-bound where it is handed to `.map`,
// `.filter` or a higher-order parameter, as at its direct call; its result names none (D9073).
function g<T, U>(t: T) { const q: U[] = []; return q.length + [t].length }
function pr<T, U>(t: T) { const q: U[] = []; return q.length < [t].length }
function k<T, U>(t: T) { const q: U[] = []; return q.length + [t].length + 6 }
function idg<T>(x: T): T { return x }
function ap<T, R>(x: T, f: (x: T) => R): R { return f(x) }
function ap2(x, f) { return f(x) }
print([3].map(g)[0])
print([3, 4].filter(pr).length)
print(ap(3, k))
print(ap2(4, k))
print(ap2("s", idg))
