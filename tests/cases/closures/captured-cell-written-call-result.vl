// @run
// @log Q
// @log 2
// A capture cell runs with a writer storing a call's function-typed result, each value instanced at the cell's type
// (D3939, `rv3498/s02`).
function inner<U>(u: U) { print("I"); print(u) }
function q(n: i32) { print("Q"); print(n) }
function pickQ(): (n: i32) => void { return q }
function main() {
  let k = inner
  const toO = () => {
    k = pickQ()
  }
  toO()
  k(2)
}
main()
