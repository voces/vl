// @run
// @log 0.75
// @log 3
// A list of two functions handed to an un-annotated parameter and called through an element at
// one argument type has the members' one result there (D14850).
function runF(fs) { print(fs[0](1.5)) }
function half(u) { return u * 0.5 }
function dbl(u) { return u * 2 }
runF([half, dbl])

function runG(fs) { print(fs[1](1.5)) }
function half2(u) { return u * 0.5 }
function dbl2(u) { return u * 2 }
runG([half2, dbl2])
