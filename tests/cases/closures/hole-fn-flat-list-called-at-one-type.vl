// @run
// @log 0.75
// @log 3
// @log 1.5
// @log 6
// A list of two functions handed to an un-annotated parameter and called through an element at
// one argument type has the members' one result there (D14850), and their joined result where
// the members' results differ (D14851).
function runF(fs) { print(fs[0](1.5)) }
function half(u) { return u * 0.5 }
function dbl(u) { return u * 2 }
runF([half, dbl])

function runG(fs) { print(fs[1](1.5)) }
function half2(u) { return u * 0.5 }
function dbl2(u) { return u * 2 }
runG([half2, dbl2])

function runH(fs) {
  print(fs[0](3))
  print(fs[1](3))
}
function half3(u) { return u * 0.5 }
function dbl3(u) { return u * 2 }
runH([half3, dbl3])
