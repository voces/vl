// @run
// @log x
// @log 4
// @log dup
// @log x
// @log dup
// @log 4
// A `let` copy of a type-parameter parameter, every write of which stores that same parameter,
// holds the parameter's value, as an unassigned copy does (D15122).
function id<T>(x: T): T { x }
function dup<T>(x: T): T {
  print("dup")
  x
}
function one<F>(a: F, c: boolean) {
  let b = a
  if c { b = a }
  print(a("x"))
  print(b(3) + 1)
}
one(id, true)
one(dup, false)
