// @run
// @log A
// @log 2
// @log A
// @log true
// A record field written with a generic takes the type the field's calls give it, as its
// initializer does (D4241).
function gA<U>(u: U) {
  print("A")
  print(u)
}
function gC<W>(w: W) {
  print("C")
  print(w)
}
function main() {
  const y = { h: gC }
  y.h = gA
  gA(2)
  y.h(true)
}
main()
