// @run
// @log 3
// @log 4
// @log 5
// @log 1
// @log 3.5
// @log 2
// @log 2
// @log 7
// @log 1
// @log 1.5
// A record whose field is a list of un-annotated functions, written whole with a list literal of
// other members, holds their ids: every member is reached, at both call types (D15351).
function inc(a) { return a + 1 }
function dbl(a) { return a * 2 }
function dec(a) { return a - 1 }
let r = { f: [inc] }
print(r.f[0](2))
r = { f: [dbl] }
print(r.f[0](2))
print(r.f[0](2.5))
let s = { f: [inc], n: 1 }
s = { f: [dec, inc], n: 2 }
print(s.f[0](2))
print(s.f[1](2.5))
print(s.n)
let rs = [{ f: [inc] }]
rs[0] = { f: [dbl] }
rs[0].f.push(dec)
print(rs[0].f[1](3))
print(rs[0].f[0](3.5))
function local() {
  let q = { f: [inc] }
  q = { f: [dec] }
  print(q.f[0](2))
  print(q.f[0](2.5))
}
local()
