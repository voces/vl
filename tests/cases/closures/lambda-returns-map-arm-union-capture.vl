// @run
// @log 1.5
// @log 2.5
// A lambda returning a captured union with a map arm returns the union box: its result is
// the type it was checked at, not the rep its body's own read would suggest.
type U = f64[] | {[string]: i32}
const v: U = [1.5]
const c = () => v
const w = c()
if w is f64[] { print(w[0]) } else { print(0) }
function d() {
  const x: U = [2.5]
  const k = () => x
  const y = k()
  if y is f64[] { print(y[0]) } else { print(0) }
  0
}
d()
