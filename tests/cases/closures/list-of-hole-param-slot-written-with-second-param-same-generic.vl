// @run
// @log 1
// @log 5
// A list of one hole parameter, its slot written with a second parameter bound to the same
// generic, handed on whole and its element called at two types (D15568).
function id<T>(x: T): T { x }
function use(ys) { print(ys.length) }
function take(a, b) {
  const xs = [a]
  xs[0] = b
  use(xs)
  print(xs[0]("abc").length + xs[0](2))
}
take(id, id)
