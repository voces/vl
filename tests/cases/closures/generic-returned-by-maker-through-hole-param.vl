// @run
// @log 6
// @log 42
// @log 42
// @log 43
// A lambda returning a generic function, handed to a parameter with no written type whose result
// is called, closes at the one parameter list those calls take: once, twice at one type, and
// through a binding of the call (D16077).
function inc(x) { x + 1 }
function run(f) { print(f()(5)) }
run(() => inc)
function twice(f) {
  print(f()(41))
  print(f()(41))
}
twice(() => inc)
function held(f) {
  const g = f()
  print(g(42))
}
held(() => inc)
