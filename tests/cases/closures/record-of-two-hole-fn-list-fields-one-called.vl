// @run
// @log 4
// @log 1.5
// @log 4
// @log 6
// @log 10
// @info `h` is never reassigned; use `const` instead of `let`
// @info `s` is never reassigned; use `const` instead of `let`
// A record of two list fields holding different un-annotated functions, one called through and
// one not, keeps the called field's set tagged in its row as its literal and reads store it
// (D16914). The re-pointed `let` stores the set's ids at its writes too.
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function half(a) { return a / 2.0 }
const r = { f: [inc0], g: [dbl] }
print(r.f[0](3))
let h = { f: [half], g: [inc0] }
print(h.f[0](3))
let s = { f: [inc0], g: [dbl] }
print(s.f[0](3))
let t = { f: [inc0], g: [half] }
t = { f: [dbl], g: [half] }
print(t.f[0](3))
const u = { f: [inc0], g: [dbl] }
print(u.f[0](3) + u.g[0](3))
