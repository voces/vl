// @run
// @warning Unused parameter
// @log x2
// @log y20
// @log 20
// @log true
// @log 2
// D10701 inside a function: a loop, a constant index, a lambda and `.length` over one list.
import { toString } from "std:fmt"

function cat(a, b) { return a + b.toString() }
function snd(a, b) { return b }
function apply2(g) { print(g("x", 2)) }
function apply3(g) { print(g("y", 20)) }
function main() {
  const fs = [apply2, apply3]
  for f in fs { f(cat) }
  fs[1](snd)
  fs[0]((a, b) => b > 1)
  print(fs.length)
}
main()
