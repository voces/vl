// @run
// @log 3
// @log 4
// @log 5
// @log 6
// @log 7
// @log 8
// @log 9
// @log 10
// @log ada
// @log 11

// @hint redundant type annotation: `held4` is inferred as `{name: string, n: i32}`

// D1476 — an un-annotated binding whose initialiser is a PROJECTION (`xs[0]`, `box.it`),
// then captured. The capture is typed from the binding, and a projection commits no rep the
// syntactic `letIs*` ladder can read, so `captureValKind` takes its i32 default unless the
// arena is asked — and the closure's frame then declares an i32 where a struct ref arrives.

// The arena carries the type either way. Each block prints a different number, so a capture
// reading another block's env prints a wrong one rather than passing.

// The witness: an index projection, captured.
function atIndex() {
  const src = [{ name: "ada", n: 3 }]
  const held = src[0]
  const get = () => held
  print(get().n)
}

atIndex()

// A later element, so the projection is not the zero slot by accident.
function atLaterIndex() {
  const src = [{ name: "ada", n: 3 }, { name: "bob", n: 4 }]
  const held = src[1]
  const get = () => held
  print(get().n)
}

atLaterIndex()

// A FIELD projection — the other shape the row names. Its cell is the NULLABLE struct,
// because a nested-struct field read folds `inner: S` and `inner: S | null` onto one hop.
function atField() {
  const box = { it: { name: "ada", n: 5 } }
  const held = box.it
  const get = () => held
  print(get().n)
}

atField()

// A field of a field, two hops down.
function atNestedField() {
  const outer = { mid: { it: { name: "ada", n: 6 } } }
  const held = outer.mid.it
  const get = () => held
  print(get().n)
}

atNestedField()

// The same shape inside a module-scope BLOCK, whose local a lambda genuinely captures.
if true {
  const src = [{ name: "ada", n: 7 }]
  const held = src[0]
  const get = () => held
  print(get().n)
}

// ── the neighbours that already ran, kept as controls ────────────────────────

// The binding ANNOTATED, which commits the rep on its own.
function annotated() {
  const src = [{ name: "ada", n: 8 }]
  const held4: { name: string, n: i32 } = src[0]
  const get = () => held4
  print(get().n)
}

annotated()

// A CALL initialiser, whose rep the callee's return commits.
type S = { name: string, n: i32 }

function mk(): S { return { name: "ada", n: 9 } }

function callInit() {
  const held = mk()
  const get = () => held
  print(get().n)
}

callInit()

// A plain struct LITERAL initialiser.
function literalInit() {
  const held = { name: "ada", n: 10 }
  const get = () => held
  print(get().n)
}

literalInit()

// A projection whose element is a STRING — no struct, so no fat rep to lose.
function stringElement() {
  const src = ["ada"]
  const held = src[0]
  const get = () => held
  print(get())
}

stringElement()

// Plain module scope, which the row records as the healthy half of the pair.
const modSrc = [{ name: "ada", n: 11 }]

const modHeld = modSrc[0]

const modGet = () => modHeld

print(modGet().n)
