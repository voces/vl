// @run
// @log 3
// @log 0
// @log s
// @log none
// @log 4
// @log -1
// @log 1
// @log 7
// @log 2
// @log 9
// @log 1
// @log s
// A `?.` read on an un-annotated parameter takes the `??` fallback in the instance handed `null`
// (D16338), and in the instance handed a record reads its field at the field's type (D16856).
function take(a) { print(a?.f ?? 0) }
take({ f: 3 })
take(null)
function name(a) { print(a?.f ?? "none") }
name({ f: "s" })
name(null)
function deep(a) { print(a?.b?.c ?? -1) }
deep({ b: { c: 4 } })
deep(null)
function ret(a) { return a?.f ?? 7 }
print(ret({ f: 1 }))
print(ret(null))
function gen<T>(a: T) { return a?.f ?? 9 }
print(gen({ f: 2 }))
print(gen(null))
function rec(a) { const r = a?.p ?? { q: 1 }; print(r.q) }
rec(null)
function show(a) { print(a?.f) }
show({ f: "s" })
