// @run
// @log 1
// @log x
// @log 1.5
// @log 102
// The generic-free twin: the counter tells the written lambda from the first, so a call that read
// the initializer's instance would print 3, not 102 (D3975).
let n = 0
let f = (a) => {
  n = n + 1
  return a
}
print(f(1))
print(f("x"))
f = (a) => {
  n = n + 100
  return a
}
print(f(1.5))
print(n)
