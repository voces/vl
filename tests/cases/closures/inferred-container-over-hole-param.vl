// @run
// @log 55
// @log 55
// @log 55
// @log 55
// @log 55
// @log 66
// AN INFERRED CONTAINER OVER AN UN-ANNOTATED CLOSURE PARAMETER (D1664).
//
// The checker leaves an un-annotated parameter the inference hole, so `[a]` and `{ f: a }`
// took an i32 element and field and the container's read was not a callable — at four
// different sentences, one per read shape. The monomorphizer knows the concrete type, and
// annotates the binding per instance the way it already annotates an inferred return list.
//
// The last pair is two instances of ONE body: the annotation is minted per instance, so
// `55` and `66` prove the two pins did not share one row.
function tail(a) {
  const xs = [a]
  const run = (m: i32) => xs[0](m)
  print(run(54))
}
function expr(a) {
  const xs = [a]
  print(xs[0](54))
}
function rebound(a) {
  const xs = [a]
  const f = xs[0]
  print(f(54))
}
function field(a) {
  const s = { f: a }
  print(s.f(54))
}
tail((n: i32) => n + 1)
expr((n: i32) => n + 1)
rebound((n: i32) => n + 1)
field((n: i32) => n + 1)
expr((n: i32) => n + 1)
expr((n: i32) => n + 12)
