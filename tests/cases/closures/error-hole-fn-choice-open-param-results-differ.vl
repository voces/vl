// @error cannot choose 'lenOf' here: called at (string) it returns i32
// A choice of un-annotated functions whose results differ, called at a caller's un-annotated
// parameter, is judged at the caller's pin and refused at the arm (D13782).
function twice(s) { return s + s }
function lenOf(s) { return s.length }
const k = [1].length > 1
function bad(z) {
  const f = if k { twice } else { lenOf }
  print(f(z))
}
bad("ab")
