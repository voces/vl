// @run
// @log 6.5
// @log 8
// @log 8
// @log 6.5
// @log 6.5
// @log 8
// One list of an un-annotated function, mapped by callbacks taking two different closed
// function types: each `.map` builds its own value at its callback's signature, so the same
// element is called at f64 by one and at i32 by the other.
function inc7(a) { return a + 1 }
function apF(r: (a: f64) => f64) { return r(5.5) }
function apI(r: (a: i32) => i32) { return r(7) }
const v = [inc7]
print(v.map(apF)[0])
print(v.map(apI)[0])
print(v.map(apI)[0])
print(apF(v[0]))
const w = [inc7]
const fs = w.map(apF)
const ns = w.map(apI)
print(fs[0])
print(ns[0])
