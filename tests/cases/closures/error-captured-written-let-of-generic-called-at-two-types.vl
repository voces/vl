// @emit-error the reassigned function binding `k` holds functions called at more than one argument type
// A capture cell holds one closure signature, so a cell seeded with a generic function and
// called at two argument types is refused rather than built at one of them (D3939).
function inner<U>(u: U) {
  print("I")
  print(u)
}
function other<V>(v: V) {
  print("O")
  print(v)
}
function main() {
  let k = inner
  const flip = () => {
    k = other
  }
  k(1)
  k("s")
}
main()
