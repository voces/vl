// @emit-error the reassigned function binding `k` holds functions called at more than one argument type
// A `let` a closure writes keeps one slot even when its list read reaches one call type: the slot
// plan cannot rename the closure's write, so the binding is refused rather than split (D7102).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function main() {
  let k = inner
  const flip = () => {
    k = other
  }
  const fs = [k]
  k = inner
  fs[0](3)
  k(true)
}
main()
