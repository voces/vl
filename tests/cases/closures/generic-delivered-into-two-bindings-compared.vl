// @run
// @log true
// @log true
// @log false
// @log true
// @log true
// @log 1
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// Each delivery of a generic into a function type builds its own adapter, and two adapters of one
// declaration at one signature are one function value (D7382).
function two<T>(_x: T) { return 1 }
function three<T>(_x: T) { return 3 }
const p: (x: i32) => i32 = two
const q: (x: i32) => i32 = two
const o: (x: i32) => i32 = three
print(p == q)
print(p == two)
print(p == o)
function same(f: (x: i32) => i32, g: (x: i32) => i32) { return f == g }
print(same(two, two))
function hole(_x) { return 1 }
const h: (x: i32) => i32 = hole
const k: (x: i32) => i32 = hole
print(h == k)
print(q(5))
