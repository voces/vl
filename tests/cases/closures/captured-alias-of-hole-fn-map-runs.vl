// @run
// @log 1.5
// @log 4
// A closure capturing a local alias of a map whose function values have hole types reads the
// env field as the map the local is (D15163).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const m = Map()
m.set("a", inc0)
m.set("b", half)
function w() {
  const c = m
  const f = () => {
    const g = c.get("b")
    if g != null { print(g(3)) }
  }
  f()
}
w()
if true {
  const c = m
  const f = () => {
    const g = c.get("a")
    if g != null { print(g(3)) }
  }
  f()
}
