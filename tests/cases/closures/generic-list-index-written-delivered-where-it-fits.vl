// @run
// @log 3
// @log s
// A module-scope list of a generic function whose element is overwritten by a fixed-type function
// runs where it is delivered at the type that function takes, beside a call of the generic at
// another type that cannot reach the list (D10122).
function id<T>(x: T): T { x }
function inc(x: i32) { x + 1 }
const ys = [id]
ys.push(id)
ys[1] = inc
function run(a: ((x: i32) => i32)[]) { print(a[1](2)) }
run(ys)
print(id("s"))
