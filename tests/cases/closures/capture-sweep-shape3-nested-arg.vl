// @run
// @log 1
// @log 1
// A closure capturing a binding held as the atom reads it at a string at a nested argument: the
// captured atom, decoded (capture binding shape 3, Q58 position sweep).
const A = "x"
const B = "y"
function takeS(s: string) { return s.length }
function id<T>(t: T): T { return t }
function main(c: boolean) {
  const M = if c { A } else { B }
  const f = () => takeS(id(M))
  print(f())
}
main(true)
main(false)
