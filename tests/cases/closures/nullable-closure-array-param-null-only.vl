// A NULLABLE closure ARRAY parameter (`((i32, i32, i32) => f32)[] | null`) whose only
// caller passes `null`. It is the CROSS of two cases the function-value collector already
// covered separately — a closure ARRAY and a NULLABLE closure — and neither reaches it:
// the annotation node is a `TyNullable` (so the closure-array test declines) and its
// non-null part is an ARRAY, not a closure (so the nullable-closure test declines). With
// no lambda anywhere else in the program to flip the machinery on, the element signature
// never interned and the narrowed indexed call was rejected with "function-value call
// arity has no interned signature" — a loud reject for a program every part of which is
// representable.
// @run
// @log NULL
// @log 3
function useIt(p: ((i32, i32, i32) => f32)[] | null) {
  const t0 = p
  if t0 != null {
    print(t0[0](1, 1, 1))
  } else {
    print("NULL")
  }
}

function useLocal() {
  const q: ((i32, i32, i32) => i32)[] | null = null
  if q != null {
    print(q[0](1, 1, 1))
  } else {
    print(3)
  }
}

useIt(null)
useLocal()
