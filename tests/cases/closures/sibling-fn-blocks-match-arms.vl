// @run
// @log 1.5
// @log s

// D2316 matrix — the shared name is bound once per `match` arm body.

function f(n: i32) {
  let out = ""
  match n {
    0 => {
      const g = () => 1.5
      out = "\{g()}"
    }
    _ => {
      const g = () => "s"
      out = out + g()
    }
  }
  out
}
print(f(0))
print(f(1))
