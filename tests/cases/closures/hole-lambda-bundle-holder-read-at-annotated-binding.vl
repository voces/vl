// @run
// @log 5
// @log 4
// @log 5
// @log 4
// @log 4
// @log 5
// @log 2.5
// @log 8
// A bundle holder's read bound at one member's annotated type takes that member, inside a
// function, inside a lambda, beside calls through the holder at both signatures, and at the top
// level (D15749).
function lap(f) {
  f(2.5)
  f(3)
  return f
}
function main() {
  const k = lap((a) => a + 1)
  const m: (f64) => f64 = k
  const n: (i32) => i32 = k
  print(m(4))
  print(n(3))
  const r = () => {
    const q: (f64) => f64 = k
    print(q(4))
  }
  r()
  print(k(3))
  const j = lap((a) => a + 1)
  const p: (i32) => i32 = j
  print(p(3))
  print(j(4))
  print(j(1.5))
}
main()
const c = lap((a) => a + 1)
const v: (f64) => f64 = c
print(v(7))
