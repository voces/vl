// @run
// @log 7 4.5
// @log 7 4.5
// @info `q` is never reassigned; use `const` instead of `let`
// @hint Intentionally-unused variable `_a`
// @hint Intentionally-unused variable `_b`
// A list element holding a record of one closure per signature whole, written again with another
// such record, in a function's body: the copy and the place call take the written record's member.
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
function run(k: i32) {
  let q = [lap((a) => a + k)]
  q[0] = lap((a) => a + 3)
  const u = q[0]
  print("\{u(4)} \{u(1.5)}")
  print("\{q[0](4)} \{q[0](1.5)}")
}
run(1)
