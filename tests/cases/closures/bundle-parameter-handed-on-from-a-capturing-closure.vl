// @run
// @log 3.5
// @log 8
// @log 5
// @log 14
// @log 3.5
// @log 8
// @log 3.5
// @log 8
// @log 1
// @log 2.5
// @log 1
// @log 7
// @log 9
// @log 1
// @log true
// A parameter called at two signatures and handed whole to a named function from inside a
// closure that captures it, at any depth: the closure hands on the record the parameter holds,
// beside a hand from the function's own body and a callee that copies its parameter.
function keep(g) { print(g(7)) }
function keepDeep(g) { print(g(7)) }
function keepCopy(g) {
  const q = g
  print(q(7))
}
function keepOwn(g) { print(g(7)) }
function keepBool(g) { print(g(true)) }
function lap(f) {
  print(f(2.5))
  const h = () => keep(f)
  h()
}
function lapDeep(f) {
  print(f(2.5))
  const h = () => {
    const h2 = () => keepDeep(f)
    h2()
  }
  h()
}
function lapCopy(f) {
  print(f(2.5))
  const h = () => keepCopy(f)
  h()
}
function lapBoth(f) {
  print(f(2.5))
  keepOwn(f)
  const h = (n: i32) => {
    print(n)
    keepBool(f)
  }
  h(9)
}
function go(k: i32) {
  lap((a) => a + k)
  lap((a) => a * k * 2)
  lapDeep((a) => a + k)
  lapCopy((a) => a + k)
  lapBoth((a) => {
    print(k)
    a
  })
}
go(1)
