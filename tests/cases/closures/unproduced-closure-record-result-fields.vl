// @run
// @log 0
// @log 4
// @log false
// @hint Intentionally-unused function `_readNiche`
// @hint Intentionally-unused function `_callField`
// @hint Intentionally-unused function `_throughList`
// A closure parameter whose record result holds a niche-nullable field and a function field,
// read and called through the call's result, in functions no producer of that closure type
// reaches and beside one it does: the annotation interns the record's row (D16906, D16907).
function _readNiche(p: () => {f: string | null}) { print(p().f ?? "d") }
function _callField(p: () => {f: () => i32}) { print(p().f()) }
function _throughList(p: () => {f: () => i32}[]) { print(p()[0].f()) }
function both(p: () => {g: () => i32, n: boolean | null}) {
  const r = p()
  print(r.g())
  print(r.n ?? false)
}
print(0)
both(() => ({ g: () => 4, n: null }))
