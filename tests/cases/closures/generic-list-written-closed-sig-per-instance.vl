// @run
// @log 3
// @log s
// @log 8
// @log 4
// @log 6
// A list of a generic written with a closed function takes that function's signature, but only
// outside a generic: inside one the lambda's parameter is the instance's own type parameter.
function id<T>(x: T): T { x }
function inc(x: i32) { x + 1 }
function g<T>(v: T): T {
  const ys = [id]
  ys.push((x: T) => x)
  ys[1](v)
}
print(g(3))
print(g("s"))
function h(v: i32) {
  const zs = [id]
  zs[0] = (x: i32) => x * 2
  zs[0](v)
}
print(h(4))
const as = [id]
as[0] = inc
for f in as { print(f(3)) }
const bs = [id, id]
bs.push(inc)
print(bs[2](5))
