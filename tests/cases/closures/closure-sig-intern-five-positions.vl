// @run
// @log 7
// @log 9
// @log 11
// @log 13
// @log 15
// The FIVE structural positions from which a closure `$fnsig` is interned WITHOUT a
// concrete lambda of that shape — every one of them reaching the single
// `internCloSigOfAtom` home in `emit_collect` (D-SIGHOME). Each position below carries
// a closure type that NO lifted lambda in this program produces, so the narrowed value
// call can only resolve if that position's own pass interned the signature from the
// ANNOTATION. Drop any one of the five and its `print` becomes a "no interned
// signature" reject.
//
// This file exists because the intern grammar was hand-written NINE times and the five
// annotation-driven copies were only ever pinned INCIDENTALLY, by files whose subject
// was something else. It pins the home's REACHABILITY from each position by name.
//
// GRADED, one position per isolated program, against a probe build whose atom home
// interns nothing: **4 of the 5 flip from the printed value to `emitProgram:
// function-value call arity has no interned signature`** — positions 1, 2, 4 and 5.
// POSITION 3 DOES NOT, and that is stated rather than hidden: a nulclosure whose result
// is a plain SCALAR is ALSO interned by the result-SPINE walk (`internNulCloResultSpine`
// → `internCloResultSpine`, which takes a plain-scalar result and interns through the
// raw key home, not the atom home). So position 3 is documentation here, not a pin —
// its own pass is redundant FOR THIS RESULT SHAPE. That is a coverage statement about
// one shape, not a licence to delete the pass: a result outside `cloResultIsPlainScalar`
// (a string, a map, a litunion, a union) is not taken by the spine.

// POSITION 1 — a FUNCTION-TYPE UNION ARM (`(() => i64) | i64`). The arm is not a
// concrete lambda anywhere; the union-member walk interns it from the arm spelling.
function p1(t0: (() => i32) | i32) {
  if t0 is () => i32 { return t0() }
  return 7
}

// POSITION 2 — a CLOSURE-ARRAY element of a union ARM (`((i32) => i32)[] | i32`). The
// arm is an array, so the function-arm branch keys "" for it; the element is keyed
// separately through `cloArrElemNameOf`.
function p2(t1: ((i32) => i32)[] | i32) {
  if t1 is ((i32) => i32)[] {
    if t1.length > 0 { return t1[0](1) }
    return 8
  }
  return 9
}

// POSITION 3 — a NULLABLE-CLOSURE annotation (`(() => i32) | null`) whose value is only
// ever `null`. No lambda of this shape exists; the TypeRef pass interns the inner
// closure key so the null-narrowed call resolves.
function p3(t2: (() => i32) | null) {
  if t2 != null { return t2() }
  return 11
}

// POSITION 4 — a CLOSURE-ELEMENT ARRAY annotation (`((i32) => i32)[]`) holding no
// lambda (an empty literal). The indexed call still `ref.cast`s to the element sig.
function p4(t3: ((i32) => i32)[]) {
  if t3.length > 0 { return t3[0](2) }
  return 13
}

// POSITION 5 — a closure buried where no name-walk recursion enumerates it: a closure
// FIELD of a struct that is itself a nullable annotation. Only the ARENA walk's
// `TyFunc` arm reaches it, and it renders + keys through the SAME home.
function p5(t4: { g: (i32) => i32 } | null) {
  if t4 != null { return t4.g(3) }
  return 15
}

const a: (() => i32) | i32 = 4
const b: ((i32) => i32)[] | i32 = 5
const c: (() => i32) | null = null
const d: ((i32) => i32)[] = []
const e: { g: (i32) => i32 } | null = null

print(p1(a))
print(p2(b))
print(p3(c))
print(p4(d))
print(p5(e))
