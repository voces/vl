// @log 2.5
// A list literal of un-annotated functions returned from an un-annotated function, read back by
// callers that call its elements at different argument types, takes a copy of the function per
// pin, so each copy's literal is instanced at one signature (D9450).
function inc0(a) { return a + 1 }
function dbl0(a) { return a * 2 }
function deliver0() { return [inc0, dbl0] }
const v0 = deliver0()
print(v0.map((f) => f(3))[1])
const u0 = deliver0()
print(u0.map((f) => f(1.25))[1])

function inc1(a) { return a + 1 }
function dbl1(a) { return a * 2 }
function deliver1() {
  const fs = [inc1, dbl1]
  return fs
}
const v1 = deliver1()
print(v1.map((f) => f(3))[1])
const u1 = deliver1()
print(u1.map((f) => f(1.25))[1])

function inc2(a) { return a + 1 }
function dbl2(a) { return a * 2 }
function deliver2() { return [inc2, dbl2] }
const v2 = deliver2()
print(v2.map((f) => f(3))[1])
const u2 = deliver2()
print(u2.map((f) => f(1.25))[1])
const w2 = deliver2()
print(w2.map((f) => f(7))[0])

function inc3(a) { return a + 1 }
function dbl3(a) { return a * 2 }
function deliver3() { return [inc3, dbl3] }
const v3 = deliver3()
print(v3.filter((f) => f(3) > 5).length)
const u3 = deliver3()
print(u3.filter((f) => f(1.25) > 2.4).length)

function twice4(a) { return a + a }
function same4(a) { return a }
function deliver4() { return [twice4, same4] }
const v4 = deliver4()
print(v4.map((f) => f(3))[0])
const u4 = deliver4()
print(u4.map((f) => f("ab"))[0])

function inc5(a) { return a + 1 }
function dbl5(a) { return a * 2 }
function deliver5() { return [inc5, dbl5] }
function main5() {
  const v = deliver5()
  print(v.map((f) => f(3))[1])
  const u = deliver5()
  print(u.map((f) => f(1.25))[1])
}
main5()

function inc6(a) { return a + 1 }
function dbl6(a) { return a * 2 }
function deliver6() { return [inc6, dbl6] }
print(deliver6().map((f) => f(3))[1])
print(deliver6().map((f) => f(1.25))[1])

function inc7(a) { return a + 1 }
function dbl7(a) { return a * 2 }
function deliver7() { return [inc7, dbl7] }
const v7 = deliver7()
for f in v7 { print(f(3)) }
const u7 = deliver7()
for f in u7 { print(f(1.25)) }

function inc8(a) { return a + 1 }
function dbl8(a) { return a * 2 }
function deliver8() { return [inc8, dbl8] }
const v8 = deliver8()
print(v8[1](3))
const u8 = deliver8()
print(u8.map((f) => f(1.25))[1])
