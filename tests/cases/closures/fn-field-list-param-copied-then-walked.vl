// @run
// @log 5.5
// @log 5.5
// A list of records of un-annotated functions of different results handed to a parameter the
// callee copies into a `const` and walks with `for`: the loop walks the parameter (D16233).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function mk() { return { a: [{ f: inc0 }, { f: half }] } }
function take(a) {
  const v = a
  let acc = 0.0
  for e in v { acc = acc + e.f(3) }
  print(acc)
}
take(mk().a)
const L = mk().a
take(L)
