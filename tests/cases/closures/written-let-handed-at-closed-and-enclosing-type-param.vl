// @run
// @log 8
// @log y
// @log 7
// @log 1.5
// @log p
// @log y
// @log 2.5
// @log 1.5
// @log 8
// @log y
// @log 7
// @log 1.5
// A `let` of generics no later write re-points, handed to a generic's parameter at a closed type
// and at the enclosing generic's own type parameter, is built per instance by an adapter that
// calls the `let` (D15103).
function fst<T>(xs: T[]): T { return xs[0] }
function lst<T>(xs: T[]): T { return xs[xs.length - 1] }
function app<T>(g: (x: T[]) => T, v: T[]): T { return g(v) }
function both<U>(u: U[]): U {
  let f = fst
  if u.length > 1 { f = lst }
  print(app(f, [7, 8]))
  app(f, u)
}
print(both(["x", "y"]))
print(both([1.5]))
function twoOpen<U>(u: U[], w: U[]): U {
  let f = fst
  if u.length > 1 { f = lst }
  print(app(f, w))
  app(f, u)
}
print(twoOpen(["x", "y"], ["p"]))
print(twoOpen([1.5], [2.5]))
function chosen<U>(u: U[]): U {
  const f = if u.length > 1 { lst } else { fst }
  print(app(f, [7, 8]))
  app(f, u)
}
print(chosen(["x", "y"]))
print(chosen([1.5]))
