// @run
// @log aC
// @log aE
// @log aC
// @log aE
// @log aE
// @info `d2` is never reassigned; use `const` instead of `let`
// @info `d2` is never reassigned; use `const` instead of `let`
// @info `d3` is never reassigned; use `const` instead of `let`
// A `let` re-alias taken after a write to the alias it copies calls the written lambda, not
// the one the chain was initialized with (D3849). Taken before the write, it keeps the old one.
function after(x: string) {
  const c = (y) => y + "C"
  const e = (y) => y + "E"
  let d = c
  print(d(x))
  d = e
  let d2 = d
  print(d2(x))
}
after("a")

function beforeAndAfter(x: string) {
  const c = (y) => y + "C"
  const e = (y) => y + "E"
  let d = c
  let d2 = d
  d = e
  let d3 = d
  print(d2(x))
  print(d(x))
  print(d3(x))
}
beforeAndAfter("a")
