// @error cannot write 'half' to an element of 'm': called at (i32) it returns f64, where 'inc0', also written to it, returns i32 — every function a call through an element of 'm' may run must return one type
// Un-annotated functions of different results written into one un-annotated `Map()` are refused
// as the same pair in a list is: a call through the map's value runs either (D9311).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const m = Map()
m.set("a", inc0)
m.set("b", half)
const x = m.get("b")
if x != null { print(x(3)) }
