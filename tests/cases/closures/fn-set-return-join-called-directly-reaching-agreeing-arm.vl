// @run
// @log 4
// @hint Intentionally-unused parameter `_a` (leading `_` marks it unused)
// A call through a function whose returns join un-annotated functions with different results
// dispatches on the member it holds, here `inc` (D13965).
function inc(a) { return a + 1 }
function str(_a) { return "s" }
function sel(c: boolean) {
  if c { return inc }
  return str
}
print(sel(true)(3))
