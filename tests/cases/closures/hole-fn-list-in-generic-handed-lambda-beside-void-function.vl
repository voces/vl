// @run
// @warning Unused parameter
// @log 3
// @log 30
// @log 9
// D10702: the list's element name drops its hole parameter, so it names the slot a
// declared `() => void` function interns; the loop keys the element, not that slot.
function apply2(g) { print(g(1, 2)) }
function apply3(g) { print(g(10, 20)) }
function gen<T>(x: T) {
  const gs = [apply2, apply3]
  for f in gs { f((a, b) => a + b) }
}
gen("z")
function tick() { print(9) }
tick()
