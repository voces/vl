// @error cannot infer type parameter `U`: `cnst`'s return type names it and no parameter does
// A generic handed to `.map` is called at the element as `cnst(3)` is, so a type parameter
// only its result names has nothing to bind it from there either (D9073).
function cnst<T, U>(t: T): U[] { return [] }
const ys = [3].map(cnst)
print(ys.length)
