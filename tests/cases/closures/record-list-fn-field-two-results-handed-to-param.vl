// @run
// @log 1.5
// A list literal of records whose function field holds functions of different results, handed
// to an un-annotated parameter and called through, dispatches per member (D15802).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function take(v) { print(v[1].f(3)) }
take([{ f: inc0 }, { f: half }])
