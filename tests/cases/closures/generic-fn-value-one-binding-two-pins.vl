// @run
// @log 1
// @log s
// @log 2.5
// @log 1
// @log s
// @log 1
// @log s
// @log 3
// @log 1
// @log z
// @log true
// @log 1
// @log 4
// @log 2
// @log t
// @log 3
// @log 5
// @log 4
// @log u
// @log 6
// @log v
// @log 7
// @log w
// @log false
// @log once
// @log 8
// @log x
// A binding of a generic returned from a function, called at several types, takes one slot per
// type; a hole-parameter, block-local or value-read maker still gets a copy per result.
function k<T>(x: T): T { return x }
function mk() { return k }
function mkN(n) {
  print(n)
  return k
}
function fw(f) { return f }
function one() {
  const a = mk()
  print(a(1))
  print(a("s"))
  print(a(2.5))
}
function local() {
  function mkL() { return k }
  const a = mkL()
  print(a(1))
  const b = mkL()
  print(b("s"))
}
function valueRead() {
  const a = mk()
  print(a(1))
  const b = mk()
  print(b("s"))
  const h: () => (x: i32) => i32 = mk
  print(h()(3))
}
function beside() {
  const a = fw(k)
  print(a(1))
  print(a("z"))
  const b = fw(k)
  print(b(true))
}
one()
local()
valueRead()
beside()
const c = mkN(1)
print(c(4))
const d = mkN(2)
print(d("t"))
function holeInFn() {
  const e = mkN(3)
  print(e(5))
  const f = mkN(4)
  print(f("u"))
}
holeInFn()
const m = fw(k)
print(m(6))
print(m("v"))
const n = fw(k)
print(n(7))
print(n("w"))
print(n(false))
function mkSay() {
  print("once")
  return k
}
function sayOnce() {
  const s = mkSay()
  print(s(8))
  print(s("x"))
}
sayOnce()
