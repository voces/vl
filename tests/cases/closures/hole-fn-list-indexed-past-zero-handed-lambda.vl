// @run
// @log 30
// D10793: a list of hole functions read at an index past 0 and handed an un-annotated lambda;
// the lambda takes the types the element's own calls of its parameter pass.
function apply2(g) { print(g(1, 2)) }
function apply3(g) { print(g(10, 20)) }
function gen() {
  const gs = [apply2, apply3]
  gs[1]((a, b) => a + b)
}
gen()
