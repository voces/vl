// A `const` bound to an `if` / `else if` chain or a `match` choosing between generic functions,
// used at more than one type, where a later condition calls a function that prints: the chain
// runs once, at the binding, each condition as often and in the order the source says, and
// every type's use reads the arm it chose (D9322).
function idg<T>(t: T): T { return t }
function kg<T>(t: T): T { return t + t }
function tg<T>(t: T): T { return t + t + t }
function say(tag: string, want: boolean) {
  print(tag)
  return want
}

// Three arms, the second condition calls.
const a = if 1 > 2 { kg } else if say("a2", true) { idg } else { kg }
print(a(3))
print(a("x"))

// Three arms, both conditions call; the last arm is chosen.
const b = if say("b1", false) { kg } else if say("b2", false) { idg } else { tg }
print(b(3))
print(b("x"))

// Four arms, a calling condition in each position, the third chosen.
const c = if say("c1", false) { kg } else if say("c2", false) { idg } else if say("c3", true) { tg } else { kg }
print(c(3))
print(c("x"))

// Four arms, the first chosen: no later condition runs.
const d = if say("d1", true) { tg } else if say("d2", true) { idg } else if say("d3", true) { kg } else { kg }
print(d(3))
print(d("x"))

// A `match` nested as an `else` arm in a function body, whose scrutinee calls only when the
// `if` fails.
function which() {
  print("which")
  return 2
}
function nested(w: boolean) {
  const e = if say("e1", w) { idg } else { match which() {
    1 => idg
    2 => tg
    _ => kg
  } }
  print(e(3))
  print(e("x"))
}
nested(false)
nested(true)

// A `match` nested as a `match` arm in a function body: each scrutinee runs once.
function inner(tag: string) {
  print(tag)
  return 2
}
function nested2() {
  const g = match inner("f1") {
    1 => idg
    _ => match inner("f2") {
      1 => idg
      2 => tg
      _ => kg
    }
  }
  print(g(3))
  print(g("x"))
}
nested2()

// A `match` whose scrutinee calls, choosing between generic functions in an arm.
const m = match which() {
  1 => idg
  _ => if say("m2", false) { idg } else { kg }
}
print(m(3))
print(m("x"))

// Inside a function body, between the prints.
function run(w: boolean) {
  print("before")
  const g = if say("g1", false) { kg } else if say("g2", w) { idg } else { tg }
  print("after")
  print(g(3))
  print(g("x"))
}
run(true)
run(false)

// In a loop, once per iteration.
let i = 0
while i < 3 {
  const q = if say("q1", i == 0) { kg } else if say("q2", i == 1) { idg } else { tg }
  print(q(i))
  print(q("y"))
  i = i + 1
}
