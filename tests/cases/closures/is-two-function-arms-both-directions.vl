// @run
// @log ret<-A is-A yes
// @log ret<-A is-B no
// @log ret<-B is-A no
// @log ret<-B is-B yes
// @log bol<-A is-A yes
// @log bol<-A is-B no
// @log bol<-B is-A no
// @log bol<-B is-B yes
// @log par<-A is-A yes
// @log par<-A is-B no
// @log par<-B is-A no
// @log par<-B is-B yes
// @log ari<-A is-A yes
// @log ari<-A is-B no
// @log ari<-B is-A no
// @log ari<-B is-B yes
// @log nil<-A is-A yes
// @log nil<-A is-B no
// @log nil<-B is-A no
// @log nil<-B is-B yes
// @log call<-A
// @log 42
// @log call<-B
// @log other
// A union with TWO function-typed arms answers `is` by SIGNATURE, in both directions.
//
// THE AXIS IS THE ARM'S SIGNATURE, NOT WHICH PART OF IT DIFFERS. The five shapes below
// move the RETURN type, the return's REP-SHARING twin (`boolean` against `i32`), the
// PARAM type, the ARITY and zero-arity-against-one. They grade alike because none of them
// is the axis: a bare function-typed arm tags on the SLOT its canonical structural render
// interns at (`cloSigTagSlot` → `cloSigSlotTag`), so any two arms whose renders differ get
// different tags and any two whose renders agree get one tag.
//
// THE `bol` SHAPE IS THE SILENT ONE, AND THAT IS WHY IT IS HERE. Its two arms emit
// STRUCTURALLY IDENTICAL wasm functypes — `(func (param structref i32) (result i32))` for
// both, since `boolean` and `i32` are one wasm result — so `call_indirect` cannot separate
// them. Every other shape below has a loud floor under a wrong answer (the mis-narrowed
// value traps at the first call, which is what the `call<-` rows stand on); this one has
// none, and a wrong answer rides all the way out as a wrong VALUE.
//
// EVERY ROW IS PINNED IN BOTH DIRECTIONS — a value built through each arm, tested against
// each arm — because ONE shared tag makes `is` a constant TRUE, and under a constant TRUE
// exactly half the cells are right by accident. The `<-A is-A` / `<-B is-B` rows alone
// cannot tell a discriminating box from a degenerate one; their `<-B is-A` / `<-A is-B`
// twins are what do.
//
// The `call<-` rows are what the answer buys: the guard's branch is what decides which
// `$fnsig` the narrowed value is called at, so a wrong answer here is a
// `wasm trap: indirect call type mismatch` at the call one line later.

type RA = (i32) => i32
type RB = (i32) => string
type BA = (i32) => i32
type BB = (i32) => boolean
type PA = (i32) => i32
type PB = (string) => i32
type AA = (i32) => i32
type AB = (i32, i32) => i32
type NA = (i32) => i32
type NB = () => i32

function retB(n: i32) {
  if n > 0 { return "s" }
  "t"
}

function parB(s: string) {
  s.length
}

function pRet(lbl: string, x: RA | RB) {
  if x is RA { print(lbl + " is-A yes") } else { print(lbl + " is-A no") }
  if x is RB { print(lbl + " is-B yes") } else { print(lbl + " is-B no") }
  0
}

function pBol(lbl: string, x: BA | BB) {
  if x is BA { print(lbl + " is-A yes") } else { print(lbl + " is-A no") }
  if x is BB { print(lbl + " is-B yes") } else { print(lbl + " is-B no") }
  0
}

function pPar(lbl: string, x: PA | PB) {
  if x is PA { print(lbl + " is-A yes") } else { print(lbl + " is-A no") }
  if x is PB { print(lbl + " is-B yes") } else { print(lbl + " is-B no") }
  0
}

function pAri(lbl: string, x: AA | AB) {
  if x is AA { print(lbl + " is-A yes") } else { print(lbl + " is-A no") }
  if x is AB { print(lbl + " is-B yes") } else { print(lbl + " is-B no") }
  0
}

function pNil(lbl: string, x: NA | NB) {
  if x is NA { print(lbl + " is-A yes") } else { print(lbl + " is-A no") }
  if x is NB { print(lbl + " is-B yes") } else { print(lbl + " is-B no") }
  0
}

function pCall(lbl: string, x: RA | RB) {
  if x is RA {
    print(lbl)
    print(x(41))
  } else {
    print(lbl)
    print("other")
  }
  0
}

pRet("ret<-A", (n: i32) => n + 1)
pRet("ret<-B", retB)
pBol("bol<-A", (n: i32) => n + 1)
pBol("bol<-B", (n: i32) => n > 0)
pPar("par<-A", (n: i32) => n + 1)
pPar("par<-B", parB)
pAri("ari<-A", (n: i32) => n + 1)
pAri("ari<-B", (n: i32, m: i32) => n + m)
pNil("nil<-A", (n: i32) => n + 1)
pNil("nil<-B", () => 7)
pCall("call<-A", (n: i32) => n + 1)
pCall("call<-B", retB)
