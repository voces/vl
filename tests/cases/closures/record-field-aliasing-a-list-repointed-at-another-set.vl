// @log 4
// A record whose field reads a list binding read elsewhere too, re-pointed at a literal of
// another function, widens the field and keeps the list's own set, decided with the field's
// (D16242).
function id1(x) { return x }
function id2(x) { return x + x }
const xs = [id1]
let r = { f: xs }
r = { f: [id2] }
print(r.f[0](2.5))
print(xs[0](3))
const ys = [id1]
let q = { f: ys }
print(q.f[0](2.5))
q = { f: [id2] }
print(q.f[0](2.5))
print(ys[0](3))
const zs = [id1]
let u = { f: zs }
u = { f: [id2] }
print(u.f[0](2.5))
const ws = [id1]
let v = { f: ws }
print(v.f[0](2.5))
print(ws[0](3))
function inc(a) { return a + 1 }
function ten(a) { return a * 10 }
const ts = [inc]
let t = { f: ts }
t = { f: [ten] }
print(t.f[0](2))
print(t.f[0](2.5))
print(ts[0](3))
