// @run
// @log CLOSURE
// @log 7
// @log true
// @log false
// @log false
// @log LIST
// @hint Intentionally-unused parameter `_q0`
// @hint Intentionally-unused parameter `_q1`
// @hint Intentionally-unused parameter `_q2`
// Cell 5's annotation on `e` is the SUBJECT (it is the only thing that spells the result
// union at that binding), so its redundancy hint is declared rather than dodged.
// @hint redundant type annotation: `e` is inferred as
// @hint Intentionally-unused parameter `_q4`
// THE GRID AROUND `closure-arm-narrow-tag-agreement.vl` — the cells whose verdicts moved
// when `internFuncTypeShapesTy` gained its composite-union arm and `refArmUnionRetName`'s
// `hasObjSibling` decline came off, plus the two that must NOT move.
//
// Cell 1 (was `emitProgram: array value does not match any array member of the union`): the
// anonymous element WITHOUT an object sibling. `refArmUnionRetName` always admitted this
// spelling, so the lambda was pinned — and the pinned coerce then rejected, because the
// element shape had never interned. This is the cell that proves the reject belonged to the
// interner and not to the pin: nothing about the PIN changed for it.
//
// Cell 2 (was `OTHER`, the silent wrong answer): the object arm and the array arm in the
// REVERSED order, with the lambda returning the OBJECT arm rather than the list. Order
// independence is the point — `refArmUnionRetName` walks the members, so an arm-position
// dependence here would be a rendering bug rather than a rep one.
//
// Cell 3 (unchanged, and the guard on the fix): TWO closure arms with DIFFERENT signatures.
// `cloSigSlotTag` separates them by interned signature slot, which is the whole of D6 — a
// value built through one arm must not answer `is` for the other. The first `is` is TRUE and
// the second FALSE; a fix that collapsed the two tags would print `true` twice.
//
// Cell 4 (unchanged): the f64 arm is the live one, so the closure test is FALSE. The tag
// compare has to answer NO for a box that holds no closure at all.
//
// Cell 5 (was `emitProgram: value-union closure RESULT is not yet representable`): the
// ANNOTATED closure-typed binding of the same result union, with no enclosing union at all.
// It shares cell 1's cause — the annotation's own `internFuncTypeShapesTy` walk reached the
// result and fell past every arm — so it is the cell that shows the hole was in the functype
// interner rather than in the closure-ARM machinery.

// 1. anonymous element, NO object sibling.
function mk1(): ((i32) => {f: boolean}[] | f64) | i32 {
  return (_q0) => ([{ f: true }])
}

// 2. object arm FIRST, array arm second; the lambda returns the object arm.
function mk2(): ((i32) => {w: i32} | {f: boolean}[]) | f64 {
  return (_q1) => ({ w: 7 })
}

// 3. two closure arms with different signatures.
function mk3(): ((i32) => {f: boolean}[] | {w: i32}) | ((i32) => i64) | f64 {
  return (_q2) => ([{ f: true }])
}

// 4. the scalar arm is live.
function mk4(): ((i32) => {f: boolean}[] | {w: i32}) | f64 { return 2.5 }

function go() {
  const a = mk1()
  if a is (i32) => {f: boolean}[] | f64 {
    print("CLOSURE")
  } else {
    print("OTHER")
  }

  const b = mk2()
  if b is (i32) => {w: i32} | {f: boolean}[] {
    const r = b(1)
    if r is {w: i32} { print(r.w) } else { print("OTHER-INNER") }
  } else {
    print("OTHER")
  }

  const c = mk3()
  print(c is (i32) => {f: boolean}[] | {w: i32})
  print(c is (i32) => i64)

  const d = mk4()
  print(d is (i32) => {f: boolean}[] | {w: i32})

  const e: (i32) => {f: boolean}[] | {w: i32} = (_q4) => ([{ f: true }])
  const er = e(1)
  if er is {f: boolean}[] { print("LIST") } else { print("OTHER") }
}
go()
