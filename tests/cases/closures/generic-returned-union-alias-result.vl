// @run
// @log 1
// @log s
// @log t
// @log 2
// A generic function value returned from an un-annotated function, delivered once at a union alias
// and once at the union it names, is called at both arms through each destination.
type U = i32 | string
function pick<T>(r: { k: T }): T { return r.k }
function deliver() { return pick }
const v: (r: { k: U }) => U = deliver()
const w: (r: { k: i32 | string }) => i32 | string = deliver()
print(v({ k: 1 }))
print(w({ k: "s" }))
print(v({ k: "t" }))
print(w({ k: 2 }))
