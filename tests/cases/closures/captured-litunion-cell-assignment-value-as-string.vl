// @run
// @log ww
// @log ww!
// @log zz-ww
// @log ww
// A captured literal-union cell's assignment used as a value where a `string` is wanted is the
// member's string: bound, concatenated, and passed to a string parameter.
type K = "zz" | "ww"
function tag(s: string) { return "zz-" + s }
function main() {
  let k: K = "zz"
  const set = (): string => {
    return k = "ww"
  }
  const s = set()
  print(s)
  print(set() + "!")
  print(tag(set()))
  print(k)
}
main()
