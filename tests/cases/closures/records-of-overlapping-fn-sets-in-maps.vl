// @log 6
// @log 1
// @log -1
// A map, or a list, of records whose function field holds a set within the set another map's
// records hold: each runs the member its record holds, whichever is written first (D16749).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function dbl(a) { return a * 2 }
const m = Map()
m.set("a", { f0: inc0 })
m.set("b", { f0: half })
const r = m.get("b")
if r != null { print(r.f0(3)) }
const n = Map()
n.set("a", { f0: inc0 })
n.set("b", { f0: half })
n.set("c", { f0: dbl })
const q = n.get("c")
if q != null { print(q.f0(3)) }
const p = Map()
p["a"] = { f0: inc0 }
p["b"] = { f0: half }
p["c"] = { f0: dbl }
const t = p.get("c")
if t != null { print(t.f0(3)) }
const u = Map()
u["a"] = { f0: inc0 }
u["b"] = { f0: half }
const v = u.get("b")
if v != null { print(v.f0(3)) }
const xs = [{ f0: inc0 }, { f0: half }]
print(xs[1].f0(3))
const w = Map()
w.set("a", { f0: inc0 })
w.set("b", { f0: half })
w.set("c", { f0: dbl })
for k, e in w { print(e.f0(3)) }
const z = Map()
z.set("a", { f0: inc0 })
z.set("b", { f0: half })
for k, e in z { print(e.f0(2) - 2) }
