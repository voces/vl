// @run
// @log a
// @log b
// @log a
// @log b
// @log true
// @log false
// @log <a>
// @log <b>
// @log b
// @log a
// D3169: a closure over an un-annotated `kn ?? e`, with `e` a walk variable over a literal
// union, its `| null` niche or a literal-union-keyed map, reads the joined atom.
type K = "a" | "b"
function t(ks: K[], kn: K | null, ns: (K | null)[]) {
  for e in ks {
    const k = kn ?? e
    const f = () => k
    print(f())
  }
  for e in ns {
    const k = e ?? "b"
    const f = () => k
    print(f())
  }
  for e in ks {
    const k = kn ?? e
    const f = () => k == "a"
    print(f())
  }
}
t(["a", "b"], null, ["a", null])
const m: {[K]: i32} = Map()
m.set("a", 1)
m.set("b", 2)
const kn: K | null = null
for e in m {
  const k = kn ?? e
  const f = () => "<\{k}>"
  print(f())
}
const zs: K[] = ["b", "a"]
for e in zs {
  const k = kn ?? e
  const f = () => k
  print(f())
}
