// @run
// @log 6
// @log 4
// A returned value `if` with a bound list of records in one arm and a literal of another set in
// the other runs, as two returns do.
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function viaIf(b) {
  const a = [{ fs: [inc0] }]
  return if b { a } else { [{ fs: [dbl] }] }
}
print(viaIf(false)[0].fs[0](3))
print(viaIf(true)[0].fs[0](3))
