// An inline list or record of un-annotated functions handed to an un-annotated parameter that the
// body delivers to an annotated destination takes the destination's type (D9610). The last three
// are controls that ran before: the list bound first, an annotated parameter, a bare function.
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function add(a, b) { return a + b }
function half(a) { return a / 2.0 }
function bound(a) {
  const k: ((x: i32) => i32)[] = a
  return k[0](4)
}
print(bound([inc0]))
function reassigned(a) {
  let k: ((x: i32) => i32)[] = []
  k = a
  return k[0](4)
}
print(reassigned([inc0]))
function field(a) {
  const r: { f: ((x: i32) => i32)[] } = { f: a }
  return r.f[0](4)
}
print(field([inc0]))
function returned(a): ((x: i32) => i32)[] { return a }
print(returned([inc0])[0](4))
function h(k: ((x: i32) => i32)[]) { return k[0](4) }
function handed(a) { return h(a) }
print(handed([inc0]))
function nested(a) {
  const k: ((x: i32) => i32)[][] = a
  return k[0][0](4)
}
print(nested([[inc0]]))
function rec(a) {
  const k: { f: (x: i32) => i32 } = a
  return k.f(4)
}
print(rec({ f: inc0 }))
function recList(a) {
  const k: { xs: ((x: i32) => i32)[] } = a
  return k.xs[0](4)
}
print(recList({ xs: [inc0] }))
function mid(a) { return bound(a) }
print(mid([inc0]))
print(bound([(x) => x + 1]))
print(bound([inc0]) + bound([dbl, inc0]))
function pair(a) {
  const k: ((x: i32, y: i32) => i32)[] = a
  return k[0](4, 5)
}
print(pair([add]))
function wide(a) {
  const k: ((x: f64) => f64)[] = a
  return k[0](3.0)
}
print(wide([half]))
const g = [inc0]
print(bound(g))
function ann(a: ((x: i32) => i32)[]) { return a[0](4) }
print(ann([inc0]))
function bare(a) {
  const k: (x: i32) => i32 = a
  return k(4)
}
print(bare(inc0))
