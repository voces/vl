// D7441: a closure capturing a tag read off a function LOCAL record union reads the env field
// as the atom the local's frame stored, whether the tag is one literal or a set of them and
// whether the read is plain or a `?.` coalesced inside the closure.
// @run
// @log b
// @log b
// @log z
// @log b
type N = { tag: "a" | "c", v: i32 } | { tag: "b", w: i32 }
function mk(a: boolean): N | null {
  if a { return null }
  { tag: "b", w: 2 }
}
function mkN(): N { { tag: "b", w: 2 } }
function plain() {
  const s = mkN()
  const t = s.tag
  const k = () => {
    print(t)
  }
  k()
}
plain()
function coalesced(a: boolean) {
  const t = mk(a)
  const c = t?.tag
  const f = () => {
    print(c ?? "z")
  }
  f()
}
coalesced(false)
coalesced(true)
function toString() {
  const s = mkN()
  const t = s.tag
  const k = () => {
    const z: string = t
    print(z)
  }
  k()
}
toString()
