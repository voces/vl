// @run
// @log a
// @log 3
// @log b
// @log s
// @log a
// @log 2.5
// @log b
// @log t
// The un-annotated spelling: hole functions in a list inside a hole-parameter function called at
// two types, read at a literal index and at a computed one (D7381).
function a(v) { print("a"); print(v) }
function b(v) { print("b"); print(v) }
function g(x, c: boolean) {
  const fs = [if c { a } else { b }]
  fs[0](x)
}
function pick(x, c: boolean) {
  const fs = [a, b]
  fs[if c { 0 } else { 1 }](x)
}
g(3, true)
g("s", false)
pick(2.5, true)
pick("t", false)
