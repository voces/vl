// @run
// @log 4
// @log 2
// @log s
// A generic read back from a map and stored as a record's field in a second map that is only ever
// written directly, then called at two types: the second map holds the generic's ids at the
// record row its held rep names (D15532).
function id<T>(x: T): T { x }
const m = Map()
m["k"] = id
const mv = m["k"]
if mv != null {
  const v = mv
  const n = Map()
  n["k"] = { f: v }
  const r = n["k"]
  if r != null { print(r.f(2) + r.f("ab").length) }
}
const a = Map()
a["k"] = { f: id }
const ar = a["k"]
if ar != null {
  print(ar.f(2))
  print(ar.f("s"))
}
