// @run
// @log O
// @log 4
// @log I
// @log 6
// @log O
// @log 7
// @log I
// @log 10
// @info `r` is never reassigned; use `const` instead of `let`
// An un-annotated alias of a capture cell's read (`const r = k`) delivers that cell: returned,
// passed, or through a `let` never written, the cell is instanced at the delivered type (D3948).
function ci(f: (n: i32) => void, n: i32) { f(n) }
function inner<U>(u: U) {
  print("I")
  print(u)
}
function other<V>(v: V) {
  print("O")
  print(v)
}
function mk(): (n: i32) => void {
  let k = inner
  const flip = () => {
    k = other
  }
  flip()
  const r = k
  return r
}
mk()(4)
function passed() {
  let k = inner
  const flip = () => {
    k = other
  }
  const r = k
  ci(r, 6)
  flip()
  const r2 = k
  ci(r2, 7)
}
passed()
function viaLet() {
  let k = inner
  const flip = () => {
    k = other
  }
  let r = k
  flip()
  ci(r, 10)
}
viaLet()
