// @run
// @log a!
// @log 2
// @log 4
// @log b!
// @log 2
// A `let` of un-annotated functions written with others is called as whichever it holds: at
// module scope, inside a function, and as an `if` arm's value.
function exclaim(s) { return s + "!" }
function ask(s) { return s + "?" }
const on = [1].length == 1
let lv = ask
lv = exclaim
print(lv("a"))
function inc(n) { return n + 1 }
function dbl(n) { return n * 2 }
let q = dbl
q = inc
print(q(1))
const m = if !on { inc } else { let q2 = dbl; q2 = inc; q2 }
print(m(3))
function main() {
  let lw = ask
  lw = exclaim
  print(lw("b"))
  let r = dbl
  if [1].length == 2 { r = inc }
  print(r(1))
}
main()
