// @run
// @log v
// @log 3
// A `let` copy of a hole parameter that is re-pointed is not the parameter: a `const` list
// literal holding it keeps the copy's own value, which the split plan builds (D15404).
function same<T>(k: T): T { k }
function dbl(x) { x }
function mid2(a) {
  let b = a
  b = dbl
  const r = [b]
  print(r[0]("v"))
  print(a(3))
}
mid2(same)
