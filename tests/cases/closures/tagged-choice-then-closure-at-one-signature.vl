// @run
// @log s
// @log s
// @log s
// @hint Intentionally-unused parameter `_a`
// @hint Intentionally-unused parameter `_a`
// A callee called with a tagged choice, then with a closure at the choice's signature, takes each
// at its own rep: the choice's instance keys by its members, a lone function's by its type (D17863).
function bo(_a) { return true }
function str(_a) { return "s" }
function ap(g, x) { return g(x) }
function flag() { return 1 > 0 }
const g = if flag() { str } else { bo }
print(ap(g, 3))
const w: (a: i32) => string | boolean = g
print(ap(w, 4))
function one(x: i32) { return if x > 0 { "s" } else { "t" } }
const lone = one
print(ap(lone, 1))
