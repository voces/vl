// @check
// @error cannot write 'one' to 'f': called at (string) it returns i32, where 'idg', also written to it, returns string
// D14722: a `let` of generics whose results disagree, called in a generic body at its type
// parameter, is refused at the write once an instance closes the call's argument types.
function idg<T>(t: T) { return t }
function one<T>(t: T) { return 1 }
function run<U>(x: U) {
  let f = idg
  if "ab".length < 5 { f = one }
  print(f(x))
}
run(5)
run("s")
