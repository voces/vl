// @run
// @log 6
// @log 4
// @log 6
// @hint Intentionally-unused variable `_a` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_b` (leading `_` marks it unused)
// A hole function stored beside a maker's called-and-returned lambda whose result at one of the
// maker's call signatures is another than the lambda's (`x * 2.0` at `i32`) does not fill the
// closure bundle there, so the family takes ids (D17736): each read calls its own member, at
// module scope and in a function.
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
function dbl(x) { return x * 2.0 }
const m = Map()
m["a"] = lap((a) => a + 1)
m["b"] = dbl
const h = m["b"]
if h != null { print(h(3)) }
const g = m["a"]
if g != null { print(g(3)) }
function body() {
  const hb = m["b"]
  if hb != null { print(hb(3)) }
}
body()
