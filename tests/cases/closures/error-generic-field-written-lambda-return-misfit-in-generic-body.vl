// @error a call through `r.f` returns string, and a function written there returns `i32` (the call's argument types)
// A record field written with a lambda is judged as a list element is (D12331).
function pick<A, B>(a: A, b: B): A { a }
const r = { f: pick }
r.f = (x: string, y: string) => 5
function g<T>(v: T): T { r.f(v, v) }
print(g("a"))
