// @run
// @log 4
// @log 4
// @log 5
// @log 6
// A record literal holding an un-annotated function, built where it is not bound and called
// through the field, builds its field as the closure its row codes (D15205).
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function mk() { return { f: inc0 } }
print({ f: inc0 }.f(3))
print(mk().f(3))
const r = mk()
print(r.f(4))
print({ f: dbl }.f(3))
