// @run
// @log 4
// @log 5
// A lambda whose RESULT is a bare captured struct. `capture-ref-types.vl` pins the captured
// struct being USED inside the body (`p.x`); this pins it being RETURNED, which is a different
// question — the closure's `$fnsig` result.
//
// `exprStruct` resolved an identifier through param / declared-local / global and never grew
// the capture arm its fourteen sibling classifiers have (`capturedKindOf`), so the lambda's
// result kind fell through to i32 while its body returned `(ref $S)`: two functypes for one
// function, which is invalid wasm.
//
// Classifying the kind alone was not enough, and the intermediate failure is the interesting
// part: `capturedStructIndex` still carried the `fnEnvIdxOf` guard that `capturedKindOf`'s own
// header explains it must not — `fnEnvIdx` is minted by `mAssignTypeIndices`, which runs AFTER
// every classification pass, so the guard blanks the answer for the whole of
// `computeRetInference`. With the kind classified and the SLOT still -1 the cell traded invalid
// wasm for `emitProgram: ref valtype with no interned shape`, a loud reject standing exactly
// where the guard was.
type S = { x: i32 }

function structResult(p: S) {
  const gs = () => p
  print(gs().x)
}

structResult({ x: 4 })

function nulStructResult(p: S | null) {
  if p != null {
    const gn = () => p
    print(gn().x)
  }
}

nulStructResult({ x: 5 })
