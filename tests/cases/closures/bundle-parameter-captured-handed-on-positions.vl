// A parameter called at two signatures, returned, and handed to a function that never calls it
// but whose closure captures it and hands it on: as an argument, a second argument, through a
// `const` copy, from a nested closure and from an `if` arm.
// @run
// @log 5
// @log 2.5
// @log 1
// @log 5
// @log 2.5
// @log 5
// @log 2.5
// @log 5
// @log 2.5
// @log 5
// @log 2.5
function lap(f) {
  f(2.5)
  f(3)
  return f
}
function take(b) {
  print(b(4))
  print(b(1.5))
}
function takeAfter(n: i32, b) {
  print(n)
  take(b)
}
function arg(a) {
  const k = () => take(a)
  k()
}
function second(a) {
  const k = () => takeAfter(1, a)
  k()
}
function copy(a) {
  const k = () => {
    const c = a
    take(c)
  }
  k()
}
function nested(a) {
  const k = () => {
    const k2 = () => take(a)
    k2()
  }
  k()
}
function arm(a, go: boolean) {
  const k = () => {
    if go { take(a) } else { print(0) }
  }
  k()
}
arg(lap((a) => a + 1))
second(lap((a) => a + 1))
copy(lap((a) => a + 1))
nested(lap((a) => a + 1))
arm(lap((a) => a + 1), true)
