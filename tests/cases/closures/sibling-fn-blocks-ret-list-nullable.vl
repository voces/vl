// @run
// @log 123null

// D2316 matrix — sibling function-scope blocks, closure return types list then a nullable
// (annotated) string.

function f() {
  let out = ""
  {
    const g = () => [1, 2, 3]
    const xs = g()
    out = "\{xs[0]}\{xs[1]}\{xs[2]}"
  }
  {
    const g: () => string | null = () => null
    const n = g()
    out = out + (n ?? "null")
  }
  out
}
print(f())
