// @run
// The keys walked inside a generic function (D17095).
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
const m = Map()
m["a"] = lap((a) => a + 1)
function walk<T>(x: T) {
  for k in m.keys() { print(k) }
  return x
}
print(walk(7))
// @log a
// @log 7
// @hint Intentionally-unused variable `_a`
// @hint Intentionally-unused variable `_b`
