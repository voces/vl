// @run
// @log 6
// @log ab
// @log 3
// @log 6
// @log 13
// D5842: an un-annotated lambda handed through an un-annotated parameter takes its parameter
// types from the function-typed parameter the callee's body hands it to: last or first, at two
// callers, through a const lambda, and capturing.
function two(a: i32, b: (n: i32) => i32) { b(a) }
function twoS(a: string, b: (s: string) => string) { b(a) }
function first(b: (n: f64) => f64, a: f64) { b(a) }
function apply(g, x, y) { return g(x, y) }
const lap = (g, x, y) => g(x, y)
const k = 10
print(apply(two, 3, (n) => n * 2))
print(apply(twoS, "a", (s) => s + "b"))
print(apply(first, (n) => n * 2, 1.5))
print(lap(two, 3, (n) => n * 2))
print(apply(two, 3, (n) => n + k))
