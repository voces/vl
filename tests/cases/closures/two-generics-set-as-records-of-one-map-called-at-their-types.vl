// @run
// @log 3
// @log t
// @log true
// @log 1
// @log s
// @log 1
// @log s
// @log 1
// @log s
// @log true
// @log 3
// @log t
// @log true
// @log 2
// @log 2.5
// Generics written by `.set` as record fields of one un-annotated map join the field's set, so
// each read calls its member at the call's types, beside an index store too, and one hole function set twice (D15533, D15339).
function id<T>(x: T): T { x }
function k2<T>(x: T): T { x }
function k3<T>(x: T): T { x }
const b = Map()
b.set("k", { f: id })
b.set("j", { f: k2 })
const bj = b.get("j")
if bj != null {
  print(bj.f(3))
  print(bj.f("t"))
}
const bk = b.get("k")
if bk != null { print(bk.f(true)) }
const c = Map()
c.set("k", { f: id })
c.set("j", { f: k2 })
c.set("m", { f: k3 })
for key in ["k", "j", "m"] {
  const r = c.get(key)
  if r != null {
    print(r.f(1))
    print(r.f("s"))
  }
}
print(c.has("j"))
const d = Map()
d["k"] = { f: id }
d.set("j", { f: k2 })
const dj = d.get("j")
if dj != null {
  print(dj.f(3))
  print(dj.f("t"))
}
const dk = d["k"]
if dk != null { print(dk.f(true)) }
function id1(a) { return a }
const e = Map()
e.set("a", { f: id1 })
e.set("b", { f: id1 })
const ea = e.get("a")
if ea != null { print(ea.f(2)) }
const eb = e.get("b")
if eb != null { print(eb.f(2.5)) }
