// @log O
// @log 1
// @log I
// @log s
// @log O
// @log s
// A `let` holding a generic function that a closure writes lives in a capture cell; the cell's
// seed and each write naming a generic are instanced at the type the cell is delivered or called
// at, one cell per binding (D3939).
function ci(f: (n: i32) => void, n: i32) { f(n) }
function cs(f: (s: string) => void, s: string) { f(s) }
function inner<U>(u: U) {
  print("I")
  print(u)
}
function other<V>(v: V) {
  print("O")
  print(v)
}
function inner2<W>(w: W) {
  print("I")
  print(w)
}
function inner3<X>(x: X) {
  print("I")
  print(x)
}
function q(n: i32) {
  print("Q")
  print(n)
}
function qs(s: string) {
  print("QS")
  print(s)
}
function delivered() {
  let a = inner
  let b = inner
  const fa = () => {
    a = q
  }
  const fb = () => {
    b = qs
  }
  ci(a, 1)
  cs(b, "s")
  fa()
  fb()
  ci(a, 2)
  cs(b, "t")
}
delivered()
function calledInClosure() {
  let k = inner2
  const flip = () => {
    k = other
  }
  const rd = () => {
    k(5)
  }
  rd()
  flip()
  rd()
}
calledInClosure()
function calledDirectly() {
  let k = inner3
  const flip = () => {
    k = qs
  }
  k("a")
  flip()
  k("b")
}
calledDirectly()
function mk(): (n: i32) => void {
  let k = other
  const flip = () => {
    k = q
  }
  flip()
  return k
}
mk()(4)
function run<T>(x: T) {
  let k = inner3
  const flip = () => {
    k = other
  }
  k(x)
  flip()
  k(x)
}
run(1)
run("s")
