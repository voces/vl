// @run
// @log 2
// @log 2.5
// @log 3
// @log 3.5
// @log a
// A record a maker returns through another maker's call, its function field written with
// another generic and called at two types, holds the widened set the one-level maker's does
// (D15742).
function id0(a) { return a }
function id1(a) { return a }
function mk() { return { f: id1 } }
function mk2() { return mk() }
const r = mk2()
r.f = id0
print(r.f(2))
print(r.f(2.5))

function k0(a) { return a }
function k1(a) { return a }
function nk() { return { g: k1 } }
function nk2() { return nk() }
function nk3() { return nk2() }
const q = nk3()
q.g = k0
const h = q.g
print(h(3))
print(h(3.5))
print(h("a"))
