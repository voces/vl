// @run
// @log 6
// @log 2
// @log 3
// @log 2
// @log 4
// @log 5
// @log 6
// @log 7
// @log 8
// @log s9
// @log 10
// @log 13
import { toString } from "std:fmt"

// A hole function handed to a hole parameter is a tagged set's member, written as its id there; the
// same name read where a closure is owed is that closure. Q58 sweep of the closure read: a closure
// argument, a union argument, a nested argument, a return, a binding, an `if` arm, a `??` operand
// and a record field; a closure has no concat or interpolation position, its call's result does.
function inc(a) { return a + 1 }
function boxed(h) { return { v: h(5) } }
function take(h: (n: i32) => i32) { return h(1) }
function takeU(h: ((n: i32) => i32) | null) {
  return if h == null { -1 } else { h(2) }
}
function pass(h: (n: i32) => i32): (n: i32) => i32 { return h }
function ret(): (n: i32) => i32 { return inc }
function pArg() { print(take(inc)) }
function pUnion() { print(takeU(inc)) }
function pNested() { print(take(pass(inc))) }
function pRet() { print(ret()(3)) }
function pLet() {
  const b: (n: i32) => i32 = inc
  print(b(4))
}
function pIf(c: boolean) {
  const f: (n: i32) => i32 = if c { inc } else { (n: i32) => n }
  print(f(5))
}
function pCoal(c: boolean) {
  const o: ((n: i32) => i32) | null = if c { null } else { inc }
  const g = o ?? inc
  print(g(6))
}
function pField() {
  const r: { h: (n: i32) => i32 } = { h: inc }
  print(r.h(7))
  print("s" + toString(r.h(8)))
  print("\{r.h(9)}")
}
print(boxed(inc).v)
pArg()
pUnion()
pNested()
pRet()
pLet()
pIf(true)
pCoal(true)
pField()
const top: (n: i32) => i32 = inc
print(take(inc) + top(10))
