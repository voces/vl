// @run
// @info `lv` is never reassigned; use `const` instead of `let`
// @log a!
// @log 22
// Two `let`s of one name in sibling blocks each hold only what their own block writes to them:
// the string functions written to the first do not reach the second's `inc`.
function ask(s) { return s + "?" }
function exclaim(s) { return s + "!" }
function inc(n) { return n + 1 }
const on = [1].length == 1
const w = if on {
  let lv = ask
  lv = exclaim
  lv
} else {
  ask
}
print(w("a"))
const n = if on {
  let lv = inc
  lv
} else {
  inc
}
print(n(21))
