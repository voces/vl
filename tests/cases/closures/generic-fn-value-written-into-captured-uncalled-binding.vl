// @run
// @log I
// @log I
// @log ok
// @log ok
// @log ok
// @log 1
// @log ok
// @log ok
// A generic function written into a binding nothing calls, from a frame that captures it: a
// lambda, its result the write or not, and a nested function. The value reaches no call (D3970).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function viaTail() {
  let k = inner
  const flip = () => {
    k = other
  }
  flip()
  print("ok")
}
function viaReturn() {
  let k = inner
  const flip = () => {
    return k = other
  }
  flip()
  print("ok")
}
function viaExpr() {
  let k = inner
  const flip = () => k = other
  flip()
  print("ok")
}
function viaStatement() {
  let k = inner
  const flip = () => {
    k = other
    return 1
  }
  print(flip())
  print("ok")
}
function viaNested() {
  let k = inner
  function flip() { k = other }
  flip()
  print("ok")
}
inner("I")
viaTail()
viaReturn()
viaExpr()
viaStatement()
viaNested()
