// A maker's result delivered at a destination it only converts to (a string-literal union
// result returned as `string`) is the maker built returning that destination, beside one at
// another destination, in each pairing (D9282).
type K = "x" | "y"
function same<T>(k: T): T { k }
function d1() { return same }
const a1: (k: K) => string = d1()
const b1: (k: string) => string = d1()
print(a1("x"))
print(b1("q"))
function d2() { return same }
const a2: (k: K) => string = d2()
const b2: (k: K) => K = d2()
print(a2("x"))
print(b2("y"))
function d3() { return same }
const a3: (k: K) => K = d3()
const b3: (k: string) => string = d3()
print(a3("x"))
print(b3("q"))
function d4() { return same }
const a4: (k: K) => string = d4()
const b4: (k: K) => string = d4()
print(a4("x"))
print(b4("y"))
