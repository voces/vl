// A lambda that calls a capturing nested function carries that function's captures in its own
// environment without reading them. Q58 sweep of the carried capture, read in the nested function
// at a scalar and a union argument, a nested argument, a concat operand, an interpolation hole, a
// return, a binding, an `if` arm, a `??` operand and a record field; the lambda is called where it
// stands, bound, passed and returned, in a module block and in a function.
function takeS(s: string) { return s.length }
function takeU(p: i32 | string) {
  return if p is string { p.length } else { p }
}
function id<T>(t: T): T { return t }
function run(f: () => string) { return f() }
const tt = [1].length == 1
if tt {
  const s = "loc"
  function k() {
    print(takeS(s))
    print(takeU(s))
    print(takeS(id(s)))
    print(s + "!")
    print("\{s}?")
    const v: string = s
    print(v)
    print(if tt { s } else { "no" })
    const n: string | null = if tt { s } else { null }
    print(n ?? "z")
    const r = { s: s }
    return r.s
  }
  print((() => k())())
  const g = () => k()
  print(g())
  print(run(() => k()))
}
function outer(t: string) {
  const s = t + "o"
  function k() { return s + "k" }
  const g = () => k()
  print(g())
  return () => k()
}
print(outer("x")())
