// @run
// @log 2
// @log 101
// @log 8
// @log 9
// @log 10
// @log true
// A function LITERAL underneath a cast or a type test. `liftFnsInExpr` walks fifteen node
// kinds and had no `AsExpr` arm, so a lambda under `as` was never pushed to `fnStmts` and
// `fnStmtsPosOf` answered -1 at emit — `function literal not lifted`, on a `vl check`-clean
// file, while deleting the cast made the identical call run (D1085).
//
// `IsExpr` is the SECOND unwalked kind and carries the same message; it was found by
// sweeping the node union rather than the row, which named only the cast.
//
// `MatchExpr` needs NO arm and that is measured, not assumed: `match` desugars into
// `IfStmt`/`Block`, which this walk already enters, and a lambda in a match SCRUTINEE and in
// a match ARM both run. `OptMember` cannot hold one either — a `?.` receiver must be
// re-readable (a name, or a chain of names), so no compilable program puts a call there.
type Circle = { r: i32 }
type Square = { s: i32 }
type Shape = Circle | Square

function pick(f: (i32) => i32) { return f(1) }
function pickShape(f: (i32) => Shape) { return f(1) }

const castedBinding = pick((n: i32) => {
  return n + 1
}) as f64

function castedIndex() {
  const xs = [1, 2]
  return xs[pick((n: i32) => {
    return n - 1
  }) as i32] +
    100
}

function castedField() {
  const holder = {
    v: pick((n: i32) => {
      return n + 7
    }) as i32,
  }
  return holder.v
}

function castedReturn() {
  return pick((n: i32) => {
    return n + 8
  }) as f64
}

function castedAssign() {
  let acc = 0
  acc = pick((n: i32) => {
    return n + 9
  }) as i32
  return acc
}

function tested() {
  return pickShape((n: i32) => {
    const c = { r: n }
    return c
  }) is Circle
}

print(castedBinding)
print(castedIndex())
print(castedField())
print(castedReturn())
print(castedAssign())
print(tested())
