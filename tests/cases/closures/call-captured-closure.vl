// @run
// @log 11
// @log 22
// @log 33
// @log 44
// @log 55
// @log 66
// @log 77
// @log 88
// @log 99
// @log 111
// @log 122
// @log 133
// @log 144
// @log 155
// @log 166
// @log 177
// @log 1007
// @log ok!
// @log 177.5

// @hint redundant type annotation: `inner` is inferred as `(i32) => i32`

// D1608 — calling a function value that reached this frame as a CAPTURE. Every block adds a
// DIFFERENT constant, so a call that reached another block's closure, or the right closure
// with the wrong env, prints a wrong number rather than passing. `emitCall`'s identifier-
// callee ladder asks `identIsBoundClosure`, whose capture rung this row built.

// The second half of the file is the RUNNING neighbours, kept as controls because a capture
// rung placed above the local rungs would take them: the uncaptured call, the captured value
// passed as an argument, the captured struct's closure field, a module global read inside the
// lambda, a local declared inside the lambda, and a same-named local that must shadow.

// The witness: a lambda captures a lambda and calls it.
function witness() {
  const inner = (n: i32) => n + 1
  const outer = (n: i32) => inner(n)
  print(outer(10))
}

witness()

// The captured value is a function-typed local bound to a NAMED function.
function add2(n: i32) { return n + 2 }

function namedAnnotated() {
  const inner: (i32) => i32 = add2
  const outer = (n: i32) => inner(n)
  print(outer(20))
}

namedAnnotated()

// The same with the local un-annotated: inference pins the cell, not an annotation.
function add3(n: i32) { return n + 3 }

function namedInferred() {
  const inner = add3
  const outer = (n: i32) => inner(n)
  print(outer(30))
}

namedInferred()

// The captured value arrives as a PARAMETER of the enclosing frame.
function paramCapture(inner: (i32) => i32) {
  const outer = (n: i32) => inner(n)
  print(outer(40))
}

paramCapture((n: i32) => n + 4)

// Rebound to a fresh local INSIDE the lambda: the taint follows the value, not the spelling,
// so the rebind must resolve the same way the capture does.
function rebound() {
  const inner = (n: i32) => n + 5
  const outer = (n: i32) => {
    const g = inner
    return g(n)
  }
  print(outer(50))
}

rebound()

// A capture crossing TWO lambda frames — the value flows env-to-env down the nesting.
function twoFrames() {
  const inner = (n: i32) => n + 6
  const mid = (n: i32) => {
    const deep = (m: i32) => inner(m)
    return deep(n)
  }
  print(mid(60))
}

twoFrames()

// A closure captured by a closure that is itself captured: three frames, one env chain.
function captureOfCaptured() {
  const base = (n: i32) => n + 7
  const wrap = (n: i32) => base(n)
  const outer = (n: i32) => wrap(n)
  print(outer(70))
}

captureOfCaptured()

// The lambda's own parameter un-annotated, so inference reaches through the argument
// boundary while the capture is still what the body calls.
function apply8(f: (i32) => i32) { return f(80) }

function unannotatedFace() {
  const inner = (n: i32) => n + 8
  print(apply8((n) => inner(n)))
}

unannotatedFace()

// A NULLABLE captured closure, narrowed then called — the kind-19 niche, whose null TEST
// already had the capture rung while the CALL did not.
function nullableCapture() {
  const inner: ((i32) => i32) | null = (n: i32) => n + 9
  const outer = (n: i32) => {
    if inner != null { return inner(n) }
    return 0
  }
  print(outer(90))
}

nullableCapture()

// Called twice in one expression: the env is re-read per call, not cached across them.
function calledTwice() {
  const inner = (n: i32) => n + 55
  const outer = (n: i32) => inner(inner(n))
  print(outer(1))
}

calledTwice()

// ── the neighbours that already ran, kept as controls ────────────────────────

// The same local called in its OWN frame, uncaptured.
function ownFrame() {
  const inner = (n: i32) => n + 2
  print(inner(120))
}

ownFrame()

// The capture READ and passed as an argument, never called through the capture.
function applyIt(f: (i32) => i32, n: i32) { return f(n) }

function passedAsArgument() {
  const inner = (n: i32) => n + 3
  const outer = (n: i32) => applyIt(inner, n)
  print(outer(130))
}

passedAsArgument()

// A captured STRUCT whose closure FIELD is called.
function structField() {
  const b = { op: (n: i32) => n + 4 }
  const outer = (n: i32) => b.op(n)
  print(outer(140))
}

structField()

// A module GLOBAL closure read inside the lambda: `capRecord` deliberately does not record a
// global as a capture, so this must keep taking the global path.
const globalAdd5 = (n: i32) => n + 5

function moduleGlobal() {
  const outer = (n: i32) => globalAdd5(n)
  print(outer(150))
}

moduleGlobal()

// A closure-valued local declared INSIDE the lambda.
function insideLambda() {
  const outer = (n: i32) => {
    const inner = (m: i32) => m + 6
    return inner(n)
  }
  print(outer(160))
}

insideLambda()

// A same-named non-closure local inside the lambda SHADOWS the capture, so the local wins and
// that lambda stays arithmetic — while a sibling lambda with no such local still calls it.
function shadowed() {
  const inner = (n: i32) => n + 1000
  const outer = (n: i32) => {
    const inner = 7
    return n + inner
  }
  const sibling = (n: i32) => inner(n)
  print(outer(170))
  print(sibling(7))
}

shadowed()

// A captured closure over a non-i32 signature: the `$fnsig` key resolves off the capture, not
// off an all-i32 arity fallback.
function stringSignature() {
  const inner = (s: string) => s + "!"
  const outer = (s: string) => inner(s)
  print(outer("ok"))
}

stringSignature()

// An f64 result through `call_ref` — the wide-scalar half of the same key.
function f64Signature() {
  const inner = (n: f64) => n + 0.5
  const outer = (n: f64) => inner(n)
  print(outer(177.0))
}

f64Signature()
