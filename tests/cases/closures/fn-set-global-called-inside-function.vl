// @run
// @log 6
// @log 5
// A module binding of a function set dispatches the same inside a function as at top level.
function inc(a) { return a + 1 }
function dbl(a) { return a * 2 }
function sel(c: boolean) {
  if c { return inc }
  return dbl
}
const g = sel(false)
function use(x: i32) { return g(x) }
print(use(3))
print(g(2.5))
