// @run
// @hint redundant type annotation: `inc` is inferred as `i32`
// @hint redundant type annotation: `run` is inferred as `i32`
// @log 2
// @log s
// @log 5
// @log 2
// @log s
// @log 3
// @log 2
// @log s
// @log 4
// @log 2
// @log s
// @log 9
// @log 2
// @log s
// @log 5
// @log 1
// A list holding a generic, copied by `slice`, and the source called through at two types
// (D10082). The copy is called at one type, grown by a push, handed to a typed parameter, or
// looped over.
function id<T>(x: T): T { x }
function same<T>(x: T): T { x }
function inc(x: i32): i32 { x + 1 }
function run(fs: ((x: i32) => i32)[]): i32 { fs[0](4) }

const xs = [id]
const ys = xs.slice(0)
print(xs[0](2))
print(xs[0]("s"))
print(ys[0](5))

const as = [id]
const bs = as.slice(0)
bs.push(inc)
print(as[0](2))
print(as[0]("s"))
print(bs[1](2))

const cs = [id]
const ds = cs.slice(0)
print(cs[0](2))
print(cs[0]("s"))
print(run(ds))

function main() {
  const es = [id]
  const n = 0
  const fs = es.slice(n, 1)
  print(es[0](2))
  print(es[0]("s"))
  for f in fs { print(f(9)) }
}
main()

const gs = [id, same]
const hs = gs.slice(1)
print(gs[0](2))
print(gs[1]("s"))
print(hs[0](5))
print(hs.length)
