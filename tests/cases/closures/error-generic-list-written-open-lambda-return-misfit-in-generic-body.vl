// @error a call through `fs[_]` returns string, and a function written there returns `i32` (the call's argument types)
// The un-annotated spelling: a lambda with an open parameter is judged at the instance too.
function pick<A, B>(a: A, b: B): A { a }
const fs = [pick]
fs[0] = (x, y: string) => 5
function g<T>(v: T): T { fs[0](v, v) }
print(g("a"))
