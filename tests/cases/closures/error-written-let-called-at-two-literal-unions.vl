// @emit-error holds functions called at more than one argument type
// Two string literal unions number their members apart, so one instance cannot take both tags
// (D4244).
function gB<V>(v: V) {
  print("B")
  print(v)
}
type S = "p" | "q"
type R = "p" | "r"
const a: S = "q"
const b: R = "r"
let x = gB
x = gB
x(b)
x(a)
