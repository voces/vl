// A lambda called at two signatures through a parameter that hands it on whole to another hole
// parameter: every parameter on the way holds the one record of its closures.
function other(g) {
  print(g(7))
  print(g(1.5))
}
function only(f) { other(f) }
function both(f) {
  print(f(3))
  print(f(2.5))
  once(f)
}
function once(g) { print(g(7)) }
function deep(h) {
  print(h(7))
  print(h(0.5))
}
function mid(g) { deep(g) }
function hop(f) {
  print(f(3))
  mid(f)
}
function a(f, n: i32) {
  print(f(n))
  if n > 0 { b(f, n - 1) }
}
function b(g, n: i32) {
  print(g(n + 0.5))
  if n > 0 { a(g, n - 1) }
}
function go(k: i32) {
  only((x) => x + k)
  both((x) => x + k)
  hop((x) => x + k)
}
go(1)
function twice(k: i32) {
  only((x) => x + k)
  only((x) => x * k)
}
twice(2)
function cycle(k: i32) { a((x) => x + k, 3) }
cycle(1)
