// @run
// @log 2
// @log 2.5
// @warning Unused parameter `x`
// A hole function's nested function, read from a list past index 0, returns the capture at each
// instance's pin: a call through a list is typed by its element only for module-scope functions.
function o(n) {
  function k(x: i32) { return n }
  const fs = [k, k]
  return fs[1](1)
}
print(o(2))
print(o(2.5))
