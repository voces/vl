// @run
// @info `q` is never reassigned; use `const` instead of `let`
// @log 1.5
// @log 1.5
// @log 4
// @log 1.5
// @log 1.5
// @log 4
// @log 6
// @log 2.5
// @log 1.5
// @log 1.5
// A record literal's list field of functions written, or pushed, a function of another result
// type: the writes join the field's element set, so a call through the field's element, an
// alias of the field or a copy of the record runs the written function (D15138).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function inner() {
  const r = { xs: [inc0] }
  r.xs[0] = half
  return r.xs[0](3)
}
const r = { xs: [inc0], n: 4 }
r.xs[0] = half
print(r.xs[0](3))
const p = { xs: [inc0] }
p.xs.push(half)
print(p.xs[1](3))
print(p.xs[0](3))
let q = { xs: [inc0] }
q.xs[0] = half
print(q.xs[0](3))
const ys = r.xs
print(ys[0](3))
print(r.n)
const t = { xs: [inc0, inc0] }
t.xs[1] = half
for f in t.xs { print(f(5)) }
const c = r
print(c.xs[0](3))
print(inner())
