// @log x
// @log 4
// An alias of a generic returned bare is instanced at the call past the return, as the name is
// (D5400); a call returning a generic hands an un-annotated parameter the generic (D5401); a
// generic forwarded from one un-annotated parameter to another takes the instance the last
// body's call fixes (D5402).
function k<T>(x: T): T { return x }
function mka() { const g = k; return g }
function mkc() {
  const g = k
  const j = g
  return j
}
function mkd() { const g = k; return g }
function mk() { return k }
function apply(f: (x: i32) => i32) { print(f(6)) }
function take(a) { print(a("x")) }
function takeN(a) { print(a(4)) }
function mid(a) { take(a) }
function both(a) { print(a("y")); take(a) }
function hop2(a) { mid(a) }
function midN(a) { takeN(a) }
const top = mkd()
function main() {
  const h = mka()
  print(h(1))
  apply(mka())
  print(mkc()(2))
  print(top("z"))
  const m = mk()
  takeN(m)
  takeN(mk())
  mid(k)
  hop2(k)
  both(k)
  const al = k
  midN(al)
}
main()
