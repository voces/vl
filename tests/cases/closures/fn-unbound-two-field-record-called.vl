// @run
// @log 4
// @log 4
// @log 4
// @log 4
// @log 9
// A record literal of an un-annotated function beside another field, called through the function
// field without being bound, builds the function at the field's type in the record the literal is
// built at (D15206).
function inc0(a) { return a + 1 }
print({ f: inc0, n: 1 }.f(3))
print({ n: 1, f: inc0 }.f(3))
print({ f: inc0, n: "s" }.f(3))
const r = { f: inc0, n: 1 }.f(3)
print(r)
print({ f: inc0, n: 1 }.f(4) + { f: inc0, n: 1 }.f(3))
