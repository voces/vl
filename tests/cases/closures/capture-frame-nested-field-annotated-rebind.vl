// @run
// @log 10
// @log 10

// @hint redundant type annotation: `c` is inferred as `Inner`

// D1635 — a code-15 nested-struct field read is stored `(ref null $Inner)`, so the local
// takes the nullable niche while the annotation names the bare struct. `captureValKind`
// defers to `letInitCellKind` only when that ladder answers the niche, and it could not:
// the receiver is a frame `let` whose nullable-VARIANT row no Ident arm resolved from
// outside the frame, so the field read classified as code -1 and the env field was declared
// non-null over a nullable value.

// The union declaration is load-bearing — it is what gives `S` a variant row and no struct
// row — and the module-scope twin runs, which is what makes the frame the axis.

type Inner = { p: i32 }

type S = { i: Inner, n: i32 }

type Other = { o: string }

type U = S | Other

function g(n: i32): S | null {
  if n == 0 { return { i: { p: 5 }, n: 1 } }

  null
}

function annotatedRebind() {
  const src = g(0)

  if src != null {
    const c: Inner = src.i
    const f = () => {
      const v = c
      print(v.p * 2)
    }
    f()
  }
}

annotatedRebind()

// The un-annotated face, which ran before the fix and must keep running: the kind and its
// row move together, so a fix that gives one without the other is `ref valtype with no
// interned shape` here.
function inferredRebind() {
  const src = g(0)

  if src != null {
    const c = src.i
    const f = () => {
      const v = c
      print(v.p * 2)
    }
    f()
  }
}

inferredRebind()
