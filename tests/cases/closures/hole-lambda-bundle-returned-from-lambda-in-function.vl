// @run
// @log 5
// @log 2.5
// @log 5
// @log 2.5
// @log 5
// @log 2.5
// @log 5
// @log 2.5
// @log 6
// A lambda bound to a `const` inside a function, returning a hole lambda's bundle, is followed as
// a named function is: its result held, handed on, called directly, and returning a captured or
// module holder (D15744).
function lap(f) {
  f(2.5)
  f(3)
  return f
}
function take(b) {
  print(b(4))
  print(b(1.5))
}
const c = lap((a) => a + 1)
function main(n: i32) {
  const g = () => lap((a) => a + n)
  const w = g()
  print(w(4))
  print(w(1.5))
  const h = () => {
    return lap((a) => a + 1)
  }
  take(h())
  const k = lap((a) => a + 1)
  const r = () => k
  take(r())
  const m = () => c
  const u = m()
  print(u(4))
  print(u(1.5))
  const d = () => lap((a) => a * 2)
  print(d()(3))
}
main(1)
