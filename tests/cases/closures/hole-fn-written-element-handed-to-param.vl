// @run
// @log 1.5
// A list element written with a function of another result, handed to an un-annotated parameter
// the callee calls, holds the written function: the element's set joins it (D9090, D14648).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function apply(f, v) { return f(v) }
const xs = [inc0]
xs[0] = half
print(apply(xs[0], 3))
