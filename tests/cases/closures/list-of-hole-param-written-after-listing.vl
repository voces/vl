// @run
// @log ab
// @log 7
// @log abab
// @log 14
// A hole parameter the body writes holds its hand or what is written: the instance binds it at
// their join, and a list literal of it built before the write holds the hand (D15011).
function id<T>(x: T): T { x }
function dbl<T>(x: T): T { x + x }
function take(a) {
  const xs = [a]
  a = dbl
  print(xs[0]("ab"))
  print(xs[0](7))
}
function later(a) {
  a = dbl
  const xs = [a]
  print(xs[0]("ab"))
  print(xs[0](7))
}
take(id)
later(id)
