// @run
// @log 3.5
// @log 4.5
// @log 0
// A parameter called at two signatures in a function that also has a bare `return`: the
// return hands back nothing, so it is no read of the parameter.
function lap(f) {
  print(f(2.5))
  if f(3) > 0 { return }
  print(0)
}
function lapAll(f) {
  print(f(3.5))
  if f(-9) > 0 { return }
  print(0)
}
function go(k: i32) {
  lap((a) => a + k)
  lapAll((a) => a + k)
}
go(1)
