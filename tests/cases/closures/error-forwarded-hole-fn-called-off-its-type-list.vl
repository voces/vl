// @error operator '+' is not defined for f64 and string
// The same through list elements, one of which calls the forwarded function off its type
// (D13201).
function add(a, b) { return a + b }
function apply2(g, s) { print(g(s, s)) }
function apply3(g, s) {
  print(g(10, 20))
  print(g(s, "x"))
}
function inner(k, h) {
  for f in [apply2, apply3] { f(h, k) }
}
inner(0.5, add)
