// @run
// @log ss
// @log 2
// @log 80
// @log 6
// @log 40
// @log 10
// An inferred list of a function set copied into a list of a closed function type: a spread into
// a push, a readonly binding, argument and return. Each element passes through its adapter
// (D15069).
function id<T>(x: T): T { return x }
function dbl<T>(x: T): T { return x + x }
function first(xs: readonly ((x: i32) => i32)[]) { return xs[0](20) }
function asView(
  xs: readonly ((x: i32) => i32)[],
): readonly ((x: i32) => i32)[] {
  return xs
}
let f = id
f = dbl
print(f("s"))
print(f(1))
const zs = [f]
const ys: ((x: i32) => i32)[] = []
ys.push(...zs)
print(ys[0](40))
const view: readonly ((x: i32) => i32)[] = zs
print(view[0](3))
print(first(zs))
print(asView(zs)[0](5))
