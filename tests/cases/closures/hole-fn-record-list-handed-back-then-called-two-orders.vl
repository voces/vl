// @hint Intentionally-unused variable `_r` (leading `_` marks it unused)
// @run
// @log 4
// @log 1.5
// A record holding a list of two functions with different results, handed to a parameter that
// hands it back, then read and called through another un-annotated parameter in both orders.
function inc(a) { return a + 1 }
function half(a) { return a / 2.0 }
function id(x) { return x }
const _r = id({ l: [inc, half] })
function app(o) { return o.l[0](3) }
print(app({ l: [inc, half] }))
print(app({ l: [half, inc] }))
