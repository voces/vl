// @run
// @log 6
// @log 3.5
// @log 8
// A re-pointed `let` a function returns, whose functions agree at each call's types, runs the
// one it holds: handed to a callee at two types, and called directly.
function inc(a) { return a + 1 }
function dbl(a) { return a * 2 }
function sel(c: boolean) {
  let f = inc
  if c { f = dbl }
  return f
}
function ap(f, x) { return f(x) }
print(ap(sel(true), 3))
print(ap(sel(false), 2.5))
print(sel(true)(4))
