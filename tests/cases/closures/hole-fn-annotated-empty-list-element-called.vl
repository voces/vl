// @run
// @log 0
// @log 0
// An annotated empty list handed to an un-annotated parameter whose element is called runs:
// the annotation names the element's result (D9281).
function early(a) {
  if a.length == 0 { return 0 }
  return a[0](4)
}
const e: ((x: i32) => i32)[] = []
print(early(e))
function count(a) { return a.map((f) => f(4)).length }
print(count(e))
