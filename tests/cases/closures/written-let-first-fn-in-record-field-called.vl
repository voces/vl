// @run
// @log 3
// A record field holding a written `let`'s first function, called through the field, takes the
// type that call gives it (D6885).
function apply3(g) { print(g(1, 2)) }
function apply4(g) { print(g(3, 4)) }
function add(a: i32, b: i32) { a + b }
let h = apply3
const r = { f: h }
h = apply4
r.f(add)
