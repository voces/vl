// @run
// @log 6
// @log 4
// @log 4
// @log 6
// @log 4
// @log 10
// @log 4
// A function-local `const` bound to an element of a list of lambdas whose set a second list tags,
// called: at a constant or a variable index, as a statement and for its value.
function main() {
  const f = (a) => a + 1
  const d = (a) => a * 2
  const two = [f, d]
  const s = two[1]
  print(s(3))
  const r = two[0]
  print(r(3))
  const m = [f]
  print(m[0](3))
}
main()
function vary() {
  const f = (a) => a + 1
  const d = (a) => a * 2
  const two = [f, d]
  let i = 0
  i = 1
  const s = two[i]
  print(s(3))
  const m = [f]
  print(m[0](3))
}
vary()
function stmt() {
  const f = (a) => a + 1
  const d = (a) => a * 2
  const two = [f, d]
  const s = two[1]
  s(3)
  print(s(5))
  const m = [f]
  print(m[0](3))
}
stmt()
