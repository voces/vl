// @emit-error a list holding a generic function is called through its elements at more than one type
// A list of generic functions called through one element at `i32` and at `boolean`, which share
// a representation, has no one element type, so it is refused (D3977).
function inner<U>(u: U) {
  print("I")
  print(u)
}
function main() {
  const fs = [inner]
  fs[0](1)
  fs[0](true)
}
main()
