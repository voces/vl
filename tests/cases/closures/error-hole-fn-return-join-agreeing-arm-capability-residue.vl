// @error cannot choose 'str' here: called at (i32) it returns string, where 'inc', also chosen here, returns i32
// Capability residue, not a design rule: this call reaches `inc` and should print 4, as
// `sel(false)(3)` should print "s". Both are refused until a call through a join of functions
// dispatches on the member it holds (D13965). When that lands this fixture becomes a @run.
function inc(a) { return a + 1 }
function str(_a) { return "s" }
function sel(c: boolean) {
  if c { return inc }
  return str
}
print(sel(true)(3))
