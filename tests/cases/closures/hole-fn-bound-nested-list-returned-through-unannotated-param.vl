// @run
// @log 6
// @log 6
// @log 2.5
// @log 4
// @hint Intentionally-unused parameter `_n` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_n` (leading `_` marks it unused)

// A list of lists of two un-annotated functions, bound and returned from a function with an
// un-annotated parameter, is built in that function's instance at the rep the checker stamped on
// the literals it copies, the inner lists of the set's ids included (D16712).
function inc(a) { return a + 1 }
function dbl(a) { return a * 2 }
function give(_n) {
  const w = [[inc], [dbl]]
  return w
}
function give2(_n) {
  const w = [[inc], [dbl]]
  return w
}
print(give(1)[1][0](3))
print(give2(1)[1][0](3))
print(give2("s")[1][0](1.25))
print(give(true)[0][0](3))
