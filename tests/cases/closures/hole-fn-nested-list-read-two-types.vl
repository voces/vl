// @run
// @log 4
// @log 3.5
// @log 6
// @log 2.5
// @log 1.5
// @log 4
// @log 3.5
// A bound nested list of an un-annotated function, its element called at two types, runs at the
// top level, inside a function, and with two functions in a row read at f64 (D9711). The last
// case, the flat list at two types, is a control that ran before.
function inc0(a) { return a + 1 }
const u0 = [[inc0]]
print(u0[0][0](3))
print(u0[0][0](2.5))

function inc1(a) { return a + 1 }
function dbl1(a) { return a * 2 }
function go1() {
  const u = [[inc1, dbl1], [inc1]]
  print(u[0][1](3))
  print(u[0][1](1.25))
  print(u[1][0](0.5))
}
go1()

function inc2(a) { return a + 1 }
const u2 = [inc2]
print(u2[0](3))
print(u2[0](2.5))
