// @run
// @log 7
// @log 8
// A closure over a guard-narrowed `i32` list cell returns the narrowed `i32`, whether its call
// result is printed directly or bound first (D3472).
function f() {
  const g: (i32 | null)[] = [7]
  if g[0] != null {
    const h = () => g[0] ?? -1
    print(h())
    const r = h()
    print(r + 1)
  }
}
f()
