// @run
// @log 3
// @log 4
// @log 6
// @log none
// A captured, reassigned nullable closure narrowed non-null, delivered to a non-null closure slot:
// passed, bound, and passed after a reassignment. Each holds the closure, recovered.
function apply(g: (n: i32) => i32, v: i32) { return g(v) }
function main() {
  let k: ((n: i32) => i32) | null = (n: i32) => n + 1
  const clear = () => {
    k = null
  }
  const set = () => {
    k = (n: i32) => n * 2
  }
  if k != null { print(apply(k, 2)) }
  if k != null {
    const h = k
    print(h(3))
  }
  set()
  if k != null { print(apply(k, 3)) }
  clear()
  if k != null { print(apply(k, 1)) } else { print("none") }
}
main()
