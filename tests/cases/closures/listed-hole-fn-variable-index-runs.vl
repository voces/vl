// @run
// @log 5
// @info `i` is never reassigned; use `const` instead of `let`
// A list of a hole parameter called at two types through a variable index runs: the list holds
// the parameter's tagged set, and each call dispatches through it (D12450).
function id<T>(x: T): T { x }
function take(a) {
  const xs = [a]
  let i = 0
  print(xs[i]("abc").length + xs[i](2))
}
take(id)
