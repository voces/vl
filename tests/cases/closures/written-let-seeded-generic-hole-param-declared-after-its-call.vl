// @run
// @log 7
// @log s
// A `let` seeded with a generic and written an un-annotated parameter takes the set's id from every
// call of the function, so a call above the declaration leaves the body to after it (D15053).
take(tw)
function id<T>(x: T): T { return x }
function tw<T>(x: T): T { return x }
function take(a) {
  let b = id
  b = a
  print(b(7))
  print(b("s"))
}
