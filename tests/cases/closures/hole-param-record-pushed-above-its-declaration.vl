// @run
// @log 1.5
// @log 0.5
// @log 0.5
// @log 0
// @log 2.5
// A call above an un-annotated function that writes an element into its parameter sees the body
// checked first, so the body's record shares the call's list fields as below the declaration
// (D16426, D16424). One function per position: a literal, a bound list written after, the field
// pushed in the body, a bare `[]`, and the call inside a function declared before.
pushOnly([{ ys: [1.5] }])
const l = [{ ys: [] }]
pushBound(l)
l[0].ys.push(0.5)
print(l[0].ys[0])
pushThenWrite([{ ys: [] }])
pushIntoEmpty([])
function main() { pushInMain([{ ys: [2.5] }]) }
main()
function pushOnly(a) {
  a.push({ ys: [] })
  print(a[0].ys[0])
}
function pushBound(a) { a.push({ ys: [] }) }
function pushThenWrite(a) {
  a.push({ ys: [] })
  a[0].ys.push(0.5)
  print(a[0].ys[0])
}
function pushIntoEmpty(a) {
  a.push({ ys: [] })
  print(a[0].ys.length)
}
function pushInMain(a) {
  a.push({ ys: [] })
  print(a[0].ys[0])
}
