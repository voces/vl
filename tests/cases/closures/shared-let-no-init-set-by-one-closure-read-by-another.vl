// @run
// @log 7
// A `let` with no initializer that one closure writes and another reads is shared through a cell
// that starts as the null box (D16023): the first closure fills it, the second reads it back.
function go(k: i32) {
  let u: i32
  const set = () => {
    u = k
  }
  set()
  const get = () => u
  print(get())
}
go(7)
