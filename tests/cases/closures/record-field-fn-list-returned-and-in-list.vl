// @run
// @log 4
// @log 1.5
// @log 1.5
// @log 4
// @log 1.5
// A record literal whose field holds lists of lists of lists of un-annotated functions with
// different results, returned from a function or held in a list, is built at its rep (D16821).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function mk() { return { f: [[[inc0]], [[half]]] } }
const r = mk()
print(r.f[0][0][0](3))
print(r.f[1][0][0](3))
const rs = [{ f: [[[inc0]], [[half]]] }]
print(rs[0].f[1][0][0](3))
for x in rs[0].f { print(x[0][0](3)) }
