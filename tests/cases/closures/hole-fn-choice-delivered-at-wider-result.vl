// @run
// @log 5
// @log 3
// @log 5
// @log 5
// @log 3
// A bound choice between un-annotated functions, delivered to a parameter whose result is a
// wider union or nullable, is called through an adapter at that signature.
function inc(a) { return a + 1 }
function dec(a) { return a - 1 }
function useK(k: (a: i32) => i32 | string) { print(k(4)) }
function useN(k: (a: i32) => i32 | null) { print(k(4) ?? 0) }
function same(c: boolean) {
  const h = if c { inc } else { dec }
  useK(h)
}
same(true)
same(false)
function nul(c: boolean) {
  const h = if c { inc } else { dec }
  useN(h)
}
nul(true)
function pick(n: i32) {
  const h = match n {
    0 => inc
    _ => dec
  }
  useK(h)
}
pick(0)
pick(1)
