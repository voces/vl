// @run
// @log 1.5
// @log 4
// @log 1.5
// @log 2.5
// A `let` list of un-annotated functions re-pointed to a literal of another result holds both
// literals' functions, so a call through its element runs the one it holds (D9172, D14648).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
let xs = [inc0]
xs = [half]
print(xs.map((f) => f(3))[0])
let ys = [inc0]
print(ys[0](3))
ys = [half]
print(ys[0](3))
for f in ys { print(f(5)) }
