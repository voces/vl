// @run
// @log 4.5
// @log 9
// @log 5
// @log 4.5
// @log 9
// @log 5
// @log 4.5
// @log 9
// @log 5
// @log 14
// @log 5
// A parameter called at two signatures and handed whole, from a closure or through a `const`
// copy of a function, into a callee instance that a direct call also reaches with its own
// lambda: that lambda is built at the record's other signature too.
function keep(g) { print(g(7)) }
function keepCopy(g) { print(g(7)) }
function keepTwo(g) { print(g(7)) }
function lap(f) {
  print(f(2.5))
  const h = () => keep(f)
  h()
}
function lapCopy(f) {
  print(f(2.5))
  const kk = keepCopy
  kk(f)
}
function lapTwo(f) {
  print(f(2.5))
  const h = () => keepTwo(f)
  h()
}
function go(k: i32) {
  lap((a) => a + k)
  keep((x) => x - k)
  lapCopy((a) => a + k)
  keepCopy((x) => x - k)
  lapTwo((a) => a + k)
  lapTwo((a) => a * k)
  keepTwo((x) => x - k)
}
go(2)
