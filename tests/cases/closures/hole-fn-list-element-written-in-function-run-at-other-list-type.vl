// @run
// @warning Unused parameter `a`
// @log x2
// @log y20
// @log 20
// @log 20
// @log 2
// D12700 at two other delivery positions: an element written by index, and one pushed inside a
// function, are part of the list's elements at its own call type.
import { toString } from "std:fmt"

function cat(a, b) { return a + b.toString() }
function snd(a, b) { return b }
function apply2(g) { print(g("x", 2)) }
function apply3(g) { print(g("y", 20)) }
const fs = [apply2, apply3]
const fs2 = [apply2, apply3]
fs2[0] = apply3
function addOne() { fs2.push(apply2) }
addOne()
for f in fs { f(cat) }
for f in fs2 { f(snd) }
