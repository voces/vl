// @run
// @log 4
// @log 5
// @log 4
// A function returning a list of records that hold un-annotated functions gives its result the
// row the returned list is built at, as a bound literal does (D15203).
function inc0(a) { return a + 1 }
function mk() { return [{ fs: [inc0] }] }
function pk() { return [{ f: inc0 }] }
print(mk()[0].fs[0](3))
const rs = mk()
print(rs[0].fs[0](4))
print(pk()[0].f(3))
