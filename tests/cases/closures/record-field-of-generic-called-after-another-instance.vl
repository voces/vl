// @run
// @log C
// @log 2
// @log C
// @log s
// @log 3
// A record field holding a generic and called through the field is instanced at that call's
// type, not at an instance another call already made (D4241).
function gC<W>(w: W) {
  print("C")
  print(w)
}
const y = { h: gC, n: 3 }
gC(2)
y.h("s")
print(y.n)
