// @run
// @info `fs` is never reassigned; use `const` instead of `let`
// @log I
// @log 3
// @log I
// @log true
// A `let` list of generics written through an element is instanced at the call through it,
// not at an instance another call made first (D4012).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function main() {
  inner(3)
  let fs = [other]
  fs[0] = inner
  fs[0](true)
}
main()
