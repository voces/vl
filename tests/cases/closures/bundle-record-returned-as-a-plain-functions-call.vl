// @run
// @log 12 4.5
// @log 5 2.5
// @log 6 3.5
// @log 6
// @log 5
// @log 2.5
// A plain function returning a call of a function that returns its parameter called at two
// signatures returns that record whole: held, called at once, through a chain, and from either
// of two returns.
function lap(f) {
  f(2.5)
  f(3)
  return f
}
function mk(k: i32) { return lap((a) => a + k) }
function pick(k: i32) {
  if k > 1 { return lap((a) => a * k) }
  return lap((a) => a + k)
}
function chain(k: i32) { return mk(k + 1) }
function go() {
  const v = mk(1)
  print(v(4))
  print(v(1.5))
}
const w = pick(3)
print("\{w(4)} \{w(1.5)}")
const u = pick(1)
print("\{u(4)} \{u(1.5)}")
const c = chain(1)
print("\{c(4)} \{c(1.5)}")
print(mk(2)(4))
go()
