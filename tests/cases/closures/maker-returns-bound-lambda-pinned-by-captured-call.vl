// @run
// @log 6
// @log 6
// @log 6.5
// A function whose result is not annotated but closes returns a bound hole lambda that its body's
// call pins: the lambda is built at that result, bound and called, called inline, at any width.
function wrap(f: (n: i32) => i32) {
  const l = (x) => f(x)
  return l
}
function wrapF(f: (n: f64) => f64) {
  const l = (x) => f(x)
  return l
}
const inc = (n: i32): i32 => n + 1
const c = wrap(inc)
print(c(5))
print(wrap(inc)(5))
const incF = (n: f64): f64 => n + 1.0
print(wrapF(incF)(5.5))
