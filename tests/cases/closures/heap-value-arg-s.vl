// @run
// @log 6
// Sibling records holding different hole functions, `s.f` called:
// passed through an un-annotated parameter and returned.
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function pass(m) { return m }
function mk() { return pass({ r: { f: inc0 }, s: { f: dbl } }) }
print(mk().s.f(3))
