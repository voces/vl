// @error argument 1: expected i32, got string
// A module-scope list of a generic function whose element is overwritten by a fixed-type function
// refuses a call through that element at a type the function cannot take (D10122).
function id<T>(x: T): T { x }
function inc(x: i32): i32 { x + 1 }
const ys = [id]
ys.push(id)
ys[1] = inc
print(ys[1]("s"))
