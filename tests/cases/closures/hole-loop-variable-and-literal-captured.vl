// @run
// @log s
// @log 4
// @log 2.5
// @log 1
// @log 1
// @log s
// A closure in a hole function captures a `for`-in loop variable, or returns a list literal of
// the parameter, at the parameter's pin: a union box, a nullable, and a `string | null` null
// (D3084, D2926).
function f(x) {
  const l = [x]
  for e in l {
    const k = () => e
    print(k())
  }
}
const u: i32 | string = "s"
f(u)
const i: i32 | string = 4
f(i)
const d: f64 | null = 2.5
f(d)
function F(x) {
  const c = () => [x]
  print(c().length)
}
const sn: string | null = null
F(sn)
F(3)
function G(x) {
  const l = [x]
  const k = () => l.filter((e) => e == x)
  print(k()[0])
}
G("s")
