// @run
// @hint Intentionally-unused parameter
// The POSITIVE side of `error-is-functype-slot-rep-reject.vl`: with the closure genuinely
// nullable — `((i32) => i32) | null`, parens and all — `is <functype>` narrows to something
// callable at every position a value can sit in, and the `!= null` spelling of each agrees.
//
// This exists because a silent-class sweep wrote the UNPARENTHESISED `(i32) => i32 | null`
// at these same seven positions, which denotes a function returning `i32 | null` and is a
// different program (see the error fixture, and `silent-class-inventory.md` §4d). Reading
// those 17 cells as "the nullable-closure `is` narrow is broken" is the mistake this file
// exists to make unrepeatable: the shape they were aimed at is the one below, and it works.
//
// Both legs of every guard run. The ELSE leg must still see `null` — a narrow that folded
// its guard to a constant would print one leg twice and is what the `NUL` lines catch.
// `nCalls` is the eval-count channel: the annotated-return producer is called once per
// reader that uses it, never twice, so a re-read of the narrowed place would show up here.
type F = (i32) => i32

let nCalls = 0
let g: F | null = null

function srcAnn(present: boolean): F | null {
  nCalls = nCalls + 1
  if present { return (x) => x + 1 }
  null
}

// ── the seven positions, `is` spelling ──────────────────────────────────────
function isParam(v: F | null) {
  if v is F { print(v(3)) } else { print("NUL") }
}
function isConstLocal() {
  const c: F | null = (x) => x + 1
  if c is F { print(c(3)) } else { print("NUL") }
}
function isLetLocal() {
  let l: F | null = null
  l = (x) => x + 1
  if l is F { print(l(3)) } else { print("NUL") }
}
function isGlobal(present: boolean) {
  if present { g = (x) => x + 1 } else { g = null }
  if g is F { print(g(3)) } else { print("NUL") }
}
function isElem() {
  const xs: (F | null)[] = [(x) => x + 1]
  const e = xs[0]
  if e is F { print(e(3)) } else { print("NUL") }
}
function isRetAnn(present: boolean) {
  const r = srcAnn(present)
  if r is F { print(r(3)) } else { print("NUL") }
}
// The INLINE spelling of the tested type, alongside the alias one above.
function isInline(v: ((i32) => i32) | null) {
  if v is (i32) => i32 { print(v(3)) } else { print("NUL") }
}

// ── the `!= null` control at the same positions ─────────────────────────────
function neParam(v: F | null) {
  if v != null { print(v(3)) } else { print("NUL") }
}
function neConstLocal() {
  const c: F | null = (x) => x + 1
  if c != null { print(c(3)) } else { print("NUL") }
}
function neGlobal(present: boolean) {
  if present { g = (x) => x + 1 } else { g = null }
  if g != null { print(g(3)) } else { print("NUL") }
}
function neElem() {
  const xs: (F | null)[] = [(x) => x + 1]
  const e = xs[0]
  if e != null { print(e(3)) } else { print("NUL") }
}
function neRetAnn(present: boolean) {
  const r = srcAnn(present)
  if r != null { print(r(3)) } else { print("NUL") }
}

// ── other arities and a REF-returning result ────────────────────────────────
function isTwoParam(v: ((i32, i32) => i32) | null) {
  if v is (i32, i32) => i32 { print(v(3, 4)) } else { print("NUL") }
}
function isZeroParam(v: (() => i32) | null) {
  if v is () => i32 { print(v()) } else { print("NUL") }
}
function isRefResult(v: ((i32) => string) | null) {
  if v is (i32) => string { print(v(1)) } else { print("NUL") }
}

// @log 4
isParam((x) => x + 1)
// @log NUL
isParam(null)
// @log 4
isConstLocal()
// @log 4
isLetLocal()
// @log 4
isGlobal(true)
// @log NUL
isGlobal(false)
// @log 4
isElem()
// @log 4
isRetAnn(true)
// @log NUL
isRetAnn(false)
// @log 4
isInline((x) => x + 1)
// @log NUL
isInline(null)

// @log 4
neParam((x) => x + 1)
// @log NUL
neParam(null)
// @log 4
neConstLocal()
// @log 4
neGlobal(true)
// @log NUL
neGlobal(false)
// @log 4
neElem()
// @log 4
neRetAnn(true)
// @log NUL
neRetAnn(false)

// @log 12
isTwoParam((a, b) => a * b)
// @log NUL
isTwoParam(null)
// @log 7
isZeroParam(() => 7)
// @log NUL
isZeroParam(null)
// @log s
isRefResult((_x) => "s")
// @log NUL
isRefResult(null)

// The producer ran once per `*RetAnn` call and never twice.
// @log 4
print(nCalls)
