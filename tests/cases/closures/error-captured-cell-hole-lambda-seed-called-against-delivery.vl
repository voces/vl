// @emit-error the reassigned function binding `k` holds functions called at more than one argument type
// A cell seeded with a hole lambda delivered at `(i32, string) => void` is refused when it is
// later called with arguments of other types, rather than built at the delivered type (D3950).
function c2(f: (a: i32, b: string) => void) { f(1, "2") }
function main() {
  let k = (x, y) => {
    print("L"); print(x); print(y)
  }
  const flip = () => {
    k = (a, b) => {
      print("M"); print(a); print(b)
    }
  }
  c2(k)
  flip()
  k("3", 4)
}
main()
