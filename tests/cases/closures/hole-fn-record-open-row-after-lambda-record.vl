// @run
// @log 1.5
// @log 4
// @log 4
// @log 4
// @log 4
// @log 7.5
// @log 4
// @log 12
// @log 4
// @hint Intentionally-unused parameter `_x`
// A record of an un-annotated function handed to an un-annotated parameter after a record of an
// annotated lambda returning another type calls its own function: through an alias, a call
// result, a reassigned local in a function, an alias inside the callee, and with two fields
// (D9952). The annotated control is the first call.
function inc0(a) { return a + 1 }
function dbl0(a) { return a * 2.5 }
function dbl1(a) { return a * 2 }
function take(a) { return a.f(3) }
function takeAlias(a) {
  const g = a
  return g.f(3)
}
function take2(a) { return a.f(3) + a.g(4) }
function mk() { return { f: inc0 } }
print(take({ f: (_x: i32): f64 => 1.5 }))
const c1 = { f: inc0 }
const v1 = c1
print(take(v1))
print(take(mk()))
function local() {
  let v = { f: inc0 }
  v = { f: inc0 }
  print(take(v))
}
local()
print(takeAlias({ f: (_x: i32): f64 => 1.5 }) + takeAlias({ f: inc0 }) - 1.5)
const c2 = { f: dbl0 }
const v2 = c2
print(take(v2))
const c3 = { f: inc0 }
const v3 = c3
print(take(v3))
const two = take2({ f: (_x: i32): f64 => 1.5, g: (_x: i32): f64 => 2.5 })
const c4 = { f: inc0, g: dbl1 }
const v4 = c4
print(take2(v4))
print(two)
