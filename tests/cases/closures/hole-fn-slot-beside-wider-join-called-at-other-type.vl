// @run
// @log 1
// @log b
// @log 4
// @log c
// A binding holding one hole function, beside a join of it and another called at a different type:
// a call through the wider join is not the binding's, so the binding's call keeps its own type
// (the calls a slot reaches are those through its set or a join holding it, #6435).
function idf(x) { return x }
function inc(x) { return x + 1 }
const flag = true
const j = if flag { idf } else { inc }
print(j(1))
const solo = idf
print(solo("b"))
function pick(k: boolean) { return if k { idf } else { inc } }
print(pick(false)(3))
const alone = idf
print(alone("c"))
