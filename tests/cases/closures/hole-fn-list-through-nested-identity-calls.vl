// @run
// A list of un-annotated functions handed through two identity calls keeps its elements, of one
// result type or of one element.
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function id(x) { return x }
print(id(id([inc0]))[0](3))
print(id(id([inc0, dbl]))[1](3))
// @log 4
// @log 6
