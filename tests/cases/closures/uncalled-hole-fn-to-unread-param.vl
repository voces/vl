// @run
// @log 2
// @log 2
// @log 1
// @log 2
// @hint Intentionally-unused variable `_k` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_h` (leading `_` marks it unused)
// @warning Unused parameter `f` (prefix with `_` to suppress, or remove it)
// A hole function that calls its own hole parameter, handed to a parameter nothing calls, is
// built as no body: the callee only prints, aliases it unread, measures it in a list, hands it on
// to another such parameter, or returns it to a binding nothing reads, so its signature is never
// observed (D6881).
function apply3(g) { print(g(1, 2)) }

function run(f) { print(2) }
function mid(f) { run(f) }
function hold(f) {
  const _k = f
  const xs = [f]
  print(xs.length)
}
function back(f) { return f }

run(apply3)
mid(apply3)
hold(apply3)
const _h = back(apply3)
print(2)
