// A `let` of a call returning one of two generics, written with a call whose set is wider,
// narrower or disjoint, and called at two types: the binding holds the join's id, and its
// initialiser's subset is decided with it (D10370).
function id<T>(x: T): T { x }
function same<T>(x: T): T {
  print("same")
  x
}
function third<T>(x: T): T {
  print("third")
  x
}
function pick(n: i32) {
  if n > 1 { return id }
  return same
}
function pick3(n: i32) {
  if n > 1 { return id }
  if n > 0 { return third }
  return same
}
let k = pick(5)
print(k(21))
k = pick3(1)
print(k(22))
print(k("b"))

function idB<T>(x: T): T { x }
function sameB<T>(x: T): T {
  print("same")
  x
}
function thirdB<T>(x: T): T {
  print("third")
  x
}
function wide(n: i32) {
  if n > 1 { return idB }
  if n > 0 { return thirdB }
  return sameB
}
function narrow(n: i32) {
  if n > 1 { return idB }
  return sameB
}
function main() {
  let j = wide(5)
  print(j(1))
  j = narrow(0)
  print(j(2))
  print(j("x"))
}
main()

function idC<T>(x: T): T { x }
function fourC<T>(x: T): T {
  print("four")
  x
}
function fiveC<T>(x: T): T {
  print("five")
  x
}
function pa(n: i32) {
  if n > 1 { return idC }
  return idC
}
function pb(n: i32) {
  if n > 1 { return fourC }
  return fiveC
}
let m = pa(5)
print(m(3))
m = pb(2)
print(m(4))
print(m("y"))
