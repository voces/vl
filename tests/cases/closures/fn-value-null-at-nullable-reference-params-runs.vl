// @run
// @log str null
// @log str a
// @log rec null
// @log rec 4
// @log list null
// @log list 2
// @log fn null
// @log fn 6
// @log map null
// @log map 1
// A function value called with `null` or a value at each nullable reference parameter: the callee
// sees the null its parameter's type names, or the value.
type P = { v: i32 }
function onStr(x: string | null) {
  if x == null { print("str null") } else { print("str " + x) }
}
function onRec(x: P | null) {
  if x == null { print("rec null") } else { print("rec \{x.v}") }
}
function onList(x: i32[] | null) {
  if x == null { print("list null") } else { print("list \{x.length}") }
}
function onFn(x: ((n: i32) => i32) | null) {
  if x == null { print("fn null") } else { print("fn \{x(3)}") }
}
function onMap(x: {[string]: i32} | null) {
  if x == null { print("map null") } else { print("map \{x.length}") }
}
function callStr() {
  const s = onStr
  s(null)
  s("a")
}
function callRec() {
  const r = onRec
  r(null)
  r({ v: 4 })
}
function callList() {
  const l = onList
  l(null)
  l([1, 2])
}
function callFn() {
  const f = onFn
  f(null)
  f((n: i32) => n * 2)
}
function callMap() {
  const m = onMap
  m(null)
  const mm: {[string]: i32} = Map()
  mm.set("k", 1)
  m(mm)
}
callStr()
callRec()
callList()
callFn()
callMap()
