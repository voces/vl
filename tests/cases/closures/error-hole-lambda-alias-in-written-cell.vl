// @emit-error a lambda with an un-annotated parameter is stored in a list, or in a variable a nested function writes, and no call fixes its parameter types
// A hole lambda no call pins, reaching a capture cell through another binding, is refused as
// one stored there by name is (D3851): its cell has no type but the hole's default (D3864).
function mk() {
  const c = (y) => y + y
  let d1 = c
  let d2 = d1
  function w4(): i32 {
    d2 = d1
    0
  }
}
mk()
