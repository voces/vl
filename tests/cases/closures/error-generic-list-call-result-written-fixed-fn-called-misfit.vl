// @error cannot write 'k' to an element of 'fs': a call through it at (i32, i32) runs it, and it is (i32, string) => i32
// A list a call returns holds the returned elements and what is written to it (D12239).
function pick<A, B>(a: A, b: B): A { a }
function k(a: i32, b: string): i32 { a }
function mk() { [pick] }
const fs = mk()
fs[0] = k
print(fs[0](1, 2))
