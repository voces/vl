// An inline list of un-annotated functions and an annotated list, each handed to one
// un-annotated parameter whose element is called, each pin the element at its own call (D9360).
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function early(a) {
  if a.length == 0 { return 0 }
  return a[0](4)
}
const e: ((x: i32) => i32)[] = [dbl]
print(early([inc0]))
print(early(e))
function late(a) { return a[0](4) }
print(late(e))
print(late([inc0]))
const none: ((x: i32) => i32)[] = []
print(early([inc0]))
print(early(none))
function two(a, b) { return a[0](4) + b[0](5) }
print(two([inc0], e))
print(two(e, [inc0]))
