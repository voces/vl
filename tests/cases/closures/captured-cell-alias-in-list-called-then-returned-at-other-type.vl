// @warning Unused function `cb` (prefix with `_` to suppress, remove it, or `export` it)
// @warning Unused variable `flip` (prefix with `_` to suppress, or remove it)
// A list element aliasing a cell's read, called at one type and returned at another, runs (D7102).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function cb(f: (b: boolean) => void, b: boolean) { f(b) }
function mk(): (b: boolean) => void {
  let k = inner
  const flip = () => {
    k = other
  }
  const r = k
  const fs = [r]
  fs[0](3)
  return r
}
mk()(true)
