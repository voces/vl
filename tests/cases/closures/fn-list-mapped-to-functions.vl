// @run
// @log 8
// @log 8
// @log 14
// @log 7
// @log 3.5
// @log 8
// @log 8
// @log 8
// @log 14
// @log 9
// @hint Intentionally-unused parameter `_f` (leading `_` marks it unused)
// A `.map` over a list of functions whose callback returns a function gives a list of that
// function's type, annotated or not, called directly, in a loop or inline; a `.filter` keeps the
// list's own type (D9171).
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function ginc<T>(a: T): T { return a }
function incA(a: i32) { return a + 1 }
function dblA(a: i32) { return a * 2 }

const x1 = [inc0]
const g1 = x1.map((f) => f)
print(g1[0](7))

const x2 = [inc0, dbl]
const g2 = x2.map((f) => f)
for g in g2 { print(g(7)) }

const x3 = [ginc]
const g3 = x3.map((f) => f)
print(g3[0](7))

const x4 = [inc0]
const g4 = x4.map((f) => f)
print(g4[0](2.5))

const x5 = [inc0]
print(x5.map((f) => f)[0](7))

const x6 = [inc0]
const g6 = x6.filter((f) => f(1) > 0)
print(g6[0](7))

const x7 = [incA]
const g7 = x7.map((f) => f)
print(g7[0](7))

const x8 = [incA]
const g8 = x8.map((_f) => dblA)
print(g8[0](7))

function main() {
  const gs = x1.map((f) => f)
  print(gs[0](8))
}
main()
