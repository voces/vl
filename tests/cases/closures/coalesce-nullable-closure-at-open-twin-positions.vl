// @run
// @log 3
// @log 3.5
// @log 1.5
// @log 1.5
// @log 3
// @log 6
// @log 8
// A `??` whose present operand is a nullable closure read from a generic helper over maps of
// un-annotated functions, where the result's closure is the operand's twin apart in openness
// (three maps of different sets instance the helper apart): bound at the top, in a function, and
// passed.
function inc(x) { return x + 1 }
function dbl(x) { return x + x }
function inc0(x) { return x + 1 }
function half(x) { return x / 2.0 }
function pick<V>(m: {[string]: V}, k: string): V | null { return m.get(k) }
const m = Map()
m["a"] = inc
m["b"] = dbl
const h = pick(m, "a") ?? dbl
print(h(2))
print(h(2.5))
const n = Map()
n["a"] = inc0
n["b"] = half
const g = pick(n, "b") ?? inc0
print(g(3))
const q = pick(n, "b")
if q != null { print(q(3)) }
const o = Map()
o["a"] = inc0
const r = pick(o, "a") ?? inc0
print(r(2))
function viaFn() {
  const f = pick(o, "z") ?? inc0
  return f(5)
}
print(viaFn())
function call(f, x: i32) { return f(x) }
print(call(pick(m, "b") ?? dbl, 4))
