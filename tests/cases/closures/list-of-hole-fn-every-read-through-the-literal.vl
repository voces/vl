// @run
// @log 3
// @log 3
// @log s
// A list of one hole function whose every read, in a loop and by index, is rewritten to the
// function by name leaves the literal holding a value nothing calls (D6661).
function h(u) { return u }
const fs = [h, h]
for f in fs { print(f(3)) }
print(fs[0]("s"))
