// @run
// @log 4
// @log 4
// @log 4
// @log 4
// @log 4
// @log 4
// The annotation on case 2's `held` is the row's own control and is deliberately kept.
// @hint redundant type annotation: `held` is inferred as `{[string]: {[string]: i32}}`
// D1772 — a captured un-annotated projection of a NESTED map. `letInitProjKind` and its
// companion `letInitProjMapShape` are one pair, and they split their domain on different
// predicates: the kind takes the rep descriptor's answer when it covers the node, while the
// shape declined every node the descriptor covered. A nested map IS covered and a
// struct-valued shallow one is not, so the pair was ("map", -1) — the mono map — over a
// value carrying the nested map's own `$mapStruct`.

function mki(): { [string]: i32 } {
  const m: { [string]: i32 } = Map()
  m["k"] = 4
  return m
}
function mko(): { [string]: { [string]: i32 } } {
  const o: { [string]: { [string]: i32 } } = Map()
  o["o"] = mki()
  return o
}

// 1 — the witness: the INDEX projection, un-annotated, captured, in a function body.
function go() {
  const xs = [mko()]
  const held = xs[0]
  const get = () => held
  print((get()["o"] ?? Map())["k"] ?? 0)
}
go()

// 2 — the ANNOTATED face of the same binding, which ran before and must keep running: it is
// what says the pair now agrees rather than that one arm replaced the other.
function goAnn() {
  const xs = [mko()]
  const held: { [string]: { [string]: i32 } } = xs[0]
  const get = () => held
  print((get()["o"] ?? Map())["k"] ?? 0)
}
goAnn()

// 3 — the FIELD projection, the sibling face the descriptor also covers.
type Box = { it: { [string]: { [string]: i32 } } }
function mkB(): Box { return { it: mko() } }
function goField() {
  const b = mkB()
  const held = b.it
  const get = () => held
  print((get()["o"] ?? Map())["k"] ?? 0)
}
goField()

// 4 — the same witness at plain module scope, where the syntactic `letIs*` ladder cannot
// resolve the projection's owner at all.
const xs = [mko()]
const held = xs[0]
const get = () => held
print((get()["o"] ?? Map())["k"] ?? 0)

// 5 — the capture removed: the pair is read by the env field, so the binding alone must
// still lower to the same cell.
function goNoCap() {
  const ys = [mko()]
  const kept = ys[0]
  print((kept["o"] ?? Map())["k"] ?? 0)
}
goNoCap()

// 6 — ONE container deep, the depth control that ran at both seeds: the shallow map takes
// the descriptor's uncovered route and must not move.
function goShallow() {
  const zs = [mki()]
  const one = zs[0]
  const g = () => one
  print(g()["k"] ?? 0)
}
goShallow()
