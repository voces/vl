// @run
// @log 4
// @log 6
// @log 4
// @log none
// @log 6
// @log 8
// @log 1
// @log 5
// A tagged set's member id read from a map and returned in a list a caller indexes and calls: the
// list holds each member's closure, a missing key's null kept, read back as the id where the
// caller types it so.
function inc(a) { return a + 1 }
function dbl(a) { return a * 2 }
const m = Map()
m["k"] = inc
m["d"] = dbl
function both() { return [m["k"], m["d"]] }
const fs = both()
let i = 0
while i < fs.length {
  const f = fs[i]
  if f != null { print(f(3)) }
  i = i + 1
}
function withMiss() { return [m["k"], m["zz"], m["d"]] }
const gs = withMiss()
let j = 0
while j < gs.length {
  const g = gs[j]
  if g != null { print(g(3)) } else { print("none") }
  j = j + 1
}
function missing() { return [m["zz"]] }
const hs = missing()
const h = hs[0] ?? dbl
print(h(4))
function one() { return [m["k"]] }
const os = one()
print(os.length)
const o = os[0] ?? dbl
print(o(4))
