// @run
// @info `r` is never reassigned; use `const` instead of `let`
// @log 3
// @log x
// @log 4
// @log y
// A `const` list, and a `let` one nothing re-points, seeded by a hole parameter, a slot written
// with a named function, while the parameter is called directly at another type (D15453).
function same<T>(k: T): T { k }
function dbl(x) { x }
function go(a) {
  const r = [a]
  r[0] = dbl
  print(r[0](3))
  print(a("x"))
}
go(same)
function goLet(a) {
  let r = [a]
  r[0] = dbl
  print(r[0](4))
  print(a("y"))
}
goLet(same)
