// @run
// @log z
// @log 7
// A block `const` shadowing a function-list parameter does not change the parameter's later
// call (D3924).
function st(fs: ((t: i32) => void)[], x: i32) {
  if true {
    const fs: ((t: string) => void)[] = [(t: string) => print(t)]
    fs[0]("z")
  }
  fs[0](x)
}
const gs: ((t: i32) => void)[] = [(t: i32) => print(t)]
st(gs, 7)
