// @run
// @log s
// A `let` list of a generic function pushed a fixed-type function and then assigned a fresh list
// runs where an alias of it is delivered at another type: the push no longer reaches the
// delivered list (D10201).
function id<T>(x: T): T { x }
function inc(x: i32) { x + 1 }
let zs = [id]
zs.push(inc)
zs = [id, id]
const ws = zs
function runS(a: ((x: string) => string)[]) { print(a[1]("s")) }
runS(ws)
