// @run
// @info `q` is never reassigned; use `const` instead of `let`
// @log 1.5
// @log 1.5
// @log 1.5
// @log 4
// @log 1.5
// @log 2
// @log 1.5
// @log 6
// @log 1.5
// @log 1.25
// A nested record literal's list field written a function of another result type, directly, at
// three levels, through an alias of the inner record or of the field: the write joins the nested
// field's element set, so a call through it runs the written function (D15168, D15191).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function dbl(a) { return a * 2 }
function id<T>(x: T): T { return x }
function halfG<T>(x: T): f64 { return x / 2.0 }
function inner() {
  const r = { inner: { xs: [inc0] } }
  r.inner.xs[0] = half
  return r.inner.xs[0](3)
}
const r = { inner: { xs: [inc0] } }
r.inner.xs[0] = half
print(r.inner.xs[0](3))
const d = { a: { b: { xs: [inc0] } } }
d.a.b.xs[0] = half
print(d.a.b.xs[0](3))
const s = { p: { xs: [inc0] }, q: { xs: [inc0] } }
s.p.xs[0] = half
print(s.p.xs[0](3))
print(s.q.xs[0](3))
const a = { inner: { xs: [inc0] } }
const inn = a.inner
inn.xs[0] = half
print(a.inner.xs[0](3))
let q = { inner: { xs: [inc0], n: 2 } }
q.inner.xs[0] = half
print(q.inner.n)
print(inner())
const b = { inner: { xs: [inc0] } }
const ys = b.inner.xs
ys[0] = dbl
print(b.inner.xs[0](3))
const g = { inner: { fs: [id] } }
g.inner.fs[0] = halfG
print(g.inner.fs[0](3))
print(g.inner.fs[0](2.5))
