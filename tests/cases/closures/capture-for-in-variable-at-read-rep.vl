// @run
// @log 1
// @log 2
// @log 3
// @log a
// @log b
// @log 6
// A closure captures a `for-in` variable, an i32 element, a string element or a map key, and
// reads it back through its environment.
function sumVia(xs: i32[]) {
  let t = 0
  for x in xs {
    const f = () => x
    print(f())
    t = t + f()
  }
  return t
}

function names(ss: string[]) {
  for s in ss {
    const g = () => s
    print(g())
  }
}

const total = sumVia([1, 2, 3])
names(["a", "b"])
print(total)
