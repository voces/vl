// @run
// @log 6
// @log 4
// @log 6
// @log 4
// @log 6
// @log 4
// A `let` map of un-annotated functions initialised from one map and re-pointed to another reads
// the join of both maps' functions, whichever it holds, and so do the maps themselves (D15535).
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
const hm = Map()
hm["k"] = inc0
const hm2 = Map()
hm2["k"] = dbl
let u = hm
u = hm2
const y = u["k"]
if y != null { print(y(3)) }
const z = hm["k"]
if z != null { print(z(3)) }
for _k, f in u { print(f(3)) }
let v = hm2
v = hm
const w = v.get("k")
if w != null { print(w(3)) }
function pick(c: boolean) {
  let p = hm
  if c { p = hm2 }
  p
}
const a = pick(true)["k"]
if a != null { print(a(3)) }
const c = pick(false)["k"]
if c != null { print(c(3)) }
