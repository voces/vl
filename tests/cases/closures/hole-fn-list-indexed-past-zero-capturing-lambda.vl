// @run
// @log 305
// @log 30
// @log 200
// D10793: a capturing lambda at the third element, and two lambdas through one element.
function apply2(g) { print(g(1, 2)) }
function apply3(g) { print(g(10, 20)) }
function apply4(g) { print(g(100, 200)) }
function gen() {
  const gs = [apply2, apply3, apply4]
  const k = 5
  gs[2]((a, b) => a + b + k)
  gs[1]((a, b) => a + b)
  gs[1]((a, b) => {
    return a * b
  })
}
gen()
