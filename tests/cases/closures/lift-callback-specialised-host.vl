// @run
// @log 2
// @log 2
// @log 16
// @log 19
// @log 2
// @log 201
// @log 3
// @log 102

// @hint redundant type annotation: `g` is inferred as `i32`
// @hint Intentionally-unused parameter `_f`
// @hint redundant type annotation: `host` is inferred as `i32`
// @hint redundant type annotation: `twice` is inferred as `i32`
// @hint redundant type annotation: `plus100` is inferred as `i32`
// @hint redundant type annotation: `capturesCallback` is inferred as `i32`
// @hint redundant type annotation: `loopHeader` is inferred as `i32`
// @hint redundant type annotation: `localFunction` is inferred as `i32`

// A function that takes a function-typed parameter is specialised per callback, and each
// specialisation shares its host's statements. A local function declared there is emitted in
// every specialisation, so it is lifted in none of them: lifting it in one frame left the other
// building a closure value for it, and the build failed on a check-clean program (D3713).

function host(_f: (n: i32) => i32): i32 {
  const g = (i: i32) => i + 1
  g(1)
}

function twice(n: i32): i32 { n * 2 }
function plus100(n: i32): i32 { n + 100 }

function capturesCallback(f: (n: i32) => i32): i32 {
  const k = 10
  const g = (i: i32) => f(i) + k
  g(3)
}

function loopHeader(f: (n: i32) => i32, m: i32): i32 {
  const drawn = (i: i32) => i + m > 4
  let s = 0
  let i = 0
  while i < 4 && !drawn(i) {
    s = s + f(i)
    i = i + 1
  }
  s
}

function localFunction(f: (n: i32) => i32): i32 {
  function g(i: i32): i32 { return i + 1 }
  g(f(1))
}

print(host(twice))
print(host((n: i32) => n * 3))
print(capturesCallback(twice))
print(capturesCallback((n: i32) => n * 3))
print(loopHeader(twice, 3))
print(loopHeader(plus100, 3))
print(localFunction(twice))
print(localFunction(plus100) + 0)
