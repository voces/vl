// @run
// @log 1.5
// @log 4
// @log 3.5
// @log 1.5
// @log 1.5
// Two returns of records whose list field holds un-annotated functions of different results
// return the join of their sets, each record built at the function's result row, so a call
// through an element runs the member it holds (D15366).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function pick(b: boolean) {
  if b { return { fs: [inc0], n: 1 } }
  return { fs: [half], n: 2 }
}
function nest(b: boolean) {
  if b { return { fs: [[inc0]] } }
  return { fs: [[half]] }
}
function inner(b: boolean) {
  if b { return { o: { fs: [inc0] } } }
  return { o: { fs: [half] } }
}
print(pick(false).fs[0](3))
print(pick(true).fs[0](3))
const r = pick(false)
print(r.fs[0](3) + r.n)
print(nest(false).fs[0][0](3))
print(inner(false).o.fs[0](3))
