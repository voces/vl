// @run
// @log 1.5
// A call through an element of a bound list literal of un-annotated functions with different
// results runs the member the element holds (D9092, D14435).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const xs = [inc0, half]
const i = xs.length - 1
print(xs[i](3))
