// @trap
// Missing-key variant of `module-holder-of-bundles-read-before-init-traps`: the holder reads key `z`, so it holds null.
// A module const holding a map read of two-signature bundles, null-tested by a function called
// before its initializer ran, traps on the read as any module global does (D17111).
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
const m = Map()
m["a"] = lap((a) => a + 1)
print(has())
const x = m["z"]
function has() { return x != null }
print(has())
// @hint Intentionally-unused variable `_a`
// @hint Intentionally-unused variable `_b`
