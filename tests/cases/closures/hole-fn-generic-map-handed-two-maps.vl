// @log 2
// @log s
// A function storing a generic into the map it is handed, called with two un-annotated maps,
// lets either map's entry be called at two types (D9480).
function id<T>(x: T): T { x }
function inc(x: i32) { x + 1 }
function fill(mm) { mm["k"] = id }
const m = Map()
m["k"] = id
const m2 = Map()
m2["k"] = id
fill(m)
fill(m2)
const r = m["k"]
if r != null {
  print(r(2))
  print(r("s"))
}
const a = Map()
const b = Map()
fill(a)
fill(b)
const ra = b["k"]
if ra != null {
  print(ra(2))
  print(ra("s"))
}
const qa = a["k"]
if qa != null { print(qa(5)) }
const c = Map()
const d = Map()
d["j"] = inc
fill(c)
fill(d)
const rc = c["k"]
if rc != null {
  print(rc(2))
  print(rc("s"))
}
function fill2(mm) {
  mm["k"] = id
  const g = mm["k"]
  if g != null { print(g(7)) }
}
const e = Map()
const f = Map()
fill2(e)
fill2(f)
const re = e["k"]
if re != null {
  print(re(2))
  print(re("s"))
}
