// @error a call through `fs[_]` passes i32 to a function written there that takes `f64` (the call's argument types)
// The generic's instance at `i32` is what a call through the element runs, so a function written
// there must take exactly `i32`, as `fs[0](1, 1)` at top level requires (D12238).
function pick<A, B>(a: A, b: B): A { a }
function k(a: i32, b: f64): i32 { a }
const fs = [pick]
fs[0] = k
function g<T>(v: T): T { fs[0](v, v) }
print(g(1))
