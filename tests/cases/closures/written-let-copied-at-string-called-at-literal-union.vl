// @run
// @log B
// @log r
// @log B
// @log q
// A copy called with a string literal union and the binding it copies called with a `string`:
// every member of the copy set is banked at the call's signature, so the copy runs its own
// instance (D4244, D4893).
function gA<U>(u: U) {
  print("A")
  print(u)
}
function gB<V>(v: V) {
  print("B")
  print(v)
}
function gC<W>(w: W) {
  print("C")
  print(w)
}
type S = "p" | "q"
const a: S = "q"
let x = gA
x = gB
let y = gC
y = x
x("r")
y(a)
