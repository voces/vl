// @run
// @log 4
// @log 1
// A record literal reassigned to a local whose function list widens to another set than a
// global's builds at the local's row, the one its field value's restamped type names (D15560).
function inc(a) { return a + 1 }
function dbl(a) { return a * 2 }
function dec(a) { return a - 1 }
let r = { f: [inc] }
r = { f: [dbl] }
print(r.f[0](2))
function local() { let q = { f: [inc] }; q = { f: [dec] }; print(q.f[0](2)) }
local()
