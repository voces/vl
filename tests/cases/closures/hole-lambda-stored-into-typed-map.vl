// @run
// @log aa
// @log 10
// @log 14
// @log 3
// @log 12
// @log bb
// A hole lambda stored into a map of a function type, by index or by `.set`, is delivered at the
// map's value type, beside a push of it into a list of another function type (D3881).
const tw = (y) => y + y
const fs: ((y: string) => string)[] = []
fs.push(tw)
print(fs[0]("a"))
const m: {[string]: (y: i32) => i32} = Map()
m["k"] = tw
const f = m["k"]
if f != null { print(f(5)) }
const byKey: {[i32]: (y: i32) => i32} = Map()
byKey.set(3, tw)
const g = byKey.get(3)
if g != null { print(g(7)) }
const fl: {[string]: (y: f64) => f64} = Map()
function put() { fl["k"] = tw }
put()
const h = fl["k"]
if h != null { print(h(1.5)) }
const sm: {[i32]: (y: string) => string} = Map()
sm[1] = tw
const tm: {[string]: (y: i32) => i32} = Map()
tm["t"] = tw
const t = tm["t"]
if t != null { print(t(6)) }
const s = sm[1]
if s != null { print(s("b")) }
