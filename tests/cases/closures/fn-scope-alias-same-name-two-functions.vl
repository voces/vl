// @run
// @log 12
// @log aa
// Two functions each bind a `let d` and write the other module lambda into it: each write is
// resolved in its own function, so each lambda takes that alias's signature (D3865).
const c = (y) => y + y
const e = (y) => y + y + y
function f(n: i32) {
  let d = c
  function w() { d = e; 0 }
  w()
  print(d(n))
}
function g(x: string) {
  let d = e
  function w() { d = c; 0 }
  w()
  print(d(x))
}
f(4)
g("a")
