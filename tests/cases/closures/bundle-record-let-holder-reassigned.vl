// A returned bundle's record held by a `let` reassigned from calls returning the same record:
// each write stores the record whole, in a function, in a loop and at the top level.
function lap(f) {
  print(f(2.5))
  print(f(3))
  return f
}
function go(k: i32) {
  let r = lap((a) => a + k)
  print(r(4))
  print(r(1.5))
  r = lap((a) => a * k)
  print(r(4))
  print(r(1.5))
}
function loop(k: i32) {
  let r = lap((a) => a + k)
  let i = 0
  while i < 2 {
    r = lap((a) => a * (k + i))
    print(r(4))
    print(r(1.5))
    i = i + 1
  }
}
go(2)
loop(2)
let t = lap((a) => a + 1)
print(t(4))
t = lap((a) => a * 2)
print(t(1.5))
