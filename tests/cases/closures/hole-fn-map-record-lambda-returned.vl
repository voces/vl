// @run
// @log 4
// @log 4
// @log 4
// A record holding a map of un-annotated functions, returned from a lambda with a block or an
// expression body, types its field at the call's binding, inside a function too (D9250).
function inc0(a) { return a + 1 }
const hm = Map()
hm["k"] = inc0
const mk = () => {
  return { m: hm }
}
const v = mk()
const x = v.m["k"]
if x != null { print(x(3)) }
const mk2 = () => ({ m: hm })
const v2 = mk2()
const x2 = v2.m["k"]
if x2 != null { print(x2(3)) }
function use() {
  const mk3 = () => {
    return { m: hm }
  }
  const w = mk3()
  const y = w.m["k"]
  if y != null { print(y(3)) }
}
use()
