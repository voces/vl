// @run
// @log 11
// @log 22
// @log 33
// @log 44
// @log 55
// @log 66
// @log 77
// @log 88
// @log 99
// @log 110
// @log 121
// @log 132
// @log 132
// @log 143
// @log 154

// @hint redundant type annotation: `f` is inferred as `(i32) => i32`
// @hint redundant type annotation: `mv` is inferred as `((i32) => i32) | null`
// @hint redundant type annotation: `v` is inferred as `(i32) => i32`
// @hint redundant type annotation: `xs` is inferred as `((i32) => i32)[]`
// @hint redundant type annotation: `v` is inferred as `(i32) => i32`
// @hint redundant type annotation: `v` is inferred as `(i32) => i32`

// D1608's position matrix as a fixture: one captured-closure call per delivery position the
// value can reach a frame through, since a capability enforced in one place is served in many
// and a fix wired at one boundary ships the rest silently. Each block has its own addend, so
// a call that reached a neighbouring block's env prints a wrong number rather than passing.

// The three container reads are annotated on purpose and the annotation is load-bearing: the
// un-annotated spelling of each still refuses, because `captureValKind` types an un-annotated
// env field through `letInitCellKind`, which has no arm for a field, element or map read.
// That residue is D1621.

// Each of those annotations carries a redundant-annotation hint, declared above: the hint is
// the checker agreeing about the TYPE, and deleting the annotation it calls redundant turns
// the block back into `emitProgram: call to unknown function`. The generator for this file is
// `scripts/capability-probes/matrix/closure-delivered-then-captured.matrix.vl`.

// The closure arrives as a parameter of the frame that captures it.
function atArgument(f: (i32) => i32) {
  const g = (n: i32) => f(n)
  print(g(10))
}

atArgument((n: i32) => n + 1)

// A reassigned function-local `let` — `emitAssign`'s `local.set` arm.
function atLocalAssign() {
  let f: (i32) => i32 = (n: i32) => n + 0
  f = (n: i32) => n + 2
  const g = (n: i32) => f(n)
  print(g(20))
}

atLocalAssign()

// Read back out of a function-valued map, narrowed, then captured.
function atMapValue() {
  const m: { [string]: (i32) => i32 } = Map()
  m["k"] = (n: i32) => n + 3
  const mv: ((i32) => i32) | null = m["k"]
  if mv != null {
    const g = (n: i32) => mv(n)
    print(g(30))
  }
}

atMapValue()

// Read back off a struct field, bound, then captured by name.
function atStructField() {
  const w = { f: (n: i32) => n + 4 }
  const v: (i32) => i32 = w.f
  const g = (n: i32) => v(n)
  print(g(40))
}

atStructField()

// Read back out of a closure array, then captured.
function atArrayElement() {
  const xs: ((i32) => i32)[] = [(n: i32) => n + 5]
  const v: (i32) => i32 = xs[0]
  const g = (n: i32) => v(n)
  print(g(50))
}

atArrayElement()

// The same element delivered by `.push`, which is its own lowering.
function atArrayPush() {
  const xs: ((i32) => i32)[] = []
  xs.push((n: i32) => n + 6)
  const v: (i32) => i32 = xs[0]
  const g = (n: i32) => v(n)
  print(g(60))
}

atArrayPush()

// What a function hands back, bound, then captured.
function deliverSeven(): (i32) => i32 { return (n: i32) => n + 7 }

function atReturn() {
  const v = deliverSeven()
  const g = (n: i32) => v(n)
  print(g(70))
}

atReturn()

// The value crosses two frames before the call: the env chain, not one hop.
function atCaptureOfCapture() {
  const v = (n: i32) => n + 8
  const outer = () => {
    const g = (n: i32) => v(n)
    print(g(80))
  }
  outer()
}

atCaptureOfCapture()

// The early-return guard: a narrowing that applies to the rest of the block, not to a branch.
function atEarlyReturnGuard(f: ((i32) => i32) | null) {
  if f == null {
    print(0)
    return 0
  }
  const g = (n: i32) => f(n)
  print(g(90))
  0
}

atEarlyReturnGuard((n: i32) => n + 9)

// A module-scope block: the one enclosing scope that is neither the module's globals nor a
// function frame, so its `const` is a local a lambda genuinely captures.
if true {
  const v = (n: i32) => n + 10
  const g = (n: i32) => v(n)
  print(g(100))
}

// The same inside a `while`, run once.
let once = 0

while once < 1 {
  const v = (n: i32) => n + 11
  const g = (n: i32) => v(n)
  print(g(110))
  once = once + 1
}

// Two instances in one module: two frames, two closures, one interned `$fnsig`.
function firstInstance() {
  const v = (n: i32) => n + 12
  const g = (n: i32) => v(n)
  print(g(120))
}

function secondInstance() {
  const v = (n: i32) => n + 12
  const g = (n: i32) => v(n)
  print(g(120))
}

firstInstance()
secondInstance()

// A module GLOBAL read inside the lambda — a global is deliberately not a capture, so this
// control must keep taking the global path.
const globalAdd13 = (n: i32) => n + 13

function atGlobal() {
  const g = (n: i32) => globalAdd13(n)
  print(g(130))
}

atGlobal()

// The captured STRUCT's field called directly, with no intermediate binding: the neighbour
// that already ran, and the one a capture rung above the local rungs would have taken.
function atStructFieldDirect() {
  const w = { f: (n: i32) => n + 14 }
  const g = (n: i32) => w.f(n)
  print(g(140))
}

atStructFieldDirect()
