// @run
// @log 3
// @log 5
// @log s
// @log 1.5
// @log true
// @log 310
// A list of generics handed, with one of its own elements, to a helper that pushes the element
// back onto it, then called through its elements at two types: the list holds its set's ids, so
// each call takes the member's own instance (D15491).
function k1<T>(x: T): T { x }
function k2<T>(x: T): T { x }
// An un-annotated helper.
function putU(xs, x) { xs.push(x) }
const v = [k1, k2]
putU(v, v[1])
print(v.length)
print(v[2](5))
print(v[0]("s"))
// A generic one, `T[]` beside `T`.
function put<T>(xs: T[], x: T) { xs.push(x) }
const w = [k1, k2]
put(w, w[0])
print(w[2](1.5))
print(w[1](true))
// Hole functions, called at one type.
function hinc(a) { a + 1 }
function hdbl(a) { a * 2 }
const h = [hinc, hdbl]
putU(h, h[1])
print(h.length * 100 + h[2](5))
