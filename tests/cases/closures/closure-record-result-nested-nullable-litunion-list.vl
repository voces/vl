// @run
// @log 1
// @log 1
// @log 1
// @log 2
// @log b
// @log 1
// @log 2
// @log b
// @log 2
// A closure's record result whose field nests a nullable literal-union list builds at the
// record's row however its spellings differ: the inner lists' element keys name one heap
// (D10770). Returned, passed as an argument, and bound, at two and three list levels.
type R = { f: ("a" | "b" | null)[][], n: i32 }
function make(): () => { f: ("a" | "b" | null)[][], n: i32 } {
  return () => ({ f: [["a"]], n: 1 })
}
function call(g: () => { f: (null | "a" | "b")[][][], n: i32 }) { return g() }
const r = make()()
print(r.n)
print(r.f[0].length)
const q = call(() => ({ f: [[["a", null]]], n: 1 }))
print(q.n)
print(q.f[0][0].length)
const g: () => { f: ("a" | "b" | null)[][], n: i32 } = () => ({ f: [["a", null, "b"]], n: 1 })
const s = g()
print(s.f[0][2] ?? "none")
const xs: R[] = [r, { f: [[null]], n: 2 }]
print(xs[0].n)
print(xs[1].n)
r.f[0][0] = "b"
r.f[0].push("a")
print(xs[0].f[0][0] ?? "none")
print(r.f[0].length)
