// @error cannot assign i32 to 'y' of type string
// A re-pointed `let` of un-annotated functions handed to a generic closes its result at the
// bodies' type, so an `i32` result does not fit a `string` destination (D9001).
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function ap<T, R>(k: (a: T) => R, x: T): R { return k(x) }
let f = inc0
if [1].length > 0 { f = dbl }
const y: string = ap(f, 5)
print(y)
