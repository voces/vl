// @error cannot write a lambda to an element of 'fs': a call through it at (i32, i32) runs it, and it takes `string` at parameter 2
// A write through a record field holding the list writes the list's own element, so a call
// through the list judges it (D12239).
function pick<A, B>(a: A, b: B): A { a }
const fs = [pick]
const m = { xs: fs }
m.xs[0] = (x, y: string) => x
print(fs[0](1, 2))
