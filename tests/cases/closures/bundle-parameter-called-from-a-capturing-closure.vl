// @log 4
// @log 4
// @log 3.5
// @log 13
// @log 12.5
// @log 30
// @log 25
// @log 13
// @log 12.5
// @log s
// @log 30
// @log 25
// @log true
// @log 13
// @log 12.5
// @log u
// @log 30
// @log 25
// @log v
// A lambda called at two signatures through a parameter, one of the calls made from a closure that
// captures the parameter: the closure reads the one record of its closures, at each instance of
// the function that captured it.
function lapCaptured(f) {
  print(f(3))
  const h = () => f(2.5)
  print(h())
}
function twoClosures(f) {
  const h = () => f(2.5)
  print(h())
  const j = () => f(3)
  print(j())
}
function stored(f) {
  print(f(3))
  const hs = [() => f(2.5)]
  print(hs[0]())
}
function go(k: i32) {
  lapCaptured((a) => a + k)
  twoClosures((a) => a + k)
  stored((a) => a + k)
}
go(1)
function twice(k: i32) {
  lapCaptured((a) => a + k)
  lapCaptured((a) => a * k)
}
twice(10)
function lapIn<T>(f, t: T) {
  print(f(3))
  const h = () => f(2.5)
  print(h())
  print(t)
}
function generic(k: i32) {
  lapIn((a) => a + k, "s")
  lapIn((a) => a * k, true)
  lapIn((a) => a + k, "u")
  lapIn((a) => a * k, "v")
}
generic(10)
