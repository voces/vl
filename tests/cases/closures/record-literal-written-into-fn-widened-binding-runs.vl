// @run
// @log 2
// @log 2.5
// @log 4
// @log 4.5
// @log 3
// @log 5
// @log x
// @log 6
// @log 6.5
// A record literal written whole into a `let` whose function field the writes widen is built at
// the binding's record, beside the initialiser, so every write's function is a member of the
// field's set (D15306). Nested records and a write under an `if` are the same binding.
function id1(a) { return a }
function id2(a) { return a }
function id3(a) { return a }
let r = { f: id1 }
r = { f: id2 }
print(r.f(2))
print(r.f(2.5))
let s = { f: id1, n: 1 }
s = { f: id2, n: 2 }
s = { f: id3, n: 3 }
print(s.f(4))
print(s.f(4.5))
print(s.n)
let t = { g: { f: id1 } }
t = { g: { f: id2 } }
print(t.g.f(5))
print(t.g.f("x"))
let u = { f: id1 }
if s.n > 0 { u = { f: id2 } }
print(u.f(6))
print(u.f(6.5))
