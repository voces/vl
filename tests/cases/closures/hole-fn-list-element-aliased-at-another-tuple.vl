// @run
// @log 1.5
// @log 1
// A hole function called through a list element at `f64` and through an alias of that element
// at `i32` runs at each call's own tuple, so the list is not built at the first call's type.
function h(a) { a / 2 }
const xs = [h]
print(xs[0](3.0))
const g = xs[0]
print(g(3))
