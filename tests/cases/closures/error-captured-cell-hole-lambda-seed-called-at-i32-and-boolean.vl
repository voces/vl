// @emit-error the reassigned function binding `k` holds functions called at more than one argument type
// A cell seeded with a hole lambda and called at `i32` and then at `boolean` holds one closure
// signature, which the second call does not have, though both share a representation (D3950).
function other<V>(v: V) { print("O"); print(v) }
function main() {
  let k = (x) => {
    print("L"); print(x)
  }
  const flip = () => {
    k = other
  }
  k(1)
  flip()
  k(true)
}
main()
