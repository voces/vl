// @run
// @log 6
// @log 10
// @log -5
// @log 4
// @log 6
// @log 8
// @log 2
// @log 2
// @log 10
// @log 4
// @log 6
// @log 8
// Records whose function fields hold named functions, in lists of differing function sets, in
// map values beside a capturing lambda, and in an unannotated list of records of function lists.
type R = { f: (i32) => i32 }
type S = { fs: ((i32) => i32)[], x: i32 }
function inc(x: i32) { x + 1 }
function dbl(x: i32) { x * 2 }
function neg(x: i32) { 0 - x }
const xs: R[] = [{ f: inc }, { f: dbl }]
const ys: R[] = [{ f: neg }]
for r in xs { print(r.f(5)) }
for r in ys { print(r.f(5)) }
const a: S[] = [{ fs: [inc, dbl], x: 3 }]
const b: S[] = [{ fs: [dbl], x: 4 }]
for s in a {
  for f in s.fs { print(f(s.x)) }
}
for s in b {
  for f in s.fs { print(f(s.x)) }
}
const m = Map()
m["a"] = { f: inc }
const n = Map()
n["b"] = { f: dbl }
const k = 9
const o = Map()
o["c"] = { f: (x: i32): i32 => x + k }
const ma = m["a"]
const nb = n["b"]
const oc = o["c"]
if ma != null { print(ma.f(1)) }
if nb != null { print(nb.f(1)) }
if oc != null { print(oc.f(1)) }
const c = [{ gs: [inc, dbl], y: 3 }]
const d = [{ gs: [dbl], y: 4 }]
for t in c {
  for g in t.gs { print(g(t.y)) }
}
for t in d {
  for g in t.gs { print(g(t.y)) }
}
