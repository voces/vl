// @run
// @log 2.5
// @log 3
// @hint Intentionally-unused variable `_a` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_b` (leading `_` marks it unused)
// @hint Intentionally-unused function `__mkd` (leading `_` marks it unused)
// An uncalled maker returning a hole lambda, beside a function returning a bundle record: its
// result is the closure its `return` builds, whatever the lambda's signature (D17579).
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
const h = lap((a) => a + 1)
print(h(1.5))
print(h(2))
function __mkd() { return (a) => a * 2 }
