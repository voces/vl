// @error cannot store 'half' in 'v[].f': called at (i32) it returns f64, where 'inc0', also stored in it, returns i32
// A list literal of records whose function field holds functions of different results, handed
// to an un-annotated parameter and called through, is refused at check rather than trapping:
// the instance reads the elements at the parameter's one type (D15802).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function take(v) { print(v[1].f(3)) }
take([{ f: inc0 }, { f: half }])
