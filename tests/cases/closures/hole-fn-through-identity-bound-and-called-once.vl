// @log 3
// @log 4
// @log true
// @log ab
// @log ab
// D15039: a binding of a hole function returned through a hole identity and called only through
// that binding holds the member's id its tagged set calls through, at module scope and in a body.
function fw(f) { return f }
function add(a, b) { return a + b }
function id(x) { return x }
const p = fw(add)
print(p(1, 2))
const q = fw(add)
print(q(1.5, 2.5))
const r = fw(id)
print(r(true))
const s = fw(add)
function h() { print(s("a", "b")) }
h()
function m() {
  const t = fw(add)
  print(t("a", "b"))
}
m()
