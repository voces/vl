// @run
// @log ss
// @log 4
// @log 6
// @log 8
// @log 10
// @log 12
// @log 2
// An inferred list of a function set copied into a readonly list held by a record field, a list
// element or a reassigned binding: each copy is a fresh list of adapters, so its holder holds no
// id (D15132).
type Holder = { f: readonly ((x: i32) => i32)[] }
function id<T>(x: T): T { return x }
function dbl<T>(x: T): T { return x + x }
function reassigned(zs: readonly ((x: i32) => i32)[]) {
  let v: readonly ((x: i32) => i32)[] = zs
  v = zs
  print(v[0](1))
}
let f = id
f = dbl
print(f("s"))
const zs = [f]
let v: readonly ((x: i32) => i32)[] = zs
v = zs
print(v[0](2))
const h: Holder = { f: zs }
print(h.f[0](3))
const h2: Holder = { f: [] }
h2.f = zs
print(h2.f[0](4))
const ls: (readonly ((x: i32) => i32)[])[] = [zs]
print(ls[0][0](5))
const ls2: (readonly ((x: i32) => i32)[])[] = [[]]
ls2[0] = zs
print(ls2[0][0](6))
reassigned(zs)
