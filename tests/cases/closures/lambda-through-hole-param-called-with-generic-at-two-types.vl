// @run
// @info `lap2` is never reassigned; use `const` instead of `let`
// @log 2
// @log s
// @log 2
// @log t
// A hole parameter handed a lambda by name at every call is that lambda, so a generic it hands
// on is called at both of the lambda's types, for a `const` and for an unwritten `let` (D6481).
function id(a) { return a }
const lap = (g) => {
  print(g(1) + 1)
  return g("s")
}
function use(k) { return k(id) }
print(use(lap))
let lap2 = (g) => {
  print(g(1) + 1)
  return g("t")
}
function use2(k) { return k(id) }
print(use2(lap2))
