// @run
// @log 2
// @log NUL
// @log 2
// @log NUL
// @log 2
// @log NUL
// @log 2
// @log NUL
// @log 2
// @log NUL
// @log 2
// @log NUL
// @log 2
// @log NUL
// @log FN
// @log NUL
// @hint redundant type annotation: `v` is inferred as `string[] | null`
// THE `: string[] | null` THE HINT NAMES IS THE ANNOTATED HALF OF A PAIR. `captureValKind`
// types an annotated env field off the annotation (`vtKindOfType`) and an un-annotated one
// off `letInitCellKind`; until #1935 that second ladder named ONE nullable kind, so deleting
// the annotation here turned the case into a loud reject (D21). Both halves run now, and the
// UN-annotated spellings of these same reps are pinned in
// `capture-unannotated-nullable-reps.vl` — this file is that file's control. Keep the
// annotation: two files, two storage sub-classes, and the hint is what says they differ.
// A nullable NICHE read through the CAPTURE storage class — the fourth storage class the
// niche classifiers have, after param / declared local / global.
//
// The null TEST for every niche has one home (`emitNulIsNullTest`), and its ladder is a
// disjunction of the per-rep `expr*` classifiers. Three of those resolved an Ident through
// param / local / global only, so a captured cell reached the fall-through and the compare's
// bare `null` arrived at `emitNulLitNode` with no rep seeded: `bare null needs a struct-typed
// context` for `!=`/`==`/`while`, and `` `is` test but no union type declared `` for the `is`
// and `match` spellings of the same question — one axis, two messages, which is why grouping
// this family by its message text splits it.
//
// The capture channel each arm now asks (`capturedKindOf`) is `captureValKind` on the parent
// frame — the ladder that TYPED the env field — so the read and the field cannot disagree
// about the wrapper. `i32[] | null` (`exprNullableList`) and `S[] | null`
// (`exprNullableRefArray`) already had that arm and are the working controls this was built
// against, arm for arm.
//
// Both capture SPELLINGS are here because they lift differently at the source level and must
// not diverge: a NAMED nested function and a lambda bound to a const. Nested function names
// are distinct across the file on purpose — capture analysis is name-keyed module-wide, and
// two same-named inner functions report `captured variable not found in enclosing frame`.

// `string[] | null` — `exprNulScalarListKind`, the leaf list with its own wrapper heap type.
function strListCap(p: string[] | null) {
  function readStrList() {
    if p != null { print(p.length) } else { print("NUL") }
  }
  readStrList()
}

strListCap(["a", "b"])
strListCap(null)

// `f64[] | null` — the same leaf family, a different wrapper.
function f64ListCap(p: f64[] | null) {
  function readF64List() {
    if p == null { print("NUL") } else { print(p.length) }
  }
  readF64List()
}

f64ListCap([1.25, 2.5])
f64ListCap(null)

// `i64[] | null`, narrowed by `is` rather than by a null comparison: the SAME ladder read
// through the `nicheOnly` caller, which reports the other message.
function i64ListCap(p: i64[] | null) {
  function readI64List() {
    if p is i64[] { print(p.length) } else { print("NUL") }
  }
  readI64List()
}

i64ListCap([10, 20])
i64ListCap(null)

// A LAMBDA capture of the same niche, and a `match` narrowing — the third spelling of the
// null question, over the fourth storage class.
function strListLambda(p: string[] | null) {
  const readIt = () => match p {
    null => "NUL"
    _ => "2"
  }
  print(readIt())
}

strListLambda(["a", "b"])
strListLambda(null)

// A capture that crosses TWO frames: the cell flows env-to-env, and the innermost read still
// resolves the niche.
function strListTwoDeep(p: string[] | null) {
  function midFrame() {
    function deepFrame() {
      if p != null { print(p.length) } else { print("NUL") }
    }
    deepFrame()
  }
  midFrame()
}

strListTwoDeep(["a", "b"])
strListTwoDeep(null)

// The capture of an annotated LOCAL rather than of a param — the other binding form
// `capturedBindingOf` resolves, and the one the `while` guard is spelled over here.
function strListLocalCap() {
  const v: string[] | null = mkStrList(true)
  function readLocal() {
    let n = 0
    while v != null && n < 1 {
      print(v.length)
      n = n + 1
    }
    if n == 0 { print("NUL") }
  }
  readLocal()
}

function mkStrList(present: boolean): string[] | null {
  if present { return ["a", "b"] }
  null
}

strListLocalCap()

function strListLocalCapNull() {
  const v: string[] | null = mkStrList(false)
  function readLocalNull() {
    let n = 0
    while v != null && n < 1 {
      print(v.length)
      n = n + 1
    }
    if n == 0 { print("NUL") }
  }
  readLocalNull()
}

strListLocalCapNull()

// `string | null` at a `.length` READ. Its null test was already claimed
// (`exprNullableString` has the capture arm), so this pins the OTHER consumer: `exprString`
// knew the `str` capture kind and not the `nulstr` one, while `declaredString` /
// `paramString` claim both — the rule being that a `string | null` cell reads AS a string for
// string ops, because the checker gates those on the narrowed branch. Without the second kind
// the read fell to the struct path: `field access but no struct type declared`.
function nulStrLenCap(p: string | null) {
  function readStrLen() {
    if p != null { print(p.length) } else { print("NUL") }
  }
  readStrLen()
}

nulStrLenCap("aa")
nulStrLenCap(null)

// `((i32) => i32) | null` — the closure niche, the sixth rep of this family. Only the null
// TEST is pinned here, and deliberately so: CALLING a captured closure is a separate gap that
// fails for a NON-nullable `(i32) => i32` capture too (`call to unknown function`), so it is
// not this axis and a call in this case would pin the wrong defect.
function nulCloCap(p: ((i32) => i32) | null) {
  function readNulClo() {
    if p != null { print("FN") } else { print("NUL") }
  }
  readNulClo()
}

nulCloCap((x) => x + 1)
nulCloCap(null)
