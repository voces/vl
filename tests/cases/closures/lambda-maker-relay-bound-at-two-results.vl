// @run
// @log 4
// @log 0.5
// @log 1
// @log 2
// @log 4
// @log 0.5
// A relay that binds a maker's hole lambda and returns the binding, with or without a parameter,
// is built per delivered result as the direct relay is (D16771).
function deliver() { return (a) => a + 1 }
function relay() {
  const f = deliver()
  return f
}
function relayAt(n: i32) {
  const f = deliver()
  print(n)
  return f
}
const v: (a: i32) => i32 = relay()
const w: (a: i32) => f64 = relay()
print(v(3))
print(w(3) / 8.0)
const v2: (a: i32) => i32 = relayAt(1)
const w2: (a: i32) => f64 = relayAt(2)
print(v2(3))
print(w2(3) / 8.0)
