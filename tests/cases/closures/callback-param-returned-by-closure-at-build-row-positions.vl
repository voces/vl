// A closure inside a list callback that returns the callback's parameter, held at the list's build
// row, is built at that row, signature included: its result read at once, bound first, from a
// `map` callback, two closures deep, and inside a function.
type J = { f: i32 | null }
function mk2() { return { f: null } }
const dA: J = mk2()
const src = [mk2()]
const r = src.filter((y) => {
  const e = () => y
  print(e().f)
  const v = e()
  print(v.f)
  const h = { w: y }
  return true
})
print(r.length)
const n = src.map((y) => {
  const e = () => y
  return e().f == null
})
print(n[0])
const d = src.filter((y) => {
  const e = () => {
    const g = () => y
    return g()
  }
  print(e().f)
  return true
})
print(d.length)
function inFn() {
  const s2 = [mk2()]
  const k = s2.filter((y) => {
    const e = () => y
    print(e().f)
    return true
  })
  print(k.length)
}
