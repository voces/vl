// @run
// @hint Intentionally-unused parameter `_x`
// @hint Intentionally-unused parameter `_x`
// @log 4
// @log 0.5
// @log 0.5
// @log 0.75
// @log 4
// @log 0.5
// A generic or hole-parameter relay of a maker's hole lambda, each instance delivered at its own
// function type, builds each instance's maker call at that result (D16808).
function deliver() { return (a) => a + 1 }
function wrap<T>(_x: T) { return deliver() }
const v: (a: i32) => i32 = wrap(1)
const w: (a: i32) => f64 = wrap("s")
print(v(3))
print(w(3) / 8.0)
const w1: (a: i32) => f64 = wrap(true)
const w2: (a: i32) => f64 = wrap(2.5)
print(w1(3) / 8.0)
print(w2(5) / 8.0)
function hole(_x) { return deliver() }
const h1: (a: i32) => i32 = hole(1)
const h2: (a: i32) => f64 = hole("s")
print(h1(3))
print(h2(3) / 8.0)
