// @log 3
// @log 0
// @log 3
// @log 3
// @log 4
// A lambda nested in a function with an un-annotated parameter reads that function's names where
// a typed destination inside it pins the parameter: a result annotation, a binding's function
// type, an unused typed parameter, an annotated local, an alias of the parameter, and a lambda
// never called. Each is built under the enclosing instance, as the unpinned spellings are.
function ann(y) {
  const b = (): i32 => y
  return b()
}
function block(y) {
  const b = (): i32 => {
    return y
  }
  return b()
}
function bound(y) {
  const b: () => i32 = () => y
  return b()
}
function unused(y) {
  const b = (_x: i32): i32 => y
  return b(1)
}
function local(y) {
  const b = () => {
    const t: i32 = y
    return t
  }
  return b()
}
function alias(y) {
  const z = y
  const b = (): i32 => z
  return b()
}
function uncalled(y) {
  const _b = (): i32 => y
  return 0
}
function twice(y) {
  const b = (): i32 => y
  return b()
}
function sum(y) {
  const b = (x: i32): i32 => y + x
  return b(1)
}
print(ann(3))
print(block(3))
print(bound(3))
print(unused(3))
print(local(3))
print(alias(3))
print(uncalled(3))
print(twice(3))
print(twice(3))
print(sum(3))
