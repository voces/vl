// @run
// @log 6
// @log 3
// A lambda capturing a hole lambda's parameter, in a function instanced at two types, holds its
// own instance only at the types its enclosing instance calls it at (D12235).
function two(a: i32, b: (n: i32) => i32) { b(a) }
function twof(a: f64, b: (n: f64) => f64) { b(a) }
function outer(h, x) {
  return h(x, (n) => {
    const g = (m) => m + n
    return g(n)
  })
}
print(outer(two, 3))
print(outer(twof, 1.5))
