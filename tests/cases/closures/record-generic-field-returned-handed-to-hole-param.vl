// @run
// @log 1
// @log z
// @log true
// @log 7
// @log 2.5
// @log 7
// @log 9
// @log w
// A record holding a generic, returned by a function and handed to a hole parameter that calls
// the field at another type, holds the set's id as a bound record does (D15430).
function k<T>(x: T): T { return x }
const r = { f: k, g: 7 }
function get() { return r }
function show(o) { print(o.f(true)); print(o.g) }
print(r.f(1))
print(r.f("z"))
show(get())
function show2(o) { const q = o; print(q.f(2.5)); print(q.g) }
show2(get())
function call9(o) { print(o.f(9)) }
call9(get())
const xs = [get()]
print(xs[0].f("w"))
