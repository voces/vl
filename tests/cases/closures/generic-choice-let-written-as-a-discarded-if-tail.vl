// @run
// @log 31
// @log d
// @log same
// @log 32
// @log same
// @log e
// @log 33
// @log f
// @log same
// @log 34
// @log same
// @log g
// A `let` of a call returning one of two generics, written with another such call as the last
// statement of an `if` whose value is discarded: the write stores the set's id, and each call
// selects its instance.
function id<T>(x: T): T { x }
function same<T>(x: T): T {
  print("same")
  x
}
function pick(n: i32) {
  if n > 1 { return id }
  return same
}
let j = pick(5)
print(j(31))
print(j("d"))
if [1].length > 0 { j = pick(0) }
print(j(32))
print(j("e"))
function run() {
  let k = pick(0)
  if [1].length > 5 {
    print(0)
  } else {
    if true { k = pick(5) }
  }
  print(k(33))
  print(k("f"))
  if [1].length > 0 { k = pick(0) } else { print(1) }
  print(k(34))
  print(k("g"))
}
run()
