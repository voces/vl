// @run
// @log 1
// @log 4
// @log 4
// @log 4
// @log 4
// A record holding a map of un-annotated functions stored as a map value is read through a
// `const` bound to the value, or to that `const`, by `[]`, `.set`/`.get` or inside a function
// (D9183).
function inc0(a) { return a + 1 }
const hm = Map()
hm["k"] = inc0
const mm = Map()
mm["k"] = { m: hm }
print(mm.length)
const v = mm["k"]
if v != null {
  const x = v.m["k"]
  if x != null { print(x(3)) }
}
const sm = Map()
sm.set("k", { m: hm })
const sv = sm.get("k")
if sv != null {
  const w = sv
  const y = w.m["k"]
  if y != null { print(y(3)) }
}
function run() {
  const lm = Map()
  lm["k"] = inc0
  const rm = Map()
  rm["k"] = { m: lm }
  const r = rm["k"]
  if r != null {
    const z = r.m["k"]
    if z != null { print(z(3)) }
  }
}
run()
const am = Map()
am["k"] = { m: hm }
const av = am["k"]
if av != null {
  const a2 = av
  const a3 = a2.m["k"]
  if a3 != null { print(a3(3)) }
}
