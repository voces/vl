// @run
// @log B
// @log 2
// @log B
// @log true
// A written `let` of generics copied into another written `let`, each called at its own type: the
// copy carries every slot the target is called at (D4240, D3975).
function gA<U>(u: U) {
  print("A")
  print(u)
}
function gB<V>(v: V) {
  print("B")
  print(v)
}
let f = gA
let g = gB
f = gB
g = f
f(2)
g(true)
