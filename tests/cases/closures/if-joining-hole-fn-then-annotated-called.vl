// @run
// @log 2
// @log 20
// @log 21
// @log 3
// @log 40
// @log 20
// @log 20
// An `if` or `match` value joining a hole function with an annotated function, the hole
// function first, takes the annotated type and instances the hole function at it (D10797).
function apply2(g: (a: i32) => i32) { print(g(2)) }
function apply3(g) { print(g(20)) }
function id(a: i32) { return a }
function pick(b: boolean) {
  const f = if b { apply3 } else { apply2 }
  f((a) => a + 1)
}
let b = false
const f = if b { apply3 } else { apply2 }
f(id)
b = true
const g = if b { apply3 } else { apply2 }
g(id)
pick(true)
pick(false)
apply3((x) => x * 2)
const fs = [apply3, apply2]
fs[0](id)
const m = match 1 {
  1 => apply3
  _ => apply2
}
m(id)
