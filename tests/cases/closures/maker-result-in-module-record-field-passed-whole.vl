// @run
// @log 1
// @log z
// @log 7
// @log 1
// @log z
// @log 7
// @log 8
// @log 1
// @log z
// @log true
// @log 7
// @log 1
// @log z
// @log 7
// A maker's generic result in a record field, called at two types, runs when the whole record
// is also handed on where that field is never read: to an un-annotated parameter, forwarded
// again, or bound to a `const` (D6371). Also read by two functions, at three types, and held.
function k<T>(x: T): T { return x }
function mk() { return k }
function show(o) { print(o.g) }
const r = { f: mk(), g: 7 }
print(r.f(1))
print(r.f("z"))
show(r)
function show2(p) { print(p.g) }
function fwd(o) { show2(o) }
function show3(o) { print(o.g + 1) }
const r2 = { f: mk(), g: 7 }
print(r2.f(1))
print(r2.f("z"))
fwd(r2)
show3(r2)
const r3 = { f: mk(), g: 7 }
print(r3.f(1))
print(r3.f("z"))
print(r3.f(true))
const q = r3
print(q.g)
const m = mk()
const r4 = { f: m, g: 7 }
print(r4.f(1))
print(r4.f("z"))
show(r4)
