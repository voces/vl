// @run
// @log aE
// @log 3
// @log 1.5
// @log false
// @log v
// @log LC
// @log nE
// @hint Intentionally-unused variable `_g` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_g` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_g` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_g` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_g` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_g` (leading `_` marks it unused)
// A function whose tail is a call through a capture cell (`d[0](x)`) returns that call's value:
// the cell's list type names the element's function type, which the rewrite's untyped read
// does not (D3846). Each result type, a hole lambda, a void cell, a lambda tail, and a cell a
// nested function writes.
function hole(x: string) {
  const c = (y) => y + "C"
  const e = (y) => y + "E"
  let d = c
  const _g = () => d(x)
  d = e
  d(x)
}
print(hole("a"))
function int(x: i32) {
  const c = (y: i32) => y + 1
  const e = (y: i32) => y + 2
  let d = c
  const _g = () => d(x)
  d = e
  d(x)
}
print(int(1))
function float(x: f64) {
  const c = (y: f64) => y + 0.5
  let d = c
  const _g = () => d(x)
  d = c
  d(x)
}
print(float(1.0))
function bool(x: boolean) {
  const c = (y: boolean) => !y
  let d = c
  const _g = () => d(x)
  d = c
  d(x)
}
print(bool(true))
function voidCell(x: string) {
  const c = (y: string) => {
    print(y)
  }
  let d = c
  const _g = () => d(x)
  d = c
  d(x)
}
voidCell("v")
function inLambda(x: string) {
  const c = (y: string) => y + "C"
  let d = c
  const _g = () => d(x)
  d = c
  const h = () => d(x)
  h()
}
print(inLambda("L"))
function nestedWriter(x: string) {
  const c = (y: string) => y + "C"
  const e = (y: string) => y + "E"
  let d = c
  function w() { d = e }
  w()
  d(x)
}
print(nestedWriter("n"))
