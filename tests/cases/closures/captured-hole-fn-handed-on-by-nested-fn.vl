// @run
// @log 3
// @log 3
// @log 3
// @log 3
// @log 3
// @log 0.5
// @log 3
// @log 3
// @log 2.25
// A lambda or nested function handing on a hole function it captures reads the pin the
// enclosing instance's parameter took, as a direct call in that body does (D13660).
function add(a, b) { return a + b }
function addF(a: f64, b: f64) { return a + b }
function mulF(a: f64, b: f64) { return a * b }
function apply2(g, s) { print(g(s, s)) }
function apply2r(g, s) { return g(s, s) }
function viaLambda(h) {
  const run = (x) => {
    apply2(h, x)
  }
  run(1.5)
}
viaLambda(add)
// The enclosing parameter annotated.
function viaAnnotated(h: (a: f64, b: f64) => f64) {
  const run = (x) => {
    apply2(h, x)
  }
  run(1.5)
}
viaAnnotated(add)
// A named nested function, and a lambda inside a lambda.
function viaNested(h) {
  function run(x) { apply2(h, x) }
  run(1.5)
}
viaNested(add)
function viaTwoDeep(h) {
  const run = (x) => {
    const inner = (y) => {
      apply2(h, y)
    }
    inner(x)
  }
  run(1.5)
}
viaTwoDeep(add)
// A result delivered to a print and to an annotated binding.
function viaResult(h) {
  const run = (x) => apply2r(h, x)
  print(run(1.5))
  const r: f64 = run(0.25)
  print(r)
}
viaResult(add)
// The capture is an un-annotated binding of the parameter.
function viaAlias(h) {
  const k = h
  const run = (x) => {
    apply2(k, x)
  }
  run(1.5)
}
viaAlias(add)
// Two instances, each with its own pin.
function viaTwo(h) {
  const run = (x) => {
    apply2(h, x)
  }
  run(1.5)
}
viaTwo(addF)
viaTwo(mulF)
