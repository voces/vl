// @run
// @hint Intentionally-unused parameter `_a`
// @hint Intentionally-unused parameter `_b`
// @info `k2` is never reassigned; use `const` instead of `let`
// @info `k3` is never reassigned; use `const` instead of `let`
// @info `e2` is never reassigned; use `const` instead of `let`
// @log W
// @log 6
// @log false
// @log W
// @log 8
// @log true
// @log W
// @log 7
// @log true
// @log S
// A `let` initialised with a copy of a written binding holding a generic with a fixed union
// parameter: a call through the copy, a delivery of it to an annotated parameter and a call
// through a copy of the copy each reach the adapted write; a copy taken before the write holds
// the initializer (D5160).
function s<A, B>(_a: A, _b: B) { print("S") }
function w<B>(a: i32 | string, b: B) {
  print("W")
  print(a)
  print(b)
}
function call(f: (a: i32, b: boolean) => void) { f(8, true) }
function main() {
  let k = s
  k = w
  let k2 = k
  k2(6, false)
  call(k2)
  let k3 = k2
  k3(7, true)
  let e = s
  let e2 = e
  e = w
  e2(9, false)
}
main()
