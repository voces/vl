// @run
// A literal list of hole functions both called through an index and read as a value: the value
// read delivers every element, the one no index call reaches included.
function inc6(a) { return a + 1 }
function dbl(a) { return a * 2 }
function apN(f) { return f(5) }
const gs = [inc6, dbl]
print(gs[1](2))
print(gs.map(apN)[0])
function take(xs) { return xs[0](3) }
print(take(gs))
// @log 4
// @log 6
// @log 4
