// @run
// @log 2.5
// @log 5
// @log 6 3.5
// @log s
// @log 5 2.5
// @log 7
// @log 6 3.5
// A binding holding a returned bundle's record, copied into another binding: the copy holds the
// same record, at the top level, in a function, and in a generic function's two instances.
function lap(f) {
  f(2.5)
  f(3)
  return f
}
function go(k: i32) {
  const v = lap((a) => a + k)
  const w = v
  print("\{w(4)} \{w(1.5)}")
}
function gen<T>(t: T, k: i32) {
  const v = lap((a) => a + k)
  const w = v
  print(t)
  print("\{w(4)} \{w(1.5)}")
}
const v = lap((a) => a + 1)
const w = v
print(v(1.5))
print(w(4))
go(2)
gen("s", 1)
gen(7, 2)
