// @run
// @log 1
// @log 1
// @log 1
// @log 2
// @log 0
// @log 4
// @log 7
// @log 0
// @log q
// @log 1
// @log 1
// @log 7
// @log 2
// @log 2
// An un-annotated lambda handed to a function-typed parameter takes the parameter's result as
// its own when its body's result is a collection with a hole (`Map()`) or a type the slot's rep
// refuses (`f64[]` against `f64[] | null`, `i32[]` against `u8[]`), and then builds as the annotated lambda does.
// The three calls before the `u8[]` pair are controls: the annotated lambda, a named function, and `i32[] | null`.
type R = { x: i32 }

function gm(f: () => {[string]: i32}) {
  const m = f()
  m["a"] = 4
  m.length
}
print(gm(() => Map()))

function gf(f: () => f64[] | null) {
  const r = f()
  if r == null { return 0 }
  r.length
}
print(gf(() => [1.5]))

function gs(f: () => string[] | null) {
  const r = f()
  if r == null { return 0 }
  r.length
}
print(gs(() => ["a"]))
print(gs(() => ["a", "b"]))
print(gs(() => null))

function gr(f: (x: i32) => R[] | null) {
  const r = f(4)
  if r == null { return 0 }
  r[0].x
}
print(gr((x: i32) => [{ x: x }]))
const keep: (x: i32) => R[] | null = (x: i32) => [{ x: x + 3 }]
print(gr(keep))
print(gr((x: i32) => if x > 100 { [{ x: x }] } else { null }))

function gq(f: () => {[string]: string}) {
  const m = f()
  m["k"] = "q"
  m["k"] ?? ""
}
print(gq(() => Map()))

print(gm((): {[string]: i32} => Map()))
function named(): f64[] | null { return [2.5] }
print(gf(named))
function gi(f: (x: i32) => i32[] | null) {
  const r = f(7)
  if r == null { return 0 }
  r[0]
}
print(gi((x: i32) => [x]))

function gu(f: () => u8[]) { f()[1] }
print(gu(() => [1, 2]))
const mk: () => () => u8[] = () => () => [1, 2]
print(mk()().length)
