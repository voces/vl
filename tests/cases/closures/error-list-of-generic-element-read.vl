// @emit-error a list holding a generic function is called at more than one type, or read other than by calling its elements
// A list of generic functions whose element is read into a name is not followed: the name's
// calls do not reach the list's type, so it is refused (D3977).
function inner<U>(u: U) {
  print("I")
  print(u)
}
function main() {
  const fs = [inner]
  const h = fs[0]
  fs[0](1)
  h(true)
}
main()
