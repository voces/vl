// An un-annotated function inside a list or record literal pushed, `set` or stored into an
// annotated list, map, element or field takes that destination's function type (D9340).
function inc0(u) { return u + 1 }
function inc1(u) { return u + 1 }
function inc2(u) { return u + 1 }
function inc3(u) { return u + 1 }
function inc4(u) { return u + 1 }
function inc5(u) { return u + 1 }
function inc6(u) { return u + 1 }
function half(u) { return u * 2.5 }
const xs: ((u: i32) => i32)[][] = []
xs.push([inc0])
print(xs[0][0](3))
const rs: ({f: (u: i32) => i32})[] = []
rs.push({ f: inc1 })
print(rs[0].f(3))
const m: Map<string, ((u: i32) => i32)[]> = Map()
m["k"] = [inc2]
const mk = m["k"]
if mk != null { print(mk[0](3)) }
m.set("j", [inc3])
const mj = m["j"]
if mj != null { print(mj[0](3)) }
const es: ((u: i32) => i32)[][] = [[]]
es[0] = [inc4]
print(es[0][0](3))
const r: {f: ((u: i32) => i32)[]} = { f: [] }
r.f = [inc5]
print(r.f[0](3))
const ls: ({f: ((u: i32) => i32)[]})[] = []
ls.push({ f: [inc6] })
print(ls[0].f[0](3))
const ds: ((u: f64) => f64)[][] = []
ds.push([half])
print(ds[0][0](2.0))
const ws: ((u: i32) => i32)[][] = []
ws.push([(u) => u * 3, (u) => u - 1])
print(ws[0][0](3))
print(ws[0][1](3))
// An un-annotated destination delivers at the one signature its own calls pin the slot at.
function inc7(u) { return u + 1 }
function inc8(u) { return u + 1 }
function inc9(u) { return u + 1 }
const us = [[inc7]]
us.push([inc8])
print(us[1][0](3))
const vs = [{ f: (u: i32) => u }]
vs.push({ f: inc9 })
print(vs[1].f(3))
