// @run
// @log 2
// @log 3
// @log 14
// @log true
// @log none
// A captured, reassigned `((i32) => i32) | null` narrowed non-null is called through its cell:
// as a statement, printed, in arithmetic and returned, and skipped once cleared.
function main() {
  let k: ((n: i32) => i32) | null = (n: i32) => n + 1
  const clear = () => {
    k = null
  }
  const set = () => {
    k = (n: i32) => n * 2
  }
  const ret = (): i32 => {
    if k != null { return k(3) + 1 }
    return 0
  }
  if k != null { print(k(1)) }
  if k != null { print(k(2)) }
  set()
  if k != null { print(k(5) + 4) }
  print(ret() - 0 == 7)
  clear()
  if k != null { print(k(1)) } else { print("none") }
}
main()
