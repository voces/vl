// @run
// @log 2
// @log 3
// @log 14
// @log 5
// @log 7
// @log true
// @log none
// A captured, reassigned `((i32) => i32) | null` narrowed non-null is called through its cell:
// as a statement, printed, in arithmetic, passed, bound and returned, and skipped once cleared.
function apply(g: (n: i32) => i32, v: i32) { return g(v) }
function main() {
  let k: ((n: i32) => i32) | null = (n: i32) => n + 1
  const clear = () => {
    k = null
  }
  const set = () => {
    k = (n: i32) => n * 2
  }
  const ret = (): i32 => {
    if k != null { return k(3) + 1 }
    return 0
  }
  if k != null { print(k(1)) }
  if k != null { print(k(2)) }
  set()
  if k != null { print(k(5) + 4) }
  if k != null { print(apply(k, 2) + 1) }
  if k != null {
    const h = k
    print(h(3) + 1)
  }
  print(ret() - 0 == 7)
  clear()
  if k != null { print(k(1)) } else { print("none") }
}
main()
