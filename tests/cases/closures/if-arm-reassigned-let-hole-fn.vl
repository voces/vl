// @run
// @log a!
// @log c!
// @log b!
// @log d!
// @log 42
// @log 2.5
// A value `if` arm block ending in a `let` of a hole function it reassigns delivers that
// binding: in the first arm, the second, both, under a conditional write, and returned from a
// function (D13103).
function exclaim(s) { return s + "!" }
function ask(s) { return s + "?" }
function twice(s) { return s + s }
const on = [1].length == 1
const x = if on {
  let lv = ask
  lv = exclaim
  lv
} else {
  ask
}
print(x("a"))

const z = if !on {
  ask
} else {
  let lz = twice
  if [2].length == 1 { lz = exclaim }
  lz
}
print(z("c"))

const w = if on {
  let lv = ask
  lv = exclaim
  lv
} else {
  let lw = twice
  lw = ask
  lw
}
print(w("b"))

function pick(on: boolean) {
  return if on {
    let lv = ask
    lv = exclaim
    lv
  } else {
    ask
  }
}
print(pick(on)("d"))

function inc(n) { return n + 1 }
function dbl(n) { return n * 2 }
const n = if on {
  let lv = inc
  lv = dbl
  lv
} else {
  inc
}
print(n(21))
const m = if !on { inc } else { let q = dbl; q = inc; q }
print(m(1.5))
