// @error cannot write 'str' to 'f': called at (i32) it returns string, where 'inc', also written to it, returns i32
// A re-pointed `let` a function returns, handed to a callee that calls it, is judged at the
// callee's argument types, as a call of the result is (D13966).
function inc(a) { return a + 1 }
function str(_a) { return "s" }
function sel(c: boolean) {
  let f = inc
  if c { f = str }
  return f
}
function ap(f, x) { return f(x) }
print(ap(sel(true), 3))
