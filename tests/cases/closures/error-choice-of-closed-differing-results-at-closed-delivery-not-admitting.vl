// @error cannot deliver this choice as (i32) => string: 'inc', one of the functions it may hold, returns i32 there, which string does not take
// @hint Intentionally-unused parameter `_a`
// A choice delivered to a closed function type whose result does not take one member's result is
// refused naming that member (D17104's control).
function inc(a) { return a + 1 }
function str(_a) { return "s" }
function run(c: boolean) {
  const g = if c { str } else { inc }
  const k: (a: i32) => string = g
  print(k(4))
}
run(true)
