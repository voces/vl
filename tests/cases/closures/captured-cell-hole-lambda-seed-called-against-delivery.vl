// @run
// @log L
// @log 1
// @log 2
// @log M
// @log 3
// @log 4
// A cell seeded with a hole lambda is delivered at `(i32, string) => void` and later called at
// other types: the delivery stores the instance at the parameter's type (D3950, D3975).
function c2(f: (a: i32, b: string) => void) { f(1, "2") }
function main() {
  let k = (x, y) => {
    print("L"); print(x); print(y)
  }
  const flip = () => {
    k = (a, b) => {
      print("M"); print(a); print(b)
    }
  }
  c2(k)
  flip()
  k("3", 4)
}
main()
