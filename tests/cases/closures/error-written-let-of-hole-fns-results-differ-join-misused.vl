// @check
// @error operator '+' is not defined for i32 | string and i32
// @error cannot assign i32 | string to 'r' of type i32
// D16064: a call through a re-pointed `let` whose functions' results differ gives their join,
// which a use needing one of them refuses as it refuses the annotated union.
function inc(a) { return a + 1 }
function str(_a) { return "s" }
function add(c: boolean) {
  let f = inc
  if c { f = str }
  print(f(3) + 1)
}
function ann(c: boolean) {
  let f = inc
  if c { f = str }
  const r: i32 = f(3)
  print(r)
}
add(true)
ann(true)
