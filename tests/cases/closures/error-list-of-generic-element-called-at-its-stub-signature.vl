// @emit-error a generic function taken as a value reaches no call that fixes its type
// A generic function with no parameters has the stub's own signature, so a call through the
// unpinned list would run the stub and print nothing; it is refused instead (D4126).
function z<U>() {
  const r: U[] = []
  print(r.length)
}
const fs = [z]
fs[0]()
