// @run
// @log 8
// @log s
// @log 8
// @log 8
// @log 12
// @log n
// @log 9
// A call whose annotated return is a value union with a function arm, and whose tail yields
// that arm, is no bare closure: it pins an un-annotated or generic parameter at the union,
// passed directly, through a binding, or inside a function (D4348). A nullable one too.

function mk(n: i32): ((x: i32) => i32) | string {
  if n == 0 { return "s" }
  return (x: i32) => x + n
}
function mkn(n: i32): ((x: i32) => i32) | null {
  if n == 0 { return null }
  return (x: i32) => x + n
}
function t(a) {
  if a is (x: i32) => i32 { print(a(7)) } else { print(a) }
}
function tn(a) {
  if a == null { print("n") } else { print(a(7)) }
}
function idT<T>(x: T): T { x }

t(mk(1))
t(mk(0))
const f = mk(1)
t(f)
function m() { t(mk(1)) }
m()
const g = idT(mk(5))
if g is (x: i32) => i32 { print(g(7)) }
tn(mkn(0))
tn(mkn(2))
