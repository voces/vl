// An INFERRED array literal's ref-list element kind is decided from the checker's recorded
// ELEMENT NAME (`nodeArrayElemName`), and the axis this file moves is WHERE the `=>` sits
// inside that name — never whether one is present. A `strContains(name, "=>")` test cannot
// tell the three positions apart and claims all of them for the closure cell (kind 5), which
// types the element `(ref $cloStruct)` and stores a map / struct wrapper into it.
//
// Three rows, one per position of the SAME closure type `(i32) => i32`:
//   1. the ELEMENT is the closure           — `((i32) => i32)`        — kind 5
//   2. the closure is the element's MAP VALUE — `{[string]:(i32)=>i32}` — kind 3
//   3. the closure is the element's STRUCT FIELD — `{f: (i32) => i32}`  — kind 1
//
// HELD FIXED across the three: the closure type, the binding form (an un-annotated `const`
// local — an ANNOTATION would decide the kind itself and the element name would not be the
// evidence), the element count (one), and the read-back (index, then call). Only the arrow's
// depth in the element name moves.
//
// Row 2 is the row that was broken: `emitProgram: index receiver is not an array or string`,
// the map list never built because the literal was claimed as a closure list. Row 3 is the
// row that BREAKS IF THE ELEMENT NAME IS SOURCE-SPELLED WITHOUT THE FIX — while the checker's
// structural render wrote a function type `->`, the substring test could not see a closure
// FIELD, so the spelling was doing the classifier's job; spelling it `=>` and leaving the test
// alone miscompiles row 3 to invalid wasm.
// @run
// @log 2
// @log 11
// @log 101
function inc(x: i32) { return x + 1 }

function mkMap(): {[string]: (i32) => i32} {
  const m: {[string]: (i32) => i32} = Map()
  m["k"] = (a) => a + 10
  return m
}

function go() {
  // POSITION 1 — the element IS the closure.
  const fs = [inc]
  print(fs[0](1))

  // POSITION 2 — the closure is the element's MAP VALUE.
  const ms = [mkMap()]
  const g = ms[0]["k"]
  if g != null { print(g(1)) }

  // POSITION 3 — the closure is the element's STRUCT FIELD.
  const ss = [{ f: (b: i32) => b + 100 }]
  print(ss[0].f(1))
}
go()
