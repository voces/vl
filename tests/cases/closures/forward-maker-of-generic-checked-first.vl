// @run
// @log 1
// @log s
// @log 4
// A function returning a generic, declared after the function that calls it, has its body
// checked before its caller's, as when it is declared first (D7764).
function k<T>(x: T): T { return x }
function one() {
  const a = mk()
  print(a(1))
  print(a("s"))
}
function mk() { return k }
one()

function two() {
  const b = mk2()
  print(b(4))
}
function mk2() { return k }
two()
