// @run
// @log a
// @log 4
// A hole lambda reached through a capture cell at a string and, through a binding the cell's read
// is written into, at an i32: each binding holds the slot its calls need (D3857, D3975).
function mk(x: string, n: i32) {
  const g = (y) => y
  const h = (y) => y + y
  let d1 = g
  function w1() {
    d1 = d1
    0
  }
  let d3 = h
  d3 = d1
  print(d1(x))
  print(d3(n))
}
mk("a", 4)
