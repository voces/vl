// @emit-error the reassigned function binding `f` holds functions called at more than one argument type
// A written `let` of generics copied into another written `let`, with each called at its own
// type: both hold one function, which no one instance serves (D4240).
function gA<U>(u: U) {
  print("A")
  print(u)
}
function gB<V>(v: V) {
  print("B")
  print(v)
}
let f = gA
let g = gB
f = gB
g = f
f(2)
g(true)
