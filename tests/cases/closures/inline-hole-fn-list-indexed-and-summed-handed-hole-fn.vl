// @run
// @log 6
// @log 0.75
// @log 38
// D8062's second delivery positions: an inline list literal of hole functions indexed at once,
// and one iterated inside a function whose loop sums what each returns.
function add(a, b) { return a + b }
function apply2(g) { return g(1, 2) + g("ab", "c").length }
function apply3(g) {
  print(g(0.5, 0.25))
  return g(10, 20) + g("x", "y").length
}
function each() {
  let s = 0
  for f in ([apply2, apply3]) { s = s + f(add) }
  return s
}
print([apply3, apply2][1](add))
print(each())
