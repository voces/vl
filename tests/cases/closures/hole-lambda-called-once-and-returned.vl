// @run
// @log 4.5
// @log 3.5
// @log 4
// @log 3.5
// @log 4
// @log 3.5
// @log 5.5
// A hole lambda handed to a function that calls it at one signature and returns it: the caller
// holds the returned value, at module scope or in a function, or calls it at once (D17044).
function lap(f) {
  f(2.5)
  return f
}
function lapShown(f) {
  print(f(2.5))
  return f
}
const k = lap((a) => a + 1)
print(k(3.5))
const j = lapShown((a) => a + 1)
print(j(3))
function main() {
  const r = lapShown((a) => a + 1)
  print(r(3))
}
main()
print(lapShown((a) => a + 1)(4.5))
