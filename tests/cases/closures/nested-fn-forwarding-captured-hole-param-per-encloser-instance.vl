// @run
// @log 3
// @log 4
// @log 2
// @log 3.75
// @log 3
// @log 4
// @log 2
// @log 3.75
// @log 3
// @log 4
// @log 2
// @log 3.75
// A function nested in a hole function, forwarding the encloser's parameter through a list of
// hole functions, is built per encloser instance: each copy calls the list element's instance at
// its own instance's set (per-instance-identity-2026-11.md, M2). D14842's control is `3 4 2 3.75`.
function add(a, b) { return a + b }
function mul(a, b) { return a * b }
function apply2(g) {
  print(g(1, 2))
  print(g(1.5, 2.5))
}
function viaNested(h) {
  function inner() {
    for f in [apply2] { f(h) }
  }
  inner()
}
viaNested(add)
viaNested(mul)
function viaLambda(h) {
  const go = () => {
    for f in [apply2] { f(h) }
  }
  go()
}
viaLambda(add)
viaLambda(mul)
function viaReturned(h) {
  function inner() {
    for f in [apply2] { f(h) }
  }
  return inner
}
viaReturned(add)()
viaReturned(mul)()
