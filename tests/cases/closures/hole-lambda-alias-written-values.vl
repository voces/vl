// @run
// @log aC
// @log aE
// @log aP
// @log aP
// @log aC
// @log aP
// @log aC
// @log aP
// @log bC
// @log bQ
// @log aC
// @log bE
// @log aa
// @log 4
// @hint Intentionally-unused parameter `_t` (leading `_` marks it unused)
// @info `shared` is never reassigned; use `const` instead of `let`
// @info `twice` is never reassigned; use `const` instead of `let`
// What a `let` alias of a hole lambda holds at a call is its latest write, not the lambda its
// chain was initialized with: such a call keeps its function-value call (D3849). A write of a
// value whose function type is already concrete, a typed parameter or an annotated lambda,
// pins the hole lambdas at that type (D3848).
const top = (y: string) => y + "TOP"

// Re-aliased after a write: the second call must see `e`.
function later(x: string) {
  const c = (y) => y + "C"
  const e = (y) => y + "E"
  let d = c
  print(d(x))
  d = e
  const d2 = d
  print(d2(x))
}
later("a")

// A typed parameter written into the alias, directly and through a second alias.
function param(x: string, p: (y: string) => string) {
  const c = (y) => y + "C"
  let d = c
  d = p
  print(d(x))
  const d2 = d
  print(d2(x))
}
param("a", (y: string) => y + "P")

// …through a capture cell, and in a generic instantiated twice.
function cell(x: string, p: (y: string) => string) {
  const c = (y) => y + "C"
  let d = c
  const g = () => d(x)
  print(g())
  d = p
  print(g())
}
cell("a", (y: string) => y + "P")
function generic<T>(_t: T, x: string, p: (y: string) => string) {
  const c = (y) => y + "C"
  let d = c
  const g = () => d(x)
  print(g())
  d = p
  print(g())
}
generic(1, "a", (y: string) => y + "P")
generic(true, "b", (y: string) => y + "Q")

// A module `let` initialized with an annotated lambda, written from a sibling function.
let shared = top
function shadow(x: string) {
  const c = (y) => y + "C"
  let shared = c
  const g = () => shared(x)
  print(g())
}
function write() {
  const e = (y) => y + "E"
  shared = e
}
write()
shadow("a")
print(shared("b"))

// One unwritten alias called at two types: each call reaches its own instance.
function twoTypes(x: string, n: i32) {
  const c = (y) => y + y
  let twice = c
  print(twice(x))
  print(twice(n))
}
twoTypes("a", 2)
