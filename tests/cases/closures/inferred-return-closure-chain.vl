// @run
// @log 11
// @log 22
// @log 33
// @log 44
// @log 55
// @log 66
// @log 77
// @log 88
// @log 99
// @log 110
// @log 121

// @hint redundant type annotation: `v` is inferred as `(i32) => i32`

// D1620 — a function value delivered through a chain of INFERRED returns. Each block adds a
// different constant, so a call that reached another chain's closure prints a wrong number.
// Both faces are here, because one missing rung put them in different clauses: an annotated
// receiver lands in clause 1 (check-clean invalid wasm) and an un-annotated one in clause 2.

// `blockTailIsClosure` asks the arena before the syntax: the checker records `(i32) => i32`
// for the tail of every chain below, and reading that is one structural test with no
// recursion bound to get right, which a syntactic descent through the callee would need.

// Two hops, annotated receiver — the row's own witness, and the clause-1 face.
function mkOne() { return (n: i32) => n + 1 }

function deliverOne() { return mkOne() }

const v: (i32) => i32 = deliverOne()
print(v(10))

// The same chain with an un-annotated receiver — the clause-2 face.
function mkTwo() { return (n: i32) => n + 2 }

function deliverTwo() { return mkTwo() }

const v2 = deliverTwo()
print(v2(20))

// THREE hops, every one inferred: the rung answers per function, so depth costs nothing.
function mkThree() { return (n: i32) => n + 3 }

function midThree() { return mkThree() }

function deliverThree() { return midThree() }

print(deliverThree()(30))

// An implicit tail with no `return` keyword, through two hops. `mkFour`'s own tail goes
// through a local rather than being a bare lambda, which `vl fmt` cannot round-trip (D1624).
function mkFour() {
  const f = (n: i32) => n + 4
  f
}

function deliverFour() { mkFour() }

print(deliverFour()(40))

// The middle hop passes the value through a LOCAL rather than returning the call directly.
function mkFive() { return (n: i32) => n + 5 }

function deliverFive() {
  const g = mkFive()
  return g
}

print(deliverFive()(50))

// The inner function ANNOTATED and the outer inferred: the classification the chain needs is
// the OUTER function's, which `fnReturnsClosure`'s annotation rung cannot supply.
function mkSix(): (i32) => i32 { return (n: i32) => n + 6 }

function deliverSix() { return mkSix() }

print(deliverSix()(60))

// The chain called directly with no binding at all — `deliver()(n)`, which refuses with a
// different message off the same missing kind, so it is one family and not two.
function mkSeven() { return (n: i32) => n + 7 }

function deliverSeven() { return mkSeven() }

print(deliverSeven()(70))

// The returned closure CAPTURES, so D1608's rung and this one compose in one program.
function mkEight() {
  const inner = (n: i32) => n + 8
  return (n: i32) => inner(n)
}

function deliverEight() { return mkEight() }

print(deliverEight()(80))

// ── the neighbours that already ran, kept as controls ────────────────────────

// The MIDDLE function annotated: `fnReturnsClosure`'s annotation rung claims this before the
// arena is asked, and it must keep claiming it rather than being re-decided.
function mkNine() { return (n: i32) => n + 9 }

function deliverNine(): (i32) => i32 { return mkNine() }

print(deliverNine()(90))

// ONE hop — the control the row's ablation names: it classifies through `exprIsClosure`'s own
// `Call` arm and never needs this rung.
function mkTen() { return (n: i32) => n + 10 }

print(mkTen()(100))

// A two-hop chain returning a STRING rather than a closure: the neighbouring rep, which the
// inferred-return ladder already carried, and which the new rung must not touch.
function mkStr() { return "12" }

function deliverStr() { return mkStr() }

print(deliverStr() + "1")
