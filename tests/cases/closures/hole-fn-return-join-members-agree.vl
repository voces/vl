// @run
// @log 4
// @log 5
// @log 6
// @log 3.5
// @log -4
// A function whose returns join un-annotated functions that agree at each call's types runs the
// one it returns: called directly, handed to a callee, and over three members.
function inc(a) { return a + 1 }
function dbl(a) { return a * 2 }
function neg(a) { return 0 - a }
function sel(c: boolean) {
  if c { return inc }
  return dbl
}
function three(n: i32) {
  if n == 0 { return inc }
  if n == 1 { return dbl }
  return neg
}
function ap(f, x) { return f(x) }
print(sel(true)(3))
print(sel(false)(2.5))
print(ap(sel(false), 3))
print(ap(sel(true), 2.5))
print(three(2)(4))
