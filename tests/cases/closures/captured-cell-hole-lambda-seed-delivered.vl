// @log 11
// @log O
// @log 2
// @log 21
// @log L
// @log false
// @log O
// @log true
// @log L
// @log s
// @log O
// @log t
// @log L
// @log 1.5
// @log O
// @log 2.5
// @log O
// @log 4
// @log L
// @log 5
// @log L
// @log 6
// @log O
// @log 7
// A capture cell seeded with a hole lambda, delivered where a function type is expected, holds
// the lambda pinned at that type, and a generic written into it is instanced there too (D3950).
function ci(f: (n: i32) => void, n: i32) { f(n) }
function cb(f: (b: boolean) => void, b: boolean) { f(b) }
function cs(f: (s: string) => void, s: string) { f(s) }
function cf(f: (n: f64) => void, n: f64) { f(n) }
function other<V>(v: V) { print("O"); print(v) }
type R = { f: (n: i32) => void }
function ints() {
  let k = (x) => {
    print("L"); print(x)
  }
  const flip = () => {
    k = other
  }
  ci(k, 1)
  flip()
  ci(k, 2)
}
function mutateThenRead() {
  let n = 10
  let k = (x) => {
    print(x + n)
  }
  const flip = () => {
    k = other
  }
  const back = () => {
    k = (x) => {
      print(x + n)
    }
  }
  ci(k, 1)
  flip()
  ci(k, 2)
  n = 20
  back()
  ci(k, 1)
}
function bools() {
  let k = (x) => {
    print("L"); print(x)
  }
  const flip = () => {
    k = other
  }
  cb(k, false)
  flip()
  k(true)
}
function strs() {
  let k = (x) => {
    print("L"); print(x)
  }
  const flip = () => {
    k = other
  }
  cs(k, "s")
  flip()
  cs(k, "t")
}
function floats() {
  let k = (x) => {
    print("L"); print(x)
  }
  const flip = () => {
    k = other
  }
  cf(k, 1.5)
  flip()
  k(2.5)
}
function mk(b: boolean): (n: i32) => void {
  let k = (x) => {
    print("L"); print(x)
  }
  const flip = () => {
    k = other
  }
  if b { flip() }
  return k
}
function fields() {
  let k = (x) => {
    print("L"); print(x)
  }
  const flip = () => {
    k = other
  }
  const r: R = { f: k }
  r.f(6)
  flip()
  const r2: R = { f: k }
  r2.f(7)
}
ints()
mutateThenRead()
bools()
strs()
floats()
mk(true)(4)
mk(false)(5)
fields()
