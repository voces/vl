// @run
// @log 2
// @log 2
// @log 2
// A record holding a generic function, handed to an un-annotated parameter and called through
// `?.`, runs: the receiver is never null in that instance, so the guard is its call (D16333).
function id<T>(x: T): T { x }
function take(a) { print(a?.f(2) ?? 0) }
take({ f: id })
function take2(a) { const v = a; print(v?.f(2) ?? 0) }
take2({ f: id })
function take3(a) { const r = a?.f(2); print(r) }
take3({ f: id })
