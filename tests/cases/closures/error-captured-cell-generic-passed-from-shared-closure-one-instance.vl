// @emit-error a generic function is passed to a function value whose parameter type names a type parameter this cl
// The same with one instance (review of #3498, `rv3498/d10_nested_closure_param_from_shared_closure_one_inst`).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function third<Z>(z: Z) { print("T"); print(z) }
function a<T>(x: T) {
  let k = inner
  const w = (g: (t: T) => void) => {
    k = g
  }
  const w2 = () => {
    w(other)
  }
  k(x)
  w2()
  k(x)
}
a(1)
