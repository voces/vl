// @run
// @log 2
// @log 5
// @log 1
// @log 1
// @log ab
// @log xyz
// @log 2
// @log 2
// @hint redundant type annotation: `f` is inferred as `i32`
// @hint redundant type annotation: `g` is inferred as `i32`
// @hint redundant type annotation: `k` is inferred as `string`
// A list keyed by a closure, nested-list or nullable element's normalized type: a literal-returning
// closure beside its widened twin, a litunion-parameter closure beside a string one, and
// `T | null` beside `null | T` each build and run (D16013).
type K = "a" | "b"
function f(x: K): i32 {
  if x == "a" { return 1 }
  2
}
function g(x: string): i32 { x.length }
const fs = [f]
const gs = [g]
print(fs[0]("b"))
print(gs[0]("hello"))
const both: ((x: K) => i32)[] = [f, g]
print(both[0]("a"))
print(both[1]("b"))
function h(): "ab" { return "ab" }
function k(): string { return "xyz" }
const hs = [h]
const ks = [k]
print(hs[0]())
print(ks[0]())
type T = { v: i32 }
const t1: T | null = { v: 1 }
const ns = [t1, null]
const ms: (null | T)[] = [null, { v: 2 }]
print(ns.length)
print(ms.length)
