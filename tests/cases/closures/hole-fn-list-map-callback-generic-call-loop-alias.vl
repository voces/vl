// @info `k` is never reassigned; use `const` instead of `let`
// @run
// @log 6
// @log 6
// @log 6
// @log 2.5
// @log 10
// @log 8
// @log 6
// @log 4
// @log 3.5
// A list literal of un-annotated functions read at two types: mapped by a named un-annotated
// callback, returned and through an un-annotated parameter; an element handed to a generic
// identity and the result called; a loop variable's alias of a nested list's row indexed
// (D9862, D9980, D9981).
function inc(a) { return a + 1 }
const v = [inc]
function ap(r) { return r(5) }
function mk() { return v.map(ap) }
print(mk()[0])
const o = { f: v.map(ap) }
print(o.f[0])
function run(xs) { return xs.map(ap) }
print(run([inc])[0])
function half(a) { return a / 2.0 }
print(run([half])[0])

function id<T>(x: T): T { return x }
function hinc(a) { a + 1 }
function hdbl(a) { a * 2 }
const w = [hinc, hdbl]
print(id(w[1])(5))
print(w[0](7))
let k = 0
const g = id(w[k])
print(g(5))

function inc2(a) { return a + 1 }
const u = [[inc2]]
for r in u {
  const q = r
  print(q[0](3))
}
print(u[0][0](2.5))
