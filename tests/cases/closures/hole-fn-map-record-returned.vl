// @run
// @log 4
// @log 4
// A record holding a map of un-annotated functions, returned from an un-annotated function,
// types its field at the call's binding, at top level and inside a function (D9181).
function inc0(a) { return a + 1 }
const hm = Map()
hm["k"] = inc0
function mk() { return { m: hm } }
const v = mk()
const x = v.m["k"]
if x != null { print(x(3)) }
function use() {
  const w = mk()
  const y = w.m["k"]
  if y != null { print(y(3)) }
}
use()
