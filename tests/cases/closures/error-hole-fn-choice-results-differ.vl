// @error cannot choose 'lenOf' here: called at (string) it returns i32, where 'twice', also chosen here, returns string
// An `if` of un-annotated functions whose bodies give different results at the type a callee
// calls it at is refused at the arm, as a re-pointed `let`'s write is (D13740, D9003).
function only(n, f) { return f(n) }
function twice(s) { return s + s }
function lenOf(s) { return s.length }
const k = [1].length > 1
print(only("abc", if k { twice } else { lenOf }))
