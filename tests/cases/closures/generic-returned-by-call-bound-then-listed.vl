// @log abc
// A `const` bound to a call that always returns one generic, put in an un-annotated list, is
// called through its element at two types, and the call still runs once (D9481).
function id<T>(x: T): T { x }
function mk0() { return id }
const v0 = mk0()
const xs0 = [v0]
if xs0[0](2) == 2 { print(xs0[0]("abc")) }
function mk() {
  print("mk")
  return id
}
const v = mk()
const xs = [v]
print(xs[0](2))
print(xs[0]("abc"))
const w = mk()
print(w(3))
print(w("t"))
function mkn(n: i32) {
  print(n)
  if n > 0 { return id }
  return id
}
function main() {
  const u = mkn(4)
  const us = [u]
  for f in us {
    print(f(2))
    print(f("abc"))
  }
  print(us.length)
}
main()
const o = { f: mk0() }
print(o.f(2))
print(o.f("abc"))
