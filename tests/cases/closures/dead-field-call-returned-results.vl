// @run
// @log 2.5
// @log s
// @log true
// @log 4
// An un-annotated function whose guarded return calls a field typed `null` at its instance: that
// call never returns, so the result is the live return's type, at each result kind (D17667).
function rf(z) {
  if z.f != null { return z.f() }
  return 2.5
}
print(rf({ v: 2, f: null }))

function rs(z) {
  if z.f != null { return z.f() }
  return "s"
}
print(rs({ v: 2, f: null }))

function rb(z) {
  if z.f != null { return z.f() }
  return true
}
print(rb({ v: 2, f: null }))

function ri(z) {
  if z.f != null { return z.f() }
  return 4
}
print(ri({ v: 2, f: null }))
