// @run
// Each member of the holder called from its own function (D17111).
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
const m = Map()
m["a"] = lap((a) => a + 1)
const x = m["a"]
function g() {
  if x != null { return x(4) }
  return 0
}
function h() {
  if x != null { return x(1.5) }
  return 0.0
}
print(g())
print(h())
// @log 5
// @log 2.5
// @hint Intentionally-unused variable `_a`
// @hint Intentionally-unused variable `_b`
