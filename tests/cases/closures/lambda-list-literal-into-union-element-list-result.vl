// @run
// @log false
// @log 3
// @log false
// @log 7
// @log 1.5
// @log 4
// An un-annotated lambda returning a list literal, at a list result whose element union holds a
// function arm or a list-of-records arm, takes that result as its annotated twin does, bound and
// handed to a parameter alike (D16905).
const v: () => ((() => i32) | boolean)[] = () => [false]
const r0 = v()[0]
if r0 is boolean { print(r0) } else { print(r0()) }
const w: () => ((() => i32) | boolean)[] = () => [() => 3]
const r1 = w()[0]
if r1 is boolean { print(r1) } else { print(r1()) }
function ap(f: () => ((() => i32) | boolean)[]) {
  const r = f()[0]
  if r is boolean { print(r) } else { print(r()) }
}
ap(() => [false])
ap(() => [() => 7])
const x: () => ({a: i32}[] | f64)[] = () => [1.5]
const r2 = x()[0]
if r2 is f64 { print(r2) } else { print(r2.length) }
const y: () => ({a: i32}[] | f64)[] = () => [[{ a: 4 }], 2.5]
const r3 = y()[0]
if r3 is f64 { print(r3) } else { print(r3[0].a) }
