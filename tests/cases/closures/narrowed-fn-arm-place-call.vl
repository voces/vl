// @run
// @log 7
// @log 7
// @log s
// @log 107
// @log 2
// @log s
// @log 4
// @log 7
// @log 8
// A place narrowed to the function arm of a value union is called directly: a record field, a
// list element, a map value, a field read through a list element, and a nested field (D4346).
// Each else arm reads the string arm, so a test folded to a constant prints the wrong line.

function mk(b: boolean): (() => i32) | string {
  if b { return () => 7 }
  return "s"
}
function mk2(n: i32): ((x: i32) => i32) | string {
  if n == 0 { return "s" }
  return (x: i32) => x + n
}
type H = { f: (() => i32) | string }
type O = { h: H }
function call(g: () => i32) { g() + 100 }

const hh: H = { f: mk(true) }
if hh.f is () => i32 { print(hh.f()) } else { print(hh.f) }
const hs: H[] = [{ f: mk(true) }, { f: mk(false) }]
if hs[0].f is () => i32 { print(hs[0].f()) } else { print(hs[0].f) }
if hs[1].f is () => i32 { print(hs[1].f()) } else { print(hs[1].f) }
if hs[0].f is () => i32 { print(call(hs[0].f)) }
const xs: (((x: i32) => i32) | string)[] = [mk2(1), mk2(0)]
if xs[0] is (x: i32) => i32 { print(xs[0](1)) } else { print(xs[0]) }
if xs[1] is (x: i32) => i32 { print(xs[1](1)) } else { print(xs[1]) }
const m: {[string]: ((x: i32) => i32) | string} = Map()
m["a"] = mk2(2)
if m["a"] is (x: i32) => i32 { print(m["a"](2)) } else { print(m["a"]) }
const o: O = { h: { f: mk(true) } }
if o.h.f is () => i32 { print(o.h.f()) } else { print(o.h.f) }
if !(hh.f is string) { print(hh.f() + 1) }
