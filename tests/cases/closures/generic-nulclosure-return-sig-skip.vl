// @run
// @log 9
// @log 3
// @log 11
// @hint Intentionally-unused parameter `_x`
// @hint redundant type annotation: `f` is inferred as `(i32) => i32 | {w: i32}`
// The ONE population in which `collectCloSigs`' lifted-function NULCLOSURE-RETURN pass
// (the `cloRetValKind(fe) == "nulclosure"` arm) reaches a MIXED scalar+composite union
// result that NO registration path admitted — an UN-INSTANTIATED GENERIC TEMPLATE.
//
// `mk`'s declared return is read at that site as a SPELLING, and for the template that
// spelling still carries the TYPE PARAMETER: `((i32) => i32 | T)`. `T` is neither a
// value atom nor a litunion, so it counts as the COMPOSITE side of
// `nulCloMixedUnionUnregistered`'s mix test while the `i32` supplies the SCALAR side —
// and nothing ever registers it, because `collectU` (which owns the
// `collectTyReachRegister` structural walk that registers a closure result union) is
// emit pass #1, while `monomorphize` and `synthRetAnnots` run later and there is no
// `collectU#2`. Every CONCRETE mixed union registers and the guard declines; only the
// template's own spelling survives to make it fire.
//
// Unguarded, that site banked the `$fnsig` key `i>u` for a spelling that mentions a type
// PARAMETER — a key describing no value — and because the intern keeps the FIRST rep for
// a key, the template reached before the concrete `f` below also STOLE that key's
// representative, replacing `f`'s own functype with the `-1` synthesized one.
//
// This file pins the SHAPE end to end: the template instantiates, the nulclosure return
// round-trips its null draw, the concrete `(i32) => i32 | {w: i32}` value call resolves
// through the same `i>u` key, and the nulclosure ANNOTATION position resolves too. All
// three print, so a future change that drops the sig for any of them fails loudly rather
// than silently.

// `_x` exists only to BIND `T` at the call site; the body never reads it.
function mk<T>(_x: T): ((i32) => i32 | T) | null { return null }

// The template's instance: the nullable-closure return is only ever `null`.
function tick() {
  const t0 = mk(1)
  if t0 != null { print(0) } else { print(9) }
}

// A CONCRETE lambda whose `$fnsig` key is the SAME `i>u` the template's spelling keys.
// Its representative must stay the lambda itself, not the template's synth sentinel.
const f: (i32) => i32 | {w: i32} = (n: i32) => (n)

function callIt(g: (i32) => i32 | {w: i32}) {
  const r = g(3)
  if r is i32 { print(r) } else { print(77) }
}

// The nulclosure ANNOTATION position over the same key, value only ever `null`.
function p3(t2: ((i32) => i32 | {w: i32}) | null) {
  if t2 != null {
    const r = t2(1)
    if r is i32 { return r }
    return 5
  }
  return 11
}

const c: ((i32) => i32 | {w: i32}) | null = null

function go() {
  tick()
  callIt(f)
  print(p3(c))
}

go()
