// @run
// @log 20
// @log 13
// A recursive record type holding a set of un-annotated functions: every walk that decides the
// set's rep reaches the type again through its own field and stops there.
function inc0(a) { return a + 1 }
function dbl0(a) { return a * 2 }
type T = { f: (a: i32) => i32, kids: T[] }
const t: T = {
  f: inc0,
  kids: [{ f: dbl0, kids: [] }, { f: inc0, kids: [{ f: dbl0, kids: [] }] }],
}
function walk(t: T, x: i32) {
  let acc = t.f(x)
  for k in t.kids { acc = acc + walk(k, x) }
  return acc
}
print(walk(t, 3))
type U = { f: (a: i32) => i32, l: U[], r: U[] }
const us = [
  { f: inc0, l: [], r: [] },
  { f: dbl0, l: [{ f: inc0, l: [], r: [] }], r: [] },
]
print(us[1].f(4) + us[1].l[0].f(4) + us[1].r.length)
