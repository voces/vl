// @error cannot assign (i32) => void to `k`: it keeps the generic type of its initializer
// A call result's concrete function type written into a cell wanted at string (review of #3498, `rv3498/c03_cell_call_result_i32_str`).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function third<Z>(z: Z) { print("T"); print(z) }
function mkf(): (n: i32) => void { return other }
function a<T>(x: T) {
  let k = inner
  const w = () => {
    k = mkf()
  }
  w()
  k(x)
}
a(1)
a("s")
