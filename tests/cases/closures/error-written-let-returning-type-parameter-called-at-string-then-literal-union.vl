// @emit-error holds functions called at more than one argument type
// A generic that returns its type parameter, called through a written `let` with a `string` and
// with a string literal union, would hand the union call a `string` back (D4244).
function idg<T>(t: T): T { return t }
type S = "p" | "q"
const a: S = "p"
const s: string = "z"
let x = idg
x = idg
const r2 = x(s)
const r1 = x(a)
print(r1)
print(r2)
