// @run
// A local list of a generic function handed twice at one closed element type, or called through
// at that type, is one storage at it and runs (D17843).
function id<T>(x: T): T { return x }
function runI(a: ((x: i32) => i32)[]) { print(a[1](2)) }
function f() {
  const zs = [id, id]
  runI(zs)
  runI(zs)
  print(zs[0](3))
}
f()
// @log 2
// @log 2
// @log 3
