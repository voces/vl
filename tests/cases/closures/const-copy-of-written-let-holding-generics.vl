// @run
// @hint Intentionally-unused parameter `_a` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_b` (leading `_` marks it unused)
// @log W
// @log 6
// @log false
// @log W
// @log q
// @log 2
// A `const` copy of a written `let` holding generics calls the written function (D6704).
function s<A, B>(_a: A, _b: B) { print("S") }
function w<B>(a: i32 | string, b: B) {
  print("W")
  print(a)
  print(b)
}
function main() {
  let k = s
  k = w
  const k2 = k
  k2(6, false)
  k2("q", 2)
}
main()
