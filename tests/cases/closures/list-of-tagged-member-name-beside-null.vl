// @run
// @log 4
// @log true
// @log false
// @log null
// @log 4
// @log null
// @log 11
// @log null
// @log 6
// A tagged set's member named straight into a list beside `null` is its id there: a read of the
// element is the nullable id, never rewritten to the member's name (D17865).
function inc(a) { return a + 1 }
const ys = [inc, null]
const g = ys[0]
if g != null { print(g(3)) }
const xs = [null, inc]
print(xs[0] == null)
print(xs[1] == null)
const f0 = xs[0]
if f0 != null { print(f0(1)) } else { print("null") }
const f1 = xs[1]
if f1 != null { print(f1(3)) } else { print("null") }
for x in xs {
  if x != null { print(x(10)) } else { print("null") }
}
function call(h) {
  if h != null { print(h(5)) } else { print("null") }
}
call(xs[0])
call(xs[1])
