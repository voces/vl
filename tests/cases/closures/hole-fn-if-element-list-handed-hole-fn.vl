// @run
// @log 3
// @log 4
// @log 30
// @log 0.75
// A list whose one element is an `if` joining two hole functions, read at a literal index
// (D7183).
function add(a, b) { return a + b }
function apply2(g) {
  print(g(1, 2))
  print(g(1.5, 2.5))
}
function apply3(g) {
  print(g(10, 20))
  print(g(0.5, 0.25))
}
function main(c: boolean) {
  const fs = [if c { apply2 } else { apply3 }]
  fs[0](add)
}
main(true)
main(false)
