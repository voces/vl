// @run
// @warning Unused parameter `a`
// @log n
// @log x2
// @log y20
// @log 2
// @log 20
// @log n
// @log y20
// @log y20
// @log 20
// @log 20
// @log n
// @log x2
// @log y20
// @log 2
// @log 20
// D10792: an element choosing by a condition that calls runs that condition once, before the
// list, and the list and its copy choose the element by its answer.
import { toString } from "std:fmt"

function cat(a, b) { return a + b.toString() }
function snd(a, b) { return b }
function apply2(g) { print(g("x", 2)) }
function apply3(g) { print(g("y", 20)) }
let n = 0
function next() {
  n = n + 1
  print("n")
  return n
}
const fs = [apply2, if next() > 0 { apply3 } else { apply2 }]
for f in fs { f(cat) }
for f in fs { f(snd) }
function run() {
  const gs = [
    match next() {
      2 => apply3
      _ => apply2
    },
    apply3,
  ]
  for f in gs { f(cat) }
  for f in gs { f(snd) }
}
run()
run()
