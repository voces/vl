// @run

// D2325 — a closure-typed PARAMETER shadowed independently in two `match` arms, by different
// `const`s of the same name. Reading the param again after the `match` sees the param.

function f(g: () => i32, n: i32) {
  let out = ""
  match n {
    1 => {
      const g = () => "one"
      out = "\{g()}"
    }
    _ => {
      const g = () => "other"
      out = "\{g()}"
    }
  }
  out = out + "|" + "\{g()}"
  out
}
print(f(() => 5, 1))
// @log one|5
print(f(() => 5, 2))
// @log other|5
