// @log 1.5
// @log 4
// A list literal of nested records of un-annotated functions stored by index into a list of lists
// of them is built at the list's element, as a pushed one is; so is an element record (D16858).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const xs = [[{ a: { f: inc0 } }], [{ a: { f: half } }]]
xs[1] = [{ a: { f: inc0 } }]
print(xs[1][0].a.f(3))
xs[0][0] = { a: { f: half } }
print(xs[0][0].a.f(3))
let i = 0
i = i + 1
xs[i] = [{ a: { f: half } }, { a: { f: inc0 } }]
let j = 0
while j < 2 { print(xs[1][j].a.f(3)); j = j + 1 }
function go() {
  const ys = [[{ a: { f: inc0 }, n: 1 }], [{ a: { f: half }, n: 2 }]]
  ys[1] = [{ a: { f: inc0 }, n: 7 }]
  ys.push([{ a: { f: half }, n: 8 }])
  for row in ys {
    for e in row { print(e.a.f(3)) }
  }
  print(ys[1][0].n + ys[2][0].n - 11)
}
go()
