// @run
// @hint redundant type annotation: `a` is inferred as `string` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// @log z
// @log yz
// The control for `member-call-tail-fed-its-own-result.vl`: with no function value in the
// module the closure-field walk never starts, so this ran before D4290 was fixed too.

function a(s: string): string { s.slice(1, s.length) }
print(a(a("xyz")))
const t = a("wxyz")
print(a(t))
