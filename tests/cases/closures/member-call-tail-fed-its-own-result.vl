// @run
// @hint redundant type annotation: `a` is inferred as `string` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// @hint redundant type annotation: `g` is inferred as `string` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// @hint redundant type annotation: `p` is inferred as `string` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// @log 2
// @log z
// @log yz
// @log k
// @log r
// @log c
// @log o
// @log literal
// @log maker
// A function whose tail is a member call on its parameter, called with its own result, in a
// module with a function value. Resolving the receiver as a closure field followed the
// parameter to that argument, the argument to the callee's tail, and the tail back to the
// same receiver, without bound (D4290). Each line drops a different number of characters.

function a(s: string): string { s.slice(1, s.length) }
function u(s: string) { s.slice(1, s.length) }
function g(): string { a(a("pqr")) }

// A real closure field still resolves through the parameter to the argument that built it.
function p(x: {f: () => string}): string { x.f() }
function mk(): {f: () => string} { { f: () => "maker" } }

const inc = (x: i32) => x + 1
print(inc(1))
print(a(a("xyz")))
const t = a("wxyz")
print(a(t))
print(u(u("ijk")))
print(g())
const r = { v: a(a("abc")) }
print(r.v)
const xs = [a(a("mno"))]
print(xs[0])
print(p({ f: () => "literal" }))
print(p(mk()))
