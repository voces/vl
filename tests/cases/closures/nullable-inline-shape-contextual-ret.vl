// @run
// @log 1.5
// @log none
// A contextually-typed lambda whose body infers a nullable inline shape, `{q: f64} | null`,
// handed to a parameter whose result is `{q: f32} | null`. The literal `1.5` adapts to the
// `f32` field, so the lambda takes the parameter's result as its own, as the annotated lambda
// `(k): {q: f32} | null => …` does, and the call reads the field at `f32`.
function each(f: (i32) => { q: f32 } | null) {
  const v = f(1)
  if v != null { print(v.q) }
  const w = f(0)
  if w == null { print("none") }
}
each((k) => {
  if k == 0 { return null }
  return { q: 1.5 }
})
