// @run
// @log 7
// @log 8
// @log 7
// @log 7
// @log 8
// @log 7
// A binding of an object literal built at the declared record it is handed to (`{ f: 7 }` at `J`,
// not its own `I`) is captured as that record: a lambda handing the capture on reads it there,
// whether the frame owning it reads a field before, after, or not at all.
type J = { f: i32 | null }
type I = { f: i32 }
function show(j: J) { print(j.f ?? 0) }

function readBefore() {
  const r = { f: 7 }
  print(r.f + 1)
  const k = () => {
    show(r)
  }
  k()
}
function readAfter() {
  const r = { f: 7 }
  const k = () => {
    show(r)
  }
  k()
  print(r.f + 1)
}
function onlyCaptured() {
  const r = { f: 7 }
  const k = () => {
    show(r)
  }
  k()
}
const g = { f: 7 }
const kg = () => {
  show(g)
}
kg()

readBefore()
readAfter()
onlyCaptured()
