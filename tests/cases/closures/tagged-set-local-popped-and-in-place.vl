// @run
// @log 6
// @log 4
// @log 6
// @log 6
// @log 4
// @log 6
// @log 4
// @log 8
// @log 4
// Function-local lambdas whose set a second list tags: a popped element narrowed and called, a
// `get` beside it, and an element called in place, each dispatched on the member id its list holds.
function popped() {
  const f = (a) => a + 1
  const d = (a) => a * 2
  const two = [f, d]
  const s = two.pop()
  if s != null { print(s(3)) }
  const m = [f]
  print(m[0](3))
}
popped()
function both() {
  const f = (a) => a + 1
  const d = (a) => a * 2
  const two = [f, d]
  const s = two.pop()
  if s != null { print(s(3)) }
  const g = two.get(0)
  if g != null { print(g(5)) }
  const m = [f]
  print(m[0](3))
}
both()
function inPlace() {
  const f = (a) => a + 1
  const d = (a) => a * 2
  const two = [f, d]
  print(two[1](3))
  print(two[0](3))
  print(two[1](4))
  const m = [f]
  print(m[0](3))
}
inPlace()
