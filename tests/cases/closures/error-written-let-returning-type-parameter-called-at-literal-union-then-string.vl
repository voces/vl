// @emit-error holds functions called at more than one argument type
// The same refusal whichever call comes first: the decision reads every call's signature (D4244).
function idg<T>(t: T): T { return t }
type S = "p" | "q"
const a: S = "p"
const s: string = "z"
let x = idg
x = idg
const r1 = x(a)
const r2 = x(s)
print(r1)
print(r2)
