// @run
// @log 4
// @log 4
// @log 3.5
// @log 8
// @log 1.5
// @log 6
// @log 3.5
// @log 4
// @log 3.5
// An inline nested list of un-annotated functions handed to an un-annotated parameter runs, read
// at one type and at two, inside a function, at f64, through an alias of the parameter, and behind
// an early-return guard (D9765). The last case, the flat list, is a control that ran before.
function inc0(a) { return a + 1 }
function take0(v) { print(v[0][0](3)) }
take0([[inc0]])

function inc1(a) { return a + 1 }
function take1(v) {
  print(v[0][0](3))
  print(v[1][0](2.5))
}
take1([[inc1], [inc1]])

function inc2(a) { return a + 1 }
function dbl2(a) { return a * 2 }
function take2(v) { return v[1][1](3) + v[0][0](1) }
function go2() {
  const r = take2([[inc2], [inc2, dbl2]])
  print(r)
}
go2()

function half3(a) { return a / 2.0 }
function take3(v) {
  const w = v
  print(w[0][0](3.0))
}
take3([[half3]])

function inc4(a) { return a + 1 }
function dbl4(a) { return a * 2 }
function take4(v) {
  if v.length == 2 {
    print(v[0][1](3))
    print(v[1][0](2.5))
    return
  }
  print(0)
}
take4([[inc4, dbl4], [inc4]])

function inc5(a) { return a + 1 }
function take5(v) {
  print(v[0](3))
  print(v[1](2.5))
}
take5([inc5, inc5])
