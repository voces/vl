// @run
// @log 5
// @log 2.5
// @log 8
// @log 10
// @log 5
// @log 2.5
// @log 11
// @log 4
// A `const` copy of a hole lambda's bundle held in a module-scope `const` is handed on as the
// holder is: whole to a parameter called at both signatures, as its member to one called at one,
// and at module scope or inside a function (D15741).
function lap(f) {
  f(2.5)
  f(3)
  return f
}
function take(b) {
  print(b(4))
  print(b(1.5))
}
function take2(b) { print(b(7)) }
const c = lap((a) => a + 1)
const v = c
take(v)
take2(v)
print(v(9))
function g() {
  const u = c
  take(u)
}
g()

function lap2(f) {
  f(1.5)
  f(2)
  return f
}
function take3(b) {
  print(b(5))
  print(b(1.5))
}
const d = lap2((a) => a * 2 + 1)
const h = () => {
  const w = d
  take3(w)
}
h()
