// @error cannot store 'half' in 'rs[].f': called at (i32) it returns f64, where 'inc0', also stored in it, returns i32
// A field of a list's records holding functions of different results, called through a `for`
// loop's element, is refused as a call through the element itself is (D9092).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const rs = [{ f: inc0 }, { f: half }]
for r in rs { print(r.f(3)) }
