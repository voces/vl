// @run
// @log 4
// @log true
// @log 4
// @log 4
// @log 4
// @log 4
// @log 3
// @log 4
// @log 4
// A value `if` or `match` seeds each arm's lambda with the type it is delivered to wherever it
// stands, as a tail `if` does: returned, bound, passed, assigned, and inside a record or list arm.
type R = { f: (i32) => i32 }
function ret(n: i32): (i32) => i32 {
  return if n == 0 { (x) => x + 1 } else { (x) => x * 2 }
}
print(ret(1)(2))
function retNull(n: i32): ((x: i32) => i32) | null {
  return if n > 0 { (x) => x + n } else { null }
}
print(retNull(1) != null)
function retMatch(n: i32): (i32) => i32 {
  return match n {
    0 => (x) => x + 1
    _ => (x) => x * 2
  }
}
print(retMatch(1)(2))
const n = [1].length
const bound: (i32) => i32 = if n == 0 { (x) => x + 1 } else { (x) => x * 2 }
print(bound(2))
function ap(h: (i32) => i32) { h(2) }
print(ap(if n == 0 { (x) => x + 1 } else { (x) => x * 2 }))
let h: (i32) => i32 = (x) => x
h = if n == 0 { (x) => x + 1 } else { (x) => x * 2 }
print(h(2))
function retList(k: i32): ((i32) => i32)[] {
  return if k == 0 { [(x) => x + 1] } else { [] }
}
print(retList(0)[0](2))
function retRec(k: i32): R {
  return if k == 0 { { f: (x) => x + 1 } } else { { f: (x) => x * 2 } }
}
print(retRec(1).f(2))
function retBlock(k: i32): (i32) => i32 {
  return if k == 0 {
    const d = 1
    (x) => x + d
  } else {
    (x) => x * 2
  }
}
print(retBlock(1)(2))
