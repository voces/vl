// @error cannot assign (_) => _ to 'f' of type (i32) => i32
// An un-annotated function whose body widens `i32` to `f64` does not fit a function type
// returning `i32`; the instance's result is the one its body gives (D8160).
function half(a) { return a / 2.0 }
const f: (i32) => i32 = half
print(f(3))
