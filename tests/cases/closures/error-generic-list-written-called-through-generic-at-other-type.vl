// @error push: cannot add (i32) => i32 to ((string) => string)[] (written into `ys`, delivered at ((string) => string)[])
// A list of a generic function pushed a fixed-type function refuses when a generic function takes it
// and calls through it at a type the other arguments close its type parameter to (D10150).
function id<T>(x: T): T { x }
function inc(x: i32): i32 { x + 1 }
const ys = [id]
ys.push(inc)
function run<U>(a: ((x: U) => U)[], u: U): U { a[1](u) }
print(run(ys, "s"))
