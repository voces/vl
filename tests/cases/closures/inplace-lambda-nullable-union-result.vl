// @run
// @log 8
// @log none
// @log s
// @log 2
// @log 0
// @log 8
// @log true
// @hint redundant type annotation: `a` is inferred as `string | i32 | null` — remove it to lean on inference
// @hint redundant type annotation: `c` is inferred as `LN | null` — remove it to lean on inference
// D2567: a lambda literal called in place, or a closure a factory hands back, over
// `string | i32 | null` or `K | null` keys its result as the value-union box, and every
// destination reads it as that box rather than boxing it again as an `i32`.
type LN = 1 | 2
function show(u: string | i32 | null) {
  if u == null { return "none" }
  if u is string { return u }
  return "num"
}
function gen(r: string | i32 | null): string | i32 | null {
  return ((x: string | i32 | null) => x)(r)
}
function mk() { return (p: string | i32 | null) => p }
const a: string | i32 | null = ((p: string | i32 | null) => p)(7)
if a is i32 { print(a + 1) }
print(show(gen(null)))
const b = ((p: string | i32 | null) => p)("s")
print(show(b))
const c: LN | null = ((p: LN | null) => p)(2)
print(c ?? 0)
const d = ((p: LN | null) => p)(null)
print(d ?? 0)
const e = mk()(7)
if e is i32 { print(e + 1) }
print(mk()(null) == null)
