// @run
// @log 1.5
// @log 5
// @log 2
// A write through an alias of a list of functions lands in the list the alias names, whose set
// joins it, so a call through the source runs the function written (D9091, D14647).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const xs = [inc0]
const ys = xs
ys[0] = half
print(xs[0](3))
const as2 = [inc0]
const bs = as2
bs.push(half)
for f in as2 { print(f(4)) }
