// @run
// @log 1
// @log 2
// @log 1
// @log 1
// A `let` list of lists of un-annotated functions nothing calls, re-pointed at another such list,
// takes the type its functions hold at no call, the re-points' included (D16921).
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function half(a) { return a / 2.0 }
let r = [[inc0]]
r = [[dbl]]
print(r.length)
let s = [[inc0], [dbl]]
s = [[dbl, inc0]]
print(s[0].length)
let t = [[inc0]]
t = [[half]]
print(t.length)
function g() {
  let u = [[inc0]]
  u = [[dbl]]
  print(u.length)
}
g()
