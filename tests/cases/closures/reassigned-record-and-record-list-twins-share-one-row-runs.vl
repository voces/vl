// @run
// @log 4
// @log 4
// @log 6
// @log 4
// @log 10
// @log 4
// @log -3
// A record and a list of records, each initialised with one function and reassigned from a call
// returning another, hold one joined set; the call's literal is built at the holder's row (D15564).
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function neg(a) { return 0 - a }
function mkr() { return { fs: [inc0] } }
let r = { fs: [dbl] }
r = mkr()
print(r.fs[0](3))
function mkl() { return [{ fs: [inc0] }] }
let k = [{ fs: [dbl] }]
k = mkl()
print(k[0].fs[0](3))
// The holder read before and after the call, then grown by a third write.
let r2 = { fs: [dbl] }
print(r2.fs[0](3))
r2 = mkr()
print(r2.fs[0](3))
r2.fs.push(dbl)
print(r2.fs[1](5))
// The twins of one record and of a list of records reached from inside a function.
function go() {
  let a = { fs: [dbl] }
  a = mkr()
  print(a.fs[0](3))
  function mkn() { return [{ fs: [neg] }] }
  let b = [{ fs: [dbl] }]
  b = mkn()
  print(b[0].fs[0](3))
}
go()
