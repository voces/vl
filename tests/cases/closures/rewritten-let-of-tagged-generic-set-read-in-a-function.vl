// A `let` of a tagged set of generic functions (the list makes the set ids), rewritten and read in
// a function or a closure, calls the member its last write stored: a call through the binding
// goes through the set of every function it may hold, not its initialiser's (D17740).
function addT<T>(a: T, b: T) { return a + b }
function first<T>(a: T, _b: T) { return a }
function third<T>(_a: T, b: T) { return b }
const _fs = [addT, first, third]
function useK() { print(k(1, 2)) }
let k = addT
useK()
k = first
useK()
k = third
useK()
k = addT
print(k(5, 6))
useK()
function local() {
  let j = first
  const g = () => j(7, 8)
  print(g())
  j = third
  print(g())
}
local()
