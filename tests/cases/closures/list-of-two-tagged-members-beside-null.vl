// A list naming two members of a tagged set beside `null` holds the joined set's nullable ids: the
// sets union under the `| null`, a null element reads back as null, and each member runs (D17875).
function inc(a) { return a + 1 }
function dbl(a) { return a * 2 }
const ys = [inc, null, dbl]
for y in ys {
  if y != null { print(y(10)) } else { print("null") }
}
const xs = [null, dbl, inc, null]
print(xs[0] == null)
print(xs[3] == null)
print(xs[1] == null)
for x in xs {
  if x != null { print(x(10)) } else { print("null") }
}
function call(g) {
  if g != null { print(g(5)) } else { print("null") }
}
call(xs[0])
call(xs[1])
call(xs[2])
print(xs.length)
