// @log false
// @log true
// One declaration delivered at two function types is one value across the arms of a union of
// those types; another declaration, or a non-function arm, is not (D7701).
function two<T>(x: T) { return [x].length }
function one(x: i32) { return x + 1 }
type F = ((x: i32) => i32) | ((x: string) => i32)
const p: (x: i32) => i32 = two
const q: (x: string) => i32 = two
const u: F = p
const v: F = q
print(u == v)
print(u != v)
const w: F = one
print(w == v)
function mk(b: boolean): F {
  if b { return p }
  return q
}
print(mk(true) == mk(false))
const ws: F[] = [p, q, one]
print(ws[0] == ws[1])
print(ws[1] == ws[2])
const s: ((x: i32) => i32) | string = "a"
let t: ((x: i32) => i32) | string = p
print(s == t)
t = "a"
print(s == t)
