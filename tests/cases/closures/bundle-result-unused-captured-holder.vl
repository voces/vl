// Such a result stored in a function's map and read back into a holder a lambda captures runs:
// the null-only holder is accepted at the bundle record (D17585).
// @run
// @log true
// @hint Intentionally-unused variable `_a`
// @hint Intentionally-unused variable `_b`
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
function inFn() {
  const k = Map()
  k["a"] = lap((a) => a + 1)
  const g = k["a"]
  const seen = () => g != null
  print(seen())
}
inFn()
