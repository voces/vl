// @run
// @log 5 2.5
// @log 6 2.5
// @log 2
// @log 5 2.5
// @log 6 4.5
// @hint Intentionally-unused variable `_a`
// @hint Intentionally-unused variable `_b`
// @hint Intentionally-unused variable `_t`
// A record of one closure per signature written into an element of an un-annotated list is held
// there whole: a copy of the element and a call through the element's place each take their member.
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
function gen<T>(t: T, k: i32) {
  const r = lap((a) => a + k)
  const _t = t
  return r
}
const xs = [lap((a) => a + 1), gen("s", 2)]
const v = xs[0]
print("\{v(4)} \{v(1.5)}")
print("\{xs[1](4)} \{xs[0](1.5)}")
print(xs.length)
let i = 0
while i < 2 {
  print("\{xs[i](4)} \{xs[i](i + 1.5)}")
  i = i + 1
}
