// @run
// @log 4
// @log 1.5
// @log 4
// @log 1.5
// @log 4
// @log 5.5
// @log 9
// A record whose function field holds un-annotated functions returning different types, joined
// by an `if`: a call through the field runs the member stored there, whichever arm is taken.
// Read directly in both arm orders, the field bound, the field written, captured, two such
// fields, and two calls summed (D15801).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function two() { [1, 2].length }
const a = if two() > 5 { { f: half } } else { { f: inc0 } }
print(a.f(3))
const b = if two() > 1 { { f: half } } else { { f: inc0 } }
print(b.f(3))
const g = a.f
print(g(3))
const c = { f: inc0 }
if two() > 1 { c.f = half }
print(c.f(3))
function go() { return a.f(3) }
print(go())
const d = if two() > 5 { { f: half, h: inc0 } } else { { f: inc0, h: half } }
print(d.f(3) + d.h(3))
print(a.f(3) + a.f(4))
