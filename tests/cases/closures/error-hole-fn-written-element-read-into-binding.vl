// @error cannot write 'half' to an element of 'xs': called at (i32) it returns f64, where 'inc0', also written to it, returns i32
// A list element written with a function of another result, read into a binding and called
// through it, is refused at the write as a direct call through the element is (D9090).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const xs = [inc0]
xs[0] = half
const g = xs[0]
print(g(3))
