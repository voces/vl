// @run
// @log 1.5
// @log 2
// @log a
// @log 2
// @log 1.5
// @log 2
// @log 1
// @log 2
// @log 1.5
// @log 2
// @log 1.5
// @log 2
// A LAMBDA WHOSE RESULT IS A LOCAL READ THROUGH A CAPTURED INFERENCE HOLE.
//
// The f64 and string arms used to check clean (`vl check` rc 0) and emit a module that does
// not instantiate — `type mismatch: expected i32, found f64` INSIDE the lambda. Graduated
// from `soundness/xfail-miscompile-lambda-captures-inferred-nonI32-elem.vl`, which absorbed
// `lambda-captures-inferred-elem-controls.vl` on the way.
//
// THE LOCAL WAS RIGHT AND THE RESULT WAS WRONG, which is not what the xfail's header
// guessed. Disassembling the bad module shows `g` declaring `(local f64)` and `(result i32)`:
// `collectLocals` types the lambda's `z` correctly, because it runs per function AFTER the
// pin and reads the annotation. What had no source was the lambda's inferred RESULT valtype.
//
// BOTH OF `criClassify`'s CHANNELS ARE BLIND AT ONCE HERE, and that is the actual root.
// Classifying `return z` means classifying an Ident that names a local, and the two ways to
// do that are the typed-IR fast path (the checker's recorded type) and `declaredKind`. The
// second reads a table `buildLocals` fills much later; the first reads -1 because a
// MONOMORPHIZED INSTANCE's body is a CLONE whose leaf nodes cannot carry a per-instance type.
// So the slot kept the `"i32"` default. The fix asks the DECLARATION instead, through
// `letCellKind` — the same shared ladder `collectLocals` mirrors — which is exactly what
// `retIsMapLocal` had been doing one column up, for maps only.
//
// IT WAS NEVER ABOUT THE CAPTURE, and the arms below say so: the trigger is a LOCAL in the
// lambda whose kind only its declaration knows. `() => self[0]` with no local compiles on
// master, and so does a lambda-local of a literal (`const z = 1.5`); a captured SCALAR hole
// (`f(x)` with `const z = x`) breaks the same way a captured element does, and so does an
// explicitly generic `f<T>(self: T[])`. The last three arms are the former controls: an i32
// element (the default is accidentally right), the same read moved OUT of the lambda, and the
// same lambda with the parameter ANNOTATED.
function viaF64(self) {
  const g = () => {
    const z = self[0]
    return z
  }
  print(g())
  return self.length
}

function viaStr(self) {
  const g = () => {
    const z = self[0]
    return z
  }
  print(g())
  return self.length
}

function viaTyParam<T>(self: T[]) {
  const g = () => {
    const z = self[0]
    return z
  }
  print(g())
  return self.length
}

function viaI32(self) {
  const g = () => {
    const z = self[0]
    return z
  }
  print(g())
  return self.length
}

function outsideLambda(self) {
  const z = self[0]
  print(z)
  return self.length
}

function annotated(self: f64[]) {
  const g = () => {
    const z = self[0]
    return z
  }
  print(g())
  return self.length
}

print(viaF64([1.5, 2.5]))
print(viaStr(["a", "b"]))
print(viaTyParam([1.5, 2.5]))
print(viaI32([1, 2]))
print(outsideLambda([1.5, 2.5]))
print(annotated([1.5, 2.5]))
