// @emit-error the reassigned function binding `f` holds functions called at more than one argument type
// A written `let` holding generic functions and called at `i32` and at `boolean`, which share a
// representation, holds one closure signature, so it is refused (D3979).
function inner<U>(u: U) {
  print("I")
  print(u)
}
function other<V>(v: V) {
  print("O")
  print(v)
}
function main() {
  let f = other
  f = inner
  f(1)
  f(true)
}
main()
