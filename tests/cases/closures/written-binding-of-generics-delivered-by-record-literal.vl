// @run
// @log 1
// @log s
// @log loud
// @log 3
// @log 20
// A written binding of two generics called at two types, delivered through an annotated record literal at a
// closed function type, is delivered through an adapter and keeps the value it held there.
function id<T>(x: T): T { return x }
function loud<T>(x: T): T {
  print("loud")
  return x
}
type R = { g: (x: i32) => i32 }
function main() {
  let f = id
  print(f(1))
  print(f("s"))
  const r: R = { g: f }
  f = loud
  print(f(3))
  print(r.g(20))
}
main()
