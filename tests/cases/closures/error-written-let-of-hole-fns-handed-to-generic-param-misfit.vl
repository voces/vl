// @error cannot write 'str' to 'f': called at (i32) it returns string, where 'inc', also written to it, returns i32 — every function a call through 'f' may run must return one type
// A re-pointed `let` handed to a generic parameter whose result one member's does not fit (`T`,
// bound `i32`) is still refused at the write (D16098).
function inc(a) { return a + 1 }
function str(_a) { return "s" }
function same<T>(g: (x: T) => T, v: T): T { return g(v) }
function run(c: boolean) {
  let f = inc
  if c { f = str }
  print(same(f, 3))
}
run(true)
