// @run
// @warning Unused parameter
// @log pick
// @log y20
// @log 20
// D10701 through a `const` choice of hole functions called at two function types; the
// condition runs once.
import { toString } from "std:fmt"

function cat(a, b) { return a + b.toString() }
function snd(a, b) { return b }
function apply2(g) { print(g("x", 2)) }
function apply3(g) { print(g("y", 20)) }
function pick() {
  print("pick")
  return true
}
const h = if pick() { apply3 } else { apply2 }
h(cat)
h(snd)
