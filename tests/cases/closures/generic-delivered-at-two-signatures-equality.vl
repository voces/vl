// @run
// @log 1
// @log s
// @log true
// @log true
// @log true
// @log false
// A generic is one function whatever signature it is delivered at: its deliveries compare equal
// to each other and to its own name, and unequal to another declaration of the same shape (D7481).
function id(x) { return x }
function other(x) { return x }
print(id(1))
print(id("s"))
const f: (x: string) => string = id
const g: (x: i32) => i32 = id
const h: (x: string) => string = id
const o: (x: string) => string = other
print(f == id)
print(g == id)
print(f == h)
print(f == o)
