// @emit-error a function this call reaches through a list or join is already taken at another function type by an earlier call through it
// One loop variable called at two function types reads one element, which holds one instance,
// so the second call is refused rather than made at the wrong signature (D10791).
import { toString } from "std:fmt"

function cat(a, b) { return a + b.toString() }
function snd(a, b) { return b }
function apply2(g) { print(g("x", 2)) }
function apply3(g) { print(g("y", 20)) }
const fs = [apply2, apply3]
for f in fs {
  f(cat)
  f(snd)
}
