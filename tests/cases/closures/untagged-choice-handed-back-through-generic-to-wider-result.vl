// @run
// @hint Intentionally-unused parameter `_a` (leading `_` marks it unused)
// @log s
// @log s
// @log s
// @log s
// @log 5
// @log 5
// @log 7
// @log 6
// @log s
// @log 5
// @log 5
// A choice of un-annotated functions called through no open parameter, handed through a generic
// that hands it back to a closed function type admitting each member's result, is decided by the
// check and dispatches there (D17099).
function inc(a) { return a + 1 }
function str(_a) { return "s" }
function id<T>(t: T): T { return t }
function useK(k: (a: i32) => i32 | string) { print(k(4)) }
function useR(r: { k: (a: i32) => i32 | string }) { print(r.k(5)) }
function run(c: boolean) {
  const g = if c { str } else { inc }
  useK(id(g))
  const k: (a: i32) => i32 | string = id(g)
  useK(k)
  const r: { k: (a: i32) => i32 | string } = { k: id(g) }
  print(r.k(6))
  useR({ k: id(g) })
}
function inline(c: boolean) { useK(id(if c { str } else { inc })) }
function same(c: boolean) {
  const h = if c { inc } else { inc }
  useK(id(h))
}
run(true)
run(false)
inline(true)
inline(false)
same(true)
