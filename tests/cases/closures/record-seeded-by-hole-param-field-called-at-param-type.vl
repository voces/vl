// @run
// @log 3
// @log 4
// The same record with the parameter called directly at the field's own type, which ran before the
// field took what is written into it and must keep running (D15455).
function go(a, b) {
  const r = { f: a }
  r.f = b
  print(r.f(3))
  print(a(4))
}
function same<T>(k: T): T { k }
function dbl(x) { x }
go(same, dbl)
