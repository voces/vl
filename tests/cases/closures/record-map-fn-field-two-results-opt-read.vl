// @run
// @log 1.5
// A map of record literals whose function field holds functions of different results, called
// through `?.` on an entry read, runs the member the entry holds (D15801, D16743).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const m = Map()
m["a"] = { f: inc0 }
m["b"] = { f: half }
print(m["b"]?.f(3))
