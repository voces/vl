// @run
// @warning Unused parameter `b`
// @log x
// @log z
// @log 3
// @log 8
// A list of hole functions that a capturing lambda joins is called with a hole function; each
// named member is built at the signature its own call of the parameter gives, its result the
// handed function's there, so the closure the list holds is that instance.
function first(a, b) { return a }
function show(g) { print(g("x", 2)) }
const fs = [show]
function add(k: string) {
  fs.push((g) => {
    print(g(k, 1))
  })
}
add("z")
for f in fs { f(first) }

function plus(a, b) { return a + b }
function sum(g) { print(g(1, 2)) }
const gs = [sum, sum]
function put(k) {
  gs[1] = (g) => {
    print(g(k, 1))
  }
}
put(7)
for f in gs { f(plus) }
