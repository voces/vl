// @run
// @log 1
// @log 2
// @log 3
// @log 4
// @hint Intentionally-unused parameter `_b` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_y` (leading `_` marks it unused)
// A function written through a record or list holding the list, or into a list a call returns,
// runs when each call through the list passes it the types it takes; a field re-pointed at
// another list no longer holds the first (D12239).
function pick<A, B>(a: A, _b: B): A { a }
const fs = [pick]
const m = { xs: fs }
m.xs[0] = (x, _y: string) => x
print(fs[0](1, "s"))
const hs = [pick]
const gs = [hs]
gs[0][0] = (x, _y: string) => x
print(hs[0](2, "s"))
function mk() { [pick] }
const ks = mk()
ks[0] = (x, _y: string) => x
print(ks[0](3, "s"))
const ws = [pick]
const n = { xs: ws }
n.xs = [pick]
n.xs[0] = (x, _y: string) => x
print(ws[0](4, 5))
