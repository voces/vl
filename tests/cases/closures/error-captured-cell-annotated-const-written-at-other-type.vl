// @error cannot assign boolean to i32
// A value annotated `(n: i32) => void` written into a cell the instance wants at boolean (review of #3498, `rv3498/z05_concrete_const_into_cell_bool`).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function third<Z>(z: Z) { print("T"); print(z) }
function a<T>(x: T) {
  let k = inner
  const f: (n: i32) => void = inner
  const w = () => {
    k = f
  }
  w()
  k(x)
}
a(1)
a(true)
