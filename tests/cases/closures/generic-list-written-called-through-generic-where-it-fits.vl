// @run
// @log 3
// @log 1.5
// A list of a generic function pushed a fixed-type function runs when a generic function calls
// through it at the type that function takes, and through an un-annotated parameter at f64 (D10150, D10152).
function id<T>(x: T): T { x }
function inc(x: i32) { x + 1 }
function half(x: f64) { x / 2.0 }
const ys = [id]
ys.push(inc)
function run<U>(a: ((x: U) => U)[], u: U): U { a[1](u) }
print(run(ys, 2))
const zs = [id]
zs.push(half)
function go(a) { print(a[1](3.0)) }
go(zs)
