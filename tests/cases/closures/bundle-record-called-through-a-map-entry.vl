// @run
// @log 5 2.5
// @log 7 4.5
// @hint Intentionally-unused variable `_a`
// @hint Intentionally-unused variable `_b`
// A record of one closure per signature stored as a map's value, called through the map's
// entry after a null test, takes the member of each call's signature.
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
const m = Map()
m["k"] = lap((a) => a + 1)
if m["k"] != null {
  if m["k"](4) == 5 { print("\{m["k"](4)} \{m["k"](1.5)}") }
}
function run(k: i32) {
  const n = Map()
  n["a"] = lap((a) => a + k)
  if n["a"] != null { print("\{n["a"](4)} \{n["a"](1.5)}") }
}
run(3)
