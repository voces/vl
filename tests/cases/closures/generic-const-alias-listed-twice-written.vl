// @run
// @hint redundant type annotation: `inc` is inferred as `i32`
// @log 327
// @log 327
// @log 3
// @log 7
// @log ab
// @log 3
// @log true
// A generic bound by a `const` and listed in two lists, one of them written with a fixed-type
// function, while the other is called through at two types (D10081).
function id<T>(x: T): T { x }
function inc(x: i32): i32 { x + 1 }
const v = id
const xs = [v]
const ys = [v]
ys[0] = inc
print(ys[0](2) * 100 + xs[0](7) + xs[0]("ab").length * 10)

// The written list grows by a push instead.
const w = id
const ps = [w]
const qs = [w]
qs.push(inc)
print(qs[1](2) * 100 + ps[0](7) + ps[0]("ab").length * 10)

// Inside a function, with the alias also called directly at two types.
function main() {
  const u = id
  const as = [u]
  const bs = [u]
  bs[0] = inc
  print(bs[0](2))
  print(as[0](7))
  print(as[0]("ab"))
  print(u(3))
  print(u(true))
}
main()
