// @run
// @log 1.5
// @log 1.5
// @log 0.75
// @log 0.75
// @log 1.5
// @log 1.5
// @log 1.5 0.75
// @log 1.5
// @log 1.5
// @log 1
// A returned bundle's record delivered to a destination declared at one of its signatures takes
// that member, whatever reads the destination: an annotated return, a record field initialised and
// assigned, a list element initialised, assigned and pushed, a reassigned global, a map slot set
// both ways, nested records and lists, and an `i32` destination.
function lap(f) {
  f(2.5)
  f(3)
  return f
}
type W = { f: (x: f64) => f64 }
type N = { w: W }
function d(): (x: f64) => f64 { return lap((a) => a / 2) }
print(d()(3))
const w: W = { f: lap((a) => a / 2) }
print(w.f(3))
w.f = lap((a) => a / 4)
print(w.f(3))
const xs: ((x: f64) => f64)[] = [lap((a) => a / 2)]
xs[0] = lap((a) => a / 4)
xs.push(lap((a) => a / 2))
print(xs[0](3))
print(xs[1](3))
let g: (x: f64) => f64 = lap((a) => a + 1)
g = lap((a) => a / 2)
print(g(3))
const m: { [string]: (x: f64) => f64 } = Map()
m["k"] = lap((a) => a / 2)
m.set("j", lap((a) => a / 4))
const mk = m["k"]
const mj = m["j"]
if mk != null && mj != null { print("\{mk(3)} \{mj(3)}") }
const n: N = { w: { f: lap((a) => a / 2) } }
print(n.w.f(3))
const ys: ((x: f64) => f64)[][] = [[lap((a) => a / 2)]]
print(ys[0][0](3))
const zs: ((x: i32) => i32)[] = [lap((a) => a / 2)]
print(zs[0](3))
