// @run
// @log I
// @log 1
// @log O
// @log 1
// @log I
// @log s
// @log O
// @log s
// A `let` of generics handed to a generic's callback parameter at the enclosing generic's own
// type parameter, written between the hands: each hand calls what the `let` held there (D3942).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function callT<T>(f: (t: T) => void, t: T) { f(t) }
function g<T>(x: T) {
  let k = inner
  callT(k, x)
  k = other
  callT(k, x)
}
g(1)
g("s")
