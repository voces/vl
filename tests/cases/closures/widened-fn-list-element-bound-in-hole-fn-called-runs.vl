// @run
// @log 1.5
// @log 4
// @log 1.5
// @log 1.5
// An element of a widened list of functions of different results, bound to a local inside an
// un-annotated function and only ever called, reads the set the list holds: the call runs the
// member the element holds (D15365).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function one(xs) {
  const g = xs[1]
  print(g(3))
}
function first(xs) {
  const g = xs[0]
  print(g(3))
}
function back(xs) {
  const g = xs[1]
  return g(3)
}
const xs = [inc0]
xs.push(half)
one(xs)
first(xs)
print(back(xs))
const r = back(xs)
print(r)
