// @run
// @log 6
// @log 4
// @log 6
// @log 8
// @log 6
// @log 4
// @log 1
// A record holding a set's functions in a list of lists, re-pointed whole at a literal of a
// smaller set, is built at the binding's record, its lists at that record's fields (D16920).
function inc0(x) { return x + 1 }
function dbl(x) { return x * 2 }
let r = { f: [[inc0, dbl]] }
r = { f: [[dbl]] }
print(r.f[0][0](3))
let b = { f: [[inc0, dbl]] }
b = { f: [[dbl, inc0]] }
print(b.f[0][1](3))
let d = { f: [[[inc0, dbl]]] }
d = { f: [[[dbl]]] }
print(d.f[0][0][0](3))
let e = { f: [[inc0, dbl]], n: 1 }
e = { f: [[dbl]], n: 2 }
print(e.f[0][0](3) + e.n)
function g() {
  let l = { f: [[inc0, dbl]] }
  l = { f: [[dbl]] }
  print(l.f[0][0](3))
}
g()
let t = { f: [[inc0, dbl]] }
t = { f: [[dbl]] }
t = { f: [[inc0]] }
print(t.f[0][0](3))
let u = { f: [[inc0, dbl]] }
u = { f: [[dbl]] }
print(u.f.length)
