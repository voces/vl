// @error operator '*' is not defined for string and i32
// An arm after the first of a choice is judged at the call's argument types, as the first arm
// is through the call's own type (D13740).
function only(n, f) { return f(n) }
function twice(s) { return s + s }
function dbl(s) { return s * 2 }
const k = [1].length > 1
print(only("abc", if k { twice } else { dbl }))
