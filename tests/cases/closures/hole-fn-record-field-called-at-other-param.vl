// @run
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// @log 4
// @log 1.5
// @log 2.5
// @log 8
// @log 4
// @log 4
// @log 3.5
// @log 4
// @log 1.5
// A record of an un-annotated function whose field the callee calls at another un-annotated
// parameter's value instances the function at the type that call's argument pins (D9646).
function inc0(a) { return a + 1 }
function inc1(a) { return a + 1 }
function inc2(a) { return a + 1 }
function inc3(a) { return a + 1 }
function inc4(a) { return a + 1 }
function take(a, n) { print(a.f(n)) }
take({ f: inc0 }, 3)
take({ f: (_x: i32): f64 => 1.5 }, 4)
function takeF(a, n) { print(a.f(n)) }
takeF({ f: inc1 }, 1.5)
takeF({ f: (x: f64): f64 => x * 2.0 }, 4.0)
function flip(n, a) { print(a.f(n)) }
const r2 = { f: inc2 }
flip(3, r2)
function both(a, n) { print(a.f(n)) }
both({ f: inc3 }, 3)
both({ f: inc3 }, 2.5)
// Control: the parameter annotated.
function takeI(a, n: i32) { print(a.f(n)) }
takeI({ f: inc4 }, 3)
takeI({ f: (_x: i32): f64 => 1.5 }, 4)
