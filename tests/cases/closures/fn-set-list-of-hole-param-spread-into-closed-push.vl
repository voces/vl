// @log ss
// @log 20
// A hole parameter holding a function set, listed and spread into a push onto a list of a closed
// function type: the set stays closures, as a direct push keeps it (D15131).
function id<T>(x: T): T { return x }
function dbl<T>(x: T): T { return x + x }
function viaHole(a) {
  const zs = [a]
  const ys: ((x: i32) => i32)[] = []
  ys.push(...zs)
  print(ys[0](10))
}
let f = id
f = dbl
print(f("s"))
viaHole(f)
