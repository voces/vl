// @run
// @log 7
// @log none
// @log s
// @log 1.5
// @log 7

// D2599: a closure capturing an un-annotated copy of a nullable LIST binding types its env
// field at that list. The copied name resolves only through the frame's locals, which the
// capture's classifier does not have, so a bare `null` test on the copy found no list type.
type P = { a: i32 }

function ints(fill: boolean) {
  let h: i32[] | null = null
  if fill { h = [7] }
  const c = h
  const f = () => {
    const v = c
    if v != null { print(v[0]) } else { print("none") }
  }
  f()
}
ints(true)
ints(false)

function others() {
  const s: string[] | null = ["s"]
  const cs = s
  const d: f64[] | null = [1.5]
  const cd = d
  const r: P[] | null = [{ a: 7 }]
  const cr = r
  const f = () => {
    if cs != null { print(cs[0]) }
    if cd != null { print(cd[0]) }
    if cr != null { print(cr[0].a) }
  }
  f()
}
others()
