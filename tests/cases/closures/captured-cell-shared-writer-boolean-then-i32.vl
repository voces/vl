// @emit-error is written with a generic function inside a closure that every instance of the enclosing generic function shares
// A capture cell in a generic body is refused, not built at one instance's type, when the same, the instances in the other order
// wants it at two function types (D3939, `rv3498/v10`).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function a<T>(x: T) {
  let k = inner
  const toO = () => {
    k = other
  }
  toO()
  k(x)
}
a(true)
a(1)
