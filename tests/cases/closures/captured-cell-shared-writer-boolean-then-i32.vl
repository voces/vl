// @run
// @log O
// @log true
// @log O
// @log 1
// A capture cell in a generic body, written with a generic by a closure the instances share, is built at each instance's type, `boolean` first (D3939, D3957, `rv3498/v10`).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function a<T>(x: T) {
  let k = inner
  const toO = () => {
    k = other
  }
  toO()
  k(x)
}
a(true)
a(1)
