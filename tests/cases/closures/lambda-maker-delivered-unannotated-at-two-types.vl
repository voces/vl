// @run
// @log 1
// @log s
// @log 2.5
// @log 10
// @log 1
// @log 20
// @log s
// @log 1
// @log 3
// @log 2
// @log q
// A `const`-bound lambda maker whose un-annotated bindings call its result at two or more types builds
// a twin per type, as a named maker does (D16078).
const mk = () => {
  const l = (x) => x
  return l
}
function a() {
  const v = mk()
  print(v(1))
}
function b() {
  const v = mk()
  print(v("s"))
}
function c() {
  const v = mk()
  print(v(2.5))
}
a()
b()
c()
const mkp = (k: i32) => {
  const l = (x) => x
  print(k)
  return l
}
function d() {
  const v = mkp(10)
  print(v(1))
}
function e() {
  const v = mkp(20)
  print(v("s"))
}
d()
e()
let n = 0
const mkc = () => {
  const l = (x) => {
    n = n + 1
    print(n)
    return x
  }
  return l
}
const v1 = mkc()
print(v1(3))
const v2 = mkc()
print(v2("q"))
