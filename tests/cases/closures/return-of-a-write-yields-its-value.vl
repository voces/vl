// @run
// @log ww
// @log ww
// @log ww
// @log ww
// @log zz
// @log null
// @log 8
// @log 7
// @log 6
// @log 7
// @log 4
// @log 4
// @log 3
// A `return` of a write to a captured binding yields the write's right-hand side at the write's
// type, as a function's tail write does (D2285): a literal, a value of the cell's wider type, a
// write under an `if`, and a returned `if` whose arms write a field (D2170).
type K = "ww" | "zz"
type Node = { v: i32, left: Node | null }

function litIntoNullable() {
  let k: K | null = null
  const set = () => {
    return k = "ww"
  }
  print(set())
  print(k)
}
litIntoNullable()

function underIf(c: boolean) {
  let k: K | null = null
  function set() {
    if c { return k = "ww" }
    return "zz"
  }
  print(set())
  print(k)
}
underIf(true)
underIf(false)

function wideCell() {
  let n: i64 | null = null
  const set = () => {
    return n = 7
  }
  print(set() + 1)
  print(n)
}
wideCell()

function both(n: Node, v: i32) {
  const m: Node = { v: v, left: null }
  return if n.left == null { n.left = m } else { n.left = m }
}
const root: Node = { v: 5, left: null }
print(both(root, 6).v)
print(both(root, 7).v)

// A field of a wider type than the value written into it.
type R = { f: i32 | null }
function armWrite(r: R, c: boolean) { return if c { r.f = 3 } else { 4 } }
const r: R = { f: null }
print(armWrite(r, true) + 1)
print(armWrite(r, false))
print(r.f)
