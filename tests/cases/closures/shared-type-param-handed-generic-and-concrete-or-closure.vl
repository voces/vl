// @log 4
// @log 3
// @log 8
// @log 9
// @log dup
// @log 4
// A type parameter shared by a generic function and a concrete function or a closure binds no
// joined set, since neither of the others has an id in one (D15409).
function id<T>(x: T): T { x }
function dup<T>(x: T): T {
  print("dup")
  x
}
function inc(x: i32) { x + 1 }
function two<F>(a: F, c: F) {
  print(a(3))
  print(c(4))
}
two(id, inc)
two(inc, dup)
two(id, (x: i32) => x * 2)
two((x: i32) => x * 3, dup)
