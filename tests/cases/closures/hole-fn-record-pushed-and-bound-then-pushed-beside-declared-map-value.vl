// @run
// @log 4
// @log 5
// @log 2.5
// D9571: a record of an un-annotated function pushed as a literal onto one un-annotated list,
// and bound then pushed onto another, beside a declared record type of the same field name whose
// function returns f64, keeps both lists at the function's own row.
type R = { f: (a: i32) => f64 }
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const m: Map<string, R> = Map()
m.set("a", { f: half })
const p = []
p.push({ f: inc0 })
print(p[0].f(3))
const q = { f: inc0 }
const p2 = []
p2.push(q)
print(p2[0].f(4))
print(m.get("a")?.f(5) ?? 0.0)
