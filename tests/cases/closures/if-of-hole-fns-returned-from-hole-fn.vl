// @run
// @log a!
// @log b?
// @log c!
// @log d?
// @log 8
// @log -2.5
// @log e?
// A value `if` choosing between hole functions, returned from a hole function, takes the instance
// its call's result is called at: bound and called, handed to an annotated parameter, called
// directly, at two value types, and with an arm ending in a local `const` (D13040).
function exclaim(s) { return s + "!" }
function ask(s) { return s + "?" }
function pick(on) { return if on { exclaim } else { ask } }
const f = pick([1].length == 1)
const g = pick([1].length == 2)
print(f("a"))
print(g("b"))

function use(h: (s: string) => string) { return h("c") }
print(use(pick([1].length == 1)))
print(pick([1].length == 2)("d"))

function twice(x) { return x * 2 }
function neg(x) { return 0 - x }
function pickNum(on) { return if on { twice } else { neg } }
const n = pickNum([1].length == 1)
print(n(4))
const m = pickNum([1].length == 2)
print(m(2.5))

function pickLocal(on) {
  return if on {
    exclaim
  } else {
    const lv = ask
    lv
  }
}
print(pickLocal([1].length == 2)("e"))
