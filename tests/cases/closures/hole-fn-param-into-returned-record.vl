// @run
// @log 4
// @log 4
// @log 4
// @log 7
// @log 4
// An un-annotated function handed to an un-annotated parameter that the callee wraps in a
// record literal: returned directly, bound and called, nested one record deeper and bound,
// through a `const` copy, and beside a second field (D16738: the record's row held a closure while the
// call handed the function's id, so the module did not validate).

function inc0(a) { return a + 1 }
function mk(f) { return { f: f } }
function mk2(f) { return { r: { f: f } } }
function mkc(f) {
  const g = f
  return { f: g }
}
function mkn(f) { return { f: f, n: 4 } }

print(mk(inc0).f(3))
const r = mk(inc0)
print(r.f(3))
const q = mk2(inc0)
print(q.r.f(3))
print(mkc(inc0).f(6))
const m = mkn(inc0)
print(m.f(m.n - 1))
