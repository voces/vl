// @run
// @warning This branch is never taken: a preceding condition is always `true`
// @hint Intentionally-unused parameter `_g` (leading `_` marks it unused)
// @log 30
// @log 0.75
// A module choice of two hole functions, one never reading its parameter, handed a named hole
// function the other calls at two types: the unread member takes the id too (D15038).
function add(a, b) { return a + b }
function apply3(g) {
  print(g(10, 20))
  print(g(0.5, 0.25))
}
function apply2(_g) {}
const f = if true { apply3 } else { apply2 }
f(add)
