// @emit-error a list holding a generic function is called through its elements at more than one type
// Inside a function the checker adapts the write to the type of the list's first call, so the
// list is followed through the adapter and refused as a list of the generic is (D4246).
function idg<T>(t: T): T { return t }
function main() {
  let x = idg
  x = idg
  const y = [x]
  print(y[0]("z"))
  print(y[0](1))
}
main()
