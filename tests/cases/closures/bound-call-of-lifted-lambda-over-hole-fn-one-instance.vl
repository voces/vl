// @run
// @log 8
// @log 9
// @log 16
// A call of a lambda-lifted lambda over a captured hole function, bound to a local in the hole
// function's one instance, is typed at the lifted lambda's result (D17664's one-instance face).
function add(a, b) { return a + b }
function mul(a, b) { return a * b }
function app(g, s) { return g(s, s) }
function p1(h) {
  const run = (x) => app(h, x)
  const v = run(4)
  print(v)
}
p1(add)
function p2(h) {
  const run = (x) => app(h, x)
  const v = run(4)
  print(v + 1)
}
p2(add)
function p3(h) {
  const run = (x) => app(h, x)
  const v = run(4)
  const w = v
  print(w)
}
p3(mul)
