// @run
// @log 20
// @log 34
// @log 105
// @log 55
// An annotated lambda in a set of un-annotated functions, dispatched at each call position.
function inc(a) { return a + 1 }
// pushed onto a list, called through an index, the value printed
const xs = [inc]
xs.push((x: i32): i32 => x * 10)
print(xs[1](2))
// called in a walk, the value summed
let total = 0
for f in xs { total = total + f(3) }
print(total)
// a statement call whose value is dropped
xs[1](4)
// a lambda capturing a local, inside a function
function local(k: i32) {
  const ys = [inc]
  ys.push((x: i32): i32 => x + k)
  print(ys[1](5))
}
local(100)
// two annotated lambdas in one set
const zs = [inc]
zs.push((x: i32): i32 => x - 1)
zs.push((x: i32): i32 => x * x)
print(zs[1](7) + zs[2](7))
