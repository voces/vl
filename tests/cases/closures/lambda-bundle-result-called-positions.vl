// @run
// @log 6
// @log 5
// @log 7
// @log 6
// @log 5
// @log 8
// @log 12
// @log 4
// A `const` lambda returning a hole lambda's bundle, its call's result called at once, at each
// position the outer call can stand in: statement, parenthesised, f64 member, operand, argument,
// return, loop body and condition.
function lap(f) {
  f(2.5)
  f(3)
  return f
}
function show(x: i32) { print(x) }
function ret(): i32 {
  const d = () => lap((a) => a * 2)
  return d()(3)
}
function main(n: i32) {
  const d = () => lap((a) => a * 2)
  print(d()(3))
  print((d())(2.5))
  print(d()(3) + 1)
  show(d()(3))
  const e = () => lap((a) => a + n)
  print(e()(4))
  print(ret() + 2)
  let s = 0
  for i in 0 to 2 { s = s + d()(i + 1) }
  print(s)
  if d()(3) == 6 { print(d()(2)) }
}
main(1)
