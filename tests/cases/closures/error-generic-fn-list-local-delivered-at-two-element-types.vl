// @error a list is passed as the same storage, so its element type cannot differ between `zs` and this destination
// A local list of a generic function is one storage, so handing it to parameters of two closed
// element types meets two signatures there: refused by the container contract (D17843).
function id<T>(x: T): T { return x }
function runS(a: ((x: string) => string)[]) { print(a[1]("s")) }
function runI(a: ((x: i32) => i32)[]) { print(a[1](2)) }
function f() {
  let zs = [id, id]
  runI(zs)
  runS(zs)
}
f()
