// @run
// @info `lap2` is never reassigned; use `const` instead of `let`
// @log 2
// @log s
// @log 2
// @log r
// @log 3
// @log t
// @log 4
// @log u
// @log 5
// @log v
// @log 6
// A lambda called directly with a generic it calls at two signatures, beside a lambda calling
// that generic at one: the generic is handed as one closure per signature, through a second
// generic, a `let`, a hole parameter, and a list.
function id(a) { return a }
function id2(a) { return a }
const lap = (g) => {
  print(g(1) + 1)
  return g("s")
}
print(lap(id))
const lapR = (g) => {
  print(g(1) + 1)
  return g("r")
}
print(lapR(id2))
let lap2 = (g) => {
  print(g(2) + 1)
  return g("t")
}
print(lap2(id))
function use(k) { return k(id) }
const lap3 = (g) => {
  print(g(3) + 1)
  return g("u")
}
print(use(lap3))
const lap4 = (g) => {
  print(g(4) + 1)
  return g("v")
}
const fs = [lap4]
print(fs[0](id))
const one = (g) => g(5) + 1
print(one(id))
