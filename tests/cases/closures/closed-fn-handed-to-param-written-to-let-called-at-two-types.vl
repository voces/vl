// @run
// @hint redundant type annotation
// @log 6
// @log x
// @log 9
// @log x
// @log 8
// @log y
// A closed function handed to a parameter that a `let` is written from, the `let` called at one
// type and the parameter beside it at another, delivers its own id (D15456): with and without a
// written result, in either argument order, and two closed functions at two calls.
function same(x) { return x }
function dbl(x: i32): i32 { return x * 2 }
function tri(x: i32) { return x * 3 }
function go(a, b) {
  let hh = a
  hh = b
  print(hh(3))
  print(a("x"))
}
go(same, dbl)
go(same, tri)
function og(a, b) {
  let hh = b
  hh = a
  print(hh(4))
  print(b("y"))
}
og(dbl, same)
