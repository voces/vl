// @run
// @log O
// @log 3
// @log O
// @log true
// An alias of a written cell placed in a list and called at one type, then delivered at another,
// splits per call type and runs (D7102).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function cb(f: (b: boolean) => void, b: boolean) { f(b) }
function main() {
  let k = inner
  const flip = () => {
    k = other
  }
  flip()
  const r = k
  const fs = [r]
  fs[0](3)
  cb(r, true)
}
main()
