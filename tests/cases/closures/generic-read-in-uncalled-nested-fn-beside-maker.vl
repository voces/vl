// @run
// @log true
// @log 2.5
// @warning Unused function `local`
// A generic read as a value inside a nested named function nothing calls stands as its set's
// id, as a top-level read does; a maker's result is still called at two types.
function k<T>(x: T): T { return x }
function local() {
  function unused() { return k }
}
function mk() { return k }
const c = mk()
print(c(true))
print(c(2.5))
