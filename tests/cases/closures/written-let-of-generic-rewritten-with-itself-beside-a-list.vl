// @run
// @log s
// @log 1
// A written `let` of a generic called at a string beside a list of the same generic called at an
// i32: the list's call does not reach the `let`, so the `let` keeps its own instance (D4890).
function k<T>(x: T): T { return x }
function main() {
  let f = k
  f = k
  print(f("s"))
  const fs = [k]
  print(fs[0](1))
}
main()
