// @run
// @warning Unused variable `g` (prefix with `_` to suppress, or remove it)
// @log 1.5
// A function written into an un-annotated list through a parameter is also the writer's result,
// held and never called: the result is the written function's id (D16230).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function put(ys) { ys[0] = half }
const xs = [inc0]
const g = put(xs)
print(xs[0](3))
