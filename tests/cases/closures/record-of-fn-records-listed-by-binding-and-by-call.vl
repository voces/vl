// @run
// A record holding a function field nothing calls is listed by a binding read and by a call
// result; the list holds each at the record its value is held at (D17677).
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function mk(k: i32) {
  const v = { r: { f: inc0 }, s: { f: dbl } }
  let m = v
  if k > 0 { m = { r: { f: dbl }, s: { f: dbl } } }
  return m
}
const xs = [mk(0), mk(1)]
const w = { r: inc0, s: dbl }
const ws = [w]
print(xs[0].r.f(6))
print(xs[1].r.f(6))
print(ws[0].r(6))
// @log 7
// @log 12
// @log 7
