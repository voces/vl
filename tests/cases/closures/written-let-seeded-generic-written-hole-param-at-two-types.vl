// @log 6
// A `let` seeded with a generic and written an un-annotated parameter holds the set's id when
// every call of the function hands that parameter one of the set's members (D15053).
function id<T>(x: T): T {
  print("I")
  x
}
function tw<T>(x: T): T {
  print("W")
  x
}
function take(a) {
  let b = id
  print(b(1))
  b = a
  print(b("s"))
  print(b(7))
}
take(id)
take(tw)
function same<T>(x: T): T {
  print("S")
  x
}
function other<T>(x: T): T {
  print("O")
  x
}
function turns(a, c) {
  let b = same
  b = a
  print(b("w"))
  b = c
  print(b(6))
}
turns(same, other)
turns(other, same)
