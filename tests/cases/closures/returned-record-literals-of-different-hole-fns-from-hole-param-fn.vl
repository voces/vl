// @run
// @log 2
// @log 2.5
// A function of an un-annotated parameter returning one of two record literals of different
// un-annotated functions builds each literal at the row its instance types it (D15305).
function id1(a) { return a }
function id2(a) { return a }
function mk(c) {
  if c { return { f: id1 } }
  return { f: id2 }
}
print(mk(true).f(2))
print(mk(false).f(2.5))
