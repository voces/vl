// @run
// @log 7
// @log 7
// @warning Container `ys` is written but never read (remove it)
// @warning Container `zs` is written but never read (remove it)
// A binding whose cell holds a tagged set's id, listed in a list whose write closes its element
// type and which nothing calls through, is that member's closure in the list.
function id<T>(x: T): T { x }
function inc(x: i32) { x + 1 }
function mk() { return id }
const v = mk()
const ys = [v]
ys[0] = inc
print(v(7))
let w = id
w = id
const zs = [w]
zs[0] = inc
print(w(7))
