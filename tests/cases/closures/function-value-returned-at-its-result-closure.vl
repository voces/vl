// @run
// @log 3
// @log q
// @log 8
// A function value returned by an un-annotated function is the same closure at the closure
// type the function's result takes, generic or not, for each destination it is delivered to.
function same<T>(k: T): T { return k }
function d1() { return same }
const v1: (k: i32) => i32 = d1()
print(v1(3))
const w1: (k: string) => string = d1()
print(w1("q"))
function twice(n: i32) { return n * 2 }
function pick() { return twice }
const t: (n: i32) => i32 = pick()
print(t(4))
