// @run
// @log 1
// @log 5
// @log 1
// @log 5
// The forwarder hands on a `const` copy of its hole parameter, which holds the parameter's value:
// the forwarder binds at the set the list joins, as it does handing on the parameter itself.
function id<T>(x: T): T { x }
function id2<U>(x: U): U { x }
function use(ys) { print(ys.length) }
function take(a, b) {
  const xs = [a]
  xs[0] = b
  use(xs)
  print(xs[0]("abc").length + xs[0](2))
}
function fwd(f) {
  const g = f
  take(g, id2)
}
function fwd2(f) {
  const g = f
  const h = g
  take(h, id2)
}
fwd(id)
fwd2(id)
