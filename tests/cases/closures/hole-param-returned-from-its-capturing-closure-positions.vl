// @log true
// A closure returning a captured hole parameter returns it at the row its capture slot stores, as
// a lambda, a named closure, an `if` join and a block body, read at the call (D17676). Bound or held
// in a field: `functions/hole-param-returned-at-its-delivered-row-positions.vl`. An argument to an
// annotated parameter (D17681).
type J = { f: i32 | null }
function mk2() { return { f: null } }
const dA: J = mk2()
function viaLambda(y) {
  const b = () => y
  const _h = { w: y }
  return b().f == null
}
function viaNamed(y) {
  function b() { return y }
  const _h = { w: y }
  return b().f == null
}
function viaJoin(y, c: boolean) {
  const b = () => if c { y } else { y }
  const _h = { w: y }
  return b().f == null
}
function viaBlock(y) {
  const b = () => {
    return y
  }
  const _h = { w: y }
  return b().f == null
}
function useJ(j: J) { return j.f == null }
function viaArg(y) {
  const b = () => y
  const _h = { w: y }
  return useJ(b())
}
function annotated(y: J) {
  const b = () => y
  return b().f == null
}
print(viaLambda(mk2()))
print(viaNamed(mk2()))
print(viaJoin(mk2(), [1].length > 0))
print(viaBlock(mk2()))
print(viaArg(mk2()))
print(annotated(dA))
