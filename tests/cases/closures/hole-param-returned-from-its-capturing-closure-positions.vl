// @run
// @log true
// @log true
// @log true
// @log true
// @log true
// @log true
// A closure returning a captured hole parameter returns it at the row its capture slot stores,
// whatever spelling holds the closure or reads its result (D17676). An argument position waits on
// D17681.
type J = { f: i32 | null }
function mk2() { return { f: null } }
const dA: J = mk2()
function viaLambda(y) {
  const b = () => y
  const h = { w: y }
  return b().f == null
}
function viaNamed(y) {
  function b() { return y }
  const h = { w: y }
  return b().f == null
}
function viaBinding(y) {
  const b = () => y
  const h = { w: y }
  const r = b()
  return r.f == null
}
function viaField(y) {
  const b = () => y
  const h = { w: y }
  const o = { v: b() }
  return o.v.f == null
}
function annotated(y: J) {
  const b = () => y
  return b().f == null
}
function viaLet(y) {
  const z = y
  const b = () => z
  const h = { w: y }
  return b().f == null
}
print(viaLambda(mk2()))
print(viaNamed(mk2()))
print(viaBinding(mk2()))
print(viaField(mk2()))
print(annotated(dA))
print(viaLet(mk2()))
