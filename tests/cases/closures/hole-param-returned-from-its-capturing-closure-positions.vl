// @run
// @log true
// @log true
// @log true
// @log true
// @log true
// A closure returning a captured hole parameter returns it at the row its capture slot stores, as
// a lambda, a named closure, an `if` join and a block body, read at the call (D17676). Held in a
// binding or a field it waits on D17682; reached through an annotated parameter, on D17681.
type J = { f: i32 | null }
function mk2() { return { f: null } }
const dA: J = mk2()
function viaLambda(y) {
  const b = () => y
  const h = { w: y }
  return b().f == null
}
function viaNamed(y) {
  function b() { return y }
  const h = { w: y }
  return b().f == null
}
function viaJoin(y, c: boolean) {
  const b = () => if c { y } else { y }
  const h = { w: y }
  return b().f == null
}
function viaBlock(y) {
  const b = () => { return y }
  const h = { w: y }
  return b().f == null
}
function annotated(y: J) {
  const b = () => y
  return b().f == null
}
print(viaLambda(mk2()))
print(viaNamed(mk2()))
print(viaJoin(mk2(), [1].length > 0))
print(viaBlock(mk2()))
print(annotated(dA))
