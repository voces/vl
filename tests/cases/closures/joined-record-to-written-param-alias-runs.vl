// @run
// @log 4
// @log 2
// @log 2
// @log 4
// @log 5
// A joined record of un-annotated functions handed to an un-annotated parameter, bound to a `let`
// the callee re-points to its own record literal, calls the literal's function as one of the
// parameter's set: after a read, before any read, and with another member (D16137).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function two() { [1, 2].length }
function take(a) {
  let v = a
  print(v.f(3))
  v = { f: half }
  print(v.f(4))
}
function first(a) {
  let v = a
  v = { f: half }
  return v.f(4)
}
function other(a) {
  let v = a
  print(v.f(3))
  v = { f: inc0 }
  print(v.f(4))
}
const r = if two() < 5 { { f: inc0 } } else { { f: half } }
take(r)
print(first(r))
other(r)
