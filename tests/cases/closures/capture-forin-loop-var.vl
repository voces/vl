// @run
// @log 4
// @log 3
// @log 6
// @log q
// @log 3
// @log -1
// @log 10
// @log 11
// @log 4
// @log -1
// @log 4
// A closure capturing either name of a `for` walk captures that name's own value: a map's value
// beside its key, a sequence's index beside its element, and a `T | null` element or value box
// that the closure narrows or coalesces.
type P = { x: i32 }

const m: {[string]: i32} = Map()
m["a"] = 3
for k, v in m {
  const g = () => v + 1
  print(g())
}

const f: {[i32]: f64} = Map()
f[1] = 1.5
for k, v in f {
  const g = () => v * 2.0
  print(g())
}

const ps: {[string]: P} = Map()
ps["a"] = { x: 5 }
for k, v in ps {
  const g = () => v.x + 1
  print(g())
}

const sl: {[string]: string[]} = Map()
sl["a"] = ["p", "q"]
for k, v in sl {
  const g = () => v[1]
  print(g())
}

const nb: {[string]: i32 | null} = Map()
nb["a"] = 3
nb["b"] = null
for k, v in nb {
  const g = () => v ?? -1
  print(g())
}

const xs = ["a", "b"]
for x, i in xs {
  const g = () => i + 10
  print(g())
}

const ns = [3, null]
for v in ns {
  const g = () => {
    if v != null { return v + 1 }
    return -1
  }
  print(g())
}

for v in nb.values() {
  const g = () => (v ?? 0) + 1
  if v != null { print(g()) }
}
