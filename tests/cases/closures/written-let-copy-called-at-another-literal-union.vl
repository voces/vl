// @run
// @log B
// @log r
// @log B
// @log q
// A copy of a written binding called at one literal union, while the function it holds is
// called directly at another: the copy runs the instance of its own atom set (D4893).
function gA<U>(u: U) {
  print("A")
  print(u)
}
function gB<V>(v: V) {
  print("B")
  print(v)
}
function gC<W>(w: W) {
  print("C")
  print(w)
}
type S = "p" | "q"
type R = "p" | "r"
const a: S = "q"
const b: R = "r"
let x1 = gA
x1 = gB
let y = gC
y = x1
gB(b)
y(a)
