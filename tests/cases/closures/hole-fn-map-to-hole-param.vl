// @run
// @log 1
// @log 2
// @log 1
// A map of un-annotated functions handed to an un-annotated parameter takes the map's own
// type at the instance (D9180).
function inc0(a) { return a + 1 }
const hm = Map()
hm["k"] = inc0
function f(mm) { return mm.length }
print(f(hm))
const sm = Map()
sm.set("a", inc0)
sm.set("b", inc0)
print(f(sm))
function inner() {
  const lm = Map()
  lm["k"] = inc0
  return f(lm)
}
print(inner())
