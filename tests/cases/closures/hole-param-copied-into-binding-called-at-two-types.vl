// @run
// @info `b` is never reassigned; use `const` instead of `let`
// @log x
// @log 3
// @log y
// @log 4
// @log z
// @log 5
// @log true
// @log z
// @log 5
// @log true
// @log w
// @log 6
// A hole parameter copied into a binding the body calls at two types takes one parameter per
// type, and each copy reads its own (D6530): a seeded `let` written with it, a `const` copy, an
// un-seeded `let` called at three types from two calls, and two parameters written in turn.
function same<T>(k: T): T { k }
function other<T>(k: T): T { k }
function seeded(a) {
  let b = same
  b = a
  print(b("x"))
  print(b(3))
}
seeded(same)
function copied(a) {
  const b = a
  print(b("y"))
  print(b(4))
}
copied(same)
function three(a) {
  let b = a
  print(b("z"))
  print(b(5))
  print(b(true))
}
three(same)
three(other)
function turns(a, c) {
  let b = same
  b = a
  print(b("w"))
  b = c
  print(b(6))
}
turns(same, other)
