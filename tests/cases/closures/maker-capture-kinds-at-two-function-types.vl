// A maker returning a lambda bound to a `const` that captures a local, delivered at two function
// types: the first instance's lambda reads its capture at the binding's own type as a later one
// does, for an f64, a string, a bool, a record, a captured parameter and a capture two lambdas
// deep.
let calls = 0
function f64Maker() {
  calls = calls + 1
  const k = calls * 1.5
  const l = (x) => {
    print(k); return x
  }
  return l
}
const fa: (x: i32) => i32 = f64Maker()
const fb: (x: string) => string = f64Maker()
print(fa(1))
fa(1)
print(fb("s"))
function strMaker() {
  const k = "k"
  const l = (x) => {
    print(k); return x
  }
  return l
}
const sa: (x: i32) => i32 = strMaker()
const sb: (x: boolean) => boolean = strMaker()
print(sa(2))
print(sb(true))
function boolMaker() {
  const k = calls > 0
  const l = (x) => {
    print(k); return x
  }
  return l
}
const ba: (x: i32) => i32 = boolMaker()
const bb: (x: string) => string = boolMaker()
print(ba(3))
print(bb("u"))
function recMaker() {
  const k = { a: 7, b: 2.5 }
  const l = (x) => {
    print(k.a); return x
  }
  return l
}
const ra: (x: i32) => i32 = recMaker()
const rb: (x: string) => string = recMaker()
print(ra(4))
print(rb("v"))
function paramMaker(p: f64) {
  const l = (x) => {
    print(p); return x
  }
  return l
}
const pa: (x: i32) => i32 = paramMaker(2.5)
const pb: (x: string) => string = paramMaker(2.5)
print(pa(5))
print(pb("t"))
function deepMaker() {
  const k = 4.5 * 2
  const l = (x) => {
    const inner = () => k
    print(inner()); return x
  }
  return l
}
const da: (x: i32) => i32 = deepMaker()
const db: (x: string) => string = deepMaker()
print(da(6))
print(db("w"))
