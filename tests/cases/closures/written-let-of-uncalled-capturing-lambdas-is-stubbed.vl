// @run
// @log 2.5
// @log 2.5
// @log 3
// A reassigned `let` of lambdas nothing calls, capturing the enclosing function's parameter, is
// stubbed as a `const` of one is: its lambdas have no instance to type their parameter at (D17848).
function f(a) {
  let c = (x) => x + a
  c = (x) => x * a
  return a
}
print(f(2.5))
function fa(a: f64) {
  let c = (x) => x + a
  c = (x) => x * a
  const _d = c
  return a
}
print(fa(2.5))
let t = (x) => x + 1
t = (x) => x * 2
print(3)
