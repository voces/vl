// @error cannot assign boolean to i32
// A concrete function written into a cell whose one instance wants boolean (review of #3498, `rv3498/z23_concrete_const_one_inst_bool`).
function inner<U>(u: U) { print("I"); print(u) }
function other<V>(v: V) { print("O"); print(v) }
function a<T>(x: T) {
  let k = inner
  const f: (n: i32) => void = other
  const w = () => {
    k = f
  }
  w()
  k(x)
}
a(true)
