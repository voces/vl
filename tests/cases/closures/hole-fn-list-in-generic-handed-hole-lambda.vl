// @run
// @log 3
// @log 30
// @log z
// A loop over a list of hole functions inside a generic, handed an un-annotated lambda, takes
// the lambda at the type the elements' own calls give it (D7846).
function apply2(g) { print(g(1, 2)) }
function apply3(g) { print(g(10, 20)) }
function run<T>(x: T) {
  const fs = [apply2, apply3]
  for f in fs { f((a, b) => a + b) }
  print(x)
}
run("z")
