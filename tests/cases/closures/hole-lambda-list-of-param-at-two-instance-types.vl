// @run
// @log 1
// @log 1
// @log 1
// @log true
// A hole lambda in a generic body that builds a list of its parameter is keyed under each instance
// at that instance's own pin only, so each clone reads its list at its own type (D15112).
function a<T>(x: T) {
  const k = (u) => {
    print([u].length)
  }
  k(x)
}
a(1)
a(true)
function b<T>(x: T) {
  const k = (u) => {
    const w = [u, u]
    print(w[0])
  }
  k(x)
}
b(1)
b(true)
