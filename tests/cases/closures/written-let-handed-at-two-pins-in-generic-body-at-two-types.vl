// @run
// @log 8
// @log y
// @log 7
// @log 1.5
// @log 8
// @log false
// @log 8
// @log y
// @log 7
// @log 1.5
// @log 8
// @log y
// @log 7
// @log 1.5
// A written `let` of generics inside a generic body instanced at several types, handed at two
// pins or called at two, reads one split `let` per pin in every instance (D9131).
function fst<T>(xs: T[]): T { return xs[0] }
function lst<T>(xs: T[]): T { return xs[xs.length - 1] }
function app<T>(g: (x: T[]) => T, v: T[]): T { return g(v) }
function both<U>(u: U[]): U {
  let f = fst
  if u.length > 1 { f = lst }
  print(app(f, [7, 8]))
  app(f, u)
}
print(both(["x", "y"]))
print(both([1.5]))
print(both([true, false]))
function direct<U>(u: U[]): U {
  let f = fst
  if u.length > 1 { f = lst }
  print(f([7, 8]))
  f(u)
}
print(direct(["x", "y"]))
print(direct([1.5]))
function aliased<U>(u: U[]): U {
  let f = fst
  if u.length > 1 { f = lst }
  const g = f
  print(app(g, [7, 8]))
  app(g, u)
}
print(aliased(["x", "y"]))
print(aliased([1.5]))
