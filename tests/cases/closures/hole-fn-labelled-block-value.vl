// @run
// @hint Intentionally-unused variable `_x`
// @hint Intentionally-unused variable `_w`
// @hint Intentionally-unused parameter `_p`
// @hint Intentionally-unused variable `_z`
// @log a?
// @log 1
// @log 2
// @log 3
// A labelled block no `break` leaves, whose value is an uncalled hole function, is that value:
// bound and never read, bound and called, handed to a parameter nothing reads, inside a function,
// and as an `if` arm, it runs (D6990).
function exclaim(s) { return s + "!" }
function shout(s) { return s + "?" }
function g(_p) { print(1) }
const on = [1].length == 1
const _x = @B { exclaim }
const y = @B { shout }
print(y("a"))
g(@B { exclaim })
function h() {
  const _z = @B { exclaim }
  print(2)
}
h()
const _w = if on { @B { exclaim } } else { exclaim }
print(3)
