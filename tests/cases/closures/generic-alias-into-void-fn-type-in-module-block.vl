// @run
// @log 4
// @log 5
// @log 6
// @log 7
// An alias of a generic delivered into an annotated `void` function type inside a module-scope
// block is called as a statement with nothing to drop: a `const` in a bare block, a `let` in an
// `if` block, that `let` reassigned, and the alias passed to a parameter of the type (D5230).
function gA<U>(u: U) { print(u) }
function each(f: (s: i32) => void, n: i32) { f(n) }
const x = gA
{
  const v: (s: i32) => void = x
  v(4)
}
if true {
  let w: (s: i32) => void = x
  w(5)
  w = gA
  w(6)
  each(x, 7)
}
