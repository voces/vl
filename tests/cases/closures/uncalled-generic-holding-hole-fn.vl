// @run
// @log 0
// @warning Unused function `hold`
// @hint Intentionally-unused variable `_k`
// @hint Intentionally-unused parameter `_x`
// A generic function nothing calls, binding a hole function nothing calls, is built as stubs: the
// template is pruned, and no slot emits the body that held the binding (D6961).
function exclaim(s) { return s + "!" }
function hold<T>(_x: T) {
  const _k = exclaim
  print(1)
}
print(0)
