// An annotated local function binding types only itself: a binding of the same name elsewhere,
// holding a function through a hole, is called at its own argument types (D5972).
function fw(f) { return f }
function id(x) { return x }
function k<T>(x: T): T { return x }
function local() {
  const h: (x: i32) => i32 = id
  print(h(3))
}
function other() {
  const h = fw(id)
  print(h("w"))
}
function generic() {
  const h: (x: i32) => i32 = k
  print(h(3))
  const q = fw(k)
  print(q("w"))
}
function blockThenFn() {
  if true {
    const h: (x: i32) => i32 = id
    print(h(3))
  }
  const h = fw(id)
  print(h("w"))
}
function nestedShadow() {
  let h = fw(id)
  if true {
    const h: (x: i32) => i32 = id
    print(h(3))
  }
  print(h("w"))
}
function wide() {
  const h: (x: f64) => f64 = id
  print(h(1.5))
}
const lam = () => {
  const h: (x: i32) => i32 = id
  print(h(3))
}
local()
other()
generic()
blockThenFn()
nestedShadow()
wide()
const w = fw(id)
print(w(2))
lam()
const h = fw(id)
print(h("w"))
