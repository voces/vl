// @run
// @warning Unused parameter
// @log x2
// @log y20
// @log 2
// @log 20
// The D10701 witness: two loops over one list of hole functions, handed functions of different
// results, each read a copy of the list holding the elements at their own type.
import { toString } from "std:fmt"

function cat(a, b) { return a + b.toString() }
function snd(a, b) { return b }
function apply2(g) { print(g("x", 2)) }
function apply3(g) { print(g("y", 20)) }
const fs = [apply2, apply3]
for f in fs { f(cat) }
for f in fs { f(snd) }
