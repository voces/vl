// @run
// @log 35
// @log 36
// @log 35
// @log 37
// @hint redundant type annotation: `arr` is inferred as `(() => void)[]` — remove it to lean on inference
// Regression (silent-class-inventory D945).
//
// A CONSUMED void-typed closure value was check-clean invalid wasm in both of its ref
// containers — read out of a RETURN slot and out of a `(() => void)[]` element — with the
// engine reporting `expected a type but nothing on stack`. Building one and passing it as an
// argument always worked.
//
// THE SCOPE SPLIT IS WHAT NAMES IT. The identical body inside a function RAN; only module
// scope failed. `emitCallStmt` drops a call statement's result unless it knows the callee is
// void, and for a closure VALUE that knowledge is `calleeReturnsVoid` → the resolved `$fnsig`
// key. Every rung of that resolution chain answers about a NAME — a narrowed arm, a
// parameter, a function-type annotation, a lifted closure, a copy of another binding — and
// `const m = mk()` is none of them: its initializer is a CALL. The key came back "", void
// went unrecognised, a `drop` was emitted, and there was nothing to drop.
//
// The rung added reads the CHECKER's recorded type of the initializer rather than any
// spelling, so it answers for a call, an indexed read and a field read alike — the three
// consumption containers this row named. It sits after every name rung, so nothing that
// resolved before resolves differently.
//
// STILL LOUD, and correctly: the immediate-call spelling `mk()()` refuses with
// `emitProgram: bare call statement is not supported`. That is a different sentence and a
// different mechanism — a callee that is a CALL, not a binding — and it is loud rather than
// silent, so it is not swept in here.
function mk(): () => void {
  return () => {
    print(35)
  }
}

// 1 — RETURN slot, at MODULE scope: the row's own witness
const m = mk()
m()
print(36)

// 2 — `(() => void)[]` ELEMENT, bound then called
function hv() { print(35) }
const arr: (() => void)[] = [hv]
const c0 = arr[0]
c0()
print(37)
