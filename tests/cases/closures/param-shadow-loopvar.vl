// @run
// @log inner|1.5|inner|2.5|

// D2325 — a `for g in closures` LOOP VARIABLE shadowed by a block-local `const g` inside the
// body. The shadow's block resolves to the const; the rest of the body still sees the loop
// variable.

function f(closures: (() => f64)[]) {
  let out = ""
  for g in closures {
    {
      const g = () => "inner"
      out = out + g() + "|"
    }
    out = out + "\{g()}" + "|"
  }
  out
}
print(f([() => 1.5, () => 2.5]))
