// @run
// @info `run` is never reassigned; use `const` instead of `let`
// @hint redundant type annotation: `addF` is inferred as `f64` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// @hint redundant type annotation: `mulF` is inferred as `f64` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// @log 3
// @log 2.25
// @log 5
// @log 6.25
// @log 0
// @log 3
// @log 2.25
// @log 3
// @log 2.25
// @log 4
// @log 4
// @log 3
// @log 2.25
// @log 3
// @log 2.25
// A lambda or nested function handing on a captured hole function reads the pin of the
// enclosing function's own instance, when that function is called with two generics (D13720).
function add(a, b) { return a + b }
function mul(a, b) { return a * b }
function sub(a, b) { return a - b }
function apply2(g, s) { print(g(s, s)) }
function apply2r(g, s) { return g(s, s) }
function viaLambda(h) {
  const run = (x) => {
    apply2(h, x)
  }
  run(1.5)
}
viaLambda(add)
viaLambda(mul)
// A named nested function, at three generics.
function viaNested(h) {
  function run(x) { apply2(h, x) }
  run(2.5)
}
viaNested(add)
viaNested(mul)
viaNested(sub)
// A lambda inside a lambda.
function viaTwoDeep(h) {
  const run = (x) => {
    const inner = (y) => {
      apply2(h, y)
    }
    inner(x)
  }
  run(1.5)
}
viaTwoDeep(add)
viaTwoDeep(mul)
// A `let` lambda, and one whose value is returned.
function viaLet(h) {
  let run = (x) => {
    apply2(h, x)
  }
  run(1.5)
}
viaLet(add)
viaLet(mul)
function viaReturn(h) {
  const run = (x) => apply2r(h, x)
  print(run(2))
}
viaReturn(add)
viaReturn(mul)
// The annotated face: every destination written.
function addF(a: f64, b: f64): f64 { return a + b }
function mulF(a: f64, b: f64): f64 { return a * b }
function apply2F(g: (a: f64, b: f64) => f64, s: f64) { print(g(s, s)) }
function viaTyped(h: (a: f64, b: f64) => f64) {
  const run = (x: f64) => {
    apply2F(h, x)
  }
  run(1.5)
}
viaTyped(addF)
viaTyped(mulF)
// The enclosing parameter alone annotated.
function viaAnnotated(h: (a: f64, b: f64) => f64) {
  const run = (x) => {
    apply2(h, x)
  }
  run(1.5)
}
viaAnnotated(add)
viaAnnotated(mul)
