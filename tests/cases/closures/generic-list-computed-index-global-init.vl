// @run
// @info `i` is never reassigned; use `const` instead of `let`
// @info `j` is never reassigned; use `const` instead of `let`
// @log 2
// @log abc
// @log 1
// @log t
// An element of a list of generics read at a computed index in a module-level initializer is
// called at two types (D9483).
function id<T>(x: T): T { x }
const xs = [id, id]
let i = 1
const s = xs[i]("abc")
print(xs[i](2))
print(s)
let j = 0
const n = xs[j](1)
const t = xs[j]("t")
print(n)
print(t)
