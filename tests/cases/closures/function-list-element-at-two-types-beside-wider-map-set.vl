// @run
// @log 4
// @log 2.25
// @log 6
// A member stored into a map of functions by `set` is decided with the map's set (D15060).
function inc0(a) { return a + 1 }
function dbl0(a) { return a * 2 }
function deliver0() { return [inc0] }
function take0(a) { print(a[0](3)) }
take0(deliver0())
print(deliver0()[0](1.25))
const m = Map()
m.set("a", dbl0)
m.set("b", inc0)
const g = m.get("b")
if g != null { print(g(5)) }
