// @run
// @log 6
// @log 3.5
// A global aliasing a list of a hole-function set holds the same ids: each element call through
// the alias reaches the member's instance at its own tuple.
function inc(a) { return a + 1 }
function dbl(a) { return a * 2 }
const fs = [inc, dbl]
const t = fs
print(t[1](3))
print(t[0](2.5))
