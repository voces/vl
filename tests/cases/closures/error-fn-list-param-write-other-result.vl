// @emit-error the function written to this element returns another type than the element's
// A function written through a parameter into a list of functions that returns another type
// at the element's arguments is refused, not stored into the list's element type (D9093).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function put(ys) { ys[0] = half }
const xs = [inc0]
put(xs)
print(xs.map((f) => f(3))[0])
