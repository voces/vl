// @error cannot write 'half' to an element of 'xs': called at (i32) it returns f64, where 'inc0', also written to it, returns i32
// A function written through a parameter into a list of functions that returns another type
// at the element's arguments is refused, as a direct call through the element is (D9093, D9172).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function put(ys) { ys[0] = half }
const xs = [inc0]
put(xs)
print(xs.map((f) => f(3))[0])
