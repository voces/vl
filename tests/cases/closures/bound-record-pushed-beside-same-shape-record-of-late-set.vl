// @log 9
// @log 2
// @log 3.5
// @log 0.5
// @log 1.25
// A bound record pushed into a list of records of a set, beside another record literal of the same
// field shape whose function a hole parameter hands it, keeps each record's set (D16998, D15641).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function trip(x) { return x * 3 }
const xs = [{ f: inc0 }, { f: half }]
const v = { f: trip }
xs.push(v)
print(xs[2].f(3))
function call0(r, x) { print(r.f(x)) }
function both(g) {
  print(g(1))
  call0({ f: g }, 2.5)
}
both(inc0)
both(half)
