// @error cannot choose 'lenOf' here: called at (string) it returns i32
// The same choice bound to a `const` first, then handed beside the caller's un-annotated
// parameter to a callee that calls it there (D13782).
function twice(s) { return s + s }
function lenOf(s) { return s.length }
function only(z, g) { return g(z) }
const k = [1].length > 1
function bad(z) {
  const h = if k { twice } else { lenOf }
  print(only(z, h))
}
bad("ab")
