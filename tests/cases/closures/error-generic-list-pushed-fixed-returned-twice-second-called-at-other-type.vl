// @error push: cannot add (i32) => i32 to ((string) => string)[] (the callee's body at the call's argument types)
// A list of a generic pushed a fixed-type function and handed back twice, once into a binding
// that fixes its element and once into an un-annotated one called at another type, refuses: the
// second delivery reaches the written element (D10151).
function id<T>(x: T): T { x }
function inc(x: i32): i32 { x + 1 }
const ys = [id]
ys.push(inc)
function deliver() { return ys }
const v: ((x: i32) => i32)[] = deliver()
const w = deliver()
print(v[1](2))
print(w[0]("s"))
