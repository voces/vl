// @run
// @log 1
// @log s
// @log loud
// @log 3
// @log 10
// A written binding of two generics called at two types, delivered through a list literal written to an annotated binding at a
// closed function type, is delivered through an adapter and keeps the value it held there.
function id<T>(x: T): T { return x }
function loud<T>(x: T): T {
  print("loud")
  return x
}
function main() {
  let f = id
  print(f(1))
  print(f("s"))
  let xs: ((x: i32) => i32)[] = []
  xs = [f]
  f = loud
  print(f(3))
  print(xs[0](10))
}
main()
