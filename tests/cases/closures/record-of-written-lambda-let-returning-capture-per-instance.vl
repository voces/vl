// @run
// @log 5
// @log 11
// @log u
// @log 21
// The same record whose lambdas return the parameter at one instance and a captured i32 at the other.
function inR<T>(x: T, z: i32) {
  let k = (n) => z
  k = (n) => {
    print(n)
    return z + 1
  }
  const o = { f: k }
  print(o.f(x))
}
inR(5, 10)
inR("u", 20)
