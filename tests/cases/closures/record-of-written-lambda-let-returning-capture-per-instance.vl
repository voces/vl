// @run
// @log 5
// @log 11
// @log u
// @log 21
// The same record whose two lambdas each print their argument and return a captured i32.
function inR<T>(x: T, z: i32) {
  let k = (n) => {
    print(n)
    return z
  }
  k = (n) => {
    print(n)
    return z + 1
  }
  const o = { f: k }
  print(o.f(x))
}
inR(5, 10)
inR("u", 20)
