  print(__atomic_load16_u_i64__(BASE + 14))
  seed()
  print(__atomic_load32_u_i64__(BASE + 0))
  print(__atomic_load32_u_i64__(BASE + 4))
  print(__atomic_load32_u_i64__(BASE + 12))
  seed()
  __atomic_store_i32__(BASE + 4, -1)
  window()
  seed()
  __atomic_store_i32__(BASE + 4, 2147483647)
  window()
  seed()
  __atomic_store_i32__(BASE + 4, (-2147483647 - 1))
  window()
  seed()
  __atomic_store_i64__(BASE + 8, -1)
  window()
  seed()
  __atomic_store_i64__(BASE + 8, 9223372036854775807)
  window()
  seed()
  __atomic_store_i64__(BASE + 8, (-9223372036854775807 - 1))
  window()
