// Every atomic load and store width at a naturally aligned address inside a seeded
// 16-byte window: a narrow load zero-extends, and a narrow store writes only its
// own bytes, so the window's other bytes read back unchanged.
// Generated by scripts/gen-atomic-cases.py; the expected lines are its model of
// the wasm threads proposal. Edit the generator, not this file.
const BASE = 256

function seed() {
  __store_i64__(BASE, -8613303245920329199)
  __store_i64__(BASE + 8, -4240963237336423)
}

function window() {
  print(__load_i64__(BASE))
  print(__load_i64__(BASE + 8))
}

function main() {
  seed()
  print(__atomic_load_i32__(BASE + 0))
  print(__atomic_load_i32__(BASE + 4))
  print(__atomic_load_i32__(BASE + 12))
  seed()
  print(__atomic_load_i64__(BASE + 0))
  print(__atomic_load_i64__(BASE + 8))
  seed()
