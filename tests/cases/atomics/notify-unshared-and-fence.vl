// @run
// @log 0
// @log 0
// @log 7
// On a memory that is not `shared` no thread can be waiting, so `memory.atomic.notify`
// wakes nobody and answers 0 whatever the count. `atomic.fence` has no operands and no
// result; it orders the accesses around it and is valid in any module, memory or not.
__atomic_store_i32__(64, 7)
print(__atomic_notify__(64, 1))
__atomic_fence__()
print(__atomic_notify__(64, -1))
print(__atomic_load_i32__(64))
