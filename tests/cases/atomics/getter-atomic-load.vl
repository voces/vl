// @run
// @log 7
// @log 8
// A getter may read linear memory with an atomic load, as it may with `__load_i32__`: the
// load's only possible effect is a trap. An atomic that writes (a store, an rmw) is not a read.
type Cell = new i32
get value(self: Cell): i32 { __atomic_load_i32__(self as! i32) }

const cell = 64 as! Cell
__atomic_store_i32__(64, 7)
print(cell.value)
__atomic_rmw_add_i32__(64, 1)
print(cell.value)
