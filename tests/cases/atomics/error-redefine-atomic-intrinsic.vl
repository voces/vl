// @check
// @error '__atomic_rmw_add_i32__' is a compiler intrinsic and cannot be redefined
// The atomics are dispatched by callee name before any declaration lookup, like the SIMD
// and memory intrinsics, so a user function of the same name would be silently discarded.
function __atomic_rmw_add_i32__(a: i32, b: i32) { return a + b }
print(__atomic_rmw_add_i32__(0, 2))
