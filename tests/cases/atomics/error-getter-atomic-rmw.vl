// @check
// @error the getter `value` on Cell calls `__atomic_rmw_add_i32__`
// A getter may read memory with an atomic load (getter-atomic-load.vl), but may not call an
// atomic with any other effect: an rmw writes linear memory, though it answers a value.
type Cell = new i32
get value(self: Cell): i32 { __atomic_rmw_add_i32__(self as! i32, 1) }

const cell = 64 as! Cell
print(cell.value)
