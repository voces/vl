// @check
// @error the getter `value` on Cell calls `__atomic_store_i32__`
// A getter may read memory with an atomic load (getter-atomic-load.vl), but may not call an
// atomic with any other effect: an atomic store writes linear memory.
type Cell = new i32
get value(self: Cell): i32 {
  __atomic_store_i32__(self as! i32, 1)
  0
}

const cell = 64 as! Cell
print(cell.value)
