// @check
// @error the getter `value` on Cell calls `__atomic_wait32__`
// A getter may read memory with an atomic load (getter-atomic-load.vl), but may not call an
// atomic with any other effect: a wait blocks the thread.
type Cell = new i32
get value(self: Cell): i32 { __atomic_wait32__(self as! i32, 0, 0 as i64) }

const cell = 64 as! Cell
print(cell.value)
