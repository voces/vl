// @run
// @log 12
// @log 3
// @log 40
// @log 1536
// @log 2
// A masked shift `((x >>> k) & m) << j` (or `* 2^j`) lowers as one shift netting `k` against `j`
// and the mask `m << j`; the value is the unreduced chain's at every width.
function field(x: i32) { return ((x >>> 4) & 15) << 2 }

function low(x: i32) { return ((x >>> 2) & 3) * 1 }

function scaled(x: i64) { return ((x >>> 8) & 255) * 8 }

function wide(x: i64) { return ((x >>> 1) & 3) << 9 }

function exact(x: i32) { return ((x >>> 3) & 7) << 3 >>> 3 }

print(field(0x35))
print(low(12))
print(scaled(0x0500))
print(wide(7))
print(exact(16))
