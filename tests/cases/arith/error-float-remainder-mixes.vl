// @check
// @error operator '%' mixes f64 and i64
// @error operator '%' mixes i64 and f64
// @error operator '%' mixes f32 and i32
// @error operator '%' mixes i32 and f32
// @error operator '%' mixes f32 and i64
// @error operator '+' mixes f64 and i64
// @error operator '+' mixes f32 and i32
// @error operator '+' mixes f32 and i64
// WHAT `%` STILL REFUSES AFTER D1586, and WHY IT IS NOT A `%` RULE. `%` left the integer-only
// family and joined the numeric lattice `+ - * /` live in, so the pairs it refuses are the
// pairs THAT lattice refuses: `i64` beside a float (the i64→f64 widening is lossy past 2^53
// and is not permitted for a variable), and `f32` beside any integer.
//
// The `+` half of this file is the CONTROL, and it is the whole point of the fixture: each
// `%` sentence has a `+` sentence beside it, word for word except the operator. If a future
// change makes `%` refuse something `+` accepts, this file is where that shows up — the old
// `operator '%' is integer-only` reject cannot say it, because it refused every float.
//
// The return annotations are load-bearing: without them each rejected body also raises
// `cannot infer a return type`, and the cascade would bury the one error each pins.
export function wide(a: i64, b: f64): f64 {
  return b % a
}
export function wideLeft(a: i64, b: f64): f64 {
  return a % b
}
export function narrow(a: f32, b: i32): f32 {
  return a % b
}
export function narrowLeft(a: i32, b: f32): f32 {
  return a % b
}
export function narrowWide(a: f32, b: i64): f32 {
  return a % b
}
export function widePlus(a: i64, b: f64): f64 {
  return b + a
}
export function narrowPlus(a: f32, b: i32): f32 {
  return a + b
}
export function narrowWidePlus(a: f32, b: i64): f32 {
  return a + b
}
