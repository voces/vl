// @check
// @error operator '%' is integer-only, got f64 and f64
// @error operator '%' is integer-only, got f64 and i32
// @error operator '%' is integer-only, got i32 and f64
// @error operator '%' is integer-only, got f64 and i64
// @error operator '%' is integer-only, got i64 and f64
// @error operator '%' is integer-only, got f64 and f64
// @error operator '%' is integer-only, got f64 and i32
// `%` is integer-only: every operand pairing with a float on EITHER side is a type
// error, whether the float arrives by annotation, by literal, or by inference from a
// literal initialiser. The i32 side of a mixed pair does not rescue it — `f64 % i32`
// widens under the numeric lattice for `+ - * /`, and `%` is deliberately outside that.
//
// Wasm has no `f64.rem`/`f32.rem` instruction, and the one-line `a - trunc(a / b) * b`
// identity is not fmod: against C/Rust it disagrees on ~43% of random operand pairs, on
// every `|a / b|` past 2^53, on a `-0.0` dividend, and on an infinite divisor. Rejecting
// keeps the failure loud instead of trading it for silent numeric corruption; an exact
// remainder, when it lands, belongs beside `sqrt`/`trunc` as a float intrinsic.
//
// The reject is what pins the emitter too: accepted float `%` reached a slice that had
// no float opcode for it, fell through to the i32 tail, and emitted `i32.rem_s` over an
// operand already on the stack as an f64 — invalid wasm that only the engine caught.
// The return annotations are load-bearing here: without them each rejected body also
// raises `cannot infer a return type`, and the cascade would bury the one error each
// function is pinning.
export function annotated(a: f64, b: f64): f64 {
  return a % b
}
export function widened(a: f64, b: i32): f64 {
  return a % b
}
export function widenedLeft(a: i32, b: f64): f64 {
  return a % b
}
export function wide(a: i64, b: f64): f64 {
  return b % a
}
export function wideLeft(a: i64, b: f64): f64 {
  return a % b
}
const _lit = 5.5 % 2.0
const inferredA = 5.5
const inferredB = 2
const _inferred = inferredA % inferredB
