// @run
// @log 1.5
// @log 2.25
// @log 0.75
// @log 1.25
// @log 1
// @log 1.5
// @log 0.5
// @log 0.5
// @log 0.25
// @log 0.550000011920929
// @log 4.5
// @log -0.5
// An f32 `%` nested under another f32 operator stays at f32 (D3376): the `%` is part of the
// arithmetic spine, so its literal operand re-encodes at f32 instead of making the parent op
// f64. The tenth row proves the width: `0.5 % 0.3f` subtracted at f32, not at f64. The last two
// keep a `%` of two literals the f64 the checker types it as, however deep it sits.
function subRem(x: f32) { x - 0.5 % x }
function addDivRem(x: f32) { x + 0.5 / x % x }
function subDivRem(x: f32) { x - x / 0.5 % x }
function remUnder(x: f32) { x * (0.5 % x) }
function parRem(x: f32) { x - (0.5 % x) }
function negRem(x: f32) { -(0.5 % x) + x }
function remOver(x: f32) { x % 0.5 + x }
function remRem(x: f32) { 0.5 % x % x + x }
function bound(x: f32) {
  const v = x - 0.5 % x
  v
}
function twoVars(x: f32, y: f32) { x - 0.5 % y }
print(subRem(2.0))
print(addDivRem(2.0))
print(subDivRem(0.75))
print(remUnder(2.5))
print(parRem(1.5))
print(negRem(2.0))
print(remOver(0.25))
print(remRem(0.5))
print(bound(0.75))
print(twoVars(0.75, 0.3))
const ay: f32 = 2.0
print(ay + (ay + 0.5 % 2.0))
function litRemDeep(x: f32) { x - (0.5 % 3.0 + x) }
print(litRemDeep(0.7))
