// @run
// @log 1.5
// @log -1.5
// @log 1.5
// @log 1.5
// @log 1.5
// @hint redundant type annotation: `same` is inferred as `f32`
// @hint redundant type annotation: `mixedWide` is inferred as `f64`
// @hint redundant type annotation: `mixedWideLeft` is inferred as `f64`
// THE f32 HALF of D1586. It is a separate case because f32 and f64 are separate emitter
// slices with separate opcode tables, and the f32 slice is entered FIRST — an f32 operand
// routed there, found no `f32.rem`, and used to fall through past the f64 slice into the i32
// tail, which is why `f32 % f32` was its own reject fixture.
//
// ONE HELPER SERVES BOTH WIDTHS, and that is a fact about floats rather than a shortcut: an
// f32 is exact in f64, the remainder of two f32-representable values is itself
// f32-representable, and every step of `__f64_rem__` is exact — so promote / call / demote
// loses nothing a second helper at the narrower width would keep. The OPERANDS are emitted at
// f32 before the promotion, so a literal re-encodes at f32 and `x % 0.1` uses f32's `0.1`.
//
// The f32/f64 mixed rows pin both entry orders; the pairs the numeric lattice refuses are
// `error-float-remainder-mixes.vl`.
export function same(a: f32, b: f32): f32 {
  return a % b
}
export function mixedWide(a: f32, b: f64): f64 {
  return a % b
}
export function mixedWideLeft(a: f64, b: f32): f64 {
  return a % b
}
print(same(5.5, 2.0))
const negF32: f32 = -5.5
print(same(negF32, 2.0))
print(mixedWide(5.5, 2.0))
print(mixedWideLeft(5.5, 2.0))

// At a type-parameter pin, at the narrow width.
function pinned<T>(a: T, b: T): T { return a % b }
const q1: f32 = 7.5
const q2: f32 = 2.0
print(pinned(q1, q2))
