// @check
// @error operator '%' is integer-only, got f32 and f32
// @error operator '%' is integer-only, got f32 and f64
// @error operator '%' is integer-only, got f64 and f32
// @error operator '%' is integer-only, got f32 and i32
// @error operator '%' is integer-only, got i32 and f32
// @error operator '%' is integer-only, got f32 and i64
// The f32 half of the `%` integer-only rule. It is a separate case because f32 and f64
// are separate emitter slices with separate opcode tables, and the f32 slice is entered
// FIRST — an f32 operand routed there, found no `f32.rem`, and fell through past the f64
// slice into the i32 tail, so `f32 % f32` produced invalid wasm by a different path than
// `f64 % f64` did. The `f32`/`f64` mixed rows pin both entry orders.
export function same(a: f32, b: f32): f32 {
  return a % b
}
export function mixedWide(a: f32, b: f64): f64 {
  return a % b
}
export function mixedWideLeft(a: f64, b: f32): f64 {
  return a % b
}
export function mixedNarrow(a: f32, b: i32): f32 {
  return a % b
}
export function mixedNarrowLeft(a: i32, b: f32): f32 {
  return a % b
}
export function mixedWideInt(a: f32, b: i64): f32 {
  return a % b
}
