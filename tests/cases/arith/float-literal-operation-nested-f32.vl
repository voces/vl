// @run
// @log 5
// @log 5
// @log 3
// @log 5
// @log 5
// @log 5
// @log 0.540000025033951
// @log 1.1400000488758089
// @log 3.75
// @log 0.255
// An operation over float literals alone is an f64, however deep it sits under an f32
// operation (D1983): the operations above it widen, as the checker types them. The first six
// rows are the row's ablation; the rest put the literal operation at other depths and sides.
const ay: f32 = 2.0
print(ay + (ay + 0.5 * 2.0))
const r = ay + (ay + 0.5 * 2.0)
print(r)
print(ay + 0.5 * 2.0)
print(ay + ay + 0.5 * 2.0)
print(ay + (ay + 1.0))
const h: f32 = 0.5
print(ay + (ay + h * 2.0))
function prodUnder(y: f32) { y * (0.5 * 3.0 + y) }
print(prodUnder(0.3))
function sumUnder(y: f32) { y * (0.5 + 3.0 + y) }
print(sumUnder(0.3))
function leftFirst(x: f32) { (1.25 * 3.0) - x + x }
print(leftFirst(0.7))
function tenth(x: f32) { x * (x + 0.1 * 0.1) }
print(tenth(0.5))
