// @run
// @log 1
// @log 1
// @log 1
// @log 1
// @log -1
// @log 1
// @log 1
// The CONTROL for the `%` integer-only rule: every pairing that stays legal, and its
// value. `%` over i32/i64 in either order is untouched by the float rejection, and the
// sign follows the DIVIDEND (`i32.rem_s`/`i64.rem_s` are signed), which is the property
// a float-remainder lowering would also have had to preserve.
function ii(a: i32, b: i32) {
  return a % b
}
function il(a: i32, b: i64) {
  return a % b
}
function li(a: i64, b: i32) {
  return a % b
}
function ll(a: i64, b: i64) {
  return a % b
}
print(ii(5, 2))
print(il(5, 2))
print(li(5, 2))
print(ll(5, 2))
print(ii(0 - 5, 2))
print(ii(5, 0 - 2))
print(13 % 4)
