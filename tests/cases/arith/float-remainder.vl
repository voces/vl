// @run
// @log 1.5
// @log -1.5
// @log 1.5
// @log 2
// @log 0.010000000000000009
// @log NaN
// @log NaN
// @log 2
// @log -Infinity
// @log 1.5
// @log 1
// @log 1.5
// @log 1.5
// @log 0
// @log 1
// @hint redundant type annotation: `annotated` is inferred as `f64`
// @hint redundant type annotation: `inf` is inferred as `f64`
// @hint redundant type annotation: `negZero` is inferred as `f64`
// @hint redundant type annotation: `widened` is inferred as `f64`
// @hint redundant type annotation: `widenedLeft` is inferred as `f64`
// @hint redundant type annotation: `p1` is inferred as `f64`
// @hint redundant type annotation: `p2` is inferred as `f64`
// @hint redundant type annotation: `i1` is inferred as `i32`
// @hint redundant type annotation: `i2` is inferred as `i32`
// `%` OVER FLOATS IS THE TRUNCATED REMAINDER — DECISIONS.md §"`%` over floats is the
// truncated remainder (Rust / JavaScript / C fmod)" (owner, 2026-09-04), built as D1586.
// `a % b` has the value of `a - b * trunc(a / b)` and takes the sign of the DIVIDEND. It was
// a loud check reject (`operator '%' is integer-only, got f64 and f64`) because wasm has no
// `f64.rem` instruction and the obvious identity is not fmod.
//
// THE IDENTITY IS NOT WHAT SHIPPED. `a - b * trunc(a / b)` EVALUATED disagrees with C on
// every quotient past 2^53, loses a `-0.0` dividend's sign, answers NaN for an infinite
// divisor, and overflows at the top of the range. `__f64_rem__` is the scaled
// repeated-subtraction form instead, whose every step is exact — which is what the `1e308`
// and `0.1 % 0.03` rows are here to pin, since a rounding lowering gets both wrong.
//
// The IEEE corners are the last four of the first group: `x % 0` and `inf % b` are NaN,
// `a % inf` is `a`, and `-0.0 % 1` keeps its sign (which `1 / v` is the only way to see —
// `print` renders both zeroes as `0`, as JavaScript's `String` does).
export function annotated(a: f64, b: f64): f64 {
  return a % b
}
print(annotated(5.5, 2.0))
print(annotated(0.0 - 5.5, 2.0))
print(annotated(5.5, 0.0 - 2.0))
print(annotated(1e308, 3.0))
print(annotated(0.1, 0.03))
print(annotated(5.5, 0.0))
const inf: f64 = 1.0 / 0.0
print(annotated(inf, 2.0))
print(annotated(2.0, inf))
const negZero: f64 = -0.0
print(1.0 / annotated(negZero, 1.0))

// A MIXED PAIR WIDENS, exactly as `+ - * /` do — `%` is now inside the numeric lattice
// rather than beside it. The pairs the lattice REFUSES are `error-float-remainder-mixes.vl`,
// and they are refused with `+`'s own sentence.
export function widened(a: f64, b: i32): f64 {
  return a % b
}
export function widenedLeft(a: i32, b: f64): f64 {
  return a % b
}
print(widened(5.5, 2))
print(widenedLeft(5, 2.0))

// The LITERAL and INFERRED spellings, which the reject this replaces listed separately
// because each reaches the arm by its own route.
const lit = 5.5 % 2.0
print(lit)
const inferredA = 5.5
const inferredB = 2
print(inferredA % inferredB)

// AT A TYPE-PARAMETER PIN (D493): `binOpDefinedFor` mirrors `checkBinary`, so the pin admits
// exactly what the direct spelling admits — float and integer alike, one function.
function pinned<T>(a: T, b: T): T { return a % b }
const p1: f64 = 7.5
const p2: f64 = 1.5
print(pinned(p1, p2))
const i1: i32 = 7
const i2: i32 = 2
print(pinned(i1, i2))
