// @run
// @log ww
// @log uww
// @log [ww]
// @log sww
// @log i=ww
// @log ww
// @log ww
// @log ww
// @log ww
// Q58 position sweep: a global whose initializer is an assignment to a literal-union cell, stored
// as the atom the assignment yields, read as a scalar and a union call argument, a nested call
// argument, a concat operand, an interpolation hole, a let initializer, an if arm, a `??` operand
// and a record field. Its return position is a claim invalid on master too, sent to lane SOUND.
type K = "zz" | "ww"
let k: K = "zz"
const c = (k = "ww")
function takeS(s: string) { print(s) }
function takeU(s: string | i32) {
  if s is string { print("u" + s) } else { print(s) }
}
function wrap(s: string) { return "[" + s + "]" }
function maybe(n: i32): string | null { return if n > 0 { "m" } else { null } }
function go(b: boolean) {
  takeS(c)
  takeU(c)
  takeS(wrap(c))
  print("s" + c)
  print("i=\{c}")
  const l = c
  print(l)
  print(if b { c } else { "no" })
  print(maybe(0) ?? c)
  const r = { v: c }
  print(r.v)
}
go(true)
