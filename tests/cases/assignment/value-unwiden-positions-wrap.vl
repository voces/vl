// An `i32` assigned into an `i64` cell, its value used in each delivery position: the cell is
// re-read and wrapped back to the `i32` (`i32.wrap_i64`), a negative and a value past 2^30 alike.
function takeI(n: i32) { print(n) }
function show(n: i32) { return "<\{n}>" }
function two(a: string, b: string) { return a + b }
function tag() {
  print("lead")
  return "L"
}
function back(k: i32) {
  let x: i64 = 0
  return x = k
}
function at_direct(k: i32) {
  let x: i64 = 0
  takeI((x = k))
  print(x)
}
function at_nested(k: i32) {
  let x: i64 = 0
  print(two(tag(), show((x = k))))
  print(x)
}
function at_concat(k: i32) {
  let x: i64 = 0
  print("v" + show((x = k)))
  print(x)
}
function at_interp(k: i32) {
  let x: i64 = 0
  print("v \{(x = k)}")
  print(x)
}
function at_ret(k: i32) { print(back(k)) }
function at_const(k: i32) {
  let x: i64 = 0
  const v = (x = k)
  print(v)
  print(x)
}
function at_ifarm(k: i32) {
  let x: i64 = 0
  const v = if k < 100 { (x = k) } else { 0 }
  print(v)
  print(x)
}
function at_coalesce(k: i32) {
  let x: i64 = 0
  const n: i32 | null = null
  print(n ?? ((x = k)))
  print(x)
}
function at_record(k: i32) {
  let x: i64 = 0
  const o = { n: (x = k) }
  print(o.n)
  print(x)
}
at_direct(-7)
at_direct(1073741825)
at_nested(-7)
at_nested(1073741825)
at_concat(-7)
at_concat(1073741825)
at_interp(-7)
at_interp(1073741825)
at_ret(-7)
at_ret(1073741825)
at_const(-7)
at_const(1073741825)
at_ifarm(-7)
at_ifarm(1073741825)
at_coalesce(-7)
at_coalesce(1073741825)
at_record(-7)
at_record(1073741825)
