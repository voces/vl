// @run
// @log cdd
// @log dd
// @log a[bb]
// @log bb
// @log x[yy]
// @log yy
// A string read, then the same string assigned in a later operand of a `+` or an interpolation
// (D17122, the string face of D17109): the earlier read sees the value before the store.
let s = "a"
function loc() {
  let t = "c"
  print(t + (t = "dd"))
  print(t)
}
function glob() {
  print("\{s}[\{s = "bb"}]")
  print(s)
}
function cellInterp() {
  let u = "x"
  print("\{u}[\{u = "yy"}]")
  print(u)
}
loc()
glob()
cellInterp()
