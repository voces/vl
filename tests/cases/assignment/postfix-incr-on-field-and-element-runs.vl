// @run
// @log 2
// @log 2
// @log 5
// @log 6
// @log 1.5
// @log 2.5
// @log 1
// A postfix `++` or `--` on a field or an element increments the place once and yields the old
// value; on an `f64` place the old value is recovered at its width (D4055, D16216).
type C = { n: i32, x: f64 }
const c: C = { n: 1, x: 1.5 }
c.n++
const xs = [1, 2]
xs[0]++
print(c.n)
print(xs[0])
const d: C = { n: 5, x: 1.5 }
const old = d.n++
print(old)
print(d.n)
print(d.x++)
print(d.x)
let calls = 0
function k() {
  calls = calls + 1
  return 0
}
xs[k()]--
print(calls)
