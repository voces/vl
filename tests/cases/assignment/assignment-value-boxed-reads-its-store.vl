// @run
// @log 5
// @log 7
// @log 7
// An assignment boxed as its value reads the store built ahead of its box.
function mk(c: boolean) {
  let x: i32 | null = null
  return if c { x = 5 }
}
function asArg(y: i32 | string) { print(y) }
function put(c: boolean) {
  let z: i32 | string = "s"
  asArg(z = 7)
  if c { print(z) }
}
print(mk(true) ?? 0)
put(true)
