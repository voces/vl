// @run
// @log 3
// @log 3
// @log 3
// @log 9
// @log 9
// @log 7
// A record literal written into a place storing one record is built at that record, so the
// write yields it, whatever other record shares the literal's shape (D16463).
type Node = { v: i32, left: Node | null }

// A field, an element and a name, each the tail of a function with no declared result.
function toField(n: Node, v: i32) { return n.left = { v: v, left: null } }
print(toField({ v: 1, left: null }, 3).v)
function toElem(xs: (Node | null)[], v: i32) { return xs[0] = { v: v, left: null } }
const slots: (Node | null)[] = [null]
print(toElem(slots, 3).v)
let held: Node | null = null
function toName(v: i32) { return held = { v: v, left: null } }
print(toName(3).v)

// The value yielded is the record stored, so it takes a write its record allows.
const root: Node = { v: 1, left: null }
const got = toField(root, 3)
got.left = { v: 9, left: null }
print(root.left?.left?.v ?? 0)
const bound = root.left = { v: 3, left: null }
bound.left = { v: 9, left: null }
print(root.left?.left?.v ?? 0)

// A literal of the same shape elsewhere mints that shape's own record.
const other = { v: 7, left: null }
print(other.v)
