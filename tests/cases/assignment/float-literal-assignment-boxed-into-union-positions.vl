// @run
// @log <2.5>
// @log 2.5
// @log 3.5 3.5
// @log 4.5 4.5
// @log 5.5 5.5
// @log 6.5!
// @log 7.5
// Q58 position sweep: an `f64` literal assignment boxed into a numeric union, which legacy's ladder
// boxes after its store (`asgLit`): boxed on its target's own plan, the stored value under the
// `f64` tag, as an argument, a record field, a list element, a `let`, a hole and a return.
type N = i64 | f64 | i32
type R = { p: N }
function show(a: N) { return "<\{a}>" }
function asArg() {
  let b: f64 = 1
  print(show(b = 2.5))
  print(b)
}
function asField() {
  let b: f64 = 1
  const r: R = { p: b = 3.5 }
  print("\{r.p} \{b}")
}
function asElem() {
  let b: f64 = 1
  const xs: N[] = [b = 4.5]
  print("\{xs[0]} \{b}")
}
function asLet() {
  let b: f64 = 1
  const n: N = b = 5.5
  print("\{n} \{b}")
}
function asInterp() {
  let b: f64 = 1
  print("\{b = 6.5}!")
}
function asRet(): N {
  let b: f64 = 1
  return b = 7.5
}
asArg()
asField()
asElem()
asLet()
asInterp()
print(asRet())
