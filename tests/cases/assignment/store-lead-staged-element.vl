// @run
// @log 12
// @log 2
// An element read as an earlier argument and assigned by a later one: the earlier read sees the
// value before the store, as written left to right.
function two(a: i32, c: i32) { print(a * 10 + c) }
function f() {
  const xs = [1, 5]
  two(xs[0], xs[0] = 2)
  print(xs[0])
}
f()
