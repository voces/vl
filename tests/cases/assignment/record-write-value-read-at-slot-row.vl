// @run
// @log 3
// @log 3
// @log 4
// @log 9
// @log 7
// A record literal written into a field and used as the write's value reads at the row its slot
// is declared at, beside a literal of the same shape that has a row of its own (D16463), and the
// value written is the record the place holds.
type Node = { v: i32, left: Node | null }
function toField(n: Node, v: i32) { return n.left = { v: v, left: null } }
const root: Node = { v: 1, left: null }
const got = toField(root, 3)
print(got.v)
print(root.left?.v ?? 0)
function toElem(xs: (Node | null)[], v: i32) {
  return xs[0] = { v: v, left: null }
}
const slots: (Node | null)[] = [null]
print(toElem(slots, 4).v)
got.left = { v: 9, left: null }
print(root.left?.left?.v ?? 0)
const other = { v: 7, left: null }
print(other.v)
