// An assignment of one member of a literal-union field or element, used as a value, at each
// position in a function and at module level: the value is the member written.
type K = "zz" | "ww"
function show(k: K) { print(k) }
function h() {
  const o: { f: K } = { f: "zz" }
  print(o.f = "ww")
  show(o.f = "ww")
  const ks: K[] = ["zz"]
  print(ks[0] = "ww")
  print(ks[0])
  const s: string = o.f = "ww"
  print(s)
  print("<" + (o.f = "ww") + ">")
  print("\{o.f = "ww"}!")
  const xs = [o.f = "ww"]
  print(xs[0])
  print((o.f = "ww") == "ww")
  const k: K = o.f = "ww"
  print(k)
  const c: "ww" = (o.f = "ww")
  const f = () => { print(c) }
  f()
}
h()
const g: { f: K } = { f: "zz" }
print(g.f = "ww")
print(g.f)
