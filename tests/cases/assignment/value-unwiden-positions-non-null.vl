// @run
// @log 5
// @log 6
// @log 21
// @log 28
// @log 9
// @log 10
// A record, a closure and a map assigned into their own nullable cells, the assignment's value
// read whole, called and indexed: the cell is re-read and cast back to the non-null reference.
function mkR(n: i32) { return { a: n } }
function mkM(n: i32) {
  const m: {[string]: i32} = Map()
  m.set("k", n)
  return m
}
function rec(n: i32) {
  let r: { a: i32 } | null = null
  const v = r = mkR(n)
  print(v.a)
  print((r = mkR(n + 1)).a)
}
function clo(n: i32) {
  let f: (() => i32) | null = null
  const g = f = () => n * 3
  print(g())
  print((f = () => n * 4)())
}
function map(n: i32) {
  let m: {[string]: i32} | null = null
  const v = m = mkM(n)
  print(v.get("k") ?? -1)
  print((m = mkM(n + 1)).get("k") ?? -1)
}
rec(5)
clo(7)
map(9)
