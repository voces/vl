// @log true
// @log true
// @log ww
// @log true
// @log false
// @log 1
// @log zz
// @log true
// @log ww
type K = "zz" | "ww"
function h(t: string) {
  const o: { f: K } = { f: "zz" }
  print((o.f = "ww") == "ww")
  print((o.f = "zz") != "zz")
  print("ww" == (o.f = "ww"))
  const ks: K[] = ["zz"]
  print((ks[0] = "ww") == "ww")
  print(ks[0])
  print((o.f = "ww") == t)
  print((o.f = "zz") == t)
  let n = 0
  if (o.f = "zz") == "zz" { n = n + 1 }
  print(n)
  print(o.f)
}
h("ww")
const g: { f: K } = { f: "zz" }
print((g.f = "ww") == "ww")
print(g.f)
