// @run
// @log -- arg
// @log 1
// @log 12
// @log 2
// @log -- nested
// @log 1
// @log 12
// @log 2
// @log -- unionArg
// @log 1
// @log 1 2
// @log 2
// @log -- binop
// @log 1
// @log 12
// @log 2
// @log -- concat
// @log 1
// @log 1<2>
// @log 2
// @log -- interp
// @log 1
// @log 1 2
// @log 2
// @log -- record
// @log 1
// @log 1 2
// @log 2
// @log -- array
// @log 1
// @log 1 2
// @log 2
// @log -- compare
// @log 1
// @log false
// @log 2
// An earlier operand reads `b`, and a later one assigns it (capture, at `i32`), in each operand
// position: the earlier read sees the value before the store, as written left to right.
function twoS(a: i32, c: i32) { return a * 10 + c }
function idS(n: i32) { return n }
function two(a: i64 | f64 | i32, c: i64 | f64 | i32) { return "\{a} \{c}" }
function show<T>(n: T) { return "<\{n}>" }
function at_arg() {
  let b = 1
  const peek = () => b
  print(peek())
  print(twoS(b, b = 2))
  print(b)
}
function at_nested() {
  let b = 1
  const peek = () => b
  print(peek())
  print(twoS(b, idS(b = 2)))
  print(b)
}
function at_unionArg() {
  let b = 1
  const peek = () => b
  print(peek())
  print(two(b, b = 2))
  print(b)
}
function at_binop() {
  let b = 1
  const peek = () => b
  print(peek())
  print(b * 10 + (b = 2))
  print(b)
}
function at_concat() {
  let b = 1
  const peek = () => b
  print(peek())
  print("\{b}" + show(b = 2))
  print(b)
}
function at_interp() {
  let b = 1
  const peek = () => b
  print(peek())
  print("\{b} \{b = 2}")
  print(b)
}
function at_record() {
  let b = 1
  const peek = () => b
  print(peek())
  const r = { p: b, q: b = 2 }
  print("\{r.p} \{r.q}")
  print(b)
}
function at_array() {
  let b = 1
  const peek = () => b
  print(peek())
  const ys = [b, b = 2]
  print("\{ys[0]} \{ys[1]}")
  print(b)
}
function at_compare() {
  let b = 1
  const peek = () => b
  print(peek())
  print(b == (b = 2))
  print(b)
}
print("-- arg")
at_arg()
print("-- nested")
at_nested()
print("-- unionArg")
at_unionArg()
print("-- binop")
at_binop()
print("-- concat")
at_concat()
print("-- interp")
at_interp()
print("-- record")
at_record()
print("-- array")
at_array()
print("-- compare")
at_compare()
