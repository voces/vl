// @run
// @log at
// @log 5
// @log rec
// @log 7
// @log key
// @log 9
// @log 3
// @log at
// @log 5
// @log at
// @log 4
// @log at
// @log 4
// @log 6
// @log 5
// @log 4
// @log 4
// @log 21
// An assignment used as a value yields the value it stores, evaluating its target's receiver,
// index or key once, also where that value's type is narrower than its target's: an i32 into a
// `(i32 | null)[]` element, an `i64` field and an `i64[]` element.
let calls = 0
function at() {
  calls = calls + 1
  print("at")
  return 0
}
type R = { n: i32 }
function rec(r: R): R {
  calls = calls + 1
  print("rec")
  return r
}
function key() {
  calls = calls + 1
  print("key")
  return "k"
}
const xs = [1, 2]
print(xs[at()] = 5)
const r: R = { n: 1 }
print(rec(r).n = 7)
const m: {[string]: i32} = Map()
print(m[key()] = 9)
print(calls)
const ns: (i32 | null)[] = [1, 2]
const v = (ns[at()] = 5)
print(v)
type W = { k: i64 }
const ws: W[] = [{ k: 1 }]
const z: i32 = 4
const q = (ws[at()].k = z)
print(q)
const ls: i64[] = [1, 2]
const u = (ls[at()] = z)
print(u)
print(calls)
print(ns[0] ?? 0)
print(ws[0].k)
print(ls[0])
print(xs[0] + r.n + (m["k"] ?? 0))
