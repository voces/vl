// @run
// @log 12
// @log 2
// A field read as an earlier argument and assigned by a later one: the earlier read sees the
// value before the store, as written left to right.
function two(a: i32, c: i32) { print(a * 10 + c) }
function f() {
  const o = { f: 1 }
  two(o.f, o.f = 2)
  print(o.f)
}
f()
