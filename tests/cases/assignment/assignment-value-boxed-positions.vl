// @log 8
// @log 8
// @log 9
// @log 10
// @log 11
// @log 12
// @log 13
// @log 13
// Q58 position sweep: an assignment used as a value and delivered into a union box whose head
// leads its value, so the head is written before the store: a literal, a call and a compound
// assignment, into a local, a field, an element and a global, as a call argument, a return, an
// annotated `let`, a record field, a list element, an `if` arm value and a `??` default. The
// target is read after each store.
type U = i32 | string
type R = { u: U }
type C = { n: i32 }
let g = 0
function mk() { return 7 }
function show(u: U) { print(u) }
function ret(c: C): U { return c.n = 4 }
function main() {
  let a = 1
  show(a = 2)
  print(a)
  show(a = mk())
  print(a)
  show(a += 3)
  print(a)
  const c: C = { n: 0 }
  show(c.n = 5)
  print(c.n)
  print(ret(c))
  const xs = [0, 0]
  show(xs[1] = 6)
  print(xs[1])
  show(g = 8)
  print(g)
  const l: U = a = 9
  print(l)
  const r: R = { u: a = 10 }
  print(r.u)
  const ys: U[] = [a = 11]
  print(ys[0])
  const k = 1
  const v = if k == 1 { a = 12 } else { "s" }
  print(v)
  const m: {[i32]: U} = Map()
  const d = m[0] ?? (a = 13)
  print(d)
  print(a)
}
main()
