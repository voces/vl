// @run
// @log ww
// @log 2
// @log 2.5
// @log ww
// The controls beside an atom cell's assignment as a global initializer: a string, an i32, an
// f64 and a nullable atom cell, each read from a function or closure.
let a = "zz"
const c = (a = "ww")
function f() { print(c) }
f()
let b = 1
const d = (b = 2)
const g = () => {
  print(d)
}
g()
let x: f64 = 1
const e = (x = 2.5)
function h() { print(e) }
h()
type K = "zz" | "ww"
let k: K | null = null
const r = (k = "ww")
function q() { print(r) }
q()
