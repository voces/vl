// An earlier operand reads a field, an element or a global, and a later one stores to it or calls
// what does, in each operand position: the earlier read sees the value before the store.
let g = 1
function bump() {
  g = g + 1
  return g
}
function twoS(a: i32, c: i32) { return a * 10 + c }
function idS(n: i32) { return n }
function two(a: i64 | f64 | i32, c: i64 | f64 | i32) { return "\{a} \{c}" }
function show<T>(n: T) { return "<\{n}>" }
function field_arg() {
  const o = { a: 1 }
  print(twoS(o.a, o.a = 2))
  print(o.a)
}
function field_nested() {
  const o = { a: 1 }
  print(twoS(o.a, idS(o.a = 2)))
  print(o.a)
}
function field_unionArg() {
  const o = { a: 1 }
  print(two(o.a, o.a = 2))
  print(o.a)
}
function field_binop() {
  const o = { a: 1 }
  print(o.a * 10 + (o.a = 2))
  print(o.a)
}
function field_concat() {
  const o = { a: 1 }
  print("\{o.a}" + show(o.a = 2))
  print(o.a)
}
function field_interp() {
  const o = { a: 1 }
  print("\{o.a} \{o.a = 2}")
  print(o.a)
}
function field_record() {
  const o = { a: 1 }
  const r = { p: o.a, q: o.a = 2 }
  print("\{r.p} \{r.q}")
  print(o.a)
}
function field_array() {
  const o = { a: 1 }
  const ys = [o.a, o.a = 2]
  print("\{ys[0]} \{ys[1]}")
  print(o.a)
}
function field_compare() {
  const o = { a: 1 }
  print(o.a == (o.a = 2))
  print(o.a)
}
function index_arg() {
  const xs = [1]
  print(twoS(xs[0], xs[0] = 2))
  print(xs[0])
}
function index_nested() {
  const xs = [1]
  print(twoS(xs[0], idS(xs[0] = 2)))
  print(xs[0])
}
function index_unionArg() {
  const xs = [1]
  print(two(xs[0], xs[0] = 2))
  print(xs[0])
}
function index_binop() {
  const xs = [1]
  print(xs[0] * 10 + (xs[0] = 2))
  print(xs[0])
}
function index_concat() {
  const xs = [1]
  print("\{xs[0]}" + show(xs[0] = 2))
  print(xs[0])
}
function index_interp() {
  const xs = [1]
  print("\{xs[0]} \{xs[0] = 2}")
  print(xs[0])
}
function index_record() {
  const xs = [1]
  const r = { p: xs[0], q: xs[0] = 2 }
  print("\{r.p} \{r.q}")
  print(xs[0])
}
function index_array() {
  const xs = [1]
  const ys = [xs[0], xs[0] = 2]
  print("\{ys[0]} \{ys[1]}")
  print(xs[0])
}
function index_compare() {
  const xs = [1]
  print(xs[0] == (xs[0] = 2))
  print(xs[0])
}
function global_arg() {
  const z0 = 0
  print(z0)
  print(twoS(g, g = 2))
  print(g)
}
function global_nested() {
  const z0 = 0
  print(z0)
  print(twoS(g, idS(g = 2)))
  print(g)
}
function global_unionArg() {
  const z0 = 0
  print(z0)
  print(two(g, g = 2))
  print(g)
}
function global_binop() {
  const z0 = 0
  print(z0)
  print(g * 10 + (g = 2))
  print(g)
}
function global_concat() {
  const z0 = 0
  print(z0)
  print("\{g}" + show(g = 2))
  print(g)
}
function global_interp() {
  const z0 = 0
  print(z0)
  print("\{g} \{g = 2}")
  print(g)
}
function global_record() {
  const z0 = 0
  print(z0)
  const r = { p: g, q: g = 2 }
  print("\{r.p} \{r.q}")
  print(g)
}
function global_array() {
  const z0 = 0
  print(z0)
  const ys = [g, g = 2]
  print("\{ys[0]} \{ys[1]}")
  print(g)
}
function global_compare() {
  const z0 = 0
  print(z0)
  print(g == (g = 2))
  print(g)
}
function callEff_arg() {
  const z0 = 0
  print(z0)
  print(twoS(g, bump()))
  print(g)
}
function callEff_nested() {
  const z0 = 0
  print(z0)
  print(twoS(g, idS(bump())))
  print(g)
}
function callEff_unionArg() {
  const z0 = 0
  print(z0)
  print(two(g, bump()))
  print(g)
}
function callEff_binop() {
  const z0 = 0
  print(z0)
  print(g * 10 + (bump()))
  print(g)
}
function callEff_concat() {
  const z0 = 0
  print(z0)
  print("\{g}" + show(bump()))
  print(g)
}
function callEff_interp() {
  const z0 = 0
  print(z0)
  print("\{g} \{bump()}")
  print(g)
}
function callEff_record() {
  const z0 = 0
  print(z0)
  const r = { p: g, q: bump() }
  print("\{r.p} \{r.q}")
  print(g)
}
function callEff_array() {
  const z0 = 0
  print(z0)
  const ys = [g, bump()]
  print("\{ys[0]} \{ys[1]}")
  print(g)
}
function callEff_compare() {
  const z0 = 0
  print(z0)
  print(g == (bump()))
  print(g)
}
