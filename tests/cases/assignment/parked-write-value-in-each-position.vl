// @run
// @log <5>
// @log 5
// @log 2.5
// @log v!
// @log v
// @log [w]
// @log 3.5
// @log 7
// @log 9
// @log 200
// @log 209
// An element, field or map entry write used as a value yields the value its store parked, in
// each position: an argument, a return, an initializer, an interpolation, after an operand, an
// `if` arm, a list element and a record field; at an i32, an f64, a string and a u8.
type R = { n: i32, f: f64, s: string }
type W = { v: i32 }
function show(n: i32) { return "<\{n}>" }
function half(x: f64) { return x / 2.0 }
function one(k: i32) { return k + 1 }
function argElem(xs: i32[], i: i32) { return show(xs[i] = 5) }
function retField(r: R) { return r.f = 2.5 }
function initMap(m: {[string]: string}, k: string) {
  const s = m[k] = "v"
  return s + "!"
}
function interp(r: R) { return "[\{r.s = "w"}]" }
function after(xs: f64[], i: i32) { return half(1.0) + (xs[i] = 3.0) }
function ifArm(m: {[i32]: i32}, c: boolean) {
  const v = if c { m[1] = 7 } else { 0 }
  return v
}
function list(r: R) { return [one(1), r.n = 9] }
function rec(bs: u8[], i: i32) {
  const w: W = { v: bs[i] = 200 }
  return w
}
const xs = [1, 2, 3]
print(argElem(xs, 1))
print(xs[1])
const r: R = { n: 0, f: 0.0, s: "" }
print(retField(r))
const m: {[string]: string} = Map()
print(initMap(m, "k"))
print(m["k"] ?? "-")
print(interp(r))
const fs = [0.0, 0.0]
print(after(fs, 1))
const mi: {[i32]: i32} = Map()
print(ifArm(mi, true))
print(list(r)[1])
const bs: u8[] = [0, 0]
print(rec(bs, 0).v)
print(r.n + bs[0])
