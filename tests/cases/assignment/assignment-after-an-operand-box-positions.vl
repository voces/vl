// @run
// @log 2 5
// @log 5
// @log t 4 6
// @log 6
// @log 1 7
// @log 1 3
// @log 4 9 9
// Q58 position sweep: an assignment boxed into a union after an operand read before it; legacy
// writes that operand first, then the box's tag over the store (`boxLeadStage`): a call's second
// and third argument, a record field, a list element and an interpolation hole.
type R = { p: i64 | f64 | i32, q: i64 | f64 | i32 }
function two(a: i64 | f64 | i32, c: i64 | f64 | i32) { return "\{a} \{c}" }
function three(a: string, c: i64 | f64 | i32, d: i64 | f64 | i32) {
  return a + " \{c} \{d}"
}
function asArg() {
  let b = 1
  print(two(b + 1, b = 5))
  print(b)
}
function asThird() {
  let b = 4
  print(three("t", b, b = 6))
  print(b)
}
function asField() {
  let b = 1
  const r: R = { p: b, q: b = 7 }
  print("\{r.p} \{r.q}")
}
function asElem() {
  let b = 1
  const xs: (i64 | f64 | i32)[] = [b, b = 3]
  print("\{xs[0]} \{xs[1]}")
}
function asInterp() {
  let b = 2
  print("\{b * 2} \{b = 9} \{b}")
}
asArg()
asThird()
asField()
asElem()
asInterp()
