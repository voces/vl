// @log ww
// An assignment to a literal-union place used as a value is the member written, delivered as
// its atom wherever an atom is taken: printed, passed, bound, stored, returned, from a `K | null`
// place, in a closure and at module scope.
type K = "zz" | "ww"
function show(k: K) { print(k) }
function back(o: { f: K }): K { return o.f = "ww" }
function positions() {
  const o: { f: K } = { f: "zz" }
  print(o.f = "ww")
  show(o.f = "ww")
  const ks: K[] = ["zz"]
  print(ks[0] = "ww")
  let v: K = "zz"
  show(v = "ww")
  let n: K | null = null
  print(n = "ww")
  show(n = "ww")
  print(back(o))
  const run = () => {
    let w: K = "zz"
    print(w = "ww")
  }
  run()
}
positions()
let g: K = "zz"
print(g = "ww")
show(g = "ww")
