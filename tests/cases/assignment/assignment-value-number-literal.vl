// @run
// @log -1
// @log 7
// @log 2.5
// @log -3
// @log 12
// @log 9
// @log 9
// An assignment whose value is its right side's number literal, at each width: the store, then
// the literal again, as the value.
let g32 = 0
let g64: i64 = 0
let gf = 0.0
function a() { return g32 = -1 }
function b(): i64 { return g64 = 7 }
function c() { return gf = 2.5 }
function d(): f32 {
  let x: f32 = 1.0
  return x = -3.0
}
function e(k: i32) {
  let n = k
  const m = (n = 5) + k
  return m
}
function h() {
  let c = 1
  const set = (): i32 => c = 9
  set()
  return c
}
function w(): f64 { return g32 = 9 }
print(a())
print(b())
print(c())
print(d())
print(e(7))
print(h())
print(w())
