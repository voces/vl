// @run
// @log true
// @log true
// @log true
// @log true
// @log debug
// @log true
// @log true
// @log false
// @log true
// @log false
// @log true
// A `const` bound to a string literal may be tested with `is` against any literal set its
// value belongs to: the exact literal, a subset, or a wider set, inline or aliased, at module
// and function scope, in a generic and over a join of such consts. Only a set it can never be
// in is refused (D2204; the refusal is const-literal-impossible-compare.vl).
type Mode = "debug" | "x"
const MODE = "debug"
print(MODE is "debug" | "x")
print(MODE is Mode)
print(MODE is "debug")
function scoped() {
  const LOCAL = "debug"
  return LOCAL is "debug" | "x"
}
print(scoped())
if MODE is "debug" | "x" {
  // the then-branch narrows MODE to the overlap, `"debug"`, which the wider set accepts (D2205)
  const k: "debug" | "x" = MODE
  print(k)
}
function g<T>(v: T) { v is "debug" | "x" }
print(g(MODE))
const A = "x"
const B = "y"
function join(c: boolean) {
  const M = if c { A } else { B }
  M is "x" | "z"
}
print(join(true))
print(join(false))
function joinSuper(c: boolean) {
  const M = if c { A } else { B }
  M is "x" | "y" | "z"
}
print(joinSuper(false))
function joinSub(c: boolean) {
  const M = if c { A } else { B }
  M is "y"
}
print(joinSub(true))
print(joinSub(false))
