// A hole's `??` chain over an atom-valued map read keeps the `-1` niche wherever a link's default
// can still miss, so the chain prints `null` or the stored member, never the sentinel (D7444).
type AB = "a" | "b"
type R = { m: {[i32]: AB} }

function mk(): R {
  const m: {[i32]: AB} = Map()
  m[3] = "b"
  { m: m }
}

function show(s: AB | null) { print(s == null) }

function use(p) {
  print(p.m[9] ?? p.m[8] ?? p.m[7])
  const t = p.m[9] ?? p.m[8]
  print(t)
  const v = p.m[9] ?? p.m[8] ?? p.m[3]
  print(v)
  print(p.m[9] ?? p.m[8] ?? "a")
  print((p.m[9] ?? p.m[8]) ?? "a")
  print(p.m[9] ?? (p.m[8] ?? p.m[7]))
  show(p.m[9] ?? p.m[8] ?? p.m[7])
  show(p.m[9] ?? p.m[8] ?? p.m[3])
}

function useR(p: R) { print(p.m[9] ?? p.m[8] ?? p.m[7]) }

function useT<T>(p: T) {
  print(p.m[9] ?? p.m[8] ?? p.m[7])
  print(p.m[9] ?? p.m[8] ?? p.m[3])
}

use(mk())
useT(mk())
useR(mk())
// @log null
