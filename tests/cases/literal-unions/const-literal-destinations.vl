// @run
// @log true
// @log true
// @log 1
// @log 2
// @log ww
// @log true
// @log false
// A `const` bound to a literal, or a join of such constants, flows into a literal-typed
// destination at the literal type it has: an annotated list or object literal element takes it
// as an argument does, and a `const` bound to the join keeps the join's literal set (D2157).
// Beside a literal-typed value that it is not a member of, a compare is an ordinary false test.
const Z = "zz"
const W = "ww"
type R = { k: "zz" | "ww" }
function q(k: "zz" | "ww") {
  if k == "zz" { return 1 }
  2
}
function main(c: boolean) {
  const xs: ("zz" | "ww")[] = [Z, W]
  const r: R = { k: if c { Z } else { W } }
  print(xs[1] == W)
  print(r.k == "zz")
  const j = if c { Z } else { W }
  print(q(j))
  print(q(if c { W } else { Z }))
  let k2: "zz" | "ww" = j
  k2 = W
  print(k2)
}
main(true)
type K = "zz" | "yy"
const m: {[string]: K} = Map()
m["a"] = Z
print(m["a"] == Z)
const D = "dd"
const kk: K = "yy"
print(kk == D)
