// @run
// @log pp!
// @log <pp
// @log qq!
// @log <qq
// @log pp!
// @log <pp
// @log qq!
// @log <qq
// @log pp!
// @log O
//
// A literal-union value joined into a string reads back as its member string, whether it was
// narrowed out of a mixed box, bound plainly, or passed as a parameter, and whether it is the
// left or the right part of the `+` or an interpolation's hole.
function boxed(x: ("pp" | "qq") | f64) {
  if x is ("pp" | "qq") {
    print(x + "!")
    print("<" + x)
  } else {
    print("O")
  }
}
function param(a: "pp" | "qq") { print(a + "!") }
function plain() {
  const y: "pp" | "qq" = "pp"
  print(y + "!")
  print("<" + y)
}
function tmpl(x: ("pp" | "qq") | f64) {
  if x is ("pp" | "qq") { print("\{x}!") }
}
boxed("pp")
boxed("qq")
plain()
param("qq")
const z: "pp" | "qq" = "qq"
print("<" + z)
tmpl("pp")
boxed(1.5)
