// @run
// @log A
// @log b
// @log one
// @log 2
// @log 1
// @log a?
// @log a!

// A `const` with a literal value tests as its literal, so comparing against it narrows as
// comparing against the literal does, for a string and a number alike, as a `match` arm reads it.
type K = "a" | "b" | "c"
type N = 1 | 2 | 3
type M = 1 | "a" | "b"

const A = "a"
const ONE = 1

function onlyBC(v: "b" | "c") { v }
function only23(v: 2 | 3) { v }
function onlyAB(v: "a" | "b") { v + "!" }
function str(k: K) {
  if k == A { print("A") } else { print(onlyBC(k)) }
}
function num(n: N) {
  if n == ONE { print("one") } else { print(only23(n)) }
}
function local(m: M) {
  const LA = "a"
  if m != LA { print(m) } else { print(m + "?") }
  const L1 = 1
  if m != L1 { print(onlyAB(m)) }
}

str("a")
str("b")
num(1)
num(2)
local(1)
local("a")
