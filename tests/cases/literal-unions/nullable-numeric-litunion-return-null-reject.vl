// @emit-error emitProgram: bare null needs a struct-typed context
// THE SOUNDNESS BOUNDARY, PINNED AS A REJECT SO A LATER CHANGE CANNOT TURN IT INTO INVALID WASM.
//
// `return null` from a `1 | 2 | null` function is a LOUD emit reject, and the omission is measured
// rather than an oversight. The cell IS the value-union box — `vtKindOfType`'s
// `nodeTyIsNulNumLitUnion` arm says so, which is what makes the PARAM position and both null TESTS
// correct — and adding that same predicate to `emitReturnValue`'s `retUNm` gate does box the
// `return null`. But the CALL-RESULT classifier is a THIRD home (`computeRetInference` /
// `criClassify`, whose call-result union test is name-keyed exactly as `retUnionFlag` is), so
// moving only the functype and the body left the receiving `const r = mk(b)` local an i32 while
// both of the others had moved to the box: 8 of 520 grid cells went from a LOUD reject to
// `vl check`-clean INVALID WASM. Until that third home moves in the same change, this stays loud.
//
// THIS IS A WORDING PIN, NOT A LOG PIN, AND IT HAS TO BE: the program does not compile, so there
// is no output to compare. The pin's job is the DIRECTION — a future change that starts accepting
// this shape must arrive with the third home moved and a `@log` fixture replacing this file, not
// by quietly emitting a module whose call result and whose body disagree about the rep.
//
// The two positions that DO work over this same type are pinned in
// `is-nullable-numeric-litunion-is-at-param.vl` and `nullable-numeric-litunion-param.vl`.

type N = 1 | 2

function mk(b: boolean): N | null {
  if b { return 1 }
  return null
}

print(mk(true) is N)
