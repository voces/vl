// An `else if` chain of `K | null` values with a string-literal arm joins to `string | null`
// and decodes each atom arm, at a generic sink, an annotated sink and a record field (D3365).
type K = "a" | "b" | "c"

function show<T>(x: T) { print(x) }

function showS(x: string | null) { print(x ?? "none") }

function g(a, b, c: boolean) {
  show(if c { a } else if !c { b } else { "c" })
  showS(if c { a } else if !c { b } else { "c" })
  const r = { v: if c { a } else if !c { b } else { "c" } }
  print(r.v)
}

function gT<T>(a: T, b: T, c: boolean) {
  show(if c { a } else if !c { b } else { "c" })
}

function gK(a: K | null, b: K | null, c: boolean) {
  show(if c { a } else if !c { b } else { "c" })
}

const u: K | null = null
const w: K | null = "b"
g(u, w, true)
g(u, w, false)
gT(u, w, false)
gK(u, w, true)
// @log null
// @log none
// @log null
// @log b
// @log b
// @log b
// @log b
// @log null
