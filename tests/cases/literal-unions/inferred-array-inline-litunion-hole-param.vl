// @run
// @log red
// @log y
// @log y
// @log red
// @log red!
// @log 1
// A hole parameter fed from an INFERRED array of an inline literal union. A literal-union array
// reps as the interned-atom i32 list, so an inferred one is NAMED `i32[]` — and the
// monomorphization pin's index arm took the element's pin from that name, pinning the atom's raw
// width. The element's own recorded type is exact, so the litunion rungs read it instead (D1756).
//
// NO `type` ALIAS AND NO ARRAY ANNOTATION MAY BE ADDED. Either one gives the element a name that
// survives, and every line below then passes through the rung that was never blind.

function mkval(): "red" | "green" { return "red" }

const srcArr = [mkval()]

// The three readers, which used to give three different wrong answers: `print` and `return`
// printed the interned id, `==` was check-clean invalid wasm, and `is string` answered false.
function shows(p) { print(p) }
function eq(p) {
  if p == "red" { print("y") } else { print("n") }
}
function isStr(p) {
  if p is string { print("y") } else { print("n") }
}
function gives(p) { return p }
function cat(p) { print(p + "!") }

function keyed(p) {
  const m = Map()
  m["red"] = 1
  print(m[p] ?? 0)
}

shows(srcArr[0])
eq(srcArr[0])
isStr(srcArr[0])
print(gives(srcArr[0]))
cat(srcArr[0])
keyed(srcArr[0])
