// @run
// @log field-mem:yes
// @log field-non:no
// @log nested-mem:yes
// @log nested-non:no
// @log elem-mem:yes
// @log elem-non:no
// @log elemvar-mem:yes
// @log elemvar-non:no
// @log map-mem:yes
// @log map-non:no
// @log tri-mem:yes
// @log tri-non:no
// @log nulfield-mem:yes
// @log nulfield-non:no
// @log i32field-mem:yes
// @log i32field-non:no
// @log local-mem:yes
// @log local-non:no
// @log param-mem:yes
// @log param-non:no
// @log global-mem:yes
// @log global-non:no
// CONTRACT: `x is K` over a value union carrying the literal-union alias `K` as an ARM is
// MEMBERSHIP over the payload for EVERY re-readable receiver, not just a bare identifier.
//
// WHY IT IS A FIXTURE. `K` rides the box as its member STRING, so it shares kind 2's box
// tag with the `string` arm and a tag compare answers `is K` TRUE for every string the box
// holds. The membership lowering that replaces it re-reads the receiver once per member
// (twice — tag, then payload), and its re-readability bound was IDENT-ness: a struct-FIELD
// receiver fell past it into the tag compare and answered `s.f is K` TRUE for the
// non-member `"zz"`, `vl check --codegen` rc 0. The bound is effect-freedom, so every
// PLACE — a field path, a nested path, an element read, a map read — belongs on the
// membership arm.
//
// THE CONTROLS ARE HALF THE FILE. `i32field` pins the tag compare that is still correct:
// a `K | i32` box reaches kind 2 only through `K`, so one string-repped arm means the tag
// decides the question exactly and must keep doing so. `nulfield` pins the ATOM rep (a
// `K | null` field is an interned id with a `-1` sentinel, not a box). The three IDENT
// receivers pin the shapes that already worked.

type K = "a" | "b"
type S = { f: K | string }
type Inner = { f: K | string }
type Outer = { g: Inner }
type Tri = { f: K | string | i32 }
type NulS = { f: K | null }
type I32S = { f: K | i32 }

const gMem: K | string = "a"
const gNon: K | string = "zz"

function paramForm(u: K | string, lbl: string) {
  if u is K { print("param-" + lbl + ":yes") } else { print("param-" + lbl + ":no") }
  0
}

function fieldForm() {
  const sMem: S = { f: "a" }
  if sMem.f is K { print("field-mem:yes") } else { print("field-mem:no") }
  const sNon: S = { f: "zz" }
  if sNon.f is K { print("field-non:yes") } else { print("field-non:no") }

  const oMem: Outer = { g: { f: "b" } }
  if oMem.g.f is K { print("nested-mem:yes") } else { print("nested-mem:no") }
  const oNon: Outer = { g: { f: "zz" } }
  if oNon.g.f is K { print("nested-non:yes") } else { print("nested-non:no") }
}

function elemForm() {
  const xs: (K | string)[] = ["a", "zz"]
  if xs[0] is K { print("elem-mem:yes") } else { print("elem-mem:no") }
  if xs[1] is K { print("elem-non:yes") } else { print("elem-non:no") }
  // An IDENT subscript is a place too, so the element read stays on the membership arm.
  const i0 = 0
  const i1 = 1
  if xs[i0] is K { print("elemvar-mem:yes") } else { print("elemvar-mem:no") }
  if xs[i1] is K { print("elemvar-non:yes") } else { print("elemvar-non:no") }

  const m: {[string]: K | string} = Map()
  m["k"] = "b"
  if m["k"] is K { print("map-mem:yes") } else { print("map-mem:no") }
  m["k"] = "zz"
  if m["k"] is K { print("map-non:yes") } else { print("map-non:no") }
}

// A THREE-arm box: the second string-repped arm is what makes the tag ambiguous, and the
// i32 arm rides along without changing the answer.
function triForm() {
  const tMem: Tri = { f: "a" }
  if tMem.f is K { print("tri-mem:yes") } else { print("tri-mem:no") }
  const tNon: Tri = { f: "zz" }
  if tNon.f is K { print("tri-non:yes") } else { print("tri-non:no") }
}

// CONTROL — the ATOM rep. A `K | null` field is an interned i32 id (`-1` for null), no box
// and no tag; its `is K` is the id-membership ladder, which needs the same re-readable
// receiver and nothing else.
function nulFieldForm() {
  const nMem: NulS = { f: "a" }
  if nMem.f is K { print("nulfield-mem:yes") } else { print("nulfield-mem:no") }
  const nNon: NulS = { f: null }
  if nNon.f is K { print("nulfield-non:yes") } else { print("nulfield-non:no") }
}

// CONTROL — the tag compare that stays. `K | i32` has ONE string-repped arm, so kind 2 is
// reached only through `K` and the box tag answers the question exactly.
function i32FieldForm() {
  const iMem: I32S = { f: "b" }
  if iMem.f is K { print("i32field-mem:yes") } else { print("i32field-mem:no") }
  const iNon: I32S = { f: 7 }
  if iNon.f is K { print("i32field-non:yes") } else { print("i32field-non:no") }
}

// CONTROL — the three IDENT receivers the membership arm already claimed.
function identForms() {
  const lMem: K | string = "a"
  if lMem is K { print("local-mem:yes") } else { print("local-mem:no") }
  const lNon: K | string = "zz"
  if lNon is K { print("local-non:yes") } else { print("local-non:no") }
  paramForm("b", "mem")
  paramForm("zz", "non")
  if gMem is K { print("global-mem:yes") } else { print("global-mem:no") }
  if gNon is K { print("global-non:yes") } else { print("global-non:no") }
}

fieldForm()
elemForm()
triForm()
nulFieldForm()
i32FieldForm()
identForms()
