// @run
// @log S2
// @log a
// @log S3
// @log a
// @log S4
// @log a
// @log Sc
// @log a
// @log Sq
// @log a
// @log 5
// `print(<literal-union atom>)` over a receiver that is NOT a re-readable place must
// evaluate that receiver EXACTLY ONCE. This pins the evaluation COUNT, not just the value:
// the sibling `atom-call-result-print.vl` already pinned `print(first(ks))`'s value, and it
// passed the whole time the count was wrong, because its callee has no side effect.
//
// The atom widens to its member string through one shared `select` tower whose id is stashed
// once (`emitStashAtomId`). A per-member `if id == <member> { print "<member>" }` chain would
// re-read the receiver once per member, which is free for a place and another CALL for a
// call — so master printed the marker ONCE PER MEMBER: `S2` twice, `S3` three times, `S4`
// four times, with the right value in between. `vl check` clean, module valid, wrong number
// of evaluations. The member-count axis is here on purpose: the count tracked the member
// count exactly, which is what identifies the re-read as the mechanism.
//
// `gEv` is the independent half of the same assertion — a mutation instead of a print
// marker, so a miscount cannot be an artifact of how print itself is lowered. Five producer
// calls, five evaluations.

type K2 = "a" | "b"
type K3 = "a" | "b" | "c"
type K4 = "a" | "b" | "c" | "d"

let gEv = 0

function p2(): K2 {
  gEv = gEv + 1
  print("S2")
  return "a"
}

function p3(): K3 {
  gEv = gEv + 1
  print("S3")
  return "a"
}

function p4(): K4 {
  gEv = gEv + 1
  print("S4")
  return "a"
}

function pc(): K2 {
  gEv = gEv + 1
  print("Sc")
  return "a"
}

function pq(): K2 | null {
  gEv = gEv + 1
  print("Sq")
  return "a"
}

// A direct CALL in print's argument position, at three member counts.
print(p2())
print(p3())
print(p4())

// A CLOSURE call — the value-call ABI reaches the same seam.
const cf = pc
print(cf())

// A `??` whose LHS is a call: the coalesce result is the atom, and the receiver behind it
// is still a call.
print(pq() ?? "a")

// Five producers ran, so five evaluations.
print(gEv)
