// @log false
// A `const` bound to a join of literal-bound consts holds their set's atom, and every read of it
// widens back to the member string where a string is owed: a compare, a concat, `.length`, a
// string or set parameter, a list, interpolation, `is`, a capture, a map key, a `let` copy that
// reassigns, a return, a field and a nested join (D14757).
const A = "x"
const B = "y"
function takeS(s: string) { return s.length + 10 }
function takeK(k: "x" | "y") { return if k == "x" { 1 } else { 2 } }
function ret(c: boolean) {
  const M = if c { A } else { B }
  return M
}
function main(c: boolean) {
  const M = if c { A } else { B }
  print(M)
  print(M == "x")
  print(M == A)
  print(M + "!")
  print(M.length)
  print(takeS(M))
  print(takeK(M))
  const xs = [M, "z"]
  print(xs[0])
  print("<\{M}>")
  print(M is "x")
  const f = () => M
  print(f())
  const m: {[string]: i32} = Map()
  m[M] = 5
  print(m["x"] ?? -1)
  let s = M
  s = s + "?"
  print(s)
  print(ret(c))
  const r = { k: M }
  print(r.k)
  const N = if c { M } else { "w" }
  print(N)
}
main(true)
main(false)
const G = if A.length == 1 { A } else { B }
print(G)
print(G == "y")
