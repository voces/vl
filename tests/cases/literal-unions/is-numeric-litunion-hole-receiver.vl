// @run
// CONTRACT: `u is Z` over a NUMERIC literal union answers the same for an UN-ANNOTATED
// parameter and for a `T` parameter of a monomorphized generic as it does for the annotated
// `u: i32` twin — and it answers correctly at a MEMBER and at a NON-MEMBER.
//
// The receiver half of the numeric-litunion membership test has to be answered per INSTANCE.
// `nodeNumScalarBaseName` reads the type the CHECKER banked at the node, and an un-annotated
// parameter has no annotation node to bank one on: `monoArgTyName`'s `"i32"` catch-all is what
// pins it, and that is the one arm of the pin which deliberately mints no annotation. So the
// bank answered "" for `function g(u)`, the whole membership arm declined, and the guard fell
// through to the monomorphized static-`is` fold — which const-folds a literal tested type to
// FALSE. Every hole and generic cell below printed the NOT branch with `vl check` rc 0, while
// the `u: i32` cell of the identical program was correct one line away. `isNumRecvBaseName`
// composes the bank with `monoArgTyName`, the same `fnIx`-scoped answer that fold reads, so
// the arm claims exactly the receivers the fold would otherwise decide.
//
// MEASURED: the hole-receiver guard emits a body BYTE-IDENTICAL to the `u: i32` control's
// (13 instructions), which is what makes the annotation's presence a no-op rather than a
// second lowering.
//
// EVERY SPELLING OF THE GUARD IS HERE, not just the `if`: the wrong answer came from the
// CONDITION, so a negated guard, an `is` bound to a value, a `while` guard and both
// short-circuit positions each carried it.

type Z = 1 | 2

// ── the un-annotated parameter, six guard spellings ─────────────────────────────
// @log h-if:IS
// @log h-if:NOT
function hIf(u) {
  if u is Z { return "h-if:IS" }
  return "h-if:NOT"
}
print(hIf(1))
print(hIf(9))

// @log h-not:IS
// @log h-not:NOT
function hNot(u) {
  if !(u is Z) { return "h-not:NOT" }
  return "h-not:IS"
}
print(hNot(2))
print(hNot(9))

// @log h-val:IS
// @log h-val:NOT
function hVal(u) {
  const b = u is Z
  if b { return "h-val:IS" }
  return "h-val:NOT"
}
print(hVal(1))
print(hVal(0))

// @log h-while:IS
// @log h-while:NOT
function hWhile(u) {
  let n = 0
  while (u is Z) && n < 1 { n = n + 1 }
  if n > 0 { return "h-while:IS" }
  return "h-while:NOT"
}
print(hWhile(2))
print(hWhile(3))

// @log h-and:IS
// @log h-and:NOT
function hAnd(u) {
  if (u is Z) && (1 == 1) { return "h-and:IS" }
  return "h-and:NOT"
}
print(hAnd(1))
print(hAnd(9))

// @log h-or:IS
// @log h-or:NOT
function hOr(u) {
  if (u is Z) || (1 == 2) { return "h-or:IS" }
  return "h-or:NOT"
}
print(hOr(2))
print(hOr(9))

// ── the GENERIC parameter: one node, one instance per pinned rep ────────────────
// The `string` instantiation is the control that keeps the receiver half honest — its
// member set is numeric, so that instance must NOT take the numeric compare (an `i32.eq`
// over a string ref is invalid wasm) and must answer NO.
// @log g-num:IS
// @log g-num:NOT
// @log g-str:NOT
function gIs<T>(u: T) {
  if u is Z { return "IS" }
  return "NOT"
}
print("g-num:" + gIs(1))
print("g-num:" + gIs(9))
print("g-str:" + gIs("zz"))

// ── the ANNOTATED CONTROL, which was already correct and must not move ──────────
// @log a-if:IS
// @log a-if:NOT
function aIf(u: i32) {
  if u is Z { return "a-if:IS" }
  return "a-if:NOT"
}
print(aIf(1))
print(aIf(9))

// ── an i64-based member set through a hole, so the compare's WIDTH follows the
// receiver rather than a separately derived base name ───────────────────────────
// @log w:IS
// @log w:NOT
type W = 5000000000 | 6000000000
function wIs(u) {
  if u is W { return "w:IS" }
  return "w:NOT"
}
print(wIs(6000000000))
print(wIs(7000000000))

// ── a FLOAT member set through a hole ──────────────────────────────────────────
// @log f:IS
// @log f:NOT
type FZ = 1.5 | 2.5
function fIs(u) {
  if u is FZ { return "f:IS" }
  return "f:NOT"
}
print(fIs(2.5))
print(fIs(9.75))
