// @run
// CONTRACT: `u is K` over a literal union that has NO ALIAS OF ITS OWN — the flattened
// `K1 | K2`, and the equivalent inline spelling — is a MEMBERSHIP test over K's member
// set, at every receiver position, for BOTH arms and for a member shared by both.
//
// Such a union reps as its member STRING, not as an interned atom: the atom valtype
// ladders carry a litunion only where its emit-time spelling is a registered alias NAME
// (`ctxKeepsLitUnion` is false at `RC_ROOT` and `RC_FN_PARAM`), and no alias here has the
// flattened member set. So the test cannot be the atom membership chain and cannot be a
// box-tag compare either — an all-literal member set carries no box. It is the string
// VALUE membership `recv == "m0" || recv == "m1" || …`, the same semantics one lowering
// down. Without that arm the guard reached the monomorphized static-`is` fold, which sees
// a non-union rep and a tested name that is no variant row, and answered a CONSTANT FALSE
// — a branch that can never run, `vl check --codegen` clean.
//
// THE CONTROLS BELOW ARE THE OTHER REP, AND THEY MUST NOT MOVE: a single-alias receiver
// (`SA`) is an atom and takes the interned-id chain; a mixed union (`MA | string`,
// `MA | i32`) boxes and takes the tag-gated payload membership.
//
// EVERY GROUP SPELLS DISJOINT LEXEMES (#1304's method note) so an alias registration
// cannot answer a lookup it was not asked, and NO alias here carries a flattened member
// set — declaring one would route these receivers down the working alias path and the
// file would pin nothing.

// ── DISJOINT arms, PARAM receiver, both arms tested both ways ───────────────────
// @log da:A
// @log da:-
// @log dd:-
// @log dd:B
type DA = "da" | "db"
type DB = "dc" | "dd"
function paramDisjoint(u: DA | DB, tag: string) {
  if u is DA { print(tag + ":A") } else { print(tag + ":-") }
  if u is DB { print(tag + ":B") } else { print(tag + ":-") }
  0
}
paramDisjoint("da", "da")
paramDisjoint("dd", "dd")

// ── OVERLAPPING arms: a SHARED member belongs to both, and answers TRUE to both ──
// @log oa:A
// @log oa:-
// @log ob:A
// @log ob:B
// @log oc:-
// @log oc:B
type OA = "oa" | "ob"
type OB = "ob" | "oc"
function paramOverlap(u: OA | OB, tag: string) {
  if u is OA { print(tag + ":A") } else { print(tag + ":-") }
  if u is OB { print(tag + ":B") } else { print(tag + ":-") }
  0
}
paramOverlap("oa", "oa")
paramOverlap("ob", "ob")
paramOverlap("oc", "oc")

// ── the BINDING receivers: module global, `const`, `let`, and a reassigned `let` ─
// @log g:B
// @log c:A
// @log l0:-
// @log l1:A
const gFlat: DA | DB = "dc"
function bindings() {
  if gFlat is DB { print("g:B") } else { print("g:-") }
  const c: DA | DB = "db"
  if c is DA { print("c:A") } else { print("c:-") }
  let l: DA | DB = "dc"
  if l is DA { print("l0:A") } else { print("l0:-") }
  l = "da"
  if l is DA { print("l1:A") } else { print("l1:-") }
  0
}
bindings()

// ── the INLINE spelling: the same flattened type, written without the aliases ────
// @log ia:A
// @log ia:-
// @log id:-
// @log id:B
type IA = "ia" | "ib"
function paramInline(u: ("ia" | "ib") | ("ic" | "id"), tag: string) {
  if u is IA { print(tag + ":A") } else { print(tag + ":-") }
  if u is ("ic" | "id") { print(tag + ":B") } else { print(tag + ":-") }
  0
}
paramInline("ia", "ia")
paramInline("id", "id")

// ── a member LITERAL over the same receiver: the value test, unchanged ───────────
// @log ml:yes
// @log ml:no
function memberLit(u: DA | DB) {
  if u is "da" { print("ml:yes") } else { print("ml:no") }
  0
}
memberLit("da")
memberLit("dd")

// ── CONTROL, the ATOM rep: a single registered alias, tested against a subset ────
// @log sa:S
// @log sa:lit
// @log sc:-
// @log sc:-
type SA = "sa" | "sb" | "sc"
type SS = "sa" | "sb"
function single(u: SA, tag: string) {
  if u is SS { print(tag + ":S") } else { print(tag + ":-") }
  if u is "sa" { print(tag + ":lit") } else { print(tag + ":-") }
  0
}
single("sa", "sa")
single("sc", "sc")

// ── CONTROL, the BOX rep: a litunion ARM of a mixed value union ──────────────────
// @log ms:A
// @log ms:-
// @log mi:A
// @log mi:-
type MA = "ma" | "mb"
function mixedStr(u: MA | string) {
  if u is MA { print("ms:A") } else { print("ms:-") }
  0
}
mixedStr("mb")
mixedStr("zz")
function mixedInt(u: MA | i32) {
  if u is MA { print("mi:A") } else { print("mi:-") }
  0
}
mixedInt("ma")
mixedInt(7)
