// @run
// @log a
// @log n
// @log c
// @log a
// @log n
// A module global of an inline `"a" | "b" | "c" | null` niche widens into a `string | null`
// global's initialiser, and an un-annotated global that holds the niche takes another's value
// as the atom it is (D3198).
const x0: "a" | "b" | "c" | null = "a"
const s: string | null = x0
print(s ?? "n")
const x1: "a" | "b" | "c" | "d" | null = null
const t: string | null = x1
print(t ?? "n")
let x2: "a" | "b" | "c" | "d" | null = "a"
x2 = "c"
const u: string | null = x2
print(u ?? "n")
let a = x0
let b = x0
b = a
print(b ?? "n")
a = null
print(a ?? "n")
