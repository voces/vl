// @check
// @error m is only ever "x" | "y" here, so this test is always false. If m can take other values, declare them in its type: "x" | "y" | "z" | "w"
// @error B is always "debug" here, so this test is always false. If B can take other values, declare them in its type: "debug" | "x"
// @error v holds no literal but "x" here, so this test is always false. If v can take other values, declare them in its type: "x" | i32 | "z"
// @error n is null or "x" | "y" here, so this test is always false. If n can take other values, declare them in its type: "x" | "y" | null | "z" | "q"
// @error a is only ever "x" | "y" here, so this test is always false. If a can take other values, declare them in its type: "x" | "y" | "z" | "q"
// @error x is null or 1 | 2 here, so this test is always false. If x can take other values, declare them in its type: 1 | 2 | null | 7 | 9
// An `is` against a literal set that shares NO value with the operand's literal type is
// refused, since it is always false (D2205) — declared or aliased, beside a non-literal member,
// under a nullable, and for numeric literals. An overlapping set is allowed.
function inline(m: "x" | "y") { print(m is "z" | "w") }
const B: "debug" = "debug"
print(B is "x")
function mixed(v: "x" | i32) { print(v is "z") }
function nullable(n: "x" | "y" | null) { print(n is "z" | "q") }
type M = "x" | "y"
type Z = "z" | "q"
function aliased(a: M) { print(a is Z) }
type X = 1 | 2 | null
function numeric(x: X) { print(x is 7 | 9) }
