// A hole function returning a read off an atom-valued map returns `AB | null` at each call, so a
// miss prints `null` rather than a member, at an i32 and a string key alike (D7881).
type AB = "a" | "b"
type R = { m: {[i32]: AB} }
type S = { m: {[string]: AB} }

function mk(): R {
  const m: {[i32]: AB} = Map()
  m[3] = "b"
  { m: m }
}

function mkS(): S {
  const m: {[string]: AB} = Map()
  m["z"] = "b"
  { m: m }
}

function pick1(p) { return p.m[9] }
function pickHit(p) { return p.m[3] }
function pickS(p) { return p.m["q"] }
function outer(p) { return pick1(p) }
function show(s: AB | null) { print(s == null) }
function viaR(r: R) { print(pick1(r)) }

const r = mk()
const s = mkS()
print(pick1(r))
print(pickHit(r))
print(pickS(s))
print(outer(r))
const b = pick1(r)
print(b == null)
print(b ?? "a")
show(pick1(r))
show(pickHit(r))
const o = { v: pickS(s) }
print(o.v)
viaR(r)
// @log null
// @log b
// @log null
// @log null
// @log true
// @log a
// @log true
// @log false
// @log null
// @log null
