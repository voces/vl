// @check
// @error MODE is always "debug" here, so this comparison is always false. If MODE can take other values, declare them: const MODE: "debug" | "release" = "debug"
// @error MODE is always "debug" here, so this comparison is always false. If MODE can take other values, declare them: const MODE: "debug" | "relaese" = "debug"
// @error MODE is always "debug" here, so this comparison is always true. If MODE can take other values, declare them: const MODE: "debug" | "release" = "debug"
// @error A is always "x" here, so this comparison is always false. If A can take other values, declare them: const A: "x" | "y" = "x"
// @error B is always "y" here, so this comparison is always false. If B can take other values, declare them: const B: "y" | "a" | "b" = "y"
// @error MODE is always "debug" here, so this test is always false. If MODE can take other values, declare them: const MODE: "debug" | "release" = "debug"
// @error M is only ever "x" | "y" here, so this comparison is always false. If M can take other values, declare them: const M: "x" | "y" | "z" = ...
// A `const` bound to a string literal holds that literal's type, so comparing it with a literal
// it can never equal is refused rather than compiled as a constant test (D2198) — in either
// operand order, against another such const, against a declared literal type, under `!=`, and
// as an `is` test. The typo (`"relaese"`) is the case the rule exists for.
const MODE = "debug"
const A = "x"
const B = "y"
if MODE == "release" { print("release") }
if "release" == MODE { print("release") }
if MODE == "relaese" { print("release") }
if MODE != "release" { print("debug") }
print(A == B)
function pick(k: "a" | "b") { k == B }
print(pick("a"))
print(MODE is "release")
function join(c: boolean) {
  const M = if c { A } else { B }
  M == "z"
}
print(join(true))
