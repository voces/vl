// @run
// @log q
// @log 9
// @log y
// @log b
// @log z
// @log y
// @log 4
// @log y
// @hint redundant type annotation: `xs` is inferred as `{k: K, n: i32}[]` — remove it to lean on inference

// D11030 — an inline record annotation whose field is a literal union (an alias, an inline set
// or one literal) must not adopt a declared row with the same field names whose field is a
// plain `string` or `i32`: the value is laid out as the literal union, so either row reads it
// at the wrong rep. The declared plain rows come first so a first-match scan would take them.
type K = "x" | "y"
type Rs = { k: string, n: i32 }
type Ri = { k: i32, n: i32 }
const rs: Rs = { k: "q", n: 1 }
const ri: Ri = { k: 7, n: 2 }
print(rs.k)
print(ri.k + ri.n)

type Ra = { k: K, n: i32 }
const ra: Ra = { k: "y", n: 3 }
function va(r: { k: K, n: i32 }): K { r.k }
print(va(ra))

type Rb = { k: "a" | "b", n: i32 }
const rb: Rb = { k: "b", n: 3 }
function vb(r: { k: "a" | "b", n: i32 }): string { r.k }
print(vb(rb))

type Rz = { k: "z", n: i32 }
const rz: Rz = { k: "z", n: 3 }
function vz(r: { k: "z", n: i32 }): string { r.k }
print(vz(rz))

// The same field through a generic function value, delivered un-annotated.
function pick<T>(r: { k: T, n: i32 }): T { r.k }
function deliver() { return pick }
const v = deliver()
const r1: { k: K, n: i32 } = { k: "y", n: 3 }
print(v(r1))
const r2: { k: K, n: i32 } = { k: "y", n: 4 }
const xs: { k: K, n: i32 }[] = [r1, r2]
print(xs[1].n)
print(v(xs[1]))
