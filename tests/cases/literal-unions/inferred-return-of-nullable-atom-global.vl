// A module global declared at a nullable literal union is the atom niche whatever literal
// initialises it, so a function returning it with no declared result returns the atom (D7122).
type K = "a" | "b"

const ga: ("a" | "b") | null = "a"
let gb: K | null = "b"
const gc: K | null = "b"
const gd = gc

function d() { return ga }
function e() { return gb }
function f() { return gd }
function show(s: K | null) { print(s == null) }

print(d() == null)
print(d())
print(d() == "a")
print(e())
gb = "a"
print(e() == "a")
gb = null
print(e())
print(f())
show(d())
print(d() ?? "z")
// @log false
// @log a
// @log true
// @log b
// @log true
// @log null
// @log b
// @log false
// @log a
