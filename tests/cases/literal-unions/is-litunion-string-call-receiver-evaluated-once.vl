// @run
// @log E
// @log yes
// @log E
// @log no
// @log E
// @log true
// @log 3
// `src(s) is CK` over a plain `string` receiver that is not a place. The answer is membership
// over CK's members, which reads the receiver once per member, so the call is evaluated once
// into a local first (D12060). The last test is the static fold: `src(s) is string` is
// always true and must still run the call (D12070).
//
// `is-litunion-over-string-receiver.vl` pins the receivers that are places.

type CK = "ca" | "cb"

let gEv = 0

function src(s: string) {
  gEv = gEv + 1
  print("E")
  s
}

function probe(s: string) {
  if src(s) is CK { print("yes") } else { print("no") }
  0
}

probe("ca")
probe("zz")
print(src("q") is string)
print(gEv)
