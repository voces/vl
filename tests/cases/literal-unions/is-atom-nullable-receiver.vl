// @run
// @log 1
// @log 2
// @log 1
// CONTRACT: `k is K` over a `K | null` receiver is that receiver's NON-NULL test. The niche
// is the atom id with `-1` for null, and `-1` is no member's interned id, so the membership
// chain the atom receiver takes answers it directly.
//
// Before D-ATOMIS this guard SILENTLY CONST-FOLDED FALSE for every binding form — the worst
// failure mode in the family, because the program still ran and simply skipped the branch.
// `paramForm("x")` printed nothing at all on master.

type K = "x" | "y"

function paramForm(p: K | null) {
  if p is K { print(1) } else { print(2) }
}

function localForm() {
  const l: K | null = "y"
  if l is K { print(1) }
}

paramForm("x")
paramForm(null)
localForm()
