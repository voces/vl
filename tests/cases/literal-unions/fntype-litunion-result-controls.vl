// @run
// @log b
// @log q
// @log b
// @log 2
// @log 1
// @warning Unused variable `stored` (prefix with `_` to suppress, or remove it)
// The redundant-annotation HINT is the point of three of these cells, not noise: the
// annotation is exactly what the failing row writes, and the hint is the only thing in the
// tree that points a caller at it.
// @hint redundant type annotation: `aliased` is inferred as `(i32) => K` — remove it to lean on inference
// @hint redundant type annotation: `numeric` is inferred as `(i32) => 1 | 2` — remove it to lean on inference
// @hint redundant type annotation: `stored` is inferred as `(i32) => "a" | "b"` — remove it to lean on inference
// The RUNNING half of the grid whose failing half is
// `tests/cases/soundness/xfail-miscompile-fntype-litunion-result-call.vl` — a function VALUE
// whose annotated type declares an INLINE string literal-union RESULT is a check-clean
// invalid module when it is CALLED. These are the neighbouring spellings that are CORRECT,
// pinned so the fix for that row cannot be taken by making one of them wrong.
//
// They are also what says what the predicate IS. `ctxKeepsLitUnion` preserves a literal
// union's members at `RC_FN_RES` and softens them at `RC_ROOT`, so the failing cell is
// exactly the one where an INLINE union sits at a function TYPE's result while the function
// DECLARATION bound to it softened the same union to `string`. Remove either half of that —
// the annotation, or the inline spelling, or the string family — and the two ends agree.
//
// THE ALIAS CELL USES A DISJOINT MEMBER SET (`"p" | "q"`), and that is not cosmetic. A
// same-layout alias declared ANYWHERE in the module graph changes how the INLINE spelling
// reps — the "hazard scope is the compiled program, not the module" rule `std/array.vl`'s
// header records — so writing the alias as `"a" | "b"` here turned three of these cells into
// `emitProgram: literal-union string widening with no members` and would have pinned an
// interaction rather than the controls.
type K = "p" | "q"

function toAB(x: i32): "a" | "b" {
  if x > 0 { return "b" }
  "a"
}

function toK(x: i32): K {
  if x > 0 { return "q" }
  return "p"
}

function to12(x: i32): 1 | 2 {
  if x > 0 { return 2 }
  1
}

// 1 — NO ANNOTATION. Inference takes the declaration's own softened result, so the binding
// and the callee agree. This is what the checker's redundant-annotation hint asks for, and
// it is the remedy a caller who meets the invalid module should reach for.
const inferred = toAB
print(inferred(1))

// 2 — a declared ALIAS as the result. `K` reps as the interned atom at BOTH positions
// (`nodeTyIsLitUnionAlias` claims a `K`-returning declaration too), so there is no seam.
const aliased: (i32) => K = toK
print(aliased(1))

// 3 — the same annotation as a PARAMETER rather than a binding.
function apply(g: (i32) => ("a" | "b"), n: i32): string {
  return g(n)
}

print(apply(toAB, 1))

// 4 — a NUMERIC literal union in the failing position. Its members are `i32` values, not
// interned atoms, so neither position has anything to preserve.
const numeric: (i32) => (1 | 2) = to12
print(numeric(1))

// 5 — the failing annotation, never CALLED. The STORE is not the boundary; the `call_ref`
// RESULT is. Without this cell a reader would look for the defect at the binding.
const stored: (i32) => ("a" | "b") = toAB
print(1)
