// @run
// @log b
// @log q
// @log b
// @log 2
// @log 1
// @log b
// @log b
// @log b
// @warning Unused variable `stored` (prefix with `_` to suppress, or remove it)
// The redundant-annotation HINT is the point of four of these cells, not noise: the
// annotation is exactly what the failing row wrote, and the hint was the only thing in the
// tree that pointed a caller at it.
// @hint redundant type annotation: `aliased` is inferred as `(i32) => K` — remove it to lean on inference
// @hint redundant type annotation: `numeric` is inferred as `(i32) => 1 | 2` — remove it to lean on inference
// @hint redundant type annotation: `stored` is inferred as `(i32) => "a" | "b"` — remove it to lean on inference
// @hint redundant type annotation: `called` is inferred as `(i32) => "a" | "b"` — remove it to lean on inference
// @hint redundant type annotation: `bare` is inferred as `(i32) => "a" | "b"` — remove it to lean on inference
// THE WHOLE GRID, running. Its failing half was
// `tests/cases/soundness/xfail-miscompile-fntype-litunion-result-call.vl` — a function VALUE
// whose annotated type declares an INLINE string literal-union RESULT was a check-clean
// invalid module when it was CALLED — and that file is folded in here, as its own header
// asked, rather than kept beside a file that now covers it.
//
// THE FIX WAS TO STOP CALLING A FUNCTION RESULT A CONTAINER. `ctxKeepsLitUnion` preserved a
// literal union's members at `RC_FN_RES` and softened them at `RC_ROOT`, so
//
//   function toAB(x: i32): "a" | "b"        // `RC_ROOT`   — a string ref, and the emitted
//                                           // functype said so
//   const f: (i32) => ("a" | "b") = toAB    // `RC_FN_RES` — the interned i32 ATOM, and the
//                                           // `$fnsig` the `call_ref` cast to said so
//
// were two reps of one type across one boundary. The three surviving preserve positions are
// CONTAINERS — an element, a field, a map value — whose slot really does hold the atom, and
// whose crossings the emitter has a widen and a narrow for. A function RESULT is the same
// scalar position a DECLARATION's return annotation occupies, and that one is `RC_ROOT`. The
// ALIAS is untouched by the change: it keeps its name at a function result through
// `litUnionAliasNameOfTy`, which is why cell 2 below still reps the atom at both ends.
//
// THE ALIAS CELL USES A DISJOINT MEMBER SET (`"p" | "q"`), and that is not cosmetic. A
// same-layout alias declared ANYWHERE in the module graph changes how the INLINE spelling
// reps — the "hazard scope is the compiled program, not the module" rule `std/array.vl`'s
// header records — so writing the alias as `"a" | "b"` here turned three of these cells into
// `emitProgram: literal-union string widening with no members` and would have pinned an
// interaction rather than the controls.
type K = "p" | "q"

function toAB(x: i32): "a" | "b" {
  if x > 0 { return "b" }
  "a"
}

function toK(x: i32): K {
  if x > 0 { return "q" }
  return "p"
}

function to12(x: i32): 1 | 2 {
  if x > 0 { return 2 }
  1
}

// 1 — NO ANNOTATION. Inference takes the declaration's own softened result, so the binding
// and the callee agree. This was the remedy a caller who met the invalid module reached for,
// and it is what the checker's redundant-annotation hint asks for.
const inferred = toAB
print(inferred(1))

// 2 — a declared ALIAS as the result. `K` reps as the interned atom at BOTH positions
// (`nodeTyIsLitUnionAlias` claims a `K`-returning declaration too), so there was never a seam.
const aliased: (i32) => K = toK
print(aliased(1))

// 3 — the same annotation as a PARAMETER rather than a binding.
function apply(g: (i32) => ("a" | "b"), n: i32): string {
  return g(n)
}

print(apply(toAB, 1))

// 4 — a NUMERIC literal union in the failing position. Its members are `i32` values, not
// interned atoms, so neither position ever had anything to preserve.
const numeric: (i32) => (1 | 2) = to12
print(numeric(1))

// 5 — the failing annotation, never CALLED. The STORE was never the boundary; the `call_ref`
// RESULT was. Without this cell a reader would look for the defect at the binding.
const stored: (i32) => ("a" | "b") = toAB
print(1)

// ── THE THREE CELLS THAT WERE INVALID MODULES ──────────────────────────────────────────
// Folded in from the xfail. All three are the same disagreement through a different
// spelling, and all three moved together, which is what says the rule — not the spelling —
// was what was wrong.

// 6 — the pinned row itself: the PARENTHESIZED result, called through a binding.
const called: (i32) => ("a" | "b") = toAB
print(called(1))

// 7 — the UNPARENTHESIZED spelling of the same annotation.
const bare: (i32) => "a" | "b" = toAB
print(bare(1))

// 8 — a GENERIC neighbour, recorded by the std review that filed the row: the same
// disagreement reached through a type PARAMETER instead of an annotation. `once<A>` binds `A`
// from the callback's rendered function type, and the render softened the PARAMETER while
// preserving the RESULT — one alias, two names, inside one signature. It is the ALIAS
// spelling here on purpose: it is the cell the inline one cannot reach.
function once<A>(f: (A) => A, init: A): A {
  return f(init)
}

function flipK(v: K): K {
  if v == "p" { return "q" }
  return "p"
}

const seed: K = "p"
if once(flipK, seed) == "q" { print("b") } else { print("NOT-q") }
