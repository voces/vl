// @run
// @log b
// @log a
// CONTRACT: a NARROWED `K | null` niche prints its member string — including through a module
// GLOBAL, which is the cell master miscompiled. The global's cell is `(mut i32)` (the atom id)
// while `exprString` answers TRUE about it, because it reads the SOFTENED render (`string`) of
// a value the emitter laid out as an i32. `print`'s dispatch asked `exprString` first, so the
// string printer was handed a raw atom id: `failed to compile: wasm[0]::function[4]`.
//
// The atom question is now asked FIRST, and it is the one that knows the rep. The local form
// (below) already worked, which is what made the global form look like a niche-only problem.

type K = "a" | "b"

const g: K | null = "b"
if g != null { print(g) }

function localForm() {
  const l: K | null = "a"
  if l != null { print(l) }
}

localForm()
