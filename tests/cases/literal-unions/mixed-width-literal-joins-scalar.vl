// @run
// @log 1
// @log 9000000000
// @log 5
// @log 1
// @log 7
// @log 9000000000
// A numeric literal member joined beside the scalar it softens to is held by that scalar, so
// `9000000000 | 1` joined with an `i32` is `9000000000 | i32`, and its list stores the box both
// sides built (D5522). Un-annotated and annotated lists, and a value `if` as a second position.
const x: 9000000000 | 1 = 1
const y: 9000000000 | 1 = 9000000000

const xs = [x, y, 5]
print(xs[0])
print(xs[1])
print(xs[2])

const ys: (9000000000 | i32)[] = [x, 5]
print(ys[0])

function pickOr(n: i32) {
  if n > 1 { x } else { n + 6 }
}
print(pickOr(1))
const zs = [pickOr(1), y]
print(zs[1])
