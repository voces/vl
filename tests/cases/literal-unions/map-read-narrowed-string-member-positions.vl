// @run
// @log b
// @log b
// @log 4
// @log b
// @log a
// A null-free `i32 | K` map read narrowed past `i32` is the literal member the box holds as its
// string: one row per position such a read is printed from.
type AB = "a" | "b"

const w: { [string]: i32 | AB } = Map()
w["k"] = "b"
w["n"] = 3
// the else of `is i32`, under a `!= null` guard
if w["k"] != null {
  if w["k"] is i32 { print(0) } else { print(w["k"]) }
}
// the else of `is i32`, bare
if w["k"] is i32 { print(0) } else { print(w["k"]) }
// the `i32` arm still reads its scalar
if w["n"] is i32 { print(w["n"] + 1) }
// a parameter map, in a function body
function show(p: { [string]: i32 | AB }) {
  if p["k"] is i32 { print(0) } else { print(p["k"]) }
}
show(w)
w["k"] = "a"
show(w)
