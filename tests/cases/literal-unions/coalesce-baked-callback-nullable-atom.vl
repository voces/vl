// A `??` over a call through a closure parameter that the call site bakes into a direct call
// reads its niche off the template's type: the rebuilt `??` and its parens keep it (D7452).
type K = "a" | "b"

function run(f: () => "a" | "b" | null): string { return f() ?? "n" }

function alias(f: () => K | null): string { (f() ?? "n") }

function one(f: () => "a" | null, d: string): string {
  const s = f() ?? d
  return s
}

function runU(f: () => K | null) { return f() ?? "n" }

function show(s: string) { print("arg " + s) }

function deliver(f: () => K | null): string {
  show(f() ?? "z")
  print(f() ?? "b")
  return "done"
}

print(run(() => "a"))
print(run(() => null))
print(alias(() => "b"))
print(one((): "a" | null => "a", "q"))
print(one((): "a" | null => null, "q"))
print(one(() => "a", "r"))
print(one(() => null, "r"))
print(deliver((): K | null => "a"))
print(deliver(() => null))
print(runU(() => "b"))
// @log a
// @log n
// @log b
// @log a
// @log q
// @log a
// @log r
// @log arg a
// @log a
// @log done
// @log arg z
// @log b
// @log done
// @log b
// @hint redundant type annotation: `run` is inferred as `string`
// @hint redundant type annotation: `alias` is inferred as `string`
// @hint redundant type annotation: `one` is inferred as `string`
// @hint redundant type annotation: `deliver` is inferred as `string`
