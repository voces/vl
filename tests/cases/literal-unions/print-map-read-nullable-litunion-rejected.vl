// @emit-error print of a nullable literal union — narrow it first
// CONTRACT (must-error): a BARE map read over a litunion-valued map types `K | null` (a
// missing key reads null), so `print(m[k])` is the same un-narrowed niche as the annotated
// binding beside it — reached by a different route, hence its own pin. On master this
// printed NOTHING at all: rc=0, empty output, for a map whose key was present.
//
// This shape is why the un-narrowed case is a REJECT rather than a widening chain that
// simply skips null: the value genuinely can be absent, and there is no member text to
// render for the absence.

type K = "ab" | "cd"

const m: {[string]: K} = Map()
m["k"] = "ab"
print(m["k"])
