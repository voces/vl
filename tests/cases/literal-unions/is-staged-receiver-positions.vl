// @run
// @log if yes
// @log if no
// @log true
// @log false
// @log true
// @log false
// @log true
// @log false
// @log true
// @log false
// @log 1
// @log 0
// @log false
// @log true
// @log true
// @log true
// @log false
// @log t
// @log 1
// @log true
// @log false
// @log na yes
// @log false
// @log true
// @log false
// @log 0
// @log 27
// Q58 position sweep: an `is` whose receiver is no re-readable place, so it is evaluated once into
// a stash before the test re-reads it, over each stash key: a box with a literal-union arm, a
// literal-union atom, a nullable string, a plain string and a float box against integers. Each
// sits in an `if` condition, a return, a `let` initializer, a call argument, a `&&` operand, an
// `if` arm value, a negation, a record field, a list element, an interpolation hole, a `while`
// condition and a lambda body; `gEv` counts that every call ran once.
type K = "a" | "b"
type R = { ok: boolean }
let gEv = 0
function bx(s: string): K | i32 {
  gEv = gEv + 1
  if s == "n" { return 1 }
  if s == "a" { return "a" }
  return "b"
}
function at(s: string): K | "c" {
  gEv = gEv + 1
  if s == "a" { return "a" }
  return "c"
}
function ns(s: string): string | null {
  gEv = gEv + 1
  if s == "" { return null }
  return s
}
function st(s: string) {
  gEv = gEv + 1
  return s
}
function fl(k: i32): f64 | string {
  gEv = gEv + 1
  if k == 0 { return 2.0 }
  return "s"
}
function na(s: string): K | null {
  gEv = gEv + 1
  if s == "a" { return "a" }
  return null
}
function bn(s: string): K | i32 | null {
  gEv = gEv + 1
  if s == "a" { return "a" }
  if s == "n" { return null }
  return 3
}
function ret(s: string) { return bx(s) is K }
function show(b: boolean) { print(b) }
function main() {
  if bx("a") is K { print("if yes") } else { print("if no") }
  if bx("n") is K { print("if yes") } else { print("if no") }
  print(ret("b"))
  print(ret("n"))
  const l1 = at("a") is K
  const l2 = at("z") is K
  print(l1)
  print(l2)
  show(ns("a") is K)
  show(ns("") is K)
  print(st("b") is K && true)
  print(st("q") is K && true)
  print(if fl(0) is 2 | 3 { 1 } else { 0 })
  print(if fl(1) is 2 | 3 { 1 } else { 0 })
  print(!(bx("a") is K))
  print(!(at("c") is K))
  const r: R = { ok: st("a") is K }
  print(r.ok)
  const xs = [ns("b") is K, ns("x") is K]
  print(xs[0])
  print(xs[1])
  print("\{if at("a") is K { "t" } else { "f" }}")
  let n = 0
  while bx(if n == 0 { "a" } else { "n" }) is K { n = n + 1 }
  print(n)
  const f = (s: string) => st(s) is K
  print(f("a"))
  print(f("zz"))
  if na("a") is K { print("na yes") } else { print("na no") }
  const l3 = na("z") is K
  print(l3)
  show(bn("a") is K)
  show(bn("n") is K)
  print(if bn("q") is K { 1 } else { 0 })
  print(gEv)
}
main()
