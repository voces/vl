// @run
// CONTRACT (CONTROL): the three STRING literal-union `is` reps answer exactly as they did
// before the NUMERIC membership arm existed. The numeric arm sits between the box-tag
// compare and the bare-literal value test in `emitIs`'s ladder, so every string rep passes
// THROUGH its gate; this file is the pin that none of them is claimed by it.
//
// The gate that keeps them apart is the tested type's base scalar: `numLitUnionBaseName`
// softens a `"str"`-kind member to `string`, which is not one of `i32` / `i64` / `f64`, so
// every cell below declines the numeric arm on its first question. The RECEIVER half of
// the same gate is what keeps a numeric test off a string value.
//
// The three reps, one group each — they are `is-atom-receiver.vl`,
// `is-alias-arm-of-flattened-litunion.vl` and `mixed-union-litunion-arm-is-membership.vl`
// in miniature, gathered here so a single run answers "did the ladder move".

// ── rep 1, the interned i32 ATOM: a single registered alias as the receiver ─────
// @log at:S
// @log at:lit
// @log ax:-
// @log ax:-
type SA = "sa" | "sb" | "sc"
type SS = "sa" | "sb"
function atomRecv(u: SA, tag: string) {
  if u is SS { print(tag + ":S") } else { print(tag + ":-") }
  if u is "sa" { print(tag + ":lit") } else { print(tag + ":-") }
  0
}
atomRecv("sa", "at")
atomRecv("sc", "ax")

// ── rep 2, the member STRING: a flattened `A | B` with no alias of its own ──────
// @log fa:A
// @log fa:-
// @log fd:-
// @log fd:B
type FA = "fa" | "fb"
type FB = "fc" | "fd"
function flatRecv(u: FA | FB, tag: string) {
  if u is FA { print(tag + ":A") } else { print(tag + ":-") }
  if u is FB { print(tag + ":B") } else { print(tag + ":-") }
  0
}
flatRecv("fa", "fa")
flatRecv("fd", "fd")

// ── rep 3, the value-union BOX: a litunion arm beside a different-rep arm ───────
// @log ms:A
// @log mz:-
// @log mi:A
// @log mn:-
type MA = "ma" | "mb"
function mixedStr(u: MA | string, tag: string) {
  if u is MA { print(tag + ":A") } else { print(tag + ":-") }
  0
}
mixedStr("mb", "ms")
mixedStr("zz", "mz")
function mixedInt(u: MA | i32, tag: string) {
  if u is MA { print(tag + ":A") } else { print(tag + ":-") }
  0
}
mixedInt("ma", "mi")
mixedInt(7, "mn")
