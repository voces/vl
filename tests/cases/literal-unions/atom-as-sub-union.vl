// @run
// @log b
// @log a
// @log b
// @log b
// @log a
// @log true
// @log b
// @log none
// @log true
// @log b!
// @log 2
// @log true
// @hint redundant type annotation: `opt` is inferred as `string` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// @hint redundant type annotation: `propStr` is inferred as `string` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// `as` from a literal-union atom to a narrower literal union compares the atom's id against the
// target's members: `as!` keeps it, `as?` gives null on a miss, `as` hands the miss back as the
// result's own atom or text (D5286). An operand already narrowed to the target cannot miss (D5285).
type NodeKind = "a" | "b"
type Wide = NodeKind | "event"
function ifCast(k: Wide): NodeKind {
  if k == "event" { "a" } else { k as! NodeKind }
}
function matchCast(k: Wide): NodeKind {
  match k {
    "event" => "a"
    _ => k as! NodeKind
  }
}
function plain(k: Wide): NodeKind { k as! NodeKind }
function viaCall(): NodeKind { mk() as! NodeKind }
function mk(): Wide { "b" }
function opt(k: Wide): string {
  const n = k as? NodeKind
  if n == null { "none" } else { n }
}
function prop(k: Wide): Wide {
  const n = k as NodeKind
  if n == "a" { "b" } else { "a" }
}
function propStr(k: Wide): string { const n = k as NodeKind; n + "!" }
print(ifCast("b"))
print(ifCast("event"))
print(matchCast("b"))
print(plain("b"))
print(plain("a"))
print((plain("b") as! NodeKind) == "b")
print(viaCall())
print(opt("event"))
print(prop("event") == "event")
print(propStr("b"))
const ws: Wide[] = ["a", "event", "b"]
const ks: NodeKind[] = []
for w in ws {
  if w != "event" { ks.push(w as! NodeKind) }
}
print(ks.length)
print(ks[1] == "b")
