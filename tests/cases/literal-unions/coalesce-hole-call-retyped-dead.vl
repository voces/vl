// @run
// @log y
// @log zz
// @log y
// @log true
// @log y
// @log 41
// @log 42
// @log 42
// @log 47
// @log 2
// @log 3
// @log y!
// @log y
// @log 42
// `??` over the call of an un-annotated parameter, in an instance where the call cannot be
// null: the default is dead at a string, a string literal union, a numeric literal union and
// i32 alike, and every reader of the `??` agrees on the operand's type (D9520, D9521, D9522).
type K = "x" | "y"
type N = 1 | 2
const k: K = "y"
const a: N = 1
const b: N = 2

function strOr(f) { print(f() ?? "q") }
strOr(() => "y")
strOr(() => "zz")

function atomOr(f) { print(f() ?? "x") }
atomOr(() => k)

function atomCompare(f) {
  const r = f() ?? "x"
  print(r == "y")
  print(r)
}
atomCompare(() => k)

function numOr(f) { print((f() ?? 0) + 40) }
numOr(() => a)
numOr(() => 2)

function numBound(f) {
  const r = f() ?? 0
  print(r + 40)
}
numBound(() => b)
numBound(() => 7)

function lenOr(f) { print((f() ?? "q").length) }
lenOr(() => "yy")
lenOr(() => "zzz")

function applied(f, g) { print(f(g()) ?? "q") }
applied((s) => s + "!", () => "y")

function atomBound(f) {
  const r: K = f() ?? "x"
  print(r)
}
atomBound(() => k)

const h = () => b
function numValue(f) { print((f() ?? 0) + 40) }
numValue(h)
