// @run
// @log prop
// @log prop
// @log wrap

// A place an `if` arm narrows and then writes reads below the `if` at what it held on entry,
// not at the arm's narrowing: the fall-through path never took that narrowing.
type Mode = "prop" | "wrap"
type Cast = { mode: Mode }

const nodes: Cast[] = []
function note() {
  if nodes.length > 0 { nodes[0].mode = "prop" }
}
function viaPath(n: Cast, flag: boolean) {
  if flag {
    if n.mode is "wrap" {
      note()
      return "early"
    }
    return "flag"
  }
  if n.mode is "wrap" { return "wrap" }
  "prop"
}
function viaName(m0: Mode, flag: boolean) {
  let m = m0
  if flag {
    if m is "wrap" {
      m = "wrap"
      return "early"
    }
    return "flag"
  }
  if m is "wrap" { return "wrap" }
  "prop"
}
function afterGuard(m0: Mode, flag: boolean) {
  let m = m0
  if flag {
    if m is "wrap" { return "early" }
    m = "prop"
  }
  if m is "wrap" { return "wrap" }
  "prop"
}
print(viaPath({ mode: "prop" }, false))
print(viaName("prop", false))
print(afterGuard("wrap", false))
