// @run
// @log true
// @log false
// @log 2
// @log true
// @log 4
// @log true
// @log 6
// @log false
// @log true
// @log 8
// @log no
// @log 9
// `x is K` where `x` is not a re-readable place, at the receiver positions a membership test
// can meet: a method call, an element read whose index is a call, a call through a record's
// function field, and a generic lambda returning a number box. Each receiver is evaluated once into a local before the
// test re-reads it per member (D12060), so `gEv` counts exactly one call per test.
//
// `src` and `num` infer their return types, so this is the un-annotated face; the annotated
// one is `is-litunion-arm-call-receiver-evaluated-once.vl`.

type K = "a" | "b"
type L = 1 | 2

let gEv = 0

function src(n: i32) {
  gEv = gEv + 1
  let v: K | i32 = 7
  if n == 0 { v = "b" }
  v
}

function nsrc(n: i32): K | null {
  gEv = gEv + 1
  if n == 0 { return "a" }
  null
}

function ix(n: i32) {
  gEv = gEv + 1
  n
}

type Bx = { k: i32 }
function get(self: Bx, n: i32) { src(n + self.k) }
const bx: Bx = { k: 0 }

print(bx.get(0) is K)
print(bx.get(1) is K)
print(gEv)

const items: (K | i32 | null)[] = ["b", 3, null]
print(!(items[ix(1)] is K) && items[ix(0)] is K)
print(gEv)

type O = { f: (n: i32) => K | null }
const o: O = { f: nsrc }
print(o.f(1) is K || o.f(0) is K)
print(gEv)

function F<A, B>(k: i32, x: A, y: B) {
  const g = () => {
    gEv = gEv + 1
    if k == 0 { x } else { y }
  }
  print(g() is L)
}
F(0, 2.5, 1)
F(1, 2.5, 1)
print(gEv)

if src(1) is K { print("yes") } else { print("no") }
print(gEv)
