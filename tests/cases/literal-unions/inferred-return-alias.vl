// @run
// @log B
// @log eq
// @log isK
// @log B
// @log B
// @log B
// @log done
// @log C
// @log B
// @log B
// @log v-B
// @log b
// @hint redundant type annotation: `r1` is inferred as `"A" | "B" | "C" | "D"`
// An UN-ANNOTATED function whose return type INFERS to a literal-union ALIAS (`type K =
// "A" | …`) reps as the interned i32 ATOM — the same rep the annotated `: K` spelling
// uses, and the emitted module is BYTE-IDENTICAL to that twin's.
//
// CONTRACT: `variantBoxUnionRetName` must not claim a PURE literal union. Its arity guard
// counts ARENA members, which is the count before its own litunion regroup contracts a
// whole run of `TyLit` members into ONE alias atom — so a four-literal union arrived
// carrying a single atom, `K`, and was recorded as a variant-box union. Every litunion
// also registers as a union NAME (`isUName`), so from there the callee `struct.new`'d a
// `{tag, anyref}` value-union box while each call site read the i32 atom: `vl check`
// clean, module refused by the engine.
//
// Both halves of the seam are exercised — the returned VALUE (a param, a local, a field,
// a list element, a call result) and what the CALL SITE does with it (print, `==`, `is`,
// an annotated binding, an un-annotated binding, an argument, a discarded result).

type K = "A" | "B" | "C" | "D"
type Cell = { c: K, n: i32 }

function idK(k: K) { return k }

function viaLocal(k: K) {
  const v = k
  return v
}

function fromField(x: Cell) { return x.c }

function fromList(xs: K[]) { return xs[0] }

function viaCall(k: K) { return idK(k) }

function sink(s: K) { print(s) }

// print — the returned atom widens to its member string.
print(idK("B")) // B

// `==` dispatch straight on the call result.
if idK("B") == "B" {
  print("eq") // eq
} else {
  print("ne")
}

// `is` over an un-annotated binding of the call result.
const r0 = idK("B")
if r0 is K {
  print("isK") // isK
} else {
  print("no")
}

// An ANNOTATED binding takes the atom.
const r1: K = idK("B")
print(r1) // B

// An UN-ANNOTATED binding takes it too, and print widens it.
const r2 = idK("B")
print(r2) // B

// Straight into another call's literal-union parameter.
sink(idK("B")) // B

// A DISCARDED result still lowers — the callee's functype result is the atom either way.
idK("B")
print("done") // done

// The other returned-value shapes: a list element, a struct field, a local.
print(fromList(["C", "D"])) // C
print(fromField({ c: "B", n: 1 })) // B
print(viaLocal("B")) // B

// Concat widens the returned atom to its member string.
print("v-" + viaCall("B")) // v-B

// Member dispatch off an un-annotated binding of a call-result return.
const r3 = viaCall("B")
if r3 == "A" {
  print("a")
} else if r3 == "B" {
  print("b")
} else {
  print("z")
} // b
