// @run
// @log b
// @log null
// @log a
// @log b
// @log null
// @log a
// A generic's returned join of a `K` pin, `null` and a member string lowers into the instance's
// `K | null` result arm by arm, with an explicit `return` and as the tail.
type K = "a" | "b"
function g<T>(c: i32, k: T) {
  return if c == 0 { k } else if c == 1 { null } else { "a" }
}
function h<T>(c: i32, k: T) {
  if c == 0 { k }
  else if c == 1 { null }
  else { "a" }
}
const k0: K = "b"
print(g(0, k0))
print(g(1, k0))
print(g(2, k0))
print(h(0, k0))
print(h(1, k0))
print(h(2, k0))
