// @run
// @log 1
// @log miss
// @log 1
// @hint redundant type annotation: `hit` is inferred as `N2 | null`
// @hint redundant type annotation: `w` is inferred as `N2 | null`
// CONTRACT: the annotated twin of `bound-map-read-of-num-litunion-null-test.vl`: an
// `N | null` binding of a `Map<string, N>` read, `N` a numeric literal union, null-tested at
// top level and in a function (D11241).

type N2 = 1 | 2

const x: N2 = 1
const m: Map<string, N2> = Map()
m.set("k", x)

const hit: N2 | null = m.get("k")
if hit != null { print(hit) }

function f() {
  const w: N2 | null = m.get("z")
  if w == null { print("miss") }
  if hit != null { print(hit) }
}

f()
