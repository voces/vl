// @emit-error a returned string cannot be shown to be a member of the literal union this instantiation's result is
// A generic whose instance returns the `K | null` niche refuses a string arm naming no member of
// `K`, rather than writing an atom id for it (D4173).
type K = "a" | "b"
function g<T>(c: i32, k: T) {
  return if c == 0 { k } else if c == 1 { null } else { "z" }
}
const k0: K = "b"
print(g(0, k0))
print(g(2, k0))
