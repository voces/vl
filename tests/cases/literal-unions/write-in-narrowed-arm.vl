// @run
// @log a!
// @log a
// @log b
// @log 1
// @log 2
// @log 11
// @log a!

// A write inside a branch a literal test narrowed re-narrows the binding to the member it
// wrote, so the reads after it lower at that member, whether the test was `is` or `==`.
type M = 1 | "a" | "b"

function pm(i: i32): M {
  if i == 0 { return 1 }
  if i == 1 { return "a" }
  "b"
}
function toStr(i: i32) {
  let x = pm(i)
  if x is 1 {
    x = "a"
    print(x + "!")
  } else {
    print(x)
  }
}
function toNum(i: i32) {
  let x = pm(i)
  if x == "a" {
    x = 1
    print(x + 1)
  } else {
    print(x)
  }
}
function eqToStr(i: i32) {
  let x = pm(i)
  if x == 1 {
    print(x + 10)
    x = "a"
    print(x + "!")
  }
}

toStr(0)
toStr(1)
toStr(2)
toNum(0)
toNum(1)
eqToStr(0)
