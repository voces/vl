// @run
// @log 2
// @log a?
// @log 2
// @log a?
// @log n
// @log 0
// @log b?
// @log 0

// Ruling `null` out of a value an earlier literal test left holding literals of one kind and
// `null` reads it at that kind, whichever order the two tests come in.
type M = 1 | "a" | "b"

function pm(i: i32): M {
  if i == 0 { return 1 }
  if i == 1 { return "a" }
  "b"
}
function get(i: i32): M | null {
  if i > 5 { return null }
  pm(i)
}
function isFirst(i: i32) {
  const x = get(i)
  if x is 1 { print(x + 1) }
  else if x != null { print(x + "?") }
}
function eqFirst(i: i32) {
  const x = get(i)
  if x == 1 { print(x + 1) }
  else if x == null { print("n") }
  else { print(x + "?") }
}
function joined(i: i32) {
  const x = get(i)
  if x == 1 || x == null { print(0) } else { print(x + "?") }
}

isFirst(0)
isFirst(1)
eqFirst(0)
eqFirst(1)
eqFirst(9)
joined(0)
joined(2)
joined(9)
