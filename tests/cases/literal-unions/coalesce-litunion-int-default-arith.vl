// @run
// @log 6000000001
// @log 1
// @log 0
// @log 15000000000
// @log 5000000002
// @log 2
// @log 5000000007
// @log 0
// @log 5000000000
// @log 6000000001
// @log 1
// @log 2.5
// @log 6000000000
// @log 5000000000
// @log 5000000000
// @log 4
// @log 5000000000
// @log 5000000000
// @log 4
// `??` over a nullable integer literal union with an `i32` default joins as `L | i32`, and
// arithmetic over that union of literals and an integer scalar computes at `i64` (D9563); a
// mixed-width union's box takes an `i32` or `f64` default at every reader (D9700).
type L = 5000000000 | 6000000000
type W = 1 | 2 | 5000000000
type N = 1 | 2
const a: L | null = 6000000000
const z: L | null = null
print((a ?? 0) + 1)
print((z ?? 0) + 1)
const w: W | null = null
const w2: W | null = 5000000000
const wt: W | null = 2
print((w ?? 0) * 3)
print((w2 ?? 0) * 3)
print((wt ?? 4) + 5000000000)
print(wt ?? 2.5)
const v = z ?? 7
const big = v + 5000000000
print(big)
function pick(x: L | null) { return x ?? 0 }
print(pick(null))
print(pick(5000000000))
const xs = [z ?? 1, a ?? 1]
print(xs[0] + xs[1])
const n: N | null = null
print((n ?? 0) + 1)
print(z ?? 2.5)
print(a ?? 2.5)
print(n ?? 5000000000)

// A function returning the box, read directly, listed and through an annotated parameter.
function g(): W | null { return w2 }
function h(): W | null { return w }
print(g() ?? 4)
print(h() ?? 4)
const ys = [g() ?? 4]
print(ys[0])
function take(f: () => W | null) { print(f() ?? 4) }
take(() => w2)
take(() => w)
