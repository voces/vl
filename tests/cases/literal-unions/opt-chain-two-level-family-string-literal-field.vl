// @run
// @log circle
// @log round
// @log none
// @log none
// @log circle
// @log true
// @log false
// @log circle
// @log round
// @log circle
// @log 2
// A two-level `?.` reading a literal-set field its layout family stores as the string decodes
// it to the atom the leaf's `K | null` holds, in every position its value reaches (D17282).
type K = "circle" | "round"
type A = { kind: K, r: i32 }
type B = { kind: string, r: i32 }
type W = { a: A | null }
function mk(n: i32): A | B {
  if n == 0 { return { kind: "round", r: 1 } }
  return { kind: "zz", r: 2 }
}
function deep(w: W | null): K | null { return w?.a?.kind }
function wide(w: W | null): string | null { return w?.a?.kind }
function take(k: K | null) { print(k ?? "none") }
const c: W = { a: { kind: "circle", r: 1 } }
const r: W = { a: { kind: "round", r: 2 } }
const e: W = { a: null }
print(deep(c) ?? "none")
print(deep(r) ?? "none")
print(deep(e) ?? "none")
print(deep(null) ?? "none")
print(wide(c) ?? "none")
print(c?.a?.kind == "circle")
print(r?.a?.kind == "circle")
const k = c?.a?.kind
if k != null { print(k) }
take(r?.a?.kind)
print(c?.a?.kind ?? "none")
print(mk(1).r)
