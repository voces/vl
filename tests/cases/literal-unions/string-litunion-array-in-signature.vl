// @run
// @log 1
// @log 1
// THE CONTROL for `soundness/numeric-litunion-array-in-signature.vl`: a STRING literal-union
// array in a function signature, in both the return and the parameter position. Both compile
// and run.
//
// The numeric-literal-union spelling of this exact program used to be refused outright, which
// is what made that one a completeness gap rather than a decline. It now compiles too — the
// numeric family reps as its BASE SCALAR and the array-element ladders grew the arm. This file
// stays as the STRING half of the pair, so a change that re-breaks one family reddens a test
// that names the other.
type S = "a" | "b"

function mk(): S[] {
  return ["a"]
}

function count(xs: S[]) {
  return xs.length
}

print(mk().length)
print(count(["b"]))
