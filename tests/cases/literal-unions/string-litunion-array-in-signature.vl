// @log 1
// THE CONTROL for `soundness/xfail-false-reject-numeric-litunion-array-in-signature.vl`: a
// STRING literal-union array in a function signature, in both the return and the parameter
// position. Both compile and run.
//
// The numeric-literal-union spelling of this exact program does not, which is what makes that
// one a completeness gap rather than a decline. Kept here, in the passing corpus, so the pair
// cannot drift apart — if this file ever starts failing, the xfail is no longer evidence of an
// asymmetry and its argument has to be rewritten.
type S = "a" | "b"

function mk(): S[] {
  return ["a"]
}

function count(xs: S[]) {
  return xs.length
}

print(mk().length)
print(count(["b"]))
