// @run
// @log e:ka
// @log e:-
// @log e:kb
// @log m:K
// @log m:-
// @log m:-
// @log n:K
// @log n:-
// @log l:kb
// @log l:-
// An `is` against a literal set over a receiver read once per member: a list element at a
// variable index, a map value at a key, a map value a `null` may never have written, a plain
// literal. The receiver reads no effect, so it is held in a local and each compare reads it.
type K = "ka" | "kb"
function elem(k: i32) {
  const xs: (K | string)[] = ["ka", "zz", "kb"]
  if xs[k] is K { print("e:" + xs[k]) } else { print("e:-") }
}
function mapVal(s: string) {
  const m: {[string]: string} = Map()
  m["a"] = "ka"
  m["b"] = "zz"
  if m[s] is K { print("m:K") } else { print("m:-") }
}
function nulMap(v: string | null) {
  const m: {[string]: string} = Map()
  if v != null { m["k"] = v }
  if m["k"] is K { print("n:K") } else { print("n:-") }
}
function lit(k: i32) {
  const xs: string[] = ["kb", "x"]
  if xs[k] is "kb" { print("l:kb") } else { print("l:-") }
}
elem(0)
elem(1)
elem(2)
mapVal("a")
mapVal("b")
mapVal("c")
nulMap("kb")
nulMap(null)
lit(0)
lit(1)
