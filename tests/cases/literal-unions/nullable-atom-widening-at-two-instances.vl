// @run
// @log b
// @log q
// @log n
// @log a
// @log z
// @log z
// @log null
// A `K | null` value widened to `string | null` inside a generic instanced in the same program
// at `K | null` and at another type reads the niche at its own instance: a return, a write into
// a declared local, and an `if` join beside a string literal (D3228, D3239, D4885).
type K = "a" | "b"
function h<T>(x: T): string | null { return x }
const k: K | null = "b"
print(h(k) ?? "n")
print(h("q") ?? "n")
function g<T>(x: T) {
  let s: string | null = null
  s = x
  print(s ?? "n")
}
const w: K | null = null
g(w)
const v: K = "a"
g(v)
function j<T0>(a0: T0, n: i32) { print(if n == 0 { a0 } else { "z" }) }
const x0: string = "s"
j(x0, 2)
const y1: K | null = null
j(y1, 2)
j(y1, 0)
