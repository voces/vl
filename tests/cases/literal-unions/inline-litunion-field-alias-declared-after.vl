// A LITERAL-UNION ALIAS IS ADOPTED BY MEMBER SET WHEREVER IT IS DECLARED (D1151).
//
// `annUnionInnerTy` gives an inline `"a" | "b"` annotation the arena index of a DECLARED alias
// with exactly those members (`litUnionAliasTyOfMembers`) — that is what makes the atom rep of
// `K` and of its pure inline spelling one type. The scan can only match a FILLED alias, and
// pass 0b filled declarations in source order, so `type C = { r: i32, k: "a" | "b" }` written
// ABOVE `type K = "a" | "b"` minted a fresh unregistered union while the identical spelling in
// a function signature — resolved after every declaration — adopted `K`. One spelling, two
// arena types: `fieldCodeOfSpelling`'s node arm coded the declared field 3 (a string ref) and
// the inline-shape parameter 0 (the interned atom), and passing the one into the other was
// `vl check` rc 0 over a module the engine refuses. Moving the `type K` line to the top of the
// file made the identical program run.
//
// THE ALIAS IS DECLARED LAST ON PURPOSE. `inline-litunion-field-two-spellings-one-layout.vl`
// declares it FIRST and says so; this file is the other order, and the two together are the
// statement that the order does not decide the layout.
//
// THE CONTROLS ARE ONE LINE APART: a same-membered alias is required (`type K = "x" | "y"`
// beside a `"a" | "b"` field leaves both spellings on the string slot and always ran), and so
// is the inline-shape PARAMETER (passing through `f(c: C)` names the declared row directly).
// @run
// @log 3
// @log a
// @log 4
// @log b
// @log 9
// @log 5
// @log q

type C = { r: i32, k: "a" | "b" }
function f(c: { r: i32, k: "a" | "b" }) { c.r }

type K = "a" | "b"
type NC = { r: i32, k: K }
function nf(v: { r: i32, k: K }) { v.r }

const c: C = { r: 3, k: "a" }
const nc: NC = { r: 4, k: "b" }
print(f(c))
print(c.k)
print(nf(nc))
print(nc.k)

// TWO DECLARATIONS OF THE ONE SPELLING, one on each side of the alias, must be one layout.
type C1 = { r: i32, k: "a" | "b" }
type C2 = { r: i32, k: "a" | "b" }
function g(x: C1) { x.r }
const c1: C1 = { r: 9, k: "a" }
const c2: C2 = { r: 5, k: "b" }
print(g(c1))
print(g(c2))

// THE UN-ALIASED CONTROL, in the same module: a member set NO declaration names keeps the
// string slot at both spellings, which is D1110's ruling and is untouched by the adoption.
function px(v: { kind: "p" | "q" }): string { v.kind }
print(px({ kind: "q" }))
