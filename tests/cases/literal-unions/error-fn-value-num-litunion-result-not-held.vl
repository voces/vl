// @error cannot assign () => M to 'g' of type () => f32
// @error cannot assign () => W to 'h' of type () => i32
// A literal-union result widens only to a number holding every literal (D9492): `16777217` has
// no exact `f32`, and `5000000000` no `i32`, as a `return` of each refuses.
type M = 1 | 16777217
type W = 1 | 5000000000
function k(): M { return 1 }
function j(): W { return 1 }
const g: () => f32 = k
const h: () => i32 = j
print(g())
print(h())
