// @run
// @log 9000000000
// @log 1
// @log 9000000000
// @log 1
// @log 1
// @log 9000000000
// @log 9000000000
// @log 1
// @log 9000000000
// @log 1
// @log 9000000000
// An integer literal union whose members span two widths (`9000000000 | 1`) has no one base
// scalar, so it is the `i32 | i64` box in every position: a declared result, a parameter, a
// lambda and a generic pin agree with the binding that always boxed it (D3491).
type D = 9000000000 | 1
const ds: D[] = [1, 9000000000]

function fromList(): D { return ds[1] }
function lit(): D { return 1 }
function wide(): D { return 9000000000 }
function echo(d: D): D { return d }
function show(d: D) { print(d) }
function id<T>(x: T): T { return x }

print(fromList())
print(lit())
print(wide())
const x: D = 1
print(echo(x))
show(1)
show(9000000000)
const l = (d: D): D => d
print(l(9000000000))
print(l(1))
const y: D = 9000000000
print(id(y))
const c = () => x
print(c())
function mk(): D | null { return 9000000000 }
const n = mk()
if n != null { print(n) }
