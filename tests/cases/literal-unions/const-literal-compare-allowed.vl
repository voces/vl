// @log false
// A `const` string-literal compare that can hold is an ordinary test (D2198): the declared
// domains below are the declarations the refusal suggests, a `string` annotation keeps the
// const a plain string (and is not a redundant annotation), and a runtime string, a
// `let`, a member of the other side and an escape spelling of the same value all still compare.
const MODE: "debug" | "release" = "debug"
print(MODE == "release")
print("release" == MODE)
if MODE != "release" { print("debug") }
const A: "x" | "y" = "x"
const B = "y"
print(A == B)
const Bd: "y" | "a" | "b" = "y"
function pick(k: "a" | "b") { k == Bd }
print(pick("a"))
print(MODE is "release")
const S: string = "debug"
print(S == "release")
function runtime(s: string) { s == S }
print(runtime("debug"))
const C = "debug"
print(runtime(C))
let l = C
l = "release"
print(l == "release")
print(C == "debug")
function member(k: "debug" | "trace") { k == C }
print(member("debug"))
print(C is string)
const Q = "\x41"
print(Q == "B")
print(Q == "A")
const JX = "x"
function join(c: boolean) {
  const M: "x" | "y" | "z" = if c { JX } else { B }
  M == "z"
}
print(join(true))
