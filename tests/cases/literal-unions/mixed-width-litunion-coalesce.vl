// @run
// @log 1
// @log 9000000000
// @log 1
// @log 9000000000
// @log 1
// @log 9000000000
// @hint redundant type annotation: `w` is inferred as `D` — remove it to lean on inference
// `y ?? 1` over a nullable literal union of two integer widths is the union itself, so the
// value it yields is the `i32 | i64` box wherever it lands: printed directly, bound without an
// annotation, or bound with one (D3491's review).
type D = 9000000000 | 1
function direct(y: D | null) { print(y ?? 1) }
function unannotated(y: D | null) {
  const w = y ?? 1
  print(w)
}
function annotated(y: D | null) {
  const w: D = y ?? 1
  print(w)
}
direct(null)
direct(9000000000)
unannotated(null)
unannotated(9000000000)
annotated(null)
annotated(9000000000)
