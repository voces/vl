// @run
// The first `.set` or `.push` into an un-annotated container pins its slot to a one-literal
// value's set, and delivers that value at the slot, as a later write does (D16360).
const a: "a" = "a"
const m = Map()
m.set("k", a)
print(m.get("k") ?? "none")
const xs = []
xs.push(a)
xs.push("a")
print(xs[0] + xs[1])
function g(): "b" { return "b" }
const n = Map()
n.set(1, g())
print(n.get(1) ?? "none")
// @log a
// @log aa
// @log b
