// @run
// @log 2000000000000
// @log 5000000001
// @log 0.25
// @log 625000000
// @log 0.25
// A function value whose result is a numeric literal union widens to a number holding each of
// its literals exactly, as a `return` delivers it (D9492): to `i64`, `f64` and `f32`. The
// arithmetic proves each value is converted, not reinterpreted.
type N = 1 | 2
type W = 1 | 2 | 5000000000
const a: N = 2
const f = () => a
const w: () => i64 = f
print(w() * 1000000000000)
function k(): W { return 5000000000 }
const v: () => i64 = k
print(v() + 1)
const d: () => f64 = f
print(d() / 8)
const dw: () => f64 = k
print(dw() / 8)
const s: () => f32 = f
print(s() / 8)
