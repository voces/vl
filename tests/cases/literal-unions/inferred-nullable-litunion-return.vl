// @run
// @log B
// @log none
// @log D
// @log none
// @log hit
// An inferred `K | null` return — the NICHE sibling of an inferred bare literal-union
// return. Its rep is the same interned i32 ATOM with `-1` standing for null that the
// annotated `: K | null` spelling reaches, and the emitted module is BYTE-IDENTICAL to
// that twin's.
//
// CONTRACT: the un-annotated form must not floor. `boolean | null` and `string | null`
// have carried their inferred niche names since A20; the literal-union niche is the third
// member of that family and had no rung, so the inferred form floored at the checker
// (or, before the bare-litunion rung beside it, reached codegen as a value-union box and
// failed there with "bare null needs a struct-typed context").

type K = "A" | "B" | "C" | "D"

// A fall-through `null` on one path and a member atom on the other.
function pick(k: K, n: i32) {
  if n > 0 { return k }
  return null
}

// The same shape reading its member out of a list.
function pickAt(ks: K[], i: i32) {
  if i < ks.length { return ks[i] }
  return null
}

const hit = pick("B", 1)
if hit != null {
  print(hit) // B
} else {
  print("none")
}

// The null path takes the else arm.
const miss = pick("B", 0)
if miss != null {
  print(miss)
} else {
  print("none") // none
}

const ks: K[] = ["C", "D"]
const at1 = pickAt(ks, 1)
if at1 != null {
  print(at1) // D
} else {
  print("none")
}

const oob = pickAt(ks, 9)
if oob != null {
  print(oob)
} else {
  print("none") // none
}

// The narrowed value compares by member, and is assignable to the bare litunion.
const again = pick("B", 1)
if again != null {
  const k: K = again
  if k == "B" { print("hit") } else { print("miss") }
} // hit
