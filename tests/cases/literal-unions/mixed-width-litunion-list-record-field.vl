// @run
// A record field of a list of integer literals with a member past `i32` is a list of union boxes,
// as the same list is outside a record (D16362).
type W = { f: (9000000000 | 1)[] }
const w: W = { f: [9000000000, 1] }
print(w.f[0])
print(w.f[1])
const e: W = { f: [] }
e.f.push(9000000000)
print(e.f.length)
function g(x: W) { print(x.f[0]) }
g({ f: [1] })
// @log 9000000000
// @log 1
// @log 1
// @log 1
