// @run
// @log 1
// @log 0
// @log 0
// THE THREE CONTROLS for `soundness/numeric-litunion-empty-list-seed.vl`, the pin for
// `const xs: K[] = []` over a numeric literal union `K` — the numeric literal union reps as its
// BASE SCALAR, and `tyAnnRefListKind` has the arm that says so.
//
//   · the same annotation with a NON-empty literal — compiles, runs;
//   · the STRING literal-union spelling with an empty literal — compiles, runs;
//   · a plain `i32[] = []` — compiles, runs.
//
// These stay after the fix rather than folding into it: they are the three neighbours the defect
// was ISOLATED against, so they are what would tell a future change that it has re-broken the
// pair rather than the whole family.
type K = 1 | 2
type S = "a" | "b"

const nonEmpty: K[] = [1]
print(nonEmpty.length)

const strEmpty: S[] = []
print(strEmpty.length)

const i32Empty: i32[] = []
print(i32Empty.length)
