// @run
// @log 1
// @log 0
// @log 0
// THE THREE CONTROLS for `soundness/numeric-litunion-empty-list-seed.vl`, which WAS a
// check-clean invalid-wasm hole on `const xs: K[] = []` with `type K = 1.5 | 2.5` and is now a
// passing pin — the numeric literal union reps as its BASE SCALAR, and `tyAnnRefListKind` grew
// the arm that says so.
//
//   · the same annotation with a NON-empty literal — compiles, runs;
//   · the STRING literal-union spelling with an empty literal — compiles, runs;
//   · a plain `f64[] = []` — compiles, runs.
//
// These stay after the fix rather than folding into it: they are the three neighbours the defect
// was ISOLATED against, so they are what would tell a future change that it has re-broken the
// pair rather than the whole family.
type K = 1.5 | 2.5
type S = "a" | "b"

const nonEmpty: K[] = [1.5]
print(nonEmpty.length)

const strEmpty: S[] = []
print(strEmpty.length)

const f64Empty: f64[] = []
print(f64Empty.length)
