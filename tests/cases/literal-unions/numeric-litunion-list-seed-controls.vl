// @run
// @log 1
// @log 0
// @log 0
// THE THREE CONTROLS for `soundness/xfail-miscompile-numeric-litunion-empty-list-seed.vl`, which
// is a check-clean invalid-wasm hole on `const xs: K[] = []` with `type K = 1.5 | 2.5`.
//
//   · the same annotation with a NON-empty literal — compiles, runs;
//   · the STRING literal-union spelling with an empty literal — compiles, runs;
//   · a plain `f64[] = []` — compiles, runs.
//
// Only the pair breaks: a numeric literal-union element AND an empty literal. All three live here
// in the PASSING corpus so the xfail's argument cannot quietly stop being true — if any control
// starts failing, the defect is wider than that file claims and it has to be rewritten.
type K = 1.5 | 2.5
type S = "a" | "b"

const nonEmpty: K[] = [1.5]
print(nonEmpty.length)

const strEmpty: S[] = []
print(strEmpty.length)

const f64Empty: f64[] = []
print(f64Empty.length)
