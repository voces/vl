// @run
// EVERY ANNOTATION HERE IS LOAD-BEARING and the file carries no `@hint` line because the
// type-informed `redundant type annotation` stream is EMPTY for it: each `const p: <U> | null`
// is what makes the binding the nullable box rather than the bare literal's own type, so
// deleting one changes the rep under test rather than tidying the source.
//
// CONTRACT: `if p is N` over a NULLABLE NUMERIC literal union (`type N = 1 | 2`, and the inline
// `1 | 2 | null`) both TESTS the box and makes the narrowed value USABLE — the then-arm's `p`
// reads as the base scalar the box's payload holds, and the else-arm is reachable with a real
// `null`. Every shape is pinned on BOTH runtime inputs, which is the whole reason this is a LOG
// pin: master's `vl check` reports "no errors" for every cell here, so a build-verdict pin over
// the CHECK stage would have passed on master.
//
// MASTER'S VERDICT ON THIS FILE IS CHECK-CLEAN INVALID WASM. The test was already right and the
// READ was not: master emitted the correct membership ladder (box tag 0, then a per-member
// payload compare) and then pushed the union BOX straight into the i32 consumer —
// `type mismatch: expected i32, found (ref $type)`. The `!= null` spelling of the identical type
// was correct one line away, because its COMPLEMENT narrowing banks the base scalar's own name
// (`i32`) while the `is` narrowing banks the tested SPELLING (`N`, or a bare `1`) — and
// `narrowedValueAtomOf`'s litunion leg is `nameIsLitUnionType`, which is `litKind == "str"` only.
// The numeric arm reached neither leg, so it answered "not narrowed to an atom", i.e. "read the
// box raw". It reads `numLitUnionBaseName` — the single home for "a numeric litunion reps as
// this base scalar" — off the arena TYPE the same push banked.
//
// CONTROLS THAT MUST NOT MOVE, and they are byte-identical across the fix: the STRING litunion's
// `is` under `| null` (a different rep — an interned atom with a `-1` null sentinel), and
// `p != null` over the numeric type.
//
// Every cell seeds its value from a LITERAL rather than from a param, because the `is`-at-a-PARAM
// position is a separate axis with a different master verdict (a LOUD reject) and lives in
// `is-nullable-numeric-litunion-is-at-param.vl`.

type N = 1 | 2

// ── a local `const`, alias spelling, both inputs ───────────────────────────────
// @log 1
// @log none
function localPresent() {
  const p: N | null = 1
  if p is N { print(p) } else { print("none") }
}
function localAbsent() {
  const p: N | null = null
  if p is N { print(p) } else { print("none") }
}
localPresent()
localAbsent()

// ── the INLINE spelling, and the single-literal test `is 1` (the alias unnamed) ─
// @log 2
// @log none
function inlinePresent() {
  const p: 1 | 2 | null = 2
  if p is 2 { print(p) } else { print("none") }
}
function inlineAbsent() {
  const p: 1 | 2 | null = null
  if p is 2 { print(p) } else { print("none") }
}
inlinePresent()
inlineAbsent()

// ── the NEGATED guard: the ELSE arm is the narrowed one ────────────────────────
// @log 1
// @log none
function negatedPresent() {
  const p: N | null = 1
  if !(p is N) { print("none") } else { print(p) }
}
function negatedAbsent() {
  const p: N | null = null
  if !(p is N) { print("none") } else { print(p) }
}
negatedPresent()
negatedAbsent()

// ── a THREE-member set, so the membership ladder is longer than one compare ────
// @log 3
// @log none
type M = 1 | 2 | 3
function threePresent() {
  const p: M | null = 3
  if p is M { print(p) } else { print("none") }
}
function threeAbsent() {
  const p: M | null = null
  if p is M { print(p) } else { print("none") }
}
threePresent()
threeAbsent()

// ── an f64-based litunion: a different base scalar through the same arm ────────
// @log 2.5
// @log none
type W = 1.5 | 2.5
function f64Present() {
  const p: W | null = 2.5
  if p is W { print(p) } else { print("none") }
}
function f64Absent() {
  const p: W | null = null
  if p is W { print(p) } else { print("none") }
}
f64Present()
f64Absent()

// ── a struct FIELD (the narrowing key is the member PATH) ──────────────────────
// @log 1
// @log none
type S = { f: N | null }
function fieldPresent() {
  const s: S = { f: 1 }
  if s.f is N { print(s.f) } else { print("none") }
}
function fieldAbsent() {
  const sn: S = { f: null }
  if sn.f is N { print(sn.f) } else { print("none") }
}
fieldPresent()
fieldAbsent()

// ── a list ELEMENT ────────────────────────────────────────────────────────────
// @log 2
// @log none
function elemPresent() {
  const xs: (N | null)[] = [2]
  const p = xs[0]
  if p is N { print(p) } else { print("none") }
}
function elemAbsent() {
  const xs: (N | null)[] = [null]
  const p = xs[0]
  if p is N { print(p) } else { print("none") }
}
elemPresent()
elemAbsent()

// ── a MAP VALUE: the read of a `{[string]: N}` already types `N | null`, and a
//    missing key supplies the null input ─────────────────────────────────────────
// @log 1
// @log none
function fromMapValue(k: string) {
  const m: {[string]: N} = Map()
  m["k"] = 1
  const p = m[k]
  if p is 1 { print(p) } else { print("none") }
}
fromMapValue("k")
fromMapValue("absent")

// ── a module GLOBAL ───────────────────────────────────────────────────────────
// @log 2
const g: N | null = 2
if g is N { print(g) } else { print("none") }
// @log none
const gn: N | null = null
if gn is N { print(gn) } else { print("none") }

// ── CONTROL: the STRING litunion's `is` under `| null` is the atom niche ───────
// @log a
// @log none
type K = "a" | "b"
function strPresent() {
  const p: K | null = "a"
  if p is K { print(p) } else { print("none") }
}
function strAbsent() {
  const p: K | null = null
  if p is K { print(p) } else { print("none") }
}
strPresent()
strAbsent()

// ── CONTROL: `!= null` over the same numeric type ─────────────────────────────
// @log 1
// @log none
function nePresent() {
  const p: N | null = 1
  if p != null { print(p) } else { print("none") }
}
function neAbsent() {
  const p: N | null = null
  if p != null { print(p) } else { print("none") }
}
nePresent()
neAbsent()
