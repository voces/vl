// @run
// @log x-only x
// @log out x
// @log false
// @log y-only y
// @log y
// @log true
// @log in y
// @log true
// @log x-only x
// @log t3 x
// @log y-only y
// @log t3 y
// @log true
// @log debug-only debug
// @log b=debug
// @log true
// @log debug-only debug
// @log debug-only debug
// @log then x
// @log else y
// @log else x
// @log yw y
// @log in y
// @log false
// @log yw w
// @log in w
// @log true
// @log 8
// @log rest x
// @log yw w
// @log null
// @log nf x
// @log yw y
// @log yw w
// @log neg x
// @log else x
// @log then y
// @log 2
// @log s
// @log y
// @log y
// An `is` against a literal set that OVERLAPS the operand's literal type is allowed, declared
// or inferred, and the then-branch narrows to the overlap while the else-branch keeps the rest
// (D2205). Each branch proves its narrowing by passing the value where only the overlap, or only
// the remainder, is accepted, and reads it by print, compare and interpolation.
function onlyY(k: "y") { print("y-only " + k) }
function onlyX(k: "x") { print("x-only " + k) }
function onlyDebug(k: "debug") { print("debug-only " + k) }
type YW = "y" | "w"
function onlyYW(k: YW) { print("yw " + k) }

// A declared alias operand tested with an inline set: the atom rep.
type M = "x" | "y"
function alias(m: M) {
  if m is "y" | "z" {
    onlyY(m)
    print(m)
    print(m == "y")
    print("in \{m}")
  } else {
    onlyX(m)
    print("out \{m}")
  }
  print(m is "y" | "z")
}
alias("x")
alias("y")

// An inline operand type, and an aliased test type that overlaps or contains it.
type T2 = "y" | "z"
type T3 = "x" | "y" | "z"
function inline(m: "x" | "y") {
  if m is T2 { onlyY(m) } else { onlyX(m) }
  if m is T3 { print("t3 \{m}") }
}
inline("x")
inline("y")

// A declared single-literal const, at module and function scope (D2205's witness).
const B: "debug" = "debug"
print(B is "debug" | "x")
if B is "debug" | "x" {
  onlyDebug(B)
  print("b=\{B}")
}
type Mode = "debug" | "x"
print(B is Mode)
function local() {
  const L: "debug" = "debug"
  if L is Mode { onlyDebug(L) }
}
local()

// The inferred spellings narrow to the overlap too: the string rep.
const MODE = "debug"
if MODE is "debug" | "x" { onlyDebug(MODE) }
const A = "x"
const C = "y"
function join(c: boolean) {
  const J = if c { A } else { C }
  if J is "x" | "z" { print("then " + J) } else { print("else " + J) }
}
join(true)
join(false)

// A union mixing literals with a non-literal member, and a two-member overlap.
function mixed(m: "x" | "y" | "w" | i32) {
  if m is "y" | "w" | "z" {
    onlyYW(m)
    print("in \{m}")
    print(m == "w")
  } else if m is i32 {
    print(m + 1)
  } else {
    print("else \{m}")
  }
}
mixed("x")
mixed("y")
mixed("w")
mixed(7)

// A nullable operand: `null` is in neither branch's overlap, so it lands in the else.
type MW = "x" | "y" | "w"
function nullable(m: MW | null) {
  if m is "y" | "w" | "z" { onlyYW(m) }
  else if m != null { print("rest " + m) }
  else { print("null") }
}
nullable("x")
nullable("w")
nullable(null)

// A struct field is narrowed by the same rule.
type S = { m: MW }
function field(s: S) {
  if s.m is "y" | "w" | "z" { onlyYW(s.m) } else { print("nf \{s.m}") }
}
field({ m: "x" })
field({ m: "y" })
field({ m: "w" })

// Negated, and inside a generic function's body.
function neg(m: M) {
  if !(m is "y" | "z") { print("neg " + m) }
}
neg("x")
neg("y")
function gen<Q>(m: M, q: Q) {
  if m is "y" | "z" { print("then " + m) } else { print("else " + m) }
  q
}
const g1 = gen("x", 1)
const g2 = gen("y", "s")
print(g1 + 1)
print(g2)

// An overlap that is the operand's whole set leaves it at its own type, so a closure that
// captures it reads the same rep the operand has.
function whole(m: "x" | "y") {
  if m is "x" | "y" | "z" {
    const c = () => m
    print(c())
  }
  if m is M | "z" {
    const d = () => m
    print(d())
  }
}
whole("y")
