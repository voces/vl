// @run
// @log none
// @log none
// CONTRACT: a FLOAT-literal TYPE mentions f64, so a program whose emitted body reaches an f64
// `print` gets the `__print_f64__` import even when no float VALUE is spelled anywhere.
//
// `repTyScalarMask`'s `TyLit` arm used to descend nowhere, on the argument that "a wide-int/float
// literal type's inhabitants must be SPELLED as that literal in source, so `scanPrintUse`'s own
// `NumLit` / `numTextIsFloat` arm has already claimed the import". That is false for the one
// inhabitant of `W | null` that is NOT a member: `null`. With `null` the only value in the file,
// the import scan saw no float, `gImports` stayed at 4, and the narrowed `print(p)` — an f64 out
// of the box's value box — called import index 4, which the import section never declared:
// `vl check` rc 0, `type mismatch: expected i32, found f64`. The arm now descends through
// `litBaseTy`, the single home for a literal's base scalar.
//
// NOT ONE FLOAT LITERAL APPEARS IN A VALUE POSITION, AND THAT IS THE PIN. The scan is MODULE-wide,
// so a single `takes(2.5)` anywhere in this file would claim the import by the old route and the
// file would pass on master — which is exactly what hid the hole. Both branches are still
// EMITTED: the then-arm's f64 `print` is compiled whether or not the run reaches it, so the
// import must exist even though every call here takes the else-arm.
//
// The mask's failure direction is asymmetric and unchanged: an EXTRA `__print_*__` import is a
// harmless unused entry, a MISSED one is invalid wasm.

type W = 1.5 | 2.5

// the PARAM position
function takes(p: W | null) {
  if p is W { print(p) } else { print("none") }
}
takes(null)

// the local position, so the pin does not depend on the param classifier
function fromLocal() {
  const p: W | null = null
  if p is W { print(p) } else { print("none") }
}
fromLocal()
