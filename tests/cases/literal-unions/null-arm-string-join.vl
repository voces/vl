// @run
// @log a
// @log null
// @log z
// @log a
// @log null
// @log z
// A join of a literal-union atom, `null` and a string is `string | null`, not the atom's
// `K | null` niche, so the string arm keeps its text.
type K = "a" | "b"
function g(a0: K, k: i32) {
  print(
    match k {
      0 => a0
      1 => null
      _ => "z"
    },
  )
}
function h(a0: K, k: i32) {
  const v = if k == 0 { a0 } else if k == 1 { null } else { "z" }
  print(v)
}
g("a", 0)
g("a", 1)
g("a", 2)
h("a", 0)
h("a", 1)
h("a", 2)
