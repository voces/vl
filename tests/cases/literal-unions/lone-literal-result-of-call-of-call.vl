// @run
// @hint redundant type annotation: `t` is inferred as `"a"`
// @log a
// @log a
// @log ax
// @log 1
// @log a
// @log a
// @log ax
// @log 1
// @log a
// @log z
// @log a
// @log a
// @log true

// A call whose function type returns one string literal yields the string, whether the
// function comes from a call or from a field (D8001).
function g(): "a" { return "a" }
function wrap(): () => "a" { return g }
print(wrap()())
const s = wrap()()
print(s)
print(wrap()() + "x")
print(wrap()().length)
const t: "a" = wrap()()
print(t)

type R = { f: () => "a" }
const r: R = { f: g }
print(r.f())
print(r.f() + "x")
print(r.f().length)
const u = r.f()
print(u)
const q = { f: () => "z" }
print(q.f())

function show(fn: () => "a") { print(fn()) }
show(wrap())
const fs = [wrap()]
print(fs[0]())
print(wrap()() == "a")
