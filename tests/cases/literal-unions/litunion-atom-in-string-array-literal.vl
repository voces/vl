// @run
// @log plain
// @log kb
// @log ka
// @log zz
// @log 2
// @log 3
// @log kb
// @log null-ok
// A literal-union ATOM as an element of a STRING-ARRAY LITERAL. The backing is
// `(ref null $aTypeIdx)` and the atom's rep is an i32 id, so the element has to widen to its
// member string on the way in. It did not: `expected (ref null $type), found i32`, check-clean
// invalid wasm.
//
// THE ELEMENT ORDER DECIDES WHICH DEFECT YOU GET, and only one of the two is fixed here. That
// is the whole reason this file exists in this shape rather than as a single `[v]` arm:
//
//   const ys = ["plain", v]   // a STRING list is built (the first element decides)
//                                       // and the atom element did not widen — FIXED HERE
//   const ys: string[] = [v]            // an ATOM list is built and the `string[]` annotation
//   const ys: string[] = [v, "plain"]   // is IGNORED — a different defect, still open, pinned
//                                       // as xfail-miscompile-atom-first-arraylit-ignores-
//                                       // annotation.vl
//
// `arrLitIsStr` declines for an atom-FIRST literal because the checker adopted a `K[]` context
// onto it (`nodeArrayElemIsLitUnion`), which is a context-propagation problem and not a missing
// widen. The two share a symptom — an atom and a string list that do not fit — and have
// different causes, so they are two files.
//
// THE RESERVATION TWIN IS THE `isolated` ARM, and it fails differently. `emitAtomToStr` stages
// the atom id in the string-op scratch frame, and `exprHasStrOp`'s ArrayLit arm only recursed
// ITSELF — it never asked whether an element was an atom — so a function whose ONLY string work
// is such a literal allocated no frame and the widen wrote to a local the vector never declared
// (`unknown local 5`). `isolated` returns `ys.length` and never prints the strings, because a
// `print` of the result would reserve the frame incidentally and hide exactly this.
//
// THE `(string | null)[]` ARM pins that a `null` element and an atom element share one literal:
// the null lowers as `ref.null` under the `pendingNulString` seed while the atom widens.
//
// THE CONTROLS ARE THE TWO NEIGHBOURS THAT ALREADY WORKED: an atom literal into a `K[]`
// annotation (correct — that IS the atom list) and `ys.push(v)` into a `string[]` (fixed
// earlier, in the push sink). Between them they say the defect is the array LITERAL's element
// position specifically, not "atoms and string lists".
type K = "ka" | "kb"

function main() {
  const v: K = "kb"
  const ys = ["plain", v]
  print(ys[0])
  print(ys[1])

  // Control 1: the atom list, correctly built and read.
  const ks: K[] = [v, "ka"]
  print(ks[1])

  // Control 2: the push sink, closed earlier — same value, same destination type, different
  // position.
  const zs: string[] = []
  zs.push("zz")
  print(zs[0])

  print(isolated("kb"))

  const ns = ["a", null, v]
  print(ns.length)
  if ns[2] != null { print(ns[2]) }
  if ns[1] == null { print("null-ok") }
}

// The RESERVATION witness: its only string work is the literal's atom widen.
function isolated(v: K) {
  const ys = ["plain", v]
  return ys.length
}
main()
