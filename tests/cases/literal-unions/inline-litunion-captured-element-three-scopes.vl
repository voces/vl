// @run
// @log green
// @log 1
// @log red
// @log green
// @log 1
// @log green
// @log green
// @log green
// @log green
// @hint redundant type annotation: `v` is inferred as `"red" | "green"` — remove it to lean on inference
// @hint redundant type annotation: `v2` is inferred as `"red" | "green"` — remove it to lean on inference
// @hint redundant type annotation: `b` is inferred as `"red" | "green"` — remove it to lean on inference
// @hint redundant type annotation: `f` is inferred as `"red" | "green"` — remove it to lean on inference
// @hint redundant type annotation: `p` is inferred as `"red" | "green"` — remove it to lean on inference
// A captured value is a third end of the inline-litunion seam, after the cell and the direct
// read: the env field is sized by the annotation, which softens an inline member set to
// `string`, while a litunion array element arrives as the interned atom. The capture is the
// ingredient at every scope — module, block and function body alike. D1768.
//
// Both halves are pinned here. The cell alone turns the block faces' invalid wasm into the
// printed atom id, so the reader's closure-call rung has to land with it: `print(g())` reading
// `0` and `g() == "green"` refusing at load are the same defect at two consumers.
//
// NO `type` DECLARATION MAY BE ADDED TO THIS FILE. An alias whose member set is exactly the
// inline spelling's makes the annotation resolve to the alias's own arena index, both ends
// agree again, and the fixture stops pinning anything.
const srcArr: ("red" | "green")[] = ["green", "red"]

// Plain module scope, where the binding is a global and the capture still decides the rep.
const v: "red" | "green" = srcArr[0]
const g = () => v
print(g())
if g() == "green" { print(1) } else { print(2) }

// The second element, so a green cell cannot be the atom id happening to read 0.
const v2: "red" | "green" = srcArr[1]
const g2 = () => v2
print(g2())

// A module block: the same binding where the frame-taking rung has no frame to take.
if true {
  const b: "red" | "green" = srcArr[0]
  const gb = () => b
  print(gb())
  if gb() == "green" { print(1) } else { print(2) }
}

// A function body, annotated and un-annotated: an annotation pins the cell, so the face that
// leans on inference has to be graded too.
function inFn() {
  const f: "red" | "green" = srcArr[0]
  const gf = () => f
  print(gf())
  const u = srcArr[0]
  const gu = () => u
  print(gu())
}
inFn()

// The control the reader must keep excluding: a named call to an inline-litunion-returning
// function reps as a string ref, at the capture and at the direct read alike.
function pick(): "red" | "green" { return "green" }
const p: "red" | "green" = pick()
const gp = () => p
print(gp())
print(pick())
