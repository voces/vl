// @run
// @log b
// @log 5
// @log a
// @log 5
// @log b
// @log b
// @log 9
// @log b
// @log 9
// @log b
// @log a
// @log b
// @log a
// @log b
// @log a

// An un-annotated copy of an `i32 | AB | null` box under a `!= null` or `!(is null)` guard
// reads at that set less `null`, so its `is i32` else is the `AB` arm: printed, passed, bound
// at an annotation, returned and delivered from a value `if`, beside the annotated copy (D8180).
type AB = "a" | "b"
function g(x: AB) { print(x) }

function pr(r: i32 | AB | null) {
  if r != null {
    const v = r
    if v is i32 { print(v + 1) } else { print(v) }
  }
}
pr("b")
pr(4)
pr(null)

function prLet(r: i32 | AB | null) {
  if !(r is null) {
    let v = r
    if v is i32 { print(v + 1) } else { print(v) }
  }
}
prLet("a")
prLet(4)

function pass(r: i32 | AB | null) {
  if r != null {
    const v = r
    if v is i32 { print(v) } else { g(v) }
  }
}
pass("b")

function bind(r: i32 | AB | null) {
  if r != null {
    const v = r
    if v is i32 {
      print(v)
    } else {
      const w: AB = v
      print(w)
    }
  }
}
bind("b")
bind(9)

function ann(r: i32 | AB | null) {
  if r != null {
    const v: i32 | AB = r
    if v is i32 { print(v) } else { g(v) }
  }
}
ann("b")
ann(9)

function back(r: i32 | AB | null): AB {
  if r != null {
    const v = r
    if v is i32 { return "a" } else { return v }
  }
  return "b"
}
print(back("b"))
print(back(1))

function viaIf(r: i32 | AB | null) {
  if r != null {
    const v = r
    g(if v is i32 { "a" } else { v })
  }
}
viaIf("b")
viaIf(2)

const top: i32 | AB | null = "b"
if top != null {
  const v = top
  if v is i32 { print(0) } else { print(v) }
}
const top2: i32 | AB | null = "a"
if top2 != null {
  const v = top2
  if v is i32 { print(0) } else { print(v) }
}
