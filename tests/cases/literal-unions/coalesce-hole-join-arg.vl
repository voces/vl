// @run
// A hole's map read is its value or `null`, so a `??` over it keeps the miss and the boolean at
// both faces, at a call argument and at a binding, and down a chain (D7968).
type R = {
  f: {[i32]: f64},
  fn: {[i32]: f64 | null},
  b: {[i32]: boolean},
  s: {[i32]: string},
}
function show(x) { print(x) }
function mk(): R {
  const f: {[i32]: f64} = Map()
  f[3] = 2.5
  const fn: {[i32]: f64 | null} = Map()
  fn[3] = 4.5
  const b: {[i32]: boolean} = Map()
  b[3] = true
  const s: {[i32]: string} = Map()
  s[3] = "x"
  { f: f, fn: fn, b: b, s: s }
}
function hole(p) {
  show(p.f[3] ?? p.f[4])
  show(p.f[9] ?? p.f[4])
  show(p.b[3] ?? 3)
  show(p.b[9] ?? 3)
  show(p.s[3] ?? p.s[4])
  const r = p.f[9] ?? p.f[4]
  print(r)
  print(p.fn[9] ?? p.fn[8] ?? p.f[3])
  print(p.fn[9] ?? (p.fn[8] ?? p.f[9]))
}
function ann(p: R) {
  show(p.f[3] ?? p.f[4])
  show(p.f[9] ?? p.f[4])
  show(p.b[3] ?? 3)
  show(p.b[9] ?? 3)
  show(p.s[3] ?? p.s[4])
  const r = p.f[9] ?? p.f[4]
  print(r)
  print(p.fn[9] ?? p.fn[8] ?? p.f[3])
  print(p.fn[9] ?? (p.fn[8] ?? p.f[9]))
}
hole(mk())
ann(mk())
// @log 2.5
// @log null
// @log true
// @log 3
// @log x
// @log null
// @log 2.5
// @log null
// @log 2.5
// @log null
// @log true
// @log 3
// @log x
// @log null
// @log 2.5
// @log null
