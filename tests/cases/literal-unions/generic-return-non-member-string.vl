// @run
// @log b
// @log null
// @log z
// @log true
// @log null
// @log 7
// A generic whose returns join its `T`, `null` and a later concrete value infers all three, so a
// `K` instance returns the non-member string `"z"` and a `boolean` instance the `7` (D4173,
// D16944): a later return is not absorbed into `T | null`.
type K = "a" | "b"
function g<T>(c: i32, k: T) {
  return if c == 0 { k } else if c == 1 { null } else { "z" }
}
const k0: K = "b"
print(g(0, k0))
print(g(1, k0))
print(g(2, k0))
function h<T>(a0: T, k: i32) {
  if k == 0 { return a0 }
  if k == 1 { return null }
  return 7
}
print(h(true, 0))
print(h(true, 1))
print(h(true, 2))
