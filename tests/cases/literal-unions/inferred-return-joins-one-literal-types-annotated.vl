// @run
// @log green
// @log red
// @log true
// @log red
// @hint redundant type annotation: `c` is inferred as `"red" | "green"`
// The annotated face of the inferred one-literal join: the same returns delivered into a
// written `"red" | "green"`, at an argument and a declared return, agree with the inferred
// spelling (D5521).
const G: "green" = "green"
const R: "red" = "red"

function d(n: i32) { if n > 1 { R } else { G } }
function spelled(n: i32): "red" | "green" { if n > 1 { R } else { G } }
function show(c: "red" | "green") { print(c) }

show(d(0))
show(spelled(2))
print(spelled(2) == d(2))
const c: "red" | "green" = d(2)
print(c)
