// @run
// @log 1
// @log 2
// @log 1
// @log true
// @log 1
// @log 1
// @log 2
// @log 1
// @log 1
// CONTRACT (must-RUN): a NUMERIC literal union behind a type ALIAS is plain `i32` at emit,
// at every read position. On the parent commit every cell below built a module that FAILED
// TO PARSE AS WEBASSEMBLY with `vl check` clean — `global.get` of a `(ref $box)` handed to
// `__print_i32__` — because the alias NAME reached the emitter unchanged, `collectU` had
// registered it in `unNames` (a `UnionDecl` whose single variant is not a `{…}` shape is
// not skipped), and `isUName` then claimed the annotation for the `{tag, value}` UNION BOX
// while every READ lowered as the i32 the checker's own algebra says it is.
//
// Not a `print` bug: `z + 1` and `toString(z)` failed identically, and `z == 1` named the
// mis-classification itself — "`==` over a struct union is not supported yet".
//
// The INLINE spelling (`const z: 0 | 1 = 1`) always worked, because `canonEmitName`'s union
// arm softens each numeric member to `i32` through `litBaseName` and dedups; the alias name
// has no top-level `|` in it, so `nameNeedsCanon` returned it untouched. `canonEmitName`
// now resolves such an alias to the SAME base scalar, via `softenLitTy` — the checker's own
// "a numeric-literal union is its base type for arithmetic" rule, not a second answer.
//
// The STRING sibling (`type K = "a" | "b"`) is deliberately NOT softened and is pinned in
// `literal-unions/` beside this: there the alias name IS the interned-atom identity.
// MEMBERSHIP is unaffected — `soundness/numeric-litunion-alias-membership.vl` pins that a
// non-member is still a type error in every position.
type Z = 0 | 1
type Y = Z
type S = { z: Z }
type T = 0 | 1 | 2

// 1. a module-scope binding, printed
const z: Z = 1
print(z)

// 2. arithmetic over it (the union constrains assignment, not computation)
print(z + 1)

// 3. widened to a string
print(toString(z))

// 4. compared to a member literal
print(z == 1)

// 5. a function-local binding
function inFn() {
  const l: Z = 1
  print(l)
}
inFn()

// 6. a struct FIELD
const s: S = { z: 1 }
print(s.z)

// 7. a THREE-member alias
const t: T = 2
print(t)

// 8. an ARRAY element
const a: Z[] = [1, 0]
print(a[0])

// 9. an alias OF the alias (the one-member `UnionDecl` wrapper the parser mints)
const y: Y = 1
print(y)
