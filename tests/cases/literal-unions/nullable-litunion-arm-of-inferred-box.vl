// @run
// @log b
// @log b
// @log a
// @log b
// @log b
// @log 0
// @log a
// @log b
// @log b
// @log 0

// The `K | null` arm an `is i32` test leaves of an `i32 | K | null` box prints as a member or
// null when the box's type is inferred from the calls of an un-annotated parameter, the members
// named by an alias or spelled inline (D8122, D8123).
type AB = "a" | "b"
function h(x: AB | null) { print(x) }

function take(v) {
  if v is i32 { print(0) } else { print(v) }
}
const r: i32 | AB | null = "b"
take(r)

function give(v) {
  if v is i32 { print(0) } else { h(v) }
}
give(r)

function inl(v) {
  if v is i32 { print(0) } else { print(v) }
}
const s: i32 | "a" | "b" | null = "a"
inl(s)

function early(v) {
  if v is i32 { return }
  print(v)
}
early(r)

function two(v) {
  if v is i32 { print(0) } else { print(v) }
}
two(r)
two(7)

function ann(v: i32 | "a" | "b" | null) {
  if v is i32 { print(0) } else { print(v) }
}
ann(s)
ann(r)

function gen<T>(v: T) {
  if v is i32 { print(0) } else { print(v) }
}
gen(r)
gen(7)
