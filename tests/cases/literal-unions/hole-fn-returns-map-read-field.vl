// A hole function returning a map read off its parameter's field returns the value or `null` at
// each call, whatever the map's value type, and builds a valid module (D7881).
type R = { m: {[string]: i32} }
type Q = { m: {[string]: string} }

function pick1(p) { return p.m["q"] }
function pick2(p) { return p.m["z"] }

const m: {[string]: i32} = Map()
m["q"] = 7
const r: R = { m: m }
const n: {[string]: string} = Map()
const q: Q = { m: n }
print(pick1(r))
print(pick1(q))
print(pick1(q) == null)
print(pick2(r))
print(pick2(r) == null)
// @log 7
// @log null
// @log true
// @log null
// @log true
