// @run
// @log ab
// @log 1
// @log a
// @log a
// CONTRACT (must-RUN): the NEGATIVE control for the print gate's literal softening. Every
// union here has literal members, and every one of them softens to a SINGLE base scalar, so
// none is a boxed value union and all of them print.
//
// This is the pin that keeps the fix from over-rejecting: a gate that softened a literal to
// its base WITHOUT the dedup would count `"ab" | "cd"` as two `string` atoms and reject all
// four — which is why the dedup is part of the gate, not a nicety. It mirrors
// `canonEmitName`, which collapses duplicate softened members before deciding.
//
// A literal beside its OWN base is covered in BOTH orders (`c`, `d`): the dedup has to
// notice the collision whichever side the literal falls on.
//
// NOT covered here, deliberately: `"a" | "b" | null`. That is the `K | null` NICHE, which
// this gate correctly declines to call a box — and printing one is separately broken on
// master (a global emits invalid wasm, a local/param silently prints nothing). Pinning it
// green here would pin a defect.
const a: "ab" | "cd" = "ab"
print(a)
const b: 1 | 2 = 1
print(b)
const c: "a" | string = "a"
print(c)
const d: string | "a" = "a"
print(d)
