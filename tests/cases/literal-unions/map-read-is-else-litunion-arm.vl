// @run
// @log b
// @log b
// @log null
// @log 2
// @log y
// @log y
// @log null
// @log b
// @log null
// @log b

// The else of `m[k] is i32` over a null-free `i32 | K` map is `K | null`, the `null` a missing
// key's, with the members named by an alias or spelled inline (D8121).
type AB = "a" | "b"
function h(x: AB | null) { print(x) }

const m: { [string]: i32 | AB } = Map()
m["k"] = "b"
m["n"] = 2
if m["k"] is i32 { print(0) } else { print(m["k"]) }
if m["k"] is i32 { print(0) } else { h(m["k"]) }
if m["z"] is i32 { print(0) } else { print(m["z"]) }
if m["n"] is i32 { print(m["n"]) } else { print(m["n"]) }

const n: { [string]: i32 | "x" | "y" } = Map()
n["k"] = "y"
if n["k"] is i32 { print(0) } else { print(n["k"]) }
if !(n["k"] is i32) { print(n["k"]) }
if n["q"] is i32 { print(0) } else { print(n["q"]) }

function f(p: { [string]: i32 | AB }) {
  if p["k"] is AB { print(p["k"]) } else { print(p["k"]) }
  if p["q"] is i32 { print(0) } else { print(p["q"]) }
}
f(m)

const u = Map()
u["k"] = r()
function r(): i32 | AB { return "b" }
if u["k"] is i32 { print(0) } else { print(u["k"]) }
