// @run
// @log ka
// @log ka
// @log kc
// @log ka
// @log kc
// @hint redundant type annotation: `f` is inferred as `(N) => string` — remove it to lean on inference
// @hint redundant type annotation: `h` is inferred as `(N) => string` — remove it to lean on inference
// A NARROWED literal-union parameter (`K & !"kb"`) reached through a FUNCTION VALUE. This was
// `soundness/xfail-miscompile-narrowed-litunion-fn-value-arg.vl`.
//
// The callee's param is the interned i32 atom, and the `$fnsig` the value call resolved once said
// `string`: a `call_indirect` at a `(structref, stringref)` functype pushing the atom id, which
// the engine refuses at load. Two producers key that signature: the arena one (`sigKeyOfTy`) and
// the name one (`annParamKind`, from the rendered spelling `"ka" | "kc"`). Since the ruling
// `one-literal-union-rep` both answer i32 for every string literal union, aliased, narrowed or
// inline, so they agree by construction.
//
// The `@hint`s are load-bearing: an un-annotated `const f = takesN` resolves the callee's own
// signature instead of building one from the annotation, which is the channel this file covers.
type K = "ka" | "kb" | "kc"
type N = K & !"kb"

function takesN(v: N): string { v }

function use(g: (N) => string) { print(g("ka")) }

function main() {
  // (1) the headline cell: an annotated LOCAL binding over a named callee
  const f: (N) => string = takesN
  print(f("ka"))
  // (2) the same value reached through a higher-order PARAM
  use(f)
  // (3) the other member of the narrowed set, so the atom id is not the winner by accident
  print(f("kc"))
}

main()

// (4) the MODULE-SCOPE binding, where the name producer claims the call before the arena
// fallback is reached.
const h: (N) => string = takesN
print(h("ka"))
print(h("kc"))
