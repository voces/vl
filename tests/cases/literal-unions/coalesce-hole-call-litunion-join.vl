// @run
// @log 5000000000
// @log 2
// @log 5000000000
// @log 5000000000
// @log 5000000001
// @log 3
// @log 1
// @log 3
// @log 1
// @log 6000000001
// @log 1
// @log 5000000001
// @log 2
// @log 7
// @log 2.5
// @log 2
// @log 0.5
// @log 0.625
// @log 2.25
// @log 1
// @log 6000000000
// @log 3
// @log 2
// @log 4
// @log 5000000000
// @log 4
// @log 3
// @log y
// @log 42
// @log 2.5
// @log 2
// `??` over the call of an un-annotated parameter bound at a function returning a numeric
// literal union: the default joins the union's base, an `i64` member included, an `f64`
// default converts the operand, and a null instance tests the box (D9561, D9562, D9564, D9700).
type N = 1 | 2
type L = 5000000000 | 6000000000
type W = 1 | 2 | 5000000000
const wa: W = 5000000000
const wb: W = 2
const na: N = 2
const nz: N | null = null
const nd: N | null = 2
const lz: L | null = null
const ln: L | null = 6000000000
const wz: W | null = null
const wn: W | null = 5000000000

// A mixed-width union under an `i32` default: printed, returned, listed and added to.
function orZero(f) { print(f() ?? 0) }
orZero(() => wa)
orZero(() => wb)
function orZeroR(f) {
  const r = f() ?? 0
  return r
}
print(orZeroR(() => wa))
function orSevenL(f) {
  const xs = [f() ?? 7]
  print(xs[0])
}
orSevenL(() => wa)
function plusOne(f) { print((f() ?? 0) + 1) }
plusOne(() => wa)
plusOne(() => wb)
plusOne(() => nz)
plusOne(() => nd)
plusOne(() => lz)
plusOne(() => ln)
plusOne(() => wz)
plusOne(() => wn)

// An `f64` default over an `i32` union, at a non-null and a null instance.
function orHalf(f) { print(f() ?? 2.5) }
orHalf(() => na)
orHalf(() => 7)
orHalf(() => nz)
orHalf(() => nd)
function quarter(f) { print((f() ?? 2.5) / 4.0) }
quarter(() => na)
quarter(() => nz)
function orHalfR(f) { return f() ?? 0.5 }
print(orHalfR(() => na) + 0.25)
function orHalfL(f) {
  const xs: f64[] = []
  xs.push(f() ?? 1.5)
  print(xs[0] / 2.0)
}
orHalfL(() => na)

// A null box under an `i32` default, returned and listed.
function orThree(f) { return f() ?? 3 }
print(orThree(() => ln))
print(orThree(() => lz))
print(orThree(() => nd))
function orFourL(f) {
  const xs = [f() ?? 4]
  print(xs[0])
}
orFourL(() => wz)
orFourL(() => wn)
orFourL(() => nz)

// A default of another type over an instance that cannot be null.
function orQ(f) { print(f() ?? "q") }
orQ(() => 3)
orQ(() => "y")
function orQB(f) {
  const v = f() ?? "q"
  if v is i32 { print(v + 1) } else { print(v) }
}
orQB(() => 41)

// The annotated control.
function orHalfA(f: () => N | null) { print(f() ?? 2.5) }
orHalfA(() => nz)
orHalfA(() => nd)
