// @run
// @log circle
// @log circle
// @log circle
// @log circle
// @log hcircle
// @log ccircle!
// @log circle
// @log circle
// @log true
// @log a
// @log a
// @log a
// @log a
// @log ha
// @log ca!
// @log a
// @log a
// @log true
// @log 1
// An atom field read as its literal's string, off a plain record and off a union member, in each
// position: the read leaves the atom and its consumer decodes it.
type H = { k: "circle", n: i32 }
type A = { kind: "a", x: i32 }
type B = { kind: "b" | "c", x: i32 }
type U = A | B
function sink(s: string) { print(s) }
function id<T>(x: T): T { return x }
function retH(h: H): string { return h.k }
function argH(h: H) { sink(h.k) }
function genH(h: H) { print(id(h.k)) }
function printH(h: H) { print(h.k) }
function holeH(h: H) { print("h\{h.k}") }
function catH(h: H) { print("c" + h.k + "!") }
function mapH(h: H) {
  const m: { [string]: string } = Map()
  m["k"] = h.k
  print(m["k"] ?? "none")
}
function pushH(h: H) {
  const xs: string[] = []
  xs.push(h.k)
  print(xs[0])
}
function eqH(h: H) { print(h.k == "circle") }
function retA(a: A): string { return a.kind }
function argA(a: A) { sink(a.kind) }
function genA(a: A) { print(id(a.kind)) }
function printA(a: A) { print(a.kind) }
function holeA(a: A) { print("h\{a.kind}") }
function catA(a: A) { print("c" + a.kind + "!") }
function mapA(a: A) {
  const m: { [string]: string } = Map()
  m["k"] = a.kind
  print(m["k"] ?? "none")
}
function pushA(a: A) {
  const xs: string[] = []
  xs.push(a.kind)
  print(xs[0])
}
function eqA(a: A) { print(a.kind == "a") }
const h: H = { k: "circle", n: 1 }
const a: A = { kind: "a", x: 1 }
const u: U = a
print(retH(h))
argH(h)
genH(h)
printH(h)
holeH(h)
catH(h)
mapH(h)
pushH(h)
eqH(h)
print(retA(a))
argA(a)
genA(a)
printA(a)
holeA(a)
catA(a)
mapA(a)
pushA(a)
eqA(a)
print(u.x)
