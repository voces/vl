// @run
// @log a
// @log b
// @log 5
// @log b
// @log 2.5
// @log b
// @log true
// @log b
// @log 5
// @log k
// @log true
// @log b
// @log o
// @log false
// @log 5
// A literal-union value joined with a scalar is the union of the literals and the scalar, and
// an un-annotated join, binding, return and list literal box it as the annotated spelling
// does: the literal prints as its text, not its atom id (D2952).
type K = "a" | "b"
function ret(a: K, c: boolean) {
  const r = if c { a } else { 5 }
  r
}
const ka: K = "a"
print(ret(ka, true))
function direct(a: K, c: boolean) { print(if c { a } else { 5 }) }
direct("b", true)
direct("b", false)
function early(a: K, c: boolean) {
  if c { return a }
  2.5
}
print(early("b", true))
print(early("b", false))
function lists(a: K, c: boolean) {
  const xs = [a, true]
  print(xs[0])
  print(xs[1])
  const ys = [if c { a } else { 5 }, 5]
  print(ys[0])
  print(ys[1])
}
lists("b", true)
function tests(a: K, c: boolean) {
  const r = if c { a } else { 5 }
  if r is K { print("k") } else { print("o") }
  print(r == "b")
  const f = () => r
  print(f())
}
tests("b", true)
tests("b", false)
