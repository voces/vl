// @run
// @log a
// @log null
// @log true
// @log n
// @log c
// @log none
// @log d
// @log b
// @log q!
// @log q
// @log a
// A function whose result is a nullable literal union, `"a" | "b" | null` spelled inline or
// as `K | null`, returns the atom niche from a contextual lambda, and its result prints,
// compares, coalesces to a non-member, narrows and widens to `string | null` (D3198).
type K = "a" | "b"
const g: () => "a" | "b" | null = () => "a"
const h: () => "a" | "b" | null = () => null
print(g())
print(h())
print(g() == "a")
print(h() ?? "n")
const fs: (() => "a" | "b" | "c" | "d" | null)[] = [() => "c"]
print(fs[0]() ?? "n")
const x = h()
if x != null { print(x) } else { print("none") }
function wide(f: () => "c" | "d" | null): string | null { return f() }
const kd: () => "c" | "d" | null = () => "d"
print(wide(kd) ?? "n")
type R = { v: i32, f: () => K | null }
const r: R = { v: 1, f: () => "b" }
print(r.f())
const s = h() ?? "q"
print(s + "!")
print(s)
function mk(): () => "a" | "b" | null { return () => "a" }
print(mk()())
