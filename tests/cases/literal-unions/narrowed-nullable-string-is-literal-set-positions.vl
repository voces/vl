// @run
// @log p:A
// @log p:-
// @log p:-
// @log e:A
// @log e:-
// @log l:A
// @log l:-
// @log b:qa
// @log t:qa
// A `string | null` narrowed non-null, tested against a set of string literals: the receiver
// recovered once and compared member by member; and, narrowed to the set, read where a string or
// the set is wanted. A parameter tested beside its null test, after an early return, a local, and
// a bound and passed read.
type QA = "qa" | "qb"
function takesQa(q: QA) { print("t:" + q) }
function param(u: string | null) {
  if u != null && u is QA { print("p:A") } else { print("p:-") }
}
function early(u: string | null) {
  if u == null { return 0 }
  if u is QA { print("e:A") } else { print("e:-") }
  return 0
}
function local(k: i32) {
  const u: string | null = if k == 0 { "qb" } else if k == 1 { "zz" } else { null }
  if u != null {
    if u is QA { print("l:A") } else { print("l:-") }
  }
}
function bound(u: string | null) {
  if u == null { return 0 }
  if u is QA {
    const q: QA = u
    print("b:" + q)
    takesQa(u)
  }
  return 0
}
param("qa")
param("zz")
param(null)
early("qb")
early("x")
early(null)
local(0)
local(1)
local(2)
bound("qa")
bound(null)
