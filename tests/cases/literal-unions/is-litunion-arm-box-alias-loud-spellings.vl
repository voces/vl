// @run
// CONTRACT: the two `is` spellings over an ALIAS-named box carrying a literal-union arm that
// failed LOUDLY rather than silently — a bare member LITERAL through the alias, and a NUMERIC
// litunion arm under one. Both run, and both answer correctly at a matching and a
// non-matching value.
//
// SPLIT OUT OF `is-litunion-arm-box-alias-spelling.vl` ON PURPOSE. That file pins the SILENT
// wrong answer of the same family and has to redden on a log mismatch; a hard emit failure
// anywhere in it would be reported first and mask the mismatch entirely, so the cells that
// used to abort the build live here instead.
//
// Both are the same root cause as the silent sibling — a predicate deciding on the union
// SPELLING it is handed, which splits a declared alias to one atom:
//   · `u is "a"` over `type W = K | i32` reached `emitUnionLitIs`, whose own gate and whose
//     arm-membership test both read the name: no arm could hold a quoted literal, so the
//     compare was refused with ``literal `is` over a struct union is not supported`.
//   · `u is N` over `type WN = N | string` (`N` NUMERIC) fell past every arm of the ladder to
//     ``is` names a type that is not a union variant`, because the value-union NAME fallback
//     `isValueUnionName` gave the same one-atom answer. The INLINE `N | string` spelling of
//     the identical box was correct throughout, which is what makes both of these the
//     spelling's fault and not the shape's.

type K = "a" | "b"
type W = K | i32

// ── a bare member LITERAL tested through the alias ─────────────────────────────
// @log lit:Y
// @log lit:N
function viaAliasLit(u: W) {
  if u is "a" { return "lit:Y" }
  return "lit:N"
}
print(viaAliasLit("a"))
print(viaAliasLit("b"))

// the i32 arm answers NO to a string literal
// @log lit:N
print(viaAliasLit(7))

// the INLINE control, correct before and after
// @log ilit:Y
// @log ilit:N
function viaInlineLit(u: K | i32) {
  if u is "a" { return "ilit:Y" }
  return "ilit:N"
}
print(viaInlineLit("a"))
print(viaInlineLit("b"))

// ── a NUMERIC litunion arm under an alias ──────────────────────────────────────
// @log num:Y
// @log num:Y
// @log num:N
type N = 1 | 2
type WN = N | string
function viaAliasNum(u: WN) {
  if u is N { return "num:Y" }
  return "num:N"
}
print(viaAliasNum(1))
print(viaAliasNum(2))
print(viaAliasNum("zz"))

// the INLINE control
// @log inum:Y
// @log inum:N
function viaInlineNum(u: N | string) {
  if u is N { return "inum:Y" }
  return "inum:N"
}
print(viaInlineNum(1))
print(viaInlineNum("zz"))

// ── `==` through the same alias, whose gate reads the same name ─────────────────
// @log eq:Y
// @log eq:N
function eqViaAlias(u: W) {
  if u == "a" { return "eq:Y" }
  return "eq:N"
}
print(eqViaAlias("a"))
print(eqViaAlias("b"))
