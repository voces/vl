// @run
// @log x
// @log x
// @log x
// @log q
// @log r
// @log other
// @log zz,q
// @log q
// @log 2
// @log 2
// @log 2
// @log x
// @log zz
// @log none
// @log zz
// @log zz
// @log 1
// @log zz
// @log zzx
// @log none
// @log 3
// @log zz
// @log 4
// @log qzz
// @warning Unused parameter `i` (prefix with `_` to suppress, or remove it)
// @hint redundant type annotation: `x` is inferred as `{a: i32}`
// A `const` bound to a string literal has the literal's type, and that type widens to `string`
// wherever the value is stored somewhere reassignable (D2157). Each line below stored a join of
// two such constants, or a function returning one, and must keep running as it did when the
// constants were plain `string`: an `if` and a `match` join, a record field and a list element
// built from a join, a function-typed list and binding, a map or set key, and a return that joins
// a constant with `null`, a number, a boolean or a record, in a function, a lambda and a callback.
const Z = "zz"
const W = "ww"

function viaIf(b: boolean) {
  let v = if b { Z } else { W }
  v = "x"
  print(v)
}
viaIf(true)

function viaMatch(n: i32) {
  let v = match n {
    1 => Z
    _ => W
  }
  v = "x"
  print(v)
}
viaMatch(1)

function pick(b: boolean) {
  if b { return Z }
  W
}
function viaRecord() {
  const o = { k: pick(true) }
  o.k = "x"
  print(o.k)
}
viaRecord()

function g() { Z }
function viaFnTypes() {
  const fs = [g]
  fs.push(() => "q")
  print(fs[1]())
  let h = g
  h = () => "r"
  print(h())
}
viaFnTypes()

function f(b: boolean) {
  if b { return Z }
  return W
}
let r = f(true)
r = "other"
print(r)

const xs = [pick(true)]
xs.push("q")
print(xs[0] + "," + xs[1])

const fns = [() => Z]
fns.push(() => "q")
print(fns[1]())

function g2() { return Z }
const m = Map()
m.set(g2(), 1)
m.set("k", 2)
print(m.size)
const m2 = Map()
m2.set(Z, 1)
m2.set("k", 2)
print(m2.size)
const s = Set()
s.add(Z)
s.add("k")
print(s.size)

let c = () => Z
c = () => "x"
print(c())

function orNull(b: boolean) {
  if b { return Z }
  null
}
print(orNull(true) ?? "none")
print(orNull(false) ?? "none")
function orNum(b: boolean) {
  if b { return Z }
  1
}
const on = orNum(true)
if on is string { print(on) }
type A = { a: i32 }
function orRec(b: boolean) {
  if b { return Z }
  const x: A = { a: 1 }
  x
}
const orr = orRec(true)
if orr is string { print(orr) }
const orr2 = orRec(false)
if orr2 is A { print(orr2.a) }
function nested() {
  function inner(b: boolean) {
    if b { return Z }
    null
  }
  print(inner(true) ?? "none")
}
nested()
const lam = (b: boolean) => {
  if b { return Z }
  return "x"
}
print(lam(true) + lam(false))
const lamNull = (n: i32) => if n > 0 { Z } else { null }
print(lamNull(0) ?? "none")
const mapped = [1, 2, 3].map((i) => if i > 1 { Z } else { null })
print(mapped.length)
print(mapped[2] ?? "none")
const ms = [1, 2, 3].map((i) => Z)
ms.push("other")
print(ms.length)
const js = [1, 2].map((i) => if i > 1 { Z } else { W })
js[0] = "q"
print(js[0] + js[1])
