// @run
// @log x
// @log x
// @log x
// @log q
// @log r
// @log other
// @log zz,q
// @log q
// @log 2
// @log 2
// @log 2
// @log x
// A `const` bound to a string literal has the literal's type, and that type widens to `string`
// wherever the value is stored somewhere reassignable (D2157). Each line below stored a join of
// two such constants, or a function returning one, and must keep running as it did when the
// constants were plain `string`: an `if` and a `match` join, a record field and a list element
// built from a join, a function-typed list and binding, and a map or set key.
const Z = "zz"
const W = "ww"

function viaIf(b: boolean) {
  let v = if b { Z } else { W }
  v = "x"
  print(v)
}
viaIf(true)

function viaMatch(n: i32) {
  let v = match n {
    1 => Z
    _ => W
  }
  v = "x"
  print(v)
}
viaMatch(1)

function pick(b: boolean) {
  if b { return Z }
  W
}
function viaRecord() {
  const o = { k: pick(true) }
  o.k = "x"
  print(o.k)
}
viaRecord()

function g() { Z }
function viaFnTypes() {
  const fs = [g]
  fs.push(() => "q")
  print(fs[1]())
  let h = g
  h = () => "r"
  print(h())
}
viaFnTypes()

function f(b: boolean) {
  if b { return Z }
  return W
}
let r = f(true)
r = "other"
print(r)

const xs = [pick(true)]
xs.push("q")
print(xs[0] + "," + xs[1])

const fns = [() => Z]
fns.push(() => "q")
print(fns[1]())

function g2() { return Z }
const m = Map()
m.set(g2(), 1)
m.set("k", 2)
print(m.size)
const m2 = Map()
m2.set(Z, 1)
m2.set("k", 2)
print(m2.size)
const s = Set()
s.add(Z)
s.add("k")
print(s.size)

let c = () => Z
c = () => "x"
print(c())
