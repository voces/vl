// @run
// @hint redundant type annotation: `fi` is inferred as `i64` — remove it to lean on inference
// @hint redundant type annotation: `bump` is inferred as `i64` — remove it to lean on inference
// @hint redundant type annotation: `z` is inferred as `i64` — remove it to lean on inference
// `e is L` over an `i64` literal union, where `e` cannot be read twice, reads `e` once into an
// `i64` slot and tests every member; a union over two widths compares at `i64` (D3590).
type B = 5000000000 | 6000000000
type C = 1 | 3000000000
function fi(x: i64): i64 { x }
function fm(): i64 { 1 }
let n = 0
function bump(x: i64): i64 {
  n = n + 1
  x
}
print(fi(5000000000) is B)
print(fi(7) is B)
print(fm() is C)
print(bump(3000000000) is C)
print(n)
const z: i64 = 3000000000
print(z is C)
// @log true
// @log false
// @log true
// @log true
// @log 1
// @log true
