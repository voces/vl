// @run
// @log ka
// @log ka
// @log kc
// @log ia
// @log a
// @log n
// @log i
// @log ka
// @log kc
// @log kc
// A NARROWED literal-union PARAMETER (`K & !"kb"`) and every consumer of it. This was
// `xfail-miscompile-narrowed-litunion-param-string-return.vl`.
//
// The parameter is declared `i32` (the atom) and the consumers once asked whether the arena type
// was a REGISTERED alias, which a narrowed copy is not, so `print(v)` emitted the raw id. Since
// the ruling `one-literal-union-rep` the rep is a function of the type: every string literal
// union is the atom, whatever its spelling, so all three spellings below are `(param i32)`:
//
//   v: K                 registered alias
//   v: K & !"kb"         narrowed copy
//   v: "ia" | "ib"       inline
//
// There are four readers: the callee (`exprIsLitAtom`), the direct caller (`cParamLitUnion`),
// a captured read (`bindingIsLitAtom`) and a captured call (`emitCapturedCall`). A fixture over
// the direct call alone passed while the capture channel printed raw ids, so the last two arms
// cover the capture channel. The function-VALUE call is `narrowed-litunion-fn-value-arg.vl`.
type K = "ka" | "kb" | "kc"
type N = K & !"kb"

function takesN(v: N): string { v }
function takesK(v: K): string { v }
function takesInline(v: "ia" | "ib"): string { v }

function pAlias(v: K) {
  if v == "ka" { print("a") }
}
function pNarrow(v: N) {
  if v == "ka" { print("n") }
}
function pInline(v: "ia" | "ib") {
  if v == "ia" { print("i") }
}

// The CAPTURE channel: a narrowed param read from inside a closure, and called from inside one.
function captures(v: N) {
  const g = () => {
    print(v)
  }
  g()
}

function capturedCall(v: N) {
  const h = (w: N) => {
    print(w)
  }
  h(v)
}

function main() {
  print(takesN("ka"))
  const n: N = "ka"
  print(n)
  print(takesK("kc"))
  print(takesInline("ia"))

  pAlias("ka")
  pNarrow("ka")
  pInline("ia")

  captures("ka")
  captures("kc")
  capturedCall("kc")
}
main()
