// @run
// @log a,b
// @log a<b
// @log a=>b
// @log a,b
// @log a}b
// CONTRACT: a type-name SEPARATOR that appears inside a QUOTED literal member is part of
// the member's TEXT, not the grammar. `emit_base`'s `tyTopLevelIndexOf` / `tyTopLevelSplit`
// were quote-BLIND where the checker's `tyTopIndexOf` has skipped quoted members
// (escape-aware, via `skipQuotedName`) since #1143, so `Box<"a,b" | "zz" | null>` split at
// the quoted comma and the annotation was rebuilt from the rubble
// (`emitProgram: bare null needs a struct-typed context`).
//
// Graded over a 15-text x 10-position x {plain, nullable} matrix (300 cells), the two
// ladders disagreed on 24 cells spanning NINE characters (`, { } [ ] ( ) <` and `=>`) and
// six positions. This file pins one cell per DISTINCT REASON the population had:
//
//   * a generic ARGUMENT (`Box<...>`) and a TWO-argument generic (`P<..., i32>`), which is
//     where #1151 first saw it — and, per #1153's own control, NOT what causes it;
//   * a PLAIN (non-nullable) member carrying the ARROW, the one character that needs the
//     home's two-character `=>` lookahead to sit INSIDE the quote skip. On master this cell
//     did not even reject — it emitted a module the runtime could not parse;
//   * an INLINE OBJECT SHAPE with two fields, which reaches the grammar through
//     `shapeInnerFieldSplit`. Until #1155 that scanner had a SECOND, private definition in
//     `emit_classify` carrying its own quote-blind ladder, so these last two lines needed
//     both homes repaired; one home later, they need only this one.
//
// The `}` case earns its line separately from `,`: a quoted CLOSER runs the depth NEGATIVE,
// so a blind ladder does not merely split in the wrong place, it loses the enclosing group.

type Box<T> = { v: T }
type P<A, B> = { a: A, b: B }

const b: Box<"a,b" | "zz" | null> = { v: "a,b" }
if b.v != null { print(b.v) }

const p: P<"a<b" | "zz" | null, i32> = { a: "a<b", b: 7 }
if p.a != null { print(p.a) }

const q: Box<"a=>b" | "zz"> = { v: "a=>b" }
print(q.v)

const s: {v: "a,b" | "zz" | null, w: i32} = { v: "a,b", w: 7 }
if s.v != null { print(s.v) }

const t: {v: "a}b" | "zz" | null, w: i32} = { v: "a}b", w: 7 }
if t.v != null { print(t.v) }
