// @run
// @log p
// @log q
// @log p
// @log p
// @log p
// @log q
// @log p
// @log p
// @log 1
// The three redundant-annotation hints are DECLARED, not silenced: the annotation IS the
// destination under test. Delete it and the binding infers the same type from its
// initializer, which is a different program — the container's declared element type is what
// makes the slot an atom slot.
// @hint redundant type annotation: `arrlit` is inferred as `("p" | "q")[]`
// @hint redundant type annotation: `a2` is inferred as `("p" | "q")[]`
// @hint redundant type annotation: `once` is inferred as `("p" | "q")[]`
// D13 of `docs/internals/silent-class-inventory.md`, and the three destinations
// `emitDestStrToAtom`'s header filed as "the same boundary one destination over".
//
// AN INLINE literal union PRODUCED BY A CALL and stored into a container was a LOUD reject —
// `emitProgram: literal-union atom narrowing needs a re-readable receiver` — at the array
// LITERAL element, the INDEXED store and the MAP-VALUE store alike. The container's slot holds
// the interned i32 ATOM (`ctxKeepsLitUnion` holds at an element, a field and a map value)
// while the call's result is the string ref an inline litunion softens to at `RC_ROOT`, so the
// store needs a NARROW; the narrow is a `select` tower that re-reads its operand once per
// member, and a CALL re-read once per member is the wrong number of EVALUATIONS, not merely a
// wrong value — so the tower refused one.
//
// ONE ARM CLOSED ALL THREE, and the reason it is one arm rather than three is that the narrow
// has ONE entry point: `emitExpr`'s `pendingLitUnion` hook, which every atom-typed destination
// already seeds. A non-place value is now STAGED there — evaluated ONCE into a slot, then
// re-read per member — which is `emitAtomToStr`'s id stash mirrored and what the `.push`
// destination already did. The predicted "a reservation walk per destination" was not needed:
// they are all EXPRESSION positions, so `exprPopBits` — the value-position walk that already
// reserves the `.pop` frames — reaches every one of them.
//
// THE `alias` AND `literal` CONTROLS ARE THE ROW'S OWN, and they must not move: a declared
// ALIAS reps as the atom at BOTH ends, so no narrow is wanted at all, and a member LITERAL
// folds to its interned id at compile time with no tower. It needed BOTH the inline spelling
// and the call.
//
// EVALUATION COUNT IS PART OF THE CONTRACT, which is why `src` counts its calls: a tower that
// re-read a call once per member would print `2` here instead of `1`, and that is a wrong
// answer rather than a refusal.

function src(): ("p" | "q") { return "p" }

// ── the three destinations, with a CALL value and the INLINE spelling ──
const arrlit: ("p" | "q")[] = [src()]
print(arrlit[0])

const idx: ("p" | "q")[] = ["q", "q"]
idx[1] = src()
print(idx[0])
print(idx[1])

const mv: {[string]: ("p" | "q")} = Map()
mv["k"] = src()
print(mv["k"] ?? "q")

// ── the same three inside a FUNCTION, the scope the row's own repro used ──
function inFn() {
  const a2: ("p" | "q")[] = [src()]
  print(a2[0])
  const i2: ("p" | "q")[] = ["q", "q"]
  i2[1] = src()
  print(i2[0])
  print(i2[1])
  const m2: {[string]: ("p" | "q")} = Map()
  m2["k"] = src()
  print(m2["k"] ?? "q")
  0
}
inFn()

// ── EVALUATION COUNT: the staged value is evaluated exactly ONCE per store ──
let calls = 0
function counted(): ("p" | "q") {
  calls = calls + 1
  return "p"
}

const once: ("p" | "q")[] = [counted()]
print(once.length - 1 + calls)
