// @run
// @log none
// @log fork
// @log none
// @log knife
// @log spoon
// @log none
// @log fork!
// D4039: an un-annotated function tail that joins two DIFFERENT literal-union types. The join is
// an inline union no alias names, and every string literal union reps as the atom, so the
// inferred return and the tail agree on `i32`. The closure spelling once printed the atom id.
type Look = "knife" | "fork"
type Alt = "none" | "spoon"

function src(k: i32, a: Look, b: Alt) {
  if k == 0 { a } else { b }
}

function run(k: i32, a: Look, b: Alt) {
  const f = () => if k == 0 { a } else { b }
  print(f())
}

function viaMatch(k: i32, a: Look, b: Alt) {
  match k {
    0 => a
    _ => b
  }
}

function inline(k: i32, a: "knife" | "fork", b: "none" | "spoon") {
  if k == 0 { a } else { b }
}

print(src(1, "knife", "none"))
print(src(0, "fork", "none"))
run(1, "knife", "none")
run(0, "knife", "none")
print(viaMatch(1, "knife", "spoon"))
print(inline(1, "knife", "none"))
const s: string = inline(0, "fork", "none")
print(s + "!")
