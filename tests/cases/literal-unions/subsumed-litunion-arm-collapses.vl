// A LITERAL-UNION ALIAS BESIDE ITS OWN BASE COLLAPSES — `Kind | string` IS `string`, the
// MIRROR half of the owner's 2026-09-02 subsumed-arm ruling. D1024 shipped the BARE-literal
// half (`string | "err"`); this is silent-class-inventory D1048, and it is the POSITION
// MATRIX for it.
//
// WHY IT NEEDED A MATRIX. The refusal was enforced nowhere — the arena simply minted a
// two-member union whose litunion arm rode the box as its member STRING, sharing the
// `string` atom's slot. That is `check`-clean INVALID WASM, and it fired at exactly the
// delivery positions where the value had to cross a signature: a PARAMETER (`offset 254`), a
// module GLOBAL, a `+` operand, and a generic pin's RETURN. Eight of the forty-two cells of
// the filed matrix; the other thirty-four ran, which is why reading the call sites was never
// going to find them.
//
// IT TOOK TWO PRODUCERS, AND EACH ALONE IS A `runs → not-runs` VETO — measured, in both
// directions, against this file's two sibling fixtures (`mixed-union-litunion-arm-is-
// membership.vl` and `is-litunion-arm-non-ident-receivers.vl`, D1048's named set):
//
//   · the ARENA alone (`homogLitUnionBase` inside `armLiteralBaseTy`): canon still spelled
//     `Kind|string`, so the emitter reserved a union box for a plain-string binding —
//     `struct field type \`K|string|i32\` has no struct-field rep` at one, check-clean
//     invalid wasm at the other.
//   · CANON alone (`canonDropSubsumedParts`): the arena still minted the two-member union —
//     `only i32 locals are supported` at one, invalid wasm at the other, and `x is Kind`
//     answered a silent TRUE for the non-member `"zz"`, which is the #1306 wrong answer
//     arriving from the other side.
//
// THE THIRD STEP THE ROW PRESCRIBED WAS ALREADY BUILT, and measuring it first is what made
// the rest cheap: `is Kind` over a COLLAPSED `string` base is ALREADY the membership ladder
// `emitIs` emits for a standalone litunion receiver, at every position the named set
// exercises. Verified on master before any edit by writing both fixtures in the spelling the
// collapse produces — 20 of 20 correct, the `string | i32` box and the `string | null` niche
// included.
//
// THE CONTROLS ARE HALF THE FILE, because a collapse rule that is too wide is worse than the
// gap. `Kind | "err"` keeps all three atoms (a literal ADDS a value to a literal set — D1043),
// `Kind | K2` stays the flattened four-atom litunion, `Kind | i32` stays a genuine two-arm
// box whose tag decides `is Kind` exactly, and `Kind | null` stays the atom niche.
// THE HINTS ARE THE RULING'S OWN FIRST HINT, ARRIVING FREE. Every `Kind | string` spelling
// below now denotes `string`, so the existing redundant-annotation machinery says so — at
// the five RETURN annotations as well as at the bindings. The annotations stay written out
// and the hints are DECLARED, because deleting them would delete the very spelling this
// fixture exists to pin. The `m` map binding is NOT in the list and that is not an omission:
// a `Map()` initializer needs its annotation to say what it is a map OF, so no hint fires.
// @hint redundant type annotation: `mirror` is inferred as `string` — remove it to lean on inference
// @hint redundant type annotation: `gv` is inferred as `string` — remove it to lean on inference
// @hint redundant type annotation: `readGlobal` is inferred as `string` — remove it to lean on inference
// @hint redundant type annotation: `plus` is inferred as `string` — remove it to lean on inference
// @hint redundant type annotation: `pinned` is inferred as `string` — remove it to lean on inference
// @hint redundant type annotation: `make` is inferred as `string` — remove it to lean on inference
// @hint redundant type annotation: `c` is inferred as `string` — remove it to lean on inference
// @hint redundant type annotation: `xs` is inferred as `string[]` — remove it to lean on inference
// @hint redundant type annotation: `s` is inferred as `{f: string}` — remove it to lean on inference
// @hint redundant type annotation: `viaAlias` is inferred as `string` — remove it to lean on inference
// @hint redundant type annotation: `bindMem` is inferred as `string` — remove it to lean on inference
// @hint redundant type annotation: `bindNon` is inferred as `string` — remove it to lean on inference
// @hint redundant type annotation: `retMem` is inferred as `string` — remove it to lean on inference
// @hint redundant type annotation: `retNon` is inferred as `string` — remove it to lean on inference

type Kind = "a" | "b"

// ── the delivery positions that were check-clean INVALID WASM ───────────────────
function mirror(x: Kind | string): string { x }
print(mirror("zz"))
print(mirror("a"))

const gv: Kind | string = "zz"
function readGlobal(): string { gv }
print(readGlobal())

function plus(x: Kind | string): string { x + "" }
print(plus("a"))

function pick<T>(v: T): T | Kind { return v }
const pinned: string = pick("zz")
print(pinned)

// ── the positions that already ran, pinned so the collapse cannot lose them ─────
function make(): Kind | string { "zz" }
print(make())

const c: Kind | string = "zz"
print(c)

const xs: (Kind | string)[] = ["zz", "a"]
print(xs[0] + xs[1])

const m: {[string]: Kind | string} = Map()
m["k"] = "zz"
print(m["k"])

type S = { f: Kind | string }
const s: S = { f: "zz" }
print(s.f)

type R = Kind | string
function viaAlias(x: R): string { x + "!" }
print(viaAlias("zz"))

// ── the UN-ANNOTATED spellings: inference does the pinning, so a fixture that
//    annotated every destination could not see them ────────────────────────────
const inferred = make()
print(inferred)
if inferred is Kind { print("K") } else { print("S") }
const inferredMem = mirror("a")
if inferredMem is Kind { print("K") } else { print("S") }
function thru() { return make() }
print(thru())
const inferredList = [make()]
print(inferredList[0])

// ── `is Kind` / `is string`, member and non-member, at three positions ──────────
function isAtParam(x: Kind | string, lbl: string) {
  if x is Kind { print(lbl + "K") } else { print(lbl + "S") }
  0
}
isAtParam("a", "")
isAtParam("zz", "")

const bindMem: Kind | string = "a"
if bindMem is string { print("S") } else { print("N") }
const bindNon: Kind | string = "zz"
if bindNon is string { print("S") } else { print("N") }

const retMem: Kind | string = mirror("a")
if retMem is Kind { print("K") } else { print("S") }
if retMem is string { print("S") } else { print("N") }
const retNon: Kind | string = mirror("zz")
if retNon is Kind { print("K") } else { print("S") }
if retNon is string { print("S") } else { print("N") }

// ── CONTROLS: the unions that must NOT collapse ────────────────────────────────
// A LITERAL beside a literal SET adds a value (D1043) — three atoms, not two.
const lit: Kind | "err" = "err"
print(lit)
// Two literal sets flatten; neither subsumes the other.
type K2 = "c" | "d"
const two: Kind | K2 = "c"
if two is K2 { print("K2") } else { print("N") }
print(two)
// A `Kind | i32` box has no `string` ARM, so it stays a box and its tag decides exactly.
function boxed(x: Kind | i32, lbl: string) {
  if x is Kind { print(lbl + "box-K") } else { print(lbl + "box-i") }
  0
}
boxed(7, "")
boxed("b", "")
// A `Kind | null` niche has no `string` ARM either.
const niche: Kind | null = "a"
if niche is Kind { print("niche-K") } else { print("niche-N") }
