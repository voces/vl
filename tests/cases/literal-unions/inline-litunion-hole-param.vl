// @run
// @log green
// @log EQ
// @log IS
// @log 1
// @log green
// @log green
// @log green
// @log red
// @log hi
// @hint redundant type annotation: `plain` is inferred as `string[]` — remove it to lean on inference
// An INLINE literal-union set delivered through an UN-ANNOTATED parameter, at every consumer
// that decides the rep differently. A litunion ARRAY is always the interned-i32 atom list, so
// the value arriving is an atom id, and the MONOMORPHIZATION PIN is what gives the parameter a
// rep: an inline set has no alias to name, so it softens to `string` — the same lowering the
// annotated inline spelling takes. Without that pin the ladder fell to its `i32` catch-all,
// `print` printed the raw id and `==` emitted the string compare core against an i32 (D1545).
//
// NO `type` DECLARATION MAY BE ADDED. An alias whose member set is exactly this one makes the
// array element resolve to the alias's own arena index, and every line below then passes for
// the wrong reason — the alias spelling always ran.

const srcArr: ("red" | "green")[] = ["green", "red"]
const plain: string[] = ["hi"]

function shows(a) { print(a) }
function eq(a) {
  if a == "green" { print("EQ") } else { print("NE") }
}
function isMember(a) {
  if a is "green" { print("IS") } else { print("NOT") }
}

function keyed(a) {
  const m = Map()
  m["green"] = 1
  print(m[a] ?? 0)
}

function gives(a) { return a }

// A second delivery hop: the hole forwards to another hole, so the inner pin is taken from
// the outer parameter rather than from the array read.
function inner(b) { print(b) }
function forwards(a) { inner(a) }

// One name, two pins: the inline set and a plain `string`. Both soften to the same rep, so
// the two calls share one instance instead of disagreeing about the parameter's width.
// `plain` keeps its annotation, hint and all, so the second pin's spelling is declared here
// rather than inferred — the redundant-annotation hint is about the TYPE, not the rep.
function shared(a) { print(a) }

shows(srcArr[0])
eq(srcArr[0])
isMember(srcArr[0])
keyed(srcArr[0])
print(gives(srcArr[0]))
forwards(srcArr[0])
shared(srcArr[0])
shared(srcArr[1])
shared(plain[0])
