// @run
// @log B
// @log C
// @log B
// @log B
// @log true
// @log A
// @log B
// @log 7
// @hint Intentionally-unused parameter `_k`
// Where an inferred literal-union return LANDS: a struct field, a list element, a map
// value, a module global, a `for` loop, an exported function's ABI, and a second function
// sharing the same parameter spine.
//
// CONTRACT: each of these is a distinct store path, and each takes the interned i32 ATOM.
// The last pair is the `$fnsig` interning invariant in miniature — `idK` and `sevenOf`
// share a parameter spine, so a return kind that disagreed with the emitted body would put
// one of them in the other's functype (the two victims report MIRRORED errors).

type K = "A" | "B" | "C" | "D"
type Slot = { c: K, n: i32 }

export function idK(k: K) { return k }

function sevenOf(_k: K) { return 7 }

// Into a struct field — the shape infers `{c: K, n: i32}` from the call result alone.
const slot = { c: idK("B"), n: 1 }
print(slot.c) // B

// Into a list element, read back by index.
const ks = [idK("B"), idK("C")]
print(ks[1]) // C

// Into a map value, read back through `??`.
const m: {[string]: K} = Map()
m["p"] = idK("B")
print(m["p"] ?? "A") // B

// Into a module GLOBAL binding — print widens it, `==` compares by member.
const g = idK("B")
print(g) // B
print(g == "B") // true

// Through a `for` loop over a literal-union list.
const src: K[] = ["A", "B"]
for v in src {
  print(idK(v))
} // A, B

// A sibling with the SAME parameter spine and a different result kind.
print(sevenOf("B")) // 7
