// @run
// @log kb
// @log plain
// @log kb
// @log kb
// @log kb
// @log kb
// @log kb
// @hint redundant type annotation: `mixed` is inferred as `string[]` — remove it to lean on inference
// @hint redundant type annotation: `strFirst` is inferred as `string[]` — remove it to lean on inference
// THE TWO `@hint`s ARE DECLARED, NOT TAKEN. The linter calls the annotation on the two MIXED
// literals redundant because their own join already reaches `string[]` — which is precisely
// the accident that made those two spellings work before the fix. Removing them would delete
// the arms that prove the defect was not about element order. The all-atom arms draw no hint
// at all: their inferred type is `K[]`, so the annotation there is load-bearing to the
// checker as well as to the emitter.
// A `string[]` ANNOTATION OVER LITERAL-UNION ATOM ELEMENTS, all six spellings.
//
// Three of them used to emit a module the engine refuses (`vl check` rc 0, `vl check
// --codegen` rc 1): an array literal whose elements are literal-union atoms under a
// `string[]` annotation built the i32 ATOM list while the binding's slot held the
// string-list wrapper. Graduated from `soundness/xfail-miscompile-atom-first-arraylit-
// ignores-annotation.vl`.
//
// THE DEFECT WAS NOT ABOUT ELEMENT ORDER, which the old fixture's header believed and
// which this matrix is arranged to refute. It was about whether the literal's OWN
// inferred element type joins to `string`: a MIXED literal (`[v, "plain"]`) infers
// `string[]` all by itself and so recorded the right rep by accident, while an ALL-ATOM
// literal (`[v]`, `[v, v]`) infers `K[]` and recorded the atom list under a `string[]`
// destination that reps differently.
//
// THE FIX IS ON THE ADOPTION SIDE. `assignableExpr`'s pre-short-circuit recorder
// (`recordElemRepArrayLit`) already stamped the destination array type on a literal whose
// element target is a NICHE-nullable scalar, for exactly this reason — the reps differ and
// the literal's own inference cannot say so. `string` over a litunion element is the same
// question and was the arm it lacked. It has to run BEFORE the plain-assignable
// short-circuit: `K[]` IS covariantly assignable to `string[]`, so the literal-aware
// adoption block never sees this pair.
//
// The last three arms are the CONTROLS that worked all along, kept here so a regression in
// either direction is visible: a string-FIRST literal (whose join already said `string`),
// the `(string | null)[]` spelling (whose niche arm predates this), and the genuine `K[]`
// annotation, which must STILL build the atom list and read back as its member text.
type K = "ka" | "kb"

function main() {
  const v: K = "kb"

  const mixed: string[] = [v, "plain"]
  print(mixed[0])
  print(mixed[1])

  const solo: string[] = [v]
  print(solo[0])

  const allAtom: string[] = [v, v]
  print(allAtom[1])

  const strFirst: string[] = ["plain", v]
  print(strFirst[1])

  const nulSpelling: (string | null)[] = [v, "plain"]
  const n0 = nulSpelling[0]
  if n0 != null { print(n0) } else { print("nil") }

  const atomList: K[] = [v, "ka"]
  print(atomList[0])
}
main()
