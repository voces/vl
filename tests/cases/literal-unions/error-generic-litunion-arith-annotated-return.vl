// @check
// @error return type mismatch: expected 5 | 6, got i32 (the return of `mul` at the call's argument types)
// @error return type mismatch: expected 5 | 6, got i32 (the return of `inc` at the call's argument types)
// Arithmetic over a type parameter pinned at a literal union is the union's base scalar, so a
// `: T` return refuses it at the pin, written type argument or inferred, as the direct spelling
// refuses `const y: 5 | 6 = x * 1000000` (D3602).
function mul<T>(x: T): T { x * 1000000 }
function inc<T>(x: T): T { x + 1 }
const c = mul<5 | 6>(5)
print(c)
const d: 5 | 6 = 5
print(inc(d))
print(mul<i32>(5))
