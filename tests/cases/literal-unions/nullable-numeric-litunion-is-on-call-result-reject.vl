// @emit-error emitProgram: `is` names a type that is not a union variant
// THE SOUNDNESS BOUNDARY OF THE NUMERIC-LITUNION MEMBERSHIP LADDER, PINNED AS A REJECT so a later
// change cannot turn it into invalid wasm or a wrong answer.
//
// `x is N` over a numeric literal union is a MEMBERSHIP test — `x == m0 || x == m1 || …` — so it
// RE-READS its receiver once per member. A bare CALL RESULT is not a re-readable place: re-reading
// it would re-run the call (an effect duplicated, and a different value if the callee is not pure),
// and there is no spill slot reserved for one. `unionEqOperandOk` is that bound, and the numeric arm
// PRE-CHECKS it and declines rather than flooring from inside — deliberately, so the shapes it
// merely fails to claim keep whichever diagnostic the paths below would give them. This program
// therefore falls to the variant ladder's own message.
//
// THIS IS A WORDING PIN AND HAS TO BE: the program does not compile, so there is no log form. The
// pin's job is the DIRECTION. A change that starts accepting this must arrive with a receiver spill
// (so each member reads the same value), not by letting the membership ladder duplicate the call.
//
// BINDING THE RESULT FIRST IS THE SUPPORTED SPELLING and it is pinned as a LOG fixture in
// `nullable-numeric-litunion-return.vl` — `const r = mk(true)` then `r is N`, which is a
// re-readable place. This file is one line away from that one, which is what makes the boundary
// legible rather than arbitrary.

type N = 1 | 2

function mk(b: boolean): N | null {
  if b { return 1 }
  return null
}

print(mk(true) is N)
