// @run
// @log one
// @log a
// @log one
// @log a
// @log 1
// @log b
// @log x

// An element of a list of a union mixing number and string literals is the union's box, so a
// binding of it reads, compares and narrows as the box, whichever other literal unions the
// program uses.
type M = 1 | "a" | "b"
type K = "x" | "y"

function g(k: K) { print(k) }
function eq(xs: M[]) {
  const v = xs[0]
  if v == 1 { print("one") } else { print(v) }
}
function isTest(xs: M[]) {
  const v = xs[0]
  if v is 1 { print("one") } else { print(v) }
}
function plain(xs: M[]) {
  const v = xs[0]
  print(v)
}

eq([1])
eq(["a"])
isTest([1])
isTest(["a"])
plain([1])
plain(["b"])
g("x")
