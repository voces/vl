// @run
// @log 1
// @log 3
// CONTRACT: an atom receiver tested against a PROPER SUBSET of its own members — a member
// LITERAL (`k is "x"`) and a narrower alias (`k is Q`). Neither folds to a constant: the
// lowering is the membership test `id == internAtom("x")`.
//
// Before D-ATOMIS both built a module that failed to parse as WebAssembly: the member-literal
// spelling fell through to the softened value-compare path (a string equality against a raw
// i32 id) and the alias spelling took the union box-tag compare.

type K = "x" | "y"
type Q = "x"

const g: K = "x"

if g is "x" { print(1) }
if g is "y" { print(2) }
if g is Q { print(3) }
