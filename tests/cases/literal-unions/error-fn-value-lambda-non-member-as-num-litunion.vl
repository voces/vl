// @error cannot assign () => i32 to 'hn' of type () => N
// @error cannot assign () => i32 to 'ht' of type () => N
// A lambda adopts a numeric literal union only when every value it returns is a member: an
// early `return 3` is not, and neither is a tail outside the union (D9490).
type N = 1 | 2
const d = false
const hn: () => N = () => {
  if d { return 3 }
  2
}
const ht: () => N = () => {
  if d { return 1 }
  3
}
print(hn() + ht())
