// rather than an absent value. A member literal is still accepted with no note.
type L = 1 | 2 | 3
const x = true
function pick(): L {
  if x { 1 } else { 5 }
}
const b: L = -2
const c: L = 2.0
const e: L = if x { 1 } else { 6 }
const f = (): L => {
  if x { 1 } else { 7 }
}
function g(): L { return if x { 8 } else { 1 } }
const d: L = 2
print(pick())
print(b + c + e + f() + g() + d)
