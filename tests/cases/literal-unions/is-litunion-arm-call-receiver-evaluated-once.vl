// @run
// @log E
// @log no
// @log E
// @log yes
// @log 2
// @hint redundant type annotation: `src` is inferred as `string`
// `src() is K` over a value union carrying the literal-union alias `K` beside a `string` arm.
// `K` rides the box as its member string, so the tag compare cannot decide the question and
// the answer is membership over the payload, which reads the receiver once per member. A call
// is not a re-readable place, so it is evaluated once into a local first (D12060).
//
// `"zz"` is a string but not a `K`, so the first test is `no`, and `gEv` counts each call
// exactly once. `is-litunion-arm-non-ident-receivers.vl` pins the receivers that are places.

type K = "a" | "b"

let gEv = 0

function src(s: string): K | string {
  gEv = gEv + 1
  print("E")
  s
}

function probe(s: string) {
  if src(s) is K { print("yes") } else { print("no") }
  0
}

probe("zz")
probe("b")
print(gEv)
