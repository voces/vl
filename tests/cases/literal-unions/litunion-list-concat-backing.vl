// @run
// @log 3
// @log a
// @log b
// @log a
// @log 3
// @log true
// @log false
// @log true
// @log 3
// @log a
// @log b
// @log a
// @log 3
// @log 1
// @log 2
// @log 1
// @log 2
// @log a
// @log a
// @log 2
// @log 1
// @log 1
// @log 3
// @log a
// @log null
// @log b
// @log 3
// @log true
// @log null
// @log false
// @log 2
// @log 7
// @log 9
// @hint redundant type annotation: `a` is inferred as `boolean[]`
// @hint redundant type annotation: `b` is inferred as `boolean[]`
// @hint redundant type annotation: `a` is inferred as `(boolean | null)[]`
// THE `@hint` LINES ARE DELIBERATE. Every annotation in this file is load-bearing — it is
// what pins the ELEMENT rep the row is about — so the redundancy hints are DECLARED rather
// than silenced by deleting the annotation, which would leave the fixture measuring inference
// instead of the backing split.
//
// THE `+` ACCEPT SET, WRITTEN DOWN. Companion to
// `tests/cases/generics/error-list-concat-no-core.vl`, which holds the refusals; this file
// holds the capability, so a later narrowing of `concatElemIsI32Backed` that over-refuses
// goes red here rather than quietly removing something.
//
// WHY IT EXISTS. That predicate's header says it "DEFAULTS TO ACCEPT, deliberately… a rule
// that over-refuses removes a capability", and `silent-class-inventory` D102 is a narrowing
// of exactly that rule — so the narrowing needs the other direction measured too, at every
// spelling, and by VALUE rather than by length. A concat that wrote the right count of
// elements into the wrong backing passes a `.length` check and fails here.
//
// ONE i32 CELL IS THE WHOLE RULE, and these are the eight spellings that have it: the two
// prims (`i32`, `boolean`), a nominal newtype over `i32`, a STRING literal union (interned
// atom ids), a NUMERIC literal union whose single base is `i32`, the two SINGLE literals whose
// base is `str` or `i32`, and the two i32-SENTINEL nullables (`K | null` rides the atom's spare
// `-1`, `boolean | null` the 0/1's spare `2`). The three spellings D102 removed sit one base
// away from two of these — `type G = 1.5` beside `type J = 1`, `type F = 1.5 | 2.5` beside
// `type N = 1 | 2`, `type BIG = 9999999999` beside `type J = 1` — which is why the rows are
// kept adjacent: the pair is the discriminator, and a fix that could not tell them apart
// would show up as one of these going loud.
type K = "a" | "b"
type N = 1 | 2
type H = "a"
type J = 1
type Id = new i32

function litUnionStr() {
  const a: K[] = ["a", "b"]
  const b: K[] = ["a"]
  const c = a + b
  print(c.length)
  print(c[0])
  print(c[1])
  print(c[2])
}

function prims() {
  const a: boolean[] = [true, false]
  const b: boolean[] = [true]
  const c = a + b
  print(c.length)
  print(c[0])
  print(c[1])
  print(c[2])
}

function litUnionStrInline() {
  const a: ("a" | "b")[] = ["a", "b"]
  const b: ("a" | "b")[] = ["a"]
  const c = a + b
  print(c.length)
  print(c[0])
  print(c[1])
  print(c[2])
}

function litUnionNumI32() {
  const a: N[] = [1, 2]
  const b: N[] = [1]
  const c = a + b
  print(c.length)
  print(c[0])
  print(c[1])
  print(c[2])
}

// ── the SINGLE literals, and the pair that discriminates D102: `H`/`J` keep the backing,
//    `G = 1.5` and `BIG = 9999999999` lose it and are refused in the error fixture. ──
function litSingleStr() {
  const a: H[] = ["a"]
  const b: H[] = ["a"]
  const c = a + b
  print(c.length)
  print(c[0])
  print(c[1])
}

function litSingleI32() {
  const a: J[] = [1]
  const b: J[] = [1]
  const c = a + b
  print(c.length)
  print(c[0])
  print(c[1])
}

// ── the two i32-SENTINEL nullables. The `null` must survive the copy AS the sentinel, which
//    is why each element is printed on its own line: a concat that folded the spare `-1` or
//    the spare `2` to 0 would print `a` / `false` where these rows say `null`. ──
function nulAtomSentinel() {
  const a: (K | null)[] = ["a", null]
  const b: (K | null)[] = ["b"]
  const c = a + b
  print(c.length)
  print(c[0])
  print(c[1])
  print(c[2])
}

function nulBoolSentinel() {
  const a: (boolean | null)[] = [true, null]
  const b: (boolean | null)[] = [false]
  const c = a + b
  print(c.length)
  print(c[0])
  print(c[1])
  print(c[2])
}

// ── the NOMINAL newtype over `i32`, which erases to the same cell. ──
function newtypeI32() {
  const a: Id[] = [7]
  const b: Id[] = [9]
  const c = a + b
  print(c.length)
  print(c[0])
  print(c[1])
}

litUnionStr()
prims()
litUnionStrInline()
litUnionNumI32()
litSingleStr()
litSingleI32()
nulAtomSentinel()
nulBoolSentinel()
newtypeI32()
