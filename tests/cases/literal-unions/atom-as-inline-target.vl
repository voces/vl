// @run
// @log a
// @log a?
// @log a!
// @log b
// @log none
// @log b!b
// @log c
// @log a
// @log none
// `as` from a literal-union atom to an inline target: one member literal yields that member's
// text, an inline sub-union of members yields the atom. Read at an un-annotated binding, an
// argument, a return and a list element, in all three modes (D5289).
type W = "a" | "b" | "c"
function src(i: i32): W {
  if i == 0 { "a" }
  else if i == 1 { "b" }
  else { "c" }
}
function wide(w: W): string { w + "!" }

function one(k: W): "a" { k as! "a" }
print(one(src(0)))
function bound(k: W): string {
  const a = k as "a"
  a + "?"
}
print(bound(src(0)))
print(wide(src(0) as! "a"))
print(bound(src(1)))
const miss = src(1) as? "a"
print(miss ?? "none")

const ab = src(1) as! ("a"|"b")
print(wide(ab) + ab)
function sub(k: W): string {
  const s = k as ("a"|"b")
  s
}
print(sub(src(2)))
const got = [src(0) as! "a", src(1) as? ("a"|"c")]
print(got[0] ?? "x")
print(got[1] ?? "none")
