// @run
// @log err
// @log ok
// @log ret-err
// @log ret-ok
// @log 7
// @log 2.5
// @log err
// @log box-err
// @log box-num
// @log a
// @log b
// @log e
// @log N
// @log err
// @log ok
// THE HINTS ARE DECLARED, NOT DELETED. Each names an annotation whose union collapsed to a
// single arm, which is the ruling's first hint arriving through the redundant-annotation
// machinery that already existed. Deleting the annotations to silence them would remove the
// SIGNATURE positions — the two D1024 actually filed — and leave the fixture testing nothing.
// @hint redundant type annotation: `ret` is inferred as `string`
// @hint redundant type annotation: `param` is inferred as `string`
// @hint redundant type annotation: `viaAlias` is inferred as `string`
// @hint redundant type annotation: `numI` is inferred as `i32`
// @hint redundant type annotation: `numF` is inferred as `f64`
// A SUBSUMED LITERAL ARM COLLAPSES — the owner's 2026-09-02 ruling, filed as D1024.
//
// A union is a SET of values, and an arm that adds no values adds no arm: `string | "err"`
// is `string`, `i32 | 3` is `i32`, and the mirror image `Kind | string` is `string`.
// Before the collapse the literal WIDENED to a duplicate `string` atom — the refusing
// sibling printed the member list as `…|string|…|string` — and a union box's tags are
// POSITIONAL over that set, so the rep built for it did not match what the function
// delivered: `vl check` rc 0 and `expected struct type at index 0, found (array (mut i32))`.
//
// THE NON-COLLAPSING CONTROLS ARE HALF THE FIXTURE, and they are why it cannot be shortened.
// Nothing collapses that ADDS a value, so `i32 | "err"` must stay a genuine two-arm box and
// `Kind | "err"` (`Kind = "a" | "b"`) must stay the three-atom litunion. A fixture that only
// showed the collapse would pass just as happily if the rule had eaten those two as well —
// and the arm it ate would be invisible at the CONSTRUCT position, which is why every case
// below also DISCRIMINATES.

type Kind = "a" | "b"
type Name = string
type R = Kind | "err"

// The signature positions D1024 filed: return, then parameter.
function ret(n: i32): string | "err" {
  if n == 0 { return "err" }
  "ok"
}
function param(x: string | "err"): string {
  "ret-" + x
}

// A literal arm subsumed by a base reached THROUGH AN ALIAS.
function viaAlias(): Name | "err" { "err" }

// Numeric bases collapse the same way — the widen had no rep for these either.
function numI(): i32 | 3 { 7 }
function numF(): f64 | 1.5 { 2.5 }

// THE MIRROR IMAGE IS NOT HERE, BUT IT SHIPPED (2026-09-02, D1048). The ruling also
// collapses `Kind | string` to `string`, and that half needed a SECOND producer — canon's
// union arm had to drop the same arm off the SPELLING (`canonDropSubsumedParts`), or the
// arena said `string` while the annotation still said `Kind|string`. Its own position matrix
// lives in `subsumed-litunion-arm-collapses.vl`, kept a separate fixture because the two
// halves fail differently and a merged file could green on one.

// CONTROL — `i32 | "err"` adds a value on both sides, so it stays a two-arm box.
function box(n: i32): i32 | "err" {
  if n == 0 { return "err" }
  5
}

// CONTROL — `Kind | "err"` has no `string` ARM (flattening `Kind` reaches its LITERALS),
// so it stays the three-atom litunion and every atom must remain reachable.
function three(n: i32): R {
  if n == 0 { return "a" }
  if n == 1 { return "b" }
  "err"
}

// The collapse must survive the `null` niche: `string | "err" | null` is `string?`.
function nullable(n: i32): string | "err" | null {
  if n == 0 { return null }
  if n == 1 { return "err" }
  "ok"
}

print(ret(0))
print(ret(1))
print(param("err"))
print(param("ok"))
print(numI())
print(numF())
print(viaAlias())

// `is <literal>` over a COLLAPSED arm is a VALUE test — it means `== "err"` with narrowing.
const b0 = box(0)
if b0 is "err" { print("box-err") } else { print("box-num") }
const b1 = box(1)
if b1 is "err" { print("box-err") } else { print("box-num") }

// All three atoms of the un-collapsed litunion stay distinguishable.
let i = 0
while i < 3 {
  const r = three(i)
  if r is "a" {
    print("a")
  } else {
    if r is "b" { print("b") } else { print("e") }
  }
  i = i + 1
}

let j = 0
while j < 3 {
  const v = nullable(j)
  if v == null { print("N") } else { print(v) }
  j = j + 1
}
