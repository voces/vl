// @run
// @log x
// @log x
// @log x
// @log x
// @log x
// @log x
// @log inline-x
// @log inline-x
// @log inline-x
// @log local-y
// @log local-y
// @log local-y
// @log atom-x
// @log atom-x
// @log atom-x
// @hint redundant type annotation: `r` is inferred as `A`
// @hint redundant type annotation: `s` is inferred as `{f: A}`
// @hint redundant type annotation: `xs` is inferred as `A[]`
// CONTRACT: a literal-union value in the STRING rep, narrowed to an alias, may be CONSUMED
// at every ATOM-typed destination — an annotated local, a `K` parameter, a `K` struct field,
// a `K[]` element, a `K` return, and an assignment to a `K` local.
//
// WHY IT IS A FIXTURE. A litunion has two reps and `nodeTyIsLitUnionAlias` decides which: a
// registered alias NAME interns as an i32 ATOM, while an un-named one — the FLATTENED
// `A | B`, and the inline spelling — stays a `(ref $array)` STRING at `RC_ROOT` and
// `RC_FN_PARAM`. Narrowing crosses between them: `if u is A { const r: A = u }` rebinds a
// string-repped `u` to `A`, whose slot is an atom. There was no conversion, so the store was
// a `local.set` of a `(ref $array)` into an `i32` local — INVALID WASM with `vl check
// --codegen` rc 0, at all six destinations and for all three string-repped spellings
// (a param, a local, the inline union).
//
// The narrowing is a `select` tower over string equality — `emitAtomToStr`'s inverse — and
// it re-reads the value once per member rather than stashing it, so it reserves no scratch
// frame and no scan has to agree with it.
//
// THE CONTROL is `atomForms`: the identical consumption over a receiver that is ALREADY an
// atom (`u: A`), which must keep lowering to the plain i32 copy it always did.

type A = "x" | "y"
type B = "z" | "w"
type SA = { f: A }

function takesA(k: A) { print(k) }
function retA(k: A): A { return k }

// A string-repped PARAM receiver — the flattened `A | B` carries no alias of its own.
function paramForm(u: A | B) {
  if u is A {
    const r: A = u // an annotated local slot
    print(r)
    takesA(u) // a `K` parameter
    const s: SA = { f: u } // a `K` struct field
    print(s.f)
    const xs: A[] = [u] // a `K[]` element
    print(xs[0])
    print(retA(u)) // a `K` return, through a `K` argument
    let m: A = "y"
    m = u // an assignment to a `K` local
    print(m)
  }
  0
}

// The INLINE spelling — the same rep by the same rule (no alias of its own).
function inlineForm(u: ("x" | "y") | ("z" | "w")) {
  if u is A {
    const r: A = u
    print("inline-" + r)
    takesA2(u)
    const xs: A[] = [u]
    print("inline-" + xs[0])
  }
  0
}

function takesA2(k: A) { print("inline-" + k) }

// A string-repped LOCAL receiver.
function localForm() {
  const u: A | B = "y"
  if u is A {
    const r: A = u
    print("local-" + r)
    takesA3(u)
    const s: SA = { f: u }
    print("local-" + s.f)
  }
  0
}

function takesA3(k: A) { print("local-" + k) }

// CONTROL — an ATOM-repped receiver. The same consumption sites, and no tower: the value is
// already the interned id every one of these slots wants.
function atomForms(u: A) {
  if u is A {
    const r: A = u
    print("atom-" + r)
    takesA4(u)
    const xs: A[] = [u]
    print("atom-" + xs[0])
  }
  0
}

function takesA4(k: A) { print("atom-" + k) }

paramForm("x")
inlineForm("x")
localForm()
atomForms("x")
