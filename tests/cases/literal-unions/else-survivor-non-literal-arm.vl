// @run
// @log 2
// @log 4
// @log 2.5
// The else of `x is "a"` over `"a" | T` narrows to the one non-literal arm, and a list, a
// closure and an f64 survivor are each used at that arm's type: a length read, a call, a sum.
function f(k: i32): "a" | i32[] {
  if k == 0 { return "a" }
  [k, 2]
}
const x = f(3)
if x is "a" { print("lit") } else { print(x.length) }
function g(k: i32): "a" | (() => i32) {
  if k == 0 { return "a" }
  () => k
}
const y = g(4)
if y is "a" { print("lit") } else { print(y()) }
function h(k: i32): "a" | f64 {
  if k == 0 { return "a" }
  1.5
}
const z = h(4)
if z is "a" { print("lit") } else { print(z + 1.0) }
