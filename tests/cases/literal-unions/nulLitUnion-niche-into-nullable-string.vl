// @run
// @log ka
// @log ka
// @log ka
// @log kb
// @log ka
// @log N
// @log N
// @log N
// @log N
// D3140: a `K | null` niche delivered to a `string | null` slot widens: the `-1` sentinel is the
// null ref and any other id its member string. Every atom-widening position takes it, at the
// let, the call argument, the field construct, the return and the list element, both values.
type K = "ka" | "kb"
type Box = { v: string | null }

function widen(k: K | null): string | null { return k }
function take(s: string | null) {
  if s != null { print(s) }
}

function main() {
  const k: K | null = "ka"
  const s: string | null = k
  if s != null { print(s) }
  take(k)
  const b: Box = { v: k }
  if b.v != null { print(b.v) }
  const w = widen("kb")
  if w != null { print(w) }
  const ns = ["a", k]
  if ns[1] != null { print(ns[1]) }
  const z: K | null = null
  const zs: string | null = z
  if zs == null { print("N") }
  const zb: Box = { v: z }
  if zb.v == null { print("N") }
  const zw = widen(null)
  if zw == null { print("N") }
  const zn = ["a", z]
  if zn[1] == null { print("N") }
}
main()
