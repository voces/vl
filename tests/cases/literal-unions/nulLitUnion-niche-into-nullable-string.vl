// @run
// @log ka
// @log ka
// @log ka
// @log kb
// @log none
// A `K | null` niche flowing into a nullable string slot, un-narrowed: the widening maps the
// `-1` sentinel to `null` and a member id to its string, at the let, the call argument, the
// field construct and the return (D3198).
type K = "ka" | "kb"
type Box = { v: string | null }

function widen(k: K | null): string | null { return k }
function take(s: string | null) {
  if s != null { print(s) }
}

function main() {
  const k: K | null = "ka"
  const s: string | null = k
  if s != null { print(s) }
  take(k)
  const b: Box = { v: k }
  if b.v != null { print(b.v) }
  const w = widen("kb")
  if w != null { print(w) }
  const kn: K | null = null
  const sn: string | null = kn
  print(sn ?? "none")
}
main()
