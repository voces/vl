// @run
// @log aa
// @log F
// @log bb
// @log aa
// @log aa
// @log bb
// @log aa
// THE MIXED-UNION PRESERVE, PINNED BY NAME (owner ruling 2026-07-29, REVERSING the
// 2026-07-28 soften this file was minted to pin). *"I'm reverting the softening. `K | f64`
// should be preserved as `K | f64` (or flattened to the constituent parts of `K | f64`).
// Softening to a string is just wrong as I see it."* So a string-litunion ALIAS standing
// as a MEMBER of a union keeps its alias name — `K | f64` is `K|f64` — and BOTH producers
// say so: `tyToEmitNameGo`'s union arm regroups the flattened literal run into its
// registered alias, and `canonEmitNameAt`'s union arm carries the mirror of that rule
// (`mixedUnionLitAliasRegroup`) so the ANNOTATION spelling matches the RENDER.
//
// THE RULE IS LIVE HERE, MEASURED BY POISON RATHER THAN CLAIMED. Suffixing CANON's
// regrouped alias (`KZZ`) moves this file off rc 0 with fifteen named corpus files for
// company; deleting either EMITTER leg (`canonLitUnionArms`'s preserve, the arm-atom
// admission below) moves it too. See the 2026-07-29 sections of
// `docs/internals/destringify-types-program.md`.
//
// THE FOUR KEEP POSITIONS ARE STILL NOT THIS RULE, and go2 holds three of them: in an
// array ELEMENT, a struct FIELD, a map VALUE and a function RESULT a PURE litunion alias
// reps as the interned i32 ATOM and both producers have always preserved it
// (`ctxKeepsLitUnion`). The map-value arm is left out because a `{[string]: K}` READ is
// `K | null`, whose narrow is a separate open gap.
//
// `tyToNominalName` PRESERVES the alias too, and under this ruling that is AGREEMENT
// rather than the fork it was: all three producers of the emitter's vocabulary now spell
// this union the same way, which takes the census's Lsoft class to zero on B1, B2 AND B3
// (#1296 could only reach B1, and its nominal half was blocked by `IsExpr.isVariant`).
//
// THE REF-LIST ELEMENT IS THE THIRD AND FOURTH PRODUCER OF THIS VOCABULARY, and go3/go4
// pin both. `emit_classify.canonLitUnionArms` — the emitter's own copy of the soften rule
// — used to re-widen the ELEMENT name while the union ROW registered under the preserved
// annotation, so the box lookup missed a row it had minted itself (go3). Deleting that
// re-widening is necessary and NOT sufficient: with the element preserved, the arm scanner
// `unionRefArrayArmSlotForElemAtom` compares a literal's probed atom (`"string"`) against
// the arm's STORED element atoms, which now read `K`, so a list literal flowing into an
// outer union stopped finding its ref-array arm at all (go4). Both legs ship here.
type K = "aa" | "bb"

function mixed(n: i32): K | f64 {
  if n > 0 { return "aa" }
  return 2.5
}
function go1() {
  const v = mixed(1)
  if v is K { print(v) } else { print("OTHER") }
  // The f64 arm is asserted by its BRANCH, not by printing the narrowed value: `print` of
  // the f64 arm of a value union is a separate pre-existing emit gap (invalid wasm on
  // master and on this build alike), and this file is not its witness.
  const w = mixed(0)
  if w is K { print("K") } else { print("F") }
}
go1()

function elemOf(): K[] { return ["bb"] }
function fieldOf(): { f: K } { return { f: "aa" } }
function resOf(): () => K {
  const f = (): K => "aa"
  return f
}
function go2() {
  const e = elemOf()
  print(e[0])
  const s = fieldOf()
  print(s.f)
  const r = resOf()
  const rv = r()
  print(rv)
}
go2()

// A mixed union standing as a ref-list ELEMENT: the element union's box row is registered
// under the PRESERVED spelling (`K|f64`), so the `is K` test must query it under that same
// spelling. Restoring `canonLitUnionArms`'s soften re-widens the stored element name to
// `string|f64` and this narrow raises "union box atom test on a union with no recorded
// members".
function elems(): (K | f64)[] { return ["bb", 2.5] }
function go3() {
  const xs = elems()
  const v = xs[0]
  if v is K { print(v) } else { print("OTHER") }
}
go3()

// The same element union as an ARM of an outer union, fed by a list LITERAL. The literal
// classifies itself as a scalar `string[]`, so it only reaches the arm's box-element build
// through `unionRefArrayArmSlotForElem` — which matches the probed atom `"string"` against
// the arm's stored element atoms. With the alias preserved those read `K`, and without the
// R3 boxed-member leg the arm is invisible and the literal falls to the value-atom ladder.
function go4() {
  const u: (K | f64)[] | {w: i32} = ["aa", 2.5]
  if u is (K | f64)[] {
    const e = u[0]
    if e is K { print(e) } else { print("OTHER") }
  } else {
    print("OTHER")
  }
}
go4()
