// @run
// @log aa
// @log F
// @log bb
// @log aa
// @log aa
// THE MIXED-UNION PRESERVE, PINNED BY NAME (owner ruling 2026-07-29, REVERSING the
// 2026-07-28 soften this file was minted to pin). *"I'm reverting the softening. `K | f64`
// should be preserved as `K | f64` (or flattened to the constituent parts of `K | f64`).
// Softening to a string is just wrong as I see it."* So a string-litunion ALIAS standing
// as a MEMBER of a union keeps its alias name — `K | f64` is `K|f64` — and BOTH producers
// say so: `tyToEmitNameGo`'s union arm regroups the flattened literal run into its
// registered alias, and `canonEmitNameAt`'s union arm carries the mirror of that rule
// (`mixedUnionLitAliasRegroup`) so the ANNOTATION spelling matches the RENDER.
//
// THE RULE IS LIVE HERE, MEASURED BY POISON RATHER THAN CLAIMED. Two sabotages, one per
// producer: suffixing CANON's regrouped alias (`KZZ`) and suffixing the RENDERER's each
// move this file off rc 0, with named corpus company in both cases — see the 2026-07-29
// section of `docs/internals/destringify-types-program.md`.
//
// THE FOUR KEEP POSITIONS ARE STILL NOT THIS RULE, and go2 holds three of them: in an
// array ELEMENT, a struct FIELD, a map VALUE and a function RESULT a PURE litunion alias
// reps as the interned i32 ATOM and both producers have always preserved it
// (`ctxKeepsLitUnion`). The map-value arm is left out because a `{[string]: K}` READ is
// `K | null`, whose narrow is a separate open gap.
//
// `tyToNominalName` PRESERVES the alias too, and under this ruling that is AGREEMENT
// rather than the fork it was: all three producers of the emitter's vocabulary now spell
// this union the same way, which takes the census's Lsoft class to zero on B1, B2 AND B3
// (#1296 could only reach B1, and its nominal half was blocked by `IsExpr.isVariant`).
//
// WHAT THIS FILE DOES NOT PIN, AND THE REASON IS FILED: a mixed union standing as a
// ref-list ELEMENT (`(K | f64)[]`) still forks, because `emit_classify.canonLitUnionArms`
// — the emitter's OWN copy of the soften rule — re-widens the element name while the
// union ROW is registered under the preserved annotation. That is the emitter half of this
// ruling and it is filed with its exact diff; four corpus files are red on this branch
// because of it.
type K = "aa" | "bb"

function mixed(n: i32): K | f64 {
  if n > 0 { return "aa" }
  return 2.5
}
function go1() {
  const v = mixed(1)
  if v is K { print(v) } else { print("OTHER") }
  // The f64 arm is asserted by its BRANCH, not by printing the narrowed value: `print` of
  // the f64 arm of a value union is a separate pre-existing emit gap (invalid wasm on
  // master and on this build alike), and this file is not its witness.
  const w = mixed(0)
  if w is K { print("K") } else { print("F") }
}
go1()

function elemOf(): K[] { return ["bb"] }
function fieldOf(): { f: K } { return { f: "aa" } }
function resOf(): () => K {
  const f = (): K => "aa"
  return f
}
function go2() {
  const e = elemOf()
  print(e[0])
  const s = fieldOf()
  print(s.f)
  const r = resOf()
  const rv = r()
  print(rv)
}
go2()
