// @check
// @error cannot assign string to 'l0' of type "#lu0"
// @error cannot assign string to 'l1' of type "a$m1"
// A string-literal type is reported as written, even when its text spells a hidden
// inline-union alias or a module-merge suffix (D11850).
function pick(u: "x" | "y"): i32 {
  if u == "x" { return 1 }
  2
}
print(pick("x"))
const l0: "#lu0" = "c"
const l1: "a$m1" = "c"
print(l0)
print(l1)
