// @run
// @log a
// @log none
// @log b
// @log aa
// @log b
// A literal-union atom handed to a function VALUE's `string | null` parameter widens to its
// member string, as it does at a direct call (D3189).
type K = "a" | "b"
const f = (x: string | null) => x ?? "none"
const k: K = "a"
print(f(k))
const n: K | null = null
print(f(n))
const j: K | null = "b"
print(f(j))
const two = (x: string | null, y: string) => (x ?? "none") + y
print(two(k, k))
function g(h: (string | null) => string) {
  const k2: K = "b"
  print(h(k2))
}
g((x: string | null) => x ?? "z")
