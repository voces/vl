// @run
// @log a
// @log null
// @log b
// @log a
// @log null
// @log a
// @log null
// A valued `if` joining a `null` arm with a member string, delivered to a `K | null` return or
// binding, types each non-null arm at `K` and the join at `K | null`.
type K = "a" | "b"
function g(c: i32, k: K): K | null {
  return if c == 0 { k } else if c == 1 { null } else { "a" }
}
function h(c: i32): K | null {
  return if c == 1 { null } else { "a" }
}
function m(c: i32, k: K): K | null {
  const r: K | null = if c == 0 { k } else if c == 1 { null } else { "a" }
  return r
}
print(g(2, "b"))
print(g(1, "b"))
print(g(0, "b"))
print(h(2))
print(h(1))
print(m(2, "b"))
print(m(1, "b"))
