// @error return type mismatch: expected K, got string — `"z"` is not one of K: "x" | "y"
// @error return type mismatch: expected K | null, got string — `"z"` is not one of K: "x" | "y"
// @error cannot assign () => string to 'ha' of type () => "a"
// @error return type mismatch: expected K, got string — `"w"` is not one of K: "x" | "y"
// A lambda adopts a string literal union, or one string literal, only when every value it
// returns is a member: an early `return` outside it refuses as a non-member tail does (D9520).
type K = "x" | "y"
const c = true
const h: () => K = () => {
  if c { return "z" }
  "y"
}
const hn: () => K | null = () => {
  if c { return "z" }
  "y"
}
const ha: () => "a" = () => {
  if c { return "b" }
  "a"
}
function run(f: () => K) { print(f()) }
run(() => {
  if c { return "w" }
  "x"
})
print(h())
print(hn())
print(ha())
