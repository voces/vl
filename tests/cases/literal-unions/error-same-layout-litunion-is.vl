// @check
// @error `is` check type 'T' is not a variant of 1 | 2 | null
// The NARROWING half. `T` and `X` share a representation but are disjoint literal sets, so
// `x is T` can never be true — and VL rejects it rather than folding it to a constant false.
// Pinned because the rep layer's shared registry entry would, if consulted here, make the two
// look like the same union and admit the check.
type T = 7 | 9 | null
type X = 1 | 2 | null

function f(x: X): i32 {
  if x is T { return 111 }
  222
}

print(f(1))
