// @check
// @warning `is` check type 'T' is not a variant of 1 | 2 | null, so this test is always false here
// @warning this branch can never run (its `is` test can never match)
// @hint redundant type annotation: `f` is inferred as `i32` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// The NARROWING half. `T` and `X` share a representation but are disjoint literal sets, so
// `x is T` can never be true: a warning, and the test folds to a constant false (D16047).
// Pinned because the rep layer's shared registry entry would, if consulted here, make the two
// look like the same union and admit the check.
type T = 7 | 9 | null
type X = 1 | 2 | null

function f(x: X): i32 {
  if x is T { return 111 }
  222
}

print(f(1))
