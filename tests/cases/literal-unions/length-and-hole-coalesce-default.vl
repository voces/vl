// @run
// @log 2
// @log 1
// @log 2
// @log null
// @log a
// @log a
// @log 2
// A string-literal union's `.length` is its member's, and a `??` over a hole parameter pinned at
// `K | null` keeps the union for a member default (D3423).
type K = "a" | "bb"
const k: K = "bb"
print(k.length)
function f(x: K | null) { print((x ?? "a").length) }
f(null)
f("bb")
function g<T>(a: T, b: T, c: boolean) {
  const r = if c { a ?? "a" } else { b }
  print(r)
}
const u: K | null = "a"
const w: K | null = null
g(u, w, false)
g(u, w, true)
g(w, u, true)
function gl<T>(x: T) { print(x.length) }
gl(k)
