// @run
// @log true
// @log false
// @log all S
// @log not all
// @log true
// @log C
// @log D
// @log b
// @log true
// @log false
// @log true
// @log true
// A test against string literals that a claimed function asks legacy for (`emitStrEqLit`): a
// list's `is` over a literal union, a record arm told by its literal field, and `as!` / `as?` to a
// literal arm. The literal is written as `emitExpr`'s literal arm writes it. Each position is its
// own function.

type S = "a" | "b"
function listReturned(v: string[]) { return v is S[] }
print(listReturned(["a", "b"]))
print(listReturned(["a", "c"]))

function listCondition(v: string[]) {
  if v is S[] { print("all S") } else { print("not all") }
}
listCondition(["b"])
listCondition(["x"])

function show(b: boolean) { print(b) }
function listArgument(v: string[]) { show(v is S[]) }
listArgument(["a"])

type C = { v: "a" | "b" | null }
type D = { v: string }
function armReturned(u: C | D) {
  if u is C { return "C" }
  return "D"
}
print(armReturned({ v: "a" }))
print(armReturned({ v: "zz" }))

function mk(k: i32): S | i32 {
  if k == 0 { return 7 }
  if k == 1 { return "a" }
  return "b"
}
function asBang(k: i32): S { return mk(k) as! S }
print(asBang(2))
function asQuestion(k: i32) {
  const o = mk(k) as? S
  print(o == null)
}
asQuestion(0)
asQuestion(1)

function inLambda(v: string[]) {
  const f = () => v is S[]
  print(f())
}
inLambda(["b", "a"])

print(["a"] is S[])
