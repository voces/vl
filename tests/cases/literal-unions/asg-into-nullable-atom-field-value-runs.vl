// @run
// @log zz
// @log ww
// @log ww
// @log ww
// @log zz
// @log zz
// @log zz
// @log zz
// @log null
// @log ww
// An assignment to a `K | null` field or element used as a value is the atom of the member
// written, widened to its string where it is delivered as one: a return, an annotated result, a
// `const`, `print`, of a literal, a call or a nullable value (D16343).
type K = "ww" | "zz"
type R = { k: K | null }
function set(r: R) { return r.k = "zz" }
print(set({ k: null }))
const r: R = { k: null }
print(r.k = "ww")
print(r.k)
function pick(b: boolean): K {
  return if b { "ww" } else { "zz" }
}
function fromCall(r: R, b: boolean) { return r.k = pick(b) }
print(fromCall({ k: null }, true))
print(fromCall({ k: "ww" }, false))
function viaConst(r: R) {
  const v = r.k = "zz"
  return v
}
print(viaConst({ k: null }))
function annotated(r: R): K | null { return r.k = "zz" }
print(annotated({ k: null }))
const xs: (K | null)[] = [null]
function elem() { return xs[0] = "zz" }
print(elem())
function fromNullable(r: R, v: K | null) { return r.k = v }
print(fromNullable({ k: "ww" }, null))
print(fromNullable({ k: null }, "ww"))
