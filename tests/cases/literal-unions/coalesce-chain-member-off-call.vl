// @run
// @log b
// @log a
// @log b
// @log a
// @log 4
// @log 7
// @log b
// @log a
// A `??` chain over a literal union whose inner link is a field read off a call: the
// re-associated inner link declares the local it reads, in a function, through a generic box,
// at the i32 neighbour, and at the top level.
type K = "a" | "b"
type B = { v: K | null }
type Box<T> = { v: T | null }
type I = { v: i32 | null }
function boxK(x: K | null): B { return { v: x } }
function boxG<T>(x: T | null): Box<T> { return { v: x } }
function boxI(x: i32 | null): I { return { v: x } }
function mkK(n: i32): K | null { return if n == 1 { "b" } else { null } }
function mkI(n: i32): i32 | null { return if n == 1 { 4 } else { null } }
function lit(n: i32, r: K | null) { print(r ?? boxK(mkK(n)).v ?? "a") }
function gen(n: i32, r: K | null) { print(r ?? boxG(mkK(n)).v ?? "a") }
function num(n: i32, r: i32 | null) { print(r ?? boxI(mkI(n)).v ?? 7) }
lit(1, null)
lit(0, null)
gen(1, null)
gen(0, null)
num(1, null)
num(0, null)
const r: K | null = null
print(r ?? boxK(mkK(1)).v ?? "a")
print(r ?? boxK(mkK(0)).v ?? "a")
