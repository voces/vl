// @run
// @log b
// @log none
// @log a
// @log none
// @log a
// @log n
// A nullable literal field read where a plain string is wanted is first narrowed or coalesced
// past its null; it is never the plain atom field read that its consumer decodes.
type R = { k: "a" | "b" | null }
type S = { k: "a" | null }
function f(r: R): string {
  if r.k != null { return r.k }
  return "none"
}
function g(s: S): string {
  if s.k != null { return s.k }
  return "none"
}
function h(s: S): string { return s.k ?? "none" }
function opt(s: S) {
  const t: string | null = s.k
  print(t ?? "n")
}
print(f({ k: "b" }))
print(f({ k: null }))
print(g({ k: "a" }))
print(g({ k: null }))
print(h({ k: "a" }))
opt({ k: null })
