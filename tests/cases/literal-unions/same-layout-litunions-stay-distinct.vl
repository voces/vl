// @run
// @log 0
// @log 1
// SAME LAYOUT, DIFFERENT TYPE — the contract the rep layer must not leak through.
//
// `1 | 2 | null` and `7 | 9 | null` lower to the SAME representation: canon softens both
// numeric literal unions to their base scalar, so both are an `i32|null` box and both file
// under the same emitter registry entry. That sharing is deliberate — identical machine code
// should share a slot — but it must stay INSIDE the rep layer.
//
// This fixture pins the three places it would be observable if it leaked. The two rejects are
// `error-*` fixtures beside this one; what runs here is the narrowing that must stay honest.
//
// `v is One` over `7 | 1` is a MEMBERSHIP test on the precise literal set, not on the shared
// i32 layout: `7` is not `1` even though both are i32s in the same slot.
type One = 1

function litIsOne(v: 7 | 1) {
  if v is One { return 1 }
  0
}

print(litIsOne(7))
print(litIsOne(1))
