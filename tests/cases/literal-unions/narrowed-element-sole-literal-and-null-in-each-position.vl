// @run
// @log y
// @log y!
// @log true
// @log x
// @log TTF
// @log FFT
// @log true
// An atom list's element narrowed to one literal is that literal's string, decoded from the atom:
// passed at the literal, concatenated, compared and returned. A `boolean | null` element narrowed
// to `null` is read for its effect beside a compare with another nullable, on either side.
type K = "x" | "y"
function onlyY(v: "y") { return v }
function onlyX(v: "x") { return v }
function c(v: boolean) { return if v { "T" } else { "F" } }
function pick(ks: K[]) {
  if ks[0] == "y" { return onlyY(ks[0]) }
  return onlyX(ks[0])
}
function cat(ks: K[]) {
  if ks[0] == "y" { print(ks[0] + "!") }
}
function same(ks: K[]) {
  if ks[0] == "y" { print(onlyY(ks[0]) == "y") }
}
function pb(k: i32): boolean | null {
  if k == 0 { return null }
  return true
}
function nul(k: i32, zi: i32 | null) {
  const a: (boolean | null)[] = [pb(k)]
  if a[0] is boolean { return "b" }
  return c(a[0] == zi) + c(zi == a[0]) + c(a[0] != zi)
}
print(pick(["y"]))
cat(["y"])
same(["y"])
print(pick(["x"]))
print(nul(0, null))
print(nul(0, 7))
print(nul(1, null) == "b")
