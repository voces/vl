// @run
// @log 2
// @log 2
// @log null
// @log c2
// @log h2
// @log 2
// @log 2
// @log 2
// @log 2
// @log 2
// @log 2
// @log 2
// @log null
// @log c2
// @log h2
// @log 2
// @log 2
// @log 2
// @log 2
// Q58 position sweep: a read of an `i32 | AB` map narrowed by the else of `is AB` is `i32 | null`,
// the map's box held at that smaller union, in every delivery position, in a function and at the
// top level. A `??` operand is not among them: that read is typed at the member, not the box.
import { toString } from "std:fmt"

type AB = "a" | "b"
type R = { v: i32 | null }
function on(x: i32 | null) { return x ?? -1 }
function un(x: i32 | AB | null) { return x }
function str(x: i32 | null) {
  return if x == null { "null" } else { toString(x) }
}
function id(x: i32 | null): i32 | null { return x }
function back(p: { [string]: i32 | AB }): i32 | null {
  if p["n"] is AB { return null } else { return p["n"] }
}

function f(p: { [string]: i32 | AB }) {
  if p["n"] is AB {
    print(0)
  } else {
    print(on(p["n"]))
    print(un(p["n"]))
  }
  if p["z"] is AB { print(0) } else { print(str(p["z"])) }
  if p["n"] is AB {
    print(0)
  } else {
    print("c" + str(p["n"]))
    print("h\{str(p["n"])}")
    print(on(id(p["n"])))
    const c = p["n"]
    print(on(c))
    const v = if p["n"] != null { p["n"] } else { null }
    print(on(v))
    const r: R = { v: p["n"] }
    print(on(r.v))
  }
  print(on(back(p)))
}

const m: { [string]: i32 | AB } = Map()
m["k"] = "b"
m["n"] = 2
f(m)
if m["n"] is AB {
  print(0)
} else {
  print(on(m["n"]))
  print(un(m["n"]))
}
if m["z"] is AB { print(0) } else { print(str(m["z"])) }
if m["n"] is AB {
  print(0)
} else {
  print("c" + str(m["n"]))
  print("h\{str(m["n"])}")
  const c = m["n"]
  print(on(c))
  const v = if m["n"] != null { m["n"] } else { null }
  print(on(v))
  const r: R = { v: m["n"] }
  print(on(r.v))
}
print(on(back(m)))
