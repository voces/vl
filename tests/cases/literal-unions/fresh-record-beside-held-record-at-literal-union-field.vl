// @run
// @log 2
// @log 2
// @log 2
// @log b
// @log 2
// @log b
// @log b
// @log a
// @log b
// @log a
// @log b
// A fresh record literal joined beside a held record adapts to the held record's type when its
// fields fit it, as a numeric literal adapts to its sibling (owner ruling 4.3): in a list, an
// `if` and a `match`, with a destination or without one (D16435).
type K = "a" | "b"
type RA = { k: K }
type H = { xs: RA[] }

function count(xs: RA[]) { return xs.length }
function off() { return false }
function two() { return 2 }

const ra: RA = { k: "a" }
const c = off()
const s = two()

const ys: RA[] = [ra, { k: "b" }]
print(ys.length)
print(count([{ k: "b" }, ra]))
const h: H = { xs: [ra, { k: "b" }] }
print(h.xs.length)
const zs = [ra, { k: "b" }]
zs.push({ k: "a" })
print(zs[1].k)
const rs: RA[] = zs
print(rs.length - 1)
const y1: RA = if c { ra } else { { k: "b" } }
print(y1.k)
const y2 = if c { ra } else { { k: "b" } }
print(y2.k)
const y3 = if !c { ra } else { { k: "b" } }
print(y3.k)
const m1 = match s {
  1 => ra
  _ => { k: "b" }
}
print(m1.k)
const m2: RA = match s {
  1 => { k: "b" }
  _ => ra
}
print(m2.k)
let w = ra
w = if c { { k: "a" } } else { ra }
ys[0].k = "b"
print(ra.k)
