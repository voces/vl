// @check
// @error print of a union value ("a" | 1) is type-valid but not yet supported by codegen
// CONTRACT (must-error): every member is a LITERAL, but they soften to DIFFERENT base
// scalars (`"a"` → string, `1` → i32), so the union still boxes — `canonEmitName` names it
// `string|i32`. Membership in the literal set is not what decides the rep; the set of BASES
// is. The same-base sibling (`print-same-base-literal-union-runs.vl`) prints fine.
//
// Before D-LITPRINT this built a module that failed to parse as WebAssembly.
const v: "a" | 1 = 1
print(v)
