// @run
// @log ka
// @log ia
// @log 232
// A literal-union struct FIELD pushed into a `string[]`. The field's rep is the interned i32
// ATOM id and the list's backing slot is a `(ref null $aTypeIdx)`, so the value has to WIDEN to
// its member string on the way in.
//
// It did not, and the store was `expected (ref $type), found i32` — check-clean invalid wasm,
// `vl check --codegen` rc 0. This file was `xfail-miscompile-litunion-field-into-string-list.vl`
// and makes the kind's documented trip to `@run`.
//
// WHY THE FIELD ALONE. The same value in every other binding class already widened — a LOCAL, a
// PARAMETER, a plain `string` return, `"v=" + v`, a `string` field store, a `string` param
// argument, an `==`. `emitPush` seeds its element emit from the RECEIVER's element type
// (`isLitArr`, `isNbArr`, `isNlluArr`, `isNsArr`) and not one of those seeds asks whether the
// VALUE is an atom, so a `string[]` receiver took the plain emit and the atom went in raw.
//
// THE THIRD ARM IS THE RESERVATION TWIN, and it fails differently. `emitAtomToStr` stages the
// atom id in the string-op scratch frame, which `emit_classify`'s scan reserves. Adding the
// emit arm WITHOUT teaching the scan leaves the frame unreserved and the widen writes to a
// local the vector never declared — a different invalid wasm, and one that only shows up in a
// function whose ONLY string work is the push. `fill` is that function: it returns an i32 sum
// and never prints or concatenates, so nothing else would reserve the frame for it.
//
// ARM 1 IS THE DEFECT; ARM 2 IS A CONTROL. Only the declared alias `K` reaches the field atom
// rep today — the inline `"ia" | "ib"` field is routed to the string rep by the field ladder, so
// arm 2 passes on master and is byte-identical before and after. It is here to pin that the fix
// does not disturb the spelling the ladder has NOT yet been widened to cover: widening that
// ladder is a net regression until sinks like this one are closed (B43), and arm 2 is what will
// start failing first if that order is ignored again.
type K = "ka" | "kb"
type R = { f: K }
type Inline = { f: "ia" | "ib" }

function fill(r: R) {
  const a = 11
  const b = 22
  const c = 33
  const d = 44
  const e = 55
  const xs: string[] = []
  xs.push(r.f)
  const g = 66
  return a + b + c + d + e + g + xs.length
}

function main() {
  const r: R = { f: "ka" }
  const xs: string[] = []
  xs.push(r.f)
  print(xs[0])

  const i: Inline = { f: "ia" }
  const ys: string[] = []
  ys.push(i.f)
  print(ys[0])

  print(fill(r))
}
main()
