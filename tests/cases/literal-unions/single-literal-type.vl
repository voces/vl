// @run
// @log world
// @log 7
// @log world
// @log 7
// @log world
// @log 7
// @log world
// @log world
// @log 7
// A SINGLE-member literal type (`"world"`, `7` — no `|`) reps as its BASE scalar: a string
// literal is a string ref, an int literal an i32/i64. This matches the softening `canonEmitName`
// applies to the annotation NAME (`litBaseName`), which the arena classifiers must AGREE with — a
// bare `TyLit` falling to the i32 default in `vtKindOfType` while its returned/passed VALUE emitted
// a string produced INVALID WASM ("expected i32, found (ref $type)"). Covered in every annotation
// position: return, param, let, field; inline AND aliased. (A string-atom litunion ALIAS
// `type K = "a"|"b"` stays the interned i32 atom — see atom-basics.vl.)

// return position — inline single literals
function helloR(): "world" { return "world" }
function sevenR(): 7 { return 7 }

// param position — inline single literals (the value flows through and back out)
function strP(x: "world"): string { return x }
function intP(x: 7): i64 { return x }

// aliased single literals — a `type W = "world"` / `type W = 7` alias
type WStr = "world"
type WInt = 7
function strAlias(): WStr { return "world" }
function intAlias(): WInt { return 7 }

// field position — a single-literal struct field
type Row = { w: "world" }

function go() {
  print(helloR())      // world
  print(sevenR())      // 7
  print(strP("world")) // world
  print(intP(7))       // 7

  const lx: "world" = "world"
  print(lx) // world
  const li: 7 = 7
  print(li) // 7

  const row: Row = { w: "world" }
  print(row.w) // world

  print(strAlias()) // world
  print(intAlias()) // 7
}

go()
