// @check
// @error return type mismatch: expected K, got string
// @error return type mismatch: expected J, got L
// @error cannot assign string to 'r' of type "ab"
// THE `==` HALF OF THE `is` LADDER, pinned beside it. `s is "aa"` NARROWS `s` to the one-member
// literal type; `s == "aa"` does not narrow at all, at either rep. That asymmetry is the whole
// reason the two spellings behave differently at an atom-typed destination, and it is worth a
// fixture because the two were once BOTH broken in opposite directions: `is` narrowed the type
// without narrowing the REP (check-clean invalid wasm, #1852 — see
// `narrowed-single-literal-rep-consumption.vl`), while `==` was rejected here. Fixing the `is`
// half must not quietly teach `==` to narrow, and teaching `==` to narrow later must not
// reintroduce the rep gap.
//
// `==` is a VALUE test with no proof attached — there is no discriminant machinery behind it
// (that is `is`, and A6b's proof-carrying narrowing) — so the refusal is the honest answer and
// the diagnostic is the ordinary type error at the USE, not a special case.

// ── a plain `string` receiver: `==` leaves it `string` ─────────────────────────────
type K = "aa" | "ab"
function fromStr(s: string): K {
  if s == "aa" { return s }
  return "ab"
}

// ── a litunion receiver: `==` leaves it the FULL union, not the matched member ─────
type L = "ba" | "bb"
type J = "ba"
function narrowMember(k: L): J {
  if k == "ba" { return k }
  return "ba"
}

// ── the CONTROL for the guard direction: a `string` cannot be re-bound as a literal ─
// This is what makes the `is` half's comparison-free lowering sound — a value typed `"ab"`
// provably holds `"ab"`, because the only way in is a real runtime test or a literal.
function noLaunder(s: string) {
  const r: "ab" = s
  print(r)
  0
}

print(fromStr("aa"))
print(narrowMember("ba"))
noLaunder("zz")
