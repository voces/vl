// A closure literal returning the one literal of a `() => "a"` function type adopts that
// result, as a declared `: "a"` return does (D7880).
type R = { f: () => "a" }

function one(_f: () => "a") { return 1 }
function call(f: () => "a"): string { return f() }
function g(): "a" { return "a" }
function wrap(): () => "a" { return () => "a" }
function useCb(f: (x: i32) => "a"): string { return f(1) }

print(one(() => "a"))
print(call(() => "a"))
const k: () => "a" = () => "a"
print(k())
const fs: (() => "a")[] = [g, () => "a"]
print(fs[1]())
const w = wrap()
print(w())
const r: R = { f: () => "a" }
print(call(r.f))
let m: () => "a" = g
m = () => "a"
print(m())
print(useCb((_x) => "a"))
// @hint Intentionally-unused parameter `_f`
// @hint Intentionally-unused parameter `_x`
// @hint redundant type annotation: `m` is inferred as `() => "a"`
// @log 1
// @log a
// @log a
// @log a
// @log a
// @log a
// @log a
// @log a
