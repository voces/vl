// @run
// @log z
// @log a
// @log null
// @log null
// A generic's returned join whose arm is a hole-typed `K | null` pin beside a string literal
// reserves the string-op frame in the instance.
type K = "a" | "b"
function g<KNT>(c: i32, kn: KNT) {
  return if c == 0 { "z" } else if c == 1 { kn } else { null }
}
const kn0: K | null = "a"
const knN: K | null = null
print(g(0, kn0))
print(g(1, kn0))
print(g(1, knN))
print(g(2, kn0))
