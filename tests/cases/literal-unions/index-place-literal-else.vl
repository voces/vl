// @run
// @log 11
// @log a!
// @log a!
// @log 1
// @log b
// @log one
// @log b!

// The else of a literal test on a list element reads the members left, unboxed, as the else
// of the same test on a binding does — for `is`, `==`, `!=` and a negated test alike.
type M = 1 | "a" | "b"

function only1(v: 1) { v + 10 }
function onlyAB(v: "a" | "b") { v + "!" }
function isElse(xs: M[]) {
  if xs[0] is 1 { print(only1(xs[0])) } else { print(onlyAB(xs[0])) }
}
function neThen(xs: M[]) {
  if xs[0] != 1 { print(onlyAB(xs[0])) }
}
function both(xs: M[]) {
  if xs[0] == 1 { print(xs[0]) } else { print(xs[0]) }
}
function negated(xs: M[]) {
  if !(xs[0] == 1) { print(onlyAB(xs[0])) } else { print("one") }
}

isElse([1])
isElse(["a"])
neThen(["a"])
both([1])
both(["b"])
negated([1])
negated(["b"])
