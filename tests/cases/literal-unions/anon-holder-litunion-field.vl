// @run
// @log red
// @log red
// @log red
// @log red
// @log red
// @log red
// @log red
// @log red

// D1757 — an INFERRED object literal minting a literal-union field. The anonymous row coded
// the field a union BOX while every reader lowers the interned ATOM, so any boundary between
// the projection and the read was check-clean invalid wasm. Every holder here is deliberately
// un-annotated, and no declared `{ it: Color }` type is in scope: a declared row with the same
// field set ADOPTS the literal and suppresses the anonymous mint, which hides the defect.
type Color = "red" | "green"

function mkval(): Color { return "red" }

function takeC(c: Color) { print(c) }

const srcBox = { it: mkval() }

// The row's own witness: an inferred return between the projection and the read.
function make() { return srcBox.it }
print(make())

// The annotated return, which the box could not satisfy either.
function makeAnn(): Color { return srcBox.it }
print(makeAnn())

// The argument boundary, annotated and as a hole parameter.
takeC(srcBox.it)

function takeHole(c) { print(c) }
takeHole(srcBox.it)

// A list element, whose element rep is the atom backing.
const xs = [srcBox.it]
print(xs[0])

// The boundaries that already ran, as controls: a direct print, a binding, and a compare
// against a member of the union — the atom's membership has to survive the mint for the
// compare to answer.
print(srcBox.it)

const held = srcBox.it
print(held)

if srcBox.it == "red" { print("red") } else { print("no") }
