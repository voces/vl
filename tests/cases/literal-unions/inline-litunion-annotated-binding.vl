// @run
// @log green
// @log green
// @log green
// @log green
// @log x
// @info `v` is never reassigned; use `const` instead of `let`
// @hint redundant type annotation: `v` is inferred as `"red" | "green"` — remove it to lean on inference
// @hint redundant type annotation: `v` is inferred as `"red" | "green"` — remove it to lean on inference
// @hint redundant type annotation: `k` is inferred as `"x" | "y"` — remove it to lean on inference

// D1752/D1196 — an INLINE literal-union annotation on a binding whose initializer is an atom.
// The cell was slotted as the atom only for a module global and only through the ALIAS
// spelling, so the inline spelling inside a frame fell to `checkLocalI32` and refused. No
// `type K = …` is declared here on purpose: an alias anywhere in the module registers the
// union's arena row, the inline spelling then resolves to that same row, and the defect
// disappears.
const srcArr: ("red" | "green")[] = ["green", "red"]

function fromListRead() {
  let v: "red" | "green" = srcArr[0]
  print(v)
}
fromListRead()

// `const` is the same cell, and a block one level in is the same frame.
function fromConstInBlock() {
  if 1 == 1 {
    const v: "red" | "green" = srcArr[0]
    print(v)
  }
}
fromConstInBlock()

// The store must still widen where the SLOT is a string: an atom initializing a `string`
// binding keeps its member-string widening, which is the arm the slot's own flag now gates.
function widensToString() {
  const s: string = srcArr[0]
  print(s)
}
widensToString()

// The un-annotated spelling, which always ran, as the control.
function unAnnotated() {
  const w = srcArr[0]
  print(w)
}
unAnnotated()

// D1196's own witness: an inline-annotated rebind of a unified discriminant field.
type K1 = "circle" | "round"
type A = { kind: K1, r: f64 }
type B = { kind: "x" | "y", r: f64 }

function f(n: i32): A | B {
  if n == 0 { return { kind: "circle", r: 1.0 } }
  return { kind: "x", r: 2.0 }
}

const b = f(1)
if b is B {
  const k: "x" | "y" = b.kind
  print(k)
} else {
  print("notB")
}
