// @run
// An `i64` receiver over an `i32`-based literal union compares at `i64`, through an alias and
// the inline spelling, as a parameter and a list element, true and false (D3658).
type U = 1 | 2
function f(e: i64) { e is U }
const e: i64 = 2
const xs: i64[] = [5, 1]
print(e is U)
print(e is 1 | 2)
print(f(1))
print(f(9))
print(xs[1] is U)
print(xs[0] is U)
// @log true
// @log true
// @log true
// @log false
// @log true
// @log false
