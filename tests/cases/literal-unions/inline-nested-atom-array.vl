// @run
// @log 1
// @log 2
// @log b
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// @log 0
// @log 1
// @log 2
// A NESTED inline literal-union array — `("a" | "b")[][]` — in every binding position,
// each PAIRED with its `K[][]` alias control on the adjacent line. The sibling
// `inline-atom-array.vl` pins the ONE-dimensional spelling; this is the nested twin, which
// that fix did not reach.
//
// WHY IT IS A FIXTURE. `canonEmitName` used to SOFTEN a bare inline literal union to its
// base scalar at every position, so this annotation rendered `string[][]` while the checker's
// arena still held `TyArray(TyArray(TyUnion[TyLit…]))`. The outer list's element ROW is
// interned from that NAME (`ensureRefElem` -> `rlInternName`), so the row was coded a
// STRING list while the literal built the interned-atom i32 wrapper: a type mismatch inside
// a global's constant expression, which wasmtime reports as `failed to parse WebAssembly
// module`, and a validation error at every other position. The canon pass now keeps the
// members (`litUnionPreserve`) wherever the renderer keeps a litunion ALIAS — array element,
// object field, map value, function result — so both spellings name one type and rep one way.
//
// The two spellings must also MEET: `takesAlias(gInline)` hands an inline-annotated value to
// a `K[][]` parameter. That line is the whole point — two structurally identical types with
// two reps is unsound in a structural language, and it is what a spelling-keyed intern row
// re-introduces if either column moves alone.

type K = "a" | "b"

const gInline: ("a" | "b")[][] = [["a", "b"]]
const gAlias: K[][] = [["a", "b"]]

type SInline = { xs: ("a" | "b")[][] }
type SAlias = { xs: K[][] }

function takesInline(xs: ("a" | "b")[][]) { print(xs.length) }
function takesAlias(xs: K[][]) { print(xs.length) }

function mkInline(): ("a" | "b")[][] { return [["a"]] }
function mkAlias(): K[][] { return [["a"]] }

function locals() {
  const xi: ("a" | "b")[][] = [["a"]]
  print(xi.length) // 1
  const xa: K[][] = [["a"]]
  print(xa.length) // 1

  // An INLINE-shape annotation whose field is the nested inline list.
  const si: { xs: ("a" | "b")[][] } = { xs: [["a"]] }
  print(si.xs.length) // 1
  const sa: { xs: K[][] } = { xs: [["a"]] }
  print(sa.xs.length) // 1

  // A DECLARED struct field.
  const di: SInline = { xs: [["a"]] }
  print(di.xs.length) // 1
  const da: SAlias = { xs: [["a"]] }
  print(da.xs.length) // 1

  // The INFERRED inner binding — the element read is a separate classifier from the list's
  // own slot, so it needs its own line.
  const inner = xi[0]
  print(inner.length) // 1

  // An EMPTY nested literal still has to build the i32 wrapper — and then take a PUSH of an
  // inner list, whose element backing is decided by the outer row the empty literal seeded.
  const ei: ("a" | "b")[][] = []
  print(ei.length) // 0
  ei.push(["a", "b"])
  print(ei.length) // 1
  print(ei[0].length) // 2
}

print(gInline.length) // 1
print(gInline[0].length) // 2
print(gInline[0][1]) // b
print(gAlias.length) // 1
takesInline([["a"]])
takesAlias([["a"]])
takesAlias(gInline) // the two spellings meet: one type, one rep
print(mkInline().length)
print(mkAlias().length)
locals()
