// @error cannot assign () => i32 to 'g' of type () => N
// @error cannot assign (N) => i32 to 'p' of type (k: i32) => i32
// The refused directions of D9382: an `i32` result is not a `1 | 2` one, and a function taking
// only `N` cannot be called with any `i32`.
type N = 1 | 2
const h: () => i32 = () => 3
const g: () => N = h
const q: (k: N) => i32 = (k: N) => k + 1
const p: (k: i32) => i32 = q
print(g() + p(3))
