// @error cannot assign () => i32 to 'g' of type () => N
// @error cannot assign (N) => i32 to 'p' of type (k: i32) => i32
// @error cannot assign () => N to 'w' of type () => i64
// The refused directions of D9382: an `i32` result is not a `1 | 2` one, a function taking
// only `N` cannot be called with any `i32`, and a function result does not widen to `i64`.
type N = 1 | 2
const h: () => i32 = () => 3
const g: () => N = h
const q: (k: N) => i32 = (k: N) => k + 1
const p: (k: i32) => i32 = q
const a: N = 2
const f: () => N = () => a
const w: () => i64 = f
print(g() + p(3))
print(w())
