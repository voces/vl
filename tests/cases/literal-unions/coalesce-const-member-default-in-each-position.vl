// @run
// @log k=zz
// @log k=yy
// @log zz
// @log yy
// @log zz
// @log k=zz
// @log k=zz
// @log zz
// @log qq!
// A `K | null` niche's `??` whose default is a `const` bound to a member literal is that member's
// atom: as a binding, an argument, a return and a print; beside a literal and a `K` default, and a
// non-member `const` default that makes the result a string.
type K = "zz" | "yy"
const Z = "zz"
const W = "qq"
const d: K = Z
function one(c: boolean): K { return if c { "yy" } else { "zz" } }
function name(k: K) { return "k=" + k }
function nul(c: boolean): K | null { return if c { null } else { one(true) } }
function asConst(c: boolean) {
  const r = nul(c) ?? Z
  return name(r)
}
function asRet(c: boolean) {
  const n = nul(c)
  return n ?? Z
}
print(asConst(true))
print(asConst(false))
print(asRet(true))
print(asRet(false))
const n0 = nul(true)
print(n0 ?? Z)
print(name(n0 ?? Z))
print(name(n0 ?? "zz"))
print(n0 ?? d)
print((n0 ?? W) + "!")
