// @emit-error literal-union string widening with no members
// A `K | null` NICHE value flowing into a nullable STRING slot. The niche's rep is the atom id
// OR the `-1` null sentinel in one i32, and the widening tower `emitAtomToStr` builds is a
// `select` chain over the MEMBER constants with no arm for `-1` — so the widen cannot express
// this value and the emitter refuses.
//
// SIX POSITIONS NOW REFUSE HERE, not the two this file was filed for. The `string | null`
// return and the `(string | null)[]` push came first; a nullable-string LET, CALL ARGUMENT and
// FIELD store joined them when those positions learned to widen. Every one asks
// `exprIsLitAtom`, so every one inherits its niche claim, and each was checked to land on the
// SAME refusal rather than on a quieter failure — `check --codegen` goes rc 0 -> rc 1 at all of
// them.
//
// THIS IS AN UPGRADE, NOT A REGRESSION, and the pin records which direction. Before the two
// nullable sinks were closed, this same program was ACCEPTED — `vl check --codegen` exited 0 —
// and produced invalid wasm at instantiation. That is the check-clean miscompile class this
// whole programme exists to remove. It now fails loudly at emit, with `check --codegen` rc 1.
// A loud refusal on a type-valid program is still a gap; it is a strictly better gap.
//
// WHY THE SINKS FIRE AT ALL. `exprIsLitAtom`'s FIRST line is
// `if exprNulLitUnion(exprIx, fnIx) { return true }` — it deliberately claims the nullable
// niche, because in a position that has NARROWED the value non-null the niche really does hold
// a plain atom. The return and push arms ask `exprIsLitAtom` without asking whether the value
// is still nullable HERE, so they inherit that claim in a position where it does not hold.
//
// Gating the arms on `!exprNulLitUnion` was considered and rejected: it sends this program back
// to the check-clean invalid wasm above, trading a loud failure for a silent one. The real fix
// is a `-1` arm in the widening tower — the niche's null sentinel lowering to the slot's null
// rather than to a member string — which is an emitter change of its own and is queued.
//
// THE CONTROL LIVES ELSEWHERE, deliberately: narrowing the niche non-null first yields a plain
// atom, which widens correctly, and that case is exercised in
// `litunion-field-nullable-string-sinks.vl` where it can actually RUN. It cannot be shown here —
// an `@emit-error` file emits nothing, so a control sharing the file would assert nothing. The
// pair together is what says the defect is the SENTINEL and not the niche.
// THE BODY ASSERTS THREE OF THE SIX, not one. An `@emit-error` file stops at the FIRST refusal,
// so extra positions here do not each get their own verdict — but a body carrying only the
// return position would leave the other five documented and untested, which is the "green file
// asserting nothing" failure this programme keeps finding. Each line below is a position that
// was separately confirmed to refuse identically when built alone.
type K = "ka" | "kb"
type Box = { v: string | null }

function widen(k: K | null): string | null { return k }
function take(s: string | null) { if s != null { print(s) } }

function main() {
  const k: K | null = "ka"
  const s: string | null = k
  if s != null { print(s) }
  take(k)
  const b: Box = { v: k }
  if b.v != null { print(b.v) }
  const w = widen("kb")
  if w != null { print(w) }
}
main()
