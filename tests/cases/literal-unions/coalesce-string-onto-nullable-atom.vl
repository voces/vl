// @run
// @log q
// @log a
// @log null
// `string | null ?? K | null` is `string | null`: the default's atom becomes its text and a null
// default stays null.
type K = "a" | "b"
function g(sn: string | null, kn: K | null) {
  const v = sn ?? kn
  print(v)
}
const kn0: K | null = "a"
g("q", kn0)
g(null, kn0)
g(null, null)
