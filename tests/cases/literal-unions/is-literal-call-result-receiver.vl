// @run
// @log true
// @log false
// @log true
// @log false
// @log true
// @log false
// @log true
// @log false
// @log true
// @log false
// @log true
// @log false
// @log true
// @log false
// @log true
// @log false
// @log false
// @log true
// @log false
// @log false
// `v is <literal>` over a boxed union whose receiver is a CALL — and over every place path
// ROOTED at one. The lowering reads the box twice (its TAG, then the PAYLOAD inside the
// tag-matched arm), so a receiver that is not a re-readable place is parked in a scratch
// slot at its first read and re-read out of the slot (`unionLitIsStashSlot`); before that
// it was a loud emit reject on a `vl check`-clean program.
//
// The RECEIVER SHAPE is the axis, because the refusal's own sentence said "non-binding"
// while the ablation said CALL: a struct-FIELD receiver and an ELEMENT receiver already
// ran, a `const` binding of the same call already ran, and parenthesising changed nothing.
// Each shape here asks the same question of a receiver that DOES hold the literal and of
// one that does not, so a fixture cannot pass by answering one constant.

type K = "a" | "b"
type S = { u: K | i32 }

function mk(n: i32): K | i32 {
  if n == 0 { return "a" }
  7
}

function pick(n: i32) { n }

function mkS(n: i32): S {
  if n == 0 { return { u: "a" } }
  { u: 7 }
}

function mkL(n: i32): (K | i32)[] {
  if n == 0 { return ["a"] }
  [7]
}

// A bare call, and the parenthesised spelling of it (the paren peel was never the bound).
print(mk(0) is "a")
print(mk(1) is "a")
print((mk(0)) is "a")
print((mk(1)) is "a")

// A call whose ARGUMENT is itself a call.
print(mk(pick(0)) is "a")
print(mk(pick(1)) is "a")

// A FIELD read and an ELEMENT read rooted at a call: `unionEqOperandOk` recurses into the
// receiver, so these were refused too even though the same reads off a BINDING ran.
print(mkS(0).u is "a")
print(mkS(1).u is "a")
print(mkL(0)[0] is "a")
print(mkL(1)[0] is "a")

// A CLOSURE call — the value-call ABI reaches the same seam.
const f = mk
print(f(0) is "a")
print(f(1) is "a")

// An element read off a PLACE whose SUBSCRIPT is a call: the subscript disqualifies the
// receiver by the same recursion.
const xs: (K | i32)[] = ["a", 7]
print(xs[pick(0)] is "a")
print(xs[pick(1)] is "a")

// EVERY ARM DISCRIMINATED, over the same call receiver: a fixture that only ever asks
// about the arm it constructed passes while `is` answers a constant.
function mk3(n: i32): K | i32 {
  if n == 0 { return "a" }
  if n == 1 { return "b" }
  7
}
print(mk3(0) is "a")
print(mk3(0) is "b")
print(mk3(1) is "a")
print(mk3(1) is "b")
print(mk3(2) is "a")
print(mk3(2) is "b")
