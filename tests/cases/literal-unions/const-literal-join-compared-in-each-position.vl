// @run
// @log true
// @log false
// @log true
// @log false
// @log true
// @log true
// @log false
// @log true
// A `const` joining two const-bound literals, held as the joined set's atom, compared as a string:
// against a const, a literal and a built string, on either side, with `!=`, and in a closure.
const A = "x"
const B = "y"
function eqConst(c: boolean) {
  const M = if c { A } else { B }
  return M == A
}
function eqLit(c: boolean) {
  const M = if c { A } else { B }
  return "y" == M
}
function neConst(c: boolean) {
  const M = if c { A } else { B }
  return M != B
}
function eqBuilt(c: boolean, s: string) {
  const M = if c { A } else { B }
  return M == s + ""
}
function inClosure(c: boolean) {
  const M = if c { A } else { B }
  const g = () => M == "x"
  return g()
}
print(eqConst(true))
print(eqConst(false))
print(eqLit(false))
print(neConst(false))
print(neConst(true))
print(eqBuilt(true, "x"))
print(eqBuilt(false, "x"))
print(inClosure(true))
