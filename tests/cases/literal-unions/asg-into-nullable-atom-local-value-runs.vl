// @run
// @log ww
// @log zz
// @log ww
// @log zz
// @log ww
// @log zz
// @log zz
// An assignment to a `K | null` local used as a value is the atom of the member written, widened
// to its string where it is delivered as one: a return, an annotated or inferred result, a
// `const`, `print`, at module level and in a function, of a literal or a call (D16184).
type K = "ww" | "zz"
function tail() {
  let k: K | null = null
  return k = "ww"
}
print(tail())
function ret(): K | null {
  let k: K | null = null
  return k = "zz"
}
print(ret())
function viaConst() {
  let k: K | null = null
  const v = k = "ww"
  return v
}
print(viaConst())
function pick(b: boolean): K {
  return if b { "ww" } else { "zz" }
}
function fromCall(b: boolean) {
  let k: K | null = null
  return k = pick(b)
}
print(fromCall(false))
let g: K | null = null
print(g = "ww")
print(g = pick(false))
print(g)
