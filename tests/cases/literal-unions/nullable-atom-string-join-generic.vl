// @run
// @log a
// @log null
// @log z
// @log a
// @log null
// @log z
// @log true
// @log false
// @log true
// @log a
// @log null
// @log z
// A join of type parameters pinned at `K` and `K | null` with a string arm is `string | null`,
// so every atom arm widens to its member text (D3336).
type K = "a" | "b"
function g<T0, T1>(a0: T0, a1: T1, k: i32) {
  const o = {
    v: match k {
      0 => a0
      1 => a1
      _ => "z"
    },
  }
  print(o.v)
}
function c<T0, T1>(a0: T0, a1: T1, k: i32) {
  print(if k == 0 { a0 } else if k == 1 { a1 } else { "z" })
}
function s<T0, T1>(a0: T0, a1: T1, k: i32) {
  const v = match k {
    0 => a0
    1 => a1
    _ => "z"
  }
  print(v is string)
}
function r<T0, T1>(a0: T0, a1: T1, k: i32) {
  match k {
    0 => a0
    1 => a1
    _ => "z"
  }
}
const x0: K = "a"
const x1: K | null = null
g(x0, x1, 0)
g(x0, x1, 1)
g(x0, x1, 2)
c(x0, x1, 0)
c(x0, x1, 1)
c(x0, x1, 2)
s(x0, x1, 0)
s(x0, x1, 1)
s(x0, x1, 2)
print(r(x0, x1, 0))
print(r(x0, x1, 1))
print(r(x0, x1, 2))
