// @run
// @log 4
// @log 4
// @log 2
// @log 4
// @log b
// @log a
// @log a
// @log a
// A module-scope `K | null` narrowed to a member reads its member's `.length`, and a member join
// stored into a member-default `??` binding at a nullable pin keeps the union (D3423).
type K = "ab" | "cdef"
let gk: K | null = "cdef"
if gk != null { print(gk.length) }
if gk is K { print(gk.length) }
const gi: "ab" | "cdef" | null = "ab"
if gi != null { print(gi.length) }
function readG(): i32 {
  if gk != null { return gk.length }
  return 0
}
print(readG())
type M = "a" | "b"
function g<T>(x: T) {
  let r = x ?? "a"
  r = if r == "a" { "b" } else { "a" }
  print(r)
}
const n: M | null = null
const b: M | null = "b"
g<M | null>(n)
g(b)
function h(x) {
  let r = x ?? "b"
  r = if r == "a" { "b" } else if r == "b" { "a" } else { "b" }
  print(r)
}
h(n)
h(b)
