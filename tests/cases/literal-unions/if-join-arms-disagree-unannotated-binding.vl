// @run
// @log green
// @log true
// @log is green
// @log v=green
// @log green
// @log green
// @log red
// @log green
// @log green
// @log green
// @log green
// @log red
// An un-annotated binding of an `if` whose arms carry different literal sets takes the type the
// checker recorded for the join, a registered literal union, and so the atom rep: the module
// cell, a function's local, and every read of either agree on it (D2206).
const A: "red" | "green" = "red"
const G: "green" = "green"
function one() { 1 }
function gr(): "green" { "green" }

const v = if one() > 0 { G } else { A }
print(v)
print(v == "green")
if v is "green" { print("is green") }
print("v=\{v}")
function show() { print(v) }
show()

let w = if one() > 1 { G } else { A }
w = if one() > 0 { G } else { A }
print(w)
const r = if one() > 1 { gr() } else { A }
print(r)
const xs = [if one() > 0 { G } else { A }, A]
print(xs[0])
const o = { k: if one() > 0 { G } else { A } }
print(o.k)

function local(n: i32) {
  const l = if n > 0 { G } else { A }
  print(l)
  const c = if n > 0 { gr() } else { A }
  print(c)
}
local(1)
function pickj(n: i32) {
  if n > 0 { G } else { A }
}
print(pickj(0))
