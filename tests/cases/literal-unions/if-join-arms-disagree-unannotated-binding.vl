// @run
// @log green
// @log true
// @log is green
// @log v=green
// @log green
// @log green
// @log red
// @log green
// @log green
// @log green
// @log green
// @log red
// @log green
// @log green
// @log blue
// @log blue
// @log red
// @log blue
// An un-annotated binding of an `if` whose arms carry different literal sets takes the type the
// checker recorded for the join, a registered literal union, and so the atom rep: the module
// cell, a function's local, and every read of either agree on it (D2206).
const A: "red" | "green" = "red"
const G: "green" = "green"
function one() { 1 }
function gr(): "green" { "green" }

const v = if one() > 0 { G } else { A }
print(v)
print(v == "green")
if v is "green" { print("is green") }
print("v=\{v}")
function show() { print(v) }
show()

let w = if one() > 1 { G } else { A }
w = if one() > 0 { G } else { A }
print(w)
const r = if one() > 1 { gr() } else { A }
print(r)
const xs = [if one() > 0 { G } else { A }, A]
print(xs[0])
const o = { k: if one() > 0 { G } else { A } }
print(o.k)

function local(n: i32) {
  const l = if n > 0 { G } else { A }
  print(l)
  const c = if n > 0 { gr() } else { A }
  print(c)
}
local(1)
function pickj(n: i32) {
  if n > 0 { G } else { A }
}
print(pickj(0))

// the same binding behind a condition that is a string compare
function sc() { "green" }
const vs = if sc() == "green" { G } else { A }
print(vs)
const ve = if sc() == "red" { A } else if sc() == "green" { G } else { A }
print(ve)

// a join that mints a fresh set equal to a declared alias's reps as that alias (D2208)
type RGB = "red" | "green" | "blue"
type S = { c: "red" | "blue" }
const st: S = { c: "blue" }
const f2 = if one() > 0 { st.c } else { G }
print(f2)
const arr: ("red" | "blue")[] = ["red", "blue"]
const e2 = if one() > 0 { arr[1] } else { G }
print(e2)
const mp: {[string]: "red" | "blue"} = Map()
mp["a"] = "red"
const m2 = if one() > 0 { mp["a"] ?? "blue" } else { G }
print(m2)
const rgb: RGB = f2
print(rgb)
