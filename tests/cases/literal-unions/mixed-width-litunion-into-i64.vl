// @run
// @log 3000000000
// @log 3000000000
// @log 1
// @log 3000000000
// @log 1
// A literal union with a member past `i32` delivered into an `i64` widens out of its box at the
// member it holds: a parameter returned as `i64`, its default, and a typed binding (D3320).
function f(x: 1 | 3000000000): i64 { x }
function g(x: 1 | 3000000000 = 3000000000): i64 { x }
print(f(3000000000))
print(g())
print(f(1))
const b: 1 | 3000000000 = 3000000000
const w: i64 = b
print(w)
const n: 1 | 3000000000 = 1
const v: i64 = n
print(v)
