// @run
// @log 2
// @log none
// @log 1
// An integer literal-union value boxed into a union takes its base scalar's arm, as a plain
// `i32` would: narrowed past its null and passed, or returned.
type LN = 1 | 2
function show(v: i32 | string) {
  if v is i32 { print(v) } else { print(v) }
}
function sLN(v: LN | null) {
  if v == null {
    print("none")
    return
  }
  show(v)
}
sLN(2)
sLN(null)
function up(v: LN): i32 | string { return v }
print(up(1))
