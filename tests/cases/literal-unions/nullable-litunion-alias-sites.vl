// @run
// @log ab
// @log zz
// @log 1
// @log ab
// @log zz
// CONTRACT: a literal-union ALIAS THAT CARRIES ITS OWN `| null` ARM (`type K = "ab" | "zz" |
// null`) is the SAME TYPE as the two-part `K2 | null` spelling, and must get the same i32 ATOM
// NICHE (member ids >= 0, the spare value -1 = null) at every construction site. Master built
// the union BOX instead — at the global, local, param and return positions each — while every
// READ classified from the arena, where the two spellings are one type, and lowered the atom:
// `struct.get`-free `call __print_i32__` on a `(ref $box)`, i.e. `failed to compile:
// wasm[0]::function[N]`, at all four.
//
// The alias interns as the EXPANDED union (a `null` member plus all-quoted literal members),
// not as a `TyNullable` over a litunion, and FOUR deciders only handled the `TyNullable` form:
// `nodeTyIsNulLitUnion` (whose own header already claimed both), `repOfTyFlat`'s TyUnion arm,
// the rep TREE's `rtOfUnion` (which is AUTHORITATIVE over the flat kind), and the two emit
// gates that exclude an atom from the box path (`emitLetDecl`'s `letUNm`, `emitReturnValue`'s
// `retUNm`) — both of which asked a NAME, and a bare alias name carries no members to scan.
//
// The `| null`-OUTSIDE control (`type K2 = "ab" | "zz"; const c: K2 | null`) ran on master and
// still runs; it is what made this look like a niche the compiler already had.

type K = "ab" | "zz" | null

const g: K = "ab"
if g != null { print(g) }

function takesK(v: K) {
  if v != null { print(v) } else { print(1) }
}

takesK("zz")
takesK(null)

function makesK(): K { return "ab" }

const r: K = makesK()
if r != null { print(r) }

function localForm() {
  const l: K = "zz"
  if l != null { print(l) }
}

localForm()
