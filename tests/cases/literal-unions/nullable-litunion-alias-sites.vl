// @run
// @log ab
// @log zz
// @log 1
// @log ab
// @log zz
// @hint redundant type annotation: `r` is inferred as `"ab" | "zz" | null`
// CONTRACT: a literal-union ALIAS THAT CARRIES ITS OWN `| null` ARM (`type K = "ab" | "zz" |
// null`) is the SAME TYPE as the two-part `K2 | null` spelling, and gets the same i32 ATOM
// NICHE (member ids >= 0, the spare value -1 = null) at every construction site — the global,
// local, param and return positions each. The failure this pins is the union BOX at a
// construction site while every READ classifies from the arena and lowers the atom:
// `struct.get`-free `call __print_i32__` on a `(ref $box)`, i.e. `failed to compile:
// wasm[0]::function[N]`.
//
// The alias interns as `TyNullable` over the litunion — the DECLARATION route folds a `null`
// variant into the niche through the same `annUnionTy` the two annotation routes climb, for
// every inner and without a gate — which is why the hint above renders the NICHE spelling,
// character for character with the inline spelling's own hint. (The display renderer spells a
// `TyNullable` and an expanded `… | null` union alike, `X | null`, so the hint no longer
// distinguishes the two routes; the four deciders below do, and they are the pin.) The
// EXPANDED shape (a `null` member beside all-quoted literal members) is still reachable
// through a wrapper whose fold declined, and four deciders answer for both:
// `nodeTyIsNulLitUnion`, `repOfTyFlat`'s TyUnion arm, the rep TREE's `rtOfUnion` (which is
// AUTHORITATIVE over the flat kind), and the two emit gates that exclude an atom from the box
// path (`emitLetDecl`'s `letUNm`, `emitReturnValue`'s `retUNm`) — both of which ask a NAME,
// and a bare alias name carries no members to scan.
//
// The `| null`-OUTSIDE control (`type K2 = "ab" | "zz"; const c: K2 | null`) is what makes
// this look like a niche the compiler already had.

type K = "ab" | "zz" | null

const g: K = "ab"
if g != null { print(g) }

function takesK(v: K) {
  if v != null { print(v) } else { print(1) }
}

takesK("zz")
takesK(null)

function makesK(): K { return "ab" }

const r: K = makesK()
if r != null { print(r) }

function localForm() {
  const l: K = "zz"
  if l != null { print(l) }
}

localForm()
