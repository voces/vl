// @run
// @log green
// @log red
// An INLINE literal union delivered through a hole parameter into a list literal. The pin
// softens it to the `string` ref, so the literal builds a string list — a fact only the
// enclosing frame can see, and both the reservation and the read had asked it frameless.
//
// Two sides that must agree: the collector reserves the string list per function body, and
// the READ of `xs[0]` must not claim the atom its element type still spells. Claiming it
// emitted an i32 consumer over a `(ref $type)` (D1740, D1760).

const src: ("red" | "green")[] = ["green", "red"]

function fromDeclared(a) {
  const xs = [a]
  print(xs[0])
}

function mkval(): "red" | "green" { return "red" }
const inferred = [mkval()]

function fromInferred(p) {
  const xs = [p]
  print(xs[0])
}

fromDeclared(src[0])
fromInferred(inferred[0])
