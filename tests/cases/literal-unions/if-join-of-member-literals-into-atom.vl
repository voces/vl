// @run
// @log ab
// @log cd
// @log cd
// @log ab
// @log ab
// @log cd
// @log cd
// @log ab
// An `if` whose arms are member literals, delivered into a literal union at a declaration, an
// assignment and an argument: each arm writes its literal's id. A non-literal arm, or an `else if`
// chain, takes the destination the same way.
type K = "ab" | "cd"
function take(k: K): K { return k }
function mk(i: i32): K { return if i > 0 { "cd" } else { "ab" } }
function decl(c: boolean): K {
  const k: K = if c { "ab" } else { "cd" }
  return k
}
function asg(c: boolean): K {
  let k: K = "cd"
  k = if c { "cd" } else { "ab" }
  return k
}
function arg(c: boolean): K { return take(if c { "ab" } else { "cd" }) }
function mixed(c: boolean): K {
  const k: K = if c { mk(1) } else { "ab" }
  return k
}
print(decl(true))
print(decl(false))
print(asg(true))
print(asg(false))
print(arg(true))
print(arg(false))
print(mixed(true))
print(mixed(false))
