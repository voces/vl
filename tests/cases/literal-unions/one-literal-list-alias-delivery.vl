// D7340: a list of one string literal and a list of its one-literal alias are one type and
// one atom list, so either delivers into the other at a binding, an argument and a result.
// @run
// @log circle
// @log circle
// @log circle
// @log circle
// @log circle
// @log 1
// @log true
type KC = "circle"
function takesAlias(a: KC[]): KC { a[0] }
function takesLit(a: "circle"[]): string { a[0] }
function passes(a: "circle"[]): "circle"[] { a }
const xs: "circle"[] = ["circle"]
const ys: KC[] = xs
print(ys[0])
const zs: "circle"[] = ys
print(zs[0])
print(takesAlias(xs))
print(takesLit(ys))
const ws = passes(["circle"])
print(ws[0])
ws.push("circle")
print(xs.length + ws.length - 2)
print(ws == ws)
