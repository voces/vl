// @run
// @log b
// @log a
// @log null
// @log 1
// @log b
// @log b
// @log b
// @log a
// @log 1
// @log b
// @log null
// @log 3
// @log b

// The arm an `is i32` test leaves of an `i32 | K | null` box is the `K | null` niche, and it
// prints as a member or null wherever the box came from (D7965).
type AB = "a" | "b"

const r: i32 | AB | null = "b"
if r is i32 { print(1) } else { print(r) }

function f(p: i32 | AB | null) {
  if p is i32 { print(1) } else { print(p) }
}
f("a")
f(null)
f(4)

const n: i32 | null = null
const xn: AB | null = "b"
const j = n ?? xn
if j is i32 { print(1) } else { print(j) }

function g(): i32 | AB | null { return "b" }
const c = g()
if c is i32 { print(1) } else { print(c) }
const s = { v: g() }
if s.v is i32 { print(1) } else { print(s.v) }

function h(x: AB | null) { print(x) }
const d: i32 | AB | null = "a"
if d is i32 { print(1) } else { h(d) }
const xs: (i32 | AB | null)[] = [1, "b", null]
for x in xs {
  if x is i32 { print(x) } else { print(x) }
}

function k<T>(p: T | AB | null) {
  if p is AB { print(p) }
  else if p == null { print("nul") }
  else { print(p) }
}
k(3)
k<i32>("b")
