// @check
// @error cannot compare "b" | "c" with "a" — not a member of the union
// @error match pattern "a" is not a member of "b" | "c"

// Once a compare has narrowed a member away, a later compare or `match` arm naming that member
// is refused, as it is after `is`: the test can never pass.
type K = "a" | "b" | "c"

function pick(i: i32): K {
  if i == 0 { return "a" }
  "b"
}
function again(i: i32) {
  const k = pick(i)
  if k == "a" { return "A" }
  if k == "a" { return "never" }
  k
}
function arm(i: i32) {
  const k = pick(i)
  if k == "a" { return "A" }
  match k {
    "a" => "never"
    "b" => "B"
    "c" => "C"
  }
}

print(again(0))
print(arm(1))
