// @run
// @log true
// @log false
// @log false
// @log true
// @log true
// `x is string` over a value that reps as the interned atom: every member of a literal union is
// a string, so it holds, and over the `K | null` niche it holds exactly when the value is not
// null (D2154).
type K = "a" | "b"
function g<T>(x: T) { x is string }
function mk(b: boolean): K | null {
  if b { return "a" }
  null
}
const n = mk(false)
print(n == null)
print(g(n))

function mk2(b: boolean): ("a" | "b") | null {
  if b { return "a" }
  null
}
print(g(mk2(false)))
print(g(mk2(true)))
const k: "a" | "b" = "b"
print(g(k))
