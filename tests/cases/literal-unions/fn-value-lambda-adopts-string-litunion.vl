// @run
// @log x
// @log null
// @log a
// @log null
// @log y
// @log x
// A lambda whose every return is a member of the expected string literal union, or is null
// where the union is nullable, adopts it, whichever return comes first (D9520).
type K = "x" | "y"
const c = true
const d = false
const h: () => K = () => {
  if c { return "x" }
  "y"
}
const hn: () => K | null = () => {
  if c { return null }
  "y"
}
const ha: () => "a" = () => {
  if c { return "a" }
  "a"
}
const ht: () => K | null = () => {
  if d { return "x" }
  null
}
const hs: () => K = () => "y"
function run(f: () => K) { print(f()) }
print(h())
print(hn())
print(ha())
print(ht())
print(hs())
run(() => "x")
