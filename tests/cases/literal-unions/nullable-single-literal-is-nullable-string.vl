// @run
// @log 10
// @log 0
// @log 1
// @log 0
// @log x
// @log none
// @log x
// @log d
// @log true
// @log true
// @log 1
// @log true
// @log 2
// A nullable union of ONE string literal is `string | null`: the literal softens to `string`
// as it does alone, so the parameter, the body, the caller and every container agree on the
// nullable string ref. Two or more literals keep the atom niche (D2827).
function eq(x: "x" | null) {
  if x == "x" { return 10 }
  0
}
function ne(x: "x" | null) {
  if x != null { return 1 }
  0
}
function narrow(x: "x" | null) {
  if x == null { return "none" }
  x
}
function orD(x: "x" | null) { x ?? "d" }
function mk(b: boolean): "x" | null {
  if b { return "x" }
  null
}
type A = "x" | null
function viaAlias(x: A) { x == "x" }
print(eq("x"))
print(eq(null))
print(ne("x"))
print(ne(null))
print(narrow("x"))
print(narrow(null))
print(orD("x"))
print(orD(null))
print(mk(true) == "x")
print(viaAlias("x"))
let g: "x" | null = null
g = "x"
const cap = () => g == "x"
if cap() { print(1) } else { print(0) }
const xs: ("x" | null)[] = []
xs.push("x")
xs.push(null)
print(xs[1] == null)
print(xs.length)
