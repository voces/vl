// @run
// @log 1
// @log 2
// @log 2
// @log 1
// @log 2
// @log true
// @log 2
// @log a
// @info `w` is never reassigned; use `const` instead of `let`
// A `??` over a numeric literal union with `null` joins to the literal union, whose rep is the
// atom, so an un-annotated binding of it, an inferred return and a capture hold the atom rather
// than the box (D2531).
let vv: 1 | 2 | null = null
const z = vv ?? 1
print(z)
vv = 2
const y = vv ?? 1
print(y)
function tail() { vv ?? 1 }
print(tail())
function ret() {
  let w: 1 | 2 | null = null
  return w ?? 1
}
print(ret())
function captured() {
  let w: 1 | 2 | null = null
  w = 2
  const c = w ?? 1
  const g = () => c
  print(g())
}
captured()
print(y == 2)
print("\{y}")
const mix: 1 | "a" | null = "a"
const m = mix ?? 1
print(m)
