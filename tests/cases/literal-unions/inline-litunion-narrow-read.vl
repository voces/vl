// @run
// @log pp
// @log qq!
// @log qq
// @log O
// @log pp
// @log qq
// @log pp
// @log true
// @log pp!
// @log O
// @log qq!
// @log pp
// @log O
// @log qq
// @log pp!
// @log O
//
// An inline literal-union arm of a mixed box (`("pp" | "qq") | f64`), narrowed by `is`, reads
// back as its string at every position the box arrives from, as the declared-alias spelling
// does (D6630). The members differ from any alias in scope, so no alias row can answer.

function bind() {
  const x: ("pp" | "qq") | f64 = "pp"
  if x is ("pp" | "qq") { print(x) } else { print("O") }
}
bind() // pp

function concat() {
  const x: ("pp" | "qq") | f64 = "qq"
  if x is ("pp" | "qq") { print(x + "!") } else { print("O") }
}
concat() // qq!

function take(x: ("pp" | "qq") | f64) {
  if x is ("pp" | "qq") { print(x) } else { print("O") }
}
take("qq") // qq
take(2.5) // O

function ret(n: i32): ("pp" | "qq") | f64 {
  if n > 0 { return "pp" }
  1.5
}
function fromRet() {
  const x = ret(1)
  if x is ("pp" | "qq") { print(x) } else { print("O") }
}
fromRet() // pp

const g: ("pp" | "qq") | f64 = "qq"
function fromGlobal() {
  if g is ("pp" | "qq") { print(g) } else { print("O") }
}
fromGlobal() // qq

function fromField() {
  const s: { v: ("pp" | "qq") | f64 } = { v: "pp" }
  const x = s.v
  if x is ("pp" | "qq") { print(x) } else { print("O") }
}
fromField() // pp

function eqStill() {
  const x: ("pp" | "qq") | f64 = "pp"
  if x is ("pp" | "qq") { print(x == "pp") } else { print("O") }
}
eqStill() // true

// The other partner of the box does not matter: a scalar, a record and a list each read back.
function withI32(n: i32) {
  const x: ("pp" | "qq") | i32 = if n > 0 { "pp" } else { 3 }
  if x is ("pp" | "qq") { print(x + "!") } else { print("O") }
}
withI32(1) // pp!
withI32(0) // O

function withI64(n: i32) {
  const x: ("pp" | "qq") | i64 = if n > 0 { "qq" } else { 3 }
  if x is ("pp" | "qq") { print(x + "!") } else { print("O") }
}
withI64(1) // qq!

function withBool(n: i32) {
  const x: ("pp" | "qq") | boolean = if n > 0 { "pp" } else { true }
  if x is ("pp" | "qq") { print(x) } else { print("O") }
}
withBool(1) // pp
withBool(0) // O

function withRecord(n: i32) {
  const x: ("pp" | "qq") | { a: i32 } = if n > 0 { "qq" } else { { a: 1 } }
  if x is ("pp" | "qq") { print(x) } else { print("O") }
}
withRecord(1) // qq

function withList(n: i32) {
  const x: ("pp" | "qq") | string[] = if n > 0 { "pp" } else { ["z"] }
  if x is ("pp" | "qq") { print(x + "!") } else { print("O") }
}
withList(1) // pp!
withList(0) // O
