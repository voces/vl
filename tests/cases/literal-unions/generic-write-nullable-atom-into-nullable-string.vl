// @run
// @log h-null
// @log false
// @log hn
// @log b
// @log true
// @log b
// @log true
// @log g-null
// @log false
// @log 1
// @log fn
// @log b
// A `K | null` value written by assignment into a declared `string | null` local or field
// inside a generic or hole instance widens at the write, and the null tests after it read the
// instance's own type, at a null and a non-null argument (D12464).
type K = "a" | "b"
function h(x) {
  let s: string | null = null
  s = x
  if s == null { print("h-null") } else { print(s) }
  print(s != null)
  print(s ?? "hn")
}
function g<T>(x: T) {
  let s: string | null = "z"
  s = x
  print(s == null)
  if s != null { print(s.length) } else { print("g-null") }
}
type R = { f: string | null }
function fld<T>(x: T) {
  const r: R = { f: "q" }
  r.f = x
  print(r.f ?? "fn")
}
const v: K | null = null
const w: K | null = "b"
h(v)
h(w)
g(v)
g(w)
fld(v)
fld(w)
