// @run
// @log 1.5
// @log a
// @log 2.5
// @log b
// @log 4000000000
// BOTH LITERAL-UNION FAMILIES IN ONE MODULE, which is the only spelling that reaches the
// disagreement between them. A STRING literal union reps as an interned i32 ATOM; a NUMERIC one
// reps as its BASE SCALAR (`numLitUnionBaseTy`) and has no atom at all. Every atom classifier is
// behind `gLitUnionUsed`, a module-wide flag only the STRING family turns on — so a numeric
// literal union misclassified as an atom is invisible until a string one is declared beside it.
//
// `exprIsLitAtom`'s array-element arm asked `nodeTyIsPureLitUnion`, which tests only that every
// member is a `TyLit`. With no `S` in the file `print(k[0])` printed `1.5`; with `S` declared it
// became `emitProgram: print of a literal-union atom whose type carries no member texts` — the
// atom widen looking for member ids in a type whose members are f64 values.
//
// THE INDEX READ IS THE ONE POSITION THAT REACHED IT. A numeric litunion SCALAR (`const k: K`)
// was always correct beside a string one, because that path never routes through the element
// classifier. Both are pinned below so the pair cannot drift apart again.
type S = "a" | "b"
type K = 1.5 | 2.5
type J = 3000000000 | 4000000000

const ks: K[] = [1.5, 2.5]
const ss: S[] = ["a", "b"]
const js: J[] = [4000000000]

print(ks[0])
print(ss[0])

// The SCALAR spelling of each, which was correct before and must stay correct.
const k1: K = 2.5
const s1: S = "b"
print(k1)
print(s1)

// The i64 base, the third rep of the numeric family.
print(js[0])
