// @run
// @log a
// @log empty
// @log none
// @log b
// @log z
// @log b
// @log true
// @log x!
// @log a
// A literal-union list's `.pop() ?? d` with a default outside the set widens the popped atom to its
// member string; a member default keeps the atom (D1413).
const xs: ("a" | "b")[] = ["a"]
print(xs.pop() ?? "empty")
print(xs.pop() ?? "empty")
function f() {
  const ys: ("a" | "b")[] = []
  print(ys.pop() ?? "none")
}
f()
function g(zs: ("a" | "b")[]): string { return zs.pop() ?? "z" }
print(g(["b"]))
print(g([]))
const ws: ("a" | "b")[] = ["a", "b"]
const r = ws.pop() ?? "c"
print(r)
print(r == "b")
const es: ("a" | "b")[] = []
print((es.pop() ?? "x") + "!")
const ms: ("a" | "b")[] = ["a"]
print(ms.pop() ?? "b")
