// @run
// @log ww
// @log arg qq
// @log [vv]
// @log nn
// @log arg mm
// @log [pp]
// @log null
// @log zz
// @log ss
// An assignment used as a value whose target is a local literal-union cell, `K` or `K | null`,
// reads back the member just assigned: returned, handed to a string parameter, and interpolated.
// A `K | null` cell assigned `null` reads back `null` (bound first: D17119),
// and a plain later read sees the cell.
type K = "zz" | "ww" | "qq" | "vv"
type M = "ss" | "nn" | "mm" | "pp"
function show(s: string) { print("arg " + s) }
function ret() {
  let k: K = "zz"
  return k = "ww"
}
function arg() {
  let k: K = "zz"
  show(k = "qq")
}
function hole() {
  let k: K = "zz"
  print("[\{k = "vv"}]")
}
function nret() {
  let m: M | null = null
  return m = "nn"
}
function narg() {
  let m: M | null = "ss"
  show(m = "mm")
}
function nhole() {
  let m: M | null = null
  print("[\{m = "pp"}]")
}
function nnull() {
  let m: M | null = "ss"
  const r = m = null
  print(r)
}
function after() {
  let k: K = "ww"
  const r = k = "zz"
  print(r)
  let m: M | null = null
  m = "ss"
  print(m)
}
print(ret())
arg()
hole()
print(nret())
narg()
nhole()
nnull()
after()
