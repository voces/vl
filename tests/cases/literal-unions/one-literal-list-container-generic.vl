// D7340: a one-literal list stored in a map value, filled by `push`, walked by `for`, and
// handed to a generic, inferred or with the literal written as its type argument.
// @run
// @log circle
// @log circle
// @log circle
// @log 1
// @log circle
// @log circle!
// @log circle
// @log 1
type KC = "circle"
function first<T>(x: T[]): T { x[0] }
function count<T>(x: T[]) { x.length }
function h(a: KC[]): string { a[0] }
const m: {[i32]: "circle"[]} = Map()
const xs: "circle"[] = ["circle"]
m[1] = xs
const g = m[1]
if g != null { print(g[0]) }
const zs: "circle"[] = []
zs.push("circle")
print(h(zs))
for z in zs { print(z) }
print(zs.length)
print(first(xs))
const y = first(xs)
print(y + "!")
print(first<"circle">(xs))
print(count<"circle">(xs))
