// @run
// @hint redundant type annotation: `k` is inferred as `K` — remove it to lean on inference
// @hint redundant type annotation: `k` is inferred as `K` — remove it to lean on inference
// @log ac
// @log guardb
// @log ac
// @log a or bc
// @log a or bc
// @log ab
// @log ABC
// @log bc
// @log 6

// A compare against a literal narrows a literal-union value exactly as `is` does: the
// then-branch to the literal, the else-branch and an exiting guard to the rest, `!=` the other
// way round, and through `&&`, `||` and `!`. Each probe hands the value to a parameter that
// accepts only the narrowed members, once from an annotated binding and once from an inferred one.
type K = "a" | "b" | "c"
type N = 1 | 2 | 3

function pick(i: i32): K {
  if i == 0 { return "a" }
  if i == 1 { return "b" }
  "c"
}
function pickN(i: i32): N {
  if i == 0 { return 1 }
  if i == 1 { return 2 }
  3
}
function onlyA(x: "a") { x }
function onlyBC(x: "b" | "c") { x }
function onlyC(x: "c") { x }
function only1(x: 1) { x }
function only23(x: 2 | 3) { x }

function thenElse(i: i32) {
  const k: K = pick(i)
  if k == "a" { return onlyA(k) } else { return onlyBC(k) }
}
function guardExit(i: i32) {
  const k = pick(i)
  if k == "a" { return "guard" }
  onlyBC(k)
}
function notEqual(i: i32) {
  const k = pick(i)
  if k != "a" { return onlyBC(k) }
  onlyA(k)
}
function both(i: i32) {
  const k = pick(i)
  if k != "a" && k != "b" { return onlyC(k) }
  "a or b"
}
function either(i: i32) {
  const k: K = pick(i)
  if k == "a" || k == "b" { return "a or b" }
  onlyC(k)
}
function negated(i: i32) {
  const k = pick(i)
  if !(k == "a") { return onlyBC(k) }
  onlyA(k)
}
function inMatch(i: i32) {
  const k = pick(i)
  if k == "a" { return "A" }
  match k {
    "b" => "B"
    "c" => "C"
  }
}
function inLoop() {
  let out = ""
  let i = 0
  while i < 3 {
    const k = pick(i)
    if k != "a" { out = out + onlyBC(k) }
    i = i + 1
  }
  out
}
function ints(i: i32) {
  const n = pickN(i)
  if n == 1 { return only1(n) }
  only23(n)
}

print(thenElse(0) + thenElse(2))
print(guardExit(0) + guardExit(1))
print(notEqual(0) + notEqual(2))
print(both(0) + both(2))
print(either(1) + either(2))
print(negated(0) + negated(1))
print(inMatch(0) + inMatch(1) + inMatch(2))
print(inLoop())
print(ints(0) + ints(1) + ints(2))
