// @check
// @error expected K | null, got string — `"z"` is not one of K: "a" | "b"
// A valued `if` joining a `null` arm with a string naming no member of `K` stays a `string`
// join, refused at a `K | null` return.
type K = "a" | "b"
function h(c: i32): K | null { return if c == 1 { null } else { "z" } }
print(h(2))
