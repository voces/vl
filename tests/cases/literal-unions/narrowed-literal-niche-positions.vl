// @run
// @log a
// @log b
// @log null
// @log a
// @log b
// @log a
// @log null
// @log b
// @log b
// A read narrowed to `K | null` out of a wider box, `K` a literal union, converts to the niche where
// it is printed or delivered to a `K | null` destination. Each position is its own function.

type AB = "a" | "b"
type W = i32 | AB | null

function printLocal() {
  const v: W = "a"
  if v is i32 { print(0) } else { print(v) }
}
printLocal()

function printParam(v: W) {
  if v is i32 { print(0) } else { print(v) }
}
printParam("b")
printParam(null)

type Holder = { w: W }
function printField(h: Holder) {
  if h.w is i32 { print(0) } else { print(h.w) }
}
printField({ w: "a" })

function printElement(xs: W[]) {
  if xs[0] is i32 { print(0) } else { print(xs[0]) }
}
printElement(["b"])

function show(k: AB | null) { print(k) }
function deliverArg(v: W) {
  if v is i32 { print(0) } else { show(v) }
}
deliverArg("a")
deliverArg(null)

function hole(v) {
  if v is i32 { print(0) } else { print(v) }
}
const g: W = "b"
hole(g)

if g is i32 { print(0) } else { print(g) }
