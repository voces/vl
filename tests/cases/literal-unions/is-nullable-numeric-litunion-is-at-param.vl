// @run
// CONTRACT (A WIDENING — these programs are a LOUD REJECT on master): `x is N` over a
// nullable-numeric-litunion PARAM compiles, and the narrowed `x` reads as the base scalar on a
// present input while the else-arm is reached on `null`. Both inputs, every cell.
//
// THE POSITION DECIDED THE VERDICT, WHICH IS THE TELL FOR TWO DISAGREEING HOMES. At a `let` /
// `const` / global / field / element / map-value the same program is `vl check`-clean INVALID
// WASM (pinned in `is-nullable-numeric-litunion-narrowed-read.vl`); at a PARAM it was
// ``emitProgram: `is` names a type that is not a union variant``. The membership arm gates on
// `exprUnion`, which asks `paramUnion` → `nodeTyIsUnionAlias`, and that predicate rejects a
// `TyNullable` whose inner is a homogeneous litunion (`isValueUnionBox` excludes an all-one-
// `litKind` union) — so it answered "not a union value" for a slot `vtKindOfType` had ALREADY
// given the box valtype, one `nodeTyIsNulNumLitUnion` arm away in the same ladder. `paramUnion`
// now reads both of that ladder's `"union"` arms, so the classifier and the slot agree.
//
// THE RETURN POSITION IS THE SAME PREDICATE'S THIRD CONSUMER and is pinned in
// `nullable-numeric-litunion-return.vl`; the boundary that is still a loud reject —
// `is` on a bare CALL RESULT, which a membership ladder cannot re-read — is pinned in
// `nullable-numeric-litunion-is-on-call-result-reject.vl`.

type N = 1 | 2

// @log 1
// @log none
function isAlias(p: N | null) {
  if p is N { print(p) } else { print("none") }
}
isAlias(1)
isAlias(null)

// the INLINE annotation of the identical box
// @log 2
// @log none
function isInline(p: 1 | 2 | null) {
  if p is N { print(p) } else { print("none") }
}
isInline(2)
isInline(null)

// the single-literal test — no alias named at the `is`
// @log 1
// @log none
function isMember(p: N | null) {
  if p is 1 { print(p) } else { print("none") }
}
isMember(1)
isMember(null)

// negated: the ELSE arm is the narrowed one
// @log 2
// @log none
function isNegated(p: N | null) {
  if !(p is N) { print("none") } else { print(p) }
}
isNegated(2)
isNegated(null)

// an f64-based litunion — a different base scalar through the same arm
// @log 2.5
// @log none
type W = 1.5 | 2.5
function isF64(p: W | null) {
  if p is W { print(p) } else { print("none") }
}
isF64(2.5)
isF64(null)

// a THREE-member set, so the ladder is longer than one compare
// @log 3
// @log none
type M = 1 | 2 | 3
function isThree(p: M | null) {
  if p is M { print(p) } else { print("none") }
}
isThree(3)
isThree(null)

// CONTROL: the STRING litunion at the same position was already correct
// @log b
// @log none
type K = "a" | "b"
function isStr(p: K | null) {
  if p is K { print(p) } else { print("none") }
}
isStr("b")
isStr(null)
