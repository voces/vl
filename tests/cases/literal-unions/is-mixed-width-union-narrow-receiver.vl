// @run
// `d is C` where only some members of the literal set `C` fit `d`'s type tests those members,
// and is refused as never matching only when none fits (D3655).
type C = 1 | 2 | 3000000000
function f(d: i32) { d is C }
function g(d: i32) {
  if d is C { return d * 100 }
  0
}
print(f(1))
print(f(3))
print(g(2))
print(g(5))
const xs = [4, 1]
print(xs[1] is C)
print(xs[0] is 1 | 3000000000)
// @log true
// @log false
// @log 200
// @log 0
// @log true
// @log false
