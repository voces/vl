// @run
// @log 1
// @log a
// CONTRACT (must-RUN): every member is a LITERAL, but they soften to DIFFERENT base scalars
// (`"a"` → string, `1` → i32), so the union still boxes — `canonEmitName` names it
// `string|i32` — and `print` dispatches on the tag (D712). Membership in the literal set is
// not what decides the rep; the set of BASES is. The same-base sibling
// (`print-same-base-literal-union-runs.vl`) needs no box and prints through the plain
// ladder, which is why it always ran.
//
// Before D-LITPRINT this built a module that failed to parse as WebAssembly; between
// D-LITPRINT and D712 it was a clean `unsupported-lowering` reject.
const v: "a" | 1 = 1
print(v)

const s: "a" | 1 = "a"
print(s)
