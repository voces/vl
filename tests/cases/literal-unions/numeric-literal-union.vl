// @run
// @log 1
// @log 2
// @log 4000000000
// @log 3000000000
// A HOMOGENEOUS NUMERIC literal union (`1 | 2`, `3000000000 | 4000000000`) is NOT a string-atom
// litunion and NOT a value-union box — it canon-collapses to its base scalar (`softenLitTy`): an
// int union reps as i32, or i64 when a member is past the i32 range, in every position. (A
// MIXED-kind literal union `"a" | 7` is a genuine value-union box — a separate rep, not covered
// here.)

function pickI(): 1 | 2 { return 1 }
function echoI(x: 1 | 2): i64 { return x }
function pickW(): 3000000000 | 4000000000 { return 4000000000 }
function echoW(x: 3000000000 | 4000000000): i64 { return x }

function go() {
  print(pickI())           // 1
  print(echoI(2))          // 2
  print(pickW())           // 4000000000
  print(echoW(3000000000)) // 3000000000
}

go()
