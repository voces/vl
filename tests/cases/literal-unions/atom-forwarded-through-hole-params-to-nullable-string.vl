// @run
// @log b
// @log a
// @log b
// @log none
// @log 2
// A literal-union atom forwarded through hole parameters into a `string | null` callback
// parameter widens to its member string, as a `string` parameter does (D3187).
type K = "a" | "b"

function G(h, v) { return h(v) }
function H(g, w) { return G(g, w) }
function I(f, u) { return H(f, u) }

const s: K = "b"
print(H((x: string | null) => x, s))
const t: K = "a"
print(I((x: string | null) => x, t))
const n: K | null = "b"
print(H((x: string | null) => x ?? "none", n))
const z: K | null = null
print(H((x: string | null) => x ?? "none", z))
print(H((x: string | null) => if x == null { 0 } else { x.length + 1 }, s))
