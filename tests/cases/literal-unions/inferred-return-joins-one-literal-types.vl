// @run
// @log green
// @log red
// @log true
// @log green
// @log red
// @log green
// An inferred return that joins one-literal types is a literal union no annotation spelled. The
// callee and every caller agree on its rep, through a named function and a lambda, at a print,
// a binding, a compare, a list element and a record field (D5521). No annotation names the union.
const G: "green" = "green"
const R: "red" = "red"

function d(n: i32) {
  if n > 1 { R } else { G }
}
const pick = (n: i32) => {
  if n > 1 { R } else { G }
}

print(d(0))
const r = d(2)
print(r)
print(d(0) == "green")
const cs = [pick(0), pick(2)]
print(cs[0])
print(cs[1])
const o = { c: d(0) }
print(o.c)
