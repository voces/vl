// @check
// @error operator '+' is not defined for string and string | null
// CONTRACT (must-error): `if s is "m"` over a raw `string | null` narrows `s` non-null in the
// THEN branch ONLY. The ELSE branch is reached by every non-`"m"` value INCLUDING null, so `s`
// is still `string?` there and a value use of it stays a type error.
//
// THE SOUNDNESS HALF OF THE NULL-GUARDED MEMBER COMPARE. That guard replaced a trap with
// `false` — a loud failure with a quiet answer — which is only correct if `false` really is the
// answer AND nothing else null-related got quieter with it. The then-branch narrowing is pinned
// by `is-nullable-string-receiver.vl` (it concatenates the receiver there); this is the other
// direction, and it must stay a REJECT: a null receiver taking the else branch is precisely the
// input the guard made reachable.
function go(s: string | null) {
  if s is "m" {
    print("then")
  } else {
    print("else" + s)
  }
  0
}
go(null)
