// D3207, D2842, D4161: a lambda against a `() => "a" | null` context adopts the one-literal
// niche whether its body is the literal or `null`, at a binding and at an argument, and a
// `[null]` delivered to `("a" | null)[]` is the atom list holding the niche.
// @run
// @log a
// @log n
// @log a
// @log n
// @log 1
// @log n
// @log 1
// @log n
const g: () => "a" | null = () => "a"
print(g() ?? "n")
const h: () => "a" | null = () => null
print(h() ?? "n")
function run(f: () => "a" | null): string {
  const v = f()
  if v != null { return v }
  return "n"
}
print(run(() => "a"))
print(run(() => null))
const xs: ("a" | null)[] = [null]
print(xs.length)
print(xs[0] ?? "n")
function first(ys: ("a" | null)[]) { ys[0] ?? "n" }
const zs: ("a" | null)[] = [null]
print(zs.length)
print(first(zs))
