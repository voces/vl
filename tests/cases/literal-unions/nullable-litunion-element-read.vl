// @run
// @log p
// @log null
// @log q
// @log p
// @log null
// @log q
// @log p
// @log null
// @log p
// @log null
// @log p
// @log q
// CONTRACT: reading a `(K | null)[]` ELEMENT yields the MEMBER, and `null` where the element is
// null — at every read form, and whether or not a null is actually present at runtime. The two
// working spellings this is twinned against are the `string` element (`(string | null)[]`, which
// has always printed `p` / `null` / `q`) and the NON-nullable `K[]` element.
//
// WHY IT IS A FIXTURE, AND WHY IT REDDENS ON THE LOG. A named litunion is an interned i32 ATOM;
// the atom must be widened back to its member string to print. Master BUILT this program and RAN
// it, printing `0`, `-1`, `1` — the raw interned ids and the null sentinel — with `vl check`
// rc 0, at every read form below. So the redness here is an output mismatch, not a verdict.
//
// The cause was not the widen but the DETECTOR that gates every atom classifier:
// `anyLitUnionUsed` asked for a bare nullable-litunion ANNOTATION type, and no node in this
// program carries one (the annotation of `(K | null)[]` is a TypeRef whose own type is the
// TyArray). So `gLitUnionUsed` stayed 0 for the whole module and `exprIsLitAtom` short-circuited
// on its FIRST LINE, which routes `print` past every atom arm to `__print_i32__`. The for-in
// loop VAR needed one more arm for the same reason a `K[]` loop var already had it: it is the one
// storage class `exprNulLitUnion` cannot resolve, so `declareForInLocals` has to flag its slot.
//
// The NARROWED spellings and the other consumers live in
// `nullable-litunion-element-consumers.vl`, which master rejects rather than mis-running.

type K = "p" | "q"

const xs: (K | null)[] = ["p", null, "q"]

// `for-in` and `while` + index are the two spellings of one read, and they were broken
// identically — the defect is at the READ, not in the iteration.
for x in xs { print(x) }

let i = 0
while i < xs.length {
  print(xs[i])
  i = i + 1
}

// A direct index read, and the same read through `.slice`, whose element temp is declared
// non-null and recovers separately.
print(xs[0])
print(xs[1])
const sl = xs.slice(0, 2)
for s in sl { print(s) }

// THE NULL-FREE RUNTIME INPUT: the same element type, no null in the list.
const ys: (K | null)[] = ["p", "q"]
for y in ys { print(y) }
