// @run
// @hint redundant type annotation: `f` is inferred as `i32`
// @hint redundant type annotation: `bump` is inferred as `i32`
// `e is L` over a numeric literal union, where `e` cannot be read twice, reads `e` once and
// tests every member: a call, an operator and a `??` answer by value, and run once (D3570).
type L = 1 | 2
function f(x: i32): i32 { x }
let n = 0
function bump(): i32 {
  n = n + 1
  n
}
function h(x: i32 | null) { print((x ?? 2) is L) }
print(f(1) is L)
print(f(4) is L)
print((f(1) + f(1)) is L)
print(bump() is L)
print(bump() is L)
print(bump() is L)
print(n)
h(1)
h(4)
h(null)
// @log true
// @log false
// @log true
// @log true
// @log true
// @log false
// @log 3
// @log true
// @log false
// @log true
