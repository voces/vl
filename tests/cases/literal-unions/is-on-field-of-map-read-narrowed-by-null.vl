// @run
// @log true
// @log false
// @log 3
// @log false
// @log true
// @log true
// @log true
// @log false

// A map read narrowed by `!= null` is the record itself, so `is` on its value-union field
// tests that field's box (D8000).
type E = { f: i32 | string }
type K = "a" | "b"

const m: { [string]: { f: i32 | string } } = Map()
m["k"] = { f: 3 }
if m["k"] != null { print(m["k"].f is i32) }

const me: { [string]: E } = Map()
me["k"] = { f: 3 }
if me["k"] != null {
  print(me["k"].f is string)
  const x = me["k"].f
  print(x)
}

const mk: { [string]: { f: i32 | K } } = Map()
mk["k"] = { f: "b" }
if mk["k"] != null { print(mk["k"].f is i32) }

const mi: { [i32]: { f: i32 | string } } = Map()
mi[1] = { f: 3 }
if mi[1] != null { print(mi[1].f is i32) }

function show(o: E | null) { if o != null { print(o.f is string) } }
show({ f: "z" })
type H = { a: E | null }
const h: H = { a: { f: 4 } }
if h.a != null { print(h.a.f is i32) }
if h.a != null { print(h.a.f is string) }
