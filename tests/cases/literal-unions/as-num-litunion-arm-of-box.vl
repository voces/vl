// @run
// @log 2
// @log 12
// @log s
// @log 1
// @log true
// @log 2
// `as!`, `as` and `as?` to a numeric literal-union arm of a box test the base's tag and the
// payload's membership, and yield the bare `i32` (D11221).
type N2 = 1 | 2
const u: N2 | string = 2
const r = u as! N2
print(r)
function mk(k: i32): N2 | string {
  if k == 0 { return "s" }
  if k == 1 { return 1 }
  2
}
function bump(k: i32): i32 | string {
  const v = mk(k) as N2
  v + 10
}
print(bump(2))
print(bump(0))
const o = mk(1) as? N2
if o != null { print(o) }
print((mk(0) as? N2) == null)
const n: N2 | null = 2
print(n as! N2)
