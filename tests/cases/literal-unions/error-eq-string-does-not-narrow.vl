// @check
// @error return type mismatch: expected K, got string
// @error cannot assign string to 'r' of type "ab"
// A compare narrows only a value whose type is a literal union. A plain `string` compared with
// a literal stays `string`, because nothing but the type says which strings it may hold; the
// literal-union half is `eq-literal-narrows-as-is.vl`.

// ── a plain `string` receiver: `==` leaves it `string` ─────────────────────────────
type K = "aa" | "ab"
function fromStr(s: string): K {
  if s == "aa" { return s }
  return "ab"
}

// ── the control for the guard direction: a `string` cannot be re-bound as a literal ─
function noLaunder(s: string) {
  const r: "ab" = s
  print(r)
  0
}

print(fromStr("aa"))
noLaunder("zz")
