// @run
// @log a
// @log b
// @log a
// A read of a `const` bound to a literal reaches a wider literal-union destination as that
// literal's member, at a binding, an argument and a return.
const A = "a"
const B = "b"
function take(m: "a" | "b" | "c") { print(m) }
function bound() {
  const m: "a" | "b" | "c" = A
  print(m)
}
function ret(): "a" | "b" { return A }
bound()
take(B)
print(ret())
