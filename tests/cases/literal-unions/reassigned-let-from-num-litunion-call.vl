// @run
// @log 11
// @log 12
// @log 11
// @log 12
// @log 12
// @hint redundant type annotation: `w` is inferred as `N2`
// @hint redundant type annotation: `u` is inferred as `N2`
// CONTRACT: a `let` seeded by a call returning a numeric literal union and then reassigned
// keeps the union's base-scalar slot, so every delivery into it, a call or a literal, stores
// the scalar it reads back. Un-annotated and annotated, in a function and at top level (D11240).

type N2 = 1 | 2

function g(): N2 { return 1 }

function h(): N2 { return 2 }

function f() {
  let v = g()
  v = g()
  print(v + 10)
  let w: N2 = g()
  w = h()
  print(w + 10)
}

f()

let t = g()
t = g()
print(t + 10)
t = 2
print(t + 10)

let u: N2 = g()
u = h()
print(u + 10)
