// @run
// @log 0
// @log a!
// @log b
// @log true
// @log k=b
// @log a
// @log 1
// A `(1 | "a" | "b")[]` element narrowed past its number to the string arms is the string the box
// holds: concatenated, printed, compared, passed at the arms and returned.
type M = 1 | "a" | "b"
type K = "a" | "b"
function name(k: K) { return "k=" + k }
function cat(xs: M[]) {
  if xs[0] is 1 { print(0) } else { print(xs[0] + "!") }
}
function pr(xs: M[]) {
  if xs[0] is 1 { print(0) } else { print(xs[0]) }
}
function eq(xs: M[]) {
  if xs[0] is 1 { print(false) } else { print(xs[0] == "b") }
}
function arg(xs: M[]) {
  if xs[0] is 1 { print("one") } else { print(name(xs[0])) }
}
function back(xs: M[]) {
  if xs[0] is 1 { return "1" }
  return xs[0]
}
cat([1])
cat(["a"])
pr(["b"])
eq(["b"])
arg(["b"])
print(back(["a"]))
print(back([1]))
