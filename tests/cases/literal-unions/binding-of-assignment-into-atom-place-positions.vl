// @run
// @log ww
// @log zz
// @log ww
// @log zz
// @log ww
// A binding whose initializer is an assignment into a literal-union place holds the member written,
// as the place's atom: a `K | null` local, a `K` local and a parameter, in a function and at the
// top, read back as a string.
type K = "ww" | "zz"
function nullable() {
  let k: K | null = null
  const v = k = "ww"
  return v
}
function plain() {
  let k: K = "ww"
  const v = k = "zz"
  return v
}
function param(p: K) {
  const v = p = "ww"
  return v
}
print(nullable())
print(plain())
print(param("zz"))
let top: K = "ww"
const t = top = "zz"
print(t)
const u = top = "ww"
print(u)
