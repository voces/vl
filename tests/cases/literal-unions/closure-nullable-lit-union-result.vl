// @run
// @log 2
// @log 2
// @log 2
// @log true
// @log 2
// D2535: a closure whose result is `K | null` returns the union box, and a value call keys that
// from its `$fnsig`. Where the callee had no annotation to name the union (a lambda with an
// inferred result, a closure handed back by a factory, a generic's per-instance getter), the
// call's result was read at the literal union's i32 niche instead. It now reads the box.
type LI = 1 | 2 | 3
const s: (LI | null)[] = [null, 2]
const g1 = (i: i32) => s[i]
const r1 = g1(1)
if r1 != null { print(r1) }
function mk(): (i32) => LI | null {
  return (i: i32): LI | null => if i > 0 { 2 } else { null }
}
const g2 = mk()
const r2 = g2(1)
if r2 != null { print(r2) }
print(g2(1) ?? 3)
function mkGet<V>(xs: (V | null)[]): (i32) => V | null {
  return (i: i32) => xs[i]
}
const g3 = mkGet(s)
print(g3(0) == null)
const r3 = g3(1)
if r3 != null { print(r3) }
