// @run
// @log 2
// @log a!
// @log b
// @log a!b
// @log 1
// @log b!
// @log a
// @log a!
// @hint redundant type annotation: `first` is inferred as `string`
// A list-literal arm of an `if` or `match` join whose destination is a literal-union list is
// built at that list: at a declared return (as the implicit tail and as `return`), at an
// argument, at an annotated binding and at a record field (D5287).
type K = "a" | "b"
function id<T>(xs: T[]): T[] { xs }
function show(k: K) { k + "!" }
function f(n: i32): K[] {
  match n {
    0 => ["a"]
    _ => id(["a", "b"])
  }
}
function g(c: boolean, ks: K[]): K[] {
  if c { ["a", "b"] } else { ks }
}
function h(c: boolean, ks: K[]): K[] { return if c { ks } else { ["b", "a"] } }
function first(ks: K[]): string { show(ks[0]) }
const B: K[] = ["b"]
print(f(1).length)
print(show(f(0)[0]))
print(g(false, B)[0])
print(first(if B.length > 5 { B } else { ["a"] }) + h(false, B)[0])
const local: K[] = match B.length {
  1 => ["b"]
  _ => B
}
print(local.length)
type Box = { ks: K[] }
const box: Box = { ks: if B.length == 1 { ["b"] } else { B } }
print(show(box.ks[0]))
function nest(c: boolean): K[][] {
  if c { [["a"], ["b", "a"]] } else { [B] }
}
print(nest(true)[1][1])
const e: K[] = if B.length > 5 { [] } else { ["a"] }
print(show(e[0]))
