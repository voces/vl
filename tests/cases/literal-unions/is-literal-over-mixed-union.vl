// @run
// @log ERR
// @log other
// @log ERR
// @log other
// @log THREE
// @log other
// @log THREE
// @log other
// @log STR
// @log other
// @log ERR
// @log other
// @log ERR
// @log S
// @log ERR
// @log notERR
// @log ERR
// @log notERR
// @log 3
// @log 0
// @log Y
// @log n
// @log n
// @log n
// @log Y
// @log n
// @log n
// @log n
// @log A
// @log other
// @log other
// @log true
// @log false
// @log false
// @log false
// LITERAL `is` OVER A MIXED UNION — the arm the literal's rep names is tested, the rest are
// not touched. D1047.
//
// `emitUnionLitIs` gated on `isValueUnionOfSet || unionCarriesLitUnionArm`, so a STRUCT or
// CONTAINER arm beside the literal's base atom refused the whole test
// (`emitProgram: literal `is` over a struct union is not supported`) — while `==` over the
// SAME union and the SAME literal ran, because `emitUnionConcreteEq` carries the third
// disjunct (`eqMixedOk`) and `is` did not. The lowering below both gates is the same
// arm-agnostic shape: read the box's TAG, compare it to the tag of the literal's own rep,
// and on a match compare that ONE payload. A struct arm simply has a tag that does not
// match, which is the right answer and needs no compare core of its own.
//
// THE CONTROLS ARE HALF THE FIXTURE. The value-union spelling (`string | i32`) and the
// TYPE-`is` (`r is string`) both ran before and must keep running unchanged, and the `==`
// twin is what the `is` answer is graded against — a widened gate that admitted an
// unchanged wrong lowering would still print SOMETHING, so every case here DISCRIMINATES:
// each is asked at a value of the matching arm and at a value of a non-matching one.
//
// THE UN-ANNOTATED DESTINATION IS DELIBERATE (`const r = mk(true)`). An annotation pins the
// rep, so a fixture that annotates every destination cannot see an inference-pinned one.

type S = { v: i32 }
type K = "a" | "b"

// CONTROL — a plain VALUE union took the old gate's first disjunct and always ran.
function valueUnion(r: string | i32) {
  if r is "err" { return "ERR" }
  "other"
}
print(valueUnion("err"))
print(valueUnion(3))

// A STRUCT arm beside the literal's `string` base.
function structAndString(r: S | string) {
  if r is "err" { return "ERR" }
  "other"
}
print(structAndString("err"))
print(structAndString({ v: 1 }))

// A STRUCT arm beside the literal's `i32` base — not a string-only defect.
function structAndI32(r: S | i32) {
  if r is 3 { return "THREE" }
  "other"
}
print(structAndI32(3))
print(structAndI32({ v: 1 }))

// CONTROL — the `==` twin over the identical union and literal, which always ran. Its
// answer is what the `is` answer above is graded against.
function structAndI32Eq(r: S | i32) {
  if r == 3 { return "THREE" }
  "other"
}
print(structAndI32Eq(3))
print(structAndI32Eq({ v: 1 }))

// CONTROL — the TYPE-`is` over the same box, which always ran (a different arm of `emitIs`).
function typeIs(r: S | string) {
  if r is string { return "STR" }
  "other"
}
print(typeIs("err"))
print(typeIs({ v: 1 }))

// A CONTAINER arm, not just a struct one — the `Json` shape, whose `j == "err"` ran while
// `j is "err"` refused.
type J = null | boolean | f64 | string | J[] | { [string]: J }
function jsonIs(j: J) {
  if j is "err" { return "ERR" }
  "other"
}
print(jsonIs("err"))
print(jsonIs(1.5))

// THE UN-ANNOTATED DESTINATION — `mk`'s return pins the rep, the binding does not.
function mk(b: boolean): S | "err" {
  if b { return "err" }
  { v: 1 }
}
const r0 = mk(true)
if r0 is "err" { print("ERR") } else { print("S") }
const r1 = mk(false)
if r1 is "err" { print("ERR") } else { print("S") }

// NEGATED, COMPARED TO `false`, AND AS A LOOP CONDITION — the test is a value, so every
// position that consumes a boolean has to see the same one.
function neg(r: S | "err") {
  if !(r is "err") { return "notERR" }
  "ERR"
}
print(neg("err"))
print(neg({ v: 1 }))

function cmpFalse(r: S | "err") {
  if (r is "err") == false { return "notERR" }
  "ERR"
}
print(cmpFalse("err"))
print(cmpFalse({ v: 1 }))

function loopCond(r: S | "err") {
  let n = 0
  while r is "err" {
    n = n + 1
    if n > 2 { return n }
  }
  n
}
print(loopCond("err"))
print(loopCond({ v: 2 }))

// THE FULL ATOM SWEEP over a THREE-arm mixed union — producing A value is not producing the
// RIGHT value at every atom, so each literal is asked at a value of every arm.
function sweepStr(r: S | string | i32) {
  if r is "err" { return "Y" }
  "n"
}
print(sweepStr("err"))
print(sweepStr("other"))
print(sweepStr(3))
print(sweepStr({ v: 1 }))

function sweepNum(r: S | string | i32) {
  if r is 3 { return "Y" }
  "n"
}
print(sweepNum(3))
print(sweepNum(4))
print(sweepNum("err"))
print(sweepNum({ v: 1 }))

// A LITERAL-UNION arm beside the struct one — the gate's third disjunct carries the same
// second leg the static-false fold below it already trusted (`unionTakesAtomAsStr`), so a
// `K` arm whose banked member kind is -1 is still seen to hold a quoted literal.
function structAndLitUnion(r: S | K) {
  if r is "a" { return "A" }
  "other"
}
print(structAndLitUnion("a"))
print(structAndLitUnion("b"))
print(structAndLitUnion({ v: 1 }))

// AN `is` INSIDE A `==` OPERAND — the two scratch stashes must not be one slot. D1060 parks a
// non-re-readable `is` RECEIVER in scratch code 17 and D972 parks a non-re-readable `==`
// OPERAND in code 13, and both boxes are `(ref null $uBoxIdx)`: a shared slot would clobber
// AND VALIDATE, so nothing would say so. Here BOTH are calls, so both stashes are live in one
// expression, and the printed value proves the outer `==` read its OWN operand: `mkX(1)` is
// `7`, and it must compare against `idx`'s answer rather than against whatever the inner `is`
// last parked.
function idx(b: boolean) {
  if b { return 7 }
  9
}
function mkX(n: i32): K | i32 {
  if n == 0 { return "a" }
  7
}
function mkY(n: i32): K | i32 {
  if n == 0 { return "a" }
  3
}
print(mkX(1) == idx(mkY(0) is "a")) // 7 == idx(true)  == 7 -> true
print(mkX(1) == idx(mkY(1) is "a")) // 7 == idx(false) == 9 -> false
print(mkX(0) == idx(mkY(0) is "a")) // the string arm never equals an i32 -> false
print(mkX(0) == idx(mkY(1) is "a")) // ditto -> false
