// @run
// @log a
// @log null
// @log z
// @log null
// @log z
// @log b
// @log z
// @log null
// @log z
// @log true
// @log false
// @log n
// @log n
// @log a
// @log x
// @log n
// @log b
// @log x
// A nullable literal-union atom joined with a string joins as `string | null`, the members
// absorbed by `string` as they are without the null, at every delivery position (D3336).
type K = "a" | "b"
function g(a0: K, a1: K | null, k: i32) {
  print(
    match k {
      0 => a0
      1 => a1
      _ => "z"
    },
  )
}
function show(v: string | null) { print(v) }
function c(a1: K | null, k: i32) {
  const v = if k == 1 { a1 } else { "z" }
  show(v)
}
function r(a1: K | null, k: i32) {
  if k == 1 { a1 } else { "z" }
}
function e(a0: K, a1: K | null, k: i32) {
  const xs = [if k == 0 { a0 } else if k == 1 { a1 } else { "z" }]
  print(xs[0] == null)
}
g("a", null, 0)
g("a", null, 1)
g("a", null, 2)
c(null, 1)
c(null, 2)
print(r("b", 1))
print(r(null, 2))
print(r(null, 1))
print(r("a", 3))
e("a", null, 1)
e("a", null, 2)
// An inferred result joining a string with a `K | null` value reads through `??` (D3241).
function f(k: K | null, b: boolean) {
  if b { return "x" }
  return k
}
print(f(null, false) ?? "n")
function h(n: i32): K | null {
  if n == 0 { return null }
  "a"
}
function f2(b: boolean, n: i32) {
  if b { return "x" }
  return h(n)
}
print(f2(false, 0) ?? "n")
print(f2(false, 1) ?? "n")
print(f2(true, 0) ?? "n")
function f3<T>(k: T, b: boolean) {
  if b { return "x" }
  return k
}
const u: K | null = null
const w: K | null = "b"
print(f3(u, false) ?? "n")
print(f3(w, false) ?? "n")
print(f3(u, true) ?? "n")
