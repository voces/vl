// @log true
// GRADUATED from `silent-class-inventory` D45 — the COMPILER-side pin, importing nothing, so
// a reading of this cannot conclude `std:array` chose the rule. `std/array.vl`'s ledger row
// and its four-export graduation are `tests/cases/std/array-litunion-list-needle.vl`.
//
// A LITERAL UNION IS VALUE-COMPARABLE AND A LIST OF THEM IS THE i32 LIST. The refusal that
// stood here said neither: `isEquatable` answered false for every `TyUnion` (so `K[]` was "a
// field is not value-comparable", about a type with no field), and `eqCmpKindOfArrayElem`
// answered "none" (so `K[]` had no list core, about the very list `i32[]` uses). Both gates
// now read the rep: `tyUnionAllLits` for the soundness half — the SAME predicate the `+` home
// has used to accept this family since it was written — and the i32-backing split for the
// lowering half.
//
// THE ROWS BELOW ARE THE REP VOCABULARY, not a demonstration. A STRING union is the interned
// atom; a NUMERIC union whose base is `i32` is that scalar; `K[][]` is a ref list of those i32
// lists (the third member of an accept set the ladder spelled as two prim names); `K[] | null`
// is the same list under the niche's null guard; and a STRUCT with a `K` FIELD is the
// structural gate's own question, which is what `isEquatable` is for. An `f64`-based union is
// deliberately absent: it rides the f64 list, which has no `==` core, and its refusal is
// pinned in `tests/cases/std/error-array-needle-not-equatable.vl`.
//
// THE `K[] | null` ROWS WERE NAMED BY THIS HEADER AND MISSING FROM THE FILE for one commit —
// a sentence ahead of its fixture, which is the pattern `std/array.vl`'s ledger counts eleven
// times, made in the change that cites the ledger. Caught by the `std-api-reviewer` pass. They
// are the NICHE: the same i32 list under a null guard, so all four null/non-null combinations
// have to be pinned and not just the interesting one.
//
// NOT THE SAME SHAPE AS `(K | null)[]`, and the distinction is worth one line because the two
// spellings look alike: this is a NULLABLE LIST of `K`, whose element is still one atom; that
// is a list of a NULLABLE atom, whose element resolves to a `TyNullable` that D45's `TyUnion`
// arm does not reach. The second is still refused and is filed as `silent-class-inventory`
// D101.
type K = "a" | "b"
type N = 1 | 2
type B = { k: K }

function listNe() {
  const a: K[] = ["a"]
  const b: K[] = ["b"]
  return a == b
}

function listEq() {
  const a: K[] = ["a", "b"]
  const b: K[] = ["a", "b"]
  return a == b
}

function listNeOp() {
  const a: K[] = ["a"]
  const b: K[] = ["b"]
  return a != b
}

// LENGTH is part of the compare: a prefix is not equal to its extension.
function listLen() {
  const a: K[] = ["a"]
  const b: K[] = ["a", "b"]
  return a == b
}

function numList() {
  const a: N[] = [1, 2]
  const b: N[] = [1, 2]
  return a == b
}

// `K[][]` — a ref list of i32 lists, the same shape `i32[][]` is.
function nested() {
  const a: K[][] = [["a"]]
  const b: K[][] = [["b"]]
  return a == b
}

function nestedEq() {
  const a: K[][] = [["a"], ["b"]]
  const b: K[][] = [["a"], ["b"]]
  return a == b
}

// A STRUCT whose FIELD is a literal union — the structural gate's own shape.
function fieldNe() {
  const a: B = { k: "a" }
  const b: B = { k: "b" }
  return a == b
}

function fieldEq() {
  const a: B = { k: "a" }
  const b: B = { k: "a" }
  return a == b
}

// `K[] | null` — the NICHE. All four null/non-null combinations, because a guard that runs
// the base's core has to be right about both operands and about neither.
function nulBoth() {
  const a: K[] | null = ["a"]
  const b: K[] | null = ["a"]
  return a == b
}

function nulBothNe() {
  const a: K[] | null = ["a"]
  const b: K[] | null = ["b"]
  return a == b
}

function nulLeft() {
  const a: K[] | null = null
  const b: K[] | null = ["a"]
  return a == b
}

function nulNull() {
  const a: K[] | null = null
  const b: K[] | null = null
  return a == b
}

print(listNe())
print(listEq())
print(listNeOp())
print(listLen())
print(numList())
print(nested())
print(nestedEq())
print(fieldNe())
print(fieldEq())
print(nulBoth())
print(nulBothNe())
print(nulLeft())
print(nulNull())
