// @run
// @log true
// @log false
// @log false
// @log true
// @log false
// @log true
// @log true
// @log false
// @log true
// @log true
// @log false
// @log true
// @log false
// @log true
// @log false
// @log true
// @log false
// @log true
// @log 3
// @hint redundant type annotation: `a` is inferred as `(boolean | null)[]`
// @hint redundant type annotation: `b` is inferred as `(boolean | null)[]`
// THE `@hint` LINES ARE DELIBERATE, for the same reason: dropping a `(boolean | null)[]`
// annotation to quiet the hint would let inference pick the element type and the row would no
// longer be about the sentinel niche.
//
// GRADUATED from `silent-class-inventory` D101 — the COMPILER-side pin, importing nothing, so
// a reading of this cannot conclude `std:array` chose the rule. The `needle: T` graduation is
// `tests/cases/std/array-litunion-list-needle.vl`.
//
// AN I32-SENTINEL NULLABLE IS ONE CELL AND A LIST OF THEM IS THE i32 LIST. D45 taught the
// `==` home that a literal union reps as one cell; it taught the arm on `TyUnion`, and
// `K | null` resolves to a `TyNullable`, so the correction missed its own `| null` sibling by
// one arm. A draft of D45's comment CLAIMED this family was covered ("`tyUnionAllLits` covers
// the `| null` member too") and the claim never fired — the sentence was deleted and D101
// filed in its place, which is the difference between a fix and a fix's description of itself.
//
// THE COMPLEMENT WAS ALREADY WRITTEN, AND THIS IS THE CALL. `tyScalarBackedListKind` — the
// EMITTER's own wrapper ladder — has answered `"list"` for `K[]`, `(K | null)[]` and
// `(boolean | null)[]` all along, off a measurement its header records: a program binding all
// eight list spellings side by side gives those three the SAME wrapper `i32[]` gets. So the
// emitter held the whole answer while the checker refused the program, and the divergence was
// visible one operator over the entire time: `(K | null)[] + (K | null)[]` concatenated and
// printed `3` while `(K | null)[] == (K | null)[]` was refused for "a field that is not
// value-comparable" about the same cell. The last line of this file is that `+`, kept beside
// the `==` so the two can never drift apart again.
//
// TWO SENTINEL FAMILIES, NOT ONE — the row names `K | null` and its `boolean | null` twin has
// the identical divergence, which a grep for the OTHER spelling of the same rep found. The
// two are `repOfNullable`'s `rdNul` 3 (the atom id with the spare `-1`) and `rdNul` 2 (the
// 0/1 with the spare `2`), and they are the only two nullables that niche into an i32 rather
// than a `(ref null …)` or a box.
//
// FOUR SPELLINGS OF THE ATOM ONE, NOT TWO, AND THE FIRST GRID MISSED HALF OF THEM. The row
// names the two-part form (`K | null`, inline and through an alias), which is a `TyNullable`.
// The EXPANDED form — `"a" | "b" | null` written out, and an alias over it — is a `TyUnion`
// with a null member, a different arena shape for the same rep, and `tyIsNullableLitUnion`
// carries both. A grid built from the row's own two spellings could not contain the other two
// and would have reported the fix complete while half its surface was untested; the four are
// pinned here for that reason. (The UN-annotated `["a", null]` is NOT a fourth rep — it infers
// as `(string | null)[]`, the ref niche, and is refused on both sides. Measured, because
// `tyIsNullableLitUnion`'s own header cites that spelling as the expanded form's source.)
//
// WHAT STAYS REFUSED, and it is measured rather than argued: `(N | null)[]` over
// `type N = 1 | 2` and `(F | null)[]` over `type F = 1.5 | 2.5`. A NUMERIC litunion's nullable
// is a value-union BOX — `repOfNullable` asks `tyIsLitUnion`, which is string-only — so the
// syntax is identical and the rep is not. Those rows live in
// `tests/cases/std/error-array-needle-not-equatable.vl`, where the pair states the boundary.
//
// THE NULL IS IN THE VALUE SPACE, WHICH IS WHY `i32.eq` IS THE WHOLE COMPARE. There is no
// guard and no tag: `null == null` is `-1 == -1` and `null == "a"` is `-1 == <atom>`, so the
// element compare is the same instruction `i32[]` uses. Every row below pins an ANSWER and
// not merely "it compiled", and the `null`-vs-value rows are the ones that would catch a
// sentinel folded to the wrong constant.
type K = "a" | "b"
type LK = K | null
type LB = boolean | null
type E = "a" | "b" | null
type WK = { f: K | null }
type WB = { f: boolean | null }

// ── the ATOM sentinel (`rdNul` 3), INLINE spelling: equal, then null-vs-value ──
function atomEq() {
  const a: (K | null)[] = ["a", null, "b"]
  const b: (K | null)[] = ["a", null, "b"]
  return a == b
}

function atomNullVsValue() {
  const a: (K | null)[] = ["a", null]
  const b: (K | null)[] = ["a", "b"]
  return a == b
}

// LENGTH is part of the core, not just the elements: a prefix must not compare equal.
function atomLen() {
  const a: (K | null)[] = ["a"]
  const b: (K | null)[] = ["a", null]
  return a == b
}

function atomNe() {
  const a: (K | null)[] = [null]
  const b: (K | null)[] = ["a"]
  return a != b
}

// ── the DECLARED-ALIAS spelling of the same type, which reaches the arena by another route ──
function aliasAtomEq() {
  const a: LK[] = ["b", null]
  const b: LK[] = ["b", "a"]
  return a == b
}

function aliasAtomNe() {
  const a: LK[] = ["b", null]
  const b: LK[] = ["b", "a"]
  return a != b
}

// ── the EXPANDED spelling of the SAME rep: a `TyUnion` with a null member rather than a
//    `TyNullable`. Written inline and through an alias. ──
function expandedEq() {
  const a: ("a" | "b" | null)[] = ["a", null]
  const b: ("a" | "b" | null)[] = ["a", null]
  return a == b
}

function expandedNullVsValue() {
  const a: ("a" | "b" | null)[] = ["a", null]
  const b: ("a" | "b" | null)[] = ["a", "b"]
  return a == b
}

function aliasExpandedNe() {
  const a: E[] = [null, "b"]
  const b: E[] = ["a", "b"]
  return a != b
}

function aliasExpandedEq() {
  const a: E[] = [null, "b"]
  const b: E[] = [null, "b"]
  return a == b
}

// ── the BOOLEAN sentinel (`rdNul` 2), both spellings. `null` is the spare 2, so a compare
//    that folded it to `false` (0) would answer `true` here and this row would catch it. ──
function boolNullVsFalse() {
  const a: (boolean | null)[] = [null]
  const b: (boolean | null)[] = [false]
  return a == b
}

function boolEq() {
  const a: (boolean | null)[] = [true, null, false]
  const b: (boolean | null)[] = [true, null, false]
  return a == b
}

function aliasBoolNullVsTrue() {
  const a: LB[] = [null]
  const b: LB[] = [true]
  return a == b
}

function aliasBoolEq() {
  const a: LB[] = [false, null]
  const b: LB[] = [false, null]
  return a == b
}

// ── THE STRUCT FIELD, which is the third rung and is reachable only because the soundness
//    gate moved. Field codes 21 and 30 are declared with the same `0x7f i32` storagetype the
//    plain scalar field is, so they share its `i32.eq` arm; before this they fell to
//    `emitProgram: unsupported struct field type in equality`, which is a loud reject the
//    checker's own refusal was hiding. ──
function fieldAtomNullVsValue() {
  const a: WK = { f: null }
  const b: WK = { f: "a" }
  return a == b
}

function fieldAtomEq() {
  const a: WK = { f: null }
  const b: WK = { f: null }
  return a == b
}

function fieldBoolNullVsFalse() {
  const a: WB = { f: null }
  const b: WB = { f: false }
  return a == b
}

function fieldBoolEq() {
  const a: WB = { f: true }
  const b: WB = { f: true }
  return a == b
}

// ── THE `+` TWIN, kept in the same file as the `==` it diverged from for three commits.
//    This has ALWAYS run; the point of pinning it here is that the two operators now read
//    ONE predicate for this element rep, so a future change cannot move one without the
//    other going red. ──
function concatTwin() {
  const a: (K | null)[] = ["a", null]
  const b: (K | null)[] = ["b"]
  return (a + b).length
}

print(atomEq())
print(atomNullVsValue())
print(atomLen())
print(atomNe())
print(aliasAtomEq())
print(aliasAtomNe())
print(expandedEq())
print(expandedNullVsValue())
print(aliasExpandedNe())
print(aliasExpandedEq())
print(boolNullVsFalse())
print(boolEq())
print(aliasBoolNullVsTrue())
print(aliasBoolEq())
print(fieldAtomNullVsValue())
print(fieldAtomEq())
print(fieldBoolNullVsFalse())
print(fieldBoolEq())
print(concatTwin())
