// @run
// @log true
// @log false
// @log 2
// `x is N` over a numeric literal union is a membership test, `x == m0 || x == m1`, so it
// reads its receiver once per member. A call result is not a re-readable place, so it is
// evaluated once into a local first and each member compares the same value (D12060); `gEv`
// counts one call per test.
//
// Binding the result first, `const r = mk(true)` then `r is N`, is the place spelling, pinned
// in `nullable-numeric-litunion-return.vl`.

type N = 1 | 2

let gEv = 0

function mk(b: boolean): N | null {
  gEv = gEv + 1
  if b { return 1 }
  return null
}

print(mk(true) is N)
print(mk(false) is N)
print(gEv)
