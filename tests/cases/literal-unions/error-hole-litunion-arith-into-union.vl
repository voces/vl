// @error cannot assign i32 to 'q' of type N
// @error cannot assign i32 to 'p' of type N
// @error cannot assign i32 to N (the body of `bump` at the call's argument types)
// @error cannot assign i64 to 's' of type W
// Arithmetic over a parameter bound at a literal union is the union's base scalar, so a result
// outside the set is refused where the set is declared, as the direct `a * 2` is (D9560).
type N = 1 | 2
type W = 1 | 2 | 5000000000
const a: N = 2
const w: W = 2
function twice(x) { x * 2 }
const q: N = twice(a)
const neg = (x) => -x
const p: N = neg(a)
function bump(x) {
  let y = x
  y *= 3
  y
}
print(bump(a))
function thrice<T>(x: T) { x * 3 }
const s: W = thrice(w)
