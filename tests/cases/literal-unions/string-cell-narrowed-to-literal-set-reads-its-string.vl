// @run
// @log then:ua
// @log else
// @log t:ub
// @log no
// @log in vb
// @log sx
// @log sy
// @log no
// A string held as `string` or `string | null`, narrowed by `is` to a literal set, is read as the
// string it holds: joined, bound to a typed `string`, and a narrowed list's element read and
// joined. A null or a string outside the set takes the else.
type UA = "ua" | "ub"
type VB = "va" | "vb"
type K = "sx" | "sy"
function join(s: string | null) {
  if s is UA { print("then:" + s) } else { print("else") }
}
function bind(s: string | null) {
  if s is UA {
    const t: string = s
    print("t:" + t)
  } else {
    print("no")
  }
}
function plain(s: string) {
  if s is VB { print("in " + s) }
}
function first(a: string[]) {
  if a is K[] { print(a[0] + "") } else { print("no") }
}
join("ua")
join(null)
bind("ub")
bind("zz")
plain("vb")
first(["sx"])
first(["sy", "sx"])
first(["q"])
