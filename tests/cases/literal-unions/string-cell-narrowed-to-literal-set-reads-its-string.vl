// @run
// @hint redundant type annotation: `u` is inferred as `UA`
// @log then:ua
// @log else
// @log t:ub
// @log no
// @log in vb
// @log sx
// @log sy
// @log no
// @log ub
// @log true
// @log p:ua
// @log true
// @log false
// A string held as `string` or `string | null`, narrowed by `is` to a literal set, is read as the
// string it holds: joined, bound to a typed `string`, and a narrowed list's element read and
// joined. A null or a string outside the set takes the else. Stored into a `UA` local, handed
// to a `UA` parameter or compared with a member, it is that member.
type UA = "ua" | "ub"
type VB = "va" | "vb"
type K = "sx" | "sy"
function join(s: string | null) {
  if s is UA { print("then:" + s) } else { print("else") }
}
function bind(s: string | null) {
  if s is UA {
    const t: string = s
    print("t:" + t)
  } else {
    print("no")
  }
}
function plain(s: string) {
  if s is VB { print("in " + s) }
}
function first(a: string[]) {
  if a is K[] { print(a[0] + "") } else { print("no") }
}
function takeUA(u: UA) { print("p:" + u) }
function stored(s: string | null) {
  if s is UA {
    const u: UA = s
    print(u)
    print(u == "ub")
  }
}
function passed(s: string | null) {
  if s is UA { takeUA(s) }
}
function cmp(s: string | null) {
  if s is UA { print(s == "ua") }
}
join("ua")
join(null)
bind("ub")
bind("zz")
plain("vb")
first(["sx"])
first(["sy", "sx"])
first(["q"])
stored("ub")
passed("ua")
cmp("ua")
cmp("ub")
