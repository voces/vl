// @run
// @log ab
// @log null
// @log cd
// @log null
// CONTRACT: a BARE map read over a litunion-valued map types `K | null` (a missing key reads
// null), so `print(m[k])` prints the stored MEMBER for a present key and `null` for an absent
// one — reached by a different route than the annotated binding, hence its own pin. Both map
// spellings are here: `{[string]: K}`, where only a MISSING key is null, and
// `{[string]: K | null}`, which can also hold a STORED null.
//
// On master this printed NOTHING AT ALL: rc=0, empty output, for a map whose key was present.
// The read is the i32 atom niche in both spellings (a miss yields the same `-1` sentinel a stored
// null does), and the widening chain took its member texts from a query that declines a nullable
// type, so it emitted no arms.
//
// The absence is exactly what there IS a rendering for — `null`, the word every other nullable
// print writes — so this needs no narrowing to be answerable.

type K = "ab" | "cd"

const m: {[string]: K} = Map()
m["k"] = "ab"
print(m["k"])
print(m["absent"])

const n: {[string]: K | null} = Map()
n["k"] = "cd"
n["z"] = null
print(n["k"])
print(n["z"])
