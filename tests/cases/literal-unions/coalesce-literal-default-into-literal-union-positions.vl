// @run
// @log m
// @log m
// @log m
// @log 2
// @log n
// A concrete `??` checks its default against its destination, as a valued `if` checks its arms,
// so a literal default reaches a literal-union binding, argument and return (D17565).
function take(k: "m" | "n") { print(k) }
function j(x: null): "m" | "n" { return x ?? "m" }
const n = null
const p = null
const w: "m" | "n" = n ?? "m"
print(w)
take(n ?? "m")
print(j(null))
const q: 1 | 2 = n ?? 2
print(q)
const r: "m" | "n" = n ?? p ?? "n"
print(r)
