// @run
// @log 1.5
// @log 2.5
// @log 0
// @log 2
// @log 1.5
// @log true false
// @log 7
// @log 2.5
// @log 3.5
// @log true
// @log yes
// The refusal of a float literal type (D2221) suggests `f64` (or `f32`), or the integer literal
// a whole-number spelling meant; each suggestion, written where the refusal fires, runs. Float
// VALUES are untouched: a `const` bound to a float literal is an `f64`, never a literal type.
type Ratio = 1 | 3
type Box<T> = { v: T }

function param(x: f64) { x }
function ret(): f32 { 2.5 }
function member(x: 1 | f64 | 3) {
  if x is f64 { 0 } else { x }
}
function whole(x: 1 | 2): i32 { x }
function generic(b: Box<f64>) { b.v }
function nested(xs: (f64 | 2)[]) { xs[0] is f64 }
function inMap(m: {[string]: f64}) { m["k"] ?? 0.0 }

const X = 2.5
let y = X
y = 3.5
const r: Ratio = 3

print(param(1.5))
print(ret())
print(member(0.5))
print(whole(2))
print(generic({ v: 1.5 }))
print("\{nested([1.5])} \{nested([2])}")
const m: {[string]: f64} = Map()
m["k"] = 7.0
print(inMap(m))
print(X)
print(y)
print(X == 2.5)
if r is 3 { print("yes") } else { print("no") }
