// @run
// CONTRACT: the NARROWING FORM and the RECEIVER's rep do not change what a narrowed
// literal-union value may be consumed as. `narrowed-string-rep-litunion-consumption.vl`
// pins the six atom-typed DESTINATIONS over three string-repped spellings with one plain
// `if`; this file holds the destinations roughly fixed and varies the other two axes —
// the guard shape, and what the receiver's runtime rep actually is.
//
// The two reps a value can arrive in, and the crossing between them: an un-named litunion
// (the flattened `A | B`, the inline spelling) and a plain `string` are `(ref $array)`
// member strings, while a registered ALIAS interns as an i32 ATOM (`nodeTyIsLitUnionAlias`).
// Every consumption below writes into an ATOM slot, so a string-repped receiver crosses
// through `emitStrToAtom` and an already-atom receiver must not.
//
// EVERY GROUP SPELLS DISJOINT LEXEMES (#1304's method note).

// ── the GUARD SHAPES over one string-repped receiver ────────────────────────────
// A bare `if`, an `if`/`else`, a NEGATED guard with an early return, an `if` whose body
// contains a loop (the narrowing must survive into it), an `else if` chain narrowing each
// arm to a DIFFERENT alias, and a `for`-loop element binding.
// @log a:if:pa
// @log a:ifelse:pa
// @log a:neg:pa
// @log a:loop:pa
// @log a:chainA:pa
// @log b:chainB:pc
// @log a:for:pa
// @log b:for:pc
type PA = "pa" | "pb"
type PB = "pc" | "pd"
function gShapes(u: PA | PB, tag: string) {
  if u is PA {
    const r0: PA = u
    print(tag + ":if:" + r0)
  }
  if u is PA {
    const r1: PA = u
    print(tag + ":ifelse:" + r1)
  } else {
    print(tag + ":else")
  }
  if !(u is PA) {
    print(tag + ":neg-")
    return 0
  }
  const r2: PA = u
  print(tag + ":neg:" + r2)
  let n0 = 0
  while n0 == 0 {
    const r3: PA = u
    print(tag + ":loop:" + r3)
    n0 = 1
  }
  0
}
gShapes("pa", "a")
function gChain(u: PA | PB, tag: string) {
  if u is PA {
    const r0: PA = u
    print(tag + ":chainA:" + r0)
  } else if u is PB {
    const r1: PB = u
    print(tag + ":chainB:" + r1)
  } else {
    print(tag + ":none")
  }
  0
}
gChain("pa", "a")
gChain("pc", "b")
function gFor(xs: (PA | PB)[]) {
  for v in xs {
    if v is PA {
      const r0: PA = v
      print("a:for:" + r0)
    } else {
      const r1: PB = v
      print("b:for:" + r1)
    }
  }
  0
}
gFor(["pa", "pc"])

// ── the RECEIVER REPS, each narrowed to the SAME alias and consumed identically ──
// A flattened `QA | QB` param (string), the inline spelling (string), a plain `string`
// param (string), a value-union BOX whose string arm is not the tested type, a
// `string | null` narrowed to non-null, and an already-ATOM receiver as the control.
// @log flat:C:qa
// @log flat:R:qa
// @log inline:C:qa
// @log inline:R:qa
// @log str:C:qa
// @log str:R:qa
// @log box:C:qa
// @log box:R:qa
// @log nul:C:qa
// @log nul:R:qa
// @log atom:C:qa
// @log atom:R:qa
type QA = "qa" | "qb"
type QB = "qc" | "qd"
function takesQa(k: QA, tag: string) { print(tag + ":R:" + k) }
function rFlat(u: QA | QB, tag: string) {
  if u is QA {
    const r0: QA = u
    print(tag + ":C:" + r0)
    takesQa(u, tag)
  }
  0
}
rFlat("qa", "flat")
function rInline(u: ("qa" | "qb") | ("qc" | "qd"), tag: string) {
  if u is QA {
    const r0: QA = u
    print(tag + ":C:" + r0)
    takesQa(u, tag)
  }
  0
}
rInline("qa", "inline")
function rStr(u: string, tag: string) {
  if u is QA {
    const r0: QA = u
    print(tag + ":C:" + r0)
    takesQa(u, tag)
  }
  0
}
rStr("qa", "str")
function rBox(u: string | i32, tag: string) {
  if u is QA {
    const r0: QA = u
    print(tag + ":C:" + r0)
    takesQa(u, tag)
  }
  0
}
rBox("qa", "box")
function rNul(u: string | null, tag: string) {
  if u == null { return 0 }
  if u is QA {
    const r0: QA = u
    print(tag + ":C:" + r0)
    takesQa(u, tag)
  }
  0
}
rNul("qa", "nul")
function rAtom(u: QA, tag: string) {
  if u is QA {
    const r0: QA = u
    print(tag + ":C:" + r0)
    takesQa(u, tag)
  }
  0
}
rAtom("qa", "atom")

// ── the DESTINATIONS the sibling file does not reach: a `K`-valued MAP entry, and a
//    `return` of the narrowed value as `K` from the enclosing function.
// @log ta
// @log ta
// @log tb
type TA = "ta" | "tb"
type TB = "tc" | "td"
function dMap(u: TA | TB) {
  if u is TA {
    const mp: {[string]: TA} = Map()
    mp["k"] = u
    const mv = mp["k"]
    if mv != null { print(mv) } else { print("?") }
  }
  0
}
dMap("ta")
function dRet(u: TA | TB): TA {
  if u is TA { return u }
  return "tb"
}
const dr0 = dRet("ta")
print(dr0)
const dr1 = dRet("tc")
print(dr1)

// ── the ORIGIN of the receiver: a field read, an element read, a map read, a call
//    result and a module global all narrow and consume the same way.
// @log ua
// @log ua
// @log ua
// @log ua
// @log ua
type UA = "ua" | "ub"
type UB = "uc" | "ud"
type UF = { g: UA | UB }
function mkUa(): UA | UB { return "ua" }
const gUa: UA | UB = "ua"
function origins() {
  const so: UF = { g: "ua" }
  const o0 = so.g
  if o0 is UA {
    const r0: UA = o0
    print(r0)
  }
  const xs: (UA | UB)[] = ["ua"]
  const o1 = xs[0]
  if o1 is UA {
    const r1: UA = o1
    print(r1)
  }
  const mm: {[string]: UA | UB} = Map()
  mm["k"] = "ua"
  const o2 = mm["k"]
  if o2 != null {
    if o2 is UA {
      const r2: UA = o2
      print(r2)
    }
  }
  const o3 = mkUa()
  if o3 is UA {
    const r3: UA = o3
    print(r3)
  }
  const o4 = gUa
  if o4 is UA {
    const r4: UA = o4
    print(r4)
  }
  0
}
origins()
