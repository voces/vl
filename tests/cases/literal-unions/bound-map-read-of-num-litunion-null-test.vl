// @run
// @log 1
// @log miss
// @log 1
// @log miss
// @log 1
// @log null
// CONTRACT: an un-annotated binding of a `Map<string, N>` read, `N` a numeric literal union,
// is the `N | null` box, so a null test of it, a hit and a miss all agree with the binding's
// slot, at top level and in a function (D11241). The annotated spelling is in
// `bound-map-read-of-num-litunion-annotated.vl`: an annotation anywhere in the module would
// register the box that this file has to find from the read's type.

type N2 = 1 | 2

const x: N2 = 1
const m: Map<string, N2> = Map()
m.set("k", x)

const hit = m.get("k")
if hit != null { print(hit) }
const miss = m.get("z")
if miss == null { print("miss") }

function f() {
  const fm: Map<string, N2> = Map()
  fm.set("k", x)
  const v = fm.get("k")
  if v != null { print(v) }
  const w = fm.get("z")
  if w == null { print("miss") }
}

f()

function g() {
  if hit != null { print(hit) }
  print(miss)
}

g()
