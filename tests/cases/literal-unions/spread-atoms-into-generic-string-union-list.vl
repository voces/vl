// @run
// @log 3
// @log y
// @log 2
// @log y
// @log x
// @log s
// @log 3
// @log a
// @log y
// A generic's spread of a literal-union list into its `(T | string)[]` result, pinned at the
// union, widens each atom to its string, as the direct spelling's `string[]` spread does (D2968).
function ws<T>(xs: T[]): (T | string)[] { return [...xs, "s"] }
function sw<T>(xs: T[]): (T | string)[] { return ["s", ...xs] }
type K = "x" | "y"

const pb: K[] = ["y", "x"]
const g = ws(pb)
print(g.length)
const g0 = g[0]
if g0 is K {
  const e = g0
  print("\{e}")
}
g.push(g[0])
print(pb.length)
for e in ws(pb) { print(e) }
const ps = ["a"]
print(ws(pb).length)
print(ws(ps)[0])
print(sw(pb)[1])
