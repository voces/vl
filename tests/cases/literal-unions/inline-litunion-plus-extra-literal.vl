// @run
// @log a
// @log b
// @log e
// @log a
// @log b
// @log e
// @log a
// @log b
// @log e
// @log a
// @log b
// @log e
// @log a
// @log b
// @log e
// @log a
// @log b
// @log e
// @log a
// @log b
// @log e
// @log a
// @log a
// @log b
// @log yes
// @log no
// @log one
// @log two
// @log three
// A LITUNION BESIDE AN EXTRA LITERAL OF ITS OWN BASE IS ONE LITERAL UNION — D1043.
//
// `Kind | "err"` over `type Kind = "a" | "b"` IS the three-atom litunion `"a" | "b" | "err"`:
// flattening `Kind` reaches its LITERALS, and `"err"` is one more literal over the same base.
// The INLINE spelling used to be a loud emit reject (`emitProgram: literal `is` over a struct
// union is not supported`) while the DECLARED spelling `type R = Kind | "err"` ran — the two
// union routes disagreeing about one type, which is the shape `annUnionInnerTy`'s header
// exists to prevent.
//
// THE MEASURED MECHANISM WAS THE NAME CHANNEL, NOT THE FLATTEN — and the row's filed
// prediction said otherwise, so it is worth writing down. Probed at `emitIs` on BOTH
// spellings, every reading was identical (`exprIsLitAtom=N`, `exprUnion=Y`,
// `nodeTyIsLitUnion=N`, `tyIsLitUnion=N`, `tyLitUnionAliasIx=-1`, the same node member
// texts) except ONE: `unionNameOfExpr` answered `R` for the declared spelling and `""` for
// the inline one. The declared alias has a NAME whose member set the emitter's predicates
// can resolve (`unionMemberSetOf("R")` → `Kind | "err"`); the inline union has no name, and
// `emitUnionLitIs`' FIRST gate disjunct is `uname == ""`. So the declared spelling was
// running on the name channel over an arena shape neither route could rep — it worked by
// accident, and widening that gate cannot help (measured: deleting the gate entirely moves
// the inline program from one refusal to `union box atom test on a union with no recorded
// members:`, with an empty name).
//
// THE FIX IS THE FLATTEN, AT BOTH ROUTES, SO NEITHER SPELLING NEEDS A NAME:
// `litUnionFlatMembers` now admits a bare `TyLit` member of the common base, so both
// spellings mint `"a" | "b" | "err"` and take the ordinary literal-union rep.
//
// NOT THE SUBSUMPTION COLLAPSE (D1024), and the distinction is the whole of the ruling:
// `unionDropSubsumedArms` drops an arm that ADDS NO VALUES (`string | "err"` is `string`),
// while this ADDS the literal to a set that is still literal. All three atoms survive, and
// every case below DISCRIMINATES all three so a rule that ate one would fail here.

type Kind = "a" | "b"
type R = Kind | "err"

function disc(v: Kind | "err") {
  if v is "a" { print("a") } else { if v is "b" { print("b") } else { print("e") } }
}

// ── the return position: the spelling D1043 filed, beside its declared control ──────
function pick(n: i32): Kind | "err" {
  if n == 0 { return "a" }
  if n == 1 { return "b" }
  "err"
}
function pickDecl(n: i32): R {
  if n == 0 { return "a" }
  if n == 1 { return "b" }
  "err"
}

let i = 0
while i < 3 { disc(pick(i))  i = i + 1 }

let j = 0
while j < 3 { disc(pickDecl(j))  j = j + 1 }

// ── the delivery positions, one value per atom each ────────────────────────────────
const x0: Kind | "err" = "a"
const x1: Kind | "err" = "b"
const x2: Kind | "err" = "err"
disc(x0)
disc(x1)
disc(x2)

// PARAMETER — `disc` itself, reached with a bare literal argument.
disc("a")
disc("b")
disc("err")

type Bx = { k: Kind | "err" }
const b0: Bx = { k: "a" }
const b1: Bx = { k: "b" }
const b2: Bx = { k: "err" }
disc(b0.k)
disc(b1.k)
disc(b2.k)

const xs: (Kind | "err")[] = ["a", "b", "err"]
let e = 0
while e < xs.length { disc(xs[e])  e = e + 1 }

const m: {[string]: Kind | "err"} = Map()
m["p"] = "a"
m["q"] = "b"
m["r"] = "err"
disc(m["p"] ?? "err")
disc(m["q"] ?? "err")
disc(m["r"] ?? "err")

// GLOBAL ASSIGNMENT between two module globals (`emitAssign`'s `global.set` arm — the
// delivery a position matrix has missed before by reading call sites instead of running one).
let ga: Kind | "err" = "a"
let gb: Kind | "err" = "err"
disc(ga)
gb = ga
disc(gb)
ga = "b"
gb = ga
disc(gb)

// ── the type is one SET, whichever spelling names it ───────────────────────────────
// A value built at the inline spelling flows into the declared one and back.
function viaDecl(v: R): Kind | "err" { v }
const rt = viaDecl(x0)
if rt is "a" { print("yes") } else { print("no") }
const ru = viaDecl("err")
if ru is "a" { print("yes") } else { print("no") }

// ── the NUMERIC twin: the rule is about the common BASE, not about strings ─────────
// `KN | 3` over `type KN = 1 | 2` is the three-atom numeric litunion `1 | 2 | 3`. It refused
// with a DIFFERENT sentence before the fix (`union box atom test on a union with no recorded
// members: i32`), which is why it is here: one flatten serves both bases, and a fixture that
// only swept strings would not have said so.
type KN = 1 | 2
function pn(n: i32): KN | 3 {
  if n == 0 { return 1 }
  if n == 1 { return 2 }
  3
}
let k = 0
while k < 3 {
  const rn = pn(k)
  if rn is 1 { print("one") } else { if rn is 2 { print("two") } else { print("three") } }
  k = k + 1
}
