// @check
// @error cannot compare 2 | 3 with 1 — not a member of the union

// Once a compare against a literal `const` has narrowed its member away, a later compare against
// it is refused, as the same compare against the literal is.
type N = 1 | 2 | 3

const ONE = 1

function again(n: N) {
  if n == ONE { return 0 }
  if n == ONE { return 1 }
  2
}

print(again(2))
