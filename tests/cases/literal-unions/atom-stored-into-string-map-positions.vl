// @run
// @log circle
// @log square
// @log square
// @log circle
// @log circle
// A literal-union atom stored into a string-valued map is decoded to its member's string: a field
// read, a parameter through `.set`, a local, a global, and a `string | null`-valued map.
type K = "circle" | "square"
type H = { k: K }
function fromField(h: H) {
  const m: { [string]: string } = Map()
  m["a"] = h.k
  print(m["a"] ?? "none")
}
function fromParam(k: K) {
  const m: { [string]: string } = Map()
  m.set("b", k)
  print(m["b"] ?? "none")
}
function fromLocal() {
  const k: K = "square"
  const m: { [string]: string } = Map()
  m["c"] = k
  print(m["c"] ?? "none")
}
const gk: K = "circle"
function fromGlobal() {
  const m: { [string]: string } = Map()
  m["d"] = gk
  print(m["d"] ?? "none")
}
function intoNullable(k: K) {
  const m: { [string]: string | null } = Map()
  m["e"] = k
  print(m["e"] ?? "none")
}
fromField({ k: "circle" })
fromParam("square")
fromLocal()
fromGlobal()
intoNullable("circle")
