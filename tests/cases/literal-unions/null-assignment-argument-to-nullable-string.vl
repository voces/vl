// @run
// @log true
// @log true
// An assignment of `null` to a literal-union cell, passed as a `string | null` argument, is
// that `null` (D17261); so is one to a module global's cell.
type M = "nn" | "mm"
function takeS(s: string | null) { print(s == null) }
function f() {
  let m: M | null = "nn"
  takeS(m = null)
}
f()
let g: M | null = "mm"
takeS(g = null)
