// A module-scope `if` whose arm is a `K | null` global narrowed to null, beside a string,
// joins to `string | null` and prints `null`, bound, inline and as an argument (D4172).
type K = "a" | "b"

function show(v: string | null) { print(v ?? "none") }

function showU<U>(v: U) { print(v) }

const a1: K | null = null
const v = if a1 == null { a1 } else { "z" }
print(v)
print(if a1 == null { a1 } else { "z" })
show(if a1 == null { a1 } else { "z" })
showU(if a1 == null { a1 } else { "z" })
const a2: K | null = "b"
const v2 = if a2 == null { a2 } else { "z" }
print(v2)
// @log null
// @log null
// @log none
// @log null
// @log z
