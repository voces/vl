// @run
// @hint redundant type annotation: `m` is inferred as `M` — remove it to lean on inference
// @log one a! b!
// @log 11
// @log xy
// @log yx
// @log qnullr

// A compare narrows a union whose members are of different kinds, which lives in a box, the
// same way `is` does: the narrowed branch reads the unboxed member. A field, a list element
// and a nullable union narrow through the same test.
type M = 1 | "a" | "b"
type R = { k: "x" | "y" }

function pm(i: i32): M {
  if i == 0 { return 1 }
  if i == 1 { return "a" }
  "b"
}
function only1(v: 1) { v + 10 }
function onlyAB(v: "a" | "b") { v + "!" }
function onlyX(v: "x") { v }
function onlyY(v: "y") { v }
function onlyQ(v: "q") { v }

function boxed(i: i32) {
  const m = pm(i)
  if m == 1 { return "one" + (if only1(m) == 11 { "" } else { "?" }) }
  onlyAB(m)
}
function boxedElse(i: i32) {
  const m: M = pm(i)
  if m != 1 { return 0 }
  only1(m)
}
function field(r: R) {
  if r.k == "x" { return onlyX(r.k) }
  onlyY(r.k)
}
function element(ks: ("x" | "y")[]): string {
  if ks[0] == "y" { return onlyY(ks[0]) }
  onlyX(ks[0])
}
function nullable(v: "q" | "r" | null) {
  if v == "q" { return onlyQ(v) }
  if v == null { return "null" }
  v
}

print(boxed(0) + " " + boxed(1) + " " + boxed(2))
print(boxedElse(0) + boxedElse(1))
print(field({ k: "x" }) + field({ k: "y" }))
print(element(["y"]) + element(["x"]))
print(nullable("q") + nullable(null) + nullable("r"))
