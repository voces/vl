// @run
// @log true true false
// @log true false false false
// @log int 2
// @log float 2
// @log float 2.5
// @log true false false
// An `is` test whose set holds integer literals dispatches on the member's rep before it
// compares values, so an integer literal is never equal to a float of the same value: over
// `1 | 2 | f64`, `is 2` holds for the integer `2` and not for the float `2.0` (D2221).
function inSet(m: 1 | 2 | 3) { m is 2 | 3 }
function isTwo(m: 1 | 2 | f64) { m is 2 }
function show(m: 2 | f64) {
  if m is 2 { return "int \{m}" }
  "float \{m}"
}
function nullable(m: 1 | 2 | null) { m is 2 }

print("\{inSet(3)} \{inSet(2)} \{inSet(1)}")
print("\{isTwo(2)} \{isTwo(1)} \{isTwo(2.0)} \{isTwo(2.5)}")
print(show(2))
print(show(2.0))
print(show(2.5))
print("\{nullable(2)} \{nullable(1)} \{nullable(null)}")
