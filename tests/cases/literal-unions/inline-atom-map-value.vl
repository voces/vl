// @run
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// @log 2
// @log 2
// @log 1
// @log 1
// An INLINE literal union as a MAP VALUE — `{[string]: ("a" | "b")}` and
// `{[string]: ("a" | "b")[]}` — in every position that decides the map's shape slot, each
// PAIRED with its `K` alias control on the adjacent line.
//
// WHY IT IS A FIXTURE. The map's VALUE kind is read out of the map's rendered spelling
// (`mvValKindOfName(mapValNameOf(t))`). While `canonEmitName` softened a bare inline literal
// union to its base scalar, that spelling said `{[string]:string}` / `{[string]:string[]}`
// — a STRING-valued map — for a map whose stores build interned i32 ATOM ids, so every
// non-empty store was invalid wasm while the `K` spelling (the MONO i32 atom map) ran. The
// canon pass now keeps the members at a map VALUE, one of the four positions the structural
// renderer already keeps a litunion ALIAS at.
//
// `takesAlias(mkInline())` is the identity line: an inline-spelled map handed to a
// `{[string]: K[]}` parameter. A litunion map's shape slot is keyed by the VALUE spelling,
// so two spellings of one type mint two slots and the argument arrives as the wrong struct
// — which is exactly what a per-spelling row does whether the spelling is softened or
// preserved. The declared alias therefore WINS the canon spelling when the program declares
// one, so the two columns converge on a single name.

type K = "a" | "b"

const gInline: {[string]: ("a" | "b")[]} = Map()
const gAlias: {[string]: K[]} = Map()

type SInline = { m: {[string]: ("a" | "b")[]} }
type SAlias = { m: {[string]: K[]} }

function takesInline(m: {[string]: ("a" | "b")[]}) { print(m.size) }
function takesAlias(m: {[string]: K[]}) { print(m.size) }

function mkInline(): {[string]: ("a" | "b")[]} {
  const m: {[string]: ("a" | "b")[]} = Map()
  m["k"] = ["a", "b"]
  return m
}
function mkAlias(): {[string]: K[]} {
  const m: {[string]: K[]} = Map()
  m["k"] = ["a", "b"]
  return m
}

// The BARE (non-array) litunion value — the map is the mono i32 atom map for both spellings.
function bare() {
  const mi: {[string]: ("a" | "b")} = Map()
  mi["k"] = "a"
  print(mi.size) // 1
  const ma: {[string]: K} = Map()
  ma["k"] = "a"
  print(ma.size) // 1
}

function locals() {
  const mi: {[string]: ("a" | "b")[]} = Map()
  mi["k"] = ["a"]
  print(mi.size) // 1
  const ma: {[string]: K[]} = Map()
  ma["k"] = ["a"]
  print(ma.size) // 1

  const si: SInline = { m: mi }
  print(si.m.size) // 1
  const sa: SAlias = { m: ma }
  print(sa.m.size) // 1

  // The READ side: the value comes back as the atom list it was stored as.
  const vi = mkInline()["k"]
  if vi != null { print(vi.length) } // 2
  const va = mkAlias()["k"]
  if va != null { print(va.length) } // 2
}

gInline["k"] = ["a"]
gAlias["k"] = ["a"]
print(gInline.size) // 1
print(gAlias.size) // 1
bare()
locals()
takesInline(mkInline())
takesAlias(mkInline()) // the two spellings meet: one type, one shape slot
