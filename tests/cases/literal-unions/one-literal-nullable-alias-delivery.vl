// D7446: `"circle" | null` and a one-literal alias's `KC | null` are one type and one atom
// niche, so either delivers into the other at a binding, assignment, argument, result,
// list read and record field, annotated or not.
// @run
// @log circle
// @log circle
// @log none
// @log circle
// @log circle
// @log circle
// @log none
// @log circle
// @log circle
// @log circle
// @log circle
// @hint redundant type annotation: `b` is inferred as `"circle" | null`
// @hint redundant type annotation: `c` is inferred as `"circle" | null`
// @hint redundant type annotation: `d` is inferred as `"circle" | null`
// @hint redundant type annotation: `e` is inferred as `KC | null`
// @hint redundant type annotation: `take` is inferred as `string`
// @hint redundant type annotation: `h` is inferred as `KC | null`
// @hint redundant type annotation: `i` is inferred as `"circle" | null`
// @hint redundant type annotation: `t` is inferred as `{k: "circle" | null}`
type KC = "circle"
const a: "circle" | null = "circle"
const n: "circle" | null = null
const b: KC | null = a
print(b ?? "none")
const b2 = a
const c: KC | null = b2
print(c ?? "none")
const d: KC | null = n
print(d ?? "none")
const e: "circle" | null = b
print(e ?? "none")
let g: KC | null = null
g = a
print(g ?? "none")
function take(p: KC | null): string { p ?? "none" }
print(take(a))
print(take(n))
function give(): KC | null { a }
const h: "circle" | null = give()
print(h ?? "none")
const xs: ("circle" | null)[] = ["circle", null]
const i: KC | null = xs[0]
print(i ?? "none")
const s: { k: "circle" | null } = { k: "circle" }
const t: { k: KC | null } = s
print(t.k ?? "none")
if b != null { print(b) }
