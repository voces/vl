// @run
// @log b!
// @log a
// @log true
// @log b
// `as!` and `as?` to a string literal-union arm of a box compare the string payload against
// each member, and a named target converts the hit to its atom (D11221).
type K = "a" | "b"
function mk(k: i32): K | i32 {
  if k == 0 { return 7 }
  if k == 1 { return "a" }
  "b"
}
const v = mk(2) as! K
print(v + "!")
const o = mk(1) as? K
if o != null { print(o) }
print((mk(0) as? K) == null)
function pick(k: i32): K { mk(k) as! K }
print(pick(2))
