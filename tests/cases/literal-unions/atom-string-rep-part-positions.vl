// @run
// @log tt!
// @log [tt]
// @log not ss
// @log no
// @log uu?
// @log none
// @log out xx
// @log in yy
// @log out ww
// @log <bb>
// @log 4
// @log vv.
// A literal-union part narrowed to one string member joins as that member's string, though the
// value it reads is held as the wider set's atom: a literal test or `is string` out of a set that
// also holds `null`, an overlap test onto one member, and a generic call's result read in a
// closure. A set beside an integer is boxed instead, and still joins as its string.
function pick(x: "ss" | "tt" | null) {
  if x is "tt" {
    print(x + "!")
    print("[\{x}]")
  } else if x != null {
    print("not " + x)
  } else {
    print("no")
  }
}
function one(x: "uu" | null) {
  if x is string { print(x + "?") } else { print("none") }
}
type M = "xx" | "yy" | "ww"
function overlap(m: M) {
  if m is "yy" | "zz" { print("in " + m) } else { print("out " + m) }
}
type K = "aa" | "bb"
function id<X>(a: X): X { return a }
function gen(e: K | null | f64) {
  if e != null && !(e is f64) {
    const f = () => id(e)
    print("<\{f()}>")
  } else if e is f64 {
    print(e + 1.0)
  }
}
function boxed(x: "vv" | 7 | null) {
  if x is string { print(x + ".") }
}
pick("tt")
pick("ss")
pick(null)
one("uu")
one(null)
overlap("xx")
overlap("yy")
overlap("ww")
gen("bb")
gen(3.0)
boxed("vv")
