// @run
// @log y
// @log z
// @log z!
// @log x
// @log 2
// @log y
// An un-annotated binding of an `if` or `match` joining two literal-union lists is the atom
// list its arms are, read back as a return, as an argument, by `.length` and by `for` (D5280).
type A = "x" | "y" | "z"
const P: A[] = ["x", "y"]
const Q: A[] = ["z"]
function show(a: A) { a + "!" }
function pick(c: boolean, i: i32): A {
  const pool = if c { P } else { Q }
  pool[i]
}
function pickArg(n: i32, i: i32) {
  const pool = match n {
    0 => P
    _ => Q
  }
  show(pool[i])
}
function count(c: boolean) {
  let pool = if c { P } else { Q }
  if pool.length == 0 { pool = P }
  pool.length
}
print(pick(true, 1))
print(pick(false, 0))
print(pickArg(1, 0))
const top = if P.length > 1 { P } else { Q }
for a in top {
  if a == "x" { print(a) }
}
print(count(true))
print(top[1])
