// @run
// @log B
// @log B
// @log B
// @log B
// @log B
// @log B
// @log B
// @log B
// @log B
// @log B
// @log B
// @log B
// @log B
// @log B
// @log B
// @log noise
// @log B
// @hint redundant type annotation: `ifArmTail` is inferred as `string`
// @hint redundant type annotation: `elseIfArmTail` is inferred as `string`
// @hint redundant type annotation: `nestedIfArmTail` is inferred as `string`
// A LITERAL-UNION ATOM MATERIALISED AT A FUNCTION'S IMPLICIT-RETURN TAIL. A VL function's
// value is its LAST STATEMENT, so `function tag(k: K): string { k }` is the same widen as
// `{ return k }` — `emitFuncBody` routes the tail through `emitReturnExit` / `emitIfTail`
// into the same `emitReturnValue`, which lowers the atom→string `select` tower and stashes
// the atom id in the string-op scratch frame. That frame is reserved by `emit_classify`'s
// scan (`fnHasStrOp`), whose statement dispatch asks the atom-widening question only under
// `RetStmt` — and does not carry a bare trailing `Ident` at all. Unreserved, the tower's
// `local.set <strScratchBase>` names an index past the end of the locals vector: `vl check`
// clean, engine reject ("unknown local N: local index out of bounds").
//
// EVERY FUNCTION HERE IS ISOLATED, and that is the point. The widen is the function's ONLY
// string op; the printing happens at top level. A `print(<string>)` beside the tail reserves
// the frame by itself and the cell passes with the tail leg deleted — `contaminatedTail` at
// the end keeps that shape visible as the negative control.
//
// THE TAIL SPELLING MUST EMIT WHAT THE `return` SPELLING EMITS. `bareTail` and `returnTwin`
// below are the same function twice; their bodies are byte-identical wasm, which is the
// oracle this file pins. Delete `fnHasStrOp`'s `fnTailWidensAtomToStr` leg and every
// function above `contaminatedTail` goes INVALID WASM while `returnTwin` keeps running.

type K = "A" | "B" | "C" | "D"

// ── the tail VALUE routes (`stmtIsTailValue` → `emitReturnExit`) ──────────────
function bareTail(k: K): string { k }
print(bareTail("B"))

// The control: the same widen spelled `return`, which the scan already claimed.
function returnTwin(k: K): string { return k }
print(returnTwin("B"))

function parenTail(k: K): string { (k) }
print(parenTail("B"))

// The tail is an Ident bound to the atom — the binding itself widens nothing (an
// un-annotated `const` of a `K` stays a `K`), so only the tail can reserve the frame.
function bindTail(k: K): string {
  const kv = k
  kv
}
print(bindTail("B"))

// Leading statements before the tail: the scan walks them for narrowing, not for the widen.
function stmtBeforeTail(k: K): string {
  const n = 1
  const n2 = n + 1
  if n2 > 99 { print(n2) }
  k
}
print(stmtBeforeTail("B"))

// A brace-less body is the same tail, one syntax over.
function bracelessTail(k: K): string k
print(bracelessTail("B"))

// An expression-body arrow, likewise.
const arrowTail = (k: K): string => k
print(arrowTail("B"))

// A field read / an element read / a call result reach the tail as non-Ident expressions.
function fieldTail(): string {
  const o: { k: K } = { k: "B" }
  o.k
}
print(fieldTail())

function elemTail(): string {
  const ks: K[] = ["B"]
  ks[0]
}
print(elemTail())

function kOf(): K { return "B" }
function callTail(): string { kOf() }
print(callTail())

// ── the tail `if` routes (`lastStmtIsValueIf` → `emitIfTail`) ─────────────────
// A DIFFERENT emit path from the bare tail: each arm's own last statement is the
// function's value, so the scan has to recurse into both arms under the arm narrowing.
function ifArmTail(k: K, c: boolean): string {
  if c { k } else { "A" }
}
print(ifArmTail("B", true))

// The `else` of an `else if` chain is a lone nested `IfStmt`, still in tail position.
function elseIfArmTail(k: K, c: boolean): string {
  if !c { "A" }
  else if c { k }
  else { "C" }
}
print(elseIfArmTail("B", true))

function nestedIfArmTail(k: K, c: boolean): string {
  if c {
    if c { k } else { "A" }
  } else {
    "C"
  }
}
print(nestedIfArmTail("B", true))

// ── the tail widen into a UNION BOX, not a bare `string` ──────────────────────
// `unionTakesAtomAsStr`'s union leg reached from tail position: the atom widens to its
// member string and is stored at the box's `anyref` payload.
function boxTail(k: K): K | f64 { k }
const boxed = boxTail("B")
if boxed is K { print(boxed) } else { print("O") }

// ── the LIFTED-CALLBACK route ─────────────────────────────────────────────────
// A `.map` callback is its own emitted function; its tail widens on its own frame.
const ks: K[] = ["B"]
const widened = ks.map((kk: K): string => {
  kk
})
print(widened[0])

// ── THE CONTAMINATED SHAPE, kept on purpose ──────────────────────────────────
// The `print` is itself a string op and reserves the frame, so this cell passes even with
// the tail leg deleted. It is the negative control for every function above.
function contaminatedTail(k: K): string {
  print("noise")
  k
}
print(contaminatedTail("B"))
