// @emit-error `is` over a literal union needs a re-readable receiver
// CONTRACT (must-error): `src(s) is K` over a plain `string` receiver that is not a PLACE.
//
// The answer is MEMBERSHIP over K's member set, which re-reads the receiver once per member;
// a call result is not re-readable and no spill slot is reserved for this shape, so the
// emitter floors LOUDLY rather than falling through to the static-`is` fold, which
// const-folds the guard to FALSE — a `vl check`-clean branch that can never run.
//
// The string-rep twin of `is-litunion-arm-call-receiver-rejected.vl` (the box rep), and the
// two share one message: it is the same refusal for the same reason.
//
// A ONE-member tested type evaluates the receiver exactly ONCE, so it is NOT floored — and
// neither is any receiver that IS a place (`is-litunion-over-string-receiver.vl` pins the
// `let` / field / element / global forms running and answering correctly).

type CK = "ca" | "cb"

function src(s: string): string { return s }

function probe(s: string) {
  if src(s) is CK { print("yes") } else { print("no") }
  0
}

probe("ca")
