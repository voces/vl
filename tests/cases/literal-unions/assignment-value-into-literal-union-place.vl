// @run
// @log b
// @log b
// @log b
// @log b
// @log b
// @log true
// A string literal assigned into a literal-union place is that literal's atom, as it is in a
// direct binding, so the assignment's value has the literal's type: an annotated binding of it
// checks, and an un-annotated one prints through its member texts (D14822).
type K = "a" | "b"
let s: "a" | "b" = "a"
const q: "a" | "b" = (s = "b")
print(q)
const r = (s = "b")
print(r)
let k: K = "a"
const t = (k = "b")
print(t)
function g() {
  let u: "a" | "b" = "a"
  const v: "a" | "b" = (u = "b")
  print(v)
  const w = (u = "b")
  print(w)
}
g()
print(r == "b")
