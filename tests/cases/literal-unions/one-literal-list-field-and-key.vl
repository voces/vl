// @run
// A record field of a list of one integer literal is that literal's list (D16366), and a map or
// set keyed by one string literal hashes it as its one-member set's atom (D16367).
type W = { f: 7[] }
const w: W = { f: [7] }
w.f.push(7)
print(w.f[0] + w.f.length)
type B = { f: 9000000000[] }
const b: B = { f: [9000000000] }
print(b.f[0])
const s: Set<"a"> = Set()
s.add("a")
print(s.has("a"))
const m: Map<"a", i32> = Map()
m.set("a", 1)
print(m.get("a") ?? 0)
const a: "a" = "a"
const t = Set()
t.add(a)
print(t.length)
// @log 9
// @log 9000000000
// @log true
// @log 1
// @log 1
