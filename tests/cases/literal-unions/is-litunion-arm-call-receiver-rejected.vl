// @emit-error `is` over a literal-union arm needs a re-readable receiver
// CONTRACT (must-error): `src() is K` over a value union carrying the literal-union alias
// `K` beside a `string` arm.
//
// `K` rides the box as its member STRING, so it shares kind 2's box tag with the `string`
// arm and the tag compare CANNOT decide the question — it answers TRUE for every string
// the box holds. The answer is MEMBERSHIP over the payload, which re-reads the receiver
// once per member (twice: tag, then payload), so it needs a re-readable PLACE. A call
// result is not one, and there is no spill slot reserved for this shape, so the emitter
// floors LOUDLY here rather than falling back on a tag compare that is known wrong: master
// ran this program and printed `yes` for the non-member `"zz"`.
//
// The receiver forms that ARE places — a field path, an element read, a map read — run and
// answer correctly; `is-litunion-arm-non-ident-receivers.vl` is their pin.

type K = "a" | "b"

function src(): K | string { return "zz" }

function probe() {
  if src() is K { print("yes") } else { print("no") }
  0
}

probe()
