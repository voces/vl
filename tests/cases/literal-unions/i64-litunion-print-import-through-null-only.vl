// @run
// @log none
// @log none
// CONTRACT: a wide-integer literal TYPE mentions i64, so a program whose emitted body reaches an
// i64 `print` gets the `__print_i64__` import even when no i64 VALUE is spelled anywhere.
//
// `repTyScalarMask`'s `TyLit` arm descends through `litBaseTy`, the single home for a literal's
// base scalar. The one inhabitant of `W | null` that is not a member is `null`: with it the only
// value in the file, a scan of spelled literals sees no wide integer, and the narrowed `print(p)`
// — an i64 out of the box's value box — would call an import the section never declared.
//
// No wide-integer literal appears in a value position, and that is the pin: the scan is
// module-wide, so a single `takes(5000000000)` would claim the import by the literal route.
// Both branches are still emitted, so the import must exist though every call takes the else-arm.

type W = 5000000000 | 6000000000

// the PARAM position
function takes(p: W | null) {
  if p is W { print(p) } else { print("none") }
}
takes(null)

// the local position, so the pin does not depend on the param classifier
function fromLocal() {
  const p: W | null = null
  if p is W { print(p) } else { print("none") }
}
fromLocal()
