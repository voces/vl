// @run
// @log 1
// @log -2
// @log 3
// A literal at a literal-union parameter, ahead of a valued `if`: it stages as the atom's id.
type Op = "lt" | "gt"
function t(o: Op, x: i32) { return if o == "lt" { x } else { 0 - x } }
function f(k: i32) { return t(if k == 2 { "gt" } else { "lt" }, k) }
function g(k: i32) {
  return t("lt", if k == 1 { 1 } else if k == 2 { 2 } else { 3 })
}
print(g(1))
print(f(2))
print(g(3))
