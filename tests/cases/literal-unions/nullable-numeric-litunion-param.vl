// @run
// @log 1
// @log 0
// @log 2
// @log 0
// @log 1
// @log 0
// @log 0
// CONTRACT: a NULLABLE NUMERIC literal union (`1 | 2 | null`, and the two-part `Z | null` over
// `type Z = 1 | 2`) is the value-union BOX at EVERY storage class, and the two null spellings
// (`x != null`, `x is null`) ask that box the same tag question.
//
// It is the one nullable shape NEITHER litunion rule claims. `tyIsNullableLitUnion` is the
// STRING niche (its `litKind != "str"` reject), and the numeric BASE collapse
// (`numLitUnionBaseName`, "`1 | 2` reps as `i32`") declines the moment a member is not a
// `TyLit` — which the `null` member is. `nulNumLitUnionBaseName` is that gap's home, and the
// rep it settles is `<base scalar> | null`, which is exactly the box a nullable i32 already
// gets. The `let` / global / element / field / map-value / `push` positions reached the box
// through the ladder's NAME test all along; the PARAM cell was the `"i32"` default, i.e. a slot
// that cannot hold the null its own annotation admits — `emitProgram: bare null needs a
// struct-typed context` at `f(null)` and at `x != null`, and `vl check`-clean invalid wasm for
// `x is null`.
//
// The CONTROLS that place this: `1 | 2` without the `| null` is a plain i32 param (below), and
// `i32 | null` — the same box, spelled with the base scalar — was correct at every position.
//
// STILL LOUD, and not by accident: `return null` from a `1 | 2 | null` function. The functype
// result and the boxed `return` both follow `vtKindOfType`, but the CALL-RESULT classifier is a
// third home (`computeRetInference`), so moving only the first two left the receiving local an
// i32 and turned a loud reject into invalid wasm — measured, then declined.

function takes(x: 1 | 2 | null) {
  if x != null { print(1) } else { print(0) }
}

takes(1)
takes(null)

type Z = 1 | 2

function takesAlias(x: Z | null) {
  if x != null { print(2) } else { print(0) }
}

takesAlias(2)
takesAlias(null)

// the `is null` spelling of the same question, over the same rep
function tests(x: 1 | 2 | null) {
  if x is null { print(0) } else { print(1) }
}

tests(2)
tests(null)

// CONTROL: the non-null numeric litunion is a plain i32 param and stays one.
function plain(x: 1 | 2): i32 { x }

print(plain(1) - 1)
