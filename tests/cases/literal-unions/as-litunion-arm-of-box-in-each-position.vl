// @run
// @log 102
// @log a
// @log b
// @log <a>
// @log [2|b]
// @log 1
// @log b
// @log 6
// @log a
// @log b
// @log 1
// @log 0
// @log b
// @log none
// @log 1
// @log a
// @log 12
// @log x
// @log a!
// @log 9
// A cast of a union box to a numeric and a string literal-union arm (`as!`, `as?`, `as`) in each
// position: a scalar and a union argument, a nested argument, a concat operand, an interpolation
// hole, a return, an initializer, an `if` arm, a `??` operand and a record field.
type N2 = 1 | 2
type S = "a" | "b"
type R = { n: N2, s: S }
function mkN(k: i32): N2 | string {
  if k == 1 { return 1 }
  else if k == 2 { return 2 }
  else { return "x" }
}
function mkS(k: i32): S | i32 {
  if k == 1 { return "a" }
  else if k == 2 { return "b" }
  else { return k }
}
function plus(n: i32): i32 { return n + 100 }
function showU(u: S | boolean): string {
  if u is boolean { return "bool" } else { return u }
}
function idS(s: S): S { return s }
function argScalar(k: i32): i32 { return plus(mkN(k) as! N2) }
function argUnion(k: i32): string { return showU(mkS(k) as! S) }
function argNested(k: i32): string { return showU(idS(mkS(k) as! S)) }
function concat(k: i32): string { return "<" + (mkS(k) as! S) + ">" }
function interp(k: i32): string { return "[\{mkN(k) as! N2}|\{mkS(k) as! S}]" }
function retN(k: i32): N2 { return mkN(k) as! N2 }
function retS(k: i32): S { return mkS(k) as! S }
function letInit(k: i32): i32 {
  const n = mkN(k) as! N2
  return n * 3
}
function ifArm(k: i32, c: boolean): S {
  const s: S = if c { mkS(k) as! S } else { "b" }
  return s
}
function coalN(k: i32): i32 { return (mkN(k) as? N2) ?? 0 }
function coalS(k: i32): string { return (mkS(k) as? S) ?? "none" }
function rec(k: i32): R {
  const r: R = { n: mkN(k) as! N2, s: mkS(k) as! S }
  return r
}
function propN(k: i32): i32 | string {
  const n = mkN(k) as N2
  return n + 10
}
function propS(k: i32): string | i32 {
  const s = mkS(k) as S
  return s + "!"
}
print(argScalar(2))
print(argUnion(1))
print(argNested(2))
print(concat(1))
print(interp(2))
print(retN(1))
print(retS(2))
print(letInit(2))
print(ifArm(1, true))
print(ifArm(1, false))
print(coalN(1))
print(coalN(0))
print(coalS(2))
print(coalS(7))
const r = rec(1)
print(r.n)
print(r.s)
print(propN(2))
print(propN(0))
print(propS(1))
print(propS(9))
