// @run
// @log green
// @log green
// @log green
// @log green
// @log green
// @log green
// @log green
// @log red
// @log green
// @hint redundant type annotation: `v` is inferred as `"red" | "green"` — remove it to lean on inference

// D1783 — the INLINE twin of the anonymous holder's literal-union field. `fieldCodeOfSpelling`
// splits the declared spelling two ways (an inline member set is the string slot, a registered
// alias is the atom) and the anonymous mint had only the alias half, so the inline field fell
// to a spellability gate that declines a union and the whole literal lost its row.
//
// NO `type` DECLARATION MAY BE ADDED TO THIS FILE. An alias over the same member set takes the
// atom rung instead, every holder mints, and the file stops pinning anything — that spelling is
// `anon-holder-litunion-field.vl`, this one's sibling.
const srcArr: ("red" | "green")[] = ["green", "red"]

// The three value sources that all reached the gate: a list element, a binding fed by one, and
// a call. Only a bare member literal ran, because its type is a `TyLit` and not a union.
const w1 = { f: srcArr[0] }
print(w1.f)

const v: "red" | "green" = srcArr[0]
const w2 = { f: v }
print(w2.f)

function pick(): "red" | "green" { return "green" }
const w3 = { f: pick() }
print(w3.f)

// A second field beside it, so the mint is graded on a row it shares.
const w4 = { f: srcArr[0], n: 1 }
print(w4.f)

// Inside a function frame, where the same miss reports as `object literal but no struct type
// declared` rather than as a valtype with no shape.
function inFn() {
  const w = { f: srcArr[0] }
  print(w.f)
}
inFn()

// The holder as a list element, and read back through the element.
const ws = [{ f: srcArr[0] }]
print(ws[0].f)

// A closure capturing the holder, the boundary that costs a row twice over.
const w5 = { f: srcArr[0] }
const g = () => w5.f
print(g())

// The second member, so a green cell cannot be one member printing by luck.
const w6 = { f: srcArr[1] }
print(w6.f)

// The control that always ran: a bare member literal is a plain string field.
const w7 = { f: "green" }
print(w7.f)
