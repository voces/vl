// @log true
// An atom compare whose right operand is a `??` over a `K | null` (a valued `if`), with the left a
// literal, a parameter, a field and a call, under `==` and `!=`, in a function and at the top.
type K = "a" | "b"
type R = { k: K }
function lit(s: K | null) { return "a" == (s ?? "b") }
function litNe(s: K | null) { return "b" != (s ?? "b") }
function param(s: K | null, t: K) { return t == (s ?? "b") }
function field(s: K | null, r: R) { return r.k == (s ?? "a") }
function pick(): K { return "b" }
function call(s: K | null) { return pick() != (s ?? "b") }
print(lit("a"))
print(lit(null))
print(litNe(null))
print(param("a", "a"))
print(param(null, "b"))
print(field("b", { k: "a" }))
print(field(null, { k: "a" }))
print(call(null))
const g: K | null = null
print("b" == (g ?? "b"))
print(call("a"))
