// @run
// @log p
// @log N
// @log q
// @log hit
// @log N
// @log miss
// @log A
// @log B
// @log B
// @log vp
// @log vq
// @log p
// @log q
// @log p
// @log q
// CONTRACT (companion to `nullable-litunion-element-read.vl`): every CONSUMER of a
// `(K | null)[]` element works once the element is narrowed — the `!= null` test itself, a member
// `==`, an `is` membership test, string concatenation, a `string` parameter and a `K` parameter.
// The oracle is the `(string | null)[]` spelling, which does all of this today.
//
// THIS FILE IS A BUILD-VERDICT PIN, not a log pin: master REJECTED each of these
// (`emitProgram: bare null needs a struct-typed context`) rather than mis-running them, because
// the `!= null` test on the loop var found no niche arm and emitted a struct null. A for-in loop
// var is the one storage class `exprNulLitUnion`'s Ident arm cannot resolve — no capture, no
// param, no `let`, no global, and no declaration node to read an annotation off — so it reads the
// checker's recorded type for that read, which is the niche only where the read is un-narrowed.
//
// Each loop var has a DISTINCT name: capture analysis is name-keyed module-wide, and a shared
// name would mask what this pins.

type K = "p" | "q"

function showStr(s: string) { print(s) }
function showK(v: K) { print(v) }

const xs: (K | null)[] = ["p", null, "q"]

// The `!= null` narrowing itself.
for a in xs {
  if a != null { print(a) } else { print("N") }
}

// A member `==` inside the narrowed branch.
for b in xs {
  if b != null {
    if b == "p" { print("hit") } else { print("miss") }
  } else { print("N") }
}

// An `is` membership test on the UN-narrowed element: a null is a member of no tested set, so it
// takes the else arm.
for c in xs {
  if c is "p" { print("A") } else { print("B") }
}

// Concatenation, a `string` parameter and a `K` parameter — the three string-side boundaries the
// atom has to widen at.
for d in xs {
  if d != null { print("v" + d) }
}
for e in xs {
  if e != null { showStr(e) }
}
for f in xs {
  if f != null { showK(f) }
}
