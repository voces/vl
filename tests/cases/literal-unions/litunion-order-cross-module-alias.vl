// @run
// CONTRACT: an INLINE `("file" | "dir")` ordering answers on MEMBER TEXT even when a
// same-layout alias is declared in ANOTHER MODULE. The companion to
// `litunion-order-is-member-text.vl`, whose inline row has the alias in the same file — this
// one is the reason the defect's scope statement had to say "the whole compiled program".
//
// `std/fs.vl` declares `export type FileKind = "file" | "dir"`. Before the fix, that
// declaration ANYWHERE in the program graph was enough to move the inline spelling onto the
// interned-id ordering: `import { pathKind } from "std:fs"` alone — the alias neither
// imported nor named here — flipped this sort from `dir file` to `file dir`, because `"file"`
// is interned first and so gets the lower id. Nothing in the sorting module mentioned the
// type declaration that decided its answer.
//
// The import is USED (`FileKind` annotates `named` below) so the case carries no lint
// directive, but the load-bearing half is the INLINE array: it is spelled `("file" | "dir")[]`
// and never `FileKind[]`.
import { FileKind } from "std:fs"
import { sorted } from "std:array"

const named: FileKind = "file"
// @log file
print(named)

const kinds: ("file" | "dir")[] = ["file", "dir", "file"]
const s = kinds.sorted((a: "file" | "dir", b: "file" | "dir") => a < b)
// @log dir
print(s[0])
// @log file
print(s[1])
// @log file
print(s[2])

// The same question asked of the IMPORTED alias itself, which is the atom rep proper.
const d: FileKind = "dir"
// @log true
print(d < named)
// @log false
print(named <= d)
