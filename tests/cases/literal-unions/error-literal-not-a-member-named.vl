// @error-at 13:21 cannot assign {tag: string, w: i32}[] to 'mixes' of type Mix[] — `"firr"` is not one of Tag: "fire" | "projectile" | "melee" (at `[1].tag`)
// @error-at 14:22 cannot assign i32[] to 'ks' of type (0 | 1)[] — `3` is not one of 0 | 1 (at `[1]`)
// @error-at 15:17 cannot assign {inner: {tag: string, w: i32}, tags: string[]} to 'o' of type Outer — `"meele"` is not one of Tag: "fire" | "projectile" | "melee" (at `tags[0]`)
// @error-at 16:22 cannot assign string to 'n' of type Tag | null — `"fier"` is not one of Tag: "fire" | "projectile" | "melee"
// @error-at 17:30 return type mismatch: expected Tag, got string — `"ice"` is not one of Tag: "fire" | "projectile" | "melee"
// @error-at 18:25 expected Tag, got string — `"wind"` is not one of Tag: "fire" | "projectile" | "melee"
// @error-at 20:13 argument 1: expected Mix, got {tag: string, w: i32} — `"melle"` is not one of Tag: "fire" | "projectile" | "melee" (at `tag`)
// diderven DV-202 — a typo in literal-union data is already a check error; the sentence names
// the literal, the union's members (`null` aside) and its path from the value's root, at a
// binding, a nested record, a nullable destination, a return, an arrow body and an argument.
type Tag = "fire" | "projectile" | "melee"
type Mix = { tag: Tag, w: i32 }
type Outer = { inner: Mix, tags: Tag[] }
const mixes: Mix[] = [{ tag: "fire", w: 40 }, { tag: "firr", w: 30 }]
const ks: (0 | 1)[] = [0, 3]
const o: Outer = { inner: { tag: "fire", w: 1 }, tags: ["meele"] }
const n: Tag | null = "fier"
function pick(): Tag { return "ice" }
const arrow = (): Tag => "wind"
function weight(m: Mix): i32 { m.w }
print(weight({ tag: "melle", w: 1 }) + mixes.length + ks.length + o.tags.length)
print(pick() == arrow())
print(n == null)
