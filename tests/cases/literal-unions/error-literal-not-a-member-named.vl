// @error-at 8:21 cannot assign {tag: string, w: i32}[] to 'mixes' of type Mix[] — `"firr"` is not one of Tag: "fire" | "projectile" | "melee" (field `tag`)
// @error-at 9:22 cannot assign i32[] to 'ks' of type (0 | 1)[] — `3` is not one of 0 | 1
// @error-at 11:13 argument 1: expected Mix, got {tag: string, w: i32} — `"melle"` is not one of Tag: "fire" | "projectile" | "melee" (field `tag`)
// diderven DV-202 — a typo in literal-union data is already a check error; the sentence now
// names the literal, the union's members and the field it sits in, through list elements,
// record fields and an argument.
type Tag = "fire" | "projectile" | "melee"
type Mix = { tag: Tag, w: i32 }
const mixes: Mix[] = [{ tag: "fire", w: 40 }, { tag: "firr", w: 30 }]
const ks: (0 | 1)[] = [0, 3]
function weight(m: Mix): i32 { m.w }
print(weight({ tag: "melle", w: 1 }) + mixes.length + ks.length)
