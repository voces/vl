// @run
// @log y
// @log true
// @log false
// @log k=x
// @log y!
// @log x
// An element of a hole list narrowed to a literal set's list is the string it is stored as: printed,
// bound and compared, compared directly, passed at the set, concatenated and returned.
type K = "x" | "y"
function name(k: K) { return "k=" + k }
function pr(a) {
  if a is K[] { print(a[0]) }
}
function cmp(a) {
  if a is K[] {
    const z = a[0]
    print(z == "y")
    print(a[1] == "y")
  }
}
function arg(a) {
  if a is K[] { print(name(a[1])) }
}
function cat(a) {
  if a is K[] { print(a[0] + "!") }
}
function back(a): string {
  if a is K[] { return a[0] }
  return "-"
}
pr(["y"])
cmp(["y", "x"])
arg(["y", "x"])
cat(["y"])
print(back(["x"]))
