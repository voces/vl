// @run
// @log kb
// @log kb
// @log kb
// @log none
// @log null-ok
// @log plain
// THREE MORE POSITIONS where a literal-union atom reaches a NULLABLE string slot. Each lowered
// the raw i32 atom id into a `(ref null $type)` and was check-clean invalid wasm:
//
//   const s: string | null = r.f        a LET with a nullable-string annotation
//   take(r.f)  where take(s: string|null)   a CALL ARGUMENT
//   const b: Box = { v: r.f }           a FIELD store (code 20)
//
// THE POSITIONS WERE MEASURED, NOT DEDUCED. Six nullable positions were built and run before any
// of them was touched: these three failed, and an ASSIGNMENT to a `string | null` binding and a
// GLOBAL initializer already worked. Reading the code would not have predicted the split — the
// two that work reach the widen by routes the three broken ones do not — and the two working
// ones are pinned here as controls precisely because they are the surprise.
//
// THE NON-NULLABLE LET NEEDS NO ARM, for a reason worth recording: `collectLocals` classifies
// `const s: string = <atom>` as an ATOM SLOT (`letInitIsLitAtom` fires ahead of `letIsString`),
// so nothing widens at the init and the widen happens at each READ instead. Only the nullable
// annotation reaches a reference slot at the init. That is why the let arm is keyed on
// `letIsNulString` rather than on "the annotation is stringy" — the stringy non-nullable case is
// not a narrower version of this one, it is a different mechanism.
//
// A FOURTH POSITION IS STILL OPEN and is pinned separately: an ATOM ARM of an if-expression
// joining into `string | null`
// (`tests/cases/soundness/xfail-miscompile-litunion-atom-if-arm-nullable-join.vl`). The obvious
// one-word fix — admitting the `nulstr` join kind beside `str` at the if-arm widen — was written
// and measured INERT (0 corpus rows, 0 of the constructed shapes) and dropped rather than
// shipped, so the join kind for that shape is something else and the site is unidentified.
type K = "ka" | "kb"
type R = { f: K }
type Box = { v: string | null }

function take(s: string | null) {
  if s != null { print(s) } else { print("none") }
}

function main() {
  const r: R = { f: "kb" }

  const s: string | null = r.f
  if s != null { print(s) }

  take(r.f)

  const b: Box = { v: r.f }
  if b.v != null { print(b.v) }

  take(null)

  // The two positions that ALREADY worked — controls, and the reason the set was measured.
  let a: string | null = null
  a = r.f
  if a == null { print("null-ok") } else { print("null-ok") }
  const p: string | null = "plain"
  if p != null { print(p) }
}
main()
