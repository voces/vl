// @run
// @log b
// @log b
// @log b
// @log b
// @log true
// @log <b>
// @log b
// @log b
// @log b
// @log b
// @log a
// @log not
// @hint redundant type annotation: `k` is inferred as `K`
// A `string` global narrowed to a literal set by `is` is read as the string its cell holds, in
// each position a narrowed read is delivered to.

type K = "a" | "b"
const g: string = "b"
function takeK(k: K) { print(k) }
function retK(): K {
  if g is K { return g }
  return "a"
}
if g is K { print(g) }
if g is K {
  const k: K = g
  print(k)
}
if g is K { takeK(g) }
print(retK())
if g is K { print(g == "b") }
if g is K { print("<\{g}>") }
if g is K {
  const r = { k: g }
  print(r.k)
}
if g is K {
  const xs: K[] = [g]
  print(xs[0])
}
if g is K {
  const n: K | null = g
  print(n ?? "none")
}
if g is K {
  const s: string = g
  print(s)
}
let h = "a"
if h is K { print(h) }
h = "zz"
if h is K { print(h) } else { print("not") }
