// @run
// @log 0
// @log true
// @log empty
// @log a
// `const E = ""` has the literal type `""`, a literal whose text is empty, so it reaches a
// `"" | "a"` destination as that member (D2157).
const E = ""
function f(k: "" | "a") {
  if k == "" { return 0 }
  1
}
print(f(E))

type K = "" | "a"
let k: K = "a"
k = E
print(k == "")

function h(v: "" | "a") {
  if v == "" { return "empty" }
  "a"
}
print(h(E))
print(h("a"))
