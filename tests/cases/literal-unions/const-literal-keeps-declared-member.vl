// @run
// @info `y` is never reassigned; use `const` instead of `let`
// @info `ys` is never reassigned; use `const` instead of `let`
// @info `j` is never reassigned; use `const` instead of `let`
// @info `js` is never reassigned; use `const` instead of `let`
// @log 1
// @log a
// @log 2
// @log x
// @log x
// A `const` inferring `"a"` widens only its own binding: the declared member `"a"` of `K`, the
// same literal, stays a `K` member when read back from a list and from a binding (D14540).
type K = "a" | "b"
const c = "a"
function step(k: K) {
  if k == "a" { 1 } else { 2 }
}
const ks: K[] = ["b", "a"]
const k = ks[1]
print(step(k))
print(c)
const x = "x"
let y: "x" | "z" = "x"
let ys = [y]
ys.push("z")
print(ys.length)
type J = "x"
let j: J = "x"
let js = [j]
print(js[0])
print(x)
