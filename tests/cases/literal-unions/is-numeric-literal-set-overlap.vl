// A numeric literal set is tested by the same rule as a string one (D2205): an overlap is
// allowed and the then-branch narrows to it, the else-branch to the rest.
function two(k: 2) { print(k * 10) }
function onlyOne(k: 1) { print(k - 100) }
type N = 1 | 2
function g(n: N) {
  if n is 2 | 3 { two(n) } else { onlyOne(n) }
  print(n is 2 | 3)
}
g(1)
g(2)
function h(n: 1 | 2 | 4 | null) {
  if n is 2 | 4 | 8 { print(n + 1000) }
  else if n != null { print(n) }
  else { print("null") }
}
h(1)
h(4)
h(null)
type T = 7 | 9
function k(y: 1 | 2 | 7) {
  if y is T { return 111 }
  222
}
print(k(7))
print(k(2))

// Literals of two kinds beside a non-literal member.
function f(v: 1 | "a" | boolean) {
  if v is "a" | "b" { print("str " + v) }
  else if v is 1 | 5 { print(v + 1) }
  else { print(v) }
}
f(1)
f("a")
f(true)
