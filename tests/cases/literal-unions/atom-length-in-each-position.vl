// @run
// @log 3
// @log 3
// @log 3
// @log 11
// @log 3
// @log 1
// @log 2
// A literal union's `.length` is its member string's, decoded from the atom: a hole parameter, a
// generic's lambda, a global, a local, a `??` result and a narrowed binding, in a print, a
// return, an argument, a binding and arithmetic.
type K = "a" | "bbb"
function show(n: i32) { print(n) }
function hole(x) { return x.length }
function gen<T>(t: T) {
  const g = (v: T) => v.length
  return g(t)
}
const gk: K = "bbb"
function local() {
  const k: K = "a"
  return k.length + 10
}
function coal(x: K | null) { return (x ?? "bbb").length }
const n: K | null = "a"
print(hole(gk))
print(gen(gk))
show(gk.length)
print(local())
print(coal(null))
print(coal("a"))
if n != null {
  const m = n.length * 2
  print(m)
}
