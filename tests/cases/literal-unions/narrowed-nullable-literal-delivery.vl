// @run
// @hint redundant type annotation: `c` is inferred as `"a" | "b" | null` — remove it to lean on inference
// @log b
// @log b
// @log b
// @log b
// @log b
// @log N
// @log N
// @log N
// @log N
// @log N
// D3118: a value narrowed to `K | null` out of a wider box reaches a `K | null` destination as
// the atom niche: a parameter, both faces of a binding, a function value and a generic.
type K = "a" | "b"
function show(w: K | null) {
  if w == null { return "N" }
  return w
}
function app<T>(x: T, f: (T) => string) { return f(x) }
function t(e: K | null | i32) {
  if !(e is i32) {
    print(show(e))
    const c: K | null = e
    print(show(c))
    const d = e
    print(show(d))
    const f = (w: K | null) => show(w)
    print(f(e))
    print(app(e, (w: K | null) => show(w)))
  }
}
t("b")
t(null)
t(3)
