// @run
// @log 2
// @log 2
// @log 1
// @log 1
// @log a
// @log a
// @log 2
// @log 2
// @log 1
// @log 1
// @log 2
// @log 2
// An INLINE literal union inside an INLINE `{…}` SHAPE annotation — `{ xs: ("a" | "b")[] }`
// — and the INFERRED bindings that read one back out, each PAIRED with its `K` alias
// control on the adjacent line.
//
// WHY IT IS A FIXTURE. An inline shape's field type is classified by `nameFieldCode(t)`,
// which by construction has NO annotation node to consult — the member text is split out of
// the rendered shape name — so the arena-first checks that repaired the DECLARED-field
// position could not fire here. While `canonEmitName` softened a bare inline literal union
// to its base scalar, the member arrived as `string[]` and the field was coded a string-ref
// list (code 6) for a value built on the interned-atom i32 wrapper: unparseable as a global,
// invalid wasm as a local. The canon pass now keeps the members at an object FIELD, so the
// text the shape name carries says what the arena says.
//
// The `f(sInline.xs)` line is the identity check: a field read out of the INLINE shape
// handed to a `K[]` parameter. And the inferred bindings (`const v = s.xs`) are here
// because a field READ is a different classifier from the field's own code.

type K = "a" | "b"

function takesAlias(xs: K[]) { print(xs.length) }

const gInline: { xs: ("a" | "b")[] } = { xs: ["a", "b"] }
const gAlias: { xs: K[] } = { xs: ["a", "b"] }

// An inline shape carrying the litunion BARE, not as a list.
const bInline: { v: ("a" | "b") } = { v: "a" }
const bAlias: { v: K } = { v: "a" }

// A shape-typed ARRAY: the shape stands as an array ELEMENT, so the field text is reached
// one construct further in.
const lInline: { xs: ("a" | "b")[] }[] = [{ xs: ["a"] }]
const lAlias: { xs: K[] }[] = [{ xs: ["a"] }]

function reads() {
  const si: { xs: ("a" | "b")[] } = { xs: ["a", "b"] }
  const vi = si.xs
  print(vi.length) // 2
  const sa: { xs: K[] } = { xs: ["a", "b"] }
  const va = sa.xs
  print(va.length) // 2

  // An INFERRED return whose type is the inline shape.
  const mi = mkInline()
  print(mi.xs.length) // 1
  const ma = mkAlias()
  print(ma.xs.length) // 1
}

function mkInline() {
  const s: { xs: ("a" | "b")[] } = { xs: ["a"] }
  return s
}
function mkAlias() {
  const s: { xs: K[] } = { xs: ["a"] }
  return s
}

print(gInline.xs.length) // 2
print(gAlias.xs.length) // 2
print(lInline.length) // 1
print(lAlias.length) // 1
print(bInline.v) // a
print(bAlias.v) // a
reads()
takesAlias(gInline.xs) // the two spellings meet: one type, one rep
takesAlias(gAlias.xs)
