// @run
// @log 2
// @log 2
// @log 1
// @log 1
// @log a
// @log a
// @log 2
// @log 2
// @log 1
// @log 1
// @log 2
// @log 2
// @log 1
// @log 1
// @log c
// @log 3
// @log a
// @log 3
// @log c
// @log 9
// @log a
// @log 9
// @log aa
// @log zz
// An INLINE literal union inside an INLINE `{…}` SHAPE annotation — `{ xs: ("a" | "b")[] }`
// — and the INFERRED bindings that read one back out, each PAIRED with its `K` alias
// control on the adjacent line.
//
// WHY IT IS A FIXTURE. An inline shape's field type is classified by `nameFieldCode(t)`,
// which by construction has NO annotation node to consult — the member text is split out of
// the rendered shape name — so the arena-first checks that repaired the DECLARED-field
// position could not fire here. While `canonEmitName` softened a bare inline literal union
// to its base scalar, the member arrived as `string[]` and the field was coded a string-ref
// list (code 6) for a value built on the interned-atom i32 wrapper: unparseable as a global,
// invalid wasm as a local. The canon pass now keeps the members at an object FIELD, so the
// text the shape name carries says what the arena says.
//
// The `f(sInline.xs)` line is the identity check: a field read out of the INLINE shape
// handed to a `K[]` parameter. And the inferred bindings (`const v = s.xs`) are here
// because a field READ is a different classifier from the field's own code.
//
// WHAT THE 2026-07-29 `LINSOFT` SLICE ADDED, AND WHY IT USES `"c" | "d"`. Everything above
// travels through canon, which preserves an inline litunion at a keep position. The two
// RENDERERS (`tyToEmitName` / `tyToNominalName`) had no leg for an inline run at all and
// softened it to `string`, so wherever the emitter's name comes from a RENDER rather than
// from an annotation the same arena type got a second row. `lamReads` and `cloResults`
// below are the two shapes where that happens — a LAMBDA's inferred return and a
// closure-VALUED map's result. On master both write a module that DOES NOT VALIDATE while
// `vl check` says rc 0 (`type mismatch: expected (ref $type), found (ref $type)`), because
// the module interns BOTH `{v:i32-atom, n:i32}` (the annotation's row) and
// `{v:string-ref, n:i32}` (the render's row) and the lambda's functype names the second
// while its body builds the first.
//
// The run is spelled `"c" | "d"` ON PURPOSE. A declared `type K = "a" | "b"` in the same
// module answers `litUnionAliasOfLitTexts` for an inline `"a" | "b"`, so the render
// preserves through the ALIAS leg that has always existed and the defect is MASKED — the
// first draft of these bodies reused `"a" | "b"`, was green on master, and proved nothing.
// The `K` control beside each body is therefore a control precisely BECAUSE its members
// differ: it exercises the alias leg while the inline body exercises the new one.
//
// The NAMED-function form (`mkInline` above) is green on master and stays as the contrast:
// this is the LAMBDA's inferred return, not the function's declared one.
//
// AND `genApps` PINS THE ONE POSITION WHERE THE KEEP RULE MUST NOT APPLY. A generic
// APPLICATION's argument is canon'd at `RC_ROOT` — canon's own arm says it "has no way to
// know" where the parameter stands — so `Box<"aa" | "zz">` reaches the emitter as
// `Box<string>` and its expansion carries a STRING field. The structural renderer sees only
// the expanded `{v: …}`, where the argument now stands at a FIELD, and preserving there
// forks the row: master and this head both print `aa`/`zz`, but a build with `appKidCtx`
// removed writes a module that does not validate. Both spellings are green here and that is
// the assertion.

type K = "a" | "b"

function takesAlias(xs: K[]) { print(xs.length) }

const gInline: { xs: ("a" | "b")[] } = { xs: ["a", "b"] }
const gAlias: { xs: K[] } = { xs: ["a", "b"] }

// An inline shape carrying the litunion BARE, not as a list.
const bInline: { v: ("a" | "b") } = { v: "a" }
const bAlias: { v: K } = { v: "a" }

// A shape-typed ARRAY: the shape stands as an array ELEMENT, so the field text is reached
// one construct further in.
const lInline: { xs: ("a" | "b")[] }[] = [{ xs: ["a"] }]
const lAlias: { xs: K[] }[] = [{ xs: ["a"] }]

function reads() {
  const si: { xs: ("a" | "b")[] } = { xs: ["a", "b"] }
  const vi = si.xs
  print(vi.length) // 2
  const sa: { xs: K[] } = { xs: ["a", "b"] }
  const va = sa.xs
  print(va.length) // 2

  // An INFERRED return whose type is the inline shape.
  const mi = mkInline()
  print(mi.xs.length) // 1
  const ma = mkAlias()
  print(ma.xs.length) // 1
}

function mkInline() {
  const s: { xs: ("a" | "b")[] } = { xs: ["a"] }
  return s
}
function mkAlias() {
  const s: { xs: K[] } = { xs: ["a"] }
  return s
}

// A LAMBDA's inferred return — the render mints the name here, not canon.
function lamReads() {
  const fi = () => {
    const s: { xs: ("c" | "d")[] } = { xs: ["c"] }
    return s
  }
  const ri = fi()
  print(ri.xs.length) // 1
  const fa = () => {
    const s: { xs: K[] } = { xs: ["a"] }
    return s
  }
  const ra = fa()
  print(ra.xs.length) // 1

  const bi = () => {
    const s: { v: ("c" | "d"), n: i32 } = { v: "c", n: 3 }
    return s
  }
  const rbi = bi()
  print(rbi.v) // c
  print(rbi.n) // 3
  const ba = () => {
    const s: { v: K, n: i32 } = { v: "a", n: 3 }
    return s
  }
  const rba = ba()
  print(rba.v) // a
  print(rba.n) // 3
}

type Box<T> = { v: T }

const gApp: Box<"aa" | "zz"> = { v: "aa" }

// The application's argument, at the global position (canon's) and at the lambda-inferred
// one (the render's) — the pair `appKidCtx` keeps agreeing.
function genApps() {
  print(gApp.v) // aa
  const f = () => {
    const s: Box<"aa" | "zz"> = { v: "zz" }
    return s
  }
  const r = f()
  print(r.v) // zz
}

// The same shape as a closure-VALUED map's RESULT: the map read hands back an inferred
// closure whose `$fnsig` is keyed by the rendered result type.
function cloResults() {
  const mkI = () => {
    const s: { v: ("c" | "d"), n: i32 } = { v: "c", n: 9 }
    return s
  }
  const mi: {[string]: () => { v: ("c" | "d"), n: i32 }} = Map()
  mi["k"] = mkI
  const gi = mi["k"]
  if gi != null {
    const ri = gi()
    print(ri.v) // c
    print(ri.n) // 9
  }
  const mkA = () => {
    const s: { v: K, n: i32 } = { v: "a", n: 9 }
    return s
  }
  const ma: {[string]: () => { v: K, n: i32 }} = Map()
  ma["k"] = mkA
  const ga = ma["k"]
  if ga != null {
    const ra = ga()
    print(ra.v) // a
    print(ra.n) // 9
  }
}

print(gInline.xs.length) // 2
print(gAlias.xs.length) // 2
print(lInline.length) // 1
print(lAlias.length) // 1
print(bInline.v) // a
print(bAlias.v) // a
reads()
takesAlias(gInline.xs) // the two spellings meet: one type, one rep
takesAlias(gAlias.xs)
lamReads()
cloResults()
genApps()
