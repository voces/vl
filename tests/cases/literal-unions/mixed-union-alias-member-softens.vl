// @run
// @log aa
// @log F
// @log bb
// @log aa
// @log aa
// THE MIXED-UNION SOFTEN, PINNED BY NAME (owner ruling 2026-07-28). In the emitter's
// vocabulary a string-litunion ALIAS standing as a MEMBER of a union is spelled by its
// base `string` — `K | f64` is `string|f64` — and the structural renderer says so as of
// this file: `tyToEmitNameGo`'s union arm carries no litunion-alias leg, which is the
// spelling `canonEmitName` has produced for that annotation all along (its union-member
// loop expands a union-ALIAS member through `unionAliasMembers`, whose render of a PURE
// litunion is `string`).
//
// THE RULE IS LIVE HERE, MEASURED BY POISON RATHER THAN CLAIMED: rendering a union's
// str-literal member as anything else (`stringZZ`) takes this file from rc 0 to
// `emitProgram: union box atom test on a union with no recorded members: stringZZ|f64`,
// and 25 other corpus files with it.
//
// THE FOUR KEEP POSITIONS ARE NOT THIS RULE, and go2 holds three of them so a slice that
// over-applies the soften has a named place to fail: in an array ELEMENT, a struct FIELD, a
// map VALUE and a function RESULT the alias reps as the interned i32 ATOM and both
// producers preserve it (`ctxKeepsLitUnion`). The map-value arm is left out because a
// `{[string]: K}` READ is `K | null`, whose narrow is a separate open gap.
//
// `tyToNominalName` still PRESERVES the alias here — the same soften on that renderer is
// blocked by `IsExpr.isVariant` not being in the emitter's vocabulary; the blocked-soften
// note on `tyToNominalNameGo`'s `unionAliasDeclNameOfTy` short-circuit carries the fuzz
// shape and the two measured fix attempts.
type K = "aa" | "bb"

function mixed(n: i32): K | f64 {
  if n > 0 { return "aa" }
  return 2.5
}
function go1() {
  const v = mixed(1)
  if v is K { print(v) } else { print("OTHER") }
  // The f64 arm is asserted by its BRANCH, not by printing the narrowed value: `print` of
  // the f64 arm of a value union is a separate pre-existing emit gap (invalid wasm on
  // master and on this build alike), and this file is not its witness.
  const w = mixed(0)
  if w is K { print("K") } else { print("F") }
}
go1()

function elemOf(): K[] { return ["bb"] }
function fieldOf(): { f: K } { return { f: "aa" } }
function resOf(): () => K {
  const f = (): K => "aa"
  return f
}
function go2() {
  const e = elemOf()
  print(e[0])
  const s = fieldOf()
  print(s.f)
  const r = resOf()
  const rv = r()
  print(rv)
}
go2()
