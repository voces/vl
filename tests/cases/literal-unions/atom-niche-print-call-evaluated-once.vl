// @run
// @log Sx
// @log a
// @log Sa
// @log a
// @log Sn
// @log null
// @log Sc
// @log b
// @log 4
// The `K | null` NICHE half of "print of an atom evaluates its receiver once". The niche is
// an i32 member id with `-1` for null, so its print is the member widen plus a sentinel arm —
// and master re-read the receiver for the sentinel TOO, which made a call receiver run
// members+1 times: three evaluations for a two-member niche, where the bare alias ran two.
// Both arms now read the ONE stashed id.
//
// Both spellings of the niche are here because they intern differently and only one of them
// is a declared alias over another alias (`type KA = KB | null`) — the pair is the standing
// litunion axis, and a fix that reached one spelling and not the other would pass a
// single-spelling pin.
//
// `pn` returns NULL: the sentinel arm still renders the word `null`, and it does so off the
// same single evaluation, so the count assertion covers the null path as well as the member
// path. `gEv` is the mutation half of the count assertion — four producers, four evaluations.

type KN = "a" | "b" | null
type KB = "a" | "b"
type KA = KB | null

let gEv = 0

function px(): KN {
  gEv = gEv + 1
  print("Sx")
  return "a"
}

function pa(): KA {
  gEv = gEv + 1
  print("Sa")
  return "a"
}

function pn(): KN {
  gEv = gEv + 1
  print("Sn")
  return null
}

function pc(): KA {
  gEv = gEv + 1
  print("Sc")
  return "b"
}

// The expanded spelling, a member value.
print(px())

// The alias-over-alias spelling, a member value.
print(pa())

// The sentinel: one evaluation, and it still renders `null`.
print(pn())

// A closure call over the niche, landing on the SECOND member (so the tower's non-default
// arm is the one that fires).
const cf = pc
print(cf())

print(gEv)
