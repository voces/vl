// @run
// @log 1
// @log 2
// @log 3
// CONTRACT: `k is K` over a LITERAL-UNION receiver. The value is an interned i32 ATOM id,
// not a union BOX — but `K` is a registered union NAME, so `unionNameOfIdent` claimed the
// binding and `emitIs` compared the box's tag field (`struct.get 0 0`) against an i32.
// Before D-ATOMIS every one of these three binding forms built a module that failed to
// parse as WebAssembly (`failed to compile: wasm[0]::function[4]`).
//
// Every member of the receiver's own litunion is in the tested set, so the test is TRUE by
// construction and folds without evaluating the receiver.

type K = "x" | "y"

const g: K = "x"
if g is K { print(1) }

function localForm() {
  const l: K = "y"
  if l is K { print(2) }
}

function paramForm(p: K) {
  if p is K { print(3) }
}

localForm()
paramForm("x")
