// @run
// @log 12
// @log 2
// @log 3
// @log one
// @log 3
// @log true
// @log 6
// @log 4000000001
// A numeric literal-union scalar cast to a narrower one of the same base is a member test of the
// scalar: `as!` yields it, `as` hands a miss back as the scalar or its box, `as?` boxes (D11221).
type N2 = 1 | 2
type N3 = 1 | 2 | 3
function f(x: N3) {
  const r = x as! N2
  r + 10
}
print(f(2))
function g(x: N3): N3 {
  const r = x as N2
  r
}
print(g(2))
print(g(3))
function h(x: N3): N3 | string {
  const r = x as N2
  if r == 1 { return "one" }
  r
}
print(h(1))
print(h(3))
const x3: N3 = 3
print((x3 as? N2) == null)
const x1: N3 = 1
const q = x1 as? N2
if q != null { print(q + 5) }
type W2 = 3000000000 | 4000000000
type W3 = 3000000000 | 4000000000 | 5000000000
function w(x: W3) {
  const r = x as! W2
  r + 1
}
print(w(4000000000))
