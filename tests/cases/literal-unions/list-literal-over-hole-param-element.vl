// @run
// @log green
// @log green
// @log 1.5
// A list literal whose ELEMENT rep is only reachable through a hole parameter. Two halves,
// both invisible to the same reader: the recorded container type is `<hole>[]`, so stepping to
// the element and resolving THAT through the pin is the only rung that names it (D1725).
//
// NO OTHER STRING OR f64 LIST MAY BE ADDED. The reservation this pins is module-wide, so a
// `string[]` or `f64[]` anywhere else makes both lower halves pass for the wrong reason — the
// alias source list is the interned i32 atom list and forces neither.

type K = "red" | "green"
const src: K[] = ["green", "red"]

// The ATOM half: the literal is the i32 atom list and the READ must widen it to the member
// text. Printing `0` here is the interned id, which is what this line exists to refuse.
function atoms(a) {
  const xs = [a]
  print(xs[0])
}

// The STRING half: the element rep is nameable only through the pin, so nothing reserved the
// string list and the emit floor refused a rep it could name.
function strings(a) {
  const xs = [a]
  print(xs[0])
}

// The same hole at a second scalar rep, which is what shows the half is not string-specific.
function floats(a) {
  const xs = [a]
  print(xs[0])
}

atoms(src[0])
strings("green")
floats(1.5)
