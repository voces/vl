// @run
// A `??` whose operand or default is an atom-valued map read, or an atom niche beside a number,
// joins into the box at both faces and at every delivery position
// (D7960-D7962, D7964, D7966, D7967, D4750).
type AB = "a" | "b"
type R = {
  a: {[i32]: i32 | null},
  b: {[i32]: AB},
  an: AB | null,
  yn: i32 | null,
  x: AB,
}

function mk(): R {
  const a: {[i32]: i32 | null} = Map()
  a[3] = 2
  a[4] = 5
  a[5] = null
  const b: {[i32]: AB} = Map()
  b[3] = "a"
  b[4] = "b"
  { a: a, b: b, an: null, yn: 6, x: "b" }
}

function joinU(p) { print(p.a[9] ?? p.b[3]) }
function joinA(p: R) { print(p.a[9] ?? p.b[3]) }
function missU(p) { print(p.a[9] ?? p.b[8]) }
function missA(p: R) { print(p.a[9] ?? p.b[8]) }
function chainU(p) { print(p.a[9] ?? p.a[4] ?? p.a[3]) }
function chainA(p: R) { print(p.a[9] ?? p.a[4] ?? p.a[3]) }
function atomOrNumU(p) { print(p.b[9] ?? 7) }
function atomOrNumA(p: R) { print(p.b[9] ?? 7) }
function nicheOrNumU(p) { print(p.an ?? 7) }
function nicheOrNumA(p: R) { print(p.an ?? 7) }
function boxOrBoxU(p) { print(p.a[9] ?? p.yn) }

function bindU(p) {
  const r = p.a[9] ?? p.x
  print(r)
}

function bindA(p: R) {
  const r = p.a[9] ?? p.b[4]
  print(r)
}

function bindBoxU(p) {
  const r = p.a[9] ?? p.yn
  print(r)
}

function retA(p: R): i32 | AB { p.b[9] ?? 7 }

function retU(p) { return p.a[9] ?? p.b[3] }

joinU(mk())
joinA(mk())
missU(mk())
missA(mk())
chainU(mk())
chainA(mk())
atomOrNumU(mk())
atomOrNumA(mk())
nicheOrNumU(mk())
nicheOrNumA(mk())
boxOrBoxU(mk())
bindU(mk())
bindA(mk())
bindBoxU(mk())
print(retA(mk()))
print(retU(mk()))

function bothNullU(x, y) {
  const r = x ?? y
  print(r == null)
}

const nAB: AB | null = null
bothNullU(nAB, nAB)

function nameOrNumU(n) { print(n ?? 7) }

function nameOrNumA(n: AB | null) {
  const r = n ?? 7
  print(r)
}

function nameRetA(n: AB | null): i32 | AB { n ?? 7 }

const bAB: AB | null = "b"
nameOrNumU(nAB)
nameOrNumU(bAB)
nameOrNumA(nAB)
print(nameRetA(bAB))
print(nAB ?? 7)

const nNum: i32 | null = null
const rNiche = nNum ?? bAB
print(rNiche)
const xAB: AB = "a"
const rAtom = nNum ?? xAB
if rAtom is i32 { print(1) } else { print(rAtom) }
// @log a
