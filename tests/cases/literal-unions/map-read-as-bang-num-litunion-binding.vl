// @run
// @log 1
// @log 12
// @log 2
// An un-annotated binding of a map read cast `as!` to a numeric literal union holds the bare
// `i32` the cast yields, at module scope and inside a function (D11220).
type N2 = 1 | 2
const m: {[string]: N2} = Map()
m["q"] = 1
const r = m["q"] as! N2
print(r)
function f() {
  const mm: {[string]: N2} = Map()
  mm["q"] = 2
  const v = mm["q"] as! N2
  v + 10
}
print(f())
let w = m["q"] as! N2
w = 2
print(w)
