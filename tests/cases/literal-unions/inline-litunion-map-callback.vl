// @run
// @log a
// @log b
// An inline literal-union callback return (`xs.map((v: i32): "a" | "b" => …)`). It used to be a
// loud decline: the inline set repped as a string ref at the annotation and as interned atoms in
// the elements, and the `.map` result classifier had no atom-list kind to reconcile the two. An
// inline set now takes the atom rep at every position, exactly as its alias spelling does (D2150),
// so the result is the atom list and each element widens to its member at `print`.
const xs = [1, -2]
const ys = xs.map((v: i32): "a" | "b" => {
  if v > 0 { return "a" }
  return "b"
})
print(ys[0])
print(ys[1])
