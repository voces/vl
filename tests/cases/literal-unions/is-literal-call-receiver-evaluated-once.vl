// @run
// @log E
// @log true
// @log 1
// @log E
// @log false
// @log 2
// @log E
// @log false
// @log 3
// @log E
// @log E
// @log false
// @log 5
// @log E
// @log true
// @log 6
// A spill changes the EVALUATION COUNT question, so it is pinned here rather than inferred.
// `mk(0) is "a"` parks the receiver at its first read and re-reads the slot for the payload,
// so the call must run EXACTLY ONCE — a lowering that re-emitted the receiver for the second
// read would double it, `vl check` clean and module valid.
//
// `gEv` is the independent half: a mutation rather than a print marker, so a miscount cannot
// be an artifact of how `print` itself is lowered.
//
// BOTH LITERAL REPS ARE HERE. The quoted literal takes the string arm's tag and the numeric
// one takes the `i32` arm's, and the two spellings emit different payload compares over the
// same parked box — so a spill wired for only one of them shows up as a count, not a value.
//
// The `&&` row pins that two `is` tests over two calls in ONE expression do not share the
// slot's live range: each tees and re-reads before the next one starts.

type K = "a" | "b"

let gEv = 0

function mk(n: i32): K | i32 {
  gEv = gEv + 1
  print("E")
  if n == 0 { return "a" }
  7
}

print(mk(0) is "a")
print(gEv)

print(mk(1) is "a")
print(gEv)

// A NUMERIC literal against the same call receiver: the `i32` arm's tag does not match the
// string the box holds, so the answer is `false` after ONE evaluation.
print(mk(0) is 9)
print(gEv)

// Two call receivers in one short-circuiting expression: both arms run (the left is true),
// so this is two more evaluations, not three and not one.
print(mk(0) is "a" && mk(1) is "a")
print(gEv)

print(mk(0) is "a" || mk(1) is "a")
print(gEv)
