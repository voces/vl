// @run
// @log b
// @log y
// @log c
// @log b
// A literal-union GLOBAL is a plain `(mut i32)` interned ATOM cell, so REASSIGNING it must
// store the member's interned id — not a `{tag, payload}` value-union box.
//
// `emitAssign`'s GLOBAL arm routed every union-NAMED target through `emitUnionCoerce`, and a
// literal union answers `letUnionNameOf`. So `let v: K = "a"` + `v = "b"` emitted
// `i32.const 2 / global.get $str / struct.new $box / global.set $v` into an i32 cell —
// `type mismatch: expected i32, found (ref $type)`, `vl check` clean, at every arity and for
// every member RHS. The identical three lines inside a FUNCTION ran, because the LOCAL arm
// one screen below has carried the `!nameIsLitUnionType` exclusion (and the `litUnion` seed
// that lowers the member RHS as its id) since it was written.
//
// The last two lines pair the two spellings that reach the same seed: an IDENT RHS (which is
// not a literal at all, so only the seed can type it) and a three-member alias.

type K = "a" | "b"
type K3 = "a" | "b" | "c"

let v: K = "a"
let w: K = "a"
let t: K3 = "a"

v = "b"
print(v) // b

// the assigned atom keeps its MEMBERSHIP identity, not a widened string
if v == "b" { print("y") } else { print("n") }

t = "c"
print(t) // c

// an IDENT RHS over the same litunion cell
const src: K = "b"
w = src
print(w) // b
