// @run
// @log false
// @log false
// @log true
// @log false
// @log true
// @log true
// @log true
// `x is <integer literal>` compares at the receiver's own width. A string, a boolean or an
// `i32` the literal does not fit never holds it; an `i64` holds any integer literal.
function g<T>(x: T) { x is 2 }
print(g("s"))
print(g(true))
print(g(2))
function w<T>(x: T) { x is 5000000000 }
print(w(2))
print(w(5000000000))
const z: i64 = 5
print(z is 5)
type V = 1 | 5000000000
const q = 1
print(q is V)
