// @log true
// `x is <integer literal>` compares at the receiver's own width. A float, a string or an
// `i32` the literal does not fit never holds it; an `i64` holds any integer literal.
const y: f64 = 2
print(y is 2)
function f(v: f64) { v is 2 || v is 3 }
print(f(2.0))
function g<T>(x: T) { x is 2 }
print(g(2.0))
print(g("s"))
print(g(2))
function w<T>(x: T) { x is 5000000000 }
print(w(2))
print(w(5000000000))
const z: i64 = 5
print(z is 5)
type V = 1 | 5000000000
const q = 1
print(q is V)
