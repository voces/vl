// @run
// @log a
// @log b
// @log c
// @log y
// A literal-union call result reaches a wider atom destination staged once and narrowed by the
// member it string-equals, at a binding, an argument and a narrowed read.
function pick(n: i32): "a" | "b" { return if n == 0 { "a" } else { "b" } }
function only(): "y" { return "y" }
function take(m: "a" | "b" | "c") { print(m) }
function bound(n: i32) {
  const m: "a" | "b" | "c" = pick(n)
  print(m)
}
function narrowed(m: "a" | "b" | "c") {
  if m == "c" { print(m) }
}
bound(0)
take(pick(1))
narrowed("c")
const w: "x" | "y" = only()
print(w)
