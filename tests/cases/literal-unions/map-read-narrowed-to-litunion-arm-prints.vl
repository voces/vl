// @run
// @log b
// @log b
// @log b
// @log b
// @log 5
// @log b
// @log b
// @log a

// A map read of a box holding an alias-spelled literal union, narrowed to that arm by the
// else of `is i32` or by `is AB`, prints as the member (D8120).
type AB = "a" | "b"

const m: { [string]: i32 | AB | null } = Map()
m["k"] = "b"
if m["k"] is i32 { print(0) } else { print(m["k"]) }
if m["k"] != null {
  if m["k"] is i32 { print(0) } else { print(m["k"]) }
}
if m["k"] is i32 { print(0) } else {
  const z = m["k"]
  print(z)
}
if m["k"] is AB { print(m["k"]) }

m["n"] = 4
if m["n"] is i32 { print(m["n"] + 1) } else { print(m["n"]) }

const w: { [string]: i32 | AB } = Map()
w["k"] = "b"
if w["k"] != null {
  if w["k"] is i32 { print(0) } else { print(w["k"]) }
}

// A second delivery position: the map handed in as a parameter.
function show(p: { [string]: i32 | AB | null }, k: string) {
  if p["k"] is i32 { print(0) } else { print(p["k"]) }
}
show(m, "k")
m["k"] = "a"
show(m, "k")
