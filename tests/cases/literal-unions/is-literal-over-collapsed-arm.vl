// @run
// CONTRACT (D1048, the ruling's SECOND hint): `x is <literal>` over an operand whose
// union COLLAPSED a subsumed literal arm is a HINT, and it fires exactly where the
// collapse cost the author something.
//
// The ruling — DECISIONS.md, "A subsumed literal arm COLLAPSES" — makes `string | "err"`
// the type `string`, because a union is a set of values and `"err"` adds none. That is
// right, and it silently removes a discrimination the author believed they had written:
// `r is "err"` no longer asks a tag, it asks `r == "err"`, so a `string` that happens to
// read "err" answers yes. The FIRST hint fires at the collapsed SPELLING (the existing
// redundant-annotation one, for free — every `: R` below carries it). This file pins the
// SECOND, at the `is` downstream of it, which is where the loss actually bites.
//
// WHAT DECIDES IT IS PROVENANCE, NOT TYPE. After the collapse the operand IS a `string`:
// same arena index, same canon spelling as any other, so a rule reading the type would
// fire on every legitimate `s is "err"` in the language. The hint reads the marks the
// collapse itself records — a `let`/param annotation that collapsed, or a declared return
// that did — which is why `plainStr` and the shadowing case below are silent while `r` is
// not.
//
// THE NEGATIVES ARE THE POINT OF THE FILE, and each one is a different reason:
//   · `Kd`             — a REAL litunion (`"ok" | "err"`): nothing collapsed, `is "err"`
//                        is a genuine atom test.
//   · `boxed`          — `i32 | "err"` is a real two-arm box; no `string` arm subsumes.
//   · `plainStr`       — declared PLAINLY `string`: no union was ever written, so there
//                        is no loss to report and hinting would fire on every compare.
//   · `shadowed`       — an inner plain `string` shadowing an outer collapsed binding:
//                        the mark is keyed by scope DEPTH, so the inner one is silent.
//   · `orErr<T>`       — a GENERIC INSTANTIATION (`T | "err"` at `T = string`). Ruled OUT
//                        by name: the caller did not write the union and the author cannot
//                        avoid it, so a hint there names a problem with no addressee.
//   · `is null` / `is string` — not literal check types; those tests still discriminate.

// ── the ruling's own example: a declared alias, through a declared return ───────
// @log ok
// @hint redundant type annotation: `f` is inferred as `string` — remove it to lean on inference
// @hint `r` is `string` — `is "err"` is a value test (`==`) and cannot tell a failure from data; give the failure a distinguishable arm (`| null` or a struct)
type R = string | "err"
function f(bad: boolean): R { if bad { return "err" }  "ok" }
const r = f(false)
if r is "err" { print("failed") } else { print(r) }

// ── the same collapse reached through a SECOND alias ────────────────────────────
// @log ok2
// @hint redundant type annotation: `g` is inferred as `string` — remove it to lean on inference
// @hint `r2` is `string` — `is "err"` is a value test (`==`) and cannot tell a failure from data; give the failure a distinguishable arm (`| null` or a struct)
type Name = string
type R2 = Name | "err"
function g(bad: boolean): R2 { if bad { return "err" }  "ok2" }
const r2 = g(false)
if r2 is "err" { print("failed2") } else { print(r2) }

// ── the MIRROR half of the ruling: `Kind | string` is `string` too ──────────────
// @log zz
// @hint redundant type annotation: `h` is inferred as `string` — remove it to lean on inference
// @hint `r3` is `string` — `is "a"` is a value test (`==`) and cannot tell a failure from data; give the failure a distinguishable arm (`| null` or a struct)
type Kind = "a" | "b"
type R3 = Kind | string
function h(bad: boolean): R3 { if bad { return "a" }  "zz" }
const r3 = h(false)
if r3 is "a" { print("A") } else { print(r3) }

// ── a WRITTEN annotation on the binding: BOTH hints, once each ──────────────────
// @log ok4
// @hint redundant type annotation: `k` is inferred as `string` — remove it to lean on inference
// @hint redundant type annotation: `r4` is inferred as `string` — remove it to lean on inference
// @hint `r4` is `string` — `is "err"` is a value test (`==`) and cannot tell a failure from data; give the failure a distinguishable arm (`| null` or a struct)
function k(bad: boolean): string { if bad { return "err" }  "ok4" }
const r4: string | "err" = k(false)
if r4 is "err" { print("failed4") } else { print(r4) }

// ── a PARAMETER annotation, and the same binding read from inside a CLOSURE ─────
// @log ok5
// @log ok5c
// @hint `p` is `string` — `is "err"` is a value test (`==`) and cannot tell a failure from data; give the failure a distinguishable arm (`| null` or a struct)
function viaParam(p: string | "err") {
  if p is "err" { print("failed5") } else { print(p) }
  const inClosure = () => {
    if p is "err" { print("failed5c") } else { print(p + "c") }
    0
  }
  inClosure()
  0
}
viaParam("ok5")

// ── NEGATIVE: a real literal union — nothing collapsed, `is` is an atom test ────
// @log kd:no
type Kd = "ok" | "err"
function mkKd(): Kd { return "ok" }
const kd = mkKd()
if kd is "err" { print("kd:yes") } else { print("kd:no") }

// ── NEGATIVE: a real two-arm box (`i32 | "err"`), no subsuming `string` arm ─────
// @log boxed:no
type Boxed = i32 | "err"
function mkBox(): Boxed { return 7 }
const boxed = mkBox()
if boxed is "err" { print("boxed:yes") } else { print("boxed:no") }

// ── NEGATIVE: a PLAINLY declared `string` — no union was ever written ───────────
// @log plain:no
// @hint redundant type annotation: `mkPlain` is inferred as `string` — remove it to lean on inference
function mkPlain(): string { return "zz" }
const plainStr = mkPlain()
if plainStr is "err" { print("plain:yes") } else { print("plain:no") }

// ── NEGATIVE: an inner PLAIN binding SHADOWING the outer collapsed `r` ──────────
// @log shadow:no
// @hint redundant type annotation: `shadowed` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `r` is inferred as `string` — remove it to lean on inference
function shadowed(): i32 {
  const r: string = "zz"
  if r is "err" { print("shadow:yes") } else { print("shadow:no") }
  0
}
shadowed()

// ── NEGATIVE: a GENERIC INSTANTIATION — ruled out, the caller wrote no union ────
// @log gen:no
function orErr<T>(v: T, bad: boolean): T | "err" { if bad { return "err" }  v }
const gv = orErr("zz", false)
if gv is "err" { print("gen:yes") } else { print("gen:no") }

// ── NEGATIVE: a NON-LITERAL check type over a collapsed operand ─────────────────
// `is null` on the nullable spelling (which collapses too — `string | "err" | null` is
// `string?`) and `is string` on the plain one. Neither is a value compare: the first
// reads the niche, the second is a type test the collapse did not degrade. The hint is
// scoped to a LITERAL check type, which is the arm the collapse dropped.
// @log null:no
// @log str:yes
type RN = string | "err" | null
function mkNul(): RN { return "zz" }
const rn = mkNul()
if rn is null { print("null:yes") } else { print("null:no") }
const rs = f(false)
if rs is string { print("str:yes") } else { print("str:no") }
