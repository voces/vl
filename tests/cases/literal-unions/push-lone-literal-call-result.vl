// @log a
// @log ax
// @log 1
// @log ax
// A call whose result is one string literal, pushed into a list of that literal or of a literal
// set holding it: in place, twice, through a generic's pass-through, in a function body, and with
// the call's own effect run once.
function g(): "a" { return "a" }
const xs: "a"[] = []
xs.push(g())
print(xs[0] + "x")
const ys: ("a" | "b")[] = ["b"]
ys.push(g())
print(ys[1] + "x")
print(ys[0] == "b")
xs.push(g())
print(xs[1] == "a")
print(xs[0])
function pass<F>(f: F): F { return f }
const zs: "a"[] = []
zs.push(pass(g)())
print(zs[0] + "x")
let n = 0
function h(): "a" {
  n = n + 1
  return "a"
}
const ws: "a"[] = []
ws.push(h())
print(n)
function main() {
  const ls: "a"[] = []
  ls.push(g())
  print(ls[0] + "x")
}
main()
