// @run
// @log knife none
// @log knife none
// @log knife none
// @log knife none
// @log knife none
// @log knife none
// @log knife none
// @log knife none
// @log other knife zzz

// DV-1207: an `if` or `match` whose arms are a literal-union value and a string literal of that
// union, delivered to that union, is the union rather than `string`: at an annotated binding, a
// return, an argument, a field and a store. A join with no destination keeps `string`, as an
// un-annotated `const` or `let` of it does, so a later store of another string still fits.
type Look = "knife" | "none"
type Holder = { look: Look }

function annotated(ok: boolean, h: Holder): Look {
  const look: Look = if ok { h.look } else { "none" }
  look
}

function returned(ok: boolean, h: Holder): Look {
  if ok { h.look } else { "none" }
}

function literalFirst(ok: boolean, h: Holder): Look {
  return if !ok { "none" } else { h.look }
}

function elseIf(ok: boolean, h: Holder): Look {
  const look: Look = if ok { h.look } else if h.look == "none" { "knife" } else { "none" }
  look
}

function matched(k: i32, h: Holder): Look {
  match k {
    1 => h.look
    _ => "none"
  }
}

function argument(l: Look): Look { l }

function field(ok: boolean, h: Holder): Look {
  const out: Holder = { look: if ok { h.look } else { "none" } }
  out.look
}

function stored(ok: boolean, h: Holder): Look {
  let look: Look = "knife"
  look = if ok { h.look } else { "none" }
  look
}

const h: Holder = { look: "knife" }
print(annotated(true, h) + " " + annotated(false, h))
print(returned(true, h) + " " + returned(false, h))
print(literalFirst(true, h) + " " + literalFirst(false, h))
print(elseIf(true, h) + " " + elseIf(false, h))
print(matched(1, h) + " " + matched(2, h))
const yes = h.look == "knife"
print(
  argument(if yes { h.look } else { "none" })
    + " "
    + argument(if !yes { h.look } else { "none" }),
)
print(
  field(true, h)
    + " "
    + field(false, h)
    + (if field(false, h) == "none" { "" } else { "!" }),
)
print(stored(true, h) + " " + stored(false, h))

let s = if yes { h.look } else { "none" }
s = "other"
const c = if yes { h.look } else { "none" }
let u = c
u = "zzz"
print(s + " " + c + " " + u)
