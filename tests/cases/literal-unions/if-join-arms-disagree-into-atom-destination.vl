// @log green
// @log green
// @log red
// @log blue
// @log green
// @log green
// An `if` value whose arms carry different literal sets, delivered to a declared literal-union
// destination (every annotation is the destination under test, hinted or not): one arm is the atom, the other a one-literal value, and the join's type is the
// atom arm's own. Each arm is narrowed where it is produced, so no position refuses (D2199).
const A: "x" | "y" = "x"
const B: "y" = "y"
const Bc = "y"
type XY = "x" | "y"
type XYZ = "x" | "y" | "z"
type R = { m: "x" | "y" | "z" }
function take(m: "x" | "y" | "z") { print(m) }
function pick(): "y" { "y" }
function wrap(v: "x" | "y"): "x" | "y" { v }
function pass<T>(v: T): T { v }
function sel<T>(c: boolean, a: T, b: T): T {
  if c { a } else { b }
}

// the witness, then a join no wider than the declared set
function join(c: boolean) {
  const M: "x" | "y" | "z" = if c { A } else { B }
  print(M)
}
join(true)
join(false)
function joinSame(c: boolean) {
  const M: "x" | "y" = if c { A } else { B }
  print(M)
}
joinSame(false)

// parameters, the alias spelling, a one-literal arm naming the other member
function params(c: boolean, a: "x" | "y", b: "y") {
  const M: "x" | "y" | "z" = if c { a } else { b }
  print(M)
}
params(true, "x", "y")
params(false, "x", "y")
function aliased(c: boolean, a: XY, b: "y") {
  const M: XYZ = if c { a } else { b }
  print(M)
}
aliased(false, "x", "y")
function otherMember(c: boolean, a: "x" | "y", b: "x") {
  let M: "x" | "y" | "z" = "z"
  M = if c { a } else { b }
  print(M == "x")
}
otherMember(false, "x", "x")

// every delivery position
function positions(c: boolean, a: "x" | "y", b: "y") {
  let l: "x" | "y" | "z" = if c { a } else { b }
  print(l)
  take(if c { a } else { b })
  const r: R = { m: if c { a } else { b } }
  print(r.m)
  const xs: ("x" | "y" | "z")[] = [if c { a } else { b }]
  print(xs[0])
  xs.push(if c { a } else { b })
  print(xs[1])
  const M: "x" | "y" | "z" = if c { a } else { b }
  print(M == "y")
}
positions(false, "x", "y")
function ret(c: boolean, a: "x" | "y", b: "y"): "x" | "y" | "z" {
  if c { a } else { b }
}
print(ret(false, "x", "y"))

// chains, a match, nested joins, an arm with a prelude, arms that are calls
function chain(k: i32, a: "x" | "y", b: "y", d: "x") {
  const M: "x" | "y" | "z" = if k == 0 { a } else if k == 1 { b } else { d }
  print(M)
}
chain(1, "x", "y", "x")
function matched(k: i32, a: "x" | "y", b: "y") {
  const M: "x" | "y" | "z" = match k {
    0 => a
    _ => b
  }
  print(M)
}
matched(0, "x", "y")
matched(1, "x", "y")
function prelude(c: boolean, a: "x" | "y", b: "y") {
  const M: "x" | "y" | "z" = if c {
    a
  } else {
    const s: string = a
    print(s + "!")
    b
  }
  print(M)
}
prelude(false, "x", "y")
function nested(c: boolean, d: boolean, a: "x" | "y", b: "y", e: "z") {
  const M: "x" | "y" | "z" = if c { a } else { if d { b } else { e } }
  print(M)
}
nested(false, true, "x", "y", "z")
nested(false, false, "x", "y", "z")
function calls(c: boolean, a: "x" | "y") {
  const M: "x" | "y" | "z" = if c { wrap(a) } else { pick() }
  print(M)
}
calls(false, "x")
calls(true, "x")

// generics: the join as a generic's argument, and a generic's own join
function generic(c: boolean, a: "x" | "y", b: "y") {
  const M: "x" | "y" | "z" = pass(if c { a } else { b })
  print(M)
  const N: "x" | "y" | "z" = sel(c, a, b)
  print(N)
}
generic(false, "x", "y")
generic(true, "x", "y")

// a closure, and the refusal's suggestion for a join of consts applied with `A` declared
function closure(c: boolean) {
  const h = (d: boolean) => {
    const M: "x" | "y" | "z" = if d { A } else { Bc }
    M
  }
  print(h(c))
}
closure(false)
function suggested(c: boolean) {
  const M: "x" | "y" | "z" = if c { A } else { Bc }
  M == "z"
}
print(suggested(true))

// module scope
const c = false
const MM: "x" | "y" | "z" = if c { A } else { Bc }
print(MM)

// a condition that is itself a string test stays a string: a compare against a member's
// spelling, an `else if` link, an `is` test, a `.length` and a list literal
function str() { "green" }
function conds(a: "red" | "green", g: "green") {
  const p = if str() == "green" { a } else { g }
  print(p)
  const q: "red" | "green" | "blue" = if str() == "red" { a } else if str() == "green" { g } else { a }
  print(q)
  const t = str()
  const r = if t is "green" | "red" { a } else { g }
  print(r)
  const u = if t.length > 3 { g } else { a }
  print(u)
  const w = if ["red", "green"].length > 1 { g } else { a }
  print(w)
}
conds("red", "green")

// an arm whose value clears the atom context (a `??` over a map read) leaves it for the next arm
function coalesced(c: boolean, g: "green") {
  const mp: {[string]: "red" | "blue"} = Map()
  mp["a"] = "red"
  const v: "red" | "green" | "blue" = if c { mp["a"] ?? "blue" } else { g }
  print(v)
  const w = if c { mp["b"] ?? "blue" } else if !c { g } else { mp["a"] ?? "blue" }
  print(w)
}
coalesced(true, "green")
coalesced(false, "green")
