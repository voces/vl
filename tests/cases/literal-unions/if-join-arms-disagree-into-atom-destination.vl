// @run
// @hint redundant type annotation: `M` is inferred as `XY` — remove it to lean on inference
// @hint redundant type annotation: `M` is inferred as `"x" | "y" | "z"` — remove it to lean on inference
// @info `l` is never reassigned; use `const` instead of `let`
// @log x
// @log y
// @log y
// @log x
// @log y
// @log y
// @log true
// @log y
// @log y
// @log y
// @log y
// @log y
// @log true
// @log y
// @log y
// @log x
// @log y
// @log x!
// @log y
// @log y
// @log z
// @log y
// @log x
// @log y
// @log y
// @log x
// @log x
// @log y
// @log false
// @log y
