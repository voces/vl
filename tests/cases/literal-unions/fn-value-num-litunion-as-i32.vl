// @run
// @log 4
// @log 2
// @log 2
// @log 42
// @log 42
// @log 3
// @log 20
// @log 2
// @hint redundant type annotation: `f` is inferred as `() => N` — remove it to lean on inference
// @hint redundant type annotation: `call` is inferred as `i32` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// @hint redundant type annotation: `fn2` is inferred as `() => N | null` — remove it to lean on inference
// A function whose result is a numeric literal union is a function returning its base `i32`,
// and a function taking `i32` is one taking the union: `1 | 2` reps as `i32`, so both types
// share one signature (D9382).
type N = 1 | 2
const a: N = 2
const b: i32 = a
const f: () => N = () => a
const g: () => i32 = f
print(b + g())

function h(): N { 2 }
const gh: () => i32 = h
print(gh())

// The un-annotated return infers `N` from the binding it reads.
const fu = () => a
const gu: () => i32 = fu
print(gu())

// A type parameter bound at `N` through the destination's parameter.
function same<T>(k: T): T { k }
const gs: (k: N) => i32 = same
print(gs(2) + 40)

// As an argument and through a generic call's result.
function call(fn: (k: N) => i32, k: N): i32 { fn(k) }
function idn(k: N): N { k }
print(call(idn, 2) + 40)

// Parameter position: a wider `i32` parameter is accepted where `N` is declared.
const inc: (k: i32) => i32 = (k: i32) => k + 1
const gi: (k: N) => i32 = inc
print(gi(2))

// Both slots at once, stored in a list.
const pick: (k: i32) => N = (k: i32): N => {
  if k > 1 { return 2 }
  1
}
const fs: ((k: N) => i32)[] = [pick]
print(fs[0](2) * 10)

// A nullable union result keeps converting as before.
const an: N | null = 2
const fn2: () => N | null = () => an
const gn: () => i32 | null = fn2
print(gn() ?? 0)
