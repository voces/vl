// @check
// @warning cannot compare "b" | "c" with "a" — not a member of the union here, so this comparison is always false
// @warning match pattern "a" can never match a value of type "b" | "c" here, so this arm never runs

// Once a compare has narrowed a member away, a later compare or `match` arm naming that member
// is a dead test, a warning, as it is after `is` (owner ruling 2026-11-12).
type K = "a" | "b" | "c"

function pick(i: i32): K {
  if i == 0 { return "a" }
  "b"
}
function again(i: i32) {
  const k = pick(i)
  if k == "a" { return "A" }
  if k == "a" { return "never" }
  k
}
function arm(i: i32) {
  const k = pick(i)
  if k == "a" { return "A" }
  match k {
    "a" => "never"
    "b" => "B"
    "c" => "C"
  }
}

print(again(0))
print(arm(1))
