// D7447: `("circle" | null)[]` and a one-literal alias's `(KC | null)[]` are one element type,
// so the list delivers in either direction and at an argument with no copy.
// @run
// @log circle
// @log none
// @log circle
// @log none
// @log circle
// @log 2
// @hint redundant type annotation: `takes` is inferred as `string`
type KC = "circle"
const xs: ("circle" | null)[] = ["circle", null]
const ys: (KC | null)[] = xs
print(ys[0] ?? "none")
print(ys[1] ?? "none")
const zs: ("circle" | null)[] = ys
print(zs[0] ?? "none")
function takes(a: (KC | null)[]): string { a[1] ?? "none" }
print(takes(xs))
const ws = [xs[0], xs[1]]
const vs: (KC | null)[] = ws
print(vs[0] ?? "none")
print(vs.length)
