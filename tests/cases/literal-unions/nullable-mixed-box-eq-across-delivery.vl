// @log true
// @log 2
// D12050: a `K | null | i32` box compared against a member of `K`, delivered as a list element,
// a call result, a parameter and an un-annotated binding of an element. None of these spell the
// union the way a bound row names it, so the compare reads the box's set off its type.
type K = "a" | "b"
function id(v: K | null | i32): K | null | i32 { v }
function kind(v: K | null | i32) {
  if v is K { "K" } else { "not" }
}
const zz: (K | null | i32)[] = ["a", 3, null, "b"]
print(zz[0] == "a")
print(zz[1] == "a")
print(zz[3] != "a")
print(id("b") == "a")
print(id("a") == "a")
print(kind(zz[0]))
print(kind(zz[1]))
print(kind(zz[2]))
const v = zz[3]
if v is K { print("K") } else { print("not") }
print(
  match id("b") {
    "a" => 1
    "b" => 2
    _ => 3
  },
)
const ff: (K | null | f64)[] = ["b"]
print(ff[0] == "b")
const w = ff[0]
if w is K { print("K") } else { print("not") }
print(w == "b")
print(
  match zz[0] {
    "b" => 1
    "a" => 2
    _ => 3
  },
)
