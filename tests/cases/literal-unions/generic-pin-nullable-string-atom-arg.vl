// @run
// @log b!
// @log a?

// D4028: a literal-union argument beside a bare `null`, into a `T` bound to `string | null`. The
// node's own type names no member, so the decode reads the set its delivery recorded.
function pair<T>(a: T, b: T): T[] { [a, b] }
const k: "a" | "b" = "b"
const ps: (string | null)[] = pair(null, k)
const e = ps[1]
if e != null { print(e + "!") }
const j: "a" | "b" = "a"
const qs: (string | null)[] = pair(j, null)
const f = qs[0]
if f != null { print(f + "?") }
