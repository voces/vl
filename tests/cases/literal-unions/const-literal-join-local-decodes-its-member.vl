// @run
// @log x
// @log true
// @log false
// @log 1
// @log x!
// @log y
// @log false
// @log true
// @log 1
// @log y!
// @log x
// @log <x>
// @log y
// @log <y>
// A `const` joining two const-bound literals is held as the joined set's atom (`letAtomCellTy`):
// each read decodes the member picked at run time, its text, its compare and its length.
const A = "x"
const B = "y"
function pick(c: boolean) {
  const M = if c { A } else { B }
  print(M)
  print(M == A)
  print(M == "y")
  print(M.length)
  const g = () => M + "!"
  print(g())
}
pick(true)
pick(false)
function show(c: boolean) {
  const M = if c { A } else { B }
  print(M)
  const g = () => "<" + M + ">"
  print(g())
}
show(true)
show(false)
