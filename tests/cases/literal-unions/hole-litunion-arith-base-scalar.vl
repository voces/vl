// @run
// @log 4
// @log 6
// @log true
// @log -2
// @log 16
// @log 12000000000
// @log 15000000000
// @log 6
// @log -5000000000
// @log 5000000002
// @log -9000000000
// @log 18000000000
// @log false
// @hint redundant type annotation: `r` is inferred as `i32`
// @hint redundant type annotation: `ng` is inferred as `i32`
// Arithmetic over a parameter or lambda bound at an integer literal union yields the union's
// base scalar, as the direct spelling does: `i32` for a one-width set (D9560), `i64` for a set
// spanning two widths, from its narrow member too (D9523, D3524).
type N = 1 | 2
type L = 5000000000 | 6000000000
type W = 1 | 2 | 5000000000
type U = 1 | 9000000000
const a: N = 2
const l: L = 6000000000
const wn: W = 2
const ww: W = 5000000000
const u: U = 9000000000
function twice(x) { x * 2 }
const r: i32 = twice(a)
print(r)
print(twice(a) + 2)
print(twice(a) == 4)
function neg(x) { -x }
const ng: i32 = neg(a)
print(ng)
const shl = (x) => x << 3
print(shl(a))
print(twice(l))
function thrice<T>(x: T) { x * 3 }
print(thrice(ww))
print(thrice(wn))
print(neg(ww))
const add = (x) => x + 5000000000
print(add(wn))
function op<T>(x: T) { -x }
print(op(u))
function dbl(x) { x * 2 }
print(dbl(u))
function less(x) { x < 2 }
print(less(ww))
