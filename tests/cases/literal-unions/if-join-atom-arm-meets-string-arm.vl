// @run
// @log green
// @log green
// @log green
// @log green
// @log green
// @hint redundant type annotation: `sv` is inferred as `string` — remove it to lean on inference
// An if-EXPRESSION whose arms disagree about the REP: one is an interned atom, the other a
// string. The join is the string ref and the atom arm widens to its member text — which the
// recorded join type cannot say inside a generic body, because a hole arm absorbs the join
// (`joinTys` collapses on mutual assignability and a hole is assignable both ways), so the
// `if` records the PARAMETER's type. Four classifiers read that one signal and all four now
// ask the arms when the recorded type is one arm's (D1728).
//
// The hole parameter is load-bearing: annotating it makes the checker record `string` for the
// join and every line below passes through the rung that was never blind.

type K = "red" | "green"
const src: K[] = ["green", "red"]
// `sv` keeps its annotation, hint and all: the arm under test must be a declared string
// VALUE rather than a member literal, and the hint is about the TYPE, not the rep.
const sv: string = "red"

// the four delivery positions, atom arm first
function bound(a) {
  const b = if a == "green" { a } else { "red" }
  print(b)
}
function shown(a) { print(if a == "green" { a } else { "red" }) }
function given(a) { return if a == "green" { a } else { "red" } }
function passed(a) { show(if a == "green" { a } else { "red" }) }
function show(s: string) { print(s) }

// the atom arm meeting a string VALUE rather than a member literal
function against(a) {
  const b = if a == "green" { a } else { sv }
  print(b)
}

bound(src[0])
shown(src[0])
print(given(src[0]))
passed(src[0])
against(src[0])
