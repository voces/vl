// D2216: a literal-union atom narrowed by `is` initialises a local annotated with the one
// narrowed literal, which reps as the same atom, and that local widens to its text.
// @run
// @log y
// @log y
// @log y
// @log true
// @hint redundant type annotation: `k` is inferred as `"y"`
type M = "x" | "y"
function f(m: M) {
  if m is "y" {
    const k: "y" = m
    print(k)
  }
}
f("y")
function g(m: "x" | "y") {
  if m is "y" {
    const k: "y" = m
    print(k)
    const s: string = k
    print(s)
    print(k == "y")
  }
}
g("y")
