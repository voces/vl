// @run
// @log q
// @log a
// @log null
// @log q
// @log a
// @log null
// @log q
// @log a
// @log null
// @log q
// @log a
// @log null
// @log false
// @log false
// @log true
// `string | null ?? K | null` where nothing else in the function streams a string: the return,
// the tail, a closure body and a `== null` test each widen the default atom themselves.
type K = "a" | "b"
function ret(sn: string | null, kn: K | null) { return sn ?? kn }
function retAnn(sn: string | null, kn: K | null): string | null {
  return sn ?? kn
}
function tail(sn: string | null, kn: K | null) { sn ?? kn }
function clo(sn: string | null, kn: K | null) {
  const f = () => sn ?? kn
  return f()
}
function isNull(sn: string | null, kn: K | null) {
  const v = sn ?? kn
  return v == null
}
const kn0: K | null = "a"
const knN: K | null = null
print(ret("q", kn0))
print(ret(null, kn0))
print(ret(null, knN))
print(retAnn("q", kn0))
print(retAnn(null, kn0))
print(retAnn(null, knN))
print(tail("q", kn0))
print(tail(null, kn0))
print(tail(null, knN))
print(clo("q", kn0))
print(clo(null, kn0))
print(clo(null, knN))
print(isNull("q", kn0))
print(isNull(null, kn0))
print(isNull(null, knN))
