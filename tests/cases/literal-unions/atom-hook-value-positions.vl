// @run
// @log zz
// @log zzzz
// @log true
// @log 4
// @log zz
// @log 3
// @log k=zz
// @log zz
// @log k=zzzz
// @log ck=zz
// @log h k=zz
// @log k=zz
// @log k=zz
// @log k=zz
// @log k=zz
// @log k=zz
// A value the atom hook converts (a const bound to a literal, a one-literal call result) in
// each position: map value and key, a set element, a `K | null` destination, one per function.
type K = "zz" | "yy"
const Z = "zz"
function one(): "zz" { return "zz" }
function name(k: K) { return "k=" + k }
function maybe(k: K | null) { return k ?? "none" }
function mapValue() {
  const m: {[string]: K} = Map()
  m["a"] = Z
  m.set("b", one())
  return (m["a"] ?? "-") + (m["b"] ?? "-")
}
function setKey() {
  const t = Set()
  t.add(one())
  return t.has("zz")
}
function mapKey() {
  const m: {[K]: i32} = Map()
  m[Z] = 4
  return m[one()] ?? 0
}
function nullable() {
  const x: K | null = one()
  return x ?? "none"
}
function listElem() {
  const xs: (K | null)[] = [one(), null, Z]
  return xs.length
}
function arg() { return name(Z) }
function unionArg() { return maybe(one()) }
function nested() { return name(one()) + maybe(Z) }
function concat() { return "c" + name(Z) }
function hole() { return "h \{name(one())}" }
function ret(): K { return Z }
function init() {
  const v: K = one()
  return name(v)
}
function field() {
  const r: { k: K } = { k: Z }
  return name(r.k)
}
function arm(c: boolean) {
  const v: K = if c { one() } else { "yy" }
  return name(v)
}
function coal(c: boolean) {
  const n: K | null = if c { null } else { one() }
  const d: K = Z
  return name(n ?? d)
}
const g: {[string]: K} = Map()
g["top"] = Z
print(g["top"] ?? "-")
print(mapValue())
print(setKey())
print(mapKey())
print(nullable())
print(listElem())
print(arg())
print(unionArg())
print(nested())
print(concat())
print(hole())
print(name(ret()))
print(init())
print(field())
print(arm(true))
print(coal(true))
