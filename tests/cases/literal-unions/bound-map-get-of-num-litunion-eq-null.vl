// @run
// @log true
// @log false
// @log true
// CONTRACT: `b == null` over an un-annotated binding of `m.get(k)`, `m` a map whose value is
// a numeric literal union, compares the `N | null` box the binding holds, at top level and in
// a function, for a miss and a hit (D2491).

type N = 0 | 5 | 7

const m: {[string]: N} = Map()
const b = m.get("a")
print(b == null)

function f() {
  const fm: {[string]: N} = Map()
  fm.set("k", 5)
  const e = fm.get("k")
  print(e == null)
  const g = fm.get("q")
  print(g == null)
}

f()
