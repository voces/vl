// @run
// @log zz
// @log ww
// @log zz
// @log none
// @log ww
// An assignment to a `K | null` local used as a value, delivered at that local's own type, is the
// cell re-read as it stands: an argument, an annotated `const`, a value `if` arm, and beside them a
// `string` result, which decodes the atom.
type K = "ww" | "zz"
function show(x: K | null) { print(x ?? "none") }
function arg() {
  let k: K | null = null
  show(k = "zz")
}
function ann() {
  let k: K | null = null
  const v: K | null = k = "ww"
  print(v ?? "none")
}
function arm(c: boolean): K | null {
  let k: K | null = null
  return if c { k = "zz" } else { null }
}
function str(): string {
  let k: K | null = null
  return k = "ww"
}
arg()
ann()
print(arm(true) ?? "none")
print(arm(false) ?? "none")
print(str())
