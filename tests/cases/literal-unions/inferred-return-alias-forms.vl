// @run
// @log B
// @log B
// @log B
// @log B
// @log B
// @log B
// @log B
// The FUNCTION-FORM axis of an inferred literal-union return: every spelling reaches the
// interned i32 ATOM rep, not just the named block form.
//
// CONTRACT: the arrow / generic / nested forms already lowered — an anonymous lambda's
// inferred return is recorded at its own litunion rung and pinned into `fnRet`, which puts
// it back on the ANNOTATED path. The named `function`, the UFCS method and the brace-less
// body had no such rung, so their recorded name was claimed as a variant-box union and the
// callee boxed a value the call sites read as an atom. Recursion is here because the
// self-call reads the same slot the classification is still settling.

type K = "A" | "B" | "C" | "D"

// Named declaration with a block body.
function blockForm(k: K) { return k }
print(blockForm("B"))

// Brace-less body (a bare expression).
function bareForm(k: K) k
print(bareForm("B"))

// Arrow lambda.
const arrowForm = (k: K) => k
print(arrowForm("B"))

// UFCS method — `self` is the literal-union receiver.
function selfForm(self: K) { return self }
const recv: K = "B"
print(recv.selfForm())

// Generic: the type parameter instantiates at the literal union per call site.
function genForm<T>(k: T) { return k }
print(genForm(recv))

// Nested (lifted) declaration, called from its enclosing frame.
function outerForm() {
  function innerForm(k: K) { return k }
  print(innerForm("B"))
}
outerForm()

// Recursion — the self-call must settle on the atom too.
function recForm(k: K, n: i32) {
  if n > 0 { return recForm(k, n - 1) }
  return k
}
print(recForm("B", 3))
