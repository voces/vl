// @check
// @warning cannot compare 2 | 3 with 1 — not a member of the union here, so this comparison is always false

// Once a compare against a literal `const` has narrowed its member away, a later compare against
// it is a dead test, a warning, as the same compare against the literal is (owner ruling
// 2026-11-12: an impossibility only a narrowing makes is a warning).
type N = 1 | 2 | 3

const ONE = 1

function again(n: N) {
  if n == ONE { return 0 }
  if n == ONE { return 1 }
  2
}

print(again(2))
