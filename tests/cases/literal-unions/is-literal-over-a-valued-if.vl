// @run
// @log y
// @log n
// @log n
// @log true
// @log false
// A literal `is` test whose receiver is a valued `if` (a value waiting on the stack): the value
// is read once, and each member's compare reads it again from where it was stored.
type QS = "qa"
type QT = "qa" | "qb"
function f(p: string | null, q: string | null) {
  if (if p != null { p } else { q }) is QS { print("y") } else { print("n") }
}
function g(p: string | null, q: string | null) {
  print((if p != null { p } else { q }) is QT)
}
f("qa", null)
f(null, "zz")
f(null, null)
g(null, "qb")
g("zz", "qa")
