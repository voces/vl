// @run
// @log a
// @log k=a
// @log <a>
// @log true
// @log a
// @log none
// @log zz
// @log true
type K1 = "circle" | "round"
type A = { kind: K1, r: f64 }
type B = { kind: "a", r: f64 }
type K = "ww" | "zz"
type R = { k: K | null }
function f(n: i32): A | B {
  if n == 0 { return { kind: "circle", r: 1.0 } }
  const v: B = { kind: "a", r: 2.0 }
  return v
}
function takeS(s: string) { return "<" + s + ">" }
function narrowed(n: i32) {
  const b = f(n)
  if b is B {
    const k = b.kind
    print(k)
    print("k=\{k}")
    print(takeS(k))
    print(k == "a")
    return k
  }
  return "none"
}
function viaField(r: R) {
  r.k = "zz"
  const v = r.k
  print(v)
  return v
}
print(narrowed(2))
print(narrowed(0))
print(viaField({ k: null }) == "zz")
