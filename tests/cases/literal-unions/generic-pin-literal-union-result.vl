// @run
// @log a
// @log a
// @log 1
// @log 2
// @hint redundant type annotation: `k` is inferred as `"a" | "b"`
// @hint redundant type annotation: `k2` is inferred as `"a" | "b"`
// A generic `T | "b"` instantiated at `T := "a"` is a union minted at the pin, whose instance
// returns the string its pinned `T` is. The call's recorded type must say the same thing, so a
// literal-typed destination narrows the string to its atom, at a written alias and at an inline
// set alike (#3056 review).
type K = "a" | "b"
function f<T>(x: T): T | "b" { x }
const a: "a" = "a"
const k: K = f(a)
print(k)
const k2: "a" | "b" = f(a)
print(k2)

function f2<T>(x: T, b: boolean): T | "b" {
  if b { return "b" }
  x
}
function q(v: "a" | "b") {
  if v == "a" { return 1 }
  2
}
function main() {
  const a2: "a" = "a"
  print(q(f2(a2, false)))
  print(q(f2(a2, true)))
}
main()
