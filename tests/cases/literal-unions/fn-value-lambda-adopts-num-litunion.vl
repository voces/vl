// @run
// @log 2
// @log 6000000000
// @log 1
// @log 3
// @log 2
// @log 42
// @log 10
// @log 1
// @log 5000000000
// @log 7
// @log 5000000002
// @log 2
// @log 0.5
// A lambda delivered where a function returning a numeric literal union is expected adopts
// that union when every value it returns, each `return` and the tail, is a member (D9490).
type N = 1 | 2
type L = 5000000000 | 6000000000
const d = false
const hn: () => N = () => {
  if d { return 1 }
  2
}
print(hn())
const hl: () => L = () => 6000000000
print(hl())
function call(f: () => N): i32 { f() }
print(call(() => 1))
const gs: (() => N)[] = [() => 2, () => 1]
print(gs[0]() + gs[1]())
let r: () => N = () => 1
r = () => 2
print(r())

// The same into `N | null`: the result is the base's nullable box (D9491).
const a: N = 2
const ha: () => N | null = () => a
print((ha() ?? 0) + 40)
const hz: () => N | null = () => 1
print((hz() ?? 0) * 10)
const hy: () => N | null = () => {
  if d { return null }
  1
}
print(hy() ?? 0)
const ln: () => L | null = () => 5000000000
print(ln() ?? 0)
const n2: () => N | null = () => null
print(n2() ?? 7)

// A lambda returning a numeric literal union adopts a numeric scalar every member converts to
// exactly, and converts at its return (D9492).
type W = 1 | 2 | 5000000000
const w: W = 2
function wf(): W { w }
const gw: () => i64 = () => wf()
print(gw() + 5000000000)
const gi: () => i64 = () => a
print(gi())
const gf: () => f64 = () => a
print(gf() / 4.0)
