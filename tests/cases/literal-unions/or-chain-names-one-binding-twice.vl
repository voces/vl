// @run
// @log 7
// @log 7

// An `||` chain that tests one binding twice keeps the narrowing its last test leaves: the
// earlier fact is superseded in scope, not retired by the right-hand side. The compiler's own
// `k == null || k == "u8" || ak < 0` is this shape.
type K = "a" | "b" | "c" | "d"

function pick(n: i32): K | null {
  if n == 0 { return null }
  "c"
}
function take(k: "c" | "d") {
  if k == "d" { return 8 }
  7
}
function viaIs(n: i32, ak: i32) {
  const k = pick(n)
  if k is "a" { return 0 }
  if k == null || k is "b" || ak < 0 { return 1 }
  take(k)
}
function viaEq(n: i32, ak: i32) {
  const k = pick(n)
  if k == "a" { return 0 }
  if k == null || k == "b" || ak < 0 { return 1 }
  take(k)
}
print(viaIs(1, 2))
print(viaEq(1, 2))
