// @check
// @error argument 1: expected 1 | 2 | null, got 7 | 9 | null
// The ASSIGNMENT half of `same-layout-litunions-stay-distinct.vl`. Both aliases soften to the
// same `i32|null` box, so the emitter files them under one registry entry — and the CHECKER
// must still reject the cross-assignment, because it reads the precise arena types and never
// the softened spelling. A regression here would make the rep layer's sharing observable as a
// type hole.
type A = 1 | 2 | null
type B = 7 | 9 | null

function takesA(x: A): i32 {
  if x is null { return -1 }
  x
}

const b: B = 7
print(takesA(b))
