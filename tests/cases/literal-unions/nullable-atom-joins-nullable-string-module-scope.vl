// @run
// @log b
// @log s
// @log rnull
// @log a
// @log arg s
// @log b
// @log qnull
// @log a
// @log s
// @log b
// A value `if` typed `string | null` is the nullable string, whatever atoms its arms hold, at
// module scope as in a function, and along an `else if` chain as for a single pair (D7450).
type K = "a" | "b"
const k: K | null = "b"
const n: string | null = null
const r = if k != null { k } else { n }
print(r ?? "rnull")
const k2: K | null = null
const n2: string | null = "s"
let w = if k2 == null { n2 } else { k2 }
w = w
print(w ?? "wnull")
print((if k2 != null { k2 } else { n }) ?? "rnull")
const m: {[string]: K} = Map()
m["x"] = "a"
const v = m["x"]
const mv = if v != null { v } else { n }
print(mv ?? "mnull")
function show(s: string | null) { print("arg " + (s ?? "none")) }
show(if k2 != null { k2 } else { n2 })
const c = k2 != null
const ch = if c { n2 } else if k != null { k } else { n2 }
print(ch ?? "chnull")
const q = if c { k2 } else if k2 != null { k2 } else { null }
print(q ?? "qnull")
function go(j: K | null, x: K | null, s: string | null) {
  const t = if j != null { j } else if x != null { x } else { s }
  print(t ?? "tnull")
}
go(null, "a", "s")
go(null, null, "s")
go("b", null, null)
