// @check
// @error-at 18:9 both imports and declares it — rename one (`as` on the import)
// @error Duplicate binding "toString": module `
// THE SHADOWING ANSWER, PINNED — and it is neither "the import wins" nor "the
// declaration wins".
//
// `toString` moved from an ambient builtin to `std:fmt`'s export on 2026-09-01
// (DECISIONS.md). A builtin was SHADOWABLE — a program could declare its own
// `print` or `toString` and the emitter resolved to the user's function (D975) —
// so the natural question after the move is which one wins when a file both
// imports std's and declares its own. The language's answer is that the question
// does not arise: VL has no namespace import, every import lands in the flat
// top-level scope, and a name bound twice there is a HARD PARSE ERROR.
//
// D975's own witness is the other half of this: a file that declares `toString`
// and never imports it still runs, and must keep running.
import { toString } from "std:fmt"

function toString(self: { foo: string }) {
  self.foo
}

const b = { foo: "mine" }
print(b.toString())
