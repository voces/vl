// @error redeclared show: `show(self: T, …)` (an open first parameter, which overlaps every kind) and `show(self: A, …)` (`A` first) overlap
// A generic `self: T` candidate overlaps every head class, so beside a concrete one it would be
// specialization, which receiver overloading does not do.
type A = { x: i32 }
function show<T>(self: T): string { return "any" }
function show(self: A): string { return "A" }

const a: A = { x: 1 }
print(a.show())
