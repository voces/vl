// @run
// @log 1
// @log 2.5
// @log 0.75
// @log 8
// @log 9.5
// A member call types an un-annotated lambda argument as the plain call does: the receiver
// binds the callee's type parameters first, then each lambda meets its parameter under that
// binding and the other arguments' (sunpa SP-052). Each line proves the inferred type.
import { sort, sorted } from "std:array"

function each<T>(self: T[], f: (T) => void) {
  for x in self { f(x) }
}

function fold<T, A>(self: T[], init: A, f: (A, T) => A): A {
  let acc = init
  for x in self { acc = f(acc, x) }
  acc
}

const keys = [3.5, 1.25, 2.0]
const order = [0, 1, 2]
order.sort((a, b) => keys[a] < keys[b])
print(order[0])
print(keys[order[0]] * 2.0)

const xs = [2.5, 0.5, 1.5]
const ys = xs.sorted((a, b) => a / 2.0 < b / 2.0)
print(ys[0] + 0.25)

const zs = [1.5, 2.5]
let s = 0.0
zs.each((x) => {
  s = s + x * 2.0
})
print(s)

// `A` comes from the second argument, `T` from the receiver.
const ns = [1, 2, 3]
print(ns.fold(0.5, (acc, x) => acc + (x as f64) * 1.5))
