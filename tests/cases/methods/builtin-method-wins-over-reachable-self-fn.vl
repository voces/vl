// @run
// @log 1
// @log he
// @log user
// @log 99
// @log 2
// @warning Unused parameter `self` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `a` (prefix with `_` to suppress, or remove it)
// @warning Unused parameter `b` (prefix with `_` to suppress, or remove it)
// A `self`-function that some receivers reach is declared legally, and a receiver whose type
// has a built-in method of that name still calls the built-in — at run time as well as in the
// checker (D2476). Before, the emitter called the function wherever one of that name existed:
// `xs.push(1)` printed 99 and left the list empty while the checker had typed the built-in.
function push(self: i32[] | string, x: i32) { print(99 + x - x) }
function slice<T>(self: T, a: i32, b: i32) { "user" }
const xs: i32[] = []
xs.push(1)
print(xs.length)
print("hello".slice(0, 2))
print((3).slice(0, 2))
const u: i32[] | string = "a"
u.push(1)
const ys = [5]
ys.push(6)
print(ys.length)
