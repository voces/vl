// @run
// @log 41
// @log 4
// @log 40
// @log ab!
// @log 3
// @log a
// @log 3
// @log -1
// @log 43
// @log b
// @log 2
// @log 42
// A method call on a local set in each delivery position: argument, return, concatenation,
// field, `??` over `?.`, closure body, and a nested call.
type A = { x: i32 }
type B = { s: string }
function val(self: A) { return self.x * 10 }
function val(self: B) { return self.s.length }
function lbl(self: A) { return if self.x > 0 { "a" } else { "?" } }
function lbl(self: B) { return self.s.slice(0, 0) + "b" }
type Holder = { n: i32, t: string }
function take(n: i32) { return n + 1 }
function ret(a: A) { return a.val() }
const a: A = { x: 4 }
const b: B = { s: "hey" }
// argument
print(take(a.val()))
print(take(b.val()))
// return
print(ret(a))
// concatenation
print(a.lbl() + b.lbl() + "!")
// field
const h: Holder = { n: b.val(), t: a.lbl() }
print(h.n)
print(h.t)
// ??
const mb = if a.x > 0 { b } else { null }
print(mb?.val() ?? -1)
const na = if a.x < 0 { a } else { null }
print(na?.val() ?? -1)
// closure
const f = () => a.val() + b.val()
print(f())
const g = (q: B): string => q.lbl()
print(g(b))
// chained / nested
print([a, a].map((e) => e.val()).length)
print(take(take(a.val())))
