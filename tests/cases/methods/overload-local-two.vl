// @run
// @log A1
// @log B:q
// Receiver overloading within one module (O1 extended): two same-named `self`-functions whose
// first parameters differ in kind coexist, and a method call picks by the receiver's type.
type A = { x: i32 }
type B = { s: string }
function describe(self: A) {
  return "A" + (if self.x == 1 { "1" } else { "?" })
}
function describe(self: B) { return "B:" + self.s }

const a: A = { x: 1 }
const b: B = { s: "q" }
print(a.describe())
print(b.describe())
