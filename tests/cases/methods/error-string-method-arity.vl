// @check
// @error slice expects 2 arguments, got 3
// @error indexOf expects 1 argument, got 0
// @error includes expects 1 argument, got 2
// @error charCodeAt expects 1 argument, got 0
// @error cpAt expects 1 argument, got 0
// @error cpLen expects no arguments, got 1
// @error isCharBoundary expects 1 argument, got 0
// @error bytes expects no arguments, got 1
// The string methods carry a fixed arity each — `.slice` takes both bounds (unlike the
// array `.slice`, whose end is optional), and `.cpLen`/`.bytes` take none. A wrong count
// is a type error at the call rather than an argument the lowering drops.
const s = "hello"
const _a = s.slice(0, 1, 2)
const _b = s.indexOf()
const _c = s.includes("a", "b")
const _d = s.charCodeAt()
const _e = s.cpAt()
const _f = s.cpLen(1)
const _g = s.isCharBoundary()
const _h = s.bytes(1)
print(s.cpLen())
