// @check
// @error `x` is already a field of `P`, so `p.x(…)` would never call this function — rename it
// @error `f` is already a field of `Q`, so `p.f(…)` would never call this function — rename it
// @error `inner` is already a field of `{inner: {v: i32}}`, so `p.inner(…)` would never call this function — rename it
// A `self`-function named after a FIELD of its receiver type is refused where it is declared
// (D2475): `recv.name(…)` resolves the field first — a plain one, a closure-typed one, or one on
// an inline record — so the function would never run, whatever arguments the call passes.
type P = {x: i32, y: i32}
type Q = {f: () => i32}
function x(self: P, k: i32): i32 { self.y + k }
function f(self: Q): i32 { self.f() + 1 }
function inner(self: {inner: {v: i32}}): i32 { self.inner.v }
