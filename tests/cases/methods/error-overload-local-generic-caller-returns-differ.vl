// @error `.get(…)` cannot choose between `get(self: A, …)` (`A` first) and `get(self: B, …)` (`B` first) for a receiver each call supplies, because the candidates return different types — annotate the receiver
// O1's generic-caller rule holds for a local set: candidates with different returns leave the
// body untypeable without an instance.
type A = { x: i32 }
type B = { s: string }
function get(self: A): i32 { return self.x }
function get(self: B): string { return self.s }
function show<T>(v: T) { print(v.get()) }

const a: A = { x: 3 }
show(a)
