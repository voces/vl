// @check
// @error set expects 2 arguments, got 1
// @error get expects 1 argument, got 0
// @error has expects 1 argument, got 0
// @error keys expects no arguments
// @error values expects no arguments
// @error add expects 1 argument, got 0
// The map and set methods are arity-checked by flavor: a map exposes `.set`/`.get`/`.has`/
// `.delete`/`.keys`/`.values`, a set only `.add`/`.has`/`.delete`/`.values`, and each has a
// fixed argument count. `.keys`/`.values` take none at all, so any argument is an error.
const m: {[string]: i32} = Map()
m.set(1)
const _g = m.get()
const _h = m.has()
const _k = m.keys(1)
const _v = m.values(1)
const s: {[string]: boolean} = Set()
s.add()
const _sv = s.values(1)
print(m.values().length)
