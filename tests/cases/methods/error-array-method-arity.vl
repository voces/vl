// @check
// @error push expects 1 argument, got 2
// @error pop expects 0 arguments, got 1
// @error get expects 1 argument, got 0
// @error clear expects 0 arguments, got 1
// @error slice expects 1 or 2 arguments, got 3
// @error map expects a function, got i32
// @error filter callback expects 1 parameter, got 2
// @error filter predicate must yield boolean, got i32
// Every builtin method on an ARRAY receiver carries a fixed arity, and `.map`/`.filter`
// additionally constrain the callback: one parameter, and for `.filter` a boolean result.
// A wrong count is a type error at the call, not a silently ignored argument.
const xs: i32[] = [1, 2, 3]
xs.push(1, 2)
const a = xs.pop(1)
const _b = xs.get()
xs.clear(1)
const _c = xs.slice(0, 1, 2)
const _d = xs.map(1)
const _e = xs.filter((p: i32, q: i32) => true)
const _f = xs.filter((p: i32) => 1)
print(a ?? 0)
