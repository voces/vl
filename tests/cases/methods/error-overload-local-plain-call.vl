// @error `describe` names `describe(self: A, …)` (`A` first) and `describe(self: B, …)` (`B` first), and a plain call does not choose between them — call it as a method, `x.describe(…)`, which picks by the receiver's type
// With two local candidates, lexical scope has no single declaration to prefer, so a plain
// call is refused and names the method spelling.
type A = { x: i32 }
type B = { s: string }
function describe(self: A): string { return "A" }
function describe(self: B): string { return "B" }

const a: A = { x: 1 }
print(describe(a))
