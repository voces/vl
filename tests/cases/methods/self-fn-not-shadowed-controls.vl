// @run
// @log 7
// @log 42
// @log 43
// @log 1
// @log 44
// @log UFCS
// @log 1
// @log 45
// @log 1
// @warning Unused parameter `self` (prefix with `_` to suppress, or remove it)
// The controls for D2475: a `self`-function is refused only when every receiver its `self`
// admits already has the member, so each of these is declared, called, and reached. In order:
// a method name over a type without that method; the call spelling of a member read (`length`
// on a list, `size` on a set); a type-parameter `self` (a string receiver still takes the built-in);
// and a nullable record, reached by a null receiver.
type P = {x: i32}
function get(self: i32, k: i32) { self + k }
function length(self: i32[]) { self[0] + 41 }
function slice<T>(self: T, a: i32) { a + 43 }
function x(self: P | null) {
  if self == null { return "UFCS" }
  "field"
}
function size(self: Set<i32>) { self.length + 45 }
print((3).get(4))
print([1].length())
print((0).slice(0))
print("abc".slice(0, 1).length)
print(true.slice(1))
const pn: P | null = null
print(pn.x())
const p = { x: 1 }
print(p.x)
const s: Set<i32> = Set()
print(s.size())
s.add(9)
print(s.length)
