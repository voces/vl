// @run
// @log 5.625
// @log -1
// @log 0.125
// An optional member call types its lambda argument from the callee as a plain member call
// does (sunpa SP-052). The generic `xs?.sorted(…)` spelling is held by D3821, an emit refusal
// of any generic `self`-function behind `?.`, lambda or not.
function total(self: f64[], f: (f64) => f64) {
  let s = 0.0
  for x in self { s = s + f(x) }
  s
}

function pick(xs: f64[] | null): f64 {
  const y = xs?.total((x) => x * 1.5)
  if y == null { return -1.0 }
  y
}

print(pick([2.5, 1.25]))
print(pick(null))
const ys = [0.5]
print(ys.total((x) => x / 4.0))
