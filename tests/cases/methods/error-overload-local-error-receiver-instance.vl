// @error this value is already `A` here, so the `as` cast does nothing — drop it
// D17480: an instance pinned at `<error>` (the redundant cast's) has no head to pick by, so the
// generic body's overloaded member call reports nothing of its own beside the cast's error.
type A = { x: i32 }
type B = { y: string }
function describe(self: A): string { return "A" }
function describe(self: B): string { return "B" }
function show<T>(v: T) { print(v.describe()) }
show({ x: 2 } as A)
