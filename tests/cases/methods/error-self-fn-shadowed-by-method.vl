// @error `slice` is already a method of `Name`, so `s.slice(…)` would never call this function — rename it
// A `self`-function named after a built-in method of its receiver type is refused where it is
// declared (D2475): `recv.name(…)` resolves the built-in first, so the function would never run.
// Each built-in list, map, set and string method is one row (a boolean-valued map is a map), then a generic element type, an
// alias and a newtype, all of which resolve through the same built-in arm. Each group is
// nested in its own function so the repeated names do not collide.
type Stack = i32[]
type Name = new string
function listMethods() {
  function push(self: i32[], x: i32) {}
  function map(self: i32[], f: (i32) => i32): i32[] { [] }
  function filter(self: i32[], f: (i32) => boolean): i32[] { [] }
  function pop(self: i32[]): i32 { 0 }
  function get(self: i32[], i: i32): i32 { i }
  function clear(self: i32[]) {}
  function slice(self: i32[], a: i32): i32[] { [] }
}
function genericList() {
  function push<T>(self: T[], x: T) {}
}
function mapMethods() {
  function get(self: {[i32]: i32}, k: i32): i32 { k }
  function set(self: {[i32]: i32}, k: i32, v: i32) {}
  function keys(self: {[i32]: i32}): i32 { 0 }
  function has(self: {[i32]: i32}, k: i32): boolean { false }
  function delete(self: {[i32]: i32}, k: i32): boolean { false }
  function values(self: {[i32]: i32}): i32 { 0 }
}
function setMethods() {
  function add(self: Set<i32>, k: i32) {}
  function has(self: Set<i32>, k: i32): boolean { false }
  function delete(self: Set<i32>, k: i32): boolean { false }
  function keys(self: Set<i32>): i32 { 0 }
  function values(self: Set<i32>): i32 { 0 }
  function get(self: {[i32]: boolean}, k: i32): i32 { k }
}
function stringMethods() {
  function slice(self: string, a: i32, b: i32): string { "" }
  function indexOf(self: string, t: string): i32 { 0 }
  function includes(self: string, t: string): boolean { false }
  function charCodeAt(self: string, i: i32): i32 { i }
  function cpAt(self: string, i: i32): i32 { i }
  function cpLen(self: string): i32 { 0 }
  function isCharBoundary(self: string, i: i32): boolean { false }
  function bytes(self: string): i32 { 0 }
}
function aliasAndNewtype() {
  function pop(self: Stack): i32 { 0 }
  function slice(self: Name, a: i32, b: i32): string { "" }
}
