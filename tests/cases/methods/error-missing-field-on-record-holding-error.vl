// @error-at 4:24 undeclared identifier 'nope'
// @error-at 5:8 no field 'missing'
// DV-101's limit — the cascade rule silences a METHOD lookup over a receiver holding an
// error type, never a missing field: `r.missing` is its own mistake and is still reported.
const r = { ok: 1, bad: nope }
print(r.missing)
