// @run
// @log rec
// @log str
// @log num
// @log num
// Three candidates in one module: a record, a string and the numeric class. The numeric
// candidate takes every number width, since literals adapt.
type R = { r: boolean }
function kind(self: R) { return if self.r { "rec" } else { "Rec" } }
function kind(self: string) { return if self.length > 0 { "str" } else { "" } }
function kind(self: f64) { return if self > 0 { "num" } else { "neg" } }

const r: R = { r: true }
print(r.kind())
print("x".kind())
print((2.5).kind())
const n: f64 = 7
print(n.kind())
