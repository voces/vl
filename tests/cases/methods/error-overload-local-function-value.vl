// @error `f` names `f(self: A, …)` (`A` first) and `f(self: B, …)` (`B` first), so it cannot be used as a function value — call it as a method, `x.f(…)`, which picks by the receiver's type
// A function value cannot name a set; an annotated lambda picks the candidate instead.
type A = { x: i32 }
type B = { s: string }
function f(self: A): i32 { return 1 }
function f(self: B): i32 { return 2 }

const g = f
