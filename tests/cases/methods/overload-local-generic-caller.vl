// @run
// @log 6
// @log 10
// A generic caller's method call picks per instance when every candidate returns one type.
type A = { x: i32 }
type B = { s: string }
function size(self: A) { return self.x }
function size(self: B) { return self.s.length }
function twice<T>(v: T) { return v.size() * 2 }

const a: A = { x: 3 }
const b: B = { s: "hello" }
print(twice(a))
print(twice(b))
