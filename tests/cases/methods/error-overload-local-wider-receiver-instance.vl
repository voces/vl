// @error `.describe(…)` on W matches more than one of `describe(self: A, …)` (`A` first) and `describe(self: B, …)` (`B` first)
// The control for D17480: an instance whose receiver two candidates both accept (a wider
// record) is still refused at the pin; only an `<error>` receiver stays silent.
type A = { x: i32 }
type B = { y: string }
type W = { x: i32, y: string }
function describe(self: A): string { return "A" }
function describe(self: B): string { return "B" }
function show<T>(v: T) { print(v.describe()) }
const w: W = { x: 1, y: "q" }
show(w)
