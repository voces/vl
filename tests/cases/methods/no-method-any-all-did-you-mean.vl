// @check
// @error no method '.any' on array i32[]; did you mean '.some'?
// @error no method '.all' on array i32[]; did you mean '.every'?
// Another language's spelling of a list predicate names `std:array`'s: `.any` is `.some`
// and `.all` is `.every`.
import { every, some } from "std:array"

const xs = [1, 2, 3]
print(xs.any((i) => i == 2))
print(xs.all((i) => i > 0))
print(xs.some((i) => i == 2))
print(xs.every((i) => i > 0))
