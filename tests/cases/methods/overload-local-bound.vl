// @run
// @log 2
// @log q
// A structural bound is satisfied through a local set: each instance type takes its own
// candidate, as the call `x.mn(y)` resolves.
type A = { v: i32 }
type B = { s: string }
function mn(self: A, o: A): A {
  if o.v < self.v { return o }
  return self
}
function mn(self: B, o: B): B {
  if o.s.length < self.s.length { return o }
  return self
}
function lo<T: { mn(T): T }>(x: T, y: T): T { return x.mn(y) }

const a1: A = { v: 3 }
const a2: A = { v: 2 }
const b1: B = { s: "xyz" }
const b2: B = { s: "q" }
print(lo(a1, a2).v)
print(lo(b1, b2).s)
