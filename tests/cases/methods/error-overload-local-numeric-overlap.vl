// @error redeclared f: `f(self: i32, …)` (a number first) and `f(self: f64, …)` (a number first) overlap, and same-named functions in one module coexist only when their first parameters differ in kind
// Every number width is one head class, so two numeric candidates overlap.
function f(self: i32): i32 { return 1 }
function f(self: f64): i32 { return 2 }

print((1).f())
