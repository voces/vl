// @error-at 6:46 'includes' is not imported
// diderven DV-101 — one missing UFCS import is one error. `g.includes(1)` has the error type,
// so `expect(…)` builds an expectation over it; the `toEqual` lookup on that receiver is the
// cascade, and must not add a second `'toEqual' is not imported` that `--fix` would act on.
import { it, expect } from "std:test"

it("x", () => { const g: i32[] = []; expect(g.includes(1)).toEqual(false) })
