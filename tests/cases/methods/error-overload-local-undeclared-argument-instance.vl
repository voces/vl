// @error undeclared identifier 'nope'
// D17480: an undeclared argument pins the instance at `<error>`; only its own error is reported.
type A = { x: i32 }
type B = { y: string }
function describe(self: A): string { return "A" }
function describe(self: B): string { return "B" }
function show<T>(v: T) { print(v.describe()) }
show(nope)
