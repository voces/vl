// @run
// @log 0
// @log x
// @log 0
// @log 5
// An un-annotated lambda returning an empty `[]` at a binding annotated `() => string[]` or
// `() => i32[][]` takes the annotation's result as its own, so the list it returns is built
// at that element type and takes a pushed element. The empty literal's element is a hole, and
// before the lambda adopted the result this was a loud floor (`inferRetEmptyListFloor`).
// The `i32` and `boolean` elements are pinned in `lambda-empty-array-literal-return.vl`.

function main() {
  const fs: () => string[] = () => {
    return []
  }
  const a = fs()
  print(a.length)
  a.push("x")
  print(a[0])
  const fn: () => i32[][] = () => {
    return []
  }
  const b = fn()
  print(b.length)
  b.push([5])
  print(b[0][0])
}
main()
