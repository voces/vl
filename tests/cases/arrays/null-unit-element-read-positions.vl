// @log 2
// @log null
// @log true
// An element read of a `null[]` list is read for its effects, then delivers its destination's null.
// Positions: binding, argument, `return`, record field, list element, `print` and a comparison.
type H = { n: null }
function take(x: null) { return x == null }
function count(l: null[]) { return l.length }
function ret(a: null[]): null { return a[0] }
function run(k: i32) {
  const a: null[] = [null, null]
  const x = a[k]
  print(x == null)
  print(take(a[k]))
  print(ret(a) == null)
  const h: H = { n: a[k] }
  print(h.n == null)
  print(count([a[k], a[1]]))
  print(a[k])
  print(a[k] == null)
}
run(0)
run(1)
