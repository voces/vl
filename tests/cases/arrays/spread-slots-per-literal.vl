// @run
// @log 7
// @log 1
// @log 9
// @log 4
// @log 2.5
// Every spread literal keeps its own frame slots: two in one function, one nested in another's
// run, one in a loop body, and one in a generic function built at two element types.
function both(a: i32[], b: i32[]): i32 {
  const x = [...a, 1, ...b]
  const y = [...b, ...a]
  return x.length + y[0]
}
function nest(a: i32[]): i32 {
  const z = [...a, [...a, 7].length]
  return z[z.length - 1] + z.length - 3
}
function pair<T>(a: T[], b: T[]): T[] { return [...a, ...b] }
print(both([1, 2], [3]))
print(nest([4]))
let s = 0
for i in [1, 2] { const w = [...[i], i]; s = s + w[0] + w[1] + w.length }
print(s - 1)
print(pair([1, 2], [3, 4]).length)
print(pair([1.0], [1.5])[1] + 1.0)
