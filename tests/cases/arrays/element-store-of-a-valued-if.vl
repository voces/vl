// @run
// @log 7
// @log 1
// @log 0
// @log 2.5
// @log 1
// @log 0
// @log b
// @log true
// @log false
// @log 9
// @log 1
// @log 0
// @log 200
// @log 1
// @log 0
// An element store whose value is a valued `if`, `&&` or `||`, for each element kind: the receiver
// and index are read before the value, which runs in place, and the store lands where it should.
type P = { a: i32 }
function yes() { return 1 == 1 }
function no() { return 1 == 2 }
const xs: i32[] = [0, 0]
const fs: f64[] = [0.0, 0.0]
const ss: string[] = ["", ""]
const bs: boolean[] = [false, false]
const ps: P[] = [{ a: 0 }, { a: 0 }]
const us: u8[] = [0, 0]
function store_xs(k: i32) {
  xs[k] = if yes() { 7 } else { 8 }
  print(xs[1])
  xs[0] = if yes() && no() { 5 } else { 1 }
  print(xs[0])
  xs[k] = if no() || no() { 3 } else { 0 }
  print(xs[1])
}
function store_fs(k: i32) {
  fs[k] = if yes() { 2.5 } else { 3.5 }
  print(fs[1])
  fs[0] = if yes() && yes() { 1.0 } else { 0.0 }
  print(fs[0])
  fs[k] = if no() || no() { 4.0 } else { 0.0 }
  print(fs[1])
}
function store_ss(k: i32) {
  ss[k] = if no() { "a" } else { "b" }
  print(ss[1])
}
function store_bs(k: i32) {
  bs[k] = yes() && yes()
  print(bs[1])
  bs[0] = no() || no()
  print(bs[0])
}
function store_ps(k: i32) {
  ps[k] = if yes() { { a: 9 } } else { { a: 1 } }
  print(ps[1].a)
  ps[0] = if yes() && yes() { { a: 1 } } else { { a: 2 } }
  print(ps[0].a)
  ps[k] = if no() || no() { { a: 5 } } else { { a: 0 } }
  print(ps[1].a)
}
function store_us(k: i32) {
  us[k] = if yes() { 200 } else { 100 }
  print(us[1])
  us[0] = if yes() && yes() { 1 } else { 2 }
  print(us[0])
  us[k] = if no() || no() { 3 } else { 0 }
  print(us[1])
}
store_xs(1)
store_fs(1)
store_ss(1)
store_bs(1)
store_ps(1)
store_us(1)
