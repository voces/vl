// @run
// @log 2
// @log N
// @log 2
// @log N
// @log 2
// @log N
// @log 2
// @log N
// @log 7
// @log N
// @log 2
// @log N
// @log K
// @log K
// @log 2
// @log N
// @log 2
// @log N
// @hint redundant type annotation: `xs` is inferred as `(string[] | null)[]` — remove it to lean on inference
// @hint redundant type annotation: `xs` is inferred as `(f64[] | null)[]` — remove it to lean on inference
// @hint redundant type annotation: `xs` is inferred as `(i64[] | null)[]` — remove it to lean on inference
// @hint redundant type annotation: `xs` is inferred as `(f32[] | null)[]` — remove it to lean on inference
// @hint redundant type annotation: `xs` is inferred as `(S[] | null)[]` — remove it to lean on inference
// @hint redundant type annotation: `xs` is inferred as `(i32[] | null)[]` — remove it to lean on inference
// @hint redundant type annotation: `xs` is inferred as `(f64[] | null)[]` — remove it to lean on inference
// @hint redundant type annotation: `xs` is inferred as `(f64[] | null)[]` — remove it to lean on inference
// @hint redundant type annotation: `c` is inferred as `f64[] | null` — remove it to lean on inference
// A `for w in xs` over a `(T[] | null)[]` — the LOOP VARIABLE of a nullable-list niche.
//
// TWO SITES, ONE DECISION, AND SHIPPING EITHER HALF ALONE IS WORSE THAN SHIPPING NEITHER.
// `forInElemKind` answers the loop var's rep and `emitForInStmt` decides whether the element
// read recovers it non-null; the niche kinds must appear in the first and stay ABSENT from
// the second. Adding only the kind arms makes every case here check-clean INVALID WASM
// ("expected (ref null $w), found (ref $w)" — the slot is nullable, the recovered value is
// not); leaving only the recover off would hand a non-null loop var a null. The `nullist`
// arm for the shared i32 backing (`(i32[] | null)[]`, the control below) was always paired
// this way, which is why that one rep escaped.
//
// The five reps that did not: the four DISTINCT-BACKING leaf lists (`string[]` element kind
// 6, `f64[]` 7, `i64[]` 8, `f32[]` 10) and the nested ref array (`S[]`, element kind 9).
//
// The last three blocks are the half a loud-reject count does not see. A loop body that
// never asks the null question — one that ignores the loop var, passes it to a `T | null`
// parameter, or copies it into an annotated `T | null` local — compiled CLEAN before and
// TRAPPED on a null element ("a null value was used where a non-null one was required"),
// because the element read recovered it. Those cells are silent, not loud, and they are
// here so that a future half-fix cannot pass by moving only the noisy ones.

type S = { v: i32 }

function mkStr(present: boolean): string[] | null {
  if present { return ["a", "b"] }
  null
}

function mkF64(present: boolean): f64[] | null {
  if present { return [1.5, 2.5] }
  null
}

function mkI64(present: boolean): i64[] | null {
  if present { return [10, 20] }
  null
}

function mkF32(present: boolean): f32[] | null {
  if present { return [1.25, 2.25] }
  null
}

function mkRef(present: boolean): S[] | null {
  if present { return [{ v: 7 }] }
  null
}

function mkI32(present: boolean): i32[] | null {
  if present { return [1, 2] }
  null
}

// `(string[] | null)[]` — element kind 6, the string-list wrapper.
function strElem() {
  const xs: (string[] | null)[] = [mkStr(true), mkStr(false)]
  for w in xs {
    if w != null { print(w.length) } else { print("N") }
  }
}

// `(f64[] | null)[]` — element kind 7. THE FILED D20 REPRO's shape.
function f64Elem() {
  const xs: (f64[] | null)[] = [mkF64(true), mkF64(false)]
  for w in xs {
    if w == null { print("N") } else { print(w.length) }
  }
}

// `(i64[] | null)[]` — element kind 8, narrowed by `is` rather than by a comparison. The
// two spellings reach the same ladder through different callers and report DIFFERENT
// messages when it has no arm (`` `is` test but no union type declared`` here, `bare null
// needs a struct-typed context` above), so one axis wearing two messages is one axis.
function i64Elem() {
  const xs: (i64[] | null)[] = [mkI64(true), mkI64(false)]
  for w in xs {
    if w is i64[] { print(w.length) } else { print("N") }
  }
}

// `(f32[] | null)[]` — element kind 10, narrowed inside a `while` guard.
function f32Elem() {
  const xs: (f32[] | null)[] = [mkF32(true), mkF32(false)]
  for w in xs {
    let seen = 0
    while w != null && seen < 1 {
      print(w.length)
      seen = seen + 1
    }
    if seen == 0 { print("N") }
  }
}

// `(S[] | null)[]` — element kind 9, the NESTED ref array. Its loop var is the kind-18
// `nulreflist`, and the inner ref-list slot comes from the outer slot's element
// (`rlElemInnerSlot`), the same resolution the non-null `reflist` loop var uses.
function refElem() {
  const xs: (S[] | null)[] = [mkRef(true), mkRef(false)]
  for w in xs {
    if w != null { print(w[0].v) } else { print("N") }
  }
}

// `(i32[] | null)[]` — the shared i32 backing (element kind 4, `nullist`). THE CONTROL:
// this one already ran, and it is what proved the leg was a per-element-kind arm rather
// than the whole loop-var path.
function i32Elem() {
  const xs: (i32[] | null)[] = [mkI32(true), mkI32(false)]
  for w in xs {
    if w != null { print(w.length) } else { print("N") }
  }
}

// A body that never reads the loop var at all. Before, this emitted CLEAN and trapped on
// the null element.
function neverRead() {
  const xs: (f64[] | null)[] = [mkF64(true), mkF64(false)]
  for w in xs { print("K") }
}

function sink(q: f64[] | null) {
  if q != null { print(q.length) } else { print("N") }
}

// The loop var flowing OUT of the loop — into a `T | null` parameter, and into an
// annotated `T | null` local. Both are silent-trap cells, not loud ones.
function flowsOut() {
  const xs: (f64[] | null)[] = [mkF64(true), mkF64(false)]
  for w in xs { sink(w) }
  for w in xs {
    const c: f64[] | null = w
    if c != null { print(c.length) } else { print("N") }
  }
}

strElem()
f64Elem()
i64Elem()
f32Elem()
refElem()
i32Elem()
neverRead()
flowsOut()
