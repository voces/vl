// @run
// @log 2
// @log 1
// @log 7
// @log 42
// @log 2
// @log 3
// THE BOX-TAG BAND, and why the packed byte list's arrival had to MOVE it.
//
// A union box tag is `uVariants.length + <offset>`. Struct variants take the dense ranks
// below; above them sit the value-atom codes (`valueAtomKind`: 0..12, and now the packed
// byte list's 13), and above THOSE three slot-keyed bands that interleave by residue mod 3
// — ref-element arrays, maps, and closure signatures past the first. The value-atom band
// was `0..12` and the slot bands started at `+13`, so a fourteenth value-atom code would
// have claimed `refArrSlotTag(0)`'s tag: `u8[] | S[]` would tag both arms alike and every
// `is` against one would answer for the other.
//
// `uAtomBandTop()` lifts the three bases by one — but ONLY in a module that interns the
// packed backing (`ba8Used`). The residues stay pairwise distinct for any base, so the
// lift is inert, and a program with no `u8[]` keeps the pre-#1806 numbering byte for byte
// (measured: 0 of 2,095 corpus files changed). A flat +3 was measured first and rejected:
// 77 corpus files changed bytes, none of them mentioning `u8[]`.
//
// This file is the witness that the four bands coexist: the four arms below tag 13
// (`u8[]`), 14 (`refArrSlotTag(0)`), 15 (`mapSlotTag(-1)`) and 0 (`i32`) — all distinct,
// and each `is` resolves its own arm.
type S = { v: i32 }

function pick(k: i32): u8[] | S[] | {[string]: i32} | i32 {
  if k == 0 {
    const bytes: u8[] = [7, 8]
    return bytes
  }
  if k == 1 {
    const structs = [{ v: 3 }]
    return structs
  }
  if k == 2 {
    const m: {[string]: i32} = Map()
    m["a"] = 7
    return m
  }
  42
}

const a0 = pick(0)
if a0 is u8[] { print(a0.length) } else { print(-1) }

const a1 = pick(1)
if a1 is S[] { print(a1.length) } else { print(-2) }

const a2 = pick(2)
if a2 is {[string]: i32} { print(a2["a"] ?? 0) } else { print(-3) }

const a3 = pick(3)
if a3 is i32 { print(a3) } else { print(-4) }

// ── `u8[]` and `i32[]` are DISTINCT atoms, not synonyms ──────────────────────
// Code 13 is not a rename of the i32 list's 7: the two backings differ (one byte per
// element vs four), so they tag and `ref.cast` separately and ONE union may carry both.
function widen(k: i32): u8[] | i32[] {
  const packed: u8[] = [3, 4]
  if k == 0 { return packed }
  const wide = [5, 6, 7]
  wide
}
const w0 = widen(0)
if w0 is u8[] { print(w0.length) } else { print(-5) }
const w1 = widen(1)
if w1 is i32[] { print(w1.length) } else { print(-6) }
