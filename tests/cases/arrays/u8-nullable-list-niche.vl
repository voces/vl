// @run
// @log 2
// @log -1
// @log 1
// D979 — `u8[] | null` IS A NICHE, AND IT NOW HAS ONE. This file was a must-error pin
// (`emitProgram: bare null needs a struct-typed context`) and its own text named the fix:
// "the `nulf32list` slice again — a VKind member, a nullable wrapper valtype, the build/read/
// push arms and the `nulScalarListKind` rung". That is what landed.
//
// A two-member `T[] | null` does not lower to the `{tag, payload}` box at all: it is a NICHE —
// the wrapper ref itself, made nullable, with `ref.null` standing for the null member and no
// tag anywhere. `u8[]` was the one scalar list absent from that family, so the packed list had
// no niche and the union had no rep.
//
// THE MULTI-MEMBER SHAPES WERE NEVER AFFECTED and still work: `u8[] | i32 | null` and
// `u8[] | IoError | null` are ordinary boxes whose `null` rides a tag.
function readFile(ok: boolean): u8[] | null {
  if ok {
    const b: u8[] = [1, 2]
    return b
  }
  null
}

const r = readFile(true)
if r != null { print(r.length) } else { print(-1) }

const e = readFile(false)
if e != null { print(e.length) } else { print(-1) }

// The bare-null spelling, which is what the old refusal actually fired on.
const n: u8[] | null = null
if n == null { print(1) }

// NOT HERE, AND THE ROW SAYS WHY: a TAIL-return `u8[] | null` function BESIDE the bare-null
// global above is the one combination still broken — V8 rejects the module
// (`local.set[0] expected (ref null 5), found (ref 9)`) while the native host accepts it.
// Each half runs alone. Filed as D979's residue.
