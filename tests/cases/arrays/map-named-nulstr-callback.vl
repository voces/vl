// @run
// @log 2
// @log yes
// @log null
// A `.map` whose callback is a NAMED function with an UN-ANNOTATED `string | null` return.
// The result is a `(string | null)[]` — the SAME string list every `string[]` uses
// (`$mkListIdx` / `$mkArrIdx`, whose element type is already `(ref null $aTypeIdx)`), with
// the nullable element DISCIPLINE on reads: an element read stays `(ref null)` instead of
// recovering non-null, so a `null` element prints `null` rather than trapping.
//
// THREE ladders have to agree for this one line, and each answers from `cloRetValKind` —
// the classifier the callback's own functype BYTES are streamed from — rather than from
// `cloRetKindOf`, whose un-annotated ladder folds the niche into the i32 result token:
//
//   * `mfResultKindOf` picks the string wrapper (`"str"`) for the result element;
//   * `collectMapFilterUse` forces `slUsed` (`mfCbResultIsStrList`) — this program's ONLY
//     string list is that result, so an unforced flag is
//     `emitProgram: .map/.filter result is string[] but string list type not collected`;
//   * `exprStringArray`'s `.map`/`.filter` arm classifies the RESULT BINDING, so `ys.length`
//     and `for y in ys` resolve the string-list wrapper instead of the i32 default.
//
// The three-way agreement is what the `@log` lines pin: the count comes from the wrapper,
// the values from the element read. With `cloRetKindOf`'s coarse answer this claimed an
// i32-LIST result and `array.set` on the i32 backing took the `(ref null $type)` the
// `$fnsig` the loop `call_indirect`s actually returns — `vl check` rc=0, invalid wasm at
// `offset 368: type mismatch: expected i32, found (ref null $type)`.
//
// The ANNOTATED spelling of the same callback (`function maybe(n: i32): string | null`)
// takes the identical path: `vtKindOfType` answers `"nulstr"` where the inference does, so
// the two spellings agree by construction rather than by luck.
function maybe(n: i32) {
  if n > 0 { return "yes" }
  return null
}
const xs = [1, 0]
const ys = xs.map(maybe)
print(ys.length) // 2
for y in ys { print(y) } // yes / null
