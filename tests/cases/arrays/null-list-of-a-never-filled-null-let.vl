// @run
// @info `m` is never reassigned; use `const` instead of `let`
// @log null
// @log 1
// @log null
// @log 2
// @log null
// @log 1
// @log 2
// @log null
// @log null
// @log null
// @log null
// @log 4
// A list of a never-filled `let x = null` that a `null[]` destination receives is a `null[]`: a
// typed binding, a `null[]` parameter and an index store take its values and assignments as the
// sentinel. A hole a write fills is that write's `T | null`, so its list is not refused (D17304).
function count(a: null[]) { return a.length }
function typed() {
  let x = null
  const a: null[] = [x]
  print(a.length)
  print(a[0])
  const b: null[] = [x, x = null]
  print(b.length)
  print(b[1])
}
function parameter() {
  let x = null
  print(count([x]))
  print(count([x = null, x]))
}
function indexStore() {
  let x = null
  const a: null[] = [null, null]
  a[0] = x
  a[1] = (x = null)
  print(a[0])
  print(a[1])
}
function afterWriter() {
  let x = null
  const w = () => {
    x = null
  }
  w()
  const a: null[] = [x]
  print(a[0])
}
function filled() {
  let x = null
  const a = [x]
  x = 3
  print(a[0])
  let y = null
  y = 4
  print([y][0])
}
let m = null
const mods: null[] = [m]
print(mods[0])
typed()
parameter()
indexStore()
afterWriter()
filled()
