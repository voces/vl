// @run
// @log 1
// @log 5
// @log ab
// @log 2
// An un-annotated list literal whose element union has a union-alias arm reps its element as
// the box: the registrar binds the alias spelling to the row its key finds (D1790).
type U = i32 | string
function mkU(): U | boolean { return "ab" }
const xs = [mkU()]
print(xs.length)
type M = { [string]: i32 } | i32
function mkM(): M | boolean { return 5 }
const ms = [mkM()]
const y = ms[0]
if y is i32 { print(y) } else { print(0) }
const ys = [mkU(), true]
const z = ys[0]
if z is string { print(z) } else { print("no") }
print(ys.length)
