// @run
// @log witness true
// @log inline true
// @log length 0
// @log reversed false
// @log string hi
// @log string none
// @log f64 2.5
// @log f64 none
// An un-annotated `[] | null` join handed to a hole keeps its `null`, and the body's write
// decides the join's empty list as it decides a bare `[]` (D6120).
import { toString } from "std:fmt"

function t() { 1 == 1 }

function isNull(a) { print("witness " + toString(a == null)) }
const x = if !t() { [] } else { null }
isNull(x)

function inl(a) { print("inline " + toString(a == null)) }
inl(if !t() { [] } else { null })

function len(a) {
  if a != null { print("length " + toString(a.length)) }
}
len(if t() { [] } else { null })

function rev(a) { print("reversed " + toString(a == null)) }
rev(if !t() { null } else { [] })

function str(a) {
  if a != null {
    a.push("hi")
    print("string " + a[0])
  } else {
    print("string none")
  }
}
str(if t() { [] } else { null })
str(if !t() { [] } else { null })

function num(a) {
  if a != null {
    a.push(2.5)
    print("f64 " + toString(a[0]))
  } else {
    print("f64 none")
  }
}
num(if t() { [] } else { null })
num(if t() { null } else { [] })
