// @run
// @log 7
// @log 7
// @log 7
// @log 7
// AN INFERRED CONTAINER WHOSE RECORDED ELEMENT SHAPE DENOTES A DECLARED ROW ONLY UNDER THE
// WIDENING THE OBJECT-LITERAL MATCHER ALREADY ACCEPTS — D733, and the single mechanism behind
// FIVE emitter sentences.
//
// THE TWO SIDES OF ONE QUESTION HAD DIFFERENT ANSWERS. `structIndexOfObjCtx` decides which row
// an object literal BUILDS and accepts a widening: `{ r: 7 }` beside `type Circle = { r: i64 }`
// builds `Circle` with an `i64.const 7`, because a bare integer literal reaches the wider slot
// (`anonValueFitsField`'s `sc == 23` leg). The FIELD-SET resolvers decide which row a recorded
// SHAPE denotes, and their per-field CODE tightening refused the same pair — the checker
// recorded `{r: i32}`, `i32` is not `i64`, no row matched, `shapeNominalOfTy` answered "". So
// the value was a `(ref $Circle)` that nothing would call `Circle`.
//
// WHAT THAT COST IS THE WHOLE REF-LIST LAYER. `arrLitNominalElemName` is the one rung
// `arrLitIsRef`, `arrLitElemName` and `arrLitElemKind` all route through; with no name the
// literal falls to the i32 backing, whose floor prints whichever sentence fits the layer:
//
//   leg 1  `[c]`                     -> struct array elements are not supported
//   leg 2  `[[c]]`                   -> nested arrays are not supported
//   leg 3  `for z in [c][0]`         -> unsupported for-in iterable
//   leg 4  a `{[string]: Circle[]}`  -> map value type has no interned slot
//
// (The fifth, `union-arm array elements are not supported in this position`, needs a declared
// ARM and lives in `unions/inferred-arm-element-widened-row.vl`.)
//
// Both field-set resolvers, and `structIndexOfTypeName`'s render twin, now run a WIDENED
// SECOND PASS behind the strict one — D461's own discipline at this seam, whose note records
// why one lenient pass is a regression. `shapeNominalOfTy` orders the four rungs
// strict-struct -> strict-variant -> widened-struct -> widened-variant, so a widening can
// never outrank an identity, and the struct pass requires a UNIQUE claimant: two widened
// matches are two LAYOUTS and no evidence which one the literal was built at.
//
// EVERY `i64` BELOW IS LOAD-BEARING. With `r: i32` the codes match and every leg runs on
// master; deleting the declaration runs too (the literal mints its own `#anon` row and both
// sides agree on it). The defect lives exactly where a declared row is a WIDENING of the
// literal's own recorded shape — so this file must declare NO second single-`r` row, or the
// scan has two claimants and correctly declines.
type Circle = { r: i64 }

// 1. the flat ref list.
function leg1() {
  const c = { r: 7 }
  const xs = [c]
  print(xs[0].r)
}
leg1()

// 2. the nested list, whose element is named through the render `{r:i32}[]`.
function leg2() {
  const c = [{ r: 7 }]
  const xs = [c]
  print(xs[0][0].r)
}
leg2()

// 3. for-in over the inferred list.
function leg3() {
  const c = [{ r: 7 }]
  const dd = [c][0]
  let hit = 0
  for z in dd {
    if z.r == 7 { hit = 7 }
  }
  print(hit)
}
leg3()

// 4. a MAP whose value is the same inferred list, read back through `??`.
type GW = { g: {[string]: Circle[]} }
function mkcall() {
  const lv1 = [{ r: 7 }]
  const cc = Map()
  cc["k0"] = lv1
  return cc
}
function leg4() {
  const wv: GW = { g: mkcall() }
  const g0 = (wv.g)["k0"] ?? []
  if g0.length > 0 { print(g0[0].r) } else { print(0) }
}
leg4()
