// @run
// @log 0
// @log 3
// @log 0
// @log EMPTY
// @log 2
// @log 0
// @log 0
// @log 0
// @hint redundant type annotation: `fc` is inferred as `() -> i32[]` — remove it to lean on inference
// @hint redundant type annotation: `fs` is inferred as `() -> S[]` — remove it to lean on inference
// @hint redundant type annotation: `fd` is inferred as `() -> f64[]` — remove it to lean on inference
// @hint redundant type annotation: `fq` is inferred as `() -> i64[]` — remove it to lean on inference
// THOSE FOUR HINTS ARE THE PLAYBOOK'S "a redundant-annotation HINT can be wrong about a
// LOAD-BEARING annotation" landmine, pinned rather than acted on. `fc`'s annotation really is
// redundant (its literal is non-empty, so inference reaches the same type). `fs` / `fd` / `fq`
// return an EMPTY `[]`, and removing their annotations turns each into the un-annotated lambda
// form, which is a different program with a different (and for the argument/return positions,
// still defective) lowering. `fi` gets no hint at all, which is the tell that inference does not
// in fact reproduce the annotation for the empty case.
//
// MASTER'S FAILURE MODE FOR THIS FILE IS "THE COMPILER DIED" — worth stating, because it is
// not the usual shape of a red fixture. On master `vl check` on this file exits 1 having
// printed a wasm backtrace through `vl-compiler.wasm` and `wasm trap: out of bounds array
// access`: no diagnostic, no source location, no module written, and no output at all for a
// `@log` to disagree with. So this file does not pin a WRONG value against master — it pins
// that a value exists to read.
//
// An EMPTY `[]` returned from a LAMBDA. `TyArray.aElem` is `-1` for an empty `[]` whose
// element type is not yet known (the declared hole, not a corruption), and the lambda
// contextual-return ladder in `checkFuncDeclNode` dereferenced it: `T.tys[-1]` is an
// out-of-bounds `array.get` inside the checker. `tyArrayElemIx` is the one home for that
// question now, and `nulElemListRetName` asks it.
//
// The legs, each independently load-bearing:
//   L1 an ANNOTATED lambda binding (`const f: () => i32[] = () => …`) — reaches the ladder
//      through the EXPECTED-return call site.
//   L2 an UN-ANNOTATED lambda binding — reaches the SAME function through the INFERRED-return
//      recording ladder, a different call site with the same hole.
//   L3 a NON-EMPTY literal control (`[1, 2, 3]`), which never carries the hole and must keep
//      working byte-for-byte.
//   L4 the element reps that each need their own list backing (`f64`, `i64`, a struct) — the
//      per-rep adopt arms, which the trap sat in front of.
//   L5 the empty list flowing on as an ARGUMENT, so the hole is read at a second boundary.

type S = { f: i32 }

function sinkI(xs: i32[]) { print(xs.length) }

function main() {
  // L1
  const fi: () => i32[] = () => {
    return []
  }
  print(fi().length)
  // L3 — the non-empty control
  const fc: () => i32[] = () => {
    return [1, 2, 3]
  }
  print(fc().length)
  // L2 — no annotation anywhere
  const fu = () => {
    return []
  }
  print(fu().length)
  // L4 — a struct element, read through an index guard
  const fs: () => S[] = () => {
    return []
  }
  const xs = fs()
  if xs.length > 0 { print(xs[0].f) } else { print("EMPTY") }
  // L5 — passed on as an argument (2 is the control's own length, printed by the sink)
  sinkI([7, 8])
  sinkI(fi())
  // L4 — the distinct scalar backings
  const fd: () => f64[] = () => {
    return []
  }
  print(fd().length)
  const fq: () => i64[] = () => {
    return []
  }
  print(fq().length)
}
main()
