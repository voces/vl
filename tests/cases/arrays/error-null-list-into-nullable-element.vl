// @check
// @error-at 17:38 null[] is not readonly (string | null)[]: a container never widens implicitly
// @error-at 21:6 null[] is not readonly (string | null)[]
// @error-at 25:27 null[] is not (Item | null)[]: a container never widens implicitly
// @error-at 29:9 null[] is not (Item | null)[] (reached through null[] | {n: i32}[] into (Item | null)[])
// VERDICT PIN (must-error), no `@log` form: the diagnostic IS the observable.
//
// A list of only `null` stores a placeholder id per slot, which no nullable element shares,
// so a `null[]` into a `(T | null)[]` is a storage-class change and refuses as `i32[]` into
// `(i32 | null)[]` does (D5520). Annotated and inferred sources, at a binding, an argument,
// an inferred return and a value `match` tail (D4190).
type Item = { n: i32 }

function mk<T>(x: T) { [x] }

// An annotated `null[]` source bound into a read-only nullable-string list.
const a: null[] = [null]
const b: readonly (string | null)[] = a

// The same list as an argument.
function count(ys: readonly (string | null)[]) { print(ys.length) }
count(a)

// An inferred source: a generic's `[x]` at `null`, returned through an inferred return.
function fresh() { mk(null) }
const c: (Item | null)[] = fresh()

// A value `match` tail: its arms are typed values, as a `[1]` arm into `(i32 | null)[]` is.
function tail(n: i32): (Item | null)[] {
  return match n {
    0 => [null]
    _ => [{ n: 1 }]
  }
}

print(b.length)
print(c.length)
print(tail(0).length)
