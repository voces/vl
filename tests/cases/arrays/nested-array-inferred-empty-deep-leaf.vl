// @emit-error index receiver is not an array or string
// The 3-D twin of `nested-array-inferred-empty-unsupported-leaf.vl`: the leaf is itself an
// ARRAY, so the arena says kind 4 (the i32-list wrapper) while the name says kind 9 (the inner
// row's own wrapper). Same divergence, same decline, and it is pinned separately because the two
// reach it through different arms — a `TyPrim` the supported set excludes, versus a `TyArray`
// leaf that is not a leaf at all.
//
// Supporting this one is not a wider guard but a real design step: kind 9 reads
// `rlWrapIdx[rlElemInnerSlot(rs)]` during the same forward pass, so the inner row has to be
// interned at a strictly lower slot index than the outer.
function deepLeaf() {
  const outer = []
  const mid = [[1, 2, 3]]
  outer.push(mid)
  print(outer[0][0][2])
}
deepLeaf()
