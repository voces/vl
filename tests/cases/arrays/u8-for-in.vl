// @run
// @log 1
// @log 2
// @log 3
// @log 6
// @log 3
// `for v in b` OVER A PACKED `u8[]` — was check-clean INVALID WASM.
//
// The loop-variable slot took its kind from the 4-byte scalar-list vocabulary, so the
// body read an `i32[]` backing over a one-byte one. `vl check` reported nothing; the
// module did not load. It is visible at all only because `vl check --codegen` validates
// its own output — plain `check` calls this program clean to this day.
//
// This ALSO corrects a claim in `u8[]`'s own landing commit, which said `for v in b` and
// `b.map(f)` both "reject at check". The `.map` half does (see below); the `for-in` half
// emitted invalid wasm, so that entry was stale in the direction that matters and the
// hole was unguarded.
const q: u8[] = [1, 2, 3]
for v in q {
  print(v)
}

// The element reads as an `i32` in 0..255, the same widening `array.get_u` performs and
// the same shape `string`/code-point already has — so ordinary arithmetic composes.
let sum = 0
for v in q {
  sum = sum + v
}
print(sum)

// A `u8[]` reaches a function boundary and back with the loop intact.
function count(b: u8[]) {
  let n = 0
  for _v in b {
    n = n + 1
  }
  n
}
print(count(q))
