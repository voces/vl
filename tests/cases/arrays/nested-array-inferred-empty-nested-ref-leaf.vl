// @run
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// D625: an un-annotated empty `[]` at a NESTED array of a REF leaf took the i32-list default.
// `function mkc(): {r: i32 | null}[][] { const cc = []  return cc }` was `vl check` rc 0 and a
// module the engine refused (`type mismatch: expected (ref $type), found (ref $type)`), while
// the ANNOTATED spelling of the very same function ran.
//
// THE DISASSEMBLY IS THREE LINES AND THEY ARE ALL IN THE BODY. The signature was already right
// — `(func (result (ref $10)))`, the `{r: i32|null}[][]` wrapper, read off the declared return —
// and the body built `array.new_fixed $3` / `struct.new $6`, the i32-list wrapper, into it. That
// is the mirror of D613, where the signature was wrong and the body right.
//
// THE CAUSE WAS AN ALLOW-LIST. `tyNestedArrLeafSupported` enumerated six leaves the
// inferred-empty synthesis may type — litunion / i32 / boolean / string / f64 / i64 — because
// the ROW's kind came from `arrLitNestedElemKind`, a hand-map that agrees with the naming
// authority `refArrElemKind` on exactly that set. That gate was asked by BOTH the intern half
// AND `nodeArrayElemName`, which decides whether an ANNOTATION is synthesized at all — so a
// declined leaf got no annotation, and the binding fell to the default.
//
// THE OLD HEADER'S SAFETY CLAIM WAS FALSE WHERE IT MATTERED: "declining keeps the LOUD reject
// master gives". Over a sixteen-leaf grid of this shape, NINE declined leaves were `check-clean
// invalid wasm` and every one of their annotated controls RAN. Declining was not avoiding a
// silent miscompile; it WAS one.
//
// THE FIX SPLITS THE TWO HALVES, WHICH THE OLD HEADER SAID MUST MOVE TOGETHER — and the split
// is measured, not argued. Only the ANNOTATION half widened (`tyNestedArrLeafRenders`: the
// element has a render). The INTERN half keeps the narrow gate, so nothing new is minted and no
// slot order moves. It is enough because the row these annotations resolve was already interned
// by the DECLARED DESTINATION's own walk — probed: `rlSlotByName` answers ≥ 0 at every leaf here
// before the change. `tests/cases/arrays/nested-array-inferred-empty-unsupported-leaf.vl` is the
// control for the split: its `f32` leaf has NO declared destination, so the intern half still
// declines and its loud reject is byte-for-byte unchanged.
//
// L1–L9 are the nine leaves that were silent. L10–L12 are three that already ran (the allow-list
// members) and must keep running. L13–L17 are the OTHER STORAGE CLASSES at the same leaf — a
// module global, a closure capture, a struct field, a call argument and a list-of-lists element
// — each of which was silent for the same reason.

type K = 1 | 2
type P = { r: i32 }
type A = { a: i32 }
type B = { b: i32 }
type U = A | B
type W = { xs: P[][] }

function sinkPP(_x: P[][]) {}

// L1 — the filed repro: an inline shape with a NULLABLE field.
function mk1(): {r: i32 | null}[][] {
  const cc = []
  return cc
}
print(mk1().length)

// L2 — the same inline shape, non-nullable. The nullable field was scenery.
function mk2(): {r: i32}[][] {
  const cc = []
  return cc
}
print(mk2().length)

// L3 — a DECLARED struct leaf. Its row is keyed nominally (`P[]`), the render is structural.
function mk3(): P[][] {
  const cc = []
  return cc
}
print(mk3().length)

// L4 — a union leaf: the element list is the kind-2 box.
function mk4(): U[][] {
  const cc = []
  return cc
}
print(mk4().length)

// L5 — a MAP leaf.
function mk5(): {[string]: i32}[][] {
  const cc = []
  return cc
}
print(mk5().length)

// L6 — a CLOSURE leaf: the kind-5 fat-pointer element.
function mk6(): ((i32) => i32)[][] {
  const cc = []
  return cc
}
print(mk6().length)

// L7 — a THIRD dimension. The leaf is itself an array, so the recursion has to descend.
function mk7(): i32[][][] {
  const cc = []
  return cc
}
print(mk7().length)

// L8 — an `f32` leaf: kind 10, the one the old header named as diverging 4-vs-10.
function mk8(): f32[][] {
  const cc = []
  return cc
}
print(mk8().length)

// L9 — a LITERAL-UNION leaf. The allow-list explicitly ADMITTED this one and it was silent
// anyway, because the element the array carries does not answer `tyIsLitUnion`.
function mk9(): K[][] {
  const cc = []
  return cc
}
print(mk9().length)

// L10–L12 — allow-list members that ran before this change and must keep running.
function mk10(): i32[][] {
  const cc = []
  return cc
}
print(mk10().length)

function mk11(): string[][] {
  const cc = []
  return cc
}
print(mk11().length)

function mk12(): f64[][] {
  const cc = []
  return cc
}
print(mk12().length)

// L13 — a module GLOBAL pinned by a call argument.
const g13 = []
sinkPP(g13)
g13.push([])
print(g13.length)

// L14 — a closure CAPTURE.
function outer14() {
  const c14 = []
  function inner14() { sinkPP(c14) }
  inner14()
  c14.push([])
  print(c14.length)
}
outer14()

// L15 — a struct FIELD destination.
function mk15(): W {
  const cc = []
  cc.push([])
  const w: W = { xs: cc }
  return w
}
print(mk15().xs.length)

// L16 — a plain call ARGUMENT at function scope.
function f16() {
  const cc = []
  cc.push([])
  sinkPP(cc)
  print(cc.length)
}
f16()

// L17 — an element of a list-of-lists literal, one dimension deeper again.
function f17() {
  const cc = []
  cc.push([])
  const outer: P[][][] = [cc]
  print(outer.length)
}
f17()
