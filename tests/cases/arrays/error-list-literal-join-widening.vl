// @check
// @error-at 13:22 i32[] is not f64[]: this join would hold both, and a container never widens implicitly. Its elements would be stored differently, so it would be a copy, and a write through either list would not reach the other. Build it as `f64[][]`
// @error-at 14:23 i32[] is not f64[]: this join would hold both, and a container never widens implicitly
// @error-at 15:16 i32[] is not f64[]: this join would hold both, and a container never widens implicitly. Its elements would be stored differently, so it would be a copy, and a write through either list would not reach the other. Build it as `f64[][]`
// A spread or a list `+` copies its own level, which converts scalars, but never the lists
// one level down (D4861): an existing inner list into a wider element would be copied, and a
// container never widens implicitly. `list-literal-join-widening-runs.vl` is the twin that
// runs, and `list-literal-keeps-existing-element-apart.vl` the literal elements.
function mk() { return [1, 2] }

const nf = [[1.5]]
const ni = [[1, 2]]

const s1 = [...nf, ...ni]
const s2 = [...nf, ...[mk()]]
const p1 = nf + ni

print(s1.length + s2.length + p1.length)
