// @check
// @error-at 18:18 i32[] is not f64[]: this join would hold both, and a container never widens implicitly. Its elements would be stored differently, so it would be a copy, and a write through either list would not reach the other. Build it as `f64[]`, or copy it with `.map((x) => x as f64)`
// @error-at 19:27 i32[] is not f64[]: this join would hold both, and a container never widens implicitly
// @error-at 20:22 i32[] is not f64[]: this join would hold both, and a container never widens implicitly. Its elements would be stored differently, so it would be a copy, and a write through either list would not reach the other. Build it as `f64[][]`
// @error-at 21:23 i32[] is not f64[]: this join would hold both, and a container never widens implicitly
// @error-at 22:16 i32[] is not f64[]: this join would hold both, and a container never widens implicitly. Its elements would be stored differently, so it would be a copy, and a write through either list would not reach the other. Build it as `f64[][]`
// A list literal joins its elements the way an `if` joins its arms (D4861): a list that
// already exists, placed beside one whose elements are stored differently, would be copied
// into the joined element type, and a container never widens implicitly. A spread or a list
// `+` copies its own level, which converts scalars, but never the lists one level down.
// `list-literal-join-widening-runs.vl` is the twin that runs.
function mk() { return [1, 2] }
function mf() { return [1.5] }
function t() { 1 == 1 }

const nf = [[1.5]]
const ni = [[1, 2]]

const d1 = [mf(), mk()]
const d2 = [mf(), if t() { mk() } else { [2.5] }]
const s1 = [...nf, ...ni]
const s2 = [...nf, ...[mk()]]
const p1 = nf + ni

print(d1.length + d2.length + s1.length + s2.length + p1.length)
