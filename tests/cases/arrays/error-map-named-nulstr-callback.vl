// @emit-error emitProgram: unsupported .map/.filter element type
// A `.map` whose callback is a NAMED function with an UN-ANNOTATED `string | null`
// return emitted INVALID WASM (`vl check` rc=0, clean):
//
//     Invalid input WebAssembly code at offset 368:
//     type mismatch: expected i32, found (ref null $type)
//
// `mfResultKindOf`'s final fallthrough asked `cloRetKindOf` — the coarse VALUE-CALL
// ABI answer, whose un-annotated ladder folds the `"nulstr"` niche into `"i32"` (it
// never consulted `fRetNulStr`; #1195 gave `fnSigKeyOf` an interlock for exactly this
// and deliberately left `cloRetKindOf` and the `.map` seam untouched). So the call
// claimed an i32-LIST result and `array.set` on the i32 backing took the `(ref null
// $string)` the `$fnsig` the loop `call_ref`s actually returns.
//
// The ANNOTATED spelling of the SAME callback (`function maybe(n: i32): string | null`)
// already rejected loudly here — `vtKindOfType` answers `"nulstr"`, `cloRetKindOf`
// returns `null`, and `emitMapFilter` fails. Only the inferred spelling miscompiled.
// `mfResultKindOf` now claims the i32/f64 element only when `cloRetKindOf` and
// `cloRetValKind` AGREE, so the two spellings give the same loud answer. A
// `(string | null)[]` map RESULT is not in `MfKind`'s vocabulary; when it is added this
// fixture graduates to `@run`.
//
// Census: the only INVALID-WASM cell in 188 `.map`/`.filter` x callback-form x
// return-kind x receiver-kind programs — the named-callback form is the only one that
// reaches the fallthrough (an inline / let-bound lambda already answered `null`).
function maybe(n: i32) {
  if n > 0 { return "yes" }
  return null
}
const xs: i32[] = [1, 2]
const ys = xs.map(maybe)
print(ys.length)
