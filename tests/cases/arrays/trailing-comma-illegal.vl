// @check
// @error expected an expression but found COMMA
// @error expected `,` but found `2`
// A doubled comma in an array literal (`[1,,2]`) is still a syntax error: only a
// single trailing comma before `]` is allowed, never an empty slot. The doubled
// comma derails the literal — the second `,` is consumed as a failed expression,
// leaving `2` where a separator belongs, which the list's own separator recovery
// then reports and inserts. Two diagnostics, no cascade past the `]`. (The first
// is a LOSSY recovery — the comma is dropped — so this file is not typechecked.)
let a = [1,, 2]
