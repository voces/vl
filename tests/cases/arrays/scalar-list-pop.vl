// @run
// @log 2
// @log 2
// @log 2
// @log 2
// @hint redundant type annotation: `b` is inferred as `f64[]`
// @hint redundant type annotation: `d` is inferred as `i32[]`
// D977 — `.pop()` ON THE SCALAR-LIST FAMILY (`i64[]`, `f64[]`, `f32[]`, `u8[]`).
//
// `emitPop` handled ref lists, string lists and the i32 default; `exprArray` claims only an
// i32-element list, so every wide scalar list fell to "receiver is not a list". And because
// `emitFail` does not halt, a DISCARDED `a.pop()` then landed as check-clean INVALID WASM
// rather than a refusal — three lines, no other list in the program.
//
// Everything the arm needs already existed: `scalarListWrap` / `scalarListBack` for the
// wrapper and backing, and a per-kind push scratch base.
//
// FOUND BY std:fmt's exact big-integer arithmetic (serde stage 0), which holds its limbs in
// an `i64[]` and carried a `bnLen` scan because it could not trim high zero limbs.
const a: i64[] = [1, 2, 3]
a.pop()
print(a.length)

const b: f64[] = [1.5, 2.5, 3.5]
b.pop()
print(b.length)

const c: f32[] = [1.0, 2.0, 3.0]
c.pop()
print(c.length)

// The i32 default must be unchanged — it is the arm the others are modelled on.
const d: i32[] = [1, 2, 3]
d.pop()
print(d.length)
