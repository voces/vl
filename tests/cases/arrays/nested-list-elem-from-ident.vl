// @run
// @log 7
// @log 7
// @log 7
// @log 7
// @log 2.5
// @log 7
// The two annotations below are the row's own CONTROLS — the spellings that already ran —
// so they are declared rather than deleted.
// @hint redundant type annotation: `c` is inferred as `string[][][]`
// @hint redundant type annotation: `ann` is inferred as `string[][]`
// A NON-EMPTY LIST LITERAL WHOSE ELEMENT IS A LIST *DELIVERED BY IDENT* — the half of
// `nested-array-inferred-empty-push.vl`'s hole that the empty-literal fix could not reach
// (silent-class-inventory D180 and D183, one root).
//
// `arrLitIsRef` classifies a literal from its FIRST ELEMENT'S NODE, and the nested arm it
// carries is gated on `e0 is ArrayLit`. `const c = [lv1]` where `lv1` is a `string[]` LOCAL
// has an IDENT there — no object literal, no nested literal, no lambda, no map, no declared
// shape — so every rung declined, the literal built on the i32 backing, and a
// `(ref $strlist)` element went into an `(array (mut i32))`: `vl check` rc 0 and
// `type mismatch: expected i32, found (ref $type)` at instantiation. The i32 arm's own floor
// ladder (`nested arrays are not supported` / `struct array elements` / `union-arm array
// elements` / `map array elements`) has no rung for a string- or f64-list element either, so
// the shape had no LOUD outcome to fall back on. It is the identical hole the union, map and
// nominal rungs each closed for their element kind, at the last one that still had it — and
// the predicate is `arrLitNestedElemName`, which already existed for the empty-literal half.
//
// THE TWO FILED ROWS ARE ONE ROOT AND THE ABLATION IS WHAT SAYS SO. D180 is the plain
// binding chain; D183 routes the same list through `std:array`'s `reverse` and fails inside
// the monomorphized `rd$m0` with a different engine message. One rung moves both, and
// neither of the other two rows closed beside it.
//
// The controls that ALREADY ran are kept here as the boundary: the annotated spelling, the
// nested LITERAL, and the flat one-level list. The `i32` leaf was the one element type the
// i32 arm's `exprArray` floor caught loudly, which is why this family stayed invisible.
import { reverse } from "std:array"

// D180's own shape: nothing declared, nothing annotated, inside a function.
function d180() {
  const lv1 = ["seven"]
  const c = [lv1]
  const g0 = c
  if g0.length > 0 {
    const g1 = g0[0]
    if g1.length > 0 {
      if (g1[0]) == "seven" { print(7) } else { print(0) }
    } else { print(0) }
  } else { print(0) }
}

// D183: the same list handed to a std generic and indexed back out. The failing function was
// the monomorphized instance, which is why this cell needs the pass to run before
// `monomorphize` rather than at `collectLocals`.
function d183() {
  const c = ["seven"]
  const dd = reverse([c])[0]
  let hit = 0
  for zz in dd {
    if zz == "seven" { hit = 7 }
  }
  print(hit)
}

// The HAND-WRITTEN generic, which monomorphizes differently from the std instance and was
// silent too.
function idg<T>(x: T): T { x }
function d183Gen() {
  const c = ["seven"]
  const dd = idg([c])[0]
  let hit = 0
  for zz in dd {
    if zz == "seven" { hit = 7 }
  }
  print(hit)
}

// DEPTH THREE with NO intermediate annotation — D180's own `annpat` table, whose middle row
// was the only one that used to rescue.
function d180Deep() {
  const lv2 = ["seven"]
  const lv1 = [lv2]
  const c: string[][][] = [lv1]
  if ((c[0])[0])[0] == "seven" { print(7) } else { print(0) }
}

// The f64 leaf — the second supported non-i32 backing, silent on master for the same reason.
function f64Leaf() {
  const c = [1.5, 2.5]
  const dd = [c]
  print(dd[0][1])
}

// THE BOUNDARY, both halves already running before this change: the annotated outer binding
// and the nested LITERAL. They must keep running, and they are what says the machinery was
// present and only the classification was missing.
function controls() {
  const lv1 = ["seven"]
  const ann: string[][] = [lv1]
  const lit = [["seven"]]
  if ann[0][0] == "seven" && lit[0][0] == "seven" { print(7) } else { print(0) }
}

d180()
d183()
d183Gen()
d180Deep()
f64Leaf()
controls()
