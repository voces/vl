// @run
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// @hint redundant type annotation: `c` is inferred as `{n: i32}`
// @hint redundant type annotation: `cs` is inferred as `C[]`
// @hint redundant type annotation: `ss` is inferred as `string[]`
// @hint redundant type annotation: `ls` is inferred as `i32[][]`
// @hint redundant type annotation: `bs` is inferred as `boolean[]`
// @hint redundant type annotation: `xs` is inferred as `i32[]`
// @hint redundant type annotation: `i32s` is inferred as `i32[]`
// @hint redundant type annotation: `i32s2` is inferred as `i32[]`
// The annotations the hints name are LOAD-BEARING here and are kept deliberately: the
// rule's hard case is a PINNED source (#1456's provenance axis), so every source below is
// spelled at its own type rather than left to inference. `ks` is the one that is not
// redundant — an un-annotated `["a"]` infers `string[]`, not `K[]`.
// THE READ-ONLY SIDE OF THE CONTAINER RULE: only a `readonly` list is covariant
// (DECISIONS.md "No implicit container widening"). Every destination below is `readonly`,
// so each widening runs. The class-keeping pairs SHARE the list (a nullable ref is the same
// wasm reftype, a niche-nullable scalar the same element with a sentinel); the three numeric
// pairs (`i32`->`i64`, `i32`->`f64`, `f32`->`f64`) are a converting copy, a snapshot licensed
// only where nothing writes the source. The mutable spellings of every pair are refused in
// `error-list-widening-mutable-destination.vl` (D2161).
type C = { n: i32 }
type K = "a" | "b"

function refElem(ys: readonly (C | null)[]) { print(ys.length) }
const c: C = { n: 1 }
const cs: C[] = [c]
refElem(cs)

function strElem(ys: readonly (string | null)[]) { print(ys.length) }
const ss: string[] = ["a"]
strElem(ss)

function listElem(ys: readonly (i32[] | null)[]) { print(ys.length) }
const ls: i32[][] = [[1]]
listElem(ls)

function boolNiche(ys: readonly (boolean | null)[]) { print(ys.length) }
const bs: boolean[] = [true]
boolNiche(bs)

function atomNiche(ys: readonly (K | null)[]) { print(ys.length) }
const ks: K[] = ["a"]
atomNiche(ks)

// The three converting pairs (D965): each changes the element's storage class and runs
// through the copy.
function widenF64(ys: readonly f64[]) { print(ys.length) }
const i32s: i32[] = [1]
widenF64(i32s)

function widenI64(ys: readonly i64[]) { print(ys.length) }
const i32s2: i32[] = [1]
widenI64(i32s2)

function promoteF64(ys: readonly f64[]) { print(ys.length) }
const f32s: f32[] = [1.0]
promoteF64(f32s)

// A HOLE on either side is never claimed — a generic element reaches the rule
// unclassified, and declining is what keeps `first` usable.
function first<T>(ys: T[]): T { return ys[0] }
const xs: i32[] = [7]
print(first(xs) - 6)
