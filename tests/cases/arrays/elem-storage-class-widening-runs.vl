// @run
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// @hint redundant type annotation: `c` is inferred as `{n: i32}`
// @hint redundant type annotation: `cs` is inferred as `C[]`
// @hint redundant type annotation: `ss` is inferred as `string[]`
// @hint redundant type annotation: `ls` is inferred as `i32[][]`
// @hint redundant type annotation: `bs` is inferred as `boolean[]`
// @hint redundant type annotation: `xs` is inferred as `i32[]`
// The annotations the hints name are LOAD-BEARING here and are kept deliberately: the
// rule's hard case is a PINNED source (#1456's provenance axis), so every source below is
// spelled at its own type rather than left to inference. `ks` is the one that is not
// redundant — an un-annotated `["a"]` infers `string[]`, not `K[]`.
// THE OTHER SIDE OF THE CONTAINER-ELEMENT STORAGE RULE, and the load-bearing half: every
// widening here KEEPS the element's storage class, so it lowers and must keep running.
// Its twin `error-elem-storage-class-no-lowering.vl` pins the class CHANGES that do not.
//
// This file exists because the rule is a CLASS test rather than a type-identity one, and
// a type-identity rule would reject every line below. Each was measured RUNNING before
// the rule shipped:
//   - a REF element takes `| null` for nothing — a nullable ref is the same wasm reftype,
//     so an object, a string and an array element all widen in place;
//   - a NICHE-nullable scalar keeps its base class — `boolean | null` is the same i32
//     element with sentinel 2, and `K | null` the same interned atom with sentinel -1.
// A future tightening that reaches any of these is rejecting working code.
type C = { n: i32 }
type K = "a" | "b"

function refElem(ys: (C | null)[]) { print(ys.length) }
const c: C = { n: 1 }
const cs: C[] = [c]
refElem(cs)

function strElem(ys: (string | null)[]) { print(ys.length) }
const ss: string[] = ["a"]
strElem(ss)

function listElem(ys: (i32[] | null)[]) { print(ys.length) }
const ls: i32[][] = [[1]]
listElem(ls)

function boolNiche(ys: (boolean | null)[]) { print(ys.length) }
const bs: boolean[] = [true]
boolNiche(bs)

function atomNiche(ys: (K | null)[]) { print(ys.length) }
const ks: K[] = ["a"]
atomNiche(ks)

// A HOLE on either side is never claimed — a generic element reaches the rule
// unclassified, and declining is what keeps `first` usable.
function first<T>(ys: T[]): T { return ys[0] }
const xs: i32[] = [7]
print(first(xs) - 6)
