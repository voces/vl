// @run
// An un-annotated list literal whose element is a nullable union of two or more non-null
// members is that union's list, in every element order, with a declared record, a nested list
// or a scalar beside the string, and inside a function (D4720).
const a = ["t", null, { x: 1 }]
const a2 = a[2]
if a2 is string { print(a2) }
else if a2 == null { print("null") }
else { print(a2.x + 2) }
const b = [{ x: 4 }, null, "u"]
for e in b {
  if e is string { print(e) }
  else if e == null { print("null") }
  else { print(e.x) }
}
const c = [null, "v", { x: 5 }]
print(c.length)
if c[0] == null { print("first null") }
type A = { a: i32 }
type B = { b: string }
const xa: A = { a: 6 }
const xb: B = { b: "w" }
const d = [xa, null, xb]
for e in d {
  if e is A { print(e.a) }
  else if e is B { print(e.b) }
  else { print("null") }
}
const f = ["s", null, [7, 8]]
const f2 = f[2]
if f2 is string { print(f2) }
else if f2 == null { print("null") }
else { print(f2[1]) }
const g = [9, null, "z"]
for e in g {
  if e is string { print(e) }
  else if e == null { print("null") }
  else { print(e + 1) }
}
function inner() {
  const h = ["t", null, { x: 11 }]
  const h2 = h[2]
  if h2 is string { print(h2) }
  else if h2 != null { print(h2.x) }
}
inner()
// @log 3
// @log 4
// @log null
// @log u
// @log 3
// @log first null
// @log 6
// @log null
// @log w
// @log 8
// @log 10
// @log null
// @log z
// @log 11
