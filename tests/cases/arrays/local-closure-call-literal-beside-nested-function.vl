// @run
// @log hi
// @log 4
// @log 5
// @log 6
// @log 2.5
// @log 4
// @log 4
// @log 3
// @log 4
// @log 7
// @hint redundant type annotation: `leg` is inferred as `i32`
// @warning Unused variable `sh` (prefix with `_` to suppress, or remove it)

// D2386 — a list literal of a local closure's calls is a list of the closure's result, even
// where another function nests a same-named function of a different result type. D1305 is the
// same reservation for a local shadowing a module global of another rep.

function b() {
  function w() { "hi" }
  print(w())
}
b()

function bound() {
  const w = () => {
    3
  }
  const xs = [w(), w() + 1]
  print(xs[1])
}
bound()

function inline() {
  const w = () => {
    3
  }
  print([w(), 5][1])
  const m = w() * 2
  print(m)
}
inline()

function c() {
  function v() { 2.5 }
  print(v())
}
c()

function returned() {
  const v = () => {
    3
  }
  return [v(), v() + 1]
}
print(returned()[1])

function param(w: () => i32) {
  const xs = [w(), w() + 1]
  print(xs[1])
}
param(() => 3)

function iterated() {
  const v = () => {
    3
  }
  for x in [v(), v() + 1] { print(x) }
}
iterated()

const sh: string = "hi"
function leg(): i32 {
  const sh = 7
  const xs = [sh]
  return xs[0]
}
print(leg())
