// @error-at 15:12 a list of only `null` has no element type: a binding of `null` that is never written another value is `null`; annotate the list or the binding, e.g. `const e: (i32 | null)[] = [x]`
// @error-at 24:15 a list of only `null` has no element type: a binding of `null`
// @error-at 26:8 a list of only `null` has no element type: a binding of `null`
// @error-at 32:12 a list of only `null` has no element type: a binding of `null`
// @error-at 40:8 a list of only `null` has no element type: a binding of `null`
// @error-at 44:12 a list of only `null` has no element type: a binding of `null`
// @error-at 48:13 a list of only `null` has no element type: a binding of `null`
// @error-at 51:12 a list of only `null` has no element type: a binding of `null`
// @error-at 54:13 a list of only `null` has no element type: a binding of `null`
// A `let x = null` no write fills is `null`, so an un-annotated list of only its values is the
// `[null]` list and refuses at the literal: a plain read, a read after a closure wrote `null`, a
// read under a read-only closure or an uncalled writer, an assignment of `null`, module scope, and
// a `const n = null` (D17304, D17447, coordinator ruling).
function plain() {
  let x = null
  const a = [x]
  print(a.length)
}
function afterWriter() {
  let x = null
  const w = () => {
    x = null
  }
  w()
  const seen = [x]
  print(seen.length)
  print([x][0])
}
function readOnly() {
  let x = null
  const r = () => x
  print(r())
  const a = [x, x]
  print(a.length)
}
function uncalled() {
  let x = null
  const w = () => {
    x = null
  }
  print([x].length)
}
function assigned() {
  let x = null
  const a = [x = null]
  print(a.length)
}
let m = null
const mods = [m]
print(mods.length)
const cn = null
const cxs = [cn]
function constBinding() {
  const n = null
  const xs = [n]
  print(xs.length)
}
plain()
afterWriter()
readOnly()
uncalled()
assigned()
constBinding()
