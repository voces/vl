// @error-at 13:12 a list of only `null` has no element type: a `let` bound to `null` and never written another value is `null`; annotate the list or the binding, e.g. `const e: (i32 | null)[] = [x]`
// @error-at 22:15 a list of only `null` has no element type: a `let` bound to `null`
// @error-at 24:8 a list of only `null` has no element type: a `let` bound to `null`
// @error-at 30:12 a list of only `null` has no element type: a `let` bound to `null`
// @error-at 38:8 a list of only `null` has no element type: a `let` bound to `null`
// @error-at 42:12 a list of only `null` has no element type: a `let` bound to `null`
// @error-at 46:13 a list of only `null` has no element type: a `let` bound to `null`
// A `let x = null` no write fills is `null`, so an un-annotated list of only its values is the
// `[null]` list and refuses at the literal: a plain read, a read after a closure wrote `null`, a
// read under a read-only closure or an uncalled writer, an assignment of `null`, and module scope
// (D17304, coordinator ruling).
function plain() {
  let x = null
  const a = [x]
  print(a.length)
}
function afterWriter() {
  let x = null
  const w = () => {
    x = null
  }
  w()
  const seen = [x]
  print(seen.length)
  print([x][0])
}
function readOnly() {
  let x = null
  const r = () => x
  print(r())
  const a = [x, x]
  print(a.length)
}
function uncalled() {
  let x = null
  const w = () => {
    x = null
  }
  print([x].length)
}
function assigned() {
  let x = null
  const a = [x = null]
  print(a.length)
}
let m = null
const mods = [m]
print(mods.length)
plain()
afterWriter()
readOnly()
uncalled()
assigned()
