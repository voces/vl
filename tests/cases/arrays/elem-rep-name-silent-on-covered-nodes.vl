// @run
// @log 1
// @log 1
// @log 1
// @log 1
// THREE MORE SHIPPED REGRESSIONS in the family of `union-arm-f64-list-field.vl`, and NONE of
// them involves an orphaned node. These are nodes the arena covers perfectly well and whose
// element rep the accessor still cannot name.
//
// `nodeTyArrayElemRepName` answers only for a `TyPrim` element. A `TyArray` whose element is a
// numeric literal-union is a `TyUnion` of `TyLit`s — and `tyIsLitUnion` demands `litKind ==
// "str"`, so the numeric ones match nothing — while a type-parameter element is a `TyParam`,
// handled nowhere. Both fall out with `""` at a node whose `nodeTyIxOf` is non-negative.
//
// The `collectA` rung then falls through to `nameIsArray(nd.tyName)`, where `checkArrName`
// REJECTS: "only i32[] arrays and struct/union element arrays are supported". All four
// declarations below fail to compile before the rungs took the NAME as a second opinion.
//
// THIS IS WHY THAT RUNG IS AN `||` AND NOT A COVERAGE GUARD. `nodeTyIxOf(i) >= 0` is true for
// every case on this page, so a guard would route all four to the silent accessor and leave
// them broken — the map rungs above can use a guard because `mapKeyRepTy` does answer for the
// nominal keys they see. Two rungs, two accessors, two shapes; the difference is not cosmetic.
//
// The last pair also needs `canonEmitTypeNames` to be scope-BLIND, which it is: it rewrites the
// shadowed `T[]` to `f64[]` / `i64[]`, which is what lets the name answer at all.
type Kf = 1.5 | 2.5
type Ki = 5000000000 | 6000000000
type Tf = f64
type Ti = i64

const xs: Kf[] = [1.5]
print(xs.length)
const ys: Ki[] = [5000000000]
print(ys.length)

function atf<Tf>(zs: Tf[]) { return zs.length }
print(atf([1.5]))
function ati<Ti>(zs: Ti[]) { return zs.length }
print(ati([5000000000]))
