// @run
// @log 4
// @log 4
// @log 4
// @log 4.5
// @log 4.5
// @log 3
// @log 4
// @log 2
// The plain elements beside a spread, and a variadic push's arguments, are built as one list at
// the type of the list holding them, whether that list is annotated or inferred.
const a: f64[][] = [[1, 2], ...[[3.5]], [5]]
print(a[0][1] / 4.0 + a[1][0])
const b = [[1, 2], ...[[3.5]], [5]]
print(b[0][1] / 4.0 + b[1][0])
function j() { return [[1, 2], ...[[3.5]]] }
print(j()[0][1] / 4.0 + j()[1][0])
const c: f64[] = [1, ...[2.5], 3]
print(c[0] / 2.0 + c[2] + c.length - 2)
const p: f64[] = []
p.push(1, 2)
print(p[0] / 2.0 + p[1] * 2)
const q = [[1.5]]
q.push([1, 2], [3])
print(q.length + q[1][0] / 2.0 - 0.5 + q[2][0] / 3.0 - 1)
function t<T>(x: T) {
  const r = [x]
  r.push(x, x)
  [...r, x].length
}
print(t(1))
const ll: i32[][] = [[3]]
const n = [...ll, null]
print(n.length)
