// @run
// @log 3.25
// @log 2.5
// A list literal spreading only a call that builds its list is copied into a wider record list
// (D16615), and so is a function returning a local list literal.
function mk() { return [{ x: 1 }, { x: 3 }] }
function mkLocal() {
  const cc = [{ x: 2 }, null]
  return cc
}
const v: { x: f64 }[] = [...mk()]
print(v[1].x + 0.25)
const w: ({ x: f64 } | null)[] = [...mkLocal()]
const e = w[0]
if e != null { print(e.x + 0.5) }
