// @run
// @log z
// @log a
// @log z
// @log z
// @log a
// @log z
// @log z
// @log z
// @hint redundant type annotation: `ys` is inferred as `(string | null)[]` — remove it to lean on inference
// @hint redundant type annotation: `zs` is inferred as `(string | null)[]` — remove it to lean on inference
// THOSE TWO HINTS ARE DECLARED, NOT ACTED ON: the annotated and the inferred spelling are each
// a face of the defect, so both are kept.

// D2276 — `xs.get(i) ?? d` over a `(string | null)[]`. A module global's read took the fused
// scalar-list read, which recovers the element with `ref.as_non_null`, so a stored `null`
// trapped (`null reference`) instead of taking the default. The same read in a function body
// always took the generic nullable read; both now do.
const ys: (string | null)[] = ["a", null]
print(ys.get(1) ?? "z")
print(ys.get(0) ?? "z")
print(ys.get(9) ?? "z")

function f() {
  const zs: (string | null)[] = ["a", null]
  print(zs.get(1) ?? "z")
  print(zs.get(0) ?? "z")
  print(zs.get(9) ?? "z")
}
f()

// The inferred spelling.
const us = ["a", null]
print(us.get(1) ?? "z")

function g() {
  const vs = ["a", null]
  print(vs.get(1) ?? "z")
}
g()
