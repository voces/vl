// @run
// @log 1
// @log 1
// @log 4.5
// @log 3
// @log 4
// @log 2
// @log 1
// @log 2
// @log 4
// @hint redundant type annotation: `cs` is inferred as `{n: i32}[]` — remove it to lean on inference
// @hint redundant type annotation: `ns` is inferred as `i32[]` — remove it to lean on inference
// @hint redundant type annotation: `rs` is inferred as `{r: i32}[]` — remove it to lean on inference
// The second fix the container rule names: each `.map` copy its refusals suggest, spelled
// exactly as the message spells it, into a MUTABLE wider list. The copy is a new list, so a
// write through it leaves the source alone, which the last line of each block shows.
type C = { n: i32 }
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
const cs: C[] = [{ n: 1 }]
const ns: i32[] = [3, 4]
const rs: Circle[] = [{ r: 5 }]

const wc: (C | null)[] = cs.map((x): C | null => x)
wc[0] = null
print(wc.length)
print(cs[0].n)

const wf: f64[] = ns.map((x) => x as f64)
wf[0] = 0.5
print(wf[0] + wf[1])
print(ns[0])

const wl: i64[] = ns.map((x) => x as i64)
print(wl[1])

const ws: Shape[] = rs.map((x): Shape => x)
ws.push({ s: 2 })
print(ws.length)
print(rs.length)

const wn: (i32 | null)[] = ns.map((x): i32 | null => x)
wn[1] = null
print(wn.length)
print(ns[1])
