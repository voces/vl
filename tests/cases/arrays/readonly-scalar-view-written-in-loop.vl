// @run
// @hint redundant type annotation: `g` is inferred as `i32[]` — remove it to lean on inference
// @hint redundant type annotation: `get` is inferred as `i32[]` — remove it to lean on inference
// @hint redundant type annotation: `h` is inferred as `i32[]` — remove it to lean on inference
// @hint redundant type annotation: `geth` is inferred as `i32[]` — remove it to lean on inference
// @hint redundant type annotation: `k` is inferred as `i32[]` — remove it to lean on inference
// @log 13
// @log 1
// @log 2
// @log 10
// @log 1,9,
// @log 3
// D3028, D3042: a view read while the loop, or a callback, writes its source through an index
// sees each write as the shared list would; a view stored in a module binding from a parameter
// reads the source's later growth.
const g: i32[] = [1, 2, 3]
function get(): i32[] { return g }
const y = get()
const v: readonly i64[] = y
let i = 0
let s: i64 = 0
while i < v.length {
  g[2] = 10
  s = s + v[i]
  i = i + 1
}
print(s)
for e in v {
  g[0] = 20
  print(e)
}

const h: i32[] = [1, 2]
function geth(): i32[] { return h }
const hy = geth()
const hv: readonly i64[] = hy
let out = ""
for e in hv.filter((e) => {
  h[1] = 9
  return e > 0
}) { out = out + "\{e}," }
print(out)

let keep: readonly i64[] = []
function st(x: i32[]) { keep = x }
const k: i32[] = [1, 2]
st(k)
k.push(3)
print(keep.length)
