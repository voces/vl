// A list literal joins its elements the way an `if` joins its arms: a list that already
// exists, beside one stored differently, is held as itself in a union element and never
// copied (DECISIONS.md, "No implicit container widening"), so a write through the element
// reaches the original. `error-list-literal-join-widening.vl` keeps the spread and `+` forms.
// @run
// @log 8
// @log 2
// @log 6
// @log 6
function t() { 1 == 1 }
function mk() { return [1, 2] }
function mf() { return [1.5] }

const ki = mk()
const e1 = [mf(), ki]
const e1b = e1[1]
if e1b is i32[] { e1b[0] = 8 }
print(ki[0])
const e2 = [mf(), if t() { mk() } else { [2.5] }]
const e2b = e2[1]
if e2b is i32[] { print(e2b[1]) }
const ia = [1, 2]
const ib: (i32 | string)[] = ["s"]
const e3 = [ia, ib]
const e3a = e3[0]
if e3a is i32[] { e3a[1] = 6 }
print(ia[1])
print(e1.length + e2.length + e3.length)
