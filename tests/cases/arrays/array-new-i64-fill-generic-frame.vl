// @run
// @log 2
// @log 2
// @log 2
// @log 2
// @log 2
// @log 7
// @hint redundant type annotation: `out` is inferred as `T[]`
// @hint redundant type annotation: `pickHidden` is inferred as `i32`
// @hint redundant type annotation: `small` is inferred as `i32`
// @hint redundant type annotation: `wide` is inferred as `f64`
// D1669 — `__array_new__` with an i64 fill inside a generic.
//
// `arrNewIntrKind` reads the fill's rep in a FRAME. Inside a monomorphized instance the fill
// is a parameter whose rep only the substituted annotation names, and `collectA`'s arena walk
// asked frameless: it interned the i32 pair while the emitter, which has the frame, built the
// i64 backing. `collectArrNewFrames` asks the same rung per function body.
//
// `exprI64Array` also gains the `__array_new__` arm its f64, string, ref and i32 siblings all
// carry, so the un-annotated local keeps the slot the intrinsic chose.
function pick<T>(v: T): T[] {
  const out = __array_new__(2, v)
  return out
}

function pickAnn<T>(v: T): T[] {
  const out: T[] = __array_new__(2, v)
  return out
}

function pickHidden<T>(v: T): i32 {
  const out = __array_new__(2, v)
  return out.length
}

function big(): i64 { 7 }

function small(): i32 { 7 }

function wide(): f64 { 7.5 }

// The row's own witness, then the annotated control and the two other pins.
print(pick(big()).length)
print(pickAnn(big()).length)
print(pick(small()).length)
print(pick(wide()).length)

// The loud face: the list never leaves the instance, so nothing spells `i64[]` at all.
print(pickHidden(big()))

// The elements are the i64 fill, not a truncated i32.
const xs = pick(big())
print(xs[1])
