// @check
// @error the literal -7 does not fit a `u8` element (0..255)
// @error the literal -2147483648 does not fit a `u8` element (0..255)
// @error the literal -3 does not fit a `u8` element (0..255)
// CONTRACT (must-error): a negative integer literal, and so a constant holding one, does not fit a
// `u8` element, exactly as one past 255 does; `as% u8` spells the wrap (owner ruling, D3428).
const xs: u8[] = [-7]
const K = -2147483648
const ys: u8[] = [K]
ys[0] = -3
const zs: u8[] = [-7 as% u8, -0]
print(xs.length + ys.length + zs[0])
