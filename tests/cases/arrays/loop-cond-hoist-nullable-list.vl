// @run
// A LOOP-CONDITION list index whose receiver is a NULLABLE list must not hoist its
// wrapper header.
//
// `loopHoistOpen` reads a list wrapper's two header fields ONCE, before the loop, and
// serves every `xs[i]` in the condition and body from those locals. That is only sound
// when the wrapper is certainly present, so `hoistRowOfRecv` opens with a nullable
// decline — but the decline was `exprNulScalarListKind`, which names only the four
// nullable leaves owning their OWN wrapper heap type (`nulstrlist` / `nulf64list` /
// `nuli64list` / `nulf32list`). `i32[] | null` and `boolean[] | null` share the i32 list
// backing, so they answered `null` there, fell through to `scalarListElemKind`, and were
// hoisted as if they were plain non-null lists.
//
// The prologue then emitted `struct.get $lTypeIdx 0/1` on a `(ref null $lTypeIdx)` in
// FRONT of the loop — and in front of the `ref.is_null` guard inside the condition. `vl
// check` rc 0, `vl build` rc 0, `wasm trap: null reference` at run. It is also a
// short-circuit violation: part of the right operand of `&&` ran with the left operand
// false. `f64[] | null` and `string[] | null` were already clean, which is what located
// the hole in the DECLINE rather than in the guard, and they are kept below as the oracle
// rows.
//
// Every row runs at both a present list and a `null`; the `null` rows are the ones that
// trapped.
//
// @log i32 present true
// @log i32 null false
// @log bool present true
// @log bool null false
// @log f64 present true
// @log f64 null false
// @log str present true
// @log str null false
// @log i32-or present true
// @log i32-or null true
// @log i32-nest present true
// @log i32-nest null false

function loopI32(e: i32[] | null) {
  let n = 0
  while e != null && e[0] >= 0 {
    n = 1
    break
  }
  return n == 1
}

function loopBool(e: boolean[] | null) {
  let n = 0
  while e != null && e[0] {
    n = 1
    break
  }
  return n == 1
}

function loopF64(e: f64[] | null) {
  let n = 0
  while e != null && e[0] >= 0.0 {
    n = 1
    break
  }
  return n == 1
}

function loopStr(e: string[] | null) {
  let n = 0
  while e != null && e[0].length > 0 {
    n = 1
    break
  }
  return n == 1
}

// The `||` complement reaches the same hoist through the ELSE-sense of the guard.
function loopOrI32(e: i32[] | null) {
  let n = 0
  while e == null || e[0] >= 0 {
    n = 1
    break
  }
  return n == 1
}

// Three conjuncts, so the index sits two guards deep and the `.length` read in the
// middle is a second header consumer the prologue would have served.
// (A guard in the CONDITION does not narrow the loop BODY — the checker narrows an
// `if` arm only — so the body spelling of this row is a check error, not a cell.)
function loopNestI32(e: i32[] | null) {
  let n = 0
  while e != null && e.length > 0 && e[0] >= 0 {
    n = 1
    break
  }
  return n == 1
}

function say(tag: string, v: boolean) {
  print(tag + " " + toString(v))
  0
}

say("i32 present", loopI32([1, 2]))
say("i32 null", loopI32(null))
say("bool present", loopBool([true]))
say("bool null", loopBool(null))
say("f64 present", loopF64([1.0]))
say("f64 null", loopF64(null))
say("str present", loopStr(["a"]))
say("str null", loopStr(null))
say("i32-or present", loopOrI32([1, 2]))
say("i32-or null", loopOrI32(null))
say("i32-nest present", loopNestI32([1, 2]))
say("i32-nest null", loopNestI32(null))
