// A join of a list that already exists with a list stored differently (`i32[]` beside
// `[2.5]`, `f32[]` beside `[2.2]`) is the union of the two lists, so the existing one is
// held as itself and never copied (DECISIONS.md, "No implicit container widening"). Each
// join position holds it apart: a `??` operand, an `if` arm, a `match` arm, a return set,
// a list of lists and a reference-element pair. A write through the joined value reaches
// the original, and a list literal arm is built as its own list.
// @run
// @log 9
// @log 4
// @log 5
// @log 1.25
// @log 3
// @log 3
// @log b
// @log 5
function t() { 1 == 1 }

const a: i32[] | null = [7]
const q1 = a ?? [2.5]

const f32s = [(1.5 as f32)]
const q2 = if t() { f32s } else { [2.2] }

const ns = [1]
const q3 = match 1 {
  1 => ns
  _ => [2.5]
}

function ret(c: boolean) {
  if c { return ns }
  [2.5]
}

const nn: i32[][] = [[3]]
const q4 = if t() { nn } else { [[2.5]] }

const ss = ["b"]
const q5 = if t() { ss } else { [1, "a"] }

if q1 is i32[] { q1[0] = 9 }
if a != null { print(a[0]) }
if q3 is i32[] { q3[0] = 4 }
print(ns[0])
const r = ret(true)
if r is i32[] { r[0] = 5 }
print(ns[0])
const rf = ret(false)
if rf is f64[] { print(rf[0] / 2.0) }
if q2 is f32[] { print(q2[0] * (2 as f32)) }
if q4 is i32[][] { print(q4[0][0]) }
if q5 is string[] { print(q5[0]) }
print(q1.length + q2.length + q3.length + q4.length + q5.length)
