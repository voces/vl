// @run
// @log 1
// @log 2
// @log 1
// @log 2
// @log a
// @log b
// @log 1
// @log 2
// @log 1.5
// @log 2.5
// @log 1
// @log 2
// @log 5000000000
// @log 2
// @log 1
// @log 2
// @log 1
// @log 2
// @log 1
// @log 2
// @hint redundant type annotation: `xs` is inferred as `i32[]?`
// @hint redundant type annotation: `xs` is inferred as `string[]?`
// @hint redundant type annotation: `xs` is inferred as `f64[]?`
// @hint redundant type annotation: `xs` is inferred as `i64[]?`
// @hint redundant type annotation: `xs` is inferred as `{v: i32}[]?`
// A NARROWED nullable-list receiver must `ref.as_non_null` at EVERY element kind before
// the wrapper `struct.get`, not only at the i32 one.
//
// `for v in xs`, `xs.slice(..)` and `xs.filter(..)` each read the iterable/receiver ONCE
// into a NON-NULL temp, and all three recovers asked `exprNullableList` — which claims
// ONLY the i32-list niche (`i32[] | null`). A `string[] | null` / `f64[] | null` /
// `i64[] | null` / `P[] | null` binding keeps its OWN wrapper, so no arm claimed it,
// nothing was emitted, and the wrapper `struct.get` received `(ref null $wrap)` where it
// demands `(ref $wrap)`: `vl check`-clean INVALID WASM (`type mismatch: expected
// (ref $type), found (ref null $type)`), never a diagnostic. The i32 rows below are the
// oracle — they have always run, which is what makes this a missing arm.
//
// The recover is the READ dual of `emitNulIsNullTest`'s niche disjunction, whose header
// states the same invariant for the null TEST — "a rep answered in only one of the two
// callers is a guard that never fires". `nulRecvNeedsRecover` is the one predicate all
// three operations ask, so a new nullable collection rep is added once.

type P = { v: i32 }

function mkI32(): i32[] | null { return [1, 2] }
function mkStr(): string[] | null { return ["a", "b"] }
function mkF64(): f64[] | null { return [1.5, 2.5] }
function mkI64(): i64[] | null { return [5000000000, 2] }
function mkRef(): P[] | null { return [{ v: 1 }, { v: 2 }] }

function keepI32(e: i32) { e >= 0 }
function keepStr(e: string) { e.length >= 0 }
function keepF64(e: f64) { e >= 0.0 }
function keepI64(e: i64) { e >= 0 }
function keepRef(e: P) { e.v >= 0 }

// ---- i32[] | null — the CONTROL: green before and after ----
function goI32() {
  const xs: i32[] | null = mkI32()
  if xs != null {
    for x in xs { print(x) }
    print(xs.slice(0, 1).length)
    print(xs.filter(keepI32).length)
  }
}
goI32()

// ---- string[] | null ----
function goStr() {
  const xs: string[] | null = mkStr()
  if xs != null {
    for x in xs { print(x) }
    print(xs.slice(0, 1).length)
    print(xs.filter(keepStr).length)
  }
}
goStr()

// ---- f64[] | null ----
function goF64() {
  const xs: f64[] | null = mkF64()
  if xs != null {
    for x in xs { print(x) }
    print(xs.slice(0, 1).length)
    print(xs.filter(keepF64).length)
  }
}
goF64()

// ---- i64[] | null ----
function goI64() {
  const xs: i64[] | null = mkI64()
  if xs != null {
    for x in xs { print(x) }
    print(xs.slice(0, 1).length)
    print(xs.filter(keepI64).length)
  }
}
goI64()

// ---- P[] | null (a ref array — its slot's own wrapper) ----
function goRef() {
  const xs: P[] | null = mkRef()
  if xs != null {
    for x in xs { print(x.v) }
    print(xs.slice(0, 1).length)
    print(xs.filter(keepRef).length)
  }
}
goRef()
