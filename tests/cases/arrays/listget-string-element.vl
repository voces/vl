// @run
// @log 2
// @log b
// @log b
// @log b
// @log b
// @log z
// @log 8
// @log 2.5
// @log 4
// @hint redundant type annotation: `b` is inferred as `{b: string}` — remove it to lean on inference
// @hint redundant type annotation: `sv` is inferred as `{w: i32}[]` — remove it to lean on inference

// D1684 — `xs.get(i) ?? d` over a `string[]`. Four descriptors keyed on the element kind fell
// through to the i32 list's answer, and `exprArray`'s typed-IR fast path claims ANY array, so
// a string list read at the i32 backing. The `nums` list is load-bearing: it is what makes
// the fall-through's `lUsed` true, which turned the refusal into invalid wasm.
type B = { b: string }
type S = { w: i32 }

const nums = [1, 2]

const ys = ["a", "b"]

print(nums[0] + 1)

// The four positions the fused `?? d` read serves.
const v = ys.get(1) ?? "z"
print(v)

function take(e: string) { print(e) }

take(ys.get(1) ?? "z")

function g() { ys.get(1) ?? "z" }

print(g())

const b: B = { b: ys.get(1) ?? "z" }
print(b.b)

// The MISS arm takes the default at the element's own rep, not the i32 list's.
print(ys.get(9) ?? "z")

// The other element kinds keep their own descriptors — the arms the named defaults now
// stand behind.
const iv = [7, 8]
print(iv.get(1) ?? 0)

const fv = [1.5, 2.5]
print(fv.get(1) ?? 0.0)

const sv: S[] = [{ w: 3 }, { w: 4 }]
const e = sv.get(1)
if e != null { print(e.w) } else { print(0) }
