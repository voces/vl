// @check
// @error-at 25:12 i32[] is not (i32 | null)[]: a container never widens implicitly
// @error-at 31:7 (reached through i32[][] into (i32 | null)[][])
// @error-at 36:10 K[] is not string[]: a container never widens implicitly
// @error-at 42:9 i64[] is not (i64 | null)[]
// VERDICT PIN (must-error), no `@log` form: the diagnostic IS the observable.
//
// NO IMPLICIT CONTAINER WIDENING (DECISIONS.md, owner ruling 2026-09-23). A container of T
// never implicitly becomes a container of a wider U when the two element types are stored
// differently: relating them takes a copy, and a copy silently stops sharing writes with the
// original, so the refusal is a design rule and names the explicit copy to write.
//
// The companion `elem-storage-class-widening-runs.vl` pins the widenings that still run and
// are owed an owner decision under the same ruling: the class-KEEPING ones share the list,
// and the three numeric pairs take a read-only converting copy. Both files are read together
// because the axis is the element's STORAGE class, not the element's type.
//
// Every pair below needs the destination element CONSTRUCTED (a box, a heap string) rather
// than converted, so it refuses read-only as well as written.
type K = "a" | "b"

// A scalar element boxed by the destination union: `i32` is a plain i32 element,
// `i32 | null` is a boxed one.
function scalarToBox(ys: (i32 | null)[]) { print(ys.length) }
const xs: i32[] = [1, 2]
scalarToBox(xs)

// The same class change one container deeper — the diagnostic must name the INNER pair
// and say which outer pair it was reached through.
function nested(ys: (i32 | null)[][]) { print(ys.length) }
const xss: i32[][] = [[1]]
nested(xss)

// An interned literal-union atom (an i32 id) into a `string` element (a ref).
function atomToRef(ys: string[]) { print(ys.length) }
const ks: K[] = ["a"]
atomToRef(ks)

// An i64 element beside the boxed twin — the same class change as `scalarToBox`, kept
// because i64 and i32 are separate storage classes and a one-class rule would miss it.
function i64ToBox(ys: (i64 | null)[]) { print(ys.length) }
const ls: i64[] = [1]
i64ToBox(ls)
