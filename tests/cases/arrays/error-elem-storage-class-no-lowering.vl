// @check
// @error-at 23:12 flowing into (i32 | null)[] changes how the ELEMENT is stored
// @error-at 29:7 (reached through i32[][] into (i32 | null)[][])
// @error-at 34:10 a value of type K[] flowing into string[]
// @error-at 39:13 a value of type i32[] flowing into f64[]
// @error-at 45:9 a value of type i64[] flowing into (i64 | null)[]
// VERDICT PIN (must-error), no `@log` form: every shape here is `vl check`-clean invalid
// wasm on the parent, so the file cannot be written as a running program — the diagnostic
// IS the observable.
//
// THE CONTAINER-ELEMENT STORAGE RULE. `assignable` accepts an element widening, and the
// emitter has no conversion for it: a container's wasm type is fixed by how its element is
// stored, so a source whose element lands in a DIFFERENT storage class is an unrelated
// type and there is no element-converting copy to insert. The companion file
// `elem-storage-class-widening-runs.vl` pins the other side — the widenings that keep the
// class and therefore keep working — and the two must be read together, because the rule
// is a class test and not a type-identity one.
type K = "a" | "b"

// A scalar element boxed by the destination union: `i32` is a plain i32 element,
// `i32 | null` is a boxed one.
function scalarToBox(ys: (i32 | null)[]) { print(ys.length) }
const xs: i32[] = [1, 2]
scalarToBox(xs)

// The same class change one container deeper — the diagnostic must name the INNER pair
// and say which outer pair it was reached through.
function nested(ys: (i32 | null)[][]) { print(ys.length) }
const xss: i32[][] = [[1]]
nested(xss)

// An interned literal-union atom (an i32 id) into a `string` element (a ref).
function atomToRef(ys: string[]) { print(ys.length) }
const ks: K[] = ["a"]
atomToRef(ks)

// A width change with no union involved at all.
function narrowToWide(ys: f64[]) { print(ys.length) }
const is32: i32[] = [1]
narrowToWide(is32)

// An i64 element beside the boxed twin — the same class change as `scalarToBox`, kept
// because i64 and i32 are separate storage classes and a one-class rule would miss it.
function i64ToBox(ys: (i64 | null)[]) { print(ys.length) }
const ls: i64[] = [1]
i64ToBox(ls)
