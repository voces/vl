// @run
// A variadic `.push` (several arguments, or a spread) onto a literal-union, `K | null`,
// `string | null` or `boolean | null` list appends each value at the slot's own rep, at every
// delivery position of the receiver, annotated or inferred (D4553).
type K = "a" | "b"
type Box = {
  ks: K[],
  ns: (string | null)[],
  bs: (boolean | null)[],
  ls: (K | null)[],
}
const gks: K[] = ["a"]
const gns: (string | null)[] = ["x"]
const gbs: (boolean | null)[] = [true]
const gls: (K | null)[] = ["a"]
function growGlobals() {
  gks.push("b", "a")
  gns.push(null, "y")
  gbs.push(null, false)
  gls.push(null, "b")
}
function addK(xs: K[]) { xs.push("b", "b") }
function addN(xs: (string | null)[]) { xs.push(null, "z") }
function addB(xs: (boolean | null)[]) { xs.push(false, null) }
function addL(xs: (K | null)[]) { xs.push("b", null) }
function addAll(xs, a, b) { xs.push(a, b) }
function addTwo<T>(xs: T[], a: T, b: T) { xs.push(a, b) }
function mkK(): K[] { return ["a"] }
function mkN(): (string | null)[] { return ["x"] }
function fromVars(k: "a" | "b", s: string | null) {
  const ks: K[] = []
  ks.push(k, k)
  const ns: (string | null)[] = []
  const atom: K = "b"
  ns.push(s, atom, null)
  print(ns.length)
  return ks[1] + (ns[0] ?? "-") + (ns[1] ?? "-")
}
// local
const xs: K[] = ["a"]
xs.push("a", "b")
print(xs.length)
print(xs[2])
const ns: (string | null)[] = ["a"]
ns.push(null, "b")
print(ns[1] == null)
print(ns[2])
const bs: (boolean | null)[] = [true]
bs.push(null, false)
print(bs[1] == null)
print(bs[2])
const ls: (K | null)[] = ["a"]
ls.push(null, "b")
print(ls[1] == null)
print(ls[2])
// struct field
const box: Box = { ks: ["a"], ns: ["x"], bs: [true], ls: ["a"] }
box.ks.push("b", "a")
box.ns.push(null, "y")
box.bs.push(null, false)
box.ls.push(null, "b")
print(box.ks[1])
print(box.ns[2])
print(box.bs[1] == null)
print(box.ls[2])
// global
growGlobals()
print(gks.length + gns.length + gbs.length + gls.length)
print(gbs[2])
// parameter, annotated, un-annotated and generic
const pk: K[] = []
const pn: (string | null)[] = []
const pb: (boolean | null)[] = []
const pl: (K | null)[] = []
addK(pk)
addN(pn)
addB(pb)
addL(pl)
print(pk[0])
print(pn[1])
print(pb[1] == null)
print(pl[0])
const k1: K = "b"
const k2: K = "a"
addAll(pk, k1, k2)
print(pk[3])
addTwo(pn, null, "n")
print(pn[3])
addTwo(pb, true, null)
print(pb[2])
// an inferred receiver
const ik = mkK()
ik.push("b", "a")
const iN = mkN()
iN.push(null, "w")
print(ik[1])
print(iN[2])
// spread, alone and after a plain argument
const sl: (K | null)[] = ["a"]
const sr: (K | null)[] = [null, "b"]
sl.push(...sr)
sl.push("a", ...sr)
print(sl.length)
print(sl[3])
const sk: K[] = ["a"]
const sk2: K[] = ["b", "a"]
sk.push(...sk2)
print(sk[1])
// value position: the new length
const vn: (string | null)[] = []
print(vn.push(null, "q", null))
// values that are variables, and an atom into a nullable string list
print(fromVars("b", "w"))
// @log 3
// @log b
// @log true
// @log b
// @log true
// @log false
// @log true
// @log b
// @log b
// @log y
// @log true
// @log b
// @log 12
// @log false
// @log b
// @log z
// @log true
// @log b
// @log a
// @log n
// @log true
// @log b
// @log w
// @log 6
// @log a
// @log b
// @log 3
// @log 3
// @log bwb
