// @run
// @log 1
// @log 2
// The SAME orphaned-`TypeRef` defect as `maps/union-arm-nullable-i32-map-field.vl`, one rung
// family over, and STRICTLY WORSE — this one cannot be masked.
//
// `nodeTyArrayElemRepName(i)` answers `""` for a node the arena has no type for, so an orphaned
// field `TypeRef` falls past the `"f64"` rung, past its `"i64"` twin, and into the chain's
// `nameIsArray(nd.tyName)` rung below, where `checkArrName("f64[]")` REJECTS:
//
//     emitProgram: only i32[] arrays and struct/union element arrays are supported
//
// A module-wide MINTING flag can be set by any other declaration in the file, which is what let
// the map version hide. A CHAIN MIS-ROUTE cannot: the rejection is about this node, so declaring
// another `f64[]` elsewhere does not help. Both rungs now carry a name fallback for the
// uncovered case.
//
// The `f32[]` rung is untouched and needs no fallback — it was never converted to the arena.
type B = { g: f64[] } | f64
type C = { g: i64[] } | f64

const x: B = 1.5
if x is f64 { print(1) } else { print(101) }
const y: C = 2.5
if y is f64 { print(2) } else { print(102) }
