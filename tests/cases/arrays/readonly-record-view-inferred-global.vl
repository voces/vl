// @run
// @log 1
// @log 2
// @log 3
// D3093: an un-annotated module-scope list of record literals delivered as `readonly Shape[]`
// is built at the destination's row, and a later write reads that same row.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function rd(r: readonly Shape[]) { return r.length }
const l = [{ r: 1 }]
print(rd(l))
l.push({ r: 2 })
print(rd(l))
l.push({ r: 3 })
print(l.length)
