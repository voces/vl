// @run
// @log 1.5
// @log 2.5
// @log 97.5
// @log 7
// @log 3
// @hint redundant type annotation: `a` is inferred as `f64[]`
// @hint redundant type annotation: `firstF32` is inferred as `f32`
// @hint redundant type annotation: `s` is inferred as `string[]`
// A scalar array whose ELEMENT carries redundant grouping parens — `(f64)[]`, `(f32)[]`,
// `(i64)[]`, `(string)[]`. Each denotes exactly its unparenthesized spelling.
//
// THIS FIXTURE PINS THE PREMISE OF A DOCUMENTED DECLINE, and that is its whole job.
// `emit_base`'s scalar-array classifiers ask `arrElemNameRaw(name) == "f64"` — the array
// grammar's RAW trailing-`[]` cut plus a leaf-name compare, which is exactly equivalent to
// the whole-spelling `name == "f64[]"` they replaced. The obvious widening is to use
// `listElemNameOf` instead (the same cut PLUS one naive grouping-paren strip), which would
// additionally accept a `(f64)[]` spelling at the classifier.
//
// That widening was DECLINED because its divergence population is empty: the parenthesized
// element is already peeled well before any of those classifiers is asked, so the shapes
// below lower correctly WITHOUT the wider cut. A 0 over an empty population is the absence
// of a witness, not agreement — so the faithful cut ships (D-SHAPEFIELD precedent).
//
// Nothing in the corpus recorded that premise, which is how a filed rationale goes stale
// silently. If a future slice widens these classifiers, or if the paren peel moves, this
// file is the witness that says what was true when the decline was written. It passes on
// master too — that is the point: it records a measured fact, it does not assert a change.

const a: (f64)[] = [1.5, 2.5]
print(a[0]) // 1.5
print(a[1]) // 2.5

// The same peel in a PARAMETER position.
function firstF32(xs: (f32)[]): f32 { return xs[0] }
print(firstF32([97.5, 8.5])) // 97.5

// And in a RETURN position, over the i64 backing.
function mkI64(): (i64)[] { return [7, 8] }
print(mkI64()[0]) // 7

// The string-ref list rides the same rule.
const s: (string)[] = ["abc"]
print(s[0].length) // 3
