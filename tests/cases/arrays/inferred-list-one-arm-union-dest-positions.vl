// @run
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// The four OTHER destination forms `letRefListDestSlot` reads, one per way the language
// spells "this list flows there" (silent-class-inventory D381). Each was check-clean
// invalid wasm before the rung and none is reachable from the binding form the row filed:
// a module-scope binding takes the GLOBAL cell's seeds, a list-of-lists literal hands the
// annotation's INNER slot, a map store reads the destination map's annotation, and a call
// argument reads the callee's parameter. The return-annotation form is the fifth and it is
// the one `f4` covers.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq

// (a) at MODULE scope — the global cell's own seed sites, which are a second pair
const lv1g = [{ r: 7 }]
const cg: Shape[] = lv1g
if cg.length > 0 {
  const e0g = cg[0]
  if e0g is Circle { print(e0g.r) } else { print(0) }
} else {
  print(0)
}

// (b) an element of a list-of-lists literal
function f2() {
  const lv1 = [{ r: 7 }]
  const c: Shape[][] = [lv1]
  if c.length > 0 {
    const g1 = c[0]
    if g1.length > 0 {
      const e0 = g1[0]
      if e0 is Circle { print(e0.r) } else { print(0) }
    } else {
      print(0)
    }
  } else {
    print(0)
  }
}

// (c) a store into a declared map of lists
function f3() {
  const lv1 = [{ r: 7 }]
  const c: {[string]: Shape[]} = Map()
  c["k0"] = lv1
  const g0 = (c)["k0"] ?? []
  if g0.length > 0 {
    const e0 = g0[0]
    if e0 is Circle { print(e0.r) } else { print(0) }
  } else {
    print(0)
  }
}

// (d) a call argument, and (e) a return annotation
function take(c: Shape[]) {
  if c.length > 0 {
    const e0 = c[0]
    if e0 is Circle { print(e0.r) } else { print(0) }
  } else {
    print(0)
  }
}
function mk(): Shape[] {
  const lv1 = [{ r: 7 }]
  return lv1
}
function f4() {
  const lv1 = [{ r: 7 }]
  take(lv1)
  take(mk())
}

f2()
f3()
f4()
