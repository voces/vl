// @check
// @error cannot assign {x: i32 | null} to 'k' of type K
// Inside `is K[]` over a record-list arm the value keeps its own type beside `K[]`: a `W` record
// is not held as a `K`, so an element read at `K` is refused rather than misread (D16989).
type W = { x: i32 | null }
type K = { x: i32 }
const a: W[] = [{ x: 1 }, { x: 2 }]
const q: W[] | K[] = a
if q is K[] { const k: K = q[0]; print(k.x) }
