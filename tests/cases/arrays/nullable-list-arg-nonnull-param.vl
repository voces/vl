// @run
// A NARROWED nullable LIST / MAP argument needs `ref.as_non_null` at the CALL BOUNDARY.
//
// Narrowing is type-level: after `if e != null`, the value on the stack still has the
// `(ref null $wrapper)` slot its declaration gave it. A `(ref $wrapper)` param does not
// accept that, so `emitCall` has to recover the non-null ref at the boundary — which it
// did for exactly one rep, the STRUCT (`cParamStruct` + `exprNullableStruct`). Every
// wrapper rep beside it pushed the nullable ref straight through: `vl check` rc 0, then
// `type mismatch: expected (ref $type), found (ref null $type)`.
//
// This is a CONSUMER-side gap, not a narrowing one — it failed identically in the
// `if`-statement spelling and in a `&&` right operand, which is what tells it apart from
// the short-circuit narrowing hole. Both spellings are exercised below.
//
// `string | null` and `S | null` are the rows that already worked and are kept as the
// oracle. The checker proved every call here guarded, so the recover can never trap.
//
// @log i32 sc true
// @log i32 st true
// @log i32 null false
// @log bool sc true
// @log bool st true
// @log bool null false
// @log f64 sc true
// @log f64 st true
// @log f64 null false
// @log i64 sc true
// @log i64 st true
// @log i64 null false
// @log str[] sc true
// @log str[] st true
// @log str[] null false
// @log ref[] sc true
// @log ref[] st true
// @log ref[] null false
// @log map sc true
// @log map st true
// @log map null false
// @log str sc true
// @log str st true
// @log str null false
// @log struct sc true
// @log struct st true
// @log struct null false

type S = { v: i32 }

function takesI32Arr(x: i32[]) { return x }
function takesBoolArr(x: boolean[]) { return x }
function takesF64Arr(x: f64[]) { return x }
function takesI64Arr(x: i64[]) { return x }
function takesStrArr(x: string[]) { return x }
function takesRefArr(x: S[]) { return x }
function takesMap(x: {[string]: i32}) { return x }
function takesStr(x: string) { return x }
function takesS(x: S) { return x }

function scI32(e: i32[] | null) { return e != null && takesI32Arr(e).length > 0 }
function stI32(e: i32[] | null) {
  if e != null { return takesI32Arr(e).length > 0 }
  return false
}

function scBool(e: boolean[] | null) {
  return e != null && takesBoolArr(e).length > 0
}
function stBool(e: boolean[] | null) {
  if e != null { return takesBoolArr(e).length > 0 }
  return false
}

function scF64(e: f64[] | null) { return e != null && takesF64Arr(e).length > 0 }
function stF64(e: f64[] | null) {
  if e != null { return takesF64Arr(e).length > 0 }
  return false
}

function scI64(e: i64[] | null) { return e != null && takesI64Arr(e).length > 0 }
function stI64(e: i64[] | null) {
  if e != null { return takesI64Arr(e).length > 0 }
  return false
}

function scStrArr(e: string[] | null) {
  return e != null && takesStrArr(e).length > 0
}
function stStrArr(e: string[] | null) {
  if e != null { return takesStrArr(e).length > 0 }
  return false
}

function scRefArr(e: S[] | null) { return e != null && takesRefArr(e).length > 0 }
function stRefArr(e: S[] | null) {
  if e != null { return takesRefArr(e).length > 0 }
  return false
}

function scMap(e: {[string]: i32} | null) {
  return e != null && (takesMap(e)["a"] ?? 0) > 0
}
function stMap(e: {[string]: i32} | null) {
  if e != null { return (takesMap(e)["a"] ?? 0) > 0 }
  return false
}

function scStr(e: string | null) { return e != null && takesStr(e).length > 0 }
function stStr(e: string | null) {
  if e != null { return takesStr(e).length > 0 }
  return false
}

function scStruct(e: S | null) { return e != null && takesS(e).v > 0 }
function stStruct(e: S | null) {
  if e != null { return takesS(e).v > 0 }
  return false
}

function mkMap() {
  const m: {[string]: i32} = Map()
  m["a"] = 1
  return m
}

function say(tag: string, v: boolean) {
  print(tag + " " + toString(v))
  0
}

say("i32 sc", scI32([1, 2]))
say("i32 st", stI32([1, 2]))
say("i32 null", scI32(null))
say("bool sc", scBool([true]))
say("bool st", stBool([true]))
say("bool null", scBool(null))
say("f64 sc", scF64([1.0]))
say("f64 st", stF64([1.0]))
say("f64 null", scF64(null))
say("i64 sc", scI64([5000000000, 2]))
say("i64 st", stI64([5000000000, 2]))
say("i64 null", scI64(null))
say("str[] sc", scStrArr(["a"]))
say("str[] st", stStrArr(["a"]))
say("str[] null", scStrArr(null))
say("ref[] sc", scRefArr([{ v: 1 }]))
say("ref[] st", stRefArr([{ v: 1 }]))
say("ref[] null", scRefArr(null))
say("map sc", scMap(mkMap()))
say("map st", stMap(mkMap()))
say("map null", scMap(null))
say("str sc", scStr("ab"))
say("str st", stStr("ab"))
say("str null", scStr(null))
say("struct sc", scStruct({ v: 5 }))
say("struct st", stStruct({ v: 5 }))
say("struct null", scStruct(null))
