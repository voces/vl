// @run
// @hint redundant type annotation: `h` is inferred as `i32[]` — remove it to lean on inference
// @hint redundant type annotation: `h1` is inferred as `i32[]` — remove it to lean on inference
// @hint redundant type annotation: `s` is inferred as `string[]` — remove it to lean on inference
// @hint redundant type annotation: `bs` is inferred as `{v: i32}[]` — remove it to lean on inference
// @hint redundant type annotation: `ns` is inferred as `(string | null)[]` — remove it to lean on inference
// @hint redundant type annotation: `us` is inferred as `(i32 | string)[]` — remove it to lean on inference
// @hint redundant type annotation: `cs` is inferred as `i32[]` — remove it to lean on inference
// @hint redundant type annotation: `g` is inferred as `i32[]` — remove it to lean on inference
// @hint redundant type annotation: `geth` is inferred as `i32[]` — remove it to lean on inference
// @log 1,2,
// @log 1,9,
// @log a,b,
// @log 1,
// @log a
// @log null
// @log 1
// @log b
// @log 1,2,3,
// @log 1,2,
// @log 1
// @log a
// A `.filter` keeps the value its callback tested: the element is read once per step, so a
// write to the source inside the callback reaches only the elements read after it. The same
// over a scalar, string, record, niche and union list, a named or closure-value callback, a
// view of the source and a generic receiver (D3060).
const h: i32[] = [1, 2]
let out = ""
for e in h.filter((e) => {
  h[0] = 9
  return e > 0
}) { out = out + "\{e}," }
print(out)

const h1: i32[] = [1, 2]
let out1 = ""
for e in h1.filter((e) => {
  h1[1] = 9
  return e > 0
}) {
  out1 = out1 + "\{e},"
}
print(out1)

const s: string[] = ["a", "b"]
let outS = ""
for e in s.filter((e) => {
  s[0] = "z"
  return e != ""
}) {
  outS = outS + e + ","
}
print(outS)

type B = { v: i32 }
const bs: B[] = [{ v: 1 }]
let outB = ""
for e in bs.filter((e) => {
  bs[0] = { v: 9 }
  return e.v > 0
}) {
  outB = outB + "\{e.v},"
}
print(outB)

const ns: (string | null)[] = ["a", null]
for e in ns.filter((e) => {
  ns[0] = "z"
  return e != "q"
}) { print(e) }

const us: (i32 | string)[] = [1, "b"]
for e in us.filter((e) => {
  us[0] = "z"
  return e != 7
}) { print(e) }

const cs: i32[] = [1, 2, 3]
const keep: (i32) => boolean = (e) => {
  cs[0] = 9
  return e < 5
}
let outC = ""
for e in cs.filter(keep) { outC = outC + "\{e}," }
print(outC)

const g: i32[] = [1, 2]
function geth(): i32[] { return g }
const gy = geth()
const gv: readonly i64[] = gy
let outV = ""
for e in gv.filter((e) => {
  g[0] = 9
  return e > 0
}) {
  outV = outV + "\{e},"
}
print(outV)

function firstKept<T>(xs: T[], z: T): T {
  return xs.filter((e) => {
    xs[0] = z
    return e == e
  })[0]
}
print(firstKept([1, 2], 9))
print(firstKept(["a", "b"], "z"))
