// @check
// @error the literal 300 does not fit a `u8` element (0..255)
// @error the literal 256 does not fit a `u8` element (0..255)
// @error the literal 0x1FF does not fit a `u8` element (0..255)
// @error the literal -1 does not fit a `u8` element (0..255)
// THE OUT-OF-RANGE LITERAL RULE, and the half of it that is an ERROR.
//
// A `u8` slot is one byte and `array.set` truncates to the low 8 bits — measured, not
// assumed: storing 300 reads back as 44. For a COMPUTED value that truncation is the
// documented behaviour (`u8-packed-list.vl` exercises it), the same kind of documented
// narrowing `5.7 as i32` → `5` is, and a runtime range check on every element store is
// not payable in a hot path.
//
// A hand-written LITERAL is different: it has a known value, there is no computation for
// the truncation to be the point of, and 300 silently becoming 44 is a typo the compiler
// can see. So the literal is rejected and the computed value is not.
//
// The check is on the LEXEME's value, radix prefixes and `_` separators included, and
// saturates rather than folding — a 400-digit literal costs three digits of work.
//
// A NEGATED literal (`-1`) is refused the same way (owner ruling, D3428): it is a value the
// compiler can see and no `u8` holds it. `-1 as% u8` is the spelling of the all-ones byte.
const a: u8[] = [1, 300]
const b: u8[] = [0, 0]
b[0] = 256
b[1] = 0x1FF
const ok: u8[] = [0, 255, 0xFF, 0b1111_1111]
ok[0] = -1
ok[1] = -1 as% u8
print(a.length + b.length + ok.length)
