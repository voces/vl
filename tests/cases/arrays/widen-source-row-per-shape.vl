// @run
// @log 1
// @log 8
// @log 1
// @log 1
// @hint redundant type annotation: `h` is inferred as `{xs: {r: i32}[]}` — remove it to lean on inference
// @hint redundant type annotation: `outer` is inferred as `{r: i32}[][]` — remove it to lean on inference
// Both annotations are DECLARED redundant, not deleted: `Circle[]` / `Circle[][]` is what
// makes the element the union ARM, and inference gives the anonymous shape — a different
// element heap, and the one this file is not about.
// Regression (silent-class-inventory D794).
//
// A ref-list widening (`const b: Shape[] = <source>`) read its SOURCE row from the cell, and
// only three cell shapes could answer: a declared local, a global, a parameter. A CALL
// RESULT, a FIELD READ and an INDEXED READ each fell through to -1 and the widening emitted
// a module the engine rejects — with nothing in the program writing anything.
//
// THE NARROW ANSWER SET WAS DELIBERATE AND THE OBVIOUS WIDENING IS STILL WRONG. Answering
// from the element NAME — `refListSlotOfExprStrict`, the spelling — was built and measured
// during D791 and lost 105 `runs` cells in the distilled corpus, because a cell can hold a
// value built at a different row than its name suggests: a shadowed global whose cell is a
// DESTINATION's row, a literal already built at the destination. Widening a value that is
// not where the spelling says produces the very `expected (ref null $type), found (ref
// $type)` the rung exists to remove.
//
// SO EACH SHAPE READS ITS OWN TABLE, which is the discipline the row prescribed and the only
// reason this is safe:
//
//   call result  → the callee's `fRetRArrElem` (its return ANNOTATION is what its own emit
//                  was typed from, so the callee cannot disagree with itself)
//   field read   → the struct table's `sFieldElemTyIxAt` / `sFieldElemNameAt`, the same pair
//                  the field's storage slot was minted from
//   indexed read → the OUTER list's element slot: `outer[0]` holds whatever `outer`'s
//                  backing was minted to hold
//
// Measured on the branch: 0 `runs` lost, 0 cells moved to silent, across all 255,504 census
// cells the distilled corpus stands for.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq

// 1 — CALL RESULT, the row's own witness
function mk(): Circle[] { return [{ r: 7 }] }
function fromCall() {
  const b: Shape[] = mk()
  print(b.length)
}
fromCall()

// 2 — call result, READ BACK through the widened destination. A widening that produced the
// right length and the wrong element rep would pass the line above and fail here.
function mk2(): Circle[] { return [{ r: 7 }, { r: 8 }] }
function fromCallRead() {
  const b: Shape[] = mk2()
  const e = b[1]
  if e is Circle { print(e.r) }
}
fromCallRead()

// 3 — FIELD READ
type Holder = { xs: Circle[] }
function fromField() {
  const h: Holder = { xs: [{ r: 7 }] }
  const b: Shape[] = h.xs
  print(b.length)
}
fromField()

// 4 — INDEXED READ
function fromIndex() {
  const outer: Circle[][] = [[{ r: 7 }]]
  const b: Shape[] = outer[0]
  print(b.length)
}
fromIndex()
