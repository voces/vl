// @run
// @log 2
// @log 8
// @log 99
// @log 3
// @log 255
// @log 1
// `u8[] | i32` — the MIXED value union, whose two arms are both value atoms.
//
// This shape failed DIFFERENTLY from `u8[] | <struct>` and for a second reason: the union
// HAS a value atom, so `emitUnionCoerce` reached its classification ladder — and the
// ladder had no `u8[]` arm. A packed list fell past `exprStringArray` / `exprF32Array` /
// `exprF64Array` / `exprI64Array` / `exprArray` to the numeric DEFAULT (`cak = 0`, "i32")
// and the wrapper REF was pushed into the i32 value box: `vl check` rc 0,
// "type mismatch: expected i32, found (ref $type)".
//
// The `u8[]` arm is checked ABOVE the generic array arm for the same reason `f32[]`
// precedes `f64[]`: a `u8[]` ELEMENT reads as an i32 everywhere (`array.get_u` widens it),
// so `exprArray` would claim the value and tag the box `i32[]` over a one-byte backing — a
// silently WRONG tag rather than a loud one.
function f(k: i32): u8[] | i32 {
  if k == 0 {
    const inner: u8[] = [7, 8]
    return inner
  }
  99
}

const listArm = f(0)
if listArm is u8[] {
  print(listArm.length)
  print(listArm[1])
} else {
  print(-1)
}

const intArm = f(1)
if intArm is i32 { print(intArm) } else { print(-2) }

// ── a BARE LITERAL into the box builds the PACKED backing ────────────────────
// The checker pins `[1, 2, 255]` to the union's only array arm, so the box is TAGGED
// `u8[]` — but `emitArr` picks a backing from the ELEMENTS, and three small ints read as
// an i32 list. Without the build kind threaded (`pendingListKind = 10`) the box carried an
// i32-list wrapper under the packed tag: `vl check` rc 0, VALID wasm, and the narrowed
// read's `ref.cast $bl8` TRAPPED at run time — the worst cell in this family, because it
// is the one a validator cannot see.
const lit: u8[] | i32 = [1, 2, 255]
if lit is u8[] {
  print(lit.length)
  print(lit[2]) // 255, not -1 — a narrowed read is still `array.get_u`
} else {
  print(-3)
}

// ── a THREE-member union carrying `null` still boxes ─────────────────────────
// Only the TWO-member `u8[] | null` is the niche rep this slice does not build
// (`error-u8-nullable-union-unsupported.vl` pins that refusal); a multi-member union with
// a `null` member is an ordinary box whose null rides a tag.
function q(k: i32): u8[] | i32 | null {
  const pk: u8[] = [3, 4]
  if k == 0 { return pk }
  if k == 1 { return 5 }
  null
}
const nullArm = q(2)
if nullArm == null { print(1) } else { print(-4) }
