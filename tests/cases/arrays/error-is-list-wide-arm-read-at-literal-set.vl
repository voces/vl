// @error cannot assign i32 to 'k' of type K
// Inside `is K[]` over a `u8[]` arm the value keeps its own type beside `K[]`: a `u8` list is not
// held as a `K[]`, so an element read at `K` is refused rather than misread (D16970).
type K = 1 | 2
const a: u8[] = [1, 2]
const q: u8[] | K[] = a
if q is K[] {
  const k: K = q[1]
  print(k)
}
