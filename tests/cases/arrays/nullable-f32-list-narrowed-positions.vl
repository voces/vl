// @run
// @log 2
// @log 1.25
// @log 2
// @log 1
// @log 2
// @log 2
// @log 2
// @log 1.25
// @log 1.25
// @log 2
// @log 2
// @log 2
// @log 2
// @log 1
// @hint redundant type annotation: `v` is inferred as `f32[] | null` — remove it to lean on inference
// @hint redundant type annotation: `v` is inferred as `f32[] | null` — remove it to lean on inference
// @hint redundant type annotation: `gv` is inferred as `f32[] | null` — remove it to lean on inference
// @hint redundant type annotation: `a` is inferred as `f32[] | null` — remove it to lean on inference
// @hint redundant type annotation: `w` is inferred as `{f: f32[] | null}` — remove it to lean on inference
// @hint redundant type annotation: `xs` is inferred as `(f32[] | null)[]` — remove it to lean on inference
// @hint redundant type annotation: `v` is inferred as `f32[] | null` — remove it to lean on inference
// A NARROWED `f32[] | null` read, at every position the silent-class sweep grids — and every
// one of them was a LOUD EMIT REJECT (`field access but no struct type declared`, or
// `field access receiver is not a struct`) until D14 closed. The `f64[] | null` twin of each
// line below has always run; that asymmetry, 174 cells wide, WAS the defect.
//
// THE ANNOTATIONS ARE KEPT AND THEIR HINTS DECLARED. Each one is the position under test —
// deleting it to silence the linter would delete the case.
//
// WHY IT WAS ONLY f32. `exprF64Array` opens with `tyIsF64Array(nodeTyIxOf(exprIx))` — it trusts
// the type the checker RECORDED, which on a read inside `if v != null` is the narrowed, non-null
// `f64[]`. The f32 twin had no working form of that test: `tyKindOf` deliberately carries no
// f32-array kind (a float LITERAL types f64, so a kind-based claim would mis-classify a
// literal-built f64 list), so `exprF32Array`'s every rung asked a NAME instead — and an
// `f32[] | null` name declares `"nulf32list"`, which none of those rungs accepts. The narrowed
// read therefore fell past the whole list ladder to the struct-field floor.
//
// The arena CAN answer, structurally (`TyArray` -> `TyPrim "f32"`), and that test is now on
// `exprF32Array`'s IDENT and MEMBER arms. Not at the top of the function, which was measured
// and is wrong twice over — see `unions/f32-list-union-member.vl` (an `ArrayLit` whose recorded
// union arm is not what it BUILDS: `wasm trap: cast failure`) and
// `nested-array-inferred-empty-unsupported-leaf.vl` (an `Index` whose rep comes from the
// container's interned row: a pinned loud decline turns into invalid wasm).
//
// NOT covered here because they are NOT f32-specific — the `f64[] | null` twin declines
// identically and the sweep grades both the same: a `capture`d nullable list, a `loopvar`, and
// a map whose VALUE TYPE is the nullable list (`unsupported map value type`).

function mk(): f32[] | null { return [1.25, 2.25] }

// const_local — the filed D14 repro's own shape.
function constLocal() {
  const v: f32[] | null = mk()
  if v != null { print(v.length) } else { print("NUL") }
  if v != null { print(v[0]) } else { print("NUL") }
}
constLocal()

// let_local — the same binding at the mutable storage class, `== null`-else form, and the
// re-assigned-to-null control that proves the narrowing is doing the work.
function letLocal() {
  let v: f32[] | null = mk()
  if v == null { print("NUL") } else { print(v.length) }
  v = null
  if v == null { print(1) } else { print(v.length) }
}
letLocal()

// param — the narrowed read inside the callee's own body, via `is`.
function paramPos(v: f32[] | null) {
  if v is f32[] { print(v.length) } else { print("NUL") }
}
paramPos([9.5, 8.5])

// global — narrowed at a module-level name, read from inside a function.
const gv: f32[] | null = mk()
function globalPos() {
  if gv != null { print(gv.length) } else { print("NUL") }
}
globalPos()

// callres — the value arrives from a call, into an annotated and an inferred binding. (An
// inferred nullable-list RETURN is a separate, still-open codegen decline, which is why `mk`
// and `retAnn` are annotated; the sweep's `ret_unann` axis is the un-annotated BINDING.)
function retAnn(): f32[] | null { return mk() }
function callPos() {
  const a: f32[] | null = retAnn()
  if a != null { print(a.length) } else { print("NUL") }
  const b = retAnn()
  if b != null { print(b[0]) } else { print("NUL") }
}
callPos()

// field, and field_place (`w.f` narrowed IN PLACE, with no copy into a local).
type Wrap = { f: (f32[] | null) }
function fieldPos() {
  const w: Wrap = { f: mk() }
  const v = w.f
  if v != null { print(v[0]) } else { print("NUL") }
  if w.f != null { print(w.f.length) } else { print("NUL") }
}
fieldPos()

// elem — the nullable list as an array ELEMENT, narrowed after the index read.
function elemPos() {
  const xs: (f32[] | null)[] = [mk()]
  const v = xs[0]
  if v != null { print(v.length) } else { print("NUL") }
}
elemPos()

// mapget — a map READ is nullable even over a plain `f32[]`-valued map.
function mapGet() {
  const mm: {[string]: f32[]} = Map()
  mm["kk"] = [1.25, 2.25]
  const v = mm["kk"]
  if v != null { print(v.length) } else { print("NUL") }
}
mapGet()

// The list OPERATIONS over a narrowed binding, not just `.length` / `[i]`.
function ops() {
  const v: f32[] | null = mk()
  if v != null {
    print(v.map((z) => z).length)
    print(v.filter((z) => z > 2.0).length)
  } else {
    print("NUL")
  }
}
ops()
