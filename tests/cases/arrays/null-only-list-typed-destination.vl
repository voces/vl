// A list literal of only `null` takes its element type from a typed destination: an annotated
// binding, a typed parameter, an annotated return, a record field, a nested literal under an
// annotation and a store all run (D1832). A non-null element types the literal itself.
type K = { k: i32 }
type H = { items: (K | null)[] }
function len(xs: (i32 | null)[]) { return xs.length }
function mk(): (string | null)[] { return [null] }
const e: (i32 | null)[] = [null]
const h: H = { items: [null] }
const c: (K | null)[][] = [[null]]
const s: (i32 | null)[][] = [[1]]
s[0] = [null]
print(e.length)
print(len([null]))
print(mk().length)
print(h.items.length)
print(c[0].length)
print(s[0].length)
const m = [null, 42]
const r = [42, null]
print(m.length + r.length)
