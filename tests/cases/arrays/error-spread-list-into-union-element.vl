// @check
// @error-at 6:29 i32[] is not f64[] | string[]: this join would hold both, and a container never widens implicitly. Its elements would be stored differently, so it would be a copy, and a write through either list would not reach the other. Build it as `(f64[] | string[])[]`
// A spread's element list is compared with the member of a union element it fits, as it is
// with a single list element: `i32[]` beside `f64[] | string[]` is refused like `i32[]`
// beside `f64[]`, not delivered into the `f64[]` member (D14083).
function three(p: f64[][], s: string[][], q: i32[][]) {
  const xs = [...p, ...s, ...q]
  print(xs.length)
}
three([[1.5]], [["x"]], [[6, 7]])
