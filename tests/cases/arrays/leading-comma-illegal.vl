// @check
// @error expected an expression but found COMMA
// @error expected `,` but found `1`
// A leading comma in an array literal (`[,1]`) is still a syntax error: the
// trailing-comma relaxation only permits ONE comma immediately before `]`. The
// leading comma derails the literal — it is consumed as a failed expression,
// leaving `1` where a separator belongs, which the list's own separator recovery
// then reports and inserts. Two diagnostics, no cascade past the `]`. (The first
// is a LOSSY recovery — the comma is dropped — so this file is not typechecked.)
let a = [, 1]
