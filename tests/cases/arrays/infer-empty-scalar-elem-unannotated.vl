// @run
// @log 2.5
// @log 2.5
// @log -1.5
// @log 1
// @log 6000000000
// @log s
// @log s
// @log ab
// @log 3.5
// D1569 — an INFERRED-empty list whose ELEMENT the checker pinned to a NON-i32 SCALAR, with no
// `f64[]` / `i64[]` / `string[]` SPELLING ANYWHERE in the module. `collectA`'s empty-literal
// arm rescued three REF element kinds (a registered union, a nested array, a shape) and no
// scalar one, so nothing minted the wrapper/backing pair and `emitArr` refused the threaded
// kind: "f64 array literal but f64 list type not collected", on a `vl check`-clean program
// whose `const xs: f64[] = []` face ran. One non-empty `[2.0]` literal anywhere made it pass,
// so this file must never spell one.
const xs = []
xs.push(1.5)
print(xs[0] + 1.0)
print(1.0 + xs[0])
print(-xs[0])
print(xs.length)

// An i64 element — the same hole, its own wrapper pair.
const bigs = []
bigs.push(6000000000)
print(bigs[0])

// A string element pushed as a LITERAL (the one spelling a syntax test in the same pass
// already covered) and as a VARIABLE / an expression (the two it could not see).
const strs = []
strs.push("s")
print(strs[0])
const s = "s"
const vars = []
vars.push(s)
print(vars[0])
const exprs = []
exprs.push("a" + "b")
print(exprs[0])

// An index STORE as the pin instead of a push, inside a function scope.
function stored() {
  const ys = []
  ys.push(0.5)
  ys[0] = 2.5
  print(ys[0] + 1.0)
}
stored()
