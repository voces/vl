// @hint redundant type annotation: `s5` is inferred as `{count: i32, symbol: i32}[]`
// @hint redundant type annotation: `s6` is inferred as `i32[][]`
// D1605 — the element-type grid for one generic `T[]` constructor over `__array_new__`.
//
// Every pin below shares ONE `filled` body, so each instance has to resolve its own
// ref-list row. Reading the row off the first-interned element instead is what this row
// closed, and a grid is the shape that catches it: the defect is invisible with a single
// pin and appears at the second one whose element differs.
//
// `back()` repeats the same elements in the opposite order, which is the control — that
// order ran before this row because the clamp landed on the right row by luck, and it
// must keep running.
type Node = { count: i32, symbol: i32 }
type Box = { xs: i32[] }
type Shape = { r: i32 } | { w: i32, h: i32 }

function filled<T>(n: i32, v: T): T[] { return __array_new__(n, v) }

function forth() {
  const a1: Node[] = filled(2, { count: 0, symbol: 11 })
  const a2: i32[][] = filled(2, [12])
  const a3: string[][] = filled(2, ["s3"])
  const a4: Node[][] = filled(2, [{ count: 0, symbol: 14 }])
  const a5: boolean[][] = filled(2, [true])
  const a6: i32[][][] = filled(2, [[16]])
  const a7: Box[] = filled(2, { xs: [17] })
  const a8: { p: i32 }[] = filled(2, { p: 18 })
  const a9: Shape[] = filled(2, { r: 19 })
  const a10: Node[][][] = filled(2, [[{ count: 0, symbol: 20 }]])
  print(a1[1].symbol)
  print(a2[1][0])
  print(a3[1][0])
  print(a4[1][0].symbol)
  print(a5[1][0])
  print(a6[1][0][0])
  print(a7[1].xs[0])
  print(a8[1].p)
  print(a9.length)
  print(a10[1][0][0].symbol)
}

function back() {
  const b10: Node[][][] = filled(2, [[{ count: 0, symbol: 20 }]])
  const b9: Shape[] = filled(2, { r: 19 })
  const b8: { p: i32 }[] = filled(2, { p: 18 })
  const b7: Box[] = filled(2, { xs: [17] })
  const b6: i32[][][] = filled(2, [[16]])
  const b5: boolean[][] = filled(2, [true])
  const b4: Node[][] = filled(2, [{ count: 0, symbol: 14 }])
  const b3: string[][] = filled(2, ["s3"])
  const b2: i32[][] = filled(2, [12])
  const b1: Node[] = filled(2, { count: 0, symbol: 11 })
  print(b10[1][0][0].symbol)
  print(b9.length)
  print(b8[1].p)
  print(b7[1].xs[0])
  print(b6[1][0][0])
  print(b5[1][0])
  print(b4[1][0].symbol)
  print(b3[1][0])
  print(b2[1][0])
  print(b1[1].symbol)
}

// The map and nullable elements, kept apart from the two ordered blocks so a change to
// either block does not have to renumber them.
function maps() {
  const m1: {[string]: i32} = Map()
  m1["k"] = 31
  const c1: {[string]: i32}[] = filled(2, m1)
  const m2: {[string]: string} = Map()
  m2["k"] = "s32"
  const c2: {[string]: string}[] = filled(2, m2)
  const m3: {[i32]: i32} = Map()
  m3[1] = 33
  const c3: {[i32]: i32}[] = filled(2, m3)
  const c4: {[string]: i32}[][] = filled(2, [m1])
  const c5: (i32[] | null)[] = filled(2, [35])
  const c6: ({[string]: i32} | null)[] = filled(2, m1)
  const c7: Node[] = filled(2, { count: 0, symbol: 37 })
  print(c1[1]["k"])
  print(c2[1]["k"])
  print(c3[1][1])
  print(c4[1][0]["k"])
  print(c5.length)
  print(c6.length)
  print(c7[1].symbol)
}

// Scalar elements share the module with the ref ones: a scalar pin mints no ref row, so
// this block is the negative half of the grid.
function scalars() {
  const s1: i32[] = filled(2, 41)
  const s2: string[] = filled(2, "s42")
  const s3: f64[] = filled(2, 4.5)
  const s4: boolean[] = filled(2, true)
  const s5: Node[] = filled(2, { count: 0, symbol: 45 })
  const s6: i32[][] = filled(2, [46])
  print(s1[1])
  print(s2[1])
  print(s3[1])
  print(s4[1])
  print(s5[1].symbol)
  print(s6[1][0])
}

forth()
back()
maps()
scalars()
