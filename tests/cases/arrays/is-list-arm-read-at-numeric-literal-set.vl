// Inside `is K[]` over a list arm stored apart from `K[]` (`u8[]`, `i64[]`, `f64[]`), an element
// reads as a `K`, converted from the arm's own rep, at module scope and in a function (D17001).
type K = 1 | 2
const a: u8[] = [1, 2]
const q: u8[] | K[] = a
if q is K[] { print(q[1]) }
function g(r: i64[] | f64[] | u8[] | K[]) {
  if r is K[] { return r[1] }
  return -1
}
const b: i64[] = [1, 2]
print(g(b))
const c = [2.0, 1.0]
print(g(c))
const d: K[] = [1, 2]
print(g(d))
const e = [2.5, 1.0]
print(g(e))
// @log 2
// @log 2
// @log 1
// @log 2
// @log -1
