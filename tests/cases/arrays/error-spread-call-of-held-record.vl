// @check
// @error {x: i32} is not {x: f64}
// A call whose list literal holds a record another binding holds is not fresh: a copy would fork
// the record, so a later write through `r` would not reach `v` (D16954).
const r = { x: 1 }
function mk() { return [r] }
const v: { x: f64 }[] = [...mk()]
r.x = 5
print(v[0].x)
