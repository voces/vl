// @run
// @log 2.75
// @log 2.75
// @log 2
// @log 2
// An anonymous record's list slot is keyed by the record type it was minted at: a spread into
// a wider join, and a record list beside a string list in a list of lists.
const v = [...[{ a: 1 }], { a: 2.5 }]
print(v[0].a / 4.0 + v[1].a)
const w = [...[{ a: 1 }], ...[{ a: 2.5 }]]
print(w[0].a / 4.0 + w[1].a)
const a = ["a"]
const b = [{ x: 1 }]
const z = [a, b]
print(z.length)
const n = [["a"], [{ x: 1 }]]
print(n.length)
