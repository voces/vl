// @run
// An ARRAY LITERAL whose elements are f32-typed VALUES is an f32 list, and says so
// WITHOUT an annotation to thread the kind through.
//
// The axis is the ELEMENT REP, and it is a per-rep ladder with one arm missing. The
// literal family `arrLitIsStr` / `arrLitIsF64` / `arrLitIsI64` had no f32 member at all,
// so `exprF32Array` had no `ArrayLit` case while both its scalar-list siblings did, the
// collection scanner had no f32 arm beside its f64/i64 ones, and `emitArrLit`'s f32 path
// was reachable only from a threaded annotation (`pendingListKind == 7`). A `[fv]`
// literal therefore fell past every list arm to the i32 catch-all: an i32 backing under
// f32 elements, `vl check` clean, "type mismatch: expected i32, found f32".
//
// WHAT MOVES: only the element rep. `i32`, `i64`, `f64`, `string` and `boolean` literals
// were correct at every position measured; `f32` failed at every one of them — an
// annotated local, a parameter, a global, a call result, a struct-field read, in a
// 1- and a 2-element literal, and at both a `T[]` and a `T` generic parameter. The
// argument SPELLING and the literal LENGTH were the dimensions the filing held fixed and
// neither of them moves.
//
// NOT CLAIMED, and the asymmetry is deliberate: the two siblings claim on ANY element of
// their leaf, this one requires EVERY element to be `exprIsF32`. A MIXED literal is not
// an f32 list at all but a checker-level union (`[fv, 1]` types `(f32 | i32)[]`), and a
// bare `[1.5]` is f64 because a float LITERAL is not `exprIsF32` — so the annotation
// stays the only route from `[1.5]` to an f32 list, and every mixed spelling keeps the
// answer it had.
//
// Values are pinned through `f32bits`, not the rendered float: an i32-backed list that
// happened to validate would still have to arrive as the f32 bit pattern, and the f32 and
// f64 encodings of the same number are different integers. `.map` over such a list is
// the one cell this file cannot carry — `f32bits` is not callable in a module that holds
// a function value — and it has its own file beside this one.
// @hint redundant type annotation: `ys` is inferred as `f32[]`
// @hint redundant type annotation: `count` is inferred as `i32`
type W = { f: f32 }
function first<T>(xs: T[]): T { return xs[0] }
function count<T>(xs: T[]): i32 { return xs.length }
function gid<T>(x: T): T { return x }
function src(): f32 { return 1.5 }

const ga: f32 = 1.5
// A module GLOBAL whose initialiser is the literal — `globalKind`'s ladder.
const gs = [ga]
// @log 1069547520
print(f32bits(gs[0]))

// ── the INFERRED local binding, which had no annotation to thread a kind ──────
function locals() {
  const a: f32 = 1.5
  const xs = [a]
  // @log 1069547520
  print(f32bits(xs[0]))
  // @log 1
  print(xs.length)
  // Two elements, and the annotated twin that always worked.
  const ys: f32[] = [a, a]
  // @log 1069547520
  print(f32bits(ys[1]))
  const zs = [a, a]
  // @log 2
  print(zs.length)
  // `.push` onto an inferred f32 list, and a `for`-in over a bare literal.
  zs.push(a)
  // @log 3
  print(zs.length)
  for v in [a] {
    // @log 1069547520
    print(f32bits(v))
  }
}
locals()

// ── the ELEMENT SPELLINGS, all flat ───────────────────────────────────────────
function spellings(p: f32) {
  // a PARAMETER element
  // @log 1069547520
  print(f32bits(first([p])))
  // a GLOBAL element
  // @log 1069547520
  print(f32bits(first([ga])))
  // a CALL-result element
  // @log 1069547520
  print(f32bits(first([src()])))
  // a struct-FIELD element
  const w: W = { f: 1.5 }
  // @log 1069547520
  print(f32bits(first([w.f])))
}
spellings(1.5)

// ── the GENERIC parameter shapes ──────────────────────────────────────────────
function generics() {
  const a: f32 = 1.5
  // `T[]` with `T` in the result
  // @log 1069547520
  print(f32bits(first([a])))
  // `T[]` with an i32 result — `T` reaches parameter position only
  // @log 2
  print(count([a, a]))
  // `T` bound to the WHOLE list
  // @log 1
  print(gid([a]).length)
}
generics()

// ── CONTROLS: the reps that were already correct, and the spellings not claimed ─
function controls() {
  const a: f32 = 1.5
  // A bare float literal stays f64 — the f32 list is never reached without an f32 VALUE.
  // @log 4609434218613702656
  print(f64bits(first([1.5])))
  // i32 / i64 / string / boolean element literals, unchanged.
  // @log 7
  print(first([7]))
  // @log 5
  print(first([5 as i64]))
  // @log aa
  print(first(["aa"]))
  // @log true
  print(first([true]))
  // A DIFFERENT list annotation is authoritative over an f32 element: the value
  // promotes into the f64 backing rather than the binding adopting the element's rep.
  const ds: f64[] = [a]
  // @log 4609434218613702656
  print(f64bits(ds[0]))
  // The MIXED spellings, each driven by its annotation exactly as before.
  const mi: f32[] = [a, 1]
  // @log 1065353216
  print(f32bits(mi[1]))
  const mf: f32[] = [a, 2.5]
  // @log 1075838976
  print(f32bits(mf[1]))
}
controls()
