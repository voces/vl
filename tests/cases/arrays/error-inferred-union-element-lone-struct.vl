// @emit-error struct array elements are not supported
// THE NEIGHBOUR THAT IS NOT THIS FAMILY, pinned so the boundary is a fixture rather than a
// claim. `const xs = [c, d]` over two declared struct types RUNS now
// (`inferred-union-element-literal.vl`); `const cs = [c]` over ONE still rejects, exactly as
// it did on the parent, and the difference is not arbitrary.
//
// A ONE-MEMBER SET IS NO UNION. The fix that made `[c, d]` work registers the checker's
// recorded ELEMENT UNION so `arrLitIsRef`'s union rung can claim the literal. `[c]`'s
// recorded element is a plain `TyObj` — there is no union to record and no union rung to
// reach — so it falls to the classifier that was already there: `arrLitIsRef` asks whether
// the FIRST ELEMENT is an object literal, and `c` is an IDENT. The literal takes the i32
// list and the struct ref hits its floor.
//
// SO THIS IS THE SAME SHAPE OF DEFECT WITH A DIFFERENT MISSING PIECE — a kind-1 struct list
// that no first-element syntax probe can see — and closing it means teaching `arrLitIsRef`
// to read a bare struct element off the arena, which is a separate slice with its own kind,
// its own hint column and its own grid. Left open deliberately; the reject is loud.
//
// BOTH ADJACENT SPELLINGS ALREADY RUN, which is what bounds the gap to this one cell:
//     const cs: C[] = [c]        // the annotation, on the parent and here
//     const cs = [{ m: 1 }]      // the object LITERAL, claimed by `e0 is ObjLit`
// @hint redundant type annotation: `c` is inferred as `{m: i32}`
type C = { m: i32 }

const c: C = { m: 1 }

function loneStructIdent() {
  const cs = [c]
  print(cs[0].m)
}
loneStructIdent()
