// @run
// @log pl022 1
// @log else 1
// @log then 9
// @log f64 1
// @log match 2
// @log nested 1
// @log outer 1
// @log generic 1
// @log union-str 0
// @log union-ref 0
// @log union-nul 0
// @log union-call 0
// @log bind 3
// @hint redundant type annotation: `ps` is inferred as `{x: i32}[]`
// An empty `[]` is built at the type it flows into (D2209). In a value `if` or `match` that
// is the join, so the empty arm takes its sibling arm's element type in either order; in an
// outer list it is its sibling elements'; in a generic body it is the instance's; into a union
// it is the list arm the checker adopted it as (D2202). `bind` is an un-annotated binding of a
// ref-list `if`, which no rung classified as a list at all (D2210).
import { toString } from "std:fmt"

type P = { x: i32 }
type B = { base: i32, length: i32 }

function falsy() { 1 == 2 }
function truthy() { 1 == 1 }

const TABLE = [["a", "b"], ["c"]]
function pick(k: i32) {
  const ms = if k >= 0 { TABLE[k] } else { [] }
  ms.length
}
print("pl022 " + toString(pick(1)))

const ps: P[] = [{ x: 1 }, { x: 2 }]

function elseArm() {
  const r = if falsy() { ps } else { [] }
  r.push({ x: 7 })
  print("else " + toString(r.length))
}
elseArm()

function thenArm() {
  const r = if truthy() { [] } else { ps }
  r.push({ x: 8 })
  print("then " + toString(r.length + r[0].x))
}
thenArm()

function floats() {
  const fs = [1.5, 2.5]
  const r = if truthy() { [] } else { fs }
  r.push(0.5)
  print("f64 " + toString(r.length))
}
floats()

function matchArm(k: i32) {
  const r = match k { 1 => [], _ => ps }
  r.length
}
print("match " + toString(matchArm(2)))

function nestedIf(k: i32) {
  const r = if k == 0 { ["a"] } else if k == 1 { ["b", "c"] } else { [] }
  r.push("d")
  r.length
}
print("nested " + toString(nestedIf(5)))

function outer() {
  const xs = [[], ["a"]]
  print("outer " + toString(xs[0].length + xs[1].length))
}
outer()

function gtail<T>(xs: T[]) { if falsy() { xs } else { [] } }
function generic() {
  const r = gtail(["q"])
  r.push("x")
  print("generic " + toString(r.length))
}
generic()

function sinkStr(data: string[] | B) {
  if data is B { return 1000 }
  data.length
}
print("union-str " + toString(sinkStr([])))

function sinkRef(data: P[] | B) {
  if data is B { return 1000 }
  data.length
}
print("union-ref " + toString(sinkRef([])))

function sinkNul(data: (string | null)[] | B) {
  if data is B { return 1000 }
  data.length
}
print("union-nul " + toString(sinkNul([])))

function none() { return [] }
function unionCall() {
  const v: P[] | B = none()
  if v is B { print("union-call B") } else { print("union-call " + toString(v.length)) }
}
unionCall()

function bind() {
  const v = if falsy() { ps } else { ps }
  v.push({ x: 3 })
  print("bind " + toString(v.length))
}
bind()
