// @run
// @log true
// @log false
// @log true
// @log true
// @log true
// @log false
// @log 2
// @log w
// @log k
// `is K[]` over a record-list arm stored apart from `K[]` answers by its records: every record a
// `K` by its fields, or no record, fits (D16989).
type W = { x: i32 | null }
type K = { x: i32 }
const a: W[] = [{ x: 1 }, { x: 2 }]
const q: W[] | K[] = a
print(q is K[])
const b: W[] = [{ x: 1 }, { x: null }]
const r: W[] | K[] = b
print(r is K[])
const c: W[] = []
const s: W[] | K[] = c
print(s is K[])
const k: K[] = [{ x: 5 }]
const t: W[] | K[] = k
print(t is K[])
type V = { tag: string, n: i32 }
type L = { tag: "a" | "b", n: i32 }
const d: V[] = [{ tag: "a", n: 1 }, { tag: "b", n: 2 }]
const u: V[] | L[] = d
print(u is L[])
const e: V[] = [{ tag: "a", n: 1 }, { tag: "z", n: 2 }]
const v: V[] | L[] = e
print(v is L[])
if q is K[] { print(q.length) }
match r {
  K[] => print("k")
  _ => print("w")
}
match q {
  K[] => print("k")
  _ => print("w")
}
