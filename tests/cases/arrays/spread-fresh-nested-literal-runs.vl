// @run
// @log 0.5
// @log 6
// @log 0.25
// @log 2.75
// @log 0.5
// @log 0.5
// @log 1.5
// A spread of a fresh nested list literal is built at its destination's element type, as the
// literal would be without the spread (D4871), annotated or joined beside a wider source
// (D4874). A record element, a paren, a third level and a returned literal take it the same way.
function ret(): f64[][] { return [...[[1, 2]]] }

const v1: f64[][] = [...[[1, 2]]]
print(v1[0][1] / 4.0)
const v2 = [...[[1, 2]], ...[[3.5]]]
print(v2[0][1] / 4.0 + v2[1][0] + v2.length)
const r1: {a: f64}[] = [...[{ a: 1 }]]
print(r1[0].a / 4.0)
const r2: {a: f64}[] = [...[{ a: 1 }], ...[{ a: 2.5 }]]
print(r2[0].a / 4.0 + r2[1].a)
const p: f64[][] = [...([[1, 2]])]
print(p[0][1] / 4.0)
print(ret()[0][1] / 4.0)
const t: f64[][][] = [...[[[3, 6]]]]
print(t[0][0][1] / 4.0)
