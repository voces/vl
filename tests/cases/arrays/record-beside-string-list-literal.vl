// @run
// @log 2
// @log s
// @log 2
// A list literal whose first element is a record and whose element type is a union with a
// member that is no record (`[{ v: 2 }, "s"]`) is the union's box list (D2727). The first
// element alone decided a record list before, and the string was stored into it. No annotation
// in this file spells the union, since one that did would register its box row by itself.
function f() {
  const x = [{ v: 2 }, "s"]
  for y in x {
    if y is string { print(y) } else { print(y.v) }
  }
}
f()
print([{ v: 2 }, "s"].length)
