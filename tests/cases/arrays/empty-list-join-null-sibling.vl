// @run
// @log if-local false
// @log if-annotated false
// @log if-push 1
// @log match-local false
// @log match-annotated true
// @log argument false
// An empty `[]` arm beside a bare `null` arm decides the join's rep itself: the `null` has no
// element to lend, and taking the join from it built an i32 blocktype over a list (D2209).
import { toString } from "std:fmt"

function t() { 1 == 1 }
function one() { 1 }

function ifLocal() {
  const x = if t() { [] } else { null }
  print("if-local " + toString(x == null))
}
ifLocal()

function ifAnnotated() {
  const x: i32[] | null = if t() { [] } else { null }
  print("if-annotated " + toString(x == null))
}
ifAnnotated()

function ifPush() {
  const x = if t() { [] } else { null }
  if x != null {
    x.push(4)
    print("if-push " + toString(x.length))
  }
}
ifPush()

function matchLocal() {
  const x = match one() {
    1 => []
    _ => null
  }
  print("match-local " + toString(x == null))
}
matchLocal()

function matchAnnotated() {
  const x: string[] | null = match one() {
    2 => []
    _ => null
  }
  print("match-annotated " + toString(x == null))
}
matchAnnotated()

function take(a: f64[] | null) { print("argument " + toString(a == null)) }
take(if t() { [] } else { null })
