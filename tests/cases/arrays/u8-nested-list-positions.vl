// @run
// @log 2
// @log 2
// @log 255
// @log 3
// @log 200
// @log 4
// @log 4
// @log 2
// @log 4
// @log 9
// @log 2
// @log 5
// @log 4
// @hint redundant type annotation: `take` is inferred as `i32` — remove it to lean on inference
// Every annotation below is kept AGAINST its own hint: each one pins the REP the
// fixture is about, and a hint saying the annotation is redundant is the checker
// agreeing about the TYPE — it says nothing about whether the two spellings agree
// about the rep.
// D1241: `u8[][]` had no rep at ANY value — the DECLARATION alone refused, with no method
// involved. `refArrShapeKind` knew four distinct-backing 2-D leaves (string / f64 / i64 /
// f32) and not the fifth, so `nameIsRefArray` answered false and `checkArrName` rejected.
// Kind 11 is that leaf: the element is the `$bl8` wrapper over the packed i8 backing.
//
// `refArrElemName` IS THE SITE A KIND ALONE DOES NOT COVER. With the shape arm in and the
// slot-key arm out, `nameIsRefArray` said yes and the row interned under the WRONG key at
// kind 4 — an i32-list element under a `u8[]` read, check-clean invalid wasm where the
// refusal had been loud.
//
// EVERY CELL PRINTS A BYTE, and 255 is the one that matters: `array.get_u` zero-extends, so
// a sign-extending read would print -1.

const xs: u8[][] = [[1, 2], [200, 255, 3]]
print(xs.length)
print(xs[0].length)
print(xs[1][1])
print(xs[1][2])

const row = xs[1]
print(row[0])
row.push(7)
print(row.length)
print(xs[1].length)

for r in xs {
  print(r.length)
}

const e: u8[][] = []
e.push([9, 8])
print(e[0][0])

function take(g: u8[][]): i32 { g[0][1] }
print(take(xs))

function mk(): u8[][] { [[4, 5]] }
print(mk()[0][1])

const p = xs.pop()
if p != null { print(p.length) } else { print(0) }
