// @check
// @error the inner lists may be written through another binding, which a copy would not see; a nested view is not built yet (D16950)
// An inner list another binding holds and writes would leave a copy stale, so the readonly list
// of lists is refused until a nested view is built.
const x: i32[] = [1, 2]
const a: i32[][] = [x]
const v: readonly (readonly f64[])[] = a
x.push(3)
print(v[0].length)
