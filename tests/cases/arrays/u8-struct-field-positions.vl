// @run
// @log 3
// @log 3
// @log 9
// @log 2
// @log 3
// @log 6
// @log 3
// @log 3
// @log 2
// @log 2
// @hint redundant type annotation: `blen` is inferred as `i32` — remove it to lean on inference
// THE POSITION MATRIX for the `u8[]` struct field (silent-class-inventory D1008).
//
// Lifting a capability gate converts a loud refusal into silent invalid wasm at every
// delivery that was not wired (D965), so the field code is graded here by READING VALUES
// BACK at each position rather than by compiling. Every line below would still compile if
// the field had been coded to the wrong backing; none of them would print the right number.
// A one-byte backing is especially unforgiving of the wrong wrapper, which is what makes
// `255` in the generic-alias fixture and `9` after an element write load-bearing.
//
// The two positions NOT here are struct equality — `a == b` over a `u8[]` field refuses,
// exactly as it does over an `f64[]`, `i64[]` or `string[]` field. That is a pre-existing
// gap spanning four of the five scalar-list field codes (only `i32[]` has an equality arm)
// and it is filed separately; it is not a `u8[]` fact.
type Cur = { buf: u8[], pos: i32 }
type Outer = { c: Cur }

// 1 — construct, then length off the wrapper
const c1: Cur = { buf: [1, 2, 3], pos: 0 }
print(c1.buf.length)

// 2 — element read
print(c1.buf[2])

// 3 — element WRITE, read back
const c3: Cur = { buf: [1, 2, 3], pos: 0 }
c3.buf[0] = 9
print(c3.buf[0])

// 4 — whole-FIELD write
const c4: Cur = { buf: [1, 2, 3], pos: 0 }
c4.buf = [4, 5]
print(c4.buf.length)

// 5 — the field as an ARGUMENT
function blen(b: u8[]): i32 { b.length }
print(blen(c1.buf))

// 6 — for-in over the field
let sum = 0
for b in c1.buf { sum = sum + b }
print(sum)

// 7 — the field as a RETURN
function bufOf(c: Cur): u8[] { c.buf }
print(bufOf(c1).length)

// 8 — nested struct field
const o: Outer = { c: { buf: [1, 2, 3], pos: 0 } }
print(o.c.buf.length)

// 9 — inside a FUNCTION body (the scope split that bit D1013 and D1019)
function inFn() {
  const c: Cur = { buf: [1, 2], pos: 0 }
  print(c.buf.length)
}
inFn()

// 10 — an element of a ref list of the struct
const xs: Cur[] = [{ buf: [1, 2], pos: 0 }]
print(xs[0].buf.length)
