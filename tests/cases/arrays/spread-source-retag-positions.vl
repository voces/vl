// @run
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// @log 2
// @log b
// @log 3
// @log t
// @log 1
// @log 1
// @log 1
// @log 1
// @log 4
// @log n1
// @log 1
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// A list holding a generic function, spread into a generic instance's list of closures at its own
// type: the source list is the literal's, apart only in a hole, copied raw (D16695). Q58 sweep of
// the spread literal: a list and a union argument, a nested argument, a return, a binding, an `if`
// arm, a `??` operand and a record field (at one instance: the second traps, D17580); its length
// at concat and interpolation.
import { toString } from "std:fmt"

function id<T>(x: T): T { return x }
function n<T>(fs: ((x: T) => T)[]) { return fs.length }
function nU<T>(fs: ((x: T) => T)[] | string) {
  return if fs is string { -1 } else { fs.length }
}
function pass<T>(fs: ((x: T) => T)[]) { return fs }
function pArg<T>(_x: T) {
  const src = [id]
  print(n<T>([...src]))
}
function pUnion<T>(_x: T) {
  const src = [id]
  print(nU<T>([...src]))
}
function pNested<T>(_x: T) {
  const src = [id]
  const fs: ((x: T) => T)[] = pass<T>([...src])
  print(n<T>(fs))
}
function pRet<T>(_x: T): ((x: T) => T)[] {
  const src = [id]
  return [...src]
}
function pLet<T>(x: T) {
  const src = [id]
  const fs: ((x: T) => T)[] = [...src]
  print(fs[0](x))
}
function pIf<T>(_x: T, c: boolean) {
  const src = [id]
  const e: ((x: T) => T)[] = []
  const fs: ((x: T) => T)[] = if c { [...src] } else { e }
  print(fs.length)
}
function pCoal<T>(_x: T, o: ((x: T) => T)[] | null) {
  const src = [id]
  const fs: ((x: T) => T)[] = o ?? [...src]
  print(fs.length)
}
function pField<T>(x: T) {
  const src = [id]
  const r: { fs: ((x: T) => T)[] } = { fs: [...src] }
  print(r.fs[0](x))
  print("n" + toString(r.fs.length))
  print("\{r.fs.length}")
}
pArg(1)
pArg("s")
pUnion(1)
pUnion("s")
pNested(1)
pNested("s")
print(pRet(1)[0](2))
print(pRet("a")[0]("b"))
pLet(3)
pLet("t")
pIf(1, true)
pIf("s", true)
pCoal(1, null)
pCoal("s", null)
pField(4)
