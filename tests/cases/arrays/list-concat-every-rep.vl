// @run
// @hint redundant type annotation: `c` is inferred as `{r: i32}` — remove it to lean on inference
// @hint redundant type annotation: `na` is inferred as `{r: i32}[][]` — remove it to lean on inference
// @hint redundant type annotation: `nb` is inferred as `{r: i32}[][]` — remove it to lean on inference
// @hint redundant type annotation: `ma` is inferred as `{[string]: i32}[][]` — remove it to lean on inference
// @hint redundant type annotation: `mb` is inferred as `{[string]: i32}[][]` — remove it to lean on inference
// THE ACCEPT SET of `silent-class-inventory` D721, READ BACK BY VALUE.
//
// `a + b` over two lists used to be `emitListConcatI` AND NOTHING ELSE — one core, hard-wired
// to the i32 backing (`$lTypeIdx` over `$aTypeIdx`). Every other rep was refused at `vl check`
// with `` `+` over X has no lowering ``, a sentence that concedes the program is type-valid
// and is therefore a clause-2 violation of the standing goal rather than a rule.
//
// A CONCAT INSPECTS NO ELEMENT, which is why one lowering covers every rep where the compare
// side needs a core per element: `emitListConcatG` allocates one backing of `lenA + lenB` and
// moves storage with two `array.copy`s, so all it needs of a list is its `{backing, len, cap}`
// wrapper heap type and its backing heap type. Every list rep in the language has both.
//
// WHY THE VALUES AND NOT JUST THE LENGTH. A lowering that allocates the right length and
// copies the wrong storage passes a `.length` check exactly as the correct one does, and the
// packed `u8` backing and the f64/i64 wide scalars are the three most likely to be wrong that
// way. Every element of every concatenation below is read back and printed.
//
// THE SECOND SPELLING IS `.length` STRAIGHT OFF THE `+`, which is a different question and
// was a second gap: the six non-i32 `expr*Array` classifiers had no concat arm, so a member
// read on the `+` expression reached no classifier and failed at the member floor — and for a
// ref list it was WORSE than a refusal, because `refListSlotOfExpr` CLAMPS an unresolved
// element name to slot 0 and slot 0 is a real row. `(a + b).length` over a `Circle[][]` read
// another row's wrapper and wrote invalid wasm, while the same line over `Circle[]` passed for
// the single reason that slot 0 happened to be the right row.
//
// THE ANNOTATIONS ARE ONLY WHERE INFERENCE WOULD NAME A DIFFERENT TYPE — `i64[]` (whose
// literals infer `i32[]`), the two literal unions and the union-arm list. Elsewhere the
// element comes from a constructor function (`mkc` / `mkm`) so the list is the NAMED rep with
// no annotation to be redundant: a ref list's (wrapper, backing) pair is keyed by its element
// NAME, so a fixture that annotated its way to `Circle[]` and one that infers it are not
// guaranteed to be the same row, and the inferred spelling is the one a user writes.

type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type K = "a" | "b"
type N = 1 | 2
type F = 1.5 | 2.5
type CM = {[string]: i32}

function mkc(r: i32) {
  const c: Circle = { r: r }
  return c
}

function mkm(v: i32) {
  const m: CM = Map()
  m["k"] = v
  return m
}

// ── the i32 list, unchanged and byte-identical: it still rides `emitListConcatI` ──────
// @log 1
// @log 2
// @log 3
function i32List() {
  const a = [1, 2]
  const b = [3]
  const c = a + b
  let i = 0
  while i < c.length {
    print(c[i])
    i = i + 1
  }
}

// ── the string list ───────────────────────────────────────────────────────────────────
// @log p
// @log q
// @log r
function stringList() {
  const a = ["p", "q"]
  const b = ["r"]
  const c = a + b
  let i = 0
  while i < c.length {
    print(c[i])
    i = i + 1
  }
}

// ── the three WIDE-SCALAR siblings of the i32 pair, each with its own backing ─────────
// @log 1.5
// @log 2.5
// @log 3.5
function f64List() {
  const a = [1.5, 2.5]
  const b = [3.5]
  const c = a + b
  let i = 0
  while i < c.length {
    print(c[i])
    i = i + 1
  }
}

// @log 1
// @log 2
// @log 3
function i64List() {
  const a: i64[] = [1, 2]
  const b: i64[] = [3]
  const c = a + b
  let i = 0
  while i < c.length {
    print(c[i])
    i = i + 1
  }
}

// THE PACKED ONE. `u8[]`'s backing is `(array (mut i8))`, so a read is `array.get_u` and a
// copy moves bytes; a concat that had reached for the i32 backing would be invalid wasm
// rather than a wrong value, and one that read with `array.get` would not validate at all.
// @log 97
// @log 98
// @log 99
function u8List() {
  const a = "ab".bytes()
  const b = "c".bytes()
  const c = a + b
  let i = 0
  while i < c.length {
    print(c[i])
    i = i + 1
  }
}

// ── the REF lists, whose (wrapper, backing) pair is keyed by an interned SLOT ─────────
// @log 1
// @log 2
// @log 3
function structList() {
  const a = [mkc(1), mkc(2)]
  const b = [mkc(3)]
  const c = a + b
  let i = 0
  while i < c.length {
    print(c[i].r)
    i = i + 1
  }
}

// @log 1
// @log 2
// @log 1
function nestedI32List() {
  const a = [[1], [2, 9]]
  const b = [[3]]
  const c = a + b
  let i = 0
  while i < c.length {
    print(c[i].length)
    i = i + 1
  }
}

// @log 1
// @log 1
// @log 1
function tripleNestedI32List() {
  const a = [[[1]], [[2, 9]]]
  const b = [[[3]]]
  const c = a + b
  let i = 0
  while i < c.length {
    print(c[i].length)
    i = i + 1
  }
}

// @log 1
// @log 2
// @log 1
function nestedStringList() {
  const a = [["x"], ["y", "z"]]
  const b = [["w"]]
  const c = a + b
  let i = 0
  while i < c.length {
    print(c[i].length)
    i = i + 1
  }
}

// @log 1
// @log 7
function mapList() {
  const a = [mkm(7)]
  const b = [mkm(8)]
  const c = a + b
  print(c.length - 1)
  print(c[0]["k"] ?? 0)
}

// @log 2
function unionArmList() {
  const a: Shape[] = [{ r: 1 }]
  const b: Shape[] = [{ s: 2 }]
  const c = a + b
  print(c.length)
}

// ── the literal-union element reps, which rep as their BASE scalar ────────────────────
// @log a
// @log b
// @log a
function strLitUnionList() {
  const a: K[] = ["a", "b"]
  const b: K[] = ["a"]
  const c = a + b
  let i = 0
  while i < c.length {
    print(c[i])
    i = i + 1
  }
}

// @log 1.5
// @log 2.5
// @log 1.5
function f64LitUnionList() {
  const a: F[] = [1.5, 2.5]
  const b: F[] = [1.5]
  const c = a + b
  let i = 0
  while i < c.length {
    print(c[i])
    i = i + 1
  }
}

// ── `.length` STRAIGHT OFF THE `+`, at the five reps where an unresolved ref-list slot
//    clamped to slot 0 and wrote invalid wasm ──────────────────────────────────────────
// @log 2
// @log 2
// @log 2
// @log 2
// @log 2
function inlineLength() {
  const ca = [mkc(1)]
  const cb = [mkc(2)]
  // THE TWO NESTED REF LISTS ARE ANNOTATED AND THE OTHERS ARE NOT, and the reason is a
  // DIFFERENT gap: `const na = [mkcl(1)]`, where `mkcl` returns a `Circle[]`, is
  // `emitProgram: nested arrays are not supported` — a list literal whose element is a
  // ref-list-returning CALL. Unrelated to concat, unmoved by D721, and not this fixture's
  // to pin; the annotated literal spelling reaches the same rep and builds.
  print((ca + cb).length)
  const na: Circle[][] = [[{ r: 1 }]]
  const nb: Circle[][] = [[{ r: 2 }]]
  print((na + nb).length)
  const ta = [[[1]]]
  const tb = [[[2]]]
  print((ta + tb).length)
  const sa = [["x"]]
  const sb = [["y"]]
  print((sa + sb).length)
  const ma: CM[][] = [[mkm(1)]]
  const mb: CM[][] = [[mkm(2)]]
  print((ma + mb).length)
}

i32List()
stringList()
f64List()
i64List()
u8List()
structList()
nestedI32List()
tripleNestedI32List()
nestedStringList()
mapList()
unionArmList()
strLitUnionList()
f64LitUnionList()
inlineLength()
