// @run
// @log 22
// @log 21
// @log 12
// @log 22
// @log 11
// @log 22
// @log 12
// @log 11
// @log 22
// Inside `is K[]` over a box of list arms, an element write stores through the arm the box holds,
// in each position: a literal, a parameter, a call's value and a call's index, in a loop, in a
// nested `if` and through a global box; each write is read back.
type K = 1 | 2
function mk(c: boolean): u8[] | K[] {
  const a: u8[] = [1, 2]
  const b: K[] = [2, 1]
  if c { return a }
  return b
}
function one(): K { return 1 }
function at(i: i32) { return i }
function lit(q: u8[] | K[]) {
  if q is K[] { q[0] = 2 }
  return q
}
function param(q: u8[] | K[], k: K) {
  if q is K[] { q[1] = k }
  return q
}
function call(q: u8[] | K[]) {
  if q is K[] { q[at(0)] = one() }
  return q
}
function loop(q: u8[] | K[]) {
  if q is K[] {
    for i in 0 to 1 { q[i] = 2 }
  }
  return q
}
function nested(q: u8[] | K[], c: boolean) {
  if q is K[] {
    if c { q[0] = 1 }
  }
  return q
}
function show(q: u8[] | K[]) {
  if q is u8[] { print(q[0] * 10 + q[1]) } else { print(q[0] * 10 + q[1]) }
}
show(lit(mk(true)))
show(lit(mk(false)))
show(param(mk(true), 2))
show(param(mk(false), 2))
show(call(mk(false)))
show(loop(mk(false)))
show(nested(mk(true), true))
show(nested(mk(false), true))
const g = mk(true)
if g is K[] { g[0] = 2 }
show(g)
