// @run
// @log 3
// @log 42
// A nullable record with a closure field, spelled by shape in a `filled` instance, is the
// record's nullable list beside a value union too (D3997).
import { filled } from "std:array"

type Item = { n: i32, f: (x: i32) => i32 }
const u: i32 | string = 3
print(u)
const a = filled<Item | null>(2, null)
a[0] = { n: 1, f: (x: i32) => x + 1 }
const y = a[0]
if y != null { print(y.f(41)) }
