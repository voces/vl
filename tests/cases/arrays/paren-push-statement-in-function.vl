// @run
// @log 2
// @log 3
// @log 2
// @log 2
// @log 2
// A parenthesized `.push` statement inside a function body is that call: it reserves the
// push scratch locals as the bare statement does, in a loop, an `if` arm, under two
// parentheses and over a string list (D14793).
function plain() {
  const xs = [1]
  (xs.push(2))
  print(xs.length)
}
function inLoop() {
  const xs = [1]
  let i = 0
  while i < 2 {
    (xs.push(i))
    i = i + 1
  }
  print(xs.length)
}
function inIf(c: boolean) {
  const xs = [1]
  if c { (xs.push(2)) }
  print(xs.length)
}
function twice() {
  const xs = [1]
  ((xs.push(2)))
  print(xs.length)
}
function strings() {
  const xs = ["a"]
  (xs.push("b"))
  print(xs.length)
}
plain()
inLoop()
inIf(true)
twice()
strings()
