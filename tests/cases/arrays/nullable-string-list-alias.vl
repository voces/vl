// @run
// @log narrowed 3
// @log global 2
// @log param 2
// @log map 2
// @log read a true x true 4
// @hint redundant type annotation: `gl` is inferred as `(string | null)[]`
// An un-annotated alias of a `(string | null)[]` keeps the string-list rep, whether the source
// is a narrowed call result, a global, a parameter or a narrowed map read (D2211).
import { toString } from "std:fmt"

function f(): (string | null)[] | null { ["a", null] }

function narrowed() {
  const mv = f()
  if mv != null {
    const v = mv
    v.push("x")
    print("narrowed " + toString(v.length))
  }
}
narrowed()

const gl: (string | null)[] = ["a", null]
const galias = gl
print("global " + toString(galias.length))

function param(p: (string | null)[]) {
  const v = p
  print("param " + toString(v.length))
}
param(["a", null])

function mapRead() {
  const m = Map()
  m["k"] = ["a", null]
  const mv = m["k"]
  if mv != null {
    const v = mv
    print("map " + toString(v.length))
  }
}
mapRead()

function read() {
  const mv = f()
  if mv != null {
    const v = mv
    v.push("x")
    v.push(null)
    const w = v
    print(
      "read "
        + (v[0] ?? "N")
        + " "
        + toString(v[1] == null)
        + " "
        + (v[2] ?? "N")
        + " "
        + toString(v[3] == null)
        + " "
        + toString(w.length),
    )
  }
}
read()
