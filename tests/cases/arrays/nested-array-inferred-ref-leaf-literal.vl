// @run
// @log 7
// @log 7
// @log 7
// @log 2
// @log b
// @log 7
// @hint redundant type annotation: `lv1` is inferred as `{r: i32}[]`
// The `C[]` annotation the hint names is LOAD-BEARING: leg 2's whole point is a NOMINAL leaf
// against leg 1's anonymous one, and without it the two legs are the same program.
// AN INFERRED NESTED ARRAY WHOSE LEAF IS A REF — D702, and the whole of what
// `emitProgram: nested arrays are not supported` actually refused.
//
// THE SENTENCE WAS BROADER THAN THE MISS BY A LONG WAY. `i32[][]`, `string[][]`, `f64[][]` and
// EVERY annotated nested list ran; what did not was a nested array with no declared destination
// whose inner list's LEAF sat outside a six-entry allow-list — a struct, a map, an f32, or
// another array. The allow-list was `tyNestedArrLeafSupported`, and it existed because
// `arrLitNestedElemKind` answered the row's kind from a hand-written leaf map while the
// annotation route resolves BY NAME through `refArrElemKind`; the six were where the two
// agreed. Outside them the outer list's backing was typed as the i32-list wrapper while a
// different wrapper was stored into it, so declining was the safe answer and the literal fell
// to the i32 path — whose floor is that sentence.
//
// The kind now comes from `refArrElemKind` itself, so there is no second derivation to
// disagree with, the kind-9 intern goes inner-first through `ensureRefElemTy`, and the intern
// declines only an element the ref-list layer cannot NAME.
//
// THE LEGS ARE THE SPELLINGS, because the classifier reaches them through different arms:
//   1. IDENT inner, anonymous struct leaf — the arena rung of `arrLitIsRef` (`[lv1]` where the
//      first element is neither an object literal nor a nested literal).
//   2. IDENT inner, DECLARED struct leaf — same arm, nominal element.
//   3. INLINE nested literal over a struct leaf (`[[{r: 7}]]`) — the `e0 is ArrayLit` rung
//      falls through (the inner IS a ref list) and the arena rungs of `arrLitElemKind` /
//      `arrLitElemName` key it kind 9 instead of the leaf probes' `i32[]`.
//   4. INLINE 3-deep i32 (`[[[1, 2]]]`) — the same fall-through with an ARRAY leaf; keyed flat
//      it was `type mismatch: expected (ref null $type), found (ref $type)` at load.
//   5. A string leaf, which the allow-list already covered — the control that the six keep
//      their answers.
//   6. A MAP leaf, the element kind (3) the empty-literal arm had no flag block for.
type C = { r: i32 }

function anonLeaf() {
  const lv1 = [{ r: 7 }]
  const c = [lv1]
  print(c[0][0].r)
}
anonLeaf()

function declaredLeaf() {
  const lv1: C[] = [{ r: 7 }]
  const c = [lv1]
  print(c[0][0].r)
}
declaredLeaf()

function inlineRefLeaf() {
  const c = [[{ r: 7 }]]
  print(c[0][0].r)
}
inlineRefLeaf()

function deepI32() {
  const c = [[[1, 2]]]
  print(c[0][0][1])
}
deepI32()

function stringLeaf() {
  const lv1 = ["a", "b"]
  const c = [lv1]
  print(c[0][1])
}
stringLeaf()

function mapLeaf() {
  const m: {[string]: i32} = Map()
  m["k"] = 7
  const lv1 = [m]
  const c = [lv1]
  print(c[0][0]["k"] ?? 0)
}
mapLeaf()
