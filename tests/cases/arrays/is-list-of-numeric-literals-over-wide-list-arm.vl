// @run
// @log true
// @log false
// @log true
// @log true
// @log false
// @log true
// @log 2
// `is K[]` over a `u8[]`, `i64[]` or `f64[]` arm answers by its elements: every element a member of
// `K`, or no element, fits (D16970).
type K = 1 | 2
const a: u8[] = [1, 2]
const b: u8[] = [1, 7]
const c: u8[] = []
const q: u8[] | K[] = a
const r: u8[] | K[] = b
const s: u8[] | K[] = c
print(q is K[])
print(r is K[])
print(s is K[])
const i: i64[] = [2, 1]
const ii: i64[] | K[] = i
print(ii is K[])
const f = [1.5]
const ff: f64[] | K[] = f
print(ff is K[])
const g = [2.0]
const gg: f64[] | K[] = g
print(gg is K[])
if q is K[] { print(q.length) }
