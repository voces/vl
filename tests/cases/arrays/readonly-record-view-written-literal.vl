// @run
// @hint redundant type annotation: `l` is inferred as `{r: i32}[]` — remove it to lean on inference
// @hint redundant type annotation: `m` is inferred as `{r: i32}[]` — remove it to lean on inference
// @log 1
// @log 3
// @log 2
// @log 6
// D3059: a written `const` list literal delivered as `readonly Shape[]` is a view of it, as an
// argument and stored into a module binding from a function's tail statement.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function rd(r: readonly Shape[]) {
  let t = 0
  for e in r {
    if e is Circle { t = t + e.r }
  }
  return t
}
const l: Circle[] = [{ r: 1 }]
print(rd(l))
l.push({ r: 2 })
print(rd(l))

let keep: readonly Shape[] = []
function st(x: Circle[]) { keep = x }
const m: Circle[] = [{ r: 5 }]
st(m)
m.push({ r: 6 })
print(keep.length)
const last = keep[1]
if last is Circle { print(last.r) }
