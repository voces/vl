// @run
// @hint redundant type annotation: `g` is inferred as `i32[]` — remove it to lean on inference
// @hint redundant type annotation: `get` is inferred as `i32[]` — remove it to lean on inference
// @log 3
// @log 9
// D3028: a view of a source the caller grows after the delivery, returned as `| null` and
// narrowed, still reads its length and elements through the source.
const g: i32[] = [1, 2]
function get(): i32[] { return g }
const y = get()
const r2: readonly f64[] = y
function maybe(c: boolean, v: readonly f64[]): readonly f64[] | null {
  if c { return v }
  return null
}
g.push(9)
const n = maybe(true, r2)
if n != null {
  print(n.length)
  print(n[2])
}
