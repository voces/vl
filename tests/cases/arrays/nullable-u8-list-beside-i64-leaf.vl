// @run
// @log 7
// @log 9
// @log 3
// @log 6
// @log 7.5
// @log 8.5
// @log 9
// @log 10
// A `u8[] | null` CELL BESIDE ANOTHER DISTINCT-BACKING NULLABLE LIST LEAF (D1105).
//
// `emitIndex`'s nullable-scalar-list arm picks the leaf's wrapper / backing / index-scratch
// pool from a ladder that had arms for `nuli64list` and `nulf32list` over an `f64` DEFAULT.
// The packed-byte leaf had none, so a `u8[] | null` read asked for the f64 wrapper — and in a
// module with no `f64` in it that type index is whatever the usage-gated offset formula left
// there. Beside an `i64[] | null` cell that is the i64 list wrapper, so the narrowing local
// was declared `(ref null $i64list)` while the value was the packed-byte wrapper:
// `vl check` rc 0 and a module the engine refuses.
//
// The pairing looked arbitrary — `u8[] | null` ALONE ran, and so did `u8[] | null` beside
// `string[] | null` — for the same reason: in those modules the unminted f64 index happens to
// land on the packed-byte wrapper. So the cell that grades this is the one BESIDE a numeric
// leaf, and both leaves are read, because a declaration alone does not exercise the read.
function go() {
  const x: i64[] | null = [7]
  if x != null { print(x[0]) }
  const y: u8[] | null = [9]
  if y != null { print(y[0]) }
}
go()

// The LENGTH and the INDEX-ASSIGN faces of the same cell, and a `for`-in over it: each reads
// the wrapper through a different site, so a fix that wired only the element read scores here.
function faces() {
  const a: i64[] | null = [1, 2, 3]
  if a != null { print(a.length) }
  const b: u8[] | null = [9, 10]
  if b != null {
    b[0] = 6
    print(b[0])
  }
  const c: f64[] | null = [7.5]
  if c != null { print(c[0]) }
  const d: f32[] | null = [8.5]
  if d != null { print(d[0]) }
  const e: u8[] | null = [9, 10]
  if e != null {
    for v in e { print(v) }
  }
}
faces()
