// @run
// @log 3
// @log 4
// @log 2
// @log 3.5
// Spread literals of several item groups: two sources, a source between plain elements, a run
// beside a literal source, and literal sources a join widens.
function both(a: i32[], b: i32[]) { return [...a, ...b] }
function around(a: i32[], x: i32) { return [x, ...a, x] }
function twice(x: i32) { return [x, ...[x]] }
function joined() { return [...[[1, 2]], ...[[3.5]]] }
print(both([1], [2, 3]).length)
print(around([5], 4)[2])
print(twice(7).length)
print(joined()[1][0])
