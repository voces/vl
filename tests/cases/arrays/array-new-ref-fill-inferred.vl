// @run
// @log 7
// @log 2
// @log 5
// @log 9
// @hint redundant type annotation: `s` is inferred as `i32[]`
// @hint redundant type annotation: `t` is inferred as `string[]`
// @hint redundant type annotation: `c` is inferred as `{r: i32}`
// D966 — `__array_new__` WITH A REF FILL AND NO ANNOTATION ON THE BINDING.
//
// The kind-3 arm resolves `refListSlotOfExpr(callIx)` and is generic over every ref ELEMENT,
// so widening it to closures / nested lists / string lists / maps needed no new lowering. The
// residue was the INTERN: `rlInternName(name, 1)` hardcoded kind 1, the STRUCT element, which
// was right while the arm only ran for structs. A nested-list element then got a row whose rep
// is the raw BACKING array where the annotated path carries the list WRAPPER — one wrong heap
// type, and the only difference between the two disassemblies.
//
// `ensureRefElemTy` is the type-CARRYING intern; it derives the kind from the element itself.
// Every binding below is deliberately UN-ANNOTATED, which is the ingredient.
const s: i32[] = [7]
const xs = __array_new__(3, s)
print(xs[0][0])

const t: string[] = ["a"]
const ys = __array_new__(2, t)
print(ys.length)

const m: {[string]: i32} = Map()
m["k"] = 5
const ms = __array_new__(2, m)
print(ms[1]["k"])

// The struct fill is the shape the arm always served — pinned so the widening cannot break it.
type C = { r: i32 }
const c: C = { r: 9 }
const cs = __array_new__(2, c)
print(cs[1].r)
