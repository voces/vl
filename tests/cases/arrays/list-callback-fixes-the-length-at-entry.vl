// @run
// @log 1,2,
// @log 1,
// @log 1;2;
// @log 1;2;3;
// @log 3
// @log 3
// @log 2
// @log 1|2|3|
// @hint Intentionally-unused parameter
// D3068: every list callback op reads the length once, at entry. An index the callback cuts
// off is skipped by `filter`, `reduce`, `some` and `every`, and an element it pushes is not
// visited, on a list and on a readonly view of it alike.
import { every, mapIndexed, reduce, some } from "std:array"

function sink() { [1, 2, 3] }
let h = sink()
let first = true
let out = ""
for e in h.filter((e) => {
  if first {
    first = false
    h.pop()
  }
  return e > 0
}) {
  out = out + "\{e},"
}
print(out)
h = sink()
const v: readonly i32[] = h
first = true
out = ""
for e in v.filter((_e) => {
  if first {
    first = false
    while h.length > 0 { h.pop() }
  }
  return true
}) {
  out = out + "\{e},"
}
print(out)
h = sink()
first = true
print(
  h.reduce(
    (acc: string, e) => {
      if first {
        first = false
        h.pop()
      }
      return acc + "\{e};"
    },
    "",
  ),
)
h = sink()
first = true
print(
  h.reduce(
    (acc: string, e) => {
      if first {
        first = false
        h.push(7)
      }
      return acc + "\{e};"
    },
    "",
  ),
)
h = sink()
first = true
let n = 0
print(
  if h.some((_e) => {
    if first {
      first = false
      h.push(7)
    }
    n = n + 1
    return false
  }) { -1 } else { n },
)
h = sink()
first = true
n = 0
print(
  if h.every((_e) => {
    if first {
      first = false
      h.push(7)
    }
    n = n + 1
    return true
  }) { n } else { -1 },
)
h = sink()
const w: readonly i32[] = h
first = true
n = 0
print(
  if w.some((_e) => {
    if first {
      first = false
      h.pop()
    }
    n = n + 1
    return false
  }) { -1 } else { n },
)
h = sink()
first = true
out = ""
for i in h.mapIndexed((e, _i) => {
  if first {
    first = false
    h.push(7)
  }
  return e
}) {
  out = out + "\{i}|"
}
print(out)
