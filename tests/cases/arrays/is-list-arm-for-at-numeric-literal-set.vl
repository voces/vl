// @run
// @log 13
// @log 22
// @log 13
// @log 22
// @log 13
// @log 22
// @log 13
// @log 13
// Inside `is K[]` over a list arm stored apart from `K[]`, a `for` binds each element as a `K`,
// converted from the arm's element: a `u8[]`, an `i64[]` and an `f64[]` arm, with an index, in
// a function and at module scope.
type K = 1 | 2
function kv(k: K): i32 { return k }
function mk_u8(c: boolean): u8[] | K[] {
  const a: u8[] = [1, 2]
  const b: K[] = [2, 1]
  if c { return a }
  return b
}
function go_u8(q: u8[] | K[]) {
  if q is K[] {
    let s = 0
    for x in q {
      s = s * 10 + kv(x)
    }
    for x, i in q { s = s + i }
    print(s)
  }
}
go_u8(mk_u8(true))
go_u8(mk_u8(false))
function mk_i64(c: boolean): i64[] | K[] {
  const a: i64[] = [1, 2]
  const b: K[] = [2, 1]
  if c { return a }
  return b
}
function go_i64(q: i64[] | K[]) {
  if q is K[] {
    let s = 0
    for x in q {
      s = s * 10 + kv(x)
    }
    for x, i in q { s = s + i }
    print(s)
  }
}
go_i64(mk_i64(true))
go_i64(mk_i64(false))
function mk_f64(c: boolean): f64[] | K[] {
  const a: f64[] = [1, 2]
  const b: K[] = [2, 1]
  if c { return a }
  return b
}
function go_f64(q: f64[] | K[]) {
  if q is K[] {
    let s = 0
    for x in q {
      s = s * 10 + kv(x)
    }
    for x, i in q { s = s + i }
    print(s)
  }
}
go_f64(mk_f64(true))
go_f64(mk_f64(false))
const a_i64: i64[] = [1, 2]
const q_i64: i64[] | K[] = a_i64
if q_i64 is K[] {
  let s = 0
  for x in q_i64 {
    s = s * 10 + kv(x)
  }
  for x, i in q_i64 { s = s + i }
  print(s)
}
const a_f64: f64[] = [1, 2]
const q_f64: f64[] | K[] = a_f64
if q_f64 is K[] {
  let s = 0
  for x in q_f64 {
    s = s * 10 + kv(x)
  }
  for x, i in q_f64 { s = s + i }
  print(s)
}
