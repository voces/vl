// @run
// @log 0
// @log 0
// @log 0
// @log b
// @log 0
// @log 0
// @log 2.5
// @log 1
// An empty list literal stored into a list cell, global or local, is built at the cell's list:
// a record list whose element row a binding fixes, a number list and a string list.
type J = { f: i32 | null }
function mk2() { return { f: null } }
const dA: J = mk2()
print(dA.f ?? 0)
let xs = [mk2()]
if xs.length > 0 { xs = [] }
print(xs.length)
let ns = [1, 2]
ns = []
print(ns.length)
let ss = ["a"]
ss = []
ss.push("b")
print(ss[0])
function local() {
  const dB: J = mk2()
  print(dB.f ?? 0)
  let ys = [mk2()]
  ys = []
  print(ys.length)
  let zs = [1.5]
  zs = []
  zs.push(2.5)
  print(zs[0])
}
local()
let ws = [mk2()]
ws = []
ws.push(mk2())
print(ws.length)
