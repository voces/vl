// @run
// @hint redundant type annotation: `b` is inferred as `boolean`
// @hint redundant type annotation: `v` is inferred as `i32`
// @hint redundant type annotation: `take` is inferred as `i32`
// @hint redundant type annotation: `ds` is inferred as `f64[]`
// @hint redundant type annotation: `us` is inferred as `(i32 | string)[]`
// @log 1
// @log 0
// @log 1
// @log 7
// @log 1
// @log 7
// @log 1
// @log 7
// @log 1
// @log 2
// @log 7
// AN ARRAY LITERAL WHOSE ELEMENTS JOIN TO A UNION THE DESTINATION HAS NONE OF
// (silent-class-inventory D591).
//
// `checkArrayLitNode` types a literal as the JOIN of its elements, and a join is a UNION
// wherever the elements do not widen into one another: `[0, b]` over an i32 and a boolean is
// `(i32 | boolean)[]`. `assignable((i32|boolean)[], i32[])` is therefore FALSE, and
// `assignableExpr`'s array-literal recursion accepts the literal ELEMENT-WISE instead —
// each element fits an `i32` slot on its own (`0` is an i32, `b` takes the A7
// boolean-into-i32 coercion). The BINDING types correctly as `i32[]`.
//
// WHAT WAS WRONG WAS THE REP. The literal NODE kept the joined type, `nodeArrayElemName`'s
// TyUnion arm handed the emitter the kind-2 BOX list for it, and the module built
// `(ref null $box)[]` into an `i32[]` slot: `vl check` rc 0, and the engine refusing the
// module with "type mismatch: expected i32, found (ref $type)". The fix re-stamps the
// literal's node type to the destination array on the element-wise-accepted path, keyed on
// exactly that mismatch — the join produced a union, the destination has none.
//
// THE NUMERIC PAIR IS THE CONTROL AND IT IS MEASURED, NOT ASSUMED: `joinTys(i32, f64)` is
// `f64`, not a union, so a mixed numeric literal never reaches the rule at all and the f32
// list-coercion path is provably outside its population. `bothbool` is the other control —
// a single-typed literal joins to itself.
//
// A BARE `true` IS STILL A REJECT in an `i32` slot (`isBoolLitExpr` excludes it from A7), so
// this file cannot demonstrate that here; `tests/cases/arrays/...` keeps the accepting
// spellings and the check suite keeps the refusing one.
type V = { x: i32 }
const b: boolean = true
const v: i32 = 7

// The filed witness: read at each slot.
const xs: i32[] = [0, b]
print(xs[1])
print(xs[0])

// The same join through every position the literal can sit in.
let ws: i32[] = []
ws = [b, v]
print(ws[0])
print(ws[1])

const ns: i32[][] = [[b, v]]
print(ns[0][0])
print(ns[0][1])

type Bx = { f: i32[] }
const bx: Bx = { f: [b, v] }
print(bx.f[0])
print(bx.f[1])

function take(a: i32[]): i32 { return a[0] }
print(take([b, v]))

// THE CONTROL: a numeric join is a WIDENING, not a union, so nothing here changes.
const ds: f64[] = [1, 2.5]
print(ds[1] as i32)

// THE OTHER CONTROL: a destination that IS a union keeps deciding for itself.
const us: (i32 | string)[] = [v, "s"]
const u0 = us[0]
if u0 is i32 { print(u0) } else { print(-1) }
