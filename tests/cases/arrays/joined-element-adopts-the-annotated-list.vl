// @run
// @hint redundant type annotation: `v` is inferred as `i32`
// @hint redundant type annotation: `take` is inferred as `i32`
// @hint redundant type annotation: `ds` is inferred as `f64[]`
// @hint redundant type annotation: `us` is inferred as `(i32 | string)[]`
// @log 7
// @log 0
// @log 7
// @log 0
// @log 7
// @log 0
// @log 0
// @log 7
// @log 0
// @log 2
// @log 7
// AN ARRAY LITERAL WHOSE ELEMENTS JOIN TO A UNION THE DESTINATION HAS NONE OF
// (silent-class-inventory D591).
//
// `checkArrayLitNode` types a literal as the JOIN of its elements, and a join is a UNION
// wherever the elements do not widen into one another: `[0, a]` over an i32 literal and an
// `A1` value is `(i32 | A1)[]`. `assignable((i32 | A1)[], A1[])` is therefore FALSE, and
// `assignableExpr`'s array-literal recursion accepts the literal ELEMENT-WISE instead — `0`
// is a literal adopting the brand, `a` already carries it. The BINDING types as `A1[]`.
//
// WHAT WAS WRONG WAS THE REP. The literal NODE kept the joined type and the emitter built
// the kind-2 BOX list for it into an unboxed slot: `vl check` rc 0, and the engine refusing
// the module. The fix re-stamps the literal's node type to the destination array on the
// element-wise-accepted path, keyed on exactly that mismatch — the join produced a union,
// the destination has none.
//
// THE NUMERIC PAIR IS THE CONTROL: `joinTys(i32, f64)` is `f64`, not a union, so a mixed
// numeric literal never reaches the rule at all.
type A1 = new i32
const a: A1 = 7
const v: i32 = 7

// The filed witness: read at each slot.
const xs: A1[] = [0, a]
print(xs[1] as! i32)
print(xs[0] as! i32)

// The same join through every position the literal can sit in.
let ws: A1[] = []
ws = [a, 0]
print(ws[0] as! i32)
print(ws[1] as! i32)

const ns: A1[][] = [[a, 0]]
print(ns[0][0] as! i32)
print(ns[0][1] as! i32)

type Bx = { f: A1[] }
const bx: Bx = { f: [0, a] }
print(bx.f[0] as! i32)
print(bx.f[1] as! i32)

function take(q: A1[]): i32 { return q[0] as! i32 }
print(take([0, a]))

// THE CONTROL: a numeric join is a WIDENING, not a union, so nothing here changes.
const ds: f64[] = [1, 2.5]
print(trunc(ds[1]) as! i32)

// THE OTHER CONTROL: a destination that IS a union keeps deciding for itself.
const us: (i32 | string)[] = [v, "s"]
const u0 = us[0]
if u0 is i32 { print(u0) } else { print(-1) }
