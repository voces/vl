// @log true
// @hint redundant type annotation: `bMix` is inferred as `(boolean | null)[][]` — remove it to lean on inference
// @hint redundant type annotation: `i2` is inferred as `(i32 | null)[][]` — remove it to lean on inference
// @hint redundant type annotation: `sMix` is inferred as `(string | null)[][]` — remove it to lean on inference
// @hint redundant type annotation: `st2` is inferred as `({r: i32} | null)[][]` — remove it to lean on inference
// GRADUATED from `silent-class-inventory` D117 — an ALL-`null` INNER array literal under a
// NESTED niche annotation. `const c: (K | null)[][] = [[null]]` was `vl check` rc 0 and
// `emitProgram: bare null needs a struct-typed context`; ONE non-null member changed it
// (`[["a", null]]` ran), so the axis is the ALL-`null` inner literal, not `null`-anywhere.
// Pre-existing and identical on three separate masters.
//
// THE OUTER ANNOTATION DID NOT REACH THE INNER LITERAL and the inner literal had nothing else
// to infer from. `assignableExpr`'s literal-aware adoption block records the destination array
// type on a niche-element literal — but it sits BELOW the `assignable` short-circuit, and
// `null[][]` IS covariantly assignable to `(K | null)[][]`, so the plain-assignable return
// fired and the inner `[null]` kept its self-inferred `null[]`. Every emitter probe that seeds
// a niche element (`nodeArrayElemIsNulLitUnion` / `…NulBool` / `…NulStr`) reads that recorded
// type, and the nested position threads no annotation of its own — the outer ref-list ELEMENT
// row is interned under its REP name, which folds `i32[]`, `(boolean|null)[]` and `(K|null)[]`
// onto one element kind and `string[]`/`(string|null)[]` onto another. Instrumented at the
// reject: `PLK=0 PLU=0 PNLU=0 PNB=0 PSI=-1 [rslot=0 nest=4 nul=0 nm=i32[]]` — every seed in
// the null-rep table empty, and the element row spelling the atom list `i32[]`.
//
// THE COMPLEMENT WAS ALREADY WRITTEN FOR THE SIBLING CONTAINER. `recordElemRepArrayLit` lives
// ABOVE the short-circuit for exactly this reason and already descends into an ObjLit's FIELD
// values (`{f: [null]}` against `{f: (K | null)[] | null}`, whose whole literal is likewise
// covariantly assignable). The ARRAY destination has the identical short-circuit and never
// grew the matching ELEMENT-wise descent; it does now, with the same `depth - 1` bound and the
// same `tyDeeperThan` recursion guard.
//
// IT IS THE THREE NICHES AND NOT THE BOXES, which is the discriminator worth pinning because
// it is the opposite of what the message suggests: `(i32 | null)[][]` and `(S | null)[][]` RAN
// on master. The emitter's unseeded fallback is a struct-typed null, which the BOX and struct
// shapes absorb and the atom / boolean / string-ref niches cannot.

type K = "a" | "b"
type S = { r: i32 }

// THE FILED WITNESS, verbatim.
const c: (K | null)[][] = [[null]]

// The atom niche at depth 3 — the row's own control that this is not a depth-2 special case.
const k3: (K | null)[][][] = [[[null]]]

// The INLINE literal-union spelling, which `canonEmitName` softens to `(string | null)[]`, and
// the EXPANDED member spelling, which the checker flattens into a `TyUnion` rather than a
// `TyNullable`. Both reach the atom list and neither is the `TyNullable`-element form.
const kInline: (("a" | "b") | null)[][] = [[null, "b"]]
type KN = "a" | "b" | null
const kExpand: KN[][] = [[null]]

// The i32-sentinel-2 niche (`boolean | null`) and the ref niche (`string | null`), the other
// two the fallback cannot absorb.
const b2: (boolean | null)[][] = [[null]]
const s2: (string | null)[][] = [[null]]
const bMix: (boolean | null)[][] = [[null, true]]
const sMix: (string | null)[][] = [[null, "z"]]

// THE STORAGE CLASSES. The fix is at the one seam every position flows through, so a param, a
// return and a struct field are the same question asked three more ways — all four were loud.
function viaParam(p: (K | null)[][]) { return p[0][0] == null }
function viaRet(): (K | null)[][] { return [[null]] }
type Box = { g: (K | null)[][] }
const boxed: Box = { g: [[null]] }

// THE CONTROLS THE ROW NAMES, all of which ran on master and must keep running: the two
// BOX/struct element shapes, and the MIXED inner literal whose non-null member already typed
// the inner list.
const i2: (i32 | null)[][] = [[null, 5]]
const st2: (S | null)[][] = [[null, { r: 3 }]]
const kMix: (K | null)[][] = [["a", null]]

print(c.length)
print(c[0][0] == null)
print(k3[0][0][0] == null)
print(kInline[0][0] == null)
print(kInline[0][1] == "b")
print(kExpand[0][0] == null)
print(b2[0][0] == null)
print(s2[0][0] == null)
print(bMix[0][1] == true)
print(sMix[0][1] == "z")
print(viaParam([[null]]))
print(viaRet().length + boxed.g.length)
print(i2[0][0] == null)
print(i2[0][1] == 5)
print(st2[0][0] == null)
print(kMix[0][1] == null)
