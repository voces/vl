// @log r
// A nullable list read before any narrowing (`p != null`, `p ?? q`, `p == null`) has its
// list's rep, whatever the element and whether the list is annotated, inferred or a type
// parameter's: the read, a field and an element of a list of them alike.
type A = { v: i32 }
type Box = { xs: f64[] | null }
function annI(p: i32[] | null) { print(p != null) }
function annA(p: A[] | null) { print((p ?? [{ v: 9 }])[0].v) }
function annF(p: f64[] | null) { print(p == null) }
function annS(p: string[] | null) { print((p ?? ["d"])[0]) }
function annL(p: i64[] | null) { print(p != null) }
function annG(p: f32[] | null) { print(p == null) }
annI([1])
annI(null)
annA([{ v: 4 }])
annA(null)
annF([2.5])
annS(null)
annS(["s"])
annL([7 as i64])
annG(null)
function inferred(c: boolean) {
  const i = if c { [1] } else { null }
  const a = if c { [{ v: 5 }] } else { null }
  const f = if c { [1.5] } else { null }
  const s = if c { ["t"] } else { null }
  print(i != null)
  print((a ?? [{ v: 6 }])[0].v)
  print(f == null)
  print((s ?? ["u"])[0])
}
inferred(true)
inferred(false)
function gen<T>(p: T[] | null, d: T[]): T {
  print(p != null)
  (p ?? d)[0]
}
print(gen([3], [0]))
print(gen(null, [{ v: 8 }]).v)
print(gen([0.5], [0.0]))
print(gen(null, ["g"]))
const b: Box = { xs: null }
const c: Box = { xs: [4.5] }
print(b.xs == null)
print((c.xs ?? [0.0])[0])
const rows: (string[] | null)[] = [null, ["r"]]
print(rows[0] == null)
print((rows[1] ?? ["x"])[0])
