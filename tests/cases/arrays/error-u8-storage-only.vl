// @check
// @error `u8` is a storage type, not a value type
// @error `u8` is a storage type, not a value type
// @error `u8` is a storage type, not a value type
// @error `u8` is a storage type, not a value type
// @error `u8` is a storage type, not a value type
// `u8` IS LEGAL IN EXACTLY ONE POSITION: as an ARRAY ELEMENT (`u8[]`). Every other
// position is a VALUE position, and a `u8` value would be a claim the runtime does not
// keep — an i32 at runtime with nothing enforcing 0..255. A `u8` SLOT is different: it is
// backed by one byte, the store truncates, so every read genuinely yields 0..255 and the
// claim is enforced by the storage. That is the split wasm itself makes — i8/i16 exist as
// storage types for array elements and struct fields and NOT as value types — and VL
// mirrors its substrate.
//
// Structurally, the rule is enforced by making the element position the only door: `u8`
// does not resolve as a type LEAF at all (`primTyOfName` deliberately does not answer for
// it), and the two array-annotation arms match the element SPELLING. So there is no
// context flag threaded through the annotation resolver, and no position can be taught
// half the rule.
//
// Five value positions, one message each. `u8[]` itself stays legal — the file compiles
// its way to exactly these five and no more.
function _f(_x: u8) { 0 }
function _g(): u8 { 1 }
type _R = { b: u8 }
const _m: {[string]: u8} = {}
const _n: u8 | null = null
const ok: u8[] = [1, 2]
print(ok.length)
