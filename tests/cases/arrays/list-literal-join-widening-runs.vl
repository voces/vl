// @run
// @log 0.5
// @log 0.5
// @log 0.5
// @log 0.5
// @log 0.5
// The twin of `error-list-literal-join-widening.vl` (D4861): a fresh list literal is built
// at the joined element type, a spread or a list `+` of scalars converts them as it copies,
// and an explicit `.map` copy is what the refusal offers for the rest.
function mk() { return [1, 2] }
function mf() { return [1.5] }

const nf = [[1.5]]
const a = [1, 2]
const b = [1.5]

const d1 = [mf(), [1, 2]]
print(d1[1][1] / 4.0)
const s1 = [...nf, ...[[1, 2]]]
print(s1[1][1] / 4.0)
const s2 = [...b, ...a]
print(s2[2] / 4.0)
const p1 = b + a
print(p1[2] / 4.0)
const d2 = [mf(), mk().map((x) => x as f64)]
print(d2[1][1] / 4.0)
