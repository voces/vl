// Inside `is K[]` over a list arm stored apart from `K[]`, a write through the index stores a `K`,
// converted to the arm's element: a `u8[]`, an `i64[]` and an `f64[]` arm, in a function and at
// module scope.
type K = 1 | 2

function mk_u8(c: boolean): u8[] | K[] {
  const a: u8[] = [1, 2]
  const b: K[] = [2, 1]
  if c { return a }
  return b
}
function go_u8(q: u8[] | K[]) {
  if q is K[] {
    const k: K = 1
    q[0] = 2
    q[1] = k
    print(q[0])
    print(q[1])
  }
}
go_u8(mk_u8(true))
go_u8(mk_u8(false))
const g_u8 = mk_u8(true)
if g_u8 is K[] { g_u8[1] = 2; print(g_u8[1]) }

function mk_i64(c: boolean): i64[] | K[] {
  const a: i64[] = [1, 2]
  const b: K[] = [2, 1]
  if c { return a }
  return b
}
function go_i64(q: i64[] | K[]) {
  if q is K[] {
    const k: K = 1
    q[0] = 2
    q[1] = k
    print(q[0])
    print(q[1])
  }
}
go_i64(mk_i64(true))
go_i64(mk_i64(false))
const g_i64 = mk_i64(true)
if g_i64 is K[] { g_i64[1] = 2; print(g_i64[1]) }

function mk_f64(c: boolean): f64[] | K[] {
  const a: f64[] = [1, 2]
  const b: K[] = [2, 1]
  if c { return a }
  return b
}
function go_f64(q: f64[] | K[]) {
  if q is K[] {
    const k: K = 1
    q[0] = 2
    q[1] = k
    print(q[0])
    print(q[1])
  }
}
go_f64(mk_f64(true))
go_f64(mk_f64(false))
const g_f64 = mk_f64(true)
if g_f64 is K[] { g_f64[1] = 2; print(g_f64[1]) }
