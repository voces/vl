// @check
// @error The callee hands back a list it holds, so a copy would not see later writes to it (D16954)
// A call whose function hands back a list it holds is not copied: the copy would not see a later
// write to the held records (D16954).
const ks = [{ x: 1 }]
function mk() { return ks }
const v: { x: f64 }[] = [{ x: 2.5 }, ...mk()]
ks[0].x = 5
print(v[1].x)
