// @run
// @log 7
// An UN-ANNOTATED list literal of ONE union arm, bound into a declared UNION-ELEMENT
// destination (silent-class-inventory D381). `[{ r: 7 }]` names the arm `Circle` by field
// set and the checker records `{r:i32}[]` — no union at all, so `arrLitBoxElemName` returns
// "" and D361's widening rung is never reached. The literal built the kind-1 `Circle` list
// while the `Shape[]` binding's cell is the kind-2 box list, and the two met at the store:
// `vl check` rc 0 and `expected (ref $type), found (ref $type)` at instantiation.
//
// D361's MIRROR, and no landing answers both: there the literal minted the box where the
// destination wanted the arm and is wrong standing alone; here it is RIGHT standing alone
// (`const c: Circle[] = lv1` runs, and so does the same literal with no `Shape` declared)
// and only the destination makes it wrong. `letRefListDestSlot` is the reverse lookup, and
// the slot it hands back is the one the ANNOTATED spelling `const lv1: Shape[] = […]`
// already takes — so the two spellings are one row.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function f() {
  const lv1 = [{ r: 7 }]
  const c: Shape[] = lv1
  if c.length > 0 {
    const e0 = c[0]
    if e0 is Circle { print(e0.r) } else { print(0) }
  } else {
    print(0)
  }
}
f()
