// @check
// @error The callee hands back a list it holds, so a copy would not see later writes to it (D16954)
// Two calls of a function whose literal holds a held record: the copy for the wider delivery
// would fork the record, so a write through `r` would not reach `w`.
const r = { x: 1 }
function hk() { return [r] }
const w: { x: f64 }[] = hk()
const u = hk()
r.x = 5
print(w[0].x + u.length)
