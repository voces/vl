// @run
// @log 5
// @log 3
// @log s
// @log true
// A `null` fill is typed by the destination the call is delivered to, so `filled(n, null)` builds
// the list that destination declares (D3990), and a `string | null` fill keeps its null (D3991).
import { filled } from "std:array"

type Item = { n: i32 }
type Character = { equip: (Item | null)[], hp: i32 }
function item(xs: (Item | null)[], i: i32): Item | null { xs[i] }
function name(xs: (string | null)[], i: i32): string | null { xs[i] }
function main() {
  const c: Character = { equip: filled(3, null), hp: 1 }
  c.equip[0] = { n: 5 }
  const e = item(c.equip, 0)
  if e != null { print(e.n) }
  print(c.equip.length)
  const names: (string | null)[] = filled(2, null)
  names[0] = "s"
  const s = name(names, 0)
  if s != null { print(s) }
  print(name(names, 1) == null)
}
main()
