// @run
// @log 1
// @log 0.5
// @log 2
// @log 3
// @log 22
// @log 8
// @log 7
// @log q
// @log 9
// @log 1
// @log 2.5
// A `.map` whose callback returns a list builds a list of lists (D4870): a literal, a nested
// `.map` that changes the leaf, records and lists one level further down, a chained `.map`, an
// inferred return, a generic, a named function and a closure value each deliver one.
function mk(xs: i32[]) { return xs.map((x) => [x * 2]) }
function mk2<T>(xs: T[]): T[][] { return xs.map((x) => [x]) }
function viaParam(g: (n: i32) => f64[]) { return [2].map(g) }
function pair(n: i32) { return [n, n + 1] }

const c = [1].map((n) => [n])
print(c[0][0])
const a: i32[][] = [[1, 2], [3]]
const b = a.map((r) => r.map((x) => x as f64))
print(b[0][1] / 4.0)
const s = [1, 2].map((n) => [{ a: n }])
print(s[1][0].a)
const d = [3].map((n) => [[n, n]])
print(d[0][0][1])
const ch = [1, 2, 3].map((n) => [n, n]).map((r) => r.length + 20)
print(ch[2])
print(mk([4])[0][0])
print(mk2([7])[0][0])
print(mk2(["q"])[0][0])
const f = (n: i32): i32[] => [n, 9]
print([1].map(f)[0][1])
print(viaParam((n) => [n * 0.5])[0][0])
const e = [1, 5].map(pair)
print(e[1][1] / 2.0 + e[0][0] - 1.5)
