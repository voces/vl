// @run
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// D1511 — an INFERRED-empty list filled by `.push` with STRUCT literals, read back with NO
// `<shape>[]` SPELLING ANYWHERE in the module. Its sibling `infer-build-struct.vl` declares
// `type P` and annotates every destination `P[]`, and that annotation is what mints the
// ref-list row: with it the whole family ran, without it `collectA` interned no row for the
// element, `synthEmptyListAnn` synthesized `#anon0[]` over a slot that does not exist, and the
// binding took the i32-list default. `vl check` accepted every line below.
//
// Reported as VL-017 by the first external consumer, in all four spellings it used.

// Direct index read.
const xs = []
xs.push({ y: 1, x: 2 })
print(xs[0].y)

// The element bound first.
const ys = []
ys.push({ y: 1, x: 2 })
const p = ys[0]
print(p.y)

// `for`-in over the list.
const zs = []
zs.push({ y: 1, x: 2 })
for q in zs {
  print(q.y)
}

// Inside a function body.
function inFn() {
  const ws = []
  ws.push({ y: 1, x: 2 })
  print(ws[0].y)
}
inFn()

// Captured by a closure — the env field is typed a whole pass before anything pins the row.
function captured() {
  const cs = []
  cs.push({ y: 1, x: 2 })
  const read = () => {
    print(cs[0].y)
  }
  read()
}
captured()
