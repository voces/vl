// @run
// @log 2
// @log 4
// @log 3.75
// @log 5000000001
// @log 2.75
// @log 4
// @log 2.25
// An un-annotated list of list literals is built at the element the checker joined their
// leaves to, whichever inner literal carries the wider one (D4876): at top level, inside a
// function, three levels deep, and with a later `.push` of the wider leaf.
function inner() {
  const v = [[1, 2], [3.5]]
  return v[0][1] / 4.0 + v[1][0]
}

const a = [[1, 2], [3.5]]
print(a.length)
print(inner())
const b = [[1], [3.5]]
print(b[0][0] / 4.0 + b[1][0])
const c = [[1], [5000000000]]
print(c[1][0] + c[0][0])
const d = [[[1]], [[2.5]]]
print(d[0][0][0] / 4.0 + d[1][0][0])
const e = [[3.5], [1, 2]]
print(e[1][1] / 4.0 + e[0][0])
const f = [[1, 2], [3.5]]
f[0].push(0.25)
print(f[0][2] + f[0].length - 1.0)
