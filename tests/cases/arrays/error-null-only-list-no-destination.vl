// @error-at 9:11 a list of only `null` has no element type; annotate it, e.g. `const e: (i32 | null)[] = [null]`
// @error-at 10:12 a list of only `null` has no element type
// @error-at 11:20 a list of only `null` has no element type
// @error-at 13:23 a list of only `null` has no element type
// @error-at 14:9 a list of only `null` has no element type
// A list literal whose every element is `null` has no element type unless a typed destination
// receives it (D1832, owner ruling (a)): an un-annotated binding, a nested literal under one, an
// un-annotated return and a generic parameter's `T[]` each refuse at the literal.
const e = [null]
const n = [[null]]
const b = { items: [null] }
function f<T>(xs: T[]): i32 { return xs.length }
function g() { return [null] }
print(f([null]))
print(e.length + n.length + b.items.length + g().length)
