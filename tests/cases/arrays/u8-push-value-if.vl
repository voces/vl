// @run
// @log 6
// @log 49
// @log 99
// @log 1
// @log 0
// @log 44
// A value `if` pushed onto a `u8[]` is typed `u8` and held as the i32 the packed store
// truncates: a digit chain, a flag, and an `else if` chain whose computed value is past a byte.
function putHex(out: u8[], v: i32) {
  if v >= 16 { putHex(out, v / 16) }
  const d = v % 16
  out.push(if d < 10 { 48 + d } else { 87 + d })
}
function putFlag(out: u8[], on: boolean) { out.push(if on { 1 } else { 0 }) }
function putWide(out: u8[], k: i32) {
  out.push(if k > 0 { k + 299 } else if k < 0 { 7 } else { 9 })
}
const o: u8[] = []
putHex(o, 300)
putFlag(o, true)
putFlag(o, false)
putWide(o, 1)
print(o.length)
print(o[0])
print(o[2])
print(o[3])
print(o[4])
print(o[5])
