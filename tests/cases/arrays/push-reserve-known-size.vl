// @run
// @log 16|1,2,3,4,2,4,6,8,3,6,9,12,4,8,12,16
// @log 6|a0,a1,a2,b0,b1,b2
// @log 8|0,1,3,4,9,10,12,13
// @log 4>13|0,1,2,3,50,51,52,53,54,55,56,57,58
// @log 3
// @log 6|0,1,2,10,11,12
// @log 0|
// @log 5|0,1,2,3,4
// @log 6|0,1,2,3,4,5
// @log 7|1,1,2,1,2,3,9
// @log 12|60,61,62,63,64,65,66,67,68,69,70,71
// A fresh `[]` whose next uses are unconditional pushes in constant-trip range loops is
// reserved at the count those loops push, and the pushes append through locals until the
// region ends (D3623). Each case prints every element, so a lost or misplaced push shows:
// records, strings, i64 and a nested list; a push past the reserve; a read between two
// regions; empty and zero-trip loops; `break`; a non-constant bound; a nested region.
import { toString } from "std:fmt"

type P = { x: i32, y: i32 }

function outer(a: i32, b: i32): f64[] {
  const o: f64[] = []
  for c in 0 until 4 {
    for r in 0 until 4 {
      o.push(((c + 1) * (r + 1)) as f64 * a as f64 / b as f64)
    }
  }
  o
}

function strs() {
  const o: string[] = []
  for k in 0 until 2 {
    for j in 0 until 3 { o.push(if k == 0 { "a" } else { "b" } + j.toString()) }
  }
  o
}

function recs(): P[] {
  const o: P[] = []
  for i in 0 until 2 {
    for j in 0 until 2 {
      for k in 0 until 2 { o.push({ x: i * 9 + j * 3, y: k }) }
    }
  }
  o
}

function past(n: i32): i64[] {
  const o: i64[] = []
  for i in 0 until 4 { o.push(i as i64) }
  if n > 0 {
    for i in 0 until 9 { o.push((50 + i) as i64) }
  }
  o
}

function midread() {
  const o: i32[] = []
  for i in 0 until 3 { o.push(i) }
  print(o.length)
  for i in 0 until 3 { o.push(10 + i) }
  o
}

function zero(n: i32) {
  const o: i32[] = []
  for i in 0 until 0 { o.push(i) }
  for i in 0 until n { o.push(i) }
  o
}

function brk() {
  const o: i32[] = []
  for i in 0 until 10 {
    if i == 5 { break }
    o.push(i)
  }
  o
}

function nonconst(n: i32) {
  const o: i32[] = []
  for i in 0 until n {
    for j in 0 until 2 { o.push(i * 2 + j) }
  }
  o
}

function nested(): i32[][] {
  const o: i32[][] = []
  for i in 1 to 3 {
    const row: i32[] = []
    for j in 1 to i { row.push(j) }
    o.push(row)
  }
  o.push([9])
  o
}

function big(): u8[] {
  const o: u8[] = []
  for i in 0 until 300 {
    for j in 0 until 2 { o.push(i * 2 + j) }
  }
  o
}

function show(xs: string[]) {
  let s = ""
  for x in xs {
    if s.length > 0 { s = s + "," }
    s = s + x
  }
  xs.length.toString() + "|" + s
}

const o1 = outer(2, 2)
print(show(o1.map((v: f64): string => v.toString())))
print(show(strs()))
print(show(recs().map((p: P): string => (p.x + p.y).toString())))
const p = past(1)
print("4>" + show(p.map((v: i64): string => v.toString())))
print(show(midread().map((v: i32): string => v.toString())))
print(show(zero(0).map((v: i32): string => v.toString())))
print(show(brk().map((v: i32): string => v.toString())))
print(show(nonconst(3).map((v: i32): string => v.toString())))
const ns = nested()
const flat: string[] = []
for r in ns {
  for v in r { flat.push(v.toString()) }
}
print(show(flat))
const b = big()
const tail: string[] = []
for i in 0 until 12 { tail.push(b[i + 60].toString()) }
print(show(tail))
