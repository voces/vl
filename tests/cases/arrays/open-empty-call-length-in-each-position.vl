// @run
// @log 0
// @log 1
// @log true
// @log 0
// @log 5
// @hint Intentionally-unused parameter
// A call returning an empty `[]` whose element no use fixes reads its `.length` off the list its
// result is built as: printed, in arithmetic, compared, passed, bound and returned.
type P = { r: i32 }
function sink(_x: P[]) {}
function mk() {
  sink([])
  return []
}
function show(n: i32) { print(n) }
function plus() { return mk().length + 5 }
print(mk().length)
print(mk().length + 1)
print(mk().length == 0)
show(mk().length)
const k = plus()
print(k)
