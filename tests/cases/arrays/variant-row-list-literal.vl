// @run
// @log 0
// @log 4
// @log 2
// @log 0
// A variant's record list literal, empty, of literals or of values, builds as the short list.
type A = { a: i32 }
type B = { b: i32 }
type U = A | B
let rows: A[][] = []
function drop(ci: i32): i32 {
  const none: A[] = []
  rows[ci] = none
  return rows[ci].length
}
function lits(n: i32): A[] {
  const xs: A[] = [{ a: n }, { a: n + 1 }]
  return xs
}
function vals(x: A, y: A): A[] {
  const xs: A[] = [x, y]
  return xs
}
function pick(u: U): i32 {
  if u is A { return u.a }
  return 0
}
rows.push([{ a: 1 }])
print(drop(0))
print(lits(3)[1].a)
print(vals({ a: 5 }, { a: 6 }).length)
print(pick({ b: 3 }))
