// @run
// @log 1
// @log 2
// @log 1
// @log a
// @log 2
// @log true
// @log 1
// @log 2
// Q58 position sweep: a list whose element class keeps its storage (a string, a boolean, a literal
// union atom), widened to the readonly list of that element or `null`, shares the list: an
// argument, a readonly binding and a return, in the start body and in a function.
type K = "a" | "b"
function strs(ys: readonly (string | null)[]) { print(ys.length) }
function bools(ys: readonly (boolean | null)[]) { print(ys.length) }
function atoms(ys: readonly (K | null)[]) { print(ys.length) }
function wide(xs: string[]): readonly (string | null)[] { return xs }
const ss = ["a"]
strs(ss)
bools([true, false])
const ks: K[] = ["a"]
atoms(ks)
const r: readonly (string | null)[] = ss
print(r[0] ?? "none")
function inFn(b: boolean) {
  const xs = ["x", "y"]
  strs(xs)
  const bs = [b]
  const rb: readonly (boolean | null)[] = bs
  print(rb[0] ?? false)
  atoms(["b"])
  print(wide(xs).length)
}
inFn(true)
