// @run
// @log 0
// @log 0
// @log 0
// @log 0
// THE EMPTY-`[]` HOLE'S TWO REMAINING ELEMENT SPELLINGS (D812, D813), at BOTH scopes.
// `synthEmptyListAnn` writes the inferred `<elem>[]` annotation back onto an un-annotated
// empty `[]` whose hole a declared destination pinned. D772 gave it a nullable-element
// fall-back gated on `rlSlotByName` answering; two spellings fell through that gate and
// were `vl check` rc 0 with an INVALID MODULE.
//
// `(string | null)[]` (D812) has no ref-list row BY DESIGN — it rides the STRING-list
// backing, `nameIsStringArray` being rep-wide over the niche — so the row test can never
// answer for it. That is a different rep, not no rep, and the string list's own predicate
// (`nameIsNulString`) is the same kind of positive proof the row test is.
//
// `(Shape | null)[]` (D813) renders `{r:i32}|{s:i32}|null`, whose row EXISTS and answers.
// What declined it was the MEMBERSHIP test: `nullablePartOf` splits at the first depth-0
// bar and demands one half be exactly `null`, so it answers "" for every union of three or
// more members. `unionSetHasNull` is the structural question the gate was asking.
//
// BOTH SCOPES, because `synthEmptyListAnn` has one home for two storage classes precisely
// so they cannot drift, and the corpus carried only the function-scope half.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
const gs = []
const ga: (string | null)[] = gs
const gu = []
const gb: (Shape | null)[] = gu
function f() {
  const xs = []
  const a: (string | null)[] = xs
  print(a.length)
  const ys = []
  const b: (Shape | null)[] = ys
  print(b.length)
}
f()
print(ga.length)
print(gb.length)
