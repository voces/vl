// @run
// @log 2
// @log b
// @log 0.5
// @log x
// @log 2
// @log yes
// @log 2.5
// @log 3
// @log 1
// @log z
// @log 3
// @log true
// @log 2
// @log 2
// @log 1
// A list literal of list literals whose leaves differ is typed a list of a union of lists, and
// its outer list holds that union's box whatever the lead inner list's leaf is (D4894). Read
// back through a narrowing, returned, passed, spread, mutated and nested a third level.
const w = [["a"], [1.5]]
print(w.length)

for e in [["a", "b"], [1.5]] {
  if e is string[] { print(e[1]) } else { print(e[0] / 3.0) }
}

function f() { return [[1], ["x"]] }
const r = f()
const r1 = r[1]
if r1 is string[] { print(r1[0]) }
print(r.length)

function g(xs: (string[] | f64[])[]) {
  const e = xs[1]
  if e is f64[] { return if e[0] > 2.0 { "yes" } else { "no" } }
  "str"
}
print(g([["a"], [2.5]]))

const s = [...[["a"], [1.5]], [2.5]]
const s2 = s[2]
if s2 is f64[] { print(s2[0]) }
print(s.length)

const l = [["a"], [1 as i64]]
const l1 = l[1]
if l1 is i64[] { print(l1[0]) }

const m = [["a"], [1.5]]
m.push([2.5])
m[0] = ["z"]
const m0 = m[0]
if m0 is string[] { print(m0[0]) }
print(m.length)

const b = [[1], [true]]
const b1 = b[1]
if b1 is boolean[] { print(b1[0]) }

const d = [[[1]], [["a"]]]
print(d.length)

function h(xs: (i32[] | string[])[]) {
  for x in xs { print(x.length) }
}
h([[1, 2], ["a"]])
