// @run
// @log 2.5
// @log 7
// @log 10
// @log 2
// A `.map` whose callback is a function value with an `f64`, `i64` or `f32` result builds that
// scalar list: the call's recorded type names it where no lifted entry does.
function half(n: i32) { (n as f64) / 2.0 }
function twice(n: i32) { (n as i64) * 2 }
function go(f: (i32) => f64, xs: i32[]) { return xs.map(f)[1] }
print(go(half, [3, 5]))
const cb = twice
const ys = [3, 5].map(cb)
ys[0] = 7 as! i64
print(ys[0])
print(ys[1])
print(ys.length)
