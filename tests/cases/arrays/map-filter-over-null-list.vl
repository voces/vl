// @run
// @log 1
// @log n
// @log null
// @log 2
// @log 2
// @log 2
// @log 7
// @hint Intentionally-unused parameter `_e` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_e` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_e` (leading `_` marks it unused)
// `.map` and `.filter` over a `null[]` list hand a callback taking `null` the bottom ref, not the
// list's stored sentinel; a callback whose element parameter holds more than `null` reads the list as is (D17039).
const xs: null[] = [null]
print(xs.map((_e): i32 => 1)[0])
function h(x) { return [x].map((e): string | i32 => e ?? "n")[0] }
print(h(null))
print(xs.map((e): string | i32 | null => e)[0] ?? "null")
const ys: null[] = [null, null]
print(ys.filter((e): boolean => e == null).length)
let c = 0
for y in ys {
  if y == null { c = c + 1 }
}
print(c)
function keep(_e: null) { return true }
print(ys.filter(keep).length)
const g = (_e: null): i32 => 7
print(ys.map(g)[1])
