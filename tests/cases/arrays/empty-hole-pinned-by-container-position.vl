// @run
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log 1
// @log 0
// @log 0
// @log 0
// @log 1
// @hint redundant type annotation: `rs` is inferred as `string[]` — remove it to lean on inference
// @hint redundant type annotation: `w2` is inferred as `{xs: string[]}` — remove it to lean on inference
// THOSE TWO HINTS ARE DECLARED, NOT ACTED ON: each annotation names the DESTINATION the
// write on the next line pins the hole from, which is the whole point of the leg. The hint is
// right that inference reaches the same type from the seed literal — and removing the
// annotation would make the leg a different program.
// AN EMPTY `[]` REACHING A CONTAINER SLOT, through a producer with no annotation of its own.
// The D16 companion: that row closed the positions where the CHECKER had already unified the
// hole with the consuming slot and only the two emit-side readers disagreed. These positions
// never reached the checker's pin at all — `constrainEmpty` walked an ARRAY destination's
// element (`const xss: string[][] = [fq()]` has always lowered) but stopped at a STRUCT field,
// a MAP value and every WRITE spelling. `vl check` exited 0 with no diagnostic, the module was
// written, and the engine refused it: `type mismatch: expected (ref $type), found (ref $type)`.
// Filed as D17 and D18 in docs/internals/silent-class-inventory.md; measured over a 231-cell
// grid (21 positions x 11 element reps), 111 SILENT before, 0 after.
//
// The two rows are ONE root, not two: the container differs but the missing walk is the same
// one, and both close on the object/map-value recursion inside `constrainEmpty`. Nothing on the
// emit side moved — the D16 seed (`emptyArrHoleKind`, read off the literal node) is what lowers
// them once the checker pins.
//
// Every leg uses an element rep with its OWN list backing (`string`, `f64`, a struct, a nested
// list, a closure). The i32/boolean shared backing was never red here — the default the
// unpinned hole fell to happened to be right for it — so an i32-only file would pass on master
// and pin nothing.
//
// ONE PRODUCER PER ELEMENT REP, and that is the rule this change chose, not an accident of
// the fixture: a hole pins from the FIRST consumer that reaches it and a conflicting second use
// is then a loud reject. Reusing a single `fq()` across the `string[]` and `f64[]` legs here
// is a type error, pinned as such in
// `tests/cases/arrays/empty-hole-container-conflict-rejected.vl`.
//
// The legs:
//   L1  a STRUCT-FIELD initializer (D17's own repro shape), over five element backings.
//   L2  a MAP-VALUE index write (D18's own repro shape).
//   L3  the write spellings that are not a container at all: a plain reassignment, a member
//       store, `m.set(k, v)` and `xs.push(v)` — each was silent for the same missing pin.
//   L4  the field of a NESTED object literal, and a struct literal in an ARRAY element and in a
//       MAP value — the recursion has to descend, not just look one level.
//   L5  a struct literal as a call ARGUMENT and as a typed RETURN.
//   L6  a NULLABLE destination (`string[] | null`), which pins through the wrapper.
//   L7  a DIRECT `[]` in the same slots — the control that already lowered, because the field
//       annotation seeds the build (`seedFieldListBuild`). It must keep lowering.

type W = { xs: string[] }
type D = { ds: f64[] }
type S = { n: i32 }
type WS = { ss: S[] }
type WN = { xss: i32[][] }
type WC = { fs: ((i32) => i32)[] }
type Inner = { xs: string[] }
type Outer = { inner: Inner }
type WQ = { xs: string[] | null }

function fq() {
  return []
}

function fd() {
  return []
}

function fs() {
  return []
}

function fn() {
  return []
}

function fc() {
  return []
}

function fm() {
  return []
}

function fr() {
  return []
}

function fw() {
  return []
}

function fset() {
  return []
}

function fpush() {
  return []
}

function fnest() {
  return []
}

function farr() {
  return []
}

function fmapstruct() {
  return []
}

function farg() {
  return []
}

function fret() {
  return []
}

function fnull() {
  return []
}

function sinkW(w: W) {
  print(w.xs.length)
}

function mkW(): W {
  return { xs: fret() }
}

// L1 — the struct-field initializer, the filed D17 program.
const w: W = { xs: fq() }
print(w.xs.length)

// L1 — the same field position over the other backings.
const d: D = { ds: fd() }
print(d.ds.length)
const ws: WS = { ss: fs() }
print(ws.ss.length)
const wn: WN = { xss: fn() }
print(wn.xss.length)
const wc: WC = { fs: fc() }
print(wc.fs.length)

// L2 — the map-value index write, the filed D18 program.
const m: {[string]: f64[]} = Map()
m["a"] = fm()
print((m["a"] ?? [1.0]).length)

// L3 — a plain reassignment into an annotated binding.
let rs: string[] = ["seed"]
rs = fr()
print(rs.length)

// L3 — a member store into a struct field.
const w2: W = { xs: ["seed"] }
w2.xs = fw()
print(w2.xs.length)

// L3 — the `.set` spelling of the same map write.
const ms: {[string]: string[]} = Map()
ms.set("a", fset())
print((ms["a"] ?? ["x"]).length)

// L3 — `.push` into an array whose ELEMENT is the list.
const pss: f64[][] = []
pss.push(fpush())
print(pss[0].length)

// L4 — a field of a nested object literal.
const o: Outer = { inner: { xs: fnest() } }
print(o.inner.xs.length)

// L4 — a struct literal in an ARRAY element, and in a MAP value.
const wsArr: W[] = [{ xs: farr() }]
print(wsArr[0].xs.length)
const wsMap: {[string]: W} = Map()
wsMap["a"] = { xs: fmapstruct() }
print(wsMap.size)

// L5 — a struct literal as an argument, and as a typed return.
sinkW({ xs: farg() })
print(mkW().xs.length)

// L6 — a nullable field destination pins through the `| null` wrapper.
const wq: WQ = { xs: fnull() }
print((wq.xs ?? ["a", "b"]).length)

// L7 — the DIRECT-literal controls, which lowered before this change and still do.
const wd: W = { xs: [] }
const md: {[string]: f64[]} = Map()
md["a"] = []
print(wd.xs.length + md.size)
