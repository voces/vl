// @run
// @log 1
// @log 1.5
// @log 5
// @log 1
// @log 1.5
// @log 5
// @log 1
// @log 1.5
// @log 5
// @log 1
// @log 1.5
// @log 5
// @log 1
// @log 1.5
// @log 5
// @log 2
// @log 3
// @log 10
// @log 1
// @log 1.5
// @log 5
// @log 2
// @log 3
// @log 10
// @hint redundant type annotation: `cs` is inferred as `{n: i32}[]` — remove it to lean on inference
// @hint redundant type annotation: `ns` is inferred as `i32[]` — remove it to lean on inference
// @hint redundant type annotation: `rs` is inferred as `{r: i32}[]` — remove it to lean on inference
// @hint redundant type annotation: `firstN` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `half` is inferred as `f64` — remove it to lean on inference
// @hint redundant type annotation: `radius` is inferred as `i32` — remove it to lean on inference
// The first fix the container rule names, at every delivery position its three `error-list-
// widening-*.vl` twins refuse: a `readonly` destination is covariant. The shared pair
// (`C[]` into `readonly (C | null)[]`) aliases the list; the numeric and ref pairs are copies,
// sound because nothing writes the source. Each line prints a value read back through the
// wider type, so a pass that skipped the conversion would print the wrong value.
type C = { n: i32 }
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
const cs: C[] = [{ n: 1 }]
const ns: i32[] = [3, 4]
const rs: Circle[] = [{ r: 5 }]

function firstN(xs: readonly (C | null)[]): i32 {
  const e = xs[0]
  if e == null { return 0 }
  e.n
}
function half(xs: readonly f64[]): f64 { xs[0] / 2.0 }
function radius(xs: readonly Shape[]): i32 {
  const e = xs[0]
  if e is Circle { return e.r }
  0
}

// argument
print(firstN(cs))
print(half(ns))
print(radius(rs))

// local binding
function bind() {
  const b1: readonly (C | null)[] = cs
  const b2: readonly f64[] = ns
  const b3: readonly Shape[] = rs
  print(firstN(b1))
  print(half(b2))
  print(radius(b3))
}
bind()

// return
function r1(): readonly (C | null)[] { return cs }
function r2(): readonly f64[] { return ns }
function r3(): readonly Shape[] { return rs }
print(firstN(r1()))
print(half(r2()))
print(radius(r3()))

// struct field
type Holder = {
  a: readonly (C | null)[],
  b: readonly f64[],
  c: readonly Shape[],
}
const h: Holder = { a: cs, b: ns, c: rs }
print(firstN(h.a))
print(half(h.b))
print(radius(h.c))

// list element
const e1: (readonly (C | null)[])[] = [cs]
const e2: (readonly f64[])[] = [ns]
const e3: (readonly Shape[])[] = [rs]
print(firstN(e1[0]))
print(half(e2[0]))
print(radius(e3[0]))

// push, indexed store and map store into a container of views (D2163)
const o1: (readonly (C | null)[])[] = [[]]
const o2: (readonly f64[])[] = [[]]
const o3: (readonly Shape[])[] = [[]]
o1[0] = cs
o2[0] = ns
o3[0] = rs
o1.push(cs)
o2.push(ns)
o3.push(rs)
print(firstN(o1[0]) + firstN(o1[1]))
print(half(o2[0]) + half(o2[1]))
print(radius(o3[0]) + radius(o3[1]))
const m1: { [string]: readonly (C | null)[] } = Map()
const m2: { [string]: readonly f64[] } = Map()
const m3: { [string]: readonly Shape[] } = Map()
m1["k"] = cs
m2["k"] = ns
m3["k"] = rs
print(firstN(m1["k"] ?? []))
print(half(m2["k"] ?? [0.0]))
print(radius(m3["k"] ?? []))

// global init and global assignment
const g1: readonly (C | null)[] = cs
const g2: readonly f64[] = ns
const g3: readonly Shape[] = rs
let a1: readonly (C | null)[] = []
let a2: readonly f64[] = []
let a3: readonly Shape[] = []
function reassign() {
  a1 = cs
  a2 = ns
  a3 = rs
}
reassign()
print(firstN(g1) + firstN(a1))
print(half(g2) + half(a2))
print(radius(g3) + radius(a3))
