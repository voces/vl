// @run
// @log 4
// @log 4
// @log 4
// @log 4
// @log 7
// @log 1
// A list literal nested in a spread is built at the element type of the list holding it, whether
// that list is annotated or its type is the join of its spreads, and beside a plain element too.
const a: f64[][] = [...[[1, 2]], ...[[3.5]]]
print(a[0][1] / 4.0 + a[1][0])
const b = [...[[1, 2]], ...[[3.5]]]
print(b[0][1] / 4.0 + b[1][0])
function j() { return [...[[1, 2]], ...[[3.5]]] }
print(j()[0][1] / 4.0 + j()[1][0])
const c = [...[[1, 2]], [3.5]]
print(c[0][1] / 4.0 + c[1][0])
const d = [...[[[1, 2]]], ...[[[3.5, 1]]]]
print(d[0][0][1] / 4.0 + d[1][0][0] + d[1][0][1] + d.length)
function t<T>(x: T) { [...[x]].length }
const u: i32 | string = 4
print(t(u))
