// @run
// @log false
// @log true
// @log false
// @log a
// @log null
// @log b
// @log 2
// @log a
// @log b
// @log 1
// @log 0
// @log 2
// @log 2
// @log 1
// @log 2
// @log 1
// @log -1
// @log 2
// @log 1
// @log 2
// @hint redundant type annotation: `strs` is inferred as `(string | null)[]`
// @hint redundant type annotation: `boxes` is inferred as `({v: i32} | null)[]`
// @hint redundant type annotation: `rows` is inferred as `(i32[] | null)[]`
// `.map` / `.filter` over a NULLABLE-ELEMENT array, at the three element reps whose
// `$fnsig` token exists: the string niche (`(ref null $aTypeIdx)`), the struct niche
// (`(ref null $S)`) and the i32-list niche (`(ref null $lTypeIdx)`).
//
// TWO facts have to hold together, and each was missing on its own:
//
//  1. the callback's `$fnsig` must be INTERNED, which needs a PARAM token for the niche
//     (`cloParamTok`). Without it `fnSigKeyOf`/`cloSigKeyExt` key "" and the whole surface
//     is `emitProgram: .map/.filter callback signature is not interned`;
//  2. the element handed to the callback must stay `(ref null $elem)`. Every ref/string
//     backing is `(array (mut (ref null $elem)))`, so a non-null element needs
//     `ref.as_non_null` after `array.get` — and that recover TRAPS on exactly the value a
//     niche exists to carry. `listElemStaysNullable` is the one answer the indexed read and
//     the `.map`/`.filter` element step share.
//
// Both runtime inputs are exercised: every list here has a `null` at index 1, and the
// callbacks are the two shapes that read the element (`== null`, and a `!= null` narrowing
// block). The `@log` lines are a LOG pin, not a verdict pin — a wrong element read shows up
// as a wrong VALUE (or a trap), not as a build failure.
type S = { v: i32 }

const strs: (string | null)[] = ["a", null, "b"]
// The callback's param is the `nulstr` niche; the result is a plain boolean list.
for f in strs.map((x) => x == null) { print(f) } // false / true / false
// A niche-RETURNING callback: the result is the SAME string list with the nullable element
// discipline, so `null` survives the round trip.
for y in strs.map((x) => x) { print(y) } // a / null / b
// The `.filter` result binding is UN-ANNOTATED — `exprStringArray`'s `.map`/`.filter` arm is
// what gives it the string-list wrapper instead of the i32 default.
const kept = strs.filter((x) => x != null)
print(kept.length) // 2
for k in kept { print(k) } // a / b

const boxes: (S | null)[] = [{ v: 1 }, null, { v: 2 }]
// A BLOCK-bodied callback with a `!= null` narrowing guard over the struct niche.
for n in boxes.map((b) => {
  if b != null { return b.v }
  return 0
}) { print(n) } // 1 / 0 / 2
const present = boxes.filter((b) => b != null)
print(present.length) // 2
const first = present[0]
print(if first == null { 0 - 1 } else { first.v }) // 1
// A CHAINED `.map(...).filter(...)` over the same niche.
print(boxes.map((b) => if b == null { 0 } else { 1 }).filter((n) => n > 0).length) // 2

const rows: (i32[] | null)[] = [[1], null, [2, 3]]
// The i32-list niche: `null` is `ref.null $lTypeIdx`, a present row its wrapper.
for w in rows.map((r) => if r == null { 0 - 1 } else { r.length }) { print(w) } // 1 / -1 / 2
print(rows.filter((r) => r == null).length) // 1
print(rows.filter((r) => r != null).length) // 2
