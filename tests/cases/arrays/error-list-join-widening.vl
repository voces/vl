// @error-at 34:20 i32[][] is not f64[][]: this join would hold both, and a container never widens implicitly. Its elements would be stored differently, so it would be a copy, and a write through either list would not reach the other. Build it as `f64[][]`
// @error-at 37:20 string[] is not (i32 | string)[]: this join would hold both, and a container never widens implicitly. Its elements would be stored differently, so it would be a copy, and a write through either list would not reach the other. Build it as `(i32 | string)[]`, or copy it with `.map((x): i32 | string => x)`
// A join of a list with a list whose elements are stored differently (`i32[]` beside
// `[2.5]`, `f32[]` beside `[2.2]`) is typed as the wider list, and handing a list that
// already exists to it would take a hidden copy, the delivery a list never makes
// implicitly (DECISIONS.md, "No implicit container widening"). Each join position refuses
// at the value that would be copied: a `??` operand, an `if` arm, a `match` arm, a return
// set, a list of lists and a reference-element pair. A list literal arm is built at the joined type and needs no copy;
// `list-join-widening-literal-arms-runs.vl` is that twin, with every printed fix applied.
function t() { 1 == 1 }

const a: i32[] | null = null
const q1 = a ?? [2.5]

const f32s = [(1.1 as f32)]
const q2 = if t() { f32s } else { [2.2] }

const ns: i32[] = [1]
const q3 = match 1 {
  1 => ns
  _ => [2.5]
}

function ret(c: boolean) {
  if c { return ns }
  [2.5]
}

const nn: i32[][] = [[3]]
const q4 = if t() { nn } else { [[2.5]] }

const ss: string[] = ["b"]
const q5 = if t() { ss } else { [1, "a"] }

print(q5.length)
print(q1.length + q2.length + q3.length + ret(true).length + q4.length)
