// @run
// @log 9
// @log 9
// @log 3
// D2411: an assignment yields its right side, so `const v = (c = x)` is one more handle on `x`.
// A write through that handle shows through `c`, the `readonly f64[]` view of `x` (DECISIONS,
// "A `readonly` destination over a written source is a live view").
let c: readonly f64[] = [1.5]
const x = [5, 2]
const v = (c = x)
v[0] = 9
print(x[0])
print(c[0])
function pass(p: i32[]) { p[1] = 3 }
let d: readonly f64[] = [1.5]
const y = [5, 2]
pass(d = y)
print(d[1])
