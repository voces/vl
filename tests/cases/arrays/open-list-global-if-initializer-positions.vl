// A global bound to an empty-list-or-null join whose element nothing fixes is the nullable i32 list
// its cell declares: built at that cell, read by a null test in the start and in a function.
function t() { return 1 == 1 }
const x = if !t() { [] } else { null }
function isNone() { return x == null }
print(isNone())
print(x == null)
const y = if t() { [] } else { null }
print(y == null)
print(y != null)
function both() { return x == null && y != null }
print(both())
