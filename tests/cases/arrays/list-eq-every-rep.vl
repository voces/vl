  print(g_ra == g_rn)
  print(g_rn == null)
}

// THE COMPARE AT MODULE SCOPE ITSELF, not merely over module-scope OPERANDS — the start
// function is its own emitted function with its own frame, and a rung reserved per FUNCTION
// has to reach it too.
// @log true
// @log false

i32List()
stringList()
nestedI32List()
f64List()
i64List()
u8List()
f32List([1.5, 2.5], [1.5, 2.5], [1.5, 3.5])
structParamList([mkc(1), mkc(2)], [mkc(1), mkc(2)], [mkc(1), mkc(3)])
f64LitUnionList()
i32LitUnionList()
strLitUnionList()
nestedF64List()
nestedI64List()
nestedStringList()
tripleNestedI32List()
structList()
unionArmElemList()
nestedStructList()
nullableF64List()
nullableStructList()
lengthDecides()
moduleScopeI32()
moduleScopeString()
moduleScopeF64()
moduleScopeI64()
moduleScopeF32()
moduleScopeU8()
moduleScopeF64LitUnion()
moduleScopeStrLitUnion()
moduleScopeI32LitUnion()
moduleScopeNestedI32()
moduleScopeNestedF64()
moduleScopeNestedI64()
moduleScopeNestedString()
moduleScopeTripleI32()
moduleScopeStruct()
moduleScopeNestedStruct()
moduleScopeNullableF64()
moduleScopeNullableStruct()
print(g_i64a == g_i64b)
print(g_f32a == g_f32c)
