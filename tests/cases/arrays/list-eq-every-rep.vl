// @run
// @hint redundant type annotation: `c` is inferred as `{r: i32}` — remove it to lean on inference
// @hint redundant type annotation: `a` is inferred as `i64[]` — remove it to lean on inference
// @hint redundant type annotation: `b` is inferred as `i64[]` — remove it to lean on inference
// @hint redundant type annotation: `c` is inferred as `i64[]` — remove it to lean on inference
// @hint redundant type annotation: `a` is inferred as `i64[][]` — remove it to lean on inference
// @hint redundant type annotation: `b` is inferred as `i64[][]` — remove it to lean on inference
// @hint redundant type annotation: `c` is inferred as `i64[][]` — remove it to lean on inference
// @hint redundant type annotation: `a` is inferred as `Circle[][]` — remove it to lean on inference
// @hint redundant type annotation: `b` is inferred as `Circle[][]` — remove it to lean on inference
// @hint redundant type annotation: `c` is inferred as `Circle[][]` — remove it to lean on inference
// THE ACCEPT SET of `silent-class-inventory` D751/D752, READ BACK BY VALUE.
//
// `a == b` over two lists had exactly THREE cores — `emitListEqICore` (the i32/boolean
// backing), `emitListEqSCore` (string elements) and `emitListEqRCore` (a ref list of
// i32/boolean lists) — and `eqCmpKindOfArrayElem` was that closed list written down as a
// TYPE rule. Every other rep was refused at `vl check` with `` `==` over X has no
// lowering ``, a sentence that concedes the program is type-valid and is therefore a
// clause-2 violation of the standing goal rather than a rule.
//
// **`==` IS NOT `+`, AND THIS FIXTURE IS THE OTHER HALF OF THAT SENTENCE.** D721 gave every
// list rep ONE concat lowering, because a concat moves opaque storage with `array.copy` and
// never looks at an element. A compare has to look, so it needs to KNOW the element:
// `emitListEqGCore` is parameterised on the (wrapper, backing) pair the concat side already
// had, PLUS an element rung — one opcode for a scalar leaf, the shared `__str_eq__` helper
// for a string leaf, a recursion into the element's own core for a nested list, and a
// field-wise compare for a flat struct element.
//
// WHY BOTH DIRECTIONS AND NOT JUST `==`. A compare that reads the wrong storage, or reads
// the right storage with the wrong opcode, still answers TRUE for two equal lists — an
// `i32.ne` over an `f64` backing does not validate, but an `i32.ne` over the low half of a
// pair that happens to match does. Every rep below is asked THREE questions: an equal pair
// (true), an unequal pair (false), and the same unequal pair through `!=` (true). The
// unequal pair always differs in the LAST element, so a length-only compare and a
// first-element-only compare both fail this fixture.
//
// THE NESTING LEVELS ARE THE SECOND CLAIM. A nested compare has two live loops at once, so
// each level needs its own frame; `f64[][]` and `i32[][][]` are here because an outer level
// writing into an inner level's counter is a wrong answer rather than a validation error.

type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type K = "a" | "b"
type N = 1 | 2
type F = 1.5 | 2.5

function mkc(r: i32) {
  const c: Circle = { r: r }
  return c
}

// ── the three cores that existed before, unchanged and byte-identical ─────────────────
// @log true
// @log false
// @log true
function i32List() {
  const a = [1, 2]
  const b = [1, 2]
  const c = [1, 3]
  print(a == b)
  print(a == c)
  print(a != c)
}

// @log true
// @log false
// @log true
function stringList() {
  const a = ["p", "q"]
  const b = ["p", "q"]
  const c = ["p", "r"]
  print(a == b)
  print(a == c)
  print(a != c)
}

// @log true
// @log false
// @log true
function nestedI32List() {
  const a = [[1], [2]]
  const b = [[1], [2]]
  const c = [[1], [3]]
  print(a == b)
  print(a == c)
  print(a != c)
}

// ── the WIDE-SCALAR backings: one core, three opcodes ─────────────────────────────────
// @log true
// @log false
// @log true
function f64List() {
  const a = [1.5, 2.5]
  const b = [1.5, 2.5]
  const c = [1.5, 3.5]
  print(a == b)
  print(a == c)
  print(a != c)
}

// @log true
// @log false
// @log true
function i64List() {
  const a: i64[] = [1, 9999999999]
  const b: i64[] = [1, 9999999999]
  const c: i64[] = [1, 9999999998]
  print(a == b)
  print(a == c)
  print(a != c)
}

// THE PACKED ONE. `u8[]`'s backing is `(array (mut i8))`, so its element read is
// `array.get_u` and the comparison is the i32 one on the zero-extended byte; reading it
// with `array.get` does not validate at all.
// @log true
// @log false
// @log true
function u8List() {
  const a = "ab".bytes()
  const b = "ab".bytes()
  const c = "ac".bytes()
  print(a == b)
  print(a == c)
  print(a != c)
}

// THE f32 BACKING, and it is here because `soundness/equality-no-lowering-reject.vl` used to
// hold it: that file's contract says a shape given a core must GRADUATE with a LOG-mismatch
// pin rather than quietly stop being refused.
// @log true
// @log false
// @log true
function f32List(a: f32[], b: f32[], c: f32[]) {
  print(a == b)
  print(a == c)
  print(a != c)
}

// THE SAME GRADUATION for a STRUCT-element list read through PARAMETERS rather than locals —
// a different storage class for the operand, and the spelling that file used.
// @log true
// @log false
// @log true
function structParamList(a: Circle[], b: Circle[], c: Circle[]) {
  print(a == b)
  print(a == c)
  print(a != c)
}

// ── the NUMERIC literal unions, which rep as their base's list ────────────────────────
// A `type F = 1.5 | 2.5` element is ONE f64 cell, so `F[]` is the f64 list and now has the
// f64 list's core. The i32-based `N = 1 | 2` rode the i32 core all along and must not move.
// @log true
// @log false
// @log true
function f64LitUnionList() {
  const a: F[] = [1.5, 2.5]
  const b: F[] = [1.5, 2.5]
  const c: F[] = [1.5, 1.5]
  print(a == b)
  print(a == c)
  print(a != c)
}

// @log true
// @log false
// @log true
function i32LitUnionList() {
  const a: N[] = [1, 2]
  const b: N[] = [1, 2]
  const c: N[] = [1, 1]
  print(a == b)
  print(a == c)
  print(a != c)
}

// @log true
// @log false
// @log true
function strLitUnionList() {
  const a: K[] = ["a", "b"]
  const b: K[] = ["a", "b"]
  const c: K[] = ["a", "a"]
  print(a == b)
  print(a == c)
  print(a != c)
}

// ── NESTING: one reserved frame per LEVEL, and the element's own core at each ──────────
// @log true
// @log false
// @log true
function nestedF64List() {
  const a = [[1.5], [2.5]]
  const b = [[1.5], [2.5]]
  const c = [[1.5], [3.5]]
  print(a == b)
  print(a == c)
  print(a != c)
}

// @log true
// @log false
// @log true
function nestedI64List() {
  const a: i64[][] = [[1], [9999999999]]
  const b: i64[][] = [[1], [9999999999]]
  const c: i64[][] = [[1], [9999999998]]
  print(a == b)
  print(a == c)
  print(a != c)
}

// @log true
// @log false
// @log true
function nestedStringList() {
  const a = [["x"], ["y"]]
  const b = [["x"], ["y"]]
  const c = [["x"], ["z"]]
  print(a == b)
  print(a == c)
  print(a != c)
}

// THREE levels: the outer ref list's element is itself a ref list, whose element is the
// i32-list wrapper — so the recursion passes through TWO different cores.
// @log true
// @log false
// @log true
function tripleNestedI32List() {
  const a = [[[1]], [[2]]]
  const b = [[[1]], [[2]]]
  const c = [[[1]], [[3]]]
  print(a == b)
  print(a == c)
  print(a != c)
}

// ── the STRUCT element, field-wise, off two stashed element refs ──────────────────────
// @log true
// @log false
// @log true
function structList() {
  const a = [mkc(1), mkc(2)]
  const b = [mkc(1), mkc(2)]
  const c = [mkc(1), mkc(3)]
  print(a == b)
  print(a == c)
  print(a != c)
}

// THE UNION-ARM SPELLING OF THE SAME ELEMENT, and it is a separate case rather than a
// duplicate: declaring `type Shape = Circle | Sq` moves `Circle` OUT of the struct table
// (`collectS` skips an arm), so the element resolves a VARIANT row and a different heap
// type. That is D57's shape reached through the list element, and the first build of this
// rung read the variant eq row's negative ENCODING as "no row" and refused it.
// @log true
// @log false
// @log true
function unionArmElemList() {
  const a = [mkc(1), mkc(2)]
  const b = [mkc(1), mkc(2)]
  const c = [mkc(1), mkc(3)]
  print(a == b)
  print(a == c)
  print(a != c)
}

// @log true
// @log false
// @log true
function nestedStructList() {
  // ANNOTATED, and the annotation is load-bearing for a reason that is NOT this row: an
  // un-annotated `[[mkc(1)]]` is `emitProgram: nested arrays are not supported`, the
  // separate array-LITERAL gap D692 names. The compare is what this fixture pins.
  const a: Circle[][] = [[mkc(1)], [mkc(2)]]
  const b: Circle[][] = [[mkc(1)], [mkc(2)]]
  const c: Circle[][] = [[mkc(1)], [mkc(3)]]
  print(a == b)
  print(a == c)
  print(a != c)
}

// ── the NULLABLE niche over a rep whose core is the generic one ───────────────────────
// `null == null` is TRUE and `null == v` is FALSE — the semantics every other nullable rep
// in the language already answers, and the niche runs the base rep's core UNDER the guard,
// so a rep the plain compare can do is a rep the nullable form can do by construction.
// @log true
// @log false
// @log true
// @log false
function nullableF64List() {
  const a: f64[] | null = [1.5]
  const b: f64[] | null = [1.5]
  const n: f64[] | null = null
  const m: f64[] | null = null
  print(a == b)
  print(a == n)
  print(n == m)
  print(a != b)
}

// @log true
// @log false
// @log true
function nullableStructList() {
  const a: Circle[] | null = [mkc(1)]
  const b: Circle[] | null = [mkc(1)]
  const n: Circle[] | null = null
  print(a == b)
  print(a == n)
  print(n == null)
}

// ── LENGTH still decides first, at every rep ──────────────────────────────────────────
// A core that only walked the shorter of the two would answer TRUE for a prefix.
// @log false
// @log false
// @log false
function lengthDecides() {
  const a = [1.5, 2.5]
  const b = [1.5]
  print(a == b)
  const c = [[1.5], [2.5]]
  const d = [[1.5]]
  print(c == d)
  const e = [mkc(1), mkc(2)]
  const f = [mkc(1)]
  print(e == f)
}

i32List()
stringList()
nestedI32List()
f64List()
i64List()
u8List()
f32List([1.5, 2.5], [1.5, 2.5], [1.5, 3.5])
structParamList([mkc(1), mkc(2)], [mkc(1), mkc(2)], [mkc(1), mkc(3)])
f64LitUnionList()
i32LitUnionList()
strLitUnionList()
nestedF64List()
nestedI64List()
nestedStringList()
tripleNestedI32List()
structList()
unionArmElemList()
nestedStructList()
nullableF64List()
nullableStructList()
lengthDecides()
