  print(g_Ka == g_Kc)
  print(g_Ka != g_Kc)
}

// @log true
// @log false
// @log true
function moduleScopeI32LitUnion() {
  print(g_Na == g_Nb)
  print(g_Na == g_Nc)
  print(g_Na != g_Nc)
}

// @log true
// @log false
// @log true
function moduleScopeNestedI32() {
  print(g_n32a == g_n32b)
  print(g_n32a == g_n32c)
  print(g_n32a != g_n32c)
}

// @log true
// @log false
