// @run
// @log 1.5
// @log 2.5
// @log b
// @log t
// @log 3.5
// @log 7
// @log 1
// An assignment of a list into an un-annotated `[]` or `[] | null` name or field pins the
// element, as a push would, so the binding's cell holds the list written (D2225).
function t() { 1 == 1 }

let x = if t() { [] } else { null }
x = [1.5]
print(x[0])

function local() {
  let y = if t() { null } else { [] }
  y = [2.5]
  print(y[0])
}
local()

const w = { f: if t() { [] } else { null } }
w.f = ["a", "b"]
print(w.f[1])

function plain() {
  let z = []
  z = ["s", "t"]
  print(z[1])
}
plain()

let n = if t() { [] } else { null }
n = if t() { [3.5] } else { null }
if n != null { print(n[0]) }

let i = if t() { [] } else { null }
i = [7]
print(i[0])

let g = if t() { [] } else { null }
if t() { g = [1.5] }
if g != null { print(g.length) }
