// @run
// @log true
// @log 0
// @log true
// @hint redundant type annotation: `g` is inferred as `string[]?`
// @hint redundant type annotation: `gi` is inferred as `i64[]?`
// A DISTINCT-BACKING nullable scalar-list GLOBAL whose non-constexpr init actually
// yields NULL. The non-const global read eagerly recovered the non-null ref
// (`ref.as_non_null`) for every cell kind not on an exclusion list, and the four
// nulscalarlist kinds were not on it — so the `!= null` test itself TRAPPED on the
// value it was testing (`global.get; ref.as_non_null; ref.is_null`). The nulstruct /
// nullist / nulclosure / nulmap cells were already excluded for exactly this reason;
// these four legitimately hold null too.
//
// PRE-EXISTING and INDEPENDENT of the un-annotated-global classifier arm: this spelling
// is ANNOTATED, and it traps on a compiler carrying only that arm's fix.

function mkNull(): string[] | null {
  return null
}

function mkI64Null(): i64[] | null {
  return null
}

const g: string[] | null = mkNull()
print(g == null) // true
if g != null { print(g.length) } else { print(0) } // 0

const gi: i64[] | null = mkI64Null()
print(gi == null) // true

// NOT pinned here, and it is a separate PRE-EXISTING loud reject rather than this
// bug: a CONSTEXPR literal-null init (`const gf: f64[] | null = null`) is rejected with
// `emitProgram: bare null needs a struct-typed context`, on master and on the fix
// alike. Loud, so it is a limitation and not a miscompile.
