// @run
// @log 7
// A one-group spread and a many-group one in one function each copy their own source.
function f(a: i32[], b: i32[]) {
  const x = [...a]
  const y = [...a, 1, ...b]
  return x.length + y.length
}
function g(a: i32[]) {
  const x = [...a]
  return x.length
}
print(f([1, 2], [3]) + g([4]))
