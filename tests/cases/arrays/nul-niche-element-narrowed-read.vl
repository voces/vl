// @run
// @log a
// @log N
// @log true
// @log N
// @log b
// @log n
// @log false
// @log n
// A `(K | null)[]` or `(boolean | null)[]` element read the checker narrows past its null: the
// element is the i32 its niche holds (`-1` or `2` for null), read alike at the narrowed type.
type K = "a" | "b"

function atoms(xs: (K | null)[]) {
  if xs[0] != null { print(xs[0]) } else { print("N") }
  if xs[1] != null { print(xs[1]) } else { print("N") }
}

function bools(xs: (boolean | null)[]) {
  if xs[0] != null { print(xs[0]) } else { print("N") }
  if xs[1] != null { print(xs[1]) } else { print("N") }
}

// The same reads in a generic instance, whose element arrives through the type parameter.
function atomAt<T>(x: T) {
  const xs: (K | null)[] = [null]
  xs[0] = x
  print(xs[0] ?? "n")
}

function boolAt<T>(x: T) {
  const xs: (boolean | null)[] = [null]
  xs[0] = x
  if xs[0] != null { print(xs[0]) } else { print("n") }
}

atoms(["a", null])
bools([true, null])
const kb: K | null = "b"
const kn: K | null = null
atomAt(kb)
atomAt(kn)
const bf: boolean | null = false
const bn: boolean | null = null
boolAt(bf)
boolAt(bn)
