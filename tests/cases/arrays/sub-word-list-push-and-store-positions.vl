// @run
// @log 127
// @log -126
// @log 4464
// @log 0
// @log 32765
// A push onto, and an element store into, a list at each sub-word width takes a plain i32 its
// backing truncates: `i8[]`, `u16[]` and `i16[]`, a record's list field, in a start body and in a
// function, each read back at its width.
type R = { hs: i16[] }
function k(x: i32) { return x }
const a: i8[] = [1]
a.push(k(130))
a[0] = k(-129)
print(a[0])
print(a[1])
const b: u16[] = []
b.push(k(65537))
b[0] = k(70000)
print(b[0])
const r: R = { hs: [0] }
r.hs.push(k(40000))
r.hs[0] = k(-40000)
print(r.hs[0] + r.hs[1])
function fill(n: i32) {
  const c: i16[] = []
  c.push(k(n))
  c.push(k(n + 1))
  c[1] = k(n * 2)
  return c[0] + c[1]
}
print(fill(32767))
