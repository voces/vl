// @error argument 1: expected f64[], got string[]
// @error cannot assign {xs: string[]} to 'w2' of type W
// @error set: expected string[], got f64[]
// @error cannot assign {xs: string[], ys: string[]} to 'w3' of type W3
// TWO CONFLICTING CONSUMERS OF ONE UN-ANNOTATED HOLE — the deliberate REJECT half of the
// container-position pin (D17/D18; the accepting half is
// `tests/cases/arrays/empty-hole-pinned-by-container-position.vl`).
//
// THE RULE THIS PINS, chosen rather than fallen into: a hole pins from the FIRST consumer that
// reaches it, and a conflicting later use is a loud type error. The alternative considered was
// "reject a multiply-consumed hole as ambiguous", and it was rejected for two reasons. First,
// the ACCEPT/REJECT VERDICT here is already order-independent — every pair below rejects in
// BOTH orders, only the wording names whichever consumer came second — so an ambiguity rule
// would buy no determinism the tree does not already have. Second, pin-from-first is the rule
// the CALL-ARGUMENT position has shipped since D16 closed; a second rule for the container
// positions would make one program's verdict depend on which slot the author wrote it into.
//
// Order-dependence remains in the MESSAGE, and that is what these legs pin: `L1` and `L2` are
// the same two consumers in the two orders, and the two `@error` texts differ. A change that
// made the message order-independent should redden this file rather than pass it.
//
// The legs:
//   L1  a `string[]` FIELD then an `f64[]` PARAM — the discriminator D17 was filed with, and
//       the exact program the row's own note says the checker used to accept in silence.
//   L2  the same two consumers in the OTHER order (param first, field second).
//   L3  a `.set` MAP-VALUE write conflicting with an earlier `f64[]` param.
//   L4  two conflicting fields in ONE object literal — a SAME-STATEMENT conflict, which stays
//       loud only because the pin runs before the assignability question at that position.

type W = { xs: f64[] }
type W3 = { xs: string[], ys: f64[] }

function sinkF(ys: f64[]) {
  print(ys.length)
}

function sinkS(ys: string[]) {
  print(ys.length)
}

// L1 — field first, then a conflicting param.
type W1 = { xs: string[] }
function f1() {
  return []
}
const w1: W1 = { xs: f1() }
sinkF(f1())

// L2 — param first, then a conflicting field.
function f2() {
  return []
}
sinkS(f2())
const w2: W = { xs: f2() }

// L3 — a `.set` map-value write conflicting with an earlier param.
function f3() {
  return []
}
sinkF(f3())
const m3: {[string]: string[]} = Map()
m3.set("a", f3())

// L4 — two conflicting fields in one object literal.
function f4() {
  return []
}
const w3: W3 = { xs: f4(), ys: f4() }

print(w1.xs.length + w2.xs.length + m3.size + w3.ys.length)
