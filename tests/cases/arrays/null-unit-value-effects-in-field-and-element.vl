// @run
// @log true
// @log 3
// @log 3
// @log null
// @log 2
// @log 4
// A `null` unit value that runs for effect, as a record field and as a `null[]` literal's element:
// the value runs in order, then the slot holds its null.
type H = { n: null }
let calls = 0
function eff(): null {
  calls = calls + 1
  return null
}
function run(k: i32) {
  const a: null[] = [null, null]
  const h: H = { n: eff() }
  print(h.n == null)
  const xs: null[] = [eff(), null, eff()]
  print(xs.length)
  print(calls)
  const h2: H = { n: a[k] }
  print(h2.n)
  const ys: null[] = [a[k], eff()]
  print(ys.length)
  print(calls)
}
run(1)
