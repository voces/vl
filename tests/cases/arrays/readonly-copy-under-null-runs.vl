// @run
// @log 3.5
// @log none
// @log 7
// A readonly list that needs a converting copy takes it under `| null` too (D2196).
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq

function f(x: readonly f64[] | null) {
  if x != null { print(x[0] / 2) } else { print("none") }
}
const ints = [7]
f(ints)
f(null)
const cs: Circle[] = [{ r: 7 }]
const w: readonly Shape[] | null = cs
if w != null {
  const c = w[0]
  if c is Circle { print(c.r) }
}
