// @run
// @log -1
// @log 0
// @log 0
// @log -1
// @log 4
// @log a
// @log 5
// @log 7
// @log 1
// @hint redundant type annotation: `nodes` is inferred as `{count: i32, symbol: i32}[]`
// @hint redundant type annotation: `rows` is inferred as `i32[][]`
// @hint redundant type annotation: `rows2` is inferred as `i32[][]`
// @hint redundant type annotation: `nodes2` is inferred as `{count: i32, symbol: i32}[]`
// @hint redundant type annotation: `gs` is inferred as `{count: i32, symbol: i32}[]`
// @hint redundant type annotation: `hs` is inferred as `string[][]`
// @hint redundant type annotation: `ps` is inferred as `{count: i32, symbol: i32}[]`
// @hint redundant type annotation: `qs` is inferred as `i32[][]`
// D1605 — one generic `T[]` constructor over `__array_new__`, pinned at TWO element reps
// in one module.
//
// The monomorphizer rebuilds only an instance's statement spine, so the `__array_new__`
// call node is SHARED by every instance and its recorded fill type is still the template's
// `T`. `refListElemNameOfExpr` answered "" for that, `refListSlotOfExpr` clamped the miss
// to slot 0 — a real row, the first ref element interned — and the second instance built
// its list at the first one's backing and wrapper heap types.
//
// The order is in this file because it decided the outcome: struct-then-nested was
// check-clean invalid wasm and nested-then-struct ran, since the clamp landed on the
// right row by luck. Both orders and both faces are pinned below.
type Node = { count: i32, symbol: i32 }

function filled<T>(n: i32, v: T): T[] { return __array_new__(n, v) }

// Struct first, nested list second — the order that used to fail.
const nodes: Node[] = filled(2, { count: 0, symbol: -1 })
const rows: i32[][] = filled(2, [0, 0])
print(nodes[1].symbol)
print(rows[1][0])

// The reversed order is the control: it ran before this row and must keep running.
function pair2() {
  const rows2: i32[][] = filled(2, [0, 0])
  const nodes2: Node[] = filled(2, { count: 0, symbol: -1 })
  print(rows2[1][0])
  print(nodes2[1].symbol)
}
pair2()

// TWO generic functions rather than two instances of one: the clamp reads a module-wide
// table, so the wrong row crossed function boundaries too.
function mkA<T>(n: i32, v: T): T[] { return __array_new__(n, v) }
function mkB<T>(n: i32, v: T): T[] { return __array_new__(n, v) }
const gs: Node[] = mkA(2, { count: 3, symbol: 4 })
const hs: string[][] = mkB(2, ["a"])
print(gs[1].symbol)
print(hs[1][0])

// The UN-ANNOTATED face. The annotation is not the ingredient — the instance's parameter
// annotation is what answers, and it is written by the monomorphizer either way.
const anonNodes = filled(2, { count: 5, symbol: 6 })
const anonRows = filled(2, [7, 8])
print(anonNodes[1].count)
print(anonRows[1][0])

// A `push`-loop constructor of the same signature always ran, and still does — it is the
// negative control that says the defect is the intrinsic's element channel, not generics.
function pushFilled<T>(n: i32, v: T): T[] {
  const out: T[] = []
  let i = 0
  while i < n {
    out.push(v)
    i = i + 1
  }
  return out
}
const ps: Node[] = pushFilled(2, { count: 1, symbol: 1 })
const qs: i32[][] = pushFilled(2, [1])
print(ps[1].symbol + qs[1][0] - 1)
