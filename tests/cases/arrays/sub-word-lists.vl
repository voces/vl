// @run
// @log -127
// @log -3
// @log -56
// @log 64464
// @log -25536
// @log 32767
// @log -32768
// @log 3
// @log 7231
// @log true
// Each sub-word list keeps a computed element's low bits at its width and reads it back
// widened: `i8[]` and `i16[]` sign-extend, `u8[]` and `u16[]` zero-extend.
function k(n: i32) { n }

const a: i8[] = [1, -3]
a.push(k(200))
a[0] = k(129)
print(a[0])
print(a[1])
print(a[2])

const b: u16[] = [60000]
b.push(k(70000))
print(b[0] + b[1])

const c: i16[] = []
c.push(k(40000))
c.push(k(-32769))
print(c[0])
print(c[1])

// A list of lists, a record field, and a walk.
type R = { f: i16[] }
const r: R = { f: [k(32768), 7] }
print(r.f[0])
const nested: u16[][] = [[k(65537)], [2]]
print(nested[0][0] + nested[1][0])
let s = 0
for x in c { s = s + x }
print(s)
const want: i8[] = [-127, -3, -56]
print(a == want)
