// @run
// @log 8
// @log 3
// @log 1
// @log 4
// @log 7
// @log 0
// @log 3
// D983 — A `u8[] | null` DESTINATION FED BY AN ARRAY LITERAL. The cell was typed from
// `nulu8list` as the packed-byte wrapper while the literal built the shared i32 backing:
// two heap types for one value, and `vl check` returned 0 — check-clean invalid wasm.
//
// The build kind is the whole story. `nulScalarListBuildKind` maps `nulu8list` to 13, and
// the literal emitter's packed-byte path tested only `pendingListKind == 10`. Its three
// siblings each have an arm that flips the literal's element flag (4 -> f64, 6 -> i64,
// 7 -> f32); 13 never got one, so the literal fell through to the default i32 backing.
// `coerceListKind` had already normalised 13 to 10 elsewhere for exactly this reason.
//
// The `ba8Used` collector arms are the second half and are NOT optional: with the literal
// path reached but the backing uncollected, the same programs traded silent invalid wasm
// for a loud `u8 array literal but u8 list type not collected`. Both halves, or neither.
//
// Every delivery position a `u8[] | null` literal has, one line each — the matrix is the
// point, since wiring one position and narrowing the gate is how a capability gap ships as
// invalid wasm at the six positions nobody wired.
const g: u8[] | null = [7, 8]

if g is u8[] { print(g[1]) }

function localBinding() {
  const b: u8[] | null = [3, 4]
  if b is u8[] { print(b[0]) }
}

localBinding()

function ret(): u8[] | null { return [1, 2, 3] }

const r = ret()

if r is u8[] { print(r[0]) }

function arg(x: u8[] | null) {
  if x is u8[] { print(x[1]) }
}

arg([9, 4])

let asg: u8[] | null = null

asg = [6, 7]

if asg is u8[] { print(asg[1]) }

const empty: u8[] | null = []

if empty is u8[] { print(empty.length) }

const nul: u8[] | null = null

if nul is u8[] { print(nul.length) } else { print(3) }
