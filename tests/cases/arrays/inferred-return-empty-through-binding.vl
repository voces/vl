// @log 7
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// D626: an INFERRED return of an empty `[]` that reaches the `return` through a BINDING.
// `function mk() { const cc = []  sink(cc)  return cc }` over `sink(_x: P[])` was `vl check`
// rc 0 and a module the engine refused.
//
// ONLY THE SIGNATURE WAS WRONG, WHICH IS THE MIRROR OF D625. Disassembled, `mk` was
// `(func (result (ref $4)))` — the i32-list wrapper — over a body whose local is `(ref $6)`
// and whose build is `array.new_fixed $5` / `struct.new $6`, both already correct. D625 had
// the signature right and the body wrong; here the body is right and the signature wrong.
// The three lines that change are all on the signature side, including the caller's
// `struct.get 6 1` where it used to read field 1 of the wrong wrapper.
//
// RUNG 1 — THE NODE. `criClassify`'s empty-`[]` arm reads `emptyArrHoleKind(rx)` off the
// RETURN EXPRESSION, and `emptyArrLitIxOf` unwraps only PARENS, so a bare ident is not an
// `ArrayLit` and the arm returns `null`. Probed on the witness: `holeAtRx=0` against
// `holeAtInit=1 holeInitName=[{r: i32}]` — the answer was one node away. `criRetHoleNode`
// resolves it through `retLocalLetOfBlock`, the SAME lookup `criRetLocalLet` and
// `synthRetPinAnn` already share, which hops un-annotated alias chains and stops at an
// annotated binding.
//
// RUNG 2 — THE NAME. A NESTED element renders structurally (`{r:i32}[]`) while the row the
// `P[][]` annotation interned is keyed `P[]`. Probed: `byName=-1 byTy=1`. `rlSlotOfTy` is the
// layer's own arena entry point and its header prescribes exactly this shape, so the arena
// picks the ROW and the row's own `rlElemName` is what is returned — because every consumer
// of this answer resolves it BY NAME (`fRetRArrElem`, read back through `rlSlotByName` at two
// sites). L12 is the leg that needs both rungs; neither alone makes it run.
//
// THE DISTILLED CORPUS SCORES THIS AT ZERO. Its `mkc` shapes all ANNOTATE the return, so no
// cell sits at this coordinate: 0 classes moved, 0 `runs` gained, and the whole family is
// invisible to the standing gate. That is why the grid is pinned here whole rather than
// collapsed, and why `distilled/named/d626/` carries it too.
//
// L16–L18 are the DECLINES and they must stay declines: a returned PARAM (no binding to
// resolve), a returned local whose init is a CALL (its producer already committed a rep), and
// a local carrying its OWN annotation (the annotation decides, and following past it would
// answer about the initializer instead).

type P = { r: i32 }
type A = { a: i32 }
type B = { b: i32 }
type U = A | B

function sink(_x: P[]) {}
function sinkPP(_x: P[][]) {}
function sinkS(_x: string[]) {}
function sinkF(_x: f64[]) {}
function sinkG(_x: f32[]) {}
function sinkU(_x: U[]) {}
function sinkM(_x: {[string]: i32}[]) {}
function sinkC(_x: ((i32) => i32)[]) {}

// L1 — the filed repro.
function mk1() {
  const cc = []
  sink(cc)
  return cc
}
print(mk1().length)

// L2 — one ALIAS hop between the literal and the return. Loud on master
// (`'.length' on a receiver the emitter cannot classify`), not silent — the same root at a
// different symptom.
function mk2() {
  const cc = []
  sink(cc)
  const dd = cc
  return dd
}
print(mk2().length)

// L3 — two hops. The chain walk is bounded, not one-shot.
function mk3() {
  const cc = []
  sink(cc)
  const dd = cc
  const ee = dd
  return ee
}
print(mk3().length)

// L4 — a PAREN around the returned ident: both unwraps compose.
function mk4() {
  const cc = []
  sink(cc)
  return (cc)
}
print(mk4().length)

// L5 — a `string` element.
function mk5() {
  const cc = []
  sinkS(cc)
  return cc
}
print(mk5().length)

// L6 — an `f64` element.
function mk6() {
  const cc = []
  sinkF(cc)
  return cc
}
print(mk6().length)

// L7 — an `f32` element.
function mk7() {
  const cc = []
  sinkG(cc)
  return cc
}
print(mk7().length)

// L8 — the element pinned by `.push` rather than by a call argument.
function mk8() {
  const cc = []
  cc.push({ r: 7 })
  return cc
}
print(mk8().length)

// L9 — a UNION element: the kind-2 box.
function mk9() {
  const cc = []
  sinkU(cc)
  return cc
}
print(mk9().length)

// L10 — a MAP element.
function mk10() {
  const cc = []
  sinkM(cc)
  return cc
}
print(mk10().length)

// L11 — a CLOSURE element: the kind-5 fat pointer.
function mk11() {
  const cc = []
  sinkC(cc)
  return cc
}
print(mk11().length)

// L12 — a NESTED element over a DECLARED struct. Needs BOTH rungs: rung 1 to read the hole
// off the binding, rung 2 because `{r:i32}[]` is not the key `P[]` was filed under.
function mk12() {
  const cc = []
  sinkPP(cc)
  return cc
}
print(mk12().length)

// L13 — an `i32` element: the case the i32-list DEFAULT was already right for, and which
// must stay byte-identical.
function mk13() {
  const cc = []
  const ii: i32[] = cc
  print(ii.length)
  return cc
}
print(mk13().length)

// L14 — the literal returned DIRECTLY, with no binding: D16's own case, unchanged.
function mk14() {
  sink([])
  return []
}
print(mk14().length)

// L15 — the RETURN annotated: it reads its own annotation and never consults the hole.
function mk15(): P[] {
  const cc = []
  sink(cc)
  return cc
}
print(mk15().length)

// L16 — a DECLINE: the returned value is a PARAM, so there is no binding to resolve.
function mk16(cc: P[]) {
  sink(cc)
  return cc
}
print(mk16([]).length)

// L17 — a DECLINE: the local's init is a CALL, whose producer already committed a rep.
function src17(): P[] {
  const z: P[] = []
  return z
}
function mk17() {
  const cc = src17()
  sink(cc)
  return cc
}
print(mk17().length)

// L18 — a DECLINE: the local carries its OWN annotation, which decides.
function mk18() {
  const cc: P[] = []
  sink(cc)
  return cc
}
print(mk18().length)

// L19 — the RESULT VALTYPE is load-bearing beyond `.length`: the caller reads an ELEMENT
// through it. On master this was `emitProgram: field access receiver is not a struct`.
function mk19() {
  const cc = []
  cc.push({ r: 7 })
  return cc
}
function rd19() {
  const g = mk19()
  if g.length > 0 { print(g[0].r) } else { print(0) }
}
rd19()
