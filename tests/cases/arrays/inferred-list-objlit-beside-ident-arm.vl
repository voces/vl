// @run
// @log 7
// @log 2
// @hint redundant type annotation: `c` is inferred as `{s: i32}` — remove it to lean on inference
// The `Sq` annotation on `c` is DECLARED rather than deleted: it is what makes the ident
// element a named arm rather than an anonymous shape, which is the ingredient under test.
// THE BOUND ON D361's RUNG, and the only population that separates it. An un-annotated
// literal mixing an OBJECT LITERAL with an IDENT of the other arm really does hold a
// union, so it must keep the kind-2 box. `arrLitObjElemsOneVariant` requires EVERY element
// to be an object literal for exactly this reason: ablate that requirement — compare only
// the object-literal elements and ignore the rest — and this program goes from `runs` to
// `emitProgram: ...`, while census block E, the 96-cell set the landing was measured on,
// grades the ablation identically to the shipped rung (96 -> runs either way). Nothing in
// the corpus covered this shape before, which is why it is here.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function f() {
  const c: Sq = { s: 2 }
  const xs = [{ r: 7 }, c]
  const e0 = xs[0]
  if e0 is Circle { print(e0.r) } else { print(0) }
  const e1 = xs[1]
  if e1 is Sq { print(e1.s) } else { print(0) }
}
f()
