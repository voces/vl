// @run
// @log 1.5
// @log 1.5
// @log 3
// @log 2
// @log 8
// A spread of an existing list whose record element carries a numeric field the destination's
// record drops is built at the destination's list type, each element copied as it is (D14960).
type Shape = { r: f64 }
type Circle = { r: f64, w: f64 }
function total(...xs: Shape[]) { xs[0].r }
const cs: Circle[] = [{ r: 1.5, w: 2.0 }]
print(total(...cs))
const ys: Shape[] = [...cs, { r: 3.0 }]
print(ys[0].r)
print(ys[1].r)
print(ys.length)
function count(...xs: Shape[]) { xs.length * 4 }
print(count(...cs, ...cs))
