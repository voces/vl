// @run
// @log 1.5
// @log 2.5
// @log 1
// The `.map` cell of `f32-array-literal-self-classifies.vl`, which that file cannot
// carry: `f32bits` is not callable in a module that holds a function value, and a lambda
// is one. The bit-pattern oracle is therefore traded for the rendered float here, and
// only here.
//
// `.map` over an INFERRED f32 list was the LOUD half of the same missing arm — the
// collection scanner had no `arrLitIsF32` case, so the literal forced no f32 wrapper and
// `.map`'s own result-kind check rejected: "emitProgram: .map result is f32[] but f32
// list type not collected". One arm answers for the loud cell and the silent ones alike.
function body() {
  const a: f32 = 1.5
  const xs = [a]
  const ys = xs.map((v: f32) => v)
  print(ys[0])
  const zs = xs.map((v: f32) => v + 1.0)
  print(zs[0])
  print(zs.length)
}
body()
