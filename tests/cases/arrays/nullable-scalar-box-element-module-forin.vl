// @run
// @log a
// @log N
// @log b
// @log 1
// @log 0
// @log 2
// @log 1
// @log 3
// @log 2
// @log 1
// @log 0
// @log 2
// @log 1
// @log 0
// @log 2
// @log 1
// @log 0
// @log 2
// @log 1
// @log 0
// @log 2
// @log 1
// @log 0
// @log 2
// @log 1
// @log 0
// @log 2
// @log 1.5
// @log 0
// @log 2.5
// @hint redundant type annotation: `cs` is inferred as `string?[]`
// @hint redundant type annotation: `xs` is inferred as `i32?[]`
// @hint redundant type annotation: `w` is inferred as `{xs: i32?[]}`
// @hint redundant type annotation: `rows` is inferred as `i32?[][]`
// @hint redundant type annotation: `ls` is inferred as `i32?[]`
// @hint redundant type annotation: `fs` is inferred as `f64?[]`
// @hint Intentionally-unused parameter `_e` (leading `_` marks it unused)
// @info `ls` is never reassigned; use `const` instead of `let`
// A `for` over a `(scalar | null)[]` — a value-union BOX element — at MODULE SCOPE.
//
// The loop-var union resolution lived inside `unionNameOfIdentSid`'s `fnIx >= 0` /
// `fn is FuncDecl` block, so a TOP-LEVEL `for` — which runs in the START function, where
// there is no `FuncDecl` body to scan — reached NO arm. `declareForInLocals` is shared
// between the two walks and declared the slot as the kind-4 box either way, so the
// narrowed read had a `(ref $uBox)` local and no member set to unbox through: it pushed
// the raw box where the loop var's own valtype said the unboxed scalar. `vl check` rc 0,
// `Invalid input WebAssembly code: type mismatch: expected i32, found (ref $type)`.
//
// The in-function spelling of every row below has always run, and so has the
// `(string | null)[]` NICHE control at the top — which is what makes this a missing arm
// and not an unsupported shape. `forInLoopVarUnionName` is the one home both walks ask,
// the same relation `startBlockLetOfSid` has to `parentLetOfSid`.
//
// A LOG mismatch is not reachable for this defect: the module never validated on master,
// so the pin is the build verdict plus the values it emits once it does.
type W = { xs: (i32 | null)[] }

function mkI32(): (i32 | null)[] { [1, null, 2] }
// A predicate that does NOT compare the box: `e == null || e >= 0` is check-clean invalid
// wasm on master AND here (the `||` right operand carries no complement narrowing for the
// box rep) — a different ladder, and out of this fixture's scope.
function keepAll(_e: i32 | null) { true }

// ---- (string | null)[] — the NICHE control: green before and after ----
const cs: (string | null)[] = ["a", null, "b"]
for c in cs { if c != null { print(c) } else { print("N") } }

// ---- (i32 | null)[], a null element PRESENT ----
const xs: (i32 | null)[] = [1, null, 2]
for x in xs { if x != null { print(x) } else { print(0) } }

// ---- the same rep with NO null element ----
const ys: (i32 | null)[] = [1, 3, 2]
for y in ys { if y != null { print(y) } else { print(0) } }

// ---- the module-scope read forms that shared the one blind walk ----
for s in xs.slice(0, 3) { if s != null { print(s) } else { print(0) } }
for f in xs.filter(keepAll) { if f != null { print(f) } else { print(0) } }
for r in mkI32() { if r != null { print(r) } else { print(0) } }

const w: W = { xs: [1, null, 2] }
for v in w.xs { if v != null { print(v) } else { print(0) } }

const rows: (i32 | null)[][] = [[1, null], [2]]
for row in rows {
  for e in row { if e != null { print(e) } else { print(0) } }
}

let ls: (i32 | null)[] = [1, null, 2]
for l in ls { if l != null { print(l) } else { print(0) } }

// ---- (f64 | null)[] — the other scalar box rep, same walk ----
const fs: (f64 | null)[] = [1.5, null, 2.5]
for d in fs { if d != null { print(d) } else { print(0.0) } }
