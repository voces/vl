// @run
// @log 7
// An un-annotated list literal whose two object literals DISAGREE structurally but denote
// the SAME union arm, stored into a declared map value (silent-class-inventory D361).
// `{ r: { c2: 1 } }` and `{ r: { s2: 1 } }` join to `{r:Cir2}|{r:Sq2}` in the checker,
// because the two `r` values have different shapes — but BOTH literals are `Circle` by
// field-name set, so the list is a list OF that arm and not a list of union boxes.
// `arrLitObjElemBoxVariant` widened on the recorded union alone and minted the kind-2 box
// element; the `{[string]: Circle[]}` destination wanted the arm's own struct, and the two
// met at the store: `vl check` rc 0 and `expected (ref null $type), found (ref $type)` at
// instantiation. `arrLitObjElemsOneVariant` asks the box arm's own predicate of EVERY
// element, so a literal that names one arm lands on kind 1 under that arm's name — the
// same slot the annotated `Circle[]` spelling interns.
type Cir2 = { c2: i32 }
type Sq2 = { s2: i32 }
type Shape2 = Cir2 | Sq2
type Circle = { r: Shape2 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function rd() {
  const lv1 = [{ r: { c2: 1 } }, { r: { s2: 1 } }]
  const c: {[string]: Circle[]} = Map()
  c["k0"] = lv1
  const g0 = (c)["k0"] ?? []
  const g1 = g0
  if g1.length > 0 {
    const e0 = g1[0]
    if e0.r is Cir2 { print(7) } else { print(0) }
  } else { print(0) }
}
rd()
