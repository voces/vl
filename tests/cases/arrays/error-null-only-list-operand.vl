// @error-at 5:10 a list of only `null` takes no element type from a `+` operand or a spread
// @error-at 6:34 a list of only `null` takes no element type from a `+` operand or a spread
// A `+` operand or spread source takes no element type from the destination around it, so the
// refusal says to bind it first (D1832); a `null[] | null` destination names `null` and types it.
let xs: (i32 | null)[] = [1]
xs = xs + [null]
const ys: (i32 | null)[] = [1, ...[null]]
const z: null[] | null = [null]
print(xs.length + ys.length)
