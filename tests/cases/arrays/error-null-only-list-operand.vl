// @error-at 7:11 a list of only `null` takes no element type from a `+` operand or a spread
// @error-at 8:35 a list of only `null` takes no element type from a `+` operand or a spread
// @error-at 9:26 a list of only `null` has no element type
// A `+` operand or spread source takes no element type from the destination around it, so the
// refusal says to bind it first (D1832); a destination whose only list member is `null[]` names none.
let xs: (i32 | null)[] = [1]
xs = xs + [null]
const ys: (i32 | null)[] = [1, ...[null]]
const z: null[] | null = [null]
print(xs.length + ys.length)
