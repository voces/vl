// @run
// @log 3
// @log 200
// @log 200
// @log 200
// @log 1
// @log 200
// @log 200
// @log 3
// @log 200
// @log 200
// @log 200
// @log 255
// @log 4
// @hint Intentionally-unused parameter `_e`
// D12902: a `.map` typed `u8[]` builds the packed byte list. Its callback's return reads as an
// `i32`, so the result kind used to name the plain `i32` list and the module failed validation
// at the store. Each cell prints a byte above 127, so a backing read signed or at the wrong
// width cannot pass; both faces of the binding and the `.filter` twin are here.

// Module scope, un-annotated and annotated binding.
const xs: u8[] = [1, 200, 7]
const m = xs.map((e) => e)
print(m.length)
print(m[1])
const ma: u8[] = xs.map((e) => e)
print(ma[1])
const fm = xs.filter((_e) => true).map((e) => e)
print(fm[1])

// Inline read, a chain and a loop over the result.
print(xs.map((e) => e)[0])
print(xs.map((e) => e).map((e) => e)[1])
for e in xs.map((e) => e) {
  if e > 100 { print(e) }
}

// Argument, return, struct field and push.
function len(ys: u8[]) { return ys.length }
print(len(xs.map((e) => e)))
function copy(ys: u8[]) { return ys.map((e) => e) }
print(copy(xs)[1])
type B = { bs: u8[] }
const b: B = { bs: xs.map((e) => e) }
print(b.bs[1])
print(b.bs.map((e) => e)[1])
const p = xs.map((e) => e)
p.push(255)
print(p[3])
print(p.length)
