// @run
// @log 0.5
// @log 1.5
// A readonly list of lists over a `const` list literal of fresh lists, read only at the
// delivery, is copied element by element (D2196).
function mk() { return [5, 6] }
function show(v: readonly (readonly f64[])[]) { print(v[0][1] / 4) }

const a: i32[][] = [[1, 2], [3]]
show(a)
const b: i32[][] = [mk(), [7]]
show(b)
