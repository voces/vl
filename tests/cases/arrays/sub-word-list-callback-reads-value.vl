// @run
// @log 1
// @log 250
// @log -12
// @log 65001
// @log 1
// @log 44
// @log 200
// A `.filter` or `.map` callback over a sub-word list takes each element as its `i32` value, and
// a fresh `.map` result meeting a sub-word list is built at that storage, as a literal of
// computed values is: each value keeps its low bits.
const b: u8[] = [250, 7]
print(b.filter((x) => x == 7).length)
print(b.filter((x) => x > 100)[0])
const c: i8[] = [-6, 7]
print(c.map((x) => x * 2)[0])
const d: u16[] = [65000, 7]
print(d.map((x) => x + 1)[0])
print(b.filter((x: i32) => x == 7).length)
const e: u8[] = [1, 200].map((x) => x + 100)
print(e[1])
const ns = [1, 200]
const f: u8[] = ns.map((x) => x)
print(f[1])
