// @run
// @log 1
// @log true
// @log 1
// @log 2
// The copy the record-list widening refusal names, run at each spelling it suggests it for
// (D14514): a fresh record per element, built from the destination's field list.
type Circle = { r: i32 | null }
type Pair = { r: i32, k: i32 }
type Spot = { r: i32 | null, k: i32 }

function mk() {
  const cc = [{ r: null }]
  return cc
}
function own(x: Circle[]) { print(x.length) }
function view(x: readonly Circle[]) { print(x[0].r == null) }
function spots(x: Spot[]) { print(x[0].r ?? 0) }
const ps: Pair[] = [{ r: 1, k: 2 }]
own(mk().map((x): Circle => { r: x.r }))
view(mk().map((x): Circle => { r: x.r }))
spots(ps.map((x): Spot => { r: x.r, k: x.k }))
print(ps[0].k)
