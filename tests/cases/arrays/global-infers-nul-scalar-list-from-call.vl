// @run
// @log true
// @log 2
// @log true
// @log 1
// @log true
// @log true
// An UN-ANNOTATED module GLOBAL bound to a `string[] | null` / `f64[] | null` /
// `i64[] | null` / `f32[] | null`-returning call infers the DISTINCT-BACKING nullable
// scalar-list cell — its own `(ref null $wrapper)` — exactly as the ANNOTATED spelling
// one arm up already does. Without the arm the cell was typed i32 while the start
// function stored the wrapper ref into it: INVALID WASM, `vl check` clean and
// `vl build` reporting success.
//
// The four kinds were found by RE-RUNNING the rep-kind sweep instead of inheriting its
// verdict: the hand-off recorded `nulmap` as the only silent-and-wrong kind in this
// position, and these four are silent-and-wrong in exactly the same way.

function mkStr(): string[] | null {
  return ["a", "b"]
}

function mkNull(): string[] | null {
  return null
}

function mkF64(): f64[] | null {
  return [1.5]
}

function mkI64(): i64[] | null {
  return null
}

function mkF32(): f32[] | null {
  return null
}

const gs = mkStr()
print(gs != null) // true
if gs != null { print(gs.length) } // 2

const gn = mkNull()
print(gn == null) // true

const gf = mkF64()
if gf != null { print(gf.length) } // 1

const gi = mkI64()
print(gi == null) // true

const g3 = mkF32()
print(g3 == null) // true
