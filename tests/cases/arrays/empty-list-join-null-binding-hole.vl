// @run
// @info `y` is never reassigned; use `const` instead of `let`
// @log const 1
// @log let 1 q
// @log local 1 q
// @log local -1
// @log reversed 1 q
// @log nested 1 q
// @log f64 1 2.5
// @log field 1 q
// @log loop 1
// @log loop -1
// A binding of an un-annotated `[] | null` join, or a record field holding one, handed to a hole
// takes the element the body writes, as a bare `[]` binding does (D6270).
import { toString } from "std:fmt"

function t() { 1 == 1 }

function take(tag: string, a) {
  if a != null {
    a.push("q")
    print(tag + " " + toString(a.length) + " " + a[0])
  } else {
    print(tag + " -1")
  }
}

function count(tag: string, a) {
  if a != null {
    a.push("q")
    print(tag + " " + toString(a.length))
  } else {
    print(tag + " -1")
  }
}

const x = if t() { [] } else { null }
count("const", x)

let y = if t() { [] } else { null }
take("let", y)

function local(c: boolean) {
  const z = if c { [] } else { null }
  take("local", z)
}
local(true)
local(false)

const r = if !t() { null } else { [] }
take("reversed", r)

const n = if t() { if t() { [] } else { null } } else { null }
take("nested", n)

function num(a) {
  if a != null {
    a.push(2.5)
    print("f64 " + toString(a.length) + " " + toString(a[0]))
  }
}
const f = if t() { [] } else { null }
num(f)

const rec = { xs: if t() { [] } else { null } }
take("field", rec.xs)

let i = 0
while i < 2 {
  const w = if i == 0 { [] } else { null }
  count("loop", w)
  i = i + 1
}
