// @run
// @hint redundant type annotation: `l` is inferred as `i32[]` — remove it to lean on inference
// @hint redundant type annotation: `g` is inferred as `i32[]` — remove it to lean on inference
// @hint redundant type annotation: `get` is inferred as `i32[]` — remove it to lean on inference
// @hint redundant type annotation: `k` is inferred as `i32[]` — remove it to lean on inference
// @hint redundant type annotation: `g0` is inferred as `f64 | null` — remove it to lean on inference
// @log 3
// @log 3
// @log 3
// @log 9
// @log 7
// @log 2
// @log 9
// @log 8
// @log 3
// @log 3
// @log 3
// @log 7
// @log 9
// @log true
// @log 5
// @log 1.5
// D3028: an `i32[]` or `f32[]` delivered as a wider `readonly` list from a source the write
// analysis cannot follow (a parameter, a call result) is a view of that source, so a write the
// caller makes after the delivery is seen through it by every read.
function back(x: i32[]): readonly i64[] { return x }
const l: i32[] = [1, 2]
const r = back(l)
l.push(3)
print(r.length)

const g: i32[] = [1, 2]
function get(): i32[] { return g }
const y = get()
const r2: readonly f64[] = y
g.push(9)
print(r2.length)

let keep: readonly i64[] = []
function st(v: readonly i64[]) { keep = v }
function pass(x: i32[]) { st(x) }
const k: i32[] = [1, 2]
pass(k)
k.push(9)
print(keep.length)
print(keep[2])

// Every read of the view sees the source as it is at the read.
function reads(v: readonly f64[]) {
  print(v[0])
  for e in v {
    if e > 8.0 { print(v.length - 1) }
  }
  print(v[2])
  print(v.map((e) => e + 1.0)[0])
  print(v.slice(1).length + 1)
  print(v.filter((e) => e > 1.0).length)
  const gv = v.get(1)
  if gv != null { print(gv + 1.0) }
  const g0: f64 | null = v.get(0)
  print(g0)
  print(v.get(2))
  const w: readonly f64[] = [7.0, 2.0, 9.0]
  print(v == w)
}
g[0] = 7
reads(r2)

// A walk whose body grows the source sees the new elements, as a walk of the source does.
function grow() {
  if g.length < 5 { g.push(4) }
}
function walk(v: readonly f64[]) {
  let n = 0
  for e in v {
    grow()
    if e > 0.0 { n = n + 1 }
  }
  print(n)
}
walk(r2)

// An `f32[]` source reads widened.
const fs: f32[] = [0.5]
function getF(): f32[] { return fs }
const fy = getF()
const r4: readonly f64[] = fy
fs.push(1.5)
print(r4[1])
