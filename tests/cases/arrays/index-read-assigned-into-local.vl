// @run
// @log 5
// @log 5
// @log 7
// @log 1.5
// @log true
// D1500 — a bare INDEX read assigned into a function-local `let` TRAPPED THE COMPILER.
// `exprEmittedRefListSlot`'s `Index` arm consumed `refListSlotOfExpr`, which CLAMPS a miss
// to row 0; a module whose only arrays are scalar interns no ref-list row, so `rlElemName`
// is EMPTY and slot 0 was an out-of-bounds read inside the seed — `vl check` rc 0, then
// `wasm trap: out of bounds array access` with no function names, which reads to a user as
// THEIR index being out of range. The arm now takes `refListSlotOfExprStrict`, and the
// fall-through it reached bound-guards its own read.
//
// NOTHING HERE IS ANNOTATED PAST THE PARAMETER, on purpose: the trap fired at both faces,
// and an annotated return is a different program. `f` is the reporter's verbatim witness;
// `g` is its `return` spelling, which also trapped. Every scalar element rep is a witness
// because none of them interns a ref-list row, and the `while` is the shape the reporting
// consumer actually wrote. The DECLARATION (`let len = xs[0]`) always ran, which is why
// nothing caught it: only `emitAssign`'s `local.set` arm asks the classifier pair.
function f(xs: i32[]) {
  let len = 0
  len = xs[0]
  len
}

function g(xs: i32[]) {
  let len = 0
  len = xs[0]
  return len
}

function loop(xs: i32[]) {
  let last = 0
  let i = 0
  while i < xs.length {
    last = xs[i]
    i = i + 1
  }
  return last
}

function ff(xs: f64[]) {
  let v = 0.0
  v = xs[0]
  return v
}

function fb(xs: boolean[]) {
  let v = false
  v = xs[0]
  return v
}

print(f([5]))
print(g([5]))
print(loop([5, 7]))
print(ff([1.5]))
print(fb([true]))
