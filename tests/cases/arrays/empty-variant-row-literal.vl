// @run
// @log 0
// @log 1
// @log 0
// An empty literal of a union variant's record list builds as the plain short list.
type A = { a: i32 }
type B = { b: i32 }
type U = A | B
let rows: A[][] = [[{ a: 1 }]]
function drop(ci: i32): i32 {
  const none: A[] = []
  rows[ci] = none
  return rows[ci].length
}
function fresh(): A[] {
  const xs: A[] = []
  xs.push({ a: 2 })
  return xs
}
function pick(u: U): i32 {
  if u is A { return u.a }
  return 0
}
print(drop(0))
print(fresh().length)
print(pick({ b: 3 }))
