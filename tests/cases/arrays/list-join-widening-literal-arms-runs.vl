// A join whose wider arm is a list literal builds that literal at the joined type, so a
// literal beside a literal needs no copy, and a list that already exists joins once the
// author copies it with `.map`, the fix `error-list-join-widening.vl` prints. Each value
// printed divides by a float, so an element still read as an `i32` would print whole.
// @run
// @log 0.625
// @log 0.5
// @log 1.5
// @log true
// @log 0.25
// @log 2.5
function t() { 1 == 1 }
function u() { 1 == 2 }

const q1 = if u() { [1] } else { [2.5] }
print(q1[0] / 4.0)

const q2 = if u() { [1] } else if t() { [2] } else { [2.5] }
print(q2[0] / 4.0)

const a: i32[] | null = [3]
const q3 = a?.map((x) => x as f64) ?? [2.5]
print(q3[0] / 2.0)

const f32s = [(1.1 as f32)]
const q4 = if t() { f32s.map((x) => x as f64) } else { [2.2] }
print(q4[0] > 1.0)

function ret(xs: i32[], c: boolean) {
  if c { return xs.map((x) => x as f64) }
  [2.5]
}
print(ret([1], true)[0] / 4.0)

const b: f64[] | null = null
const q5 = b ?? [2.5]
print(q5[0])
