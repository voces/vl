// @emit-error emitProgram: bare null needs a struct-typed context
// `u8[] | null` IS NOT A BOX, AND THAT IS WHY IT IS STILL REFUSED after #1806 taught the
// union box about the packed byte list.
//
// A two-member `T[] | null` does not lower to the `{tag, payload}` box at all: it is a
// NICHE — the wrapper ref itself, made nullable, with `ref.null` standing for the null
// member and no tag anywhere. That rep is a per-backing VKind (`nullist` for `i32[]`,
// `nulstrlist`, `nulf64list`, `nuli64list`, `nulf32list`), and `nulScalarListKind` is its
// one home. There is no `nulu8list`, so the packed list has no niche and the union has no
// rep.
//
// The MULTI-member shapes are unaffected and DO work — `u8[] | i32 | null` and
// `u8[] | IoError | null` are ordinary boxes whose `null` rides a tag
// (`u8-union-scalar-arm.vl` exercises one). It is exactly the two-member niche that is
// missing, and the refusal is LOUD at `vl build` / `vl run` (rc 3) in every position:
// local, param, return, module global, struct field and list element.
//
// Adding it is the `nulf32list` slice again — a VKind member, a nullable wrapper valtype,
// the build/read/push arms and the `nulScalarListKind` rung — and it is filed rather than
// smuggled in behind the union work, because a niche is a different rep from a box and the
// two share no code.
function readFile(ok: boolean): u8[] | null {
  if ok {
    const b: u8[] = [1, 2]
    return b
  }
  null
}
const r = readFile(true)
if r != null { print(r.length) } else { print(-1) }
