// @run
// @log 3
// @log 2
// A `filled` instance over a nullable record spells its element by shape; beside a value union
// it is still the record's nullable list, not a union-box list (D3996).
import { filled } from "std:array"

type Item = { n: i32 }
const u: i32 | string = 3
print(u)
const a = filled<Item | null>(2, null)
print(a.length)
