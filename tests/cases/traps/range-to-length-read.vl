// @trap array index out of bounds
// @warning an inclusive `to` range up to `.length` reaches that index, one past the last element — use `until` for the half-open `[0, .length)`, or `for x in …` to iterate the elements
// `to xs.length` is inclusive, so it proves nothing about `xs[i]`: the guard stays and the
// read at `i == len` traps. `range-proven-index.vl` holds the spellings that do prove it.
function f(xs: u8[]) {
  let s = 0
  for i in 0 to xs.length { s += xs[i] }
  s
}
print(f([1, 2, 3]))
