// @trap array index out of bounds
// A range variable the body reassigns is not bounded by the range, so `xs[i]` keeps its
// guard and the read past `len` traps rather than returning the backing's slack.
function f(xs: i32[]) {
  let s = 0
  for i in 0 until xs.length {
    i = i + 2
    s += xs[i]
  }
  s
}
print(f([1, 2, 3, 4]))
