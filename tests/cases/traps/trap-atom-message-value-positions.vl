// @trap
// Q58 position sweep: `__trap__` of a literal-union atom read from a record field, a narrowed union
// and a parameter, as a statement and as an `if` arm's value; the first to run prints `full`.
type Why = "empty" | "full"
type Box = { why: Why }
function pick(n: i32, w: Why) { return if n > 0 { n } else { __trap__(w) } }
function viaField(b: Box) {
  if b.why == "empty" { __trap__(b.why) }
}
function viaUnion(u: Why | i32) {
  if u is Why {
    if u == "empty" { __trap__(u) }
  }
}
viaField({ why: "full" })
viaUnion(3)
print(pick(2, "empty"))
print(pick(0, "full"))
