// @trap
// A hole function instantiated at a `never` argument computes nothing: its body's read of the
// parameter is `unreachable` (D16006), at a `print` argument and at a return alike. Reaching the
// call traps in `fail` first, under legacy and the IR alike.
function fail(): never { __trap__() }
function k(n: i32) {
  const f = (x) => x
  const id = (y) => y
  if n > 5 { print(f(fail())) }
  if n > 1 { return id(fail()) }
  return n
}
print(k(3))
