// @trap array index out of bounds
// @warning an inclusive `to` range up to `.length` reaches that index, one past the last element — use `until` for the half-open `[0, .length)`, or `for x in …` to iterate the elements
// A field list walked `to b.xs.length` reads one past the end: the header of `b.xs` is cached
// ahead of the loop, and the index is not proven in range under `to len`, so the guard stays
// and the last read traps. `tests/vl_hoist_trap_iteration_test.ts` pins the prefix.
type Bag = { xs: i32[], k: i32 }

function over(b: Bag) {
  let s = 0
  for i in 0 to b.xs.length { s = s * 31 + b.xs[i] }
  s
}

print(1)
print(over({ xs: [1, 2, 3, 4, 5, 6, 7], k: 0 }))
print(99)
