// @trap array index out of bounds
// An unrolled list walk whose body indexes another list by the element traps on the element
// that is out of range, the sixth (second copy of the second trip): each round prints its
// number first, and the round that first reaches that element never prints its sum.
// `tests/vl_hoist_trap_iteration_test.ts` pins the prefix, which `@trap` cannot.
function pick(ix: i32[], ys: i32[]): i32 {
  let s = 0
  for x in ix { s = s * 31 + ys[x] }
  s
}

const ys = [10, 20, 30, 40, 50, 60, 70]
const ix = [0, 1, 2, 3, 4, 5, 6, 3, 2, 1]
let r = 1
while r <= 3 {
  print(r)
  print(pick(ix, ys))
  ix[5] = ix[5] + 1
  r = r + 1
}
print(99)
