// @trap array index out of bounds
// D3068: `.map` fixes the length at entry, and an index its callback has since cut off ends
// the call with the trap an `xs[i]` read past the length raises, rather than a stale element.
const h = [1, 2, 3]
let first = true
const m = h.map((e) => {
  if first {
    first = false
    h.pop()
  }
  return e
})
print(m.length)
