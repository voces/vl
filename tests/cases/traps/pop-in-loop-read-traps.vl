// @trap array index out of bounds
// A pop in the loop body shrinks `len` under a bound read once at the loop's start, so the
// third read (i = 2, `len` 2) traps. The body calls `pop`, so the header is re-read per access
// and no copy is made; a cached `len` would read the popped slack instead.
function drain(xs: i32[]) {
  let s = 0
  for i in 0 until xs.length {
    s = s * 31 + xs[i]
    xs.pop() ?? 0
  }
  s
}

print(drain([1, 2, 3, 4]))
