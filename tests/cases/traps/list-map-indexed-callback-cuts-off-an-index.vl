// @trap array index out of bounds
// @hint Intentionally-unused parameter
// D3068: `std:array`'s `mapIndexed` fixes the length at entry, and an index its callback has
// since cut off ends the call with the trap an `xs[i]` read past the length raises.
import { mapIndexed } from "std:array"

const h = ["a", "b", "c"]
let first = true
const m = h.mapIndexed((_e, i) => {
  if first {
    first = false
    h.pop()
  }
  return i
})
print(m.length)
