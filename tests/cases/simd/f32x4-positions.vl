// @run
// @log 2
// @log 7
// @log 5
// @log 4
// @log 4
// @log 4
// @log 9
// @log 5
// @log 1
// @log 2
// @log 10
// @log 16
// @log 9
// @hint redundant type annotation: `gAnn` is inferred as `F32x4`
// @hint redundant type annotation: `annotated` is inferred as `F32x4`
// Every position an F32x4 is delivered through, each in its annotated and its inferred
// spelling: a module global (const, mutable, annotated), a local, a parameter, an annotated
// and an inferred return, an if-expression, a loop-carried reassignment, a closure capture and
// a generic identity. Each proves the vector arrived by printing one lane.
import { Buffer, loadF32 } from "std:buffer"
import { F32x4, f32x4, reduceAddF32x4, splatF32, storeF32x4 } from "std:simd"

const sb = Buffer(16)

function lane1(v: F32x4) {
  sb.storeF32x4(0, v)
  return sb.loadF32(4)
}

const g = f32x4(1.0, 2.0, 3.0, 4.0)
const gAnn: F32x4 = splatF32(7.0)
let gMut = splatF32(1.0)

function bump() { gMut = gMut + splatF32(2.0) }

function twiceAnn(a: F32x4): F32x4 { return a + a }

function squareInferred(a: F32x4) { return a * a }

function build() { return f32x4(0.0, 5.0, 0.0, 0.0) }

function pick(c: boolean) {
  const v = if c { splatF32(1.0) } else { splatF32(2.0) }
  return v
}

function id<T>(x: T): T { return x }

function main() {
  print(lane1(g))
  print(lane1(gAnn))
  bump()
  bump()
  print(lane1(gMut))
  const inferred = g + g
  print(lane1(inferred))
  const annotated: F32x4 = g * g
  print(lane1(annotated))
  print(lane1(twiceAnn(g)))
  print(lane1(squareInferred(f32x4(0.0, 3.0, 0.0, 0.0))))
  print(lane1(build()))
  print(lane1(pick(true)))
  print(lane1(pick(false)))
  let acc = splatF32(0.0)
  let i = 0
  while i < 5 {
    acc = acc + g
    i = i + 1
  }
  print(lane1(acc))
  const captured = f32x4(1.0, 8.0, 3.0, 4.0)
  const sum = (): f32 => captured.reduceAddF32x4()
  print(sum())
  print(lane1(id(splatF32(9.0))))
}
main()
