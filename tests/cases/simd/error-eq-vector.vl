// @check
// @error `==` does not compare 128-bit vectors: F32x4 has four lanes and no single answer
// A vector has four lanes, so `==` has no single truth value to give. The lane-wise compare is
// `eqF32x4`, which answers a mask; `==` is refused rather than silently comparing one lane.
import { splatF32 } from "std:simd"

const a = splatF32(1.0)
print(a == a)
