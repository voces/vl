// @check
// @error __replace_lane_i64x2__ requires a compile-time lane index literal in 0..1
// An i64x2 has two lanes, so lane 2 is out of range and refused where the call is written.
function main() {
  const x: i64 = 9
  const v = __replace_lane_i64x2__(__splat_i64x2__(x), 2, x)
  print(__extract_lane_i64x2__(v, 0))
}
main()
