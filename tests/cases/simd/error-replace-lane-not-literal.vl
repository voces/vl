// @check
// @error __replace_lane_f32x4__ requires a compile-time lane index literal in 0..3
// The replaced lane is a wasm instruction immediate, like the extracted one (O3).
function main() {
  const v = __splat_f32x4__(1.0)
  const lane = 2
  const w = __replace_lane_f32x4__(v, lane, 5.0)
  print(__extract_lane_f32x4__(w, 2))
}
main()
