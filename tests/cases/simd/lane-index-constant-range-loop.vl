// @run
// @log 10
// @log 4
// @log 2
// A constant-range loop variable passes as a `Lane4` where every value it takes is a lane: the
// four-lane reduction, a sub-range with `const` bounds, a reversed `to … step -1`, and
// `withLane` writing each lane.
import { f32x4 } from "std:simd"

const LAST = 3

function main() {
  const v = f32x4(1.0, 2.0, 3.0, 4.0)
  let s: f32 = 0.0
  for i in 0 until 4 { s = s + v.lane(i) }
  print(s)
  let t: f32 = 0.0
  for i in 3 to LAST { t = t + v.lane(i) }
  print(t)
  let w = v
  for i in 3 to 0 step -1 { w = w.withLane(i, v.lane(i) * 0.5) }
  let u: f32 = 0.0
  for i in 0 until 4 step 2 { u = u + w.lane(i) }
  print(u)
}
main()
