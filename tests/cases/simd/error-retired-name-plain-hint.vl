// @error undeclared identifier 'addSatU8x16'; did you mean `a.addSat(b)`, the `addSat` that takes `U8x16`?
// The plain-call spelling of a retired name: the first argument becomes the receiver.
import { splatU8 } from "std:simd"

const a = splatU8(200)
const b = splatU8(100)
print(addSatU8x16(a, b).eq(a).anyTrue())
