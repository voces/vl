// promote_low_f32x4 (lanes 0 and 1 to f64), demote_f64x2_zero (to f32 lanes 0 and 1,
// rounding to nearest-even, with lanes 2 and 3 zero) and convert_low_i32x4_s/u (exact).
// A NaN input is the canonical one, whose result the spec fixes. Printed as bit patterns.
// Generated by scripts/gen-conv-cases.py; the expected lines are its model of
// the wasm spec. Edit the generator, not this file.
function v4(a: i32, b: i32, c: i32, d: i32): v128 {
  __store_i32__(0, a)
  __store_i32__(4, b)
  __store_i32__(8, c)
  __store_i32__(12, d)
  __load_v128__(0)
}

function v2(a: i64, b: i64): v128 {
  __store_i64__(0, a)
  __store_i64__(8, b)
  __load_v128__(0)
}

function show4(x: v128) {
  __store_v128__(16, x)
  print(__load_i32__(16))
  print(__load_i32__(20))
  print(__load_i32__(24))
  print(__load_i32__(28))
}

function show2(x: v128) {
  __store_v128__(16, x)
  print(__load_i64__(16))
  print(__load_i64__(24))
}

function main() {
  const x0 = v4(0, (-2147483647 - 1), 1065353216, 1073741824)
  show2(__promote_low_f32x4__(x0))
  const x2 = v4(1069547520, -1068953637, 2139095040, -8388608)
  show2(__promote_low_f32x4__(x2))
  const x4 = v4(2139095040, -8388608, 0, 0)
  show2(__promote_low_f32x4__(x4))
  const x6 = v4(1, -2139095041, 1065353216, 1065353216)
  show2(__promote_low_f32x4__(x6))
  const x8 = v4(2139095039, 2143289344, 305419896, -1698898192)
  show2(__promote_low_f32x4__(x8))
  const x10 = v2(0, (-9223372036854775807 - 1))
  show4(__demote_f64x2_zero__(x10))
  const x12 = v2(4609434218613702656, -4609115380302729960)
  show4(__demote_f64x2_zero__(x12))
  const x14 = v2(9218868437227405312, -4503599627370496)
  show4(__demote_f64x2_zero__(x14))
  const x16 = v2(4607182419068452864, 4607182419605323776)
  show4(__demote_f64x2_zero__(x16))
  const x18 = v2(5183643170835005440, -4039728866019770368)
  show4(__demote_f64x2_zero__(x18))
  const x20 = v2(5183643170566569984, 9094988921128908188)
  show4(__demote_f64x2_zero__(x20))
  const x22 = v2(3931642474694443008, 3933894274508128256)
  show4(__demote_f64x2_zero__(x22))
  const x24 = v2(118622047889322841, 9221120237041090560)
  show4(__demote_f64x2_zero__(x24))
  const x26 = v4(0, -1, 7, 7)
  show2(__convert_low_i32x4_s__(x26))
  const x28 = v4(2147483647, (-2147483647 - 1), 1, 1)
  show2(__convert_low_i32x4_s__(x28))
  const x30 = v4(1, -2, 2147483647, (-2147483647 - 1))
  show2(__convert_low_i32x4_s__(x30))
  const x32 = v4(123456789, -987654321, 0, 0)
  show2(__convert_low_i32x4_s__(x32))
  const x34 = v4(0, -1, 7, 7)
  show2(__convert_low_i32x4_u__(x34))
  const x36 = v4(2147483647, (-2147483647 - 1), 1, 1)
  show2(__convert_low_i32x4_u__(x36))
  const x38 = v4(1, -2, 2147483647, (-2147483647 - 1))
  show2(__convert_low_i32x4_u__(x38))
  const x40 = v4(123456789, -987654321, 0, 0)
  show2(__convert_low_i32x4_u__(x40))
}
main()
