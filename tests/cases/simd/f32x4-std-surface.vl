// std:simd's F32x4 surface, each op read back lane by lane through a Buf (lane 0 at the
// lowest address, so `f32x4(1, 2, 3, 4)` stores 1 first). -0.0 is printed as its bit pattern
// (0x80000000 = -2147483648) and NaN as `true` from a per-lane `x != x` test, since only the
// NaN-ness, not the NaN's payload bits, is part of the contract.
import { Buffer, loadF32, loadI32 } from "std:buffer"
import {
  F32x4,
  Mask32x4,
  absF32x4,
  addF32x4,
  divF32x4,
  eqF32x4,
  f32x4,
  geF32x4,
  gtF32x4,
  leF32x4,
  loadF32x4,
  ltF32x4,
  maxF32x4,
  minF32x4,
  mulF32x4,
  neF32x4,
  reduceAddF32x4,
  selectF32x4,
  splatF32,
  sqrtF32x4,
  storeF32x4,
  subF32x4,
} from "std:simd"

const buf = Buffer(64)

function lanes(v: F32x4) {
  buf.storeF32x4(0, v)
  print(buf.loadF32(0))
  print(buf.loadF32(4))
  print(buf.loadF32(8))
  print(buf.loadF32(12))
}

function bits(v: F32x4) {
  buf.storeF32x4(0, v)
  print(buf.loadI32(0))
  print(buf.loadI32(4))
  print(buf.loadI32(8))
  print(buf.loadI32(12))
}

function nans(v: F32x4) {
  buf.storeF32x4(0, v)
  let i = 0
  while i < 16 {
    const x = buf.loadF32(i)
    print(x != x)
    i = i + 4
  }
}

function mask(m: Mask32x4) { bits(m as! F32x4) }

function main() {
  const a = f32x4(1.0, 2.0, 3.0, 4.0)
  lanes(a)
  // Lane 0 is the lowest address: an unaligned load at byte 20 reads a's lanes 1..3, then 9.
  buf.storeF32x4(16, a)
  buf.storeF32x4(32, splatF32(9.0))
  lanes(buf.loadF32x4(20))
  const b: F32x4 = splatF32(0.5)
  lanes(a + b)
  lanes(a - b)
  lanes(a * b)
  lanes(a / b)
  // The named twins agree with the operators.
  lanes(subF32x4(addF32x4(a, b), mulF32x4(divF32x4(a, b), b)))
  lanes(sqrtF32x4(f32x4(4.0, 9.0, 2.0, 0.25)))
  lanes(absF32x4(f32x4(-1.5, 2.0, -3.0, 0.0)))
  // abs clears the sign of -0.0.
  bits(absF32x4(f32x4(-0.0, 0.0, -0.0, 1.0)))
  // min/max: -0.0 is below 0.0 in either argument order.
  const zs = f32x4(-0.0, 0.0, 1.0, -2.0)
  const ps = f32x4(0.0, -0.0, 2.0, -3.0)
  bits(minF32x4(zs, ps))
  bits(maxF32x4(zs, ps))
  // min/max: a NaN in either lane gives NaN, whichever side it is on.
  const nan = splatF32(0.0) / splatF32(0.0)
  const half = f32x4(nan.reduceAddF32x4(), 1.0, nan.reduceAddF32x4(), 2.0)
  nans(minF32x4(half, a))
  nans(maxF32x4(a, half))
  nans(sqrtF32x4(f32x4(-1.0, 1.0, 4.0, -0.5)))
  // Compares answer all-ones (-1) or all-zeros per lane.
  const c = f32x4(1.0, 5.0, 3.0, 0.0)
  mask(ltF32x4(a, c))
  mask(leF32x4(a, c))
  mask(gtF32x4(a, c))
  mask(geF32x4(a, c))
  mask(eqF32x4(a, c))
  mask(neF32x4(a, c))
  // NaN is unordered: every ordered compare and `eq` is false, `ne` is true; -0.0 == 0.0.
  mask(ltF32x4(half, a))
  mask(eqF32x4(half, half))
  mask(neF32x4(half, half))
  mask(eqF32x4(zs, ps))
  // select takes the first vector where the mask is set.
  lanes(selectF32x4(ltF32x4(a, c), a, splatF32(-1.0)))
  // reduceAdd sums as (x + z) + (y + w).
  print(reduceAddF32x4(a))
  print(f32x4(1.0e8, 1.0, -1.0e8, 1.0).reduceAddF32x4())
}
main()
