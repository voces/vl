// f32x4 and f64x2 pmin/pmax over ±0, signed and payload-carrying NaNs, infinities and
// subnormals. pmin is `b < a ? b : a` and pmax `a < b ? b : a`, so each lane is one
// operand's bits unchanged: x86 `minps d, s` is `pmin(s, d)`. Printed as bit patterns.
// Generated by scripts/gen-conv-cases.py; the expected lines are its model of
// the wasm spec. Edit the generator, not this file.
function v4(a: i32, b: i32, c: i32, d: i32): v128 {
  __store_i32__(0, a)
  __store_i32__(4, b)
  __store_i32__(8, c)
  __store_i32__(12, d)
  __load_v128__(0)
}

function v2(a: i64, b: i64): v128 {
  __store_i64__(0, a)
  __store_i64__(8, b)
  __load_v128__(0)
}

function show4(x: v128) {
  __store_v128__(16, x)
  print(__load_i32__(16))
  print(__load_i32__(20))
  print(__load_i32__(24))
  print(__load_i32__(28))
}

function show2(x: v128) {
  __store_v128__(16, x)
  print(__load_i64__(16))
  print(__load_i64__(24))
}

function main() {
  const x0 = v4(0, (-2147483647 - 1), 2143289344, 1065353216)
  const x1 = v4((-2147483647 - 1), 0, 1065353216, 2143289344)
  show4(__pmin_f32x4__(x0, x1))
  show4(__pmax_f32x4__(x0, x1))
  const x4 = v4(-4194303, 2141192194, -8388608, 2139095040)
  const x5 = v4(2141192194, -4194303, 2139095040, -8388608)
  show4(__pmin_f32x4__(x4, x5))
  show4(__pmax_f32x4__(x4, x5))
  const x8 = v4(1069547520, -1082130432, 1, -2147483647)
  const x9 = v4(1075838976, -1073741824, 0, (-2147483647 - 1))
  show4(__pmin_f32x4__(x8, x9))
  show4(__pmax_f32x4__(x8, x9))
  const x12 = v4(2139095040, -4194304, 1065353216, (-2147483647 - 1))
  const x13 = v4(2143289344, -8388608, 1065353216, (-2147483647 - 1))
  show4(__pmin_f32x4__(x12, x13))
  show4(__pmax_f32x4__(x12, x13))
  const x16 = v2(0, (-9223372036854775807 - 1))
  const x17 = v2((-9223372036854775807 - 1), 0)
  show2(__pmin_f64x2__(x16, x17))
  show2(__pmax_f64x2__(x16, x17))
  const x20 = v2(9221120237041090560, 4607182418800017408)
  const x21 = v2(4607182418800017408, 9221120237041090560)
  show2(__pmin_f64x2__(x20, x21))
  show2(__pmax_f64x2__(x20, x21))
  const x24 = v2(-2251799813685247, 9219994337134247938)
  const x25 = v2(9219994337134247938, -2251799813685247)
  show2(__pmin_f64x2__(x24, x25))
  show2(__pmax_f64x2__(x24, x25))
  const x28 = v2(-4503599627370496, 9218868437227405312)
  const x29 = v2(9218868437227405312, -4503599627370496)
  show2(__pmin_f64x2__(x28, x29))
  show2(__pmax_f64x2__(x28, x29))
  const x32 = v2(4609434218613702656, -4616189618054758400)
  const x33 = v2(4612811918334230528, -4611686018427387904)
  show2(__pmin_f64x2__(x32, x33))
  show2(__pmax_f64x2__(x32, x33))
  const x36 = v2(1, -9223372036854775807)
  const x37 = v2(0, (-9223372036854775807 - 1))
  show2(__pmin_f64x2__(x36, x37))
  show2(__pmax_f64x2__(x36, x37))
}
main()
