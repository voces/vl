// @run
// @log 3
// @log 1.5
// @log 5
// @log 7
// @log 6
// @log 4
// @log 2.5
// @log 6
// @log 8
// @log 9
// A valued `if` whose arms are `F32x4` vectors, a `v128` join: at a `const`, a return, an argument,
// a record field and an annotated `const`. Each prints one lane.
import { Buffer, loadF32 } from "std:buffer"
import { F32x4, f32x4, splatF32, storeF32x4 } from "std:simd"

const sb = Buffer(16)
function lane1(v: F32x4) {
  sb.storeF32x4(0, v)
  return sb.loadF32(4)
}
function retIf(c: boolean) {
  return if c { splatF32(1.5) } else { f32x4(0.0, 2.5, 0.0, 0.0) }
}
function run(c: boolean) {
  const v = if c { splatF32(3.0) } else { splatF32(4.0) }
  print(lane1(v))
  print(lane1(retIf(c)))
  print(lane1(if c { splatF32(5.0) } else { splatF32(6.0) }))
  const r = { v: if c { splatF32(7.0) } else { splatF32(8.0) } }
  print(lane1(r.v))
  const w: F32x4 = if !c { splatF32(9.0) } else { v + v }
  print(lane1(w))
}
run(true)
run(false)
// @hint redundant type annotation: `w`
