// @error member access '.ltF32x4' on non-object F32x4; did you mean `a.lt(b)`, the `lt` that takes `F32x4`?
// A shape-suffixed name from before std:simd's operations became methods names the method that
// replaced it: `lt` is a receiver-overload set with a candidate on `F32x4`.
import { splatF32 } from "std:simd"

const a = splatF32(1.0)
const b = splatF32(2.0)
print(a.ltF32x4(b).anyTrue())
