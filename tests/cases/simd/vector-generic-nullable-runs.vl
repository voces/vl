// @run
// @log false
// @log 4
// @log 2
// A generic body's `T | null` and `T | i32` at a vector instance box it under its own atom (D2634).
function wrapN<T>(x: T): T | null {
  const w: T | null = x
  return w
}
const a = wrapN(__splat_i32x4__(4))
print(a == null)
if a != null { print(__extract_lane_i32x4__(a, 2)) }
function orZ<T>(x: T, z: boolean): T | i32 {
  if z { return 2 }
  return x
}
const u = orZ(__splat_i32x4__(1), true)
if u is i32 { print(u) }
