// @check
// @error-at 14:15 argument 1: expected Lane4, got i32
// @error-at 15:15 argument 1: expected Lane4, got i32
// @error-at 16:19 argument 1: expected Lane4, got i32
// @error-at 17:4 cannot assign to `.x`: it reads the getter `x` on F32x4
// The lane index of `lane` / `withLane` is a `Lane4` (0 | 1 | 2 | 3), so an out-of-range literal
// and a plain `i32` are refused where the call is written, not trapped at run time; a
// runtime index has to be declared a `Lane4`. A getter is read-only: write a lane with
// `withLane`.
import { f32x4 } from "std:simd"

function main() {
  const v = f32x4(1.0, 2.0, 3.0, 4.0)
  const k = 1 + 1
  print(v.lane(k))
  print(v.lane(4))
  print(v.withLane(k, 0.5).x)
  v.x = 3.0
}
main()
