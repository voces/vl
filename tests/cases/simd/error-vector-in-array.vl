// @check
// @error F32x4[] holds a 128-bit vector inside an array, struct field or map, which has no lowering yet
// A vector lives in locals, parameters, returns and globals. Held inside a container it has no
// lowering yet, and the checker says so before the emitter can produce an invalid module. This
// is the un-annotated spelling; an annotated `F32x4[]` is refused the same way.
import { splatF32 } from "std:simd"

const inferred = [splatF32(1.0), splatF32(2.0)]
print(inferred.length)
