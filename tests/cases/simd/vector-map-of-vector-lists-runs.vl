// @run
// @log 2
// @log 0
// A map whose value is a vector list reads back a nullable vector list (D1981).
import { F32x4, splatF32 } from "std:simd"

const mv: {[string]: F32x4[]} = Map()
mv.set("a", [splatF32(5.0)])
const g = mv.get("a")
if g != null {
  g.push(splatF32(6.0))
  print(g.length)
}
print((mv.get("b") ?? []).length)
