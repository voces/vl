// @run
// @log 1
// @log 6
// @log 13
// @log 14
// @log 3
// @log 2
// @log 5
// @log 8
// A struct field of vector type is a `v128` field: a literal, an inferred and an annotated
// record, a write and a compound write in a loop, arithmetic in a literal, a field two record
// arms share, and a record a lambda returns, each read back through a lane.
import { F32x4, splatF32 } from "std:simd"

const b = { pos: splatF32(6.0), m: 1.0 }
print(b.m)
print(b.pos.x)
type Body = { p: F32x4, m: i32 }
function bump(b: Body, n: i32) {
  let i = 0
  while i < n {
    b.p = b.p + splatF32(1.0)
    i = i + 1
  }
}
const c: Body = { p: splatF32(3.0), m: 1 }
bump(c, 10)
print(c.p.z)
c.p += splatF32(1.0)
print(c.p.w)
const sum = { p: splatF32(1.0) + splatF32(2.0), m: 1 }
print(sum.p.x)
type A = { k: "a", p: F32x4 }
type B = { k: "b", p: F32x4, n: i32 }
function lane0(u: A | B) { return u.p.x }
print(lane0({ k: "b", p: splatF32(2.0), n: 1 }))
print(lane0({ k: "a", p: splatF32(5.0) }))
const wrap = (x: F32x4) => {
  return { p: x }
}
print(wrap(splatF32(8.0)).p.z)
