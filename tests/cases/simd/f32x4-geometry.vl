// @run
// @log -15
// @log -15
// @log -11.25
// @log 3.75
// @log 6.25
// @log 0
// @log -11.25
// @log 3.75
// @log 6.25
// @log 0
// @log 1
// @log 0.6000000238418579
// @log 0
// @log 0.800000011920929
// @log 0
// @log 1
// @log true
// @log true
// @log true
// @log true
// F32x4 as the graphics vec4 (O7): `dot`, `cross` and `normalize` are methods reached through
// the vector itself — none of them is imported here — and each agrees bit for bit with the
// scalar formula written in the same order. A vec3 is an F32x4 whose w is 0.
import { Buffer, loadF32 } from "std:buffer"
import { F32x4, f32x4, storeF32x4 } from "std:simd"

const buf = Buffer(32)

function lanes(v: F32x4) {
  buf.storeF32x4(0, v)
  print(buf.loadF32(0))
  print(buf.loadF32(4))
  print(buf.loadF32(8))
  print(buf.loadF32(12))
}

function main() {
  const ax: f32 = 1.25
  const ay: f32 = -2.5
  const az: f32 = 3.75
  const bx: f32 = 0.5
  const by: f32 = 4.0
  const bz: f32 = -1.5
  const zero: f32 = 0.0
  const a = f32x4(ax, ay, az, 0.0)
  const b = f32x4(bx, by, bz, 0.0)

  // dot sums lane products as (x + z) + (y + w).
  print(a.dot(b))
  print((ax * bx + az * bz) + (ay * by + zero * zero))

  // cross ignores w on the way in and writes 0 on the way out.
  const w = f32x4(ax, ay, az, 7.0).cross(f32x4(bx, by, bz, -3.0))
  lanes(w)
  print(ay * bz - az * by)
  print(az * bx - ax * bz)
  print(ax * by - ay * bx)
  // The cross product is perpendicular to both inputs.
  print(w.dot(a))
  print(
    f32x4(1.0, 0.0, 0.0, 0.0)
      .cross(f32x4(0.0, 1.0, 0.0, 0.0))
      .dot(f32x4(0.0, 0.0, 1.0, 0.0)),
  )

  // normalize divides every lane by sqrt(dot(v, v)).
  const n = f32x4(3.0, 0.0, 4.0, 0.0).normalize()
  lanes(n)
  print(n.dot(n))
  const len = sqrt((ax * ax + az * az) + (ay * ay + zero))
  buf.storeF32x4(0, a.normalize())
  print(buf.loadF32(0) == ax / len)
  print(buf.loadF32(4) == ay / len)
  print(buf.loadF32(8) == az / len)
  // A zero vector has no direction: every lane is NaN.
  buf.storeF32x4(0, f32x4(0.0, 0.0, 0.0, 0.0).normalize())
  const z0 = buf.loadF32(0)
  print(z0 != z0)
}
main()
