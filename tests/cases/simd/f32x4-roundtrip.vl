// @run
// @log 1069547520
// @log 1084227584
// The v128 SIMD substrate round-trip (simd-design.md §G, slices S1-S2). A 128-bit vector
// flows through locals as the wasm `v128` valtype and back out through a lane.
//
// First: splat 1.5 across four f32 lanes, store the vector into linear memory, load it back,
// and extract lane 0 — it must equal 1.5. The value is proven by storing it as an f32 and
// reading its bit pattern: 1.5f is 0x3FC00000 = 1069547520.
//
// Second: splat 2.0 and 3.0, add the two vectors (5.0 in every lane), extract lane 2 — 5.0f
// is 0x40A00000 = 1084227584. The lane index is a compile-time literal (the wasm immediate).
function main() {
  const v = __splat_f32x4__(1.5)
  __store_v128__(0, v)
  const w = __load_v128__(0)
  const lane0 = __extract_lane_f32x4__(w, 0)
  __store_f32__(32, lane0)
  print(__load_i32__(32))

  const a = __splat_f32x4__(2.0)
  const b = __splat_f32x4__(3.0)
  const s = __add_f32x4__(a, b)
  const lane2 = __extract_lane_f32x4__(s, 2)
  __store_f32__(36, lane2)
  print(__load_i32__(36))
}
main()
