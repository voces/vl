// @check
// @error Body isn't equatable (a field is not value-comparable)
// A record holding a vector is not value-comparable, as a vector's four lanes have no single
// answer under `==`.
import { F32x4, splatF32 } from "std:simd"

type Body = { p: F32x4 }
const a: Body = { p: splatF32(1.0) }
print(a == a)
