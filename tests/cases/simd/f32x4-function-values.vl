// @run
// @log 4
// @log 6
// @log 2.25
// @log 12
// Regression (D1982). An `F32x4` crosses the function-value ABI: a lambda taking and
// returning one (annotated and inferred), a std function passed as a value, and a
// vector-returning lambda captured into another closure.
import { toString } from "std:fmt"
import { F32x4, addF32x4, splatF32 } from "std:simd"

function twice(f: (F32x4) => F32x4, v: F32x4): F32x4 { return f(f(v)) }
print(toString(twice((a: F32x4): F32x4 => a + a, splatF32(1.0)).x))
print(toString(twice((a: F32x4) => a + a, splatF32(1.5)).y))

function comb(g: (F32x4, F32x4) => F32x4): F32x4 {
  g(splatF32(2.0), splatF32(0.25))
}
print(toString(comb(addF32x4).z))

function outer() {
  const v = splatF32(3.0)
  const mkv = () => v + v
  const h = (k: f32): f32 => mkv().w * k
  h(2.0)
}
print(toString(outer()))
