// @check
// @error Body holds a 128-bit vector inside an array, struct field, map, nullable or union
// A struct type with a vector field that is only ever named in a signature reaches no
// expression, so the annotation itself is refused.
import { F32x4 } from "std:simd"

type Body = { pos: F32x4, m: f32 }
function mass(b: Body) { return b.m }
print(1)
