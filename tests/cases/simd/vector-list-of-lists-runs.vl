// @run
// @log 3
// @log 12
// @log 21
// A list of vector lists is a ref list of flat `v128` list wrappers (D1981).
import { F32x4, splatF32 } from "std:simd"

const xs: F32x4[][] = [[splatF32(1.0)], []]
xs[1].push(splatF32(4.0))
xs.push([splatF32(7.0), splatF32(8.0)])
print(xs.length)
print(xs[1][0].x + xs[2][1].w)
xs[0][0] = splatF32(2.0)
function total(m: F32x4[][]): f32 {
  let t = 0.0 as f32
  for r in m { for v in r { t = t + v.x } }
  return t
}
print(total(xs))
