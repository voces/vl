// A loop variable passes as a `Lane4` only over a constant range that holds lanes alone and
// that its body never writes: a data-bounded end, a range reaching past lane 3, an empty
// range, a variable the body assigns, and arithmetic over it (which is an `i32`) are refused.
import { f32x4 } from "std:simd"

function main(n: i32) {
  const v = f32x4(1.0, 2.0, 3.0, 4.0)
  let s: f32 = 0.0
  let hi = 4
  for i in 0 until n { s = s + v.lane(i) }
  for i in 0 until 5 { s = s + v.lane(i) }
  for i in 2 until 2 { s = s + v.lane(i) }
  for i in 0 until 4 { i = 1; s = s + v.lane(i) }
  for i in 0 until 3 { s = s + v.lane(i + 1) }
  print(s)
}
main(4)
