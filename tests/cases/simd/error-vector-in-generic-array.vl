// @check
// @error `wrap` stores its type parameter in a container here: F32x4[] holds a 128-bit vector
// A generic body that puts its `T` in a container has no vector in it until a call binds
// `T`, so the container is re-asked at the call: here `T = F32x4` makes `[x, x]` an
// `F32x4[]`, refused like the direct spelling rather than emitted as an invalid module.
import { splatF32 } from "std:simd"

function wrap<T>(x: T): i32 {
  const a = [x, x]
  return a.length
}
print(wrap(splatF32(2.0)))
