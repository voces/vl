// @check
// @error v128 | null boxes `wrapN`'s type parameter bound to a 128-bit vector
// A generic body's `T | null` has no instance at a vector yet (D2634), so the pin is refused
// rather than emitted as an invalid module; the direct `v128 | null` spelling runs.
function wrapN<T>(x: T): T | null {
  const w: T | null = x
  w
}
const a = wrapN(__splat_i32x4__(4))
print(a == null)
