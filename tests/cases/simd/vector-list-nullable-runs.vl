// @run
// @log true
// @log 1
// @log 3
// A nullable vector list is the flat `v128` list wrapper in a nullable slot (D1981).
import { F32x4, splatF32 } from "std:simd"

let a: F32x4[] | null = null
print(a == null)
a = [splatF32(1.0)]
if a != null { print(a.length) }
const xs: (F32x4[] | null)[] = [null, [splatF32(3.0)]]
for x in xs {
  if x != null { print(x[0].x) }
}
