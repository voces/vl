// @run
// @log 2
// A struct type with a vector field that is only ever named in a signature lowers like any
// other: the record is passed and its other field read.
import { F32x4, splatF32 } from "std:simd"

type Body = { pos: F32x4, m: f32 }
function mass(b: Body) { return b.m }
print(mass({ pos: splatF32(1.0), m: 2.0 }))
