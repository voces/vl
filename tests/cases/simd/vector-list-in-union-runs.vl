// @run
// @log 1
// @log s
// @log 2
// A vector list is a value-union member under its own atom (D16943).
import { F32x4, splatF32 } from "std:simd"

function f(u: F32x4[] | string) {
  if u is string { print(u) } else { print(u.length) }
}
f([splatF32(1.0)])
f("s")
const u: F32x4[] | i32 = [splatF32(2.0)]
if u is F32x4[] { print(u[0].x) }
