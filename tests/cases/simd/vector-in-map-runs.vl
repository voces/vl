// @run
// @log 2.5
// @log 1.5
// @log 2
// @log true
// A map of vectors stores its values on a flat `v128` list; a miss reads as `null` (D16891).
import { F32x4, splatF32 } from "std:simd"

const mv: {[string]: F32x4} = Map()
mv.set("a", splatF32(2.5))
mv["b"] = splatF32(1.5)
const a = mv.get("a")
if a != null { print(a.y) }
print((mv.get("b") ?? splatF32(0.0)).x)
print(mv.length)
print(mv.get("c") == null)
