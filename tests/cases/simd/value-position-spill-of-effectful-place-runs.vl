// @run
// @log 1
// @log 1
// @log 2
// @log 2
// @log 6
// @log 3
// A `??` over a list cell and a compound write used as a value, over a place whose index has an
// effect, run the index once: the receiver and index spill to locals before the read (D16484), and
// the spill's never-run arm needs no literal of a vector or record type (D16485).
import { F32x4, splatF32 } from "std:simd"

let n = 0
function idx() {
  n = n + 1
  return 0
}
const xs: (F32x4 | null)[] = []
xs.push(splatF32(1.0))
print((xs[idx()] ?? splatF32(0.0)).x)
print(n)
const rs = [{ v: splatF32(1.0) }]
print((rs[idx()].v += splatF32(1.0)).x)
print(n)
type P = { a: i32 }
const qs: P[][] = [[{ a: 1 }]]
print(qs[idx()][0].a += 5)
print(n)
