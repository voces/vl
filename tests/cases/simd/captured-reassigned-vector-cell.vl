// @run
// @log 100
// @log 100
// @log 100
// @log 7
// @log 30
// @log 4
// @log 21
// @log 10
// @log 4
// @hint redundant type annotation: `v` is inferred as `v128` — remove it to lean on inference
// @hint redundant type annotation: `v` is inferred as `F32x4` — remove it to lean on inference
// A function-local vector that a closure captures and the function then reassigns is shared
// through a cell. A vector has no list backing, so the cell holds it boxed; each read unboxes
// and each store boxes, in both scopes (D2826).
import { F32x4, lane, splatF32 } from "std:simd"

function unann() {
  let v = __splat_i32x4__(10)
  const g = (): i32 => __extract_lane_i32x4__(v, 1)
  v = __splat_i32x4__(100)
  g()
}
function ann() {
  let v: v128 = __splat_i32x4__(10)
  const g = (): i32 => __extract_lane_i32x4__(v, 1)
  v = __splat_i32x4__(100)
  g()
}
function param(v: v128) {
  const g = (): i32 => __extract_lane_i32x4__(v, 1)
  v = __splat_i32x4__(100)
  g()
}
function closureWrites() {
  let v = __splat_i32x4__(10)
  const g = () => {
    v = __splat_i32x4__(7)
  }
  g()
  __extract_lane_i32x4__(v, 2)
}
function beforeAfter() {
  let v = __splat_i32x4__(10)
  const g = (): i32 => __extract_lane_i32x4__(v, 0)
  const a = g()
  v = __splat_i32x4__(20)
  a + g()
}
function looped() {
  let v = __splat_i32x4__(0)
  const g = (): i32 => __extract_lane_i32x4__(v, 3)
  let i = 0
  while i < 5 {
    v = __splat_i32x4__(i)
    i = i + 1
  }
  g()
}
function twoClosures() {
  let v = __splat_i32x4__(1)
  const g = (): i32 => __extract_lane_i32x4__(v, 0)
  const h = () => {
    v = __splat_i32x4__(__extract_lane_i32x4__(v, 0) + 10)
  }
  h()
  h()
  g()
}
function tailYield() {
  let v = __splat_i32x4__(1)
  const h = () => v = __splat_i32x4__(5)
  const r = h()
  __extract_lane_i32x4__(r, 0) + __extract_lane_i32x4__(v, 1)
}
function brand() {
  let v: F32x4 = splatF32(1.5)
  const g = (): f32 => lane(v, 0)
  v = splatF32(2.5) + v
  g()
}
print(unann())
print(ann())
print(param(__splat_i32x4__(3)))
print(closureWrites())
print(beforeAfter())
print(looped())
print(twoClosures())
print(tailYield())
print(brand())
