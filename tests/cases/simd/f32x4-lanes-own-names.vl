// @run
// @log 3
// @log 7
// @log 2
// @log 5
// @log 11
// @log 9
// A program's own `lane`, `withLane` and `x` for another type do not hide std:simd's on an
// F32x4: the vector's type-bound methods are found past a local function whose `self` is some
// other type, and a getter is found through the receiver's type alone, never by name.
import { f32x4 } from "std:simd"

function lane(self: i32, i: i32) { return self + i }
function withLane(self: string, i: i32, x: i32) { return self.length + i + x }
function x(self: i32) { return self + 1 }
const y = 9

function main() {
  const v = f32x4(1.0, 2.0, 3.0, 4.0)
  print(v.lane(2))
  print(v.withLane(3, 7.0).lane(3))
  print(v.y)
  print(1.lane(4))
  print(10.x())
  print(y)
}
main()
