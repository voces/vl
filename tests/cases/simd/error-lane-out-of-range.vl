// @check
// @error __extract_lane_f32x4__ requires a compile-time lane index literal in 0..3
// An f32x4 has four lanes (0..3); lane 4 is out of range. The literal is small enough for the
// compiler to see the mistake, so it is a loud check error rather than an emit-time surprise.
function main() {
  const v = __splat_f32x4__(1.0)
  print(__extract_lane_f32x4__(v, 4))
}
main()
