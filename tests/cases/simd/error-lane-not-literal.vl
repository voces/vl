// @check
// @error __extract_lane_f32x4__ requires a compile-time lane index literal in 0..3
// The lane index of `__extract_lane_f32x4__` is a wasm instruction IMMEDIATE, not a stack
// operand, so it must be a compile-time literal in 0..3 (the seed of O3, simd-design.md §F).
// A `const`-bound value is not a literal node, so it is refused at the checker.
function main() {
  const v = __splat_f32x4__(1.0)
  const lane = 1
  print(__extract_lane_f32x4__(v, lane))
}
main()
