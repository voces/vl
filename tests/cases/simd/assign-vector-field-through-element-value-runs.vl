// @run
// @log 3
// @log 3
// @log 4
// @log 5
// @log 6
// @log 2
// An assignment to a vector field reached through a list element or a nested record, used as a
// value, yields the vector written: a binding, a print, a function's return, a nested field, and
// a compound write (D16486).
import { F32x4, splatF32 } from "std:simd"

type R = { v: F32x4 }
const rs: R[] = [{ v: splatF32(1.0) }]
const w = (rs[0].v = splatF32(3.0))
print(w.x)
print(rs[0].v.y)
print((rs[0].v = splatF32(4.0)).z)
function set(xs: R[], i: i32): F32x4 { return xs[i].v = splatF32(5.0) }
print(set(rs, 0).w)
type H = { r: R }
const h: H = { r: { v: splatF32(1.0) } }
print((h.r.v = splatF32(6.0)).x)
const qs: R[] = [{ v: splatF32(1.0) }]
print((qs[0].v += splatF32(1.0)).x)
