// @check
// @error __extract_lane_s_i16x8__ requires a compile-time lane index literal in 0..7
// An integer lane read's index is a wasm instruction immediate like an f32x4 one, so a value
// bound to a `const` is refused; each shape has its own range (0..15 for i8x16, 0..1 for i64x2).
function main() {
  const v = __splat_i16x8__(-3)
  const lane = 5
  print(__extract_lane_s_i16x8__(v, lane))
}
main()
