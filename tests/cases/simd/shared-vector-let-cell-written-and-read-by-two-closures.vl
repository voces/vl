// @run
// @log 4
// @log 5
// A `v128` `let` with no initializer that one closure writes and another reads is shared through a
// `v128 | null` cell: each write boxes the vector, and each read sees the last one.
function go(k: i32) {
  let u: v128
  const set = (x: i32) => {
    u = __splat_i32x4__(x)
  }
  const get = (): i32 => __extract_lane_i32x4__(u, 1)
  set(k)
  print(get())
  set(k + 1)
  print(get())
}
go(4)
