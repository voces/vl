// @check
// @error `==` does not compare 128-bit vectors: v128 | null has four lanes and no single answer
// Two operands that may each hold a vector may compare two, which `==` does not define: the
// boxed spelling is refused like the bare one (error-eq-vector.vl). A null test still runs.
function vec(n: i32): v128 | null {
  if n < 0 { return null }
  __splat_i32x4__(n)
}
const a = vec(1)
const b = vec(1)
print(a == b)
