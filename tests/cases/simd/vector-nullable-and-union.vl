// @run
// @log 7
// @log none
// @log 3
// @log 7
// @log true
// @log 5
// @log 2
// @log 6
// @log 1
// @log 9
// @log 4
// @log scalar 4
// @log 11
// @log neg
// @log 8
// @log 1
// @hint redundant type annotation: `lane` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `xs` is inferred as `(v128 | null)[]` — remove it to lean on inference
// @hint redundant type annotation: `want` is inferred as `v128` — remove it to lean on inference
// Regression (D2633; plumb PL-044). A vector boxes as a value-union atom, so `v128 | null`,
// `v128 | i32` and `v128 | string` lower at every position, and `??`, `== null`, `!= null`,
// `as!`, `as?` and `is` read the vector back. Each proof reads a lane.
function vec(n: i32): v128 | null {
  if n < 0 { return null }
  __splat_i32x4__(n)
}
function lane(v: v128 | null): i32 {
  if v == null { return -1 }
  __extract_lane_i32x4__(v, 0)
}

// Return, local and `!=`/`==` narrowing.
const a = vec(7)
if a != null { print(__extract_lane_i32x4__(a, 1)) }
const b = vec(-1)
if b == null { print("none") }

// `??` and `as!` / `as?`.
print(__extract_lane_i32x4__(b ?? __splat_i32x4__(3), 2))
print(__extract_lane_i32x4__(a as! v128, 3))
print((b as? v128) == null)

// Parameter and module global.
let g: v128 | null = null
g = vec(5)
print(lane(g))

// Struct field, list element and map value.
type Holder = { v: v128 | null, n: i32 }
const h: Holder = { v: null, n: 2 }
print(h.n)
h.v = vec(6)
print(lane(h.v))
const xs: (v128 | null)[] = [vec(1), null]
print(lane(xs[0]))
const m: {[string]: v128 | null} = Map()
m["k"] = vec(9)
print(lane(m["k"] ?? null))

// `v128 | i32` and `v128 | string`, tested with `is`.
function pick(n: i32): v128 | i32 {
  if n < 0 { return 0 - n }
  __splat_i32x4__(n)
}
const p = pick(4)
if p is v128 { print(__extract_lane_i32x4__(p, 0)) }
const q = pick(-4)
if q is i32 { print("scalar \{q}") }
function word(n: i32): v128 | string {
  if n < 0 { return "neg" }
  __splat_i32x4__(n)
}
const w = word(11)
if w is v128 { print(__extract_lane_i32x4__(w, 1)) } else { print(w) }
const s = word(-1)
if s is v128 { print("vector") } else { print(s) }

// A generic instance at a bare vector (the pin was an i32 before).
function id<T>(x: T): T { x }
print(__extract_lane_i32x4__(id(__splat_i32x4__(8)), 0))

// The else-less tail `if` that assigns a vector, its result read (PL-044's first program).
let want: v128 = __splat_i32x4__(0)
function f(op: i32) {
  if op == 0 { want = __splat_i32x4__(1) }
}
if f(0) != null { print(__extract_lane_i32x4__(want, 0)) }
