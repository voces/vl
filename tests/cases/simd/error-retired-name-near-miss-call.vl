// @error undeclared identifier 'ltF32x4'; did you mean `a.lt(b)`, the `lt` that takes `F32x4`?
// A retired name called as a near miss. The keyed-method hint deliberately supersedes the
// type-name note it used to get ("did you mean 'F32x4'?"): `F32x4` is the type, not the function.
import { splatF32 } from "std:simd"

const a = splatF32(1.0)
const b = splatF32(2.0)
print(ltF32x4(a, b).anyTrue())
