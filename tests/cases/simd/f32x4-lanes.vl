// @log 1.5
// @log 2.5
// @log 3.5
// @log 4.5
// @log true
// @log true
// @log true
// @log true
// @log 10
// @log 20
// @log 30
// @log 40
// @log 1.5
// @log -1
// @log 2.5
// @log 3.5
// @log 4.5
// @log 1.5
// @log -2
// @log 3.5
// @log 4.5
// @log 1.5
// @log 2.5
// @log -3
// @log 4.5
// @log 1.5
// @log 2.5
// @log 3.5
// @log -4
// @log 1.5
// @log 2.5
// @log 3.5
// @log 4.5
// @log 6
// @log 12
// @log 40
// @log 12
// Reading and replacing single lanes of an F32x4 (simd-design.md O3). `.x .y .z .w` are
// getters and `lane(i)` / `withLane(i, x)` take a literal index; none of them is imported,
// all are reached through the vector. Lane 0 is `x` and sits at the lowest address. withLane
// answers a new vector and leaves its receiver alone. A `Lane` known only at run time works.
import { Buffer } from "std:buffer"
import { F32x4, Lane, f32x4, loadF32x4, splatF32 } from "std:simd"

const v = f32x4(1.5, 2.5, 3.5, 4.5)

function show(u: F32x4) {
  print(u.lane(0))
  print(u.lane(1))
  print(u.lane(2))
  print(u.lane(3))
}

function laneAt(u: F32x4, k: Lane) { return u.lane(k) }

function main() {
  // The getters, on an un-annotated binding.
  print(v.x)
  print(v.y)
  print(v.z)
  print(v.w)
  // Each getter is the indexed read of its lane.
  print(v.x == v.lane(0))
  print(v.y == v.lane(1))
  print(v.z == v.lane(2))
  print(v.w == v.lane(3))

  // Lane 0 is the lowest address.
  const b = Buffer(32)
  b.storeF32(0, 10.0)
  b.storeF32(4, 20.0)
  b.storeF32(8, 30.0)
  b.storeF32(12, 40.0)
  show(b.loadF32x4(0))

  // withLane on every lane: a new vector, and the original unchanged.
  const w0 = v.withLane(0, -1.0)
  print(v.x)
  show(w0)
  show(v.withLane(1, -2.0))
  show(v.withLane(2, -3.0))
  show(v.withLane(3, -4.0))
  show(v)

  // A vector parameter as the receiver, and a runtime lane index.
  const s = splatF32(2.0) * f32x4(3.0, 6.0, 20.0, 0.0)
  print(laneAt(s, 0))
  print(laneAt(s, 1))
  let k: Lane = 0
  if b.loadI32(4) > 0 { k = 3 }
  print(b.loadF32x4(0).lane(k))
  print(s.y)
}
main()
