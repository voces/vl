// @run
// @log 7
// @log 2
// @log 3
// @log 4
// @log 5
// @log 6
// @log 15
// A cell of a list of nullable vectors read past its null, unboxed to the vector: a `??` in a
// function and at the top, a cell tested non-null then read, one returned, one passed on, and
// a loop's cells summed.
import { F32x4, splatF32 } from "std:simd"

function lane(v: F32x4) { return v.x }
function orSeven(zs: (F32x4 | null)[], i: i32): F32x4 {
  return zs[i] ?? splatF32(7.0)
}
const xs: (F32x4 | null)[] = []
xs.push(null)
xs.push(splatF32(2.0))
xs.push(splatF32(3.0))
print(orSeven(xs, 0).x)
print((xs[1] ?? splatF32(0.0)).y)
if xs[2] != null { print(xs[2].z) }
function firstSet(zs: (F32x4 | null)[]): F32x4 { return zs[1] ?? splatF32(4.0) }
const ys: (F32x4 | null)[] = [null, null]
print(firstSet(ys).x)
print(lane(ys[0] ?? splatF32(5.0)))
print(lane(xs[0] ?? splatF32(6.0)))
let s: f32 = 0.0
let i = 0
while i < 3 {
  s = s + (xs[i] ?? splatF32(10.0)).x
  i = i + 1
}
print(s)
