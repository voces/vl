// @error no method 'select' for Mask32x4 — no `select(self: …)` in scope takes it; one takes `self: F32x4`
// `select` is keyed on the value, `a.select(m, b)`, not on the mask; the refusal names the plain
// name, never a receiver overload's internal spelling.
import { splatF32 } from "std:simd"

const a = splatF32(1.0)
const m = a.lt(a)
print(m.select(a, a).x)
