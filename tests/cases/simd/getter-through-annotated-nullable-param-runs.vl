// @run
// @log 1
// @log 1
// @log 2
// A getter read through a parameter annotated `F32x4 | null`, behind an if-guard, an early
// return or an else arm, runs: the getter is found through the parameter's type (D16945).
import { F32x4, splatF32 } from "std:simd"

function a(v: F32x4 | null) {
  if v != null { print(v.y) }
}
function b(v: F32x4 | null) {
  if v == null { return }
  print(v.y)
}
function c(v: F32x4 | null) {
  if v == null { print(0) } else { print(v.y) }
}
const x: F32x4 | null = splatF32(1.0)
a(x)
b(x)
c(splatF32(2.0))
