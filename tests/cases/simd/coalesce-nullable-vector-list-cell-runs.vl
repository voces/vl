// @run
// @log 7
// @log 2
// @log 11
// @log 3
// @log 6
// `??` read straight off a cell of a list of nullable vectors chooses the element or the
// default: a constant and a loop index, chained, and inside a function.
import { F32x4, splatF32 } from "std:simd"

const xs: (F32x4 | null)[] = []
xs.push(null)
xs.push(splatF32(2.0))
print((xs[0] ?? splatF32(7.0)).x)
print((xs[1] ?? splatF32(7.0)).y)
let s = 0.0
let i = 0
while i < 2 {
  s = s + (xs[i] ?? splatF32(9.0)).x
  i = i + 1
}
print(s)
const ys: (F32x4 | null)[] = []
ys.push(null)
ys.push(splatF32(3.0))
print((ys[0] ?? ys[1] ?? splatF32(0.0)).z)
function first(zs: (F32x4 | null)[]): F32x4 { zs[0] ?? splatF32(6.0) }
print(first(ys).x)
