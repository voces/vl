// @run
// @log 2
// @log 3
// @log 5
// @log 6
// @log 0
// @log 4
// @log 3
// @log 9
// A list of vectors is a flat `v128` list: an inferred and an annotated literal, `push`, an index
// read and write, a compound write, `for … in`, `pop`, `slice`, a list passed and returned, a
// list in a record field, and the generic list methods at a vector element.
import { F32x4, splatF32 } from "std:simd"
import { reduce } from "std:array"

const inferred = [splatF32(1.0), splatF32(2.0)]
print(inferred.length)
const xs: F32x4[] = []
xs.push(splatF32(3.0))
print(xs[0].y)
xs[0] = xs[0] + splatF32(2.0)
print(xs[0].z)
xs[0] += splatF32(1.0)
print(xs[0].w)
let s = 0.0
for v in inferred { s = s + v.x }
const popped = inferred.pop()
if popped != null { print(popped.x - s + 1.0) }
function grow(ys: F32x4[], n: i32): F32x4[] {
  let i = 0
  while i < n {
    ys.push(splatF32(i as f32))
    i = i + 1
  }
  ys
}
print(grow([], 5).slice(4, 5)[0].x)
type M = { ps: F32x4[] }
const m: M = { ps: [splatF32(1.0)] }
m.ps.push(splatF32(3.0))
print(m.ps[1].x)
const doubled = m.ps.map((v) => v * splatF32(3.0))
print(doubled.reduce((a, v) => a + v, splatF32(0.0)).x / 1.3333334)
