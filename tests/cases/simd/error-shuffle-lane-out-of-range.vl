// @check
// @error __shuffle_f32x4__ requires a compile-time lane index literal in 0..7
// A shuffle picks each result lane from the eight lanes of its two inputs (0..3 from the first,
// 4..7 from the second), each an immediate, so lane 8 names nothing.
function main() {
  const v = __splat_f32x4__(1.0)
  const w = __shuffle_f32x4__(v, v, 0, 1, 2, 8)
  print(__extract_lane_f32x4__(w, 0))
}
main()
