// @check
// @error-at 4:51 `foo` here names a parameter at 5:11, not a function with a `self` parameter
// A fn-typed parameter declares no `self` parameter, so it does not dispatch.
type P = { x: i32 }
function g(foo: (self: P) => i32, p: P) { return p.foo() }
print(g((self: P) => self.x + 6, { x: 1 }))
