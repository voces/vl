// @run
// @log 171
// @log 18
// A nested `self` function shadows the module one only inside its frame.
type P = { x: i32 }
function foo(self: P) { self.x + 17 }
function main() {
  function foo(self: P) { self.x + 170 }
  const p: P = { x: 1 }
  print(p.foo())
}
main()
const q: P = { x: 1 }
print(q.foo())
