// @check
// @error-at 8:10 'foo' is not a method — its first parameter is named `q`, not `self`, and a UFCS call `x.foo(…)` dispatches only to a `self` first parameter; rename it to `self`, or call `foo(…)` directly
// A local lambda whose first parameter is not `self` shadows the module function and does not dispatch.
type P = { x: i32 }
function foo(self: P) { self.x + 19 }
function main() {
  const foo = (q: P) => q.x + 190
  const p: P = { x: 1 }
  print(p.foo())
}
main()
