// @check
// @error-at 8:10 `foo` here names a const at 8:2, not a function with a `self` parameter
// A non-function const in a module-level block shadows the module function.
type P = { x: i32 }
function foo(self: P) { self.x + 14 }
const p: P = { x: 1 }
{
  const foo = 2
  print(p.foo())
  print(foo)
}
