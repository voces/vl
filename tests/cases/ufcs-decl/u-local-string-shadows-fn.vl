// @check
// @error-at 8:10 `foo` here names a const at 7:2, not a function with a `self` parameter
// A non-function string const shadows the module function.
type P = { x: i32 }
function foo(self: P) { self.x + 18 }
function main() {
  const foo = "s"
  const p: P = { x: 1 }
  print(p.foo())
  print(foo)
}
main()
