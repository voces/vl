// @check
// @error-at 6:26 `foo` here names a parameter at 7:11, not a function with a `self` parameter
// A lambda's non-function parameter shadows the module function.
type P = { x: i32 }
function foo(self: P) { return self.x + 15 }
const p: P = { x: 1 }
const f = (foo: i32) => p.foo() + foo
print(f(100))
