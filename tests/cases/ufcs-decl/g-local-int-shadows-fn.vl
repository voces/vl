// @check
// @error-at 8:10 `foo` here names a let at 7:2, not a function with a `self` parameter
// A non-function let shadows the module `self` function by lexical scope.
type P = { x: i32 }
function foo(self: P) { self.x + 7 }
function main() {
  let foo = 1
  const p: P = { x: 1 }
  print(p.foo())
  print(foo)
}
main()
