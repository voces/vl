// @run
// @log 5
// @log 6
// A method call reaches a `self` function declared in a function body, over a record and an i32 (D4196).
type Foo = { v: i32 }
function main() {
  function bump(self: Foo) { return self.v + 1 }
  const f: Foo = { v: 4 }
  return f.bump()
}
function other(n: i32) {
  function twice(self: i32) { return self * 2 }
  return n.twice()
}
print(main())
print(other(3))
