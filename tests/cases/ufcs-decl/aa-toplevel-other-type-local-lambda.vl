// @run
// @log 25
// @log a!
// A local `self` lambda over another type shadows the module function; both calls run (D14546).
type P = { x: i32 }
function foo(self: string) { self + "!" }
function main() {
  const foo = (self: P) => self.x + 24
  const p: P = { x: 1 }
  print(p.foo())
}
main()
print("a".foo())
