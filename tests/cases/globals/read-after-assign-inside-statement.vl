// @log 5
// @log 5
// @log 3
// @log 3
// A function reading a binding with no initializer, called after the write inside the statement
// that assigns it, reads the value: the binding holds it from its first write (D14361).
function t() { 1 == 1 }

let n: i32
function rd() { return n }
function show() { print(rd()) }
if t() {
  n = 1
  show()
} else {
  n = 2
}
show()

let s: string
function rds() { return s }
if t() {
  s = "a"
  print(rds())
} else {
  s = "b"
}
print(rds())

let m: i32
function rdm() { return m }
const k = 1
match k {
  1 => {
    m = 5
    print(rdm())
  }
  _ => {
    m = 6
  }
}
print(rdm())

let w: i32
function setw() { w = 3 }
function rdw() { return w }
if t() {
  setw()
  print(rdw())
} else {
  w = 1
}
print(rdw())
