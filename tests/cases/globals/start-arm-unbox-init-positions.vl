// Q58 position sweep: a record global whose initializer is a maker's union of records delivered
// at the declared record, the arm's unbox written by the start body's delivery, read as a scalar
// and a union call argument, a nested call argument, a concat operand, an interpolation hole, a
// return, a let initializer, an if arm, a `??` operand and a record field.
type J = { a: i32 }
type K = { j: J | null }
function show(n: i32) { return "\{n}" }
function mk(b: boolean) { return if b { { j: { a: 1 } } } else { { j: null } } }
const k: K = mk(false)
const t: K = mk(true)
function takeI(x: i32) { print(x) }
function takeU(x: i32 | string) {
  if x is string { print(x) } else { print(x + 100) }
}
function inc(x: i32) { return x + 1 }
function ret(): K { return t }
takeI(t.j?.a ?? 5)
function viaU() { takeU(k.j?.a ?? 5) }
viaU()
takeI(inc(t.j?.a ?? 5))
function viaCat() { print("s" + show(k.j?.a ?? 5)) }
viaCat()
function viaHole() { print("i=\{t.j?.a ?? 5}") }
viaHole()
print(ret().j?.a ?? 9)
const l = k
print(l.j?.a ?? 6)
print(if l.j == null { t.j?.a ?? 0 } else { 0 })
print(k.j?.a ?? 7)
const r = { v: t }
print(r.v.j?.a ?? 8)
