// @trap
// A module global read before its initializer ran is a runtime error (owner ruling 2026-09-26).
// `n`'s initializer is not a constant the module folds, so its cell holds the zero default
// until the start function reaches the declaration; `rn` runs before that and read `0` (D2652).
function rn(): i32 { n }
print(rn())
const n = 3 + 4
