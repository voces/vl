// @run
// @log b
// @log null
// @log a
// @log b
// @log b
// The setters return `0` so each is a value expression the top level can sequence; the
// binding is not read, which is what the leading `_` declares.
// @hint Intentionally-unused variable `_r0` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_r1` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_r2` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_r3` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_r4` (leading `_` marks it unused)
// ASSIGNING TO A MODULE GLOBAL AT THE `Arm | null` NICHE (D1111).
//
// `emitAssign`'s `global.set` arm coerced the RHS into the union BOX whenever the cell's
// annotation named a union — under a comment reading "a union GLOBAL's cell is ALWAYS the box
// (`globalCellKind` has no kind-8 variant cell)". It has both an `variant` arm and a
// `nulvariant` one, so `let gv: S | null` over a union ARM `S` names a union while its cell is
// `(ref null $uVarHeap[vi])`, and the arm stored a `{tag, payload}` box into it: `vl check`
// rc 0 over a module the engine refuses.
//
// THE KIND IS THE DESTINATION'S OWN, and it is the only thing that can answer "is this
// position box-shaped". Three faces of one seam are graded here: the object-literal RHS (which
// needs `pendingVariantIdx`, else it builds the box), the bare `null` RHS (which needs the
// arm's heap for its `ref.null`, and was the loud `bare null needs a struct-typed context`),
// and a narrowed-arm RHS read from another global (D1031's ninth boundary, unchanged).
type K = "a" | "b"
type S = { k: K, n: i32 }
type Other = { o: string }
type U = S | Other
function mk(): U { { o: "x" } }

let gv: S | null = null
const gw: S | null = { k: "a", n: 1 }

// The union is LIVE — without a value flowing through it the arms never intern.
const t = mk()
if t is S { print("s") }

function setLit() {
  gv = { k: "b", n: 2 }
  0
}
const _r0 = setLit()
const e0 = gv
if e0 == null { print("null") } else { print(e0.k) }

function setNull() {
  gv = null
  0
}
const _r1 = setNull()
const e1 = gv
if e1 == null { print("null") } else { print(e1.k) }

function setFromGlobal() {
  gv = gw
  0
}
const _r2 = setFromGlobal()
const e2 = gv
if e2 == null { print("null") } else { print(e2.k) }

function setNarrowedArm(u: U) {
  if u is S { gv = u }
  0
}
const _r3 = setNarrowedArm({ k: "b", n: 3 })
const e3 = gv
if e3 == null { print("null") } else { print(e3.k) }

// THE KIND-8 SIBLING: an object literal assigned to a bare `variant` global. Same seed, same
// arm, and it was check-clean invalid wasm too — the cell is `(ref $uVarHeap[vi])` and the
// literal built the box.
let gb: S = { k: "a", n: 4 }
function setBare() {
  gb = { k: "b", n: 5 }
  0
}
const _r4 = setBare()
print(gb.k)
