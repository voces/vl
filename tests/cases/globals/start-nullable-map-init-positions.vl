// Q58 position sweep: a nullable map global initialized by `Map()`, stored into its ref niche by
// the start body, read as a scalar and a union call argument, a nested call argument, a concat
// operand, an interpolation hole, a return, a let initializer, an if arm, a `??` operand and a
// record field.
const m: {[string]: i32} | null = Map()
function show(n: i32) { return "\{n}" }
function fill() {
  if m != null { m["a"] = 3 }
}
fill()
function takeM(x: {[string]: i32} | null) {
  if x != null { print(x["a"] ?? 0) } else { print("N") }
}
function takeU(x: {[string]: i32} | string | null) {
  if x is string { print(x) }
  else if x != null { print("map") }
  else { print("N") }
}
function size(x: {[string]: i32} | null) {
  return if x != null { x.length } else { -1 }
}
function ret(): {[string]: i32} | null { return m }
takeM(m)
function viaU() { takeU(m) }
viaU()
print(size(ret()))
print("s" + show(size(m)))
print("i=\{size(m)}")
takeM(ret())
const l = m
takeM(l)
const c = size(l) > 0
takeM(if c { m } else { null })
takeM(m ?? null)
const r = { v: m }
takeM(r.v)
