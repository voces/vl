// @run
// @log 7
// @warning Field `J.f` is never read (remove it)
// @hint Intentionally-unused variable `_dA` (leading `_` marks it unused)
// Q58 position sweep: the narrowed nullable-cell read as return.
type J = { f: i32 | null, g: i32 }
function mk2() { return { f: null, g: 7 } }
const _dA: J = mk2()
const __m = Map()
__m["k"] = mk2()
const __mv = __m["k"]
if __mv != null {
  const r = (): J => {
    return __mv
  }
  print(r().g)
}
