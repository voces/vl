// @run
// A module binding read at another rep than its cell's: a `K | null` read as `K` after an
// assignment (print, argument, `string` binding, compare), a map read named in functions declared
// above it and null-tested, and a holder of an un-annotated function read into another binding.
type K = "ww" | "zz"
function pick(b: boolean): K { return if b { "ww" } else { "zz" } }
function show(k: K) { return "k=" + k }
let g: K | null = null
g = pick(true)
print(g)
print(show(g))
const gs: string = g
print(gs)
print(g == "ww")
const m = Map()
m["a"] = { v: 1 }
function has() { return x != null }
function hasNot() { return x == null }
function either() { return if x != null { "some" } else { "none" } }
const x = m["a"]
print(has())
print(hasNot())
print(either())
function id1(a) { return a + 1 }
function id3(a) { return a + 101 }
const q0 = { f: id3 }
const q1 = q0
let u = { f: id1 }
u = q1
print(u.f(2))
print(u.f(2.5))
// @log ww
// @log k=ww
// @log ww
// @log true
// @log true
// @log false
// @log some
// @log 103
// @log 103.5
