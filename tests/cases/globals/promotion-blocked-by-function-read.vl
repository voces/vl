// @run
// @log 3
// @log 10
// @log 20
// @log 25
// THE INVERTED CONTROL for start-local promotion (G2c). Both bindings below are plain
// i32 scalars declared at top level with an initializer, in a program that has a
// top-level statement list — every cheap clause of the safety predicate holds for both,
// and both are reassigned. They differ in exactly one thing: `pinned` is named inside a
// function body, so it must stay a module GLOBAL cell (a wasm local of the start
// function is not addressable from another function's frame), while `promoted` is named
// nowhere but the top level and takes the local.
//
// The structural assertion — the module declares EXACTLY ONE global, `pinned`'s — lives
// in `tests/vl_global_promotion_test.ts`. Exactly one is the sharp form: zero would mean
// the predicate promoted a binding a function writes, and two would mean it refused a
// binding nothing else names, which would leave this file testing nothing.
let pinned: i32 = 3
let promoted: i32 = 10

function bumpPinned(n: i32) {
  pinned = pinned + n
}

print(pinned)
print(promoted)
promoted = promoted + 10
print(promoted)
bumpPinned(2)
print(pinned + promoted)
