// @log i=4
// @log 4
// @log 4
// @log 4
// @log 4
// @log 4
// Q58 position sweep: a widened global whose initializer is a value join of literals and a
// narrower read, written by the start body's widen arm, read as a scalar and a union call
// argument, a nested call argument, a concat operand, an interpolation hole, a return, a let
// initializer, an if arm, a `??` operand and a record field.
function show(n: f64) { return "\{n}" }
function id(n: i32) { return n }
const c = id(1) == 1
const n = id(4)
const x = if c { n } else { 2.5 }
const y = if !c { 3000000000 } else { n }
function takeF(v: f64) { print(v) }
function takeU(v: f64 | string) {
  if v is string { print(v) } else { print(v + 100.0) }
}
function half(v: f64) { return v / 2.0 }
function ret() { return y }
function maybe(k: i32): f64 | null { return if k > 0 { 1.0 } else { null } }
takeF(x)
takeU(x)
takeF(half(x))
print("s" + show(x))
print("i=\{y}")
print(ret())
const l = x
print(l)
print(if c { y } else { 0 })
print(maybe(0) ?? x)
const r = { v: y }
print(r.v)
