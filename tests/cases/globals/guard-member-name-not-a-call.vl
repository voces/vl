// @run
// @log 1
// @log 3
// A field read named like a free function does not reach that function: `lo.k` runs before
// `u`'s declaration, and `k()` only after it, so `u` takes no read-before-init guard (D2652).
type R = { k: i32 }
const lo: R = { k: 1 }
print(lo.k)
const u = [3]
function k() { print(u[0]) }
k()
