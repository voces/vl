// @run
// @log false
// @log 7
// @warning Field `J.f` is never read (remove it)
// @hint Intentionally-unused variable `_dA` (leading `_` marks it unused)
// Neighbour: the nullable global read un-narrowed, delivered whole and through `?.`.
type J = { f: i32 | null, g: i32 }
function mk2() { return { f: null, g: 7 } }
const _dA: J = mk2()
const __m = Map()
__m["k"] = mk2()
const __mv = __m["k"]
const w = __mv
print(w == null)
print(w?.g ?? 0)
