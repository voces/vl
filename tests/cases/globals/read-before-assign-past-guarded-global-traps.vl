// @trap
// `g` is guarded (a function that reads it is reachable before its declaration), so the
// progress cell moves past it before `n` is assigned. Numbered by declaration, `n` would read
// as already passed and `rd` would print `0`; it is numbered where it is assigned (D14360).
function rg(b: boolean) {
  if b { print(g[0]) }
}
function rd() { n }
rg(false)
let n: i32
const g = [4]
print(rd())
n = 1
print(rd())
