// @hint redundant type annotation: `idi` is inferred as `i32`
// @hint redundant type annotation: `ids` is inferred as `string`
// @hint redundant type annotation: `early` is inferred as `i32`
// @hint redundant type annotation: `gs` is inferred as `string`
// @hint redundant type annotation: `gi` is inferred as `i32`
// A module global written by a function that may run before the global's initializer (so the
// write is guarded, D2654), at each place the written value comes from and each place the write
// sits. Each setter is reached once before its `let` with `go` false, so the guard passes after.
type P = { x: i32 }
function idi(v: i32): i32 { return v }
type Bi = { f: i32 }
function boxi(v: i32): Bi { return { f: v } }
function ids(v: string): string { return v }
type Bs = { f: string }
function boxs(v: string): Bs { return { f: v } }
function idq(v: string | null): string | null { return v }
type Bq = { f: string | null }
function boxq(v: string | null): Bq { return { f: v } }
function idu(v: i32 | string): i32 | string { return v }
type Bu = { f: i32 | string }
function boxu(v: i32 | string): Bu { return { f: v } }
function idr(v: P): P { return v }
type Br = { f: P }
function boxr(v: P): Br { return { f: v } }
function parami(v: i32, go: boolean) {
  if go { gi = v }
}
function calli(v: i32, go: boolean) {
  if go { gi = idi(v) }
}
function nesti(v: i32, go: boolean) {
  if go { gi = idi(idi(v)) }
}
function armi(v: i32, go: boolean, v2: boolean) {
  if go { gi = if v2 { v } else { v + 1 } }
}
function coali(v: i32, go: boolean, nn: i32 | null) {
  if go { gi = nn ?? (v) }
}
function fieldi(v: i32, go: boolean) {
  if go { gi = boxi(v).f }
}
function params(v: string, go: boolean) {
  if go { gs = v }
}
function calls(v: string, go: boolean) {
  if go { gs = ids(v) }
}
function nests(v: string, go: boolean) {
  if go { gs = ids(ids(v)) }
}
function arms(v: string, go: boolean, v2: boolean) {
  if go { gs = if v2 { v } else { v + "!" } }
}
function coals(v: string, go: boolean, nn: string | null) {
  if go { gs = nn ?? (v) }
}
function fields(v: string, go: boolean) {
  if go { gs = boxs(v).f }
}
function holes(v: string, go: boolean) {
  if go { gs = "<\{v}>" }
}
function paramq(v: string | null, go: boolean) {
  if go { gq = v }
}
function callq(v: string | null, go: boolean) {
  if go { gq = idq(v) }
}
function nestq(v: string | null, go: boolean) {
  if go { gq = idq(idq(v)) }
}
function armq(v: string | null, go: boolean, v2: boolean) {
  if go { gq = if v2 { v } else { v } }
}
function coalq(v: string | null, go: boolean, nn: string | null | null) {
  if go { gq = nn ?? (v) }
}
function fieldq(v: string | null, go: boolean) {
  if go { gq = boxq(v).f }
}
function paramu(v: i32 | string, go: boolean) {
  if go { gu = v }
}
function callu(v: i32 | string, go: boolean) {
  if go { gu = idu(v) }
}
function nestu(v: i32 | string, go: boolean) {
  if go { gu = idu(idu(v)) }
}
function armu(v: i32 | string, go: boolean, v2: boolean) {
  if go { gu = if v2 { v } else { v } }
}
function coalu(v: i32 | string, go: boolean, nn: i32 | string | null) {
  if go { gu = nn ?? (v) }
}
function fieldu(v: i32 | string, go: boolean) {
  if go { gu = boxu(v).f }
}
function paramr(v: i32, go: boolean) {
  if go { gr = { x: v } }
}
function callr(v: i32, go: boolean) {
  if go { gr = idr({ x: v }) }
}
function nestr(v: i32, go: boolean) {
  if go { gr = idr(idr({ x: v })) }
}
function armr(v: i32, go: boolean, v2: boolean) {
  if go { gr = if v2 { { x: v } } else { { x: v + 1 } } }
}
function coalr(v: i32, go: boolean, nn: P | null) {
  if go { gr = nn ?? ({ x: v }) }
}
function fieldr(v: i32, go: boolean) {
  if go { gr = boxr({ x: v }).f }
}
function loopi(v: i32, go: boolean) {
  let k = 0
  while go && k < 2 {
    gi = gi + v
    k = k + 1
  }
}
function clo(v: i32, go: boolean) {
  const f = () => {
    gi = v * 2
  }
  if go { f() }
}
function early(v: i32, go: boolean): i32 {
  if !go { return 0 }
  gi = v
  return gi
}
parami(10, false)
calli(11, false)
nesti(12, false)
armi(13, false, true)
coali(14, false, null)
fieldi(15, false)
params("w6", false)
calls("w7", false)
nests("w8", false)
arms("w9", false, true)
coals("w10", false, null)
fields("w11", false)
holes("w12", false)
paramq("q13", false)
callq("q14", false)
nestq("q15", false)
armq("q16", false, true)
coalq("q17", false, null)
fieldq("q18", false)
paramu("u19", false)
callu("u20", false)
nestu("u21", false)
armu("u22", false, true)
coalu("u23", false, null)
fieldu("u24", false)
paramr(35, false)
callr(36, false)
nestr(37, false)
armr(38, false, true)
coalr(39, false, null)
fieldr(40, false)
loopi(1, false)
clo(1, false)
early(1, false)
let gi: i32 = 3
let gs: string = "s"
let gq: string | null = null
let gu: i32 | string = 0
let gr: P = { x: 0 }
parami(10, true)
print(gi)
calli(11, true)
print(gi)
nesti(12, true)
print(gi)
armi(13, true, true)
print(gi)
coali(14, true, null)
print(gi)
fieldi(15, true)
print(gi)
params("w6", true)
print(gs)
calls("w7", true)
print(gs)
nests("w8", true)
print(gs)
arms("w9", true, true)
print(gs)
coals("w10", true, null)
print(gs)
fields("w11", true)
print(gs)
holes("w12", true)
print(gs)
paramq("q13", true)
print(gq ?? "none")
callq("q14", true)
print(gq ?? "none")
nestq("q15", true)
print(gq ?? "none")
armq("q16", true, true)
print(gq ?? "none")
coalq("q17", true, null)
print(gq ?? "none")
fieldq("q18", true)
print(gq ?? "none")
paramu("u19", true)
print(gu)
callu("u20", true)
print(gu)
nestu("u21", true)
print(gu)
armu("u22", true, true)
print(gu)
coalu("u23", true, null)
print(gu)
fieldu("u24", true)
print(gu)
paramr(35, true)
print(gr.x)
callr(36, true)
print(gr.x)
nestr(37, true)
print(gr.x)
armr(38, true, true)
print(gr.x)
coalr(39, true, null)
print(gr.x)
fieldr(40, true)
print(gr.x)
loopi(2, true)
print(gi)
clo(4, true)
print(gi)
print(early(6, true))
