// @run
// @log 7
// Q58 position sweep: the narrowed nullable-cell read as coalesce.
import { toString } from "std:fmt"
type J = { f: i32 | null, g: i32 }
function mk2() { return { f: null, g: 7 } }
const dA: J = mk2()
const __m = Map()
__m["k"] = mk2()
const __mv = __m["k"]
function sj(j: J): i32 { return j.g + (j.f ?? 0) }
function su(j: J | string): i32 { return if j is string { 0 } else { j.g } }
function sc(n: i32): i32 { return n + 1 }
if __mv != null {
  const m: J | null = if dA.f != null { dA } else { null }
  print((m ?? __mv).g)
}
