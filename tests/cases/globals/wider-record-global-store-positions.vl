// @log 100
// @log 110
// @log 120
// @log 12
// A wider record (a declared subtype) assigned to a global of the narrower record, the
// assignment's value in each position, one position per function.
type A = { x: i32 }
type B = { x: i32, y: i32 }
type H = { p: A | null }
let k = 0
function nb(): B {
  k = k + 1
  return { x: k, y: k * 10 }
}
function yOf(q: B): i32 { return q.y }
function yOr(q: B | null): i32 { return q?.y ?? 0 }
function id(q: B): B { return q }
let a: A = { x: 0 }
function stmt(): i32 {
  a = nb()
  return a.x
}
function arg(): i32 { return yOf(a = nb()) }
function unionArg(): i32 { return yOr(a = nb()) }
function nested(): i32 { return yOf(id(a = nb())) }
function concat(): string { return "y" + "\{yOf(a = nb())}" }
function hole(): string { return "hole \{(a = nb()).y}" }
function ret(): B { return a = nb() }
function init(): i32 {
  const c = a = nb()
  return c.y
}
function field(): i32 {
  const h = { f: a = nb() }
  return h.f.y
}
function arm(): i32 { return if k >= 0 { (a = nb()).y } else { 0 } }
function coal(): i32 {
  const o: B | null = if k > 100 { null } else { a = nb() }
  return (o ?? nb()).y
}
a = nb()
print(a.x)
print(stmt())
print(arg())
print(unionArg())
print(nested())
print(concat())
print(hole())
print(ret().y)
print(init())
print(field())
print(arm())
print(coal())
print(a.x)
