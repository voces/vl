// @run
// @log 7
// @log 7
// @log 7
// @log 7
// @log 9
// An i64 / f64 GLOBAL assignment widens an i32 RHS to the cell's valtype.
//
// `emitAssign`'s LOCAL arm has widened both since they were written — its own comment calls
// the gap a soundness hole ("the checker accepts the assignment") — but the GLOBAL arm never
// got either. `let a: i64 = 0` + `a = 7` pushed a bare `i32.const 7` into the `(mut i64)`
// cell and the module was rejected (`type mismatch: expected i64, found i32`), `vl check`
// clean, at TOP LEVEL as much as inside a function.
//
// An already-wide RHS makes the widener a no-op, which is why only the INTEGER-literal
// spelling was broken and `a = b` / `a = a + 1` / `a = 1.5` all ran: the last line pins that
// the no-op path still works after the widening arms were inserted ahead of it.

let bi: i64 = 0
let bf: f64 = 0.0
let ci: i64 = 0
let cf: f64 = 0.0
let acc: i64 = 8

const n: i32 = 7

bi = 7 // i32 literal into an i64 global, at top level
print(bi)

bf = 7 // i32 literal into an f64 global
print(bf)

// NB neither assignment may sit in TAIL position: a tail assignment is the function's
// implicit return value, and the emitter re-reads the CELL there while the return kind was
// classified off the RHS — a separate, still-open mismatch (filed, not this fixture's subject).
function inFn(): i32 {
  ci = n // an i32 IDENT, from inside a function
  cf = n
  return 0
}
print(inFn() + ci)
print(cf)

// an already-i64 RHS still needs no widening
acc = acc + 1
print(acc)
