// @run
// A module `const` bound to `null`, read through a local by functions declared before and after it,
// is the `_ | null` hole the binding holds, not a placeholder (D17160).
function before() {
  const v = g
  print(v == null)
}
const g = null
function after() {
  const v = g
  print(v == null)
}
before()
after()
// @log true
// @log true
