// @run
// A module `const` initialized by a call returning `null`, read through a local by a function declared
// before it, un-annotated and annotated (D17160).
function mk() { return null }
function mk2(): null { return null }
function show() {
  const v = g
  const w = h
  print(v == null)
  print(w == null)
}
const g = mk()
const h = mk2()
show()
// @log true
// @log true
