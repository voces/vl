// @run
// @log 1
// @log 0
// @log 0
// @log 2
// @log 0
// The kind-15 twin of `nullable-global-const-cell-seed-leak.vl`, over a second seed.
//
// An `i32[] | null` cell lowers its bare `null` as `ref.null $lTypeIdx` through the
// boolean `pendingNulList`, not through the heap index `pendingNulRefHeap`, and
// `emitNullBySeed` reads the boolean first — so a leak here outranks every other null
// rep in the module rather than merely competing with one. Same const-cell scope
// question, same three victim positions, a different variable carrying it.
//
// Left armed, `before`, `after` and `pick`'s `return null` all lower as
// `ref.null $lTypeIdx` into an `(ref null $S)` destination: `type mismatch: expected
// (ref null $type), found (ref null $type)`, `vl check` clean.

type S = { v: i32 }

const before: S | null = null
const armer: i32[] | null = [1]
const after: S | null = null

function pick(n: i32): S | null {
  if n > 0 { return { v: n } }
  return null
}

function readArmer() { if armer != null { armer[0] } else { 0 } }
function readBefore() { if before != null { before.v } else { 0 } }
function readAfter() { if after != null { after.v } else { 0 } }

print(readArmer())
print(readBefore())
print(readAfter())

// The non-null arm of the same function, so the `return null` arm cannot be claiming
// every call.
const some = pick(2)
if some != null { print(some.v) } else { print(-1) }
const none = pick(0)
if none == null { print(0) } else { print(1) }
