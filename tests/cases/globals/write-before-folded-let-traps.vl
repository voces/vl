// @trap
// A `let` whose initializer is a constant holds that value from instantiation, so a read can
// never precede it, but a write can: `setG` stored `5` and, the initializer having no start-time
// store to overwrite it with, the program printed `5` instead of `7` (D2654).
function setG() { g = 5 }
setG()
let g = 7
print(g)
