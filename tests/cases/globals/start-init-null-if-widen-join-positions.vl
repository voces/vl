// @run
// @log 1
// @log true
// @log 3000000001
// @log x3000000000
// @log h 3000000000
// @log 3000000000
// @log 3000000000
// @log 3000000000
// @log 3000000000
// @log 3000000000
// @info `v1` is never reassigned; use `const` instead of `let`
// @info `c` is never reassigned; use `const` instead of `let`
// Start-body shapes the IR claims: a `null`-typed global written as an `if` (run for its effect)
// and a widened global whose join nests a narrower join; the value read in several positions,
// one per function.
let k = 0
function bump() {
  k = k + 1
  return k > 0
}
const n0 = if bump() { null } else { null }
let v1 = 5
let c = true
const x = if c { 3000000000 } else { if c { v1 } else { 1 } }
function arg() { return x + 1 }
function show(v: i64) { return "\{v}" }
function concat() { return "x" + show(x) }
function hole() { return "h \{x}" }
function ret() { return x }
function init() {
  const y = x
  return y
}
function field() {
  const r = { f: x }
  return r.f
}
function arm(t: boolean) { return if t { x } else { 0 } }
function coal(t: boolean) {
  const o = if t { null } else { x }
  return o ?? x
}
function nulls() { return n0 == null }
print(k)
print(nulls())
print(arg())
print(concat())
print(hole())
print(ret())
print(init())
print(field())
print(arm(true))
print(coal(true))
