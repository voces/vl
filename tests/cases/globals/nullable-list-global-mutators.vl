// @run
// @log 2
// @log 3
// @log 2
// @log 0
// @log 3
// @log 2
// The `.push` / `.pop` / `.clear` RECEIVER over a NULLABLE-list GLOBAL — kind 18
// (`S[] | null`) and kind 15 (`i32[] | null`) alike.
//
// A list op resolves a bare-local receiver to the local itself, but every OTHER receiver
// (a module GLOBAL, a struct field, an index) is evaluated once into the op frame's
// `recvRef` scratch slot — which is a NON-NULL wrapper ref. The Ident→global read
// deliberately leaves a nullable LIST cell un-recovered (the `g != null` compare has to
// see the raw cell), so the stash pushed a `(ref null $wrap)` into a `(ref $wrap)` slot:
// `type mismatch: expected (ref $type), found (ref null $type)`, `vl check` clean, `vl
// run` rejected. The LOCAL twin ran — a local receiver IS the frame slot and is never
// staged — which is what makes this a storage-class divergence rather than a list bug.
//
// The receiver of a list op is non-null by the checker's own narrowing (an un-narrowed
// `g.push(x)` over `g: T[] | null` is a type error), so the recover never traps.

type S = { n: i32 }

// (1) kind 18: push onto a `S[] | null` global.
let xs: S[] | null = []
xs = [{ n: 1 }, { n: 2 }]
print(xs.length)
xs.push({ n: 3 })
print(xs.length)

// (2) kind 18: pop. The mutation is observed through the LENGTH — BINDING the popped
// value off a GLOBAL list (`const t = g.pop()`) is a separate live defect, red for a
// NON-nullable `i32[]` global too (`expected (ref null $type), found i32`); filed, and
// deliberately not spelled here so this fixture pins one mechanism.
xs.pop()
print(xs.length)

// (3) kind 18: clear.
xs.clear()
print(xs.length)

// (4) kind 15: the same three over an `i32[] | null` global — broken on master for the
// same reason, and healed by the same recover.
let ns: i32[] | null = []
ns = [1, 2]
ns.push(3)
print(ns.length)
ns.pop()
print(ns.length)
