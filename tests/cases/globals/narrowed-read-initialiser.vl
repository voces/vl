// @run
// @log 1
// @log 2
// @log 1.5
// @log 1.5
// @log 10
// @log 4
// @log 1
// @log 12
// @log 8
// A module binding initialised from a nullable global that an earlier statement assigned takes
// the narrowed type the checker gave the read, as the same binding inside a function does.
let vv: i32 | null = null
vv = 1
const v31 = vv ?? -1
print(v31)

let copy = vv
copy = copy + 1
print(copy)

let fv: f64 | null = null
fv = 1.5
print(fv ?? -1.0)
const fw = fv ?? -1.0
print(fw)

let lv: i64 | null = null
lv = 9
const lw = lv ?? 0
print(lw + 1)

let cv: i32 | null = null
cv = 3
const cw = cv
const g = () => cw + 1
print(g())

{
  const bw = vv ?? -1
  print(bw)
}

function twice(x: i32) { return x * 2 }
let av: i32 | null = null
av = 6
const aw = av
print(twice(aw))

let rv: i32 | null = null
rv = 1
const ra = rv
rv = null
const rb = rv ?? 7
print(ra + rb)
