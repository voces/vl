// @check
// @error-at 7:31 operator '+' is not defined for string and i32
// @error-at 11:6 return type mismatch: expected string, got i32 (the return of `g2` at the call's argument types)
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// A function body reading an un-annotated module global declared after it is checked against
// the global's type, as it is when the global comes first: `string + i32` is refused (D3078).

function f2(x: string) { print(x + k) }
function g2<T>(_x: T): T { return k }
const k = 2 + 3
f2("s")
print(g2("s"))
