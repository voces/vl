// @run
// @log 2
// @log 2
// @log 4
// @log 2
// @log 2
// @log 4
// @log 2
// @log w!
// @log hole w
// @log 100
// A union global narrowed to a `T | null` niche, read in each position.
const u: string | i32[] | null = if 1 > 2 { "s" } else { [4, 5] }
const s: string | i32[] | null = if 1 > 2 { [1] } else { "w" }
function len(x: i32[] | null) { return if x == null { 0 } else { x.length } }
function either(x: i32[] | string | null) {
  return if x is string { 100 } else if x == null { 0 } else { x.length }
}
function str(x: string | null) { return x ?? "none" }
function back(): i32[] | null {
  if !(u is string) { return u }
  return null
}
if !(u is string) {
  print(len(u))
  print(either(u))
  print(len(back()) + len(u))
  const v = u
  print(len(v))
  const r = { f: u }
  print(len(r.f))
  print((u ?? [9])[0])
  print(len(if u == null { null } else { u }))
}
if !(s is i32[]) {
  print(str(s) + "!")
  print("hole \{s ?? "none"}")
  print(either(s))
}
