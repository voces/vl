// @run
// @log 7
// @log 7
// @log 21
// @log 10.5
// @log true
// @log st
// @log 9
// @log 15
// @log 7
// @log 7
// @log 7
// @log 10
// @log 7
// Every global below is read only after its initializer ran, so none carries the
// read-before-init guard (D2652) and each read is the value its initializer stored. `k` is a
// constant the module folds into its cell, so even the early read `rk()` sees it.
function seven() { 7 }
function mkMap(): Map<string, i32> {
  const m: Map<string, i32> = Map()
  m["a"] = seven()
  m
}
function pickU(): string | i32 { seven() }
function pickN(): i32 | null { seven() }
function mkClo(): (i32) => i32 {
  (x: i32) => x + seven()
}
function rk() { k }
print(rk())
const k = 7
const gi = seven()
const gl = seven() as i64 * 3
const gf = seven() * 1.5
const gb = seven() > 3
const gs = "s" + "t"
const gp = { x: seven(), y: 2 }
const gxs = [seven(), 8]
const gm = mkMap()
const gu = pickU()
const gn = pickN()
const gc = mkClo()
function readAll() {
  print(gi)
  print(gl)
  print(gf)
  print(gb)
  print(gs)
  print(gp.x + gp.y)
  print(gxs[0] + gxs[1])
  print(gm["a"] ?? -1)
  print(if gu is i32 { gu } else { -1 })
  print(gn ?? -1)
  print(gc(3))
}
readAll()
const later = (): i32 => gi
print(later())
