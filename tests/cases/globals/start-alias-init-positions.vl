// Q58 position sweep: a module global aliasing a generic function, written by the start body's
// alias arm as the capture-free closure core, called as a scalar and a union call argument, a
// nested call argument, a concat operand, an interpolation hole, a return, a let initializer, an
// if arm, a `??` operand and a record field.
function add(a, b) { return a + b }
const g = add
function takeI(x: i32) { print(x) }
function takeU(x: i32 | string) {
  if x is string { print(x) } else { print(x + 100) }
}
function inc(x: i32) { return x + 1 }
function ret() { return g(4, 5) }
function maybe(k: i32): i32 | null { return if k > 0 { k } else { null } }
takeI(g(1, 2))
takeU(g(1, 3))
takeI(inc(g(2, 2)))
print("s" + g("a", "b"))
print("i=\{g(3, 3)}")
print(ret())
const l = g(5, 5)
print(l)
const c = l > 3
print(if c { g(6, 1) } else { 0 })
print(maybe(0) ?? g(7, 1))
const r = { v: g(8, 1) }
print(r.v)
