// @run
// @log 1.5
// @log 0
// @log 0
// @log 2
// @log 0
// A const cell's null-rep seeds are scoped to that cell's own init.
//
// A const global's constexpr init runs in the global section, emitted before every
// function body and before the synthetic start function, so a seed armed there and not
// cleared reaches all three — and declaration order does not rescue it, because
// `emitGlobalSection` runs every const cell before `emitCodeSection` runs any body.
//
// The value at risk is a `f64[] | null` cell's own wrapper. A bare `null` is never a
// WasmGC constexpr (`isConstInit` has no `NullLit` arm), so every `= null` global is a
// start-function victim rather than a const one. Left armed, the victims below lower
// `ref.null $fl64` into a `(ref null $S)` cell and into an `S | null` return:
// `type mismatch: expected (ref null $type), found (ref null $type)`, `vl check` clean.
//
// Three victim positions carry the pin: a global declared after the armer, one declared
// before it, and a `return null` in a function body. Reading the armer back is the
// control — its cell still holds its own wrapper, so the scoping cannot be claiming a
// non-list init.

type S = { v: i32 }

const before: S | null = null
const armer: f64[] | null = [1.5]
const after: S | null = null

function pick(n: i32): S | null {
  if n > 0 { return { v: n } }
  return null
}

function readArmer() { if armer != null { armer[0] } else { 0.0 } }
function readBefore() { if before != null { before.v } else { 0 } }
function readAfter() { if after != null { after.v } else { 0 } }

print(readArmer())
print(readBefore())
print(readAfter())

// The non-null arm of the same function, so the `return null` arm cannot be claiming
// every call.
const some = pick(2)
if some != null { print(some.v) } else { print(-1) }
const none = pick(0)
if none == null { print(0) } else { print(1) }
