// @run
// @log 7
// @log q
// @log 7
// @log 7
// @log 7
// @log 7
// @log 1.5
// @log 7
// @log 0
// @info `gb` is never reassigned; use `const` instead of `let`
// @hint redundant type annotation: `gl` is inferred as `i32[]` — remove it to lean on inference
// @hint redundant type annotation: `gc` is inferred as `{v: i32}` — remove it to lean on inference
// @hint redundant type annotation: `gf` is inferred as `f64` — remove it to lean on inference
// @hint redundant type annotation: `gb` is inferred as `{v: i32}` — remove it to lean on inference
// CONTRACT (must-RUN): a function whose LAST statement is an else-less `if` whose arm ASSIGNS
// a module global (D1220). The tail `if` makes the assignment the function's value, so the
// function's inferred return is `T | null` — and for a STRUCT global that inference had no
// annotation for `fnRetNullBearing` / `emitNullForRet` to read, so the fall-through was
// `unreachable` padding under a `(ref null $C)` result: a TRAP at `vl check` rc 0.
//
// THE DESTINATION KIND IS THE AXIS, so every rep is here: i32, string, list, struct,
// `C | null`, map and f64 globals, plus a struct FIELD target. (`i64` is D1303 and is
// deliberately absent — it is invalid wasm on master too, and at a different layer.)
//
// THE NEGATIVE CONTROL is `setVoid`, which pins the other half of D1086's ruling: a `: void`
// annotation must keep the same tail `if` a STATEMENT. Its `print(0)` after the call is what
// proves the caller had nothing to drop.
type C = { v: i32 }

let gi = 0
let gs = "a"
let gl: i32[] = [0]
let gc: C = { v: 1 }
let gn: C | null = null
let gf: f64 = 0.0
let gb: C = { v: 1 }
const gm = Map()

function setI(y: C) {
  if y.v > 0 { gi = y.v }
}
function setS(y: C) {
  if y.v > 0 { gs = "q" }
}
function setL(y: C) {
  if y.v > 0 { gl = [y.v] }
}
function setC(y: C) {
  if y.v > 0 { gc = y }
}
function setN(y: C) {
  if y.v > 0 { gn = y }
}
function setM(y: C) {
  if y.v > 0 { gm["k"] = y.v }
}
function setF(y: C) {
  if y.v > 0 { gf = 1.5 }
}
function setB(y: C) {
  if y.v > 0 { gb.v = y.v }
}
function setVoid(y: C): void {
  if y.v > 0 { gi = y.v }
}

setI({ v: 7 })
print(gi)
setS({ v: 7 })
print(gs)
setL({ v: 7 })
print(gl[0])
setC({ v: 7 })
print(gc.v)
setN({ v: 7 })
print((gn ?? { v: 0 }).v)
setM({ v: 7 })
print(gm["k"] ?? 0)
setF({ v: 7 })
print(gf)
setB({ v: 7 })
print(gb.v)
setVoid({ v: 7 })
print(0)
