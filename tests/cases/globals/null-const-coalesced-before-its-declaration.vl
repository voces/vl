// @run
// A module `const` bound to `null` read by `??` in functions declared before it, at a string and an
// i32 default, through a local and directly (D17160).
function s() {
  const v = g
  print(v ?? "n")
}
function i() {
  const v = g
  print((v ?? 3) + 1)
}
function pick() { return g ?? "dflt" }
const g = null
s()
i()
print(pick())
// @log n
// @log 4
// @log dflt
