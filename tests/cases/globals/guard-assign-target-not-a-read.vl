// @run
// @log 1
// @log b
// The statement that assigns a no-initializer `let` does not read it, so a function that reads
// the binding only after that statement leaves it unguarded (D2652).
let n: i32
n = 1
function readN() { return n }
print(readN())
let s: string
s = "a"
function fill() { s = "b" }
function readS() { return s }
fill()
print(readS())
