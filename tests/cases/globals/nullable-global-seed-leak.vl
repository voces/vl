// @run
// @log V
// @log N
// @log V
// @log N
// The start function's null-rep seeds must not LEAK from one global to the next.
//
// `emitStartFnCode` clears `pendingNulBool` / `pendingNulString` / `pendingNulClosure`
// / `pendingMapSlot` / `pendingStructIdx` / the list seeds after each global's
// initializer — but never `pendingNulRefHeap`, which the `nulmap` arm has always armed.
// `emitNullLitNode` clears that one only when it CONSUMES it, so a global whose init is
// NOT a bare `null` (here `Map()`) left it armed, and the NEXT global's bare `null` took
// the map struct's heap type instead of its own: `type mismatch: expected (ref null
// $S), found (ref null $mapStruct)` — an invalid module from two ordinary declarations,
// `vl check`-clean. The `| null` list seeds this file's siblings add arm the same
// variable, so the clear is what keeps them from widening the hole.
//
// The order is load-bearing: the ARMER (a non-null-initialized nullable map) must come
// first and the VICTIM (any other nullable ref cell initialized to `null`) second.

type S = { v: i32 }

const m: {[string]: i32} | null = Map()
const s: S | null = null

function obM(x: {[string]: i32} | null) {
  if x != null { print("V") } else { print("N") }
}
function obS(x: S | null) {
  if x != null { print("V") } else { print("N") }
}
function obC(x: ((i32) => i32) | null) {
  if x != null { print("V") } else { print("N") }
}

obM(m)
obS(s)

// The same shape with a nullable CLOSURE as the victim — a third ref rep, so the pin
// is not specific to the struct heap type.
const m2: {[string]: i32} | null = Map()
const c: ((i32) => i32) | null = null
obM(m2)
obC(c)
