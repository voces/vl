// @run
// @log 2
// @log 2
// @log 0
// @log 7
// @log 0
// @log 4
// @log 1
// @log 9
// @log 2
// THE EMPTY-`[]` INITIALIZER over a kind-18 (`S[] | null`) GLOBAL. `nullable-refarray-
// global-read.vl` (#1211) pinned seven READ cells of such a global and every one of them
// initializes the cell to a NON-EMPTY literal; this file is the `= []` / `= null` column,
// which nothing covered and which was broken end to end.
//
// A global re-derives its kind PER READ from the `letIs*` ladder (a local files its kind
// once, in `buildLocals`, and never re-consults the initializer). `letIsArray` falls
// through to the INITIALIZER when the annotation is not an i32 array — and an EMPTY `[]`
// has no element to classify, so it answers "i32 list". `exprArray`'s global arm therefore
// claimed `let g: S[] | null = []` as the MONO i32 list while `globalCellKind` gave the
// cell the ref-list wrapper: `.length` read `struct.get $i32ListWrap 1` off a
// `(ref null $refListWrap)` — `type mismatch: expected (ref null $type), found (ref null
// $type)`, `vl check` clean and `vl run` rejected. The `= null` initializer classified as
// NOTHING at all (a bare `null` is no list), so the same reads fell out of the list family
// and hit `emitProgram: field access receiver is not a struct`.
//
// Both are one gap: `exprRefArray`'s Ident arm never grew the third storage class. The
// LOCAL reads `declaredKind == "nulreflist"` and the PARAM `paramNulRefArray`; the global
// arm now asks `globalCellKind` — the CELL's own answer, the same keying
// `exprNullableRefArray`'s global arm uses — so a read cannot disagree with the cell, and
// the element ROW comes from the annotation `emitGlobalSection` itself reads
// (`letAnnRefListSlot`), not from an initializer that names no element.

type S = { n: i32 }

// (1) THE FILED SHAPE: empty init, then a NON-EMPTY assignment, read directly (the
// assignment narrows the cell non-null, so no `!= null` guard is needed — nor allowed).
let xs: S[] | null = []
xs = [{ n: 1 }, { n: 2 }]
print(xs.length)
print(xs[1].n)

// (2) the EMPTY assignment over the same cell — the filing recorded this neighbour as
// running; it rejected the module exactly like (1).
let ys: S[] | null = []
ys = []
print(ys.length)

// (3) the `= null` INITIALIZER with a non-empty assignment — the loud-emit-error column.
let zs: S[] | null = null
zs = [{ n: 7 }]
print(zs[0].n)

// (4) the UNASSIGNED empty cell, observed through the `!= null` narrow.
const ks: S[] | null = []
if ks != null { print(ks.length) }

// (5) the NESTED (`S[][] | null`) and NULLABLE-ELEMENT (`(S | null)[] | null`) spellings
// of the same empty init — different ref-list rows, same classifier.
let ns: S[][] | null = []
ns = [[{ n: 3 }], [{ n: 4 }]]
print(ns[1][0].n)

let es: (S | null)[] | null = []
es = [{ n: 5 }]
print(es.length)

// (6) an INDEXED STORE through the cell, and the read back.
let ws: S[] | null = []
ws = [{ n: 1 }]
ws[0] = { n: 9 }
print(ws[0].n)

// CONTROL — the LOCAL twin of (1), which ran on master and must keep running: it is the
// witness that this was a storage-class divergence and not a list-machinery bug.
function localTwin() {
  let ls: S[] | null = []
  ls = [{ n: 1 }, { n: 2 }]
  print(ls.length)
}
localTwin()
