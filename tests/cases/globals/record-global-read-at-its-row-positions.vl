// @run
// @log 7
// @log 7
// @log 7
// @log 7
// @log v7
// @log hole 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 3
// @warning `B` is the same type as `A` ({v: i32}); this union has one member. help: add a discriminant field
// A struct global read at a record its cell's row holds (a declared union of equal records,
// narrowed to its inline spelling while a nominal twin exists), one position per function.
type R = { v: i32 } | { v: i32 }
type A = { v: i32 }
type B = { v: i32 }
type N = A | B
function get(x: { v: i32 }) { return x.v }
function some(x: { v: i32 } | null) { return x?.v ?? 0 }
function wrap(x: { v: i32 }): { v: i32 } { return x }
const r: R = { v: 7 }
const n: N = { v: 3 }
function arg() {
  let o = 0
  if r is { v: i32 } { o = get(r) }
  return o
}
function unionArg() {
  let o = 0
  if r is { v: i32 } { o = some(r) }
  return o
}
function nested() {
  let o = 0
  if r is { v: i32 } { o = get(wrap(r)) }
  return o
}
function concat() {
  let o = ""
  if r is { v: i32 } { o = "v" + "\{r.v}" }
  return o
}
function hole() {
  let o = ""
  if r is { v: i32 } { o = "hole \{r.v}" }
  return o
}
function ret(): { v: i32 } {
  if r is { v: i32 } { return r }
  return { v: 0 }
}
function init() {
  let o = 0
  if r is { v: i32 } {
    const c = r
    o = c.v
  }
  return o
}
function field() {
  let o = 0
  if r is { v: i32 } {
    const h = { f: r }
    o = h.f.v
  }
  return o
}
function arm(c: boolean) {
  let o = 0
  if r is { v: i32 } { o = if c { r.v } else { 0 } }
  return o
}
function coal(c: boolean) {
  let o = 0
  if r is { v: i32 } {
    const m = if c { null } else { r }
    o = (m ?? r).v
  }
  return o
}
if r is { v: i32 } { print(r.v) }
print(arg())
print(unionArg())
print(nested())
print(concat())
print(hole())
print(ret().v)
print(init())
print(field())
print(arm(true))
print(coal(false))
print(n.v)
