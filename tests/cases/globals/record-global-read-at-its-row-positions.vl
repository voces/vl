// @run
// @log 7
// @log 7
// @log 7
// @log 7
// @log v7
// @log hole 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 3
// A struct global read at a record its cell's row holds (a declared union of equal records,
// narrowed to its inline spelling while a nominal twin exists), one position per function.
type R = { v: i32 } | { v: i32 }
type A = { v: i32 }
type B = { v: i32 }
type N = A | B
function get(x: { v: i32 }): i32 { return x.v }
function some(x: { v: i32 } | null): i32 { return x?.v ?? 0 }
function wrap(x: { v: i32 }): { v: i32 } { return x }
const r: R = { v: 7 }
const n: N = { v: 3 }
function arg(): i32 { return if r is { v: i32 } { get(r) } else { 0 } }
function unionArg(): i32 { return if r is { v: i32 } { some(r) } else { 0 } }
function nested(): i32 { return if r is { v: i32 } { get(wrap(r)) } else { 0 } }
function concat(): string { return if r is { v: i32 } { "v" + "\{r.v}" } else { "" } }
function hole(): string { return if r is { v: i32 } { "hole \{r.v}" } else { "" } }
function ret(): { v: i32 } {
  if r is { v: i32 } { return r }
  return { v: 0 }
}
function init(): i32 {
  if r is { v: i32 } {
    const c = r
    return c.v
  }
  return 0
}
function field(): i32 {
  if r is { v: i32 } {
    const h = { f: r }
    return h.f.v
  }
  return 0
}
function arm(): i32 { return if r is { v: i32 } { if r.v > 1 { r.v } else { 0 } } else { 0 } }
function coal(): i32 {
  if r is { v: i32 } {
    const o: { v: i32 } | null = if r.v > 100 { null } else { r }
    return (o ?? r).v
  }
  return 0
}
if r is { v: i32 } { print(r.v) }
print(arg())
print(unionArg())
print(nested())
print(concat())
print(hole())
print(ret().v)
print(init())
print(field())
print(arm())
print(coal())
print(n.v)
