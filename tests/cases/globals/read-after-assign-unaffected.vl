// @run
// @log 1
// @log a
// @log 8
// @log 9
// No-initializer `let`s at i32 and string, read through functions only after the `if` that
// assigns both on every path. `maybe(false)` makes every reader reachable first, so `k`, `j`
// and both bindings are guarded, with `k` declared before the `if` and `j` after it: the
// progress cell passes each binding where it is assigned (D14360).
function rd() { n }
function rs() { s }
function rk() { n + k[0] + j[0] }
function maybe(b: boolean) {
  if b { print(rd() + rk()); print(rs()) }
}
maybe(false)
let n: i32
let s: string
const k = [7]
if (1 > 0) {
  n = 1
  s = "a"
} else {
  n = 2
  s = "b"
}
const j = [0, 1]
print(rd())
print(rs())
print(rk())
n = 2
print(rk())
