// @run
// A copy of a module container in a function declared above the top-level writes that pin it is
// that container, so the copy reads what those writes stored (D16364).
function one() {
  const v = xs
  print(v[0] + 1.0)
}
function two() {
  const w = m
  print(w.get("k") ?? 0.0)
}
const xs = []
xs.push(1.5)
const m = Map()
m.set("k", 2.5)
one()
two()
// @log 2.5
// @log 2.5
