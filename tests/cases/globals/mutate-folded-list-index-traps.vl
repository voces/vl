// @trap
// @info `g` is never reassigned; use `const` instead of `let`
// A folded record or list initializer is built at instantiation, so a function that mutates the
// object before the declaration used to keep its change past the initializer (D2654 review).
// The mutation goes through a read of the global, which is now guarded when it can run early.
// Master prints `5`.
function w() { g[0] = 5 }
w()
let g = [1, 2]
print(g[0])
