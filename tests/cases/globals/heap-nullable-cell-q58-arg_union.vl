// @run
// @log 7
// @hint Intentionally-unused variable `_dA` (leading `_` marks it unused)
// @hint redundant type annotation: `su` is inferred as `i32` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// Q58 position sweep: the narrowed nullable-cell read as arg_union.
type J = { f: i32 | null, g: i32 }
function mk2() { return { f: null, g: 7 } }
const _dA: J = mk2()
const __m = Map()
__m["k"] = mk2()
const __mv = __m["k"]
function su(j: J | string): i32 { return if j is string { 0 } else { j.g } }
if __mv != null { print(su(__mv)) }
