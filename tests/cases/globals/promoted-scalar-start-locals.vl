// @run
// @log 55
// @log 55
// @log 5050
// @log 2.5
// @log 4.5
// @hint redundant type annotation: `total` is inferred as `i32`
// @hint redundant type annotation: `twice` is inferred as `i32`
// @hint redundant type annotation: `acc` is inferred as `f64`
// A top-level scalar `let` that NO function names lives in a LOCAL of the synthetic
// start function rather than a module global cell (G2c, `emit_state.vl`). A mutable
// wasm global is observable module state an engine must keep in memory; a local lives
// in a register, and a top-level accumulator loop is several times faster for it.
//
// This case is the BEHAVIOUR half of the pin — every binding below is promoted, so the
// module declares no globals at all, and the values it prints must be exactly what the
// same program prints with cells. The STRUCTURE half (the module really does declare
// zero globals) is `tests/selfhost_native_global_promotion_test.ts`, which builds this
// very file; the inverted control is `promotion-blocked-by-function-read.vl`.
//
// `twice` is here on purpose: a module with functions still promotes the bindings
// those functions do not name, and `total` crossing a call as an ARGUMENT is a
// top-level mention, not a function-body one.
let total: i32 = 0
for i in 1 to 10 {
  total = total + i
}
print(total)

function twice(n: i32): i32 { n * 2 }
print(twice(total) - total)

let big: i64 = 0
let k: i64 = 0
while k < 100 {
  k = k + 1
  big = big + k
}
print(big)

let acc: f64 = 0.0
acc = acc + 2.5
print(acc)

let small: f32 = 1.5
small = small * 3.0
print(small)
