// @run
// @log 2.5
// @log 103.5
// @log 9
// @log s2
// @log i=3
// @log 5
// @log 6
// @log 7
// @log 8
// @log 9
// @log 4
// Q58 position sweep: a global annotated at one member of a bundle holder's closures, written by
// the start body's holder arm as the member pick, called as a scalar and a union call argument, a
// nested call argument, a concat operand, an interpolation hole, a return, a let initializer, an
// if arm, a `??` operand and a record field.
function show(n: f64) { return "\{n}" }
function lap(f) {
  f(2.5)
  f(3)
  return f
}
const h = lap((a) => a + 1)
const v: (f64) => f64 = h
function takeF(x: f64) { print(x) }
function takeU(x: f64 | string) {
  if x is string { print(x) } else { print(x + 100.0) }
}
function dbl(x: f64) { return x * 2.0 }
function ret() { return v(4.0) }
function maybe(k: i32): f64 | null { return if k > 0 { 1.0 } else { null } }
takeF(v(1.5))
takeU(v(2.5))
takeF(dbl(v(3.5)))
print("s" + show(v(1.0)))
print("i=\{v(2.0)}")
print(ret())
const l = v(5.0)
print(l)
const c = l > 3.0
print(if c { v(6.0) } else { 0.0 })
print(maybe(0) ?? v(7.0))
const r = { x: v(8.0) }
print(r.x)
print(h(3))
