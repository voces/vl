// @run
// @log 5
// @log 6
// @log 1
// @log 7
// @log 8
// @log 9
// @log 3
// D1106 — an UN-ANNOTATED module global bound to a `<ref-array> | null` value.
//
// The annotated arm of `globalCellKind` has carried the kind-18 cell since the read side
// needed it; the un-annotated arm never grew it, so `const r = mk()` with `mk(): P[] | null`
// fell through to the i32 guess. `exprNullableRefArray`'s global rung asks that very
// function, so it answered false and the `r != null` compare's bare `null` had no rep at
// all: `emitProgram: bare null needs a struct-typed context` on a check-clean program (and
// silent invalid wasm where the binding is never read).
//
// TWO DISTINCT ELEMENT ROWS IN ONE MODULE, deliberately. The slot half of the fix is
// `letAnnRefListSlot`'s un-annotated leg, and its predecessor answered `0` — which is not
// "no slot" but the FIRST slot, so a module with one such global cannot tell the two apart.
// With `P` and `Q` both live, a cell typed from the wrong row is `expected (ref null $type),
// found (ref null $type)`.
//
// Every cell reads an ELEMENT through the narrowed global, so a wrapper of the wrong heap
// type cannot pass by binding.

type P = { a: i32 }
type Q = { b: i32, c: i32 }

function mkP(n: i32): P[] | null {
  if n == 0 { return [{a: 5}] }
  return null
}
function mkQ(n: i32): Q[] | null {
  if n == 0 { return [{b: 6, c: 1}] }
  return null
}
function mkN(n: i32): i32[][] | null {
  if n == 0 { return [[7]] }
  return null
}
function mkM(n: i32): {[string]: i32}[] | null {
  if n == 0 {
    const q: {[string]: i32} = Map()
    q["k"] = 8
    return [q]
  }
  return null
}

const gp = mkP(0)
if gp != null { print(gp[0].a) }

const gq = mkQ(0)
if gq != null { print(gq[0].b) }
if gq != null { print(gq[0].c) }

const gn = mkN(0)
if gn != null { print(gn[0][0]) }

const gm = mkM(0)
if gm != null { print(gm[0]["k"]) }

// The `.length` read and a SECOND function's return, both of which reach the same cell.
function relay(n: i32): P[] | null { return mkP(n) }
const gr = relay(0)
if gr != null { print(gr[0].a + 4) }
if gr != null { print(gr.length + 2) }
