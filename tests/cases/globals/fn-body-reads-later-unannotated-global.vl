// @run
// @log 6
// @log 5
// @log ab!
// @log 3
// @log 6
// @log 7
// @log 5
// @log s
// A function body checked before pass 2 reaches an un-annotated module global declared after
// it reads the global's own type, not a placeholder: a return inferred from it, a lambda
// returning it and an argument built from it all type as the global does (D3078).

function plus() { return k + 1 }
function ret() { return k }
function cat() { return s + "!" }
function head() { return xs[0] }
function lam() {
  const g = () => k + 1
  return g()
}
function viaCall() { return m }
function take(n: i32) { print(n) }
function passes() { take(k) }
function gen<T>(x: T) { print(x) }

const k = 2 + 3
const s = "a" + "b"
const xs = [1, 2].map((e) => e * 3)
const m = mk()
function mk() { return 7 }

print(plus())
print(ret())
print(cat())
print(head())
print(lam())
print(viaCall())
passes()
gen("s")
