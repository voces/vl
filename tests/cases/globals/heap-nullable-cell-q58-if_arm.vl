// @run
// @log 7
// Q58 position sweep: the narrowed nullable-cell read as if_arm.
type J = { f: i32 | null, g: i32 }
function mk2() { return { f: null, g: 7 } }
const _dA: J = mk2()
const __m = Map()
__m["k"] = mk2()
const __mv = __m["k"]
if __mv != null {
  const v = if _dA.f == null { __mv } else { _dA }
  print(v.g)
}
