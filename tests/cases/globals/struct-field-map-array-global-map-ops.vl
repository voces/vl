// @run
// @log 7
// @log 41
// @log true
// @log -1
// @log false
// @log 41
// A map op on an ELEMENT of a GLOBAL STRUCT-FIELD map-array (`F.scopes[i][k]`, where
// `F` is a module global struct and `scopes` is a `{[string]: i32}[]` field), performed
// by functions that own NO map local and NO map param.
//
// `fnHasMap` reserves the shared map scratch frame by scanning LOCALS and PARAMS only,
// so this receiver is invisible to it: `mapScratchBase` would point past the declared
// locals and the map lowering emits against a local the vector never declared
// (`vl check` rc 0, `vl build` rc 1 "invalid local index"). The global-field walk
// (`fnHasGlobalMapOp` → `blockHasMapOp` → `exprHasMapOp`) is what reserves it here.
//
// All four shapes the emitter lowers as map ops appear on that receiver, one per
// function, so each is reached with the frame owed to it alone: the SET `g[k] = v`
// (`bind`), the `.has(k)` member call (`seen`), and the GET `g[k]` fused with `??`
// (`find`). `depth` is a second, non-map field so the receiver is a real struct-field
// read rather than a whole-global one.
type Frames = {
  scopes: {[string]: i32}[],
  depth: i32,
}

const F: Frames = { scopes: [], depth: 0 }

function pushFrame() {
  F.scopes.push(Map())
  F.depth = F.depth + 1
  0
}

// SET on the global-field map-array element.
function bind(name: string, ty: i32) {
  const top = F.scopes.length - 1
  F.scopes[top][name] = ty
  0
}

// GET fused with `??`, plus `.has`, walking the chain innermost-first.
function find(name: string) {
  let i = F.scopes.length - 1
  while i >= 0 {
    if F.scopes[i].has(name) { return F.scopes[i][name] ?? -1 }
    i = i - 1
  }
  -1
}

// `.has` alone, on the innermost frame only.
function seen(name: string) {
  const top = F.scopes.length - 1
  return F.scopes[top].has(name)
}

// The METHOD spelling of the fused get-with-default (`recv.get(k) ?? d`) on the same
// receiver — the fourth lowered map-op shape, and the one whose receiver sits two
// nodes deep inside the `??`.
function findTop(name: string) {
  const top = F.scopes.length - 1
  F.scopes[top].get(name) ?? -1
}

pushFrame()
bind("a", 7)
pushFrame()
bind("b", 41)
print(find("a"))
print(find("b"))
print(seen("b"))
print(find("zz"))
print(seen("a"))
print(findTop("b"))
