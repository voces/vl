// @trap
// A closure that writes a module global, called before the global's `let`, traps with the
// write-before-init message instead of having its store overwritten by the initializer (D2654).
function mk(v: i32): () => void {
  return () => {
    n = v
  }
}
const w = mk(4)
w()
let n = 3
print(n)
