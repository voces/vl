// @run
// @log false
// @log true
// @log true
// @log 4
// @log -1
// D3099: a module global annotated with a record, `null` and a scalar is the union box, whatever
// order its members are spelled in, and a generic instantiated from its narrowing reads it.
type Circle = { r: i32 }
const q: Circle | null | string = { r: 4 }
print(q is string)
const s: null | Circle | string = "x"
print(s is string)
const n: Circle | null | string = null
print(n == null)
function show(w: Circle | null) {
  if w == null { return 0 - 1 }
  return w.r
}
function id<T>(x: T): T { return x }
if !(q is string) { print(show(id(q))) }
if !(n is string) { print(show(id(n))) }
