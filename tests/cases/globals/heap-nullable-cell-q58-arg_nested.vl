// @hint redundant type annotation: `sj` is inferred as `i32` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// @hint redundant type annotation: `sc` is inferred as `i32` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// Q58 position sweep: the narrowed nullable-cell read as arg_nested.
type J = { f: i32 | null, g: i32 }
function mk2() { return { f: null, g: 7 } }
const _dA: J = mk2()
const __m = Map()
__m["k"] = mk2()
const __mv = __m["k"]
function sj(j: J): i32 { return j.g + (j.f ?? 0) }
function sc(n: i32): i32 { return n + 1 }
if __mv != null { print(sc(sj(__mv))) }
