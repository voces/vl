// @run
// @log 4
// @log 4
// @log 4
// @log c4
// @log h 4
// @log 4
// A global bound to a hole instance's result (a shared field of mixed types read through a hole
// parameter), so its reads have no type rep of their own, read in each position.
type K = { h: i32 }
type J = { h: string, z: i32 }
const k: K = { h: 4 }
const u: K | J = k
function ret(a) { return a.h }
const r = ret(u)
function show(x) { return "\{x}" }
function arg() { return show(r) }
function nested() { return show(show(r)) }
function concat() { return "c" + show(r) }
function hole() { return "h \{r}" }
function arm(c: boolean) { return if c { show(r) } else { "-" } }
print(r)
print(arg())
print(nested())
print(concat())
print(hole())
print(arm(true))
