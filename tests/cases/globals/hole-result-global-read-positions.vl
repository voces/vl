// @run
// @log 4
// @log 4
// @log 4
// @log 4
// @log 4
// A global bound to a hole instance's result (a shared field of mixed types read through a hole
// parameter), whose reads lower at its cell's rep, printed in each position.
type K = { h: i32 }
type J = { h: string, z: i32 }
const k: K = { h: 4 }
const u: K | J = k
function ret(a) { return a.h }
const r = ret(u)
function inFn() { print(r) }
function inLoop(n: i32) {
  let i = 0
  while i < n {
    print(r)
    i = i + 1
  }
}
function arm(c: boolean) {
  if c { print(r) } else { print(0) }
}
print(r)
inFn()
inLoop(2)
arm(true)
