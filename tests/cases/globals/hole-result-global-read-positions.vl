// @run
// @log 4
// @log 4
// @log 4
// @log 4
// @log 4
// A global bound to a hole instance's result (a shared field of mixed types read through a hole
// parameter), whose reads lower at its cell's rep, read in each position that prints it.
type K = { h: i32 }
type J = { h: string, z: i32 }
const k: K = { h: 4 }
const u: K | J = k
function ret(a) { return a.h }
const r = ret(u)
function show(x) { print(x) }
function twice(x) {
  show(x)
  show(x)
}
function arg() { show(r) }
function nested() { twice(r) }
function arm(c: boolean) {
  if c { show(r) } else { print(0) }
}
print(r)
arg()
nested()
arm(true)
