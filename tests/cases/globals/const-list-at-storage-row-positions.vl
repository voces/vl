// Q58 position sweep: a constant list literal of records handed where a wider record is declared,
// built at its binding's storage row as the global section's constant initializer, read as a scalar
// and a union call argument, a nested call argument, a concat operand, an interpolation hole, a
// return, a let initializer, an if arm, a `??` operand and a record field.
function sum(ps: { x: i32 | string }[]) {
  for e in ps {
    if e.x is i32 { print(e.x) }
  }
}
const xs = [{ x: 6 }, { x: 7 }]
sum(xs)
function takeI(v: i32) { print(v) }
function takeU(v: i32 | string) {
  if v is string { print(v) } else { print(v + 100) }
}
function inc(v: i32) { return v + 1 }
function show(n: i32) { return "\{n}" }
function ret() { return xs.length }
function maybe(k: i32): i32 | null { return if k > 0 { k } else { null } }
takeI(xs.length)
takeU(xs.length)
takeI(inc(xs.length))
print("s" + show(xs.length))
print("i=\{xs.length}")
print(ret())
const l = xs.length
print(l)
print(if l > 1 { xs.length } else { 0 })
print(maybe(0) ?? xs.length)
const r = { n: xs.length }
print(r.n)
