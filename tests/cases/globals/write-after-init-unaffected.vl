// @run
// @log 8
// @log uv
// @log 12
// @log 9
// Every write below runs after its global's initializer, so none carries the write guard
// (D2654) and each lands and is read back.
function seven() { 7 }
let n = seven()
function bump() { n = n + 1 }
bump()
print(n)
let s = "s" + "t"
function setS() { s = "u" + "v" }
setS()
print(s)
let xs = [seven(), 1]
function setXs() { xs = [seven(), 5] }
setXs()
print(xs[0] + xs[1])
for i in 0 until 1 { bump() }
print(n)
