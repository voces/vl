// @trap
// A no-initializer `let` that only a function assigns: no top-level statement assigns it, as
// the checker reads it, so a read through a function is before its value wherever it runs
// (D14360). The function's own early write is not refused, since no initializer overwrites it.
let n: i32
function fill() { n = 5 }
function rd() { n }
fill()
print(rd())
