// @trap
// A later global's initializer reads a no-initializer `let` through a function before its
// first assignment. That initializer runs after the binding's declaration, so the progress
// cell must order a binding by where it is assigned, not where it is declared (D14360).
let n: i32
function rd() { n }
function mk() {
  print(rd())
  [1]
}
const m = mk()
n = 3
print(rd() + m[0])
