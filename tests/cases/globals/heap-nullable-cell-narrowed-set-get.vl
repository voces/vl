// @run
// @log 12
// @log 4
// @hint Intentionally-unused variable `_dA` (leading `_` marks it unused)
// The same through `set`/`get`: the narrowed read takes its record row's heap.
type J = { f: i32 | null, g: i32 }
function mk2() { return { f: null, g: 11 } }
const _dA: J = mk2()
const __m = Map()
__m.set("k", mk2())
const __mv = __m.get("k")
if __mv != null {
  const v = __mv
  print(v.g + 1)
  print(v.f ?? 4)
}
