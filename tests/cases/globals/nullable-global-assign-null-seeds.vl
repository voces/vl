// @run
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log 7
// THE GLOBAL half of the assign-`null` seed gap.
//
// `emitAssign`'s GLOBAL arm seeded only the boolean, string and closure niches, so
// re-assigning `null` to a nullable list, literal-union, struct, scalar-list or map
// GLOBAL rejected the module with `emitProgram: bare null needs a struct-typed context`
// — while the identical LOCAL binding (once its own gap was closed) and the global's own
// INITIALIZER both lowered `null` fine. The arm now seeds the same reps the global
// initializer does, resolved from the cell kind (`globalCellKind`) exactly as the init
// path resolves them.
//
// The last line is the CONTROL: a non-null value assigned back must still lower normally.

type S = { v: i32 }
type K = "a" | "b"

let gList: i32[] | null = [7]
gList = null
if gList == null { print(0) }

let gLitUnion: K | null = "a"
gLitUnion = null
if gLitUnion == null { print(0) }

let gStruct: S | null = { v: 7 }
gStruct = null
if gStruct == null { print(0) }

let gF64List: f64[] | null = [7.5]
gF64List = null
if gF64List == null { print(0) }

let gStrList: string[] | null = ["a"]
gStrList = null
if gStrList == null { print(0) }

// CONTROL — a real value assigned back into a nullable-struct global, so the added seeds
// cannot be claiming a NON-null RHS. (The checker narrows `gBack` at the assignment, so
// it is read directly rather than re-tested against `null`.)
let gBack: S | null = null
gBack = { v: 7 }
print(gBack.v)
