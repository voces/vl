// @run
// A function declared above a module `[]` or `Map()` reads the container its later top-level
// writes pin, since the binding keeps the container it was hoisted at (D16364).
function one() {
  print(xs[0] + 1.0)
  print(xs.length)
}
function two() {
  print(m.get("k") ?? 0.0)
}
function three() { print(ss[0]) }
const xs = []
xs.push(1.5)
const m = Map()
m.set("k", 2.5)
const ss = []
ss.push("s")
one()
two()
three()
// @log 2.5
// @log 1
// @log 2.5
// @log s
