// @run
// @log 1
// @log bc
// @log 2
// @log kx
// @log 6
// @log 3
// @log -1
// A module-scope `let` with no initializer, at i32, string and a union of lists. Written in
// every arm of an `if` or `match` at top level and read after the join, then written in a
// function called from top level and read after through a function. The cell is the
// non-constant global's: nullable, zero-initialised, every ref read asserts non-null (D14281).
let n: i32
if (1 > 0) { n = 1 } else { n = 2 }
print(n)

let s: string
if (1 < 0) { s = "a" } else { s = "bc" }
print(s)

let u: i32[] | string[]
match 2 {
  2 => {
    u = ["p", "q"]
  }
  _ => {
    u = [9]
  }
}
print(u.length)

function fill(k: i32) {
  s = "k" + "x"
  n = k * 2
  if k > 0 { u = [1, 2, 3] } else { u = ["a"] }
}
function readS() { s }
function readN() { n }
function lenInts() {
  if u is i32[] { return u.length }
  -1
}
fill(3)
print(readS())
print(readN())
print(lenInts())
fill(0)
print(lenInts())
