// Q58 position sweep: a list global the global section declares at the instance list its
// initializer built (a generic's call whose element a wider record reads), stored and read at that
// list, its element read as a scalar and a union call argument, a nested call argument, a concat
// operand, an interpolation hole, a return, a let initializer, an if arm, a `??` operand and a
// record field.
type Circle = { r: i32 | null }
function show(n: i32) { return "\{n}" }
function keep<T>(xs: T[]): T[] { return xs }
function mkcall() { return { r: null } }
const ks = [{ r: null }]
print(ks.length)
const k = keep([mkcall()])
const c: Circle = k[0]
function takeI(x: i32) { print(x) }
function takeU(x: i32 | string) {
  if x is string { print(x) } else { print(x + 100) }
}
function inc(x: i32) { return x + 1 }
function ret() { return k.length }
takeI(k.length)
takeU(k.length)
takeI(inc(k.length))
print("s" + show(k.length))
print("i=\{k.length}")
print(ret())
const l = k.length
print(l)
print(if l > 0 { k.length } else { 0 })
print(c.r ?? 12)
const rec = { n: k.length }
print(rec.n)
