// @run
// @log 3
// @log 3
// @log 3
// @log 3
// @log v3
// @log h 3
// @log 3
// @log 3
// @log 3
// @log 3
// @log 3
// @hint redundant type annotation: `gn` is inferred as `M` — remove it to lean on inference
// A global whose cell is a union arm's variant row, initialized from a plain record of the arm's
// fields (an intersection that names the arm), read in each position, one per function.
type Node = { v: i32, next: Node | null }
type M = Node & { v: i32 }
type R = { w: string }
function g(u: Node | R | null) {
  if u is Node { return u.v }
  return 0
}
function mkM(): M { return { v: 3, next: null } }
const gn: Node = mkM()
function take(n: Node) { return n.v }
function arg() { return take(gn) }
function unionArg() { return g(gn) }
function nested() { return take(gn.next ?? gn) }
function concat() { return "v" + "\{gn.v}" }
function hole() { return "h \{gn.v}" }
function ret(): Node { return gn }
function init() {
  const c = gn
  return c.v
}
function field() {
  const o = { n: gn }
  return o.n.v
}
function arm(c: boolean) { return if c { gn.v } else { 0 } }
function coal() { return (gn.next ?? gn).v }
print(gn.v)
print(arg())
print(unionArg())
print(nested())
print(concat())
print(hole())
print(ret().v)
print(init())
print(field())
print(arm(true))
print(coal())
