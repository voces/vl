// @run
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log 1
// @log 9000000000
// @log 1.5
// @log 2.5
// @log a
// THE GLOBAL CELL's nullable-LIST null seeds — the initializer half of the gap whose
// re-ASSIGNMENT half `nullable-global-assign-null-seeds.vl` pins.
//
// A bare `null` is never a WasmGC constexpr (`isConstInit` has no `NullLit` arm), so
// EVERY `= null` global initializer runs in the synthetic START FUNCTION. That block
// seeded the map / struct / boolean / string / literal-union / closure cells as each
// was added and never seeded the LIST cells, so a plain
//
//     const g: i32[] | null = null
//
// reached `emitNullLitNode` with an empty context and rejected the whole module with
// `emitProgram: bare null needs a struct-typed context` — while the SAME annotation on
// a function-local lowered fine. All five leaf list reps are here: the i32-backed
// kind-15 cell and the four distinct-backing scalar lists, each of which has its own
// wrapper heap type (an i64 list must not build the i32 one).
//
// The second group is the CONTROL: the identical annotations initialized to a real
// list, read back ELEMENT-wise, so the added seeds cannot be claiming a non-null
// initializer and each cell is proved to hold its own wrapper. (`.length` on a
// narrowed `f32[] | null` is a separate, pre-existing defect — it emits an invalid
// module on master too — so the controls index instead.)

const gI32: i32[] | null = null
if gI32 == null { print(0) }

const gI64: i64[] | null = null
if gI64 == null { print(0) }

const gF32: f32[] | null = null
if gF32 == null { print(0) }

const gF64: f64[] | null = null
if gF64 == null { print(0) }

const gStr: string[] | null = null
if gStr == null { print(0) }

// CONTROL — a real list in every one of the five cells.
const vI32: i32[] | null = [1]
if vI32 != null { print(vI32[0]) }

const vI64: i64[] | null = [9000000000]
if vI64 != null { print(vI64[0]) }

const vF32: f32[] | null = [1.5]
if vF32 != null { print(vF32[0]) }

const vF64: f64[] | null = [2.5]
if vF64 != null { print(vF64[0]) }

const vStr: string[] | null = ["a"]
if vStr != null { print(vStr[0]) }
