// Q58 position sweep: a `string` global initialized from a literal-union atom, written by the
// start body's atom arm as the member's string, read as a scalar and a union call argument, a
// nested call argument, a concat operand, an interpolation hole, a return, a let initializer, an
// if arm, a `??` operand and a record field.
type Color = "red" | "green" | "blue"
const A: Color = "green"
const B: string = A
function takeS(x: string) { print(x) }
function takeU(x: i32 | string) {
  if x is string { print("u " + x) } else { print(x) }
}
function len(x: string) { return x.length }
function ret() { return B }
function maybe(k: i32): string | null { return if k > 0 { "m" } else { null } }
takeS(B)
takeU(B)
print(len(B))
print("s" + B)
print("i=\{B}")
print(ret())
const l = B
print(l)
const c = l.length > 3
print(if c { B } else { "no" })
print(maybe(0) ?? B)
const r = { v: B }
print(r.v)
