// @run
// A module `const` initialized by a call with effects that returns `null` runs that call once, in
// order, whatever a function declared before it reads of it (D17160).
let n = 0
function noisy() {
  n = n + 1
  print("init")
  return null
}
function show() {
  const v = g
  print(v == null)
}
print("start")
const g = noisy()
show()
print(n)
// @log start
// @log init
// @log true
// @log 1
