// @check
// @warning `/ 0` traps at run time — integer division by zero is a trap, not a value
// @warning `% 0` traps at run time — integer division by zero is a trap, not a value
// @warning `/ 0` traps at run time — integer division by zero is a trap, not a value
// @hint redundant type annotation: `d` is inferred as `i32`

// An integer `/ 0` or `% 0` is `vl check`-clean and TRAPS at run time. The program is
// legal and the trap is the language's own defined behaviour, so this is a `warning` —
// `for-step-zero` is the one `error` here, because a `step 0` loop is degenerate outright
// rather than a program that runs right up to the division.

// Anchored at the DIVISOR: that is the token to change. Every integer spelling of zero
// the lexer accepts counts, so the hex and separator forms are the same finding, while a
// non-zero divisor and a NAME are not — the pass reads no expression it did not lex.
function d(): i32 {
  const x = 10
  const y = 3
  const ok = x / y + x / 1 + x % 2
  return ok + x / 0 + x % 0 + x / 0x0
}
print(d())
