// @run
// @log 6
// @hint redundant type annotation: `g` is inferred as `i32`
// @hint redundant type annotation: `k` is inferred as `i32`
// D3597: an annotation on an exported declaration's signature documents the module's API,
// so the redundant-annotation hint (and `--fix` with it) stays off it. A function the module
// keeps to itself, and a binding it does not export, keep the hint.
export function f(x: i32): i32 { x + 1 }
export const m: i32 = 2
export let label: string = "k"
function g(): i32 { 3 }
const k: i32 = f(m)
print(k + g() + label.length - 1)
