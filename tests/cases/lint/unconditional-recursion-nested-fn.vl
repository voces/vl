// @check
// @warning always recurses
// @hint redundant type annotation: `spinFn` is inferred as `i32`
// @hint redundant type annotation: `hostFn` is inferred as `i32`
// The analysis is per-DECLARATION and never descends into a nested `FuncDecl`:
// an inner function's body runs only when the inner function is called, so it
// says nothing about the outer function's paths. Here `spinFn` self-recurses on
// every path and is the ONLY finding — `hostFn` returns `n` without ever
// reaching it, so exactly one warning is asserted (the shared walker reaches the
// inner declaration on its own and analyses it against its own name).
// `@check` only: `spinFn` would exhaust the stack if it were ever called.
function hostFn(n: i32): i32 {
  function spinFn(k: i32): i32 {
    return spinFn(k + 1)
  }
  return n
}
print(hostFn(1))
