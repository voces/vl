// @run
// @log 6
// @log [ab]
// @log v=a-b-c- ok
// @log abc
// prefer-interpolation stays quiet on: a numeric `+` chain, a string chain with fewer
// than three literals, a chain inside an interpolation hole, an interpolated string's
// own desugared `+`, and a chain of strings with no literal at all.
const a = "a"
const b = "b"
const c = "c"
print(1 + 2 + 3)
print("[" + a + b + "]")
print("v=\{a + "-" + b + "-" + c + "-"} ok")
print("\{a}\{b}\{c}")
