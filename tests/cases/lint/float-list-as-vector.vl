// @run
// @log 3
// @log 7
// @log 12
// @log 1.5
// @log 9
// @hint this 3-element `f64[]` is returned, so it is used as a vector
// @hint this 2-element `f64[]` is returned, so it is used as a vector
// @hint this 3-element `f32[]` goes to a parameter read only at fixed indexes
// @hint this 3-element `f64[]` is only read at fixed indexes
// LINT `float-list-as-vector`: a 2-to-4-element float list built where a record would do —
// returned, passed to an `f64[]`/`f32[]` parameter its callee reads only as `p[0]`…, or held
// in a local read only that way. Four fire below; every control in
// float-list-as-vector-no-warn.vl is a genuine list.

// FIRES: returned from a function annotated `f64[]`.
function p3(x: f64, y: f64, z: f64): f64[] { [x, z, y] }
print(p3(1.0, 2.0, 3.0)[1])

// FIRES: returned from an un-annotated function, every element visibly a float.
function half(a: f64, b: f64) {
  if a > b { return [a / 2, b] }
  [a, b * 0.5]
}
print(half(14.0, 1.0)[0])

// FIRES: an `f32[]` argument the callee reads only at fixed indexes.
function sum3(v: f32[]) { v[0] + v[1] + v[2] }
print(sum3([3.0, 4.0, 5.0]))

// FIRES: a local read only at fixed indexes.
function lerpX(a: f64, t: f64) {
  const d = [a * t, a, 0.0]
  d[0] + d[2]
}
print(lerpX(3.0, 0.5))
print(lerpX(3.0, 3.0))
