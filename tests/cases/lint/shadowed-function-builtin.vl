// @run
// @log 5
// @log 6
// @warning `floor` shadows the builtin `floor`, which this function calls above it; below it the name means the binding, so rename one
// D3599: a binding that hides a builtin the same function calls above it warns at the binding.
// A binding named like a builtin in a function that never calls the builtin (`max` in `h`) does
// not: nothing in that function can mean two things.
function g(x: f64) {
  const a = floor(x)
  const floor = 2.0
  a + floor
}
function h(max: i32) { max + 1 }
print(g(3.5))
print(h(5))
