// @check
// @warning Field `Pt.z` is never read
// @warning Field `cfg.debug` is never read
// A field of a module-private record type that no `.f` reads anywhere in the module,
// and a field of an object literal bound to a local only ever read through `.f`.
type Pt = { x: i32, y: i32, z: i32 }
function main() {
  const p: Pt = { x: 1, y: 2, z: 3 }
  p.z = 4
  print(p.x + p.y)
  const cfg = { width: 80, debug: true }
  print(cfg.width)
  0
}
main()
