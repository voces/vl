// @run
// @log 5000000000
// @log 1.5
// @log 5000000001
// @log -5000000000
// @log 7
// @hint redundant type annotation: `same` is inferred as `i32`
// D3798: an annotated literal binding read as a `??` default would, without its annotation, be
// delivered at the left operand's type, which need not hold it. The annotation is load-bearing
// there, so it is not hinted redundant. `same` matches the operand's type: its hint stays.
const l: (i32 | null)[] = [null, 4]
const big: i64 = 5000000000
print(l[0] ?? big)
const half: f64 = 1.5
print(l[0] ?? half)
let wide: i64 = 5000000000
wide = wide + 1
print(l[0] ?? wide)
const neg: i64 = 5000000000
print(l[0] ?? -neg)
const same: i32 = 7
print(l[0] ?? same)
