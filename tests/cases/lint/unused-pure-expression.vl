// LINT `unused-pure-expression` — a NON-FINAL expression statement whose value is
// discarded and whose evaluation is trivially pure does nothing at all: it is a stray
// edit or half of a deleted line. The motivating shape is a mistyped assertion —
// `it("fails", () => { 3; expect(1).toEqual(2) })` — where the `3` does nothing.
//
// FINAL statements never fire (a block's tail IS its value in this expression-oriented
// language), and neither does anything containing a call, member access, or index — nor
// an OPERATOR over identifier operands, which could dispatch to a user overload (the
// quiet shapes are pinned by `unused-pure-expression-no-warn.vl`, which declares NO
// warnings so any firing there fails strictly). Every firing here shares one message,
// so one directive covers them; the five FIRES sites below each carry the warning.
// @run
// @log stray literal
// @log 9
// @log lambda ran
// @log 5
// @warning This expression has no effect: it is not the final statement of its block, so its value is discarded

// FIRES — the motivating shape: a stray literal ahead of the real work.
function f() {
  3
  print("stray literal")
  return 9
}
print(f())

// FIRES — the same shape inside a LAMBDA body (a nameless function's block): a binary
// operator whose leaves are ALL LITERALS provably cannot dispatch to an overload
// (dispatch needs an object-typed left operand; a literal is never one).
const cb = () => {
  1 + 2
  print("lambda ran")
}
cb()

// FIRES three times — a nested all-literal operator tree behind parens, a pure array
// literal (its elements are identifier READS, which dispatch nothing), and a bare
// identifier, each discarded mid-block.
function g(a: i32, b: i32) {
  (1 + 2) * 3
  [a, b]
  a
  return a + b
}
print(g(2, 3))
