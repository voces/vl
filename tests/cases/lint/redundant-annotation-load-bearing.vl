// @run
// @log 0
// @log 9
// @log 3
// @log 5
// @log 5
// @log 1.5
// @log 1
// @log 1
// @log 7
// @log 1
// @log 3
// @log a
// @log 7
// @log 2
// @log ab
// @hint redundant type annotation: `count` is inferred as `i32`
// @hint redundant type annotation: `r` is inferred as `K`
// @hint redundant type annotation: `xs` is inferred as `i32[]`
// @hint redundant type annotation: `two` is inferred as `i32`
// @hint redundant type annotation: `s` is inferred as `string`
// No redundant-annotation hint where removing the annotation changes what the program builds
// (D3800): each binding or return before the control keeps its annotation for a reason
// inference does not see. The control's annotations are redundant and keep the hint.
type K = "a" | "b"
type P = { x: i32 }
type B = { x: f64, lean: f64 }
type Circle = { r: i32 }
type Shape = Circle | { s: i32 }

// A return the annotation pins an empty list for.
function mk(): i32[] {
  const inner = []
  inner
}
print(mk().length)

// A return read through a narrowing.
function grow(x: i32[] | i32): i32 {
  if x is i32[] {
    x.push(7)
    return x.length
  }
  x
}
print(grow(9))
print(grow([1, 2]))

// A return called through a binding a closure reassigns.
function f(g: (i32) => i32) { g(0) }
function viaLocal(): i32 {
  let op = (x: i32) => x + 1
  f((i) => {
    op = (x: i32) => x + 5 + i
    0
  })
  op(0)
}
print(viaLocal())

// A generic call's result that holds a union.
function orFive<T>(a: T | null) {
  const r = a ?? 5
  r
}
const none: P | null = null
const v: P | i32 = orFive(none)
if v is P { print(v.x) } else { print(v) }

// A record literal in one arm of the initializer.
function pick(p: B, c: boolean) {
  const t: B = if c { p } else { { x: 0.0, lean: 0.0 } }
  t.x + t.lean
}
print(pick({ x: 1.0, lean: 0.5 }, true))

// A list literal of function values.
function one(k: K) {
  if k == "a" { 1 } else { 2 }
}
const fs: ((K) => i32)[] = [one]
print(fs[0]("a"))

// A cast to a list, and an alias to a list of records.
function nested(c: boolean): i32[][] | f64[] {
  if c { return [1.5] }
  [[1]]
}
const w: i32[][] = nested(false) as! i32[][]
print(w[0][0])
const lv = [{ r: 7 }]
const shapes: Shape[] = lv
const circles: Circle[] = lv
print(circles[0].r)
print(shapes.length)

// The control: these annotations are redundant.
function count(n: i32): i32 {
  if n <= 0 { return 0 }
  count(n - 1) + 1
}
print(count(3))
function show(u) {
  const r: K = u
  print(r)
}
show("a")
const xs: i32[] = [7]
print(xs[0])
function two(): i32 { 1 + 1 }
print(two())
const s: string = "a" + "b"
print(s)
