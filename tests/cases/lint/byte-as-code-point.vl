// @run
// @log 7
// @log 6
// @log h
// @log 4
// @warning `s[i]` is a byte, not a character; use `for cp in s` or `codePoints(s)[i]`
// LINT `byte-as-code-point` (D3641, sunpa SP-029): `s[i]` over a string is a UTF-8 byte,
// so passing it where a code point is meant letters `"Hrímey"` as mojibake. It fires where
// the read flows DIRECTLY into `fromCodePoint`, a parameter of this module named `cp` or
// `codePoint`, or a comparison with a non-ASCII character literal. Five fire below; the
// controls do not: an `i32[]` element, an ASCII literal, and a byte stored in a local first.
import { codePoints } from "std:str"

function glyphOf(cp: i32) {
  if cp == 'í' { return 1 }
  0
}

// FIRES twice: sunpa's slip, a byte per glyph, and a byte compared with `'í'`.
function letter(text0: string) {
  let text = text0
  text = text + ""
  let n = 0
  for i in 0 until text.length {
    n = n + 1 + glyphOf(text[i])
    if text[i] == 'í' { n = n + 100 }
  }
  n
}
print(letter("Hrímey"))

// The fix the message names: iterate code points, or index the list of them.
function letterFixed(text: string) {
  let n = 0
  for cp in text { n = n + 1 + glyphOf(cp) }
  n
}
print(letterFixed("Hrímey") - glyphOf(codePoints("Hrímey")[2]))

// FIRES three times: through `.slice`, through a field the check types, and by name.
function firsts(s: string, xs: i32[]) {
  const inner = s.slice(0, 2)
  const r = { name: s }
  let hits = 0
  if fromCodePoint(inner[0]) == "\u{fffd}" { hits = hits + 1 }
  if fromCodePoint(r.name[1] as i32) == "\u{fffd}" { hits = hits + 1 }
  hits = hits + glyphOf(cp: s[2])
  // Quiet: an element of an `i32[]`, an ASCII literal, and a byte held in a local.
  print(fromCodePoint(xs[0]))
  if s[0] == 'H' { hits = hits + 2 }
  const b = s[2]
  if b != 'í' { hits = hits + 2 }
  hits
}
print(firsts("Hrímey", [104]))
