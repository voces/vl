// @run
// @warning `==` on `Level` compares every element of its list field `grid.cells`
// @warning `==` on `Level | null` compares every element of its list field `grid.cells`
// @warning `!=` on `Grid` compares every element of its list field `cells`
// @warning `==` on `Tagged` compares every element of its list field `tags`
// @log false
// @log false
// @log true
// @log false
// @log true
// `==` on a record holding a list compares element by element, which reads like "the same
// record" and costs O(n). Nested records, a nullable side and an optional list all count.
type Grid = { w: i32, cells: i32[] }
type Level = { name: string, grid: Grid, serial: i32 }
type Tagged = { id: i32, tags: string[] | null }

const a: Level = { name: "a", grid: { w: 1, cells: [1, 2] }, serial: 1 }
const b: Level = { name: "a", grid: { w: 1, cells: [1, 3] }, serial: 2 }
let cache: Level | null = null
if a.serial > 5 { cache = b }
print(a == b)
print(cache == a)
print(a.grid != b.grid)
const t: Tagged = { id: 1, tags: null }
print(t == { id: 2, tags: null })
print(t == t)
