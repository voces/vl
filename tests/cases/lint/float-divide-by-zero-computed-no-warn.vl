// @run
// @log Infinity
// @log NaN
// @log true
// @log true
// @log 0.5

// Only a zero LITERAL divisor warns: a named zero, a computed one and a std constant do not,
// and neither does a non-zero literal.
import { INFINITY, NAN } from "std:math"

const z = 0.0
function f(x: f64) {
  print(x / z)
  print(x % (x - x))
  print(x / z == INFINITY)
  print(NAN != NAN)
  print(x / 2.0)
}
f(1.0)
