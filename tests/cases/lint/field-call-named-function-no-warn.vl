// @run
// @log 6
// @log 6
// @log 4
// A binding read only through a call of its field that holds a named function is read (D17043):
// the checker repoints `r.f(3)` to `twice(3)`, and the unused-variable rule still sees `r`.
// Annotated and un-annotated callees, in a function and at the top level; no diagnostic.
function twice(a: i32) { return a * 2 }
function twiceU(a) { return a * 2 }
function inc0(x: i32) { return x + 1 }
function bound() {
  const r = { f: twice }
  return r.f(3)
}
function boundU() {
  const r = { f: twiceU }
  return r.f(3)
}
const a = { f: inc0 }
print(bound())
print(boundU())
print(a.f(3))
