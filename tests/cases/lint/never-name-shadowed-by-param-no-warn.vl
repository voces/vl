// @check
// A parameter that shadows a `: never` function's name is an ordinary callback: the call
// through it may return, so the code after it is reachable (D1972).
function fail(msg: string): never {
  print(msg)
  __trap__()
}
function f(n: i32, fail: (string) => void) {
  if n < 0 {
    fail("negative")
    print(n)
  }
  n
}
print(
  f(3, (s: string) => {
    print(s)
  }),
)
fail("done")
