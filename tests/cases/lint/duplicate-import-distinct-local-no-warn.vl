// @run
// @log 6
// The NEAR MISS: one source, one imported name, TWO local bindings. Nothing is
// repeated — `twice` is a second name for the same function, not a second copy
// of the same specifier — so duplicate-import stays silent. This is the third
// part of the rule's key (source, imported name, LOCAL) doing its job; keying on
// (source, local) alone would still be silent here, but keying on (source, name)
// alone would flag it wrongly.
import { used } from "./import-use-helper"
import { used as twice } from "./import-use-helper"

print(used(2) + twice(1))
