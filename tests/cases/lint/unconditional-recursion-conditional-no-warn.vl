// @run
// @log 0
// @log true
// @log 7
// @hint redundant type annotation: `countdown` is inferred as `i32`
// @hint redundant type annotation: `guard` is inferred as `boolean`
// @hint redundant type annotation: `sumTo` is inferred as `i32`
// The three ways a self-call is CONDITIONAL without an `if` guard, none of which
// may be flagged:
//   - `countdown` recurses inside a `while` body — a loop may run zero times, so
//     the statement after it is reachable without recursing;
//   - `guard` puts the self-call on the RIGHT of `||`, which short-circuits, so
//     there is a path that never evaluates it (`&&` and `??` behave the same);
//   - `sumTo` recurses inside a `for` body, the range form of the same argument
//     (its `1 to n` range is empty at `n == 0`, which is what terminates it).
// Zero diagnostics are asserted.
function countdown(n: i32): i32 {
  while n > 0 { return countdown(n - 1) }
  return n
}
function guard(n: i32): boolean {
  return n <= 0 || guard(n - 1)
}
function sumTo(n: i32): i32 {
  let acc = 0
  for i in 1 to n { acc = acc + sumTo(n - i) }
  return acc + n
}
print(countdown(3))
print(guard(3))
print(sumTo(3))
