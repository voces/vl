// @run
// @warning dividing by `0.0` gives Infinity or NaN
// @warning dividing by `0.0` gives Infinity or NaN
// @warning dividing by `0.0` gives Infinity or NaN
// @warning dividing by `0.0` gives Infinity or NaN
// @warning dividing by `0.0` gives Infinity or NaN
// @log Infinity
// @log -Infinity
// @log NaN
// @log -Infinity
// @log NaN

// A float `/` or `%` whose divisor is a zero literal is legal and gives the IEEE result, but
// is more often a slip than a wanted value: `std:math`'s INFINITY and NAN spell the intent.
// Each spelling of a zero literal counts: `0.0`, `-0.0`, a parenthesised zero, an exponent.
function f(x: f64) {
  print(x / 0.0)
  print(x / -0.0)
  print(x % (0.0))
  print(x / (-(0.0)))
  print(x % 0e0)
}
f(1.0)
