// @run
// @log true
// @log true
// @log false
// @log true
// @log false
// The deep-record-compare warning stays quiet on a record with no list, a compare of the
// list fields by name, a null test, and a compare of two identifying fields.
type P = { x: i32, y: i32 }
type Level = { serial: i32, cells: i32[] }

const p: P = { x: 1, y: 2 }
print(p == { x: 1, y: 2 })
const a: Level = { serial: 1, cells: [1] }
const b: Level = { serial: 2, cells: [1] }
print(a.cells == b.cells)
print(a.serial == b.serial)
let cache: Level | null = null
if a.serial > 5 { cache = b }
print(cache == null)
print(cache != null)
