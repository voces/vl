// @run
// @log 1
// @log 0
// @log 0
// @hint `=== null` tests for null as `== null` does — write `==`
// @hint `!== null` tests for null as `!= null` does — write `!=`
// `x === null` is a null test, narrowed and lowered as `x == null` is; the hint names `==`.
type P = { x: i32 }

function f(p: P | null) {
  if p === null { return 0 }
  p.x
}

function g(p: P | null) {
  if p !== null { return p.x - 1 }
  0
}

print(f({ x: 1 }))
print(f(null))
print(g({ x: 1 }))
