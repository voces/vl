// @check
// @warning always recurses
// @hint redundant type annotation: `loop` is inferred as `i32`
// The headline unconditional-recursion shape: every path through `loop` calls
// `loop` again, so the call can never return. The return type is ANNOTATED on
// purpose — that is the spelling no other diagnostic sees. Without the
// annotation the checker reports "cannot infer a return type for 'loop'", and
// annotating it silences that message while leaving the infinite recursion in
// place; this rule is annotation-independent, so it survives the workaround.
// `@check` only: running the program would exhaust the stack.
function loop(n: i32): i32 {
  return loop(n + 1)
}
print(loop(1))
