// @check
// @warning Unreachable code
// @warning Unreachable code
// A statement after a call that never returns is unreachable: `__trap__` and a function
// declared `: never` end the path for the lint by the same rule as `return` (D1972).
function fail(msg: string): never {
  print(msg)
  __trap__()
}
function f(n: i32) {
  if n < 0 {
    fail("negative")
    print(n)
  }
  if n > 100 {
    __trap__("too big")
    print(n)
  }
  n
}
print(f(3))
