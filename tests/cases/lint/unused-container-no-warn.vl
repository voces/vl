// @run
// @log 2
// @log 3
// @log 1
// @log 1
// @log 0
// A container read in any way is not flagged: its length, an element, iteration, being
// passed to a function or returned, and a `push` that is this module's own function,
// which may read its receiver.
type Bag = { n: i32 }
function push(self: Bag, v: i32) { print(self.n + v) }
function total(xs: i32[]) {
  let t = 0
  for x in xs { t = t + x }
  t
}
function make() {
  const out: i32[] = []
  out.push(1)
  out
}
function main() {
  const a: i32[] = []
  a.push(1)
  a.push(2)
  print(a.length)
  const b: i32[] = []
  b.push(3)
  print(total(b))
  const m: {[string]: i32} = Map()
  m["k"] = 1
  print(m["k"] ?? 0)
  print(make()[0])
  const bag: Bag = { n: 0 }
  bag.push(0)
  0
}
main()
