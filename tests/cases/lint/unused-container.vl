// @check
// @warning Container `log` is written but never read
// @warning Container `seen` is written but never read
// @warning Container `again` is written but never read
// A list, map or set that is only ever written (pushed to, set, index-assigned, or
// reassigned) is dead state: nothing ever reads what it holds.
function main() {
  const log: string[] = []
  log.push("a")
  const seen: {[string]: i32} = Map()
  seen["k"] = 1
  seen.set("j", 2)
  let again: i32[] = []
  again = [1]
  0
}
main()
