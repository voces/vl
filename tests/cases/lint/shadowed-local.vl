// @warning `sheet` shadows the `sheet` declared at 24:9 in this function; rename one if they are different values
// @warning `k` shadows the `k` declared at 33:7 in this function
// @warning `xs` shadows the `xs` declared at 35:9 in this function
// @warning `n` shadows the `n` declared at 61:16 in this function
// @warning `c` shadows the `c` declared at 69:9 in this function
// @hint this 2-element `f64[]` is only read at fixed indexes

// D3579 (sunpa SP-021) — `shadowed-local`: a block-scoped binding that hides a binding of
// the same function. Shadowing is legal (one binding per name per scope), so this warns
// rather than refuses, on the inner binding's name.
function f() {
  const sheet = [1.0, 2.0]
  let s = 0.0
  for k in 0 until 2 { const sheet = 10.0 * k as f64; s += sheet }
  s + sheet[0]
}
print(f())

// A loop variable is a binding on both sides of the rule.
function loops() {
  let k = 0
  for k in 0 until 2 { print(k) }
  const xs = [1, 2]
  for v, xs in [3] { print(v + xs) }
  k = k + 3
  k + xs.length
}
print(loops())

// Silent: a rebinding whose initialiser reads the binding it hides, a lambda's own
// binding, a module-level name, and sibling scopes.
const total = 2
function quiet(n: i32) {
  if n > 0 {
    const n = n * 2
    print(n)
  }
  const g = (k: i32) => {
    const n = k
    n
  }
  const total = 1
  for i in 0 until 1 { print(i) }
  for i in 0 until 1 { print(i) }
  g(n) + total
}
print(quiet(2) + total)

function param(n: i32) {
  if n > 0 { const n = 4; return n }
  n
}
print(param(1))

// A chain of re-shadowings of one name is one finding, on its first link.
function chain() {
  const c = 1
  if c > 0 {
    const c = 2
    if c > 1 {
      const c = 3
      return c
    }
  }
  c
}
print(chain())
