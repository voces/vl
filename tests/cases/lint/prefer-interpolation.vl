// @run
// @log 00-01-02-03
// @log a<1>b<2>c
// @log the quick brown fox w jumps over the lazy dog w and runs w away
// @info this string is built from 7 pieces with `+`; an interpolated string reads better: `"\{hex(0)}-\{hex(1)}-\{hex(2)}-\{hex(3)}"`
// @info this string is built from 5 pieces with `+`; an interpolated string reads better: `"a<\{n(1)}>b<\{n(2)}>c"`
// @info this string is built from 7 pieces with `+`; an interpolated string `"text \{expr} more"` reads better
// A `+` chain carrying three or more string literals is suggested as one interpolated
// string. The rewrite is previewed when it is short; a long chain names the syntax.
// `+=` counts its right-hand side as the chain.
function hex(i: i32) { "0\{i}" }
function n(i: i32) { "\{i}" }
print(hex(0) + "-" + hex(1) + "-" + hex(2) + "-" + hex(3))
let s = ""
s += "a<" + n(1) + ">b<" + n(2) + ">c"
print(s)
const w = "w"
print(
  "the quick brown fox "
    + w
    + " jumps over the lazy dog "
    + w
    + " and runs "
    + w
    + " away",
)
