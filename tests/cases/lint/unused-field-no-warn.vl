// @run
// @log 3
// @log 1
// @log 2
// A field is spared when its object escapes to a function, when a `?.f` reads it, and
// when any `.f` in the module reads that name, whatever the receiver's type.
type Opt = { v: i32 }
type Wrap = { inner: i32 }
function sum(o: { a: i32, b: i32 }) { o.a + o.b }
function get<T>(w: T, f: (x: T) => i32) { f(w) }
function main() {
  const lit = { a: 1, b: 2 }
  print(sum(lit))
  const n: Opt | null = { v: 1 }
  print(n?.v ?? 0)
  const w: Wrap = { inner: 2 }
  print(get(w, (x) => x.inner))
  0
}
main()
