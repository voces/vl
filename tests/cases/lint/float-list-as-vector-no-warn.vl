// @run
// @log 6
// @log 3
// @log 7
// @log 2
// @log 4
// @log 5
// @log 7
// LINT `float-list-as-vector` stays quiet on genuine lists and on what it cannot see: a
// literal that is pushed to, iterated, indexed by a variable or measured, a callee that
// loops over its parameter, a list of integers, a five-element table, and a module-level
// constant, which is built once.

const WEIGHTS = [0.5, 1.5]

function total(xs: f64[]) {
  let s = 0.0
  for x in xs { s = s + x }
  s
}

function grows(a: f64): f64[] {
  const v = [a, a]
  v.push(a)
  v
}

function pick(a: f64, i: i32) {
  const v = [a, a + 1.0, a + 2.0]
  v[i]
}

function count(a: f64) {
  const v = [a, a]
  v.length
}

function ints(a: i32) { [a, a + 1] }

function five(a: f64): f64[] { [a, a, a, a, a] }

function written(a: f64) {
  const v = [a, a, a]
  v[0] = 4.0
  v[0] + v[1]
}

print(total([1.0, 2.0, 3.0]))
print(grows(1.0).length)
print(pick(5.0, 2))
print(count(1.0))
print(ints(1)[1] + WEIGHTS.length)
print(five(1.0).length)
print(written(3.0))
