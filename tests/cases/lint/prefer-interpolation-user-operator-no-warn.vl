// @run
// @log w|a|bb|ccc
// @log <w|a|bb|ccc>
// @log x|1|2|3
// A `+` chain carrying three string literals is not a string being built when its
// leftmost operand is an object with its own `+`: `w + "a" + "bb" + "ccc"` is a Widget,
// and `"\{w}abbccc"` would be a string with a different value. prefer-interpolation stays
// quiet on it — directly, inside an interpolation hole, and when the object comes from a
// call. The string operands inside the Widget's own `+` are two literals, under the bar.
type Widget = new { s: string }

function "+"(self: Widget, other: string): Widget {
  const r: Widget = { s: self.s + "|" + other }
  return r
}

function mk(s: string): Widget {
  const r: Widget = { s: s }
  return r
}

const w: Widget = { s: "w" }
const v = w + "a" + "bb" + "ccc"
print(v.s)
print("<\{(w + "a" + "bb" + "ccc").s}>")
print((mk("x") + "1" + "2" + "3").s)
