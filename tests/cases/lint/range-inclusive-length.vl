// @check
// @warning an inclusive `to` range up to `.length` reaches that index, one past the last element — use `until` for the half-open `[0, .length)`, or `for x in …` to iterate the elements
// The residual footgun `until` closes: an inclusive `to` whose bound is a `.length` /
// `.count` member reaches the length itself, one past the last index — reading it traps.
// The lint suggests the half-open `until`, or element iteration (`for x in xs`). Only a
// DIRECT member bound fires: a `to xs.length - 1` bound is the hand correction, and an
// `until` range is the fix, so neither is reported (see loops/until-array-index.vl).
const xs = [1, 2, 3]
let sum = 0
for i in 0 to xs.length { sum = sum + xs[i] }
print(sum)
