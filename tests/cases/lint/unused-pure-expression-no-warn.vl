// LINT `unused-pure-expression`, the QUIET side — no warning is declared, so any firing
// below fails the strict lint adjudication. Two families must stay quiet:
//
// FINAL statements, everywhere: VL is expression-oriented and a block's tail IS its
// value — a function tail, a statement-if's arm tails, a loop body's last statement,
// a single-expression lambda body. Only a statement with another statement AFTER it in
// the same list has its value discarded for sure.
//
// ANYTHING containing a call or an index, even mid-block: a call has effects and an
// index read can trap, so these stay quiet, as do assignments (`=`, `++`) and the
// `is`/`as` forms the whitelist never admits. An OPERATOR fires only when every operand
// is a literal or a read of a plain scalar (`unused-pure-expression-scalar-operands.vl`):
// an object operand could dispatch to a user overload (`function +(self, b) { … }`), a
// getter read runs the getter, and a type parameter could be bound to either.
// @run
// @log side effect
// @log side effect
// @log side effect
// @log 12
// @log overload ran
// @log 12
// @log 18
// @log 2
// @log made
// @log made
// @log 3

let hits = 0
function bump() {
  hits = hits + 1
  print("side effect")
  hits
}

function quiet(n: i32) {
  // Non-final but IMPURE (or outside the whitelist) — all quiet.
  bump()        // a call
  const lst = [n, n + 1]
  lst.length    // a member access
  lst[0]        // an index
  n is i32      // `is` — not whitelisted
  n as! f64     // `as` — not whitelisted
  bump() + 1    // a binary with a call operand
  [bump(), 2]   // an array literal with a call element
  [n * 2]       // an array element that is an identifier-operand operator
  let acc = n
  acc = acc + 1 // an assignment
  acc++         // desugars to an assignment
  // FINAL-statement tails — pure, but each is its block's value.
  if acc > 0 { 1 } else { 2 }
  let i = 0
  while i < 2 {
    i = i + 1
    i // the loop body's tail
  }
  return acc
}
print(quiet(10))

// An object operand: `+` dispatches to the overload, which prints.
type V = { a: i32 }
function +(self: V, o: V): V {
  print("overload ran")
  { a: self.a + o.a }
}
function overloaded(v: V) {
  v + v
  v.a
}
print(overloaded({ a: 1 }) + 11)

// A getter read runs the getter; a type parameter could be bound to `V` above.
type Color = new i32
get r(self: Color): i32 { ((self as! i32) >> 16) & 255 }
function viaGetter(c: Color) {
  c.r + 1
  c.r
}
print(viaGetter(0x123456 as! Color))
function generic<T>(x: T): T {
  x == x
  x
}
print(generic(2))

// A field read whose receiver is a call or an index runs that call, or can trap; an integer
// `/` or `%` by a read traps on zero. `-made().x` opens its block, so no line sits above it.
type P = { x: i32 }
function made(): P {
  print("made")
  { x: 1 }
}
function receivers(xs: P[], i: i32, b: i32) {
  -made().x
  made().x + 1
  xs[i].x + 1
  i / b
  i % b
  xs.length
}
print(receivers([{ x: 1 }, { x: 2 }], 0, 1) + 1)
