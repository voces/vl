// LINT `unused-pure-expression`, the QUIET side — no warning is declared, so any firing
// below fails the strict lint adjudication. Two families must stay quiet:
//
// FINAL statements, everywhere: VL is expression-oriented and a block's tail IS its
// value — a function tail, a statement-if's arm tails, a loop body's last statement,
// a single-expression lambda body. Only a statement with another statement AFTER it in
// the same list has its value discarded for sure.
//
// ANYTHING containing a call, member access, or index, even mid-block: a call has
// effects, a member or index read can trap — full purity semantics are out of the
// rule's v1 scope, so these all stay quiet, as do assignments (`=`, `++`) and the
// `is`/`as` forms the whitelist never admits. And any OPERATOR over identifier
// operands: VL has operator overloading (`function +(self, b) { … }`), so `n + 1`
// could dispatch to an arbitrary user function with effects, and the syntactic lint
// tier cannot resolve the dispatch — only all-literal-leaved operator trees are
// called pure.
// @run
// @log side effect
// @log side effect
// @log side effect
// @log 12

let hits = 0
function bump() {
  hits = hits + 1
  print("side effect")
  hits
}

function quiet(n: i32) {
  // Non-final but IMPURE (or outside the whitelist) — all quiet.
  bump()          // a call
  const lst = [n, n + 1]
  lst.length      // a member access
  lst[0]          // an index
  n is i32        // `is` — not whitelisted
  n as! f64        // `as` — not whitelisted
  bump() + 1      // a binary with a call operand
  [bump(), 2]     // an array literal with a call element
  n + 1           // an operator over an IDENTIFIER — `+` could be a user overload
  -n              // unary over an identifier — same bound, uniformly
  [n * 2]         // an array element that is an identifier-operand operator
  let acc = n
  acc = acc + 1   // an assignment
  acc++           // desugars to an assignment
  // FINAL-statement tails — pure, but each is its block's value.
  if acc > 0 {
    1
  } else {
    2
  }
  let i = 0
  while i < 2 {
    i = i + 1
    i             // the loop body's tail
  }
  return acc
}
print(quiet(10))
