// @run
// @log 3
// @log 7
// @warning this line is a separate statement; its value is discarded. If it continues the expression above, wrap it in parentheses or put the operator at the end of the previous line
// @warning This expression has no effect: it is not the final statement of its block, so its value is discarded
// @hint redundant type annotation
// LINT `unused-pure-expression` over SCALAR operands (D3673, sunpa SP-040). An operator tree
// whose leaves are literals or reads of a plain number, boolean or string cannot dispatch to
// an overload, so discarding it does nothing. The quiet near misses are in
// `unused-pure-expression-no-warn.vl`.

// FIRES with the line-break message: sunpa's camera. A leading `-` starts a new statement, so
// `w` is `a * 3.0` and the second line is computed and thrown away. Prints 3, not -0.5. (As
// written the line was indented under `const w`; `vl fmt` moves it out to its own statement.)
function f(a: f64, b: f64): f64 {
  const w = a * 3.0
  -b * 3.5
  w
}
print("\{f(1.0, 1.0)}")

// FIRES seven times: names the editor can see are scalars (a parameter, a literal `const`),
// and reads only the check can type (a local initialised by a call, record fields). The
// leading `-` after `k == 3` is the line-break message again; the call line stays quiet.
type Cam = { x: f64, y: f64 }
const LIMIT = 4
function mk(): f64 { 2.0 }
function g(c: Cam, k: i32, s: string): i32 {
  const t = mk()
  t * 2.0
  c.x - c.y
  k == 3
  -k
  !(k > LIMIT)
  ~k
  s == "a"
  mk() + 1.0
  k + LIMIT
}
print(g({ x: 1.0, y: 2.0 }, 3, "a"))
