// @run
// @log 283380
// @log 524287
// @log 65535
// @log 15
// @log 1
// @log 4194300
// @log 7
// @log 524287
// @log 7
// @hint masking `h >> 13` to its low 19 bits is the logical shift `h >>> 13`
// @hint masking `x >> 16` to its low 16 bits is the logical shift `x >>> 16`
// @hint masking `w >> 28` to its low 4 bits is the logical shift `w >>> 28`
// @hint masking `b >> 63` to its low bit is the logical shift `b >>> 63`
// @hint masking `(a * 3) >> 10` to its low 22 bits is the logical shift `(a * 3) >>> 10`
// LINT `shift-mask-is-logical-shift`: `(x >> k) & mask`, where the mask keeps exactly the low
// `w - k` bits of a `w`-bit `x`, is `x >>> k`. Five fire below; the controls do not: a mask
// one bit short, an `i64` shifted under an `i32`-sized mask, and an operand whose width a
// bare literal binding leaves open.

function hash(a: i32, b: i32) {
  let h = a * 374761393 + b * 668265263
  h = (h ^ ((h >> 13) & 0x7ffff)) * 1274126177
  h
}
print((hash(-1, 0) >> 13) & 0x7ffff)
print(-1 >>> 13)

// FIRES: either operand order, decimal or hex.
function hi16(x: i32) { 0xffff & (x >> 16) }
print(hi16(-1))

// FIRES: a parameter; an annotated `i64` with its own 64-bit mask.
function top4(w: i32) { (w >> 28) & 15 }
print(top4(-16))
const b: i64 = -1
print((b >> 63) & 1)

// FIRES: the operand is an expression whose width its names fix.
function scaled(a: i32) { ((a * 3) >> 10) & 0x3fffff }
print(scaled(-1365))

// Quiet: one bit short of the mask, which is not `>>>`.
function top3(w: i32) { (w >> 28) & 7 }
print(top3(-16))
// Quiet: an `i64` under the `i32` mask keeps different bits.
print((b >> 13) & 0x7ffff)
// Quiet: a bare-literal binding can still be retyped by its uses.
const k = 1000
print((k >> 7) & 0x1ffffff)
