// @run
// @log 120
// @log 8
// Ordinary recursion must stay silent — the false-positive floor for the
// unconditional-recursion rule. A base case is a path that reaches a function
// exit WITHOUT recursing, which is exactly what the rule looks for:
//   - `fact` guards with an `if` that has no `else`, so the condition being
//     false is itself a clean fall-through past the guard;
//   - `fib` splits `if`/`else` and one arm returns without recursing.
// No function here can be flagged, so the harness asserts zero diagnostics.
function fact(n: i32): i32 {
  if n <= 1 { return 1 }
  return n * fact(n - 1)
}
function fib(n: i32): i32 {
  if n < 2 { return n } else { return fib(n - 1) + fib(n - 2) }
}
print(fact(5))
print(fib(6))
