// @run
// @log 3
// @log 3
// @log 1
// @log 5
// @info `q` is never reassigned; use `const` instead of `let`
// @hint redundant type annotation: `v` is inferred as `D[]`
// A `let` holding only list literals, returned by an inferred function, is copied where the call
// is delivered as a list of a wider record, as a literal `const` is (D15894).
type D = { v: i64 }
let q = [{ v: 3 }]
function g() { return q }
const v: D[] = g()
print(v[0].v)
let r = [{ v: 1 }]
r = [{ v: 3 }]
function h() { r }
const w: D[] = h()
print(w[0].v)
w.push({ v: 9 })
print(r.length)
const o = h()
print(o[0].v + w.length)
