// @run
// @log 1
// @log 2
// @log 2
// @log 3
// @log 2
// @log 2
// @log 2

// D2461: a function value a callee runs is charged at its own argument, so a read-only callback
// keeps a narrowing; a cell write, a pop or a set on a container whose element type cannot be the
// narrowed one's keeps it; and a method a record declares is its own function, not a built-in.
import { reverse } from "std:array"

type O = { v: i32 | string, w: i32 | string }
type Bag = { items: i32[] }
function each(xs: i32[], f: (i32) => void) {
  for x in xs { f(x) }
}
function call1(x: O, f: (O) => void) { f(x) }
function other(x: O) { x.w = "s" }
function fill(out: f64[]) { out[0] = 2.0 }
function clear(self: Bag, x: i32) { print(self.items.length + x) }

function main(
  o: O,
  xs: (i32 | string)[],
  ys: f64[],
  seen: {[string]: boolean},
  b: Bag,
) {
  if o.v is i32 {
    each([1], (x: i32): void => {
      print(x)
    })
    call1(o, other)
    print(o.v + 1)
  }
  if xs[0] is i32 {
    const r = xs.reverse()
    print(xs[0] + 1)
    print(r.length + 1)
    fill(ys)
    ys.pop()
    seen.set("k", true)
    print(xs[0] + 1)
    b.clear(2)
    print(xs[0] + 1)
  }
}
main({ v: 1, w: 1 }, [1, "a"], [1.0], Map(), { items: [] })
