// @check
// @error-at 20:17 cannot assign string[] to 't' of type S[]
// @error-at 24:18 cannot assign string[] to 't2' of type S[]
// @error-at 29:17 cannot assign string to 'y' of type S
// @error-at 34:17 cannot assign string to 'y' of type S
// @error-at 39:17 cannot assign string to 'y' of type S
// @error-at 43:6 cannot assign () => string[] to () => S[]
// @error-at 47:19 cannot assign string[][] to 'k' of type S[][]
// @error-at 53:20 cannot assign string[][] to 'k2' of type S[][]
// @error-at 59:20 cannot assign string[][] to 'k3' of type S[][]
// D4946 VERDICT PIN (must-error): a `map`/`filter` callback or a `for` body that may write an
// element of the narrowed list out of its leaf, or call what may, does not see its parameter or
// variable narrowed; nor does a callback that may run after the guard. Line and column are 0-based.
type S = "a" | "b"
const s = ["a", "b"]
const m = [["a"], ["b", "a"]]
function poke() { s[1] = "zz" }
function pokeRow() { m[1][1] = "zz" }
let g = (): S[] => []
if (s is S[]) {
  const t: S[] = s.map((x) => {
    s[1] = "zz"
    x
  })
  const t2: S[] = s.map((x) => {
    poke()
    x
  })
  for x in s {
    const y: S = x
    s[1] = "zz"
    print(y)
  }
  for x in s {
    const y: S = x
    poke()
    print(y)
  }
  for x in s {
    const y: S = x
    s.push("q")
    print(y)
  }
  g = () => s.map((x) => x)
  print(t.length + t2.length)
}
if (m is S[][]) {
  const k: S[][] = m.map(
    (r) => r.map((x) => {
      m[1][1] = "zz"
      x
    }),
  )
  const k2: S[][] = m.map(
    (r) => r.map((x) => {
      pokeRow()
      x
    }),
  )
  const k3: S[][] = m.map(
    (r) => r.filter((x) => {
      r[0] = "zz"
      x == "a"
    }),
  )
  print(k.length + k2.length + k3.length)
}
