// @check
// @error-at 15:28 'm["k"]' was narrowed by a guard, but the call on line 16 can write it — re-test 'm["k"]' after the call
// @error-at 27:28 'p["k"]' was narrowed by a guard, but the call on line 28 can write it — re-test 'p["k"]' after the call

// D15148: a call through a map slot is charged every function ever stored in the map, so one
// that writes the slot, itself or through another function, still ends the narrowing.
// Line and column are 0-based.

// The stored function writes the slot.
const m: {[string]: ((a: i32) => i32) | null} = Map()
m["k"] = (a: i32) => {
  m["k"] = null
  a + 1
}
if m["k"] != null {
  if m["k"](4) == 5 { print(m["k"](4)) }
}

// Another stored function deletes it.
const p = Map()
function clear() { p.delete("k") }
p["k"] = (a: i32) => a + 1
p["j"] = (a: i32) => {
  clear()
  a
}
if p["k"] != null {
  if p["k"](4) == 5 { print(p["k"](4)) }
}
