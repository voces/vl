// @check
// @error 'r' is no longer narrowed to B: the call to 'f' on line 14 may reassign it
// VERDICT PIN (must-error, D4083): `r is B` narrows the record's field `k` to `K`, a fact
// about heap state. A call whose closure stores into `r.k` retires it, so `r.k` reads at
// its declared `i32`. This program checked clean and printed 5.
type K = 0 | 1
type A = { k: i32 }
type B = { k: K }
const r: A = { k: 0 }
const f = () => {
  r.k = 5
}
if (r is B) {
  f()
  const e: K = r.k
  print(e)
}
