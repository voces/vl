// @run
// A CALL ARGUMENT takes its nullability expectation from the PARAMETER, never from the
// enclosing position — `silent-class-inventory` D31.
//
// `emitDirectCall` builds each argument's context with `expCtxHere()`, which SNAPSHOTS the
// ambient `pending*` seeds. At a `return f(x)` those seeds are the RETURN boundary's, and
// the four nullable seeds were only ever set TO TRUE — never cleared — so a `string | null`
// RESULT expectation reached the ARGUMENT sub-expression of a call whose parameter is a
// plain `string`. The narrowed value then kept its `(ref null $s)` rep under a `(ref $s)`
// param: `vl check` rc 0, no diagnostic at any severity, and the engine refusing the module
// at load with `type mismatch: expected (ref $type), found (ref null $type)`.
//
// NO GENERICS ANYWHERE, which is what separates it from the monomorphizer's pin (D25): the
// callee is an ordinary function and the two boundaries in question are its parameter and
// the CALLER's return. It was found by D25's grid — closing the pin routed
// `generics/mono-nullable-arg-pin.vl`'s own `narrowed` control onto it — and it reproduces
// on the parent commit with the four lines of `tailNulRet` below and nothing else.
//
// EVERY RETURN ANNOTATION HERE IS DECLARED, redundancy hint and all: dropping the
// callees' `: string` / `: boolean` / `: i32` makes their return kind INFERRED, which is a
// different program — measured, it lands on a different invalid-wasm cell
// (`expected (ref $type), found i32`) that has nothing to do with this row.
// @hint redundant type annotation: `takeS` is inferred as `string`
// @hint redundant type annotation: `takeB` is inferred as `boolean`
// @hint redundant type annotation: `takeL` is inferred as `i32`
// @hint redundant type annotation: `takeNulS` is inferred as `i32`
//
// THE ONE-BIT DIFF IS THE WITNESS. `tailNulRet` and `tailConcreteRet` differ only in the
// enclosing return annotation; disassembled, the second carries the `ref.as_non_null` the
// first is missing, on the same argument of the same call to the same function.
function takeS(x: string): string { return x }

function takeB(b: boolean): boolean { return b }

function takeL(xs: i32[]): i32 { return xs[0] }

// THE FILED SHAPE: the enclosing return is nullable, the parameter is not.
function tailNulRet(x: string | null): string | null {
  if x != null { return takeS(x) }
  return null
}

// The CONTROL that always ran — the same call, a concrete enclosing return. The `: string`
// IS the axis under test, so its redundancy hint is declared rather than removed.
// @hint redundant type annotation: `tailConcreteRet` is inferred as `string`
function tailConcreteRet(x: string | null): string {
  if x != null { return takeS(x) }
  return "zz"
}

// The two other seeded reps, in the same shape.
function tailNulBool(b: boolean | null): boolean | null {
  if b != null { return takeB(b) }
  return null
}

function tailNulList(xs: i32[] | null): i32[] | null {
  if xs != null {
    if takeL(xs) == 5 { return xs }
    return null
  }
  return null
}

// The seed must still REACH a genuinely nullable parameter: this is the half the
// assignment keeps, and a `null` argument is the cell that proves the slot is nullable.
function takeNulS(s: string | null): i32 {
  if s != null { return s.length }
  return -1
}

function passNulThrough(s: string | null): string | null {
  if takeNulS(s) >= 0 { return s }
  return null
}

const a = tailNulRet("aa")
// @log aa
if a != null { print(a) } else { print("null") }
// @log null
const b = tailNulRet(null)
if b != null { print(b) } else { print("null") }
// @log aa
print(tailConcreteRet("aa"))
// @log zz
print(tailConcreteRet(null))
// @log true
const c = tailNulBool(true)
if c != null { print(c) } else { print("null") }
// @log null
const d = tailNulBool(null)
if d != null { print(d) } else { print("null") }
// @log 1
const e = tailNulList([5])
if e != null { print(e.length) } else { print("null") }
// @log null
const f = tailNulList([1])
if f != null { print(f.length) } else { print("null") }
// @log 5
print(takeNulS("hello"))
// @log -1
print(takeNulS(null))
// @log hello
const g = passNulThrough("hello")
if g != null { print(g) } else { print("null") }
// @log null
const h = passNulThrough(null)
if h != null { print(h) } else { print("null") }
