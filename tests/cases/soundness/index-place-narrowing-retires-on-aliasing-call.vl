// @check
// @error 'xs[0]' was narrowed by a guard, but the call to 'clr' on line 27 can write it — re-test 'xs[0]' after the call
// @hint redundant type annotation: `xs` is inferred as `(i32[] | null)[]`
// SOUNDNESS (must-error). An ALIASING CALL that receives the array retires every narrowed
// CELL of it — the third of the three retirement rules inventory-2 D11's candidate broke,
// and the only one with no local spelling: the guarded block never mentions the write.
//
// THIS FILE REPLACES A REFUTATION PIN. Until #2003 it stood as
// `index-place-is-not-narrowable-refusal-pin.vl`, asserting the DECLARED-type message that
// an unnarrowable index place produces, and saying what would have to land before the
// refusal could come off. All of it landed; what the file pins now is the retirement.
//
// THE RULE IS DELIBERATELY BLUNT HERE, and the bluntness is the finding. Everywhere else
// `callInvalidatesReal` refines by write effect — a callee that only READS keeps every
// narrowing, which is what makes the rule usable. It cannot refine an index cell, because
// `fnWriteEffects`' summaries are `,`-terminated FIELD sub-paths and `placeSubPath` answers
// "" for `ys[0] = …`: consulting them would read "writes nothing" for the exact callee that
// nulls the cell. So any call receiving the array retires the cell, matching the `key == ak`
// leg that already refuses to refine a write to the argument place itself. An index
// vocabulary for the summaries is inventory-2 D452.
function src(): i32[] | null { return [1, 2] }
function clr(ys: (i32[] | null)[]) { ys[0] = null }

function aliasingCall() {
  const xs: (i32[] | null)[] = [src()]
  if xs[0] != null {
    clr(xs)
    print(xs[0].length)
  } else { print("NUL") }
}
aliasingCall()
