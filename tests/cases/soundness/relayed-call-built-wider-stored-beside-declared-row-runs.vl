// @run
// @log 4
// @log 5
// @log 6
// @log 4
// @log 5
// @log 6
// @log 4
// @log 5
// @log 4
// D14512: a call built at a wider record, relayed through a generic identity, a hole identity or
// a returned binding, is built there in every container it is stored into, beside a declared row
// of its own shape.
type II = { f: i32 }
type J = { f: i32 | null }
function mk() { { f: 4 } }
function id<T>(x: T): T { x }
function h(x) { x }
function r() {
  const k = mk()
  return k
}
const d: J = mk()
const xs = [id(mk())]
const e = xs[0]
print(e.f)
const ys = [h(mk())]
print(ys[0].f + 1)
const zs = [r()]
const z = zs[0]
print(z.f + 2)
const m = Map()
m.set("a", id(mk()))
m.set("b", h(mk()))
m.set("c", r())
const a = m.get("a")
if a != null { print(a.f) }
const b = m.get("b")
if b != null { print(b.f + 1) }
const c = m.get("c")
if c != null { print(c.f + 2) }
const w = { g: h(mk()) }
print(w.g.f)
const hv = h(mk())
const hw = hv
print(hw.f + 1)
print(d.f ?? 0)
