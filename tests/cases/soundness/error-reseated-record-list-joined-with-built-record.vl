// @check
// @error {f: i32} is not I (reached through {f: i32}[] into I[]): they store field `f` differently
// D2925: a list of literals adopts the `I[]` it is delivered to, and an `if` joining it with a
// list of the existing `{ f: i32 }` record would widen that record in place; it is refused, as
// the annotated `const il: I[] = [{ f: 7 }]` is (DECISIONS.md "Record covariance").
const i: { f: i32 } = { f: 4 }
type I = { f: i64 | null }
const il = [{ f: 7 }]
const ic: I[] = il
const j = if ic.length > 0 { il } else { [i] }
print(j[0].f)
print(i.f)
