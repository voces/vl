// @emit-error this record was built as another record type than the `I` a declared destination
// @hint redundant type annotation: `i` is inferred as `{f: i32}`
// D2925: an `if` joining a re-seated list with a list of an already-built record of the
// literal's own type would deliver two element storages into one join, so that record is refused.
const i: { f: i32 } = { f: 4 }
type I = { f: i64 | null }
const il = [{ f: 7 }]
const ic: I[] = il
const j = if ic.length > 0 { il } else { [i] }
print(j[0].f)
print(i.f)
