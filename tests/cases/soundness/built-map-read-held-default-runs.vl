// @run
// @log 9
// @log 5
// @log 5
// @log 4
// A read of a container whose values are built wider, defaulted with `??` to a `const` holding a
// record literal, builds that binding at the container's record: the default is the binding
// itself, so a write through the result is a write to it (D15217).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const m = Map()
m.set("a", mk())
const wm: {[string]: J} = Map()
wm.set("a", mk())
const d = { f: 1 }
const b = m.get("z") ?? d
b.f = 9
print(d.f)
const d2 = { f: 1 }
const b2 = m.get("a") ?? d2
print(b2.f + d2.f)
const d3 = { f: 1 }
function rd() { d3.f }
const b3 = m.get("a") ?? d3
print(b3.f + rd())
function g() {
  const d4 = { f: 1 }
  const b4 = m.get("a") ?? d4
  b4.f
}
print(g())
