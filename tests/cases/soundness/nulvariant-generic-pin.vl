// @run
// @log 7
// @log 7
// @log 7
// @log 6
// @log 8
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// THE MONOMORPHIZER'S ARGUMENT PIN, over the VARIANT reps — `silent-class-inventory` D23.
//
// A pin BECOMES the instance's parameter annotation, so it has to name the argument's TYPE.
// `monoAnnPinName` claimed a struct (`isSName`), a union (`isUName`), the composite-list and
// scalar spellings and the nullable forms of all of those — and NOT a declared union ARM.
// `Circle` has no struct row by construction (that is the very gate `nulVariantIndexOf`
// applies), so the argument fell past every arm to the cascade's `"i32"` catch-all: the
// instance declared an i32 parameter over a `(ref $type)` value, `vl check` rc 0 and
// `type mismatch: expected i32, found (ref $type)` at load.
//
// ONE ARM COVERS BOTH HALVES. `monoNulAnnName` delegates its non-null base to the same
// ladder precisely so there is one membership list, so teaching it `Circle` teaches it
// `Circle | null` at the same time — and the niche's cell, a `(ref null $uVarHeap[vi])`, is
// one an annotated `c: Circle | null` parameter already lowers end to end.
//
// THE CATCH-ALL IS THE DEFECT, NOT THE MISSING ARM, which is why the ladder also grew
// FLOORS: a cascade answering `i32` for a rep it does not recognise mints a wrong instance
// silently, while one answering `""` gets an honest emit refusal. The refusals live in
// `tests/cases/soundness/error-generic-unpinnable-rep.vl`.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq

function dstGen<T>(_x: T, k: i32) {
  return k
}

function mkc(): Circle | null {
  return { r: 5 }
}

// The NON-NULL variant. Not in D23's filing at all — the grid found it, and it is the arm
// the nullable half is derived from.
function variantArg(v: Circle) {
  return dstGen(v, 7)
}

// The niche, through both narrowing constructs. The pin comes from the PARAMETER's
// annotation, which is the channel that goes blind mid-mono for everything else
// (`buildLocals` has not run, so no `expr*` classifier can see a local).
function nicheParamIs(c: Circle | null) {
  if c is Circle { return dstGen(c, 7) }
  return -1
}

function nicheLocalNeNull() {
  const c: Circle | null = { r: 5 }
  if c != null { return dstGen(c, 7) }
  return -1
}

// The generic NON-ARRAY parameter — `std:array`'s `reduce` has the only one in std, and its
// `init: A` binds the ACCUMULATOR's union type from the callback. So the niche argument meets
// a UNION parameter inside the instance, which is D24's boundary reached through D23's pin:
// the two had to close together for this cell to run.
function bump(acc: Shape, x: i32): Shape {
  if acc is Circle { return { r: acc.r + x } }
  return acc
}

function localReduce<A>(f: (A, i32) => A, init: A): A {
  return f(init, 1)
}

function genericInit(c: Circle | null) {
  if c is Circle {
    const out = localReduce(bump, c)
    if out is Circle { return out.r }
    return -2
  }
  return -1
}

print(variantArg({ r: 5 }))
print(nicheParamIs(mkc()))
print(nicheLocalNeNull())
print(genericInit(mkc()))
print(genericInit({ r: 7 }))
