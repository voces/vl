// @run
// @log 1
// @log false
// @log 6
// @log 6
// @log 6
// @log 6
// @hint Intentionally-unused parameter `_x`
// @hint Intentionally-unused parameter `_a`
// @hint Intentionally-unused parameter `_b`
// @warning is always false here
// D15180: a bound record whose function's result one delivery builds wider is handed to a generic
// that nothing else pins at its own type, or delivered at the wider type inside a literal: the
// instance is built at the wider record, so it runs.
type Circle = { r: i32 | null }
type K = { r: null }
function sink(_x: Circle) {}
function mkcall() { { r: null } }
const c = mkcall()
sink(c)
const k: K = { r: null }
function one<T>(_a: T) { 1 }
function id<T>(a: T): T { a }
function viaField<T>(a: T, _b: { f: T }): T { a }
function listViaField<T>(a: T[], _b: { f: T }): T { a[0] }
const xs: Circle[] = [c]
const w: { f: Circle } = { f: c }
print(one(c))
print(id(c) == null)
print(viaField(c, { f: k }).r ?? 6)
print(listViaField([c], { f: k }).r ?? 6)
print(xs[0].r ?? 6)
print(w.f.r ?? 6)
