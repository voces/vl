// @run
// @log 1.25
// @log 1.25
// @log 3.25
// @log 2
// A list literal made only of a spread of a fresh list `const`, delivered where a wider record
// list is declared, builds the `const`'s literal at that record (D16443). One list per position:
// an annotated binding (and a read of the spread list itself), and a parameter.
const s1 = [{ x: 1 }]
const t1: { x: f64 }[] = [...s1]
print(t1[0].x + 0.25)
print(s1[0].x + 0.25)
function f(v: { x: f64 }[]) {
  print(v[0].x + 0.25)
  print(v.length)
}
const s2 = [{ x: 3 }, { x: 4 }]
f([...s2])
