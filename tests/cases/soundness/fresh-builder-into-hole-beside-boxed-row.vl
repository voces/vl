// @run
// @log 5
// @log 7
// D8684: a call to a builder whose body ends in a record literal, handed to an un-annotated
// parameter that reads the field, keeps the literal's own storage beside a declared record
// that boxes the field; bare and returned.
type J = { f: i32 | null }
function mk() { { f: 4 } }
function mk2() { return { f: 6 } }
function rd(r) { return r.f + 1 }
print(rd(mk()))
print(rd(mk2()))
