// @run
// @log 5
// @log 5
// @log 2

// D15322: a call through a record field runs one of the functions ever stored there, so a
// narrowing of that field, or of a sibling, survives when none of them can write it.

type R = { f: ((a: i32) => i32) | null, g: string | null }
const r: R = { f: (a: i32) => a + 1, g: "ab" }
if r.f != null {
  if r.f(4) == 5 { print(r.f(4)) }
}
if r.g != null {
  if r.f != null { print(r.f(4)) }
  print(r.g.length)
}
