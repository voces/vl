// @check
// @error I is not J: they store field `f` differently (`i32` into `i32 | null`)
// @error I is not J: they store field `f` differently
// @error I is not J: they store field `f` differently
// @error I is not J: they store field `f` differently
// @error {h: I} is not H: they store field `h` differently (`I` into `J`)
// @error I is not J (reached through I[] into J[]): they store field `f` differently
// @error I is not J: they store field `f` differently
// @error D2 is not D: they store field `v` differently (`i32` into `f64`)
// @hint redundant type annotation: `i` is inferred as `I`
// @hint redundant type annotation: `hs` is inferred as `{h: I}`
// @hint redundant type annotation: `dd` is inferred as `D2`
// An existing record, one a binding, call result or field already holds, is shared rather than
// copied, so it is refused wherever it is delivered as a record that stores a field differently:
// a write through the wider handle would break the narrower one (D2996, DECISIONS.md "Record
// covariance: only a fresh value widens"). Each message names both fixes.
type I = { f: i32 }
type J = { f: i32 | null }
type H = { h: J }
type D = { v: f64 }
type D2 = { v: i32 }
function take(j: J) { print(j.f ?? 0) }
const i: I = { f: 4 }
const b: J = i
take(i)
function ret(): J { return i }
let a: J = { f: 1 }
a = i
const hs: {h: I} = { h: i }
const hh: H = hs
const xs: J[] = [i]
const ys: J[] = []
ys.push(i)
const dd: D2 = { v: 3 }
const d: D = dd
print(b.f ?? 0)
print(ret().f ?? 0)
print(a.f ?? 0)
print(hh.h.f ?? 0)
print(xs.length + ys.length)
print(d.v)
