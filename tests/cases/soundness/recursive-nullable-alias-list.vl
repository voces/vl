// @run
// @log 3
// @log 7
// @log 2
// @log 5
// @log 2
// @log 2
// @log 3
// A recursive record whose list field holds its own nullable: through a `| null` alias, a `| null`
// list, a push, a list of lists and a generic alias, and the generic record spelling. The element
// record has no name a render can give, so its row is found by its type.
type T = { v: i32, kids: T[] } | null
function sum(t: T) {
  if t == null { return 0 }
  let s = t.v
  for k in t.kids { s = s + sum(k) }
  return s
}
print(sum({ v: 1, kids: [{ v: 2, kids: [] }, null] }))

type NT = { v: i32, kids: NT[] | null } | null
function nsum(t: NT) {
  if t == null { return 0 }
  let s = t.v
  const ks = t.kids
  if ks != null {
    for k in ks { s = s + nsum(k) }
  }
  return s
}
print(nsum({ v: 1, kids: [{ v: 2, kids: null }, null, { v: 4, kids: [] }] }))

const root: T = { v: 1, kids: [] }
if root != null {
  root.kids.push({ v: 5, kids: [] })
  root.kids.push(null)
  print(root.kids.length)
  const k0 = root.kids[0]
  if k0 != null { print(k0.v) }
}

type G = { v: i32, rows: G[][] } | null
const g: G = { v: 1, rows: [[{ v: 2, rows: [] }, null]] }
if g != null {
  const c = g.rows[0][0]
  if c != null { print(c.v) }
}

type Tree<A> = { v: A, kids: Tree<A>[] } | null
function count<A>(t: Tree<A>) {
  if t == null { return 0 }
  let n = 1
  for k in t.kids { n = n + count(k) }
  return n
}
const tr: Tree<string> = { v: "a", kids: [{ v: "b", kids: [] }, null] }
print(count(tr))

type R<A> = { v: A, kids: (R<A> | null)[] }
function rsum(t: R<i32> | null) {
  if t == null { return 0 }
  let s = t.v
  for k in t.kids { s = s + rsum(k) }
  return s
}
print(rsum({ v: 1, kids: [{ v: 2, kids: [] }, null] }))
