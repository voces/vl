// @check
// @error 'v' is no longer narrowed to K[]: the call to 'f' on line 13 may reassign it
// VERDICT PIN (must-error, D4926): `v is K[]` narrows every element of `v`, and that is a
// fact about heap state. A call whose closure stores into an element falsifies it, so the
// read after the call is at the declared element type and `const e: K` is refused. This
// program checked clean and printed 5.
type K = 0 | 1
const v: i32[] = [0, 1]
const f = () => {
  v[0] = 5
}
if (v is K[]) {
  f()
  const e: K = v[0]
  print(e)
}
