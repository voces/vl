// @log 0
// @log 1
// @log 0
// @log 0
// @log 0
// @log 1
// @log 1
// A list `is` test over a nullable or union operand answers by the element an annotation fixed,
// as a bare `V[]` does: an empty `i32[]` does not pass `is f64[]` (DECISIONS "An annotation fixes
// an empty list's element type"). An open list at another parameter leaves that answer alone, and
// a non-empty list beside an open one answers false under either rule (D16689).
function opt<V>(v: V[] | null) { return v is f64[] }
function box<V>(v: V[] | string) {
  if v is f64[] { return 1 }
  return 0
}
function side<V>(a: V[], b: i32[]) {
  if a is f64[] { return 1 + b.length }
  return 0
}
function g<V>(v: V[]) {
  if v is f64[] { return 1 }
  return 0
}
const e: i32[] = []
const f: f64[] = []
print(opt(e))
print(opt(f))
print(opt(null))
print(box(e))
print(box([2.5]))
print(box("s"))
print(side(e, []))
print(g([2]))
print(g([]))
print(g([]))
