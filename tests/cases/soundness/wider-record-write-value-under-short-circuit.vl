// A record wider than a name's own, written into the name in the right operand of `&&` or `||`,
// is the value: the call runs once, only when the left side lets it, and the name holds its
// record. Through a `while` condition and a field read of the value too (D16105).
type A = { x: i32 }
type B = { x: i32, y: i32 }
function yOf(q: B) { return q.y }
let k = 0
function nb(): B { k = k + 1; return { x: k, y: k * 10 } }
let a: A = { x: 0 }
print(k < 5 && yOf(a = nb()) > 0)
print(a.x)
print(k)
print(k > 5 || yOf(a = nb()) == 20)
print(a.x)
print(k > 5 && yOf(a = nb()) > 0)
print(a.x)
print(k)
let n = 0
while n < 2 && yOf(a = nb()) < 100 { n = n + 1 }
print(a.x)
function local() {
  let b: A | null = null
  return k < 9 && (b = nb()).y == 50
}
print(local())
print(a.x)
