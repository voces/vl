// @run
// @log 7
// @log 1
// @log 10
// @hint Intentionally-unused parameter `_b`
// @hint Intentionally-unused parameter `_a`
// D14817: a fresh call result delivered at its own type to an instance a held argument pins, while
// another delivery builds the call's record wider, is built wide and copied where it lands; a
// write through the wide landing reaches no record a narrow landing holds.
type Circle = { r: i32 | null }
type K = { r: null }
function sink(c: Circle) {
  c.r = 7
  print(c.r ?? 0)
}
function mkcall() { { r: null } }
sink(mkcall())
function both<T>(_a: T, _b: T) { 1 }
function first<T>(a: T, _b: T): T { a }
const k: K = { r: null }
print(both(mkcall(), k))
print(first(mkcall(), k).r ?? 10)
