// @run
// @log 6
// @log 6
// @log 6
// @log 6
// @hint Intentionally-unused parameter `_x`
// @hint Intentionally-unused parameter `_a`
// @hint Intentionally-unused parameter `_b`
// A generic whose type parameter a wider-built argument and a held binding inside a literal
// bind apart runs where its body reads only one of the two (D15129's controls).
type Circle = { r: i32 | null }
type K = { r: null }
function sink(_x: Circle) {}
function mkcall() { { r: null } }
const c = mkcall()
sink(c)
const k: K = { r: null }
function ignore<T>(a: T, _b: { f: T }): T { a }
function onlyB<T>(_a: T, b: { f: T }): T { b.f }
function ignoreNested<T>(a: T, _b: { f: T[] }): T { a }
function onlyBNested<T>(_a: T, b: { f: T[] }): T { b.f[0] }
print(ignore(c, { f: k }).r ?? 6)
print(onlyB(c, { f: k }).r ?? 6)
print(ignoreNested(c, { f: [k] }).r ?? 6)
print(onlyBNested(c, { f: [k] }).r ?? 6)
