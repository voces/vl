// D2589: a write inside the right operand of a narrowing `&&` or `||` ends what the left operand
// established, so the arm the whole condition guards reads the place at its declared type. The
// write may sit in an if-expression arm, a `match` arm, or a `while` loop's own condition.
type A = { r: i32 }
type R = { f: A | null }
function mkA(n: i32): A | null {
  if n == 0 { return null }
  { r: n }
}

function pathAnd(n: i32) {
  const p: R = { f: mkA(7) }
  if p.f != null && (if n == 1 { p.f = null; true } else { false }) {
    print(p.f.r)
  }
}

function bareAnd(n: i32) {
  let x: A | null = mkA(7)
  if x != null && (if n == 1 { x = null; true } else { false }) { print(x.r) }
}

function matchArm(n: i32) {
  const p: R = { f: mkA(7) }
  if (
    p.f != null
    && (match n {
      1 => {
        p.f = null; true
      }
      _ => false
    })
  ) {
    print(p.f.r)
  }
}

function whileCond(n: i32) {
  let x: A | null = mkA(7)
  while x != null && (if n == 1 { x = null; true } else { false }) {
    print(x.r)
  }
}

function orElse(n: i32) {
  const p: R = { f: mkA(7) }
  if p.f == null || (if n == 1 { p.f = null; false } else { false }) {
    print(0)
  } else {
    print(p.f.r)
  }
}

function postGuard(n: i32) {
  let x: A | null = mkA(7)
  if x == null || (if n == 1 { x = null; false } else { false }) { return }
  print(x.r)
}

function valueUnion(n: i32) {
  let u: i32 | string | null = 4
  if u is i32 && (if n == 1 { u = null; true } else { false }) { print(u + 1) }
}

pathAnd(1)
bareAnd(1)
matchArm(1)
whileCond(1)
orElse(1)
postGuard(1)
valueUnion(1)
