// @run
// @log 40
// @log 12
// @log 40
// @log 60
// @log 3
// @log 4
// D14532: a read out of a container its stores build at a wider record, handed to an annotated
// parameter that is only read or written for a field, runs: the callee has a copy at that rep.
type J = { f: i32 | null }
function mk() { { f: 4 } }
function g(r: { f: i32 }) { r.f * 10 }
function h(o: { a: { f: i32 } }) { o.a.f * 3 }
function down(r: { f: i32 }): i32 {
  if r.f > 3 { return down({ f: r.f - 1 }) }
  r.f
}
const wideJ: J = mk()
const w = { a: mk() }
const xs = [mk()]
print(g(w.a))
print(h(w))
print(g(xs[0]))
print(g(xs[0]) + g({ f: 2 }))
print(down(xs[0]))
print(wideJ.f ?? 0)
