// @check
// @error cannot assign i32 | string to 'y' of type i32 — 'a.x' is no longer narrowed to i32: the assignment to 'al.x' on line 17 may reassign it; re-test 'a.x' after the assignment
// @error cannot assign i32 | string to 'y' of type i32 — 'a.x' is no longer narrowed to i32: the call to 'k' on line 29 may reassign it; re-test 'a.x' after the call
// @error cannot assign i32 | string to 'y' of type i32 — 'a.x' is no longer narrowed to i32: the assignment to 'al.x' on line 37 may reassign it; re-test 'a.x' after the assignment
// @error cannot assign i32 | string to 'y' of type i32 — 'a.x' is no longer narrowed to i32: the call to 'setX' on line 46 may reassign it; re-test 'a.x' after the call
// @error cannot assign i32 | string to 'y' of type i32 — 'a.x' is no longer narrowed to i32: the assignment to 'al.x' on line 58 in the loop around this read may reassign it; re-test 'a.x' after the assignment
// The path twin of `union-record-narrowing-ends-on-aliased-write-reject.vl`: the same five ways
// a write reaches the object through another place end the narrowing of `a.x`.

type A = { x: i32 | string }

function setX(self: A, v: string) { self.x = v }

export function viaAlias(a: A) {
  const al = a
  if a.x is i32 {
    al.x = "s"
    const y: i32 = a.x
    print(y)
  }
}

export function viaClosure(a: A) {
  const al = a
  const k = () => {
    al.x = "s"
  }
  if a.x is i32 {
    k()
    const y: i32 = a.x
    print(y)
  }
}

export function viaParam(a: A, al: A) {
  if a.x is i32 {
    al.x = "s"
    const y: i32 = a.x
    print(y)
  }
}

export function viaMethod(a: A) {
  const al = a
  if a.x is i32 {
    al.setX("s")
    const y: i32 = a.x
    print(y)
  }
}

export function inLoop(a: A) {
  const al = a
  if a.x is i32 {
    for i in [0, 1] {
      const y: i32 = a.x
      print(y)
      al.x = "s"
    }
  }
}
