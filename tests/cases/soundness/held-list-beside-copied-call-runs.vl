// @run
// @log 1
// @log 1
// @log 1
// @hint Intentionally-unused parameter `_x`
// @hint Intentionally-unused parameter `_a`
// @hint Intentionally-unused parameter `_b`
// D15183: a fresh call D14817 copies into the record a held argument pins sits beside a held list
// argument at that record; the instance is the held argument's, so the list is handed as it is.
type Circle = { r: i32 | null }
type K = { r: null }
function sink(_x: Circle) {}
function mkcall() { { r: null } }
sink(mkcall())
const k: K = { r: null }
const ks = [k]
function f<T>(_a: T, _b: T, c: T[]) { c.length }
print(f(mkcall(), k, ks))
print(f(mkcall(), k, [k]))
print(ks.length)
