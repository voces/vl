// @run
// @info `r` is never reassigned
// @log 6
// @log 4
// A maker called more than once keeps its own record; its call is copied where it lands wider.
// A fresh record `let` pushed into a list of a maker's calls is also handed on at its own type,
// and runs (D15283).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const wideJ: J = mk()
const xs = [mk()]
let r = { f: 6 }
xs.push(r)
function h(o: { f: i32 }) { o.f }
print(h(r))
print(wideJ.f ?? 0)
