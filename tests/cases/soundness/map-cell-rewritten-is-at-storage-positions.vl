// A map cell written in an `is` branch, written whole again, then tested for the member it holds:
// the test reads the cell's box at its storage, past the write's narrowing. A string and an `i32`
// member, a second key, inside a function and at top level.
function strCell() {
  const m: {[string]: i32 | string} = Map()
  if m["k"] is string { m["k"] = 5 }
  m["k"] = "x"
  if m["k"] is string { print(m["k"]) }
}
function intCell() {
  const m: {[string]: i32 | string} = Map()
  m["k"] = "s"
  if m["k"] is string { m["k"] = 5; print(m["k"] + 1) }
  m["k"] = 3
  if m["k"] is i32 { print(m["k"] + 10) }
}
function twoKeys() {
  const m: {[string]: i32 | string} = Map()
  m["a"] = 1
  if m["a"] is i32 { m["b"] = "y" }
  m["b"] = 7
  let c = 0
  if m["b"] is i32 { c = c + 1 }
  if m["a"] is i32 { c = c + 10 }
  print(c)
}
strCell() // x
intCell() // 6 13
twoKeys() // 11
const tm: {[string]: i32 | string} = Map()
if tm["k"] is i32 { tm["k"] = "q" }
tm["k"] = "z"
if tm["k"] is string {
  print(tm["k"]) // z
}
