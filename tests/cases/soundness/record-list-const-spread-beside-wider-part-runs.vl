// @run
// @log 1
// @log 1
// @log 1
// @log 1
// @log 2.5
// A fresh list `const` spread into a list literal beside a part built at a wider record is built
// at that record, as a spread into a push builds it (D16440). One list per position: beside a
// held record, beside a literal, before a literal, a read of the spread list itself, and a read
// of the held part.
const a = { x: 2.5 }
const s1 = [{ x: 1 }]
const l1 = [a, ...s1]
print(l1[1].x)
const s2 = [{ x: 1 }]
const l2 = [{ x: 2.5 }, ...s2]
print(l2[1].x)
const s3 = [{ x: 1 }]
const l3 = [...s3, { x: 2.5 }]
print(l3[0].x)
const s4 = [{ x: 1 }]
const l4 = [a, ...s4]
print(s4[0].x)
print(l4[0].x)
