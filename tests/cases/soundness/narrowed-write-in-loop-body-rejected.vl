// @check
// @error 'q' was narrowed by a guard OUTSIDE this loop, so this write would leave the reads before it reading null on the next iteration
// VERDICT PIN (must-error): the RE-EXECUTION BARRIER. A loop body is checked once and
// executed many times, so "the narrowing retires from the write onward" is not a
// statement-order fact there: the read textually BEFORE the write runs again after it.
// Here the guard is OUTSIDE the loop and gets no re-test, so `use(q)` reads a null on
// the second iteration — and the write keeps master's reject.
//
// THE BARRIER IS WHAT MAKES THE MOTIVATING IDIOM SOUND WITHOUT A BACK-EDGE PASS, and it
// distinguishes the two loop shapes exactly. `while q != null { use(q)   q = null }` is
// accepted (`narrowed-write-retires-bare-name.vl`): the loop's OWN condition is the
// guard, so it is re-tested on every back edge and holds on entry to every iteration
// whatever the body wrote. A guard from an enclosing `if`, as below, has no such
// re-test. Removing the barrier turns this file into a check-clean program that prints
// a null on iteration two.

function step(k: i32) {
  if k < 3 { return k + 1 }
  null
}

function loopWrite() {
  let q = step(0)
  let n = 0
  let go = true
  if q != null {
    while go {
      n = n + q
      q = null
      go = false
    }
  }
  print(n)
}

loopWrite()
