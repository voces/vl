// @run
// @log 1
// @log 0
// @log 1
// @log 0
// @log 1
// @log false
// @log true
// A list `is` test whose calls hand one fixed list it can never match and another it can answers
// per instance by that instance's own element (DECISIONS "An annotation fixes an empty list's
// element type"): the disjoint call skips the arm, the meeting one enters it.
function g2<V>(v: V) {
  if v is f64[] { print(v.length) }
  print(1)
}
const e: i32[] = []
g2(e)
const k: f64[] = []
g2(k)
function h2(v) {
  if v is f64[] { return 1 }
  return 0
}
print(h2(e))
print(h2(k))
function h<V>(v: V[]) { return v is f64[] }
print(h(e))
print(h([2.5]))
