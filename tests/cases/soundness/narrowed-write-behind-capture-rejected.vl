// @check
// @error 'w1', made on line 18, reads 'v' as i32, a narrowing a write since then may have ended — re-test 'v' before this call, or inside 'w1'
// VERDICT PIN (must-error): a closure made inside a guarded region reads its capture at the
// narrowed rep and runs later. The write after it is accepted and ends the narrowing (D2609),
// so the CALL after the write is what is refused: the binding no longer holds the type the
// closure captured (D2402). Without the refusal the closure would read a null as an `i32`.

function mk(b: boolean): i32 | null {
  if b { return 7 }
  return null
}

function captureThenWrite(b: boolean) {
  let v = mk(b)
  if v != null {
    const w1 = () => {
      print(v + 1)
    }
    v = null
    w1()
  }
  print("end")
}

captureThenWrite(true)
