// @check
// @error cannot assign null to i32
// VERDICT PIN (must-error): a narrowing a CLOSURE captured is not retirable. A closure
// created inside a guarded region reads its capture at the region's NARROWED rep and runs
// LATER, so retiring the narrowing behind it is a write the capture never sees: without
// this the file below is `vl check`-clean and emits a module the engine rejects with
// `expected (ref null $type), found i32` inside `w1`.
//
// The write therefore keeps master's verdict AND master's message. `narFnEpoch` counts
// function bodies checked and every narrowing records the count at install, so "a body
// that may have captured this narrowing has been checked since" is one comparison. It is
// deliberately coarse — it does not ask whether the closure captures THIS name — because
// the sound-and-coarse answer costs only programs that were rejected anyway.
//
// THE ORDER MATTERS AND THE OTHER ORDER IS ACCEPTED: a closure created BEFORE the guard
// captured the binding un-narrowed, its epoch is already spent when the narrowing
// installs, and the write inside the guard goes through.

function mk(b: boolean): i32 | null {
  if b { return 7 }
  return null
}

function captureThenWrite(b: boolean) {
  let v = mk(b)
  if v != null {
    const w1 = () => { print(v + 1) }
    v = null
    w1()
  }
  print("end")
}

captureThenWrite(true)
