// @run
// @log null
// @log d
// @log true
// @log null
// @log true
// @log false
// @log true
// @log e
// @log s
// @log true
// @log s
// @log null
// @log d
// @log false
// @log true
// @log t
// @log true
// @log true
// A `string | null` or `boolean | null` read the checker narrowed to `null` still holds its
// cell's niche: the name, the field and the module global each print, test and `??` it as
// the nullable value, and a write after the narrowing seeds the cell's null, not the read's.
function pick(k: i32): string | null {
  if k == 0 { return null }
  "s"
}
function pb(k: i32): boolean | null {
  if k == 0 { return null }
  true
}
type S = { s: string | null }
function f(k: i32) {
  const r = pick(k)
  if r is string {
    print(r)
  } else {
    print(r)
    print(r ?? "d")
    const z: string | null = r
    print(z == null)
  }
  const b = pb(k)
  if b is boolean {
    print(b)
  } else {
    print(b)
    print(b == null)
    print(b ?? false)
  }
  const o: S = { s: pick(k) }
  if o.s is string {
    print(o.s)
  } else {
    print(o.s == null)
    print(o.s ?? "e")
  }
}
f(0)
f(1)
let g = pb(0)
let s = pick(0)
function h() {
  if g == null { print(g) } else { print(g) }
  if s == null { print(s ?? "d") } else { print(s) }
  print(g ?? false)
}
h()
g = true
s = "t"
h()
if g != null { print(g) }
