// @run
// @log 7
// @log 8
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 8
// @log 7
// @log true
// @log 7
// @log 7
// @log 8
// @log 7
// @log 8
// @log 7
// @log 1
// D2933: an un-annotated object literal whose field types match a declared record exactly is
// built at the record type its binding is handed to, when that record has the same field names
// and stores them differently, so every delivery and every read of the binding sees one struct.
type J = { f: i32 | null }
type I = { f: i32 }
type A = { v: i32 }
type NJ = { f: A | null }
type NI = { f: A }
type PJ = { b: string, a: i32 | null }
type PI = { a: i32, b: string }
type H = { h: J }

function show(j: J) { print(j.f ?? 0) }
function showN(j: NJ) {
  if j.f != null { print(j.f.v) } else { print(0) }
}
function showP(j: PJ) { print(j.a ?? 0) }

function argument() {
  const r = { f: 7 }
  show(r)
  print(r.f + 1)
}
function binding() {
  const r = { f: 7 }
  const j: J = r
  show(j)
}
function retJ(): J {
  const r = { f: 7 }
  return r
}
function element() {
  const r = { f: 7 }
  const js: J[] = [r]
  show(js[0])
}
function pushed() {
  const r = { f: 7 }
  const js: J[] = []
  js.push(r)
  show(js[0])
}
function field() {
  const r = { f: 7 }
  const hh: H = { h: r }
  show(hh.h)
}
function captured() {
  const r = { f: 7 }
  const k = () => {
    show(r)
  }
  k()
  print(r.f + 1)
}
function aliased() {
  const r = { f: 7 }
  const q = r
  show(q)
}
function compared() {
  const r = { f: 7 }
  const j: J = r
  print(j == r)
  show(j)
}
function nested() {
  const r = { f: { v: 7 } }
  showN(r)
  print(r.f.v + 1)
}
function permuted() {
  const r = { a: 7, b: "x" }
  showP(r)
  print(r.a + 1)
}
function listElement() {
  const other: J[] = []
  const rs = [{ f: 7 }]
  show(rs[0])
  print(rs.length + other.length)
}

argument()
binding()
show(retJ())
element()
pushed()
field()
captured()
aliased()
compared()
nested()
permuted()
listElement()
