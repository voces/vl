// @run
// @log true
// @log false
// @log 5
// @log 7
// @log 5
// @log i32
// @log 5
// @hint redundant type annotation: `c1` is inferred as `boolean`
// @hint redundant type annotation: `c0` is inferred as `boolean`
// @hint redundant type annotation: `x` is inferred as `i32 | f64 | null`
// @hint redundant type annotation: `z` is inferred as `i32 | f64 | null`
// D2627, D2629. After an `if` whose arm wrote a numeric member, the place holds either member,
// so `i32` and `f64` join to `i32 | f64`, never to the `f64` the `i32` widens to. Both arms
// writing the `i32` member at a field or cell read it as `i32`. A loop's widening write into a
// field ends the narrowing before the loop, and a store through an alias leaves a map cell
// present, reading its value type.
function c1(): boolean { return true }
function c0(): boolean { return false }
function usei32(v: i32) { print(v) }
function src(): i32 | f64 | null { return 5 }
type W = { f: f64 | i32 }
function show(v: f64 | i32) {
  if v is i32 { print("i32"); print(v) } else { print("f64"); print(v) }
}
function oneBranch() {
  let x: i32 | f64 | null = src()
  if x is i32 {
    if c1() { x = 1.5 }
    const y: i32 | f64 | null = x
    print(y is f64)
  }
  let z: i32 | f64 | null = src()
  if z is i32 {
    if c0() { z = 1.5 }
    print(z is f64)
  }
}
function bothArms() {
  const w: W = { f: 1.5 }
  if w.f is f64 {
    if c1() { w.f = 5 } else { w.f = 7 }
    usei32(w.f)
  }
  const l: (f64 | i32)[] = [1.5]
  if l[0] is f64 {
    if c0() { l[0] = 5 } else { l[0] = 7 }
    usei32(l[0])
  }
}
function fieldLoop() {
  const w: W = { f: 1.5 }
  if w.f is f64 {
    let i = 0
    while i < 1 { w.f = 5; i = i + 1 }
    usei32(if w.f is i32 { w.f } else { 0 })
  }
}
function aliasMap() {
  const m: {[string]: f64 | i32} = Map()
  m["k"] = 1.5
  const m2 = m
  if m["k"] is f64 {
    m2["k"] = 5
    show(m["k"])
  }
}
oneBranch()
bothArms()
fieldLoop()
aliasMap()
