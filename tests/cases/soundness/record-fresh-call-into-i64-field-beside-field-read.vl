// @run
// @log 1
// @log 1
// @log 1
// @log 1
// @log 2147483648
// @log -2147483648
// @log -2
// D14383, D14384: a literal-building function called once into `{ x: i64 }` and once for a
// field read is built at `i64`, and the read narrows it back to the `i32` it is typed as, so
// arithmetic on it still wraps at 32 bits.
function bare() { { x: 1 } }
function take(p: { x: i64 }): void { print(p.x) }
take(bare())
const a = bare()
print(a.x)

function held() {
  const r = { x: 1 }
  r
}
take(held())
const b = held()
print(b.x)

function big() {
  const r = { x: 2147483647 }
  r
}
function takeInc(p: { x: i64 }): void { print(p.x + 1) }
takeInc(big())
const c = big()
const cx = c.x
print(cx + 1)
print(c.x * 2)
