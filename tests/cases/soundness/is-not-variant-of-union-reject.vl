// @check
// @warning `is` check type 'C' is not a variant of A | B, so this test is always false here
// @warning Unused function `f` (prefix with `_` to suppress, remove it, or `export` it)
// @warning this branch can never run (its `is` test can never match)
// @hint redundant type annotation: `f` is inferred as `i32` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// A record type that is no variant of the union, tested with `is`: a warning, the test folds to
// false, and its arm reads the operand as `never` (the D16047 ruling, 2026-11-14).
type A = { x: i32 }
type B = { y: i32 }
type C = { z: i32 }

function f(v: A | B): i32 {
  if v is C {
    return 0 // C is not a variant of A | B
  }
  return 1
}
