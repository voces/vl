// @run
// @log 4
// @hint Intentionally-unused variable `_k`
// A function's record result shared between an own-type binding and a record that stores its
// integer as an `i64` one level down is copied at that delivery, the nested record at its own row
// (D15264; this was a must-error pin while the converting copy served only a flat field).
type J = { f: i64 }
type K = { j: J }
function mk() { { j: { f: 4 } } }
const y = mk()
const _k: K = mk()
print(y.j.f)
