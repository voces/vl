// @run
// @log 1
// @log 2
// @log 0
// @log b
// @log a
// @log a
// @log b
// @hint redundant type annotation: `e` is inferred as `S`
// @hint redundant type annotation: `f` is inferred as `S`
// D4928: inside `if (b is K[])` the elements of `b` read as `K`, and a `K[]` of its own is a
// `map` copy, which a later write to `b` does not reach. String literal unions read the same
// way, at every nesting depth.
type K = 0 | 1
type S = "a" | "b"
const b = [0, 1]
const s = ["a", "b"]
let k: K[] = []
if (b is K[]) {
  k = b.map((x) => x)
  const show = (x: K) => {
    print(x)
  }
  show(b[1])
  print(b.map((x) => x + 1)[1])
}
b[0] = 5
print(k[0])
let t: S[] = []
if (s is S[]) {
  const e: S = s[1]
  print(e)
  const sh = (x: S) => {
    print(x)
  }
  sh(s[0])
  t = s.map((x) => x)
}
s[0] = "zz"
print(t[0])
const m: string[][] = [["a"], ["b", "a"]]
if (m is S[][]) {
  const f: S = m[1][0]
  print(f)
}
