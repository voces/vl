// @run
// @log null
// @log d
// @log null
// @log false
// @log null
// @log true
// @log b:true
// @log s:true
// @log s
// @log true
// A `string | null` or `boolean | null` local narrowed to `null` by the else of `is string` or
// `is boolean` reads as its cell's null: printed, defaulted by `??`, compared, bound to a typed
// `string | null`. Handed to a parameter of the other nullable it is that parameter's own null.
function ps(k: i32): string | null {
  if k == 0 { return null }
  return "s"
}
function pb(k: i32): boolean | null {
  if k == 0 { return null }
  return true
}
function takeB(x: boolean | null) { print("b:\{x == null}") }
function takeS(x: string | null) { print("s:\{x == null}") }
function s(k: i32) {
  const b = ps(k)
  if b is string {
    print(b)
  } else {
    print(b)
    print(b ?? "d")
    const z: string | null = b
    print(z)
  }
}
function t(k: i32) {
  const b = pb(k)
  if b is boolean {
    print(b)
  } else {
    print(b ?? false)
    print(b)
    print(b == null)
  }
}
function toB(k: i32) {
  const b = ps(k)
  if b is string { print(b) } else { takeB(b) }
}
function toS(k: i32) {
  const b = pb(k)
  if b is boolean { print(b) } else { takeS(b) }
}
s(0)
t(0)
toB(0)
toS(0)
s(1)
t(1)
