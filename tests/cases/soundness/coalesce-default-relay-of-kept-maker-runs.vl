// @run
// @log 1
// @log 1
// @log 1
// @log 1
// A maker called more than once keeps its own record; its call is copied where it lands wider.
// A `??` default calling a relay of a maker an annotated binding also takes runs, at any relay
// depth (D15380).
type J = { f: i32 | null }
function mk2() { { f: 1 } }
function mk4() { mk2() }
const dA: J = mk2()
function mk6() { mk4() }
print(dA.f ?? 0)
print(mk4().f ?? 0)
const m = Map()
m.set("a", { f: 4 })
const b = m.get("z") ?? mk4()
print(b.f)
const c = m.get("y") ?? mk6()
print(c.f)
