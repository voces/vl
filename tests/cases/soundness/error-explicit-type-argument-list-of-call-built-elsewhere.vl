// @check
// @hint Intentionally-unused parameter `_x`
// @error-at 9:5 {r: null} is not Circle: they store field `r` differently
// VERDICT PIN (must-error): a call whose record another delivery builds at a wider record, handed
// in a list literal to a call that writes its type argument, is refused as its direct twin is (D14815).
type Circle = { r: i32 | null }
type K = { r: null }
function sink(_x: Circle) {}
function mkcall() { { r: null } }
sink(mkcall())
function first<T>(xs: T[]): T { xs[0] }
print(first<K>([mkcall()]).r ?? 1)
