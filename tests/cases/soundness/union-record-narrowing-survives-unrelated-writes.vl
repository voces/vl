// @run
// @log 1
// @log 2
// @log 1
// @log 3
// @log 2.5
// @log 7
// @log left
// @log 1
// @log 7
// @log 1
// @log 2
// @hint `B` is contained in `A`, so `is B` tests the value
// @hint redundant type annotation: `y` is inferred as `1 | 2` — remove it to lean on inference
// @hint `B` is contained in `A`, so `is B` tests the value
// @hint redundant type annotation: `y` is inferred as `1 | 2` — remove it to lean on inference
// @hint `B` is contained in `A`, so `is B` tests the value
// @hint `B` is contained in `A`, so `is B` tests the value
// @hint `B` is contained in `A`, so `is B` tests the value
// @hint `B` is contained in `A`, so `is B` tests the value
// @hint redundant type annotation: `y` is inferred as `1 | 2` — remove it to lean on inference
// @hint `B` is contained in `A`, so `is B` tests the value
// @hint redundant type annotation: `z` is inferred as `1 | 2` — remove it to lean on inference
// A union binding narrowed to a record by its field values survives what cannot reach the object
// (a fresh object's write, a call that only reads), and once a write ends it the binding reads
// at its declared type and re-tests afresh.
type A = { x: i32 }
type B = { x: 1 | 2 }

function plus(p: A) { p.x + 1 }

function fresh(base: A) {
  const a: A | B = base
  const other: A = { x: 1 }
  if a is B {
    other.x = 7
    const y: 1 | 2 = a.x
    print(y)
  }
}
fresh({ x: 1 })

function readsOnly(base: A) {
  const a: A | B = base
  if a is B {
    print(plus(base))
    const y: 1 | 2 = a.x
    print(y)
  }
}
readsOnly({ x: 1 })

// A record discriminated by a literal field keeps the narrowing across a call that only reads.
type C = { kind: "c", r: f64 }
type S = { kind: "s", w: f64 }
function area(sh: C | S) {
  if sh.kind == "c" { return sh.r * 2.0 }
  sh.w
}
function grow(sh: C | S) {
  if sh is C {
    print(area(sh))
    sh.r = sh.r + 1.0
    print(sh.r)
  }
}
grow({ kind: "c", r: 1.5 })

function retest(base: A) {
  const a: A | B = base
  const k = () => {
    base.x = 7
  }
  if a is B {
    k()
    print(a.x)
    if a is B { print("still") } else { print("left") }
  }
}
retest({ x: 1 })

function loopRead(base: A) {
  const a: A | B = base
  if a is B {
    for i in [0, 1] {
      print(a.x)
      base.x = 7
    }
  }
}
loopRead({ x: 1 })

// Below a guard that exits, the same: a write elsewhere keeps it, and a re-test after a write
// narrows afresh.
type O = { w: i32 }
function afterGuard(base: A, other: O) {
  const a: A | B = base
  if !(a is B) { return 0 }
  other.w = 7
  const y: 1 | 2 = a.x
  print(y)
  base.x = 2
  if !(a is B) { return 0 }
  const z: 1 | 2 = a.x
  print(z)
  0
}
afterGuard({ x: 1 }, { w: 3 })
