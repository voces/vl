// @run
// @log 3.5
// @log 3.5
// @log 1.5
// @log 3.5
// @log 1.5
// @log 3.5
// A fresh call delivered to a union holding a wider record keeps master's boxed build, whether
// the function is called once through an identity or at several sites (D3444's review): none
// of these is refused as an existing record.
type R = { v: f64 }
function idd<T>(x: T): T { x }
function mk0() { { v: 7 } }
const d0: R | string = idd(mk0())
if d0 is R { print(d0.v / 2) }

function mk1(k: i32) { { v: k } }
const d1: R | string = mk1(7)
const e1 = mk1(3)
if d1 is R { print(d1.v / 2) }
print(e1.v / 2)

function mk2(k: i32) { { v: k } }
function take(d: R | string) {
  if d is R { print(d.v / 2) }
}
take(mk2(7))
take(mk2(3))

function mk3() { { v: 7 } }
const xs: (R | string)[] = [mk3(), mk3()]
const a = xs[1]
if a is R { print(a.v / 2) }
