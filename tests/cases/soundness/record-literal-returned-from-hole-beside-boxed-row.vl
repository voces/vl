// @run
// @log 5
// @log 6
// @log 5
// @hint redundant type annotation: `v` is inferred as `{f: i32}`
// @hint redundant type annotation: `k` is inferred as `{f: i32}`
// @hint redundant type annotation: `xs` is inferred as `{f: i32}[]`
// D8680: a record literal built inside an instance, its field typed by the hole, keeps its own
// storage when a declared record of its field names boxes that field and the result lands at
// an annotated record of the literal's own storage; a generic builder too, and a list of them.
type J = { f: i32 | null }
function bump(n) { return { f: n + 1 } }
function mk<T>(n: T) { return { f: n } }
const v: { f: i32 } = bump(4)
print(v.f)
const k: { f: i32 } = mk(6)
print(k.f)
const xs: { f: i32 }[] = [bump(4)]
print(xs[0].f)
