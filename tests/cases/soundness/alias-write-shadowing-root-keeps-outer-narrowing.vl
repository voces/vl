// @run
// @log true
// @log 42
// A write through an inner binding that shadows a narrowed path's root is a write to another
// object: the inner `p` is a fresh record no other place refers to, so the outer `p.f` keeps its
// narrowing. The alias rule compares the two roots' declarations, not their names (D3307).
type A = { f: i32 | null }
function go(p: A) {
  if p.f != null {
    {
      const p: A = { f: 1 }
      p.f = null
      print(p.f == null)
    }
    print(p.f + 1)
  }
}
go({ f: 41 })
