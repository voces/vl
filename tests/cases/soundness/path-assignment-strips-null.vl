// @run
// @log 6
// @log 2
// @log ab
// @log 7
// @log 6
// @log true
// @log true
// @warning `t != null` is always true here (t is string)
// D1848. A non-null write to a nullable field or list cell strips `null` for the code after it,
// as `x = 5` does a name: `o.v + 1` runs. A binding read out of the field is proved non-null, so
// its null test is a dead-test warning and a constant (owner ruling 2026-09-26). A later null
// write, or a call that may write the field, ends the strip.
type N = { v: i32 | null }
type M = { v: string | null }
type S = { n: i32 }
type P = { v: S | null }
function clr(o: N) { o.v = null }
function scalar(o: N) {
  o.v = 5
  print(o.v + 1)
}
function str(o: M) {
  o.v = "ab"
  print(o.v.length)
  const t = o.v
  if t != null { print(t) } else { print("NULL") }
}
function struct(o: P) {
  o.v = { n: 7 }
  print(o.v.n)
}
function cell(xs: (i32 | null)[]) {
  xs[0] = 5
  print(xs[0] + 1)
}
function nullAfter(o: N) {
  o.v = 5
  o.v = null
  print(o.v == null)
}
function callAfter(o: N) {
  o.v = 5
  clr(o)
  print(o.v == null)
}
scalar({ v: null })
str({ v: null })
struct({ v: null })
cell([null])
nullAfter({ v: 1 })
callAfter({ v: 1 })
