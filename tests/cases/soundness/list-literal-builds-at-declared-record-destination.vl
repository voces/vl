// @run
// @log 7
// @log 7
// @log 1
// @log b
// @log 8
// @log 8
// @log 9
// @log 10
// @log 11
// @log 12
// @log 4
// @log a
// @hint redundant type annotation: `i` is inferred as `{f: i32}`
// @hint redundant type annotation: `s` is inferred as `{f: string}`
// D2881: an un-annotated list of object literals that a declared destination later adopts
// into another record is built at the destination's record, not at an annotated record of the
// same field names elsewhere in the module, so the one list both handles hold is one type.
const i: { f: i32 } = { f: 4 }
const s: { f: string } = { f: "a" }
type I = { f: i64 | null }
const il = [{ f: 7 }]
const ic: I[] = il
print(ic[0].f)
print(il[0].f)
print(il.length)
type J = { f: string | null }
const jl = [{ f: "b" }]
const jc: J[] = jl
print(jc[0].f)
function local() {
  const ll = [{ f: 8 }]
  const lc: I[] = ll
  print(lc[0].f)
  print(ll[0].f)
}
local()
function take(xs: I[]) { print(xs[0].f) }
const al = [{ f: 9 }]
take(al)
type W = { xs: I[] }
const fl = [{ f: 10 }]
const w: W = { xs: fl }
print(w.xs[0].f)
const cl = [{ f: 11 }]
const cap = () => {
  const cc: I[] = cl
  print(cc[0].f)
  0
}
cap()
type K = { f: i32 | null }
const kl = [{ f: 12 }]
let kc: K[] = []
kc = kl
print(kc[0].f)
print(i.f)
print(s.f)
