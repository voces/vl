// @check
// @error was narrowed by a guard, but the assignment on line 25 ended the narrowing
// VERDICT PIN (must-error): the retirement half of the accepted write, in the direction
// a run cannot see. Accepting `q = null` inside a guard is only sound if the narrowing
// STOPS holding at that point, so the read after it must be refused. Drop the
// retirement and this file compiles, then prints the pre-write value.
//
// THE READ IS REFUSED RATHER THAN RE-TYPED, and that is not conservatism. The EMITTER's
// narrow stack (`narrowStripNullOnly`, emit_state.vl) is built on "writing null back
// inside a null guard is impossible", so a read after such a write is lowered against
// the region's stale UNBOXED rep: typing the read `i32?` instead gives a check-clean
// module the engine rejects with "expected (ref null $type), found i32". The
// property-path spelling has always refused the read (`pathInvalidatedErr`); this makes
// the bare-name spelling agree, and the message says where a live read can go.

function step(k: i32) {
  if k < 3 { return k + 1 }
  null
}

function readAfterWrite() {
  let q = step(0)
  if q != null {
    print(q)
    q = null
    print(q ?? 9)
  }
}

readAfterWrite()
