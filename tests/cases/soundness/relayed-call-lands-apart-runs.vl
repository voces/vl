// @run
// @log 4
// @log 4
// A call an inferred function hands back lands where that function's call is delivered, at `K`
// storing `f` as `i64 | null`: the copy widens it there and boxes it (D14516, D15715).
type J = { f: i32 | null }
type K = { f: i64 | null }
function mk() { { f: 4 } }
const wideJ: J = mk()
function relay() { mk() }
const v: K = relay()
print(wideJ.f ?? 0)
print(v.f ?? 0)
