// @check
// @error-at 8:8 `c` holds only a literal, so it is built at the type it is delivered to, but it is delivered as Circle (line 11) and as Tag (line 11), which store a field differently, and a record is shared, not copied. Annotate the records in `c` with one of them, and copy it with an object literal for the other
// D14507: two annotated reads of one list element that store a field differently are refused at
// the binding they would both pin, rather than built at one record and read as the other.
type Circle = { r: i32 | null }
type Tag = { r: string | null }

function rd() {
  const c = Map()
  c["k0"] = [{ r: null }]
  const g1 = c["k0"] ?? []
  const gp: Circle = g1[0]
  const t: Tag = g1[0]
  if t.r != null { print(1) }
  if gp.r != null { print(7) } else { print(0) }
}
rd()
