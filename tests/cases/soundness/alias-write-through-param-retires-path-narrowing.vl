// @check
// @error 'o.v' was narrowed by a guard, but the call to 'clr' on line 28 can write it
// VERDICT PIN (must-error): a narrowing over a property PATH is a fact about heap
// state, so a call that writes that field through its parameter falsifies it. The
// guard is right and the read is right; only their separation by `clr(o)` is wrong.
//
// This program CHECKED CLEAN and then trapped `null reference` at the `.length`. The
// identical DIRECT write one line up (`o.v = null`) is ACCEPTED and retires the narrowing
// itself (`writeStorageTy` / `retireNarrowingsForWrite`) — and the read after THAT is
// allowed, at the field's DECLARED type, exactly as the bare-name spelling has always been
// (`direct-write-retires-path-narrowing-and-reads-declared.vl`, inventory #2 D8).
//
// THE TWO CAUSES ARE NOT ONE RULE, and `pathRetiredByAssign` is where they part. A direct
// write is a statement the emit walk passes over, and `emit_classify`'s write-retirement
// retires it on the emit side too, so the two sides agree about the rep and the read is
// safe. An ALIASED write is the case the callee's write-effect summary is needed for,
// because the guarded scope never spells it — and the emitter has no relation that could
// detect it — so this one keeps the refusal.
//
// The diagnostic names the CALL rather than the nullness, because the call is the only
// part of the program the reader has to act on.
type O = { v: string | null }

function clr(o: O) { o.v = null }

const o: O = { v: "hi" }
if o.v != null {
  clr(o)
  print(o.v.length)
} else {
  print(0)
}
