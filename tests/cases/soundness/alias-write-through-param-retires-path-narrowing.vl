// @check
// @error 'o.v' was narrowed by a guard, but the call to 'clr' on line 22 can write it
// VERDICT PIN (must-error): a narrowing over a property PATH is a fact about heap
// state, so a call that writes that field through its parameter falsifies it. The
// guard is right and the read is right; only their separation by `clr(o)` is wrong.
//
// This program CHECKED CLEAN and then trapped `null reference` at the `.length`. The
// identical DIRECT write one line up (`o.v = null`) is ACCEPTED and retires the
// narrowing itself (`writeStorageTy` / `retireNarrowingsForWrite`), so the read after it
// is refused there too — by the same `pathInvalidatedErr` this file pins, naming the
// assignment instead of the call. An ALIASED write is the case the callee's write-effect
// summary is needed for, because the guarded scope never spells it.
//
// The diagnostic names the CALL rather than the nullness, because the call is the only
// part of the program the reader has to act on.
type O = { v: string | null }

function clr(o: O) { o.v = null }

const o: O = { v: "hi" }
if o.v != null {
  clr(o)
  print(o.v.length)
} else {
  print(0)
}
