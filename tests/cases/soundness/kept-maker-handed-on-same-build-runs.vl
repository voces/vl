// @run
// @log null
// @log null
// @log null
// @log 2
// @log null
// A kept maker's value handed on to a place every value of which is that maker's build: a `let`
// assigned another of its calls, and a list, direct or through a record field, holding only its
// calls (D15933).
type J = { f: i32 | null }
function mk2() { { f: null } }
const dA: J = mk2()
const a = mk2()
let b = mk2()
b = a
print(b.f)
const xs = [mk2()]
const r = { ys: xs }
r.ys.push(mk2())
print(r.ys[1].f)
const zs = [mk2()]
zs.push(mk2())
print(zs[1].f)
print(zs.length)
print(dA.f)
