// @check
// THE NEGATIVE FOR `totality-gate-nested-null.vl`, and the reason that fix is a bug fix
// rather than a loosening: making the gate RECURSE must not make it stop firing.
//
// The gate asks whether a return type admits `null`. It used to test only whether the
// type's TOP NODE was a `TyNullable`, which missed `i32 | (string | null)` — a union that
// reaches `null` one level down. It now asks `tyBearsNull`, which recurses.
//
// A recursive answer is only worth having if it still answers NO when it should. Every
// function below falls off the end and none of their return types contains a `null`
// anywhere, at any depth — so every one must still be refused. The nested case is the
// pointed one: `i32 | (string | boolean)` has the same SHAPE as the accepted spelling and
// differs only in that the inner arm is not nullable.
// @error not all code paths return a value in 'flat'
// @error not all code paths return a value in 'nested'
// @error not all code paths return a value in 'plain'

// a flat union with no null
type U = i32 | string
function flat(c: boolean): U {
  if c { return 5 }
}

// a NESTED union with no null — the shape the recursion has to walk into and still refuse
type N = string | boolean
type V = i32 | N
function nested(c: boolean): V {
  if c { return 5 }
}

// and the plain non-union case the gate has always caught
function plain(c: boolean): i32 {
  if c { return 5 }
}

print(1)
