// @no-instantiate expected
// ACCEPTS, THEN MISCOMPILES. A `string | null` argument at a GENERIC call: `vl check --codegen`
// exits 0 and the module does not validate —
//
//     type mismatch: expected (ref $type), found (ref null $type)
//
// which is, word for word, the failure `monoNulAnnName` exists to prevent. Its header says so:
// pinning `string` for a `string | null` argument makes the instance declare a NON-null
// parameter. The guard runs on the annotation channel and this shape reaches the pin without
// passing through it.
//
// THREE CONTROLS, in `generics/nullable-arg-generic-controls.vl`, and they place it tightly:
//   · `boolean | null` — compiles and runs. The boolean niche is an i32 sentinel, not a ref, so
//     there is no nullable-ref valtype to get wrong;
//   · the same call NON-generic (`function id(v: string | null): string | null`) — fine, because
//     no pin is minted at all;
//   · a plain `string` through the same generic — fine, which is the pin working correctly.
// So it is the pair: a nullable REF argument AND a generic instantiation.
//
// `i32 | null` fails too but LOUDLY (rc 1, no module emitted), so it is a different defect and
// is deliberately not folded in here — one shape per fixture.
//
// NOT MINIMISED FURTHER ON PURPOSE: the binding is annotated `string | null` and read back
// through a null check, which is the ordinary way to write this. The defect does not need an
// exotic spelling — it needs a nullable ref and a `<T>`.
function id<T>(v: T): T {
  return v
}

const s: string | null = "hi"
const r = id(s)
if r != null { print(r) } else { print(0) }
