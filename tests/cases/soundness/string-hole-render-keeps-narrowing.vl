// @run
// @log 0
// @log g g
// @log 0
// @log g g
// @hint redundant type annotation: `annotated` is inferred as `string`
// A string interpolation hole calls nothing, so it keeps a narrowing that a closure of the
// function could end, with the return annotated or inferred alike (D7765).
type G = { name: string, ty: i32 }
function find(k: i32): G | null {
  if k > 0 { { name: "g", ty: k } } else { null }
}
function annotated(): string {
  let g = find(2)
  const k = (): i32 => {
    g = null
    0
  }
  print(k())
  g = find(3)
  if g != null { return "\{g.name} \{g.name}" }
  "none"
}
print(annotated())

function inferred() {
  let g = find(2)
  const k = (): i32 => {
    g = null
    0
  }
  print(k())
  g = find(3)
  if g != null { return "\{g.name} \{g.name}" }
  "none"
}
print(inferred())
