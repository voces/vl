// @run
// @log 12000000003
// @log 12000000003
// @log 4
// @hint redundant type annotation: `ownN` is inferred as `i32`
// A function relaying a call whose record is read at its own row, delivered into a record storing
// a field as a wider number both directly and through another function, is copied at each
// delivery; a relay whose callee has no other read is built wide (D15244).
type R = { n: i64, s: string }
function mk() { { n: 3, s: "a" } }
const own = mk()
const ownN: i32 = own.n + 1
function fb() { mk() }
const vb: R = fb()
function g() { fb() }
const vg: R = g()
print(vg.n * 4000000000 + vb.n)
function mk2() { { n: 3, s: "b" } }
function fb2() { mk2() }
const wb: R = fb2()
function g2() { fb2() }
const wg: R = g2()
print(wg.n * 4000000000 + wb.n)
print(ownN)
