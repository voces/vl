// @run
// @log 4
// @log 4
// @log 1
// @log 2
// @log 1
// @log 4
// @log 1
// A `??` default held in a `const` of a record literal, for a read of a map whose values are built
// wider, placed in a list or record literal: the binding is built at the read's record and keeps
// its own type, so the join is one record and the slot holds it (D15313).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const m = Map()
m.set("a", mk())
const wm: {[string]: J} = Map()
wm.set("a", mk())
const d1 = { f: 1 }
const xs = [m.get("a") ?? d1]
print(xs[0].f ?? 0)
const d2 = { f: 1 }
const r = { g: m.get("a") ?? d2 }
print(r.g.f ?? 0)
const d3 = { f: 1 }
const ys = [m.get("z") ?? d3]
print(ys[0].f ?? 0)
print(d3.f + 1)
const d4 = { f: 1 }
const zs = [m.get("z") ?? d4, m.get("a") ?? d4]
print(zs[0].f ?? 0)
print(zs[1].f ?? 0)
type H = { f: i32 | null }
type K = { h: H }
function mkn() { { h: { f: 4 } } }
const mn = Map()
mn.set("a", mkn())
const wn: {[string]: K} = Map()
wn.set("a", mkn())
const d5 = { h: { f: 1 } }
const ns = [mn.get("z") ?? d5]
print(ns[0].h.f ?? 0)
