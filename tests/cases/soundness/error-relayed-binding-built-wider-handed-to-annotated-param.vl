// @check
// @error-at 11:13 {f: i32} is not J: they store field `f` differently
// D14750: a call built at a wider record, relayed through a returned binding of an identity,
// refuses where it reaches a parameter annotated at its own record, as the direct call does.
type J = { f: i32 | null }
function mk() { { f: 4 } }
function id<T>(x: T): T { x }
function r() {
  const k = id(mk())
  return k
}
const d: J = mk()
function u(a: { f: i32 }) { a.f }
print(u(r()))
print(d.f ?? 0)
