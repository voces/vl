// @error {v: i32 | f64 | string} is not D: they store field `v` differently (`i32 | f64 | string` into `f64 | string`), and a record is shared, not copied, so only a fresh record widens. A write through the D would break the {v: i32 | f64 | string}. Build the source as `D`, or copy it with a literal `{ v: … }`
// CONTRACT (must-error): a call of an inferred function whose returned literal the destination
// would keep two of its numbers as one in is judged by the function's own result type, as the
// annotated return is, since the result is built at that type (D14891).
type D = { v: f64 | string }
const x: i32 | f64 | string = 3
function mk() { return { v: x } }
const o = mk()
const d: D = o
print(d.v)
