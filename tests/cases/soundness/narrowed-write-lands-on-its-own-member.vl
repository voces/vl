// @run
// @log 5
// @log 5
// @log 5
// @log 5
// @log 5
// @log 7
// @hint redundant type annotation: `g` is inferred as `i32 | f64`
// @hint redundant type annotation: `x` is inferred as `i32 | f64`
// D2609. A write under a narrowing lands on the member of the declaration the value IS: `5`
// into an `i32 | f64` narrowed to `f64` is the `i32` member, boxed as one, and the place reads
// as `i32` after it rather than as the `f64` it was narrowed to. The same for a module binding,
// a field, a list cell and a map cell, and for a value typed as the whole union.
function src(): i32 | f64 { return 1.5 }
function src7(): i32 | f64 { return 7 }
type W = { f: i32 | f64 }
let g: i32 | f64 = src()
if g is f64 { g = 5; print(g) }
function local() {
  let x: i32 | f64 = src()
  if x is f64 { x = 5; print(x) }
}
function field() {
  const w: W = { f: 1.5 }
  if w.f is f64 { w.f = 5; print(w.f) }
}
function cell() {
  const xs: (i32 | f64)[] = [1.5]
  if xs[0] is f64 { xs[0] = 5; print(xs[0]) }
}
function mapCell() {
  const m: {[string]: i32 | f64} = Map()
  m["k"] = 1.5
  if m["k"] is f64 { m["k"] = 5; print(m["k"]) }
}
function unionValue() {
  let x: i32 | f64 = src7()
  if x is i32 { x = src7(); print(x) }
}
local()
field()
cell()
mapCell()
unionValue()
