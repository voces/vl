// @check
// @error f64 doesn't fit in i32 — the conversion is lossy and must be made explicit with `as` (write `x as i32`) (`q` holds only a literal, so it is built as the `D` it is delivered to
// D3339: adoption is all or nothing. `q` is delivered as `D`, so it is a `D` at every read, and
// a read that needs its own `i32` field is refused as the annotated `const q: D = { v: 7 }` is,
// never served at the literal's own width.
type D = { v: f64 }
const q = { v: 7 }
const d: D = q
const n: i32 = q.v
print(n)
print(d.v)
