// @run
// @log true
// @log null
// @log true
// @log s
// D2865. A `boolean` record literal beside a declared `{ f: i32 | null }` record keeps its own
// record: a `boolean` is no `i32 | null`, so neither its read nor a shared reader sees `null`.
const n: { f: i32 | null } = { f: null }
const x = { f: true }
print(x.f)
function p(o) { print(o.f) }
p(n)
p({ f: true })
const s = { f: "s" }
print(s.f)
