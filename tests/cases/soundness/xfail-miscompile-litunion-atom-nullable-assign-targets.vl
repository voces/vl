// @no-instantiate found struct.get of type i32
// ACCEPTS, THEN MISCOMPILES. A literal-union atom ASSIGNED into a nullable-string DESTINATION
// that is not a simple local. `vl check --codegen` exits 0 and the module does not validate.
//
// THE DESTINATION SHAPE IS THE WHOLE DEFECT, and getting that wrong is what this file records.
// A census of "nullable-string positions" concluded that ASSIGNMENT already worked, on the
// strength of a simple local:
//
//   let a: string | null = null ;  a = r.f       // OK — a LOCAL
//   b.v = r.f                                    // MISCOMPILES — a FIELD
//   xs[0] = r.f                                  // MISCOMPILES — a list ELEMENT
//   m["k"] = r.f                                 // MISCOMPILES — a map VALUE
//
// The census counted POSITIONS (let / call arg / field / if-arm / assign / global) and treated
// "assign" as one of them. It is at least four, and only the easiest was tested — so the arm
// written for the field CONSTRUCT (`{ v: r.f }`, code 20) does not cover the field ASSIGN, and
// the sibling fix moved the failure from one to the other rather than closing it.
//
// PROVEN ATOM-SPECIFIC: every destination above accepts a plain `string` RHS. It is the i32 atom
// rep reaching a `(ref null $type)` slot, the same shape as the positions that were closed.
type K = "ka" | "kb"
type R = { f: K }
type Box = { v: string | null }
function main() {
  const r: R = { f: "kb" }
  const b: Box = { v: null }
  b.v = r.f
  if b.v != null { print(b.v) }
}
main()
