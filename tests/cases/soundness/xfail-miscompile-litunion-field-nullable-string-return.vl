// @no-instantiate type error in return
// ACCEPTS, THEN MISCOMPILES. The `string | null` sibling of
// `xfail-miscompile-litunion-field-into-string-list.vl`: a literal-union struct field is the
// i32 ATOM, and returning it through a `string | null` annotation declares a nullable string
// reference result without widening the atom. The module fails validation and
// `vl check --codegen` exits 0.
//
// The NON-nullable form is the control and it WORKS:
//
//   function pick(r: R): string { r.f }                            // OK
//   function pick(b: boolean, r: R): string | null { … r.f … }     // MISCOMPILES — this file
//
// So the widening is present on the plain `string` return path and missing on the nullable
// one. That pins the gap as per-sink plumbing rather than an absent conversion, and it is why
// the two sinks are pinned as two files: fixing one need not fix the other.
type K = "ka" | "kb"
type R = { f: K }
function pick(b: boolean, r: R): string | null {
  if b { return r.f }
  null
}
function main() { print(pick(true, { f: "kb" }) ?? "none") }
main()
