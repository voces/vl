// @run
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @hint redundant type annotation: `xs` is inferred as `{r: i32}[]` — remove it to lean on inference
// @hint redundant type annotation: `c5` is inferred as `{g: i32}` — remove it to lean on inference
// @hint redundant type annotation: `d5` is inferred as `{h: i32}` — remove it to lean on inference
// THE THREE HINTS ABOVE ARE DECLARED, NOT DELETED, and each annotation is load-bearing:
// `xs: Circle[]` IS the control that named this row's second root (it ran before the fix
// because the source annotation hands the CHECKER the element type), and `c5: Ring` /
// `d5: Band` are what make program 5's two elements commit to DIFFERENT names, which is the
// disagreement gate the corpus `cmp` bought. Removing any of them removes what the program
// tests.
// GRADUATED from `@no-instantiate` (silent-class-inventory D157 + D163, 2026-08-27). This file
// was the check-clean-invalid-wasm SPECIMEN — `tests/vl_check_codegen_test.ts`'s
// `INVALID_MODULE_SRC` — and program 1 below is that constant verbatim. It printed
// `type mismatch: expected (ref $type), found (ref $type)` out of a `vl check` that exited 0
// with no diagnostics at all. It runs.
//
// TWO ROOTS, AND NEITHER ONE ALONE MOVES A SINGLE CELL. That is not a remark about tidiness;
// it is the measured landing order, and it is why both halves are in one commit:
//
//   * ROOT ONE, THE PIN. `dstPinCallArgs` read a parameter as an OPEN generic position only
//     when its spelling IS a type parameter, so `reverse`'s `xs: T[]` read as a CONCRETE
//     destination, `armPinAnnName("T[]")` cut the element `T`, `variantIndexOf("T")` declined,
//     and the position pushed `""` — a destination DISAGREEMENT that VETOED the pin the
//     declared result was already carrying. And `dstPinSrcIs` recognised exactly one
//     transparent hop, a whole-VALUE identity conduit, so it could not see through an `Index`
//     over a `Call` over an `ArrayLit` even once the veto was lifted.
//   * ROOT TWO, THE LIST LITERAL'S ELEMENT ROW (D163). `arrLitElemName` names a literal's
//     element from the CHECKER's recorded `TyArray.aElem` whenever the first element is not
//     itself a literal, and that record is a STRUCTURAL shape. `shapeNominalOfTy` resolves one
//     by asking the struct table before the variant table, so with `Dot` declared the row keys
//     `Dot` while the element expression builds `Circle`.
//
// MEASURED PER CANDIDATE on the 2,850-cell D88/D100 grid, against `a19a3db7`: the pin's two
// halves move **0 cells** on their own and **0 cells together** — they change four MESSAGES
// and nothing else, because with the pin firing the list literal still keys the twin's row.
// The element-row fix moves 2. All three together move 6, and the four extra cells are exactly
// the four the pin's halves could only re-message. The union of the singles is 2 and the
// composition is 6: a DIRECTION, not a count.
//
// THE CONTROL THAT NAMED ROOT TWO is in this file as program 3: binding the list to an
// ANNOTATED local first (`const xs: Circle[] = [c]`) always ran, because the source annotation
// gives the CHECKER the element type and the same code path then answers correctly.
//
// IT IS NOT STD-SPECIFIC, AND THAT IS MEASURED — program 2 is the hand-written conduit, nine
// lines and no import. What the conduit has to be is ELEMENT-PRESERVING: a callee whose result
// annotation is spelled exactly as one of its parameters' and whose spelling mentions a type
// parameter, read back with an index.
import { reverse } from "std:array"
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Dot = { r: i32 }

// 1 — THE FORMER SPECIMEN, VERBATIM.
function mk(n: i32): Circle {
  const c = { r: n }
  return reverse([c])[0]
}
print((mk(7)).r)

// 2 — THE HAND-WRITTEN CONDUIT. No import, and the identical failure before the fix: the axis
// is element-preservation, not `std`.
function rv<T>(xs: T[]): T[] { return xs }
function mk2(n: i32): Circle {
  const c2 = { r: n }
  return rv([c2])[0]
}
print((mk2(7)).r)

// 3 — THE CONTROL THAT NAMED ROOT TWO, and it ran before the fix as well: annotating the LIST
// hands the CHECKER the element type, so the structural record it keys from is already right.
// It is here so a future change that re-derives the element row has to keep both routes
// agreeing.
function mk3(n: i32): Circle {
  const c3 = { r: n }
  const xs: Circle[] = [c3]
  return reverse(xs)[0]
}
print((mk3(7)).r)

// 4 — THE MAP-VALUED CONDUIT (silent-class-inventory D163's own witness). The element here is
// a CALL, not an identifier, so the committed rep comes from the callee's parameter annotation
// through its un-annotated result — and the row the literal keys is a kind-3 MAP row rather
// than a kind-1 struct one.
function thru(x: {[string]: Circle}) { return x }
function mk4(n: i32) {
  const c4 = Map()
  c4["k"] = { r: n }
  return reverse([thru(c4)])[0]
}
print(((mk4(7))["k"] ?? { r: 0 }).r)

// 5 — THE DISAGREEMENT GATE, which is the safety property and is measured rather than argued.
// A list literal whose elements commit to DIFFERENT names has no single committed rep, so the
// bank stays empty and the checker-typed union element keeps the literal — the box list, which
// is the right answer. Without this gate `[c5, d5]` keyed the row under the first arm and
// `tests/cases/arrays/inferred-union-element-literal.vl` went from `runs` to
// `emitProgram: unknown variant field in field access`; the corpus `cmp` is what found it.
type Ring = { g: i32 }
type Band = { h: i32 }
type Loop = Ring | Band
const c5: Ring = { g: 7 }
const d5: Band = { h: 7 }
function both() {
  const xs5 = [c5, d5]
  let acc = 0
  for x in xs5 {
    if x is Ring { acc = acc + x.g } else { acc = acc + x.h }
  }
  return acc - 7
}
print(both())
