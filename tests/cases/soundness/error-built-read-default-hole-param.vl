// @check
// @error-at 11:34 a `??` whose default is a parameter or an annotated binding
// VERDICT PIN (must-error): a `??` over a read of a container built wider, defaulted to an
// un-annotated parameter, joins the read with a record no build moves at any pin, so it is
// refused at check until a converting copy of the read exists (D15318, D15241).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const m = Map()
m.set("a", mk())
const wm: {[string]: J} = Map()
wm.set("a", mk())
function pick(d) { (m.get("a") ?? d).f }
print(pick({ f: 1 }))
