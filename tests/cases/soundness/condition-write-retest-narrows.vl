// @run
// @log 3
// @log -2
// @log 4.5
// @log s!
// @log 3
// @log 7
// @log -2
// @log true
// @warning `x != null` is always true here (x is i32)
// @warning `x == null` is always false here (x is f64)

// D2589: a re-test after a write in the condition narrows again, in both halves, for a value
// union read by the arm the condition guards, after an `||` guard, and in a `while` condition.
// D2601: a write in an if-expression arm's prelude ends a narrowing for the code after it.
function reAnd(n: i32) {
  let x: i32 | null = 6
  if x != null && (if n == 1 { x = 3; true } else { true }) && x != null {
    print(x + 0)
  } else {
    print(0 - 2)
  }
}

function reNested(n: i32) {
  let x: i32 | null = 6
  if x != null && ((if n == 1 { x = null; true } else { true }) && x != null) {
    print(x + 0)
  } else {
    print(0 - 2)
  }
}

function reFloat(n: i32) {
  let x: f64 | null = 1.5
  if x == null || (if n == 1 { x = 3.5; false } else { false }) || x == null {
    print(0 - 2)
    return
  }
  print(x + 1.0)
}

function reUnion(n: i32) {
  let x: i32 | string = "q"
  if (
    !(x is string)
    || (if n == 1 { x = "s"; false } else { false })
    || !(x is string)
  ) {
    print(0 - 2)
  } else {
    print(x + "!")
  }
}

function reWhile(n: i32) {
  let x: i32 | null = 6
  let k = 0
  while (
    x != null
    && (if k == n { x = 2; true } else { true })
    && x != null
    && k < 2
  ) {
    k = k + 1
    if k == 2 { print(x + 1) }
  }
}

function prelude(n: i32) {
  let x: i32 | null = 6
  if x != null {
    const b = if n == 1 {
      x = null
      true
    } else {
      false
    }
    if x != null { print(x + 0) } else { print(0 - 2) }
    print(b)
  }
}

reAnd(1)
reNested(1)
reFloat(1)
reUnion(1)
reWhile(1)
reWhile(5)
prelude(1)
