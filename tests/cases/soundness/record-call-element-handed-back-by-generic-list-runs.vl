// @run
// @log 10
// @log 13
// @log true
// @log 20
// @hint Intentionally-unused parameter `_x`
// D14812: a generic handing back an element of a list literal of calls built at a wider record
// relays it, returns it, compares it and stores it at that record.
type Circle = { r: i32 | null }
function sink(_x: Circle) {}
function mkcall() { { r: null } }
function first<T>(xs: T[]): T { xs[0] }
sink(mkcall())
function g() { first([mkcall()]) }
print(g().r ?? 10)
const y = first([mkcall()])
const b = y
print(b.r ?? 13)
print(y == y)
const s = [y]
print(s[0].r ?? 20)
