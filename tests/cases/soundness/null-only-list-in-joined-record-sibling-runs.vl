// A list of only `null` in one record of a list literal, its sibling holding a value there,
// stores the null of the field's element type (D16316).
const w: {z: (i64[] | null)[]}[] = [{ z: [null] }, { z: [[1]] }]
const e = w[1].z[0]
if e != null { print(e[0]) }
print(w[0].z[0] == null)
function f(v: {z: (i32[] | null)[], k: string}[]) {
  const x = v[0].z[0]
  if x != null { print(x[0]) }
  print(v[1].k)
}
f([{ z: [[7]], k: "r" }, { z: [null, null], k: "s" }])
const b: {z: (boolean | null)[]}[] = [{ z: [null] }, { z: [true] }]
print(b[0].z[0] == null)
