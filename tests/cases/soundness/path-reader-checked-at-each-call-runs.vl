// @run
// @log 2
// @log s
// @log 2
// @log 10
// @log 6
// A nested function that reads a narrowed field or cell is checked at each call, as one reading a
// bare name is: a write or a writing call after the call runs, and a re-test before a later call
// lets it run again (D16380).
type O = { v: i32 | string }
const o: O = { v: 1 }
const xs: (i32 | string)[] = [1]
const ys: (i32 | string)[] = [1]
function w() { ys[0] = "t" }
if xs[0] is i32 {
  const c = (): i32 => xs[0] + 1
  print(c())
  xs[0] = "s"
  print(xs[0])
}
if ys[0] is i32 {
  const d = (): i32 => ys[0] + 1
  print(d())
  w()
}
if o.v is i32 {
  const e = (): i32 => o.v + 1
  o.v = "s"
  if o.v is string { o.v = 9 }
  if o.v is i32 { print(e()) }
}
if xs[0] is string {
  xs[0] = 4
  if xs[0] is i32 {
    const f = (): i32 => xs[0] + 1
    xs[0] = 5
    print(f())
  }
}
