// @check
// @error {v: i32} is not D: they store field `v` differently (`i32` into `f64`)
// D3442: an object literal handed through a generic identity is built at the identity's own
// instance, which holds an integer where the destination's flat float field waits; with no
// binding to adopt it is refused, where it was invalid wasm. `const q = { v: 7 }` then `idd(q)`
// adopts and runs.
type D = { v: f64 }
function idd<T>(x: T): T { x }
const d: D = idd({ v: 7 })
print(d.v / 2)
