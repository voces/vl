// @run
// @log 5
// @log 5
// @log 9
// @log 10
// @log 4
// @log 4
// A record literal written into a field of a receiver the record solve built wider than its own
// type is built at the field's stored record (D15820): directly, held in a binding, and nested.
type J = { f: i32 | null }
type K = { j: J | null }
function mk() { { j: { f: 4 } } }
const kk: K = mk()
const y = mk()
y.j = { f: 5 }
print(y.j.f)
const v = { f: 5 }
const w = mk()
w.j = v
print(w.j.f)

type I = { g: i32 | null }
type H = { h: I | null }
type G = { j: H | null }
function mg() { { j: { h: { g: 4 } } } }
const gg: G = mg()
const x = mg()
x.j = { h: { g: 9 } }
print(x.j.h.g)
x.j.h = { g: 10 }
print(x.j.h.g)
print(kk.j?.f ?? 0)
print(gg.j?.h?.g ?? 0)
