// @run
// @log 1.5
// @log 2
// @log true
// @log 7
// @log 3.5
// Q58 position sweep: an operator whose left operand never returns, beside an `f64`, `f32` or `i64`
// one, computed at that operand's width (D17064): the call runs for its effect and diverges, a
// zero standing in its place: an add, a divide, a compare, a `let` and a call's argument.
function fail(): never { __trap__() }
function addF(c: boolean, x: f64) {
  if c { return x }
  return fail() + x
}
function divF32(c: boolean, x: f32) {
  if c { return x }
  return fail() / x
}
function geF(c: boolean, x: f64) {
  if c { return true }
  return fail() >= x
}
function inLet(c: boolean, x: i64) {
  if c { return x }
  const y: i64 = fail() * x
  return y
}
function asArg(c: boolean, x: f64) {
  if c { return x }
  return addF(true, fail() - x)
}
print(addF(true, 1.5))
print(divF32(true, 2.0 as f32))
print(geF(true, 0.5))
print(inLet(true, 7 as i64))
print(asArg(true, 3.5))
