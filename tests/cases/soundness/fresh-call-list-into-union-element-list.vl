// @run
// @log 1.5
// @log 3.5
// A list literal of fresh calls delivered into a `(R | string)[]` builds at the destination's
// union-element list, even when an `R[]` list exists elsewhere in the program (D14494).
type R = { v: f64 }
function mk3() { { v: 7 } }
function main() {
  const ys: R[] = [{ v: 1.5 }]
  print(ys[0].v)
  const xs: (R | string)[] = [mk3(), mk3()]
  const a = xs[1]
  if a is R { print(a.v / 2) }
}
main()
