// @error-at 14:24 this value is built as J where line 9 delivers it, and it is handed on here at its own type, which stores a field differently; a record is shared, not copied, so one value cannot be both. Annotate it with one of the types, and copy it with an object literal for the other
// @error-at 16:24 this value is built as J where line 9 delivers it, and it is handed on here at its own type, which stores a field differently; a record is shared, not copied, so one value cannot be both. Annotate it with one of the types, and copy it with an object literal for the other
// A `??` default calling a maker that hands back a maker an annotated binding builds wider is
// refused at its own type, as the inner maker's own call is, through any depth of relay (D15380).
type J = { f: i32 | null }
function mk2() { { f: 1 } }
function mk4() { mk2() }
const dA: J = mk2()
function mk6() { mk4() }
print(dA.f ?? 0)
print(mk4().f ?? 0)
const m = Map()
m.set("a", { f: 4 })
const b = m.get("z") ?? mk4()
print(b.f)
const c = m.get("y") ?? mk6()
print(c.f)
