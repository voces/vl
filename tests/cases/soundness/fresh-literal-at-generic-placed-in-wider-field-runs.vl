// @run
// @log 2
// @log 5
// @log 4
// @log 2
// @log n
// D15184: a fresh record literal handed to a type parameter that the body places in a field of a
// record literal delivered wider, where that literal is only read or handed to an annotated
// parameter, is built at the field's destination, as D14760 builds one only delivered.
type V = { y: i32, x: i32 | string }
function g<T>(v: T) {
  const o: { c: V } = { c: v }
  o.c.y
}
function two<T>(v: T) {
  const o: { c: V, d: i32 } = { c: v, d: 3 }
  o.c.y + o.d
}
function use(o: { c: V }) { o.c.y }
function viaArg<T>(v: T) { use({ c: v }) }
function readX<T>(v: T) {
  const o: { c: V } = { c: v }
  const x = o.c.x
  if x is string { x } else { "n" }
}
print(g({ y: 2, x: 9 }))
print(two({ y: 2, x: 9 }))
print(g({ y: 4, x: "s" }))
print(viaArg({ y: 2, x: 9 }))
print(readX({ y: 2, x: 9 }))
