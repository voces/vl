// @check
// @error 'v' is no longer narrowed to K[]: the assignment to 'alias[0]' on line 10 may reassign it
// VERDICT PIN (must-error, D4926): an element store through an alias of `v` falsifies the
// element narrowing `v is K[]` exactly as a store through `v` itself would, so the read
// after it is at the declared element type. This program checked clean and printed 5.
type K = 0 | 1
const v: i32[] = [0, 1]
const alias = v
if (v is K[]) {
  alias[0] = 5
  const e: K = v[0]
  print(e)
}
