// @run
// @log false
// @log false
// @log false
// @log true
// @warning `is` check type 'f64[]' can never match a value of type i32[], so this test is always false here
// @warning `is` check type 'f64[]' can never match a value of type i32[], so this test is always false here
// @warning `is` check type 'f64[]' can never match a value of type i32[], so this test is always false here
// A list read through a narrowed nullable, out of a map or from a parameter, keeps the element
// type an annotation or a write fixed, so an empty one does not pass `is f64[]` (DECISIONS "An
// annotation fixes an empty list's element type", D16447). A list nothing fixed still does.
const e: i32[] = []
const m: {[string]: i32[]} = Map()
m["k"] = e
const r = m["k"]
if r != null { print(r is f64[]) }

function viaParam(p: i32[] | null) {
  if p != null { print(p is f64[]) }
}
viaParam(e)

const w: i32[] | null = [1]
if w != null {
  w.pop()
  print(w is f64[])
}

const open = Map()
open["k"] = []
const o = open["k"]
if o != null { print(o is f64[]) }
