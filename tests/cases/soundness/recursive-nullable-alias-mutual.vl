// @run
// @log 6
// @log 10
// @log 5
// @log 7
// @log 6
// Two recursive record aliases spelled with `| null` that name each other, in either declaration
// order and generic: each record is one struct, built, walked and narrowed through the other.
type A = { v: i32, b: B } | null
type B = { w: i32, a: A } | null
let x: A = { v: 1, b: { w: 2, a: { v: 3, b: null } } }
let s = 0
while x != null {
  s = s + x.v
  const y = x.b
  if y == null { break }
  s = s + y.w
  x = y.a
}
print(s)

function sum(x: A) {
  if x == null { return 0 }
  const y = x.b
  if y == null { return x.v }
  return x.v + y.w + sum(y.a)
}
print(sum({ v: 1, b: { w: 2, a: { v: 3, b: { w: 4, a: null } } } }))
const p: B = { w: 5, a: { v: 6, b: null } }
if p != null { print(p.w) }

type W = { n: i32, k: K } | null
type K = { w: W } | null
const k: K = { w: { n: 7, k: null } }
if k != null {
  const w = k.w
  if w != null { print(w.n) }
}

type GA<T> = { v: T, b: GB<T> } | null
type GB<T> = { w: T, a: GA<T> } | null
let g: GA<i32> = { v: 1, b: { w: 2, a: { v: 3, b: null } } }
let t = 0
while g != null {
  t = t + g.v
  const h = g.b
  if h == null { break }
  t = t + h.w
  g = h.a
}
print(t)
