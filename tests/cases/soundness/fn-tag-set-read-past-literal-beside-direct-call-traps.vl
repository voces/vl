// @trap array index out of bounds
// A list's record field holding an un-annotated function, read at two constant indices at two
// types beside a direct call of the function, tags the function's set: each call through the
// field is dispatched at its own signature, and the read past the literal's length traps (D15338).
function id1(a) { return a }
const xs = [{ f: id1 }]
print(xs[0].f(2))
print(xs[1].f(2.5))
print(id1(2.5))
