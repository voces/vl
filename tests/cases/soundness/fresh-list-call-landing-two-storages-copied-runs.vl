// @run
// @log 7
// @log true
// @log 7
// @log true
// @log 1
// @log true
// D14510: a function's fresh list of `null`-field records whose calls land it on two lists that
// store the field differently is built at its own row and copied element by element at each call.
type Circle = { r: i32 | null }
type Tag = { r: string | null }
function sink(x: Circle[]) { print(x[0].r ?? 7) }
function sink2(x: Tag[]) { print(x[0].r == null) }
function sink3(x: readonly Circle[]) { print(x.length) }
function viaBinding() {
  const cc = [{ r: null }]
  return cc
}
function bare() { [{ r: null }] }
sink(viaBinding())
sink2(viaBinding())
sink(bare())
sink2(bare())
sink3(bare())
print(bare()[0].r == null)
