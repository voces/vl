// @run
// @log 5
// @log 4
// @log 6
// @log 8
// @log 4
// @log 9
// A record written through a binding of a call the record solve builds at a wider record, directly,
// from another binding or through a `const` alias, lands in the binding's own copy of the result;
// a scalar field written through one is stored in the shared build (D15246).
type J = { f: i32 | null }
type K = { j: J }
function mk() { { j: { f: 4 } } }
const _k: K = mk()
const y = mk()
y.j = { f: 5 }
print(y.j.f)
print(_k.j.f ?? 0)
const z = mk()
const n = { f: 6 }
z.j = n
print(z.j.f)
const w = mk()
const a = w
a.j = { f: 8 }
print(w.j.f)
const s = mk()
print(s.j.f)
s.j.f = 9
print(s.j.f)
