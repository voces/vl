// @run
// @log -1
// @log 3
// @log 4
// @log 6
// @log 6
// @log 7
// The VARIANT twin of `narrowed-nullable-fn-arg.vl`: a `Circle | null` — where `Circle` is a
// union ARM — narrowed non-null and PASSED AS AN ARGUMENT to a `Circle` parameter.
//
// `Circle | null` is the `nulvariant` NICHE, not a box (a single struct plus `null` has one
// non-null member), so the narrowed value keeps its `(ref null $uVarHeap[vi])` slot while the
// parameter declares the bare `(ref $uVarHeap[vi])`. The variant param position already carried
// a boundary bridge — the union-BOX unbox-and-cast for a boxed argument — but not the
// nullable-NICHE recover, so a narrowed niche argument reached the callee raw: `vl check` rc 0
// with no diagnostic at any severity, engine refuses the module at load.
//
// The `struct` arm of the same ladder has held this recover all along, and `nulvariant` is its
// exact variant-table twin — they are separate kinds only because the heap TABLE differs
// (`sHeapIdx` vs `uVarHeap`), not because the lowering does.
//
// EVERY ARGUMENT HERE IS DELIVERED THROUGH A `Circle | null` BINDING, never as a bare object
// LITERAL. That is deliberate and load-bearing: an object literal in a `nulvariant` ARGUMENT
// position is a separate live defect (it boxes, `struct.new $unionBox`, into a niche slot —
// silent-class inventory row D21), and spelling it here would make this file fail for the
// other reason and hide whichever of the two regressed.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq

function area(sh: Shape) {
  if sh is Circle { return sh.r }
  return 0
}

function radius(c: Circle) { return c.r }

function go(v: Circle | null) {
  if v is Circle { return radius(v) }
  return -1
}

function goBound(v: Circle | null) {
  if v != null {
    const w = v
    return radius(w)
  }
  return -1
}

function goNested(v: Circle | null) {
  if v is Circle { return radius(v) + 1 }
  return -1
}

const c3: Circle | null = { r: 3 }
const c4: Circle | null = { r: 4 }
const c5: Circle | null = { r: 5 }

print(go(null))
print(go(c3))
print(goBound(c4))
print(goNested(c5))
// The BOXED argument the same param position already accepted — kept beside the niche so a
// change to one arm cannot silently take the other with it.
print(area({ r: 6 }))
print(area({ s: 7 }) + 7)
