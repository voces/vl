// @run
// @log none
// @log 6
// @log 1
// A map read of a list of hole functions, bound before a narrowed read whose callback pins them,
// keeps its `| null`: the pin records the list type on each binding it reads through, nullable
// where that binding's own type is, so a missing key takes the `else`.
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
let b2 = [inc0, dbl]
b2 = [dbl]
const m4 = Map()
m4["k"] = [inc0, dbl]
const mv4 = m4["absent"]
if mv4 != null {
  const v4 = mv4
  print(v4.map((f) => f(3))[1])
} else { print("none") }
const mv5 = m4["k"]
if mv5 != null {
  const v5 = mv5
  print(v5.map((f) => f(3))[1])
} else { print("none") }
print(b2.length)
