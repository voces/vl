// A maker's fresh list of nullable records, spread beside a wider record part, is copied into the
// list's element, each null kept (D16613): beside a literal, beside a held part, and delivered
// whole at an annotated wider list from a maker called twice (D16616).
function mk() { return [{ x: 1 }, null] }
const v = [...mk(), { x: 2.5 }]
print((v[0] ?? { x: 0.0 }).x + 0.25)
print(v[1] == null)
print(v.length)
const a: { x: f64 } | null = { x: 2.5 }
const w = [a, ...mk()]
print((w[1] ?? { x: 0.0 }).x + 0.25)
print(w[2] == null)
const u: ({ x: f64 } | null)[] = mk()
print((u[0] ?? { x: 0.0 }).x + 0.25)
print(u[1] == null)
