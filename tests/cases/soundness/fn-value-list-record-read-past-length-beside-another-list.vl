// @log 2
// @trap array index out of bounds
// A list's record field holding an un-annotated function, read at two constant indices at two
// types beside another such list read at `f64`: the set is tagged, so the module validates, the
// in-bounds read prints, and the read past the literal's length traps (D15338).
function id1(a) { return a }
const xs = [{ f: id1 }]
print(xs[0].f(2))
print(xs[1].f(2.5))
const ys = [{ f: id1 }]
print(ys[0].f(2.5))
