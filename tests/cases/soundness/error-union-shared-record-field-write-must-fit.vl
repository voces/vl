// @check
// @error-at 9:0 cannot assign null to `f` through a union
// VERDICT PIN (must-error): a write through a nested field of a union of records must fit every
// member, as the flat write must, since one member stores the field as `i32` (D15314).
type H = { f: i32 | null }
type K = { h: { f: i32 } }
type J = { h: H }
const k: K = { h: { f: 4 } }
const u: K | J = k
u.h.f = null
print(u.h.f ?? 0)
