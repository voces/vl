// @run
// @log 5
// @log 6
// @log 7
// @log 8
// @log 1
// @log 4
// @log 1
// @log 5
// @log 10
// D8620: a record literal handed to an un-annotated parameter whose body reads its field keeps
// its own storage when a declared record of its field names boxes that field. The hole's read,
// a second field, a declared row used beside it, `is` of that record on the literal's own row,
// one the body never reads keeping the declared row, a union member of the declared record,
// and the literal handed over through an un-annotated binding.
type J = { f: i32 | null }
type JG = { f: i32 | null, g: string }
type N = { r: i32 | null }
const u: J | string = "x"
function rd(r) { return r.f + 1 }
function rd2(r) { return r.f + r.g.length }
function take(a) { return a.r + 1 }
function guard(v) {
  if v is N {
    print(v.r ?? 0)
    return
  }
  print(0)
}
function whole(v) {
  if v is N { print(1) } else { print(0) }
}
print(rd({ f: 4 }))
print(rd2({ f: 4, g: "ab" }))
const o: N = { r: 1 }
print(take({ r: 6 }))
print(take({ r: 7 }))
print(o.r ?? 0)
guard({ r: 4 })
whole({ r: 2 })
print(if u is J { 0 } else { rd({ f: 4 }) })
const o2 = { f: 9 }
print(rd(o2))
