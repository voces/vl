// @run
// @log 4
// @log 7
// @log 4
// @log 4
// @log 4
// An element of a list literal whose records its parts built at a wider record is read at that
// build, where a binding of it is reassigned or a literal is pushed into the list (D15232).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const wideJ: J = mk()
const c = wideJ.f == 4
const xs = [{ a: mk() }]
let b = xs[0]
b = { a: xs[0].a }
print(b.a.f ?? 0)
let d = xs[0]
d = { a: { f: 7 } }
print(d.a.f ?? 0)
let e = xs[0]
e = if c { { a: xs[0].a } } else { { a: { f: 1 } } }
print(e.a.f ?? 0)
xs.push({ a: xs[0].a })
print(xs[1].a.f ?? 0)
print(wideJ.f ?? 0)
