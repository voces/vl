// @check
// @error-at 44:10 operator '+' is not defined for i32 | string and i32 — 'o.v' is no longer narrowed to i32: the call to 'rec' on line 44 may reassign it; re-test 'o.v' after the call
// @error-at 48:10 operator '+' is not defined for i32 | string and i32 — 'o.v' is no longer narrowed to i32: the call to 'a' on line 48 may reassign it; re-test 'o.v' after the call
// @error-at 54:10 operator '+' is not defined for i32 | string and i32 — 'o.v' is no longer narrowed to i32: the call to 'swap' on line 54 may reassign it; re-test 'o.v' after the call

// D2472: a recursive edge may hand a different function value into the slot the cycle calls, so
// every function value a call inside a recursion cycle passes on is charged to the cycle. Line
// and column are 0-based.

type O = { v: i32 | string }
function wr(x: O) { x.v = "s" }
function pure(x: O) { print(x.v is i32) }

// The recursive edge hands a writer into the slot the base case calls.
function rec(x: O, n: i32, f: (O) => void) {
  if n == 0 {
    f(x)
    return
  }
  rec(x, n - 1, wr)
}

// Mutual recursion swaps the two slots.
function a(x: O, n: i32, f: (O) => void, g: (O) => void) {
  if n == 0 {
    f(x)
    return
  }
  b(x, n - 1, g, f)
}
function b(x: O, n: i32, f: (O) => void, g: (O) => void) { a(x, n, f, g) }

// Self-recursion swaps them.
function swap(x: O, n: i32, f: (O) => void, g: (O) => void) {
  if n == 0 {
    f(x)
    return
  }
  swap(x, n - 1, g, f)
}

function main(o: O) {
  if o.v is i32 {
    rec(o, 1, pure)
    print(o.v + 1)
  }
  if o.v is i32 {
    a(o, 1, pure, wr)
    print(o.v + 1)
  }
  if o.v is i32 {
    swap(o, 1, pure, (x: O): void => {
      x.v = "s"
    })
    print(o.v + 1)
  }
}
main({ v: 1 })
