// @run
// @log "hi"
// @log <value>
// CONTRACT (must-RUN): D932's tail-position twin. The same statically-false arm with a
// narrowed use, but the `if` is the function's LAST statement, so it lowers through
// `emitIfTail` / `emitStmtsTail` rather than `emitIfStmtStmt` — a separate emitter that
// needed the same dead-arm skip and the same `emitLetCursor` accounting.
function show(v): string {
  if v is string { return "\"" + v + "\"" } else { return "<value>" }
}

print(show("hi"))
print(show(5))
