// @no-instantiate found struct.get of type i32
// ACCEPTS, THEN MISCOMPILES. An ATOM arm of an if-expression joining into `string | null`. The
// join yields the raw i32 atom id where the binding's slot is a nullable string reference:
// `expected (ref null $type), found i32`, with `vl check --codegen` rc 0.
//
// THE TWO NEIGHBOURS WORK, which is what makes this narrow:
//
//   const s: string        = if b { r.f } else { "z" }    // OK — the `str` join widens
//   const s: string | null = if b { "z" } else { null }   // OK — no atom involved
//   const s: string | null = if b { r.f } else { "z" }    // MISCOMPILES — this file
//
// So it is neither "if-expressions cannot widen atoms" nor "nullable joins are broken"; it is
// the two together.
//
// THE OBVIOUS FIX WAS WRITTEN AND IS WRONG. `emitIfArm` widens an atom when the join kind is
// `str`; admitting `nulstr` beside it changes NOTHING — measured at 0 corpus rows and 0 of the
// constructed shapes, this file included. So the join kind for a nullable-string if-expression
// is neither `str` nor `nulstr`, and the site that decides it has not been identified. Pinned
// rather than guessed at.
//
// Filed alongside three sibling positions that WERE closed
// (tests/cases/literal-unions/litunion-atom-into-nullable-string-positions.vl); severity here is
// unchanged by that change — identical error before and after.
type K = "ka" | "kb"
type R = { f: K }
function pick(b: boolean, r: R) {
  const s: string | null = if b { r.f } else { "z" }
  if s != null { print(s) }
}
function main() { pick(true, { f: "kb" }) }
main()
