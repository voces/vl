// @run
// @log 5
// @log 6
// The value positions inside a bare block in tail position are the body's, all the way down: a
// block ending in an `if`/`else` whose arms each yield a value returns that value (D3477).
function k(c: boolean): i32 {
  {
    if c { 5 } else { 6 }
  }
}
print(k(true))
print(k(false))
