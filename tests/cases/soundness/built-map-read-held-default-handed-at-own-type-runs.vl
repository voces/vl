// @run
// @log 5
// A maker called more than once keeps its own record; its call is copied where it lands wider.
// A `const` used as a `??` default over a map read of a maker's calls, also handed on at its own
// type, runs (D15217).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const m = Map()
m.set("a", mk())
const wm: {[string]: J} = Map()
wm.set("a", mk())
function use(v: { f: i32 }) { v.f }
const d = { f: 1 }
const b = m.get("a") ?? d
print(b.f + use(d))
