// @run
// @log 5
// @log 5
// @log 5
// @log 5
// @log 5
// @log 5
// @log 5
// @log 5
// @log 5.5
// @log 5.5
// @log 1
// @log 1
// @log aa
// @log aa
// @log 3
// @log 3
// @log 2
// @log 2
// CONTRACT (must-RUN): `x ?? d` where a narrowing already proves `x` non-null. Each leg
// prints the coalesce and then the SAME value read WITHOUT the `??` — the twin is the
// assertion, because a lowering that reads the wrong rep cannot agree with the plain read
// of the same binding at the same point.
//
// EVERY BOXED-REP LEG IS `vl check` rc 0 AND INVALID WASM before this change: the niche
// arms of `emitCoalesce` evaluate the LHS at the DECLARED nullable rep (the box's tag is
// read off it) while `emitIdentNode` reads a narrowed binding at the ARM's rep, so the
// operand and the arm disagree —
// `Invalid input WebAssembly code: type mismatch: expected (ref null $type), found i32`.
//
// THE NARROWING ORIGIN IS NOT THE ROOT, and that is why all three spellings are here. The
// defect was filed against an ASSIGNMENT narrowing with no guard in the program; the
// `!= null` and `is T` guards reach the identical module with nothing written at all. A fix
// keyed on the assignment kind would leave two thirds of this file red.

function mk5(k: i32) {
  if k > 0 { return 5 }
  null
}

// ── assignment narrowing, no guard anywhere: the filed spelling ────────────────
function asgI32() {
  let x: i32 | null = null
  x = 5
  print(x ?? 0)
  print(x)
}

// ── the `!= null` guard: no write in the program ───────────────────────────────
function guardI32(p: i32 | null) {
  if p != null {
    print(p ?? 0)
    print(p)
  }
}

// ── the `is T` guard: the third spelling of the same narrowing ─────────────────
function isGuardI32(p: i32 | null) {
  if p is i32 {
    print(p ?? 0)
    print(p)
  }
}

// ── the other boxed scalar widths ──────────────────────────────────────────────
function asgI64() {
  let x: i64 | null = null
  x = 5
  print(x ?? 0)
  print(x)
}

function asgF64() {
  let x: f64 | null = null
  x = 5.5
  print(x ?? 0.5)
  print(x)
}

// A NUMERIC litunion is a box whose payload is the base scalar, and its `??` read was
// invalid for the same reason.
type N = 1 | 2

function asgNumLitUnion() {
  const v: N = 1
  let x: N | null = null
  x = v
  print(x ?? 2)
  print(x)
}

// A STRING litunion is the i32 atom-id niche, not a box — a different rep reaching the
// same disagreement through the assignment narrowing.
type K = "aa" | "bb"

function asgStrLitUnion() {
  const v: K = "aa"
  let x: K | null = null
  x = v
  print(x ?? "bb")
  print(x)
}

// The REF niches (`S | null`, `i32[] | null`) already lowered — `br_on_non_null` accepts a
// non-null operand — so these two legs pin that the dead-default lowering computes the
// same value they did, rather than a change of answer.
type S = { n: i32 }

function asgStruct() {
  const v = { n: 3 }
  let x: S | null = null
  x = v
  print((x ?? { n: 9 }).n)
  print(x.n)
}

function asgList() {
  const v = [1, 2]
  let x: i32[] | null = null
  x = v
  print((x ?? [9]).length)
  print(x.length)
}

asgI32()
guardI32(mk5(1))
isGuardI32(mk5(1))
asgI64()
asgF64()
asgNumLitUnion()
asgStrLitUnion()
asgStruct()
asgList()
