// @run
// @log false
// @log true
// @log false
// @log 4
// @log 1
// @log 7
// D4040: a declared union whose member is a nullable-record alias has that alias's record and
// `null` as its arms, as the flat spelling does, so the alias's value is boxed where it lands.
type A = { x: i32 } | null
type U = A | { tag: i32 }
const a: A = { x: 4 }
const u: U = a
print(u == null)
const n: A = null
const un: U = n
print(un == null)
function f(v: A): U { return v }
print(f({ x: 3 }) == null)
if u is { tag: i32 } { print(u.tag) }
else if u == null { print(0) }
else { print(u.x) }
let w: U = { tag: 2 }
w = { x: 1 }
if w is { x: i32 } { print(w.x) } else { print(0) }
const t: U = { tag: 7 }
if t is { tag: i32 } { print(t.tag) } else { print(0) }
