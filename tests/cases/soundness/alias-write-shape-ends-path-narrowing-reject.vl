// @check
// @error-at 25:14 member access '.length' on non-object string | null — 'o.v' is no longer narrowed to string: the call to 'h' on line 25 may reassign it; re-test 'o.v' after the call
// @error-at 37:14 member access '.length' on non-object string | null — 'o.v' is no longer narrowed to string: the call to 'h' on line 37 may reassign it; re-test 'o.v' after the call
// @error-at 47:14 member access '.length' on non-object string | null — 'o.v' is no longer narrowed to string: the call to 'h' on line 47 may reassign it; re-test 'o.v' after the call
// @error-at 55:14 member access '.length' on non-object string | null — 'o.v' is no longer narrowed to string: the call to 'clr' on line 55 may reassign it; re-test 'o.v' after the call
// @error-at 67:14 member access '.length' on non-object string | null — 'o.v' is no longer narrowed to string: the call to 'h' on line 67 may reassign it; re-test 'o.v' after the call
// @error-at 77:14 member access '.length' on non-object string | null — 'o.v' is no longer narrowed to string: the call to 'clrQ' on line 77 may reassign it; re-test 'o.v' after the call
// @error-at 86:14 member access '.length' on non-object string | null — 'o.v' is no longer narrowed to string: the call to 'clrB' on line 86 may reassign it; re-test 'o.v' after the call
// @error-at 98:14 member access '.length' on non-object string | null — 'o.v' is no longer narrowed to string: the call to 'clrAliased' on line 98 may reassign it; re-test 'o.v' after the call
// @error-at 110:14 member access '.length' on non-object string | null — 'o.v' is no longer narrowed to string: the call to 'map' on line 110 may reassign it; re-test 'o.v' after the call
// @error-at 119:16 member access '.length' on non-object string | null — 'xs[0]' is no longer narrowed to string: the call to 'clear' on line 118 may reassign it; re-test 'xs[0]' after the call

// D2461: a call ends a path narrowing when it may write the path through any alias of an object on
// it — the argument or receiver it is handed, a local copy, a second parameter, a list holding it,
// a module binding, a field of another argument — since a callee's writes are summarised by the
// field or cell they replace, not by the name they are spelled through. Line and column are 0-based.
type O = { v: string | null }
type B = { o: O }
function clr(o: O) { o.v = null }

// A nested function hands the captured object to a writer.
function viaArgument(o: O) {
  function h() { clr(o) }
  if o.v != null {
    h()
    print(o.v.length)
  }
}

// A method receiver.
function clear(self: O) { self.v = null }
function viaReceiver(o: O) {
  const h = () => {
    o.clear()
  }
  if o.v != null {
    h()
    print(o.v.length)
  }
}

// A local alias written by a nested function.
function viaLocalAlias(o: O) {
  const p = o
  function h() { p.v = null }
  if o.v != null {
    h()
    print(o.v.length)
  }
}

// A second parameter the caller may bind to the same object.
function viaSecondParam(o: O, p: O) {
  if o.v != null {
    clr(p)
    print(o.v.length)
  }
}

// A list holding the object.
function viaList(o: O) {
  const os = [o]
  const h = () => {
    os[0].v = null
  }
  if o.v != null {
    h()
    print(o.v.length)
  }
}

// A module binding the narrowed parameter may be.
const q: O = { v: "abc" }
function clrQ() { q.v = null }
function viaModule(o: O) {
  if o.v != null {
    clrQ()
    print(o.v.length)
  }
}

// A field of another argument.
function clrB(b: B) { b.o.v = null }
function viaField(o: O, b: B) {
  if o.v != null {
    clrB(b)
    print(o.v.length)
  }
}

// A callee's own local alias of its parameter.
function clrAliased(o: O) {
  const p = o
  p.v = null
}
function viaCalleeAlias(o: O) {
  if o.v != null {
    clrAliased(o)
    print(o.v.length)
  }
}

// A named writer handed to `map`, which runs it.
function viaMap(o: O, xs: i32[]) {
  const w = (x: i32): i32 => {
    o.v = null
    x
  }
  if o.v != null {
    print(xs.map(w).length)
    print(o.v.length)
  }
}

// A list's cells emptied and refilled through a second parameter.
function viaListAlias(xs: (string | null)[], ys: (string | null)[]) {
  if xs[0] != null {
    ys.clear()
    ys.push(null)
    print(xs[0].length)
  }
}

const o: O = { v: "abc" }
viaArgument(o)
viaReceiver(o)
viaLocalAlias(o)
viaSecondParam(o, o)
viaList(o)
viaModule(q)
viaField(o, { o: o })
viaCalleeAlias(o)
viaMap(o, [1])
const xs: (string | null)[] = ["abc"]
viaListAlias(xs, xs)
