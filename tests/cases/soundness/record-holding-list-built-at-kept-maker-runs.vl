// @run
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// @log 2
// @log 1
// A record or list literal holding a list binding whose stores build its elements at a kept
// maker's record is built where that list is (D15690).
type J = { f: i32 | null }
function mk2() { { f: 1 } }
const dA: J = mk2()
print(dA.f ?? 0)
const xs = [mk2()]
const r = { ys: xs }
print(r.ys[0].f ?? 0)
const bs = [mk2()]
bs[0] = mk2()
const q = { ys: bs, n: 1 }
print(q.ys[0].f ?? 0)
print(q.n)
const ps = [mk2()]
ps.push(mk2())
const p = { ys: ps }
const zs = p.ys
print(zs[1].f ?? 0)
print(p.ys.length)
const ws = [xs]
print(ws[0][0].f ?? 0)
