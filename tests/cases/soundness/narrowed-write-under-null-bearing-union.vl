// @run
// @log 10
// @log 6
// @log 1
// @hint redundant type annotation: `x` is inferred as `i32 | string | null`
// D2612. Over a null-bearing value union, a write under a guard that narrowed to one member
// keeps what the checker says it holds: the emitter no longer widens the binding to every
// non-null member after the write, and a write under a narrowing that still admits `null`
// re-narrows to the member stored rather than to the declaration minus `null`.
function useI(v: i32) { print(v + 1) }
function src(): i32 | string | null { return 7 }
function srcN(): i32 | string | null { return null }
function keep() {
  let x: i32 | string | null = src()
  if x is i32 {
    x = 9
    useI(x)
  }
}
function notIsOther() {
  let x: i32 | string | null = srcN()
  if !(x is i32) { x = 5; print(x + 1) }
}
function notIsSame() {
  let x: i32 | string | null = srcN()
  if !(x is i32) { x = "q"; print(x.length) }
}
keep()
notIsOther()
notIsSame()
