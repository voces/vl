// @run
// @log 7
// @log 7
// @log 7
// @log 7
// A binding of a call built where its number is held wider and boxed (`i64 | null`, `f64 | null`)
// reads its field back at its own `i32` by unboxing and converting, with no box rebuilt (D15716).
type J = { f: i64 | null }
type F = { f: f64 | null }
function mk2() { { f: 7 } }
function mk3() { { f: 7 } }
const o = mk2()
const d: J = o
print(o.f)
print(d.f ?? 0)
const p = mk3()
const e: F = p
print(e.f ?? 0)
print(p.f)
