// @run
// @log 7
// @log 9
// @log 4
// A list of record lists spread into a list of lists built at a wider record is built at the inner
// lists' record (D15285).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const wideJ: J = mk()
const zs = [[mk()]]
zs.push(...[[{ f: 7 }]])
print(zs[1][0].f ?? 0)
zs.push(...[[{ f: 5 }, { f: 9 }]])
print(zs[2][1].f ?? 0)
print(wideJ.f ?? 0)
