// @check
// @error-at 14:5 {r: null}[] is not Circle[]: a container never widens implicitly
// @error-at 15:6 {r: null}[] is not Tag[]: a container never widens implicitly
// @error-at 16:5 {r: null}[] is not Circle[]: a container never widens implicitly
// @error-at 17:6 {r: null}[] is not Tag[]: a container never widens implicitly
// D14510: one function body builds one list, so a fresh call whose calls land it on two lists
// that store a field differently is refused at each delivery, as a record is (D8301).
type Circle = { r: i32 | null }
type Tag = { r: string | null }
function sink(_x: Circle[]) {}
function sink2(_x: Tag[]) {}
function viaBinding() { const cc = [{ r: null }]; return cc }
function bare() { [{ r: null }] }

sink(viaBinding())
sink2(viaBinding())
sink(bare())
sink2(bare())
print(1)
