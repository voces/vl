// @run
// @log 12
// @log 1
// @log 9
// @log 1
// @hint Intentionally-unused parameter `_x`
// D14813: a list literal of calls handed to a generic that hands the list back, its only call, is
// built at the record another delivery builds the calls at, where the result is only measured or
// indexed for a field.
type Circle = { r: i32 | null }
function sink(_x: Circle) {}
function mkcall() { { r: null } }
sink(mkcall())
function keep<T>(xs: T[]): T[] { xs }
const k = keep([mkcall()])
print(k[0].r ?? 12)
function same<T>(xs: T[]): T[] { xs }
print(same([mkcall()]).length)
function pass<T>(xs: T[]): T[] { xs }
const p = pass([mkcall()])
print(p[0].r ?? 9)
print(p.length)
