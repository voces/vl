// @run
// @log -1
// @log 5
// @log 7
// @log 9
// A NULLABLE function value, narrowed non-null with `is`, then PASSED AS AN ARGUMENT.
//
// The narrow is TYPE-LEVEL ONLY: the value keeps its `(ref null $cloStruct)` slot while a
// `(i32, i32) => i32` parameter declares the non-null `(ref $cloStruct)`. Calling the narrowed
// value IN PLACE needs no coercion (`emitCallRef` recovers on its own), so only the
// pass-through was affected — and it was the worst class, `vl check` rc 0 with no diagnostic at
// any severity while the engine refused the module at load.
//
// The recover belongs to the call-argument boundary's non-null ladder, beside the `struct` and
// list/map arms that already held it; `closure` and `variant` were the two reps that ladder had
// never learned. It sits under the guard the checker proved, so it cannot trap.
//
// THE SHAPE IS ORDINARY — an optional callback, narrowed, forwarded. `std/array.vl`'s
// callback-DELIVERY paragraph is the caller-facing statement this pins; its four std spellings
// live in `tests/cases/std/narrowed-nullable-comparator-delivery.vl`.
function applyTo(xs: i32[], f: (i32, i32) => i32) { return f(xs[0], xs[1]) }

function add(a: i32, b: i32) { return a + b }

function go(xs: i32[], g: ((i32, i32) => i32) | null) {
  if g is (i32, i32) => i32 { return applyTo(xs, g) }
  return -1
}

// A binding between the narrow and the argument, and a `!= null` narrow: the same recover,
// reached from the other two spellings that produce a narrowed nullable-closure operand.
function goBound(xs: i32[], g: ((i32, i32) => i32) | null) {
  if g != null {
    const h = g
    return applyTo(xs, h)
  }
  return -1
}

// The narrowed value as an argument to a call that is ITSELF an argument — the arg spine
// clears its pending context per position, so the inner recover must survive the nesting.
function goNested(xs: i32[], g: ((i32, i32) => i32) | null) {
  if g is (i32, i32) => i32 { return applyTo(xs, g) + 1 }
  return -1
}

print(go([2, 4], null))
print(go([2, 3], add))
print(goBound([3, 4], add))
print(goNested([3, 5], add))
