// @check
// @error this field read holds a J, as the record it is read from is built wider than its own type
// A field read off a literal's binding the record solve builds wider holds the field's stored
// record, so it is judged there as a call's is: annotated at its own type it is refused (D15827).
type J = { f: i32 | null }
type K = { j: J }
const y = { j: { f: 4 } }
const ks: K[] = [y]
print(ks.length)
const w: { f: i32 } = y.j
print(w.f)
