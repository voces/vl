// @check
// @error-at 19:10 {f: i32} is not J: they store field `f` differently
// @error-at 20:8 {a: {f: i32}} is not {a: J}: they store field `a` differently
// @error-at 21:8 {f: i32} is not J: they store field `f` differently
// @error-at 22:9 {f: i32} is not J: they store field `f` differently
// @error-at 23:8 {f: i32} is not J: they store field `f` differently
// VERDICT PIN (must-error), no `@log` form: the diagnostic IS the observable.
// A container its stores build at `J` hands a value on at its own type: one value cannot be
// stored both ways, so each such read refuses (D14519).
type J = { f: i32 | null }
function mk() { { f: 4 } }
function g(r: { f: i32 }) { r.f * 10 }
function h(o: { a: { f: i32 } }) { o.a.f * 3 }
function hs(o: { f: i32 }[]) { o[0].f * 3 }
const wideJ: J = mk()
const w = { a: mk() }
const xs = [mk()]
const m = Map()
m.set(1, mk())
print(g(w.a))
print(h(w))
print(g(xs[0]))
print(hs(xs))
print(g(m.get(1) ?? { f: 0 }))
print(wideJ.f ?? 0)
