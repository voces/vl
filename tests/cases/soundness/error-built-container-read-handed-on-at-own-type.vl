// @check
// @error-at 19:10 this {f: i32} is stored at J, the row the stores into its container build; handing it on as {f: i32} is type-valid but not supported yet
// @error-at 20:8 this {a: {f: i32}} is stored at {a: J}, the row the stores into its container build; handing it on as {a: {f: i32}} is type-valid but not supported yet
// @error-at 21:8 this {f: i32} is stored at J, the row the stores into its container build; handing it on as {f: i32} is type-valid but not supported yet
// @error-at 22:9 this container's {f: i32} elements are stored at J, the row its stores build; handing it on as {f: i32}[] is type-valid but not supported yet
// @error-at 23:8 this {f: i32} is stored at J, the row the stores into its container build; handing it on as {f: i32} is type-valid but not supported yet
// VERDICT PIN (must-error), no `@log` form: the diagnostic IS the observable.
// A container its stores build at `J` hands a value on at its own type. Each read is type-valid
// and refuses until a converting delivery exists (D14532).
type J = { f: i32 | null }
function mk() { { f: 4 } }
function g(r: { f: i32 }) { r.f * 10 }
function h(o: { a: { f: i32 } }) { o.a.f * 3 }
function hs(o: { f: i32 }[]) { o[0].f * 3 }
const wideJ: J = mk()
const w = { a: mk() }
const xs = [mk()]
const m = Map()
m.set(1, mk())
print(g(w.a))
print(h(w))
print(g(xs[0]))
print(hs(xs))
print(g(m.get(1) ?? { f: 0 }))
print(wideJ.f ?? 0)
