// @run
// @log -3.5
// @log -3.5
// @log -3.5
// @log -3
// @log 3.5
// @log -21
// D14485: a negated number literal in a function's returned object literal is a literal, as
// the bare one is, when the call is built at the record it is delivered to.
type F = { v: f32 }
type N = { p: { v: f32 } }
type L = { v: i64 }
function take(x: F) { print(x.v / 2) }

function d1() { return { v: -7 } }
const w1: F = d1()
print(w1.v / 2)

function d2() { return { p: { v: -7 } } }
const w2: N = d2()
print(w2.p.v / 2)

function d3() { return { v: -7 } }
take(d3())

function d4() { return { v: -1.5 } }
const w4: F = d4()
print(w4.v * 2)

function d5() { return { v: -(-7) } }
const w5: F = d5()
print(w5.v / 2)

function d6() { return { v: -7 } }
const w6: L = d6()
print(w6.v * 3)
