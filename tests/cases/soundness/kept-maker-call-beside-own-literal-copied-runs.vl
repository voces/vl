// @run
// @log null
// @log null
// @log null
// @log null
// @log 0
// D15932: a maker of a `null`-field record built at a wider record for one use, joined in an
// `if` or `match` or listed beside a part built at its own row, is copied into that row.
type J = { f: i32 | null }
function mk2() { { f: null } }
const dA: J = mk2()
const go = [1].length > 0
const a = if go { mk2() } else { { f: null } }
print(a.f)
const n = 2
const b = match n {
  1 => { f: null }
  _ => mk2()
}
print(b.f)
const xs = [{ f: null }]
const ys = [...xs, mk2()]
print(ys[1].f)
const zs: { f: null }[] = [{ f: null }]
const ws = [...zs, mk2()]
print(ws[1].f)
print(dA.f ?? 0)
