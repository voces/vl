// @run
// @log 2
// @log 9
// @log 5
// A binding annotated at the narrow record and handed to the same parameter is built at the
// wider rep it takes, beside the handed-back literal (D15373).
type V = { y: i32, x: i32 | string }
function k(v: V) { v.y }
function back<T>(v: T): T {
  k(v)
  v
}
function f(q: { y: i32, x: i32 }) { q.x }
print(back({ y: 2, x: 9 }).y)
print(f(back({ y: 2, x: 9 })))
const q: { y: i32, x: i32 } = { y: 4, x: 5 }
print(f(q))
