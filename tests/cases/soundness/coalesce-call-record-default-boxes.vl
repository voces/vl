// @run
// @log 1
// @log 7
// @log 7
// @log s
// @log 7
// @log true
// A `??` whose operand is a call returning a value union with a record member and `null` boxes a
// record default into that union: a record binding or parameter was delivered bare into the box,
// and the module failed to validate (D3488).
type Rec = { x: i32 }
const b: Rec = { x: 7 }
function mk(): Rec { return { x: 7 } }
function g(k: i32): Rec | i32 | null {
  if k == 1 { return 1 }
  return null
}
function h(k: i32): Rec | string | null {
  if k == 1 { return "s" }
  return null
}
const c1 = g(1) ?? b
if c1 is i32 { print(c1) }
const c2 = g(2) ?? b
if c2 is Rec { print(c2.x) }
const c3 = g(2) ?? mk()
if c3 is Rec { print(c3.x) }
const c4 = h(1) ?? b
if c4 is string { print(c4) }
function viaParam(d: Rec) {
  const c = h(2) ?? d
  if c is Rec { print(c.x) }
}
viaParam(b)
function two<A, B>(k: i32, a: A, x: B) {
  if k == 0 { a }
  else if k == 1 { x }
  else { null }
}
const c5 = two(1, b, 1) ?? b
print(c5 is i32)
