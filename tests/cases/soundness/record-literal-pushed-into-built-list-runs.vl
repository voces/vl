// @run
// @log 8
// @log 8
// @log 9
// @log 8
// @log 3
// @log 4
// A record literal pushed, spread or index-stored into a list whose elements are built at a wider
// record is built at that record, through the list's own binding or an alias of it (D15235).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const wideJ: J = mk()
const xs = [mk()]
xs.push({ f: 8 })
print(xs[1].f)
const b = xs
b.push({ f: 8 })
print(b[2].f)
xs[0] = { f: 9 }
print(xs[0].f)
xs.push(...[{ f: 8 }])
print(xs[3].f)
function g() {
  const ys = [mk()]
  ys.push({ f: 3 })
  ys[1].f
}
print(g())
print(wideJ.f ?? 0)
