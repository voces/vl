// @check
// @error-at 9:11 set: expected {f: i32}, got J (`o` holds only a literal, so it is built as the `J` it is delivered to; annotate it to keep its own type, and copy it for the other use)
// A literal binding a `J[]` builds at `J`, stored into a map whose earlier literal store holds its
// own row, would be held at two storages, so the store is refused (D15718).
type J = { f: i32 | null }
const o = { f: 4 }
const wideJ: J[] = [o]
const m = Map()
m.set("b", { f: 5 })
m.set("a", o)
print(m.get("b")?.f ?? 0)
print(wideJ[0].f ?? 0)
