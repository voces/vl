// @run
// @log 0
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// D14504: a `null` field lands on a nullable storage, so a fresh call delivered as `Circle`
// once and read in place once is built at `Circle`.
type Circle = { r: i32 | null }
function sink(_x: Circle) {}
function mkcall() {
  const cc = { r: null }
  return cc
}
sink(mkcall())
const dd = mkcall()
if dd.r != null { print(7) } else { print(0) }
