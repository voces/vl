// @run
// @log 2
// @log 2.5
// @log 3
// @log 0.5
// @log 4
// @log true
// Unary `-` and `~` over a call that never returns are `never`, as a binary operator over one is
// (D17067, D14420): the path ends at the call, and the live path runs.
function fail(): never { __trap__() }
function neg(c: boolean, x: i32) {
  if c { return x }
  return -fail()
}
function negw(c: boolean, x: f64) {
  if c { return x }
  return -fail()
}
function inv(c: boolean, x: i32) {
  if c { return x }
  return ~fail()
}
function bound(c: boolean) {
  if c { return 0.5 }
  const y: f64 = -fail()
  return y
}
function sum(c: boolean, x: i32) {
  if c { return x }
  return -fail() + x
}
function nt(c: boolean) {
  if c { return true }
  return !fail()
}
print(neg(true, 2))
print(negw(true, 2.5))
print(inv(true, 3))
print(bound(true))
print(sum(true, 4))
print(nt(true))
