// @log 7
// @hint Intentionally-unused parameter `_x`
// @hint Intentionally-unused parameter `_b`
// D15181: a list or record literal holding a record built at a wider row than its own type is
// built at that row, here where a declared type spells the record's own shape, and a generic
// handed it is instanced there.
type Circle = { r: i32 | null }
type K = { r: null }
function sink(_x: Circle) {}
function mkcall() { { r: null } }
const c = mkcall()
sink(c)
const cw: Circle = { r: 3 }
const ys = { f: c }
const zs = [[c]]
print(ys.f.r ?? 6)
print(zs[0][0].r ?? 6)
print([[c]].length)
function first<T>(_b: T, a: T[]): T { a[0] }
function field<T>(_b: T, a: { f: T }): T { a.f }
function only<T>(a: T[]): T { a[0] }
print(field(cw, { f: c }).r ?? 8)
print(only<Circle>([c]).r ?? 8)
print(first(cw, [c]).r ?? 7)
