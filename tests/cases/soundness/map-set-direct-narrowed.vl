// @run
// @log -1
// @hint redundant type annotation: `f` is inferred as `i32`
// A map's `set` of the narrowed key, called directly, ends the narrowing, so the re-test reads
// the string it stored.
function f(m: {[string]: string | i32}): i32 {
  if m["a"] is i32 {
    m.set("a", "s")
    const x = m["a"]
    if x is i32 { return x + 1 }
    return -1
  }
  0
}
const m: {[string]: string | i32} = Map()
m["a"] = 3
print(f(m))
