// @run
// @log 6
// @log 3
// @log 12
// D8200: `T | L` at `T := K`, both numeric literal sets, is one flat numeric set. Built as a
// union of two sets it was invalid wasm. `T := i32` keeps the union.
type K = 1 | 2
type L = 3 | 4
function l<T>(x: T, o: L): (T | L)[] { return [x, o] }

const a: K = 2
const w: (K | L)[] = l(a, 4)
print(w[0] + w[1])
const u = l(a, 3)
print(u[1])
const n = 9
const m = l(n, 3)
print(m[0] + m[1])
