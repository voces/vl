// @run
// @log 5
// @log true
// @log true
// @log 7
// @log b
// D1411, D2482 and D2483. A record literal is built at an unrelated declared record of its
// field names only when each field's type fits that record's field: an `i32 | null` value is
// no `i32`, and a `boolean` or an `i32` is neither a nullable number nor a string literal set.
type Q = { f: i32 }
const u: i32 | null = 5
const w = { f: u }
print(w.f ?? 0)
type Q2 = { k: i32 | null }
const r2 = { k: true }
print(r2.k)
type Q3 = { g: f64 | null }
const r3 = { g: true }
print(r3.g)
type Q4 = { h: "a" | "b" | null }
const r4 = { h: 7 }
print(r4.h)
const q4: Q4 = { h: "b" }
print(q4.h)
