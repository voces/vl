// @run
// @log 0
// @log 0
// @log 1
// @log 0
// @log 0
// @log 0
// @log 0
// @log 1
// @log 1
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log 1
// @log other
// @log other
// @log other
// @log string
// @hint redundant type annotation: `mkPlain` is inferred as `string`
// @hint redundant type annotation: `probe` is inferred as `string`
// @hint redundant type annotation: `c1` is inferred as `{r: i32}`
// CONTRACT (must-not-error, D950/D942): at a monomorphized instance whose receiver
// reps as a NULLABLE NICHE, `v is X` must answer per ARM, not "is the value present".
//
// The two niche arms of `emitIs` lower `recv is X` to the receiver's own null test on
// the premise that "the checker already proved the tested shape is the sole non-null
// member". At a generic DECLARATION the receiver is `T`, so the checker must accept
// `v is boolean` beside `v is string` and proves nothing — only the INSTANCE makes one
// of them impossible. Master answered TRUE to `is boolean`, `is f64` AND `is string`
// on one `string | null` value, all three emitting the byte-identical
// `(i32.eqz (ref.is_null …))`; three mutually exclusive tests answering true on one
// value is no predicate at all.
//
// Exactly one arm may fire per value: the niche's own base for a present value,
// `is null` for a null. The last four lines are D942 — the same degeneracy reached
// through a GENERIC STRUCT FIELD read, whose rep is a nullable ref niche even when the
// instance type is not nullable at all.

function isB<T>(v: T) {
  if v is boolean { return 1 }
  0
}
function isS<T>(v: T) {
  if v is string { return 1 }
  0
}
function isN<T>(v: T) {
  if v is null { return 1 }
  0
}

function mkStr(c: boolean): string | null {
  if c { return "x" }
  null
}
function mkBool(c: boolean): boolean | null {
  if c { return true }
  null
}

// `string | null`, present: only `is string`.
print(isB(mkStr(true))) // 0
print(isN(mkStr(true))) // 0
print(isS(mkStr(true))) // 1
// `string | null`, null: only `is null`.
print(isB(mkStr(false))) // 0
print(isS(mkStr(false))) // 0

// `boolean | null`, present: only `is boolean`. The base arm still asks the niche's
// null question, so it must keep working — the fix may not fold IT.
print(isS(mkBool(true))) // 0
print(isN(mkBool(true))) // 0
print(isB(mkBool(true))) // 1
// `boolean | null`, null: only `is null`.
print(isN(mkBool(false))) // 1
print(isB(mkBool(false))) // 0
print(isS(mkBool(false))) // 0

// The CONTROLS the defect was localized with, which the fix must not move: a
// non-nullable `T = string` decides correctly, and so does a `T = i32 | null`
// (a value-union BOX, which takes the tag compare and never reached the niche arms).
function mkPlain(c: boolean): string {
  if c { return "x" }
  "y"
}
function mkI32(c: boolean): i32 | null {
  if c { return 5 }
  null
}
print(isB(mkPlain(true))) // 0
print(isB(mkI32(true)))   // 0
print(isS(mkI32(true)))   // 0
print(isN(mkI32(true)))   // 0
print(isN(mkI32(false)))  // 1

// D942 — the same arm, reached through a generic struct FIELD read.
type Carrier<T> = { held: T }
type Circle = { r: i32 }

function carry<T>(value: T): Carrier<T> { return { held: value } }
function probe<T>(self: Carrier<T>): string {
  const a = self.held
  if a is string { return "string" }
  if a is boolean { return "boolean" }
  if a is i32 { return "i32" }
  "other"
}
const c1: Circle = { r: 1 }
print(probe(carry(c1)))  // other  (master: string)
print(probe(carry(1.5))) // other
print(probe(carry(c1)))  // other
print(probe(carry("z"))) // string
