// @check
// @error-at 7:29 {y: i32, x: i32} is not V: they store field `x` differently
// @error-at 9:22 {y: i32, x: i32} is not V (reached through {c: {y: i32, x: i32}} into {c: V}): they store field `x` differently
// VERDICT PIN (must-error): a type parameter's value handed as an argument, or as a record field,
// to a record that stores a field differently is refused at the pin, as a binding is (D14759).
type V = { y: i32, x: i32 | string }
function k(v: V): i32 { v.y }
function g<T>(v: T): i32 { k(v) }
function f<T>(v: T): i32 {
  const o: { c: V } = { c: v }
  o.c.y
}
const a: { y: i32, x: i32 } = { y: 2, x: 9 }
print(g(a))
print(f(a))
