// @log 3
// @log 3
// @log 3
// A `let` list binding reassigned other list literals holds only literals, so it is built at the
// list of a wider record it is delivered to, as a `const` one is (D15871).
type D = { v: i64 }
let q = [{ v: 1 }]
q = [{ v: 3 }]
const ds: D[] = q
print(ds[0].v)
let q2 = [{ v: 1 }]
const ds2: D[] = q2
q2 = [{ v: 3 }]
print(ds2[0].v)
print(q2[0].v + 1)
let q3 = [{ v: 1 }]
q3 = [{ v: 3 }, { v: 4 }]
q3.push({ v: 5 })
const ds3: D[] = q3
print(ds3.length)
print(q3[2].v + ds3[0].v)
const r = [{ v: 5 }]
let q4 = [{ v: 1 }]
q4 = r
const ds4: D[] = q4
print(ds4[0].v)
print(r[0].v + 1)
const go = [1].length > 0
let q5 = [{ v: 1 }]
if go { q5 = [{ v: 7 }] }
const ds5: D[] = q5
print(ds5[0].v)
let q6 = [{ v: 1 }]
q6 = [{ v: 3 }]
type W = { f: D[] }
const w: W = { f: q6 }
print(w.f[0].v)
const xs: D[][] = [q6]
print(xs[0][0].v)
function f() {
  let q7 = [{ v: 1 }]
  q7 = [{ v: 3 }]
  const ds7: D[] = q7
  print(ds7[0].v)
}
f()
