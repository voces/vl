// @check
// @warning `is` check type 'string' can never match a value of type Name, so this test is always false here
// @warning `is` check type 'i32' can never match a value of type string, so this test is always false here
// @warning `is` check type 'string' can never match a value of type i32, so this test is always false here
// @warning `is` check type 'i64' can never match a value of type i32, so this test is always false here
// @warning `is` check type 'Dog' can never match a value of type Cat, so this test is always false here
// @error exported function `probe` is generic over `T` and nothing in the program calls it
// A test a PLAIN operand's declared type can never satisfy, at each rung (a newtype, scalars, a
// sibling variant): a warning, the test folds to false, and its arm reads the operand as `never`,
// so no branch binds it at a type the value does not have (the D16047 ruling, 2026-11-14).
type Name = new string
type Cat = { meow: i32 }
type Dog = { woof: i32 }

function takesString(s: string) { return s }
function takesDog(d: Dog) { return d.woof }

export function newtypeRung(n: Name) {
  return if n is string { takesString(n) }
}

export function stringIsI32(s: string) {
  if s is i32 { return s + 1 }
  return 0
}

export function i32IsString(v: i32) {
  return if v is string { takesString(v) }
}

export function i32IsI64(v: i32) {
  if v is i64 { return 1 }
  return 0
}

export function variantIsSibling(c: Cat) {
  return if c is Dog { takesDog(c) }
}

// CONTROL — a generic operand is opaque and must stay testable.
export function probe<T>(v: T) {
  if v is i32 { return 1 }
  return 0
}
