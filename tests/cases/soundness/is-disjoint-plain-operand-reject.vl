// @check
// @error `is` check type 'string' can never match a value of type Name
// @error `is` check type 'i32' can never match a value of type string
// @error `is` check type 'string' can never match a value of type i32
// @error `is` check type 'i64' can never match a value of type i32
// @error `is` check type 'Dog' can never match a value of type Cat
// CONTRACT (must-error): the `is` soundness gate covers a PLAIN operand, not only a
// union/nullable one. `x is T` narrows the THEN branch to `T` VERBATIM, so a test the
// value can never satisfy hands the branch a binding of a type the value does not have —
// a LAUNDER, not a dead branch.
//
// The newtype rung is the sharpest: `takesString(n)` on a `Name` is a hard type error,
// and `as` is numeric-only, so a `new string` brand has NO legal unwrap at all. Wrapping
// the same call in `if n is string { … }` used to manufacture one and print "bob".
//
// The scalar rungs (`string is i32`, `i32 is string`, `i32 is i64`) each used to pass
// `vl check` and emit INVALID WASM; the sibling-variant rung (`Cat is Dog`) emitted
// invalid wasm as soon as the branch touched the binding.
//
// A generic parameter stays freely testable — `TyVar` is assignable in both directions
// by construction, so `is` inside a generic body is untouched (see the `probe` arm below,
// which must NOT error).
type Name = new string
type Cat = { meow: i32 }
type Dog = { woof: i32 }

function takesString(s: string) { s }
function takesDog(d: Dog) { d.woof }

export function newtypeRung(n: Name) {
  if n is string { takesString(n) }
}

export function stringIsI32(s: string) {
  if s is i32 { return s + 1 }
  0
}

export function i32IsString(v: i32) {
  if v is string { takesString(v) }
}

export function i32IsI64(v: i32) {
  if v is i64 { return 1 }
  0
}

export function variantIsSibling(c: Cat) {
  if c is Dog { takesDog(c) }
}

// CONTROL — a generic operand is opaque and must stay testable.
export function probe<T>(v: T) {
  if v is i32 { return 1 }
  0
}
