// D14532: a read out of a container its stores build at a wider record, handed to a hole parameter
// that is only read for a field or handed to another such parameter, runs at the build.
function k(q) { q.f + 1 }
function g2(r) { k(r) }
type J = { f: i32 | null }
function mk() { { f: 4 } }
function g(r) { r.f * 10 }
function h(o) { o.a.f * 3 }
const wideJ: J = mk()
const w = { a: mk() }
const xs = [mk()]
print(g(w.a))
print(h(w))
print(g(xs[0]))
print(g2(xs[0]))
print(wideJ.f ?? 0)
