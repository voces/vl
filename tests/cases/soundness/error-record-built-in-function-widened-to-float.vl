// @check
// @error {v: i32} is not D: they store field `v` differently (`i32` into `f64`)
// @hint redundant type annotation: `x` is inferred as `i32`
// D2996: a record a function with no declared result builds is built at its own row, and an
// `i32` field has no conversion into a bare `f64` one, so a function called more than once is
// refused as an existing record is; declaring `mk`'s result as `D` builds it there. A function
// called once is built at its one destination (D3444, DECISIONS.md "Record covariance").
type D = { v: f64 }
const x: i32 = 3
function mk() { return { v: x } }
const d: D = mk()
print(d.v / 2.0)
const e: D = mk()
print(e.v)
