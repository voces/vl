// @emit-error emitProgram: monomorphize: unsupported argument type for `_x` in a call to `dstGen`
// THE `u8[]` HALF of the monomorphizer's floor — the sibling of
// `tests/cases/soundness/error-generic-nulreflist-field-pin.vl`, whose header states the rule
// in full (`silent-class-inventory` D23).
//
// `u8[]` is the PACKED byte list: an i32-element list over a one-byte backing, so the pin
// cascade's `exprArray` arm does not claim it (it spells the 4-byte `i32[]`) and it fell all
// the way to the `"i32"` catch-all — an i32 parameter over a `(ref $u8Wrap)` value.
//
// THE TWO SPELLINGS DISAGREED, which is what made this worth flooring rather than leaving.
// A `readFile`-shaped `u8[]` meeting a `std:array` generic already got a clean CHECKER error
// (`tests/cases/std/error-u8-array-generic.vl` — `T` ranges over value types and `u8` is
// storage), while the same value handed to a user-declared generic reached the emitter and
// miscompiled. One rule, one outcome, now at both.
function dstGen<T>(_x: T, k: i32): i32 {
  return k
}

function bytes(b: u8[]) {
  return dstGen(b, 7)
}

const zs: u8[] = []
print(bytes(zs))
