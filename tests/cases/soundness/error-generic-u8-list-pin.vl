// @run
// @log 7
// @log 200
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// @hint redundant type annotation: `dstGen` is inferred as `i32`
// Graduated from an `@emit-error` pin (D2238), on the terms its sibling
// `error-generic-nulreflist-field-pin.vl` set: a floor is a placeholder for a name.
//
// `u8[]` is the packed byte list, and a generic `T` bound to the WHOLE list is a value type,
// so the pin is the list's own spelling and the instance's parameter is the byte-list cell.
// `T := u8` — a `T[]` meeting `u8[]` — is a different rule and still refused by the checker
// (`tests/cases/std/error-u8-array-generic.vl`).
function dstGen<T>(_x: T, k: i32): i32 { return k }
function idGen<T>(x: T): T { return x }

function bytes(b: u8[]) { return dstGen(b, 7) }

const zs: u8[] = []
print(bytes(zs))
const bs: u8[] = [200]
const back = idGen(bs)
print(back[0])
