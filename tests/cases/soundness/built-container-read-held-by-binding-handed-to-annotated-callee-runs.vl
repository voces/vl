// @run
// @log 4
// @log 4
// @log 4
// @log 4
// A binding holding a read out of a built container is that read: handed to an annotated
// parameter read only for fields, the callee is instanced at the build, and assigned into a
// binding built there too it converts nothing (D15124). The first two were invalid wasm.
type J = { f: i32 | null }
function mk() { { f: 4 } }
const wideJ: J = mk()
const xs = [mk()]
function take(v: { f: i32 }) { v.f }
const b = xs[0]
print(take(b))
function g() {
  const c = xs[0]
  return take(c)
}
print(g())
const p = xs[0]
let q = xs[0]
q = p
print(q.f)
print(wideJ.f ?? 0)
