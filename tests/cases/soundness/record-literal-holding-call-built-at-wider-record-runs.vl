// @run
// @log 4
// @log 5
// @log 4
// @log 4
// @log 4
// @log 16000000000
// @log 9
// A record literal a function returns, holding another function's record result, built at a wider
// record: the inner call is built at the wider field, as the literal written there builds it, also
// beside an own-type binding, through a list or an argument, and at an `i64` field (D15215).
type J = { f: i32 | null }
type K = { j: J }
function mk() { { f: 4 } }
function w() { { j: mk() } }
const k: K = w()
const y = w()
print(k.j.f ?? 0)
print(y.j.f + 1)
const ks: K[] = [w()]
print(ks[0].j.f ?? 0)
function use(v: K) { print(v.j.f ?? 0) }
use(w())
function v() { w() }
const kv: K = v()
print(kv.j.f ?? 0)
type J64 = { f: i64 }
type K64 = { j: J64 }
function mk64() { { f: 4 } }
function w64() { { j: mk64() } }
const k64: K64 = w64()
print(k64.j.f * 4000000000)
k.j.f = null
print(k.j.f ?? 9)
