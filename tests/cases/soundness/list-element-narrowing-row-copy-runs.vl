// @run
// @log 0
// @log 1
// @log 1
// @log 0
// @log 1
// @log 7
// @log 0
// @log b
// @log widened
// @log 0
// @log 1
// @log 0
// @log 1
// @log 0
// @log 0
// @log 7
// D4945: under `b is K[][]` a row of `b` becomes a `K[]` of its own only through a `map` copy,
// which later writes to `b` do not reach; a row still delivers as its declared `i32[]`, and a
// store or push that keeps every element in `K` leaves the narrowing standing. The guarded list
// itself stays an `i32[]`, so it takes a wider store and delivers at its declared type.
type K = 0 | 1
type S = "a" | "b"
const b: i32[][] = [[0], [1]]
const m = [["a"], ["b"]]
const show = (x: K) => {
  print(x)
}
let k: K[] = []
let kk: K[][] = []
let wide: i32[] = []
let one: K = 0
let ks: S[] = []
if (b is K[][]) {
  k = b[0].map((x) => x)
  kk = b.map((r) => r.map((x) => x))
  wide = b[1]
  one = b[0][0]
  for r in b {
    const c: K[] = r.map((x) => x)
    show(c[0])
  }
  const z = b[1].map((x) => x)
  const w: K[] = z
  show(w[0])
}
if (m is S[][]) { ks = m[1].map((x) => x) }
b[0][0] = 5
b[1][0] = 7
print(k[0])
print(kk[1][0])
print(wide[0])
print(one)
print(ks[0])
if (b is K[][]) { print("still") } else { print("widened") }
const g: i32[][] = [[0], [1]]
if (g is K[][]) {
  g[0][0] = 1
  g[1].push(0)
  let i = 0
  while i < 2 {
    g[i][0] = 0
    g[i].push(1)
    i = i + 1
  }
  for r in g {
    show(r[0])
    show(r[r.length - 1])
  }
  show(g[1][1])
}
const v = [0, 1]
if (v is K[]) {
  show(v[0])
  v[1] = 7
  wide = v
  print(wide[1])
}
