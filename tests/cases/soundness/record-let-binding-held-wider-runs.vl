// @run
// @info `r` is never reassigned; use `const` instead of `let`
// @info `s` is never reassigned; use `const` instead of `let`
// @info `t` is never reassigned; use `const` instead of `let`
// @info `u` is never reassigned; use `const` instead of `let`
// @log 6
// @log 6
// @log 6
// @log 6
// @log 6
// @log 4
// A fresh record `let` nothing reassigns is built where it is pushed or assigned into a place
// held at a wider record, as a `const` is (D15283).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const wideJ: J = mk()
const xs = [mk()]
let r = { f: 6 }
xs.push(r)
print(xs[1].f ?? 0)
let y = xs[0]
let s = { f: 6 }
y = s
print(y.f ?? 0)
let z = mk()
let t = { f: 6 }
z = t
print(z.f ?? 0)
let a = xs[0]
let b = mk()
let u = { f: 6 }
a = u
b = u
print(a.f ?? 0)
print(b.f ?? 0)
print(wideJ.f ?? 0)
