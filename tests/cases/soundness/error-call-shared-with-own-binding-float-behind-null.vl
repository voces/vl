// @check
// @error-at 10:14 they store field `j` differently
// @hint Intentionally-unused variable `_k`
// VERDICT PIN (must-error): a function's record result shared between an own-type binding and a
// record that stores its integer as a float behind `| null` has no conversion, so it is refused at
// check as the plain spelling is (D15247).
type J = { f: f64 | null }
type K = { j: J | null }
function mk() { { j: { f: 4 } } }
const y = mk()
const _k: K = mk()
print(y.j.f)
