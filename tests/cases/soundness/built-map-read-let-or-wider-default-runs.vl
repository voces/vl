// @run
// @log 4
// @log 4
// @log 3
// @log 7
// @log 8
// @log 4000000000
// @log 2
// A read of a map whose values are built wider, defaulted with `??` to a `let`, or to a binding
// whose record the read's stores a number wider: the binding is delivered at the read's record as
// a typed delivery of it is (D15248, D15249).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const m = Map()
m.set("a", mk())
const wm: {[string]: J} = Map()
wm.set("a", mk())
let d = { f: 1 }
const b = m.get("a") ?? d
print(b.f)
d = { f: 3 }
print(b.f)
print(d.f ?? 0)
const e = { f: 7 }
let d2 = { f: 1 }
d2 = e
const b2 = m.get("z") ?? d2
print(b2.f ?? 0)
print(e.f + 1)
type K = { f: i64 }
function mk64() { { f: 4 } }
const m64 = Map()
m64.set("a", mk64())
const wm64: {[string]: K} = Map()
wm64.set("a", mk64())
const d64 = { f: 1 }
const b64 = m64.get("z") ?? d64
print(b64.f * 4000000000)
print(d64.f + 1)
