// @log 1
// A `map` or `filter` callback over a list a kept maker's build stores at a wider record than its
// element type takes its elements at that record: a lambda, a named hole function, a chain, a
// list literal receiver, a lambda in a generic body, and a `filter` or `slice` result beside a
// list of the element's own row (D16134).
type J = { f: i32 | null }
function mk2() { { f: null } }
const dA: J = mk2()
const xs = [mk2()]
const ws = [{ f: null }]
print(xs.filter((y) => y.f == null)[0].f)
print(xs.map((y) => y.f == null)[0])
function chk(y) { y.f == null }
print(xs.filter(chk)[0].f)
print(xs.map(chk)[0] && ws.map(chk)[0])
print(xs.filter((y) => y.f == null).filter((y) => y.f == null)[0].f)
function k<T>(t: T) { print([mk2()].filter((y) => y.f == null)[0].f) }
k(1)
const zs = xs.slice(0, 1)
print(zs[0].f)
print(ws.length)
