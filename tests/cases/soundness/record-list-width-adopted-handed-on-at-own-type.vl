// @run
// @log 7
// @log 7
// @log 4
// @hint redundant type annotation: `i` is inferred as `{f: i32}`
// D2914: a list of object literals delivered where a list of a record storing its field as
// `i64 | null` is declared takes that list type, so a use that hands it on (`il.map`) reads the
// adopted record, as the annotated `const il: I[] = [{ f: 7 }]` does.
const i: { f: i32 } = { f: 4 }
type I = { f: i64 | null }
const il = [{ f: 7 }]
const ic: I[] = il
const z = il.map((e) => e.f)
print(z[0])
print(ic[0].f)
print(i.f)
