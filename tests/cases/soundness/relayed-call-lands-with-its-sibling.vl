// @run
// @log 4
// @log 4
// @log 4
// @log 4
// @log 4
// A call that an inferred function hands back lands where that function's call is delivered,
// so it is built at the same wider record as its sibling call (D14516): a `return`, a tail
// value, two hops, and an argument and a list element as the delivery.
type J = { f: i32 | null }
function mk() { { f: 4 } }
const wideJ: J = mk()
function relay() { return mk() }
function tail() { mk() }
function relay2() { return tail() }
function sink(x: J) { print(x.f ?? 0) }
const v: J = relay()
const w: J = relay2()
sink(tail())
const xs: J[] = [relay()]
print(wideJ.f ?? 0)
print(v.f ?? 0)
print(w.f ?? 0)
print(xs[0].f ?? 0)
