// @run
// @warning this `??` default is never used: `D` is never null — drop the `??` and its default
// @log 3.5
// @log 3.5
// @log 3.5
// @log 7000000000
// @log 3.5
// @log 4.5
// @log 3.5
// @log 3.5
// @log 28
// @log 7
// D3441: a binding that holds only a literal, delivered through an `if` arm, a `match` arm or
// either `??` operand, adopts the record the join is delivered to, as its annotated twin
// `const q: D = { v: 7 }` does; two such bindings joined together both adopt it.
type D = { v: f64 }
type E = { v: i64 }
type L = { xs: { v: f64 }[] }
const c = true
const k = 1

const q1 = { v: 7 }
print(q1.v / 2)
const d1: D = if c { q1 } else { { v: 2 } }

const q2 = { v: 7 }
const d2: D = match k {
  1 => q2
  _ => ({ v: 2 })
}
print(q2.v / 2)

const q3 = { v: 7 }
const d3: D = q3 ?? { v: 2 }
print(q3.v / 2)

const q4 = { v: 7 }
const m: E | null = null
const d4: E = m ?? (if c { q4 } else { { v: 2 } })
print(q4.v * 1000000000)

const q5 = { v: 7 }
const r5 = { v: 9 }
const d5: D = if c { q5 } else { r5 }
print(q5.v / 2)
print(r5.v / 2)

const q6 = { xs: [{ v: 7 }] }
const d6: L = if c { q6 } else { { xs: [] } }
print(q6.xs[0].v / 2)
print(d6.xs[0].v / 2)
print(d1.v + d2.v + d3.v + d5.v)
print(d4.v)
