// @run
// @log 6
// @log 2
// @log cc
// @log i32
// D2610. A write to a narrowed map cell re-narrows the cell to the member it stored, in both
// halves: the emitter pushes that member for the cell as an `is` test of it would, so the reads
// after the write lower at it. And a write of the whole union leaves the cell present, so it
// reads as the union rather than the map read's `T | null`.
type A = { r: i32 }
type B = { s: string }
function useU(v: i32 | f64) {
  if v is i32 { print("i32"); return }
  print("f64")
}
function src2(): i32 | f64 { return 7 }
function go() {
  const m: {[string]: i32 | string} = Map()
  m["k"] = "s"
  if m["k"] is string { m["k"] = 5; print(m["k"] + 1) }
  m["k"] = 3
  if m["k"] is i32 { m["k"] = "tt"; print(m["k"].length) }
  const n: {[string]: A | B} = Map()
  n["k"] = { r: 1 }
  if n["k"] is A { n["k"] = { s: "cc" }; print(n["k"].s) }
  const u: {[string]: i32 | f64} = Map()
  u["k"] = 1
  if u["k"] is i32 { u["k"] = src2(); useU(u["k"]) }
}
go()
