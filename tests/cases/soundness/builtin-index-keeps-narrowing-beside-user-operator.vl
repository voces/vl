// @run
// @log b7
// @hint redundant type annotation
// @hint Intentionally-unused parameter
// D5590: an index into a built-in list runs the built-in, so a callee that only writes a list
// element keeps a narrowing even when a declared `"[]="` writes the narrowed field.
type Box = { kind: "a" | "b" | "c" }
function "[]="(self: Box, _i: i32, _v: i32) { self.kind = "a" }
function "[]"(self: Box, i: i32): i32 {
  if self.kind == "a" { 0 } else { i }
}
type Intent = { kind: "a" | "b" | "c", n: i32 }
function fill(xs: i32[]) { xs[0] = 7 }
function act(i: Intent, xs: i32[]): string {
  if i.kind == "a" { return "a" }
  fill(xs)
  match i.kind {
    "b" => "b\{xs[0]}"
    "c" => "c"
  }
}
print(act({ kind: "b", n: 1 }, [0]))
