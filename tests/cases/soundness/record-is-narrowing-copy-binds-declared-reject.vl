// @check
// @error-at 12:23 cannot assign i32 to 'y' of type 1 | 2
// VERDICT PIN (must-error, D4133): an un-annotated copy of a record narrowed by its fields
// binds at the declared type, so a write through `base` cannot leave it reading as `1 | 2`.

type A = { x: i32 }
type B = { x: 1 | 2 }
function f(base: A) {
  const a: A | B = base
  if a is B {
    const c = a
    base.x = 7
    const y: 1 | 2 = c.x
    print(y)
  }
}
f({ x: 1 })
