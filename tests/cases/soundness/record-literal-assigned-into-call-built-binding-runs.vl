// @run
// @log 6
// @log 7
// @log 6
// @log 6
// @log 6
// @log 4
// @log 4
// A record literal assigned into a binding initialised from a call whose results are built at a
// wider record is built at that record: twice, from a closure, in a function, nested (D15239).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const wideJ: J = mk()
let y = mk()
y = { f: 6 }
print(y.f)
y = ({ f: 7 })
print(y.f)
let z = mk()
const set = () => {
  z = { f: 6 }
}
set()
print(z.f)
function g() {
  let w = mk()
  w = { f: 6 }
  w.f
}
print(g())
type O = { j: { f: i32 | null } }
function mo() { { j: { f: 4 } } }
const wideO: O = mo()
let o = mo()
o = { j: { f: 6 } }
print(o.j.f)
print(wideJ.f ?? 0)
print(wideO.j.f ?? 0)
