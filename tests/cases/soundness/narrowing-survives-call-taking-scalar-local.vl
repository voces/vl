// @run
// @log 5 1
// @log 5 2
// @hint redundant type annotation: `y` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `y` is inferred as `1 | 2` — remove it to lean on inference
// A call that hands a scalar local to an intrinsic (`toString` reaches `clz(m)`) cannot write
// a narrowed path or binding, so both stay narrowed past it (D4130).
import { toString } from "std:fmt"

type A = { x: i32 | string }
type P = { x: i32 }
type Q = { x: 1 | 2 }
function path(a: A) {
  const k = 5
  if a.x is i32 {
    const s = k.toString()
    const y: i32 = a.x
    print(s + " " + y.toString())
  }
}
function bind(a: P) {
  const k = 5
  if a is Q {
    const s = k.toString()
    const y: 1 | 2 = a.x
    print(s + " " + y.toString())
  }
}
path({ x: 1 })
bind({ x: 2 })
