// @run
// @log 7
// @log 7
// @log 8
// @log 9
// @log 7
// @log 4
// @log 4
// @info `s` is never reassigned; use `const` instead of `let`
// A fresh record `const` as a part of a list literal beside parts built at a wider record is built
// where the list takes it, whichever way the parts are spelled and wherever else it is read (D15372).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const wideJ: J = mk()
const xs = [mk()]
const r = { f: 7 }
const ws = [...xs, r]
print(ws[1].f ?? 0)
print(r.f)
let s = { f: 8 }
const vs = [xs[0], s]
print(vs[1].f ?? 0)
function g() {
  const t = { f: 9 }
  const us = [...xs, t]
  print(us[1].f ?? 0)
}
g()
const q = { f: 7 }
const ps = [q, ...xs]
print(ps[0].f ?? 0)
print(ps[1].f ?? 0)
print(wideJ.f ?? 0)
