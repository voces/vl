// @run
// @hint redundant type annotation: `x` is inferred as `i32`
// @log 1.5
// @log 3.5
// @log 3.5
// @log 3.5
// @log 3.5
// D3444: a function with no declared result that returns only object literals, called once, is
// built at the record its call is delivered to, an integer literal or value there converted to
// the float field, as the twin with a declared result is.
type D = { v: f64 }
type F = { v: f32 }
type N = { p: { v: f64 } }
const x: i32 = 3
function mk1() { return { v: x } }
const d1: D = mk1()
print(d1.v / 2)

function mk2() { return { v: 7 } }
const d2: F = mk2()
print(d2.v / 2)

function mk3() { return { p: { v: 7 } } }
const d3: N = mk3()
print(d3.p.v / 2)

function mk4(k: i32) {
  if k > 0 { return { v: 7 } }
  return { v: 9 }
}
const d4: D | string = mk4(1)
if d4 is D { print(d4.v / 2) }

const mk5 = () => ({ v: 7 })
const d5: F = mk5()
print(d5.v / 2)
