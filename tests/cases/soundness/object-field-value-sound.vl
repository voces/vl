// @run
// @log 5
// @log 9
// @log 1
// @hint redundant type annotation: `b` is inferred as `{value: i32}`
// CONTRACT (must-NOT-error): the field-value tightening must not reject
// well-typed object literals. Runnable companion cases that must keep passing:
//   1. correct field types against a generic alias,
//   2. nullable field assignment (a `null` value into an `i32 | null` field),
//   3. a literal supplying EXACTLY the parameter's fields — the shape rule is
//      about which fields exist, so a literal that names the destination's
//      fields and no others is accepted whatever its field ORDER.
// AN EXCESS PROPERTY IS NOT IN THIS LIST ANY MORE, and that is a rule change, not
// a slip. `fst({ x: 1, y: 2 })` used to stand here as "width subtyping is
// permissive"; the emitter builds the literal at the parameter's shape, so `y`
// and its initializer were dropped unevaluated — a wrong evaluation COUNT that
// `vl check` reported clean. The reject is
// `objects/object-literal-excess-field-reject.vl`, its observable half is
// `objects/object-literal-declared-field-initializer-runs.vl`, and the
// non-literal source forms were already rejected by the object-shape floor.
// (Numeric field coercion is asserted at the type level in
// object-field-value-coerce.vl; codegen of an i32-literal-into-f64-field is a
// separate, pre-existing limitation unrelated to this check.)
type Box<T> = { value: T }
const b: Box<i32> = { value: 5 }
print(b.value) // 5

type Opt = { v: i32 | null }
const o: Opt = { v: null } // nullable field accepts null — no error
print(o.v ?? 9) // null field reads back, defaulted via `??` — 9

// A literal naming exactly the parameter's fields, in its own order: accepted,
// and only a wrong field VALUE would be rejected.
function fst(p: { y: i32, x: i32 }): i32 p.x
print(fst({ x: 1, y: 2 })) // 1
