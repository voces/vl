// @check
// @error-at 10:6 this call binds `V` as f64, but a later write fixes the element of the list it hands as i32

// A call that binds `V` from another argument hands its open list as a `V[]`; a later write that
// fixes the list at another element is a type mismatch at the call (D16759).
function first<V>(v: V[], d: V): V {
  if v.length > 0 { return v[0] }
  return d
}
const e = []
print(first(e, 1.5))
e.push(4)
