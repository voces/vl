// @check
// @error-at 12:0 push: cannot add string to f64[]

// A call that binds `V` from another argument hands its open list as a `V[]`, so the list's
// element is fixed there: a later write of another type is refused as it is into an annotated
// `f64[]` (D16759).
function first<V>(v: V[], d: V): V {
  if v.length > 0 { return v[0] }
  return d
}
const e = []
print(first(e, 1.5))
e.push("x")
