// @run
// @log 4
// @log 2
// @log 1
// @log 7
// @log 1
// A read of a map whose values are built wider, defaulted with `??` to a `const` holding a fresh
// call result, or to the call itself: the function is built at the read's record (D15240).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const m = Map()
m.set("a", mk())
const wm: {[string]: J} = Map()
wm.set("a", mk())
function mkA() { { f: 1 } }
const dA = mkA()
const a = m.get("a") ?? dA
print(a.f)
print(dA.f + 1)
function mkB() { { f: 1 } }
const dB = mkB()
const b = m.get("z") ?? dB
print(b.f ?? 0)
function mkC(n: i32) { { f: n } }
const dC = mkC(7)
const c = m.get("z") ?? dC
print(c.f ?? 0)
function mkD() { { f: 1 } }
const d = m.get("z") ?? mkD()
print(d.f ?? 0)
