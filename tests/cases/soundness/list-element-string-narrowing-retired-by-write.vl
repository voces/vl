// reach them: a direct store, a call whose closure stores, and a `push` in a loop all retire it.
// Line and column are 0-based.
type S = "a" | "b"
const s: string[] = ["a", "b"]
const f = () => {
  s[0] = "zz"
}
if (s is S[]) {
  s[1] = "yy"
  const e: S = s[1]
