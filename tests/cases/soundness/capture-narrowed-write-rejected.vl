// @check
// @error-at 22:12 operator '+' is not defined for i32 | null and i32
// @error-at 33:4 'w1', made on line 31, reads 'v' as i32, a narrowing a write since then may have ended — re-test 'v' before this call, or inside 'w1'
// SOUNDNESS, the narrowed-CAPTURE direction. A closure made inside a guard reads its capture
// at the narrowed rep, and it runs later. A write BEFORE the closure is made ends the
// narrowing, so the closure reads the declared `i32 | null` and the arithmetic is the error. A
// write AFTER it is accepted (D2609), and the call of the closure after the write is refused,
// since the binding no longer holds the captured type there (D2402). Inside a closure that
// writes the capture, the body reads it at its declared type, so the write there is accepted.
// The benign write that keeps the guard true is pinned beside it
// (`functions/capture-narrowed-nullable-scalar.vl`).
function mk(b: boolean): i32 | null {
  if b { return 7 }
  return null
}

function writes(b: boolean) {
  let u = mk(b)
  if u != null {
    // BEFORE the closure is created.
    u = null
    const w0 = () => {
      print(u + 1)
    }
    w0()
  }
  let v = mk(b)
  if v != null {
    const w1 = () => {
      print(v + 1)
    }
    // AFTER the closure is created, before it is called.
    v = null
    w1()
  }
  let x = mk(b)
  if x != null {
    // INSIDE the closure's own body.
    const w2 = () => {
      x = null
      print(1)
    }
    w2()
  }
}

writes(true)
