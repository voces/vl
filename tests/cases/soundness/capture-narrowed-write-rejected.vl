// @check
// @error-at 31:30 'u' was narrowed by a guard, but the assignment on line 31 ended the narrowing
// @error-at 38:8 cannot assign null to i32
// @error-at 44:27 cannot assign null to i32
// SOUNDNESS, the narrowed-CAPTURE direction. A closure created inside a guard reads its
// capture at the NARROWED rep, and it runs LATER — so whether that rep is sound depends on
// whether anything can falsify the guard between the closure's creation and its call.
//
// Nothing can, and this file is the pin. Inside the guarded scope the narrowed type is what
// the binding ACCEPTS, so every write that could falsify the guard is ALREADY a check error,
// at all three positions that matter: before the closure is created, after it is created but
// before it is called, and inside the closure's own body. The capture therefore has nothing
// to invalidate — the same argument that settles it for a bare local, reached through a
// closure. A VERDICT pin, not a log pin: a rejected program produces no output, so there is
// no log form of this assertion.
//
// The complement is pinned by the log fixtures beside it
// (`functions/capture-narrowed-nullable-scalar.vl`): a BENIGN write — one that keeps the
// guard true — is accepted both before and after the closure is created, and a write inside
// the closure body is a loud `emitProgram` reject for every rep, so a by-value capture can
// never silently disagree with a later mutation either.
function mk(b: boolean): i32 | null {
  if b { return 7 }
  return null
}

function writes(b: boolean) {
  let u = mk(b)
  if u != null {
    // BEFORE the closure is created.
    u = null
    const w0 = () => { print(u + 1) }
    w0()
  }
  let v = mk(b)
  if v != null {
    const w1 = () => { print(v + 1) }
    // AFTER the closure is created, before it is called.
    v = null
    w1()
  }
  let x = mk(b)
  if x != null {
    // INSIDE the closure's own body.
    const w2 = () => { x = null
      print(1) }
    w2()
  }
}

writes(true)
