// @run
// @log 1
// @log 1
// A maker called more than once keeps its own record; its call is copied where it lands wider.
// A spread of a list held at its own record beside a maker's call in a list literal runs (D15691).
type J = { f: i32 | null }
function mk2() { { f: 1 } }
const dA: J = mk2()
print(dA.f ?? 0)
const xs: { f: i32 }[] = [{ f: 5 }]
const ys = [...xs, mk2()]
print(ys[1].f ?? 0)
