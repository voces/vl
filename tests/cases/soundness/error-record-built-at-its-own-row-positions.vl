// @check
// @error-at 21:13 {r: i32} is not K: they store field `r` differently
// @error-at 23:13 {r: i32} is not K: they store field `r` differently
// @error-at 24:22 {r: i32, g: i32} is not J: they store field `r` differently
// @error-at 25:13 {r: i32, g: i32} is not J: they store field `r` differently
// @error-at 27:8 {r: i32, g: i32} is not J: they store field `r` differently
// @error-at 29:11 {r: i32, g: i32} is not J: they store field `r` differently
// @error-at 30:10 {r: i32, g: i32} is not J: they store field `r` differently
// D8022, D8141, D8142, D8144, D8140: a record built at a row of its own field storage, by a
// written type argument or by a call beside a declared record of its fields (`Col`), is refused
// where it is delivered into a record that stores a field more widely, at each position below.
type Col = { r: i32, g: i32 }
type J = { r: i32 | null, g: i32 }
type K = { r: i32 | null }
function idn<T>(v: T): T { v }
function mkU() { { r: 15, g: 1 } }
function mkN() { { r: 15, g: 1 } }
function mkP() { { r: 15, g: 1 } }
function mkS() { { r: 15, g: 1 } }
function mkB() { { r: 15, g: 1 } }

const a: K = idn<{ r: i32 }>({ r: 4 })
const s = idn<{ r: i32 }>({ r: 4 })
const b: K = s
const u: J | string = mkU()
const n: J = idn(idn(mkN()))
const xs: J[] = []
xs.push(idn(mkP()))
const m: { [string]: J } = Map()
m.set("k", idn(mkS()))
const h = idn(mkB())
const v: J = h
print(a.r ?? 0)
print(b.r ?? 0)
if u is J { print(u.r ?? 0) }
print(n.r ?? 0)
print(v.r ?? 0)
