// @check
// @error-at 15:13 {r: i32} is not K: they store field `r` differently
// @error-at 17:13 {r: i32} is not K: they store field `r` differently
// @error-at 18:22 {r: i32, g: i32} is not J: they store field `r` differently
// D8022, D8141: a record built at a row of its own field storage, by a written type
// argument or by a call beside a declared record of its fields (`Col`), is refused where it is
// delivered into a record that stores a field more widely, at each position below. The list,
// map and identity-held binding positions (D8144) run since D8020 closed, and two nested
// identities (D8142) since D8303 closed.
type Col = { r: i32, g: i32 }
type J = { r: i32 | null, g: i32 }
type K = { r: i32 | null }
function idn<T>(v: T): T { v }
function mkU() { { r: 15, g: 1 } }

const a: K = idn<{ r: i32 }>({ r: 4 })
const s = idn<{ r: i32 }>({ r: 4 })
const b: K = s
const u: J | string = mkU()
print(a.r ?? 0)
print(b.r ?? 0)
if u is J { print(u.r ?? 0) }
