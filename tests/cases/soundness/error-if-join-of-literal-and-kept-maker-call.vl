// @check
// @error-at 15:39 this value is built as J where line 13 delivers it, and it is handed on here at its own type, which stores a field differently; a record is shared, not copied, so one value cannot be both. Annotate it with one of the types, and copy it with an object literal for the other
// @error-at 17:21 this value is built as J where line 13 delivers it, and it is handed on here at its own type, which stores a field differently; a record is shared, not copied, so one value cannot be both. Annotate it with one of the types, and copy it with an object literal for the other
// @error-at 19:39 this value is built as J where line 13 delivers it, and it is handed on here at its own type, which stores a field differently; a record is shared, not copied, so one value cannot be both. Annotate it with one of the types, and copy it with an object literal for the other
// @error-at 23:7 this value is built as J where line 13 delivers it, and it is handed on here at its own type, which stores a field differently; a record is shared, not copied, so one value cannot be both. Annotate it with one of the types, and copy it with an object literal for the other
// @error-at 27:31 this value is built as J where line 13 delivers it, and it is handed on here at its own type, which stores a field differently; a record is shared, not copied, so one value cannot be both. Annotate it with one of the types, and copy it with an object literal for the other
// A maker's call as an `if` or `match` arm beside a literal is refused at its own type when an
// annotated binding builds the maker wider, as a bound read of the call is, at any relay depth
// and inside a function (D15653).
type J = { f: i32 | null }
function mk2() { { f: 1 } }
function mk4() { mk2() }
const dA: J = mk2()
print(dA.f ?? 0)
const k = 1
const a = if k > 0 { { f: 4 } } else { mk2() }
print(a.f)
const b = if k > 0 { mk2() } else { { f: 4 } }
print(b.f)
const c = if k > 0 { { f: 4 } } else { mk4() }
print(c.f)
const d = match k {
  1 => { f: 4 }
  _ => mk2()
}
print(d.f)
function pick(n: i32) {
  if n > 0 { { f: 4 } } else { mk4() }
}
print(pick(k).f)
