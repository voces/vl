// @run
// @log 8
// @log 6
// @hint Intentionally-unused parameter `_x`
// @hint Intentionally-unused variable `_z`
// D14813: a generic list callee that binds an element of a list of calls built at a wider record,
// unread or read for a field, is instanced at that record.
type Circle = { r: i32 | null }
function sink(_x: Circle) {}
function mkcall() { { r: null } }
sink(mkcall())
function rd<T>(xs: T[]) {
  const _z = xs[0]
  8
}
function rf<T>(xs: T[]): i32 {
  const z = xs[0]
  z.r ?? 6
}
print(rd([mkcall()]))
print(rf([mkcall()]))
