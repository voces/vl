// @log false
// @log 2
// Every use of an inferred function's result delivers it into the same wider record or record
// list: each is copied where it lands, and runs (D14385's controls).
type Cir2 = { c2: i32 }
type Sq2 = { s2: i32 }
type Circle = { r: Cir2 | Sq2 }
function mk() { return { r: { c2: 1 } } }
function rows() {
  const t = [{ r: { c2: 1 } }, { r: { s2: 5 } }]
  t
}
const a: Circle = mk()
const b: Circle = mk()
print(a.r is Sq2)
print(b.r is Cir2)
const l: Circle[] = rows()
const l2: Circle[] = rows()
print(l[0].r is Sq2)
print(l2.length)
