// @run
// @log true
// @log false
// @log f32
// @log true
// @log true
// @log true
// @log true
// An `is` over a field whose record is stored at a wider record's row tests the value rebuilt at
// the receiver's own members (D3006), not the stored box's widened tag: printed, in an `if`, bound,
// returned, negated and at the top level.
type D = { v: i64 | f64 }
function printed() {
  const x: i32 | f32 = 1.5
  const o = { v: x }
  const c: {[string]: D} = Map()
  c["k"] = o
  print(o.v is f32)
  print(o.v is i32)
}
function inIf() {
  const x: i32 | f32 = 2.5
  const o = { v: x }
  const c: {[string]: D} = Map()
  c["k"] = o
  if o.v is f32 { print("f32") } else { print("lost f32") }
}
function bound() {
  const x: i32 | f32 = 3.5
  const o = { v: x }
  const c: {[string]: D} = Map()
  c["k"] = o
  const b = o.v is f32
  return b
}
function returned() {
  const x: i32 | f32 = 4
  const o = { v: x }
  const c: {[string]: D} = Map()
  c["k"] = o
  return o.v is i32
}
function negated() {
  const x: i32 | f32 = 5.5
  const o = { v: x }
  const c: {[string]: D} = Map()
  c["k"] = o
  print(!(o.v is i32))
}
printed()
inIf()
print(bound())
print(returned())
negated()
const gx: i32 | f32 = 6.5
const go = { v: gx }
const gc: {[string]: D} = Map()
gc["k"] = go
print(go.v is f32)
