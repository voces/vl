// @run
// @log 9
// @log 9
// @log q
// @log 20
// @log 4
// A fresh literal a generic delivers to a wider record and hands back is built at that record,
// and the caller's reads, a reassigned binding and a second instance are served there (D15185).
type V = { y: i32, x: i32 | string }
function k(v: V) { v.y }
function back<T>(v: T): T {
  k(v)
  v
}
print(back({ y: 2, x: 9 }).x)
const r = back({ y: 2, x: 9 })
print(r.x)
print(back({ y: 3, x: "q" }).x)
print(r.x * 2 + r.y)
let s = back({ y: 2, x: 9 })
s = { y: 1, x: 4 }
print(s.x)
