// @check
// @error member access '.length' on non-object i32[] | null
// @hint redundant type annotation: `xs` is inferred as `(i32[] | null)[]`
// SOUNDNESS (must-error). A write that may falsify an `xs[0]` narrowing RETIRES it, in the
// two spellings a write can take inside the guard itself.
//
// WHY THIS FILE IS THE PRICE OF INVENTORY-2 D11's LANDING. `writeRetiresNarrowing`'s header
// used to say the two sides stayed consistent for free — *"An unkeyable target (`xs[i] = …`)
// names no place and retires nothing — and no narrowing can key one either"*. Keying a
// constant index breaks that symmetry, and #1993 measured the result: both programs below
// were CHECK-CLEAN and died `wasm trap: null reference`, the `program TRAP` column the
// census records as ZERO across 250,238 cells.
//
//   1. A VARIABLE subscript (`xs[i] = null`) keys "" — `retireNarrowingsForWrite` now reads
//      that "" as "may have hit any cell of the receiver" rather than as "hits nothing",
//      and retires every narrowing under `xs[`.
//   2. A ROOT rebind (`xs = [null]`) replaces the whole array; the prefix leg matched
//      `tgtKey + "."` only, so no index child of the target was ever retired.
//
// The DECLARED-type message below is the point: the narrowing is gone, so the read is
// checked against the storage — exactly what the same read outside any guard gets.
function src(): i32[] | null { return [1, 2] }

function varIndexWrite(i: i32) {
  const xs: (i32[] | null)[] = [src()]
  if xs[0] != null {
    xs[i] = null
    print(xs[0].length)
  } else { print("NUL") }
}
varIndexWrite(0)
