// @log false
// D3443: a literal binding delivered to a union that holds a wider record adopts the member it
// lands on, as its annotated twin does, whether the other member is a string, a number or
// another record, and whether the width change is `f32` or a nested record.
type F = { v: f32 }
type G = { w: string }
type N = { p: { v: f64 } }
type L = { xs: { v: f64 }[] }

const q1 = { v: 7 }
const d1: F | string = q1
print(q1.v / 2)

const q2 = { v: 7 }
const d2: F | i32 = q2
print(q2.v / 2)

const q3 = { p: { v: 7 } }
const d3: N | G = q3
print(q3.p.v / 2)
if d3 is N { print(d3.p.v / 2) }

const q4 = { xs: [{ v: 7 }] }
const d4: L | null = q4
print(q4.xs[0].v / 2)
print(d1 is string)
print(d2 is i32)
print(d4 == null)

const il = [{ f: 7 }]
const ic: { f: f64 }[] | string = il
print(il[0].f / 2)
print(ic is string)
