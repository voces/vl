// @run
// @log 0.3333333333333333
// @log 0.3333333333333333
// @log 1.3333333333333333
// @log 5
// @log 2147483648
// @log 2147483648
// @log 2147483648
// @log 2147483647
// @log 3.5
// @log 3.5
// D3339: a binding that holds only a literal, delivered to a record that stores a numeric field
// at another width or kind, takes that record as its type at every read, before the delivery
// and after it, through a lambda, a loop and an identity call; each value is its annotated
// twin's (DECISIONS.md "Record covariance").
type D = { v: f64 }
type J = { f: f64 }
type L = { f: i64 }
type F = { v: f32 }
function id<T>(x: T): T { x }
const q = { v: 1 }
print(q.v / 3)
const d: D = q
print(d.v / 3)

const il = [{ f: 4 }]
const ic: J[] = il
print(il[0].f / 3)
const z = il.map((e) => e.f)
print(z[0] + ic.length)

const e = { f: 2147483647 }
const g = () => e.f + 1
print(g())
for r in [e] { print(r.f + 1) }
print(id(e).f + 1)
const l: L = e
print(l.f)

const h = { v: 7 }
print(h.v / 2)
const k: F = h
print(k.v / 2)
