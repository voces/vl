// @run
// @log 9
// @log 0
// @log 8
// @log 0
// @log 7
// @log 0
// @log 4
// A field written from a right-hand side that rebinds the receiver lands in the object read
// first; a later read through the rebound name is not narrowed to the value written.
type A = { x: i32 }
type H = { p: A | null }
let h: H = { p: null }
const keep = h
function sw(): A { h = { p: null }; return { x: 9 } }
h.p = sw()
print(keep.p?.x ?? 0)
print(h.p?.x ?? 0)
type Outer = { q: H }
const o: Outer = { q: { p: null } }
const okeep = o.q
const swq = (): A => { o.q = { p: null }; return { x: 8 } }
o.q.p = swq()
print(okeep.p?.x ?? 0)
print(o.q.p?.x ?? 0)
type Box = { h: H }
const bx: Box = { h: { p: null } }
const bkeep = bx.h
function swb(b: Box): A { b.h = { p: null }; return { x: 7 } }
bx.h.p = swb(bx)
print(bkeep.p?.x ?? 0)
print(bx.h.p?.x ?? 0)
const k: H = { p: null }
function mk(): A { return { x: 4 } }
k.p = mk()
print(k.p.x)
