// @run
// @log 3
// @log -1
// @hint Intentionally-unused parameter `_t` (leading `_` marks it unused)
// A lambda cloned for a generic's instance answers what its template did: when the template's
// body reads a closure-written binding at its declared type, so does every clone's, and the
// emitter replays no narrowing into it (D2402).
function mk<T>(_t: T, c: boolean) {
  let v: boolean | f64 = 1.5
  const w = () => {
    v = true
  }
  if v is f64 {
    const r = (): f64 => {
      if v is f64 { return v * 2.0 }
      -1.0
    }
    if c { w() }
    return r
  }
  (): f64 => 0.0
}
print(mk(1, false)())
print(mk(1, true)())
