// @run
// @log 2
// @log 1
// @log 4
// @log 3
// @log 7
// @log 9
// CONTRACT (must-RUN): the property-PATH spelling of the same rule. `if o.v != null {
// print(o.v.length)   o.v = null }` was "cannot assign null to string" — the assignment's
// target type came out of the narrowing overlay instead of the field's declared type,
// with no read involved and no soundness rule behind it. It is the residue #1444 left
// (its item (d)) and it has the same root as the bare-name leak, so it is fixed by the
// same `writeStorageTy`.
//
// THE PLACE LEG IS PINNED BOTH WAYS. A write to a DIFFERENT field of the same object
// leaves the narrowing standing (`o.w = null` then `o.v.length` still reads 4), while a
// write to the guarded path itself, or to a PREFIX of it, ends it. A rule that retired
// on any write to the object would reject the `o.w` leg.

type In = { v: string | null }
type Out = { a: In, w: i32 | null }

function fieldWrite() {
  const b: In = { v: "ab" }
  if b.v != null {
    print(b.v.length) // 2
    b.v = null
  }
  print(1)
}

function otherFieldKeepsIt() {
  const o: Out = { a: { v: "abcd" }, w: 7 }
  if o.a.v != null {
    o.w = null // a different field — the narrowing survives it
    print(o.a.v.length) // 4
    o.a.v = null
  }
  print(3)
}

function nestedPath() {
  const o: Out = { a: { v: "xyz" }, w: 7 }
  if o.a.v != null {
    if o.w != null {
      print(o.w) // 7
    }
    o.a.v = null
  }
  print(9)
}

fieldWrite()
otherFieldKeepsIt()
nestedPath()
