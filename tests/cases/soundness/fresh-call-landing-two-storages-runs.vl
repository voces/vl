// @run
// @log 1
// @log 15
// @log 1
// @log 16
// @log 1
// @log 17
// D8301: a maker's calls landing on two records that store a field differently are each copied
// where they land: directly, through a generic identity (D15712), and as an argument.
type J = { r: i32 | null, g: i32 }
type K = { r: i32 | null, g: i32 | null }
function idn<T>(v: T): T { v }
function mkA() { { r: 15, g: 1 } }
function mkB() { { r: 16, g: 1 } }
function mkC() { { r: 17, g: 1 } }
function h(k: K) { print(k.g ?? 0) }

const a: J = mkA()
const b: K = mkA()
const c: J = idn(mkB())
const d: K = idn(mkB())
const e: J = mkC()
h(mkC())
print(a.r ?? 0)
print(b.g ?? 0)
print(c.r ?? 0)
print(d.g ?? 0)
print(e.r ?? 0)
