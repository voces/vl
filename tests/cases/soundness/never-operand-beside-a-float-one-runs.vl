// @run
// @log 2.5
// @log 1.5
// @log true
// @log 2.5
// @log 5
// An operator whose left operand is a call that never returns computes at its other operand's
// width: an f64 or f32 one reaches its own float op, and the destination takes it as it stands
// (D17064).
function fail(): never { __trap__() }
function mul(c: boolean, x: f64) {
  if c { return x }
  return fail() * x
}
function sub(c: boolean, x: f32) {
  if c { return x }
  return fail() - x
}
function lt(c: boolean, x: f64) {
  if c { return true }
  return fail() < x
}
function bound(c: boolean, x: f64) {
  if c { return x }
  const y: f64 = (fail() + x) * 2.0
  return y
}
function wide(c: boolean, x: i64) {
  if c { return x }
  return fail() + x
}
print(mul(true, 2.5))
print(sub(true, 1.5 as f32))
print(lt(true, 1.0))
print(bound(true, 2.5))
print(wide(true, 5 as i64))
