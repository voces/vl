// @run
// @log 3
// @log 0
// @log 0
// @log none
// @log x
// @log s
// @log 4
// @log 9
// @log 2
// @log 6
// @log three
// @log other
// `a?.b?.v ?? d` where `v` is a union box field that can itself hold `null`, at the end of a
// chain: a parameter root, a local root, a global root, a three-link chain, a scalar and a union
// result, in a return, an argument, a binding, a loop and an `if`.
type In = { v: i32 | string | null }
type Mid = { inner: In | null }
type Out = { mid: Mid | null }
const g: Mid | null = { inner: { v: 4 } }
function show(x: i32 | string) { print(x) }
function ret(m: Mid | null) { return m?.inner?.v ?? 0 }
function arg(m: Mid | null) { show(m?.inner?.v ?? "none") }
function local() {
  const m: Mid | null = { inner: { v: "s" } }
  const r = m?.inner?.v ?? "d"
  return r
}
function glob() { return g?.inner?.v ?? 1 }
function three(o: Out | null) { return o?.mid?.inner?.v ?? 2 }
function loop(ms: (Mid | null)[]) {
  let t = 0
  for m in ms {
    const x = m?.inner?.v ?? 1
    if x is i32 { t = t + x }
  }
  return t
}
function cond(m: Mid | null) {
  if (m?.inner?.v ?? 0) == 3 { print("three") } else { print("other") }
}
print(ret({ inner: { v: 3 } }))
print(ret({ inner: null }))
print(ret(null))
arg({ inner: { v: null } })
arg({ inner: { v: "x" } })
print(local())
print(glob())
print(three({ mid: { inner: { v: 9 } } }))
print(three({ mid: null }))
print(loop([{ inner: { v: 5 } }, null, { inner: { v: "q" } }]))
cond({ inner: { v: 3 } })
cond(null)
