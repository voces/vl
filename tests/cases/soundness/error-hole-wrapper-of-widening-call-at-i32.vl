// @check
// @error-at 10:15 f64 doesn't fit in i32
// @error-at 11:5 argument 1: expected i32, got f64
// @error-at 13:16 f64 doesn't fit in i32
// @error-at 18:16 f64 doesn't fit in i32
// D8220: a wrapper returning a direct call of an un-annotated function takes that call's result
// at the wrapper's bound argument, so `w(3)` is an `f64` and is refused at an `i32` binding, an
// `i32` argument, through a second wrapper level and through a lambda wrapper.
function half(a) { return a / 2.0 }
function w(x) { return half(x) }
const r: i32 = w(3)
take(w(3))
function w2(x) { w(x) }
const r2: i32 = w2(3)
function take(v: i32) { print(v) }
print(r)
print(r2)
const wl = (x) => half(x)
const r3: i32 = wl(3)
print(r3)
