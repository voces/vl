// @run
// @log 7
// @log 8
// @log 7
// @log 9
// @log 4
// A fresh list binding spread into a push is delivered whole as the list, so it is built at a
// wider annotated element, or at the receiver's wider build (D15287).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const wideJ: J = mk()
const xs = [mk()]
const more = [{ f: 7 }, { f: 8 }]
xs.push(...more)
print(xs[1].f ?? 0)
print(xs[2].f ?? 0)
print(more[0].f ?? 0)
const ys: J[] = [{ f: 4 }]
const rest = [{ f: 9 }]
ys.push(...rest)
print(ys[1].f ?? 0)
print(wideJ.f ?? 0)
