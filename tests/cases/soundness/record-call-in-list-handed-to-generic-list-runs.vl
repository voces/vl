// @run
// @log 3
// @log 4
// @log 1
// @log 6
// @log 16
// @log 11
// D14733: a list literal of calls built at a wider record is handed to a generic list parameter
// at that record, where the list is only indexed or measured and the result read for a field.
type Circle = { r: i32 | null }
function sink(_x: Circle) {}
function mkcall() { { r: null } }
function first<T>(xs: T[]): T { xs[0] }
function n<T>(xs: T[]): i32 { xs.length }
function rr<T>(xs: T[]): i32 { xs[0].r ?? 16 }
sink(mkcall())
const y = first([mkcall()])
print(y.r ?? 3)
print(first([mkcall()]).r ?? 4)
print(n([mkcall()]))
print(first([mkcall(), mkcall()]).r ?? 6)
print(rr([mkcall()]))
const f = () => first([mkcall()]).r ?? 11
print(f())
