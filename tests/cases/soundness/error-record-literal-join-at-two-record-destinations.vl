// @check
// @error `q` holds only a literal, so it is built at the type it is delivered to, but it is delivered as D (line 11) and as E (line 12)
// D3441: a literal binding delivered through an `if` arm adopts the record the join is delivered
// to, so a second delivery at a record that stores the same field differently is the two-demands
// refusal, as it is for two plain deliveries.
type D = { v: f64 }
type E = { v: i64 }
const c = true
const q = { v: 7 }

const d: D = if c { q } else { { v: 2 } }
const e: E = q
print(d.v)
print(e.v)
