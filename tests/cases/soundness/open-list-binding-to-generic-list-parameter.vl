// @run
// @log 0
// @log 0
// @log 3
// @log 4
// @log 1.5
// @log 2.5
// @log -1
// @log 0
// @log 0
// @log 0
// @log 1
// An un-annotated `[]` binding handed to a parameter that spells the callee's own type parameter
// keeps its element open: the call binds the parameter at the element the row settles at, the
// unbound default when nothing writes it (D16758).
function probe<V>(v: V[]) { return v.length }
function pair<V>(a: V[], b: V): V {
  if a.length > 0 { return a[0] }
  return b
}
function first<V>(v: V[], d: V): V {
  if v.length > 0 { return v[0] }
  return d
}
function opt<V>(v: V[] | null) {
  if v == null { return 0 - 1 }
  return v.length
}
function field<V>(r: { v: V[] }) { return r.v.length }
function inner<T>(x: T) {
  const a = []
  print(probe(a))
  a.push(x)
  return a.length
}
function local() {
  const e = []
  print(probe(e))
}
const e = []
print(probe(e))
local()
const p = []
print(pair(p, 3))
p.push(4)
print(p[0])
const f = []
print(first(f, 1.5))
f.push(2.5)
print(first(f, 0.5))
print(opt(null))
const o = []
print(opt(o))
const g = []
print(field({ v: g }))
print(inner(2.5))
