// @check
// @error-at 12:18 this record, returned by a call, is fresh and type-valid here, but not supported yet: it is not built where a list holding elements built as J (line 13) takes it
// A `const` holding a generic's call, as a part of a list literal beside a part built at a wider
// record, is refused at the part, as a plain function's is (D15375); the calls themselves are
// copied into the list's build (D15652).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const wideJ: J = mk()
const xs = [mk()]
function id<T>(v: T): T { v }
function idh(v) { v }
const o = id({ f: 1 })
const a = [xs[0], o]
const b = [xs[0], id({ f: 2 })]
const c = [...xs, idh({ f: 3 })]
print(a.length + b.length + c.length)
print(wideJ.f ?? 0)
