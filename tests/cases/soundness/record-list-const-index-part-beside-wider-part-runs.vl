// @run
// @log 1.25
// @log 1.25
// @log 1.25
// @log 1.25
// An element read of a fresh list `const` beside a part built at a wider record builds the list
// there, as a spread of it does (D16610): beside a literal, after a held part, of a nullable
// element, and the spread list's own read.
const s = [{ x: 1 }]
const v = [s[0], { x: 2.5 }]
print(v[0].x + 0.25)
const a = { x: 2.5 }
const t = [{ x: 1 }]
const w = [a, t[0]]
print(w[1].x + 0.25)
const n = [{ x: 1 }, null]
const u = [n[0], { x: 2.5 }]
print((u[0] ?? { x: 0.0 }).x + 0.25)
print(s[0].x + 0.25)
