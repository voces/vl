// @run
// @log 4
// A maker called more than once keeps its own record; its call is copied where it lands wider.
// A `??` default holding a call, over a map read of a maker's calls, inside a record literal
// runs (D15316).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const m = Map()
m.set("a", mk())
const wm: {[string]: J} = Map()
wm.set("a", mk())
function mkd() { { f: 1 } }
const dl = mkd()
const xs = { g: m.get("a") ?? dl }
print(xs.g.f ?? 0)
