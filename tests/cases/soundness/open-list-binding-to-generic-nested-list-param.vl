// @log 1
// @log 1
// An un-annotated `[]` binding handed to a generic `V[][]` parameter stays a list of lists whose
// inner element the call binds `V` at once the program's writes settle it (D16760).
function probe<V>(v: V[][]) { return v.length }
function test<V>(v: V[][] | string) {
  if v is f64[][] { return 1 }
  return 0
}
const e = []
print(probe(e))
const w = []
print(probe(w))
w.push([2.5])
print(probe(w))
print(w[0][0])
function local() {
  const l = []
  print(probe(l))
  l.push(["a"])
  l.push([])
  print(probe(l))
}
local()
const o = []
print(test(o))
const f = []
f.push([2.5])
print(test(f))
