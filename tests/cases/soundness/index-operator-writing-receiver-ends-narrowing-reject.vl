// @check
// @error-at 11:2 non-exhaustive match — missing "a" (add the arm or a `_`) — 'b.kind' is no longer narrowed to "b" | "c": the call to 'poke' on line 11 may reassign it; re-test 'b.kind' after the call
// D5590, D5591: an index on a record still dispatches to its declared operator, so a narrowing
// of the field that operator writes ends at the call. Line and column are 0-based.
type Box = { kind: "a" | "b" | "c" }
function "[]="(self: Box, _i: i32, _v: i32) { self.kind = "a" }
function "[]"(self: Box, i: i32): i32 { i }
function poke(b: Box) { b[0] = 5 }
function act(b: Box): string {
  if b.kind == "a" { return "a" }
  poke(b)
  match b.kind {
    "b" => "b"
    "c" => "c"
  }
}
print(act({ kind: "b" }))
