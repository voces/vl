// @run
// @log 3
// @log true
// @log 5
// @log 7
// @log false
// @hint redundant type annotation: `r0` is inferred as `{f: boolean}`
// @hint redundant type annotation: `r1` is inferred as `{f: i32}`
// @hint redundant type annotation: `o` is inferred as `{w: {v: i32}}`
// @hint redundant type annotation: `dd` is inferred as `{v: boolean}`
// D2890. A record literal is built at a declared record of its field names only when each
// field's type fits that record's: `i32` and `boolean` share a slot code but read as
// different values, whichever other records of that field name the program holds.
const r0: { f: boolean } = { f: true }
const r1: { f: i32 } = { f: 3 }
const r2: { f: i64 } = { f: 5 }
print(r1.f)
print(r0.f)
print(r2.f)
type D = { v: boolean }
const o: { w: { v: i32 } } = { w: { v: 7 } }
print(o.w.v)
const dd: D = { v: false }
print(dd.v)
