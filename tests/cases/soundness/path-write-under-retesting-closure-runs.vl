// @run
// @log false
// @log true
// @log false
// @log 5
// A write of a narrowed field or cell's other member runs while a nested function only re-tests
// it or does not read it: the re-test reads the storage, and nothing reads the old narrowing
// (D16297).
type O = { v: i32 | string }
const o: O = { v: 1 }
const xs: (i32 | string)[] = [1]
if xs[0] is i32 {
  const c = (): boolean => xs[0] is i32
  xs[0] = "s"
  print(c())
  xs[0] = 4
  print(c())
}
if o.v is i32 {
  const d = (): boolean => o.v is i32
  o.v = "s"
  print(d())
}
if xs[0] is i32 {
  const e = (): i32 => 5
  xs[0] = "t"
  print(e())
}
