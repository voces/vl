// @check
// @error-at 19:11 operator '*' is not defined for boolean | f64 and f64 — 'v' is no longer narrowed to f64: the call to 'k3' on line 19 may reassign it; re-test 'v' after the call
// @error-at 37:11 operator '*' is not defined for boolean | f64 and f64 — 'v' is no longer narrowed to f64: the call on line 37 may reassign it; re-test 'v' after the call
// @error-at 54:11 operator '*' is not defined for boolean | f64 and f64 — 'v' is no longer narrowed to f64: the call to 'run' on line 54 may reassign it; re-test 'v' after the call
// @error-at 72:8 operator '*' is not defined for boolean | f64 and f64 — 'mv' is no longer narrowed to f64: the operator '+' on line 72 may reassign it; re-test 'mv' after the call
// D2390: a writer that another closure returns, stores or passes on has escaped, even though
// it is only ever named inside that closure; and an operator whose declaration calls a writer
// reaches it. Each read after the call is refused. Line and column are 0-based.

// A reacher returns the writer.
function returned(): f64 {
  let v: boolean | f64 = 1.5
  const k = () => {
    v = true
  }
  const r = () => k
  const k3 = r()
  if v is f64 {
    k3()
    return v * 2.0
  }
  0.0
}

// A reacher stores the writer in a list.
function stored(): f64 {
  let v: boolean | f64 = 1.5
  const fs: (() => void)[] = []
  const k = (): void => {
    v = true
  }
  const reg = () => {
    fs.push(k)
  }
  reg()
  if v is f64 {
    fs[0]()
    return v * 2.0
  }
  0.0
}

// A reacher passes the writer into a record.
type O = { run: () => void }
function mk(g: () => void): O { { run: g } }
function passed(): f64 {
  let v: boolean | f64 = 1.5
  const k = (): void => {
    v = true
  }
  const wrap = (): O => mk(k)
  const o = wrap()
  if v is f64 {
    o.run()
    return v * 2.0
  }
  0.0
}

// A declared operator whose body calls a named writer.
type P = { x: i32 }
let mv: boolean | f64 = 1.5
const mk2 = () => {
  mv = true
}
function "+"(self: P, b: P): P {
  mk2()
  { x: self.x + b.x }
}
const p: P = { x: 1 }
if mv is f64 {
  const q = p + p
  print(mv * 2.0 + q.x as f64)
}

print(returned() + stored() + passed())
