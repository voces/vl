// @check
// @error 'o.v' was narrowed by a guard, but the call to 'clr' on line 18 can write it
// VERDICT PIN (must-error), and the highest-value cell of the aliased-write grid: this
// rep did not TRAP. `boolean | null` is a boxed union, so the stale narrowing made a
// check-clean program PRINT `null` where its type said `boolean` — a silently wrong
// value, not a crash. The rep axis is not flat: `string | null` trapped `null
// reference`, `i32 | null` trapped `cast failure`, and this one printed garbage, all
// from the same one-line defect.
//
// A trap and a wrong value are different failures and the fix has to cover both, which
// is why the field rep is its own axis rather than one representative.
type O = { v: boolean | null }

function clr(o: O) { o.v = null }

const o: O = { v: true }
if o.v != null {
  clr(o)
  print(o.v)
} else {
  print(0)
}
