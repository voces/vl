// @run
// @log null
// The boxed-rep cell of the aliased-write grid: `boolean | null` is a boxed union, so a stale
// narrowing here printed a wrong value rather than trapping. `clr(o)` ends the `o.v` narrowing
// after its statement, and the read below it is at the declared type, printing `null` (D2405).
type O = { v: boolean | null }

function clr(o: O) { o.v = null }

const o: O = { v: true }
if o.v != null {
  clr(o)
  print(o.v)
} else {
  print(0)
}
