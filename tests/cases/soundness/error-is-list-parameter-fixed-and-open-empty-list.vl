// @check
// @error a parameter tested by `is` against a list type is handed an empty list whose element type is fixed
// @error a parameter tested by `is` against a list type is handed an empty list whose element type is fixed

// One body cannot answer a list `is` test both by an annotated empty list's element type and by an
// empty list nothing fixed, so a parameter reached by both is refused at both calls until inferred
// interfaces record the per-call fact (D16342).
function take(v) { return v is f64[] }
const e: i32[] = []
print(take(e))
print(take([]))
