// @run
// @log b
// @log 1
// @log a
// @log b
// @log a
// @log b
// @log a
// @log a
// @log 0
// @log 1
// @log a
// @log b
// @log a
// @hint redundant type annotation: `y` is inferred as `S`
// @hint redundant type annotation: `y` is inferred as `S`
// @hint redundant type annotation: `y` is inferred as `S`
// D4946: under `s is S[]` the parameter of a `map`/`filter` callback over `s` and a `for`
// variable over `s` read as `S`, so `s.map((x) => x)` is an `S[]` copy at every nesting depth,
// annotated or inferred, and a later write to `s` does not reach it.
type S = "a" | "b"
type K = 0 | 1
const s = ["a", "b"]
let keep: S[] = []
if (s is S[]) {
  const t = s.map((x) => x)
  print(t[1])
  keep = s.map((x) => x)
  const f = s.filter((x) => {
    const y: S = x
    y == "a"
  })
  print(f.length)
  for x in s {
    const y: S = x
    print(y)
  }
}
const m: string[][] = [["a"], ["b", "a"]]
let mm: S[][] = []
if (m is S[][]) {
  mm = m.map((r) => r.map((x) => x))
  for r in m {
    for x in r {
      const y: S = x
      print(y)
    }
  }
}
s[0] = "zz"
m[0][0] = "zz"
print(keep[0])
const n = [[0], [1, 0]]
let nn: K[][] = []
if (n is K[][]) { nn = n.map((r) => r.map((x) => x)) }
n[0][0] = 5
print(nn[0][0])
print(nn[1][0])
print(mm[0][0])
print(mm[1][0])
print(mm[1][1])
