// @run
// @log 5
// @log 5
// @log 0
// @log 0
// @log 5
// @log false

// D2603: a nullable arm of a declared struct union (`A | null` beside `A | B | null`) is tested
// through an assignment the way a plain nullable struct is.
type A = { r: i32 }
type B = { s: string }
function mkA(n: i32): A | null {
  if n == 0 { return null }
  { r: n }
}
function mx(n: i32): A | B | null {
  if n == 0 { return null }
  { s: "b" }
}
function go(n: i32) {
  let x = mkA(2)
  if (x = mkA(n)) != null { print(x.r) } else { print(0) }
  if (x = mkA(n)) == null { print(0) } else { print(x.r) }
}
function guard(n: i32) {
  let x = mkA(2)
  if (x = mkA(n)) == null { print(0); return }
  print(x.r)
}
go(5)
go(0)
guard(5)
print(mx(1) == null)
