// @run
// @log 3
// @log 7.5
// @log 4
// A list literal holding a spread of a fresh record list `const` is a new list, so a widening
// push onto it writes no list of the spread's (D16614), bare or nullable element alike.
const s = [{ x: 1 }]
const v = [...s, { x: 2.5 }]
v.push({ x: 7.5 })
print(v.length)
print(v[2].x)
const n = [{ x: 1 }, null]
const w = [...n, { x: 2.5 }]
w.push({ x: 7.5 })
print(w.length)
