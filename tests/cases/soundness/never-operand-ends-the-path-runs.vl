// @run
// @log 1
// @log 2
// @log true
// An arithmetic or comparison operator over a `never` operand, a function's or a lambda's call, is
// `never`: the path ends at the operand, so the live path runs (D14420).
function fail(): never { __trap__() }
const f = (): never => fail()
function a(c: boolean): i32 { if c { return 1 } f() + 1 }
function b(c: boolean): i32 { if c { return 2 } 1 - f() }
function d(c: boolean): boolean { if c { return true } fail() < 2 }
print(a(true))
print(b(true))
print(d(true))
