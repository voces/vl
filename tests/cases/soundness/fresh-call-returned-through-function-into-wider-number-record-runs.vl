// @run
// @log 12000000000
// @log 12000000000
// @log 12000000000
// @log 12000000000
// @log 12000000000
// @log 12000000000
// @log 4
// @hint redundant type annotation: `ownN` is inferred as `i32`
// A record a call builds at its own row, also read there, delivered through inferred functions
// into a record storing a field as a wider number, is copied at the delivery as the direct
// spelling is; a chain whose function has no other read is built wide (D15216).
type R = { n: i64, s: string }
function mk() { { n: 3, s: "a" } }
const own = mk()
const ownN: i32 = own.n + 1
function f() { return mk() }
const v: R = f()
print(v.n * 4000000000)
function fb() { mk() }
const vb: R = fb()
print(vb.n * 4000000000)
function fh() {
  const r = mk()
  return r
}
const vh: R = fh()
print(vh.n * 4000000000)
function fg() { mk() }
function g() { fg() }
const vg: R = g()
print(vg.n * 4000000000)
function use(r: R) { r.n * 4000000000 }
function fu() { mk() }
print(use(fu()))
function mk2() { { n: 3, s: "b" } }
function f2() { mk2() }
function g2() { f2() }
const w: R = g2()
print(w.n * 4000000000)
print(ownN)
