// @check
// @error `==` compares values, and a map has no defined equality: `A | i32` and `A` can both hold one
// CONTRACT (must-error): a map has no defined value equality (T7.3), so `==` between a union and
// a value that can both hold one is refused at check, as the bare compare is (D16611).
type A = { m: {[string]: i32} }
const u: A | i32 = 3
const x: A = { m: Map() }
print(u == x)
