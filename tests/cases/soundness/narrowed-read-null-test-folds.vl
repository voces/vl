// @run
// @log 5
// @log 5
// @log false
// @log 5
// @log true
// @log 6
// @log 6
// @log present
// @log 5
// @log 2
// @log 2
// CONTRACT (must-RUN): a null TEST on a binding an ASSIGNMENT narrowing already proved
// non-null. Each leg prints the folded test and then the VALUE the same binding holds at the
// same point — a fold that reached the wrong rep cannot agree with the read beside it.
//
// EVERY LEG IS `vl check` rc 0 AND `emitProgram: bare null needs a struct-typed context`
// before this change. The checker keeps an assignment-narrowed null test MEANINGFUL on
// purpose — it asks the DECLARED type, which is what makes `let xs: S[] | null = []` /
// `xs = […]` / `if xs != null` compile — while the emitter read the narrowed rep, reached no
// arm of the null-test ladder, and fell out to the i32 compare with a bare `null` nothing
// could type. The reconciliation belongs in the emitter: the test is DEAD, so it folds.
//
// A redundant null test inside a live GUARD narrowing is a different verdict — the checker
// rejects it (`cannot compare i32 with null`) — so the assignment kind is the only spelling
// that reaches the emitter at all.
//
// THE BOUNDARY IS PINNED IN BOTH DIRECTIONS: `nullStaysNull` is the same test over a binding
// no narrowing covers, and it must still answer at RUNTIME rather than fold.

type K = "aa" | "bb"

// `!= null` in statement position: the guard the checker deliberately keeps meaningful.
function testAfterAsg() {
  let x: i32 | null = null
  x = 5
  if x != null {
    print(x)
  }
  print(x)
}

// `== null` in VALUE position folds to the constant the narrowing proves, and the binding
// still holds what was written to it.
function eqNullValue() {
  let x: i32 | null = null
  x = 5
  print(x == null)
  print(x)
}

// The other direction, with NO narrowing: the test is a real runtime read.
function nullStaysNull() {
  const n: i32 | null = null
  print(n == null)
}

// The fold does not disturb the narrowed read it guards.
function testThenArith() {
  let x: i32 | null = null
  x = 5
  if x != null {
    print(x + 1)
  }
  print(x + 1)
}

// The ELSE arm of a folded test is unreachable, and the reachable arm is the right one.
function elseArm() {
  let x: i32 | null = null
  x = 5
  if x == null {
    print("absent")
  } else {
    print("present")
  }
  print(x)
}

// A litunion asks the same question of the i32 atom-id niche.
function litUnionTest() {
  const v: K = "bb"
  let x: K | null = null
  x = v
  if x != null {
    print(2)
  }
  print(2)
}

testAfterAsg()
eqNullValue()
nullStaysNull()
testThenArith()
elseArm()
litUnionTest()
