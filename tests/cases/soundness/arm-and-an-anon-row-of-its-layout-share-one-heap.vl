// GRADUATED from `@no-instantiate` (silent-class-inventory D282, 2026-08-28). Program 1
// below was the check-clean-invalid-wasm SPECIMEN — `tests/vl_check_codegen_test.ts`'s
// `INVALID_MODULE_SRC` — verbatim. It printed `type mismatch: expected (ref null $type),
// found (ref $type)` out of a `vl check` that exited 0 with one redundant-annotation hint
// and no errors. It runs.
//
// WHAT CLOSED IT IS D280's ARGUMENT AT AN ANONYMOUS CLAIMANT. D280 merged a union ARM with a
// DECLARED struct of the arm's exact layout, on the ground that the checker accepts either
// wherever the other is expected and two acceptances must not be two WasmGC heap types. Its
// key is `repSlotOfTy(uVarTyIx[vi])`, and that bridge answers only for a DECLARED row
// (`repSlotCacheSync` scans `sRowDecl[si] == 1`). An interned `#anonN` row — minted by
// `collectAnonShapes` from an object literal no context could name — is a claimant of the
// same layout that the bridge cannot see, and the checker says so out loud on program 1:
// `dleaf` is annotated `Circle` and INFERRED as `{r: i32}`.
//
// THE COMPLEMENT WAS ALREADY WRITTEN. `repRowOfTyStruct` is the same double gate
// (`slotCanonId` key + `structFieldCodesEq` layout) lifted to a whole-table scan keyed on an
// arena type instead of a second slot, and `slotCanonId`'s arena rung covers exactly the
// `#anon` rows the name path cannot resolve. One confirm-only line under the declared
// answer, so every module that had a merge keeps the merge it had.
//
// THE DISASSEMBLY IS THE WHOLE DIAGNOSIS. Before, program 1's rec group carried THREE
// identical `(struct (field (mut i32)))` — the `#anon` row the map's value slot uses, then
// `Circle`'s variant heap, then `Sq`'s — and the `??` result local was typed `(ref null
// $anon)` while its ELSE arm loaded a global declared `(mut (ref $Circle))`. Now the rec
// group carries TWO, the global is `(mut (ref $anon))`, and the identical `global.get` is
// well typed. One heap type fewer; nothing else in the module moves.
//
// PROGRAM 2 IS THE BOX A MERGED HEAP STILL NEEDS, at six coordinates the D280 landing did
// not reach. That merge made `emitUnionCoerce`'s equal-heap arm reachable for a DECLARED
// twin and gave it the box (D281); this one makes it reachable for an ANONYMOUS row, and
// program 2 is the shape that needs it. Ablated rather than argued: strip D281's rung and
// program 2 is check-clean invalid wasm, while program 1 still runs.
//
// PROGRAM 4 IS THE INERTNESS CONTROL. It declares the twin, so `repSlotOfTy` answers and the
// new rung is never reached — counted at the site: `declAnswered=1 anonReach=1
// anonAnswered=0` on program 4's shape against `declAnswered=0 anonReach=2 anonAnswered=1`
// on program 1's.

// @hint redundant type annotation: `dleaf` is inferred as `{r: i32}` — remove it to lean on inference
// @hint redundant type annotation: `dleaf3` is inferred as `{r: i32}` — remove it to lean on inference
// @hint redundant type annotation: `dleaf4` is inferred as `{r: i32}` — remove it to lean on inference
// THE HINT IS DECLARED, NOT DELETED: `dleaf: Circle` is the ONLY nominal claim in program 1,
// and the checker calling it redundant is the disagreement the row is about.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function fill(c, n: i32) { c["k1"] = { r: n } }
const c = Map()
fill(c, 7)
const dleaf: Circle = { r: 0 }
print((((c)["k1"] ?? dleaf)).r)

// PROGRAM 2 — the same anonymous row read back out and BOXED into the union. The merge makes
// the payload heap already right; the box is still required.
type Circle2 = { r: i32 }
type Sq2 = { z: i32 }
type Shape2 = Circle2 | Sq2
function fill2(c, n: i32) { c["k1"] = { r: n } }
const c2 = Map()
fill2(c2, 7)
const sh2: Shape2 = ((c2)["k1"] ?? { r: 0 })
if sh2 is Circle2 { print(sh2.r) } else { print(0) }

// PROGRAM 3 — the depth-2 sibling, `read x param x arm x notwin x d2` of the D156 annotation-
// position grid. The six cells of that shape were the whole of that grid's surviving silent
// population after D280.
type Circle3 = { r: i32 }
type Sq3 = { s: i32 }
type Shape3 = Circle3 | Sq3
function fill3(c, n: i32) {
  const l1 = Map()
  l1["k1"] = { r: n }
  c["k2"] = l1
}
const c3 = Map()
fill3(c3, 7)
const d1: {[string]: Circle3} = Map()
const dleaf3: Circle3 = { r: 0 }
print((((((c3)["k2"] ?? d1))["k1"] ?? dleaf3)).r)

// PROGRAM 4 — THE INERTNESS CONTROL: the same program with the layout twin DECLARED, so
// D280's own rung answers and this change's does not run at all. It ran before and runs now.
type Circle4 = { r: i32 }
type Sq4 = { z: i32 }
type Shape4 = Circle4 | Sq4
type Dot4 = { r: i32 }
function fill4(c, n: i32) { c["k1"] = { r: n } }
const c4 = Map()
fill4(c4, 7)
const dleaf4: Circle4 = { r: 0 }
print((((c4)["k1"] ?? dleaf4)).r)
