// @run
// @log 1.5
// @log 3
// @hint redundant type annotation: `x` is inferred as `i32`
// D2996, D8201: a record a function with no declared result builds is built at the record its
// calls deliver it to, an `i32` field converted to a bare `f64` one, when every call lands on
// that record's storage; here two sites (D3444, DECISIONS.md "Record covariance").
type D = { v: f64 }
const x: i32 = 3
function mk() { return { v: x } }
const d: D = mk()
print(d.v / 2.0)
const e: D = mk()
print(e.v)
