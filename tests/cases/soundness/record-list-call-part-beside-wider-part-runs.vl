// @run
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// A call's fresh record, or a `const` of one, as a part of a list literal beside a part at a wider
// record is copied into that record, as beside a part built elsewhere (D16441, D16442). One maker
// per position: after a held part, before it, a `const` of the call, and a maker called twice.
function mk1() { return { x: 1 } }
function mk2() { return { x: 1 } }
function mk3() { return { x: 1 } }
function mk4() { return { x: 1 } }
const a = { x: 2.5 }
const l1 = [a, mk1()]
print(l1[1].x)
const l2 = [mk2(), a]
print(l2[0].x)
const m = mk3()
const l3 = [a, m]
print(l3[1].x)
function atInt(v: { x: i32 }) { print(v.x) }
const n = mk4()
const l4 = [a, n]
print(l4[1].x)
atInt(mk4())
