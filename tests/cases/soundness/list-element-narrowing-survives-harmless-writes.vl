// @run
// @log 1
// @log 0
// @log 1
// @log 1
// @log 0
// @log 1
// @log 5
// D4926's other half: `v is K[]` survives writes that cannot break it. Calls that write a
// list of another element type, a direct store or push of a `K` (checked against the
// narrowed element), and the same inside a loop all keep every element a `K`.
type K = 0 | 1
const v = [0, 1]
const names = ["a"]
const other = ["p"]
const g = () => {
  names[0] = "b"
}
const h = () => {
  other.push("q")
}
const show = (x: K) => {
  print(x)
}
if (v is K[]) {
  g()
  h()
  v[0] = 1
  v.push(0)
  show(v[0])
  show(v[2])
  for x in v { show(x) }
  let i = 0
  while i < 2 {
    v.push(1)
    v[i] = 0
    i = i + 1
  }
  show(v[3])
}
print(v.length)
