// @run
// @log 4
// @log 16000000000
// @log 5
// @log 16000000000
// @log a
// @log 16000000000
// A function's record result kept at its own row beside a delivery to a record that stores a
// nested number wider is copied at that delivery, each nested record at its own row (D15264).
type J = { f: i64 }
type K = { j: J }
function mk() { { j: { f: 4 } } }
const _k: K = mk()
const y = mk()
print(y.j.f)
print(_k.j.f * 4000000000)
type I = { g: i64 }
type L = { j: { i: I, s: string }, n: i32 }
function mk3() { { j: { i: { g: 4 }, s: "a" }, n: 1 } }
const _l: L = mk3()
const z = mk3()
print(z.j.i.g + z.n)
print(_l.j.i.g * 4000000000)
print(_l.j.s)
function take(k: K) { k.j.f * 4000000000 }
print(take(mk()))
