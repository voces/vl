// @run
// @log true
// @log false
// @log 2
// @log false
// One call delivers an inferred function's result into a wider record or record list, and another
// use keeps it at its own type. The delivery is copied where it lands, a list of row unions arm by
// arm, so the body stays at its own type for the other use (D14385).
type Cir2 = { c2: i32 }
type Sq2 = { s2: i32 }
type Circle = { r: Cir2 | Sq2 }
function mk() { return { r: { c2: 1 } } }
function rows() { [{ r: { c2: 1 } }, { r: { s2: 5 } }] }
const h = mk()
print(h.r is Cir2)
const h2: Circle = mk()
print(h2.r is Sq2)
const l = rows()
print(l.length)
const l2: Circle[] = rows()
print(l2[0].r is Sq2)
