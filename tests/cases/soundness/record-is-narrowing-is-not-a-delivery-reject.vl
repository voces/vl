// VERDICT PIN (must-error, D4084): `a is B` fits `a` by its fields' current values, and
// the caller's `A` still writes them, so `a` is read as `B` but never delivered as one:
// returned, passed, pushed, assigned, or stored in a field or an element. The copy runs.
type A = { x: i32 }
type B = { x: 1 | 2 }
type H = { v: B }
const keep: B[] = []
let g: B = { x: 1 }
function k(b: B) { keep.push(b) }
function ret(a: A): B {
  if a is B { return a }
  { x: 1 }
}
function deliver(a: A) {
  if a is B {
    k(a)
    keep.push(a)
    g = a
    const h: H = { v: a }
    const xs: B[] = [a]
    const c: B = a
    print(h.v.x + xs[0].x + c.x)
    const y: 1 | 2 = a.x
    print(y)
  }
}
deliver({ x: 1 })
print(ret({ x: 1 }).x)
