// @run
// @log 4
// @log 4
// @log 1
// @log 4
// @hint Intentionally-unused variable `_wx`
// A read of a container whose values are built wider, defaulted with `??` to a record literal and
// bound un-annotated, is held at the container's record, and the literal is built there (D15230).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const m = Map()
m.set("a", mk())
const wm: {[string]: J} = Map()
wm.set("a", mk())
const b = m.get("a") ?? { f: 1 }
print(b.f)
const c = m["a"] ?? { f: 1 }
print(c.f)
const e = m.get("z") ?? { f: 1 }
print(e.f)
const xs = [mk()]
const _wx: J[] = [mk()]
const p = xs.pop() ?? { f: 1 }
print(p.f)
