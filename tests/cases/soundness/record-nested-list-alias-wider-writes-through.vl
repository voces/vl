// @run
// @log 7
// @log 7
// @log 3
// A list of record lists bound wider is the same list: a write through the wider binding is read
// back through the narrower one.
type J = { f: i32 | null }
const more = [[{ f: 7 }]]
const w: J[][] = more
print(w[0][0].f ?? 0)
print(more[0][0].f ?? 0)
w[0][0].f = 3
print(more[0][0].f ?? 0)
