// @run
// @log 3
// @log 3
// @log 4
// @log s
// @log 5
// D3401: a record literal an inferred function returns, built where a delivery stores its union
// field as another union, is returned at that record, so the call's result is built there.
type D = { v: f64 | string }
const x: i32 | string = 3
function mk() { return { v: x } }
const o = mk()
const d: D = o
print(d.v)
const e: D = mk()
print(e.v)
const y: i32 | string = 4
function pick(n: i32) {
  if n > 0 { return { v: y } }
  return { v: "s" }
}
const p: D = pick(1)
print(p.v)
const q: D = pick(0)
print(q.v)
type N = { v: i32 | string | null }
const z: i32 | string = 5
function mkn() { { v: z } }
const n: N = mkn()
print(n.v ?? 0)
