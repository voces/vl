// @run
// @log 7
// @log 7
// @log 7
// @log 4
// @log 7
// @log 4
// @log 7
// @log 7
// @hint redundant type annotation: `i` is inferred as `{f: i32}`
// D2922, D2924 and D2925's decline set: a re-seated list's element read through a call or an
// `if` join, a join with the list itself or with object literals, and a field whose record holds
// the destination's list or record keep running.
const i: { f: i32 } = { f: 4 }
type I = { f: i64 | null }
type H = { xs: I[] }
type H2 = { r: I }
const il = [{ f: 7 }]
const ic: I[] = il
function g() { return il[0] }
print(g().f)
const e = if ic.length > 0 { il[0] } else { il[0] }
print(e.f)
const j = if ic.length > 0 { il } else { il }
print(j[0].f)
print(i.f)
const k = if ic.length > 0 { il } else { [{ f: 3 }] }
print(k[0].f)
print(i.f)
const hh = { xs: il }
print(hh.xs[0].f)
const h: H2 = { r: il[0] }
print(h.r.f ?? 0)
