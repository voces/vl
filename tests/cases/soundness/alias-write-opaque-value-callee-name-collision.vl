// @check
// @error 'o.v' was narrowed by a guard, but the call to 'fp' on line 30 can write it
// INVARIANT PIN — it passes on every compiler whose nested-callee lookup is scoped, so it
// does not distinguish one such compiler from another. What it pins is the OPAQUE
// fallback: a callee that is a function VALUE is not statically one body, so every live
// narrowing retires, and no name-keyed shortcut may answer that call with a declaration.
//
// `fp` is a `const` bound to a function, and an unrelated body declares a nested function
// that HAPPENS TO SHARE THE NAME. The module-level `fp` is the value, so the call must
// stay opaque; a lookup that answers "the nested `fp`" summarises a body that writes
// nothing and accepts the program, which then reads null through the retired narrowing.
//
// This is the direction a wrong answer must never err in: answering "found" where the
// scoped walk finds nothing fails OPEN, while answering "not found" where it would find a
// declaration only over-invalidates.
type O = { v: string | null }

function mut(o: O) { o.v = null }

// The name collision lives inside another body, where it is the only `fp` in scope.
function other() {
  function fp(q: O) { print(q.v ?? "x") }
  fp({ v: "y" })
}

const fp = mut
const o: O = { v: "hi" }

if o.v != null {
  fp(o)
  print(o.v.length)
}

other()
