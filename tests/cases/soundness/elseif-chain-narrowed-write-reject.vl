// @check
// @error cannot assign string to boolean
// WHY THE CHAIN MAY TRUST ITS ARMS — `guard-else-narrowed-write-reject.vl`'s argument,
// carried down a multi-step chain.
//
// The hand-up says "every arm above exited, so the place is the residual below". The only
// way an arm could falsify that is to WRITE a member back into the place on the path that
// falls through. It cannot: a bare name's narrowing is a shadowing `declare`, so the write
// inside the arm is checked against the NARROWED type, not the declared one. By the third
// arm here `x` is a bare `boolean`, and `x = "s"` is a type error there — the diagnostic
// below.
//
// The narrowing is not a ban on assignment: a write the narrowing still admits (`x = false`)
// is accepted and keeps the fact true. That is why the rule is a type check, and why the
// chain needs no invalidation machinery for bare names at all.
function f(x: i32 | string | boolean): boolean {
  if x is i32 { return false }
  else if x is string { return false }
  else { x = "s" }
  return x
}
print(f(true))
