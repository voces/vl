// @check
// @error-at 27:8 operator '*' is not defined for boolean | f64 and f64 — 'v' is no longer narrowed to f64: the operator '[]' on line 27 may reassign it; re-test 'v' after the call
// @error-at 33:8 operator '*' is not defined for boolean | f64 and f64 — 'w' is no longer narrowed to f64: the operator '[]=' on line 33 may reassign it; re-test 'w' after the call
// @error-at 47:11 operator '*' is not defined for boolean | f64 and f64 — 'u' is no longer narrowed to f64: the operator '[]' on line 47 may reassign it; re-test 'u' after the call
// D2390: a user index operator is a call. `p[0]` dispatches to `"[]"` and `p[0] = 3` to `"[]="`,
// so a declaration whose body calls a writer, or any index once a writer has escaped, ends the
// narrowing. Line and column are 0-based.
type P = { x: i32, f: () => void }
let v: boolean | f64 = 1.5
let w: boolean | f64 = 1.5
const k = (): void => {
  v = true
}
const k2 = (): void => {
  w = true
}
function "[]"(self: P, i: i32): i32 {
  k()
  self.f()
  i
}
function "[]="(self: P, i: i32, x: i32) { k2() }
const p: P = { x: 1, f: () => {} }

// The read operator's body calls the writer of `v`.
if v is f64 {
  const q = p[0]
  print(v * 2.0 + q as f64)
}

// The write operator's body calls the writer of `w`.
if w is f64 {
  p[0] = 3
  print(w * 2.0)
}

// A writer escaped into the record the read operator calls through.
function escaped(): f64 {
  let u: boolean | f64 = 1.5
  const r: P = {
    x: 1,
    f: () => {
      u = true
    },
  }
  if u is f64 {
    const q = r[0]
    return u * 2.0 + q as f64
  }
  0.0
}
print(escaped())
