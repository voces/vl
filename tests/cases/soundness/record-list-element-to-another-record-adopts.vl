// @run
// @log 7
// @log 7
// D2933: a list that holds only object literals takes the list type its element is delivered
// to, so its element reaches the declared record at that record's own row.
type J = { f: i32 | null }
type I = { f: i32 }
const il = [{ f: 7 }]
function show(r: J) { print(r.f ?? 1) }
show(il[0])
print(il[0].f ?? 0)
