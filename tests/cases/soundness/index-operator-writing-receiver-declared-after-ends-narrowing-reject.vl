// @check
// @error-at 10:2 non-exhaustive match — missing "a" (add the arm or a `_`) — 'b.kind' is no longer narrowed to "b" | "c": the call to 'poke' on line 10 may reassign it; re-test 'b.kind' after the call
// D5593: index-operator-writing-receiver-ends-narrowing-reject with the writer declared after
// its caller: a real write still ends the narrowing. Line and column are 0-based.
type Box = { kind: "a" | "b" | "c" }
function "[]="(self: Box, _i: i32, _v: i32) { self.kind = "a" }
function "[]"(self: Box, i: i32): i32 { i }
function act(b: Box): string {
  if b.kind == "a" { return "a" }
  poke(b)
  match b.kind {
    "b" => "b"
    "c" => "c"
  }
}
function poke(b: Box) { b[0] = 5 }
print(act({ kind: "b" }))
