// @run
// @log 15
// @log 16
// @log 17
// @log 18
// @log 19
// @log 20
// @log 3.5
// @log 4.5
// D8140, D8143, D3460: a fresh call into a record that stores a field more widely is built at that
// record when it is reached through an un-annotated binding or through a function returning
// the call, even beside a declared record of the call's own fields (`Col`).
type Col = { r: i32, g: i32 }
type J = { r: i32 | null, g: i32 }
function useJ(m: J) { print(m.r ?? 0) }

function mk1() { { r: 15, g: 1 } }
const s1 = mk1()
const a: J = s1
print(a.r ?? 0)

function mk2() { { r: 16, g: 1 } }
const s2 = mk2()
useJ(s2)

function mk3() { { r: 17, g: 1 } }
const s3 = mk3()
const t3 = s3
const c: J = t3
print(c.r ?? 0)

function mk4() { { r: 18, g: 1 } }
function wrap4() { return mk4() }
const d: J = wrap4()
print(d.r ?? 0)

function mk5() { { r: 19, g: 1 } }
function wrap5() { mk5() }
useJ(wrap5())

function mk6() { { r: 20, g: 1 } }
function wrap6() { mk6() }
function outer6() { wrap6() }
const e: J = outer6()
print(e.r ?? 0)

type D = { v: f64 }
function useD(x: D) { print(x.v / 2) }
function mk7() { return { v: 7 } }
const a7 = mk7()
const d7: D = a7
print(d7.v / 2)
function mk8() { return { v: 9 } }
const a8 = mk8()
useD(a8)
