// @run
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// THE ADOPTED LITERAL'S BOXED FIELD, READ — and the CHANNEL that has to move as one
// (silent-class-inventory D209, closed 2026-08-28; the refutation pins are D271, D272, D290).
//
// `structIndexOfObjCtx` resolves an un-annotated `{ r: 7 }` by FIELD-NAME SET, and
// `anonValueFitsField`'s refutation-only widening lets a union-BOX field accept every atom —
// so a declared `type Circle = { r: i32 | null }` anywhere in the file CAPTURES the literal
// and its `r` is emitted BOXED, while the checker still types the value `{r: i32}`. Delete
// the declaration and the same program prints 7; that is D209.
//
// THE CLOSE IS THREE RUNGS ON ONE PREDICATE (`memReadUnboxAtomKind`), and each was measured
// alone: the READ site unboxes, `exprUnion` stops calling the read a union VALUE, and
// `emitUnionCoerce`'s atom ladder takes the atom from the same answer. Any TWO of them lose
// running programs — program 3 below is one of the eight the read+classifier pair loses.
//
// The programs are ordered by which rung they pin.

// 1 — D209's own repro: the adopted read consumed as a bare atom. Was `vl check` rc 0 with
// no diagnostics and "type mismatch: expected i32, found (ref $type)" at run.
type C1 = { r1: i32 | null }
const lv1 = [{ r1: 7 }]
print((lv1[0]).r1)

// 2 — the same read consumed by something that WANTS the box (D272's pin, from the other
// side): the read unboxes AND the coercion boxes it again, so the union binding is still a
// box and `is i32` still narrows.
type C2 = { r2: i32 | null }
const v2 = { r2: 7 }
const q2: i32 | null = (v2).r2
if q2 is i32 { print(q2) } else { print(0) }

// 3 — D290: a STRING atom through the same channel. The read delivers a string ref, and the
// coercion ladder classifies the EXPRESSION — which still reads as a code-16 box — so without
// the third rung it fell to the numeric default and applied `struct.new $vbI32` to a string
// ref. `vl check` rc 0, "expected i32, found (ref $type)".
type C3 = { r3: string | i32 }
const v3 = { r3: "7" }
const q3: string | i32 = (v3).r3
if q3 is string { print(q3) } else { print(0) }

// 4 — the same, into a union PARAM rather than a binding (a different box-typed position:
// `emitUnionBoxArg`, not the let-init).
type C4 = { r4: string | i32 }
function sink4(u: string | i32) {
  if u is string { print(u) } else { print(0) }
}
const v4 = { r4: "7" }
sink4((v4).r4)

// 5 — a BOOLEAN atom: the value box is shared with i32, so only the TAG separates them and a
// missing rung is a silently FALSE `is boolean` rather than invalid wasm.
type C5 = { r5: boolean | i32 }
const v5 = { r5: true }
const q5: boolean | i32 = (v5).r5
if q5 is boolean { print(7) } else { print(0) }

// 6 — an f64 atom where the union's OTHER member is a string, so the read cannot ride the
// numeric default either.
type C6 = { r6: f64 | string }
const v6 = { r6: 7.0 }
print((v6).r6)

// 7 — WHERE THE THIRD SOURCE JOINS. `type C7 = { r7: i64 | null }` beside `{ r7: 7 }` stores
// the payload as i64 (tag 3, `struct.new $vbI64`) while the checker types the read `i32`, so
// THREE sources disagree. That was this predicate's DECLINE when D209 landed (condition 3, the
// box can hold the checker's atom, counted `reach=1 ans=0`) and D291 closed it by naming the
// store's own promotion ladder and asking it at both ends. This cell is the ANNOTATED, NARROWED
// spelling and takes the narrow path either way — it is here as the control that says the
// widened atom still narrows and prints as an i64. `adopted-read-widened-store-narrows-back.vl`
// is D291's own fixture.
type C7 = { r7: i64 | null }
const v7: C7 = { r7: 7 }
if (v7).r7 is i64 { print(7) } else { print(0) }
