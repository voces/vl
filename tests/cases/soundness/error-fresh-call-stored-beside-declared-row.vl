// @check
// @error-at 20:13 {f: i32} is not J: they store field `f` differently
// @error-at 22:13 {f: i32} is not J: they store field `f` differently
// @error-at 25:13 {f: i32} is not J: they store field `f` differently
// @error-at 28:13 {f: i32} is not J: they store field `f` differently
// D8302: the annotated twin of `fresh-call-read-in-place-beside-declared-row`. A call of the
// same function that is stored rather than read for a field — at the literal's own declared
// record, in a list, in a record, or returned — would be built at that record's row, so the
// call delivered into the wider record is refused rather than built at one row and read as
// the other.
type II = { f: i32 }
type J = { f: i32 | null }
function mk1() { { f: 1 } }
function mk2() { { f: 2 } }
function mk3() { { f: 3 } }
function mk4() { { f: 4 } }
function r4() {
  const k = mk4()
  return k
}
const a: J = mk1()
const k1: II = mk1()
const b: J = mk2()
const k2 = mk2()
const l2 = [k2]
const c: J = mk3()
const k3 = mk3()
const o3 = { a: k3 }
const d: J = mk4()
print(k1.f + l2[0].f + o3.a.f + r4().f)
print((a.f ?? 0) + (b.f ?? 0) + (c.f ?? 0) + (d.f ?? 0))
