// @check
// @error-at 16:13 {f: i32} is not J: they store field `f` differently
// D8302: the annotated twin of `fresh-call-read-in-place-beside-declared-row`. A call of the
// same function delivered at the literal's own declared record would be built at that record's
// row, so the call delivered into the wider record is refused. Stored in an un-annotated list
// (`mk2`) or record (`mk3`), or returned through a binding (`mk4`), it is built at `J` and runs.
type II = { f: i32 }
type J = { f: i32 | null }
function mk1() { { f: 1 } }
function mk2() { { f: 2 } }
function mk3() { { f: 3 } }
function mk4() { { f: 4 } }
function r4() {
  const k = mk4()
  return k
}
const a: J = mk1()
const k1: II = mk1()
const b: J = mk2()
const k2 = mk2()
const l2 = [k2]
const c: J = mk3()
const k3 = mk3()
const o3 = { a: k3 }
const d: J = mk4()
print(k1.f + l2[0].f + o3.a.f + r4().f)
print((a.f ?? 0) + (b.f ?? 0) + (c.f ?? 0) + (d.f ?? 0))
