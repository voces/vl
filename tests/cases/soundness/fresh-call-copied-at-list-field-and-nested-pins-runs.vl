// @run
// @log 6
// @log 6
// @log 6
// @log 6
// @log 6
// @log 6
// @log 6
// @log 6
// @log 2
// @log 1
// @hint Intentionally-unused parameter `_x`
// @hint Intentionally-unused parameter `_d`
// @hint Intentionally-unused parameter `_b`
// D14818: a fresh call result reaching a type parameter as a list element, a record field or a
// nested list element, where a held argument or the call's written type arguments pin it at the
// call's own type while another delivery builds it wider, is built wide and copied where it lands.
type Circle = { r: i32 | null }
type K = { r: null }
function sink(_x: Circle) {}
function mkcall() { { r: null } }
sink(mkcall())
const k: K = { r: null }
const ks = [k]
function first<T>(xs: T[]): T { xs[0] }
function pick<T>(a: T[], _d: T): T { a[0] }
function viaField<T>(a: { f: T }, _b: T[]): T { a.f }
function viaNested<T>(a: T[][], _b: T): T { a[0][0] }
function both<T>(a: T[], b: T[]) { a.length + b.length }
function n<T>(xs: T[]) { xs.length }
print(first([mkcall(), k]).r ?? 6)
print(first([k, mkcall()]).r ?? 6)
print(pick([mkcall()], k).r ?? 6)
print(first<K>([mkcall()]).r ?? 6)
print(viaField({ f: mkcall() }, ks).r ?? 6)
print(viaNested([[mkcall()]], k).r ?? 6)
print(viaField<K>({ f: mkcall() }, ks).r ?? 6)
print(viaNested<K>([[mkcall()]], k).r ?? 6)
print(both([mkcall()], ks))
print(n<K>([mkcall()]))
