// @run
// @log true
// @log 2
// @log true
// @log 2
// @log 2
// @log 2
// @log 3
// @log 2
// @hint redundant type annotation: `fold` is inferred as `i32`
// @hint redundant type annotation: `sum` is inferred as `i32`

// D2472: a recursion cycle that hands on only read-only function values keeps the narrowing, and
// a fold whose recursive edge passes a call's result in a non-function slot charges nothing.
type O = { v: i32 | string }
function pure(x: O) { print(x.v is i32) }
function swap(x: O, n: i32, f: (O) => void, g: (O) => void) {
  if n == 0 {
    f(x)
    return
  }
  swap(x, n - 1, g, f)
}
function a(x: O, n: i32, f: (O) => void) {
  if n == 0 {
    f(x)
    return
  }
  b(x, n - 1, f)
}
function b(x: O, n: i32, f: (O) => void) { a(x, n, f) }
function fold(n: i32, acc: i32, f: (i32) => i32): i32 {
  if n == 0 { return acc }
  return fold(n - 1, f(acc), f)
}
function sum(xs: i32[], i: i32, acc: i32, f: (i32, i32) => i32): i32 {
  if i >= xs.length { return acc }
  return sum(xs, i + 1, f(acc, xs[i]), f)
}
function main(o: O) {
  if o.v is i32 {
    swap(o, 1, pure, pure)
    print(o.v + 1)
    a(o, 2, pure)
    print(o.v + 1)
    print(fold(2, 0, (x: i32): i32 => x + 1))
    print(o.v + 1)
    print(sum([1, 2], 0, 0, (x: i32, y: i32): i32 => x + y))
    print(o.v + 1)
  }
}
main({ v: 1 })
