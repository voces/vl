// @run
// @log 4
// @log 5
// @log 4
// @log 4
// D14811: a by-rep result stored in a `const` list literal that is only indexed for a field
// keeps the rep its elements are built at, through a hole, a type parameter and a closure.
type J = { f: i32 | null }
function mk() { { f: 4 } }
function back(r) { return r }
function gen<T>(r: T): T { r }
const wideJ: J = mk()
const xs = [mk()]
const keep = [back(xs[0])]
print(keep[0].f)
const kept = [gen(xs[0])]
print(kept[0].f + 1)
const g = () => keep[0].f
print(g())
print(wideJ.f ?? 0)
