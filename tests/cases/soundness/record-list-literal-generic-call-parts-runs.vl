// @run
// @log 6
// @log 4
// A `const` holding a generic's call, as a part of a list literal beside a part built at a wider
// record, is built at the list's build as it is bound, as a plain function's is (D15655); the
// calls themselves are copied into the list's build (D15652).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const wideJ: J = mk()
const xs = [mk()]
function id<T>(v: T): T { v }
function idh(v) { v }
const o = id({ f: 1 })
const a = [xs[0], o]
const b = [xs[0], id({ f: 2 })]
const c = [...xs, idh({ f: 3 })]
print(a.length + b.length + c.length)
print(wideJ.f ?? 0)
