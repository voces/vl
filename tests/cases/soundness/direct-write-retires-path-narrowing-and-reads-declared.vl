// @run
// @log bb
// @log NUL2
// @log 5
// A DIRECT write to a narrowed property PATH retires the narrowing and leaves the path
// READABLE AT ITS DECLARED TYPE — the answer the bare-name spelling has always given.
//
// WHAT THIS PINS (inventory #2 D8). `if w.f != null { w.f = mk()   … }` was a loud check
// reject at every read after the write, in all 46 cells of the assignment leg, flat across
// 23 of 23 reps. The row filed the message as `cannot assign string? to string` and
// prescribed "assignment should be checked against the field's DECLARED type" — but the
// ASSIGNMENT was already accepted (`writeStorageTy`), and what refused was the READ after
// it (`pathInvalidatedErr`). `bare()` below is the identical program with the place a local
// instead of a field, and it RAN on master: the defect was the path/name ASYMMETRY, not the
// write check.
//
// WHY THE CALL CAUSE KEEPS REFUSING, and why that is not the same rule. A path narrowing
// dies two ways, and `npInvBy` records which. An ALIASED write through a call is invisible
// to the emit walk, so the read after it stays a loud reject
// (`alias-write-through-param-retires-path-narrowing.vl` pins that, unchanged). A DIRECT
// `w.f = e` is a statement the emit walk passes over exactly as it passes over `f = e`, and
// `emit_classify`'s write-retirement grew a Member arm so the emitter retires it too. Both
// sides retire the same write; without the emit half the stack keeps the NARROWED rep and
// the four scalar-newtype cells emit `bare null needs a struct-typed context`.
//
// RE-TESTING IS WHAT THE OLD DIAGNOSTIC ASKED FOR ("re-test 'w.f' after the assignment"),
// and it now works: the inner `w.f != null` re-derives the narrowing from the DECLARED
// field type, so the rep read below it is correct in both arms.
type W = { f: string | null }

function some(): string | null { return "bb" }
function none(): string | null { return null }

function reTest(mk: () => string | null) {
  const w: W = { f: "aa" }
  if w.f != null {
    w.f = mk()
    if w.f != null { print(w.f) } else { print("NUL2") }
  } else {
    print("NUL")
  }
}

// THE BARE-NAME TWIN, which ran on master and must keep running: one thing differs from
// `reTest` — the narrowed place is a local, not a field.
function bare() {
  let f: i32 | null = 1
  if f != null {
    f = 5
    print(f)
  } else {
    print("NUL")
  }
}

reTest(some)
reTest(none)
bare()
