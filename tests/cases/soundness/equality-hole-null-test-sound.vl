// @check
// CONTRACT (must-not-error): a NULLNESS test is exempt from the equality capability check that a
// generic call site applies under substitution. `x == null` asks about the STORAGE, not about
// type agreement between the two operands, so it is a legal question of every argument type —
// and `assignable` fails both ways on a `(non-nullable, null)` pair, so without the exemption the
// mutual-compatibility rule would reject the single most common thing a generic does with a
// nullable parameter.
function isNil(x) x == null

function firstOrNull(xs) {
  if xs.length == 0 { return null }
  xs[0]
}

print(isNil(1))
print(isNil("s"))
print(firstOrNull([1, 2]) == null)
