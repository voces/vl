// @run
// @log 10
// @log 10
// @hint redundant type annotation: `k1` is inferred as `{f: i32}`
// A maker called more than once keeps its own record; its call is copied where it lands wider.
// Calls of one maker delivered at its own declared record and at a wider one, or stored in an
// un-annotated list or record, all run (D8302).
type II = { f: i32 }
type J = { f: i32 | null }
function mk1() { { f: 1 } }
function mk2() { { f: 2 } }
function mk3() { { f: 3 } }
function mk4() { { f: 4 } }
function r4() {
  const k = mk4()
  return k
}
const a: J = mk1()
const k1: II = mk1()
const b: J = mk2()
const k2 = mk2()
const l2 = [k2]
const c: J = mk3()
const k3 = mk3()
const o3 = { a: k3 }
const d: J = mk4()
print(k1.f + l2[0].f + o3.a.f + r4().f)
print((a.f ?? 0) + (b.f ?? 0) + (c.f ?? 0) + (d.f ?? 0))
