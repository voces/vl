// @run
// @log 2
// @log 9
// A literal a generic builds wider and hands back, handed on at its own type: the parameter it
// reaches takes the wider record's rep, whether or not an earlier query built the write scan (D15373).
type V = { y: i32, x: i32 | string }
function k(v: V) { v.y }
function back<T>(v: T): T {
  k(v)
  v
}
function f(q: { y: i32, x: i32 }) { q.x }
print(back({ y: 2, x: 9 }).y)
print(f(back({ y: 2, x: 9 })))
