// @trap array index out of bounds
// A record field holding an un-annotated function, read past its literal's length at `i32` and
// then at `string`, beside a list of another such record handed to an un-annotated parameter:
// the read past the length traps, and is not rewritten to the function it would hold (D15338).
function id1(a) { return a }
function id2(a) { return a }
const ts = [{ f: id1 }]
ts.push({ f: id2 })
function g(qs) { return qs[1].f(7) }
print(g(ts))
const rs = [{ g: { f: id1 } }]
print(rs[1].g.f(2))
print(rs[0].g.f("s"))
