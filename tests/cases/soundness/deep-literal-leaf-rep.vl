// @run
// @log a
// @log none
// @log 3000000007
// @log 3000000007
// A literal's leaf is built at its destination's rep however deep it sits: a `null` beside a
// string seven records down (D16740), and an `i64` literal five records down in a list (D16741).
const ys = [
  { a: { b: { c: { d: { e: { g: { h: "a" } } } } } } },
  { a: { b: { c: { d: { e: { g: { h: null } } } } } } },
]
print(ys[0].a.b.c.d.e.g.h ?? "none")
print(ys[1].a.b.c.d.e.g.h ?? "none")
const big = 3000000000
const zs: { a: { b: { c: { d: { e: i64 } } } } }[] = [
  {
    a: {
      b: { c: { d: { e: 7 } } },
    },
  },
]
print(zs[0].a.b.c.d.e + big)
const deep = [
  {
    a: {
      b: {
        c: { d: { e: { g: { h: { i: { j: { k: { l: { m: 7 } } } } } } } } },
      },
    },
  },
  {
    a: {
      b: {
        c: { d: { e: { g: { h: { i: { j: { k: { l: { m: 8 } } } } } } } } },
      },
    },
  },
]
print(deep[0].a.b.c.d.e.g.h.i.j.k.l.m + big)
