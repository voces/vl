// @run
// @log 4
// @log 4
// A maker called more than once keeps its own record; its call is copied where it lands wider.
// A maker's call relayed through a returned binding of an identity reaches a parameter annotated
// at its own record that stores it, and runs (D14753).
type J = { f: i32 | null }
function mk() { { f: 4 } }
function id<T>(x: T): T { x }
function r() {
  const k = id(mk())
  return k
}
const keep: { f: i32 }[] = []
const d: J = mk()
function u(a: { f: i32 }) {
  keep.push(a)
  a.f
}
print(u(r()))
print(d.f ?? 0)
