// @check
// @error 'b.value' is no longer narrowed to f64: the operator '+' on line 17 may reassign it
// @error 'b.value' is no longer narrowed to f64: the operator '+' on line 24 may reassign it
// @error 'b.tag' is no longer narrowed to f64: the operator '[]' on line 35 may reassign it
// An operator that dispatches to a declaration is a call of it, its operands the arguments, so
// one that writes a field of an operand ends that field's narrowing — directly, through a
// function its body calls, and through an index operator (D2400).
type W = new { value: f64 | boolean }
type B = new { cells: f64[], tag: f64 | boolean }
function zap(o: W) { o.value = true }
function "+"(self: W, o: W): W {
  zap(o)
  self
}
function direct(a: W, b: W): f64 {
  if b.value is f64 {
    const c = a + b
    return b.value * 2.0
  }
  0.0
}
function inLoop(a: W, b: W): f64 {
  if b.value is f64 {
    for i in 0 to 1 { const c = a + b }
    return b.value * 2.0
  }
  0.0
}
function "[]"(self: B, i: i32): f64 {
  self.tag = true
  self.cells[i]
}
function indexed(b: B): f64 {
  if b.tag is f64 {
    const x = b[0]
    return b.tag * x
  }
  0.0
}
