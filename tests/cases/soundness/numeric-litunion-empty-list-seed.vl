// @run
// @log 0
// @log 0
// @log 0
// @log 1
// @log 2.5
// GRADUATED from `xfail-miscompile-numeric-litunion-empty-list-seed.vl`. An EMPTY array literal
// annotated with a NUMERIC literal-union element type used to accept and then miscompile:
// `vl check --codegen` exited 0 and the module did not validate.
//
//     type K = 1.5 | 2.5
//     const xs: K[] = []        // type mismatch: expected (ref $type), found (ref $type)
//
// THE ROOT WAS A MISSING ARM, NOT A MISSING REPRESENTATION, and the file's own prescription
// ("teaching this arm the numeric case means deciding what a numeric literal-union list's REP
// is") was answered by a rule the compiler already carried in three places: a numeric literal
// union reps as its BASE SCALAR (`typecheck.numLitUnionBaseTy`, and `tyKindOf`'s standalone arm
// states it verbatim). Its members ARE `i32` / `i64` / `f64` values; there is no atom to intern
// and nothing for A16's tag scheme to encode. So a `K[]` is an f64 list, an i64 list or an i32
// list, and `tyAnnRefListKind` — which seeds the wrapper an EMPTY `[]` builds — simply had no
// arm saying so: its first structural test is `tyIsLitUnionArray`, which demands
// `litKind == "str"`.
//
// THE i32 BASE IS WHY THIS LOOKED NARROWER THAN IT WAS. `type K = 0 | 1` always worked, because
// the un-seeded default IS the i32 wrapper; only the f64 and i64 bases had a cell the default
// did not fit. Same defect, hidden on a third of its population.
//
// The three CONTROLS still live in `literal-unions/numeric-litunion-list-seed-controls.vl`.
type K = 1.5 | 2.5
type J = 3000000000 | 4000000000

const xs: K[] = []
print(xs.length)

// The i64 base — the second cell the i32 default did not fit.
const js: J[] = []
print(js.length)

// The INLINE spelling, which has no alias for the canon pass to soften.
const inl: (1.5 | 2.5)[] = []
print(inl.length)

// An empty seed is only correct if the list it seeded also ACCEPTS the element.
const ys: K[] = []
ys.push(2.5)
print(ys.length)
print(ys[0])
