// @run
// @log 0
// @log 0
// @log 1
// @log 4000000000
// An EMPTY array literal annotated with a NUMERIC literal-union element type seeds the list
// at the union's BASE SCALAR (`typecheck.numLitUnionBaseTy`): a `J[]` over i64 members is an
// i64 list. The i32 base always worked because the un-seeded default is the i32 wrapper; the
// i64 base is the cell that default does not fit. Controls: `numeric-litunion-list-seed-controls.vl`.
type J = 3000000000 | 4000000000

const js: J[] = []
print(js.length)

// The INLINE spelling, which has no alias for the canon pass to soften.
const inl: (3000000000 | 4000000000)[] = []
print(inl.length)

// An empty seed is only correct if the list it seeded also ACCEPTS the element.
const ys: J[] = []
ys.push(4000000000)
print(ys.length)
print(ys[0])
