// @run
// @log 2
// @log 2
// @log 100
// @log 5
// @log abc
// @log 5
// @log 2
// @log 3
// @log 2
// @log 4

// D2461, D2471: what a call cannot write keeps a narrowing — an append, a store under another
// literal key, a store of exactly the narrowed type, a write into an object the callee made, a
// read-only callee, a write of another field, and a callback that only runs inside the call.
type O = { v: string | null, n: i32 }
type Cfg = { k: i32 }

const xs: (i32 | string)[] = [1]
function append() { xs.push("s") }
if xs[0] is i32 {
  append()
  print(xs[0] + 1)
}

const m: {[string]: i32 | string} = Map()
m["a"] = 1
function putB() { m.set("b", "x") }
if m["a"] is i32 {
  putB()
  print(m["a"] + 1)
}

const n: {[string]: i32} = Map()
n["a"] = 1
function bump(k: string) { n[k] = 99 }
if n["a"] != null {
  bump("a")
  print(n["a"] + 1)
}

function mk(s: string): O {
  const r: O = { v: null, n: 0 }
  r.v = s
  r
}
function show(o: O) { print(o.v ?? "-") }
function count(o: O) { o.n = o.n + 1 }
function f(o: O) {
  if o.v != null {
    const q = mk("zz")
    print(o.v.length + (q.v ?? "").length)
    show(o)
    count(o)
    print(o.v.length + o.n)
    const h = () => {
      print(o.n)
    }
    h()
    print(o.v.length)
  }
}
f({ v: "abc", n: 1 })

let cfg: Cfg | null = null
function init() { cfg = { k: 2 } }
function inner(g: (i32) => void, x: i32) { g(x) }
function each(ys: i32[], g: (i32) => void) {
  for y in ys { inner(g, y) }
}
function run(ys: i32[]) {
  if cfg != null {
    each(ys, (y: i32) => {
      print(y * cfg.k)
    })
  }
}
init()
run([1, 2])
