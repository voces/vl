// @run
// @log 18
// @log ab
// @log ab
// @log 6
// A call to a local closure whose body is visible, and writes nothing, does not end a path
// narrowing: the callee resolves to that body like a declared function. Nor does passing the
// narrowed value itself as an argument, which hands over the value and not the place (D2403).
type O = { value: f64 | boolean }
type N = { name: string | null }
function inLoop(o: O) {
  let t = 0.0
  if o.value is f64 {
    const c = (): f64 => o.value * 2.0
    let i = 0
    while i < 2 {
      t = t + o.value * 2.0
      t = t + c()
      t = t + c()
      i = i + 1
    }
  }
  t
}
function shown(o: N, xs: i32[]) {
  if o.name != null {
    const show = (s: string) => {
      print(s)
    }
    for x in xs { show(o.name) }
  }
}
function helper(o: O) {
  if o.value is f64 {
    const h = () => 1.0
    h()
    return o.value * 4.0
  }
  0.0
}
print(inLoop({ value: 1.5 }))
shown({ name: "ab" }, [1, 2])
print(helper({ value: 1.5 }))
