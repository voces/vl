// @run
// @log 4
// @log 5
// @log 4
// @log 6
// A binding of a call the record solve builds at a wider record, handed to a parameter that a
// record is written through, takes its own copy, and the parameter is built at its own row; a
// read-only parameter handed the same binding reads it there too (D15267).
type J = { f: i32 | null }
type K = { j: J }
function mk() { { j: { f: 4 } } }
const _k: K = mk()
const y = mk()
function w(p: { j: { f: i32 } }) { p.j = { f: 5 } }
function rd(p: { j: { f: i32 } }) { print(p.j.f) }
rd(y)
w(y)
rd(y)
print(_k.j.f ?? 0)
const z = mk()
function w2(p: { j: { f: i32 } }, v: i32) { p.j = { f: v } }
w2(z, 6)
print(z.j.f)
