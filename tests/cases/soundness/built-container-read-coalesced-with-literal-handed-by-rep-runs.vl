// D14739: a read out of a container built at a wider record, defaulted with `??` to a fresh
// literal and handed to a parameter that takes the rep, builds the literal there too.
type II = { f: i32 }
type J = { f: i32 | null }
function mk() { { f: 4 } }
function g(r: { f: i32 }) { r.f * 10 }
function w(r: { f: i32 }) {
  r.f = r.f + 1
  r.f * 10
}
function h(r) { r.f * 10 }
const wideJ: J = mk()
const m = Map()
m.set(1, mk())
print(g(m.get(1) ?? { f: 0 }))
print(g(m.get(2) ?? { f: 0 }))
print(w(m[1] ?? { f: 9 }))
print(w(m[2] ?? { f: 7 }))
print(h(m.get(1) ?? { f: 0 }))
print(h(m[2] ?? { f: 7 }))
print(wideJ.f ?? 0)
