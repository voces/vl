// @run
// @log 7
// @log 8
// @log 6
// @log 12
// @log 4
// A binding holding a read of a container built at a wider record is stored at that record, so
// a record literal assigned into it is built there too (D15188).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const wideJ: J = mk()
const xs = [mk()]
let b = xs[0]
b = { f: 7 }
print(b.f)
function g() {
  let c = xs[0] ?? { f: 1 }
  c = { f: 8 }
  c.f
}
print(g())
let d = xs[0]
d = { f: 7 }
d = { f: 6 }
print(d.f)
let e = xs[0]
for i in 0 to 2 { e = { f: i + 10 } }
print(e.f)
print(wideJ.f ?? 0)
