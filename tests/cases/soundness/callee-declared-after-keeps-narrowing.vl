// @run
// @log b7
// @log b7
// @log The wolf guards.
// @log b5
// @hint redundant type annotation
// @hint Intentionally-unused parameter
// D5593: what a call may write does not depend on whether its callee is declared before the
// caller, directly or through another call; each callee here is declared after its caller.
type Box = { kind: "a" | "b" | "c" }
function "[]="(self: Box, _i: i32, _v: i32) { self.kind = "a" }
function "[]"(self: Box, i: i32): i32 {
  if self.kind == "a" { 0 } else { i }
}
type Intent = { kind: "a" | "b" | "c" }
function act(i: Intent, xs: i32[]): string {
  if i.kind == "a" { return "a" }
  fill(xs)
  match i.kind {
    "b" => "b\{xs[0]}"
    "c" => "c"
  }
}
function actVia(i: Intent, xs: i32[]): string {
  if i.kind == "a" { return "a" }
  mid(xs)
  match i.kind {
    "b" => "b\{xs[0]}"
    "c" => "c"
  }
}
function mid(xs: i32[]) { fill(xs) }
function fill(xs: i32[]) { xs[0] = 7 }
type Foe = { name: string }
type Turn = { kind: "mend" | "guard" | "dive" }
function foeActs(fs: Foe[], t: Turn) {
  if t.kind == "mend" { return }
  print(
    "The \{foeName(fs, 0)} \{match t.kind { "guard" => "guards", "dive" => "dives" }}.",
  )
}
function foeName(fs: Foe[], k: i32): string { fs[k].name }
type Cell = { n: i32 }
type Want = { kind: "a" | "b" | "c" }
function want(w: Want, c: Cell): string {
  if w.kind == "a" { return "a" }
  bump(c)
  match w.kind {
    "b" => "b\{c[0]}"
    "c" => "c"
  }
}
function bump(c: Cell) { c[0] = 5 }
function "[]="(self: Cell, i: i32, v: i32) { self.n = max(v, i) }
function "[]"(self: Cell, i: i32): i32 { self.n + i }
print(act({ kind: "b" }, [0]))
print(actVia({ kind: "b" }, [0]))
foeActs([{ name: "wolf" }], { kind: "guard" })
print(want({ kind: "b" }, { n: 0 }))
