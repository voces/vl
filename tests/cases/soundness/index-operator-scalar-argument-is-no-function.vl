// @run
// @log b5
// @hint redundant type annotation
// D5591: a scalar parameter handed to a built-in (`max(v, i)`) is no function value, so the
// operator writes only its receiver and a callee indexing another record keeps the narrowing.
type Box = { n: i32 }
function "[]="(self: Box, i: i32, v: i32) { self.n = max(v, i) }
function "[]"(self: Box, i: i32): i32 { self.n + i }
type Intent = { kind: "a" | "b" | "c", n: i32 }
function poke(b: Box) { b[0] = 5 }
function act(i: Intent, b: Box): string {
  if i.kind == "a" { return "a" }
  poke(b)
  match i.kind {
    "b" => "b\{b[0]}"
    "c" => "c"
  }
}
print(act({ kind: "b", n: 1 }, { n: 0 }))
