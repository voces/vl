// @run
// @log 1
// @log 1
// A `map` over a list of a maker's calls, beside an annotated binding taking the maker wider,
// runs: the maker keeps its own record and that binding's call is copied (D15697).
type J = { f: i32 | null }
function mk2() { { f: 1 } }
const dA: J = mk2()
print(dA.f ?? 0)
const xs = [mk2()]
const ns = xs.map((y) => y.f ?? 0)
print(ns[0])
