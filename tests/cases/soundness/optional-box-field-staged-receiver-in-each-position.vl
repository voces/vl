// @run
// @log 3
// @log 9
// @log 9
// @log 5
// @log 7
// @log 104
// @log big
// @log small
// @log 4
// `r?.f ?? d` where `f` is a union box field and the receiver `r` is no place legacy reads again
// (an element, a call's result, a field over an element): it is evaluated once into
// the `?.` stash and read back from it; in a return, an argument, a binding, a loop and an `if`.
type J = { f: i32 | null }
type K = { j: J | null }
let calls = 0
function mk(v: i32 | null): K {
  calls = calls + 1
  return { j: { f: v } }
}
function show(x: i32) { print(x) }
function elem(ks: (J | null)[], i: i32) { return ks[i]?.f ?? 9 }
function call() { show(mk(5).j?.f ?? 8) }
function bind(ks: K[]) {
  const x = ks[0].j?.f ?? 7
  return x
}
function loop(ks: K[]) {
  let t = 0
  for i in [0, 1] { t = t + (ks[i].j?.f ?? 100) }
  return t
}
function cond(ks: (J | null)[]) {
  if (ks[0]?.f ?? 0) > 1 { print("big") } else { print("small") }
}
const js: (J | null)[] = [{ f: 3 }, null, { f: null }]
print(elem(js, 0))
print(elem(js, 1))
print(elem(js, 2))
call()
print(bind([mk(null)]))
print(loop([mk(4), mk(null)]))
cond([{ f: 2 }])
cond([{ f: null }])
print(calls)
