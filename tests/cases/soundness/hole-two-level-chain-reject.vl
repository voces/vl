// @check
// @error-at 30:19 argument of type i32 flows into `ps` expecting string
// @error-at 35:20 argument of type i32 flows into `ps` expecting string
// @error-at 39:26 argument 1: expected string, got i32
// @error-at 44:16 argument of type i32 flows into `ps` expecting string
// @error-at 49:29 argument of type i32 flows into `ps` expecting string
// @error-at 54:18 operator '+' is not defined for string and i32
// SOUNDNESS — the TWO-LEVEL derived-hole chain. Every spelling below reported
// "no errors" (with AND without `--codegen`) and then emitted INVALID WASM
// ("expected (ref $type), found i32").
//
// The one-level spelling always rejected: `gb`'s return is the derived hole
// `?fld.bar.<hgb>`, and `ps(gb({bar: 42}))` resolves it against the call's
// bindings. Add ONE hop and it evaporated. At the inner call `gb(w)` the argument
// is itself the enclosing body's hole `<hgo>`, so `substHoleByName` resolved the
// BASE and then found no `bar` on a TyVar — it returned "unresolved", and the
// derived read went on naming `<hgb>`, a hole that is out of scope at every site
// that could ever pin it. Nothing re-checked the chain when `go({bar: 42})`
// pinned `<hgo>`.
//
// The chain now RE-BASES: `?fld.bar.<hgb>` under `<hgb> := <hgo>` IS
// `?fld.bar.<hgo>` (`rebaseDerivedHole`), and a deferred constraint whose hole
// substituted to another hole is RE-RECORDED under that one, so the demand
// survives each hop and is re-validated where the outer call finally pins it.
// `inference/hole-two-level-chain.vl` is the must-not-error twin.
function ps(t: string) { print(t) }

// ── the minimal case: no join at all, one relay hop ────────────────────────
function gb(v) { return v.bar }
function goField(w) { ps(gb(w)) }
goField({ bar: 42 })

// Two hops. The re-base has to compose.
function midField(u) { return gb(u) }
function goField3(w) { ps(midField(w)) }
goField3({ bar: 42 })

// The relay RETURNS the derived hole and the pin happens at the relay's own call.
function relayField(w) { return gb(w) }
ps(relayField({ bar: 42 }))

// The INDEX flavour (`?elem.`) of the same chain.
function hd(v) { return v[0] }
function goElem(w) { ps(hd(w)) }
goElem([1, 2, 3])

// A NESTED field read — the base itself resolves to a hole-typed field.
function gbz(v) { return v.bar.baz }
function goNested(w) { ps(gbz(w)) }
goNested({ bar: { baz: 42 } })

// The deferred BINARY-OP constraint takes the same hop.
function addOne(v) { return v.bar + 1 }
function goBin(w) { print(addOne(w)) }
goBin({ bar: "s" })
