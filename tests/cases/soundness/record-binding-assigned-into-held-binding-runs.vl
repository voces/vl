// @run
// @log 6
// @log 6
// @log 6
// @log 6
// @log 6
// @log 6
// @log 9
// @log 6
// @log 4
// A fresh record `const` assigned into a binding held at a wider record, by a built read or a
// built call, is built there by its literal's stamp and keeps its own type (D15238).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const wideJ: J = mk()
const xs = [mk()]
const c = wideJ.f == 4
let y = xs[0]
const r = { f: 6 }
y = r
print(y.f)
print(r.f)
let z = mk()
const s = { f: 6 }
z = s
print(z.f)
let v = xs[0]
const t = { f: 6 }
v = if c { t } else { { f: 7 } }
print(v.f)
function g() {
  let w = xs[0]
  const u = { f: 6 }
  w = u
  w.f ?? 0
}
print(g())
let a = xs[0]
const b = { f: 6 }
a = b
xs.push(b)
print(xs[1].f)
a = { f: 9 }
print(a.f)
print(b.f)
print(wideJ.f ?? 0)
