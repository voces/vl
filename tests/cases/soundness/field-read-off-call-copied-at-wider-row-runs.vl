// @run
// @log 4
// @hint Intentionally-unused variable `_k`
// @hint redundant type annotation: `w` is inferred as `{f: i32}`
// A call delivered at a wider row is copied there, so the unannotated call keeps its own row and
// a field read off it is its own record, delivered where its own type is declared (D15825).
type J = { f: i32 | null }
type K = { j: J }
function mk() { { j: { f: 4 } } }
const _k: K = mk()
const y = mk()
const w: { f: i32 } = y.j
print(w.f)
