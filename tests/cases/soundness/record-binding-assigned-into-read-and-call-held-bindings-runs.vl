// @run
// @log 6
// @log 6
// @log 7
// @log 7
// @log 7
// @log 4
// A fresh record `const` assigned into a binding held wider by a built call and one held there by
// a built read is built once at that record, beside a push into the built list (D15282).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const wideJ: J = mk()
const xs = [mk()]
let y = mk()
let z = xs[0]
const r = { f: 6 }
y = r
z = r
print(y.f ?? 0)
print(z.f ?? 0)
let a = mk()
let b = xs[0]
const s = { f: 7 }
a = s
b = s
xs.push(s)
print(a.f ?? 0)
print(b.f ?? 0)
print(xs[1].f ?? 0)
print(wideJ.f ?? 0)
