// @log 2
// @log true
// A binding of the `null` unit type runs its initialiser: an assignment of `null` stores, and a
// call runs, for a local and for a module global (D17088).
let hits = 0
function note(): null {
  hits = hits + 1
  return null
}

function localAsg() {
  let s: string | null = "a"
  const x = (s = null)
  print(s == null)
  print(x == null)
}
localAsg()

function localLet() {
  let n: i32 | null = 1
  let z = (n = null)
  print(n == null)
  print(z == null)
}
localLet()

function localCall() {
  const y = note()
  print(hits)
  print(y == null)
}
localCall()

function annotated() {
  let s: string | null = "a"
  const x: string | null = (s = null)
  print(s == null)
  print(x == null)
}
annotated()

let gs: string | null = "a"
const gx = (gs = null)
print(gs == null)
print(gx == null)

const gy = note()
print(hits)
print(gy == null)
