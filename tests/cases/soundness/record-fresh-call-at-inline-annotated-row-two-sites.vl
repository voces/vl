// @run
// @log 7
// @log 7
// @log 4
// D3430, D8201: a record a function with no declared result builds is built at the record its
// two calls deliver it to, though an annotation spells a record of its own field storage inline.
const i: { f: i32 } = { f: 4 }
type I = { f: i32 | null }
function mk() { { f: 7 } }
const b: I = mk()
const b2: I = mk()
print(b.f ?? 0)
print(b2.f ?? 0)
print(i.f)
