// @run
// @log 7
// @log 7
// @log 7
// @log 7
// GRADUATED from `@no-instantiate` (silent-class-inventory D155, 2026-08-27). This file was
// the check-clean-invalid-wasm SPECIMEN — `tests/vl_check_codegen_test.ts`'s
// `INVALID_MODULE_SRC` — and program 1 below is that constant verbatim. It printed
// `type mismatch: expected (ref $type), found (ref $type)` out of a `vl check` that exited 0
// with no diagnostics at all. It runs.
//
// IT IS D139'S CHANNEL WITH THE DESTINATION ONE SCOPE OUT, AND THE ROW'S OWN FIFTH CONTROL
// SAID SO. D139 closed by giving D81's `synthDstPinAnns` the module run it never had, so a
// top-level `const c = Map()` delivered to `thru(x: {[string]: Circle})` is pinned exactly as
// its function-scoped sibling always was. Here the binding sits inside `mkm` and there is NO
// destination inside `mkm` at all: `mkm`'s result is un-annotated, so `dstPinRetDest` records
// nothing, the four legs find nothing, `dstN.length == 0`, and the pin declines. Probed on
// `1559d80c` the dump is exactly that — `DPA let=18 name=c ret=-1 n=0`. Annotating the RESULT
// makes it run, which is what says the deciding information exists and the pin cannot see it.
//
// THE FIX IS ONE RUNG AND ONE SCAN, both inside the pass that already carries this context:
// `dstPinSrcIsAt` learns that an ordinary call to an UN-ANNOTATED callee is transparent to the
// binding that callee hands back (`dstPinCalleeRetLet`), and `dstPinCallerDests` runs the same
// `dstPinScan` over every OTHER function body and over the module, but only for a binding that
// IS its function's tail value. A DECLARED result answers -1 and is not a hop: it is the
// destination, `dstPinRetDest` already records it, and a caller must not overrule it.
//
// THE DISAGREEMENT GATE IS UNCHANGED AND IT IS THE SAFETY PROPERTY. Two call sites delivering
// `mkm()` to differently-annotated destinations push two names and the pin declines — built
// and RUN: `thru(mkm())` beside `thrud(x: {[string]: Dot})` is check-clean invalid wasm at the
// SAME message and the SAME offset (1316) on master and on this tree, i.e. untouched.
//
// MEASURED: the 36-cell binding-storage-class grid (`scripts/silent-sweep/d139/`) moves 3, all
// forward — `armtwin x mapval x none x callres` check-clean invalid wasm to runs, and
// `arm`/`armdiff` at the same coordinate loud emit reject to runs — 0 backward. The 2,850-cell
// D88/D100, 1,114-cell D112, 9,450-cell D52, 3,144-cell D75/D81/D82, 1,710-cell D111/D117 and
// 1,732-cell D131 grids each move 0 cells and 0 messages.
//
// THE CLASS IS NOT EMPTY. The successor specimen is
// `xfail-miscompile-arm-literal-through-a-list-conduit.vl` beside it — an arm-shaped literal
// that reaches its declared-result destination through an element-preserving LIST conduit —
// and D156 / D157 / D158 / D163 carry four live shapes with runnable witnesses.

// 1 — the former specimen, verbatim: the map is built and returned by `mkm`, and the only
// nominal claim on it is `thru`'s PARAMETER, at a call site in another scope. The value is
// never read back, which is the point of keeping it unchanged: the mismatch was at the
// `Map()` construction, not at a read.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Dot = { r: i32 }
function thru(x: {[string]: Circle}) { return x }
function mkm() {
  const c = Map()
  c["o"] = { r: 7 }
  return c
}
thru(mkm())
print(7)

// 2 — the same shape with the value READ BACK through the map, so the pin covers the round
// trip and not only the construction.
function mkm2() {
  const c2 = Map()
  c2["o"] = { r: 7 }
  return c2
}
print((thru(mkm2())["o"] ?? { r: 0 }).r)

// 3 — THE CALL SITE INSIDE A FUNCTION. This is the control that separated this row from D139:
// D139 was storage-class DEPENDENT (its function-scope sibling ran) and this one was silent at
// BOTH scopes, so the caller scan has to walk every function body and not only the module.
function mkm3() {
  const c3 = Map()
  c3["o"] = { r: 7 }
  return c3
}
function caller() {
  return (thru(mkm3())["o"] ?? { r: 0 }).r
}
print(caller())

// 4 — TWO call sites that AGREE, both positional parameters of one callee. The pin collects
// every delivery and requires all of them to name the same arm; here they do, so it fires.
function mkm4(n: i32) {
  const c4 = Map()
  c4["o"] = { r: n }
  return c4
}
function two(a: {[string]: Circle}, b: {[string]: Circle}) {
  return (a["o"] ?? { r: 0 }).r + (b["o"] ?? { r: 0 }).r
}
print(two(mkm4(3), mkm4(4)))
