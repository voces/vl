// @run
// @log 2
// @log 9
// @log 3
// The parameter that takes the wider rep for a handed-back literal takes it for a plain literal
// argument too, so both callers are served at one build (D15373).
type V = { y: i32, x: i32 | string }
function k(v: V) { v.y }
function back<T>(v: T): T {
  k(v)
  v
}
function f(q: { y: i32, x: i32 }) { q.x }
print(back({ y: 2, x: 9 }).y)
print(f(back({ y: 2, x: 9 })))
print(f({ y: 1, x: 3 }))
