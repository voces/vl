// @emit-error this record was built as another record type than the `I`
// @hint redundant type annotation: `i` is inferred as `{f: i32}`
// D2917: a record some other expression already built at its own row cannot join a list a
// declared destination makes hold another record of the same field names; a record is shared,
// not converted. Refused at the element.
const i: { f: i32 } = { f: 4 }
type I = { f: i64 | null }
function mk() { { f: 7 } }
const il = [mk(), { f: 3 }]
const ic: I[] = il
print(ic[0].f)
print(ic[1].f)
print(i.f)
