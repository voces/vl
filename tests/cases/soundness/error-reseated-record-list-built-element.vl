// @check
// @error {f: i32} is not I: they store field `f` differently (`i32` into `i64 | null`)
// D2917: a list of literals adopts the `I[]` it is delivered to, and its first element is a
// record `mk` builds at the declared `{ f: i32 }` row; `mk` is called at two sites, so it is
// built at neither destination and is refused as an existing record is (DECISIONS.md "Record
// covariance").
const i: { f: i32 } = { f: 4 }
type I = { f: i64 | null }
function mk() { { f: 7 } }
const il = [mk(), { f: 3 }]
const ic: I[] = il
const jl = [mk()]
print(ic[0].f)
print(ic[1].f)
print(jl.length)
print(i.f)
