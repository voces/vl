// @run
// @log 7
// @log 7
// @log 6
// @log 8
// @log 7
// @log 4
// Every record literal written into a reassigned fresh record `let` that a place holds at a wider
// record is built there: before or after the push, through an `if`, or assigned on (D15374).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const wideJ: J = mk()
const c = wideJ.f == 4
const xs = [mk()]
let r = { f: 6 }
r = { f: 7 }
xs.push(r)
print(xs[1].f ?? 0)
let s = { f: 6 }
xs.push(s)
s = { f: 7 }
print(s.f ?? 0)
print(xs[2].f ?? 0)
let t = { f: 6 }
t = if c { { f: 8 } } else { { f: 9 } }
xs.push(t)
print(xs[3].f ?? 0)
let y = xs[0]
let u = { f: 6 }
u = { f: 7 }
y = u
print(y.f ?? 0)
print(wideJ.f ?? 0)
