// @run
// @log 1
// @log 1.5
// @log 1
// @log 1
// @log a
// @log 1
// @log 4000000000
// GRADUATED from `xfail-false-reject-numeric-litunion-array-in-signature.vl`. A NUMERIC
// literal-union array was fine as a `const` and refused in a function SIGNATURE:
//
//   function mk(): K[] { … }       // emitProgram: field access but no struct type declared
//   function n(xs: K[]) { … }      // same
//
// THE FILE'S SECOND PRESCRIPTION WAS ALSO WRONG, and in the opposite direction from its first.
// The 2026-08-23 re-measure concluded "a numeric litunion has no atom rep to route to, so the
// signature path has nothing to be taught … this is ROADMAP A16 … it closes with A16's numeric
// literal-union representation, not before." A16 is the ENUM-TAG question for the interned
// STRING atom, and it does not reach this family at all: a numeric literal union's members are
// `i32` / `i64` / `f64` VALUES, so there is no atom identity for a tag scheme to encode, and the
// compiler has stated the rep for that family in `tyKindOf`'s own standalone arm for as long as
// that arm has existed — it reps as its BASE SCALAR. What was missing was the ARRAY-ELEMENT
// twin of that arm, in three ladders that each had the `TyPrim` case and not the litunion one:
// `nodeTyArrayElemRepName`, `tyAnnRefListKind` and `tyKindOf`'s `TyArray` leg.
//
// WHY THE DECLARATION POSITION WORKED AND THE SIGNATURE DID NOT. `collectA`'s f64/i64 rungs read
// `nodeTyArrayElemRepName(i) || nameIsF64Array(nd.tyName)`; the canon pass softens a `K[]`
// ANNOTATION to `f64[]`, so the NAME answered where the arena would not — at every position an
// annotation `TypeRef` is walked, and no other. Answering from the arena makes the positions
// agree without a fourth name test.
//
// AND THE OLD `const` CONTROL'S RETRACTION WAS ITSELF STALE: it reported `print(xs[0])` failing
// with "print of a literal-union atom whose type carries no member texts". Measured on the
// pre-fix seed at `cdf7940c`, that program printed `1.5`. The element read was never half-atom.
type K = 1.5 | 2.5
type S = "a" | "b"
type J = 3000000000 | 4000000000

function mk(): K[] {
  return [1.5]
}

function first(xs: K[]): f64 {
  return xs[0]
}

print(mk().length)
print(first(mk()))

const xs: K[] = [1.5]
print(xs.length)

// THE STRING CONTROL, unchanged: the spelling that always compiled.
function mkS(): S[] {
  return ["a"]
}
print(mkS().length)
print(mkS()[0])

// THE i64 BASE in the same signature position — the third rep of the family.
function mkJ(): J[] {
  return [4000000000]
}
print(mkJ().length)
print(mkJ()[0])
