// @run
// @log 1
// @log 2
// @log 1
// @log 1
// @log a
// @log 1
// @log 4000000000
// A NUMERIC literal-union array in a function SIGNATURE (`function mk(): K[]`,
// `function n(xs: K[])`) compiles as at a `const`. A numeric literal union reps as its BASE
// SCALAR, so `K[]` is an i32 or i64 list; the array-element ladders answer from the arena
// rather than from the canon-softened annotation name, so every position agrees.
type K = 1 | 2
type S = "a" | "b"
type J = 3000000000 | 4000000000

function mk(): K[] { return [2] }

function first(xs: K[]): i32 { return xs[0] }

print(mk().length)
print(first(mk()))

const xs: K[] = [1]
print(xs.length)

// The string control: the spelling that always compiled.
function mkS(): S[] { return ["a"] }
print(mkS().length)
print(mkS()[0])

// The i64 base in the same signature position.
function mkJ(): J[] { return [4000000000] }
print(mkJ().length)
print(mkJ()[0])
