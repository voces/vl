// @run
// @log 4
// @log 4
// @log 5
// @log 6
// @log a
// @log 5
// D8302: a function whose literal is built at a wider record where one call lands serves its
// other calls too, when each is only read for a field, though the program declares a record
// of the literal's own storage. A binding read, a direct read, a read inside a function, and
// a two-field record.
type II = { f: i32 }
type J = { f: i32 | null }
type I2 = { f: i32, g: string }
type J2 = { f: i32 | null, g: string }
function mk() { { f: 4 } }
function mk2() { { f: 4, g: "a" } }
function q() {
  const k = mk()
  return k.f + 2
}
const xj: J = mk()
const k = mk()
print(xj.f ?? 0)
print(k.f)
print(mk().f + 1)
print(q())
const yj: J2 = mk2()
const k2 = mk2()
print(k2.g)
print((yj.f ?? 0) + 1)
