// @check
// @error not all code paths return a value in 'k'
// A bare block in tail position returns its tail, so one that can fall through leaves the body
// without a value: an else-less `if` that returns is not total, and the emitter pads nothing
// here (D1902, D3477).
function k(c: boolean): i32 {
  {
    if c { return 5 }
  }
}
print(k(true))
