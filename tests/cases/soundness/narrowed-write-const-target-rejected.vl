// @check
// @error cannot reassign `const` q
// @error cannot reassign `const` r
// VERDICT PIN (must-error): a `const` binding cannot be rebound, guard or no guard —
// and inside a guard it silently COULD be. `isConstName` stops at the first scope that
// BINDS the name and asks that frame alone (the scope-chain shadowing rule a `let`
// shadowing an outer `const` depends on), and a bare-name narrowing is a shadowing
// `declare` into a scope of its own with no const map entry. So every guard hid the
// const reject: `const q = step(0)` / `if q != null { q = 5 }` compiled and RAN on
// master, and only the null-carrying spelling was stopped — by the assignment target
// type coming out of the narrowing overlay, which is the accident this change removes.
//
// The narrowing now carries the constness across with it, so the reject is the CONST
// one, at the write, whatever the right-hand side. Both spellings are pinned here: the
// non-null write, which master accepted outright, and the null write, which master
// rejected with the wrong message ("cannot assign null to i32").

function step(k: i32) {
  if k < 3 { return k + 1 }
  null
}

function nonNullWrite() {
  const q = step(0)
  if q != null { q = 5 }
  print(1)
}

function nullWrite() {
  const r = step(0)
  while r != null { r = null }
  print(2)
}

nonNullWrite()
nullWrite()
