// @run
// @log 4
// @log 4
// @log 5
// @log 4
// @log 3
// A field read off a record built wider holds the field's stored record: an annotated parameter
// only read, or written, is instanced at that record, as a binding of the read is (D15825).
type J = { f: i32 | null }
type L = { j: J }
type K = { j: J, l: L }
function mk() { { j: { f: 4 }, l: { j: { f: 4 } } } }
const _k: K = mk()
const y = mk()
function own(q: { f: i32 }) { q.f }
print(own(y.j))
const v = y.j
print(own(v))
function put(q: { f: i32 }) { q.f = 5 }
put(y.j)
print(y.j.f)
print(own(y.l.j))
v.f = 3
print(y.j.f)
