// @run
// @hint redundant type annotation: `three` is inferred as `i32`
// @hint redundant type annotation: `four` is inferred as `i32`
// @hint redundant type annotation: `plainTail` is inferred as `i32`
// @hint redundant type annotation: `mixedCond` is inferred as `i32`
// @hint redundant type annotation: `nestedArm` is inferred as `i32`
// @hint redundant type annotation: `scalar` is inferred as `i32`
// @hint redundant type annotation: `thenPlainIf` is inferred as `i32`
// @hint redundant type annotation: `loopChain` is inferred as `i32`
// @hint redundant type annotation: `nullFirst` is inferred as `i32`
// @hint redundant type annotation: `discrim` is inferred as `i32`
// @log 1
// @log 2
// @log 3
// @log 40
// @log 4
// @log tail
// @log 9
// @log 7
// @log 22
// @log 33
// @log 42
// @log 0
// @log 1
// @log 6
// @log 6
// @log 66
// @log 42
// @log -1
// @log -2
// @log 6
// @log 9
// @log 7
// EVERY return annotation here is LOAD-BEARING and the hints are the price: the whole
// point of each function is that the residual BELOW the chain is assignable to the
// declared return, so dropping an annotation would let the function infer whatever the
// residual happens to be and the case would pass vacuously.
//
// THE MULTI-STEP `else if` CHAIN — the half `elseif-chain-residual.vl` left open and
// `seq-guard-residual.vl` mis-attributed to the subtraction COUNT. CLOSED. Both files
// have been corrected to point here.
//
// THE GAP. A chain of divergent guards subtracted only its OUTERMOST arm:
//
//     if u is A { return u.a }
//     else if u is B { return u.b }
//     return u.c              // `field 'c' is not on every member of B | C`
//
// while the identical program with the `else` removed printed `5`. One keyword apart.
//
// THE MECHANISM, and it is neither the count nor the `else`. An `else if` arm's own
// `checkIfStmtNode` ran its post-guard leg and `declare`d the arm's complement into
// WHATEVER SCOPE HAPPENED TO BE OPEN, and that was wrong in both directions at once:
//
//   * the parent had pushed an else-arm narrowing scope (its condition narrowed a bare
//     name), so `popScope` unwound the arm's `declare` with the arm — the chain
//     narrowed nothing past the first link, which is the reported defect;
//   * the parent had pushed NO scope (its condition narrowed nothing), so the arm's
//     `declare` landed straight in the ENCLOSING BLOCK and survived — including when
//     the parent's own then did NOT diverge, which is unsound and was a live
//     check/emit split, pinned from the other side in
//     `elseif-chain-nondiverging-arm-reject.vl`.
//
// THE RULE. A chain link has no enclosing block of its own — the rest of "its" block is
// the rest of the PARENT's, and the parent owns the question of whether that code is
// reached at all. So a link BANKS its complement (`pgUpKeys`) instead of declaring it,
// and the head of the chain applies the bank only when its own then diverges. That
// composes to exactly "every arm from the top down to here exited, so control arrived
// through the last one's false edge". A link whose own then does not diverge drops its
// whole subtree, which is what stops the subtraction at a falling-through middle arm.
//
// EMIT MOVED WITH CHECK. `emit_classify.pushPostGuardNarrow` pushed only the outermost
// complement too; its complements already STACK, so the mirror is a walk down the chain
// pushing arm by arm, stopping at the same arm the checker stops at. The `@run` tier is
// the half that pins it: `scalar` and `loopChain` below both CONSUME the residual in
// unboxed arithmetic, so a checker-only narrowing would lower a `ref` operand into an
// `i32.add` and fail validation rather than print.
type A = { a: i32 }
type B = { b: i32 }
type C = { c: i32 }
type D = { d: i32 }

// 3-ARM CHAIN over a struct union — the reported program, verbatim apart from the names.
function three(u: A | B | C): i32 {
  if u is A { return u.a }
  else if u is B { return u.b }
  return u.c
}
print(three({ a: 1 }))
print(three({ b: 2 }))
print(three({ c: 3 }))

// 4 ARMS: the subtraction is not capped at two. Each link's complement is computed
// against the residual the link ABOVE it left, so A, then B, then C come off and the
// tail sees a bare `D`.
function four(u: A | B | C | D): i32 {
  if u is A { return u.a }
  else if u is B { return u.b }
  else if u is C { return u.c * 10 }
  return u.d
}
print(four({ c: 4 }))
print(four({ d: 4 }))

// A CHAIN ENDING IN A PLAIN `else` that falls through. The tail arm is a Block, not a
// link, so it banks nothing of its own — but the `else if` above it still hands up, and
// reaching the code below means that Block ran with the chain's residual in hand.
function plainTail(u: A | B | C): i32 {
  if u is A { return u.a }
  else if u is B { return u.b }
  else { print("tail") }
  return u.c
}
print(plainTail({ c: 9 }))

// A NON-`is` CONDITION MIXED IN. `k > 0` narrows nothing, so the middle link banks
// nothing — but it DIVERGES, so the walk continues through it and the third link's
// subtraction still reaches the tail. Diverging and narrowing are separate questions.
function mixedCond(u: A | B | C, k: i32): i32 {
  if u is A { return u.a }
  else if k > 0 { return 100 }
  else if u is B { return u.b }
  return u.c
}
print(mixedCond({ c: 7 }, 0))

// A NESTED `else if` CHAIN INSIDE A DIVERGING ARM. The inner chain sits in a BLOCK, so it
// has an enclosing block of its own and declares normally; the hand-up marker is read and
// cleared by the immediate callee, so the inner `if` never mistakes itself for a link of
// the outer chain.
function nestedArm(u: A | B | C, v: A | B): i32 {
  if u is A {
    if v is A { return v.a }
    else if v is B { return v.b }
    return 0
  } else if u is B {
    return u.b
  }
  return u.c
}
print(nestedArm({ a: 1 }, { b: 22 }))
print(nestedArm({ c: 33 }, { a: 1 }))

// A SCALAR union, and the residual is USED rather than returned — `x + 41` is an unboxed
// `i32.add`, so this is the emitter half of the pin, not just a checker verdict.
function scalar(x: i32 | string | boolean): i32 {
  if x is string { return 0 }
  else if x is boolean { return 1 }
  return x + 41
}
print(scalar(1))
print(scalar("s"))
print(scalar(true))

// A CHAIN FOLLOWED BY A PLAIN `if` — the interaction with the bare guard SEQUENCE that
// `seq-guard-residual.vl` closed. The chain's banked residual is declared into the
// enclosing block, so the plain `if` after it subtracts from THAT, not from the
// declaration; the two mechanisms compose to a bare `D` at the tail.
function thenPlainIf(u: A | B | C | D): i32 {
  if u is A { return u.a }
  else if u is B { return u.b }
  if u is C { return u.c }
  return u.d
}
print(thenPlainIf({ c: 6 }))
print(thenPlainIf({ d: 6 }))

// `continue` LEAVES THE PATH EXACTLY AS `return` DOES, and inside a loop it is how a
// guard chain is spelled. The accumulator is unboxed `i32` arithmetic, so emit is pinned
// here too.
function loopChain(xs: (i32 | string | boolean)[]): i32 {
  let n = 0
  for x in xs {
    if x is string { continue }
    else if x is boolean { continue }
    n = n + x
  }
  return n
}
print(loopChain([1, "a", 2, true, 3, 60]))

// A NULL STRIP AS THE HEAD OF THE CHAIN. A strip and a union subtraction are the same
// shadowing `declare`, so they compose: `null` goes first, `string` second, and the tail
// is a bare `i32`.
function nullFirst(x: i32 | string | null): i32 {
  if x == null { return -1 }
  else if x is string { return -2 }
  return x + 1
}
print(nullFirst(41))
print(nullFirst(null))
print(nullFirst("s"))

// A LITERAL-DISCRIMINANT chain. The narrowed key is the bare name `sh` (the discriminant
// fact is pushed about the tag's PARENT), so it hands up like any other bare name and the
// tail reads the last member's own field. This shape rejected on master.
type Circle = { kind: "circle", r: i32 }
type Square = { kind: "square", s: i32 }
type Tri = { kind: "tri", b: i32 }
function discrim(sh: Circle | Square | Tri): i32 {
  if sh.kind == "circle" { return sh.r * 3 }
  else if sh.kind == "square" { return sh.s * sh.s }
  return sh.b
}
print(discrim({ kind: "circle", r: 2 }))
print(discrim({ kind: "square", s: 3 }))
print(discrim({ kind: "tri", b: 7 }))
