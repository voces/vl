// @run
// @log 5
// @log 4
// @log 4
// @log 4
// @log 4
// @log 4
// A by-rep identity's result returned by another function is built where the identity's argument
// is, also when the identity is called at its own storage too, directly or through a held
// binding (D15125).
type J = { f: i32 | null }
function mk() { { f: 4 } }
function back(r) { return r }
const wideJ: J = mk()
const xs = [mk()]
const plain = { f: 5 }
print(back(plain).f)
function g() { return back(xs[0]) }
print(g().f)
function h() {
  const c = back(xs[0])
  return c
}
print(h().f)
const v = g()
print(v.f)
function take(r: { f: i32 }) { r.f }
print(take(h()))
print(wideJ.f ?? 0)
