// @run
// @log 1
// @log h
// @hint redundant type annotation: `y` is inferred as `i32` — remove it to lean on inference
// A call of the `__str_from_bytes__` builtin runs no function it is handed, so a path narrowing
// survives it (D4784).
type A = { x: i32 | string }
const b: u8[] = []
b.push(104)
function path(a: A) {
  if a.x is i32 {
    const s = __str_from_bytes__(b, 0, 1)
    const y: i32 = a.x
    print(y)
    print(s)
  }
}
path({ x: 1 })
