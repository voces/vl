// @emit-error is handed on here at its own element type
// @hint redundant type annotation: `i` is inferred as `{f: i32}`
// D2924: an un-annotated object literal holding a re-seated list picks the record its own field
// types name, whose field is a list of the literal's record, so the field is refused.
const i: { f: i32 } = { f: 4 }
type I = { f: i64 | null }
const il = [{ f: 7 }]
const ic: I[] = il
const hh = { xs: il }
print(hh.xs[0].f)
