// @run
// @log 4
// @log 1
// @log 1
// @log 1
// @log 1
// A read of a map whose values are built wider, defaulted with `??` to a record that no binding,
// return or write holds: the default is delivered at the read's record all the same (D15319).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const m = Map()
m.set("a", mk())
const wm: {[string]: J} = Map()
wm.set("a", mk())
function id<T>(d: T): T { d }
function mk2() { { f: 1 } }
function mk4() { mk2() }
const lit = { f: 1 }
print((m.get("a") ?? id({ f: 1 })).f ?? 0)
print((m.get("z") ?? { f: 1 }).f ?? 0)
print((m.get("z") ?? mk4()).f ?? 0)
print((m.get("z") ?? lit).f ?? 0)
const x = (m.get("z") ?? id({ f: 1 })).f
print(x)
