// @run
// @log 7
// @log 3
// @log 7
// @log 4
// D2914 and D2917 refuse only where the destination's record is stored differently from the
// elements' own: two records of one layout share a heap type, so every use of the list and an
// already-built element both run.
type J = { f: i32 }
type I = { f: i32 }
const i: J = { f: 4 }
function mk() { { f: 7 } }
const il = [{ f: 7 }]
const ic: I[] = il
const z = il.map((e) => e.f)
print(z[0] + ic.length - 1)
const bl = [mk(), { f: 3 }]
const bc: I[] = bl
print(bc[1].f)
print(bc[0].f)
print(i.f)
