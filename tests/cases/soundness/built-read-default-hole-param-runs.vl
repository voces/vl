// @run
// @log 4
// A maker called more than once keeps its own record; its call is copied where it lands wider.
// A `??` over a map read of a maker's calls, defaulted to a hole parameter, runs (D15318).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const m = Map()
m.set("a", mk())
const wm: {[string]: J} = Map()
wm.set("a", mk())
function pick(d) { (m.get("a") ?? d).f }
print(pick({ f: 1 }))
