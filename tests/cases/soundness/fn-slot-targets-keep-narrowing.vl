// @run
// @log 5
// @log 5
// @log 5

// D15148: a call through a map slot or list element runs one of the functions ever stored
// there, so a narrowing of that slot survives when none of them can write it.

const m = Map()
m["k"] = (a: i32) => a + 1
if m["k"] != null {
  if m["k"](4) == 5 { print(m["k"](4)) }
}

const xs: (((a: i32) => i32) | null)[] = [(a: i32) => a + 1]
if xs[0] != null {
  if xs[0](4) == 5 { print(xs[0](4)) }
}

// A stored function that writes something else.
let n = 0
const w = Map()
w["k"] = (a: i32) => {
  n = n + 1
  a + 1
}
if w["k"] != null {
  if w["k"](4) == 5 { print(w["k"](4)) }
}
