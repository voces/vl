// @run
// @log -1
// @log -1
// @log -1
// @log -1
// @log -1
// @log 5
// @log 6
// @log 6
// @log 5
// @log w
// @log none
// A write in a short circuit's right side, a `??` default or a `?.` call's argument may not
// run, so the place keeps its type after the operator; the arm the right side decides still
// reads the write (D2451).
function nn(v: i32): i32 | null {
  if v < 0 { return null }
  return v
}
function t() { return true }
function f() { return false }
function id(b: boolean) { return b }
function coal() {
  let c: i32 | null = null
  nn(3) ?? (c = 5)
  print(c ?? -1)
}
function and() {
  let c: i32 | null = null
  f() && (c = 5) > 0
  print(c ?? -1)
}
function or() {
  let c: i32 | null = null
  t() || (c = 5) > 0
  print(c ?? -1)
}
function opt() {
  let c: i32 | null = null
  const xs: i32[] | null = null
  xs?.push(c = 5)
  print(c ?? -1)
}
function elseArm() {
  let c: i32 | null = null
  if id(f() && (c = 5) > 0) { print(0) } else { print(c ?? -1) }
}
function ran() {
  let c: i32 | null = null
  f() || (c = 5) > 0
  print(c ?? -1)
}
function thenArm() {
  let c: i32 | null = null
  if t() && (c = 5) > 0 { print(c + 1) }
}
function elseOfOr() {
  let c: i32 | null = null
  if !(f() || (c = 5) < 0) { print(c + 1) }
}
function after() {
  let c: i32 | null = null
  if t() && (c = 5) > 0 {}
  print(c ?? -1)
}
function str() {
  let s: string | null = null
  nn(-1) ?? (s = "w").length
  print(s ?? "none")
  let u: string | null = null
  nn(1) ?? (u = "w").length
  print(u ?? "none")
}
coal()
and()
or()
opt()
elseArm()
ran()
thenArm()
elseOfOr()
after()
str()
