// @run
// @log 2.5
// @log flipped
// @log 4.5
// @log false
// @log none
// A call that may write a narrowed place ends its narrowing, and a re-test after the call reads
// the place's storage and narrows it again (D2408, D2449, D2464). A test after a call in the same
// condition narrows past it (D3251).
type W = { value: f64 | boolean }
type R = { f: (() => i32) | null }
const NF: (() => i32) | null = null
const xs: (i32 | string)[] = [1]
function wx() { xs[0] = "s" }
function bare() {
  let v: boolean | f64 = 1.5
  let step = 0
  const k = (): boolean => {
    step = step + 1
    v = if step == 1 { 2.5 } else { true }
    true
  }
  if v is f64 && k() {
    if v is f64 { print(v) }
  }
  if v is f64 && k() {
    if v is f64 { return "still" }
    return "flipped"
  }
  "none"
}
function mutate(w: W) {
  w.value = 4.5
  true
}
function path(v: W) {
  if v.value is f64 {
    if mutate(v) {
      if v.value is f64 { return v.value }
    }
  }
  0.0
}
function clrB(q: R) {
  q.f = NF
  return true
}
function first(z: R) {
  if clrB(z) && z.f != null { return "called" }
  "none"
}
print(bare())
print(path({ value: 1.5 }))
if xs[0] is i32 {
  const c = (): boolean => xs[0] is i32
  wx()
  print(c())
}
print(first({ f: () => 5 }))
