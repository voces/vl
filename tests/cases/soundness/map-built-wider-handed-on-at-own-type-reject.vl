// @check
// @error `m`, which holds a fresh map, is built as J where line 11 delivers it, and it is handed on here at its own type, which stores a field differently
// @error `n`, which holds a fresh map, is built as J where line 23 delivers it, and it is handed on here at its own type, which stores a field differently
// CONTRACT (must-error): a `Map()` binding whose values one delivery builds at a wider record is
// not handed on at its own type: not returned from an un-annotated function, and not passed to a
// parameter annotated at that type, at module scope or in a function, as a list literal binding
// is not (D15180). A map is shared, not copied, so its values cannot be stored both ways.
type J = { f: i32 | null }
const m = Map()
m.set("a", { f: 4 })
const wm: {[string]: J} = m
const d = { f: 1 }
const w3 = { k: { x: { f: 7 } } }
w3.k = { x: m.get("a") ?? d }
function whole() { return m }
function h(x: {[string]: {f: i32}}) { return x.get("a")?.f ?? 0 }
print(h(m))
print(whole().length)
print(wm.length)
function go() {
  const n = Map()
  n.set("a", { f: 4 })
  const wn: {[string]: J} = n
  const w4 = { k: { x: { f: 7 } } }
  w4.k = { x: n.get("a") ?? d }
  function back() { return n }
  print(back().length + wn.length + h(n))
}
go()
