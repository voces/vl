// @run
// @log 4
// @log 1
// @log 4
// A hole parameter handed a call result the checker rebuilds at a wider record and a plain
// literal is elaborated once per record: the key names the delivered row (D15173).
type J = { f: i32 | null }
function mk() { { f: 4 } }
function r() {
  const k = mk()
  return k
}
function u(a) { a.f }
const d: J = mk()
print(u(r()))
print(u({ f: 1 }))
print(d.f ?? 0)
