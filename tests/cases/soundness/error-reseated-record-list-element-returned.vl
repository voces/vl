// @check
// @error argument 1: expected {f: i32}, got I (`il` holds only a literal, so it is built as the `I[]`
// D2922: a list of literals adopts the `I[]` it is delivered to, so `g`'s inferred return is an
// `I`, and handing it to a `{ f: i32 }` parameter is refused, as the annotated
// `const il: I[] = [{ f: 7 }]` is. A record is shared, not copied.
const i: { f: i32 } = { f: 4 }
type I = { f: i64 | null }
function show(r: { f: i32 }) { print(r.f) }
const il = [{ f: 7 }]
const ic: I[] = il
function g() { return il[0] }
show(g())
print(ic[0].f)
