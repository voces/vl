// @emit-error is handed on here at its own element type
// @hint redundant type annotation: `i` is inferred as `{f: i32}`
// D2922: an element of a re-seated list returned by an un-annotated function is handed on by
// that function's calls, so a call delivering it at the list's own record is refused.
const i: { f: i32 } = { f: 4 }
type I = { f: i64 | null }
function show(r: { f: i32 }) { print(r.f) }
const il = [{ f: 7 }]
const ic: I[] = il
function g() { return il[0] }
show(g())
print(ic[0].f)
