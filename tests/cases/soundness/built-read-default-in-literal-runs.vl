// @run
// @log 4
// @log 4
// @log 4
// @log 4
// A `??` default written for a read of a map whose values are built wider, placed in a list or
// record literal: the literal is built with that slot at the read's record (D15312).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const m = Map()
m.set("a", mk())
const wm: {[string]: J} = Map()
wm.set("a", mk())
const xs = [m.get("a") ?? { f: 1 }]
print(xs[0].f ?? 0)
const s = { g: m.get("a") ?? { f: 1 } }
print(s.g.f ?? 0)
function mkd() { { f: 1 } }
const ys = [m.get("a") ?? mkd()]
print(ys[0].f ?? 0)
const b = m.get("a") ?? { f: 1 }
const zs = [b]
print(zs[0].f ?? 0)
