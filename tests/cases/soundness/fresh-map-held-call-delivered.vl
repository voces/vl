// @run
// @log 1
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// D14503: a binding holding a call is delivered as the call is, so the `Map()` the function
// returns is built at the map `sink` takes.
type Circle = { r: i32 | null }
function sink(_x: {[string]: Circle}) {}
function mk() {
  const lv1 = Map()
  lv1["k0"] = { r: null }
  return lv1
}
const mm = mk()
sink(mm)
print(mm.length)
