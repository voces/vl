// D2060 — the other half of the rule: a record delivered where a wider field is declared runs
// wherever nothing it reaches writes a widened field a value the source's field cannot hold.
// Reads, writes to a field not widened, writes of a value the source's field accepts, writes
// into a fresh literal, and a read-only recursion all run; `error-covariant-record-field-written.vl`
// is the refused half.
import { sort } from "std:array"

type Circle = { r: i32 }

function show(p: { x: i32 | string }) {
  if p.x is i32 { print(p.x) } else { print(p.x) }
}
function applyTo(p: { x: i32 | string }, f: ({ x: i32 | string }) => void) {
  f(p)
}
function passBack(p: { x: i32 | string }): { x: i32 | string } { return p }
type Fl = { x: i32 | string, n: i32 }
function bump(self: Fl): Fl {
  self.n = self.n + 1
  return self
}
type Pn = { name: string | null, age: i32 }
function byAge(ps: Pn[]) { ps.sort((a: Pn, b: Pn) => a.age < b.age) }
function setNarrow(p: { x: i32 | string }) { p.x = 40 }
function bumpY(p: { x: i32 | string, y: i32 }) { p.y = p.y + 10 }
function fill(p: { x: i32 | string }) {
  p.x = "fresh"
  show(p)
}
function walk(p: { x: i32 | string }, n: i32) {
  if n > 0 { walk(p, n - 1) } else { show(p) }
}
function peek(p: { c: Circle | null }) {
  if p.c != null { print(p.c.r) }
}
function deepShow(p: { inner: { x: i32 | string } }) {
  if p.inner.x is i32 { print(p.inner.x) }
}
function sum(ps: { x: i32 | string }[]) {
  let t = 0
  for e in ps {
    if e.x is i32 { t = t + e.x }
  }
  print(t)
}
function boundShow<T: { x: i32 | string }>(t: T) {
  if t.x is i32 { print(t.x) }
}
type W = { x: i32 | string }
function describe(self: W) { show(self) }
function same(self: W): W { return self }
function countInts(ps: { x: i32 | string }[]) {
  const ints = ps.filter((e) => e.x is i32)
  const ys = ints.map((e) => if e.x is i32 { e.x } else { 0 })
  print(ys.length)
}

const a = { x: 1 }
show(a)
const b = { x: 2, y: 3 }
bumpY(b)
print(b.x + b.y)
fill({ x: 0 })
walk(a, 3)
const d = { c: { r: 4 } }
peek(d)
print(d.c.r)
const n = { inner: { x: 5 } }
deepShow(n)
print(n.inner.x + 1)
const xs = [{ x: 6 }, { x: 7 }]
sum(xs)
print(xs[0].x + xs[1].x)
boundShow(a)
a.describe()
const alias: { x: i32 | string } = a
const reader = () => {
  show(alias)
}
reader()
const m = { x: 2 }
setNarrow(m)
print(m.x + 2)
mainFirst()
const jr: { x: i32 | string } = { x: "a" }
const joined = [a, jr]
for je in joined {
  if je.x is i32 { print(je.x) }
}
countInts(xs)
applyTo(a, (r: { x: i32 | string }) => {
  show(r)
})
passBack(a)
const fl = { x: 1, n: 0 }
fl.bump()
print(fl.n)
const people = [{ name: "ann", age: 40 }, { name: "bob", age: 30 }]
byAge(people)
print(people[0].age)
show(a.same())
print(a.x + 1)

// Declared after the call above: the stored value's type is known once every body is checked.
function mainFirst() {
  const mf = { x: 3 }
  setLater(mf)
  print(mf.x + 1)
}
function setLater(p: { x: i32 | string }) { p.x = 50 }

// A union join handed to a record parameter that reads a scalar field; a `match` join read; a
// read-only rest parameter; a swap of two widened fields through the source's own values.
type Item = { name: string, qty: i32, note: string | null }
function cost(it: Item) { return it.qty * 10 }
const ia = { name: "a", qty: 2, note: null }
const ib = { name: "b", qty: 3, note: "x" }
const pickI = if ia.qty > 1 { ia } else { ib }
print(cost(pickI))
const mk = 1
const mw: { x: i32 | string } = { x: "b" }
const mj = match mk {
  1 => a
  _ => mw
}
if mj.x is i32 { print(mj.x) }
function countRest(...ws: { x: i32 | string }[]) { return ws.length }
print(countRest(a, a))
type Pair = { l: i32 | null, r: i32 | null }
function swapLR(p: Pair) {
  const t = p.l
  p.l = p.r
  p.r = t
}
const pr = { l: 1, r: 2 }
swapLR(pr)
print(pr.l + pr.r)
