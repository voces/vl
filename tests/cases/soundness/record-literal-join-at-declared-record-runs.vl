// @run
// @log 1
// @log 5
// @log 1
// A join of record literals, one holding a record and the other `null` in a field, delivered as
// the one record whose field is that record or `null`: each arm is built there, and the join holds
// that record (D15719).
type J = { a: i32 }
type K = { j: J | null }
const go = [1].length > 0
const k: K = if go { { j: { a: 1 } } } else { { j: null } }
print(k.j?.a ?? 5)
const n = 2
const m: K = match n {
  1 => { j: { a: 1 } }
  _ => { j: null }
}
print(m.j?.a ?? 5)
function use(x: K) { print(x.j?.a ?? 5) }
use(if go { { j: { a: 1 } } } else { { j: null } })
