// @run
// @log false
// @log true
// @log true
// @log 0
// @log 1
// @log true
// An explicit type argument fixes the element of an empty list literal handed at a parameter that
// spells it, as an annotation does (DECISIONS "An explicit type argument fixes an empty list
// literal's element"); a literal nothing fixed, or one only another argument's binding settles,
// still fits every `is T[]`.
function g<V>(v: V[]) { return v is f64[] }
function o<V>(v: V[]) { return v is f64[] }
function h<V>(v: V[][] | string) {
  if v is f64[][] { return 1 }
  return 0
}
function pair<V>(a: V[], b: V) {
  if b == b { return a is f64[] }
  return false
}
print(g<i32>([]))
print(g<f64>([]))
print(o([]))
print(h<i32>([]))
print(h<f64>([]))
print(pair([], 1))
