// @check
// @error-at 17:16 f64 doesn't fit in i32
// @error-at 18:16 f64 doesn't fit in i32
// @error-at 19:5 argument 1: expected i32, got f64
// @error-at 20:24 cannot be used as `(i32) => i32` here
// @error-at 21:11 `declG` returns f64 at this call's types
// @error-at 22:16 `declWrapG` returns f64 at this call's types
// D8941, D8942: a generic function's undeclared numeric result is taken from its body at the
// call's bound types, so `x / 2.0` at `T := i32` is `f64` and is refused at an `i32` binding,
// argument and function type. A declared `T` result whose body gives `f64` at `T := i32` is
// refused at the call.
function half(a) { return a / 2.0 }
function halfG<T>(x: T) { return x / 2.0 }
function wrapG<T>(x: T) { return half(x) }
function declG<T>(x: T): T { return x / 2.0 }
function declWrapG<T>(x: T): T { return half(x) }
function take(v: i32) { print(v) }
const r1: i32 = halfG(3)
const r2: i32 = wrapG(3)
take(wrapG(3))
const f: (i32) => i32 = wrapG
const r3 = declG(3)
const r4: i32 = declWrapG(3)
print(r1)
print(r2)
print(r3)
print(r4)
print(f(3))
