// @run
// @log 3
// @log 9
// @log 1
// @log true
// @log 0
// @log 1
// @log true

// D2589: what a write in a condition leaves standing. A test after the write narrows, a write
// the narrowing admits keeps it, and a re-test or a null test reads the place as written.
type A = { r: i32 }
type R = { f: A | null }
function mkA(n: i32): A | null {
  if n == 0 { return null }
  { r: n }
}

function go(n: i32) {
  const p = { f: mkA(7) }
  let x = mkA(7)
  if (if n == 1 { p.f = mkA(3); true } else { false }) && p.f != null {
    print(p.f.r)
  }
  if p.f != null && (if n == 1 { p.f = { r: 9 }; true } else { false }) {
    print(p.f.r)
  }
  if x != null && (if n == 1 { x = null; true } else { false }) { print(1) }
  print(x == null)
  x = mkA(5)
  if x != null && (if n == 1 { x = null; true } else { false }) {
    if x != null { print(x.r) } else { print(0) }
  }
  x = mkA(5)
  if x == null || (if n == 1 { x = null; false } else { false }) {
    print(0)
  } else {
    print(1)
  }
  print(x == null)
}

go(1)
