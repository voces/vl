// @run
// @log 7
// @log 4
// D2909: a list of literals returned where the function declares a list of a record storing its
// field as `i64 | null` takes that list type, so it is built there, beside a declared
// `{ f: i32 }` record of the literal's own field storage.
const i: { f: i32 } = { f: 4 }
type I = { f: i64 | null }
function mk(): I[] {
  const il = [{ f: 7 }]
  il
}
print(mk()[0].f)
print(i.f)
