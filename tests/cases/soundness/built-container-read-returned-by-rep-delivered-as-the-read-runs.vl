// @run
// @log true
// @log 4
// @log 4
// @log 8
// @log 4
// A by-rep identity's result is read where its argument is: compared, bound, held in a list or a
// field, or handed back again (D14819).
type J = { f: i32 | null }
function mk() { { f: 4 } }
function back(r) { return r }
const wideJ: J = mk()
const xs = [mk()]
print(back(xs[0]) == xs[0])
const b = back(back(xs[0]))
print(b.f)
const keep = [back(xs[0]), back(xs[0])]
const z = keep[1]
print(z.f)
const m = { a: back(xs[0]), n: xs[0] }
print(m.a.f + m.n.f)
print(wideJ.f ?? 0)
