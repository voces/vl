// @run
// @log 1
// @log 4
// @log 1
// @log 1
// @log 4000000000
// A read of a map whose values are built wider, its record holding a nested record, defaulted
// with `??` to a `const` of a literal: the binding keeps its own type and is built at the read's record, so the
// join is one record and its nested field reads that record's storage (D15310).
type H = { f: i32 | null }
type J = { h: H }
function mk() { { h: { f: 4 } } }
const m = Map()
m.set("a", mk())
const wm: {[string]: J} = Map()
wm.set("a", mk())
const d = { h: { f: 1 } }
const b = m.get("z") ?? d
print(b.h.f ?? 0)
const dh = { h: { f: 1 } }
const hit = m.get("a") ?? dh
print(hit.h.f ?? 0)
const db = { h: { f: 1 } }
const bb = m.get("z") ?? db
const hh = bb.h
print(hh.f ?? 0)
print(d.h.f + 0)
type H64 = { f: i64 }
type K = { h: H64 }
function mk64() { { h: { f: 4 } } }
const m64 = Map()
m64.set("a", mk64())
const wm64: {[string]: K} = Map()
wm64.set("a", mk64())
const d64 = { h: { f: 1 } }
const b64 = m64.get("z") ?? d64
print(b64.h.f * 4000000000)
