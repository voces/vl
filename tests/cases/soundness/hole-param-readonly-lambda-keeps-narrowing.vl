// @run
// @log 1
// @log 4
// A read-only `const` lambda in a body with an un-annotated parameter does not end the narrowing:
// the body is checked again at the call's argument types, which decide, and there the lambda
// writes nothing.
function g(xs) {
  const h = () => {
    print(xs.length)
  }
  if xs[0] is i32 {
    h()
    return xs[0] + 1
  }
  0
}
const xs: (string | i32)[] = [3]
print(g(xs))
