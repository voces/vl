// @run
// @log 5
// @log 5
// @log 7
// @log 6
// @log 8
// @log 0.5
// @log 1.5
// @log 0.5
// @log 2.5
// @log 5
// @log 5
// @log 9
// @log 5
// @log 7
// @log 5
// @log true
// @log false
// @log true
// @log a
// @log b
// @log b
// @log null
// @log false
// @log 4
// @log y
// A `?.` read of a field that can itself hold `null` is null when the receiver or the field
// is, and `?? d` defaults on either (D3457). Each field type has its own encoding of `null` —
// the value box, the boolean and literal-union sentinels, the null string — and each is read
// here through a nullable receiver, a nested chain, a function and an object literal.
type L = "a" | "b"
type P = { a: i32, b: i32 | null, w: i64 | null, f: f64 | null, g: f32 | null }
type Q = {
  s: string | null,
  l: L | null,
  k: L,
  t: boolean | null,
  u: i32 | string | null,
}
type O = { p: P | null }

const none: P | null = null
const hole: P | null = { a: 1, b: null, w: null, f: null, g: null }
const full: P | null = { a: 1, b: 7, w: 8, f: 1.5, g: 2.5 }
print(none?.b ?? 5)
print(hole?.b ?? 5)
print(full?.b ?? 5)
print(hole?.w ?? 6)
print(full?.w ?? 6)
print(hole?.f ?? 0.5)
print(full?.f ?? 0.5)
print(hole?.g ?? 0.5)
print(full?.g ?? 0.5)

const o0: O | null = { p: null }
const o1: O | null = { p: { a: 1, b: null, w: null, f: null, g: null } }
const o2: O | null = { p: { a: 1, b: 9, w: null, f: null, g: null } }
print(o0?.p?.b ?? 5)
print(o1?.p?.b ?? 5)
print(o2?.p?.b ?? 5)

function pick(p: P | null) {
  const b = p?.b ?? 5
  const r = { a: p?.a ?? 0, b: b }
  r.a + r.b
}
print(pick(null))
print(pick({ a: 2, b: null, w: null, f: null, g: null }))
print(pick({ a: 2, b: 3, w: null, f: null, g: null }))

const qn: Q | null = { s: null, l: null, k: "a", t: null, u: null }
const qf: Q | null = { s: "x", l: "b", k: "b", t: false, u: "y" }
print(qn?.s == null)
print(qf?.s == null)
print(qn?.l == null)
print(qn?.l ?? "a")
print(qf?.l ?? "a")
print(qf?.k ?? "a")
print(qn?.t)
print(qf?.t ?? true)
print(qn?.u ?? 4)
print(qf?.u ?? 4)
