// @run
// @info `q` is never reassigned; use `const` instead of `let`
// @log 4
// @log 1
// @log 1
// @log 1
// @log 7
// @log 2
// @log 2
// A list literal part reading a binding of a call's fresh record is built, with the binding and its
// function, at the record the list's other parts are built at (D15655).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const wideJ: J = mk()
print(wideJ.f ?? 0)
const xs = [mk()]
function os0() { { f: 1 } }
const o = os0()
const ws = [xs[0], o]
print(ws[1].f ?? 0)
const vs = [o, xs[0]]
print(vs[0].f ?? 0)
print(o.f ?? 0)
o.f = 7
print(ws[1].f ?? 0)
function os2() { { f: 2 } }
function g() {
  const p = os2()
  const ys = [xs[0], p]
  print(ys[1].f ?? 0)
}
g()
let q = os2()
const zs = [xs[0], q]
print(zs[1].f ?? 0)
