// @check
// @error-at 13:12 this {f: i32} is stored at J, the row the stores into its container build; handing it on as {f: i32} is type-valid but not supported yet
// @error-at 14:14 this {f: i32} is stored at J, the row the stores into its container build; handing it on as {f: i32} is type-valid but not supported yet
// @error-at 15:11 this {f: i32} is stored at J, the row the stores into its container build; handing it on as {f: i32} is type-valid but not supported yet
// VERDICT PIN (must-error): a hole parameter that stores, captures or returns a value read out of
// a built container refuses until those positions take the build's rep (D14754).
type J = { f: i32 | null }
function mk() { { f: 4 } }
function field(r) { const o = { a: r }; o.a.f + 1 }
function capture(r) { const c = () => r.f + 1; c() }
function back(r) { return r }
const wideJ: J = mk()
const xs = [mk()]
print(field(xs[0]))
print(capture(xs[0]))
print(back(xs[0]).f)
print(wideJ.f ?? 0)
