// @check
// @error 'r' is no longer narrowed to B: the assignment to 'alias.k' on line 12 may reassign it
// VERDICT PIN (must-error, D4083): a field store through an alias of `r` retires `r is B`
// exactly as a store through `r` would, so `r.k` reads at its declared `i32`. This program
// checked clean and printed 5.
type K = 0 | 1
type A = { k: i32 }
type B = { k: K }
const r: A = { k: 0 }
const alias = r
if (r is B) {
  alias.k = 5
  const e: K = r.k
  print(e)
}
