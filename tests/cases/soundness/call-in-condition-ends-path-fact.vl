// @check
// @error-at 12:43 operator '*' is not defined for f64 | boolean and f64
// @error-at 17:9 operator '*' is not defined for f64 | boolean and f64
// A path fact a condition establishes is dropped when a call later in the same condition may
// write the path: the test ran before the call. Both the `&&` then-arm and the `||` early
// return lose the fact, and the reads below are at the declared type (D2404).
type W = { value: f64 | boolean }
function mutate(w: W): boolean {
  w.value = true
  false
}
function andArm(v: W): f64 {
  if v.value is f64 && !mutate(v) { return v.value * 2.0 }
  0.0
}
function orGuard(v: W): f64 {
  if !(v.value is f64) || mutate(v) { return 0.0 }
  return v.value * 2.0
}
print(andArm({ value: 1.5 }))
print(orGuard({ value: 1.5 }))
