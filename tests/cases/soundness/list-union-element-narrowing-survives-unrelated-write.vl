// @run
// @log 1
// D4926's other half over a declared union of lists: a call that writes only a `string[]`
// cannot reach either member, so `v is K[]` still narrows the read after it.
type K = 0 | 1
const src = [0, 1]
const names = ["a"]
const v: K[] | i32[] = src
const f = () => {
  names[0] = "b"
}
if (v is K[]) {
  f()
  const show = (x: K) => {
    print(x)
  }
  show(v[1])
}
