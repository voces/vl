// @run
// @log 1
// @log 1
// @log 1
// @log 1
// @log 3
// @log 4
// @log 1
// @log 1
// @log 1
// @log 2
// A push of a kept maker's call stores into the list as an index write does, so the list is built
// at the call's record; a spread of such a list is built there too (D15657).
type J = { f: i32 | null }
function mk2() { { f: 1 } }
const dA: J = mk2()
print(dA.f ?? 0)
const xs = [mk2()]
xs.push(mk2())
print(xs[1].f ?? 0)
const b = mk2()
const bs = [b]
bs.push(b)
print(bs[1].f ?? 0)
function go() {
  const gs = [mk2()]
  const c = mk2()
  gs.push(c)
  print(gs[1].f ?? 0)
}
go()
const ws = [mk2()]
let i = 0
while i < 2 {
  ws.push(mk2())
  i = i + 1
}
ws.push({ f: 3 })
print(ws[3].f ?? 0)
print(ws.length)
const ys = [...xs, mk2()]
print(ys[2].f ?? 0)
const zs = [mk2(), ...xs]
print(zs[1].f ?? 0)
const vs = [...xs]
vs.push(mk2())
print(vs[2].f ?? 0)
print(vs.length - 1)
