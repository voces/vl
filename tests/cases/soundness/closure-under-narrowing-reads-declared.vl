// @run
// @log 2
// @log 3
// @log -1
// @log 3
// A nested function runs when it is called, so a narrowing it captures holds inside it only
// while nothing may write the binding. A binding some closure writes reads at its declared type
// inside every nested function, which then re-tests it; a lambda handed straight to `map` runs
// during that call and keeps the narrowing (D2402).
let k = () => {}

function reTestInside() {
  let v: boolean | f64 = 1.5
  const w = (): void => {
    v = true
  }
  if v is f64 {
    const r = (): f64 => {
      if v is f64 { return v * 2.0 }
      -1.0
    }
    const a = r()
    w()
    return a + r()
  }
  0.0
}

function escaped(): () => f64 {
  let v: boolean | f64 = 1.5
  k = () => {
    v = true
  }
  if v is f64 {
    return (): f64 => {
      if v is f64 { return v * 2.0 }
      -1.0
    }
  }
  (): f64 => 0.0
}

function mapped() {
  let v: boolean | f64 = 1.5
  const w = () => {
    v = true
  }
  if v is f64 {
    const xs = [1.0, 2.0].map((x: f64): f64 => x * v)
    w()
    return xs[1]
  }
  0.0
}

print(reTestInside())
const r = escaped()
print(r())
k()
print(r())
print(mapped())
