// @run
// @log 4
// @log 5
// @log 6
// @log 7
// @log 8
// @log 9
// @log 10
// @log 11
// @log 12
// @log 12
// @log 13
// @log 14
// @log 16
// D7941: a record literal handed through a generic identity that alone pins its instance is built
// at the record it is delivered to, so a declared record of the literal's own fields (`Col`)
// cannot change the verdict. Each delivery position prints the widened field.
type Col = { r: i32, g: i32, b: i32 }
type J = { r: i32 | null, g: i32, b: i32 }
type W = { j: J }
type L = { f: (i32 | null)[] }
function idn<T>(v: T): T { v }
function useJ(j: J) { print(j.r ?? 0) }
function retJ(): J { idn({ r: 7, g: 1, b: 2 }) }

const a: J = idn({ r: 4, g: 1, b: 2 })
print(a.r ?? 0)
const b: J = idn(idn({ r: 5, g: 1, b: 2 }))
print(b.r ?? 0)
const c: J | null = idn({ r: 6, g: 1, b: 2 })
print(c?.r ?? 0)
print(retJ().r ?? 0)
useJ(idn({ r: 8, g: 1, b: 2 }))
let d: J = { r: 1, g: 1, b: 2 }
d = idn({ r: 9, g: 1, b: 2 })
print(d.r ?? 0)
const xs: J[] = [idn({ r: 10, g: 1, b: 2 })]
print(xs[0].r ?? 0)
const w: W = { j: idn({ r: 11, g: 1, b: 2 }) }
print(w.j.r ?? 0)
const s = idn({ r: 12, g: 1, b: 2 })
print(s.r)
useJ(s)
const l: L = idn({ f: [13] })
print(l.f[0] ?? 0)
const col = idn({ r: 14, g: 1, b: 2 })
print(col.r)
const e: J = idn({ r: 16, g: 1, b: 2 })
print(e.r ?? 0)
