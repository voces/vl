// @run
// @log 4
// @log 6
// @log 6
// @log 6
// @log 7
// @log 6
// @log 9
// A fresh call result written into a field of a receiver built wider, its function called
// elsewhere at its own type, is copied to the field's stored record where it is written (D15822);
// a binding of that field reads the stored record (D15824).
type J = { f: i32 | null }
type K = { j: J | null }
function mk() { { j: { f: 4 } } }
const _k: K = mk()
print(_k.j?.f ?? 0)
const y = mk()
function mj() { { f: 6 } }
y.j = mj()
const z = mj()
function own(q: { f: i32 }) { q.f }
print(y.j.f)
print(own(z))
z.f = 7
print(y.j.f)
print(z.f)
const zs = [mj(), mj()]
print(zs[1].f)
const w = y.j
w.f = 9
print(y.j.f)
