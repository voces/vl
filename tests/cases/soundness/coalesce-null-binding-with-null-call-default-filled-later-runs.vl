// @run
// @log a
// @log nf
// @log 7
// @log 7
// @log 2
// D3408: a `??` over a `null` binding whose default is a call returning only `null` is nullable,
// so a binding it initialises takes a later record or list fill.
function nf() {
  print("nf")
  null
}
function t(n: i32) {
  const z = null
  let w = if n == 1 {
    print("a")
    z ?? nf()
  } else {
    null
  }
  w = { x: 7 }
  print((w ?? { x: 9 }).x)
}
t(1)
function q() { null }
function r() { null }
function c() {
  const z = null
  let w = z ?? z ?? q()
  w = { x: 7 }
  print((w ?? { x: 9 }).x)
  const y = null
  let l = y ?? r()
  l = [1, 2]
  print((l ?? []).length)
}
c()
