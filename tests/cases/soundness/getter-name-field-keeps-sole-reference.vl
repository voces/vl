// @run
// @log 5
// @log 3
// @log 5
// @log true
// @hint redundant type annotation: `g` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `v` is inferred as `i32` — remove it to lean on inference

// D3760: a field read `p.me` is not a getter read when `p`'s type has the field, even with a
// getter `me` on another type or one std brings in (`std:simd`'s `x`), so the fresh const stays
// the only holder of its object and a write through another value keeps its narrowing.
import { splatF32 } from "std:simd"

type A = new { me: i32, f: i32 | null }
type H = new { k: i32 }
get me(self: H): i32 { self.k }
function g(o: A): i32 {
  const p: A = { me: 1, f: 4 }
  const n = p.me
  if p.f != null {
    o.f = null
    return p.f + n
  }
  0
}
print(g({ me: 0, f: 1 }))
const h: H = { k: 3 }
print(h.me)

type V = new { x: f64, y: f64, tag: i32 | null }
function v(o: V): i32 {
  const p: V = { x: 1.0, y: 2.0, tag: 4 }
  const s = p.x + p.y
  if p.tag != null {
    o.tag = null
    return p.tag + 1
  }
  if s > 2.5 { return 9 }
  0
}
print(v({ x: 0.0, y: 0.0, tag: 1 }))
print(splatF32(1.0).x > 0.0)
