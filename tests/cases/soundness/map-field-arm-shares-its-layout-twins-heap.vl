// @run
// @log 7
// @log 7
// @hint redundant type annotation: `wv` is inferred as `{g: {[string]: Dot}}` — remove it to lean on inference
// @hint Intentionally-unused variable `_sp2` (leading `_` marks it unused)
// silent-class-inventory D624 (2026-08-30). `vl check` returned 0 and `vl run` printed
// `Invalid input WebAssembly code: type mismatch: expected (ref [null] $type), found
// (ref $type)` for both programs below.
//
// WHAT IT PINS: `variantStructHeapTwinAt`'s field-storage guard, widened at the MAP codes.
// D280 gives a union arm and a declared struct of its exact layout ONE WasmGC heap type, but
// its layout guard declined outright on any field whose storage is a `(ref [null] <heap>)`
// the code does not name — and a MAP-typed field (19, or 29 for its `| null` niche) was the
// single largest decline: over the distilled corpus the function was asked 11,866 times on
// 1,784 cells and declined 2,836 times on 112 cells right there, against 29 cells at the
// nested-struct code and none at the ref-list codes. So `Circle` the arm and `Dot` the
// declared twin stayed two heap types, the two `{[string]: <that shape>}` maps built over
// them stayed two map structs, and the store of one into the other was invalid wasm.
//
// The descent is SLOT EQUALITY (`uFieldMapShape` / `sFieldMapShape`, each table's one home
// for "which map does this field denote"), not the twin relation: two fields resolving the
// same shape emit the same map struct because `mvMapTypeIdx` is a function of the slot, and
// asking the mv layer nothing it has to compute is what keeps this rung out of the
// `repMapValSlotsTwin` -> `variantStructHeapTwinAt` cycle. See D627 for the pair that slot
// equality still declines — a map whose VALUE type has a layout twin of its own.
//
// TWO PROGRAMS, because the family has two reach paths and each was filed separately. The
// first reaches the merge through a STRUCT FIELD with both ends annotated to DIFFERENT
// declared rows, and reads the stored value back so the merge is graded on a hit and not
// only on the validator's acceptance. The second is the row's filed witness: nothing
// annotated, the carrier reaching a LIST element, and the `Box1`/`_sp1` spacer that was
// load-bearing on the un-annotated spelling.
type Circle = { r: {[string]: i32} }
type Dot = { r: {[string]: i32} }
type Sq = { s: i32 }
type Shape = Circle | Sq
type GW = { g: {[string]: Circle} }
function mkcall(): {[string]: Dot} {
  const cc: {[string]: Dot} = Map()
  const inner: {[string]: i32} = Map()
  inner["n"] = 7
  cc["k0"] = { r: inner }
  return cc
}
function outer() {
  const wv: GW = { g: mkcall() }
  const got = (wv.g)["k0"] ?? { r: Map() }
  print((got.r)["n"] ?? 0)
}
outer()

// PROGRAM 2 — the row's filed witness, with the `else` arm turned into a printed 7 so a
// silent skip cannot pass for a pass. Nothing here is annotated: `lv2`'s `Map()` infers its
// value row from the first key write while `Box2`'s element names `Circle2`, and the two
// ends land on the arm's heap and the declared twin's.
function mkI2(): {[string]: i32} {
  const mi: {[string]: i32} = Map()
  return mi
}
type Circle2 = { r: {[string]: i32} }
type Dot2 = { r: {[string]: i32} }
type Sq2 = { s: i32 }
type Shape2 = Circle2 | Sq2
type Box2 = {[string]: Circle2}[]
const _sp2: Box2 = []
const lv2 = Map()
lv2["k0"] = { r: mkI2() }
const c2 = [lv2]
const dd2 = c2
const g2 = dd2
if g2.length > 0 { print(7) } else { print(0) }
