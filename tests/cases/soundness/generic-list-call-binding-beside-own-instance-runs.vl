// @run
// @log 1
// @log 12
// D14890: a binding holding a `T[]` generic's call, whose element is read where a wider record
// is wanted, is the list of the instance that read takes, beside an instance at the own type.
type Circle = { r: i32 | null }
function keep<T>(xs: T[]): T[] { xs }
function mkcall() { { r: null } }
const ks = [{ r: null }]
print(keep(ks).length)
const k = keep([mkcall()])
const c: Circle = k[0]
print(c.r ?? 12)
