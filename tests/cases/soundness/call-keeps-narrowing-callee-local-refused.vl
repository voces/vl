// @check
// @error-at 31:45 'g' is no longer narrowed to G: the call earlier in this statement may reassign it — read 'g' in a statement after the call, and re-test it there
// @error-at 31:54 'g' is no longer narrowed to G: the call earlier in this statement may reassign it — read 'g' in a statement after the call, and re-test it there
// @error-at 32:45 'g' is no longer narrowed to G: the call earlier in this statement may reassign it — read 'g' in a statement after the call, and re-test it there
// @error-at 32:54 'g' is no longer narrowed to G: the call earlier in this statement may reassign it — read 'g' in a statement after the call, and re-test it there
// @error-at 41:46 'g' is no longer narrowed to G: the call to 'k' earlier in this statement may reassign it — read 'g' in a statement after the call, and re-test it there
// D3019: resolving a callee's writes to their declarations must not hide a write that does
// reach the narrowed binding: a closure in the callee writing it, a write after the callee's
// same-named local has gone out of scope, and a closure writing a nested function's own local.
// Line and column are 0-based.
type G = { name: string, ty: i32 }
function find(k: i32): G | null {
  if k > 0 { { name: "g", ty: k } } else { null }
}

let g = find(2)
function viaClosure(v: i32) {
  const k = () => {
    g = null
  }
  k()
  v
}
function afterBlock(v: i32) {
  if v > 0 {
    let g = 1
    g = 2
  }
  g = null
  v
}
if g != null { print("\{g.name} \{viaClosure(g.ty)} \{g.name}") }
if g != null { print("\{g.name} \{afterBlock(g.ty)} \{g.name}") }

function nested() {
  const w = (): string => {
    let g = find(2)
    const k = (): i32 => {
      g = null
      0
    }
    if g != null { return "\{g.name} \{k()} \{g.name}" }
    "none"
  }
  w()
}
print(nested())
