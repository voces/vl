// @run
// @log 6
// @log 6
// @log 8
// @log 6
// @log 6
// @log 4
// A record literal an `if` or `match` arm yields, assigned into a binding held at a wider record
// by a built read or a built call, is built at that record, beside a call or read arm (D15280).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const wideJ: J = mk()
const c = wideJ.f == 4
const xs = [mk()]
let y = xs[0]
y = if c { { f: 6 } } else { { f: 7 } }
print(y.f)
let z = mk()
z = if c { { f: 6 } } else { mk() }
print(z.f)
let w = mk()
w = if !c { { f: 6 } } else if c { { f: 8 } } else { { f: 7 } }
print(w.f)
let m = mk()
m = match 1 {
  1 => { f: 6 }
  _ => { f: 7 }
}
print(m.f)
let v = xs[0]
v = if c { { f: 6 } } else { xs[0] }
print(v.f)
print(wideJ.f ?? 0)
