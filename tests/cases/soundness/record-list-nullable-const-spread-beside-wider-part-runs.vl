// A fresh list `const` of nullable records spread beside a wider record part is built at that
// record, its nulls kept (D16449): the list's reads, then the spread list's own index read, `??`
// read and binding, and the spread beside a nullable held part.
const s = [{ x: 1 }, null]
const v = [...s, { x: 2.5 }]
print((v[0] ?? { x: 0.0 }).x + 0.25)
print(v[1] == null)
print((s[0] ?? { x: 0.0 }).x + 0.25)
print((s[0] ?? { x: 0 }).x)
const e = s[0]
if e != null { print(e.x + 0.25) }
const a: { x: f64 } | null = { x: 2.5 }
const s2 = [{ x: 1 }, null]
const w = [a, ...s2]
print((w[1] ?? { x: 0.0 }).x + 0.25)
const s3 = [{ x: 1 }]
const u = [...s3, { x: 2.5 }]
print((s3.pop() ?? { x: 0.0 }).x + 0.25)
