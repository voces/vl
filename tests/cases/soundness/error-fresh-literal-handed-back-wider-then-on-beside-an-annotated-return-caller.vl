// @check
// @error-at 7:4 {y: i32, x: i32} is not V: they store field `x` differently (`i32` into `i32 | string`), and a record is shared, not copied, so only a fresh record widens. A write through the V would break the {y: i32, x: i32}. Build the source as `V`, or copy it with a literal `{ y: v.y, x: v.x }`
// A record an annotated function returns is shared, so handing it through the generic that
// delivers it wider still refuses beside the handed-back literal that now runs (D15373).
type V = { y: i32, x: i32 | string }
function k(v: V) { v.y }
function back<T>(v: T): T {
  k(v)
  v
}
function f(q: { y: i32, x: i32 }) { q.x }
print(back({ y: 2, x: 9 }).y)
print(f(back({ y: 2, x: 9 })))
function g(): { y: i32, x: i32 } { { y: 6, x: 7 } }
print(f(g()))
print(f(back(g())))
