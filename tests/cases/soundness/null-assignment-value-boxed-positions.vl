// @run
// @log true
// @log true
// @log true
// @log true
// @log true
// @log true
// @log true
// @log true
// @log true
// @hint redundant type annotation: `u` is inferred as `i32 | null`
// @hint redundant type annotation: `xs` is inferred as `(i32 | null)[]`
// An assignment of `null` used as a value delivered into `i32 | null` stores, then is that box's
// null: bound, passed, returned, an `if` arm, a list element, a field and at the top level.
function takeBox(u: i32 | null) { return u == null }
function bound() {
  let s: string | null = "a"
  const u: i32 | null = (s = null)
  print(u == null)
  print(s == null)
}
function passed() {
  let s: string | null = "b"
  print(takeBox(s = null))
  print(s == null)
}
function returned(): i32 | null {
  let s: string | null = "c"
  return (s = null)
}
function joined(c: boolean) {
  let s: string | null = "d"
  const u: i32 | null = if c { (s = null) } else { 4 }
  print(u == null)
}
function listed() {
  let s: string | null = "e"
  const xs: (i32 | null)[] = [(s = null), 5]
  print(xs[0] == null)
}
function fielded() {
  let s: string | null = "f"
  const h: { u: i32 | null } = { u: (s = null) }
  print(h.u == null)
}
bound()
passed()
print(returned() == null)
joined(true)
listed()
fielded()
let gs: string | null = "g"
const gu: i32 | null = (gs = null)
print(gu == null)
