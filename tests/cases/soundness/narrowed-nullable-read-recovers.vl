// @run
// @log 2
// @log same
// @log 2
// D2500, D4664, D3705: a read the checker narrowed to the non-null twin of its cell's nullable
// ref delivers that non-null ref, at an argument and as a `??` default read through a field.
function take(xs: u8[]) { print(xs.length) }
function mk(flag: boolean): u8[] | null {
  if flag { return [3, 4] }
  null
}
const v = mk(true)
if v != null { take(v) }

function same(a: u8[]) { a.length == 2 }
function one(a: u8[] | null) {
  if a != null {
    if same(a) { print("same") }
  }
}
const x: u8[] = [1, 2]
one(x)

type V = { x: f64, y: f64 }
type P = { o: V | null, a: V }
const p: P = { o: null, a: { x: 1.0, y: 2.0 } }
function f() { p.o ?? p.a }
print(f().y)
