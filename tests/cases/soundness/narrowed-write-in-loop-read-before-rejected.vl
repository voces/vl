// @check
// @error operator '+' is not defined for i32 | null and i32
// The refusing half of the re-execution barrier (D2609). The write in the loop ends the
// narrowing made outside it before the loop starts, so the read before the write, which runs
// again after it, is typed at the declared `i32 | null`: the arithmetic on it is the error.

function step(k: i32) {
  if k < 3 { return k + 1 }
  null
}

function loopWrite() {
  let q = step(0)
  if q != null {
    let i = 0
    while i < 2 {
      print(q + 1)
      q = null
      i = i + 1
    }
  }
}

loopWrite()
