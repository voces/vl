// @run
// @log 6
// @log 5
// @log 4
// @log 3
// @log -1
// @log 3
// @log 3
// @info `v` is never reassigned; use `const` instead of `let`
// D2407: a closure that does not escape — called by its handle in the body that makes it, or handed
// to `map` — keeps a captured path narrowing, and one that escapes may re-test the path itself. A
// `const` never changes and a `let` never assigned cannot either, so a returned closure keeps those.
type O = { v: string | null }

function local(o: O) {
  if o.v != null {
    const c = (): i32 => o.v.length
    return c() + c()
  }
  0
}

function callback(o: O, xs: i32[]) {
  if o.v != null { return xs.map((x: i32): i32 => x + o.v.length) }
  xs
}

function named(o: O) {
  if o.v != null {
    function h() { o.v.length }
    return h()
  }
  0
}

function retests(o: O): () => i32 {
  if o.v != null {
    return (): i32 => {
      if o.v != null { return o.v.length }
      -1
    }
  }
  (): i32 => 0
}

function constant(): () => f64 {
  const v: f64 | boolean = 1.5
  if v is f64 { return (): f64 => v * 2.0 }
  (): f64 => 0.0
}

function neverAssigned(): () => f64 {
  let v: f64 | boolean = 1.5
  if v is f64 { return (): f64 => v * 2.0 }
  (): f64 => 0.0
}

print(local({ v: "abc" }))
print(callback({ v: "abc" }, [1, 2])[1])
print(named({ v: "abcd" }))
const o: O = { v: "abc" }
const r = retests(o)
print(r())
o.v = null
print(r())
print(constant()())
print(neverAssigned()())
