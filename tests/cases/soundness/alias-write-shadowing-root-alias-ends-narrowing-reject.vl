// @check
// @error-at 15:11 operator '+' is not defined for i32 | null and i32 — 'p.f' is no longer narrowed to i32: the assignment to 'q.f' on line 13 may reassign it; re-test 'p.f' after the assignment
// The control for alias-write-shadowing-root-keeps-outer-narrowing: under an inner `p`, a write
// through `q`, an alias of the outer `p`, still ends the outer `p.f`'s narrowing (D3307).
type A = { f: i32 | null }
function go(p: A) {
  if p.f != null {
    {
      const q = p
      const p: A = { f: 1 }
      print(p.f)
      // q is the outer p
      q.f = null
    }
    print(p.f + 1)
  }
}
go({ f: 41 })
