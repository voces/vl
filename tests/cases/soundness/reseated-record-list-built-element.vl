// @run
// @log 7
// @log 3
// @log 1
// @log 4
// D2917: a list of literals adopts the `I[]` it is delivered to, and `mk` is called in it and in
// a second list. Both lists store `mk()`, so `mk` builds at `I` and the second list is an `I[]`
// too; a write through either reaches no `{ f: i32 }` read (DECISIONS.md "Record covariance").
const i: { f: i32 } = { f: 4 }
type I = { f: i64 | null }
function mk() { { f: 7 } }
const il = [mk(), { f: 3 }]
const ic: I[] = il
const jl = [mk()]
print(ic[0].f)
print(ic[1].f)
print(jl.length)
print(i.f)
