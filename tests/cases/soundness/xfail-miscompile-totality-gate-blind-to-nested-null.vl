// @check
// @error not all code paths return a value
// XFAIL — the checker's TOTALITY gate cannot see a `null` that sits one level down.
//
// `U` is `i32 | (string | null)` through an alias, so it DOES admit `null` and the else-less
// fall-through is a legal `null` result. The gate rejects it anyway, and its message tells the
// author to "annotate the return type `| null`" — advice that is already satisfied, one level in.
//
// SAME BLIND SPOT, DIFFERENT WALK from the one repaired alongside this file. `tyBearsNull`
// scanned only a union's DIRECT members for a `null` prim and so missed the nested case; it now
// mirrors `collectRetAtoms` and recurses. The gate here is a SEPARATE non-recursive reader of the
// same shape, on the checker side, and is deliberately left alone: repairing it changes which
// programs are ACCEPTED, which is a language-behaviour change and not part of a destringify
// slice. Filed so the pair is on record together — fixing the emitter half exposed this one.
//
// The flat spelling `i32 | string | null` is accepted, which is the control: the two spellings
// denote the same type and only one of them compiles.
type N = string | null
type U = i32 | N

function ga(c: boolean): U {
  if c { return 5 }
}

export function main() {
  const v = ga(true)
  if v is i32 { print(v) }
}
