// @run
// @log 1
// @log a
// D14382: a function returning an alias of its literal binding is built at the record its one
// call delivers it to, as one returning the binding is.
function rec() {
  const r = { x: 1, y: "a" }
  const s = r
  s
}
function take(p: { x: i64, y: string }): void {
  print(p.x)
  print(p.y)
}
take(rec())
