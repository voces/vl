// @run
// @log 1
// @log 2
// @log 16
// @log 12
// @log 10
// D14760: a fresh record literal handed to a generic whose body only reads it or hands it to an
// annotated parameter that stores a field differently is built at that record, as the hole
// spelling's is; a binding is too, and a body that hands the value back keeps it refused.
type V = { y: i32, x: i32 | string }
function poke(self: V) { self.y - 1 }
function k(v: V) { v.y }
function g<T>(v: T) { v.poke() }
function h<T>(v: T) { k(v) }
function twice<T>(v: T) { k(v) + k(v) }
function lam<T>(v: T) {
  const c = () => k(v)
  c()
}
function back<T>(v: T): T {
  k(v)
  v
}
print(g({ y: 2, x: 9 }))
print(h({ y: 2, x: 9 }))
print(twice({ y: 8, x: 9 }))
print(lam({ y: 12, x: 9 }))
const a = { y: 2, x: 9 }
const r = back(a)
print(r.x + 1)
