// @run
// @log 5
// @log 4
// @log 4
// @log 4
// A binding of an element of a list whose records are built at a wider record, or of a binding
// of one, is the list's held row even where another value interns the narrow row (D15126).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const wideJ: J = mk()
const xs = [mk()]
const plain = { f: 5 }
print(plain.f)
function take(v: { f: i32 }) { v.f }
const keep = [xs[0]]
const z = keep[0]
print(z.f)
const g = xs[0]
const y = g
print(take(y))
print(wideJ.f ?? 0)
