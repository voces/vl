// @emit-error is handed on here at its own element type
// @hint redundant type annotation: `i` is inferred as `{f: i32}`
// D2914: a list of object literals built at the record its declared destination names (D2881)
// is still typed with its own elements' record, so handing it or an element on at that type
// would deliver the destination's row where the other is expected. It is refused at the use.
const i: { f: i32 } = { f: 4 }
type I = { f: i64 | null }
const il = [{ f: 7 }]
const ic: I[] = il
const z = il.map((e) => e.f)
print(z[0])
print(ic[0].f)
print(i.f)
