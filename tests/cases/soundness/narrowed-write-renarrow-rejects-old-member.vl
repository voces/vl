// @check
// @error-at 10:34 member access '.length' on non-object i32
// @error-at 15:29 field 'length' is not on every member of i32 | string
// @error-at 23:10 'k', made on line 22, reads 'x' as string, a narrowing a write since then may have ended
// The refusing half of the 2026-09-26 ruling: a write re-narrows the place to what it stored,
// so a read the old narrowing allowed is refused after it — directly, after a loop that may
// write it, and through a closure made under the narrowing and called after the write.
function src(): i32 | string { return "s" }
function direct() {
  let x: i32 | string = src()
  if x is string { x = 5; print(x.length) }
}
function loopRead() {
  let x: i32 | string = src()
  if x is string {
    while x != "z" { print(x.length); x = 5 }
  }
}
function closure() {
  let x: i32 | string = src()
  if x is string {
    const k = () => x.length
    x = 5
    print(k())
  }
}
direct()
loopRead()
closure()
