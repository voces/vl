// @run
// @log 1
// @log 1
// @log 7
// @log 7
// @log 2
// @hint `B` is contained in `A`, so `is B` tests the value
// VERDICT PIN (must-run, D4084, D4133): a record narrowed by `is` B is delivered as a B by
// copying its fields, and an un-annotated copy of it binds at its declared type, so a write
// through the caller's A is seen through the copy. A cast from a union whose members store
// no field wider than B still picks the arm.
type A = { x: i32 }
type B = { x: 1 | 2 }
type C = { y: string }
const keep: B[] = []
function stash(a: A) {
  if a is B { keep.push({ x: a.x }) }
}
function alias(base: A) {
  const u: A | B = base
  if u is B {
    const c = u
    print(c.x)
    base.x = 7
    print(c.x)
  }
}
function plain(a: A) {
  if a is B {
    const c = a
    c.x = 7
    print(a.x)
  }
}
function pick(u: B | C) {
  const b = u as? B
  if b != null { print(b.x) }
}
const a: A = { x: 1 }
stash(a)
a.x = 7
print(keep[0].x)
alias({ x: 1 })
plain({ x: 1 })
pick({ x: 2 })
