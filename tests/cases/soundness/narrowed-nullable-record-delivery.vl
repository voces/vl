// @run
// @hint redundant type annotation: `g` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `c` is inferred as `Circle | null` — remove it to lean on inference
// @log 4
// @log -1
// @log 4
// @log -1
// @log 4
// @log -1
// @log 4
// @log -1
// D3097: a value narrowed out of a union box to `X | null` is unboxed into a nullable record
// destination: a direct call, a binding, a return and a function value's argument.
type Circle = { r: i32 }
function g(w: Circle | null): i32 {
  if w == null { return 0 - 1 }
  return w.r
}
const zz: (Circle | null | string)[] = [{ r: 4 }, null, "x"]
for e in zz {
  if !(e is string) { print(g(e)) }
}
for e in zz {
  if !(e is string) {
    const c: Circle | null = e
    print(g(c))
  }
}
function pick(e: Circle | null | string): Circle | null {
  if e is string { return null }
  return e
}
for e in zz {
  if !(e is string) { print(g(pick(e))) }
}
const f = (w: Circle | null): i32 => if w == null { 0 - 1 } else { w.r }
for e in zz {
  if !(e is string) { print(f(e)) }
}
