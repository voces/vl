// @check
// @error 'v' is no longer narrowed to K[]: the call to 'f' on line 13 may reassign it
// VERDICT PIN (must-error, D4926): over a declared union of lists the element narrowing
// `v is K[]` is retired by a write through any member, whichever member is spelled first.
// `v` holds the `i32[]` `src`, so the closure's store reaches it.
type K = 0 | 1
const src = [0, 1]
const v: K[] | i32[] = src
const f = () => {
  src[0] = 5
}
if (v is K[]) {
  f()
  const e: K = v[0]
  print(e)
}
