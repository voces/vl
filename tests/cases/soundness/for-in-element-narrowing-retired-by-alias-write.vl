// @check
// @error cannot assign i32 to 'e' of type K
// VERDICT PIN (must-error, D4926): an element store through an alias inside the loop
// retires `v is K[]` for the loop variable of `for x in v`, so `x` is an `i32`. This
// program checked clean and printed 0 then 5.
type K = 0 | 1
const v: i32[] = [0, 1]
const alias = v
if (v is K[]) {
  for x in v {
    alias[1] = 5
    const e: K = x
    print(e)
  }
}
