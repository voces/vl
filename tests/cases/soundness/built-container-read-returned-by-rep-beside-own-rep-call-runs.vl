// @run
// @log 9
// @log 9
// @log 4
// A hole identity called with a read out of a built container and with a record at its own
// storage is instanced at each, and each result is read where its argument is (D14819).
type J = { f: i32 | null }
function mk() { { f: 4 } }
function back(r) { return r }
const wideJ: J = mk()
const xs = [mk()]
function take(v: { f: i32 }) { v.f }
const plain = { f: 5 }
print(take(back(xs[0])) + take(back(plain)))
const b = back(xs[0])
print(b.f + back(plain).f)
print(wideJ.f ?? 0)
