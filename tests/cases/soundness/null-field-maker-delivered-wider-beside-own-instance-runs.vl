// @run
// @log 1
// @log 12
// @log null
// @log null
// @hint Intentionally-unused parameter `_x`
// D14890: a maker of a `null`-field record, delivered at a record storing the field wider and
// handed in a list to a generic whose other instance is at the own type, is built at its own row
// and copied where it lands wider; a `null` field read off a wider build is `null`.
type Circle = { r: i32 | null }
function sink(_x: Circle) { }
function mkcall() { { r: null } }
sink(mkcall())
function keep<T>(xs: T[]): T[] { xs }
const ks = [{ r: null }]
print(keep(ks).length)
const k = keep([mkcall()])
print(k[0].r ?? 12)
const o = mkcall()
const get = () => o.r
print(get())
function g() {
  if ks.length > 5 { return { r: null } }
  return mkcall()
}
print(g().r)
