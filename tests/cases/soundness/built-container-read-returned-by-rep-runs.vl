// @run
// @log 4
// @log 4
// @log 4
// @log 4
// @log 4
// @log 9
// @log 4
// D14754: a by-rep parameter returned to a call whose result is read for a field, handed on to
// another by-rep parameter, or written through, runs at the container's build.
type J = { f: i32 | null }
function mk() { { f: 4 } }
function back(r) { return r }
function tail(r) { r }
function gen<T>(r: T): T { r }
function rd(q) { q.f }
const wideJ: J = mk()
const xs = [mk()]
print(back(xs[0]).f)
print(tail(xs[0]).f)
print(gen(xs[0]).f)
print(rd(back(xs[0])))
print(back(gen(xs[0])).f)
tail(xs[0]).f = 9
print(xs[0].f)
print(wideJ.f ?? 0)
