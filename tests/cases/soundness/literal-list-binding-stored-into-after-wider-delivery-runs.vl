// @run
// @log 2
// @log 6
// @log 9
// @log 2
// A list literal binding delivered as a list of a wider record adopts it, and its later stores,
// a push, an index write or a write through an element, are judged at that list (D3340).
type J = { f: i32 | null }
const il = [{ f: 4 }]
const ic: J[] = il
il.push({ f: 5 })
print(ic.length)
const jl = [{ f: 4 }]
const jc: J[] = jl
jl[0] = { f: 6 }
print(jc[0].f ?? 0)
type K = { f: i64 }
const kl = [{ f: 4 }]
const kc: K[] = kl
kl[0].f = 9
print(kc[0].f)
let ll = [{ f: 4 }]
const lc: J[] = ll
ll.push({ f: 5 })
print(lc.length)
