// @run
// @log 4
// @log 4
// @log 7
// @log 1
// @log 1
// @log 1
// @log 1
// A field read through a union of records whose members store a record field differently is
// typed at the union of the members' own records, so it reads at depth two and three, a write
// that fits every member runs, and a `??` default typed at a read's wider record joins (D15314).
type H = { f: i32 | null }
type K = { h: { f: i32 } }
type J = { h: H }
const k: K = { h: { f: 4 } }
const u: K | J = k
print(u.h.f ?? 0)
type K3 = { g: { h: { f: i32 } } }
type J3 = { g: { h: H } }
const k3: K3 = { g: { h: { f: 4 } } }
const u3: K3 | J3 = k3
print(u3.g.h.f ?? 0)
u.h.f = 7
print(u.h.f ?? 0)
const a: K | null = null
const dj: J = { h: { f: 1 } }
print((a ?? dj).h.f ?? 0)
function mkv() { { h: { f: 4 } } }
const m = Map()
m.set("a", mkv())
const wm: {[string]: J} = Map()
wm.set("a", mkv())
const da: J = { h: { f: 1 } }
const b1 = m.get("z") ?? da
print(b1.h.f ?? 0)
let dl = { h: { f: 2 } }
dl = { h: { f: 1 } }
const b2 = m.get("z") ?? dl
print(b2.h.f ?? 0)
function mkd() { { h: { f: 1 } } }
const dc = mkd()
const b3 = m.get("z") ?? dc
print(b3.h.f ?? 0)
