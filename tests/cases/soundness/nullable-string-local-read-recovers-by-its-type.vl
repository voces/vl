// @run
// @log null
// @log s
// @log ne
// @log eq
// @log ne
// @log -1
// @log 2
// A `string | null` local read recovers the non-null ref exactly when its own type at the
// instance excludes null: a hole parameter at a nullable pin stays nullable (D3202), a union
// `==` recovers its operand after its own null test, and an assignment's re-read is the value stored.
function f(x) {
  const l = [x]
  l[0] = x
  print(l[0])
}
const v0: string | null = null
f(v0)
const v1: string | null = "s"
f(v1)
function eqBox(a: string | null, b: string | null, c: boolean) {
  const r = if c { a ?? 5 } else { b }
  if r == b { print("eq") } else { print("ne") }
}
eqBox("n", null, true)
eqBox("n", null, false)
eqBox(null, "n", true)
function asg(n: i32): string | null {
  if n == 0 { return null }
  "ab"
}
function reread(n: i32) {
  let s = asg(7)
  if s != null && (s = asg(n)) != null { print(s.length) } else { print(-1) }
}
reread(0)
reread(2)
