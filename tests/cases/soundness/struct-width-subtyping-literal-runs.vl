// @run
// @log tick
// @log 3
// @log 7
// @log hello
// A literal argument with more fields than its inline record parameter is passed at its own record,
// as it is to a named record parameter: the parameter takes the row slot, and every initializer,
// the extra ones included, runs (D16290).
function tick() {
  print("tick")
  5
}
function xOf(p: { x: i32 }) { p.x }
function sumXY(p: { x: i32, y: i32 }) { p.x + p.y }
function greet(p: { name: string }) { p.name }

print(xOf({ x: 3, y: 4, z: tick() }))
print(sumXY({ x: 3, y: 4, z: 5 }))
print(greet({ name: "hello", id: 42 }))
