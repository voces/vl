// @run
// @log 5
// @log 4
// @log 3
// @log 6
// D8203: a record literal through a generic identity into a union member, when an earlier call
// gave the literal's shape a row of its own, is delivered at the instance's row, in a binding,
// an identity with a block return, and an argument.
type J = { r: i32 | null }
function idn<T>(v: T): T { v }
function idt<T>(v: T): T { return v }
const w = idn({ r: 5 })
print(w.r)
const u: J | string = idn({ r: 4 })
if u is J { print(u.r ?? 0) }
const x: J | string = idt({ r: 3 })
if x is J { print(x.r ?? 0) }
function take(p: J | string) {
  if p is J { print(p.r ?? 0) }
}
take(idn({ r: 6 }))
