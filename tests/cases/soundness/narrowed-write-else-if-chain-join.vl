// @run
// @log true
// @log false
// @log true
// @log 2
// @log i32
// @hint redundant type annotation: `x` is inferred as `i32 | string | null`
// @hint redundant type annotation: `k` is inferred as `i32`
// @hint redundant type annotation: `y` is inferred as `i32 | string | null`
// D2627. An `else if` chain with no final `else` may run no arm, so the place keeps its entry
// member on that path and the join after the chain includes it: `i32` and two `string` writes
// join to `i32 | string`, not `string`. With a final `else` every path writes, and the join is
// the written member, which the emitter reads unboxed.
function k(n: i32): i32 { return n }
function src(): i32 | string | null { return 5 }
function srcU(): i32 | string { return 5 }
function noElse2() {
  let x: i32 | string | null = src()
  if x is i32 {
    if k(2) == 0 { x = "s" }
    else if k(2) == 1 { x = "t" }
    const y: i32 | string | null = x
    print(y is i32)
    print(x == null)
  }
}
function noElse3() {
  let x = srcU()
  if x is i32 {
    if k(2) == 0 { x = "s" }
    else if k(2) == 1 { x = "t" }
    else if k(2) == 3 { x = "u" }
    print(x is i32)
  }
}
function withElse() {
  let x = srcU()
  if x is i32 {
    if k(2) == 0 { x = "s" }
    else if k(2) == 1 { x = "t" }
    else { x = "uu" }
    print(x.length)
  }
}
function field() {
  const w = { f: srcU() }
  if w.f is i32 {
    if k(2) == 0 { w.f = "s" }
    else if k(2) == 1 { w.f = "t" }
    if w.f is i32 { print("i32") } else { print("str") }
  }
}
noElse2()
noElse3()
withElse()
field()
