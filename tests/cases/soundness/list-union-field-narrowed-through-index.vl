// @run
// @log 2
// @log 3
// @log 1.5
// @log 0
// @log 2
// @log 7
// D8261: a list-union field narrowed by `is string[]` through an index (`xs[0].items`) is
// read at the list, in an annotated and an un-annotated list, at the `f64[]` arm, in the else
// branch, and under a field of a record. A write to the element between the test and the read
// is not narrowed past.
type A = { kind: "a", items: f64[] | string[] }
const s: A = { kind: "a", items: ["x", "y"] }
const xs: A[] = [s]
if xs[0].items is string[] { print(xs[0].items.length) }
const t: A = { kind: "a", items: ["p", "q", "r"] }
const ys = [t]
if ys[0].items is string[] { print(ys[0].items.length) }
const f: A = { kind: "a", items: [1.5, 2.5] }
const fs: A[] = [f]
if fs[0].items is f64[] { print(fs[0].items[0]) }
if fs[0].items is string[] { print(fs[0].items.length) } else { print(0) }
const w = { e: [s] }
if w.e[0].items is string[] { print(w.e[0].items.length) }
const zs: A[] = [s]
if zs[0].items is string[] {
  zs[0] = f
  if zs[0].items is f64[] { print(7) } else { print(8) }
}
