// @run
// @log 15
// @log 15
// @log 15
// @log 3
// @log 15
// @log 15
// @log 7
// A fresh call whose literal is beside a declared record of its fields, delivered into a union
// whose record member stores a field more widely, is built at the member and boxed under its tag:
// a binding, an argument, a return (D8141), and a record literal's field or a field write, where
// the literal keeps the field's box (D15828, D15870).
type Col = { r: i32, g: i32 }
type J = { r: i32 | null, g: i32 }
function mkU() { { r: 15, g: 1 } }
const u: J | string = mkU()
if u is J { print(u.r ?? 0) }
function take(x: J | string) {
  if x is J { print(x.r ?? 0) }
}
take(mkU())
function back(): J | string { mkU() }
const b = back()
if b is J { print(b.r ?? 0) }
const c: Col = { r: 1, g: 2 }
print(c.r + c.g)
type W = { f: J | string }
const w: W = { f: mkU() }
const wv = w.f
if wv is J { print(wv.r ?? 0) }
const w2: W = { f: "s" }
w2.f = mkU()
const wv2 = w2.f
if wv2 is J { print(wv2.r ?? 0) }
type K = { r: i32 | null }
function mkK() { { r: 7 } }
type V = { f: K | string }
const vk: V = { f: mkK() }
const kv = vk.f
if kv is K { print(kv.r ?? 0) }
