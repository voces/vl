// @run
// @log 15
// @log 15
// @log 15
// @log 3
// A fresh call whose literal is beside a declared record of its fields, delivered into a union
// whose record member stores a field more widely, is built at the member and boxed under its tag:
// a binding, an argument and a return (D8141).
type Col = { r: i32, g: i32 }
type J = { r: i32 | null, g: i32 }
function mkU() { { r: 15, g: 1 } }
const u: J | string = mkU()
if u is J { print(u.r ?? 0) }
function take(x: J | string) {
  if x is J { print(x.r ?? 0) }
}
take(mkU())
function back(): J | string { mkU() }
const b = back()
if b is J { print(b.r ?? 0) }
const c: Col = { r: 1, g: 2 }
print(c.r + c.g)
