// @run
// @info `g` is never reassigned; use `const` instead of `let`
// @log g 3 g
// @log g 3 g
// @log g 3 g
// @log g 3 g
// @log g 3 g
// @log g 3
// @log g 3 g
// @log g 3 g
// D3019 (plumb PL-063): a call ends a narrowing only when it may write THAT binding. A write
// inside a callee resolves to the declaration it names, so a callee's own local, parameter or
// closure-captured local of the same name leaves the caller's narrowing standing. Each shape
// below keeps RUNNING; the refusals a real writer still earns are the `-refused` fixture.
type G = { name: string, ty: i32 }
function find(k: i32): G | null {
  if k > 0 { { name: "g", ty: k } } else { null }
}

function local(v: i32) {
  let g = v
  g += 1
  "\{g}"
}
function param(g: i32) {
  g = g + 1
  "\{g}"
}
function captured(v: i32) {
  let g = v
  const k = () => {
    g = g + 1
  }
  k()
  g
}
const lambda = (v: i32): i32 => {
  let g = v
  g = g + 1
  g
}

// The filed witness: a `const` in a module-level block, the callee writing its own local.
if true {
  const g = find(2)
  if g == null {
    print("none")
  } else {
    print("\{g.name} \{local(g.ty)} \{g.name}")
  }
}
// A `let` in the same place, and each other way a callee can own a `g`.
if true {
  let g = find(2)
  if g != null { print("\{g.name} \{param(g.ty)} \{g.name}") }
  g = null
}
if true {
  let g = find(2)
  if g != null { print("\{g.name} \{captured(g.ty)} \{g.name}") }
  g = null
}
if true {
  let g = find(2)
  if g != null { print("\{g.name} \{lambda(g.ty)} \{g.name}") }
  g = null
}
// A module binding, read directly and through a closure.
let g = find(2)
if g != null { print("\{g.name} \{local(g.ty)} \{g.name}") }
if g != null {
  const r = () => g.name
  print("\{r()} \{local(g.ty)}")
}
// A function's own local.
function inFunction() {
  let g = find(2)
  if g != null { return "\{g.name} \{local(g.ty)} \{g.name}" }
  g = null
  "none"
}
print(inFunction())
// A nested function's own local.
function nested() {
  let g = find(2)
  const w = (v: i32): i32 => {
    let g = v
    g = g + 1
    g
  }
  if g != null { return "\{g.name} \{w(g.ty)} \{g.name}" }
  g = null
  "none"
}
print(nested())
