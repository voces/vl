// @run
// @log 5
// @log null
// @log true
// @log s
// @log none
// @log t
// @log 5
// @log true
// @log 6
// @log 5
// @log true
// @log 7
// @log true
// @log 6
// @log true
// @log 1
// @log true
// @log 2
// @log null
// @log 3
// @log a
// @warning `h` shadows the `h` declared at
// D3020: a declaration in a block shadows a narrowed name, and a call there writes the outer
// binding. The narrowing ends when the block does, so a read after it sees the declared type.
type G = { name: string }
function mk(): G | null { { name: "a" } }
type H = { g: i32 }
const hv: H | null = { g: 5 }

let g = mk()
function k() { g = null }
function one() { hv != null }

if g != null {
  if true { const g = 5; k(); print(g) }
  print(g?.name)
  print(g == null)
}

g = mk()
if g != null {
  {
    const g = "s"
    k()
    print(g)
  }
  if g != null { print(g.name) } else { print("none") }
}

g = mk()
if g != null {
  if true {
    const g = 5
    if true { const g = "t"; k(); print(g) }
    print(g)
  }
  print(g == null)
}

g = mk()
if g != null {
  const y = (if one() { const g = 5; k(); g } else { 0 })
    + (if g == null { 1 } else { 0 })
  print(y)
}

g = mk()
if g != null {
  match hv {
    H{g} => {
      k(); print(g)
    }
    null => {}
  }
  print(g == null)
}

g = mk()
if g != null {
  if true {
    const g = 5
    let n = 0
    while n < 2 { n = n + 1; k() }
    print(g + n)
  }
  print(g == null)
}

// A join inside the shadow is about the shadowing binding, which the call does not write.
g = mk()
if g != null {
  if true {
    const g = 5
    if g > 1 { k() }
    print(g + 1)
  }
  print(g == null)
}

function local() {
  let h = mk()
  const w = () => {
    h = null
  }
  function v() { h = null }
  if h != null {
    if true { const h = 1; w(); print(h) }
    print(h == null)
  }
  h = mk()
  if h != null {
    if true { const h = 2; v(); print(h) }
    print(h?.name)
  }
  // A callee that writes nothing leaves the narrowing standing.
  h = mk()
  if h != null {
    if true { const h = 3; print(h) }
    print(h.name)
  }
}
local()
