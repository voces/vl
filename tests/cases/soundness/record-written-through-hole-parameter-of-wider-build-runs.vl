// @run
// @log 5
// @log 4
// @log 5
// A call the record solve builds at a wider record, handed to an un-annotated parameter that a
// record is written through, is copied to its own record there, and the instance is keyed at that
// record; the binding of the wider build keeps it (D15266).
type J = { f: i32 | null }
type K = { j: J }
function mk() { { j: { f: 4 } } }
const _k: K = mk()
function __take(a) {
  const v = a
  v.j = { f: 5 }
  print(v.j.f)
}
__take(mk())
print(_k.j.f ?? 0)
const k: K = { j: { f: 4 } }
__take(k)
