// @log 7
// @hint redundant type annotation: `d3` is inferred as `{r: i32}` — remove it to lean on inference
// @hint redundant type annotation: `c3` is inferred as `Dot3` — remove it to lean on inference
// @hint redundant type annotation: `d4` is inferred as `{r: i32}` — remove it to lean on inference
// THE THREE HINTS ABOVE ARE DECLARED, NOT DELETED, and every one of the three annotations is
// the whole of what its program tests. `d3: Dot3` / `d4: Dot4` are what make the value commit
// to the STRUCT table's row, and `c3: Circle3` is what makes the destination commit to the
// VARIANT table's — the two claimants whose heaps this change merges. Delete any of them and
// the program stops crossing the seam and runs for a reason that has nothing to do with the
// fix. The second hint is also the finding stated by the checker itself: `c3` is inferred as
// `Dot3` where it is annotated `Circle3`, which is the acceptance `DECISIONS.md` derives
// "they MUST share one heap type" from.
// GRADUATED from `@no-instantiate` (silent-class-inventory D280 / D156 / D158 / D171,
// 2026-08-28). Program 1 below was the check-clean-invalid-wasm SPECIMEN —
// `tests/vl_check_codegen_test.ts`'s `INVALID_MODULE_SRC`, filed as D158 — verbatim. It
// printed `type mismatch: expected (ref null $type), found (ref $type)` out of a `vl check`
// that exited 0 with no diagnostics at all. It runs.
//
// WHAT CLOSED IT IS ONE HEAP TYPE, NOT A PIN. `DECISIONS.md` states the rule the struct
// slot layer was built on: `type A = {v:i32}` and `type B = {v:i32}` "are THE SAME type (the
// checker accepts a `B` wherever an `A` is expected), so they MUST share one heap type", and
// minting two was "an active soundness bug". The checker applies that same acceptance across
// the variant⇄struct seam — a `Dot = {r:i32}` IS accepted where the union ARM
// `Circle = {r:i32}` is expected — and the two tables never merged, so that seam kept the bug
// the struct, ref-list, map-value and variant layers each closed. `uVarSTwin` is the merge (D280).
//
// PROGRAM 3 IS THE ROOT IN ITS MINIMAL FORM — seven lines, no map, no list, no pin, no
// generic — and it was a silent miscompile on `28425535` and every generation before it.
// Nothing in the D156 family's twelve filed candidates names it, because every one of them
// was looking at a carrier and this is a table.
//
// PROGRAM 4 IS THE BOX THAT A MERGED HEAP STILL NEEDS. `emitUnionCoerce` asked one test —
// `sHeapIdx[rbSsi] != uVarHeap[rbVi]` — and read the answer as two different questions:
// "must the payload be REBUILT onto another heap type" and "is this value already
// box-shaped". They coincided only because the two tables never cross-deduped, so the equal
// branch was unreachable; the merge makes it reachable and raw-passing a bare `(ref $arm)`
// into a `(ref null $uBox)` cell is invalid wasm. It is here because it is the one
// regression the merge introduced and the one no POPULATION could have found: it moves 0 cells
// on the D88 / D112 / D156 / D139 grids (5,188), 0 classes on the distilled census corpus
// (250,310 cells) and 0 on census block B (28,590) — none of them boxes a plain declared
// struct into a union. Filed as D281.

type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Dot = { r: i32 }
function mk(n: i32) {
  const l1 = Map()
  l1["k1"] = { r: n }
  const c = Map()
  c["k2"] = l1
  return c
}
const d1: {[string]: Circle} = Map()
print(((((mk(7))["k2"] ?? d1))["k1"] ?? { r: 0 }).r)

// PROGRAM 2 — D156's and D171's own filed witness, verbatim: a nested arm-valued map
// delivered to an annotated parameter, with the layout twin declared. The CONTESTED half of
// #1966's peel, which shipped gated on `armLayoutContested` precisely because the arm and
// the twin were two heaps.
type Circle2 = { r: i32 }
type Sq2 = { s: i32 }
type Shape2 = Circle2 | Sq2
type Dot2 = { r: i32 }
function thru(x: {[string]: {[string]: Circle2}}) { return x }
function mk2() {
  const i0 = Map()
  i0["k"] = { r: 7 }
  const c = Map()
  c["o"] = i0
  thru(c)
}
mk2()
print(7)

// PROGRAM 3 — THE ROOT, minimal. No container at all: a declared struct assigned into a
// union-arm-annotated binding, and back.
type Circle3 = { r: i32 }
type Sq3 = { s: i32 }
type Shape3 = Circle3 | Sq3
type Dot3 = { r: i32 }
const d3: Dot3 = { r: 7 }
const c3: Circle3 = d3
print(c3.r)

// PROGRAM 4 — the box a merged heap still needs: a plain declared struct flowing into a
// UNION-typed module global, whose cell is always the `{tag, payload}` box.
type Circle4 = { r: i32 }
type Sq4 = { s: i32 }
type Shape4 = Circle4 | Sq4
type Dot4 = { r: i32 }
const d4: Dot4 = { r: 7 }
const s4: Shape4 = d4
if s4 is Circle4 { print(7) } else { print(0) }
