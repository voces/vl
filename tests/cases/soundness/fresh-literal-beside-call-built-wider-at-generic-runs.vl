// @run
// @log 1
// @log 2
// @log 4
// @log 9
// @hint Intentionally-unused parameter `_x`
// @hint Intentionally-unused parameter `_a`
// @hint Intentionally-unused parameter `_b`
// D14816: a fresh record literal handed to a generic beside a call built at a wider record is
// built at that record, where the instance the call's rep pins is built.
type Circle = { r: i32 | null }
function sink(_x: Circle) {}
function mkcall() { { r: null } }
sink(mkcall())
function both<T>(_a: T, _b: T) { 1 }
function second<T>(_a: T, b: T): T { b }
function first<T>(a: T, _b: T): T { a }
function three<T>(_a: T, _b: T, c: T): T { c }
print(both(mkcall(), { r: null }))
print(second(mkcall(), { r: null }).r ?? 2)
const y = first(mkcall(), { r: null })
print(y.r ?? 4)
print(three(mkcall(), { r: null }, { r: null }).r ?? 9)
