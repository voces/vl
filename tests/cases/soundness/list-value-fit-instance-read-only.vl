// An instance's list that passes `is f64[]` only as an empty list does may still be read in the
// arm, and a delivery stays legal at an instance whose list is the tested type (D4981, D5003).
function pushOne(xs: f64[]) { xs.push(1.5) }
function g<V>(v: V) {
  if v is f64[] { print(v.length) }
  print(1)
}
function t<V>(a: V[]) {
  if a is f64[] { print(a.length) }
  print(a.length)
}
function h<V>(v: V) {
  if v is f64[] { pushOne(v) }
}
const e: i32[] = []
g(e)
t(e)
const f: f64[] = []
h(f)
print(f.length)
const k: f64[] = [2.5]
t(k)
