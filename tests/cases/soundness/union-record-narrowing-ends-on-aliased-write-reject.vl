// @check
// @error cannot assign i32 to 'y' of type 1 | 2 — 'a' is no longer narrowed to B: the assignment to 'base.x' on line 25 may reassign it; re-test 'a' after the assignment
// @error cannot assign i32 to 'y' of type 1 | 2 — 'a' is no longer narrowed to B: the call to 'k' on line 37 may reassign it; re-test 'a' after the call
// @error cannot assign i32 to 'y' of type 1 | 2 — 'a' is no longer narrowed to B: the assignment to 'al.x' on line 45 may reassign it; re-test 'a' after the assignment
// @error cannot assign i32 to 'y' of type 1 | 2 — 'a' is no longer narrowed to B: the call to 'setX' on line 54 may reassign it; re-test 'a' after the call
// @error cannot assign i32 to 'y' of type 1 | 2 — 'a' is no longer narrowed to B: the assignment to 'base.x' on line 66 in the loop around this read may reassign it; re-test 'a' after the assignment
// @hint `B` is contained in `A`, so `is B` tests the value
// @hint `B` is contained in `A`, so `is B` tests the value
// @hint `B` is contained in `A`, so `is B` tests the value
// @hint `B` is contained in `A`, so `is B` tests the value
// @hint `B` is contained in `A`, so `is B` tests the value
// A union binding narrowed to a record by the value of its fields is a fact about heap state: a
// write that may reach the object through another place ends it, exactly as it ends the path
// narrowing of the field (`path-narrowing-ends-on-aliased-write-reject.vl`), whichever way the
// write reaches the object: an alias, a closure, a second parameter, a method, a loop.

type A = { x: i32 }
type B = { x: 1 | 2 }

function setX(self: A, v: i32) { self.x = v }

export function viaAlias(base: A) {
  const a: A | B = base
  if a is B {
    base.x = 7
    const y: 1 | 2 = a.x
    print(y)
  }
}

export function viaClosure(base: A) {
  const a: A | B = base
  const k = () => {
    base.x = 7
  }
  if a is B {
    k()
    const y: 1 | 2 = a.x
    print(y)
  }
}

export function viaParam(a: A | B, al: A) {
  if a is B {
    al.x = 7
    const y: 1 | 2 = a.x
    print(y)
  }
}

export function viaMethod(base: A) {
  const a: A | B = base
  if a is B {
    base.setX(7)
    const y: 1 | 2 = a.x
    print(y)
  }
}

export function inLoop(base: A) {
  const a: A | B = base
  if a is B {
    for i in [0, 1] {
      const y: 1 | 2 = a.x
      print(y)
      base.x = 7
    }
  }
}
