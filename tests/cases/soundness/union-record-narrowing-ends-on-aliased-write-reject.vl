// @hint `B` is contained in `A`, so `is B` tests the value
// @hint `B` is contained in `A`, so `is B` tests the value
// A union binding narrowed to a record by the value of its fields is a fact about heap state: a
// write that may reach the object through another place ends it, exactly as it ends the path
// narrowing of the field (`path-narrowing-ends-on-aliased-write-reject.vl`), whichever way the
// write reaches the object (an alias, a closure, a second parameter, a method, a loop) and
// wherever the narrowing came from (an arm, a guard that exits, a join, an operand, a generic).

type A = { x: i32 }
type B = { x: 1 | 2 }

function setX(self: A, v: i32) { self.x = v }

export function viaAlias(base: A) {
  const a: A | B = base
  if a is B {
    base.x = 7
    const y: 1 | 2 = a.x
    print(y)
  }
}

export function viaClosure(base: A) {
  const a: A | B = base
  const k = () => {
    base.x = 7
  }
  if a is B {
    k()
    const y: 1 | 2 = a.x
    print(y)
  }
}

export function viaParam(a: A | B, al: A) {
  if a is B {
    al.x = 7
    const y: 1 | 2 = a.x
    print(y)
  }
}

export function viaMethod(base: A) {
  const a: A | B = base
  if a is B {
    base.setX(7)
    const y: 1 | 2 = a.x
    print(y)
  }
}

export function inLoop(base: A) {
  const a: A | B = base
  if a is B {
    for i in [0, 1] {
      const y: 1 | 2 = a.x
      print(y)
      base.x = 7
    }
  }
}

export function afterGuard(base: A) {
  const a: A | B = base
  if !(a is B) { return 0 }
  base.x = 7
  const y: 1 | 2 = a.x
  print(y)
  0
}

export function afterGuardClosure(base: A) {
  const a: A | B = base
  if !(a is B) { return 0 }
  const k = () => {
    base.x = 7
  }
  k()
  const y: 1 | 2 = a.x
  print(y)
  0
}

export function afterGuardCall(base: A) {
  const a: A | B = base
  if !(a is B) { return 0 }
  setX(base, 7)
  const y: 1 | 2 = a.x
  print(y)
  0
}

export function afterGuardLoop(base: A) {
  const a: A | B = base
  if !(a is B) { return 0 }
  for i in [0, 1] {
    const y: 1 | 2 = a.x
    print(y)
    base.x = 7
  }
  0
}

export function afterElseIfGuard(base: A, q: boolean) {
  const a: A | B = base
  if q { return 0 }
  else if !(a is B) { return 0 }
  base.x = 7
  const y: 1 | 2 = a.x
  print(y)
  0
}

export function afterNullableGuard(base: A) {
  const a: A | B | null = base
  if !(a is B) { return 0 }
  base.x = 7
  const y: 1 | 2 = a.x
  print(y)
  0
}

export function afterJoin(base: A, b2: B) {
  let a: A | B = base
  if !(a is B) { a = b2 }
  base.x = 7
  const y: 1 | 2 = a.x
  print(y)
}

export function inIfExpression(base: A) {
  const a: A | B = base
  const r = if a is B {
    base.x = 7
    const y: 1 | 2 = a.x
    y
  } else {
    0
  }
  print(r)
}

function poke(b: A): boolean {
  b.x = 7
  true
}

function takes(v: 1 | 2): boolean { v == 1 }

export function inOrOperand(base: A): boolean {
  const a: A | B = base
  !(a is B) || poke(base) && takes(a.x)
}

function inGeneric<T>(base: A, t: T) {
  const a: A | B = base
  if a is B {
    base.x = 7
    const y: 1 | 2 = a.x
    print(y)
  }
  print(t)
}

export function callsGeneric(base: A) { inGeneric(base, 1) }
