// @check
// @error-at 17:11 operator '*' is not defined for boolean | f64 and f64 — 'v' is no longer narrowed to f64: the call to 'k' on line 17 may reassign it; re-test 'v' after the call
// @error-at 34:11 operator '*' is not defined for boolean | f64 and f64 — 'v' is no longer narrowed to f64: the call to 'map' on line 34 may reassign it; re-test 'v' after the call
// @error-at 50:11 operator '*' is not defined for boolean | f64 and f64 — 'v' is no longer narrowed to f64: the call to 'run' on line 50 may reassign it; re-test 'v' after the call
// @error-at 62:29 'v' is no longer narrowed to f64: the call to 'k' earlier in this statement may reassign it — read 'v' in a statement after the call, and re-test it there
// @error-at 74:2 operator '*' is not defined for boolean | f64 and f64 — 'v' is no longer narrowed to f64: the call to 'k' on line 74 may reassign it; re-test 'v' after the call
// D2390: a call that may run a closure assigning a narrowed binding ends the narrowing, and a
// use at the narrowed type after it names the call. Line and column are 0-based.

// A direct call to the writer.
function direct(): f64 {
  let v: boolean | f64 = 1.5
  const k = () => {
    v = true
  }
  if v is f64 {
    k()
    return v * 2.0
  }
  0.0
}

// A lambda argument that calls the writer: the writer has escaped into `map`.
function lambdaArg(): f64 {
  let v: boolean | f64 = 1.5
  const k = () => {
    v = true
  }
  const xs = [1, 2]
  if v is f64 {
    const ys = xs.map((x) => {
      k()
      x
    })
    return v * 2.0 + ys.length as f64
  }
  0.0
}

// A writer stored in a record has escaped, so a call it is never named in may run it.
type Box = { cb: () => void }
function run(b: Box) { b.cb() }
function escaped(): f64 {
  let v: boolean | f64 = 1.5
  const k = (): void => {
    v = true
  }
  const b: Box = { cb: k }
  if v is f64 {
    run(b)
    return v * 2.0
  }
  0.0
}

// A read later in the call's own statement.
function sameStatement(): f64 {
  let v: boolean | f64 = 1.5
  const k = () => {
    v = true
    1.0
  }
  if v is f64 { return k() + v }
  0.0
}

// A call inside the condition: the test ran before it, so the code below is not narrowed.
function condition(): f64 {
  let v: boolean | f64 = 1.5
  const k = () => {
    v = true
    false
  }
  if !(v is f64) || k() { return 0.0 }
  v * 2.0
}

print(direct() + lambdaArg() + escaped() + sameStatement() + condition())
