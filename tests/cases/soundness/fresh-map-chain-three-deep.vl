// @run
// @log 1
// @log 0
// D14505: a chain of `Map()` bindings settles one binding a literal round, so the innermost
// of three is built at the declared map's record too.
type Circle = { r: i32 | null }
function mkc(): {[string]: {[string]: {[string]: Circle}}} {
  const lv2 = Map()
  lv2["k0"] = { r: null }
  const lv1 = Map()
  lv1["k0"] = lv2
  const cc = Map()
  cc["k0"] = lv1
  return cc
}
const c = mkc()
print(c.length)
const a = c["k0"] ?? Map()
const b = a["k0"] ?? Map()
const r = b["k0"] ?? { r: 4 }
print(r.r ?? 0)
