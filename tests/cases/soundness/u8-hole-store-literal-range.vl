// @check
// @error the literal 300 does not fit a `u8` element (0..255)
// @error the literal 1000 does not fit a `u8` element (0..255)
// @error the literal 300 does not fit a `u8` element (0..255)
// @error the literal 1000 does not fit a `u8` element (0..255)
// A hole parameter pinned at `u8[]` reads its element as `i32` but writes it as `u8`, so an
// out-of-range literal stored through the hole is refused exactly as the direct spelling
// refuses it — by index and by `.push`, bare and under `!= null` (D2238).
function setBare(a) { a[0] = 300 }
function pushBare(a) { a.push(1000) }
function setNarrowed(a) {
  if a != null { a[0] = 300 }
}
function pushNarrowed(a) {
  if a != null { a.push(1000) }
}

const q: u8[] = [7]
setBare(q)
pushBare(q)
const n: u8[] | null = [7]
setNarrowed(n)
pushNarrowed(n)
