// @run
// @log flipped
// @log 0
// @log flipped
// @log 0
// @log 1.5
// @log none
// A module binding narrowed inside a function can be written by any function of the module, so
// a call that may reach such a writer ends the narrowing: a top-level function two calls down, a
// module-level closure, one inside a loop, and a top-level function rebinding the root of a
// narrowed field. Each reads the value after the call, not the stale narrowing (D2401).
type O = { v: string | null }
let g: boolean | f64 = 1.5
let v: boolean | f64 = 1.5
let h: boolean | f64 = 1.5
let o: O = { v: "abc" }
function setG() { g = true }
function viaSetG() { setG() }
const setV = () => {
  v = true
}
function setH() { h = true }
function reset() { o = { v: null } }

function twoDown() {
  if g is f64 {
    viaSetG()
    if g is f64 { return g }
    print("flipped")
  }
  0.0
}

function moduleClosure() {
  if v is f64 {
    setV()
    if v is f64 { return v }
    print("flipped")
  }
  0.0
}

function loop() {
  let t = 0.0
  if h is f64 {
    let i = 0
    while i < 2 {
      if h is f64 { t = t + h }
      setH()
      i = i + 1
    }
  }
  t
}

function rebind() {
  if o.v != null {
    reset()
    print(o.v ?? "none")
  }
}

print(twoDown())
print(moduleClosure())
print(loop())
rebind()
