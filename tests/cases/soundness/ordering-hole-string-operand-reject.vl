// @check
// @error operator '<' is not defined for i32 and string (the call's argument types)
// @error operator '>' is not defined for string and f64 (the call's argument types)
// @error operator '<=' is not defined for boolean and string (the call's argument types)
// @error operator '>=' is not defined for i32[] and string (the call's argument types)
// @error operator '<' is not defined for {n: i32} and string (the call's argument types)
// @error operator '<' is not defined for null and string (the call's argument types)
// @error operator '<' is not defined for string | null and string (the call's argument types
// @error operator '<' is not defined for f64 and string (the call's argument types)
// CONTRACT (must-error): the rejecting half of `ordering-hole-string-operand-sound.vl`. An
// ordering with one annotated string operand and one HOLE defers its form to the call site
// rather than deciding it in the body — so the call site is where a non-string binding of the
// hole must be caught, and `binOpDefinedFor`'s ordering rule admits exactly `string`/`string`
// and numeric/numeric. Every other binding is a clean type error naming the ARGUMENT types,
// not the hole.
//
// So the loosening costs nothing in safety: the half-annotated spelling rejects the same
// programs its fully-annotated twin rejects. `string?` is the sharpest case — a nullable
// string is not orderable in the annotated spelling either, and the hole must not smuggle
// it past by way of being permissively assignable to `string`.

function cmpNum(a, b: string) { a < b }
function cmpNumR(a: string, b) { a > b }
function cmpBool(a, b: string) { a <= b }
function cmpArr(a, b: string) { a >= b }
function cmpObj(a, b: string) { a < b }
function cmpNull(a, b: string) { a < b }
function cmpNulStr(a, b: string) { a < b }

// A hole reached through a SECOND generic hop still re-defers, so the outer call decides it.
function cmpInner(p, q: string) { p < q }
function cmpOuter(w) { cmpInner(w, "b") }

function maybeStr(k: i32): string | null {
  if k > 0 { return "a" }
  return null
}

print(cmpNum(1, "b")) // i32 against a string
print(cmpNumR("a", 2.5)) // f64 on the hole side
print(cmpBool(true, "b")) // boolean is not orderable
print(cmpArr([1], "b")) // a list is not orderable
print(cmpObj({n: 1}, "b")) // an object is not orderable
print(cmpNull(null, "b")) // null is not orderable
print(cmpNulStr(maybeStr(1), "b")) // a NULLABLE string is not orderable either
print(cmpOuter(1.5)) // through two hops
