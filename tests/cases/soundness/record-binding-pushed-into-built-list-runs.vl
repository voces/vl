// @run
// @log 6
// @log 7
// @log 6
// @log 6
// @log 6
// @log 6
// @log 4
// A fresh record `const` pushed into a list whose elements are built at a wider record is built
// at that record, read at its fields, through an alias, from a closure, or pushed twice (D15237).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const wideJ: J = mk()
const xs = [mk()]
const r = { f: 6 }
xs.push(r)
print(xs[1].f)
print(r.f + 1)
const b = xs
const s = { f: 6 }
b.push(s)
print(xs[2].f)
const ys = [mk()]
const t = { f: 6 }
xs.push(t)
ys.push(t)
print(ys[1].f)
const u = { f: 6 }
const push = () => {
  ys.push(u)
}
push()
print(ys[2].f)
function g() {
  const zs = [mk()]
  const v = { f: 6 }
  zs.push(v)
  v
}
print(g().f)
print(wideJ.f ?? 0)
