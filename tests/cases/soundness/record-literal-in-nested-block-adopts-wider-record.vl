// @run
// @log 1.5
// @log 1.5
// @hint redundant type annotation: `x` is inferred as `i32`
// D2995: a record literal bound one block below the module or a function body adopts the wider
// record it is handed to, as one bound at the top of the body does.
type D = { v: f64 }
const x: i32 = 3
function g(d: D) { print(d.v / 2.0) }
if true {
  const q = { v: x }
  g(q)
}
function f() {
  if x > 0 {
    const q = { v: x }
    g(q)
  }
}
f()
