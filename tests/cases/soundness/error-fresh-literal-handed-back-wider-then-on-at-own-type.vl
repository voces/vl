// @check
// @error-at 12:8 this {y: i32, x: i32} is stored at V, the row the stores into its container build; handing it on as {y: i32, x: i32} is type-valid but not supported yet
// VERDICT PIN (must-error): a literal a generic builds wider and hands back is stored at that
// record, so handing the result on at its own type needs a copy (D15185).
type V = { y: i32, x: i32 | string }
function k(v: V) { v.y }
function back<T>(v: T): T {
  k(v)
  v
}
function f(q: { y: i32, x: i32 }) { q.x }
print(back({ y: 2, x: 9 }).y)
print(f(back({ y: 2, x: 9 })))
