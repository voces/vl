// @log 6
// @log ab
// The same alias through functions that build and walk it, and its generic spelling.
type LL = { v: i32, n: LL } | null
function push(l: LL, v: i32): LL { return { v: v, n: l } }
function len(l: LL) {
  let k = 0
  let c = l
  while c != null {
    k = k + 1
    c = c.n
  }
  return k
}
const l = push(push(push(null, 1), 2), 3)
print(len(l))
if l != null { print(l.v) }

type GL<T> = { v: T, n: GL<T> } | null
let g: GL<i32> = { v: 1, n: { v: 2, n: { v: 3, n: null } } }
let s = 0
while g != null {
  s = s + g.v
  g = g.n
}
print(s)
const h: GL<string> = { v: "a", n: { v: "b", n: null } }
if h != null {
  const e = h.n
  if e != null { print(h.v + e.v) }
}
