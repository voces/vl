// @run
// @log 7
// @log 7
// @log 4
// @hint redundant type annotation: `i` is inferred as `{f: i32}`
// D2924: a list of object literals adopted as `I[]` is stored in an un-annotated object
// literal's field at that type, so the field and the list agree on one element storage.
const i: { f: i32 } = { f: 4 }
type I = { f: i64 | null }
const il = [{ f: 7 }]
const ic: I[] = il
const hh = { xs: il }
print(hh.xs[0].f)
print(ic[0].f)
print(i.f)
