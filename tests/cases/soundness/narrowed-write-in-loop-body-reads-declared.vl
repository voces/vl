// @run
// @log 1
// @log null
// @log end
// The re-execution barrier (D2609). A loop body runs many times, so a read textually before a
// write reads what the write stored on the next iteration. A write in the loop that may leave a
// narrowing made outside it therefore ends that narrowing before the loop starts, in both
// halves: `print(q)` reads `q` at its declared `i32 | null`, and prints `null` on the second
// iteration. A read the narrowed type alone allows (`q + 1`) is refused there instead
// (`soundness/narrowed-write-in-loop-read-before-rejected.vl`).

function step(k: i32) {
  if k < 3 { return k + 1 }
  null
}

function loopWrite() {
  let q = step(0)
  if q != null {
    let i = 0
    while i < 2 {
      print(q)
      q = null
      i = i + 1
    }
  }
  print("end")
}

loopWrite()
