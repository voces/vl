// @run
// @log 20
// @log 21
// D14566: a function-local binding of a call whose function returns another call's fresh
// record holds that record at the row it is built at, not at the declared record of its fields.
type Col = { r: i32, g: i32 }
type J = { r: i32 | null, g: i32 }
function idn<T>(v: T): T { v }

function mkR() { { r: 20, g: 1 } }
function dl() { return mkR() }
function f() {
  const d = dl()
  const dj: J = d
  print(dj.r ?? 0)
}
f()

function mkS() { { r: 21, g: 1 } }
function dm() { return idn(mkS()) }
function g() {
  const d = dm()
  const dj: J = d
  print(dj.r ?? 0)
}
g()
