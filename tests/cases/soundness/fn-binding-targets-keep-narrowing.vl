// @run
// @log 3
// @log 5
// @log 3

// D5017: a call through a binding runs one of the functions ever stored into it, so a
// narrowing survives when none of them can write the narrowed path — whether the binding is
// bound once to a named function, re-pointed through a setter, or bound to another binding.

type Box = { m: string | null }

// Bound once to a named function.
function countNone(n: i32) { n - n }
const counter: (n: i32) => i32 = countNone
function tally(n: i32) { counter(n) }
function show(b: Box) {
  if b.m != null {
    const k = tally(1)
    return b.m.length + k
  }
  -1
}

// Re-pointed through a setter: the targets are every value any call hands it.
function bump(n: i32) { n + 1 }
let hook: (n: i32) => i32 = countNone
function hookSet(f: (n: i32) => i32) { hook = f }
function runHook(n: i32) { hook(n) }
function showHook(b: Box) {
  if b.m != null {
    const k = runHook(1)
    return b.m.length + k
  }
  -1
}

// Re-pointed to another binding, which itself is never re-pointed.
const other: (n: i32) => i32 = countNone
let chained: (n: i32) => i32 = countNone
function pointOther() { chained = other }
function showChained(b: Box) {
  if b.m != null {
    const k = chained(1)
    return b.m.length + k
  }
  -1
}

print(show({ m: "abc" }))
hookSet(bump)
print(showHook({ m: "abc" }))
pointOther()
print(showChained({ m: "abc" }))
