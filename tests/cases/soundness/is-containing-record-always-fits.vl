// @log true
// @log false
// @log 2
// @log 0
// `b is A` where every value of `b`'s declared record type fits `A` holds, and over a union it
// tests the one member that can fit `A` (D4062).

type A = { x: i32 }
type B = { x: 1 | 2 }
function plain(b: B) { b is A }
print(plain({ x: 1 }))

type S = { k: string }
type P = { k: "p" }
function str(p: P) { p is S }
print(str({ k: "p" }))

function orNull(b: B | null) { b is A }
print(orNull({ x: 2 }))
print(orNull(null))

type C = { z: string }
function either(b: B | C) { b is A }
print(either({ x: 1 }))
print(either({ z: "q" }))

function then(b: B | C) {
  if b is A { return b.x }
  0
}
print(then({ x: 2 }))
print(then({ z: "q" }))
