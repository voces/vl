// @check
// @error-at 18:13 {r: i32, g: i32} is not J: they store field `r` differently
// @error-at 19:13 {r: i32, g: i32} is not K: they store field `r` differently
// @error-at 20:13 {r: i32, g: i32} is not J: they store field `r` differently
// @error-at 21:13 {r: i32, g: i32} is not K: they store field `r` differently
// @error-at 22:13 {r: i32, g: i32} is not J: they store field `r` differently
// @error-at 23:2 {r: i32, g: i32} is not K: they store field `r` differently
// D8301: one function body builds one record row, so a fresh call whose calls land on two
// records that store a field differently is refused at each delivery rather than built at one
// row and read as the other: directly, through an identity, and as an argument.
type J = { r: i32 | null, g: i32 }
type K = { r: i32 | null, g: i32 | null }
function idn<T>(v: T): T { v }
function mkA() { { r: 15, g: 1 } }
function mkB() { { r: 16, g: 1 } }
function mkC() { { r: 17, g: 1 } }
function h(k: K) { print(k.g ?? 0) }

const a: J = mkA()
const b: K = mkA()
const c: J = idn(mkB())
const d: K = idn(mkB())
const e: J = mkC()
h(mkC())
print(a.r ?? 0)
print(b.g ?? 0)
print(c.r ?? 0)
print(d.g ?? 0)
print(e.r ?? 0)
