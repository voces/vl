// @check
// @error-at 16:13 {r: i32, g: i32} is not J: they store field `r` differently
// @error-at 17:13 {r: i32, g: i32} is not K: they store field `r` differently
// D8301: a maker's calls landing on two records are each copied where they land, directly and
// as an argument; through a generic identity the call is not the delivered value, so it still
// refuses at each landing rather than built at one row and read as the other.
type J = { r: i32 | null, g: i32 }
type K = { r: i32 | null, g: i32 | null }
function idn<T>(v: T): T { v }
function mkA() { { r: 15, g: 1 } }
function mkB() { { r: 16, g: 1 } }
function mkC() { { r: 17, g: 1 } }
function h(k: K) { print(k.g ?? 0) }

const a: J = mkA()
const b: K = mkA()
const c: J = idn(mkB())
const d: K = idn(mkB())
const e: J = mkC()
h(mkC())
print(a.r ?? 0)
print(b.g ?? 0)
print(c.r ?? 0)
print(d.g ?? 0)
print(e.r ?? 0)
