// @run
// @log 1
// @log 1
// A record literal whose field names match an arm of a declared union, but whose checker type
// is its own `{v: i32}`, builds at that type: declaring `U` does not change `e.v / 2` (D14493).
type R = { v: f64 }
type U = R | string
const e0 = { v: 3 }
print(e0.v / 2)
function f() {
  const e1 = { v: 3 }
  print(e1.v / 2)
}
f()
