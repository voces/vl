// @run
// @log 2
// @log 4
// A lambda handed to a declared function that only ever calls that parameter runs inside the
// call, so it keeps a narrowing of a module binding the call cannot reach a writer of. `init`
// writes `cfg`, and nothing `each` does can reach it (D2402).
type Cfg = { k: i32 }
let cfg: Cfg | null = null
function init() { cfg = { k: 2 } }
function each(xs: i32[], f: (i32) => void) {
  for x in xs { f(x) }
}
function run(xs: i32[]) {
  if cfg != null {
    each(xs, (x: i32) => {
      print(x * cfg.k)
    })
  }
}
init()
run([1, 2])
