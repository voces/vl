// @check
// @error this value is built as Circle where line 15 delivers it, and it is handed on here at its own type
// @error this value is built as Circle[] where line 19 delivers it, and it is handed on here at its own type
// CONTRACT (must-error): one call delivers an inferred function's result into a wider record or
// record list, and another use keeps it at its own type. The body builds one result, so the
// other use is refused (clause 2 until the result is built at the destination, D14385). The
// annotated-only calls are the controls in `inferred-result-delivered-wider-runs.vl`.
type Cir2 = { c2: i32 }
type Sq2 = { s2: i32 }
type Circle = { r: Cir2 | Sq2 }
function mk() { return { r: { c2: 1 } } }
function rows() { [{ r: { c2: 1 } }, { r: { s2: 5 } }] }
