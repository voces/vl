// @run
// @log 1
// @log 2
// @log 3
// CONTRACT (must-not-error): the acceptance mirror of
// inferred-is-chain-no-else-reject.vl. An EXHAUSTIVE `is`-chain over every
// variant, in a function with NO return annotation, needs no trailing `else` —
// the chain subtracts every variant, the fall-through is unreachable, and all
// paths return. The inferred-return totality check must not over-fire on it.

type A = { a: i32 }
type B = { b: i32 }
type C = { c: i32 }
type ABC = A | B | C

function get(x: ABC) {
  if x is A { return x.a }
  else if x is B { return x.b }
  else if x is C { return x.c }
}

print(get({ a: 1 })) // 1
print(get({ b: 2 })) // 2
print(get({ c: 3 })) // 3
