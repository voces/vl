// @log 4
// @hint redundant type annotation: `i` is inferred as `{f: i32}`
// D2914's decline set: the uses of a list built at its declared destination's record that
// read that row where they are keep running — returns and `if` joins that keep its type, and a
// `for` variable of the same name included — and a destination of the list's own record made
// nullable does not re-seat its record at all.
const i: { f: i32 } = { f: 4 }
type I = { f: i64 | null }
type H = { r: I }
function wide(r: I) { print(r.f) }
function wideList(): I[] { il }
function elem(): I { il[0] }
const il = [{ f: 7 }]
const ic: I[] = il
function inferredElem() { il[0] }
print(ic[0].f)
print(il[0].f)
print(il.length)
for e in il { print(e.f) }
const x = il[0]
print(x.f)
const alias = il
print(alias[0].f)
const g = () => il[0].f
print(g())
wide(il[0])
const w: I = il[0]
print(w.f)
const h: H = { r: il[0] }
print(h.r.f)
const l: I[] = [il[0]]
print(l[0].f)
const ll: I[][] = [il]
print(ll[0][0].f)
print(wideList()[0].f)
print(elem().f)
print(inferredElem().f)
function show(r: { f: i32 }) { print(r.f) }
function inner() {
  const il = [{ f: 9 }]
  show(il[0])
}
inner()
const nl = [{ f: 5 }]
const nc: readonly ({ f: i32 } | null)[] = nl
const n0 = nc[0]
if n0 != null { print(n0.f) }
show(nl[0])
function whole() { il }
print(whole()[0].f)
const gl = () => il
print(gl()[0].f)
const q = if il.length > 0 { il } else { il }
print(q[0].f)
const other = [{ f: 6 }]
for il in other { show(il) }
print(i.f)
