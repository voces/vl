// @run
// @log 4
// @log 6
// @log 5
// @log 5
// @log 7
// A call's record result, or a held binding also handed to a parameter of its own type, written
// into a field of a receiver the record solve built wider, is built at the field's stored record
// (D15821).
type J = { f: i32 | null }
type K = { j: J | null }
function mk() { { j: { f: 4 } } }
const kk: K = mk()
print(kk.j?.f ?? 0)
const y = mk()
function mj() { { f: 6 } }
y.j = mj()
print(y.j.f)

const w = mk()
const v = { f: 5 }
w.j = v
function own(z: { f: i32 }) { z.f }
print(own(v))
print(w.j.f)

function put() {
  const x = mk()
  x.j = { f: 7 }
  return x.j.f
}
print(put())
