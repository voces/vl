// @run
// @log 1
// @log 3
// @log 1
// @log 1
// @log 1
// @log 1
// @log 3
// @log 1
// @log 1
// A list literal holding a binding of a join whose every arm is a kept maker's call is built where
// the arms are, beside a declared row of the join's own type and beside a kept call (D15656).
type J = { f: i32 | null }
type K = { f: i32 }
function mk2() { { f: 1 } }
function mk3() { { f: 3 } }
const dA: J = mk2()
const dB: J = mk3()
print(dA.f ?? 0)
print(dB.f ?? 0)
const k = 1
const b = if k > 0 { mk2() } else { mk2() }
const xs = [b]
print(xs[0].f ?? 0)
const ys = [b, mk2()]
print(ys[1].f ?? 0)
const m = match k {
  1 => mk2()
  _ => mk3()
}
const zs = [m, m]
print(zs[1].f ?? 0)
const o = { g: b }
print(o.g.f ?? 0)
function g(n: i32) {
  const c = if n > 0 { mk3() } else { mk2() }
  const cs = [c]
  print(cs[0].f ?? 0)
}
g(k)
const z: K = { f: 1 }
print(z.f)
const ws: J[] = [b]
print(ws[0].f ?? 0)
