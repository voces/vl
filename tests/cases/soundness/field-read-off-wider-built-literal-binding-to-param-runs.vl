// @run
// @log 1
// @log 4
// @log 4
// @log 5
// A field read off a literal's binding the record solve builds wider, handed to a parameter of the
// read's own type, instances the parameter at the field's stored record (D15827).
type J = { f: i32 | null }
type K = { j: J }
const y = { j: { f: 4 } }
const ks: K[] = [y]
print(ks.length)
function own(q: { f: i32 }) { q.f }
print(own(y.j))
const v = y.j
print(own(v))
function put(q: { f: i32 }) { q.f = 5 }
put(y.j)
print(ks[0].j.f ?? 0)
