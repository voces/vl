// @error-at 13:18 this list holds elements built as J where line 14 gives them, and elements held at their own {f: i32} here, which store a field differently; a record is shared, not copied, so one list cannot hold both. Copy these with an object literal
// @error-at 15:20 this list holds elements built as J where line 16 gives them, and elements held at their own {f: i32} here, which store a field differently; a record is shared, not copied, so one list cannot hold both. Copy these with an object literal
// A list literal holding a part built at a wider record and a part held at its own storage is
// refused at the own part: a record is shared, not copied, so one list cannot hold both (D15372).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const wideJ: J = mk()
const xs = [mk()]
const os = [{ f: 1 }]
const a = [...xs, ...os]
const o: { f: i32 } = { f: 2 }
const b = [xs[0], o]
function h(p: { f: i32 }) {
  const c = [xs[0], p]
  c.length
}
print(a.length + b.length + h({ f: 3 }))
print(wideJ.f ?? 0)
