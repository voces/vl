// @run
// @log 8
// @log 9
// @log 5
// @log 0
// D8683: a record literal handed to a hole beside a union member of its own storage and a
// declared record that boxes its field keeps the member's storage, as an argument and as a
// binding the hole reads.
type J = { r: i32 }
type N = { r: i32 | null }
const a: J | string = { r: 5 }
function take(b) { return b.r + 1 }
print(take({ r: 7 }))
const o = { r: 8 }
print(take(o))
if a is J { print(a.r) }
const keepN: N = { r: null }
print(keepN.r ?? 0)
