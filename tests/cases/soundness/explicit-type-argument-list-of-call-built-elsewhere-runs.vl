// @run
// @log 1
// @hint Intentionally-unused parameter `_x`
// A call whose record another delivery builds at a wider record, handed in a list literal to a call
// that writes its type argument, is copied into it as its direct twin is (D14815, D14818).
type Circle = { r: i32 | null }
type K = { r: null }
function sink(_x: Circle) {}
function mkcall() { { r: null } }
sink(mkcall())
function first<T>(xs: T[]): T { xs[0] }
print(first<K>([mkcall()]).r ?? 1)
