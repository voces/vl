// @run
// @log 7
// @log 7
// @log 8
// @log 9
// @log 6
// @log 4
// A fresh list of record lists delivered whole to a list of lists of a wider record, bound, passed
// or spread into a push, is built there by its literal's stamp and keeps its own type (D15370).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const wideJ: J = mk()
const more = [[{ f: 7 }]]
const w: J[][] = more
print(w[0][0].f ?? 0)
print(more[0][0].f ?? 0)
const two = [[{ f: 7 }], [{ f: 8 }]]
function h(x: J[][]) { x[1][0].f ?? 0 }
print(h(two))
const ys = [[mk()]]
const rest = [[{ f: 9 }]]
ys.push(...rest)
print(ys[1][0].f ?? 0)
const zs: J[][] = [[{ f: 4 }]]
const tail = [[{ f: 6 }]]
zs.push(...tail)
print(zs[1][0].f ?? 0)
print(wideJ.f ?? 0)
