// @run
// @log 1
// @log 3.5
// @log 3
// @log 1.25
// @log 1.25
// @log 1.25
// A spread of a call's fresh record list beside a part at a wider record is copied element by
// element into that record (D16444), and a `const` of a maker's one call is built there (D16445).
// One maker per position; each fraction proves a float field.
function mk1() { return [{ x: 1 }] }
function mk2() { return [{ x: 3 }] }
function mk3() { return [{ x: 1 }] }
const l1 = [{ x: 2.5 }, ...mk1()]
print(l1[1].x)
const a = { x: 0.5 }
const l2 = [...mk2(), a]
print(l2[0].x + l2[1].x)
print(l2.length + 1)
const l3: { x: f64 }[] = [{ x: 2.5 }, ...mk3()]
print(l3[1].x + 0.25)
function mk4() { return [{ x: 1 }] }
const s4 = mk4()
const l4 = [{ x: 2.5 }, ...s4]
print(l4[1].x + 0.25)
print(s4[0].x + 0.25)
