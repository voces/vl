// @check
// @error comparison expects numeric operands, got _ and boolean
// @error operator '<' is not defined for i32 and boolean (the call's argument types)
// @error cannot assign (_) => _ to 'c' of type i32
// @error unknown type 'nosuchtype'
// @error print of () => <error> is type-valid but not yet supported by codegen — `print` renders one scalar or string; print the elements/fields individually, e.g. `print(xs[0])`
// The RENDERING contract for a type that is not a concrete type. `docs/guide/soundness.md`
// guarantees VL has no dynamic top type, so the two things `tyToStr` cannot name as a
// type must not be spelled as type NAMES — a reader who believes the spelling is writable
// writes it and gets `unknown type '…'`, which is how this file's ancestor
// (`tests/lsp_undisplayable_type_test.ts`) was reported.
//
// The two conditions are DISTINCT and this file pins both in one place so a change that
// collapses them reddens:
//   `_`       NO TYPE WAS DETERMINED HERE — an un-annotated still-polymorphic param
//             (this file), and equally the element of an empty `[]` or the key/value of
//             an empty `Map()` (`soundness/absence-markers-render-reject.vl`)
//   `<error>` a `TyErr` — the reader's OWN annotation was rejected, above, by name
// The same split governs the LSP: `<error>` is filtered from editor surfaces by
// `isDisplayableType`, `_` deliberately is not, because a blank-bearing type is
// informative — and a bare `_` is a substring of ordinary identifiers, so it could not
// join a substring sentinel list without deleting hints from healthy code.

// (1) A HOLE at a leaf position, where the message reads as a sentence.
function cmp(a) {
  if a < true { return 1 }
  return 2
}
print(cmp(1))

// (2) A HOLE nested inside a composite render, the case that forces a COMPACT marker:
// no restructured sentence can spell this one, because the hole is a component of a
// function type rather than the whole subject of the message.
function id(x) x
const c: i32 = id
print(c)

// (3) An unresolvable annotation is a `TyErr`, which renders `<error>` — NOT `_`.
// `nosuchtype` is not a VL type, so `mk`'s return type is absent rather than unsolved.
function mk(): nosuchtype {
  return 0
}
print(mk)
