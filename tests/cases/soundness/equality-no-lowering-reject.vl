// @check
// @error `==` over f64[] has no lowering
// @error `==` over i64[] has no lowering
// @error `==` over f32[] has no lowering
// @error `==` over {v: i32}[] has no lowering
// @error `==` over string[][] has no lowering
// @error `==` over i32[][][] has no lowering
// @error `==` over {[string]: i32} has no lowering
// @error `!=` over f64[]? has no lowering
// @error `==` over {[string]: i32}? has no lowering
// CONTRACT (must-error): the SOUNDNESS BOUNDARY of `==` in the other direction. A rep the
// emitter has no compare core for must not pass `vl check` — `eqCmpKindOfTy` answers "none" and
// the checker rejects with `unsupported-lowering`, off the same function the emitter's dispatch
// reads. Every shape below was `vl check`-CLEAN INVALID WASM: no arm claimed it, so the `==`
// fell through to the i32 tail and emitted `i32.eq` over two refs ("expected i32, found
// (ref $type)").
//
// The emitter has exactly three list-compare cores — the i32/boolean backing, string elements,
// and a ref list of i32/boolean lists. So an `f64[]` / `i64[]` / `f32[]` element (each its own
// distinct backing), a STRUCT element, a `string[][]`, and anything nested deeper than
// `i32[][]` have none; nor does a map. THE NULLABLE FORM OF EACH IS REJECTED FOR THE SAME
// REASON, which is the whole point of one home: a niche can only take the null guard when its
// non-null rep has a core to guard.
//
// A later change that gives one of these a core must GRADUATE it out of this file with a
// LOG-mismatch pin, not quietly let it become invalid wasm again.
type S = {v: i32}
export function eqF64(a: f64[], b: f64[]) { print(a == b) }
export function eqI64(a: i64[], b: i64[]) { print(a == b) }
export function eqF32(a: f32[], b: f32[]) { print(a == b) }
export function eqStructList(a: S[], b: S[]) { print(a == b) }
export function eqStrStrList(a: string[][], b: string[][]) { print(a == b) }
export function eqDeepList(a: i32[][][], b: i32[][][]) { print(a == b) }
export function eqMap(a: {[string]: i32}, b: {[string]: i32}) { print(a == b) }
export function neNulF64(a: f64[] | null, b: f64[] | null) { print(a != b) }
export function eqNulMap(a: {[string]: i32} | null, b: {[string]: i32} | null) {
  print(a == b)
}
