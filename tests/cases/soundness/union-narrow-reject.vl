// @check
// @error cannot assign string | i32 to 'n' of type string
// CONTRACT (must-error): the reverse — assigning a wider union into a narrower
// type — is unsound (the `i32` arm would not fit `string`) and must be rejected.
// Going wider→narrower requires an explicit `is`/`==` narrowing first. A `let`
// written a member reads at that member, so the wider value here is a parameter.
function f(w: string | i32) {
  const n: string = w
  print(n)
}
f("a")
