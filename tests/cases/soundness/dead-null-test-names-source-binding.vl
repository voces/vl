// @run
// @warning `y != null` is always true here (y is Item)
// @log 1
// @log 1
// The dead-null-test warning names a binding as the source spells it, even in a program that
// imports a module (D4029).
import { filled } from "std:array"

type Item = { n: i32 }
const a: (Item | null)[] = [null]
a[0] = { n: 1 }
const y = a[0]
if y != null { print(y.n) }
print(filled(1, 0).length)
