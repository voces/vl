// @check
// @error `o` is built as D where line 12 delivers it, which stores field `v` (`i32 | f64 | string`) as `f64 | string`, keeping two of its numbers as one, so it cannot also keep its own type. Copy it there with an object literal, `{ v: o.v }`
// @error the records in `os` are built as D where line 16 delivers each record, which stores field `v` (`i32 | f64 | string`) as `f64 | string`, keeping two of its numbers as one, so each record cannot also keep its own type. Copy each record there, `os.map((r): D => { v: r.v })`
// @error `ob` is built as D where line 21 delivers it
// A literal-holding binding that keeps its own type, whose record keeps two of a union field's
// numbers as one member (`i32` and `f64` as `f64`), is refused at the delivery, which names
// the copy: a read at its own type cannot tell them apart, nor can one at `D` (D3011).
type D = { v: f64 | string }
const x: i32 | f64 | string = 3
const o = { v: x }
const c: {[string]: D} = Map()
c["k"] = o
const t = o.v
if t is i32 { print(t / 2) } else { print("lost i32") }
const os = [{ v: x }]
const ds: D[] = os
const u = os[0].v
if u is i32 { print(u / 2) } else { print("lost i32") }
print(ds.length)
const ob = { v: x }
const db: D = ob
print(db.v)
