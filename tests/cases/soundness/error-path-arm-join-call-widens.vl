// @check
// @error cannot assign i32 | string | boolean to 'y' of type i32 | string
// SOUNDNESS (must-error): A CALL IN EITHER ARM LEAVES THE PATH UNKNOWN, and the arm join must
// not hand the fact back. This is the hazard D1849's close names, and it is a CONTROL rather
// than an argument — with the guard removed this file COMPILES and returns `false`, having
// stored a `boolean` into a binding typed `i32 | string`.
//
// The join folds each arm to one end type, seeding an arm that wrote nothing with the type the
// `if` was entered at. That seed is what a call breaks: `setBool` may store any member the
// FIELD declares, not just the one the guard proved, so the else arm's true end is the whole
// declaration. Seeding it with `i32` would make the join `i32 | string` and lose the `boolean`
// the call actually stored.
//
// THE LEDGER IS WHY IT WORKS ACROSS ARMS. `npInvBy` is first-cause-wins, so the then arm's
// write marks the entry and the else arm's call finds it already marked — the mark alone cannot
// tell the join that a call happened. `noteCallInvalidations` therefore records the event in the
// join's own ledger unconditionally, where the two arms are read separately.
type T = { v: i32 | string | boolean }
function setBool(p: T) { p.v = true }
function f(t: T, c: boolean): boolean {
  if t.v is i32 {
    if c { t.v = "s" } else { setBool(t) }
    const y: i32 | string = t.v
    return y is string
  }
  return false
}
print(f({ v: 3 }, false))
