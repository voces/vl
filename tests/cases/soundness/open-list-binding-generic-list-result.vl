// @run
// @log 0
// @log 1
// @log 2.5
// @log 1
// @log s
// @log 4
// @log 1.5
// @log 0
// A generic's `V[]` result over an open `[]` binding shares that list's element: a write through
// either fixes both, and nothing written leaves them at the unbound default (D16782).
function g<V>(v: V[]): V[] { return v }
function mk<V>(v: V[]): V[] {
  const r: V[] = []
  if v.length > 0 { r.push(v[0]) }
  return r
}
const a = []
print(g(a).length)
const e = []
const h = g(e)
e.push(2.5)
print(h.length)
print(h[0])
const s = []
const t = g(s)
t.push("s")
print(s.length)
print(s[0])
function local() {
  const l = []
  const m = g(l)
  m.push(3)
  print(l[0] + 1)
}
local()
const q = []
const r = mk(q)
r.push(1.5)
print(r[0])
print(q.length)
