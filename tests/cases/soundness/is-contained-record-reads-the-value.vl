// `v is B` where the operand is declared as one record `A` that contains `B` tests the value:
// it fits when every field `B` narrows holds a member of its literal set (D4058).

type A = { x: i32 }
type B = { x: 1 | 2 }
function plain(b: A) { b is B }
print(plain({ x: 7 }))
print(plain({ x: 1 }))

function orNull(b: A | null) { b is B }
print(orNull({ x: 7 }))
print(orNull({ x: 2 }))
print(orNull(null))

type S = { k: string }
type P = { k: "p" | "r" }
function str(s: S) { s is P }
print(str({ k: "q" }))
print(str({ k: "r" }))

type W = { x: i32, y: i32 }
type V = { x: i32, y: 3 | 4 }
function wide(w: W) { w is V }
print(wide({ x: 9, y: 5 }))

// The then-arm reads the narrowed field at the narrowed type.
function one(v: 1 | 2) { v }
function then(b: A) {
  if b is B { return one(b.x) }
  0
}
print(then({ x: 7 }))
print(then({ x: 2 }))

// A module binding and a list element take the same test.
const k: A = { x: 7 }
print(k is B)
const xs: A[] = [{ x: 2 }]
for a in xs { print(a is B) }
