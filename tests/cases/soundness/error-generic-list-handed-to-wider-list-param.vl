// @check
// @error i32[] is not f64[]: a container never widens implicitly, and only a readonly list is covariant
// D3402: a `T[]` pinned at `i32[]` and handed to an `f64[]` parameter is refused at the pin, as the
// direct spelling `h(xs)` is: the container never widens implicitly.
function h(a: f64[]) {
  a[0] = 1.5
  return a.length
}
function g<T>(xs: T[]) { return h(xs) }
const xs: i32[] = [1]
print(g(xs))
