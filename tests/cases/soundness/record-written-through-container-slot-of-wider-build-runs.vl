// @run
// @log 5
// @log 5
// @log 5
// @log 5
// @log 4
// A call the record solve builds at a wider record, stored in a list element, a record field or a
// map value whose read a record is then written through, is copied to its own record where it is
// stored; the binding of the wider build keeps it (D15266).
type J = { f: i32 | null }
type K = { j: J }
function mk() { { j: { f: 4 } } }
const _k: K = mk()
const xs = [mk()]
const a = xs[0]
a.j = { f: 5 }
print(a.j.f)
const o = { w: mk() }
const b = o.w
b.j = { f: 5 }
print(b.j.f)
const m = Map()
m["k"] = mk()
const mv = m["k"]
if mv != null {
  const c = mv
  c.j = { f: 5 }
  print(c.j.f)
}
const n = Map()
n.set("k", mk())
const nv = n.get("k")
if nv != null {
  const d = nv
  d.j = { f: 5 }
  print(d.j.f)
}
print(_k.j.f ?? 0)
