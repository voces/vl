// @check
// @error-at 11:31 operator '*' is not defined for f64 | boolean and f64
// @error-at 18:30 operator '*' is not defined for f64 | boolean and f64

// D2462: a closure that escapes the body making it reads a captured bare name at its declared type
// when the name is assigned anywhere, since the assignment may run before the closure does — here
// a local and a module binding, each rewritten directly after the closure is stored. Line and
// column are 0-based.
function local() {
  let v: f64 | boolean = 1.5
  let c = (): f64 => 0.0
  if v is f64 { c = (): f64 => v * 2.0 }
  v = true
  print(c())
}

let g: f64 | boolean = 1.5
let cg = (): f64 => 0.0
if g is f64 { cg = (): f64 => g * 2.0 }
g = true
print(cg())
local()
