// @run
// @hint redundant type annotation: `xi` is inferred as `i32` — remove it to lean on inference
// @log 1
// @log 3
// @log 1.5
// @log 3
// @log 3.5
// @log 3
// @log 1
// Beside the refused merge, the deliveries that keep a union field's numbers apart run: the
// copy the refusal names, a fresh literal, an `i32` field, the same union, and an `i32` with
// no `f64` beside it (D3011).
type D = { v: f64 | string }
const x: i32 | f64 | string = 3
const o = { v: x }
const c: {[string]: D} = Map()
c["k"] = { v: o.v }
const t = o.v
if t is i32 { print(t / 2) } else { print("lost i32") }
print(c["k"]?.v)
const d: D = { v: x }
const dv = d.v
if dv is f64 { print(dv / 2.0) } else { print("s") }
const xi: i32 = 3
const oi = { v: xi }
c["i"] = oi
print(c["i"]?.v)
const xs: f64 | string = 3.5
const os = { v: xs }
c["s"] = os
print(c["s"]?.v)
const xn: i32 | string = 3
const on = { v: xn }
const dn: D = on
print(dn.v)
const tn = on.v
if tn is i32 { print(tn / 2) } else { print("lost i32") }
