// @run
// @log 12
// @log 12
// @log 12
// @log 12
// @log 12
// @log 12
// @log 12
// @hint redundant type annotation: `h` is inferred as `Circle`
// D15930: an element read of a fresh list delivered where a record stores its field wider is built
// at that record: a literal indexed directly, a generic handing the list back, a binding holding
// that call, an inferred function's result, and a maker called twice.
type Circle = { r: i32 | null }
function keep<T>(xs: T[]): T[] { xs }
function idl<T>(x: T): T { x }
function mkcall() { { r: null } }
function d() { [{ r: null }][0] }
function e() {
  const xs = [{ r: null }]
  xs
}
const a: Circle = [{ r: null }][0]
print(a.r ?? 12)
const k = keep([mkcall()])
const b: Circle = k[0]
print(b.r ?? 12)
const c: Circle = keep([mkcall()])[0]
print(c.r ?? 12)
const j = idl([{ r: null }])
const f: Circle = j[0]
print(f.r ?? 12)
const g: Circle = d()
print(g.r ?? 12)
const h: Circle = e()[0]
print(h.r ?? 12)
const u = mkcall()
print(u.r ?? 12)
