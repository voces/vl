// @check
// @error 'o.v' was narrowed by a guard, but the call to 'zap' on line 19 can write it
// VERDICT PIN (must-error) for the mutation route that passes NO ARGUMENT. `zap` writes
// `o.v` through a FREE variable, so an invalidation keyed on arguments cannot see it —
// and an argument-keyed rule is the natural one to write. This is the cell that makes
// the free-variable write summary load-bearing rather than defensive: disabling that
// one channel reddens this shape and nothing else.
//
// The closure spelling of the same write (`const zap = () => { o.v = null }`) is caught
// by a different leg — a callee whose target is not statically one body is opaque and
// retires every live narrowing — so both spellings are covered, by design, separately.
type O = { v: string | null }

const o: O = { v: "hi" }

function zap() { o.v = null }

if o.v != null {
  zap()
  print(o.v.length)
} else {
  print(0)
}
