// @check
// @error-at 8:6 this call hands an empty list whose element a later write fixes as f64, after the call's instance is built; annotate the list's element type
// @error-at 12:6 this call hands an empty list whose element a later write fixes as string, after the call's instance is built; annotate the list's element type

// An open `[]` binding a call hands a generic list parameter, and a later write then fixes at an
// element other than the unbound default, is refused at the call (D16759).
function probe<V>(v: V[]) { return v.length }
const e = []
print(probe(e))
e.push(2.5)

const s = []
print(probe(s))
s.push("x")
