// @run
// @log 0
// @log 1
// @log 0
// @log 0
// @log 0
// @log 2
// @log 0
// @log 1
// @log 1.5
// @log 4
// An open `[]` binding a call hands a generic list parameter, and a later write then fixes, binds
// the call's type parameter at that element: the instance is built at it, at the default or not.
// One another argument binds first is fixed at that binding, so a later integer literal widens
// into it (D16759).
function probe<V>(v: V[]) { return v.length }
function test<V>(v: V[]) {
  if v is f64[] { return 1 }
  return 0
}
function first<V>(v: V[], d: V): V {
  if v.length > 0 { return v[0] }
  return d
}
function two<V, W>(v: V[], w: W) {
  if w is boolean { return v.length }
  return 0 - 1
}
const e = []
print(probe(e))
e.push(2.5)
print(probe(e))
const s = []
print(test(s))
s.push("x")
print(test(s))
function local() {
  const l = []
  print(probe(l))
  l.push("a")
  l.push("b")
  print(probe(l))
}
local()
const t = []
print(two(t, true))
t.push(1.5)
print(two(t, false))
const b = []
print(first(b, 1.5))
b.push(4)
print(b[0])
