// @check
// @error cannot assign i32 to 'e' of type K
// VERDICT PIN (must-error, D4926): the loop variable of `for x in v` under `v is K[]` reads
// elements the loop body can still write. A call in the body that stores into an element
// retires the narrowing for the whole loop, so `x` is an `i32`. This program checked clean
// and printed 0 then 5.
type K = 0 | 1
const v: i32[] = [0, 1]
const f = () => {
  v[1] = 5
}
if (v is K[]) {
  for x in v {
    f()
    const e: K = x
    print(e)
  }
}
