// @run
// @log -1
// @log -1
// @log 4
// A map's `set` writes the key's value as `m[k] = v` does, so it ends a narrowing of that cell:
// called directly, or from a lambda the call runs, the value reads at its declared type and the
// re-test sees the string. A `set` of a different literal key leaves the narrowing standing.
function lambdaSet(m: {[string]: string | i32}) {
  const h = () => {
    m.set("a", "s")
  }
  if m["a"] is i32 {
    h()
    const x = m["a"]
    if x is i32 { return x + 1 }
    return -1
  }
  0
}
function directSet(m: {[string]: string | i32}) {
  if m["a"] is i32 {
    m.set("a", "s")
    const x = m["a"]
    if x is i32 { return x + 1 }
    return -1
  }
  0
}
function otherKey(m: {[string]: string | i32}) {
  if m["a"] is i32 {
    m.set("b", "s")
    return m["a"] + 1
  }
  0
}
function mk(): {[string]: string | i32} {
  const m: {[string]: string | i32} = Map()
  m["a"] = 3
  m
}
print(lambdaSet(mk()))
print(directSet(mk()))
print(otherKey(mk()))
