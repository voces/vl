// @emit-error an element of this list is handed on here to a record type of the same field names
// D2933: a list of object literals whose element is handed to a declared record of the same
// field names is built at that record only where a list of it exists; with none, the element
// would reach the destination at its own record, so the delivery is refused.
type J = { f: i32 | null }
type I = { f: i32 }
const il = [{ f: 7 }]
function show(r: J) { print(1) }
show(il[0])
