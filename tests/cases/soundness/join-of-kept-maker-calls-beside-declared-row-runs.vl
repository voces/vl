// @run
// @log 1
// @log 1
// @log 1
// @log 1
// @log 3
// @log 1
// @log 9
// A join whose every arm is a call of a maker an annotated binding builds wider is built where its
// arms are, though a declared record spells the join's own type (D15654).
type J = { f: i32 | null }
type K = { f: i32 }
function mk2() { { f: 1 } }
function use(x: { f: i32 }) { x.f }
const dA: J = mk2()
print(dA.f ?? 0)
const k = 1
const b = if k > 0 { mk2() } else { mk2() }
print(b.f ?? 0)
const m = match k {
  1 => mk2()
  _ => mk2()
}
print(m.f ?? 0)
const u = if k > 0 { mk2() } else { mk2() }
print(use(u))
const z: K = { f: 3 }
print(z.f)
function g(n: i32) {
  const c = if n > 0 { mk2() } else { mk2() }
  print(c.f ?? 0)
}
g(k)
const w = if k > 0 { mk2() } else { mk2() }
w.f = 9
print(w.f ?? 0)
