// @run
// @log 4
// @log 1
// @log 4
// @log 1
// D3403: a binding built where a delivery stores its `i32` member as `f64` beside `null`, read
// at its own type, narrows the stored box back to the `i32` it held.
type D = { v: f64 | string | null }
const x: i32 | string = 4
const o = { v: x }
const d: D = o
print(d.v ?? "z")
const t = o.v
if t is i32 { print(t / 3) } else { print("n") }
const p = { v: x }
const l: D[] = [p]
print(l[0].v ?? "z")
const u = p.v
if u is i32 { print(u / 3) } else { print("n") }
