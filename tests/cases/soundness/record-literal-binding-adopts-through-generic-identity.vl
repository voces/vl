// @run
// @log 3.5
// @log 3.5
// @log 3.5
// @log 7000000000
// @log 3.5
// @log 14
// D3442: a generic identity hands its argument back, so a literal binding delivered through it
// adopts the destination record like its annotated twin, through nested identities and a join
// inside one; it was check-clean invalid wasm.
type D = { v: f64 }
type E = { v: i64 }
type N = { p: { v: f64 } }
function idd<T>(x: T): T { return x }
const c = true

const q1 = { v: 7 }
const d1: D = idd(q1)
print(q1.v / 2)
print(d1.v / 2)

const q2 = { v: 7 }
const d2: D = idd(idd(q2))
print(q2.v / 2)

const q3 = { v: 7 }
const d3: E = idd(if c { q3 } else { { v: 1 } })
print(d3.v * 1000000000)

const q4 = { p: { v: 7 } }
const d4: N = idd(q4)
print(q4.p.v / 2)
print(d2.v + d4.p.v)
