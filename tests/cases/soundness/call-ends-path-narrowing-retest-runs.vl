// @run
// @log gone
// @log flipped
// @log 0
// @log gone
// @log 3
// @log none
// @log none
// @log abc
// A call that may write a narrowed field, element or map value ends that narrowing after its
// statement: the place then reads at its declared type, and a re-test narrows it again. The
// emitter retires the path at the same statement, so both halves agree on the rep (D2405).
type O = { v: string | null }
type W = { value: f64 | boolean }

function clr(o: O) { o.v = null }
function mutate(w: W) { w.value = true }
function clrCell(xs: (string | null)[]) { xs[0] = null }

function retest(o: O) {
  if o.v != null {
    clr(o)
    if o.v != null { print(o.v.length) } else { print("gone") }
  }
}

function retestIs(v: W) {
  if v.value is f64 {
    mutate(v)
    if v.value is f64 { return v.value * 2.0 }
    print("flipped")
  }
  0.0
}

function retestCell(xs: (string | null)[]) {
  if xs[0] != null {
    clrCell(xs)
    if xs[0] != null { print(xs[0].length) } else { print("gone") }
  }
}

function declaredRead(o: O) {
  if o.v != null {
    print(o.v.length)
    clr(o)
    print(o.v ?? "none")
  }
}

function inOneArm(o: O, c: boolean) {
  if o.v != null {
    if c { clr(o) }
    print(o.v ?? "none")
  }
}

retest({ v: "abc" })
print(retestIs({ value: 1.5 }))
retestCell(["abc"])
declaredRead({ v: "abc" })
inOneArm({ v: "abc" }, true)
inOneArm({ v: "abc" }, false)
