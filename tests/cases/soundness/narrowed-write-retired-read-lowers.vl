// @run
// @log 1
// @log 9
// @log 2
// @log 7
// @log 3
// @log 3
// CONTRACT (must-RUN): a read INSIDE the guarded region, AFTER the write that retired the
// narrowing. This file was a `@check` / `@error` pin, and the refusal it pinned was an
// EMITTER constraint stated as a checker rule: the emitter's narrow stack held the region's
// narrowed rep for the rest of the guarded block, so typing this read `i32?` gave a
// check-clean module the engine rejects with "expected (ref null $type), found i32", and the
// checker refused the read rather than emit that. The emitter retires the same write now
// (`narrowRetired`, emit_state.vl), so the read lowers at the DECLARED rep — which is what
// putting the declared type back into the scope the narrowing shadowed always meant.
//
// EACH LEG PAIRS THE PRE-WRITE READ WITH THE POST-WRITE ONE. The first is the narrowed
// value and the second the default, so a compiler that left the binding narrowed past the
// write prints the pre-write value where the log demands the default — the direction this
// file has pinned from the start, now readable as a value rather than as a diagnostic.
//
// THE MAY-HAVE-HAPPENED WRITE IS HERE TOO (`nestedWrite`): the retirement is written in
// place, never pushed, so an inner block's close cannot resurrect the narrowing and the
// read after it is boxed on both paths. Under `c == false` the binding still holds 3 and the
// read must still see it, which is what makes the boxed read the only correct lowering
// rather than merely the safe one.

function step(k: i32) {
  if k < 3 { return k + 1 }
  null
}

function readAfterWrite() {
  let q = step(0)
  if q != null {
    print(q) // 1 — narrowed
    q = null
    print(q ?? 9) // 9 — retired, so the default
  }
}

// A NULLABLE right-hand side retires the same way, and the read after it is the same rep.
function readAfterNullableWrite() {
  let r = step(1)
  if r != null {
    print(r) // 2 — narrowed
    r = step(9)
    print(r ?? 7) // 7 — retired, and `step(9)` is null
  }
}

// The write MAY not have happened: `c` is false, so the binding still holds its value and
// the boxed read has to produce it.
function nestedWrite() {
  let s = step(2)
  const c = false
  if s != null {
    print(s) // 3 — narrowed
    if c { s = null }
    print(s ?? 6) // 3 is retired-but-present, so the read is 3 — not the default
  }
}

readAfterWrite()
readAfterNullableWrite()
nestedWrite()
