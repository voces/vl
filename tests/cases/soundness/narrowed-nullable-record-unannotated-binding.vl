// @run
// @log false
// @log true
// @log 4
// @log -1
// @log 4
// @log -1
// @log false
// @log true
// D3107: an un-annotated binding of a value narrowed to `X | null` out of a wider box is the
// nullable record, delivered to a parameter, a capture, a field read and a return.
type Circle = { r: i32 }
function g(w: Circle | null) { return w == null }
const zz: (Circle | null | string)[] = [{ r: 4 }, null]
for e in zz {
  if !(e is string) {
    const c = e
    print(g(c))
  }
}
function show(w: Circle | null) {
  if w == null { return 0 - 1 }
  return w.r
}
function t(e: Circle | null | string) {
  if !(e is string) {
    const c = e
    const f = () => show(c)
    print(f())
  }
}
t({ r: 4 })
t(null)
function u(e: Circle | null | string) {
  if !(e is string) {
    const c = e
    if c != null { print(c.r) } else { print(0 - 1) }
  }
}
u({ r: 4 })
u(null)
function pass(e: Circle | null | string): Circle | null {
  if !(e is string) {
    const c = e
    return c
  }
  return null
}
print(pass({ r: 4 }) == null)
print(pass(null) == null)
