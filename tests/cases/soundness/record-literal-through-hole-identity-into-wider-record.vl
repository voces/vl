// @run
// @log 3
// @log 4
// @log 5
// @log 6
// D8800: a record literal, or a binding holding only one, handed back by an un-annotated identity
// into a record that stores its field boxed is built at that record, as through a generic
// identity, while the program declares the literal's own record.
type A = { d: i32 | null }
type II = { d: i32 }
function f(v) { return v }
function g(v) {
  const w = v
  return w
}
function h<T>(v: T): T { return v }
const a: A = f({ d: 3 })
print(a.d ?? 0)
const x = { d: 4 }
const b: A = f(x)
print(b.d ?? 0)
const c: A = g({ d: 5 })
print(c.d ?? 0)
const e: A = h({ d: 6 })
print(e.d ?? 0)
