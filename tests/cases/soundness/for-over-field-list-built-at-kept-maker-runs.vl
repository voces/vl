// @run
// @log 1
// @log 1
// @log 1
// @log 1
// @log 3
// @log 5
// @log 1
// A `for` over a list read off a record field types its loop variable where the list is built,
// at a kept maker's record (D15694).
type J = { f: i32 | null }
function mk2() { { f: 1 } }
const dA: J = mk2()
print(dA.f ?? 0)
const r = { ys: [mk2()] }
for y in r.ys { print(y.f ?? 0) }
const xs = [mk2()]
const q = { ys: xs }
const zs = q.ys
for y in zs { print(y.f ?? 0) }
const n = { a: { ys: [mk2()] } }
for y in n.a.ys { print(y.f ?? 0) }
function go() {
  const g = { ys: [mk2()], k: 2 }
  for y in g.ys { print((y.f ?? 0) + g.k) }
}
go()
const w = { ys: [mk2()] }
for y in w.ys { y.f = 5 }
print(w.ys[0].f ?? 0)
print(w.ys.length)
