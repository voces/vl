// @run
// @log 1
// @log 1
// @log 4
// @hint redundant type annotation: `q` is inferred as `{f: i32}`
// A maker called more than once keeps its own record; its call is copied where it lands wider.
// A binding of a call held in a list literal beside a maker's call is also handed on at its own
// storage, and runs (D15655).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const wideJ: J = mk()
const xs = [mk()]
function os0() { { f: 1 } }
const o = os0()
const ws = [xs[0], o]
print(ws[1].f ?? 0)
const q: { f: i32 } = o
print(q.f)
print(wideJ.f ?? 0)
