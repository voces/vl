// @run
// @log 4
// @log 4
// @log 7
// @log 1
// @log 4
// @log 15
// @hint Intentionally-unused variable `_k`
// @hint Intentionally-unused variable `_l`
// @hint Intentionally-unused variable `_k2`
// A function's nested record result, delivered to a wider record at one binding and kept at its
// own type at another, is built at the wider record and read back at its own type (D15231).
type J = { f: i32 | null }
type K = { j: J }
function mk() { { j: { f: 4 } } }
const _k: K = mk()
const y = mk()
print(y.j.f)
const z = y.j
print(z.f)
y.j.f = 7
print(y.j.f)
const xs = [mk()]
print(xs.length)
type L = { k: K }
function mk2() { { k: { j: { f: 4 } } } }
const _l: L = mk2()
const w = mk2()
print(w.k.j.f)
type J2 = { f: i32 | null, g: i32 }
type K2 = { j: J2, h: i32 }
function mk3() { { j: { f: 4, g: 5 }, h: 6 } }
const _k2: K2 = mk3()
const v = mk3()
print(v.j.f + v.j.g + v.h)
