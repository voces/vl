// @check
// @error-at 30:16 f64 | i32 doesn't fit in i32
// @error-at 31:16 i32 | f64 doesn't fit in i32
// @error-at 32:16 f64 | i32 doesn't fit in i32
// @error-at 33:16 f64 doesn't fit in i32
// @error-at 34:16 f64 | i32 doesn't fit in i32
// @error-at 35:5 argument 1: expected i32, got f64 | i32
// @error-at 36:24 cannot assign (_) => _ | _ to 'f' of type (i32) => i32
// D8940: an un-annotated function whose returns join an `f64` with its `i32` argument returns
// the join, `f64 | i32`, at the call's bound types, so it is refused at an `i32` binding, an
// `i32` argument and a function type returning `i32`, whatever the order of the returns, as an
// `if` expression, as a lambda, and with a literal arm, which adapts to the `f64` it joins.
function halfOr(a) {
  if a > 1 { return a / 2.0 }
  return a
}
function orHalf(a) {
  if a > 1 { return a }
  return a / 2.0
}
function halfIf(a) { return if a > 1 { a / 2.0 } else { a } }
function scaleOr(a) {
  if a > 1 { return a * 1.5 }
  return 2
}
const halfL = (a) => {
  if a > 1 { return a / 2.0 }
  return a
}
function take(v: i32) { print(v) }
const r1: i32 = halfOr(3)
const r2: i32 = orHalf(3)
const r3: i32 = halfIf(3)
const r4: i32 = scaleOr(3)
const r5: i32 = halfL(3)
take(halfOr(3))
const f: (i32) => i32 = halfOr
print(r1)
print(r2)
print(r3)
print(r4)
print(r5)
print(f(3))
