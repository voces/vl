// @run
// @log 1
// @log 4
// @log 1
// @log 1
// @log 1
// A read of a map whose values are built wider, defaulted with `??` to a `const` of a maker that
// hands back another maker's call: the call is delivered at the read's record down the chain, as
// an inline `?? mk4()` is, rather than the binding being adopted there (D15311).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const m = Map()
m.set("a", mk())
const wm: {[string]: J} = Map()
wm.set("a", mk())
function mk2() { { f: 1 } }
function mk4() { mk2() }
const d = mk4()
const b = m.get("z") ?? d
print(b.f ?? 0)
function mkA2() { { f: 1 } }
function mkA4() { mkA2() }
const dA = mkA4()
const bA = m.get("a") ?? dA
print(bA.f ?? 0)
function mkR2() { { f: 1 } }
function mkR4() { return mkR2() }
const dR = mkR4()
const bR = m.get("z") ?? dR
print(bR.f ?? 0)
function mkT2() { { f: 1 } }
function mkT4() { mkT2() }
function mkT6() { mkT4() }
const dT = mkT6()
const bT = m.get("z") ?? dT
print(bT.f ?? 0)
function mkB2() { { f: 1 } }
function mkB4() {
  const r = mkB2()
  r
}
const dB = mkB4()
const bB = m.get("z") ?? dB
print(bB.f ?? 0)
