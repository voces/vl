// @check
// @error is handed on here at its own type, which stores a field differently
// @hint Intentionally-unused parameter `_b`
// @hint Intentionally-unused parameter `_x`
// CONTRACT (must-error): a bound record whose function's result one delivery builds wider is not
// handed on at its own type: not to a generic whose instance a held argument or a written type
// argument pins at that type, and not inside a list or record literal delivered there (D15180).
type Circle = { r: i32 | null }
type K = { r: null }
function sink(_x: Circle) {}
function mkcall() { { r: null } }
const c = mkcall()
sink(c)
const k: K = { r: null }
const ks: K[] = [k]
function both<T>(a: T, _b: T): T { a }
function inList<T>(a: T[], _b: T): T { a[0] }
function inField<T>(a: { f: T }, _b: T[]): T { a.f }
function nested<T>(a: T[][]): T { a[0][0] }
const xs: K[] = [c]
const w: { f: K } = { f: c }
print(xs.length + (w.f.r ?? 1))
print(both(c, k).r ?? 6)
print(inList([c], k).r ?? 6)
print(inField({ f: c }, ks).r ?? 6)
print(nested<K>([[c]]).r ?? 6)
