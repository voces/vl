// @run
// @log 6
// @warning Unused variable `wideJ`
// @hint redundant type annotation: `h` is inferred as `i32`
// A maker called more than once keeps its own record; its call is copied where it lands wider.
// A fresh record `const` assigned into a binding of a maker's call is also handed on at its own
// type, and runs (D15238).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const wideJ: J = mk()
const xs = [mk()]
function h(o: { f: i32 }): i32 { o.f }
let y = xs[0]
const r = { f: 6 }
y = r
print(h(r))
let z = mk()
const s = { f: 6 }
z = s
const zs = [{ f: 1 }]
zs.push(s)
