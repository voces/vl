// @run
// @log 5
// @log 3
// @log 4
// @log 3
// @log 4
// A body ending in a bare `{ … }` returns that block's tail, as an `if` arm's block does (D3477):
// annotated, nested, after a statement, as a lambda body and un-annotated. D1902's trap is
// closed by lowering the block tail-aware, so a value is returned where the totality rule says so.
function k(): i32 {
  {
    5
  }
}
function nested(id: i32): i32 {
  {
    {
      id
    }
  }
}
function after(id: i32): i32 {
  const x = 1
  {
    id + x
  }
}
const lam = (id: i32): i32 => {
  {
    id
  }
}
function inferred(id: i32) {
  {
    {
      id + 1
    }
  }
}
print(k())
print(nested(3))
print(after(3))
print(lam(3))
print(inferred(3))
