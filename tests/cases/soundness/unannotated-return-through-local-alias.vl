// Regression (silent-class-inventory D41), the graduation of
// `xfail-miscompile-alias-local-anon-objlit-return.vl`. An un-annotated local ALIASING another
// un-annotated local, returned from an un-annotated function. Seven lines and NO TYPE
// DECLARATION AT ALL — the smallest member this class has held.
//
// On master `c0873a06`: `vl check` rc 0 with no diagnostics, and `type mismatch: expected
// i32, found (ref $type)` at instantiation. The direction of that message is the tell — the
// RESULT VALTYPE fell to the scalar default while the body handed back a ref. The wasm diff
// is one line: `(func (param i32) (result i32))` became `(func (param i32) (result (ref 0)))`
// and nothing else in the module moved.
//
// WHY THE ALIAS AND NOT THE OBJECT. `criClassify` runs as a GLOBAL pass, before any function's
// locals are collected, so `exprStruct`'s Ident arm — which answers for a param, a global and
// a capture — has nothing to read for a body-declared local. That is exactly why
// `criRetLocalLet` exists: it resolves the returned ident to its `let`. An INIT that is itself
// a bare local ident is the same miss one hop further in, and the lookup now follows the
// un-annotated chain (`retLocalLetOfBlock`).
//
// THE CELLS, and the last two are what make the chain a chain rather than one special case:
//   · the filed witness (one hop, no declarations)
//   · TWO hops
//   · a LIST through the alias (`emitProgram: field access receiver is not a struct` on master)
//   · a hop that ENDS at an annotated let — the chain stops there, because an annotation pins
//     the cell's rep and following past one would answer about the initializer where the
//     declaration already decided
//   · the alias of a PARAM, which never had this defect (`parentLetOf` finds no let) and is
//     here so the lookup's stopping condition is covered from the other side
//
// The param cell is spelled `c: Boxed` rather than `c: { r: i32 }` on purpose: an INLINE-SHAPE
// parameter in a program that also declares a struct of that layout is `emitProgram: ref
// valtype with no interned shape` on master `c0873a06` and on this branch alike — an unrelated
// pre-existing shape, filed as `silent-class-inventory.md` D53, which would otherwise fail this
// file for a reason that has nothing to do with the row it pins.
// @run
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @hint redundant type annotation
type Boxed = { r: i32 }

function oneHop(n: i32) {
  const c = { r: n }
  const o = c
  return o
}

function twoHops(n: i32) {
  const c = { r: n }
  const o1 = c
  const o = o1
  return o
}

function listHop(n: i32) {
  const c = [{ r: n }]
  const o = c
  return o
}

function annotatedLink(n: i32) {
  const c: Boxed = { r: n }
  const o = c
  return o
}

function paramAlias(c: Boxed) {
  const o = c
  return o
}

print(oneHop(7).r)
print(twoHops(7).r)
print(listHop(7)[0].r)
print(annotatedLink(7).r)
print(paramAlias({ r: 7 }).r)
