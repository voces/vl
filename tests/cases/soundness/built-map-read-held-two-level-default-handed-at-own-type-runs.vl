// @run
// @log 1
// @log 4
// A maker called more than once keeps its own record; its call is copied where it lands wider.
// A held two-level maker default over a map read, also handed on at its own type, runs (D15311).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const m = Map()
m.set("a", mk())
const wm: {[string]: J} = Map()
wm.set("a", mk())
function mk2() { { f: 1 } }
function mk4() { mk2() }
const d = mk4()
function use(v: { f: i32 }) { print(v.f) }
const b = m.get("a") ?? d
use(d)
print(b.f ?? 0)
