// A record narrowed out of a union alias the spelling names without a brace pins at the record,
// the arm the type says it is, not at the box (D15978); so does a list of records (D15979).
type W = {r: i32} | string
function id<T>(x: T): T { return x }
function f(w: W) {
  if w is string { return 0 }
  const y = id(w)
  return y.r
}
print(f({ r: 3 }))
print(f("a"))
type R = {r: i32}
type WL = R[] | string
function g(w: WL) {
  if w is string { return 0 }
  const y = id(w)
  return y.length
}
print(g([{ r: 3 }]))
print(g("a"))
