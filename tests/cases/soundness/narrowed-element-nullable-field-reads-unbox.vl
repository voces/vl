// @run
// @log 5
// @log 7
// @log 5
// @log 9
// @log 10
// @log 4
// @log 3
// @log hi
// @log b
// A list element narrowed to a record arm, then its nullable field read by `??` or under a
// `!= null` test, reads the arm out of the element's box and the atom out of the field's
// (D8145). Both spellings of the list, and the read delivered to a print, a binding, a return
// and an argument.
type J = { r: i32 | null, s: string | null, k: "a" | "b" | null }
type K = { z: i32 }
const q: J = { r: 5, s: "hi", k: "b" }
const n: J = { r: null, s: null, k: null }
const xs: (J | K)[] = [q, n]
const ys = [n, { z: 1 }]
if xs[0] is J { print(xs[0].r ?? 0) }
if ys[0] is J {
  const w = ys[0].r ?? 7
  print(w)
}
function first(zs: (J | K)[]) {
  if zs[0] is J { return zs[0].r ?? 9 }
  return 1
}
function twice(v: i32) { v * 2 }
print(first(xs))
print(first([n]))
if xs[0] is J {
  if xs[0].r != null { print(twice(xs[0].r)) }
}
if xs[0] is J {
  const g = if xs[0].r != null { xs[0].r - 1 } else { 0 }
  print(g)
}
if xs[1] is J { print(xs[1].r ?? 3) }
if xs[0] is J {
  if xs[0].s != null { print(xs[0].s) }
  if xs[0].k != null { print(xs[0].k) }
}
