// @check
// @error return type mismatch: expected boolean, got i32 | string | boolean
// WHAT THE CHAIN MAY TRUST ABOUT ITS ARMS — `guard-else-write-voids-residual.vl`'s argument,
// carried down a multi-step chain.
//
// The hand-up says "every arm above exited, so the place is the residual below". An arm
// falsifies that by WRITING a different member into the place on the path that falls through,
// and under the reads-only rule (D1736) it may: the write is checked against the declaration,
// not against the narrowing. So the hand-up is what gives. `pgUpKeys` skips a name an arm
// clobbered and the `if` node is marked, so the emitter's own chain walk stops at the same
// link — the two halves must agree about the rep of `x` below the chain or the read is
// check-clean invalid wasm.
//
// The narrowing is still not a ban on assignment, and a write the narrowing ADMITS
// (`x = false` in the third arm) retires nothing and leaves the residual standing.
function f(x: i32 | string | boolean): boolean {
  if x is i32 { return false }
  else if x is string { return false }
  else { x = "s" }
  return x
}
print(f(true))
