// @check
// @error argument 1: expected I, got J (`r` holds only a literal, so it is built as the `J`
// D2933: an un-annotated binding that holds only a literal takes the record it is delivered to,
// so handing it on at its own record, which stores the same field names differently, is a type
// error that names the adoption.
type J = { f: i32 | null }
type I = { f: i32 }
function show(j: J) { print(j.f ?? 0) }
function own(k: I) { print(k.f) }
const r = { f: 7 }
show(r)
own(r)
