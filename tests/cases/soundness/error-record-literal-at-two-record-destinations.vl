// @emit-error is handed on here at its own type, and elsewhere to a declared record type
// D2933: an un-annotated object literal built at the record its binding is handed to cannot
// also be handed on at its own record, which stores the same field names differently; a record
// is shared, not converted, so the second delivery is refused.
type J = { f: i32 | null }
type I = { f: i32 }
function show(j: J) { print(j.f ?? 0) }
function own(k: I) { print(k.f) }
const r = { f: 7 }
show(r)
own(r)
