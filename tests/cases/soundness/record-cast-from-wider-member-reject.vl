// @check
// @error-at 9:12 `as B` would hand over an object a member A of A | B can still write wider fields; test it with `is B` and copy its fields
// VERDICT PIN (must-error, D4134): `as? B` over `A | B` would hand over an object the `A`
// member can still write wider, so it is refused; `is B` reads it and a copy delivers it.

type A = { x: i32 }
type B = { x: 1 | 2 }
function f(base: A) {
  const a: A | B = base
  const b = a as? B
  if b != null {
    base.x = 7
    const y: 1 | 2 = b.x
    print(y)
  }
}
f({ x: 1 })
