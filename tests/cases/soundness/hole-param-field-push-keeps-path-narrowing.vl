// @run
// @log 4
// `o.xs.push` on an un-annotated parameter does not end the narrowing: the body is checked again
// at the call's argument types, which decide, and a push appends rather than replacing a cell.
type O = { v: string | i32, xs: i32[] }
function g(o) {
  if o.v is i32 {
    o.xs.push(1)
    return o.v + 1
  }
  0
}
const o: O = { v: 3, xs: [] }
print(g(o))
