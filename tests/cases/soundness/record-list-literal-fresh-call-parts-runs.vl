// @run
// @log 6
// @log 4
// A call part of a list literal beside a part built at a wider record is copied into the list's
// build (D15652), and a `const` holding a call's record is built there as it is bound (D15655).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const wideJ: J = mk()
const xs = [mk()]
const o = os0()
function os0() { { f: 1 } }
const a = [...xs, os0()]
const b = [xs[0], o]
const c = [xs[0], os0()]
print(a.length + b.length + c.length)
print(wideJ.f ?? 0)
