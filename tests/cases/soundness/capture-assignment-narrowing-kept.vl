// @run
// @log 2
// @log 4
// @log 1
// @log 3
// @log 2
// @log 3
// @log 3
// @log 2
// @log 2
// @log 3
// @log 5
// @log 2
// @hint Intentionally-unused parameter
// An assignment's narrowing reaches a function body when nothing can store `null` after it and
// nothing can call the body before it: no later write that may be `null`, and for a top-level
// function no call ahead of the narrowing write. A write of another non-null value keeps it, a
// declaration in the body shadows the binding rather than clashing with it, and a local made
// inside a loop is a fresh binding each time round (D2529, D2555).
type P = { x: i32 }
let s: string | null = null
s = "ab"
let p: P | null = null
p = { x: 4 }
let n: i32 | null = null
n = 0
let gv: i32 | null = null
gv = 1
function lenS() { return s.length }
print(lenS())
const px = () => p.x
print(px())
function nextN() { return n + 1 }
print(nextN())
const ys = [1, 2].map((x: i32) => x + n + 1)
print(ys[1])
const short = ["x", "yy", "zzz"].filter((x: string) => x.length < s.length)
print(short.length + 1)
function writeAfter() {
  let t: string | null = null
  t = "ab"
  const h = () => t.length
  t = "abc"
  print(h())
}
writeAfter()
function shadow() {
  const s = "abc"
  print(s.length)
}
shadow()
function loopLocal() {
  let i = 0
  while i < 2 {
    let v: i32 | null = null
    v = 1
    const h = () => v + 1
    print(h())
    i = i + 1
  }
}
loopLocal()
function loopFor() {
  for x in [2] {
    let v: i32 | null = null
    v = x
    const zs = [1].map((y: i32) => y + v)
    print(zs[0])
  }
}
loopFor()
let vv: i32 | null = null
vv = 1
function clear() { vv = null }
function guarded() {
  if vv != null {
    clear()
    print(vv ?? 5)
  }
}
guarded()
function genH<T>(_x: T) { return gv + 1 }
print(genH(0))
