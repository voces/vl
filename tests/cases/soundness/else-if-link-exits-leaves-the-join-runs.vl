// @run
// @log 7
// @log 7
// @log a
// @log 60
// @log p
// @log zero
// An `else if` link whose every arm exits hands no value to the chain's join, as its
// `else { if … }` spelling does: the chain types at the arms that complete (D3396).
type R = { x: i32 }
function t(n: i32) {
  let w = if n == 1 { null } else if n == 2 { return } else { return }
  w = { x: 7 }
  print((w ?? { x: 9 }).x)
}
function u(n: i32) {
  let w = if n == 1 { null } else if n == 2 { return } else if n == 3 { return } else { return }
  w = 7
  print(w ?? 9)
}
function v(n: i32) {
  const w = if n == 1 { "a" } else if n == 2 { return } else if n == 3 { if n > 0 { return } else { return } } else { return }
  print(w)
}
function lab(n: i32) {
  const r = if n > 0 { { x: n, y: "p" } } else if n == 0 { return "zero" } else { return "neg" }
  return r.y
}
t(1)
t(2)
u(1)
v(1)
v(3)
let i = 0
let s = 0
while true {
  i = i + 1
  const k = if i < 4 { i * 10 } else if i == 4 { break } else { break }
  s = s + k
}
print(s)
print(lab(3))
print(lab(0))
