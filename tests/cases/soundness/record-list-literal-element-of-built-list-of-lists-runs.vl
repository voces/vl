// @run
// @log 7
// @log 8
// @log 9
// @log 6
// @log 4
// A list literal pushed or stored as an element of a list of lists built at a wider record is built
// at the inner lists' record, through an alias of the list too (D15284).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const wideJ: J = mk()
const ys = [[mk()]]
ys.push([{ f: 7 }])
print(ys[1][0].f ?? 0)
ys[0] = [{ f: 8 }]
print(ys[0][0].f ?? 0)
const b = ys
b.push([{ f: 5 }, { f: 9 }])
print(ys[2][1].f ?? 0)
function g() {
  const zs = [[mk()]]
  zs.push([{ f: 6 }])
  zs[1][0].f ?? 0
}
print(g())
print(wideJ.f ?? 0)
