// @run
// @log s
// @log x
// @log x
// @log true
// @log s
// @log y
// @log y
// D2880: a record literal whose field holds a literal-set value is handed to the field of an
// outer record built for a `string` field of the same name, so it is built at that row, and the
// binding, the outer record's field and a later write through the binding read one struct.
type K = "x" | "y"
function reads() {
  const r1 = { f: "s" }
  const v2: K = "x"
  const r2 = { f: v2 }
  const w1 = { g: r1 }
  print(w1.g.f)
  const w2 = { g: r2 }
  print(w2.g.f)
  print(r2.f)
  print(r2.f == "x")
}
function writes() {
  const r1 = { f: "s" }
  const v2: K = "x"
  const r2 = { f: v2 }
  const w1 = { g: r1 }
  print(w1.g.f)
  const w2 = { g: r2 }
  r2.f = "y"
  print(w2.g.f)
  print(r2.f)
}
reads()
writes()
