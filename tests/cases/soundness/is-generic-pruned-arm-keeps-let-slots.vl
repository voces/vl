// @run
// @log a
// @log zq
// CONTRACT (must-RUN): D932's slot-accounting half. A pruned arm's `let`s still own
// their collect-allocated slots: `collectLocals` numbers declared locals over the WHOLE
// body in pre-order while emission hands slots out positionally (`emitLetCursor`), so
// skipping the dead arm WITHOUT advancing the cursor bound every later `let` one slot
// early — `after` here landed in `inner`'s cell and the module failed to validate
// ("expected i32, found (ref $type)") on the pre-D932 whole-span-shape skip too.
// `cursorSlotsUnder` advances the cursor over every skipped `let` (and the ForRange /
// ForIn synthetics), so the two pre-orders agree again.
function pick(v): string {
  if v is { foo: string } {
    const inner = v.foo
    return inner
  }
  const after = "z" + "q"
  return after
}

print(pick({ foo: "a" }))
print(pick(5))
