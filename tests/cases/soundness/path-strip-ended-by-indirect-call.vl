// @run
// @log null
// @log true
// @log null
// @log null
// D1848's strip ends at a call that may run the writer, directly or through another function:
// `d()` calls `c()`, which stores `null`, so after `d()` the place reads at its declared type
// and a plain read or a null test of it is accepted. A write the nested body makes ends the
// enclosing narrowing where the body is called, not where it is checked.
type A = { r: i32 }
type W = { f: A | null }
const gw: W = { f: null }
gw.f = { r: 1 }
function gc() { gw.f = null }
function gd() { gc() }
function field() {
  const w: W = { f: null }
  w.f = { r: 1 }
  function c() { w.f = null }
  function d() { c() }
  d()
  const v = w.f
  if v == null { print("null") } else { print(v.r) }
}
function lambda() {
  const w: W = { f: null }
  w.f = { r: 1 }
  function c() { w.f = null }
  const d = () => c()
  d()
  print(w.f == null)
}
function cell() {
  const s: (A | null)[] = [null]
  s[0] = { r: 1 }
  function c() { s[0] = null }
  function d() { c() }
  d()
  const v = s[0]
  if v == null { print("null") } else { print(v.r) }
}
field()
lambda()
cell()
gd()
const gv = gw.f
if gv == null { print("null") } else { print(gv.r) }
