// @run
// @log 7
// @log 7
// @log 8
// @log 9
// @log 7
// @log 7
// @log 7
// @log 4
// An inner list of a list of lists built at a wider record, held by a binding or read in place, is
// built at that record where a literal is assigned, pushed or stored into it (D15236).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const wideJ: J = mk()
const c = wideJ.f == 4
const ys = [[mk()]]
let b = ys[0]
b = [{ f: 7 }]
print(b[0].f ?? 0)
ys[0].push({ f: 7 })
print(ys[0][1].f ?? 0)
const d = ys[0]
d.push({ f: 8 })
print(d[2].f ?? 0)
d[0] = { f: 9 }
print(d[0].f ?? 0)
let e = ys[0]
e = if c { [{ f: 7 }] } else { [] }
print(e[0].f ?? 0)
function g() {
  let h = ys[0]
  h = [{ f: 7 }]
  h[0].f ?? 0
}
print(g())
const k = ys[0]
const r = { f: 7 }
k.push(r)
print(k[1].f ?? 0)
print(wideJ.f ?? 0)
