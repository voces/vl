// @check
// @error 'o.value' is read at its narrowed type by the function on line 13, which may run after the call to 'mutate' writes it
// @error 'o.value' is read at its narrowed type by the function on line 24, which may run after the call to 'mutate' writes it
// @error 'o.value' is not narrowed inside the function on line 37: it is returned, stored or handed on
// A writing call after a nested function read a path under its narrowing is refused even when
// an earlier call (here the reader itself) already ended the narrowing: the reader still runs
// later, and every later writer is asked (D2402). One that escapes reads the declared type (D2407).
type O = { value: f64 | boolean }
function mutate(o: O) { o.value = true }
function straight(o: O) {
  let t = 0.0
  if o.value is f64 {
    const c = (): f64 => o.value * 2.0
    t = t + c()
    mutate(o)
    t = t + c()
  }
  print(t)
}
function looped(o: O) {
  let t = 0.0
  if o.value is f64 {
    let i = 0
    const c = (): f64 => o.value * 2.0
    while i < 2 {
      t = t + c()
      mutate(o)
      i = i + 1
    }
  }
  print(t)
}
function escapedBlock(o: O): f64 {
  let keep = (): f64 => 0.0
  if o.value is f64 {
    if true {
      const g = (): f64 => o.value * 2.0
      keep = g
    }
    mutate(o)
  }
  keep()
}
