// @check
// @error 'c', made on line 13, reads 'o.value' as f64, a narrowing a write or a call since then may have ended
// @error 'o.value' was narrowed by a guard outside this loop, and the call to 'mutate' can write it
// @error 'o.value' is not narrowed inside the function on line 37: it is returned, stored or handed on
// A nested function that read a path under its narrowing is refused at a call after a writing
// call, and in a loop the writer is refused, since the reader runs again on the next iteration
// (D16380, D2403). One that escapes reads the declared type (D2407).
type O = { value: f64 | boolean }
function mutate(o: O) { o.value = true }
function straight(o: O) {
  let t = 0.0
  if o.value is f64 {
    const c = (): f64 => o.value * 2.0
    t = t + c()
    mutate(o)
    t = t + c()
  }
  print(t)
}
function looped(o: O) {
  let t = 0.0
  if o.value is f64 {
    let i = 0
    const c = (): f64 => o.value * 2.0
    while i < 2 {
      t = t + c()
      mutate(o)
      i = i + 1
    }
  }
  print(t)
}
function escapedBlock(o: O): f64 {
  let keep = (): f64 => 0.0
  if o.value is f64 {
    if true {
      const g = (): f64 => o.value * 2.0
      keep = g
    }
    mutate(o)
  }
  keep()
}
