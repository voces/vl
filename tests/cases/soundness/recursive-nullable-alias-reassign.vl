// @run
// @log true
// @log 6
// @log 2
// @log 2
// @log 3
// @log 5
// @info `e` is never reassigned; use `const` instead of `let`
// A recursive record alias spelled with a top-level `| null`: a binding reassigned from its own
// field, a walk, an un-annotated field read narrowed, `null` first, and a `| null` field. The
// field naming the alias is the same nullable record the binding holds, so one struct carries it.
type LL = { v: i32, n: LL } | null
let c: LL = { v: 1, n: { v: 2, n: null } }
if c != null { c = c.n }
print(c != null)

let w: LL = { v: 1, n: { v: 2, n: { v: 3, n: null } } }
let s = 0
while w != null {
  s = s + w.v
  w = w.n
}
print(s)

const r: LL = { v: 1, n: { v: 2, n: null } }
if r != null {
  const d = r.n
  if d != null { print(d.v) }
  let e = r.n
  if e != null { print(e.v) }
}

type NL = null | { v: i32, n: NL }
let q: NL = { v: 1, n: { v: 2, n: null } }
let t = 0
while q != null {
  t = t + q.v
  q = q.n
}
print(t)

type DN = { v: i32, n: DN | null } | null
let z: DN = { v: 4, n: { v: 5, n: null } }
if z != null { z = z.n }
if z != null { print(z.v) }
