// @check
// @error-at 25:6 argument 1: expected "a" | "b", got string
// @error-at 31:4 argument 1: expected 0 | 1, got i32
// @error-at 38:18 cannot assign "a" | "b" to 'r2' of type i32
// @hint redundant type annotation: `r` is inferred as `"a" | "b"` — remove it to lean on inference
// @hint redundant type annotation: `r2` is inferred as `0 | 1` — remove it to lean on inference
// @hint redundant type annotation: `r1` is inferred as `"a" | "b"` — remove it to lean on inference
// SOUNDNESS — the REJECT half of `inference/unannotated-param-solved-from-usage.vl`.
//
// An un-annotated parameter used to be an inference HOLE that each call site pinned to
// its own argument, so a NON-MEMBER argument was accepted: `p("zz")` passed `vl check`
// and the module the emitter produced was invalid (`expected i32, found (ref $type)`) —
// or, in the spellings where the reps happened to agree, it RAN and printed `zz`, a
// value the type `"a" | "b"` does not contain.
//
// `const r: K = u` decides the parameter, so the call site checks the argument against
// `K` — the same message, at the same position, the annotated `p(u: K)` produces. That
// identity is the point: the un-annotated spelling reaches a target that already exists.
type K = "a" | "b"
type Z = 0 | 1

function p(u) {
  const r: K = u
  print(r)
}
p("zz")

function pz(u) {
  const r2: Z = u
  print(r2)
}
pz(7)

// TWO DISAGREEING usages: the first solves the parameter, and the second is then checked
// against the solved type instead of against a permissive hole. Rejected exactly as the
// annotated `pd(u: K)` rejects it — a parameter cannot be both.
function pd(u) {
  const r1: K = u
  const r2: i32 = u
  print(r1)
  print(r2)
}
pd("a")
