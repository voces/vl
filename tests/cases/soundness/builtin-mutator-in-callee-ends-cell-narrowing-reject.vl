// @check
// @error-at 33:8 operator '+' is not defined for i32 | string | null and i32 — 'm["a"]' is no longer narrowed to i32: the call to 'put' on line 33 may reassign it; re-test 'm["a"]' after the call
// @error-at 37:8 operator '+' is not defined for i32 | string | null and i32 — 'm["a"]' is no longer narrowed to i32: the call to 'drop' on line 37 may reassign it; re-test 'm["a"]' after the call
// @error-at 41:8 operator '+' is not defined for i32 | null and i32 — 'n["a"]' is no longer narrowed to i32: the call to 'dropN' on line 41 may reassign it; re-test 'n["a"]' after the call
// @error-at 45:8 operator '+' is not defined for i32 | string and i32 — 'ys[0]' is no longer narrowed to i32: the call to 'wipe' on line 45 may reassign it; re-test 'ys[0]' after the call
// @error-at 49:8 operator '+' is not defined for i32 | string and i32 — 'xs[0]' is no longer narrowed to i32: the call to 'refill' on line 49 may reassign it; re-test 'xs[0]' after the call
// @error-at 57:10 operator '+' is not defined for i32 | string | null and i32 — 'p["a"]' is no longer narrowed to i32: the call to 'put2' on line 57 may reassign it; re-test 'p["a"]' after the call

// D2471: a built-in method that may replace or remove a held cell (`set`, `delete`, `clear`, `pop`,
// `sort`, `reverse`, `insert`, `remove`) is a write of its receiver's cells in every summary a call
// is judged by, so calling a function that runs one ends a narrowing of a cell. Line and column
// are 0-based.
const m: {[string]: i32 | string} = Map()
m["a"] = 1
const n: {[string]: i32} = Map()
n["a"] = 1
const xs: (i32 | string)[] = [1]
const ys: (i32 | string)[] = [1]

function put(k: string) { m.set(k, "x") }
function drop(k: string) { m.delete(k) }
function dropN(k: string) { n.delete(k) }
function wipe() {
  ys.clear()
  ys.push("s")
}
function refill() {
  xs.pop()
  xs.push("s")
}

if m["a"] is i32 {
  put("a")
  print(m["a"] + 1)
}
if m["a"] is i32 {
  drop("a")
  print(m["a"] + 1)
}
if n["a"] != null {
  dropN("a")
  print(n["a"] + 1)
}
if ys[0] is i32 {
  wipe()
  print(ys[0] + 1)
}
if xs[0] is i32 {
  refill()
  print(xs[0] + 1)
}

// The same built-ins inside a nested function of a function.
function nested(p: {[string]: i32 | string}) {
  function put2(k: string) { p.set(k, "x") }
  if p["a"] is i32 {
    put2("a")
    print(p["a"] + 1)
  }
}
nested(m)
