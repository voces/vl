// @check
// @error `s`, which holds only literals, is built as {x: f64} where line 9 delivers it
// CONTRACT (must-error): a fresh list `const` spread beside a wider record part is built at that
// record (D16440), so handing it on at its own `{x: i32}[]` would share one record at two
// storages: a record is shared, not copied.
function f(v: { x: i32 }[]) { print(v[0].x) }
const a = { x: 2.5 }
