// @run
// @log 6
// @log 6
// @log 1
// @log 6
// @log 6
// @hint Intentionally-unused parameter `_x`
// @hint Intentionally-unused parameter `_a`
// @hint Intentionally-unused parameter `_b`
// A list literal holding a held binding, handed to a list of a type parameter another argument
// binds wider, is passed at the list it is built as (D15210).
type Circle = { r: i32 | null }
type K = { r: null }
function sink(_x: Circle) {}
function mkcall() { { r: null } }
const c = mkcall()
sink(c)
const k: K = { r: null }
function ignore<T>(a: T, _b: T[]): T { a }
function onlyB<T>(_a: T, b: T[]): T { b[0] }
function count<T>(_a: T, b: T[]) { b.length }
function swapped<T>(_b: T[], a: T): T { a }
print(ignore(c, [k]).r ?? 6)
print(onlyB(c, [k, { r: null }]).r ?? 6)
print(count(c, [k]))
print(swapped([k], c).r ?? 6)
print(onlyB(c, [k]).r ?? 6)
