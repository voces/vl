// @check
// @error 'v' is no longer narrowed to K[]: the call to 'f' on line 12 may reassign it
// VERDICT PIN (must-error, D4926): a `push` appends an element the guard never tested, so
// a call that pushes onto `v` retires `v is K[]` and the read of the new element is at the
// declared type. This program checked clean and printed 7.
type K = 0 | 1
const v: i32[] = [0, 1]
const f = () => {
  v.push(7)
}
if (v is K[]) {
  f()
  const e: K = v[2]
  print(e)
}
