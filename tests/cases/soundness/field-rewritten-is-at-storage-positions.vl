// @run
// @log 1
// @log 1
// @log 2
// @log 1
// @log false
// @log false
// @log 7
// A record field written in an `is` branch, written whole again, then tested for the member it
// holds: the test reads the field's box at its storage, past the write's narrowing. Parameter,
// local, top-level and captured receivers; a string and an `i32` member.
type O = { v: i32 | string }
function param(o: O) {
  o.v = "s"
  if o.v is string { o.v = 9 }
  if o.v is i32 { print(1) }
}
function local() {
  const o: O = { v: 1 }
  o.v = "s"
  if o.v is string { o.v = 9 }
  if o.v is i32 { print(1) }
}
function strMember(o: O) {
  o.v = "s"
  if o.v is string { print(2) }
  if o.v is i32 { print(1) }
}
function captured() {
  const o: O = { v: 1 }
  if o.v is i32 {
    const d = (): boolean => o.v is i32
    o.v = "s"
    print(d())
  }
}
param({ v: 1 })
local()
strMember({ v: 1 })
const t: O = { v: 1 }
t.v = "s"
if t.v is string { t.v = 9 }
if t.v is i32 { print(1) }
captured()
if t.v is i32 {
  const d = (): boolean => t.v is i32
  t.v = "s"
  print(d())
}
t.v = 7
if t.v is i32 { print(t.v) }
