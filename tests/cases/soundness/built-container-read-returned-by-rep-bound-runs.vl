// @run
// @log 4
// @log 4
// @log 8
// @log 9
// @log 9
// @log 4
// D14810: a by-rep parameter returned into a `const` read only for fields is bound at the
// container's build, through a hole or a generic callee.
type J = { f: i32 | null }
function mk() { { f: 4 } }
function back(r) { return r }
function gen<T>(r: T): T { r }
const wideJ: J = mk()
const xs = [mk()]
const b = back(xs[0])
print(b.f)
const c = gen(xs[0])
print(c.f)
print(b.f + c.f)
b.f = 9
print(xs[0].f)
const g = () => c.f
print(g())
print(wideJ.f ?? 0)
