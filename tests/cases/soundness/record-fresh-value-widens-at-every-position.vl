// @run
// @log 1.5
// @log 1.5
// @log 1.5
// @log 1.5
// @log 1.5
// @log 1.5
// @log 1.5
// @log 1.5
// @log 1.5
// @log 1.5
// @hint redundant type annotation: `x` is inferred as `i32`
// A fresh record, an object literal or a binding that holds only one, is built at the record it
// is delivered to, so it widens at every position: each read halves an `f64` field that was
// written as an `i32` (D2996, DECISIONS.md "Record covariance: only a fresh value widens").
type D = { v: f64 }
type H = { h: D }
const x: i32 = 3
function half(d: D) { print(d.v / 2.0) }
function ret(): D { return { v: x } }
const s = { v: x }
const b: D = s
half(b)
half({ v: x })
half(ret())
let a: D = { v: 1.0 }
a = { v: x }
half(a)
const hh: H = { h: s }
half(hh.h)
const xs: D[] = [{ v: x }]
half(xs[0])
xs[0] = { v: x }
half(xs[0])
const ys: D[] = []
ys.push({ v: x })
half(ys[0])
const g = (d: D) => {
  print(d.v / 2.0)
}
g({ v: x })
const j: D = if x > 0 { { v: x } } else { { v: 0 } }
half(j)
