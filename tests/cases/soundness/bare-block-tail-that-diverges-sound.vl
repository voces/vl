// @run
// @log 5
// @log 1
// @log 7
// @log 9
// @hint redundant type annotation: `ret` is inferred as `i32`
// @hint redundant type annotation: `bothArms` is inferred as `i32`
// @hint redundant type annotation: `loops` is inferred as `i32`
// @hint redundant type annotation: `notLast` is inferred as `i32`
// CONTRACT (must-not-error): what D1902's refusal must NOT swallow. A bare `{ … }` at a
// body's tail yields nothing, but it still DIVERGES when its own tail does — a `return`, an
// `if`/`else` returning from both arms, a `while true` that returns — and each of these
// bodies is total for that reason alone. A block that is not the last statement never
// carried the return in the first place. Every one of these ran before the refusal existed,
// so a totality rule narrow enough to reject `{ 5 }` and wide enough to keep these is the
// whole of the fix; refusing any line here would be a working program lost. The declared
// hints are load-bearing: each says INFERENCE reads the same body as total, so the two
// faces agree here exactly where D1902 says they must disagree over a bare tail value.
function ret(): i32 {
  {
    return 5
  }
}
print(ret())

function bothArms(c: boolean): i32 {
  {
    if c { return 1 } else { return 2 }
  }
}
print(bothArms(true))

function loops(): i32 {
  {
    while true { return 7 }
  }
}
print(loops())

function notLast(): i32 {
  {
    5
  }
  return 9
}
print(notLast())
