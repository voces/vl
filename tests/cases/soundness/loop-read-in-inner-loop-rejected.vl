// @check
// @error 'v.value' was narrowed by a guard outside this loop, and the call to 'mutate' can write it, so the read on line 12
// A read in an inner loop runs again on every iteration of the loops around it, so a writing
// call later in an outer loop is refused for it as for a read in the outer body (D2403).
type W = { value: f64 | boolean }
function mutate(w: W) { w.value = true }
function f(v: W) {
  let t = 0.0
  if v.value is f64 {
    let i = 0
    while i < 2 {
      for j in 0 to 1 { t = t + (v.value as f64) }
      mutate(v)
      i = i + 1
    }
  }
  t
}
print(f({ value: 1.5 }))
