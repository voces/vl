// @run
// @log 7
// @log 7
// @log 5
// @log 12
// @log 4
// A binding holding a list whose elements are built at a wider record is stored at that list, so
// a list literal assigned into it is built there too (D15189).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const wideJ: J = mk()
const xs = [mk()]
let b = xs
b = [{ f: 7 }]
print(b[0].f)
function g() {
  let c = xs
  c = [{ f: 7 }]
  c[0].f
}
print(g())
let d = xs
d = [{ f: 7 }]
d = [{ f: 6 }, { f: 5 }]
print(d[1].f)
let e = xs
for i in 0 to 2 { e = [{ f: i + 10 }] }
print(e[0].f)
print(wideJ.f ?? 0)
