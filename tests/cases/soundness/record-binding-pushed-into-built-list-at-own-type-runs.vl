// @run
// @log 6
// @warning Unused variable `wideJ`
// @hint redundant type annotation: `h` is inferred as `i32`
// A maker called more than once keeps its own record; its call is copied where it lands wider.
// A fresh record `const` pushed into a list of a maker's calls is also handed on at its own type,
// and runs (D15237).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const wideJ: J = mk()
const xs = [mk()]
const zs = [{ f: 1 }]
const r = { f: 6 }
function h(o: { f: i32 }): i32 { o.f }
xs.push(r)
zs.push(r)
print(h(r))
