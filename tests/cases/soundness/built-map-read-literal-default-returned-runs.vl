// @run
// @log 9
// @log 4
// @log 4
// @log 1
// @log 8
// A function returning a read of a container whose values are built wider, defaulted with `??` to
// a record literal, returns the container's record, and the literal is built there (D15218).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const m = Map()
m.set("a", mk())
const wm: {[string]: J} = Map()
wm.set("a", mk())
function g() { m.get("a") ?? { f: 1 } }
const x = g()
x.f = 9
print(m.get("a")?.f ?? 0)
function gi() { m["a"] ?? { f: 1 } }
print(gi().f - 5)
function gr() { return m.get("a") ?? { f: 1 } }
print(gr().f - 5)
function gz() { m.get("z") ?? { f: 1 } }
print(gz().f)
function g2(t: boolean) {
  if t { return m.get("a") ?? { f: 1 } }
  m["a"] ?? { f: 2 }
}
print(g2(true).f - 5 + g2(false).f - 5)
