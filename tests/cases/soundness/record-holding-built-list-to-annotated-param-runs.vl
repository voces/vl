// @run
// @log 1
// @log 1
// @log 1
// @log 4
// @log 3
// @log 1
// @log 1
// A record built at a kept maker's list, handed to an annotated parameter of its own type that the
// callee reads only for a field, is read where it is built (D15695).
type J = { f: i32 | null }
type R = { ys: { f: i32 }[] }
function mk2() { { f: 1 } }
const dA: J = mk2()
print(dA.f ?? 0)
const xs = [mk2()]
function use(r: { ys: { f: i32 }[] }) { print(r.ys[0].f) }
const r = { ys: xs }
use(r)
const o = { ys: [{ f: 4 }] }
use(r)
use(o)
function sum(r: { ys: { f: i32 }[], n: i32 }) { print(r.ys[0].f + r.n) }
const s = { ys: xs, n: 2 }
sum(s)
function walk(r: R) {
  for y in r.ys { print(y.f) }
}
const w = { ys: xs }
walk(w)
function count(r: R) { print(r.ys.length) }
const c = { ys: xs }
count(c)
