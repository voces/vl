// D2407: a closure that escapes the function making it — returned, stored in a field, a list, a
// map or a global, handed to a callee that is not known to only call it, or assigned to another
// binding — reads a captured field, element or map-value path at its declared type, since any
// holder of the object may write the path before it runs. Line and column are 0-based.
type O = { v: string | null }
type H = { run: () => i32 }

// Returned.
function returned(o: O): () => i32 {
  if o.v != null { return (): i32 => o.v.length }
  (): i32 => 0
}

// An index cell, returned.
function cell(xs: (string | null)[]): () => i32 {
  if xs[0] != null { return (): i32 => xs[0].length }
  (): i32 => 0
}

// A map value, returned.
function mapValue(m: {[string]: string | null}): () => i32 {
  if m["a"] != null { return (): i32 => m["a"].length }
  (): i32 => 0
}

// Stored in a struct field.
function field(o: O): H {
  if o.v != null {
    const h = { run: (): i32 => o.v.length }
    return h
  }
  { run: (): i32 => 0 }
}

// Assigned to another binding.
let keep = (): i32 => 0
function assigned(o: O) {
  if o.v != null {
    const c = (): i32 => o.v.length
    keep = c
  }
}

// Handed to a callee that stores it.
const saved: (() => i32)[] = []
function stash(k: () => i32) { saved.push(k) }
function handed(o: O) {
  if o.v != null { stash((): i32 => o.v.length) }
}

const o: O = { v: "abc" }
const r = returned(o)
o.v = null
print(r())
print(cell(["a"])() + mapValue(Map())() + field(o).run())
assigned(o)
handed(o)
