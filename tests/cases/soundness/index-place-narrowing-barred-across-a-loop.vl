// @check
// @error member access '.length' on non-object i32[] | null — 'xs[0]' is no longer narrowed to i32[]: the assignment to 'xs[0]' on line 16 in the loop around this read may reassign it; re-test 'xs[0]' after the assignment
// @hint redundant type annotation: `xs` is inferred as `(i32[] | null)[]`
// SOUNDNESS (must-error), and what it pins is the MESSAGE (Inventory-2 D11, D2609).
//
// A write in a loop to a place narrowed outside it runs before the reads textually above it
// on the next iteration, so the narrowing ends before the loop starts. The read is what is
// refused, and the sentence names the write and the loop, not a type mistake.
function src(): i32[] | null { return [1, 2] }

function barred(c: boolean) {
  const xs: (i32[] | null)[] = [src()]
  if xs[0] != null {
    while c {
      print(xs[0].length)
      xs[0] = null
    }
  } else {
    print("NUL")
  }
}
barred(false)
