// @check
// @error 'xs[0]' was narrowed by a guard OUTSIDE this loop, so this write would leave the reads before it reading null on the next iteration — move the write out of the loop, or make the guard on 'xs[0]' the loop's own condition
// @hint redundant type annotation: `xs` is inferred as `(i32[] | null)[]`
// SOUNDNESS (must-error), and what it pins is the MESSAGE.
//
// A narrowing retires at a falsifying write because the statements AFTER the write run with
// it gone — a statement-order fact a loop body breaks, since the reads textually before the
// write run again after it. `writeStorageTy` therefore declines across a re-execution
// barrier and the write is refused. That much a member place already had.
//
// `writeBarredByLoop` is the arm that decides WHICH refusal the reader is told about, and it
// tested `Member` alone. Without its Index twin this program still errors — but as
// `cannot assign null to i32[]`, which is false on its own terms (the storage holds a null
// perfectly well, and the identical write one block out is accepted) and sends the reader
// looking for a type mistake instead of at the loop. Inventory-2 D11.
function src(): i32[] | null { return [1, 2] }

function barred(c: boolean) {
  const xs: (i32[] | null)[] = [src()]
  if xs[0] != null {
    while c {
      print(xs[0].length)
      xs[0] = null
    }
  } else { print("NUL") }
}
barred(false)
