// @run
// @log 4
// @log 1
// @log 4
// @log 1
// @log 4
// @log 1
// A read of a map whose values are built wider, defaulted with `??` to a held `const` of a maker
// and, elsewhere, to a maker relaying it: both deliver the inner maker at the read's record, and
// it is built there once (D15317).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const m = Map()
m.set("a", mk())
const wm: {[string]: J} = Map()
wm.set("a", mk())
function mk2() { { f: 1 } }
function mk4() { mk2() }
const dA = mk2()
const bA = m.get("a") ?? dA
const b = m.get("z") ?? mk4()
print(bA.f ?? 0)
print(b.f ?? 0)
function mkH2() { { f: 1 } }
function mkH4() { mkH2() }
const dH = mkH2()
const bH = m.get("a") ?? dH
const d = mkH4()
const bD = m.get("z") ?? d
print(bH.f ?? 0)
print(bD.f ?? 0)
function mkR2() { { f: 1 } }
function mkR4() { mkR2() }
const dR = mkR2()
const bR = m.get("a") ?? dR
function g() { m.get("z") ?? mkR4() }
print(bR.f ?? 0)
print(g().f ?? 0)
