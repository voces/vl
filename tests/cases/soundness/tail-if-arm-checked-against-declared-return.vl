// @error-at 32:14 expected i32, got string
// @error-at 35:25 expected i32, got string
// @error-at 39:19 expected i32, got string
// @error-at 45:9 expected i32, got string
// @error-at 51:15 expected i32, got string
// @error-at 62:4 expected i32, got string
// @error-at 68:6 expected i32, got string
// @error-at 74:41 expected i32, got string
// @error-at 76:18 expected i32, got string
// @error-at 81:11 expected i32, got string
// @error-at 85:14 expected P, got {y: i32}
// @error-at 88:27 expected "a" | "b", got string
// @error-at 91:14 expected i32, got boolean
// @error-at 94:14 expected i32, got f64
// @error-at 97:14 expected boolean, got i32
// @error-at 100:14 expected i32 | null, got string
// CONTRACT (must-error, D2234): under a declared return type every value a tail `if`/`else`
// yields is the return, so each arm is checked against that type at the arm itself — exactly
// as a bare tail expression is. A tail `if` is a statement node, and a tail `match` desugars
// to one, so the tail check once skipped them both: every function below passed `vl check`
// and then built invalid wasm, crashed on a cast, or printed a value of the wrong type (the
// literal-union one printed `b` for `"c"`, the boolean one `1`, the integer-into-boolean one
// `true`), and the nullable one trapped on a cast.
//
// One refused arm per spelling: then, else, else-if link, nested `if`, block tail, an arm
// whose tail is a bare block, a `match` arm (literal and type vocabularies), a lambda with a
// declared result, a `self`-function, a record, a literal union, and the two conversions the
// language does not make implicitly (boolean to i32, i32 to boolean, f64 to i32), and a
// `string` arm under an `i32 | null` return.
type P = { x: i32 }
type Q = { s: string }
function thenArm(n: i32): i32 {
  if n == 0 { "i" } else { 2 }
}
function elseArm(n: i32): i32 {
  if n == 0 { 2 } else { "i" }
}
function elseIfArm(n: i32): i32 {
  if n == 0 { 1 }
  else if n == 1 { "s" }
  else { 2 }
}
function matchArm(n: i32): i32 {
  match n {
    0 => 1
    1 => "s"
    _ => 2
  }
}
function nestedArm(n: i32): i32 {
  if n == 0 {
    if n > 5 { "a" } else { 3 }
  } else {
    2
  }
}
function blockTailArm(n: i32): i32 {
  if n == 0 {
    1
  } else {
    const z = n + 1
    print(z)
    "s"
  }
}
function bareBlockArm(n: i32): i32 {
  if n == 0 {
    {
      "s"
    }
  } else {
    2
  }
}
const lam = (n: i32): i32 => if n == 0 { "i" } else { 2 }
function lab(self: P): i32 {
  if self.x > 0 { "x" } else { 1 }
}
function matchType(v: P | Q): i32 {
  match v {
    P => v.x
    Q => v.s
  }
}
function recordArm(n: i32): P {
  if n == 0 { { y: 1 } } else { { x: 2 } }
}
function litArm(n: i32): "a" | "b" {
  if n == 0 { "a" } else { "c" }
}
function boolArm(n: i32): i32 {
  if n == 0 { true } else { 2 }
}
function floatArm(n: i32): i32 {
  if n == 0 { 1.5 } else { 2 }
}
function intToBool(n: i32): boolean {
  if n == 0 { 5 } else { false }
}
function nullableArm(n: i32): i32 | null {
  if n == 0 { "s" } else { null }
}
print(
  thenArm(1)
    + elseArm(1)
    + elseIfArm(1)
    + matchArm(1)
    + nestedArm(1)
    + blockTailArm(1),
)
print(
  bareBlockArm(1) + lam(1) + lab({ x: 1 }) + matchType({ x: 1 }) + recordArm(1).x,
)
print(litArm(1))
print(boolArm(1) + floatArm(1))
print(intToBool(1))
print(nullableArm(1) ?? 3)
