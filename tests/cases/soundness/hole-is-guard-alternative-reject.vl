// @check
// @error argument 1: expected {foo: string} | {bar: any}, got {baz: string}
// @error argument 1: expected {zap: any, foo: string} | {zap: any, bar: any}, got {foo: string}
// @error argument 1: expected {other: any, ok: string} | {other: any}, got {ok: string}
// SOUNDNESS net for the `is`-guard ALTERNATIVE constraint (see
// `inference/hole-is-guard-alternative.vl`): accepting the guard's tested type
// alongside the demanded shape must not become a blanket "any object goes".
//
// Each alternative also carries WHICH demanded fields an argument taking the
// guard's TRUE path still reaches, so the three ways to reach one still reject.
// Those residual fields are folded into the RENDERED arm too: printing the bare
// tested type made the message contradict itself (`expected {foo: string} | …, got
// {foo: string}` — naming an arm the rejected argument appears to satisfy).
function foobar(v) {
  if v is { foo: string } then return v.foo
  return v.bar
}
// (1) NEITHER arm: `{baz: string}` satisfies no path. The message names the whole
// disjunction, not the complement arm alone.
print(foobar({ baz: "baz" }))

// (2) A field demanded BEFORE the guard runs on every path, so it stays required
// even for an argument that then takes the guard.
function preGuard(v) {
  print(v.zap)
  if v is { foo: string } then return v.foo
  return v.bar
}
print(preGuard({ foo: "x" }))

// (3) A then-branch that does NOT diverge rejoins the fall-through, so the fields
// demanded after the guard are reached by a guard-satisfying argument too.
function rejoins(v) {
  if v is { ok: string } then print(v.ok)
  return v.other
}
print(rejoins({ ok: "x" }))
