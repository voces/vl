// @check
// @error 'o2.v' was narrowed by a guard, but the call to 'outerB' on line 40 can write it
// INVARIANT PIN — it passes on every compiler that resolves a nested callee by walking
// the ENCLOSING SUBTREE, so it does not distinguish one such compiler from another. What
// it pins is the property that makes that lookup cacheable at all: the answer depends on
// WHICH body is being summarised, not on the callee name alone.
//
// Two enclosing bodies each declare a function named `h`, and their write effects
// DIFFER: `outerA`'s only reads, `outerB`'s writes the guarded field. So one name must
// answer two different declarations, and a cache keyed on the name alone answers the
// second query with the first body's summary.
//
// The pin is TWO-SIDED because the corpus oracle requires every diagnostic to be
// declared and every declared diagnostic to appear:
//   * the `o1` guard must SURVIVE — a resolver that over-invalidates reports an
//     undeclared second error here, which is the failure mode that killed the broad
//     rule (a read-only callee must not retire a narrowing);
//   * the `o2` guard must RETIRE — a resolver that answers `outerA`'s `h` for
//     `outerB`'s body reports no error at all, and the program then reads null.
type O = { v: string | null }

function outerA(o: O) {
  function h(q: O) { print(q.v ?? "x") }
  h(o)
}

function outerB(o: O) {
  function h(q: O) { q.v = null }
  h(o)
}

const o1: O = { v: "hi" }
if o1.v != null {
  outerA(o1)
  print(o1.v.length)
}

const o2: O = { v: "hi" }
if o2.v != null {
  outerB(o2)
  print(o2.v.length)
}
