// @run
// @log 5
// @log 6
// @log 7
// @log 1
// @log 4
// The annotated twin of D8620: the parameter names the literal's own record, so its row is
// the annotation's and a declared record boxing the field is never a candidate.
type J = { f: i32 | null }
type JG = { f: i32 | null, g: string }
type N = { r: i32 | null }
function rd(r: { f: i32 }) { return r.f + 1 }
function rd2(r: { f: i32, g: string }) { return r.f + r.g.length }
function take(a: { r: i32 }) { return a.r + 1 }
function guard(v: { r: i32 }) {
  if v is N {
    print(v.r ?? 0)
    return
  }
  print(0)
}
print(rd({ f: 4 }))
print(rd2({ f: 4, g: "ab" }))
print(take({ r: 6 }))
const o: N = { r: 1 }
print(o.r ?? 0)
guard({ r: 4 })
