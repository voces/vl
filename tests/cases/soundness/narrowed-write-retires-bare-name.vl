// @run
// @log 6
// @log 1
// @log 1
// @log 9
// @log true
// @log false
// @log true
// @log false
// @log 8
// @log 2
// @log 5
// CONTRACT (must-RUN): a write a narrowing does not admit is ACCEPTED, and it RETIRES
// the narrowing. What a place accepts is its STORAGE type; the narrowing is a flow fact
// about the value, and this write is the fact's end, not a type error.
//
// The `while` walk is the idiom the leaked target type killed outright: the loop
// condition IS the guard, so re-assigning the guarded binding inside the body is the
// only way to reach the chain's end. `q = step(q)` stores a NULLABLE and `r = null` the
// literal; both were "cannot assign i32? / null to i32". Every leg below is a `vl check`
// reject before this change, so the whole file is the acceptance pin.
//
// THE `?? ` READS AFTER EACH GUARDED BLOCK pin the value the retired binding holds. A
// compiler that accepted the write while leaving the binding narrowed for the rest of
// the FUNCTION prints the pre-write value where the log demands the default. (A read
// INSIDE the block is refused outright — `narrowed-write-retired-read-rejected.vl`.)
//
// A NON-NULL write KEEPS the narrowing: `v = 8` cannot falsify "v is not null", and
// retiring there would reject the read after it.
//
// EVERY GUARDED WRITE IS FOLLOWED BY A STATEMENT. An assignment is an expression, so a
// write in TAIL position of a `void` function returns its right-hand side and traps —
// on master too, with a non-null right-hand side and no narrowing involved. That is a
// separate pre-existing defect and this file stays out of its way.

function step(k: i32) {
  if k < 3 { return k + 1 }
  null
}

function mkb(k: i32) {
  if k > 0 { return true }
  null
}

// Walk a nullable chain to exhaustion — a nullable RHS, re-tested on every back edge.
function walk() {
  let acc = 0
  let q = step(0)
  while q != null {
    acc = acc + q
    q = step(q)
  }
  print(acc) // 6 = 1 + 2 + 3
}

// The same walk with a LITERAL null: exactly one iteration, then the guard is false.
function walkOnce() {
  let seen = 0
  let r = step(0)
  while r != null {
    seen = seen + 1
    r = null
  }
  print(seen) // 1
}

// The `if` spelling, with the retired binding read after the guarded block.
function ifWrite() {
  let s = step(0)
  if s != null {
    print(s) // 1
    s = null
  }
  print(s ?? 9) // 9
}

// A BOXED rep (`boolean | null` is an i32 sentinel) takes the same write.
function boxedRep() {
  let bb = mkb(1)
  if bb != null {
    print(bb && true) // true
    bb = null
  }
  print(bb ?? false) // false
}

// An `is T` guard narrows the same way and takes the same write.
function isGuard() {
  let u = mkb(1)
  if u is boolean {
    print(u && true) // true
    u = null
  }
  print(u ?? false) // false
}

// A write the narrowing ADMITS leaves it in force.
function nonNullWrite() {
  let v = step(0)
  if v != null {
    v = 8
    print(v) // 8 — still non-null after a write the narrowing admits
  }
}

// A write in a NESTED block retires for the statements after that block too: the
// retirement is written in place, never pushed, so the inner block's close cannot
// resurrect it.
function nestedWrite() {
  let w = step(1)
  const c = true
  if w != null {
    print(w) // 2
    if c { w = null }
  }
  print(w ?? 5) // 5
}

walk()
walkOnce()
ifWrite()
boxedRep()
isGuard()
nonNullWrite()
nestedWrite()
