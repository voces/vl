// D2602: testing an assignment narrows the name it stores into, as a test of the name would.
type A = { r: i32 }
function mkS(n: i32): string | null {
  if n == 0 { return null }
  "ab"
}
function mkI(n: i32): i32 | null {
  if n == 0 { return null }
  n
}
function mkU(n: i32): i32 | string | null {
  if n == 1 { return "s" }
  n
}
function mkA(n: i32): A | null {
  if n == 0 { return null }
  { r: n }
}
function go(n: i32) {
  let s = mkS(7)
  if s != null && (s = mkS(n)) != null { print(s.length) } else { print(-1) }
  let i = mkI(7)
  if (i = mkI(n)) == null { print(-1) } else { print(i + 1) }
  let a = mkA(7)
  if (a = mkA(n)) != null { print(a.r) } else { print(-1) }
  let u = mkU(7)
  if !((u = mkU(n)) is i32) { print(1) } else { print(u + 1) }
  if (i = mkI(n)) == null { return }
  print(i + 100)
}
go(0)
go(2)
