// @check
// @error 'm[1]' is no longer narrowed to string: the call to 'set' on line 8 may reassign it
// `m.set(1, null)` ends the non-null narrowing of `m[1]`, so the read after it is at
// `string | null` and the checker refuses the member access, rather than the program reading
// the removed value as a string.
function f(m: {[i32]: string | null}): i32 {
  if m[1] != null {
    m.set(1, null)
    return m[1].length
  }
  0
}
