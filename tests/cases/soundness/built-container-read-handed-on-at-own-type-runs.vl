// @run
// @log 40
// @log 12
// @log 40
// @log 12
// @log 40
// @log 4
// A container its stores build at `J` hands a value on at its own type: the record reads, the
// container itself and a `??` read with a literal default all run, instanced at `J` (D14739).
type J = { f: i32 | null }
function mk() { { f: 4 } }
function g(r: { f: i32 }) { r.f * 10 }
function h(o: { a: { f: i32 } }) { o.a.f * 3 }
function hs(o: { f: i32 }[]) { o[0].f * 3 }
const wideJ: J = mk()
const w = { a: mk() }
const xs = [mk()]
const m = Map()
m.set(1, mk())
print(g(w.a))
print(h(w))
print(g(xs[0]))
print(hs(xs))
print(g(m.get(1) ?? { f: 0 }))
print(wideJ.f ?? 0)
