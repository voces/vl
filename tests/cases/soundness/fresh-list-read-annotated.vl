// @run
// @log 0
// @hint redundant type annotation: `gp` is inferred as `Circle` — remove it to lean on inference
// D14507: an annotated read of a list element pins the element of the list it reads, so a list
// of literals stored into a `Map()` and read back out is built at the annotation's record.
type Circle = { r: i32 | null }
function rd() {
  const lv1 = [{ r: null }]
  const c = Map()
  c["k0"] = lv1
  const g1 = c["k0"] ?? []
  if g1.length > 0 {
    const gp: Circle = g1[0]
    if gp.r != null { print(7) } else { print(0) }
  } else {
    print(0)
  }
}
rd()
