// @run
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// THE ADOPTED READ WHERE **THREE** SOURCES DISAGREE — and the store's own ladder, asked at
// both ends of the box (silent-class-inventory D291, closed 2026-08-28; D209 is the row this
// is the residue of, and D271 / D272 / D290 are the refutation pins it must not move).
//
// D209 closed the case where the emitter's rep (a box the adoption produced) and the checker's
// type (a bare atom it never widened) disagree. Here a THIRD source joins: the field's declared
// member is WIDER than the checker's atom, so `emitUnionCoerce`'s promotion ladder widened the
// payload on the way IN — `{ r: 7 }` against `r: i64 | null` boxes tag 3 / `struct.new $vbI64`
// — while the checker still types the read `i32`. D209's predicate declined exactly here, on
// its third condition, and the decline was measured (`reach=1 ans=0`).
//
// THE CLOSE IS THE LADDER, NAMED. `unionStoreAtomKind(unionName, kind)` answers "the atom a
// value of this atom is ACTUALLY STORED as in this union", and both ends ask it: the coercion
// picks the tag with it, and the un-narrowed read casts the payload to it and NARROWS the
// result back to the atom the checker's consumers were typed against. Three rungs, and each
// was stripped and graded: without the read's narrowing the module traps or is invalid, and
// without the coercion's destination guard 64 running cells go loud.
//
// The programs are ordered by which rung they pin.

// 1 — D291's own repro. Was `vl check` rc 0 with no diagnostics and
// "type mismatch: expected i32, found (ref $type)" at run.
type C1 = { r1: i64 | null }
const lv1 = [{ r1: 7 }]
print((lv1[0]).r1)

// 2 — the f64 spelling, which is the same row: the store re-encodes 7 as an f64 payload and
// the read truncates it back. Same three lines, one token.
type C2 = { r2: f64 | null }
const lv2 = [{ r2: 7 }]
print((lv2[0]).r2)

// 3 — the widened read consumed by something that WANTS the box (D272's pin at the widened
// atom). The read narrows i64 -> i32 and the coercion RE-WIDENS it, because the destination
// union cannot hold i32 and the ladder that widened the store widens this too. Without the
// coercion's guard the box would be tagged i32 and `is i64` silently false.
type C3 = { r3: i64 | null }
const v3 = { r3: 7 }
const q3: i64 | null = (v3).r3
if q3 is i64 { print(q3) } else { print(0) }

// 4 — the second box-wanting consumer, which takes a DIFFERENT emitter path (an object-literal
// field store rather than a binding init), at the f64 atom.
type C4 = { r4: f64 | null }
type B4 = { s4: f64 | null }
const v4 = { r4: 7 }
const w4: B4 = { s4: (v4).r4 }
if w4.s4 is f64 { print(w4.s4) } else { print(0) }

// 5 — THE `runs but wrong value` HALF, which is the worse one. This LOADED and printed `0`:
// the store widened the payload to f64 and the union `==` compared it under the checker's i32
// arm, so the compare was silently false. No diagnostic, a valid module, a wrong answer.
type C5 = { r5: f64 | null }
const v5 = { r5: 7 }
if (v5).r5 == 7 { print(7) } else { print(0) }

// 6 — the widening also happens when the union's other arm is not `null`: `i64 | string` has
// no i32 member either, so the store takes the i64 arm.
type C6 = { r6: i64 | string }
const v6 = { r6: 7 }
print((v6).r6)

// 7 — D271's PIN at the widened atom, which must keep running: the destination three tokens
// later is what makes the adoption right, and nothing here READS the adopted field, so the
// predicate is not even reached (`reach=0`).
type C7 = { r7: i64 | null }
const lv7 = [{ r7: 7 }]
const c7: C7[] = lv7
print(c7.length + 6)

// 8 — THE ANNOTATED spelling of program 5, which is NOT the channel at all and is why the
// ladder had to be shared rather than the read taught. Here the binding IS annotated, so the
// checker honestly types the read `f64 | null` and no adoption asymmetry exists — and it still
// printed `0`, because `unionEqAtomOf` carried its OWN copy of the promotion ladder with only
// the i64 half of it. Two readers of one decision is the whole family's shape.
type C8 = { r8: f64 | null }
const v8: C8 = { r8: 7 }
if (v8).r8 == 7 { print(7) } else { print(0) }

// 9 — and the box really does hold the WIDE atom, which is why the read has to convert rather
// than the store having to narrow: through the declared destination the same field narrows
// `is i64` and prints as an i64.
type C9 = { r9: i64 | null }
const lv9 = [{ r9: 7 }]
const c9: C9[] = lv9
if (c9[0]).r9 is i64 { print(7) } else { print(0) }
