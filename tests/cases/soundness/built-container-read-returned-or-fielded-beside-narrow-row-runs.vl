// @run
// @log 5
// @log 4
// @log 4
// @log 4
// @log 4
// A function returning a read out of a built container, and a record literal's field holding one,
// are built at the container's record even where another value interns the narrow row; so is a
// binding of either, and the result handed to an annotated parameter read for fields (D15127).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const wideJ: J = mk()
const xs = [mk()]
const plain = { f: 5 }
print(plain.f)
function first() { return xs[0] }
const v = first()
print(v.f)
const w = { f: xs[0] }
const u = w.f
print(u.f)
function take(r: { f: i32 }) { r.f }
print(take(first()))
print(wideJ.f ?? 0)
