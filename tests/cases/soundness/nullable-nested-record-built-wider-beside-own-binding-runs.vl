// @run
// @log 4
// @log 5
// @log 4
// @log 7
// @log 8
// @log 4
// @log 4
// @log 4
// @hint Intentionally-unused variable `_k2`
// @hint Intentionally-unused variable `_a`
// A function's record result delivered to a record whose nested field is a nullable record, beside
// an own-type binding, is built at the wider record for both; the own binding reads it back (D15214).
type J = { f: i32 | null }
type K = { j: J | null }
type H = { f: i32 | null }
type J2 = { h: H | null }
type K2 = { j: J2 | null }
function mk() { { j: { f: 4 } } }
function mk2() { { j: { h: { f: 4 } } } }
const _k: K = mk()
const y = mk()
print(y.j.f)
print(y.j.f + 1)
print(_k.j?.f ?? 0)
y.j.f = 7
print(y.j.f)
if _k.j != null { _k.j.f = null }
print(_k.j?.f ?? 8)
const _k2: K2 = mk2()
const y2 = mk2()
print(y2.j.h.f)
const ks: K[] = [mk()]
print(ks[0].j?.f ?? 0)
function run() {
  const _a: K = mk()
  const b = mk()
  print(b.j.f)
}
run()
