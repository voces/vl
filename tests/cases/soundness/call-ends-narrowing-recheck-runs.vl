// D2390: a call that may run a closure assigning a captured, narrowed binding ends that
// narrowing, and the reads after it are at the declared type. Each function here is a shape
// the rule has to keep RUNNING: the filed witness read at the declared type, a re-test after
// the call, a call that cannot reach the writer keeping the narrowing, and the loop, guard,
// generic and module-scope placements of the same call.
// @run
// @log true
// @log now true
// @log 3
// @log 3
// @log f1.5,btrue,
// @log true
// @log true
// @log true1
// @log true1
// @log true
// @log true,true,
// @hint redundant type annotation: `ys` is inferred as `T[]`

// The filed witness: `k()` sets `v` to `true`, so `"\{v}"` renders the boolean.
function witness() {
  let v: boolean | f64 = 1.5
  const k = () => {
    v = true
  }
  if v is f64 { k(); "\{v}" } else { "no" }
}
print(witness())

// Re-testing after the call narrows again, per the value the call left.
function retest() {
  let v: boolean | f64 = 1.5
  const k = () => {
    v = true
  }
  if v is f64 {
    k()
    if v is f64 { "still \{v * 2.0}" } else { "now \{v}" }
  } else {
    "no"
  }
}
print(retest())

// `map` with a lambda that reaches no writer keeps the narrowing: `k` is only ever called by
// name, so a call that does not name it cannot run it.
function unrelated() {
  let v: boolean | f64 = 1.5
  const k = () => {
    v = true
  }
  const xs = [1, 2, 3]
  if v is f64 {
    const ys = xs.map((x) => x + 1)
    print(ys.length)
    return v * 2.0
  }
  k()
  0.0
}
print(unrelated())

// A loop re-runs the reads before the call, so the narrowing ends before the loop; the re-test
// inside it narrows per iteration.
function loop() {
  let v: boolean | f64 = 1.5
  const k = () => {
    v = true
  }
  let out = ""
  if v is f64 {
    let i = 0
    while i < 2 {
      if v is f64 { out = out + "f\{v}," } else { out = out + "b\{v}," }
      k()
      i = i + 1
    }
  }
  out
}
print(loop())

// A post-guard narrowing ends at the call the same way.
function postGuard() {
  let v: boolean | f64 = 1.5
  const k = () => {
    v = true
  }
  if !(v is f64) { return "no" }
  k()
  "\{v}"
}
print(postGuard())

// A function that calls the writer reaches it too.
function reacher() {
  let v: boolean | f64 = 1.5
  const k = () => {
    v = true
  }
  const g = () => {
    k()
  }
  if v is f64 {
    g()
    return "\{v}"
  }
  "no"
}
print(reacher())

// A generic instance whose rebuilt statement holds the call keeps its original's retirement.
function gen<T>(x: T) {
  let v: boolean | f64 = 1.5
  const k = () => {
    v = true
    1
  }
  if v is f64 {
    const ys: T[] = [x, x, x].slice(0, k())
    return "\{v}\{ys.length}"
  }
  "no"
}
print(gen(1))
print(gen("a"))

// Module scope.
let mv: boolean | f64 = 1.5
const mk = () => {
  mv = true
}
if mv is f64 {
  mk()
  print(mv)
}

// A loop whose condition calls the writer.
function whileCond() {
  let v: boolean | f64 = 1.5
  let n = 0
  const k = () => {
    v = true
    n = n + 1
    n < 3
  }
  let out = ""
  if v is f64 {
    while k() { out = out + "\{v}," }
  }
  out
}
print(whileCond())
