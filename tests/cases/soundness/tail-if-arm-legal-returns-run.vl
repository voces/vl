// @run
// @log 1
// @log 2.5
// @log 5000000000
// @log s
// @log 7
// @log none
// @log 1
// @log 9
// @log 2
// @log 0
// @log x
// @log 7
// @log a
// @log 6
// @log 10
// @log 4
// @hint redundant type annotation: `widenF` is inferred as `f64` — remove it to lean on inference
// @hint redundant type annotation: `widenL` is inferred as `i64` — remove it to lean on inference
// @hint redundant type annotation: `neverArm` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `emptyList` is inferred as `i32[]` — remove it to lean on inference
// @hint redundant type annotation: `matchF` is inferred as `f64` — remove it to lean on inference
// @hint redundant type annotation: `nested` is inferred as `i32` — remove it to lean on inference
// CONTRACT (runs, D2234): the arm-by-arm check a tail `if`/`else` or `match` now gets under a
// declared return is the check a bare tail expression gets, so every arm a direct tail would
// accept still runs: an integer literal adopting `f64` or `i64`, an arm that is one member of
// a union return, `null` into a nullable return, an arm that never returns, an arm that
// returns early, an empty list, an object literal picking a union arm, a literal-union member,
// a generic `T` arm, and an arm lambda that reads its parameter type from the declared return.
// The annotations are the subject, so the redundant-annotation hints are declared, not removed.
type A = { a: i32 }
type B = { b: string }
function widenF(n: i32): f64 {
  if n == 0 { 1 } else { 2.5 }
}
function widenL(n: i32): i64 {
  if n == 0 { 5000000000 } else { 2 }
}
function unionRet(n: i32): string | i32 {
  if n == 0 { "s" } else { 2 }
}
function nullRet(n: i32): i32 | null {
  if n == 0 { 7 } else { null }
}
function stop(): never { __trap__() }
function neverArm(n: i32): i32 {
  if n < 0 { stop() } else { 1 }
}
function earlyRet(n: i32): i32 {
  if n == 0 { return 9 }
  else if n == 1 { 2 }
  else { 3 }
}
function emptyList(n: i32): i32[] {
  if n == 0 { [] } else { [1, 2] }
}
function objArm(n: i32): A | B {
  if n == 0 { { a: 1 } } else { { b: "x" } }
}
function matchF(n: i32): f64 {
  match n {
    0 => 7
    _ => 2.5
  }
}
function litRet(n: i32): "a" | "b" {
  if n == 0 { "a" } else { "b" }
}
function gen<T>(n: i32, a: T, b: T): T {
  if n == 0 { a } else { b }
}
function lamArm(n: i32): (i32) => i32 {
  if n == 0 {
    (x) => x + 1
  } else {
    (x) => x * 2
  }
}
function nested(n: i32): i32 {
  if n > 0 {
    if n > 5 { 10 } else { 4 }
  } else {
    0
  }
}
print(widenF(0))
print(widenF(1))
print(widenL(0))
print(unionRet(0))
print(nullRet(0) ?? 0)
print(nullRet(1) ?? "none")
print(neverArm(1))
print(earlyRet(0))
print(earlyRet(1))
print(emptyList(0).length)
const o = objArm(1)
if o is B { print(o.b) }
print(matchF(0))
print(litRet(0))
print(gen(0, 6, 8))
print(nested(9))
print(lamArm(1)(2))
