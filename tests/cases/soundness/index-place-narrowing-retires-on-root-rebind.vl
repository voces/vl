// @check
// @error member access '.length' on non-object i32[] | null
// @hint redundant type annotation: `xs` is inferred as `(i32[] | null)[]`
// SOUNDNESS (must-error). Rebinding the ROOT falsifies every `xs[...]` narrowing under it.
//
// `writeRetiresNarrowing`'s prefix leg matched `tgtKey + "."` and nothing else, which was
// total while `.` was the only separator a key could contain. The moment `placeKeyOf` keys
// `xs[0]` (inventory-2 D11), `xs = [null]` stopped retiring anything and this program was
// CHECK-CLEAN with a `wasm trap: null reference` — one of three the census records as zero
// in 250,238 cells. The leg now speaks both separators, for the identical reason it spoke
// the first: the place holds a different object and nothing is known about what is in it.
function src(): i32[] | null { return [1, 2] }

function rootRebind() {
  let xs: (i32[] | null)[] = [src()]
  if xs[0] != null {
    xs = [null]
    print(xs[0].length)
  } else { print("NUL") }
}
rootRebind()
