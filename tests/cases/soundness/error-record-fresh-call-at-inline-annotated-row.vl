// @check
// @error {f: i32} is not I: they store field `f` differently (`i32` into `i32 | null`)
// D3430: a record a function with no declared result builds is built at the row of a record of
// its own field storage that an annotation spells inline, as at a declared `type`'s; called at
// two sites it is refused where it is delivered to a record that stores a field differently.
const i: { f: i32 } = { f: 4 }
type I = { f: i32 | null }
function mk() { { f: 7 } }
const b: I = mk()
const b2: I = mk()
print(b.f ?? 0)
print(b2.f ?? 0)
print(i.f)
