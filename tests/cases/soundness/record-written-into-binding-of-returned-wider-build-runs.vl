// @run
// @log 5
// @log 4
// @log 6
// @log 4
// A call the record solve builds at a wider record, returned by a function whose result a binding
// takes and then writes a record through, is copied back to its own record where it is returned,
// through a recursive return as well (D15266).
type J = { f: i32 | null }
type K = { j: J }
function mk() { { j: { f: 4 } } }
const _k: K = mk()
function deliver() { return mk() }
const v = deliver()
v.j = { f: 5 }
print(v.j.f)
print(_k.j.f ?? 0)
function down(n: i32) {
  if n > 0 { return down(n - 1) }
  return mk()
}
const w = down(2)
w.j = { f: 6 }
print(w.j.f)
function read() { return mk() }
print(read().j.f)
