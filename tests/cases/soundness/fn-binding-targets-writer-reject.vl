// @check
// @error-at 25:15 member access '.length' on non-object string | null — 'b.m' is no longer narrowed to string: the call to 'tally' on line 25 may reassign it; re-test 'b.m' after the call
// @error-at 36:15 member access '.length' on non-object string | null — 'b.m' is no longer narrowed to string: the call to 'hook' on line 36 may reassign it; re-test 'b.m' after the call
// @error-at 51:15 member access '.length' on non-object string | null — 'b.m' is no longer narrowed to string: the call to 'f' on line 51 may reassign it; re-test 'b.m' after the call

// D5017: a call through a binding is charged every function ever stored into it, so a writer
// installed through a setter, an alias of the setter, or a closure still ends the narrowing.
// Line and column are 0-based.

type Box = { m: string | null }

const shared: Box = { m: "abc" }
function countNone(_n: i32): i32 { 0 }
function clobber(n: i32): i32 {
  shared.m = null
  n
}

// Installed through a setter.
let counter: (n: i32) => i32 = countNone
function counterSet(f: (n: i32) => i32) { counter = f }
function tally(n: i32): i32 { counter(n) }
function show(b: Box): i32 {
  if b.m != null {
    const k = tally(1)
    return b.m.length + k
  }
  -1
}

// Installed through an alias of the setter, which hides the argument.
let hook: (n: i32) => i32 = countNone
function hookSet(f: (n: i32) => i32) { hook = f }
function showHook(b: Box): i32 {
  if b.m != null {
    const k = hook(1)
    return b.m.length + k
  }
  -1
}

// A local binding re-pointed inside a closure.
function showLocal(b: Box): i32 {
  let f: (n: i32) => i32 = countNone
  const re = (): i32 => {
    f = clobber
    0
  }
  re()
  if b.m != null {
    const k = f(1)
    return b.m.length + k
  }
  -1
}

counterSet(clobber)
const s = hookSet
s(clobber)
print(show(shared))
print(showHook(shared))
print(showLocal(shared))
