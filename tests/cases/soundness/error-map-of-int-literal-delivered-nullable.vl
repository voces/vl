// @check
// @error {[string]: 1} is not {[string]: 1 | null}: a container never widens implicitly
// @error {[string]: 1 | 2} is not {[string]: 1 | 2 | null}: a container never widens implicitly
// @error {[string]: 1} is not {[string]: i32 | null}: a container never widens implicitly
// D2713: a map of an integer literal, or a union of them, is stored as a map of `i32`, so it is
// refused where a map whose value adds `null` is wanted, as a map of `i32` is.
const m: {[string]: 1} = Map()
m["k"] = 1
const w: {[string]: 1 | null} = m
const n: {[string]: 1 | 2} = Map()
const v: {[string]: 1 | 2 | null} = n
const u: {[string]: i32 | null} = m
print(w.length + v.length + u.length)
