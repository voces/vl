// @run
// @log 1
// @log 6
// @hint Intentionally-unused parameter `_x`
// @hint Intentionally-unused parameter `_a`
// @hint Intentionally-unused parameter `_b`
// A call whose record another delivery builds wider, handed at its own type as a direct argument
// (D14817) or as a list element beside a held element (D14818, refused before as D14814), is
// copied where it lands and runs.
type Circle = { r: i32 | null }
type K = { r: null }
function sink(_x: Circle) {}
function mkcall() { { r: null } }
sink(mkcall())
function both<T>(_a: T, _b: T) { 1 }
function first<T>(xs: T[]): T { xs[0] }
const k: K = { r: null }
print(both(mkcall(), k))
print(first([mkcall(), k]).r ?? 6)
