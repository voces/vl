// @run
// @log 5
// @log 4
// @log 5
// @log 5
// @log 5
// @log 5
// @log 5
// D14512: a second call of a function built at a wider record serves every slot from that build.
type J = { f: i32 | null }
function mk() { { f: 4 } }
function g() {
  const c = mk()
  return c
}
const wideJ: J = mk()
const wideF = wideJ.f ?? 0
const c = mk()
const v = c
print(v.f + 1)
const t = v.f
print(t)
const xs = [mk()]
const e = xs[0]
print(e.f + 1)
const w = { g: mk() }
print(w.g.f + 1)
const m = Map()
m.set("k", mk())
const x = m.get("k")
if x != null { print(x.f + 1) }
print(g().f + 1)
print(wideF + 1)
