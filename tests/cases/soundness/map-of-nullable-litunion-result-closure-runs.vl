// A map whose value is a nullable function returning a literal union stores the function, built
// in place or arriving through a narrowed union parameter (D16315).
// unfiled: D16315
const m: {[string]: (() => "d" | "e") | null} = Map()
m["a"] = () => "e"
m["b"] = null
const f = m["a"] ?? null
if f != null { print(f()) }
print((m["b"] ?? null) == null)
m.delete("b")
print(m.length)
function useIt(p: {[string]: (() => "d" | "e") | null} | i32) {
  if p is {[string]: (() => "d" | "e") | null} {
    const g = p["k"] ?? null
    if g != null { print(g()) } else { print("none") }
  } else {
    print(p)
  }
}
const n: {[string]: (() => "d" | "e") | null} = Map()
n["k"] = () => "d"
useIt(n)
useIt(5)
useIt(Map())
