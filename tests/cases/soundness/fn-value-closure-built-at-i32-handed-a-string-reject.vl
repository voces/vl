// @emit-error emitProgram: a function value is called at two signatures, and the closure it holds was built for one: this call passes a string or a heap value to its `i32` parameter
// A record field holding an un-annotated function, read past its literal's length at `i32` and
// then at `string`, beside a list of another such record handed to an un-annotated parameter,
// keeps one closure built at `i32`; a string argument has no conversion into it (D15338).
function id1(a) { return a }
function id2(a) { return a }
const ts = [{ f: id1 }]
ts.push({ f: id2 })
function g(qs) { return qs[1].f(7) }
print(g(ts))
const rs = [{ g: { f: id1 } }]
print(rs[1].g.f(2))
print(rs[0].g.f("s"))
