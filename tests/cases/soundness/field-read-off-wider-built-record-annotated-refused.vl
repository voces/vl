// @check
// @error this field read holds a J, as the record it is read from is built wider than its own type
// A field read off a record built wider holds the field's stored record, so delivering it where its
// own type is declared would share one record as two layouts: refused (D15825).
type J = { f: i32 | null }
type K = { j: J }
function mk() { { j: { f: 4 } } }
const _k: K = mk()
const y = mk()
const w: { f: i32 } = y.j
print(w.f)
