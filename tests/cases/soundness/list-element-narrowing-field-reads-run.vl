// @run
// @log 1
// @log 1
// @log 0
// @log 1
// @log 1
// @log 0
// @log 3
// @log 6
// @log 7
// @log B
// @log A
// @log 2
// @hint redundant type annotation: `a` is inferred as `K`
// @hint redundant type annotation: `rd` is inferred as `i32`
// @hint redundant type annotation: `fresh` is inferred as `i32`
// @hint redundant type annotation: `take` is inferred as `string`
// @hint redundant type annotation: `s` is inferred as `K`
// @hint redundant type annotation: `t` is inferred as `K`
// @hint redundant type annotation: `u` is inferred as `K`
// @hint redundant type annotation: `v` is inferred as `K`
// @hint redundant type annotation: `z` is inferred as `S`
// A list field narrowed by `o.xs is K[]` reads its elements as `K`, keeps the narrowing across
// a store or push of a `K`, iterates and copies at `K`, and a store of a wider value retires it
// rather than being refused (D4957). A string field narrows the same way.
type K = 0 | 1
type S = "a" | "b"
type O = { xs: i32[] }
type T = { ss: string[] }
function rd(o: O): i32 {
  if (o.xs is K[]) {
    const a: K = o.xs[0]
    o.xs[0] = 5
    return a + o.xs[0]
  }
  -1
}
function fresh(o: O): i32 {
  if (o.xs is K[]) {
    o.xs = [7]
    return o.xs[0]
  }
  -1
}
function take(s: S): string {
  if s == "a" { "A" } else { "B" }
}
const o: O = { xs: [0, 1] }
if (o.xs is K[]) {
  const s: K = o.xs[1]
  print(s)
  o.xs[0] = 1
  const t: K = o.xs[0]
  print(t)
  o.xs.push(0)
  const u: K = o.xs[2]
  print(u)
  for x in o.xs {
    const v: K = x
    print(v)
  }
  const m: K[] = o.xs.map((x) => x)
  print(m.length)
}
print(rd({ xs: [1, 0] }))
print(fresh({ xs: [1, 0] }))
const t: T = { ss: ["a", "b"] }
if (t.ss is S[]) {
  print(take(t.ss[1]))
  const z: S = t.ss[0]
  print(take(z))
  const c: S[] = t.ss.map((x) => x)
  print(c.length)
}
