// @run
// @log 3
// @log 4
// @log 5
// @log 0
// D3468: a record-union field of a list element narrowed by `is A` through the index reads
// its field, at the top level, in an un-annotated list, inside a function, and in the else arm.
type A = { v: i32 }
type B = { s: string }
type W = { h: A | B }
const z: W[] = [{ h: { v: 3 } }]
if z[0].h is A { print(z[0].h.v) }
const q: W = { h: { v: 4 } }
const y = [q]
if y[0].h is A { print(y[0].h.v) }
function f(ws: W[]) {
  if ws[0].h is A { print(ws[0].h.v) }
  if ws[1].h is A { print(ws[1].h.v) } else { print(0) }
}
const b: W = { h: { s: "x" } }
f([{ h: { v: 5 } }, b])
