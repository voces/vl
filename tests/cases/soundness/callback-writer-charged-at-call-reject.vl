// @error-at 35:10 operator '+' is not defined for i32 | string and i32 — 'o.v' is no longer narrowed to i32: the call to 'viaMap' on line 35 may reassign it; re-test 'o.v' after the call
// @error-at 43:10 operator '+' is not defined for i32 | string and i32 — 'G.v' is no longer narrowed to i32: the call to 'call0' on line 43 may reassign it; re-test 'G.v' after the call
// @error-at 51:10 operator '+' is not defined for i32 | string and i32 — 'o.v' is no longer narrowed to i32: the call to 'mapIndexed' on line 51 may reassign it; re-test 'o.v' after the call
// @error-at 62:8 operator '+' is not defined for i32 | null and i32 — 'm["a"]' is no longer narrowed to i32: the call to 'call' on line 62 may reassign it; re-test 'm["a"]' after the call
// @error-at 68:8 operator '+' is not defined for i32 | string and i32 — 'G.v' is no longer narrowed to i32: the call to 'call1' on line 68 may reassign it; re-test 'G.v' after the call

// D2461, D2472, D2473: a call is charged what every function value it runs writes — one
// called inside a lambda handed to `map`, one with no argument, a std function reached by the
// method spelling, and one handed on at module scope. Line and column are 0-based.

import { mapIndexed } from "std:array"

type O = { v: i32 | string }
const G: O = { v: 1 }
function wf(x: O) { x.v = "s" }
function call1(x: O, f: (O) => void) { f(x) }
function viaMap(x: O, f: (O) => void) {
  const r = [x].map((y: O): i32 => {
    f(y)
    0
  })
  print(r.length)
}
function call0(f: () => void) { f() }
function wrG() { G.v = "s" }
function wrIx(x: O, i: i32) {
  x.v = "s"
  i
}

// A writer handed to a function that calls it inside a lambda given to `map`.
function inMap(o: O) {
  if o.v is i32 {
    viaMap(o, wf)
    print(o.v + 1)
  }
}

// A writer of a module binding, called with no argument.
function zeroArg() {
  if G.v is i32 {
    call0(wrG)
    print(G.v + 1)
  }
}

// A std function reached by the method spelling.
function stdMethod(o: O) {
  if o.v is i32 {
    print([o].mapIndexed(wrIx).length)
    print(o.v + 1)
  }
}

// A map-cell remover handed on at module scope.
const m: {[string]: i32} = Map()
m["a"] = 1
function del(k: string) { m.delete(k) }
function call(f: (string) => void) { f("a") }
if m["a"] != null {
  call(del)
  print(m["a"] + 1)
}

// A writer handed on at module scope.
if G.v is i32 {
  call1(G, wf)
  print(G.v + 1)
}
inMap(G)
zeroArg()
stdMethod(G)
