// THE TOTALITY GATE SEES A `null` ONE LEVEL DOWN — CLOSED.
//
// `U` is `i32 | (string | null)` through an alias, so it DOES admit `null` and the
// else-less fall-through is a legal `null` result. The gate rejected it anyway, and its
// message told the author to "annotate the return type `| null` to fall through" — advice
// already satisfied, one level in.
//
// IT WAS AN INCONSISTENCY, NOT A LANGUAGE DECISION, which is why it closed rather than
// waiting on a ruling. Three facts settled it:
//
//   1. The FLAT spelling of the same type (`i32 | string | null`) was already accepted AND
//      already ran correctly — measured, printing the value on the returning path and
//      falling through as null on the other.
//   2. The EMITTER half already recursed. `tyBearsNull` was repaired for exactly this
//      shape, and its header says so: "the arena keeps a union's members NESTED, so
//      `i32 | (string | null)` is `TyUnion[i32, TyNullable(string)]` and the `null` sits
//      one level DOWN".
//   3. So the two halves DISAGREED — the emitter was prepared to lower a fall-through the
//      checker refused. This gate was the last non-recursive reader of the question.
//
// The fix is to ask `tyBearsNull(ret)` instead of testing whether the return type's TOP
// NODE is a `TyNullable`. It admits exactly the spellings whose flat equivalent was
// already admitted, which is the bound that makes it a bug fix.
//
// THE NEGATIVE IS THE REAL TEST and it is pinned below: a return type with no `null`
// ANYWHERE — including a nested union of `string | boolean` — must still be refused, or
// the gate would have stopped doing its job rather than started doing it properly.
// @run
// @log 5
// @log absent
// @log absent
// @log 9

type N = string | null
type U = i32 | N

// The subject: no `else`, so the fall-through is a `null` result — legal, because `U`
// admits `null` through `N`.
function ga(c: boolean): U {
  if c { return 5 }
}

const v = ga(true)
if v is i32 {
  print(v) // 5
} else {
  print("absent")
}
const w = ga(false)
if w is i32 {
  print("WRONG") // absent
} else {
  print("absent")
}

// The OUTER-INLINE spelling of the same shape — the alias is only on the inner arm.
function gb(c: boolean): i32 | N {
  if c { return 7 }
}
const x = gb(false)
if x is i32 {
  print("WRONG") // absent
} else {
  print("absent")
}

// THE FLAT CONTROL, accepted before this change and unchanged by it. It is the reason the
// nested spelling was an inconsistency rather than a language question: same type, same
// behaviour, one spelling apart.
type F = i32 | string | null
function gc(c: boolean): F {
  if c { return 9 }
}
const y = gc(true)
if y is i32 {
  print(y) // 9
} else {
  print("absent")
}
