// @check
// @error cannot infer type parameter `T` in this call to `f`: its argument is `i32[] | K[]`
// A `K[]` shares an `i32[]`'s storage and is told apart by its elements' values, which `poke`
// changes while `f<K>` runs: the call is not split over the twins, so no `K` reads as 9.
type K = 1 | 2
const a: i32[] = [1, 2]
const q: i32[] | K[] = a
function poke() { a.push(9) }
function f<T>(xs: T[]): T {
  poke()
  return xs[xs.length - 1]
}
print(f(q))
