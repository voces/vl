// @run
// @log 0
// @log 0
// @log 2
// @log y
// @log 1
// A record arm's list-union field, read under the arm's narrowing and then its own list-arm
// `is`, reads the list out of the field's box (D4954): both list arms, the read delivered to
// a print, a binding, an index and an argument, the receiver annotated or a parameter.
type A = { kind: "a", items: f64[] | string[] }
type B = { kind: "b", n: i32 }
const e: f64[] = []
const u: A | B = { kind: "a", items: e }
if u is A {
  if u.items is string[] { print(u.items.length) }
  if u.items is f64[] { print(u.items.length) }
}
function count(ys: string[]) { ys.length }
function show(p: A | B) {
  if p is A {
    if p.items is string[] {
      const w = p.items
      print(count(w))
      print(p.items[1])
    }
  }
}
show({ kind: "a", items: ["x", "y"] })
const v: A | B = { kind: "a", items: [1.5] }
if v is A {
  if v.items is f64[] { print(v.items.length) }
}
