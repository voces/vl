// @run
// @log true
// @log 3
// @log false
// @log true
// @log 1
// @log true
// @hint redundant type annotation: `y` is inferred as `A | null`
// @hint redundant type annotation: `x` is inferred as `i32 | string`
// @hint redundant type annotation: `x` is inferred as `i32 | null`
// D2604. After an early-return guard the rest of the block reads the narrowed type, but a write
// is checked against the declaration: `y = null` and `y = mkA(0)` are accepted, the write
// re-narrows `y` to what it stored, and a null test of it is a real question again. The same
// holds after a `while` guard's `break` and an `is` guard's early return over a value union.
type A = { r: i32 }
function mkA(n: i32): A | null {
  if n == 0 { return null }
  { r: n }
}
function nullAfterReturn() {
  let y: A | null = mkA(6)
  if y == null { return }
  y = null
  print(y == null)
}
function otherAfterReturn() {
  let y: A | null = mkA(6)
  if y == null { return }
  y = { r: 3 }
  print(y.r)
  print(y == null)
  y = mkA(0)
  print(y == null)
}
function srcU(): i32 | string { return 4 }
function isAfterReturn() {
  let x: i32 | string = srcU()
  if x is string { return }
  x = "s"
  print(x.length)
}
function srcN(): i32 | null { return 4 }
function afterBreak() {
  let x: i32 | null = srcN()
  while true {
    if x == null { break }
    x = null
    print(x == null)
  }
}
nullAfterReturn()
otherAfterReturn()
isAfterReturn()
afterBreak()
