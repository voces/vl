// @run
// @log 15
// @log 14
// @log 13
// @log 16
// @hint redundant type annotation: `col` is inferred as `{r: i32, g: i32, b: i32}`
// D8020: a fresh call built at a wider record through a generic identity takes its own instance,
// apart from the identity's instance at the declared record that spells the call's fields.
// Sharing one instance was invalid wasm.
type Col = { r: i32, g: i32, b: i32 }
type J = { r: i32 | null, g: i32, b: i32 }
function idn<T>(v: T): T { v }
function mk() { { r: 15, g: 1, b: 2 } }
function mk2() { { r: 16, g: 1, b: 2 } }
function dl() { return idn(mk2()) }

const col: Col = idn({ r: 14, g: 1, b: 2 })
const m: J = idn(mk())
const c0: Col = { r: 13, g: 1, b: 2 }
const c1 = idn(c0)
const d: J = dl()
print(m.r ?? 0)
print(col.r)
print(c1.r)
print(d.r ?? 0)
