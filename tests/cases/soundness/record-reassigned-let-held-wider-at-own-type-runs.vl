// @run
// @log 1
// @log 4
// A maker called more than once keeps its own record; its call is copied where it lands wider.
// A reassigned fresh record `let` pushed into a list of a maker's calls, then written with a record
// of its own type, runs (D15374).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const wideJ: J = mk()
const xs = [mk()]
const os = [{ f: 1 }]
let r = { f: 6 }
xs.push(r)
r = os[0]
print(r.f ?? 0)
print(wideJ.f ?? 0)
