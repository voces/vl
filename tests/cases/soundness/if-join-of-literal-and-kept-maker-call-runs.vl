// @run
// @log 1
// @log 4
// @log 1
// @log 4
// @log 4
// @log 4
// A maker called more than once keeps its own record; its call is copied where it lands wider.
// A maker's call as an `if` or `match` arm beside a literal runs at its own type when an annotated
// binding also takes the maker wider, at any relay depth and inside a function (D15653).
type J = { f: i32 | null }
function mk2() { { f: 1 } }
function mk4() { mk2() }
const dA: J = mk2()
print(dA.f ?? 0)
const k = 1
const a = if k > 0 { { f: 4 } } else { mk2() }
print(a.f)
const b = if k > 0 { mk2() } else { { f: 4 } }
print(b.f)
const c = if k > 0 { { f: 4 } } else { mk4() }
print(c.f)
const d = match k {
  1 => { f: 4 }
  _ => mk2()
}
print(d.f)
function pick(n: i32) {
  if n > 0 { { f: 4 } } else { mk4() }
}
print(pick(k).f)
