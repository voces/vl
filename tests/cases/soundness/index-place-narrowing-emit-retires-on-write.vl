// @run
// @log null
// @log null
// @log null
// SOUNDNESS (must-RUN, and it is the must-RUN direction that makes it a soundness file).
// The EMITTER twin of `index-place-narrowing-retires-on-write.vl` next door, which pins the
// CHECKER's three retirement rules. This one pins that the emitter retires the same writes,
// and every program here printed `null` on the base compiler and TRAPPED on a candidate
// that had the narrowed READ without the retirement.
//
// WHY THE CHECKER'S FIXTURE CANNOT COVER THIS. Its three programs use `i32[] | null` cells
// and read `.length`, so the retired read is a member access on a union — which the checker
// REFUSES, loudly, and the emitter is never asked. Every cell whose declared rep the checker
// refuses to read hides the emit half completely, and that is every BOX rep: `print` has no
// lowering for `NtI32 | null`, so `print(xs[0])` after a retiring write is a check reject
// whether or not the emitter retired anything.
//
// A NICHE cell is the one that reaches the emitter. `string | null` HAS a `print` lowering —
// it renders `null` — so the checker types the read at the declared rep, says nothing, and
// the only thing standing between the program and `wasm trap: null reference` is whether the
// emitter's narrowing stack retired alongside the checker's overlay. It did not: the write
// arm keyed `tgt is Ident || tgt is Member` and an `xs[i] = v` target is neither.
//
// Three spellings, and they need two different rules — the same two the checker needed:
//
//   1. A write to the CELL (`ns[0] = nul()`) retires that key, gated on the RHS being
//      null-bearing, because a write the narrowing still admits must keep it (the
//      `ns[0] = "z"` case, pinned in objects/place-narrowed-array-element-emit.vl).
//   2. A VARIABLE subscript (`ns[i] = nul()`) names no cell and so retires the receiver's
//      whole family. `i` is a `const` only to keep the linter quiet: what makes the write
//      unkeyable is that the subscript NODE is an identifier rather than an integer literal,
//      which is the same test both stages apply (`intLitTextOf` / `intLitDigitsOf`), so
//      neither folds it.
//   3. A ROOT rebind (`ns = [nul()]`) replaces every cell and retires them UNCONDITIONALLY —
//      outside the null-bearing gate, because an array type is not itself nullable and the
//      gate would decline the very write that replaces a non-null cell with a null one.
function nul(): string | null { return null }

function cellWrite() {
  const ns: (string | null)[] = ["a"]
  if ns[0] != null {
    ns[0] = nul()
    print(ns[0])
  } else { print("NUL") }
}

function varIndexWrite() {
  const ns: (string | null)[] = ["a"]
  const i = 0
  if ns[0] != null {
    ns[i] = nul()
    print(ns[0])
  } else { print("NUL") }
}

function rootRebind() {
  let ns: (string | null)[] = ["a"]
  if ns[0] != null {
    ns = [nul()]
    print(ns[0])
  } else { print("NUL") }
}

cellWrite()
varIndexWrite()
rootRebind()
