// @run
// @log 5
// @log 5
// @log 4
// @log 4
// A maker called more than once keeps its own record; its call is copied where it lands wider.
// A read out of a container of a maker's calls, handed to a hole parameter that stores,
// captures or returns it, runs (D14811).
type J = { f: i32 | null }
function mk() { { f: 4 } }
function field(r) { const o = { a: r }; o.a.f + 1 }
function capture(r) { const c = () => r.f + 1; c() }
function back(r) { return r }
const wideJ: J = mk()
const xs = [mk()]
print(field(xs[0]))
print(capture(xs[0]))
print(back(xs[0]).f)
print(wideJ.f ?? 0)
