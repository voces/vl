// @run
// @log 6
// @log 4
// A maker called more than once keeps its own record; its call is copied where it lands wider.
// A list literal holding a read of a list of a maker's calls beside a part at its own storage
// runs (D15372).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const wideJ: J = mk()
const xs = [mk()]
const os = [{ f: 1 }]
const a = [...xs, ...os]
const o: { f: i32 } = { f: 2 }
const b = [xs[0], o]
function h(p: { f: i32 }) {
  const c = [xs[0], p]
  c.length
}
print(a.length + b.length + h({ f: 3 }))
print(wideJ.f ?? 0)
