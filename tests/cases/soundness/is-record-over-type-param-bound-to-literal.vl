// @run
// @hint redundant type annotation: `ret` is inferred as `i32`
// @log 15
// @log 15
// @log 7
// @log 0
// @log 15
// D8300: `is J` over a type parameter bound to a record literal tests value fit, so a literal
// whose flat field fits `J`'s nullable one is a `J`, whether the literal is an argument, a
// binding, or annotated. A literal with a field `J` lacks is not.
type J = { r: i32 | null, g: i32 }
function gd<T>(v: T) {
  if v is J { print(v.r ?? 0) } else { print(0) }
}
gd({ r: 15, g: 1 })
const o = { r: 15, g: 2 }
gd(o)
const a: J = { r: 7, g: 3 }
gd(a)
gd({ q: 1 })
function ret<T>(v: T): i32 {
  if v is J { return v.r ?? 0 }
  0
}
print(ret({ r: 15, g: 1 }))
