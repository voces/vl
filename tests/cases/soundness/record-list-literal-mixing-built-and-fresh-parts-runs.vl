// @run
// @log 7
// @log 7
// @log 7
// @log 7
// @log 4
// @log 7
// @log 4
// @log 7
// @log 4
// A list literal whose parts include one built at a wider record, a spread of such a list or an
// element of one, builds its fresh literal parts and spread literals there (D15371).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const wideJ: J = mk()
const xs = [mk()]
const ys = [[mk()]]
const a = [...ys, ...[[{ f: 7 }]]]
print(a[1][0].f ?? 0)
const b = [...xs, { f: 7 }]
print(b[1].f ?? 0)
const c = [ys[0], [{ f: 7 }]]
print(c[1][0].f ?? 0)
const d = [{ f: 7 }, ...xs]
print(d[0].f ?? 0)
const e = [...xs]
print(e[0].f ?? 0)
const g = [xs[0], { f: 7 }]
print(g[1].f ?? 0)
const h = [...ys]
print(h[0][0].f ?? 0)
function k() {
  const m = [...xs, ...[{ f: 7 }]]
  m[1].f ?? 0
}
print(k())
print(wideJ.f ?? 0)
