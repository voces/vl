// @run
// @log 4
// @hint Intentionally-unused variable `_k`
// A function's record result delivered beside an own-type binding at a record that stores its
// integer as a float behind `| null`, one record down: the call is copied there, converting the
// field, and the other call keeps its own row (D15247).
type J = { f: f64 | null }
type K = { j: J | null }
function mk() { { j: { f: 4 } } }
const y = mk()
const _k: K = mk()
print(y.j.f)
