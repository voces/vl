// @run
// @log 3
// @log 2.5
// @log true
// @log 9
// @log 4
// @log end
// A call that never returns, left of an operator beside a wider operand, nested inside another
// operator of that width: returned, bound, compared, an argument and an `i64` chain.
function fail(): never { __trap__() }
function show(x: f64) { print(x) }
function ret(c: boolean, x: f64) {
  if c { return x }
  return (fail() + x) * 2.0
}
function bound(c: boolean, x: f64) {
  if c { return x }
  const y: f64 = (fail() * x) - 1.0
  return y
}
function cmp(c: boolean, x: f32) {
  if c { return true }
  return (fail() + x) < 2.0
}
function arg(c: boolean, x: f64) {
  if c {
    show(x)
    return 0
  }
  show((fail() - x) / 3.0)
  return 1
}
function wide(c: boolean, x: i64) {
  if c { return x }
  return (fail() + x) * (2 as i64)
}
print(ret(true, 3.0))
print(bound(true, 2.5))
print(cmp(true, 1.0 as f32))
arg(true, 9.0)
print(wide(true, 4 as i64))
print("end")
