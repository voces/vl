// @check
// @error field 'b' is not on every member of A | B
// @error field 'd' is not on every member of B | C | D
// @error field 'c' is not on every member of B | C
// WHERE `elseif-chain-multistep.vl` STOPS, and the reason this side matters more than
// that side: the chain subtraction turns a loud reject into an accepted program, so an
// over-narrowing fix would trade a diagnostic for a wrong answer. Each function here is
// a chain arm that does NOT diverge, and each must keep its refusal.
//
// THE RULE BEING PINNED. A chain link hands its complement up only when its own then
// EXITS on every path, and the head applies the bank only when ITS then exits. Reaching
// the code below the chain through an arm that merely fell through means that arm's
// condition was TRUE there, so nothing below it was ruled out.
//
// `head` IS ALSO A REGRESSION PIN, not just a taste ruling. Before the fix an `else if`
// arm `declare`d its complement into whatever scope was open, and when the head's own
// condition narrowed nothing (`k > 0`) no scope had been pushed — so the arm's narrowing
// landed in the enclosing block and applied on the `k > 0` path too, where the guard
// never ran. That was check-clean and emitted invalid wasm; the scalar spelling of the
// same program answered `type mismatch: expected i32, found (ref $type)` from the engine,
// measured on `e2b5a1f7`. The checker now refuses it, which is what the two sides
// agreeing looks like.
type A = { a: i32 }
type B = { b: i32 }
type C = { c: i32 }
type D = { d: i32 }

// THE HEAD falls through. `k > 0` is not a narrowing condition, so nothing is subtracted
// for it — and because the head does not exit, the arm below it may not subtract either:
// `u` is still the whole `A | B` when `k > 0` took the first branch.
function head(u: A | B, k: i32): i32 {
  if k > 0 { print("t") }
  else if u is A { return u.a }
  return u.b
}
print(head({ a: 1 }, 1))

// A MIDDLE ARM falls through. The walk stops there: `B` comes off (the head exited), but
// `C` does not, because control can leave the chain through the `B` arm's own body. The
// residual is the CONSERVATIVE `B | C | D` rather than the exact `B | D` — the arm that
// falls through is not re-joined, it just ends the subtraction. Under-narrowing is a
// refusal; over-narrowing would be a cast through the wrong view.
function middle(u: A | B | C | D): i32 {
  if u is A { return u.a }
  else if u is B { print("mid") }
  else if u is C { return u.c }
  return u.d
}
print(middle({ d: 4 }))

// THE LAST ARM falls through, with nothing after it. Its own complement is never banked,
// so only the head's subtraction survives and `u` is `B | C` below the chain.
function tailArm(u: A | B | C): i32 {
  if u is A { return u.a }
  else if u is B { print("last") }
  return u.c
}
print(tailArm({ c: 3 }))
