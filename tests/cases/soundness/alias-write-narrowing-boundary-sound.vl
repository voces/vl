// @run
// @log 2
// @log 5
// @log 2
// @log 4
// CONTRACT (must-RUN): the soundness boundary of the aliased-write rule, pinned in the
// direction that a wider rule breaks. Every call below receives the guarded object and
// EVERY narrowing must survive it, because none of them can falsify the guard:
//
//   * a callee that only READS the field
//   * a callee that writes a DIFFERENT field of the same object
//   * a callee that only reads, RECURSIVELY (a cycle is answered at the least
//     fixpoint, not assumed to write — the strictly-fail-closed reading rejected this
//     shape for every field rep)
//   * an intrinsic (`print`) handed the object itself
//   * the mutating call placed AFTER the guarded read, where evaluation order makes
//     the read correct
//
// The BROAD rule — any call receiving the object retires every narrowing rooted at it —
// rejects the first four of these. It was measured and refused on exactly this file's
// shape: 94 of 106 correct grid cells and 2 corpus files, one of them blaming `print`.
type O = { v: string | null, w: i32 | null }

function rd(o: O) { if o.v != null { print(o.v.length) } else { print(0) } }
function clrW(o: O) { o.w = null }
function walk(o: O, n: i32) { if n > 0 { walk(o, n - 1) } }
function clrV(o: O) { o.v = null }

const o: O = { v: "hi", w: 5 }

if o.v != null {
  rd(o)              // reads only
  print(o.w ?? 0)    // 5
  clrW(o)            // writes a different field
  walk(o, 2)         // recursive, reads only
  print(o.v.length)  // 2 — still narrowed
}

const p: O = { v: "abcd", w: 1 }
if p.v != null {
  print(p.v.length)  // 4 — the read PRECEDES the write
  clrV(p)
}
