// @emit-error emitProgram: a function value is called at two signatures, and the closure it holds was built for one: this call reads an `i32` result from a wider one
// A list's record field holding an un-annotated function, read at two constant indices at two
// types beside another such list read at `f64`, keeps one closure built at `f64`; the `i32` read
// of it has no conversion from that result (D15338). Both reads at index 0 run.
function id1(a) { return a }
const xs = [{ f: id1 }]
print(xs[0].f(2))
print(xs[1].f(2.5))
const ys = [{ f: id1 }]
print(ys[0].f(2.5))
