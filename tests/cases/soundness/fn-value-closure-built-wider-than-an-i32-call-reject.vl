// @emit-error cannot take the generic function `id1` as a value — a function value carries ONE signature, and parameter `a` is un-annotated (it would default to i32). Call sites pin `id1` at (i32), (f64)
// A list's record field holding an un-annotated function, read at two constant indices at two
// types beside another such list read at `f64`: the `i32` read at index 0 calls `id1` directly,
// so the closures still built from it meet the value floor, which names both pins (D15338).
function id1(a) { return a }
const xs = [{ f: id1 }]
print(xs[0].f(2))
print(xs[1].f(2.5))
const ys = [{ f: id1 }]
print(ys[0].f(2.5))
