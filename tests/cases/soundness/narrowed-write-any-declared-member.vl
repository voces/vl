// @run
// @log 1
// @log 5
// @log 7
// @log 5
// @log s
// @log 5
// @log 5
// @log 1
// @log 6
// @log true
// @log true
// @log false
// @hint redundant type annotation: `x` is inferred as `i32 | string`
// @hint redundant type annotation: `y` is inferred as `A | null`
// The owner ruling of 2026-09-26 (DECISIONS.md, D2390): inside a narrowed block any write the
// DECLARED type admits is accepted, and it re-narrows the place to the written value's type for
// the rest of the flow, whatever function bodies were checked since the narrowing began. A
// loop that may make such a write ends the narrowing before it starts; a closure made under the
// narrowing is still called under it; a place re-narrows like a name.
function src(): i32 | string { return "s" }
type W = { f: i32 | string }
function afterLambda() {
  let x: i32 | string = src()
  if x is string {
    const ys = [1, 2].map((v) => v + x.length)
    print(x.length)
    x = 5
    print(x + ys[0] - 2)
  }
}
function beforeCall() {
  let x: i32 | string = src()
  if x is string {
    const k = () => x.length + 6
    print(k())
    x = 5
    print(x)
  }
}
function inLoop() {
  let x: i32 | string = src()
  if x is string {
    let i = 0
    while i < 2 {
      print(x)
      x = 5
      i = i + 1
    }
    print(x)
  }
}
function place() {
  const w: W = { f: "s" }
  if w.f is string {
    print(w.f.length)
    w.f = 5
    print(w.f + 1)
  }
}
type A = { r: i32 }
function mkA(n: i32): A | null {
  if n == 0 { return null }
  { r: n }
}
function nested() {
  let y: A | null = mkA(2)
  if y != null {
    if y.r > 0 {
      y = null
      print(y == null)
    }
    print(y == null)
  }
}
function closureTests() {
  let v: i32 | string = 1
  if v is i32 {
    const c = (): boolean => v is i32
    v = "s"
    print(c())
  }
}
afterLambda()
beforeCall()
inLoop()
place()
nested()
closureTests()
