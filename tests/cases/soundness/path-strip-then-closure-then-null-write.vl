// @run
// @log 5
// @log true
// @log true
// @log true
// @log true
// @log true
// @log true
// @log null
// @log true
// @log true
// @log null
// @hint Intentionally-unused variable `_c` (leading `_` marks it unused)
// D1848's strip is knowledge about the value, never the place's type. After `w.f = { r: 1 }`
// strips `null`, a closure made later does not change what the place may store: `w.f = null`
// is checked against the declared `A | null` and re-narrows. A nested function reads a stripped
// place at its declared type, so one that reads or writes it stays sound when called after.
type A = { r: i32 }
type W = { f: A | null }
const gw: W = { f: null }
gw.f = { r: 1 }
const gc = () => 5
gw.f = null
function field() {
  const w: W = { f: null }
  w.f = { r: 1 }
  const c = () => 5
  w.f = null
  print(c())
  print(w.f == null)
}
function cell() {
  const s: (A | null)[] = [null]
  s[0] = { r: 1 }
  const _c = () => 5
  s[0] = null
  print(s[0] == null)
}
function readsIt() {
  const w: W = { f: null }
  w.f = { r: 1 }
  const c = () => w.f == null
  w.f = null
  print(c())
}
function writesIt() {
  const s: (string | null)[] = [null]
  s[0] = "a"
  function c() { s[0] = null }
  c()
  print(s[0] == null)
}
function lambdaWrites() {
  const w: W = { f: null }
  w.f = { r: 1 }
  const c = () => {
    w.f = null
  }
  c()
  print(w.f == null)
}
function readsLater() {
  const w: W = { f: null }
  w.f = { r: 1 }
  const c = () => {
    const v = w.f
    if v != null { print(v.r) } else { print("null") }
  }
  w.f = null
  c()
}
function cellCallThenRead() {
  const s: (i32 | null)[] = [null]
  s[0] = 4
  const c = () => {
    s[0] = null
  }
  c()
  print(s[0] == null)
  print(s[0])
}
field()
cell()
readsIt()
writesIt()
lambdaWrites()
print(gw.f == null)
readsLater()
print(gc() == 5)
cellCallThenRead()
