// @check
// @error non-exhaustive `is`-chain falls through with no `else` — missing C (add the arm(s) or an `else`; expected i32)
// CONTRACT (must-error / guard): the INFERRED-return twin of
// exhaustive-is-chain-no-else-reject.vl. A non-exhaustive `is`-chain over a
// 3-variant union in a function with NO return annotation must STILL error —
// inference infers `i32` from the covered arms, but the `C` path falls off the
// end and the emitter writes `unreachable` there (a runtime trap). Refused with
// the same message the annotated case gives, so inference is not more permissive
// than an annotation.

type A = { a: i32 }
type B = { b: i32 }
type C = { c: i32 }
type ABC = A | B | C

function get(x: ABC) {
  if x is A { return x.a }
  else if x is B { return x.b }
}
