// @check
// @error-at 25:5 a {x: i32} cannot be delivered as {x: i32 | string} here
// @error-at 31:6 a {x: i32} cannot be delivered as {x: i32 | null} here
// @error-at 36:5 a {inner: {x: i32}} cannot be delivered as {inner: {x: i32 | string}} here
// @error-at 46:6 a {c: {r: i32}} cannot be delivered as {c: Circle | null} here
// @error-at 53:5 a {x: i32}[] cannot be delivered as {x: i32 | string}[] here
// @error-at 57:32 a {x: i32} cannot be delivered as {x: i32 | string} here
// @error-at 62:60 a {x: i32} cannot be delivered as {x: i32 | string} here
// @error-at 70:5 cannot be bound here to a type parameter whose bound declares a wider field
// @error-at 76:0 a {x: i32} cannot be delivered as W here
// @error-at 81:32 a {x: i32} cannot be delivered as {x: i32 | string} here
// @error-at 88:12 a {x: i32} cannot be delivered as JW here
// @error-at 95:16 a {x: i32} cannot be delivered as {x: i32 | f64} here
// @error-at 104:16 a {x: i32}[] cannot be delivered as {x: i32 | string}[] here
// @error-at 113:8 a {x: i32}[] cannot be delivered as {x: i32 | string}[] here
// @error-at 122:6 a {x: i32}[] cannot be delivered as {x: i32 | string}[] here
// D2060 — a record delivered where a record with a WIDER field is declared shares the source,
// so a store through the wider handle would put a string, a `null` or another union member in
// a field the source still types narrower. The delivery is legal only where nothing it reaches
// writes a widened field, and each delivery below is refused at the delivery, naming the write.
type Circle = { r: i32 }

// argument: the callee writes the widened field
function setS(p: { x: i32 | string }) { p.x = "s" }
const a = { x: 1 }
setS(a)

// the write is one call further in
function clear(p: { x: i32 | null }) { p.x = null }
function relay(p: { x: i32 | null }) { clear(p) }
const b = { x: 2 }
relay(b)

// a nested record: the widened slot is `inner.x`
function deep(p: { inner: { x: i32 | string } }) { p.inner.x = "s" }
const c = { inner: { x: 3 } }
deep(c)

// a record field that is a struct, widened to `| null`, written inside a closure
function later(p: { c: Circle | null }) {
  const k = () => {
    p.c = null
  }
  k()
}
const d = { c: { r: 4 } }
later(d)

// a list of records: the element's field is written through a loop variable
function each(ps: { x: i32 | string }[]) {
  for e in ps { e.x = "s" }
}
const e = [{ x: 5 }]
each(e)

// a binding alias, written through a local alias of the alias
const f = { x: 6 }
const fw: { x: i32 | string } = f
const fw2 = fw
fw2.x = "s"

// a return widens, and the caller writes the result
function widen(v: { x: i32 }): { x: i32 | string } { return v }
const g = { x: 7 }
const gw = widen(g)
gw.x = "s"

// a type parameter bounded by the wider field
function setB<T: { x: i32 | string }>(t: T) { t.x = "s" }
const h = { x: 8 }
setB(h)

// a `self`-function
type W = { x: i32 | string }
function clobber(self: W) { self.x = "s" }
const i = { x: 9 }
i.clobber()

// a generic write whose value type is a type variable
function setG<T>(p: { x: T }, v: T) { p.x = v }
const l = { x: 12 }
const lw: { x: i32 | string } = l
setG(lw, "s")

// a join: a list literal takes the wider sibling's type, and a write goes through it
type JW = { x: i32 | string }
const jq = { x: 13 }
const jw: JW = { x: "a" }
const js = [jq, jw]
js[0].x = "s"

// a join through two returns of a function whose result type is inferred
const rq = { x: 14 }
const rw: { x: i32 | f64 } = { x: 2.5 }
function pickR(c: boolean) {
  if c { return rq }
  return rw
}
pickR(true).x = 7.5

// a spread operand's elements join a literal whose element type is wider
const sa = { x: 15 }
const sxs = [sa]
const sw: { x: i32 | string } = { x: "w" }
const sws = [...sxs, sw]
sws[0].x = "s"

// the elements come back out of a list method, and a callback writes one
function firstOf(ps: { x: i32 | string }[]) {
  const ys = ps.filter((e) => true)
  ys[0].x = "s"
}
const j = [{ x: 10 }]
firstOf(j)
function each2(ps: { x: i32 | string }[]) {
  const n = ps.map((e) => {
    e.x = "s"
    0
  })
  print(n.length)
}
const k = [{ x: 11 }]
each2(k)

print(
  a.x + b.x + c.inner.x + d.c.r + e[0].x + f.x + g.x + h.x + i.x + j[0].x + k[0].x,
)
