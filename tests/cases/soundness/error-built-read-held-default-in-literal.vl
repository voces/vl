// @check
// @error-at 12:12 a `??` whose default is a binding, built at J for a read of a container built wider, is not yet supported inside a list or record literal
// VERDICT PIN (must-error): a `??` default held in a binding is built at the read's record by
// adopting the binding, and a literal slot holding the join has no build that meets it, so it is
// refused at check rather than built invalid (D15313).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const m = Map()
m.set("a", mk())
const wm: {[string]: J} = Map()
wm.set("a", mk())
const dl = { f: 1 }
const xs = [m.get("a") ?? dl]
print(xs[0].f ?? 0)
