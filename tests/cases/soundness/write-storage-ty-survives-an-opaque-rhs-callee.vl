// @run
// @log 1
// @log 1
// WHAT A PLACE ACCEPTS IS ITS STORAGE TYPE — even when the right-hand side of the very
// assignment retired the narrowing on the way in.
//
// WHAT THIS PINS (inventory #2 D8, its SECOND half). `lt` is read off the assignment
// TARGET before the right-hand side is checked, so it is the NARROWED type. The RHS is then
// checked, and a callee whose write-effect summary is opaque marks the path through
// `noteCallInvalidations`. `writeStorageTy` — asked afterwards — saw `npInvBy[slot] >= 0`
// and declined, leaving `asgLt` at a narrowed type the storage never had:
//
//     [ERROR]: cannot assign {[string]: i32} | null to {[string]: i32}
//
// which is the message inventory #2's D8 filed, and read as flat across 23 of 23 reps.
// IT IS NOT A REP AXIS. Both halves below are the same `{[string]: i32}` field; the only
// thing that differs is the CALLEE'S BODY — `viaIndexWrite` assigns through an index and was
// accepted, `viaMethodCall` calls a method and was rejected. The grid saw it only on Sets
// because a Set can only be built with `.add`, which is a method call.
//
// A retired narrowing is also the case where answering is most obviously right: the place
// reads at its declared type from here on, so the declared type is what the write is
// against either way.
//
// THE ATTRIBUTION IS THE SECOND HALF. `npInvBy` records WHICH node retired the path, and
// `retireNarrowingsForWrite` used to skip a slot a call had already claimed — so the read
// below was reported as "the call to 'viaMethodCall' … can write it" when the assignment on
// the line above is what replaced the field. The write's attribution now wins, because the
// emitter retires that write and can therefore be trusted with the read.
type W = { f: {[string]: i32} | null }

function seed(): {[string]: i32} {
  const m = Map()
  m["a"] = 1
  return m
}
function viaIndexWrite(): {[string]: i32} | null {
  const m = Map()
  m["a"] = 1
  return m
}
function viaMethodCall(): {[string]: i32} | null {
  const m = Map()
  m.set("a", 1)
  return m
}

function idx() {
  const w: W = { f: seed() }
  if w.f != null {
    w.f = viaIndexWrite()
    if w.f != null { print(w.f.length) } else { print("NUL2") }
  } else { print("NUL") }
}
function meth() {
  const w: W = { f: seed() }
  if w.f != null {
    w.f = viaMethodCall()
    if w.f != null { print(w.f.length) } else { print("NUL2") }
  } else { print("NUL") }
}

idx()
meth()
