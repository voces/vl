// @run
// @log -1
// @log -1
// @log -1
// @log 1
// @log 1
// @log -1
// @log 3
// @log 7
// @log -1
// @log 1
// @log -2
// @log 1
// @log -1
// @log 1
// @log -1
// @log 2
// @log 1
// @log -1
// @hint Intentionally-unused parameter
// A narrowing an assignment makes does not refuse a later write, so a function body that may run
// after a write that may store `null` reads the binding at its declared type: a top-level
// function or a module-level closure over a module `let` something may null, and a closure over a
// local nulled after it captured it (D2529). With no such write the narrowing is kept.
let a: i32 | null = null
a = 1
function readA() { return a }
a = null
print(readA() ?? -1)

let b: i32 | null = null
b = 1
const readB = () => b
b = null
print(readB() ?? -1)

let c: i32 | null = null
c = 1
function outerC() {
  function innerC() { return c }
  return innerC()
}
c = null
print(outerC() ?? -1)

let d: i32 | null = null
d = 1
const readD = () => {
  return d
}
print(readD())

let e: i32 | null = null
e = 1
function readE() { return e }
print(readE() ?? -1)
e = null
print(readE() ?? -1)

let g: i32 | null = null
g = 1
const ys = [1, 2].map((x: i32) => x + (g ?? 0))
print(ys[1])

const k: i32 | null = 7
function readK() { return k ?? -1 }
print(readK())

function localAfter() {
  let v: i32 | null = null
  v = 1
  function h() { return v }
  v = null
  print(h() ?? -1)
}
localAfter()

function localCallThenWrite() {
  let v: i32 | null = null
  v = 1
  const h = () => v
  print(h() ?? -1)
  v = null
  print(v ?? -2)
}
localCallThenWrite()

function localLoop() {
  let v: i32 | null = null
  v = 1
  let i = 0
  while i < 2 {
    const h = () => v
    print(h() ?? -1)
    v = null
    i = i + 1
  }
}
localLoop()

function localWriter() {
  let v: i32 | null = null
  v = 1
  const w = () => {
    v = null
  }
  const h = () => v
  print(h() ?? -1)
  w()
  print(h() ?? -1)
}
localWriter()

function localBefore() {
  let v: i32 | null = null
  v = 1
  const h = () => v
  print(h() + 1)
}
localBefore()

let gw: i32 | null = null
gw = 1
function genW<T>(_x: T) { return gw }
print(genW(0) ?? -1)
gw = null
print(genW(0) ?? -1)
