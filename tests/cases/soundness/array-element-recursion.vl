// @run
// @log 1
// @log 10
// CONTRACT (must-not-error, ROADMAP A11): a `type` that recurses THROUGH an
// ARRAY element type compiles and runs. `Tree` references itself through the
// element type of its `kids` array. Recursion through a *nullable struct field*
// already worked (the rec-group ties the self-reference, see
// recursive-type-build-traverse.vl); this pins the array-element back-edge,
// which previously overflowed the stack at codegen ("Maximum call stack size
// exceeded").
//
// The element struct, its list `{backing,len,cap}` wrapper, and the backing
// array are built in ONE WasmGC rec group, so the self-reference is a forward
// reference rather than an unbounded re-entry. An empty `kids` array is the
// recursion base case (a leaf); traversal walks the array, recursing into each
// child.
//
// `kids` is spelled `Tree[]`. It used to be spelled `{ [i32]: Tree }` on the
// claim that the index-signature form was "equivalent to `Tree[]`", and that is
// what parked this case as an `xfail`: the checker rejected the i32 key
// ("unknown type '{[i32]:Tree}'"), so it never reached the emitter and could not
// produce its `@log` lines. B6a's i32-keyed `Map` retires that reading —
// `{[i32]: V}` is a hash map, not an array — so the array contract is spelled
// with the array type, and it holds.
type Tree = { value: i32, kids: Tree[] }

function total(t: Tree): i32 {
  let sum = t.value
  let i = 0
  while i < t.kids.length {
    sum = sum + total(t.kids[i])
    i = i + 1
  }
  return sum
}

// A leaf — an empty `kids` array, so just its own value.
const leaf: Tree = { value: 1, kids: [] }
print(total(leaf))               // 1

// 2 + 3 + 5 = 10 — a root with two children, both leaves.
const t: Tree = {
  value: 2,
  kids: [
    { value: 3, kids: [] },
    { value: 5, kids: [] },
  ],
}
print(total(t))                  // 10
