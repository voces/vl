// @check
// @error 'v.value' was narrowed by a guard outside this loop, and the call to 'mutate' can write it, so the read on line 16
// @error 'v.value' was narrowed by a guard outside this loop, and the call to 'mutate' can write it, so the read on line 27
// @error 'xs[0]' was narrowed by a guard outside this loop, and the call to 'clrCell' can write it, so the read on line 38
// A call in a loop that may write a path narrowed outside the loop is refused when the loop
// read the path under that narrowing before the call, since the read runs again after it on the
// next iteration. A re-test inside the loop is the fix, and runs (D2403).
type W = { value: f64 | boolean }
function mutate(w: W) { w.value = true }
function clrCell(xs: (f64 | boolean)[]) { xs[0] = true }
function whileLoop(v: W): f64 {
  let t = 0.0
  if v.value is f64 {
    let i = 0
    while i < 2 {
      t = t + (v.value as f64)
      mutate(v)
      i = i + 1
    }
  }
  t
}
function forIn(v: W): f64 {
  let t = 0.0
  if v.value is f64 {
    for x in [1, 2] {
      t = t + (v.value as f64)
      mutate(v)
    }
  }
  t
}
function cell(xs: (f64 | boolean)[]): f64 {
  let t = 0.0
  if xs[0] is f64 {
    let i = 0
    while i < 2 {
      t = t + (xs[0] as f64)
      clrCell(xs)
      i = i + 1
    }
  }
  t
}
print(whileLoop({ value: 1.5 }))
print(forIn({ value: 1.5 }))
print(cell([1.5]))
