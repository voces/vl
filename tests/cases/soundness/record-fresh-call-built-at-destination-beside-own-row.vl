// @run
// @hint redundant type annotation: `i` is inferred as `{f: i32}`
// @log 0.5
// @log 4
// @log 4
// @log 7
// @log 7
// @log 3
// @log 4
// A function with no declared result called once, returning only object literals, builds them
// at its call's destination even where a record of their own fields is declared, by a `type` or
// inline: D2437, D3349 (a `push`), D3351 (an `if` arm), D3430, D2917 (a list element).
type Q = { k: i32[] }
type R = { k: f64[] }
function mk1() { return { k: [1, 2] } }
const v: R = mk1()
print(v.k[1] / 4.0)

type I = { f: i32 }
type J = { f: i32 | null }
function mk2() { { f: 4 } }
const xs: J[] = []
xs.push(mk2())
print(xs[0].f ?? 70)

function mk3() { { f: 4 } }
const c = true
const x: J = if c { mk3() } else { { f: 9 } }
print(x.f ?? 70)

const i: { f: i32 } = { f: 4 }
type K = { f: i64 | null }
function mk4() { { f: 7 } }
const b: K = mk4()
print(b.f ?? 0)

function mk5() { { f: 7 } }
const il = [mk5(), { f: 3 }]
const ic: K[] = il
print(ic[0].f)
print(ic[1].f)
print(i.f)
