// @run
// @log 7
// @log 0
// @hint Intentionally-unused parameter `_b`
// D15181: a fresh call in a list literal handed to a generic instanced at a wider record, where a
// declared type spells the call's own shape, is built at the instance's record.
type Circle = { r: i32 | null }
type K = { r: null }
function mkcall() { { r: null } }
const cw: Circle = { r: 3 }
function first<T>(_b: T, a: T[]): T { a[0] }
print(first(cw, [mkcall()]).r ?? 7)
const k: K = { r: null }
print(k.r ?? 0)
