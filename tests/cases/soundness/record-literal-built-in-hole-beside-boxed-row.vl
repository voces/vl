// @run
// @log 4
// @log 7
// @log 0
// D8682: a record literal built inside a hole's instance from the hole keeps its own storage
// when a declared record of its field names boxes that field, read through a binding and
// returned.
type A = { d: i32 | null }
function g(x) {
  const v = { d: x }
  print(v.d + 1)
}
g(3)
function h(x) {
  const v = { d: x }
  return v.d + 1
}
print(h(6))
const keepA: A = { d: null }
print(keepA.d ?? 0)
