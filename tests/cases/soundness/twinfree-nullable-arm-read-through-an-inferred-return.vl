// @run
// @log 0
// @hint redundant type annotation: `useShape` is inferred as `i32`
// @hint redundant type annotation: `sqv` is inferred as `{s: i32}`
// @hint Intentionally-unused variable `_sp1`
// @hint Intentionally-unused variable `_sp2`
// GRADUATED FROM THE SPECIMEN SLOT (silent-class-inventory D300). This is verbatim the
// program `tests/vl_check_codegen_test.ts`'s `INVALID_MODULE_SRC` carried between #1986 and
// its close, and the previous file that held it was
// `tests/cases/soundness/xfail-miscompile-twinfree-nullable-arm-read.vl`, `@no-instantiate`.
// It is kept whole rather than minimised: the minimal forms live beside it in
// `tests/cases/maps/`, and what makes THIS spelling worth freezing is that a census of every
// inventory row picked it as the class's only live member.
//
// THE MECHANISM. A map struct's identity is exactly `(keys wrapper, vals wrapper)` — the
// other five of its seven fields are constant across every one the emitter writes — so two
// map-value slots that interned the SAME vals ref-list slot emit byte-identical map structs
// and must share one heap type. `repMapValSlotsTwin` gated that on the value type's
// CANONICAL KEY, which is a TYPE identity: `{r: null}` (what the un-annotated `Map()` inside
// `mkcall` infers at its first key write) and the declared `Circle` resolve one struct row,
// one ref-list slot and one wrapper, and differ in `canon` alone. Two map structs were minted
// for one map, `mkcall`'s result came back `(ref $20)`, and the field's `struct.new` wanted
// `(ref $19)`: `vl check` rc 0 with four HINTs and no errors, then *type mismatch: expected
// (ref $type), found (ref $type)* out of the engine.
//
// `Box1`/`Box2` and the `Shape` union are the census coordinate's own padding, not
// ingredients — the whole thing reduces to `mkcall()` into a declared `{[string]: Circle}`
// field, which is `tests/cases/maps/map-value-twin-through-an-inferred-return.vl`'s shape.
// The `0` is the right answer: `r` is `null`, so the `!=` is false.
type Circle = { r: i32 | null }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = {[string]: Circle}
type Box2 = {[string]: Circle}
type GW = { g: {[string]: Circle} }
function useShape(s: Shape): i32 { if s is Sq { return 1 } return 0 }
const sqv: Sq = { s: 1 }
const _sp1: Box1 = Map()
const _sp2: Box2 = Map()
function mkcall() {
  const cc = Map()
  cc["k0"] = { r: null }
  return cc
}
function outer() {
  const lam = () => {
    const wv: GW = { g: mkcall() }
    if useShape(sqv) > 99 { print(0) }
    const g0 = (wv.g)["k0"] ?? { r: null }
    if (g0).r != null { print(7) } else { print(0) }
  }
  lam()
}
outer()
