// @check
// @error-at 10:17 {f: i32} is not J: they store field `f` differently
// @error-at 11:19 {f: i32} is not K: they store field `f` differently
// VERDICT PIN (must-error), no `@log` form: the diagnostic IS the observable.
// A call that an inferred function hands back lands where that function's call is delivered;
// here that is a record storing `f` differently from its sibling's, so one build cannot serve
// both and each landing refuses, as D8301 does for two direct calls (D14516).
type J = { f: i32 | null }
type K = { f: i64 | null }
function mk() { { f: 4 } }
const wideJ: J = mk()
function relay() { mk() }
const v: K = relay()
print(wideJ.f ?? 0)
print(v.f ?? 0)
