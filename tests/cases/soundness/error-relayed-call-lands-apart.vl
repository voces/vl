// @check
// @error-at 9:19 {f: i32} is not K: they store field `f` differently
// VERDICT PIN (must-error), no `@log` form: the diagnostic IS the observable.
// A call that an inferred function hands back lands where that function's call is delivered;
// no copy converts `i32` into `i64 | null`, so that landing refuses (D14516).
type J = { f: i32 | null }
type K = { f: i64 | null }
function mk() { { f: 4 } }
const wideJ: J = mk()
function relay() { mk() }
const v: K = relay()
print(wideJ.f ?? 0)
print(v.f ?? 0)
