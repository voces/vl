// @run
// @log true
// @log true
// @log true
// @log false
// @hint redundant type annotation: `h` is inferred as `Circle[]`
// D14223: a function returning a list literal of two record shapes, bare, through an alias of
// its binding, or from both arms of an `if`, is built at the record list its one call
// delivers it to.
type Cir2 = { c2: i32 }
type Sq2 = { s2: i32 }
type Shape2 = Cir2 | Sq2
type Circle = { r: Shape2 }

function bare() { [{ r: { c2: 1 } }, { r: { s2: 5 } }] }
const g: Circle[] = bare()
print(g[1].r is Sq2)

function aliased() {
  const t = [{ r: { c2: 1 } }, { r: { s2: 5 } }]
  const u = t
  u
}
const h: Circle[] = aliased()
print(h[1].r is Sq2)

function arms(b: boolean) {
  if b { [{ r: { c2: 1 } }, { r: { s2: 5 } }] } else { [{ r: { s2: 2 } }] }
}
const k: Circle[] = arms(true)
print(k[1].r is Sq2)
print(k[0].r is Sq2)
