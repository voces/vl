// @run
// @log 4
// `push` on an un-annotated parameter does not end the narrowing: the body is checked again at the
// call's argument types, which decide, and a push appends rather than replacing a cell.
function g(xs) {
  if xs[0] is i32 {
    xs.push("s")
    return xs[0] + 1
  }
  0
}
const xs: (string | i32)[] = [3]
print(g(xs))
