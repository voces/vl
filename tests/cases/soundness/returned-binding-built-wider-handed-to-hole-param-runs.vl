// @run
// @log 4
// @log 7
// @log 4
// @log 4
// @log 5
// @log 4
// @log 4
// D14741: a call returning a binding of a call built at a wider record, handed to a hole
// parameter, is stored there at that build.
type II = { f: i32 }
type J = { f: i32 | null }
function mk() { { f: 4 } }
function id<T>(x: T): T { x }
function r() {
  const k = mk()
  return k
}
function r2() {
  const k = id(mk())
  const k2 = k
  return k2
}
function u(a) { a.f }
function w(a) {
  a.f = 7
  a.f
}
function b(a) {
  const c = a
  c.f
}
function g<T>(a: T): T { a }
const d: J = mk()
print(u(r()))
print(w(r()))
print(b(r2()))
print(g(r2()).f)
print(u(r()) + u({ f: 1 }))
print(u(r2()))
print(d.f ?? 0)
