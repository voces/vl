// @run
// @log 1
// D14506: a chain of ten `Map()` bindings, stored by index and by `.set`, settles in one
// literal round, each inner map built at the declared map's record.
type Circle = { r: i32 | null }
type M1 = {[string]: Circle}
type M2 = {[string]: M1}
type M3 = {[string]: M2}
type M4 = {[string]: M3}
type M5 = {[string]: M4}
type M6 = {[string]: M5}
type M7 = {[string]: M6}
type M8 = {[string]: M7}
type M9 = {[string]: M8}
type M10 = {[string]: M9}
function mkc(): M10 {
  const l1 = Map()
  l1.set("k", { r: null })
  const l2 = Map()
  l2.set("k", l1)
  const l3 = Map()
  l3["k"] = l2
  const l4 = Map()
  l4.set("k", l3)
  const l5 = Map()
  l5["k"] = l4
  const l6 = Map()
  l6.set("k", l5)
  const l7 = Map()
  l7["k"] = l6
  const l8 = Map()
  l8.set("k", l7)
  const l9 = Map()
  l9["k"] = l8
  const l10 = Map()
  l10.set("k", l9)
  return l10
}
const c = mkc()
print(c.length)
