// @run
// @log 1
// @log 1
// @log 4
// @log 1
// @log 1
// @log 9
// @log 2
// @log a
// @log 2.5
// @log 1.5
// @log 4
// A call's fresh record as a list literal part beside a part built at a wider record is copied
// into that record, each scalar field boxed into its `| null` field (D15652).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const wideJ: J = mk()
const xs = [mk()]
function os0() { { f: 1 } }
const ws = [xs[0], os0()]
print(ws[1].f ?? 0)
const vs = [os0(), xs[0]]
print(vs[0].f ?? 0)
print(vs[1].f ?? 0)
const us = [...xs, os0()]
print(us[1].f ?? 0)
const o = os0()
print(o.f)
ws[1].f = 9
print(ws[1].f ?? 0)
function id(x) { x }
const ts = [xs[0], id({ f: 2 })]
print(ts[1].f ?? 0)
type S = { f: string | null, g: f64 }
function ms() { { f: "z", g: 1.5 } }
const wS: S = ms()
const ys = [ms()]
function s0() { { f: "a", g: 2.5 } }
const zs = [ys[0], s0()]
print(zs[1].f ?? "-")
print(zs[1].g)
print(wS.g)
print(wideJ.f ?? 0)
