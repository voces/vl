// @run
// @log 5
// @log 6
// @log 5
// @log 5
// @log 4
// @log x
// @hint Intentionally-unused parameter `_x`
// @hint Intentionally-unused parameter `_b`
// @hint Intentionally-unused parameter `_w`
// D15184: a fresh call copied into its own record where a pin delivers it, while another delivery
// builds it at a wider row that stores a field as nullable, unwraps that field: the call's own
// result type types it non-null, so every value its function builds holds one there.
type Circle = { r: i32 | null }
type K = { r: i32 }
type W = { a: i32 | null, b: string }
type WK = { a: i32, b: string }
function sink(_x: Circle) {}
function sinkW(_w: W) {}
function mk5() { { r: 5 } }
function mkw() { { a: 3, b: "x" } }
sink(mk5())
sinkW(mkw())
const k: K = { r: 1 }
const wk: WK = { a: 1, b: "y" }
function both<T>(a: T, _b: T): T { a }
function first<T>(xs: T[]): T { xs[0] }
function id<T>(x: T): T { x }
function viaField<T>(a: { f: T }, _b: T): T { a.f }
print(both(mk5(), k).r)
print(first([mk5(), k]).r + 1)
print(id<K>(mk5()).r)
print(viaField({ f: mk5() }, k).r)
const r = both(mkw(), wk)
print(r.a + 1)
print(r.b)
