// @run
// @log 4
// @log 12
// @log 4
// @hint redundant type annotation: `take` is inferred as `i32`
// @hint redundant type annotation: `ys` is inferred as `{f: i32}[]`
// @hint redundant type annotation: `r` is inferred as `{f: i32}`
// A maker called more than once keeps its own record; its call is copied where it lands wider.
// A read out of a container of a maker's calls reaching an annotated destination through a
// list or record literal or an inferred function's result runs (D15124, D15127).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const wideJ: J = mk()
const xs = [mk()]
function take(v: { f: i32 }): i32 { v.f }
function first() { return xs[0] }
const ys: { f: i32 }[] = [xs[0]]
type W = { a: { f: i32 } }
const w: W = { a: xs[0] }
const r: { f: i32 } = first()
print(take(first()))
print(ys[0].f + w.a.f + r.f)
print(wideJ.f ?? 0)
