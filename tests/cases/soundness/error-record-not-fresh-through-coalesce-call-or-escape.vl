// @check
// @error I is not J: they store field `f` differently (`i32` into `i32 | null`)
// @error {f: i32} is not J: they store field `f` differently (`i32` into `i32 | null`)
// @error {f: i32} is not J: they store field `f` differently (`i32` into `i32 | null`)
// Three values that look fresh and are not: an existing record on the left of `??` (either operand
// may be the one delivered), a literal a function builds at a declared record of its own fields
// (D3338), and a local a function hands to another place before returning it (D3341). Each is
// refused as an existing record is (DECISIONS.md "Record covariance: only a fresh value widens").
type I = { f: i32 }
type J = { f: i32 | null }
const a: I | null = { f: 4 }
const b: J = a ?? { f: 5 }
print(b.f ?? 0)
function mk() { { f: 4 } }
const c: J = mk()
print(c.f ?? 0)
const keep: { f: i32 }[] = []
function esc() {
  const s = { f: 4 }
  keep.push(s)
  s
}
const d: J = esc()
print(d.f ?? 0)
