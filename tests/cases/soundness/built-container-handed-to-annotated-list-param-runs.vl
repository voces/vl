// @run
// @log 4
// @log 12
// @log 15
// @log 6
// @log 9
// @log 5
// D14738: a list its stores build at a wider record, handed on whole to an annotated list
// parameter whose elements are only read or written for a field, runs at the list's build.
type J = { f: i32 | null }
function mk() { { f: 4 } }
function hs(o: { f: i32 }[]) { o[0].f * 3 }
function lenPlus(o: { f: i32 }[]) { o.length + o[1].f }
function setF(o: { f: i32 }[]) {
  o[0].f = 9
  o[0].f
}
function at(o: { f: i32 }[], i: i32) { o[i].f + i }
const wideJ: J = mk()
const xs = [mk(), mk()]
print(wideJ.f ?? 0)
print(hs(xs))
print(hs(xs) + hs([{ f: 1 }]))
print(lenPlus(xs))
print(setF(xs))
print(at(xs, 1))
