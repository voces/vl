// @hint redundant type annotation: `scalar` is inferred as `boolean` — remove it to lean on inference
// @hint redundant type annotation: `ref` is inferred as `boolean` — remove it to lean on inference
// @hint redundant type annotation: `str` is inferred as `boolean` — remove it to lean on inference
// @hint redundant type annotation: `throughGetter` is inferred as `boolean` — remove it to lean on inference
// @hint redundant type annotation: `inClosure` is inferred as `boolean` — remove it to lean on inference
// @hint redundant type annotation: `inLambdaArg` is inferred as `boolean` — remove it to lean on inference
// @hint redundant type annotation: `apart` is inferred as `i32` — remove it to lean on inference

// D3760: a getter that hands back its receiver makes the result another name for a fresh
// `const`, so a write through that name ends the const's narrowing, whether the getter site
// comes before or after the const is checked, and whether the field holds a scalar or a ref.
type B = { v: i32 }
type H = new { f: i32 | null }
type R = new { f: B | null }
type S = new { f: string | null }
get me(self: H): H { self }
get me(self: R): R { self }
get me(self: S): S { self }

// A getter site checked in another function first, which once banked it before `g`'s root.
function earlier(h: H): H { h.me }

function scalar(): boolean {
  const p: H = { f: 4 }
  const q = p.me
  if p.f != null {
    q.f = null
    return p.f == null
  }
  false
}

function ref(): boolean {
  const p: R = { f: { v: 4 } }
  const q = p.me
  if p.f != null {
    q.f = null
    return p.f == null
  }
  false
}

function str(): boolean {
  const p: S = { f: "a" }
  const q = (p).me.me
  if p.f != null {
    (q).f = null
    return p.f == null
  }
  false
}

function throughGetter(): boolean {
  const p: H = { f: 4 }
  if p.f != null {
    p.me.f = null
    return p.f == null
  }
  false
}

function inClosure(): boolean {
  const p: R = { f: { v: 4 } }
  const c = () => p.me
  const q = c()
  if p.f != null {
    q.f = null
    return p.f == null
  }
  false
}

function inLambdaArg(): boolean {
  const p: H = { f: 4 }
  const q = ap(() => p.me)
  if p.f != null {
    q.f = null
    return p.f == null
  }
  false
}
function ap(k: () => H): H { k() }

print(scalar())
print(ref())
print(str())
print(throughGetter())
print(inClosure())
print(inLambdaArg())

const tp: S = { f: "b" }
const tc = () => tp.me
const tq = tc()
if tp.f != null {
  tq.f = null
  print(tp.f == null)
}
const th: H = { f: 4 }
print(earlier(th).f == 4)

// A getter read off one fresh const does not reach another's narrowing.
function apart(): i32 {
  const p: H = { f: 4 }
  const o: H = { f: 5 }
  const q = o.me
  if p.f != null {
    q.f = null
    return p.f
  }
  0
}
print(apart())

// A compound assignment and an `is` narrowing, through the same getter.
type N = new { f: i32 | f64 }
type U = new { f: i32 | string }
get me(self: N): N { self }
get me(self: U): U { self }
function compound() {
  const p: N = { f: 4 }
  const q = p.me
  if p.f is i32 {
    q.f += 0.5
    return p.f is f64
  }
  false
}
function isArm() {
  const p: U = { f: "a" }
  const q = p.me
  if p.f is string {
    q.f = 3
    return p.f is i32
  }
  false
}
print(compound())
print(isArm())
