// @log true
// @log true
// @log true
// @log true
// @log true
// @log true
// @log true
// @log nnp0w
// @log true
// @log true
// @log nnp0wn
// A `null`-typed compare with an assignment of `null` on a side stores, runs each side left then
// right, and answers the constant. The right side sees the left's store, and the left's write is
// seen before the right's.
let tr = ""
function n(): null {
  tr = tr + "n"
  return null
}
function peek(x: string | null): null {
  tr = tr + (if x == null { "p0" } else { "p1" })
  return null
}
let u: string | null = "a"
function wr(): null {
  u = "z"
  tr = tr + "w"
  return null
}
function f() {
  let s: string | null = "a"
  print((s = null) == n())
  print(s == null)
  let t: i32 | null = 1
  print(n() != (t = null))
  print(t == null)
  let v: string | null = "a"
  print((v = null) == peek(v))
  print(wr() == (u = null))
  print(u == null)
  let a: string | null = "a"
  let b: string | null = "b"
  print((a = null) == (b = null))
  print(a == null && b == null)
  const z: null = null
  let c: string | null = "c"
  print(z == (c = null))
  print(tr)
}
f()
let g: string | null = "g"
print((g = null) == n())
print(g == null)
print(tr)
