// @run
// @log 7
// @log 7
// @log 2
// @log 4
// A list literal spread into a push delivers each element as a pushed value does, so a record or
// list literal among them is built at a wider annotated element (D15285).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const wideJ: J = mk()
const xs: J[] = [{ f: 4 }]
xs.push(...[{ f: 7 }])
print(xs[1].f ?? 0)
const ys: J[][] = [[{ f: 4 }]]
ys.push(...[[{ f: 7 }]])
print(ys[1][0].f ?? 0)
xs.push(...[{ f: null }, { f: 2 }])
print(xs[3].f ?? 0)
print(wideJ.f ?? 0)
