// @check
// @hint Intentionally-unused parameter `_x`
// @hint Intentionally-unused parameter `_a`
// @hint Intentionally-unused parameter `_b`
// @error-at 11:5 {r: null} is not Circle: they store field `r` differently
// VERDICT PIN (must-error): a call whose record another delivery builds wider, handed at its own
// type to an instance a held argument or element pins, is refused at the wider delivery (D14814).
type Circle = { r: i32 | null }
type K = { r: null }
function sink(_x: Circle) {}
function mkcall() { { r: null } }
sink(mkcall())
function both<T>(_a: T, _b: T): i32 { 1 }
function first<T>(xs: T[]): T { xs[0] }
const k: K = { r: null }
print(both(mkcall(), k))
print(first([mkcall(), k]).r ?? 6)
