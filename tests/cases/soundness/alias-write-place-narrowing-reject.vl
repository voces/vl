// @check
// @error-at 26:50 operator '+' is not defined for string | null and string
// @error-at 35:14 field 'q' is not on every member of A | B — narrow with `is` first (no 'q' on A) — 'p.f' is no longer narrowed to B: the assignment to 'q.f' on line 35 may reassign it; re-test 'p.f' after the assignment
// @error-at 44:16 member access '.r' on non-object A | null — 'xs[0]' is no longer narrowed to A: the assignment to 'ys[0]' on line 44 may reassign it; re-test 'xs[0]' after the assignment
// @error-at 55:6 'p.f' was narrowed by a guard outside this loop, and the assignment to 'q.f' can write it, so the read on line 55 would see the old narrowing on the next iteration — re-test 'p.f' inside the loop
// @error-at 68:4 'p.f' is read at its narrowed type by the function on line 68, which may run after the assignment to 'q.f' writes it — re-test 'p.f' inside that function
// @error-at 78:14 member access '.r' on non-object A | null — 'p.f' is no longer narrowed to A: the assignment to 'q.f' on line 78 may reassign it; re-test 'p.f' after the assignment

// D2585: a narrowed place read at its narrowed type after a write through another name for its
// object is refused, naming the write: in the next statement, in a loop that read it before the
// write, in a closure made before the write, and after an arm that wrote it. Lines are 0-based.
type A = { r: i32 }
type B = { q: string }
type H = { f: i32 | string | null }
type R = { f: A | null }
type U = { f: A | B }
function mkA(n: i32): A | null {
  if n == 0 { return null }
  { r: n }
}

function scalar() {
  const p: H = { f: "x" }
  const q = p
  if p.f != null {
    q.f = null
    if p.f is i32 { print(p.f + 1) } else { print(p.f + "!") }
  }
}

function member() {
  const p: U = { f: { q: "x" } }
  const q = p
  if p.f is B {
    q.f = { r: 3 }
    print(p.f.q)
  }
}

function cell() {
  const xs: (A | null)[] = [mkA(7)]
  const ys = xs
  if xs[0] != null {
    ys[0] = null
    print(xs[0].r)
  }
}

function loop() {
  const p: R = { f: mkA(7) }
  const q = p
  if p.f != null {
    let i = 0
    while i < 2 {
      print(p.f.r)
      q.f = null
      i = i + 1
    }
  }
}

function closure() {
  const p: R = { f: mkA(7) }
  const q = p
  if p.f != null {
    const rd = () => {
      print(p.f.r)
    }
    q.f = null
    rd()
  }
}

function arm() {
  const p: R = { f: mkA(7) }
  const q = p
  if p.f != null {
    if p.f.r > 3 { q.f = null }
    print(p.f.r)
  }
}

scalar()
member()
cell()
loop()
closure()
arm()
