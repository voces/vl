// @run
// @log 7
// @log 6
// @log 1
// @log 0
// @log 1
// @hint Intentionally-unused parameter `_b`
// @hint Intentionally-unused parameter `_a`
// D14818: a fresh call result delivered as a direct argument to a parameter typed `T`, where the
// call's written type arguments bind `T` at its own type while another delivery builds it wider,
// is built wide and copied where it lands, as D14817 does for a held argument's pin.
type Circle = { r: i32 | null }
type K = { r: null }
function sink(c: Circle) { print(c.r ?? 7) }
function mkcall() { { r: null } }
function id<T>(x: T): T { x }
function n<T>(_b: T) { 1 }
const w = mkcall()
sink(w)
print(id<K>(mkcall()).r ?? 6)
print(n<K>(mkcall()))
print(w.r ?? 0)
function both<T>(_a: T, _b: T) { 1 }
const k: K = { r: null }
print(both(mkcall(), k))
