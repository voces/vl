// @run
// @log true
// @log x!
// @log true
// @log true
// @log true
// @log true
// @log 5
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @hint redundant type annotation: `p` is inferred as `{f: A | null}` — remove it to lean on inference
// @hint redundant type annotation: `a` is inferred as `{f: A | null}` — remove it to lean on inference
// @hint redundant type annotation: `fr` is inferred as `{f: A | null}` — remove it to lean on inference
// @hint redundant type annotation: `fr` is inferred as `{f: A | null}` — remove it to lean on inference
// @hint redundant type annotation: `b` is inferred as `{f: A | null}` — remove it to lean on inference
// @hint redundant type annotation: `xs` is inferred as `(A | null)[]` — remove it to lean on inference
// @hint redundant type annotation: `ys` is inferred as `(A | null)[]` — remove it to lean on inference
// @hint redundant type annotation: `a` is inferred as `{f: A | null}` — remove it to lean on inference

// D2584, D2585: a write through another name for a narrowed place's object ends the narrowing,
// so a re-test after it runs; a write the narrowed type admits, a different fresh local, or a
// same-named field of another type keeps it.
type A = { r: i32 }
type H = { f: i32 | string | null }
type G = { g: H }
type K = { f: string | null }
type R = { f: A | null }
function mkA(n: i32): A | null {
  if n == 0 { return null }
  { r: n }
}

function field() {
  const p: H = { f: 4 }
  const q = p
  if p.f != null {
    q.f = null
    print(p.f == null)
  }
}

function fieldRetest() {
  const p: H = { f: "x" }
  const q = p
  if p.f != null {
    q.f = 9
    if p.f is string { print(p.f + "!") } else { print("x!") }
  }
}

function cell() {
  const xs: (i32 | string | null)[] = ["x"]
  const ys = xs
  if xs[0] != null {
    ys[0] = null
    print(xs[0] == null)
  }
}

function mapCell() {
  const m: { [string]: i32 | string | null } = Map()
  m["k"] = 4
  const n = m
  if m["k"] != null {
    n["k"] = null
    print(m["k"] == null)
  }
}

function nested() {
  const p: G = { g: { f: 4 } }
  const s = p.g
  if p.g.f != null {
    s.f = null
    print(p.g.f == null)
  }
}

function param(a: H, b: H) {
  if a.f != null {
    b.f = null
    print(a.f == null)
  }
}

function admitted() {
  const p: R = { f: mkA(7) }
  const q = p
  if p.f != null {
    q.f = { r: 5 }
    print(p.f.r)
  }
}

function freshDistinct() {
  const a: R = { f: mkA(7) }
  const b: R = { f: mkA(3) }
  if a.f != null {
    b.f = null
    print(a.f.r)
  }
}

function freshCells() {
  const xs: (A | null)[] = [mkA(7)]
  const ys: (A | null)[] = [mkA(3)]
  if xs[0] != null {
    ys[0] = null
    print(xs[0].r)
  }
}

function otherType() {
  const a: R = { f: mkA(7) }
  const k: K = { f: "x" }
  if a.f != null {
    k.f = null
    print(a.f.r)
  }
}

function otherKey() {
  const m: { [string]: A | null } = Map()
  m["k"] = mkA(7)
  if m["k"] != null {
    m["j"] = null
    print(m["k"].r)
  }
}

field()
fieldRetest()
cell()
mapCell()
nested()
const h: H = { f: 4 }
param(h, h)
admitted()
freshDistinct()
freshCells()
otherType()
otherKey()

// A fresh local no other place refers to is apart from a parameter, in either role.
function paramThenFresh(p: R) {
  if p.f != null {
    const fr: R = { f: mkA(3) }
    fr.f = null
    print(p.f.r)
  }
}
function freshThenParam(q: R) {
  const p: R = { f: mkA(7) }
  if p.f != null {
    q.f = null
    print(p.f.r)
  }
}
type N = { g: R }
function nestedFresh(p: N) {
  if p.g.f != null {
    const fr: R = { f: mkA(3) }
    fr.f = null
    print(p.g.f.r)
  }
}
paramThenFresh({ f: mkA(7) })
freshThenParam({ f: mkA(3) })
nestedFresh({ g: { f: mkA(7) } })
