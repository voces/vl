// @run
// @log 4
// @log 9
// @log 5
// @log 8
// @log 1
// @log 8
// @log 4
// @log 4
// @log 4
// D14753: a call built at a wider record, handed to a parameter annotated at its own record that
// only reads or writes a field, runs in an instance at the build, directly or relayed.
type II = { f: i32 }
type J = { f: i32 | null }
function mk() { { f: 4 } }
function id<T>(x: T): T { x }
function h(x) { x }
function r() {
  const k = id(mk())
  return k
}
function u(a: { f: i32 }) { a.f }
function w(a: { f: i32 }) {
  a.f = 9
  a.f
}
function t(a: { f: i32 }) {
  if a.f == 4 { 1 } else { 0 }
}
const d: J = mk()
print(u(mk()))
print(w(id(mk())))
print(u(h(mk())) + u({ f: 1 }))
print(u(r()) + u(r()))
print(t(mk()))
const z = mk()
print(u(z) + z.f)
print(u(h(r())))
print(u(id(r())))
print(d.f ?? 0)
