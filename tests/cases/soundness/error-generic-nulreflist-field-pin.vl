// @emit-error emitProgram: monomorphize: unsupported argument type for `_x` in a call to `dstGen`
// THE MONOMORPHIZER'S FLOOR, and this file exists to keep it LOUD.
//
// `monoArgTyName`'s cascade used to end in a bare `"i32"` catch-all, and that catch-all was
// the defect: the answer BECOMES the instance's parameter annotation, so a rep the ladder
// cannot NAME declared an i32 parameter over a `(ref …)` value — `vl check` rc 0 and
// `type mismatch: expected i32, found (ref …)` at load. An unrecognised REF rep now answers
// `""`, which fails the call by name here instead of minting a wrong instance
// (`silent-class-inventory` D23; its `u8[]` sibling is
// `tests/cases/soundness/error-generic-u8-list-pin.vl`).
//
// THE SPELLING IS THE WHOLE PROBLEM, not generics. An `S[] | null` PARAMETER and an
// annotated `S[] | null` LOCAL both pin fine, through `monoNulAnnName`; a struct FIELD read
// has no annotation channel at all, so the two ends of one type disagreed — one instance for
// the spelling that could be read, an i32 miscompile for the one that could not.
//
// The refusal also has to survive one BINDING (`const xs = o.xs`): the un-annotated-let arm
// recurses into the initializer, and it treats `""` as "nothing known" unless the refusal is
// propagated — otherwise the Ident cascade, post-mono blind for a local, answers `"i32"` and
// re-enters the very failure the floor prevents, one binding later.
//
// WHEN THIS GAINS A PIN the file starts failing, which is the point: a floor is a placeholder
// for a name, not a rule. Delete it and graduate a `@run` row.
type P = { a: i32 }
type Bx = { xs: P[] | null }

function dstGen<T>(_x: T, k: i32): i32 {
  return k
}

function nulRefListField(o: Bx) {
  const xs = o.xs
  if xs != null { return dstGen(xs, 7) }
  return -1
}

print(nulRefListField({ xs: [{ a: 1 }] }))
