// @run
// @log 7
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// @hint redundant type annotation: `dstGen` is inferred as `i32`
// GRADUATED FROM A `@emit-error` PIN (D1516), on the terms the pin itself set: "WHEN THIS
// GAINS A PIN the file starts failing, which is the point: a floor is a placeholder for a
// name, not a rule."
//
// The floor it pinned is still there and still right — `monoArgTyName` answers `""` rather
// than the `"i32"` catch-all for a rep it cannot NAME, because the answer becomes the
// instance's parameter annotation and a wrong one is check-clean invalid wasm. What changed
// is that the union family now HAS a name at that floor: the checker typed `o.xs` long
// before the mono pass ran, and `monoUnionPinName` reads it, through `monoAnnPinName` so the
// pin stays a spelling an annotated parameter already lowers.
//
// The two spellings this file's header called disagreeing now agree: an `S[] | null`
// PARAMETER, an annotated `S[] | null` LOCAL and this struct FIELD read all pin the same.
// The one-binding hop (`const xs = o.xs`) is kept because the un-annotated-let arm recurses
// into the initialiser and would otherwise re-enter the failure one binding later.
type P = { a: i32 }
type Bx = { xs: P[] | null }

function dstGen<T>(_x: T, k: i32): i32 {
  return k
}

function nulRefListField(o: Bx) {
  const xs = o.xs
  if xs != null { return dstGen(xs, 7) }
  return -1
}

print(nulRefListField({ xs: [{ a: 1 }] }))
