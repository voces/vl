// @run
// @log made
// @log 3
// @log made
// @log 4
// @log made
// @log 5
// @log 2
// @hint redundant type annotation: `w` is inferred as `K`
// A `null`-typed field read is its receiver's read, then `null`: off a generic call's result, off a
// local bound to one, and off an annotated local, each receiver built once.
type K = { r: null, n: i32 }
function id<T>(x: T): T { return x }
function mk(): K {
  print("made")
  return { r: null, n: 2 }
}
function offCall() { print(id(mk()).r ?? 3) }
function offBinding() {
  const v = id(mk())
  print(v.r ?? 4)
}
function offAnnotated() {
  const w: K = id(mk())
  print(w.r ?? 5)
  return w.n
}
offCall()
offBinding()
print(offAnnotated())
