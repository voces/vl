// @run
// @log 0
// @log 0
// @log 7
// @log 7
// @log 9
// @log 9
// @log 4
// @log 4
// @log true
// @log true
// @log 5
// @log 4
// CONTRACT (must-RUN): the EMITTER half of "an accepted write retires the narrowing". Each
// leg prints the read after the retiring write and then the SAME read from a binding that
// was never narrowed at all — the twin is the assertion, because the two must reach the
// same rep for the same stored value.
//
// THE CHECKER ALREADY RETIRED (`retireNarrowingsForWrite` puts the declared type back into
// the scope the narrowing shadowed) and types every read after the write at the DECLARED
// rep. The emitter's narrow stack did not, so it kept claiming the narrowed one: over the
// scalar reps the read unboxed a null payload and TRAPPED on the `ref.cast` (`f(x)`,
// `return x`), and `print(x ?? 0)` put an unboxed operand where the box arm reads the tag —
// `vl check` rc 0 both times.
//
// THE WRITE IS `x = null` WITH NO GUARD IN THE PROGRAM. The assignment kind's null write is
// accepted on master, so this is the spelling that reaches the defect with no guard-kind
// rule involved at all.

function gi(v: i32 | null) { print(v ?? 7) }

type K = "aa" | "bb"

// The filed shape: write, retire, read through `??`.
function coalesceAfterRetire() {
  let x: i32 | null = null
  x = 5
  x = null
  print(x ?? 0)
  const never: i32 | null = null
  print(never ?? 0)
}

// ARGUMENT position — this TRAPPED (`wasm trap: cast failure`) rather than emitting a
// wrong module, so it is the leg that shows the two failure modes share one root.
function argAfterRetire() {
  let x: i32 | null = null
  x = 5
  x = null
  gi(x)
  const never: i32 | null = null
  gi(never)
}

// RETURN position — the same trap through the callee's boundary.
function retAfterRetire(): i32 | null {
  let x: i32 | null = null
  x = 5
  x = null
  return x
}

function neverRet(): i32 | null {
  const never: i32 | null = null
  return never
}

// A NULLABLE (not literally `null`) right-hand side retires just as much: the narrowing
// does not admit it either.
function step(k: i32) {
  if k < 3 { return k + 1 }
  null
}

function nullableRhsRetires() {
  let x: i32 | null = null
  x = 5
  x = step(9)
  print(x ?? 4)
  const never: i32 | null = null
  print(never ?? 4)
}

// A BOXED litunion reads its null SENTINEL back as an atom rather than trapping, so it is
// the leg where the same root is a WRONG VALUE instead of a crash.
function litUnionAfterRetire() {
  const v: K = "aa"
  let x: K | null = null
  x = v
  x = null
  print(x == null)
  const never: K | null = null
  print(never == null)
}

// A write the narrowing ADMITS keeps it — retiring there would refuse a live read.
function admittedWriteKeeps() {
  let x: i32 | null = null
  x = 5
  x = 4
  print(x + 1)
  print(x)
}

coalesceAfterRetire()
argAfterRetire()
print(retAfterRetire() ?? 9)
print(neverRet() ?? 9)
nullableRhsRetires()
litUnionAfterRetire()
admittedWriteKeeps()
