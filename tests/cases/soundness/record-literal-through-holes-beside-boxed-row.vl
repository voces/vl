// @log 5
// @log 5
// @log 5
// @log 5
// @log 5
// @log 5
// @log 5
// D8900, D8920: a record literal keeps its own storage when a declared record of its field names
// boxes that field and the literal reaches a hole reading the field bare through a builder's
// result, through a second hole it is handed on to, through an un-annotated binding of it, or
// back out of an identity, at an un-annotated parameter or one declared as a bare type parameter.
type J = { f: i32 | null }
function bump(n) { return { f: n + 1 } }
function mk() { return { f: 4 } }
function take(a) {
  const v = a
  print(v.f + 1)
}
function rd(r) { return r.f + 1 }
function fwd(a) { return rd(a) }
function bind(a) {
  const v = a
  print(rd(v))
}
function id(x) { return x }
function onto(b) { print(b.f + 1) }
function rdT<T>(r: T) { return r.f + 1 }
function fwdT<T>(a: T) { return rdT(a) }
const keepJ: J = { f: null }
const keepF = keepJ.f ?? 0
take(bump(4))
print(fwd({ f: 4 }) + keepF)
bind({ f: 4 })
print(rd(id({ f: 4 })) + keepF)
print(fwd(mk()) + keepF)
print(fwd(bump(3)) + keepF)
onto(id({ f: 4 }))
take(bump(3))
print(rdT({ f: 4 }) + keepF)
print(fwdT({ f: 4 }) + keepF)
