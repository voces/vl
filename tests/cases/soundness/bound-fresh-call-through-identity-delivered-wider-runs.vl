// @run
// @log 15
// @log 16
// @log 17
// @log 18
// @log 19
// @log 20
// @log 1
// @info `kl` is never reassigned; use `const` instead of `let`
// A binding holding a fresh call, handed through a generic or hole identity into a wider record,
// is built there: in a binding, an argument, a `let`, a function body and a copy chain (D15179).
type J = { r: i32 | null, g: i32 }
function idn<T>(v: T): T { v }
function idh(v) { v }
function mk(n: i32) { { r: n, g: 1 } }
function take(j: J) { print(j.r ?? 0) }
const k = mk(15)
const m: J = idn(k)
print(m.r ?? 0)
const kh = mk(16)
const mh: J = idh(kh)
print(mh.r ?? 0)
const ka = mk(17)
take(idn(ka))
let kl = mk(18)
const ml: J = idn(kl)
print(ml.r ?? 0)
function inFn() {
  const kf = mk(19)
  const mf: J = idn(kf)
  print(mf.r ?? 0)
}
inFn()
const kc = mk(20)
const kc2 = kc
const mc: J = idn(kc2)
print(mc.r ?? 0)
print(mc.g)
