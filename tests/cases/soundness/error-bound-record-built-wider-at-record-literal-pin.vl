// @check
// @error is handed on here at its own type, which stores a field differently
// @hint Intentionally-unused parameter `_x`
// @hint Intentionally-unused parameter `_b`
// CONTRACT (must-error): a bound record built wider, reaching a type parameter through a record
// field or a nested list, is not handed to an instance a record literal holding a held value pins
// at its own type (D15182).
type Circle = { r: i32 | null }
type K = { r: null }
function sink(_x: Circle) {}
function mkcall() { { r: null } }
const c = mkcall()
sink(c)
const k: K = { r: null }
function viaField<T>(a: { f: T }, _b: { f: T }): T { a.f }
function viaNested<T>(a: T[][], _b: { f: T }): T { a[0][0] }
print(viaField({ f: c }, { f: k }).r ?? 6)
print(viaNested([[c]], { f: k }).r ?? 6)
