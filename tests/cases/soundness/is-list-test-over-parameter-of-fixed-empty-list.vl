// @run
// @log false
// @log 2
// @log false
// @log false
// @log true
// @log true
// A list `is` test over an un-annotated or generic parameter answers as the annotated spelling
// does when every call hands a list whose element is fixed and cannot meet the tested one
// (D16342); a list nothing fixed still answers by emptiness (D4910).
function take(v) { v is f64[] }
const m: i32[] = []
print(take(m))
function branch(v) {
  if v is f64[] { return 1 }
  return 2
}
print(branch(m))
function gen<T>(v: T) { v is f64[] }
print(gen(m))
function written(v) { v is f64[] }
const w = [1]
w.pop()
print(written(w))
function open(v) { v is f64[] }
print(open([]))
function deflt<T>() {
  const q: T[] = []
  q is f64[]
}
print(deflt<i32>())
