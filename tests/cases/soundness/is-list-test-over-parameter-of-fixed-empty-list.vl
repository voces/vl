// A list `is` test over an un-annotated or a type parameter answers by the element type an
// annotation fixed, as the annotated spelling does, when every call hands such a list; a list
// nothing fixed still fits every list type (D4910), and an instance whose list meets the test
// still passes it empty (D16342).
const e: i32[] = []
const k: f64[] = []
function take(v) { return v is f64[] }
print(take(e))
function open(v) { return v is f64[] }
print(open([]))
function gen<T>(v: T) { return v is f64[] }
print(gen(e))
function g2<V>(v: V) {
  if v is f64[] { print(v.length) }
  print(1)
}
g2(e)
g2(k)
function h2(v) {
  if v is f64[] { return 1 }
  return 0
}
print(h2(e))
print(h2(k))
