// @run
// @log true
// @log false
// @log true
// @log false
// @log true
// @log false
// @log true
// @log false
// @log true
// @log false
// @log true
// @log false
// @log true
// @log false
// @log true
// @log false
// @log false
// @log true
// @log true
// @log true
// @log true
// @log false
// @log true
// @log false
// CONTRACT (must-not-error): a lexicographic ordering (`<` `<=` `>` `>=`) with ONE operand
// annotated as a string and the other an inference HOLE is writable. The body cannot decide
// the operator's form yet, so it DEFERS — `noteBinCstr` records the constraint and the call
// site adjudicates it under substitution (`binOpDefinedFor`), exactly as `+` already does for
// `s + h`. `ordering-hole-string-operand-reject.vl` is the rejecting half: every non-string
// binding of the hole is still a clean type error, at the call that pins it.
//
// This is the ordering twin of `equality-hole-operand-sound.vl`. The population is the four
// ordering operators x the two HALF-annotated directions x the three string-typed spellings
// (`string`, a string LITERAL type, a string LITERAL UNION — the last two reach the same arm
// through `softenLitTy`). All 24 have bare and fully-annotated twins that accept and print
// the same value, so an annotation never removes a capability here.

// `string` on one side, a hole on the other.
function ltRs(a, b: string) { a < b }
function ltLs(a: string, b) { a < b }
function leRs(a, b: string) { a <= b }
function leLs(a: string, b) { a <= b }
function gtRs(a, b: string) { a > b }
function gtLs(a: string, b) { a > b }
function geRs(a, b: string) { a >= b }
function geLs(a: string, b) { a >= b }

// A string LITERAL UNION softens to `string` before the ordering arm.
function ltRu(a, b: "a" | "b") { a < b }
function ltLu(a: "a" | "b", b) { a < b }
function leRu(a, b: "a" | "b") { a <= b }
function leLu(a: "a" | "b", b) { a <= b }
function gtRu(a, b: "a" | "b") { a > b }
function gtLu(a: "a" | "b", b) { a > b }
function geRu(a, b: "a" | "b") { a >= b }
function geLu(a: "a" | "b", b) { a >= b }

// A single string LITERAL type softens the same way.
function ltRl(a, b: "a") { a < b }
function ltLl(a: "a", b) { a < b }
function leRl(a, b: "a") { a <= b }
function leLl(a: "a", b) { a <= b }
function gtRl(a, b: "a") { a > b }
function gtLl(a: "a", b) { a > b }
function geRl(a, b: "a") { a >= b }
function geLl(a: "a", b) { a >= b }

print(ltRs("a", "b")) // true
print(ltLs("b", "a")) // false
print(leRs("a", "a")) // true
print(leLs("b", "a")) // false
print(gtRs("b", "a")) // true
print(gtLs("a", "b")) // false
print(geRs("a", "a")) // true
print(geLs("a", "b")) // false

print(ltRu("a", "b")) // true
print(ltLu("b", "a")) // false
print(leRu("b", "b")) // true
print(leLu("b", "a")) // false
print(gtRu("b", "a")) // true
print(gtLu("a", "b")) // false
print(geRu("a", "a")) // true
print(geLu("a", "b")) // false

print(ltRl("a", "a")) // false
print(ltLl("a", "b")) // true
print(leRl("a", "a")) // true
print(leLl("a", "b")) // true
print(gtRl("b", "a")) // true
print(gtLl("a", "b")) // false
print(geRl("a", "a")) // true
print(geLl("a", "b")) // false
