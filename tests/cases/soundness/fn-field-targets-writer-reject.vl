// @check
// @error-at 15:27 'r.f' was narrowed by a write of a non-null value, but the call to 'f' on line 16 can write it — re-test 'r.f' after the call
// @error-at 27:12 member access '.length' on non-object string | null — 'p.g' is no longer narrowed to string: the call to 'h' on line 27 may reassign it; re-test 'p.g' after the call

// D15322: a call through a record field is charged every function ever stored there, so one that
// writes the narrowed place, stored directly or through an alias, still ends the narrowing.
// Line and column are 0-based.

type R = { f: ((a: i32) => i32) | null }
const r: R = { f: (a: i32) => a + 1 }
r.f = (a: i32) => {
  r.f = null
  a
}
if r.f != null {
  if r.f(4) == 5 { print(r.f(4)) }
}

type Q = { h: (a: i32) => i32, g: string | null }
const p: Q = { h: (a: i32) => a + 1, g: "ab" }
const alias = p
alias.h = (a: i32) => {
  p.g = null
  a
}
if p.g != null {
  print(p.h(4))
  print(p.g.length)
}
