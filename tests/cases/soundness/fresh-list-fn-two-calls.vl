// @run
// @log 3
// @log 7
// D14508: a function returning a fresh list of literals, called at two sites that both deliver
// it as `Circle[]`, builds its records at `Circle` for both, as one called at one site does.
type Circle = { r: i32 | null }
function sink(xs: Circle[]) {
  xs[0].r = 3
  print(xs[0].r ?? 0)
}
function mkcall() {
  const cc = [{ r: null }]
  return cc
}
sink(mkcall())
const lamc = (x: Circle[]) => x
const dd = lamc(mkcall())
dd[0].r = 7
print(dd[0].r ?? 0)
