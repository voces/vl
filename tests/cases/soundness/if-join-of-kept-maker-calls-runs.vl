// @run
// @log 1
// @log 1
// @log 4
// @log 1
// @log 4
// A join whose every arm is a call of a maker an annotated binding builds wider, or one delivered
// or assigned whole at that record, is built there and runs (D15653).
type J = { f: i32 | null }
function mk2() { { f: 1 } }
function mk4() { mk2() }
const dA: J = mk2()
print(dA.f ?? 0)
const k = 1
const a = if k > 0 { mk2() } else { mk2() }
print(a.f ?? 0)
const b: J = if k > 0 { { f: 4 } } else { mk2() }
print(b.f ?? 0)
const c = if k > 0 { mk4() } else { mk4() }
print(c.f ?? 0)
let z = mk2()
z = if k > 0 { { f: 4 } } else { mk2() }
print(z.f ?? 0)
