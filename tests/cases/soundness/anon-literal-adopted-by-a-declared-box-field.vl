// @run
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// THE ADOPTION `structIndexOfObjCtx` MAKES FOR AN UN-ANNOTATED OBJECT LITERAL, and the two
// candidate fixes for it that this file PINS as refused (silent-class-inventory D208 / D209 /
// D271 / D272, 2026-08-27).
//
// THE ADOPTION. `structIndexOfObjCtx`'s field-name-set scan is REFUTATION-ONLY:
// `anonValueFitsField` lets a union-BOX field (code 16) accept every atom "by construction",
// so a bare `{ r: 7 }` matches a declared `{ r: i32 | null }` and the literal is built as that
// row with its `r` stored BOXED — while the CHECKER types the same literal `{r: i32}` and
// every read of it unboxed. That disagreement is D209, CLOSED 2026-08-28 by a three-rung
// channel (the read site, `exprUnion` and `emitUnionCoerce`'s atom pick, all asking one
// predicate) — and programs 4 and 5 below, which the READ-side candidate reddened, are the
// reason it took three rungs rather than one. See also
// `tests/cases/soundness/adopted-box-field-read-is-a-channel.vl`.
//
// PROGRAM 1 GRADUATED (D208): the adoption also SUPPRESSES the row that would have agreed —
// `collectAnonShapes` interns an `#anon` row only `if structIndexOfObj(ai) < 0` — so the map
// value's element spelling `{r:{c2:i32}}` resolved NO struct row and `rlElemStructRow` fell to
// the `rlElemHeap = 0` sentinel. Closed by restoring the resolver's fourth rung, which its
// SLOT-LESS twin `structIdxOfElemName` never lost.
//
// PROGRAMS 2-6 ARE THE PINS, AND THEY ARE MEASURED REFUSALS, NOT CAUTION.
//   · 2 and 3 (D271) redden under the RESOLVER-side candidate — the one that declines the
//     adoption on a proven canon-id disagreement. There the adoption is the RIGHT row and the
//     only thing that says so is a destination one UN-ANNOTATED binding away, which
//     `recordRepTyAdopt` never reaches (its walk has Paren / ObjLit / ArrayLit arms and no
//     Ident one). Probed, the defect and these pins produce byte-identical resolver dumps.
//   · 4 and 5 (D272) redden under the READ-side candidate — the one that unboxes an
//     un-narrowed code-16 read whose CHECKER type is an atom. Here the box is the CORRECT
//     rep because the CONSUMER is a union slot, and unboxing pushes a bare scalar into it:
//     72 `runs` lost over a 1,260-cell read-form grid, 36 of them into a silent class.
//   · 6 is the control at the other end of the annotation axis: annotating the literal's own
//     container, where checker and emitter have always agreed.
// KEEP ALL FIVE: they are the floor any future change to this adoption has to clear.

// 1 — D208's repro, verbatim in shape: an un-annotated map of LISTS with nothing annotated
// anywhere, and the payload field is a declared union so the box leniency fires on an ARM.
type D2Cir = { c2: i32 }
type D2Sq = { s2: i32 }
type D2Shape = D2Cir | D2Sq
type C1 = { r1: D2Shape }
const lv1 = [{ r1: { c2: 7 } }]
const m1 = Map()
m1["k0"] = lv1
const g1 = (m1)["k0"] ?? []
if g1.length > 0 {
  if (g1[0]).r1 is D2Cir { print(7) } else { print(0) }
} else {
  print(0)
}

// 2 — D271, the RESOLVER-side pin: a declared destination one un-annotated binding away, one
// container out.
type C2 = { r2: i32 | null }
const lv2 = [{ r2: 7 }]
const c2: C2[][] = [lv2]
print(c2.length + 6)

// 3 — D271 one container shallower: the destination is the alias itself.
type C3 = { r3: i32 | null }
const lv3 = [{ r3: 7 }]
const c3: C3[] = lv3
print(c3.length + 6)

// 4 — D272, the READ-side pin: the adopted literal's boxed field is read UN-NARROWED into a
// UNION-typed binding. The checker types the read `i32`; the consumer wants the box; the box
// is what the emitter already has, so this runs. Unbox it and a bare i32 lands in a
// `(ref $uBox)` slot.
type C4 = { r4: i32 | null }
const v4 = { r4: 7 }
const q4: i32 | null = (v4).r4
if q4 is i32 { print(q4) } else { print(0) }

// 5 — D272's second consumer: the same read stored into ANOTHER code-16 field.
type C5 = { r5: i32 | null }
type B5 = { s5: i32 | null }
const v5 = { r5: 7 }
const w5: B5 = { s5: (v5).r5 }
if w5.s5 is i32 { print(w5.s5) } else { print(0) }

// 6 — the control at the OTHER end of the annotation axis: annotating the literal's own
// container. The checker adopts here, so emitter and checker already agreed and this
// spelling has always run.
type C6 = { r6: i32 | null }
const c6: C6[] = [{ r6: 7 }]
print(c6.length + 6)
