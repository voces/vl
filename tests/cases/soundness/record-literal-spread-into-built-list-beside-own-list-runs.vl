// @run
// @log 7
// @log 1
// @log 4
// A record literal spread into a list whose elements are built at a wider record is built at
// that list, even where another list literal of its own record type mints the own row: a
// literal's stamp is where it is built, the parameter its call closes only where it is
// delivered (D15288).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const wideJ: J = mk()
const xs = [mk()]
xs.push(...[{ f: 7 }])
const os = [{ f: 1 }]
print(xs[1].f ?? 0)
print(os[0].f)
print(wideJ.f ?? 0)
