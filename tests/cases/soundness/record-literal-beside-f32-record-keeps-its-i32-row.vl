// @run
// @log 3
// @log 4
// @log 5
// @log 2.5
// @hint redundant type annotation: `ti` is inferred as `i32`
// @hint redundant type annotation: `inner` is inferred as `i32`
// D2979. An un-annotated record literal takes the declared record of its field names only
// when the checker could store its fields there; `{ v: 3 }` is `{v: i32}`, and the checker
// refuses that record at `R32`'s `f32` field, so its `i32` read is an `i32`.
type R32 = { v: f32 }
function ti(a: i32): i32 { a }
const B = 3
const q = { v: B }
print(ti(q.v))
const p = { v: 4 }
print(ti(p.v))
function inner(): i32 {
  const r = { v: 5 }
  r.v
}
print(inner())
const d: R32 = { v: 2.5 }
print(d.v)
