// @log 1
// @log true
// @log true
// An assignment of `null` used as a value is the `null` its destination holds, and it stores: into
// a union box (a binding, an argument, a value `if`), a `null` parameter, a `null[]` element and a
// `null`-valued map (D17090).
let hits = 0
function note(): null {
  hits = hits + 1
  return null
}
function takeBox(u: i32 | null) { return u == null }
function takeNull(a: null) { return a == null }

function boxBinding() {
  let s: string | null = "a"
  const u: i32 | null = (s = null)
  print(s == null)
  print(u == null)
  let n: i32 | null = 1
  const w: i32 | null = (n = null)
  print(n == null)
  print(w == null)
}
boxBinding()

function boxArgument() {
  let s: string | null = "a"
  print(takeBox(s = null))
  print(s == null)
  print(takeBox(note()))
  print(hits)
}
boxArgument()

function boxJoin(c: boolean) {
  let s: string | null = "a"
  const u: i32 | null = if c { (s = null) } else { note() }
  print(s == null)
  print(u == null)
}
boxJoin(true)
boxJoin(false)

function nullSlots() {
  let s: string | null = "a"
  print(takeNull(s = null))
  print(s == null)
  s = "b"
  const xs: null[] = []
  xs.push(s = null)
  print(s == null)
  print(xs.length)
  s = "c"
  const m: { [string]: null } = Map()
  m.set("k", (s = null))
  print(s == null)
  print(m.get("k") == null)
}
nullSlots()
