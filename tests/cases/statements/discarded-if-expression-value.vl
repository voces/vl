// @run
// @log then
// @log 10
// @log else
// @log 20
// @log m-a
// @log 30
// @log ladder-b
// @log 40
// @log nested
// @log 50
// @log top
// @log 60
// A value-producing `if`-expression or `match` in STATEMENT position DISCARDS its value,
// the same rule `discarded-call-return.vl` pins for a non-void call. Such an `if` lowers as
// a VOID `if` whose arm blocks each end in a value, so the discard happens INSIDE the arm,
// on the arm's own last statement — which is why a hand-written `==` ladder reproduces the
// shape identically, and why `match` needs no separate handling (`desugarMatchAt` lowers it
// to the same chain before emit sees it).
//
// Every arm calls `tick` before yielding its value, so the log pins WHICH arm ran and that
// the discard did not swallow the arm's effects: a mis-lowering that takes the wrong arm,
// drops the effect, or reorders the discard against the surrounding statements moves a log
// LINE rather than merely changing an exit code. The conditions are PARAMETERS, not `const`
// literals, so no arm folds away and every arm is really emitted.
function tick(tag: string) {
  print(tag)
  10
}

// then-arm taken; its value (a `tick` result) is discarded, its `print` is not.
function a1(c: boolean) {
  if c { tick("then") } else { tick("no") }
  10
}

// else-arm taken, string-valued arms — the discarded rep is a ref, not a scalar.
function a2(c: boolean) {
  if c { "x" } else { tick("else") "y" }
  20
}

// `match` over a literal union in statement position.
type K = "a" | "b"
function a3(k: K) {
  match k {
    "a" => { tick("m-a") }
    "b" => { tick("m-b") }
  }
  30
}

// The same shape spelled as the `==` ladder `match` desugars to.
function a4(k: K) {
  if k == "a" { tick("ladder-a") } else { tick("ladder-b") }
  40
}

// A NESTED if-expression in statement position: the inner join is discarded too.
function a5(c: boolean) {
  if c { if !c { 1 } else { tick("nested") } } else { 0 }
  50
}

print(a1(true))
print(a2(false))
print(a3("a"))
print(a4("b"))
print(a5(true))

// Top level runs statements too, so the discard applies there as well.
function topFlag() { true }
if topFlag() { tick("top") } else { 0 }
print(60)
