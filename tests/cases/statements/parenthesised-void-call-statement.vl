// @run
// @log 11
// @log 12
// @log 13
// @log 14
// @log 20
// @log 21
// @log 30
// @log 31
// @log 40
// @log 10
// @log 60
// @log 14
// @log 70
// @log 50
// @log 51
// @log 52
// @hint redundant type annotation: `h` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `dbl` is inferred as `i32` — remove it to lean on inference
// A parenthesised call statement is the call statement, so a void one is a statement too, and a
// value one is still a value in tail position (D2637). One position per line of output.
function g(x: i32) { print(x) }
function h(x: i32): i32 {
  print(x)
  x
}
function dbl(x: i32): i32 { x * 2 }

// inside a function, doubly parenthesised, and a discarded value call
function f() {
  (g(11))
  ((g(12)))
  (h(13))
  g(14)
}
// the tail of an inferred function
function tailp() {
  g(20)
  (g(21))
}
// a loop body
function inLoop() {
  for i in 0 to 1 { (g(30 + i)) }
}
f()
tailp()
inLoop()
// a block-bodied closure, a value tail, an expression-bodied closure (void and value), and `: void`
const k = () => {
  (g(40))
}
k()
function t() { (dbl(5)) }
print(t())
const k2 = () => (g(60))
k2()
const k3 = () => (dbl(7))
print(k3())
function u(): void { (g(70)) }
u()
// top level, doubly parenthesised, and inside an `if`
(g(50))
((g(51)))
if true { (g(52)) }
