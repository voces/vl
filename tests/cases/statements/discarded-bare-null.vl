// @warning This expression has no effect: it is not the final statement of its block, so its value is discarded
// A discarded `null` statement drops like every other value-shaped class in
// `discarded-expression-statement-classes.vl`. A nullable-ref `null` is `ref.null none`,
// which needs no destination to type it, so the statement no longer refuses for want of
// a slot.
function f() {
  null
  0
}
print(f())
