// @run
// @log 3
// @log done
// @hint Intentionally-unused parameter `_x`
// The empty BODY of every construct is legal and runs (D2223 refuses only a bare `{}` used
// as a value or as a nested statement): `if`, `else`, `while`, `for`, a function, an arrow
// lambda, and a match arm. `() => {}` is an empty-bodied lambda, never an empty object, so
// it passes as a callback.
function each(xs: i32[], cb: (i32) => void) {
  for x in xs { cb(x) }
}
function nothing() {}
let n = 0
if n > 0 {}
if n > 0 {} else {}
if n > 0 { n = 1 } else {}
while n > 0 {}
for _x in [1, 2] {}
nothing()
const g = () => {}
g()
each([1, 2, 3], (_x: i32) => {})
each([1, 2, 3], (_x) => {})
each([1, 2, 3], (_x: i32) => {
  n = n + 1
})
match n {
  0 => {}
  _ => {}
}
print(n)
print("done")
