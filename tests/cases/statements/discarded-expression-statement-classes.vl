// @run
// @log numlit
// @log strlit
// @log boollit
// @log charlit
// @log ident
// @log paren
// @log binadd
// @log bincmp
// @log member
// @log index
// @log isexpr
// @log asexpr
// @log objlit
// @log arraylit
// @log strarraylit
// @log unaryneg
// @log unarynot
// @log postinc
// @log callval
// @log i64
// @log f64
// @log 99
// @warning This expression has no effect: it is not the final statement of its block, so its value is discarded
// The `unused-pure-expression` lint deliberately NAMES the population this file is built
// from: 13 of the classes below (literal / ident / paren / literal-leaved binary /
// array / struct literal) are trivially-pure non-final discarded statements — exactly
// the rule's target. The one directive above covers all 13 (they share a message); the
// call / member / index / `is` / `as` / `++` classes stay outside its whitelist, and so
// do the two unary-over-IDENTIFIER classes (`-id` / `!flag`) — an operator over an
// identifier operand could dispatch to a user overload, so only all-literal-leaved
// operator trees are called pure.
// VL's expression-statement rule — a bare value expression in statement position is
// evaluated for effect and its value DISCARDED — holds by NODE CLASS, not by spelling:
// `emitStmt` routes every statement that `stmtIsTailValue` calls a value through one
// `drop`. This file walks the classes so the rule cannot come apart for one of them
// again; `discarded-call-return.vl` pins the call case that established the rule.
//
// Each class is preceded by a `print` naming it, so a class whose discard emits the wrong
// number of stack values yields an INVALID MODULE, which stops the run and TRUNCATES the
// log at that class's own name — the log says which class broke, not merely that something
// did.
//
// `classes` is VOID and ends in a `print`, deliberately. A body ending in a VALUE would hide
// a missing `drop`: wasm's `return` pops only the result and leaves any residue below it
// unexamined, so the function would still answer correctly with the stack dirty. A void
// body's `end` requires an EMPTY stack, which is what makes the residue a validation error
// and this file sensitive to the discard rather than only to the value.
//
// A bare `null` statement is deliberately absent: it has no rep to drop without a typed
// context and still rejects, pinned by `error-discarded-bare-null.vl`.
function val() { 7 }

function classes() {
  print("numlit")
  42
  print("strlit")
  "s"
  print("boollit")
  true
  print("charlit")
  'x'
  print("ident")
  const id = 5
  id
  print("paren")
  (1 + 2)
  print("binadd")
  1 + 2
  print("bincmp")
  1 < 2
  print("member")
  const lst = [1, 2]
  lst.length
  print("index")
  lst[0]
  print("isexpr")
  id is i32
  print("asexpr")
  id as f64
  print("objlit")
  { a: 1 }
  print("arraylit")
  [1, 2]
  print("strarraylit")
  ["p", "q"]
  print("unaryneg")
  -id
  print("unarynot")
  const flag = true
  !flag
  print("postinc")
  let bump = 5
  bump++
  print("callval")
  val()
  print("i64")
  const big: i64 = 5
  big
  print("f64")
  const frac = 1.5
  frac
  print(99)
}

classes()
