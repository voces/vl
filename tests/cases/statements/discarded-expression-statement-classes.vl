// @run
// @log numlit
// @log strlit
// @log boollit
// @log charlit
// @log ident
// @log paren
// @log binadd
// @log bincmp
// @log member
// @log index
// @log isexpr
// @log asexpr
// @log objlit
// @log arraylit
// @log strarraylit
// @log unaryneg
// @log unarynot
// @log postinc
// @log callval
// @log i64
// @log f64
// @log 99
// VL's expression-statement rule — a bare value expression in statement position is
// evaluated for effect and its value DISCARDED — holds by NODE CLASS, not by spelling:
// `emitStmt` routes every statement that `stmtIsTailValue` calls a value through one
// `drop`. This file walks the classes so the rule cannot come apart for one of them
// again; `discarded-call-return.vl` pins the call case that established the rule.
//
// Each class is preceded by a `print` naming it, and the whole run ends in `99`. A class
// whose discard emits the wrong number of stack values yields an INVALID MODULE, which
// stops the run and TRUNCATES the log at that class's own name — so the log says which
// class broke, not merely that something did.
//
// A bare `null` statement is deliberately absent: it has no rep to drop without a typed
// context and still rejects, pinned by `error-discarded-bare-null.vl`.
function val() { 7 }

function classes() {
  print("numlit")
  42
  print("strlit")
  "s"
  print("boollit")
  true
  print("charlit")
  'x'
  print("ident")
  const id = 5
  id
  print("paren")
  (1 + 2)
  print("binadd")
  1 + 2
  print("bincmp")
  1 < 2
  print("member")
  const lst = [1, 2]
  lst.length
  print("index")
  lst[0]
  print("isexpr")
  id is i32
  print("asexpr")
  id as f64
  print("objlit")
  { a: 1 }
  print("arraylit")
  [1, 2]
  print("strarraylit")
  ["p", "q"]
  print("unaryneg")
  -id
  print("unarynot")
  const flag = true
  !flag
  print("postinc")
  let bump = 5
  bump++
  print("callval")
  val()
  print("i64")
  const big: i64 = 5
  big
  print("f64")
  const frac = 1.5
  frac
  99
}

print(classes())
