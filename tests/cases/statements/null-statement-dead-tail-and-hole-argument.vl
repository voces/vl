// @run
// @log 0
// @log a
// @log 3
// A `null` the program discards (a bare statement or a dead tail after a `return`), and one passed
// through a hole callee, is the one value of the `null` type, written and dropped or passed.
function f() {
  null
  return 0
}
print(f())
function deadNull(_k: i32): string {
  return "a"
  null
}
print(deadNull(1))
function orz<T>(v: T | null, d: T): T { return v ?? d }
function via(a) { print(a(null, 3)) }
via(orz)
