// @run
// @log 12
// @log abxyzp0p1ic.
// A discarded value is evaluated for its effects in source order: an object literal's fields,
// an array literal's elements, then an index call's list, its argument and the call.
let trail = ""
function tick(s: string) {
  trail = trail + s
  return trail.length
}
function pick(i: i32): (n: i32) => i32 {
  tick("p\{i}")
  return (n: i32) => n + tick("c")
}
function f() {
  { a: tick("a"), b: tick("b") }
  [tick("x"), tick("y"), tick("z")]
  [pick(0), pick(1)][1](tick("i"))
  return tick(".")
}
print(f())
print(trail)
