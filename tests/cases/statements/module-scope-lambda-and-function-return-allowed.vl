// @run
// @log 1
// @log 2
// @log 3
// D2262's residue: `T.curRet == -1` is the checker's "no enclosing function" test (PL-028),
// so `return` keeps working at every nesting THAT test does not cover — a module-scope
// lambda, a named top-level function, and a `return` reached through the function's own
// `if`. None of these is a module-level return: each sits inside a `FuncDecl` body, which
// saves and restores `T.curRet` around the check.
const f = () => {
  return 1
}
print(f())

function g(x: i32) {
  if x > 0 { return 2 }
  return 0
}
print(g(1))

const h = (x: i32) => {
  if x > 0 { return 3 }
  0
}
print(h(1))
