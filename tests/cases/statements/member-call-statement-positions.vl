// @run
// @log 2
// @log 3
// @log 3
// @log 2
// @log 2
// @log 0
// @log 1
// @hint redundant type annotation: `xs` is inferred as `i32[]` — remove it to lean on inference
// @hint redundant type annotation: `annotatedTail` is inferred as `i32[]` — remove it to lean on inference
// @hint redundant type annotation: `xs` is inferred as `i32[]` — remove it to lean on inference
// @hint redundant type annotation: `nonTail` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `xs` is inferred as `i32[]` — remove it to lean on inference
// @hint redundant type annotation: `ms` is inferred as `i32[]` — remove it to lean on inference
// CONTRACT (must-RUN): a member call whose value no mutator arm claims is a DISCARDED VALUE
// in statement position and the function's RESULT in tail position (D1240). Positions:
// module scope, a non-tail statement, the tail of an annotated function, the tail of an
// UN-ANNOTATED one whose caller reads the result, and the tail of a `: void` one.
//
// THE NEGATIVE CONTROL is `pushTail`, and it is the reason the classifier asks the CHECKER's
// type and excludes `.push` by name (D1301): `.push` has no value lowering at any position,
// so classifying its tail as a value would refuse a procedure that runs. `pushTail` must
// stay VOID — its `print(0)` after the call is what proves the call was lowered as a
// statement and the caller got nothing to drop.
//
// `popTail` is the wrong-answer pin: before D1240 it returned `null` for a list that had a
// value to pop, at `vl check` rc 0.
function annotatedTail(): i32[] {
  const xs: i32[] = [1, 2, 3]
  xs.slice(0, 2)
}

function nonTail(): i32 {
  const xs: i32[] = [1, 2, 3]
  xs.slice(0, 2)
  return xs.length
}

function inferredTail(xs: i32[]) {
  xs.slice(0, 2)
}

function voidTail(): void {
  const xs: i32[] = [1, 2, 3]
  xs.slice(0, 2)
}

function popTail(xs: i32[]) {
  xs.pop()
}

function pushTail(xs: i32[]) {
  xs.push(9)
}

const ms: i32[] = [1, 2, 3]
ms.slice(0, 2)

print(annotatedTail().length)
print(nonTail())
print(ms.length)
print(inferredTail([1, 2, 3]).length)
print(popTail([1, 2]) ?? 0)
voidTail()
print(0)
pushTail(ms)
print(1)
