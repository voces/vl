// @run
// @log after
// @log 0
// @log 1
// @log no
// @log done
// A BARE `return` — the ordinary early exit from a void function. It had NO LOWERING:
// `vl check` reported the file clean and the emitter refused with
// `emitProgram: bare return is not supported`, so a guard clause could not be written in
// VL at all. Nothing in the corpus exercised it, which is why the hole survived — the
// A/B that shipped this moved 0 verdicts and 0 bytes over 2,005 files.
//
// The population is exactly the functions with an EMPTY result type, and the checker is
// already the gate on that: `error-bare-return-in-value-fn.vl` is the other side, where a
// bare return is refused by NAME of the type it owes.

// The headline shape: a guard clause.
function guard(c: boolean) {
  if c { return }
  print("after")
}
guard(true)
guard(false)

// Inside a loop, where the return has to cross the loop's block structure.
function upto(n: i32) {
  let i = 0
  while i < n {
    if i == 2 { return }
    print(i)
    i = i + 1
  }
}
upto(5)

// In a lambda body, which reaches the same emitter arm through a different function form.
function nested() {
  const f = (c: boolean) => {
    if c { return }
    print("no")
  }
  f(true)
  f(false)
}
nested()

// In TAIL position, where the fall-through would have ended the body anyway — the
// terminator still has to be written, not elided.
function tail() {
  print("done")
  return
}
tail()
