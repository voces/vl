// @run
// @log 7
// @log in
// @log 3
// @log ab
// @log 6
// @log 9
// @log 5
// @log 1
// @log 4
// @hint redundant type annotation: `s` is inferred as `string` — remove it to lean on inference
// @hint redundant type annotation: `p` is inferred as `{a: i32}` — remove it to lean on inference
// CONTRACT (must-RUN): a bare `{ … }` block is a STATEMENT with its own scope, at every
// scope and with every content (D1253). The parser mints a `Block` for it deliberately and
// the checker gives it a scope; the emitter lowers it by desugaring to `if true { … }`, so
// every per-function scratch-frame scan walks it.
//
// THE HAZARD THIS PINS is the SCAN coverage, not the arm. An `emitStmt` arm alone makes the
// first two lines below work and leaves the string op, the `.push` and the concatenation
// compiling against locals nobody declared — check-clean invalid wasm, `unknown local N`.
// Every content here needs a frame some walker reserves.
//
// The block's own scope is pinned by the shadowing pair: the inner `n` must not escape.
type P = { a: i32 }

function contents() {
  {
    print(7)
  }
  {
    const s: string = "in"
    print(s)
  }
  {
    const p: P = { a: 3 }
    print(p.a)
  }
  {
    const t = "a" + "b"
    print(t)
  }
  {
    const xs: i32[] = []
    xs.push(6)
    print(xs[0])
  }
  {
    const c = 8
    const f = () => {
      return c + 1
    }
    print(f())
  }
}

function shadows() {
  const n = 4
  {
    const n = 5
    print(n)
  }
  {
    {
      print(1)
    }
  }
  print(n)
}

contents()
shadows()
