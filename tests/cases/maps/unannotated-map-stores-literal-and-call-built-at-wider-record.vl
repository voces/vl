// @run
// @log 6
// @log 5
// @log 6
// @log 4
// Every store into an un-annotated `Map()` contributes its build, in either order and through
// `.set` or an index: the literals are built at the `J` the stored `mk()` is built as (D14517).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const wideJ: J = mk()
const m = Map()
m.set("b", { f: 5 })
m.set("a", mk())
const n = Map()
n["a"] = mk()
n["b"] = { f: 5 }
const x = m.get("b")
if x != null { print(x.f + 1) }
const y = m.get("a")
if y != null { print(y.f + 1) }
const z = n["b"]
if z != null { print(z.f + 1) }
print(wideJ.f ?? 0)
