// @run
// @log 4
// @log 4
// @log 2
// @log true
// @log 2
// @log 5
// @log 9
// @log 9
// @log a
// @log 4
// @log b
// @log 5
// A `Map()` global whose values the checker builds at a wider record (`J`, the D16957 shape) is
// held at that record's map, and every read of it reads that map: delivered whole to an annotated
// binding, a method's receiver at top level and in a function, an argument, and a walk of its
// values or its pairs at top level and in a function.
type J = { f: i32 | null }
const m = Map()
m.set("a", { f: 4 })
const wm: {[string]: J} = m
const d = { f: 1 }
const w3 = { k: { x: { f: 7 } } }
w3.k = { x: m.get("a") ?? d }
print(w3.k.x.f ?? 0)
print(wm.get("a")?.f ?? 0)
m.set("b", { f: 5 })
print(m.length)
print(m.has("a"))
function count(x: {[string]: J}) { return x.length }
print(count(m))
function inner() { return m.get("b")?.f ?? 0 }
print(inner())
let sum = 0
for v in m.values() { sum = sum + (v.f ?? 0) }
print(sum)
function walk() {
  let s = 0
  for v in m.values() { s = s + (v.f ?? 0) }
  return s
}
print(walk())
for k, v in m {
  print(k)
  print(v.f ?? 0)
}
