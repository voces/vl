// @run
// @log 1
// @log 0
// @log 9
// @log 1
// @log 11
// @log 22
// @log 15
// A map read's default that computes runs only when the key is missing, after the probe: the
// counter rises once, and a default that assigns the key or the map variable is seen afterwards.
const m: {[string]: i32} = Map()
let calls = 0
function cnt() {
  calls = calls + 1
  return 9
}
function f(k: string) { return m[k] ?? cnt() }
function kw(k0: string) {
  let k = k0
  const v = m[k] ?? (k = "zz").length
  return v * 10 + k.length
}
function mw() {
  let mm: {[string]: i32} = Map()
  const other: {[string]: i32} = Map()
  other["q"] = 5
  const v = mm["q"] ?? (mm = other).length
  return v * 10 + (mm["q"] ?? 0)
}
m["a"] = 1
print(f("a"))
print(calls)
print(f("b"))
print(calls)
print(kw("a"))
print(kw("b"))
print(mw())
