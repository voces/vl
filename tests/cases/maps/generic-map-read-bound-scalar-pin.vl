// @run
// @log null
// @log 5
// @log null
// @log 5
// @log null
// @log 1.5
// @log null
// @log true
// @log null
// @log 7
// @log null
// @log 5
// A generic's un-annotated binding of a map read at a pin that makes the value a scalar keeps
// the miss's `null`, at `m.get(k)` and `m[k]`, at `i32`, `f64` and `boolean` (D10292, D10360).
function show<V>(m: Map<string, V>, k: string) {
  const x = m.get(k)
  print(x)
}
function showIdx<V>(m: Map<string, V>, k: string) {
  const x = m[k]
  print(x)
}
function keep<V>(m: Map<string, V>, k: string): V | null {
  const x = m.get(k)
  x
}
function later<V>(m: Map<string, V>, k: string) {
  const x = m.get(k)
  const f = () => x
  f()
}
const mi: Map<string, i32> = Map()
mi.set("k", 5)
show(mi, "z")
show(mi, "k")
showIdx(mi, "z")
showIdx(mi, "k")
const mf: Map<string, f64> = Map()
mf.set("k", 1.5)
show(mf, "z")
showIdx(mf, "k")
const mb: Map<string, boolean> = Map()
mb.set("k", true)
show(mb, "z")
showIdx(mb, "k")
print(keep(mi, "z"))
print(keep(mi, "z") ?? 7)
print(later(mi, "z"))
print(later(mi, "k"))
