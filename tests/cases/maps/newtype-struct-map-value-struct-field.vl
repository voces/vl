// @run
// @log 21
// @log 22
// A NEWTYPE over a struct as the map value of a struct FIELD — the one intern path
// that arrives with the field row's own banked arena index (`sFieldElemTyIx`)
// instead of resolving the value spelling itself.
type EView = new { base: i32, length: i32 }
type GView = new { base: i32, length: i32 }
type ViewHolder = {
  em: { [string]: EView },
  gm: { [string]: GView },
}

const emap: { [string]: EView } = Map()
emap["k"] = { base: 21, length: 1 }
const gmap: { [string]: GView } = Map()
gmap["k"] = { base: 22, length: 2 }

const holder: ViewHolder = { em: emap, gm: gmap }
const ev = holder.em["k"]
if ev != null { print(ev.base) }
const gv = holder.gm["k"]
if gv != null { print(gv.base) }
