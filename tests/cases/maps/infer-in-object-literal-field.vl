// @run
// @log x
// @log 1.5
// @log 4
// @log two
// @log 3
// @log 7
// @log true
// @log true
// @log sv
// @log 9
// @log sk
// @log ik
// AN INFERRED MAP IN AN ANONYMOUS OBJECT LITERAL'S FIELD. An anonymous shape's field codes
// come from the literal's VALUES (there is no annotation to read), and a `Map()` value had
// no code at all — which un-interned the WHOLE literal, so every use of the binding, a read
// as harmless as `.length` included, reported "ref valtype with no interned shape". The
// annotated twin (`const s: {m: {[string]: string}} = { m: Map() }`) has always run: the
// gap was exactly the missing spelling.
//
// A map field is code 19 and an mv slot's identity is the (KEY, VALUE) PAIR, so both halves
// come off the type the checker recorded on the constructor — which is why both key reps
// and several value reps are here rather than one witness.
//
// THE FILE MUST STAY ANNOTATION-FREE AT EVERY MAP (`infer-value-kinds.vl` states the rule):
// an annotated `{[K]: V}` anywhere in the module mints that slot and the inferred field then
// FINDS it, which would make the fixture pass with the field code still missing.

type Pt = { x: i32 }

function mkStruct() {
  return Map()
}

// The headline: a `Map()` field, written and read through the field.
const s = { m: Map() }
s.m["a"] = "x"
print(s.m["a"] ?? "none") // x

// A map field beside ORDINARY fields — the literal's other codes must still classify, and
// the shape must intern with the map among them.
const mixed = { m: Map(), n: 4, tag: "t" }
mixed.m.set("a", 1.5)
print(mixed.m["a"] ?? 0.0) // 1.5
print(mixed.n) // 4

// A NESTED literal: the inner shape interns first (lower arena indices), and the outer one
// carries it as a code-15 field.
const nest = { o: { m: Map() } }
nest.o.m[1] = "two"
print(nest.o.m[1] ?? "none") // two

// A field initialised from a map-returning FACTORY rather than a direct constructor — the
// field's type is still only what the checker recorded on the call.
const fromCall = { m: mkStruct() }
fromCall.m.set("a", { x: 3 })
print((fromCall.m["a"] ?? { x: 0 }).x) // 3

// The mono i32 value rep, which needs no mv slot — the field row still has to exist for it.
const sizes = { m: Map() }
sizes.m["a"] = 7
print(sizes.m["a"] ?? 0) // 7

// A `Set()` field on each key rep: a Set is a boolean-valued map, mono either way, but the
// two monos are two different structs.
const os = { s: Set() }
os.s.add("a")
print(os.s.has("a")) // true

const oi = { s: Set() }
oi.s.add(1)
print(oi.s.has(1)) // true

// TWIN LITERALS: an anonymous shape is interned per field-name SET, so two `{ m: Map() }`
// literals over DIFFERENT map types are the collapse this discriminates. Each pair below
// name-matches the other exactly and must still get its own shape — the value axis first,
// then the key axis, which is the half a bare `Map()` carries no spelling for at all.
const tvA = { m: Map() }
tvA.m["k"] = "sv"
const tvB = { m: Map() }
tvB.m["k"] = 9
print(tvA.m["k"] ?? "none") // sv
print(tvB.m["k"] ?? 0) // 9

const tkA = { q: Map() }
tkA.q["k"] = "sk"
const tkB = { q: Map() }
tkB.q[1] = "ik"
print(tkA.q["k"] ?? "none") // sk
print(tkB.q[1] ?? "none") // ik
