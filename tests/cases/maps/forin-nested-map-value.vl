// @run
// @log 1
// @log 7
// @log 1
// @log 7
// @log 2
// @log q
// @log 4
// @log n
// @log 3
// @log 3
// @log 42
// @log 6
// @log 8
// @log 8
// @log 3
// @log n
// @log 1
// A map whose value is itself a map walks with `for k, v in m` and `for v in m.values()`, and
// a list of maps walks with `for v in xs`: the loop variable is the inner map, readable,
// writable and nullable where its type is. A ref-list value binds its own row in a pair walk.
type P = { x: i32 }

const outer: {[string]: {[string]: i32}} = Map()
const inner: {[string]: i32} = Map()
inner["x"] = 7
outer["a"] = inner
for k, v in outer {
  print(v.length)
  print(v["x"] ?? 0)
}
for v in outer.values() {
  print(v.length)
  print(v["x"] ?? 0)
  v["y"] = 2
}
print(inner["y"] ?? 0)

const deep: {[i64]: {[string]: string[]}} = Map()
const leaf: {[string]: string[]} = Map()
leaf["s"] = ["p", "q"]
deep[1] = leaf
for k, v in deep { print((v["s"] ?? [])[1]) }

const maybe: {[string]: {[string]: i32} | null} = Map()
const mi: {[string]: i32} = Map()
mi["x"] = 4
maybe["a"] = mi
maybe["b"] = null
for k, v in maybe {
  if v != null { print(v["x"] ?? 0) } else { print("n") }
}

function total(xs: {[string]: i32}[]) {
  let n = 0
  for m in xs { n = n + m.length }
  return n
}
const three: {[string]: i32} = Map()
three["a"] = 1
three["b"] = 2
three["c"] = 3
print(total([three]))

const lists: {[string]: P[]} = Map()
lists["a"] = [{ x: 3 }]
for k, v in lists { print(v[0].x) }

const o: {[string]: {[string]: {[string]: i32}}} = Map()
const mid: {[string]: {[string]: i32}} = Map()
const bottom: {[string]: i32} = Map()
bottom["z"] = 42
mid["m"] = bottom
o["o"] = mid
for k, v in o {
  for k2, w in v { print(w["z"] ?? 0) }
}

function sum(m: {[i32]: {[string]: i32}}) {
  let t = 0
  for k, v in m {
    for k2, x in v { t = t + x + k }
  }
  return t
}
const byId: {[i32]: {[string]: i32}} = Map()
const row: {[string]: i32} = Map()
row["x"] = 5
byId[1] = row
print(sum(byId))

const plain = Map()
const pi = Map()
pi["x"] = 8
plain["a"] = pi
for k, v in plain { print(v["x"] ?? 0) }
for v in plain.values() { print(v["x"] ?? 0) }

const withNull = [three, null]
for v in withNull {
  if v == null { print("n") } else { print(v.length) }
}

const sets = [Set<string>()]
sets[0].add("a")
for s in sets { print(s.length) }
