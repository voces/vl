// @check
// @error map key must be i32, got string
// @error cannot assign i32 to string?
// SOUNDNESS: the index-write pin is a COMMITMENT, not a widening. Once `m[1] = "x"`
// materialises the inferred `Map()` as `{[i32]: string}`, a later write with a
// conflicting KEY or a conflicting VALUE is a clean type error — the index spelling's
// twin of `error-infer-conflict.vl`, which pins the same floor for `.set`. A bare
// integer literal pins the key to its BASE type `i32` (not to a literal type), so
// `m[2]` below is a legal key and only its value is refused.
const m = Map()
m[1] = "x"
m["b"] = "y"
m[2] = 5
