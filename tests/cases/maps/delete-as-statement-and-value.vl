// @run
// @log true
// @log false
// @log 1
// @log 2
// A map delete as a statement, its result dropped, and as a value: hit, then miss.
function prune(m: {[i32]: i32}) {
  m.delete(1)
  const hit = m.delete(2)
  print(hit)
  print(m.delete(2))
  return m.has(3)
}
const m: {[i32]: i32} = Map()
m[1] = 10
m[2] = 20
m[3] = 30
if prune(m) { print(m.length) }
const s: {[string]: i32} = Map()
s["a"] = 1
s["b"] = 2
s.delete("zz")
print(s.length)
