// @run
// @log 0 0 0
// @log 0 0 0
// D2505: `forin-walk-mutation-against-reference.vl` over i64 keys. Random inserts, overwrites
// and deletes over 64 keys, with a walk every 400 steps whose body deletes (the current key or
// another), inserts and overwrites, against a reference that is JS `Map` iteration written out:
// an append-only log of entries, walked by index, skipping dead ones. The keys are chosen to
// share their low 32 bits in pairs and to include both i64 extremes, so a map that hashed or
// compared a truncated key would conflate two of them. Per map kind: mismatches, a walk that
// ended early or late, and the live count against the reference's (all three 0).

// Key `i`: 62 keys sharing their low half and differing in the high one, each positive one
// beside its negation, plus the two i64 extremes.
function keyOf(i: i32) {
  if i == 0 { return 9223372036854775807 }
  if i == 1 { return -9223372036854775807 - 1 }
  const k = ((i / 2) as i64 << 32) | 77
  if i % 2 == 1 { return 0 - k }
  k
}

function indexOf(k: i64) {
  for i in 0 until 64 {
    if keyOf(i) == k { return i }
  }
  -1
}

function mapKeys() {
  const m: {[i64]: i32} = Map()
  const logK: i32[] = []
  const logV: i32[] = []
  const logLive: boolean[] = []
  const pos: i32[] = []
  for i in 0 until 64 { pos.push(-1) }
  let seed = 777
  let bad = 0
  let ends = 0
  for step in 0 until 12000 {
    seed = (seed * 1103515245 + 12345) & 2147483647
    const k = (seed >> 8) % 64
    const op = (seed >> 3) % 5
    if op < 2 {
      m.delete(keyOf(k))
      if pos[k] >= 0 { logLive[pos[k]] = false }
      pos[k] = -1
    } else {
      m[keyOf(k)] = step
      if pos[k] >= 0 {
        logV[pos[k]] = step
      } else {
        pos[k] = logK.length
        logK.push(k)
        logV.push(step)
        logLive.push(true)
      }
    }
    if step % 400 == 0 {
      let c = 0
      let n = 0
      for wk, wv in m {
        while c < logK.length && !logLive[c] { c = c + 1 }
        if c >= logK.length || keyOf(logK[c]) != wk || logV[c] != wv {
          bad = bad + 1
        }
        const wi = indexOf(wk)
        seed = (seed * 1103515245 + 12345) & 2147483647
        const a = (seed >> 8) % 64
        const wop = (seed >> 3) % 6
        if wop == 0 || wop == 1 {
          m.delete(wk)
          if wi >= 0 && pos[wi] >= 0 { logLive[pos[wi]] = false }
          if wi >= 0 { pos[wi] = -1 }
        } else if wop == 2 {
          m.delete(keyOf(a))
          if pos[a] >= 0 { logLive[pos[a]] = false }
          pos[a] = -1
        } else if n < 150 {
          m[keyOf(a)] = step + n
          if pos[a] >= 0 {
            logV[pos[a]] = step + n
          } else {
            pos[a] = logK.length
            logK.push(a)
            logV.push(step + n)
            logLive.push(true)
          }
        }
        n = n + 1
        c = c + 1
      }
      while c < logK.length && !logLive[c] { c = c + 1 }
      if c < logK.length { ends = ends + 1 }
    }
  }
  let live = 0
  for i in 0 until 64 {
    if pos[i] >= 0 { live = live + 1 }
  }
  "\{bad} \{ends} \{m.length - live}"
}

function sets() {
  const s: Set<i64> = Set()
  const logK: i32[] = []
  const logLive: boolean[] = []
  const pos: i32[] = []
  for i in 0 until 64 { pos.push(-1) }
  let seed = 99
  let bad = 0
  let ends = 0
  for step in 0 until 12000 {
    seed = (seed * 1103515245 + 12345) & 2147483647
    const k = (seed >> 8) % 64
    const op = (seed >> 3) % 5
    if op < 2 {
      s.delete(keyOf(k))
      if pos[k] >= 0 { logLive[pos[k]] = false }
      pos[k] = -1
    } else {
      s.add(keyOf(k))
      if pos[k] < 0 {
        pos[k] = logK.length
        logK.push(k)
        logLive.push(true)
      }
    }
    if step % 400 == 0 {
      let c = 0
      let n = 0
      for x in s {
        while c < logK.length && !logLive[c] { c = c + 1 }
        if c >= logK.length || keyOf(logK[c]) != x { bad = bad + 1 }
        const xi = indexOf(x)
        seed = (seed * 1103515245 + 12345) & 2147483647
        const a = (seed >> 8) % 64
        const wop = (seed >> 3) % 6
        if wop == 0 || wop == 1 {
          s.delete(x)
          if xi >= 0 && pos[xi] >= 0 { logLive[pos[xi]] = false }
          if xi >= 0 { pos[xi] = -1 }
        } else if wop == 2 {
          s.delete(keyOf(a))
          if pos[a] >= 0 { logLive[pos[a]] = false }
          pos[a] = -1
        } else if n < 150 {
          s.add(keyOf(a))
          if pos[a] < 0 {
            pos[a] = logK.length
            logK.push(a)
            logLive.push(true)
          }
        }
        n = n + 1
        c = c + 1
      }
      while c < logK.length && !logLive[c] { c = c + 1 }
      if c < logK.length { ends = ends + 1 }
    }
  }
  let live = 0
  for i in 0 until 64 {
    if pos[i] >= 0 { live = live + 1 }
  }
  "\{bad} \{ends} \{s.length - live}"
}

print(mapKeys())
print(sets())
