// @run
// @log x
// @log 1.5
// @log 5000000000
// @log 3
// @log 3
// @log 2
// @log 4
// @log 5
// @log 7
// @log hit
// USAGE-DRIVEN INFERENCE ACROSS THE VALUE REPS. `infer-from-set.vl` pins the headline —
// an un-annotated `const m = Map()` takes its key/value from a downstream `m.set(k, v)` —
// on an i32 value, which is the ONE value type that needs no mv slot: i32 / boolean /
// literal-union atoms all ride the shared mono `vals` list. Every other value type
// resolved its TYPE here and had no REP, because the only mv MINT in the compiler is
// `collectA`'s `TypeRef` walk and an un-annotated `Map()` puts no map spelling in the
// arena for it to read. Each binding below rejected with "unsupported map value type"
// while its annotated twin ran.
//
// THE FILE MUST STAY ANNOTATION-FREE AT THE OUTER MAP. An annotated `{[K]: V}` anywhere
// in the module mints that (KEY, VALUE) slot, and the inferred binding then FINDS it —
// which is how the gap survived: a corpus of annotated maps masks it everywhere it is
// measured. The only annotation here is the INNER map of the nested case, whose pair
// (`{[string]: i32}`) is not the outer one (`{[string]: {[string]: i32}}`).

type Pt = { x: i32 }
type A = { a: i32 }
type B = { b: i32 }
type U = A | B

function bump(n: i32) {
  n + 1
}

function pick(b: boolean): string | null {
  if b { return "hit" }
  null
}

function go() {
  // kind 3 — the string vals list.
  const ms = Map()
  ms.set("a", "x")
  print(ms["a"] ?? "none") // x

  // kind 11 / 10 — the scalar f64 / i64 vals lists.
  const mf = Map()
  mf.set("a", 1.5)
  print(mf["a"] ?? 0.0) // 1.5

  const mi = Map()
  mi.set("a", 5000000000)
  print(mi["a"] ?? 0) // 5000000000

  // kind 1 — a struct value over a ref vals list.
  const mp = Map()
  mp.set("a", { x: 3 })
  print((mp["a"] ?? { x: 0 }).x) // 3

  // kind 6 — a LIST value (i32 and string element backings are different heaps).
  const ml = Map()
  ml.set("a", [1, 2, 3])
  print((ml["a"] ?? []).length) // 3

  const msl = Map()
  msl.set("a", ["p", "q"])
  print((msl["a"] ?? []).length) // 2

  // kind 6 — a NESTED map value. The inner map is annotated; the outer is not, and the
  // two are different (KEY, VALUE) pairs, so the inner's slot cannot mint the outer's.
  const inner: {[string]: i32} = Map()
  inner.set("k", 4)
  const mm = Map()
  mm.set("a", inner)
  const dflt: {[string]: i32} = Map()
  print((mm["a"] ?? dflt)["k"] ?? 0) // 4

  // kind 14 — a CLOSURE value; the read binds a closure local and the call resolves its
  // sig from the inferred value type.
  const mc = Map()
  mc.set("a", bump)
  const f = mc["a"] ?? bump
  print(f(4)) // 5

  // kind 2 — a UNION value over the shared box; `is` narrows the read.
  const u: U = { a: 7 }
  const mu = Map()
  mu.set("k", u)
  const v = mu["k"] ?? u
  if v is A { print(v.a) } // 7

  // A NICHE-nullable value (`string | null`) rides its non-null twin's vals rep.
  const mn = Map()
  mn.set("a", pick(true))
  print(mn["a"] ?? "none") // hit
}
go()
