// @run
// @log 1
// @log 2
// @log true
// @log 2
// @log 33
// @log 2
// @log 1
// @log 4
// THE SCRATCH-FRAME RESERVATION FOR THE i32-KEYED map in FIELD position — the
// third file in the family (`map-scratch-frame-reservation.vl` string-keyed,
// `i32-keyed-scratch-frame-reservation.vl` the bare i32 receiver forms), and the
// one that pins the receiver form those two could not spell.
//
// The rule the family exists for: the per-function map frame is reserved by a
// SCAN (`fnHasMap` / `blockHasMapOp` / `exprHasMapOp` / `forInMapRecv`), and the
// op is lowered by a HANDLER. A member of the handler's set that the scan does
// not enumerate writes `local.set` against locals that were never reserved —
// INVALID WASM at `vl check` rc 0. So EVERY function below holds exactly ONE map
// op: nothing here lends its frame to anything else, and deleting any bystander
// leaves each row a real pin.
//
// What is being claimed: the scans stayed key-BLIND and receiver-COMPLETE through
// B6b. `exprHasMapOp` reaches a `s.f`-rooted receiver through `exprMap` exactly as
// it reaches a bare name, and the i32-key frame (`mapI32Base`) is gated on the
// module-wide `mI32Used` beside the per-function `fnUsesMap` — so the FIELD
// position adds no receiver form and no key test to the scan half. The one thing
// it DID add is the flag setter for an INLINE shape, which is pinned separately in
// `i32-keyed-inline-shape-field-flag.vl` (a module-wide flag cannot be pinned in
// a file that spells the map anywhere else).
//
// NOT HERE, and measured that way: a SET-typed field (`{s: {[K]: boolean}}`) has
// no `.add` at all — `unknown property \`add\` on {[i32]: boolean}` — and the
// STRING-keyed twin reads identically, so it is a pre-existing CHECKER gap and
// not this rep's. Filed in ROADMAP B6.

type Box = { m: {[i32]: i32} }

// ── one op per function, over a struct-field receiver ────────────────────────
function fStore(b: Box) {
  b.m[11] = 1
}
function fRead(b: Box): i32 {
  return b.m[11] ?? -1
}
function fSet(b: Box) {
  b.m.set(22, 2)
}
function fGet(b: Box): i32 {
  return b.m.get(22) ?? -1
}
function fHas(b: Box): boolean {
  return b.m.has(11)
}
function fDelete(b: Box) {
  b.m.delete(11)
}
function fLength(b: Box): i32 {
  return b.m.length
}
function fForIn(b: Box): i32 {
  let acc = 0
  for k in b.m {
    acc = acc + k
  }
  return acc
}
function fKeys(b: Box): i32 {
  const ks = b.m.keys()
  return ks.length
}

// The struct itself is built in a frame that performs NO map op of its own.
function mk(): Box {
  return { m: Map() }
}

const b: Box = mk()
fStore(b)
print(fRead(b))     // 1
fSet(b)
print(fGet(b))      // 2
print(fHas(b))      // true
print(fLength(b))   // 2
print(fForIn(b))    // 33
print(fKeys(b))     // 2
fDelete(b)
print(fLength(b))   // 1

// A GLOBAL struct: `fnHasMap` sees no map DECLARATION in these frames, so the
// body walk is the only thing that can reserve them.
const gb: Box = { m: Map() }
function gStore() {
  gb.m[44] = 4
}
function gRead(): i32 {
  return gb.m[44] ?? -1
}
gStore()
print(gRead())      // 4
