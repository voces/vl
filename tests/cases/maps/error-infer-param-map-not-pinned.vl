// @error argument 1: parameter is used as a map but nothing in the body pins its key or value — add a type annotation
// @error-at 17
// THE FLOOR ON THE MAP DEMAND OF AN UN-ANNOTATED PARAMETER, and why it is a floor rather
// than an inference. A callee that only READS its map parameter pins nothing: `q.get("a")`
// checks against a demand whose key and value are still open, so what it records on the node
// is `V | null` with no `V`.
//
// The argument's own type cannot repair that, and the reason is ORDER. The body was already
// checked against the open demand, so pinning it from this argument now would emit against
// stale recorded types — bidirectional inference (ROADMAP E5), not a pin. Measured before the
// floor existed: 10 wasm traps and 1 silently-wrong output across the position grid, all
// `vl check`-clean. Annotating either the parameter or the binding runs.
function takeStr(q) {
  print(q.get("a") ?? "none")
}
const m: {[string]: string} = Map()
m["a"] = "x"
takeStr(m)
