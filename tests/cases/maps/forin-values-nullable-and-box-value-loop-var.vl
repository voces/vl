// @run
// @log x
// @log 0
// @log 7
// @log 0
// @log 1
// @log 0
// @log 7
// @log 0
// CONTRACT: `for v in m.values()` binds the loop var to the rep ONE INDEX READ of the same
// map yields — including when the value type is nullable or boxed. Three value kinds share
// this rule and `forInElemKind`'s `.values()` sub-ladder is their one home:
//
//   · a NULLABLE STRING value (`{[string]: string | null}`, mv kind 3) rides the SAME vals
//     list its non-null twin does (the element slot is `(ref null $aTypeIdx)` either way),
//     so only the loop VAR differs: the kind-16 niche, which keeps the raw nullable ref.
//   · a UNION-BOX value (`{[string]: i32 | null}`, `{[string]: 1 | 2 | null}`, mv kind 2) —
//     the vals element IS `$uBox`, so the loop var is a kind-4 union-box local and
//     `v != null` is the box-TAG compare.
//   · a NULLABLE-STRUCT value (`{[string]: S | null}`, mv kind 1) — a `(ref null $S)`
//     element slot, so the loop var is the kind-9 niche.
//
// The failures this pins are what a NON-null loop var does to each: the kind-3 value bound
// `"str"`, which recovers every element `ref.as_non_null` (a trap on a stored null) and whose
// `v != null` found no nullable rep to test — `emitProgram: bare null needs a struct-typed
// context`; the kind-2 value fell to `"struct"`, whose slot resolution answers -1 —
// `emitProgram: ref valtype with no interned shape`; the kind-1 nullable value bound the
// non-null `"struct"` and its `v != null` reached the structural struct-equality path —
// `emitProgram: struct equality is not supported yet`. The mono-i32 niches
// (`boolean | null`, `K | null`) are unaffected: they rep as the mono i32 map, not a vals list.
//
// The CONTROL that makes this a loop-var defect and not "nullable map values are
// unsupported" is `m.keys()` + `m[k]`, which binds the nullable rep today.

type S = { v: i32 }

const ms: {[string]: string | null} = Map()
ms["a"] = "x"
ms["b"] = null
for v in ms.values() {
  if v != null { print(v) } else { print(0) }
}

const mi: {[string]: i32 | null} = Map()
mi["a"] = 7
mi["b"] = null
for v in mi.values() {
  if v != null { print(v) } else { print(0) }
}

const mn: {[string]: 1 | 2 | null} = Map()
mn["a"] = 1
mn["b"] = null
for v in mn.values() {
  if v != null { print(1) } else { print(0) }
}

const mt: {[string]: S | null} = Map()
mt["a"] = { v: 7 }
mt["b"] = null
for v in mt.values() {
  if v != null { print(v.v) } else { print(0) }
}
