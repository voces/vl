// An empty `Map()` or `Set()`, or a generic's call handing one back, read in place by a key read
// settles as a bound one only read does: the read's key fixes the key, the value takes the default
// (D16726, D16886). The receiver is evaluated where it sits, between its neighbours.
function take<B>(b: B): B { return b }
function f() {
  print("f")
  return 1
}
function g() {
  print("g")
  return 2
}
function takeLoud<B>(b: B): B {
  print("take")
  return b
}
print(Set().has(1))
print(Map().has(1))
print(Map()[1] ?? 0)
print(Map().keys().length)
print(take(Set()).has(1))
print(take(Map())[1] ?? 0)
print(Map().get("k") ?? 7)
print(Set().delete("a"))
print(f() + (if takeLoud(Set()).has(g()) { 10 } else { 20 }))
