// @check
// @error 'm[1]' was narrowed by a guard, but the call to 'delete' on line 19 can write it — re-test 'm[1]' after the call
// @error 'n["a"]' was narrowed by a guard, but the call to 'delete' on line 28 can write it — re-test 'n["a"]' after the call
// @error 'xs[0]' was narrowed by a guard, but the call to 'pop' on line 36 can write it — re-test 'xs[0]' after the call

// SOUNDNESS FLOOR FOR THE LITERAL-SUBSCRIPT CELL NARROWING. A guard narrows the CELL
// `m[1]`, and a call that can REMOVE that cell ends the narrowing — otherwise the read
// after it is a `vl check`-clean recover of a key that is no longer there.
//
// `delete` reaches neither of the general legs: it is an INTRINSIC (no callee body to take a
// write summary from), and `callArgPlaces` puts a receiver in the argument list only for a
// UFCS call to a user function. Both key spellings and the LIST twin (`pop`) are here, since
// one rule serves all three.

export function intCell() {
  const m: {[i32]: string | f64} = Map()
  m[1] = "x"
  if m[1] is string {
    m.delete(1)
    print(m[1])
  }
}

export function strCell() {
  const n: {[string]: string | f64} = Map()
  n["a"] = "x"
  if n["a"] is string {
    n.delete("a")
    print(n["a"])
  }
}

export function listCell() {
  const xs: (string | f64)[] = ["x"]
  if xs[0] is string {
    xs.pop()
    print(xs[0])
  }
}
