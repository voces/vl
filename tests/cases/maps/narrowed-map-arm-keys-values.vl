// @run
// @log 2
// @log 2
// D1805: `.keys()` and `.values()` on a map arm recovered from `{[string]: i32} | i32` by an `is`
// test reserve their scratch frame.
function mkInner(): {[string]: i32} {
  const m: {[string]: i32} = Map()
  m["a"] = 1
  m["b"] = 2
  m
}
function mkBox(): {[string]: i32} | i32 { mkInner() }
const v = mkBox()
if v is {[string]: i32} {
  print(v.keys().length)
  print(v.values().length)
} else {
  print(-1)
}
