// @run
// @log 5
// @log 7
// @log s
// @log 9000000000
// A map read narrowed past `null` prints from its box when the map's value is a union ALIAS:
// the narrowing names the alias, whose members are counted, not its spelling (D3511).
type U = i32 | i64
type V = i32 | string
type D = 9000000000 | 1
const m: { [string]: U } = Map()
m["k"] = 5
if m["k"] != null { print(m["k"]) }
const w: { [string]: V } = Map()
w["k"] = 7
if w["k"] != null { print(w["k"]) }
w["k"] = "s"
if w["k"] != null { print(w["k"]) }
const d: { [string]: D } = Map()
d["k"] = 9000000000
if d["k"] != null { print(d["k"]) }
