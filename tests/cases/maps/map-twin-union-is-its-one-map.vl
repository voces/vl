// @run
// @log 1
// @log 1
// @log 2
// @log 1
// @log 7
// @log 1
// @log 1
// @log 2
// A union of a literal-union map and its plain base twin (`LM | IM`) is the one map both
// store as, at a list, a parameter, a return, a map value, a capture and a generic (D15540).
type LM = {[i32]: 1 | 2}
type IM = {[i32]: i32}
function lenOf<T>(m: {[i32]: T}): i32 { m.length }
function mkL(): LM | IM {
  const m: LM = Map()
  m.set(1, 1)
  m.set(2, 2)
  m
}
const mi: IM = Map()
mi.set(3, 4)
const u: LM | IM = mi
print([u].length)
function viaParam(x: LM | IM): i32 { lenOf(x) }
print(viaParam(mi))
print(lenOf(mkL()))
const held: {[string]: LM | IM} = Map()
held["k"] = u
const got = held["k"]
if got != null { print(lenOf(got)) }
function anyOf<T>(x: T): i32 { 7 }
print(anyOf(u))
const f = () => lenOf(u)
print(f())
const xs: (LM | IM)[] = []
xs.push(u)
xs.push(mkL())
print(lenOf(xs[0]))
print(lenOf(xs[1]))
