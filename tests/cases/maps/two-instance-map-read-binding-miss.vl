// @run
// @log null
// @log null
// @log 7
// @log 1.5
// A hole called at two map value types binds its map read at each instance's own box, so a
// miss prints `null` and a hit its value at both (D3398).
type A = { m: {[i32]: i32} }
type B = { m: {[i32]: f64} }
function mkA(): A {
  const v: {[i32]: i32} = Map()
  v[3] = 7
  { m: v }
}
function mkB(): B {
  const v: {[i32]: f64} = Map()
  v[3] = 1.5
  { m: v }
}
function use(r, k) {
  const x = r.m[k]
  print(x)
}
use(mkA(), 9)
use(mkB(), 9)
use(mkA(), 3)
use(mkB(), 3)
