// A union of maps that agree on the key reads by index, `.get`, `.has`, `.length` and `.keys()`
// member by member; an index or `.get` reads the union of the members' values or null (D10140).

function mk(b: boolean): {[string]: string} | {[string]: i32} {
  if b {
    const s: {[string]: string} = Map()
    s["k"] = "x"
    return s
  }
  const t: {[string]: i32} = Map()
  t["k"] = 7
  t["j"] = 8
  t
}
function rd(us: {[string]: string} | {[string]: i32}) {
  const a = us["k"]
  print(a ?? "none")
  print(us["zz"] ?? "miss")
  print(us.get("j") ?? "nog")
  print(us.has("j"))
  print(us.length)
  print(us.keys().length)
}
rd(mk(true))
rd(mk(false))
const s: {[string]: string} = Map()
s["k"] = "x"
const us: {[string]: string} | {[string]: string | null} = s
print(us["k"] ?? "none")
