// @run
// @log 2
// @log 1
// An ARRAY ELEMENT one rung deeper: a list of LISTS of i32-keyed maps. The peel in
// `i32MapSpellingLowerable` used to be exactly one `[]` deep and this file pinned the reject;
// the peel is a fixpoint now, and the position needed no new plumbing to open.

// The write is what proves it: a nested element row that handed back the wrong map struct
// would read a plausible length and trap here.
const xs: {[i32]: i32}[][] = [[Map()]]
xs[0][0][1] = 2
print(xs[0][0][1] ?? 0)
print(xs[0][0].length)
