// @run
// @log 2
// @log 1
// An ARRAY ELEMENT one rung deeper: a list of LISTS of i32-keyed maps. The element row is
// reached through the same list rungs as a string-keyed map's, at any depth.

// The write is what proves it: a nested element row that handed back the wrong map struct
// would read a plausible length and trap here.
const xs: {[i32]: i32}[][] = [[Map()]]
xs[0][0][1] = 2
print(xs[0][0][1] ?? 0)
print(xs[0][0].length)
