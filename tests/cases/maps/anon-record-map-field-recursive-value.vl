// @run
// @log 1
// @log 2
// @log 3
// An anonymous record holding a map whose value type is recursive (`Node` names itself) keys the
// map-value slot by the value's name, so the field is built and read back.
type Node = { v: i32, next: Node | null }
const m: {[string]: Node} = Map()
m["a"] = { v: 1, next: { v: 2, next: null } }
const o = { m: m, k: 3 }
const n = o.m["a"]
if n != null {
  print(n.v)
  const nx = n.next
  if nx != null { print(nx.v) }
}
print(o.k)
