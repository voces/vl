// @run
// @log 1
// @log 1
// @log yes
// @log no
// @log 1
// @log 1
// A literal-union value used as a MAP KEY. Its members are strings and its rep is the interned
// i32 atom, so the key boundary widens it to its member text — the same widen `print` performs,
// through the one home both consumers share. It was refused as `map key is not a string`, which
// is a statement about the rep and not about the value (D1724).
//
// One gate serves every consumer, so all four are here: the index read, `.get`, `.has` and
// `.delete`, plus the hole-parameter face where the WRITE side reaches the same gate.

type K = "red" | "green"
const src: K[] = ["green", "red"]

function reads(a: K) {
  const m = Map()
  m["green"] = 1
  print(m[a] ?? 0)
}

function gets(a: K) {
  const m = Map()
  m["green"] = 1
  print(m.get(a) ?? 0)
}

function asks(a: K) {
  const m = Map()
  m["green"] = 1
  if m.has(a) { print("yes") } else { print("no") }
}

function drops(a: K) {
  const m = Map()
  m["green"] = 1
  m.delete(a)
  if m.has("green") { print("yes") } else { print("no") }
}

// The hole-parameter face, where the write side reaches the same boundary: an annotated `K`
// destination is refused at check instead, which is a different row.
function writes(a) {
  const m = Map()
  m[a] = 1
  print(m["green"] ?? 0)
}

function setsIt(a) {
  const m = Map()
  m.set(a, 1)
  print(m["green"] ?? 0)
}

reads("green")
gets("green")
asks("green")
drops("green")
writes(src[0])
setsIt(src[0])
