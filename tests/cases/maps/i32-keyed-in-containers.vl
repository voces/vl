// @run
// @log 2.5
// @log 2
// @log 2.5
// @log 2
// @log true
// @log 2
// @hint redundant type annotation: `g` is inferred as `{[i32]: f64}[][]`
// @hint redundant type annotation: `fs` is inferred as `(() => {[i32]: f64})[]`

// An i32-keyed map DELIVERED to a container: a nested array, an array of map-returning
// closures, and a map value. Each lowers the way its STRING-keyed twin does. A union member
// that IS the map is the position that stays refused (`error-i32-keyed-position-union-member.vl`).

// Every cell WRITES through the container and reads back: one that hands back a map with the
// wrong struct reads a plausible length and traps on the write, so a read-only proof would
// pass on a miscompile.
function mk(): {[i32]: f64} {
  const m: {[i32]: f64} = Map()
  m.set(1, 2.5)
  return m
}

// A NESTED array of maps — two list layers.
const g: {[i32]: f64}[][] = [[mk()]]
g[0][0].set(2, 3.5)
print(g[0][0].get(1) ?? 0.0)
print(g[0][0].length)

// An ARRAY of map-returning CLOSURES: the arrow is not required to be top-level.
const fs: (() => {[i32]: f64})[] = [mk]
const got = fs[0]()
got.set(2, 3.5)
print(got.get(1) ?? 0.0)
print(got.length)

// A map VALUE that is itself an i32-keyed map.
const outer: {[string]: {[i32]: boolean}} = Map()
const inner: {[i32]: boolean} = Map()
inner.set(1, true)
outer.set("a", inner)
const back = outer.get("a")
if back == null {
  print(false)
  print(0)
} else {
  back.set(2, false)
  print(back.get(1) ?? false)
  print(back.length)
}
