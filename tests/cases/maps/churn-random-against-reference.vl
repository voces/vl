// @run
// @log 0 true 43
// REGRESSION (D2280): pseudo-random insert / overwrite / delete over 64 keys, an i32-keyed and a
// string-keyed map in lockstep, checked after every op against a flat reference list — `delete`'s
// answer, `.length`, a lookup, `has`, and a final `for` walk. Prints the mismatch count (0), that
// the walk saw exactly the live keys, and the live count.
const m: {[i32]: i32} = Map()
const s: {[string]: i32} = Map()
const ref: i32[] = []
for i in 0 until 64 { ref.push(-1) }
let seed = 12345
let live = 0
let bad = 0
for step in 0 until 20000 {
  seed = (seed * 1103515245 + 12345) & 2147483647
  const k = (seed >> 8) % 64
  const op = (seed >> 3) % 3
  if op == 2 {
    const had = m.delete(k)
    const hads = s.delete("key\{k}")
    if had != (ref[k] >= 0) || hads != had { bad = bad + 1 }
    if ref[k] >= 0 { live = live - 1 }
    ref[k] = -1
  } else {
    if ref[k] < 0 { live = live + 1 }
    m[k] = step
    s["key\{k}"] = step
    ref[k] = step
  }
  if m.length != live || s.length != live { bad = bad + 1 }
  const probe = (seed >> 16) % 64
  if (m[probe] ?? -1) != ref[probe] || (s["key\{probe}"] ?? -1) != ref[probe] {
    bad = bad + 1
  }
  if m.has(probe) != (ref[probe] >= 0) { bad = bad + 1 }
}
let n = 0
for k in m {
  if (m[k] ?? -1) != ref[k] { bad = bad + 1 }
  n = n + 1
}
print("\{bad} \{n == live} \{live}")
