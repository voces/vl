// @run
// @log 0
// @log 0
// @log 1
// D15546's store-free half: a record field's `Map()` that no write anywhere types runs at the
// unbound default, as `const m = Map()` does.
function u(a) { print(a.f.length) }
const r = { f: Map() }
u(r)
u({ f: Map() })
const h = { g: { f: Map() }, n: 1 }
print(h.n)
