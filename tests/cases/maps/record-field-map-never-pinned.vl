// @run
// @warning the element type of 'r.f' is never fixed by any write, so it is always empty — give it its type where it is built if a write was meant
// @warning the element type of a container this argument holds is never fixed by any write, so it is always empty — give it its type where it is built if a write was meant
// @warning the element type of 'h.g.f' is never fixed by any write, so it is always empty — give it its type where it is built if a write was meant
// @log 0
// @log 0
// @log 1
// D15546's store-free half: a record field's `Map()` that no write anywhere types runs at the
// unbound default, as `const m = Map()` does, and the warning names the binding and field.
function u(a) { print(a.f.length) }
const r = { f: Map() }
u(r)
u({ f: Map() })
const h = { g: { f: Map() }, n: 1 }
print(h.n)
