// @run
// @log aa
// @log 1
// @log true
// @log 1
// @log 1
// @log 2
// @log bb
// @log 1
// @log 2
// @log 2
// @hint redundant type annotation: `rdS` is inferred as `string`
// @hint redundant type annotation: `lnS` is inferred as `i32`
// @hint redundant type annotation: `hsS` is inferred as `boolean`
// @hint redundant type annotation: `ksS` is inferred as `i32`
// @hint redundant type annotation: `vsS` is inferred as `i32`
// @hint redundant type annotation: `rdI` is inferred as `string`
// @hint redundant type annotation: `fiI` is inferred as `i32`
// THE RESERVATION HALF — the half this family always misses.
//
// EVERY FUNCTION HERE HOLDS EXACTLY ONE MAP OP. The per-function scratch frames (the
// 15-slot map frame, the 5-slot i32-KEY frame, the `.keys()`/`.values()` builders, the
// per-mv-slot typed frames) are reserved by MEMBERSHIP SCANS over a function's
// statements, and a file where one function holds several ops hides a missed scan behind
// its neighbours: some other op in the same body reserved the frame the missed one then
// used. One op per function is the only shape that can fail.
//
// THE RECEIVER IS AN ARRAY ELEMENT in every one of them (`xs[0]`, never a bare local).
// That is the receiver form the scans are least likely to know — #1249 is the standing
// example, where `exprHasMapOp` had to learn a receiver shape before the frame it gates
// was reserved. It knows this one: every function below ran on master when the list was
// built from a pre-seeded binding, which is how this PR's measurement separated the
// CONSTRUCTOR defect from a reservation defect. This file is what keeps that true.
//
// BOTH KEY REPS in one module, because the i32-key frame (`mapI32Base`) is reserved only
// when `fnUsesMap && mI32Used` and the flag is module-wide: a file with only i32-keyed
// maps cannot tell a correctly-reserved frame from one whose absence happens not to
// collide. The `mkI` / `stI` pair below is exactly the cell that failed — the map-ARRAY
// annotation arm never set `mI32Used`, so `stI`'s key temporary landed on `mkI`'s
// map-ref index.
function mkS(): {[string]: string}[] { return [Map()] }
function stS(xs: {[string]: string}[]) { xs[0]["k"] = "aa" }
function rdS(xs: {[string]: string}[]): string { return xs[0]["k"] ?? "z" }
function lnS(xs: {[string]: string}[]): i32 { return xs[0].length }
function hsS(xs: {[string]: string}[]): boolean { return xs[0].has("k") }
function ksS(xs: {[string]: string}[]): i32 {
  const k = xs[0].keys()
  return k.length
}
function vsS(xs: {[string]: string}[]): i32 {
  const v = xs[0].values()
  return v.length
}
function puS(xs: {[string]: string}[]) { xs.push(Map()) }

function mkI(): {[i32]: string}[] { return [Map()] }
function stI(xs: {[i32]: string}[]) { xs[0][1] = "bb" }
function rdI(xs: {[i32]: string}[]): string { return xs[0][1] ?? "z" }
function fiI(xs: {[i32]: string}[]): i32 {
  let n = 0
  for kk in xs[0] { n = n + 1 }
  return n
}
function puI(xs: {[i32]: string}[]) { xs.push(Map()) }

function go() {
  const s = mkS()
  stS(s)
  print(rdS(s)) // aa
  print(lnS(s)) // 1
  print(hsS(s)) // true
  print(ksS(s)) // 1
  print(vsS(s)) // 1
  puS(s)
  print(s.length) // 2

  const i = mkI()
  stI(i)
  print(rdI(i)) // bb
  print(fiI(i)) // 1
  puI(i)
  print(i.length) // 2
  print(s.length) // 2 — the string list is untouched by the i32 work
}
go()
