// @run
// @log 70
// @log 1
// @log 71
// @log 9
// D672. TWO OWNER LITERALS JOINED BY `??` ARE ONE ROW WITH A BOXED FIELD.
//
// `{ r: { c2: 1 } }` and `{ r: { s2: 9 } }` share the field-name set `{r}` and disagree at
// `r`. D391's `anonNestPolyPremint` gives each its OWN anonymous row, which is right for two
// SEPARATE owners (`anon-nested-arm-layout-polymorphic.vl` reads `p.r.c2` monomorphically
// and needs exactly that). It is wrong for a pair a `??` makes into ONE value: the map's
// value slot picks the first row, the default is lowered against it, and `emitObj` reported
// `object literal is missing a struct field` — naming `c2`, a field this program never
// writes.
//
// THE ROW THE PAIR NEEDS ALREADY HAS A SPELLING. Add `type Circle = { r: Shape2 }` and this
// program has run on every recent compiler (silent-class-inventory D210, a refutation pin):
// both literals adopt `Circle`, whose `r` is a union box, and each nested literal boxes as
// its arm. `anonNestPolyUnionName` mints that row when nobody declared it. Off
// `./node_modules/.bin/wasm-dis` the result is D210's module — ONE owner row
// `(struct (field (mut (ref $box))))` over the shared `{tag, value}` box.
//
// BOTH ARMS ARE READ, which is what makes this a layout test rather than a message test: a
// collapse onto one arm's nested struct answers `is Cir2` for both and the wrong field read
// would be invalid wasm, which the harness catches as a module that will not instantiate.
type Cir2 = { c2: i32 }
type Sq2 = { s2: i32 }
type Shape2 = Cir2 | Sq2

const c = Map()
c["k0"] = { r: { c2: 1 } }

// The HIT arm: the stored value, whose `r` is the `Cir2` arm.
const hit = (c)["k0"] ?? { r: { s2: 9 } }
if (hit).r is Cir2 { print(70) } else { print(0) }
if (hit).r is Cir2 { print((hit).r.c2) } else { print(0) }

// The MISS arm: the `??` default, whose `r` is the `Sq2` arm — the payload the collapse
// this row is about would have lost.
const miss = (c)["nope"] ?? { r: { s2: 9 } }
if (miss).r is Cir2 { print(0) } else { print(71) }
if (miss).r is Sq2 { print((miss).r.s2) } else { print(0) }
