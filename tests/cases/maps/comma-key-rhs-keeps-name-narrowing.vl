// @run
// @log 2
// A right operand that writes the key `,x,` drops that key's fact from the condition and keeps
// the fact about the name `x` (D6442).
const m: {[string]: i32 | null} = Map()
m[",x,"] = 2
function clr() {
  m[",x,"] = null
  true
}
function run(x: i32 | null) {
  if x != null && m[",x,"] != null && clr() { print(x + 1) }
}
run(1)
