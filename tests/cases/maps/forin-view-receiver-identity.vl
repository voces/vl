// @run
// @log S
// @log first
// @log 1
// @log S
// @log p
// @log q
// @log S
// @log z
// @log S
// @log 1
// @log 1
// LOG-MISMATCH FIXTURE — the IDENTITY consequence of the evaluation count, pinned as
// a WRONG VALUE rather than only an extra marker line. Every receiver here is a
// FACTORY that hands back a FRESH, DIFFERENTLY-POPULATED map on each call, so a
// second evaluation of the receiver is observable in the values themselves: the loop
// would walk a map the program never named.
//
// Legs:
//   L1  fresh-per-call keys: a walk over a later evaluation prints that map's keys
//       (`second`), so the value — not just the count — is wrong.
//   L2  SHRINKING factory (2 entries then 1): the loop BOUND is the walked list's
//       `len`, so a second evaluation truncates the walk to the second map's single
//       entry.
//   L3  GROWING factory (1 entry then 2): the bound and the tombstone `live[]` array
//       would come from DIFFERENT maps, so the walk reads `live[1]` out of the first
//       map's shorter array and silently drops an entry.
//   L4  the observable call COUNT itself, printed by the program.
// Together they pin that the walked list, the loop bound and `live[]` are all read
// off ONE evaluation.
//
// WHY THIS HID: a value-only oracle over a receiver that returns the SAME map every
// call cannot distinguish one evaluation from two — which is every existing map
// for-in case in the corpus. Only a factory receiver makes the count visible as a
// value, which is what this file is for.

let n1 = 0

function fresh1(): {[string]: i32} {
  print("S")
  n1 = n1 + 1
  const m: {[string]: i32} = Map()
  if n1 == 1 {
    m["first"] = 1
  }
  if n1 == 2 {
    m["second"] = 2
  }
  return m
}

// L1 — keys AND values off the one evaluation.
for k in fresh1().keys() {
  print(k) // first
}
print(n1) // 1

let n2 = 0

function shrink(): {[string]: i32} {
  print("S")
  n2 = n2 + 1
  const m: {[string]: i32} = Map()
  if n2 == 1 {
    m["p"] = 1
    m["q"] = 2
  }
  if n2 == 2 {
    m["z"] = 9
  }
  return m
}

// L2 — the loop bound is the FIRST evaluation's length (2), not the second's (1).
for k in shrink().keys() {
  print(k) // p, q
}

let n3 = 0

function grow(): {[string]: i32} {
  print("S")
  n3 = n3 + 1
  const m: {[string]: i32} = Map()
  if n3 == 1 {
    m["z"] = 9
  }
  if n3 == 2 {
    m["p"] = 1
    m["q"] = 2
  }
  return m
}

// L3 — the bound and `live[]` agree because they are one map: exactly one entry.
for k in grow().keys() {
  print(k) // z
}

let n4 = 0

function counted(): {[string]: i32} {
  print("S")
  n4 = n4 + 1
  const m: {[string]: i32} = Map()
  m["k"] = n4
  return m
}

// L4 — the stored value IS the call count, and the count is printed after the walk,
// so both halves of the same fact are pinned.
for v in counted().values() {
  print(v) // 1
}
print(n4) // 1
