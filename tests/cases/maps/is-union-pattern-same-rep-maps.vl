// @run
// @log bool
// @log i-or-s
// @log i-or-s
// D2493 through a union pattern: `is {[i32]: i32} | string` names one of two same-rep maps and
// tests its own tag, so the boolean map falls to the else branch.
const mb: {[i32]: boolean} = Map()
mb.set(1, true)
const mi: {[i32]: i32} = Map()
function f(u: {[i32]: i32} | {[i32]: boolean} | string) {
  if u is {[i32]: i32} | string { print("i-or-s") } else { print("bool") }
}
f(mb)
f(mi)
f("s")
