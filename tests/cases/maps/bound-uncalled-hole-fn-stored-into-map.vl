// @run
// @log 1
// @log 1
// @log 1
// @log 2
// @log 4
// @info `r` is never reassigned; use `const` instead of `let`
// A binding never rewritten, holding an un-annotated function nothing calls or a record of one,
// stored into an un-annotated map is served by the uncalled function's stub (D16202).
function inc0(a) { return a + 1 }
function inc1(a) { return a + 1 }
const m = Map()
const inner = { f: inc0 }
m["k"] = inner
print(m.length)
const n = Map()
const g = inc0
n.set("k", g)
print(n.length)
function run() {
  const p = Map()
  let r = { f: inc0 }
  p["k"] = r
  print(p.length)
}
run()
const q = Map()
const s = { f: inc0 }
q["a"] = s
q["b"] = { f: inc0 }
print(q.length)
const c = Map()
const t = { f: inc1 }
c["k"] = t
const u = c.get("k")
if u != null { print(u.f(3)) }
