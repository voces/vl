// @run
// @log b
// @log none
// @log a
// A map read of a literal-union-valued map is the member or `null`: the probe's miss is the
// `K | null` niche's `-1`, so the read is that nullable atom as it stands.
type AB = "a" | "b"
function look(m: {[string]: AB}, k: string) {
  const v = m[k]
  if v == null { print("none") } else { print(v) }
}
function first(m: {[string]: AB}) { return m["x"] ?? "a" }
function go() {
  const m: {[string]: AB} = Map()
  m["x"] = "b"
  look(m, "x")
  look(m, "z")
  const e: {[string]: AB} = Map()
  print(first(e))
}
go()
