// @run
// @log 6
// @log 6
// A record of an un-annotated function, bound to a `const` and then set into an un-annotated
// `Map()`, is the map's value; so is the same set after an inline record's (D9533).
function dbl(a) { return a * 2 }
const m = Map()
const r0 = { f: dbl }
m.set("b", r0)
const r = m.get("b")
if r != null { print(r.f(3)) }
function inc0(a) { return a + 1 }
const n = Map()
n.set("a", { f: inc0 })
const r1 = { f: dbl }
n.set("b", r1)
const q = n.get("b")
if q != null { print(q.f(3)) }
