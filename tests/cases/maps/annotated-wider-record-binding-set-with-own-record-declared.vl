// @run
// @log 4
// D3350's annotated spelling: the binding declared at the wider record, set into a map of it,
// while a record of the literal's own fields is declared.
type O = { v: i32 }
type I = { f: O }
type J = { f: O | null }
const s: J = { f: { v: 4 } }
const m = Map<string, J>()
m.set("a", s)
const x = m.get("a") ?? { f: { v: 9 } }
print(x.f?.v ?? 70)
