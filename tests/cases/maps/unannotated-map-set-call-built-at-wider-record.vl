// @run
// @log 5
// @log 4
// An un-annotated `Map()` holds its values at the record its stored call is built as: `mk()`
// is built at `J` for `wideJ`, so the map's value row is `J`, not `mk`'s own shape (D14517).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const wideJ: J = mk()
const m = Map()
m.set("a", mk())
const x = m.get("a")
if x != null { print(x.f + 1) }
print(wideJ.f ?? 0)
