// @emit-error an i64-keyed Map/Set is supported as a binding / parameter / return / `| null` / an ARRAY ELEMENT at any depth / a closure result / a MAP VALUE / a struct or variant FIELD — not inside
// D2505: the i64-keyed twin of `error-i32-keyed-position-union-member.vl`. A member that IS
// the map lowers into the shared union box, which records no map struct, so the i64 key meets
// the same position gate as the i32 one (`open-rulings.md` §B6a-map-in-union-box). The same map
// as a FIELD of an arm runs (`i64-keyed-in-containers.vl`).
const m: {[i64]: i32} = Map()
m[4294967297] = 7
const u: {[i64]: i32} | i32 = m
if u is {[i64]: i32} { print(u.length) } else { print(-1) }
