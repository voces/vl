// @run
// @log 7
// @log 16
// @hint redundant type annotation: `cell` is inferred as `i32`
// @hint redundant type annotation: `c` is inferred as `{r: i32}`
// Regression (silent-class-inventory D47 + D50, at the ONE coordinate that needs both).
// A `for v in m.values()` over an arm-VALUED map, spelled INLINE at the binding.
//
// THE TWO ROOTS COMPOSE HERE AND NEITHER FIX REACHES IT ALONE, which is what the ablation
// says: with only D50's variant loop var the map still takes the `-3` map-value floor
// ("unsupported map value type"), and with only D47's arm key the map lowers and the walk
// then takes D50's ("field access receiver is not a struct"). 34 of the grid's 1,024 cells
// sit in that composition zone and every one of them is a `mapval` × `for`-in.
//
// The `.values()` half of `forInRefArrayStructIdx` has DECLINED an arm-valued map since
// D34 (`if mvValVariantOf(mvs) >= 0 { return -1 }`) — the variant row was sitting in the
// column the decline reads, and nothing asked for it. `forInRefArrayVariantIdx` is that
// decline read forwards.

type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq

function cell(): i32 {
  const m: {[string]: Circle} = Map()
  const c: Circle = { r: 7 }
  m["k"] = c
  m["j"] = { r: 9 }
  const g = m["k"]
  if g != null { print(g.r) }
  let t = 0
  for v in m.values() { t = t + v.r }
  return t
}

print(cell())
