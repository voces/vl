// @run
// @log true
// @log false
// @log b
// @log 3
// @log false
// A map's record value read where a twin record row of another map is typed: read as stored,
// then delivered at the read's rep by the one conversion: a guard, a binding, an argument.
type K = "a" | "b"
const m: { [string]: { f: i32 | string } } = Map()
const mk: { [string]: { f: i32 | K } } = Map()
mk["k"] = { f: 3 }
mk["j"] = { f: "b" }
if mk["k"] != null { print(mk["k"].f is i32) }
if mk["j"] != null { print(mk["j"].f is i32) }
const v = mk["j"]
if v != null { print(v.f) }
function g(m: { [string]: { f: i32 | K } }) {
  if m["k"] != null { print(m["k"].f) }
}
g(mk)
m["x"] = { f: "s" }
if m["x"] != null { print(m["x"].f is i32) }
