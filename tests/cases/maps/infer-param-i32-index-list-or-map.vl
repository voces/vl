// @run
// @log true
// @log hi
// @log true
// @log 5
// @log 4
// An i32 index on an un-annotated parameter takes a list, a string or an i32-keyed map: the
// call resolves the index against the argument, and each instance reads it at its own type.
function takeAt(q) { print(q[1] ?? false) }
const m: {[i32]: boolean} = Map()
m[1] = true
takeAt(m)
const n: {[i32]: string} = Map()
n[1] = "hi"
function show(q) { print(q[1] ?? "none") }
show(n)
takeAt([false, true])
function first(c) { return c[1] ?? 0 }
const k: {[i32]: i32} = Map()
k[1] = 5
print(first(k))
print(first([3, 4]))
