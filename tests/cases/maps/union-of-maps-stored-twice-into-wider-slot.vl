// @run
// @log 2
// @log 1
// @log x
// @log 2
// @log x
// @log 2
// @log x

// A store that replaces the handle in a container slot writes nothing into the union of maps
// the slot held, so a second store of the source, an alias of it, or a fresh map there is not
// refused (D10070).

const s: {[string]: string} = Map()
s["k"] = "x"
const us: {[string]: string} | {[string]: string | null} = s
const hm: {[string]: {[string]: string | null}} = Map()
hm.set("p", us)
hm.set("q", us)
print(hm.length)

const w: {[string]: string | null} = us
const hw: {[string]: {[string]: string | null}} = Map()
hw.set("p", w)
print(hw.length)
print(w["k"] ?? "none")

const hi: {[string]: {[string]: string | null}} = Map()
hi.set("p", us)
hi["q"] = us
const fresh: {[string]: string | null} = Map()
hi["p"] = fresh
print(hi.length)
print(s["k"] ?? "none")

const xs: {[string]: string | null}[] = []
xs.push(us)
xs.push(us)
xs[0] = fresh
print(xs.length)
print(s["k"] ?? "none")
