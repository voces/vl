// @run
// @log 4
// @log n
// @log 4
// @log n
// @log 4
// @log n
// @log s
// @log n
// A nullable map bound by a loop, annotated or not and at a generic instance, is a map that
// may be null, never a list, whatever spelling its binding has.
const mi: {[string]: i32} = Map()
mi["x"] = 4
const ann: {[string]: {[string]: i32} | null} = Map()
ann["a"] = mi
ann["b"] = null
for k, v in ann {
  if v != null { print(v["x"] ?? 0) } else { print("n") }
}
const una = [mi, null]
for v in una {
  if v != null { print(v["x"] ?? 0) } else { print("n") }
}
function gen<T>(x: T) {
  const inner: {[string]: T} = Map()
  inner["x"] = x
  const ms: {[string]: {[string]: T} | null} = Map()
  ms["a"] = inner
  ms["b"] = null
  for k, v in ms {
    if v != null { print(v["x"] ?? x) } else { print("n") }
  }
}
gen(4)
gen("s")
