// @run
// @log 1
// @log 1
// @log false
// A numeric literal value and a union of literals store alike, one i32 cell, so the map is
// shared, not refused as stored differently.
function f(w: {[string]: 1 | 2}) { w.length }
const m: {[string]: 1} = Map()
m["k"] = 1
print(f(m))
const n: {[i64]: 1 | 2} = Map()
n[4294967296] = 2
const v: {[i64]: 1 | 2 | 3} = n
print(v.length)
print(v[4294967296] == null)
