// @run
// @log 1
// @log 2
// @log 2
// @log true
// @log false
// @log -1
// @log x
// @log y
// @log 2
// @log true
// @log 1
// @log 2
// @log 1
// @log 2
// @log twenty
// @log 0
// USAGE-DRIVEN INFERENCE through the INDEX-WRITE spelling. `m[k] = v` pins a bare
// `Map()`'s key and value holes in place exactly as `m.set(k, v)` does
// (`infer-from-set.vl`) and as `xs[i] = v` pins an empty `[]`'s element — the two
// WRITE spellings of one program have to infer identically, and the index one used
// to fall to the "cannot infer … annotate" floor instead.
//
// BOTH key reps are here, because the pin is key-BLIND: the string key and B6a's
// mono i32 key take the same one rule. The i32 half is the shape whose annotated
// `{[i32]: string}` twin has always run.
const ms = Map()
ms["a"] = 1
ms["b"] = 2
print(ms["a"] ?? -1) // 1
print(ms["b"] ?? -1) // 2
print(ms.length) // 2
print(ms.has("a")) // true
print(ms.has("z")) // false
print(ms.get("missing") ?? -1) // -1 — absent

const mi = Map()
mi[1] = "x"
mi[2] = "y"
print(mi[1] ?? "none") // x
print(mi.get(2) ?? "none") // y
print(mi.length) // 2
print(mi.has(1)) // true
mi.delete(1)
print(mi.length) // 1
for k in mi {
  print(k) // 2
}
print(mi.keys().length) // 1

// A `let` binding, and the two write spellings MIXED: whichever runs first pins the
// holes, and the second checks against the pin rather than re-opening it.
let mx = Map()
mx[10] = "ten"
mx.set(20, "twenty")
print(mx.length) // 2
print(mx[20] ?? "none") // twenty
mx = Map()
print(mx.length) // 0
