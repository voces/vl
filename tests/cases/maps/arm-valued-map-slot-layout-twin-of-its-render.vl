// @run
// @log 7
// @log 7
// @log 7
// @log 7
// GRADUATED from the D88/D100 grid's residue (silent-class-inventory D123, rungs 1 and 2,
// 2026-08-27). Each program below is one of that grid's `check-clean invalid wasm` cells,
// verbatim; together they are the four coordinates its 56 moved cells occupy —
// `mapval x std`, `nestedmap x gen`, `nestedmap x std`, and the `armdiff` level that says
// the layout twin is NOT what makes them fail.
//
// WHAT THEY PIN IS ONE SENTENCE: two mv slots that interned the SAME vals ref-list slot are
// ONE map struct, and the row whose heap that element holds is the CANONICAL twin's row.
//
// `repMapValSlotsTwin`'s kind-1 arm asked a PROXY for the first half — the arm-identity
// split D34 installed — and the proxy is stricter than the layout it guards. Probed at the
// mint on program 1:
//
//   slot=0 name=Circle   kind=1 canon=1 rl=0 rlwrap=9 rep=0
//   slot=1 name={r:i32}  kind=1 canon=1 rl=0 rlwrap=9 rep=1
//   rl=0 nm=Circle k=1 heap=1 wrap=9
//
// One ref-list slot, one wrapper, two map structs. `rlSlotsLayoutTwin` is the ref-list
// layer's own pairwise equivalence and answers this directly; it was exported, imported,
// and already called ONE BRANCH DOWN by the kind-6 arm.
//
// AND MERGING THE SLOTS IS ONLY HALF OF IT. With the two slots sharing a heap, the value
// SEEDS still read `mvValVariantIdx` / `mvValStructIdx` off the slot the spelling minted,
// so the store at `i0["k"] = { r: n }` still built the inline `{r:i32}` row — `struct.new 0`
// into an array of `(ref null 1)`. The three value-build boundaries (the map STORE, the
// `??` DEFAULT, the `?.` field read) now read those two columns through `mvCanonRepOf`, the
// same chokepoint the heap mint, the union-box tag and the arm-slot guard already use.
// Ablated: the comparator rung alone moves 8 of the grid's 100 cells, the seed read alone
// moves 0, and the two together move 56 — a COMPOSITION, not one root stated twice.
//
// THE D34 REFUSAL IS UNTOUCHED and `tests/cases/maps/arm-valued-map-beside-layout-twin.vl`
// is where that is pinned: `{[string]: Circle}` beside `{[string]: Dot}` interns two
// ref-list rows (the arm's `uVarHeap[Circle]` and `Dot`'s `sHeapIdx`), `rlSlotsLayoutTwin`
// declines a row whose `rlElemStructRow` is -1, and the pair stays two heaps. That file's
// module is byte-identical across this change, as is every corpus file but seven.
//
// STILL OPEN, and deliberately not papered over: with an EXACT struct twin declared
// (`type Dot = { r: i32 }`), the render `{r:i32}` resolves to `Dot` before it can reach the
// arm, the two slots genuinely hold two heaps, and no seam merges them —
// silent-class-inventory D139, pinned at
// `tests/cases/soundness/xfail-miscompile-arm-valued-map-beside-struct-twin.vl`.

// 1 — `arm x mapval x std x param` (cell arm_declname_mapval_std_param_ann0_norm)
import { reverse } from "std:array"
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function thru(x: {[string]: Circle}) { return x }
function mk(n: i32) {
  const c = Map()
  c["k"] = { r: n }
  return reverse([thru(c)])[0]
}
print(((mk(7))["k"] ?? { r: 0 }).r)

// 2 — `arm x nestedmap x gen x param` (cell arm_declname_nestedmap_gen_param_ann0_norm)
function idg<T>(x: T): T { return x }
function thru2(x: {[string]: {[string]: Circle}}) { return x }
function mk2(n: i32) {
  const i0 = Map()
  i0["k"] = { r: n }
  const c = Map()
  c["o"] = i0
  return idg(thru2(c))
}
print((((mk2(7))["o"] ?? Map())["k"] ?? { r: 0 }).r)

// 3 — `arm x nestedmap x std x retann` (cell arm_declname_nestedmap_std_retann_ann0_norm):
// the container annotation on the RESULT rather than on a parameter
function mk3(n: i32): {[string]: {[string]: Circle}} {
  const i0 = Map()
  i0["k"] = { r: n }
  const c = Map()
  c["o"] = i0
  return reverse([c])[0]
}
print((((mk3(7))["o"] ?? Map())["k"] ?? { r: 0 }).r)

// 4 — `armdiff x nestedmap x gen x paramlocal`: a declared struct of a DIFFERENT field set
// is present, so the layout twin is not the trigger; the parameter is re-bound to a local
type Dot = { q: i32 }
function thru4(x: {[string]: {[string]: Circle}}) {
  const y = x
  return y
}
function mk4(n: i32) {
  const i0 = Map()
  i0["k"] = { r: n }
  const c = Map()
  c["o"] = i0
  return idg(thru4(c))
}
print((((mk4(7))["o"] ?? Map())["k"] ?? { r: 0 }).r)
