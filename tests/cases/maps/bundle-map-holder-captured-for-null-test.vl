// @run
// @log true
// @log 2.5
// @log 3
// @hint Intentionally-unused variable `_a`
// @hint Intentionally-unused variable `_b`
// A nullable holder of a map's two-signature bundle, captured by a lambda that only tests it for
// `null`, keeps the bundle record (D17585).
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
function inFn() {
  const k = Map()
  k["a"] = lap((a) => a + 1)
  const g = k["a"]
  const seen = () => g != null
  print(seen())
  if g != null {
    print(g(1.5))
    print(g(2))
  }
}
inFn()
