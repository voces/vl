// Two scalar map reads compared, or one against a `V | null` value: equal when both miss, or
// both hit and their values agree, at every value kind.
const m: {[string]: i32} = Map()
m["a"] = 1
m["b"] = 1
m["c"] = 2
print(m["a"] == m["b"])
print(m["a"] != m["b"])
print(m["a"] == m["c"])
print(m["a"] != m["q"])
print(m["q"] == m["r"])
const nu: i32 | null = null
print(nu != m["q"])
const mf: {[string]: f64} = Map()
mf["x"] = 1.5
mf["y"] = 1.5
print(mf["x"] == mf["y"])
const mi: {[string]: i64} = Map()
mi["x"] = 3 as i64
print(mi["x"] != mi["w"])
const mb: {[string]: boolean} = Map()
mb["t"] = true
print(mb["t"] == mb["u"])
const m32: {[string]: f32} = Map()
m32["p"] = 0.5 as f32
print(m32["p"] == m32["p"])
function f(k: string, j: string) { return m[k] == m[j] }
print(f("a", "b"))
print(f("a", "zz"))
print(f("y", "zz"))
print(f("c", "b"))
