// @run
// @log 1
// @log 2
// @log 3
// @log 4
// @log 5
// @log 6
// @log 7
// @log 8
// @log 9
// THE POSITION AND VALUE-KIND EVIDENCE for the map arm of `singleAliasMemberTyIx`, kept as a
// fixture because the arm carries NO gate and a gate is exactly what a later slice would be
// tempted to add. Its sibling `alias-annotation-is-transparent.vl` pins the headline; this
// one pins the two axes the arm was measured on.
//
// AXIS 1 — POSITION. `type M = {[string]: i32}` in a function PARAMETER, a function RETURN, a
// function-LOCAL binding, under `| null` (both arms), as an ARRAY element and as a UNION
// member. Every one of these was a checker or emit reject on the parent commit.
//
// AXIS 2 — VALUE KIND, which is where the array arm's precedent does NOT transfer. D-ALIASARR
// gated its member on `arrSpineIsScalar` because `tyToEmitName` re-renders an array's element
// and so DROPS a declared element's name — `Cat[]` becomes `{n:i32}[]` and the emitter's
// element tables lose the row they key on. The map arm has no such exposure: `tyToEmitName`'s
// map arm emits `{[K]:V}` whatever `V` is, so a map name is never an emit route and there is
// nothing for the alias to lose. `Pt` below is a DECLARED struct standing as the alias's map
// value; on the parent that was `emitProgram: a map value is not a supported union member`,
// and there is no cell anywhere in the 73-cell twin table where the alias spelling worked on
// the parent and this arm took it away.
//
// NOT COVERED HERE, ON PURPOSE — a map whose value is NOT the mono-i32 kind (`f64`, `string`,
// a struct, a nullable) is invalid wasm as an ARRAY ELEMENT or as another map's VALUE. That is
// a pre-existing EMITTER defect, not this arm's: all ten such cells fail identically with no
// alias anywhere in the program, on the parent. `xs` and `deep` below therefore use `i32`
// values, which is the kind those two positions do lower.
type M = {[string]: i32}
type Pt = { x: i32 }
type P = {[string]: Pt}

const a: M = Map()
a["k"] = 9

// POSITION: function PARAMETER.
function size(m: M) { return m.length }
print(size(a)) // 1

// POSITION: function RETURN.
function make(): M {
  const r: M = Map()
  r["p"] = 1
  r["q"] = 2
  return r
}
print(make().length) // 2

// POSITION: function-LOCAL binding.
function local() {
  const t: M = Map()
  t["a"] = 1
  t["b"] = 2
  t["c"] = 3
  return t.length
}
print(local()) // 3

// POSITION: under `| null`, both arms.
const maybe: M | null = null
if maybe == null { print(4) } else { print(0) } // 4
const present: M | null = a
if present == null { print(0) } else { print(5) } // 5

// POSITION: ARRAY element (i32 values — see the header note).
const xs: M[] = []
xs.push(a)
xs.push(make())
print(xs[0].length + xs[1].length + 3) // 1 + 2 + 3 = 6

// VALUE KIND: a DECLARED STRUCT as the map's value — the shape the array arm's gate exists
// for, and which needs no gate here.
const pts: P = Map()
pts["o"] = { x: 1 }
const got = pts["o"]
if got == null { print(0) } else { print(got.x + 6) } // 7

// POSITION: UNION member beside a scalar.
type U = M | i32
const u: U = 8
if u is i32 { print(u) } else { print(0) } // 8

// A map alias as another map alias's VALUE, read back through both levels.
const deep: {[string]: M} = Map()
deep["d"] = a
const inner = deep["d"] ?? Map()
print(inner["k"] ?? 0) // 9
