// @run
// @log 0
// @log false
// @log 2
// @log 0
// @log 1
// @log 0
// @log 6
// @log 0
// @log 30
// @log 0
// @log 1
// @log 0
// `m.clear()` empties the map object itself, so every handle on it sees it empty: an alias, a
// list element, a record field, a module global, a closure capture, and a walk in progress.
type Holder = { m: Map<string, i32> }

const g: Map<i32, i32> = Map()

function clearGlobal() { g.clear() }

function main() {
  const m: Map<string, i32> = Map()
  m["a"] = 1
  const alias = m
  alias.clear()
  print(m.length)
  print(m.has("a"))
  m["b"] = 2
  print(alias["b"] ?? -1)

  const ms: Map<string, i32>[] = [Map(), Map()]
  ms[0]["x"] = 1
  ms[1]["y"] = 2
  ms[0].clear()
  print(ms[0].length)
  print(ms[1].length)

  const h: Holder = { m: Map() }
  h.m["k"] = 5
  h.m.clear()
  print(h.m.length)
  h.m["k"] = 6
  print(h.m["k"] ?? -1)

  g[1] = 10
  g[2] = 20
  clearGlobal()
  print(g.length)
  g[2] = 30
  print(g[2] ?? -1)

  const c: Map<i32, string> = Map()
  c[7] = "seven"
  const wipe = () => {
    c.clear()
  }
  wipe()
  print(c.length)

  const w: Map<i32, i32> = Map()
  w[1] = 1
  w[2] = 2
  w[3] = 3
  let steps = 0
  for k in w.keys() {
    steps = steps + 1
    w.clear()
  }
  print(steps)
  print(w.length)
}

main()
