// @error the assignment on line 12 writes a widened field
// A union of maps stored twice into a wider map-valued slot still refuses once a store writes
// into the value the slot holds, since that value is the source (D10070).

const s: {[string]: string} = Map()
s["k"] = "x"
const us: {[string]: string} | {[string]: string | null} = s
const hm: {[string]: {[string]: string | null}} = Map()
hm.set("p", us)
hm.set("q", us)
const got = hm["p"]
if got != null { got["k"] = null }
print(hm.length)
