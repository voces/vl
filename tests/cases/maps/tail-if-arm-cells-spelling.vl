// @run
// @log 7
// @log 7
// @hint redundant type annotation: `gc` is inferred as `{[string]: S}`
// A tail `if` whose arms assign an annotated and an un-annotated map cell of one shape: the
// cells agree by their map shape, not by their type spelling, so the result is that map.

type S = { a: i32 }

function mkR(v: i32): {[string]: S} {
  const m: {[string]: S} = Map()
  m["a"] = { a: v }
  return m
}

let gd = mkR(0)
let gc: {[string]: S} = mkR(1)

function fc(c: boolean) {
  if c { gc = mkR(8) } else { gd = mkR(7) }
}

function fl(c: boolean) {
  let loc = mkR(1)
  if c { gc = mkR(8) } else { loc = mkR(7) }
}

const r = fc(false)
const v = r["a"]
if v != null { print(v.a) }
const q = fl(false)
const w = q["a"]
if w != null { print(w.a) }
