// @emit-error unsupported i32-keyed map value type 'string'
// CAPABILITY (B6a, i32-keyed half): the i32-keyed rep is the MONO map — its
// `vals` is the shared i32 list — so its value types are exactly the ones that
// ride that list (`mvValKindOfName == -1`: i32, boolean, a literal-union atom, a
// nullable atom). A value that would intern an mv SLOT needs a per-value
// i32-keyed map struct, and none is minted, so it is a LOUD reject at the
// unsupported-lowering tier rather than a mono-shaped lowering against the
// string-keyed struct (invalid wasm, which `vl check` cannot see).
//
// `vl check` accepts the TYPE — `{[i32]: string}` is a perfectly well-formed
// `TyMap`, and the checker is deliberately not the place that knows which value
// reps the emitter has minted. That is why this is `@emit-error`, not `@error`.
const m: {[i32]: string} = Map()
m[1] = "a"
print(m[1] ?? "z")
