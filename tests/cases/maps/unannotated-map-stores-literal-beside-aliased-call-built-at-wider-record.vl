// @run
// @log 5
// @log 4
// @log 4
// D14644: a literal stored into a map whose value a call builds at a wider record runs at that build.
type J = { f: i32 | null }
function mk() { { f: 4 } }
function main() {
  const wideJ: J = mk()
  const m = Map()
  const a = mk()
  m.set("a", { f: 4 })
  const x = m.get("a")
  if x != null { print(x.f + 1) }
  const b = a
  print(b.f)
  print(wideJ.f ?? 0)
}
main()
