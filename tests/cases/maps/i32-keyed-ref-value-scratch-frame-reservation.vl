// @run
// @log 1
// @log true
// @log x
// @log true
// @log 1
// @log 1
// @log 1
// @log 2
// THE RESERVATION HALF, for an i32-keyed map with a REF value — the half this family
// always misses, measured rather than argued.
//
// EVERY FUNCTION HOLDS EXACTLY ONE MAP OP. That is the whole design of the file: the
// scratch frames are reserved per FUNCTION by membership scans (`fnHasMap`,
// `exprHasMapOp`, `blockHasMapOp`, `forInMapRecv`, `startFnDetectScratch`) that walk for
// map OPERATIONS and RECEIVER FORMS, so a scan that missed one of these receivers would
// let the lowering write `local.set` against locals the function never reserved — and a
// file where one function holds several ops hides that behind its neighbours.
//
// A REF value widens the reservation surface past what `i32-keyed-scratch-frame-
// reservation.vl` (#1282, mono values) covers, in three ways at once, and this file
// exercises all three per function:
//   · the mv slot's OWN typed 3-slot frame (mapRef / valsBk / valStash) — reserved per
//     module mv slot in any map-using function, so a NEW slot (which is what an
//     i32-keyed ref value mints) shifts every frame after it;
//   · the i32-KEY frame (`mapI32Base`, 5 slots) reserved on `fnUsesMap && mI32Used` —
//     which must still be set when the ONLY i32-keyed map in the module is ref-valued;
//   · the `.values()` per-slot OUTPUT backing (`mvValsOutBase`) and the key-list builder
//     (`mapKeysBase`), whose i32-keyed arms take their out/src slots from the i32 frame.
//
// The `.keys()` cell is the one where the two axes cross: the receiver's SHAPE is an mv
// slot (a ref value) while its KEY LIST is an `i32[]`, so the classifier has to ask the
// slot's key column rather than the mono sentinel — the exact site that emitted an
// invalid module before `mapShapeKeyI32` existed.
function bind() {
  const m: {[i32]: string} = Map()
  m[1] = "x"
  print(m.length)
}
function has(m: {[i32]: string}) { print(m.has(1)) }
function get(m: {[i32]: string}) { print(m[1] ?? "z") }
function del(m: {[i32]: string}) {
  const r = m.delete(1)
  print(r)
}
function keys(m: {[i32]: string}) {
  const k = m.keys()
  print(k.length)
}
function vals(m: {[i32]: string}) {
  const v = m.values()
  print(v.length)
}
function walk(m: {[i32]: string}) {
  let n = 0
  for k in m { n = n + k }
  print(n)
}
function put(m: {[i32]: string}) {
  m.set(2, "y")
  print(m.length)
}
function mk(): {[i32]: string} {
  const m: {[i32]: string} = Map()
  m[1] = "x"
  return m
}
bind()
has(mk())
get(mk())
del(mk())
keys(mk())
vals(mk())
walk(mk())
put(mk())
