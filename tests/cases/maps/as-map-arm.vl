// @run
// @log false
// @log true
// @log 1
// @log true
// @log 2
// @log s
// `as?`, `as!` and `as` out of a union box to a map arm: the payload is the map struct ref, and
// `as?` yields the nullable map ref. Two maps of one representation keep their own tags.
const mi: {[string]: i32} = Map()
mi.set("b", 1)
const mb: {[string]: boolean} = Map()
mb.set("b", true)
function f(u: {[string]: i32} | {[string]: boolean}) {
  const m = u as? {[string]:i32}
  print(m == null)
}
f(mi)
f(mb)
function g(u: {[string]: i32} | string) {
  const m = u as! {[string]:i32}
  m.get("b") ?? -1
}
print(g(mi))
// `as` hands a miss back to the caller: the rest of the union is this function's result.
function h(u: {[i32]: i32} | {[i32]: boolean} | string): {[i32]: i32} | string {
  const m = u as {[i32]:boolean}
  print(m.has(1))
  print(m.length)
  "s"
}
const nb: {[i32]: boolean} = Map()
nb.set(1, true)
nb.set(2, false)
const r = h(nb)
if r is string { print(r) }
