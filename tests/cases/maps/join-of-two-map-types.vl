// @run
// @log false
// @log 1
// @log 0
// @log 64
// @log 30
// @log true
// @log 2
// @log B
// @log true
// @log 1
// @log true
// @log 30
// @log 7
// A join of two map types whose key or value reps differ is their union, never the wider map
// a delivery would refuse to widen into: the result is the box, tagged per arm (D2666); a map
// joined with a scalar is the same box, un-annotated (D2648).
function mkA(): {[string]: i32} {
  const m: {[string]: i32} = Map()
  m["a"] = 1
  m["b"] = 2
  return m
}
function mkB(): {[string]: i32 | null} {
  const m: {[string]: i32 | null} = Map()
  m["q"] = 3
  return m
}
let ga = mkA()
let gb = mkB()
function assignArms(c: boolean) {
  if c { ga = mkA() } else { gb = mkB() }
}
const r = assignArms(false)
print(r is {[string]: i32})
if r is {[string]: i32 | null} { print(r.length) }
print(ga.length - 2)
function m32(): {[i32]: i32} {
  const m: {[i32]: i32} = Map()
  m[3] = 30
  return m
}
function m64(): {[i64]: i32} {
  const m: {[i64]: i32} = Map()
  m[3 as i64] = 64
  return m
}
let g32 = m32()
let g64 = m64()
function keyArms(c: boolean) {
  if c { g32 = m32() } else { g64 = m64() }
}
const k = keyArms(false)
if k is {[i64]: i32} { print(k[3 as i64] ?? -1) }
const k2 = keyArms(true)
if k2 is {[i32]: i32} { print(k2[3] ?? -1) }
function lit(): {[string]: "a" | "b"} {
  const m: {[string]: "a" | "b"} = Map()
  return m
}
function str(): {[string]: string} {
  const m: {[string]: string} = Map()
  m["k"] = "v"
  return m
}
function values(c: boolean) {
  if c { lit() } else { str() }
}
print(values(false) is {[string]: string})
const vs = values(true)
if vs is {[string]: "a" | "b"} { print(vs.length + 2) }
function bools(): {[string]: boolean} {
  const m: {[string]: boolean} = Map()
  m["t"] = true
  return m
}
const c = false
const bound = if c { mkA() } else { bools() }
match bound {
  {[string]: i32} => print("A")
  {[string]: boolean} => print("B")
}
function mkAn(c: boolean): {[string]: i32} | null {
  if c { return mkA() }
  null
}
const co = mkAn(false) ?? mkB()
print(co is {[string]: i32 | null})
function nullJoin(c: boolean) {
  if c { mkAn(false) } else { mkB() }
}
const nj = nullJoin(false)
if nj is {[string]: i32 | null} { print(nj.length) }
const nj2 = nullJoin(true)
print(nj2 == null)
function pick(n: i32) {
  if n > 0 { return m32() }
  return 7
}
const pv = pick(1)
if pv is {[i32]: i32} { print(pv[3] ?? -1) }
const pw = pick(0)
if pw is i32 { print(pw) }
