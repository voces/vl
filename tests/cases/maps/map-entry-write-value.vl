// @run
// @log 9
// @log 9
// @log 5
// @log 2.5
// @log v!
// @log v
// @log 4
// @log 4
// @log 77
// @log 6
// @log 66
// @log 10
// A map entry write used as a value yields the stored value in any position, its siblings
// evaluated in source order.
const m: {[string]: i32} = Map()
m["a"] = 1
let k = "a"
print(m[k] = 9)
print(m["a"] ?? 0)

const mf: {[string]: f64} = Map()
const fk = "x"
print((mf[fk] = 2.5) * 2)
print(mf["x"] ?? 0)

const ms: {[string]: string} = Map()
print((ms[fk] = "v") + "!")
print(ms["x"] ?? "-")

type P = { v: i32 }
const mp: {[string]: P} = Map()
print((mp[fk] = { v: 4 }).v)
print(mp["x"]?.v ?? 0)

const mi: {[i32]: i32} = Map()
const ik = 3
function two(a: i32, b: i32) { print(a * 10 + b) }
two(mi[ik] = 7, mi[ik] ?? 0)
const xs = [0, 0]
const xi = 1
print(mi[ik] = xs[xi] = 6)
print(xs[1] * 10 + (mi[3] ?? 0))

function both() {
  const local = Map()
  const lk = "q"
  return (local[lk] = 5) + (local[lk] ?? 0)
}
print(both())
k = "b"
