// @run
// @log 0
// @log 42
// @log 7
// @log 42
// @log 41.75
// @log 42
// @log 2
// @log true
// @log true
// An integer-keyed map as a PARAMETER of a spelled function type, and as the type argument
// of a generic record (D9920, D2722). Each value is written through the map the callee
// receives and read back, so a map handed across with the wrong struct cannot print it.

// The filed repro: the parameter type of a function-typed parameter.
function run(f: (k: {[i32]: i32}) => i32) {
  const m: {[i32]: i32} = Map()
  f(m)
}
function g(k: {[i32]: i32}) { k.length }
print(run(g))

function readBack(f: (k: {[i32]: i32}) => i32) {
  const m: {[i32]: i32} = Map()
  m.set(3, 41)
  f(m)
}
print(readBack((k: {[i32]: i32}) => (k.get(3) ?? 0) + 1))

// A nullable map parameter, called with `null` and with a map.
const h: (k: {[i32]: i32} | null) => i32 = (k: {[i32]: i32} | null) => {
  if k == null { return 7 }
  (k.get(3) ?? 0) + 1
}
const hm: {[i32]: i32} = Map()
hm.set(3, 41)
print(h(null))
print(h(hm))

// The i64 key, past the i32 range, through a function-typed binding.
function gi(k: {[i64]: f64} | null) {
  if k == null { return 0.25 }
  (k.get(4294967296) ?? 0.0) + 0.5
}
const fi: (k: {[i64]: f64} | null) => f64 = gi
const mi: {[i64]: f64} = Map()
mi.set(4294967296, 41.0)
print(fi(mi) + fi(null))

// A generic record's type argument: the map read back through the nullable field.
type Box<T> = { v: T | null }
const bm0: {[i32]: i32} = Map()
bm0.set(3, 41)
const bm: Box<{[i32]: i32}> = { v: bm0 }
const w = bm.v
if w != null {
  w.set(4, 0)
  print((w.get(3) ?? 0) + 1)
}
print(bm0.length)

// The same record at a Set and at its boolean-valued map twin, through one generic (D2722).
function isSet<T>(b: Box<T>) { print(b.v is Set<i32>) }
const s: Set<i32> = Set()
const m: {[i32]: boolean} = Map()
const bs: Box<Set<i32>> = { v: s }
const bb: Box<{[i32]: boolean}> = { v: m }
isSet(bb)
isSet(bs)
