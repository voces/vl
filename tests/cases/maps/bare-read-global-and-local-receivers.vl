// @run
// @log 7
// @log null
// @log ab
// @log missing
// @log 2
// @log true
// @log none
// @log 3
// A bare map read `m[k]` off a map global and off a local: an `i32` map through its helper, its
// miss `null`; a string map probed inline, nullable and narrowed; a boolean map's miss its null.
const counts: {[string]: i32} = Map()
const names: {[string]: string} = Map()
const flags: {[string]: boolean} = Map()
function count(k: string) { return counts[k] }
function name(k: string): string {
  const v = names[k]
  if v == null { return "missing" }
  return v
}
function nameLen(): i32 {
  if names["a"] is string { return names["a"].length }
  return 0
}
function flag(k: string): string {
  const f = flags[k]
  if f == null { return "none" }
  return if f { "true" } else { "false" }
}
function local(k: string): i32 {
  const m: {[string]: string[]} = Map()
  m["x"] = ["a", "b", "c"]
  const l = m[k]
  return if l == null { 0 } else { l.length }
}
counts["a"] = 7
names["a"] = "ab"
flags["a"] = true
print(count("a"))
print(count("b"))
print(name("a"))
print(name("b"))
print(nameLen())
print(flag("a"))
print(flag("b"))
print(local("x"))
