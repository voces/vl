// @run
// @log 5
// @log 4
// A binding holding a call counts as the build it holds: `a` is `mk()` built at `J`, so the
// un-annotated map it is stored into holds `J` values (D14518).
type J = { f: i32 | null }
function mk() { { f: 4 } }
const wideJ: J = mk()
const m = Map()
const a = mk()
m.set("a", a)
const x = m.get("a")
if x != null { print(x.f + 1) }
print(wideJ.f ?? 0)
