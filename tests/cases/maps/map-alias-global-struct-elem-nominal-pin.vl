// @run
// @log 7
// @hint Intentionally-unused variable `_sp1` (leading `_` marks it unused)
// A refutation pin (D1857). `elemNameIsNominalAt` asks whether an element name is one
// `repElemKey` keys nominally — one a structural row cannot stand in for — so resolving it
// with the structural-tolerant `structIndexOfTypeName` inverts the predicate and this program
// becomes a compiler trap. The module-global binding typed by the alias is the one ingredient
// the trap needs; everything else here is the shape that carries it.
type Cir2 = { c2: i32 }
type Sq2 = { s2: i32 }
type Shape2 = Cir2 | Sq2
type Circle = { r: Shape2 }
type Box1 = {[string]: Circle[]}
const _sp1: Box1 = Map()
function rd() {
  const c: {[string]: Circle[]} = Map()
  c["k0"] = [{ r: { c2: 7 } }]
  const g0 = (c)["k0"] ?? []
  if g0.length > 0 {
    const e = g0[0]
    if e.r is Cir2 { print(7) } else { print(0) }
  } else {
    print(0)
  }
}
rd()
