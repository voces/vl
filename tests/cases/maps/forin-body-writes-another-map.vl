// @run
// @log 40
// @log 40
// @log 780
// @log 40
// @log 5460
// @log 40
// @log 40
// @log 780
// @log 0
// @log 780
// @log 2000
// @log 40
// @log 780
// @log 40
// @log 780
// A `for`-in walk over one map whose body inserts into, deletes from, resizes or compacts
// ANOTHER map of the same shape: every walk visits each of its own entries once, with the
// right value. The walk re-reads its map's `live` and `vals` every step, so it keeps that
// map in a slot of its own; the body's map ops share one scratch slot per shape (D2313,
// plumb PL-035). The first leg is plumb's witness.
import { toString } from "std:fmt"

const m: {[string]: i32} = Map()
for i in 0 until 40 { m["k" + toString(i)] = i }

// L1 — plumb's witness: `for k, v in m`, inserting into a boolean-valued map.
const d: {[string]: boolean} = Map()
for r in 0 until 3 {
  for k, v in m {
    if !d.has(k) { d[k] = true }
  }
}
print(d.size)

// L2 — `for k in m`, the i32-valued twin, read back.
const d2: {[string]: i32} = Map()
let s2 = 0
for r in 0 until 3 {
  for k in m { d2[k] = m[k] ?? -1 }
}
for k in d2 { s2 = s2 + (d2[k] ?? 0) }
print(d2.size)
print(s2)

// L3 — the i32-keyed rep.
const mi: {[i32]: i32} = Map()
for i in 0 until 40 { mi[i * 7] = i }
const di: {[i32]: i32} = Map()
let si = 0
for r in 0 until 3 {
  for k in mi { di[k + 1] = k }
}
for k, v in di { si = si + v }
print(di.size)
print(si)

// L4 — `.keys()` and `.values()` walks.
const d4: {[string]: boolean} = Map()
for k in m.keys() {
  if !d4.has(k) { d4[k] = true }
}
print(d4.size)
const d5: {[string]: i32} = Map()
let s5 = 0
for v in m.values() { d5["v" + toString(v)] = v; s5 = s5 + v }
print(d5.size)
print(s5)

// L5 — deleting from the other map.
const d6: {[string]: i32} = Map()
for k, v in m { d6[k] = v }
let s6 = 0
for k, v in m { d6.delete(k); s6 = s6 + v }
print(d6.size)
print(s6)

// L6 — growing the other map's index many times over.
const d7: {[string]: i32} = Map()
for k, v in m {
  for j in 0 until 50 { d7[k + "/" + toString(j)] = j }
}
print(d7.size)

// L7 — compacting the other map every step, string- and i32-keyed.
const d8: {[string]: i32} = Map()
let s8 = 0
for k, v in m {
  for j in 0 until 100 { d8["t" + toString(j)] = j }
  for j in 0 until 100 { d8.delete("t" + toString(j)) }
  d8[k] = v
  s8 = s8 + v
}
print(d8.size)
print(s8)
const d9: {[i32]: i32} = Map()
let s9 = 0
for k, v in mi {
  for j in 0 until 100 { d9[1000 + j] = j }
  for j in 0 until 100 { d9.delete(1000 + j) }
  d9[k] = v
  s9 = s9 + v
}
print(d9.size)
print(s9)
