// @run
// @log Q
// @log R
// @log R
// @log Q
// @log S
// @log R
// D2732: a union of two maps of one record is a box at a module binding, a local and a
// function-local union with a scalar, and `is` tells the two maps apart at each.
type Circle = { r: i32 }
type Q = {[string]: Circle}
type R = {[string]: Circle | null}
function mkQ(): Q { const m: Q = Map(); m["a"] = { r: 3 }; m }
function mkR(): R { const m: R = Map(); m["a"] = null; m }
function sh(w: R | Q | string) {
  if w is Q { print("Q") }
  else if w is R { print("R") }
  else { print("S") }
}
const u: Q | R = mkQ()
sh(u)
const v: Q | R = mkR()
sh(v)
function f() {
  const a: Q | R = mkR()
  sh(a)
  const b: R | Q | string = mkQ()
  sh(b)
  const c: R | Q | string = "s"
  sh(c)
}
f()
const g: R | Q | string = mkR()
sh(g)
