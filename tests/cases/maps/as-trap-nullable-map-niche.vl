// @run
// @log 7
// @log 2
// @log 9
// `as!` over a niche-repped `M | null` where `M` is a map traps on null and hands the map back at
// its own type, at an un-annotated binding, an argument and a field (D12460).
function mk(): {[string]: i32} | null {
  const m: {[string]: i32} = Map()
  m["a"] = 7
  m["b"] = 9
  m
}
const v = mk() as! {[string]:i32}
print(v["a"] ?? 0)
function size(m: {[string]: i32}) { m.length }
print(size(mk() as! {[string]:i32}))
const r = { m: mk() as! {[string]:i32} }
print(r.m["b"] ?? 0)
