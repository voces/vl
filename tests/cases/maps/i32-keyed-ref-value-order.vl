// @run
// @log c,b,d,a,
// @log c,b,d,a,
// @log 4
// @log 4
// @log 0
// @log 0
// DETERMINISM for a REF-valued map, under BOTH keys — the ref-value extension of
// `i32-keyed-order-and-extremes.vl`'s pin.
//
// The order contract (DECISIONS B6a) is a property of the shared ordered entry arrays
// and the tombstone-aware walk, so it must survive the two axes independently: the KEY
// rep (which decides the `keys` list type, the hash and the compare) and the VALUE rep
// (which decides the `vals` list type). #1282 pinned key-under-mono-value; this pins
// key-under-REF-value, running the SAME interleaving under both keys in ONE module so
// the two lines are a twin comparison rather than two snapshots.
//
// Interleaving: insert a,c,b · delete a · insert d · RE-insert a. A re-inserted key
// takes a NEW entry at the END (its old entry stays a tombstone), so the live order is
// `c,b,d,a` on both reps. Running both in one module also exercises both map structs,
// both probe helpers and the `__map_resize__` they share — the frame hazard
// `i32-keyed-alongside-string-keyed.vl` covers for mono values, here with two DIFFERENT
// vals list types live at once.
function i32Side(): string {
  const m: {[i32]: string} = Map()
  m[1] = "a"
  m[3] = "c"
  m[2] = "b"
  const d1 = m.delete(1)
  if !d1 { return "delete missed" }
  m[4] = "d"
  m[1] = "a"
  let out = ""
  for k in m { out = out + (m[k] ?? "?") + "," }
  return out
}

function strSide(): string {
  const m: {[string]: string} = Map()
  m["1"] = "a"
  m["3"] = "c"
  m["2"] = "b"
  const d1 = m.delete("1")
  if !d1 { return "delete missed" }
  m["4"] = "d"
  m["1"] = "a"
  let out = ""
  for k in m { out = out + (m[k] ?? "?") + "," }
  return out
}

// The churn half: 40 keys past the load-factor grow, then deleted back to empty. The
// grow rehashes through the SAME `__map_resize__` for both reps, and the compaction
// threshold is driven by `count - size`, which the ref vals list grows in lockstep with.
function churn(): i32 {
  const m: {[i32]: string} = Map()
  let i = 0
  while i < 40 {
    m[i * 7] = "v"
    i = i + 1
  }
  let j = 0
  while j < 40 {
    const gone = m.delete(j * 7)
    if !gone { return -1 }
    j = j + 1
  }
  m.length
}

function churnStr(): i32 {
  const m: {[string]: string} = Map()
  let i = 0
  while i < 40 {
    m["k" + toString(i * 7)] = "v"
    i = i + 1
  }
  let j = 0
  while j < 40 {
    const gone = m.delete("k" + toString(j * 7))
    if !gone { return -1 }
    j = j + 1
  }
  m.length
}

function go() {
  print(i32Side())  // c,b,d,a,
  print(strSide())  // c,b,d,a,  — the same sequence, which is the pin
  const mi: {[i32]: string} = Map()
  mi[0] = "z"
  mi[-2147483648] = "min"
  mi[2147483647] = "max"
  mi[-1] = "neg"
  print(mi.length)  // 4 — zero, both extremes and -1 are four distinct keys
  const ki = mi.keys()
  print(ki.length)  // 4
  print(churn())    // 0
  print(churnStr()) // 0
}
go()
