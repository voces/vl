// @run
// @log true
// @log true
// @log true
// @log false
// @log a
// @log b
// @log c
// @hint Intentionally-unused variable `_a`
// @hint Intentionally-unused variable `_b`
// @hint Intentionally-unused variable `_a`
// @hint Intentionally-unused variable `_b`
// A bundle of one signature set stored into a map whose values are the union of two sets' records
// is boxed into that union: an index store, a `.set`, and an index store inside a function.
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
function lap2(f) {
  const _a = f(true)
  const _b = f(3)
  return f
}
const m = Map()
m["a"] = lap((a) => a + 1)
m.set("b", lap2((a) => a))
function put(k: string) { m[k] = lap2((a) => a) }
put("c")
print(m.has("a"))
print(m.has("b"))
print(m.has("c"))
print(m.has("d"))
for k in m.keys() { print(k) }
