// @hint Intentionally-unused parameter
// @hint redundant type annotation: `five` is inferred as `i32`
// @hint redundant type annotation: `tick` is inferred as `i32`
// A record literal written out of its row's order, holding a boxed binding's `??`, stored into a
// map, a record field, a list element and a nested receiver, from a parameter and a global, with
// a scalar and a record `??`: each line is the trace and the stored value, `q` null then present.
type P = { a: i32, b: i32 }
type Q = { p: P, c: i32 }
type H = { p: P, q: Q }
let log = ""
function mkq(x: boolean): i32 | null { return if x { null } else { 2 } }
function mkr(x: boolean): P | null {
  return if x { null } else { { a: 7, b: 8 } }
}
function five(): i32 {
  log = log + "5"
  return 5
}
function tick(): i32 {
  log = log + "t"
  return 1
}
const gm: {[string]: P} = Map()
const gh: H = { p: { a: 0, b: 0 }, q: { p: { a: 0, b: 0 }, c: 0 } }
const gl: P[] = [{ a: 0, b: 0 }]
function mapPs(m: {[string]: P}, x: boolean) {
  const q = mkq(x)
  m["k"] = { b: tick(), a: q ?? five() }
}
function mapPr(m: {[string]: P}, x: boolean) {
  const q = mkq(x)
  const r = mkr(x)
  m["k"] = r ?? { b: tick(), a: q ?? five() }
}
function mapGs(_m: {[string]: P}, x: boolean) {
  const q = mkq(x)
  gm["k"] = { b: tick(), a: q ?? five() }
}
function mapGr(_m: {[string]: P}, x: boolean) {
  const q = mkq(x)
  const r = mkr(x)
  gm["k"] = r ?? { b: tick(), a: q ?? five() }
}
function fldPs(h: H, x: boolean) {
  const q = mkq(x)
  h.p = { b: tick(), a: q ?? five() }
}
function fldPr(h: H, x: boolean) {
  const q = mkq(x)
  const r = mkr(x)
  h.p = r ?? { b: tick(), a: q ?? five() }
}
function fldGs(_h: H, x: boolean) {
  const q = mkq(x)
  gh.p = { b: tick(), a: q ?? five() }
}
function fldGr(_h: H, x: boolean) {
  const q = mkq(x)
  const r = mkr(x)
  gh.p = r ?? { b: tick(), a: q ?? five() }
}
function idxPs(l: P[], x: boolean) {
  const q = mkq(x)
  l[0] = { b: tick(), a: q ?? five() }
}
function idxPr(l: P[], x: boolean) {
  const q = mkq(x)
  const r = mkr(x)
  l[0] = r ?? { b: tick(), a: q ?? five() }
}
function idxGs(_l: P[], x: boolean) {
  const q = mkq(x)
  gl[0] = { b: tick(), a: q ?? five() }
}
function idxGr(_l: P[], x: boolean) {
  const q = mkq(x)
  const r = mkr(x)
  gl[0] = r ?? { b: tick(), a: q ?? five() }
}
function nstPs(h: H, x: boolean) {
  const q = mkq(x)
  h.q.p = { b: tick(), a: q ?? five() }
}
function nstPr(h: H, x: boolean) {
  const q = mkq(x)
  const r = mkr(x)
  h.q.p = r ?? { b: tick(), a: q ?? five() }
}
const lm: {[string]: P} = Map()
const lh: H = { p: { a: 0, b: 0 }, q: { p: { a: 0, b: 0 }, c: 0 } }
const ll: P[] = [{ a: 0, b: 0 }]
function show(p: P) {
  print(log)
  print(p.a * 10 + p.b)
}
for x in [true, false] {
  log = ""
  mapPs(lm, x)
  show(lm["k"] ?? { a: -1, b: -1 })
  log = ""
  mapPr(lm, x)
  show(lm["k"] ?? { a: -1, b: -1 })
  log = ""
  mapGs(lm, x)
  show(gm["k"] ?? { a: -1, b: -1 })
  log = ""
  mapGr(lm, x)
  show(gm["k"] ?? { a: -1, b: -1 })
  log = ""
  fldPs(lh, x)
  show(lh.p)
  log = ""
  fldPr(lh, x)
  show(lh.p)
  log = ""
  fldGs(lh, x)
  show(gh.p)
  log = ""
  fldGr(lh, x)
  show(gh.p)
  log = ""
  idxPs(ll, x)
  show(ll[0])
  log = ""
  idxPr(ll, x)
  show(ll[0])
  log = ""
  idxGs(ll, x)
  show(gl[0])
  log = ""
  idxGr(ll, x)
  show(gl[0])
  log = ""
  nstPs(lh, x)
  show(lh.q.p)
  log = ""
  nstPr(lh, x)
  show(lh.q.p)
}
