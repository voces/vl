// @run
// @log id2
// @log 7
// Two un-annotated map parameters stored a generic by a string key take their maps from their
// calls, so calls above both declarations leave both bodies to after them.
const b = Map()
b["k"] = { f: id }
over(b)
const h = Map()
h["k"] = id
bare(h)
const hr = h["k"]
if hr != null { print(hr(7)) }
function id<T>(x: T): T { return x }
function id2<T>(x: T): T { print("id2"); return x }
function over(mm) { mm["k"] = { f: id2 } }
function bare(mm) { mm["k"] = id2 }
