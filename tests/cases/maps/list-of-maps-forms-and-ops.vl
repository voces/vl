// @run
// @log aa
// @log aa
// @log aa
// @log aa
// @log 1
// @log true
// @log false
// @log 1
// @log 2
// @log true
// @log bb
// @hint redundant type annotation: `use` is inferred as `string`
// @hint redundant type annotation: `bnd` is inferred as `{[string]: string}[]`
// The FOUR ways a list of maps comes into existence, and every operation through an
// ELEMENT receiver. The forms are the axis that separated the two defects behind this
// family, so they are pinned together rather than one per file.
//
//   lit    `const xs: {[K]: V}[] = [Map()]`   — the element `Map()` needs the seed
//   push   `xs.push(Map())`                   — same seed, other boundary
//   bind   `const xs = [m]` from a seeded `m` — needs NO seed; ran on master
//   param  the list arrives as a parameter    — needs no seed either
//
// `bind` and `param` running on master is what proves the root is the CONSTRUCTOR and
// not the store: the identical `xs[0][k] = v` is invalid wasm under `lit`/`push` and
// correct under `bind`/`param`, and the only difference between them is where the map
// was built.
//
// The OPERATIONS below all go through the element receiver `xs[0]` — the receiver form
// #1249's `exprHasMapOp` history says the membership scans are most likely not to know.
// They do know it: every one of these ran on master under `bind`, so the per-function
// map frames were already reserved for an element receiver. What was missing was the
// seed at the far end.
function use(xs: {[string]: string}[]): string { return xs[0]["k"] ?? "z" }

function go() {
  const lit: {[string]: string}[] = [Map()]
  lit[0]["k"] = "aa"
  print(lit[0]["k"] ?? "z") // aa

  const psh: {[string]: string}[] = []
  psh.push(Map())
  psh[0]["k"] = "aa"
  print(psh[0]["k"] ?? "z") // aa

  const seeded: {[string]: string} = Map()
  const bnd: {[string]: string}[] = [seeded]
  bnd[0]["k"] = "aa"
  print(bnd[0]["k"] ?? "z") // aa

  print(use(lit)) // aa

  // An indexed ASSIGNMENT of a fresh map into an existing row — the third boundary the
  // element seed reaches (`refElemValueCtx`, shared with `.push`).
  const asg: {[string]: string}[] = [Map()]
  asg[0] = Map()
  asg[0]["k"] = "aa"
  print(asg[0].length) // 1

  // has / delete / length / `.set` / `.keys()` / `.values()` / for-in, each through the
  // ELEMENT receiver.
  const ops: {[string]: string}[] = [Map()]
  ops[0].set("k", "aa")
  print(ops[0].has("k")) // true
  const d = ops[0].delete("k")
  print(ops[0].has("k")) // false
  if d {
    print(1) // 1 — `d` is read, so the delete is not dead
  }

  ops[0]["p"] = "aa"
  ops[0]["q"] = "bb"
  print(ops[0].length) // 2

  const ks = ops[0].keys()
  const vs = ops[0].values()
  let n = 0
  for kk in ops[0] { n = n + 1 }
  print(ks.length == vs.length && ks.length == n) // true — 2 keys, 2 values, 2 iterations
  print(ops[0]["q"] ?? "z")                       // bb
}
go()
