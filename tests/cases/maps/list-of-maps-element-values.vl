// @run
// @log aa
// @log 7
// @log 2
// @log 3
// @log 1.5
// @log 5000000000
// @log 2.5
// @log 1
// @log 1
// @log 2
// @log 0
// @log a
// @log true
// A LIST OF MAPS — `{[string]: V}[]` — and its ELEMENT `Map()`, for every value type
// the map rep lowers. The whole family this file pins was `vl check` rc 0 and a module
// that fails to instantiate, and NOT for the reason its name suggests.
//
// THE ROOT IS THE CONSTRUCTOR, NOT THE STORE. #1286 filed this as a list-of-maps STORE
// defect (`xs[0][k] = v`) and measured 12 of 14 value types invalid. The store is
// innocent: `const m: {[string]: string} = Map()` followed by `const xs = [m]` and
// `xs[0][k] = v` RUNS on master. What was invalid is the CONSTRUCTION — `[Map()]` alone,
// with no store anywhere in the program, is already a module that cannot instantiate.
//
// The element `Map()` reached `emitMapNew` with the ambient `pendingMapSlot` (-1, the
// MONO map struct) and `struct.new`'d that into a ref backing typed to the element's OWN
// per-value struct: `type mismatch: expected (ref null $type), found (ref $type)`. That
// is the SAME one line #1286 fixed one composition position over, at the map-VALUE
// boundary — and for the same reason it was silently right for a few values: the three
// whose map struct IS the mono one (`i32`, `boolean`, and a literal-union ATOM, the
// third one the filing's count missed) needed no seed at all.
//
// The seed is `rlElemMapShape` — the ref-list twin of `mvInnerMapShape` — applied at the
// element boundary in `emitArr` (a literal) and in `refElemValueCtx` (`.push` and
// `xs[i] = Map()`). Every value type below is spelled identically to a non-list twin in
// this directory; the LIST form and the twin now agree on all 750 cells of the parity
// grid, byte-for-byte on the 320 that already ran.
// `S` is the STRUCT value and `T | U` the UNION value, and they are deliberately
// DISJOINT: a struct that is a MEMBER of any declared union cannot be a map value at all
// (`mvValKindOfName`'s last arm asks `structIndexByValName`, which a union member is not
// in), so `{[string]: S}` beside `{[string]: S | T}` is a loud reject on master and here.
// #1286 filed that as "a struct-valued AND a union-valued map in ONE module"; the
// union-valued MAP is not the condition — see `error-map-value-struct-in-union.vl`.
type S = { x: i32 }
type T = { y: i32 }
type U = { z: i32 }
type At = "a" | "b"

function inc(n: i32) { return n + 1 }

function go() {
  const ss: {[string]: string}[] = [Map()]
  ss[0]["k"] = "aa"
  print(ss[0]["k"] ?? "z") // aa

  const st: {[string]: S}[] = [Map()]
  st[0]["k"] = { x: 7 }
  const s1 = st[0]["k"] ?? { x: 0 }
  print(s1.x) // 7

  const sl: {[string]: i32[]}[] = [Map()]
  sl[0]["k"] = [7, 8]
  const l1 = sl[0]["k"] ?? []
  print(l1.length) // 2

  const sm: {[string]: string[]}[] = [Map()]
  sm[0]["k"] = ["p", "q", "r"]
  const m1: string[] = sm[0]["k"] ?? []
  print(m1.length) // 3

  // The WIDE scalars ride their own scalar vals lists, not a ref list.
  const sf: {[string]: f64}[] = [Map()]
  sf[0]["k"] = 1.5
  print(sf[0]["k"] ?? 0.0) // 1.5

  const si: {[string]: i64}[] = [Map()]
  si[0]["k"] = 5000000000
  print(si[0]["k"] ?? 0) // 5000000000

  const s32: {[string]: f32}[] = [Map()]
  s32[0]["k"] = 2.5
  print(s32[0]["k"] ?? 0.0) // 2.5

  // `V | null` on its niche, and a nullable ATOM value (which is NOT mono — it interns a
  // box-backed vals slot, so it was in the broken twelve, not the working few).
  const sn: {[string]: string | null}[] = [Map()]
  sn[0]["k"] = "aa"
  print(sn[0].length) // 1

  const sna: {[string]: i32 | null}[] = [Map()]
  sna[0]["k"] = 7
  print(sna[0].length) // 1

  const su: {[string]: T | U}[] = [Map()]
  su[0]["k"] = { y: 1 }
  su[0]["j"] = { z: 2 }
  print(su[0].length) // 2

  // A NESTED map value through a list element: the inner `Map()` takes the map-VALUE
  // seed (#1286) while the outer one takes this PR's ELEMENT seed — both in one store.
  const sn2: {[string]: {[string]: i32}}[] = [Map()]
  sn2[0]["k"] = Map()
  const inner = sn2[0]["k"] ?? Map()
  print(inner.length) // 0

  // A literal-union ATOM value — one of the three that rode the mono struct by accident
  // and so must stay byte-identical.
  const sa: {[string]: At}[] = [Map()]
  sa[0]["k"] = "a"
  print(sa[0]["k"] ?? "b") // a

  // A CLOSURE value, reached through the `.set` METHOD rather than the index store: the
  // method form wrote `ref.func` with no declarative elem segment behind it
  // (`undeclared function reference`) because nothing flipped `fnValUsed` — every other
  // function-value position is described by an annotation that does, and a builtin
  // method's argument is not.
  const sc: {[string]: (i32) => i32}[] = [Map()]
  sc[0].set("k", inc)
  const f1 = sc[0]["k"] ?? inc
  print(f1(1) == 2) // true
}
go()
