// @run
// @log 3,2,4,1,
// @log 3,2,4,1,
// @log 100
// @log 200
// @log 300
// @log 400
// @log 4
// @log 4
// @log 0
// DETERMINISM + KEY RANGE for the i32-keyed rep.
//
// (1) INSERTION ORDER IS THE CONTRACT (DECISIONS B6a — replay depends on it), so
// the i32-keyed map must iterate exactly where the string-keyed one does under
// the same interleaving: insert 3,1,2 · delete 1 · insert 4 · RE-insert 1. A
// re-inserted key takes a NEW entry at the END (its old entry stays a tombstone),
// so the order is `3,2,4,1` — and the two reps print the SAME sequence, which is
// what makes this a twin pin rather than a snapshot. Any hashing scheme that
// re-ordered on rehash would break BOTH lines; the reps share the ordered
// keys/vals arrays and the tombstone-aware walk, so neither can drift alone.
//
// (2) THE KEY RANGE. i32 keys are the whole signed range: 0, negatives, and both
// extremes. The hash is masked non-negative (`& 0x7fffffff`) and the slot pick is
// `i32.rem_u`, so a negative key can never index out of the table — this is the
// pin for that, and `-2147483648` is the value whose sign bit survives every step
// of the mix.
const oi: {[i32]: i32} = Map()
oi[3] = 1
oi[1] = 2
oi[2] = 3
oi.delete(1)
oi[4] = 4
oi[1] = 5
let io = ""
for k in oi {
  io = io + toString(k) + ","
}
print(io) // 3,2,4,1,

// The STRING twin, same interleaving, same order.
const os: {[string]: i32} = Map()
os["3"] = 1
os["1"] = 2
os["2"] = 3
os.delete("1")
os["4"] = 4
os["1"] = 5
let so = ""
for k in os {
  so = so + k + ","
}
print(so) // 3,2,4,1,

// Zero, a negative, and both i32 extremes are four DISTINCT keys.
const e: {[i32]: i32} = Map()
e[0] = 100
e[-1] = 200
e[2147483647] = 300
e[-2147483648] = 400
print(e[0] ?? -1)           // 100
print(e[-1] ?? -1)          // 200
print(e[2147483647] ?? -1)  // 300
print(e[-2147483648] ?? -1) // 400
print(e.length)             // 4

// Churn past the load-factor grow (resize re-places from the STORED hashes, so a
// grow can neither lose nor re-order an entry) and then delete every key back out.
const big: {[i32]: i32} = Map()
let i = 0
while i < 64 {
  big[i * 7 - 200] = i
  i = i + 1
}
let miss = 0
let j = 0
while j < 64 {
  if (big[j * 7 - 200] ?? -1) != j { miss = miss + 1 }
  j = j + 1
}
print(miss + big.length - 60) // 4 — 0 misses, 64 live
let d = 0
while d < 64 {
  big.delete(d * 7 - 200)
  d = d + 1
}
print(big.length)             // 0
