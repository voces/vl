// @run
// @hint redundant type annotation: `h` is inferred as `string` — remove it to lean on inference
// @hint redundant type annotation: `w` is inferred as `{f: V | null}` — remove it to lean on inference
// @hint redundant type annotation: `l0` is inferred as `i32[]` — remove it to lean on inference
// @log 7
// @log true
// @log true
// @log true
// @log 7
// @log true
// @log some
// @log null
// @log true
// @log true
// @log 9
// @log true
// @log 5
// @log true
// @log 7
// @log true
// @log 0
// @log true
// @log 9
// @log true
// @log 2.5
// @log true
// A map read with a nullable default is `V | null`, whatever the map's value type admits: a
// miss is the read's null. `m[k] ?? null` is the read itself (D2247) and `m[k] ?? n[k]`
// keeps the default's null (D2248), for record, string, list, map and scalar values, bound,
// compared, returned, passed and stored (from consumer plumb PL-023).

type V = { x: i32, y: i32 }
type W = { f: V | null }

const recs: {[string]: V} = Map()
const more: {[string]: V} = Map()
recs["k"] = { x: 7, y: 2 }
more["k"] = { x: 9, y: 0 }

const a = recs["k"] ?? null
if a != null { print(a.x) }
const b = recs["z"] ?? null
print(b == null)
print((recs["k"] ?? null) != null)
print((recs["z"] ?? null) == null)

function get(k: string): V | null { recs[k] ?? null }
const g = get("k")
if g != null { print(g.x) }
print(get("z") == null)

function h(p: V | null): string {
  if p == null { return "null" }
  "some"
}
print(h(recs["k"] ?? null))
print(h(recs["z"] ?? null))

const w: W = { f: recs["z"] ?? null }
print(w.f == null)
const c = true
const j = if c { recs["z"] ?? null } else { null }
print(j == null)

const both = recs["q"] ?? more["k"]
if both != null { print(both.x) }
print((recs["q"] ?? more["q"]) == null)

const strs: {[string]: string} = Map()
strs["k"] = "seven"
const s = strs["k"] ?? null
if s != null { print(s.length) }
print((strs["z"] ?? null) == null)

const lists: {[string]: i32[]} = Map()
const l0: i32[] = [7]
lists["k"] = l0
const l = lists["k"] ?? null
if l != null { print(l[0]) }
print((lists["z"] ?? null) == null)

const maps: {[string]: {[string]: i32}} = Map()
maps["k"] = Map()
const mm = maps["k"] ?? null
if mm != null { print(mm.length) }
print((maps["z"] ?? null) == null)

const nums: {[string]: i32} = Map()
const numsB: {[string]: i32} = Map()
numsB["k"] = 9
const n = nums["k"] ?? numsB["k"]
if n != null { print(n) }
print((nums["z"] ?? null) == null)

const fl: {[string]: f64} = Map()
fl["k"] = 2.5
function getF(k: string): f64 | null { fl[k] ?? fl["q"] }
const f = getF("k")
if f != null { print(f) }
print(getF("z") == null)
