// @run
// @log 1
// The NON-NULLABLE twin of `union-arm-nullable-i32-map-field.vl`, in its own file because
// `mI32Used` is module-wide and these two would cover each other's misses.
//
// This one never broke, and the reason is the point: the union variant field pass collected it
// through its code-19 arm, independently of the orphaned annotation `TypeRef`. Its nullable twin
// is code 29, and that pass had a 19 arm and no 29 arm — so the nullable field's flags arrived
// only by accident, from the orphan reaching the annotation walk's `nulMapInnerName` rung. When
// that rung stopped answering there was nothing left. The 29 arm is now present, which is the
// root fix; the annotation walk's coverage guard is the belt.
type Ctl = { g: {[i32]: i32} } | f64
const c: Ctl = 2.5
if c is f64 { print(1) } else { print(101) }
