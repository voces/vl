// @run
// @log 4
// @log 1.5
// @hint redundant type annotation: `xs` is inferred as `f64[]`
// A `const` read from a map or popped from a scalar list, then tested `is` its scalar, is split
// into a flag and the scalar; the present test is told apart by the pattern's own type (D15254).
const m: Map<string, i64> = Map()
m["k"] = 4
function f(): i64 {
  const v = m["k"]
  if v is i64 { return v }
  0
}
print(f())
const xs: f64[] = [1.5]
function g(): f64 {
  const p = xs.pop()
  if p is f64 { return p }
  0.0
}
print(g())
