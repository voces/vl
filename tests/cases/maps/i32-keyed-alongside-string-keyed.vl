// @run
// @log 213
// @log 2
// @log true
// @log 2
// BOTH KEY REPS LIVE IN ONE MODULE — the composition the two shape sentinels
// exist to keep apart. Every shared piece is exercised with both reps present:
// the two map struct heap types, the two probe helpers at their assigned
// function indices, `__map_resize__` shared by both, and — the real hazard —
// the SCRATCH FRAME, which the i32 rep extends rather than replaces.
//
// The nested reads are the point. `emitMapRecvKey` parks the receiver and key on
// the wasm OPERAND STACK precisely because an inner map op in the KEY expression
// runs its own probe through the same frame; here that inner op is a map of the
// OTHER key rep, so a frame slot shared by mistake (the mapRef, the target key,
// the keys backing) would surface as a wrong-map probe or a lost write rather
// than as a type error.
function f(): i32 {
  const s: {[string]: i32} = Map()
  const a: {[i32]: i32} = Map()
  const b: {[i32]: i32} = Map()
  s["k"] = 3
  a[1] = 10
  a[2] = 20
  // an i32-map read INSIDE another i32-map's key expression
  b[a[1] ?? 0] = 99
  // a STRING-map read inside an i32-map's key expression
  b[s["k"] ?? 0] = 77
  // the mirror (an i32-map read feeding a string-keyed map) in the value position
  s["v"] = a[2] ?? 0
  let n = 0
  for k in b {
    n = n + k
  }
  // 99 + 77 + 20 + 13 + 2 + 2
  return (b[10] ?? -1) + (b[3] ?? -1) + (s["v"] ?? -1) + n + b.length + s.length
}
print(f()) // 213

// A ref-valued STRING map and an i32-keyed SET as module globals: both written
// from the same function, so ONE frame carries both reps' ops.
const gs: {[string]: string} = Map()
const gi: {[i32]: boolean} = Set()
function g(): i32 {
  gs.set("a", "bb")
  gi.add(7)
  return 0
}
const z = g()
print((gs["a"] ?? "").length + z) // 2
print(gi.has(7))                  // true
print(gi.length + gs.length)      // 2
