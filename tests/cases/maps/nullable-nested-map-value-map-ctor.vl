// @run
// @log 7
// @log 7
// @log 1
// RUNG 2 of the D112 close (2026-08-27): a NESTED MAP whose value is `{[K2]: V} | null`.
//
// `mvInnerMapShape` names the struct a `Map()` must build to sit in a nested-map slot's
// vals element, and it did not peel the `| null` — while its ref-list twin
// `rlElemMapShape` has peeled one all along. A `{[K]: {[K2]: V} | null}` value rides the
// SAME vals element as its non-null twin (one map struct, nullable only in the slot), so
// the `Map()` that fills that cell builds the same struct either way. Unpeeled, the arena
// leg saw a `TyNullable` and the name leg a `…|null` spelling, both declined, and the MONO
// fallback answered: `struct.new` of the mono map into a typed vals element, `vl check`
// rc 0, engine refuses with `type mismatch: expected (ref null $type), found (ref $type)`.
//
// BOTH CALLERS WERE WRONG TOGETHER and one line fixed both, which is why all three
// programs below are here: the `??` DEFAULT (`emitMapValDefault`), the map STORE
// (`emitMapSetV`), and the two in one program. They share `mvInnerMapShape`, so a
// regression in either direction reddens this file.
//
// Silently right only for a MONO inner map, where the fallback IS the answer — which is
// why nothing caught it until a non-mono inner value was nullable at the same time.

// the `??` DEFAULT half
function mk(n: i32) {
  const i0 = Map()
  i0["k"] = { r: n }
  const c: {[string]: {[string]: {r: i32}} | null} = Map()
  c["o"] = i0
  return c
}
print((((mk(7))["o"] ?? Map())["k"] ?? { r: 0 }).r)

// the map STORE half, and the read back through the default
const c2: {[string]: {[string]: {r: i32}} | null} = Map()
c2["o"] = Map()
const i2 = c2["o"] ?? Map()
i2["k"] = { r: 7 }
print((i2["k"] ?? { r: 0 }).r)

// a STRING-valued inner map: the same store with a different non-mono value type
const c3: {[string]: {[string]: string} | null} = Map()
c3["o"] = Map()
print(c3.size)
