// @run
// @log 7

// A record list stored by an index store into a map of `readonly` union lists is a view of the
// list, as `m.set(k, xs)` is, so a later write to the list shows through the map (D3057).

type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function mk(): Circle[] { return [{ r: 1 }, { r: 2 }] }
const a = mk()
const m: { [string]: readonly Shape[] } = Map()
m["k"] = a
a[0] = { r: 7 }
const v = m["k"]
if v != null {
  const e = v[0]
  if e is Circle { print(e.r) }
}
