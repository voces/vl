// @run
// @log null
// @log null
// @log null
// @log null
// @log 0
// @log false
// @log true
// @log true
// @log false
// @log true
// @log false
// @log true
// @log true
// @log false
// @log true
// @log false
// @log miss
// @log hit
// @log null
// @log 2.5
// @log false
// @log null
// @log false
// @log 1.5
// A bare read `m[k]` of a scalar-valued map is `V | null`, and a miss is `null` wherever it is
// consumed directly, not only once bound (D2466). `print`, `==`/`!=` against a scalar, a union
// or another read, and `is` read the probe's hit flag; each used to see the rep's empty `0`.
const m: {[string]: i32} = Map()
m["z"] = 0
print(m["q"])
print(m.get("q"))
const miss = m["q"]
print(miss)
const mk: {[i32]: i32} = Map()
print(mk[4])
print(m["z"])
print(m["q"] == 0)
print(m["z"] == 0)
print(m["q"] != 0)
print(0 == m["q"])
print(m["q"] == null)
print(m["z"] == m["q"])
print(m["q"] == m["r"])
const nu: i32 | null = null
const zu: i32 | null = 0
print(m["q"] == nu)
print(m["q"] == zu)
print(m["z"] == zu)
print(m["q"] is i32)
const r1 = match m["q"] {
  null => "miss"
  _ => "hit"
}
print(r1)
const r2 = match m["z"] {
  null => "miss"
  _ => "hit"
}
print(r2)
const mf: {[string]: f64} = Map()
mf["a"] = 2.5
print(mf["q"])
print(mf["a"])
print(mf["q"] == 0.0)
const mi: {[string]: i64} = Map()
print(mi.get("q"))
print(mi["q"] == 0)
const m32: {[string]: f32} = Map()
m32["a"] = 1.5
print(m32["a"])
