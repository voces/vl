// @check
// @error `is` cannot tell {[i32]: i32} from {[i32]: boolean} yet
// D2493 through a union pattern: `is {[i32]: i32} | string` names one of two same-rep maps, so
// the tag test would answer for both. A pattern naming both halves of the pair is allowed.
const mb: {[i32]: boolean} = Map()
mb.set(1, true)
function f(u: {[i32]: i32} | {[i32]: boolean} | string) {
  if u is {[i32]: i32} | string { print("i-or-s") } else { print("bool") }
}
f(mb)
