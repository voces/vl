// @run
// @log 10
// @log 20
// @log 30
// @log x
// @log none
// @log z
// @log 1
// @log 2
// @log 3
// @log 11
// @log 12
// @log 13
// @log 101
// @log 201
// @log 301
// @log 1.5
// @log 2.5
// @log 3.5
// A walk of a map's keys or values binds each at the rep the map stores it at: `i64` keys, nullable
// values, list values, record values, closure values called in the body, and `f64` values. Each map
// holds three entries with distinct values, so a wrong stride or a key/value swap prints wrong.
type P = { n: i32 }
function walk() {
  const ki: {[i64]: i32} = Map()
  ki[10 as i64] = 1
  ki[20 as i64] = 2
  ki[30 as i64] = 3
  for k in ki.keys() { print(k) }
  const ns: {[string]: string | null} = Map()
  ns["a"] = "x"
  ns["b"] = null
  ns["c"] = "z"
  for s in ns.values() { print(s ?? "none") }
  const ls: {[string]: i32[]} = Map()
  ls["a"] = [4]
  ls["b"] = [5, 6]
  ls["c"] = [7, 8, 9]
  for xs in ls.values() { print(xs.length) }
  const rs: {[string]: P} = Map()
  rs["a"] = { n: 11 }
  rs["b"] = { n: 12 }
  rs["c"] = { n: 13 }
  for r in rs.values() { print(r.n) }
  const fs: {[string]: (k: i32) => i32} = Map()
  fs["a"] = (k: i32) => k + 100
  fs["b"] = (k: i32) => k + 200
  fs["c"] = (k: i32) => k + 300
  for g in fs.values() { print(g(1)) }
  const ds: {[string]: f64} = Map()
  ds["a"] = 1.5
  ds["b"] = 2.5
  ds["c"] = 3.5
  for d in ds.values() { print(d) }
}
walk()
