// @run
// @log S
// @log a
// @log b
// @log S
// @log 1
// @log 2
// @log S
// @log a
// @log b
// @log S
// @log 5
// @log 6
// @log S
// @log 7
// @log 8
// @log S
// @log 5
// @log 6
// LOG-MISMATCH FIXTURE — it pins the EVALUATION COUNT of a map-view for-in's
// receiver, not merely the values the loop yields. Each `mk*` callee prints ONE
// marker `S` per evaluation, so a receiver lowered twice shows up as a SECOND `S`
// line even while every value stays right. The count is the whole point: the
// receiver's side effects must run once, and the walked list, the loop bound and
// the tombstone `live[]` must all come from THAT one evaluation.
//
// Legs, one per receiver form × view — all three go through the same single stash
// (`pushMapRecvRef` + `emitForInList` reading it), so each is a separate leg:
//   L1  `for k in <call>.keys()`    — string-keyed
//   L2  `for v in <call>.values()`  — string-keyed
//   L3  `for k in <call>`           — bare map iterable, string-keyed
//   L4  the same three over an i32-KEYED map (the other key rep's mapRef local)
//
// WHY THIS HID: every map for-in in the corpus binds its receiver to a LOCAL first
// (`m.keys()`, `big.keys()` in iteration-order.vl / delete.vl / churn-reuse-correct.vl),
// and a local has no side effect to count. The one corpus case that DOES iterate a
// CALL result — tests/cases/arrays/for-in-f64-array.vl, `for x in mk()` — is a
// side-effect-free `mk()` over a LIST, which takes the single-evaluation path
// anyway. So the map twin of that shape was covered nowhere, and a value-only
// oracle could not have seen it: the values were always correct.

function mkKeys(): {[string]: i32} {
  print("S")
  const m: {[string]: i32} = Map()
  m["a"] = 1
  m["b"] = 2
  return m
}

// L1 — a `.keys()` walk over a call.
for k in mkKeys().keys() {
  print(k) // a, b
}

// L2 — a `.values()` walk over a call.
for v in mkKeys().values() {
  print(v) // 1, 2
}

// L3 — the bare map iterable over a call.
for k in mkKeys() {
  print(k) // a, b
}

function mkI32(): {[i32]: i32} {
  print("S")
  const m: {[i32]: i32} = Map()
  m[5] = 7
  m[6] = 8
  return m
}

// L4 — the i32-KEYED rep reads its own mapRef local (`mapI32Base + 4`), so it is a
// separate leg from the string-keyed frame's shared scratch slot 0.
for k in mkI32().keys() {
  print(k) // 5, 6
}

for v in mkI32().values() {
  print(v) // 7, 8
}

for k in mkI32() {
  print(k) // 5, 6
}
