// @run
// @log b
// @log null
// @log 7
// @log null
// @log true
// @log null
// A map field bound inside a generic instantiated at several map types is read at each
// instance's own value type (D3412).
type AB = "a" | "b"
type R = { m: {[i32]: AB} }
function mk(): R {
  const v: {[i32]: AB} = Map()
  v[3] = "b"
  { m: v }
}
type S = { m: {[i32]: i32} }
function mk2(): S {
  const v: {[i32]: i32} = Map()
  v[3] = 7
  { m: v }
}
type Q = { m: {[i32]: boolean} }
function mk3(): Q {
  const v: {[i32]: boolean} = Map()
  v[3] = true
  { m: v }
}
function use<T>(p: T) {
  const e = p.m
  print(e[3])
  print(e[9])
}
use(mk())
use(mk2())
use(mk3())
