// D2505: an i64-keyed map delivered to each container position — a parameter and a return, a
// struct and a variant field, a list element, a `| null` binding, a closure capture, a module
// global — each written through and read back at a key past the i32 range. A generic over the
// value is D2494's, at every key rep.
type Rec = { tbl: {[i64]: string}, n: i32 }
type Shape = { kind: "sq", ids: {[i64]: f64} } | { kind: "none" }

const G: {[i64]: i32} = Map()

function make(k: i64, v: string) {
  const m: {[i64]: string} = Map()
  m[k] = v
  m
}

function readAt(m: {[i64]: string}, k: i64) { m[k] ?? "?" }

const made = make(6000000000, "ret")
print(readAt(made, 6000000000))
print(readAt(made, 1705032704))

const r = { tbl: made, n: 1 }
r.tbl[-6000000000] = "field"
print(r.tbl[-6000000000] ?? "?")
print(r.tbl.length)

const ids: {[i64]: f64} = Map()
ids[8000000000] = 2.5
const sh: Shape = { kind: "sq", ids: ids }
if sh.kind == "sq" { print(sh.ids[8000000000] ?? 0.0) }

const lst: {[i64]: string}[] = []
lst.push(made)
lst.push(make(1, "second"))
print(lst[1][1] ?? "?")
print(lst[0][6000000000] ?? "?")

let maybe: {[i64]: string} | null = null
if maybe == null { maybe = make(7, "nul") }
if maybe != null { print(maybe[7] ?? "?") }

const cap: {[i64]: i32} = Map()
const bump = (k: i64) => {
  cap[k] = (cap[k] ?? 0) + 1
  cap[k] ?? 0
}
bump(9000000000)
print(bump(9000000000))

G[-1] = 5
G[4294967295] = 6
function sumG() {
  let t = 0
  for k, v in G { t = t + v }
  t
}
print(sumG())
