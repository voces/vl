// @run
// @log 5
// @log 1
// @log zz
// @log 1
// THE VARIANT-TABLE TWIN of `i32-keyed-inline-shape-field-collect.vl`, isolated
// for the same reason that file states: the flag is MODULE-WIDE and the intern is
// keyed on the (KEY, VALUE) pair, so any other i32-keyed spelling anywhere in the
// file would cover a miss in either.
//
// `{f: {[i32]: V}} | i32` is ONE `TypeRef` name, so the bare-map arm of
// `collectA`'s annotation scan never sees this map either. The row lands in the
// VARIANT table (`collectShapeVariantFields` → `pushFieldRow`), and the collector
// is the variant half of the field-table re-derivation pass, off
// `uFieldElemKeyI32`.
//
// THE VARIANT HALF IS A JOINT PIN, and it is measured: sabotaging either of the
// variant pass's two writes ALONE fails nothing, because an inline union arm must
// SPELL its shape to be narrowed (`if v is {f: {[i32]: V}}`) and that spelling
// interns a STRUCT row for the same shape, whose pass does both jobs over again.
// Sabotage a variant write TOGETHER WITH its struct twin and this file fails — the
// intern pair with "map value type has no interned slot" (`refVal` below), the
// flag pair with invalid wasm (`mono`). That is the strongest pin this position
// admits, and it is why the arms stay: the covering row is another pass's
// accident, not the variant table's invariant.

function mono() {
  const v: {f: {[i32]: i32}} | i32 = { f: Map() }
  if v is {f: {[i32]: i32}} {
    v.f[11] = 5
    print(v.f[11] ?? 0) // 5
    print(v.f.length)   // 1
  } else {
    print(-1)
  }
}
mono()

// The REF-valued half: the arm's map value interns a per-(KEY, VALUE) mv slot and
// this arm is the module's only mention of the i32-keyed one.
function refVal() {
  const w: {g: {[i32]: string}} | i32 = { g: Map() }
  if w is {g: {[i32]: string}} {
    w.g[11] = "zz"
    print(w.g[11] ?? "-") // zz
    print(w.g.length)     // 1
  } else {
    print(-1)
  }
}
refVal()
