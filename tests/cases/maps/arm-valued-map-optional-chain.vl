// @run
// @log 7
// @log -1
// @hint redundant type annotation: `c` is inferred as `{r: i32}`
// Regression (silent-class-inventory D47, the rung it made reachable): `m[k]?.f ?? d` over
// an arm-VALUED map.
//
// D47 lets the map lower; this site then read the value row's STRUCT index, which is -1 for
// an arm (`collectS` SKIPS a `type X = {…}` that is a union member, so the arm has a
// `uVariants` row and no `sNames` one). `sFieldIndex(-1, …)` bounds itself and answers -1,
// so the program stayed LOUD rather than trapping — but the message it produced,
// "`?.` field is not on the map's value struct", names a cause that is not true: the field
// IS on it. A wrong table gives a wrong reason, which is the failure mode this whole family
// produces at every rung.
//
// The either/or is the same one the STORE seed and the `??` DEFAULT seed have carried since
// D34, and all three accessors it needs were already written arm-for-arm against their
// struct counterparts: `variantFieldIndex` / `variantFieldTypeAt` / `uVarHeap`.
//
// The MISS arm is pinned too — `?.` over a key that was never stored takes the default,
// which is the one thing a hit-only fixture cannot distinguish from a wrong field read.

type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq

function cell() {
  const m: {[string]: Circle} = Map()
  const c: Circle = { r: 7 }
  m["k"] = c
  print(m["k"]?.r ?? -1)
  print(m["absent"]?.r ?? -1)
}

cell()
