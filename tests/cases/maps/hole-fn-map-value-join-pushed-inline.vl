// @run
// @log 1.5
// @log 4
// @log 2.5
// A value join of maps of un-annotated functions, pushed inline onto or set inline into an
// annotated holder, delivers each branch's map at the holder's element (D15942).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const fnMap = Map()
fnMap.set("b", half)
const m2 = Map()
m2.set("a", half)
const k = [1].length > 0
const xs: ({ [string]: (a: f64) => f64 })[] = []
xs.push(if k { m2 } else { fnMap })
const g = xs[0].get("a")
if g != null { print(g(3)) }

const m3 = Map()
m3.set("a", inc0)
const ys: ({ [string]: (a: f64) => f64 })[] = []
ys.push(if k { m3 } else { fnMap })
const h = ys[0].get("a")
if h != null { print(h(3)) }

const m5 = Map()
m5.set("a", half)
const mm: { [string]: { [string]: (a: f64) => f64 } } = Map()
mm.set("k", if k { m5 } else { fnMap })
const mv = mm.get("k")
if mv != null {
  const f = mv.get("a")
  if f != null { print(f(5)) }
}
