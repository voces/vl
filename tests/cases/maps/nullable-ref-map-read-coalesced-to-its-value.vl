// @run
// @log 3
// @log 9
// @log 9
// @log hi
// @log none
// @log none
// A map whose value is a nullable record or string, read under `??`: a stored null and a miss both
// take the default, and a hit is the stored value.
type P = { x: i32 }
function rec(m: {[string]: P | null}, k: string) {
  const v = m[k] ?? { x: 9 }
  print(v.x)
}
function str(m: {[string]: string | null}, k: string) {
  const v = m[k] ?? "none"
  print(v)
}
function go() {
  const a: {[string]: P | null} = Map()
  a["p"] = { x: 3 }
  a["n"] = null
  rec(a, "p")
  rec(a, "n")
  rec(a, "z")
  const b: {[string]: string | null} = Map()
  b["s"] = "hi"
  b["n"] = null
  str(b, "s")
  str(b, "n")
  str(b, "z")
}
go()
