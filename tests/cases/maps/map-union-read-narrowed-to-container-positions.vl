// @log 3
// @log 13
// @log 1
// @log 8
// @log 1
// @log 1
// @log true
// @log 1
// @log 8
// @log 18
// @log 1
// A read of a union-valued map narrowed to a map or list member is unboxed to that container
// after the probe. Positions: binding, argument, record field, method receiver, `return` and list
// element.
type P = { n: i32 }
type M = {[string]: i32}
function sz(m: M) { return m.length }
function ln(l: P[]) { return l.length * 10 + l[0].n }
function mkM(k: i32): M {
  const m: M = Map()
  m["a"] = k
  return m
}
function getM(t: {[string]: M | i32}): M {
  if t["k"] is M { return t["k"] }
  return Map()
}
function run(n: i32) {
  const t: {[string]: M | i32} = Map()
  t["k"] = mkM(n)
  if t["k"] is M {
    const q = t["k"]
    print(q["a"] ?? -1)
    print(sz(t["k"]))
    const r = { m: t["k"] }
    print(r.m.length)
    print(t["k"].has("a"))
  }
  print(getM(t).length)
  const u: {[string]: P[] | string} = Map()
  u["k"] = [{ n: n }]
  if u["k"] is P[] {
    const xs = u["k"]
    print(xs[0].n)
    print(ln(u["k"]))
    const ls = [u["k"]]
    print(ls[0].length)
  }
}
run(3)
run(8)
