// @run
// @log 4
// @log 5
// @log x
// @log true
// @log 6
// @log s
// @log 7
// @log 8
// @log 9
// @log 10
// A fresh `Map()` or `Set()` delivered to a union is built as the union's one map (or set)
// member, at a binding, a nullable binding, an argument, an assignment, a return, a record
// field and a list element (D2649).
const a: {[string]: i32} | string = Map()
if a is {[string]: i32} {
  a.set("k", 4)
  print(a.get("k") ?? -1)
}
const b: {[i32]: i32} | string | null = Map()
if b is {[i32]: i32} {
  b.set(3, 5)
  print(b.get(3) ?? -1)
}
const c: {[i64]: string} | i32 = Map()
if c is {[i64]: string} {
  c.set(3, "x")
  print(c.get(3) ?? "none")
}
const s: Set<string> | i32 = Set()
if s is Set<string> {
  s.add("a")
  print(s.has("a"))
}
function arg(u: {[string]: i32} | string) {
  if u is {[string]: i32} {
    u.set("k", 6)
    print(u.get("k") ?? -1)
  } else {
    print(u)
  }
}
arg(Map())
arg("s")
let asg: {[string]: i32} | string = "s"
asg = Map()
if asg is {[string]: i32} {
  asg.set("k", 7)
  print(asg.get("k") ?? -1)
}
function ret(): {[string]: i32} | string { Map() }
const r = ret()
if r is {[string]: i32} {
  r.set("k", 8)
  print(r.get("k") ?? -1)
}
type R = { m: {[string]: i32} | string }
const rec: R = { m: Map() }
const f = rec.m
if f is {[string]: i32} {
  f.set("k", 9)
  print(f.get("k") ?? -1)
}
const xs: ({[string]: i32} | string)[] = [Map(), "s"]
const e = xs[0]
if e is {[string]: i32} {
  e.set("k", 10)
  print(e.get("k") ?? -1)
}
