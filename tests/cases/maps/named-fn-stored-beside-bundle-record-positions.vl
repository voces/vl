// @run
// @log true
// @log 3
// @log 2.5
// @log 3
// @log true
// @hint Intentionally-unused variable `_a` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_b` (leading `_` marks it unused)
// @hint redundant type annotation: `dbl` is inferred as `f64` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// A typed named function stored into a map whose slot holds a two-signature bundle's record, from
// module scope and from a function: it is built as that record, its own member its closure, and a
// read or a walk calls it at its own signature (D17700). A call at the other signature is D17726.
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
function dbl(a: f64): f64 { return a * 2.0 }
const m = Map()
m["a"] = lap((a) => a + 1)
function g() {
  m["c"] = dbl
  return m.has("a")
}
print(g())
m["b"] = dbl
const h = m["b"]
if h != null { print(h(1.5)) }
const n = Map()
n["a"] = lap((a) => a + 1)
n["b"] = dbl
for v in n.values() { print(v(1.5)) }
print(m.has("c"))
