// @run
// @log 40 0
// @log 20 20
// @log 80 5560 0
// @log 40 0
// @log 2 z 1
// @log 10 k0,k2,k4,k6,k8,k10,k12,k14,k16,k18
// REGRESSION (D2315): a walk over a map whose body deletes from it or inserts into it behaves like
// JS `Map` iteration. Every key is visited once while it lives; a deleted key the walk has not
// reached is skipped; a key inserted during the walk is visited. It holds when the deletes pile up
// enough for an insert in the body to compact the map, since the walk resumes by entry sequence.
import { toString } from "std:fmt"

// L1: delete every key as it is visited (the row's witness). Master visited 25 and left 15.
const m: {[string]: i32} = Map()
for i in 0 until 40 { m["k" + toString(i)] = i }
let n = 0
for k in m { m.delete(k); n = n + 1 }
print("\{n} \{m.length}")

// L2: delete ahead of the cursor. The odd keys go before the walk reaches them.
const a: {[i32]: i32} = Map()
for i in 0 until 40 { a[i] = i }
let seen = 0
for k in a {
  seen = seen + 1
  if k % 2 == 0 { a.delete(k + 1) }
}
print("\{seen} \{a.length}")

// L3: delete the current key and insert a new one. The inserts compact the map mid-walk, and every
// new key is still visited: 40 originals plus 40 inserted, keys 0..39 and 100..139.
const b: {[i32]: i32} = Map()
for i in 0 until 40 { b[i] = i }
let visits = 0
let sum = 0
for k in b {
  visits = visits + 1
  sum = sum + k
  b.delete(k)
  if k < 100 { b[k + 100] = k }
}
print("\{visits} \{sum} \{b.length}")

// L4: a Set, emptied by its own walk.
const s: Set<string> = Set()
for i in 0 until 40 { s.add("e" + toString(i)) }
let sn = 0
for x in s { s.delete(x); sn = sn + 1 }
print("\{sn} \{s.length}")

// L5: at the first key, delete every key (the current one too) and insert one. The insert
// compacts a map with no live entry left; the walk still reaches the new key.
const c: {[string]: i32} = Map()
for i in 0 until 20 { c["c" + toString(i)] = i }
let cv = 0
let last = ""
for k in c {
  cv = cv + 1
  last = k
  if k == "c0" {
    for i in 0 until 20 { c.delete("c" + toString(i)) }
    c["z"] = 99
  }
}
print("\{cv} \{last} \{c.length}")

// L6: string values survive the churn. Delete the odd keys during a walk, then insert enough
// to compact, then read back what is left in order.
const d: {[string]: string} = Map()
for i in 0 until 20 { d["k" + toString(i)] = "v" + toString(i) }
for k, v in d {
  const i = parseIdx(k)
  if i % 2 == 0 { d.delete("k" + toString(i + 1)) }
}
for i in 0 until 12 { d["t" + toString(i)] = "x"; d.delete("t" + toString(i)) }
let out = ""
let ok = 0
for k, v in d {
  if v == "v" + toString(parseIdx(k)) { ok = ok + 1 }
  if out != "" { out = out + "," }
  out = out + k
}
print("\{ok} \{out}")

function parseIdx(k: string) {
  let r = 0
  for i in 1 until k.length { r = r * 10 + (k.charCodeAt(i) - 48) }
  r
}
