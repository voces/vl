// @run
// @log 4
// @hint redundant type annotation: `dbl` is inferred as `f64` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// A function map whose stored values close its storage (`dbl`'s signature adopting the hole
// lambda `g`), handed to a hole parameter that reads it by key, keys the parameter's instance at
// that storage (`elabHolderStorageTy`), so the read runs (D17813).
function dbl(a: f64): f64 { return a * 2.0 }
const g = (a) => a + 1
const m = Map()
m["a"] = g
m["b"] = dbl
function walk(mm) {
  const v = mm["a"]
  if v != null { print(v(3)) }
}
walk(m)
