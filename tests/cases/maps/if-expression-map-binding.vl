// @run
// @log 7
// @log 7
// @log q
// @log 10.5
// @log 3
// @log 2
// An un-annotated binding initialized by a value `if` whose arms are maps is a map binding, at
// module scope, in a function, and captured, for ref, string and i32-keyed maps (D2663).

type S = { a: i32 }

function mkR(v: i32): {[string]: S} {
  const m: {[string]: S} = Map()
  m["a"] = { a: v }
  return m
}
function early() { false }

function mkS(v: string): {[string]: string} {
  const m: {[string]: string} = Map()
  m["a"] = v
  return m
}

function mkI(v: i32): {[i32]: f64} {
  const m: {[i32]: f64} = Map()
  m[3] = 1.5 * v
  return m
}

const gc = if early() { mkR(8) } else { mkR(7) }
const gcv = gc["a"]
if gcv != null { print(gcv.a) }

function main() {
  const lc = if early() { mkR(8) } else { mkR(7) }
  const f = () => {
    const v = lc["a"]
    if v != null { return v.a }
    return 0
  }
  print(f())
  const ls = if early() { mkS("p") } else { mkS("q") }
  const lsv = ls["a"]
  if lsv != null { print(lsv) }
  const li = if early() { mkI(8) } else { mkI(7) }
  const liv = li[3]
  if liv != null { print(liv) }
  const lw = if early() { mkR(8) } else { mkR(7) }
  lw["b"] = { a: 3 }
  const x = lw["b"]
  if x != null { print(x.a) }
  print(lw.length)
}
main()
