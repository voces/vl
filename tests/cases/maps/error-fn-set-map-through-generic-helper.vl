// @emit-error unsupported argument type for `m` in a call to `pick`
// A map of a set of un-annotated functions handed to a generic helper binds `V` to the set, which
// the helper's instance cannot mint until instances own their sets (D14433).
function inc(x) { return x + 1 }
function dbl(x) { return x + x }
function pick<V>(m: {[string]: V}, k: string): V | null { return m.get(k) }
const m = Map()
m["a"] = inc
m["b"] = dbl
const h = pick(m, "a") ?? dbl
print(h(2))
print(h(2.5))
