// @emit-error emitProgram: the compiler cannot yet lower this statement (convert map -> map)
// @hint redundant type annotation: `dbl` is inferred as `f64` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// A function map whose calls split, handed to a hole parameter that reads it by key, refuses at
// the hand, not with an internal error: its slot is decided by its stored values, never by a
// read's pin (D17813). It runs once a parameter's instance takes its argument's storage (D17820).
function dbl(a: f64): f64 { return a * 2.0 }
const g = (a) => a + 1
const m = Map()
m["a"] = g
m["b"] = dbl
function walk(mm) {
  const v = mm["a"]
  if v != null { print(v(3)) }
}
walk(m)
