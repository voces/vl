// @run
// @log none
// @log none
// @log 4
// A map read of a function slot, returned in a list and read back, keeps its miss: a pin closing
// the read's open type keeps its `| null` (D17725).
function inc(a) { return a + 1 }
const m = Map()
m["k"] = inc
function ret() { return [m["zz"]] }
function hit() { return [m["k"]] }
const f = ret()[0]
if f != null { print(f(3)) } else { print("none") }
const l = ret()
const g = l[0]
if g != null { print(g(3)) } else { print("none") }
const h = hit()[0]
if h != null { print(h(3)) } else { print("none") }
