// @run
// @log 7
// @log 105
// @log 107
// @hint redundant type annotation: `readA` is inferred as `i32`
// @hint redundant type annotation: `readB` is inferred as `i32`
// A MAP-VALUE twin whose value is a REF LIST of declared struct twins: the two
// map slots (`{[string]: A[]}` / `{[string]: B[]}`) key the same canonical value
// type, and their vals ref-list slots are nested-array elements (kind 9) whose
// inner lists carry `A` / `B` — distinct slots, one layout. Both maps therefore
// share ONE map-struct heap type, so an `{[string]: A[]}` reads through a
// `{[string]: B[]}`-typed parameter.
type A = { v: i32 }
type B = { v: i32 }

function readA(m: { [string]: A[] }): i32 {
  const xs = m["k"]
  if xs != null { return xs[0].v }
  return -1
}
function readB(m: { [string]: B[] }): i32 {
  const xs = m["k"]
  if xs != null { return xs[0].v + 100 }
  return -1
}

function go() {
  const ma: { [string]: A[] } = Map()
  ma["k"] = [{ v: 7 }]
  print(readA(ma)) // 7
  const mb: { [string]: B[] } = Map()
  mb["k"] = [{ v: 5 }]
  print(readB(mb)) // 105
  print(readB(ma)) // 107 — the twin map crossing
}
go()
