// @run
// @log 1
// @log 41
// @log v
// @log v
// @log 7
// @log 7
// @log 2
// D15546: a `Map()` in a record handed to an un-annotated parameter takes its value type from
// the callee's store through the field, as a bare `Map()` argument does from a store into it.
function t(a) {
  a.f["k"] = 41
  print(a.f.length)
}
const r = { f: Map() }
t(r)

function deep(a) {
  a.g.f["k"] = 41
  print(a.g.f["k"] ?? 0)
}
deep({ g: { f: Map() } })

function s(a) {
  a.f["k"] = "v"
  print(a.f["k"] ?? "")
}
const q = { f: Map(), n: 3 }
s(q)
print(q.f["k"] ?? "-")

function twice(a) {
  a.f["k"] = 7
  print(a.f["k"] ?? 0)
}
twice({ f: Map() })
twice({ f: Map() })

function w1(a) { a.f["k"] = 1 }
function w2(a) {
  a.f["j"] = 2
  print(a.f.length)
}
const b = { f: Map() }
w1(b)
w2(b)
