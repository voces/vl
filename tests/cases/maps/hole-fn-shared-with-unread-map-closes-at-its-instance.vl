// @run
// @log 4
// @log 1.5
// A function stored in an annotated map and in a map nothing reads is held by the unread map at the
// one signature it is instanced at, as the map's slot fact closes it (D15754).
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const fnMap = Map()
fnMap.set("a", inc0)
fnMap.set("b", half)
const m2 = Map()
m2.set("a", half)
const v: { [string]: (a: f64) => f64 } = fnMap
const g = v.get("a")
if g != null { print(g(3)) }
const h = v.get("b")
if h != null { print(h(3)) }
