// @run
// @log true
// @log false
// @log true
// A map whose value is a Set takes the slot of the boolean map it is stored as, so a union
// holding it answers `is` against its own type (D14551).
const s: {[string]: Set<i32>} = Map()
const w: {[string]: Set<i32>} | string = s
print(w is {[string]: Set<i32>})
print(w is string)

function local() {
  const v: {[string]: Set<i32>} | string = s
  v is {[string]: Set<i32>}
}
print(local())
