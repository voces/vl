// @run
// @log -5000000000
// @log 0
// @log null
// @log 2.75
// @log 0
// @log null
// @log -3
// @log 0
// @log null
// @log -5000000000
// @log 2.75
// @log null
// @log 2.75
// @log 0
// @log null
// @log 0
// @log null
// @log -5000000000
// @log null
// `print` of a scalar-valued map read prints the stored value on a hit, a stored zero included,
// and `null` on a miss, at every position the read can stand in.
const mi: {[string]: i64} = Map()
mi["big"] = -5000000000
mi["zero"] = 0
const mf: {[string]: f64} = Map()
mf["frac"] = 2.75
mf["zero"] = 0.0
const mk: {[i32]: i32} = Map()
mk[7] = -3
mk[0] = 0

print(mi["big"])
print(mi["zero"])
print(mi["none"])
print(mf.get("frac"))
print(mf["zero"])
print(mf["none"])
print(mk[7])
print(mk[0])
print(mk[1])

function inFunction() {
  print(mi["big"])
  print(mf["frac"])
  print(mk[9])
}
inFunction()

function viaParam(m: {[string]: f64}, k: string) { print(m[k]) }
viaParam(mf, "frac")
viaParam(mf, "zero")
viaParam(mf, "none")

const inClosure = () => {
  print(mi["zero"])
  print(mi["none"])
}
inClosure()

function generic<V>(m: {[string]: V}, k: string) { print(m[k]) }
generic(mi, "big")
generic(mf, "none")
