// @run
// @log 1.5
// @log 2.5
// @log 2
// @log 2
// @log 2
// A parenthesised `??` over a hole map parameter's read has the width, operand type and list rep
// of the `??` it wraps, at each instance (D16794, D16795, D16797). Declared after the calls, since
// a hole that only reads its map is refused when the body comes first.
const mf: {[string]: f64} = Map()
mf.set("a", 1.5)
const mi: {[string]: i32} = Map()
mi.set("a", 1)
const ml: {[string]: i32[]} = Map()
ml.set("a", [1, 2])
width(mf)
plus(mf)
plus(mi)
before(mi)
size(ml)
function width(q) { print((q.get("a") ?? 0.0)) }
function plus(q) { print((q.get("a") ?? 0) + 1) }
function before(q) { print(1 + (q.get("a") ?? 0)) }
function size(q) { print((q.get("a") ?? []).length) }
