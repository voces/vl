// @run
// @log 5
// @log 5
// @log 9
// @log 5
// @log 1
// @log 1
// A `u8[]` map VALUE rides the same kind-6 ref-value spine every other list value does: the
// vals element is the `$bl8` wrapper ref, and a ref-value list already reps a `u8[]` element.
// It names itself at each classifier rather than joining the shared scalar-list one, so a
// reader that has not grown an arm keeps refusing loudly instead of misreading (D1008/D1853).
const src: u8[] = [4, 5, 6]
const m: { [string]: u8[] } = Map()
m["k"] = src
const v = m["k"]
if v != null { print(v[1]) } else { print(0) }
// `.get` is the same read through the other spelling.
const g = m.get("k")
if g != null { print(g[1]) } else { print(0) }
// The value is the list itself, not a copy — a write through the read is visible at the source.
if v != null { v[0] = 9 }
print(src[0])
// The i32-keyed map reaches it too, and so does the nullable niche: the niche and its
// non-null twin admit the same element reps, which is what keeps that pair honest.
const k: { [i32]: u8[] } = Map()
k[7] = src
const kv = k[7]
if kv != null { print(kv[1]) } else { print(0) }
const n: { [string]: u8[] | null } = Map()
n["k"] = src
print(n.length)
// Nested one level: a map whose value is a map whose value is the packed list.
const inner: { [string]: u8[] } = Map()
inner["a"] = src
const outer: { [string]: { [string]: u8[] } } = Map()
outer["b"] = inner
print(outer.length)
