// @run
// @log 6
// @hint redundant type annotation: `dbl` is inferred as `i32`
// D9533's annotated spelling: the function, the record binding and the map all declared.
type R = { f: (a: i32) => i32 }
function dbl(a: i32): i32 { return a * 2 }
const m = Map<string, R>()
const r0: R = { f: dbl }
m.set("b", r0)
const r = m.get("b")
if r != null { print(r.f(3)) }
