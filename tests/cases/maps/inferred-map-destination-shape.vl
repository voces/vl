// @run
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 0
// @log 0
// @hint redundant type annotation: `c5` is inferred as `{f: WT1}` — remove it to lean on inference
// THE DESTINATION AN UN-ANNOTATED `Map()` NEVER HAD (silent-class-inventory D203–D207).
//
// `const lv1 = Map()` takes its VALUE type from the checker's inference at the first key
// write, and that inference never looks forward. `lv1["k0"] = { r: {c2: 1} }` pins the
// object literal's OWN type, `{r: {c2: i32}}` — while the DECLARED destination the binding
// is then stored into names `Circle`. The emitter had two map structs for one map: the
// binding's cell typed from the inferred value, the destination's vals element from the
// declaration. `vl check` rc 0, and "type mismatch: expected (ref $type), found (ref $type)"
// out of the engine.
//
// FIVE CONTAINERS, THREE DESTINATION SPELLINGS, and the split is the language's, not a
// taxonomy: `dst[k] = m` (sections 1 and 2), `const c: {[string]: V}[] = [m]` (section 3),
// and `const c: W = { f: m }` (sections 4 and 5). Each section is one `cont` level of the
// census grid (`nestedmap`, `map3`, `list_of_map`, `structfield`, `structfield2`), verbatim
// from the generated cell apart from the per-section type names this file needs to hold
// them in one module.
//
// THE REP AXIS IS WHAT MAKES THE TWO IDENTITIES DIFFER, so a union ARM field is section 1–5's
// payload (`{ r: Shape2 }` against a literal `{ r: {c2: 1} }`) and a NULLABLE one is section
// 6's: the inferred literal type is a strict SUBTYPE of the declared field in both, which is
// exactly when the render and the row stop naming one layout. With `type Circle = {r: i32}`
// the two coincide and every one of these ran on master — that control is section 7, which
// must keep printing its miss.
//
// SECTION 7 IS ALSO THE FLOOR ON THE FIX: it has NO annotated destination at all, so the
// destination rung must decline and the binding must keep the shape its own initializer
// infers. A version of this fix that decided by the value NAME instead moved 9 such cells
// from `runs` to check-clean invalid wasm across a 770-cell `annpat x cont x rep` probe.

// 1 — nestedmap: `dst[k] = m` where dst's value is the map
type Cir2 = { c2: i32 }
type Sq2 = { s2: i32 }
type Shape2 = Cir2 | Sq2
type Circle = { r: Shape2 }
const lv1 = Map()
lv1["k0"] = { r: { c2: 1 } }
const c1: {[string]: {[string]: Circle}} = Map()
c1["k0"] = lv1
const a0 = (c1)["k0"] ?? Map()
const a1 = (a0)["k0"] ?? { r: { s2: 1 } }
if (a1).r is Cir2 { print(7) } else { print(0) }

// 2 — map3: the SAME store one level deeper, so the middle map is un-annotated too
type CirB = { c2: i32 }
type SqB = { s2: i32 }
type ShapeB = CirB | SqB
type CircleB = { r: ShapeB }
const lw2 = Map()
lw2["k0"] = { r: { c2: 1 } }
const lw1 = Map()
lw1["k0"] = lw2
const c2: {[string]: {[string]: {[string]: CircleB}}} = Map()
c2["k0"] = lw1
const b0 = (c2)["k0"] ?? Map()
const b1 = (b0)["k0"] ?? Map()
const b2 = (b1)["k0"] ?? { r: { s2: 1 } }
if (b2).r is CirB { print(7) } else { print(0) }

// 3 — list_of_map: the destination is an ARRAY LITERAL under a ref-array annotation
type CirC = { c2: i32 }
type SqC = { s2: i32 }
type ShapeC = CirC | SqC
type CircleC = { r: ShapeC }
const lx1 = Map()
lx1["k0"] = { r: { c2: 1 } }
const c3: {[string]: CircleC}[] = [lx1]
if c3.length > 0 {
  const d1 = (c3[0])["k0"] ?? { r: { s2: 1 } }
  if (d1).r is CirC { print(7) } else { print(0) }
} else {
  print(0)
}

// 4 — structfield: the destination is an OBJECT LITERAL field under a struct annotation
type CirD = { c2: i32 }
type SqD = { s2: i32 }
type ShapeD = CirD | SqD
type CircleD = { r: ShapeD }
type WS1 = { f: {[string]: CircleD} }
const ly1 = Map()
ly1["k0"] = { r: { c2: 1 } }
const c4: WS1 = { f: ly1 }
const e1 = ((c4).f)["k0"] ?? { r: { s2: 1 } }
if (e1).r is CirD { print(7) } else { print(0) }

// 5 — structfield2: the same field store one struct deeper
type CirE = { c2: i32 }
type SqE = { s2: i32 }
type ShapeE = CirE | SqE
type CircleE = { r: ShapeE }
type WT1 = { f: {[string]: CircleE} }
type WT2 = { f: WT1 }
const lz2 = Map()
lz2["k0"] = { r: { c2: 1 } }
const lz1: WT1 = { f: lz2 }
const c5: WT2 = { f: lz1 }
const f2 = (((c5).f).f)["k0"] ?? { r: { s2: 1 } }
if (f2).r is CirE { print(7) } else { print(0) }

// 6 — a NULLABLE-field payload, whose stored value is `null`. The rep axis reaches the
// seam a second way: `{ r: null }` against a declared `{ r: i32 | null }`. Its answer is
// the MISS (`0`), which is what the `?? { r: null }` default computes — the point is that
// the module loads at all.
type CircleF = { r: i32 | null }
const lq1 = Map()
lq1["k0"] = { r: null }
const c6: {[string]: {[string]: CircleF}} = Map()
c6["k0"] = lq1
const g0 = (c6)["k0"] ?? Map()
const g1 = (g0)["k0"] ?? { r: null }
if (g1).r != null { print(7) } else { print(0) }

// 7 — THE CONTROL, and the floor. Nothing is annotated anywhere, so the destination rung
// must decline and the un-annotated map keeps its own inferred shape. This RAN on master
// and must keep running; the miss it prints is the `?? { … }` default, not the payload.
type CircleG = { r: i32 }
const lr1 = Map()
lr1["k0"] = { r: 7 }
const c7 = Map()
c7["k0"] = lr1
const h0 = (c7)["zz"] ?? Map()
const h1 = (h0)["k0"] ?? { r: 0 }
if (h1).r == 7 { print(7) } else { print(0) }
