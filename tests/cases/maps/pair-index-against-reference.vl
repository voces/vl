// @run
// @log 0 0 0 0
// @log 0 0 0 0
// D2370: the pair index (a key or a string key's hash beside the entry number, placed by a
// multiplicative slot hash) against a flat reference, in a module that deletes. The keys are
// the families that hash worst: sequential, negative, multiples of 2^20 and 2^26, the
// extremes, and multiples of the slot multiplier's inverse, which all land in one home slot.
// Random insert / overwrite / delete / lookup over them drives many resizes and compactions,
// with an i32-keyed, a string-keyed and a string-valued map in lockstep, and every 1000 steps
// each walk, `keys()` and `values()` is compared with the reference's insertion order.
// Prints, twice (two seeds): lookup mismatches, walk mismatches, order mismatches, and the
// live count against the reference's (all 0).

function family() {
  const fam: i32[] = []
  for i in 0 until 64 { fam.push(i) }
  for i in 1 until 65 { fam.push(0 - i) }
  for i in 1 until 64 { fam.push(i << 20) }
  for i in 1 until 32 { fam.push(i << 26) }
  // 340573321 is the inverse of 0x9e3779b9 mod 2^32: `k * 0x9e3779b9` is then just `i`.
  for i in 1 until 129 { fam.push(i * 340573321) }
  fam.push(2147483647)
  fam.push(-2147483648)
  let seed = 99
  for i in 0 until 200 {
    seed = (seed * 1103515245 + 12345) & 2147483647
    fam.push(seed * 7 + 3)
  }
  fam
}

function run(seed0: i32) {
  const fam = family()
  const kn = fam.length
  const m: {[i32]: i32} = Map()
  const s: {[string]: i32} = Map()
  const sv: {[i32]: string} = Map()
  // The reference: an append-only log of (family index, value), a live flag per log row,
  // and each family index's current row (-1 when absent).
  const logI: i32[] = []
  const logLive: boolean[] = []
  const pos: i32[] = []
  const val: i32[] = []
  for i in 0 until kn {
    pos.push(-1)
    val.push(0)
  }
  let seed = seed0
  let live = 0
  let bad = 0
  let walkBad = 0
  let orderBad = 0
  for step in 0 until 12000 {
    seed = (seed * 1103515245 + 12345) & 2147483647
    const ix = (seed >> 4) % kn
    const k = fam[ix]
    const op = (seed >> 1) % 8
    if op < 4 {
      if pos[ix] < 0 {
        pos[ix] = logI.length
        logI.push(ix)
        logLive.push(true)
        live = live + 1
      }
      val[ix] = step
      m[k] = step
      s["s\{k}"] = step
      sv[k] = "v\{step}"
    } else if op < 7 {
      const had = pos[ix] >= 0
      if m.delete(k) != had { bad = bad + 1 }
      if s.delete("s\{k}") != had { bad = bad + 1 }
      if sv.delete(k) != had { bad = bad + 1 }
      if had {
        logLive[pos[ix]] = false
        pos[ix] = -1
        live = live - 1
      }
    }
    const want = if pos[ix] >= 0 { val[ix] } else { -1 }
    if (m[k] ?? -1) != want { bad = bad + 1 }
    if (s["s\{k}"] ?? -1) != want { bad = bad + 1 }
    if m.has(k) != (pos[ix] >= 0) { bad = bad + 1 }
    if pos[ix] >= 0 && (sv[k] ?? "") != "v\{want}" { bad = bad + 1 }
    if m.length != live || s.length != live || sv.length != live {
      bad = bad + 1
    }
    if step % 1000 == 999 {
      // Every map walks in the reference's order: the log's live rows, first insert first.
      let c = 0
      for key, v in m {
        while c < logI.length && !logLive[c] { c = c + 1 }
        if c >= logI.length || fam[logI[c]] != key || val[logI[c]] != v {
          walkBad = walkBad + 1
        }
        c = c + 1
      }
      c = 0
      for key in s {
        while c < logI.length && !logLive[c] { c = c + 1 }
        if c >= logI.length || "s\{fam[logI[c]]}" != key {
          walkBad = walkBad + 1
        }
        c = c + 1
      }
      const ks = m.keys()
      const vs = sv.values()
      if ks.length != live || vs.length != live { orderBad = orderBad + 1 }
      let j = 0
      for r in 0 until logI.length {
        if logLive[r] {
          if j < ks.length && ks[j] != fam[logI[r]] { orderBad = orderBad + 1 }
          if j < vs.length && vs[j] != "v\{val[logI[r]]}" {
            orderBad = orderBad + 1
          }
          j = j + 1
        }
      }
    }
  }
  // Every family key answers as the reference says, present or not.
  for i in 0 until kn {
    if m.has(fam[i]) != (pos[i] >= 0) { bad = bad + 1 }
  }
  "\{bad} \{walkBad} \{orderBad} \{m.length - live}"
}

print(run(12345))
print(run(777))
