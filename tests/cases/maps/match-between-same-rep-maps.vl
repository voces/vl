// @run
// @log 0
// @log 1
// @log -2
// D2493's `match` twin at an i32 key: each map arm compares its own box tag.
function f(u: {[i32]: i32} | {[i32]: boolean} | string) {
  match u {
    {[i32]: i32} => print(u.length)
    {[i32]: boolean} => print(-u.length)
    _ => print(0)
  }
}
f("s")
const mi: {[i32]: i32} = Map()
mi.set(1, 10)
f(mi)
const mb: {[i32]: boolean} = Map()
mb.set(1, true)
mb.set(2, false)
f(mb)
