// @run
// @log 2.5
// @log 1.5
// @log 2.5
// @log 1.5
// @log 7
// @log 2.5
// @log 1.5
// @log 2.5
// @log 1.5
// A map read's `??` with a wider default that the checker types at the default (a recursive
// function keeps the join widened, D10090) reads the stored value at the result's rep: a hit
// widens, a miss is the default. `m.get(k)`, `m[k]`, an `i64` default, a nullable value and a
// map generic over its value (D10091).
function look(m: Map<string, i32>, k: string, d: f64, n: i32) {
  if n > 0 { return look(m, k, d, n - 1) }
  return m.get(k) ?? d
}
const m: Map<string, i32> = Map()
m.set("k", 5)
print(look(m, "k", 1.5, 1) / 2)
print(look(m, "z", 1.5, 1))
function idx(m: Map<string, i32>, k: string, d: f64, n: i32) {
  if n > 0 { return idx(m, k, d, n - 1) }
  return m[k] ?? d
}
print(idx(m, "k", 1.5, 1) / 2)
print(idx(m, "z", 1.5, 1))
function wide(m: Map<string, i32>, k: string, d: i64, n: i32) {
  if n > 0 { return wide(m, k, d, n - 1) }
  return m[k] ?? d
}
print(wide(m, "k", 9, 1) + 2)
function nul(m: Map<string, i32 | null>, k: string, d: f64, n: i32) {
  if n > 0 { return nul(m, k, d, n - 1) }
  return m[k] ?? d
}
const u: Map<string, i32 | null> = Map()
u.set("k", 5)
u.set("n", null)
print(nul(u, "k", 1.5, 1) / 2)
print(nul(u, "n", 1.5, 1))
function gen<V>(m: Map<string, V>, k: string, d: f64, n: i32) {
  if n > 0 { return gen(m, k, d, n - 1) }
  return m.get(k) ?? d
}
print(gen(m, "k", 1.5, 1) / 2)
print(gen(m, "z", 1.5, 1))
