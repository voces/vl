// @emit-error an i32-keyed Map/Set cannot be a struct / variant FIELD
// CAPABILITY (B6a, i32-keyed half): the FIELD position, which `collectA`'s
// spelling gate cannot see — the field's own annotation node IS a bare
// `{[i32]: i32}`, a supported spelling; only the field ROW knows it sits in a
// struct. So the field recorder asks separately, and the message names the
// position. Without it the field's cell resolved the STRING-keyed struct and the
// reject landed much later, at the first key op, complaining about the KEY.
type B = { m: {[i32]: i32} }
const b: B = { m: Map() }
b.m[1] = 2
print(b.m.length)
