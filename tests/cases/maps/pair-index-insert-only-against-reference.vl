// @run
// @log 0 0 552
// @log 0 0 552
// D2370: the pair index in a module that never deletes, where a map keeps no `live` or
// `hashes` array and the probe has no dead-entry test. The same worst-hashing key families as
// `pair-index-against-reference.vl`, inserted and overwritten in random order into one map of
// each key and value rep, looked up (present and absent) against a flat reference after every
// step, then walked in the reference's first-insert order. Prints, per seed: lookup
// mismatches, walk mismatches, and the final size.

type P = { x: i32, y: string }

function family() {
  const fam: i32[] = []
  for i in 0 until 64 { fam.push(i) }
  for i in 1 until 65 { fam.push(0 - i) }
  for i in 1 until 64 { fam.push(i << 20) }
  for i in 1 until 32 { fam.push(i << 26) }
  // 340573321 is the inverse of 0x9e3779b9 mod 2^32: `k * 0x9e3779b9` is then just `i`.
  for i in 1 until 129 { fam.push(i * 340573321) }
  fam.push(2147483647)
  fam.push(-2147483648)
  let seed = 99
  for i in 0 until 200 {
    seed = (seed * 1103515245 + 12345) & 2147483647
    fam.push(seed * 7 + 3)
  }
  fam
}

function run(seed0: i32) {
  const fam = family()
  const kn = fam.length
  const mi: {[i32]: i32} = Map()
  const mf: {[i32]: f64} = Map()
  const ml: {[i32]: i64} = Map()
  const ms: {[string]: string} = Map()
  const mp: {[i32]: P} = Map()
  const mb: {[string]: boolean} = Map()
  const st: {[i32]: boolean} = Set()
  const order: i32[] = []
  const val: i32[] = []
  for i in 0 until kn { val.push(-1) }
  let seed = seed0
  let bad = 0
  for step in 0 until 6000 {
    seed = (seed * 1103515245 + 12345) & 2147483647
    const ix = (seed >> 4) % kn
    const k = fam[ix]
    // Insert or overwrite on 3 steps in 4, else only look up — often a key not yet present.
    if (seed >> 1) % 4 != 0 {
      if val[ix] < 0 { order.push(ix) }
      val[ix] = step
      mi[k] = step
      mf[k] = step / 2.0
      ml[k] = (step as i64) * 1000000000
      ms["s\{k}"] = "v\{step}"
      mp[k] = { x: step, y: "p\{k}" }
      mb["b\{k}"] = step % 2 == 0
      st.add(k)
    }
    const w = val[ix]
    const here = w >= 0
    if (mi[k] ?? -1) != w { bad = bad + 1 }
    if here {
      if (mf[k] ?? -1.0) != w / 2.0 { bad = bad + 1 }
      if (ml[k] ?? (0 as i64)) != (w as i64) * 1000000000 { bad = bad + 1 }
      if (ms["s\{k}"] ?? "") != "v\{w}" { bad = bad + 1 }
      if (mp[k]?.x ?? -1) != w { bad = bad + 1 }
      if (mb["b\{k}"] ?? (w % 2 != 0)) != (w % 2 == 0) { bad = bad + 1 }
    }
    if mf.has(k) != here || ml.has(k) != here || ms.has("s\{k}") != here {
      bad = bad + 1
    }
    if mp.has(k) != here || mb.has("b\{k}") != here || st.has(k) != here {
      bad = bad + 1
    }
    if mi.length != order.length || st.length != order.length { bad = bad + 1 }
  }
  // Every map walks in first-insert order.
  let walkBad = 0
  let c = 0
  for k, v in mi {
    if c >= order.length || fam[order[c]] != k || val[order[c]] != v {
      walkBad = walkBad + 1
    }
    c = c + 1
  }
  c = 0
  for k in ms {
    if c >= order.length || "s\{fam[order[c]]}" != k { walkBad = walkBad + 1 }
    c = c + 1
  }
  c = 0
  for v in mp.values() {
    if c >= order.length || v.y != "p\{fam[order[c]]}" { walkBad = walkBad + 1 }
    c = c + 1
  }
  const ks = st.values()
  const fs = mf.values()
  for r in 0 until order.length {
    if r >= ks.length || ks[r] != fam[order[r]] { walkBad = walkBad + 1 }
    if r >= fs.length || fs[r] != val[order[r]] / 2.0 { walkBad = walkBad + 1 }
  }
  "\{bad} \{walkBad} \{mi.length}"
}

print(run(4242))
print(run(31337))
