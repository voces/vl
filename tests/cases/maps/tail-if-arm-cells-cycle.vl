// @run
// @log 7
// @log 7
// @hint redundant type annotation: `gd` is inferred as `{[string]: S}`
// An un-annotated global initialized by a call to a function whose tail `if` assigns it in one
// arm and another map cell in the other: the arm join asks the global's kind, which asks the
// function's result, and the re-entered join answers from the call's checked type (D2662).

type S = { a: i32 }

function mkR(v: i32): {[string]: S} {
  const m: {[string]: S} = Map()
  m["a"] = { a: v }
  return m
}

let gd: {[string]: S} = mkR(0)
let gc = fc(false)

function fc(c: boolean) {
  if c { gc = mkR(8) } else { gd = mkR(7) }
}

const gcv = gc["a"]
if gcv != null { print(gcv.a) }
const gdv = gd["a"]
if gdv != null { print(gdv.a) }
