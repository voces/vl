// @run
// @log 4
// @log 4
// @log 4
// @log 4.5
// @hint redundant type annotation: `dbl` is inferred as `f64` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// A map of a tagged set's functions, read by key inside a hole parameter and called there, calls
// the member at its own instance and converts its result to the call's type, as at module scope
// (D17833): an integer argument through a member returning `i32` beside one returning `f64`.
function dbl(a: f64): f64 { return a * 2.0 }
const g = (a) => a + 1
const m = Map()
m["a"] = g
m["b"] = dbl
const t = m["a"]
if t != null { print(t(3)) }
function walk(mm) {
  const v = mm["a"]
  if v != null { print(v(3)) }
}
walk(m)
function walkBound(mm) {
  const v = mm["a"]
  if v != null {
    const r = v(3)
    print(r)
  }
}
walkBound(m)
function walkFloat(mm) {
  const v = mm["a"]
  if v != null { print(v(3.5)) }
}
walkFloat(m)
