// @trap
// The cell `gc` is un-annotated and its initializer calls `fc`, the very function whose
// inferred map-return shape resolving `gc` requires (D30's cycle). Compiling it must
// terminate — without the `retMapFlight` guard it hangs the compiler — and the build must be
// valid. Running it writes `gc` inside `fc` before its initializer ran, which is a runtime
// error (D2654); `tests/vl_global_read_before_init_message_test.ts` pins the sentence.
type S = { a: i32 }

function mkR(v: i32): {[string]: S} {
  const m: {[string]: S} = Map()
  m["a"] = { a: v }
  return m
}

let gc = fc(true)

function fc(c: boolean) {
  if c { gc = mkR(8) } else { gc = mkR(7) }
}

const gcv = gc["a"]
if gcv != null { print(gcv.a) }
