// @run
// @log x
// @log 1.5
// @log 9000000000
// @log one
// @log 3
// @log true
// @log true
// @log 7
// AN INFERRED MAP PINNED BY A WRITE THROUGH AN UN-ANNOTATED PARAMETER. `const m = Map()`
// followed by `put(m)`, where `put`'s body is the only thing that says what the map holds.
// Three per-rep ladders each had an arm for every collection except map:
//
//   · the hole RECEIVER of a method call is constrained to an ARRAY by `.map`/`.filter`/
//     `.push`/`.pop`; the map surface (`.set`/`.get`/`.has`/`.delete`/`.add`/`.keys`/
//     `.values`) had no dual, so `q.set("a", 1)` grew a `{set: any}` STRUCT shape and the
//     call reported `expected {set: _}, got {[string]: i32}` — naming a method the argument
//     has;
//   · the hole receiver of an INDEX assumed an array for every index, so `q["a"] = 1` was
//     `array index must be i32, got string` about a parameter nothing called an array. An
//     array is i32-indexed, so a non-i32 index can only be a map — that is the whole
//     disambiguation;
//   · the monomorphizer's PIN NAME for an argument named string, five list reps, union,
//     struct and four scalars, and fell through to the `"i32"` default for a map, so even a
//     call the checker let through emitted an i32 param over a body doing map work.
//
// The demand the callee's own operations pin is what pins the ARGUMENT: `constrainEmpty`
// closes `m`'s open holes from it, which is what clears the `cannot infer a type for 'm'`
// floor. Both WRITE spellings are here because they are two ladders, not one.
//
// THE FILE MUST STAY ANNOTATION-FREE AT EVERY MAP (`infer-value-kinds.vl` states the rule):
// an annotated `{[K]: V}` anywhere in the module mints that (KEY, VALUE) slot and the
// inferred binding then FINDS it. Each callee is its own function for the second reason the
// sibling fixtures give — the instance registry is keyed by function + signature, so two
// call sites of one callee unify into a single value type and stop testing separate reps.

// The headline, index spelling: the parameter's write is the only spelling of the type.
function putStr(q) {
  q["a"] = "x"
}
const ms = Map()
putStr(ms)
print(ms["a"] ?? "none") // x

// kind 11 — an f64 value, index spelling.
function putF64(q) {
  q["a"] = 1.5
}
const mf = Map()
putF64(mf)
print(mf["a"] ?? 0.0) // 1.5

// kind 10 — an i64 value through the `.set` spelling, the other ladder.
function putI64(q) {
  q.set("a", 9000000000)
}
const mi = Map()
putI64(mi)
print(mi["a"] ?? 0) // 9000000000

// The i32 KEY half through `.set`, whose own key pin is what decides which of the two map
// structs the instance rides.
function putIKey(q) {
  q.set(1, "one")
}
const mk = Map()
putIKey(mk)
print(mk[1] ?? "none") // one

// A struct value over a REF vals list.
function putStruct(q) {
  q.set("a", { x: 3 })
}
const mp = Map()
putStruct(mp)
print((mp["a"] ?? { x: 0 }).x) // 3

// `.add` on a hole can only mean a Set — boolean-valued, on either key rep.
function addStr(q) {
  q.add("a")
}
const ss = Set()
addStr(ss)
print(ss.has("a")) // true

function addI32(q) {
  q.add(7)
}
const si = Set()
addI32(si)
print(si.has(7)) // true

// TWO un-annotated parameters, the map in the second slot — the pin is per-parameter, not a
// property of being the first argument.
function putAt(n: i32, q) {
  q["n"] = n
}
const mn = Map()
putAt(7, mn)
print(mn["n"] ?? 0) // 7
