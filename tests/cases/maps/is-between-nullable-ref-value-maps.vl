// @run
// @log false
// @log true
// @log true
// @log false
// @log 2
// @log 3
// @log false
// @log true
// A nullable-ref map value is stored as its non-null twin is, so the two maps share one struct;
// each owns its box tag, and `is` tells them apart (D2690).
type Circle = { r: i32 }
const ms: {[string]: string | null} = Map()
ms["k"] = null
const us: {[string]: string} | {[string]: string | null} = ms
print(us is {[string]: string})
print(us is {[string]: string | null})
const mc: {[i32]: Circle} = Map()
mc[1] = { r: 2 }
function f(u: {[i32]: Circle} | {[i32]: Circle | null}) {
  if u is {[i32]: Circle | null} { return 3 }
  const c = u[1]
  if c != null { return c.r }
  0
}
const uc: {[i32]: Circle} | {[i32]: Circle | null} = mc
print(uc is {[i32]: Circle})
print(uc is {[i32]: Circle | null})
print(f(mc))
const mn: {[i32]: Circle | null} = Map()
print(f(mn))
const ma: {[i64]: i32[] | null} = Map()
const ua: {[i64]: i32[]} | {[i64]: i32[] | null} | string = ma
print(ua is {[i64]: i32[]})
print(ua is {[i64]: i32[] | null})
