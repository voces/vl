// @run
// @log 1
// @log 1
// @log 1
// @log 1
// @log green
// @log green
// @log 1
// @log 1
// @log 0
// @log 7
// @log 0
// A literal union as a MAP KEY, at every consumer that takes one and every one that hands
// one back. Such a map hashes as i32 because its keys REP as the interned atom, so a key
// written as a member literal lowers as that id and `m[m.keys()[0]]` closes the loop with
// no widen at either end (D1748).
//
// The `.ann` face is the point: the map's SPELLING says `{[K]: i32}`, whose key text is not
// `i32`, so the emitter's name-keyed question had to learn what the arena already said.
//
// The NUMERIC half is the same sentence at the other rep: `0 | 1` reps as its own i32 base
// rather than an interned atom, and hashes for that reason. An `i64`- or `f64`-based member
// set reps as neither and is still refused — `error-litunion-map-key-wide-base.vl`.

type K = "red" | "green"

// ---- consumers that TAKE a key ----

function writes(a: K) {
  const m: {[K]: i32} = Map()
  m[a] = 1
  print(m["green"] ?? 0)
}

function sets(a: K) {
  const m: {[K]: i32} = Map()
  m.set(a, 1)
  print(m.get("green") ?? 0)
}

function asks(a: K) {
  const m: {[K]: i32} = Map()
  m["green"] = 1
  if m.has(a) { print(1) } else { print(0) }
}

function boundKey(a: K) {
  const m: {[K]: i32} = Map()
  const k: K = "green"
  m[k] = 1
  print(m[a] ?? 0)
}

// ---- consumers that HAND a key back ----

// The read must widen the atom to its member text, at both the `.keys()` element and the
// bare for-in walk — the loop var is the one storage class with no declaration to read.
function handsBack(a: K) {
  const m: {[K]: i32} = Map()
  m[a] = 1
  print(m.keys()[0])
  for k in m { print(k) }
  print(m[m.keys()[0]] ?? 0)
}

// A Set is a boolean-valued map and rides the same key rep.
function membership(a: K) {
  const s: {[K]: boolean} = Set()
  s.add(a)
  print(s.size)
  s.delete("green")
  print(s.size)
}

type N = 0 | 1

// The numeric member set: no interning, the key IS the value, and the read prints the number.
function numeric(a: N) {
  const m: {[N]: i32} = Map()
  m[a] = 7
  print(m[0] ?? 0)
  for k in m { print(k) }
}

writes("green")
sets("green")
asks("green")
boundKey("green")
handsBack("green")
membership("green")
numeric(0)
