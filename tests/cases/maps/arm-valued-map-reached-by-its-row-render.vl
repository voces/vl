// @run
// @log 7
// @log 5
// @log 3
// D671, ARM HALF. AN UN-ANNOTATED MAP WHOSE VALUE SHAPE A UNION ARM ALREADY CLAIMED.
//
// `{ n: 7 }` has the field set of `Ca`, an arm of `U1`, so `objVariantName` claims it and
// `collectAnonShapes` SKIPS the `#anonN` row it would otherwise mint — the skip is right,
// because a literal the emitter really does box must not also have a bare struct row. The
// checker meanwhile types this map's value as the anonymous row `{n: i32}`, which is the
// only spelling the mv layer ever holds (`tyToEmitName` of the recorded type).
//
// So the map asked its two name-keyed resolvers which row `{n:i32}` names, and both said
// none: `structIndexByValName` because `collectS` skips a union member, `variantIndexOf`
// because it is a NOMINAL `uVariants` lookup and the render is not the arm's name. The
// answer was `emitProgram: unsupported map value type` on a program whose ANNOTATED
// spellings — `{[string]: Ca}` and `{[string]: U1}`, both below — have always run.
//
// `mvValArmOfShape` reads the adoption instead of contradicting it, gated on the struct
// lookup having declined, so a genuinely anonymous map value (which has its own `#anonN`
// row) never reaches it.
type Ca = {n: i32}
type Sq = {s: i32}
type U1 = Ca | Sq

// THE ROW THIS FILE IS ABOUT: nothing annotated anywhere.
function bare() {
  const m = Map()
  m["k"] = { n: 7 }
  const g = m["k"] ?? { n: 0 }
  print(g.n)
}

// The ARM-annotated control, which ran before this landing and must keep running.
function annotArm() {
  const m: {[string]: Ca} = Map()
  m["k"] = { n: 5 }
  const g = m["k"] ?? { n: 0 }
  print(g.n)
}

// The UNION-annotated control — the value is the box, narrowed on the read.
function annotUnion() {
  const m: {[string]: U1} = Map()
  m["k"] = { n: 3 }
  const g = m["k"] ?? { s: 0 }
  if g is Ca { print(g.n) } else { print(0) }
}

bare()
annotArm()
annotUnion()
