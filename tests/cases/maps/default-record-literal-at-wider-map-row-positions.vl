// @run
// @log 4
// @log 4
// @log 4
// @log 4
// @log 4
// @log 4
// @log 4
// @log 9
// @log 9
// @log 9
// @log 9
// @log 8
// @log 9
// @log 9
// A map read's default that is a literal of a declared record's own fields (`I`), read off a map
// of a wider record (`J`), is delivered at the map's value row in the start body: the hit and the
// miss both print through it. Q58 positions at top level; key "a" hits, key "z" misses.
type O = { v: i32 }
type I = { f: O }
type J = { f: O | null }
const s = { f: { v: 4 } }
const m = Map<string, J>()
m.set("a", s)
function vOf(j: J): i32 { return j.f?.v ?? 70 }
function wrap(j: J): i32 { return vOf(j) }
function ret(k: string): J { return m.get(k) ?? { f: { v: 9 } } }
type Holder = { j: J }
const q: J | null = null
print(vOf(m.get("a") ?? { f: { v: 9 } }))
print(wrap(m.get("a") ?? { f: { v: 9 } }))
print(vOf(ret("a")))
const xa = m.get("a") ?? { f: { v: 9 } }
print(xa.f?.v ?? 70)
const ya = if m.has("a") { m.get("a") ?? { f: { v: 9 } } } else { m.get("a") ?? { f: { v: 8 } } }
print(vOf(ya))
print(vOf(q ?? (m.get("a") ?? { f: { v: 9 } })))
const ha: Holder = { j: m.get("a") ?? { f: { v: 9 } } }
print(vOf(ha.j))
print(vOf(m.get("z") ?? { f: { v: 9 } }))
print(wrap(m.get("z") ?? { f: { v: 9 } }))
print(vOf(ret("z")))
const xz = m.get("z") ?? { f: { v: 9 } }
print(xz.f?.v ?? 70)
const yz = if m.has("z") { m.get("z") ?? { f: { v: 9 } } } else { m.get("z") ?? { f: { v: 8 } } }
print(vOf(yz))
print(vOf(q ?? (m.get("z") ?? { f: { v: 9 } })))
const hz: Holder = { j: m.get("z") ?? { f: { v: 9 } } }
print(vOf(hz.j))
