// @check
// @error a `match` arm cannot tell {[i32]: i32} from {[i32]: boolean} yet
// D2493's `match` twin at an i32 key: the arm would compare the one box tag both maps share.
function f(u: {[i32]: i32} | {[i32]: boolean} | string) {
  match u {
    {[i32]: i32} => print(u.length)
    _ => print(0)
  }
}
f("s")
