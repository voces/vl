// @error `??` default expects a value, got void
// CONTRACT (must-error): the `??` DEFAULT is the value the expression yields when the left
// side is null, so a void call there leaves the coalesce with nothing to produce.
//
// `??` is the one operator with no shape demand of its own to catch this: the others reject
// a void operand through their arms (`operator '+' is not defined for void and i32`, `cannot
// compare void with i32`, `operator '!' expects boolean, got void`), while `??` JOINS its
// operands' types instead of demanding a shape of them. So the void flowed into the join and
// on to codegen, which emitted a module that failed to validate.
//
// A VERDICT pin: the program does not build either way, and the fix moves the refusal to the
// check tier — there is no correct output for a `@log` to pin.
function pv() { print(1) }
const m: {[string]: i32} = Map()
m.set("a", 1)
print(m["a"] ?? pv())
