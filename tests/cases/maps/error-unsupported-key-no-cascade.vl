// @check
// @error-at 8:9 A P-keyed Map isn't supported yet — `Map`/`Set` keys must be `string`, `i32` or `i64`
// @error-at 12:19 A boolean-keyed Map isn't supported yet — `Map`/`Set` keys must be `string`, `i32` or `i64`
// @error-at 14:18 An f64-keyed Map isn't supported yet — `Map`/`Set` keys must be `string`, `i32` or `i64`
// A refused key type reports once, wherever the annotation stands: a binding, a parameter and
// a return name the key, and an index of the refused map adds no `array index` error.
type P = { x: i32, y: i32 }

const m: {[P]: string} = Map()
m[{ x: 1, y: 2 }] = "a"
print(m[{ x: 1, y: 2 }] ?? "none")

function byFlag(t: {[boolean]: i32}): i32 { return t[true] ?? 0 }

function fresh(): {[f64]: i32} { return Map() }
