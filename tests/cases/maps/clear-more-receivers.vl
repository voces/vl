// `.clear()` on a map or set at receivers `clear-receivers.vl` leaves out: a parameter, a nullable
// map narrowed non-null, a set held in a record field, inside an `if` arm and a loop, and a map
// keyed by string.
// @run
// @log 0
// @log 0
// @log true
// @log 0
// @log 0
// @log 1
// @log 0
type H = { s: {[i32]: boolean} }
function viaParam(m: {[i32]: i32}) {
  m.clear()
  print(m.length)
}
function viaNullable(m: {[i32]: i32} | null) {
  if m != null {
    m.clear()
    print(m.length)
  }
}
function viaField(h: H) {
  h.s.clear()
  print(!h.s.has(1))
  print(h.s.length)
}
function inArm(m: {[string]: i32}, go: boolean) {
  if go { m.clear() } else { m.set("x", 9) }
  print(m.length)
}
function inLoop(m: {[i32]: i32}) {
  for i in 0 until 3 {
    m.clear()
    m.set(i, i)
  }
  print(m.length)
  m.clear()
  print(m.length)
}
const a: {[i32]: i32} = Map()
a.set(1, 1)
viaParam(a)
const b: {[i32]: i32} = Map()
b.set(2, 2)
viaNullable(b)
const s: {[i32]: boolean} = Map()
s.set(1, true)
viaField({ s: s })
const r: {[string]: i32} = Map()
r.set("a", 1)
inArm(r, true)
inLoop(Map())
