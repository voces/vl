// @emit-error unsupported map value type
// A binding of a map entry of a set of un-annotated functions would hold a nullable id of the
// set, which has no rep yet, so the set stays untagged and the map refuses its value (D14432).
function inc(x) { return x + 1 }
function dbl(x) { return x + x }
const m = Map()
m.set("a", inc)
m.set("b", dbl)
const g = m.get("b")
if (g != null) {
  print(g(2))
  print(g(2.5))
}
