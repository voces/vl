// @run
// @log null
// @log 4
// @log -1
// @log 1.5
// @log null
// @log 5000000000
// @log 5
// @log true
// @log 4
// @log 4
// @log null
// @log true
// @log null
// @log 0.5
// @log 0
// @log 9
// @log null
// @log 7
// `m[k] as? V` over a scalar-valued map's read is the read itself: the value on a hit, `null`
// on a miss, at every value width and wherever the cast is consumed (D2467).
const m: {[string]: i32} = Map()
print(m["zz"] as? i32)
m["k"] = 4
print(m["k"] as? i32)
print(m["zz"] as? i32 ?? -1)
const fm: {[string]: f64} = Map()
fm["k"] = 1.5
print(fm["k"] as? f64)
print(fm["z"] as? f64)
const lm: {[string]: i64} = Map()
lm["k"] = 5000000000
print(lm["k"] as? i64)
const v = m["k"] as? i32
if v != null { print(v + 1) }
print((m["z"] as? i32) == null)
print((m["k"] as? i32) ?? 0)
function get(k: string): i32 | null { return m[k] as? i32 }
print(get("k"))
print(get("q"))
const bm: {[string]: boolean} = Map()
bm["t"] = true
print(bm["t"] as? boolean)
print(bm["f"] as? boolean)
function local() {
  const om: {[string]: f64} = Map()
  om["a"] = 0.5
  return om["a"] as? f64
}
print(local())
const z: {[string]: i32} = Map()
z["zero"] = 0
print(z["zero"] as? i32)
function pick<V>(pm: {[string]: V}, k: string) { return pm[k] as? V }
const pm: {[string]: i32} = Map()
pm["k"] = 9
print(pick(pm, "k"))
print(pick(pm, "x"))
const c: Map<string, i32> = Map()
c["x"] = 7
print(c["x"] as? i32)
