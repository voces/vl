// @log 3
// An un-annotated `Map()` of two-signature bundles: its value type is open while its mv slot stores
// the bundle record, so the IR holds the map at that record, as legacy stores it. Q58 sweep over a
// module `const` and `let`: `.has`, index, `get`, a write and a lambda's capture, each calling the
// bundle it reads, and a `??` defaulting to another bundle holder (D17583); a `for` over its values
// is D17582.
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
const m = Map()
m["a"] = lap((a) => a + 1)
let n = Map()
n["x"] = lap((a) => a * 2)
function has() { return m.has("a") }
function viaIndex() {
  const h = m["a"]
  if h != null { print(h(1.5)) }
}
function viaGet() {
  const h = m.get("a")
  if h != null { print(h(4)) }
}
function store() { m["b"] = lap((a) => a - 1) }
const seen = () => m.has("b")
print(has())
viaIndex()
viaGet()
store()
print(seen())
function fromLet() {
  const h = n["x"]
  if h != null { print(h(3)) }
}
fromLet()
const dflt = lap((a) => a * 2)
const hit = m["a"] ?? dflt
print(hit(1.5))
const o = Map()
o["k"] = lap((a) => a + 1)
const dflt2 = lap((a) => a * 2)
const miss = o["zz"] ?? dflt2
print(miss(1.5))
