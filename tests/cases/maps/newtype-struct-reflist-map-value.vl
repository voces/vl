// @run
// @log 3
// @log 4
// @hint redundant type annotation: `readAView` is inferred as `i32`
// @hint redundant type annotation: `readBView` is inferred as `i32`
// A NEWTYPE over a struct as the ELEMENT of a ref-LIST map value — the kind-6 arm,
// whose vals ref-list slot is interned BEFORE the mv row is pushed.
//
// The two newtypes are the same shape, so `{[string]: AView[]}` and
// `{[string]: BView[]}` key one canonical value type and share the map struct while
// staying distinct arena indices. This is the ref-list twin of
// `newtype-struct-map-value-twin.vl`.
type AView = new { base: i32, length: i32 }
type BView = new { base: i32, length: i32 }

function readAView(m: { [string]: AView[] }): i32 {
  const xs = m["r"]
  if xs != null { return xs[0].base }
  return -1
}
function readBView(m: { [string]: BView[] }): i32 {
  const xs = m["r"]
  if xs != null { return xs[0].base }
  return -1
}

function goReflistNewtype() {
  const am: { [string]: AView[] } = Map()
  am["r"] = [{ base: 3, length: 1 }]
  print(readAView(am))
  const bm: { [string]: BView[] } = Map()
  bm["r"] = [{ base: 4, length: 2 }]
  print(readBView(bm))
}
goReflistNewtype()
