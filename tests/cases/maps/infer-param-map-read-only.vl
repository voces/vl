// @run
// @log x
// @log none
// @log 7
// @log true
// @log 2
// @log 1.5
// A hole parameter that only reads its map is pinned by the argument, in either declaration
// order: the body's reads take the map the call hands it (D16714, D15161).
function takeStr(q) { print(q.get("a") ?? "none") }
const m: {[string]: string} = Map()
m["a"] = "x"
takeStr(m)
const e: {[string]: string} = Map()
takeStr(e)
const n: {[string]: i32} = Map()
n.set("z", 7)
byIndex(n)
hasKey(n)
const k = Map()
k.set("a", 1)
k.set("b", 2)
after(k)
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const fs = Map()
fs.set("a", inc0)
fs.set("b", half)
callB(fs)
function byIndex(q) { print(q["z"] ?? 0) }
function hasKey(q) { print(q.has("z")) }
function after(q) {
  const g = q.get("b")
  if g != null { print(g) }
}
function callB(q) {
  const g = q.get("b")
  if g != null { print(g(3)) }
}
