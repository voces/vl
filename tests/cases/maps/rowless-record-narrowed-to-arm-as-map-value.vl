// @log true
// @log true
// @log true
// @log true
// A record literal with no row of its own (`{ r: null }`) beside the union arm it narrows to is
// stored as that arm in an un-annotated map: stored directly, bound first, from a maker, and read
// back with a default (D17400).
type Shape = Circle | Sq
type Sq = { s: i32 }
type Circle = { r: i32 | null }
function mk() { return { r: null } }
const m = Map()
m["k"] = { r: null }
print(m.has("k"))
const n = Map()
const c = { r: null }
n["k"] = c
const x = n["k"]
if x != null { print(x.r == null) }
const p = Map()
p["k"] = mk()
const y = p["k"]
if y != null { print(y.r == null) }
const z = m["j"] ?? { r: null }
print(z.r == null)
