// @run
// @log true
// @log false
// @log true
// @log true
// @log hi
// @log true
// @log true
// @log true
// @log j
// @log true
// @log j
// A map whose value is a recursive nullable alias stores and reads its values through
// the alias's own arms at an annotated binding, an inferred return and a record field.
type J = null | boolean | f64 | string | J[] | { [string]: J }

const m: Map<string, J> = Map()
m.set("t", true)
m.set("n", null)
m.set("s", "hi")
print(m.has("n"))
print(m.has("q"))
const t = m.get("t")
if t is boolean { print(t) }
print(m.get("n") == null)
const s = m.get("s")
if s is string { print(s) }
const o: J = m
if o is { [string]: J } { print(o.has("s")) }

function mk(): J { return "j" }
function nl(): J { return null }
function build() {
  const b = Map<string, J>()
  b.set("a", mk())
  b.set("n", nl())
  return b
}
const bm = build()
print(bm.has("a"))
print(bm.get("n") == null)
const g = bm.get("a")
if g != null {
  if g is string { print(g) }
}

type R = { tag: string, kids: Map<string, J> }
const r: R = { tag: "t", kids: Map() }
r.kids.set("a", "j")
r.kids.set("n", null)
print(r.kids.has("n"))
const k = r.kids.get("a")
if k != null {
  if k is string { print(k) }
}
