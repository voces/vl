// @emit-error bare null needs a struct-typed context
// Binding a LIST-valued map read to a MODULE-SCOPE `const`, then narrowing it, has no arm —
// and THE SECOND HALF OF THIS FILE IS NOT NULLABLE, which is the point.
//
// Both halves report the same message on master and on the branch that closed the
// nullable-list map value (`maps/nullable-list-valued-map.vl`). Measured as a 2x2 over
// scope x nullability, 6 list reps x 5 map operations x 2 runtime inputs:
//
//                  `V | null`            `V`
//     function      0/60 -> 60/60         60/60 -> 60/60
//     MODULE        0/60 -> 48/60         48/60 -> 48/60
//
// The 12 that stay loud in each MODULE row are the same 12 coordinates — this `read`
// operation, every rep, both inputs — and the `V` column does not move at all, on either
// side. So what is missing is not the niche and not the scope in general: `.size`, `.has`,
// `?? d` and `.values()` over the same nullable-list map all lower at module scope, and a
// nullable STRING or nullable MAP value binds fine there too.
//
// THE MISSING RUNG, NAMED. A module-scope binding is a GLOBAL cell, so its kind resolves
// through `letNulScalarListKind` -> `exprNulScalarListKind(d.letInit)`; a function-local one
// resolves through `letCellKind` / `letInitCellKind`, which DO carry a `mapReadMvSlot` arm.
// That is the whole difference. The Index arm of the list-family nullable classifiers
// (`exprNulScalarListKind` / `exprNullableList` / `exprNullableRefArray`) reads a
// `(T[] | null)[]` ELEMENT and nothing else, where `exprNullableStruct` (`mvValKind == 1`),
// the `nulstr` classifier (`== 3`), the union-box one (`== 2`) and the closure one (`== 14`)
// each ask `mapReadMvSlot`. Value kind **6** — a list — is the one kind with no consumer arm,
// which is why this is list-specific and nullability-blind.
//
// Its sibling is `maps/error-inline-null-compare-list-value.vl`: an INLINE `m[k] == null`
// over a list-valued map is the same rung asked without a binding at all. One rung closes
// both; delete both files together, not this one alone.

const nulm: {[string]: f64[] | null} = Map()
nulm["k"] = [1.5, 2.5]
const nv = nulm["k"]
if nv != null { print(nv.length) } else { print("N") }

// THE CONTROL, and it is master's own gap: the value type carries no `| null` at all. The
// map read's implicit `T?` makes `pv` nullable either way, and this half has never lowered.
const plainm: {[string]: f64[]} = Map()
plainm["k"] = [1.5, 2.5]
const pv = plainm["k"]
if pv != null { print(pv.length) } else { print("N") }
