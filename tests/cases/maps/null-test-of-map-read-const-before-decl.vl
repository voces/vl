// A null test of a module `const` holding a map read, in a function declared before the `const`,
// takes the nullable-ref arm (D17125).
// @run
// @log true
// @hint redundant type annotation: `has` is inferred as `boolean`
const m = Map()
m["a"] = { v: 1 }
function has(): boolean { return x != null }
const x = m["a"]
print(has())
