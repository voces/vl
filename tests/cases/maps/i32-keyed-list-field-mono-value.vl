// @run
// @log 7
// @log true
// @log 2
// THE MONO-VALUED TWIN of `i32-keyed-list-field-collect.vl`: the same list-typed
// inline-shape field position with an i32 VALUE, which fails at the same missing flag by
// the OTHER route.
//
// An i32 / boolean value interns no mv slot — it rides the shared i32 `vals` list — so the
// op's map shape is the mono sentinel `-4`, and `mapTypeIdxOf`'s `-4` arm GUARDS on
// `mI32Used` and rejects loudly ("i32-keyed map but its map struct was not collected")
// rather than emitting a `struct.get` against the string-keyed twin. Same cause as the
// f64-valued file, opposite symptom: that one is `vl check` rc 0 + invalid wasm, this one
// is a clean emit reject of a correct fully-annotated program.
//
// Kept in its own file for the module-wide-flag reason (see the f64 file's header) AND so
// the two symptoms stay separately pinned: with both in one file the loud reject fires
// first and the silent cell is never reached.

const s: {m: {[i32]: i32}[]} = { m: [Map()] }
s.m[0][11] = 7
s.m[0][22] = 8
print(s.m[0][11] ?? 0) // 7
print(s.m[0].has(22))  // true
print(s.m[0].length)   // 2
