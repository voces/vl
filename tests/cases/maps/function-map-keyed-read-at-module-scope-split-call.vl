// @run
// @log 4
// @hint redundant type annotation: `dbl` is inferred as `f64` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// A keyed read of a function map whose calls split, at module scope, called at `(i32)`: the
// neighbour of D17813, whose parameter spelling refuses.
function dbl(a: f64): f64 { return a * 2.0 }
const g = (a) => a + 1
const m = Map()
m["a"] = g
m["b"] = dbl
const v = m["a"]
if v != null { print(v(3)) }
