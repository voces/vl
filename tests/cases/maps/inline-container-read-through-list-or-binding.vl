// An empty `Map()` read in place, through a list literal it sits in or a call handed it with
// scalars, settles at the read (D16892). A call or list handed a binding can return that binding,
// so a read through it leaves the binding's type to its later writes.
function take<T>(x: T): T { return x }
function two<T>(pick: boolean, a: T, b: T): T {
  return if pick { a } else { b }
}
function keep<T>(a: T, n: i32): T { return if n > 0 { a } else { a } }
print([Map()][0].get("a") ?? 7)
print(take([Map()])[0].get("a") ?? 7)
print(two(true, Map(), Map()).has("q"))
print(keep(Map(), 1)["q"] ?? 3)
const m = Map()
print(take(m).has("a"))
m.set("a", "x")
print(m.get("a") ?? "n")
const n = Map()
print(take(n)["a"] ?? "z")
n.set("a", "y")
print(n.get("a") ?? "n")
const p = Map()
print([p][0].has("a"))
p.set("a", "w")
print(p.get("a") ?? "n")
const q = Map()
print(two(true, q, Map()).has("a"))
q.set("a", "v")
print(q.get("a") ?? "n")
const g = Map()
function pickG(k: i32) { return if k > 0 { g } else { g } }
print(pickG(1).has("a"))
g.set("a", "u")
print(g.get("a") ?? "n")
