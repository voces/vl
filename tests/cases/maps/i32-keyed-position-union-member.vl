// @run
// @log 1
// @log 7
// @log 2
// @log 9
// @log -1
// @log 42
// An i32-keyed map IS a union member (owner ruling 2026-09-26, `open-rulings.md`
// §B6a-map-in-union-box): the box tags it at its own code, so the `is`-narrowed read casts
// to the i32-keyed map struct rather than the string-keyed one. This program was a loud emit
// refusal, and before the refusal existed it was check-clean invalid wasm.
const m: {[i32]: i32} = Map()
m[1] = 7
const u: {[i32]: i32} | i32 = m
if u is {[i32]: i32} { print(u.length) } else { print(-1) }
if u is {[i32]: i32} {
  print(u[1] ?? -1)
  u.set(2, 9)
  print(u.length)
  print(u.get(2) ?? -1)
  u.delete(1)
  print(u[1] ?? -1)
}
function f(x: {[i32]: string} | i32) {
  match x {
    {[i32]: string} => x.length
    i32 => x
  }
}
print(f(42))
