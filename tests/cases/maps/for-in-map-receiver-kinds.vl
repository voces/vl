// @run
// @log 7
// @log 5
// @log 1
// @log 103
// @log 15
// @log 4
// @log 5
// @log 0
// A map walk over a receiver that is no global: a local, a parameter, a field read, a call that
// runs once, two nested walks over two maps, a body that writes another map, and a nullable
// parameter narrowed by `!= null`.
type O = { m: {[string]: i32} }
let calls = 0
function mk(): {[string]: i32} {
  calls = calls + 1
  const m: {[string]: i32} = Map()
  m["a"] = 1
  m["b"] = 2
  return m
}
function local() {
  const m: {[string]: i32} = Map()
  m["x"] = 3
  m["y"] = 4
  let s = 0
  for k in m.keys() { s = s + (m[k] ?? 0) }
  return s
}
function param(m: {[string]: i32}) {
  let s = 0
  for v in m.values() { s = s + v }
  return s
}
function field(o: O) {
  let n = 0
  for k in o.m.keys() { n = n + k.length }
  return n
}
function call() {
  let s = 0
  for v in mk().values() { s = s + v }
  return s + calls * 100
}
function nested(a: {[string]: i32}, b: {[string]: i32}) {
  let s = 0
  for x in a.values() {
    for y in b.values() { s = s + x * y }
  }
  return s
}
function mutates(a: {[string]: i32}) {
  const other: {[string]: i32} = Map()
  let n = 0
  for k in a.keys() {
    other[k] = n
    n = n + 1
  }
  return n + other.length
}
function nullable(m: {[string]: i32} | null) {
  let s = 0
  if m != null {
    for v in m.values() { s = s + v }
  }
  return s
}
const g: {[string]: i32} = Map()
g["p"] = 5
print(local())
print(param(g))
print(field({ m: g }))
print(call())
print(nested(g, mk()))
print(mutates(mk()))
print(nullable(g))
print(nullable(null))
