// @run
// @log 2
// @log 30
// @log 1:10
// @log 2:20
// @log 3
// @log 2
// A `for ... in` over a global whose type is a union of a map and another type, narrowed to the map
// before the walk: its keys, its values and its pairs, in a function and at the top.
const u: {[i32]: i32} | string = Map()
function fill() {
  if u is {[i32]: i32} {
    u[1] = 10
    u[2] = 20
  }
}
fill()
function keys() {
  let c = 0
  if u is {[i32]: i32} {
    for k in u { c = c + 1 }
  }
  return c
}
function vals() {
  let s = 0
  if u is {[i32]: i32} {
    for v in u.values() { s = s + v }
  }
  return s
}
function pairs() {
  if u is {[i32]: i32} {
    for k, v in u { print("\{k}:\{v}") }
  }
}
print(keys())
print(vals())
pairs()
let t = 0
if u is {[i32]: i32} {
  for k in u { t = t + k }
}
print(t)
let n = 0
if u is {[i32]: i32} {
  for v in u.values() { n = n + 1 }
}
print(n)
