// @run
// @log true
// @log 12
// @log 2
// A walk of an `i64`-keyed map's keys binds each key at `i64` when a `string`-keyed map with the
// same value type is built first: the key rep comes from the walked map's own type, not from the
// first map interned with that value.
function mk(): {[string]: i32 | string} {
  const m: {[string]: i32 | string} = Map()
  m["a"] = 1
  return m
}
function keys(m: {[i64]: i32 | string}) {
  let t: i64 = 0
  for k in m.keys() { t = t + k }
  print(t)
}
function count(m: {[string]: i32 | string}) {
  let n = 0
  for k in m.keys() {
    if k != "" { n = n + 1 }
  }
  print(n)
}
const g: {[i64]: i32 | string} = Map()
g[5 as i64] = "x"
g[7 as i64] = 9
print(mk().has("a"))
keys(g)
const h = mk()
h["b"] = "y"
count(h)
