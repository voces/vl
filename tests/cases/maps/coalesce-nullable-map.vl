// @run
// @log 2
// @log -1
// @log 1
// @log -1
// @log 20
// @log -9
// @log x
// @log dflt
// @log 7.25
// @log 2.5
// @log 20
// @hint redundant type annotation: `o` is inferred as `{[string]: i32} | null`
// `??` over a nullable map with a default of the same map type is that map: the operand when it
// is present, else the default, at the operand's shape. A binding of it is a map (D3257).
function mk(n: i32): Map<string, i32> {
  const m = Map<string, i32>()
  m["a"] = n
  m
}
function h(n: i32, c: boolean) {
  const o: Map<string, i32> | null = if c { mk(n) } else { null }
  const z = o ?? mk(-1)
  z["a"] ?? -9
}
function size(o: Map<string, i32> | null) {
  const z = o ?? mk(-1)
  z.length
}
function loopVal(n: i32) {
  const m = for i in 0 until 4 {
    if i == n { break mk(i * 10) }
  }
  (m ?? Map<string, i32>())["a"] ?? -9
}
print(h(2, true))
print(h(2, false))
print(size(mk(3)))
print(-size(null))
print(loopVal(2))
print(loopVal(9))
function strs(o: Map<string, string> | null) {
  const z = o ?? Map<string, string>()
  print(z["a"] ?? "dflt")
}
function keyed(o: Map<i32, f64> | null) {
  const d = Map<i32, f64>()
  d[1] = 2.5
  const z = o ?? d
  print(z[1] ?? -1.0)
}
const sm = Map<string, string>()
sm["a"] = "x"
strs(sm)
strs(null)
const km = Map<i32, f64>()
km[1] = 7.25
keyed(km)
keyed(null)
function take(a) {
  const v = a
  print((v ?? mk(-1))["a"] ?? -9)
}
take(
  for i in 0 until 4 {
    if i == 2 { break mk(i * 10) }
  },
)
