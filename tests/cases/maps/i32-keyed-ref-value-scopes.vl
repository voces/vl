// @run
// @log aa
// @log 1
// @log true
// @log false
// @log 1
// @log 2
// @log 2
// @log 2
// @log 1
// @log cc
// @log dd
// @log 50
// @log bb
// EVERY OPERATION x SCOPE x POSITION for an i32-keyed REF-valued map, spelled so each
// line has a `{[string]: V}` twin. The mono-value halves of this grid are pinned by
// `i32-keyed-scopes.vl`; this is the half #1282 deferred, and the point of running them
// together is that the two reps now share ONE resolution path — the shape is a slot,
// the slot carries the key, and every `cm*` accessor asks the slot.
//
// The GLOBAL cell is the one that would have been silent: a global map cell's valtype
// comes from `mapAnnShape`, which resolved the KEY before the value and answered the
// MONO i32-keyed struct for every i32-keyed annotation. With a ref value that struct is
// the wrong layout, and `vl check` cannot see it.
const g: {[i32]: string} = Map()

function readG() {
  g[1] = "aa"
  return g[1] ?? "z"
}

// PARAM: the param's valtype is this (key, value) pair's map struct.
function sizeOf(m: {[i32]: string}) { return m.length }

// RETURN: the return valtype is the same struct, resolved through the same annotation.
function mk(): {[i32]: string} {
  const m: {[i32]: string} = Map()
  m[7] = "bb"
  return m
}

// `| null`: the nullable cell is `(ref null <that struct>)` and the narrowed ops run on
// the recovered non-null ref.
function nulRoundTrip(): string {
  let m: {[i32]: string} | null = null
  m = Map()
  if m != null {
    m[3] = "cc"
    return m[3] ?? "z"
  }
  return "z"
}

// CLOSURE RESULT: `() => {[i32]: V}` — the position `collectA`'s spelling gate used to
// reject wholesale. It delegates to the RETURN spelling now, which is the same slot the
// direct return position resolves.
function viaClosure(): string {
  const f: () => {[i32]: string} = mk
  const m = f()
  m[8] = "dd"
  return m[8] ?? "z"
}

function go() {
  print(readG())  // aa
  print(g.length) // 1

  // has / delete / length on the ref-valued rep — key-side machinery, value-blind.
  const m: {[i32]: string} = Map()
  m[10] = "aa"
  m[20] = "bb"
  print(m.has(10)) // true
  const d = m.delete(10)
  print(m.has(10)) // false
  print(m.length)  // 1
  if d {
    print(2) // 2 — `d` is read, so the delete is not dead
  }

  // keys() is an i32 LIST for the i32-keyed rep even though the shape is an mv slot —
  // the classifier asks the slot's key column, not the mono sentinel. values() is the
  // slot's own vals rep (a string list here).
  m[30] = "cc"
  const ks = m.keys()
  print(ks.length) // 2
  const vs = m.values()
  print(vs.length) // 2

  print(sizeOf(mk()))   // 1 — the param cell holds `mk()`'s one entry
  print(nulRoundTrip()) // cc
  print(viaClosure())   // dd

  // a bare `for k in m` over the ref-valued rep binds an i32 key.
  let sum = 0
  for k in m { sum = sum + k }
  print(sum)          // 20 + 30
  print(m[20] ?? "z") // bb
}
go()
