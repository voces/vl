// @run
// @log a
// @log 42
// @log 2
// @log x
// D15545: an un-annotated record field holding a `Map()` whose value is a record type known
// only from a later store. The store's literal is that record's first, so the holder's row
// mints after it, as an empty-list field a later push pins does.
const v = { f: Map() }
v.f["k"] = { f: (x: i32) => if x > 0 { "a" } else { "b" } }
const t1 = v.f["k"]
if t1 != null { print(t1.f(1)) }

function inner() {
  const w = { f: Map() }
  w.f["k"] = { g: 41 }
  const r = w.f["k"]
  if r != null { return r.g + 1 }
  0
}
print(inner())

const m = Map()
const h = { f: m }
m["a"] = { n: 1 }
m["b"] = { n: 2 }
print(h.f.length)

const d = { f: { g: Map() } }
d.f.g["k"] = { s: "x" }
const s = d.f.g["k"]
if s != null { print(s.s) }
