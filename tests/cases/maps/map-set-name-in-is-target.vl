// @run
// @log 1
// @log 1
// @log 2
// `Map<K, V>` and `Set<T>` inside an `is` target name the same arm as the index signature the
// union's member was written with, whichever spelling each side uses (D2468).
const v: { seen: Map<string, i32> } | i32 = { seen: Map() }
if v is { seen: Map<string, i32> } {
  v.seen["p"] = 1
  print(v.seen.length)
}
const w: { seen: {[string]: i32} } | i32 = { seen: Map() }
if w is { seen: Map<string, i32> } {
  w.seen["q"] = 2
  print(w.seen.length)
}
const s: { seen: Set<string> } | i32 = { seen: Set() }
if s is { seen: Set<string> } {
  s.seen.add("a")
  s.seen.add("b")
  print(s.seen.length)
}
