// @run
// @log 0.5
// @log 0.5
// @log 16777216
// @log 16777216
// @log 1.5
// @log a
// @log b
// @log 1
// @log 0.5
// @log 0.5
// @log 0.5
// @log 16777216
// @log 0.5
// @log 0.5
// @log 0.5
// @log 42
// @log 1
// `m.set(k, v)` TAKES THE SAME CONTEXTUAL TYPING AS `m[k] = v` (webcraft P2 polish).
// The value argument is a store into the map's value slot, so it runs the two steps
// every other store position runs — `seedExpected`, then the expression-aware
// `assignableExpr` — instead of the bare structural `assignable` it used to run. That
// is not a second copy of the rules: it is the one function the assignment path calls,
// so the two spellings cannot drift.
//
// Every line here is a PAIR: the `m[k] = v` spelling (green on master) and the
// `m.set(k, v)` twin (a `set: expected …, got …` type error on master). The twin grid
// that produced them read 16/38 direct and 0/12 nested twin pairs agreeing on master
// and 38/38 + 12/12 after; these are the shapes, one per rule.
type K = "a" | "b"
type N = 0 | 1
type S = { v: f32 }
type W = { m: {[string]: f32} }

// A `.` literal into an f32 value — context-typed, one rounding.
const a: {[string]: f32} = Map()
a["x"] = 0.5
a.set("y", 0.5)
print(a["x"] ?? 0.0) // 0.5
print(a["y"] ?? 0.0) // 0.5

// An INTEGER literal into an f32 value — admitted only when f32 holds it exactly.
const b: {[string]: f32} = Map()
b["x"] = 16777216
b.set("y", 16777216)
print(b["x"] ?? 0.0) // 16777216
print(b["y"] ?? 0.0) // 16777216

// A doubly-signed literal is still a literal (the checker and the emitter share one peel).
const c: {[string]: f32} = Map()
c.set("y", -(-1.5))
print(c["y"] ?? 0.0) // 1.5

// A MEMBER literal into a literal-union value — narrows to the member, so the atom rep
// is what gets stored (a bare `string` would divorce the checked type from the rep).
const d: {[string]: K} = Map()
d["x"] = "a"
d.set("y", "b")
print(d["x"] ?? "a") // a
print(d["y"] ?? "a") // b

// The integer-member twin.
const e: {[string]: N} = Map()
e.set("y", 1)
print(e["y"] ?? 0) // 1

// An OBJECT literal adapts FIELD-WISE (its `f32` field takes the same literal rule),
// and an ARRAY literal ELEMENT-WISE.
const f: {[string]: S} = Map()
f.set("y", { v: 0.5 })
print((f["y"] ?? { v: 0.0 }).v) // 0.5
const g: {[string]: f32[]} = Map()
g.set("y", [0.5])
print((g["y"] ?? [])[0]) // 0.5

// Through a NULLABLE value slot and through a UNION value slot — the destination's
// wrapper is peeled by the same one home, so neither needs its own rule.
const h: {[string]: f32 | null} = Map()
h.set("y", 0.5)
print(h["y"] ?? 0.0) // 0.5
const i: {[string]: f32 | string} = Map()
i.set("y", 16777216)
const iv = i["y"]
if iv is f32 {
  print(iv) // 16777216
}

// An i32 KEY rep changes nothing about the value rule.
const j: {[i32]: f32} = Map()
j.set(7, 0.5)
print(j[7] ?? 0.0) // 0.5

// NESTED receivers: the map reached through an array element and through a struct
// field. These were 0/12 on master — the receiver expression never mattered, but the
// grid had to say so.
const k: {[string]: f32}[] = [Map()]
k[0].set("y", 0.5)
print(k[0]["y"] ?? 0.0) // 0.5
const w: W = { m: Map() }
w.m.set("y", 0.5)
print(w.m["y"] ?? 0.0) // 0.5

// `seedExpected` is the OTHER half, and it is the half `.push` already had: an
// un-annotated lambda argument infers its parameter from the map's value type.
// Without the seed this line is `cannot infer a type for parameter \`x\``.
const fn: {[string]: (i32) => i32} = Map()
fn.set("y", (x) => x + 1)
const got = fn["y"]
if got != null {
  print(got(41)) // 42
}

// The NEWTYPE literal adoption the old `nomSlotAccepts` rung supplied is SUBSUMED,
// not lost: `assignableExpr` is that helper's own body.
type EntityId = new i32
const n2: {[string]: EntityId} = Map()
n2.set("y", 1)
print(n2["y"] ?? 0) // 1
