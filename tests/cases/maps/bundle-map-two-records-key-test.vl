// A map stored bundles of two different signature sets, read only by key tests, keeps each store's
// record whole in a value slot that is the union of the records (D17106).
// @run
// @log true
// @log a
// @log b
// @hint Intentionally-unused variable `_a`
// @hint Intentionally-unused variable `_b`
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
function lap2(f) {
  const _a = f(true)
  const _b = f(3)
  return f
}
const m = Map()
m["a"] = lap((a) => a + 1)
m["b"] = lap2((a) => a)
print(m.has("b"))
for k in m.keys() { print(k) }
