// A read off a hole parameter's map field is the value or `null` at each call: a string-keyed
// miss, a `??` over two reads, a nested map's read and a lambda's read (D3397, D3399, D3411, D3413).
type AB = "a" | "b"
type H = { m: {[string]: i32} }
type N = { m: {[i32]: i32 | null} }
type Nm = { m: {[i32]: {[i32]: boolean}} }
type A = { n: {[i32]: AB} }

function mkH(): H {
  const v: {[string]: i32} = Map()
  v["a"] = 7
  { m: v }
}
function mkN(): N {
  const v: {[i32]: i32 | null} = Map()
  v[3] = 7
  { m: v }
}
function mkNm(): Nm {
  const inr: {[i32]: boolean} = Map()
  inr[1] = true
  const o: {[i32]: {[i32]: boolean}} = Map()
  o[0] = inr
  { m: o }
}
function mkA(): A {
  const n: {[i32]: AB} = Map()
  n[0] = "b"
  { n: n }
}

function skey(r) {
  const x = r.m["z"]
  print(x)
}
function coal(r) { print(r.m[9] ?? r.m[3]) }
function inner<T>(p: T) {
  const q = p.m[0]
  if q != null { print(q[1]) }
}
function viaLambda(p) {
  const g = (i: i32) => p.n[i] ?? "a"
  print(g(0))
}

skey(mkH())
coal(mkN())
inner(mkNm())
viaLambda(mkA())
// @log null
// @log 7
// @log true
// @log b
