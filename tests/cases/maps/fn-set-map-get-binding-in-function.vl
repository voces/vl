// @run
// @log 4
// @log 5
// @log 3
// @log 0
// @log 10
// @log 6
// The same bindings as `fn-set-map-get-binding.vl`, as locals of a function body (D14432).
function inc(x) { return x + 1 }
function dbl(x) { return x + x }
function run() {
  const m = Map()
  m.set("a", inc)
  m.set("b", dbl)
  const g = m.get("b")
  if (g != null) {
    print(g(2))
    print(g(2.5))
  }
  const i = m["a"]
  if (i != null) { print(i(2)) }
  const h = m.get("z")
  if (h == null) { print(0) }
  let k = m.get("b")
  if (k != null) { print(k(5)) }
  k = m.get("a")
  if (k != null) { print(k(5)) }
}
run()
