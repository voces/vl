// @run
// @log 42
// @log hi
// @log MISS
// @log 2.5
// @log -1
// @log 7
// @log -1
// @log 1.5
// @log -1
// A map read narrowed past its null by `!= null` reads the value as itself: a record inside a
// `R | null` value and its fields, and an `f64`, `i64` or `f32` slot. A missing key keeps its null
// and takes the guard's other arm.
type R = { f: i64, s: string }
function rec(m: {[string]: R | null}, k: string) {
  const v = m[k]
  if v != null {
    print(v.f)
    print(v.s)
  } else { print("MISS") }
}
function f64Of(m: {[string]: f64}) {
  if m["k"] != null { return m["k"] }
  return -1.0
}
function i64Of(m: {[string]: i64}) {
  if m["k"] != null { return m["k"] }
  return -1
}
function f32Of(m: {[string]: f32}) {
  if m["k"] != null { return m["k"] }
  return -1.0 as f32
}
function go() {
  const r: {[string]: R | null} = Map()
  r["a"] = { f: 42, s: "hi" }
  r["n"] = null
  rec(r, "a")
  rec(r, "n")
  const d: {[string]: f64} = Map()
  d["k"] = 2.5
  print(f64Of(d))
  print(f64Of(Map()))
  const i: {[string]: i64} = Map()
  i["k"] = 7
  print(i64Of(i))
  print(i64Of(Map()))
  const f: {[string]: f32} = Map()
  f["k"] = 1.5 as f32
  print(f32Of(f))
  print(f32Of(Map()))
}
go()
