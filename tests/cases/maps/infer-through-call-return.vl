// @run
// @log x
// @log 1.5
// @log 5000000000
// @log one
// @log 3
// @log seed
// @log carried
// @log true
// @log true
// USAGE-DRIVEN INFERENCE ACROSS A FUNCTION BOUNDARY. `infer-from-set.vl` and
// `infer-from-index-write.vl` pin the map whose holes a downstream write closes; here the
// binding and the `Map()` that fills it are in DIFFERENT functions, so the inferred type
// has to survive a return.
//
// Three seams, one cause each way it broke. The callee's functype RESULT valtype, the
// `return Map()` CONSTRUCTOR, and the caller's receiver SHAPE are three readings of one
// question, and every rung that answered it read a SPELLING — a param annotation, a `let`
// annotation, a callee's return annotation. An inferred map has none, so the un-annotated
// factory fell to the mono i32 map at each: the caller reported "map values must be i32 /
// boolean" when the two agreed, and emitted INVALID WASM with `vl check` rc 0 when they
// did not.
//
// THE FILE MUST STAY ANNOTATION-FREE AT EVERY MAP (`infer-value-kinds.vl` states the rule):
// an annotated `{[K]: V}` anywhere in the module mints that (KEY, VALUE) slot and the
// inferred binding then FINDS it, which is exactly how the gap survived a corpus of
// annotated maps. Each factory below is its own function for the same reason — two call
// sites of one factory would unify into a single value type and stop testing separate reps.

type Pt = { x: i32 }

function mkStr() {
  return Map()
}
function mkF64Inner() {
  return Map()
}
// TWO call hops: the shape has to travel through a factory that returns another
// factory's result, not just through one `return Map()`.
function mkF64() {
  return mkF64Inner()
}
function mkI32Key() {
  return Map()
}
function mkStruct() {
  return Map()
}
// The value pinned INSIDE the callee and the map returned as a LOCAL — the reading that
// left `fRetKind` at its `"i32"` default over a body returning a map ref.
function mkSeeded() {
  const t = Map()
  t["k"] = "seed"
  return t
}
// The same, read at the call site with no further write: nothing downstream can repair a
// result type the callee already declared wrong.
function mkCarried() {
  const t = Map()
  t.set("k", "carried")
  return t
}
function mkSetStr() {
  return Set()
}
function mkSetI32() {
  return Set()
}

// An ARROW-const factory, which reaches the boundary by a different definition form.
const mkI64 = () => Map()

// kind 3 — the string vals list, pinned only at the CALL SITE.
const ms = mkStr()
ms.set("a", "x")
print(ms["a"] ?? "none") // x

// kind 11 — an f64 value across two hops.
const mf = mkF64()
mf["a"] = 1.5
print(mf["a"] ?? 0.0) // 1.5

// kind 10 — an i64 value out of the arrow factory.
const mi = mkI64()
mi.set("a", 5000000000)
print(mi["a"] ?? 0) // 5000000000

// The i32 KEY half: `{[i32]: string}` is a different slot from `{[string]: string}` above,
// and the key is the half a bare `Map()` carries no spelling for at all.
const mik = mkI32Key()
mik[1] = "one"
print(mik[1] ?? "none") // one

// kind 1 — a struct value over a ref vals list.
const mp = mkStruct()
mp.set("a", { x: 3 })
print((mp["a"] ?? { x: 0 }).x) // 3

// A returned map LOCAL, its value pinned inside the callee.
const md = mkSeeded()
md["j"] = "other"
print(md["k"] ?? "none") // seed

const mc = mkCarried()
print(mc["k"] ?? "none") // carried

// A Set is a boolean-valued map: mono on either key rep, but WHICH mono is still the key's
// to say, and the `-1` / `-4` pair is two different structs.
const ss = mkSetStr()
ss.add("a")
print(ss.has("a")) // true

const si = mkSetI32()
si.add(1)
print(si.has(1)) // true
