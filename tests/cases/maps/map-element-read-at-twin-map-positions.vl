// @run
// @log 3
// @log 3
// @log 3
// A list element that is a map of an un-annotated function, read at another rep of that map (its
// value pinned at the signature an annotated list holds a sibling map at): bound, called off the
// read, and read in a function.
function half(a) { return a / 2.0 }
const m1 = Map()
m1.set("a", half)
const m2 = Map()
m2.set("a", half)
const ws: ({ [string]: (a: f64) => f64 })[] = [m1]
const g = ws[0].get("a")
const xs = [m2]
const e = xs[0]
const h = e.get("a")
if g != null && h != null { print(g(3) + h(3)) }
const k = xs[0].get("a")
if g != null && k != null { print(g(3) + k(3)) }
function viaFn() {
  const f = xs[0].get("a")
  return if g != null && f != null { g(3) + f(3) } else { 0.0 }
}
print(viaFn())
