// @run
// @log 4
// @log 199
// @log false
// REGRESSION (D2280, plumb PL-031, the reporter's witness at 200 keys): a map holding at most 4
// entries hung at its 17th distinct key, because resizing looked at the live count while every
// deleted entry's index slot stayed a probe marker. The index now resizes on the entry count.
const m: {[i32]: i32} = Map()
for k in 0 until 200 {
  m[k] = k
  if k >= 4 { m.delete(k - 4) }
}
print(m.length)
print(m[199] ?? -1)
print(m.has(16))
