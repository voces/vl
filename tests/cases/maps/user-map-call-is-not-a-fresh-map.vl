// @run
// @log 7
// @log true
// @log 2
// @hint redundant type annotation: `m` is inferred as `{[string]: R}`
// D14226 — only a call the checker resolves to the ambient `Map` builds a fresh map at its
// destination. A binding named `Map` (Q11 permits one) is an ordinary call: its result keeps
// its own type and identity, so a write through `m` is seen through `base`.
type R = { f: i32 }
const base: {[string]: R} = Map()
base.set("a", { f: 7 })
function pick(): {[string]: R} {
  const Map = () => base
  const m: {[string]: R} = Map()
  m.set("b", { f: 9 })
  m
}
const got = pick()
const a = got.get("a")
if a != null { print(a.f) }
print(base.has("b"))
print(base.length)
