// @run
// @log 42
// @log 13
// @log -1
// @log 2
// @log true
// @log vee
// @log 1
// @log three
// @log 1
// @log null-ok
// CONSTRUCTING a `Map()` into the NULLABLE-map field of an inline-object UNION ARM. Every
// shape below was check-clean invalid wasm or a loud emit failure one release ago
// (`xfail-miscompile-union-arm-constructed-map-field.vl`).
//
// ONE MISSING LADDER ARM. `emitObj` (the plain struct-literal path) seeds a nullable-map
// field's construct context from `sFieldMapShape` under `scode == 29`; the VARIANT-literal
// twin `emitVariantObj` had the `vcode == 19` (non-null map) arm and NO `vcode == 29` one,
// while BOTH read-back sites already paired `19 || 29` off the same `uFieldMapShape` — the
// type section's variant loop (`emit_sections`) and the narrowed-field resolver
// (`emit_classify`). Only the CONSTRUCT seed was short, so the `Map()` reached `emitMapNew`
// on the ambient `pendingMapSlot` (-1, the MONO string-keyed struct) and `struct.new`'d that
// row into a field declaring a different one: `expected (ref null $type), found (ref $type)`.
//
// THE i32 KEY WAS NEVER THE TRIGGER, and the xfail's own three controls said otherwise — they
// were read one conjunct too narrow. -1 is the mono STRING-keyed shape, so a seed-less
// `Map()` is accidentally right for exactly one field type, `{[string]: i32} | null`, and
// wrong for every other. `Str` below (string key, string VALUE — a `>= 0` mv slot) miscompiled
// identically with no i32 anywhere, which is why it is pinned here rather than trusted to the
// i32 cases.
//
// THE BARE `null` IS THE SAME ARM'S SECOND HALF. Without the `pendingNulRefHeap` seed that
// arm also carries, `{ g: null }` had no heap type to null and failed LOUDER — `emitProgram:
// bare null needs a struct-typed context` — on a program the checker accepts. `Nul` pins it.
//
// The maps are EXERCISED, not merely constructed: a module that validates while building the
// wrong map row is the failure this file exists to catch, and only a read-back distinguishes
// the right row from a same-shaped wrong one.
type Box = { g: {[i32]: i32} | null } | f64
type Str = { g: {[string]: string} | null } | f64
type I32S = { g: {[i32]: string} | null } | f64
type Nul = { g: {[i32]: i32} | null } | f64

const b: Box = { g: Map() }
if b is f64 {
  print(0)
} else {
  const m = b.g
  if m != null {
    m[7] = 42
    m[9] = 13
    print(m[7] ?? -1)
    print(m[9] ?? -1)
    print(m[8] ?? -1)
    print(m.size)
    print(m.has(7))
  }
}

const s: Str = { g: Map() }
if s is f64 {
  print(0)
} else {
  const m = s.g
  if m != null {
    m["k"] = "vee"
    print(m["k"] ?? "MISS")
    print(m.size)
  }
}

const i: I32S = { g: Map() }
if i is f64 {
  print(0)
} else {
  const m = i.g
  if m != null {
    m[3] = "three"
    print(m[3] ?? "MISS")
    print(m.size)
  }
}

const n: Nul = { g: null }
if n is f64 {
  print("f64")
} else {
  if n.g == null { print("null-ok") } else { print("null-bad") }
}
