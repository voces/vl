// @run
// @log a
// @log a
// @log a
// @log 8
// @log 2
// @log 2
// @log a
// A map whose value is OBJECT-shaped, read at the guarded place. D1734 gave the place its
// `!= null` narrowing and gated this shape out, because lifting the gate produced check-clean
// invalid wasm — the read was right and the CLASSIFIER was not (D1735).
//
// The string field is the load-bearing row: `memberFieldCode` answered -1 for any narrowed
// receiver whose narrow named no variant, so `print` picked the i32 printer for a string.
// Both faces, an arm value and a plain struct, and the string-VALUED map's own `.length`.
type Hit = { msg: string }
type Miss = { why: string }
type R = Hit | Miss
type A = { n: i32 }
function mkA(): Hit { return { msg: "a" } }
const ma: { [string]: Hit } = Map()
ma["k"] = mkA()
if ma["k"] != null { print(ma["k"].msg) } else { print("null") }
const mu = Map()
mu["k"] = mkA()
if mu["k"] != null { print(mu["k"].msg) } else { print("null") }
const mn: { [string]: Hit | null } = Map()
mn["k"] = mkA()
if mn["k"] != null { print(mn["k"].msg) } else { print("null") }
const mi: { [string]: A } = Map()
mi["k"] = { n: 8 }
if mi["k"] != null { print(mi["k"].n) } else { print(0) }
const ms: { [string]: string } = Map()
ms["k"] = "ab"
if ms["k"] != null { print(ms["k"].length) } else { print(0) }
if ms["k"] is string { print(ms["k"].length) } else { print(0) }
const mv: { [string]: Hit } = Map()
mv["k"] = mkA()
const v = mv["k"]
if v != null { print(v.msg) } else { print("null") }
