// @run
// @log true
// @log 7
// @log true
// @log true
// @log true
// D16709: a parameter narrowed off one map of a two-map union is read as that map's struct at
// a method receiver, un-annotated, generic or annotated, early return or `else` alike.
function mka(): {[i32]: i32} {
  const m: {[i32]: i32} = Map()
  m.set(1, 7)
  return m
}
function mkb(): {[i32]: boolean} {
  const m: {[i32]: boolean} = Map()
  m.set(1, true)
  return m
}
function pick(n: i32): {[i32]: i32} | {[i32]: boolean} {
  if n > 0 { return mkb() }
  return mka()
}
function guard(v) {
  if v is {[i32]: i32} { return }
  print(v.get(1) ?? false)
}
function either(v) {
  if v is {[i32]: i32} { print(v.get(1) ?? 0) } else { print(v.has(1)) }
}
function guardGen<T>(v: T) {
  if v is {[i32]: i32} { return }
  print(v.get(1))
}
function guardAnn(v: {[i32]: i32} | {[i32]: boolean}) {
  if v is {[i32]: i32} { return }
  print(v.get(1) ?? false)
}
guard(pick(1))
either(pick(0))
either(pick(1))
guardGen(pick(1))
guardAnn(pick(1))
