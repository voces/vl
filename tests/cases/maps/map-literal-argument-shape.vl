// @run
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// @log 1
// D1223 — a bare `Map()` LITERAL at the ARGUMENT boundary builds the PARAMETER's map
// struct, at every value type and through a nested call.
//
// A `Map()` self-identifies nothing: it builds whatever `pendingMapSlot` names. Every
// sibling delivery seeds that from its destination — the binding from its annotation, the
// global assign from the cell, the return from the result annotation — and the argument
// position had no seed, so the constructor read the ambient `-1` (the MONO i32 map) while
// the parameter slot is the value-typed map struct: `vl check` rc 0, invalid wasm for
// EVERY non-mono value type. `{[string]: i32}` escaped it because the mono shape IS its
// shape, which is why no fixture caught this.
//
// EACH CELL WRITES THROUGH THE PARAMETER AND READS THE SIZE BACK, so a map built at the
// wrong shape cannot pass by being constructed. The seed is the parameter's alone — the
// ambient is cleared per argument — so `outer(take(Map()))` builds `take`'s shape, not the
// enclosing position's.

type S = { a: i32 }

function mkin(): {[string]: i32} {
  const q: {[string]: i32} = Map()
  q["j"] = 1
  q
}

function takeI(m: {[string]: i32}) { m["k"] = 1
  m.size }
function takeS(m: {[string]: string}) { m["k"] = "v"
  m.size }
function takeD(m: {[string]: f64}) { m["k"] = 1.5
  m.size }
function takeL(m: {[string]: i64}) { m["k"] = 1
  m.size }
function takeF(m: {[string]: f32}) { m["k"] = 1.5
  m.size }
function takeB(m: {[string]: boolean}) { m["k"] = true
  m.size }
function takeR(m: {[string]: S}) { m["k"] = {a: 1}
  m.size }
function takeA(m: {[string]: i32[]}) { m["k"] = [1]
  m.size }
function takeN(m: {[string]: {[string]: i32}}) { m["k"] = mkin()
  m.size }

print(takeI(Map()))
print(takeS(Map()))
print(takeD(Map()))
print(takeL(Map()))
print(takeF(Map()))
print(takeB(Map()))
print(takeR(Map()))
print(takeA(Map()))
print(takeN(Map()))

// The NESTED argument: the inner call's parameter decides, not the outer one's.
function idn(n: i32) { n }
print(idn(takeS(Map())))
