// @run
// @log 0
// @log ay1
// @log true
// @log 43
// @log ba
// @log b
// D3123 (plumb PL-075): an inferred record whose field is a map fed by a binding, a parameter
// or a read has a row, and a literal-union-valued map field keys the atom-valued map slot.
import { toString } from "std:fmt"

function pair() { const r: {[i32]: i32} = Map(); { regs: r } }
const p = pair()
print(toString(p.regs.length))

function words(k: string, x: string) {
  const m: {[string]: string} = Map()
  m[k] = x
  { n: m.length, words: m }
}
const w = words("a", "ay")
print((w.words["a"] ?? "miss") + toString(w.n))

function seen(s: Set<i32>) { { seen: s } }
const s: Set<i32> = Set()
s.add(7)
print(seen(s).seen.has(7))

function nested(m: {[i32]: {[i32]: i32}}) { { outer: { regs: m }, tag: "t" } }
const inner: {[i32]: i32} = Map()
inner[4] = 43
const nm: {[i32]: {[i32]: i32}} = Map()
nm[1] = inner
const nv = nested(nm).outer.regs[1]
if nv != null { print(nv[4] ?? -1) } else { print(-2) }

type AB = "a" | "b"
function mkL(k: i32, x: AB): {[i32]: AB} {
  const m: {[i32]: AB} = Map()
  m[k] = x
  m
}
function lit(k: i32) {
  const b = mkL(k + 1, "a")
  { direct: mkL(k, "b"), bound: b }
}
const l = lit(3)
print((l.direct[3] ?? "a") + (l.bound[4] ?? "b"))

function mkN(k: i32): {[i32]: AB} | null {
  if k < 0 { return null }
  mkL(k, "b")
}
function nul(k: i32) { { regs: mkN(k) } }
const nr = nul(2).regs
if nr != null { print(nr[2] ?? "a") } else { print("none") }
