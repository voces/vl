// @run
// @log 1
// @log none
// @log true
// @log 1
// @log none
// @log miss
// @log miss
// A single map beside `null` is a nullable niche, not a box: `is` and `match` over it are the null
// test and consult no map tag, at every key rep and in a module where two same-rep maps have one
// each (#3193 review). A generic `is M` whose pin's union lacks `M` answers false (D2493).
function f(u: {[i64]: i32} | null) {
  if u is {[i64]: i32} { print(u.length) } else { print("none") }
}
const m: {[i64]: i32} = Map()
m.set(5, 1)
f(m)
f(null)
const s: Set<i64> = Set()
s.add(4)
const n: Set<i64> | null = s
print(n is Set<i64>)
function g(u: {[i32]: 1 | 2} | null) {
  match u {
    {[i32]: 1 | 2} => print(u.length)
    null => print("none")
  }
}
const l: {[i32]: 1 | 2} = Map()
l.set(3, 2)
g(l)
g(null)
function tw(x: {[i32]: i32} | {[i32]: boolean}): boolean { x is {[i32]: i32} }
function k<T>(u: T) { if u is {[string]: boolean} { print("hit") } else { print("miss") } }
const mi: {[string]: i32} = Map()
const v: {[string]: i32} | string = mi
k(v)
const tb: {[i32]: boolean} = Map()
if tw(tb) { print("wrong") } else { print("miss") }
