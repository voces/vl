// @run
// @log 4 true false 196=392 197=394 198=396 199=398
// @log 4 true false k196=v196 k197=v197 k198=v198 k199=v199
// @log 4 395
// @log 4 10000000000
// @log 4 p196 p197 p198 p199
// @log 4 true n196 n197 n198 n199
// @log 4 true false
// @log 4 200
// @log 4 0=196 1=197 2=198 3=199
// @log 4 4 true false
// REGRESSION (D2280, plumb PL-031): a map that never holds more than 4 entries, churned through
// 200 distinct keys. A deleted entry's index slot stays a probe marker, so resizing on the LIVE
// count let the 16-slot index fill with markers and the 17th key's probe spun forever. Every key
// rep and a spread of value reps share that machinery, so each gets its own window here, read
// back through `.length`, `has`, a lookup and `for` iteration after the churn.
type P = { x: i32, y: string }
type Shape = { kind: "c", r: f64 } | { kind: "s", side: i32 }

function ci32() {
  const m: {[i32]: i32} = Map()
  for k in 0 until 200 {
    m[k] = k * 2
    if k >= 4 { m.delete(k - 4) }
  }
  let s = ""
  for k in m { s = s + " \{k}=\{m[k] ?? -1}" }
  "\{m.length} \{m.has(199)} \{m.has(195)}\{s}"
}

function cstr() {
  const m: {[string]: string} = Map()
  for k in 0 until 200 {
    m["k\{k}"] = "v\{k}"
    if k >= 4 { m.delete("k\{k - 4}") }
  }
  let s = ""
  for k in m.keys() { s = s + " \{k}=\{m[k] ?? "?"}" }
  "\{m.length} \{m.has("k199")} \{m.has("k10")}\{s}"
}

function cf64() {
  const m: {[i32]: f64} = Map()
  for k in 0 until 200 {
    m[k] = k / 2.0
    if k >= 4 { m.delete(k - 4) }
  }
  let t = 0.0
  for v in m.values() { t = t + v }
  "\{m.length} \{t}"
}

function ci64() {
  const m: {[string]: i64} = Map()
  for k in 0 until 200 {
    m["\{k}"] = 10000000000 as i64
    if k >= 4 { m.delete("\{k - 4}") }
  }
  "\{m.length} \{m["199"] ?? (0 as i64)}"
}

function cstruct() {
  const m: {[i32]: P} = Map()
  for k in 0 until 200 {
    m[k] = { x: k, y: "p\{k}" }
    if k >= 4 { m.delete(k - 4) }
  }
  let s = ""
  for k in m { s = s + " \{m[k]?.y ?? "?"}" }
  "\{m.length}\{s}"
}

function cnullable() {
  const m: {[string]: i32 | null} = Map()
  for k in 0 until 200 {
    if k % 2 == 0 { m["n\{k}"] = null } else { m["n\{k}"] = k }
    if k >= 4 { m.delete("n\{k - 4}") }
  }
  let s = ""
  for k in m.keys() { s = s + " \{k}" }
  "\{m.length} \{m.has("n198")}\{s}"
}

function cunion() {
  const m: {[i32]: Shape} = Map()
  for k in 0 until 200 {
    if k % 2 == 0 {
      m[k] = { kind: "c", r: 1.5 }
    } else {
      m[k] = { kind: "s", side: k }
    }
    if k >= 4 { m.delete(k - 4) }
  }
  "\{m.length} \{m.has(196)} \{m.has(195)}"
}

function clist() {
  const m: {[string]: i32[]} = Map()
  for k in 0 until 200 {
    m["l\{k}"] = [k, k + 1]
    if k >= 4 { m.delete("l\{k - 4}") }
  }
  "\{m.length} \{(m["l199"] ?? [])[1]}"
}

// Delete then re-insert the same key: it takes the new value and moves to the end of the order.
function creinsert() {
  const m: {[i32]: i32} = Map()
  for k in 0 until 4 { m[k] = k }
  for r in 0 until 200 {
    m.delete(r % 4)
    m[r % 4] = r
  }
  let s = ""
  for k in m { s = s + " \{k}=\{m[k] ?? -1}" }
  "\{m.length}\{s}"
}

function cset() {
  const a: {[i32]: boolean} = Set()
  const b: {[string]: boolean} = Set()
  for k in 0 until 200 {
    a.add(k)
    b.add("s\{k}")
    if k >= 4 {
      a.delete(k - 4)
      b.delete("s\{k - 4}")
    }
  }
  "\{a.length} \{b.length} \{a.has(197)} \{b.has("s3")}"
}

print(ci32())
print(cstr())
print(cf64())
print(ci64())
print(cstruct())
print(cnullable())
print(cunion())
print(clist())
print(creinsert())
print(cset())
