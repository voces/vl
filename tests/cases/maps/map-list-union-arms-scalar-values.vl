// @run
// @log 0
// @log 1.5
// @log 1
// @log 0
// A union of map-list arms whose map values are numbers of different widths: each arm's map
// struct names its keys and vals wrappers in the type section's one rec group.
const a: {[string]: i32}[] | {[string]: f64}[] = []
print(a.length)
const m: {[string]: f64} = Map()
m["a"] = 1.5
const u: {[string]: i32}[] | {[string]: f64}[] = [m]
if u is {[string]: f64}[] { print(u[0]["a"] ?? 0.0) }
print(u.length)
const w: {[i32]: i32}[] | {[i32]: f64}[] | {[i32]: i64}[] = []
print(w.length)
