// @run
// @log 7
// @log 6
// @log 5
// @log 8
// @log 4
// @log 8
// @hint redundant type annotation: `kd` is inferred as `{[string]: i32}`
// The D2662 cycle through a generic call and an index expression, an index-initialized
// arm cell, and a mono-map cycle: a re-entered arm join answers from the checked return,
// and two cells agree on their columns or on one map shape.

type S = { a: i32 }

function mkR(v: i32): {[string]: S} {
  const m: {[string]: S} = Map()
  m["a"] = { a: v }
  return m
}

function mkI(v: i32): {[string]: i32} {
  const m: {[string]: i32} = Map()
  m["k"] = v
  return m
}

function id<T>(x: T) { return x }

let gd = mkR(0)
let gc = id(fc(false))

function fc(c: boolean) {
  if c { gc = mkR(8) } else { gd = mkR(7) }
}

let hd = mkR(0)
let hc = [fe(false)][0]

function fe(c: boolean) {
  if c { hc = mkR(8) } else { hd = mkR(6) }
}

let jd = mkR(1)
let jc = [mkR(1)][0]

function fj(c: boolean) {
  if c { jc = mkR(8) } else { jd = mkR(5) }
}

let kd: {[string]: i32} = mkI(1)
let kc = fk(false)

function fk(c: boolean) {
  if c { kc = mkI(8) } else { kd = mkI(4) }
}

const v = gc["a"]
if v != null { print(v.a) }
const w = hc["a"]
if w != null { print(w.a) }
const x = fj(false)["a"]
if x != null { print(x.a) }
const y = fj(true)["a"]
if y != null { print(y.a) }
print(kc["k"] ?? -1)
print(fk(true)["k"] ?? -1)
