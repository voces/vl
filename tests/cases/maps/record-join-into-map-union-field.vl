// @run
// @log true
// @log 1
// @log false
// @log s
// @log true
// @log 1
// @log true
// @log 1
// @log true
// @log 1
// @log true
// @log 1
// A record literal in an `if` arm builds the destination record, whose field holds a union of
// maps, and a twin map delivered into it is retagged as it is outside the `if`: at a binding,
// an assignment to a local, a parameter and a global, and a `match` arm (D2730).
type A = {[string]: string}
type B = {[string]: string | null}
function mkA(): A { const m: A = Map(); m["k"] = "x"; m }
function uA(): A | B { mkA() }
type Sx = { f: B | string }
function sh(w: B | string) {
  print(w is B)
  match w {
    string => print("s")
    B => print(w.length)
  }
}
let gx: Sx = { f: "g" }
function bind(sel: i32) {
  const sx: Sx = if sel == 0 { { f: uA() } } else { { f: "s" } }
  sh(sx.f)
}
function assign(sel: i32, p: Sx) {
  let sx: Sx = { f: "z" }
  sx = if sel == 0 { { f: uA() } } else { { f: "s" } }
  sh(sx.f)
  p = if sel == 0 { { f: uA() } } else { { f: "s" } }
  sh(p.f)
  gx = if sel == 0 { { f: uA() } } else { { f: "s" } }
  sh(gx.f)
}
function arm(sel: i32) {
  const sx: Sx = match sel {
    0 => ({ f: uA() })
    _ => ({ f: "s" })
  }
  sh(sx.f)
}
bind(0)
bind(1)
assign(0, { f: "q" })
arm(0)
