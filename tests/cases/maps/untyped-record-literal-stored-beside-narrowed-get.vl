// @run
// @log 0
// @log 4.5
// @log 7.5
// @log 4.5
// @log 0
// @info `brains` is never reassigned
// An untyped record literal stored into a `Map<i32, B>` as an `if` arm's value makes the
// function's inferred return `B | f64`, so `B` is a union arm; a `B | null` read narrowed in
// another function then returns, passes and joins as that arm, not as a plain record (D3593).
type B = { x: f64, lean: f64 }
let brains: Map<i32, B> = Map()
function brainOf(id: i32): B {
  const got = brains.get(id)
  if got != null { return got }
  const b: B = { x: 0.0, lean: 0.0 }
  brains[id] = b
  b
}
export function home(id: i32, x: f64) {
  const b = brains.get(id)
  if b == null { brains[id] = { x, lean: 0.0 } } else { b.x = x }
}
export function g(id: i32): f64 { brainOf(id).x }
function lean(b: B) { b.x + b.lean }
function pick(id: i32, c: boolean) {
  const got = brains.get(id)
  if got != null {
    const t: B = if c { got } else { { x: 0.0, lean: 0.0 } }
    return lean(t)
  }
  -1.0
}
print(g(1))
home(2, 4.5)
print(g(2))
home(2, 7.5)
print(g(2))
home(3, 4.5)
print(pick(3, true))
print(pick(3, false))
