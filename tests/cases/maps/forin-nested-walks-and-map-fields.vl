// @log 780
// @log 780
// @log 40
// @log 780
// @log 40
// @log k39
// @log 40
// @log 20
// @log 780
// Walks that share a map shape with the maps their bodies write: nested walks over two maps
// and over one map twice, maps held in struct fields, a walk inside a function, struct- and
// string-valued maps, and a map op inside another map op's key or value. Each walk keeps its
// own map across its body, so every count and sum is the one the entries hold (D2313).
import { toString } from "std:fmt"

const m: {[string]: i32} = Map()
for i in 0 until 40 { m["k" + toString(i)] = i }

// L1 — nested walks over two maps of one shape, the inner body writing a third.
const m2: {[string]: i32} = Map()
for i in 0 until 40 { m2["j" + toString(i)] = i }
const d1: {[string]: boolean} = Map()
for k, v in m {
  for k2, v2 in m2 { d1[k + k2] = true }
}
print(d1.length)

// L2 — the same map walked by both loops.
let n2 = 0
const d2: {[string]: boolean} = Map()
for k, v in m {
  for k2, v2 in m {
    if v == 0 { d2[k2] = true }
    n2 = n2 + 1
  }
}
print(n2)
print(d2.length)

// L3 — both maps are fields of one struct.
type Holder = { a: {[string]: i32}, b: {[string]: i32} }
const h: Holder = { a: Map(), b: Map() }
for i in 0 until 40 { h.a["k" + toString(i)] = i }
for r in 0 until 3 {
  for k, v in h.a { h.b[k] = v }
}
let s3 = 0
for k, v in h.b { s3 = s3 + v }
print(h.b.length)
print(s3)

// L4 — the walk inside a function, over its parameters.
function copyInto(src: {[string]: i32}, dst: {[string]: i32}) {
  let s = 0
  for k, v in src { dst[k] = v; s = s + v }
  s
}
const d4: {[string]: i32} = Map()
let s4 = 0
for r in 0 until 3 { s4 = copyInto(m, d4) }
print(s4)
print(d4.length)

// L5 — struct-valued and string-valued maps.
type P = { x: i32 }
const ps: {[string]: P} = Map()
for i in 0 until 40 { ps["k" + toString(i)] = { x: i } }
const d5: {[string]: P} = Map()
for r in 0 until 3 {
  for k, v in ps {
    if !d5.has(k) { d5[k] = { x: v.x } }
  }
}
let s5 = 0
for k, v in d5 { s5 = s5 + v.x }
print(s5)
const ss: {[string]: string} = Map()
for i in 0 until 40 { ss["k" + toString(i)] = "k" + toString(i) }
const d6: {[string]: string} = Map()
for r in 0 until 3 {
  for k, v in ss { d6[v] = k }
}
print(d6.length)
print(d6["k39"] ?? "none")

// L6 — a map op inside the value, and inside the key, of another map op.
const e: {[string]: i32} = Map()
for i in 0 until 20 { e["k" + toString(i * 2)] = 1 }
const d7: {[string]: boolean} = Map()
for k in m { d7[k] = e.has(k) }
let n7 = 0
for k, v in d7 {
  if v { n7 = n7 + 1 }
}
print(d7.length)
print(n7)
const names: {[string]: string} = Map()
for k in m { names[k] = "x" + k }
const d8: {[string]: i32} = Map()
for k, v in m { d8[names[k] ?? "?"] = m[k] ?? -1 }
let s8 = 0
for k, v in d8 { s8 = s8 + v }
print(s8)
