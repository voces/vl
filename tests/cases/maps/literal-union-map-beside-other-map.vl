// @run
// @log true
// @log false
// @log false
// @log true
// @log true
// @log false
// A numeric literal-union map shares its base's box member (D2493), so beside a map of another
// representation, or a boolean map, `is` still tells the two apart.
const m: {[string]: 1 | 2} = Map()
m["k"] = 2
const u: {[string]: 1 | 2} | {[string]: string} = m
print(u is {[string]: 1 | 2})
print(u is {[string]: string})
const s: {[string]: string} = Map()
const w: {[string]: 1 | 2} | {[string]: string} = s
print(w is {[string]: 1 | 2})
print(w is {[string]: string})
const n: {[i32]: 3 | 4} = Map()
const x: {[i32]: 3 | 4} | {[i32]: boolean} = n
print(x is {[i32]: 3 | 4})
print(x is {[i32]: boolean})
