// @error cannot write through an index of {[string]: string} | {[string]: i32}
// A union of maps reads member by member, but a store through its index still refuses: the
// value would have to fit every member's value slot (D10140).

const s: {[string]: string} = Map()
s["k"] = "x"
const us: {[string]: string} | {[string]: i32} = s
us["k"] = "y"
print(us.length)
