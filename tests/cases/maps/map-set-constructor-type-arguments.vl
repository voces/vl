// @run
// @log 2
// @log a
// @log b
// @log true
// @log 0
// @log 1
// @log 3
// `Map<K, V>()` and `Set<T>()` construct the collection at the type their arguments name,
// so an empty one needs no annotation and no pinning use (A15). A set keeps the set
// surface (`.add`, `.values()` yielding its elements) exactly as a bare `Set()` does.
const s = Set<string>()
s.add("a")
s.add("a")
s.add("b")
print(s.length)
for v in s.values() { print(v) }
const flags = Map<i32, boolean>()
flags[1] = true
print(flags[1] ?? false)
const empty = Map<string, i32[]>()
print(empty.length)
const outer = Map<string, Map<string, i32>>()
outer["a"] = Map<string, i32>()
print(outer.length)
const ids = Set<i32>()
ids.add(4)
ids.add(5)
ids.add(6)
print(ids.length)
