// @run
// @log 7
// @log 2
// The recursive value reached through the record's own map field (`Tree.kids`), handed whole to an
// anonymous record's map field.
type Tree = { kids: {[string]: Tree}, v: i32 }
const t: Tree = { kids: Map(), v: 1 }
t.kids["x"] = { kids: Map(), v: 7 }
const o = { m: t.kids, w: 2 }
const c = o.m["x"]
if c != null { print(c.v) }
print(o.w)
