// @run
// @log 2
// @log 100
// @log 3
// @log 7
// @log 0
// @log 5
// A map read `(…)[k] ?? d` whose receiver is computed: a `??` over a nullable map, an `if` whose
// arm holds a block, a valued `if`, in a function, bound and at the top.
function mk(k: i32): Map<string, i32> {
  const m: Map<string, i32> = Map()
  m["a"] = k
  return m
}
function coal(o: Map<string, i32> | null) { return (o ?? mk(2))["a"] ?? 0 }
function block(n: i32) {
  return (if n > 1 {
    const o = if n == 2 { mk(100) } else { null }
    o ?? mk(102)
  } else {
    mk(0)
  })["a"]
    ?? 0
}
function valued(n: i32) { return (if n > 1 { mk(n) } else { mk(2) })["a"] ?? 0 }
print(coal(null))
print(block(2))
print(valued(3))
const bound = (if coal(mk(7)) == 7 { mk(7) } else { mk(0) })["a"] ?? 0
print(bound)
const o: Map<string, i32> | null = null
print((o ?? Map<string, i32>())["a"] ?? 0)
print((if bound > 1 { mk(5) } else { mk(6) })["a"] ?? 0)
