// @run
// @log bool map
// @log int map
// @log 1
// D2493: two maps whose keys hash alike and whose values each rep as one i32 cell share one map
// struct; the box tags each by its member type, so `is {[string]: i32}` answers for that map alone.
function f(u: {[string]: i32} | {[string]: boolean}) {
  if u is {[string]: i32} {
    print("int map")
    print(u.length)
  } else {
    print("bool map")
  }
}
const n: {[string]: boolean} = Map()
n.set("b", true)
f(n)
const i: {[string]: i32} = Map()
i.set("b", 7)
f(i)
