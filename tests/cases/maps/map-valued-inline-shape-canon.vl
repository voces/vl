// @run
// @log a
// @log 9
// @log 3
// @log 1
// @log 2
// The WIDE brace-endpoint span (`nameIsBraceSpanEnds`) seen from the side that needs its
// WIDTH. D-BRACEDOWN moved that predicate from `emit_base.vl` down into `typecheck.vl` and
// routed the checker's three hand-written copies to it — `nameToTyReal`'s inline-object arm,
// `canonEmitName`'s shape arm and `isObjShapeName`. All three want the WIDE reading, which
// accepts a name that opens `{` and ends `}` WITHOUT also demanding that its second character
// not be `[`, so a MAP name passes as well as a shape.
//
// Tightening `canonEmitName`'s arm to the shape OPENER (`nameIsShapeOpen`) is the mistake
// this file catches, and it needs a map VALUE that actually canonicalizes to see it: with an
// `i32` value the canon pass is a no-op and every reading agrees. A literal-union alias does
// not — it canon-names its base scalar — so skipping the map arm leaves the annotation
// spelling the ALIAS where the rest of the compiler expects the canon name.
type Lit = "a" | "b"
const m: {[string]: Lit} = Map()
m["k"] = "a"
print(m["k"] ?? "b")

// The same width one level in: the map is a FIELD of an inline shape, and its value is a
// transparent one-member alias. The shape's own canon recurses into the field, so the arm has
// to accept `{[string]:Id}` on the way down.
type Id = i32
const s: { m: {[string]: Id}, t: i32 } = { m: Map(), t: 3 }
s.m["z"] = 9
print(s.m["z"] ?? 0)
print(s.t)

// A shape carrying a map as a RETURN annotation — the canon pass rewrites the rendered name
// rather than the written one, a channel plain `vl check` does not exercise.
function shape(): { m: {[string]: Id}, t: i32 } {
  const r: { m: {[string]: Id}, t: i32 } = { m: Map(), t: 2 }
  r.m["q"] = 1
  r
}
const sh = shape()
print(sh.m["q"] ?? 0)
print(sh.t)
