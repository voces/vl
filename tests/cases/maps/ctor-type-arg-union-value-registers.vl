// @run
// @log true
// @log 5
// @log s
// @log 7
// @log 2
// @log 3
// @log 6
// @log 9
// @log 4
// D8260: a map whose value union is spelled only as `Map<K, V>()`'s type argument registers
// that union, so a record stored into it boxes and `is` reads it back. Each position spells its
// own union, so no other spelling registers it: a binding, a nullable field read by `??`, a
// record field, a list element, a reassigned let, a function result, and the annotated binding.

type J = { r: i32 }
type N = { n: i32 | null }
type F = { f: i32 }
type L = { l: i32 }
type R = { g: i32 }
type K = { k: i32 }
type A = { an: i32 }

const q: J = { r: 5 }
const m = Map<string, J | string>()
m.set("a", q)
m.set("b", "s")
print(m.has("a"))
const g = m.get("a")
if g is J { print(g.r) }
const h = m.get("b")
if h is string { print(h) }

const mn = Map<string, N | string>()
mn.set("a", { n: 7 })
const gn = mn.get("a")
if gn is N { print(gn.n ?? 0) }

const o = { m: Map<string, F | string>() }
o.m.set("a", { f: 2 })
const go = o.m.get("a")
if go is F { print(go.f) }

const ls = [Map<string, L | string>()]
ls[0].set("a", { l: 3 })
const gl = ls[0].get("a")
if gl is L { print(gl.l) }

let mr = Map<string, R | string>()
mr = Map<string, R | string>()
mr.set("a", { g: 6 })
const gr = mr.get("a")
if gr is R { print(gr.g) }

function mk() { Map<string, K | string>() }
const mf = mk()
mf.set("a", { k: 9 })
const gf = mf.get("a")
if gf is K { print(gf.k) }

const ma: Map<string, A | string> = Map()
ma.set("a", { an: 4 })
const ga = ma.get("a")
if ga is A { print(ga.an) }
