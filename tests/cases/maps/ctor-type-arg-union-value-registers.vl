// @run
// @log true
// @log 5
// @log s
// @log 7
// @log 7
// @log 2
// @log 3
// @log 6
// @log 9
// D8260: a map whose value union is spelled only as `Map<K, V>()`'s type argument registers
// that union, so a record stored into it boxes and `is` reads it back. The annotated spelling
// and the constructor held by a record field, a list element and a function result run too.

type J = { r: i32 }
type N = { n: i32 | null }

const q: J = { r: 5 }
const m = Map<string, J | string>()
m.set("a", q)
m.set("b", "s")
print(m.has("a"))
const g = m.get("a")
if g is J { print(g.r) }
const h = m.get("b")
if h is string { print(h) }

const ma: Map<string, J | string> = Map()
ma.set("a", { r: 7 })
const ga = ma.get("a")
if ga is J { print(ga.r) }

const mn = Map<string, N | string>()
mn.set("a", { n: 7 })
const gn = mn.get("a")
if gn is N { print(gn.n ?? 0) }

const o = { m: Map<string, J | string>() }
o.m.set("a", { r: 2 })
const go = o.m.get("a")
if go is J { print(go.r) }

const ls = [Map<string, J | string>()]
ls[0].set("a", { r: 3 })
const gl = ls[0].get("a")
if gl is J { print(gl.r) }

let mr = Map<string, J | string>()
mr = Map<string, J | string>()
mr.set("a", { r: 6 })
const gr = mr.get("a")
if gr is J { print(gr.r) }

function mk() { Map<string, J | string>() }
const mf = mk()
mf.set("a", { r: 9 })
const gf = mf.get("a")
if gf is J { print(gf.r) }
