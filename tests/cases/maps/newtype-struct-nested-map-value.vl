// @run
// @log 11
// @log 12
// A NEWTYPE over a struct as the value of a NESTED map value — the kind-6 MAP arm,
// whose inner shape is interned recursively before this slot's parallel arrays are
// pushed. The two same-shape newtypes keep the inner mv slots' arena identities
// distinct while the reps stay one.
type CView = new { base: i32, length: i32 }
type DView = new { base: i32, length: i32 }

function readCView(m: { [string]: { [string]: CView } }): i32 {
  const inner = m["o"]
  if inner != null {
    const cv = inner["i"]
    if cv != null { return cv.base }
  }
  return -1
}
function readDView(m: { [string]: { [string]: DView } }): i32 {
  const inner = m["o"]
  if inner != null {
    const dv = inner["i"]
    if dv != null { return dv.base }
  }
  return -1
}

function goNestedNewtype() {
  const ci: { [string]: CView } = Map()
  ci["i"] = { base: 11, length: 1 }
  const cm: { [string]: { [string]: CView } } = Map()
  cm["o"] = ci
  print(readCView(cm))
  const di: { [string]: DView } = Map()
  di["i"] = { base: 12, length: 2 }
  const dm: { [string]: { [string]: DView } } = Map()
  dm["o"] = di
  print(readDView(dm))
}
goNestedNewtype()
