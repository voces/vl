// @run
// @log 4
// @log 6
// @log 4
// @log 6
// @hint Intentionally-unused variable `_a` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_b` (leading `_` marks it unused)
// @hint redundant type annotation: `dbl` is inferred as `f64` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// A values walk over a map of a function set binds each value at the closure rep the map stores
// it at, called directly and through a copy (D17731's walk half).
function dbl(a: f64): f64 { return a * 2.0 }
const g = (a) => a + 1
const _a = g(2.5)
const _b = g(3)
const m = Map()
m["a"] = g
m["b"] = dbl
for v in m.values() { print(v(3.0)) }
for v in m.values() {
  const w = v
  print(w(3.0))
}
