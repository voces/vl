// @run
// @log 0.5
// @hint redundant type annotation: `ints` is inferred as `i32[]` — remove it to lean on inference
// `m.set(k, v)` is the method spelling of `m[k] = v`, and a readonly list value takes the same
// converting copy through either (D2163): the write analysis files both as one store.
const ints: i32[] = [1, 2]
const m: {[string]: readonly f64[]} = Map()
m.set("j", ints)
print((m["j"] ?? [0.0])[1] / 4.0)
