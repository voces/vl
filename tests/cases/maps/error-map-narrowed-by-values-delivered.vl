// @check
// @error-at 10:34 'w' is narrowed by `is` only for reading its values
// @error-at 13:32 member access '.length' on non-object string | null
// CONTRACT (must-error): a map narrowed by `is` to a narrower value type is read at it, never
// delivered as it, and a store through an alias ends it, as for a list (D4928, D4926, D2701).
const w: {[string]: string | null} = Map()
w["a"] = "x"
const al = w
function take(m: {[string]: string}) { print(m.length) }
// A delivery would hand on a map a later write through `al` can widen.
if w is {[string]: string} { take(w) }
if w is {[string]: string} {
  al["a"] = null
  for v in w.values() { print(v.length) }
}
