// @run
// @log 7
// @log -1
// @log a
// @log z
// @log 7
// @log s
// @log 7.5
// @log -1
// @log -1
// CONTRACT (must-RUN): two `??`-JOINED same-field-set ANONYMOUS object literals that
// disagree at a LEAF field get ONE row whose field is the MERGED type — the scalar twin of
// D672's nested rung (`maps/coalesce-join-same-fieldset-shapes.vl`), and the same argument:
// `structIndexOfObj` matches a literal to a row by field-NAME set, so a `??` that has to
// deliver one value cannot leave the pair with two rows, and the merged field is the only
// rep they share.
//
// THE FILED SENTENCE WAS THE NULL CORNER OF A WIDER FAMILY (`silent-class-inventory` D804,
// filed as D735). Ablated over the field VALUE PAIR of `c["k0"] = {r: A}` / `?? {r: B}`,
// master gave:
//
//     A=i32 / string / f64   B=null   loud `bare null needs a struct-typed context`
//     A=null                 B=i32    the same loud reject
//     A=i32                  B=string CHECK-CLEAN INVALID WASM
//     A=i32                  B=f64    CHECK-CLEAN INVALID WASM
//     A=string               B=i32    CHECK-CLEAN INVALID WASM
//     A=i32                  B=i32    runs (the control)
//
// With `null` the loser has no rep at all and `anonValueFitsField`'s `vc < 0` leniency merges
// the pair onto the winner's valtype — loud. With a DIFFERENT scalar rep that same predicate
// REFUTES, each literal gets its own row, and the `??` then joins two heap types — silent.
// One merged row closes both halves, which is why the rung unions EVERY same-fieldset
// sibling's atom rather than only the null one.
//
// THE MERGED CODE IS THE DECLARED ONE, asked of `nameFieldCode`. `i32|null` and `i32|string`
// are the code-16 box; `string|null` is the code-20 NICHE, and minting 16 for it put a
// `{tag, value}` box behind consumers reading the niche — check-clean invalid wasm, measured,
// which is the one trade worth vetoing. (`boolean|null` is code 21 and is still declined: an
// `#anon` row carrying one interns no map-value slot, so that pair keeps its loud reject.)
//
// DECLARING THE MERGED SHAPE ALWAYS WORKED — `type Circle = { r: i32 | null }` makes the
// first block below print on master. This mints the row the user would otherwise have to
// write, which is what makes it a capability gap rather than a rule.

// ---- i32 beside null: the filed witness, at both the HIT and the MISS ----
function rd(k: string) {
  const c = Map()
  c["k0"] = { r: 7 }
  const g0 = (c)[k] ?? { r: null }
  if g0.r != null { print(g0.r) } else { print(-1) }
}
rd("k0") // 7   — the stored literal, boxed as the i32 atom
rd("miss") // -1  — the default, boxed as the null atom

// ---- string beside null: the code-20 NICHE, not the box ----
function rs(k: string) {
  const c = Map()
  c["k0"] = { r: "a" }
  const g0 = (c)[k] ?? { r: null }
  if g0.r != null { print(g0.r) } else { print("z") }
}
rs("k0") // a
rs("miss") // z

// ---- i32 beside string: the SILENT corner, and no `null` anywhere in it ----
function rm(k: string) {
  const c = Map()
  c["k0"] = { r: 7 }
  const g0 = (c)[k] ?? { r: "s" }
  if g0.r is string { print(g0.r) } else { print(g0.r) }
}
rm("k0") // 7
rm("miss") // s

// ---- f64 beside null, and the reversed order (the null is the STORED value) ----
function rf(k: string) {
  const c = Map()
  c["k0"] = { r: 7.5 }
  const g0 = (c)[k] ?? { r: null }
  if g0.r != null { print(g0.r) } else { print(-1.0) }
}
rf("k0") // 7.5
rf("miss") // -1

function rn(k: string) {
  const c = Map()
  c["k0"] = { r: null }
  const g0 = (c)[k] ?? { r: 7 }
  if g0.r != null { print(g0.r) } else { print(-1) }
}
rn("k0") // -1 — the STORED null
