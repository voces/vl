// @run
// @log 7
// @log 7
// @log 7
// @log 7
// @log 0
// @log 7
// A value read out of an un-annotated `Map()` binding and joined with an existing record by `??`
// builds the binding at that record, through an alias, a call with no declared result, an
// identity, a same-shape generic call and a nested map.
import { reverse } from "std:array"

type Circle = { r: i32 | null }
const dfl: Circle = { r: null }

function idg<T>(x: T): T { return x }

function mk() {
  const m = Map()
  m["k0"] = { r: 7 }
  return m
}

function viaAlias() {
  const c = Map()
  c["k0"] = { r: 7 }
  const d = c
  const g = d["k0"] ?? dfl
  print(g.r ?? 0)
}

function viaCall() {
  const g = mk()["k0"] ?? dfl
  print(g.r ?? 0)
}

function viaIdentity() {
  const c = Map()
  c["k0"] = { r: 7 }
  const g = idg(c)["k0"] ?? dfl
  print(g.r ?? 0)
}

function viaReverse() {
  const lv = Map()
  lv["k0"] = { r: 7 }
  const c = Map()
  c["k0"] = lv
  const dd = reverse([c])[0]
  const g0 = dd["k0"] ?? Map()
  const g = g0["k0"] ?? dfl
  print(g.r ?? 0)
}

function missing() {
  const c = Map()
  c["k0"] = { r: 7 }
  const g = c["k1"] ?? dfl
  print(g.r ?? 0)
  const h = c["k0"] ?? dfl
  print(h.r ?? 0)
}

viaAlias()
viaCall()
viaIdentity()
viaReverse()
missing()
