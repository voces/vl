// @run
// @log 0
// THE SAME SEAM WITH THE MERGE BLOCKED ONE LAYER DOWN (silent-class-inventory D301).
//
// D300 hoisted the kind-1 layout question above the canonical-key gate and asked it as
// ref-list slot EQUALITY. That is the tightest evidence of one vals wrapper, and it is
// blind to the one thing this program has: TWO DECLARED NAMES OF ONE LAYOUT. `Circle` and
// `CircleN` intern two `rlInternName` rows, so the two map-value slots hold rl=0 and rl=2
// — different slots — while `rlTwin` gives both rows the SAME wrapper, because a struct
// element's `rlSig` is `"h:" + sHeapIdx[rlElemStructRow(row)]` and the struct table had
// already deduped the two names.
//
// Probed at the mint on master: `MV0 {r:null} rl=0 rlwrap=8` beside `MV2 CircleN rl=2
// rlwrap=8`, and `RL0 Circle twin=0 wrap=8` beside `RL2 CircleN twin=0 wrap=8`. One
// wrapper, two map structs (disassembled: `$16` and `$18`, field-for-field equal), and
// the nested store of one into the other was
// `Invalid input WebAssembly code: type mismatch: expected (ref $type), found (ref $type)`.
//
// `type Circle` IS LOAD-BEARING even though nothing references it: delete it and the same
// program RUNS, because then there is only one `rlInternName` row to be twins of.
//
// The `0` is the right answer: `r` is `null`, so the `!=` is false.
type Circle = { r: i32 | null }
type CircleN = { r: i32 | null }
function nested() {
  const iv = Map()
  iv["k0"] = { r: null }
  const om = Map()
  om["k0"] = iv
  const dd: {[string]: {[string]: CircleN}} = om
  const n0 = (dd)["k0"] ?? Map()
  const n1 = (n0)["k0"] ?? { r: null }
  if (n1).r != null { print(7) } else { print(0) }
}
nested()
