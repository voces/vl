// @run
// @log 0
// THE MAP-VALUE HEAP TWIN THE CANONICAL KEY REFUSED (silent-class-inventory D300).
//
// A map struct's whole identity is `(keys wrapper, vals wrapper)` — the other five
// fields are constant across every one of them (`emitTypeSection`'s map loop). So two
// map-value slots that interned the SAME vals ref-list slot emit BYTE-IDENTICAL map
// structs and MUST share one heap type. `repMapValSlotsTwin` gated that on the value
// type's CANONICAL KEY first, which is a TYPE identity and not a layout one: `{r: null}`
// — what an un-annotated `Map()` infers at its first key write — and the declared
// `Circle` (`{r: i32 | null}`) resolve ONE struct row and ONE vals slot and are two
// different `repCanonId`s. Two map structs were minted for one map, and handing the
// call's result to the field's `struct.new` was `vl check` rc 0 with no diagnostics, then
// "type mismatch: expected (ref $type), found (ref $type)" out of the engine — two
// distinct heap types behind one placeholder.
//
// THE DIFFERENCE FROM D203–D207's ALREADY-FIXED DESTINATION RUNG IS ONE HOP: the map
// arrives through a FUNCTION's inferred RETURN, so there is no annotated binding in the
// way to pin it. `inferred-map-destination-shape.vl` section 6 is the same seam with the
// map bound directly, and it has run since #1907.
//
// The `0` is the right answer: `r` is `null`, so the `!=` is false.
type Circle = { r: i32 | null }
type GW = { g: {[string]: Circle} }
function mkcall() {
  const cc = Map()
  cc["k0"] = { r: null }
  return cc
}
const wv: GW = { g: mkcall() }
const g0 = (wv.g)["k0"] ?? { r: null }
if (g0).r != null { print(7) } else { print(0) }
