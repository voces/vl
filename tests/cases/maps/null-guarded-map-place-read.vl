// @run
// @log 10
// @log 10
// @log 1
// @log 10
// @log 10
// @log 6
// @log a
// A map cell guarded by `!= null` and READ at that place. A list cell has narrowed that way
// since D451; the map arm was declined on the reading that a map read is `V | null` whatever
// the key, so keying it would narrow a nullability the storage never dropped (D1734).
//
// Three condition spellings, because they reach three different collector arms: `!= null`,
// the else of `== null`, and the else of `is null` — the last only over a nullable value,
// which is the only place the emitter admits `is null`. Then the value reps, the WRITE that
// the guard must not widen, and last an ARM-valued cell, whose read is no longer unwrapped.
type Hit = { msg: string }
type Miss = { why: string }
type R = Hit | Miss
const m: { [string]: i32 } = Map()
m["k"] = 5
if m["k"] != null { print(m["k"] * 2) } else { print(0) }
if m["k"] == null { print(0) } else { print(m["k"] * 2) }
const ml: { [string]: i32[] } = Map()
ml["k"] = [5]
if ml["k"] != null { print(ml["k"].length) } else { print(0) }
const mn: { [string]: i32 | null } = Map()
mn["k"] = 5
if mn["k"] != null { print(mn["k"] * 2) } else { print(0) }
if mn["k"] is null { print(0) } else { print(mn["k"] * 2) }
if m["k"] != null {
  m["k"] = 3
  print(m["k"] * 2)
} else {
  print(0)
}
const mh: { [string]: Hit | null } = Map()
mh["k"] = { msg: "a" }
if mh["k"] is Hit { print(mh["k"].msg) } else { print("null") }
