// @run
// A default that is neither a member nor an atom of the set joins with the atom read into the
// box `K0 | i32`, so a hit prints its member and a miss the default (D4750).
type K0 = "aa" | "bb"

function go() {
  const m: {[string]: K0} = Map()
  m["k"] = "aa"
  print(m["k"] ?? 3)
  print(m["z"] ?? 3)
}
go()
// @log aa
// @log 3
