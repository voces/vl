// @run
// @log 0
// @log 1
// @log 1.5
// @log JO
// @log f64
// @log null
// The return annotation stays: an ANNOTATED return pins the function's rep, and this
// fixture exists because two producers disagreed about a rep. Leaning on inference here
// would quietly change what it tests.
// @hint redundant type annotation: `kind` is inferred as `string`
// A mutually recursive alias pair with the MAP declared FIRST — the declaration order
// D1036 did not close, and the one that made a type's file position observable.
//
// THE DECLARED TYPE HAD NO EMIT NAME AT ALL. `type J = null | f64 | JO` folds its `null`
// (`annUnionTy(nonNull, true)`) and pass 0b fills the 0a placeholder with that fold as its
// SINGLE member, so `cUserTypes["J"]` is a one-member `TyUnion` and every reference — `JO`'s
// map value included — carries the `TyNullable` INSIDE it. The cycle guard cannot name that
// index, one nameless member collapses the spelling, and `tyToEmitName(J)` is "".
//
// TWO HALVES, AND THE FIRST ALONE IS A MISCOMPILE. Answering a COLLAPSED render with the
// declared name makes the binding build — and then `is` over the MAP arm answers false for a
// value of that very arm, because the store interns the slot through the value NAME (which
// resolves to the wrapper) while an `is` test asks by arena TYPE (`tyMapValOf`, the member).
// Two integers for one type, two tags for one arm, and a boxed map that matches NOTHING.
// `mvSlotOfValTyK` retries through the wrapper on a miss, which is the half that makes the
// tags agree.
//
// The arm sweep below is the point of the fixture: every gate in this repo passed the
// render half on its own, and only an `is`-over-the-map-arm line caught it.
type JO = { [string]: J }
type J = null | f64 | JO

const o: JO = Map()
print(o.size)

o["k"] = 1.5
print(o.size)

const v = o["k"]
if v is f64 { print(v) }

function kind(x: J): string {
  if x == null { return "null" }
  if x is f64 { return "f64" }
  if x is JO { return "JO" }
  "none"
}
const nested: JO = Map()
print(kind(nested))
print(kind(2.5))
print(kind(null))
