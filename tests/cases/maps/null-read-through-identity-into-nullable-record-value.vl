// @run
// @log true
// @log true
// @log true
// @log 3
// @info `ln` is never reassigned; use `const` instead of `let`
// D8361: a `null`-typed read handed through a generic identity into a nullable-record map
// value is the identity's own `null`, not the map value's null heap: through `set`, through
// `m[k] = …`, and from a `let` binding no write fills.
type C = { a: i32, b: i32 }
function id<T>(x: T): T { x }
const nn = null
const m: { [string]: C | null } = Map()
m.set("k", id(nn))
print(m.get("k") == null)
m["j"] = id(nn)
print(m["j"] == null)
let ln = null
m.set("l", id(ln))
print(m.get("l") == null)
m.set("c", { a: 3, b: 4 })
const g = m.get("c")
if g != null { print(g.a) }
