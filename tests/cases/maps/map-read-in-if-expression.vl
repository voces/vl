// @run
// @log 42
// @log 7
// @log 42
// @log 42
// @log 42
// @log 42
// @log 42
// @log 5
// @log 42
// @log 42
// @hint redundant type annotation: `elems` is inferred as `(i32 | null)[]` — remove it to lean on inference
// @hint redundant type annotation: `v` is inferred as `i32 | null` — remove it to lean on inference
// @hint redundant type annotation: `v` is inferred as `i32 | null` — remove it to lean on inference
// @hint redundant type annotation: `v` is inferred as `i32 | null` — remove it to lean on inference
// @hint redundant type annotation: `v` is inferred as `i32 | null` — remove it to lean on inference
// @hint redundant type annotation: `v` is inferred as `i32 | null` — remove it to lean on inference
// @hint redundant type annotation: `b` is inferred as `{v: i32 | null}` — remove it to lean on inference

// D1827 — a module-global MAP read anywhere inside an `if` used as an EXPRESSION. The map
// scratch frame is reserved from `fnUsesMap`, and its walk tested every operand kind but not
// an `if` in expression position, so the body read fifteen slots the locals vector never
// declared. Each cell is its own function on purpose: a second map touch anywhere in the
// frame sets the flag by another route and the cell stops testing anything.
type Box = { v: i32 | null }

const reg: {[string]: i32} = Map()

function fill() { reg["k"] = 42 }
fill()

// The map read is in the CONDITION only — the arms never touch it.
function condOnly() {
  const v: i32 | null = if reg["k"] != null { 42 } else { null }
  v ?? 0
}
print(condOnly())

// The map read is in an ARM only, under a condition that narrows nothing.
function armOnly(flag: boolean) {
  const v: i32 | null = if flag { 7 } else { null }
  v ?? 0
}
print(armOnly(true))

// The narrowed re-read, which is what an optional call over a map receiver desugars to.
function narrowedReRead() {
  const v: i32 | null = if reg["k"] != null { reg["k"] } else { null }
  v ?? 0
}
print(narrowedReRead())

// `return <if-expression>` — the delivery the tail-expression spelling does not share.
function returned(): i32 | null {
  return if reg["k"] != null { reg["k"] } else { null }
}
print(returned() ?? 0)

// An ARGUMENT, an ARRAY element and an object FIELD, the three literal positions.
function take(a: i32 | null) { a ?? 0 }
function argument() { take(if reg["k"] != null { reg["k"] } else { null }) }
print(argument())

function arrayElem() {
  const elems: (i32 | null)[] = [if reg["k"] != null { reg["k"] } else { null }]
  const first = elems[0]
  if first != null { return first }
  0
}
print(arrayElem())

function objField() {
  const b: Box = { v: if reg["k"] != null { reg["k"] } else { null } }
  b.v ?? 0
}
print(objField())

// A `match`, which the checker desugars into the same if-chain.
function matched(x: i32 | string) {
  const v: i32 | null = match x {
    i32 => reg["k"]
    string => 5
  }
  v ?? 0
}
print(matched("s"))

// The two controls that ran before and must keep running: an if STATEMENT, and a LOCAL map
// whose declaration sets the flag by itself.
function ifStatement() {
  let out = 0
  if reg["k"] != null { out = reg["k"] ?? 0 }
  out
}
print(ifStatement())

function localMap() {
  const own: {[string]: i32} = Map()
  own["k"] = 42
  const v: i32 | null = if own["k"] != null { own["k"] } else { null }
  v ?? 0
}
print(localMap())
