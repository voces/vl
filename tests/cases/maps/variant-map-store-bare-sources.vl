// Q58 sweep: a bare variant value stored into a map whose value is that variant, from each source,
// as `m[k] = v` and `m.set(k, v)`, in a function and at module scope; each read back prints a field
// only that variant has.
type Circle = { r: i32 }
type Square = { side: i32, tag: string }
type Shape = Circle | Square
type Box = { c: Circle }
type Holder = { h: Circle | null }
let gn: Circle | null = null
function mk(r: i32): Circle { return { r: r } }
function show(m: {[string]: Circle}, k: string) {
  const c = m.get(k)
  if c != null { print(c.r) } else { print("none") }
}
function fromConst() {
  const m: {[string]: Circle} = Map()
  const c: Circle = { r: 1 }
  m["a"] = c
  m.set("b", c)
  show(m, "a")
  show(m, "b")
}
function fromParam(p: Circle) {
  const m: {[string]: Circle} = Map()
  m["a"] = p
  m.set("b", p)
  show(m, "b")
}
function fromCall() {
  const m: {[string]: Circle} = Map()
  m["a"] = mk(3)
  m.set("b", mk(4))
  show(m, "a")
  show(m, "b")
}
function fromField(bx: Box) {
  const m: {[string]: Circle} = Map()
  m["a"] = bx.c
  m.set("b", bx.c)
  show(m, "a")
}
function fromElem(cs: Circle[]) {
  const m: {[string]: Circle} = Map()
  m["a"] = cs[1]
  m.set("b", cs[0])
  show(m, "a")
  show(m, "b")
}
function fromNarrowed(s: Shape) {
  const m: {[string]: Circle} = Map()
  if s is Circle {
    m["a"] = s
    m.set("b", s)
  }
  show(m, "a")
}
function fromNullable(n: Circle | null) {
  const m: {[string]: Circle} = Map()
  if n != null {
    m["a"] = n
    m.set("b", n)
  }
  show(m, "b")
}
function fromNullableLocal(k: i32) {
  const m: {[string]: Circle} = Map()
  let n: Circle | null = null
  if k > 0 { n = mk(k) }
  if n != null { m["a"] = n }
  show(m, "a")
}
function fromNullField(o: Holder) {
  const m: {[string]: Circle} = Map()
  if o.h != null {
    m["a"] = o.h
    m.set("b", o.h)
  }
  show(m, "a")
}
function fromNullGlobal() {
  const m: {[string]: Circle} = Map()
  if gn != null {
    m["a"] = gn
    m.set("b", gn)
  }
  show(m, "b")
}
function fromNullCapture(k: i32) {
  let n: Circle | null = null
  if k > 0 { n = mk(k) }
  const f = () => {
    const m: {[string]: Circle} = Map()
    if n != null { m["a"] = n }
    show(m, "a")
  }
  f()
}
fromConst()
fromParam(mk(2))
fromCall()
fromField({ c: mk(5) })
fromElem([mk(6), mk(7)])
fromNarrowed(mk(8))
fromNarrowed({ side: 1, tag: "sq" })
fromNullable(mk(9))
fromNullable(null)
fromNullableLocal(10)
fromNullableLocal(0)
fromNullField({ h: mk(13) })
fromNullField({ h: null })
gn = mk(14)
fromNullGlobal()
fromNullCapture(15)
fromNullCapture(0)
const gm: {[string]: Circle} = Map()
const gc: Circle = { r: 11 }
gm["g"] = gc
gm.set("h", mk(12))
show(gm, "g")
show(gm, "h")
