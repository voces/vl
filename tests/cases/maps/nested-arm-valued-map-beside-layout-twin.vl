// @run
// @log 7
// @log 9
// @log 3
// @log 4
// @log 5
// @hint redundant type annotation: `cA` is inferred as `{r: i32}`
// @hint redundant type annotation: `cB` is inferred as `{r: i32}`
// @hint redundant type annotation: `cP` is inferred as `{p: i32}`
// @hint redundant type annotation: `cQ` is inferred as `{p: i32}`
// @hint redundant type annotation: `cS` is inferred as `{w: i32}`
// D93. A NESTED ARM-VALUED MAP BESIDE ITS LAYOUT TWIN IS TWO SLOTS — D48'S SHAPE ONE
// CONTAINER OUT, AND TWO STACKED LAYERS DROPPED THE SAME NOMINAL FACT.
//
// `Circle` is an arm of `Shape`, `Dot` is a standalone struct with the identical field set.
// D47 keyed an arm-valued map's mv slot on the ARM'S OWN NAME and D48 made the arm the
// third component of that slot's identity, so `{[string]: Circle}` and `{[string]: Dot}`
// are correctly two slots. Wrap each in ANOTHER map and both fixes stop reaching: the outer
// map's VALUE is a `TyMap`, not an arm, so `variantRowOfTy` answers -1 for both and
// `tyToEmitName` — which drops the arm at EVERY depth — renders both outer values
// `{[string]:{r:i32}}`. One outer slot, one vals element heap, and whichever inner map
// struct loses is stored into a field typed for the other: `vl check` rc 0, "type mismatch:
// expected (ref null $type), found (ref $type)".
//
// THE CONDITION THAT WOULD BE CORRECT IS A PROPERTY OF THE PAIR, and that is why two
// measured candidates were refuted before this one: making the FIND discriminate on the arm
// (701 -> 609 correct, 17 -> 57 silent) and holding a LOUD floor at the mint (866/148/10
// against 894/112/18, buying 8 fewer silent cells for 28 fewer working programs, six of
// them `correct` on master). Both had to answer "will a second, differently-armed value
// later claim this slot?", which a mint minting one slot at a time cannot see — so every
// shape-level approximation fired on SINGLE-UNIT programs whose only sin was an unused
// `type Dot = {r:i32}`. A KEY does not have to see the pair: it is computed per claimant
// from what already distinguishes them, mint and find compute it the same way, and a
// single-unit program merely gets its slot under a different name.
//
// TWO LAYERS, AND NEITHER HALF IS CORRECT ALONE — measured by ablation on a 300-cell grid.
// The mv half (the nominal key plus the slot's ARM SIGNATURE) separates the outer slots and
// leaves 24 silent; the rep-key half (`repElemKey`/`repMvValKey`'s missing VARIANT rung,
// the exact complement of the DECLARED-struct rung beside it) alone REDDENS 9 working
// programs. Together: 27 cells moved, every one to `runs`, 0 backward.
//
// WHICH FUNCTION FAILED WAS THE DECLARATION ORDER, so both orders are below.

type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Dot = { r: i32 }

type IMA = {[string]: Circle}
type NMA = {[string]: IMA}
type IMB = {[string]: Dot}
type NMB = {[string]: IMB}

function reader() {
  const imA: IMA = Map()
  const cA: Circle = { r: 7 }
  imA["k"] = cA
  const nmA: NMA = Map()
  nmA["a"] = imA
  const qA = nmA["a"]
  if qA != null {
    const gA = qA["k"]
    if gA != null { print(gA.r) } else { print(-1) }
  } else { print(-1) }
  const imB: IMB = Map()
  const cB: Dot = { r: 9 }
  imB["k"] = cB
  const nmB: NMB = Map()
  nmB["a"] = imB
  const qB = nmB["a"]
  if qB != null {
    const gB = qB["k"]
    if gB != null { print(gB.r) } else { print(-1) }
  } else { print(-1) }
}

reader()

// THE TWIN DECLARED FIRST — the same pair, the other order. On master the failure moved to
// whichever unit came second and the count did not change.
type Pt = { p: i32 }
type Tri = { t3: i32 }
type Poly = Pt | Tri
type Q = { p: i32 }

type IMQ = {[string]: Q}
type NMQ = {[string]: IMQ}
type IMP = {[string]: Pt}
type NMP = {[string]: IMP}

function readerB() {
  const imQ: IMQ = Map()
  const cQ: Q = { p: 3 }
  imQ["k"] = cQ
  const nmQ: NMQ = Map()
  nmQ["a"] = imQ
  const q = nmQ["a"]
  if q != null {
    const g = q["k"]
    if g != null { print(g.p) } else { print(-1) }
  } else { print(-1) }
  const imP: IMP = Map()
  const cP: Pt = { p: 4 }
  imP["k"] = cP
  const nmP: NMP = Map()
  nmP["a"] = imP
  const p = nmP["a"]
  if p != null {
    const g = p["k"]
    if g != null { print(g.p) } else { print(-1) }
  } else { print(-1) }
}

readerB()

// THE SINGLE-UNIT CONTROL, WHICH IS THE ONE THE REFUTED FLOORS REDDENED. One nested
// arm-valued map, no twin declared anywhere, crossing a FUNCTION BOUNDARY as a declared
// return and bound un-annotated on the way back. It is `correct` on master and on this
// branch; a floor at the mint made it a reject, which is the whole reason this row closed
// with a key instead.
type Star = { w: i32 }
type Moon = { m: i32 }
type Sky = Star | Moon
type IMS = {[string]: Star}
type NMS = {[string]: IMS}

function mkS(): NMS {
  const cS: Star = { w: 5 }
  const im: IMS = Map()
  im["k"] = cS
  const nm: NMS = Map()
  nm["a"] = im
  return nm
}

function readerC() {
  const nm = mkS()
  const q = nm["a"]
  if q != null {
    const g = q["k"]
    if g != null { print(g.w) } else { print(-1) }
  } else { print(-1) }
}

readerC()
