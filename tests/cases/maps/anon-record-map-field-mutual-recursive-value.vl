// @run
// @log hi
// @log 4
// The value's cycle closes through a second declaration (`B` holds `A`, `A` holds `B`).
type A = { b: B | null, v: i32 }
type B = { a: A | null, w: string }
const m: {[string]: B} = Map()
m["k"] = { a: { b: null, v: 4 }, w: "hi" }
const o = { m: m }
const x = o.m["k"]
if x != null {
  print(x.w)
  const a = x.a
  if a != null { print(a.v) }
}
