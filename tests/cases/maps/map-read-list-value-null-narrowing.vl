// @run
// @log false
// @log 5
// @log 5
// @log 1
// @log s
// @log 1.5
// @log 9
// NARROWING A MAP READ whose VALUE is a ref container — the rung
// `maps/error-inline-null-compare-list-value.vl` was pinned open for, and which replaces it.
//
// The read yields `T[] | null` (a MISS is the null) and the vals element is
// `(ref null <wrapper>)` already, so the rep was always there — what was missing was the
// CLAIM. `emitNulIsNullTest` consults six predicates and every one of them answered false for
// a map read, so a receiver the CHECKER calls nullable (`nodeTyIsNullable` 1) reached the
// `uDeclared` floor: `` `is` test but no union type declared `` for the `is` spelling, and
// `bare null needs a struct-typed context` for `== null` / `!= null`, both on `vl check`-clean
// programs (silent-class-inventory D1038/D1039).
//
// THE ANNOTATED BINDING ALWAYS WORKED — `const g: i32[] | null = m[k]` pins the rep from the
// annotation and never consults the initializer — which is why no fixture caught this: it is
// the missing-annotation shape (D969). Every binding below is deliberately UN-annotated.
//
// One arm per predicate, and each covers both spellings and both positions at once: the
// inline `m[k] == null` asks the predicate directly, the un-annotated `const g = m[k]` asks it
// through the let-slot ladder to pick the local's kind.
function inlineCompare() {
  const m: { [string]: f64[] } = Map()
  m["k"] = [1.5]
  print(m["k"] == null)
}
inlineCompare()

// i32-list value — the `nullist` rep, both spellings.
const mi: { [string]: i32[] } = Map()
mi["a"] = [5]
const gi = mi["a"]
if gi is i32[] { print(gi[0]) }
const gi2 = mi["a"]
if gi2 != null { print(gi2[0]) }

// A MISS reads as null, so the narrow must decline it rather than trap.
const gmiss = mi["nope"]
if gmiss != null { print(0) } else { print(1) }

// The distinct-backing scalar lists — `nulstrlist` and `nulf64list`.
const ms: { [string]: string[] } = Map()
ms["a"] = ["s"]
const gs = ms["a"]
if gs is string[] { print(gs[0]) }

const mf: { [string]: f64[] } = Map()
mf["a"] = [1.5]
const gf = mf["a"]
if gf is f64[] { print(gf[0]) }

// A nested MAP value — the same niche one container over.
const mm: { [string]: { [string]: i32 } } = Map()
mm["a"] = Map()
const gm = mm["a"]
if gm is { [string]: i32 } { print(9) }
