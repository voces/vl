// @run
// @log 41
// @log 41
// @log 41
// @log 41
// @log 41
// @log 1
// @log 41
// @log true
// @log 41
// D15547: a `Map()` in a list handed to an un-annotated parameter takes its value type from
// the callee's store through the element, as a record field's `Map()` does through the field.
function t(a) {
  a[0]["k"] = 41
  print(a[0]["k"] ?? 0)
}
t([Map()])
const xs = [Map()]
t(xs)

function inRec(a) {
  a.f[0]["k"] = 41
  print(a.f[0]["k"] ?? 0)
}
inRec({ f: [Map()] })

function recs(a) {
  a[0].f["k"] = 41
  print(a[0].f["k"] ?? 0)
}
recs([{ f: Map() }])

function two(a) {
  a[0]["k"] = 41
  a[1]["j"] = 2
  print(a[0]["k"] ?? 0)
  print(a[1].length)
}
two([Map(), Map()])

function viaLocal(a) {
  const m = a[0]
  m["k"] = 41
  print(m["k"] ?? 0)
}
viaLocal([Map()])

function sets(a) {
  a[0].add(4)
  print(a[0].has(4))
}
sets([Set()])

function ann(a: Map<string, i32>[]) {
  a[0]["k"] = 41
  print(a[0]["k"] ?? 0)
}
ann([Map()])
