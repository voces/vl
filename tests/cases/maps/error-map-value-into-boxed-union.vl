// @check
// @error {[string]: Circle} is not {[string]: Circle | Sq}: a container never widens implicitly
// A `Circle` value is stored bare and a `Circle | Sq` value as the union's box, so the two maps
// store their values differently and a delivery between them is refused, as it is for scalars (D2691).
type Circle = { r: i32 }
type Sq = { s: i32 }
const m: {[string]: Circle} = Map()
m["a"] = { r: 3 }
const w: {[string]: Circle | Sq} = m
print(w.length)
