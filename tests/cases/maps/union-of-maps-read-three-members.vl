// @run
// @log i32 10
// @log null
// @log true
// @log f64 2.5
// @log null
// @log true
// @log P 42
// @log null
// @log true
// @log 9
// @log 2
// @log true
// @log 2

// Three maps keyed by i32, one holding a record, read once each through a call receiver, and an
// un-annotated join of two maps read the same way (D10140).

import { toString } from "std:fmt"

type P = { x: i32 }
let calls = 0
function mk(k: i32): {[i32]: i32} | {[i32]: f64} | {[i32]: P} {
  calls = calls + 1
  if k == 0 {
    const a: {[i32]: i32} = Map()
    a[1] = 10
    return a
  }
  if k == 1 {
    const b: {[i32]: f64} = Map()
    b[1] = 2.5
    return b
  }
  const c: {[i32]: P} = Map()
  c[1] = { x: 42 }
  c
}
function show(v: i32 | f64 | P | null) {
  if v is null { return "null" }
  if v is i32 { return "i32 " + toString(v) }
  if v is f64 { return "f64 " + toString(v) }
  "P " + toString(v.x)
}
for k in [0, 1, 2] {
  print(show(mk(k)[1]))
  print(show(mk(k).get(2)))
  print(mk(k).has(1))
}
print(calls)
// un-annotated join of two maps
const m1: {[string]: string} = Map()
m1["a"] = "s"
const m2: {[string]: boolean} = Map()
m2["a"] = true
m2["b"] = false
function pick(c: boolean) {
  if c { m1 } else { m2 }
}
const u = pick(false)
print(u.length)
const r = u["a"]
if r is boolean { print(r) }
const ks = u.keys()
print(ks.length)
