// @run
// @log 1
// @log 4
// @log 2.5

// An index store of an un-annotated parameter into an annotated map lands in the value slot
// `V` and is converted at the pin, as `.set(k, v)` is (D10042).

type Box = { m: Map<string, i32> }

function f(v) {
  const m: Map<string, i32> = Map()
  m["a"] = v
  print(m.length)
}
f(7)

function g(v) {
  const b: Box = { m: Map() }
  b.m["a"] = v
  print(b.m["a"] ?? 0)
}
g(4)

function h(v) {
  const m: Map<string, f64> = Map()
  m["a"] = v
  print(m["a"] ?? 0.0)
}
h(2.5)
