// @check
// @error member access '.keys' on non-object {[string]: i32} | null
// CONTRACT (must-error) — THE OTHER DIRECTION OF THE SAME BOUNDARY that
// forin-narrowed-nullable-map-views.vl pins. Making a NARROWED nullable map iterable
// must not make an UN-NARROWED one iterable: without the `!= null` guard the map may
// be null at the `.keys()`, and the receiver's `ref.as_non_null` recover would TRAP
// instead of diagnosing. The recover is sound only because the checker proved the
// guard, so the guard has to stay mandatory — this is the leg that keeps it so.
const m: {[string]: i32} | null = Map()
for k in m.keys() {
  print(k)
}
