// @run
// @log 5
// @log true
// @log 1

// A union of maps held in a record field reads through the field, and through a generic call
// returning the record (D10140).

type Box = { m: {[string]: i32} | {[string]: string} }
function first<T>(xs: T[]): T { xs[0] }
const a: {[string]: i32} = Map()
a["q"] = 5
const b: Box = { m: a }
print(b.m["q"] ?? 0)
print(b.m.has("q"))
const bs = [b]
print(first(bs).m.length)
