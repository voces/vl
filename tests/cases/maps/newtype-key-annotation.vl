// @run
// @log 1
// @log 2
// @log 1
// @log 0
// @log 2
// @log 10
// @log 20
// @log 1
// @log 7
// @log 1
// @log 4
// @hint redundant type annotation: `ka` is inferred as `Id`
// @hint redundant type annotation: `kb` is inferred as `Id`
// @hint redundant type annotation: `dk` is inferred as `Id2`
// A NOMINAL NEWTYPE at the map/Set KEY position. `type Id = new i32` is minted as a
// SECOND arena index over the SAME `Ty` value and is erased before the emitter runs
// (`newtype-design.md` §3), so `{[Id]: V}` hashes byte-for-byte as `{[i32]: V}` —
// every module below is byte-identical to the one its `{[i32]: V}` / `{[string]: V}`
// twin builds, and to the twin with the annotation deleted entirely.
//
// The gate that decides this (`typecheck.mapKeyRepTy`) asks what the key LOWERS to,
// not what it is spelled: an index compare against `TY_I32`/`TY_STR` is a spelling
// test, and it refused every key below — in BOTH spellings, the annotation and the
// `m[k] = v` pin — so an annotation that restates exactly what inference already knows
// was an error. The two emitter predicates that pick between the string-keyed and the
// i32-keyed map struct (`nodeTyMapKeyIsI32`, `emit_rep.tyMapKeyIsI32`) project that
// same answer, so the checker and the emitter cannot disagree about which hash a map
// takes.
//
// Every binding here is ANNOTATED on purpose: an annotated `{[K]: V}` anywhere in a
// module mints that slot, and an inferred `Map()` elsewhere in the same module would
// then resolve it and pass for the wrong reason.
//
// The declared `@hint`s are the KEY BINDINGS, never the map annotations — inference
// recovers `Id` from `1 as Id` but has no way to reach `{[Id]: i32}` from a bare
// `Map()`, so the map annotations below are load-bearing, not documentation.
type Id = new i32
type Nm = new string
type Id2 = new Id

const ka: Id = 1 as Id
const kb: Id = 2 as Id

// INDEX write + read through an i32-base newtype key.
const m: {[Id]: i32} = Map()
m[ka] = 1
m[kb] = 2
print(m[ka] ?? 0) // 1
print(m[kb] ?? 0) // 2

// `.has` / `.delete` / `.length` over the same key.
if m.has(ka) { print(1) } else { print(0) } // 1
m.delete(ka)
m.delete(kb)
print(m.length) // 0

// `.set` / `.get` and a for-in, whose loop variable is the newtype key itself.
const counts: {[Id]: i32} = Map()
counts.set(ka, 10)
counts.set(kb, 20)
print(counts.keys().length) // 2
for k in counts { print(counts.get(k) ?? 0) } // 10, 20

// A STRING-base newtype key — the other hash.
const names: {[Nm]: i32} = Map()
const nk: Nm = "alpha"
names[nk] = 7
if names.has(nk) { print(1) } else { print(0) } // 1
print(names[nk] ?? 0) // 7

// A newtype OVER a newtype erases to the same base, so it keys a map too.
const deep: {[Id2]: i32} = Map()
const dk: Id2 = 3 as Id2
deep[dk] = 1
print(deep[dk] ?? 0) // 1

// A Set of newtype keys, and a NULLABLE map — the `| null` wrapper the key predicates
// tolerate, which resolved to the wrong map struct while the gate compared indices.
const seen: {[Id]: boolean} = Set()
seen.add(ka)
seen.add(kb)
let opt: {[Id]: i32} | null = null
opt = Map()
if opt != null {
  opt[ka] = seen.length + 2
  print(opt[ka] ?? 0) // 4
}
