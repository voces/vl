// @run
// @log object
// @log object
// @log object
// @log object
// @log 2
// @log {"bytes":2254088}
// A map whose type is spelled through a RECURSIVE alias, delivered into the union that alias
// is part of. All four spellings of the pair — alias or inline on the VALUE, alias or inline
// on the ARM — and the narrowed read that says the box is real, plus `std:json`'s own write
// path, which is what a reader of that module's header writes (D1865).
// @hint redundant type annotation: `name` is inferred as `string` — remove it to lean on inference
// @hint redundant type annotation: `wname` is inferred as `string` — remove it to lean on inference
// @hint redundant type annotation: `size` is inferred as `i32` — remove it to lean on inference

import { Json, JsonError, toJson } from "std:json"

// The arm spelled INLINE.
type V = f64 | string | { [string]: V }
type VMap = { [string]: V }

// The arm spelled through the ALIAS — a second recursive union, so the two do not share a row.
type W = f64 | string | WMap
type WMap = { [string]: W }

function name(v: V): string {
  if v is f64 { return "number" }
  if v is string { return "string" }
  "object"
}

function wname(w: W): string {
  if w is f64 { return "number" }
  if w is string { return "string" }
  "object"
}

// aliased value, inline arm — the row's own witness, and `std:json`'s shape.
const a: VMap = Map()
a["k"] = 1.0
print(name(a))

// inline value, inline arm — the control that ran before the fix and must keep running.
const b: { [string]: V } = Map()
b["k"] = 1.0
print(name(b))

// aliased value, aliased arm.
const c: WMap = Map()
c["k"] = 1.0
print(wname(c))

// inline value, aliased arm.
const d: { [string]: W } = Map()
d["k"] = 1.0
print(wname(d))

// The LOAD-BEARING read: narrow back to the map arm and ask its size. Without this, "runs"
// is consistent with an untagged pass-through that happens to fall to the last branch.
function size(v: V): i32 {
  if v is f64 { return -1 }
  if v is string { return -2 }
  if v is { [string]: V } { return v.size }
  -3
}

const e: VMap = Map()
e["one"] = 1.0
e["two"] = "x"
print(size(e))

// `std:json`'s write path, the reason the row exists: `Json`'s object arm is recursive and
// spelled inline, so a program that names the object type is exactly this shape.
type JsonMap = { [string]: Json }
const j: JsonMap = Map()
j["bytes"] = 2254088.0
const rendered = toJson(j)
if rendered is JsonError {
  print("render: " + rendered.msg)
} else {
  print(rendered)
}
