// D2505: `{[i64]: V}`, the whole surface over the worst keys for a 64-bit key in a 32-bit index:
// two pairs that share a low half, `-1`, and both i64 extremes. Then insertion order, a re-insert
// after a delete going to the end, a `Set<i64>`, and the other key spellings.

type Handle = i64
type Fd = new i64
type Big = 6000000000 | 7000000000

const kmax = 9223372036854775807
const kmin = kmax + 1
const m: {[i64]: string} = Map()
m[kmax] = "max"
m[kmin] = "min"
m.set(0, "zero")
m[4294967296] = "hi1"
m[-4294967296] = "hineg"
m[-1] = "neg1"
print(m.length)             // 6
print(m[kmax] ?? "?")       // max
print(m[kmin] ?? "?")       // min
print(m[4294967296] ?? "?")
print(m.get(-4294967296) ?? "?")
print(m[-1] ?? "?")
print(m.get(0) ?? "?")
print(m[8589934592] ?? "?") // absent: shares its low half with 0 and 4294967296
const miss = m[1]
print(miss == null)         // true
print(m.has(0))
print(m.has(1))
print(m.delete(-1))         // true
print(m.delete(-1))         // false
print(m.length)             // 5
for k in m { print(k) }
m.delete(0)
m[0] = "zero"               // a re-insert goes to the end
for k, v in m { print(v) }

const ks = m.keys()
print(ks.length) // 5
print(ks[0])     // the max key
let n = 0
for v in m.values() { n = n + v.length }
print(n)         // 18, the five values' lengths

const s: Set<i64> = Set()
s.add(1125899906842624)
s.add(1125899906842624)
s.add(-1)
print(s.length) // 2
print(s.has(1125899906842624))
print(s.has(562949953421312))
print(s.values()[0])

// The generic and inferred spellings, an alias and a newtype key, and a literal union over
// i64, which reps as its i64 base and so hashes as an i64 key.
const g = Map<i64, f64>()
g.set(-3, 1.5)
const c = Map()
const big = 77777777777
c.set(big, 3)
const a: Map<i64, string> = Map()
a[1099511627776] = "a"
print(a[1099511627776] ?? "?")
print(g.get(-3) ?? 0.0)
print(c[big] ?? -1)
const h: {[Handle]: string} = Map()
h[12884901888] = "handle"
print(h[12884901888] ?? "?")
const f: {[Fd]: string} = Map()
f[5000000000 as Fd] = "newtype"
print(f[5000000000 as Fd] ?? "?")
const lm: {[Big]: i32} = Map()
lm[7000000000] = 2
lm[6000000000] = 1
print(lm[7000000000] ?? -1)
print(lm.keys()[0])

// Six keys with one hash, so one home slot: the probe has to walk the chain and tell them apart by
// the stored key, through a delete in the middle of the chain and a re-insert.
const same = [
  -631570175187520707, -1649801635965245830, -2668033096742970953,
  -3686264557520696076, -4704496018298421199, -5722727479076146322,
]
const t: {[i64]: i32} = Map()
for i in 0 until 6 { t[same[i]] = i * 10 }
t.delete(same[2])
let sum = 0
for i in 0 until 6 { sum = sum + (t[same[i]] ?? 100) }
print(sum)
t[same[2]] = 7
print(t[same[2]] ?? -1)
print(t.keys()[5] == same[2])
