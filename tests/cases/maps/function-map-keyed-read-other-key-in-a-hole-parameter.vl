// @run
// @log 6
// @hint redundant type annotation: `dbl` is inferred as `f64` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// D17813's other key: the typed member read through the parameter runs, the parameter keyed at
// the storage the map's stored values close it to (D17813).
function dbl(a: f64): f64 { return a * 2.0 }
const g = (a) => a + 1
const m = Map()
m["a"] = g
m["b"] = dbl
function walk(mm) {
  const v = mm["b"]
  if v != null { print(v(3)) }
}
walk(m)
