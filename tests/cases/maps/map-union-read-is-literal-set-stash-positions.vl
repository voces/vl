// @run
// @log b
// @log b
// @log int
// A map read of an `i32 | "a" | "b"` value tested `is` the literal set, then read again: the
// test's stash holds the read's boxed nullable, declared at the union box's nullable ref. In a
// function, at top level, and with the value the other member.
type AB = "a" | "b"
function show(p: { [string]: i32 | AB }) {
  if p["k"] is AB { print(p["k"]) }
}
const w: { [string]: i32 | AB } = Map()
w["k"] = "b"
show(w)
if w["k"] is AB { print(w["k"]) }
w["j"] = 4
if w["j"] is AB { print("no") } else { print("int") }
