// @run
// @log 0
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// Census block-A cell `a008328` VERBATIM — the graded cell, not a retyping. It is the
// witness for D211, the loud→silent move #1966 introduced and this change closes, and it
// is here so the family cannot go silent again without a red test.
//
// #1966's peel + fixpoint pin `c` from `sink`'s nested-map parameter and then `lv1` from
// `c`'s pinned spelling, which is CORRECT and is why the change is not reverted: what it
// reached was a lowering that had no rung for a `Circle` receiver that is a union ARM
// (D219). Before the peel the same program stopped one stage earlier with `emitProgram:
// ref valtype with no interned shape`; after it, `vl check` was clean and the module was
// one the engine refuses at load.
//
// THE TWO UNUSED TYPE DECLARATIONS ARE LOAD-BEARING. `type Sq` and `type Shape` are never
// mentioned again, and deleting them moves the cell from `union=unused` to `union=nounion`
// — a coordinate that was ALREADY invalid wasm at the base, i.e. a DIFFERENT, pre-existing
// defect wearing the same outcome. A reduced witness therefore looks like a successful
// minimisation and is not one; the cheap check is to run any reduction against the BEFORE
// seed and require it to be LOUD there.
type Circle = { r: i32 | null }
type Sq = { s: i32 }
type Shape = Circle | Sq
function sink(_x: {[string]: {[string]: Circle}}) { }
const lv1 = Map()
lv1["k0"] = { r: null }
const c = Map()
c["k0"] = lv1
sink(c)
const g0 = (c)["k0"] ?? Map()
const g1 = (g0)["k0"] ?? { r: null }
if (g1).r != null { print(7) } else { print(0) }
