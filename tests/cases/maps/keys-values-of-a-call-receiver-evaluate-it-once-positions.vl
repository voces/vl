// @log 2
// @log 2
// `m.keys()` and `m.values()` over a receiver no read can repeat (a call, a field of a call, a
// method chain) evaluate it once: each line prints the list's length, then how many times `mk`
// ran. Q58 positions in functions (let, return, argument, field store, element store) and at top
// level, where one line reads both lists.
let calls = 0
type B = { m: {[string]: i32} }
type H = { s: string[], i: i32[] }
function mk() {
  calls = calls + 1
  const m: {[string]: i32} = Map()
  m["a"] = 1
  return m
}
function bx(): B { return { m: mk() } }
function same(self: {[string]: i32}) { return self }
function n_string(xs: string[]) { return xs.length }
function n_i32(xs: i32[]) { return xs.length }
function let_call_keys() {
  const xs = mk().keys()
  return xs.length
}
function ret_call_keys() { return mk().keys() }
function arg_call_keys() { return n_string(mk().keys()) }
function fld_call_keys() {
  const h: H = { s: [], i: [] }
  h.s = mk().keys()
  return h.s.length
}
function elt_call_keys() {
  const ls: string[][] = [[]]
  ls[0] = mk().keys()
  return ls[0].length
}
function let_call_values() {
  const xs = mk().values()
  return xs.length
}
function ret_call_values() { return mk().values() }
function arg_call_values() { return n_i32(mk().values()) }
function fld_call_values() {
  const h: H = { s: [], i: [] }
  h.i = mk().values()
  return h.i.length
}
function elt_call_values() {
  const ls: i32[][] = [[]]
  ls[0] = mk().values()
  return ls[0].length
}
function let_field_keys() {
  const xs = bx().m.keys()
  return xs.length
}
function ret_field_keys() { return bx().m.keys() }
function arg_field_keys() { return n_string(bx().m.keys()) }
function fld_field_keys() {
  const h: H = { s: [], i: [] }
  h.s = bx().m.keys()
  return h.s.length
}
function elt_field_keys() {
  const ls: string[][] = [[]]
  ls[0] = bx().m.keys()
  return ls[0].length
}
function let_field_values() {
  const xs = bx().m.values()
  return xs.length
}
function ret_field_values() { return bx().m.values() }
function arg_field_values() { return n_i32(bx().m.values()) }
function fld_field_values() {
  const h: H = { s: [], i: [] }
  h.i = bx().m.values()
  return h.i.length
}
function elt_field_values() {
  const ls: i32[][] = [[]]
  ls[0] = bx().m.values()
  return ls[0].length
}
function let_chain_keys() {
  const xs = mk().same().keys()
  return xs.length
}
function ret_chain_keys() { return mk().same().keys() }
function arg_chain_keys() { return n_string(mk().same().keys()) }
function fld_chain_keys() {
  const h: H = { s: [], i: [] }
  h.s = mk().same().keys()
  return h.s.length
}
function elt_chain_keys() {
  const ls: string[][] = [[]]
  ls[0] = mk().same().keys()
  return ls[0].length
}
function let_chain_values() {
  const xs = mk().same().values()
  return xs.length
}
function ret_chain_values() { return mk().same().values() }
function arg_chain_values() { return n_i32(mk().same().values()) }
function fld_chain_values() {
  const h: H = { s: [], i: [] }
  h.i = mk().same().values()
  return h.i.length
}
function elt_chain_values() {
  const ls: i32[][] = [[]]
  ls[0] = mk().same().values()
  return ls[0].length
}
calls = 0
print(let_call_keys())
print(calls)
calls = 0
print(ret_call_keys().length)
print(calls)
