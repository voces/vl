// @run
// @log 7
// @log 5
// @log true
// @log 7
// @log 7
// @log -1
// @log -2
// @log 4
// @log -1
// A read of a null-free scalar map whose default is nullable is `T | null`: a hit boxes the stored
// scalar, a miss is the default. One row per position such a read is delivered in; the i64 map
// rides the same arm.
function key(k: string) { return k }

const n: {[string]: i32} = Map()
n["b"] = 7
const none: i32 | null = null
const some: i32 | null = 5
// a top-level binding, hit and miss
const hit = n[key("b")] ?? none
const miss = n[key("z")] ?? some
print(hit ?? -1)
print(miss ?? -1)
// a print argument
print((n[key("z")] ?? none) == null)
// a literal key
const lit = n["b"] ?? none
print(lit ?? -1)
// a function body, returned
function readOr(k: string): i32 | null { return n[k] ?? none }
print(readOr("b") ?? -1)
print(readOr("q") ?? -1)
// a call argument
function show(v: i32 | null) { print(v ?? -2) }
show(n[key("z")] ?? none)
// an i64 map
const im: {[string]: i64} = Map()
im["x"] = 4 as i64
const idf: i64 | null = null
print(im[key("x")] ?? idf ?? (-1 as i64))
print(im[key("y")] ?? idf ?? (-1 as i64))
