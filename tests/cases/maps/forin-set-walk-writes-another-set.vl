// @run
// @log 40
// @log 40
// @log 0
// @log 3
// @log 6
// @log 0
// @log 3
// @log 6
// @log 0
// @log 0
// @log 3
// @log 1
// @log 6
// @log 2
// @log 40
// @log 2340
// Set walks. A walk over one set whose body adds to another keeps its own set across the
// body (D2313), and an i32-keyed set is a set to every walk: `.values()` and `for x in s`
// yield its elements, and `for x, i in s` binds a dense index, never the membership
// booleans the set stores beside them (D2314).
import { toString } from "std:fmt"

// L1 — string-keyed: `for x in s` adding to another set.
const s: Set<string> = Set()
for i in 0 until 40 { s.add("k" + toString(i)) }
const t: Set<string> = Set()
let n = 0
for r in 0 until 3 {
  for x in s {
    t.add(x)
    if r == 0 { n = n + 1 }
  }
}
print(t.length)
print(n)

// L2 — i32-keyed: `.values()` walked directly and through a binding, then `for x, i`.
const si: Set<i32> = Set()
for i in 0 until 3 { si.add(i * 3) }
for x in si.values() { print(x) }
const xs = si.values()
for x in xs { print(x) }
for x, i in si { print(x); print(i) }

// L3 — i32-keyed: `.values()` adding to another set.
const big: Set<i32> = Set()
for i in 0 until 40 { big.add(i * 3) }
const ti: Set<i32> = Set()
let sum = 0
for r in 0 until 3 {
  for x in big.values() {
    ti.add(x)
    if r == 0 { sum = sum + x }
  }
}
print(ti.length)
print(sum)
