// @run
// @log 5
// @log 4
// A local map's cell reads the shape its stores deliver, as a module global's does: `a` is
// `mk()` built at `J`, so the un-annotated local map holds `J` values (D14643).
type J = { f: i32 | null }
function mk() { { f: 4 } }
function main() {
  const wideJ: J = mk()
  const m = Map()
  const a = mk()
  m.set("a", a)
  const x = m.get("a")
  if x != null { print(x.f + 1) }
  print(wideJ.f ?? 0)
}
main()
