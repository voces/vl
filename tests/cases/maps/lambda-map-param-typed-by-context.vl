// @run
// @log 0
// @log 42
// @log 1
// @log 42
// A lambda whose map parameter takes its type from the function type it is delivered to reads
// that parameter as a map: `.length`, `.get`, an `i32`-keyed map, a lambda handed to a
// function-typed parameter, and a generic whose value type the parameter binds (D9990).
const f: (k: {[string]: i32}) => i32 = (k) => k.length
const e: {[string]: i32} = Map()
print(f(e))
function run(m: {[string]: i32}, g: (k: {[string]: i32}) => i32) { g(m) }
const m: {[string]: i32} = Map()
m.set("a", 41)
print(run(m, (k) => k.length + (k.get("a") ?? 0)))
const fi: (k: {[i32]: i32}) => i32 = (k) => k.length
const mi: {[i32]: i32} = Map()
mi.set(3, 1)
print(fi(mi))
function sz<V>(k: {[string]: V}) { k.length }
const h: (k: {[string]: i32}) => i32 = (k) => sz(k) + 41
print(h(m))
