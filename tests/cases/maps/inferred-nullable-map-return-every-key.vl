// @run
// @log true
// @log x
// @log 9
// @log 2
// @log null
// An un-annotated function returning `null` or a map infers a nullable map at every map key
// kind, string, i32 and i64 (D1108).
function pickI(c: boolean) {
  if c { return null }
  const m: {[i32]: string} = Map()
  m[4] = "x"
  return m
}
function pickL(c: boolean) {
  if c { return null }
  const m: {[i64]: i32} = Map()
  m[5 as i64] = 9
  return m
}
function pickS(c: boolean) {
  if c { return null }
  const m: {[string]: i32} = Map()
  m["k"] = 2
  return m
}
print(pickI(true) == null)
const i = pickI(false)
if i != null { print(i[4] ?? "-") }
const l = pickL(false)
if l != null { print(l[5 as i64] ?? -1) }
const s = pickS(false)
if s != null { print(s["k"] ?? -1) }
const n = pickL(true)
if n != null { print(1) } else { print("null") }
