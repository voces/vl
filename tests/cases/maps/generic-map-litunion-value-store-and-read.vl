// @run
// @log n
// @log s
// @log n
// A map built in a generic at a literal-union value type stores and reads the value at one
// rep, annotated or not (D2595).
type Dir = "n" | "s"
const A1: Dir = "n"
const A2: Dir = "s"
function f<T>(x: T): {[string]: T} {
  const m: {[string]: T} = Map()
  m["k"] = x
  m
}
function g<T>(x: T): {[string]: T} {
  const m = Map()
  m["k"] = x
  m
}
print(f(A1)["k"] ?? "s")
print(f(A2)["k"] ?? "n")
print(g(A1)["k"] ?? "s")
