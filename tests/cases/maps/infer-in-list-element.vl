// @run
// @log x
// @log 1.5
// @log 9000000000
// @log one
// @log 3
// @log true
// @log true
// @log 2
// @log seeded
// AN INFERRED MAP AS A LIST ELEMENT. `arrLitIsRef` / `arrLitElemKind` / `arrLitElemName` are
// three readings of one question — which ref-list ROW an array literal's elements belong to —
// and every element rep had an arm except MAP. A `Map()` element is no object literal, no
// nested literal and no lambda, so all three first-element probes missed it and `[Map()]`
// fell to the i32 LIST, where the element guard refuses a map-struct ref: `emitProgram: map
// array elements are not supported in this position`. The annotated `{[K]: V}[]` twin has
// always run.
//
// The row key is the whole `{[K]:V}` spelling, so the KEY rides it (unlike a struct/variant
// FIELD row, which erases the key) — which is why both key reps are here, and why the
// element's own map struct is found rather than defaulted.
//
// THE FILE MUST STAY ANNOTATION-FREE AT EVERY MAP (`infer-value-kinds.vl` states the rule):
// an annotated `{[K]: V}` anywhere in the module mints that (KEY, VALUE) slot and the
// inferred element then FINDS it, which would make the fixture pass with the row still
// missing. Each factory below is its own function for the same reason — two call sites of
// one factory unify into a single value type and stop testing separate reps.

function mkSeeded() {
  const t = Map()
  t["k"] = "seeded"
  return t
}

// The headline: a bare `Map()` element, written and read through the element.
const xs = [Map()]
xs[0]["a"] = "x"
print(xs[0]["a"] ?? "none") // x

// kind 11 — an f64 value over its own vals list.
const fs = [Map()]
fs[0]["a"] = 1.5
print(fs[0]["a"] ?? 0.0) // 1.5

// kind 10 — an i64 value, through the `.set` write spelling.
const bigs = [Map()]
bigs[0].set("a", 9000000000)
print(bigs[0]["a"] ?? 0) // 9000000000

// The i32 KEY half: `{[i32]: string}` is a different struct from `{[string]: string}` above,
// and a bare `Map()` carries no spelling for the key at all.
const ks = [Map()]
ks[0][1] = "one"
print(ks[0][1] ?? "none") // one

// A struct value over a REF vals list.
const ps = [Map()]
ps[0]["a"] = { x: 3 }
print((ps[0]["a"] ?? { x: 0 }).x) // 3

// A `Set()` element is a boolean-valued map — mono on either key rep, but WHICH mono is
// still the key's to say.
const ss = [Set()]
ss[0].add("a")
print(ss[0].has("a")) // true

const si = [Set()]
si[0].add(7)
print(si[0].has(7)) // true

// TWO elements share one row, and the list keeps its ordinary list surface.
const two = [Map(), Map()]
two[0]["a"] = 1
two[1]["b"] = 2
print(two.length) // 2

// A map that reached the element from a CALL — the element's shape has to survive both the
// return and the element intern, which are separate resolvers reading one recorded type.
const cs = [mkSeeded()]
print(cs[0]["k"] ?? "none") // seeded
