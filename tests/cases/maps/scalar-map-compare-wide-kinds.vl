// @log true
// @log true
// @log true
// @log false
// @log true
// @log false
function big() { return 9000000000 }
const ml: {[string]: i64} = Map()
ml["a"] = 9000000000
const mf: {[string]: f64} = Map()
mf["a"] = 2.5
const ms: {[i32]: f32} = Map()
ms[1] = 1.5
print(ml["a"] == 9000000000)
print(ml["a"] == big())
print(big() != ml["b"])
print(ml["b"] == 0)
print(mf["a"] == 2.5)
print(2.5 == mf["b"])
print(mf["a"] != 2.0)
print(mf["b"] != 0.0)
print(ms[1] == 1.5)
print(ms[2] == 0.0)
function inFn(m: {[string]: f64}, k: string, v: f64) { return m[k] == v }
print(inFn(mf, "a", 2.5))
print(inFn(mf, "z", 0.0))
