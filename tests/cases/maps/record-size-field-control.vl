// @run
// @log 7
// @log 3
// @log 2
// @log 12
// The names `.size` and `len` are free for a program's own use: a record field, a
// `self`-function on a map, and a user function `len` all keep working.
const b = { size: 7 }
print(b.size)

function size(self: {[string]: i32}) { self.length + 1 }
const m: {[string]: i32} = Map()
m["a"] = 1
m["b"] = 2
print(m.size())
print(m.length)

function len(xs: i32[]) { xs.length * 4 }
print(len([1, 2, 3]))
