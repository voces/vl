// @run
// @log aa
// @log 7
// @log 2
// @log 1.5
// @log 5000000000
// @log 2.5
// @log 1
// @log 0
// @log aa
// @log aa
// @log true
// @log 2
// @log 1
// The i32-KEYED half of the array-ELEMENT position, which #1286 kept as a loud reject
// DELIBERATELY and for a reason that has now expired: the `{[string]: V}` spelling of
// this very program was itself invalid wasm, so opening the i32 half would have turned a
// clean reject into that. The string half is fixed
// (`list-of-maps-element-values.vl`), so this graduates.
//
// #1286 predicted this half would then "follow for free, because the ref-list ELEMENT
// row already records the whole `{[i32]: V}` spelling (unlike a field row) and
// `rlElemMapKeyI32` already reads the key off it". THE PREDICTION WAS RIGHT ABOUT THE
// ROW AND WRONG ABOUT FREE. The row does carry the key and needed no column — the gate
// cost exactly one `[]` peel — but opening it exposed a SECOND half-taught classifier
// one layer up: the map-ARRAY annotation arm set `mUsed`/`lUsed`/`aUsed` and not
// `mI32Used`, the flag that gates the i32-keyed map struct, the i32 probe helper and the
// per-function 5-slot i32-KEY scratch frame. Without that frame the store's key
// temporary aliased the map-REF temporary at the same local index — `type mismatch:
// expected (ref $type), found i32`, `vl check` rc 0.
//
// It hid behind two accidents. A `[Map()]` LITERAL flips `mI32Used` from the
// constructor's own checker-recorded key type, so only the `.push` form of a bare
// `{[i32]: V}[]` was exposed; the nullable-element spelling `({[i32]: V} | null)[]` is
// not a `nameIsMapArray` at all, so it was exposed in every form.
//
// THOSE TWO CELLS ARE NOT IN THIS FILE, and their absence is deliberate: `mI32Used` is a
// MODULE flag, so a single `[Map()]` literal anywhere in a file covers every other
// spelling in it. This file is full of literals, and it passes with the fix reverted.
// `list-of-maps-i32-key-frame.vl` holds the two exposed cells with NOTHING that flips the
// flag beside them — the per-function reservation lesson applied one scope out.
type S = { x: i32 }

function use(xs: {[i32]: string}[]): string { return xs[0][1] ?? "z" }

function go() {
  const ss: {[i32]: string}[] = [Map()]
  ss[0][1] = "aa"
  print(ss[0][1] ?? "z") // aa

  const st: {[i32]: S}[] = [Map()]
  st[0][1] = { x: 7 }
  const s1 = st[0][1] ?? { x: 0 }
  print(s1.x) // 7

  const sl: {[i32]: i32[]}[] = [Map()]
  sl[0][1] = [7, 8]
  const l1 = sl[0][1] ?? []
  print(l1.length) // 2

  const sf: {[i32]: f64}[] = [Map()]
  sf[0][1] = 1.5
  print(sf[0][1] ?? 0.0) // 1.5

  const si: {[i32]: i64}[] = [Map()]
  si[0][1] = 5000000000
  print(si[0][1] ?? 0) // 5000000000

  const s32: {[i32]: f32}[] = [Map()]
  s32[0][1] = 2.5
  print(s32[0][1] ?? 0.0) // 2.5

  const sn: {[i32]: string | null}[] = [Map()]
  sn[0][1] = "aa"
  print(sn[0].length) // 1

  const sm: {[i32]: {[i32]: i32}}[] = [Map()]
  sm[0][1] = Map()
  const inner = sm[0][1] ?? Map()
  print(inner.length) // 0

  // The `.push` and NULLABLE-ELEMENT forms live in `list-of-maps-i32-key-frame.vl`, where
  // no literal can mask them (see the header).
  const psh: {[i32]: string}[] = []
  psh.push(Map())
  psh[0][1] = "aa"
  print(psh[0][1] ?? "z") // aa

  print(use(ss)) // aa — the PARAM form

  // has / delete / for-in through an i32-keyed ELEMENT receiver, and `.set`.
  const ops: {[i32]: string}[] = [Map()]
  ops[0].set(1, "aa")
  print(ops[0].has(1)) // true
  ops[0][2] = "bb"
  let n = 0
  for kk in ops[0] { n = n + 1 }
  print(n) // 2
  const d = ops[0].delete(1)
  if d {
    print(ops[0].length) // 1
  }
}
go()
