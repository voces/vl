// @run
// @log 1
// @log 1
// @log 1
// @log 1
// @log ba
// An un-annotated function nothing calls, stored as a record into a map read back from a map, is
// built at its `i32` default; a body that does not check there (`+ "a"`, `.length`) is built with
// no body, since no call can reach that instance (D16927). A call through the slot still runs.
function g(x) { return x + "a" }
function h(x) { return x.length }
function k(x) { return x * 0.5 }
const __m = Map()
__m.set("k", { m: Map() })
const __mv = __m.get("k")
if __mv != null {
  __mv.m["g"] = { f: g }
  print(__mv.m.length)
}
const __n = Map()
__n.set("k", { m: Map() })
const __nv = __n.get("k")
if __nv != null {
  __nv.m["h"] = { f: h }
  print(__nv.m.length)
}
const __o = Map()
__o.set("k", { m: Map() })
const __ov = __o.get("k")
if __ov != null {
  __ov.m["k"] = { f: k }
  print(__ov.m.length)
}
function g2(x) { return x + "a" }
const __p = Map()
__p.set("k", { m: Map() })
const __pv = __p.get("k")
if __pv != null {
  __pv.m["k"] = { f: g2 }
  print(__pv.m.length)
  const r = __pv.m["k"]
  if r != null { print(r.f("b")) }
}
