// @log 4
// An un-annotated function written into an un-annotated `Map()`: the map stores it at the hole
// function's rep, which a read typed at the pinned signature retags. Q58 sweep of the read: a
// binding, a return, a `??` operand, a record field, a list element, a direct call and a `.get`,
// each called to prove the value, and at an annotated binding, argument and `.get` (D17581); an
// `if` arm is D16239.
function inc(a) { return a + 1 }
function zero(a: i32) { return a - a }
const m = Map()
m["k"] = inc

function pLet() {
  const f = m["k"]
  if f != null { print(f(3)) }
}
function pRet() { return m["k"] }
function pCoal() { print((m["k"] ?? zero)(3)) }
function pField() {
  const r = { f: m["k"] }
  if r.f != null { print(r.f(3)) }
}
function pList() {
  const fs = [m["k"]]
  const f = fs[0]
  if f != null { print(f(3)) }
}
function pDirect() {
  if m["k"] != null { print(m["k"](3)) }
}
function call(f: ((a: i32) => i32) | null) {
  return if f != null { f(3) } else { -1 }
}
function pAnnLet() {
  const f: ((a: i32) => i32) | null = m["k"]
  if f != null { print(f(3)) }
}
function pAnnArg() { print(call(m["k"])) }
function pAnnGet() {
  const f: ((a: i32) => i32) | null = m.get("k")
  if f != null { print(f(3)) }
}
function pGet() {
  const f = m.get("k")
  if f != null { print(f(3)) }
}

pLet()
const rf = pRet()
if rf != null { print(rf(3)) }
pCoal()
pField()
pList()
pDirect()
pGet()
pAnnLet()
pAnnArg()
pAnnGet()
