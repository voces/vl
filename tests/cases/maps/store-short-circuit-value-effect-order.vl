// @run
// @log mk5
// @log 5
// @log r5
// @log 5
// @log k5
// @log 5
// @log mk
// @log 2
// @log r
// @log 2
// @log k
// @log 2
// @log mk5
// @log r5
// @hint redundant type annotation: `key` is inferred as `string`
// @hint redundant type annotation: `five` is inferred as `i32`
// A map or field store whose value is a boxed binding's `??` reads its receiver, then its key,
// then tests the binding, calling the default only on null: each call logs its turn.
type R = { f: i32 }
let log = ""
function mkq(n: boolean): i32 | null { return if n { null } else { 2 } }
const mm: {[string]: i32} = Map()
const rr: R = { f: 0 }
function mkM(): {[string]: i32} {
  log = log + "m"
  return mm
}
function mkR(): R {
  log = log + "r"
  return rr
}
function key(): string {
  log = log + "k"
  return "x"
}
function five(): i32 {
  log = log + "5"
  return 5
}
function storeMap(n: boolean) {
  const q = mkq(n)
  mkM()[key()] = q ?? five()
}
function storeField(n: boolean) {
  const q = mkq(n)
  mkR().f = q ?? five()
}
function storeKey(m: {[string]: i32}, n: boolean) {
  const q = mkq(n)
  m[key()] = q ?? five()
}
for n in [true, false] {
  log = ""
  storeMap(n)
  print(log)
  print(mm["x"] ?? -1)
  log = ""
  storeField(n)
  print(log)
  print(rr.f)
  log = ""
  storeKey(mm, n)
  print(log)
  print(mm["x"] ?? -1)
}
const q0 = mkq(true)
log = ""
mkM()[key()] = q0 ?? five()
print(log)
log = ""
mkR().f = q0 ?? five()
print(log)
