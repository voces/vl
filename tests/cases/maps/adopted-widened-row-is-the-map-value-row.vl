// @run
// @log 7
// @log 7
// @log 1
// D671, STRUCT HALF — D461's residue, adopted through a NUMERIC WIDENING instead of a box.
//
// `structIndexOfObj` matches `{ r: 7 }` onto the declared `Circle` row and that adoption
// SUPPRESSES the `#anon` row `collectAnonShapes` would have minted. The adoption is right,
// and the disassembly says so: with no map in the file at all, `const p = { r: 7 }` emits
// `(struct.new $1 (i64.const 7))` over `(struct (field (mut i64)))` — the literal
// re-encodes at the declared width.
//
// The map then asked which row the CHECKER's render of its value names. The render is
// `{r:i32}` (the literal's own inferred type), and `structIndexOfTypeName` refuses `Circle`
// as a PROVEN field-code mismatch: `emitProgram: unsupported map value type`, on a program
// whose value rep the emitter had already got right. Deleting the unused `type Circle` line
// made it run — the same "how load-bearing the disagreement was" `adopted-anon-shape-is-
// the-map-value-row.vl` records for the union-box adopter.
//
// `mvValRowOfShape` applies `anonValueFitsField`'s DECLARED-row tier to the render: a
// declared row's codes are evidence of its ANNOTATION, not of what its literals look like,
// so only the two pairs no adoption can bridge refute. The last `print` is the CONTROL that
// keeps the tier honest — `{r: i32}` beside a declared `{r: i32}` row still places on the
// STRICT scan and never reaches the lenient one.
// `Exact`'s field is deliberately NOT named `r`: a declared `{r: i32}` row in this file
// would place the widened map's render on the STRICT scan and the lenient tier would never
// be asked — the fixture would pass on master and prove nothing. (Verified: with the
// control's field named `r`, this file runs on master `ca1429c0`.)
type Circle = { r: i64 }
type Exact = { q: i32 }

function widened() {
  const c = Map()
  c["k0"] = { r: 7 }
  const g0 = c["k0"] ?? { r: 0 }
  if g0.r == 7 { print(7) } else { print(0) }
}

// The ANNOTATED control, which ran before this landing and must keep running.
function annotated() {
  const c: {[string]: Circle} = Map()
  c["k0"] = { r: 7 }
  const g0 = c["k0"] ?? { r: 0 }
  if g0.r == 7 { print(7) } else { print(0) }
}

// The EXACT-width control: the strict scan places it, so the lenient tier is never asked.
function exact() {
  const e: {[string]: Exact} = Map()
  e["k0"] = { q: 1 }
  const g = e["k0"] ?? { q: 0 }
  print(g.q)
}

widened()
annotated()
exact()
