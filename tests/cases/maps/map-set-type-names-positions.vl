// @run
// @log 1
// @log 2
// @log 7
// @log true
// @log false
// @log three
// @log four
// @log 3.5
// @log 1
// @log 5
// @log 9
// @log 4
// @log deep
// @log 4
// @log 2
// @log x
// @log y
// @hint redundant type annotation: `back` is inferred as `{[string]: f64}`
// `Map<K, V>` is the long spelling of `{[K]: V}` (A15) and `Set<T>` is its own type (owner
// ruling Q2); both are legal wherever a type is written. One position per block, each printing a value that
// proves the map behind the annotation is the one the program wrote to: binding, struct
// field, parameter (fed an index-signature map AND an inferred `Map()`), return (read back
// through an index-signature binding — the annotation is load-bearing, it IS the other
// spelling under test), generic argument, nested value, union member.

// Binding.
const m: Map<string, i32> = Map()
m["a"] = 1
m.set("b", 2)
print(m["a"] ?? -1)
print(m.get("b") ?? -1)

// Struct field — both names.
type Reg = { idx: Map<string, i32>, tags: Set<string> }
const r: Reg = { idx: Map(), tags: Set() }
r.idx.set("main", 7)
r.tags.add("x")
print(r.idx["main"] ?? -1)
print(r.tags.has("x"))
print(r.tags.has("y"))

// Parameter: an index-signature value and an inferred one both flow in.
function put(p: Map<i32, string>, k: i32, v: string) { p[k] = v }
const sig: {[i32]: string} = Map()
put(sig, 3, "three")
print(sig[3] ?? "none")
const inf = Map()
put(inf, 4, "four")
print(inf[4] ?? "none")

// Return, read back through the other spelling.
function mk(): Map<string, f64> {
  const out: Map<string, f64> = Map()
  out["pi"] = 3.5
  out
}
print(mk()["pi"] ?? 0.0)
const back: {[string]: f64} = mk()
print(back.length)

// Generic argument: an alias application and a generic function's element.
type Box<T> = { v: T }
const b: Box<Map<string, i32>> = { v: Map() }
b.v["k"] = 5
print(b.v["k"] ?? -1)
function first<T>(xs: T[]): T { xs[0] }
const ms: Map<string, i32>[] = [Map()]
ms[0]["z"] = 9
print(first(ms)["z"] ?? -1)

// Nested: a list value and a map value.
const lists: Map<string, i32[]> = Map()
lists["xs"] = [1, 2, 3, 4]
print((lists["xs"] ?? []).length)
const nest: Map<i32, Map<i32, string>> = Map()
nest[1] = Map()
const inner = nest[1] ?? Map()
inner[2] = "deep"
print((nest[1] ?? Map())[2] ?? "none")

// Union member, and a set read back as its elements.
let um: Map<string, i32> | null = null
um = Map()
if um != null {
  um["q"] = 4
  print(um["q"] ?? -1)
}
const s: Set<string> = Set()
s.add("x")
s.add("y")
s.add("x")
print(s.length)
for e in s.values() { print(e) }
