// @run
// @log 1024
// @log 7
// @log 2048
// @log 9
// A NEWTYPE over a struct at the map-VALUE position, with a same-shape newtype
// SIBLING — the standing grading shape for the mv layer.
//
// `new` separates ARENA-INDEX identity from REP identity: `FView` and `IView`
// resolve to different `cUserTypes` entries and different `T.tys` indices, and
// `repMvValKey` renders both to the same structural key, so the two maps share one
// mv slot and one map-struct heap type. Every rung that shortcuts a map-value
// name → arena-index resolution has to keep those two facts apart, and the fuzz
// grammar emits no `new` type, so this file is the population.
type FView = new { base: i32, length: i32 }
type IView = new { base: i32, length: i32 }

const fm: { [string]: FView } = Map()
const im: { [string]: IView } = Map()

fm["a"] = { base: 1024, length: 7 }
im["a"] = { base: 2048, length: 9 }

const f = fm["a"]
if f != null {
  print(f.base)
  print(f.length)
}
const i = im["a"]
if i != null {
  print(i.base)
  print(i.length)
}
