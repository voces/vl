// @run
// @log aa
// @log bb
// @log aa
// @log bb
// @log aa
// @log bb
// @log aa
// @log bb
// @log aa
// @log bb
// @log aa
// @log bb
// @log aa
// @log bb
// @log aa
// @log bb
// The METHOD spelling of the fused atom-map read, `m.get(k) ?? <member>`, is the SAME
// lowering as `m[k] ?? <member>` — `emitCoalesce` routes both through `emitMapGetOr` — so it
// must also be the same ATOM at every classifier that keys on the receiver's value type.
// It was not: `exprIsLitAtom`'s `??` arm asked `binLeft is Index` and nothing else, so the
// `.get` half fell through, `print` skipped the atom -> member-text widen, and the read
// printed the RAW ATOM ID (`0` where `aa` is expected) — a SILENT WRONG ANSWER on BOTH key
// reps and for the nullable-atom value (`K | null`) too. Both spellings now resolve the
// receiver through the ONE fused-read shape home (`fusedMapReadRecvIx`).
//
// Every `.get` line below is paired with its `[k]` TWIN, which is the control: the two must
// print identically, hit and miss, for each of {string,i32} key x {K, K | null} value.
type K0 = "aa" | "bb"

function strKeyed() {
  const m: {[string]: K0} = Map()
  m["k"] = "aa"
  print(m.get("k") ?? "bb")  // hit  -> aa   (was: 0)
  print(m.get("zz") ?? "bb") // miss -> bb   (was: 1)
  print(m["k"] ?? "bb")      // the TWIN control
  print(m["zz"] ?? "bb")
}

function i32Keyed() {
  const m: {[i32]: K0} = Map()
  m[7] = "aa"
  print(m.get(7) ?? "bb")
  print(m.get(9) ?? "bb")
  print(m[7] ?? "bb")
  print(m[9] ?? "bb")
}

function strKeyedNullableValue() {
  const m: {[string]: K0 | null} = Map()
  m["k"] = "aa"
  print(m.get("k") ?? "bb")
  print(m.get("zz") ?? "bb")
  print(m["k"] ?? "bb")
  print(m["zz"] ?? "bb")
}

function i32KeyedNullableValue() {
  const m: {[i32]: K0 | null} = Map()
  m[7] = "aa"
  print(m.get(7) ?? "bb")
  print(m.get(9) ?? "bb")
  print(m[7] ?? "bb")
  print(m[9] ?? "bb")
}

strKeyed()
i32Keyed()
strKeyedNullableValue()
i32KeyedNullableValue()
