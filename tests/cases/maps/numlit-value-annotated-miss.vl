// @run
// @log absent
// @log 1
// @log absent
// @log 1.5
// @log false
// @log 1
// @log absent
// @log 9
// @log a
// @log absent
// @log 1
// @log absent

// A MISS ON A NUMERIC-LITUNION-VALUED MAP NARROWS AS ABSENT — the twin of
// `scalar-nullable-read-miss-narrows-absent.vl` for the one value rep that file's fix
// deliberately excluded.
//
// THIS IS THE HALF THE INVENTORY ROW UNDERSTATED. D6 is filed as check-clean INVALID WASM
// on the INFERRED binding, which is loud at load. With the binding ANNOTATED the identical
// map compiled, ran, and printed `0` for a key that was never set:
//
//     const v: N2 | null = m["nope"]
//     if v != null { print(v) } else { print("absent") }   // printed 0
//
// That is #1899's silent wrong answer — `emitMapGet`'s "rep's empty value" boxed under the
// PRESENT tag — surviving in the one value rep #1901's predicate excluded. `vl check` rc 0,
// a module that loads, and a wrong number.
//
// WHY IT SURVIVED. #1901 scoped itself BY REP and excluded every value type carrying its
// own spare "absent": `boolean` (the `2` sentinel), `string` and structs (`ref.null`), and
// litunions (the `-1` sentinel). The last of those is true of the STRING litunion only — an
// interned atom ID leaves every negative spare — and a numeric litunion was swept in with
// it. Its rep is THE NUMBER, so nothing is spare, and `0` is a member of plenty of them.

type N2 = 1 | 2

const m: {[string]: N2} = Map()
m["a"] = 1

// THE BUG. A key that was never set used to print `0`.
// @hint redundant type annotation: `miss` is inferred as `N2 | null`
const miss: N2 | null = m["nope"]
if miss != null { print(miss) } else { print("absent") }
// @hint redundant type annotation: `hit` is inferred as `N2 | null`
const hit: N2 | null = m["a"]
if hit != null { print(hit) } else { print("absent") }

// The FLOAT base, where the empty value is `0.0` and `0.0` is not a member — the read was
// wrong for the same reason, it just could not be caught by inspecting the number.
type F2 = 1.5 | 2.5
const f: {[string]: F2} = Map()
f["a"] = 1.5
// @hint redundant type annotation: `fmiss` is inferred as `F2 | null`
const fmiss: F2 | null = f["nope"]
if fmiss != null { print(fmiss) } else { print("absent") }
// @hint redundant type annotation: `fhit` is inferred as `F2 | null`
const fhit: F2 | null = f["a"]
if fhit != null { print(fhit) } else { print("absent") }

// A LITUNION WHOSE MEMBER SET CONTAINS THE EMPTY VALUE is the sharpest form: `0` is both
// "the rep's empty value" and a legal member, so a stored `0` and a miss are the same bits
// without the box. `+ 1` is there so the stored zero is printed as something other than the
// literal the miss arm would have produced.
type NZ = 0 | 1
const z: {[string]: NZ} = Map()
z["a"] = 0
print(z.has("nope")) // false — the probe was always right
const zhit = z["a"]
if zhit != null {
  print(zhit + 1) // 1 — a STORED zero
} else {
  print("absent")
}
const zmiss = z["nope"]
if zmiss != null {
  print(zmiss + 1) // absent
} else {
  print("absent")
}

// The read that was already correct, as the inverted control.
print(m["nope"] ?? 9) // 9

// THE STRING-LITUNION CONTROL — correct before this change and byte-identical after it.
type K2 = "a" | "b"
const s: {[string]: K2} = Map()
s["a"] = "a"
const shit = s["a"]
if shit != null { print(shit) } else { print("absent") }
const smiss = s["nope"]
if smiss != null { print(smiss) } else { print("absent") }

// THE DECLARED-NULLABLE CONTROL — the map that could always store a null, also unchanged.
//
// INSIDE A FUNCTION DELIBERATELY, and that is now a HISTORICAL note rather than a live
// caveat. The identical five lines at MODULE SCOPE used to compile, load and then TRAP on
// the miss (`wasm trap: null reference`) — filed as D19 in
// `docs/internals/silent-class-inventory.md`, and deliberately unpinned while it was a trap
// because pinning one freezes it as contract. D19 is CLOSED (`emitStartFnCode` grew the
// union-box map-read arm its function-local twin always had), and the module-scope half is
// now pinned as a RUNNING fixture next door in
// `maps/module-scope-union-box-map-read-miss.vl` — which is what a closed trap should be
// held down by. This block stays as the function-scope control it always was.
function declaredNullable() {
  const d: {[string]: N2 | null} = Map()
  d["a"] = 1
  const dhit = d["a"]
  if dhit != null { print(dhit) } else { print("absent") }
  const dmiss = d["nope"]
  if dmiss != null { print(dmiss) } else { print("absent") }
}
declaredNullable()
