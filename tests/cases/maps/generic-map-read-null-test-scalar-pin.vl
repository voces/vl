// @run
// @log true
// @log false
// @log false
// @log true
// @log true
// @log 5
// @log true
// @log 1.5
// @log 5
// @log 0.5
// A generic's map read at a pin that binds the value to a scalar tests its miss as the null:
// `m.get(k) != null`, and a `??` whose `f64` default joins the stored `i32` apart (D10291).
function has<V>(m: Map<string, V>, k: string) {
  print(m.get(k) != null)
  print(m[k] == null)
}
function pick<V>(m: Map<string, V>, k: string, d: f64) { m.get(k) ?? d }
function pickIdx<V>(m: Map<string, V>, k: string, d: f64) { return m[k] ?? d }
const mm: Map<string, i32> = Map()
mm.set("k", 5)
has(mm, "k")
has(mm, "z")
const hit = pick(mm, "k", 1.5)
print(hit is i32)
print(hit)
const miss = pick(mm, "z", 1.5)
print(miss is f64)
print(miss)
print(pickIdx(mm, "k", 0.5))
print(pickIdx(mm, "z", 0.5))
