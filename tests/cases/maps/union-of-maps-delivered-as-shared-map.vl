// A union whose members all share one map's storage is delivered as that map by unboxing its
// payload, at a parameter, a binding, a return and a list, record or map-value slot (D2692).
function take(m: {[string]: boolean | null}) { m.length }
const a: {[string]: boolean} = Map()
const u: {[string]: boolean} | {[string]: boolean | null} = a
print(take(u))
const s: {[string]: string} = Map()
s["k"] = "x"
const us: {[string]: string} | {[string]: string | null} = s
const w: {[string]: string | null} = us
print(w.length)
const x = w["k"]
if x != null { print(x) }
function back(
  v: {[string]: string} | {[string]: string | null},
): {[string]: string | null} {
  v
}
const b = back(us)
print(b.length)
const xs: {[string]: string | null}[] = [us]
print(xs[0].length)
type H = { m: {[string]: string | null} }
const h: H = { m: us }
print(h.m.length)
const hm: {[string]: {[string]: string | null}} = Map()
hm["p"] = us
const got = hm["p"]
if got != null { print(got.length) }
const f = (): boolean => w.has("k")
print(f())
