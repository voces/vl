// @run
// @log 8
// @log 8
// @log true
// @log 14
// @log 7
// @log 0
// @log missing q
// @log 5
// @log 0
// @log missing c
// @log 3
// @hint redundant type annotation: `take` is inferred as `i64`
// @hint redundant type annotation: `get` is inferred as `i64`
// @hint redundant type annotation: `w` is inferred as `i64`
// @hint redundant type annotation: `l` is inferred as `i64`
// @hint redundant type annotation: `v` is inferred as `f64`
// A `!= null` test narrows an `i64` or `f64` map read itself, as an `i32` one does; a stored
// `0` stays present and a missing key stays missing (D9630). The `i32` map is the control.
const m: { [string]: i64 } = Map()
m["k"] = 7
m["z"] = 0
function take(v: i64): i64 { v * 2 }
function get(mm: { [string]: i64 }): i64 {
  if mm["k"] != null { return mm["k"] }
  -1
}
if m["k"] != null {
  const w: i64 = m["k"]
  let l: i64 = m["k"]
  l = l + 1
  print(w + 1)
  print(l)
  print(m["k"] > 3)
  print(take(m["k"]))
}
print(get(m))
if m["z"] != null { print(m["z"]) } else { print("missing z") }
if m["q"] != null { print(m["q"]) } else { print("missing q") }
const fm: { [string]: f64 } = Map()
fm["a"] = 2.5
fm["b"] = 0.0
if fm["a"] != null {
  const v: f64 = fm["a"]
  print(v * 2.0)
}
if fm["b"] != null { print(fm["b"]) } else { print("missing b") }
if fm["c"] != null { print(fm["c"]) } else { print("missing c") }
const im: { [string]: i32 } = Map()
im["n"] = 3
if im["n"] != null {
  const n = im["n"]
  print(n)
}
