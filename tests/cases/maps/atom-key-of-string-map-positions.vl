// @run
// @log 3
// @log 4
// @log true
// @log 1
// @log 5
// @log 0
// @log 7
// A literal-union value as the key of a string-keyed map, decoded to its member text at each map
// operation: `.set`, an index store, `.get`, an index read under `??`, `.has` and `.delete`, from a
// parameter, a record field, a narrowed local and at the top.
type K = "red" | "green"
type R = { k: K, n: i32 }
function viaSet(a: K) {
  const m = Map<string, i32>()
  m.set(a, 3)
  return m.get("green") ?? 0
}
function viaIndex(r: R) {
  const m = Map<string, i32>()
  m[r.k] = r.n
  return m[r.k] ?? 0
}
function viaHas(a: K) {
  const m = Map<string, i32>()
  m["red"] = 1
  return m.has(a)
}
function viaNarrowed(x: K | null) {
  const m = Map<string, i32>()
  m["green"] = 1
  if x != null { return m.get(x) ?? 0 }
  return -1
}
print(viaSet("green"))
print(viaIndex({ k: "red", n: 4 }))
print(viaHas("red"))
print(viaNarrowed("green"))
const top = Map<string, i32>()
const key: K = "red"
top.set(key, 5)
print(top[key] ?? 0)
top.delete(key)
print(top.get(key) ?? 0)
top[key] = 7
print(top.get("red") ?? 0)
