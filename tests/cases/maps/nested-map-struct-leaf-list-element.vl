// @run
// @log 4
// @log 4
// @log 4
// @log 4
// @log 4
// @log 4
// @log 4
// @log 4
// The annotation on case 4 is the row's own control and is deliberately kept.
// @hint redundant type annotation: `held4` is inferred as `{[string]: {[string]: Rec}}`
// @hint redundant type annotation: `vs` is inferred as `{[string]: {[string]: Rec}}[]`
// D1786 — a ref-list element that is a map interns its element row, and the mv row for that
// element's VALUE was minted by the value's own first op instead — which can fall between
// the frame-layout pass and the emit pass, so the value-slot find answered `-3` to one and
// the real slot to the other. Minting it beside the element row is what makes both passes
// read one answer.

type Rec = { n: i32 }
function mki(): { [string]: Rec } {
  const m: { [string]: Rec } = Map()
  m["k"] = { n: 4 }
  return m
}
function mko(): { [string]: { [string]: Rec } } {
  const o: { [string]: { [string]: Rec } } = Map()
  o["o"] = mki()
  return o
}

// 1 — the witness: an un-annotated list of nested maps, read at module scope.
const xs = [mko()]
const held = xs[0]
print(((held["o"] ?? Map())["k"] ?? { n: 0 }).n)

// 2 — THE PAIR: a shallow-map list beside the nested one, in this same module. A candidate
// that fixes only the nested element loses this — the shallow list runs on its own and stops
// running once a nested-map list is present, which neither the grid nor byte-identity sees.
const ds = [mki()]
const held2 = ds[0]
print((held2["k"] ?? { n: 0 }).n)

// 3 — the same nested read inside a function body, where the locals vector is what desynced.
function go() {
  const ys = [mko()]
  const held3 = ys[0]
  print(((held3["o"] ?? Map())["k"] ?? { n: 0 }).n)
}
go()

// 4 — the ANNOTATED binding, which refused too: the face is not the ingredient.
function goAnn() {
  const ws = [mko()]
  const held4: { [string]: { [string]: Rec } } = ws[0]
  print(((held4["o"] ?? Map())["k"] ?? { n: 0 }).n)
}
goAnn()

// 5 — captured, the face whose refusal was `arity has no interned signature` rather than the
// locals desync: one coordinate, three sentences.
function goCap() {
  const zs = [mko()]
  const held5 = zs[0]
  const get = () => held5
  print(((get()["o"] ?? Map())["k"] ?? { n: 0 }).n)
}
goCap()

// 6 — the annotated ARRAY, a control that ran at both seeds: its element name keeps the
// declared `Rec`, so its value slot resolved on the first ask.
const vs: { [string]: { [string]: Rec } }[] = [mko()]
const held6 = vs[0]
print(((held6["o"] ?? Map())["k"] ?? { n: 0 }).n)

// 7 — a STRING leaf, the control that bounds the ingredient: a value whose mv row is interned
// early enough that the find never answered "unsupported".
function mkis(): { [string]: string } {
  const m: { [string]: string } = Map()
  m["k"] = "4"
  return m
}
function mkos(): { [string]: { [string]: string } } {
  const o: { [string]: { [string]: string } } = Map()
  o["o"] = mkis()
  return o
}
const ss = [mkos()]
const held7 = ss[0]
print((held7["o"] ?? Map())["k"] ?? "0")

// 8 — a shallow map of a DIFFERENT value type beside the nested one, so the pair in case 2
// is not merely "two map lists".
type Dot = { q: i32 }
function mkd(): { [string]: Dot } {
  const d: { [string]: Dot } = Map()
  d["k"] = { q: 4 }
  return d
}
const es = [mkd()]
const held8 = es[0]
print((held8["k"] ?? { q: 0 }).q)
