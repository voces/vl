// A `u8[]` list literal delivered into a map's value slot builds the packed byte list, by an
// index store, a `.set`, a record's map field and a `??` default (D2255, from consumer plumb
// PL-025); the map's `.values()` loop binds it too. A literal assigned to a `u8[]` local
// builds it as well (D2256).

function inFunction() {
  const m: {[i32]: u8[]} = Map()
  m[3] = [1, 2]
  m.length
}
print(inFunction())

const byIndex: {[string]: u8[]} = Map()
byIndex["a"] = [1, 200]
byIndex.set("b", [7])
const a = byIndex.get("a")
if a != null {
  print(a[1])
  a[0] = a[1] + 100
  print(a[0])
}
print(byIndex.length)
for v in byIndex.values() { print(v.length) }

type Holder = {m: {[i32]: u8[]}}
const h: Holder = { m: Map() }
h.m[1] = [3, 250]
const hv = h.m.get(1)
if hv != null { print(hv[1]) }

const d = byIndex["zz"] ?? [9, 8, 7]
print(d.length)
const e = byIndex.get("a") ?? []
print(e[1])

const nullable: {[i32]: u8[] | null} = Map()
nullable[1] = [5]
print(nullable.length)
const nv = nullable.get(1)
if nv != null { print(nv[0] + 2) }
nullable[2] = null
for w in nullable.values() { print(w != null) }

function assignLocal() {
  let bytes: u8[] = [1]
  bytes = [1, 200]
  bytes[1]
}
print(assignLocal())
