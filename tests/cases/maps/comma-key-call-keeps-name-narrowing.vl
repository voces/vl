// @run
// @log 2
// A call that writes the key `,x,` retires that key's narrowing and leaves the narrowing of
// the name `x` (D6441).
const m: {[string]: i32 | null} = Map()
m[",x,"] = 2
function clr() { m[",x,"] = null }
function run(x: i32 | null) {
  if x != null && m[",x,"] != null {
    clr()
    print(x + 1)
  }
}
run(1)
