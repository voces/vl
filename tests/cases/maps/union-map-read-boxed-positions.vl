// @run
// @log 5
// @log null
// @log two
// @log null
// @log two
// @log null
// @log 5
// @log two
// @log null
// @log 5
// @log 5
// @log null
// @log two
// @log 5
// @log false
// Q58 position sweep: a read of a map whose values are a union, delivered into a union box, which
// is the stored box (a miss the null-tagged box): into the map's own union and a wider one, as a
// call argument, a return, an annotated `let`, an assignment, a record field, a list element, an
// `if` arm value, a `??` default and a `??` operand.
type U = i32 | string | null
type W = i32 | string | boolean | null
type R = { u: U, w: W }
function showU(u: U) { print(u) }
function showW(w: W) { print(w) }
function retU(m: {[i32]: U}, k: i32): U { return m[k] }
function retW(m: {[i32]: U}, k: i32): W { return m[k] }
function main() {
  const m: {[i32]: U} = Map()
  m[1] = 5
  m[2] = "two"
  m[3] = null
  showU(m[1])
  showU(m[9])
  showW(m[2])
  showW(m[3])
  showU(retU(m, 2))
  showW(retW(m, 9))
  const a: W = m[1]
  showW(a)
  let b: W = true
  b = m[2]
  showW(b)
  const r: R = { u: m[3], w: m[1] }
  showU(r.u)
  showW(r.w)
  const xs: W[] = [m[1], m[9]]
  showW(xs[0])
  showW(xs[1])
  const k = 2
  const c = if k == 2 { m[2] } else { false }
  showW(c)
  const d: W = m[9] ?? m[1]
  showW(d)
  const e: W = m[3] ?? false
  showW(e)
}
main()
