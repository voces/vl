// @run
// @log 1
// @log 20
// @log 30
// @log true
// @log true
// @log 101
// @log 202
// @log 303
// Maps whose keys differ in rep are distinct union members with distinct box tags, so `is` and
// `match` each recover the struct the member names. `{[i32]: i32} | {[string]: i32}` was
// check-clean invalid wasm before the integer-keyed mono maps took their own tags (D2519).
function show(x: {[i32]: i32} | {[string]: i32} | {[i64]: i32}) {
  match x {
    {[i32]: i32} => print(x.get(1) ?? -1)
    {[string]: i32} => print(x.get("k") ?? -1)
    {[i64]: i32} => print(x.get(4294967297) ?? -1)
  }
}
const a: {[i32]: i32} = Map()
a.set(1, 1)
const b: {[string]: i32} = Map()
b.set("k", 20)
const c: {[i64]: i32} = Map()
c.set(4294967297, 30)
show(a)
show(b)
show(c)
function f(x: Set<i32> | {[string]: boolean}) {
  if x is Set<i32> { print(x.has(3)) } else { print(x.get("b") ?? false) }
}
const s: Set<i32> = Set()
s.add(3)
const m: {[string]: boolean} = Map()
m.set("b", true)
f(s)
f(m)
function g(x: Set<i32> | Set<string> | Set<i64>) {
  if x is Set<i32> { print(x.length + 100) }
  else if x is Set<string> { print(x.length + 200) }
  else { print(x.length + 300) }
}
const t: Set<string> = Set()
t.add("a")
t.add("b")
const w: Set<i64> = Set()
w.add(4294967297)
w.add(1)
w.add(2)
g(s)
g(t)
g(w)
