// @run
// @log 2
// A bound `.values()` off a map field of an `is`-narrowed declared-union arm reserves its
// scratch frame and builds the list (D1805's field receiver).
type Hits = { h: {[i32]: i32} }
type Miss = { m: i32 }
type Ev = Hits | Miss

const e: Ev = { h: Map() }
if e is Hits {
  e.h[11] = 3
  e.h[22] = 4
  const vs = e.h.values()
  print(vs.length)
}
