// @run
// @log 7
// @log 7
// @log 2.5
// A map binding of un-annotated functions nothing calls directly, pushed onto or set into an
// annotated holder, takes the holder's function type for its values (D15752).
function inc0(a) { return a + 1 }
const fnMap = Map()
fnMap.set("a", inc0)
const xs: ({ [string]: (a: f64) => f64 })[] = []
xs.push(fnMap)
const f = xs[0].get("a")
if f != null { print(f(6)) }

function inc1(a) { return a + 1 }
const m1 = Map()
m1.set("a", inc1)
const m: { [string]: { [string]: (a: f64) => f64 } } = Map()
m.set("k", m1)
const i = m.get("k")
if i != null {
  const g = i.get("a")
  if g != null { print(g(6)) }
}

function half(a) { return a / 2.0 }
const m2 = Map()
m2.set("h", half)
const ys: ({ [string]: (a: f64) => f64 })[] = []
ys.push(m2)
const h = ys[0].get("h")
if h != null { print(h(5)) }
