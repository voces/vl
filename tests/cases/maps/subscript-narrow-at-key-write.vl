// @run
// @log 2
// A callee writing a key that starts with `@` writes that one cell, so a narrowing of a
// different key survives the call (D6401).
function clr(m: {[string]: i32 | null}) { m["@x"] = null }

const m: {[string]: i32 | null} = Map()
m["ab"] = 1
if m["ab"] != null {
  clr(m)
  print(m["ab"] + 1)
}
