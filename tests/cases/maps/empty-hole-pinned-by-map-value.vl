// @run
// @log 0
// @log 0
// @log 0
// @log 0
// @log 1
// AN EMPTY `[]` STORED INTO A MAP VALUE, from a producer with no annotation of its own — the
// filed D18 repro (docs/internals/silent-class-inventory.md) and the three other spellings of
// the same write. `vl check` exited 0 with no diagnostic, the module was written, and the
// engine refused it: `type mismatch: expected (ref null $type), found (ref $type)` — the i32
// list wrapper the unpinned hole defaults to, stored into an `f64[]`-valued cell.
//
// The map-value position now pins the hole the way an ARRAY-element destination always did
// (`const xss: f64[][] = [fq()]` has never been red): `constrainEmpty` recurses through the
// map's VALUE and through a struct FIELD, and the two WRITE spellings — `m[k] = v` and
// `m.set(k, v)` — pin identically, which is the rule the map arms already state for their key
// and value HOLES one screen up.
//
// The cross-container legs live in `tests/cases/arrays/empty-hole-pinned-by-container-position.vl`
// (21 positions x 11 element reps); this file is the map-shaped subset, kept where a reader
// looking at the map corpus will find it.
//
// The legs:
//   L1  `m[k] = fq()` — D18's own program, verbatim but for the producer name.
//   L2  `m.set(k, fq())` — the method spelling of the same store.
//   L3  a map whose value is a STRUCT carrying the hole, written through the index.
//   L4  a NESTED map (`{[string]: {[string]: string[]}}`) reached through a bound inner map.
//   L5  the DIRECT `[]` control, which lowered before this change and still does.

type W = { xs: string[] }

function fq() {
  return []
}

function fs() {
  return []
}

function fw() {
  return []
}

function fn() {
  return []
}

// L1 — the filed repro.
const m: {[string]: f64[]} = Map()
m["a"] = fq()
print((m["a"] ?? [1.0]).length)

// L2 — the `.set` spelling.
const ms: {[string]: string[]} = Map()
ms.set("a", fs())
print((ms["a"] ?? ["x"]).length)

// L3 — a struct-valued map carrying the hole in a field.
const mw: {[string]: W} = Map()
mw["a"] = { xs: fw() }
print((mw["a"] ?? { xs: ["z"] }).xs.length)

// L4 — a nested map's inner value.
const inner: {[string]: string[]} = Map()
inner["b"] = fn()
const outer: {[string]: {[string]: string[]}} = Map()
outer["a"] = inner
print((inner["b"] ?? ["y"]).length)

// L5 — the direct-literal control.
const md: {[string]: f64[]} = Map()
md["a"] = []
print(md.size)
