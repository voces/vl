// @run
// @log 1
// @log 1
// @log 1

// A union of maps stored into a container slot whose value is wider is not refused by the store
// that delivers it, at `.set`, an index store and `.push`.

const s: {[string]: string} = Map()
s["k"] = "x"
const us: {[string]: string} | {[string]: string | null} = s
const hm: {[string]: {[string]: string | null}} = Map()
hm.set("p", us)
print(hm.length)
const hi: {[string]: {[string]: string | null}} = Map()
hi["q"] = us
print(hi.length)
const xs: {[string]: string | null}[] = []
xs.push(us)
print(xs.length)
