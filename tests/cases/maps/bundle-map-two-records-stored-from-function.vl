// A bundle of another signature set stored into a module map from inside a function: the value
// slot is the union of the two records, and the key test reads no value (D17106).
// @run
// @log true
// @hint Intentionally-unused variable `_a`
// @hint Intentionally-unused variable `_b`
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
function lap2(f) {
  const _a = f(1.5)
  const _b = f(true)
  return f
}
const m = Map()
m["a"] = lap((a) => a + 1)
function g() {
  m["b"] = lap2((a) => a)
  return m.has("a")
}
print(g())
