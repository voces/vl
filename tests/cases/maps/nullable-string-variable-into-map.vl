// D2596: a `string | null` VARIABLE stored into a `{[string]: string | null}` map keeps its
// null. The store read the variable as a non-null string, which trapped on the null a bare
// `null` literal already stored. Every write spelling and scope, and the generic reach.
function mk(b: boolean): string | null {
  if b { return null }
  "z"
}

const m: {[string]: string | null} = Map()
const x: string | null = null
m["k"] = x
print(m.has("k"))
print(m["k"])
m.set("j", mk(false))
print(m["j"])
let y: string | null = "q"
y = null
m["i"] = y
print(m.length)
print(m["i"])

function f<T>(v: T): {[string]: T} {
  const n = Map()
  n["k"] = v
  n
}
print(f(x)["k"])

type H = { m: {[string]: string | null} }
function inFunction() {
  const h: H = { m: Map() }
  const v = mk(true)
  h.m["k"] = v
  print(h.m.has("k"))
  print(h.m["k"])
}
inFunction()
