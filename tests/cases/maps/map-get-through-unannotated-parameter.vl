// @run
// @log 7
// @log 7
// @log 7
// @log 7
// @log 7
// @log 0
// @log true
// @log s
// A map `.get` read through an un-annotated parameter is the index read wherever the instance
// types the receiver as a map: a field, a nested field, a list element's field, a local copy of
// the map or of the parameter, a missing key and a bound miss (D15153, D3414).
type R = { r: i32 }
type A = { g: Map<string, R> }
type Q = { o: A }
const g: Map<string, R> = Map()
g.set("x", { r: 7 })
const x: A = { g: g }
function field(a) { print(a.g.get("x")?.r ?? 0) }
function nested(a) { print(a.o.g.get("x")?.r ?? 0) }
function elem(a) { print(a[0].g.get("x")?.r ?? 0) }
function localMap(a) {
  const m = a.g
  print(m.get("x")?.r ?? 0)
}
function localParam(a) {
  const v = a
  print(v.g.get("x")?.r ?? 0)
}
function miss(a) { print(a.g.get("zz")?.r ?? 0) }
function bound(a) {
  const v = a.g.get("zz")
  print(v == null)
}
function strs(a) { print(a.g.get("x") ?? "-") }
field(x)
nested({ o: x })
elem([x])
localMap(x)
localParam(x)
miss(x)
bound(x)
const sg: Map<string, string> = Map()
sg.set("x", "s")
strs({ g: sg })
