// @run
// @log 4
// A binding holding a literal of a declared record's own fields, set into a map of a wider
// record, is stored at the map's value row (D3350).
type O = { v: i32 }
type I = { f: O }
type J = { f: O | null }
const s = { f: { v: 4 } }
const m = Map<string, J>()
m.set("a", s)
const x = m.get("a") ?? { f: { v: 9 } }
print(x.f?.v ?? 70)
