// @run
// @log 55
// @log first
// @log 42
// AN INFERRED STRUCT FIELD HOLDING A NULLABLE MAP (D1665).
//
// The anonymous-literal mint codes a nullable REF field through a niche rung that peels the
// recorded `TyNullable` and codes its inner. Its map arm was empty, so `{ f: mkI() }` took no
// field code, minted no row, and the global's cell asked for a struct shape that was never
// interned. The field codes 29 now — a nullable ref to the value type's mv struct, the rep
// the declared `{[string]: i32} | null` spelling already had.
//
// The three holders share the field name `f` and two of them disagree about the map's VALUE
// type, which is what the printed values prove: an mv slot's identity is its (key, value)
// pair, so three rows that match on names and codes alone would put a `string`-valued map in
// an `i32`-valued slot. `first` coming back as a string is that guard holding.
function mkI(): { [string]: i32 } | null {
  const m: { [string]: i32 } = Map()
  m["k"] = 55
  return m
}
function mkS(): { [string]: string } | null {
  const m: { [string]: string } = Map()
  m["k"] = "first"
  return m
}
function mkJ(): { [string]: i32 } | null {
  const m: { [string]: i32 } = Map()
  m["k"] = 42
  return m
}
const wi = { f: mkI() }
const vi = wi.f
if vi != null { print(vi["k"]) }
const ws = { f: mkS() }
const vs = ws.f
if vs != null { print(vs["k"]) }
const wj = { f: mkJ() }
const vj = wj.f
if vj != null { print(vj["k"]) }
