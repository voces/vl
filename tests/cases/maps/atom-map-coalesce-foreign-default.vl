// D7448: `??` over a read off an atom-valued map takes a default its atom cannot hold, a
// string or a nullable string, and the result is that default's string type.
// @run
// @log b
// @log dflt
// @log dflt
// @log zz
// @log a
// @log b
// @log miss
// @log rnull
// @log b
// @log nn
// @log b
// @log 1
// @log a
// @log none
// @log circle
// @log none
// @log null
// @log b
// @hint redundant type annotation: `s` is inferred as `string`
// @hint redundant type annotation: `k` is inferred as `K`
// @hint redundant type annotation: `f` is inferred as `string`
// @hint redundant type annotation: `r2` is inferred as `string | null`
type K = "a" | "b"
const m: {[string]: K} = Map()
m["x"] = "b"
const d = "dflt"
print(m.get("x") ?? "none")
print(m.get("q") ?? d)
print(m["q"] ?? d)
const s: string = m["q"] ?? "zz"
print(s)
const k: K = m["q"] ?? "a"
print(k)
function f(mm: {[string]: K}, key: string): string { mm[key] ?? "miss" }
print(f(m, "x"))
print(f(m, "y"))
const n: string | null = null
const r = m["q"] ?? n
print(r ?? "rnull")
const r2: string | null = m["x"] ?? n
print(r2 ?? "rnull")
const mn: {[string]: K | null} = Map()
mn["x"] = null
print(mn["x"] ?? "nn")
print(mn["x"] ?? m["x"] ?? "nn")
print((mn["x"] ?? "c").length)
const m3: {[string]: "a" | "b" | null} = Map()
m3["a"] = "a"
print(m3["a"] ?? "none")
print(m3["c"] ?? "none")
const m4: {[string]: "circle" | null} = Map()
m4["a"] = "circle"
print(m4["a"] ?? "none")
print(m4["z"] ?? "none")
type R = { m: {[i32]: K} }
function mk(): R {
  const mm: {[i32]: K} = Map()
  mm[3] = "b"
  { m: mm }
}
function use(p: R) {
  print(p.m[9] ?? p.m[8] ?? p.m[7])
  print(p.m[9] ?? p.m[3] ?? p.m[7])
}
use(mk())
