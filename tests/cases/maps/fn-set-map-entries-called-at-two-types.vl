// @run
// @log 4
// @log 3
// @log 3
// @log 3.5
// @log 8
// @log 2.5
// @log 4
// @log 6
// @log 6
// A map whose entries are written with two un-annotated functions holds one set of them, so an
// entry read through `??` calls the member it holds at each call's own arguments. The annotated
// face holds closures of the declared type and reads `.get` through a `null` test.
function inc(x) { return x + 1 }
function dbl(x) { return x + x }
const m = Map()
m["a"] = inc
m["b"] = dbl
print((m["b"] ?? inc)(2))
print((m["b"] ?? inc)(1.5))
const f = m["a"] ?? dbl
print(f(2))
print(f(2.5))
const n = Map()
n.set("a", inc)
n.set("b", dbl)
print((n["b"] ?? inc)(4))
print((n["z"] ?? inc)(1.5))

function inc2(x: i32) { return x + 1 }
function dbl2(x: i32) { return x + x }
const am: Map<string, (x: i32) => i32> = Map()
am.set("a", inc2)
am.set("b", dbl2)
const g = am.get("b")
if (g != null) { print(g(2)) }
am["c"] = dbl2
print((am["c"] ?? inc2)(3))
print((am["z"] ?? inc2)(5))
