// D8361's annotated face: the read is declared `C | null`, so the identity's instance is the
// record's nullable ref and the map value stores it as it stands.
type C = { a: i32, b: i32 }
function id<T>(x: T): T { x }
const nn: C | null = null
const m: { [string]: C | null } = Map()
m.set("k", id(nn))
print(m.get("k") == null)
m["j"] = id(nn)
print(m["j"] == null)
const t: C | null = id(nn)
m.set("t", t)
print(m.get("t") == null)
