// D2505: every value kind over an i64 key. Each map takes two keys that share their low 32 bits,
// overwrites one, reads a hit, a miss and the other key, deletes one and walks the rest, so a
// value rep crossed with the i64 key's struct shows as a wrong value, not only a trap.
type P = { x: i32, y: string }

const K1 = 4294967301
const K2 = 5

function scalars() {
  const a: {[i64]: i32} = Map()
  a[K1] = 1
  a[K2] = 2
  a[K1] = 3
  print(a[K1] ?? -1)
  print(a[K2] ?? -1)
  print(a[9] ?? -1)
  const b: {[i64]: i64} = Map()
  b.set(K1, 9000000000)
  b.set(K2, -9000000000)
  print((b[K1] ?? 0) + (b[K2] ?? 0))
  const c: {[i64]: f64} = Map()
  c[K1] = 0.5
  c[K2] = 2.25
  print((c[K1] ?? 0.0) + (c.get(K2) ?? 0.0))
  const d: {[i64]: boolean} = Map()
  d[K1] = true
  print(d[K1] ?? false)
  print(d[K2] ?? false)
}

function refs() {
  const s: {[i64]: string} = Map()
  s[K1] = "one"
  s[K2] = "two"
  s.delete(K1)
  for k, v in s { print(v) }
  const r: {[i64]: P} = Map()
  r[K1] = { x: 1, y: "p1" }
  r[K2] = { x: 2, y: "p2" }
  const r1 = r[K1] ?? { x: 0, y: "none" }
  print(r1.y)
  const r9 = r[K1 + 1] ?? { x: 0, y: "none" }
  print(r9.y)
  const l: {[i64]: i32[]} = Map()
  l[K1] = [1, 2, 3]
  l[K2] = [4]
  const l1 = l[K1] ?? []
  const l2 = l[K2] ?? []
  print(l1.length * 10 + l2[0])
  const f: {[i64]: (i64) => i64} = Map()
  f[K1] = (x: i64) => x * 2
  f[K2] = (x: i64) => x + K1
  const f1 = f[K1] ?? ((x: i64) => x)
  const f2 = f.get(K2) ?? ((x: i64) => x)
  print(f1(21))
  print(f2(1))
}

function nullables() {
  const n: {[i64]: string | null} = Map()
  n[K1] = null
  n[K2] = "set"
  print(n.has(K1))
  print(n[K1] ?? "stored-null")
  print(n[K2] ?? "stored-null")
  print(n[7] ?? "missing")
  for v in n.values() { print(v ?? "null-value") }
  const q: {[i64]: i32 | null} = Map()
  q[K1] = null
  q[K2] = 4
  print(q[K1] ?? -1)
  print(q[K2] ?? -1)
  print(q.length)
}

function nested() {
  const outer: {[i64]: {[i64]: string}} = Map()
  const inner: {[i64]: string} = Map()
  inner[K2] = "deep"
  outer[K1] = inner
  const got = outer[K1] ?? Map()
  print(got[K2] ?? "?")
  print(got[K1] ?? "?")
}

scalars()
refs()
nullables()
nested()
