// @error argument 1: parameter is indexed with an i32, which is ambiguous between an array and an i32-keyed map — add a type annotation
// @error-at 16
// AN i32 INDEX ON AN UN-ANNOTATED PARAMETER IS AMBIGUOUS, and the ambiguity is the ruling.
// `q[1]` fits `i32[]` and `{[i32]: V}` alike; a STRING index fits only a map, which is why
// that spelling infers (`infer-through-param-write.vl`) and this one does not.
//
// The body is checked as the ARRAY — its element is a derived hole resolved through
// `TyArray` — so accepting an i32-keyed map argument here emits an array read over a map ref.
// Measured before this floor: `{[i32]: boolean}` printed its value through the i32 formatter
// the array reading chose, `vl check`-clean and SILENTLY WRONG. Deciding it from the argument
// is backward flow (ROADMAP E5); annotating either side runs.
function takeAt(q) {
  print(q[1] ?? false)
}
const m: {[i32]: boolean} = Map()
m[1] = true
takeAt(m)
