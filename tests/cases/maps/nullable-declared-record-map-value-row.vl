// @run
// @log x
// @log n
// A map whose value is a declared record behind `| null` keys its value slot at that record's
// own row: the non-null part names it, with no field-set scan (join-row J-A1).
type Box = { f: string }
const nm: {[string]: Box | null} = Map()
nm["a"] = { f: "x" }
print(nm["a"]?.f ?? "n")
print(nm["b"]?.f ?? "n")
