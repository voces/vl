// @run
// @log 2
// @log none
// @log false
// @log true
// @log false
// @log true
// A map whose value is a nullable closure binds each walked value at the nullable closure, so a
// stored null reads as null instead of trapping, in both walk spellings and through a narrowing.
const n: {[i32]: ((i32) => i32) | null} = Map()
n[1] = (x: i32) => x + 1
n[2] = null
for k, f in n {
  if f != null { print(f(k)) } else { print("none") }
}
for f in n.values() { print(f == null) }
const un: {[i32]: ((i32) => i32) | null} | string = n
if un is {[i32]: ((i32) => i32) | null} {
  for k, f in un { print(f == null) }
}
