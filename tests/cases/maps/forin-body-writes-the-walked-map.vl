// @run
// @log 40
// @log 1560
// @log 20
// @log 20
// A walk whose body writes the map it walks, in the two cases the map's contract settles:
// overwriting a visited key's value (the walk visits each key once and the new values
// stand), and deleting a key the walk has not reached yet (a deleted entry is skipped,
// like any tombstone). Inserting new keys, or deleting enough to compact the walked map,
// is not pinned here.
import { toString } from "std:fmt"

const m: {[string]: i32} = Map()
for i in 0 until 40 { m["k" + toString(i)] = i }

// L1 — overwrite during the walk.
let n1 = 0
for k, v in m { m[k] = v * 2; n1 = n1 + 1 }
let s1 = 0
for k, v in m { s1 = s1 + v }
print(n1)
print(s1)

// L2 — delete ahead of the cursor: every odd key goes before the walk reaches it.
const m2: {[string]: i32} = Map()
for i in 0 until 40 { m2["k" + toString(i)] = i }
let n2 = 0
for k, v in m2 {
  if v % 2 == 0 { m2.delete("k" + toString(v + 1)) }
  n2 = n2 + 1
}
print(n2)
print(m2.size)
