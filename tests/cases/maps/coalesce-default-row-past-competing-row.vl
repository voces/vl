// @run
// @log 7
// @log -1
// @log s
// @log 7
// @log -1
// @log s
// @log 3
// @log -1
// @warning Unused function `sink` (prefix with `_` to suppress, remove it, or `export` it)
// @hint Intentionally-unused parameter `_x` (leading `_` marks it unused)
// CONTRACT (must-RUN): D804's merged row is minted even when a NARROWER same-field-set row
// already exists, and the map the pair flows through takes the merged row as its VALUE.
//
// THE COMPETING ROW IS THREE LINES THE PROGRAM NEVER USES. `type R = { r: i32 }`, declared
// and never mentioned again, is enough: it is interned by `collectS` BEFORE
// `collectAnonShapes` runs, both `??` operands match it by field-name set (a bare `null`
// value matches anything — `anonValueFitsField`'s `vc < 0` leniency), and D804's merge is
// then gated out by its own `structIndexOfObj(ow) >= 0` line. The gate's comment stated the
// assumption that fails: "a sibling a DECLARED row already claims never lands here — and if
// one did, this literal would have matched that row too and no mint would be running."
// Exactly true, and exactly the problem. `silent-class-inventory` D833, twelve cells.
//
// TWO HALVES, AND EACH ONE IS A SEPARATE RUNG (the ablation is in D841's row).
//   · the FAMILY (`anonLeafJoinFamily`) — the sibling scan's "already claimed" skip is
//     lifted for, and only for, the literals the `??` makes ONE value: its default, and the
//     literals stored into the container its left operand reads. Without it the `_str`
//     blocks below are `check-clean invalid wasm` / a loud reject.
//   · the SUPERSEDE (`anonLeafSupersede`) — the map's value slot resolves its struct row by
//     rendering the checker's inferred value type (`{r: i32}`) and looking the render up,
//     which names `R` exactly. Without it the vals array is emitted over `R` and the merged
//     literal cannot be stored into it: the `_i32` competing-row blocks stay exactly as
//     master had them.
//
// THE FAMILY IS A DATAFLOW QUESTION AND NOT A FIELD-SET ONE, and that is what
// `distilled/named/d841_hazard_declared_dest.vl` pins: `const x: R = { r: "a" }` shares the
// field set with an unrelated `??` over `{r: i32}` and must keep `R`. Taking the field set
// as the family took that program from `runs` to invalid wasm — measured, not feared.
//
// THE DECLARED SPELLING OF THE SAME SHAPE STAYS BYTE-IDENTICAL. `type R = { r: i32 | null }`
// beside the pair has always run, because both literals match `R` and `R`'s field IS the
// box; `anonRowServesLeafSet` is the test that keeps it that way, and without it
// `coalesce-default-leaf-shape-merge.vl` compiles to different bytes (one corpus module
// DIFFER, and `cmp` is the only instrument that sees it).

// ---- the ALIAS carrier: a `type` declared and never used ----
type R = { r: i32 }

function rd(k: string) {
  const c = Map()
  c["k1"] = { r: 7 }
  const g1 = (c)[k] ?? { r: null }
  if g1.r != null { print(g1.r) } else { print(-1) }
}
rd("k1") // 7   — the stored literal, boxed as the i32 atom
rd("miss") // -1  — the default, boxed as the null atom

function rs() {
  const c = Map()
  c["k1"] = { r: 7 }
  const g1 = (c)["miss"] ?? { r: "s" }
  print(g1.r)
}
rs() // s

// ---- the PARAMETER-ANNOTATION carrier: an inline `{r: i32}` on a function never called ----
function sink(_x: { r: i32 }) { print(1) }

function pd(k: string) {
  const c = Map()
  c["k1"] = { r: 7 }
  const g1 = (c)[k] ?? { r: null }
  if g1.r != null { print(g1.r) } else { print(-1) }
}
pd("k1") // 7
pd("miss") // -1

function ps() {
  const c = Map()
  c["k1"] = { r: 7 }
  const g1 = (c)["miss"] ?? { r: "s" }
  print(g1.r)
}
ps() // s

// ---- the competing row still HOLDS ITS OWN VALUES: `R` is used here, narrowly ----
function useR(x: R) { print(x.r) }

function ud(k: string) {
  const c = Map()
  c["k1"] = { r: 7 }
  const g1 = (c)[k] ?? { r: null }
  if g1.r != null { print(g1.r) } else { print(-1) }
}
useR({ r: 3 }) // 3   — a plain `R`, not the merged row
ud("miss") // -1
