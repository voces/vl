// @check
// @error `is` cannot tell {[string]: i32} from {[string]: 1 | 2} yet
// A numeric literal-union map value reps as its base, so `{[string]: 1 | 2}` and
// `{[string]: i32}` are one box member and a test between them is refused (D2493).
const m: {[string]: 1 | 2} = Map()
m["q"] = 2
const u: {[string]: i32} | {[string]: 1 | 2} = m
print(u is {[string]: i32})
