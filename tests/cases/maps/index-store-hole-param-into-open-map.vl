// @run
// @log 1
// @log 9
// @log 1.5
// @log 5
// @log x
// @log t

// An un-annotated `Map()` filled with an un-annotated parameter takes its value type from the
// pin, for a scalar, a record, a string and a hole key (D10041).

function f(v) {
  const m = Map()
  m["a"] = v
  print(m.length)
}
f(7)

function g(v) {
  const m = Map()
  m["a"] = v
  const r = m["a"]
  if r != null { print(r.w) }
}
g({ v: 7, w: 9 })

function h(v) {
  const m = Map()
  m["a"] = v
  print((m["a"] ?? 0.0) / 2.0)
}
h(3.0)

function mk(v) {
  const m = Map()
  m["k"] = v
  m
}
const a = mk(5)
print(a["k"] ?? 0)
const b = mk("x")
print(b["k"] ?? "none")

function keyed(k, v) {
  const m = Map()
  m[k] = v
  print(m[k] ?? v)
}
keyed(3, "t")
