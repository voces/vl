// @run
// @log 7
// @log 7
// @log 7
// A NESTED arm-valued map, delivered to an annotation that names the arm two and three
// containers out (silent-class-inventory D156). Every program here was
// `emitProgram: unsupported map value type` on `ff04d74b` — a LOUD reject, at the line of
// the INNER binding — and every one runs now.
//
// WHY IT WAS LOUD RATHER THAN SILENT, AND WHY THAT IS THE SAME ROW. `armPinAnnName` and
// `dstPinMapValue`'s leg-4 gate cut a map annotation exactly ONCE (`mapValNameOf`), so
// `{[string]: {[string]: Circle}}` answered `{[string]:Circle}` — a spelling the variant
// table can never claim — and both gates DECLINED. Declining is not neutral at that
// position: `dstPinPushAnn` records the `""` as a destination DISAGREEMENT, so one
// nested-map delivery VETOES the pin every other delivery of the same binding agreed on.
// With no pin the inner `Map()` reaches the mv layer with no value type at all and the
// mint has nothing to intern, which is the loud floor above. Both gates now peel every
// level (`mapLeafValName`).
//
// AND THE PASS RUNS TO A FIXPOINT, which is what makes `mk3` work. A pin CREATES a
// destination: `l1` is visited while `l2` is still un-annotated and records nothing, and
// only once `l2` is pinned from `c` does `l1` have a receiver annotation to read. One
// walk pins `l2` and leaves `l1` bare; the loop pins both.
//
// NO LAYOUT TWIN IS DECLARED HERE AND THAT IS THE POINT — it is the whole of what the new
// rungs are gated on (`armLayoutContested`). Add `type Dot = { r: i32 }` and these
// programs go back to being refused, deliberately: with two nominal claimants for
// `{ r: 7 }` a pin that cannot reach EVERY level of the chain leaves it consistent
// nowhere, which is measurably worse than the un-pinned chain that rides the arm/twin
// conflation the mv and ref-list layers still carry. That half is filed as D171, with the
// two rungs that would remove the conflation built and measured as pure regressions.

type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq

function thru(x: {[string]: {[string]: Circle}}) { return x }

// 1 — depth 2, function scope, the delivery is a call PARAMETER.
function mk() {
  const i0 = Map()
  i0["k"] = { r: 7 }
  const c = Map()
  c["o"] = i0
  const t = thru(c)
  return ((t["o"] ?? Map())["k"] ?? { r: 0 }).r
}
print(mk())

// 2 — the same chain at MODULE scope, which is D139's storage-class axis over this row.
const g0 = Map()
g0["k"] = { r: 7 }
const g1 = Map()
g1["o"] = g0
thru(g1)
print(((g1["o"] ?? Map())["k"] ?? { r: 0 }).r)

// 3 — depth 3, which needs the fixpoint: one walk pins `l2` and not `l1`.
function deep(x: {[string]: {[string]: {[string]: Circle}}}) { return x }
function mk3() {
  const l1 = Map()
  l1["k1"] = { r: 7 }
  const l2 = Map()
  l2["k2"] = l1
  const c = Map()
  c["k3"] = l2
  deep(c)
  return ((((c["k3"] ?? Map())["k2"] ?? Map())["k1"] ?? { r: 0 })).r
}
print(mk3())
