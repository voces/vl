// @run
// @log 1
// @log 2
// @log 1.5
// An un-annotated list literal of maps whose un-annotated functions nothing calls takes the
// elaboration's slot fact for its type, at module scope, in a function, and beside an annotated
// list of maps holding the same function (D15756).
function half(a) { return a / 2.0 }
const m4 = Map()
m4.set("a", half)
const ys = [m4]
print(ys.length)

function go() {
  const m5 = Map()
  m5.set("a", half)
  const zs = [m5, m5]
  print(zs.length)
}
go()

const m1 = Map()
m1.set("a", half)
const v: ({ [string]: (a: f64) => f64 })[] = [m1]
const g = v[0].get("a")
if g != null { print(g(3)) }
