// @run
// @log true
// @log true
// @log true
// @log true
// @log true
// @log true
// @log true
// @log true
// @log true
// @log 7
// @log 7
// @log true
// @log 7
// @log true
// @log true
// @log 7
// @log true
// @log true
// @log 4
// @log true
// A record-valued map's miss read straight into a union that also holds a scalar and `null` is
// the union's null, at every delivery position, through `[k]`, `?.`, a second record arm and a
// generic; a hit is the record arm (D10170).
type P = { x: i32 }
type Q = { y: string }
const c: {[i32]: P} = Map()
c.set(1, { x: 7 })
const a: i32 | P | null = c.get(2)
print(a is null)
function r(): i32 | P | null { return c.get(2) }
print(r() is null)
function q(v: i32 | P | null) { return v is null }
print(q(c.get(2)))
let z: i32 | P | null = 1
z = c.get(2)
print(z is null)
type H = { v: i32 | P | null }
const h: H = { v: c.get(2) }
print(h.v is null)
const l: (i32 | P | null)[] = [c.get(2)]
print(l[0] is null)
function local() {
  const m: {[i32]: P} = Map()
  const v: string | P | null = m[3]
  return v is null
}
print(local())
const b: string | P | null = c[2]
print(b is null)
const two: P | Q | null = c.get(2)
print(two is null)
const hit: i32 | P | null = c.get(1)
if hit is P { print(hit.x) }
const hit2: P | Q | null = c[1]
if hit2 is P { print(hit2.x) }
const k: {[i32]: P} | null = c
const oc: i32 | P | null = k?.get(2)
print(oc is null)
const och: i32 | P | null = k?.get(1)
if och is P { print(och.x) }
function at<T>(m: {[i32]: T}, key: i32): i32 | T | null { return m.get(key) }
print(at(c, 2) is null)
const g = at(c, 2)
print(g is null)
const g1 = at(c, 1)
if g1 is P { print(g1.x) }
const kn: {[i32]: P} | null = null
const ocn: i32 | P | null = kn?.get(2)
print(ocn is null)
type R = { x: i32, y: i32 }
const d: {[i32]: R} = Map()
d.set(1, { x: 3, y: 4 })
const e: i32 | R | P | null = d.get(2)
print(e is null)
const f: i32 | R | P | null = d.get(1)
if f is R { print(f.y) }
const s: {[string]: P} = Map()
const t: boolean | P | null = s.get("z")
print(t is null)
