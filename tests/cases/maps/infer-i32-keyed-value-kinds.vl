// @run
// @log x
// @log 9
// @log 4.25
// @log 2
// THE KEY IS THE SLOT IDENTITY'S OTHER HALF, on the inferred path too. `{[string]: S}`
// and `{[i32]: S}` record the same value spelling and are two layouts, so the mint an
// un-annotated `const m = Map()` needs has to read BOTH halves off the checker's recorded
// type — `collectA`'s constructor arm already read the key there (for the `mI32Used` type
// flag) and now reads the value at the same node.
//
// Its string-keyed twin is `infer-value-kinds.vl`; the same annotation-free rule holds
// here (an annotated `{[i32]: V}` anywhere in the module would mint the slot the inferred
// binding is supposed to need). The pairing is what this file adds: an i32-keyed map that
// resolved a STRING-keyed slot would read a string-ref keys list as i32s — invalid wasm,
// not a reject — so the two halves are pinned together.

type Pt = { x: i32 }

function go() {
  const ms = Map()
  ms.set(1, "x")
  print(ms[1] ?? "none") // x

  const mp = Map()
  mp.set(1, { x: 9 })
  print((mp[1] ?? { x: 0 }).x) // 9

  const mf = Map()
  mf.set(2, 4.25)
  print(mf[2] ?? 0.0) // 4.25

  const ml = Map()
  ml.set(3, ["p", "q"])
  print((ml[3] ?? []).length) // 2
}
go()
