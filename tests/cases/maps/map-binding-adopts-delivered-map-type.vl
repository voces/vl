// @run
// @log 1
// @log 7
// @log 7
// @hint Intentionally-unused parameter `_x`
// An un-annotated `Map()` binding is built at the map type it is delivered as, as a list
// literal binding is, through nested maps too.

type Circle = { r: i32 | null }
type P = { r: i32 }

function sink(x: {[string]: Circle}) {
  const v = x["k0"]
  if v != null { print(v.r ?? 0) }
}
const q: P = { r: 1 }
print(q.r)
const lv1 = Map()
lv1["k0"] = { r: 7 }
sink(lv1)

function sink2(_x: {[string]: {[string]: Circle}}) {}
const lv2 = Map()
lv2["k0"] = { r: 7 }
const c2 = Map()
c2["k0"] = lv2
sink2(c2)
const h0 = c2["k0"] ?? Map()
const h1 = h0["k0"] ?? { r: null }
if h1.r != null { print(7) } else { print(0) }
