// @run
// @log b
// @log 5
// @log c
// @log b

// An un-annotated map filled with a record join narrows its place read by an `is` complement,
// in a function, at module scope, and annotated (D2582).
type A = { r: i32 }
type B = { q: string }
function mkA(n: i32): A | null {
  if n == 0 { return null }
  return { r: n }
}
function mkB(s: string): B | null {
  if s == "" { return null }
  return { q: s }
}
function go(n: i32) {
  const m = Map()
  m["k"] = mkA(n) ?? mkB("b")
  if m["k"] == null { print("null") }
  else if m["k"] is A { print(m["k"].r) }
  else { print(m["k"].q) }
}
go(0)
go(5)
const mm = Map()
mm["k"] = mkA(0) ?? mkB("c")
if mm["k"] == null { print("null") }
else if mm["k"] is A { print(mm["k"].r) }
else { print(mm["k"].q) }
const ma: { [string]: A | B | null } = Map()
ma["k"] = mkA(0) ?? mkB("b")
if ma["k"] == null { print("null") }
else if ma["k"] is A { print(ma["k"].r) }
else { print(ma["k"].q) }
