// A map of the rowless `{ r: null }` beside a plain `Dot` and the union arm `Circle` of one shape is
// stored at their row; each read of it is that row's record: bound, a `??` with a default, a field
// test, handed to a function expecting `Dot`, returned, a call argument, at module scope.
type Circle = { r: i32 | null }
type Dot = { r: i32 | null }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = {[string]: Circle}[]
const _sp1: Box1 = []
function onDot(d: Dot) { print(d.r == null) }
function show(x) { if x.r != null { print(7) } else { print(0) } }
function rd() {
  const m = Map()
  m["k"] = { r: null }
  const g1 = m["k"] ?? { r: null }
  if g1.r != null { print(7) } else { print(0) }
  const g2 = m["j"] ?? { r: null }
  if g2.r != null { print(7) } else { print(0) }
  print((m["k"] ?? { r: null }).r == null)
  print((m["j"] ?? { r: null }).r == null)
  show(m["k"] ?? { r: null })
  return m["j"] ?? { r: null }
}
const back = rd()
show(back)
onDot(back)
const n = Map()
n["k"] = { r: null }
const g3 = n["k"] ?? { r: null }
print(g3.r == null)
onDot(n["j"] ?? { r: null })
