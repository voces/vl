// @run
// @log 2
// @log object
// @log object
// The three return annotations are LOAD-BEARING and stay: this fixture is about which
// spelling of a map type reaches the emitter, so a declared return is one fewer thing the
// inference could be doing instead. Declared rather than deleted, per the hint's own rule.
// @hint redundant type annotation: `vsize` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `wname` is inferred as `string` — remove it to lean on inference
// @hint redundant type annotation: `uname` is inferred as `string` — remove it to lean on inference
// D1865's three RUNNING controls, kept where a gate re-runs them. A map delivered into a
// union refuses when its type is spelled through an alias AND the union is recursive; each
// of the three below removes exactly one of those two ingredients and must keep running,
// so a fix that closes the row by disturbing one of them has moved the family, not closed it.

// (1) The recursion, at the INLINE spelling — and read back through the map arm, which is
// what says the box is real rather than an accidental fall-through to the last branch.
type V = f64 | string | { [string]: V }

function vsize(v: V): i32 {
  if v is f64 { return -1 }
  if v is string { return -2 }
  if v is { [string]: V } { return v.size }
  -3
}

const rec: { [string]: V } = Map()
rec["a"] = 1.0
rec["b"] = "x"
print(vsize(rec))

// (2) The ALIAS, over a non-recursive union whose map value is a ref type.
type Box = { v: i32 }
type W = f64 | string | { [string]: Box }
type WM = { [string]: Box }

function wname(w: W): string {
  if w is f64 { return "number" }
  if w is string { return "string" }
  "object"
}

const refm: WM = Map()
refm["a"] = { v: 1 }
print(wname(refm))

// (3) The same alias over an i32-valued map, whose value rides the mono map slot rather
// than an interned one — the two value reps reach the arm by different routes.
type U = f64 | string | { [string]: i32 }
type UM = { [string]: i32 }

function uname(u: U): string {
  if u is f64 { return "number" }
  if u is string { return "string" }
  "object"
}

const monom: UM = Map()
monom["a"] = 1
print(uname(monom))
