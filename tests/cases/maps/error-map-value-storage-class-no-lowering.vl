// @check
// @error-at 10:12 flowing into {[string]: i32 | null} changes how the ELEMENT is stored
// The MAP arm of the container-element storage rule — the same class test over a map's
// KEY and VALUE that `arrays/error-elem-storage-class-no-lowering.vl` pins over an array's
// element. A map's wasm type is fixed by how its value is stored, so a `{[string]: i32}`
// (a mono i32 map) is an unrelated type to a `{[string]: i32 | null}` (a boxed one) and
// there is no value-converting copy to insert.
function widenVal(_m: {[string]: i32 | null}) { print(1) }
const mi: {[string]: i32} = Map()
mi["a"] = 1
widenVal(mi)
