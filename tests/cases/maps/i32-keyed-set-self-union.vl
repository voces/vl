// @run
// @log true
// @log 4
// @log 42
// @log 3
// D2519: a `self` parameter whose union has an i32-keyed Set arm declares a member call for a
// set of integers, and each receiver narrows back to its own arm. A set's own `add` still wins
// the member call on a set receiver, so `add` is reached here only through the string.
function add(self: Set<i32> | string, x: i32) {
  if self is string {
    print(self.length + x)
  } else {
    print(self.length + x + 100)
  }
}
const s = Set<i32>()
s.add(1)
print(s.has(1))
"z".add(3)
function total(self: Set<i32> | string) {
  if self is string { return self.length }
  let t = 0
  for x in self { t = t + x }
  t
}
const n = Set<i32>()
n.add(40)
n.add(2)
print(n.total())
print("abc".total())
