// @run
// @log 0
// @log 1
// @log b
// @log 0
// @log 0
// @log 0
// A `Map()` whose key and value types come from where it is delivered, built at that map in
// each position: a union arm's nullable map field, an annotated binding, an argument and a
// return, one per function.
type Box = { g: {[i32]: i32} | null } | f64
type Plain = { g: {[string]: string} }
function size(m: {[i32]: i32} | null) {
  if m == null { return -1 }
  return m.length
}
const b: Box = { g: Map() }
function arm() {
  const x: Box = { g: Map() }
  if x is f64 { return 0 }
  const g = x.g
  if g != null {
    g[1] = 2
    return g.length
  }
  return -1
}
function plain() {
  const p: Plain = { g: Map() }
  p.g["a"] = "b"
  return p.g["a"] ?? "none"
}
function annotated() {
  const m: {[i32]: i32} | null = Map()
  return size(m)
}
function argPos() { return size(Map()) }
function ret(): {[i32]: i32} | null { return Map() }
if b is f64 { print(0) } else { print(size(b.g)) }
print(arm())
print(plain())
print(annotated())
print(argPos())
print(size(ret()))
