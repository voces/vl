// @run
// @log 3
// @log 7
// @log 2
// @log 3
// @log 10
// A map global of hole functions, written where it is built and in another function, then read,
// set and read again in a third at the binding's storage type: each read takes the cell as legacy
// stores it, so every write is seen.
function half(a) { return a / 2.0 }
function twice(a) { return a * 2.0 }
const m = Map()
m.set("a", half)
function addTwice() { m.set("b", twice) }
function readAll() {
  const ys: { [string]: (a: i32) => f64 } = m
  const h = ys.get("a")
  if h != null { print(h(6)) }
  const t = ys.get("b")
  if t != null { print(t(3) + 1.0) }
  ys.set("c", half)
  const c = ys.get("c")
  if c != null { print(c(4)) }
  print(ys.length)
}
addTwice()
readAll()
const later = m.get("c")
if later != null { print(later(8) + 6.0) }
