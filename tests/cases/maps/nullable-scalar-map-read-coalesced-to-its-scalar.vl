// @run
// @log 2.5
// @log 7.5
// @log 7.5
// @log 4
// A map whose value is a nullable scalar, read under `??`, peels to the scalar: a stored null and a
// miss both take the default, and an integer value widens to the result's float.
function pick(m: {[string]: f64 | null}, k: string) { return m[k] ?? 7.5 }
function count(m: {[string]: i32 | null}, k: string) { return m[k] ?? 0.5 }
function go() {
  const a: {[string]: f64 | null} = Map()
  a["x"] = 2.5
  a["n"] = null
  print(pick(a, "x"))
  print(pick(a, "n"))
  print(pick(a, "z"))
  const b: {[string]: i32 | null} = Map()
  b["c"] = 4
  print(count(b, "c"))
}
go()
