// @run
// @log 4
// @log 4
// @log 6
// @log 4
// @log 7
// A walk over a map's `.values()` reads the map's value slot, as a key-value walk does, so its call
// pins the hole functions the map holds, bare or in a record field, and one written into a value's
// field through a narrowed read (D16239). A walk's key and a list walk's index read no slot.
function inc(n) { return n + 1 }
function dbl(n) { return n * 2 }
const m = Map()
m["a"] = inc
for g in m.values() { print(g(3)) }

const rs = Map()
rs["a"] = { f: inc }
for e in rs.values() { print(e.f(3)) }

const ws = Map()
ws["a"] = { f: inc }
const r = ws["a"]
if r != null { r.f = dbl }
for e in ws.values() { print(e.f(3)) }

for k in m {
  const h = m[k]
  if h != null { print(h(3)) }
}
const xs = [inc]
for x, i in xs { print(x(i + 6)) }
