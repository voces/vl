// @run
// @log 4
// @log 7
// @log hi
// @log 7
// @log 5
// @log 5
// A map whose value is a union with null, read under `??`: a hit keeps the stored box, and a miss
// or a stored null boxes the default into it. A nullable default keeps the result nullable.
function wide(m: {[string]: i32 | string | null}, k: string) {
  const v = m[k] ?? 7
  if v is i32 { print(v) } else { print(v) }
}
function chain(m: {[string]: i32 | null}, a: string, b: string) {
  const v = m[a] ?? m[b]
  if v != null { print(v) }
}
function go() {
  const m: {[string]: i32 | string | null} = Map()
  m["n"] = 4
  m["s"] = "hi"
  m["z"] = null
  wide(m, "n")
  wide(m, "q")
  wide(m, "s")
  wide(m, "z")
  const c: {[string]: i32 | null} = Map()
  c["x"] = 5
  chain(c, "x", "y")
  chain(c, "y", "x")
}
go()
