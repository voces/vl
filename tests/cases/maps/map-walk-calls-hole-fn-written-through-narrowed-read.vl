// @run
// @log 6
// @log 10
// @log 6
// A map walk's value variable reads the map's value slot, so its call pins a hole function written
// into a value's field through a narrowed read of the map, by name or as a lambda (D16237).
function inc(n) { return n + 1 }
function dbl(n) { return n * 2 }
const m = Map()
m["a"] = { f: inc }
const r = m["a"]
if r != null { r.f = dbl }
for k, e in m { print(e.f(3)) }

function mk() {
  const h = Map()
  h["a"] = { f: inc }
  h["b"] = { f: inc }
  return h
}
const v = mk()
const s = v["a"]
if s != null { s.f = dbl }
let c = 0
for k, e in v { c = c + e.f(3) }
print(c)

const w = Map()
w["a"] = { f: inc }
const t = w["a"]
if t != null { t.f = (n) => n * 2 }
for k, e in w { print(e.f(3)) }
