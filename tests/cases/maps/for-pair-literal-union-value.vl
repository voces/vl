// @run
// @log q
// @log p
// @log true
// @log q!
// @log p
// @log q
// D2656: the value binding of `for k, v` over a literal-union-valued map is the member, not its
// interned index, at a string key, an i32 key, and through a union narrowed to the map.
type L = "p" | "q"
const m: {[string]: L} = Map()
m.set("a", "q")
m.set("b", "p")
for k, v in m { print(v) }
for k, v in m {
  if v == "q" {
    print(true)
    print(v + "!")
  }
}
const n: {[i32]: L} = Map()
n.set(7, "p")
function f(u: {[i32]: L} | string) {
  if u is {[i32]: L} {
    for k, v in u { print(v) }
    print(u.get(9) ?? "q")
  }
}
f(n)
