// @run
// @log 7
// @log 1
// @log 3
// @log 7
// An un-annotated `Map()` whose value is an inferred `{ x: i32 }[] | i32[]`, from a plain and
// from a generic function, narrowed to the record arm by an `else` of `is i32[]` (D5113).
function w(b: boolean) {
  if b { return [{ x: 7 }] }
  [1, 2, 3]
}
function wrap<T>(t: T, b: boolean) {
  if b { return [t] }
  [1, 2, 3]
}
const m = Map()
m["k"] = w(true)
m["j"] = w(false)
const v = m["k"]
if v != null {
  if v is i32[] { print(0) } else { print(v[0].x) }
  if v is i32[] { print(0) } else { print(v.length) }
}
const vj = m["j"]
if vj != null {
  if vj is i32[] { print(vj[2]) } else { print(vj[0].x) }
}
const g = Map()
g.set("k", wrap({ x: 7 }, true))
const vg = g.get("k")
if vg != null {
  if !(vg is i32[]) && vg.length == 1 { print(vg[0].x) } else { print(9) }
}
