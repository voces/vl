// @run
// @log 1
// @log 1
// @log x
// @log 1.5
// @log 0
// @log null
// @log 5
// @log 12
// A BARE MAP `m.get(k)`, no `??` (D1522, `~/glean` VL-003).
//
// The first three lines are the consumer's program unchanged. `.get` is a designed map
// builtin (`docs/guide/collections-design.md` §C2.1) and the checker types it `V | null`,
// but only the FUSED `m.get(k) ?? d` had a lowering — a bare one fell out of the member
// ladder into `emitCall`'s UFCS fallback and refused with `callee is not a function name`,
// a sentence about UFCS on a call that was never UFCS.
//
// THE TWO SPELLINGS ARE ONE READ, which is why the fix is a rewrite (`m.get(k)` becomes
// `m[k]` in `dispatchRewrite`) and not an emit arm: teaching the LOWERING alone left the
// classifier reading the call's checker type and claiming the value-union box, so print
// went from a loud refusal to invalid wasm. The MISS lines are here because parity has to
// include them — a mono i32 map has no spare value and reads `0`, a string map reads
// `null`, and both spellings must agree or one of them is silently wrong.
//
// The last two are the EXCLUSIONS the gate has to keep: a LIST `.get(i)` is a different
// checked read, and a closure-valued struct FIELD named `get` is an ordinary member call.
const m = Map()
m.set("a", 1)
print(m.get("a"))

const mi: {[i32]: i32} = Map()
mi.set(7, 1)
print(mi.get(7))

const ms: {[string]: string} = Map()
ms.set("a", "x")
print(ms.get("a"))

const mf: {[string]: f64} = Map()
mf.set("a", 1.5)
const vf = mf.get("a")
print(vf ?? 0.0)

print(m.get("zz"))
print(ms.get("zz"))

const xs = [4, 5, 6]
print(xs.get(1) ?? -1)

type Box = { get: (i32) => i32 }
const b: Box = { get: (n) => n * 3 }
print(b.get(4))
