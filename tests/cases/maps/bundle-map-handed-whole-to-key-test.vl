// A map of a two-signature bundle handed whole to a parameter its callee only tests for a key
// keeps the bundle record its values hold (D17096).
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
function h(x) { return x.has("a") }
function ks(x) { return x.keys().length }
const m = Map()
m["a"] = lap((a) => a + 1)
print(h(m))
print(ks(m) == 1)
