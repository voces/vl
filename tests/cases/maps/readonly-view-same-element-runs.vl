// @run
// @log x
// @log 4
// @log y
// @log 2
// @log z
// @hint redundant type annotation: `first` is inferred as `string` — remove it to lean on inference
// @hint redundant type annotation: `total` is inferred as `f64` — remove it to lean on inference
// @hint redundant type annotation: `rowTag` is inferred as `string` — remove it to lean on inference
// @hint redundant type annotation: `deg` is inferred as `i32` — remove it to lean on inference
// @hint redundant type annotation: `gr` is inferred as `{adj: {[string]: string[]}}` — remove it to lean on inference
// @hint redundant type annotation: `n` is inferred as `string` — remove it to lean on inference
// @hint redundant type annotation: `row` is inferred as `{tags: string[]}` — remove it to lean on inference
// A list shared as a `readonly` view of its OWN element type needs no copy and admits no wider
// store, so it passes inside a map value, a record field, or both: the map rule refuses only a
// list whose element differs, or a view of a union or nullable element a narrower list could be
// shared as (D2161). Each read prints an element, so a list that stopped sharing would show.
type Row = { tags: string[] }
type RoRow = { tags: readonly string[] }

function first(m: {[string]: readonly string[]}): string {
  const v = m["a"]
  if v == null { return "-" }
  v[0]
}
const m1: {[string]: string[]} = Map()
m1["a"] = ["x"]
print(first(m1))

function total(m: {[string]: readonly f64[]}): f64 {
  let t = 0.0
  for k in m.keys() {
    const v = m[k]
    if v != null {
      for x in v { t = t + x }
    }
  }
  t
}
const m2: {[string]: f64[]} = Map()
m2["a"] = [1.5, 2.5]
print(total(m2))

function rowTag(m: {[string]: RoRow}): string {
  const r = m["a"]
  if r == null { return "-" }
  r.tags[0]
}
const m3: {[string]: Row} = Map()
m3["a"] = { tags: ["y"] }
print(rowTag(m3))

function deg(g: { adj: {[string]: readonly string[]} }, k: string): i32 {
  const v = g.adj[k]
  if v == null { return 0 }
  v.length
}
const adj: {[string]: string[]} = Map()
adj["a"] = ["b", "c"]
const gr: { adj: {[string]: string[]} } = { adj: adj }
print(deg(gr, "a"))

function n(r: { tags: readonly string[] }): string { r.tags[1] }
const row: Row = { tags: ["x", "z"] }
print(n(row))
