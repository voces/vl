// A map read of a tagged set's ids, `F | null`, handed to an un-annotated parameter that
// null-tests and calls it, is pinned at the nullable of the set's id rep (D17722).
function inc(a) { return a + 1 }
function dbl(a) { return a * 2 }
function half(a) { return a / 2.0 }
function callIt(g, x) {
  if g != null { print(g(x)) } else { print("none") }
}
const m = Map()
m["k"] = inc
m["j"] = dbl
callIt(m["k"], 3)
callIt(m["z"], 3)
callIt(m.get("k"), 3)
callIt(m["j"], 3)
const r = m["k"]
callIt(r, 3)
function go() {
  const m2 = Map()
  m2["k"] = inc
  m2["j"] = dbl
  callIt(m2["j"], 5)
  callIt(m2["x"], 5)
}
go()
const mh = Map()
mh["h"] = half
callIt(mh["h"], 3.0)
callIt(m["k"], 10)
