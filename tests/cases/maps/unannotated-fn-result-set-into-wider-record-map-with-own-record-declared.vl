// @run
// @log 4
// D3342's un-annotated spelling: the function's result, a literal of a declared record's own
// fields, set into a map of a wider record, is stored at the map's value row.
type O = { v: i32 }
type I = { f: O }
type J = { f: O | null }
function mk() { { f: { v: 4 } } }
const m = Map<string, J>()
m.set("a", mk())
const x = m.get("a") ?? { f: { v: 9 } }
print(x.f?.v ?? 70)
