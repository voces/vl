import { toString } from "std:fmt"

// `m.clear()` empties a map in place, keeping its capacity: every op afterwards behaves as on a
// fresh map, and a refill — colliding keys, keys past a resize — finds what it stores.
type P = { x: i32, y: i32 }

// i32 keys 1, 17 and 33 share a probe chain in the 16-slot index.
const a: Map<i32, i32> = Map()
a[1] = 1
a[17] = 17
a[33] = 33
print(a.length)
a.clear()
print(a.length)
print(a[17] ?? -1)
print(a.has(1))
let seen = 0
for k in a.keys() { seen = seen + k }
print(seen)
print(a.keys().length)
a[33] = 30
a[17] = 10
print(a.length)
print(a[17] ?? -1)
print(a[33] ?? -1)
print(a[1] ?? -1)

// String keys past a resize, then cleared, then refilled in a different order.
const s: Map<string, i32> = Map()
let i = 0
while i < 20 {
  s["k" + i.toString()] = i
  i = i + 1
}
print(s.length)
s.clear()
print(s.length)
print(s.has("k3"))
let walked = 0
for k in s.keys() { walked = walked + k.length }
print(walked)
i = 19
while i >= 0 {
  s["k" + i.toString()] = 19 - i
  i = i - 1
}
print(s.length)
print(s["k19"] ?? -1)
print(s["k0"] ?? -1)
print(s["k12"] ?? -1)

// String values: the cleared map drops them and stores new ones.
const t: Map<string, string> = Map()
t["a"] = "x"
t["b"] = "y"
t.clear()
print(t.length)
t["b"] = "a"
t["a"] = "b"
print(t.length)
print((t["b"] ?? "") + (t["a"] ?? ""))

// Record values, with a delete before the clear.
const r: Map<string, P> = Map()
r["p"] = { x: 1, y: 2 }
r["q"] = { x: 3, y: 4 }
r.delete("p")
r.clear()
print(r.length)
r["q"] = { x: 4, y: 5 }
print(r.length)
const q = r["q"]
if q != null { print(q.y) }

// A fresh map that was never written.
const f: Map<i32, f64> = Map()
f.clear()
print(f.length)
print(f.has(0))
f[0] = 2.5
print(f.length)
const g: Map<i32, f64> = Map()
g.clear()
g[4] = 9.0
print(g[4] ?? 0.0)
