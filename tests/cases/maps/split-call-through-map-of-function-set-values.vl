// @run
// @log 4
// @log 6
// @log 4
// @log 6
// @log 4
// @log 6
// @log 4
// @log 6
// @log 4
// @hint Intentionally-unused variable `_a` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_b` (leading `_` marks it unused)
// @hint redundant type annotation: `dbl` is inferred as `f64` — `--fix` keeps a return annotation as the signature's documentation; remove it by hand if it is not
// A call whose members give different results, through a map's values, tags the set as a list's
// element does: walked, bound first, copied in the loop, and off a record's field (D17731); a
// map of one hole function walked so calls it at the call's own types (D16239).
function dbl(a: f64): f64 { return a * 2.0 }
const g = (a) => a + 1
const _a = g(2.5)
const _b = g(3)
const m = Map()
m["a"] = g
m["b"] = dbl
for v in m.values() { print(v(3)) }
const vs = m.values()
for v in vs { print(v(3)) }
for v in m.values() {
  const w = v
  print(w(3))
}
const r = { mm: m }
for v in r.mm.values() { print(v(3)) }
function inc(n) { return n + 1 }
const mi = Map()
mi["a"] = inc
for f in mi.values() { print(f(3)) }
