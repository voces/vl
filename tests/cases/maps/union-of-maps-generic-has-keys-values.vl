// @log 1
// @log 1
// @log q
// @log r
// D10171, D10173: a generic over `{[string]: V} | {[string]: string}` reads its parameter through
// `.has`, `.keys()`, `.values()` and a `for`, called at a member that binds `V` and at the other.
const a: {[string]: i32} = Map()
a["q"] = 5
const b: {[string]: string} = Map()
b["r"] = "x"
const t: {[string]: boolean} = Map()
t["p"] = true
function g<V>(m: {[string]: V} | {[string]: string}, k: string) { m.has(k) }
function n<V>(m: {[string]: V} | {[string]: string}) { m.keys().length }
function vs<V>(m: {[string]: V} | {[string]: string}) { m.values().length }
function ks<V>(m: {[string]: V} | {[string]: string}) {
  let s = ""
  for k in m { s = s + k }
  s
}
print(g(a, "q"))
print(g(b, "q"))
print(g(b, "r"))
print(g(t, "p"))
print(n(a))
print(n(b))
print(vs(a))
print(ks(a))
print(ks(b))
