// @check
// @error two maps do not join into one value yet
// D2493's join twin: an `if` whose arms are two maps of one representation has no type to
// become, since the union it would join to is refused.
const m1: {[i32]: i32} = Map()
const m2: {[i32]: boolean} = Map()
const x = if m1.length > 0 { m1 } else { m2 }
print(x.length)
