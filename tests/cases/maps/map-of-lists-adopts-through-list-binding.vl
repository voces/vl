// @run
// @log 8
// @log 9
// @log 10
// An un-annotated `Map()` whose list values are written from an un-annotated list binding takes
// the map type it is delivered as, and the list binding takes that map's value type, so its
// records are built at the declared row beside a same-shape `Dot`. Each delivery position is
// spelled once: a binding, an argument, a result.
type Circle = { r: i64 }
type Dot = { r: i64 }
type GW = { g: {[string]: Circle[]} }

function viaBinding() {
  const lv = [{ r: 8 }]
  const c = Map()
  c["k"] = lv
  const m: {[string]: Circle[]} = c
  const g0 = m["k"] ?? []
  if g0.length > 0 { print(g0[0].r) }
}

function show(m: {[string]: Circle[]}) {
  const g0 = m["k"] ?? []
  if g0.length > 0 { print(g0[0].r) }
}

function viaArgument() {
  const lv = [{ r: 9 }]
  const c = Map()
  c["k"] = lv
  show(c)
}

function made(): {[string]: Circle[]} {
  const lv = [{ r: 10 }]
  const c = Map()
  c["k"] = lv
  c
}

viaBinding()
viaArgument()
show(made())
const _d: Dot = { r: 0 }
