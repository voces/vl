// @run
// @log 7
// @log 0
// @log 2.5
// @log 9
// @log 21
// @log 9
// @log 4
// @log 12
// @log true
// @log 5.5
// @log 1
// `m[k]?.f ?? d` over a map of records, a hit and a miss, in each position: a parameter map, a
// local map, a key and a default from calls, inside arithmetic, in a loop, in a nested `if`, a
// returned value, a union-of-records map's field and a global map read in a function.
type P = { n: i32, w: f64, ok: boolean }
type A = { kind: "a", n: i32 }
type B = { kind: "b", n: i32 }
const g: {[string]: P} = Map()
g["x"] = { n: 4, w: 5.5, ok: true }
function key() { return "x" }
function dflt() { return 9 }
function param(m: {[string]: P}, k: string) { return m[k]?.n ?? 0 }
function local() {
  const m: {[i32]: P} = Map()
  m[3] = { n: 1, w: 2.5, ok: false }
  return m[3]?.w ?? 0.0
}
function callKey(m: {[string]: P}) { return m[key()]?.n ?? dflt() }
function arith(m: {[string]: P}) {
  return (m["x"]?.n ?? 0) * 2 + (m["q"]?.n ?? 7)
}
function loop(m: {[string]: P}) {
  let t = 0
  for k in ["x", "y", "x"] { t = t + (m[k]?.n ?? 1) }
  return t
}
function nested(m: {[string]: P}, c: boolean) {
  if c {
    if m["x"]?.ok ?? false { return m["x"]?.n ?? 0 }
  }
  return -1
}
function arms() {
  const m: {[string]: A | B} = Map()
  m["a"] = { kind: "a", n: 12 }
  return m["a"]?.n ?? 0
}
function glob() { return g["x"]?.ok ?? false }
const m: {[string]: P} = Map()
m["x"] = { n: 7, w: 1.0, ok: true }
print(param(m, "x"))
print(param(m, "z"))
print(local())
print(callKey(Map()))
print(arith(m))
print(loop(g))
print(nested(g, true))
print(arms())
print(glob())
print(g["x"]?.w ?? 0.0)
print(g["y"]?.n ?? 1)
