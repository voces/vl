// @run
// @log 7
// @log 2
// @log 7
// @hint redundant type annotation: `loc` is inferred as `{[string]: S}`
// @hint redundant type annotation: `ga` is inferred as `{[string]: S}`
// @hint redundant type annotation: `ge` is inferred as `{[string]: S}`
// The D2662 cycle with the other arm assigning a function local, an `else if` chain, and a
// three-function chain whose every tail `if` assigns two different map cells.

type S = { a: i32 }

function mkR(v: i32): {[string]: S} {
  const m: {[string]: S} = Map()
  m["a"] = { a: v }
  return m
}

let gc = fc(false)

function fc(c: boolean) {
  let loc: {[string]: S} = mkR(1)
  if c { gc = mkR(8) } else { loc = mkR(7) }
}

let ga: {[string]: S} = mkR(0)
let gb = fa(false)
let gz = fb(false)

function fa(c: boolean) {
  if c { gb = mkR(1) } else { ga = mkR(2) }
}

function fb(c: boolean) {
  if c { gz = mkR(3) } else { gb = fa(c) }
}

let ge: {[string]: S} = mkR(0)
let gy = fe(1)

function fe(c: i32) {
  if c == 0 { gy = mkR(8) }
  else if c == 1 { ge = mkR(7) }
  else { gy = mkR(9) }
}

const gcv = gc["a"]
if gcv != null { print(gcv.a) }
const gzv = gz["a"]
if gzv != null { print(gzv.a) }
const gyv = gy["a"]
if gyv != null { print(gyv.a) }
