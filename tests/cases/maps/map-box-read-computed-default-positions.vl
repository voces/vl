// @run
// @log bd
// @log ad
// @log ad
// @log bd
// @log ad
// @log str
// @log str
// @log str
// @log str
// @log str
// @log bd
// @log ad
// @log ad
// @log bd
// @log ad
// A read of a boxed `T | null` map value whose computed default makes it non-null: the default is
// boxed into the read's box, the same struct as the value's. Positions: binding, argument,
// `return`, record field and list element, over a stored null, a stored member and a missing key.
type K = "ad" | "bd"
type V = {f: K[]} | string | null
type H = { v: {f: K[]} | string }
function show(v: {f: K[]} | string) {
  if v is {f: K[]} { print(v.f[0]) } else { print(v) }
}
function ret(m: {[string]: V}, k: string): {f: K[]} | string {
  return m[k] ?? { f: ["ad"] }
}
function run(k: string) {
  const m: {[string]: V} = Map()
  m["n"] = null
  m["s"] = "str"
  const a = m[k] ?? { f: ["bd"] }
  show(a)
  show(m[k] ?? { f: ["ad"] })
  show(ret(m, k))
  const h: H = { v: m[k] ?? { f: ["bd"] } }
  show(h.v)
  const l = [m[k] ?? { f: ["ad"] }]
  show(l[0])
}
run("n")
run("s")
run("x")
