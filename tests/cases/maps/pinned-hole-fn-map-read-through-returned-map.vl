// @run
// @log 3
// @log 3
// @log 3
// @log 3
// A map of an un-annotated function pinned at one signature, read and called through a call of a
// function returning it (with a parameter, with two returns, bound first, read in a function),
// while an annotated list of maps holds the same function at another signature (D15758).
function half(a) { return a / 2.0 }
const m1 = Map()
m1.set("a", half)
const m4 = Map()
m4.set("a", half)
const ws: ({ [string]: (a: f64) => f64 })[] = [m1]
const g = ws[0].get("a")

function mk() { return m4 }
const h1 = mk().get("a")
if g != null && h1 != null { print(g(3) + h1(3)) }

function pick(c: boolean) {
  if c { return m4 }
  return m4
}
const h2 = pick(true).get("a")
if g != null && h2 != null { print(g(3) + h2(3)) }

const v = mk()
const h3 = v.get("a")
if g != null && h3 != null { print(g(3) + h3(3)) }

function go() {
  const h4 = mk().get("a")
  if g != null && h4 != null { print(g(3) + h4(3)) }
}
go()
