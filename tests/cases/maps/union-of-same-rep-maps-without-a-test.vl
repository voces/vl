// @run
// @log 2
// @log true
// @log false
// Two maps that share one representation may share a union, a list and a nullable, and each
// keeps its own box tag (D2493). These read what both members have in common.
const a: {[string]: i32} = Map()
a.set("x", 1)
const c: {[string]: boolean} = Map()
const xs = [a, c]
print(xs.length)
function f(u: {[string]: i32} | {[string]: boolean} | null) { print(u == null) }
f(null)
f(a)
