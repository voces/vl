// @run
// @log 1
// @log 1
// @log 1
// @log 1
// D15547's store-free half: a list element's `Map()` that no write anywhere types runs at the
// unbound default.
function u(a) { print(a.length) }
u([Map()])
const xs = [Map()]
u(xs)
const r = { f: [Map()] }
print(r.f.length)
const h = [{ f: Map() }]
print(h.length)
