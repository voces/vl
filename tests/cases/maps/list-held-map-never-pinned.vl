// @run
// @warning the element type of a container this argument holds is never fixed by any write, so it is always empty — give it its type where it is built if a write was meant
// @warning the element type of 'xs[i]' is never fixed by any write, so it is always empty — give it its type where it is built if a write was meant
// @warning the element type of 'r.f[i]' is never fixed by any write, so it is always empty — give it its type where it is built if a write was meant
// @warning the element type of 'h[i].f' is never fixed by any write, so it is always empty — give it its type where it is built if a write was meant
// @log 1
// @log 1
// @log 1
// @log 1
// D15547's store-free half: a list element's `Map()` that no write anywhere types runs at the
// unbound default, and the warning names the binding and the path to it.
function u(a) { print(a.length) }
u([Map()])
const xs = [Map()]
u(xs)
const r = { f: [Map()] }
print(r.f.length)
const h = [{ f: Map() }]
print(h.length)
