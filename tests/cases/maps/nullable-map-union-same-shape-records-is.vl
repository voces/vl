// @run
// @log true
// @log true
// @log false
// @log 7
// @log false
// D2723: `P` and `Q` are one record shape, so `{[i32]: P} | {[i32]: Q} | null` is one map beside
// `null`, a nullable-map niche, and `is` against either member tests non-null. Graded at a
// binding, a parameter (a map and `null`), a return and a `null` binding.
type P = { a: i32 }
type Q = { a: i32 }
const mp: {[i32]: P} = Map()
mp.set(1, { a: 7 })
const u2: {[i32]: P} | {[i32]: Q} | null = mp
print(u2 is {[i32]: Q})
function f(u: {[i32]: P} | {[i32]: Q} | null) { u is {[i32]: P} }
print(f(mp))
print(f(null))
function g(): {[i32]: P} | {[i32]: Q} | null { mp }
const r = g()
if r != null { print(r[1]?.a ?? 0) }
const n: {[i32]: P} | {[i32]: Q} | null = null
print(n is {[i32]: Q})
