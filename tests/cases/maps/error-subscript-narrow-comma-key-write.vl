// @check
// @error 'm["a,b"]' is no longer narrowed to i32: the call to 'clr' on line 16 may reassign it
// @error 'g["a,b"]' is no longer narrowed to i32: the call to 'clrFree' on line 24 may reassign it
// @error operator '+' is not defined for i32 | null and i32
// A key holding a comma is one cell like any other, so a write to it through a parameter, a
// free variable or an alias ends its narrowing, as the comma-free key's does (D6400).
function clr(m: {[string]: i32 | null}) { m["a,b"] = null }

const g: {[string]: i32 | null} = Map()
function clrFree() { g["a,b"] = null }

export function viaParam() {
  const m: {[string]: i32 | null} = Map()
  m["a,b"] = 1
  if m["a,b"] != null {
    clr(m)
    print(m["a,b"] + 1)
  }
}

export function viaFree() {
  g["a,b"] = 1
  if g["a,b"] != null {
    clrFree()
    print(g["a,b"] + 1)
  }
}

export function viaAlias() {
  const m: {[string]: i32 | null} = Map()
  m["a,b"] = 1
  if m["a,b"] != null {
    const q = m
    q["a,b"] = null
    print(m["a,b"] + 1)
  }
}
