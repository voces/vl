// @run
// @log S
// @log a
// @log b
// @log S
// @log S
// @log NONE
// @log S
// @log 1
// @log 2
// @log S
// @log S
// @log NONE
// @log S
// @log a
// @log b
// @log S
// @log S
// @log NONE
// @log S
// @log 5
// @log 6
// @log S
// @log S
// @log NONE
// @log S
// @log 7
// @log 8
// @log S
// @log S
// @log NONE
// @log S
// @log 5
// @log 6
// @log S
// @log S
// @log NONE
// @log S
// @log 2
// @log S
// @log 0
// @log S
// @log NONE
// A NARROWED nullable map (`{[K]: V} | null` past a `!= null` guard) is ITERABLE by
// `.keys()`, `.values()` and the bare `for k in m` — the map twin of the narrowed
// nullable-LIST iterable. The narrowed cell still holds a `(ref null $mapStruct)`, so
// the receiver's ONE evaluation recovers it (`pushMapRecvRef`'s `ref.as_non_null`)
// before the `(ref $mapStruct)` mapRef store; without that recover the module is
// `vl check`-CLEAN INVALID WASM (`type mismatch: expected (ref $type), found
// (ref null $type)`) rather than any diagnostic.
//
// EVERY LEG IS GRADED ON ALL THREE RUNTIME INPUTS, because a nullable receiver graded
// on one input is not graded: mode 2 = present and populated, mode 1 = present and
// EMPTY (the loop must run zero times, not trap on an empty backing), mode 0 = NULL
// (the guard's else-arm, so the loop is never reached at runtime while its code is
// still emitted and validated).
//
// Legs: `.keys()` / `.values()` / bare, over the string-keyed rep and over the
// i32-KEYED rep (whose mapRef local is its own frame slot, not the shared scratch
// slot 0). The `.size` leg is the SIBLING CONTROL that always worked — it reaches the
// same map through `emitMapRecvKey`, which has carried the recover all along; keeping
// it here pins that the two receiver paths now agree.
//
// WHY THIS HID: `.size` on a narrowed nullable map is clean, so the shape looked
// covered; only the for-in receiver path lacked the recover, and it produced no
// message at all — nothing to grep for, and `vl check` said "no errors".

function makeStr(mode: i32): {[string]: i32} | null {
  print("S")
  if mode == 0 {
    return null
  }
  const m: {[string]: i32} = Map()
  if mode == 2 {
    m["a"] = 1
    m["b"] = 2
  }
  return m
}

function strKeys(mode: i32) {
  const nm = makeStr(mode)
  if nm == null {
    print("NONE")
  } else {
    for k in nm.keys() {
      print(k)
    }
  }
}

function strValues(mode: i32) {
  const nm = makeStr(mode)
  if nm == null {
    print("NONE")
  } else {
    for v in nm.values() {
      print(v)
    }
  }
}

function strBare(mode: i32) {
  const nm = makeStr(mode)
  if nm == null {
    print("NONE")
  } else {
    for k in nm {
      print(k)
    }
  }
}

function strSize(mode: i32) {
  const nm = makeStr(mode)
  if nm == null {
    print("NONE")
  } else {
    print(nm.size)
  }
}

function makeI32(mode: i32): {[i32]: i32} | null {
  print("S")
  if mode == 0 {
    return null
  }
  const m: {[i32]: i32} = Map()
  if mode == 2 {
    m[5] = 7
    m[6] = 8
  }
  return m
}

function i32Keys(mode: i32) {
  const nm = makeI32(mode)
  if nm == null {
    print("NONE")
  } else {
    for k in nm.keys() {
      print(k)
    }
  }
}

function i32Values(mode: i32) {
  const nm = makeI32(mode)
  if nm == null {
    print("NONE")
  } else {
    for v in nm.values() {
      print(v)
    }
  }
}

function i32Bare(mode: i32) {
  const nm = makeI32(mode)
  if nm == null {
    print("NONE")
  } else {
    for k in nm {
      print(k)
    }
  }
}

strKeys(2)
strKeys(1)
strKeys(0)
strValues(2)
strValues(1)
strValues(0)
strBare(2)
strBare(1)
strBare(0)
i32Keys(2)
i32Keys(1)
i32Keys(0)
i32Values(2)
i32Values(1)
i32Values(0)
i32Bare(2)
i32Bare(1)
i32Bare(0)
strSize(2)
strSize(1)
strSize(0)
