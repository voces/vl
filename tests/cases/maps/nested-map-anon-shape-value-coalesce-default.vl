// @run
// @log 7
// @log 7
// @log 7
// @log 7
// GRADUATED from `tests/cases/soundness/xfail-miscompile-nested-map-anon-shape-value.vl`
// (silent-class-inventory D112, closed 2026-08-27). The first program below is that pin
// byte-for-byte: a NESTED MAP whose inner value is an ANONYMOUS object shape, with NOT ONE
// DECLARED TYPE in it, read back through `?? Map()`.
//
// WHAT IT PINS is the `??` DEFAULT's map seed. `emitMapValDefault` is the boundary that
// emits `d` in `m[k] ?? d` for a ref-valued map slot, and it had an arm for every value
// kind — scalar, union box, struct list, string/f64/i64/f32 list, struct, nullable niche —
// except a NESTED MAP. Unseeded, `emitMapNew` read the ambient `pendingMapSlot` (-1) and
// `struct.new`'d the MONO i32-valued map struct into a vals element typed for the inner
// map's own struct: `vl check` rc 0, engine refuses. The seed is `mvValIsMap` /
// `mvInnerMapShape`, the map STORE boundary's own pair, called one line away in
// `emitMapSetV` and never called here.
//
// THE MESSAGE SAID `expected (ref null $type), found (ref $type)` AND THE NULLABILITY WAS A
// RED HERRING — the two `$type`s were two different heap types behind one placeholder
// (the inner map's struct, and the mono one). Probed at the site rather than read off the
// sentence, which is the reading the row was originally filed under.
//
// The last three programs are the axes that bracket it, and each one RAN BEFORE the fix:
// one nesting level less, a MONO inner value, and a named default of the right type. Keep
// them — they are what says the trigger is the inner map's ref value cell reached through
// the outer read, not nesting as such and not the anonymous shape as such.
function mk(n: i32) {
  const i0 = Map()
  i0["k"] = { r: n }
  const c = Map()
  c["o"] = i0
  return c
}
print((((mk(7))["o"] ?? Map())["k"] ?? { r: 0 }).r)

// one nesting level less
function mk1(n: i32) {
  const c = Map()
  c["k"] = { r: n }
  return c
}
print(((mk1(7))["k"] ?? { r: 0 }).r)

// a MONO inner value
function mkm(n: i32) {
  const i0 = Map()
  i0["k"] = n
  const c = Map()
  c["o"] = i0
  return c
}
print(((mkm(7))["o"] ?? Map())["k"] ?? 0)

// a NAMED default of the right type, instead of the bare `Map()`
const d = Map()
d["z"] = { r: 0 }
print((((mk(7))["o"] ?? d)["k"] ?? { r: 0 }).r)
