// @run
// @log 1
// @log 8
// A `Map()` binding delivered as a map of a wider record keeps its own type when another read
// needs it: adoption is all-or-nothing, so `v.r + 1` still reads an `i32`.

type Circle = { r: i32 | null }

function count(x: {[string]: Circle}) { print(x.length) }
const lv = Map()
lv["k0"] = { r: 7 }
count(lv)
const v = lv["k0"]
if v != null { print(v.r + 1) }
