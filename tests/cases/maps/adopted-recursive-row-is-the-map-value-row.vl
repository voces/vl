// @run
// @log 1
// @log 1
// @log 2
// @log 3
// @log 2

// A record literal stored in an un-annotated `Map()` beside a declared record of the same
// field names, one of them nullable and nesting a record, is held as that record (D9963):
// with a `null` field, behind a `??` default, nesting a second literal, and non-recursive.

type Node = {v: i32, next: Node | null}
type Q = {w: i32}
type Box = {b: i32, inner: Q | null}

const m = Map()
m["a"] = { v: 1, next: null }
const n = m["a"]
if n != null { print(n.v) }
const d = m["z"] ?? { v: 0, next: null }
print(d.v + m.length)

const deep = Map()
deep["a"] = { v: 1, next: { v: 2, next: null } }
const top = deep["a"]
if top != null { print(top.next.v) }

const boxes = Map()
boxes["a"] = { b: 3, inner: null }
const bx = boxes["a"]
if bx != null { print(bx.b) }
boxes["b"] = { b: 4, inner: null }
print(boxes.length)
