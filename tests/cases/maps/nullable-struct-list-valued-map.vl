// @run
// @log 2
// @log 14.5
// @log N
// @log 0
// @hint redundant type annotation: `v` is inferred as `{[string]: {f: f64}[] | null}` — remove it to lean on inference
// A map whose VALUE is a nullable list of an INLINE struct
// (`{[string]: {f: f64}[] | null}`) — the shape that filed the whole nullable-list map value
// as a loud reject (fuzz frontier seed 615401451 d6 --branching, p2c).
//
// IT IS THE ORDERING CASE, AND IT IS WHY THE LIST ARM HAS TO SIT ABOVE THE STRUCT PROBE.
// `structIndexByValName`'s field-name parse ignores a trailing `[]`, so `{f: f64}[]` matches
// the ELEMENT struct `{f: f64}` and the slot mints kind 1 — a `(ref null $struct)` vals
// element that the list store then pushes a `(ref $rlWrap)` into: INVALID WASM at `vl check`
// rc 0. The original remedy excluded every list inner from `nulRefMapValInnerOf`, which kept
// the reject loud but cost the whole niche; naming the list arm FIRST answers kind 6 — the
// same kind the non-nullable `{[string]: {f: f64}[]}` value gets — so the mis-parse below it
// is never reached.
//
// The sibling `maps/nullable-list-valued-map.vl` covers the leaf and ref-element reps of the
// same niche; this file is here for the inline-struct ELEMENT specifically, because that is
// the spelling the ordering hazard needs.
function makeIt(): {[string]: {f: f64}[] | null} {
  const h0: {[string]: {f: f64}[] | null} = Map()
  h0["k"] = [{ f: 4.0 }, { f: 14.5 }]
  h0["n"] = null
  return h0
}
function go() {
  const v: {[string]: {f: f64}[] | null} = makeIt()
  const rk = v["k"]
  if rk != null {
    print(rk.length)
    print(rk[1].f)
  } else {
    print("N")
  }
  const rn = v["n"]
  if rn != null { print(rn.length) } else { print("N") }
  print((v["n"] ?? []).length)
}
go()
