// @run
// @log 99
// @log 7
// @log true
// @log -1
// @log 7
// @log false
// @log 2.5
// @log true
// @log 4
// @log -1
// A map read whose `??` default is nullable stays `V | null` on the single-evaluation path
// too — a map whose own value is `scalar | null`, and a read keyed by a call, which is not
// re-read — so a stored value, a stored null and a miss each give the right answer (D2253, D2254).

function key(k: string) { k }

const m: {[string]: i32 | null} = Map()
m["a"] = null
m["b"] = 7
const d: i32 | null = 99
const nothing: i32 | null = null
print(m["a"] ?? d ?? -1)
print(m["b"] ?? d ?? -1)
print((m["a"] ?? nothing) == null)
print((m[key("z")] ?? nothing) ?? -1)

const n: {[string]: i32} = Map()
n["b"] = 7
print(n[key("b")] ?? nothing ?? -1)
print((n[key("z")] ?? d) == null)

const fm: {[string]: f64} = Map()
fm["x"] = 2.5
const fd: f64 | null = null
print(fm[key("x")] ?? fd ?? -1.0)
print((fm[key("y")] ?? fd) is null)

const im: {[string]: i64 | null} = Map()
im["x"] = 4 as i64
const idf: i64 | null = null
print(im[key("x")] ?? idf ?? (-1 as i64))
print(im[key("y")] ?? idf ?? (-1 as i64))
