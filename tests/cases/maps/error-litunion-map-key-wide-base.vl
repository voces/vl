// @check
// @error A F-keyed Map isn't supported yet
// @error A L-keyed Map isn't supported yet
// The BOUND on the literal-union map key. A member set hashes as i32 because its values rep
// as one — a string set as the interned atom, a numeric set as its own base — so a set whose
// base is `f64` or `i64` reps as neither and keeps the gate's refusal (D1748).
//
// The negative half of `litunion-map-key-every-consumer.vl`: without it, "a literal union
// hashes as i32" reads as a rule about the SPELLING rather than about the rep, and widening
// the gate to every `TyUnion` of `TyLit`s would pass every gate in the tree.
type F = 1.5 | 2.5
type L = 6000000000 | 7000000000

const fm: {[F]: i32} = Map()
const lm: {[L]: i32} = Map()
