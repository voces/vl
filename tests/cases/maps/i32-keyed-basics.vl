// @run
// @log 0
// @log 1
// @log 2
// @log 1
// @log 2
// @log -1
// @log true
// @log false
// @log 99
// @log 2
// @log true
// @log 1
// @log -1
// @log 20
// @log 1
// @log 20
// @log 1
// @log 2
// An i32-keyed `Map` (B6a): `{[i32]: V}` is the SAME ordered open-addressing hash
// map as `{[string]: V}` with one field re-typed — `keys` is the i32 list instead
// of the string-ref list — so the whole string-keyed surface mirrors here:
// `Map()`, `m[k] = v`, `m[k]` reading `V | null`, `.length`, `.has`, `.delete`,
// `.keys()`, `.values()` and bare `for k in m`. The KEY difference is only the
// hash (an integer mix, `fbI32HashMix`) and the compare (`i32.eq` instead of a
// call into `__str_eq__`); the probe, resize, tombstones and compaction are
// literally the same machinery. This file is the twin of `basics.vl` plus the
// iteration/keys/values surface, so a divergence between the two reps shows up
// as a diff between two fixtures that read line for line the same.
const m: {[i32]: i32} = Map()
print(m.length)            // 0

m[10] = 1
print(m.length)            // 1
m[20] = 2
print(m.length)            // 2

print(m[10] ?? -1)         // 1
print(m[20] ?? -1)         // 2
print(m[99] ?? -1)         // -1 — absent → null

print(m.has(10))           // true
print(m.has(99))           // false

// overwrite: value changes, size unchanged.
m[10] = 99
print(m[10] ?? -1)         // 99
print(m.length)            // 2

// delete tombstones: `has` goes false, `length` drops, a read is null.
print(m.delete(10))        // true
print(m.length)            // 1
print(m[10] ?? -1)         // -1

// `.keys()` builds a fresh i32 list of the LIVE keys, in insertion order.
const ks = m.keys()
print(ks[0])               // 20
print(ks.length)           // 1

// bare `for k in m` walks the same live keys with no intermediate list.
let last = 0
let n = 0
for k in m {
  last = k
  n = n + 1
}
print(last)                // 20
print(n)                   // 1

// `.values()` is the i32 vals list (the mono rep, shared with the string twin).
const vs = m.values()
print(vs[0])               // 2 — key 20's value; key 10's entry was deleted
