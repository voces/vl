// @run
// @log 4
// A function declared to return a wider record, its result set into a map of that record, stores
// the declared record's row although a record of the literal's own fields is declared (D3342).
type O = { v: i32 }
type I = { f: O }
type J = { f: O | null }
function mk(): J { { f: { v: 4 } } }
const m = Map<string, J>()
m.set("a", mk())
const x = m.get("a") ?? { f: { v: 9 } }
print(x.f?.v ?? 70)
