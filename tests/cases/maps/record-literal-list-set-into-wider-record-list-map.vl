// @run
// @log 3.5
// @log 0.5
// D3200: a bound list of record literals delivered by `m.set` into a map of a list of a record
// storing `v` as `f64` takes that list type, so it is stored at the map's row, and its own reads
// compute at `f64`.
type R = { v: f64, w: i32 }
const ls = [{ v: 1, w: 3 }]
const m: {[string]: R[]} = Map()
m.set("a", ls)
const q = m.get("a")
if q != null { print(q[0].v / 2.0 + q[0].w) }
print(ls[0].v / 2)
