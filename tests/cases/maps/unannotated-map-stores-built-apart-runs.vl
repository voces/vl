// @run
// @warning Unused variable `wideK`
// @log 4
// Two makers' calls stored into one un-annotated `Map()`, one also delivered at `J` and one at a
// field union `i32 | string`, are each copied where they land (D14517, D15714).
type J = { f: i32 | null }
type K = { f: i32 | string }
function mk() { { f: 4 } }
function mk2() { { f: 6 } }
const wideJ: J = mk()
const wideK: K = mk2()
const m = Map()
m.set("a", mk())
m.set("b", mk2())
print(wideJ.f ?? 0)
