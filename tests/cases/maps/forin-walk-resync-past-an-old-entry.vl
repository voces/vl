// @run
// @log 46 6 1 1
// REGRESSION (D2323): a walk resyncs by entry sequence after an insert in its body compacts the
// map, and an entry far older than the walk's own must still read as earlier. Two permanent
// keys, then churn, then a walk that deletes each entry it visits (other than the two) and
// inserts a new one, 40 times, which compacts mid-walk. JS `Map` visits 46 entries and each
// permanent key once. The row's hand-run witness puts 2^30 + 64 churn inserts between the two
// keys and the walk (about 45 s), which is what wrapped a 31-bit sequence; this is its shape.
const m: {[i32]: i32} = Map()
m[-1] = -1
m[-2] = -2
let k = 0
while k < 10000 {
  m[k] = k
  if k >= 4 { m.delete(k - 4) }
  k = k + 1
}
let visits = 0
let added = 0
let seen1 = 0
let seen2 = 0
for x in m {
  visits = visits + 1
  if x == -1 { seen1 = seen1 + 1 }
  if x == -2 { seen2 = seen2 + 1 }
  if x != -1 && x != -2 && added < 40 {
    m.delete(x)
    added = added + 1
    m[-100 - added] = x
  }
}
print("\{visits} \{m.length} \{seen1} \{seen2}")
