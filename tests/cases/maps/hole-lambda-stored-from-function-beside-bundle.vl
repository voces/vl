// @run
// @log true
// @log true
// @hint Intentionally-unused variable `_a` (leading `_` marks it unused)
// @hint Intentionally-unused variable `_b` (leading `_` marks it unused)
// A hole lambda stored into a map whose slot holds a bundle's record, at module scope and from a
// function, is built as that record at its signatures (D17572).
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
const m = Map()
m["a"] = lap((a) => a + 1)
m["b"] = (a) => a * 2
print(m.has("b"))
function g() {
  m["c"] = (a) => a * 3
  return m.has("a")
}
print(g())
