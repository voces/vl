// A map read of a two-signature bundle is the bundle's record or `null`; its holder keeps the
// `null`, so a missing key reads as a miss, not a trap. Q58 sweep: a module holder and a function's,
// each by index and by `get`, key missing and present, called through after narrowing; a module
// holder captured by a lambda; a map of plain values beside them. A function's captured is D17585.
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
const m = Map()
m["a"] = lap((a) => a * 2)
const h = m["z"]
if h != null { print(h(1.5) + h(4)) } else { print("map miss") }
const hp = m["a"]
if hp != null { print(hp(1.5) + hp(1.5)) } else { print("map miss") }
const hg = m.get("z")
if hg != null { print(hg(1)) } else { print("map miss") }
const h2 = m.get("a")
if h2 != null { print(h2(1)) } else { print("map miss") }
const seen = () => h != null
print(seen())
const seenP = () => hp != null
print(seenP())
function inFn() {
  const k = Map()
  k["a"] = lap((a) => a + 1)
  const g = k.get("q")
  if g != null { print(g(1)) } else { print("map miss") }
  const g2 = k["a"]
  if g2 != null { print(g2(1.5) + g2(4)) } else { print("map miss") }
  const g3 = k["q"]
  if g3 != null { print(g3(1)) } else { print("map miss") }
  const g4 = k.get("a")
  if g4 != null { print(g4(1)) } else { print("map miss") }
}
inFn()
const p = Map()
p["x"] = 11
const q = p["y"]
if q != null { print(q) } else { print("map miss") }
