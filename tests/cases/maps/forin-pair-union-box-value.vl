// @run
// @log a
// @log 3
// @log 3
// @log 2.5
// @log s
// @log none
// @log t
// @log 4
// @log 7
// A `for k, v in m` walk over a map whose value is a union box binds `v` as that union, the
// same as `m.values()` does: it prints, narrows, coalesces and passes at every value union.
function show(u: i32 | null) { print(u ?? -1) }

const m: {[string]: i32 | null} = Map()
m["a"] = 3
for k, v in m {
  print(k)
  print(v)
  show(v)
}

const f: {[i32]: f64 | null} = Map()
f[1] = 2.5
for k, v in f {
  if v != null { print(v) }
}

const s: {[string]: string | null} = Map()
s["x"] = "s"
s["y"] = null
for k, v in s { print(v ?? "none") }

const u: {[string]: i32 | string} = Map()
u["p"] = "t"
u["q"] = 4
for k, v in u {
  if v is string { print(v) } else { print(v) }
}

function main() {
  const g: {[i32]: i64 | null} = Map()
  g[0] = 7
  for k, v in g {
    const x = v
    print(x)
  }
}

main()
