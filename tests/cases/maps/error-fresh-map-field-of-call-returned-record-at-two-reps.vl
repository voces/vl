// @emit-error emitProgram: a record field holds a fresh `Map()` whose values store functions at one rep while the record's row stores them at another
// A record a call returns holds a fresh map that the caller stores an un-annotated function into
// and calls through: the map is built at one rep of the function and the record's row stores
// another, which would not validate (D17015). The same record bound directly to a `const` runs.
function inc0(a) { return a + 1 }
function mk() { return { m: Map() } }
const v = mk()
v.m["k"] = { f: inc0 }
const r = v.m.get("k")
if r != null { print(r.f(3)) }
