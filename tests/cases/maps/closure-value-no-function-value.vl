// @log null
// @log null
// @log null
// @log null
// @log null
// @log null

// A map whose VALUE cell is a closure fat-pointer forces the function-value machinery on
// (`fnValUsed`) even though this module CONSTRUCTS no closure: there is no lambda, no bare
// function name used as a value, and every map here is empty or holds only `null`.
//
// A bare map read (`const r = mp[k]`) binds that value cell to a local, so the local's
// heap type is the closure fat-pointer struct — which exists only when the machinery is
// on. Without the flip the local claimed an index no closure struct occupied and the
// module was INVALID WASM at `vl check` rc 0 (`expected (ref null $type), found
// (ref null $type)`, two distinct indices printing one name); the narrowed CALL was the
// loud twin, "function-value call arity has no interned signature", because the value's
// `$fnsig` is interned by the same gate.
//
// Every spelling of "the value cell is a closure" is here: bare, nullable, the inline
// arrow, an i32 key, and the map reached through a module global / a struct field / a
// parameter.
//
// THE FLAG IS MODULE-WIDE, SO THIS FILE HAS TO STAY LAMBDA-FREE AND NARROW. A closure-ARRAY
// or closure-FIELD map value (`{[string]: F[]}`, `{[string]: {f: F}}`) reaches the machinery
// through its own annotation branch and is measured clean — but one such annotation ANYWHERE
// in this module turns the flag on for every function above it and this whole file passes
// vacuously. Both were in an earlier draft and scored it 0 wrong lines against master's seed.
// Keep them out.
//
// The counterpart control is `bare-read-nullable-value.vl`, whose closure-valued map DOES
// store a lambda: the machinery is on there for the ordinary reason, so a fix that only
// worked when a lambda exists cannot pass both files.

type F = (i32) => i32

const gm: {[string]: F} = Map()

function fromGlobal() {
  const r = gm["k"]
  if r != null { print(r(3)) } else { print("null") }
  0
}
fromGlobal()

function bareValue() {
  const mp: {[string]: F} = Map()
  const r = mp["k"]
  if r != null { print(r(3)) } else { print("null") }
  0
}
bareValue()

function nullableValue() {
  const mp: {[string]: F | null} = Map()
  mp["k"] = null
  const r = mp["k"]
  if r != null { print(r(3)) } else { print("null") }
  0
}
nullableValue()

function inlineSpelling() {
  const mp: {[string]: (i32) => i32} = Map()
  const r = mp["k"]
  if r != null { print(r(3)) } else { print("null") }
  0
}
inlineSpelling()

function i32Key() {
  const mp: {[i32]: F} = Map()
  const r = mp[3]
  if r != null { print(r(3)) } else { print("null") }
  0
}
i32Key()

type Holder = { m: {[string]: F} }

function fromField() {
  const h: Holder = { m: Map() }
  const r = h.m["k"]
  if r != null { print(r(3)) } else { print("null") }
  0
}
fromField()

function fromParam(mp: {[string]: F}) {
  const r = mp["k"]
  if r != null { print(r(3)) } else { print("null") }
  0
}

function callParam() {
  const mp: {[string]: F} = Map()
  fromParam(mp)
  0
}
callParam()
