// @run
// @log 30
// @log 2
// @log 7
// @log 9
// @log 1
// @log true
// @log added 5
// @log false
// @warning Unused parameter `self` (prefix with `_` to suppress, or remove it)
// A `self`-function whose `self` is a map or a set is reached by `recv.name(…)` like on any
// other receiver (D2477). Before, the map arm refused every name it did not own with `unknown
// property`. `get` and `set` are map members and not set members, so they reach a function on a
// `Set` receiver and stay the built-ins on a map; `add` is the reverse.
function total(self: {[string]: i32}) {
  let t = 0
  for k in self.keys() { t = t + (self[k] ?? 0) }
  t
}
function size(self: {[string]: i32}) { self.keys().length }
function get(self: Set<i32>, k: i32) { k + 6 }
function set(self: Set<i32>, k: i32, v: i32) { print(k + v) }
function add(self: {[i32]: boolean}, k: i32) { print("added \{k}") }
const m: {[string]: i32} = Map()
m["a"] = 10
m["b"] = 20
print(m.total())
print(m.size())
const s: Set<i32> = Set()
s.add(3)
print(s.get(1))
s.set(4, 5)
const b: {[i32]: boolean} = Map()
b[4] = true
print(b.keys().length)
print(b.get(4) ?? false)
b.add(5)
print(b.has(5))
