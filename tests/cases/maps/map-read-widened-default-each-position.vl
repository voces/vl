// `m[k] ?? d` whose default is a wider number than the map's scalar value, so a hit is widened to
// the `??`'s number: an `i32` map read at `f64` and `i64`, an `f32` map's at `f64`, a hit and a
// miss, a literal and a computed default, a global map, after an earlier operand, as a call
// argument, a returned value and a union's box, which a hit reaches as the wider number; and a
// default a call computes, joined with the value into a box or a boxed `T | null`.
// @run
// @log 2
// @log 0.5
// @log 7
// @log 9000000000
// @log 1.25
// @log 0.75
// @log 12.5
// @log 3.5
// @log 4
// @log 2.5
// @log f
// @log f
// @log 7
// @log 9000000000
// @log 2
// @log 5
// @log 0
type N = i32 | f64
function half() { return 0.5 }
function big() { return 9000000000 }
function maybe(n: i32): i32 | null { return if n > 0 { n } else { null } }
function orZero(v: i32 | null) { return v ?? 0 }
function show(v: N) { return if v is i32 { "i" } else { "f" } }
function asF(m: {[string]: i32}, k: string) { return m[k] ?? 0.5 }
function asL(m: {[string]: i32}, k: string) { return m[k] ?? 9000000000 }
function asF32(m: {[string]: f32}, k: string) { return m[k] ?? 0.75 }
function plus(a: f64, b: f64) { return a + b }
const g: {[string]: i32} = Map()
g["a"] = 3
const m: {[string]: i32} = Map()
m["x"] = 2
m["y"] = 7
const fm: {[string]: f32} = Map()
fm["p"] = 1.25
print(asF(m, "x"))
print(asF(m, "z"))
print(asL(m, "y"))
print(asL(m, "z"))
print(asF32(fm, "p"))
print(asF32(fm, "q"))
print(10 + (m["x"] ?? half()) + 0.5)
print(plus(0.5, g["a"] ?? 1.5))
print(1 + (g["a"] ?? half()))
print(plus(2, m["q"] ?? half()))
print(show(m["x"] ?? 1.5))
print(show(m["z"] ?? 1.5))
print(m["y"] ?? big())
print(m["z"] ?? big())
print(orZero(m["x"] ?? maybe(5)))
print(orZero(m["z"] ?? maybe(5)))
print(orZero(m["z"] ?? maybe(0)))
