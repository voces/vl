// NARROWING AN INFERRED MAP READ — `const v = m[k]` then `if v is V`.
//
// The annotated spelling was made CORRECT by #1901 (a miss no longer narrows as present);
// this is the same read with the annotation left off, which until now did not compile at
// all:
//
//     emitProgram: `is` test but no union type declared
//
// — on a two-line program with NO union declared anywhere. The annotated twin worked, and
// so did an inferred binding off a FUNCTION returning `V | null`, because that function's
// return ANNOTATION is what the registration walk reads. A map read has an annotation on
// neither side.
//
// TWO HALVES, and the ORDERING is why one was not enough. `collectU` is the FIRST emit
// pass and reads the annotation node directly, so it cannot wait for a synthesized one —
// it seeds its registration walk from the INITIALIZER's recorded type. The slot classifier
// runs twelve passes later and reads annotations, so `synthNullableAnn` writes the
// inferred type back AS an annotation for it, the same move `synthEmptyListAnn` makes for
// an un-annotated empty `[]`. Registration alone leaves `is names a type that is not a
// union variant`; the annotation alone is never seen.
//
// SCOPED TO MAP READS, and the narrowing was forced by measurement. Claiming every
// box-rep nullable diverted WORKING bindings onto the annotated ladder — 9 corpus
// regressions, then 2 after excluding the niches by hand, and the survivors were nullable
// numeric LITUNIONS, which answer `tyScalarBaseIs(f64)` (they rep as their base scalar)
// while their nullable reps as the `-1` niche. The base-scalar question and the
// nullable-rep question have different answers there.
// @run
// @log absent
// @log 7
// @log absent
// @log 7
// @log absent
// @log 1.5
// @log absent
// @log 1.5
// @log absent
// @log true
// @log absent
// @log x
// @log 7
// @log absent
// @log 3
// @log -1
// `vl0` is deliberately a `let` — the classifier ladder treats `let` and `const` through
// different arms and this file pins both. It is never reassigned, so the lint fires and
// is declared rather than silenced.
// @info `vl0` is never reassigned; use `const` instead of `let`

// ── the four BOX widths: the ones that did not compile ──
const mi: {[string]: i32} = Map()
mi["a"] = 7
const vi0 = mi["nope"]
if vi0 is i32 {
  print("WRONG") // absent
} else {
  print("absent")
}
const vi1 = mi["a"]
if vi1 is i32 {
  print(vi1) // 7
} else {
  print("WRONG")
}

const mq: {[string]: i64} = Map()
mq["a"] = 7
const vq0 = mq["nope"]
if vq0 is i64 {
  print("WRONG") // absent
} else {
  print("absent")
}
const vq1 = mq["a"]
if vq1 is i64 {
  print(vq1) // 7
} else {
  print("WRONG")
}

const md: {[string]: f64} = Map()
md["a"] = 1.5
const vd0 = md["nope"]
if vd0 is f64 {
  print("WRONG") // absent
} else {
  print("absent")
}
const vd1 = md["a"]
if vd1 is f64 {
  print(vd1) // 1.5
} else {
  print("WRONG")
}

const mf: {[string]: f32} = Map()
mf["a"] = 1.5
const vf0 = mf["nope"]
if vf0 is f32 {
  print("WRONG") // absent
} else {
  print("absent")
}
const vf1 = mf["a"]
if vf1 is f32 {
  print(vf1) // 1.5
} else {
  print("WRONG")
}

// ── the two NICHE widths, as the inverted control: they compiled before and must be
//    untouched, since claiming them is exactly what broke the corpus ──
const mb: {[string]: boolean} = Map()
mb["a"] = true
const vb0 = mb["nope"]
if vb0 is boolean {
  print("WRONG") // absent
} else {
  print("absent")
}
const vb1 = mb["a"]
if vb1 is boolean {
  print(vb1) // true
} else {
  print("WRONG")
}

const ms: {[string]: string} = Map()
ms["a"] = "x"
const vs0 = ms["nope"]
if vs0 is string {
  print("WRONG") // absent
} else {
  print("absent")
}
const vs1 = ms["a"]
if vs1 is string {
  print(vs1) // x
} else {
  print("WRONG")
}

// ── an i32-KEYED map: the fourCC rule-table shape this was reported against ──
const mk: {[i32]: i32} = Map()
mk[1214603620] = 7
const vk1 = mk[1214603620]
if vk1 is i32 {
  print(vk1) // 7
} else {
  print("WRONG")
}
const vk0 = mk[999]
if vk0 is i32 {
  print("WRONG") // absent
} else {
  print("absent")
}

// ── `let` rather than `const`, and inside a FUNCTION (a wasm local, not a global) ──
let vl0 = mi["a"]
if vl0 is i32 {
  print(3) // 3
} else {
  print("WRONG")
}

function inFn() {
  const m: {[i32]: f64} = Map()
  m[5] = 2.5
  const v = m[9]
  if v is f64 { return 0 }
  return 0 - 1
}
print(inFn()) // -1
