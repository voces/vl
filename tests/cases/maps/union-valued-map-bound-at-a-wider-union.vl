// @run
// @log 4
// @log x
// @log x
// A map of union-boxed values bound at a map of a wider union is the same map: both hold their
// values in the one box, so a module binding and a local each read it back by arm.
const m: {[string]: i32 | string} = Map()
m["a"] = 3
m["b"] = "x"
const w: {[string]: i32 | string | f64} = m
const va = w["a"]
if va is i32 { print(va + 1) }
const vb = w["b"]
if vb is string { print(vb) }
function f(q: {[string]: i32 | string}) {
  const lw: {[string]: i32 | string | f64} = q
  const lv = lw["b"]
  if lv is string { print(lv) }
}
f(m)
