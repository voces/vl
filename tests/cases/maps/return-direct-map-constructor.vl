// @run
// @log 0
// @log 1
// @log s
// @log 0
// @log 2.5
// @log 0
// @log 9
// @log 0
// @log 0
// A `return Map()` — the map CONSTRUCTOR directly in return position — builds the
// RETURN ANNOTATION's `$mapStruct`, not the shared mono i32 one. Every non-mono value
// type is at risk (`string`, `f64`, a struct, a list, a nested map): the functype result
// is the value-typed map struct, so a mono `struct.new` there is invalid wasm inside the
// returning function itself. A `return m` over a map VARIABLE was never at risk — the
// value is already built — which is why only the direct constructor needs the seed.

function emptyStrMap(): {[string]: string} { return Map() }

function emptyF64Map(): {[string]: f64} { return Map() }

type W = {w: i32}

function emptyStructMap(): {[string]: W} { return Map() }

function emptyListMap(): {[string]: i32[]} { return Map() }

function emptyNestedMap(): {[string]: {[string]: i32}} { return Map() }

const sm = emptyStrMap()
print(sm.size) // 0
sm["k"] = "s"
print(sm.size) // 1
print(sm["k"] ?? "?") // s

const fm = emptyF64Map()
print(fm.size) // 0
fm["k"] = 2.5
print(fm["k"] ?? 0.0) // 2.5

const wm = emptyStructMap()
print(wm.size) // 0
wm["k"] = { w: 9 }
const got = wm["k"]
if got != null {
  print(got.w) // 9
}

const lm = emptyListMap()
print(lm.size) // 0

const nm = emptyNestedMap()
print(nm.size) // 0
