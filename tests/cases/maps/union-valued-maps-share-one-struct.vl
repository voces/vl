// @run
// @log 4
// @log x
// @log true
// @log false
// @log false
// @log true
// @log 3
// Every union value is the one shared box, so maps whose values are two different unions store
// alike: a delivery between them shares the map, and each keeps its own tag in a union.
type Circle = { r: i32 }
type Sq = { s: i32 }
const m: {[string]: i32 | string} = Map()
m["a"] = 3
m["b"] = "x"
const w: {[string]: i32 | string | f64} = m
const va = w["a"]
if va is i32 { print(va + 1) }
const vb = w["b"]
if vb is string { print(vb) }
function pick(
  c: boolean,
): {[string]: i32 | string} | {[string]: i32 | string | f64} {
  if c { return m }
  const n: {[string]: i32 | string | f64} = Map()
  n["z"] = 1.5
  n
}
print(pick(true) is {[string]: i32 | string})
print(pick(false) is {[string]: i32 | string})
print(pick(true) is {[string]: i32 | string | f64})
print(pick(false) is {[string]: i32 | string | f64})
function show(ws: {[string]: Circle | Sq | null}) {
  const v = ws["a"]
  if v is Circle { print(v.r) }
}
const cs: {[string]: Circle | Sq} = Map()
cs["a"] = { r: 3 }
show(cs)
