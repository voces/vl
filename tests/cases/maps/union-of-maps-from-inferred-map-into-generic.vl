// @run
// @log true
// @log 1
// D10232: a union of maps read out of an un-annotated map and narrowed non-null keeps `| null`
// in its spelling; handed to a generic over `{[string]: V} | {[string]: string}` it binds `V`.
function mk(): {[string]: i32} | {[string]: string} {
  const s: {[string]: i32} = Map()
  s["q"] = 5
  s
}
function h<V>(m: {[string]: V} | {[string]: string}, k: string) { m.has(k) }
function n<V>(m: {[string]: V} | {[string]: string}) { m.values().length }
const outer = Map()
outer["k"] = mk()
const mv = outer["k"]
if mv != null {
  const v = mv
  print(h(v, "q"))
  print(n(v))
}
