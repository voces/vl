// @run
// @log 1
// @log 6
// @log 1
// @log yes
// @log none
// @log 9
// @log 9
// @log 8
// @log 4
// @log 2.5
// @log 1.5
// @log -1
// @log -1
// @log 3
// @log s
// `k?.get(key)` over a nullable map reads `k[key]` under the `?.` guard, at a scalar, string,
// nullable, record and f64 value, through a field receiver and in a generic's body (D10030).
function f(k: {[string]: i32} | null) { (k?.get("a") ?? 0) + 1 }
print(f(null))
const m: {[string]: i32} = Map()
m["a"] = 5
print(f(m))
type H = { m: {[string]: i32} | null }
const h: H = { m: null }
print((h.m?.get("a") ?? 0) + 1)
function s(k: {[string]: string} | null) { k?.get("a") ?? "none" }
const ms: {[string]: string} = Map()
ms["a"] = "yes"
print(s(ms))
print(s(null))
function n(k: {[string]: i32 | null} | null) { k?.get("a") ?? 9 }
const mn: {[string]: i32 | null} = Map()
mn["a"] = null
print(n(mn))
print(n(null))
type P = { x: i32 }
function r(k: {[string]: P} | null) { (k?.get("a") ?? { x: 4 }).x }
const mp: {[string]: P} = Map()
mp["a"] = { x: 8 }
print(r(mp))
print(r(null))
function d(k: {[string]: f64} | null) { k?.get("a") ?? 1.5 }
const mf: {[string]: f64} = Map()
mf["a"] = 2.5
print(d(mf))
print(d(null))
const xs: ({[string]: i32} | null)[] = [Map(), null]
for x in xs { print(x?.get("a") ?? -1) }
function look<V>(k: {[string]: V} | null): V | null { k?.get("a") }
const gi: {[string]: i32} = Map()
gi["a"] = 3
const ri = look(gi)
if ri != null { print(ri) }
const gs: {[string]: string} = Map()
gs["a"] = "s"
const rs = look(gs)
if rs != null { print(rs) }
