// A null-field record literal stored into a map whose value type has a struct row of its own is
// built at that row, beside the union arm its shape is narrower than (D17728): at top level, read
// by a miss and a hit, and in a function.
type Circle = { r: i32 | null }
type Sq = { s: i32 }
type Shape = Circle | Sq
const m: {[string]: {r: null}} = Map()
m["k"] = { r: null }
const n = m["q"]
print(n == null)
const h = m["k"]
print(h != null)
function f() {
  const fm: {[string]: {r: null}} = Map()
  fm["k"] = { r: null }
  const got = fm["k"]
  print(got != null)
  print(fm["z"] == null)
}
f()
