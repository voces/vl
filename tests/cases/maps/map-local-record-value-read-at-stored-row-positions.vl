// @run
// @log 1
// @log 4
// @log 4
// @log 1
// @log 4
// @log true
// @log 1
// A map local whose record value holds a record that widens only through a later view at `J`: the
// local is held at the row it is stored at, and each read follows that row: an optional chain, a
// narrowed local, a default under `??`, a values loop, a null test and an argument.
type J = { f: i32 | null }
function size(w: {[string]: { x: J }}) { return w.length }
function reads() {
  const m = Map()
  m.set("a", { f: 4 })
  const g: {[string]: J} = m
  print(g.length)
  const d = { f: 1 }
  const w = Map()
  w.set("b", { x: m.get("a") ?? d })
  print(w.get("b")?.x.f ?? 0)
  const r = w.get("b")
  if r != null { print(r.x.f ?? 0) }
  print((w.get("z") ?? { x: d }).x.f ?? 0)
  for v in w.values() { print(v.x.f ?? 0) }
  print(w.get("z") == null)
  print(size(w))
}
reads()
