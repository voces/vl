// @run
// @log k
// @log k
// @log 1
// @log 1
// @log 1
// D10172, D10173: a `for` over a value typed as a union of two map types, with one and two
// loop variables, its `.values().length`, and the same walk inside a generic.
const s: {[string]: string} = Map()
s["k"] = "x"
const us: {[string]: string} | {[string]: i32} = s
for k in us { print(k) }
for k, v in us { print(k) }
print(us.values().length)
function f<V>(m: {[string]: V} | {[string]: string}) {
  let c = 0
  for k, v in m { c = c + 1 }
  c
}
const a: {[string]: i32} = Map()
a["q"] = 5
print(f(a))
print(f(s))
