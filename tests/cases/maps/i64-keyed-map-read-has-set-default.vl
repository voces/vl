// @run
// @log 1
// @log true
// @log false
// @log 7
// @log -1
// An `i64`-keyed map's key written at its own width at a read, `has`, a store and a default read.
function keyed(k: i32) {
  const m: {[i64]: i32} = Map()
  m.set(8, 1)
  m[k] = 7
  print(m[8] ?? 0)
  print(m.has(8))
  print(m.has(9))
  print(m[k] ?? 0)
  print(m[100] ?? -1)
}
keyed(5)
