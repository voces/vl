// @run
// @log aa
// @log xx
// D7448: a `??` over an atom-valued map read with a `string` default that is not a member
// joins to `string`: a hit decodes the atom to its text, a miss takes the default.
type K0 = "aa" | "bb"

function go() {
  const m: {[string]: K0} = Map()
  m["k"] = "aa"
  const s = "xx"
  print(m["k"] ?? s)
  print(m["z"] ?? s)
}
go()
