// @run
// @log 2
// A param whose annotation is a UNION with a map MEMBER (`boolean | {[string]: string}`), and an
// alias-named map param beside it. Both reach `fnHasMapParam`, which decides whether a function
// needs the map scratch frame reserved.
//
// THE SPELLING CANNOT SEE THE ALIAS. `nameIsMap` cuts a `{[` out of anywhere in a rendering, so it
// catches the inline union arm — but `type M = {[string]: i32}` renders as `M` at a param
// annotation, and there is no `{[` to cut. The arena walks the type and finds the `TyMap` either
// way.
//
// AND THE EXACT ARENA TWIN CANNOT SEE THE UNION. `nodeTyIsMap` is `t is TyMap`, false for both the
// nullable and the union spellings, which is why substituting it moved 4 corpus rows. Width is
// part of a predicate's identity: the arena form has to match the WIDTH of the name form it
// replaces, not merely its subject.
//
// `nodeTyReachesMap` is the span twin — a `TyMap`, or one reached through a `TyNullable` hop or as
// a `TyUnion` member. This file pins both halves of what that width means.
type U = boolean | {[string]: string}
type M = {[string]: i32}

function viaUnion(u: U) {
  if u is boolean { return 1 }
  return 2
}

function viaAlias(m: M) {
  return m.size
}

const q: {[string]: string} = Map()
const r: M = Map()
r["k"] = 1
print(viaUnion(q) + viaAlias(r) - 1)
