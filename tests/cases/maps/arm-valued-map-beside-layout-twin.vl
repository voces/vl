// @run
// @log 7
// @log 9
// @log 3
// @log 4
// @log 5
// @log 6
// @hint redundant type annotation: `c` is inferred as `{r: i32}`
// @hint redundant type annotation: `d` is inferred as `{r: i32}`
// @hint redundant type annotation: `q` is inferred as `{p: i32}`
// @hint redundant type annotation: `p` is inferred as `{p: i32}`
// @hint Intentionally-unused variable `_z`
// @hint redundant type annotation: `dsc` is inferred as `{rad: i32}`
// @hint redundant type annotation: `trg` is inferred as `{rad: i32}`
// D48. AN ARM-VALUED MAP AND A LAYOUT-TWIN STRUCT-VALUED MAP IN ONE PROGRAM ARE TWO SLOTS.
//
// EVERY VALUE ANNOTATION BELOW IS LOAD-BEARING AND EVERY ONE DRAWS A REDUNDANCY HINT, which
// is exactly the shape this row is about: `Circle` is an arm of `Shape`, `Dot` is a
// standalone struct with the identical field set, and the hint's `{r: i32}` is the RENDER
// that cannot tell them apart. They are two WasmGC heap types in two tables that never merge
// (`DECISIONS.md`: the variant to struct-TABLE seam stays nominal), so `{[string]: Circle}`
// and `{[string]: Dot}` are two map structs over two vals element heaps. The hints are
// declared rather than the annotations deleted.
//
// The mv layer could not see that, because every name it holds is a RENDER: `tyToEmitName`
// spells the arm `{r:i32}`, character for character what it spells the twin and an
// anonymous shape, and re-resolving the render mints one shared anonymous arena index. Both
// rungs of a slot's identity — the arena key (`mvSlotOfTyK`) and the name scan
// (`mvSlotByValNameK`) — therefore collapsed the pair: the SECOND map found the first's
// slot, its mint never ran, and its store put a `(ref $Dot)` into a vals element typed
// `(ref null $uVarHeap[Circle])`. `vl check` rc 0, "type mismatch: expected (ref null
// $type), found (ref $type)" — the two `$type`s two different heap types behind one
// placeholder.
//
// The ARM is the third component of the identity, and `mvArmHintOfTy` (over
// `variantRowOfTy`, nominal by construction) is what supplies it. Three states, not two:
// "no type to ask" matches any slot and is what every un-hinted caller passes, so nothing
// they resolve moves; "a resolved type that is NOT an arm" is the state that stops the
// twin's mint from finding the arm's slot; "this arm" matches only that arm's slot.
//
// WHICH FUNCTION FAILED WAS THE DECLARATION ORDER, so both orders are below.

type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Dot = { r: i32 }
type CM = {[string]: Circle}
type DM = {[string]: Dot}

function mkC(i: i32) {
  const m: CM = Map()
  const c: Circle = { r: i }
  m["k"] = c
  return m
}

function mkD(i: i32) {
  const m: DM = Map()
  const d: Dot = { r: i }
  m["k"] = d
  return m
}

function rdC(v: CM) { const g = v["k"]; if g != null { return g.r }; return -1 }
function rdD(v: DM) { const g = v["k"]; if g != null { return g.r }; return -1 }

print(rdC(mkC(7)))
print(rdD(mkD(9)))

// THE TWIN DECLARED FIRST — the same pair, the other order. Before the fix the failure moved
// to whichever function came second and the count did not change.
type Pt = { p: i32 }
type Tri = { t3: i32 }
type Poly = Pt | Tri
type Q = { p: i32 }
type PM = {[string]: Pt}
type QM = {[string]: Q}

function mkQ(i: i32) {
  const m: QM = Map()
  const q: Q = { p: i }
  m["k"] = q
  return m
}

function mkP(i: i32) {
  const m: PM = Map()
  const p: Pt = { p: i }
  m["k"] = p
  return m
}

function rdQ(v: QM) { const g = v["k"]; if g != null { return g.p }; return -1 }
function rdP(v: PM) { const g = v["k"]; if g != null { return g.p }; return -1 }

print(rdQ(mkQ(3)))
print(rdP(mkP(4)))

// THE CONTROL THE FIX MUST NOT REDDEN, and it is the one a two-state parity gets wrong.
// `Disc` and `Trg` are arms of two DIFFERENT unions over one field set — `uVarTwin` layout
// twins, therefore ONE variant heap type — so their maps DO share a map struct and
// `repMapValSlotsTwin`'s kind-1 arm has to say so. That arm used to compare the arms'
// IDENTITIES, which was unreachable then (this row collapsed the pair before two kind-1
// slots could exist) and is wrong now: an identity test refuses this merge and emits two
// identical map structs that a `pass`-onward boundary then mixes — measured, 2 grid cells
// moving `runs` to check-clean invalid wasm. It compares HEAPS (`repVariantSlotsTwin`).
type Disc = { rad: i32 }
type Bar = { bw: i32 }
type Round = Disc | Bar
type Trg = { rad: i32 }
type Wedge = { ww: i32 }
type Angular = Trg | Wedge
type RM = {[string]: Disc}
type AM = {[string]: Trg}

function takeR(a: RM) { const _z = a  return 5 }
function takeA(a: AM) { const _z = a  return 6 }

function mkDisc(i: i32) {
  const m: RM = Map()
  const dsc: Disc = { rad: i }
  m["k"] = dsc
  return takeR(m)
}

function mkTrg(i: i32) {
  const m: AM = Map()
  const trg: Trg = { rad: i }
  m["k"] = trg
  return takeA(m)
}

print(mkDisc(5))
print(mkTrg(6))
