// @run
// @log 3.5
// @log 7.5
// @log 0
// @log 1
// @log 7
// @log 3
// @log 1.5
// @log 0
// @log 7.5
// @log 0.5
// @log 7
// @log 0
// @log true
// @log false
// @log s
// @log none
// `m[k]?.f ?? d` over a map of records reads an f64, i64 or f32 field, hit and miss, at both key
// kinds, with an integer-literal default widened to the field (D3459).
type F = { v: f64 }
type L = { v: i64 }
type G = { v: f32 }
type I = { v: i32 }
type B = { v: boolean }
type S = { v: string }
const mf: {[string]: F} = Map()
mf["a"] = { v: 7 }
print((mf["a"]?.v ?? 0.0) / 2)
mf["b"] = { v: 7.5 }
print(mf["b"]?.v ?? 0.0)
print(mf["z"]?.v ?? 0.0)
print(mf["z"]?.v ?? 1)
const ml: {[string]: L} = Map()
ml["a"] = { v: 7 }
print(ml["a"]?.v ?? 0)
print(ml["z"]?.v ?? 3)
const mg: {[string]: G} = Map()
mg["a"] = { v: 1.5 as f32 }
print(mg["a"]?.v ?? 0.0 as f32)
print(mg["z"]?.v ?? 0.0 as f32)
const kf: {[i32]: F} = Map()
kf[1] = { v: 7.5 }
print(kf[1]?.v ?? 0.0)
print(kf[2]?.v ?? 0.5)
const mi: {[string]: I} = Map()
mi["a"] = { v: 7 }
print(mi["a"]?.v ?? 0)
print(mi["z"]?.v ?? 0)
const mb: {[string]: B} = Map()
mb["a"] = { v: true }
print(mb["a"]?.v ?? false)
print(mb["z"]?.v ?? false)
const ms: {[string]: S} = Map()
ms["a"] = { v: "s" }
print(ms["a"]?.v ?? "none")
print(ms["z"]?.v ?? "none")
