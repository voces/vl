// @hint Intentionally-unused parameter
// @hint redundant type annotation: `five` is inferred as `i32`
// @hint redundant type annotation: `key` is inferred as `string`
// A map or record field store whose value is a boxed binding's `??`, at a scalar and at a wide
// default, into each receiver and key spelling and from each place a store sits.
type R = { f: i32 }
type W = { f: i32 | string }
let n = 0
function mkq(x: boolean): i32 | null { return if x { null } else { 2 } }
function mkw(x: boolean): i32 | string | null {
  return if x { null } else { "w" }
}
function five(): i32 {
  n = n + 1
  return 5
}
function six(): i32 | string {
  n = n + 1
  return 6
}
function key(): string { return "c" }
const gm: {[string]: i32} = Map()
const gw: {[string]: i32 | string} = Map()
const gr: R = { f: 0 }
const gx: W = { f: 0 }
function msPlit(m: {[string]: i32}, x: boolean) {
  const q = mkq(x)
  m["a"] = q ?? five()
}
function msPloc(m: {[string]: i32}, x: boolean) {
  const q = mkq(x)
  const k0 = "b"
  m[k0] = q ?? five()
}
function msPcall(m: {[string]: i32}, x: boolean) {
  const q = mkq(x)
  m[key()] = q ?? five()
}
function msLlit(m: {[string]: i32}, x: boolean) {
  const q = mkq(x)
  const lm = m
  lm["a"] = q ?? five()
}
function msLloc(m: {[string]: i32}, x: boolean) {
  const q = mkq(x)
  const lm = m
  const k0 = "b"
  lm[k0] = q ?? five()
}
function msLcall(m: {[string]: i32}, x: boolean) {
  const q = mkq(x)
  const lm = m
  lm[key()] = q ?? five()
}
function msGlit(_m: {[string]: i32}, x: boolean) {
  const q = mkq(x)
  gm["a"] = q ?? five()
}
function msGloc(_m: {[string]: i32}, x: boolean) {
  const q = mkq(x)
  const k0 = "b"
  gm[k0] = q ?? five()
}
function msGcall(_m: {[string]: i32}, x: boolean) {
  const q = mkq(x)
  gm[key()] = q ?? five()
}
function mwP(m: {[string]: i32 | string}, x: boolean) {
  const q = mkw(x)
  m["a"] = q ?? six()
}
function mwG(_m: {[string]: i32 | string}, x: boolean) {
  const q = mkw(x)
  gw["a"] = q ?? six()
}
function fsP(r: R, x: boolean) {
  const q = mkq(x)
  r.f = q ?? five()
}
function fsG(_r: R, x: boolean) {
  const q = mkq(x)
  gr.f = q ?? five()
}
function fwP(r: W, x: boolean) {
  const q = mkw(x)
  r.f = q ?? six()
}
function fwG(_r: W, x: boolean) {
  const q = mkw(x)
  gx.f = q ?? six()
}
function inIf(m: {[string]: i32}, x: boolean, c: boolean) {
  const q = mkq(x)
  if c { m["i"] = q ?? five() }
}
function inLoop(m: {[string]: i32}, x: boolean) {
  const q = mkq(x)
  for i in 0 until 2 { m["l"] = q ?? five() }
}
function inClosure(r: R, x: boolean) {
  const q = mkq(x)
  const f = () => {
    r.f = q ?? five()
  }
  f()
}
const lm0: {[string]: i32} = Map()
const lw0: {[string]: i32 | string} = Map()
const r0: R = { f: 0 }
const w0: W = { f: 0 }
for x in [true, false] {
  msPlit(lm0, x)
  msPloc(lm0, x)
  msPcall(lm0, x)
  msLlit(lm0, x)
  msLloc(lm0, x)
  msLcall(lm0, x)
  msGlit(lm0, x)
  msGloc(lm0, x)
  msGcall(lm0, x)
  mwP(lw0, x)
  mwG(lw0, x)
  fsP(r0, x)
  fsG(r0, x)
  fwP(w0, x)
  fwG(w0, x)
  inIf(lm0, x, true)
  inLoop(lm0, x)
  inClosure(r0, x)
  print(lm0["a"] ?? -1)
  print(lm0["b"] ?? -1)
  print(lm0["c"] ?? -1)
  print(gm["a"] ?? -1)
  print(gm["b"] ?? -1)
  print(gm["c"] ?? -1)
  print(lm0["i"] ?? -1)
  print(lm0["l"] ?? -1)
  print(lw0["a"] ?? -1)
  print(gw["a"] ?? -1)
  print(r0.f)
  print(gr.f)
  print(w0.f)
  print(gx.f)
  print(n)
}
const qs = mkq(true)
gm["s"] = qs ?? five()
gr.f = qs ?? five()
print(gm["s"] ?? -1)
print(gr.f)
print(n)
