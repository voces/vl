// @run
// @log b
// @log s
// D3123: a map a binding or a call feeds into an `M | null` record field keeps its code, so the
// literal builds the declared record.
type AB = "a" | "b"
type R = { m: {[i32]: AB} | null }
const lv: {[i32]: AB} = Map()
lv[2] = "b"
const r: R = { m: lv }
const e = r.m
if e != null { print(e[2] ?? "a") } else { print("null") }

type U = { m: {[i32]: i32 | string} | null }
function mkU(): {[i32]: i32 | string} {
  const q: {[i32]: i32 | string} = Map(); q[1] = "s"; q
}
function fu(): U { { m: mkU() } }
const ue = fu().m
if ue != null {
  const t = ue[1]
  if t is string { print(t) } else { print("other") }
} else {
  print("null")
}
