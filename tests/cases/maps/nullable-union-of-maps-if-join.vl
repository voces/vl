// @run
// @log true
// @log true
// @log false
// @log false
// @log true
// A value `if` with a `null` arm, bound to an annotated union of two maps and `null`, is the
// union box, not the nullable map its initializer reps as alone (D2683).
type IM = {[i32]: i32}
type SM = {[string]: i32}
type BM = {[i32]: boolean}
const ma: IM = Map()
const ms: SM = Map()
const mb: BM = Map()
const n = ma.length
const nn: IM | SM | null = if n == 0 { ms } else if n == 1 { ma } else { null }
print(nn is SM)
function h(k: i32) {
  const b: IM | BM | null = if k == 0 { mb } else { null }
  print(b is BM)
  print(b == null)
}
h(0)
h(1)
