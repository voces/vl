// @error `??` over an atom-valued map needs a member-literal (or atom) default
// A default that is neither a member, an atom of the set nor a string has no join with the
// atom read's rep, so it is refused at check (D4750 is the case where it should not be).
type K0 = "aa" | "bb"

function go() {
  const m: {[string]: K0} = Map()
  m["k"] = "aa"
  print(m["k"] ?? 3)
}
go()
