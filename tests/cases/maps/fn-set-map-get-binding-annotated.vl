// The annotated face of `fn-set-map-get-binding.vl`: a map of a declared function type, at
// module scope and in a function body (D14432).
function inc(x: i32) { return x + 1 }
function dbl(x: i32) { return x + x }
const m: Map<string, (x: i32) => i32> = Map()
m.set("a", inc)
m.set("b", dbl)
const g = m.get("b")
if (g != null) { print(g(2)) }
const i = m["a"]
if (i != null) { print(i(2)) }
const h = m.get("z")
if (h == null) { print(0) }
function run() {
  const n: Map<string, (x: i32) => i32> = Map()
  n.set("a", inc)
  n.set("b", dbl)
  const f = n.get("b")
  if (f != null) { print(f(2)) }
  const j = n["a"]
  if (j != null) { print(j(2)) }
}
run()
