// @run
// @log 7
// @log 7
// @log 7
// @log 7
// @log 3
// An un-annotated `Map()` held by a list or record literal takes the map type the literal is
// delivered as, so its record values are built at the declared row: a union-armed field holds
// the arm the literal wrote. Each delivery position is spelled once.
type Cir = { c2: i32 }
type Sq = { s2: i32 }
type Shape = Cir | Sq
type Circle = { r: Shape }
type Holder = { f: {[string]: Circle} }
type Plain = { r: i32 }

function firstOf(xs: {[string]: Circle}[]): Circle {
  xs[0]["k"] ?? { r: { s2: 0 } }
}
function fieldOf(h: Holder): Circle { h.f["k"] ?? { r: { s2: 0 } } }
function wrap(): {[string]: Circle}[] {
  const m = Map()
  m["k"] = { r: { c2: 1 } }
  [m]
}

const a = Map()
a["k"] = { r: { c2: 1 } }
const la: {[string]: Circle}[] = [a]
if (la[0]["k"] ?? { r: { s2: 0 } }).r is Cir { print(7) } else { print(0) }

const b = Map()
b["k"] = { r: { c2: 1 } }
if firstOf([b]).r is Cir { print(7) } else { print(0) }

const c = Map()
c["k"] = { r: { c2: 1 } }
if fieldOf({ f: c }).r is Cir { print(7) } else { print(0) }

if (wrap()[0]["k"] ?? { r: { s2: 0 } }).r is Cir { print(7) } else { print(0) }

// The control: a map delivered nowhere keeps its own value type.
const d = Map()
d["k"] = { r: 3 }
print((d["k"] ?? { r: 0 }).r)
