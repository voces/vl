// @run
// @log true
// @log true
// @log false
// @log 1
// @log 2
// @log 1
// The map-and-set methods on an un-annotated parameter take a Set as readily as a map: the
// call resolves `.has`, `.delete` and `.keys()` against the argument's kind.
function take(a) { print(a.has(1)) }
const s: Set<i32> = Set()
s.add(1)
take(s)
const m: {[i32]: i32} = Map()
m[1] = 2
take(m)
function drop(a) {
  a.delete(1)
  print(a.has(1))
}
drop(s)
function count(a) { print(a.keys().length) }
s.add(4)
count(s)
m[3] = 4
count(m)
function grow(a) {
  a.add(9)
  print(a.length)
}
const t: Set<i32> = Set()
grow(t)
