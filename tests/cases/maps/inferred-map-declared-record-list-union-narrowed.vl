// @run
// @log 7
// @log 1
// @log 3
// @log 8
// @log hi
// @log 5
// An un-annotated `Map()` whose value is a written `P[] | i32[]`, read and narrowed to each arm
// at module scope: the record arm by an `else` of `is i32[]`, two record types (D5113).
type P = { x: i32 }
type Q = { y: string }
function w(b: boolean): P[] | i32[] {
  if b { return [{ x: 7 }] }
  [1, 2, 3]
}
function u(b: boolean): Q[] | i32[] {
  if b { return [{ y: "hi" }] }
  [4, 5]
}
const m = Map()
m["a"] = w(true)
m["b"] = w(false)
const va = m["a"]
if va != null {
  if va is i32[] { print(0) } else { print(va[0].x) }
  if va is i32[] { print(0) } else { print(va.length) }
}
const vb = m["b"]
if vb != null {
  if vb is i32[] { print(vb[2]) } else { print(vb[0].x) }
}
const n = Map()
n["k"] = u(true)
n["j"] = u(false)
const vk = n["k"]
if vk != null {
  if !(vk is i32[]) { print(vk[0].y.length + 6) }
  if vk is i32[] { print(0) } else { print(vk[0].y) }
}
const vj = n["j"]
if vj != null {
  if vj is i32[] { print(vj[1]) } else { print(vj[0].y) }
}
