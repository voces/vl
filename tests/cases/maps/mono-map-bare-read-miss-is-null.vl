// @run
// @log aa
// @log MISS
// @log no-first-member
// @log hit-second-member
// @log aa
// @log MISS
// @log no-first-member
// @log hit-second-member
// @log true
// @log MISS
// @log no-false
// @log hit-true
// @log true
// @log MISS
// @log no-false
// @log hit-true
// A BARE read `m[k]` over a NICHE-BEARING mono map — an ATOM value (`K`) or a `boolean` one —
// is `V | null`: a MISSING key IS null. `emitMapGet`'s miss arm yielded that niche sentinel
// (`-1` / `2`) only for the explicitly-NULLABLE value spelling (`K | null`, `boolean | null`)
// and `0` for the plain one. But `0` is a REAL VALUE in both reps — atom id 0 is the
// FIRST-INTERNED member, and boolean 0 is `false` — so the plain spelling read a miss back as
// a genuine value:
//
//   * `m[missing] == <first-interned member>` and `m[missing] == false` both read TRUE, and
//   * `const g = m[k]; if g != null { … }` narrowed a MISSING key NON-null (boolean), or
//     could not classify the binding at all and emitted `bare null needs a struct-typed
//     context` (atom).
//
// The two map spellings differ only in whether a null can be STORED; what a READ produces is
// the niche either way, so the miss arm now yields the sentinel for both. (A plain-`i32`
// -valued map is the one that genuinely has no spare value — every i32 is a legal value — so
// it keeps `0` and its `!= null` narrow stays the loud emit reject.)
//
// The first-interned member matters: the store below is `"bb"` FIRST, so `"bb"` is atom id 0
// and `m[missing] == "bb"` is exactly the compare the old `0` miss got wrong.
type K0 = "aa" | "bb"

function atomStrKeyed() {
  const m: {[string]: K0} = Map()
  m["j"] = "bb" // "bb" interns FIRST -> atom id 0
  m["k"] = "aa"
  const g = m["k"]
  if g != null { print(g) } else { print("WRONG-HIT-NULL") }
  const h = m["zz"]
  if h != null { print("WRONG-MISS-NOT-NULL") } else { print("MISS") }
  if m["zz"] == "bb" { print("WRONG-MISS-EQ-ID0") } else { print("no-first-member") }
  if m["j"] == "bb" { print("hit-second-member") } else { print("WRONG-HIT-NE") }
}

function atomI32Keyed() {
  const m: {[i32]: K0} = Map()
  m[6] = "bb"
  m[7] = "aa"
  const g = m[7]
  if g != null { print(g) } else { print("WRONG-HIT-NULL") }
  const h = m[9]
  if h != null { print("WRONG-MISS-NOT-NULL") } else { print("MISS") }
  if m[9] == "bb" { print("WRONG-MISS-EQ-ID0") } else { print("no-first-member") }
  if m[6] == "bb" { print("hit-second-member") } else { print("WRONG-HIT-NE") }
}

function boolStrKeyed() {
  const m: {[string]: boolean} = Map()
  m["k"] = true
  const g = m["k"]
  if g != null { print(g) } else { print("WRONG-HIT-NULL") }
  const h = m["zz"]
  if h != null { print("WRONG-MISS-NOT-NULL") } else { print("MISS") }
  if m["zz"] == false { print("WRONG-MISS-EQ-FALSE") } else { print("no-false") }
  if m["k"] == true { print("hit-true") } else { print("WRONG-HIT-NE") }
}

function boolI32Keyed() {
  const m: {[i32]: boolean} = Map()
  m[7] = true
  const g = m[7]
  if g != null { print(g) } else { print("WRONG-HIT-NULL") }
  const h = m[9]
  if h != null { print("WRONG-MISS-NOT-NULL") } else { print("MISS") }
  if m[9] == false { print("WRONG-MISS-EQ-FALSE") } else { print("no-false") }
  if m[7] == true { print("hit-true") } else { print("WRONG-HIT-NE") }
}

atomStrKeyed()
atomI32Keyed()
boolStrKeyed()
boolI32Keyed()
