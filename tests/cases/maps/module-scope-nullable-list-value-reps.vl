// @run
// @log 1
// @log s
// @log 1.5
// @log 5000000000
// @log 2.5
// @log true
// @log 4
// @log 5
// @log 6
// D1107 — a module-scope bare read of a map whose VALUE spelling carries `| null`, over
// every list backing.
//
// The CELL was classified from `letNulMapReadValKind`, which reads the vals ELEMENT KIND;
// the READ side asked `nameIsI32Array` / `nulScalarListKind` of `mvValName`, the DECLARED
// spelling. A `{[string]: i32[] | null}` banks `"i32[] | null"`, which neither name test
// reads past — so the cell said `nullist` and the read said "not nullable", and the
// `!= null` compare's bare `null` reached `emitNullLitNode` with no rep. The REF backings
// escaped it because their global rung asks the cell directly.
//
// The plain-`V` twin of each of these already lowered (the read's implicit `T?` makes it
// nullable either way), so the value's own `| null` is the whole ingredient; both
// spellings are graded side by side in `maps/module-scope-list-value-read-bind.vl`.
//
// Each cell reads an ELEMENT through the narrowed binding, so a wrapper of the wrong heap
// type cannot pass by binding.

type S = { v: i32 }

const mi: {[string]: i32[] | null} = Map()
mi["k"] = [1]
const ri = mi["k"]
if ri != null { print(ri[0]) }

const ms: {[string]: string[] | null} = Map()
ms["k"] = ["s"]
const rs = ms["k"]
if rs != null { print(rs[0]) }

const md: {[string]: f64[] | null} = Map()
md["k"] = [1.5]
const rd = md["k"]
if rd != null { print(rd[0]) }

const ml: {[string]: i64[] | null} = Map()
ml["k"] = [5000000000]
const rl = ml["k"]
if rl != null { print(rl[0]) }

const mf: {[string]: f32[] | null} = Map()
mf["k"] = [2.5]
const rf = mf["k"]
if rf != null { print(rf[0]) }

const mb: {[string]: boolean[] | null} = Map()
mb["k"] = [true]
const rb = mb["k"]
if rb != null { print(rb[0]) }

// The REF backings, which already lowered — kept as the controls that must not move.
const mr: {[string]: S[] | null} = Map()
mr["k"] = [{v: 4}]
const rr = mr["k"]
if rr != null { print(rr[0].v) }

const mn: {[string]: i32[][] | null} = Map()
mn["k"] = [[5]]
const rn = mn["k"]
if rn != null { print(rn[0][0]) }

// A MISS on the same nullable-valued map is still the null side.
const mm: {[string]: i32[] | null} = Map()
mm["k"] = [6]
const rm = mm["absent"]
if rm != null { print(rm[0]) } else { print(6) }
