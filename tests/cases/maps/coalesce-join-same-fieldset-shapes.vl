// @run
// @log 7
// @log 7
// A REFUTATION PIN for silent-class-inventory D735's refused candidate. `m[k] ?? d` whose
// two sides are OBJECT shapes with the same field-NAME set but different field TYPES is
// typed by the checker as their UNION — `{r: {c2: i32}} | {r: {s2: i32}}` here — and two
// arms sharing a field-name set collide on `variantSig`, which is exactly the shape
// `assignTags` refuses for a DECLARED union ("union `U` cannot be discriminated — variants
// `A` and `B` have the same field names but different field types"). Reasoning from that,
// D735's residue was first shipped as a CHECKER refusal of the anonymous case.
//
// THE CORPUS REFUTED IT IN ONE RUN: 16 behavioural classes stopped running, this program's
// shape among them (`d004020`, `d004021`, `d004023`, `d004024`, `d004770`…). The emitter does
// NOT represent such a pair as a union and never has — `structIndexOfObj` matches a literal
// by field-name SET, so both shapes land on ONE row and the differing field is widened in
// place. Disassembled: the module holds exactly one shape,
// `(type $0 (struct (field (mut (ref $3)))))` over the union box `$3`, and no second row for
// the default's spelling.
//
// So this must keep RUNNING. What is still open is the case where the widened field has no
// registered union to box into (`m[k] ?? { r: null }` over a `{[string]: {r:i32}}` map, which
// dies at the default's bare `null`) — a merged-row mint, not a rule about discriminability.
type Cir2 = { c2: i32 }
type Sq2 = { s2: i32 }
type Shape2 = Cir2 | Sq2

function hit() {
  const c = Map()
  c["k0"] = { r: { c2: 1 } }
  const g0 = (c)["k0"] ?? { r: { s2: 1 } }
  if (g0).r is Cir2 { print(7) } else { print(0) }
}

function miss() {
  const c = Map()
  c["k0"] = { r: { c2: 1 } }
  const g0 = (c)["zz"] ?? { r: { s2: 1 } }
  if (g0).r is Sq2 { print(7) } else { print(0) }
}

hit()
miss()
