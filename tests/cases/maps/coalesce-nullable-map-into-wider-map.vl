// @run
// @log 1
// @log 1
// @log 0
// @log 2
// `n ?? w` over a nullable map and a wider map that stores alike is the wider map, as the value
// `if` join of the two is, and every read of it reads that map (D15050).
const a: {[string]: string} = Map()
a["k"] = "v"
const n: {[string]: string} | null = a
const w: {[string]: string | null} = Map()
const r = n ?? w
print(r.length)
print((n ?? w).length)
function pick(m: {[string]: string} | null, d: {[string]: string | null}) {
  const x = m ?? d
  x.length
}
print(pick(null, w))
const b: {[string]: i32} = Map()
b["p"] = 1
b["q"] = 2
const nb: {[string]: i32} | null = b
const wb: {[string]: i32 | null} = Map()
print((nb ?? wb).length)
