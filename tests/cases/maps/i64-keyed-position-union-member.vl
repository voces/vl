// @run
// @log 1
// @log 7
// @log 2
// @log none
// D2505's i64-keyed twin of `i32-keyed-position-union-member.vl`: the i64-keyed map is a union
// member at its own box code, so the narrowed read reaches a key past the i32 range.
const m: {[i64]: i32} = Map()
m[4294967297] = 7
const u: {[i64]: i32} | i32 = m
if u is {[i64]: i32} { print(u.length) } else { print(-1) }
if u is {[i64]: i32} {
  print(u[4294967297] ?? -1)
  u.set(1, 3)
  let c = 0
  for k in u { c = c + 1 }
  print(c)
}
function pick(n: i32): Set<i64> | null {
  if n > 0 {
    const s: Set<i64> = Set()
    s.add(4294967297)
    return s
  }
  null
}
const p = pick(0)
if p == null { print("none") } else { print(p.length) }
