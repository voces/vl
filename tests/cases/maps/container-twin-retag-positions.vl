// @run
// @log 3
// @log 4
// @log 5
// @log 1
// @log 2
// @log 3
// @log 4
// @log 5
// @log 6
// A list of a record delivered where the list's element is the record's union-arm twin on one
// heap, and a map delivered where its values are its own `| null` or a wider union's box, go in
// as they stand: a declaration, an argument and a return of each.
type Node = { v: i32, next: Node | null }
type R = { w: string }
type M = Node & { v: i32 }
function show(u: Node | R | null) {
  if u is Node { print(u.v) }
}
function mkM(): M { return { v: 3, next: null } }
function decl() {
  const xs: Node[] = [mkM()]
  show(xs[0])
}
function takeL(xs: Node[]) { print(xs[0].v + 1) }
function backL(): Node[] { return [mkM()] }
decl()
takeL([mkM()])
print(backL()[0].v + 2)
function strs(): {[string]: string} {
  const m: {[string]: string} = Map()
  m["a"] = "x"
  return m
}
function declS() {
  const m: {[string]: string | null} = strs()
  print(m.length)
}
function takeS(m: {[string]: string | null}) { print(m.length + 1) }
function backS(): {[string]: string | null} { return strs() }
declS()
takeS(strs())
print(backS().length + 2)
function nums(): {[string]: i32 | string} {
  const m: {[string]: i32 | string} = Map()
  m["a"] = 3
  return m
}
function declU() {
  const w: {[string]: i32 | string | f64} = nums()
  const a = w["a"]
  if a is i32 { print(a + 1) }
}
function takeU(w: {[string]: i32 | string | f64}) {
  const a = w["a"]
  if a is i32 { print(a + 2) }
}
function backU(): {[string]: i32 | string | f64} { return nums() }
declU()
takeU(nums())
const bu = backU()["a"]
if bu is i32 { print(bu + 3) }
