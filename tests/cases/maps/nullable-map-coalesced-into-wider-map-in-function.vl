// @run
// @log 1
// @log true
// @log 0
// @log false
// A nullable map coalesced with a wider map that stores alike, inside a function: the result is
// the wider map, the operand's when present, and every read of it reads that map.
function pick(m: {[string]: string} | null, d: {[string]: string | null}, k: string) {
  const x = m ?? d
  print(x.length)
  print(x.has(k))
}
const a: {[string]: string} = Map()
a["k"] = "v"
const w: {[string]: string | null} = Map()
pick(a, w, "k")
pick(null, w, "k")
