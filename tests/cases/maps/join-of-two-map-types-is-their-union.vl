// @run
// @log true
// @log 1
// @log a
// @log x
// @log 2
// @log w
// @log 1
// @log false
// @log true
// @log true
// A join of two map types that store alike is their union, which `is` refines from the
// member's tag, and what every member supports works on it without narrowing (D2701).
type Circle = { r: i32 }

function mk(): {[string]: string} {
  const m: {[string]: string} = Map()
  m["a"] = "x"
  return m
}
function mkw(): {[string]: string | null} {
  const m: {[string]: string | null} = Map()
  m["w"] = null
  return m
}
function pick(b: boolean) {
  if b { return mk() }
  return mkw()
}

const r = if mk().length > 0 { mk() } else { mkw() }
print(r is {[string]: string})
print(r.length)
for k in r { print(k) }
print(r["a"] ?? "none")
r["z"] = "w"
print(r.length)
print(r.get("z") ?? "none")
r.delete("z")
print(r.length)

const q = pick(false)
print(q is {[string]: string})
print(q is {[string]: string | null})

function mkc(): {[string]: Circle} {
  const m: {[string]: Circle} = Map()
  m["c"] = { r: 1 }
  return m
}
function mkcn(): {[string]: Circle | null} {
  const m: {[string]: Circle | null} = Map()
  return m
}
const n = if r.length > 0 { mkc() } else { null }
const cc = n ?? mkcn()
print(cc is {[string]: Circle})
