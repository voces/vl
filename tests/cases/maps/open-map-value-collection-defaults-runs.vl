// @run
// @log 2
// @log 0
// @log 1
// @log 1
// @log 1
// An unwritten `Map()` or `Set()` stored whole as a value of an unwritten map, or pushed onto an
// unwritten list, takes the default with its holder at the scope's end, as a binding of it
// would, whether read or not (D16341, D16432).
const m = Map()
m["k"] = Map()
m["j"] = Map()
print(m.length)
const v = m["k"]
if v != null { print(v.length) }
const s = Map()
s["k"] = Set()
print(s.length)
function inner() {
  const n = Map()
  n["k"] = Map()
  return n.length
}
print(inner())
const xs = []
xs.push(Map())
print(xs.length)
