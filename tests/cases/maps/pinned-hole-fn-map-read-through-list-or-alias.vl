// @run
// @log 3
// @log 3
// @log 3
// @log 3
// A map of an un-annotated function pinned at one signature, read and called through an
// un-annotated list holding it, a `const` alias, an alias of that alias inside a closure, while an
// annotated list of maps holds the same function at another signature (D15757).
function half(a) { return a / 2.0 }
const m1 = Map()
m1.set("a", half)
const m4 = Map()
m4.set("a", half)
const ws: ({ [string]: (a: f64) => f64 })[] = [m1]
const g = ws[0].get("a")

const ys = [m4]
const h1 = ys[0].get("a")
if g != null && h1 != null { print(g(3) + h1(3)) }

const al = m4
const h2 = al.get("a")
if g != null && h2 != null { print(g(3) + h2(3)) }

const c = m4
const f = () => {
  const inner = c
  const h3 = inner.get("a")
  if g != null && h3 != null { print(g(3) + h3(3)) }
}
f()

function go() {
  const zs = [m4, m4]
  const h4 = zs[1]["a"]
  if g != null && h4 != null { print(g(3) + h4(3)) }
}
go()
