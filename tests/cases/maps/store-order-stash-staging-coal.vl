// @run
// @log t5
// @log 51
// @log t5
// @log 51
// @log to5
// @log 531
// @log t
// @log 21
// @log t
// @log 21
// @log t
// @log 781
// @hint redundant type annotation: `five` is inferred as `i32`
// @hint redundant type annotation: `tick` is inferred as `i32`
// @hint redundant type annotation: `tock` is inferred as `i32`
// A store whose value is a record literal written out of its row's order, holding a boxed
// binding's `??`: the fields run in source order (`tick` before the binding's test), the default
// only on `null`, and a nested literal default does the same inside it.
type P = { a: i32, b: i32 }
type N = { p: P, c: i32 }
type H = { p: P, n: N }
let log = ""
function mkq(x: boolean): i32 | null { return if x { null } else { 2 } }
function mkr(x: boolean): P | null {
  return if x { null } else { { a: 7, b: 8 } }
}
function five(): i32 {
  log = log + "5"
  return 5
}
function tick(): i32 {
  log = log + "t"
  return 1
}
function tock(): i32 {
  log = log + "o"
  return 3
}
function mapOne(m: {[string]: P}, x: boolean) {
  const q = mkq(x)
  m["k"] = { b: tick(), a: q ?? five() }
}
function fieldOne(h: H, x: boolean) {
  const q = mkq(x)
  h.p = { b: tick(), a: q ?? five() }
}
function nested(h: H, x: boolean) {
  const q = mkq(x)
  const r = mkr(x)
  h.n = { c: tick(), p: r ?? { b: tock(), a: q ?? five() } }
}
const mp: {[string]: P} = Map()
const h: H = { p: { a: 0, b: 0 }, n: { p: { a: 0, b: 0 }, c: 0 } }
for x in [true, false] {
  log = ""
  mapOne(mp, x)
  print(log)
  print((mp["k"]?.a ?? -1) * 10 + (mp["k"]?.b ?? -1))
  log = ""
  fieldOne(h, x)
  print(log)
  print(h.p.a * 10 + h.p.b)
  log = ""
  nested(h, x)
  print(log)
  print(h.n.p.a * 100 + h.n.p.b * 10 + h.n.c)
}
