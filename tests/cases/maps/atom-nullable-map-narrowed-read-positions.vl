// @run
// @log b
// @log a
// @log b!
// @log got b
// @log b
// @log b
// @log b
// @log b
// @log b
// @log 2
// @log none
// @log b
// @log true
// @log b
// @log b?
// @log 2
// @log b
// @log 2
// A read of an `AB | null`-valued map narrowed past its null, in each delivery position: a call
// argument at the atom and at a wider union, a nested argument, a concat, an interpolation, a
// return, a `let`, an `if` arm, a `??` into another type, and a record field; then un-annotated,
// and at module scope.
type AB = "a" | "b"
type Wide = AB | i32
function atom(x: AB) { print(x) }
function wide(x: Wide) { print(x) }
function id(x: AB): AB { return x }
function ret(m: {[i32]: AB | null}): AB {
  if m[3] != null { return m[3] }
  return "a"
}
function use(m: {[i32]: AB | null}) {
  if m[3] != null {
    atom(m[3])
    atom(if m[3] == "a" { "b" } else { "a" })
    print(m[3] + "!")
    print("got \{m[3]}")
    wide(m[3])
    atom(id(m[3]))
    let l = m[3]
    l = id(l)
    print(l)
    const r = { v: m[3] }
    print(r.v)
  }
  print(ret(m))
  print(if m[3] != null { m[3] } else { "a" })
  print(m[9] ?? 2)
  if m[4] != null { print(m[4]) } else { print("none") }
  print(m[3] ?? 2)
  print((m[3] ?? 2) == "b")
}
const a: {[i32]: AB | null} = Map()
a[3] = "b"
a[4] = null
use(a)
function useHole(m) {
  if m[3] != null {
    atom(m[3])
    print(m[3] + "?")
  }
  print(m[9] ?? 2)
}
useHole(a)
if a[3] != null { atom(a[3]) }
print(a[9] ?? 2)
