// A narrower twin's box reaching a union that holds only the wider twin through a join's
// branch, a `match` arm, a `??` or a `| null` source is retagged there too (D2690).
type A = {[string]: string}
type B = {[string]: string | null}
function mkA(): A { const m: A = Map(); m["k"] = "x"; m }
function mkB(): B { const m: B = Map(); m["k"] = "y"; m["n"] = null; m }
function uA(): A | B { mkA() }
function uB(): A | B { mkB() }
function nn(): A | B | null { uA() }
function sh(w: B | string) {
  print(w is B)
  match w {
    string => print("s")
    B => print(w.length)
  }
}
const c = mkA().length > 0
const w1: B | string = if c { uA() } else { uB() }
sh(w1)
sh(if c { uA() } else { "s" })
const k = 2
const w2: B | string = match k {
  1 => "one"
  _ => uA()
}
sh(w2)
const w3: B | string = nn() ?? "d"
sh(w3)
function r(): B | string {
  if c { return uA() }
  "s"
}
sh(r())
const w4: B | string | null = if c { nn() } else { null }
if w4 != null { sh(w4) }
