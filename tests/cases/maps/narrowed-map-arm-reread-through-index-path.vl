// @run
// @log 2
// @log 2
// @log true
// @log 1
// @log 2
// @log 3
// @log 2
// @log 1
// @log 2
// @log 2
// @log 5
// @log 8
// A map-valued union member RE-READ through its own narrowed index path — `if m[k] is
// {[string]: i32} { m[k].size }`, with no name bound in between. The read had only an ATOM
// unbox, so a container arm left the union box for a consumer typed on the map (D1866). Every
// map operation is re-read through the path, because a fix that opens the box for one and not
// another is what the `.size`-only witness could not see.

function mkInner(): { [string]: i32 } {
  const m: { [string]: i32 } = Map()
  m["a"] = 1
  m["b"] = 2
  m
}

function mkBox(): { [string]: i32 } | i32 { mkInner() }

const m: { [string]: { [string]: i32 } | i32 } = Map()
m["k"] = mkBox()
m["n"] = 7

if m["k"] != null {
  if m["k"] is { [string]: i32 } {
    print(m["k"].size)
    print(m["k"].length)
    print(m["k"].has("a"))
    print(m["k"]["a"] ?? -1)
    print(m["k"].get("b") ?? -1)
    let t = 0
    for kk in m["k"] { t = t + (m["k"][kk] ?? 0) }
    print(t)
    // The binding INSIDE the arm: its cell has to follow the read, not the map's declared
    // value rep, or the unboxed map is stored into a union-box local.
    const q = m["k"]
    print(q.size)
    m["k"].delete("a")
    print(m["k"].size)
    m["k"]["c"] = 3
    print(m["k"].size)
  } else {
    print(-1)
  }
}

// The LIST arm of the same channel: a ref-element array is the other container the read can
// unbox to, and it was refused loudly where the map was silent.
type P = { x: i32 }

function mkList(): P[] { [{ x: 5 }, { x: 6 }] }

function mkListBox(): P[] | i32 { mkList() }

const l: { [string]: P[] | i32 } = Map()
l["k"] = mkListBox()

if l["k"] != null {
  if l["k"] is P[] {
    print(l["k"].length)
    print(l["k"][0].x)
  } else {
    print(-1)
  }
}

// The ATOM arm of the same map, unchanged: it never read the box's payload, and must not start.
if m["n"] != null {
  if m["n"] is i32 { print(m["n"] + 1) } else { print(-1) }
}
