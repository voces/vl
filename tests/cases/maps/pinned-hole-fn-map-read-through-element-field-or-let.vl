// @run
// @log 3
// @log 3
// @log 3
// @log 3
// @log 3
// A map of an un-annotated function pinned at one signature, read and called through a binding of
// a list element, a record field, a field of a list element, and a reassigned `let`, while an
// annotated list of maps holds the same function at another signature (D15759).
function half(a) { return a / 2.0 }
const m1 = Map()
m1.set("a", half)
const m4 = Map()
m4.set("a", half)
const ws: ({ [string]: (a: f64) => f64 })[] = [m1]
const g = ws[0].get("a")

const xs = [m4]
const v1 = xs[0]
const h1 = v1.get("a")
if g != null && h1 != null { print(g(3) + h1(3)) }

const w = { f: m4 }
const v2 = w.f
const h2 = v2.get("a")
if g != null && h2 != null { print(g(3) + h2(3)) }

const rs = [{ f: m4 }]
const v3 = rs[0].f
const h3 = v3.get("a")
if g != null && h3 != null { print(g(3) + h3(3)) }

let v4 = m4
v4 = m4
const h4 = v4.get("a")
if g != null && h4 != null { print(g(3) + h4(3)) }

function go() {
  const v5 = xs[0]
  const h5 = v5.get("a")
  if g != null && h5 != null { print(g(3) + h5(3)) }
}
go()
