// @run
// @log true
// @log 1 true
// @log s true
// @log 2 false
// @log true
// @log true
// @log 1
// @log none
// `m is {[K]: V}` over a map typed with the same key and a wider value tests every value at
// runtime, so an empty map passes (owner ruling, D2701). A join of two maps that store alike is the
// wider map, which is where the test reads true for a value built as the narrower one.
function mk(): {[string]: string} {
  const m: {[string]: string} = Map()
  m["a"] = "x"
  return m
}
function mkw(): {[string]: string | null} {
  const m: {[string]: string | null} = Map()
  return m
}
const c = mk().length > 0
const r = if c { mk() } else { mkw() }
print(r is {[string]: string})
function test<T>(x: T, m: {[string]: string | null}) {
  "\{x} \{m is {[string]: string}}"
}
const a: {[string]: string | null} = Map()
a["k"] = "v"
print(test(1, a))
print(test("s", a))
a["n"] = null
print(test(2, a))
print(a !is {[string]: string})
const e: {[string]: string | null} = Map()
print(e is {[string]: string})
// The values read at the narrower type while nothing can write the map; a key read may still miss.
const w: {[string]: string | null} = Map()
w["a"] = "x"
if w is {[string]: string} {
  for v in w.values() { print(v.length) }
  print(w["zz"] ?? "none")
}
