// @run
// @log aa
// @log 1
// @log bb
// @log 1
// THE TWO i32-KEYED LIST-OF-MAPS SPELLINGS THAT NOTHING ELSE COVERS, alone in a file
// because that is the only shape in which they can fail.
//
// `mI32Used` is a MODULE flag. It gates the i32-keyed map struct, the i32 probe helper
// and the per-function 5-slot i32-KEY scratch frame, and the map-ARRAY annotation arm
// never set it — but a `[Map()]` LITERAL sets it from the CONSTRUCTOR's own
// checker-recorded key type, so ONE literal anywhere in a file covers every other
// i32-keyed spelling in it. `list-of-maps-i32-keyed.vl` is full of literals and passes
// with the fix reverted; these two cells do not, and would be invisible if they sat
// beside one.
//
// That is the per-function scratch-frame reservation lesson (see
// `list-of-maps-scratch-frame-reservation.vl`) one scope OUT: a module-wide flag hides a
// missed setter behind any other spelling that happens to set it, exactly as a function
// holding several map ops hides a missed membership scan behind its neighbours. So the
// discipline is the same — isolate the cell from anything that could cover it.
//
// NEITHER SPELLING IS ONE A `[Map()]` COVERS:
//   · `.push(Map())` into a bare `{[i32]: V}[]` — the pushed `Map()` carries no
//     checker-recorded key the constructor arm can read.
//   · `({[i32]: V} | null)[]` — not a `nameIsMapArray` at all, so even its LITERAL form
//     misses both the array arm and the constructor arm. This is the cell that forced the
//     flag to be asked of the PEELED ELEMENT name rather than under a map-array gate.
//
// Without the fix each writes `type mismatch: expected (ref $type), found i32` at
// `vl check` rc 0: with no key frame reserved, the store's key temporary and the map-REF
// temporary resolve to the SAME local index.
function go() {
  const psh: {[i32]: string}[] = []
  psh.push(Map())
  psh[0][1] = "aa"
  print(psh[0][1] ?? "z") // aa
  print(psh[0].length)    // 1

  const nul: ({[i32]: string} | null)[] = [Map()]
  const nm = nul[0]
  if nm != null {
    nm[2] = "bb"
    print(nm[2] ?? "z") // bb
    print(nm.length)    // 1
  }
}
go()
