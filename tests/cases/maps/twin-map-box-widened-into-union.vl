// @run
// @log true
// @log false
// @log 11
// @log true
// @log m
// A box built under `{[K]: V}` and delivered into a union that holds only `{[K]: V | null}`
// takes that member's tag, so `is` and `match` there read the member it holds (D2690).
type Circle = { r: i32 }
const a: {[string]: string} = Map()
a["k"] = "x"
const u: {[string]: string} | {[string]: string | null} = a
const w: {[string]: string | null} | string = u
print(w is {[string]: string | null})
print(w is string)
function mkA(): {[i32]: Circle} {
  const m: {[i32]: Circle} = Map()
  m[1] = { r: 5 }
  m
}
function uA(): {[i32]: Circle} | {[i32]: Circle | null} { mkA() }
function f(v: {[i32]: Circle | null} | i32) {
  match v {
    i32 => print(-1)
    {[i32]: Circle | null} => print(10 + v.length)
  }
}
f(uA())
const xs: ({[i32]: Circle | null} | i32)[] = [uA()]
print(xs[0] is {[i32]: Circle | null})
function uB(): {[string]: boolean} | {[string]: boolean | null} {
  const m: {[string]: boolean} = Map()
  m
}
const g = uB()
const h: {[string]: boolean | null} | string = g
match h {
  string => print("s")
  {[string]: boolean | null} => print("m")
}
