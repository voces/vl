// @check
// @error-at 13:11 {f: i32} is not K: they store field `f` differently
// @error-at 14:11 this value is built as K where line 12 delivers it, and it is handed on here at its own type
// VERDICT PIN (must-error), no `@log` form: the diagnostic IS the observable.
// A maker's call delivered at `J` is copied there, but no copy boxes `i32` into `i32 | string`,
// so `mk2` is kept at `K` and its store at its own type refuses (D14385, D14517).
type J = { f: i32 | null }
type K = { f: i32 | string }
function mk() { { f: 4 } }
function mk2() { { f: 6 } }
const wideJ: J = mk()
const wideK: K = mk2()
const m = Map()
m.set("a", mk())
m.set("b", mk2())
print(wideJ.f ?? 0)
