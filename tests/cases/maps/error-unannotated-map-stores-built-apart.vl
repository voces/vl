// @check
// @error-at 13:11 {f: i32} is not J: they store field `f` differently
// @error-at 14:11 {f: i32} is not K: they store field `f` differently
// VERDICT PIN (must-error), no `@log` form: the diagnostic IS the observable.
// Two calls stored into one un-annotated `Map()` are built at records storing `f` differently,
// so the map has no one value row and each store refuses, whichever comes first (D14517).
type J = { f: i32 | null }
type K = { f: i32 | string }
function mk() { { f: 4 } }
function mk2() { { f: 6 } }
const wideJ: J = mk()
const wideK: K = mk2()
const m = Map()
m.set("a", mk())
m.set("b", mk2())
print(wideJ.f ?? 0)
