// @run
// @log 2
// @log 2
// Binding a LIST-valued map read to a MODULE-SCOPE `const` and narrowing it, at BOTH
// nullabilities of the map's value — a `V | null` value and a plain `V`, which the read's
// implicit `T?` makes nullable either way.
//
// THE RUNG BOTH HALVES NEEDED (D1107). A module-scope binding is a GLOBAL cell, so
// `globalCellKind` types it from `letNulMapReadValKind` — which reads the vals ELEMENT
// KIND. The READ side asked `nameIsI32Array` / `nulScalarListKind` of `mvValName`, the
// DECLARED spelling, so a value carrying `| null` was claimed by the cell and refused by
// the read: the compare's bare `null` then had no rep. Both now come from the element
// kind (`mvNulListValKind`), so the cell and the read cannot disagree.
//
// The plain-`V` half is the CONTROL: it shares the cell but not the spelling, and it
// stayed loud on master for the sibling reason (`nameIsI32Array` answers for `i32[]` and
// not for `f64[]`).

const nulm: {[string]: f64[] | null} = Map()
nulm["k"] = [1.5, 2.5]
const nv = nulm["k"]
if nv != null { print(nv.length) } else { print("N") }

const plainm: {[string]: f64[]} = Map()
plainm["k"] = [1.5, 2.5]
const pv = plainm["k"]
if pv != null { print(pv.length) } else { print("N") }
