// @log true
// D2498: an un-annotated function whose tail is an else-less `if` yielding a map returns that map
// or `null`, as a list, string or record result does: the map itself, and a map element write.
function pick(c: boolean, m: {[string]: i32}) {
  if c { m }
}
const m: {[string]: i32} = Map()
print(pick(true, m) == null)
print(pick(false, m) == null)
function pickS(c: boolean, m: {[string]: string}) {
  if c { m }
}
const ms: {[string]: string} = Map()
print(pickS(true, ms) == null)
print(pickS(false, ms) == null)
function store(c: boolean, v: {[string]: i32}, o: {[string]: {[string]: i32}}) {
  if c { o["x"] = v }
}
const o: {[string]: {[string]: i32}} = Map()
print(store(true, m, o) == null)
print(store(false, m, o) == null)
