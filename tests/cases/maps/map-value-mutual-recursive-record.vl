// @run
// @log 5
// @log 5
// @log 7
// @log nokids
// @log 2

// An un-annotated `Map()` whose value is a record in a cycle through two declarations keys its
// value slot by the record's declared name, read through `??` and through a `!= null` guard
// (D1889).

type Leaf = { w: i32, up: Branch | null }
type Branch = { kids: Leaf | null }

function mkval(): Branch {
  return { kids: { w: 5, up: { kids: { w: 7, up: null } } } }
}

const srcMap = Map()
srcMap["k"] = mkval()
const d = (srcMap["k"] ?? { kids: null })
const dk = d.kids
if dk != null { print(dk.w) } else { print(0) }

srcMap["j"] = { kids: null }
const v = srcMap["k"]
if v != null {
  const k = v.kids
  if k != null {
    print(k.w)
    const u = k.up
    if u != null {
      const k2 = u.kids
      if k2 != null { print(k2.w) }
    }
  }
}
const j = srcMap["j"]
if j != null {
  if j.kids == null { print("nokids") }
}
print(srcMap.length)
