// An un-annotated `Map()` whose only value is an index-stored bare `[]` has a value rep: at the
// top level, in a function, decided by a later push or by another store's element, and beside an
// annotated map and a list's own element store (D5471).
const m = Map()
m["k"] = []
const x = m["k"]
if x != null { print(x.length) }
function f() {
  const fm = Map()
  fm["k"] = []
  const fx = fm["k"]
  if fx != null { print(fx.length) }
  print(fm.length)
}
f()
const pm = Map()
pm["k"] = []
const px = pm["k"]
if px != null {
  px.push(2.5)
  print(px[0])
}
const sm = Map()
sm["j"] = ["s"]
sm["k"] = []
const sy = sm["k"]
if sy != null { print(sy.length) }
const im = Map()
im["k"] = []
im["j"] = [1]
const ij = im["j"]
if ij != null { print(ij[0]) }
const am: Map<string, f64[]> = Map()
am["k"] = []
const ay = am["k"]
if ay != null { print(ay.length) }
const xs = [[1.5]]
xs[0] = []
print(xs[0].length)
