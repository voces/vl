// D7446: a map value of one string literal is its one-member set's atom, annotated or
// inferred, and crosses a parameter, a return and a record field as one.
// @run
// @log m=circle
// @log none
// @log x=circle
// @log circle
// @log none
// @log circle
// @log v=circle
// @log circle-circle
// @log circle
// @log none
// @log none
// @log 1
type C = { kind: "circle", r: i32 }
function mkC(n: i32): C { { kind: "circle", r: n } }
const m = Map()
m["k"] = mkC(1).kind
const mv = m["k"]
if mv != null { print("m=" + mv) }
print(m["z"] ?? "none")
const xs = []
xs.push(mkC(2).kind)
print("x=" + xs[0])

type R = { m: {[string]: "circle"} }
function mk(): {[string]: "circle"} {
  const am: {[string]: "circle"} = Map()
  am["a"] = "circle"
  am
}
function rd(m: {[string]: "circle"}, k: string) { m[k] ?? "none" }
const x = mk()
print(rd(x, "a"))
print(rd(x, "b"))
const r: R = { m: x }
print(r.m["a"] ?? "none")
const v = r.m["a"]
if v != null { print("v=" + v) }
const ys: "circle"[] = ["circle"]
const ns: ("circle" | null)[] = [null, "circle"]
print(ys[0] + (ns[0] ?? "-") + (ns[1] ?? "-"))

function rdn(m: {[string]: "circle" | null}, k: string) { m[k] ?? "none" }
function mkn(): {[string]: "circle" | null} {
  const am: {[string]: "circle" | null} = Map()
  am["a"] = "circle"
  am["n"] = null
  am
}
const xn = mkn()
print(rdn(xn, "a"))
print(rdn(xn, "n"))
print(rdn(xn, "z"))
print(xn.length - 1)
