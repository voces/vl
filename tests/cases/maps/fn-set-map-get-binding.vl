// @run
// @log 4
// @log 5
// @log 3
// @log 0
// @log 10
// @log 6
// A binding of a map entry of a set of un-annotated functions holds the set's id boxed as
// `i32 | null`, at module scope: `.get`, an index read, a miss, and a reassigned `let` (D14432).
function inc(x) { return x + 1 }
function dbl(x) { return x + x }
const m = Map()
m.set("a", inc)
m.set("b", dbl)
const g = m.get("b")
if (g != null) {
  print(g(2))
  print(g(2.5))
}
const i = m["a"]
if (i != null) { print(i(2)) }
const h = m.get("z")
if (h == null) { print(0) }
let k = m.get("b")
if (k != null) { print(k(5)) }
k = m.get("a")
if (k != null) { print(k(5)) }
