// @run
// @log true
// @log false
// @log true
// @log miss
// @log true
// @log false
// @log mutated
// @log true
// @log false
// @log true
// @log false
// @log true
// @log true
// A bare scalar map read compared after a null test narrowed it reads the probe's compare: a hit
// on its value, a stored zero or `false` included, a miss as no value. A write between the test
// and the compare is read again.
const mi: {[string]: i32} = Map()
mi["k"] = 41
mi["z"] = 0
const mb: {[i32]: boolean} = Map()
mb[1] = true
mb[2] = false

if mi["k"] != null {
  print(mi["k"] == 41)
  print(41 != mi["k"])
}
if mi["z"] != null { print(mi["z"] == 0) }
if mi["q"] == null { print("miss") } else { print(mi["q"] == 0) }
if !(mb[2] == null) { print(mb[2] == false) }
if mb[1] != null { print(mb[1] != true) }

function inFunction(m: {[string]: i32}, k: string) {
  if m[k] != null {
    m[k] = 7
    if m[k] == 7 { print("mutated") } else { print("stale") }
  }
}
inFunction(mi, "k")
print(mi["k"] == 7)

const inClosure = () => {
  if mi["z"] != null { print(mi["z"] != 0) }
}
inClosure()

function generic<V>(m: {[string]: V}, k: string, v: V) {
  if m[k] != null { print(m[k] == v) }
}
generic(mi, "k", 7)
generic(mi, "z", 1)

const mf: {[string]: f64} = Map()
mf["f"] = 2.5
if mf["f"] != null { print(mf["f"] == 2.5) }
const ml: {[string]: i64} = Map()
ml["l"] = -5000000000
if ml["l"] != null { print(ml["l"] == -5000000000) }
