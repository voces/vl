// @run
// @log 0
// @log 1
// @log 1.5
// @log 2
// A map BINDING annotated with a RECURSIVE ALIAS — `type JO = {[string]: J}` where `J`
// names `JO` back, so the pair is mutually recursive and the annotation is a `TypeRef`
// standing INSIDE the cycle.
//
// THE STRUCTURAL SPELLING OF THE SAME TYPE ALWAYS COMPILED, which is what made the gap
// invisible: `let o: {[string]: J} = Map()` is not a `TypeRef` node, so it skips the
// render rung in `letMapShape` and resolves at the destination rung below it. Only the
// ALIAS spelling takes the render rung, and the render hands the NAME layer `{[string]:J}`
// — whose value `J` no rung of `mvValKindOfName` classifies, because `unionMemberSetOf`
// returns a recursive alias unexpanded and the union rung's member count reads 1. That
// `-3` seeded `pendingMapSlot` and `emitMapNew` refused the binding outright.
//
// The `-3` is a NON-ANSWER, so the rung now falls through instead of returning it, and
// the destination rung — the one the structural spelling has always used — resolves the
// slot. An alias standing OUTSIDE the cycle (`type Root = {[string]: J}`) never had the
// problem: its render closes the cycle on `JO` and the name layer is never asked about a
// bare alias.
type J = null | f64 | JO
type JO = { [string]: J }

const o: JO = Map()
print(o.size)

o["k"] = 1.5
print(o.size)

const v = o["k"]
if v is f64 { print(v) }

// The same binding at the STRUCTURAL spelling — the control that always ran, kept here so
// a regression in either spelling is visible against the other.
const s: { [string]: J } = Map()
s["a"] = 1.0
s["b"] = 2.0
print(s.size)
