// @run
// @log 44
// @log 1
// @log -56
// @log -127
// @log 4464
// @log 1
// @log -25536
// @log -32767
// @log -3
// @log -32766
// @log 7
// A `flat` record's sub-word field stores the low bits of a computed value at its width, signed
// for `i8`/`i16`, and a read widens it back to `i32` (D15978, D16045).
flat type B = { u: u8, s: i8, c: i32 }
flat type H = { u: u16, s: i16, c: i32 }
function k(n: i32) { n }
const b: B = { u: k(300), s: k(200), c: 7 }
print(b.u)
b.u = k(257)
print(b.u)
print(b.s)
b.s = k(129)
print(b.s)
const h: H = { u: k(70000), s: k(40000), c: 7 }
print(h.u)
h.u = k(65537)
print(h.u)
print(h.s)
h.s = k(32769)
print(h.s)
const lit: H = { u: 1, s: -3, c: 7 }
print(lit.s)
print(h.s + 1)
print(lit.c)
