// @run
// @log 1024
// @log 4
// @log 1024
// @log 4
// @log 2048
// A NEWTYPE over a STRUCT — the second customer, and the one that decided the
// design (`docs/internals/newtype-design.md`, `buffer-design.md` §L2).
//
// `F32View` and `I32View` in `std:buffer` are the SAME shape, `{base, length}`.
// Under pure structural typing an `I32View` satisfies every `F32View` parameter
// and integer bytes read back as floats with no diagnostic; the interim shipped
// with the element width in the FIELD name (`f32base` / `i32base`) because that is
// the only discriminator a structural checker can see. `new` mints the identity
// instead, and the rejection it buys is pinned by
// `tests/cases/std/buffer-view-element-type-mismatch.vl`.
//
// This file is the single-file model of that shape, and what it pins is the part
// people expect a nominal type to take away and it does not:
//
//   - an OBJECT LITERAL constructs either view with no cast, because a literal is
//     brand-polymorphic — it is checked field-wise against the destination, which
//     re-applies the brand rule to every field VALUE;
//   - field READ, PARAMETER, RETURN and ARRAY-ELEMENT positions all work;
//   - the two views still share ONE wasm heap type, because the brand is a
//     checker-side column and the emitter never learns it exists. Zero cost is not
//     "cheap", it is byte-identical to the same program with `new` deleted.
type FView = new { base: i32, length: i32 }
type IView = new { base: i32, length: i32 }

function mkF(b: i32, n: i32): FView { return { base: b, length: n } }

function readFBase(v: FView) { return v.base }

const fv = mkF(1024, 4)
print(readFBase(fv))
print(fv.length)

const iv: IView = { base: 1024, length: 4 }
print(iv.base)
print(iv.length)

const many: FView[] = [{ base: 2048, length: 1 }, { base: 4096, length: 1 }]
print(readFBase(many[0]))
