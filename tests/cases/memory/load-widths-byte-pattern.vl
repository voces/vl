// @run
// @log 4
// @log 3
// @log 2
// @log 1
// @log 772
// @log 258
// @log 6153737366864528132
// Every load width read off ONE known byte pattern, so the widths are checked
// against each other and not just against themselves.
//
// Two i32 stores lay down eight bytes, little-endian:
//
//   __store_i32__(0, 0x01020304)   →  04 03 02 01
//   __store_i32__(4, 0x55667788)   →  88 77 66 55
//
// so byte k at address k is (4-k) for k in 0..3, the 16-bit halves are 0x0304
// (772) and 0x0102 (258), and the whole 8 bytes read as one i64 are
// 0x5566778801020304 = 6153737366864528132.
//
// Expectations derived independently (python `struct`, the same two's-complement
// and little-endian spec the wasm load instructions implement), never read back
// off VL's own output.
__store_i32__(0, 0x01020304)
__store_i32__(4, 0x55667788)
print(__load_u8__(0))
print(__load_u8__(1))
print(__load_u8__(2))
print(__load_u8__(3))
print(__load_i16__(0))
print(__load_u16__(2))
print(__load_i64__(0))
