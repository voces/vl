// @check
// @error-at 32:14 argument 1: expected TVAddr, got NodeAddr
// @error-at 33:15 argument 1: expected NodeAddr, got TVAddr
// The discriminating half of `flat-generic-rows-branded-bracket.vl`: the program
// the brand is supposed to STOP (webcraft P1.2,
// `docs/internals/flat-records-design.md` §11.3).
//
// Every row address is an `i32` at runtime, so the working file cannot tell a
// brand from no brand — only this one can. Both directions are pinned, because a
// brand that stops one crossing and not its mirror is a half-taught rule.
import { Buffer } from "std:buffer"

flat type TValue = { value: i64, tt: i32, pad: i32 }
flat type Node = { key: i32, val: i32 }

type TVAddr = new i32
type NodeAddr = new i32

type Rows<R, A> = { base: i32, count: i32, brand: A }

function "[]"<R, A>(self: Rows<R, A>, i: i32): A {
  return self.base + i * R.size
}

function tt(self: TVAddr) { return __load_i32__((self as i32) + TValue.tt) }

function val(self: NodeAddr) { return __load_i32__((self as i32) + Node.val) }

const buf = Buffer(4096)
const st: Rows<TValue, TVAddr> = { base: buf.base + 64, count: 4, brand: 0 }
const nd: Rows<Node, NodeAddr> = { base: buf.base + 2048, count: 4, brand: 0 }

print(tt(nd[1]))
print(val(st[1]))
