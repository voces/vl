// @emit-error has no field 'nosuch'
// The twin of `flat-generic-rows-not-flat-rejected.vl`: the binding IS a flat
// type, and the member is not one of its layout members.
//
// Both misses are separate answers from `flatConstOfNameProp` for the same reason
// they are separate files — they are different mistakes, and the monomorphizer
// names each against the binding that made it. The message repeats the layout
// surface (`.size` and one offset per declared field), which is the same sentence
// the non-generic `Rec.nope` reject gives, because it is the same rule.
flat type TValue = { value: i64, tt: i32, pad: i32 }

type Rows<T> = { base: i32, count: i32 }

function "[]"<T>(self: Rows<T>, i: i32): i32 {
  return self.base + i * T.nosuch
}

const st: Rows<TValue> = { base: 1000, count: 4 }

print(st[1])
