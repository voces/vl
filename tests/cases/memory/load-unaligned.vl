// @run
// @log -2013199869
// @log 515
// @log 34817
// @log 24038036589314563
// @log 1.5
// @log 1.5
// THE ALIGNMENT IMMEDIATE IS A HINT, NOT A CONSTRAINT. Every load width writes
// its NATURAL alignment exponent (0/1/2/3 for 8/16/32/64-bit), but the wasm spec
// permits an access at ANY address regardless: an engine treats a mismatch as a
// missed optimization, never a fault. This case reads every width at an ODD
// address to hold that property down, because the whole load matrix would be
// quietly unusable over packed byte layouts if it were not true.
//
// Layout: 04 03 02 01 88 77 66 55  (0x01020304 at 0, 0x55667788 at 4)
//
//   __load_i32__(1) = 0x88010203 = -2013199869   (align-exp 2, address 1)
//   __load_i16__(1) = 0x0203     = 515           (align-exp 1, address 1)
//   __load_u16__(3) = 0x8801     = 34817         (align-exp 1, address 3)
//   __load_i64__(1) = 24038036589314563          (align-exp 3, address 1)
//
// then 1.5 read at f32 width from address 1 and at f64 width from address 3,
// each written by an unaligned pair of narrow stores' worth of i32 words placed
// so the float's bytes straddle the natural boundary.
__store_i32__(0, 0x01020304)
__store_i32__(4, 0x55667788)
print(__load_i32__(1))
print(__load_i16__(1))
print(__load_u16__(3))
print(__load_i64__(1))
// f32 1.5 (0x3FC00000) starting at address 33: bytes 00 00 C0 3F at 33..36,
// laid down by two i32 stores whose overlap places them there.
__store_i32__(32, 0x00000000)
__store_i32__(36, 0x0000003F)
__store_i32__(33, 0x3FC00000)
print(__load_f32__(33))
// f64 1.5 (0x3FF8000000000000) starting at address 51.
__store_i32__(48, 0x00000000)
__store_i32__(51, 0x00000000)
__store_i32__(55, 0x3FF80000)
print(__load_f64__(51))
