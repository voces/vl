// @run
// @log -1
// @log 255
// @log -1
// @log 65535
// @log -128
// @log 128
// @log -32768
// @log 32768
// @log 127
// @log 127
// THE reason both spellings exist. A narrow load results in an i32 either way;
// the `_s` form SIGN-extends the byte/halfword into it and the `_u` form ZERO-
// extends it, so the same byte reads as two different numbers:
//
//   byte 0xFF    __load_i8__  = -1        __load_u8__  = 255
//   byte 0x80    __load_i8__  = -128      __load_u8__  = 128
//   half 0xFFFF  __load_i16__ = -1        __load_u16__ = 65535
//   half 0x8000  __load_i16__ = -32768    __load_u16__ = 32768
//   byte 0x7F    both = 127                              (below the sign bit,
//                                                         the two agree — the
//                                                         control that proves
//                                                         the pairs above are
//                                                         differing for the
//                                                         RIGHT reason)
//
// Each value is stored as a full i32 and read back narrow, so the high bytes of
// the stored word are provably not participating.
__store_i32__(0, 0x000000FF)
print(__load_i8__(0))
print(__load_u8__(0))
__store_i32__(4, 0x0000FFFF)
print(__load_i16__(4))
print(__load_u16__(4))
__store_i32__(8, 0x00000080)
print(__load_i8__(8))
print(__load_u8__(8))
__store_i32__(12, 0x00008000)
print(__load_i16__(12))
print(__load_u16__(12))
__store_i32__(16, 0x0000007F)
print(__load_i8__(16))
print(__load_u8__(16))
