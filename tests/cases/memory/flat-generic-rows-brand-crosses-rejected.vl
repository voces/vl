// @check
// @error-at 37:21 argument 1: expected TVAddr, got NodeAddr
// @error-at 38:22 argument 1: expected NodeAddr, got TVAddr
// The discriminating witness for the branded generic row accessor: the program
// where the brands are supposed to STOP it (webcraft P1.2,
// `docs/internals/flat-records-design.md` §11.3).
//
// `flat-generic-rows-branded.vl` shows one generic accessor serving two records
// and reading the right bytes. That program is not evidence of a brand — an
// accessor with NO brand at all passes it identically, because every row address
// is an `i32` at runtime. Only the reject below tells the two apart, which is why
// it is a separate file rather than a comment on that one.
//
// Both directions are pinned, because a brand that stops one crossing and not
// its mirror is a half-taught rule.
import { Buffer } from "std:buffer"

flat type TValue = { value: i64, tt: i32, pad: i32 }
flat type Node = { key: i32, val: i32 }

type TVAddr = new i32
type NodeAddr = new i32

type Rows<R, A> = { base: i32, count: i32, brand: A }

function rowAt<R, A>(self: Rows<R, A>, i: i32): A {
  return self.base + i * R.size
}

function tt(self: TVAddr) { return __load_i32__((self as i32) + TValue.tt) }

function val(self: NodeAddr) { return __load_i32__((self as i32) + Node.val) }

const buf = Buffer(4096)
const st: Rows<TValue, TVAddr> = { base: buf.base + 64, count: 4, brand: 0 }
const nd: Rows<Node, NodeAddr> = { base: buf.base + 2048, count: 4, brand: 0 }

print(tt(rowAt(nd, 1)))
print(val(rowAt(st, 1)))
