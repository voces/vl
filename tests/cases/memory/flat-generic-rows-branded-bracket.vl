// §10's `rows<T>` sketch, whole: one generic container, one generic bracket, and
// row addresses the checker keeps apart (webcraft P1.2,
// `docs/internals/flat-records-design.md` §11.3).
//
// `flat-generic-rows-branded.vl` gets the brand through a plain CALL. This file
// gets it through the BRACKET, which needs one thing that file does not: `x[i]`
// used to be typed at the operator's DECLARED return, so a generic `"[]"`
// handed every site the same bare type parameter. The bind happens at the site
// now, from the receiver's structure — which is why `A` has to be named in the
// container body and not merely passed as a type argument.
//
// Read alongside `flat-generic-rows-branded-bracket-crosses-rejected.vl`: this
// half only shows the addresses are right, and an accessor with no brand at all
// produces byte-identical output.
// @log 1024
// @log 1072
// @log 2048
// @log 2072
// @log 77
// @log 77
// @log 99
// @log 99

flat type TValue = { value: i64, tt: i32, pad: i32 }
flat type Node = { key: i32, val: i32 }

type TVAddr = new i32
type NodeAddr = new i32

type Rows<R, A> = { base: i32, count: i32, brand: A }

function "[]"<R, A>(self: Rows<R, A>, i: i32): A {
  return self.base + i * R.size
}

function tt(self: TVAddr) { return __load_i32__((self as i32) + TValue.tt) }

function val(self: NodeAddr) { return __load_i32__((self as i32) + Node.val) }

const st: Rows<TValue, TVAddr> = { base: 1024, count: 4, brand: 0 }
const nd: Rows<Node, NodeAddr> = { base: 2048, count: 4, brand: 0 }

// The derived addresses: stride 16 for TValue, stride 8 for Node, from ONE
// operator.
print(st[0] as i32)
print(st[3] as i32)
print(nd[0] as i32)
print(nd[3] as i32)

// Write through the DERIVED address, read back at a HAND-COMPUTED one.
__store_i32__((st[2] as i32) + TValue.tt, 77)
print(__load_i32__(1024 + 2 * 16 + 8))
print(tt(st[2]))

__store_i32__((nd[2] as i32) + Node.val, 99)
print(__load_i32__(2048 + 2 * 8 + 4))
print(val(nd[2]))
