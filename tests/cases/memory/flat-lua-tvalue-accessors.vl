// @run
// @log 3
// @log 100
// @log 3
// @log 200
// @log 5
// @log 300
// @log 16
// @log 1
// THE FORCING CUSTOMER, in miniature: Lua 5.3's `TValue` in an arena, addressed
// entirely through constants DERIVED from the declaration (webcraft P1.2).
//
// This is the measurement behind the phasing in `flat-records-design.md` §6.3 —
// what `flat type` ALONE buys, without the `buf.rows<T>` accessor (§6.1) or the
// `stack[i].tt` sugar (§6.2) the requirements doc also asks for.
//
// Today, WITHOUT this feature, the same code is written with `+ 8` and `* 16`
// spelled as literals, hand-computed from a layout that is written down NOWHERE.
// Add a field, reorder two, widen an i32 to an i64, and every one of those
// literals is silently wrong: the program still compiles, still runs, and reads
// the wrong bytes. That is the defect class this tier exists to prevent, and it is
// the one the declaration closes.
//
// What §6.1 and §6.2 would remove from this file is the last two accessors PER
// FIELD — boilerplate, not expressiveness. Nothing here is unreachable today, and
// that is why the layout half shipped first.
import { Buf, Buffer } from "std:buffer"

flat type TValue = { value: i64, tt: i32, pad: i32 }
type Stack = new { base: i32, count: i32 }

function stackOf(b: Buf, off: i32, count: i32): Stack {
  const s: Stack = { base: b.base + off, count: count }
  return s
}
function slotAt(s: Stack, i: i32) { return s.base + i * TValue.size }
function tagOf(s: Stack, i: i32) { return __load_i32__(slotAt(s, i) + TValue.tt) }
function setTag(s: Stack, i: i32, v: i32) {
  __store_i32__(slotAt(s, i) + TValue.tt, v)
}
function valOf(s: Stack, i: i32) {
  return __load_i64__(slotAt(s, i) + TValue.value)
}
function setVal(s: Stack, i: i32, v: i64) {
  __store_i64__(slotAt(s, i) + TValue.value, v)
}

const buf = Buffer(4096)
const st = stackOf(buf, 64, 128)
setTag(st, 0, 3)
setVal(st, 0, 100 as i64)
setTag(st, 1, 3)
setVal(st, 1, 200 as i64)
setTag(st, 7, 5)
setVal(st, 7, 300 as i64)

let i = 0
while i < 2 {
  print(tagOf(st, i))
  print(valOf(st, i) as i32)
  i = i + 1
}
print(tagOf(st, 7))
print(valOf(st, 7) as i32)

// The stride the accessors used is the DECLARED one, and it is the spec's number.
print(TValue.size)
// Slot 7 sits exactly 7 strides past slot 0 — asserted against the raw address,
// not against another derived one.
let ok = 0
if slotAt(st, 7) - slotAt(st, 0) == 7 * 16 { ok = 1 }
print(ok)
