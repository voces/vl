// @run
// A wide store's value operand read from a narrower number variable widens to the width (an
// `i32` or `f32` into an `f64` store), and an `i64` variable goes in as it stands.
function putF(a: i32, x: i32) { __store_f64__(a, x) }
function putG(a: i32, x: f32) { __store_f64__(a, x) }
function putH(a: i32, x: i64) { __store_i64__(a, x) }
putF(0, 3)
print(__load_i64__(0))
putG(8, 1.5)
print(__load_i64__(8))
putH(16, 7)
print(__load_i64__(16))
// @log 4613937818241073152
// @log 4609434218613702656
// @log 7
