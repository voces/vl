// @run
// @log 5000000077
// @log 1069547520
// @log 4609434218613702656
// @log 1234
// @log -4611123068473966592
// @log 4613937818241073152
// @log 1065353216
// @log 5000000077
// @log 1.5
// @log 1.5
// THE THREE WIDE STORE WIDTHS (`buffer-design.md` §C2's other half):
//
//   __store_i64__ → i64.store (0x37, align-exp 3)
//   __store_f32__ → f32.store (0x38, align-exp 2)
//   __store_f64__ → f64.store (0x39, align-exp 3)
//
// Each is verified by ROUND TRIP against a DIFFERENT width, so the store and the
// load check each other rather than agreeing on a shared mistake: an f32 written
// at 8 is read back as the i32 bit pattern at 8, an f64 at 16 as the i64 pattern.
// Every expectation below is the python `struct` encoding of the value, not a
// hand-derived one — two hand-derived expectations were wrong in the load slice.
//
//   f32  1.5 → 1069547520      f32  1.0 → 1065353216
//   f64  1.5 → 4609434218613702656
//   f64 -2.25 → -4611123068473966592     f64 3.0 → 4613937818241073152
//
// The address is an i32 in all fourteen load/store ops; the VALUE takes the width
// the declaration names, so an integer literal re-encodes at i64, a float literal
// at f32/f64, and a narrower variable widens where the checker permits it.

// i64: a value past the i32 range, stored and read at its own width.
__store_i64__(0, 5000000077)
print(__load_i64__(0))

// f32 and f64, each read back as the integer bit pattern of the same width.
__store_f32__(8, 1.5)
print(__load_i32__(8))
__store_f64__(16, 1.5)
print(__load_i64__(16))

// An i32 VARIABLE widening into the i64 store's value operand.
function putWide(a: i32, x: i32) {
  __store_i64__(a, x)
  0
}
putWide(24, 1234)
print(__load_i64__(24))

// f64 from a variable, and from a bare integer literal.
const neg: f64 = -2.25
__store_f64__(32, neg)
print(__load_i64__(32))
__store_f64__(40, 3)
print(__load_i64__(40))

// An f32 variable, and an f32 read straight back into an f32 store.
const one: f32 = 1.0
__store_f32__(48, one)
print(__load_i32__(48))

// A store as a function's implicit TAIL statement. This is the shape that kept the
// widths unshipped once: a store leaves NOTHING on the stack, so classifying it as
// the body's value emits a function that promises a result and produces none — an
// invalid module. `emit_classify.stmtIsTailValue` knows the three names now.
function putI64(a: i32, v: i64) { __store_i64__(a, v) }
putI64(56, 5000000077)
print(__load_i64__(56))

// UNALIGNED at the two widths whose natural alignment is not 1. The alignment
// immediate is a HINT, not a constraint — the spec permits an access at any
// address — and these pin that for the stores as the load slice did for the loads.
__store_f32__(65, 1.5)
print(__load_f32__(65))
__store_f64__(83, 1.5)
print(__load_f64__(83))
