// THE TWO NARROW STORE WIDTHS, which complete `buffer-design.md` §C2's matrix:
//
//   __store_i8__  → i32.store8  (0x3a, align-exp 0)
//   __store_i16__ → i32.store16 (0x3b, align-exp 1)
//
// Verified by disassembly, not by reading the table: `3a 00 00` and `3b 01 00`.
//
// A store is sign-AGNOSTIC — one instruction per width, and it TRUNCATES — so there
// is no `__store_u8__` twin (§O2, ruled). The loads keep their split because there
// really are two instructions there, and this file uses that asymmetry as its oracle:
// every byte written narrow is read back BOTH ways, and the two readings must differ
// exactly where the high bit is set. Every expectation is python's byte model, never
// hand-derived.
// EVERY LANE OF A WORD. The narrow stores' natural alignment is 0 and 1, but the
// alignment immediate is a HINT — an 8-bit store is legal at every address and a
// 16-bit one at every address including the ones that STRADDLE two words.
__store_i8__(0, 65)
__store_i8__(1, 66)
__store_i8__(2, 67)
__store_i8__(3, 68)
print(__load_u8__(0))
print(__load_u8__(1))
print(__load_u8__(2))
print(__load_u8__(3))
// the four bytes read back as ONE i32 — the store and the load check each other
print(__load_i32__(0))

// TRUNCATION and the SIGN/ZERO-EXTENSION pair. A store has no signedness: one
// instruction per width, and it discards the high bits. `__store_i8__(a, -1)` and
// `__store_i8__(a, 255)` write the SAME byte, which `__load_i8__` reads as -1 and
// `__load_u8__` as 255. The 127 cell is the CONTROL where both spellings agree.
__store_i8__(16, 255)
__store_i8__(17, 256)
__store_i8__(18, -1)
__store_i8__(19, 127)
__store_i8__(20, 128)
__store_i8__(21, 511)
print(__load_u8__(16))
print(__load_i8__(16))
print(__load_u8__(17))
print(__load_i8__(17))
print(__load_u8__(18))
print(__load_i8__(18))
print(__load_u8__(19))
print(__load_i8__(19))
print(__load_u8__(20))
print(__load_i8__(20))
print(__load_u8__(21))
print(__load_i8__(21))

// NEIGHBOUR SURVIVAL. One byte poked into a word leaves the other three exactly
// as they were — the property the read-modify-write emulation in `std:buffer` had
// to work for, and that the instruction gets for free.
__store_i32__(32, 287454020)
__store_i8__(33, 238)
print(__load_u8__(32))
print(__load_u8__(33))
print(__load_u8__(34))
print(__load_u8__(35))

// 16-BIT AT EVERY LANE, including lane 3 — the halfword that straddles the word
// boundary and that a word-level read-modify-write cannot express in one go.
__store_i16__(48, 4660)
__store_i16__(53, 4661)
__store_i16__(58, 4662)
__store_i16__(63, 4663)
print(__load_u16__(48))
print(__load_u16__(53))
print(__load_u16__(58))
print(__load_u16__(63))

// 16-BIT truncation and the sign/zero pair, with 32767 as the agreeing CONTROL.
__store_i16__(80, 65535)
__store_i16__(84, 65536)
__store_i16__(88, -1)
__store_i16__(92, 32767)
__store_i16__(96, 32768)
__store_i16__(100, 74565)
print(__load_u16__(80))
print(__load_i16__(80))
print(__load_u16__(84))
print(__load_i16__(84))
print(__load_u16__(88))
print(__load_i16__(88))
print(__load_u16__(92))
print(__load_i16__(92))
print(__load_u16__(96))
print(__load_i16__(96))
print(__load_u16__(100))
print(__load_i16__(100))

// A STRADDLING 16-bit store across two initialised words: bytes 3 and 4 change,
// the other six do not.
__store_i32__(112, -1431655766)
__store_i32__(116, -1145324613)
__store_i16__(115, 4660)
print(__load_u8__(112))
print(__load_u8__(113))
print(__load_u8__(114))
print(__load_u8__(115))
print(__load_u8__(116))
print(__load_u8__(117))
print(__load_u8__(118))
print(__load_u8__(119))

// A narrow store as a function's implicit TAIL statement — the shape that kept the
// WIDE widths unshipped for a PR (`emit_classify.stmtIsTailValue`): a store leaves
// nothing on the stack, so classifying it as the body's value promises a result the
// function does not produce. The `stmtIsTailValue` arm is membership-driven, so
// these two names were covered the day they joined `nameIsMemStoreIntrinsic`.
function tail8(a: i32, v: i32) { __store_i8__(a, v) }
function tail16(a: i32, v: i32) { __store_i16__(a, v) }
tail8(128, 205)
tail16(132, 4660)
print(__load_u8__(128))
print(__load_u16__(132))

// The B3/O7 axis: a named function wrapping the intrinsic in a module that also
// uses a FUNCTION VALUE, and the intrinsic inside a lambda body. Both positions
// used to fail `captured variable not found in enclosing frame` for every memory
// intrinsic; `capScan` asks `nameIsEmitterIntrinsic` now, so a newly reserved name
// is exempt the same day.
const bump = (x: i32) => x + 1
function put8(a: i32, v: i32) {
  __store_i8__(a, v)
  0
}
put8(144, 199)
print(bump(1))
print(__load_u8__(144))
const stash = (a: i32) => {
  __store_i16__(a, 999)
  a
}
stash(148)
print(__load_u16__(148))

// THE LAST LEGAL ADDRESS of each narrow width in the one page the module starts
// with — 65535 for a byte, 65534 for a halfword. One byte further is
// `store-narrow-past-page-end-traps.vl`.
__store_i8__(65535, 222)
print(__load_u8__(65535))
__store_i16__(65534, 43981)
print(__load_u16__(65534))
