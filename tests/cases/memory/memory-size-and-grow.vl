// @run
// @log 1
// @log 1
// @log 4
// @log 4
// @log 4
// `memory.size` and `memory.grow`, against exactly what the wasm spec says they
// return — which is the part that is easy to get backwards:
//
//   memory.size      → the CURRENT size, in 64 KiB pages.
//   memory.grow(d)   → the size BEFORE the growth, in pages (NOT the new size,
//                      NOT a success flag), or -1 if the growth failed.
//
// So a module that starts at one page reads:
//
//   __memory_size__()    = 1     one page, the emitter's hardcoded minimum
//   __memory_grow__(3)   = 1     the PREVIOUS count — this is the tell
//   __memory_size__()    = 4     1 + 3
//   __memory_grow__(0)   = 4     a zero-page grow is legal and reports the size
//   __memory_size__()    = 4     and changes nothing
//
// `memory-grow-failure.vl` pins the -1.
print(__memory_size__())
print(__memory_grow__(3))
print(__memory_size__())
print(__memory_grow__(0))
print(__memory_size__())
