// A row-accessor LIBRARY: the flat layout, the row brand, the container brand,
// the index operator and the field accessors, all exported from one module. This
// is the shape the Lua VM port wants — one module per record.
//
// Note what is NOT exported: nothing names the `"[]"` operator, because an index
// operator has no name a use site could write. The entry reaches it by writing a
// bracket on a value whose type this module declared.
export flat type TValue = { value: i64, tt: i32, pad: i32 }

export type RowAddr = new i32
export type Stack = new { base: i32, count: i32 }

export function "[]"(self: Stack, i: i32): RowAddr {
  return (self.base + i * TValue.size) as RowAddr
}

export function tt(self: RowAddr) {
  return __load_i32__((self as i32) + TValue.tt)
}
export function setTt(self: RowAddr, v: i32) {
  __store_i32__((self as i32) + TValue.tt, v)
}
export function value(self: RowAddr) {
  return __load_i64__((self as i32) + TValue.value)
}
export function setValue(self: RowAddr, v: i64) {
  __store_i64__((self as i32) + TValue.value, v)
}

export function mkStack(base: i32, count: i32): Stack {
  return { base: base, count: count }
}
