// @run
// @log 7
// @log 4242
// @log 16
// THE MERGE AXIS for the fused row pattern: every piece lives in `./lib`.
//
// Two different mechanisms have to survive the module merge here, and they
// survive it for different reasons:
//
//   - the BRACKET (`st[3]`) names nothing, so there is nothing to alias — the
//     checker's operator registry is built from the already-merged program and
//     holds the mangled minted name from the start (`index-operator-design.md` §R4);
//   - the UFCS accessors (`.setTt`, `.tt`) DO carry a property string, and that
//     string is deliberately left plain by the merge, so they reach the mangled
//     function through `ufcsAliasOf` — a different route entirely.
//
// The fused spelling rides BOTH on every single access, which is why the
// cross-module case is worth pinning separately from the single-file one.
//
// `TValue.size` also crosses: the layout constants fold against an IMPORTED flat
// declaration exactly as against a local one.
import { Buffer } from "std:buffer"
import { mkStack, setTt, setValue, TValue, tt, value } from "./lib"

const buf = Buffer(4096)
const st = mkStack(buf.base + 64, 128)

st[3].setTt(7)
st[3].setValue(4242 as i64)
print(st[3].tt())
print(st[3].value() as i32)
print(TValue.size)
