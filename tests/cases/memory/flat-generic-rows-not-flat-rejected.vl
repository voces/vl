// @check
// @error-at 18:6 `T` is bound to `Plain`, which is not a `flat` type, so it has no byte layout for `T.size`
// A layout member on a type PARAMETER is admitted in the generic body, where the
// checker sees `T` and not `Plain`, and asked again at each call: the call's
// binding is what answers "is it flat" (webcraft P1.2, `flat-records-design.md` §11).
//
// The reject is therefore at the CALL, here an index operator's site, and names the
// binding. One accessor set still serves every flat record; a binding that is not
// one is refused by `vl check` rather than at `vl build` (D12470).
//
type Plain = { a: i32 }

type Rows<T> = { base: i32, count: i32 }

function "[]"<T>(self: Rows<T>, i: i32): i32 { return self.base + i * T.size }

const st: Rows<Plain> = { base: 1000, count: 4 }

print(st[1])
