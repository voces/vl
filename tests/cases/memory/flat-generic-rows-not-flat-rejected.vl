// @emit-error `T` is bound to `Plain`, which is not a `flat` type
// A layout member on a type PARAMETER is checked at the INSTANCE, not at the
// generic body — the checker sees `T`, not `Plain`, so "is it flat" is a question
// only a binding can answer (webcraft P1.2, `flat-records-design.md` §11).
//
// The reject is therefore at EMIT, and this file pins that it is loud and names
// the binding. That is the standing cost of deferring the fold: `vl check` passes
// and `vl build` rejects. It buys the thing the deferral exists for — one accessor
// set serving every flat record — and the alternative (rejecting every `T.size` in
// the checker) is what this feature replaced.
type Plain = { a: i32 }

type Rows<T> = { base: i32, count: i32 }

function "[]"<T>(self: Rows<T>, i: i32): i32 {
  return self.base + i * T.size
}

const st: Rows<Plain> = { base: 1000, count: 4 }

print(st[1])
