// @run
// @log 1
// @log 2
// A parameter may take the intrinsic's name, and then a call through it is an ordinary call:
// the build folds only an `if` whose `__memory_shared__()` the checker resolved to the intrinsic.
function f(__memory_shared__: () => boolean) {
  if __memory_shared__() { return 1 }
  2
}
print(f(() => true))
print(f(() => false))
