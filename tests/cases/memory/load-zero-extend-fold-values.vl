// @run
// @log 4294934657
// @log 4294934657
// @log 4294934657
// @log 4294934657
// @log 65535
// @log 32897
// @log 255
// @log 129
// @log 4294934656
// @log 32897
// @log 129
// @log 0
// @log -32639
// @log 2049
// The values of the spellings the emitter folds into a zero-extending i64 load (plumb PL-048:
// `(__load_i32__(p, off) as% i64) & 4294967295`), and of the neighbours it must not fold.
// tests/vl_zext_load_fold_test.ts reads the instructions; this pins that both agree on the value.
const M32: i64 = 0xFFFFFFFF
const P = 4096
__store_i32__(P, 0xFFFF8081)
function wrap32(p: i32) { (__load_i32__(p, 0) as% i64) & 4294967295 }
function prop32(p: i32) { (__load_i32__(p) as i64) & 0xffff_ffff }
function twice32(p: i32) { (((__load_i32__(p) as% i64) & M32)) & M32 }
function left32(p: i32) { 4294967295 & (__load_i32__(p) as% i64) }
function u16(p: i32) { (__load_u16__(p, 2) as% i64) & 65535 }
function u16bare(p: i32) { __load_u16__(p) as i64 }
function u8(p: i32) { ((__load_u8__(p, 3) as% i64)) & 4294967295 }
function u8bare(p: i32) { __load_u8__(p) as% i64 }
// Not folded: the mask drops a bit, or keeps sign bits, or narrows past the load's width.
function dropBit(p: i32) { (__load_i32__(p) as% i64) & 4294967294 }
function low16(p: i32) { (__load_i32__(p) as% i64) & 0xffff }
function u16low8(p: i32) { (__load_u16__(p) as% i64) & 255 }
function u8bit(p: i32) { (__load_u8__(p) as% i64) & 16 }
function signed(p: i32) { __load_i32__(p) as i64 }
// A parameter spelled like the intrinsic is the parameter, not the load.
function shadow(__load_u8__: (i32) => i32, p: i32) { __load_u8__(p) as i64 }
print(wrap32(P))
print(prop32(P))
print(twice32(P))
print(left32(P))
print(u16(P))
print(u16bare(P))
print(u8(P))
print(u8bare(P))
print(dropBit(P))
print(low16(P))
print(u16low8(P))
print(u8bit(P))
print(signed(P))
print(shadow((q: i32): i32 => q - 2047, P))
