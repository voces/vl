// A type PARAMETER answers for its layout: ONE generic row accessor serves every
// flat record, because `T.size` and `T.<field>` fold per monomorphized instance
// (webcraft P1.2, `docs/internals/flat-records-design.md` §11).
//
// The two records have DIFFERENT strides, so a single shared instance — the
// failure mode the per-instance fold exists to prevent — cannot pass this: it
// would address both at whichever binding instantiated last.
//
// Every WRITE goes through the derived address and every verification READ comes
// back through a raw intrinsic at a HAND-COMPUTED one, because an address scheme
// can be internally consistent and still be wrong about which bytes it touches.
// @log 1024
// @log 1040
// @log 1072
// @log 2048
// @log 2056
// @log 2072
// @log 16
// @log 8
// @log 8
// @log 4
// @log 77
// @log 77
// @log 99
// @log 99
// @hint Intentionally-unused parameter `_self`
// @hint Intentionally-unused parameter `_self`
// @hint Intentionally-unused parameter `_self`
// @hint redundant type annotation: `"[]" for Rows<T>` is inferred as `i32`
// @hint redundant type annotation: `strideOf` is inferred as `i32`
// @hint redundant type annotation: `ttOffOf` is inferred as `i32`
// @hint redundant type annotation: `valOffOf` is inferred as `i32`
// @hint redundant type annotation: `st` is inferred as `{base: i32, count: i32}`
// @hint redundant type annotation: `nd` is inferred as `{base: i32, count: i32}`

flat type TValue = { value: i64, tt: i32, pad: i32 }
flat type Node = { key: i32, val: i32 }

type Rows<T> = { base: i32, count: i32 }

function "[]"<T>(self: Rows<T>, i: i32): i32 {
  return self.base + i * T.size
}

function strideOf<T>(_self: Rows<T>): i32 {
  return T.size
}

function ttOffOf<T>(_self: Rows<T>): i32 {
  return T.tt
}

function valOffOf<T>(_self: Rows<T>): i32 {
  return T.val
}

const st: Rows<TValue> = { base: 1024, count: 4 }
const nd: Rows<Node> = { base: 2048, count: 4 }

// The derived addresses: stride 16 for TValue, stride 8 for Node.
print(st[0])
print(st[1])
print(st[3])
print(nd[0])
print(nd[1])
print(nd[3])

// The constants themselves, per instance.
print(strideOf(st))
print(strideOf(nd))
print(ttOffOf(st))
print(valOffOf(nd))

// Write through the DERIVED address, read back at a HAND-COMPUTED one.
__store_i32__(st[2] + TValue.tt, 77)
print(__load_i32__(1024 + 2 * 16 + 8))
print(__load_i32__(st[2] + TValue.tt))

__store_i32__(nd[2] + Node.val, 99)
print(__load_i32__(2048 + 2 * 8 + 4))
print(__load_i32__(nd[2] + Node.val))
