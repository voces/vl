// @check
// @error-at 44:12 member access '.tt' on non-object NodeAddr
// @error-at 46:12 argument 1: expected RowAddr, got i32
// TWO row-address brands over the SAME representation, told apart by brand alone —
// the Lua VM's actual shape, where a `TValue` slot and a `Node` slot are both
// `i32` addresses into the same arena and confusing them reads plausible garbage.
//
// This is what makes the fused pattern SAFE rather than merely short. Every row
// address is an `i32` at runtime, so without P1.5's brands these two accessor sets
// would be one interchangeable pile and a `Node` address handed to a `TValue`
// accessor would silently load the wrong four bytes. Branded, it is a checker
// error naming both types.
//
// Two `"[]"` operators coexist in one program, dispatching by receiver — B14's R2
// mint (`index-operator-design.md` §R2), which is what lets one module carry a
// stack and a node table at once.
//
// The second error pins the other direction: a bare `i32` VARIABLE does not flow
// into a row address. (A literal deliberately does — `newtype-base-value-rejected.vl`
// states that rule — so this uses a variable.)
import { Buffer } from "std:buffer"

flat type TValue = { value: i64, tt: i32, pad: i32 }
flat type Node = { key: i64, val: i64, next: i32, pad: i32 }

type RowAddr = new i32
type NodeAddr = new i32
type Stack = new { base: i32, count: i32 }
type Nodes = new { base: i32, count: i32 }

function "[]"(self: Stack, i: i32): RowAddr {
  return (self.base + i * TValue.size) as RowAddr
}
function "[]"(self: Nodes, i: i32): NodeAddr {
  return (self.base + i * Node.size) as NodeAddr
}
function tt(self: RowAddr) { return __load_i32__((self as i32) + TValue.tt) }
function next(self: NodeAddr) { return __load_i32__((self as i32) + Node.next) }

const buf = Buffer(4096)
const st: Stack = { base: buf.base + 64, count: 128 }
const nd: Nodes = { base: buf.base + 2048, count: 32 }
print(st[0].tt())
print(nd[0].next())
print(nd[0].tt())
const raw = 5
print(tt(raw))
