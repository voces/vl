// @run
// @log 1
// @hint redundant type annotation: `memory` is inferred as `i32`
// The CONTROL for `export-memory-name-collision.vl`. A function exported as
// `memory` is only a conflict in a program that also uses linear memory — the
// memory export is gated on the memory existing, exactly as the memory SECTION
// is. A program that never touches linear memory is byte-for-byte what it was
// before P0.2: no memory, no memory export, no reject.
export function memory(): i32 { 1 }

print(memory())
