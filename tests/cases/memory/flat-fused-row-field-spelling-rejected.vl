// @check
// @error-at 33:12 member access '.tt' on non-object RowAddr
// THE ONE DIVERGENCE from webcraft P1.2's spelling, pinned as the reject it is.
//
// The requirements doc writes `stack[i].tt` — a FIELD. VL's UFCS is call-style,
// so the fused row accessors are reached as `stack[i].tt()`, and the paren-less
// form is what this file pins. It is a LOUD CHECKER REJECT, not a wrong address
// and not a silently different value: `RowAddr` is a brand over `i32`, an `i32`
// has no members, and the checker says exactly that. The line above it calls the
// SAME accessor in the working spelling, so the only difference between the two
// is the parens.
//
// That failure mode is the one this tier wants. The alternative worth naming is
// what would happen if `RowAddr` were branded over a STRUCT instead: `.tt` would
// then resolve as a real field read of a materialized row, which is precisely the
// fusion the ask forbids. Branding over `i32` makes the wrong spelling
// unrepresentable rather than merely slower.
//
// The working fixture is `flat-fused-row-accessors.vl`.
import { Buffer } from "std:buffer"

flat type TValue = { value: i64, tt: i32, pad: i32 }
type RowAddr = new i32
type Stack = new { base: i32, count: i32 }

function "[]"(self: Stack, i: i32): RowAddr {
  return (self.base + i * TValue.size) as RowAddr
}
function tt(self: RowAddr) { return __load_i32__((self as i32) + TValue.tt) }

const buf = Buffer(4096)
const st: Stack = { base: buf.base + 64, count: 128 }
print(st[0].tt())
print(st[0].tt)
