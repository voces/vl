// @run
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log 0
// @log 1
// @log 0
// @log 0
// A fresh memory is ZERO-FILLED at every width, with no data segment emitted —
// which is what lets a bump allocator that never reuses an address satisfy
// webcraft's "zero-filled" requirement for free, with no explicit clearing.
//
// The last three lines are the part that only became askable with `memory.grow`:
// a NEWLY GROWN page is zero too. Growth does not hand back reused bytes, so the
// guarantee holds for the whole address space a program ends up with, not just
// for the page it started with.
print(__load_u8__(1000))
print(__load_i16__(1000))
print(__load_i32__(1000))
print(__load_i64__(1000))
print(__load_f32__(1000))
print(__load_f64__(1000))
print(__memory_grow__(1))
print(__load_i32__(65536))
print(__load_u8__(131071))
