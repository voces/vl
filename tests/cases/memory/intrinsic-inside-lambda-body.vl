// @run
// @log 7
// @log 1
// THE SECOND FAILING POSITION, pinned in its own right (D-CAPCALLEE).
//
// `load-width-in-named-fn-with-lambda.vl` covers "a named function in a module
// that uses a function value"; this covers the other half of the censused pair —
// the intrinsic called from INSIDE a lambda body, where the free identifier is
// recorded against the lambda's own frame. On master both spellings below failed
// with `captured variable not found in enclosing frame`.
//
// `__memory_size__` takes no arguments, so it also pins that the callee-position
// skip does not depend on there being an argument to scan.
function main() {
  __store_i32__(0, 7)
  const rd = () => __load_i32__(0)
  const pages = () => __memory_size__()
  print(rd())
  print(pages())
}
main()
