// @run
// @log 2
// @log 4609434218613702656
// @log 4613937818241073152
// A wide store inside a LAMBDA body, and inside a named function in a module that
// uses a function value — the two positions where every memory intrinsic used to
// fail `emitProgram: captured variable not found in enclosing frame`.
//
// #1172 made that exemption a POSITION rather than a name filter, but the set it
// consults (`emit_base.isBuiltinFnName`) was a PARTIAL COPY of the checker's
// reservation list, so a newly-lowered intrinsic could be reserved in one file and
// still capturing in the other. `capScan` now asks
// `typecheck.nameIsEmitterIntrinsic` — the authoritative "the emitter rewrites this
// call site" list, which is exactly the condition that makes the exemption sound —
// so these three names were exempt the same day they acquired their arms.
//
// The expectations are python `struct` encodings: f64 1.5 → 4609434218613702656,
// f64 3.0 → 4613937818241073152.
const bump = (x: i32) => x + 1

// A named function wrapping the intrinsic, in a module that uses a function value.
function put(a: i32, v: f64) {
  __store_f64__(a, v)
  0
}
put(0, 1.5)
print(bump(1))
print(__load_i64__(0))

// The intrinsic called from inside a lambda body.
const stash = (a: i32) => {
  __store_f64__(a, 3)
  a
}
stash(8)
print(__load_i64__(8))
