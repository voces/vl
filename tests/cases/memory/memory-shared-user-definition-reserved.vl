// @check
// @error '__memory_shared__' is a compiler intrinsic and cannot be redefined
// @error '__memory_shared__' is internal to std
// The build decides `__memory_shared__()` by name, so a user function of the same name would be
// silently discarded; the call below is refused independently, since this module is not std.
function __memory_shared__() { return true }
print(__memory_shared__())
