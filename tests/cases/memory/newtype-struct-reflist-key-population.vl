// @run
// @log 11
// @log 22
// @log 33
// @log 44
// @log 1
// @log 2
// @log 3
// @log 4
// @log 500
// @log 5
// @log 600
// @log 700
// The four ref-list ELEMENT spellings a `new` newtype puts in play at once, in one
// program — the population `repElemKeyOfNameTy` keys, and the one the fuzzer cannot
// reach (its grammar emits no `new` type).
//
// A newtype has TWO live arena indices over ONE `Ty`: the BASE that `cUserTypes`
// registers, and `nwBrand`'s second entry, which is what the annotation grammar
// resolves the name to. Only the base owns an `sNames` row, so `repElemKey` keys the
// base NOMINALLY (`S<row>`) and the brand STRUCTURALLY — which is why two same-shape
// newtypes (`PView` / `QView`) and a bare inline shape share ONE ref-list slot while
// the same-shape PLAIN declared struct (`Plain`) keeps its own. All four still read
// back their own values; a slot merge that crossed them would print another's.
type PView = new { base: i32, length: i32 }
type QView = new { base: i32, length: i32 }
type Plain = { base: i32, length: i32 }
type Holder = { ps: PView[], qs: QView[] }

function readP(xs: PView[]): i32 { return xs[0].base }
function readQ(xs: QView[]): i32 { return xs[0].base }
function readPlain(xs: Plain[]): i32 { return xs[0].base }
function readInline(xs: { base: i32, length: i32 }[]): i32 { return xs[0].base }

const ps: PView[] = [{ base: 11, length: 1 }]
const qs: QView[] = [{ base: 22, length: 2 }]
const pl: Plain[] = [{ base: 33, length: 3 }]
const il: { base: i32, length: i32 }[] = [{ base: 44, length: 4 }]

print(readP(ps))
print(readQ(qs))
print(readPlain(pl))
print(readInline(il))
print(ps[0].length)
print(qs[0].length)
print(pl[0].length)
print(il[0].length)

// The nested ref-list and the struct FIELD, whose element rows are interned through
// the same bridge from a recorded NAME rather than from an expression's type.
const grid: PView[][] = [[{ base: 500, length: 5 }]]
print(grid[0][0].base)
print(grid[0][0].length)

const h: Holder = {
  ps: [{ base: 600, length: 6 }],
  qs: [{ base: 700, length: 7 }],
}
print(h.ps[0].base)
print(h.qs[0].base)
