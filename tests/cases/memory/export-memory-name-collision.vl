// @emit-error exports a function named 'memory'
// P0.2 exports the module's linear memory under the name `memory` (the name a
// host reaches for: `instance.exports.memory.buffer`). Wasm export names must be
// unique, so a program that BOTH uses linear memory AND exports a function called
// `memory` would build an invalid module. It is rejected instead, loudly, at the
// one place that can see both names.
//
// The reject is gated on the memory existing: a program that exports a function
// named `memory` and never touches linear memory still compiles — nothing is
// competing for the name. That control is `export-memory-name-no-collision.vl`.
//
// This is the cost of ruling O4 as "automatic, always `memory`", and it is
// mechanically fixable (rename the function).
export function memory(): i32 { 1 }

__store_i32__(0, 7)
print(__load_i32__(0))
