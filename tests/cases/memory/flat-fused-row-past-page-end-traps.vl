// @trap memory access out of bounds
// THE BOUNDS POLICY for a fused row access, stated as the trap it is.
//
// `st[i]` on a row-ADDRESS receiver adds NO check of its own — not to the index,
// not to the address. That is deliberate and it is the same policy
// `load-past-page-end-traps.vl` states for a raw intrinsic: a `RowAddr` IS a raw
// address, the engine's own bounds check is the policy, and a desync-class bug
// should be loud rather than recoverable.
//
// This is the one place the fused spelling differs from `std:buffer`'s views,
// which DO fence each access (`buffer-design.md` §L3) because a view carries a
// length. A `Stack` here carries a `count` field and the operator deliberately
// ignores it: fencing would put a compare-and-trap on the hot path of exactly the
// tier that exists to be a raw arena. A program that wants the fence writes it in
// the operator body, which is four lines of ordinary VL and is the RIGHT place for
// the choice to live — the operator is user code.
//
// Row 4096 sits at base + 4096*16 = 65600-ish, past the one page the module starts
// with, so the load faults.
import { Buffer } from "std:buffer"

flat type TValue = { value: i64, tt: i32, pad: i32 }
type RowAddr = new i32
type Stack = new { base: i32, count: i32 }

function "[]"(self: Stack, i: i32): RowAddr {
  return (self.base + i * TValue.size) as RowAddr
}
function tt(self: RowAddr) { return __load_i32__((self as i32) + TValue.tt) }

const buf = Buffer(4096)
const st: Stack = { base: buf.base + 64, count: 128 }
// `count` is 128 and the index is 4096: the operator does not consult it.
print(st[4096].tt())
