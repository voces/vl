// @log 255
// @log 4295000447
// The three zero-extending i64 loads, `__load_u8_i64__`/`__load_u16_i64__`/`__load_u32_i64__`
// (plumb PL-048): every stored value has its top bit set, so a sign-extending load would print a
// negative number. Each is read at no offset, at a memarg offset, and at a constant address.
const P = 4096
__store_i32__(P, 0xFFFFFFFF)
__store_i32__(P, 4, 0x80000000)
__store_i32__(P + 8, 0x80008001)
__store_i32__(P + 12, 0xFFFF8081)
function at(p: i32) { __load_u32_i64__(p) }
print(at(P))
print(__load_u32_i64__(P, 4))
print(__load_u32_i64__(P + 8))
print(__load_u32_i64__(4096, 0))
print(__load_u16_i64__(P))
print(__load_u16_i64__(P, 6))
print(__load_u16_i64__(P + 12))
print(__load_u16_i64__(P + 12, 2))
print(__load_u8_i64__(P))
print(__load_u8_i64__(P, 7))
print(__load_u8_i64__(P + 12))
print(__load_u8_i64__(P + 12, 3))
print(
  __load_u32_i64__(P + 12)
    + __load_u16_i64__(P + 12, 2)
    + __load_u8_i64__(P + 12, 3),
)
