// @run
// @log 10
// @log 0
// @log 1
// @log 2
// @log 4
// @log 6
// @log 10
// @log 0
// @log 4
// @log 6
// @log 8
// @log 9
// @log 1
// @log 5
// @log 4
// @log -5
// @log 200
// @log 4000
// @log -300
// @log 999
// @log 200

// Sub-word storage widths in a `flat` record (webcraft P1.2, veldt ask #3): u8/i8 are one
// byte, u16/i16 two, folded into the running-sum layout. Read/written through the existing
// byte load/store intrinsics at the folded offset. Legal only inside `flat`; erased before emit.

flat type Voxel = { sdf: i8, mat: u8, hp: u16, dx: i16, id: i32 }

// The width in each position, and the running-sum offsets it produces.
print(Voxel.size) // 1+1+2+2+4 = 10
print(Voxel.sdf)  // 0
print(Voxel.mat)  // 1
print(Voxel.hp)   // 2
print(Voxel.dx)   // 4
print(Voxel.id)   // 6

// The same widths reversed — order is layout, so the offsets change.
flat type Rev = { id: i32, dx: i16, hp: u16, mat: u8, sdf: i8 }
print(Rev.size) // 10
print(Rev.id)   // 0
print(Rev.dx)   // 4
print(Rev.hp)   // 6
print(Rev.mat)  // 8
print(Rev.sdf)  // 9

// A single byte field, and a nested `flat` whose inner byte field composes by addition.
flat type One = { b: u8 }
flat type Outer = { x: i32, k: One }
print(One.size)        // 1
print(Outer.size)      // 4 + 1 = 5
print(Outer.k + One.b) // 4 + 0 = 4

// Round-trip: write each field at its FOLDED offset, read it back through the matching width,
// so the fold is proven against a real load — a signed i8, an unsigned u8, both half-words.
__store_i8__(1024 + Voxel.sdf, 0 - 5)
__store_i8__(1024 + Voxel.mat, 200)
__store_i16__(1024 + Voxel.hp, 4000)
__store_i16__(1024 + Voxel.dx, 0 - 300)
__store_i32__(1024 + Voxel.id, 999)
print(__load_i8__(1024 + Voxel.sdf)) // -5
print(__load_u8__(1024 + Voxel.mat)) // 200
print(__load_u16__(1024 + Voxel.hp)) // 4000
print(__load_i16__(1024 + Voxel.dx)) // -300
print(__load_i32__(1024 + Voxel.id)) // 999
print(__load_u8__(1024 + 1))         // 200 — mat at the hand-computed offset
