// @run
// @log 1
// @log 305419896
// @log -120
// @log 136
// @log 22136
// @log 4660
// @log 18
// @log 1311768464867721352
// THE LAST BYTES OF THE PAGE. One page is 65536 bytes, so the highest address
// each width may legally START at is 65536 minus its own size:
//
//   i8/u8  65535     i16/u16  65534     i32  65532     i64  65528
//
// Every width is read at exactly its own last legal address. `memory.size` is
// printed first, so the case states the page count its addresses are derived
// from and cannot silently pass against a differently sized memory.
//
// Bytes after the two stores, at 65528..65535:  88 00 00 00 78 56 34 12
//
//   __load_i32__(65532) = 0x12345678 = 305419896
//   __load_i8__(65528)  = 0x88 signed   = -120
//   __load_u8__(65528)  = 0x88 unsigned = 136
//   __load_u16__(65532) = 0x5678 = 22136
//   __load_u16__(65534) = 0x1234 = 4660          ← the final halfword
//   __load_u8__(65535)  = 0x12   = 18            ← the final byte
//   __load_i64__(65528) = 0x1234567800000088 = 1311768464867721352
//
// `load-page-boundary-trap.vl` is the other half: one byte further traps.
print(__memory_size__())
__store_i32__(65528, 0x00000088)
__store_i32__(65532, 0x12345678)
print(__load_i32__(65532))
print(__load_i8__(65528))
print(__load_u8__(65528))
print(__load_u16__(65532))
print(__load_u16__(65534))
print(__load_u8__(65535))
print(__load_i64__(65528))
