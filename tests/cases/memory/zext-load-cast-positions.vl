// @run
// @log 254
// @log u65534
// @log 4294967294
// @log c254
// @log h65534
// @log 254
// @log 65534
// @log 4294967294
// @log 254
// @log 4294967294
// @log 65534
// @log 254
// @log 254
// Q58 position sweep: a narrow load folded with its widening into the zero-extending `_i64` load
// (`zextLoadOf`), spelled as an `as% i64` cast and as a mask that only zero-extends, in every
// delivery position.
import { toString } from "std:fmt"

type U = i64 | string
type R = { v: i64 }
const B = 4096
function sc(x: i64) { return x }
function un(u: U) { return if u is string { u } else { "u" + toString(u) } }
function ld8() { return __load_u8__(B) as% i64 }
function ld16() { return __load_u16__(B) as% i64 }
function m32() { return (__load_i32__(B) as% i64) & 4294967295 }
function opt(c: boolean): i64 | null { return if c { null } else { 1 } }
__store_i32__(B, -2)
print(sc(__load_u8__(B) as% i64))
print(un(__load_u16__(B) as% i64))
print(sc(sc((__load_i32__(B) as% i64) & 4294967295)))
print("c" + toString(__load_u8__(B) as% i64))
print("h\{__load_u16__(B) as% i64}")
print(ld8())
print(ld16())
print(m32())
const k = __load_u8__(B) as% i64
const j = (__load_i32__(B) as% i64) & 4294967295
print(k)
print(j)
print(if k > 0 { __load_u16__(B) as% i64 } else { 0 })
print(opt(true) ?? (__load_u8__(B) as% i64))
const r: R = { v: (__load_u8__(B) as% i64) & 255 }
print(r.v)
