// @run
// @log 16
// @log 0
// @log 8
// @log 12
// @log 12
// @log 8
// @log 12
// @log 4
// @log 28
// @log 0
// @log 4
// @log 12
// @log 16
// @log 24
// @log 24
// @log 0
// @log 4
// @log 12
// @log 16
// @log 0
// FLAT RECORD LAYOUTS (webcraft P1.2) — the layout GRID: every scalar width in
// every position, with each offset asserted against the hand-computed value.
// `docs/internals/flat-records-design.md`.
//
// THE LAYOUT RULE, and it is the whole design: offsets are the RUNNING SUM of the
// declared field widths and the compiler never inserts a byte. No alignment, no
// trailing pad, no reordering. Field order IS layout.
//
// The requirements doc's own example is the argument for that rule. It spells
// `TValue` with an explicit `pad: i32` — which under C's natural-alignment rules
// would be REDUNDANT, since `{ i64, i32 }` is already padded out to 16 there. The
// pad is written because its author expects `{ value: i64, tt: i32 }` to be 12
// bytes. This file pins that it is (see `Head` below), and that `TValue` comes out
// at the size the spec states, with `tt` at the offset the spec states.
//
// The round-trip half — that these constants address the bytes they claim to —
// is `flat-roundtrip-raw-addresses.vl`. An offset table can be internally
// consistent and still wrong; only a load at the address proves it.

// The spec's own record, and its own arithmetic: "fixed size 16",
// "i32.load at offset + i*16 + 8".
flat type TValue = { value: i64, tt: i32, pad: i32 }
print(TValue.size)  // 16
print(TValue.value) // 0
print(TValue.tt)    // 8  — the spec's number
print(TValue.pad)   // 12

// NO IMPLICIT PADDING, stated as a difference: the same record WITHOUT the pad
// field is 12, not 16. Under C rules it would be 16 and the pad field above would
// buy nothing.
flat type Head = { value: i64, tt: i32 }
print(Head.size)    // 12, not 16
print(Head.tt)      // 8

// NO LEADING ALIGNMENT either: an i64 following an i32 sits at offset 4 and
// straddles the 8-byte boundary. Legal in wasm (the alignment immediate is a hint,
// not a constraint) and deliberate — a tier that pads cannot express a packed
// foreign layout.
flat type Straddle = { a: i32, b: i64 }
print(Straddle.size) // 12
print(Straddle.b)    // 4

// Every scalar width, in first / middle / last position.
flat type Wide = { a: f32, b: f64, c: i32, d: i64, e: f32 }
print(Wide.size) // 4 + 8 + 4 + 8 + 4 = 28
print(Wide.a)    // 0
print(Wide.b)    // 4
print(Wide.c)    // 12
print(Wide.d)    // 16
print(Wide.e)    // 24

// The same widths in the REVERSE order lay out differently — order is layout, and
// nothing is reordered to pack better.
flat type Rev = { e: f32, d: i64, c: i32, b: f64 }
print(Rev.size) // 4 + 8 + 4 + 8 = 24
print(Rev.e)    // 0
print(Rev.d)    // 4
print(Rev.c)    // 12
print(Rev.b)    // 16

// A single-field record is its field's width; an EMPTY one is 0. Both are
// well-defined under the running-sum rule and neither is special-cased.
flat type One = { only: i64 }
flat type Nothing = {}
print(One.size - 8 + Nothing.size)
