// @run
// @log 4
// @log 65534
// @log -2
// @log 200
// @log 4
// @log -56
// @log 1
// @log 44
// @log 1
// @log -6
// @log -25536
// Q58 position sweep: an `i16`, `u16` and `i8` list's element read at an i32, and a `flat`
// record's `i8`, `u16` and `i16` field built from and stored a plain i32, each in the start body
// and in a function.
flat type W = { s: i8, u: u16, t: i16 }
function k(n: i32) { return n }
const xs: i16[] = [-3, 7]
print(xs[0] + xs[1])
const us: u16[] = [65534]
print(us[0])
const bs: i8[] = [-2]
print(bs[0])
const w: W = { s: k(200), u: k(200), t: k(4) }
print(w.u)
print(w.t)
print(w.s)
w.u = k(65537)
print(w.u)
function inFn(n: i32) {
  const ys: i8[] = [-3, 7]
  const v: W = { s: k(n), u: k(1), t: k(-6) }
  print(ys[0] + n)
  print(v.u)
  print(v.t)
  v.t = k(40000)
  print(v.t)
}
inFn(47)
