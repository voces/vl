// @run
// @log 84
// @log 7
// @log 7
// @log 4242
// `stack[i].tt` as the requirements doc spells it — a FIELD-shaped read — closing the one
// divergence `flat-records-design.md` §9.1 recorded. `"[]"` still returns a row ADDRESS, and
// `tt` is now a getter over that address rather than a `self`-function, so the read needs no
// parentheses. It is an offset load and nothing else: at every optimisation level the module is
// byte-identical to the `.tt()` spelling (property-access-design.md, getters v1).
import { Buffer } from "std:buffer"

flat type TValue = { value: i64, tt: i32, pad: i32 }
type RowAddr = new i32
type Stack = new { base: i32, count: i32 }

function "[]"(self: Stack, i: i32): RowAddr {
  return (self.base + i * TValue.size) as RowAddr
}
get tt(self: RowAddr): i32 { __load_i32__((self as! i32) + TValue.tt) }
get value(self: RowAddr): i64 { __load_i64__((self as! i32) + TValue.value) }
function setTt(self: RowAddr, v: i32) {
  __store_i32__((self as! i32) + TValue.tt, v)
}
function setValue(self: RowAddr, v: i64) {
  __store_i64__((self as! i32) + TValue.value, v)
}

const buf = Buffer(4096)
const st: Stack = { base: buf.base + 64, count: 8 }
let i = 0
while i < 8 {
  st[i].setTt(i * 3)
  i = i + 1
}
let acc = 0
let j = 0
while j < 8 {
  acc = acc + st[j].tt
  j = j + 1
}
print(acc)

// The write goes through the derived address; the check reads the raw bytes back.
st[3].setTt(7)
print(st[3].tt)
print(__load_i32__(buf.base + 64 + 3 * 16 + 8))
st[5].setValue(4242)
print(st[5].value)
