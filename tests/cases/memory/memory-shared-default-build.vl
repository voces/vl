// @run
// @log false
// @log 1
// @log 2
// @log 3
// `__memory_shared__()` (std-internal) is decided by the build: `false` unless `--shared-memory`.
// An else-less `if` on it is folded away before emit, at top level, in a function and in a
// loop; anywhere else, such as an `if` with an `else`, it is an ordinary constant.
print(__memory_shared__())
if __memory_shared__() { print(100) }
function pick() {
  if __memory_shared__() { return 100 }
  1
}
print(pick())
let n = 0
while n < 2 {
  if __memory_shared__() { n = 10 }
  n = n + 1
}
print(n)
if __memory_shared__() { print(100) } else { print(3) }
