// ONE generic row accessor, every flat record, and the row addresses it hands
// back are BRANDED — the last thing §10's `rows<T>` sketch was missing
// (webcraft P1.2, `docs/internals/flat-records-design.md` §11.3).
//
// The brand is a FIELD of the container, not a phantom type argument, and that
// is the whole difference. The checker binds type parameters by STRUCTURAL
// unification against the argument's arena type; a generic alias application
// expands into its body, so a parameter mentioned nowhere in that body leaves
// nothing to unify and stays unbound — and an unbound type variable is
// assignable to everything, which is an unbranded address wearing a brand's
// spelling. Naming `A` in the body puts it back in the structure.
//
// The two parameters are bound by DIFFERENT layers, each by the rule it can
// actually apply: `A` structurally by the checker (below), `R` nominally by the
// monomorphizer, which is what folds `R.size` per instance (§11.1). `R` stays
// phantom precisely because the layer that reads it does not need it in the
// structure.
//
// The two records have different strides, so a single shared fold cannot pass
// this. Every WRITE goes through the derived address and every verification READ
// comes back through a raw intrinsic at a HAND-COMPUTED one (§7.2).
// @log 1024
// @log 1072
// @log 2048
// @log 2072
// @log 16
// @log 8
// @log 77
// @log 77
// @log 99
// @log 99
// @hint Intentionally-unused parameter `_self`

flat type TValue = { value: i64, tt: i32, pad: i32 }
flat type Node = { key: i32, val: i32 }

type TVAddr = new i32
type NodeAddr = new i32

type Rows<R, A> = { base: i32, count: i32, brand: A }

function rowAt<R, A>(self: Rows<R, A>, i: i32): A {
  return self.base + i * R.size
}

function strideOf<R, A>(_self: Rows<R, A>) { return R.size }

function tt(self: TVAddr) { return __load_i32__((self as i32) + TValue.tt) }

function val(self: NodeAddr) { return __load_i32__((self as i32) + Node.val) }

const st: Rows<TValue, TVAddr> = { base: 1024, count: 4, brand: 0 }
const nd: Rows<Node, NodeAddr> = { base: 2048, count: 4, brand: 0 }

// The derived addresses: stride 16 for TValue, stride 8 for Node.
print(rowAt(st, 0) as i32)
print(rowAt(st, 3) as i32)
print(rowAt(nd, 0) as i32)
print(rowAt(nd, 3) as i32)

// The constants themselves, per instance.
print(strideOf(st))
print(strideOf(nd))

// Write through the DERIVED address, read back at a HAND-COMPUTED one.
__store_i32__((rowAt(st, 2) as i32) + TValue.tt, 77)
print(__load_i32__(1024 + 2 * 16 + 8))
print(tt(rowAt(st, 2)))

__store_i32__((rowAt(nd, 2) as i32) + Node.val, 99)
print(__load_i32__(2048 + 2 * 8 + 4))
print(val(rowAt(nd, 2)))
