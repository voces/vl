// `vl test` meta-fixture: the other file importing ./counter (see a.test.vl).
import { expect, it, toEqual } from "std:test"
import { bump } from "./counter"

const first = bump()

it("b sees the shared module fresh", () => {
  expect(first).toEqual(1)
})

it("b keeps its own state across its tests", () => {
  expect(bump()).toEqual(2)
})
