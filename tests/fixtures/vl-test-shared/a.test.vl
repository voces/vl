// `vl test` meta-fixture: one of two files importing ./counter. Its top level bumps
// the shared counter once, so a file that saw the other file's bump would read 2.
import { expect, it, toEqual } from "std:test"
import { bump } from "./counter"

const first = bump()

it("a sees the shared module fresh", () => {
  expect(first).toEqual(1)
})

it("a keeps its own state across its tests", () => {
  expect(bump()).toEqual(2)
})
