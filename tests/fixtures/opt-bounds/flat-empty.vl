// A list of never-written four-field records, which `-O` and `-O3` store as one array of their
// fields (D3681), read out of range: index 0 of the list once it is emptied. It must trap as the unoptimised build
// does, with the engine's own bounds trap; `tests/vl_list_index_trap_test.ts` builds it at both
// rungs, checks the list was flattened, and pins the stdout before the trap.
type Q = { x: f64, y: f64, z: f64, w: f64 }

function q(b: i32): Q { ({ x: b as f64, y: 1.0, z: 2.0, w: 3.0 }) }
function at(xs: Q[], i: i32): f64 { xs[i].x + xs[i].w }

const qs: Q[] = []
let s = 0.0
for f in 0 until 50 {
  qs.clear()
  for b in 0 until 8 { qs.push(q(b + f)) }
  for b in 0 until 8 { s += at(qs, b) }
  for b in 0 until 8 { qs[b] = q(b) }
}
print(s)
qs.clear()
print(at(qs, 0))
print("unreached")
