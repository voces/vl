// `vl test` meta-fixture: the green path — nesting, hooks, negation, skips.
// Exercised by tests/vl_test_runner_test.ts; run it by hand with
// `vl test tests/fixtures/vl-test`.
//
// DELIBERATELY NOT `vl fmt`-normalized. The formatter has no trailing-lambda rule
// yet, so it explodes `it("name", () => { … })` into a vertical argument list —
// structurally, not on width. Written here the way a test file WANTS to read; the
// gap is filed in docs/internals/vl-test-design.md §Known gaps. `tests/` is outside
// the fmt gate by construction (scripts/lint-self.sh never passes it in).
import {
  beforeEach,
  describe,
  done,
  expect,
  it,
  itSkip,
  not,
  toBeFalse,
  toBeTrue,
  toEqual,
} from "std:test"

let hits = 0

beforeEach(() => {
  hits = hits + 1
  done()
})

it("adds", () => {
  expect(1 + 1).toEqual(2)
})

describe("strings", () => {
  it("compares by value", () => {
    expect("ab" + "c").toEqual("abc")
  })
  describe("nested", () => {
    it("reports its full path", () => {
      expect(true).toBeTrue()
    })
  })
})

it("negates", () => {
  expect(5).not().toEqual(6)
})

it("has booleans", () => {
  expect(false).toBeFalse()
})

it("ran the hook once per test", () => {
  expect(hits > 0).toBeTrue()
})

itSkip("is skipped and never runs", () => {
  expect(1).toEqual(2)
})
