// `vl test` meta-fixture: the green path — nesting, hooks, negation, skips.
// Exercised by tests/vl_test_runner_test.ts; run it by hand with
// `vl test tests/fixtures/vl-test`.
//
// This file is `vl fmt`-clean AS WRITTEN — the way a test file WANTS to read IS
// the canonical form, since the formatter's trailing-lambda exception
// (docs/internals/fmt-trailing-lambda-design.md) hugs `it("name", () => { … })`.
// Pinned as a formatter fixture by tests/vl_fmt_test.ts, so a regression in that
// rule reddens there rather than silently disfiguring every test file.
import {
  beforeEach,
  describe,
  done,
  expect,
  it,
  itSkip,
  not,
  toBeFalse,
  toBeTrue,
  toEqual,
} from "std:test"

let hits = 0

beforeEach(() => {
  hits = hits + 1
  done()
})

it("adds", () => {
  expect(1 + 1).toEqual(2)
})

describe("strings", () => {
  it("compares by value", () => {
    expect("ab" + "c").toEqual("abc")
  })
  describe("nested", () => {
    it("reports its full path", () => {
      expect(true).toBeTrue()
    })
  })
})

it("negates", () => {
  expect(5).not().toEqual(6)
})

it("has booleans", () => {
  expect(false).toBeFalse()
})

// A TEMPLATE LITERAL inside a test file. `vl test` appends a `std:test`
// re-export to every file, so module mode is already armed here and the
// injected `std:fmt` edge rides in beside the protocol's — the interaction
// worth pinning, since the appended line is the compiler's other source-level
// injection.
it("interpolates a template", () => {
  const n = 7
  expect(`n=${n}`).toEqual("n=7")
  expect(`plain`).toEqual("plain")
})

it("ran the hook once per test", () => {
  expect(hits > 0).toBeTrue()
})

itSkip("is skipped and never runs", () => {
  expect(1).toEqual(2)
})
