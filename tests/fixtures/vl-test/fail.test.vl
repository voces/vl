// `vl test` meta-fixture: a FAILING assertion reports its rendered message, and
// the tests around it still run — one failure does not end the file.
// `vl fmt`-clean as written — see the note in pass.test.vl.
import { expect, fail, it, toEqual } from "std:test"

it("passes before the failure", () => {
  expect(1).toEqual(1)
})

it("fails an assertion", () => {
  expect(7).toEqual(8)
})

it("shows a failing test's captured output", () => {
  print("about to fail")
  expect("left").toEqual("right")
})

it("fails outright", () => {
  fail("no branch reached")
})

it("passes after the failure", () => {
  expect(2).toEqual(2)
})

// The renderer-agreement pin (std/utf8.vl's one-renderer ruling names std:test's
// private vltI64Str as the knowingly-kept copy): this failure's message renders
// i64 min through THAT copy, and the runner test asserts the digits std:fmt's
// toString produces for the same value — so the two renderers cannot drift
// silently at the value where their shared negative-accumulator trick matters.
it("renders i64 min through the kept copy", () => {
  const wideMin: i64 = -9223372036854775808
  const one: i64 = 1
  expect(wideMin).toEqual(one)
})
