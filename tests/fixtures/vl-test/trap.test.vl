// `vl test` meta-fixture: the ISOLATION proof. A test that traps for a reason no
// matcher recorded — a raw `__trap__()`, an out-of-bounds index — fails with the
// engine's own trap text, and the tests AFTER it still run in this same file. That
// is what per-test host calls plus re-instantiation buy.
// `vl fmt`-clean as written — see the note in pass.test.vl.
import { expect, it, toEqual } from "std:test"

it("runs before the trap", () => {
  expect(1).toEqual(1)
})

it("traps on an out-of-bounds index", () => {
  const xs: i32[] = []
  print(xs[5])
})

it("traps outright", () => {
  __trap__()
})

it("still runs after two traps", () => {
  expect(42).toEqual(42)
})
