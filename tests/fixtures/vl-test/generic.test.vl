// `vl test` meta-fixture: the GENERIC assertion surface (std:test v2) — structs,
// arrays and negation flow through the same `expect`/`toEqual` the atoms use; a
// non-atom failure renders the `<value>` sentinel, and atom failures render
// exactly as v1 did (the i64 case here extends the exactness pin beyond
// fail.test.vl's i32/string).
// `vl fmt`-clean as written — see the note in pass.test.vl.
import { expect, it, not, toEqual } from "std:test"

type Point = { x: i32, y: i32 }

it("compares structs", () => {
  const p: Point = { x: 3, y: 4 }
  expect(p).toEqual({ x: 3, y: 4 })
})

it("renders a failing struct as the value sentinel", () => {
  const p: Point = { x: 3, y: 4 }
  expect(p).toEqual({ x: 3, y: 5 })
})

it("compares arrays by element", () => {
  expect([1, 2, 3]).toEqual([1, 2, 3])
  expect(["a", "b"]).toEqual(["a", "b"])
})

it("renders a failing string array as the value sentinel", () => {
  expect(["a"]).toEqual(["b"])
})

it("negates a struct comparison", () => {
  const p: Point = { x: 1, y: 1 }
  expect(p).not().toEqual({ x: 9, y: 9 })
})

it("renders a wide integer exactly", () => {
  const big: i64 = 5000000000
  expect(big).toEqual(3000000000 as i64)
})
