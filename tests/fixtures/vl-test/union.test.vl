// `vl test` meta-fixture: a UNION-TYPED receiver — `expect` where T is inferred
// as `i32 | string` from a union-typed return (the D947 route-around in
// std/test.vl: the dead atom arms of the render ladder validate because
// std:test mints every atom's value box). A failure renders the HELD arm
// exactly as v1 did — digits for the integer, quotes for the string — so the
// atom-exactness pin extends to union receivers.
// `vl fmt`-clean as written — see the note in pass.test.vl.
import { expect, it, toEqual } from "std:test"

function parse(s: string): i32 | string {
  if s == "4" { return 4 }
  s
}

it("asserts through a union-typed receiver", () => {
  expect(parse("4")).toEqual(4)
  expect(parse("x")).toEqual("x")
})

it("renders the held integer arm exactly", () => {
  expect(parse("4")).toEqual(5)
})

it("renders the held string arm exactly", () => {
  expect(parse("x")).toEqual("y")
})
