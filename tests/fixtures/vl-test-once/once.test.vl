import { expect, it } from "std:test"
import { appendTextFile, readTextFile } from "std:fs"
import { getEnv } from "std:env"

// Every run of this top level appends a line to `$VL_TOP_LOG`, so the log holds one
// line only when collection and the run share one instance.
const log = getEnv("VL_TOP_LOG")
if log is string { appendTextFile(log, "top\n") }

it("sees the top level ran once", () => {
  if log is string { expect(readTextFile(log)).toEqual("top\n") }
})

it("a second test in the file reads the same instance", () => {
  if log is string { expect(readTextFile(log)).toEqual("top\n") }
})
