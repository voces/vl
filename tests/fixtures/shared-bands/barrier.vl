// The generation barrier `docs/guide/workers.md` shows, and a round-trip check over it: each of
// `n` parties writes its slot, waits at the barrier, and counts every slot that is not this round's.
import { Buf, Buffer } from "std:buffer"
import {
  atomicAddI32,
  atomicLoadI32,
  atomicNotify,
  atomicStoreI32,
  atomicWaitI32,
} from "std:atomic"

// Word 0 counts arrivals this round, word 4 is the round number.
function barrier(b: Buf, n: i32) {
  const round = b.atomicLoadI32(4)
  if b.atomicAddI32(0, 1) + 1 == n {
    b.atomicStoreI32(0, 0)
    b.atomicAddI32(4, 1)
    b.atomicNotify(4, n)
  } else {
    while b.atomicLoadI32(4) == round { b.atomicWaitI32(4, round) }
  }
}
export function make(): i32 { return Buffer(8).base }
// Each of n parties: `rounds` times, write my slot, barrier, check everyone's slot, barrier.
export function run(at: i32, n: i32, me: i32, rounds: i32, slots: i32): i32 {
  const b: Buf = { base: at, length: 8 }
  const s: Buf = { base: slots, length: n * 4 }
  let bad = 0
  let r = 1
  while r <= rounds {
    s.atomicStoreI32(me * 4, r)
    barrier(b, n)
    let i = 0
    while i < n {
      if s.atomicLoadI32(i * 4) != r { bad = bad + 1 }
      i = i + 1
    }
    barrier(b, n)
    r = r + 1
  }
  return bad
}
export function slotsOf(n: i32): i32 { return Buffer(n * 4).base }
