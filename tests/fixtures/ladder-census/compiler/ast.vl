// A made-up compiler tree for the ladder and rep-classifier census pins.
export type Lit = { v: i32 }
export type Name = { s: string }
export type Add = { l: i32, r: i32 }
export type Neg = { e: i32 }
export type Blk = { xs: i32[] }
export type Node = Lit | Name | Add | Neg | Blk

export type TokKind = ""
  | "IDENT" // a name
  | "NUMBER"
  | "PLUS"
  | "MINUS"
  | "EOF"

export type Shape = { kind: TokKind, size: i32 }
