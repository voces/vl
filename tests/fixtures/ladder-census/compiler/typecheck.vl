export type TyPrim = { p: string }
export type TyArray = { elem: i32 }
export type TyMap = { k: i32, v: i32 }
export type TyNullable = { inner: i32 }
export type Ty = TyPrim | TyArray
  | TyMap
  | TyNullable

export type PrimName = "i32" | "f64" | "string" | "boolean"

export function primWidth(p: PrimName): i32 {
  if p == "i32" { return 4 }
  if p == "f64" { return 8 }
  if p == "string" { return 4 }
  if p == "boolean" { return 1 }
  return 0
}

export function tyIsRef(t: Ty): boolean {
  if t is TyArray { return true }
  if t is TyMap { return true }
  return false
}

function nodeArrayElemName(n: Node): string {
  if n is Lit { return "i32" }
  if n is Name { return "str" }
  return ""
}
