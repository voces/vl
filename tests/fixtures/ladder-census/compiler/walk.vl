import {
  closureFlag,
  heapSlotOf,
  listElemName,
  slotKey,
  vtKindOfType,
  vtKindOfTypeAgain,
  vtKindOfTypeOnceMore,
} from "./emit_rep.vl"

export function walkStmt(n: Node): i32 {
  if n is Blk { return 1 }
  if n is Neg { return 2 }
  if n is Add { return 3 }
  walkExpr(n)
}

export function walkExpr(n: Node): i32 {
  if n is Lit { return 1 }
  if n is Name { return 2 }
  if n is Blk { return walkStmt(n) }
  return 0
}

export function tokPrec(k: TokKind): i32 {
  if k == "PLUS" { return 1 }
  else if k == "MINUS" { return 1 }
  emitFail("tokPrec: no precedence for this token kind")
  0
}

export function tokAll(k: TokKind): i32 {
  if k == "IDENT" { return 1 }
  if k == "NUMBER" || k == "PLUS" { return 2 }
  if k == "MINUS" { return 3 }
  if k == "EOF" { return 4 }
  return 0
}

export function shapeSize(s: Shape): i32 {
  if s.kind == "IDENT" { return 1 }
  if s.kind == "NUMBER" { return 2 }
  return 0
}

export function nodeTag(n: Node): string {
  match n {
    Lit => "lit"
    Name | Add => "name"
    _ => ""
  }
}

export function vkWidth(k: VKind): i32 {
  match k {
    "i32" => 4
    "str" => 4
    _ => {
      emitFail("vkWidth: no width for this kind")
      0
    }
  }
}

export function eqRow(n: i32): i32 {
  if structIndexOfExpr(n) >= 0 { return 1 }
  if closureIdxOf(n) >= 0 { return 2 }
  if nulVariantIdxOfExpr(n) >= 0 { return 3 }
  return 0
}
