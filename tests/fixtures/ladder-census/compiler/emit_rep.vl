// Rep classifiers over the arena, names and tables.
export function vtKindOfType(t: Ty, name: string) {
  if t is TyPrim { return "i32" }
  if t is TyArray { return "list" }
  if nameIs(name, "Map") { return "struct" }
  "str"
}

export function heapSlotOf(t: Ty): i32 {
  if t is TyArray { return T.tys.length }
  if t is TyMap { return 2 }
  return -1
}

function nameIs(a: string, b: string): boolean { a == b }

export function listElemName(t: Ty, frame: i32): string {
  if t is TyArray { return tyToStr(t.elem) }
  if t is TyNullable { return name.substring(0, 3) }
  return ""
}

export function closureFlag(n: Node) {
  if exprIsClosure(n) { return 1 }
  if exprIsRef(n) { return 2 }
  0
}

function retKindFor(ix: i32): VKind {
  if fnReturnsClosure(ix) { return "closure" }
  fRetKind[ix]
}

export function slotKey(t: Ty): i32 {
  match t {
    TyPrim => 1
    TyArray => 2
    _ => 0
  }
}

function isStructKind(k: VKind): boolean {
  if structIndexOfExpr(k) >= 0 { return true }
  if variantIdxOfExpr(k) >= 0 { return true }
  if nulVariantIdxOfExpr(k) >= 0 { return true }
  false
}

function callsAll(t: Ty) {
  const a = vtKindOfType(t, "x")
  const b = heapSlotOf(t)
  const c = heapSlotOf(t) + slotKey(t)
  retKindFor(emitCurFnIx)
}
