// `vl test` meta-fixture: one deliberately SLOW test per file, so a run over these
// files measures SCHEDULING. Four files at ~80 ms each take ~320 ms serially
// (`--jobs 1`) and ~80 ms across four workers — the evidence that files really do
// run concurrently. Kept out of tests/fixtures/vl-test so the behavioural fixtures
// stay fast. `vl fmt`-clean as written — see the note in ../vl-test/pass.test.vl.
import { expect, it, toEqual } from "std:test"

it("burns cpu (a)", () => {
  let acc = 0
  let i = 0
  while i < 100000000 {
    acc = acc + (i % 7)
    i = i + 1
  }
  expect(acc > 0).toEqual(true)
})
