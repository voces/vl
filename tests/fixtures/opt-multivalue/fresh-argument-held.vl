// @log 276
// @log 70
// @log 20
// A written record passed as a HELD local (D3765): `emit` only reads its parameter, but
// writes the module's `last` before it reads. `it` is a fresh literal held in a local that
// `last` also holds, so the write reaches `it` while `emit` runs, and `emit` must read 7.
// Only a literal passed straight to `emit` has no other reference to write it.
type Item = { key: f64, height: f64 }
let draws: f64[] = []
let last: Item = { key: 0.0, height: 0.0 }
function emit(i: Item) {
  last.height = 7.0
  draws.push(i.height * 10.0 + i.key)
}
for k in 0 until 3 {
  const it = { key: k as f64, height: 1.0 }
  last = it
  emit(it)
  emit({ key: k as f64, height: 2.0 })
}
let s = 0.0
for v in draws { s += v }
print(s)
print(draws[0])
print(draws[1])
