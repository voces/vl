// @log 7476.833333333333
// @log 732
// @log 321
// @allocs 1
// sunpa's draw items (D3765): `Item` is written (`it.height = 3.0` on a stored item), yet a
// literal built as `emit`'s argument has no other reference, and `emit` only reads it and
// hands it on to `weight`, which only reads it too. So each literal is passed as its fields
// and no `Item` is made for `shadow` or `tree`. The stored item stays a struct, and `emit`
// reads the height its write gave it.
type Item = { key: f64, x: f64, y: f64, alpha: f64, height: f64, more: f64[] }
let draws: f64[] = []
const shared: f64[] = [0.5, 1.5, 2.5]
const items: Item[] = []
function weight(i: Item): f64 { i.key * 10.0 + i.height * 100.0 + i.alpha }
function emit(i: Item) {
  for k in 0 until 3 { draws.push(i.more[k] + i.x) }
  draws.push(i.x * 2.0 + i.y + i.alpha * i.key + i.height)
  draws.push(i.x * 3.0 + i.y - i.alpha * i.key + i.height)
  draws.push(i.x * 4.0 + i.y + i.alpha / (i.key + 1.0) + i.height)
  draws.push(i.x * 5.0 - i.y + i.alpha * i.key * i.height)
  draws.push(i.x * 6.0 + i.y * i.alpha + i.key + i.height)
  draws.push(i.x * 7.0 + i.y + i.alpha + i.key / (i.height + 1.0))
  draws.push(i.x * 8.0 - i.y * i.alpha + i.key + i.height)
  draws.push(i.x * 9.0 + i.y + i.alpha * i.alpha + i.key * i.height)
  draws.push(weight(i))
}
function shadow(x: f64, y: f64) {
  emit({ key: 0.0, x, y, alpha: 0.5, height: 0.0, more: shared })
}
function tree(x: f64, y: f64) {
  emit({ key: 1.0, x, y, alpha: 1.0, height: 0.0, more: shared })
}
for i in 0 until 30 {
  shadow(1.0, i as f64)
  tree(1.0, i as f64)
}
items.push({ key: 2.0, x: 0.0, y: 0.0, alpha: 1.0, height: 0.0, more: shared })
for it in items {
  it.height = 3.0
  emit(it)
}
let s = 0.0
for v in draws { s += v }
print(s)
print(draws.length)
print(draws[draws.length - 1])
