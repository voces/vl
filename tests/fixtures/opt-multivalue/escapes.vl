// @log 15
// @log 15
// @log 16
// @log true
// @log false
// @log 4.5
// @log 29
// @log 115
// @log 102
// Records that do escape, next to call sites of the same producers that do not (D3625):
// kept in a list, returned onward, captured by a closure, compared with `==`, passed to a
// generic, held in a record, picked by an `if`, passed through a function value, and one
// type written through an alias. Each prints a value that proves the right record was read.
type V = { x: f64, y: f64, z: f64 }
type W = { a: f64, b: f64 }

function mk(k: f64): V { ({ x: k, y: k + 1.0, z: k * 2.0 }) }
function mkw(k: f64): W { ({ a: k, b: -k }) }
function idg<T>(v: T): T { v }
function onward(k: f64): V {
  const v = mk(k)
  v
}
function apply(f: (k: f64) => V, k: f64): f64 { const v = f(k); v.x + v.z }
function bump(w: W) { w.a = w.a + 100.0 }

const kept: V[] = []
function run(k: f64) {
  kept.push(mk(k))
  print(kept[0].x + kept[0].y + kept[0].z)
  print(onward(k).x + onward(k).y + onward(k).z)
  const c = mk(k + 0.25)
  const h = () => c.x + c.y + c.z
  print(h())
  print(mk(k) == mk(k))
  print(mk(k) == mk(k + 1.0))
  print(idg(mk(k)).y)
  const box = { inner: mk(k * 2.0), n: 1 }
  print(box.inner.x + box.inner.y + box.inner.z + (box.n as f64) - 1.0)
  const w = mkw(k)
  bump(w)
  print(w.a + w.b * 0.0 + 4.5 + (if k > 0.0 { mk(k) } else { mk(-k) }).x * 2.0)
  print(apply(mk, k) + mkw(k).a + 88.0)
}
run(3.5)
