// @log 6765
// @log 10946
// @log 33
// @log 1346269
// @log 8013
// Producers that call themselves (D3625): a recursive producer read field by field, a
// field-only parameter handed back to the same function, and a TAIL-recursive producer whose
// result twin must tail-call its own twin. The last is the shape that once left a
// `return_call` to the struct-returning function inside a multi-value twin.
type P = { a: i32, b: i32 }
function fibp(n: i32): P {
  if n == 0 { return { a: 0, b: 1 } }
  const r = fibp(n - 1)
  ({ a: r.b, b: r.a + r.b })
}
function walk(p: P, n: i32): i32 {
  if n == 0 { return p.a + p.b }
  walk(p, n - 1) + p.a
}
function step(p: P, n: i32): P {
  if n == 0 { p } else { step({ a: p.b, b: p.a + p.b }, n - 1) }
}
function use(n: i32): i32 {
  const s = step(fibp(3), n)
  s.a * 1000 + s.b
}
print(fibp(20).a)
print(fibp(20).b)
print(walk(fibp(5), 4))
print(step({ a: 0, b: 1 }, 30).b)
print(use(3))
