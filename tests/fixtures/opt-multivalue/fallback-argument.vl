// @log 6
// @log -1
// @allocs 0
// sunpa's wrapFingers (D3803): `line` is handed to `unit` as the fallback it returns
// unchanged, at calls whose own results are held as fields without a local between: passed
// straight to `turn`, which only reads its axis, and as one arm of a merge `axis` holds. Both
// calls take `unit`'s result twin, so `line` is held as fields and no call makes a struct.
type V3 = { x: f64, y: f64, z: f64 }
function len(a: V3): f64 { sqrt(a.x * a.x + a.y * a.y + a.z * a.z) }
function unit(a: V3, fallback: V3): V3 {
  const l = len(a)
  if l < 1.0e-9 { fallback } else { ({ x: a.x / l, y: a.y / l, z: a.z / l }) }
}
function sub(a: V3, b: V3): V3 {
  ({ x: a.x - b.x, y: a.y - b.y, z: a.z - b.z })
}
let total = 0.0
function turn(axis: V3, w: f64) {
  total += axis.x * w + axis.y * 2.0 + axis.z * 4.0
}
function wrap(t: f64): f64 {
  total = 0.0
  const line = unit({ x: t, y: 0.0, z: 0.0 }, { x: 0.0, y: 0.0, z: 1.0 })
  for i in 0 until 3 {
    const bend = sub(
      { x: 0.0, y: i as f64, z: 0.0 },
      { x: 0.0, y: 1.0, z: 0.0 },
    )
    const axis = if i == 0 { unit(bend, line) } else { line }
    turn(unit(axis, line), 0.5)
  }
  total
}
print(wrap(0.0))
print(wrap(3.0))
