// @log 30
// @log 6
// A module `const` record made by a call, read field by field in a loop and passed to a
// function that only reads it. At `-O`/`-O3` the global holds its fields, one global each.
type Span = { lo: i32, hi: i32 }

function span(lo: i32, n: i32): Span { return ({ lo: lo, hi: lo + n }) }
function width(s: Span): i32 { return s.hi - s.lo }

const xs = [2, 4]
const S = span(xs[0], xs[1])

function total(k: i32): i32 {
  let t = 0
  for _i in 0 until k { t = t + S.lo + width(S) }
  return t
}

print(total(5))
print(S.hi)
