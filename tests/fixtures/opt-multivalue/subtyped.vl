// @log 3.7416573867739413
// @log 9
// @log 7.5
// @log 7.483314773547883
// @log 1.5
// @log 11
// sunpa's V3 after #3372 (D3630): `Pt = { x, y }` is a prefix of `V3 = { x, y, z }`, so the
// emitter declares V3 a subtype of Pt, and `Particle` has V3's wasm shape and is written in
// place. Neither may cost V3 its twins: a write is charged to its own type and that type's
// subtyping component, and V3's component (V3 and Pt) is never written. A module global and a
// record field hold V3, so the escape step leaves its producers alone.
type Pt = { x: f64, y: f64 }
type V3 = { x: f64, y: f64, z: f64 }
type Particle = { px: f64, ph: f64, py: f64 }
type Foot = { off: V3, lift: f64 }

const UP: V3 = { x: 0.0, y: 1.0, z: 0.0 }
const foot: Foot = { off: { x: 1.0, y: 2.0, z: 3.0 }, lift: 0.5 }
const spark: Particle = { px: 1.0, ph: 0.5, py: 0.0 }

function add(a: V3, b: V3): V3 {
  ({ x: a.x + b.x, y: a.y + b.y, z: a.z + b.z })
}
function scale(a: V3, k: f64): V3 { ({ x: a.x * k, y: a.y * k, z: a.z * k }) }
function length(a: V3): f64 { sqrt(a.x * a.x + a.y * a.y + a.z * a.z) }
function rotate(x: f64, y: f64): Pt { ({ x: y, y: x }) }
// Particles move in place, which is what marks their wasm shape as written.
function drift(p: Particle, dt: f64) {
  p.px = p.px + dt
  p.py = p.py + dt * 2.0
}

function hot_len(): f64 { length(foot.off) }
function hot_sum(k: f64): f64 {
  const s = add(scale(UP, k), foot.off)
  s.x + s.y + s.z
}
function hot_pt(): f64 {
  const p = rotate(1.5, 7.5)
  p.x
}
// A record carried round a loop.
function hot_loop(n: i32): f64 {
  let p: V3 = { x: 0.0, y: 0.0, z: 0.0 }
  for _i in 0 until n { p = add(p, scale(foot.off, 0.5)) }
  length(p)
}

print(hot_len())
print(hot_sum(3.0))
print(hot_pt())
print(hot_loop(4))
print(rotate(1.5, 2.0).y)
drift(spark, 5.0)
print(spark.px + spark.py - spark.ph * 0.0 - 5.0)
