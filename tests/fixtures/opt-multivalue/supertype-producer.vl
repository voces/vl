// @log 15
// @log 15
// @log 18
// @log 15
// @log 15
// @log 0
// @log 12
// A producer of the supertype `Pt` handing back a subtype `V3` producer's result (D3630):
// a bare tail call, an early `return`, `if` arms, a chain of two, and as another call's
// argument. A result twin of `Pt` returns two fields and `V3`'s returns three, so none of
// these may forward its call to the subtype's twin; each must still build and print, while
// `mk3`'s own field-only call site still gets its twin.
type Pt = { x: i32, y: i32 }
type V3 = { x: i32, y: i32, z: i32 }

function mk3(k: i32): V3 { ({ x: k, y: k * 2, z: k * 3 }) }
function bare(k: i32): Pt { mk3(k) }
function early(k: i32): Pt {
  if k > 3 { return mk3(k) }
  mk3(k + 1)
}
function arms(k: i32): Pt {
  if k > 100 { ({ x: 0, y: 0 }) } else { mk3(k) }
}
function chain(k: i32): Pt { bare(k) }
function sum(p: Pt): i32 { p.x + p.y }

print(bare(5).x + bare(5).y)
print(sum(early(5)))
print(sum(early(1)) + 12)
print(sum(arms(5)))
print(sum(chain(5)))
print(arms(200).x)
print(mk3(4).z)
