// @log 2
// @log 5
// @allocs 0
// sunpa's legs (D3767): `pf` is read field by field and handed to `unit` as the fallback it
// returns unchanged. That parameter is a field use only in `unit`'s result twin, which is the
// twin the call takes when its own result (`knee`) is held as fields, so `pf` is held as
// fields too and neither `unit` call makes a struct.
type V3 = { x: f64, y: f64, z: f64 }
const UP: V3 = { x: 0.0, y: 1.0, z: 0.0 }
function len(a: V3): f64 { sqrt(a.x * a.x + a.y * a.y + a.z * a.z) }
function unit(a: V3, fallback: V3): V3 {
  const l = len(a)
  if l < 1.0e-9 { fallback } else { ({ x: a.x / l, y: a.y / l, z: a.z / l }) }
}
function add(a: V3, b: V3): V3 {
  ({ x: a.x + b.x, y: a.y + b.y, z: a.z + b.z })
}
function scale(a: V3, k: f64): V3 { ({ x: a.x * k, y: a.y * k, z: a.z * k }) }
function legs(t: f64): f64 {
  const pf = unit({ x: t, y: 0.0, z: 1.0 }, { x: 0.0, y: 0.0, z: 1.0 })
  let s = UP.x
  for i in 0 until 4 {
    const ff: V3 = { x: i as f64 - t, y: 0.0, z: -pf.z * 0.1 }
    const knee = unit(add(ff, scale(pf, 0.1)), pf)
    s += knee.x + knee.z * 2.0
  }
  s
}
print(legs(1.0))
print(legs(0.0))
