// @log 11438.616050616034
// @log 840
// @allocs 1
// sunpa's draw items (D3754): a record wider than a result may be, with a list field, built
// per call and handed to a callee that only reads it. The callee is too large to inline, so
// only the multi-value step can pass the record as its fields; the list goes on as the same
// object, which `emit` reads and `ensure` grows in between. A module global holds both types;
// the one allocation left is `draws`'s, made once.
type Item = {
  key: f64,
  x: f64,
  y: f64,
  sprite: i32,
  alpha: f64,
  lift: f64,
  sx: f64,
  sy: f64,
  shade: f64,
  rot: f64,
  lightX: f64,
  lit: f64,
  ground: f64,
  height: f64,
  roll: f64,
  jump: f64,
  more: f64[],
}
let draws: f64[] = []
const shared: f64[] = [0.5]
const NONE: Item = {
  key: 0.0,
  x: 0.0,
  y: 0.0,
  sprite: 0,
  alpha: 0.0,
  lift: 0.0,
  sx: 0.0,
  sy: 0.0,
  shade: 0.0,
  rot: 0.0,
  lightX: 0.0,
  lit: 0.0,
  ground: 0.0,
  height: 0.0,
  roll: 0.0,
  jump: 0.0,
  more: shared,
}
function ensure(xs: f64[], n: i32) {
  while xs.length < n { xs.push(xs.length as f64) }
}
function emit(i: Item) {
  ensure(i.more, 3)
  for k in 0 until 3 { draws.push(i.more[k] + i.x) }
  draws.push(
    i.x * 2.0 + i.y + i.alpha * i.lift + i.sx / (i.sy + 0.5) + i.ground,
  )
  draws.push(
    i.key + i.shade + i.rot + i.lightX + i.lit + i.height + i.roll + i.jump,
  )
  draws.push(
    i.x * 3.0 + i.y + i.alpha * i.lift + i.sx / (i.sy + 1.5) + i.ground,
  )
  draws.push(
    i.key * i.shade + i.rot + i.lightX + i.lit + i.height + i.roll + i.jump,
  )
  draws.push(
    i.x * 4.0 + i.y + i.alpha * i.lift + i.sx / (i.sy + 2.5) + i.ground,
  )
  draws.push(
    i.key + i.shade * i.rot + i.lightX + i.lit + i.height + i.roll + i.jump,
  )
  draws.push(
    i.x * 5.0 + i.y + i.alpha * i.lift + i.sx / (i.sy + 3.5) + i.ground,
  )
  draws.push(
    i.key + i.shade + i.rot * i.lightX + i.lit + i.height + i.roll + i.jump,
  )
  draws.push(
    i.x * 6.0 + i.y + i.alpha * i.lift + i.sx / (i.sy + 4.5) + i.ground,
  )
  draws.push(
    i.key + i.shade + i.rot + i.lightX * i.lit + i.height + i.roll + i.jump,
  )
  draws.push(
    i.sprite as f64 + i.x * 7.0 + i.y + i.alpha * i.lift + i.sx / (i.sy + 5.5),
  )
}
function shadow(x: f64, y: f64) {
  emit(
    {
      key: 0.0,
      x,
      y,
      sprite: -1,
      alpha: 0.5,
      lift: 0.0,
      sx: 1.0,
      sy: 2.0,
      shade: 1.0,
      rot: 0.0,
      lightX: 0.0,
      lit: 0.0,
      ground: y,
      height: 0.0,
      roll: -1.0,
      jump: -1.0,
      more: shared,
    },
  )
}
function tree(x: f64, y: f64) {
  emit(
    {
      key: 1.0,
      x,
      y,
      sprite: 2,
      alpha: 1.0,
      lift: 0.0,
      sx: 1.0,
      sy: 1.0,
      shade: 1.0,
      rot: 0.0,
      lightX: 0.0,
      lit: 0.0,
      ground: y,
      height: 0.0,
      roll: -1.0,
      jump: -1.0,
      more: shared,
    },
  )
}
for i in 0 until 30 {
  shadow(1.0, i as f64)
  tree(1.0, i as f64)
}
let s = NONE.x
for v in draws { s += v }
print(s)
print(draws.length)
