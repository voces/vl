// @log 13
// @log 20
// @log 3
// @log 6
// A module `let` record written again from a function, beside a `const` record that is
// also stored in a list: the first is held as field globals and each write sets them all;
// the second escapes, so it stays a struct.
type Span = { lo: i32, hi: i32 }

function span(lo: i32, n: i32): Span { return ({ lo: lo, hi: lo + n }) }
function width(s: Span): i32 { return s.hi - s.lo }

const xs = [3, 4]
let cur = span(xs[0], xs[1])
const kept = span(xs[1], xs[0])
const all = [kept]

function step(n: i32) { cur = span(cur.hi, n + width(cur)) }

step(2)
print(cur.hi)
step(1)
print(cur.hi)
print(all[0].hi - kept.lo - width(kept) + 3)
print(width(all[0]) + kept.lo - 1)
