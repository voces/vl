// A small producer read as fields still gets its twin beside the capped function.
type P = { a: f64, b: f64 }
const P0: P = { a: 0.0, b: 0.0 }
function pair(t: f64): P { ({ a: t, b: t * 2.0 }) }
print(run(1.0) + pair(P0.a).b)
print(run(2.0) + pair(P0.b).b)
print(run(3.0) + pair(P0.a).a)
