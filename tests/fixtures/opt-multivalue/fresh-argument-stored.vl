// @log 58.5
// @log 9
// @log 3
// A fresh argument whose callee STORES it (D3765): `keep` pushes its parameter onto a list,
// writes the stored element through the list, then reads its parameter. `hold` captures it
// in a closure that writes it, and `back` returns it. Each parameter escapes, so each
// literal stays a struct and every read sees the write made through the other reference.
type Item = { key: f64, height: f64 }
let draws: f64[] = []
const held: Item[] = []
function keep(i: Item) {
  held.push(i)
  held[held.length - 1].height = 9.0
  draws.push(i.height + i.key)
}
function hold(i: Item) {
  const set = (h: f64) => {
    i.height = h
  }
  set(i.key * 4.0)
  draws.push(i.height)
}
function back(i: Item): Item { i }
for k in 0 until 3 {
  keep({ key: k as f64, height: 1.0 })
  hold({ key: k as f64 + 1.0, height: 0.0 })
  const b = back({ key: 5.0, height: k as f64 })
  b.height = b.height + 0.5
  draws.push(b.height)
}
let s = 0.0
for v in draws { s += v }
print(s)
print(draws[0])
print(held.length)
