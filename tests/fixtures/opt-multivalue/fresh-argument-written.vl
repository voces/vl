// @log 402
// @log 30
// @log 3.5
// A fresh argument whose callee WRITES it (D3765): `lift` sets a field of its parameter
// directly, and `raise` through a helper. Neither parameter is field-only, so each literal
// stays a struct, and each callee reads back the height it wrote.
type Item = { key: f64, x: f64, height: f64, more: f64[] }
let draws: f64[] = []
const shared: f64[] = [0.5]
function lift(i: Item) {
  i.height = i.height + 2.0
  draws.push(i.height * 10.0 + i.x)
  draws.push(i.key + i.height + i.more[0])
}
function bump(i: Item) { i.height = i.height * 3.0 + 1.0 }
function raise(i: Item) {
  bump(i)
  draws.push(i.height * 10.0 + i.x)
  draws.push(i.key + i.height + i.more[0])
}
for k in 0 until 4 {
  lift({ key: 1.0, x: k as f64, height: 1.0, more: shared })
  raise({ key: 2.0, x: k as f64, height: k as f64, more: shared })
}
let s = 0.0
for v in draws { s += v }
print(s)
print(draws[0])
print(draws[3])
