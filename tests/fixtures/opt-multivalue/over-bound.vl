// @log 45
// @log 90
// A nine-field record is past the step's bound (D3625, `MV_RECORD_MAX_FIELDS`), so its
// producer keeps its `struct.new` even where the caller only reads the fields. A module
// global holds the type, so the escape step leaves it alone too.
type R9 = {
  a: f64,
  b: f64,
  c: f64,
  d: f64,
  e: f64,
  f: f64,
  g: f64,
  h: f64,
  i: f64,
}
const ZERO: R9 = {
  a: 0.0,
  b: 0.0,
  c: 0.0,
  d: 0.0,
  e: 0.0,
  f: 0.0,
  g: 0.0,
  h: 0.0,
  i: 0.0,
}
function mk(k: f64): R9 {
  ({
    a: k,
    b: k + 1.0,
    c: k + 2.0,
    d: k + 3.0,
    e: k + 4.0,
    f: k + 5.0,
    g: k + 6.0,
    h: k + 7.0,
    i: k + 8.0,
  })
}
function sum(k: f64): f64 {
  const r = mk(k)
  r.a + r.b + r.c + r.d + r.e + r.f + r.g + r.h + r.i + ZERO.a
}
function twice(k: f64): f64 { mk(k).i * 0.0 + sum(k) * 2.0 }
print(sum(1.0))
print(twice(1.0))
