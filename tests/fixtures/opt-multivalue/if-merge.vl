// @log 106.7706681743
// @log 101.52350861181297
// @log 1.3416407864998738
// @log 1.8614271578730528
// @allocs 3
// sunpa's IK (D3766): `if p < 0 { sk.root } else { quatOf(g[p]) }` handed to a parameter
// that only reads it. The `if` leaves the record's fields: the producer's arm calls its
// twin, the field's arm reads the stored record there, and a struct literal's arm makes no
// struct at all. The same for a choice held in a local (`lead`), whose arms are locals. The
// three allocations left are the module globals', made once.
type Q = { x: f64, y: f64, z: f64, w: f64 }
type V3 = { x: f64, y: f64, z: f64 }
type Sk = { parents: i32[], root: Q }
const sk: Sk = {
  parents: [-1, 0, 1, 1],
  root: { x: 0.0, y: 0.0, z: 0.0, w: 1.0 },
}
const UP: V3 = { x: 0.0, y: 1.0, z: 0.0 }
const m: f64[] = [1.0, 2.0, 2.0, 4.0]
let acc = 0.0

function qnorm(q: Q): Q {
  const l = sqrt(q.x * q.x + q.y * q.y + q.z * q.z + q.w * q.w)
  ({ x: q.x / l, y: q.y / l, z: q.z / l, w: q.w / l })
}
function quatOf(k: f64): Q { qnorm({ x: m[0] + k, y: m[1], z: m[2], w: m[3] }) }
function unit(a: V3, fallback: V3): V3 {
  const l = sqrt(a.x * a.x + a.y * a.y + a.z * a.z)
  if l < 1.0e-9 { fallback } else { ({ x: a.x / l, y: a.y / l, z: a.z / l }) }
}
// Too large to inline: only the multi-value step can take its records apart.
function rotateBy(k: i32, r: Q, parent: Q) {
  for j in 0 until 3 {
    acc += parent.x * r.w + parent.w * r.x + k as f64 + j as f64
  }
  acc += parent.y + parent.z + r.y + r.z
  acc += parent.y * parent.z * r.y * r.z + parent.w
  acc += parent.x * parent.z * r.x * r.z + parent.w
  acc += parent.w * parent.z * r.w * r.z + parent.x
  acc += parent.y * parent.x * r.y * r.x + parent.z
}
function chain(t: f64): f64 {
  acc = 0.0
  for b in 0 until 4 {
    const p = sk.parents[b]
    rotateBy(b, quatOf(t), if p < 0 { sk.root } else { quatOf(t + p as f64) })
    rotateBy(
      b,
      quatOf(t),
      if p < 1 { { x: t, y: 0.0, z: 0.0, w: 1.0 } } else { quatOf(t) },
    )
  }
  acc
}
function split(t: f64): f64 {
  const d0 = unit({ x: t, y: 1.0, z: 0.0 }, UP)
  const d1 = unit({ x: 0.0, y: t, z: 2.0 }, UP)
  const lead = if d0.z < d1.z { d1 } else { d0 }
  const from = if d0.z < d1.z { d0 } else { d1 }
  lead.x + lead.y * 2.0 + from.z * 3.0 + (if t > 1.0 { d0 } else { d1 }).y
}
print(chain(1.0))
print(chain(0.5))
print(split(1.0))
print(split(2.0))
