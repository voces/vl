// `toBeCloseTo`: jest's tolerance, every numeric receiver, and the two that fail.
import { expect, it, not, toBeCloseTo } from "std:test"

const one: i32 = 1
const three: i64 = 3
const half: f32 = 0.5

it("a float sum is close to its decimal", () => {
  expect(0.1 + 0.2).toBeCloseTo(0.3)
})

it("digits tightens the tolerance", () => {
  expect(1.000001).toBeCloseTo(1.0, 5)
})

it("negative digits loosen it", () => {
  expect(140.0).toBeCloseTo(100.0, -2)
})

it("a difference over half a unit is not close", () => {
  expect(1.01).not().toBeCloseTo(1.0)
})

it("equal infinities are close", () => {
  expect(1.0 / 0.0).toBeCloseTo(1.0 / 0.0)
})

it("NaN is close to nothing", () => {
  expect(0.0 / 0.0).not().toBeCloseTo(0.0 / 0.0)
})

it("an integer or f32 receiver converts", () => {
  expect(one).toBeCloseTo(1.004)
  expect(three).toBeCloseTo(3.0)
  expect(half).toBeCloseTo(0.5)
})

it("a huge digits ends", () => {
  expect(1.0).toBeCloseTo(1.0, 2000000000)
  expect(1.0).toBeCloseTo(9.0, -2000000000)
})

it("fails past the tolerance", () => {
  expect(1.001).toBeCloseTo(1.0, 3)
})

it("fails on a string receiver", () => {
  expect("1").toBeCloseTo(1.0)
})
