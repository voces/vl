// @log 6
// @log -1
// @log 7.5
// @log -1
// @log 9
// @log -1
// @log 2.5
// @log -1
// @log 8
// @log 0
// @log 4
// @log -2
// @log 3
// @log -1
// @log 7
// @log -1
// @log true
// @log false
// @log 6
// @log 6
// @log null
// @allocs 26
// sunpa SP-046: a `const` holding a map read, a scalar list's `.get(i)` or a `.pop()`, typed
// `S | null` for a wide scalar `S`, null-tested and read, holds no box: it reads as `??` does.
// Only `escapes` keeps one, built where its value is handed on as `i32 | null`.
const mi: Map<i32, i32> = Map()
const mf: Map<i32, f64> = Map()
const ml: Map<i32, i64> = Map()
const fs: f32[] = [1.5, 2.5]
const xs: i32[] = [7, 8, 9]
const mb: Map<i32, boolean> = Map()

function eqIf(k: i32): i32 {
  const g = mi.get(k)
  if g == null { -1 } else { g }
}
function neIf(k: i32): f64 {
  const g: f64 | null = mf[k]
  if g != null { g } else { -1.0 }
}
function early(k: i32): i64 {
  const g = ml.get(k)
  if g is null { return -1 }
  g + 1
}
function popped(): f32 {
  const g = fs.pop()
  match g {
    null => -1.0
    _ => g
  }
}
function both(k: i32): i32 {
  const g = xs.get(k)
  if g != null && g > 7 { g }
  else if g is i32 { 0 }
  else { -2 }
}
function coal(k: i32): i32 {
  const g = mi[k]
  g ?? -1
}
function flag(k: i32): boolean {
  const g = mb.get(k)
  if g == null { false } else { g }
}
function show(x: i32 | null) {
  if x == null { print("null") } else { print(x) }
}
function escapes(k: i32) {
  const g = mi.get(k)
  if g != null { print(g) }
  show(g)
}

mi[3] = 6
mf[1] = 7.5
ml[2] = 8 as i64
mb[1] = true
print(eqIf(3))
print(eqIf(4))
print(neIf(1))
print(neIf(2))
print(early(2))
print(early(3))
print(popped())
print(fs.length - 2)
print(both(1))
print(both(0))
print(both(2) - 5)
print(both(5))
print(coal(3) - 3)
print(coal(9))
print(xs[0])
print(eqIf(0))
print(flag(1))
print(flag(2))
escapes(3)
escapes(4)
