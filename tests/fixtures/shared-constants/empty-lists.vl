// @log 729
// @log 3
// @log 0
// @log 2.5
// @log ab
// @log 1
// @allocs 16
// sunpa SP-043: `lists` builds 729 empty lists a frame and writes one. An empty literal reads
// its element type's shared zero-length backing, so each costs its list struct alone. The 16
// sites left are the list structs, each push's growth reallocation and the record literal.
type P = { x: i32, ys: f64[] }

let all: i32[][] = []
export function lists(n: i32): i32 {
  all = []
  for _m in 0 until n { all.push([]) }
  all[0].push(n)
  all.length
}

function kinds() {
  const d: f64[] = []
  const s: string[] = []
  const u: u8[] = []
  const r: P[] = []
  d.push(2.5)
  s.push("ab")
  r.push({ x: 1, ys: [] })
  print(d[0])
  print(s[0])
  print(r.length + u.length + r[0].ys.length)
}

print(lists(729))
print(lists(3))
print(all[1].length)
kinds()
