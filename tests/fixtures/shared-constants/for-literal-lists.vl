// @log 840
// @log 33
// @log true
// @log false
// @log a
// @log bc
// @log nm
// @log 8
// @log 6
// @log 5
// @log 6
// @log g
// @log 4
// @log 337
// @log 15
// @allocs 2
// D3805 (sunpa): a list literal of constants that only a `for` iterates is one module constant
// list, read on every entry to the loop. Every element kind, a named constant, a nested loop, a
// `break` and `continue`, a generic function's two instances and module scope; the 2 sites left
// are `nonConst`'s, whose elements are not constants and keep their order of evaluation.
const A = 3
const NAME = "nm"
const HALF = 0.5

function reach(x: f64): f64 {
  let up = 0.0
  for r in [120.0, 280.0, 560.0] { up = max(up, x - r) }
  up
}

function sides(): i32 {
  let s = 0
  for side in [0, 1] {
    for k in [10, -2, A] { s += side * k + k }
  }
  s
}

function kinds() {
  for b in [true, false] { print(b) }
  for w in ["a", "bc", NAME] { print(w) }
}

function brk(): i32 {
  let s = 0
  for v in [1, 2, 3, 4, 5] {
    if v == 2 { continue }
    if v == 5 { break }
    s += v
  }
  s
}

function gen<T>(x: T): T {
  let n = 0
  for v in [1, 2, 3] { n += v }
  print(n)
  x
}

function halfs(): f64 {
  let s = 0.0
  for h in [HALF, 1, 2.5] { s += h }
  s
}

function nonConst(h: i32): i32 {
  let s = 0
  for v in [3, h - 4, h] { s = s * 10 + v }
  s
}

let t = 0.0
for i in 0 until 4 { t += reach(i as f64 * 200.0) }
print(t)
print(sides())
kinds()
print(brk())
print(gen(5))
print(gen("g"))
print(halfs())
print(nonConst(7))
let m = 0
for q in [4, 5, 6] { m += q }
print(m)
