// @log 1
// @log 8
// @log 2163
// @log true
// @log false
// @allocs 0
// A capture-free lambda passed as a value is the module's one constant closure of that
// function (sunpa's `sort(full[m], (a, b) => …)`), so no call below allocates a closure.
function best(xs: i32[], better: (a: i32, b: i32) => boolean): i32 {
  let b = xs[0]
  for x in xs {
    if better(x, b) { b = x }
  }
  b
}
function apply(f: (a: i32, b: i32) => i32, x: i32, y: i32): i32 { f(x, y) }
function mk(): (a: i32) => i32 {
  (a) => a + 1
}

function sum(n: i32): i32 {
  let s = 0
  for i in 0 until n { s += apply((a, b) => a * 10 + b, i, 3) }
  s
}

const xs: i32[] = [5, 3, 8, 1, 2]
print(best(xs, (a, b) => a < b))
print(best(xs, (a, b) => a > b))
print(sum(21))
const o: (a: i32) => i32 = (a) => a + 1
print(mk() == mk())
print(mk() == o)
