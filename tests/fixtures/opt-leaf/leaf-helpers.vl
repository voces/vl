// @log 563
// Leaf helpers in the shape transliterated code reaches registers and memory through
// (plumb PL-027): each is a handful of instructions and has several callers, so binaryen's
// bare `-O` keeps every use a call. `vl build -O` must inline all three (DECISIONS.md,
// "`-O` inlines leaf helpers"); `st8` is five instructions, `rg` six, `sr` seven.
const CTX = 2048

function st8(a: i64, v: i64) { __store_i8__(a as% i32, v as% i32) }
function rg(i: i32): i64 { __load_i64__(CTX + i * 8) }
function sr(i: i32, v: i64) { __store_i64__(CTX + i * 8, v) }

function step(k: i32) {
  const a = rg(0) + (k as% i64)
  const b = rg(1) ^ a
  st8(4096 + (k % 16) as% i64, b)
  st8(4112, a)
  sr(0, a & 1023)
  sr(1, b & 255)
}

let i = 0
while i < 50 {
  step(i)
  i = i + 1
}
print(rg(0) + rg(1) + (__load_u8__(4112) as% i64))
