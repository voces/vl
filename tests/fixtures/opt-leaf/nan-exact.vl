// NaN-exact float helpers in plumb's shape (PL-053): the operation, a self-compare, and a
// call to an out-of-line `nan32`/`nan64` only when the result is NaN. `vl build -O` must inline
// the helpers and keep `nan32`/`nan64` a call, and every result's BITS must be the ones the
// unoptimized module prints: a NaN operand's own payload, quieted, else the fixed indefinite NaN.
const QNAN32: i32 = 0xffc00000 as% i32
const QNAN64: i64 = 0xfff8000000000000 as% i64

function nan32(a: f32, b: f32): f32 {
  if a != a { return f32fromBits(f32bits(a) | 0x400000) }
  if b != b { return f32fromBits(f32bits(b) | 0x400000) }
  f32fromBits(QNAN32)
}
function nan64(a: f64, b: f64): f64 {
  if a != a { return f64fromBits(f64bits(a) | 0x8000000000000) }
  if b != b { return f64fromBits(f64bits(b) | 0x8000000000000) }
  f64fromBits(QNAN64)
}
function fadd32(a: f32, b: f32): f32 {
  const r = a + b
  if r != r { nan32(a, b) } else { r }
}
function fsub32(a: f32, b: f32): f32 {
  const r = a - b
  if r != r { nan32(a, b) } else { r }
}
function fmul32(a: f32, b: f32): f32 {
  const r = a * b
  if r != r { return nan32(a, b) }
  r
}
function fdiv32(a: f32, b: f32): f32 {
  const r = a / b
  if r != r { nan32(a, b) } else { r }
}
function fadd64(a: f64, b: f64): f64 {
  const r = a + b
  if r != r { nan64(a, b) } else { r }
}
function fmul64(a: f64, b: f64): f64 {
  const r = a * b
  if r != r { return nan64(a, b) }
  r
}

// Operand pairs as bits, read at run time so no pass can fold them: a signalling NaN with a
// payload on each side, two NaNs (the first wins), Inf - Inf and 0 * Inf (no NaN operand, so the
// indefinite NaN), a negative quiet NaN, and one ordinary product.
const A32: i32[] = [
  0x7f800001,
  0x3fc00000,
  0x7f812345,
  0x7f800000,
  0,
  0xffc0beef as% i32,
  0x3fc00000,
]
const B32: i32[] = [
  0x3fc00000,
  0xff800abc as% i32,
  0x7fa00000,
  0x7f800000,
  0x7f800000,
  0x40000000,
  0x40000000,
]
const A64: i64[] = [
  0x7ff0000000000001, 0x3ff8000000000000, 0x7ff0000000000000, 0,
]
const B64: i64[] = [
  0x3ff8000000000000,
  0xfff00000000abcde as% i64,
  0x7ff0000000000000,
  0x7ff0000000000000,
]

// The helpers are called from functions, as a translated unit calls them: a callee the
// top-level loop calls directly stays out of run-once code whatever its size.
// Each pair runs in both operand orders, which is also what gives every helper two call sites.
function step32(a: f32, b: f32) {
  print(f32bits(fadd32(a, b)))
  print(f32bits(fsub32(a, b)))
  print(f32bits(fmul32(a, b)))
  print(f32bits(fdiv32(a, b)))
  print(f32bits(fadd32(b, a)))
  print(f32bits(fsub32(b, a)))
  print(f32bits(fmul32(b, a)))
  print(f32bits(fdiv32(b, a)))
}
function step64(a: f64, b: f64) {
  print(f64bits(fadd64(a, b)))
  print(f64bits(fmul64(a, b)))
  print(f64bits(fadd64(b, a)))
  print(f64bits(fmul64(b, a)))
}

let i = 0
while i < A32.length {
  step32(f32fromBits(A32[i]), f32fromBits(B32[i]))
  i = i + 1
}
let j = 0
while j < A64.length {
  step64(f64fromBits(A64[j]), f64fromBits(B64[j]))
  j = j + 1
}
