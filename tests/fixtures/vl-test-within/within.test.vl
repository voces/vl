// `toBeWithin`: an absolute tolerance, every numeric receiver, and the two that fail.
import { expect, it, not, toBeWithin } from "std:test"

const one: i32 = 1
const half: f32 = 0.5

it("a float sum is within a small tolerance", () => {
  expect(0.1 + 0.2).toBeWithin(0.3, 0.000001)
})

it("the bound itself is within", () => {
  expect(1.5).toBeWithin(1.0, 0.5)
})

it("a decimal bound is compared in f64", () => {
  expect(1.1).not().toBeWithin(1.0, 0.1)
})

it("a negative tolerance admits nothing", () => {
  expect(1.0).not().toBeWithin(1.0, -1.0)
})

it("a difference past the tolerance is not within", () => {
  expect(1.02).not().toBeWithin(1.0, 0.01)
})

it("equal infinities are within", () => {
  expect(1.0 / 0.0).toBeWithin(1.0 / 0.0, 0.1)
})

it("NaN is within nothing", () => {
  expect(0.0 / 0.0).not().toBeWithin(0.0 / 0.0, 1.0)
})

it("an integer or f32 receiver converts", () => {
  expect(one).toBeWithin(1.004, 0.01)
  expect(half).toBeWithin(0.5, 0.0)
})

it("fails past the tolerance", () => {
  expect(1.004).toBeWithin(1.0, 0.001)
})

it("fails on a string receiver", () => {
  expect("1").toBeWithin(1.0, 0.5)
})
