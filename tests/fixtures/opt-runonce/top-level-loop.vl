// @log 1200003
// A hot callee reached from a loop in TOP-LEVEL code, which runs once as the start
// function. `-O`/`-O3` must keep `step` its own function: inlined into the start function
// it would stay on V8's baseline tier for the whole run (DECISIONS.md, "`-O3` keeps hot
// callees out of run-once code"). `step` has a loop so it is never the tiny-leaf exemption.
function step(i: i32): i32 {
  let s = 0
  let k = 0
  while k < 4 {
    s = s + (i + k) % 7
    k = k + 1
  }
  return s
}

let acc = 0
let i = 0
while i < 100000 {
  acc = acc + step(i)
  i = i + 1
}
print(acc)
