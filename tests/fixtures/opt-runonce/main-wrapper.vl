// @log 1200003
// The same hot loop inside `main()`, called once from top-level code. `main` runs once
// too, so it is run-once code as well and `step` must stay out of it.
function step(i: i32): i32 {
  let s = 0
  let k = 0
  while k < 4 {
    s = s + (i + k) % 7
    k = k + 1
  }
  return s
}

function main() {
  let acc = 0
  let i = 0
  while i < 100000 {
    acc = acc + step(i)
    i = i + 1
  }
  print(acc)
}

main()
