// @log 7
// `bench/arrays/binsearch`'s kernel at a test-sized N — the second program the
// release profile slows down (1.22x measured). Three loops (fill, query, probe),
// and binaryen rotates all three.
//
// This fixture carries the NESTED case: the probe loop's carried values (`lo`,
// `hi`, `found`) live across a rotated back-edge inside an outer rotated loop, so
// a flag change that alters the rotation of either level moves a pinned number.
function bsearch(a: i32[], n: i32, key: i32): i32 {
  let lo = 0
  let hi = n - 1
  let found = -1
  while lo <= hi {
    const mid = (lo + hi) >> 1
    const v = a[mid]
    if v < key {
      lo = mid + 1
    } else {
      if v > key {
        hi = mid - 1
      } else {
        found = mid
        lo = hi + 1
      }
    }
  }
  return found
}

function run(n: i32): i32 {
  const a: i32[] = []
  let i = 0
  while i < n {
    a.push(i * 3)
    i = i + 1
  }
  let hits = 0
  let q = 0
  while q < n {
    if bsearch(a, n, q * 3) >= 0 { hits = hits + 1 }
    q = q + 1
  }
  return hits
}
print(run(7))
