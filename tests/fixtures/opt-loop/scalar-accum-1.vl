// @log 435
// ONE loop-carried accumulator. This is the CONTROL for the loop-rotation gate:
// binaryen's `-O` rotates this loop exactly like the others, and wasmtime compiles
// the rotated form with no spill and no register shuffle — measured 1.00x, so a
// rotated loop is not harmful by itself. What makes it harmful is how many values
// are carried across the back-edge, which is what `scalar-accum-3` pins.
function tick(n: i32): i32 {
  let si: i32 = 0
  let i: i32 = 0
  while i < n {
    si = si + (i & 1023)
    i = i + 1
  }
  return si
}
print(tick(30))
