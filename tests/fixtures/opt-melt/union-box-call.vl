// @log 50
// Per-tick scratch, union box: a `i64 | boolean` is allocated by a helper and
// consumed by an `is` narrowing INSIDE the loop, never stored anywhere. VL emits
// two allocations per trip — the payload box `{i64}` and the tagged box
// `{tag: i32, value: anyref}` — and both are non-escaping by construction.
// The allocation reaches its use through an expression, not through a local
// written on two paths, which is the shape that melts (`opt-profile-design.md`).
function boxOf(i: i32): i64 | boolean {
  if i % 2 == 0 { return 7 }
  return true
}

function tick(n: i32): i32 {
  let acc = 0
  let i = 0
  while i < n {
    const u = boxOf(i)
    if u is i64 { acc = acc + 1 }
    i = i + 1
  }
  return acc
}
print(tick(100))
