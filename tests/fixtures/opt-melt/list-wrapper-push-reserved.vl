// @log 420
// `list-wrapper-push` with its pushes unconditional: the three pushes are counted, so the
// list is reserved at 3 and they append through locals (D3623). Nothing grows, nothing is
// stored into the wrapper inside the trip, and the scratch list melts at both rungs.
function tick(n: i32): i32 {
  let acc = 0
  let i = 0
  while i < n {
    const xs: i32[] = []
    xs.push(i)
    xs.push(i + 1)
    xs.push(i + 2)
    acc = acc + xs[0] + xs[2]
    i = i + 1
  }
  return acc
}
print(tick(20))
