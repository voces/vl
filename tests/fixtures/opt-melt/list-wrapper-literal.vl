// @log 420
// Per-tick scratch, `{backing, len, cap}` wrapper: a list literal is built and
// read inside the loop. VL lowers `[a, b, c]` to `array.new_fixed` for the
// backing plus `struct.new` for the `{backing, len, cap}` wrapper, so this is
// the wrapper allocation webcraft names, in its cheapest form — both the
// allocation and its uses in one straight-line region.
function tick(n: i32): i32 {
  let acc = 0
  let i = 0
  while i < n {
    const xs = [i, i + 1, i + 2]
    acc = acc + xs[0] + xs[2]
    i = i + 1
  }
  return acc
}
print(tick(20))
