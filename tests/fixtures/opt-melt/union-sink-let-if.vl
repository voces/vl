// @log 350
// `union-box-payload-read`'s program with the producer written as a `const` BINDING whose
// init is an if-EXPRESSION — the third spelling of one program, and the one a sim reaches
// for when the value is used more than once.
//
// The binding's slot is a non-null `(ref $uBox)`, which is not defaultable, and a void-`if`
// merge does not satisfy the definite-assignment check — so this shape used to build a box
// in each arm AND pre-seed a null box before the `if` that every path immediately
// overwrote. Three sites, none of which Heap2Local can own, so the box survived every rung:
// 5/4/4.
//
// The BINDING SINK writes each arm's tag and payload into the sink pair and performs the
// one `struct.new` after the `if`. That single store dominates every read of the binding,
// so the pre-seed is not merely redundant but unnecessary, and the shape drops to ONE site
// — the shape escape analysis can own.
//
// This row and `union-box-payload-read` / `union-sink-if-expression` are the same program
// in three spellings and must read the same counts; a divergence means the sink stopped
// firing for one of them. The two survivors at `-O`/`-O3` are the PAYLOAD allocations (the
// data), not the box (the overhead).
function tick(n: i32): i32 {
  let acc = 0
  let i = 0
  while i < n {
    const u: i64 | boolean = if i % 2 == 0 then 7 else true
    if u is i64 { acc = acc + (u as i32) }
    i = i + 1
  }
  return acc
}
print(tick(100))
