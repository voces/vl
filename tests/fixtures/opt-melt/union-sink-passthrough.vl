// @log 350
// THE INVERTED CONTROL. Both of `pick`'s exits return a union value that ALREADY EXISTS
// — its parameter — so neither constructs a box, and the sink must not manufacture one.
// The peephole is what makes this hold: it rewrites a `return` only when the last
// instruction written is the box's own `struct.new`, and here it never is, so both exits
// stay plain `return`s and the exit block is never emitted.
//
// Without that restraint a per-function sink would wrap `pick` and add a construction
// site to a function that had none, turning an optimization into a regression.
function pick(a: i64 | boolean, b: i64 | boolean, i: i32): i64 | boolean {
  if i % 2 == 0 { return a }
  return b
}

function tick(n: i32): i32 {
  let acc = 0
  let i = 0
  while i < n {
    const u = pick(7, true, i)
    if u is i64 { acc = acc + (u as i32) }
    i = i + 1
  }
  return acc
}
print(tick(100))
