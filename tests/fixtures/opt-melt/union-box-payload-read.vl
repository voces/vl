// @log 350
// THE SHAPE A SIM ACTUALLY WRITES, and the one that does NOT melt.
//
// `union-box-call` is this program with its `is` arm changed to test the tag and
// throw the value away (`acc = acc + 1`), and it melts 4 → 0. Here the narrowed
// value is CONSUMED — the payload is read — and all four allocations survive the
// full release profile. That single difference is the whole boundary.
//
// This is the counterexample to webcraft P1.3's "vl's union boxes must melt in
// per-tick scratch code": they melt when the box is allocated, tag-tested and
// discarded, and not when it is used. Kernel code writes the second one.
//
// The struct-union twin behaves the same way (its tag-only form melts to 2 rather
// than 0, its field-read form to 4); the grid is in `opt-profile-design.md` §3
// item 0. Pinned here so the boundary cannot move silently in either direction —
// if this ever reads below 4, the union rep or the optimizer has improved and the
// requirements note must be re-graded.
function boxOf(i: i32): i64 | boolean {
  if i % 2 == 0 { return 7 }
  return true
}

function tick(n: i32): i32 {
  let acc = 0
  let i = 0
  while i < n {
    const u = boxOf(i)
    if u is i64 { acc = acc + (u as i32) }
    i = i + 1
  }
  return acc
}
print(tick(100))
