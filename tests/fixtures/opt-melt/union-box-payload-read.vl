// @log 350
// THE SHAPE A SIM ACTUALLY WRITES: the narrowed value is CONSUMED — `u as i32` reads
// the payload — which is the case a tag-test-only fixture cannot speak for.
//
// `boxOf` is two-armed, so it once built the union box at TWO allocation sites, one per
// `return`. Heap2Local scalarizes per SITE, so neither could be owned and every
// allocation survived the full release profile. The RETURN SINK gives the function one
// site: both `return`s write the tag and payload into two reserved locals and branch to
// a single exit that performs the only `struct.new`. Three allocations are emitted, and
// the release profile melts the box, leaving the two `$vbI64`/`$vbI32` PAYLOAD
// allocations — the data the loop actually asked for.
//
// So webcraft P1.3's "vl's union boxes must melt in per-tick scratch code" is answered
// YES for the box; what a per-trip union still costs is its payload's value box, which is
// the phase-3 question (a payload-typed box per scalar rep) and not a box question at all.
//
// Pinned so the boundary cannot move silently in either direction. A count that goes UP
// means the sink stopped firing for this shape; one that goes DOWN means the payload
// boxes started melting too, and `unboxed-union-rep-design.md` §4's ladder says which
// candidate did it.
function boxOf(i: i32): i64 | boolean {
  if i % 2 == 0 { return 7 }
  return true
}

function tick(n: i32): i32 {
  let acc = 0
  let i = 0
  while i < n {
    const u = boxOf(i)
    if u is i64 { acc = acc + (u as i32) }
    i = i + 1
  }
  return acc
}
print(tick(100))
