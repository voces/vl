// @log 50
// The SAME union box as `union-box-call.vl`, reached the other way: a mutable
// `let` of union type written on two paths, narrowed after the join. Nothing
// escapes here either — but the ref-typed local now has two definitions, and
// binaryen's Heap2Local scalarizes per allocation site, so neither site can own
// the local. This is the shape that does NOT fully melt; it is here as the
// counter-example that keeps the melt rule honest.
function tick(n: i32): i32 {
  let acc = 0
  let i = 0
  while i < n {
    let u: i64 | boolean = true
    if i % 2 == 0 { u = 7 }
    if u is i64 { acc = acc + 1 }
    i = i + 1
  }
  return acc
}
print(tick(100))
