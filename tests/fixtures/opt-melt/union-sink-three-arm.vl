// @log 250
// THREE arms, still ONE construction site. This is the cell that separates "the sink
// merged the returns" from "a union producer happens to emit one box": at three arms an
// unsunk producer emits three, and any per-arm accounting would read 3 here and 2 in the
// two-arm fixture beside it.
function boxOf(i: i32): i64 | boolean | string {
  if i % 3 == 0 { return 5 }
  if i % 3 == 1 { return true }
  return "x"
}

function tick(n: i32): i32 {
  let acc = 0
  let i = 0
  while i < n {
    const u = boxOf(i)
    if u is i64 { acc = acc + (u as i32) }
    i = i + 1
  }
  return acc
}
print(tick(150))
