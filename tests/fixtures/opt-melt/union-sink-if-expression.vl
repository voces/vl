// @log 350
// `union-box-payload-read`'s producer written as ONE `return` of an if-EXPRESSION — the
// spelling `unboxed-union-rep-design.md` §2.1 measured as unreachable by the return sink
// and §10.4 filed as "the single largest remaining return-position shape".
//
// The value-typed `if` that lowers a union-valued if-expression has a `(ref $uBox)`
// blocktype, so it built a box in EACH ARM and the merge at its `end` is precisely what
// stops Heap2Local owning either. Lowered instead as a VOID statement-`if` whose arms
// each terminate as their own return — the identical program, and what
// `if c { return a } else { return b }` already emitted — every arm's box meets the
// sink's peephole and the function is left with the exit block's ONE construction.
//
// This fixture and `union-box-payload-read` are the SAME program in two spellings and
// must read the same counts; a divergence between them means the split stopped firing
// for the if-expression form while the two-`return` form kept working.
function boxOf(i: i32): i64 | boolean {
  return if i % 2 == 0 { 7 } else { true }
}

function tick(n: i32): i32 {
  let acc = 0
  let i = 0
  while i < n {
    const u = boxOf(i)
    if u is i64 { acc = acc + (u as i32) }
    i = i + 1
  }
  return acc
}
print(tick(100))
