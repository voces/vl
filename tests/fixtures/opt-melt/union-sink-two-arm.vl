// @log 350
// The RETURN SINK's positive cell: a two-armed union producer builds its box at ONE
// allocation site. Each `return` writes the tag and the payload into two reserved locals
// and branches to a single exit block, which performs the only `struct.new $uBox`.
//
// Structurally pinned (`vl_union_return_sink_test.ts`) because the behavioural oracle is
// BLIND to the sink: 350 is 350 whether the box is built once or once per arm.
function boxOf(i: i32): i64 | boolean {
  if i % 2 == 0 { return 7 }
  return true
}

function tick(n: i32): i32 {
  let acc = 0
  let i = 0
  while i < n {
    const u = boxOf(i)
    if u is i64 { acc = acc + (u as i32) }
    i = i + 1
  }
  return acc
}
print(tick(100))
