// @log 420
// The `{backing, len, cap}` wrapper across a CALL boundary: the scratch list is
// built by a helper and consumed by the caller's loop. Binaryen must inline the
// helper before its escape analysis can see that nothing outlives the trip, so
// this fixture separates "the wrapper melts" from "the wrapper melts only when
// the allocation is already in the consuming function".
function tripleOf(i: i32): i32[] { return [i, i + 1, i + 2] }

function tick(n: i32): i32 {
  let acc = 0
  let i = 0
  while i < n {
    const xs = tripleOf(i)
    acc = acc + xs[0] + xs[2]
    i = i + 1
  }
  return acc
}
print(tick(20))
