// @log 420
// The GROWN `{backing, len, cap}` wrapper: a fresh scratch list is built by
// `.push` each trip. Growth reallocates the backing and writes it back into the
// wrapper's field, so the backing array is stored into a heap object — the
// textbook escape. Kept as the honest worst case for per-tick scratch: the pushes sit under an
// `if`, so the list is not reserved at its count (D3623; `list-wrapper-push-reserved` is that).
function tick(n: i32): i32 {
  let acc = 0
  let i = 0
  while i < n {
    const xs: i32[] = []
    if i >= 0 {
      xs.push(i)
      xs.push(i + 1)
      xs.push(i + 2)
    }
    acc = acc + xs[0] + xs[2]
    i = i + 1
  }
  return acc
}
print(tick(20))
