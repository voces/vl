// @log 5050
// Per-tick scratch, plain struct: the vector-math shape a sim tick is made of —
// a small record built by a helper, read once, discarded. `struct.new` per trip
// with no store anywhere. This is Heap2Local's canonical target, so it is the
// CONTROL for the two harder shapes: if this one does not melt at a profile,
// that profile melts nothing.
type V2 = { x: i32, y: i32 }

function addV(a: V2, b: V2): V2 { return { x: a.x + b.x, y: a.y + b.y } }

function tick(n: i32): i32 {
  let acc = 0
  let i = 0
  while i < n {
    const p = addV({ x: i, y: 0 }, { x: 0, y: i })
    acc = acc + p.x
    i = i + 1
  }
  return acc
}
print(tick(101))
