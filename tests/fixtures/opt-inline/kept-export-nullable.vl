// @log 6 9 4
// Disqualifier: an export's signature names the record, `V3 | null`, so JS may hold a `V3`.
type V3 = { x: f64, y: f64, z: f64 }
type H = { a: V3, n: f64 }

function mk(k: f64): V3 { ({ x: k, y: k * 2.0, z: k * 3.0 }) }
const h: H = { a: mk(1.0), n: 0.0 }
export function origin(i: i32): V3 | null {
  if i > 0 { h.a } else { null }
}
for i in 0 until 4 { h.a = mk(i as f64) }
const o = origin(1)
print("\{h.a.y} \{h.a.z} \{if o != null { o.x + 1.0 } else { 0.0 }}")
