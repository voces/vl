// @log 4 4 4 4 4
// The record reaches an export through a union box, a list and a parent. `H` is named by a
// signature and keeps its layout. `G.b` and `K.c` are read whole, so they are inlined only
// with `$VL_INLINE_REBOX`, and never under `--stable-layout`.
type V3 = { x: f64, y: f64, z: f64 }
type H = { a: V3, n: f64 }
type G = { b: V3, n: f64 }
type K = { c: V3, n: f64 }

const h: H = { a: { x: 1.0, y: 2.0, z: 3.0 }, n: 0.0 }
function mkG(): G { ({ b: { x: 4.0, y: 5.0, z: 6.0 }, n: 0.0 }) }
function mkK(): K { ({ c: { x: 7.0, y: 8.0, z: 9.0 }, n: 0.0 }) }
const g = mkG()
const k = mkK()
export function either(i: i32): V3 | i32 {
  if i > 0 { g.b } else { i }
}
export function all(): V3[] { [k.c] }
export function parent(): H { h }
for i in 0 until 5 {
  h.a = { x: i as f64, y: 0.0, z: 0.0 }
  g.b = { x: 0.0, y: i as f64, z: 0.0 }
  k.c = { x: 0.0, y: 0.0, z: i as f64 }
}
print("\{h.a.x} \{g.b.y} \{k.c.z} \{parent().a.x} \{all()[0].z}")
