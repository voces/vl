// @log init a pos=1,2,3 rot=0.4,0.8 len=1
// @log literal a pos=1,2,3 rot=0.4,0.8 len=1
// @log call a pos=7,14,21 rot=0.4,0.8 len=1
// @log param a pos=0.5,1,1.5 rot=0.4,0.8 len=1
// @log cond-t a pos=4,8,12 rot=0.4,0.8 len=1
// @log cond-f a pos=5,10,15 rot=0.4,0.8 len=1
// @log spread a pos=100,10,15 rot=0.4,0.8 len=1
// @log rot a pos=100,10,15 rot=0.6882472016116852,0 len=1
// @log local a pos=6,12,18 rot=0.6882472016116852,0 len=1
// @log let-2 a pos=2,4,6 rot=0.6882472016116852,0 len=1
// @log let-4 a pos=8,16,24 rot=0.6882472016116852,0 len=1
// @log copy 8 16 24 now 9 rot-copy 0.6882472016116852 now 0.23570226039551587
// @log sum 54 qsum 1.4142135623730951 ret 54 1.4142135623730951
// @log same true true true false
// @log from-other 9 same true
// @log after 9 11
// @log other-fields a2 pos=11,22,33 rot=0.23570226039551587,0 len=11
// @log rig-root r pos=1.5,3,4.5 rot=0,0.8 len=1.5
// @log rig-tip t pos=8,16,24 rot=0.7372097807744856,0.5897678246195885 len=2.5
// @log rig-alias t pos=1.25,2.5,3.75 rot=0.7372097807744856,0.5897678246195885 len=2.5
// @log list 2498.0451797924597
// @log list j0 pos=48,96,144 rot=0.9995476136389166,0.021266970502955673 len=0
// @log list j1 pos=49,98,147 rot=0.9995662545881396,0.020824296970586242 len=1
// @log list j2 pos=46,92,138 rot=0.9995837668914375,0.020399668712070152 len=2
// @log list j3 pos=47,94,141 rot=0.999527744955953,0.02172886402078159 len=3
// @log map mx pos=12,24,36 rot=0.7947194142390263,0.5298129428260175 len=3
// @log map-y my pos=4,8,12 rot=0.2,0.8 len=4
// @log map-x-again mx pos=12,24,36 rot=0.7947194142390263,0.5298129428260175 len=3
// @log self a2 pos=11,22,33 rot=0.23570226039551587,0 len=11
// @log alias-store t pos=1.25,2.5,3.75 rot=0.7372097807744856,0.5897678246195885 len=2.5
// @log alias-twin t pos=2,4,6 rot=0.7372097807744856,0.5897678246195885 len=2.5
// Parent kinds x store positions x read positions, with copy-vs-alias proof rows.
type V3 = { x: f64, y: f64, z: f64 }
type Q = { x: f64, y: f64, z: f64, w: f64 }
type Joint = { name: string, rot: Q, pos: V3, len: f64 }
type Rig = { root: Joint, tip: Joint, n: i32 }

function mk(k: f64): V3 { ({ x: k, y: k * 2.0, z: k * 3.0 }) }
function qnorm(q: Q): Q {
  const l = sqrt(q.x * q.x + q.y * q.y + q.z * q.z + q.w * q.w)
  ({ x: q.x / l, y: q.y / l, z: q.z / l, w: q.w / l })
}
function sum(v: V3): f64 { v.x + v.y + v.z }
function qsum(q: Q): f64 { q.x + q.y + q.z + q.w }
function same(a: V3, b: V3): boolean { a == b }
function posOf(j: Joint): V3 { j.pos }
function rotOf(j: Joint): Q { j.rot }
function joint(name: string, k: f64): Joint {
  ({
    name: name,
    rot: qnorm({ x: k, y: 1.0, z: 0.5, w: 2.0 }),
    pos: mk(k),
    len: k,
  })
}

// Store positions.
function storeLiteral(j: Joint) { j.pos = { x: 1.0, y: 2.0, z: 3.0 } }
function storeCall(j: Joint, k: f64) { j.pos = mk(k) }
function storeParam(j: Joint, v: V3) { j.pos = v }
function storeCond(j: Joint, c: boolean) {
  j.pos = if c { mk(4.0) } else { mk(5.0) }
}
function storeFromOther(j: Joint, o: Joint) { j.pos = o.pos }
function storeSpread(j: Joint) { j.pos = { x: 100.0, y: j.pos.y, z: j.pos.z } }
function storeRot(j: Joint, k: f64) {
  j.rot = qnorm({ x: k, y: k, z: 1.0, w: 0.0 })
}
function storeLocal(j: Joint, k: f64) {
  const v = mk(k)
  j.pos = v
}
function storeLet(j: Joint, k: f64) {
  let v = mk(k)
  if k > 3.0 { v = mk(k * 2.0) }
  j.pos = v
}

function show(tag: string, j: Joint) {
  print(
    "\{tag} \{j.name} pos=\{j.pos.x},\{j.pos.y},\{j.pos.z} rot=\{j.rot.x},\{j.rot.w} len=\{j.len}",
  )
}

// A plain record parent.
const a = joint("a", 1.0)
show("init", a)
storeLiteral(a)
show("literal", a)
storeCall(a, 7.0)
show("call", a)
storeParam(a, mk(0.5))
show("param", a)
storeCond(a, true)
show("cond-t", a)
storeCond(a, false)
show("cond-f", a)
storeSpread(a)
show("spread", a)
storeRot(a, 3.0)
show("rot", a)
storeLocal(a, 6.0)
show("local", a)
storeLet(a, 2.0)
show("let-2", a)
storeLet(a, 4.0)
show("let-4", a)

// A read is a copy taken at the read: a later store does not reach it.
const before = a.pos
const rbefore = a.rot
storeCall(a, 9.0)
storeRot(a, 0.25)
print(
  "copy \{before.x} \{before.y} \{before.z} now \{a.pos.x} rot-copy \{rbefore.x} now \{a.rot.x}",
)
// Whole-value reads: passed, returned, compared.
print(
  "sum \{sum(a.pos)} qsum \{qsum(a.rot)} ret \{sum(posOf(a))} \{qsum(rotOf(a))}",
)
const b = joint("b", 9.0)
print(
  "same \{same(a.pos, b.pos)} \{a.pos == b.pos} \{a.pos == a.pos} \{a.rot == b.rot}",
)
storeFromOther(b, a)
print("from-other \{b.pos.x} same \{same(a.pos, b.pos)}")
storeCall(a, 11.0)
print("after \{b.pos.x} \{a.pos.x}")
// The parent's other fields stay put.
a.len = a.len + 10.0
a.name = "a2"
show("other-fields", a)

// A nested record parent.
const rig: Rig = { root: joint("r", 1.5), tip: joint("t", 2.5), n: 2 }
rig.tip.pos = mk(8.0)
rig.root.rot = qnorm({ x: 0.0, y: 0.0, z: 3.0, w: 4.0 })
show("rig-root", rig.root)
show("rig-tip", rig.tip)
rig.root = rig.tip
rig.tip.pos = mk(1.25)
show("rig-alias", rig.root)

// In a list.
const js: Joint[] = []
for i in 0 until 4 { js.push(joint("j\{i}", i as f64)) }
let s = 0.0
for i in 0 until 50 {
  js[i % 4].pos = mk(i as f64)
  js[(i + 1) % 4].rot = qnorm({ x: i as f64, y: 1.0, z: 0.0, w: 1.0 })
  s = s + js[i % 4].pos.y + js[(i + 1) % 4].rot.x
}
print("list \{s}")
for j in js { show("list", j) }

// A map value.
const m = Map<string, Joint>()
m.set("x", joint("mx", 3.0))
m.set("y", joint("my", 4.0))
const mx = m.get("x")
if mx != null {
  mx.pos = mk(12.0)
  show("map", mx)
}
const my = m.get("y") ?? joint("none", 0.0)
my.rot = qnorm({ x: 1.0, y: 2.0, z: 2.0, w: 4.0 })
show("map-y", my)
show("map-x-again", m.get("x") ?? joint("none", 0.0))

// A store whose source may alias its destination reads every source field first.
storeFromOther(a, a)
show("self", a)
rig.tip.pos = rig.root.pos
rig.root.rot = rig.tip.rot
show("alias-store", rig.tip)
const twin = rig.root
twin.pos = mk(2.0)
rig.root.pos = twin.pos
show("alias-twin", rig.tip)
