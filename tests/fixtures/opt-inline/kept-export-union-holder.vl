// @log 2 4
// Disqualifier: the only export hands JS a record holding a parent through a union box,
// `W | i32`.
type V = { x: f64, y: f64 }
type P = { a: V, n: i32 }
type W = { p: P, k: i32 }

function mk(k: f64): V { ({ x: k, y: k * 2.0 }) }
function mkP(k: f64): P { ({ a: mk(k), n: 0 }) }
const p = mkP(1.0)
const w: W = { p: p, k: 1 }
export function g(i: i32): W | i32 {
  if i > 0 { w } else { i }
}
for i in 0 until 3 { p.a = mk(i as f64) }
print("\{p.a.x} \{w.p.a.y}")
