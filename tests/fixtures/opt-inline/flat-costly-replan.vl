// @log 5646
// A whole element held in a local set once and stored back only through the emitter's scratch
// local: free only if the multi-value step takes that local apart, and here no function takes
// or returns the record, so the step never runs. The flattening asks the step, re-plans with the
// read counted whole, and the list stays boxed by default (D3736).
type V3 = { x: f64, y: f64, z: f64 }

function rotate(p: V3[], k: i32): f64 {
  const cur = p[k % p.length]
  p[(k * 5 + 3) % p.length] = cur
  cur.x
}

const p: V3[] = []
for i in 0 until 16 { p.push({ x: i as f64, y: 1.0, z: 2.0 }) }
let s = 0.0
for k in 0 until 1000 { s += rotate(p, k) }
print(s)
