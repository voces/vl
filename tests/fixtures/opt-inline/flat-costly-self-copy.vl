// @log 1191
// A held element copied onto itself (`h = h`): the multi-value step does not take such a local
// apart, so the read would rebuild a record each time. The list stays boxed by default (D3736).
type V3 = { x: f64, y: f64, z: f64 }

function add(a: V3, b: V3): V3 {
  ({ x: a.x + b.x, y: a.y + b.y, z: a.z + b.z })
}

function work(p: V3[]): f64 {
  let s = 0.0
  for r in 0 until 300 {
    let h = p[r % p.length]
    if r % 3 == 0 { h = h } else { h = add(h, p[0]) }
    p[r % p.length] = h
    s += h.x
  }
  s
}

const p: V3[] = []
for i in 0 until 9 { p.push({ x: i as f64, y: 1.0, z: 2.0 }) }
print(work(p))
