// @log 20 12
// Disqualifier: the only export hands JS the record itself through a union box, `V3 | i32`.
// Every read of the field here is a field read, so only the boundary rule keeps it boxed.
type V3 = { x: f64, y: f64, z: f64 }
type H = { a: V3, n: f64 }

function mk(k: f64): V3 { ({ x: k, y: k * 2.0, z: k * 3.0 }) }
function mkH(k: f64): H { ({ a: mk(k), n: 0.0 }) }
const h = mkH(1.0)
const spare = mk(9.0)
export function either(i: i32): V3 | i32 {
  if i > 0 { spare } else { i }
}
let s = 0.0
for i in 0 until 5 {
  h.a = mk(i as f64)
  s = s + h.a.y
}
print("\{s} \{h.a.z}")
