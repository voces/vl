// @log 4 4
// Disqualifier: the record crosses an entry-module export.
type V3 = { x: f64, y: f64, z: f64 }
type H = { a: V3, n: f64 }

const h: H = { a: { x: 1.0, y: 2.0, z: 3.0 }, n: 0.0 }
export function current(): V3 { h.a }
export function store(k: f64) { h.a = { x: k, y: k, z: k } }
store(4.0)
print("\{current().x} \{h.a.y}")
