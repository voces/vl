// @log 2 4
// Disqualifier: the only export hands JS a map of parents through a union box,
// `Map<string, P> | i32`.
type V = { x: f64, y: f64 }
type P = { a: V, n: i32 }

function mk(k: f64): V { ({ x: k, y: k * 2.0 }) }
function mkP(k: f64): P { ({ a: mk(k), n: 0 }) }
const p = mkP(1.0)
const mp = Map<string, P>()
mp.set("a", p)
export function g(i: i32): Map<string, P> | i32 {
  if i > 0 { mp } else { i }
}
for i in 0 until 3 { p.a = mk(i as f64) }
print("\{p.a.x} \{(mp.get("a") ?? p).a.y}")
