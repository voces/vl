// @log 252411
// A whole element held in a local that is copied and stored back, in a module where no
// function takes or returns the record: the multi-value step never runs, so nothing takes the
// local apart and every read would rebuild a record. The list stays boxed by default (D3736).
type V3 = { x: f64, y: f64, z: f64 }

function work(p: V3[], rounds: i32): f64 {
  const n = p.length
  let cur = p[0]
  let s = 0.0
  for r in 0 until rounds {
    for i in 0 until n {
      cur = p[(i * 7 + r) % n]
      s += cur.x
    }
    p[r % n] = cur
  }
  s
}

const p: V3[] = []
for i in 0 until 64 {
  p.push({ x: ((i * 37) % 100) as f64, y: i as f64, z: 0.5 })
}
print(work(p, 80))
