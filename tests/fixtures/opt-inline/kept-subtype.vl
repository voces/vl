// @log 135 2 20
// Disqualifier: the field's record type has a width subtype, so a slot can hold either.
type A3 = { a: f64, b: f64, c: f64 }
type A4 = { a: f64, b: f64, c: f64, d: f64 }
type H = { v: A3, n: f64 }

function mk3(k: f64): A3 { ({ a: k, b: k, c: k }) }
function mk4(k: f64): A4 { ({ a: k, b: k, c: k, d: k * 10.0 }) }
function total(v: A3): f64 { v.a + v.b + v.c }
const h: H = { v: mk3(1.0), n: 0.0 }
let s = 0.0
for i in 0 until 10 {
  h.v = if i % 2 == 0 { mk3(i as f64) } else { mk4(i as f64) }
  s = s + total(h.v)
}
const four = mk4(2.0)
h.v = four
print("\{s} \{h.v.a} \{four.d}")
