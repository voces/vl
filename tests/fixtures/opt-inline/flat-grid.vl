// A list of never-written records, through every list op the -O step rewrites (D3681). Each
// line proves a value: a read is a copy taken at the read, stores land at every position.
import { concat, extend, filled, mapIndexed, reverse } from "std:array"

type V3 = { x: f64, y: f64, z: f64 }
type V2 = { u: f64, w: f64 }
type P = { a: i32, b: i32 }
type One = { v: f64 }
type Eight = { a: f64, b: f64, c: f64, d: f64, e: f64, f: f64, g: f64, h: f64 }
type Holder = { pts: V2[], n: i32 }

function mk(k: f64): V3 { ({ x: k, y: k * 2.0, z: k * 3.0 }) }
function mk2(k: f64): V2 { ({ u: k, w: k + 0.25 }) }
function sumv(v: V3): f64 { v.x + v.y * 10.0 + v.z * 100.0 }
function last<T>(xs: T[]): T { xs[xs.length - 1] }

let xs: V3[] = []
for i in 0 until 6 { xs.push(mk(i as f64)) }
// @log 0
// @log 40
const v0 = xs[0]
xs[0] = mk(40.0)
print(v0.x)
print(xs[0].x)
// @log 10
// @log 15
xs[1] = xs[5]
xs[5] = mk(7.5)
print(xs[1].y)
print(xs[5].y)
// @log 30.75
let acc = 0.0
for i in 0 until xs.length {
  const e = xs[i]
  acc += e.x - e.y + e.z * 0.5
}
print(acc)
// @log 642
// @log 22.5
print(sumv(xs[2]))
print(last(xs).z)
// @log 22.5
// @log 3
// @log true
// @log 5
const p = xs.pop()
if p != null { print(p.z) }
const g = xs.get(3)
if g != null { print(g.x) }
print(xs.get(99) == null)
print(xs.length)
// @log 2.5
// @log 165.5
xs.push({ x: 1.5, y: 2.5, z: 3.5 })
print(xs[xs.length - 1].y)
let it = 0.0
for v in xs { it += v.z }
print(it)
// @log 7
// @log 100
// @log 0
const ys = xs
ys.push(mk(100.0))
print(xs.length)
print(xs[xs.length - 1].x)
xs.clear()
print(ys.length)

// Nested lists, a list in a record, maps, a captured list.
// @log 99.25
// @log 23
// @log 225
let grid: V2[][] = []
for r in 0 until 3 {
  let row: V2[] = []
  for c in 0 until 4 { row.push(mk2((r * 10 + c) as f64)) }
  grid.push(row)
}
grid[1][2] = mk2(99.0)
print(grid[1][2].w)
print(grid[2][3].u)
let gs = 0.0
for row in grid {
  for q in row { gs += q.u }
}
print(gs)
// @log 4
// @log 5
const h: Holder = { pts: [], n: 0 }
for i in 0 until 5 { h.pts.push(mk2(i as f64)); h.n += 1 }
h.pts[0] = h.pts[4]
print(h.pts[0].u)
print(h.pts.length)
// @log 3.25
// @log 5.25
const m: {[string]: V2[]} = Map()
m["a"] = [mk2(1.0), mk2(2.0)]
const ma = m["a"]
if ma != null { ma.push(mk2(3.0)); print(ma[2].w) }
const mv: {[string]: V2} = Map()
mv["k"] = mk2(5.0)
mv["j"] = mk2(6.0)
const mk1 = mv["k"]
if mk1 != null { print(mk1.w) }
// @log 3.5
let cap: V2[] = []
const add = (k: f64) => {
  cap.push(mk2(k))
}
add(1.0)
add(2.0)
const sumc = () => {
  let s = 0.0
  for q in cap { s += q.w }
  s
}
print(sumc())

// The std builders: `filled` is an array.new, `concat` and the rest copy element by element.
// @log 9.5
// @log 9
// @log 1
// @log 4
// @log 13
// @log 8.25
// @log 16
// @log 4
// @log 0.75
// @log 8
const f = filled(4, mk2(0.5))
f[2] = mk2(8.0)
print(f[0].w + f[2].w + f[3].u)
const cc = concat(f, h.pts)
print(cc.length)
print(cc[5].u)
const rv = reverse(cc)
print(rv[0].u)
extend(rv, f)
print(rv.length)
print(rv[rv.length - 2].w)
const mi = mapIndexed(f, (q: V2, i: i32) => q.u * i as f64)
print(mi[2])
const sl = cc.slice(2, 6)
print(sl.length)
print(sl[1].w)
const lit: V2[] = [mk2(1.0), { u: 7.0, w: 8.0 }, mk2(3.0)]
print(lit[1].w)

// Other element shapes: i32 fields, one field, eight fields.
// @log 2099
// @log 4
// @log 8
// @log 3
const ps: P[] = []
for i in 0 until 5 { ps.push({ a: i, b: i * i }) }
ps[1] = { a: -7, b: 70 }
let pa = 0
for q in ps { pa += q.a * 1000 + q.b }
print(pa)
const os: One[] = []
for i in 0 until 3 { os.push({ v: i as f64 + 0.5 }) }
os[0] = os[2]
print(os[0].v + os[1].v)
const es: Eight[] = []
for i in 0 until 3 {
  const k = i as f64
  es.push(
    {
      a: k,
      b: k + 1.0,
      c: k + 2.0,
      d: k + 3.0,
      e: k + 4.0,
      f: k + 5.0,
      g: k + 6.0,
      h: k + 7.0,
    },
  )
}
print(es[2].h - es[1].a)
print(es.length)
