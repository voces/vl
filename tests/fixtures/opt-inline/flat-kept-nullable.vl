// @log 0
// @log 6
// @log 2
// Disqualifier for a flattened list: its elements may be null, which has no flat form.
type V2 = { u: f64, w: f64 }

function mk(k: f64): V2 { ({ u: k, w: k * 3.0 }) }
const ns: (V2 | null)[] = []
for i in 0 until 4 { ns.push(if i % 2 == 0 { mk(i as f64) } else { null }) }
let nn = 0
for e in ns {
  if e == null { nn += 1 } else { print(e.w) }
}
print(nn)
