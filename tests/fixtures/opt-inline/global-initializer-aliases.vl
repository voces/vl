// @log 0.75
// @log 3.75
// @log 4 6.5 9.25
// @log 6.5 10.75 15.375
// @log 0.5 1.5 1.5 3.125
// Proof rows for a parent a global's initializer builds: the old record in a replaced field
// stays observable through a binding, a list, a closure and another record, and each sees
// the value from before the write.
type V3 = { x: f64, y: f64, z: f64 }
type Body = { pos: V3, vel: V3 }
function vadd(a: V3, b: V3): V3 {
  return { x: a.x + b.x, y: a.y + b.y, z: a.z + b.z }
}
const body: Body = {
  pos: { x: 1.0, y: 2.0, z: 3.0 },
  vel: { x: 0.5, y: 0.25, z: 0.125 },
}
const other: Body = {
  pos: { x: 0.0, y: 0.0, z: 0.0 },
  vel: { x: 0.0, y: 0.0, z: 0.0 },
}
const kept: V3[] = []
function step(): f64 {
  const old = body.vel
  kept.push(body.vel)
  other.vel = body.vel
  const f = () => old.x + old.y
  body.vel = vadd(body.vel, body.pos)
  body.pos = vadd(body.pos, body.vel)
  return f()
}
print(step())
print(step())
print("\{body.vel.x} \{body.vel.y} \{body.vel.z}")
print("\{body.pos.x} \{body.pos.y} \{body.pos.z}")
print("\{kept[0].x} \{kept[1].x} \{other.vel.x} \{other.vel.z}")
