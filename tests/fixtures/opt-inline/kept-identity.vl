// @log 27 true
// Disqualifier: a value of the record is observable by identity. A closure's `==` compares
// its environment with `ref.eq`, and the environment holds the record, so its fields stay boxed.
type V3 = { x: f64, y: f64, z: f64 }
type H = { a: V3, n: f64 }

function mk(k: f64): V3 { ({ x: k, y: k * 2.0, z: k * 3.0 }) }
const h: H = { a: mk(1.0), n: 0.0 }
for i in 0 until 10 { h.a = mk(i as f64) }
const keep = h.a
const f = () => keep.x + h.a.y
const g = f
print("\{f()} \{f == g}")
