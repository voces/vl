// @log -9.800000000000002
// @log -5.3900000000000015
// @log -9.8
// @allocs 1
// Aeomach's AE-004: a record built by a global's initializer has its record fields replaced
// every step. At -O/-O3 the initializer stores their fields in the parent and the step
// allocates nothing: the one struct.new left is `g`, built at start-up.
type V3 = { x: f64, y: f64, z: f64 }
type Body = { pos: V3, vel: V3 }
function vadd(a: V3, b: V3): V3 { return { x: a.x + b.x, y: a.y + b.y, z: a.z + b.z } }
function vscale(a: V3, s: f64): V3 { return { x: a.x * s, y: a.y * s, z: a.z * s } }
const body: Body = { pos: { x: 0.0, y: 0.0, z: 0.0 }, vel: { x: 0.0, y: 0.0, z: 0.0 } }
const g: V3 = { x: 0.0, y: -9.8, z: 0.0 }
export function step(dt: f64) {
  body.vel = vadd(body.vel, vscale(g, dt))
  body.pos = vadd(body.pos, vscale(body.vel, dt))
}
for i in 0 until 10 { step(0.1) }
print(body.vel.y)
print(body.pos.y + body.pos.x)
print(g.y)
