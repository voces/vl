// @log 26
// @log 9
// The only export hands JS the list itself, `V2[]`: JS holds the list but cannot read its
// elements, so the list is flattened by default and kept under `--stable-layout`.
type V2 = { u: f64, w: f64 }

function mk(k: f64): V2 { ({ u: k, w: k * 2.0 }) }
const pts: V2[] = []
for i in 0 until 4 { pts.push(mk(i as f64)) }
export function grab(): V2[] { pts }
pts[2] = mk(9.0)
let s = 0.0
for p in pts { s += p.w }
print(s)
print(pts[2].u)
