// @log 454.76301647470007
// @log 0.854743783410637
// @log 8
// @allocs 0
// sunpa's pose blending (D3681): every frame stores each bone's rotation into a `Q[]`, reads
// last frame's back as arguments, and rebuilds a second list by pushing. At -O/-O3 both lists
// hold their elements' fields side by side, so the frame allocates no `Q`.
type Q = { x: f64, y: f64, z: f64, w: f64 }
type State = { lastQ: Q[], offQ: Q[] }

function qn(x: f64, y: f64, z: f64, w: f64): Q {
  const l = sqrt(x * x + y * y + z * z + w * w)
  ({ x: x / l, y: y / l, z: z / l, w: w / l })
}
function rot(b: i32, t: f64): Q { qn(b as f64 + t, 1.0, t, 2.0) }
function qmul(a: Q, b: Q): Q {
  ({
    x: a.w * b.x + a.x * b.w + a.y * b.z - a.z * b.y,
    y: a.w * b.y - a.x * b.z + a.y * b.w + a.z * b.x,
    z: a.w * b.z + a.x * b.y - a.y * b.x + a.z * b.w,
    w: a.w * b.w - a.x * b.x - a.y * b.y - a.z * b.z,
  })
}
function dot(a: Q, b: Q): f64 { a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w }

const st: State = { lastQ: [], offQ: [] }
for b in 0 until 8 { st.lastQ.push({ x: 0.0, y: 0.0, z: 0.0, w: 1.0 }) }

// One frame: last frame's rotations are read, then replaced.
function frame(t: f64): f64 {
  let s = 0.0
  st.offQ.clear()
  for b in 0 until st.lastQ.length {
    s += dot(st.lastQ[b], rot(b, t))
    st.offQ.push(qmul(st.lastQ[b], rot(b, t)))
  }
  for b in 0 until st.lastQ.length { st.lastQ[b] = rot(b, t) }
  for q in st.offQ { s += q.w }
  s
}

let total = 0.0
for f in 0 until 100 { total += frame(f as f64 * 0.01) }
print(total)
print(st.lastQ[3].w * 2.0)
print(st.offQ.length)
