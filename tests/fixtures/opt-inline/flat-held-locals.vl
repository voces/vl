// @log 2899.5080958915155
// @log 1.75
// @log 5
// @allocs 0
// sunpa's FABRIK solver (D3736): a whole element held in a local that is only passed to
// field parameters, stored back, or copied into the store's own scratch (`p[0] = base`), and a
// `let` element read later reassigned from a producer. At -O/-O3 the list holds its elements'
// fields and none of those reads allocates.
type V3 = { x: f64, y: f64, z: f64 }

function v3(x: f64, y: f64, z: f64): V3 { ({ x, y, z }) }
function add(a: V3, b: V3): V3 {
  ({ x: a.x + b.x, y: a.y + b.y, z: a.z + b.z })
}
function sub(a: V3, b: V3): V3 {
  ({ x: a.x - b.x, y: a.y - b.y, z: a.z - b.z })
}
function scale(a: V3, k: f64): V3 { ({ x: a.x * k, y: a.y * k, z: a.z * k }) }
function length(a: V3): f64 { sqrt(a.x * a.x + a.y * a.y + a.z * a.z) }
function unit(a: V3, fallback: V3): V3 {
  const l = length(a)
  if l < 1.0e-12 { return fallback }
  scale(a, 1.0 / l)
}
function mix3(a: V3, b: V3, t: f64): V3 { add(a, scale(sub(b, a), t)) }

function fabrik(n: i32, target: V3, iterations: i32): f64 {
  let p: V3[] = []
  for i in 0 until n { p.push(v3(i as f64, (i * i) as f64 * 0.5, 1.0)) }
  let lengths: f64[] = []
  for i in 0 until n - 1 { lengths.push(length(sub(p[i + 1], p[i]))) }
  const base = p[0]
  const goal = mix3(p[n - 1], target, 0.75)
  for _it in 0 until iterations {
    p[n - 1] = goal
    let i = n - 2
    while i >= 0 {
      p[i] = add(
        p[i + 1],
        scale(
          unit(sub(p[i], p[i + 1]), { x: 0.0, y: 1.0, z: 0.0 }),
          lengths[i],
        ),
      )
      i -= 1
    }
    p[0] = base
    for j in 0 until n - 1 {
      p[j + 1] = add(
        p[j],
        scale(
          unit(sub(p[j + 1], p[j]), { x: 0.0, y: 1.0, z: 0.0 }),
          lengths[j],
        ),
      )
    }
    if length(sub(p[n - 1], goal)) < 1.0e-6 { break }
  }
  let s = 0.0
  for q in p { s += q.x + q.y * 2.0 + q.z * 3.0 }
  s
}

// sunpa's hand targets: a `let` read reassigned from a producer, and a `const` read passed
// only to field parameters.
function hands(ts: V3[], was: V3[], k: f64): f64 {
  let s = 0.0
  for side in 0 until ts.length {
    let keep = ts[side]
    const prior = was[side]
    if length(sub(keep, prior)) > k {
      keep = add(prior, scale(sub(keep, prior), 0.5))
    }
    s += length(keep)
    was[side] = keep
  }
  s
}

let total = 0.0
for f in 0 until 40 { total += fabrik(6, v3(2.0, f as f64 * 0.1, -1.0), 8) }
let ts: V3[] = []
let was: V3[] = []
for i in 0 until 5 {
  ts.push(v3(i as f64, 1.0, 0.0))
  was.push(v3(0.0, 0.0, 0.0))
}
for f in 0 until 10 { total += hands(ts, was, 0.5) }
print(total)
// A held read is a copy taken at the read: changing the list after does not reach it.
function proof(xs: V3[]): f64 {
  const first = xs[1]
  xs[1] = v3(9.0, 9.0, 9.0)
  first.x + first.y * 0.75 + xs[1].z * 0.0
}
print(proof(ts))
print(ts.length)
