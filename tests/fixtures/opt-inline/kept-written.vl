// @log 77 18 77 1
// @log 55 55
// Disqualifier: a field of the record is written somewhere.
type V3 = { x: f64, y: f64, z: f64 }
type H = { a: V3, n: f64 }

function mk(k: f64): V3 { ({ x: k, y: k * 2.0, z: k * 3.0 }) }
const h: H = { a: mk(1.0), n: 0.0 }
const alias = h.a
for i in 0 until 10 { h.a = mk(i as f64) }
const w = h.a
w.x = 77.0
print("\{h.a.x} \{h.a.y} \{w.x} \{alias.x}")
const v = mk(3.0)
h.a = v
v.y = 55.0
print("\{h.a.y} \{v.y}")
