// @log 7
// @log 3
// Disqualifier for a flattened list: an element's field is written through an alias, which a
// list holding copies would not see.
type V2 = { u: f64, w: f64 }

function mk(k: f64): V2 { ({ u: k, w: k * 3.0 }) }
const xs: V2[] = []
for i in 0 until 3 { xs.push(mk(i as f64)) }
const a = xs[1]
a.u = 7.0
print(xs[1].u)
print(xs[1].w)
