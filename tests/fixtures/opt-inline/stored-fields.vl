// @log 79.56673994815708
// @log 1
// @log 0.3711184188450051
// @log 300
// @allocs 1
// sunpa's posing (SP-039): small records stored into the fields of records held in a list,
// every frame, and read back field by field. At -O/-O3 the frame allocates nothing: the one
// struct.new left is the joint built at start-up.
type V3 = { x: f64, y: f64, z: f64 }
type Q = { x: f64, y: f64, z: f64, w: f64 }
type Joint = { rot: Q, at: V3, len: f64 }

function qnorm(q: Q): Q {
  const l = sqrt(q.x * q.x + q.y * q.y + q.z * q.z + q.w * q.w)
  ({ x: q.x / l, y: q.y / l, z: q.z / l, w: q.w / l })
}
function add(a: V3, b: V3): V3 {
  ({ x: a.x + b.x, y: a.y + b.y, z: a.z + b.z })
}

const joints: Joint[] = []
for i in 0 until 3 {
  joints.push(
    {
      rot: { x: 0.0, y: 0.0, z: 0.0, w: 1.0 },
      at: { x: 0.0, y: 0.0, z: 0.0 },
      len: 1.0,
    },
  )
}

// One frame: every joint's rotation and position is replaced, then read.
function pose(t: f64): f64 {
  let s = 0.0
  for i in 0 until joints.length {
    const j = joints[i]
    j.rot = qnorm({ x: t, y: i as f64, z: 1.0, w: 1.0 })
    j.at = add(j.at, { x: j.rot.x, y: j.rot.y, z: j.rot.z })
    j.len = j.len + 1.0
    s = s + j.rot.w + j.at.x
  }
  s
}

let total = 0.0
for f in 0 until 100 { total = pose(f as f64 * 0.01) }
print(joints[2].at.y)
print(joints[1].rot.y / joints[1].rot.w)
print(joints[0].rot.w * joints[0].rot.w * 2.0 - 0.3)
print(joints[0].len + joints[1].len + joints[2].len - 3.0)
