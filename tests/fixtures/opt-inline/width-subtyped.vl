// @log read 105
// @log read 513
// @log read 921
// @log ext 20 21 3 ext2 30 10 7
// @log after 2024 63
// @log after 3038 93
// @log after 921 30
// @log held 30 now 40 41
// @log others 4141 98 42
// @log closure 64
// @log closure-after 94
// @log global 8184 -1 99
// Width-subtyped parents (D622), closure captures, and a module-global parent.
type V3 = { x: f64, y: f64, z: f64 }
type Base = { at: V3, b: f64 }
type Ext = { at: V3, b: f64, c: f64 }
type Ext2 = { at: V3, b: f64, c: f64, d: V3 }

function mk(k: f64): V3 { ({ x: k, y: k + 1.0, z: k + 2.0 }) }
function sum(v: V3): f64 { v.x + v.y + v.z }

// Read and write the field through the supertype.
function readBase(p: Base): f64 { p.at.x * 100.0 + p.at.z + p.b }
function writeBase(p: Base, k: f64) { p.at = mk(k) }
function wholeBase(p: Base): V3 { p.at }

const e: Ext = { at: mk(1.0), b: 2.0, c: 3.0 }
const e2: Ext2 = { at: mk(5.0), b: 6.0, c: 7.0, d: mk(8.0) }
const bs: Base[] = [e, e2, { at: mk(9.0), b: 10.0 }]
for p in bs { print("read \{readBase(p)}") }
writeBase(e, 20.0)
writeBase(e2, 30.0)
print("ext \{e.at.x} \{e.at.y} \{e.c} ext2 \{e2.at.x} \{e2.d.z} \{e2.c}")
for p in bs { print("after \{readBase(p)} \{sum(wholeBase(p))}") }
const held = wholeBase(e2)
e2.at = mk(40.0)
e2.d = mk(41.0)
print("held \{held.x} now \{e2.at.x} \{e2.d.x}")
e2.b = 99.0
e2.c = 98.0
print("others \{readBase(e2)} \{e2.c} \{e2.d.y}")

// Closures capture a record and a parent.
function adder(p: Base): (f64) => f64 {
  const v = p.at
  (k: f64) => k + v.x + v.y + p.at.z
}
const f = adder(e)
print("closure \{f(1.0)}")
e.at = mk(50.0)
print("closure-after \{f(1.0)}")

// A module-global parent, written in a loop.
let g: Base = { at: mk(0.0), b: 0.0 }
let total = 0.0
for i in 0 until 100 {
  g.at = mk(i as f64)
  if i % 3 == 0 { g = { at: mk(-1.0), b: i as f64 } }
  total = total + g.at.y + g.b
}
print("global \{total} \{g.at.x} \{g.b}")
