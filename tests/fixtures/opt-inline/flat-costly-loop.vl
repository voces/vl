// @log 107200
// A list filled once and read field by field inside a nested loop: each read is weighted by
// its loops against the store's, so the list stays boxed by default, where a flat read's
// bounds-checked array.get per field would make the loop slower (D3736).
type V3 = { x: f64, y: f64, z: f64 }

function work(p: V3[], rounds: i32): f64 {
  let s = 0.0
  for r in 0 until rounds {
    for i in 0 until p.length { s += p[i].x * p[i].y + p[i].z }
  }
  s
}

const p: V3[] = []
for i in 0 until 64 { p.push({ x: i as f64, y: 1.0, z: 2.0 }) }
print(work(p, 50))
