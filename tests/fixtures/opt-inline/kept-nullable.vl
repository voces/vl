// @log 40
// Disqualifier: a nullable field.
type V3 = { x: f64, y: f64, z: f64 }
type H = { a: V3 | null, n: f64 }

function mk(k: f64): V3 { ({ x: k, y: k * 2.0, z: k * 3.0 }) }
const h: H = { a: null, n: 0.0 }
let s = 0.0
for i in 0 until 10 {
  h.a = if i % 2 == 0 { mk(i as f64) } else { null }
  const a = h.a
  if a != null { s = s + a.y }
}
print("\{s}")
