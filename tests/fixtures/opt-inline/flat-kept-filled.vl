// @log 6
// @log 4
// Disqualifier for a flattened list: `filled(n, v)` shares one box across every slot, so the
// boxed list is n references and one record, where a flat one would hold n copies of the
// record's fields: at n = 40,000,000, an array V8 refuses to make.
import { filled } from "std:array"
type Q = { x: f64, y: f64, z: f64, w: f64 }

const a = filled(4, { x: 1.0, y: 2.0, z: 3.0, w: 4.0 })
a[2] = { x: 9.0, y: 2.0, z: 3.0, w: 4.0 }
let s = 0.0
for i in 0 until a.length { s = s + a[i].x }
print(s / 2.0)
print(a.length)
