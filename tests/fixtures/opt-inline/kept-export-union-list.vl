// @log 2 4
// Disqualifier: the only export hands JS a list of parents through a union box, `P[] | string`.
type V = { x: f64, y: f64 }
type P = { a: V, n: i32 }

function mk(k: f64): V { ({ x: k, y: k * 2.0 }) }
function mkP(k: f64): P { ({ a: mk(k), n: 0 }) }
const p = mkP(1.0)
export function grab(i: i32): P[] | string {
  if i > 0 { [p] } else { "no" }
}
for i in 0 until 3 { p.a = mk(i as f64) }
print("\{p.a.x} \{p.a.y}")
