// @log 2652
// The cost rule: a table filled at one store site and read field by field at many. A flat
// read costs one bounds-checked array.get per field, so a list read far more than it is
// written stays boxed by default (and flattens, still correct, under `$VL_INLINE_REBOX`).
type V2 = { u: f64, w: f64 }

const tbl: V2[] = []
for i in 0 until 8 { tbl.push({ u: i as f64, w: (i * i) as f64 }) }

function score(i: i32, j: i32): f64 {
  const a = tbl[i].u * tbl[j].w + tbl[j].u * tbl[i].w
  const b = tbl[i].u + tbl[i].w + tbl[j].u + tbl[j].w
  const c = tbl[i].u * tbl[i].u + tbl[j].w * tbl[j].w
  const d = tbl[i].w - tbl[j].u
  a + b + c - d
}

let total = 0.0
for i in 0 until 4 { total += score(i, i + 3) }
print(total)
