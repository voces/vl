// `vl test` meta-fixture: what a test PRINTS, and how an f64 operand reads in a
// failure. Exercised by tests/vl_test_runner_test.ts (DV-902, DV-903).
import { expect, it, toEqual } from "std:test"

it("prints along the way", () => {
  print("printed by a passing test")
  expect(1).toEqual(1)
})

it("compares an f64", () => {
  expect(0.5).toEqual(1.25)
})
