// Traps on its first call: `pick` reads past the end of a three-element list. An
// optimized `--names` build must name the trapping frame, and must carry no
// source-line rows, since those describe the unoptimized module's bytes.
function pick(xs: i32[], k: i32): i32 {
  let s = 0
  let i = 0
  while i < 10 {
    s = s + xs[k + i]
    i = i + 1
  }
  return s
}

function outer(n: i32): i32 {
  const xs = [1, 2, 3]
  return pick(xs, n) + n
}

let t = 0
let j = 0
while j < 3 {
  t = t + outer(j)
  j = j + 1
}
print(t)
