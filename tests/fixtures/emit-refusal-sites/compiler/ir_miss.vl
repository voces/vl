// The IR decline channel's parsing cases: a literal, a template with a hole, a forward of a
// variable (no site of its own), the declaration itself, a longer identifier, and a wrapper
// that hands its `string` parameter to one (`skip`, whose callers' literals are sites).
function irLMiss(why: string) { return 0 }
function build(why: string, k: string) {
  irLMiss("non-stack temp: out of order")
  irBMiss("field " + k)
  missRhs(why)
  myirLMiss("not a site")
  return missRhs("spans two lines")
}
function skip(why: string): i32 {
  irBMiss(why)
  return 0
}
function use() {
  const r = skip("wrapped")
  return r
}
