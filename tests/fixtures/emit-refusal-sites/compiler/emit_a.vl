// Not a compiler: every emitFail("call in a comment") here is blanked.
function emitFail(msg: string) { emitFailAt(msg, 0) }

function emitFailAt(msg: string, at: i32) { print(msg) }

function one(t: i32, name: string) {
  emitFail("lowerSet: element kind supports only i32 and f64")
  emitFail("emitCall: the callee is supported as a value only")
  emitFailAt("toWasm: " + name + " has no rep in this module", t)
  emitFail("emitIs: the operand has no value box")
  emitFail("emitLet: the slot must be a local")
  emitFail("emitMatch: only an i32 scrutinee is supported here")
  emitFail(
    "emitMatch: only a literal pattern — never a binding, a guard or a nested record of any shape at all — is allowed",
  )
  emitFail("emitOp: unsupported operator " + name)
  emitFail("emitOp: the operator is not supported")
  emitFail("emitCast: cannot cast " + name + " to a boxed union")
  emitFail("emitRef: unknown function " + name)
  emitFail("emitIntern: type not interned")
  emitFail("emitArray: index out of range")
  emitFail("emitArgs: expected two arguments")
  emitFail("emitBody: the block is empty ")
  emitFail("emitArgs: requires a receiver")
  emitFail("emitArgs: the receiver is not a record")
  emitFail("emitArgs: the slot was set but the rep moved")
  emitFail("emitArgs: no frame")
  emitFail(describe(name))
  emitFail("emitOdd: a refusal with nothing to say")
  emitFail("emitFn: a map value has no lowering")
  emitFail("emitFn: nested closures are not yet supported")
  emitFailAt(
    "emitFn: " + name + " is not yet implemented for \"" + name + "\"",
    t,
  )
  emitFail("emitFn: the size×count product overflowed")
  emitFail("emitFn: café is unknown")
}
