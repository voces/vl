// @log 5473195
// A per-call state struct handed to a helper whose body is larger than the decoder helpers'
// (between 60 and 320 bytes of code): the escape step must still inline it, or the struct
// is passed to a call and stays on the heap.
type Acc = { a: i32, b: i32, c: i32, d: i32, n: i32 }

function mix(s: Acc, v: i32) {
  s.a = (s.a * 31 + v) % 1009
  s.b = (s.b + s.a * 7 + v * 3) % 2003
  s.c = (s.c * 17 + s.b + (v % 13)) % 4001
  s.d = (s.d + s.c * 5 + s.a * 11 + (v % 7)) % 8009
  if s.d > 4000 { s.d = s.d - 4000 }
  s.n += 1
}

function fold(seed: i32): i32 {
  const s: Acc = { a: seed % 97, b: 1, c: 2, d: 3, n: 0 }
  mix(s, seed)
  mix(s, seed + 1)
  mix(s, seed * 3)
  s.a + s.b + s.c + s.d + s.n
}

let total = 0
for i in 0 until 1000 { total += fold(i) }
print(total)
