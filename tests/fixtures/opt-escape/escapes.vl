// @log 21
// @log 13
// @log 33
// @log 3
// Per-call structs that DO leave their function after passing through a helper small
// enough to be inlined: returned (`Tally`, which no field can hold, so its helper is
// inlined), captured by a closure that outlives the call, and kept in a list. The
// allocation must stay real, and every write before the escape must show after it.
type Tally = { total: i32 }
type Acc = { total: i32, step: i32 }
type Pt = { x: i32, y: i32 }

function add(t: Tally, v: i32): Tally {
  t.total += v
  t
}

function build(): Tally {
  const t: Tally = { total: 0 }
  add(add(t, 5), 16)
}

function bumpAcc(a: Acc) { a.total += a.step }

function counter(start: i32): () => i32 {
  const a: Acc = { total: start, step: 1 }
  bumpAcc(a)
  () => {
    bumpAcc(a)
    a.total
  }
}

function keep(ps: Pt[], p: Pt) { ps.push(p) }

print(build().total)
const next = counter(10)
next()
print(next())
const ps: Pt[] = []
for i in 0 until 3 {
  const p: Pt = { x: i, y: i * 2 }
  keep(ps, p)
  p.x += 10
}
let s = 0
for p in ps { s += p.x + p.y - 2 }
print(s)
print(ps.length)
