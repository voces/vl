// @log 3083
// @log 3084
// @log 3085
// Identity and aliasing through inlined helpers: a write through one name is seen through
// the other, `same` tells the two names of one struct from two equal structs by writing
// through one and reading the other, and `==` still compares fields. Every answer must
// match the unoptimized build.
type Box = { v: i32, n: i32 }

function bump(b: Box): i32 {
  b.v += 1
  b.v
}

function same(a: Box, b: Box): boolean {
  const before = b.v
  a.v += 100
  const moved = b.v != before
  a.v -= 100
  moved
}

function alike(a: Box, b: Box): boolean { a == b }

function probe(k: i32): i32 {
  const s: Box = { v: 0, n: k }
  const t: Box = { v: 0, n: k }
  let acc = bump(s) + bump(s)
  const a = s
  a.v += 5
  acc += bump(s) * 10 + s.n
  if same(s, a) { acc += 1000 }
  if same(s, t) { acc += 2000 }
  t.v = s.v
  if alike(s, t) { acc += 2000 }
  if same(s, t) { acc += 4000 }
  acc
}

for k in 0 until 3 { print(probe(k)) }
