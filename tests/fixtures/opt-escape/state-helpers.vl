// @log 4127229
// A per-call state struct handed to small helpers, the shape of a byte decoder. No
// field, element or global can hold a `Cursor`, so once the helpers are inlined into
// `scan` it never leaves `scan` and `-O`/`-O3` keep it off the heap.
type Cursor = { at: i32, step: i32, wide: boolean, sum: i64 }

function next(c: Cursor): i32 {
  const v = (c.at * 7 + 3) % 11
  c.at += c.step
  v
}

function width(c: Cursor): i32 {
  if c.wide { return 2 }
  1
}

function take(c: Cursor, n: i32) {
  let k = 0
  while k < n {
    c.sum += next(c) * width(c)
    k += 1
  }
}

function scan(seed: i32): i64 {
  const c: Cursor = { at: seed, step: 1, wide: seed % 3 == 0, sum: 0 }
  take(c, 4)
  if next(c) > 5 { c.wide = !c.wide }
  take(c, 2)
  c.sum
}

let total: i64 = 0
for i in 0 until 100000 { total += scan(i) }
print(total)
