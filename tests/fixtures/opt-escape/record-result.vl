// @log 283192000
// @log 555000
// @log 4000
// Small records RETURNED from a call and only read, passed on or rewritten by the caller:
// plumb's squad shape (a producer with three call sites, too big for binaryen to inline on
// its own), a producer reached through a wrapper, and the same producer called straight from
// the top-level loop. None can be held by a heap location, so `-O`/`-O3` keep all of them
// off the heap.
type Quat = { x: f32, y: f32, z: f32, w: f32, ok: boolean }
type Span = { lo: i32, hi: i32 }

function slerp(a: f32, b: f32, t: f32): Quat {
  const s = a + (b - a) * t
  { x: s, y: s * 0.5, z: s + 1.0, w: s - 1.0, ok: s == s }
}

function squad(q1: f32, a: f32, b: f32, q2: f32, t: f32): f32 {
  const p = slerp(a, b, t)
  if !p.ok { return 0.0 as f32 }
  const q = slerp(q1, q2, t)
  if !q.ok { return 0.0 as f32 }
  const r = slerp(p.x + q.y, p.z + q.w, t * 0.5)
  r.x + r.y + r.z + r.w
}

function turned(k: i32): Quat { slerp(k as f32, (k + 2) as f32, 0.5) }

function lean(k: i32): i32 {
  const q = turned(k)
  q.w = q.w + 3.0
  if q.ok { return (q.w as! i32) - (q.x as! i32) }
  -1
}

function span(k: i32): Span { { lo: k, hi: k * 2 + 1 } }

function width(s: Span): i32 { s.hi - s.lo }

let acc: f64 = 0.0
let tot = 0
let leans = 0
for i in 0 until 1000 {
  const f = (i % 100) as f32
  acc = acc + (squad(f, f + 1.0, f + 2.0, f + 3.0, 0.25) as f64)
  const s = span(i)
  s.hi += 1
  tot += width(s)
  leans += lean(i) + lean(i + 1)
  const d = slerp(f, f + 4.0, 0.75)
  if d.ok { tot += d.z as! i32 }
}
print((acc * 1024.0) as! i64)
print(tot)
print(leans)
