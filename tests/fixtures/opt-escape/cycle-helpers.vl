// @log 1213
// Small helpers that take a per-call struct and call one another in a cycle. Inlining a
// cycle unrolls it and the struct stays live across the recursion anyway, so none of them
// may be chosen: the optimized module stays about the size of the plain one.
type Walk = { depth: i32, x: i32 }

function w0(c: Walk, k: i32): i32 {
  c.depth += 1
  c.x = (c.x * 17 + k) % 1009
  if k <= 0 { return c.depth }
  if c.x % 3 == 0 { return w2(c, k - 2) }
  w1(c, k - 1)
}

function w1(c: Walk, k: i32): i32 {
  c.depth += 2
  c.x = (c.x * 13 + k) % 1009
  if k <= 0 { return c.depth }
  if c.x % 3 == 1 { return w3(c, k - 2) }
  w2(c, k - 1)
}

function w2(c: Walk, k: i32): i32 {
  c.depth += 3
  c.x = (c.x * 11 + k) % 1009
  if k <= 0 { return c.depth }
  if c.x % 3 == 2 { return w0(c, k - 2) }
  w3(c, k - 1)
}

function w3(c: Walk, k: i32): i32 {
  c.depth += 4
  c.x = (c.x * 7 + k) % 1009
  if k <= 0 { return c.depth }
  w0(c, k - 1)
}

function walk(seed: i32): i32 {
  const c: Walk = { depth: 0, x: seed }
  w0(c, 12)
}

let t = 0
for i in 0 until 50 { t += walk(i) }
print(t)
