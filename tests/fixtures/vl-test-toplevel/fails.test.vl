// `vl test` meta-fixture: output printed at a file's top level, beside a passing and a
// failing test. Exercised by tests/vl_test_runner_test.ts (#1346, #1347).
import { expect, it, toEqual } from "std:test"

print("top level of fails")

it("passes and prints", () => {
  print("from the passing test")
  expect(1).toEqual(1)
})

it("fails and prints", () => {
  print("from the failing test")
  expect(1).toEqual(2)
})
