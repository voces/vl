// ir shadow: a function-valued field called off a receiver that is not a plain record
// expect no row containing method f
// expect covered >= 12
// expect matched >= 12
// `t0.f(1)` with `t0` a union box narrowed to a record arm is legacy's plain `emitCallRef`, as
// `emitCallCore` sends any closure-typed callee, whatever its receiver.

type K0 = "84648" | "bfvf" | "jzf"

function readAtom(v: { a: i32, f: (i32) => K0, z: f64 } | i32) {
  const t0 = v
  if t0 is { a: i32, f: (i32) => K0, z: f64 } {
    print(t0.f(1))
  } else {
    print("OTHER")
  }
}
readAtom({ a: 11, f: (_q0) => ("bfvf"), z: 2.5 })
readAtom(7)

const g: { f: { a: f32, f: () => boolean, z: string } | i64 } = {
  f: {
    a: 3.5,
    f: () => (true),
    z: "dx",
  },
}
function readField() {
  const t0 = g.f
  if t0 is { a: f32, f: () => boolean, z: string } {
    print(t0.f())
    print(t0.a)
    print(t0.z)
  } else {
    print("OTHER")
  }
}
const gi: { f: { a: f32, f: () => boolean, z: string } | i64 } = { f: 9 }
function readFieldI() {
  const t0 = gi.f
  if t0 is { a: f32, f: () => boolean, z: string } {
    print(t0.f())
  } else {
    print("OTHER")
  }
}
readField() // true / 3.5 / dx
readFieldI()

function readList() {
  const v: { f: (i32) => boolean[] } | f64 = { f: (_q0) => ([false]) }
  const t0 = v
  if t0 is { f: (i32) => boolean[] } {
    print(t0.f(1)[0])
  } else {
