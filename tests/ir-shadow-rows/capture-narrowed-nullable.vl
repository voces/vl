// ir shadow: a nullable capture read where the checker narrowed it to its member is the capture at its own rep, then legacy's recover, and matches
// expect covered >= 2
// expect matched >= 2
// expect no row containing capture binding
// expect no row containing mismatch
function mk(k: i32): i32[] | null {
  if k == 0 { return null }
  return [k, k]
}
function frame() {
  const c = mk(1)
  const f = () => {
    if c != null { print(c[1]) } else { print(0) }
  }
  f()
}
frame()
