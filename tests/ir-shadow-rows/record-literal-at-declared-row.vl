// ir shadow: a stashed record literal builds at its destination's row type and matches
// expect covered = 4
// expect no row containing uncovered
type VK = "i32" | "struct" | "list"
type RD = { rdKind: VK | null, rdNul: i32, rdSlot: i32, rdSigTok: string, rdListElem: string, rdAtom: i32 }
function tok(k: VK | null) { return if k == null { "" } else { "t" } }
function declared(kind: VK, nul: i32): RD {
  const d: RD = { rdKind: kind, rdNul: nul, rdSlot: -1, rdSigTok: tok(kind), rdListElem: "", rdAtom: 0 }
  return d
}
function returned(kind: VK): RD { return { rdKind: kind, rdNul: 2, rdSlot: -1, rdSigTok: tok(kind), rdListElem: "", rdAtom: 0 } }
function maybe(kind: VK, nul: i32): RD | null {
  if nul < 0 { return null }
  return { rdKind: kind, rdNul: nul, rdSlot: -1, rdSigTok: tok(kind), rdListElem: "", rdAtom: 0 }
}
print(declared("list", 1).rdNul)
print(returned("i32").rdSigTok)
print(maybe("struct", 3)?.rdNul ?? 0)
