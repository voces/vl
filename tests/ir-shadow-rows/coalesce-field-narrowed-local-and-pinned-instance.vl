// ir shadow: a field coalesce over a narrowed nullable local and a pinned instance's constant test
// expect covered >= 3
// expect no row containing fail
type C = { r: i32 | null }
function sink(x: {[string]: C}) {
  const v = x["k"]
  if v != null { print(v.r ?? 0) }
}
const m: {[string]: C} = Map()
m["k"] = { r: 7 }
sink(m)
type M = "a" | 1
function pick<T>(x: T) {
  let s: M | null = null
  s = x
  print(s ?? "n")
}
const mn: M | null = null
const ma: M = "a"
pick(mn)
pick(ma)
