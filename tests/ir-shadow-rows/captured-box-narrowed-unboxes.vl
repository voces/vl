// ir shadow: a captured union box narrowed in or around the closure reads on legacy's unbox arm
// expect covered >= 4
// expect matched >= 4
// expect no row containing read of
// expect no row containing fail
function inBody(u: i32 | null) {
  const f = () => {
    if u != null { print(u + 1) } else { print("none") }
  }
  f()
}
inBody(5)
inBody(null)
function atSite(u: i32 | null) {
  if u != null {
    const g = () => { print(u * 3) }
    g()
  }
}
atSite(1)
