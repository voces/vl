// ir shadow: a nullable string or boolean print of a valued if opens its blocks before the if (RPrintOpen), as legacy writes it
// expect covered >= 2
// expect matched >= 2
// expect no row containing of a valued if
// expect no row containing mismatch
function g(a: string | null, b: string | null, c: boolean) {
  print(if c { a } else { b })
}
function h(a: boolean | null, c: boolean) { print(if c { a } else { null }) }
g("x", null, true)
g("x", null, false)
h(true, true)
