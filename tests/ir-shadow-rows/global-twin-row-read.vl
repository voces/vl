// ir shadow: a global a call built at a declared twin's row is stored and read at that row
// expect start covered >= 1
// expect start matched >= 1
// expect no row containing global read coercion
type J = { f: i32 }
type K = { j: J | null }
type W = { k: K }
function mk() { return { k: { j: { f: 4 } } } }
const y = mk()
print(y.k.j.f)
const w: W = mk()
print(w.k.j?.f ?? 0)
