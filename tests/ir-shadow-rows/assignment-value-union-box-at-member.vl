// ir shadow: an assignment used as a value, writing one member into a union-box target, is the
// target's box re-read, unboxed at the destination's heap where a member is delivered
// expect covered >= 4
// expect matched >= 4
// expect start covered >= 1
// expect start matched >= 1
// expect no row containing mismatch
// expect no row containing fail
// expect no row containing global read coercion
// expect no row containing narrowed read
type A = { r: i32 }
type B = { s: string }
function src(): A | B { return { r: 3 } }
let x: A | B = src()
function go() {
  const k = () => {
    return x = { s: "b" }
  }
  print(k().s)
}
go()
const v: B = (x = { s: "c" })
print(v.s)
function loc() {
  let y: A | B = src()
  const w: B = (y = { s: "d" })
  print(w.s)
}
loc()
