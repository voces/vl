// ir shadow: an is test at litArms' box arms is, per literal, the box, its tag test, the box again and its payload compare
// expect covered >= 3
type L = "a" | "bb"
type N = 1 | 2
function lits(v: string | i32): boolean { return v is L }
function nums(v: string | i32): boolean { return v is N }
function mem(v: string | i32 | boolean): boolean { return v is "a" | "z" }
print(lits("a"))
print(lits("c"))
print(lits(3))
print(nums(2))
print(nums(5))
print(nums("x"))
print(mem("z"))
print(mem(true))
