// ir shadow: a list concat builds as RListCat over legacy's tail and matches
// expect covered = 5
// expect uncovered list concat widen = 1
type P = { x: i32 }
function ci(a: i32[], b: i32[]) { return a + b }
function cs(a: string[], b: string[]) { return a + b }
function cr(a: P[], b: P[]) { return a + b }
function c3(a: i32[], b: i32[], c: i32[]) { return a + b + c }
function cn(a: i32[] | null, b: i32[]) {
  if a == null { return b }
  return a + b
}
function cw(a: i32[], b: f64[]) { return b + a }
print(ci([1], [2]).length)
print(cs(["a"], ["b"]).length)
print(cr([{ x: 1 }], [{ x: 2 }])[1].x)
print(c3([1], [2], [3]).length)
print(cn([1], [2]).length)
print(cw([1], [2.5]).length)
