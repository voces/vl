// ir shadow: a render call whose template hole is pinned to a string or atom is that hole's string
// expect covered >= 3
// expect matched >= 3
// expect no row containing template hole pinned
// `show`'s instances at `K` and `string` write the hole's string where the call stands, as legacy's
// `emitCallCore` does before any call route.
type K = "a" | "b"
function show(a) { print("v=\{a}") }
function shown(a) { return "w=\{a}" }
const k: K = "a"
show(k)
show("s")
print(shown(k))
