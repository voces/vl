// ir shadow: a field or element write used as a value re-reads its target whole
// expect covered >= 1
// expect matched >= 1
// expect no row containing fail
type P = { x: i32 }
function elem(xs: i32[], i: i32) { print((xs[i] = 8) + 1) }
function field(p: P, v: i32) { print(p.x = v) }
const xs = [1, 2, 3]
elem(xs, 2)
const p: P = { x: 1 }
field(p, 4)
print(p.x + xs[2])
