// ir shadow: a field or element write used as a value re-reads its target whole
// expect covered >= 2
// expect matched >= 2
// expect no row containing fail
type P = { x: i32 }
function bump(xs: i32[], i: i32) { return (xs[i] = 8) + 1 }
function setX(p: P, v: i32): i32 { return p.x = v }
const xs = [1, 2, 3]
print(bump(xs, 2))
const p: P = { x: 1 }
print(setX(p, 4))
print(p.x + xs[2])
