// ir shadow: a variadic push with a spread argument builds legacy's minted run literal, whose
// slots no collect walk recorded and so key by the emission sequence
// expect covered >= 3
// expect matched >= 3
// expect no row containing mismatch
// expect no row containing fail
// expect no row containing array spread unrecorded
function one(xs: i32[], ys: i32[]) {
  xs.push(...ys)
  print(xs.length)
}
function mixed(xs: i32[], ys: i32[]) {
  xs.push(1, ...ys, 2)
  xs.push(...ys)
  print(xs[xs.length - 1])
}
function strs(xs: string[], ys: string[]) {
  xs.push("a", ...ys)
  print(xs.length)
}
one([1], [2, 3])
mixed([0], [5, 6])
strs([], ["b"])
