// ir shadow: a map variable's keys() and values() are legacy's writer over the variable
// expect covered >= 3
// expect matched >= 3
// expect no row containing fail
function keysOf(m: {[string]: i32}) {
  const ks = m.keys()
  print(ks.length)
}
function valsOf(m: {[i32]: string}) {
  const vs = m.values()
  for v in vs { print(v) }
}
function setVals(s: Set<i32>) {
  const xs = s.values()
  print(xs.length)
}
const a: {[string]: i32} = Map()
a["x"] = 1
a["y"] = 2
keysOf(a)
const b: {[i32]: string} = Map()
b[1] = "p"
valsOf(b)
const s: Set<i32> = Set()
s.add(4)
setVals(s)
