// ir shadow: a module record's bundle field read as a value is read at the record its cell holds
// expect start matched >= 1
// expect no row containing field read coercion
// expect no row containing mismatch
function lap(f) {
  f(2.5)
  f(3)
  return f
}
const w = { f: lap((a) => a + 1) }
const v = w.f
print(v(4))
print(v(1.5))
