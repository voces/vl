// ir shadow: a function value whose result is never, called as a named statement, a field and an index statement, an operand, an if arm and a return
// expect matched >= 8
// expect no row containing call of a non-declaration
type H = { fail: (s: string) => never }
function stmtNamed(bail: (s: string) => never, x: i32 | null): i32 {
  if x == null { bail("named") }
  return x + 1
}
function stmtField(h: H, x: i32 | null): i32 {
  if x == null { h.fail("field") }
  return x + 2
}
function stmtIndex(fs: ((s: string) => never)[], x: i32 | null): i32 {
  if x == null { fs[0]("index") }
  return x + 3
}
function operand(bail: (s: string) => never, c: boolean): i32 {
  if c { return 4 }
  return bail("operand") + 1
}
function arm(bail: (s: string) => never, c: boolean): string {
  const v = if c { "arm" } else { bail("arm") }
  return v + "!"
}
function ret(bail: (s: string) => never, c: boolean): i32 {
  if c { return 6 }
  return bail("ret")
}
function fieldValue(h: H, c: boolean): i32 {
  if c { return 7 }
  return h.fail("value") + 1
}
const bail = (s: string): never => {
  print(s)
  __trap__()
}
const h: H = { fail: bail }
print(stmtNamed(bail, 0))
print(stmtField(h, 0))
print(stmtIndex([bail], 0))
print(operand(bail, true))
print(arm(bail, true))
print(ret(bail, true))
print(fieldValue(h, true))
