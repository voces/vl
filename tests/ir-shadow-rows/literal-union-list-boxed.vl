// ir shadow: a literal-union list boxed into a union rides under its arm's tag
// expect covered >= 3
// expect matched >= 3
// expect no row containing box ladder
// expect no row containing fail
type K = "x" | "y"
function show(a: i32[] | K[]) {
  if a is K[] { print(a[0]) } else { print(a[0] + 1) }
}
function viaId() {
  const ks: K[] = ["x", "y"]
  show(ks)
}
function viaLit() { show(["y"]) }
viaId()
viaLit()
