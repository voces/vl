// ir shadow: an element read whose receiver call stages a lead below a boxed binding's ?? opens its row at the lead
// expect matched >= 2
// expect no row containing fail
// expect no row containing mismatch
// expect no row containing short-circuit argument after another
function pair(n: i32, v: i32 | f64): (i32 | f64)[] {
  const xs: (i32 | f64)[] = []
  let i = 0
  while i < n {
    xs.push(v)
    i = i + 1
  }
  return xs
}
function places(q: i32 | null, b: f64) {
  const v = pair(2, q ?? b)[1]
  if v is i32 { print(v) } else { print(v * 2.0) }
}
places(7, 6.75)
places(null, 6.75)
