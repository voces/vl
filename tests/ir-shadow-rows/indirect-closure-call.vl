// ir shadow: a call through a list element, a call's result and a parenthesized call builds as a plain closure call
// expect covered = 5
// expect matched = 5
function mk(n: i32): (k: i32) => i32 { return (k: i32): i32 => n + k }
function ap(fs: ((x: i32) => i32)[], v: i32): i32 { return fs[0](v) + mk(2)(v) }
function pick(c: boolean): (x: i32) => i32 {
  return if c { mk(1) } else { mk(5) }
}
function run(): i32 { return (pick(true))(3) }
print(ap([mk(1)], 4))
print(run())
