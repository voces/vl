// ir shadow: a `boolean | null` field narrowed by `is boolean` or `!= null`, off a plain record and
// off a union member, is read as the i32 its niche holds, as legacy reads it
// expect no row containing member record
// expect matched >= 3
type O = { f: boolean | null, n: i32 }
type A = { kind: "a", f: boolean | null }
type B = { kind: "b", n: i32 }
type U = A | B
function rec(o: O) {
  if o.f is boolean { print(o.f) }
}
function notNull(o: O) {
  if o.f != null { print(!o.f) }
}
function arm(a: A) {
  if a.f is boolean { print(a.f) }
}
const a: A = { kind: "a", f: false }
const u: U = a
rec({ f: true, n: 1 })
notNull({ f: true, n: 2 })
arm(a)
if u is B { print(u.n) }
