// ir shadow: a bare block mid-body builds through its rewrite's untyped true and matches
// expect covered = 2
// expect no row containing uncovered
function mid(x: i32) {
  let y = x
  {
    const z = y + 1
    y = z * 2
  }
  return y
}
function nested(x: i32) {
  let y = x
  {
    {
      y = y + 4
    }
    y = y + 1
  }
  return y
}
print(mid(1))
print(nested(4))
