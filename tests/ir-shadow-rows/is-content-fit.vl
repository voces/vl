// ir shadow: x is B where the checker minted a content check (isFit), built as the check itself
// expect covered >= 2
// expect no row containing is staged
// expect no row containing fail
type A = { x: i32 }
type B = { x: 1 | 2 }
type C = { z: string }
function g(r: A | C) {
  if r is B { return r.x * 10 }
  return 0 - 1
}
function h(r: A | C) {
  if !(r is B) { return "no" }
  return "B"
}
print(g({ x: 1 }))
print(g({ x: 7 }))
print(g({ z: "s" }))
print(h({ x: 2 }))
print(h({ z: "s" }))
