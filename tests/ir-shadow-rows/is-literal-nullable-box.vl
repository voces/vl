// ir shadow: x is N over a null-tagged box (a nullable numeric or string literal union) is the box's own tag test per member
// expect covered >= 2
type N = 1 | 2
type S = "a" | "b"
function isN(x: N | null): boolean { return x is N }
function isS(x: S | 3 | null): boolean { return x is S }
print(isN(1))
print(isN(null))
print(isS("a"))
print(isS(3))
print(isS(null))
