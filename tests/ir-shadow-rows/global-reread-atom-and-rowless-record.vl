// ir shadow: a literal-union global's assignment value re-reads the cell's atom and decodes it,
// and a global whose record type has no struct row reads at the row its initializer stored
// expect covered >= 4
// expect matched >= 4
// expect start covered >= 1
// expect start matched >= 1
// expect no row containing mismatch
// expect no row containing fail
// expect no row containing global read coercion
type K = "zz" | "ww"
let top: K = "zz"
function setTop() { return top = "ww" }
print(setTop())
type Circle = { r: i32 | null }
function sink(_x: Circle) {}
function mkcall() { return { r: null } }
sink(mkcall())
function first<T>(a: T, _b: T): T { return a }
const y = first(mkcall(), { r: null })
print(y.r ?? 4)
