// ir shadow: a module const holding a returned bundle record is that record, cell and read alike
// expect start matched >= 1
// expect no row containing global initializer coercion
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
const u = lap((a) => a / 2)
const xs = [u]
const v = xs[0]
print(v(3))
