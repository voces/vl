// ir shadow: a nullable reference global read where the checker narrowed it to its non-null member
// expect covered >= 1
// expect matched >= 1
// expect no row containing global read coercion
type P = { a: i32 }
let p: P | null = null
p = { a: 3 }
print(p.a)
let s: string | null = null
s = "x"
print(s + "y")
let l: i32[] | null = null
l = [4]
print(l.length)
function f() {
  if p != null { print(p.a + 1) }
  if s != null { print(s) }
}
f()
