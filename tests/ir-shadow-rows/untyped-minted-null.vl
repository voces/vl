// ir shadow: an untyped minted null into a nullable string field and at a null-only instance matches
// expect covered >= 4
// expect no row containing rep ?
// expect no row containing miss
type Other = { b: i32 }
type OS = { s: string | null }
function mk(): Other | OS { return {} }
function show(v: Other | OS) { return if v is OS { v.s ?? "nul" } else { "o" } }
const c: Other | OS = {}
print(show(mk()))
print(show(c))
function inc(x: i32) { return x + 1 }
function stmt(b) { b?.g(2) }
stmt(null)
stmt({ g: inc })
