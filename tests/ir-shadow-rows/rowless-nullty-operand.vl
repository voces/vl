// ir shadow: a `null`-typed field's null test is legacy's read-and-drop: the field raw at its storage, dropped, then the constant
// expect covered >= 2
// expect matched >= 2
// expect no row containing null test nullty
// expect no row containing mismatch
type K = { f: i32 | null }
function mkn() { return { f: null } }
const kA: K = mkn()
print(kA.f ?? 3)
function mkg(y) { return { g: y.f == null } }
print([mkn()].map(mkg)[0].g)
