// ir shadow: a literal-union member narrowed out of a union box prints as the string it is boxed as
// expect covered >= 3
// expect matched >= 3
// expect no row containing print operand rep
// `loc` narrows a box parameter, `fld` a union-box field and `glo` a box global (`irBUnboxKindRep`).
type K0 = "aa" | "bb"
const G: K0 | f64 = "bb"
function loc(x: K0 | f64) {
  if x is K0 { print(x) }
}
function fld(a: { f: K0 | f64 }) {
  if a.f is K0 { print(a.f) }
}
function glo() {
  if G is K0 { print(G) }
}
loc("aa")
fld({ f: "bb" })
glo()
