// ir shadow: a tagged set's id handed to the closure adapter's call is a plain i32 argument
// expect covered >= 6
// expect matched >= 6
// expect no row containing indirect call
// `run` delivers `f`, a tagged set, to `twice`'s closed parameter through the adapter lambda the
// checker writes; that call takes the set's i32 id as it stands, as legacy's general arm writes it.
function twice(f: (n: i32) => i32, n: i32): i32 { return f(f(n)) }
function inc(a) { return a + 1 }
function dbl(a) { return a * 2 }
function run(c: boolean) {
  let f = inc
  if c { f = dbl }
  print(f(1))
  print(twice(f, 5))
}
run(true)
run(false)
