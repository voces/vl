// ir shadow: a call's record copied into another row reads its value once, then the copy's tail
// expect start covered >= 1
// expect start matched >= 1
// expect no row containing pre-path coercion recCopy
type J = { f: i64 }
type K = { j: J }
function mk() { return { j: { f: 4 } } }
const y = mk()
const _k: K = mk()
print(y.j.f)
