// ir shadow: two boxed bindings' ?? arguments side by side, and one before a call argument
// expect matched >= 3
// expect no row containing short-circuit argument after another
function show2(a: i32 | i64, c: i32 | i64) {
  print(if a is i32 { "i32" } else { "i64" })
  print(a)
  print(if c is i32 { "i32" } else { "i64" })
  print(c)
}
function three(): i64 {
  print("lead")
  return 3
}
function run(q: i32 | null, r: i32 | null, b: i64) {
  show2(q ?? b, r ?? b)
  show2(q ?? b, three())
}
run(7, null, -9000000003)
run(null, 8, -9000000003)
