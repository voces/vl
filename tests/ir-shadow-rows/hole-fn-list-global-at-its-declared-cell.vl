// ir shadow: a module global stores a generic call's list of closure lists as its cell declares it
// expect start matched >= 1
// expect no row containing global initializer coercion
// The cell's hole type has no valtype; the global section declares it at the value's list
// (`cellDeclStores`), so the cell is noted at the value's rep.
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function id2(x) { return x }
const ll = id2([[inc0, half]])
print(ll[0][1](3))
print(ll[0][0](3))
