// ir shadow: a shared nullable let written null after a number stores its literal into the nested cell
// expect covered >= 3
// expect matched >= 3
// expect no row containing store element
// The cell of a `T | null` let is a nested list; a store of its literal builds the inner list, as
// legacy's nested-row store does.
function go(k: i32) {
  let u: i32 | null
  const set = (x: i32 | null) => {
    u = x
  }
  const get = () => if u == null { -1 } else { u }
  set(k)
  print(get())
  set(null)
  print(get())
  u = null
  print(get())
}
go(5)
