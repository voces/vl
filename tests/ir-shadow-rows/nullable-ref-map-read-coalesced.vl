// ir shadow: a nullable ref map value read under ?? is the niche's value, its null the default
// expect covered >= 2
// expect matched >= 2
// expect no row containing map read mv
// expect no row containing fail
type P = { x: i32 }
function rec(m: {[string]: P | null}, k: string) {
  const v = m[k] ?? { x: 9 }
  print(v.x)
}
function str(m: {[string]: string | null}, k: string) {
  const v = m[k] ?? "none"
  print(v)
}
function go() {
  const a: {[string]: P | null} = Map()
  a["p"] = { x: 3 }
  a["n"] = null
  rec(a, "p")
  rec(a, "n")
  rec(a, "z")
  const b: {[string]: string | null} = Map()
  b["s"] = "hi"
  b["n"] = null
  str(b, "s")
  str(b, "n")
  str(b, "z")
}
go()
