// ir shadow: an is arm tag test over a box value that is not a local's slot is the value and its tag compare
// expect covered >= 3
function boxOf(n: i32): string | i32 { return if n > 0 { "a" } else { 3 } }
function callIs(n: i32): boolean { return boxOf(n) is string }
function elemIs(xs: (string | i32)[], i: i32): boolean { return xs[i] is i32 }
print(callIs(1))
print(callIs(0))
print(elemIs(["a", 2], 1))
print(elemIs(["a", 2], 0))
