// ir shadow: `==`/`!=` over nullable references builds through RNulNicheEq under legacy's guard
// expect covered >= 5
// expect matched >= 5
// expect no row containing operand type
function cmpList(a: i32[] | null, b: i32[] | null) { return a == b }
function cmpStr(a: string | null, b: string | null) { return a == b }
function cmpStrList(a: string[] | null, b: string[] | null) { return a == b }
function cmpRefList(a: i32[][] | null, b: i32[][] | null) { return a == b }
function neStr(a: string | null, b: string | null) { return a != b }
print(cmpList([1, 2], [1, 2]))
print(cmpList(null, [1]))
print(cmpStr(null, null))
print(cmpStr("x", "y"))
print(cmpStrList(["a"], ["a"]))
print(cmpRefList([[1]], null))
print(neStr("a", null))
