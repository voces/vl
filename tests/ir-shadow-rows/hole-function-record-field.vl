// ir shadow: a hole function stored in a record field builds at the field's closure rep, and reads at the built kid
// expect covered >= 2
// expect matched >= 2
// expect no row containing object field coercion
// `asBool` and `asStr` store `g` at two instances' closure reps (`holeCloTy`).
function g(a) { return a }
function asBool() { return { f: g, n: 1 }.f(true) }
function asStr() { return { f: g, n: "x" }.f("s") }
print(asBool())
print(asStr())
