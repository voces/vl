// ir shadow: a stored row's boxed field read converting to a narrower number is a named miss
// expect start uncovered field read of a stored row's box = 1
// `o.f` reads `i64 | null`'s box at `i32`: legacy unboxes and converts, which this read does not.
type J = { f: i64 | null }
type F = { f: f64 | null }
function mk2() { return { f: 7 } }
function mk3() { return { f: 7 } }
const o = mk2()
const d: J = o
print(o.f)
print(d.f ?? 0)
const p = mk3()
const e: F = p
print(e.f ?? 0)
print(p.f)
