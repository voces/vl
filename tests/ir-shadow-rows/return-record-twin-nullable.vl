// ir shadow: a record literal at a same-heap twin row is retagged before its nullable return widen
// expect covered >= 2
// expect matched >= 2
// expect no row containing return coercion
export type Diag = { msg: string, at: i32 }
const ds: Diag[] = []
const xs: i32[] = [1, 2, 3]
function lm(): LateMiss | null {
  let j = 0
  while j < xs.length {
    if xs[j] == 2 {
      const at = xs[j]
      return { at: at, msg: "m" + "x" }
    }
    j = j + 1
  }
  return null
}
export type LateMiss = { at: i32, msg: string }
function addD(m: string) { ds.push({ msg: m, at: 1 }) }
addD("q")
const r = lm()
if r != null { print(r.msg) }
print(ds[0].msg)
