// ir shadow: a choice delivered to a closed function type is a lifted adapter whose captured id
// dispatches to the member chosen, each result boxed at the adapter's union
// expect covered >= 5
// expect no row containing capture binding
// expect no row containing fail
function inc(a) { return a + 1 }
function str(_a) { return "s" }
function ap(g, x) { return g(x) }
function run(c: boolean) {
  const g = if c { str } else { inc }
  print(ap(g, 3))
  const k: (a: i32) => i32 | string = g
  print(k(4))
}
run(true)
run(false)
