// ir shadow: a one-literal place legacy's atom hook writes as its member's id builds through RAtomSole
// expect covered >= 5
// expect matched >= 5
// expect no row containing pre-path atom hook
function take(m: "x" | "y" | "z") { print(m) }
function param(b: "y") {
  const m: "x" | "y" | "z" = b
  print(m)
}
function arg(b: "y") { take(b) }
function ret(b: "x"): "x" | "y" { return b }
function narrowed(v: "x" | "y") {
  if v == "y" {
    const m: "y" | "z" = v
    print(m)
  }
}
param("y")
arg("y")
print(ret("x"))
narrowed("y")
