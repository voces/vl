// ir shadow: a map store whose value is an assignment to a wider name stages its receiver and key
// below the store and matches legacy
// expect matched >= 1
// expect no row containing map store value store
function go(): f64 {
  let m: f64 = 0.5
  const box: { [string]: i32 } = Map()
  box["k"] = (m = 5)
  print(box["k"] ?? -1)
  return m
}
print(go())
