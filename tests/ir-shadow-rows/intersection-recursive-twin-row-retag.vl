// ir shadow: an intersection over a recursive record, the record also in a union with another, retagged at a call argument and a return, typed at the delivery's own type
// expect matched >= 4
// expect no row containing fail
// expect no row containing mismatch
type Node = { v: i32, next: Node | null }
type M = Node & { v: i32 }
type R = { w: string }
function sink(n: i32) { print(n) }
function pickNext(m: M, other: boolean): Node | null {
  if other { return null }
  return m.next
}
function f(m: M, other: boolean) {
  const nx = pickNext(m, other)
  if nx != null { sink(nx.v) } else { print("else") }
}
function g(u: Node | R | null) {
  if u is Node { sink(u.v) }
  else if u != null { print(u.w) }
  else { print("null") }
}
const tail: Node = { v: 9, next: null }
f({ v: 1, next: tail }, false)
f({ v: 1, next: tail }, true)
f({ v: 1, next: null }, false)
g(tail)
g({ w: "r" })
g(null)
