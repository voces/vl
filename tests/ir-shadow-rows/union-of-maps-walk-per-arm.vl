// ir shadow: a walk of a union of maps' box is built per arm, its pair's value boxed into the value union
// expect covered >= 3
// expect matched >= 3
// expect no row containing for in iterable
function __pick(p, c: boolean) {
  const s: {[string]: string} = Map()
  s["k"] = p
  const t: {[string]: boolean} = Map()
  t["j"] = true
  return if c { s } else { t }
}
function __show(r: string | boolean): string {
  if r is string { return r }
  return "b"
}
function pairs(v) {
  let out = ""
  for k, x in v { out = out + k + "=" + __show(x) + ";" }
  print(out)
}
function keys(v) {
  let n = 0
  for k in v { n = n + 1 }
  print(n)
}
pairs(__pick("x", true))
keys(__pick("x", false))
