// ir shadow: a boolean | null ?? d whose present arm re-reads the operand writes it again as built: a list element read, or a global
// expect covered >= 1
// expect start covered >= 1
function f(o: (boolean | null)[], i: i32): boolean { return o[i] ?? false }
const g: boolean | null = null
print(g ?? true)
print(f([true], 0))
print(f([null], 0))
