// ir shadow: a store of a literal written out of row order holding a staging ?? stages its leads and matches
// expect covered >= 3
// expect no row containing uncovered
type P = { a: i32, b: i32 }
type H = { p: P }
let n = 0
function mkq(x: boolean): i32 | null { return if x { null } else { 2 } }
function five(): i32 {
  n = n + 1
  return 5
}
function tick(): i32 {
  n = n + 10
  return 1
}
function mapOne(m: {[string]: P}, x: boolean) {
  const q = mkq(x)
  m["k"] = { b: tick(), a: q ?? five() }
}
function fieldOne(h: H, x: boolean) {
  const q = mkq(x)
  h.p = { b: tick(), a: q ?? five() }
}
const m: {[string]: P} = Map()
const h: H = { p: { a: 0, b: 0 } }
mapOne(m, true)
fieldOne(h, false)
print(n)
print(h.p.a)
