// ir shadow: a record compare whose operands legacy re-reads at each field: globals, a global's field, a parameter's field, and a narrowed nullable local
// expect matched >= 3
// expect start matched >= 1
// expect no row containing record compare place operand
type P = { x: i32, s: string }
type Q = { p: P, n: i32 }
const a: Q = { p: { x: 1, s: "a" }, n: 2 }
const b: Q = { p: { x: 1, s: "a" }, n: 3 }
function fields(u: Q, v: Q): boolean { return u.p == v.p }
function narrowed(): boolean {
  let m: Q | null = null
  m = a
  return m == a
}
function globals(): boolean { return a == b }
print(a == b)
print(a.p == b.p)
print(fields(a, b))
print(narrowed())
print(globals())
