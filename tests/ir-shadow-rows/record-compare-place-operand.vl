// ir shadow: a record compare whose operands legacy re-reads at each field: globals, field chains two deep over a global, a parameter's field, a narrowed nullable local or parameter, and a place beside a call on either side
// expect matched >= 8
// expect start matched >= 1
// expect no row containing record compare place operand
type C = { v: i32, s: string }
type B = { c: C, k: i32 }
type A = { b: B, n: i32 }
const g: A = { b: { c: { v: 1, s: "x" }, k: 2 }, n: 3 }
const h: A = { b: { c: { v: 1, s: "x" }, k: 9 }, n: 4 }
function mk(): C { return { v: 1, s: "x" } }
function globals(): boolean { return g == h }
function deep(): boolean { return g.b.c == h.b.c }
function fields(u: A, w: A): boolean { return u.b == w.b }
function guarded(x: B | null, y: B): boolean {
  if x != null { return x.c == y.c }
  return false
}
function assigned(): boolean {
  let m: A | null = null
  m = g
  return m == g
}
function mixL(y: A): boolean { return mk() == y.b.c }
function mixR(y: A): boolean { return y.b.c == mk() }
print(g == h)
print(g.b.c == h.b.c)
print(mk() == g.b.c)
print(globals())
print(deep())
print(fields(g, h))
print(guarded(g.b, h.b))
print(guarded(null, h.b))
print(assigned())
print(mixL(g))
print(mixR(h))
