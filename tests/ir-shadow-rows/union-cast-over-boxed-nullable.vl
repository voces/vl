// ir shadow: a union cast over a boxed `T | null` operand, at a call argument, nested, a concat operand, a return, a binding, an if arm, a `??` operand and a record field
// expect matched >= 12
// expect no row containing union cast operand rep
type U = i32 | string | null
function mk(k: i32): U {
  if k == 0 { return 7 }
  if k == 1 { return "s" }
  return null
}
function sN(x: i32 | null) { return if x == null { -1 } else { x } }
function takeI(x: i32) { return x * 2 }
function idN(x: i32 | null) { return x }
function argUnion(u: U) { return sN(u as? i32) }
function argNested(u: U) { return sN(idN(u as? i32)) }
function argScalar(u: U) { return takeI(u as! i32) }
function concat(u: U) { return "c" + (u as! string) }
function ret(u: U): i32 | null { return u as? i32 }
function letInit(u: U) {
  const x = u as? i32
  return sN(x)
}
function ifArm(u: U, f: boolean) {
  const x = if f { u as? i32 } else { null }
  return sN(x)
}
function coalesce(u: U) { return (u as? i32) ?? -5 }
function recField(u: U) {
  const r = { a: u as? i32 }
  return sN(r.a)
}
print(argUnion(mk(0)))
print(argUnion(mk(1)))
print(argUnion(mk(2)))
print(argNested(mk(2)))
print(argScalar(mk(0)))
print(concat(mk(1)))
print(sN(ret(mk(2))))
print(letInit(mk(1)))
print(ifArm(mk(2), true))
print(coalesce(mk(2)))
print(recField(mk(0)))
