// ir shadow: a literal-union atom or a scalar list passed to a closure call goes in as it stands, and matches
// expect covered >= 6
// expect matched >= 6
// expect no row containing call of a non-declaration
// expect no row containing mismatch
type K = "a" | "b"
function apply(f: (k: K) => i32, k: K): i32 { return f(k) }
function go() {
  const g = (k: K) => if k == "a" { 1 } else { 2 }
  const q: K = "b"
  print(g(q))
  print(g("a"))
  const sum = (xs: f64[]) => xs.length
  const ys: f64[] = [1.5, 2.5]
  print(sum(ys))
  const join = (ss: string[]) => ss.length
  const ws = ["x", "y", "z"]
  print(join(ws))
}
go()
print(apply((k) => if k == "b" { 7 } else { 8 }, "b"))
