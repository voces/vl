// ir shadow: a union compare whose box is a narrowed or captured read reads it again and matches
// expect covered >= 7
// expect no row containing uncovered
// Each arm answers its own number: "a" 1, "b" 2, an i32 100 + k, a record 200 + r, null -1.
function lits(k: "a" | "b" | i32): i32 {
  if k == "a" { return 1 }
  if k == "b" { return 2 }
  return 100 + k
}
function afterNull(k: "a" | i32 | null): i32 {
  return match k {
    null => -1
    "a" => 1
    i32 => 100 + k
  }
}
function rec(k: "a" | "b" | { r: i32 }): i32 {
  return match k {
    "a" => 1
    "b" => 2
    _ => 200 + k.r
  }
}
function cap(k: "a" | i32): () => i32 {
  return () => match k {
    "a" => 1
    _ => 3
  }
}
// The other operand writes the box first: the compare reads it before the call, as legacy does.
function bumped(k0: "a" | "b" | i32): i32 {
  let k: "a" | "b" | i32 = k0
  const bump = (): "a" | "b" | i32 => {
    k = 5
    return "b"
  }
  if k == "a" { return 1 }
  if k == bump() { return 2 }
  return 3
}
print(lits("a"))
print(lits("b"))
print(lits(3))
print(afterNull(null))
print(afterNull("a"))
print(afterNull(4))
print(rec("a"))
print(rec("b"))
print(rec({ r: 9 }))
print(cap("a")())
print(cap(2)())
print(bumped("b"))
print(bumped(7))
