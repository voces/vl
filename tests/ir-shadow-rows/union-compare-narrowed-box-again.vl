// ir shadow: a union compare whose box is a narrowed or captured read reads it again and matches
// expect covered >= 5
// expect no row containing uncovered
function lits(k: "a" | "b" | i32): i32 {
  if k == "a" { return 1 }
  if k == "b" { return 2 }
  return 0
}
function afterNull(k: "a" | i32 | null) {
  return match k {
    null => 2
    "a" => 1
    i32 => k + 5
  }
}
function rec(k: "a" | "b" | { r: i32 }) {
  return match k {
    "a" => 1
    "b" => 2
    _ => k.r
  }
}
function cap(k: "a" | i32): () => string {
  return () => match k {
    "a" => "ca"
    _ => "ci"
  }
}
print(lits("b") + lits(3) + afterNull(null) + afterNull("a") + afterNull(4) + rec("b") + rec({ r: 9 }))
print(cap("a")() + cap(2)())
