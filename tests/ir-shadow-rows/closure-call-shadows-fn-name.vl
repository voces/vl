// ir shadow: a closure binding that shadows a function of its name is called through, and matches
// expect covered >= 5
// expect matched >= 5
// expect no row containing call of a non-declaration
// expect no row containing mismatch
function qa(a: i32): i32 { return a + 100 }
function viaParam(qa: (n: i32) => i32): i32 { return qa(8) }
function viaLocal(): i32 {
  const qa = (n: i32) => n * 2
  return qa(5)
}
print(viaParam((n) => n + 1))
print(viaLocal())
print(qa(1))
