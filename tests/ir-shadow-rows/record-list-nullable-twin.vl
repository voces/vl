// ir shadow: a record list bound at its record-or-null twin list retags it as itself
// expect covered >= 1
// expect matched >= 1
// expect no row containing declaration coercion
// expect no row containing fail
type Circle = { r: i32 }
function f() {
  const xs = [{ r: 7 }]
  const a: (Circle | null)[] = xs
  const b: Circle[] = xs
  print(a.length)
  print(b.length)
  print(b[0].r)
}
f()
