// ir shadow: a const cell's constant initializer builds as a fragment and matches legacy
// expect const cell plain number: matched = 1
// expect const cell plain string: matched = 2
// expect const cell plain array: matched = 2
// expect const cell plain object: matched = 2
// expect const cell union number: matched = 2
// expect no row containing const cell plain number: miss
type P = { x: i32, y: f64 }
const a = 1
const b = a + 2
const s = "hi"
const xs = [1, 2, 3]
const p: P = { x: 1, y: 2 }
const u: i32 | string = 3
print(b)
print(s)
print(xs[1])
print(p.y)
print(u)
