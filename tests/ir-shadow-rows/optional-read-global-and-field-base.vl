// ir shadow: a standalone `?.` over a module global or a field read, its base written again after the null test, in argument, nested, return, binding, if arm, `??`, record field and statement positions, and over a nullable leaf field
// expect matched >= 16
// expect no row containing optional read base
type In = { v: i32, s: string | null }
type H = { p: In | null }
function mk(k: i32): In | null {
  if k == 0 { return { v: 1, s: "a" } }
  if k == 1 { return { v: 2, s: null } }
  return null
}
let g = mk(0)
const hold: H = { p: mk(1) }
function sN(x: i32 | null) { return if x == null { -1 } else { x } }
function sS(x: string | null) { return x ?? "n" }
function idN(x: i32 | null) { return x }
function gArg() { return sN(g?.v) }
function gStr() { return sS(g?.s) }
function gNested() { return sN(idN(g?.v)) }
function gRet(): i32 | null { return g?.v }
function gInfer() {
  const x = g?.v
  return sN(x)
}
function gArm(c: boolean) {
  const x = if c { g?.v } else { null }
  return sN(x)
}
function gCoal() { return g?.v ?? -5 }
function gRec() {
  const r = { a: g?.v }
  return sN(r.a)
}
function gStmt() {
  g?.v
  return 0
}
function fArg() { return sN(hold.p?.v) }
function fStr() { return sS(hold.p?.s) }
function local(h: H) { return sN(h.p?.v) }
print(gArg())
print(gStr())
print(gNested())
print(sN(gRet()))
print(gInfer())
print(gArm(true))
print(gCoal())
print(gRec())
print(gStmt())
g = mk(2)
print(gArg())
print(fArg())
print(fStr())
print(local({ p: null }))
