// ir shadow: a record write's value reads its let at the row its slot is declared at
// expect covered >= 2
// expect matched >= 2
// expect no row containing narrowed read
// expect no row containing fail
type Node = { v: i32, left: Node | null }
function toField(n: Node, v: i32) { return n.left = { v: v, left: null } }
print(toField({ v: 1, left: null }, 3).v)
function toElem(xs: (Node | null)[], v: i32) {
  return xs[0] = { v: v, left: null }
}
const slots: (Node | null)[] = [null]
print(toElem(slots, 4).v)
const other = { v: 9, left: null }
print(other.v)
