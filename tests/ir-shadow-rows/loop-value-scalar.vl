// ir shadow: a scalar loop value leaves its typed frame through its result binding
// expect covered >= 4
// expect matched >= 4
// expect no row containing loop value
function tailValue(n: i32): i32 {
  const r = @B {
    if n < 0 { break @B 0 }
    n * 2
  }
  return r + 1
}
function onlyBreaks(n: i32): i32 {
  const r = @B {
    if n > 5 { break @B 50 }
    break @B n
  }
  return r
}
function outerBreak(n: i32): i32 {
  const r = @Outer {
    @Inner {
      if n == 0 { break @Outer 100 }
      if n == 1 { break @Inner }
    }
    n + 7
  }
  return r
}
function firstOver(xs: i32[], limit: i32): i32 {
  let i = 0
  const r = while true {
    if xs[i] > limit { break xs[i] }
    i = i + 1
  }
  return r * 10
}
print(tailValue(4))
print(tailValue(-3))
print(onlyBreaks(9))
print(onlyBreaks(2))
print(outerBreak(0))
print(outerBreak(1))
print(outerBreak(5))
print(firstOver([1, 5, 9, 12], 6))
