// ir shadow: a scalar loop value leaves its typed frame through its result binding
// expect covered >= 7
// expect matched >= 7
// expect no row containing loop value
function tailValue(n: i32): i32 {
  const r = @B {
    if n < 0 { break @B 0 }
    n * 2
  }
  return r + 1
}
function onlyBreaks(n: i32): i32 {
  const r = @B {
    if n > 5 { break @B 50 }
    break @B n
  }
  return r
}
function outerBreak(n: i32): i32 {
  const r = @Outer {
    @Inner {
      if n == 0 { break @Outer 100 }
      if n == 1 { break @Inner }
    }
    n + 7
  }
  return r
}
function firstOver(xs: i32[], limit: i32): i32 {
  let i = 0
  const r = while true {
    if xs[i] > limit { break xs[i] }
    i = i + 1
  }
  return r * 10
}
function sumPast(limit: i32) {
  let i = 0
  let acc = 0
  const r = while true {
    i = i + 1
    acc = acc + i * i
    if acc > limit { break acc - i }
  }
  return r
}
function wideBlock(n: i64) {
  const r = @W {
    if n < 0 { break @W 0 }
    n * 3000000000
  }
  return r
}
function halfUntil(x: f64) {
  let v = x
  const r = while true {
    v = v / 2.0
    if v < 1.0 { break v * 10.0 }
  }
  return r
}
print(tailValue(4))
print(tailValue(-3))
print(onlyBreaks(9))
print(onlyBreaks(2))
print(outerBreak(0))
print(outerBreak(1))
print(outerBreak(5))
print(firstOver([1, 5, 9, 12], 6))
print(sumPast(20))
print(wideBlock(5))
print(wideBlock(-2))
print(halfUntil(12.0))
