// ir shadow: a ref list read whose element stays nullable keeps it, or recovers where the place is narrowed
// expect covered >= 2
// expect matched >= 2
// expect no row containing fail
type R = { v: i32 }
function firstV(xs: (R | null)[]) {
  const e = xs[0]
  if e != null { print(e.v) } else { print(-1) }
}
function narrowed(xs: (R | null)[]) {
  if xs[1] != null { print(xs[1].v) }
}
const a: (R | null)[] = [{ v: 3 }, null]
const c: (R | null)[] = [null, { v: 5 }]
firstV(a)
firstV(c)
narrowed(c)
