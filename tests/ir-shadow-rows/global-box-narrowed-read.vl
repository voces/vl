// ir shadow: a union-box global read narrowed to a record arm or a list arm unboxes the cell, as a local's narrowed read does
// expect covered >= 2
type A = { r: i32 }
type B = { s: string }
function src(): A | B { return { r: 3 } }
let x: A | B = src()
function rec(): string { if x is B { return x.s } else { return "a" } }
function mk(): i32[] | string { return [1, 2] }
let y: i32[] | string = mk()
function len(): i32 { if y is i32[] { return y.length } else { return 0 } }
print(rec())
print(len())
