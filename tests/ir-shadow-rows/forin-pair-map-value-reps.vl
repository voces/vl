// ir shadow: a for walk binding a map's value at a rep other than i32 or string: a float, a boolean, a record, a list, a closure, a union box, a nullable i32 and a nullable string
// expect matched >= 8
// expect start matched >= 1
// expect no row containing for in pair rep
type P = { x: i32, s: string }
function floats(m: {[string]: f64}): f64 {
  let t = 0.0
  for k, v in m { t = t + v }
  return t
}
function flags(m: {[string]: boolean}): i32 {
  let n = 0
  for k, v in m {
    if v { n += 1 }
  }
  return n
}
function records(m: {[string]: P}): i32 {
  let n = 0
  for k, v in m { n += v.x + v.s.length }
  return n
}
function lists(m: {[string]: i32[]}): i32 {
  let n = 0
  for k, v in m { n += v.length }
  return n
}
function calls(m: {[string]: (i32) => i32}): i32 {
  let n = 0
  for k, f in m { n += f(2) }
  return n
}
function boxes(m: {[string]: i32 | string}): i32 {
  let n = 0
  for k, v in m {
    if v is i32 { n += v } else { n += v.length }
  }
  return n
}
function nulInts(m: {[string]: i32 | null}): i32 {
  let n = 0
  for k, v in m {
    if v != null { n += v } else { n += 100 }
  }
  return n
}
function nulStrs(m: {[string]: string | null}): i32 {
  let n = 0
  for k, v in m { n += (v ?? "--").length }
  return n
}
function inc(x: i32): i32 { return x + 1 }
function tri(x: i32): i32 { return x * 3 }
const fm: {[string]: f64} = Map()
fm["a"] = 1.5
fm["b"] = 2.25
const bm: {[string]: boolean} = Map()
bm["a"] = true
bm["b"] = false
bm["c"] = true
const pm: {[string]: P} = Map()
pm["a"] = { x: 1, s: "ab" }
pm["b"] = { x: 2, s: "c" }
const lm: {[string]: i32[]} = Map()
lm["a"] = [1, 2]
lm["b"] = [3]
const cm: {[string]: (i32) => i32} = Map()
cm["a"] = inc
cm["b"] = tri
const um: {[string]: i32 | string} = Map()
um["a"] = 4
um["b"] = "xyz"
const ni: {[string]: i32 | null} = Map()
ni["a"] = 5
ni["b"] = null
const ns: {[string]: string | null} = Map()
ns["a"] = "xyz"
ns["b"] = null
print(nulInts(ni))
print(nulStrs(ns))
print(floats(fm))
print(flags(bm))
print(records(pm))
print(lists(lm))
print(calls(cm))
print(boxes(um))
for k, v in pm { print(k + v.s) }
