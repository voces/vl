// ir shadow: two shadow-arm is tests of different element types in one function store their empty lists in scratch locals in legacy's order, read non-null in their regions; a read before the test and one in a loop after it read the binding
// expect covered >= 2
// expect matched >= 2
// expect no row containing is empty fit shadow
function w<T>(t: T, b: boolean) {
  if b { return [t, t] }
  return [1, 2, 3]
}
function two<T>(t: T, b: boolean) {
  const v = w(t, b)
  const u = w(t, b)
  print(v.length)
  if v is i32[] { print(v.length) } else { print(0) }
  if u is i64[] { print(u.length + 100) } else { print(1) }
  let i = 0
  while i < 2 {
    print(v.length + 10)
    i = i + 1
  }
}
two(1.5, true)
two(1.5, false)
