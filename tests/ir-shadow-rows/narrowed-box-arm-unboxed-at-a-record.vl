// ir shadow: a union box narrowed to a record or nullable record arm is unboxed at a record
// destination: a return, an argument and a binding
// expect covered >= 5
// expect matched >= 5
// expect no row containing fail
type Circle = { r: i32 }
function g(w: Circle | null): i32 {
  if w == null { return 0 - 1 }
  return w.r
}
function h(w: Circle): i32 { return w.r }
function pick(e: Circle | null | string): Circle | null {
  if e is string { return null }
  return e
}
function arg(e: Circle | string) {
  if !(e is string) { print(h(e)) }
}
function bind(e: Circle | null | string) {
  if !(e is string) {
    const c: Circle | null = e
    print(g(c))
  }
}
print(g(pick({ r: 4 })))
print(g(pick("x")))
arg({ r: 5 })
arg("y")
bind({ r: 6 })
bind(null)
