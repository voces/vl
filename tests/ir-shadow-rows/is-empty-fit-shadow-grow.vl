// ir shadow: a pushing arm's is tests only until its grow row's empty list is stored, pushes onto it, and a length outside the arm reads it once filled; a length before the test fires the grow scan, and two grow rows in one function take legacy's scratch locals
// expect covered >= 2
// expect matched >= 2
// expect no row containing is empty fit shadow grow
function two<T, U>(a: T[]) {
  const q: U[] = []
  const r: U[] = []
  print(q.length)
  if q is f64[] { q.push(1.5) }
  if r is boolean[] { r.push(true) }
  print(q.length)
  print(r.length)
  print(a.length)
}
function g<V>(v: V[]) {
  if v is f64[] { v.push(1.5) }
  return v.length
}
two([1])
const e: i32[] = []
print(g(e))
print(e.length)
