// ir shadow: a spread copy of a list a generic function was pushed into, called through its element at one type
// expect covered >= 2
// expect matched >= 2
// expect no row containing rep ?
// expect no row containing mismatch
function id<T>(x: T): T { return x }
function f() {
  const xs = []
  xs.push(id)
  const ys = [...xs]
  print(ys[0](2))
}
f()
