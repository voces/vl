// ir shadow: a numeric global is initialised widened to its cell and the start body matches
// expect start covered = 1
// expect start matched = 1
function k(): i32 { return 5 }
const a: f64 = 3
const b: i64 = k()
const c: f32 = 2
const d: f64 = k() * 2
const e: i64 = -4
print(a + 0.5)
print(b + 1)
print(c)
print(d)
print(e)
