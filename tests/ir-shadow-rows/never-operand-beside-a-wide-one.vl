// ir shadow: an operator whose left never operand sits beside a non-i32 one is claimed at that width; a right one stays a named miss (D17064)
// expect no row containing rep novalue
function fail(): never { __trap__() }
function wide(c: boolean) {
  if c { return 2.5 }
  return fail() * 2.0
}
function rf(c: boolean, x: f64) {
  if c { return x }
  return x * fail()
}
function li(c: boolean, x: i64) {
  if c { return x }
  return fail() + x
}
function ri(c: boolean, x: i64) {
  if c { return x }
  return x - fail()
}
function cmpf(c: boolean, x: f64) {
  if c { return true }
  return x < fail()
}
print(rf(true, 2.5))
print(li(true, 5 as i64))
print(ri(true, 6 as i64))
print(cmpf(true, 1.0))
print(wide(true))
