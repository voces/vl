// ir shadow: an arm-site read through a name an `is` guard narrows to a narrower union of lists reads that name's box, as legacy's chain re-reads the name in each arm
// expect covered >= 3
// expect matched >= 3
// expect no row containing arm site operand
function mkT(k: i32): i32[] | f64[] | string {
  if k == 0 { return "s" }
  if k == 1 { return [2.5, 3.5, 4.5] }
  return [4, 5]
}
const len = (a) => if a is string { 0 } else { a.length }
print(len(mkT(2)))
print(len(mkT(1)))
print(len(mkT(0)))
function second(a) {
  if a is string { return 0.0 }
  return a[1] + 0.0
}
print(second(mkT(2)))
print(second(mkT(1)))
function count(a) {
  if a is string { return -1 }
  return a.length
}
print(count(mkT(1)))
print(count(mkT(0)))
