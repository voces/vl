// ir shadow: a nullable re-read recovering to a non-atom inner rep stays a named miss
// expect uncovered nullable read recover = 1
// expect no row containing fail
function nn(v: i32): i32 | null { return if v > 0 { v } else { null } }
function str() {
  let s: string | null = null
  nn(-1) ?? (s = "w").length
  print(s ?? "none")
}
str()
