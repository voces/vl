// ir shadow: a nullable re-read recovering to a non-atom inner rep is held at its non-null type
// expect covered >= 2
// expect matched >= 2
// expect no row containing nullable read recover
function nn(v: i32): i32 | null { return if v > 0 { v } else { null } }
function str() {
  let s: string | null = null
  nn(-1) ?? (s = "w").length
  print(s ?? "none")
}
str()
