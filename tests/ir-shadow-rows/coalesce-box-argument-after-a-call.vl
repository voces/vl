// ir shadow: a boxed binding's ?? argument after a call argument stages the call below its tag test
// expect matched >= 4
// expect no row containing short-circuit argument after another
// expect no row containing coalesce box after an operand
function show(n: i32, a: i32 | i64) {
  print(n)
  if a is i32 {
    print("i32")
    print(a)
  } else {
    print("i64")
    print(a)
  }
}
function two(): i32 {
  print("lead")
  return 2
}
function big(): i64 {
  print("default")
  return -9000000003
}
function run(q: i32 | null, b: i64) {
  show(two(), q ?? big())
  show(two(), q ?? b)
  show(2, q ?? b)
}
run(7, -9000000003)
run(null, -9000000003)
