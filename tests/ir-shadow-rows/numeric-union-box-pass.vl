// ir shadow: a numeric union passes into a union box as itself where no member widens
// expect covered >= 2
// expect matched >= 2
// expect no row containing box ladder
function kind<T>(v: T) {
  if v is i32 { return "i32" }
  if v is f64 { return "f64" }
  return "other"
}
function floats(q: f32 | null, r: f64 | null, b: f32) {
  print(kind((q ?? (r ?? b))))
}
floats(1.5, null, 0.5)
