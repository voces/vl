// ir shadow: a nullable record or string boxed into a union that admits null tests it once
// expect covered >= 3
// expect matched >= 3
// expect no row containing box ladder
// expect no row containing fail
type Err = { code: i32 }
type Ok = { v: i32 }
function show(y: Err | Ok | null) {
  print(y == null)
  print(y is Ok)
}
function pass(d: Ok | null) { show(d) }
pass(null)
pass({ v: 1 })
function bindStr(d: string | null) {
  const y: i32[] | string | null = d
  print(y == null)
}
bindStr(null)
