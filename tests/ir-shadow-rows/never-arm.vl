// ir shadow: a value `if` arm that never returns, and a tail arm past an exit, build through the IR
// expect covered >= 4
// expect matched >= 4
// expect no row containing dead tail arm
function die(): never { __trap__() }
function valued(c: boolean) {
  const v = if c { 7 } else { __trap__() }
  return v
}
function valuedCall(c: boolean) {
  const v = if c { 7 } else { die() }
  return v
}
function tailThen(c: boolean) { return if c { __trap__() } else { 8 } }
print(valued(true))
print(valuedCall(true))
print(tailThen(false))
