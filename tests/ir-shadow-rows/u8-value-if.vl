// ir shadow: a value if pushed onto a u8 list builds at i32 and matches
// expect covered >= 3
// expect no row containing uncovered
function hex(out: u8[], d: i32) {
  out.push(if d < 10 { 48 + d } else { 87 + d })
}
function flag(out: u8[], on: boolean) { out.push(if on { 1 } else { 0 }) }
function chain(out: u8[], k: i32) {
  out.push(if k > 0 { k + 299 } else if k < 0 { 7 } else { 9 })
}
const o: u8[] = []
hex(o, 12)
flag(o, true)
chain(o, 1)
print(o[0] + o[1] + o[2])
