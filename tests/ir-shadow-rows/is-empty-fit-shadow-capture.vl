// ir shadow: a shadow-arm is whose name a closure in the same function reads builds: the closure's read is its own function's, and the outer env capture reads the binding
// expect covered >= 2
// expect matched >= 2
// expect no row containing is empty fit shadow
function s<T, U>(a: T[]) {
  const q: U[] = []
  if q is f64[] {
    const k = () => q.length + 10
    print(k())
  }
  print(a.length)
}
s([1])
