// ir shadow: a boolean | null boxed into a wider union is tested on its value and boxed as its niche
// expect covered >= 3
// expect matched >= 3
// expect no row containing box ladder
// expect no row containing fail
function show(y: boolean | i32 | null) {
  if y == null { print("null") }
  else if y is boolean { print(y) }
  else { print(y + 1) }
}
function pass(d: boolean | null) { show(d) }
function bind(d: boolean | null) {
  const k: boolean | string | null = d
  if k == null { print("null") }
  else if k is boolean { print(k) }
  else { print(k) }
}
pass(true)
pass(null)
show(4)
bind(false)
bind(null)
