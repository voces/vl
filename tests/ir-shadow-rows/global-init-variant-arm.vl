// ir shadow: a bare-arm global initialised by a record literal takes the arm row, and the start body matches
// expect start covered >= 1
// expect start matched >= 1
// expect no row containing global initializer variant
type Node = { v: i32, next: Node | null } | { e: i32 }
function sumNode(n: Node | null) {
  if n == null { return 0 }
  if n is { e: i32 } { return n.e * 100 }
  return n.v + sumNode(n.next)
}
const a = { v: 3, next: { e: 1 } }
let b = { v: 3, next: { e: 1 } }
b = a
const v = b
print(sumNode(v))
const c = { v: 3, next: { v: 2, next: { e: 1 } } }
let d = { v: 3, next: { v: 2, next: { e: 1 } } }
d = c
const w = d
print(sumNode(w))
print(sumNode(b))
