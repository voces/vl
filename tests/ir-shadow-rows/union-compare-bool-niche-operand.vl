// ir shadow: a boolean | null operand against a union with no null arm compares its niche and matches
// expect covered >= 7
// expect no row containing uncovered
type UB = i32 | boolean
type H = { b: boolean | null }
let gb: boolean | null = null
function byParam(u: UB, k: boolean | null) { return u == k }
function byParamL(u: UB, k: boolean | null) { return k == u }
function byField(u: UB, h: H) { return u == h.b }
function byFieldNe(u: UB, h: H) { return h.b != u }
function byGlobal(u: UB) { return u == gb }
function byLocal(u: UB, h: H) {
  const k = h.b
  return u == k
}
// One line per box value: the operand null, true, then false, at each position.
function row(u: UB) {
  const hs: H[] = [{ b: null }, { b: true }, { b: false }]
  const ks: (boolean | null)[] = [null, true, false]
  let line = ""
  for i in 0 until 3 {
    gb = ks[i]
    const cells = [byParam(u, ks[i]), byParamL(u, ks[i]), byField(u, hs[i]), byFieldNe(u, hs[i]), byGlobal(u), byLocal(u, hs[i])]
    for c in cells { line = line + (if c { "T" } else { "f" }) }
    line = line + " "
  }
  print(line)
}
row(true)
row(false)
row(1)
