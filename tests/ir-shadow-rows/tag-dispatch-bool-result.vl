// ir shadow: a call through a tagged function set whose result is a boolean builds through the IR
// expect covered >= 4
// expect matched >= 4
// expect no row containing tag dispatch result
function pos(x) { return x > 0 }
function neg(x) { return x < 0 }
function test(f) { return f(3) }
function pick(c: boolean) {
  const f = if c { pos } else { neg }
  return f(3)
}
print(test(pos))
print(test(neg))
print(pick(true))
