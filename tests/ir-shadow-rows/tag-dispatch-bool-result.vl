// ir shadow: a call through a tagged function set whose result is a boolean builds through the IR
// expect covered >= 4
// expect matched >= 4
// expect no row containing tag dispatch result
function same<T>(k: T): T { return k }
function flag(a) { return a(true) }
function both(a) {
  print(a(1))
  return a(false)
}
print(flag(same))
print(both(same))
