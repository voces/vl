// ir shadow: a literal arm whose receiver is a temp is built where legacy reads it once: one member, or a box test it stashes
// expect covered >= 4
type K = "a" | "b"
type J = "a"
function kOf(n: i32): K { return if n > 0 { "a" } else { "b" } }
function one(n: i32): boolean { return kOf(n) is J }
function boxOf(n: i32): string | i32 { return if n > 0 { "a" } else { 3 } }
function stashed(n: i32): boolean { return boxOf(n) is "a" }
print(one(1))
print(one(0))
print(stashed(1))
print(stashed(0))
