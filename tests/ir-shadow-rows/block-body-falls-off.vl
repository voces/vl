// ir shadow: a block body that falls off its last statement builds and matches
// expect covered >= 5
// expect matched >= 5
let n = 0
const xs: i32[] = []
function bump(k: i32) { n = n + k }
function a(x: i32) {
  if x > 2 { return 1 }
  n = n + x
}
function s(x: i32) {
  if x > 2 { return "big" }
  bump(x)
}
function c(x: i32) {
  if x > 0 { return x * 2 }
  xs.push(x)
}
function d(x: i32) {
  if x > 0 { return true }
  const y = x + 1
}
print(a(1))
print(s(4))
print(c(-4))
print(d(0))
