// ir shadow: a for iterable of signed number literals builds each as one immediate
// expect covered = 2
// expect matched = 2
// expect no row containing for iterable element
function ints() {
  for x in [1, -2, -(3)] { print(x) }
}
function floats() {
  for x in [0.5, -0.6, -1e10] { print(x) }
}
ints()
floats()
