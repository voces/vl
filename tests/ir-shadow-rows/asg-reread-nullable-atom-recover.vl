// ir shadow: an assignment's re-read of a K | null local recovers at the member type
// expect covered >= 2
// expect no row containing fail
type K = "ww" | "zz"
function pick(b: boolean): K { return if b { "ww" } else { "zz" } }
function fromCall(b: boolean) {
  let k: K | null = null
  return k = pick(b)
}
print(fromCall(false))
