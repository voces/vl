// ir shadow: a K | null local narrowed to one member passes its atom cell to an atom destination
// expect covered >= 2
// expect matched >= 2
// expect no row containing narrowed read
type VK = "str" | "map" | "i32" | "list"
function sig(i: i32): VK | null { if i == 0 { return null } if i == 1 { return "str" } return "i32" }
function wk(i: i32): VK | null {
  const k = sig(i)
  if k == null { return null }
  if k == "str" { return k }
  return "list"
}
print(wk(1) ?? "none")
