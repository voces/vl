// ir shadow: a narrowed record arm stored into a union-valued map boxes on legacy's union arm
// expect covered >= 1
// expect matched >= 1
// expect no row containing map store value unbox
type A = { a: i32 }
type B = { b: string }
type R = A | B
type S = { m: {[i32]: R} }
function put(s: S, ix: i32, x: i32) {
  const gr: R = { a: x }
  s.m[ix] = gr
  return 0
}
const s: S = { m: Map() }
put(s, 1, 5)
const r = s.m.get(1)
if r is A { print(r.a) }
