// ir shadow: an order-stashed literal argument with a valued if after a variable argument
// expect covered >= 3
// expect matched >= 3
// expect no row containing short-circuit argument after another
type XF = { xfList: i32, xfVar: i32, xfMap: i32, xfMapNonNull: boolean }
function rec(i: i32): boolean { return i > 2 }
function node(b: i32[], r: XF, k: i32): i32 { b.push(r.xfList + k + r.xfVar); return b.length }
function f(b: i32[], mr: i32, g: i32): i32 {
  return node(
    b,
    {
      xfList: mr,
      xfVar: g,
      xfMap: g,
      xfMapNonNull: mr >= 0 && rec(mr),
    },
    -1,
  )
}
print(f([], 3, 4))
