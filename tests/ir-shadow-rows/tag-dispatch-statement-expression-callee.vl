// ir shadow: a tagged call builds as legacy's dispatch whatever its callee expression
// expect covered >= 26
// expect matched >= 26
// expect no row containing index valued-if operand
// expect no row containing expression if int match
// expect no row containing tag dispatch callee expression
// expect no row containing fail
function inner<U>(u: U) {
  print("I")
  print(u)
}
function other<V>(v: V) {
  print("O")
  print(v)
}
function constant() {
  const fs = [inner, other]
  fs[0](1)
  fs[1](2)
}
function computed(i: i32) {
  const fs = [inner, other]
  fs[i](3)
}
function ifIndex(c: boolean) {
  const fs = [inner, other]
  fs[if c { 0 } else { 1 }](4)
}
function field() {
  const r = { fs: [inner, other] }
  r.fs[1](5)
}
function mk() { return [inner, other] }
function returned() { mk()[0](6) }
function cell() {
  let k = inner
  const g = () => {
    k = other
  }
  g()
  k(7)
}
function generic<T>(x: T) {
  const fs = [inner, other]
  fs[1](x)
}
function notLast() {
  const fs = [inner, other]
  fs[0](8)
  print(0)
}
function pick(c: boolean) { return if c { inner } else { other } }
function ifCallee(c: boolean) { (if c { inner } else { other })(1) }
function callCallee(c: boolean) { pick(c)(2) }
function matchCallee(n: i32) {
  const fs = [inner, other]
  fs[match n {
    0 => 0
    _ => 1
  }](3)
}
function nestedList() {
  const fss = [[inner, other]]
  fss[0][1](4)
}
function id<T>(t: T): T { return t }
function twice<T>(t: T): T { return t }
function valuedIndex() {
  const fs = [id, twice]
  print(fs[1](10))
}
function valuedCell() {
  let k = id
  const g = () => {
    k = twice
  }
  g()
  print(k(11))
}
function valuedField() {
  const r = { fs: [id, twice] }
  const v = r.fs[0](12)
  print(v)
}
constant()
computed(1)
ifIndex(true)
ifIndex(false)
field()
returned()
cell()
generic(9)
generic("s")
notLast()
ifCallee(true)
ifCallee(false)
callCallee(true)
callCallee(false)
matchCallee(0)
nestedList()
valuedIndex()
valuedCell()
valuedField()
