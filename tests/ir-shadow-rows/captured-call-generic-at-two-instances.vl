// ir shadow: a capturing nested generic instanced at two types is called through a closure of its instance's own reps, and matches
// expect covered >= 3
// expect matched >= 3
// expect no row containing captured call closure rep
// expect no row containing mismatch
function valueArm(x: i32) {
  function inner<U>(u: U, n: i32) {
    return if n > 0 { inner(u, n - 1) } else { x + n }
  }
  print(inner(1, 2))
  print(inner("s", 0) + 1)
}
valueArm(7)
