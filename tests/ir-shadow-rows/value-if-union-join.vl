// ir shadow: a value if joined at a union box builds per arm; an else-if link at another join is a named miss
// expect covered >= 1
// expect matched >= 1
// expect uncovered union if chain join = 1
// `argPre`'s join boxes each arm into `U` (`emitUnionIfValue`); `arg`'s inner link plans a scalar join of
// its own, which legacy still writes at the head's box.
type U = i32 | string
function show(u: U | null) {
  if u == null { return "null" }
  if u is string { return u }
  return "int"
}
function arg(c: i32) {
  print(show(if c > 1 { "big" } else if c > 0 { c } else { 0 }))
}
function argOpt(c: boolean) { print(show(if c { "on" })) }
function argPre(c: i32) {
  print(
    show(
      if c > 5 {
        const t = c * 2
        t
      } else {
        "small"
      },
    ),
  )
}
arg(2)
arg(1)
argOpt(true)
argOpt(false)
argPre(9)
argPre(1)
