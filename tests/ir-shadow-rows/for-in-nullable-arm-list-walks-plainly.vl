// ir shadow: a walk over a nullable union-arm list binds the nullable arm along legacy's plain walk
// expect matched >= 1
// expect start matched >= 1
// expect no row containing for in element nulvariant
// expect no row containing fail
// `forInElemPlain`'s `nulvariant`: the element is read at the arm's nullable record, as
// `nulstruct` is.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function show(z: (Circle | null)[]) {
  for e in z {
    if e == null { print(0 - 1) } else { print(e.r) }
  }
}
const z: (Circle | null)[] = [{ r: 4 }, null]
show(z)
for e in z {
  if e != null { print(e.r) }
}
