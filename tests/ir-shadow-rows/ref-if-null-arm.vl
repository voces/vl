// ir shadow: a reference join's bare null arm builds as the join's typed null
// expect covered >= 2
// expect matched >= 2
// expect no row containing ref if arm null
// expect no row containing mismatch
type R = { et: i32, nul: boolean }

let g: R | null = null

function rowOf(k: i32): R { return { et: k, nul: false } }

function setG(c: boolean, k: i32): i32 {
  const row = rowOf(k)
  g = if c { row } else { null }
  const x = g
  if x != null { return x.et }
  return -1
}

print(setG(true, 5))
print(setG(false, 6))
