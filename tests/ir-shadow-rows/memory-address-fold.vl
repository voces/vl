// ir shadow: a `const` address legacy folds keeps its bounded part in the fold's scratch local,
// teed at the declaration, and every access through it reads that local at the folded offset
// expect no row containing memory address fold
// expect matched >= 3
const D = 1024
function once(x: i32) {
  const p = D + (x & 1023) * 8
  __store_i64__(p, 555)
  return __load_i64__(p) as% i32
}
function unread(x: i32) {
  const p = D + (x & 1023) * 8
  return x
}
function twice(x: i32) {
  const p = D + (x & 255) * 4
  __store_i32__(p, 7)
  return __load_i32__(p) + __load_i32__(p, 0)
}
print(once(37))
print(unread(3))
print(twice(9))
