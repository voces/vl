// ir shadow: a nullable map coalesced into a wider map that stores alike is that map as it stands
// expect covered >= 1
// expect matched >= 1
// expect no row containing coalesce nulRef result rep
// expect no row containing fail
function pick(m: {[string]: string} | null, d: {[string]: string | null}, k: string) {
  const x = m ?? d
  print(x.length)
  print(x.has(k))
}
const a: {[string]: string} = Map()
a["k"] = "v"
const w: {[string]: string | null} = Map()
pick(a, w, "k")
pick(null, w, "k")
