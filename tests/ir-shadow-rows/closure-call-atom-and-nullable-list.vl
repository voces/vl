// ir shadow: a function value called with a literal-union atom at a string parameter, and a scalar list at a nullable list parameter, non-null and nullable
// expect matched >= 5
// expect no row containing call of a non-declaration
type K = "ab" | "cde"
function viaStr(f: (s: string) => i32, k: K): i32 { return f(k) }
function viaNulStr(f: (s: string | null) => i32, k: K): i32 { return f(k) }
function viaF64(f: (xs: f64[] | null) => i32, xs: f64[]): i32 { return f(xs) }
function viaF64N(f: (xs: f64[] | null) => i32, xs: f64[] | null): i32 {
  return f(xs)
}
function viaU8(f: (xs: u8[] | null) => i32, xs: u8[]): i32 { return f(xs) }
const slen = (s: string): i32 => s.length
const nslen = (s: string | null): i32 => if s == null { -1 } else { s.length }
const flen = (xs: f64[] | null): i32 => if xs == null { -1 } else { xs.length }
const blen = (xs: u8[] | null): i32 => if xs == null { -1 } else { xs.length }
const k: K = "cde"
const fs: f64[] = [1.5, 2.5]
const nfs: f64[] | null = fs
const bs: u8[] = [1, 2, 3]
print(viaStr(slen, k))
print(viaNulStr(nslen, "ab"))
print(viaF64(flen, fs))
print(viaF64N(flen, nfs))
print(viaU8(blen, bs))
