// ir shadow: a captured binding held as the atom, read at a string at each delivery position but
// interpolation, which this harness cannot compile, decodes the captured atom (Q58 sweep)
// expect no row containing capture binding
// expect no row containing fail
const A = "x"
const B = "y"
function takeS(s: string) { return s.length }
function takeU(p: i32 | string) { return if p is string { p.length } else { p } }
function id<T>(t: T): T { return t }
function main(c: boolean) {
  const M = if c { A } else { B }
  const ret = () => M
  const cat = () => "a" + M
  const argS = () => takeS(M)
  const argU = () => takeU(M)
  const nested = () => takeS(id(M))
  const letInit = () => {
    const s: string = M
    return s
  }
  const ifArm = () => if c { M } else { "w" }
  const coal = () => {
    const n: string | null = M
    return n ?? "z"
  }
  const field = () => {
    const r: { k: string } = { k: M }
    return r.k
  }
  print(ret())
  print(cat())
  print(argS())
  print(argU())
  print(nested())
  print(letInit())
  print(ifArm())
  print(coal())
  print(field())
}
main(true)
main(false)
