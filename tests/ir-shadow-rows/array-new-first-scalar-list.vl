// ir shadow: an `__array_new__` that is its program's first f64 list builds without minting its pair
// expect covered >= 1
// expect matched >= 1
// expect no row containing fail
function f(n: i32) {
  const xs = [1, 2, 3]
  print(xs.length)
  const a = __array_new__(n, 1.5)
  print(a.length)
}
f(2)
