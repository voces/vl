// ir shadow: v is B over record arms whose values cross rows, legacy's variant chain tail with each receiver read the IR's box variable
// expect covered >= 2
// expect no row containing variant row chain
// expect no row containing variant shape
// expect no row containing fail
type A = { x: i32 }
type B = { x: 1 | 2 }
type C = { x: 3 | 4 }
function f(v: A | B) {
  if v is B { return "B" }
  return "A"
}
function g(v: C | B) {
  if v is B { return "B" }
  return "C"
}
const a: A = { x: 1 }
print(f(a))
const b: A = { x: 7 }
print(f(b))
const c: C = { x: 3 }
print(g(c))
