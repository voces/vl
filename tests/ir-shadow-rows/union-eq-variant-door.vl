// ir shadow: a union compare against a record takes legacy's variant door (unionEqVariantRowOf)
// expect covered >= 3
// expect matched >= 3
// The record operand plain, nullable, and on the left; the box read once, the record once.
type P = { x: i32 }
type U = P | i32
type N = P | i32 | null
function eqP(u: U, p: P) { return u == p }
function eqN(u: N, p: P | null) { return u == p }
function neL(u: U, p: P) { return p != u }
print(eqP({ x: 1 }, { x: 1 }))
print(eqP(3, { x: 1 }))
print(eqN(null, null))
print(eqN({ x: 2 }, null))
print(neL({ x: 1 }, { x: 2 }))
