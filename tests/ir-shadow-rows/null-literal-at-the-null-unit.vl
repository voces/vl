// ir shadow: a null literal at the null unit is the bottom ref (statement, dead tail, hole argument)
// expect covered >= 4
// expect matched >= 4
// expect no row containing expression null
// A bare `null` naming no null of its own is `ref.null none`, as legacy's `emitNullAt` writes it.
function f() {
  null
  return 0
}
print(f())
function deadNull(_k: i32): string {
  return "a"
  null
}
print(deadNull(1))
function orz<T>(v: T | null, d: T): T { return v ?? d }
function via(a) { print(a(null, 3)) }
via(orz)
