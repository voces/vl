// ir shadow: a union box narrowed to a list's, closure's or map's `A | null` reads as that niche
// expect matched >= 7
// expect no row containing narrowed read niche
// expect no row containing fail
// Legacy's own niche tail (`emitNicheReadTail`) writes each: the null tag is the niche's null,
// any other arm the payload cast to `A`. The scalar niches are the controls.
type F = (a: i32) => i32
type M = {[string]: i32}
type UL = i32[] | null | string
type UF = F | null | string
type UM = M | null | i32
type US = string | null | i32
function listLen(u: UL) {
  if u is string { return 0 - 2 }
  const l = u
  return if l == null { 0 - 1 } else { l.length }
}
function listArg(u: UL) {
  if u is string { return 0 - 2 }
  return lenOf(u)
}
function lenOf(l: i32[] | null) {
  return if l == null { 0 - 1 } else { l.length }
}
function closureCall(u: UF) {
  if u is string { return 0 - 2 }
  const c = u
  return if c == null { 0 - 1 } else { c(3) }
}
function mapLen(u: UM) {
  if u is i32 { return 0 - 2 }
  const m = u
  return if m == null { 0 - 1 } else { m.length }
}
function strCtrl(u: US) {
  if u is i32 { return "i" }
  const s = u
  return s ?? "n"
}
const mm: M = Map()
mm["a"] = 1
print(listLen([1, 2]))
print(listLen(null))
print(listLen("s"))
print(listArg([4]))
print(listArg(null))
print(closureCall((a: i32) => a + 1))
print(closureCall(null))
print(closureCall("s"))
print(mapLen(mm))
print(mapLen(null))
print(mapLen(7))
print(strCtrl("s"))
print(strCtrl(null))
