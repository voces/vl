// ir shadow: a union compare whose operand holds null takes legacy's null leg (unionEqNulPlanOf)
// expect covered >= 5
// expect matched >= 5
// A `boolean | null` operand against a union with `null`, and a `string | null` operand against a
// union with and without it, each side and `!=`.
type B = i32 | boolean | null
type S = i32 | string
type SN = i32 | string | null
function bEq(u: B, k: boolean | null) { return u == k }
function bNe(u: B, k: boolean | null) { return k != u }
function sEq(u: S, k: string | null) { return u == k }
function snEq(u: SN, k: string | null) { return k == u }
function snNe(u: SN, k: string | null) { return u != k }
print(bEq(null, null))
print(bEq(true, null))
print(bNe(true, true))
print(sEq("a", null))
print(sEq("a", "a"))
print(snEq(null, null))
print(snNe(1, "a"))
