// ir shadow: a list literal typed as a ref-list arm of its union is boxed as itself under that arm
// expect covered >= 3
// expect matched >= 3
// expect no row containing box ladder
// expect no row containing fail
type Json = null | boolean | f64 | string | Json[] | { [string]: Json }
function count(c: Json): i32 {
  if c is Json[] { return c.length }
  return 0
}
function one() { print(count([2.5])) }
function two() { print(count([[1.5]])) }
function strs() { print(count(["a", "b"])) }
one()
two()
strs()
