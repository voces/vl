// ir shadow: a shared scalar let's writer boxes its value into the T | null cell at the site's union
// expect covered >= 5
// expect matched >= 5
// expect no row containing store element
// `idxStoreSiteBoxes`: a value owing no box is boxed at the cell's union, as legacy's
// `emitUnionBoxArg` writes it.
function goI(k: i32) {
  let u: i32
  const set = (x: i32) => {
    u = x
  }
  const get = () => u
  set(k)
  print(get())
  set(9)
  print(get())
}
goI(7)
function goF(k: f64) {
  let u: f64
  const set = (x: f64) => {
    u = x
  }
  const get = () => u
  set(k)
  print(get())
  set(2.5)
  print(get())
}
goF(1.5)
