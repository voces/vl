// ir shadow: a choice of functions kept as its set's id in a module global, read at a closed function type
// expect covered >= 5
// expect matched >= 5
// expect no row containing global read coercion
function inc0(a) { return a + 1 }
function dbl0(a) { return a * 2 }
function apply(f: (x: i32) => i32) { return f(4) }
const b = true
const fs = [dbl0]
const g = if b { inc0 } else { dbl0 }
fs.push(g)
print(fs[1](5))
const h: (x: i32) => i32 = g
print(h(2))
print(apply(g))
