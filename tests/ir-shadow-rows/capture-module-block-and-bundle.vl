// ir shadow: a start body's closure over a module-block local, and bundles captured whole
// expect covered >= 3
// expect matched >= 3
// expect no row containing closure env capture
// expect no row containing bundle callee
// The module block's `rd` captures its local `p` (`ibStartRoots`). `lap`'s untyped `f` is called at
// two signatures, so it is a bundle record: `h` captures it whole and calls through it (`capTyOf`,
// `bundleCaptureRead`), and `r` holds the bundle `lap` returns, which `j` captures.
type P = { x: i32 }
if true {
  const p: P = { x: 7 }
  const rd = () => p.x
  print(rd())
}
function lap(f) {
  print(f(3))
  const h = () => f(2.5)
  print(h())
  return f
}
function holds(k: i32) {
  const r = lap((a) => a + k)
  const j = () => r(4)
  print(j())
}
holds(1)
