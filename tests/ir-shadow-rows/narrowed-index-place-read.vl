// ir shadow: a field read off an element narrowed through its index place is the element re-read
// at its storage box, then the narrowed arm's field, as legacy's `emitNarrowedMem` writes it
// expect no row containing member record
// expect matched >= 1
type A = { r: i32 }
type M = i32 | A
function f(xs: M[]) {
  if xs[0] is A { print(xs[0].r) } else { print(0) }
}
f([{ r: 5 }])
f([7])
