// ir shadow: a union binding's if arm with a prelude matches, sinking and seeded
// expect covered = 2
// expect matched = 2
// Each arm's statements before its value are written as legacy's `emitIfArmOpen` writes them, then
// the value goes into the sink pair or the seeded box.
type U = i32 | string
function pre(c: i32): U {
  const r: U = if c > 1 {
    const t = c * 2
    t + 1
  } else {
    "small"
  }
  return r
}
function seeded(b: boolean, v: U, w: U): boolean {
  const u = if b {
    const x = v
    x
  } else {
    w
  }
  return u is i32
}
const p = pre(3)
if p is i32 { print(p) }
print(seeded(true, 1, "y"))
