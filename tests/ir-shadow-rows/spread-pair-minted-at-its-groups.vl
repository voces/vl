// ir shadow: a spread literal whose list pair is unminted when built is minted before its groups
// expect covered >= 4
// expect matched >= 4
// expect no row containing fail
function idh(v) { return v }
function t<T>(x: T) {
  const n = idh(
    [...[x]].map((e) => {
      if e != null { return e }
      return null
    }),
  )
  for y in n { print(y) }
}
const a: i32 = 4
t(a)
