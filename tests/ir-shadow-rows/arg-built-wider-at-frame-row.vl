// ir shadow: a record built wider at its delivery, handed to an identity instance that holds it at
// legacy's declared row
// expect no row containing argument coercion
// expect start covered >= 1
// expect start matched >= 1
// `mkcall()` is built as `Circle`; `id`'s frame holds its parameter at that row (`paramFrameTy`),
// and the call delivers it there.
type Circle = { r: i32 | null }
function sink(x: Circle) { print(x.r ?? 9) }
function id(x) { return x }
function id2(x) {
  const y = x
  return y
}
function mkcall() { return { r: null } }
sink(mkcall())
const y = id(mkcall())
print(y.r ?? 3)
print(id(mkcall()).r ?? 4)
const z = id2(id(mkcall()))
print(z.r ?? 5)
const z2 = id2(mkcall())
print(z2.r ?? 7)
