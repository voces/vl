// ir shadow: a bundle parameter called at two signatures and returned whole builds as its record
// expect covered >= 3
// expect matched >= 3
// expect no row containing open parameter type
// expect no row containing bundle parameter read
// expect no row containing mismatch
function lap(f) {
  print(f(2.5))
  print(f(3))
  return f
}
function twice(g) {
  g(1.5)
  g(2)
  return g
}
function g(n: i32) { print(n) }
const k = lap((a) => a + 1)
print(k(3))
const t = twice((a) => a * 2)
print(t(4))
g(1)
