// ir shadow: a list copy and a box retag build as RCoerce over legacy's tail and match
// expect covered >= 4
// expect matched >= 4
// expect no row containing pre-path coercion
// expect no row containing fail
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function copied(): Circle[] {
  const lv1 = [{ r: 7 }]
  const cU: Shape[] = lv1
  print(cU.length)
  return lv1
}
function kind<T>(v: T) {
  if v is i32 { return "i32" }
  if v is i64 { return "i64" }
  if v is f32 { return "f32" }
  if v is f64 { return "f64" }
  return "other"
}
function retagged(q: f32 | null, b: f64) {
  const o = { v: q ?? b }
  print(o.v)
  print(kind(o.v))
  print("<\{o.v}>")
}
print(copied().length)
retagged(1.5, 6.75)
retagged(null, 6.75)
