// ir shadow: a range loop over a hoisted list header, rolled, with a continue, unrolled and partial; a range proven over its list's length; a for walk over a list of closures
// expect covered >= 9
// expect matched >= 9
// expect no row containing for range hoisted
// expect no row containing for range proven
// expect no row containing for in element closure
function rolled(xs: i32[], n: i32): i32 {
  let s = 0
  for i in 0 until n { s += xs.length + i }
  return s
}
function skips(xs: i32[], n: i32): i32 {
  let s = 0
  for i in 0 until n {
    if i == 1 { continue }
    s += xs.length
  }
  return s
}
function unrolled(xs: i32[]): i32 {
  let s = 0
  for i in 0 until 3 { s += xs.length * i }
  return s
}
function proven(xs: i32[]): i32 {
  let s = 0
  for i in 0 until xs.length { s += xs[i] }
  return s
}
function nested(xs: i32[]): i32 {
  let s = 0
  for i in 0 until xs.length {
    for j in 0 until xs.length { s += xs[i] * xs[j] }
  }
  return s
}
function fill(xs: i32[]): i32 {
  for i in 0 until xs.length { xs[i] = i + 1 }
  return xs[0] + xs[2]
}
function calls(fs: ((n: i32) => i32)[]): i32 {
  let s = 0
  for f in fs { s += f(s + 1) }
  return s
}
print(rolled([1, 2], 3))
print(skips([1, 2, 3], 4))
print(unrolled([1, 2]))
print(proven([1, 2, 3]))
print(nested([1, 2, 3]))
print(fill([0, 0, 0]))
print(calls([(n: i32) => n * 2, (n: i32) => n + 3]))
