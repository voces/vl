// ir shadow: a function-value compare legacy writes on its closure route builds through RClosureEq
// expect covered >= 7
// expect matched >= 7
// expect no row containing operand type
function exclaim(s) { return s + "!" }
function two<T>(x: T): i32 { return 1 }
function one(x: i32): i32 { return 1 }
const on = [1].length == 1
function calledThenCompared(p) {
  print(p("e"))
  return p === exclaim
}
function sameGeneric(): boolean { return one === two }
function inGeneric<U>(u: U): boolean {
  const s: (x: boolean) => i32 = two
  print(s(true))
  return one === two
}
print(calledThenCompared(if on { exclaim } else { exclaim }))
print(sameGeneric())
print(inGeneric(3))
