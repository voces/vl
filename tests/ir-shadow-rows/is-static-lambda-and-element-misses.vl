// ir shadow: a static is in a lambda, or over an element read, stays a named miss
// expect uncovered is static in a lambda >= 1
// expect uncovered is static receiver place = 1
function lam<T>(v: T): boolean {
  const g = () => v is T
  return g()
}
function a32(x) {
  const xs = [x, x + 1.5]
  print(xs[1] is f32)
}
print(lam(2))
a32(1.25 as f32)
