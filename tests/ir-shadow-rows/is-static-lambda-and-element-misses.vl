// ir shadow: a static is in a lambda, or over an element read, is decided at emitIs's prim pre-arm, a named miss
// expect uncovered is pre-arm prim = 2
function lam<T>(v: T): boolean {
  const g = () => v is T
  return g()
}
function a32(x) {
  const xs = [x, x + 1.5]
  print(xs[1] is f32)
}
print(lam(2))
a32(1.25 as f32)
