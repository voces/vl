// ir shadow: a call through a tagged function set whose result is a union builds through the IR
// expect covered >= 4
// expect matched >= 4
// expect no row containing tag dispatch result union
function twice(s) { return s + s }
function lenOf(s) { return s.length }
function shout(s) { return s + "!" }
function main() {
  const fs = [twice]
  fs.push(lenOf)
  fs.push(shout)
  for g in fs { print(g("ab")) }
}
main()
