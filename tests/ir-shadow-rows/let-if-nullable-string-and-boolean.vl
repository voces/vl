// ir shadow: a string | null and a boolean | null binding's if writes each arm and matches
// expect covered = 2
// expect matched = 2
// `letIfInitRep` 1 and 2: no seed, each arm's value into the binding, and a missing `else`'s
// `ref.null` string or niche 2.
type K = "a" | "b"
function str(c: i32, k: K) {
  const s: string | null = if c > 1 { "big" } else if c > 0 { k }
  return s ?? "none"
}
function flag(c: i32) {
  const f: boolean | null = if c > 0 { c > 5 }
  return if f == null { "unset" } else if f { "high" } else { "low" }
}
print(str(2, "a"))
print(str(1, "b"))
print(str(0, "a"))
print(flag(9))
print(flag(1))
print(flag(0))
