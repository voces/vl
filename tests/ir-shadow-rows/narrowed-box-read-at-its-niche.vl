// ir shadow: a union box narrowed to a `string | null` or `boolean | null` niche reads at that niche
// expect covered >= 3
// expect matched >= 3
// expect no row containing fail
function pickS(k: i32): string | i32 | null {
  if k == 0 { return null }
  if k == 1 { return "s" }
  return 3
}
function pickB(k: i32): boolean | i32 | null {
  if k == 0 { return null }
  if k == 1 { return true }
  return 3
}
function take(s: string | null) { print(s ?? "none") }
function takeB(s: boolean | null) { print(s ?? false) }
function f(k: i32) {
  const x = pickS(k)
  if !(x is i32) { take(x) }
  const y = pickB(k)
  if !(y is i32) { takeB(y) }
}
f(1)
f(0)
