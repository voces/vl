// ir shadow: a `let x = null` read before its fill is the destination's null, or its storage's
// expect covered >= 3
// expect matched >= 3
// expect no row containing fail
function link2<T>(xs: T[], v: T) { xs.push(v) }
function other() {
  let x = null
  const y: string | null = x
  x = 5
  print(y == null)
  print(x ?? 0)
}
function same() {
  const xs: (string | null)[] = []
  let x = null
  link2(xs, x)
  x = "t"
  xs.push(x)
  print(xs.length)
}
other()
same()
