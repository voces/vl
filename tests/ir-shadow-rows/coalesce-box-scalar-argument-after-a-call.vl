// ir shadow: a boxed binding's ?? argument at a scalar after a call argument stages the call below its tag test
// expect matched >= 4
// expect no row containing short-circuit argument after another
// expect no row containing coalesce box after an operand
function s(n: i32, a: i32) {
  print(n)
  print(a)
}
function sf(n: i32, a: f64) {
  print(n)
  print(a)
}
function two(): i32 {
  print("lead")
  return 2
}
function five(): i32 {
  print("default")
  return 5
}
function run(q: i32 | null, f: f64 | null) {
  s(two(), q ?? five())
  s(2, q ?? 5)
  sf(two(), f ?? 1.5)
}
run(7, 2.5)
run(null, null)
