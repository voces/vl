// ir shadow: a `??` over an assignment of `null` is its default, the store run first, in the IR as in legacy
// expect matched >= 3
// expect no row containing fail
// expect no row containing mismatch
// expect no row containing uncovered
function local() {
  let n: string | null = "x"
  print((n = null) ?? "d")
}
function field() {
  const o: { f: string | null } = { f: "x" }
  print((o.f = null) ?? "d")
}
function num() {
  let k: i32 | null = 3
  print((k = null) ?? 7)
}
local()
field()
num()
