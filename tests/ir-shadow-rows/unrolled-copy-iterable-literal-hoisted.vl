// ir shadow: a `for` iterable literal of a range variable in a fully unrolled copy reads the
// module constant list legacy hoists for that copy, its variable bound to the copy's constant
// expect covered >= 1
// expect matched >= 1
// expect no row containing mismatch
// expect no row containing fail
function a() {
  let s = ""
  for i in 0 until 3 {
    s = s + "w"
    for x in [i, i] { s = s + "." }
  }
  print(s)
}
a()
