// ir shadow: xs is L[] over a list of wider elements on the listFit rung, built over legacy's walk
// expect covered >= 2
// expect no row containing is rung
// expect no row containing fail
type Dir = "n" | "s"
function allDirs(xs: string[]) {
  if xs is Dir[] { return "dirs" }
  return "other"
}
function allSmall(xs: i32[]) {
  if xs is (1 | 2)[] { return "small" }
  return "big"
}
print(allDirs(["n", "s"]))
print(allDirs(["n", "e"]))
print(allSmall([1, 2, 1]))
print(allSmall([1, 3]))
