// ir shadow: a union-field ?? read off a call reads it back from legacy's stash, and a string ?? over an if-expression is the nulStr block
// expect covered >= 3
// expect matched >= 3
// expect no row containing coalesce field place
// expect no row containing coalesce of a valued if
// expect no row containing fail
type J = { r: i32 | null, g: i32 }
let calls = 0
function mk(v: i32 | null): J {
  calls = calls + 1
  return { r: v, g: 1 }
}
function readOff() {
  print(mk(4).r ?? 0)
  print(mk(null).r ?? 7)
  print(calls)
}
readOff()
function pick(c: boolean, s: string | null) {
  print((if c { s } else { null }) ?? "dflt")
}
pick(true, "x")
pick(true, null)
pick(false, "y")
