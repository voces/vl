// ir shadow: a K | null place operand takes the null leg's id test and its decode, and matches
// expect covered >= 4
// expect no row containing uncovered
// Box null against operand null answers on the null leg; "a" and "b" decode apart on the plain arm.
type K = "a" | "b"
type U = i32 | K | null
type H = { k: K | null }
let gk: K | null = null
function byParam(u: U, k: K | null) { return u == k }
function byField(u: U, h: H) { return h.k != u }
function byGlobal(u: U) { return u == gk }
function show(u: U, k: K | null) {
  gk = k
  const h: H = { k: k }
  print(byParam(u, k))
  print(byField(u, h))
  print(byGlobal(u))
}
show(null, null)
show("a", null)
show("a", "a")
show("a", "b")
show("b", "b")
show(1, "a")
