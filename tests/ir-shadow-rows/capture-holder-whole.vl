// ir shadow: a binding holding a returned bundle whole, captured, copied and called in a closure
// expect covered >= 3
// expect matched >= 3
// expect no row containing capture binding
// `lap` returns its bundle parameter, so `c` holds that record whole; `g` captures `c`, copies it into
// `v` (`capturedHolderTy`) and calls through both (`calleeIsCapture`).
function lap(f) {
  f(2.5)
  f(3)
  return f
}
function fr(k: i32) {
  const c = lap((a) => a + k)
  const g = () => {
    const v = c
    print(v(4))
    print(c(1.5))
  }
  g()
}
fr(2)
