// ir shadow: a field of a field of a maker call is read at the field type of the call's built type
// expect start matched >= 1
// expect no row containing field read coercion
// expect no row containing mismatch
function inc0(a) { return a + 1 }
function mk2(f) { return { r: { f: f } } }
function mk5(f) { return { a: { b: { c: { d: { f: f } } } } } }
print(mk2(inc0).r.f(3))
print(mk5(inc0).a.b.c.d.f(4))
