// ir shadow: a decided pushing arm's grown length at every delivery position: call argument at a scalar and a union parameter, nested call argument, concat operand, return, let initializer, if arm value, ?? operand and record field
// expect no row containing decided is fit shadow
function len(n: i32): i32 { return n }
function lenOr(x: i32 | string): i32 { return if x is string { 0 } else { x } }
function twice(n: i32): i32 { return n * 2 }
function posOr(n: i32): i32 | null { return if n > 0 { n } else { null } }
function pArg<V>(v: V[]) {
  if v is f64[] { v.push(1.5) }
  print(len(v.length))
}
function pUnion<V>(v: V[]) {
  if v is f64[] { v.push(1.5) }
  print(lenOr(v.length))
}
function pNested<V>(v: V[]) {
  if v is f64[] { v.push(1.5) }
  print(twice(len(v.length)))
}
function pConcat<V>(v: V[]) {
  if v is f64[] { v.push(1.5) }
  print("n=" + (if v.length > 0 { "some" } else { "none" }))
}
function pReturn<V>(v: V[]): i32 {
  if v is f64[] { v.push(1.5) }
  return v.length
}
function pLet<V>(v: V[]) {
  if v is f64[] { v.push(1.5) }
  const n = v.length
  print(n)
}
function pIfArm<V>(v: V[], b: boolean) {
  if v is f64[] { v.push(1.5) }
  print(if b { v.length } else { -1 })
}
function pCoalesce<V>(v: V[]) {
  if v is f64[] { v.push(1.5) }
  print(posOr(v.length) ?? 0)
}
function pRecord<V>(v: V[]) {
  if v is f64[] { v.push(1.5) }
  const r = { n: v.length }
  print(r.n)
}
const e: i32[] = []
const f: f64[] = []
pArg(e)
pArg(f)
pUnion(e)
pUnion(f)
pNested(e)
pNested(f)
pConcat(e)
pConcat(f)
print(pReturn(e))
print(pReturn(f))
pLet(e)
pLet(f)
pIfArm(e, true)
pIfArm(f, true)
pCoalesce(e)
pCoalesce(f)
pRecord(e)
pRecord(f)
