// ir shadow: a captured for-in variable reads at its read's rep where legacy's capture valtype agrees
// expect covered >= 2
// expect matched >= 2
// expect no row containing capture binding
// The closures in `ints` and `strs` capture the loop variable (`capRepFor`).
function ints(xs: i32[]) {
  for x in xs {
    const f = () => x
    print(f())
  }
}
function strs(ss: string[]) {
  for s in ss {
    const g = () => s
    print(g())
  }
}
ints([1, 2])
strs(["a"])
