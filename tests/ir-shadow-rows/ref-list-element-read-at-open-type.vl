// ir shadow: a nested list of hole functions read by index at an open type is the element as stored
// expect covered >= 4
// expect no row containing index element coercion
// expect no row containing differ
function inc1(a) { return a + 1 }
function dbl1(a) { return a * 2 }
function atCall() {
  const m = Map()
  m.set("k", [[inc1], [dbl1, inc1]])
  m["j"] = [[dbl1]]
  const x = m["k"]
  if x != null { print(x[1][0](3)) }
}
function atBind() {
  const m = Map()
  m.set("k", [[inc1], [dbl1, inc1]])
  m["j"] = [[dbl1]]
  const x = m["k"]
  if x != null {
    const r = x[1]
    print(r[1](3))
  }
}
atCall()
atBind()
