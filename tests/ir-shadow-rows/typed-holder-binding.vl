// ir shadow: an annotated binding of a bundle holder's read takes the member its type names
// expect covered >= 3
// expect matched >= 3
// expect no row containing declaration coercion
// `lap` returns its hole parameter as a bundle of its two closure instances, so `k` holds the
// record and each annotated binding picks the member its type names (`RHolderPick`).
function lap(f) {
  f(2.5)
  f(3)
  return f
}
function asF64() {
  const k = lap((a) => a + 1)
  const m: (f64) => f64 = k
  print(m(4))
}
function asI32() {
  const k = lap((a) => a + 2)
  const n: (i32) => i32 = k
  print(n(7))
}
function viaCopy() {
  const k = lap((a) => a + 3)
  const w = k
  const m: (f64) => f64 = w
  print(m(1))
}
asF64()
asI32()
viaCopy()
