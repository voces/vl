// ir shadow: a spread literal of several item groups builds each group, then joins them
// expect covered >= 4
// expect matched >= 4
// expect no row containing uncovered
function both(a: i32[], b: i32[]) { return [...a, ...b] }
function around(a: i32[], x: i32) { return [x, ...a, x] }
function twice(x: i32) { return [x, ...[x]] }
function joined() { return [...[[1, 2]], ...[[3.5]]] }
print(both([1], [2, 3]).length)
print(around([5], 4)[2])
print(twice(7).length)
print(joined()[1][0])
