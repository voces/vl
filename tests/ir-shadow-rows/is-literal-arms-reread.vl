// ir shadow: a literal is-test reading its receiver once per member re-reads a list element, a field or a global as the builder read it
// expect covered >= 3
// expect start covered >= 1
type N = 1 | 2 | 3
type S = "a" | "b"
type R = { n: N | null, s: S | string }
function g(xs: (N | null)[], i: i32): boolean { return xs[i] is N }
function h(r: R): boolean { return r.s is S }
function k(r: R): boolean { return r.n is N }
const gl: S | string = "b"
print(gl is S)
print(g([1, null], 0))
print(h({ n: 1, s: "a" }))
print(k({ n: null, s: "z" }))
