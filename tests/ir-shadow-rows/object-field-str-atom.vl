// ir shadow: a literal-union atom into a string record field is decoded as legacy's emitAtomToStr
// expect covered >= 2
// expect matched >= 2
// expect no row containing object field strAtom
type K = "aa" | "bb" | "cc"
type RS = { t: string, k: K | null }
function mk(k: K): RS { return { t: k, k: k } }
function mk2(t: string): RS { return { t: t, k: null } }
print(mk("bb").t)
print(mk2("x").t)
