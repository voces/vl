// ir shadow: a hole parameter read at its frame's rep, an operator over it at legacy's width, and a call typed `<error>` at its callee's result
// expect covered >= 8
// expect matched >= 8
function app<T, U>(f: (T) => U, v: T): U { return f(v) }
function via(a) { print(a((n) => n + 1, 2)) }
via(app)
function viaCap(a, k) { print(a((n) => n + k, 2)) }
viaCap(app, 10)
type N = { k: i32 }
function down(self: N) {
  if self.k <= 0 { return 0 }
  return { k: self.k - 1 }.up()
}
function up(self: N) { return self.down() + 1 }
print({ k: 3 }.up())
