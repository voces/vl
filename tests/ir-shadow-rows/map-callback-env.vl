// ir shadow: xs.map / xs.filter by a callback that captures, its closure built from the captures after the receiver
// expect covered >= 2
// expect no row containing map callback env
// expect no row containing fail
function scaled(xs: i32[], k: i32) { return xs.map((x) => x * k) }
function above(xs: i32[], lo: i32) { return xs.filter((x) => x > lo).length }
print(scaled([1, 2, 3], 10)[2])
print(above([1, 5, 9], 4))
