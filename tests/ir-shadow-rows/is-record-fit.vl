// ir shadow: an instance's record is on the recordFit rung, by a literal set and by a field box's arms, legacy's field tests reading the IR's variable
// expect covered >= 2
// expect no row containing is rung
// expect no row containing record fit
// expect no row containing fail
type A = { x: i32 | string | boolean, y: string }
type B = { x: i32 | boolean, y: string }
function l<L>(u: L | null) { return u is { a: 1 | 2 } }
function g<T>(a: T) { return a is B }
const r1: { a: i32 } = { a: 1 }
const r3: { a: i32 } = { a: 3 }
print(l(r1))
print(l(r3))
print(l<{ a: i32 }>(null))
const p: A = { x: 1, y: "a" }
const q: A = { x: "s", y: "b" }
print(g(p))
print(g(q))
