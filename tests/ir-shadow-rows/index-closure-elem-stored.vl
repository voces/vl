// ir shadow: lists of hole functions read at the open type their holes leave, each element read at its closure storage (repStoresAs)
// expect covered >= 10
// expect no row containing index element coercion
// expect no row containing fail
function inc(a) { return a + 1 }
function dbl(a) { return a * 2 }
function nested(_n) {
  let w = [[inc], [dbl]]
  w = [[dbl], [inc]]
  return w
}
print(nested(1)[0][0](3))
print(nested("s")[1][0](1.5))
function flat(_n) {
  let u = [inc, dbl]
  u = [dbl, inc]
  return u
}
function take(a) { print(a[1](3)) }
take(flat(1))
function inner(_n) {
  let w = [[inc, dbl]]
  const row = w[0]
  print(row[1](4))
  w = [[dbl, inc]]
  print(w[0][0](4))
}
inner(1)
inner("s")
