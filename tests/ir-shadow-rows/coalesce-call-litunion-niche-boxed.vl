// ir shadow: a `??` over a literal union's `K | null` niche a call yields, joined into a value union, is legacy's atom stash, which the IR writes as legacy does
// expect matched >= 2
// expect start matched >= 1
// expect no row containing fail
// expect no row containing mismatch
type K = "a" | "b"
function g(): K | null { return "b" }
function f() { print(g() ?? 2) }
f()
