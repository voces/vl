// ir shadow: a for walk over a list of record lists
// expect covered >= 1
// expect matched >= 1
// expect no row containing for in element reflist
type OV = { ov: i32 }
type SE = { seLIx: OV[], seRIx: OV[] }
function f(r: SE): i32 {
  let t = 0
  for ixs in [r.seLIx, r.seRIx] {
    for o in ixs { t = t + o.ov }
  }
  return t
}
print(f({ seLIx: [{ ov: 1 }], seRIx: [{ ov: 2 }, { ov: 3 }] }))
