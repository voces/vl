// ir shadow: a numeric coalesce chain boxed into a generic writes the box tag ahead of the chain
// expect covered >= 2
// expect matched >= 2
// expect no row containing box of a valued if
// expect no row containing fail
function kind<T>(v: T) {
  if v is i32 { return "i32" }
  if v is i64 { return "i64" }
  return "other"
}
function run(q: i64 | null, r: i32 | null) {
  print((q ?? (r ?? 5)))
  print(kind((q ?? (r ?? 5))))
}
run(9000000001, null)
run(null, -3)
run(null, null)
