// ir shadow: an assignment's value re-read from a wider cell is narrowed back by legacy's unwiden opcode
// expect matched >= 5
// expect no row containing fail
// expect no row containing mismatch
// expect no row containing assignment value unwiden
function wrapTail(c: boolean) {
  let x: i64 | null = null
  return x = if c { 5 } else { -7 }
}
function truncTail(k: i32) {
  let y: f64 = 0
  return y = k
}
let held: { v: i32 } | null = null
function recTail(v: i32) { return held = { v: v } }
function cloTail(n: i32) {
  let f: (() => i32) | null = null
  return (f = () => n * 3)()
}
print(wrapTail(true))
print(wrapTail(false))
print(truncTail(-7))
print(recTail(4).v)
print(cloTail(5))
