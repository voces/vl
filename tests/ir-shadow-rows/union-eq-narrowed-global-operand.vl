// ir shadow: a union == whose operand is a module let its initializer narrowed compares at the box it is stored as
// expect start covered >= 1
// expect start matched >= 1
// expect no row containing union compare operand rep
type A = { a: i32 }
type B = { b: i32 }
const src: A = { a: 1 }
const held: A | B = src
let v: A | B = src
print(v == held)
print(held != v)
