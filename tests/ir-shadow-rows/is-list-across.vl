// ir shadow: x is L over a box of list arms on the listAcross rung, the box once into the shared slot then each arm's test
// expect covered >= 3
// expect no row containing is rung
// expect no row containing fail
type K = 1 | 2
function mk(c: boolean): i32[] | string[] {
  if c { return [1, 2] }
  return ["a"]
}
function fits(x: i32[] | string[]): boolean { return x is K[] }
function strs(x: i32[] | string[]): i32 {
  if x is K[] { return 1 }
  return 0
}
print(fits(mk(true)))
print(fits(mk(false)))
print(strs(mk(true)))
