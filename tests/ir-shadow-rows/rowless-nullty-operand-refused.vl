// ir shadow: a `null`-typed field's null test is legacy's read-and-drop, which the IR refuses by name
// expect uncovered null test nullty operand = 1
// expect no row containing mismatch
type K = { f: i32 | null }
function mkn() { return { f: null } }
const kA: K = mkn()
print(kA.f ?? 3)
function mkg(y) { return { g: y.f == null } }
print([mkn()].map(mkg)[0].g)
