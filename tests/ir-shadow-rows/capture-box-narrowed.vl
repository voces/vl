// ir shadow: a union-box capture read at a narrower union's box, in a closure, a lifted function, a nested closure and as a value
// expect matched >= 5
// expect no row containing capture binding
function closure(k: "a" | i32 | null): i32 {
  if k == "a" { return 1 }
  const g = () => {
    return if k == null { 2 } else { k + 5 }
  }
  return g()
}
function lifted(k: "a" | i32 | null): i32 {
  if k == "a" { return 1 }
  function g(): i32 { return if k == null { 2 } else { k + 5 } }
  return g()
}
function nested(k: "a" | i32 | null): i32 {
  if k == "a" { return 1 }
  const outer = () => {
    const inner = () => {
      return if k == null { 2 } else { k + 7 }
    }
    return inner()
  }
  return outer()
}
function asValue(k: "a" | i32 | null): i32 | null {
  if k == "a" { return 1 }
  const g = (): i32 | null => k
  return g()
}
print(closure(3))
print(closure("a"))
print(closure(null))
print(lifted(3))
print(lifted(null))
print(nested(3))
print(nested(null))
print(asValue(9) ?? -1)
print(asValue(null) ?? -1)
