// ir shadow: a ?? chain's re-associated inner link with no type of its own is of its chain's type: a literal-union chain whose default is a member, and a hole's map reads of mixed kinds
// expect covered >= 3
// expect no row containing rep ?
type K = "a" | "b"
function mkK(n: i32): K | null { return if n == 1 { "b" } else { null } }
function lit(n: i32, r: K | null) { print(r ?? mkK(n) ?? "a") }
function hole(a, b) { print(a[9] ?? a[8] ?? b[3]) }
lit(1, null)
lit(0, null)
const t: {[i32]: boolean} = Map()
t[8] = true
const n: {[i32]: i32} = Map()
n[3] = 2
hole(t, n)
hole(Map(), n)
