// ir shadow: a function handed through a closure call to a parameter it calls at two signatures is the record of its closures, and matches
// expect covered >= 6
// expect matched >= 6
// expect no row containing mismatch
function id(a) { return a }
function dup(a) { return a }
const lap = (g) => {
  print(g(1) + 1)
  return g("s")
}
function use(k) {
  print(k(id))
  return k(dup)
}
print(use(lap))
