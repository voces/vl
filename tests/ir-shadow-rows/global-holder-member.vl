// ir shadow: a module binding holding one member of a returned bundle, read where its type is open
// expect no row containing open temp type
// expect no row containing global read coercion
// expect start covered >= 1
// expect start matched >= 1
// `w` and `k` hold a hole lambda's bundle's member or record (`globalHolderTy`); the start
// body reads `w` at that member's closure, as its cell holds it.
function lap(f) {
  f(2.5)
  f(3)
  return f
}
const c = lap((a) => a + 1)
function g() { return c }
const w = g()
print(w(3))
function u(f: (f64) => f64) { print(f(3.5)) }
u(g())
const k = g()
print(k(6))
print(k(1.5))
