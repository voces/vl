// ir shadow: a record compare's element side over a place receiver re-reads the place at each field
// expect matched >= 6
// expect start matched >= 1
// expect no row containing spans
// expect no row containing fail
// expect uncovered record compare element place = 1
// The receiver is a global, a narrowed nullable global, or field reads over a variable, read
// again at each field as legacy's own root reads it; the index is a variable or an immediate.
// An index that builds a call stages the whole side, read once (`k` counts the calls); a
// receiver that is itself an element stays a named miss.
type P = { x: i32, y: i32 }
type Q = { p: P, z: i32 }
type H = { items: P[] }
const xs: P[] = [{ x: 1, y: 2 }, { x: 1, y: 2 }, { x: 3, y: 4 }]
const qs: Q[] = [{ p: { x: 1, y: 2 }, z: 5 }, { p: { x: 1, y: 2 }, z: 5 }]
const nl: P[] | null = [{ x: 1, y: 2 }]
const pairs: P[][] = [[{ x: 1, y: 2 }]]
let k = 0
function next() {
  k = k + 1
  return k
}
function atImm(p: P) { return xs[0] == p }
function atVar(p: P, i: i32) { return xs[i] != p }
function twoPlaces(i: i32) { return xs[i] == xs[2] }
function nested(i: i32) { return qs[i] == qs[1] }
function field(h: H, i: i32, p: P) { return h.items[i] == p }
function narrowed(p: P) {
  if nl != null { return nl[0] == p }
  return false
}
function byCall(p: P) { return xs[next()] == p }
function byElem(p: P) { return pairs[0][0] == p }
const p12: P = { x: 1, y: 2 }
print(atImm(p12))
print(atImm({ x: 3, y: 2 }))
print(atVar(p12, 1))
print(atVar(p12, 2))
print(twoPlaces(0))
print(twoPlaces(2))
print(nested(0))
print(field({ items: [{ x: 1, y: 2 }, { x: 1, y: 3 }] }, 1, p12))
print(narrowed(p12))
print(byCall(p12))
print(byElem(p12))
print(xs[0] == xs[1])
print(xs[1] != xs[2])
print(k)
