// ir shadow: a hole function's field called off a maker call is read at the call's built type
// expect start matched >= 1
// expect no row containing field read coercion
// expect no row containing mismatch
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function mk(f) { return { f: f } }
print(mk(inc0).f(3))
print(mk(dbl).f(3))
