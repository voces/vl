// ir shadow: a nullable map's ?? takes the nullable reference core at the map's heap, a parameter or a call operand
// expect covered >= 2
function sz(m: {[string]: i32} | null): i32 {
  const d: {[string]: i32} = Map()
  return (m ?? d).length
}
function mk(b: boolean): {[string]: i32} | null { return if b { Map() } else { null } }
function sz2(b: boolean): i32 { return (mk(b) ?? Map()).length }
print(sz(null))
print(sz2(true))
print(sz2(false))
