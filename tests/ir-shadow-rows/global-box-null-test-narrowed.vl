// ir shadow: a null test of a union-box global the checker narrowed past one member reads the
// cell as it stores it and compares the box's tag, as legacy does
// expect start covered >= 1
// expect start matched >= 1
// expect no row containing mismatch
// expect no row containing fail
// expect no row containing global read coercion
type A = { x: i32 } | null
type U = A | { tag: i32 }
const a: A = { x: 4 }
const u: U = a
if u is { tag: i32 } { print(u.tag) }
else if u == null { print(0) }
else { print(u.x) }
function opt<T>(f: () => T | string | null): T | string | null { return f() }
const q = opt(() => ({ a: 2 }))
if q is string { print(q) }
else if q == null { print(0) }
else { print(q.a) }
