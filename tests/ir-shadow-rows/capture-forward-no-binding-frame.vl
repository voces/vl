// ir shadow: a capture copied env to env where no binding frame is found
// expect no row containing open temp type
// expect covered >= 78
// expect matched >= 78
// `cloEnvOf` holds such a copy at its rep's own type, as `liftCapVar` does.

type Err = { code: i32, msg: string }

function viaLocal(): () => i32[] | Err {
  const r: i32[] = [4, 5, 6]
  return () => r
}

function viaParam(r: string): () => string | Err { return () => r }

function viaDeep(): () => i32 | Err {
  const r = 41
  return () => (() => (() => r)())()
}

function viaGeneric<T>(r: T): () => T { return () => r }

function viaInferred(): () => string | Err {
  const r = "loc"
  return () => r
}

function viaLoop(): () => i32 | Err {
  let f: () => i32 | Err = () => 0
  for r in 7 to 7 { f = () => (() => r)() }
  return f
}

const a = viaLocal()()
let out = "\{a is Err}"
if !(a is Err) { out = out + " \{a.length}" }
const b = viaParam("hey")()
out = out + " \{b is Err}"
if !(b is Err) { out = out + " " + b }
const c = viaDeep()()
out = out + " \{c is Err}"
if !(c is Err) { out = out + " \{c + 1}" }
const d = viaLoop()()
out = out + " \{d is Err}"
if !(d is Err) { out = out + " \{d}" }
out = out + " " + viaGeneric("gen")()
const e = viaInferred()()
if !(e is Err) { out = out + " " + e }

if true {
  const r: Err | null = { code: 2, msg: "block" }
  out = out + " \{r != null}"
}
print(out)
