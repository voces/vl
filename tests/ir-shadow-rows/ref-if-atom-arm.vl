// ir shadow: a string join's atom arm decodes to its member string, a plain arm niches into a nullable join
// expect covered >= 5
// expect matched >= 5
// expect no row containing ref if arm
type K = "a" | "b"
function pick(c: boolean, k: K) { return if c { k } else { "z" } }
function pickNul(c: boolean, k: K | null) { return if c { k } else { "z" } }
function bound(c: boolean, k: K) {
  const v = if c { k } else { "zz" }
  print(v)
}
function show(v: string | null) { print(v) }
function viaParam(c: boolean, k: K | null) {
  const v = if c { k } else { "y" }
  show(v)
}
print(pick(true, "a"))
print(pick(false, "b"))
print(pickNul(true, null))
print(pickNul(false, "a"))
bound(true, "b")
bound(false, "a")
viaParam(true, null)
viaParam(false, "a")
