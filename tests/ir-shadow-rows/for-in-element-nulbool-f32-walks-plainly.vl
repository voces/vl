// ir shadow: a walk over a `(boolean | null)[]` or an `f32[]` binds the element along legacy's plain walk
// expect matched >= 1
// expect start matched >= 1
// expect no row containing for in element nulbool
// expect no row containing for in element f32
// expect no row containing fail
// `forInElemPlain`'s `nulbool` and `f32`: the element is read whole at its own rep, a
// walk whose body cannot reallocate the list hoisted, an index pair and a nested walk alike.
function nb(v: boolean | null) {
  if v == null { return 2 }
  return if v { 1 } else { 0 }
}
function plainB(z: (boolean | null)[]) {
  for v in z { print(nb(v)) }
}
function growB(z: (boolean | null)[]) {
  for v in z {
    if v == null { z.push(true) } else { print(nb(v)) }
  }
}
function pairB(z: (boolean | null)[]) {
  for v, i in z { print(i + nb(v)) }
}
function breakB(z: (boolean | null)[]) {
  for v in z {
    if v == null { continue }
    if !v { break }
    print(7)
  }
}
function plainF(z: f32[]) {
  let s: f32 = 0
  for v in z { s = s + v }
  print(s)
}
function growF(z: f32[]) {
  for v in z {
    if v > 2 { z.push(1) } else { print(v) }
  }
}
function pairF(z: f32[]) {
  for v, i in z { print(v * 2) }
}
function nested(a: f32[], b: (boolean | null)[]) {
  for x in a {
    for y in b {
      if y == true { print(x) }
    }
  }
}
const bs: (boolean | null)[] = [true, null, false]
const fs: f32[] = [1.5, 2.5, 3.5]
plainB(bs)
growB([null, false])
pairB(bs)
breakB([null, true, false, true])
plainF(fs)
growF([1, 3])
pairF(fs)
nested(fs, bs)
for v in bs { print(nb(v)) }
for v in fs { print(v) }
