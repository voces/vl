// ir shadow: a list of one recursive record handed at a list of its structural twin, the two
// stored on one heap, is the same list: the retag's record walk ends at the heap
// expect covered >= 3
// expect matched >= 3
// expect no row containing fail
type L1 = { n: L1 | null, v: i32 }
type L2 = { n: L2 | null, v: i32 }
function sum(xs: L1[]) {
  let t = 0
  for x in xs { t = t + x.v }
  return t
}
function mk(k: i32): L2[] {
  const a: L2 = { n: null, v: k }
  const b: L2 = { n: a, v: k + 1 }
  return [a, b]
}
function go(k: i32) { print(sum(mk(k))) }
go(1)
go(5)
