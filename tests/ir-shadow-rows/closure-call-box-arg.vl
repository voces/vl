// ir shadow: an argument of a closure call into a union parameter is boxed at that parameter, and matches
// expect covered >= 4
// expect matched >= 4
// expect no row containing call of a non-declaration
// expect no row containing mismatch
function apply(f: (w: string | i32) => i32, n: i32): i32 { return f(n) }
function go() {
  const g = (w: string | i32) => if w is i32 { w + 1 } else { 0 }
  print(g(4))
  print(g("a"))
  const k: string | i32 = 9
  print(g(k))
}
go()
print(apply((w) => if w is i32 { w * 2 } else { 1 }, 5))
