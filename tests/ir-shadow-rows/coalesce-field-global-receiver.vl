// ir shadow: o.v ?? d at module scope over a global record, and over a global's field, re-reads the receiver as it was read
// expect start covered >= 1
type J = { f: i32 | null }
type O = { j: J }
const wideJ: J = { f: 2 }
const wideO: O = { j: { f: null } }
print(wideJ.f ?? 0)
print(wideO.j.f ?? 0)
