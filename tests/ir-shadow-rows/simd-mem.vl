// ir shadow: SIMD loads and stores build along the memory address plan and match
// expect covered >= 5
// expect matched >= 5
// expect no row containing simd memory
function ld(p: i32): v128 { return __load_v128__(p) }
function ldOff(p: i32): v128 { return __load_v128__(p, 16) }
function st(p: i32, v: v128) { __store_v128__(p, v) }
function stConst(v: v128) { __store_v128__(64, v) }
function dropLoad(p: i32) { __load_v128__(p) }
st(128, __splat_i32x4__(7))
stConst(__splat_i32x4__(9))
print(__extract_lane_i32x4__(ld(128), 2))
print(__extract_lane_i32x4__(ldOff(48), 0))
dropLoad(128)
