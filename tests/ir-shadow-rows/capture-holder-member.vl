// ir shadow: a captured binding holding one member of a returned bundle (called at one signature), read in a closure, a lifted function, a nested closure and twice
// expect matched >= 6
// expect no row containing capture binding
function lap(f) {
  print(f(2.5))
  print(f(3))
  return f
}
function inClosure(k: i32) {
  const r = lap((a) => a + k)
  const h = () => print(r(4))
  h()
}
function inLifted(k: i32) {
  const r = lap((a) => a * k)
  function h() { print(r(5)) }
  h()
}
function nested(k: i32) {
  const r = lap((a) => a - k)
  const outer = () => {
    const inner = () => print(r(9))
    inner()
  }
  outer()
}
function twice(k: i32) {
  const r = lap((a) => a + k)
  const h = (): i32 => r(1) + r(2)
  print(h())
}
inClosure(2)
inLifted(3)
nested(4)
twice(5)
