// ir shadow: a lambda's tail `x ?? "n"` typed nullable in a generic instance is returned at its non-null result with legacy's `ref.as_non_null`, as a field, an element, a global and an explicit `return`; where the left side is null at runtime the default delivers
// expect covered >= 8
// expect matched >= 8
// expect no row containing tail coercion
type K = "a" | "b"
type R = { s: string | null, n: i32 }
let gs: string | null = null
function field<T>(x: T) {
  const o: R = { s: null, n: 1 }
  o.s = x
  o.s = "z"
  const f = () => o.s ?? "n"
  print(f())
}
function elem<T>(x: T) {
  const a: (string | null)[] = [null]
  a[0] = x
  a[0] = "y"
  const f = () => a[0] ?? "n"
  print(f())
}
function glob<T>(x: T) {
  gs = null
  gs = x
  gs = "w"
  const f = () => gs ?? "n"
  print(f())
}
function ret<T>(x: T) {
  const o: R = { s: null, n: 2 }
  o.s = x
  o.s = "v"
  const f = () => {
    return o.s ?? "n"
  }
  print(f())
}
function dflt<T>(x: T) {
  const o: R = { s: null, n: 3 }
  o.s = x
  const f = () => o.s ?? "n"
  print(f())
}
function dfltGlob<T>(x: T) {
  gs = x
  const f = () => gs ?? "n"
  print(f())
}
const v: K | null = null
const w: K | null = "a"
field(v)
elem(v)
glob(v)
ret(v)
dflt(v)
dflt(w)
dfltGlob(v)
dfltGlob(w)
