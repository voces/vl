// ir shadow: a closure boxed into a union under its closure arm's tag builds and matches
// expect covered >= 3
// expect matched >= 3
// expect no row containing box ladder
// expect no row containing fail
type F = ((x: i32) => i32) | i32
function run(f: F, x: i32) {
  if f is i32 { return f }
  return f(x)
}
function mk(k: i32): F { return (x: i32) => x + k }
function bound(k: i32) {
  const g = (x: i32) => x * k
  return run(g, 1)
}
print(run(mk(4), 3))
print(bound(3))
