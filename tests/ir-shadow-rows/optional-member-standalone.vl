// ir shadow: a standalone `?.` over one link and a variable base is built at every leaf kind
// expect covered >= 5
// expect matched >= 5
// expect no row containing optional member
// Each function reads one field of a nullable record: the boxed number and float, the nullable
// string and record, the string. The link's null test reads the base twice, as legacy's does.
type P = { x: i32, f: f64, s: string | null, q: Q | null, t: string }
type Q = { n: i32 }
function xs(p: P | null) { return p?.x }
function fs(p: P | null) { return p?.f }
function ss(p: P | null) { return p?.s }
function qs(p: P | null) { return p?.q }
function ts(p: P | null) { return p?.t }
const a: P = { x: 3, f: 1.5, s: "hi", q: { n: 9 }, t: "tt" }
print(xs(a) ?? -1)
print(fs(a) ?? -1.0)
print(ss(a) ?? "none")
print(qs(a)?.n ?? -1)
print(ts(a) ?? "none")
