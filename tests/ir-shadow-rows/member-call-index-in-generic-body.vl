// ir shadow: a generic body indexes a member call's result its instance lowers to a direct call, at f64 and i64
// expect covered >= 4
// expect matched >= 4
// expect no row containing rep ?
// expect no row containing mismatch
function rev<T>(self: T[]): T[] { return self }
function first<T>(xs: T[]): T { return xs.rev()[0] }
function len<T>(xs: T[]) { return xs.rev().length }
print(first([1.5, 2.5]))
print(first([(3 as i64), (1 as i64)]))
print(len([1, 2, 3]))
