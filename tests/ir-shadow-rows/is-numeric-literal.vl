// ir shadow: x is K over a numeric literal union is legacy's membership compare, the receiver once into a slot or once per member
// expect covered >= 3
type K = 1 | 2 | 3
type W = 5000000000 | 6000000000
function a(x: i32): boolean { return x is K }
function w(x: i64): boolean { return x is W }
function f(): i32 { return 2 }
function c(): boolean { return f() is K }
print(a(2))
print(a(7))
print(w(5000000000))
print(c())
