// ir shadow: an else-if chain of member literals at a literal-union destination walks its direct links without the atom hook
// expect covered >= 2
type Op = "lt" | "le" | "gt" | "ge"
function two(k: i32, x: boolean): Op {
  const c: Op = if k > 0 && x { "lt" } else if k > 0 { "le" } else if x { "gt" } else { "ge" }
  return c
}
function one(k: i32): Op {
  const c: Op = if k > 0 { "lt" } else { "le" }
  return c
}
print(two(1, true))
print(two(1, false))
print(two(-1, true))
print(two(-1, false))
print(one(1))
