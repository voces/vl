// ir shadow: a value if joined at a closure writes each arm's closure as itself
// expect covered >= 6
// expect matched >= 6
// expect no row containing expression if ref closure
function inc(x: i32) { return x + 1 }
function dec(x: i32) { return x - 1 }
function lambdas(c: i32): (i32) => i32 {
  return if c > 0 { (x: i32) => x * 10 } else { (x: i32) => x - 10 }
}
function named(c: boolean): (i32) => i32 {
  const f = if c { inc } else { dec }
  return f
}
function capturing(k: i32): (i32) => i32 {
  const g = if k > 2 { (x: i32) => x + k } else { (x: i32) => x * k }
  return g
}
function chain(c: i32): (i32) => i32 {
  return if c == 0 { inc } else if c == 1 { dec } else { (x: i32) => x * x }
}
print(lambdas(1)(4))
print(lambdas(-1)(4))
print(named(true)(7))
print(named(false)(7))
print(capturing(5)(1))
print(capturing(2)(3))
print(chain(0)(9))
print(chain(1)(9))
print(chain(2)(9))
