// ir shadow: an is test at the litArms rung: a map read's hit or miss, a ref niche's null test
// expect covered >= 3
// expect no row containing fail
type R = { n: i32 }
const m: {[string]: i32} = Map()
m["a"] = 1
function hit(k: string): boolean { return m[k] is i32 }
function miss(k: string): boolean { return m[k] is null }
function nul(r: R | null): boolean { return r is null }
print(hit("a"))
print(miss("a"))
print(nul(null))
