// ir shadow: a list literal of an order-stashed record matches at the door from legacy's frame
// expect node-in array: matched >= 2
// expect no row containing node-in array: differ
const xs = [{ v: 2, f: () => 11 }]
function g(): i32 {
  const ys = [{ v: 2, w: 3, f: () => 11 }]
  return ys[0].f() + ys[0].w
}
print(xs[0].f() + g())
