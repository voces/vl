// ir shadow: a record literal's field `if c { [] } else { null }` no write pins takes the i32 list a plain local's join takes, so its body is covered
// expect covered >= 1
// expect matched >= 1
// expect start covered >= 1
// expect start matched >= 1
// expect no row containing if arm coercion
function local(c: boolean): boolean {
  const lb = { xs: if c { [] } else { null } }
  return lb.xs == null
}
const w = { f: if 1 == 1 { [] } else { null }, n: 7 }
print(w.f == null)
print(local(false))
print(w.n)
