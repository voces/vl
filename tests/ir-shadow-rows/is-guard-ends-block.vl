// ir shadow: a statement if whose decided-true record guard always exits ends its block behind unreachable, the statements after it not built
// expect covered >= 3
// expect matched >= 3
// expect no row containing decided is guard ends block
function foobar(v) {
  if v is { foo: string } { return v.foo }
  return v.bar
}
function pick(v) {
  if v is { a: string } { return v.a }
  return v.b
}
print(foobar({ bar: 42 }))
print(foobar({ foo: "foo" }))
print(pick({ a: "x", b: "y" }))
