// ir shadow: an is test at the emptyFit rung over a union box reads each list arm's emptiness
// expect covered >= 2
// expect no row containing fail
function probe<V>(v: V[] | string): boolean { return v is f64[] }
function arm<V>(v: V[] | string) {
  if v is f64[] { return 1 }
  return 0
}
print(probe(["a"]))
print(probe([]))
print(arm([1]))
print(arm("s"))
