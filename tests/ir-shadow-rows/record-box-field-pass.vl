// ir shadow: a record's box field narrowed by an else arm, passed to a union parameter
// expect covered >= 2
// expect matched >= 2
// expect no row containing narrowed field unbox rep
type OV = { ov: i32 }
type OS = { os: string }
type OI = { oi: i32, oj: i32 }
type Op = OV | OS | OI
type MF = { mfA: i32, mfB: Op }
function use(o: Op): i32 {
  if o is OV { return o.ov }
  return -1
}
function lm(r: MF): i32 {
  if r.mfB is OS { return 0 } else { return use(r.mfB) }
}
print(lm({ mfA: 1, mfB: { ov: 4 } }))
