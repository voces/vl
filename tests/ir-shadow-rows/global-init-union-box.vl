// ir shadow: a union global is initialised as its boxed cell and the start body matches
// expect start covered >= 1
// expect start matched >= 1
type A = { a: i32 }
type B = { b: string }
type U = A | B
const u: U = { a: 1 }
const w: i32 | string = "hi"
const x: i32 | string = 7
const n: i32 | null = null
function mk(): A { return { a: 9 } }
const v: U = mk()
print(u is A)
print(w)
print(x)
print(v is A)
