// ir shadow: a nested function called inside a generic's instance is the one the scope chain names, and matches
// expect covered >= 8
// expect matched >= 8
// expect no row containing call target
// expect no row containing mismatch
function pTyParam<T>(x: T): T {
  function id(a: T): T { return a }
  return id(x)
}
function recur<T>(x: T, n: i32): T {
  function down(a: T, m: i32): T {
    if m <= 0 { return a }
    return down(a, m - 1)
  }
  return down(x, n)
}
print(pTyParam(41) + 1)
print(pTyParam("s"))
print(recur(2.5, 3))
print(recur(7, 2))
