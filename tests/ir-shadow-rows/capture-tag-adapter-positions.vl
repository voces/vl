// ir shadow: a choice delivered to a closed function type at a binding, an `if` arm, a record
// field and a return is an adapter dispatching on the captured id (Q58 sweep)
// expect no row containing capture binding
// expect no row containing fail
function inc(a) { return a + 1 }
function str(_a) { return "s" }
function ap(g, x) { return g(x) }
type K = (a: i32) => i32 | string
function mk(c: boolean): K {
  const g = if c { str } else { inc }
  print(ap(g, 3))
  return g
}
function run(c: boolean) {
  const g = if c { str } else { inc }
  print(ap(g, 3))
  const k: K = g
  print(k(4))
  const j: K = if c { g } else { inc }
  print(j(4))
  const r: { k: K } = { k: g }
  print(r.k(4))
  print(mk(c)(4))
}
run(true)
run(false)
