// ir shadow: a global or local cell sits at its storage row when its initializer builds that row
// expect start covered >= 1
// expect start matched >= 1
// expect covered >= 3
// expect matched >= 3
// expect no row containing declaration coercion
// expect no row containing global initializer coercion
function exclaim(s) { return s + "!" }
const xs = [exclaim]
print(xs.length)
function half(a) { return a / 2.0 }
function go() {
  const m5 = Map()
  m5.set("a", half)
  const zs = [m5, m5]
  print(zs.length)
}
go()
