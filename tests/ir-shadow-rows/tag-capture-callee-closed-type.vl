// ir shadow: a captured cell holding its tagged set's id, read at a closed function type
// expect covered >= 4
// expect matched >= 4
// expect no row containing capture binding
function inner<U>(u: U) { print(u) }
function other<V>(v: V) { print(v) }
function cb(f: (b: boolean) => void, b: boolean) { f(b) }
function main() {
  let k = inner
  const flip = () => {
    return k = other
  }
  const r = k
  const fs = [r]
  fs[0](true)
  cb(r, false)
}
main()
