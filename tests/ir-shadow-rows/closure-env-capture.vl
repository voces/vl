// ir shadow: a closure environment, its field reads and an env-to-env copy build and match
// expect covered = 5
// expect matched = 5
function mk(n: i32, s: string): (k: i32) => i32 {
  return (k: i32): i32 => {
    print(s)
    return n + k
  }
}
function mk2(n: i32): () => (k: i32) => i32 {
  return (): (k: i32) => i32 => (k: i32): i32 => n * k
}
const f = mk(3, "a")
print(f(4))
print(mk2(5)()(2))
