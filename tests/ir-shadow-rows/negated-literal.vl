// ir shadow: a negated literal builds as one constant at the negation's width and matches
// expect covered = 3
// expect no row containing uncovered
function a4() { return -2147483647 - 1 }
function a8() { return -9223372036854775807 - 1 }
function b2(x: i32) { return x > -2147483648 }
print(a4())
print(a8())
print(b2(0))
