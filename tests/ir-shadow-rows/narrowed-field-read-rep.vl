// ir shadow: a box local narrowed by a discriminant compare reads an atom field at its storage rep; a string destination is a named miss, never the id claimed as a string
// expect covered >= 1
// expect no row containing fail
// expect no row containing mismatch
type A = { kind: "circle" | "round", r: f64 }
type B = { kind: "a", r: f64 }
function f(n: i32): A | B {
  if n == 0 { return { kind: "circle", r: 1.0 } }
  return { kind: "a", r: 2.0 }
}
function h(b: A | B): string {
  if b.kind == "a" { return b.kind }
  return "x"
}
function g(b: A | B): string[] {
  if b.kind == "a" {
    const xs: string[] = [b.kind]
    return xs
  }
  return []
}
print(h(f(2)))
print(g(f(2))[0])
