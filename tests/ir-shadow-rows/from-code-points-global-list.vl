// ir shadow: fromCodePoints over a global list re-reads the global and matches
// expect covered = 2
// expect matched = 2
let acc: i32[] = []
let names: string[] = []
function commit(): i32 {
  names.push(fromCodePoints(acc))
  acc = []
  return 0
}
function local(): string {
  const xs: i32[] = [104, 105]
  return fromCodePoints(xs)
}
acc.push(111)
acc.push(107)
commit()
print(names[0])
print(local())
