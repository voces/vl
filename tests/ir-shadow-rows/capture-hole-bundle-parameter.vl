// ir shadow: a hole-typed bundle parameter captured by a closure, at each instance
// expect no row containing open temp type
// expect covered >= 45
// expect matched >= 45
// A read of `f` in a closure is held at the bundle record its capture holds (`capReadTy`).
function lapCaptured(f) {
  print(f(3))
  const h = () => f(2.5)
  print(h())
}
function twoClosures(f) {
  const h = () => f(2.5)
  print(h())
  const j = () => f(3)
  print(j())
}
function stored(f) {
  print(f(3))
  const hs = [() => f(2.5)]
  print(hs[0]())
}
function go(k: i32) {
  lapCaptured((a) => a + k)
  twoClosures((a) => a + k)
  stored((a) => a + k)
}
go(1)
function twice(k: i32) {
  lapCaptured((a) => a + k)
  lapCaptured((a) => a * k)
}
twice(10)
function lapIn<T>(f, t: T) {
  print(f(3))
  const h = () => f(2.5)
  print(h())
  print(t)
}
function generic(k: i32) {
  lapIn((a) => a + k, "s")
  lapIn((a) => a * k, true)
  lapIn((a) => a + k, "u")
  lapIn((a) => a * k, "v")
}
generic(10)
