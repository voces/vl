// ir shadow: a tail arm ending in a never-returning call, or in a bare block, is claimed as legacy writes it
// expect covered >= 2
// expect matched >= 2
// expect no row containing tail arm
function die(): never { __trap__() }
function w(k: i32) {
  return match k {
    1 => 3
    _ => die()
  }
}
function k(): i32 { return if true { { 5 } } else { 6 } }
print(w(1))
print(k())
