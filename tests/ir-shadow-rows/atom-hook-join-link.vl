// ir shadow: a value-if link the atom hook writes as a join at the destination
// expect covered >= 2
// expect matched >= 2
// expect no row containing pre-path atom hook
type Arm = "struct" | "variant" | "unionBox"
function armOf(i: i32): Arm { if i == 0 { return "unionBox" } return "struct" }
function f(at: i32, variant: boolean): i32 {
  const arm: Arm = if at < 0 { armOf(at) } else if variant { "variant" } else { "struct" }
  if arm == "unionBox" { return 1 }
  return 0
}
print(f(-1, false))
print(f(2, true))
