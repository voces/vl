// ir shadow: an element read of a list literal led by a valued if, as the right operand after a call, in a function and in the start
// expect matched >= 3
// expect start matched >= 1
// expect no row containing spans: read index
function f(x: i32) { return x }
function g(c: boolean): i32 { return f(1) + [if c { 20 } else { 0 }][0] }
function h(c: boolean): i32 { return f(1) + [f(2), if c { 20 } else { 0 }][1] }
const c = 1 > 0
print(g(c))
print(h(c))
print(f(1) + [if c { 20 } else { 0 }][0])
