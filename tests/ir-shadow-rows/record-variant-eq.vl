// ir shadow: a `==`/`!=` over one record-union arm builds through RStructEq on the variant's row
// expect covered >= 5
// expect matched >= 5
// expect no row containing operand type
type Circle = { kind: "c", r: i32 }
type Label = { kind: "l", text: string, at: Circle }
type Shape = Circle | Label
function area(s: Shape): i32 { return if s is Circle { s.r } else { 0 } }
function mkC(r: i32): Circle { return { kind: "c", r: r } }
function same(a: Circle, b: Circle) { return a == b }
function differ(a: Label, b: Label) { return a != b }
function callRight(a: Circle) { return a == mkC(2) }
function callBoth() { return mkC(3) == mkC(3) }
function narrowed(s: Shape, c: Circle) {
  if s is Circle { return s == c }
  return false
}
print(same(mkC(1), mkC(1)))
print(differ({ kind: "l", text: "a", at: mkC(1) }, { kind: "l", text: "b", at: mkC(1) }))
print(callRight(mkC(2)))
print(callBoth())
print(narrowed(mkC(4), mkC(4)))
print(area(mkC(5)))
