// ir shadow: a variant record returned at its nominal struct twin retags it as itself
// expect matched >= 2
// expect no row containing return coercion
// expect no row containing fail
type B = { base: i32, length: i32 }
type W = new { base: i32, length: i32 }
function size(d: u8[] | B) {
  if d is B { return d.length }
  return d.length
}
function view(b: B, c: i32): W {
  const x = b.base + 1
  return { base: x, length: c }
}
function len(w: W) { return w.length }
const b: B = { base: 3, length: 4 }
print(len(view(b, 5)))
print(size(b))
