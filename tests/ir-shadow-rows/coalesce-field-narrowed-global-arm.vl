// ir shadow: a coalesce over a field of a top-level union narrowed to its record arm re-reads its box
// expect covered >= 1
// expect no row containing fail
type J = { r: i32 | null, g: i32 }
type K = { s: string }
function mk(n: i32): J | K {
  if n > 0 { return { r: n, g: 0 } }
  return { s: "k" }
}
const u = mk(3)
if u is J { print(u.r ?? 0) }
