// ir shadow: a box local read at a narrower or nullable union's box is the same box
// expect covered >= 3
// expect matched >= 3
// expect no row containing fail
type R = { a: i32 }
function show(v: i32 | null) { print(v ?? -1) }
function pastRecord(u: R | i32 | null) {
  if u is R { print(u.a) } else { show(u) }
}
function widened(u: i32 | string) {
  const w: i32 | string | null = u
  print(w is i32)
}
pastRecord({ a: 3 })
pastRecord(4)
pastRecord(null)
widened(2)
