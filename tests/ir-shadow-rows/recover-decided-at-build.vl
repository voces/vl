// ir shadow: a string re-read of an assignment recovers at its non-null type, its non-null count decided where it is built
// expect covered >= 2
// expect matched >= 2
// expect no row containing fail
function nn(v: i32): i32 | null {
  if v < 0 { return null }
  return v
}
function str() {
  let s: string | null = null
  nn(-1) ?? (s = "w").length
  print(s ?? "none")
}
str()
