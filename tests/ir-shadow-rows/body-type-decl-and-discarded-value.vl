// ir shadow: a body-scope type declaration writes nothing, and a discarded value is evaluated and dropped
// expect covered >= 3
// expect matched >= 3
// expect no row containing statement
function area(w: i32, h: i32): i32 {
  type Box = { w: i32, h: i32 }
  const b: Box = { w: w, h: h }
  return b.w * b.h
}
function tag(n: i32): string {
  type K = "small" | "big"
  const k: K = if n < 10 { "small" } else { "big" }
  return k
}
function drops(xs: i32[]): i32 {
  "unused"
  [1, 2]
  xs.length
  return xs[0] + 1
}
print(area(3, 4))
print(tag(3) + tag(30))
print(drops([41]))
