// ir shadow: a list held closed, read at an open type legacy declares no valtype for, reads its storage
// expect covered >= 10
// expect matched >= 10
// expect no row containing narrowed read
// expect no row containing local slot shared across reps
// expect no row containing fail
function inc(a) { return a + 1 }
function dbl(a) { return a * 2 }
function nested(_n) {
  let w = [[inc], [dbl]]
  w = [[dbl], [inc]]
  return w
}
function flat(_n) {
  let u = [inc, dbl]
  u = [dbl, inc]
  return u
}
function take(a) { print(a[1](3)) }
function inner(_n) {
  let w = [[inc, dbl]]
  print(w[0][1](4))
  w = [[dbl, inc]]
  print(w[0][0](4))
}
print(nested(1)[0][0](3))
print(nested("s")[1][0](1.5))
take(flat(1))
inner(1)
inner("s")
