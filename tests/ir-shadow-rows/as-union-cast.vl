// ir shadow: a union-box cast takes legacy's tag test and tail; a niche's as? and as! are the operand
// expect covered >= 4
// expect matched >= 4
// expect uncovered union cast niche propagate = 1
// `opt`, `bang` and `prop` cast a box (`RAsUnion`); `nOpt` and `nBang` a `string | null` niche
// (the operand, `RCast`). `nProp`'s propagating `as` writes its operand inside the block it leaves.
type A = { a: i32 }
type B = { b: i32 }
function opt(u: A | B) {
  const x = u as? A
  return if x == null { 0 } else { x.a }
}
function bang(u: A | B) { return (u as! B).b }
function prop(u: A | B): A | B {
  const x = u as A
  return { a: x.a + 1 }
}
function nOpt(s: string | null) { return (s as? string) ?? "-" }
function nBang(s: string | null) { return (s as! string) + "!" }
function nProp(s: string | null): string | null {
  const t = s as string
  return t + "?"
}
print(opt({ a: 1 }))
print(bang({ b: 2 }))
print(prop({ b: 3 }) is B)
print(nOpt(null))
print(nBang("x"))
print(nProp("y") ?? "n")
