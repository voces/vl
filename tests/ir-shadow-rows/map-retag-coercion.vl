// ir shadow: a union box the table retags on delivery (mapRetag) builds as its value then the retag, and matches
// expect covered >= 4
// expect matched >= 4
// expect start matched >= 1
// expect no row containing pre-path coercion
type U = 1 | "s"
function mk(): U { return 1 }
const x = mk()
const r: i64 | string = x ?? 5
print(r)
function take(v: i64 | string) { print(v) }
take(x ?? 5)
function give(): i64 | string { return x ?? 5 }
print(give())
let a: i64 | string = "z"
a = x ?? 5
print(a)
type R = { v: i64 | string }
const o: R = { v: x ?? 5 }
print(o.v)
const l: (i64 | string)[] = [x ?? 5]
print(l[0])
type W = 9000000000 | 1 | "s"
function mw(): W { return 1 }
const y = mw()
const w: i64 | string = y ?? 5
print(w)
