// ir shadow: a union-box-valued map bound at a map of a wider union is retagged, not converted
// expect start matched >= 1
// expect matched >= 1
// expect no row containing global initializer coercion
// expect no row containing declaration coercion
// expect no row containing global initializer mapBox
// Both maps hold their values in the one box (`boxMapRetag`); each bare read is the map's box
// read at its cell (`mapBox`).
const m: {[string]: i32 | string} = Map()
m["a"] = 3
m["b"] = "x"
const w: {[string]: i32 | string | f64} = m
const va = w["a"]
if va is i32 { print(va + 1) }
const vb = w["b"]
if vb is string { print(vb) }
function f(q: {[string]: i32 | string}) {
  const lw: {[string]: i32 | string | f64} = q
  const lv = lw["b"]
  if lv is string { print(lv) }
}
f(m)
