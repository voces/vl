// ir shadow: a map boxed into a union under its map arm's tag builds and matches
// expect covered >= 2
// expect matched >= 2
// expect no row containing box ladder
// expect no row containing fail
type V = {[string]: i32} | i32
function mk(): V {
  const m: {[string]: i32} = Map()
  m["a"] = 1
  return m
}
function bound() {
  const m: {[string]: i32} = Map()
  const v: V = m
  return if v is i32 { v } else { 0 }
}
print(if mk() is i32 { 1 } else { 2 })
print(bound())
