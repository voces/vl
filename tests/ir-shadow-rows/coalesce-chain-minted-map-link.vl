// ir shadow: in a hole instance, a `??` chain's re-associated inner link `b ?? d` over a map read
// has no type of its own; it is built at the map's non-null value rep, as legacy writes it
// expect covered >= 4
// expect matched >= 4
// expect no row containing mismatch
// expect no row containing fail
// expect no row containing rep ?
// expect no row containing open temp type
type N12 = 1 | 2
type R = { a: {[string]: N12} }
type Q = { a: {[string]: N12 | null} }
function mk(): R {
  const a: {[string]: N12} = Map()
  a["k3"] = 1
  a["k4"] = 2
  return { a: a }
}
function mq(): Q {
  const a: {[string]: N12 | null} = Map()
  a["k4"] = 2
  a["k5"] = null
  return { a: a }
}
function use(p) {
  const r = p.a["k3"] ?? p.a["k4"] ?? 1
  print(r == null)
}
use(mk())
use(mq())
