// ir shadow: a closure over a for-in element or a range counter takes the variable its loop made, at legacy's capture valtype, and matches
// expect covered >= 3
// expect matched >= 3
// expect no row containing callee captures
// expect no row containing capture binding
// expect no row containing mismatch
function walk(xs: f64[]) {
  for z in xs {
    const half = () => z / 2.0
    print(half())
  }
  for i in 0 to 2 {
    const sq = () => i * i
    print(sq())
  }
}
walk([1.5, 3.0])
