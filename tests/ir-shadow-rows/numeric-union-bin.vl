// ir shadow: an operator over a numeric union builds through RNumUnionBin on legacy's dispatch
// expect covered >= 8
// expect matched >= 8
// expect no row containing operand type
function add(a: i32 | f64, b: i32) { return a + b }
function mul(a: i64 | f64) { return a * 3 }
function eq(a: i32 | f64, b: i32) { return a == b }
function lt(a: i32 | f64) { return a < 2 }
function rem(a: i32 | i64) { return a % 3 }
function nest(a: i32 | f64) { return (a + 1) * 2 }
function both(a: i32 | f64, b: i32 | f64) { return (a + 1) + (b * 2) }
function scalarLeft(a: i32 | f64, b: i32) { return b + (a * 3) }
print(add(1, 2))
print(add(1.5, 2))
print(mul(4.5))
print(eq(2, 2))
print(lt(1.5))
print(rem(7))
print(nest(2))
print(both(1.5, 2))
print(scalarLeft(2.5, 1))
