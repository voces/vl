// ir shadow: a call that never returns, as an i32 operand of an operator or a typed binding, is built as a value and the consumer after it
// expect covered >= 6
// expect matched >= 6
// expect no row containing rep novalue
function fail(): never { __trap__() }
function lt(c: boolean) {
  if c { return true }
  return fail() < 2
}
function add(c: boolean) {
  if c { return 1 }
  return fail() + 1
}
function sub(c: boolean) {
  if c { return 2 }
  return 1 - fail()
}
function bound(c: boolean) {
  if c { return 3 }
  const z: i32 = fail()
  return z
}
function wideBound(c: boolean): f64 {
  if c { return 0.5 }
  const y: f64 = fail()
  return y
}
print(lt(true))
print(add(true))
print(sub(true))
print(bound(true))
print(wideBound(true))
