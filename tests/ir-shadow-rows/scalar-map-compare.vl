// ir shadow: a scalar map read against a plain operand is legacy's scalarMap compare, either side
// expect covered >= 2
// expect matched >= 2
// expect no row containing operand type
const gm: {[i32]: i32} = Map()
function g(b: i32, held: i32): i32 {
  const helds: {[i32]: i32} = Map()
  helds[1] = 2
  if helds[b] != held { return 1 }
  if held == helds[b] { return 3 }
  if gm[b] == 4 { return 5 }
  return 0
}
function h(b: i32): boolean {
  const bs: {[i32]: boolean} = Map()
  bs[1] = true
  return bs[b] == true
}
gm[1] = 4
print(g(1, 2))
print(g(1, 3))
print(h(1))
