// ir shadow: a nullable-scalar map value read under ?? peels to its scalar, the default in its kind
// expect covered >= 3
// expect matched >= 3
// expect no row containing map read mv
// expect no row containing fail
function pick(m: {[string]: f64 | null}, k: string) { return m[k] ?? 7.5 }
function count(m: {[string]: i32 | null}, k: string) { return m[k] ?? 0.5 }
function go() {
  const a: {[string]: f64 | null} = Map()
  a["x"] = 2.5
  a["n"] = null
  print(pick(a, "x"))
  print(pick(a, "n"))
  print(pick(a, "z"))
  const b: {[string]: i32 | null} = Map()
  b["c"] = 4
  print(count(b, "c"))
}
go()
