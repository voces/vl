// ir shadow: a scalar map read into its nullable box is the probe's own box
// expect covered >= 3
// expect matched >= 3
// expect no row containing fail
function idG<T>(a: T): T { return a }
function viaHole() {
  const mp = Map()
  mp["k"] = idG
  const g = mp["k"]
  if g != null { print(g(2.5)) }
}
function viaI32(k: string) {
  const q: {[string]: i32} = Map()
  q["a"] = 7
  const v = q[k]
  print(v ?? 0 - 1)
}
viaHole()
viaI32("a")
viaI32("b")
