// ir shadow: a map's keys or values off a global or a field re-read per step
// expect covered >= 2
// expect matched >= 2
// expect no row containing map iter receiver
const cU: {[string]: i32} = Map()
function g(): i32 {
  const ks = cU.keys()
  let i = 0
  let t = 0
  while i < ks.length {
    t = t + (cU[ks[i]] ?? (-1))
    i = i + 1
  }
  return t
}
type H = { m: {[i32]: string} }
function h(x: H): i32 { return x.m.values().length }
cU["a"] = 2
cU["b"] = 3
print(g())
print(h({ m: Map() }))
