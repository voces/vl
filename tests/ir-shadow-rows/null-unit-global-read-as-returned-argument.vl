// ir shadow: a never-filled null unit global read as an argument folds to its destination's null
// expect covered >= 2
// expect matched >= 2
// expect no row containing mismatch
// `ret` hands `nn` on and returns the call's `null` at its nullable result; legacy writes the
// read as `ref.null none`, never a `global.get` of the unit's cell.
type C = { a: i32, b: i32 }
function hid(x) { return x }
const nn = null
function ret(): C | null { return hid(nn) }
print(ret() == null)
const t: C | null = hid(nn)
print(t == null)
