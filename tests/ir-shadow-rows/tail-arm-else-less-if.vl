// ir shadow: an else-less if ending a tail arm is a T | null value written as an else-less link
// expect covered >= 3
// expect matched >= 3
// expect no row containing tail arm
type P = { a: i32 }
function f(c: boolean, d: boolean) {
  return if c {
    if d { 5 }
  } else {
    6
  }
}
function s(c: boolean, d: boolean) {
  return if c {
    if d { "a" }
  } else {
    "b"
  }
}
function p(c: boolean, d: boolean): P | null {
  return if c {
    if d { { a: 5 } }
  } else {
    { a: 6 }
  }
}
print(f(true, true))
print(f(true, false))
print(f(false, true))
print(s(true, false))
print(s(false, false))
const p1 = p(true, true)
if p1 != null { print(p1.a) }
print(p(true, false) == null)
