// ir shadow: a push whose value stages a receiver, onto a local list
// expect covered >= 1
// expect matched >= 1
// expect no row containing push late receiver
const gD: i32[] = [1, 2, 3]
function fl(mark: i32): i32 {
  const ds: i32[] = []
  while gD.length > mark {
    ds.push(gD.pop() ?? -1)
  }
  return ds.length
}
print(fl(1))
