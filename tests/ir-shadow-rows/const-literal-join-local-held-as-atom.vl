// ir shadow: a `const` joining two const-bound literals is held as the joined set's atom
// (`letAtomCellTy`), read and captured where its text is wanted, as legacy decodes it
// expect covered >= 2
// expect matched >= 2
// expect no row containing mismatch
// expect no row containing fail
// expect no row containing atom cell local rep
const A = "x"
const B = "y"
function show(c: boolean) {
  const M = if c { A } else { B }
  print(M)
  const g = () => "<" + M + ">"
  print(g())
}
show(true)
show(false)
