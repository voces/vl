// ir shadow: a literal place narrowed out of a mixed box into an atom destination builds legacy's atom tower
// expect covered >= 5
// expect matched >= 5
// expect no row containing pre-path atom hook
type M = 1 | "a" | "b"
type N = 1 | "a" | "b" | "c"
function onlyAB(v: "a" | "b") { return v + "!" }
function arg(m: M) {
  if m != 1 { print(onlyAB(m)) }
}
function bound(m: M) {
  if m != 1 {
    const v: "a" | "b" = m
    print(v)
  }
}
function three(n: N) {
  if n != 1 {
    const v: "a" | "b" | "c" = n
    print(v)
  }
}
function ret(m: M): "a" | "b" {
  if m != 1 { return m }
  return "a"
}
arg("a")
bound("b")
three("c")
print(ret("b"))
