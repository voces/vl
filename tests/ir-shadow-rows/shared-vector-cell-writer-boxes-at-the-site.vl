// ir shadow: a shared v128 let's writer boxes the vector into its v128 | null cell
// expect covered >= 2
// expect no row containing store element
// expect no row containing fail
// The writer is lifted through its cell; its capture parameter is typed at the cell's rep
// (`liftCapVar`). The reader's `union cast operand rep` is another class.
function go(k: i32) {
  let u: v128
  const set = (x: i32) => {
    u = __splat_i32x4__(x)
  }
  const get = (): i32 => __extract_lane_i32x4__(u, 1)
  set(k)
  print(get())
  set(k + 1)
  print(get())
}
go(4)
