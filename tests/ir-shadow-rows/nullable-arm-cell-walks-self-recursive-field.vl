// ir shadow: a narrowed arm bound into a nullable arm cell, walked through its own self-typed field
// expect covered >= 1
// expect matched >= 1
// expect no row containing member record
// `sum` binds the narrowed `u` into `c: O | null`, which legacy casts to as a nullable ref
// (the cell's kind, not the value's), then reads `c.next`, a `nulstruct` field holding `O`.
type O = { n: i32, next: O | null }
type P = { m: i32 }
type U = O | P
function sum(u: U) {
  if u is O {
    let t = 0
    let c: O | null = u
    while c != null {
      t = t + c.n
      c = c.next
    }
    return t
  }
  return u.m
}
print(sum({ n: 1, next: { n: 2, next: null } }))
print(sum({ m: 5 }))
