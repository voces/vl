// ir shadow: an operand built before a void if (a null-typed one run for its effect) waits on the stack below it, a string concat's earlier part and a binary operator's left alike
// expect covered >= 3
// expect matched >= 3
// expect no row containing string operand after another
function add(k: i32, c: boolean) {
  const x = null
  return k + ((if c { x } else { x }) ?? 11)
}
function eq(k: i32, c: boolean) {
  const x = null
  return k == ((if c { x } else { x }) ?? 11)
}
function concat(c: boolean) {
  const x = null
  return "<" + ((if c { x } else { x }) ?? "c") + ">"
}
print(add(1, true))
print(eq(11, false))
print(concat(true))
