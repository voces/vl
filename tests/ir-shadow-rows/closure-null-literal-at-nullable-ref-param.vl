// ir shadow: a `null` literal handed to a function value's nullable closure or map parameter is
// built at that parameter's rep
// expect no row containing closure argument coercion
// expect matched >= 4
function onFn(x: ((n: i32) => i32) | null) {
  if x == null { print("fn null") } else { print("fn \{x(3)}") }
}
function onMap(x: {[string]: i32} | null) {
  if x == null { print("map null") } else { print("map \{x.length}") }
}
function callFn() {
  const f = onFn
  f(null)
  f((n: i32) => n * 2)
}
function callMap() {
  const m = onMap
  m(null)
  const mm: {[string]: i32} = Map()
  mm.set("k", 1)
  m(mm)
}
callFn()
callMap()
