// ir shadow: a `null` literal handed to a function value's nullable closure or map parameter is
// built at that parameter's rep
// expect no row containing closure argument coercion
// expect matched >= 4
function onFn(x: ((n: i32) => i32) | null): i32 {
  if x == null { return 7 }
  return x(3)
}
function onMap(x: {[string]: i32} | null): i32 {
  if x == null { return 8 }
  return x.length
}
function callFn() {
  const f = onFn
  print(f(null))
  print(f((n: i32) => n * 2))
}
function callMap() {
  const m = onMap
  print(m(null))
  const mm: {[string]: i32} = Map()
  mm.set("k", 1)
  print(m(mm))
}
callFn()
callMap()
