// ir shadow: an assignment of one member of a literal-union field or element re-reads its atom; as a compare operand the IR declines it by name
// expect uncovered assignment-value atom re-read as a compare operand = 1
// expect matched >= 2
// expect no row containing fail
// expect no row containing mismatch
type K = "zz" | "ww"
function show(k: K) { print(k) }
function arg() {
  const o: { f: K } = { f: "zz" }
  show(o.f = "ww")
}
function cat() {
  const o: { f: K } = { f: "zz" }
  print("<" + (o.f = "ww") + ">")
}
function bind() {
  const o: { f: K } = { f: "zz" }
  const k: K = o.f = "ww"
  print(k)
}
function cmp() {
  const o: { f: K } = { f: "zz" }
  print((o.f = "ww") == "ww")
}
arg()
cat()
bind()
cmp()
