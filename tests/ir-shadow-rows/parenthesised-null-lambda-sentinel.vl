// ir shadow: a parenthesised null lambda body returns its sentinel result's null
// expect covered >= 5
// expect matched >= 5
// expect no row containing expression null
// `deliver` asks the literal inside the parens for its own null (`nullOwnAt`), the sentinel.
type K = "a" | "b"
function useB(p: () => boolean | null) {
  const t = p()
  if t != null { print(t) } else { print("NULL") }
}
function useK(p: () => K | null) {
  const t = p()
  if t != null { print(t) } else { print("NULL") }
}
useB(() => (null))
useK(() => (null))
useB(() => true)
