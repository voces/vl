// ir shadow: a tail arm whose last statement legacy writes as a statement builds as one
// expect covered >= 3
// expect matched >= 3
// expect no row containing rep ?
function lit(k: 1 | 2) {
  return match k {
    _ => {
      7
    }
  }
}
function pair(k: "a" | "b") {
  return match k {
    _ => {
      k + "!"
    }
  }
}
function rec(k: { x: i32 } | { y: i32 }) {
  return match k {
    _ => {
      3
    }
  }
}
print(lit(1))
print(pair("a"))
print(rec({ x: 1 }))
