// ir shadow: a closure call into a union-arm parameter takes an argument already of that arm as it stands, and matches
// expect covered >= 5
// expect matched >= 5
// expect no row containing call of a non-declaration
// expect no row containing mismatch
type A = { k: "a", v: i32 }
type B = { k: "b", w: string }
const both = (p: A | B): i32 => {
  return if p.k == "a" { p.v } else { 7 }
}
function call(f: (p: A) => i32): i32 { return f({ k: "a", v: 5 }) }
function viaLocal(): i32 {
  const f: (p: A) => i32 = both
  const a: A = { k: "a", v: 9 }
  return f(a)
}
print(call(both))
print(viaLocal())
