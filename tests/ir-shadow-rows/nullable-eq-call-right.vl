// ir shadow: a nullable compare's call operand over pure arguments is built once per path
// expect covered >= 3
// expect matched >= 3
// expect no row containing nullable eq right operand
type P = "i32" | "i64" | "f64"
function rp(i: i32): P | null { if i == 0 { return null } return "i64" }
function kp(k: i32): string { if k == 1 { return "i32" } return "i64" }
function hc(i: i32, k: i32): i32 {
  if k != 0 && rp(i) != kp(k) { return 1 }
  return 0
}
print(hc(1, 1))
print(hc(1, 2))
