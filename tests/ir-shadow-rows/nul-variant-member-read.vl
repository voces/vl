// ir shadow: a field read off a narrowed `Node | null` local is the receiver, made non-null, then
// the variant's field, as legacy's `emitMemNulVariantRead` writes it
// expect no row containing member record
// expect matched >= 2
type Node = { v: i32, next: Node | null }
type M = Node & { v: i32 }
function f(m: M) {
  const nx = m.next
  if nx != null { print(nx.v) } else { print(0) }
}
const tail: Node = { v: 5, next: null }
f({ v: 1, next: tail })
f({ v: 2, next: null })
