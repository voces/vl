// ir shadow: a record list returned where the result's type holds a hole retags it as itself
// expect covered >= 2
// expect matched >= 2
// expect no row containing return coercion
// expect no row containing fail
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function pick(b: boolean) {
  if b { return [{ f: inc0 }] }
  const xs = [{ f: dbl }]
  return xs
}
print(pick(true)[0].f(3))
print(pick(false)[0].f(3))
