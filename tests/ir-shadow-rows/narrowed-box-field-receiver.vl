// ir shadow: a variant field read off a narrowed box field
// expect covered >= 1
// expect matched >= 1
// expect no row containing member record
type OV = { ov: i32 }
type OS = { os: string }
type OI = { oi: i32, oj: i32 }
type Op = OV | OS | OI
type SR = { srV: Op, srStash: boolean }
type SB = { brV: Op, brHas: boolean }
type St = SR | SB
function f(n: St): i32 {
  match n {
    SR => {
      if !n.srStash && (!(n.srV is OV) || n.srV.ov < 0) { return -1 }
      return 1
    }
    SB => {
      if n.brHas && !(n.brV is OV && n.brV.ov > 2) { return -2 }
      return 2
    }
  }
}
print(f({ srV: { ov: 2 }, srStash: false }))
print(f({ brV: { ov: 1 }, brHas: true }))
