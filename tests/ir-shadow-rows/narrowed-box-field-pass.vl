// ir shadow: a narrowed box field the box plan passes to a union parameter
// expect covered >= 2
// expect matched >= 2
// expect no row containing narrowed field unbox rep
type OV = { ov: i32 }
type OS = { os: string }
type OI = { oi: i32, oj: i32 }
type Op = OV | OS | OI
type LF = { lfV: Op, lfAt: i32 }
type MS = { msSym: i32, msLoc: Op }
type R = LF | MS
function opRep(o: Op): i32 {
  if o is OV { return o.ov }
  return -1
}
function chk(r: R): i32 {
  return match r {
    LF => if !(r.lfV is OV) || opRep(r.lfV) < 0 { 1 } else { 0 }
    MS => {
      if r.msSym >= 0 && r.msLoc is OV {
        if opRep(r.msLoc) != r.msSym { return 2 }
      }
      0
    }
  }
}
print(chk({ lfV: { ov: 3 }, lfAt: 0 }))
print(chk({ msSym: 2, msLoc: { ov: 3 } }))
