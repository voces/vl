// ir shadow: a Map() whose own type is open is built at its record field's map
// expect covered >= 1
// expect matched >= 1
// expect no row containing rep unsup
type TO = { names: string[], tys: i32[], fix: {[string]: i32}, flen: i32 }
type TP = { pn: string }
type TT = TO | TP
const all: TT[] = []
function mk(names: string[], tys: i32[]) {
  const t: TT = { names: names, tys: tys, fix: Map(), flen: 0 }
  all.push(t)
  return all.length - 1
}
print(mk(["a"], [1]))
