// ir shadow: a call through a copy of a returned bundle's annotated holder picks its member, and matches
// expect covered >= 4
// expect matched >= 4
// expect no row containing call of a non-declaration
// expect no row containing mismatch
function lap(f) {
  f(2.5)
  f(3)
  return f
}
const d: (x: f64) => f64 = lap((a) => a / 2)
const e = () => {
  const v = d
  print(v(3))
}
function twice(): f64 {
  const w = d
  return w(5) + w(1)
}
e()
print(twice())
