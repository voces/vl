// ir shadow: a zero-extending load fold is a named miss, never a mismatch
// expect uncovered zero-extending load mask = 1
// expect uncovered expression as zextLoad = 1
// expect matched >= 1
// expect no row containing mismatch
function wrap32(p: i32): i64 {
  return (__load_i32__(p, 0) as% i64) & 4294967295
}
function u16bare(p: i32): i64 { return __load_u16__(p) as i64 }
function low(p: i32): i32 { return __load_i32__(p) & 255 }
__store_i32__(64, -1)
print(wrap32(64))
print(u16bare(64))
print(low(64))
