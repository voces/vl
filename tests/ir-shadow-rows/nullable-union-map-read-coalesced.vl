// ir shadow: a union-with-null map value read under ?? keeps the box, the default boxed into it
// expect covered >= 3
// expect matched >= 3
// expect no row containing map read mv
// expect no row containing fail
function wide(m: {[string]: i32 | string | null}, k: string) {
  const v = m[k] ?? 7
  if v is i32 { print(v) } else { print(v) }
}
function chain(m: {[string]: i32 | null}, a: string, b: string) {
  const v = m[a] ?? m[b]
  if v != null { print(v) }
}
function go() {
  const m: {[string]: i32 | string | null} = Map()
  m["n"] = 4
  m["s"] = "hi"
  m["z"] = null
  wide(m, "n")
  wide(m, "q")
  wide(m, "s")
  wide(m, "z")
  const c: {[string]: i32 | null} = Map()
  c["x"] = 5
  chain(c, "x", "y")
  chain(c, "y", "x")
}
go()
