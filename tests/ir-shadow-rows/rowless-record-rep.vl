// ir shadow: a record type no struct row records, held at the row legacy stores it in
// expect covered >= 3
// expect matched >= 3
// expect no row containing ref if arm rep
// expect no row containing declaration coercion
// expect no row containing mismatch
type J = { f: i32 | null }
function join(x: i32) {
  const n = if x > 0 { { f: 5 } } else { { f: 4 } }
  const b: J = n
  print(b.f ?? 70)
}
function widen() {
  const sv = { b: 7 }
  const u: {b: i32 | null} = sv
  print(u.b ?? 0)
}
function take(j: J) { print(j.f ?? 70) }
join(3)
join(0)
widen()
take(if 1 > 0 { { f: 6 } } else { { f: 1 } })
