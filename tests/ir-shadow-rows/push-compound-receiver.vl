// ir shadow: a push onto a call result or a coalesced map read
// expect covered >= 3
// expect matched >= 3
// expect no row containing push receiver payload cast
const rows: i32[][] = [[], []]
function rowsOf(k: i32): i32[] { return rows[k] }
function bp(k: i32, v: i32): i32 {
  rowsOf(k).push(v)
  return rowsOf(k).length
}
function mc(d: i32, ix: i32): i32 {
  const makerCalls: {[i32]: i32[]} = Map()
  makerCalls[d] = []
  if d >= 0 && makerCalls.has(d) { (makerCalls.get(d) ?? []).push(ix) }
  return (makerCalls.get(d) ?? []).length
}
print(bp(1, 5))
print(mc(2, 7))
