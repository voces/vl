// ir shadow: a ?? over an atom niche or a boolean | null is its niche cell's if, the operand re-read or stashed as legacy writes it
// expect covered >= 6
// expect uncovered coalesce niche place >= 1
type K = "a" | "b"
type R = { k: K | null }
function kOf(n: i32): K | null { return if n > 0 { "a" } else { null } }
function bOf(n: i32): boolean | null { return if n > 0 { true } else { null } }
function rOf(n: i32): R { return { k: kOf(n) } }
function param(k: K | null): K { return k ?? "b" }
function local(n: i32): K {
  const k = kOf(n)
  return k ?? "b"
}
function call(n: i32): K { return kOf(n) ?? "b" }
function fieldOfCall(n: i32): K { return rOf(n).k ?? "b" }
function boolCall(n: i32): boolean { return bOf(n) ?? false }
function boolParam(v: boolean | null): boolean { return v ?? true }
function fieldPlace(r: R): K { return r.k ?? "b" }
print(param(null))
print(local(1))
print(call(0))
print(fieldOfCall(1))
print(boolCall(0))
print(boolParam(null))
print(fieldPlace({ k: null }))
