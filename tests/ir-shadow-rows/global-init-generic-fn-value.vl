// ir shadow: a hole or generic function's value initializing an annotated global
// expect no row containing global initializer coercion
// expect start covered >= 1
// expect start matched >= 1
// The value is the instance legacy picks for the cell, whose own closure rep is the cell's
// (`instanceClosureRep`), typed at the cell's type.
function id(x) { return x }
function other(x) { return x }
print(id(1))
print(id("s"))
const f: (x: string) => string = id
const g: (x: i32) => i32 = id
const h: (x: string) => string = id
const o: (x: string) => string = other
print(f === id)
print(g === id)
print(f === h)
print(f === o)
function scale(a) { return a * 1.5 }
const f2: (a: i32) => f64 = scale
print(f2(3))
const g2: (a: i32) => f64 = (a) => a * 1.5
print(g2(3))
const h2: (a: i32) => f64 = (a) => a + 1
print(h2(3))
