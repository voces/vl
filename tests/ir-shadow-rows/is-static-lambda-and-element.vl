// ir shadow: a static is in a lambda, or over an element read, is its decided plan's constant
// expect covered >= 4
// expect no row containing uncovered
function lam<T>(v: T): boolean {
  const g = () => v is T
  return g()
}
function a32(x) {
  const xs = [x, x + 1.5]
  print(xs[1] is f32)
}
print(lam(2))
a32(1.25 as f32)
