// ir shadow: a ?? whose stashed operand is an if
// expect covered >= 3
// expect matched >= 3
// expect no row containing coalesce box stash operand
function a(i: i32): i32 | null {
  if i == 0 { return null }
  return i
}
function f(c: i32, d: boolean): i32 {
  const row = (if d { a(c) } else { a(c + 1) }) ?? -1
  return row
}
function g(c: i32): i32 { return a(c) ?? a(c + 1) ?? -1 }
print(f(0, true))
print(f(0, false))
print(g(0))
