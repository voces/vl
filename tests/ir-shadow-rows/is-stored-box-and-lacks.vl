// ir shadow: an is over a narrowed name or element read at its storage tests the declared box's tag, and a map the box cannot hold is the receiver dropped then false
// expect covered >= 4
// expect matched >= 4
// expect no row containing is arm tag box
// expect no row containing is arm tag lacks
// expect no row containing is stored box
const xs: (i32 | string)[] = [1]
function wx() { xs[0] = "s" }
function id<X>(x: X): X { return x }
function lacks<T>(u: T | string): boolean { return id(u) is Set<i32> }
const q: {[i32]: boolean} = Map()
const uq: {[i32]: boolean} | string = q
let u: i32 | f64 = 5
if u is i32 { print(u) }
u = 3.5
if u is f64 { print(u) }
if xs[0] is i32 {
  const c = (): boolean => xs[0] is i32
  wx()
  print(c())
}
print(lacks<{[i32]: boolean}>(uq))
