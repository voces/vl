// ir shadow: a record's function-valued field named `push`, called with no argument or with two,
// is the record's closure call, not a list's variadic push
// expect covered >= 3
// expect matched >= 3
// expect no row containing mismatch
// expect no row containing fail
// expect no row containing record field
type P = { push: () => i32 }
type Q = { push: (x: i32, y: i32) => i32 }
function zero(a: P) { print(a.push()) }
function two(a: Q) { print(a.push(2, 3)) }
zero({ push: () => 9 })
two({ push: (x, y) => x + y })
