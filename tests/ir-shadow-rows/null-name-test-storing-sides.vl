// ir shadow: a null name test whose null side stores is written as legacy writes it, a right side after the staged test, a left side dropped before an effectful test
// expect covered >= 3
// expect matched >= 3
// expect no row containing null name test of a null side that stores
function zz(z: i32 | null) {
  print("zz")
  return z
}
function right(z: i32 | null) {
  let n = null
  print(z == (n = null))
  print(zz(z) != (n = null))
}
function pairs() {
  let m = null
  let k = null
  const n = null
  print((m = n) == (k = n))
}
function left(z: i32 | null) {
  let n = null
  print((n = null) == zz(z))
}
right(3)
pairs()
left(null)
