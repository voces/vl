// ir shadow: a null-only call delivered at a sentinel or a nullable record cell, module and local
// expect start matched >= 1
// expect matched >= 2
// expect no row containing global initializer coercion
// expect no row containing declaration coercion
// The call is run and dropped, then the cell's sentinel (`emitDirectCallTail`); at a nullable
// record it is the bottom ref, retagged.
type C = { a: i32 }
type K = "a" | "b"
function np() { return null }
const gb: boolean | null = np()
print(gb == null)
const gk: K | null = np()
print(gk == null)
function f() {
  const lb: boolean | null = np()
  print(lb == null)
  const lk: K | null = np()
  print(lk == null)
  const lc: C | null = np()
  if lc != null { print(lc.a) } else { print("none") }
}
f()
type W = { f: C | null }
const w: W = { f: np() }
if w.f != null { print(w.f.a) } else { print("none") }
