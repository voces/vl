// ir shadow: an open-typed read of a binding the IR holds closed reads its storage
// expect covered >= 28
// expect matched >= 28
// expect no row containing closure temp at an open type's rep
// expect no row containing array element coercion
// expect no row containing narrowed read
// expect no row containing local slot shared across reps
// expect no row containing fail
function adder(n) {
  const f = (a) => a + n
  return f
}
function gadder<T>(n: T) {
  const f = (a) => a + n
  return f
}
function inc0(a) { return a + 1 }
function dbl0(a) { return a * 2 }
function nested(_n) {
  let u = [[inc0], [dbl0]]
  return u
}
function takeNested(a) { print(a[1][0](3)) }
function flat(_n) {
  let u = [inc0, dbl0]
  return u
}
function takeFlat(a) { print(a[0](3)) }
function inList<T>(x: T) {
  let k = (n) => {
    print("R")
    print(n)
  }
  k = (n) => {
    print("S")
    print(n)
  }
  const fs = [k]
  fs[0](x)
}
function inRecord<T>(x: T) {
  let k = (n) => {
    print(n)
    return 1
  }
  k = (n) => {
    print(n)
    return 2
  }
  const o = { f: k }
  print(o.f(x))
}
const x = adder(1.5)
print(x(2.0))
const g = gadder(1.5)
print(g(2.0))
takeNested(nested(1))
takeFlat(flat(1))
inList(3)
inList("s")
inRecord(5)
inRecord("u")
