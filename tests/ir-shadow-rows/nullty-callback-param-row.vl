// ir shadow: a `null`-typed field's null test on a callback parameter reads the row the parameter is held at, the drop in the test's place
// expect covered >= 3
// expect matched >= 3
// expect no row containing null test nullty
// expect no row containing mismatch
type J = { f: i32 | null }
function mk2() { return { f: null } }
const dA: J = mk2()
const src = [mk2()]
print(src.filter((y: { f: null }) => y.f == null).length)
const ks = src.map((y) => {
  return { n: 2, s: [y.f == null] }
})
print(ks[0].s[0] && dA.f == null)
