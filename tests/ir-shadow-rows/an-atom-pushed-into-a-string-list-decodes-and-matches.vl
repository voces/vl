// ir shadow: an atom pushed into a string list decodes and matches
// expect covered = 3
// expect matched = 3
type K = "i32" | "f64" | "str"
type P = { name: K, n: i32 }
function names(ps: P[]): string[] {
  const out: string[] = []
  for p in ps { out.push(p.name) }
  return out
}
function opt(p: P): (string | null)[] {
  const out: (string | null)[] = []
  out.push(p.name)
  out.push(null)
  return out
}
function lit(): string[] {
  const out: string[] = []
  const k: K = "f64"
  out.push(k)
  return out
}
const ps: P[] = [{ name: "i32", n: 1 }, { name: "str", n: 2 }]
print(names(ps)[1])
print(opt(ps[0]).length)
print(lit()[0])
