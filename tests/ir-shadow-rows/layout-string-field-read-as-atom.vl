// ir shadow: a literal-set field its layout family stores as its string, read as its atom off a
// union member and off an anonymous record of that shape, is read at the string it holds
// expect no row containing member record
// expect matched >= 3
type K = "circle" | "round"
type A = { kind: K, r: i32 }
type B = { kind: string, r: i32 }
type H = { a: A, n: i32 }
function mk(n: i32): A | B {
  if n == 0 { return { kind: "round", r: 1 } }
  return { kind: "zz", r: 2 }
}
function useA(a: A) { print("a " + a.kind) }
function anon(o: { kind: K, r: i32 }) { print("o " + o.kind) }
function nested(h: H) { print("h " + h.a.kind) }
useA({ kind: "circle", r: 1 })
anon({ kind: "round", r: 2 })
nested({ a: { kind: "circle", r: 3 }, n: 1 })
print(mk(1).r)
