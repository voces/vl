// ir shadow: a module global union read as a narrowed field's receiver is its box, at the start
// expect start covered >= 1
// expect start matched >= 1
// expect no row containing fail
type Rect = { kind: "rect", w: i32, h: i32 }
type Circle = { kind: "circle", r: i32 }
type Shape = Rect | Circle
const sh: Shape = { kind: "rect", w: 2, h: 3 }
if sh is Rect {
  print(sh.w)
  print(sh.h)
}
