// ir shadow: an object literal whose later field is a valued if after another
// expect covered >= 2
// expect matched >= 2
// expect no row containing short-circuit field after another
type EP = { epSlot: i32, epK: i32 }
type Plan = { erL: EP, erR: EP }
const ROOT: EP = { epSlot: -1, epK: 0 }
function place(a: i32): EP { return { epSlot: a, epK: 1 } }
function f(lE: boolean, rE: boolean, a: i32): i32 {
  const plan: Plan = {
    erL: if lE { place(a) } else { ROOT },
    erR: if rE { place(a + 1) } else { ROOT },
  }
  return plan.erL.epSlot + plan.erR.epSlot
}
print(f(true, false, 3))
