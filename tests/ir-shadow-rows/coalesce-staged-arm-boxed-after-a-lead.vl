// ir shadow: a niche or nullable-reference ?? boxed into a union argument after a lead writes the lead first; a tag-only box goes late
// expect verified >= 13
// expect no row containing fail
// expect no row containing mismatch
function show(v: i32 | boolean): string {
  if v is i32 { return "int" }
  return "bool"
}
function showS(v: i32 | string): string {
  if v is i32 { return "int" }
  return "str"
}
function showR(v: i32 | { x: i32 }): string {
  if v is i32 { return "int" }
  return "rec"
}
function pairB(f: string, v: i32 | boolean): string { return f + show(v) }
function pairS(f: string, v: i32 | string): string { return f + showS(v) }
function pairR(f: string, v: i32 | { x: i32 }): string { return f + showR(v) }
function two(a: string, b: string): string { return a + b }
function dflt(): string {
  print("default")
  return "d"
}
function b1(f: string, rc: boolean | null): string {
  return f + show(rc ?? false)
}
function b2(f: string, rc: boolean | null): string {
  return pairB(f, rc ?? false)
}
function b3(f: string, rc: boolean | null): string {
  return two(f, show(rc ?? true))
}
function l1(f: string, k: "a" | "b" | null): string {
  return f + showS(k ?? "a")
}
function l2(f: string, k: "a" | "b" | null): string {
  return pairS(f, k ?? "a")
}
function s1(f: string, s: string | null): string {
  return f + showS(s ?? dflt())
}
function s2(f: string, s: string | null): string {
  return pairS(f, s ?? dflt())
}
function r1(f: string, r: { x: i32 } | null): string {
  return f + showR(r ?? { x: 9 })
}
function r2(f: string, r: { x: i32 } | null): string {
  return pairR(f, r ?? { x: 9 })
}
print(b1("a", null))
print(b2("b", true))
print(b3("c", null))
print(l1("d", null))
print(l2("e", "b"))
print(s1("f", null))
print(s2("g", "s"))
print(r1("h", null))
print(r2("i", { x: 4 }))
