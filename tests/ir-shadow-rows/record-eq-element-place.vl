// ir shadow: a record compare side legacy re-reads as a list element is written at every field read
// expect covered >= 23
// expect matched >= 23
// expect no row containing record compare place operand
import { includes, indexOf } from "std:array"

type Pt = { x: i32, name: string }
type Seg = { a: Pt, b: Pt }
function firstTwo(ps: Pt[]) { return ps[0] == ps[1] }
function at(ps: Pt[], i: i32, q: Pt) { return ps[i] != q }
function nested(ss: Seg[], i: i32, t: Seg) { return ss[i] == t }
function find(ps: Pt[], q: Pt): i32 {
  let i = 0
  while i < ps.length {
    if ps[i] == q { return i }
    i = i + 1
  }
  return -1
}
const ps: Pt[] = [{ x: 1, name: "a" }, { x: 1, name: "a" }, { x: 2, name: "b" }]
print(firstTwo(ps))
print(at(ps, 2, { x: 2, name: "b" }))
print(nested([{ a: ps[0], b: ps[2] }], 0, { a: ps[1], b: ps[2] }))
print(find(ps, { x: 2, name: "b" }))
print(indexOf(ps, { x: 2, name: "b" }))
print(includes(ps, { x: 3, name: "c" }))
