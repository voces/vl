// ir shadow: a union-box local narrowed to a ref list or a map arm reads unboxed to it
// expect covered >= 3
// expect matched >= 3
// expect no row containing fail
type Ca = { n: i32 }
type Sq = { s: i32 }
type U = {[i32]: i32} | string
function firstN(c: Ca[] | i32) {
  if c is i32 { print(c) } else { print(c[0].n) }
}
function walk(c: Ca[] | i32) {
  if c is i32 { print(c) } else { for e in c { print(e.n) } }
}
function sizeOf(u: U) {
  if u is {[i32]: i32} { print(u.length) } else { print(u) }
}
firstN([{ n: 7 }])
firstN(3)
walk([{ n: 8 }, { n: 9 }])
const m: {[i32]: i32} = Map()
m[1] = 2
sizeOf(m)
sizeOf("s")
