// ir shadow: a type parameter only `null` binds is `never`, so each guarded read of it, at each
// delivery position but interpolation, which this harness cannot compile, is legacy's
// `unreachable` at its consumer's rep (Q58 position sweep)
// expect no row containing pre-path dead never
// expect no row containing fail
function g<T>(t: T): T { return t }
function sU(p: i32 | string): i32 { return if p is i32 { p } else { 0 } }
function argBuiltin<Z>(z: Z | null) {
  if z != null { print(z) }
}
function argGeneric<Z>(z: Z | null) {
  if z != null { print(g(z)) }
}
function nested<Z>(z: Z | null) {
  if z != null { print(g(g(z))) }
}
function argUnion<Z>(z: Z | null) {
  if z != null { print(sU(z)) }
}
function cat<Z>(z: Z | null) {
  if z != null { print("a" + z) }
}
function coal<Z>(z: Z | null) {
  if z != null { print(z ?? 1) }
}
argBuiltin(null)
argGeneric(null)
nested(null)
argUnion(null)
cat(null)
coal(null)
print("end")
