// ir shadow: a union of maps every member stores as one map is delivered as that map, its box's payload cast
// expect covered >= 3
// expect matched >= 3
// expect start covered >= 1
// expect start matched >= 1
// expect no row containing mapUnbox
type LM = {[i32]: 1 | 2}
type IM = {[i32]: i32}
function lenOf<T>(m: {[i32]: T}) { return m.length }
function mkL(): LM | IM {
  const m: LM = Map()
  m.set(1, 1)
  return m
}
const mi: IM = Map()
mi.set(3, 4)
const u: LM | IM = mi
function viaParam(x: LM | IM) { return lenOf(x) }
print(viaParam(mi))
print(lenOf(mkL()))
print(lenOf(u))
