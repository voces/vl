// ir shadow: a ?? over a record's value-union field is the record, the field's null test, the default, and the field's box or payload
// expect covered >= 2
type R = { v: i32 | null | string }
type S = { n: i32 | null }
function keep(r: R): i32 | string { return r.v ?? "d" }
function val(s: S): i32 { return s.n ?? 7 }
print(keep({ v: 3 }))
print(keep({ v: null }))
print(val({ n: 4 }))
print(val({ n: null }))
