// ir shadow: hole map reads under ?? joined into a union box, each null-test arm boxed into the join's union
// expect covered >= 5
// expect matched >= 5
// expect no row containing box ladder
// expect no row containing union if arm rep
// expect no row containing fail
type AB = "a" | "b"
type R = { a: {[i32]: boolean | null}, b: {[i32]: i32} }
type S = { a: {[i32]: i32}, b: {[i32]: AB} }
function show(x) { print(x) }
function mkR(): R {
  const a: {[i32]: boolean | null} = Map()
  a[3] = false
  a[5] = null
  const b: {[i32]: i32} = Map()
  b[3] = 2
  return { a: a, b: b }
}
function mkS(): S {
  const a: {[i32]: i32} = Map()
  a[3] = 7
  const b: {[i32]: AB} = Map()
  b[4] = "b"
  return { a: a, b: b }
}
function useR(p) {
  print(p.a[9] ?? p.b[3])
  print(p.a[3] ?? p.b[3])
}
function useS(p) {
  show(p.a[3] ?? p.b[4])
  show(p.a[8] ?? p.b[4])
}
useR(mkR())
useS(mkS())
