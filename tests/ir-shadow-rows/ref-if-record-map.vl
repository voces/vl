// ir shadow: a value if joined at a record or map reference builds and matches
// expect covered = 5
// expect matched = 5
// expect no row containing expression if ref
type P = { x: i32, y: i32 }
function pick(k: boolean, a: P, b: P): P { return if k { a } else { b } }
function chain(k: i32, a: P, b: P, c: P): P {
  return if k == 0 { a } else if k == 1 { b } else { c }
}
function mkp(k: boolean): P {
  const p = if k { { x: 1, y: 2 } } else { { x: 3, y: 4 } }
  return p
}
function mp(k: boolean, a: Map<string, i32>, b: Map<string, i32>): Map<string, i32> {
  return if k { a } else { b }
}
function np(k: boolean, a: P): P | null { return if k { a } else { null } }
const a: P = { x: 1, y: 2 }
const b: P = { x: 5, y: 6 }
print(pick(false, a, b).x)
print(chain(2, a, b, a).y)
print(mkp(false).y)
const m1: Map<string, i32> = Map()
m1["q"] = 4
print(mp(true, m1, m1)["q"] ?? 0)
print(np(true, a)?.x ?? 0)
