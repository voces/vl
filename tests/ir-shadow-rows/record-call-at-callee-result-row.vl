// ir shadow: a record call whose type keys its callee's result row is the callee's result as it stands
// expect start matched >= 1
// expect no row containing call result coercion
function rec() {
  const r = { x: 1, y: "a" }
  const s = r
  return s
}
function take(p: { x: i64, y: string }): void {
  print(p.x)
  print(p.y)
}
take(rec())
