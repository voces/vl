// ir shadow: fromCodePoints over a literal list is read once into its spill slot
// expect covered >= 2
// expect matched >= 2
// expect no row containing code point list spill
function bj(c: i32): string { return "expected `" + fromCodePoints([c]) + "`" }
function cs(xs: i32[]): string { return fromCodePoints(xs) }
print(bj(65))
print(cs([66, 67]))
