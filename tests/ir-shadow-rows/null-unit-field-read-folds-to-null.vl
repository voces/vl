// ir shadow: a `null`-typed field read off a generic call's result, a binding of one and an
// annotated local is the receiver's read, dropped, then the read's null
// expect no row containing null unit read
// expect no row containing member record
// expect matched >= 3
type K = { r: null, n: i32 }
function id<T>(x: T): T { return x }
function mk(): K {
  print("made")
  return { r: null, n: 2 }
}
function offCall() { print(id(mk()).r ?? 3) }
function offBinding() {
  const v = id(mk())
  print(v.r ?? 4)
}
function offAnnotated(): i32 {
  const w: K = id(mk())
  print(w.r ?? 5)
  return w.n
}
offCall()
offBinding()
print(offAnnotated())
