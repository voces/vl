// ir shadow: a value if joined at a byte list
// expect covered >= 3
// expect matched >= 3
// expect no row containing expression if ref u8list
function ent(): u8[] { return [1, 2] }
const pre: u8[] = [1, 2]
function f(un: boolean): boolean {
  const post: u8[] = if un { [] } else { ent() }
  let same = post.length == pre.length
  return same
}
function g(un: boolean, a: u8[]): i32 {
  const q: u8[] = if un { a } else { ent() }
  return q.length
}
print(f(false))
print(f(true))
print(g(true, [3]))
