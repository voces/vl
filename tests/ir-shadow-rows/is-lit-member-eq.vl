// ir shadow: an is test at litArms' memberEq arm is, per member, the receiver and its string compare, guarded at a nullable string
// expect covered >= 2
type J = "a" | "bb"
function plain(s: string): boolean { return s is J }
function nul(s: string | null): boolean { return s is J }
print(plain("a"))
print(plain("bb"))
print(plain("c"))
print(nul("bb"))
print(nul(null))
print(nul("zz"))
