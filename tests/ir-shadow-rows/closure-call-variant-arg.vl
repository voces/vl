// ir shadow: a union-arm argument goes into a closure parameter as it stands, or unboxed from a narrowed box, and matches
// expect covered >= 8
// expect matched >= 8
// expect no row containing call of a non-declaration
// expect no row containing mismatch
type Shape = Circle | Sq
type Sq = { s: i32 }
type Circle = { r: i32 }
function apply(f: (c: Circle) => i32, c: Circle): i32 { return f(c) }
function go() {
  const g = (c: Circle) => c.r + 1
  const c: Circle = { r: 4 }
  print(g(c))
  const d: Circle = { r: 9 }
  print(g(d))
}
function narrowed(sh: Shape) {
  const g = (c: Circle) => c.r * 2
  if sh is Circle { print(g(sh)) }
}
const lamc = (x: Circle) => x
function unboxed(s: Shape): i32 {
  return if s is Circle { lamc(s).r } else { 0 }
}
go()
narrowed({ r: 8 })
print(unboxed({ r: 7 }))
print(unboxed({ s: 3 }))
narrowed({ s: 1 })
const k: Circle = { r: 2 }
print(apply((c) => c.r * 3, k))
