// ir shadow: a union-arm argument already of that arm goes into a closure parameter as it stands, and matches
// expect covered >= 4
// expect matched >= 4
// expect no row containing call of a non-declaration
// expect no row containing mismatch
type Shape = Circle | Sq
type Sq = { s: i32 }
type Circle = { r: i32 }
function apply(f: (c: Circle) => i32, c: Circle): i32 { return f(c) }
function go() {
  const g = (c: Circle) => c.r + 1
  const c: Circle = { r: 4 }
  print(g(c))
  const d: Circle = { r: 9 }
  print(g(d))
}
go()
const k: Circle = { r: 2 }
print(apply((c) => c.r * 3, k))
