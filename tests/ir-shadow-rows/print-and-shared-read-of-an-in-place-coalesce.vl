// ir shadow: a union print or a shared read of a ?? written in place declares its locals as legacy now does
// expect covered >= 5
// expect matched >= 5
// expect no row containing join past the optional chains
// expect no row containing print union of a fused map read
// expect no row containing fail
type R = { a: {[i32]: i32 | null} }
function chain(p: R) { print(p.a[9] ?? p.a[4] ?? p.a[3]) }
function pair(p: R) { print(p.a[3] ?? p.a[4]) }
type J = { f: i32 | null }
type K = { f: i32 | null, g: i32 }
function mk(): K { return { f: 4, g: 0 } }
const m: {[string]: K} = Map()
m.set("a", mk())
function pick(d: J) { return (m.get("a") ?? d).f }
function miss(d: J) { return (m.get("z") ?? d).f }
const a: {[i32]: i32 | null} = Map()
a[3] = 5
chain({ a: a })
pair({ a: a })
print(pick({ f: 1 }) ?? 0)
print(miss({ f: 1 }) ?? 0)
