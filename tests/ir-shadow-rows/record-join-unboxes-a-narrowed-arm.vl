// ir shadow: a value if joined at a record's row unboxes its narrowed arm in that arm
// expect matched >= 2
// expect start matched >= 1
// expect no row containing union if rep
// expect no row containing ref if arm unbox
// expect no row containing fail
// `ifExprPlainWhy` routes the join as its reference join, and `refIfArm`'s `unbox` recovers the
// box at the join's record (RArmUnbox), as legacy's `emitRefIfArm` writes it.
type A = { k: "a", v: i32 }
type B = { k: "b", w: i32 }
function pick(x: A | B, d: A) {
  const o: A = if x is A { x } else { d }
  return o.v
}
function nul(x: A | B) {
  const r: A | null = if x is A { x } else { null }
  if r != null { return r.v }
  return 0
}
const box: A | B = { k: "a", v: 7 }
print(pick(box, { k: "a", v: 5 }))
print(nul(box))
const top: A = if box is A { box } else { { k: "a", v: 1 } }
print(top.v)
