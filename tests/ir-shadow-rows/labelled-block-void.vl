// ir shadow: a void labelled block is one block frame a break leaves, which a continue passes
// expect covered >= 3
// expect matched >= 3
// expect no row containing labelled block
function early(n: i32): i32 {
  let r = 0
  @b {
    if n < 0 { break @b }
    r = n * 2
  }
  return r + 1
}
function skipOdd(xs: i32[]): i32 {
  let s = 0
  @L for x in xs {
    @b {
      if x % 2 == 1 { continue @L }
      if x > 6 { break @b }
      s = s + x
    }
    s = s + 100
  }
  return s
}
function outer(xs: i32[]): i32 {
  let s = 0
  @L for x in xs {
    @b {
      if x == 0 { break @L }
      s = s + x
    }
  }
  return s
}
print(early(5))
print(early(-1))
print(skipOdd([1, 2, 3, 4, 8]))
print(outer([3, 4, 0, 9]))
