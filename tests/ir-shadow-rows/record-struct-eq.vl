// ir shadow: a record `==`/`!=` builds through RStructEq on legacy's field-wise compare
// expect covered >= 7
// expect matched >= 7
// expect no row containing operand type
type Pt = { x: i32, y: i32 }
type Seg = { a: Pt, b: Pt, name: string }
function mk(x: i32): Pt { return { x: x, y: x + 1 } }
function same(p: Pt, q: Pt) { return p == q }
function differ(p: Pt, q: Pt) { return p != q }
function nested(s: Seg, t: Seg) { return s == t }
function callRight(p: Pt) { return p == mk(1) }
function fieldLeftCall(s: Seg) { return s.a == mk(1) }
function callBoth() { return mk(2) == mk(2) }
print(same({ x: 1, y: 2 }, { x: 1, y: 2 }))
print(differ({ x: 1, y: 2 }, { x: 1, y: 3 }))
print(
  nested({ a: mk(1), b: mk(2), name: "s" }, { a: mk(1), b: mk(2), name: "s" }),
)
print(callRight(mk(1)))
print(callBoth())
print(fieldLeftCall({ a: mk(1), b: mk(2), name: "s" }))
