// ir shadow: an order-stashed record literal boxed under its own arm writes the tag first
// expect covered >= 2
// expect matched >= 2
// expect no row containing stash-set
// expect no row containing fail
type A = { a: i32, k: i32 }
type B = { s: string }
type U = A | B
function put(x: i32): U {
  const u: U = { k: x * 2, a: if x > 0 { x } else { 0 } }
  return u
}
const p = put(9)
if p is A {
  print(p.a)
  print(p.k)
}
function mk(x: i32, flag: boolean): U {
  return { k: if flag { 2 } else { 3 }, a: x + 1 }
}
const u = mk(6, true)
if u is A { print(u.k) }
