// ir shadow: a masked shift builds as legacy's strength-reduced shift and mask; a narrowing source's wrap stays legacy's
// expect covered >= 2
// expect matched >= 2
// expect uncovered shift-mask fold narrowing source = 1
// `f32w` and `f64w` net the shifts at their width; `fNarrow` reads an i64 at width 32.
function f32w(x: i32) { return ((x >>> 4) & 15) << 2 }
function f64w(x: i64) { return ((x >>> 8) & 255) * 8 }
function fNarrow(y: i64) { return (((y >>> 4) & 15) as% i32) << 2 }
print(f32w(0x35))
print(f64w(0x0500))
print(fNarrow(0x35))
