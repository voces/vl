// ir shadow: a masked shift builds as legacy's strength-reduced shift and mask, a narrowing source wrapped
// expect covered >= 3
// expect matched >= 3
// expect no row containing shift-mask fold
// `f32w` and `f64w` net the shifts at their width; `fNarrow` reads an i64 at width 32 and wraps it.
function f32w(x: i32) { return ((x >>> 4) & 15) << 2 }
function f64w(x: i64) { return ((x >>> 8) & 255) * 8 }
function fNarrow(y: i64) { return (((y >>> 4) & 15) as% i32) << 2 }
print(f32w(0x35))
print(f64w(0x0500))
print(fNarrow(0x35))
