// ir shadow: a literal-union map's bare read is its nullable atom, the miss the niche's -1
// expect matched >= 2
// expect no row containing map get rep
// expect no row containing fail
type AB = "a" | "b"
function look(m: {[string]: AB}, k: string) {
  const v = m[k]
  if v == null { print("none") } else { print(v) }
}
function go() {
  const m: {[string]: AB} = Map()
  m["x"] = "b"
  look(m, "x")
  look(m, "z")
}
go()
