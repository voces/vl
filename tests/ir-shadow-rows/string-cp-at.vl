// ir shadow: s.cpAt(i) is a string op on legacy's tail
// expect covered >= 2
// expect matched >= 2
// expect no row containing method cpAt
let gS = "héllo"
let gP = 1
function cp(): i32 { return gS.cpAt(gP) }
function cq(s: string, i: i32): i32 { return s.cpAt(i) + 1 }
print(cp())
print(cq("abc", 0))
