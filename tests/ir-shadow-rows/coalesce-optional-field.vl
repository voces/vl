// ir shadow: p?.x ?? d over a nullable record's scalar field is the receiver, its null test, the default and the field; the string field still misses on expression optional member
// expect covered >= 1
type P = { x: i32, name: string }
function px(p: P | null): i32 { return p?.x ?? -1 }
function pn(p: P | null): string { return p?.name ?? "none" }
print(px({ x: 4, name: "a" }))
print(px(null))
print(pn({ x: 1, name: "b" }))
print(pn(null))
