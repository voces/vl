// ir shadow: a read of a scalar list that may be a view of its source reads through the view (scalarListGetTail's view arm)
// expect covered >= 1
function back(x: i32[]): readonly i64[] { return x }
function at(r: readonly i64[], i: i32): i64 { return r[i] }
const l: i32[] = [1, 2]
const r = back(l)
l.push(3)
print(at(r, 2))
