// ir shadow: a for walk in an expression-position match arm takes its node-pinned slot
// expect covered >= 1
// expect matched >= 1
// expect no row containing for in pinned slot
type A = { xs: i32[] }
type B = { n: i32 }
type U = A | B
function sum(u: U): i32 {
  const r = match u {
    A => {
      let o = 0
      for f in u.xs { o = o + f }
      o
    }
    B => u.n
  }
  return r + 1
}
print(sum({ xs: [1, 2, 3] }))
print(sum({ n: 4 }))
