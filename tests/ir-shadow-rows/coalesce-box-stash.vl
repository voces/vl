// ir shadow: l ?? d on the boxStash rung, the operand built after the shared slot, the default boxed into the absent arm
// expect covered >= 2
// expect no row containing box stash
// expect no row containing boxStash
// expect no row containing fail
function pick(n: i32): i32 | string | null {
  if n == 0 { return null }
  if n == 1 { return 4 }
  return "s"
}
function or(n: i32): i32 | string { return pick(n) ?? "d" }
print(or(0))
print(or(1))
print(or(2))
