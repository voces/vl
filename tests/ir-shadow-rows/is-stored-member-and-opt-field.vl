// ir shadow: an is over a local record's box field at its storage tests the raw field's tag, and x?.f is K over an unstaged base tests the field's tag past the base's null test
// expect covered >= 4
// expect matched >= 4
// expect no row containing is arm tag memStruct
// expect no row containing is arm tag optField
function k(n: i32): i32 { return n }
function srcU(): i32 | string { return 5 }
function field() {
  const w = { f: srcU() }
  if w.f is i32 {
    if k(2) == 0 { w.f = "s" }
    else if k(2) == 1 { w.f = "t" }
    if w.f is i32 { print("i32") } else { print("str") }
  }
}
type Bu = { y: i32 | string }
function fu(x: Bu | null) {
  if (x?.y) is string { print("s") } else { print("n") }
}
field()
fu(null)
fu({ y: 3 })
fu({ y: "a" })
