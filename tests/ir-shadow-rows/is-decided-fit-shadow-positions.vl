// ir shadow: a decided list test's region reads its receiver at every delivery position: call argument at a scalar and a union parameter, nested call argument, concat operand, return, let initializer, if arm value, ?? operand and record field
// expect no row containing decided is fit shadow
function len(n: i32): i32 { return n }
function lenOr(x: i32 | string): i32 { return if x is string { 0 } else { x } }
function twice(n: i32): i32 { return n * 2 }
function posOr(n: i32): i32 | null { return if n > 0 { n } else { null } }
function pArg<V>(v: V) {
  if v is f64[] { print(len(v.length)) } else { print(-1) }
}
function pUnion<V>(v: V) {
  if v is f64[] { print(lenOr(v.length)) } else { print(-1) }
}
function pNested<V>(v: V) {
  if v is f64[] { print(twice(len(v.length))) } else { print(-1) }
}
function pConcat<V>(v: V) {
  if v is f64[] {
    print("n=" + (if v.length > 1 { "many" } else { "one" }))
  } else {
    print("none")
  }
}
function pReturn<V>(v: V): i32 {
  if v is f64[] { return v.length }
  return -1
}
function pLet<V>(v: V) {
  if v is f64[] {
    const n = v.length
    print(n)
  } else {
    print(-1)
  }
}
function pIfArm<V>(v: V, b: boolean) {
  if v is f64[] { print(if b { v.length } else { 0 }) } else { print(-1) }
}
function pCoalesce<V>(v: V) {
  if v is f64[] { print(posOr(v.length) ?? 0) } else { print(-1) }
}
function pRecord<V>(v: V) {
  if v is f64[] {
    const r = { n: v.length }
    print(r.n)
  } else {
    print(-1)
  }
}
const fs: f64[] = [1.5, 2.5]
const ns: i32[] = [1]
pArg(fs)
pArg(ns)
pUnion(fs)
pUnion(ns)
pNested(fs)
pNested(ns)
pConcat(fs)
pConcat(ns)
print(pReturn(fs))
print(pReturn(ns))
pLet(fs)
pLet(ns)
pIfArm(fs, true)
pIfArm(ns, true)
pCoalesce(fs)
pCoalesce(ns)
pRecord(fs)
pRecord(ns)
