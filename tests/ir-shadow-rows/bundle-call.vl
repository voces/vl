// ir shadow: a call through a bundle parameter reads its member closure and calls it at that member's signature
// expect matched >= 3
// expect no row containing call of a non-declaration
function other(g) { print(g(7)) }
function other2(g) { print(g(1.5)) }
function handTwo(f) {
  other(f)
  other2(f)
}
function go(k: i32) { handTwo((a) => a + k) }
go(2)
