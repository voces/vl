// ir shadow: a desugared null test over a nullable value union builds and matches
// expect covered >= 1
// expect matched >= 1
// expect no row containing rep ?
// The rewrite's `l != null` is typed `boolean` (`mkNullTestNe`), so `viaUnion`'s `??` builds.
type R = { r: i32 }
function viaMap(m: {[string]: i32 | null}, k: string) {
  const v = m[k] ?? 0
  return v
}
function viaUnion(u: i32 | string | null) {
  const v = u ?? "none"
  if v is string { return v }
  return "int"
}
function viaChain(x: R | null) {
  const n = x?.r
  return n ?? -1
}
const m: {[string]: i32 | null} = Map()
m["a"] = 3
print(viaMap(m, "a"))
print(viaMap(m, "b"))
print(viaUnion(null))
print(viaUnion("s"))
print(viaChain({ r: 5 }))
print(viaChain(null))
