// ir shadow: an element narrowed to a record arm that the box plan passes to a union parameter
// expect covered >= 3
// expect matched >= 3
// expect no row containing index element coercion
type OV = { ov: i32 }
type OS = { os: string }
type OI = { oi: i32, oj: i32 }
type Op = OV | OS | OI
type SR = { srV: Op, srStash: boolean }
function opRep(o: Op): i32 { if o is OV { return o.ov } return 0 }
function f(r: SR): i32 {
  if !r.srStash && (!(r.srV is OV) || r.srV.ov < 0) { return -1 }
  return 1
}
function g(a: Op[]): boolean {
  return a.length == 1 && a[0] is OV && opRep(a[0]) == 3
}
print(f({ srV: { ov: 2 }, srStash: false }))
print(g([{ ov: 3 }]))
