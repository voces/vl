// ir shadow: a nullable literal-union compared with a string field is built on the nulNiche route
// expect covered >= 2
// expect matched >= 2
// expect no row containing string operand coercion
type K = "i32" | "f64" | "str"
type P = { from: string }
function kindOf(n: i32): K | null {
  if n == 0 { return null }
  return if n == 1 { "i32" } else { "f64" }
}
function check(n: i32, p: P): boolean {
  if kindOf(n) != p.from { return false }
  return true
}
print(check(1, { from: "i32" }))
print(check(2, { from: "i32" }))
print(check(0, { from: "" }))
