// ir shadow: a lifted function passes its own capture on to a lifted callee and matches
// expect covered >= 3
// expect matched >= 3
function outer(n: i32): i32 {
  function mid(k: i32): i32 {
    function leaf(j: i32): i32 { return n + j }
    return leaf(k) * 2
  }
  return mid(4)
}
print(outer(3))
