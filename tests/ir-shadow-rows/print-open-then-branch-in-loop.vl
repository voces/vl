// ir shadow: a loop that continues or breaks after a nullable print of a valued if: the opened print's frames are closed before the branch
// expect covered >= 2
// expect matched >= 2
// expect no row containing mismatch
// expect no row containing of a valued if
function g(a: string | null, b: string | null) {
  let i = 0
  while i < 10 {
    print(if i % 2 == 0 { a } else { b })
    i = i + 1
    if i == 3 { continue }
    if i > 4 { break }
  }
  print(i)
}
function h(a: boolean | null) {
  let n = 0
  while true {
    print(if n < 2 { null } else { a })
    n = n + 1
    if n == 4 { break }
  }
  print(n)
}
g("x", null)
h(false)
