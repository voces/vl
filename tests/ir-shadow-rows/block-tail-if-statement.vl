// ir shadow: a block body's last if is a statement whose falling arm pads null (D17038)
// expect covered = 2
// expect matched = 2
let n = 0
function tl(a: i32) {
  if a > 5 {
    return 1
  } else {
    n = n + a
  }
}
function te(a: i32) {
  if a > 0 { return a } else { a * 2 }
}
print(tl(2))
print(tl(9))
print(te(-1))
print(n)
