// ir shadow: a scalar map join whose default computes is the fused read's miss arm
// expect covered >= 2
// expect matched >= 2
// expect no row containing uncovered
// expect no row containing fail
function flag(): boolean { return true }
function viaCall(p) { print(p.m[9] ?? flag()) }
const mm: {[i32]: i32} = Map()
mm[1] = 10
viaCall({ m: mm })
