// ir shadow: a generic's `null` instance capturing its `null`-typed parameter
// expect covered >= 25
// expect matched >= 25
// expect no row containing closure env capture
// expect no row containing read of x
// `outer(null)` holds `x` at `nullref` in its closures' environments (`capRepFor`), and a read of
// the capture on legacy's `nulnone` arm is its destination's null (`captureRead`).
function len<T>(f: () => T | null) {
  const t = f()
  return if t == null { 0 } else { 1 }
}
function outer<U>(x: U) { print(len(() => x)) }
outer(null)
outer(5)
function keep<U>(x: U): () => U { return () => x }
print(keep(null)() == null)
print(keep(3)() == null)
function twice<U>(x: U) {
  const f = () => x
  const g = () => f()
  print(g() == null)
}
twice(null)
twice("s")
