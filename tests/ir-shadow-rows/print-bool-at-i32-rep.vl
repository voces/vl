// ir shadow: a boolean read at an i32 rep (a hole lambda's parameter) prints through print's bool arm
// expect covered >= 10
// expect no row containing print operand rep
function inner<U>(u: U) { print(u) }
function a<T>(x: T) {
  let k = inner
  const h = (u) => {
    print(u)
  }
  const w = () => {
    return k = h
  }
  k(x)
  w()
  k(x)
}
a(1)
a(true)
