// ir shadow: a function value called with a reference at a nullable reference parameter: a map, a closure and a string, each non-null and nullable
// expect matched >= 6
// expect no row containing call of a non-declaration
function inc(x: i32): i32 { return x + 1 }
function viaMap(
  f: (m: {[string]: i32} | null) => i32,
  m: {[string]: i32},
): i32 {
  return f(m)
}
function viaMapN(
  f: (m: {[string]: i32} | null) => i32,
  m: {[string]: i32} | null,
): i32 {
  return f(m)
}
function viaFn(
  f: (g: ((x: i32) => i32) | null) => i32,
  g: (x: i32) => i32,
): i32 {
  return f(g)
}
function viaFnN(
  f: (g: ((x: i32) => i32) | null) => i32,
  g: ((x: i32) => i32) | null,
): i32 {
  return f(g)
}
function viaStr(f: (s: string | null) => i32, s: string): i32 { return f(s) }
function viaStrN(f: (s: string | null) => i32, s: string | null): i32 {
  return f(s)
}
const mlen = (m: {[string]: i32} | null): i32 => if m == null { -1 } else { m.length }
const gcall = (g: ((x: i32) => i32) | null): i32 => if g == null { -1 } else { g(4) }
const slen = (s: string | null): i32 => if s == null { -1 } else { s.length }
const m: {[string]: i32} = Map()
m["a"] = 1
const nm: {[string]: i32} | null = m
const ng: ((x: i32) => i32) | null = inc
const ns: string | null = "xyz"
print(viaMap(mlen, m))
print(viaMapN(mlen, nm))
print(viaFn(gcall, inc))
print(viaFnN(gcall, ng))
print(viaStr(slen, "ab"))
print(viaStrN(slen, ns))
