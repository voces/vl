// ir shadow: an is arm tag test over a record's union-box field reads the field at its storage, then its tag compare
// expect covered >= 2
type R = { v: string | i32 }
function strField(r: R): boolean { return r.v is string }
function intField(r: R): boolean { return r.v is i32 }
print(strField({ v: "a" }))
print(strField({ v: 3 }))
print(intField({ v: 3 }))
