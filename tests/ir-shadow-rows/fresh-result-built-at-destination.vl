// ir shadow: an un-annotated function returns at its recorded result, where its literal is built
// expect covered >= 2
// expect matched >= 2
// expect no row containing return coercion
// expect no row containing fail
type I = { f: i32 }
type J = { f: i32 | null }
function mk() { return { f: 4 } }
const j: J = mk()
print(j.f ?? 0)
function mk2(n: i32) { return { f: n + 6 } }
function relay(n: i32): J { return mk2(n) }
print(relay(1).f ?? 0)
