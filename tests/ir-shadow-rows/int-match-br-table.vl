// ir shadow: a dense integer match is one br_table, in tail and statement position, at i32 and i64
// expect covered >= 4
// expect matched >= 4
// expect no row containing if switch
function wide(site: i32): boolean {
  return match site {
    2 | 5 | 6 | 7 | 15 | 16 => true
    _ => false
  }
}
function name(k: i32): string {
  return match k {
    10 => "ten"
    11 => "eleven"
    12 => "twelve"
    14 => "fourteen"
    _ => "other"
  }
}
function big(k: i64): i32 {
  return match k {
    0 => 1
    1 => 2
    2 => 3
    3 => 4
    _ => 0
  }
}
function count(xs: i32[]): i32 {
  let n = 0
  for x in xs {
    match x {
      0 => {
        n = n + 1
      }
      1 => {
        n = n + 10
      }
      2 => {
        n = n + 100
      }
      3 => {
        break
      }
      _ => {
        n = n + 1000
      }
    }
  }
  return n
}
let s = 0
let i = 0
while i < 20 {
  if wide(i) { s = s + 1 }
  i = i + 1
}
print(s)
print(name(10) + name(12) + name(13) + name(14) + name(-5))
print(big(2) + big(3) + big(9) + big(-1))
print(count([0, 1, 2, 7, 3, 2]))
