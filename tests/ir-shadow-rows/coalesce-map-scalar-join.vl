// ir shadow: a scalar map read under ?? joining another arm of its union boxes each arm at its own tag
// expect covered >= 5
// expect matched >= 5
// expect no row containing mapScalarJoin
// expect no row containing fail
function show(x) { print(x) }
function viaPrint(p) { print(p.m[1] ?? true) }
function viaBind(p) {
  const r = p.m[9] ?? true
  print(r)
}
function viaPass(p) { show(p.m[2] ?? false) }
function viaRet(p) { return p.m[9] ?? "gone" }
const mm: {[i32]: i32} = Map()
mm[1] = 10
mm[2] = 20
viaPrint({ m: mm })
viaBind({ m: mm })
viaPass({ m: mm })
print(viaRet({ m: mm }))
