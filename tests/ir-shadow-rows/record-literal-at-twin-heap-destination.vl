// ir shadow: a struct literal at a record destination of its row's heap is built at the destination's rep
// expect const cell plain object: matched = 2
// expect no row containing global initializer coercion
type Box<T> = { v: T }
type Holder = { c: Box<i32> }
type OptHolder = { c: Box<i32> | null }
const o: OptHolder = { c: { v: 11 } }
type Cat = { c: Box<i32> }
type Dog = { d: i32 }
function show(): i32 { return o.c?.v ?? 0 }
print(show())
