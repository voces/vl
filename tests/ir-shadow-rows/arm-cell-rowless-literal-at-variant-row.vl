// ir shadow: an arm cell's rowless record literal is held at the variant row and returned there
// expect matched >= 2
// expect start matched >= 1
// expect no row containing object variant field
// expect no row containing return coercion
// expect no row containing fail
// expect no row containing mismatch
// `rowlessLetTy`: a `let` whose cell kind is `variant` holds its rowless record at the arm's
// variant row (`emitVariantCoerce`), so a `null` field is boxed and an `i32` widened there.
type Circle = { r: i32 | null }
type Sq = { s: i32 }
type Shape = Circle | Sq
function rOf(c: Circle) { return if c.r == null { 0 - 1 } else { c.r } }
function mk() {
  const cc = { r: null }
  return cc
}
print(rOf(mk()))
