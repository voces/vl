// ir shadow: a record copy into an `i64` field's row, re-read per field, is legacy's whole copy
// expect covered >= 1
// expect matched >= 1
// expect no row containing pre-path coercion recCopy
type K = { f: i64 }
function mk() { return { f: 4 } }
function main() {
  const k: K = mk()
  const y = mk()
  print(y.f)
  print(k.f)
}
main()
