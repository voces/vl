// ir shadow: a map walk binds each key or value at the rep the map stores it at, an i64 key and a record value
// expect covered >= 1
// expect matched >= 1
// expect no row containing for in map element
// expect no row containing mismatch
type P = { n: i32 }
function walk() {
  const ki: {[i64]: i32} = Map()
  ki[10 as i64] = 1
  ki[20 as i64] = 2
  for k in ki.keys() { print(k) }
  const rs: {[string]: P} = Map()
  rs["a"] = { n: 11 }
  rs["b"] = { n: 12 }
  for r in rs.values() { print(r.n) }
}
walk()
