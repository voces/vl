// ir shadow: a closure call's nullable union-arm parameter takes a narrowed box unboxed to the arm
// expect covered >= 2
// expect matched >= 2
// expect no row containing call of a non-declaration
// expect no row containing fail
// `callRefArgPlain`'s `nulArm`: the argument is delivered at the closure's parameter, an owed box
// unboxed to the arm's nullable record as legacy's `armOpen` writes it.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function run(rd: (Circle | null) => i32, zz: (Circle | null | string)[]) {
  const e = zz[0]
  if !(e is string) { print(rd(e)) }
  print(rd({ r: 5 }))
  print(rd(null))
}
const rd = (w: Circle | null): i32 => if w == null { 0 - 1 } else { w.r }
run(rd, [{ r: 3 }, null, "x"])
