// ir shadow: a union box against a concrete literal is legacy's tag test and payload compare
// expect covered >= 3
// expect matched >= 3
// expect no row containing string operand coercion
// expect no row containing fail
function f(k: "a" | i32 | null) {
  if k == "a" { return 1 }
  return 2
}
print(f("a"))
print(f(3))
print(f(null))
function g(u: string | i32) { return u != "x" }
print(g(4))
function h(u: string | i32) { return u == 7 }
print(h("7"))
