// ir shadow: a value if boxed arm by arm at a union with a list arm, empty list arms included
// expect covered >= 4
// expect no row containing box ladder
// @run
// @log s:big
// @log empty list
// @log int
// @log list of a
// @log s:two
// @log int
// @log empty list
// @log empty list
// @log null
// A value `if` whose arms join at a union holding a list arm is boxed arm by arm: an `else if`
// chain returned, passed and bound, with an empty list literal and a null arm among its arms.
type U = i32 | string | string[]
function show(u: U | null): string {
  if u == null { return "null" }
  if u is string { return "s:" + u }
  if u is string[] {
    return if u.length == 0 { "empty list" } else { "list of " + u[0] }
  }
  return "int"
}
function pick(c: i32): U {
  return if c > 2 { "big" } else if c > 1 { [] } else if c > 0 { c } else { ["a", "b"] }
}
function arg(c: i32) {
  print(show(if c > 1 { "two" } else if c > 0 { c * 3 } else { [] }))
}
function bind(c: boolean) {
  const u: U | null = if c { [] } else { null }
  print(show(u))
}
for i in [3, 2, 1, 0] { print(show(pick(i))) }
arg(2)
arg(1)
arg(0)
bind(true)
bind(false)
