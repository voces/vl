// ir shadow: a module global union reassigned to an arm's literal reads as that arm's record
// expect covered >= 1
// expect matched >= 1
// expect no row containing global read coercion
// After `w = { v: "b" }` the checker narrows the global `w` to `C`; the call reads it at `C`'s
// record, the box unboxed to the arm as a local's read is (`narrowedBoxVariantPlain`).
type C = { v: "a" | "b" | null }
type D = { v: string }
function g(u: C | D) {
  if u is C { return "C" }
  return "D"
}
let w: C | D = { v: "q" }
print(g(w))
w = { v: "b" }
print(g(w))
