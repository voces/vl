// ir shadow: a boolean | null print, an i64-keyed map, a map delete and a walk's second name
// expect covered >= 4
// expect matched >= 4
// expect no row containing print nulBool
// expect no row containing map key
// expect no row containing method delete
// expect no row containing for in pair
// expect no row containing mismatch
function nb(m: {[string]: i32}) {
  const r: boolean | null = if m.length > 1 { null } else { m.has("k") }
  print(r)
}
function wide(): i32 {
  const m: {[i64]: i32} = Map()
  m.set(8, 1)
  m[9] = 2
  print(m.has(8))
  return m[9] ?? -1
}
function drop(m: {[i32]: i32}): boolean {
  m.delete(3)
  return m.delete(4)
}
function walk(xs: string[], m: {[string]: i32}) {
  for x, i in xs { print(i) }
  for k, v in m { print(v) }
}
const m0: {[string]: i32} = Map()
m0["k"] = 1
nb(m0)
print(wide())
const d: {[i32]: i32} = Map()
d[3] = 1
d[4] = 2
print(drop(d))
walk(["a", "b"], m0)
