// ir shadow: a decided list test over a pushing arm builds: its push lands on the grow row and its length reads the grown list, at a decided true and false instance and in a loop; a decided arm that only reads does not fill; a union receiver with a string or another list builds alike
// expect covered >= 9
// expect matched >= 9
// expect no row containing decided is fit shadow
function pushTrue<V>(v: V[]) {
  if v is f64[] { v.push(1.5) }
  print(v.length)
}
function loopPush<V>(v: V[]) {
  let n = 0
  while n < 3 {
    if v is f64[] { v.push(0.5) }
    n = n + 1
  }
  if v is f64[] { print(v.length) }
  print(v.length)
}
function readOnly<V>(v: V[]) {
  if v is f64[] { print(v.length) }
  print(v.length)
}
function unionStr<T>(x: T[] | string) {
  if x is f64[] { x.push(2.5) }
  if x is string { print(x) } else { print(x.length) }
}
function unionLists<T>(x: T[] | f64[]) {
  if x is f64[] { x.push(3.5) }
  print(x.length)
}
const e: i32[] = []
pushTrue(e)
print(e.length)
const f: f64[] = []
pushTrue(f)
print(f.length)
const e3: i32[] = []
loopPush(e3)
const f3: f64[] = []
loopPush(f3)
readOnly(e)
readOnly(f)
const ui: i32[] = []
unionStr(ui)
unionStr("s")
const uf: f64[] = []
unionLists(ui)
unionLists(uf)
