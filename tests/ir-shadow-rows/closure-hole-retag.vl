// ir shadow: a hole lambda's cell read into a list at its open element rep is the same closure struct, retagged, and matches
// expect covered >= 2
// expect matched >= 2
// expect no row containing narrowed read
// expect no row containing mismatch
function mk(x: string) {
  const c = (y) => y + "C"
  print(c("q"))
  const fs = [c]
  print(fs.length)
  print(x)
}
mk("a")
