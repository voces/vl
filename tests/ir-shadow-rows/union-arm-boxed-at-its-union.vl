// ir shadow: a union dispatch's arm, and a print's `if` at a union, are boxed at their own union
// expect covered >= 3
// expect matched >= 3
// expect no row containing tag dispatch arm coercion
// expect no row containing print union if
function only(n, f) { return f(n) }
function twice(s) { return s + s }
function lenOf(s) { return s.length }
function pick(k: boolean): i32 | string { return if k { 1 } else { "one" } }
function main() {
  const k = [1].length > 1
  print(only("abc", if k { twice } else { lenOf }))
  print(if k { pick(true) } else { pick(false) })
}
main()
