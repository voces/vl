// ir shadow: i64, f32 and f64 loads and stores build along the memory access plan and match
// expect covered >= 6
// expect matched >= 6
// expect no row containing memory access wide value
function putL(p: i32, v: i64) { __store_i64__(p, v) }
function getL(p: i32): i64 { return __load_i64__(p) }
function putF(p: i32, v: f32) { __store_f32__(p, 8, v) }
function getF(p: i32): f32 { return __load_f32__(p, 8) }
function putD(p: i32, v: f64) { __store_f64__(p, v) }
function getD(p: i32): f64 { return __load_f64__(p) }
putL(256, 1234567890123 as i64)
print(getL(256))
putF(256, 1.5 as f32)
print(getF(256))
putD(512, 2.25)
print(getD(512))
