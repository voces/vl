// ir shadow: a direct call of a lifted callee that assigns its captures sets them back after it
// expect covered >= 2
// expect matched >= 2
// expect no row containing callee writes back captures
// `count` calls a lifted counter as a statement and `sum` as a value, each handing `c` back
// (`RCall.caWb`, legacy's `emitDirectCallTail`).
function count() {
  let c = 0
  function inc() { c = c + 1 }
  inc()
  inc()
  return c
}
function sum(n: i32) {
  let t = 0
  function add(k: i32) {
    t = t + k
    return t
  }
  const a = add(n)
  return a + add(1)
}
print(count())
print(sum(3))
