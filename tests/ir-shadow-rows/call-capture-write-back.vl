// ir shadow: lifted functions that assign their captures, and the calls that set them back
// expect covered >= 6
// expect matched >= 6
// expect no row containing callee writes back captures
// expect no row containing local slot
// `inc`, `add` and `go` hand `c`, `t` and `k` back (`IrFn.irRetExtra`); `count`, `sum` and `deep`
// set them back after each call (`RCall.caWb`); `go` tail-calls itself, dropping its write-back.
function count() {
  let c = 0
  function inc() { c = c + 1 }
  inc()
  inc()
  return c
}
function sum(n: i32) {
  let t = 0
  function add(k: i32) {
    t = t + k
    return t
  }
  const a = add(n)
  return a + add(1)
}
function deep(n: i32) {
  let k = 0
  function go(m: i32) {
    if m == 0 { return k }
    k += 1
    return go(m - 1)
  }
  return go(n)
}
print(count())
print(sum(3))
print(deep(5))
