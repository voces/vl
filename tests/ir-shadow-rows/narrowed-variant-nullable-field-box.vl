// ir shadow: a union-box field read off a value narrowed to its variant is the box itself, a boxed nullable on that field's box
// expect covered >= 1
// expect matched >= 1
// expect no row containing narrowed field unbox
// expect no row containing mismatch
type A = { tag: "a", x: i64 | null }
type B = { tag: "b", y: i32 }
type U = A | B
function rd(u: U): i64 {
  if u is A { return u.x ?? -1 }
  return 0
}
print(rd({ tag: "a", x: 41 }))
print(rd({ tag: "a", x: null }))
