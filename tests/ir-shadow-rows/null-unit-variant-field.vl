// ir shadow: a null-unit variant field is its slot's null
// expect covered >= 4
// expect matched >= 4
// A variant literal's `null` field is the bottom ref legacy writes after `emitNulNoneForEffect`'s
// empty effect; `mkH`'s `null`-typed local reads as its destination's null.
type A = { tag: i32, n: null }
type B = { tag: i32, s: string }
type U = A | B
type H = { n: null, k: i32 }
function mkA(t: i32): U { return { tag: t, n: null } }
function mkB(t: i32): U { return { tag: t, s: "b" } }
function mkH(k: i32): H {
  const z = null
  return { n: z, k: k }
}
function tagOf(u: U) {
  if u is A { return u.tag }
  return 0 - u.tag
}
print(tagOf(mkA(3)))
print(tagOf(mkB(4)))
print(mkH(5).k)
