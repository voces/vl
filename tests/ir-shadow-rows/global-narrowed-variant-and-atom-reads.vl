// ir shadow: a module global's union box narrowed to a record arm reads as its box cast to the
// variant, and a literal-union global delivered where a string is wanted passes its id to the
// delivery's decode
// expect start covered >= 1
// expect start matched >= 1
// expect no row containing mismatch
// expect no row containing fail
// expect no row containing global read coercion
type J = { r: i32 }
function pair<T>(a: T, b: T): T[] { return [a, b] }
const v: J | string = { r: 4 }
if v is J { print(v.r) }
const k: "a" | "b" = "b"
const ps: (string | null)[] = pair(null, k)
const e = ps[1]
if e != null { print(e + "!") }
