// ir shadow: a map of a rowless record's value rep is the storage row's, so a default read of it matches
// expect covered >= 1
// expect matched >= 1
// expect no row containing map read mv value rep
// expect no row containing mismatch
type Circle = { r: i32 | null }
type Dot = { r: i32 | null }
function rd() {
  const m = Map()
  m["k0"] = { r: null }
  const ms = [m]
  const g = ms[0]["k0"] ?? { r: null }
  print(g.r ?? 7)
}
rd()
