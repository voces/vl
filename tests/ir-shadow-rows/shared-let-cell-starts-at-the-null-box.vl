// ir shadow: a shared let with no initializer starts as its cell list's null box
// expect covered >= 2
// expect no row containing expression null
// The rewrite's `[null]` element is the payload-less null box, as `deliver` hands a `null`
// literal to the box writer (`unionElemValue`).
function go(k: i32) {
  let u: i32
  const set = () => {
    u = k
  }
  set()
  const get = () => u
  print(get())
}
go(7)
