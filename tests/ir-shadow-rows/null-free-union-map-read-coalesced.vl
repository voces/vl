// ir shadow: a null-free union map value read under ?? is the slot's box, its default boxed into it
// expect covered >= 3
// expect matched >= 3
// expect no row containing map read mv
// expect no row containing fail
type P = { x: i32 }
function num(m: {[string]: i32 | string}, k: string) {
  const v = m[k] ?? 7
  if v is i32 { print(v) } else { print(v) }
}
function rec(m: {[string]: P | string}, k: string) {
  const v = m[k] ?? { x: 9 }
  if v is P { print(v.x) } else { print(v) }
}
function go() {
  const a: {[string]: i32 | string} = Map()
  a["n"] = 5
  a["s"] = "hi"
  num(a, "n")
  num(a, "z")
  num(a, "s")
  const b: {[string]: P | string} = Map()
  b["p"] = { x: 3 }
  rec(b, "p")
  rec(b, "z")
}
go()
