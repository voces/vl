// ir shadow: a closure global initialized from another global holding a closure is that global's value
// expect covered >= 4
// expect matched >= 4
// expect no row containing closure name of a global
const c = (y) => y + y
const e = (y) => y + y + y
let d = c
function mk(f: (y: i32) => i32, n: i32) { print(f(n)) }
function w() { d = e }
w()
mk(d, 4)
