// ir shadow: a discarded slice statement builds as a temp legacy drops, and matches
// expect covered >= 3
// expect matched >= 3
// expect no row containing effect outside I1
function nonTail(): i32 {
  const xs: i32[] = [1, 2, 3]
  xs.slice(0, 2)
  return xs.length
}
function voidTail(): void {
  const xs: i32[] = [1, 2, 3]
  xs.slice(0, 2)
}
function strs(): i32 {
  const ss: string[] = ["a", "b"]
  ss.slice(1)
  return ss.length
}
