// ir shadow: a union of records each stored at a record's heap is delivered there unboxed
// expect covered >= 4
// expect matched >= 4
// expect no row containing coercion
// `B | D` is a box whose arms are both stored at `A`'s layout (D16321), so every record slot
// takes the payload cast to `A`'s heap: a return, a binding, an argument and a field.
type A = { x: i32 }
type B = { x: 1 | 2 }
type D = { x: 3 | 4 }
type R = { a: A }
function ret(b: B | D): A { return b }
function bind(b: B | D) {
  const a: A = b
  return a.x
}
function take(a: A) { return a.x }
function arg(b: B | D) { return take(b) }
function field(b: B | D): R { return { a: b } }
print(ret({ x: 3 }).x)
print(bind({ x: 4 }))
print(arg({ x: 2 }))
print(field({ x: 1 }).a.x)
