// ir shadow: an uninitialized binding, scalar or reference, builds through the IR and writes nothing
// expect covered >= 4
// expect matched >= 4
function scalar(c: boolean) {
  let x: i32
  if c { x = 1 } else { x = 2 }
  return x
}
function text(c: boolean) {
  let s: string
  if c { s = "a" } else { s = "b" }
  return s
}
function list(c: boolean) {
  let xs: i32[]
  if c { xs = [1] } else { xs = [2, 3] }
  return xs.length
}
function f<T>(a: T): T {
  let x: T
  x = a
  return x
}
print(scalar(true))
print(text(false))
print(list(false))
print(f("s"))
