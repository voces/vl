// ir shadow: a tagged call returning a list builds under legacy's dispatch blocktype and matches; its index read stays legacy's
// expect no row containing tag dispatch result
// expect uncovered index of a tagged call = 1
function wrap(a) { return [a] }
function bound(g, x) {
  const r = g(x)
  print(r[0] + 0.5)
}
function opOn(g, x) { print(g(x)[0] + 0.5) }
bound(wrap, 2.5)
opOn(wrap, 2.5)
