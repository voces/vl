// ir shadow: a tagged call returning a list builds under legacy's dispatch blocktype, and an index read of it matches
// expect no row containing tag dispatch result
// expect covered >= 3
// expect matched >= 3
// expect no row containing fail
function wrap(a) { return [a] }
function bound(g, x) {
  const r = g(x)
  print(r[0] + 0.5)
}
function opOn(g, x) { print(g(x)[0] + 0.5) }
bound(wrap, 2.5)
opOn(wrap, 2.5)
