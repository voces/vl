// ir shadow: a tagged call returning a record or a list builds each arm under legacy's dispatch blocktype and matches
// expect no row containing tag dispatch result
// expect uncovered index of a tagged call = 1
type P = { x: i32 }
function mkp(n: i32): P { return { x: n } }
function mkq(n: i32): P { return { x: n * 2 } }
function two<T>(v: T): T[] { return [v, v] }
function viaRec(f) { print(f(3).x) }
function viaList(g) { print(g(4).length) }
function viaIndex(g) { print(g(5)[1]) }
viaRec(mkp)
viaRec(mkq)
viaList(two)
viaIndex(two)
