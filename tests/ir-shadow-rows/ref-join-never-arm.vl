// ir shadow: a reference join's arm that calls a never function builds as that call's statement
// expect covered >= 3
// expect matched >= 3
// expect no row containing rep novalue
function fail(m: string): never { __trap__(m) }
function name(c: boolean, s: string) {
  const v = if c { s } else { fail("no name") }
  return v
}
function size(c: boolean, xs: i32[]) {
  const ys = if c { xs } else { fail("no list") }
  return ys.length
}
print(name(true, "ada"))
print(size(true, [1, 2, 3]))
