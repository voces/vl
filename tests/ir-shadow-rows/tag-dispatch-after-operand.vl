// ir shadow: a tag dispatch after an operand stages the operand below its id stash and matches
// expect covered >= 4
// expect matched >= 4
// expect no row containing tag dispatch after an operand
function add(a, b) { return a + b }
function after(g, x: i32) { return x * 2 + g(1, 2) }
function both(g) { return g(1, 2) + g("ab", "c").length }
print(after(add, 3))
print(both(add))
