// ir shadow: a ?. call through a hole-typed function field, boxed into f64 | null, writes the box's tag ahead of the dispatch, at module scope and in a function
// expect covered >= 1
// expect start covered >= 1
// expect no row containing boxed tag dispatch
function half(a) { return a / 2.0 }
const m = Map()
m["b"] = { f: half }
const v: f64 | null = m["b"]?.f(4)
print(v ?? -1.0)
function k(key: string) {
  const w: f64 | null = m[key]?.f(4)
  print(w ?? -1.0)
}
k("b")
k("zz")
