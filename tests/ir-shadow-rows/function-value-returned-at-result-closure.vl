// ir shadow: a function value returned at its result closure type is built at that rep
// expect covered >= 4
// expect matched >= 4
// expect no row containing return coercion
// expect no row containing fail
function same<T>(k: T): T { return k }
function d1() { return same }
const v1: (k: i32) => i32 = d1()
print(v1(3))
const w1: (k: string) => string = d1()
print(w1("q"))
function twice(n: i32) { return n * 2 }
function pick() { return twice }
const t: (n: i32) => i32 = pick()
print(t(4))
