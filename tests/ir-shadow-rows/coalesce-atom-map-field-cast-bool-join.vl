// ir shadow: an atom map read boxed into a hole union, a field ?? off a box narrowed to a record arm, a boolean | null ?? joining a box
// expect covered >= 4
// expect matched >= 4
// expect no row containing box ladder
// expect no row containing coalesce field cast
// expect no row containing nulBoolJoin
// expect no row containing fail
type AB = "a" | "b"
function use(p) { print(p.m[9] ?? 3) }
const mm: {[i32]: AB} = Map()
mm[1] = "a"
mm[9] = "b"
use({ m: mm })
type J = { r: i32 | null }
function take(u: J | string) {
  if u is J { print(u.r ?? 0) } else { print(u) }
}
take({ r: 6 })
take({ r: null })
take("s")
function none(): boolean | null { return null }
function no(): boolean | null { return false }
function joined(f: () => boolean | null) {
  const i = f() ?? 5
  if i is i32 { print(i) } else { print(i) }
}
joined(none)
joined(no)
