// ir shadow: a shared scalar-or-null field read under ?? unboxes to the result's scalar, its default in the else
// expect covered >= 3
// expect matched >= 3
// expect no row containing coalesce nulRef boxFieldScalar
// expect no row containing fail
type A = { k: i32 | null, x: i32 }
type B = { k: i32 | null, y: string }
function f(u: A | B) { return u.k ?? -1 }
function g(u: A | B) { return u.k ?? 0.5 }
type C = { k: f64 | null, x: i32 }
type D = { k: f64 | null, y: string }
function h(u: C | D) { return u.k ?? 0.5 }
print(f({ k: 3, x: 1 }))
print(f({ k: null, y: "s" }))
print(h({ k: 2.5, x: 1 }))
print(g({ k: null, y: "t" }))
