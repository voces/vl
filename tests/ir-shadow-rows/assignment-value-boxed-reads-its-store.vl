// ir shadow: an assignment boxed as its value reads the store built ahead of it, with no verifier
// fallback
// expect no row containing claim fell back
// expect covered >= 1
// expect matched >= 1
function mk(c: boolean) {
  let x: i32 | null = null
  return if c { x = 5 }
}
function asArg(y: i32 | string) { print(y) }
function put(c: boolean) {
  let z: i32 | string = "s"
  asArg(z = 7)
  if c { print(z) }
}
print(mk(true) ?? 0)
put(true)
