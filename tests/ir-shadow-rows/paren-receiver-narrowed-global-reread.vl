// ir shadow: a parenthesized field receiver and a narrowed global box are read again and match
// expect covered >= 5
// expect no row containing uncovered
type C = { r: f64 | null }
type U = { u: i32 | string, k: string | null }
const lv1: C[] = [{ r: 7 }]
const ls: U[] = [{ u: "a", k: "a" }]
let g: "a" | i32 | null = "a"
function boxCmp() { return (lv1[0]).r == 7 }
function boxNested() { return ((lv1[0])).r == 7 }
function unionBox() { return (ls[0]).u == "a" }
function nullLeg(v: i32 | string | null) { return v == (ls[0]).k }
function globalPlain() {
  if g != null { return g == "a" }
  return false
}
print(boxCmp())
print(boxNested())
print(unionBox())
print(nullLeg("a"))
print(globalPlain())
