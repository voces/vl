// ir shadow: a literal-union atom boxed as its member string under the string tag builds
// expect covered >= 3
// expect matched >= 3
// expect no row containing box ladder
// expect no row containing fail
type A = "a" | "b"
type U = A | { tag: i32 }
function f(x: A): U { return x }
print(f("a") == "a")
function show(u: U) {
  if u is { tag: i32 } { print(u.tag) } else { print(u) }
}
function bound(x: A) {
  const u: U = x
  show(u)
}
bound("a")
function passed(x: A) { show(x) }
passed("b")
