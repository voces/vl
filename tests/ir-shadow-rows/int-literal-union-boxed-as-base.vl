// ir shadow: an integer literal-union value boxes under its base scalar arm
// expect covered >= 3
// expect matched >= 3
// expect no row containing box ladder
// expect no row containing fail
type LN = 1 | 2
function show(v: i32 | string) {
  if v is i32 { print(v) } else { print(v) }
}
function sLN(v: LN | null) {
  if v == null {
    print("none")
    return
  }
  show(v)
}
sLN(2)
sLN(null)
function up(v: LN): i32 | string { return v }
print(up(1))
