// ir shadow: a ref list read of a box element narrowed at its place reads unboxed, as legacy's tail unboxes it
// expect covered >= 2
// expect matched >= 2
// expect no row containing fail
function scalar(xs: (i32 | null)[]) {
  if xs[0] != null { print(xs[0] + 1) }
}
function member(xs: (f64 | string)[]) {
  if xs[0] is f64 { print(xs[0] + 0.5) } else { print("s") }
}
scalar([4, null])
member([1.5, "a"])
