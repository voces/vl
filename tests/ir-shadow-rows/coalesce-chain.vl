// ir shadow: a `??` chain builds as legacy's re-associated outer link, minted ahead of the bodies
// expect covered >= 2
// expect matched >= 2
// expect no row containing coalesce chain
// `num` and `grouped` lower `a ?? (b ?? d)` through the links `coalChainsPrime` minted.
function num(a: i32 | null, b: i32 | null, c: i32 | null) {
  return a ?? b ?? c ?? 9
}
function grouped(a: i32 | null, b: i32 | null) { return (a ?? b) ?? 4 }
print(num(null, null, 3))
print(grouped(null, null))
