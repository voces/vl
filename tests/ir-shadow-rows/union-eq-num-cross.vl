// ir shadow: a union compare whose number arm the operand widens to or from takes legacy's cross-width door
// expect covered >= 2
// expect matched >= 2
// An `i32` operand against an `f64` and an `i64` arm, on either side.
type F = f64 | string
type W = i64 | boolean
function fEq(u: F, k: i32) { return u == k }
function wNe(u: W, k: i32) { return k != u }
print(fEq(2.0, 2))
print(fEq("x", 2))
print(wNe(5, 5))
