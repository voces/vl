// ir shadow: a union-valued map read is its box, a miss the null-tagged box; a binding of it and a ?? over it (mapJoinIf) are built
// expect covered >= 2
const m: {[string]: i32 | string} = Map()
m["a"] = 3
m["b"] = "x"
function bind(k: string): boolean {
  const v = m[k]
  return v is i32
}
function orDefault(k: string): i32 | string { return m[k] ?? "none" }
function isStr(k: string): boolean { return m[k] is string }
print(bind("a"))
print(bind("z"))
print(orDefault("b"))
print(orDefault("z"))
print(isStr("b"))
