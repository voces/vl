// ir shadow: an instance's is that can never match its niche-held T | null is false, its call receiver still evaluated
// expect covered >= 2
// expect no row containing impossible null test
// expect no row containing fail
let calls = 0
function mk<T>(x: T): T | null {
  calls = calls + 1
  return x
}
function g3<T>(x: T) {
  if mk(x) is i32 { return 7 }
  return 8
}
function g6<T>(x: T) { return mk(x) is i32 }
print(g3("x"))
print(g3(1))
print(g6("y"))
print(calls)
