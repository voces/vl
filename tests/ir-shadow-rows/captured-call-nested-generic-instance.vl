// ir shadow: a capturing nested generic called directly builds its instance's closure, typed as that instance closes it, and matches
// expect covered >= 4
// expect matched >= 4
// expect no row containing mismatch
function outer(x: i32) {
  function inner<U>(u: U, n: i32) {
    if n > 0 { inner(u, n - 1) } else { print(x) }
  }
  inner(1, 2)
}
function pick(k: i32): i32 {
  function at<T>(t: T): i32 { return k }
  return at("s") + 1
}
outer(7)
print(pick(4))
