// ir shadow: a struct value on its arm's variant heap boxes as itself under that arm's tag
// expect covered >= 3
// expect matched >= 3
// expect no row containing box ladder
// expect no row containing fail
type Circle = { r: i32 }
function tag<T>(v: T) {
  const aw: i32 | string | T = v
  if aw is string { return "\"" + aw + "\"" }
  return "o"
}
function radius<T>(v: T, f: (x: T) => i32) {
  const aw: i32 | T = v
  if aw is i32 { return aw }
  return f(v)
}
const c: Circle = { r: 3 }
print(tag(c))
print(tag("hi"))
print(radius(c, (x) => x.r))
