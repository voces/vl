// ir shadow: a map store's value on legacy's scalar arm is widened, and on its union arm boxed
// expect covered >= 2
// expect matched >= 2
// expect no row containing fail
function widen(k: string) {
  const m: {[string]: f64} = Map()
  m[k] = 3
  print(m[k] ?? 0.5)
}
function boxed(k: string, n: i32) {
  const u: {[string]: i32 | string} = Map()
  u[k] = n
  u["s"] = "t"
  print(u.length)
}
widen("a")
boxed("a", 4)
