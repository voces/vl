// ir shadow: a `null` stored into an atom- or `boolean | null`-valued map is the value's sentinel
// expect covered >= 2
// expect matched >= 2
// expect no row containing fail
type K = "x" | "y"
function bools() {
  const m: Map<string, boolean | null> = Map()
  m.set("a", true)
  m.set("b", null)
  m["c"] = null
  print(m.get("b") == null)
  print(m.length)
}
function atoms() {
  const m: Map<string, K | null> = Map()
  m.set("a", "x")
  m.set("b", null)
  print(m.length)
}
bools()
atoms()
