// ir shadow: a shared nullable let written null after a number names its store miss
// expect uncovered store element >= 1
// The cell of a `T | null` let is a nested list; a store into it is `idxStoreOtherWhy`'s
// nested-literal arm, which stays a named miss, never silent.
function go(k: i32) {
  let u: i32 | null
  const set = (x: i32 | null) => {
    u = x
  }
  const get = () => if u == null { -1 } else { u }
  set(k)
  print(get())
  set(null)
  print(get())
  u = null
  print(get())
}
go(5)
