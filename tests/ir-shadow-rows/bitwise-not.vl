// ir shadow: a bitwise not builds as an xor with the all-ones mask and matches
// expect covered >= 5
// expect matched >= 5
function k(): i32 { return ~5 }
function k64(): i64 { return ~7 }
function w(x: i32): i64 { return ~x }
function g(x: i32): i32 { return ~~x + ~(x * 2) }
function m(x: i64, n: i64): i64 { return x & ~n }
print(k())
print(k64())
print(w(4))
print(g(9))
print(m(255, 15))
