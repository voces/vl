// ir shadow: a null unit result returns the bottom ref, and a null unit read is its destination null
// expect covered >= 4
// expect matched >= 4
// expect no row containing rep null
// expect no row containing fail
function q(f: () => i32 | null) {
  const t = f()
  return if t == null { 0 } else { 1 }
}
function nn() { return null }
print(q(() => null))
print(q(nn))
const z = nn()
print(z == null)
function hid(x) { return x }
print(hid(null) == null)
