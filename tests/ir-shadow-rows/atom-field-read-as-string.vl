// ir shadow: a field typed by one bare string literal, stored as its atom, read where the
// literal's string is wanted, is read at the atom and decoded by its consumer, as legacy does
// expect no row containing member record
// expect matched >= 2
type H = { k: "circle", n: i32 }
type A = { kind: "a", x: i32 }
type B = { kind: "b" | "c", x: i32 }
type U = A | B
function retH(h: H): string { return h.k }
function retA(a: A): string { return a.kind }
const a: A = { kind: "a", x: 1 }
const u: U = a
print(retH({ k: "circle", n: 1 }))
print(retA(a))
print(u.x)
