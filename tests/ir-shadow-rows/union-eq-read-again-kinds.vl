// ir shadow: a union compare's box or operand read again by name, and the number and list arms
// expect covered >= 4
// expect matched >= 4
// expect uncovered union compare box = 1
// A box that is a global or a field read is written again for each later read, an operand that is
// such a read at its use; i64 and f64 arms take the operand widened. A global list's element is not
// a read the lowering writes again (`byElem`).
type U = i32 | string
type W = i64 | string
type F = f64 | string
type L = i32[] | i32
type H = { u: U }
const gu: U = "a"
const gh: H = { u: 3 }
const gs: U[] = [1, "b"]
const gl: i32[] = [1, 2]
function byGlobal() { return gu == "a" }
function byField() { return gh.u == 3 }
function byElem() { return gs[1] != "b" }
function wide(w: W, f: F) { return w == 5 && f == 2 }
function lst(l: L) { return l == gl }
print(byGlobal())
print(byField())
print(byElem())
print(wide(5, 2.0))
print(lst([1, 2]))
