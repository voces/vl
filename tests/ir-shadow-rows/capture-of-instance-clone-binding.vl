// ir shadow: a generic instance's nested function capturing the frame's own binding finds the clone minted from the template's
// expect covered >= 7
// expect matched >= 7
// expect no row containing callee captures
// expect no row containing mismatch
function a<T>(x: T) {
  let k = (u) => {
    print(u)
  }
  const rd = () => {
    k(x)
  }
  rd()
}
a(1)
a(true)
