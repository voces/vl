// ir shadow: a value `match` with no `br_table` plan is the plain chain, whatever its scrutinee
// expect no row containing expression if int match
// expect no row containing stack value read out of order
// expect covered >= 6
// expect matched >= 6
// expect start covered >= 1
// expect start matched >= 1
// `match k` over a global and `match 1` over a literal are written as legacy's plain chain
// (`emitIntSwitch` declines); an integer `-` over a valued `if` is `0 - x`, its zero staged below.

function len(id: i32): i32 {
  return match id {
    0x10 => 14
    0x11 => 22
    -1 => 99
    _ => -1
  }
}

function name(id: i32) {
  match id {
    0 => {
      print("zero")
    }
    1 => {
      print("one")
    }
    _ => {
      print("other")
    }
  }
}

function wide(x: i64): string {
  return match x {
    0 => "z"
    4294967296 => "big"
    _ => "?"
  }
}

function span(id: i32) {
  return match id {
    0x12 | 0x13 => 30
    _ => 0
  }
}

print(len(0x10))
print(len(0x11))
print(len(-1))
print(len(7))
name(0)
name(5)
print(wide(0))
print(wide(4294967296))
print(wide(3))

const k = 2
match k {
  1 => print("m1")
  2 => print("m2")
  _ => print("mx")
}
const v = match k {
  2 => "two"
  _ => "?"
}
print(v)
print(span(0x12))
print(span(0x13))
const ks = match 1 {
  1 => "one"
  _ => "?"
}
print(ks)
const w: i64 = 5
function t() { return 1 == 1 }
function negIf() { print((-(if t() { 0xFFFFFFFF } else { 46341 })) + w) }
negIf()
