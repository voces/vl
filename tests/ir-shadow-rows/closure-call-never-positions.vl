// ir shadow: Q58's positions for a never function-value call, each behind a guard the live path skips (a never value in a record field or an un-annotated binding is a check refusal)
// expect matched >= 11
// expect no row containing call of a non-declaration
type B = (s: string) => never
function takeI(x: i32): i32 { return x * 2 }
function takeU(x: i32 | string): i32 {
  return if x is i32 { x } else { x.length }
}
function argScalar(bail: B, c: boolean): i32 {
  if c { return 1 }
  return takeI(bail("argScalar"))
}
function argUnion(bail: B, c: boolean): i32 {
  if c { return 2 }
  return takeU(bail("argUnion"))
}
function argNested(bail: B, c: boolean): i32 {
  if c { return 3 }
  return takeI(takeI(bail("argNested")))
}
function concat(bail: B, c: boolean): string {
  if c { return "concat" }
  return "a" + bail("concat")
}
function hole(bail: B, c: boolean): string {
  if c { return "hole" }
  return "a\{bail("hole")}b"
}
function ret(bail: B, c: boolean): i32 {
  if c { return 6 }
  return bail("ret")
}
function letInit(bail: B, c: boolean): i32 {
  if c { return 7 }
  const v: i32 = bail("letInit")
  return v + 1
}
function ifArm(bail: B, c: boolean): i32 {
  const v = if c { 9 } else { bail("ifArm") }
  return v
}
function coalesce(bail: B, n: i32 | null): i32 {
  const v = n ?? bail("coalesce")
  return v
}
const bail = (s: string): never => {
  print(s)
  __trap__()
}
print(argScalar(bail, true))
print(argUnion(bail, true))
print(argNested(bail, true))
print(concat(bail, true))
print(hole(bail, true))
print(ret(bail, true))
print(letInit(bail, true))
print(ifArm(bail, true))
print(coalesce(bail, 10))
