// ir shadow: a call through a tagged function set as a statement builds as legacy's dispatch
// expect covered >= 8
// expect matched >= 8
// expect no row containing call of a non-declaration
// expect no row containing tag dispatch result rep
function show<T>(x: T) { print(x * 3) }
function d() { return show }
function e() { return d() }
function last() {
  const u = d()
  u(8)
}
function notLast() {
  const u = d()
  u(2)
  print(0)
}
function copied() {
  const u = d()
  const w = u
  w(3)
}
function nested() {
  const n = e()
  n(7)
}
function twice() {
  const u = d()
  u(1)
  u(4)
}
last()
notLast()
copied()
nested()
twice()
