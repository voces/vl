// ir shadow: a parameter spelled like an intrinsic is an ordinary closure call where legacy's is, and matches
// expect covered >= 6
// expect matched >= 6
// expect no row containing call of a non-declaration
// expect no row containing mismatch
function grow(__memory_grow__: (n: i32) => i32): i32 {
  return __memory_grow__(1)
}
function shared(__memory_shared__: () => boolean): i32 {
  if __memory_shared__() { return 1 }
  return 2
}
function load(__load_i32__: (p: i32) => i32): i32 { return __load_i32__(4) * 3 }
print(grow((n) => n + 10))
print(shared(() => true))
print(load((p) => p + 1))
