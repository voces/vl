// ir shadow: a record-joined value if compared with a record builds as legacy's struct compare
// expect no row containing fail
// expect no row containing mismatch
// expect start matched >= 1
// Legacy's `eqRouteOf` counts a record-joined `if` operand as the record (D17132); the IR, which
// leaves the compare to legacy, must stay beside it without a mismatch.
type P = { x: i32 }
type Q = { y: string }
function f(u: P | Q, v: P) { return v == (if u is P { u } else { v }) }
print(f({ x: 1 }, { x: 1 }))
print(f({ x: 2 }, { x: 1 }))
