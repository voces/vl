// ir shadow: v128 values and SIMD intrinsics build through RSimd and match
// expect covered >= 12
// expect matched >= 12
// expect no row containing uncovered
type V = new v128
function splat(x: f32): V { return __splat_f32x4__(x) as V }
function add(a: V, b: V): V {
  return __add_f32x4__(a as! v128, b as! v128) as V
}
function lane2(v: V): f32 { return __extract_lane_f32x4__(v as! v128, 2) }
function repl(v: v128, y: f32): v128 { return __replace_lane_f32x4__(v, 1, y) }
function swap(a: v128, b: v128): v128 {
  return __shuffle_f32x4__(a, b, 1, 0, 7, 6)
}
function mask(v: v128): i32 { return __bitmask_i32x4__(v) }
function shl(v: v128, n: i32): v128 { return __shl_i32x4__(v, n) }
function sel(a: v128, b: v128, m: v128): v128 {
  return __bitselect_v128__(a, b, m)
}
function wide(x: i64): i64 {
  return __extract_lane_i64x2__(__splat_i64x2__(x), 1)
}
function keep(v: V): V {
  const w = v
  return w
}
function twice(x: f32): f32 {
  const t = __splat_f32x4__(x)
  const u = __add_f32x4__(t, t)
  return __extract_lane_f32x4__(u, 3)
}
function anyLt(a: v128, b: v128): boolean {
  return __any_true_v128__(__lt_f32x4__(a, b)) != 0
}
const s = add(splat(1.5), splat(2.0))
print(lane2(keep(s)))
const r = swap(repl(s as! v128, 9.0), __splat_f32x4__(4.0))
print(__extract_lane_f32x4__(r, 0))
print(mask(shl(__splat_i32x4__(1), 31)))
print(
  __extract_lane_i32x4__(
    sel(__splat_i32x4__(7), __splat_i32x4__(3), __splat_i32x4__(-1)),
    0,
  ),
)
print(wide(5 as i64))
print(twice(1.25))
print(anyLt(__splat_f32x4__(1.0), __splat_f32x4__(2.0)))
