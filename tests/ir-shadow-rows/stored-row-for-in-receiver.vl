// ir shadow: a for-in over a list read at a stored row's field walks that row's element
// expect start matched >= 1
// expect no row containing for in stored-row receiver
type J = { f: i32 | null }
function mk2() { return { f: null } }
const dA: J = mk2()
const go = [1].length > 0
const r = { ys: [mk2()] }
for y in r.ys { print(y.f) }
