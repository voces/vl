// ir shadow: a closure call widens an i32 argument to its f64 parameter and passes a closure and a list as they stand
// expect covered >= 5
// expect matched >= 5
function ap(f: (x: f64) => f64, n: i32): f64 { return f(n) }
function ap2(f: (g: (k: i32) => i32, xs: i32[]) => i32, g: (k: i32) => i32): i32 { return f(g, [1, 2]) }
function use2(g: (k: i32) => i32, xs: i32[]): i32 { return g(xs[1]) }
function inc(k: i32): i32 { return k + 1 }
function half(x: f64): f64 { return x / 2.0 }
print(ap(half, 3))
print(ap2(use2, inc))
