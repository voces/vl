// ir shadow: a module closure binding initialized by a call is the value the call returns, written at the cell, and matches
// expect start covered >= 1
// expect start matched >= 1
// expect no row containing closure value of a call
// expect no row containing mismatch
function adder(k: i32): (n: i32) => i32 { return (n: i32) => n + k }
const add2 = adder(2)
print(add2(5))
