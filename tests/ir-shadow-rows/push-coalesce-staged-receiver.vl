// ir shadow: a push onto a field receiver whose value is a boxed ??
// expect covered >= 2
// expect matched >= 2
// expect no row containing push short-circuit operand
type VK = "str" | "i32" | "map"
type Plan = { eTags: i32[], eFrom: VK[] }
function sig(i: i32): VK | null { if i == 0 { return null } return "map" }
function fl(plan: Plan, e: i32, k: VK): i32 {
  plan.eFrom.push(sig(e) ?? k)
  return plan.eFrom.length
}
print(fl({ eTags: [], eFrom: [] }, 0, "i32"))
