// ir shadow: a `??` written in place after an earlier argument stages that argument below it
// expect covered >= 4
// expect matched >= 4
// expect no row containing short-circuit argument after another
// expect no row containing after an operand
type VK = "i32" | "i64" | "f64" | "str"
type D = { k: VK | null, w: i32 }
function dOf(n: i32): D { return if n > 0 { { k: "i64", w: n } } else { { k: null, w: 0 } } }
function s2(n: i32, s: VK): i32 { return n + (if s == "i64" { 100 } else { 0 }) }
function width(n: i32): i32 { return n * 2 }
function lead(n: i32): i32 {
  const k = dOf(n).k
  return s2(27, k ?? "i32")
}
function afterTemp(n: i32): i32 {
  const k = dOf(n).k
  return s2(width(n), k ?? "f64")
}
print(lead(1))
print(lead(0))
print(afterTemp(3))
print(afterTemp(0))
