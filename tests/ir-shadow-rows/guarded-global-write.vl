// ir shadow: a global written by a function that may run before its initializer guards the write and matches
// expect covered >= 2
// expect no row containing uncovered
function setN(v: i32, go: boolean) {
  if go { n = v }
}
function setS(v: string, go: boolean) {
  if go { s = v + "!" }
}
setN(9, false)
setS("x", false)
let n = 3
let s = "s"
setN(5, true)
setS("y", true)
print(n)
print(s)
