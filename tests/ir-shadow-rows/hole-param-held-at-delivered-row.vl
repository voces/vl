// ir shadow: a hole function's parameter, local and result held at the row legacy declares them at
// expect covered >= 2
// expect matched >= 2
// expect no row containing return coercion
// expect no row containing narrowed read
// expect no row containing fail
type A = { d: i32 | null }
function g(v) {
  const w = v
  return w
}
const c: A = g({ d: 5 })
print(c.d ?? -1)
function h(v) { return v }
const f: A = h({ d: 7 })
print(f.d ?? -1)
