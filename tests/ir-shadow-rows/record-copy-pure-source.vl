// ir shadow: a record copy legacy re-reads per field (one flat field) is legacy's whole copy
// expect start covered >= 1
// expect start matched >= 1
// expect no row containing pre-path coercion recCopy
type D = { v: f64 }
const x: i32 = 3
function mk() { return { v: x } }
const d: D = mk()
print(d.v / 2.0)
const e: D = mk()
print(e.v)
