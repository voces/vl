// ir shadow: a nullable number coalesced with a number of another type is legacy's typed null-test join
// expect covered >= 2
// expect matched >= 2
// expect no row containing coalesce nulRef numJoinIf
// expect no row containing fail
function orHalf(a: (i64 | null)[]) { print(a[1] ?? 0.5) }
function orHalfAdd(a: (i32 | null)[]) { print((a[0] ?? 0.5) + 1) }
const x: (i64 | null)[] = [1, null]
const y: (i32 | null)[] = [1]
const z: (f64 | null)[] = [1.5]
print(z[0] ?? 2)
orHalfAdd(y)
orHalf(x)
print((y[0] ?? 0.5) + 2)
