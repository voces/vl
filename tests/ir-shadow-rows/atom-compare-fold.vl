// ir shadow: an == over two sides typed as single string literals folds: each side's id dropped, then the constant
// expect covered >= 2
function same(a: "x", b: "x"): boolean { return a == b }
function notSame(a: "x", b: "x"): boolean { return a != b }
print(same("x", "x"))
print(notSame("x", "x"))
