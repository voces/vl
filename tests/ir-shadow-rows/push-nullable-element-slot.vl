// ir shadow: a push onto a nullable element slot appends the value as legacy builds it: own rep, ref widened to its nullable, or a bare null
// expect covered >= 1
// expect matched >= 1
// expect no row containing push nested list element
// expect no row containing push nullable element coercion
// expect no row containing mismatch
type R = { v: i32 }
function mkr(n: i32): R { return { v: n } }
function fill(m: R | null): i32 {
  const xs: (R | null)[] = []
  xs.push(mkr(4))
  xs.push(null)
  xs.push({ v: 5 })
  if m != null { xs.push(m) }
  return xs.length
}
print(fill(mkr(6)))
