// ir shadow: an exact numeric as? builds through legacy's numeric cast tail, yielding its box
// expect covered >= 2
// expect matched >= 2
// expect no row containing expression as
// `wide` and `flo` cast an i64 and an f64 to `i32 | null` (`RNumCast` over `numExactCastTail`).
function wide(x: i64) {
  const n = x as? i32
  return if n == null { -1 } else { n }
}
function flo(x: f64) {
  const n = x as? i32
  return if n == null { -1 } else { n }
}
print(wide(7))
print(flo(2.5))
