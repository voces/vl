// ir shadow: a statement if or ! over a decided is takes its constant; a value if and a short-circuit stay named misses
// expect covered >= 3
// expect uncovered decided is condition = 1
// expect uncovered decided is short-circuit = 1
function stmtIf<T>(v: T): i32 {
  let r = 0
  if v is i32 { r = 1 } else { r = 2 }
  return r
}
function valueIf<T>(v: T): i32 { return if v is string { 3 } else { 4 } }
function notIs<T>(v: T): boolean { return !(v is i32) }
function shortIs<T>(v: T, b: boolean): boolean { return v is i32 && b }
function ends<T>(v: T): i32 {
  if v is i32 { return 5 }
  return 6
}
print(stmtIf(1))
print(valueIf(1))
print(notIs(1))
print(shortIs(1, true))
print(ends(1))
