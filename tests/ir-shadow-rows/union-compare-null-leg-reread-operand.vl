// ir shadow: a null-leg union compare reads a field or global operand again in its plain arm and matches
// expect covered >= 4
// expect no row containing uncovered
// Box null against operand null answers on the null leg; a string against itself on the plain arm.
type U = i32 | string | null
type H = { k: string | null }
let gk: string | null = null
function byField(u: U, h: H) { return u == h.k }
function byFieldNe(u: U, h: H) { return h.k != u }
function byGlobal(u: U) { return u == gk }
function byGlobalNe(u: U) { return gk != u }
function show(u: U, k: string | null) {
  gk = k
  const h: H = { k: k }
  print(byField(u, h))
  print(byFieldNe(u, h))
  print(byGlobal(u))
  print(byGlobalNe(u))
}
show(null, null)
show("s", null)
show(null, "s")
show("s", "s")
show("s", "t")
show(1, "s")
