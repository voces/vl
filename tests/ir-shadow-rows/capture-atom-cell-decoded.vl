// ir shadow: a capture of a binding held as the atom, read at a string, decodes the captured atom
// expect covered >= 1
// expect no row containing capture binding
// expect no row containing fail
const A = "x"
const B = "y"
function main(c: boolean) {
  const M = if c { A } else { B }
  const f = () => M
  print(f())
}
main(true)
main(false)
