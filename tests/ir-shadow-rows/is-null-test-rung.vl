// ir shadow: an is test at the null-test rung over a nullable niche is covered and matches
// expect covered >= 5
// expect no row containing uncovered
type K = "a" | "b"
function sNul(s: string | null) { return if s is null { 1 } else { 0 } }
function sSome(s: string | null) { return if s is string { 1 } else { 0 } }
function bNul(b: boolean | null) { return if b is null { 1 } else { 0 } }
function bSome(b: boolean | null) { return if b is boolean { 1 } else { 0 } }
function kNul(k: K | null) { return if k is null { 1 } else { 0 } }
print(sNul(null) + sSome("x") + bNul(false) + bSome(null) + kNul("b"))
