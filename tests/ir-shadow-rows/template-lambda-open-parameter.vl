// ir shadow: a template lambda's open parameter is held at the kind legacy declares it at
// expect covered >= 7
// expect matched >= 7
// expect no row containing parameter rep
// `count`'s lambda takes `_v` at the template's open `T`, which has no rep of its own; legacy
// declares the parameter at its descriptor's kind, and the IR holds it there (`repDescTy`).
function each<T>(self: T[], f: (T) => void) {
  for x in self { f(x) }
}
function count<T>(x: T) {
  let n = 0
  each(x, (_v) => {
    n = n + 1
  })
  return n
}
print(count([1, 2, 3, 4]))
print(count(["a", "b"]))
