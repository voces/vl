// ir shadow: a record's own `length` field read through a narrowed binding is a plain member read
// expect covered >= 1
// expect matched >= 1
// expect no row containing member record
// `size` reads `d.length` with `d` narrowed to `B` out of `u8[] | B`; legacy's `emitMemberNode`
// passes every earlier `length` arm and reads the narrowed field.
type B = { base: i32, length: i32 }
function size(d: u8[] | B) {
  if d is B { return d.length }
  return 0
}
print(size({ base: 1, length: 4 }))
