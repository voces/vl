// ir shadow: range loops inside a list reserve region build as legacy unrolls them
// expect covered >= 2
// expect matched >= 2
// expect no row containing for range in a reserve region
// The pushes into `o` are counted into its reserve, which legacy weighs as inline when it decides
// to unroll, so the builder plans them before it asks: `inner` and `outer` unroll as legacy does.
function inner(): i32[] {
  const o: i32[] = []
  for i in 0 until 3 { o.push(i) }
  print(o.length)
  return o
}
function outer(): i32[] {
  const o: i32[] = []
  for i in 0 until 2 {
    for j in 0 until 2 { o.push(i * 2 + j) }
  }
  print(o.length)
  return o
}
function wide(): u8[] {
  const o: u8[] = []
  for i in 0 until 300 { o.push(i) }
  print(o.length)
  return o
}
print(inner()[2])
print(outer()[3])
print(wide()[7])
