// ir shadow: an element read through a union of lists or maps a hole parameter holds is built as legacy's tag chain over the box, its index a variable, an immediate or a key literal
// expect covered >= 5
// expect matched >= 5
// expect no row containing index none
function mkS(k: i32): i32[] | f64[] {
  if k == 0 { return [1.5, 2.5] }
  const a = [4, 7]
  return a
}
function second(a) { print(a[1]) }
second(mkS(1))
second(mkS(0))
function at(a, i: i32) { print(a[i]) }
at(mkS(1), 0)
at(mkS(0), 1)
function mkT(k: i32): string[] | i32[] {
  if k == 0 { return ["x", "y"] }
  const a = [4, 7]
  return a
}
function first(a) {
  const e = a[0]
  if e is string { print("s:" + e) } else { print(e + 1) }
}
first(mkT(1))
first(mkT(0))
function pick(c: boolean) {
  const s: {[string]: string} = Map()
  s["k"] = "v"
  const t: {[string]: boolean} = Map()
  t["k"] = true
  return if c { s } else { t }
}
function show(r: string | boolean | null): string {
  if r is null { return "null" }
  if r is string { return r }
  return "b"
}
function key(m) { print(show(m["k"])) }
key(pick(true))
key(pick(false))
type K = 1 | 2
function lit(r: i64[] | f64[] | u8[] | K[]) {
  if r is K[] { return r[1] }
  return -1
}
const d: K[] = [1, 2]
print(lit(d))
const e = [2.5, 1.0]
print(lit(e))
