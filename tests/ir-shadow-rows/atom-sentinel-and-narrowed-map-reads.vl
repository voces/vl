// ir shadow: an atom map under ??, a K | null and a boolean | null map at their sentinel, and narrowed scalar and record reads
// expect covered >= 6
// expect matched >= 6
// expect no row containing map read atom
// expect no row containing map read sentinel
// expect no row containing map get rep
// expect no row containing fail
type AB = "a" | "b" | "c"
function atomOr(m: {[string]: AB}, k: string): AB { return m[k] ?? "b" }
function nulAtomOr(m: {[string]: AB | null}, k: string): AB {
  return m[k] ?? "c"
}
function nulBoolOr(m: {[string]: boolean | null}, k: string) {
  return m[k] ?? false
}
function wide(m: {[string]: i64}) {
  if m["k"] != null { return m["k"] }
  return -1
}
function rec(m: {[string]: {f: i64} | null}, k: string) {
  const v = m[k]
  if v != null { print(v.f) } else { print("MISS") }
}
function go() {
  const a: {[string]: AB} = Map()
  a["x"] = "a"
  print(atomOr(a, "x"))
  print(atomOr(a, "y"))
  const n: {[string]: AB | null} = Map()
  n["z"] = null
  print(nulAtomOr(n, "z"))
  const t: {[string]: boolean | null} = Map()
  t["y"] = true
  print(nulBoolOr(t, "y"))
  print(nulBoolOr(t, "q"))
  const w: {[string]: i64} = Map()
  w["k"] = 7
  print(wide(w))
  const e: {[string]: i64} = Map()
  print(wide(e))
  const r: {[string]: {f: i64} | null} = Map()
  r["k"] = { f: 42 }
  rec(r, "k")
  rec(r, "q")
}
go()
