// ir shadow: an order-stashed record whose later field is a valued if sets each field into its slot, and matches
// expect covered >= 1
// expect matched >= 1
// expect no row containing short-circuit field after another
type R = { a: i32, s: string, n: boolean, x: boolean }
function mk(a: i32, k: boolean): R {
  return {
    a: if k { 1 } else { a },
    s: "q",
    n: k,
    x: if k { a > 2 } else { a < 0 },
  }
}
print(mk(3, true).a)
print(mk(-5, false).x)
