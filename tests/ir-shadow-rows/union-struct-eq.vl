// ir shadow: a `==`/`!=` over a union of records takes the struct union compare, a narrowed local read as its box
// expect covered >= 5
// expect matched >= 5
// expect no row containing operand type
// expect no row containing union compare operand rep
type A = { a: i32 }
type B = { b: i32, s: string }
type AB = A | B
const src: A = { a: 1 }
function same(u: AB, v: AB) { return u == v }
function differ(u: AB, v: AB) { return u != v }
function guarded(u: AB, held: AB) {
  if u is A { return u == held }
  return u != held
}
function reassigned(held: AB) {
  let r: AB = src
  r = { b: 2, s: "x" }
  return r == held
}
function mixedArms(u: AB) {
  const w: AB = { b: 3, s: "y" }
  return u == w
}
print(same(src, { a: 1 }))
print(differ(src, { b: 1, s: "z" }))
print(guarded(src, src))
print(reassigned({ b: 2, s: "x" }))
print(mixedArms({ b: 3, s: "y" }))
