// ir shadow: a hole lambda instanced at `never` reads its parameter at each delivery position;
// every read is legacy's `unreachable` at its consumer's rep (Q58 position sweep)
// expect no row containing pre-path dead never
// expect no row containing fail
function fail(): never { __trap__() }
function sI(p: i32): i32 { return p }
function sU(p: i32 | string): i32 { return if p is i32 { p } else { 0 } }
function g<T>(t: T): T { return t }
function k(n: i32, c: boolean): i32 {
  const argS = (x) => sI(x)
  const argU = (x) => sU(x)
  const nested = (x) => sI(g(x))
  const cat = (x) => "a" + x
  const interp = (x) => "<\{x}>"
  const ret = (x) => x
  const letInit = (x) => {
    const y: i32 = x
    return y
  }
  const ifArm = (x) => if c { x } else { 1 }
  const coal = (x) => x ?? 1
  const field = (x) => {
    const r: { a: i32 } = { a: x }
    return r.a
  }
  if n > 5 {
    argS(fail())
    argU(fail())
    nested(fail())
    cat(fail())
    interp(fail())
    ret(fail())
    letInit(fail())
    ifArm(fail())
    coal(fail())
    field(fail())
  }
  return n
}
print(k(3, true))
