// ir shadow: a loop variable forwarded through a sibling, and an instance's closure over its parameter
// expect covered >= 11
// expect matched >= 11
// expect no row containing closure env capture
// A `for-in` element or range counter a nested function captures is typed by its loop when the
// forwarding frame never reads it (`capLoopTyOf`). A generic or hole instance's closure over its
// own parameter is held at that parameter's type (`capRepAtTy`).
function walk() {
  for g in ["a", "b"] {
    function k() { print(g) }
    function inner() { k() }
    inner()
  }
  for i in 1 to 2 {
    function kr() { print(i) }
    function innerR(h: i32) { kr() }
    innerR(7)
  }
}
walk()
function id<T>(x: T): T { return x }
const ks = [id]
function both<T>(t: T) {
  ks[0] = (x) => {
    print(t)
    return x + x
  }
  print(ks[0](7))
}
both(8)
both("b")
function app<T, U>(f: (T) => U, v: T): U { return f(v) }
function viaCap(a, k) { print(a((n) => n + k, 2)) }
viaCap(app, 10)
