// ir shadow: a reference join's chain opens every link at its head's join, as legacy writes it
// expect covered >= 1
// expect matched >= 1
// expect no row containing ref if chain join
type Arm = "null" | "atom" | "union" | "ref" | "scalar"
function rungOf(a: Arm): string {
  const rung = match a {
    "null" => "null join"
    "atom" => ""
    "union" => "union"
    "ref" => ""
    "scalar" => ""
  }
  return rung
}
print(rungOf("union"))
print(rungOf("null"))
