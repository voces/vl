// ir shadow: a memory access over computed and called operands matches
// expect covered >= 4
// expect matched >= 4
function k(n: i32): i32 { return n * 2 }
function st(i: i32, j: i32) { __store_i32__(i + j * 4, k(j) + 1) }
function stc(i: i32) { __store_i32__(k(i), k(i + 1)) }
function ld(i: i32, j: i32): i32 {
  return __load_i32__(k(i) + j) + __load_u8__(i * 3)
}
st(100, 2)
stc(60)
print(ld(54, 0))
