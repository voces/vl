// ir shadow: an order-stashed record with a valued if field boxed into its union is a named miss
// expect uncovered box of a stash-set record = 1
type V1 = { op: string, l: i32, r: i32, id: i32 }
type V2 = { name: string }
type Node = V1 | V2
function bin(op: string, l: i32, r: i32): i32 {
  const ident = op == "==="
  const n: Node = {
    op: if ident { "==" } else { op },
    l: l,
    r: r,
    id: if ident { 1 } else { 0 },
  }
  return if n is V1 { n.id } else { -1 }
}
print(bin("===", 1, 2))
print(bin("+", 1, 2))
