// ir shadow: a tag test on a for walk variable's box reads it raw
// expect covered >= 1
// expect matched >= 1
// expect no row containing is box not a local
type OV = { ov: i32 }
type OI = { oiBits: i32 }
type Op = OV | OI
function f(es: Op[]): i32 {
  let n = 0
  for e in es {
    if !(e is OI || e is OV) { return -1 }
    if e is OV { n = n + e.ov }
  }
  return n
}
print(f([{ ov: 3 }, { oiBits: 1 }]))
