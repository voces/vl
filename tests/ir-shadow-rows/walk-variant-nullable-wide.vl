// ir shadow: variant, nullable and wide scalar walks are covered and match
// expect covered = 6
// expect matched = 6
type C = { r: i32 }
type Q = { s: i32 }
type Sh = C | Q
type P = { x: i32 }
function sumR(cs: C[]): i32 {
  let t = 0
  for c in cs { t = t + c.r }
  return t
}
function nonNull(xs: (string | null)[]): i32 {
  let n = 0
  for x in xs {
    if x != null { n = n + 1 }
  }
  return n
}
function nulRec(ps: (P | null)[]): i32 {
  let n = 0
  for p in ps {
    if p != null { n = n + p.x }
  }
  return n
}
function sumF(fs: f64[]): f64 {
  let t = 0.0
  for f in fs { t = t + f }
  return t
}
function sumL(ls: i64[]): i64 {
  let t: i64 = 0
  for l in ls { t = t + l }
  return t
}
function isC(s: Sh): boolean { return s is C }
print(sumR([{ r: 1 }, { r: 2 }]))
print(nonNull(["a", null, "b"]))
print(nulRec([{ x: 4 }, null]))
print(sumF([1.5, 2.0]))
print(sumL([3, 4]))
print(isC({ s: 1 }))
