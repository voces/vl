// ir shadow: a hole function read as a value on legacy's inert arm builds its closure by the core writer and matches
// expect matched >= 2
// expect no row containing closure value inert
function inc0(a) { return a + 1 }
function mk<T>(x: T) { return [{ fs: [inc0], x: x }] }
const r = mk(5)
const f = r[0].fs[0]
print(f(r[0].x))
