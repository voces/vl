// ir shadow: an else-less value if at a union box, a reference join and an i32 niche; a left operand or an earlier field staged below a valued if; a valued break out of a for
// expect covered >= 10
// expect matched >= 10
// expect no row containing expression if no else
// expect no row containing short-circuit
// expect no row containing break
type Box = { v: i32 | null }
type P = { a: i32 }
type K = "a" | "b"
type R = { a: i32, b: string }
function take(v: i32 | null): void {
  if v != null { print(v) } else { print(-1) }
}
function id(n: i32): i32 { return n }
function arg(c: boolean): void { take(if c { 7 }) }
function field(c: boolean): void {
  const b: Box = { v: if c { 7 } }
  take(b.v)
}
function rec(c: boolean): void {
  const x: P | null = if c { { a: 7 } }
  print(if x != null { x.a } else { -1 })
}
function mkK(): K { return "a" }
function lit(c: boolean): void {
  const k: K | null = if c { mkK() }
  print(k ?? "-")
}
function lead(c: boolean, a: i32): i32 { return a + id(if c { 5 } else { 1 }) }
function fields(c: boolean, x: i32): R { return { a: x, b: if c { "y" } else { "n" } } }
function brk(k: i32): i32 {
  const r = for i in 0 to 3 {
    if i == k { break i * 10 }
    break -1
  }
  return r ?? -2
}
arg(true)
arg(false)
field(true)
rec(false)
lit(true)
print(lead(true, 1))
print(fields(false, 3).b)
print(brk(0))
