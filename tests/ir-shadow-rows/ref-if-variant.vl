// ir shadow: a value if joined at a variant row builds, its arms written as themselves
// expect covered >= 3
// expect matched >= 3
// expect no row containing expression if ref variant
// expect no row containing mismatch
type OVar = { ov: i32 }
type OImm = { oiRep: i32, oiBits: i64 }
type Opnd = OVar | OImm

function mk(k: i32): OVar {
  const o: OVar = { ov: k }
  return o
}

function test(a: Opnd, b: Opnd): i32 {
  if a is OVar && b is OVar { return a.ov + b.ov }
  return -1
}

function pick(w: i32): i32 {
  const a = mk(10)
  const b = mk(20)
  const c = mk(1)
  const v = if w == 4 { a } else { b }
  return c.ov + v.ov
}

print(pick(4))
print(pick(1))
const im: OImm = { oiRep: 1, oiBits: 2 }
print(test(im, im))
