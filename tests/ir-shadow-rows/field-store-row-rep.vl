// ir shadow: a field store into a generic instance's wider row slot writes that row
// expect covered >= 2
// expect matched >= 2
// expect no row containing field store row rep
// `put` is instanced at `J`, whose `f` is stored as a union box while the parameter reads it as
// `i32`: the receiver is built at `J`'s row, so the store writes the box there.
type J = { f: i32 | null }
type K = { j: J }
const y = { j: { f: 4 } }
const ks: K[] = [y]
print(ks.length)
function own(q: { f: i32 }) { return q.f }
print(own(y.j))
const v = y.j
print(own(v))
function put(q: { f: i32 }) { q.f = 5 }
put(y.j)
print(ks[0].j.f ?? 0)
