// ir shadow: a field store into a generic instance's wider row slot is a named miss
// expect covered = 1
// expect matched = 1
// expect uncovered field store row rep = 1
// `put` is instanced at `J`, whose `f` is stored as a union box while the parameter reads it as
// `i32`: the box arm does not write into the read's rep, so the store stays legacy's.
type J = { f: i32 | null }
type K = { j: J }
const y = { j: { f: 4 } }
const ks: K[] = [y]
print(ks.length)
function own(q: { f: i32 }) { return q.f }
print(own(y.j))
const v = y.j
print(own(v))
function put(q: { f: i32 }) { q.f = 5 }
put(y.j)
print(ks[0].j.f ?? 0)
