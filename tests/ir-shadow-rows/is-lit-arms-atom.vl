// ir shadow: an is test at litArms' atom arms is the operand and its compare: not the null id, or each member's id
// expect covered >= 2
type K = "a" | "b" | "c"
type J = "a" | "b"
function kOf(n: i32): K | null { return if n > 0 { "a" } else { null } }
function notNul(n: i32): boolean {
  const k = kOf(n)
  return k is K
}
function members(k: K): boolean { return k is J }
print(notNul(1))
print(notNul(0))
print(members("b"))
print(members("c"))
