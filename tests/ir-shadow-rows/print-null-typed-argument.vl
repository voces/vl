// ir shadow: a print of a null-typed argument runs it for its effect, then legacy's null word
// expect matched >= 3
// expect no row containing print nulNone
// expect no row containing fail
// expect no row containing mismatch
// `printStmt`'s `nulNone` arm: `nulNoneEffect`, then `RPrint`, whose lowering calls
// `emitPrintNullWord`.
function noisy(): null {
  print("effect")
  return null
}
function a(x: null) { print(x) }
function b() { print(noisy()) }
function c() { print(null) }
a(null)
b()
c()
