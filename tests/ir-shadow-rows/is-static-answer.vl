// ir shadow: an is test with a static answer is its constant after a call receiver, unless emitIs's pre-arm decides it
// expect covered >= 3
// expect uncovered is pre-arm prim = 3
// expect uncovered is pre-arm tautology = 2
// expect uncovered is pre-arm pin = 1
type A = { a: i32 }
type B = { b: string }
type K = "x" | "y"
function mk(): A { return { a: 1 } }
function num(): i32 { return 4 }
function never1(v: A | B): boolean { return v is K }
function never2(v: i32): boolean { return v is string }
function inst<T>(v: T): boolean { return v is i32 }
function same(v: A): boolean { return v is A }
function neverCall(): boolean { return num() is string }
function sameCall(): boolean { return mk() is A }
print(never1({ a: 1 }))
print(
  never2(1) || inst(2) || inst("s") || same({ a: 1 }) || neverCall() || sameCall(),
)
