// ir shadow: a union compare whose box is a call takes legacy's stashed arm
// expect covered >= 1
// expect matched >= 1
// expect no row containing union compare plan
const CLOSED = 2147483647
const opens: i32[] = []
function f(x: i32): i32 {
  opens.push(CLOSED)
  let id = x
  if opens.pop() == CLOSED { id = id + 1 }
  return id
}
print(f(3))
