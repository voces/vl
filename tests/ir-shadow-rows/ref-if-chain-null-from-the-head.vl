// ir shadow: a reference join's chain nullable from its head link, with an inner link yielding none
// expect covered >= 1
// expect matched >= 1
// expect no row containing ref if chain null inward
// The head arm reads a hole instantiated `K | null`, so the chain's blocktype is nullable from the
// head; the inner `else if` yields no null and opens at the chain's type (`siJoinNul`).
type K = "a" | "b"
function g(a0, a1, k: i32) {
  const o = { v: if k == 0 { a0 } else if k == 1 { a1 } else { "z" } }
  print(o.v ?? "none")
}
const x0: K | null = null
const x1: K = "b"
g(x0, x1, 0)
g(x0, x1, 1)
g(x0, x1, 2)
