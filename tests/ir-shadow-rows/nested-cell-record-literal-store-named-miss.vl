// ir shadow: a shared record-or-null let's nested cell store of a record literal is a named miss
// expect uncovered store element record literal >= 1
// expect no row containing fail
// The store's element-read row legacy banks from its receiver, the lowering from the record's
// own read; the shape stays refused, by name, rather than claimed with rows that disagree.
type P = { x: i32 }
function go() {
  let u: P | null
  const g = () => if u == null { 0 } else { u.x }
  print(g())
  u = { x: 7 }
}
go()
