// ir shadow: an index trap, a write trap and an operator field build through the field call
// expect covered >= 7
// expect matched >= 7
// expect no row containing rep ?
function cell(init: i32) {
  const store = [init, init, init]
  return {
    "[]": (k: i32) => store[k],
    "[]=": (k: i32, v: i32) => {
      return store[k] = v
    },
  }
}
function scale(x: i32) { return { "*": (s: i32) => x * s } }
function read(i: i32) {
  const c = cell(7)
  c[i] = 42
  return c[i] + c[0]
}
function times(n: i32) {
  const a = scale(n)
  return a * 3
}
print(read(1))
print(times(5))
