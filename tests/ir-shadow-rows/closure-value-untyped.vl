// ir shadow: a function literal with no type of its own, returned, is the closure value of its function's result
// expect covered >= 6
// expect matched >= 6
// expect no row containing rep ?
// expect no row containing mismatch
// expect no row containing fail
function mk() { return (a) => a + 2.5 }
function take(a: (a: i32) => f64) { print(a(3)) }
function adder(n: f64) { return (a) => a + n }
const x = mk()
take(x)
const z = adder(2.25)
print(z(0.5))
