// ir shadow: a field read off a receiver held at its storage row reads that row's field
// expect covered >= 5
// expect no row containing field read of a stored row
// @run
// @log null
// @log null
// @log s
// @log 8
// @log 41
// @log 6
// A receiver held at the row its record was built as, wider than its own type, reads that row's
// field: a null member of a boxed nullable, a generic record list's fields, a nested record's list.
type J = { f: i32 | null }
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function mk<T>(x: T) { return [{ fs: [inc0], x: x }] }
function mkJ() { return { f: null } }
function nest() { return { a: [{ f: inc0 }, { f: dbl }] } }
const _held: J = mkJ()
const v = mkJ()
print(v.f)
const xs = [mkJ()]
print(xs[0].f)
print(mk("s")[0].x)
print(mk(7)[0].x + 1)
print(mk(2)[0].fs[0](40))
print(nest().a[1].f(3))
