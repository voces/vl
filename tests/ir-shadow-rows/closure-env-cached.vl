// ir shadow: a nested function's cached environment is dropped at its declaration and built at its first read
// expect covered = 4
// expect matched = 4
function outer(n: i32, s: string): i32 {
  function inner(k: i32): i32 {
    print(s)
    return n + k
  }
  const g = inner
  const h = inner
  return g(3) + h(1)
}
function mk(n: i32): (k: i32) => i32 {
  function add(k: i32): i32 { return n + k }
  return add
}
print(outer(3, "x"))
print(mk(2)(5))
