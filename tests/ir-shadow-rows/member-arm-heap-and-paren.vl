// ir shadow: a nullable arm field read at its heap and a parenthesised receiver match
// expect covered >= 4
// expect matched >= 4
// expect no row containing member record
// `Q.o` is stored `nulstruct` at the arm `O`'s heap and read as `O | null`, or as `O` once recovered;
// `(w.inner).r` reads its receiver as the bare field read.
type Q = { o: O | null, k: i32 }
type O = { n: i32, next: O | null }
type P = { m: i32 }
type U = O | P
type W = { inner: { r: i32 } }
function get(q: Q) { return q.o }
function cnt(q: Q) {
  const x = q.o
  if x != null { return x.n }
  return q.k
}
function guarded(q: Q) {
  if q.o != null { return q.o.n }
  return 0
}
function paren(w: W) { return (w.inner).r }
const q: Q = { o: { n: 1, next: null }, k: 2 }
print(cnt(q))
print(get(q) == null)
print(guarded(q))
print(paren({ inner: { r: 4 } }))
const u: U = { m: 3 }
if u is P { print(u.m) }
