// ir shadow: an is at its storage runs the ordinary rung under the storage mark, a narrowed variant's box field tests its tag, and a literal set over a box's string payload tests each member; a head guard the instance decides true cuts its block though its test is written
// expect covered >= 4
// expect matched >= 4
// expect no row containing decided is guard ends block
// expect no row containing is storage rung
// expect no row containing is arm tag
function classify(v: "a" | "b" | 1): i32 {
  if v is "a" { return 1 }
  else if v is "b" { return 2 }
  else if v is 1 { return 3 }
}
type V1 = { a: i32, f: string | i64 }
type V2 = { b: i32 }
function readStr(u: V1 | V2) {
  if u is V1 {
    if u.f is string { print(u.f) }
  }
}
function withRecord(n: i32) {
  const x: ("pp" | "qq") | { a: i32 } = if n > 0 { "qq" } else { { a: 1 } }
  if x is ("pp" | "qq") { print(x) } else { print("O") }
}
type Circle = { r: i32 }
function assignNiche() {
  let c: Circle | null = null
  c = { r: 5 }
  if c is Circle { return c.r }
  return -1
}
print(classify("a"))
print(classify(1))
readStr({ a: 1, f: "hi" })
withRecord(1)
withRecord(0)
print(assignNiche())
