// ir shadow: a nullable record compare with an element side reads the element through its place
// expect matched >= 12
// expect start matched >= 1
// expect no row containing spans
// expect no row containing fail
// expect no row containing nullable record eq element place
// expect uncovered record compare element place = 1
// Every ablated ingredient is incidental: which side, either side bare, the index kind, the
// receiver kind, both sides elements. A side with effects is staged and read once; a `null`-typed
// side is `nulName` (the element's null test), one narrowed under `== null` is still `C | null`.
type C = { r: i32, s: i32 }
const gs: (C | null)[] = [{ r: 1, s: 2 }, null]
let i = 0
function base(xs: (C | null)[], y: C | null) { return xs[0] == y }
function yBare(xs: (C | null)[], y: C) { return xs[0] != y }
function elemBare(xs: C[], y: C | null) { return xs[0] == y }
function rightElem(xs: (C | null)[], y: C | null) { return y == xs[0] }
function varIdx(xs: (C | null)[], y: C | null, k: i32) { return xs[k] == y }
function globalRecv(y: C | null) { return gs[0] == y }
function bothElem(xs: (C | null)[], ys: (C | null)[]) { return xs[0] != ys[1] }
function moveTo(k: i32, v: C | null) {
  i = k
  return v
}
function rightMoves() { return gs[i] == moveTo(1, { r: 1, s: 2 }) }
function leftMoves() { return moveTo(1, null) == gs[i] }
function narrowedNull(xs: (C | null)[], n: C | null) {
  if n == null { return xs[0] == n }
  return false
}
function unitNull(xs: (C | null)[]) {
  const n = null
  return n != xs[0]
}
function literalRight(ys: (C | null)[]) {
  let j = 0
  return ys[j] == { r: 1, s: 2 }
}
const c12: C = { r: 1, s: 2 }
print(base([c12], c12))
print(base([null], c12))
print(yBare([c12], { r: 1, s: 3 }))
print(elemBare([c12], null))
print(rightElem([null], null))
print(varIdx([null, c12], c12, 1))
print(globalRecv(null))
print(bothElem([c12], [null, c12]))
i = 0
print(rightMoves())
i = 0
print(leftMoves())
print(i)
print(narrowedNull([null], null))
print(narrowedNull([c12], null))
print(literalRight([c12]))
print(gs[1] == gs[0])
print(unitNull([null]))
print(unitNull([c12]))
