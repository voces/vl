// ir shadow: a generic handed to a parameter of a closed function type takes its closure at that type's instance
// expect covered >= 6
// expect matched >= 6
// expect no row containing fnClo
function same<T>(k: T): T { return k }
function twice(f: (x: i32) => i32) { return f(f(1)) }
function ss(f: (x: string) => string) { return f("y") }
function one<F>(a: F) {
  print(a("x"))
  print(twice(a))
}
function both<F>(a: F) {
  print(ss(a))
  print(twice(a))
}
one(same)
both(same)
