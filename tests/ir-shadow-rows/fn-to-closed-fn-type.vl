// ir shadow: a generic handed through a hole identity to a closed function type takes its closure there
// expect covered >= 4
// expect matched >= 4
// expect no row containing fnClo
function k<T>(x: T): T { return x }
function fw(f) { return f }
const v = fw(k)
print(v(41))
const b = fw(k)
print(b("z"))
function annotated() {
  const w: (x: i32) => i32 = fw(k)
  print(w(3))
}
annotated()
