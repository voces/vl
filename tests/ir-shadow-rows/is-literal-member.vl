// ir shadow: x is "lit" on the litMember rung over a mixed union, built as the literal arms' one-member compare
// expect covered >= 2
// expect no row containing is rung
// expect no row containing fail
type S = { v: i32 }
function valueUnion(r: string | i32): string {
  if r is "err" { return "ERR" }
  return "other"
}
function structAndString(r: S | string): string {
  if r is "err" { return "ERR" }
  return "other"
}
print(valueUnion("err"))
print(valueUnion(3))
print(structAndString("err"))
print(structAndString({ v: 1 }))
