// ir shadow: a field read typed never, in an instance whose type parameter binds never, reads the i32 its slot stores
// expect covered >= 4
// expect matched >= 4
// expect no row containing rep novalue
type CN<X> = { v: X }
function show<T>(v: CN<T> | null) {
  if v == null {
    print("none")
    return
  }
  print(v.v)
}
type W<X> = { a: i32, w: X }
function second<T>(r: W<T> | null) {
  if r == null { return 0 }
  print(r.w)
  return r.a
}
show({ v: 7 })
show(null)
print(second({ a: 3, w: "s" }))
print(second(null))
