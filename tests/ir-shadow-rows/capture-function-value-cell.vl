// ir shadow: a capturing nested function read as a value through its function-value cell
// expect covered >= 14
// expect matched >= 14
// expect no row containing closure env cell
// The value of a celled function is legacy's cell fill (`emitClosureValueCore`), and an
// environment carrying the cell reads it where the frame reaches it (`emitCloCellRef`).
function outer(n: i32) {
  function inner(x: i32) { return x + n }
  function sib() { return inner }
  function self() { return inner === inner }
  const a = inner
  const c = () => inner
  print(a === c())
  print(a === sib())
  const mk = () => () => inner
  print(mk()() === a)
  print(self())
  print(c()(4))
}
outer(3)
function made<T>(t: T, n: i32): (x: i32) => i32 {
  function inner(x: i32) { print(t); return x + n }
  const c = () => inner
  return c()
}
print(made(1, 2)(3))
print(made("s", 2) === made("s", 2))
