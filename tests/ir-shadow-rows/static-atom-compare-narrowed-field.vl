// ir shadow: a static atom compare reads a narrowed one-literal field raw at its stored atom
// expect covered >= 2
// expect matched >= 2
// expect no row containing narrowed field read coercion
type LK = "str" | "int"
type TL = { litKind: LK, litText: string, litWide: boolean }
type TA = { el: i32 }
type Ty = TL | TA
const tys: Ty[] = [{ litKind: "int", litText: "3", litWide: false }, { el: 1 }]
function tyAt(i: i32): Ty { return tys[i] }
function f(m: i32): i32 {
  const t = tyAt(m)
  if t is TL {
    if t.litKind != "str" && t.litKind != "int" { return -1 }
    return 1
  }
  return 0
}
print(f(0))
