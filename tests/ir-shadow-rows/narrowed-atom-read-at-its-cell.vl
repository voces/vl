// ir shadow: an atom local narrowed to one literal reads at its atom cell where legacy writes it raw
// expect covered >= 3
// expect matched >= 3
// expect no row containing fail
type K = "red" | "green"
const src: K[] = ["green", "red"]
function rank(s: "first" | "second"): i32 {
  if s == "first" { return 1 } else if s == "second" { return 2 }
}
function bound(a) {
  const b = if a == "green" { a } else { "red" }
  print(b)
}
function given(a) { return if a == "green" { a } else { "red" } }
print(rank("second"))
bound(src[0])
print(given(src[1]))
