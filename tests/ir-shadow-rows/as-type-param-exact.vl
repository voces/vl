// ir shadow: a type-parameter operand's exact as! and failing as? at its pin build as the exact cast
// expect covered >= 3
// expect matched >= 3
// expect uncovered expression as = 1
// `opt` at f64 and i64 pins can fail (`holeOptExactSrc`), as can `bang` at f64; `opt` at an i32
// pin cannot, and boxes its plain cast, which stays legacy's.
function opt<T>(u: T) {
  const v = u as? i32
  if v == null { return -1 }
  return v
}
function bang<T>(u: T) { return u as! i32 }
const f = 3.0
const w: i64 = 12
print(opt(f))
print(opt(w))
print(opt(5))
print(bang(f))
