// ir shadow: an element read at a narrower union's box, and one the box plan passes
// expect covered >= 3
// expect matched >= 3
// expect no row containing index element coercion
type OV = { ov: i32 }
type OS = { os: string }
type OI = { oi: i32, oj: i32 }
type Op = OV | OS | OI
type RW = { rwArgs: Op[], rwOp: string }
function use(o: Op): i32 { if o is OV { return o.ov } return 0 }
function f(r: RW): i32 {
  if r.rwArgs.length != 1 || r.rwArgs[0] is OS { return -1 }
  return use(r.rwArgs[0])
}
function g(r: RW): i32 {
  const a = r.rwArgs
  const n = a.length
  const ok = n == 2 && use(a[0]) == 1 && use(a[1]) == 2
  return if ok { 1 } else { 0 }
}
print(f({ rwArgs: [{ ov: 1 }], rwOp: "x" }))
print(g({ rwArgs: [{ ov: 1 }, { ov: 2 }], rwOp: "x" }))
