// ir shadow: a pushing arm's grown length read outside the arm at every delivery position: call argument at a scalar and a union parameter, nested call argument, concat operand, return, let initializer, if arm value, ?? operand and record field
// expect no row containing is empty fit shadow grow
function len(n: i32): i32 { return n }
function lenOr(x: i32 | string): i32 { return if x is string { 0 } else { x } }
function twice(n: i32): i32 { return n * 2 }
function posOr(n: i32): i32 | null { return if n > 0 { n } else { null } }
function pArg<T, U>(a: T[]) {
  const q: U[] = []
  if q is f64[] { q.push(1.5) }
  print(len(q.length))
}
function pUnion<T, U>(a: T[]) {
  const q: U[] = []
  if q is f64[] { q.push(1.5) }
  print(lenOr(q.length))
}
function pNested<T, U>(a: T[]) {
  const q: U[] = []
  if q is f64[] { q.push(1.5) }
  print(twice(len(q.length)))
}
function pConcat<T, U>(a: T[]) {
  const q: U[] = []
  if q is f64[] { q.push(1.5) }
  print("n=" + (if q.length > 0 { "some" } else { "none" }))
}
function pReturn<T, U>(a: T[]): i32 {
  const q: U[] = []
  if q is f64[] { q.push(1.5) }
  return q.length
}
function pLet<T, U>(a: T[]) {
  const q: U[] = []
  if q is f64[] { q.push(1.5) }
  const n = q.length
  print(n)
}
function pIfArm<T, U>(a: T[], b: boolean) {
  const q: U[] = []
  if q is f64[] { q.push(1.5) }
  print(if b { q.length } else { 0 })
}
function pCoalesce<T, U>(a: T[]) {
  const q: U[] = []
  if q is f64[] { q.push(1.5) }
  print(posOr(q.length) ?? 0)
}
function pRecord<T, U>(a: T[]) {
  const q: U[] = []
  if q is f64[] { q.push(1.5) }
  const r = { n: q.length }
  print(r.n)
}
pArg([1])
pUnion([1])
pNested([1])
pConcat([1])
print(pReturn([1]))
pLet([1])
pIfArm([1], true)
pCoalesce([1])
pRecord([1])
