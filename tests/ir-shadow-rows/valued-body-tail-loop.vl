// ir shadow: a valued body ending in a loop falls into legacy's pad and matches
// expect covered >= 3
// expect matched >= 3
function find(xs: i32[], k: i32): i32 {
  let i = 0
  while true {
    if xs[i] == k { return i }
    i = i + 1
  }
}
function scan(n: i32) {
  let i = 0
  while i < n {
    if i * i > n { return i }
    i = i + 1
  }
}
function lp(x: i32): boolean | null {
  let c = x
  while c > 0 {
    if c == 3 { return true }
    c = c - 1
  }
}
print(find([4, 5, 6], 6))
print(scan(10))
print(lp(5))
