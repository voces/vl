// ir shadow: p?.f ?? d and a boxed binding's ?? at module scope over a global re-read the global as it was read
// expect start matched >= 1
// expect no row containing coalesce optional place
// expect no row containing coalesce box place
// expect no row containing fail
type T = { v: i32, left: T | null }
const kept: T = { v: 1, left: { v: 2, left: null } }
print(kept.left?.v ?? 0)
const m: i32 | null = 4
print((m ?? (1 << 40)) + 1)
