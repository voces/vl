// ir shadow: an arm-site read through a narrowed name is that name's box, and an index that calls and writes nothing is built once ahead of the tag chain; an index that calls is a named miss
// expect covered >= 4
// expect no row containing arm site stashed receiver
function mkS(k: i32): i32[] | f64[] {
  if k == 0 { return [1.5, 2.5, 3.5] }
  const a = [4, 7, 9]
  return a
}
function mkT(k: i32): i32[] | f64[] | string {
  if k == 0 { return "s" }
  return [4, 5]
}
function last(a) { print(a[a.length - 1]) }
last(mkS(1))
last(mkS(0))
function nextOf(a, i: i32) { print(a[i + 1]) }
nextOf(mkS(1), 0)
nextOf(mkS(0), 1)
const len = (a) => if a is string { 0 } else { a.length }
print(len(mkT(1)))
print(len(mkT(0)))
let calls = 0
function next(): i32 {
  calls = calls + 1
  print("next")
  return 1
}
function viaCall(a) { print(a[next()]) }
viaCall(mkS(1))
viaCall(mkS(0))
print(calls)
