// ir shadow: a range loop legacy writes rolled builds as block, loop, test, body and step
// expect covered >= 4
// expect matched >= 4
// expect no row containing uncovered statement
// expect no row containing mismatch
function sum(n: i32): i32 {
  let s = 0
  for i in 0 until n {
    s = s + i * 2
    print(i)
  }
  return s
}
function down(): i32 {
  let s = 0
  for i in 10 to 1 step -3 {
    s = s + i
    print(s)
  }
  return s
}
function skipOdd(n: i32): i32 {
  let s = 0
  for i in 0 until n {
    if i % 2 == 1 { continue }
    if i > 6 { break }
    s = s + i
    print(i)
  }
  return s
}
function upTo(n: i32): i32 {
  let s = 0
  for i in 1 to 100 {
    s = s + i
    print(s)
    if s > n { break }
  }
  return s
}
print(sum(5))
print(down())
print(skipOdd(20))
print(upTo(30))
