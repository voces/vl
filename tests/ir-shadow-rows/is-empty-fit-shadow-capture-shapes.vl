// ir shadow: the risky closure shapes over a shadow arm's name build and match: a closure made before the is and called after it, one made inside the arm and called after it, and two closures capturing the same name
// expect covered >= 6
// expect matched >= 6
// expect no row containing is empty fit shadow
function before<T, U>(a: T[]) {
  const q: U[] = []
  const k = () => q.length + 10
  if q is f64[] { print(q.length) }
  print(k())
  print(a.length)
}
function inArm<T, U>(a: T[]) {
  const q: U[] = []
  let f = () => 0
  if q is f64[] { f = () => q.length + 20 }
  print(f())
  print(a.length)
}
function twoClosures<T, U>(a: T[]) {
  const q: U[] = []
  if q is f64[] {
    const k1 = () => q.length + 10
    const k2 = () => q.length + 20
    print(k1() + k2())
  }
  print(a.length)
}
before([1])
inArm([1])
twoClosures([1])
