// ir shadow: an operator's left variable or literal is staged below a valued right if and matches
// expect covered = 5
// expect matched = 5
// expect no row containing short-circuit right operand
function a(x: i32, k: boolean): i32 { return x + (if k { 1 } else { 2 }) }
function c(x: i32, k: boolean): boolean {
  return x < (if k { 1 } else { x * 2 })
}
function m(x: i32, k: boolean): i64 {
  const y: i64 = 7; return y - (if k { 1 } else { 2 })
}
function lit(k: boolean): i32 { return 5 + (if k { 1 } else { 2 }) }
function f(x: f64, k: boolean): f64 { return x / (if k { 2.0 } else { 4.0 }) }
print(a(1, true))
print(c(3, false))
print(m(1, true))
print(lit(false))
print(f(8.0, true))
