// ir shadow: a shared field read off a module global union pushes the global's box once per arm
// expect start covered >= 1
// expect start matched >= 1
// expect no row containing fail
type A = { tag: i32, a: i32 }
type B = { tag: i32, b: i32 }
function pick(c: boolean) {
  if c { return { tag: 0, a: 1 } }
  return { tag: 1, b: 2 }
}
const r = pick(true)
print(r.tag)
const r2 = pick(false)
print(r2.tag)
