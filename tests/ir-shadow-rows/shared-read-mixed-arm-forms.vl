// ir shadow: a shared field read whose arms store the field at different reps is covered
// expect covered >= 3
// expect matched >= 3
// expect no row containing member box
// `F` reads `u.k` stored at `i32 | null` in `A` and at `string | null` in `B`; `G` reads a
// lone literal stored at its string beside an atom set; `H` boxes a nullable list arm.
type A = { k: i32 | null, x: i32 }
type B = { k: string | null, y: string }
function F(u: A | B) { print(u.k) }
F({ k: 3, x: 1 })
F({ k: "z", y: "s" })
type K = "a" | "b"
type C = { v: K | null }
type D = { v: i32 | null }
function G(u: C | D) { print(u.v) }
G({ v: "b" })
G({ v: 2 })
type L = { w: i32[] | null }
type M = { w: string[] | null }
function H(u: L | M) { print(u.w == null) }
H({ w: null })
H({ w: [1] })
