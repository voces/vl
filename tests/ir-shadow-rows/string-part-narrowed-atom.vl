// ir shadow: a literal-union read narrowed to one member is a string part decoded off its atom cell
// expect covered >= 2
// expect matched >= 2
// expect no row containing string atom part route
type A = "union" | "str" | "nulStr" | "none"
function armOf(n: i32): A {
  if n == 0 { return "union" }
  if n == 1 { return "str" }
  return "none"
}
function route(n: i32): string {
  const a = armOf(n)
  if a == "union" { return "u" }
  else if a == "str" || a == "nulStr" { return "s" }
  else { return "literal member " + a }
}
print(route(0))
print(route(2))
