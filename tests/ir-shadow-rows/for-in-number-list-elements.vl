// ir shadow: a walk over f64 lists, i64 lists or nullable byte lists binds each inner list as it is stored
// expect covered >= 3
// expect matched >= 3
// expect no row containing for in element
// expect no row containing mismatch
function walkF(xs: f64[][]) {
  for row in xs { print(row.length) }
}
function walkI(xs: i64[][]) {
  for row in xs { print(row.length) }
}
function walkU(xs: (u8[] | null)[]) {
  for b in xs {
    if b != null { print(b.length) } else { print(-1) }
  }
}
walkF([[1.5], []])
walkI([[1 as i64]])
walkU([null, [1 as u8]])
