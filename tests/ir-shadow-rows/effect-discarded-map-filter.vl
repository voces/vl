// ir shadow: a .map or .filter whose list is discarded, in a function body, an if arm, a loop body and the start, and a capturing one
// expect matched >= 4
// expect start matched >= 1
// expect no row containing effect outside I1
function a(xs: i32[]): i32 {
  xs.filter((e) => e > 1)
  return xs.length
}
function b(xs: i32[], k: i32): i32 {
  xs.map((e) => e + k)
  return k
}
function c(xs: i32[], f: boolean): i32 {
  if f { xs.map((e) => e * 2) }
  return 3
}
function d(xs: string[]): i32 {
  let n = 0
  for i in 0 until 2 {
    xs.map((s) => s + "!")
    n += 1
  }
  return n
}
const ys = [1, 2, 3]
ys.map((e) => e + 1)
print(a(ys))
print(b(ys, 4))
print(c(ys, true))
print(d(["p", "q"]))
