// ir shadow: a nullable or union binding's arm that calls a never function builds as that call's statement
// expect covered >= 3
// expect matched >= 3
// expect no row containing rep novalue
type A = { a: i32 }
type B = { b: string }
function fail(m: string): never { __trap__(m) }
function opt(c: boolean, n: i32) {
  const v: i32 | null = if c { n } else { fail("no value") }
  return v ?? 0
}
function pick(c: boolean, x: A) {
  const u: A | B = if c { x } else { fail("no arm") }
  if u is A { return u.a }
  return 0
}
print(opt(true, 4))
print(pick(true, { a: 5 }))
