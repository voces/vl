// ir shadow: a boolean argument of a closure call goes in as the i32 its parameter takes, and matches
// expect covered >= 4
// expect matched >= 4
// expect no row containing call of a non-declaration
// expect no row containing mismatch
function apply(f: (b: boolean) => i32, b: boolean): i32 { return f(b) }
function go() {
  const g = (b: boolean) => if b { 1 } else { 0 }
  const t = true
  print(g(t))
  print(g(false))
}
go()
print(apply((b) => if b { 7 } else { 8 }, false))
