// ir shadow: s is Circle over arms sharing one row, the tag then the discriminant field's literal, the box re-read per literal
// expect covered >= 1
// expect no row containing variant shape
// expect no row containing variant row
// expect no row containing fail
type Shape = { kind: "circle", size: i32 } | { kind: "square", size: i32 }
type Circle = { kind: "circle", size: i32 }
function isCircle(s: Shape) {
  if s is Circle { return "circle" }
  return "other"
}
print(isCircle({ kind: "circle", size: 2 }))
print(isCircle({ kind: "square", size: 3 }))
