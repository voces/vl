// ir shadow: a closure stored at a record field whose twin row's kid names another signature is the closure as it stands, and matches
// expect covered >= 3
// expect matched >= 3
// expect no row containing object field coercion
// expect no row containing mismatch
type T0 = {
  f: {f: (i32, i32, i32) => string},
  z: {f: (i32, i32, i32) => boolean},
}
function useTwin(p: T0) {
  print(p.f.f(1, 1, 1))
  print(p.z.f(1, 1, 1))
}
function go() {
  const w: T0 = {
    f: { f: (_q0, _q1, _q2) => ("66") },
    z: { f: (_q3, _q4, _q5) => (false) },
  }
  useTwin(w)
}
go()
