// ir shadow: a union global read at the one atom the checker narrowed it to unboxes it
// expect start covered >= 1
// expect start matched >= 1
// expect no row containing global read coercion
let x = null
x = 5
print(x + 1)
let y: i32 | null = null
y = 7
print(y * 2)
let z: f64 | null = null
z = 1.5
print(z + 1.0)
