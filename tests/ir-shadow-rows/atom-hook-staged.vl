// ir shadow: a literal-union value that is no place reaches an atom destination parked once, by legacy's staged tower
// expect covered >= 6
// expect matched >= 6
// expect no row containing pre-path atom hook
function y(): "y" { return "y" }
function pick(c: boolean): "a" | "b" { return if c { "a" } else { "b" } }
function one() {
  const m: "x" | "y" = y()
  print(m)
}
function two(c: boolean) {
  const m: "a" | "b" | "c" = pick(c)
  print(m)
}
function arg(c: boolean) { take(pick(c)) }
function take(m: "a" | "b" | "c") { print(m) }
one()
two(true)
two(false)
arg(false)
