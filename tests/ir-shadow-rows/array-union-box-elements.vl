// ir shadow: a value-union local a closure writes lives in a one-element cell of a union-box list another literal mints, boxed per element
// expect covered >= 2
// expect no row containing array ref
// expect no row containing fail
function forIn() {
  let out = ""
  const ys: (boolean | string)[] = [true]
  for v in ys {
    const k = () => {
      return v = false
    }
    k()
    if v is boolean { out = out + (if v { "t" } else { "f" }) }
  }
  return out
}
function boolFromString() {
  let v: boolean | string = "a"
  const k = () => {
    return v = false
  }
  k()
  return if v is boolean { if v { "t" } else { "f" } } else { "?" }
}
print(forIn())
print(boolFromString())
