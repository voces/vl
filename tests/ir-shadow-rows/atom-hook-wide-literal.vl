// ir shadow: a read of a const bound to a literal into an atom destination is read, dropped and its literal's id
// expect covered >= 4
// expect matched >= 4
// expect no row containing pre-path atom hook
const A = "a"
const B = "b"
function take(m: "a" | "b" | "c") { print(m) }
function bound() {
  const m: "a" | "b" | "c" = A
  print(m)
}
function arg() { take(B) }
function ret(): "a" | "b" { return A }
bound()
arg()
print(ret())
