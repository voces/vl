// ir shadow: a union-valued map read passed to a union parameter is the box ladder's own read, banking no element-read row
// expect covered >= 2
function show(v: f64 | i32) { print(v) }
function viaNullTest() {
  const m: {[string]: f64 | i32} = Map()
  m["k"] = 1.5
  if m["k"] != null { show(m["k"]) }
}
function viaAlias() {
  const m: {[string]: f64 | i32} = Map()
  m["k"] = 1.5
  const m2 = m
  if m["k"] is f64 {
    m2["k"] = 5
    show(m["k"])
  }
}
viaNullTest()
viaAlias()
