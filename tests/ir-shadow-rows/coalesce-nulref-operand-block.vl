// ir shadow: a nullable reference's ?? whose operand is a temp (a list element, a call) builds the operand inside the plain block it opens
// expect covered >= 2
type R = { x: i32 }
function d(o: (R | null)[], i: i32): i32 { return (o[i] ?? { x: 9 }).x }
function mk(b: boolean): R | null { return if b { { x: 1 } } else { null } }
function h(b: boolean): i32 { return (mk(b) ?? { x: 5 }).x }
print(d([null], 0))
print(d([{ x: 3 }], 0))
print(h(false))
print(h(true))
