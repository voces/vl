// ir shadow: a direct call of a nested function that captures through its environment builds and matches
// expect covered >= 2
// expect matched >= 2
// expect no row containing uncovered
function outer(n: i32, s: string): i32 {
  function inner(k: i32): i32 {
    print(s)
    return n + k
  }
  const g = inner
  inner(1)
  return inner(2) + g(3)
}
print(outer(3, "x"))
