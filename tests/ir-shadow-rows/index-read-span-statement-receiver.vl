// ir shadow: an element read whose receiver is a statement keeps legacy's span from that statement
// expect covered >= 3
// expect matched >= 3
// expect no row containing spans
type A = { v: i32 }
function coal(p: A[] | null) { print((p ?? [{ v: 9 }])[0].v) }
function strs(p: string[] | null) { print((p ?? ["d"])[0]) }
function pick(c: boolean, a: i32[], b: i32[]) { print((if c { a } else { b })[1]) }
coal(null)
strs(["s"])
pick(true, [1, 2], [3, 4])
