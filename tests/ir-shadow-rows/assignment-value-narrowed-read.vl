// ir shadow: an assignment re-read through its target's narrowing stays a named miss
// expect uncovered assignment value narrowed read = 1
// expect no row containing fail
function nn(v: i32): i32 | null { return if v > 0 { v } else { null } }
function str() {
  let s: string | null = null
  nn(-1) ?? (s = "w").length
  print(s ?? "none")
}
str()
