// ir shadow: a captured atom or K | null is held as its i32, as legacy's capture is
// expect covered >= 2
// expect matched >= 2
// expect uncovered capture binding = 1
// The closures in `pick` and `orNone` read their captures at the i32 rep the env holds; `flag`'s
// reads its `boolean | null` narrowed to `boolean`, a rep the capture does not hold.
type K = "a" | "b"
function pick(k: K) {
  const f = () => k
  return f()
}
function orNone(k: K | null) {
  const f = () => k ?? "none"
  return f()
}
function flag(v: boolean | null) {
  const f = () => if v == null { "unset" } else if v { "yes" } else { "no" }
  return f()
}
print(pick("b"))
print(orNone(null))
print(flag(true))
