// ir shadow: a captured atom or K | null is held as its i32, as legacy's capture is
// expect covered >= 6
// expect matched >= 6
// expect no row containing capture binding
// The closures in `pick` and `orNone` read their captures at the i32 rep the env holds; `flag`'s
// reads its `boolean | null` narrowed to `boolean`: the capture at its own rep, then the recover.
type K = "a" | "b"
function pick(k: K) {
  const f = () => k
  return f()
}
function orNone(k: K | null) {
  const f = () => k ?? "none"
  return f()
}
function flag(v: boolean | null) {
  const f = () => if v == null { "unset" } else if v { "yes" } else { "no" }
  return f()
}
print(pick("b"))
print(orNone(null))
print(flag(true))
