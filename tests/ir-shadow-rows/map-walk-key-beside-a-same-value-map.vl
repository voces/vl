// ir shadow: a walk of an i64-keyed map's keys, after a string-keyed map with the same value type is interned
// expect covered >= 2
// expect matched >= 2
// expect no row containing for in map element
// expect no row containing mismatch
function mk(): {[string]: i32 | string} {
  const m: {[string]: i32 | string} = Map()
  m["a"] = 1
  return m
}
function keys(m: {[i64]: i32 | string}) {
  let t: i64 = 0
  for k in m.keys() { t = t + k }
  print(t)
}
const g: {[i64]: i32 | string} = Map()
g[5 as i64] = "x"
g[7 as i64] = 9
print(mk().has("a"))
keys(g)
