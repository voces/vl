// ir shadow: atomics and the scalar saturating truncations build through RAtomic and RTruncSat
// expect covered >= 12
// expect matched >= 12
// expect no row containing intrinsic none
// expect no row containing atomic
// expect no row containing trunc_sat
function ld(at: i32) { return __atomic_load_i32__(at) }
function ld64(at: i32) { return __atomic_load_i64__(at) }
function st(at: i32, v: i32) { __atomic_store_i32__(at, v) }
function st16(at: i32, v: i64) { __atomic_store16_i64__(at, v) }
function add(at: i32, v: i32) { return __atomic_rmw_add_i32__(at, v) }
function cas(at: i32, e: i64, r: i64) { return __atomic_rmw_cmpxchg_i64__(at, e, r) }
function at8(v: i32) { return __atomic_load8_u_i32__(64 + 4, 4) + v }
function fence() { __atomic_fence__() }
function discarded(at: i32) { __atomic_rmw_add_i32__(at, 1) }
function sat(x: f64) { return __trunc_sat_f64_s_i32__(x) }
function satU(x: f32) { return __trunc_sat_f32_u_i64__(x) }
function satDrop(x: f64) { __trunc_sat_f64_u_i32__(x) }
st(64, 7)
print(ld(64))
print(add(64, 1))
discarded(64)
print(ld(64))
st16(72, 5 as i64)
print(ld64(72))
print(cas(72, 5 as i64, 9 as i64))
print(at8(1))
fence()
print(sat(-3.7))
print(satU(1e30 as f32))
satDrop(2.5)
