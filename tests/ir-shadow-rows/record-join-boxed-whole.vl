// ir shadow: a valued if of one variant boxed into its union writes the join into a once-slot, then the tag (late box)
// expect covered >= 3
// expect verified >= 3
// expect no row containing box ladder
// expect no row containing box of a valued if
// expect no row containing fail
type OVar = { ov: i32 }
type OImm = { oiRep: i32, oiBits: i64 }
type Opnd = OVar | OImm
function num(o: Opnd): i32 {
  if o is OVar { return o.ov }
  return 100 + o.oiRep
}
function show(op: string, i: i32, o: Opnd): i32 {
  const k = if op == "gt" { 1000 } else { 2000 }
  return k + i * 10 + num(o)
}
function local(n: i32): OVar { return { ov: n } }
function test(w: i32, i: i32): i32 {
  const lim = local(1)
  const n = local(2)
  return show(if w == 4 { "gt" } else { "ge" }, i, if w == 4 { lim } else { n })
}
print(test(4, 7))
