// ir shadow: a module global of the `null` type initialized by a `null` literal, a call run once, and an assignment yielding `null`, read in argument, nested, return, binding, `??`, record field and null-test positions
// expect matched >= 7
// expect start matched >= 1
// expect no row containing global initializer nulnone
type In = { v: i32 }
let hits = 0
function nothing() {
  hits = hits + 1
  return null
}
let gs: string | null = "z"
const fromLit = null
const fromCall = nothing()
const fromAsg = (gs = null)
function sN(x: In | null) { return if x == null { -1 } else { x.v } }
function idN(x: In | null) { return x }
function retCall(): In | null { return fromCall }
function bind() {
  const a: In | null = fromAsg
  return sN(a)
}
function coal() {
  const d: In = { v: 5 }
  return (fromLit ?? d).v
}
function rec() {
  const r: { a: In | null } = { a: fromCall }
  return sN(r.a)
}
print(sN(fromLit))
print(sN(idN(fromCall)))
print(sN(retCall()))
