// ir shadow: a struct literal argument legacy builds at its parameter's row is built at the parameter's rep
// expect start matched >= 1
// expect no row containing argument coercion
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function take(r) { return r.f(3) }
function take2(n, r) { return r.f(n) }
const p = { f: inc0 }
print(take(p))
print(take2(3, { f: inc0 }))
print(take2(2.5, { f: half }))
