// ir shadow: memory-management intrinsics build through RMemOp and match
// expect covered >= 7
// expect matched >= 7
// expect no row containing memory op
function pages(): i32 { return __memory_size__() }
function grow(n: i32): i32 { return __memory_grow__(n) }
function fill(at: i32, v: i32, n: i32) { __memory_fill__(at, v, n) }
function copy(d: i32, s: i32, n: i32) { __memory_copy__(d, s, n) }
function base(): i32 { return __heap_base__() }
function room(): i32 { return __heap_limit__() - __heap_base__() }
function drops(n: i32) { __memory_grow__(n) }
fill(1024, 7, 16)
copy(2048, 1024, 16)
print(__load_u8__(2050))
print(pages() > 0)
print(grow(0) == pages())
print(room() >= 0)
print(base() > 0)
drops(0)
