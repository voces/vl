// ir shadow: a closure in a shadow-arm region reads the arm's list, delivered at every position: call argument at a scalar and a union parameter, nested call argument, concat operand, return, let initializer, if arm value, ?? operand and record field
// expect no row containing is empty fit shadow
function len(n: i32): i32 { return n }
function lenOr(x: i32 | string): i32 { return if x is string { 0 } else { x } }
function twice(n: i32): i32 { return n * 2 }
function posOr(n: i32): i32 | null { return if n >= 0 { n } else { null } }
function pArg<T, U>(a: T[]) {
  const q: U[] = []
  if q is f64[] {
    const k = () => q.length + 10
    print(len(k()))
  }
  print(a.length)
}
function pUnion<T, U>(a: T[]) {
  const q: U[] = []
  if q is f64[] {
    const k = () => q.length + 10
    print(lenOr(k()))
  }
  print(a.length)
}
function pNested<T, U>(a: T[]) {
  const q: U[] = []
  if q is f64[] {
    const k = () => q.length + 10
    print(twice(len(k())))
  }
  print(a.length)
}
function pConcat<T, U>(a: T[]) {
  const q: U[] = []
  if q is f64[] {
    const k = () => q.length
    print("n=" + (if k() == 0 { "empty" } else { "some" }))
  }
  print(a.length)
}
function pReturn<T, U>(a: T[]): i32 {
  const q: U[] = []
  if q is f64[] {
    const k = () => q.length + 10
    return k()
  }
  return a.length
}
function pLet<T, U>(a: T[]) {
  const q: U[] = []
  if q is f64[] {
    const k = () => q.length + 10
    const n = k()
    print(n)
  }
  print(a.length)
}
function pIfArm<T, U>(a: T[], b: boolean) {
  const q: U[] = []
  if q is f64[] {
    const k = () => q.length + 10
    print(if b { k() } else { 0 })
  }
  print(a.length)
}
function pCoalesce<T, U>(a: T[]) {
  const q: U[] = []
  if q is f64[] {
    const k = () => q.length
    print(posOr(k()) ?? -1)
  }
  print(a.length)
}
function pRecord<T, U>(a: T[]) {
  const q: U[] = []
  if q is f64[] {
    const k = () => q.length + 10
    const r = { n: k() }
    print(r.n)
  }
  print(a.length)
}
pArg([1])
pUnion([1])
pNested([1])
pConcat([1])
print(pReturn([1]))
pLet([1])
pIfArm([1], true)
pCoalesce([1])
pRecord([1])
