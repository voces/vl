// ir shadow: a global holding a tagged set's id, listed where its member's closure is delivered,
// reads the id as the cell holds it and is replaced by that closure, as legacy writes it
// expect start covered >= 1
// expect start matched >= 1
// expect node-in array: matched >= 1
// expect no row containing mismatch
// expect no row containing fail
// expect no row containing global read coercion
function id<T>(x: T): T { return x }
function inc(x: i32) { return x + 1 }
function mk() { return id }
const v = mk()
const ys = [v]
ys[0] = inc
print(v(7))
print(ys[0](1))
