// ir shadow: byte, list-of-list and boxed-element walks are covered and match
// expect covered = 7
// expect matched = 7
function sum(bs: u8[]): i32 {
  let s = 0
  for b in bs { s = s + b }
  return s
}
function hex(bs: u8[]): string {
  let out = ""
  for b in bs {
    out = out + "x"
    if b > 100 { out = out + "!" }
  }
  return out
}
function flat(rows: u8[][]): i32 {
  let n = 0
  for r in rows { n = n + r.length }
  return n
}
function has(xs: string[][], k: string): boolean {
  for row in xs {
    for x in row { if x == k { return true } }
  }
  return false
}
function count(xs: string[][]): i32 {
  let n = 0
  for row in xs { n = n + row.length }
  return n
}
type A = { a: i32 }
type B = { b: i32 }
type U = A | B
function allA(us: U[]): boolean {
  for u in us {
    if !(u is A) { return false }
  }
  return true
}
function sumA(us: U[]): i32 {
  let s = 0
  for u in us {
    if u is A { s = s + u.a }
  }
  return s
}
const bs: u8[] = [1, 2, 250]
print(sum(bs))
print(hex(bs))
print(flat([bs, bs]))
print(has([["a"], ["b", "c"]], "c"))
print(count([["a"], ["b", "c"]]))
const us: U[] = [{ a: 1 }, { b: 2 }, { a: 3 }]
print(allA(us))
print(sumA(us))
