// ir shadow: a list element before a valued if is staged below it
// expect covered >= 4
// expect matched >= 4
// expect no row containing operand above a valued if
// An element written before a valued `if` (scalar, string or union) is staged below the `if` as a
// call's argument is, so the list literal builds in legacy's order.
function cnt(xs: i32[]) { return xs.length }
function f(n: i32, c: boolean) {
  return cnt([n, if c { 1 } else { 2 }, n])
}
function g(s: string, c: boolean) {
  const xs = [s, if c { "a" } else { "b" }]
  return xs.length
}
print(f(1, true))
print(g("x", false))
type A = { a: i32 }
type B = { b: i32 }
type U = A | B
function cntU(xs: U[]) { return xs.length }
function pair(x: A): U { return { b: x.a } }
function f2(idx: U, tag: U | null, slot: A, e: U) {
  return cntU([idx, if tag == null { slot } else { pair(slot) }, e])
}
print(f2({ a: 9 }, null, { a: 2 }, { b: 1 }))
