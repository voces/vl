// ir shadow: map walks the i32-or-string rule admits stay built beside the stored-rep rule: a set's values, a nested map's keys with its value, an i32-keyed map's keys
// expect covered >= 3
// expect matched >= 3
// expect no row containing for in map element
// expect no row containing mismatch
function setWalk() {
  const s: Set<string> = Set()
  s.add("a")
  s.add("b")
  for v in s.values() { print(v) }
}
function nestedWalk() {
  const outer: {[string]: {[string]: i32}} = Map()
  const inner: {[string]: i32} = Map()
  inner["x"] = 1
  outer["o"] = inner
  for k, v in outer { print(k + "\{v.length}") }
}
function keyWalk() {
  const b: {[i32]: string} = Map()
  b[3] = "c"
  b[4] = "d"
  let n = 0
  for k in b { n = n + k }
  print(n)
}
setWalk()
nestedWalk()
keyWalk()
