// ir shadow: an earlier operand read at its use is staged below a store a later operand makes (a local, a global, a field, an element), as legacy writes it first
// expect matched >= 6
// expect no row containing fail
// expect no row containing mismatch
// expect no row containing after an operand
function two(a: i32, c: i32) { print(a * 10 + c) }
function k(): i32 { return 4 }
let g = 1
function loc() {
  let b = 1
  two(b, b = 2)
  two(b + 1, b = 5)
  two(k(), b = 7)
}
function glob() {
  two(g, g = 3)
  print([g, g = 6].length)
}
function fld() {
  const r = { x: 1 }
  two(r.x, r.x = 5)
  const o = { p: r.x, q: r.x = 8 }
  two(o.p, o.q)
}
function elem() {
  const xs = [1, 2]
  two(xs[0], xs[0] = 9)
  two(xs[1], (xs[1] = 3) + 1)
}
loc()
glob()
fld()
elem()
