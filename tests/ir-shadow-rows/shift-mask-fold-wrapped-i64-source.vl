// ir shadow: a shift-mask fold whose source is an i64 shift wrapped to i32 is built, wrap and all
// expect covered >= 4
// expect matched >= 4
// expect no row containing shift-mask fold
// `hi` and `lo` take the narrowing form, `(y >>> k) as% i32 & m`; `hiAt` and `hiMul` the same
// under an outer shift. Each reads `y` at i64 and wraps it as legacy's `srPushSource` does.
function hi(y: i64) { return (y >>> 40) as% i32 & 255 }
function hiAt(y: i64) { return ((y >>> 40) as% i32 & 255) << 4 }
function hiMul(y: i64) { return ((y >>> 8) as% i32 & 15) * 16 }
function lo(y: i64) { return (y >>> 0) as% i32 & 1 }
const v = 0x12345678_9abcdef0 as i64
print(hi(v))
print(hiAt(v))
print(hiMul(v))
print(lo(v))
