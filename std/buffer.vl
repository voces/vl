// `std:buffer` — allocating and reading raw bytes in linear memory.
//
//     import { Buffer, bufferMark, bufferRelease, loadI32, storeI32 } from "std:buffer"
//
// A `Buf` is an ordinary value describing an extent of linear memory, and a host
// reads those bytes directly through the module's exported `memory`. NOTHING here
// bounds-checks except the typed views: a read past the end of a `Buf` but still
// inside the memory is not caught. Reclamation is LIFO — `bufferRelease(mark)`
// invalidates every `Buf` allocated after `mark`.

// A linear-memory extent: the byte address of its first byte, and the number of
// bytes the caller asked for. `.length` is a plain field read.
export type Buf = { base: i32, length: i32 }

// A wasm page is 64 KiB, and the memory intrinsics count pages.
const PAGE_SHIFT = 16
const PAGE_MASK = 65535

// Byte addresses below this are never handed out, so `base == 0` is never a
// real `Buf` and a program poking raw addresses has a window std will not touch.
const HEAP_BASE = 1024

// Every allocation's size rounds up to this, so each `Buf` starts aligned and
// every width's natural alignment is satisfied at offset 0.
const ALIGN = 8

// The bump pointer: the address one past the last byte handed out.
let bumpPtr = HEAP_BASE

// `n` rounded up to the next multiple of `ALIGN`.
function alignUp(n: i32): i32 {
  const slack = n & (ALIGN - 1)
  if slack == 0 { return n }
  return n + (ALIGN - slack)
}

// Grow the memory until byte `end` (exclusive) is addressable. Page arithmetic
// throughout, because a byte count would overflow an i32 at 2 GiB.
function ensureCapacity(end: i32) {
  let needPages = end >> PAGE_SHIFT
  if (end & PAGE_MASK) != 0 { needPages = needPages + 1 }
  const havePages = __memory_size__()
  if needPages > havePages {
    // A refused growth cannot be papered over: the caller is about to write through
    // a `Buf` with no memory behind it.
    if __memory_grow__(needPages - havePages) < 0 { __trap__() }
  }
}

// Reserve `n` zero-filled bytes and describe them. Bytes never handed out
// before are zero for free; a region reclaimed by `bufferRelease` holds
// whatever was written there. Traps on a negative length or a total past 2 GiB.
// Growing the memory DETACHES a host's views of it — re-take them afterwards.
export function Buffer(byteLength: i32): Buf {
  if byteLength < 0 { __trap__() }
  const base = bumpPtr
  const next = base + alignUp(byteLength)
  if next < base { __trap__() }
  ensureCapacity(next)
  bumpPtr = next
  return { base: base, length: byteLength }
}

// The current bump pointer, to hand back to `bufferRelease`.
export function bufferMark(): i32 { return bumpPtr }

// Reclaim everything allocated since `mark`, in one move. Every `Buf` allocated
// after `mark` DANGLES: reads answer another buffer's bytes and writes corrupt
// them silently, because nothing is out of bounds. Traps on a `mark` outside
// `[heap base, bump pointer]` — which a mark held across an earlier release is.
export function bufferRelease(mark: i32) {
  if mark < HEAP_BASE { __trap__() }
  if mark > bumpPtr { __trap__() }
  bumpPtr = mark
}

// ── loads ────────────────────────────────────────────────────────────────────

// Eight widths, four of them signed/unsigned pairs: of the byte 0xFF, `loadI8`
// answers -1 and `loadU8` answers 255.

// The byte at `off`, sign-extended into an i32.
export function loadI8(self: Buf, off: i32): i32 {
  return __load_i8__(self.base + off)
}

// The byte at `off`, zero-extended into an i32.
export function loadU8(self: Buf, off: i32): i32 {
  return __load_u8__(self.base + off)
}

// The 16-bit halfword at `off`, sign-extended.
export function loadI16(self: Buf, off: i32): i32 {
  return __load_i16__(self.base + off)
}

// The 16-bit halfword at `off`, zero-extended.
export function loadU16(self: Buf, off: i32): i32 {
  return __load_u16__(self.base + off)
}

// The 32-bit word at `off`.
export function loadI32(self: Buf, off: i32): i32 {
  return __load_i32__(self.base + off)
}

// The 64-bit word at `off`.
export function loadI64(self: Buf, off: i32): i64 {
  return __load_i64__(self.base + off)
}

// The 32-bit float at `off`.
export function loadF32(self: Buf, off: i32): f32 {
  return __load_f32__(self.base + off)
}

// The 64-bit float at `off`.
export function loadF64(self: Buf, off: i32): f64 {
  return __load_f64__(self.base + off)
}

// ── stores ───────────────────────────────────────────────────────────────────

// Six widths and no signed/unsigned split: a store truncates, so `store8` has
// no signed twin for its name to distinguish it from.

// The 32-bit word at `off`.
export function storeI32(self: Buf, off: i32, v: i32) {
  __store_i32__(self.base + off, v)
}

// The 64-bit word at `off`.
export function storeI64(self: Buf, off: i32, v: i64) {
  __store_i64__(self.base + off, v)
}

// The 32-bit float at `off`.
export function storeF32(self: Buf, off: i32, v: f32) {
  __store_f32__(self.base + off, v)
}

// The 64-bit float at `off`.
export function storeF64(self: Buf, off: i32, v: f64) {
  __store_f64__(self.base + off, v)
}

// The low 8 bits of `v` at `off`; higher bits are discarded. It writes ONE byte
// and never a wider word, so a host reading the neighbours sees them untouched.
export function store8(self: Buf, off: i32, v: i32) {
  __store_i8__(self.base + off, v)
}

// The low 16 bits of `v` at `off`, little-endian. Legal and correct at every
// address, including one where the halfword straddles two words.
export function store16(self: Buf, off: i32, v: i32) {
  __store_i16__(self.base + off, v)
}

// ── bulk ─────────────────────────────────────────────────────────────────────

// Nothing here bounds-checks either; a non-positive `len` writes nothing.

// Set `len` bytes starting at `off` to the low 8 bits of `byte`.
export function fill(self: Buf, off: i32, len: i32, byte: i32) {
  if len > 0 { __memory_fill__(self.base + off, byte, len) }
}

// Copy `len` bytes from `src` at `srcOff` into `self` at `dstOff` — the
// DESTINATION is the receiver, matching `dst.fill(…)`. Overlapping ranges are
// handled: the copy behaves as if the bytes went through a temporary, so `src`
// and `self` may be the same `Buf`, overlapping either way.
export function copyFrom(
  self: Buf,
  dstOff: i32,
  src: Buf,
  srcOff: i32,
  len: i32,
) {
  if len > 0 { __memory_copy__(self.base + dstOff, src.base + srcOff, len) }
}

// ── typed views ──────────────────────────────────────────────────────────────

// A view re-describes a `Buf` sub-range in ELEMENTS rather than bytes. These
// ARE bounds-checked, because an out-of-range element index usually stays inside
// the memory and nothing else would catch it. `F32View` and `I32View` are
// distinct types on purpose: identically shaped, they would let a float read
// integer bytes.

// The largest element count whose byte size fits in a positive i32.
const MAX_COUNT_4 = 536870911

// A view of 4-byte floats. `base` is element 0's byte address and `length` is
// the element count, both plain field reads.
export type F32View = new { base: i32, length: i32 }

// A view of 4-byte signed integers.
export type I32View = new { base: i32, length: i32 }

// The base address of an f32 view, branded by width — the handle the `*At`
// accessors below take. Only `f32base` mints one, so a base that came from
// there was range-checked when its view was built.
export type F32Base = new i32

// The i32 twin, distinct from `F32Base` only by name — which is the whole job.
export type I32Base = new i32

// Check that `count` 4-byte elements starting at BYTE offset `off` lie inside
// `self`, and answer their address. Taken once per view, which is what lets
// each access check only `0 <= i < length`. An empty view is in range.
function view4Base(self: Buf, off: i32, count: i32): i32 {
  if off < 0 { __trap__() }
  if count < 0 { __trap__() }
  if count > MAX_COUNT_4 { __trap__() }
  const bytes = count << 2
  const end = off + bytes
  if end < off { __trap__() }
  if end > self.length { __trap__() }
  return self.base + off
}

// `count` f32 elements starting at byte `off`. Traps unless the whole range
// lies inside `self`. A `count` of 0 is in range and satisfies no index.
export function f32view(self: Buf, off: i32, count: i32): F32View {
  const b = view4Base(self, off, count)
  return { base: b, length: count }
}

// `count` i32 elements starting at byte `off`. Traps unless the whole range
// lies inside `self`. A `count` of 0 is in range and satisfies no index.
export function i32view(self: Buf, off: i32, count: i32): I32View {
  const b = view4Base(self, off, count)
  return { base: b, length: count }
}

// Element `i` of an f32 view. Traps on an index outside `[0, length)`.
export function getF32(self: F32View, i: i32): f32 {
  if i < 0 { __trap__() }
  if i >= self.length { __trap__() }
  return __load_f32__(self.base + (i << 2))
}

// Write element `i` of an f32 view. Traps on an index outside `[0, length)`.
export function setF32(self: F32View, i: i32, v: f32) {
  if i < 0 { __trap__() }
  if i >= self.length { __trap__() }
  __store_f32__(self.base + (i << 2), v)
}

// Element `i` of an i32 view. Traps on an index outside `[0, length)`.
export function getI32(self: I32View, i: i32): i32 {
  if i < 0 { __trap__() }
  if i >= self.length { __trap__() }
  return __load_i32__(self.base + (i << 2))
}

// Write element `i` of an i32 view. Traps on an index outside `[0, length)`.
export function setI32(self: I32View, i: i32, v: i32) {
  if i < 0 { __trap__() }
  if i >= self.length { __trap__() }
  __store_i32__(self.base + (i << 2), v)
}

// ── the bracket spelling ─────────────────────────────────────────────────────

// `v[i]` and `v[i] = x` over a view: the same bounds check and the same single
// load or store as the accessors above, so the two spellings mix in one loop.
export function "[]"(self: F32View, i: i32): f32 { return getF32(self, i) }

export function "[]="(self: F32View, i: i32, v: f32) { setF32(self, i, v) }

export function "[]"(self: I32View, i: i32): i32 { return getI32(self, i) }

export function "[]="(self: I32View, i: i32, v: i32) { setI32(self, i, v) }

// The ABSOLUTE byte address of element `i` — what a caller mixing view access
// with the raw intrinsics, or with a host-side typed array, needs. NOT bounds
// checked: it computes an address rather than dereferencing one, and the
// one-past-the-end address is the useful answer for a range.
export function byteAddrF32(self: F32View, i: i32): i32 {
  return self.base + (i << 2)
}

// The i32 twin.
export function byteAddrI32(self: I32View, i: i32): i32 {
  return self.base + (i << 2)
}

// ── hoisted accessors ────────────────────────────────────────────────────────

// These take the base and the length as SCALARS, so a loop hoists them once
// instead of re-reading the view on every access. Same traps, same loads and
// stores. Two things are given up, which is why `v[i]` stays the default: the
// pair can be MISMATCHED across two same-width columns, and the extent is the
// one you CLAIM — only a base from `f32base`/`i32base` carries the view's check.
// They are also NOT methods: a base is a plain address, not a receiver, so
// `getF32At(b, n, i)` is the only spelling and `b.getF32At(n, i)` is a type error.

// The branded base of an f32 view. The only public way to mint an `F32Base`.
export function f32base(self: F32View): F32Base { return self.base as F32Base }

// The i32 twin.
export function i32base(self: I32View): I32Base { return self.base as I32Base }

// Element `i` of the f32 extent `[base, base + length*4)`. Traps on an index
// outside `[0, length)`. `base` comes from `f32base(v)`.
export function getF32At(base: F32Base, length: i32, i: i32): f32 {
  if i < 0 { __trap__() }
  if i >= length { __trap__() }
  return __load_f32__((base as! i32) + (i << 2))
}

// Write element `i` of the f32 extent `[base, base + length*4)`. Traps on an
// index outside `[0, length)`.
export function setF32At(base: F32Base, length: i32, i: i32, v: f32) {
  if i < 0 { __trap__() }
  if i >= length { __trap__() }
  __store_f32__((base as! i32) + (i << 2), v)
}

// Element `i` of the i32 extent `[base, base + length*4)`. Traps on an index
// outside `[0, length)`. `base` comes from `i32base(v)`.
export function getI32At(base: I32Base, length: i32, i: i32): i32 {
  if i < 0 { __trap__() }
  if i >= length { __trap__() }
  return __load_i32__((base as! i32) + (i << 2))
}

// Write element `i` of the i32 extent `[base, base + length*4)`. Traps on an
// index outside `[0, length)`.
export function setI32At(base: I32Base, length: i32, i: i32, v: i32) {
  if i < 0 { __trap__() }
  if i >= length { __trap__() }
  __store_i32__((base as! i32) + (i << 2), v)
}
