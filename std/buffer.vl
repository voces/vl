// `std:buffer` — the linear-memory tier's allocator and access surface, in pure
// VL over the `__load_*__` / `__store_*__` / `__memory_*__` intrinsic floor
// (`docs/internals/buffer-design.md` §C, sequencing item S5). The compiler owns
// exactly what an INSTRUCTION is; allocation POLICY is ordinary code and lives
// here (O1 = (c): `Buffer` is std VL, not a compiler-known type).
//
// TWO HEAPS. A `Buf` VALUE is an ordinary WasmGC struct with ordinary VL value
// semantics; a `Buf`'s CONTENTS live in linear memory, which the host can read
// directly through the module's exported `memory`. `.length` is a plain field
// read — no call, no side table.
//
// BOUNDS: there are none here, by design (§A4). An access past the end of the
// memory traps in the ENGINE — that trap is the memory-safety proof, and adding
// a VL-level check would only make it quieter. An access past the end of a
// `Buf` but still inside the memory is NOT caught: `Buf` describes an extent,
// it does not fence it.
//
// HOST CONTRACT (O5 = lazy growth, no epoch export). `Buffer(n)` grows the
// memory when it must, and a `memory.grow` DETACHES every host view of
// `exports.memory.buffer`. A host must therefore re-take its typed-array views
// after any guest call that may allocate; a stale view is detectable by
// `view.byteLength === 0` (a detached view yields `undefined` on an indexed
// read rather than throwing). This is what Emscripten's `updateMemoryViews()`,
// wasm-bindgen's `byteLength === 0` probe and Go's `wasm_exec.js` buffer-
// identity check all do; none of them exports a growth counter, and neither
// does this module.
//
// RECLAMATION IS MARK/RELEASE, AND IT CAN DANGLE (O6). There is no per-object
// `free`; `bufferMark()` / `bufferRelease(mark)` move the one bump pointer, so
// reclamation is LIFO and costs nothing. The hazard is stated here rather than
// in a footnote because it is the FIRST way a VL program can hold a dangling
// reference at all: a `Buf` held across a `bufferRelease` that undoes its
// allocation still points at live, in-bounds, since-reused linear memory. Reads
// through it return another buffer's bytes and writes through it corrupt them —
// SILENTLY. No trap fires, because nothing is out of bounds. Treat a released
// mark as invalidating every `Buf` allocated after it.
//
// PERFORMANCE. Every access below is a real wasm `call`; `wasm-opt -O` (what
// `vl build -O` runs) does NOT inline these wrappers, `-O3 --closed-world`
// does (§O1). Every body is now ONE instruction plus its address arithmetic —
// `store8`/`store16` were read-modify-write emulations and `fill`/`copyFrom`
// were byte loops until the narrow-store and bulk intrinsics landed, and the
// swap changed no signature and no expectation.

// A `Buf` is a linear-memory extent: the byte address of its first byte, and
// the number of bytes the caller ASKED for (the allocator may reserve a few
// more for alignment; those are invisible here).
export type Buf = { base: i32, length: i32 }

// A wasm page is 64 KiB; `__memory_size__` / `__memory_grow__` count pages.
const PAGE_SHIFT = 16
const PAGE_MASK = 65535

// POLICY 1 — the reserved low region. Byte addresses below `HEAP_BASE` are
// never handed out. Three reasons, none of them cosmetic:
//   - address 0 stays outside every allocation, so `base == 0` cannot be a
//     legitimate `Buf` and a zeroed/garbage descriptor is distinguishable;
//   - a program may still poke raw addresses through the bare intrinsics
//     (that is the §A3 "two users collide" hazard), and this leaves it a
//     documented kilobyte that `std:buffer` promises never to touch;
//   - the host's staging ABI probe (`ioMem`, `scripts/vl-host/src/main.rs`)
//     wants a fixed low window it can own later without moving the heap.
// 1 KiB, not one page: reserving a whole page would force a `memory.grow`
// during init for programs that fit comfortably in the default one.
const HEAP_BASE = 1024

// POLICY 2 — alignment. Every allocation's SIZE is rounded up to 8 bytes, and
// `HEAP_BASE` is a multiple of 8, so every `Buf` starts 8-byte aligned and each
// width's natural alignment is satisfied at offset 0 and at every 8-multiple
// offset. This is a PERFORMANCE choice, not a correctness one — wasm's
// alignment immediate is a hint and every load/store here is legal at any
// address (pinned by the unaligned cases in `tests/cases/memory/`). 8 is the
// widest scalar VL can store (i64 / f64).
const ALIGN = 8

// The bump pointer: the address one past the last byte handed out. Module-level
// mutable state, which is exactly what makes the allocator's policy ordinary
// VL code (§C4).
let bumpPtr = HEAP_BASE

// `n` rounded up to the next multiple of `ALIGN`.
function alignUp(n: i32): i32 {
  const slack = n & (ALIGN - 1)
  if slack == 0 { return n }
  return n + (ALIGN - slack)
}

// Grow the memory until byte `end` (exclusive) is addressable. Page arithmetic
// throughout — computing `pages * 65536` would itself overflow i32 at 2 GiB,
// which is inside the range this can be asked about.
function ensureCapacity(end: i32) {
  let needPages = end >> PAGE_SHIFT
  if (end & PAGE_MASK) != 0 { needPages = needPages + 1 }
  const havePages = __memory_size__()
  if needPages > havePages {
    // `memory.grow` answers with the size BEFORE the growth, or -1 on failure.
    // A refused allocation cannot be papered over — the caller is about to write
    // through a `Buf` that has no memory behind it.
    //
    // MEASURED, this branch is defensive rather than routine: `Buffer`'s i32
    // overflow guard caps `end` at 2^31, i.e. at most 32768 pages, and wasm32's
    // own ceiling is 65536 — so the SPEC limit is unreachable from here and only
    // host resource exhaustion can produce the -1. Both hosts grow a 2 GiB
    // request without complaint (wasmtime 47 and V8 alike, measured), which is
    // why no corpus fixture pins this line: there is no request that fails
    // deterministically on every host.
    if __memory_grow__(needPages - havePages) < 0 { __trap__() }
  }
}

// `Buffer(n)` — reserve `n` zero-filled bytes and describe them.
//
// ZERO-FILL: a wasm memory starts zeroed and freshly grown pages are zeroed, so
// bytes that have never been handed out before are zero for free — no fill loop
// runs here. That guarantee ends at the first `bufferRelease`: addresses handed
// out a SECOND time carry whatever the previous owner wrote. Call
// `buf.fill(0, buf.length, 0)` when reusing a released region and zeros matter.
//
// Traps on a negative length and on an allocation that would carry the bump
// pointer past 2 GiB (where an i32 byte address stops being orderable), because
// either would silently corrupt every later allocation.
export function Buffer(byteLength: i32): Buf {
  if byteLength < 0 { __trap__() }
  const base = bumpPtr
  const next = base + alignUp(byteLength)
  if next < base { __trap__() }
  ensureCapacity(next)
  bumpPtr = next
  return { base: base, length: byteLength }
}

// `bufferMark()` — the current bump pointer, to hand back to `bufferRelease`.
export function bufferMark(): i32 { return bumpPtr }

// `bufferRelease(mark)` — reclaim everything allocated since `mark` in one
// move. LIFO, no free list, no fragmentation, and NO liveness check: see this
// module's header for the dangling-`Buf` hazard this opens, which is silent
// corruption rather than a trap.
//
// Traps on a mark outside `[HEAP_BASE, bumpPtr]` — below the base it would let
// allocations walk into the reserved region, above the pointer it re-reserves
// bytes that are already free. Both are bugs at the call site, not recoverable
// states.
export function bufferRelease(mark: i32) {
  if mark < HEAP_BASE { __trap__() }
  if mark > bumpPtr { __trap__() }
  bumpPtr = mark
}

// ── Loads: eight widths, four of them signed/unsigned pairs. ──
//
// The signed/unsigned split is REAL here and is kept: `i32.load8_s` and
// `i32.load8_u` are two different instructions, and of the byte 0xFF the first
// answers -1 while the second answers 255. (The stores below have no such
// split — see `store8`.)

// The byte at `off`, sign-extended into an i32 (0xFF → -1).
export function loadI8(self: Buf, off: i32): i32 {
  return __load_i8__(self.base + off)
}

// The byte at `off`, zero-extended into an i32 (0xFF → 255).
export function loadU8(self: Buf, off: i32): i32 {
  return __load_u8__(self.base + off)
}

// The 16-bit halfword at `off`, sign-extended (0xFFFF → -1).
export function loadI16(self: Buf, off: i32): i32 {
  return __load_i16__(self.base + off)
}

// The 16-bit halfword at `off`, zero-extended (0xFFFF → 65535).
export function loadU16(self: Buf, off: i32): i32 {
  return __load_u16__(self.base + off)
}

// The 32-bit word at `off`.
export function loadI32(self: Buf, off: i32): i32 {
  return __load_i32__(self.base + off)
}

// The 64-bit word at `off`.
export function loadI64(self: Buf, off: i32): i64 {
  return __load_i64__(self.base + off)
}

// The 32-bit float at `off`.
export function loadF32(self: Buf, off: i32): f32 {
  return __load_f32__(self.base + off)
}

// The 64-bit float at `off`.
export function loadF64(self: Buf, off: i32): f64 {
  return __load_f64__(self.base + off)
}

// ── Stores: six widths, and no signed/unsigned split (O2). ──
//
// A store is sign-AGNOSTIC. There is exactly one instruction per width and it
// TRUNCATES — `i32.store8` cannot tell a signed byte from an unsigned one — so
// naming these `storeU8`/`storeI8` would falsely imply a signed twin exists.
// Hence `store8` / `store16` against the loads' `loadI8` / `loadU8`: the
// asymmetry is the instruction set's, and it is deliberate.

// The 32-bit word at `off`.
export function storeI32(self: Buf, off: i32, v: i32) {
  __store_i32__(self.base + off, v)
}

// The 64-bit word at `off`.
export function storeI64(self: Buf, off: i32, v: i64) {
  __store_i64__(self.base + off, v)
}

// The 32-bit float at `off`.
export function storeF32(self: Buf, off: i32, v: f32) {
  __store_f32__(self.base + off, v)
}

// The 64-bit float at `off`.
export function storeF64(self: Buf, off: i32, v: f64) {
  __store_f64__(self.base + off, v)
}

// The low 8 bits of `v` at `off`. Higher bits are discarded, exactly as
// `i32.store8` discards them — because this IS `i32.store8` (0x3a).
//
// This body used to be a READ-MODIFY-WRITE over the containing 32-bit word, and
// its whole expectation set survived the swap unchanged, which is the evidence
// that the emulation was faithful. What the emulation could not preserve was the
// access WIDTH — it touched 4 bytes where the instruction touches 1 — and that
// difference was unobservable from VL (no threads, no shared memory) but NOT
// from the host: `tests/vl_exported_memory_test.ts` reads the untouched
// neighbours through the exported memory, which is the assertion the emulation
// would have failed.
export function store8(self: Buf, off: i32, v: i32) {
  __store_i8__(self.base + off, v)
}

// The low 16 bits of `v` at `off`, little-endian — `i32.store16` (0x3b).
//
// This was two byte-wide read-modify-writes rather than one word-level one,
// because a halfword at an address congruent to 3 mod 4 STRADDLES two words. The
// instruction has no such difficulty: wasm's alignment immediate is a hint, and
// a 16-bit store is legal and correct at every address, straddle included.
export function store16(self: Buf, off: i32, v: i32) {
  __store_i16__(self.base + off, v)
}

// ── Bulk ops: one instruction each. ──
//
// THE ONE PLACE THIS MODULE DOES NOT PASS ITS ARGUMENT STRAIGHT THROUGH. Both
// instructions take an UNSIGNED byte count, and VL has no unsigned i32, so a
// negative `len` is ~4 GiB and traps in the engine. The byte loops these bodies
// replaced treated a non-positive `len` as "write nothing", and that behaviour
// is pinned (`tests/cases/std/buffer-bulk.vl`), so the guard stays. Which is the
// right layering anyway: the intrinsic IS the instruction (`__memory_fill__`
// traps on -5, pinned by `tests/cases/memory/bulk-negative-length-traps.vl`),
// and softening it is POLICY, which is std's job (O1 = (c)).
//
// Nothing else is guarded. There is still no per-access bounds check — a range
// that leaves the memory traps in the engine, and a range that leaves the `Buf`
// but stays inside the memory is not caught, exactly as for every load and store
// above. `Buf` describes an extent; it does not fence it.

// Set `len` bytes starting at `off` to the low 8 bits of `byte` — `memory.fill`
// (0xfc 11). A non-positive `len` writes nothing.
// (Spelled as a positive `if` rather than an early `return`: a BARE `return` in a
// void function type-checks and then fails at emit — `emitProgram: bare return is
// not supported`. Worth knowing before reaching for a guard clause here.)
export function fill(self: Buf, off: i32, len: i32, byte: i32) {
  if len > 0 { __memory_fill__(self.base + off, byte, len) }
}

// Copy `len` bytes from `src` at `srcOff` into `self` at `dstOff` — the
// DESTINATION is the receiver (O3), matching `dst.fill(...)` and the
// self-first UFCS shape `std:array` / `std:fmt` already establish. (`Buffer.copy`
// is not spellable: VL has no static methods.)
//
// OVERLAP IS HANDLED, and it is now handled by the INSTRUCTION. `memory.copy`
// (0xfc 10) is defined to behave as if the bytes went through a temporary —
// memmove semantics, not memcpy — so an overlapping copy never reads a byte it
// has already overwritten, in either direction. `self` and `src` may be the same
// `Buf`, and may overlap partially either way.
//
// This body used to CHOOSE its loop direction from the absolute addresses,
// because a naive forward loop is wrong exactly when the destination is above
// the source. That choice is gone, not merely optimized: both directions were
// pinned by value in `buffer-bulk.vl` before the swap and both still pass, which
// is what makes "the instruction has the semantics the loop was imitating" a
// measurement rather than a claim about the spec.
export function copyFrom(
  self: Buf,
  dstOff: i32,
  src: Buf,
  srcOff: i32,
  len: i32,
) {
  if len > 0 { __memory_copy__(self.base + dstOff, src.base + srcOff, len) }
}

// ── Typed views (webcraft P1.1) ──────────────────────────────────────────────
//
// A VIEW is a `Buf` sub-range re-described in ELEMENTS rather than bytes: a byte
// address plus an element COUNT, with an element width baked into the type. The
// kernel it exists for is structure-of-arrays — `for i { x[i] += vx[i] }` over
// columns — where the alternative is `loadF32(base + (i << 2))` spelled by hand
// at every access, which is the DataView experience webcraft already has and
// wants absorbed.
//
// WHY THE TWO VIEWS ARE `new` (webcraft P1.5, `docs/internals/newtype-design.md`).
// VL is STRUCTURALLY typed: a plain `type X = {…}` names a shape, not an identity,
// so two declarations with the same field names and types ARE THE SAME TYPE and
// are silently interchangeable. Spelled plainly — both views as
// `{ base: i32, length: i32 }` — an `I32View` satisfies every `F32View` parameter
// in this module and `iv.getF32(0)` type-checks while REINTERPRETING four integer
// bytes as a float, with no diagnostic. Measured, not feared.
//
// `new` mints the identity the shape does not: the two declarations are now
// distinct to the checker even though the shape is identical, and the mismatch is
// a named reject (`tests/cases/std/buffer-view-element-type-mismatch.vl`). It is
// ZERO-COST — a newtype is erased before the emitter runs, so the two views still
// share one wasm heap type and the module is byte-identical to the one this
// section shipped with `f32base`/`i32base` field names.
//
// THE ELEMENT WIDTH IS IN THE TYPE, NOT IN A FIELD NAME. That is the whole point:
// every further width this family grows (i64, f64, the narrow widths) is one more
// `new`, not one more name hack.
//
// `.length` is the ELEMENT count, per the P1.1 spec's `x.length`. It is a plain
// struct field — no call, no side table, exactly as `Buf.length` is.
//
// BOUNDS ARE CHECKED HERE, AND THIS IS THE ONE PLACE IN `std:buffer` THAT
// CHECKS. Everything above obeys §A4 (the engine traps; a `Buf` describes an
// extent and does not fence it). A view is different, and deliberately so,
// because the P1.1 spec asks for it in the same breath as the surface:
// "index-bounds = count". The reason the answer differs is that the FAILURE
// MODE differs. An out-of-range byte offset on a `Buf` is usually far out and
// leaves the memory, so the engine catches it. An out-of-range ELEMENT index on
// a view is usually one or two past the end of a column — still inside the
// memory, still inside some other column — so the engine sees nothing wrong and
// the read returns A NEIGHBOUR'S BYTES. That is a silent wrong answer in exactly
// the code (SoA kernels, snapshot/rollback, the differential harness) whose
// entire value is being byte-comparable with a TS twin. So each accessor traps
// on an index outside `[0, length)` via `__trap__` (`unreachable`) — the same
// loud, deterministic, unrecoverable stop the engine's own bounds trap is.
//
// THE CHECK IS TWO COMPARES PER ACCESS AND NOTHING HOISTS IT — not VL, which has
// no LICM, and not binaryen at `--closed-world -O3 --gufa -O3`, which keeps both
// compares even when the loop guard four instructions above them is the
// byte-identical comparison against the same constant. That is read off the
// disassembly, not inferred from a stopwatch, and it is pinned as a shape by
// `tests/buffer_view_bounds_shape_test.ts`. P1.4 asks that the policy be stated,
// not that it be eliminated; `docs/internals/buffer-design.md` §M is the
// statement, with the price and the disassembly.
//
// The price is not what it looks like. On a loop holding ONE view the check
// measures FREE at `-O3` (the compares are perfectly predicted and fill spare
// issue slots); what costs is the per-access re-read of this struct's own `base`
// and `length`, which binaryen hoists out of the loop only when GUFA can fold
// them to constants — i.e. only when the program has one live view of the shape.
// A two-view loop pays 7 field loads per element and runs 3.7x the hoisted
// spelling. So the recipe for a kernel that has proved its own bounds is to take
// the base and the count ONCE (`byteAddrF32(v, 0)`, `v.length`) and run the bare
// intrinsics inside — measured identical to a hand-written raw kernel at EVERY
// rung, no flag needed. `Buf`'s `loadF32`/`storeF32` are also still there, still
// unfenced, and still take a byte offset.

// The largest element count whose byte size fits in a positive i32, per width.
// `count << 2` at 2^29 is already negative, so the count must be rejected BEFORE
// the shift rather than after it.
const MAX_COUNT_4 = 536870911

// A view of 4-byte floats. `base` is the byte address of element 0; `length` is
// the element count. `new` is what keeps this distinct from `I32View`, which has
// the identical shape — see this section's header.
export type F32View = new { base: i32, length: i32 }

// A view of 4-byte signed integers.
export type I32View = new { base: i32, length: i32 }

// Shared construction check for a 4-byte-element view over `self`: `off` is a
// BYTE offset into the `Buf` and `count` is an ELEMENT count. Traps unless the
// whole range `[off, off + count*4)` lies inside the `Buf`.
//
// This is the ALLOCATION-TIME check §J3 puts in std's hands, taken once per view
// rather than once per access. It is what makes the per-access check able to be
// just `0 <= i < length`: if the extent was validated when the view was made,
// an in-range index cannot leave the `Buf`.
//
// A view may be EMPTY (`count == 0`), which is in-range for every offset up to
// `length` and satisfies no index at all — the natural base case for a loop over
// a column that happens to have no rows.
function view4Base(self: Buf, off: i32, count: i32): i32 {
  if off < 0 { __trap__() }
  if count < 0 { __trap__() }
  if count > MAX_COUNT_4 { __trap__() }
  const bytes = count << 2
  const end = off + bytes
  if end < off { __trap__() }
  if end > self.length { __trap__() }
  return self.base + off
}

// `buf.f32view(off, count)` — `count` f32 elements starting at byte `off`.
export function f32view(self: Buf, off: i32, count: i32): F32View {
  const b = view4Base(self, off, count)
  return { base: b, length: count }
}

// `buf.i32view(off, count)` — `count` i32 elements starting at byte `off`.
export function i32view(self: Buf, off: i32, count: i32): I32View {
  const b = view4Base(self, off, count)
  return { base: b, length: count }
}

// Element `i` of an f32 view. Traps on an index outside `[0, length)`.
export function getF32(self: F32View, i: i32): f32 {
  if i < 0 { __trap__() }
  if i >= self.length { __trap__() }
  return __load_f32__(self.base + (i << 2))
}

// Write element `i` of an f32 view. Traps on an index outside `[0, length)`.
export function setF32(self: F32View, i: i32, v: f32) {
  if i < 0 { __trap__() }
  if i >= self.length { __trap__() }
  __store_f32__(self.base + (i << 2), v)
}

// Element `i` of an i32 view. Traps on an index outside `[0, length)`.
export function getI32(self: I32View, i: i32): i32 {
  if i < 0 { __trap__() }
  if i >= self.length { __trap__() }
  return __load_i32__(self.base + (i << 2))
}

// Write element `i` of an i32 view. Traps on an index outside `[0, length)`.
export function setI32(self: I32View, i: i32, v: i32) {
  if i < 0 { __trap__() }
  if i >= self.length { __trap__() }
  __store_i32__(self.base + (i << 2), v)
}

// ── the bracket (webcraft P1.1's spelling) ───────────────────────────────────
// `x[i]` / `x[i] = v` over a view, as free INDEX-OPERATOR functions (B14). Each
// is a one-line forward to the accessor above: same bounds check, same single
// load/store, so the bracket is SPELLING, not a second access path, and the two
// spellings mix freely in one loop.
//
// THE FORWARD IS A REAL FRAME AT THE UNOPTIMIZED RUNG. `x[i]` emits a call to
// THIS function, which then calls `getF32` — two calls per access where
// `x.getF32(i)` emits one. The modules are the same SIZE (one call index swapped
// for another) but not the same bytes, and unoptimized the extra frame is
// measurable. Both `-O` and `-O3` inline the forward away and the two spellings
// converge, so this is a `vl build`-with-no-flags effect only; §M2 has the
// number.
//
// Two `"[]"` declarations coexist because an index operator dispatches on its
// `self` parameter's TYPE and the two views are distinct nominal brands — the
// only thing that tells them apart, since their structures are identical.

export function "[]"(self: F32View, i: i32): f32 { return getF32(self, i) }

export function "[]="(self: F32View, i: i32, v: f32) { setF32(self, i, v) }

export function "[]"(self: I32View, i: i32): i32 { return getI32(self, i) }

export function "[]="(self: I32View, i: i32, v: i32) { setI32(self, i, v) }

// The byte offset of element `i` RELATIVE TO the `Buf` the view was cut from is
// not recoverable from the view alone (a view knows an absolute address, not its
// parent). These two return the ABSOLUTE byte address of element `i`, which is
// what a caller mixing view access with the bare intrinsics or with a host-side
// typed array needs. No bounds check: this computes an address, it does not
// dereference one, and `byteAddrF32(v, v.length)` — the one-past-the-end address
// — is the useful answer for a range, not an error.
export function byteAddrF32(self: F32View, i: i32): i32 {
  return self.base + (i << 2)
}

export function byteAddrI32(self: I32View, i: i32): i32 {
  return self.base + (i << 2)
}
