// `std:simd` — 128-bit vectors computed lane by lane in one instruction: four f32 lanes
// (`F32x4`), or 16 u8, 8 u16, 8 i16 or 4 i32 lanes (`U8x16`, `U16x8`, `I16x8`, `I32x4`).
//     import { F32x4, loadF32x4, splatF32, storeF32x4 } from "std:simd"
// Operations are methods keyed on the receiver's shape, `px.min(hi).addSat(b)`, and need no
// import. `splat`, `load` and `store` keep a shape suffix: no vector receiver says which shape to
// build. Importing a keyed name such as `min` shadows the scalar intrinsic; call it as a method.
// Your own function of that name wins if its `self` is un-annotated, generic or the vector type.
// `v as I16x8` reads the same bytes as another shape; any `Buf` offset works, unchecked. No
// relaxed ops: integer and finite f32 results are the same bits on every host. Not here:
// negation, vector `not`, and integer lanes, shifts and `*`.

import { Buf } from "std:buffer"

// Four f32 lanes. A distinct type from `Mask32x4`: a comparison result is not accepted as
// numbers without an `as`.
export type F32x4 = new v128

// Sixteen u8, eight u16, eight i16 and four i32 lanes. Each is its own type, so a `U8x16` is not
// accepted where an `I16x8` is expected without an `as`.
export type U8x16 = new v128
export type U16x8 = new v128
export type I16x8 = new v128
export type I32x4 = new v128

// The answer of a lane-wise comparison of a four-lane vector (`F32x4` or `I32x4`): each lane is
// all-ones where true, all-zeros where false. `Mask8x16` and `Mask16x8` answer the other shapes.
export type Mask32x4 = new v128
export type Mask8x16 = new v128
export type Mask16x8 = new v128

// ── construct, load, store ───────────────────────────────────────────────────

// All four lanes set to `x`.
export function splatF32(x: f32): F32x4 { return __splat_f32x4__(x) as F32x4 }

// A vector from its four lanes, x first.
export function f32x4(x: f32, y: f32, z: f32, w: f32): F32x4 {
  const v0 = __splat_f32x4__(x)
  const v1 = __replace_lane_f32x4__(v0, 1, y)
  const v2 = __replace_lane_f32x4__(v1, 2, z)
  return __replace_lane_f32x4__(v2, 3, w) as F32x4
}

// The 16 bytes at byte `off` as four f32 lanes, lane 0 at the lowest address. Any `off`
// works, aligned or not; a read past the end of `self` is not caught.
export function loadF32x4(self: Buf, off: i32): F32x4 {
  return __load_v128__(self.base + off) as F32x4
}

// Write `v`'s four lanes as 16 bytes at byte `off`, lane 0 at the lowest address. Any `off`
// works; a write past the end of `self` is not caught and lands on whatever is there.
export function storeF32x4(self: Buf, off: i32, v: F32x4) {
  __store_v128__(self.base + off, v as! v128)
}

// ── lanes ────────────────────────────────────────────────────────────────────

// A lane position, 0 to 3. A literal checks itself; a plain `i32` is refused, so turn one into
// a lane with a function declared to return `Lane4`.
export type Lane4 = 0 | 1 | 2 | 3

// Lane `i`, where lane 0 is `x`. A literal `i` compiles to one lane read when optimised; a
// `Lane4` known only at run time costs a four-way branch.
export function lane(self: F32x4, i: Lane4): f32 {
  const r = self as! v128
  if i == 0 { return __extract_lane_f32x4__(r, 0) }
  if i == 1 { return __extract_lane_f32x4__(r, 1) }
  if i == 2 { return __extract_lane_f32x4__(r, 2) }
  return __extract_lane_f32x4__(r, 3)
}

// A copy of `self` with lane `i` set to `x`; `self` itself is unchanged. The index works as
// for `lane`.
export function withLane(self: F32x4, i: Lane4, x: f32): F32x4 {
  const r = self as! v128
  if i == 0 { return __replace_lane_f32x4__(r, 0, x) as F32x4 }
  if i == 1 { return __replace_lane_f32x4__(r, 1, x) as F32x4 }
  if i == 2 { return __replace_lane_f32x4__(r, 2, x) as F32x4 }
  return __replace_lane_f32x4__(r, 3, x) as F32x4
}

// Lane 0, the graphics `x`.
export get x(self: F32x4): f32 {
  return __extract_lane_f32x4__(self as! v128, 0)
}

// Lane 1, the graphics `y`.
export get y(self: F32x4): f32 {
  return __extract_lane_f32x4__(self as! v128, 1)
}

// Lane 2, the graphics `z`.
export get z(self: F32x4): f32 {
  return __extract_lane_f32x4__(self as! v128, 2)
}

// Lane 3, the graphics `w`; 0 in a vec3.
export get w(self: F32x4): f32 {
  return __extract_lane_f32x4__(self as! v128, 3)
}

// ── arithmetic ───────────────────────────────────────────────────────────────

// `a + b`, lane by lane; `a.add(b)` below is its method spelling.
export function "+"(self: F32x4, o: F32x4): F32x4 { return self.add(o) }

// `a - b`, lane by lane.
export function "-"(self: F32x4, o: F32x4): F32x4 { return self.sub(o) }

// `a * b`, lane by lane.
export function "*"(self: F32x4, o: F32x4): F32x4 { return self.mul(o) }

// `a / b`, lane by lane; a zero lane in `o` gives an infinity or NaN in that lane, not a trap.
export function "/"(self: F32x4, o: F32x4): F32x4 { return self.div(o) }

// Lane-wise sum, the method form of `+`.
export function add(self: F32x4, o: F32x4): F32x4 {
  return __add_f32x4__(self as! v128, o as! v128) as F32x4
}

// Lane-wise difference, the method form of `-`.
export function sub(self: F32x4, o: F32x4): F32x4 {
  return __sub_f32x4__(self as! v128, o as! v128) as F32x4
}

// Lane-wise product, the method form of `*`.
export function mul(self: F32x4, o: F32x4): F32x4 {
  return __mul_f32x4__(self as! v128, o as! v128) as F32x4
}

// Lane-wise quotient, the method form of `/`.
export function div(self: F32x4, o: F32x4): F32x4 {
  return __div_f32x4__(self as! v128, o as! v128) as F32x4
}

// The smaller of each pair of lanes. A NaN in either lane gives NaN, and -0.0 counts as
// smaller than 0.0.
export function min(self: F32x4, o: F32x4): F32x4 {
  return __min_f32x4__(self as! v128, o as! v128) as F32x4
}

// The larger of each pair of lanes. A NaN in either lane gives NaN, and 0.0 counts as
// larger than -0.0.
export function max(self: F32x4, o: F32x4): F32x4 {
  return __max_f32x4__(self as! v128, o as! v128) as F32x4
}

// Each lane with its sign cleared; -0.0 becomes 0.0.
export function abs(self: F32x4): F32x4 {
  return __abs_f32x4__(self as! v128) as F32x4
}

// The square root of each lane, correctly rounded; a negative lane gives NaN.
export function sqrt(self: F32x4): F32x4 {
  return __sqrt_f32x4__(self as! v128) as F32x4
}

// The four lanes added as `(x + z) + (y + w)`. That order is fixed, so a scalar loop
// adding in the same order gets the same bits.
export function reduceAdd(self: F32x4): f32 {
  const v = self as! v128
  const s = __add_f32x4__(v, __shuffle_f32x4__(v, v, 2, 3, 0, 1))
  const t = __add_f32x4__(s, __shuffle_f32x4__(s, s, 1, 0, 3, 2))
  return __extract_lane_f32x4__(t, 0)
}

// ── compare and select ───────────────────────────────────────────────────────

// Lanes where `self < o`. Every ordered comparison is false for a NaN lane.
export function lt(self: F32x4, o: F32x4): Mask32x4 {
  return __lt_f32x4__(self as! v128, o as! v128) as Mask32x4
}

// Lanes where `self <= o`.
export function le(self: F32x4, o: F32x4): Mask32x4 {
  return __le_f32x4__(self as! v128, o as! v128) as Mask32x4
}

// Lanes where `self > o`.
export function gt(self: F32x4, o: F32x4): Mask32x4 {
  return __gt_f32x4__(self as! v128, o as! v128) as Mask32x4
}

// Lanes where `self >= o`.
export function ge(self: F32x4, o: F32x4): Mask32x4 {
  return __ge_f32x4__(self as! v128, o as! v128) as Mask32x4
}

// Lanes where `self == o` as numbers: NaN is never equal, and -0.0 equals 0.0.
export function eq(self: F32x4, o: F32x4): Mask32x4 {
  return __eq_f32x4__(self as! v128, o as! v128) as Mask32x4
}

// Lanes where `self != o`; the exact complement of `eq`, so true for a NaN lane.
export function ne(self: F32x4, o: F32x4): Mask32x4 {
  return __ne_f32x4__(self as! v128, o as! v128) as Mask32x4
}

// Lane by lane, `self` where `m` is true and `other` where it is false.
export function select(self: F32x4, m: Mask32x4, other: F32x4): F32x4 {
  return __bitselect_v128__(self as! v128, other as! v128, m as! v128) as F32x4
}

// ── geometry ─────────────────────────────────────────────────────────────────

// The dot product over all four lanes, summed in `reduceAdd`'s order. For vec3s,
// keep w at 0 in both.
export function dot(self: F32x4, o: F32x4): f32 {
  return self.mul(o).reduceAdd()
}

// The 3D cross product of the x, y, z lanes; both w lanes are ignored and the result's w is 0.
export function cross(self: F32x4, o: F32x4): F32x4 {
  const a = self as! v128
  const b = o as! v128
  const l = __mul_f32x4__(
    __shuffle_f32x4__(a, a, 1, 2, 0, 3),
    __shuffle_f32x4__(b, b, 2, 0, 1, 3),
  )
  const r = __mul_f32x4__(
    __shuffle_f32x4__(a, a, 2, 0, 1, 3),
    __shuffle_f32x4__(b, b, 1, 2, 0, 3),
  )
  return __replace_lane_f32x4__(__sub_f32x4__(l, r), 3, 0.0) as F32x4
}

// `self` divided by its length `sqrt(self.dot(self))`, all four lanes. A zero vector gives
// NaN in every lane.
export function normalize(self: F32x4): F32x4 {
  return self.div(splatF32(self.dot(self)).sqrt())
}

// ── U8x16 ────────────────────────────────────────────────────────────────────

// All 16 lanes set to `x`; only its low 8 bits are kept, so 256 gives 0.
export function splatU8(x: i32): U8x16 { return __splat_i8x16__(x) as U8x16 }

// The 16 bytes at byte `off` as 16 u8 lanes, little-endian, lane 0 at the lowest address.
// Any `off` works, aligned or not; a read past the end of `self` is not caught.
export function loadU8x16(self: Buf, off: i32): U8x16 {
  return __load_v128__(self.base + off) as U8x16
}

// Write `v`'s 16 lanes as 16 bytes at byte `off`, lane 0 at the lowest address. A write past
// the end of `self` is not caught and lands on whatever is there.
export function storeU8x16(self: Buf, off: i32, v: U8x16) {
  __store_v128__(self.base + off, v as! v128)
}

// `a + b`, lane by lane, wrapping: a lane past 255 wraps to 0.
export function "+"(self: U8x16, o: U8x16): U8x16 { return self.add(o) }

// `a - b`, lane by lane, wrapping.
export function "-"(self: U8x16, o: U8x16): U8x16 { return self.sub(o) }

// Lane-wise wrapping sum, the method form of `+`.
export function add(self: U8x16, o: U8x16): U8x16 {
  return __add_i8x16__(self as! v128, o as! v128) as U8x16
}

// Lane-wise wrapping difference, the method form of `-`.
export function sub(self: U8x16, o: U8x16): U8x16 {
  return __sub_i8x16__(self as! v128, o as! v128) as U8x16
}

// Lane-wise sum clamped to 0 to 255: a lane that would overflow stays at the bound.
export function addSat(self: U8x16, o: U8x16): U8x16 {
  return __add_sat_u_i8x16__(self as! v128, o as! v128) as U8x16
}

// Lane-wise difference clamped to 0 to 255: 3 - 5 gives 0.
export function subSat(self: U8x16, o: U8x16): U8x16 {
  return __sub_sat_u_i8x16__(self as! v128, o as! v128) as U8x16
}

// The smaller of each pair of lanes, read as unsigned u8.
export function min(self: U8x16, o: U8x16): U8x16 {
  return __min_u_i8x16__(self as! v128, o as! v128) as U8x16
}

// The larger of each pair of lanes, read as unsigned u8.
export function max(self: U8x16, o: U8x16): U8x16 {
  return __max_u_i8x16__(self as! v128, o as! v128) as U8x16
}

// Lanes where `self == o`.
export function eq(self: U8x16, o: U8x16): Mask8x16 {
  return __eq_i8x16__(self as! v128, o as! v128) as Mask8x16
}

// Lanes where `self != o`.
export function ne(self: U8x16, o: U8x16): Mask8x16 {
  return __ne_i8x16__(self as! v128, o as! v128) as Mask8x16
}

// Lanes where `self < o`, read as unsigned u8.
export function lt(self: U8x16, o: U8x16): Mask8x16 {
  return __lt_u_i8x16__(self as! v128, o as! v128) as Mask8x16
}

// Lanes where `self <= o`.
export function le(self: U8x16, o: U8x16): Mask8x16 {
  return __le_u_i8x16__(self as! v128, o as! v128) as Mask8x16
}

// Lanes where `self > o`.
export function gt(self: U8x16, o: U8x16): Mask8x16 {
  return __gt_u_i8x16__(self as! v128, o as! v128) as Mask8x16
}

// Lanes where `self >= o`.
export function ge(self: U8x16, o: U8x16): Mask8x16 {
  return __ge_u_i8x16__(self as! v128, o as! v128) as Mask8x16
}

// Lane by lane, `self` where `m` is true and `other` where it is false.
export function select(self: U8x16, m: Mask8x16, other: U8x16): U8x16 {
  return __bitselect_v128__(self as! v128, other as! v128, m as! v128) as U8x16
}

// The bitwise and of the two vectors.
export function and(self: U8x16, o: U8x16): U8x16 {
  return __and_v128__(self as! v128, o as! v128) as U8x16
}

// The bitwise or of the two vectors.
export function or(self: U8x16, o: U8x16): U8x16 {
  return __or_v128__(self as! v128, o as! v128) as U8x16
}

// The bitwise exclusive or of the two vectors.
export function xor(self: U8x16, o: U8x16): U8x16 {
  return __xor_v128__(self as! v128, o as! v128) as U8x16
}

// `self` with every bit that is set in `o` cleared.
export function andNot(self: U8x16, o: U8x16): U8x16 {
  return __andnot_v128__(self as! v128, o as! v128) as U8x16
}

// ── U16x8 ────────────────────────────────────────────────────────────────────

// All 8 lanes set to `x`; only its low 16 bits are kept, so 65536 gives 0.
export function splatU16(x: i32): U16x8 { return __splat_i16x8__(x) as U16x8 }

// The 16 bytes at byte `off` as 8 u16 lanes, little-endian, lane 0 at the lowest address.
// Any `off` works, aligned or not; a read past the end of `self` is not caught.
export function loadU16x8(self: Buf, off: i32): U16x8 {
  return __load_v128__(self.base + off) as U16x8
}

// Write `v`'s 8 lanes as 16 bytes at byte `off`, lane 0 at the lowest address. A write past
// the end of `self` is not caught and lands on whatever is there.
export function storeU16x8(self: Buf, off: i32, v: U16x8) {
  __store_v128__(self.base + off, v as! v128)
}

// `a + b`, lane by lane, wrapping: a lane past 65535 wraps to 0.
export function "+"(self: U16x8, o: U16x8): U16x8 { return self.add(o) }

// `a - b`, lane by lane, wrapping.
export function "-"(self: U16x8, o: U16x8): U16x8 { return self.sub(o) }

// Lane-wise wrapping sum, the method form of `+`.
export function add(self: U16x8, o: U16x8): U16x8 {
  return __add_i16x8__(self as! v128, o as! v128) as U16x8
}

// Lane-wise wrapping difference, the method form of `-`.
export function sub(self: U16x8, o: U16x8): U16x8 {
  return __sub_i16x8__(self as! v128, o as! v128) as U16x8
}

// Lane-wise sum clamped to 0 to 65535: a lane that would overflow stays at the bound.
export function addSat(self: U16x8, o: U16x8): U16x8 {
  return __add_sat_u_i16x8__(self as! v128, o as! v128) as U16x8
}

// Lane-wise difference clamped to 0 to 65535: 3 - 5 gives 0.
export function subSat(self: U16x8, o: U16x8): U16x8 {
  return __sub_sat_u_i16x8__(self as! v128, o as! v128) as U16x8
}

// The smaller of each pair of lanes, read as unsigned u16.
export function min(self: U16x8, o: U16x8): U16x8 {
  return __min_u_i16x8__(self as! v128, o as! v128) as U16x8
}

// The larger of each pair of lanes, read as unsigned u16.
export function max(self: U16x8, o: U16x8): U16x8 {
  return __max_u_i16x8__(self as! v128, o as! v128) as U16x8
}

// Lanes where `self == o`.
export function eq(self: U16x8, o: U16x8): Mask16x8 {
  return __eq_i16x8__(self as! v128, o as! v128) as Mask16x8
}

// Lanes where `self != o`.
export function ne(self: U16x8, o: U16x8): Mask16x8 {
  return __ne_i16x8__(self as! v128, o as! v128) as Mask16x8
}

// Lanes where `self < o`, read as unsigned u16.
export function lt(self: U16x8, o: U16x8): Mask16x8 {
  return __lt_u_i16x8__(self as! v128, o as! v128) as Mask16x8
}

// Lanes where `self <= o`.
export function le(self: U16x8, o: U16x8): Mask16x8 {
  return __le_u_i16x8__(self as! v128, o as! v128) as Mask16x8
}

// Lanes where `self > o`.
export function gt(self: U16x8, o: U16x8): Mask16x8 {
  return __gt_u_i16x8__(self as! v128, o as! v128) as Mask16x8
}

// Lanes where `self >= o`.
export function ge(self: U16x8, o: U16x8): Mask16x8 {
  return __ge_u_i16x8__(self as! v128, o as! v128) as Mask16x8
}

// Lane by lane, `self` where `m` is true and `other` where it is false.
export function select(self: U16x8, m: Mask16x8, other: U16x8): U16x8 {
  return __bitselect_v128__(self as! v128, other as! v128, m as! v128) as U16x8
}

// The bitwise and of the two vectors.
export function and(self: U16x8, o: U16x8): U16x8 {
  return __and_v128__(self as! v128, o as! v128) as U16x8
}

// The bitwise or of the two vectors.
export function or(self: U16x8, o: U16x8): U16x8 {
  return __or_v128__(self as! v128, o as! v128) as U16x8
}

// The bitwise exclusive or of the two vectors.
export function xor(self: U16x8, o: U16x8): U16x8 {
  return __xor_v128__(self as! v128, o as! v128) as U16x8
}

// `self` with every bit that is set in `o` cleared.
export function andNot(self: U16x8, o: U16x8): U16x8 {
  return __andnot_v128__(self as! v128, o as! v128) as U16x8
}

// ── I16x8 ────────────────────────────────────────────────────────────────────

// All 8 lanes set to `x`; only its low 16 bits are kept, so 65536 gives 0.
export function splatI16(x: i32): I16x8 { return __splat_i16x8__(x) as I16x8 }

// The 16 bytes at byte `off` as 8 i16 lanes, little-endian, lane 0 at the lowest address.
// Any `off` works, aligned or not; a read past the end of `self` is not caught.
export function loadI16x8(self: Buf, off: i32): I16x8 {
  return __load_v128__(self.base + off) as I16x8
}

// Write `v`'s 8 lanes as 16 bytes at byte `off`, lane 0 at the lowest address. A write past
// the end of `self` is not caught and lands on whatever is there.
export function storeI16x8(self: Buf, off: i32, v: I16x8) {
  __store_v128__(self.base + off, v as! v128)
}

// `a + b`, lane by lane, wrapping: a lane past 32767 wraps to -32768.
export function "+"(self: I16x8, o: I16x8): I16x8 { return self.add(o) }

// `a - b`, lane by lane, wrapping.
export function "-"(self: I16x8, o: I16x8): I16x8 { return self.sub(o) }

// Lane-wise wrapping sum, the method form of `+`.
export function add(self: I16x8, o: I16x8): I16x8 {
  return __add_i16x8__(self as! v128, o as! v128) as I16x8
}

// Lane-wise wrapping difference, the method form of `-`.
export function sub(self: I16x8, o: I16x8): I16x8 {
  return __sub_i16x8__(self as! v128, o as! v128) as I16x8
}

// Lane-wise sum clamped to -32768 to 32767: a lane that would overflow stays at the bound.
export function addSat(self: I16x8, o: I16x8): I16x8 {
  return __add_sat_s_i16x8__(self as! v128, o as! v128) as I16x8
}

// Lane-wise difference clamped to -32768 to 32767.
export function subSat(self: I16x8, o: I16x8): I16x8 {
  return __sub_sat_s_i16x8__(self as! v128, o as! v128) as I16x8
}

// The smaller of each pair of lanes, read as signed i16.
export function min(self: I16x8, o: I16x8): I16x8 {
  return __min_s_i16x8__(self as! v128, o as! v128) as I16x8
}

// The larger of each pair of lanes, read as signed i16.
export function max(self: I16x8, o: I16x8): I16x8 {
  return __max_s_i16x8__(self as! v128, o as! v128) as I16x8
}

// Lanes where `self == o`.
export function eq(self: I16x8, o: I16x8): Mask16x8 {
  return __eq_i16x8__(self as! v128, o as! v128) as Mask16x8
}

// Lanes where `self != o`.
export function ne(self: I16x8, o: I16x8): Mask16x8 {
  return __ne_i16x8__(self as! v128, o as! v128) as Mask16x8
}

// Lanes where `self < o`, read as signed i16.
export function lt(self: I16x8, o: I16x8): Mask16x8 {
  return __lt_s_i16x8__(self as! v128, o as! v128) as Mask16x8
}

// Lanes where `self <= o`.
export function le(self: I16x8, o: I16x8): Mask16x8 {
  return __le_s_i16x8__(self as! v128, o as! v128) as Mask16x8
}

// Lanes where `self > o`.
export function gt(self: I16x8, o: I16x8): Mask16x8 {
  return __gt_s_i16x8__(self as! v128, o as! v128) as Mask16x8
}

// Lanes where `self >= o`.
export function ge(self: I16x8, o: I16x8): Mask16x8 {
  return __ge_s_i16x8__(self as! v128, o as! v128) as Mask16x8
}

// Lane by lane, `self` where `m` is true and `other` where it is false.
export function select(self: I16x8, m: Mask16x8, other: I16x8): I16x8 {
  return __bitselect_v128__(self as! v128, other as! v128, m as! v128) as I16x8
}

// The bitwise and of the two vectors.
export function and(self: I16x8, o: I16x8): I16x8 {
  return __and_v128__(self as! v128, o as! v128) as I16x8
}

// The bitwise or of the two vectors.
export function or(self: I16x8, o: I16x8): I16x8 {
  return __or_v128__(self as! v128, o as! v128) as I16x8
}

// The bitwise exclusive or of the two vectors.
export function xor(self: I16x8, o: I16x8): I16x8 {
  return __xor_v128__(self as! v128, o as! v128) as I16x8
}

// `self` with every bit that is set in `o` cleared.
export function andNot(self: I16x8, o: I16x8): I16x8 {
  return __andnot_v128__(self as! v128, o as! v128) as I16x8
}

// ── I32x4 ────────────────────────────────────────────────────────────────────

// All four lanes set to `x`.
export function splatI32(x: i32): I32x4 { return __splat_i32x4__(x) as I32x4 }

// The 16 bytes at byte `off` as 4 i32 lanes, little-endian, lane 0 at the lowest address.
// Any `off` works, aligned or not; a read past the end of `self` is not caught.
export function loadI32x4(self: Buf, off: i32): I32x4 {
  return __load_v128__(self.base + off) as I32x4
}

// Write `v`'s 4 lanes as 16 bytes at byte `off`, lane 0 at the lowest address. A write past
// the end of `self` is not caught and lands on whatever is there.
export function storeI32x4(self: Buf, off: i32, v: I32x4) {
  __store_v128__(self.base + off, v as! v128)
}

// `a + b`, lane by lane, wrapping: a lane past its range wraps around, as `i32` arithmetic does.
export function "+"(self: I32x4, o: I32x4): I32x4 { return self.add(o) }

// `a - b`, lane by lane, wrapping.
export function "-"(self: I32x4, o: I32x4): I32x4 { return self.sub(o) }

// Lane-wise wrapping sum, the method form of `+`.
export function add(self: I32x4, o: I32x4): I32x4 {
  return __add_i32x4__(self as! v128, o as! v128) as I32x4
}

// Lane-wise wrapping difference, the method form of `-`.
export function sub(self: I32x4, o: I32x4): I32x4 {
  return __sub_i32x4__(self as! v128, o as! v128) as I32x4
}

// The smaller of each pair of lanes, read as signed i32.
export function min(self: I32x4, o: I32x4): I32x4 {
  return __min_s_i32x4__(self as! v128, o as! v128) as I32x4
}

// The larger of each pair of lanes, read as signed i32.
export function max(self: I32x4, o: I32x4): I32x4 {
  return __max_s_i32x4__(self as! v128, o as! v128) as I32x4
}

// Lanes where `self == o`.
export function eq(self: I32x4, o: I32x4): Mask32x4 {
  return __eq_i32x4__(self as! v128, o as! v128) as Mask32x4
}

// Lanes where `self != o`.
export function ne(self: I32x4, o: I32x4): Mask32x4 {
  return __ne_i32x4__(self as! v128, o as! v128) as Mask32x4
}

// Lanes where `self < o`, read as signed i32.
export function lt(self: I32x4, o: I32x4): Mask32x4 {
  return __lt_s_i32x4__(self as! v128, o as! v128) as Mask32x4
}

// Lanes where `self <= o`.
export function le(self: I32x4, o: I32x4): Mask32x4 {
  return __le_s_i32x4__(self as! v128, o as! v128) as Mask32x4
}

// Lanes where `self > o`.
export function gt(self: I32x4, o: I32x4): Mask32x4 {
  return __gt_s_i32x4__(self as! v128, o as! v128) as Mask32x4
}

// Lanes where `self >= o`.
export function ge(self: I32x4, o: I32x4): Mask32x4 {
  return __ge_s_i32x4__(self as! v128, o as! v128) as Mask32x4
}

// Lane by lane, `self` where `m` is true and `other` where it is false.
export function select(self: I32x4, m: Mask32x4, other: I32x4): I32x4 {
  return __bitselect_v128__(self as! v128, other as! v128, m as! v128) as I32x4
}

// The bitwise and of the two vectors.
export function and(self: I32x4, o: I32x4): I32x4 {
  return __and_v128__(self as! v128, o as! v128) as I32x4
}

// The bitwise or of the two vectors.
export function or(self: I32x4, o: I32x4): I32x4 {
  return __or_v128__(self as! v128, o as! v128) as I32x4
}

// The bitwise exclusive or of the two vectors.
export function xor(self: I32x4, o: I32x4): I32x4 {
  return __xor_v128__(self as! v128, o as! v128) as I32x4
}

// `self` with every bit that is set in `o` cleared.
export function andNot(self: I32x4, o: I32x4): I32x4 {
  return __andnot_v128__(self as! v128, o as! v128) as I32x4
}

// ── widen and narrow ─────────────────────────────────────────────────────────

// Lanes 0 to 7 as eight u16 lanes, each value unchanged.
export function widenLow(self: U8x16): U16x8 {
  return __extend_low_i8x16_u__(self as! v128) as U16x8
}

// Lanes 8 to 15 as eight u16 lanes, each value unchanged.
export function widenHigh(self: U8x16): U16x8 {
  return __extend_high_i8x16_u__(self as! v128) as U16x8
}

// Lanes 0 to 3 as four i32 lanes, each value unchanged (so 65535 stays 65535).
export function widenLow(self: U16x8): I32x4 {
  return __extend_low_i16x8_u__(self as! v128) as I32x4
}

// Lanes 4 to 7 as four i32 lanes, each value unchanged.
export function widenHigh(self: U16x8): I32x4 {
  return __extend_high_i16x8_u__(self as! v128) as I32x4
}

// Lanes 0 to 3 as four i32 lanes, sign kept (so -1 stays -1).
export function widenLow(self: I16x8): I32x4 {
  return __extend_low_i16x8_s__(self as! v128) as I32x4
}

// Lanes 4 to 7 as four i32 lanes, sign kept.
export function widenHigh(self: I16x8): I32x4 {
  return __extend_high_i16x8_s__(self as! v128) as I32x4
}

// `self`'s eight lanes then `o`'s as 16 u8 lanes, each clamped to 0 to 255: -7 gives 0 and
// 300 gives 255.
export function narrowSatToU8x16(self: I16x8, o: I16x8): U8x16 {
  return __narrow_i16x8_u__(self as! v128, o as! v128) as U8x16
}

// `self`'s eight lanes then `o`'s as 16 u8 lanes, each clamped to at most 255.
export function narrowSatToU8x16(self: U16x8, o: U16x8): U8x16 {
  const cap = __splat_i16x8__(255)
  const a = __min_u_i16x8__(self as! v128, cap)
  const b = __min_u_i16x8__(o as! v128, cap)
  return __narrow_i16x8_u__(a, b) as U8x16
}

// `self`'s four lanes then `o`'s as eight i16 lanes, each clamped to -32768 to 32767.
export function narrowSatToI16x8(self: I32x4, o: I32x4): I16x8 {
  return __narrow_i32x4_s__(self as! v128, o as! v128) as I16x8
}

// `self`'s four lanes then `o`'s as eight u16 lanes, each clamped to 0 to 65535.
export function narrowSatToU16x8(self: I32x4, o: I32x4): U16x8 {
  return __narrow_i32x4_u__(self as! v128, o as! v128) as U16x8
}

// ── Mask8x16 ─────────────────────────────────────────────────────────────────

// Lanes true in both masks.
export function and(self: Mask8x16, o: Mask8x16): Mask8x16 {
  return __and_v128__(self as! v128, o as! v128) as Mask8x16
}

// Lanes true in either mask.
export function or(self: Mask8x16, o: Mask8x16): Mask8x16 {
  return __or_v128__(self as! v128, o as! v128) as Mask8x16
}

// Lanes true in exactly one of the masks.
export function xor(self: Mask8x16, o: Mask8x16): Mask8x16 {
  return __xor_v128__(self as! v128, o as! v128) as Mask8x16
}

// Lanes true in `self` and false in `o`.
export function andNot(self: Mask8x16, o: Mask8x16): Mask8x16 {
  return __andnot_v128__(self as! v128, o as! v128) as Mask8x16
}

// Every lane flipped.
export function not(self: Mask8x16): Mask8x16 {
  return __not_v128__(self as! v128) as Mask8x16
}

// Whether any lane is true.
export function anyTrue(self: Mask8x16): boolean {
  return __any_true_v128__(self as! v128) != 0
}

// Whether every lane is true.
export function allTrue(self: Mask8x16): boolean {
  return __all_true_i8x16__(self as! v128) != 0
}

// One bit per lane, lane 0 in bit 0, so a 16-lane mask gives 0 to 65535; `popcnt` of it
// counts the true lanes.
export function bitmask(self: Mask8x16): i32 {
  return __bitmask_i8x16__(self as! v128)
}

// ── Mask16x8 ─────────────────────────────────────────────────────────────────

// Lanes true in both masks.
export function and(self: Mask16x8, o: Mask16x8): Mask16x8 {
  return __and_v128__(self as! v128, o as! v128) as Mask16x8
}

// Lanes true in either mask.
export function or(self: Mask16x8, o: Mask16x8): Mask16x8 {
  return __or_v128__(self as! v128, o as! v128) as Mask16x8
}

// Lanes true in exactly one of the masks.
export function xor(self: Mask16x8, o: Mask16x8): Mask16x8 {
  return __xor_v128__(self as! v128, o as! v128) as Mask16x8
}

// Lanes true in `self` and false in `o`.
export function andNot(self: Mask16x8, o: Mask16x8): Mask16x8 {
  return __andnot_v128__(self as! v128, o as! v128) as Mask16x8
}

// Every lane flipped.
export function not(self: Mask16x8): Mask16x8 {
  return __not_v128__(self as! v128) as Mask16x8
}

// Whether any lane is true.
export function anyTrue(self: Mask16x8): boolean {
  return __any_true_v128__(self as! v128) != 0
}

// Whether every lane is true.
export function allTrue(self: Mask16x8): boolean {
  return __all_true_i16x8__(self as! v128) != 0
}

// One bit per lane, lane 0 in bit 0, so an 8-lane mask gives 0 to 255; `popcnt` of it
// counts the true lanes.
export function bitmask(self: Mask16x8): i32 {
  return __bitmask_i16x8__(self as! v128)
}

// ── Mask32x4 ─────────────────────────────────────────────────────────────────

// Lanes true in both masks.
export function and(self: Mask32x4, o: Mask32x4): Mask32x4 {
  return __and_v128__(self as! v128, o as! v128) as Mask32x4
}

// Lanes true in either mask.
export function or(self: Mask32x4, o: Mask32x4): Mask32x4 {
  return __or_v128__(self as! v128, o as! v128) as Mask32x4
}

// Lanes true in exactly one of the masks.
export function xor(self: Mask32x4, o: Mask32x4): Mask32x4 {
  return __xor_v128__(self as! v128, o as! v128) as Mask32x4
}

// Lanes true in `self` and false in `o`.
export function andNot(self: Mask32x4, o: Mask32x4): Mask32x4 {
  return __andnot_v128__(self as! v128, o as! v128) as Mask32x4
}

// Every lane flipped.
export function not(self: Mask32x4): Mask32x4 {
  return __not_v128__(self as! v128) as Mask32x4
}

// Whether any lane is true.
export function anyTrue(self: Mask32x4): boolean {
  return __any_true_v128__(self as! v128) != 0
}

// Whether every lane is true.
export function allTrue(self: Mask32x4): boolean {
  return __all_true_i32x4__(self as! v128) != 0
}

// One bit per lane, lane 0 in bit 0, so a 4-lane mask gives 0 to 15; `popcnt` of it
// counts the true lanes.
export function bitmask(self: Mask32x4): i32 {
  return __bitmask_i32x4__(self as! v128)
}
