// `std:utf8` — turning VL strings into UTF-8 byte lists, and back.
//
//     import { encodeUtf8, decodeUtf8, decodeUtf8Lossy, Utf8Error } from "std:utf8"
//
// Encoding is total and never repairs. Decoding is STRICT by default: an
// ill-formed sequence is an error, not a silent replacement character — reach
// for `decodeUtf8Lossy` when rendering something beats stopping. No UTF-16, no
// other encodings, no byte-order-mark handling and no normalization.

import { toString } from "std:fmt"

// Why a decode failed. `at` is a byte offset RELATIVE to the `off` handed in,
// so it stays meaningful over a slice and is also the length of the valid
// prefix; `byte` is the lead byte that failed; `msg` is prose for a human.
export type Utf8Error = { at: i32, byte: i32, msg: string }

// U+FFFD, the character `decodeUtf8Lossy` substitutes.
const REPLACEMENT = 0xFFFD

// The number of bytes `self.encodeUtf8()` produces. O(1): a VL string already
// IS its own UTF-8 encoding.
export function utf8Length(self: string) { self.length }

// `self` as a fresh, mutable list of UTF-8 byte values. Cannot fail and never
// repairs: a string holding ill-formed bytes round-trips through
// `encodeUtf8`/`decodeUtf8` as itself.
export function encodeUtf8(self: string): u8[] { return self.bytes() }

// The one decode loop; `lossy` picks which of the two public spellings it is
// serving, so they cannot disagree about what ill-formed means.
function decodeCore(
  self: u8[],
  off: i32,
  len: i32,
  lossy: boolean,
): string | Utf8Error {
  const cps: i32[] = []
  let i = 0
  while i < len {
    const b0 = self[off + i]
    // The lead byte gives the sequence length, and the tighter bounds the FIRST
    // continuation byte must satisfy; every later one is the plain 0x80..0xBF.
    let size = 0
    let cp = 0
    let lo = 0x80
    let hi = 0xBF
    if b0 < 0x80 {
      size = 1
      cp = b0
    } else if b0 >= 0xC2 && b0 <= 0xDF {
      size = 2
      cp = b0 & 0x1F
    } else if b0 >= 0xE0 && b0 <= 0xEF {
      size = 3
      cp = b0 & 0x0F
      if b0 == 0xE0 { lo = 0xA0 }
      if b0 == 0xED { hi = 0x9F }
    } else if b0 >= 0xF0 && b0 <= 0xF4 {
      size = 4
      cp = b0 & 0x07
      if b0 == 0xF0 { lo = 0x90 }
      if b0 == 0xF4 { hi = 0x8F }
    }
    // `good` is the maximal valid subpart and never less than 1 — what the lossy
    // path advances by, so one bad sequence yields one U+FFFD and cannot stall.
    let ok = size > 0
    let good = 1
    let k = 1
    while ok && k < size {
      if i + k >= len {
        ok = false
      } else {
        const b = self[off + i + k]
        let blo = 0x80
        let bhi = 0xBF
        if k == 1 {
          blo = lo
          bhi = hi
        }
        if b < blo || b > bhi {
          ok = false
        } else {
          cp = (cp << 6) | (b & 0x3F)
          good = good + 1
        }
      }
      k = k + 1
    }
    if ok {
      cps.push(cp)
      i = i + size
    } else if lossy {
      cps.push(REPLACEMENT)
      i = i + good
    } else {
      return {
        at: i,
        byte: b0,
        msg: "invalid UTF-8: byte " + toString(b0) + " at offset " + toString(i),
      }
    }
  }
  fromCodePoints(cps)
}

// The whole array as a string, or a `Utf8Error` locating the first ill-formed
// sequence. Overlong forms, surrogates, values past U+10FFFF and truncated
// tails are all refused.
export function decodeUtf8(self: u8[]): string | Utf8Error {
  decodeCore(self, 0, self.length, false)
}

// The same over one range, so a caller splitting a byte block into records can
// attribute a failure to the RECORD rather than to the block.
export function decodeUtf8At(
  self: u8[],
  off: i32,
  len: i32,
): string | Utf8Error {
  decodeCore(self, off, len, false)
}

// The whole array with one U+FFFD per MAXIMAL ill-formed subpart, which is the
// WHATWG rule. Total — no input is rejected — and the result is guaranteed
// well-formed UTF-8, the original bytes gone. Use `decodeUtf8` to find out.
export function decodeUtf8Lossy(self: u8[]) {
  const r = decodeCore(self, 0, self.length, true)
  // Unreachable: the lossy path substitutes rather than failing.
  if r is Utf8Error {
    __trap__(
      "internal error in std:utf8: the lossy decode rejected an input it must accept; please report",
    )
    return ""
  }
  r
}
