// `std:fmt` — rendering numbers as text, and parsing them back.
//
//     import { toString, parseI32, parseI64, parseF64 } from "std:fmt"
//
// `toString`'s domain is exactly `i32 | i64 | boolean | f64`, and it is this
// module's export rather than a builtin — a file that declares its own
// `toString` cannot also import this one. The float style is ECMAScript's, so
// `print(x.toString())` and `print(x)` agree. `join`, `repeat` and `split` are
// re-exported from `std:str`. No `f32`, no radix but ten, no unsigned parser.

import { padStart } from "std:str"

// The string surface, re-exported from its owner: these ARE `std:str`'s
// functions, not second copies, so importing `split` from either reaches one
// implementation.
export { join, repeat, split } from "std:str"

// A decimal digit value as its character. It takes an i64 so both integer
// widths share one renderer.
function digitChar(d: i64) {
  if d == 0 { return "0" }
  if d == 1 { return "1" }
  if d == 2 { return "2" }
  if d == 3 { return "3" }
  if d == 4 { return "4" }
  if d == 5 { return "5" }
  if d == 6 { return "6" }
  if d == 7 { return "7" }
  if d == 8 { return "8" }
  "9"
}

// Decimal rendering of any i64, i64 min included: the accumulator works in the
// NEGATIVE range, which is the half wide enough to hold it.
function renderI64(n: i64) {
  if n == 0 { return "0" }
  const zero: i64 = 0
  let m = n
  if m > 0 { m = zero - m }
  let out = ""
  while m < 0 {
    out = digitChar(zero - (m % 10)) + out
    m = m / 10
  }
  if n < 0 { out = "-" + out }
  out
}

// The decimal rendering of `self`: `n.toString()` over an i32, an i64, an f64
// or a boolean. Floats follow ECMAScript's `Number::toString` — the shortest
// text that reads back as the same value — with `"NaN"`, `"Infinity"` and
// `"-Infinity"` for the specials, and `"0"` for both zeros.
export function toString(self: i32 | i64 | boolean | f64) {
  if self is boolean {
    if self { return "true" }
    return "false"
  }
  if self is i32 {
    const wide: i64 = self
    return renderI64(wide)
  }
  if self is f64 { return renderF64(self) }
  return renderI64(self)
}

// This module's older spelling of `std:str`'s `padStart`: pad `self` on the left
// with `fill` up to `width`, tiling and cutting a multi-character `fill` so the
// result is exactly `width` wide, and never truncating `self`. New code should
// reach for `padStart`, which has a `padEnd` twin that this name does not.
export function padLeft(self: string, width: i32, fill: string) {
  return padStart(self, width, fill)
}

// ── text → integer ───────────────────────────────────────────────────────────

// The grammar is `"-"? digit+` and nothing else. Leading zeros are accepted; a
// leading "+", whitespace, `"1.0"` and `"1e3"` are not, so this is a strict
// subset of `parseF64`'s grammar and choosing between them is a choice of TYPE
// and never of dialect. `"-0"` is zero: an integer has no signed zero.

// i64's bounds. i64 min is spelled as max-minus-one because it has no decimal
// literal of its own — the minus would apply after the magnitude overflowed.
const I64_MAX: i64 = 9223372036854775807
const I64_MIN: i64 = -9223372036854775807 - 1
// The largest magnitude the accumulator may already hold and still survive a
// multiply by ten.
const I64_MIN_DIV10: i64 = -922337203685477580
// i32's bounds, held WIDE: they are compared against an i64 accumulator, which
// is what lets `parseI32` reject before it truncates.
const I32_MAX_WIDE: i64 = 2147483647
const I32_MIN_WIDE: i64 = -2147483648

// The integer `self` spells, or `null` when it is not one in this grammar or
// denotes one outside `lo`..=`hi`. `lo <= 0 <= hi` is a PRECONDITION: each sign
// is checked against one bound only, so a range not containing zero is not
// enforced. Both callers here straddle zero.
function parseBoundedInt(self: string, lo: i64, hi: i64): i64 | null {
  const n = self.length
  if n == 0 { return null }
  let i = 0
  let neg = false
  // Only "-": a leading "+" is not in this grammar and falls through to the digit
  // loop, which refuses it.
  if self[0] == 45 {
    neg = true
    i = 1
  }
  if i >= n { return null }

  // Held NEGATED, so `"-9223372036854775808"` is an ordinary intermediate and the
  // magnitude that would overflow never has to exist.
  let acc: i64 = 0
  while i < n {
    const c = self[i]
    if c < 48 || c > 57 { return null }
    const d: i64 = c - 48
    // Guard, THEN multiply: below this floor the product leaves i64 entirely.
    if acc < I64_MIN_DIV10 { return null }
    acc = acc * 10
    // Guard, THEN subtract; the comparison's own arithmetic stays in range.
    if acc < I64_MIN + d { return null }
    acc = acc - d
    i = i + 1
  }

  if neg {
    if acc < lo { return null }
    return acc
  }
  // `0 - acc` is safe only after this test, because `acc` may be i64 min.
  if acc < 0 - hi { return null }
  0 - acc
}

// The i64 the decimal integer `self` spells, or `null` when `self` is not one
// or does not fit. Out of range is `null` too: for an integer, "out of range"
// and "not a number of this type" are the same statement — wrapping would be a
// silently wrong value and saturating would forge one.
export function parseI64(self: string): i64 | null {
  parseBoundedInt(self, I64_MIN, I64_MAX)
}

// The i32 the decimal integer `self` spells, or `null` when `self` is not one
// or does not fit in 32 bits. Same grammar as `parseI64`; `"2147483648"` and
// `"-2147483649"` are `null` rather than wrapped.
export function parseI32(self: string): i32 | null {
  const v = parseBoundedInt(self, I32_MIN_WIDE, I32_MAX_WIDE)
  if v is null { return null }
  // The bounds above already refused everything outside i32, so this narrowing is
  // provably lossless.
  v as! i32
}

// ── f64 ↔ text ───────────────────────────────────────────────────────────────

// The style is ECMAScript `Number::toString`, radix 10. Everything from here to
// `renderF64` is the exact arithmetic it needs: big naturals held as 32-bit
// limbs in an `i64[]`, so a limb times a multiplier of at most 10^9 still fits.
// High zero limbs are left in place, so every operation reads to the highest
// non-zero limb rather than to `.length`.
const BN_MASK: i64 = 4294967295

// The number of limbs that carry value. Zero has length 0.
function bnLen(a: i64[]): i32 {
  let i = a.length - 1
  while i >= 0 && a[i] == 0 { i = i - 1 }
  i + 1
}

function bnIsZero(a: i64[]): boolean { bnLen(a) == 0 }

// A fresh big natural holding `v`, which must not be negative.
function bnFromI64(v: i64): i64[] {
  const out: i64[] = []
  let x = v
  while x > 0 {
    out.push(x & BN_MASK)
    x = x >>> 32
  }
  out
}

function bnCopy(a: i64[]): i64[] {
  const out: i64[] = []
  let i = 0
  while i < a.length {
    out.push(a[i])
    i = i + 1
  }
  out
}

// -1, 0 or 1 as `a` is less than, equal to, or greater than `b`.
function bnCmp(a: i64[], b: i64[]): i32 {
  const la = bnLen(a)
  const lb = bnLen(b)
  if la != lb {
    if la < lb { return -1 }
    return 1
  }
  let i = la - 1
  while i >= 0 {
    if a[i] != b[i] {
      if a[i] < b[i] { return -1 }
      return 1
    }
    i = i - 1
  }
  0
}

// `a += b`, in place.
function bnAddInto(a: i64[], b: i64[]) {
  let carry: i64 = 0
  let i = 0
  while i < b.length || carry != 0 {
    if i >= a.length { a.push(0) }
    let s = a[i] + carry
    if i < b.length { s = s + b[i] }
    a[i] = s & BN_MASK
    carry = s >>> 32
    i = i + 1
  }
}

// `a -= b`, in place. The caller guarantees `a >= b`; a smaller `a` borrows off
// the top and answers garbage rather than trapping.
function bnSubInto(a: i64[], b: i64[]) {
  let borrow: i64 = 0
  let i = 0
  while i < a.length {
    let d = a[i] - borrow
    if i < b.length { d = d - b[i] }
    if d < 0 {
      d = d + 4294967296
      borrow = 1
    } else {
      borrow = 0
    }
    a[i] = d
    i = i + 1
  }
}

// `a *= m`, in place. `m` must be at most 10^9 — see the limb-width note above.
function bnMulSmall(a: i64[], m: i64) {
  let carry: i64 = 0
  let i = 0
  while i < a.length {
    const p = a[i] * m + carry
    a[i] = p & BN_MASK
    carry = p >>> 32
    i = i + 1
  }
  while carry != 0 {
    a.push(carry & BN_MASK)
    carry = carry >>> 32
  }
}

// 10^n for n in 0..=18.
function pow10i64(n: i32): i64 {
  let p: i64 = 1
  let i = 0
  while i < n {
    p = p * 10
    i = i + 1
  }
  p
}

// `a *= 10^k`, in place, in 10^9 chunks so each limb product stays in range.
function bnMulPow10(a: i64[], k: i32) {
  if bnIsZero(a) { return }
  let n = k
  while n >= 9 {
    bnMulSmall(a, 1000000000)
    n = n - 9
  }
  if n > 0 { bnMulSmall(a, pow10i64(n)) }
}

// `a <<= bits`, in place.
function bnShlInto(a: i64[], bits: i32) {
  if bnIsZero(a) { return }
  const whole = bits / 32
  const rem = bits % 32
  if rem > 0 {
    let carry: i64 = 0
    let i = 0
    while i < a.length {
      const v = (a[i] << rem) | carry
      a[i] = v & BN_MASK
      carry = v >>> 32
      i = i + 1
    }
    if carry != 0 { a.push(carry) }
  }
  if whole > 0 {
    let j = 0
    while j < whole {
      a.push(0)
      j = j + 1
    }
    let i = a.length - 1
    while i >= whole {
      a[i] = a[i - whole]
      i = i - 1
    }
    let z = 0
    while z < whole {
      a[z] = 0
      z = z + 1
    }
  }
}

// `a >>= 1`, in place.
function bnShr1(a: i64[]) {
  let i = a.length - 1
  let carry: i64 = 0
  while i >= 0 {
    const v = a[i] | (carry << 32)
    a[i] = v >>> 1
    carry = v & 1
    i = i - 1
  }
}

function bnBitLen(a: i64[]): i32 {
  const n = bnLen(a)
  if n == 0 { return 0 }
  return (n - 1) * 32 + ((64 - clz(a[n - 1])) as! i32)
}

// The big natural spelled by `d`, a list of decimal digit VALUES (0..=9).
function bnFromDigits(d: i32[]): i64[] {
  const out = bnFromI64(0)
  let i = 0
  while i < d.length {
    let chunk: i64 = 0
    let c = 0
    while c < 9 && i < d.length {
      const dv: i64 = d[i]
      chunk = chunk * 10 + dv
      i = i + 1
      c = c + 1
    }
    bnMulSmall(out, pow10i64(c))
    bnAddInto(out, bnFromI64(chunk))
  }
  out
}

// floor(a / b), leaving the exact remainder in `a`. Shift-and-subtract from the
// top, so the loop runs once per QUOTIENT bit.
function bnDivMod(a: i64[], b: i64[]): i64 {
  if bnCmp(a, b) < 0 { return 0 }
  const shift = bnBitLen(a) - bnBitLen(b)
  const d = bnCopy(b)
  bnShlInto(d, shift)
  let q: i64 = 0
  let i = shift
  while i >= 0 {
    q = q << 1
    if bnCmp(a, d) >= 0 {
      bnSubInto(a, d)
      q = q + 1
    }
    bnShr1(d)
    i = i - 1
  }
  q
}

// ── f64 → text ───────────────────────────────────────────────────────────────

// The shortest digit string that identifies a value, with the exponent that
// places it: value = 0.d[0]d[1]… × 10^n.
type DecDigits = { d: i32[], n: i32 }

// `r + mp` against `s`, with the comparison inclusive when the significand is
// even — round-to-nearest-even hands an even significand its own boundaries.
function upperTest(r: i64[], mp: i64[], s: i64[], inclusive: boolean): boolean {
  const t = bnCopy(r)
  bnAddInto(t, mp)
  const c = bnCmp(t, s)
  if inclusive { return c >= 0 }
  c > 0
}

// Burger–Dybvig over exact rationals; `x` must be finite and strictly positive.
// The value is held as R/S with its two half-ulp boundaries, all exact, and
// digits are generated until the emitted prefix already identifies the value
// uniquely — so no digit is emitted that the interval does not force.
function shortestDigits(x: f64): DecDigits {
  const bits = f64bits(x)
  const be = ((bits >>> 52) & 2047) as! i32
  const frac = bits & 4503599627370495
  let m = frac
  let e = -1074
  if be != 0 {
    m = frac + 4503599627370496
    e = be - 1075
  }
  const evenB = (m & 1) == 0
  // The gap BELOW is half the gap above exactly at the bottom of a binade with a
  // binade beneath it. Get this wrong and powers of two render one digit long.
  const smaller = frac == 0 && be > 1

  const r = bnFromI64(m)
  const s = bnFromI64(1)
  const mp = bnFromI64(1)
  const mm = bnFromI64(1)
  if e >= 0 {
    if smaller {
      bnShlInto(r, e + 2)
      bnShlInto(s, 2)
      bnShlInto(mp, e + 1)
      bnShlInto(mm, e)
    } else {
      bnShlInto(r, e + 1)
      bnShlInto(s, 1)
      bnShlInto(mp, e)
      bnShlInto(mm, e)
    }
  } else {
    if smaller {
      bnShlInto(r, 2)
      bnShlInto(s, 2 - e)
      bnShlInto(mp, 1)
    } else {
      bnShlInto(r, 1)
      bnShlInto(s, 1 - e)
    }
  }

  // `n` is the smallest integer with value + M+ ≤ 10^n. The estimate is biased
  // LOW, so the fixup below only ever climbs and stops at the minimal one.
  const bl = 64 - (clz(m) as! i32)
  let k = ((floor(((bl + e - 1) as! f64) * 0.3010299956639812)) as! i32) - 1
  if k >= 0 {
    bnMulPow10(s, k)
  } else {
    bnMulPow10(r, 0 - k)
    bnMulPow10(mp, 0 - k)
    bnMulPow10(mm, 0 - k)
  }
  while upperTest(r, mp, s, evenB) {
    bnMulSmall(s, 10)
    k = k + 1
  }

  // One digit per turn, stopping as soon as the interval no longer needs another;
  // when both boundaries are reached at once, the closer digit wins with the
  // spec's even tie-break. The 25-digit bound is a floor, not a policy: a double
  // never needs more than 17.
  const digits: i32[] = []
  let done = false
  while !done && digits.length < 25 {
    bnMulSmall(r, 10)
    bnMulSmall(mp, 10)
    bnMulSmall(mm, 10)
    let d = 0
    while bnCmp(r, s) >= 0 {
      bnSubInto(r, s)
      d = d + 1
    }
    const cLow = bnCmp(r, mm)
    let low = cLow < 0
    if evenB { low = cLow <= 0 }
    const high = upperTest(r, mp, s, evenB)
    if low && high {
      const t = bnCopy(r)
      bnMulSmall(t, 2)
      const c = bnCmp(t, s)
      if c > 0 { d = d + 1 }
      else if c == 0 && (d % 2) != 0 { d = d + 1 }
      digits.push(d)
      done = true
    } else if low {
      digits.push(d)
      done = true
    } else if high {
      digits.push(d + 1)
      done = true
    } else {
      digits.push(d)
    }
  }

  // A terminating `d + 1` can carry out of 9. The scaling should make this
  // unreachable; it is handled anyway, because the alternative is a wrong digit.
  let ci = digits.length - 1
  let carrying = true
  while carrying && ci >= 0 {
    if digits[ci] != 10 {
      carrying = false
    } else {
      digits[ci] = 0
      if ci == 0 {
        digits[0] = 1
        k = k + 1
        carrying = false
      } else {
        digits[ci - 1] = digits[ci - 1] + 1
        ci = ci - 1
      }
    }
  }
  while digits.length > 1 && digits[digits.length - 1] == 0 { digits.pop() }

  { d: digits, n: k }
}

// The four-way layout of ECMA-262 `Number::toString` over a digit list and its
// exponent: the digits then trailing zeros, a radix point inside them, a
// leading `"0."` run, or exponential form with an always-signed exponent. The
// specials belong to `renderF64`.
function layoutDec(d: i32[], n: i32): string {
  const k = d.length
  const buf: i32[] = []
  if k <= n && n <= 21 {
    let i = 0
    while i < k {
      buf.push(48 + d[i])
      i = i + 1
    }
    let z = 0
    while z < n - k {
      buf.push(48)
      z = z + 1
    }
    return fromCodePoints(buf)
  }
  if n > 0 && n <= 21 {
    let i = 0
    while i < n {
      buf.push(48 + d[i])
      i = i + 1
    }
    buf.push(46)
    while i < k {
      buf.push(48 + d[i])
      i = i + 1
    }
    return fromCodePoints(buf)
  }
  if n > -6 && n <= 0 {
    buf.push(48)
    buf.push(46)
    let z = 0
    while z < 0 - n {
      buf.push(48)
      z = z + 1
    }
    let i = 0
    while i < k {
      buf.push(48 + d[i])
      i = i + 1
    }
    return fromCodePoints(buf)
  }
  buf.push(48 + d[0])
  if k > 1 {
    buf.push(46)
    let i = 1
    while i < k {
      buf.push(48 + d[i])
      i = i + 1
    }
  }
  const ex = n - 1
  if ex >= 0 {
    const up: i64 = ex
    return fromCodePoints(buf) + "e+" + renderI64(up)
  }
  const down: i64 = 0 - ex
  fromCodePoints(buf) + "e-" + renderI64(down)
}

// `toString`'s f64 arm. The sign is read off the BIT PATTERN, because `-0.0 <
// 0.0` is false. NaN renders `"NaN"`, the infinities `"Infinity"` and
// `"-Infinity"`, and both zeros `"0"` — so `-0` is the one finite value that
// does not survive a round trip through text.
function renderF64(x: f64): string {
  const bits = f64bits(x)
  const be = ((bits >>> 52) & 2047) as! i32
  const frac = bits & 4503599627370495
  if be == 2047 {
    if frac != 0 { return "NaN" }
    if bits < 0 { return "-Infinity" }
    return "Infinity"
  }
  // Both zeros render "0", which is the spec's rule.
  if be == 0 && frac == 0 { return "0" }
  const dd = shortestDigits(abs(x))
  const body = layoutDec(dd.d, dd.n)
  if bits < 0 { return "-" + body }
  body
}

// ── text → f64 ───────────────────────────────────────────────────────────────
const ONE64: i64 = 1
// Spelled as a shift, because i64 min has no decimal literal.
const SIGN_BIT: i64 = ONE64 << 63
const BITS_INF: i64 = 9218868437227405312
const BITS_NAN: i64 = 9221120237041090560
const TWO53: i64 = 9007199254740992
// Enough significant digits to separate any decimal from a double's rounding
// boundary, with slack. Without a cap a megabyte of digits would be a megabyte
// of big integer, which is a denial-of-service surface for a JSON reader.
const MAX_SIG_DIGITS = 800

function withSign(v: f64, neg: boolean): f64 {
  if neg { return f64fromBits(f64bits(v) | SIGN_BIT) }
  v
}

function isDigitByte(c: i32): boolean { c >= 48 && c <= 57 }

// 10^e exactly, for e in 0..=22 — the range over which a power of ten is
// representable as an f64. Callers must not exceed 22.
function pow10f(e: i32): f64 {
  let p = 1.0
  let i = 0
  while i < e {
    p = p * 10.0
    i = i + 1
  }
  p
}

// The f64 nearest to the number `self` spells, or `null` when `self` is not one:
// the grammar is JSON's plus `"Infinity"` and `"NaN"`, so `"+1"`, `"1."`,
// `".5"`, `"0x10"`, whitespace and digit separators are refused. Out of range
// is NOT a failure — overflow answers ±Infinity, underflow ±0. Correctly rounded.
export function parseF64(self: string): f64 | null {
  const n = self.length
  if n == 0 { return null }
  let i = 0
  let neg = false
  if self[0] == 45 {
    neg = true
    i = 1
  }
  if i >= n { return null }
  const c0 = self[i]
  if c0 == 73 {
    if self.slice(i, n) != "Infinity" { return null }
    return withSign(f64fromBits(BITS_INF), neg)
  }
  if c0 == 78 {
    // "NaN" only, unsigned: the renderer never puts a sign on it and VL has no such
    // literal.
    if neg { return null }
    if self != "NaN" { return null }
    return f64fromBits(BITS_NAN)
  }

  // `digs` collects SIGNIFICANT digits and `exp10` is the power of ten they are
  // multiplied by; `truncated` records a non-zero digit dropped past the cap.
  const digs: i32[] = []
  let exp10 = 0
  let truncated = false
  const istart = i
  while i < n && isDigitByte(self[i]) {
    const d = self[i] - 48
    // A LEADING zero of the integer part is neither a significant digit nor a place,
    // so `"007"` is `7` with the exponent untouched.
    if digs.length > 0 || d != 0 {
      if digs.length < MAX_SIG_DIGITS {
        digs.push(d)
      } else {
        exp10 = exp10 + 1
        if d != 0 { truncated = true }
      }
    }
    i = i + 1
  }
  if i == istart { return null }
  if i < n && self[i] == 46 {
    i = i + 1
    const fstart = i
    while i < n && isDigitByte(self[i]) {
      const d = self[i] - 48
      // Every fraction digit is a place, leading zeros included. Past the cap the
      // place is already accounted for, so only truncation is recorded.
      if digs.length >= MAX_SIG_DIGITS {
        if d != 0 { truncated = true }
      } else {
        if digs.length > 0 || d != 0 { digs.push(d) }
        exp10 = exp10 - 1
      }
      i = i + 1
    }
    if i == fstart { return null }
  }
  if i < n && (self[i] == 101 || self[i] == 69) {
    i = i + 1
    let es = 1
    if i < n && self[i] == 43 {
      i = i + 1
    } else if i < n && self[i] == 45 {
      es = -1
      i = i + 1
    }
    const estart = i
    let ev = 0
    while i < n && isDigitByte(self[i]) {
      if ev < 1000000 { ev = ev * 10 + (self[i] - 48) }
      i = i + 1
    }
    if i == estart { return null }
    exp10 = exp10 + es * ev
  }
  // Trailing anything — a unit, whitespace, a stray separator — is a rejection
  // rather than a partial parse.
  if i != n { return null }

  if digs.length == 0 { return withSign(0.0, neg) }
  // The magnitude gate, before any big integer exists: the largest f64 is under
  // 10^309 and anything below 10^-350 is far under half the smallest subnormal.
  const dmag = exp10 + digs.length
  if dmag > 310 { return withSign(f64fromBits(BITS_INF), neg) }
  if dmag < -350 { return withSign(0.0, neg) }

  // Clinger's fast path: with both operands exactly representable, one IEEE
  // multiply or divide is one correct rounding. It covers most human-written
  // numbers; everything else falls to the exact path below.
  if digs.length <= 15 && exp10 >= -22 && exp10 <= 22 {
    let acc: i64 = 0
    let j = 0
    while j < digs.length {
      const dv: i64 = digs[j]
      acc = acc * 10 + dv
      j = j + 1
    }
    let v = acc as! f64
    if exp10 > 0 { v = v * pow10f(exp10) }
    if exp10 < 0 { v = v / pow10f(0 - exp10) }
    return withSign(v, neg)
  }

  // The exact path: value = num / den, both integers, no rounding yet.
  const num = bnFromDigits(digs)
  const den = bnFromI64(1)
  if exp10 > 0 { bnMulPow10(num, exp10) }
  if exp10 < 0 { bnMulPow10(den, 0 - exp10) }

  // Choose the binary exponent so the quotient has 53 bits. -1074 is the floor,
  // because no double has a smaller exponent and a short quotient there is
  // exactly what a subnormal is.
  let e2 = bnBitLen(num) - bnBitLen(den) - 53
  if e2 < -1074 { e2 = -1074 }
  let q: i64 = 0
  let rem = bnFromI64(0)
  let dn = bnFromI64(0)
  let settled = false
  while !settled {
    if e2 + 1075 >= 2047 { return withSign(f64fromBits(BITS_INF), neg) }
    rem = bnCopy(num)
    dn = bnCopy(den)
    if e2 > 0 { bnShlInto(dn, e2) }
    if e2 < 0 { bnShlInto(rem, 0 - e2) }
    q = bnDivMod(rem, dn)
    if q >= TWO53 { e2 = e2 + 1 } else { settled = true }
  }

  // Round to nearest, ties to even — except that a truncated tail means the true
  // value is strictly above the tie, so it rounds up.
  const t = bnCopy(rem)
  bnMulSmall(t, 2)
  const c = bnCmp(t, dn)
  let up = false
  if c > 0 {
    up = true
  } else if c == 0 {
    if truncated { up = true }
    else if (q & 1) != 0 { up = true }
  }
  if up { q = q + 1 }
  if q >= TWO53 {
    q = q / 2
    e2 = e2 + 1
  }
  if e2 + 1075 >= 2047 { return withSign(f64fromBits(BITS_INF), neg) }
  // One expression for both classes: the carry out of the significand IS the
  // exponent field's low bit, and at the subnormal floor the term vanishes.
  const be2: i64 = e2 + 1074
  return withSign(f64fromBits((be2 << 52) + q), neg)
}
