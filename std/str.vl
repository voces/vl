// `std:str` — the string methods the language core does not have.
//
//     import { split, join, trim, replaceAll, startsWith, padStart } from "std:str"
//
// Each takes the string first, so it reads as a method: `s.trim()`. Indices and
// lengths are the core's own units, so they compose with `slice` and `indexOf`.
// Case folding is ASCII-only and says so in the name; `trim` is ASCII-only too.
// No regex and no pattern arguments — `contains`, `indexOf` and `slice` stay in
// the core, and importing a second copy of one of those names would not compile.

// ── the shared cores ─────────────────────────────────────────────────────────

// Whether `needle` occurs at index `at`. An out-of-range `at` — negative, or a
// needle that would run off the end — is `false` rather than a trap.
function matchAt(self: string, needle: string, at: i32): boolean {
  if at < 0 { return false }
  if at + needle.length > self.length { return false }
  let i = 0
  while i < needle.length {
    if self[i + at] != needle[i] { return false }
    i = i + 1
  }
  true
}

// The index of the first `needle` at or after `from`, or -1. An empty needle
// is found immediately at `from`, matching the core's `indexOf("") == 0`.
function findFrom(self: string, needle: string, from: i32): i32 {
  let i = from
  if i < 0 { i = 0 }
  const last = self.length - needle.length
  while i <= last {
    if matchAt(self, needle, i) { return i }
    i = i + 1
  }
  -1
}

// Append every CODE POINT of `s` to `buf` — the one copy primitive here. It
// iterates rather than indexes, because `buf` is drained by `fromCodePoints`
// and `s[i]` is a byte: pushing bytes in would build mojibake.
function pushStr(buf: i32[], s: string) {
  for cp in s { buf.push(cp) }
}

// Append `s[lo..hi)` to `buf`, clamping `lo` up to 0 and `hi` down to the end,
// so a caller may pass an empty or inverted range.
function pushRange(buf: i32[], s: string, lo: i32, hi: i32) {
  let start = lo
  if start < 0 { start = 0 }
  pushStr(buf, s.slice(start, hi))
}

// The six ASCII whitespace characters.
function isSpace(c: i32): boolean {
  c == ' ' || c == '\t' || c == '\n' || c == '\v' || c == '\f' || c == '\r'
}

// The index of the first non-whitespace character, or `self.length` when there
// is none.
function spanStart(self: string): i32 {
  let i = 0
  while i < self.length {
    if !isSpace(self[i]) { return i }
    i = i + 1
  }
  self.length
}

// One past the last non-whitespace character, or 0 when there is none.
function spanEnd(self: string): i32 {
  let i = self.length
  while i > 0 {
    if !isSpace(self[i - 1]) { return i }
    i = i - 1
  }
  0
}

// ── searching ────────────────────────────────────────────────────────────────

// Whether `self` begins with `prefix`. An empty prefix is always present; a
// prefix longer than `self` never is.
export function startsWith(self: string, prefix: string): boolean {
  matchAt(self, prefix, 0)
}

// Whether `self` ends with `suffix`. An empty suffix is always present.
export function endsWith(self: string, suffix: string): boolean {
  matchAt(self, suffix, self.length - suffix.length)
}

// The index of the LAST occurrence of `needle`, or -1 when absent — the
// counterpart the core's `indexOf` lacks, keeping its -1 convention. An empty
// needle answers `self.length`. Occurrences may OVERLAP here, unlike in
// `split` and `replaceAll`: `"aaa".lastIndexOf("aa")` is 1.
export function lastIndexOf(self: string, needle: string): i32 {
  let i = self.length - needle.length
  while i >= 0 {
    if matchAt(self, needle, i) { return i }
    i = i - 1
  }
  -1
}

// ── splitting and joining ────────────────────────────────────────────────────

// The pieces of `self` between each occurrence of `sep`. The result always has
// one more element than `sep` has occurrences, so a leading, trailing or
// doubled separator each give an empty piece and `"".split(",")` is `[""]`.
// An EMPTY `sep` splits into single characters, and `"".split("")` is `[]`.
export function split(self: string, sep: string): string[] {
  const out: string[] = []
  if sep.length == 0 {
    for cp in self { out.push(fromCodePoint(cp)) }
    return out
  }
  let start = 0
  let at = findFrom(self, sep, 0)
  while at >= 0 {
    out.push(self.slice(start, at))
    start = at + sep.length
    at = findFrom(self, sep, start)
  }
  out.push(self.slice(start, self.length))
  out
}

// The elements of `self` with `sep` between each adjacent pair — `split`'s
// inverse. An empty list joins to `""` and a one-element list to that element,
// neither touching `sep`; there is never a trailing separator.
export function join(self: string[], sep: string): string {
  if self.length == 0 { return "" }
  if self.length == 1 { return self[0] }
  const buf: i32[] = []
  let i = 0
  while i < self.length {
    if i > 0 { pushStr(buf, sep) }
    pushStr(buf, self[i])
    i = i + 1
  }
  fromCodePoints(buf)
}

// ── replacing ────────────────────────────────────────────────────────────────

// `self` with the FIRST occurrence of `from` replaced by `to`. A `from` that
// does not occur answers `self` unchanged, with nothing allocated. An empty
// `from` occurs at index 0, so `"abc".replace("", "-")` is `"-abc"`.
export function replace(self: string, from: string, to: string): string {
  const at = findFrom(self, from, 0)
  if at < 0 { return self }
  self.slice(0, at) + to + self.slice(at + from.length, self.length)
}

// `self` with EVERY occurrence of `from` replaced by `to`. Matches are consumed
// left to right and never overlap, so `"aaa".replaceAll("aa", "b")` is `"ba"`
// and a `to` containing `from` is not rescanned. An empty `from` matches at
// every character boundary: `"abc".replaceAll("", "-")` is `"-a-b-c-"`.
export function replaceAll(self: string, from: string, to: string): string {
  const buf: i32[] = []
  if from.length == 0 {
    for cp in self {
      pushStr(buf, to)
      buf.push(cp)
    }
    pushStr(buf, to)
    return fromCodePoints(buf)
  }
  let at = findFrom(self, from, 0)
  if at < 0 { return self }
  let start = 0
  while at >= 0 {
    pushRange(buf, self, start, at)
    pushStr(buf, to)
    start = at + from.length
    at = findFrom(self, from, start)
  }
  pushRange(buf, self, start, self.length)
  fromCodePoints(buf)
}

// ── trimming ─────────────────────────────────────────────────────────────────

// `self` without leading ASCII whitespace. An all-blank string trims to `""`,
// and a string with nothing to remove comes back unchanged and unallocated.
export function trimStart(self: string): string {
  const a = spanStart(self)
  if a == 0 { return self }
  if a == self.length { return "" }
  return self.slice(a, self.length)
}

// `self` without trailing ASCII whitespace. An all-blank string trims to `""`.
export function trimEnd(self: string): string {
  const b = spanEnd(self)
  if b == self.length { return self }
  if b == 0 { return "" }
  return self.slice(0, b)
}

// `self` without leading or trailing ASCII whitespace. Interior whitespace is
// UNTOUCHED: `" a b ".trim()` is `"a b"`, not `"ab"`.
export function trim(self: string): string {
  const a = spanStart(self)
  if a == self.length { return "" }
  const b = spanEnd(self)
  if a == 0 && b == self.length { return self }
  return self.slice(a, b)
}

// ── building ─────────────────────────────────────────────────────────────────

// `self` concatenated `n` times. `n <= 0` answers `""` rather than failing: a
// count that came out negative is an empty result, not a bug in the program.
export function repeat(self: string, n: i32): string {
  if n <= 0 { return "" }
  if n == 1 { return self }
  if self.length == 0 { return "" }
  const buf: i32[] = []
  let i = 0
  while i < n {
    pushStr(buf, self)
    i = i + 1
  }
  fromCodePoints(buf)
}

// Exactly `n` CODE POINTS of `pad`, tiled and truncated wherever the tiling
// lands: `padFill(3, "ab")` is `"aba"`. `n <= 0` or an empty `pad` answers
// `""`, which is what lets both padders leave their input alone.
function padFill(n: i32, pad: string): string {
  if n <= 0 { return "" }
  const tile: i32[] = []
  for cp in pad { tile.push(cp) }
  if tile.length == 0 { return "" }
  const buf: i32[] = []
  let i = 0
  while i < n {
    buf.push(tile[i % tile.length])
    i = i + 1
  }
  fromCodePoints(buf)
}

// `self` padded on the LEFT with `pad` until it is `len` CODE POINTS wide.
// It NEVER truncates, so `"hello".padStart(3, "0")` is `"hello"`, and an empty
// `pad` is a no-op rather than a hang. Code points are not display width — a
// CJK character is one here and two columns on screen.
export function padStart(self: string, len: i32, pad: string): string {
  const fill = padFill(len - self.cpLen(), pad)
  if fill.length == 0 { return self }
  fill + self
}

// `self` padded on the RIGHT with `pad`. Same rules as `padStart`: never
// truncates, empty `pad` is a no-op, `len` counts code points.
export function padEnd(self: string, len: i32, pad: string): string {
  const fill = padFill(len - self.cpLen(), pad)
  if fill.length == 0 { return self }
  self + fill
}

// ── ASCII case ───────────────────────────────────────────────────────────────

// The distance from `c` to its ASCII case counterpart, or 0 when it has none —
// so every non-ASCII character passes through unchanged.
function caseShift(c: i32, up: boolean): i32 {
  if up {
    if c >= 'a' && c <= 'z' { return -32 }
    return 0
  }
  if c >= 'A' && c <= 'Z' { return 32 }
  0
}

// The one case walk. It scans before it builds, so a string with nothing to
// change comes back as it arrived, with no allocation.
function mapAsciiCase(self: string, up: boolean): string {
  let hit = false
  for cp in self {
    if caseShift(cp, up) != 0 {
      hit = true
      break
    }
  }
  if !hit { return self }
  const buf: i32[] = []
  for cp in self { buf.push(cp + caseShift(cp, up)) }
  fromCodePoints(buf)
}

// `self` with every ASCII lower-case letter upper-cased. NOTHING else changes:
// `"é"`, `"ß"` and every other non-ASCII character pass through untouched, and
// the name says so. Full Unicode case mapping needs tables VL does not ship.
export function toUpperAscii(self: string): string { mapAsciiCase(self, true) }

// `self` with every ASCII upper-case letter lower-cased. Same promise, same limit.
export function toLowerAscii(self: string): string { mapAsciiCase(self, false) }
