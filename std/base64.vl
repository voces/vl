// `std:base64` — RFC 4648 §4 base64: the standard alphabet, always padded.
//
//     import { encodeBase64, decodeBase64, Base64Error } from "std:base64"
//
// Encoding is total; decoding is strict. Spaces, line wrapping, missing padding
// and non-canonical trailing bits are each refused, which is what makes
// decode-then-encode an exact identity. The URL-safe alphabet is not here; when
// it arrives it gets its own name rather than a boolean parameter.

// Why a decode stopped. Branch on `kind`: `"character"` for a byte outside the
// alphabet, `"length"` for an input that is not a multiple of four,
// `"padding"` for a misplaced `=`, `"bits"` for non-canonical trailing bits.
// `at` locates it — the input's size for `"length"` — and `msg` is prose.
export type Base64Error = {
  at: i32,
  kind: "character" | "length" | "padding" | "bits",
  msg: string,
}

// A 6-bit value as its character, over the RFC 4648 §4 alphabet.
function b64Char(v: i32): i32 {
  if v < 26 { return 65 + v }
  if v < 52 { return 97 + (v - 26) }
  if v < 62 { return 48 + (v - 52) }
  if v == 62 { return 43 }
  47
}

// The inverse: a character's 6-bit value, or -1. `=` is not accepted here,
// because padding is positional and the decoder handles it.
function b64Val(c: i32): i32 {
  if c >= 65 && c <= 90 { return c - 65 }
  if c >= 97 && c <= 122 { return c - 97 + 26 }
  if c >= 48 && c <= 57 { return c - 48 + 52 }
  if c == 43 { return 62 }
  if c == 47 { return 63 }
  -1
}

function b64Err(
  at: i32,
  kind: "character" | "length" | "padding" | "bits",
  msg: string,
): Base64Error {
  { at: at, kind: kind, msg: msg }
}

// `self` as padded base64 text. Total — every byte sequence has an encoding,
// and `[]` encodes to `""`.
export function encodeBase64(self: u8[]): string {
  const out: i32[] = []
  const n = self.length
  let i = 0
  while i + 3 <= n {
    const a = self[i]
    const b = self[i + 1]
    const c = self[i + 2]
    out.push(b64Char(a >> 2))
    out.push(b64Char(((a & 3) << 4) | (b >> 4)))
    out.push(b64Char(((b & 15) << 2) | (c >> 6)))
    out.push(b64Char(c & 63))
    i = i + 3
  }
  const rest = n - i
  if rest == 1 {
    const a = self[i]
    out.push(b64Char(a >> 2))
    out.push(b64Char((a & 3) << 4))
    out.push(61)
    out.push(61)
  }
  if rest == 2 {
    const a = self[i]
    const b = self[i + 1]
    out.push(b64Char(a >> 2))
    out.push(b64Char(((a & 3) << 4) | (b >> 4)))
    out.push(b64Char((b & 15) << 2))
    out.push(61)
  }
  fromCodePoints(out)
}

// The bytes `self` encodes, or why it is not canonical padded base64 — see
// `Base64Error` for the four refusals. `""` decodes to an empty list and is
// not an error. Non-ASCII input is refused by the same test that refuses a
// space, because indexing a string yields a byte.
export function decodeBase64(self: string): u8[] | Base64Error {
  const out: u8[] = []
  const n = self.length
  if n == 0 { return out }
  if n % 4 != 0 {
    return b64Err(n, "length", "base64 length is not a multiple of 4")
  }
  let i = 0
  while i < n {
    const last = i + 4 == n
    const t0 = self[i]
    const t1 = self[i + 1]
    const t2 = self[i + 2]
    const t3 = self[i + 3]
    // A group encodes at least one byte, which needs two characters, so `=` in
    // either of the first two positions is always wrong.
    if t0 == 61 { return b64Err(i, "padding", "misplaced '=' padding") }
    if t1 == 61 { return b64Err(i + 1, "padding", "misplaced '=' padding") }
    const c0 = b64Val(t0)
    if c0 < 0 { return b64Err(i, "character", "not a base64 character") }
    const c1 = b64Val(t1)
    if c1 < 0 { return b64Err(i + 1, "character", "not a base64 character") }
    if t2 == 61 {
      if !last { return b64Err(i + 2, "padding", "'=' before the last group") }
      if t3 != 61 { return b64Err(i + 3, "padding", "'=' must pad to the end") }
      // A canonical encoder leaves the bits past the encoded byte zero.
      if (c1 & 15) != 0 {
        return b64Err(i + 1, "bits", "non-zero bits past the encoded byte")
      }
      out.push((c0 << 2) | (c1 >> 4))
      return out
    }
    const c2 = b64Val(t2)
    if c2 < 0 { return b64Err(i + 2, "character", "not a base64 character") }
    if t3 == 61 {
      if !last { return b64Err(i + 3, "padding", "'=' before the last group") }
      // Likewise the low two bits of the third character.
      if (c2 & 3) != 0 {
        return b64Err(i + 2, "bits", "non-zero bits past the encoded byte")
      }
      out.push((c0 << 2) | (c1 >> 4))
      out.push(((c1 & 15) << 4) | (c2 >> 2))
      return out
    }
    const c3 = b64Val(t3)
    if c3 < 0 { return b64Err(i + 3, "character", "not a base64 character") }
    out.push((c0 << 2) | (c1 >> 4))
    out.push(((c1 & 15) << 4) | (c2 >> 2))
    out.push(((c2 & 3) << 6) | c3)
    i = i + 4
  }
  out
}
