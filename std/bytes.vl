// `std:bytes` — integers read out of a `u8[]`, at either byte order.
//
//     import { u16le, i32le, i64le, i32be } from "std:bytes"
//
// Each takes the list first, so it reads as a method: `b.i32le(off)`. The names
// deliberately do not repeat `std:buffer`'s `load*`, so a file reading both a
// `Buf` and a `u8[]` can import both sets. An offset that runs off either end
// traps in the list's own bounds check; nothing here answers 0 for a short read.
// NOT here: writing bytes back; one byte is `b[off]`, already 0 to 255, and a
// signed one is `(b[off] << 24) >> 24`; a float is `f32fromBits(b.i32le(off))`.

// ── 16 bits ──────────────────────────────────────────────────────────────────

// Eight reads: one per width and byte order, and at 16 bits one per signedness
// too. Two bytes fit an i32 two ways, so `u16le` answers 65535 where `i16le`
// answers -1. Four and eight bytes fill their return type, so there is one read
// each: at 64 there is nowhere wider, and at 32 the widening is a cast you spell.

// The two bytes at `off`, low byte first, as 0 to 65535.
export function u16le(self: u8[], off: i32): i32 {
  return self[off] | (self[off + 1] << 8)
}

// The two bytes at `off`, high byte first, as 0 to 65535.
export function u16be(self: u8[], off: i32): i32 {
  return (self[off] << 8) | self[off + 1]
}

// The two bytes at `off`, low byte first, sign-extended to -32768 to 32767.
export function i16le(self: u8[], off: i32): i32 {
  return (u16le(self, off) << 16) >> 16
}

// The two bytes at `off`, high byte first, sign-extended to -32768 to 32767.
export function i16be(self: u8[], off: i32): i32 {
  return (u16be(self, off) << 16) >> 16
}

// ── 32 bits ──────────────────────────────────────────────────────────────────

// The four bytes at `off`, low byte first. The whole 32-bit pattern lands in the
// i32, so a word at or above 2^31 reads negative; for it as a number widen FIRST
// — `(b.i32le(off) as i64) & 0xffffffff`, since masking the i32 alone does nothing.
export function i32le(self: u8[], off: i32): i32 {
  return self[off] |
    (self[off + 1] << 8) |
    (self[off + 2] << 16) |
    (self[off + 3] << 24)
}

// The four bytes at `off`, high byte first — the order a network protocol or a
// big-endian container uses. Delivered like `i32le`: the whole pattern, so 2^31
// and up read negative.
export function i32be(self: u8[], off: i32): i32 {
  return (self[off] << 24) |
    (self[off + 1] << 16) |
    (self[off + 2] << 8) |
    self[off + 3]
}

// ── 64 bits ──────────────────────────────────────────────────────────────────

// The eight bytes at `off`, low byte first. i64 is the widest integer, so a value
// at or above 2^63 reads negative and there is nowhere wider to put it.
export function i64le(self: u8[], off: i32): i64 {
  const lo = i32le(self, off)
  const hi = i32le(self, off + 4)
  return ((lo as i64) & 0xffffffff) | ((hi as i64) << 32)
}

// The eight bytes at `off`, high byte first. Delivered like `i64le`: a value at
// or above 2^63 reads negative.
export function i64be(self: u8[], off: i32): i64 {
  const hi = i32be(self, off)
  const lo = i32be(self, off + 4)
  return ((lo as i64) & 0xffffffff) | ((hi as i64) << 32)
}
