// `std:json` — RFC 8259 JSON as a VL value tree, and back.
//
//     import { Json, JsonError, parseJson, toJson } from "std:json"
//
// Four names are the whole surface. The parser follows I-JSON: duplicate member
// names, lone surrogates, raw control characters, a leading byte-order mark and a
// number outside f64 range are all refused. Numbers ARE `f64`, so an integer past
// the interoperable range loses precision with no error, and untrusted bytes want
// `std:utf8`'s decoder first — this module takes text. NOT here, each its own name
// when it arrives: a pretty printer, a JSON-pointer API, mapping to your own types.

import { parseF64, toString } from "std:fmt"

// The value tree: the six JSON types. Objects are VL maps and arrays are VL
// lists, so `m.has(k)` sits beside `m[k]` and a MISSING member stays
// distinguishable from one holding `null`.
export type Json = null | boolean | f64 | string | Json[] | { [string]: Json }

// Why a parse or a render stopped. Branch on `kind`; `msg` is prose, not the
// contract. `at` is a byte offset into the parsed text (0 on render) and is in
// `[0, length]` INCLUSIVE, so bounds-check before indexing with it. `path` is
// an RFC 6901 pointer: the CONTAINER on parse, the OFFENDING VALUE on render.
export type JsonError = {
  at: i32,
  kind: "syntax" | "duplicate" | "depth" | "nonfinite",
  path: string,
  msg: string,
}

// Container nesting cap, in both directions. It turns a stack overflow — which
// no program can handle — into an error a caller can read, and it is what a
// cycle in a program-built tree surfaces as. It protects `parseJson` and
// `toJson` and nothing else: your own walker over a cyclic tree still traps.
const MAX_DEPTH = 128

function jsonErr(
  at: i32,
  kind: "syntax" | "duplicate" | "depth" | "nonfinite",
  path: string,
  msg: string,
): JsonError {
  { at: at, kind: kind, path: path, msg: msg }
}

// One RFC 6901 pointer segment. The two escapes are ordered: `~` first, or the
// `~1` produced from a `/` would itself be re-escaped.
function ptrSeg(k: string): string {
  const out: i32[] = []
  for cp in k {
    if cp == 126 {
      out.push(126)
      out.push(48)
    } else {
      if cp == 47 {
        out.push(126)
        out.push(49)
      } else {
        out.push(cp)
      }
    }
  }
  fromCodePoints(out)
}

// ── the renderer ─────────────────────────────────────────────────────────────

// Whether `x` has a JSON spelling. NaN and the two infinities do not.
function isFiniteF64(x: f64): boolean {
  if x != x { return false }
  if x > 1.7976931348623157e308 { return false }
  if x < -1.7976931348623157e308 { return false }
  true
}

// `toString` is right for every f64 except negative zero, which it prints as
// `0`. The sign is KEPT here: RFC 8259 admits `-0` and most readers keep it.
function numText(x: f64): string {
  if x == 0.0 && 1.0 / x < 0.0 { return "-0" }
  toString(x)
}

function hexDigit(v: i32): i32 {
  if v < 10 { return 48 + v }
  97 + (v - 10)
}

// The character that follows the backslash for the five control characters RFC
// 8259 names, or 0 for anything else. `"` and `\` are not here: they escape to
// themselves. It inverts `simpleEscape` exactly, which is why neither is a table.
function namedEscape(cp: i32): i32 {
  if cp == 8 { return 98 }
  if cp == 9 { return 116 }
  if cp == 10 { return 110 }
  if cp == 12 { return 102 }
  if cp == 13 { return 114 }
  0
}

// `s` as a JSON string literal, quotes included, pushed onto `buf` as code
// points — so non-ASCII passes through raw and correct.
function pushQuoted(buf: i32[], s: string) {
  buf.push(34)
  for cp in s {
    const named = namedEscape(cp)
    if cp == 34 || cp == 92 {
      buf.push(92)
      buf.push(cp)
    } else {
      if named != 0 {
        buf.push(92)
        buf.push(named)
      } else {
        // Everything else below U+0020 takes the six-character form, with lowercase hex.
        if cp < 32 {
          buf.push(92)
          buf.push(117)
          buf.push(48)
          buf.push(48)
          buf.push(hexDigit(cp >> 4))
          buf.push(hexDigit(cp & 15))
        } else {
          buf.push(cp)
        }
      }
    }
  }
  buf.push(34)
}

function pushText(buf: i32[], s: string) {
  for cp in s { buf.push(cp) }
}

// The walk's failure, carried beside the buffer so `renderInto` can answer a
// plain boolean and every level can prepend its own pointer segment on the way
// out. Do not make `renderInto` void, and do not rebind `err` to read it.
type Rend = { err: JsonError | null }

// First failure wins, and a render error's `at` is always 0.
function rendFail(
  r: Rend,
  kind: "syntax" | "duplicate" | "depth" | "nonfinite",
  msg: string,
) {
  if r.err == null { r.err = jsonErr(0, kind, "", msg) }
}

// Re-point a propagating render error one level up. On render `path` names the
// VALUE, so every level prepends its own segment.
function underSeg(r: Rend, seg: string) {
  if r.err != null { r.err.path = "/" + seg + r.err.path }
}

// Walk `v` into `buf`, answering whether it was written; `r` carries WHY when
// it was not. `depth` counts the containers already open, so the cap is checked
// as a container is entered.
function renderInto(v: Json, buf: i32[], depth: i32, r: Rend): boolean {
  if v is null {
    pushText(buf, "null")
    return true
  }
  if v is boolean {
    if v { pushText(buf, "true") } else { pushText(buf, "false") }
    return true
  }
  if v is f64 {
    if !isFiniteF64(v) {
      rendFail(r, "nonfinite", "no JSON spelling for this number")
      return false
    }
    pushText(buf, numText(v))
    return true
  }
  if v is string {
    pushQuoted(buf, v)
    return true
  }
  if v is Json[] {
    if depth + 1 > MAX_DEPTH {
      rendFail(r, "depth", "nesting exceeds the depth cap")
      return false
    }
    buf.push(91)
    let i = 0
    while i < v.length {
      if i > 0 { buf.push(44) }
      if !renderInto(v[i], buf, depth + 1, r) {
        underSeg(r, toString(i))
        return false
      }
      i = i + 1
    }
    buf.push(93)
    return true
  }
  if v is { [string]: Json } {
    // Do not inline: the map arm has to be re-bound at its own type here.
    const o: { [string]: Json } = v
    if depth + 1 > MAX_DEPTH {
      rendFail(r, "depth", "nesting exceeds the depth cap")
      return false
    }
    buf.push(123)
    let first = true
    let bad = ""
    for k in o {
      if r.err == null {
        if !first { buf.push(44) }
        first = false
        pushQuoted(buf, k)
        buf.push(58)
        // A key reached by iteration is always present, so a `null` here is a STORED
        // JSON null and renders as one.
        const mv = o[k]
        if mv == null {
          pushText(buf, "null")
        } else {
          if !renderInto(mv, buf, depth + 1, r) { bad = k }
        }
      }
    }
    if r.err != null {
      underSeg(r, ptrSeg(bad))
      return false
    }
    buf.push(125)
    return true
  }
  // Unreachable while `Json` has six arms and all six are above. A seventh added
  // without a branch here has to be LOUD: writing nothing would hand back a
  // document with a value silently missing.
  rendFail(
    r,
    "nonfinite",
    "internal error in std:json: this value is none of the six JSON types; please report",
  )
  false
}

// `self` as compact RFC 8259 text, or why it has none: a number with no JSON
// spelling, or a tree deeper than the nesting cap — which is also how a cycle
// arrives. No whitespace at all, objects in INSERTION order, `/` unescaped,
// non-ASCII raw as UTF-8, and nothing partial is ever returned.
export function toJson(self: Json): string | JsonError {
  const buf: i32[] = []
  const r: Rend = { err: null }
  if !renderInto(self, buf, 0, r) {
    if r.err != null { return r.err }
    // Unreachable while every failure above raises first. It is an error rather
    // than a partial document, and a value rather than a trap, because neither
    // direction of this module traps.
    return jsonErr(
      0,
      "nonfinite",
      "",
      "internal error in std:json: the render stopped without recording a reason; please report",
    )
  }
  fromCodePoints(buf)
}

// ── the parser ───────────────────────────────────────────────────────────────

// Scanner state. The error rides here so the value functions can answer a plain
// `Json`; it is private bookkeeping and not a second error channel — the
// surface is `Json | JsonError` in both directions. `sealed` is how `path` is
// built without costing anything on the success path.
type Scan = {
  s: string,
  i: i32,
  err: JsonError | null,
  sealed: boolean,
}

// The byte at `i`, or -1 at end of input. Every read goes through this: an
// unguarded index past the end would trap, and a parser must never trap.
function byteAt(p: Scan, i: i32): i32 {
  if i < 0 || i >= p.s.length { return -1 }
  p.s[i]
}

// Raise from a SCALAR position: the enclosing container owns the pointer, so
// the error is left for it to claim. First error wins.
function raise(
  p: Scan,
  at: i32,
  kind: "syntax" | "duplicate" | "depth" | "nonfinite",
  msg: string,
) {
  if p.err == null {
    p.err = jsonErr(at, kind, "", msg)
    p.sealed = false
  }
}

// Raise from a CONTAINER's own token stream — a missing `:`, an unterminated
// array. That container claims the pointer here.
function raiseHere(
  p: Scan,
  at: i32,
  kind: "syntax" | "duplicate" | "depth" | "nonfinite",
  msg: string,
) {
  raise(p, at, kind, msg)
  p.sealed = true
}

// Called by a container when a CHILD failed. The innermost container claims the
// pointer and adds no segment; every container above prepends the segment of
// the child it was reading.
function sealErr(p: Scan, seg: string) {
  if p.err != null {
    if p.sealed { p.err.path = "/" + seg + p.err.path } else { p.sealed = true }
  }
}

function isWs(c: i32): boolean { c == 32 || c == 9 || c == 10 || c == 13 }

function skipWs(p: Scan) {
  while p.i < p.s.length && isWs(p.s[p.i]) { p.i = p.i + 1 }
}

function isDigit(c: i32): boolean { c >= 48 && c <= 57 }

function hexVal(c: i32): i32 {
  if c >= 48 && c <= 57 { return c - 48 }
  if c >= 97 && c <= 102 { return c - 97 + 10 }
  if c >= 65 && c <= 70 { return c - 65 + 10 }
  -1
}

// The four hex digits of a `\uXXXX` at `p.i`, or -1. Does not advance.
function hex4(p: Scan): i32 {
  let v = 0
  let k = 0
  while k < 4 {
    const d = hexVal(byteAt(p, p.i + k))
    if d < 0 { return -1 }
    v = v * 16 + d
    k = k + 1
  }
  v
}

// The code point a one-character escape names, or -1 if it names none. `\/` is
// accepted on input even though the renderer never writes it.
function simpleEscape(e: i32): i32 {
  if e == 34 { return 34 }
  if e == 92 { return 92 }
  if e == 47 { return 47 }
  if e == 98 { return 8 }
  if e == 102 { return 12 }
  if e == 110 { return 10 }
  if e == 114 { return 13 }
  if e == 116 { return 9 }
  -1
}

// One `\uXXXX` escape whose `u` has just been consumed. Pushes one code point,
// combining a surrogate PAIR into the single character it names.
function pUnicodeEscape(p: Scan, buf: i32[], esc: i32): boolean {
  const hi = hex4(p)
  if hi < 0 {
    raise(p, esc, "syntax", "\\u needs four hex digits")
    return false
  }
  p.i = p.i + 4
  if hi >= 55296 && hi <= 56319 {
    if byteAt(p, p.i) != 92 || byteAt(p, p.i + 1) != 117 {
      raise(p, esc, "syntax", "lone high surrogate escape")
      return false
    }
    p.i = p.i + 2
    const lo = hex4(p)
    if lo < 0 {
      raise(p, esc, "syntax", "\\u needs four hex digits")
      return false
    }
    if lo < 56320 || lo > 57343 {
      raise(p, esc, "syntax", "high surrogate not followed by a low surrogate")
      return false
    }
    p.i = p.i + 4
    buf.push(65536 + ((hi - 55296) * 1024) + (lo - 56320))
    return true
  }
  if hi >= 56320 && hi <= 57343 {
    raise(p, esc, "syntax", "lone low surrogate escape")
    return false
  }
  buf.push(hi)
  true
}

// A JSON string literal starting at its opening quote; on failure it raises and
// answers `""`. With no escape the value is one byte-exact slice; the first
// escape switches it onto a code-point buffer, which substitutes U+FFFD for a
// malformed byte the slice route would have passed through.
function pString(p: Scan): string {
  p.i = p.i + 1
  const start = p.i
  const buf: i32[] = []
  let escaped = false
  let runStart = start
  let out = ""
  let done = false
  while !done {
    const c = byteAt(p, p.i)
    if c < 0 {
      raise(p, p.s.length, "syntax", "unterminated string")
      return ""
    }
    if c < 32 {
      raise(p, p.i, "syntax", "raw control character in a string")
      return ""
    }
    if c == 34 {
      if escaped {
        for cp in p.s.slice(runStart, p.i) { buf.push(cp) }
        out = fromCodePoints(buf)
      } else {
        out = p.s.slice(start, p.i)
      }
      p.i = p.i + 1
      done = true
    } else {
      if c == 92 {
        escaped = true
        for cp in p.s.slice(runStart, p.i) { buf.push(cp) }
        const esc = p.i
        p.i = p.i + 1
        const e = byteAt(p, p.i)
        const simple = simpleEscape(e)
        if simple >= 0 {
          buf.push(simple)
          p.i = p.i + 1
        } else {
          if e != 117 {
            raise(p, esc, "syntax", "unknown escape")
            return ""
          }
          p.i = p.i + 1
          if !pUnicodeEscape(p, buf, esc) { return "" }
        }
        runStart = p.i
      } else {
        p.i = p.i + 1
      }
    }
  }
  out
}

// A number lexeme validated against RFC 8259 §6 by hand, then converted.
// `parseF64` is the conversion and never the gate — it accepts `01`, `NaN` and
// `Infinity`, which JSON does not.
function pNumber(p: Scan): Json {
  const start = p.i
  if byteAt(p, p.i) == 45 { p.i = p.i + 1 }
  const intStart = p.i
  if byteAt(p, p.i) == 48 {
    p.i = p.i + 1
    if isDigit(byteAt(p, p.i)) {
      raise(p, intStart, "syntax", "a number may not have a leading zero")
      return null
    }
  } else {
    if !isDigit(byteAt(p, p.i)) {
      raise(p, p.i, "syntax", "a number needs a digit")
      return null
    }
    while isDigit(byteAt(p, p.i)) { p.i = p.i + 1 }
  }
  if byteAt(p, p.i) == 46 {
    p.i = p.i + 1
    if !isDigit(byteAt(p, p.i)) {
      raise(p, p.i, "syntax", "a fraction needs a digit after the point")
      return null
    }
    while isDigit(byteAt(p, p.i)) { p.i = p.i + 1 }
  }
  const e = byteAt(p, p.i)
  if e == 101 || e == 69 {
    p.i = p.i + 1
    const sign = byteAt(p, p.i)
    if sign == 43 || sign == 45 { p.i = p.i + 1 }
    if !isDigit(byteAt(p, p.i)) {
      raise(p, p.i, "syntax", "an exponent needs a digit")
      return null
    }
    while isDigit(byteAt(p, p.i)) { p.i = p.i + 1 }
  }
  const lex = p.s.slice(start, p.i)
  const v = parseF64(lex)
  if v == null {
    raise(p, start, "syntax", "not a number")
    return null
  }
  if !isFiniteF64(v) {
    raise(p, start, "nonfinite", "number out of range for a double")
    return null
  }
  v
}

// `word` at `p.i`, consumed. The three JSON literals are the only keywords.
function eatWord(p: Scan, word: string): boolean {
  let k = 0
  while k < word.length {
    if byteAt(p, p.i + k) != word[k] { return false }
    k = k + 1
  }
  p.i = p.i + word.length
  true
}

function pArray(p: Scan, depth: i32): Json {
  if depth + 1 > MAX_DEPTH {
    raiseHere(p, p.i, "depth", "nesting exceeds the depth cap")
    return null
  }
  p.i = p.i + 1
  const a: Json[] = []
  skipWs(p)
  if byteAt(p, p.i) == 93 {
    p.i = p.i + 1
    return a
  }
  while true {
    skipWs(p)
    const v = pValue(p, depth + 1)
    if p.err != null {
      sealErr(p, toString(a.length))
      return null
    }
    a.push(v)
    skipWs(p)
    const c = byteAt(p, p.i)
    if c == 44 {
      p.i = p.i + 1
      skipWs(p)
      if byteAt(p, p.i) == 93 {
        raiseHere(p, p.i, "syntax", "trailing comma in an array")
        return null
      }
    } else {
      if c == 93 {
        p.i = p.i + 1
        return a
      }
      if c < 0 {
        raiseHere(p, p.s.length, "syntax", "unexpected end of input")
        return null
      }
      raiseHere(p, p.i, "syntax", "expected ',' or ']' in an array")
      return null
    }
  }
  null
}

function pObject(p: Scan, depth: i32): Json {
  if depth + 1 > MAX_DEPTH {
    raiseHere(p, p.i, "depth", "nesting exceeds the depth cap")
    return null
  }
  p.i = p.i + 1
  const o: { [string]: Json } = Map()
  skipWs(p)
  if byteAt(p, p.i) == 125 {
    p.i = p.i + 1
    return o
  }
  while true {
    skipWs(p)
    const keyAt = p.i
    if byteAt(p, p.i) != 34 {
      raiseHere(p, p.i, "syntax", "expected a '\"'-quoted member name")
      return null
    }
    const k = pString(p)
    if p.err != null {
      sealErr(p, "")
      return null
    }
    // A repeated member name is refused, with `at` at the SECOND occurrence.
    if o.has(k) {
      raiseHere(p, keyAt, "duplicate", "duplicate member name")
      return null
    }
    skipWs(p)
    if byteAt(p, p.i) != 58 {
      raiseHere(p, p.i, "syntax", "expected ':' after a member name")
      return null
    }
    p.i = p.i + 1
    skipWs(p)
    const v = pValue(p, depth + 1)
    if p.err != null {
      sealErr(p, ptrSeg(k))
      return null
    }
    o[k] = v
    skipWs(p)
    const c = byteAt(p, p.i)
    if c == 44 {
      p.i = p.i + 1
      skipWs(p)
      if byteAt(p, p.i) == 125 {
        raiseHere(p, p.i, "syntax", "trailing comma in an object")
        return null
      }
    } else {
      if c == 125 {
        p.i = p.i + 1
        return o
      }
      if c < 0 {
        raiseHere(p, p.s.length, "syntax", "unexpected end of input")
        return null
      }
      raiseHere(p, p.i, "syntax", "expected ',' or '}' in an object")
      return null
    }
  }
  null
}

function pValue(p: Scan, depth: i32): Json {
  const c = byteAt(p, p.i)
  if c < 0 {
    raise(p, p.s.length, "syntax", "unexpected end of input")
    return null
  }
  if c == 123 { return pObject(p, depth) }
  if c == 91 { return pArray(p, depth) }
  if c == 34 { return pString(p) }
  if c == 45 || isDigit(c) { return pNumber(p) }
  if c == 116 {
    if eatWord(p, "true") { return true }
    raise(p, p.i, "syntax", "expected 'true'")
    return null
  }
  if c == 102 {
    if eatWord(p, "false") { return false }
    raise(p, p.i, "syntax", "expected 'false'")
    return null
  }
  if c == 110 {
    if eatWord(p, "null") { return null }
    raise(p, p.i, "syntax", "expected 'null'")
    return null
  }
  raise(p, p.i, "syntax", "unexpected byte where a value was expected")
  null
}

// A parsed `Json` re-delivered as `Json | JsonError`, one arm at a time — the
// alias is not a member of its own composition, so each arm is handed over at
// its own spelling.
function asResult(v: Json): Json | JsonError {
  if v is boolean { return v }
  if v is f64 { return v }
  if v is string { return v }
  if v is Json[] { return v }
  if v is { [string]: Json } {
    // Do not inline: the map arm has to be re-bound at its own type here.
    const o: { [string]: Json } = v
    return o
  }
  null
}

// The `Json` `self` holds, or why it is not JSON — see the module header for
// what the parser refuses. It never traps and never answers a partial tree.
export function parseJson(self: string): Json | JsonError {
  // The byte-order mark is the one input where the byte you see and the byte the
  // parser sees differ, so it is named rather than reported as a stray byte.
  if self.length >= 3 && self[0] == 239 && self[1] == 187 && self[2] == 191 {
    return jsonErr(0, "syntax", "", "leading byte-order mark")
  }
  const p: Scan = { s: self, i: 0, err: null, sealed: false }
  skipWs(p)
  if p.i >= self.length {
    return jsonErr(self.length, "syntax", "", "unexpected end of input")
  }
  const v = pValue(p, 0)
  if p.err != null { return p.err }
  skipWs(p)
  if p.i < self.length {
    return jsonErr(
      p.i,
      "syntax",
      "",
      "trailing content after the top-level value",
    )
  }
  asResult(v)
}
