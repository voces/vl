// `std:json` — RFC 8259 JSON as a VL value tree, with an I-JSON (RFC 7493)
// parser and a compact renderer. Text in, `Json` out, and back;
// `docs/json-design.md` is the specification. THE WHOLE SURFACE IS FOUR NAMES:
// `Json`, `JsonError`, `parseJson`, `toJson` — see `JsonError` for how a failure
// is located and which `kind`s each direction produces, `MAX_DEPTH` for the
// nesting cap and what a cycle does, and `toJson` for what the renderer emits.
//
// THE PROFILE IS I-JSON (RFC 7493) MINUS TWO CLAUSES: §2.1's NONCHARACTER half is
// not enforced (a noncharacter is an ordinary scalar a VL string already holds,
// where a lone surrogate has no UTF-8 encoding at all — that half IS enforced),
// and §2.2's precision half is the `f64` rounding below rather than a refusal.
// Beyond RFC 8259's grammar the parser refuses DUPLICATE MEMBER NAMES (at the
// second key's opening quote — last-wins hides a producer bug), LONE SURROGATES,
// a NUMBER OUTSIDE f64 RANGE (so every tree `parseJson` returns, `toJson`
// renders), RAW CONTROL CHARACTERS and a LEADING BOM; trailing content and an
// empty body each get their own `syntax` message. `parseF64` IS NOT THE JSON
// NUMBER GRAMMAR — it takes `01`, `NaN` and `Infinity` and rejects `.5` — so the
// lexer scans RFC 8259 §6 itself and calls `parseF64` for the CONVERSION alone.
//
// TWO SILENTLY LOSSY BEHAVIOURS, both chosen deviations from `std-api-review.md`
// §2. NUMBERS ARE `f64`, so past the interoperable integer range precision is
// lost with no error and a 64-bit id does not survive this tree; the exact path
// is stage 3's `fromJson<T>` reading the lexeme straight to `i64`, and since the
// lexer already scans the lexeme a `precision` kind stays addable. AND THE TWO
// STRING ROUTES DISAGREE ON MALFORMED UTF-8: an escape-free literal is one
// byte-exact `slice`, one with any escape goes through `for cp in …`, which
// substitutes U+FFFD. Run untrusted bytes through `decodeUtf8` first — it is the
// one strict decoder, and why v1 takes `string` and not `u8[]`.
//
// NOT HERE, EACH WAITING ON A CONSUMER OR A RULING, named so nothing else takes
// the spelling: `toJsonPretty` (the mode-switch `toJson(v, pretty)` is refused
// outright, and the indent PARAMETER is deliberately NOT fixed — an `i32` would
// foreclose tabs forever in a std with no deprecation story), `jsonKind`,
// `jsonPointer`, `jsonEquals` (absent rather than deferred: `==` over refs is
// already structural, so compare by rendering until `==` over a struct union
// lowers), and stage 3's `fromJson<T>` / generic `toJson<T>`, which at `T = Json`
// IS this `toJson` and so generalises in place. TWO COMPILER GAPS REACH THE
// CALLER: D1030 — the pair does not compose, read `parseJson`'s note first — and
// D1050, why `kind` is an INLINE literal set with no alias. The rest shape only
// the body (D1112/D1161 at `Rend`, D1029, D1009, D1025, D1032, D1034).

import { parseF64, toString } from "std:fmt"

// The value tree: the six JSON types, arms spelled structurally.
//
// Objects are VL maps and arrays are VL lists, so `m.has(k)` sits beside
// `m[k]` and MISSING stays distinguishable from a stored `null` on the tree
// itself — a distinction any flattening accessor would have to give up.
//
// The arms are NOT named (`type JsonObject = { [string]: Json }`), which is
// what a reader wants and what the compiler refuses today: as a member of the
// recursive union the checker rejects it, and declared after the tree
// `let o: JsonObject = Map()` refuses at emit (D1022). An alias is transparent,
// so adding the two names later changes no program's meaning.
export type Json = null | boolean | f64 | string | Json[] | { [string]: Json }

// Why a parse or a render stopped, where, and in which of the four ways.
//
// `at` is a byte offset into the parsed text and is `0` on render. `path` is an RFC
// 6901 pointer (`~` as `~0`, `/` as `~1`) in BOTH directions but not with one meaning:
// on PARSE it names the CONTAINER being read when the failure fired (`"/users/3"`, and
// `""` before any container opens), on RENDER the OFFENDING VALUE itself. `at` IS IN
// `[0, length]` INCLUSIVE, so BOUNDS-CHECK before rendering `self[e.at]` or a truncated
// document traps the error handler. `msg` is prose and is NOT the contract: branch on
// `kind`, locate with `at` and `path`. `parseJson` produces all four kinds, `toJson`
// only `depth` and `nonfinite`, so an exhaustive branch sees arms one direction can
// never return (the `IoError` precedent). `kind` IS A LITERAL UNION, not an `i32` code,
// so `match` sees the arms; `path` keeps this structurally DISTINCT from `Base64Error`.
export type JsonError = {
  at: i32,
  kind: "syntax" | "duplicate" | "depth" | "nonfinite",
  path: string,
  msg: string,
}

// Container nesting cap, both directions: the parser's input and the renderer's
// tree. VL is the only surveyed implementation that caps BOTH. This is a STACK
// BUDGET, not a taste — a parser-shaped frame on this host runs out of stack
// around a thousand levels and recursive descent spends about two frames per
// level, so the cap sits well inside the budget and a trap (which no program can
// handle) becomes an error a caller can read. Re-take the measurement with the
// real frame before moving it; a limit can be RAISED later and never lowered.
//
// A CYCLE IN A PROGRAM-BUILT TREE SURFACES AS `kind: "depth"` — the tree can hold
// one and a naive walk over it traps, so this is what converts that into an
// error. A PARSED tree cannot contain a cycle. The cap protects `parseJson` and
// `toJson` and NOTHING A CONSUMER WRITES: a walker over a cyclic tree still traps.
const MAX_DEPTH = 128

function jsonErr(
  at: i32,
  kind: "syntax" | "duplicate" | "depth" | "nonfinite",
  path: string,
  msg: string,
): JsonError {
  { at: at, kind: kind, path: path, msg: msg }
}

// One RFC 6901 pointer segment. The two escapes are ordered: `~` first, or the
// `~1` produced from a `/` would itself be re-escaped into `~01`.
function ptrSeg(k: string): string {
  const out: i32[] = []
  for cp in k {
    if cp == 126 {
      out.push(126)
      out.push(48)
    } else {
      if cp == 47 {
        out.push(126)
        out.push(49)
      } else {
        out.push(cp)
      }
    }
  }
  fromCodePoints(out)
}

// ── the renderer ───────────────────────────────────────────────────────────

// Whether `x` has a JSON spelling. NaN fails its own equality; the infinities
// are the only finite-comparison failures left once NaN is gone.
function isFiniteF64(x: f64): boolean {
  if x != x { return false }
  if x > 1.7976931348623157e308 { return false }
  if x < -1.7976931348623157e308 { return false }
  true
}

// `toString` is ECMA-262 `Number::toString` and is right for every f64 except
// negative zero, which it prints as `0`. The sign is KEPT: RFC 8259 admits `-0`,
// Go, serde and Python all round-trip it, and JS alone loses it — `toJson`'s block
// states the exception, this is why it exists.
function numText(x: f64): string {
  if x == 0.0 && 1.0 / x < 0.0 { return "-0" }
  toString(x)
}

function hexDigit(v: i32): i32 {
  if v < 10 { return 48 + v }
  97 + (v - 10)
}

// The character that follows the backslash for the five control characters
// RFC 8259 gives a named escape, or 0 for every other code point. A ladder
// rather than a lookup because it inverts exactly — `simpleEscape` reads the
// same five pairs in the parse direction — and two tables that must agree is
// one more thing to get wrong (`std/base64.vl`'s `b64Char`/`b64Val` rule).
//
// `"` and `\` are NOT here: they escape to themselves, so the caller writes
// them without a table.
function namedEscape(cp: i32): i32 {
  if cp == 8 { return 98 }
  if cp == 9 { return 116 }
  if cp == 10 { return 110 }
  if cp == 12 { return 102 }
  if cp == 13 { return 114 }
  0
}

// `s` as a JSON string literal, quotes included, pushed onto `buf` as code
// points. `for cp in s` is what makes non-ASCII pass through raw and correct:
// the code point goes in whole and `fromCodePoints` re-encodes it.
function pushQuoted(buf: i32[], s: string) {
  buf.push(34)
  for cp in s {
    const named = namedEscape(cp)
    if cp == 34 || cp == 92 {
      buf.push(92)
      buf.push(cp)
    } else {
      if named != 0 {
        buf.push(92)
        buf.push(named)
      } else {
        // Everything else below U+0020 has no named escape and takes the
        // six-character form. Lowercase hex, consistently (RFC 8259 §7 allows
        // either case).
        if cp < 32 {
          buf.push(92)
          buf.push(117)
          buf.push(48)
          buf.push(48)
          buf.push(hexDigit(cp >> 4))
          buf.push(hexDigit(cp & 15))
        } else {
          buf.push(cp)
        }
      }
    }
  }
  buf.push(34)
}

function pushText(buf: i32[], s: string) {
  for cp in s { buf.push(cp) }
}

// The walk's failure, carried beside the buffer so `renderInto` can answer a
// plain `boolean` and every level can prepend its own pointer segment on the way
// out. It is ONE `JsonError | null`; `at` is not carried separately because a
// render error's `at` is always 0.
//
// ── EVERY READ OF `err` NARROWS IT IN PLACE (`if r.err != null { … r.err … }`)
// AND NEVER THROUGH A REBIND, here and in `Scan`. Neither rebind spelling runs at
// every position this module needs (D1112, D1161), and the compiler ACTIVELY
// suggests the refused one with a `redundant type annotation` hint — so this is
// not a safe cleanup. ── DO NOT MAKE `renderInto` VOID: it was once, and an
// `if`/`else` with ONE EMPTY BRANCH in a void function is check-clean and TRAPS
// (D1034). Two facts keep it away — it is not void, and no branch here is empty.
type Rend = { err: JsonError | null }

function rendFail(
  r: Rend,
  kind: "syntax" | "duplicate" | "depth" | "nonfinite",
  msg: string,
) {
  // First failure wins, and a render error's `at` is always 0.
  if r.err == null { r.err = jsonErr(0, kind, "", msg) }
}

// Re-point a propagating render error one level up. On render `path` names the
// VALUE, so EVERY level prepends its own segment — which costs nothing on the
// success path and O(depth) once, on the way out of a failure.
function underSeg(r: Rend, seg: string) {
  // D1112/D1161: `err` is narrowed IN PLACE here and everywhere else in this
  // module. Neither rebind spelling runs at both of the positions this module
  // needs — see the note at `Rend`.
  if r.err != null { r.err.path = "/" + seg + r.err.path }
}

// Walk `v` into `buf`. Answers whether it was written; `r` carries WHY when it
// was not. `depth` is the number of containers already open, so the cap is
// checked as a container is ENTERED.
//
// THE `boolean` RESULT IS LOAD-BEARING, and not only for control flow: this
// function was VOID first and TRAPPED on `unreachable` (D1034, and the note at
// `Rend`). It also lets every arm exit with a value, which D1032 makes the
// simpler spelling than a bare `return` in a function whose result type is
// inferred.
function renderInto(v: Json, buf: i32[], depth: i32, r: Rend): boolean {
  if v is null {
    pushText(buf, "null")
    return true
  }
  if v is boolean {
    if v { pushText(buf, "true") } else { pushText(buf, "false") }
    return true
  }
  if v is f64 {
    if !isFiniteF64(v) {
      rendFail(r, "nonfinite", "no JSON spelling for this number")
      return false
    }
    pushText(buf, numText(v))
    return true
  }
  if v is string {
    pushQuoted(buf, v)
    return true
  }
  if v is Json[] {
    if depth + 1 > MAX_DEPTH {
      rendFail(r, "depth", "nesting exceeds the depth cap")
      return false
    }
    buf.push(91)
    let i = 0
    while i < v.length {
      if i > 0 { buf.push(44) }
      if !renderInto(v[i], buf, depth + 1, r) {
        underSeg(r, toString(i))
        return false
      }
      i = i + 1
    }
    buf.push(93)
    return true
  }
  if v is { [string]: Json } {
    // D1029: an `is`-narrowed MAP arm still carries the union's box at every
    // delivery position; re-binding it at the arm's OWN type is what unwraps
    // it. Six of eight positions are check-clean INVALID WASM without this
    // line, so it is load-bearing and not a style choice.
    const o: { [string]: Json } = v
    if depth + 1 > MAX_DEPTH {
      rendFail(r, "depth", "nesting exceeds the depth cap")
      return false
    }
    buf.push(123)
    let first = true
    let bad = ""
    for k in o {
      if r.err == null {
        if !first { buf.push(44) }
        first = false
        pushQuoted(buf, k)
        buf.push(58)
        // D1009/D1025: the read is hoisted, and it is `Json | null` rather
        // than `Json`. A key reached by iteration is always present, so the
        // `null` face is a stored JSON null and renders as one.
        const mv = o[k]
        if mv == null {
          pushText(buf, "null")
        } else {
          if !renderInto(mv, buf, depth + 1, r) { bad = k }
        }
      }
    }
    if r.err != null {
      underSeg(r, ptrSeg(bad))
      return false
    }
    buf.push(125)
    return true
  }
  // Unreachable while `Json` has six arms and all six are above. It is a
  // FAILURE and not a silent success on purpose: a seventh arm added without a
  // branch here would otherwise write nothing and let `toJson` return a
  // document with a value missing, which is the silent-truncation shape this
  // module exists to avoid. Loud and wrong beats quiet and wrong.
  rendFail(r, "nonfinite", "no lowering for this Json arm")
  false
}

// `self` as compact RFC 8259 text, or the reason it has none. The two ways it
// can fail are a number with no JSON spelling (`NaN`, `±Infinity`) and a tree
// deeper than the cap — which is also how a cycle arrives. Nothing partial is
// ever returned: the buffer is discarded on failure.
//
// NO WHITESPACE AT ALL; pretty printing is a second FUNCTION, never a parameter.
// Objects render in INSERTION ORDER, because VL maps are, so parse→render is an
// identity on key order. Numbers go through `toString` (ECMA-262 shortest
// round-trip) with ONE exception: `-0` keeps its sign. Escapes are the RFC
// minimum with LOWERCASE hex, `/` is not escaped, and NON-ASCII — U+2028/U+2029
// included — is emitted RAW as UTF-8, which is safe because a lone surrogate
// cannot be in a VL string, so the raw path can never emit one.
export function toJson(self: Json): string | JsonError {
  const buf: i32[] = []
  const r: Rend = { err: null }
  if !renderInto(self, buf, 0, r) {
    // D1112/D1161: narrowed in place — see the note at `Rend`.
    if r.err != null { return r.err }
    // Unreachable while every `false` from `renderInto` has raised first, and
    // it carries the same `kind` the pre-D1031 flat carrier's initial values
    // produced here. It is a failure rather than a partial document on
    // purpose, and it is a `JsonError` rather than `__trap__` because this
    // module's whole contract is that neither direction traps — the same
    // argument the depth cap is built on. `msg` says what happened rather than
    // being empty, matching `renderInto`'s own seventh-arm floor twenty lines
    // up; `kind` is the least wrong of four and is not evidence about a cause
    // nothing here knows.
    return jsonErr(0, "nonfinite", "", "the renderer stopped without raising")
  }
  fromCodePoints(buf)
}

// ── the parser ─────────────────────────────────────────────────────────────

// Scanner state. The error rides HERE rather than in every return type so the
// value functions can answer a plain `Json`: a `Json | JsonError` result cannot
// be narrowed back to a `Json` for a `push` or a map store, because the residue
// of removing the error arm is the FLATTENED member list and not the registered
// name (D1030). This is a private carrier, not a second error channel — the
// surface is `Json | JsonError` in both directions.
//
// THE ERROR IS ONE `JsonError | null`, and `parseJson` hands that same object
// straight back to the caller. Reads of `err` narrow IN PLACE and never through
// a rebind; the note at `Rend` has the reason (D1112, D1161). `sealed` is how
// `path` is computed without paying for it on the success path (see `sealErr`);
// it stays a flat field because it is SCANNER bookkeeping, not part of the error.
type Scan = {
  s: string,
  i: i32,
  err: JsonError | null,
  sealed: boolean,
}

// The byte at `i`, or -1 at end of input. Every read goes through this: an
// unguarded `s[i]` past the end TRAPS, and a parser must never trap.
function byteAt(p: Scan, i: i32): i32 {
  if i < 0 || i >= p.s.length { return -1 }
  p.s[i]
}

// Raise from a SCALAR position: the enclosing container owns the pointer, so
// the error is left unsealed for it to claim. First error wins — a parse stops
// at the first fault and later positions are not meaningful.
function raise(
  p: Scan,
  at: i32,
  kind: "syntax" | "duplicate" | "depth" | "nonfinite",
  msg: string,
) {
  if p.err == null {
    p.err = jsonErr(at, kind, "", msg)
    p.sealed = false
  }
}

// Raise from a CONTAINER's own token stream (a missing `:`, an unterminated
// array). This container is the one being read, so it claims the pointer here
// and no ancestor prepends anything below it.
function raiseHere(
  p: Scan,
  at: i32,
  kind: "syntax" | "duplicate" | "depth" | "nonfinite",
  msg: string,
) {
  raise(p, at, kind, msg)
  p.sealed = true
}

// Called by a container when a CHILD failed. The first container the error
// passes through IS the container being read when it fired, so it claims the
// pointer and contributes no segment; every container above it prepends the
// segment of the child it was parsing. That builds `path` in O(depth) on the
// failure path and costs nothing on the success path.
function sealErr(p: Scan, seg: string) {
  // D1112/D1161: narrowed in place — see the note at `Rend`.
  if p.err != null {
    if p.sealed { p.err.path = "/" + seg + p.err.path } else { p.sealed = true }
  }
}

function isWs(c: i32): boolean { c == 32 || c == 9 || c == 10 || c == 13 }

function skipWs(p: Scan) {
  while p.i < p.s.length && isWs(p.s[p.i]) { p.i = p.i + 1 }
}

function isDigit(c: i32): boolean { c >= 48 && c <= 57 }

function hexVal(c: i32): i32 {
  if c >= 48 && c <= 57 { return c - 48 }
  if c >= 97 && c <= 102 { return c - 97 + 10 }
  if c >= 65 && c <= 70 { return c - 65 + 10 }
  -1
}

// The four hex digits of a `\uXXXX` at `p.i`, or -1. Does not advance.
function hex4(p: Scan): i32 {
  let v = 0
  let k = 0
  while k < 4 {
    const d = hexVal(byteAt(p, p.i + k))
    if d < 0 { return -1 }
    v = v * 16 + d
    k = k + 1
  }
  v
}

// The code point a one-character escape names, or -1 if it names none. `/` is
// escapable on input even though the renderer never escapes it — RFC 8259
// allows `\/` and every producer that HTML-escapes emits it. The five control
// escapes here are the same five `namedEscape` writes in the render direction,
// read backwards.
function simpleEscape(e: i32): i32 {
  if e == 34 { return 34 }
  if e == 92 { return 92 }
  if e == 47 { return 47 }
  if e == 98 { return 8 }
  if e == 102 { return 12 }
  if e == 110 { return 10 }
  if e == 114 { return 13 }
  if e == 116 { return 9 }
  -1
}

// A `\uXXXX` escape whose backslash is at `esc` and whose `u` has just been
// consumed. Pushes one code point, combining a surrogate PAIR into the single
// character it names. Answers whether it succeeded.
function pUnicodeEscape(p: Scan, buf: i32[], esc: i32): boolean {
  const hi = hex4(p)
  if hi < 0 {
    raise(p, esc, "syntax", "\\u needs four hex digits")
    return false
  }
  p.i = p.i + 4
  if hi >= 55296 && hi <= 56319 {
    // A high surrogate is text only as the first half of a pair, and the
    // second half has to be spelled as its own escape.
    if byteAt(p, p.i) != 92 || byteAt(p, p.i + 1) != 117 {
      raise(p, esc, "syntax", "lone high surrogate escape")
      return false
    }
    p.i = p.i + 2
    const lo = hex4(p)
    if lo < 0 {
      raise(p, esc, "syntax", "\\u needs four hex digits")
      return false
    }
    if lo < 56320 || lo > 57343 {
      raise(p, esc, "syntax", "high surrogate not followed by a low surrogate")
      return false
    }
    p.i = p.i + 4
    buf.push(65536 + ((hi - 55296) * 1024) + (lo - 56320))
    return true
  }
  if hi >= 56320 && hi <= 57343 {
    raise(p, esc, "syntax", "lone low surrogate escape")
    return false
  }
  buf.push(hi)
  true
}

// A JSON string literal starting at the opening quote. Returns the decoded
// value; on failure sets the scanner's error and returns `""`.
//
// TWO ROUTES, and the header says why: with NO escape the value is one
// byte-exact `slice`; the first escape switches it onto a code-point buffer,
// which is exact for well-formed UTF-8 and substitutes U+FFFD for a malformed
// byte the slice route would have passed through. That disagreement is real,
// documented at the top of this file, and is the price of not carrying a second
// UTF-8 decoder.
function pString(p: Scan): string {
  p.i = p.i + 1
  const start = p.i
  const buf: i32[] = []
  let escaped = false
  let runStart = start
  let out = ""
  let done = false
  while !done {
    const c = byteAt(p, p.i)
    if c < 0 {
      raise(p, p.s.length, "syntax", "unterminated string")
      return ""
    }
    if c < 32 {
      raise(p, p.i, "syntax", "raw control character in a string")
      return ""
    }
    if c == 34 {
      // With no escape anywhere, the value IS the input's bytes and one slice
      // delivers them; nothing is decoded and nothing is re-encoded.
      if escaped {
        for cp in p.s.slice(runStart, p.i) { buf.push(cp) }
        out = fromCodePoints(buf)
      } else {
        out = p.s.slice(start, p.i)
      }
      p.i = p.i + 1
      done = true
    } else {
      if c == 92 {
        // The first escape switches this literal onto the buffer route; the
        // raw run before it is carried across as code points.
        escaped = true
        for cp in p.s.slice(runStart, p.i) { buf.push(cp) }
        const esc = p.i
        p.i = p.i + 1
        const e = byteAt(p, p.i)
        const simple = simpleEscape(e)
        if simple >= 0 {
          buf.push(simple)
          p.i = p.i + 1
        } else {
          if e != 117 {
            raise(p, esc, "syntax", "unknown escape")
            return ""
          }
          p.i = p.i + 1
          if !pUnicodeEscape(p, buf, esc) { return "" }
        }
        runStart = p.i
      } else {
        p.i = p.i + 1
      }
    }
  }
  out
}

// A number lexeme validated against RFC 8259 §6 BY HAND, then converted.
// `parseF64` is the conversion and never the gate — it accepts `01`, `NaN` and
// `Infinity`, which JSON does not.
function pNumber(p: Scan): Json {
  const start = p.i
  if byteAt(p, p.i) == 45 { p.i = p.i + 1 }
  const intStart = p.i
  if byteAt(p, p.i) == 48 {
    p.i = p.i + 1
    if isDigit(byteAt(p, p.i)) {
      raise(p, intStart, "syntax", "a number may not have a leading zero")
      return null
    }
  } else {
    if !isDigit(byteAt(p, p.i)) {
      raise(p, p.i, "syntax", "a number needs a digit")
      return null
    }
    while isDigit(byteAt(p, p.i)) { p.i = p.i + 1 }
  }
  if byteAt(p, p.i) == 46 {
    p.i = p.i + 1
    if !isDigit(byteAt(p, p.i)) {
      raise(p, p.i, "syntax", "a fraction needs a digit after the point")
      return null
    }
    while isDigit(byteAt(p, p.i)) { p.i = p.i + 1 }
  }
  const e = byteAt(p, p.i)
  if e == 101 || e == 69 {
    p.i = p.i + 1
    const sign = byteAt(p, p.i)
    if sign == 43 || sign == 45 { p.i = p.i + 1 }
    if !isDigit(byteAt(p, p.i)) {
      raise(p, p.i, "syntax", "an exponent needs a digit")
      return null
    }
    while isDigit(byteAt(p, p.i)) { p.i = p.i + 1 }
  }
  const lex = p.s.slice(start, p.i)
  const v = parseF64(lex)
  if v == null {
    // Defensive: the scan above accepts a subset of what `parseF64` does.
    raise(p, start, "syntax", "not a number")
    return null
  }
  if !isFiniteF64(v) {
    raise(p, start, "nonfinite", "number out of range for a double")
    return null
  }
  v
}

// `word` at `p.i`, consumed. The three JSON literals are the only keywords.
function eatWord(p: Scan, word: string): boolean {
  let k = 0
  while k < word.length {
    if byteAt(p, p.i + k) != word[k] { return false }
    k = k + 1
  }
  p.i = p.i + word.length
  true
}

function pArray(p: Scan, depth: i32): Json {
  if depth + 1 > MAX_DEPTH {
    raiseHere(p, p.i, "depth", "nesting exceeds the depth cap")
    return null
  }
  p.i = p.i + 1
  const a: Json[] = []
  skipWs(p)
  if byteAt(p, p.i) == 93 {
    p.i = p.i + 1
    return a
  }
  while true {
    skipWs(p)
    const v = pValue(p, depth + 1)
    if p.err != null {
      sealErr(p, toString(a.length))
      return null
    }
    a.push(v)
    skipWs(p)
    const c = byteAt(p, p.i)
    if c == 44 {
      p.i = p.i + 1
      skipWs(p)
      if byteAt(p, p.i) == 93 {
        raiseHere(p, p.i, "syntax", "trailing comma in an array")
        return null
      }
    } else {
      if c == 93 {
        p.i = p.i + 1
        return a
      }
      if c < 0 {
        raiseHere(p, p.s.length, "syntax", "unexpected end of input")
        return null
      }
      raiseHere(p, p.i, "syntax", "expected ',' or ']' in an array")
      return null
    }
  }
  null
}

function pObject(p: Scan, depth: i32): Json {
  if depth + 1 > MAX_DEPTH {
    raiseHere(p, p.i, "depth", "nesting exceeds the depth cap")
    return null
  }
  p.i = p.i + 1
  const o: { [string]: Json } = Map()
  skipWs(p)
  if byteAt(p, p.i) == 125 {
    p.i = p.i + 1
    return o
  }
  while true {
    skipWs(p)
    const keyAt = p.i
    if byteAt(p, p.i) != 34 {
      raiseHere(p, p.i, "syntax", "expected a '\"'-quoted member name")
      return null
    }
    const k = pString(p)
    if p.err != null {
      sealErr(p, "")
      return null
    }
    // I-JSON (RFC 7493 §2.3) and serde ruling A: a repeat is refused, and `at`
    // points at the SECOND occurrence.
    if o.has(k) {
      raiseHere(p, keyAt, "duplicate", "duplicate member name")
      return null
    }
    skipWs(p)
    if byteAt(p, p.i) != 58 {
      raiseHere(p, p.i, "syntax", "expected ':' after a member name")
      return null
    }
    p.i = p.i + 1
    skipWs(p)
    const v = pValue(p, depth + 1)
    if p.err != null {
      sealErr(p, ptrSeg(k))
      return null
    }
    o[k] = v
    skipWs(p)
    const c = byteAt(p, p.i)
    if c == 44 {
      p.i = p.i + 1
      skipWs(p)
      if byteAt(p, p.i) == 125 {
        raiseHere(p, p.i, "syntax", "trailing comma in an object")
        return null
      }
    } else {
      if c == 125 {
        p.i = p.i + 1
        return o
      }
      if c < 0 {
        raiseHere(p, p.s.length, "syntax", "unexpected end of input")
        return null
      }
      raiseHere(p, p.i, "syntax", "expected ',' or '}' in an object")
      return null
    }
  }
  null
}

function pValue(p: Scan, depth: i32): Json {
  const c = byteAt(p, p.i)
  if c < 0 {
    raise(p, p.s.length, "syntax", "unexpected end of input")
    return null
  }
  if c == 123 { return pObject(p, depth) }
  if c == 91 { return pArray(p, depth) }
  if c == 34 { return pString(p) }
  if c == 45 || isDigit(c) { return pNumber(p) }
  if c == 116 {
    if eatWord(p, "true") { return true }
    raise(p, p.i, "syntax", "expected 'true'")
    return null
  }
  if c == 102 {
    if eatWord(p, "false") { return false }
    raise(p, p.i, "syntax", "expected 'false'")
    return null
  }
  if c == 110 {
    if eatWord(p, "null") { return null }
    raise(p, p.i, "syntax", "expected 'null'")
    return null
  }
  raise(p, p.i, "syntax", "unexpected byte where a value was expected")
  null
}

// A parsed `Json` re-delivered as `Json | JsonError`. The whole ladder exists
// because the alias is not a member of its own composition: `return v` for a
// `v: Json` is `expected Json | JsonError, got Json`, so each arm is handed
// over at its own spelling. The map arm additionally needs the D1029 re-bind —
// without it this function is check-clean INVALID WASM.
function asResult(v: Json): Json | JsonError {
  if v is boolean { return v }
  if v is f64 { return v }
  if v is string { return v }
  if v is Json[] { return v }
  if v is { [string]: Json } {
    const o: { [string]: Json } = v
    return o
  }
  null
}

// The `Json` `self` holds, or why it is not JSON. See the module header for the
// profile. A parse NEVER TRAPS and never returns a partial tree.
//
// ── READ THIS BEFORE WRITING A CONSUMER: THE RESULT DOES NOT FLOW BACK INTO
// `toJson` YET (D1030). Narrowing away `JsonError` leaves the FLATTENED member
// list rather than the name `Json`, so `toJson(r)`, `r.toJson()` and
// `const v: Json = r` are all refused at CHECK — loud, but none of them compiles.
// Narrow to the ONE arm you want instead (re-binding a map arm at its own type,
// D1029), or re-deliver each arm at its own spelling, the ladder `asResult` uses.
// AND ONE A WALKER TRIPS ON (D1033): a string INDEX handed straight to a
// value-union parameter — `k[i].toString()` — is check-clean INVALID WASM when
// `k` was narrowed out of `Json`; hoist it as `const b: i32 = k[i]` first.
export function parseJson(self: string): Json | JsonError {
  // The BOM is the one input where the byte the user sees and the byte the
  // parser sees differ, so it is named rather than reported as a stray byte.
  if self.length >= 3 && self[0] == 239 && self[1] == 187 && self[2] == 191 {
    return jsonErr(0, "syntax", "", "leading byte-order mark")
  }
  const p: Scan = { s: self, i: 0, err: null, sealed: false }
  skipWs(p)
  if p.i >= self.length {
    return jsonErr(self.length, "syntax", "", "unexpected end of input")
  }
  const v = pValue(p, 0)
  // D1112/D1161: narrowed in place — see the note at `Rend`. Since D1031 closed
  // this is the SAME object the scanner raised, not a copy of its fields.
  if p.err != null { return p.err }
  skipWs(p)
  if p.i < self.length {
    return jsonErr(
      p.i,
      "syntax",
      "",
      "trailing content after the top-level value",
    )
  }
  asResult(v)
}
