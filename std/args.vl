// `std:args` — the program's command-line arguments, as text.
//
//     import { programArgs, Utf8Error } from "std:args"
//
// `programArgs()` is the whole surface. Index 0 is the FIRST user argument —
// the program name is not in the list, so there is nothing to slice off — and
// nothing here parses flags: the arguments arrive as the host passed them.

import { Utf8Error, decodeUtf8 } from "std:utf8"
import { toString } from "std:fmt"

// Re-exported so a caller of `programArgs` can spell its error arm without
// a second import. It is the same type `std:utf8` exports, not a copy.
export { Utf8Error } from "std:utf8"

// Every argument the program was given, in order. No arguments is an EMPTY
// list, never an error and never null. The one failure is a single argument
// that is not UTF-8: it fails the WHOLE call with `std:utf8`'s `Utf8Error`
// naming which one, because dropping it would renumber the rest.
export function programArgs(): string[] | Utf8Error {
  const n = __args_count__()
  const out: string[] = []
  let i = 0
  while i < n {
    const raw = __args_get__(i)
    // An empty argument is both the floor's failure signal and a legitimate
    // value, so the errno is what separates them.
    if raw.length == 0 {
      if __fs_errno__() != 0 {
        __trap__("std:args: the floor refused an index below __args_count__()")
      }
    }
    const s = decodeUtf8(raw)
    if s is Utf8Error {
      // Re-spelled here so the message names which argument failed.
      return {
        at: s.at,
        byte: s.byte,
        msg: "args.programArgs: argument " +
          toString(i) +
          " is not UTF-8: " +
          s.msg,
      }
    }
    out.push(s)
    i = i + 1
  }
  out
}
