// `std:env` — reading the environment this program was started with.
//
//     import { getEnv, IoError } from "std:env"
//
// `getEnv` is the whole surface. The environment is AMBIENT — it belongs to the
// process rather than to any value here — so this module only READS it: a setter
// would change what every later read answers, including reads made by code that
// never asked, and a program that wants to pass a value somewhere should pass it.
// A value that is not text is an error rather than a silent absence, so "unset"
// and "set to something unreadable" are never the same answer.

import { EILSEQ, EINVAL, ENOENT, IoError, errnoName } from "std:fs"
import { Utf8Error, decodeUtf8, encodeUtf8 } from "std:utf8"

// Re-exported so a caller of `getEnv` can spell its error arm and branch on the codes
// this module answers with, without a second import. They are `std:fs`'s own names
// rather than copies, so one `IoError` vocabulary covers every module answering with one.
export { EILSEQ, EINVAL, IoError, errnoName } from "std:fs"

// The errno the last floor call recorded, as a positive number; 0 when it did not fail.
function lastErrno(): i32 {
  const e = __fs_errno__()
  if e < 0 { return 0 - e }
  e
}

// The value of the environment variable `name`, or `null` when it is not set. A variable
// set to the empty string answers `""`, which is NOT `null`. The `IoError` arm is for a
// question that cannot be answered: `EINVAL` for a name no environment can hold (empty,
// or containing `=` or a NUL byte), `EILSEQ` for a value that is not UTF-8.
export function getEnv(name: string): string | IoError | null {
  if name.length == 0 {
    return { code: EINVAL, msg: "env.getEnv: the name is empty" }
  }
  const raw = __env_get__(encodeUtf8(name))
  // Empty is the floor's "not set" signal, its failure signal, and a legitimately
  // empty value alike; the errno is what separates the three.
  if raw.length == 0 {
    const e = lastErrno()
    if e == ENOENT { return null }
    if e != 0 {
      return { code: e, msg: "env.getEnv " + name + ": " + errnoName(e) }
    }
  }
  const text = decodeUtf8(raw)
  if text is Utf8Error {
    return {
      code: EILSEQ,
      msg: "env.getEnv " + name + ": the value is not UTF-8: " + text.msg,
    }
  }
  text
}
