// `std:idtable` — a table keyed by small non-negative integer ids, stored as a list.
//
//     import { IdTable } from "std:idtable"   // its methods need no import
//
// For ids a program hands out itself (object handles, entity numbers): a read or write is
// one list access, with no hashing. Memory is one slot per id up to the highest ever set,
// and the table never shrinks. `ids` walks in ascending id, not insertion order, and
// `t[id]`, `t[id] = v` work too. A table cannot store `null`, and `V` is not yet supported
// as `string`, `boolean`, a literal union of strings or a function type. For large,
// negative or non-integer keys, or for insertion order, use a map (`{[i32]: V}`).

// `length` is how many ids are present; `slots` holds one entry per id up to the highest
// set. Read either; writing either silently desyncs `length`, `has` and `ids`.
export type IdTable<V> = { slots: (V | null)[], length: i32 }

// A new, empty table. Name the value type: `IdTable<Tex>()`.
export function IdTable<V>(): IdTable<V> {
  const slots: (V | null)[] = []
  return { slots: slots, length: 0 }
}

// The value stored at `id`, or `null` when there is none. A negative `id` or one past
// the highest id set is `null` too, never a trap.
export function get<V>(self: IdTable<V>, id: i32): V | null {
  if id < 0 || id >= self.slots.length { return null }
  return self.slots[id]
}

// `t[id]`: the same read as `get`.
export function "[]"<V>(self: IdTable<V>, id: i32): V | null {
  return get(self, id)
}

// Whether a value is stored at `id`. A stored `0` counts as present.
export function has<V>(self: IdTable<V>, id: i32): boolean {
  return get(self, id) != null
}

// Store `v` at `id`, replacing any value there. Grows the table to `id + 1` slots if
// needed, so a large `id` allocates. Traps on a negative `id`.
export function set<V>(self: IdTable<V>, id: i32, v: V) {
  if id < 0 { __trap__("std:idtable.set: an id cannot be negative") }
  // One `null` pushed many times: a scalar `V`'s `null` is a heap value, made once here.
  const none: V | null = null
  while self.slots.length <= id { self.slots.push(none) }
  const was = self.slots[id]
  self.slots[id] = v
  if was == null { self.length = self.length + 1 }
}

// `t[id] = v`: the same write as `set`.
export function "[]="<V>(self: IdTable<V>, id: i32, v: V) { set(self, id, v) }

// Remove the value at `id`. Answers whether one was there. The slot stays allocated.
export function delete<V>(self: IdTable<V>, id: i32): boolean {
  if id < 0 || id >= self.slots.length { return false }
  if self.slots[id] == null { return false }
  self.slots[id] = null
  self.length = self.length - 1
  return true
}

// A NEW list of the ids present, ascending. Walks every slot, so it costs the highest id.
export function ids<V>(self: IdTable<V>): i32[] {
  const out: i32[] = []
  let i = 0
  while i < self.slots.length {
    if self.slots[i] != null { out.push(i) }
    i = i + 1
  }
  return out
}
