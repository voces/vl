// `std:test` — the in-language test surface.
//
//     import { describe, it, beforeEach, expect } from "std:test"
//
// Calling `describe`/`it`/`beforeEach`/`afterEach` at a file's top level
// REGISTERS; nothing runs until `vl test` drives the file. `expect(value)`
// builds the receiver for the matchers, which read as methods:
// `expect(x).toEqual(y)`. A failed assertion aborts that one test and reports
// its own call site; a passing one does nothing. The `vlt*` exports at the
// bottom are the runner's protocol, not part of the authoring surface.

// A call site, as a value: `file` is the module key `vl test` prints as its
// header and `line`/`col` are 1-based. Every MATCHER takes a trailing
// `caller: CallerLoc = __callsite__`, which the compiler fills at the call —
// pass it explicitly to forward a helper's own location one hop, never a chain.
export type CallerLoc = { file: string, line: i32, col: i32 }

// ── the registry ─────────────────────────────────────────────────────────────

// Parallel arrays, one entry per registered test; index `i` is the runner's id.
const vltNames: string[] = []        // the test's full path (scope > … > name)
const vltBodies: (() => void)[] = [] // its body
const vltSkips: i32[] = []           // 1 = registered by `itSkip`
const vltScopes: string[] = []       // the enclosing `describe` path (hook matching)

// The `describe` path currently being registered into ("" at file scope), saved
// and restored around each `describe` body so nesting composes.
let vltScope = ""

// Hooks, also parallel: each records the `describe` scope it was declared in,
// and runs around every test at or beneath that scope.
const vltBeforeScopes: string[] = []
const vltBeforeFns: (() => void)[] = []
const vltAfterScopes: string[] = []
const vltAfterFns: (() => void)[] = []

// The message of the assertion that aborted the running test. The runner reads
// it AFTER catching the trap, so a failure is reported structurally.
let vltFailMsg = ""

// A void no-op, so a function whose real work ends in an assignment or a push
// still types as `() -> void`.
function vltDone() {}

// The same no-op, exported, for closing a test body whose last statement yields
// a value: `beforeEach(() => { hits = hits + 1  done() })`. Without it that
// body types as `() => i32` and the registration call rejects it. A body ending
// in an `expect(…)` matcher — nearly all of them — needs nothing.
export function done() {}

// ── registration ─────────────────────────────────────────────────────────────

// Group the tests registered by `body` under `name`. REGISTRATION ONLY: the
// body runs at collect time, so real work in it would run once, at the wrong
// time, for every test in the file.
export function describe(name: string, body: () => void) {
  const saved = vltScope
  if vltScope.length > 0 {
    vltScope = vltScope + " > " + name
  } else {
    vltScope = name
  }
  body()
  vltScope = saved
  vltDone()
}

// The shared registration path. `path` is the scope-qualified name the report
// and the `-t` filter both match against.
function vltRegister(name: string, body: () => void, skip: i32) {
  let path = name
  if vltScope.length > 0 { path = vltScope + " > " + name }
  vltNames.push(path)
  vltBodies.push(body)
  vltSkips.push(skip)
  vltScopes.push(vltScope)
  vltDone()
}

// Register one test.
export function it(name: string, body: () => void) {
  vltRegister(name, body, 0)
}

// Register one test as SKIPPED: it is collected and reported, and never run.
// (`.skip` is not spellable — VL has no property access on a function value.)
export function itSkip(name: string, body: () => void) {
  vltRegister(name, body, 1)
}

// Run `body` before each test at or beneath the enclosing `describe` scope.
export function beforeEach(body: () => void) {
  vltBeforeScopes.push(vltScope)
  vltBeforeFns.push(body)
  vltDone()
}

// Run `body` after each test at or beneath the enclosing `describe` scope.
// These fire in REVERSE registration order, so hooks nest the way scopes do:
// outermost `before` first, outermost `after` last.
export function afterEach(body: () => void) {
  vltAfterScopes.push(vltScope)
  vltAfterFns.push(body)
  vltDone()
}

// Does a hook declared at scope `hook` apply to a test whose scope is `test`?
// The file scope applies to everything; otherwise it is a PATH-SEGMENT prefix
// test, so a `describe("list")` hook does not leak into `describe("listener")`.
function vltInScope(hook: string, test: string) {
  if hook.length == 0 { return 1 }
  if hook == test { return 1 }
  const sep = hook + " > "
  if test.length >= sep.length {
    const head = test.slice(0, sep.length)
    if head == sep { return 1 }
  }
  0
}

// ── assertion ────────────────────────────────────────────────────────────────

// The receiver `expect` builds: the value at its own type, its rendering for a
// failure message, and the two facts the matchers need — which boolean it
// holds, and an f64's digits, which the message itself cannot show. It carries
// no location: the MATCHER owns that.
type Expectation<T> = {
  actual: T,
  negated: boolean,
  shown: string,
  isBool: boolean,
  boolVal: boolean,
  hasEcho: boolean,
  echo: f64
}

// Private and never named by a signature. Declaring it is what registers the
// scalar value types this module's generic matchers need in every module that
// links `std:test`, so a matcher instantiated at a type lacking one of them
// still validates.
type VltAtomReps = i32 | i64 | f64 | boolean | string

// The receiver for the matchers. `T` is inferred from the argument, so a call
// site reads the same for every type. The five scalar types render as
// themselves in a failure message; anything else renders `"<value>"` until VL
// has reflection. `expect` decides nothing, so it reports no location.
export function expect<T>(value: T): Expectation<T> {
  let isBool = false
  let boolVal = false
  let hasEcho = false
  let echo = 0.0
  if value is boolean {
    isBool = true
    boolVal = value
  }
  if value is f64 {
    hasEcho = true
    echo = value
  }
  return {
    actual: value,
    negated: false,
    shown: vltShow(value),
    isBool: isBool,
    boolVal: boolVal,
    hasEcho: hasEcho,
    echo: echo,
  }
}

// Invert the pass/fail sense: `expect(5).not().toEqual(6)` passes. It answers a
// fresh receiver carrying the same receipt, and reports nothing itself — the
// matcher after it is what anchors the failure location.
export function not<T>(self: Expectation<T>): Expectation<T> {
  return {
    actual: self.actual,
    negated: !self.negated,
    shown: self.shown,
    isBool: self.isBool,
    boolVal: self.boolVal,
    hasEcho: self.hasEcho,
    echo: self.echo,
  }
}

// Record the rendered message and abort the test. The runner catches the trap,
// reads the message back, and continues with the next test.
function vltAbort(msg: string) {
  vltFailMsg = msg
  __trap__()
}

// One decimal digit as its character.
function vltDigit(d: i64) {
  if d == 0 { return "0" }
  if d == 1 { return "1" }
  if d == 2 { return "2" }
  if d == 3 { return "3" }
  if d == 4 { return "4" }
  if d == 5 { return "5" }
  if d == 6 { return "6" }
  if d == 7 { return "7" }
  if d == 8 { return "8" }
  "9"
}

// Decimal rendering of any i64, i64 min included. Kept here rather than
// imported so this module — the surface that reports every other module's
// failures — has no dependencies of its own to be broken by.
function vltI64Str(v: i64) {
  if v == 0 { return "0" }
  let n = v
  let neg = false
  if v > 0 { n = 0 - v } else { neg = true }
  let out = ""
  while n < 0 {
    const d = 0 - (n % 10)
    out = vltDigit(d) + out
    n = n / 10
  }
  if neg { return "-" + out }
  out
}

// The one render ladder: the scalar forms, and `"<value>"` for anything else.
// It has no side effects — an f64's digits are echoed by the failure paths.
function vltShow<T>(value: T): string {
  let shown = "<value>"
  if value is string { shown = "\"" + value + "\"" }
  if value is boolean {
    if value { shown = "true" } else { shown = "false" }
  }
  if value is i32 { shown = vltI64Str(value as! i64) }
  if value is i64 { shown = vltI64Str(value) }
  if value is f64 { shown = "<f64>" }
  shown
}

// `file:line:col`, or `""` when the location cannot name a file — a message
// reading `at :9:1` would be worse than one with no location at all.
function vltLocStr(loc: CallerLoc) {
  if loc.file.length == 0 { return "" }
  loc.file +
    ":" +
    vltI64Str(loc.line as! i64) +
    ":" +
    vltI64Str(loc.col as! i64)
}

// Assemble the failure message from already-rendered strings and abort.
// `kind`: 0 = toEqual, 1 = toBeTrue, 2 = toBeFalse. THE LOCATION LINE IS LAST
// AND NOTHING MAY BE APPENDED AFTER IT — the editor reads the last match, so a
// line added here silently re-anchors every failure. Add it BEFORE the location.
function vltFail(
  shownA: string,
  negated: boolean,
  kind: i32,
  shownE: string,
  loc: CallerLoc,
) {
  let tail = "be true"
  if kind == 0 { tail = "equal " + shownE }
  if kind == 2 { tail = "be false" }
  let sense = "to "
  if negated { sense = "not to " }
  let msg = "expected " + shownA + " " + sense + tail
  const at = vltLocStr(loc)
  if at.length > 0 { msg = msg + "\n  at " + at }
  vltAbort(msg)
}

// Equality at `T`'s own `==`, jest-style: value equality per element or field
// wherever the language defines it. Both operands are `T`, so a cross-type pair
// (`expect(4).toEqual("4")`) is refused at compile time. `caller` is normally
// omitted; pass it to forward a wrapper's own location.
export function toEqual<T>(
  self: Expectation<T>,
  expected: T,
  caller: CallerLoc = __callsite__,
) {
  const a = self.actual
  const ok = a == expected
  let bad = !ok
  if self.negated { bad = ok }
  if bad {
    if self.hasEcho { print(self.echo) }
    if expected is f64 { print(expected) }
    vltFail(self.shown, self.negated, 0, vltShow(expected), caller)
  }
  vltDone()
}

// The receiver holds boolean `true`. A NON-boolean receiver is never true, so
// `expect(5).toBeTrue()` compiles and fails at run time. Forward a wrapper's
// location with `expect(v).toBeTrue(caller)`, where it is the only argument.
export function toBeTrue<T>(
  self: Expectation<T>,
  caller: CallerLoc = __callsite__,
) {
  let ok = false
  if self.isBool { ok = self.boolVal }
  let bad = !ok
  if self.negated { bad = ok }
  if bad { vltFail(self.shown, self.negated, 1, self.shown, caller) }
  vltDone()
}

// The receiver holds boolean `false`. Non-boolean receivers fail at run time,
// as in `toBeTrue`, and `caller` forwards the same way.
export function toBeFalse<T>(
  self: Expectation<T>,
  caller: CallerLoc = __callsite__,
) {
  let ok = false
  if self.isBool { ok = !self.boolVal }
  let bad = !ok
  if self.negated { bad = ok }
  if bad { vltFail(self.shown, self.negated, 2, self.shown, caller) }
  vltDone()
}

// Fail the running test outright with `msg` — the escape hatch for a condition
// no matcher expresses. It takes no `CallerLoc`, so `msg` is the whole report
// and std does not vouch for a location typed into it. No `toBe`, `toThrow`
// or `toBeNull` yet.
export function fail(msg: string) { vltAbort(msg) }

// ── the runner protocol ──────────────────────────────────────────────────────

// Read by the host after instantiation, once the start function has registered
// everything. `vl test` re-exports these into each `*.test.vl` module it
// compiles; a test file never calls them.

// How many tests this file registered.
export function vltCount(): i32 { vltNames.length }

// Code-point length of test `i`'s scope-qualified name.
export function vltNameLen(i: i32): i32 { vltNames[i].length }

// Code point `j` of test `i`'s name.
export function vltNameAt(i: i32, j: i32): i32 { vltNames[i][j] }

// 1 when test `i` was registered by `itSkip`.
export function vltSkipped(i: i32): i32 { vltSkips[i] }

// Run test `i` with its hook chain. 0 = passed, 1 = skipped; a FAILURE does not
// return, because the assertion traps and the host reads the message back.
export function vltRun(i: i32): i32 {
  vltFailMsg = ""
  if vltSkips[i] != 0 { return 1 }
  const scope = vltScopes[i]
  let h = 0
  while h < vltBeforeScopes.length {
    if vltInScope(vltBeforeScopes[h], scope) != 0 {
      const before = vltBeforeFns[h]
      before()
    }
    h = h + 1
  }
  const body = vltBodies[i]
  body()
  let a = vltAfterScopes.length - 1
  while a >= 0 {
    if vltInScope(vltAfterScopes[a], scope) != 0 {
      const after = vltAfterFns[a]
      after()
    }
    a = a - 1
  }
  0
}

// Code-point length of the last failure message. 0 means the trap carried none
// — a bare `__trap__()` or an out-of-bounds index rather than an assertion.
export function vltFailLen(): i32 { vltFailMsg.length }

// Code point `j` of the last failure message.
export function vltFailAt(j: i32): i32 { vltFailMsg[j] }
