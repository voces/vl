// `std:fs` — reading and writing whole files, and listing directories.
//
//     import { readTextFile, writeTextFile, listDir, IoError } from "std:fs"
//
// Errors are VALUES: every fallible export answers `T | IoError` and nothing here
// traps. These are FREE functions and not methods — the thing operated on is the
// FILE, so `path` leads and `"a.txt".readTextFile()` is deliberately unspellable.
// Paths are strings and contents are bytes; text is a decoding on top, which is
// why `readFile` and `readTextFile` are two functions rather than one with a flag.
// No path manipulation, no open handles, no partial reads: every read is whole-file.

import { Utf8Error, decodeUtf8, decodeUtf8At, encodeUtf8 } from "std:utf8"
import { toString } from "std:fmt"

// A failed operation. `code` is the WASI errno as a POSITIVE number — the
// constants below name the ones worth branching on — and `msg` is a sentence
// naming the operation and the path.
export type IoError = { code: i32, msg: string }

// What an operation answers when success has nothing to report: a reason, or
// `null` for "it worked". Call sites read `if e != null { … }`.
export type IoResult = IoError | null

// What a path names. A literal union, so `match` over it is exhaustive and a
// third answer added later makes every existing `match` fail loudly.
export type FileKind = "file" | "dir"

// The errnos worth naming, in WASI preview1's numbering. Everything else is
// reported by number.
export const EACCES = 2
export const EILSEQ = 25
export const EINVAL = 28
export const EIO = 29
export const EISDIR = 31
export const ENOENT = 44
export const ENOSPC = 51
export const ENOTDIR = 54
export const EPERM = 63

// The errno as a short name, or `"errno N"` for the rest.
function errName(code: i32) {
  if code == EACCES { return "EACCES (permission denied)" }
  if code == EILSEQ { return "EILSEQ (invalid byte sequence)" }
  if code == EINVAL { return "EINVAL (invalid argument)" }
  if code == EIO { return "EIO (i/o error)" }
  if code == EISDIR { return "EISDIR (is a directory)" }
  if code == ENOENT { return "ENOENT (no such file or directory)" }
  if code == ENOSPC { return "ENOSPC (no space left on device)" }
  if code == ENOTDIR { return "ENOTDIR (not a directory)" }
  if code == EPERM { return "EPERM (operation not permitted)" }
  "errno " + toString(code)
}

// The one message shape, so every error out of this module reads the same.
function failed(op: string, path: string, code: i32) {
  "fs." + op + " " + path + ": " + errName(code)
}

// The errno of the call that just answered empty, as a positive number; 0 when
// that call did not fail.
function lastErrno(): i32 {
  const e = __fs_errno__()
  if e < 0 { return 0 - e }
  e
}

// Whether an empty result from the floor was a failure, and if so which. 0
// means the file or directory really is empty.
function emptyErrno(): i32 { lastErrno() }

// Every entry point rejects an empty path before the syscall — the one policy
// applied ahead of the host, so the answer is the same everywhere.
function emptyPathMsg(op: string) { "fs." + op + ": the path is empty" }

// The whole file as bytes, or why not. This is the function that reads a PNG.
// Whole-file only: the result is as large as the file.
export function readFile(path: string): u8[] | IoError {
  if path.length == 0 { return { code: EINVAL, msg: emptyPathMsg("readFile") } }
  const r = __fs_read__(encodeUtf8(path))
  // Empty is both the floor's failure signal and a legitimately empty file.
  if r.length == 0 {
    const e = emptyErrno()
    if e != 0 { return { code: e, msg: failed("readFile", path, e) } }
  }
  r
}

// The whole file decoded as UTF-8, or why not. Two failures share one type:
// the read can fail with any errno, and the DECODE fails with `EILSEQ` when
// the file is not text. Read bytes and decode them yourself to be lossy.
export function readTextFile(path: string): string | IoError {
  if path.length == 0 {
    return { code: EINVAL, msg: emptyPathMsg("readTextFile") }
  }
  const bytes = readFile(path)
  if bytes is IoError { return bytes }
  const text = decodeUtf8(bytes)
  if text is Utf8Error {
    return { code: EILSEQ, msg: "fs.readTextFile " + path + ": " + text.msg }
  }
  text
}

// Replace the file's contents with `data`. Answers `null` on success, since a
// whole-file write has nothing to report. Whether the file is created,
// truncated or replaced atomically is the host's policy, not this module's.
export function writeFile(path: string, data: u8[]): IoResult {
  if path.length == 0 {
    return { code: EINVAL, msg: emptyPathMsg("writeFile") }
  }
  const rc = __fs_write__(encodeUtf8(path), data)
  if rc == 0 { return null }
  let code = EIO
  if rc < 0 { code = 0 - rc }
  { code: code, msg: failed("writeFile", path, code) }
}

// The same, encoding `text` as UTF-8 first. Encoding cannot fail, so this adds
// no failure mode.
export function writeTextFile(path: string, text: string): IoResult {
  if path.length == 0 {
    return { code: EINVAL, msg: emptyPathMsg("writeTextFile") }
  }
  writeFile(path, encodeUtf8(text))
}

// The entries of a directory, as NAMES rather than paths — re-attach the
// directory with `dir + "/" + name`. `"."` and `".."` are not included and
// the order is the host's. One entry that is not UTF-8 fails the whole call,
// because silently dropping a file that exists is a wrong answer.
export function listDir(path: string): string[] | IoError {
  if path.length == 0 { return { code: EINVAL, msg: emptyPathMsg("listDir") } }
  const block = __fs_list__(encodeUtf8(path))
  // An empty block is a failure or an empty directory; the errno separates them.
  if block.length == 0 {
    const e = emptyErrno()
    if e != 0 { return { code: e, msg: failed("listDir", path, e) } }
  }
  const out: string[] = []
  let start = 0
  let i = 0
  // One past the end, so the final entry — which has no separator after it — is
  // emitted by the same branch as every other.
  while i <= block.length {
    let atSep = i == block.length
    if !atSep { atSep = block[i] == 0x00 }
    if atSep {
      // A filename is never empty, so a zero-length run carries no information.
      if i > start {
        const name = decodeUtf8At(block, start, i - start)
        if name is Utf8Error {
          return {
            code: EILSEQ,
            msg: "fs.listDir " +
              path +
              ": entry at byte " +
              toString(start + name.at) +
              " is not UTF-8",
          }
        }
        out.push(name)
      }
      start = i + 1
    }
    i = i + 1
  }
  out
}

// What `path` names, or why the question could not be answered. A missing path
// is an ERROR here (`ENOENT`), not a third kind — `pathExists` is the function
// that turns that into a boolean, and it is separate on purpose.
export function pathKind(path: string): FileKind | IoError {
  if path.length == 0 { return { code: EINVAL, msg: emptyPathMsg("pathKind") } }
  const k = __fs_stat__(encodeUtf8(path))
  if k == 0 { return "file" }
  if k == 1 { return "dir" }
  let code = EIO
  if k < 0 { code = 0 - k }
  { code: code, msg: failed("pathKind", path, code) }
}

// Whether `path` names anything, or why that is unanswerable. Only `ENOENT`
// and `ENOTDIR` become `false`; everything else — a permission error above
// all — propagates with its reason intact, rather than reading as absence.
export function pathExists(path: string): boolean | IoError {
  const k = pathKind(path)
  if k is IoError {
    if k.code == ENOENT { return false }
    if k.code == ENOTDIR { return false }
    return k
  }
  true
}
