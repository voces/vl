// `std:array` — pure-VL array/list helpers over the intrinsic floor (the emitter
// provides the list primitives `.push` / `.length` / indexing / `map` / `filter`;
// these derived methods are written in VL on top of them, the array dual of
// `std:fmt`). Each takes a `self` first parameter, so it reads as a UFCS method on
// the receiver (`xs.indexOf(3)`, `xs.includes(3)`). All are GENERIC in the element
// type `T`, so one definition serves `i32[]`, `string[]`, … — `==` resolves per
// element type.
//
// The first group is the SEARCH family (each returns an i32 / boolean, building no
// new collection); the second is the BUILDING family (`reverse` / `concat` /
// `mapIndexed` / `sorted`, each returning a NEW list); the third is the ORDERING pair
// `sort` / `sorted`, which is the one place the module has both a mutating and a
// building spelling of the same operation. The building family is
// GENERIC over the element type too: a generic `const out: T[] = []` followed by
// `out.push(…)` now propagates `T` through monomorphization, so one definition
// builds the right list per instantiation. (`slice` and the bare `map`/`filter` are
// emitter primitives; these add what the floor does not cover.)
//
// EXACTLY ONE EXPORT MUTATES ITS RECEIVER — `sort`. Everything else leaves it alone
// (the SEARCH family builds nothing at all; the BUILDING family returns a new list). That is
// worth stating because the module briefly claimed the stronger rule ("nothing here
// mutates"), and the stronger rule was wrong on its own terms: it was a description of
// nine transformers, not a principle. `sort`'s block below has the argument. What the
// rule DOES still buy is that mutation is visible in the name: VL lists are REFERENCE
// types with no ownership discipline, so a mutating helper reorders every other binding
// that aliases the same list — and the only export that does it is the one whose name
// is the bare imperative verb.
//
// HOW FAR THE GENERIC SURFACE REACHES — THREE KINDS of answer, and the count that matters is
// the kind, not the cause: a LOUD CHECKER ERROR, an HONEST refusal that writes nothing, and a
// `vl check`-CLEAN INVALID MODULE. A `u8[]` is the first at every spelling; a struct element
// is the second; the third has one member left, and it is NO LONGER THE NARROWED ONE — two
// `reduce` instances in one program whose accumulators are a declared UNION and a MEMBER
// STRUCT of that union, below. Every export here is `<T>` over a `T[]`, and each cell below
// was RUN, not assumed.
// All of this is pre-existing compiler behaviour rather than anything std chose, but it decides
// what this module can be used for.
//
//   ADMITTED: `i32`, `i64`, `f64`, `boolean`, `string`, nested lists (`i32[][]`), and STRING
//   or NUMERIC LITERAL UNIONS at every position this module has — element, `needle` argument,
//   `reduce` accumulator, callback result. This list carried TWO carve-outs and carries none
//   keyed on the ELEMENT TYPE, and that sentence is the one this header has been wrong about
//   most often, so read the record below before treating it as a clearance: it is a claim
//   about a compiler that changed, re-derived by running every position, not an inherited one.
//   ONE CARVE-OUT SURVIVES AND IT IS NOT KEYED ON THE ELEMENT TYPE AT ALL, and its subject
//   has CHANGED: it is no longer the narrowed nullable union ARM (retired below) but the
//   pair of `reduce` instances that sits one cell over from it — a declared UNION
//   accumulator and a MEMBER STRUCT accumulator, in ONE program. The narrowed nullable
//   CALLBACK that used to stand here is retired too.
//
//   A STRUCT ELEMENT is refused at EMIT with a clean error ("monomorphize:
//   unsupported argument type for `self`"). Plain `vl check` reports the program
//   clean; `vl build` / `vl run` / `vl check --codegen` all say no. The same refusal
//   is pinned on hand-written generics in
//   `tests/cases/generics/error-genapp-tyaram-*.vl`;
//   `tests/cases/std/error-array-struct-element.vl` pins it against `sorted`, where a
//   caller meets it first (sorting records by a field), and names the idiom that
//   works instead: sort an INDEX list and let the comparator read the keys out of
//   parallel arrays it closes over.
//
//   A LITERAL UNION IS ADMITTED AT EVERY POSITION AND AT EVERY DELIVERY, the nullable ones
//   now included, and this paragraph has carried a carve-out
//   at some position continuously until now, so the enumeration is per EXPORT and per
//   ARGUMENT SHAPE rather than "literal unions work": `reverse`, `concat`, `mapIndexed`,
//   `sorted` and the mutating `sort` over a `("a" | "b")[]` and a NUMERIC `(1 | 2)[]`;
//   `indexOf` / `lastIndexOf` / `includes` / `count` with a BARE MEMBER LITERAL as the
//   `needle` as well as with a bound one; `reduce` with a literal-union ELEMENT and with a
//   literal-union ACCUMULATOR; `mapIndexed` with a literal-union callback RESULT, delivered by
//   name, as a lambda WHOSE RETURN TYPE IS ANNOTATED, through a binding annotated or not, and
//   out of a list element, a struct field or a function result. The lambda's annotation is
//   load-bearing, and without it the failure is HONEST: a bare `"y"` in an unannotated lambda
//   infers `string`, so `cannot assign string[] to … of type U[]` is a check error rather than
//   a surprise.
//
//   THE REP DISAGREEMENT UNDERNEATH IS STILL REAL and it is what every closed carve-out was:
//   a literal union's members are PRESERVED in a CONTAINER (an element, a field, a map value —
//   an interned i32 ATOM) and SOFTENED as a scalar (a string ref), so a value CROSSING that
//   boundary needs a conversion. All of them are now inserted — the element READ, the element
//   STORE, the ORDERING compare, the RESULT list, the monomorphized ARGUMENT, the function-value
//   CALL RESULT, the callback reaching a call through a BINDING, and the call result stored into
//   a list or map. What made the last four one class rather than four defects is that each was a
//   producer naming one type two ways; see `ctxKeepsLitUnion`'s header for the rule.
//   `tests/cases/soundness/generic-litunion-element-bind-and-store.vl` carries the
//   element-read and element-store mechanism;
//   `tests/cases/std/array-mapindexed-litunion-result.vl` carries the RESULT-list one (the
//   `T` x `U` grid, both `U` spellings, 3- and 5-member unions, a lambda callback and an
//   empty receiver); `array-mapindexed-litunion-callback-delivery.vl` beside it is the
//   DELIVERY x SPELLING cross product; `array-litunion-needle.vl` is the `needle` argument at
//   both scopes; `array-reduce-litunion-accumulator.vl` is the accumulator in both parameter
//   orders; `tests/cases/std/array-sorted.vl` pins the ordering.
//
//   ORDERING (`<` `>` `<=` `>=`) OVER A STRING LITERAL UNION COMPARES MEMBER TEXT, at
//   every spelling of the operand — a named alias, the inline form, a `K | null` narrowed
//   non-null, and a mixed `string`/alias pair. This paragraph carried a third carve-out
//   for it until the compiler was fixed: an aliased `K` reps as the interned i32 ATOM, so
//   the ordering used to compare INTERNED IDS (first appearance in the emitted code) and
//   returned a silently wrong answer whose hazard scope was the whole compiled program.
//   `tests/cases/soundness/litunion-alias-relational-compare.vl` is the graduated pin;
//   `tests/cases/literal-unions/litunion-order-is-member-text.vl` is the grid, and
//   `litunion-order-cross-module-alias.vl` beside it is the cross-module row. A NUMERIC
//   alias (`type N = 1 | 2 | 3`) keeps the numeric compare, which is the correct order for
//   it and a cheaper one.
//
//   IF YOU CARRIED THE OLD REMEDY, DELETE IT. Widening inside the comparator
//   (`const ps: string = p`) is now redundant and costs a local for nothing. Copying to a
//   `string[]` and sorting that is not free either way — measured, it buys ~12% on the
//   compares (0.15 s against 0.17 s over 20M) at the price of an O(n) allocation and a
//   changed result type, so take it only if you wanted strings anyway.
//
//   THE NARROWED-NULLABLE-CALLBACK CARVE-OUT IS RETIRED. `const cmp: ((K, K) => boolean) | null`
//   narrowed with `is` and handed to `sorted` / `sort` / `reduce` / `mapIndexed` was
//   `vl check`-clean and an INVALID module (wasmtime: "type mismatch: expected (ref $type),
//   found (ref null $type)"); all four spellings run now, and the four are RUN in
//   `tests/cases/std/narrowed-nullable-comparator-delivery.vl` beside a `null` control.
//
//   IT WAS NOT ABOUT LITERAL UNIONS AND NOT ABOUT THIS MODULE, which is why the element-type
//   framing above could not state it and why it was called out separately. The boundary was
//   the ARGUMENT position: the narrow proves the value non-null and every consumer agrees, but
//   the value crossing the call kept its `(ref null …)` valtype while the parameter declared
//   the non-null one. The call boundary's non-null recover ladder had held that coercion for
//   `struct` and for the list/map wrappers all along and had never learned `closure` — so the
//   remedy this paragraph used to give ("call it in place") is no longer needed, and a caller
//   who took it is still correct. `tests/cases/soundness/narrowed-nullable-fn-arg.vl` is the
//   std-free mechanism pin.
//
//   THE NARROWED-UNION-ARM CARVE-OUT IS RETIRED. `reduce`'s `init: A` handed a narrowed
//   nullable union ARM — `c: Circle | null` narrowed to `Circle`, where `Circle` is a member
//   of a declared `Shape` — used to be `vl check`-clean and an INVALID module, with the SAME
//   engine message the retirement above quotes; `reduce([1, 2], bump, c)` over a
//   `Shape`-accumulating `bump` now runs and prints 8. If you carried the remedy this
//   paragraph used to imply — widen before the call — it is no longer needed and a caller who
//   took it is still correct.
//
//   THE OTHER REMEDY IT USED TO IMPLY IS THE THING THAT NOW BREAKS, so do not carry it and
//   this retirement together. "Bind a plain STRUCT accumulator instead" is still correct
//   ALONE, but a program holding BOTH it and a union accumulator that is a SUPERTYPE of that
//   struct is `vl check`-clean and an INVALID module: two `reduce` instances, `A = Circle`
//   and `A = Shape`, and the `Circle` one is refused at load. No narrowing and no nullability
//   is involved, which is why it is a different row — `silent-class-inventory.md` D26 —
//   rather than a leftover of this one. MIGRATE THE STRUCT-ACCUMULATOR CALL IN THE SAME EDIT
//   rather than leaving both spellings in the program.
//
//   IT WAS A DIFFERENT ROOT — `silent-class-inventory.md` D24 — which is why the callback
//   ladder fix did not reach it: a `Circle | null` narrowed to `Circle` is the `nulvariant`
//   NICHE, and a UNION parameter wants the `{tag, value}` BOX, so the argument needed BOXING
//   and not the ladder's non-null recover. `emitUnionBoxArg` has the niche rung now, keyed off
//   the arm-for-arm index twin of `exprNullableVariant`, and the mono pin has learned to NAME
//   a declared union arm (and, through the one shared membership list, its `| null` form) —
//   so the pin channel behind `needle: T` and the boxing channel behind `init: A` now answer
//   the same way for a declared union arm. THE `needle` POSITION ITSELF IS STILL UNREACHABLE
//   for one, and that is not the same claim: `T` is the ELEMENT type there, so a variant
//   needle forces a variant element and the call is refused at the RECEIVER
//   ("monomorphize: unsupported argument type for `self`") before the needle is looked at.
//
//   `tests/cases/std/array-reduce-narrowed-variant-init.vl` runs the retired shape through
//   THIS module; `tests/cases/soundness/nulvariant-call-boundary.vl` and
//   `…/nulvariant-generic-pin.vl` are the std-free mechanism pins.
//
//   It was found by the std review of the commit that retired the callback carve-out, against
//   that commit's own clearance — the ledger's closing rule ("re-probe when the family moves,
//   INCLUDING toward correctness") paying for itself for the second time in the same review
//   that invoked it. It paid a third time on the grid that closed it: of the 14 silent cells
//   in that grid's POSITION axis, only two (the plain call argument in each direction) were
//   the ones the filed rows described. And a fourth time in the review of THIS paragraph,
//   which is where D26 came from.
//
//   THE TWO BELOW ARE RETIRED AS WELL — the DISHONEST `needle` one and the HONEST
//   litunion-accumulator one — and the ledger counts them all as over-promises that were
//   MADE, so what they were is recorded here rather than deleted. No count is given on
//   purpose: every previous attempt to give one went stale within a commit.
//
//   THE DISHONEST ONE was a bare member LITERAL as the `needle` argument: `xs.indexOf("b")`
//   over an atom-repped `("a" | "b")[]` wrote an INVALID module that plain `vl check` called
//   clean — four lines importing only std, on the four exports taking a `needle: T`. Its root
//   was one rung below where the filing put it. The pin a monomorphized instance takes for a
//   parameter BECOMES that parameter's annotation, so it has to name the argument's TYPE; for
//   a literal-union array it named the argument's REP (`nameIsI32Array` accepts a litunion
//   `K[]`), `T` bound to plain `i32`, and the instance declared `needle` an i32 while the
//   caller pushed a string ref. Both pin channels now claim the shape. The remedy this header
//   prescribed — bind the needle first — is no longer needed, and it never worked at FUNCTION
//   scope anyway: there the same call was a LOUD `monomorphize: expected an array argument for
//   `self``, because the RECEIVER was what could not be pinned. Pinned as
//   `tests/cases/std/array-litunion-needle.vl`, both scopes.
//
//   THE HONEST ONE was `reduce` with a STRING literal-union ACCUMULATOR: refused at EMIT with
//   "literal-union string widening with no members", no invalid module and no wrong answer.
//   The deciding property was where `A` is FIRST BOUND — at `f: (A, T) => A`, a CALLBACK
//   parameter, whose pin renders each type parameter's BOUND NAME, and a literal union's bound
//   name was the SOFTENED `string`, so a type parameter that must WIDEN back to member text had
//   no member list to widen with. That render (`nominalizeFnTypeOfTy`) was a third hand-written
//   copy of the emit renderer's function-type arm and had neither of that arm's alias legs;
//   with both, `(K, i32) => K` renders as itself and `A` binds to `K` at both ends. Pinned as
//   `tests/cases/std/array-reduce-litunion-accumulator.vl`, which keeps the parameter-ORDER
//   rows: the `init`-first spelling ran while the callback-first one did not, and pinning both
//   running is what says the axis is gone rather than merely quiet.
//
//   THE SIGNATURE WAS NOT CHANGED TO ROUTE AROUND EITHER, and that decision outlived them
//   both, which is the point of it: std has NO deprecation story, so a parameter order chosen
//   for a compiler defect would have outlived the defect and could not be undone.
//
//   `tests/cases/std/array-litunion-remedies.vl` still runs both retired remedies. It is kept
//   deliberately: a remedy that is now unnecessary is still CORRECT, callers have copied it,
//   and the file is the cheapest thing that would notice if either stopped working.
//
// This paragraph first claimed literal unions worked, on the strength of a probe that
// used `reverse` — the one shape-blind export in the module. It was then rewritten to
// claim they were broken everywhere else (that one UNDER-claimed), on probes that
// predated the boundary-widen
// work. Then it over-promised twice more — it called the inline spelling a workaround
// when an unused alias defeats it, and it scoped `mapIndexed` by the RECEIVER when the
// defect is keyed on the CALLBACK'S RESULT. A std review then found two more: the
// ordering hazard's scope was the whole COMPILED PROGRAM and not the module (std's own
// `std:fs` defeated the "declare no alias" advice), and the ordering carve-out was scoped
// to "named alias" when a NUMERIC alias orders correctly. Then a SIXTH, when the
// `mapIndexed` carve-outs closed: the survivor was scoped to "a string-literal-union ALIAS
// in a non-element type parameter" and BOTH halves of that are wrong — the alias is not the
// axis (the inline spelling fails too, the moment any same-layout alias exists in the
// program), and "non-element" described where that one example's parameter happened to sit
// rather than anything measured.
//
// AND A SEVENTH, caught by the std review of the very commit that deleted the two
// `mapIndexed` rows: closing them was written up as "a literal-union ELEMENT is admitted
// with NO carve-out at all", and `xs.indexOf("b")` over a `K[]` is four lines, imports only
// std, and writes an invalid module. It is the worst-shaped over-promise this section has
// made — the strongest claim, on the dishonest failure kind, in the paragraph a caller
// reads first — and the rule that would have caught it was already written two paragraphs
// below, in the ordering carve-out's own "the hazard scope is the compiled PROGRAM".
//
// AN EIGHTH, and it is the one that makes the count worth keeping: the SEVENTH's own fix note
// said the `mapIndexed` boundary "lowers correctly in BOTH spellings, inline and a declared
// alias", and the axis that decides is one that sentence never mentions — how the CALLBACK
// reaches the call site. By name it ran; through a binding with an alias `U` it was
// check-clean invalid wasm. The grid written to satisfy "probe ARM BY ARM" had a row for
// "alias `U`, callback by name" and a row for "inline `U`, callback as a lambda" and never
// took the CROSS cell, which is the diagonal passing for a cross product.
//
// NINE over-promises, and every one of THOSE NINE subjects is now gone — a new state for
// this section, and the one it is most likely to be wrong about next. It is already half
// wrong: the review of the ninth retirement went looking for the CROSS cell that retirement
// had no fixture for and found D26, so the count of over-promises is nine and the count of
// live carve-outs is one, and those are different numbers about different things. THREE were about the ordering
// carve-out, DELETED when the compiler stopped comparing interned ids; one was `mapIndexed`
// scoped by the RECEIVER; one was the `reverse` probe; one was the `reduce` survivor's
// scoping; the seventh was the `needle` argument; the eighth was the callback DELIVERY axis;
// the ninth was a NULLABLE function value narrowed with `is`, cleared by the commit that
// found it.
// The last four all closed in one change, because they were one rule — a producer naming one
// literal-union type two ways across a boundary — and the class was worked as a CROSS PRODUCT
// rather than defect by defect, which is what the eighth over-promise cost was needed to learn.
// THE AXIS VALUES, SPELLED OUT, because a cell COUNT without them is the numerical form of the
// same mistake: delivery = by name / lambda / binding / annotated binding; spelling = alias /
// inline / inline beside an unused same-layout alias; position = argument / result / element /
// map value / return / local / push / indexed store; scope = module / function. 210 cells. The
// std review of that very commit then found a NINTH delivery the list does not contain — a
// NULLABLE function value narrowed with `is` — so read the enumeration as what was measured,
// never as what exists. The ninth's own subject is now gone as well, and it was NOT in this
// family: its root was the call boundary's non-null recover ladder, which knew `struct` and
// the list/map wrappers and had never learned `closure` or `variant`. A 192-cell grid over
// (narrowed rep × narrowing form × delivery × generic-or-not) is what separated it from the
// monomorphizer pin it superficially resembles — 26 check-clean invalid modules, 18 of them
// this ladder and 8 of them not.
//
// WHAT THE NINE BOUGHT: a generic surface has to be probed ARM BY ARM; the probe has to vary
// the dimension the claim is about, AS A CROSS PRODUCT and not as a diagonal; a remedy is not
// a remedy until it has been RUN in the situation that needs it — in a module shaped like the
// one that needs it; and the whole section has to be re-probed when the family under it moves,
// including when it moves TOWARD correctness, because a stale carve-out sends callers to a
// workaround they no longer need AND a deleted one tempts the next writer to clear the whole
// paragraph instead of re-probing it. This rewrite is the fourth time that last rule has been
// invoked. It IS the first time this paragraph has had no NARROWING carve-out to state — a
// draft of the previous rewrite claimed that prematurely and a review caught it, which is why
// the sentence is being written a second time; and it still is not a clean paragraph, because
// the review of THIS rewrite found D26 one cell over from the row it was retiring. The next
// reader's cheapest check is not to read this but to run
// `tests/cases/std/array-litunion-needle.vl` and its four neighbours.
//
// `u8[]` is separately outside the surface, and it is a CHECKER ERROR at every spelling. This
// paragraph claimed that once for the WRONG REASON — it named the storage-type diagnostic,
// which never fires here — and the retraction that followed was measured on the UFCS spelling
// only, while the DIRECT spelling had been a clean checker error the whole time. Two
// half-measurements in opposite directions on one axis; it can be stated flatly now because
// the receiver-side rung was written. `u8`'s storage-type diagnostic ("`u8` is a storage type, not a
// value type — … a generic argument is a value, and values are `i32`") fires on an EXPLICIT
// `u8` in a value position — `tests/cases/arrays/error-u8-storage-only.vl` pins its five doors
// — and a generic call over a `u8[]` spells `u8` nowhere, so it takes none of them. The rule
// that DOES cover it is its own: "`u8[]` cannot be passed to a generic parameter", because `T`
// ranges over value types and `u8` is storage, so a `u8[]` is not an instantiation of `T[]`.
//
// THAT RULE EXISTED AND REACHED ONLY HALF ITS CALLS. It sat in the direct-call argument loop,
// and `self` does not travel through an argument loop — it arrives ahead of one — so
// `indexOf(xs, 2)` was a clean checker error while `xs.indexOf(2)`, the same export on the
// same receiver, was `vl check` rc 0 over an invalid module. Every UFCS spelling measured
// (`indexOf` / `includes` / `reverse` / `concat` / `sorted`, and a hand-written generic
// importing nothing) is now the same DIAGNOSTIC as its direct twin — `concat`'s direct
// spelling reports it once per `u8[]` argument and the UFCS spelling stops at the receiver, so
// the COUNT can differ. The FOUR spellings that reached an honest emit refusal instead are
// caught at `vl check` too: three carry "monomorphize: expected an array argument for `self`",
// and a MODULE-scope `std:fs.readFile` result carries "unsupported argument type for `self`" —
// the message is keyed on the binding's SCOPE, not on where the bytes came from, and an
// enumeration that varied the source and not the scope is the diagonal this header keeps
// paying for. `tests/cases/std/error-u8-array-generic.vl`
// runs the direct/UFCS pair side by side, which is the shape that would notice a future rung
// landing on one spelling only. Byte sequences belong to `std:utf8`, whose own `u8[]` exports
// take a CONCRETE `self: u8[]` and are unaffected.

// The index of the FIRST element equal to `needle`, or -1 if absent. `==` is the
// element type's equality (value for scalars / strings, reference for functions).
// A BARE MEMBER LITERAL as the `needle` over a literal-union array (`xs.indexOf("b")` on a
// `("a" | "b")[]`) is FINE, and it is called out here because it was not: it wrote an invalid
// module that plain `vl check` called clean, on this export and on `lastIndexOf` / `includes`
// / `count`, and the header's remedy was to bind the needle first. Both are retired — module
// header for what it was; pinned as `tests/cases/std/array-litunion-needle.vl`.
export function indexOf<T>(self: T[], needle: T): i32 {
  let i = 0
  while i < self.length {
    if self[i] == needle { return i }
    i = i + 1
  }
  return -1
}

// The index of the LAST element equal to `needle`, or -1 if absent.
export function lastIndexOf<T>(self: T[], needle: T): i32 {
  let i = self.length - 1
  while i >= 0 {
    if self[i] == needle { return i }
    i = i - 1
  }
  return -1
}

// Whether any element equals `needle`.
export function includes<T>(self: T[], needle: T): boolean {
  let i = 0
  while i < self.length {
    if self[i] == needle { return true }
    i = i + 1
  }
  return false
}

// How many elements equal `needle`.
export function count<T>(self: T[], needle: T): i32 {
  let c = 0
  let i = 0
  while i < self.length {
    if self[i] == needle { c = c + 1 }
    i = i + 1
  }
  return c
}

// Left fold: thread `acc` (seeded with `init`) through `f(acc, element)` for each
// element in order, returning the final accumulator. The accumulator type `A` may
// differ from the element type `T` (summing an `i32[]` to an `i32`, joining a
// `string[]` to a `string`, summing an `f64[]` to an `f64`). The generic closure
// parameter `f: (A, T) => A` is monomorphized per call shape.
// A STRING literal-union accumulator was this module's one HONEST carve-out — refused at EMIT
// ("literal-union string widening with no members") whatever the element type — and it is
// retired: the pin that rendered `f: (A, T) => A` softened the type parameter it also had to
// widen back. Module header for what it was; pinned as
// `tests/cases/std/array-reduce-litunion-accumulator.vl`.
// A NARROWED NULLABLE UNION ARM as `init` (`c: Circle | null` narrowed to `Circle`, where
// `Circle` is a member of a declared `Shape`) was a second carve-out on this export, and it is
// retired too. Module header for what it was; pinned as
// `tests/cases/std/array-reduce-narrowed-variant-init.vl`.
// STILL LIVE, and it is the one carve-out this module has left: TWO instances in ONE program
// whose accumulators are a declared UNION and a MEMBER STRUCT of it (`A = Shape` and
// `A = Circle`). `vl check` rc 0, invalid module — `silent-class-inventory.md` D26. Either
// accumulator alone is fine; it is holding both that fails.
export function reduce<T, A>(self: T[], f: (A, T) => A, init: A): A {
  let acc = init
  let i = 0
  while i < self.length {
    acc = f(acc, self[i])
    i = i + 1
  }
  return acc
}

// ── The BUILDING family — each returns a NEW list, leaving its inputs unmutated. ──
// (`sorted` is a fourth member and lives with `sort` at the bottom of the file, so the
// ordering pair reads together.)

// `self`'s elements in reverse order.
export function reverse<T>(self: T[]): T[] {
  const out: T[] = []
  let i = self.length - 1
  while i >= 0 {
    out.push(self[i])
    i = i - 1
  }
  return out
}

// `self` followed by `other`. The element type `T` must match (`==`-comparable not
// required — this only moves elements), so a mixed-type concat does not type-check.
export function concat<T>(self: T[], other: T[]): T[] {
  const out: T[] = []
  let i = 0
  while i < self.length {
    out.push(self[i])
    i = i + 1
  }
  let j = 0
  while j < other.length {
    out.push(other[j])
    j = j + 1
  }
  return out
}

// `map` with the element INDEX: `f(element, i)` for each element, collected in
// order into a new list. The result element type `U` may differ from `T`. The
// emitter's bare `.map` passes only the element; this is the indexed companion.
// A `U` that is a STRING literal union now lowers in both the inline and the declared-ALIAS
// spelling — it did not until the RESULT-list boundary fix, so a caller carrying the old
// "declare the callback's result `string`" workaround can drop it — PROVIDED THE CALLBACK
// REACHES THE CALL SITE ANY OF THE SEVEN WAYS MEASURED — as a named function, as a lambda
// literal, through a binding annotated or not, or out of a list element, a struct field or a
// function result. Read that as what was MEASURED, not as a whitelist: the DELIVERY axis is
// called out at all because it is the axis a "both spellings work" claim here missed (an alias
// `U` through a binding was check-clean INVALID wasm while the by-name spelling ran, with no
// hint to signpost it — the missing fact was the RESULT twin of `cloCallParamLitUnion`), and
// the FIRST time this sentence enumerated it, it named four and three more were working. An
// EIGHTH delivery — a NULLABLE function value narrowed with `is`, which failed for an `i32`
// callback too — was the module header's surviving carve-out and is RETIRED;
// `tests/cases/std/narrowed-nullable-comparator-delivery.vl` runs it on this export. Grids:
// `tests/cases/std/array-mapindexed-litunion-result.vl` for `T` x `U`,
// `array-mapindexed-litunion-callback-delivery.vl` for delivery x spelling.
export function mapIndexed<T, U>(self: T[], f: (T, i32) => U): U[] {
  const out: U[] = []
  let i = 0
  while i < self.length {
    out.push(f(self[i], i))
    i = i + 1
  }
  return out
}

// ── The ORDERING pair — `sort` in place, `sorted` as a copy ────────────────────
//
// Two exports, one algorithm, and four decisions. std is version-locked to the
// compiler and has no deprecation story, so each of these is close to permanent.
//
//   sort<T>(self: T[], less: (T, T) => boolean)          // reorders self, returns nothing
//   sorted<T>(self: T[], less: (T, T) => boolean): T[]   // leaves self alone, returns a new list
//
// CONTRACT, both. Ascending under `less`. STABLE (equal elements keep their input
// order). O(n log n) comparisons in the WORST case — a bottom-up merge over runs an
// insertion sort has already ordered. Allocation is the one place the two differ, and it
// differs on BOTH sides of the base case: `sort` allocates NOTHING for n <= 16 and one
// n-element auxiliary above it, while `sorted` allocates the returned list always and
// the same auxiliary only above it — so 0 vs n below the threshold, and n vs 2n above.
//
// WHY THIS IS IN STD, by clause. `std-design.md` D1's admission principle has two
// halves and this lands on the FIRST: "(a) what the LANGUAGE story needs to be complete
// without third parties", which names collections outright — seconded by
// `perf-workstream.md` §6.2, which calls a sort "the clearest gap" and `std:array` "the
// right home". It is NOT admitted by the consumer clause: nothing in the tree imports
// it, because the compiler imports zero std modules today.
//
// AND THAT LAST FACT IS A CHOICE, NOT A LAW — this module previously said otherwise, and
// the correction matters here only for what it forbids as an ARGUMENT. D1's bar rested
// on a seed assembly that concatenated `compiler/*.vl` with import lines range-blanked;
// that assembly is gone, and a compiler module importing `std:array` was measured to
// build and work, at a real seed cost and one unmeasured fixpoint risk. The full note,
// with the quotes and the numbers, is in `std-design.md` D1 (2026-08-23) and
// `perf-workstream.md` §6.0 — the right venue for a bootstrap ruling.
//
// What it means for the pair below: it is NOT defended by "the compiler could never call
// it". It is defended on its own merits, and the compiler's four in-place sorts are cited
// as evidence about SHAPE — never as consumers, and never as impossible consumers.
//
// 1. BOTH SPELLINGS SHIP, and in place is the primary. The first draft of this module
//    shipped only `sorted`, on the argument that every other `std:array` export builds.
//    Three things beat it:
//
//    (a) IN PLACE IS THE CONVENTION, not the exception. Rust `slice::sort` (std ships no
//        copying variant at all), Go `sort.Slice`, C++ `std::sort`, Java `Arrays.sort`
//        are all in place; JS `.sort()` has always been in place and `toSorted()` is
//        ES2023. Only Python ships both. Shipping ONLY the copy was the unusual choice.
//    (b) THE COPY TAXES EXACTLY THE CALLERS THE ALGORITHM IS FOR. `sorted` is 2n against
//        `sort`'s n above the base case, and n against ZERO below it. On the short lists
//        this tree sorts that is a rounding error — but the whole reason this is
//        O(n log n) rather than an insertion sort is the caller who sorts a million
//        elements, and a copy-only
//        surface hands that caller a doubling with no way to opt out. An API whose cost
//        model fights its own justification is the wrong API.
//
//        THE WIN IS ALLOCATION, NOT TIME, and the numbers say so plainly (best-of-5,
//        ns/sort, same harness as the SORT_RUN table): n=16 420 vs 469 (`sort` allocates
//        nothing at all here, so this 10% is the whole allocation); n=1536 143,180 vs
//        142,714 — a tie, because `sort`'s copy-home and `sorted`'s extra copy cancel;
//        n=65,536 9,078,350 vs 9,195,883, 1.3%. Anyone reaching for `sort` to go faster
//        is reaching for the wrong reason; reach for it to halve the footprint.
//    (c) "NO STD EXPORT MUTATES THROUGH `self`" WAS THINNER THAN IT READ. It was really
//        "`std:array`'s nine exports are all transformers so far" — and `std:buffer`
//        already has ELEVEN `self`-first exports that mutate through the receiver
//        (`storeI32/I64/F32/F64`, `store8`, `store16`, `fill`, `setF32`, `setI32`, and
//        both `"[]="` operators), while `std:test` mutates module globals. Counted, not
//        estimated. So the rule was not thin — it was false outside this module, and
//        true inside it only because nothing had needed to mutate yet.
//
//    THE PAIR IS PYTHON'S, AND JS'S `toSorted` WAS THE OTHER CANDIDATE. Recording why
//    it lost, because #1856 is already on master and this is the last PR in which either
//    name is free. `sort`/`toSorted` differ at the FIRST character and `sort`/`sorted` at
//    the last two, so JS's pair is the more legible one — a real point against the choice
//    made here. It loses on three others: `toSorted` reads as a CONVERSION (`toStr`,
//    `toUpperAscii` in this very std turn a value into another type, and this does not);
//    it is ES2023, the newest convention in the survey rather than the settled one; and
//    every building export in std is a plain name, so a `to`-prefixed outlier would need
//    its own rule. The mitigation for the two-character gap is that the DANGEROUS
//    direction is a type error — see the void-return note below.
//
//    `reverse` IS A SHARPER PROBLEM THAN "WART" CONVEYS, and adding `sort` sharpened it:
//    the module now TEACHES "bare imperative verb = mutates" by example, and `reverse` is
//    a bare imperative verb that does not. In JS `Array.prototype.reverse()` DOES mutate
//    (`toReversed()` is ES2023, the same batch as `toSorted`), so a JS-shaped reader
//    writing `xs.reverse()` as a statement gets a silent no-op — measured: no diagnostic
//    at any severity. It cannot be renamed; std has no deprecation story. The rule going
//    forward is that a BUILDING export whose verb also names a common in-place operation
//    takes the participle.
//
//    THE VOID RETURN IS LOAD-BEARING, and it is what makes the pair safe in the direction
//    that matters. `const ys = xs.sort(less)` is a TYPE ERROR ("cannot bind the void
//    result of 'ys' — a void function returns no value"), so a reader who expects `sort`
//    to hand back the sorted list is stopped by the compiler. Had `sort` returned `self`
//    for chaining, that mistake would compile and hide the mutation. The other direction
//    has no such guard: a discarded `xs.sorted(less)` is clean at every severity, and the
//    name is the only thing arguing against it.
//
//    WHY `sorted` EARNS A SECOND PERMANENT NAME — the composability argument, which is
//    the one that survives checking. `sort` is void, so there is NO expression-position
//    spelling of "a sorted copy" without it: `xs.sorted(less)[0]` and
//    `xs.sorted(less).indexOf(9)` have no `sort`-only equivalent, and rubric §3 rates a
//    self-first export that returns something chainable above one that returns a status.
//    That, and not the shield below, is why the second name exists. (An earlier draft
//    claimed the shield was the reason. It is not: `const out = xs.slice(0)` followed by
//    `out.sort(less)` gets the IDENTICAL shield — verified, same 40/39/0/39 — because the
//    shield is bought by the COPY, and `slice` is also a copy. What `sorted` adds there
//    is only that the copy cannot be forgotten.)
//
//    A CONSEQUENCE OF THE COPY, which `xs.slice(0)` shares: a comparator that MUTATES
//    THE RECEIVER mid-sort. `sorted` snapshots — it fills its
//    working buffer and reads `n` before `less` is called even once — so such a
//    comparator changes the receiver and cannot touch the result. `sort` has no shield,
//    and the consequence is not merely a wrong answer:
//
//      A COMPARATOR THAT SHRINKS `self` MAKES `sort` TRAP. `n` is captured once, `pop()`
//      is expressible, and an index below the captured `n` is then out of bounds. Pinned
//      in `tests/cases/std/array-sort-comparator-pops-traps.vl`; the same comparator
//      under `sorted` returns a correct sort of the ORIGINAL 40 elements while the
//      receiver ends at 39 (`array-sort-inplace.vl`).
//
//      A comparator that GROWS `self` does not trap — the appended elements are simply
//      outside the captured range and are left unsorted at the end.
//
//    This is a caller error either way and neither export defends against it, but only
//    one of them turns it into a trap, and the header of a permanent API should say
//    which. (An earlier draft of this paragraph asserted `sort` "cannot trap". It was
//    wrong, and it was wrong because it reasoned about the captured bound instead of
//    running it.)
//
// 2. `less` IS A BOOLEAN STRICT LESS-THAN, not a three-way `(T, T) => i32`. A three-way
//    composes better in the abstract; in this tree it composes with nothing. All four
//    hand-written comparators in `compiler/` are two-argument boolean predicates — two
//    spelled `<` (`fmtNameLess`, `cliDiagLess`) and two spelled `>` with the arguments
//    reversed (`cliStrGt`, and a bare `pos[order[b]] > pos[key]` that is not a named
//    function at all); not one is three-way. That includes the MULTI-KEY one, which is
//    the case three-way is usually argued for: `cli.cliDiagLess` orders diagnostics by
//    line and then by column in three readable lines. Boolean also has no sign
//    convention to get backwards, and it keeps the generic closure parameter on exactly
//    the shape this module already ships and tests (`reduce`, `mapIndexed`) rather than
//    on new ground — generics through closures have been a defect source (#1823, #1827),
//    and decision 5 below is this change's own contribution to that list.
//
//    `less` may close over anything, which makes SORTING AN INDEX LIST a first-class use
//    rather than a workaround: `order.sort((a, b) => line[a] < line[b])` is how two of
//    the four in-tree sorts are already written, with the keys in parallel arrays the
//    comparator reads.
//
// 3. `less` MUST BE A STRICT ORDER — `less(a, a)` false, and `less(a, b)` and
//    `less(b, a)` never both true. An INCONSISTENT `less` is NOT undefined behaviour
//    here, and that is a guarantee rather than an implementation detail: the result is
//    an unspecified ORDER, but it is always a PERMUTATION of the input. No element is
//    lost, duplicated or invented, and — for a comparator that merely ANSWERS wrongly —
//    it never traps or reads out of bounds. Both loops
//    are bounded by INDICES rather than by the comparator (`j >= lo`, and
//    `p < mid && q < e` with unconditional drains after it), which is what buys that; a
//    sentinel-style `while less(...)` walk would run off the end instead.
//
//    READ THAT AS SCOPED TO WHAT `less` ANSWERS, not to what it does. It covers a
//    comparator that returns the wrong booleans, however wrongly. It does NOT cover a
//    comparator that MUTATES the receiver, which is a different failure with a different
//    outcome — under `sort`, shrinking `self` traps. See decision 1's last paragraph;
//    the index bounds that make a lying comparator safe are the same bounds a shrinking
//    one invalidates.
//
// 4. NOT DONE, DELIBERATELY. No `sortUnstable` — Rust and Go both split the API, but
//    that is a second name doing almost the same thing, `cli.vl` needs the stable one
//    (it orders error-tier diagnostics before lint-tier ones at the same position by
//    relying on it), and adding a name later is possible while removing one is not. No
//    `sortedBy(keyOf)` / `sortBy(keyOf)` — each is `sort` with a two-line comparator and
//    a second way to spell the same thing. No default ordering (`xs.sort()`): `<` is
//    defined for the scalars and for `string` but not for a struct or a union ("comparison
//    expects numeric operands, got P and P"), so a defaulted overload would type-check
//    for some `T` and not others, and VL has no overloading to express that. No
//    `binarySearch` / `lowerBound` — a STANDING RULING rather than a judgement made here:
//    `perf-workstream.md` §6.2 says "Zero occurrences in the tree, no consumer. The
//    admission principle excludes it by name", and a sorted list existing does not change
//    that. No adaptivity: an already-sorted input is NOT detected and still pays every
//    merge pass; the run detection that would fix it is the bulk of Timsort's machinery
//    and no measured consumer wants it.
//
// 5. THE TWO BODIES ARE DUPLICATED, AND THAT IS A COMPILER LIMITATION, NOT A CHOICE.
//    `sorted` should be four lines — copy, `sort(out, less)`, return — and it cannot be,
//    because A GENERIC FUNCTION CANNOT PASS ITS OWN GENERIC-TYPED FUNCTION PARAMETER TO
//    ANOTHER GENERIC FUNCTION. Minimal repro, no std involved:
//
//      function inner<T>(xs: T[], f: (T, T) => boolean) { f(xs[0], xs[1]) }
//      function outer<T>(xs: T[], f: (T, T) => boolean) { inner(xs, f) }   // <- refused
//      // emitProgram: monomorphize: unsupported argument type for `f` in a call to `inner`
//
//    Four spellings were tried and all four fail: the direct call, the UFCS call
//    (`xs.inner(f)`, "unsupported member-call statement"), forwarding through a local
//    binding, and re-wrapping in a fresh lambda (`(a: T, b: T) => f(a, b)`, "only i32,
//    i64, f64, f32, boolean, struct, union, array, or string parameters are supported").
//    A generic->generic call with a plain `T[]` argument works, and a NON-generic caller
//    forwarding a concrete closure into a generic function works — it is specifically the
//    generic-to-generic FUNCTION-VALUE hop that has no lowering. Pinned in
//    `tests/cases/std/error-generic-closure-forward.vl`.
//
//    THE GATE COVERS ORDER, NOT COST — worth stating precisely, because the gate is the
//    whole defence. Set `sort`'s SORT_RUN to 32 and leave `sorted`'s at 16 and every
//    assertion in the fixture still passes, while the CONTRACT's "allocates NOTHING for
//    n <= 16" quietly becomes false. Allocation is not observable from VL, so no fixture
//    can close that gap; the two constants have to be read together by hand.
//
//    THE MITIGATION IS A GATE, NOT A PROMISE. `tests/cases/std/array-sort-agrees.vl`
//    sorts every length from 0 to 200 through BOTH exports and fails if they ever
//    disagree by one element, so drift between the copies is caught by the corpus rather
//    than by a reader. WHEN THE COMPILER GROWS THIS, collapse `sorted` to copy + `sort` +
//    return; it is a pure refactor with no API change, and that fixture is what makes it
//    safe to do.
// WHERE SORT_RUN = 16 COMES FROM — it is the insertion-sort run length of the
// ORDERING pair's base case, declared inside `sort` below. IT WAS SWEPT ON `sorted`, when
// that was the only export; `sort` shares the constant and differs only by not making the
// leading copy, so the sweep transfers except at the base-case cliff itself (below n = 17
// `sort` allocates nothing where `sorted` allocates n). It is MEASURED rather than
// folklore: best-of-5 (minimum) WALL time per sort of a fresh MINSTD-seeded `i32[]`,
// comparator reached through an indirect call, native host, `RUN` swept at fixed n
// (ns/sort). `perf-workstream.md` §8.1 mandates user CPU (`%U`) and NEVER wall clock,
// because several agents share this box and wall clock has produced multi-second
// outliers on self-compiles; the minimum of five samples on a single-threaded
// in-module microbenchmark is the standard defence against exactly that, and the
// COMPARISON COUNTS below — deterministic, and §8.2's "counters before timers" —
// carry the asymptotic half of the claim without depending on the instrument at all.
// The threshold choice is the only thing resting on the timings.
//
//   n \ RUN |      8      12      16      24      32
//   ---------+---------------------------------------
//        24  |   1197     973    1014     878     845
//        48  |   2485    2293    2352    2543    2711
//        96  |   5888    5952    5874    5966    6320
//       384  |  27462   27401   27624   28777   34074
//      1536  | 151854  149404  144957  145387  149617
//      6144  | 681971  676976  678606  701796  715954
//
// 12 and 16 are jointly best from n=48 up and are within noise of each other — each
// wins two of the five rows and neither is ever more than 3% off the other. 8 never
// wins a row and pays up to 8% for the extra merge pass it forces (n=48, n=1536); 32
// is 3-24% worse from n=48 up. The n=24 row is the one place a bigger RUN wins, and it
// wins for a reason that does not generalise: 24 <= 32 means the merge never runs at
// all there. 16 is the LARGEST value that stays within 3% of the best column at every
// size from 48 up, which is why it and not 12 is the constant — a longer base run is
// the cheaper failure mode if a future caller sorts mostly-short lists.
//
// DROPPING THE BASE CASE ENTIRELY (RUN=1, a pure bottom-up merge) costs 18-63% up to
// n=256 and ~9% at n=1024 and n=16384 (best-of-3, same harness), so the insertion leaf
// is load-bearing rather than decorative.
//
// The other direction — what the generality costs a SHORT list, which is the only
// length the tree itself ever sorts — is nothing. Against a plain stable insertion
// sort (best-of-3): at n=16 both measure 0.448 us; at n=8, 0.176 vs 0.168 us (the one
// extra copy the MEASURED variant made — `sort` does not make it at all); at n=32,
// 1.328 vs 1.360 us. The crossover sits between n=32 (a tie) and
// n=64 (3.104 vs 5.792 us, 1.9x), and by n=1024 the merge is 90.5 us against insertion
// sort's 1014.5 us — 11.2x, and 10,583 comparisons against 258,411.

// Reorder `self` IN PLACE, ascending under `less`. STABLE; O(n log n) comparisons worst
// case; allocates nothing up to n = 16 and one n-element buffer above that. Returns
// nothing — the receiver IS the result. See the block above for the contract `less` must
// satisfy and for what happens when it does not.
export function sort<T>(self: T[], less: (T, T) => boolean) {
  // SORT_RUN lives INSIDE the function rather than beside the module header because a
  // module-level const is emitted as a wasm global whether or not anything imports the
  // export that reads it. THE DELTA IS 8 BYTES, and the probe is this whole program:
  //
  //   import { indexOf } from "std:array"
  //   print([1, 2, 3].indexOf(2))
  //
  // built with `vl build`, module-level `SORT_RUN` against function-local. Absolute sizes
  // are deliberately NOT quoted — they move with every unrelated std edit, and an earlier
  // draft of this comment quoted three that no longer reproduce. The delta is what the
  // argument uses. 8 bytes is small, but it is 8 bytes charged to callers who never sort,
  // and the run length is not a knob anyone outside this function can reach.
  const SORT_RUN = 16
  const n = self.length
  // A 0- or 1-element list is already sorted, and saying so by NESTING rather than with
  // an early `return` is forced: VL's emitter rejects a bare `return` in a void function
  // (the same shape `std:buffer.fill` uses).
  if n >= 2 {
    // Base case: insertion-sort each block of SORT_RUN in place. `less(key, self[j])`
    // and not `!less(self[j], key)` is what makes this half STABLE — an element stops as
    // soon as its left neighbour is not strictly greater, so equals never cross.
    let lo = 0
    while lo < n {
      let hi = lo + SORT_RUN
      if hi > n { hi = n }
      let k = lo + 1
      while k < hi {
        const key = self[k]
        let j = k - 1
        while j >= lo && less(key, self[j]) {
          self[j + 1] = self[j]
          j = j - 1
        }
        self[j + 1] = key
        k = k + 1
      }
      lo = lo + SORT_RUN
    }
    // A list that fits in one run is done. Skipping here is what makes `sort` allocate
    // NOTHING at the lengths this tree actually sorts — the whole n-vs-2n difference
    // between `sort` and `sorted` is n-vs-0 below n = 17.
    if n > SORT_RUN {
      const aux: T[] = []
      let z = 0
      while z < n {
        aux.push(self[z])
        z = z + 1
      }
      // Bottom-up merge, ping-ponging between `self` and `aux` so no pass copies back.
      // `srcIsSelf` is a parity BIT and not a comparison, because `==` on two lists is
      // not reference identity in VL and would answer a different question.
      let src = self
      let dst = aux
      let srcIsSelf = true
      let width = SORT_RUN
      while width < n {
        let s = 0
        while s < n {
          let mid = s + width
          if mid > n { mid = n }
          let e = mid + width
          if e > n { e = n }
          let p = s
          let q = mid
          let o = s
          // STABLE: the right half wins only when it is STRICTLY less, so on a tie the
          // left (earlier) element goes first.
          while p < mid && q < e {
            if less(src[q], src[p]) {
              dst[o] = src[q]
              q = q + 1
            } else {
              dst[o] = src[p]
              p = p + 1
            }
            o = o + 1
          }
          // Unconditional drains — index-bounded, so a comparator that lies still yields
          // a permutation rather than a trap.
          while p < mid {
            dst[o] = src[p]
            p = p + 1
            o = o + 1
          }
          while q < e {
            dst[o] = src[q]
            q = q + 1
            o = o + 1
          }
          s = e
        }
        const tmp = src
        src = dst
        dst = tmp
        srcIsSelf = !srcIsSelf
        width = width + width
      }
      // An ODD number of merge passes leaves the answer in `aux`; copy it home. This is
      // the one cost `sort` pays that `sorted` does not, it is n writes against the
      // merge's n log n, and it is skipped outright whenever the pass count is even.
      if !srcIsSelf {
        let i = 0
        while i < n {
          self[i] = src[i]
          i = i + 1
        }
      }
    }
  }
}

// `self`'s elements in ascending order under `less`, as a NEW list, leaving `self`
// untouched. STABLE; O(n log n) comparisons worst case; allocates the returned list
// always and one auxiliary only above n = 16 — so n below the threshold and 2n above,
// against `sort`'s 0 and n.
//
// THIS BODY IS `sort`'s, COPIED. It should read `const out = …copy…; sort(out, less);
// return out` and cannot — see decision 5 above for the repro and
// `tests/cases/std/array-sort-agrees.vl` for the differential fixture that keeps the two
// copies honest. The only intended differences are the leading copy, and the tail:
// `sorted` RETURNS whichever buffer holds the answer, so it never pays `sort`'s
// copy-home.
export function sorted<T>(self: T[], less: (T, T) => boolean): T[] {
  const SORT_RUN = 16
  const n = self.length
  const out: T[] = []
  let c = 0
  while c < n {
    out.push(self[c])
    c = c + 1
  }
  if n < 2 { return out }

  let lo = 0
  while lo < n {
    let hi = lo + SORT_RUN
    if hi > n { hi = n }
    let k = lo + 1
    while k < hi {
      const key = out[k]
      let j = k - 1
      while j >= lo && less(key, out[j]) {
        out[j + 1] = out[j]
        j = j - 1
      }
      out[j + 1] = key
      k = k + 1
    }
    lo = lo + SORT_RUN
  }
  if n <= SORT_RUN { return out }

  const aux: T[] = []
  let z = 0
  while z < n {
    aux.push(out[z])
    z = z + 1
  }
  let src = out
  let dst = aux
  let width = SORT_RUN
  while width < n {
    let s = 0
    while s < n {
      let mid = s + width
      if mid > n { mid = n }
      let e = mid + width
      if e > n { e = n }
      let p = s
      let q = mid
      let o = s
      while p < mid && q < e {
        if less(src[q], src[p]) {
          dst[o] = src[q]
          q = q + 1
        } else {
          dst[o] = src[p]
          p = p + 1
        }
        o = o + 1
      }
      while p < mid {
        dst[o] = src[p]
        p = p + 1
        o = o + 1
      }
      while q < e {
        dst[o] = src[q]
        q = q + 1
        o = o + 1
      }
      s = e
    }
    const tmp = src
    src = dst
    dst = tmp
    width = width + width
  }
  return src
}
