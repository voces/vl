// `std:array` — list helpers, generic in the element type.
//
//     import { filled, indexOf, concat, extend, sort, sorted } from "std:array"
//
// Every export but `filled` takes the list first, so it reads as a method:
// `xs.indexOf(3)`. `extend`, `insert`, `fill`, `removeAt`, `swapRemove`, `retain`
// and `sort` change their receiver; every other builder returns a NEW list.
// None of these applies to a `u8[]` — `std:bytes`, `std:utf8` and `std:base64`
// own those. NOT here: `sortBy`, a default `xs.sort()` (`<` is not defined for a
// struct or a union), and binary search.

// ── constructing: a NEW list from a length ───────────────────────────────────

// A NEW list of `n` elements, each one `v` — for a table whose slots are written
// later, out of order. `v` fixes the element type; `filled(0, v)` is empty and a
// negative `n` traps. `v` is SHARED, not copied, so every slot holds the same
// struct or list — for one object per slot, `filled(n, 0).mapIndexed(f)`.
export function filled<T>(n: i32, v: T): T[] {
  if n < 0 { __trap__("std:array.filled: a length cannot be negative") }
  return __array_new__(n, v)
}

// The index of the FIRST element equal to `needle`, or -1 when absent.
// Elements are compared with `==`, at the element type's own equality, so an
// element type `==` does not accept is refused when you call this.
export function indexOf<T>(self: T[], needle: T): i32 {
  let i = 0
  while i < self.length {
    if self[i] == needle { return i }
    i = i + 1
  }
  return -1
}

// The index of the LAST element equal to `needle`, or -1 when absent.
export function lastIndexOf<T>(self: T[], needle: T): i32 {
  let i = self.length - 1
  while i >= 0 {
    if self[i] == needle { return i }
    i = i - 1
  }
  return -1
}

// Whether any element equals `needle`.
export function includes<T>(self: T[], needle: T): boolean {
  let i = 0
  while i < self.length {
    if self[i] == needle { return true }
    i = i + 1
  }
  return false
}

// How many elements equal `needle`.
export function count<T>(self: T[], needle: T): i32 {
  let c = 0
  let i = 0
  while i < self.length {
    if self[i] == needle { c = c + 1 }
    i = i + 1
  }
  return c
}

// Whether `pred` answers true for at least one element. It calls `pred` front to
// back and stops at the first true, so later elements are never seen. An empty
// list answers false. `includes` is the twin that compares with `==`.
export function some<T>(self: T[], pred: (T) => boolean): boolean {
  let i = 0
  while i < self.length {
    if pred(self[i]) { return true }
    i = i + 1
  }
  return false
}

// Whether `pred` answers true for every element. It calls `pred` front to back
// and stops at the first false, so later elements are never seen. An empty list
// answers true.
export function every<T>(self: T[], pred: (T) => boolean): boolean {
  let i = 0
  while i < self.length {
    if !pred(self[i]) { return false }
    i = i + 1
  }
  return true
}

// Left fold: thread `acc` — seeded with `init` — through `f(acc, element)` for
// each element in order, and answer the final accumulator. The accumulator type
// may differ from the element type, so an `i32[]` folds to a `string`. An empty
// list answers `init` untouched.
export function reduce<T, A>(self: T[], f: (A, T) => A, init: A): A {
  let acc = init
  let i = 0
  while i < self.length {
    acc = f(acc, self[i])
    i = i + 1
  }
  return acc
}

// ── building: each of these answers a NEW list ───────────────────────────────

// `self`'s elements in reverse order, as a NEW list. It does NOT reverse in
// place, despite the name — `xs.reverse()` written as a statement does nothing.
export function reverse<T>(self: T[]): T[] {
  const out: T[] = []
  let i = self.length - 1
  while i >= 0 {
    out.push(self[i])
    i = i - 1
  }
  return out
}

// `f(element, index)` for each element, collected in order into a new list.
// The result element type may differ from the element type. (The core's bare
// `.map` passes only the element; this is the indexed companion.)
export function mapIndexed<T, U>(self: T[], f: (T, i32) => U): U[] {
  const out: U[] = []
  let i = 0
  while i < self.length {
    out.push(f(self[i], i))
    i = i + 1
  }
  return out
}

// ── appending: `extend` in place, `concat` as a copy ─────────────────────────

// Append every element of `other` to `self`, in order, and answer nothing — the
// receiver is the result. `other` is only read, so a narrower list is accepted
// as the source. `concat` is the copying twin. `xs.extend(xs)` doubles the
// list: the elements held on entry are appended once.
export function extend<T>(self: T[], other: readonly T[]) {
  // Read the length ONCE, so a receiver that is also the source appends what it
  // held on entry rather than chasing its own growth forever.
  const n = other.length
  let i = 0
  while i < n {
    self.push(other[i])
    i = i + 1
  }
}

// `self` followed by `other`, as a NEW list, leaving both untouched. Both must
// have the same element type. Nothing is compared, so this reaches element
// types the search helpers above refuse — a map element, for one.
export function concat<T>(self: readonly T[], other: readonly T[]): T[] {
  const out: T[] = []
  let i = 0
  while i < self.length {
    out.push(self[i])
    i = i + 1
  }
  let j = 0
  while j < other.length {
    out.push(other[j])
    j = j + 1
  }
  return out
}

// ── changing in place: `insert`, `fill` and the removers ─────────────────────

// Insert `v` at index `at`, moving the elements from `at` on one place later; `at`
// may equal `self.length` (an append); `at` outside `[0, self.length]` traps.
export function insert<T>(self: T[], at: i32, v: T) {
  if at < 0 || at > self.length {
    __trap__("std:array.insert: index out of range")
  }
  self.push(v)
  let i = self.length - 1
  while i > at {
    self[i] = self[i - 1]
    i = i - 1
  }
  self[at] = v
}

// Set every element of `self` to `v`, in place; the length is unchanged. `v` is
// SHARED, not copied, as in `filled`.
export function fill<T>(self: T[], v: T) {
  let i = 0
  while i < self.length {
    self[i] = v
    i = i + 1
  }
}

// Remove the element at index `i` and answer it, moving every later element one
// place earlier so the order is kept; O(length - i). An `i` outside
// `[0, self.length)` traps. `swapRemove` is the O(1) twin that does not keep order.
export function removeAt<T>(self: T[], i: i32): T {
  if i < 0 || i >= self.length {
    __trap__("std:array.removeAt: index out of range")
  }
  const out = self[i]
  let k = i + 1
  while k < self.length {
    self[k - 1] = self[k]
    k = k + 1
  }
  self.pop()
  return out
}

// Remove the element at index `i` and answer it, moving the LAST element into
// its place; O(1), and the order of the rest is not kept. An `i` outside
// `[0, self.length)` traps.
export function swapRemove<T>(self: T[], i: i32): T {
  if i < 0 || i >= self.length {
    __trap__("std:array.swapRemove: index out of range")
  }
  const out = self[i]
  self[i] = self[self.length - 1]
  self.pop()
  return out
}

// Keep only the elements for which `keep` answers true, in place and in order;
// O(length), allocating nothing. `.filter` is the copying twin. `keep` sees each
// element once, front to back, and must not change `self`: a push from inside it
// is dropped, and a pop or clear can trap.
export function retain<T>(self: T[], keep: (T) => boolean) {
  const n = self.length
  let w = 0
  let r = 0
  while r < n {
    const v = self[r]
    if keep(v) {
      self[w] = v
      w = w + 1
    }
    r = r + 1
  }
  while self.length > w { self.pop() }
}

// ── ordering: `sort` in place, `sorted` as a copy ────────────────────────────
//
// Both order ascending under `less`, a strict less-than that may close over
// anything, and both are STABLE with O(n log n) comparisons in the worst case.
// An INCONSISTENT `less` leaves the order unspecified but the result is always a
// permutation — that covers what `less` ANSWERS. A `less` that MUTATES the
// receiver is a different matter and can TRAP.

// Reorder `self` IN PLACE, ascending under `less`, and answer nothing — the
// receiver is the result. Allocates nothing up to 16 elements, and one
// n-element scratch buffer above that. The contract `less` must satisfy is in
// the block above.
export function sort<T>(self: T[], less: (T, T) => boolean) {
  // Insertion-sort runs of this length, then merge them pairwise.
  const SORT_RUN = 16
  const n = self.length
  // A 0- or 1-element list is already sorted.
  if n >= 2 {
    let lo = 0
    while lo < n {
      let hi = lo + SORT_RUN
      if hi > n { hi = n }
      let k = lo + 1
      while k < hi {
        const key = self[k]
        let j = k - 1
        while j >= lo && less(key, self[j]) {
          self[j + 1] = self[j]
          j = j - 1
        }
        self[j + 1] = key
        k = k + 1
      }
      lo = lo + SORT_RUN
    }
    // A list that fits in one run needs no merge, and allocates nothing.
    if n > SORT_RUN {
      const aux: T[] = []
      let z = 0
      while z < n {
        aux.push(self[z])
        z = z + 1
      }
      let src = self
      let dst = aux
      // Ping-pong between the two buffers, so no merge pass has to copy back.
      let srcIsSelf = true
      let width = SORT_RUN
      while width < n {
        let s = 0
        while s < n {
          let mid = s + width
          if mid > n { mid = n }
          let e = mid + width
          if e > n { e = n }
          let p = s
          let q = mid
          let o = s
          while p < mid && q < e {
            if less(src[q], src[p]) {
              dst[o] = src[q]
              q = q + 1
            } else {
              dst[o] = src[p]
              p = p + 1
            }
            o = o + 1
          }
          while p < mid {
            dst[o] = src[p]
            p = p + 1
            o = o + 1
          }
          while q < e {
            dst[o] = src[q]
            q = q + 1
            o = o + 1
          }
          s = e
        }
        const tmp = src
        src = dst
        dst = tmp
        srcIsSelf = !srcIsSelf
        width = width + width
      }
      // An odd number of passes leaves the answer in the scratch buffer.
      if !srcIsSelf {
        let i = 0
        while i < n {
          self[i] = src[i]
          i = i + 1
        }
      }
    }
  }
}

// `self`'s elements ascending under `less`, as a NEW list, leaving `self`
// untouched. Same ordering contract as `sort` — the block above it — but it
// allocates the result always, plus one scratch buffer above 16 elements.
export function sorted<T>(self: T[], less: (T, T) => boolean): T[] {
  const SORT_RUN = 16
  const n = self.length
  const out: T[] = []
  let c = 0
  while c < n {
    out.push(self[c])
    c = c + 1
  }
  if n < 2 { return out }

  let lo = 0
  while lo < n {
    let hi = lo + SORT_RUN
    if hi > n { hi = n }
    let k = lo + 1
    while k < hi {
      const key = out[k]
      let j = k - 1
      while j >= lo && less(key, out[j]) {
        out[j + 1] = out[j]
        j = j - 1
      }
      out[j + 1] = key
      k = k + 1
    }
    lo = lo + SORT_RUN
  }
  if n <= SORT_RUN { return out }

  const aux: T[] = []
  let z = 0
  while z < n {
    aux.push(out[z])
    z = z + 1
  }
  let src = out
  let dst = aux
  let width = SORT_RUN
  while width < n {
    let s = 0
    while s < n {
      let mid = s + width
      if mid > n { mid = n }
      let e = mid + width
      if e > n { e = n }
      let p = s
      let q = mid
      let o = s
      while p < mid && q < e {
        if less(src[q], src[p]) {
          dst[o] = src[q]
          q = q + 1
        } else {
          dst[o] = src[p]
          p = p + 1
        }
        o = o + 1
      }
      while p < mid {
        dst[o] = src[p]
        p = p + 1
        o = o + 1
      }
      while q < e {
        dst[o] = src[q]
        q = q + 1
        o = o + 1
      }
      s = e
    }
    const tmp = src
    src = dst
    dst = tmp
    width = width + width
  }
  return src
}
