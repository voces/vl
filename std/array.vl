// `std:array` — pure-VL array/list helpers over the intrinsic floor (the emitter
// provides `.push` / `.length` / indexing / `map` / `filter`; these are written in
// VL on top, the array dual of `std:fmt`). Each takes a `self` first parameter so it
// reads as a UFCS method (`xs.indexOf(3)`), and all are GENERIC in the element type
// `T`, with `==` resolving per element type. Three families: SEARCH (an i32 or a
// boolean, building nothing), BUILDING (`reverse`, `concat`, `mapIndexed`, `sorted`,
// each returning a NEW list), and the ORDERING pair `sort`/`sorted`.
//
// EXACTLY ONE EXPORT MUTATES ITS RECEIVER — `sort` — and what that buys is that
// mutation is VISIBLE IN THE NAME: VL lists are REFERENCE types with no ownership
// discipline, so a mutating helper reorders every other binding that aliases the
// same list, and the only one that does it is named with the bare imperative verb.
//
// HOW FAR THE GENERIC SURFACE REACHES, per EXPORT and per ARGUMENT SHAPE rather than
// "X works". ADMITTED at every position — element, `needle`, `reduce` accumulator,
// callback result: `i32`, `i64`, `f64`, `boolean`, `string`, nested lists, and STRING
// or NUMERIC LITERAL UNIONS. At `needle` ONLY: a nullable REF NICHE and the two
// i32-sentinel nullables (`K | null` over a string literal union, `boolean | null`),
// which stay LOUD at `sorted`/`sort`'s comparator and `mapIndexed`'s `U`. A MAP
// ELEMENT is admitted at `mapIndexed` and `sorted` and refused at the four `needle`
// exports, where the axis is equatability and a map has no compare core.
//
// THE LIVE CARVE-OUT IS LOUD, and it is one mechanism at two spellings: an ANONYMOUS
// OBJECT SHAPE the generic boundary cannot name — a callback result with nothing
// declared, at either container, and a receiver whose struct element has NO STRUCT
// ROW. REMEDY: give the shape a NAME the boundary can see. A `type` declaration mints
// a row and never has to be referenced, and so does ANY inline annotation of that
// layout anywhere in the program — a binding, a parameter, a return type.
//
// A LITERAL UNION IS ADMITTED AT EVERY POSITION AND EVERY DELIVERY, the nullable ones
// included. The one load-bearing spelling is a LAMBDA's return annotation: a bare
// `"y"` in an unannotated lambda infers `string`, so the failure without it is an
// HONEST check error rather than a surprise. ORDERING (`<` `>` `<=` `>=`) OVER A
// STRING LITERAL UNION COMPARES MEMBER TEXT at every spelling of the operand; a
// NUMERIC alias keeps the numeric compare, which is both correct for it and cheaper.
//
// `u8[]` IS OUTSIDE THE SURFACE AT EVERY SPELLING, direct and UFCS alike, and it is a
// CHECKER ERROR: `T` ranges over value types and `u8` is storage, so a `u8[]` is not
// an instantiation of `T[]`. `tests/cases/std/error-u8-array-generic.vl` runs the
// pair side by side. Byte sequences belong to `std:utf8`, whose exports take `u8[]`.

// The index of the FIRST element equal to `needle`, or -1 if absent. `==` is the
// element type's equality (value for scalars and strings, reference for functions).
// A BARE MEMBER LITERAL as the `needle` over a literal-union array (`xs.indexOf("b")`
// on a `("a" | "b")[]`) is fine, at both scopes, here and on `lastIndexOf`, `includes`
// and `count`. Pinned as `tests/cases/std/array-litunion-needle.vl`.
//
// A `needle: T` THE CHECKER WILL NOT `==` IS REFUSED AT `vl check`, IN THE DIRECT
// SPELLING'S OWN WORDS — the message names the callee and then repeats what `a == b`
// would say. THE AXIS IS EQUATABILITY OF `T`, NOT THE STRUCT: a list whose ELEMENT is
// itself non-equatable fails the structural gate AND has no list core, so both sentences
// fire on one call. `isEquatable` and `eqCmpKindOfTy` both ride the PIN rather than
// answering about the bare `TyVar`, which is what makes every route agree.
export function indexOf<T>(self: T[], needle: T): i32 {
  let i = 0
  while i < self.length {
    if self[i] == needle { return i }
    i = i + 1
  }
  return -1
}

// The index of the LAST element equal to `needle`, or -1 if absent.
export function lastIndexOf<T>(self: T[], needle: T): i32 {
  let i = self.length - 1
  while i >= 0 {
    if self[i] == needle { return i }
    i = i - 1
  }
  return -1
}

// Whether any element equals `needle`.
export function includes<T>(self: T[], needle: T): boolean {
  let i = 0
  while i < self.length {
    if self[i] == needle { return true }
    i = i + 1
  }
  return false
}

// How many elements equal `needle`.
export function count<T>(self: T[], needle: T): i32 {
  let c = 0
  let i = 0
  while i < self.length {
    if self[i] == needle { c = c + 1 }
    i = i + 1
  }
  return c
}

// Left fold: thread `acc` (seeded with `init`) through `f(acc, element)` for each
// element in order, returning the final accumulator. The accumulator type `A` may
// differ from the element type `T` (summing an `i32[]` to an `i32`, joining a
// `string[]` to a `string`, summing an `f64[]` to an `f64`). The generic closure
// parameter `f: (A, T) => A` is monomorphized per call shape.
//
// `A` IS THE ONLY DOOR ON THIS MODULE THAT ADMITS A DECLARED UNION AT ALL, and that is
// what still bounds the surface: a `Shape[]` RECEIVER is loud at both scopes, a
// `mapIndexed` union RESULT is loud, and a union-member struct as a map value is a loud
// emit refusal. A union MEMBER is a different door from a declared union, and it is
// admitted. Pinned under `tests/cases/std/` by `array-reduce-litunion-accumulator.vl`,
// `array-reduce-narrowed-variant-init.vl` and `array-reduce-member-accum-layout-twin.vl`.
export function reduce<T, A>(self: T[], f: (A, T) => A, init: A): A {
  let acc = init
  let i = 0
  while i < self.length {
    acc = f(acc, self[i])
    i = i + 1
  }
  return acc
}

// ── The BUILDING family — each returns a NEW list, leaving its inputs unmutated. ──
// (`sorted` is a fourth member and lives with `sort` at the bottom of the file, so the
// ordering pair reads together.)

// `self`'s elements in reverse order.
export function reverse<T>(self: T[]): T[] {
  const out: T[] = []
  let i = self.length - 1
  while i >= 0 {
    out.push(self[i])
    i = i - 1
  }
  return out
}

// `self` followed by `other`. The element type `T` must match (`==`-comparable not
// required — this only moves elements), so a mixed-type concat does not type-check.
//
// AND FOR SOME ELEMENT TYPES THIS IS THE ONLY WORKING CONCATENATION, which is worth saying
// because the `+` operator reads as the obvious spelling and stopped being one on 2026-08-26.
// `F[] + F[]` over `type F = 1.5 | 2.5` is a loud `vl check` reject (`silent-class-inventory`
// D102 — it used to write invalid wasm); `xs.concat(ys)` over the same lists RUNS and reads
// its elements back correctly, on that day's compiler and the one before it. The reason is
// that `+` has exactly ONE lowering (`emitListConcatI`, hard-wired to the i32 backing) while
// this function is an ordinary `push` loop over `T`, so it inherits the element's own storage
// instead of assuming one. The same holds for `type G = 1.5`, `type BIG = 9999999999`,
// `(1|2)|null` and `(1.5|2.5)|null`. Measured at each, both spellings.
export function concat<T>(self: T[], other: T[]): T[] {
  const out: T[] = []
  let i = 0
  while i < self.length {
    out.push(self[i])
    i = i + 1
  }
  let j = 0
  while j < other.length {
    out.push(other[j])
    j = j + 1
  }
  return out
}

// `map` with the element INDEX: `f(element, i)` for each element, collected in
// order into a new list. The result element type `U` may differ from `T`. The
// emitter's bare `.map` passes only the element; this is the indexed companion.
//
// A `U` THAT IS A STRING LITERAL UNION lowers in both the inline and the declared-ALIAS
// spelling, and the DELIVERY of the callback is its own axis — a named function, a lambda
// literal, a binding annotated or not, a list element, a struct field, a function result,
// and a NULLABLE function value narrowed with `is` all work. That axis is called out
// because a "both spellings work" claim once missed it: an alias `U` through a binding was
// check-clean INVALID wasm while the by-name spelling ran, with no hint to signpost it.
// Grids: `tests/cases/std/array-mapindexed-litunion-result.vl` for `T` x `U`, and
// `array-mapindexed-litunion-callback-delivery.vl` for delivery x spelling.
export function mapIndexed<T, U>(self: T[], f: (T, i32) => U): U[] {
  const out: U[] = []
  let i = 0
  while i < self.length {
    out.push(f(self[i], i))
    i = i + 1
  }
  return out
}

// ── The ORDERING pair — `sort` in place, `sorted` as a copy ────────────────────
//   sort<T>(self: T[], less: (T, T) => boolean)          // reorders self, returns nothing
//   sorted<T>(self: T[], less: (T, T) => boolean): T[]   // leaves self alone, returns a copy
// CONTRACT, both: ascending under `less`, STABLE, and O(n log n) comparisons in the WORST
// case — a bottom-up merge over runs an insertion sort has already ordered. They differ
// only in ALLOCATION, and on both sides of the base case. `less` IS A BOOLEAN STRICT
// LESS-THAN, not a three-way `(T, T) => i32`: there is no sign convention to get backwards,
// and it keeps the generic closure parameter the shape `reduce`/`mapIndexed` already ship.
// It may close over anything, which makes SORTING AN INDEX LIST first-class rather than a
// workaround. An INCONSISTENT `less` is NOT undefined behaviour — the ORDER is unspecified
// but the result is always a PERMUTATION, because both loops are bounded by INDICES. That
// covers what `less` ANSWERS, never a comparator that MUTATES the receiver, which can trap.

// Reorder `self` IN PLACE, ascending under `less`. STABLE; O(n log n) comparisons worst
// case; allocates nothing up to n = 16 and one n-element buffer above that. Returns
// nothing — the receiver IS the result. See the block above for the contract `less` must
// satisfy and for what happens when it does not.
//
// NOT DONE, DELIBERATELY, and each is a name a version-locked std could never take back:
// no `sortUnstable` (a second name doing almost the same thing, and the stable one is the
// one `cli.vl` relies on); no `sortBy`/`sortedBy` (each is `sort` with a two-line
// comparator); no default ordering `xs.sort()`, since `<` is defined for the scalars and
// `string` but not for a struct or a union and VL has no overloading to express that; no
// `binarySearch`/`lowerBound`, excluded by name in `perf-workstream.md` §6.2; and no
// adaptivity — an already-sorted input is not detected and still pays every merge pass.
export function sort<T>(self: T[], less: (T, T) => boolean) {
  // SORT_RUN lives INSIDE the function rather than beside the module header because a
  // module-level const is emitted as a wasm global whether or not anything imports the
  // export that reads it. The delta is small, but it is charged to callers who never
  // sort, and the run length is not a knob anyone outside this function can reach.
  // Absolute sizes are deliberately NOT quoted — they move with every unrelated std
  // edit, and an earlier draft of this comment quoted three that no longer reproduce.
  const SORT_RUN = 16
  const n = self.length
  // A 0- or 1-element list is already sorted, and saying so by NESTING rather than with
  // an early `return` is forced: VL's emitter rejects a bare `return` in a void function
  // (the same shape `std:buffer.fill` uses).
  if n >= 2 {
    // Base case: insertion-sort each block of SORT_RUN in place. `less(key, self[j])`
    // and not `!less(self[j], key)` is what makes this half STABLE — an element stops as
    // soon as its left neighbour is not strictly greater, so equals never cross.
    let lo = 0
    while lo < n {
      let hi = lo + SORT_RUN
      if hi > n { hi = n }
      let k = lo + 1
      while k < hi {
        const key = self[k]
        let j = k - 1
        while j >= lo && less(key, self[j]) {
          self[j + 1] = self[j]
          j = j - 1
        }
        self[j + 1] = key
        k = k + 1
      }
      lo = lo + SORT_RUN
    }
    // A list that fits in one run is done. Skipping here is what makes `sort` allocate
    // NOTHING at the lengths this tree actually sorts — the whole n-vs-2n difference
    // between `sort` and `sorted` is n-vs-0 below n = 17.
    if n > SORT_RUN {
      const aux: T[] = []
      let z = 0
      while z < n {
        aux.push(self[z])
        z = z + 1
      }
      // Bottom-up merge, ping-ponging between `self` and `aux` so no pass copies back.
      // `srcIsSelf` is a parity BIT and not a comparison, because `==` on two lists is
      // not reference identity in VL and would answer a different question.
      let src = self
      let dst = aux
      let srcIsSelf = true
      let width = SORT_RUN
      while width < n {
        let s = 0
        while s < n {
          let mid = s + width
          if mid > n { mid = n }
          let e = mid + width
          if e > n { e = n }
          let p = s
          let q = mid
          let o = s
          // STABLE: the right half wins only when it is STRICTLY less, so on a tie the
          // left (earlier) element goes first.
          while p < mid && q < e {
            if less(src[q], src[p]) {
              dst[o] = src[q]
              q = q + 1
            } else {
              dst[o] = src[p]
              p = p + 1
            }
            o = o + 1
          }
          // Unconditional drains — index-bounded, so a comparator that lies still yields
          // a permutation rather than a trap.
          while p < mid {
            dst[o] = src[p]
            p = p + 1
            o = o + 1
          }
          while q < e {
            dst[o] = src[q]
            q = q + 1
            o = o + 1
          }
          s = e
        }
        const tmp = src
        src = dst
        dst = tmp
        srcIsSelf = !srcIsSelf
        width = width + width
      }
      // An ODD number of merge passes leaves the answer in `aux`; copy it home. This is
      // the one cost `sort` pays that `sorted` does not, it is n writes against the
      // merge's n log n, and it is skipped outright whenever the pass count is even.
      if !srcIsSelf {
        let i = 0
        while i < n {
          self[i] = src[i]
          i = i + 1
        }
      }
    }
  }
}

// `self`'s elements in ascending order under `less`, as a NEW list, leaving `self`
// untouched. STABLE; O(n log n) comparisons worst case; allocates the returned list
// always and one auxiliary only above n = 16 — so n below the threshold and 2n above,
// against `sort`'s 0 and n.
//
// THIS BODY IS `sort`'s, COPIED, and that is a COMPILER LIMITATION rather than a choice:
// it should read `const out = …copy…; sort(out, less); return out` and cannot, because a
// GENERIC FUNCTION CANNOT PASS ITS OWN GENERIC-TYPED FUNCTION PARAMETER TO ANOTHER
// GENERIC FUNCTION — the direct call, the UFCS call, a forwarding local and a re-wrapping
// lambda were all refused. `tests/cases/std/array-sort-agrees.vl` is the differential
// fixture that keeps the two copies honest; the only intended differences are the leading
// copy and the tail, where `sorted` returns whichever buffer holds the answer.
export function sorted<T>(self: T[], less: (T, T) => boolean): T[] {
  const SORT_RUN = 16
  const n = self.length
  const out: T[] = []
  let c = 0
  while c < n {
    out.push(self[c])
    c = c + 1
  }
  if n < 2 { return out }

  let lo = 0
  while lo < n {
    let hi = lo + SORT_RUN
    if hi > n { hi = n }
    let k = lo + 1
    while k < hi {
      const key = out[k]
      let j = k - 1
      while j >= lo && less(key, out[j]) {
        out[j + 1] = out[j]
        j = j - 1
      }
      out[j + 1] = key
      k = k + 1
    }
    lo = lo + SORT_RUN
  }
  if n <= SORT_RUN { return out }

  const aux: T[] = []
  let z = 0
  while z < n {
    aux.push(out[z])
    z = z + 1
  }
  let src = out
  let dst = aux
  let width = SORT_RUN
  while width < n {
    let s = 0
    while s < n {
      let mid = s + width
      if mid > n { mid = n }
      let e = mid + width
      if e > n { e = n }
      let p = s
      let q = mid
      let o = s
      while p < mid && q < e {
        if less(src[q], src[p]) {
          dst[o] = src[q]
          q = q + 1
        } else {
          dst[o] = src[p]
          p = p + 1
        }
        o = o + 1
      }
      while p < mid {
        dst[o] = src[p]
        p = p + 1
        o = o + 1
      }
      while q < e {
        dst[o] = src[q]
        q = q + 1
        o = o + 1
      }
      s = e
    }
    const tmp = src
    src = dst
    dst = tmp
    width = width + width
  }
  return src
}
