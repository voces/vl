// A day-one PAIR as the JSON object every generator builds and every report reads: two
// spellings of one program (`a`, `b`), what was varied (`axis`, `delta`) and what to
// compare. A saved sample is one such object per line, keys sorted.
//
//     import { newPair, side, dumpSorted } from "./pairs"

import { Json, JsonError, parseJson } from "std:json"
import { join, split } from "std:str"
import { JsonMap, die, jsonStr, stripWs } from "../lib/common"
import { dumpJson, readText, sortStrings } from "../lib/corpus"

export function jstrs(xs: string[]): Json {
  const out: Json[] = []
  for x in xs { out.push(x) }
  out
}

export function jfaces(m: Map<string, string>): JsonMap {
  const out: JsonMap = Map()
  for k, v in m { out[k] = v }
  out
}

// One face of a pair: its source, the lines it must print, and the face's name.
export function side(src: string, want: string[], face: string): JsonMap {
  const m: JsonMap = Map()
  m["src"] = src
  m["want"] = jstrs(want)
  m["face"] = face
  m
}

export function newPair(
  axis: string,
  spec: JsonMap,
  fa: JsonMap,
  fb: JsonMap,
  a: JsonMap,
  b: JsonMap,
  features: string[],
  delta: JsonMap,
): JsonMap {
  const p: JsonMap = Map()
  p["axis"] = axis
  p["spec"] = spec
  p["facesA"] = fa
  p["facesB"] = fb
  p["a"] = a
  p["b"] = b
  p["compare"] = if sameStrs(strs(a, "want"), strs(b, "want")) { "grade+output" } else { "grade" }
  p["features"] = jstrs(features)
  p["delta"] = delta
  p
}

export function sameStrs(x: string[], y: string[]): boolean {
  if x.length != y.length { return false }
  let i = 0
  while i < x.length {
    if x[i] != y[i] { return false }
    i = i + 1
  }
  true
}

// `json.dumps(v, sort_keys=True)`.
export function dumpSorted(v: Json): string {
  if v is JsonMap {
    const keys: string[] = []
    for k, _x in v { keys.push(k) }
    const parts: string[] = []
    for k in sortStrings(keys) {
      parts.push(jsonStr(k) + ": " + dumpSorted(v[k] ?? null))
    }
    return "{" + join(parts, ", ") + "}"
  }
  if v is Json[] {
    const items: string[] = []
    for x in v { items.push(dumpSorted(x)) }
    return "[" + join(items, ", ") + "]"
  }
  dumpJson(v)
}

export function str(m: JsonMap, k: string): string {
  const v = m[k]
  if v is string { return v }
  ""
}

export function strs(m: JsonMap, k: string): string[] {
  const out: string[] = []
  const v = m[k]
  if v is Json[] {
    for x in v {
      if x is string { out.push(x) }
    }
  }
  out
}

export function obj(m: JsonMap, k: string): JsonMap {
  const v = m[k]
  if v is JsonMap { return v }
  Map()
}

export function int(m: JsonMap, k: string): i32 {
  const v = m[k]
  if v is f64 { return (v as? i32) ?? 0 }
  0
}

// A string-valued JSON object as a map, in its own order.
export function faceMap(m: JsonMap): Map<string, string> {
  const out: Map<string, string> = Map()
  for k, v in m {
    if v is string { out[k] = v }
  }
  out
}

// One pair per non-blank line of a saved sample.
export function loadJsonl(path: string): JsonMap[] {
  const out: JsonMap[] = []
  for l in split(readText(path), "\n") {
    if stripWs(l) == "" { continue }
    const j = parseJson(l)
    if j is JsonError {
      die("day-one: " + path + " is not JSON lines: " + j.msg, 1)
    } else if j is JsonMap {
      out.push(j)
    }
  }
  out
}
