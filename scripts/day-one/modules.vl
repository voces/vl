// The `modules_split` axis: one program spelled as one file and as two modules. A unit
// is a declaration or a module-scope statement group with its dependencies named; the
// `split` face moves a dependency-closed random subset into `mod.vl` and imports what
// the entry still uses. Both faces print the same lines. docs/internals/day-one-sampler.md.
//
//     import { makePair, splitFiles } from "./modules"

import { toString } from "std:fmt"
import { join, replaceAll, startsWith } from "std:str"
import { JsonMap, rstripWs, splitLines } from "../lib/common"
import { sortStrings } from "../lib/corpus"
import { excluded } from "./grammar"
import { Rng, below, randint, random, weighted } from "./rng"
import { faceMap, jfaces, jstrs, newPair, obj, side, str, strs } from "./pairs"

const NAME_SLOT = "@N@"
const NAME_POOL = ["n", "v", "s", "k"]
const HOT_NAME = "n"
const COLLIDE_P = 0.55

// `probe` is a print the entry makes about the unit's state; `probeWant` is its line,
// or `@tally` / `@table` / `@tag` for one that depends on which units were drawn.
// `writes` names the units whose global this one assigns: a writer moves with them.
export type Unit = {
  id: string,
  weight: i32,
  lines: string[],
  exports: string[],
  deps: string[],
  head: string[],
  probe: string,
  probeWant: string,
  names: i32,
  features: string[],
  writes: string[],
}

export type Report = {
  id: string,
  weight: i32,
  needs: string[],
  lines: string[],
  want: string[],
  features: string[],
}

// Which units, which name each slot took, which units moved to `mod.vl`.
export type ModSpec = {
  units: string[],
  report: string,
  names: Map<string, string>,
  moved: string[],
}

function un(
  id: string,
  weight: i32,
  lines: string[],
  exports: string[],
  deps: string[],
): Unit {
  {
    id: id,
    weight: weight,
    lines: lines,
    exports: exports,
    deps: deps,
    head: [],
    probe: "",
    probeWant: "",
    names: 0,
    features: [],
    writes: [],
  }
}

function feat(u: Unit, features: string[]): Unit {
  u.features = features
  u
}

function probed(u: Unit, probe: string, want: string): Unit {
  u.probe = probe
  u.probeWant = want
  u
}

function stmt(u: Unit, writes: string[]): Unit {
  u.names = 1
  u.writes = writes
  u
}

function headed(u: Unit, head: string): Unit {
  u.head = [head]
  u
}

