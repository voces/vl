// The grammar of ORDINARY VL programs, as data: the shapes a tutorial would contain,
// weighted toward the textbook end, which the sampler pairs two spellings of. Nothing
// here renders (`render.vl` walks these records) and nothing runs a program
// (`sample.vl` does). docs/internals/day-one-sampler.md.
//
//     import { VALUES, AXES } from "./grammar"

import { split } from "std:str"

// One way a value is consumed. `want` is the exact stdout the pair is graded on; an
// empty tag field means the read does not carry it. `namedOnly` marks a read whose
// spelling needs a declared name (`is Rect`), which the inline face cannot write.
export type Read = {
  id: string,
  lines: string[],
  want: string[],
  narrow: string,
  namedOnly: boolean,
  mix: string,
  op: string,
  opw: string,
  xnp: string,
  xrep: string,
}

export type Decl = { name: string, rhs: string }

// One ordinary type in both spellings. `expr` is "" when `mk` builds the value inside
// a helper returning `{T}`; `fns` are module declarations the record brings.
export type Value = {
  id: string,
  weight: i32,
  decls: Decl[],
  named: string,
  inline: string,
  expr: string,
  mk: string[],
  alt: string,
  altInfers: boolean,
  noInline: boolean,
  fns: string[],
  features: string[],
  reads: Read[],
}

export type Position = {
  id: string,
  weight: i32,
  wraps: boolean,
  noNullable: boolean,
  fixedScope: string,
}

export type Scope = { id: string, weight: i32 }

export type Source = {
  id: string,
  weight: i32,
  needsAlt: boolean,
  noNullable: boolean,
}

export type Scenery = { id: string, lines: string[], isImport: boolean }

// The second argument of the two-hole pin; `expr` "" is the `same` control, filled
// from the value's own `alt` at render.
export type SecondPin = {
  id: string,
  weight: i32,
  expr: string,
  decls: string[],
}

// What a pair varies. `needs` names what a plan must offer for the axis to apply,
// `pinFusion` forces the fusion face, and `generator` names an axis with its own grammar.
export type Axis = {
  id: string,
  weight: i32,
  faces: string[],
  needs: string,
  pinFusion: string,
  generator: string,
}

// Grammar ids the caller asked every generator to stop drawing (`--exclude`).
const EXCLUDED: string[] = []

export function exclude(ids: string[]) {
  for i in ids { EXCLUDED.push(i) }
}

export function excluded(id: string): boolean {
  for e in EXCLUDED {
    if e == id { return true }
  }
  false
}

// A read from its id, a space-separated tag list (`narrow=eq named_only`), its lines
// and its wanted output.
function rd(id: string, tags: string, lines: string[], want: string[]): Read {
  const r: Read = {
    id: id,
    lines: lines,
    want: want,
    narrow: "",
    namedOnly: false,
    mix: "",
    op: "",
    opw: "",
    xnp: "",
    xrep: "",
  }
  for t in split(tags, " ") {
    if t == "" { continue }
    if t == "named_only" {
      r.namedOnly = true
      continue
    }
    let eq = 0
    while eq < t.length && t[eq] != 61 { eq = eq + 1 }
    const k = t.slice(0, eq)
    const v = t.slice(eq + 1, t.length)
    if k == "narrow" { r.narrow = v }
    else if k == "mix" { r.mix = v }
    else if k == "op" { r.op = v }
    else if k == "opw" { r.opw = v }
    else if k == "xnp" { r.xnp = v }
    else if k == "xrep" { r.xrep = v }
  }
  r
}

function d(name: string, rhs: string): Decl { { name: name, rhs: rhs } }

function cat(a: string[], b: string[]): string[] {
  const out: string[] = []
  for x in a { out.push(x) }
  for x in b { out.push(x) }
  out
}

// A nominal record's `alt`: a call, so the value keeps its brand un-annotated.
function opAlt(name: string, ty: string): string[] {
  [
    "function \{name}(): \{ty} {",
    "  const r: " + ty + " = { x: 9 }",
    "  return r",
    "}",
  ]
}

const OP_MK = ["const r: {T} = { x: 3 }", "return r"]
const REC_INLINE = "{ name: string, n: i32 }"
const REC_EXPR = "{ name: \"ada\", n: 3 }"
const REC_ALT = "{ name: \"zed\", n: 0 }"
const THRU = "function thru<T>(x: T): T { return x }"

function recDecl(): Decl { d("Rec", REC_INLINE) }

