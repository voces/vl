function ax(id: string, weight: i32, faces: string[], needs: string): Axis {
  {
    id: id,
    weight: weight,
    faces: faces,
    needs: needs,
    pinFusion: "",
    generator: "",
  }
}

// The axes in expected-yield order, which is the order every report prints them in.
export const AXES: Axis[] = [
  ax(
    "named_vs_inline",
    6,
    ["named", "inline"],
    "decls",
  ),
  {
    id: "annotated_vs_inferred",
    weight: 5,
    faces: ["annotated", "inferred"],
    needs: "",
    pinFusion: "bound",
    generator: "",
  },
  ax("narrowing", 4, ["*"], "narrow_group"),
  ax("fusion", 3, ["fused", "bound"], "fusible"),
  ax(
    "pinning",
    3,
    ["direct", "generic", "hole", "generic2"],
    "pinnable",
  ),
  ax(
    "scope",
    3,
    ["module", "function", "fn_block", "module_block"],
    "free_scope",
  ),
  ax("scenery", 3, ["bare", "neighbour"], ""),
  ax("operator_vs_call", 4, ["*"], "op_group"),
  {
    id: "init_vs_assign",
    weight: 5,
    faces: ["init", "assign"],
    needs: "assignable",
    pinFusion: "bound",
    generator: "",
  },
  {
    id: "modules_split",
    weight: 5,
    faces: ["single", "split"],
    needs: "",
    pinFusion: "",
    generator: "modules",
  },
  {
    id: "imports_pair",
    weight: 4,
    faces: ["alone", "together"],
    needs: "",
    pinFusion: "",
    generator: "imports",
  },
]

export function axisIds(): string[] {
  const out: string[] = []
  for a in AXES { out.push(a.id) }
  out
}
