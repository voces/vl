function pos(id: string, weight: i32, wraps: boolean): Position {
  { id: id, weight: weight, wraps: wraps, noNullable: false, fixedScope: "" }
}

// Every syntactic place the value can be delivered before it is read. `wraps` puts the
// read inside the delivery (an un-annotated parameter is a hole).
export const POSITIONS: Position[] = [
  pos("binding", 4, false),
  pos("argument", 4, true),
  pos("return", 4, false),
  pos("assignment", 2, false),
  pos("struct_field", 3, false),
  pos("list_element", 3, false),
  {
    id: "map_value",
    weight: 2,
    wraps: false,
    noNullable: true,
    fixedScope: "",
  },
  {
    id: "global_init",
    weight: 2,
    wraps: true,
    noNullable: false,
    fixedScope: "module",
  },
  pos("closure_capture", 3, false),
]

