// Turn a minimised day-one hit into an inventory ROW DRAFT and a standing PROBE. The row
// carries the generator seed and index, so `sample.vl --seed N` regenerates the pair
// verbatim; the probe is `scripts/capability-probes/<name>.vl`. It drafts, it does not
// file: replace the mechanism paragraph with what the ablation says. From the checkout root:
//
//     vl run scripts/day-one/file_row.vl -- run.jsonl --index 7 --title "…"
//     vl run scripts/day-one/file_row.vl -- run.jsonl --index 7 --probe-name uncalled-hof --write

import { exit } from "std:process"
import { programArgs } from "std:args"
import { Utf8Error } from "std:utf8"
import { parseI32 } from "std:fmt"
import { join, replaceAll, split, startsWith } from "std:str"
import {
  JsonMap,
  cpPrefix,
  die,
  findFrom,
  rstripWs,
  stripWs,
} from "../lib/common"
import { cwd, makeTempDir, pyRepr, spawn, writeText } from "../lib/corpus"
import { Ctx } from "./grade"
import { splitFiles } from "./modules"
import { int, loadJsonl, obj, str } from "./pairs"
import { ablatePair, failingSide, minimise, sideSrc, sideWant } from "./reduce"

const USAGE = "usage: file_row.vl [-h] --index INDEX [--title TITLE] [--probe-name PROBE_NAME] [--compiler COMPILER] [--date DATE] [--write] jsonl"

function usageError(msg: string): i32 {
  print(USAGE)
  print("file_row.vl: error: \{msg}")
  2
}

// The id `scripts/inventory/ls.vl --next` hands out.
function nextId(abs: string, compiler: string): string {
  const p = spawn(
    abs + "/scripts/vl-host/target/release/vl",
    [
      "run",
      "scripts/inventory/ls.vl",
      "--compiler",
      compiler,
      "--",
      "--next",
    ],
  )
  const words = split(replaceAll(stripWs(p.out), "\n", " "), " ")
  words[words.length - 1]
}

function stdout(cmd: string, args: string[]): string {
  stripWs(spawn(cmd, args).out)
}

function indented(src: string): string {
  const out: string[] = []
  for l in split(rstripWs(src), "\n") { out.push("    \{l}") }
  join(out, "\n")
}

function statusOf(grade: string): string {
  if grade == "emit refuses" { return "loud emit reject" }
  if grade == "check refuses" { return "loud check reject" }
  if grade == "SILENT (check rc 0)" { return "check-clean invalid wasm" }
  if grade == "RUNS-WRONG" { return "check-clean silently wrong" }
  if grade == "TRAP (program)" { return "loads then traps" }
  if grade == "COMPILER TRAP (check rc 0)" { return "compiler trap" }
  grade
}

function main(args: string[]): i32 {
  const abs = cwd()
  let jsonl = ""
  let index = 0
  let hasIndex = false
  let title = "TODO one sentence naming the MECHANISM"
  let probeName = ""
  let compiler = abs + "/build/vl-compiler.wasm"
  let date = ""
  let write = false
  let i = 0
  while i < args.length {
    let a = args[i]
    let val: string | null = null
    const eq = findFrom(a, "=", 0)
    if startsWith(a, "--") && eq > 0 {
      val = a.slice(eq + 1, a.length)
      a = a.slice(0, eq)
    }
    if a == "-h" || a == "--help" {
      print(USAGE)
      return 0
    }
    if a == "--write" {
      write = true
      i = i + 1
      continue
    }
    if !startsWith(a, "-") || a == "-" {
      if jsonl != "" { return usageError("unrecognized arguments: \{a}") }
      jsonl = a
      i = i + 1
      continue
    }
    const known = ["--index", "--title", "--probe-name", "--compiler", "--date"]
    let isKnown = false
    for k in known {
      if k == a { isKnown = true }
    }
    if !isKnown { return usageError("unrecognized arguments: \{args[i]}") }
    let v = ""
    if val is string {
      v = val
      i = i + 1
    } else {
      if i + 1 >= args.length {
        return usageError("argument \{a}: expected one argument")
      }
      v = args[i + 1]
      i = i + 2
    }
    if a == "--index" {
      const n = parseI32(v)
      if n == null {
        return usageError("argument --index: invalid int value: \{pyRepr(v)}")
      }
      index = n ?? 0
      hasIndex = true
    } else if a == "--title" {
      title = v
    } else if a == "--probe-name" {
      probeName = v
    } else if a == "--compiler" {
      compiler = v
    } else {
      date = v
    }
  }
  if jsonl == "" || !hasIndex {
    return usageError(
      "the following arguments are required: \{if jsonl == "" { "jsonl" } else { "--index" }}",
    )
  }

  let pair: JsonMap = Map()
  let found = false
  for p in loadJsonl(jsonl) {
    if !found && int(p, "index") == index {
      pair = p
      found = true
    }
  }
  if !found { die("file_row: no pair with index \{index} in \{jsonl}", 1) }
  const side = failingSide(pair)
  const twin = if side == "a" { "b" } else { "a" }
  const c: Ctx = {
    vl: abs + "/scripts/vl-host/target/release/vl",
    compiler: compiler,
    std: abs + "/std",
  }
  const dir = makeTempDir()
  const m = minimise(c, sideSrc(pair, side), sideWant(pair, side), dir)
  const ab = ablatePair(c, pair, side, dir)
  spawn("rm", ["-rf", dir])

  const grade = m.base.grade
  const rid = nextId(abs, abs + "/build/vl-compiler.wasm")
  const sha = stdout("git", ["-C", abs, "rev-parse", "--short", "HEAD"])
  const day = if date != "" { date } else { stdout("date", ["+%F"]) }
  const chkrc = if grade != "check refuses" { "0" } else { "non-zero" }
  const clause = if grade == "SILENT (check rc 0)" || grade == "RUNS-WRONG" { "1" } else { "2" }
  const face = str(obj(pair, side), "face")
  const twinFace = str(obj(pair, twin), "face")
  const seed = int(pair, "seed")
  const axis = str(pair, "axis")
  const rows: string[] = []
  for r in ab.rows {
    rows.push(
      "| \{r.axis} \{r.flip} | \{r.grade} | \{if r.same == "MOVED" { "**yes**" } else { "no" }} |",
    )
  }
  const ablation = if rows.length == 0 { "| — | — | — |" } else { join(rows, "\n") }
  const repro = "\{indented(m.wit)}\n    // vl check: rc 0.  vl run: \{cpPrefix(m.base.message, 80)}"
  const body = [
    "### \{rid} — \{title}",
    "",
    "**\{statusOf(grade)} · `vl check` rc \{chkrc} · clause \{clause} · the \{face} spelling only; the \{twinFace} spelling RUNS · found \{day} by `scripts/day-one/sample.vl --seed \{seed}` pair \{index} (axis `\{axis}`), against master `\{sha}`**",
    "",
    "Repro:",
    "",
    repro,
    "",
    "#### Mechanism",
    "",
    "TODO — what decides the outcome, and where. A validator sentence is not a mechanism;",
    "write what the ABLATION below says, not what the message says.",
    "",
    "#### Ablation",
    "",
    "| ingredient removed | outcome | needed? |",
    "| --- | --- | --- |",
    ablation,
    "",
    "#### Grading list",
    "",
    "* the twin spelling below, which must keep running:",
    "",
    indented(sideSrc(pair, twin)),
    "",
  ]
  const rowText = join(body, "\n")
  const probe = join(
    [
      "// \{title}",
      "//",
      "// Found by the day-one sampler (`scripts/day-one/sample.vl --seed \{seed}`, pair \{index},",
      "// axis `\{axis}`). The TWIN spelling — \{twinFace} — runs and prints the same value, which is",
      "// what makes this a capability gap rather than a design question. See \{rid}.",
      "// Should print \{join(sideWant(pair, side), " then ")}.",
      m.wit,
    ],
    "\n",
  )

  if !write {
    print(rowText)
    print("---- probe ----")
    print(probe)
    return 0
  }
  const rowPath = "\{abs}/docs/internals/inventory/\{rid}.md"
  writeText(rowPath, rowText)
  print("wrote \{rowPath}")
  if probeName != "" {
    // A capability probe is one file; a multi-module witness is a tests/cases/modules fixture.
    if splitFiles(m.wit).length > 1 {
      print(
        "no probe written: the witness is multi-module. File it as a fixture directory under tests/cases/modules/ and cite it on the row.",
      )
      return 0
    }
    const pp = "\{abs}/scripts/capability-probes/\{probeName}.vl"
    writeText(pp, probe)
    print("wrote \{pp}")
  }
  0
}

const argv = programArgs()
if argv is Utf8Error {
  die("file_row: an argument is not UTF-8: \{argv.msg}", 2)
} else {
  exit(main(argv))
}
