// Run every capability probe in `scripts/capability-probes/` and report which still refuse.
// Each probe is a program `vl check` accepts, one per known capability gap the distilled
// corpus cannot see; a refusal is a clause-2 violation and a SILENT one a clause-1 one.
// Grading is `lib/probe-grade.vl`'s, so a probe and a position-matrix cell read alike.
//
//     vl run scripts/capability-probes.vl -- [--compiler SEED] [--live-sites | --floor]
//
// Run it from the checkout root: paths resolve against the working directory. Probes are
// graded `$JOBS` at a time (default 6) by `xargs -P` over a build of this file, because
// `runProgram` waits for its child. `$VL_PROBE_TIMEOUT` (default 120) bounds each `vl` call.

import { IoError, listDir, readFile, writeTextFile } from "std:fs"
import { exit } from "std:process"
import { programArgs } from "std:args"
import { Utf8Error, decodeUtf8Lossy } from "std:utf8"
import { parseI32, toString } from "std:fmt"
import { join, split, startsWith } from "std:str"
import { Json, JsonError, parseJson } from "std:json"
import { includes } from "std:array"
import {
  JsonMap,
  cpAt,
  cpPrefix,
  die,
  envOr,
  exists,
  fanOutArgv,
  findFrom,
  hexDigits,
  rstripWs,
  stripWs,
  univNl,
} from "./lib/common"
import { Graded, Job, grade, spawn } from "./lib/probe-grade"

const HERE = "scripts/capability-probes"
const SELF = "scripts/capability-probes.vl"
const COMPILER = "build/vl-compiler.wasm"

function contains(s: string, needle: string): boolean {
  findFrom(s, needle, 0) >= 0
}

// `s` padded with spaces to `w` code points on the right, as `{s:<w}` formats it.
function padRight(s: string, w: i32): string {
  let out = s
  let n = s.cpLen()
  while n < w {
    out = out + " "
    n = n + 1
  }
  out
}

// `xs` in byte order, which for UTF-8 is Python's code-point order. A hand merge sort
// rather than `std:array`'s `sort`, whose comparator lambda makes the compiler trap (D4290).
function sortStrings(xs: string[]): string[] {
  if xs.length <= 1 { return xs }
  const mid = xs.length / 2
  const a = sortStrings(xs.slice(0, mid))
  const b = sortStrings(xs.slice(mid, xs.length))
  const out: string[] = []
  let i = 0
  let j = 0
  while i < a.length || j < b.length {
    if j >= b.length || (i < a.length && !(b[j] < a[i])) {
      out.push(a[i])
      i = i + 1
    } else {
      out.push(b[j])
      j = j + 1
    }
  }
  out
}

// Whether Python's `str.isprintable` refuses the non-ASCII code point `cp`: the
// separators, format and control characters, surrogates and private use. Unassigned
// code points, which Python also refuses, are not tabled.
function unprintable(cp: i32): boolean {
  if cp <= 0xA0 || cp == 0xAD || cp == 0x1680 || cp == 0x3000 { return true }
  if (cp >= 0x600 && cp <= 0x605) || cp == 0x61C || cp == 0x6DD || cp == 0x70F {
    return true
  }
  if cp == 0x180E || (cp >= 0x2000 && cp <= 0x200F) { return true }
  if (cp >= 0x2028 && cp <= 0x202F) || (cp >= 0x205F && cp <= 0x206F) {
    return true
  }
  if (cp >= 0xD800 && cp <= 0xF8FF) || cp == 0xFEFF { return true }
  if cp >= 0xFFF9 && cp <= 0xFFFB { return true }
  cp == 0xE0001 || (cp >= 0xE0020 && cp <= 0xE007F) || cp >= 0xF0000
}

function pyRepr(s: string): string {
  let q = 39
  if contains(s, "'") && !contains(s, "\"") { q = 34 }
  const qs = s.slice(0, 0) + (if q == 39 { "'" } else { "\"" })
  const parts = [qs]
  let i = 0
  while i < s.length {
    const b = s[i]
    if b < 0x80 {
      if b == q || b == 92 { parts.push("\\" + s.slice(i, i + 1)) }
      else if b == 9 { parts.push("\\t") }
      else if b == 10 { parts.push("\\n") }
      else if b == 13 { parts.push("\\r") }
      else if b < 32 || b == 127 { parts.push("\\x" + hexDigits(b, 2)) }
      else { parts.push(s.slice(i, i + 1)) }
      i = i + 1
      continue
    }
    const c = cpAt(s, i)
    if !unprintable(c.cp) { parts.push(s.slice(i, i + c.n)) }
    else if c.cp <= 0xFF { parts.push("\\x" + hexDigits(c.cp, 2)) }
    else if c.cp <= 0xFFFF { parts.push("\\u" + hexDigits(c.cp, 4)) }
    else { parts.push("\\U" + hexDigits(c.cp, 8)) }
    i = i + c.n
  }
  parts.push(qs)
  join(parts, "")
}

function readText(path: string): string {
  const t = readFile(path)
  if t is IoError {
    die("capability-probes: cannot read \{path} (\{t.msg})", 1)
    return ""
  }
  univNl(decodeUtf8Lossy(t))
}

function writeText(path: string, text: string) {
  const w = writeTextFile(path, text)
  if w != null { die("capability-probes: cannot write \{path} (\{w.msg})", 1) }
}

function cwd(): string {
  const p = spawn("pwd", ["-P"])
  if p.code != 0 { die("capability-probes: pwd failed: " + p.err, 1) }
  stripWs(p.out)
}

// The `.vl` names directly under `dir`, sorted, as `sorted(os.listdir(dir))` filters them.
function vlFiles(dir: string, ext: string): string[] {
  const out: string[] = []
  const names = listDir(dir)
  if names is IoError {
    die("capability-probes: cannot list \{dir} (\{names.msg})", 1)
    return out
  }
  for n in names {
    if (
      n.length >= ext.length
      && n.slice(n.length - ext.length, n.length) == ext
    ) {
      out.push(n)
    }
  }
  sortStrings(out)
}

// `re.search(r"Should print (.+?)\.?\s*$", line)` on one header line: the group, or null.
function shouldPrint(line: string): string | null {
  const key = "Should print "
  const at = findFrom(line, key, 0)
  if at < 0 { return null }
  const rest = line.slice(at + key.length, line.length)
  if rest.length == 0 { return null }
  let end = rstripWs(rest).length
  if end > 0 && rest[end - 1] == 46 { end = end - 1 }
  if end < 1 { end = cpPrefix(rest, 1).length }
  rest.slice(0, end)
}

// The `Should print ...` line in the probe's header, or null.
function expected(path: string): string | null {
  for line in readText(path).split("\n") {
    if !startsWith(line, "//") { break }
    const g = shouldPrint(line)
    if g is string { return stripWs(g) }
  }
  null
}

// ── grading one probe, inside a worker ───────────────────────────────────────────

function gradeFull(j: Job): Graded { grade(j, expected(j.probe)) }

// A worker's answer file: each field as its byte length on a line, then its bytes.
function field(s: string): string { toString(s.length) + "\n" + s }

// Grade the job staged in `file` into `file.out`; `channel` grades the channel only, with no
// output contract, which is how the day-one sampler asks (it checks the output itself).
function gradeOne(file: string, channel: boolean) {
  const l = readText(file).split("\n")
  const j: Job = { vl: l[0], seed: l[1], std: l[2], probe: l[3], secs: l[4] }
  const g = if channel { grade(j, null) } else { gradeFull(j) }
  writeText(
    file + ".out",
    field(g.verdict) + field(g.detail) + field(g.out) + field(g.err),
  )
}

function readGraded(file: string): Graded {
  const t = readText(file)
  const f: string[] = []
  let at = 0
  while f.length < 4 {
    const nl = findFrom(t, "\n", at)
    if nl < 0 {
      die("capability-probes: a worker answer is truncated: " + file, 1)
    }
    const n = parseI32(t.slice(at, nl)) ?? 0
    f.push(t.slice(nl + 1, nl + 1 + n))
    at = nl + 1 + n
  }
  { verdict: f[0], detail: f[1], out: f[2], err: f[3] }
}

// ── the parent: stage one job per probe, fan them out, read the answers back ─────────

function jobsFromEnv(): i32 {
  const j = envOr("JOBS", "6")
  const n = parseI32(stripWs(j))
  if n == null { die("capability-probes: JOBS is not an integer: " + j, 1) }
  n ?? 6
}

// Up to this many probes are graded in this process: below it the fan-out's own build
// costs more than it saves (`--live-sites` grades about a dozen).
const SERIAL_MAX = 16

// Grade every probe named in `probes` (file names under `HERE`) against `seed`.
function gradeAll(
  abs: string,
  seed: string,
  probes: string[],
): Map<string, Graded> {
  const res: Map<string, Graded> = Map()
  const secs = envOr("VL_PROBE_TIMEOUT", "120")
  if probes.length <= SERIAL_MAX {
    for p in probes {
      res[p] = gradeFull(
        {
          vl: abs + "/scripts/vl-host/target/release/vl",
          seed: seed,
          std: abs + "/std",
          probe: "\{abs}/\{HERE}/\{p}",
          secs: secs,
        },
      )
    }
    return res
  }
  const mk = spawn("mktemp", ["-d"])
  if mk.code != 0 { die("capability-probes: mktemp -d failed: " + mk.err, 1) }
  const root = stripWs(mk.out)
  const vl = envOr("VL", "scripts/vl-host/target/release/vl")
  const head = [abs + "/scripts/vl-host/target/release/vl", seed, abs + "/std"]
  const files: string[] = []
  let k = 0
  for p in probes {
    const f = root + "/" + toString(k) + ".job"
    writeText(f, "\{join(head, "\n")}\n\{abs}/\{HERE}/\{p}\n\{secs}")
    files.push(f)
    k = k + 1
  }
  const grader = root + "/grader.wasm"
  const b = spawn(vl, ["build", SELF, "--compiler", COMPILER, "-o", grader])
  if b.code != 0 {
    spawn("rm", ["-rf", root])
    die("capability-probes: cannot build \{SELF}:\n" + b.out + b.err, 1)
  }
  writeText(root + "/jobs", join(files, "\n") + "\n")
  const x = spawn(
    "sh",
    fanOutArgv(
      root + "/jobs",
      toString(jobsFromEnv()),
      [vl, "run", grader, "--", "--grade-one"],
    ),
  )
  if x.code != 0 {
    spawn("rm", ["-rf", root])
    die(
      "capability-probes: a grading worker failed (rc=\{toString(x.code)}):\n"
        + x.out
        + x.err,
      1,
    )
  }
  k = 0
  for p in probes {
    res[p] = readGraded(files[k] + ".out")
    k = k + 1
  }
  spawn("rm", ["-rf", root])
  res
}

function graded(res: Map<string, Graded>, p: string): Graded {
  res[p] ?? { verdict: "", detail: "", out: "", err: "" }
}

// ── `--live-sites` ──────────────────────────────────────────────────────────

type Site = { literal: string, probe: string }

function loadLiveSites(path: string): Site[] {
  const out: Site[] = []
  const j = parseJson(readText(path))
  if j is JsonError {
    die("capability-probes: \{path} is not JSON: \{j.msg}", 1)
    return out
  }
  if j is JsonMap {
    const sites = j["sites"]
    if sites is Json[] {
      for s in sites {
        if s is JsonMap {
          const lit = s["literal"]
          const probe = s["probe"]
          if lit is string && probe is string {
            out.push({ literal: lit, probe: probe })
            continue
          }
        }
        die("capability-probes: a site in \{path} has no literal or probe", 1)
      }
      return out
    }
  }
  die("capability-probes: \{path} has no `sites` list", 1)
  out
}

// `compiler/*.vl` as one text, so a listed literal that has left the tree is caught.
function compilerSource(): string {
  const parts: string[] = []
  for fn in vlFiles("compiler", ".vl") {
    parts.push(readText("compiler/" + fn))
  }
  join(parts, "\n")
}

type Row = { verdict: string, lit: string, probe: string, detail: string }

function liveSites(abs: string, seed: string): i32 {
  const sites = loadLiveSites(HERE + "/live-sites.json")
  const src = compilerSource()
  const rows: Row[] = []
  const toGrade: string[] = []
  for s in sites {
    if !exists(HERE + "/" + s.probe) {
      rows.push(
        {
          verdict: "NOPROBE",
          lit: s.literal,
          probe: s.probe,
          detail: "no such file in scripts/capability-probes/",
        },
      )
    } else if !contains(src, "\"" + s.literal) {
      rows.push(
        {
          verdict: "GONE",
          lit: s.literal,
          probe: s.probe,
          detail: "literal is no longer in compiler/*.vl",
        },
      )
    } else {
      rows.push({ verdict: "", lit: s.literal, probe: s.probe, detail: "" })
      if !toGrade.includes(s.probe) { toGrade.push(s.probe) }
    }
  }
  const res = gradeAll(abs, seed, toGrade)
  let bad = 0
  let live = 0
  for r in rows {
    let verdict = r.verdict
    let detail = r.detail
    if verdict == "" {
      const g = graded(res, r.probe)
      if g.verdict == "RUNS" {
        verdict = "FELL"
        detail = "the witness RUNS — delete this entry"
      } else if !contains(g.err, r.lit) {
        verdict = "DRIFT"
        detail = "\{g.verdict}: \{g.detail}"
      } else {
        verdict = "LIVE"
        detail = g.verdict
      }
    }
    if verdict == "LIVE" { live = live + 1 } else { bad = bad + 1 }
    print(
      "  \{padRight(verdict, 7)} \{padRight(cpPrefix(r.lit, 64), 66)} \{r.probe}",
    )
    if verdict != "LIVE" { print("          " + detail) }
  }
  print(
    "\n\{toString(live)} of \{toString(rows.length)} listed refusal sites still refuse a check-clean program",
  )
  if bad > 0 {
    print(
      "A row above is not what the list claims. The list is a RATCHET: a witness",
    )
    print(
      "that starts running comes OFF it in the PR that closed the gap, and a row",
    )
    print("may only be ADDED with a probe that reaches its literal.")
    return 1
  }
  0
}

// ── `--floor` and the default report ─────────────────────────────────────────────

function floor(probes: string[], res: Map<string, Graded>): i32 {
  let bad = 0
  for fn in probes {
    const g = graded(res, fn)
    if (
      g.verdict == "WRONG"
      || g.verdict == "TIMEOUT"
      || startsWith(g.verdict, "SILENT")
      || startsWith(g.verdict, "COMPILER TRAP")
    ) {
      print("  \{padRight(g.verdict, 26)} \{fn}\n          \{g.detail}")
      bad = bad + 1
    }
  }
  print(
    "\n\{toString(bad)} of \{toString(probes.length)} capability probes break clause 1 (trap, invalid wasm, timeout or wrong output)",
  )
  if bad > 0 { return 1 }
  0
}

function report(probes: string[], res: Map<string, Graded>): i32 {
  const now: string[] = []
  const still: string[] = []
  const why: string[] = []
  for fn in probes {
    const g = graded(res, fn)
    if g.verdict == "RUNS" {
      now.push(fn)
    } else if g.verdict == "WRONG" {
      const want = expected(HERE + "/" + fn) ?? ""
      still.push(fn)
      why.push(
        "RUNS but output " + pyRepr(g.out) + ", header says " + pyRepr(want),
      )
    } else {
      still.push(fn)
      why.push("\{g.verdict}: \{g.detail}")
    }
  }
  for fn in now { print("  RUNS  " + fn) }
  let k = 0
  while k < still.length {
    print("  GAP   " + still[k] + "\n          " + why[k])
    k = k + 1
  }
  print(
    "\n\{toString(now.length)} of \{toString(probes.length)} capability probes run · \{toString(still.length)} still refuse",
  )
  if still.length > 0 {
    print(
      "Each line above is a program the type system accepts and codegen will not build.",
    )
    return 1
  }
  0
}

// ── arguments, read as Python argparse reads them ────────────────────────────────────

const USAGE = "usage: capability-probes.vl [-h] [--compiler COMPILER] [--live-sites] [--floor]"

function usageError(msg: string): i32 {
  print(USAGE)
  print("capability-probes.vl: error: " + msg)
  2
}

// The long option `arg` names, by exact spelling or unique prefix, or "" for none.
function longOpt(arg: string): string {
  if !startsWith(arg, "--") || arg.length < 3 { return "" }
  let hit = ""
  let n = 0
  for o in ["--compiler", "--live-sites", "--floor", "--help"] {
    if o == arg { return o }
    if startsWith(o, arg) {
      hit = o
      n = n + 1
    }
  }
  if n == 1 { return hit }
  ""
}

function main(args: string[]): i32 {
  if (
    args.length == 2
    && (args[0] == "--grade-one" || args[0] == "--grade-channel")
  ) {
    gradeOne(args[1], args[0] == "--grade-channel")
    return 0
  }
  const abs = cwd()
  let seed = abs + "/" + COMPILER
  let live = false
  let fl = false
  let i = 0
  while i < args.length {
    let a = args[i]
    let val: string | null = null
    const eq = findFrom(a, "=", 0)
    if startsWith(a, "--") && eq > 0 {
      val = a.slice(eq + 1, a.length)
      a = a.slice(0, eq)
    }
    const o = if a == "-h" { "--help" } else { longOpt(a) }
    if o == "--help" {
      print(USAGE)
      return 0
    } else if o == "--compiler" {
      if val is string {
        seed = val
      } else if i + 1 < args.length && !startsWith(args[i + 1], "-") {
        seed = args[i + 1]
        i = i + 1
      } else {
        return usageError("argument --compiler: expected one argument")
      }
    } else if o == "--live-sites" && val == null {
      live = true
    } else if o == "--floor" && val == null {
      fl = true
    } else {
      return usageError("unrecognized arguments: " + args[i])
    }
    i = i + 1
  }
  if live { return liveSites(abs, seed) }
  const probes = vlFiles(HERE, ".vl")
  if probes.length == 0 {
    print("no probes found -- that is a failure, not a pass")
    return 1
  }
  const res = gradeAll(abs, seed, probes)
  if fl { return floor(probes, res) }
  report(probes, res)
}

const argv = programArgs()
if argv is Utf8Error {
  die("capability-probes: an argument is not UTF-8: " + argv.msg, 2)
} else {
  exit(main(argv))
}
