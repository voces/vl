+// inst-shadow probe: the one signature call `ix`'s walk-top instance calls the closure handed to
+// its parameter `i` at, which `elabCallBundleSigs` drops as no bundle; -1 for none or several.
+export function elabShadowOneSig(ix: i32, i: i32): i32 {
+  const top = if elabWalkKeys.length > 0 { elabWalkKeys[elabWalkKeys.length - 1] } else { -1 }
+  const k = elabCallInstFrom(ix, top)
+  if k < 0 || i < 0 || i >= 64 { return -1 }
+  const sigs = elabBundleSigs.get(elabBundleKey(k, i)) ?? []
+  if sigs.length == 1 { sigs[0] } else { -1 }
+}
+
+// inst-shadow probe: the walk-top instance's parameter `i` of call `ix` with the shadow aliases a
+// rename minted for its declaration bound as their names are; -1 when that does not close.
+export function elabShadowAliasTy(ix: i32, i: i32): i32 {
+  const top = if elabWalkKeys.length > 0 { elabWalkKeys[elabWalkKeys.length - 1] } else { -1 }
+  const k = elabCallInstFrom(ix, top)
+  if k < 0 { return -1 }
+  const dn = nodeAt(ekDecl[k])
+  const pt = if dn is FuncDecl && i < dn.fnParams.length { nodeTyIxOf(dn.fnParams[i]) } else { -1 }
+  if pt < 0 { return -1 }
+  const ns: string[] = []
+  const ts: i32[] = []
+  let j = 0
+  while j < ekNames[k].length {
+    ns.push(ekNames[k][j])
+    ts.push(ekTys[k][j])
+    j = j + 1
+  }
+  for al in elabAliases {
+    const nm = elabAliasOf[al] ?? ""
+    let q = 0
+    while q < ekNames[k].length {
+      if ekNames[k][q] == nm {
+        ns.push(al)
+        ts.push(ekTys[k][q])
+      }
+      q = q + 1
+    }
+  }
+  const t = elabOutTy(substTyDeep(pt, ns, ts), k)
+  if t >= 0 && !tyHasTyVar(t) { t } else { -1 }
+}
+
+// inst-shadow probe: the walk-top instance's parameter `i` of call `ix`, holes kept; -1 for none.
+export function elabShadowParamTy(ix: i32, i: i32): i32 {
+  const top = if elabWalkKeys.length > 0 { elabWalkKeys[elabWalkKeys.length - 1] } else { -1 }
+  const k = elabCallInstFrom(ix, top)
+  if k < 0 { return -1 }
+  const dn = nodeAt(ekDecl[k])
+  const pt = if dn is FuncDecl && i < dn.fnParams.length { nodeTyIxOf(dn.fnParams[i]) } else { -1 }
+  if pt < 0 { return -1 }
+  substTyDeep(pt, ekNames[k], ekTys[k])
+}
+
+export function elabShadowNoAnswer(ix: i32, i: i32): string {
+  const ks = elabCallKeys[ix] ?? []
+  if ks.length == 0 { return "nokey" }
+  const top = if elabWalkKeys.length > 0 { elabWalkKeys[elabWalkKeys.length - 1] } else { -1 }
+  const k = elabCallInstFrom(ix, top)
+  if k < 0 { return "noframe" }
+  const dn = nodeAt(ekDecl[k])
+  const pt = if dn is FuncDecl && i < dn.fnParams.length { nodeTyIxOf(dn.fnParams[i]) } else { -1 }
+  if pt < 0 { return "open" }
+  const st = substTyDeep(pt, ekNames[k], ekTys[k])
+  if tyHasHole(st) { "openhole" } else { "open" }
+}
+
 export function elabLateLen(i: i32): i32 { elabLateNames[i].length }
 
 export function elabLateAt(i: i32, j: i32): i32 { elabLateNames[i][j] }
