+// inst-shadow probe. Each generic call `monoWalkIdentCall` instances prints one line:
+// `@@IS <line> <callee> <tag>...`, a tag per parameter, comparing the instance's parameter types
+// (`monoInstParamPinTys`) with the elaboration's (`callArgRepTy` over `elabCallParamTy`).
+let instShadowStk: i32[] = []
+let instShadowArmed = false
+
+// Records `fe` as the instance the innermost probed call made or hit, once.
+function instShadowSet(fe: i32): i32 {
+  if !instShadowArmed { return 0 }
+  instShadowArmed = false
+  if instShadowStk.length > 0 && instShadowStk[instShadowStk.length - 1] < 0 {
+    instShadowStk[instShadowStk.length - 1] = fe
+  }
+  0
+}
+
+function instShadowCall(fe: i32, ix: i32): i32 {
+  const tys = monoInstParamPinTys(fe)
+  const tpl = monoCallTplOf(ix)
+  const cn = nodeAt(ix)
+  const cd = if cn is Call { monoCalleeDeclOf(cn) } else { -1 }
+  const cdn = if cd >= 0 && cd < P.nodes.length { nodeAt(cd) } else { nodeAt(0) }
+  const args = monoArgsInParamOrder(ix, cd)
+  let gen = false
+  let line = "@@IS " + i32ToStr(nodeLineOf(ix))
+  if cdn is FuncDecl {
+    gen = cdn.fnTyParams.length > 0
+    line = line + " " + (if cdn.fnName == "" { "<lambda>" } else { cdn.fnName })
+    line = line + (if gen { "/gen" } else { "/plain" })
+  } else {
+    line = line + " ?/plain"
+  }
+  if tys.length == 0 {
+    // Mono declines: does the elaboration close each parameter anyway?
+    line = line + " monoopen"
+    let j = 0
+    while j < args.length {
+      line = line + (if elabCallParamTy(tpl, j) >= 0 { " eo:yes" } else { " eo:no" })
+      j = j + 1
+    }
+    return elabShadowNote(line)
+  }
+  let i = 0
+  while i < tys.length {
+    const e = elabCallParamTy(tpl, i)
+    const pn = if cdn is FuncDecl && i < cdn.fnParams.length { nodeAt(cdn.fnParams[i]) } else { nodeAt(0) }
+    const at = if pn is Param && pn.parType >= 0 { nodeTyIxOf(pn.parType) } else { -1 }
+    if e < 0 {
+      const why = elabShadowNoAnswer(tpl, i)
+      const arg = if i < args.length { args[i] } else { -1 }
+      if why == "nokey" && !gen && at >= 0 && !tyHasTyVar(at) {
+        // A non-generic callee's parameter: its rep is the argument's stored row, else the annotation.
+        const ar = if arg >= 0 { recArgRepOf(monoArgSrcOf(arg)) } else { -1 }
+        const want = if ar >= 0 { ar } else { at }
+        const c = instShadowCls(tys[i], want, tpl, i)
+        line = line + (if c == "REAL" { " no:argrep-dis" } else { " argrep" })
+      } else {
+        let sub = why
+        if why == "nokey" {
+          const f = if cn is Call { unwrapParen(cn.callFn) } else { -1 }
+          const fdn = if f >= 0 { nodeAt(f) } else { nodeAt(0) }
+          const ax = if arg >= 0 { unwrapParen(arg) } else { -1 }
+          const axn = if ax >= 0 { nodeAt(ax) } else { nodeAt(0) }
+          if !(fdn is Ident) { sub = "nokey-nonident" }
+          else if !(cdn is FuncDecl) || identDeclOf(f) != cd { sub = "nokey-value" }
+          else if axn is ArrayLit && axn.arrElems.length == 0 { sub = "nokey-emptylist" }
+          else if !gen { sub = "nokey-plainhole" }
+          else { sub = "nokey-gen" }
+        }
+        line = line + " " + instShadowCands(sub, tys[i], tpl, i, arg)
+      }
+    } else {
+      const r = callArgRepTy(tpl, i, e)
+      let c = instShadowCls(tys[i], r, tpl, i)
+      // A concrete annotation is the parameter's emitted type whatever row the column records.
+      if c == "REAL" && at >= 0 && !tyHasTyVar(at) && tySame(at, r) { c = "annrow" }
+      line = line + " " + c
+      if c == "REAL" {
+        line = line + "[" + i32ToStr(i) + " mono=" + tyToStr(tys[i]) + " elab=" + tyToStr(r) + "]"
+      }
+    }
+    i = i + 1
+  }
+  elabShadowNote(line)
+}
+
+// The tag of a parameter the walk-top instance leaves without a closed type: `<why>:` and, for
+// each other elaboration source in turn (the instances the parameter carries, the argument's own
+// type, the bundle signature), `a` when it agrees with mono's `m`, `d` when it disagrees, `n` when
+// it gives nothing.
+function instShadowCands(why: string, m: i32, tpl: i32, i: i32, arg: i32): string {
+  let out = ""
+  const own = elabCallParamTyOwn(tpl, i)
+  out = out + instShadowCandCh(m, own, tpl, i)
+  const aty = if arg >= 0 { elabNodeTyAgreed(unwrapParen(arg)) } else { -1 }
+  out = out + instShadowCandCh(m, aty, tpl, i)
+  const sigs = elabCallBundleSigs(tpl, i)
+  out = out + instShadowBundleCh(m, sigs, tpl, i)
+  out = out + instShadowTagCh(m, arg)
+  out = out + instShadowCandCh(m, elabShadowAliasTy(tpl, i), tpl, i)
+  const pt = elabShadowParamTy(tpl, i)
+  out = out + (if pt >= 0 && tyToStr(pt) == tyToStr(m) { "a" } else { "n" })
+  out = out + instShadowCandCh(m, elabShadowOneSig(tpl, i), tpl, i)
+  out = out + instShadowCandCh(m, instShadowCheckedParamTy(tpl, i), tpl, i)
+  // Nothing agrees: name both sides, so the cell can be classified from the line.
+  const graded = !strContains(out, "a")
+  out = why + ":" + out
+  if graded {
+    out = out + " {mono=" + tyToStr(m) + " elab=" + (if pt >= 0 { tyToStr(pt) } else { "-" }) + "}"
+  }
+  out
+}
+
+// The checker's closed type for the callee's parameter `i`, as a solved hole leaves it; -1 when open.
+function instShadowCheckedParamTy(tpl: i32, i: i32): i32 {
+  const cn = nodeAt(tpl)
+  const cd = if cn is Call { monoCalleeDeclOf(cn) } else { -1 }
+  if cd < 0 || cd >= P.nodes.length { return -1 }
+  const dn = nodeAt(cd)
+  if !(dn is FuncDecl) || i >= dn.fnParams.length { return -1 }
+  const t = nodeTyIxOf(dn.fnParams[i])
+  if t < 0 || tyHasTyVar(t) || tyHasHole(t) { -1 } else { t }
+}
+
+// The tagged-set source: the set the argument's type carries, spelled as the ids it is stored as.
+function instShadowTagCh(m: i32, arg: i32): string {
+  const ts = if arg >= 0 { monoArgTaggedSetTy(arg) } else { -1 }
+  if ts < 0 { return "n" }
+  const ms = tyToStr(m)
+  if tySame(m, ts) { return "a" }
+  if fnTagTyIsTagged(ts) && ms == "i32" { return "a" }
+  const ln = fnTagListRepName(ts)
+  if ln != "" { return if ln == ms { "a" } else { "d" } }
+  if monoTagMapTy(ts) { return if monoTagMapRepName(ts) == ms { "a" } else { "d" } }
+  "d"
+}
+
+// The bundle source: one signature compares as a type, several as mono's bundle record.
+function instShadowBundleCh(m: i32, sigs: i32[], tpl: i32, i: i32): string {
+  if sigs.length == 0 { return "n" }
+  if sigs.length == 1 { return instShadowCandCh(m, sigs[0], tpl, i) }
+  const mt = tyAt(m)
+  if !(mt is TyObj) || mt.objFieldTypes.length != sigs.length { return "d" }
+  for ft in mt.objFieldTypes {
+    let hit = false
+    for sg in sigs {
+      if tySame(sg, ft) { hit = true }
+    }
+    if !hit { return "d" }
+  }
+  "a"
+}
+
+function instShadowCandCh(m: i32, c: i32, tpl: i32, i: i32): string {
+  if c < 0 || tyHasTyVar(c) || tyHasHole(c) { return "n" }
+  if instShadowCls(m, c, tpl, i) == "REAL" { "d" } else { "a" }
+}
+
+// The agreement class of mono's parameter type `m` and the elaboration's `r` (argument `i` of
+// call `tpl`): `ok` when the same type, a named class when the two differ by a known rep rule.
+function instShadowCls(m: i32, r: i32, tpl: i32, i: i32): string {
+  if tySame(m, r) { return "ok" }
+  if repCanonKey(m) == repCanonKey(r) { return "repeq" }
+  if instShadowSoftKey(m) == instShadowSoftKey(r) { return "litrep" }
+  const xs: i32[] = []
+  flattenVariantsInto(r, xs)
+  let nn = -1
+  let nulls = 0
+  for x in xs {
+    if isNullTy(x) { nulls = nulls + 1 } else if nn < 0 { nn = x } else { nn = -2 }
+  }
+  if nulls > 0 && nn >= 0 && tyAt(m) is TyFunc {
+    if tySame(nn, m) || repCanonKey(nn) == repCanonKey(m) { return "nulfn" }
+  }
+  if tyHasTyVar(m) && !tyHasTyVar(r) { return "monoopenrec" }
+  const sigs = elabCallBundleSigs(tpl, i)
+  const mt = tyAt(m)
+  if sigs.length > 0 && mt is TyObj {
+    let all = mt.objFieldTypes.length == sigs.length
+    for ft in mt.objFieldTypes {
+      let hit = false
+      for sg in sigs {
+        if tySame(sg, ft) { hit = true }
+      }
+      if !hit { all = false }
+    }
+    if all { return "bundle" }
+  }
+  if !(tyAt(m) is TyFunc) && tyAt(r) is TyFunc && !tyHasTyVar(r) { return "colstub" }
+  "REAL"
+}
+
+// `t`'s union members, each literal softened to its base, keyed by rep and sorted.
+function instShadowSoftKey(t: i32): string {
+  const xs: i32[] = []
+  flattenVariantsInto(t, xs)
+  const ks: string[] = []
+  for x in xs {
+    const k = repCanonKey(softenLitTy(x))
+    if !strListHas(ks, k) { ks.push(k) }
+  }
+  const used: boolean[] = []
+  for _k in ks { used.push(false) }
+  let out = ""
+  let n = 0
+  while n < ks.length {
+    let bi = -1
+    let j = 0
+    while j < ks.length {
+      if !used[j] && (bi < 0 || strLess(ks[j], ks[bi])) { bi = j }
+      j = j + 1
+    }
+    used[bi] = true
+    out = out + ks[bi] + ";"
+    n = n + 1
+  }
+  out
+}
+
 // Walk function `fnIx`'s own body, coercing its implicit return first. A bare-expression
 // body parses to a synthetic one-statement `Block` with no `RetStmt`, so `monoWalk`'s
 // `RetStmt` arm has nothing to read; the value of a body block is its last statement,
