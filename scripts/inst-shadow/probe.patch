 export function elabLateCount(): i32 { elabLateNames.length }
 
+// inst-shadow probe: one line per call, printed by `$VL_LATE_DEMANDS=1` as a late demand.
+export function elabShadowNote(s: string): i32 {
+  elabLateNames.push(s)
+  0
+}
+
+// inst-shadow probe: why call `ix` gives parameter `i` no closed type from the walk top.
+export function elabShadowNoAnswer(ix: i32, i: i32): string {
+  const ks = elabCallKeys[ix] ?? []
+  if ks.length == 0 { return "nokey" }
+  const top = if elabWalkKeys.length > 0 { elabWalkKeys[elabWalkKeys.length - 1] } else { -1 }
+  const k = elabCallInstFrom(ix, top)
+  if k < 0 { return "noframe" }
+  const dn = nodeAt(ekDecl[k])
+  const pt = if dn is FuncDecl && i < dn.fnParams.length { nodeTyIxOf(dn.fnParams[i]) } else { -1 }
+  if pt < 0 { return "open" }
+  const st = substTyDeep(pt, ekNames[k], ekTys[k])
+  if tyHasHole(st) { "openhole" } else { "open" }
+}
+
 export function elabLateLen(i: i32): i32 { elabLateNames[i].length }
 
 export function elabLateAt(i: i32, j: i32): i32 { elabLateNames[i][j] }
