// The self-compile IR-miss ratchet: compiler functions the IR builder does not cover.
//
//     vl run scripts/self-ir-misses.vl [-- --check | --write-baseline] [--seed P]
//
// Checks `compiler/entry.vl` once under the blocker census (`$VL_IR_SHADOW=4`, `vl check
// --codegen`) and sums its `blockers <classes>` rows other than `blockers none`: the functions
// I8 needs at zero (ir-design-2026-11.md §10.3). It prints each class row. `--check` exits 1 when
// the count is above the committed `scripts/self-ir-misses-baseline.txt`; a count that fell
// prints and passes. `--write-baseline` records the count, and refuses one above the baseline,
// so the ratchet only lowers. Exit 2 is the harness failing: the check printed no census row.
// Run it from the checkout root. The seed is `--seed`, else `build/vl-compiler.wasm`; the host is
// `$VL_BIN` when set.

import { IoError, readTextFile, writeTextFile } from "std:fs"
import { programArgs } from "std:args"
import { getEnv } from "std:env"
import { exit, runProgram } from "std:process"
import { Utf8Error, decodeUtf8Lossy } from "std:utf8"
import { parseI32 } from "std:fmt"
import { split, startsWith, trim } from "std:str"

function vlBin(): string {
  const v = getEnv("VL_BIN")
  if v is string { return v }
  return "./scripts/vl-host/target/release/vl"
}

const BASELINE = "scripts/self-ir-misses-baseline.txt"
const ROW = "\tblockers "

function die(msg: string, code: i32) {
  print(msg)
  exit(code)
}

// The census's class rows for the self-compile: each row's count and its class set.
type Census = { misses: i32, rows: string[], seen: boolean }

function measure(seed: string): Census {
  const args = [
    "VL_IR_SHADOW=4",
    vlBin(),
    "check",
    "--codegen",
    "--compiler",
    seed,
    "compiler/entry.vl",
  ]
  const r = runProgram("env", args)
  if r is IoError {
    die("self-ir-misses: cannot run \{vlBin()} (\{r.msg})", 2)
    return { misses: 0, rows: [], seen: false }
  }
  const out: Census = { misses: 0, rows: [], seen: false }
  for line in split(decodeUtf8Lossy(r.stderr), "\n") {
    const at = line.indexOf(ROW)
    if !startsWith(line, "[ir] ") || at < 0 { continue }
    const c = line.indexOf(": ")
    if c < 0 || c > at { continue }
    const n = parseI32(line.slice(c + 2, at))
    if !(n is i32) { continue }
    out.seen = true
    const key = line.slice(at + ROW.length, line.length)
    if key == "none" { continue }
    out.misses = out.misses + n
    out.rows.push("  \{n}\t\{key}")
  }
  return out
}

function baseline(): i32 {
  const t = readTextFile(BASELINE)
  if t is IoError {
    die("self-ir-misses: cannot read \{BASELINE} (\{t.msg})", 2)
  }
  const n = if t is string { parseI32(trim(t)) } else { null }
  if !(n is i32) {
    die("self-ir-misses: \{BASELINE} holds no count", 2)
    return 0
  }
  return n
}

const args = programArgs()
const argv: string[] = if args is Utf8Error { [] } else { args }
let seed = "build/vl-compiler.wasm"
let mode = ""
let i = 0
while i < argv.length {
  const a = argv[i]
  if a == "--seed" && i + 1 < argv.length {
    seed = argv[i + 1]
    i = i + 1
  } else if a == "--check" || a == "--write-baseline" {
    mode = a
  }
  i = i + 1
}
const got = measure(seed)
if !got.seen {
  die(
    "self-ir-misses: the census printed no row (is \{seed} a seed with the IR shadow?)",
    2,
  )
}
for r in got.rows { print(r) }
const base = baseline()
if mode == "--write-baseline" {
  if got.misses > base {
    die(
      "self-ir-misses: \{got.misses} missed is above the baseline \{base}; the ratchet only lowers",
      1,
    )
  }
  const w = writeTextFile(BASELINE, "\{got.misses}\n")
  if w is IoError {
    die("self-ir-misses: cannot write \{BASELINE} (\{w.msg})", 2)
  }
  print("self-ir-misses: baseline \{base} → \{got.misses}")
} else if got.misses > base {
  die(
    "self-ir-misses: \{got.misses} self-compile functions the IR misses, above the baseline \{base} — cover them, or name the class to the coordinator",
    1,
  )
} else if got.misses < base {
  print(
    "self-ir-misses ok — \{got.misses} missed, below the baseline \{base}: lower it with -- --write-baseline",
  )
} else {
  print("self-ir-misses ok — \{got.misses} missed (baseline \{base})")
}
