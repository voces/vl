// Binary multiprecision floats for the std:math graders, trig-grade.vl and math-grade.vl: the
// part of mpmath they grade against. A value is `s * M * 2^e`, M a natural in 28-bit limbs.
//
//     import { BF, expBF, fromF64, toF64 } from "./bigfloat"
//
// Arithmetic truncates to the `prec` bits it is given; `roundNearest` is the one rounding
// step, for matching a reference mpmath rounded at its working precision. The functions
// take finite arguments in their domain and are good to a few units in the last of `prec`
// bits. Not a general library: no NaN, no infinity, and exp saturates (see `expBF`).

import { filled } from "std:array"
import { logF64 } from "std:math"

const LB = 28
const MASK: i64 = 268435455
const ZL: i64 = 0
const ONE64: i64 = 1

export type BF = { s: i32, m: i64[], e: i32 }

export type SinCos = { sin: BF, cos: BF }

// ── naturals: little-endian 28-bit limbs, no zero limb on top ───────────────────────

function limbBits(v: i64): i32 { (64 - clz(v)) as! i32 }

function nBits(m: i64[]): i32 {
  if m.length == 0 { return 0 }
  (m.length - 1) * LB + limbBits(m[m.length - 1])
}

function trimmed(m: i64[]): i64[] {
  while m.length > 0 && m[m.length - 1] == 0 { m.pop() }
  m
}

function nShl(m: i64[], k: i32): i64[] {
  if m.length == 0 { return [] }
  const out: i64[] = filled(k / LB, ZL)
  const r = (k % LB) as i64
  if r == 0 {
    for v in m { out.push(v) }
    return out
  }
  let carry = ZL
  for v in m {
    out.push(((v << r) & MASK) | carry)
    carry = v >> (28 - r)
  }
  if carry != 0 { out.push(carry) }
  out
}

function nShr(m: i64[], k: i32): i64[] {
  const q = k / LB
  if q >= m.length { return [] }
  const r = (k % LB) as i64
  const out: i64[] = []
  let i = q
  while i < m.length {
    let v = m[i] >> r
    if r != 0 && i + 1 < m.length { v = v | ((m[i + 1] << (28 - r)) & MASK) }
    out.push(v)
    i = i + 1
  }
  trimmed(out)
}

function nCmp(a: i64[], b: i64[]): i32 {
  if a.length != b.length {
    if a.length < b.length { return -1 }
    return 1
  }
  let i = a.length - 1
  while i >= 0 {
    if a[i] != b[i] {
      if a[i] < b[i] { return -1 }
      return 1
    }
    i = i - 1
  }
  0
}

function nAdd(a: i64[], b: i64[]): i64[] {
  const out: i64[] = []
  let carry = ZL
  let i = 0
  while i < a.length || i < b.length {
    let v = carry
    if i < a.length { v = v + a[i] }
    if i < b.length { v = v + b[i] }
    out.push(v & MASK)
    carry = v >> 28
    i = i + 1
  }
  if carry != 0 { out.push(carry) }
  out
}

// a - b for a >= b.
function nSub(a: i64[], b: i64[]): i64[] {
  const out: i64[] = []
  let borrow = ZL
  let i = 0
  while i < a.length {
    let v = a[i] - borrow
    if i < b.length { v = v - b[i] }
    borrow = 0
    if v < 0 {
      v = v + 268435456
      borrow = 1
    }
    out.push(v)
    i = i + 1
  }
  trimmed(out)
}

// Each column sums at most min(len) products below 2^56, so 2^63 holds up to 128 limbs.
function nMul(a: i64[], b: i64[]): i64[] {
  const acc: i64[] = filled(a.length + b.length, ZL)
  let i = 0
  while i < a.length {
    const ai = a[i]
    if ai != 0 {
      let j = 0
      while j < b.length {
        acc[i + j] = acc[i + j] + ai * b[j]
        j = j + 1
      }
    }
    i = i + 1
  }
  let carry = ZL
  let k = 0
  while k < acc.length {
    const v = acc[k] + carry
    acc[k] = v & MASK
    carry = v >> 28
    k = k + 1
  }
  trimmed(acc)
}

// m * c and m / c (truncating) for 0 < c < 2^34.
function nMulSmall(m: i64[], c: i64): i64[] {
  const out: i64[] = []
  let carry = ZL
  for v in m {
    const t = v * c + carry
    out.push(t & MASK)
    carry = t >> 28
  }
  while carry != 0 {
    out.push(carry & MASK)
    carry = carry >> 28
  }
  out
}

function nDivSmall(m: i64[], c: i64): i64[] {
  const out: i64[] = filled(m.length, ZL)
  let r = ZL
  let i = m.length - 1
  while i >= 0 {
    const t = (r << 28) | m[i]
    out[i] = t / c
    r = t % c
    i = i - 1
  }
  trimmed(out)
}

function testBit(m: i64[], i: i32): boolean {
  if i < 0 || i / LB >= m.length { return false }
  ((m[i / LB] >> ((i % LB) as i64)) & 1) == 1
}

// Whether any bit below bit `i` is set.
function anyBelow(m: i64[], i: i32): boolean {
  let k = 0
  while k < i / LB && k < m.length {
    if m[k] != 0 { return true }
    k = k + 1
  }
  if k >= m.length || i % LB == 0 { return false }
  (m[k] & ((ONE64 << ((i % LB) as i64)) - 1)) != 0
}

function toI64(m: i64[]): i64 {
  let v = ZL
  let i = m.length - 1
  while i >= 0 {
    v = (v << 28) | m[i]
    i = i - 1
  }
  v
}

// ── values ───────────────────────────────────────────────────────────────────────

export function zero(): BF { { s: 0, m: [], e: 0 } }

export function one(): BF { { s: 1, m: [ONE64], e: 0 } }

function mk(s: i32, m: i64[], e: i32, prec: i32): BF {
  const t = trimmed(m)
  if t.length == 0 { return zero() }
  const n = nBits(t)
  if n > prec { return { s: s, m: nShr(t, n - prec), e: e + n - prec } }
  { s: s, m: t, e: e }
}

// The exact value of a finite double.
export function fromF64(x: f64): BF {
  const b = f64bits(x)
  const be = ((b >>> 52) & 2047) as! i32
  let frac = b & 4503599627370495
  let e = -1074
  if be != 0 {
    frac = frac + 4503599627370496
    e = be - 1075
  }
  let s = 1
  if b < 0 { s = -1 }
  mk(s, [frac & MASK, frac >> 28], e, 64)
}

export function fromI32(n: i32): BF {
  let s = 1
  let v = n as i64
  if v < 0 {
    s = -1
    v = 0 - v
  }
  mk(s, [v & MASK, (v >> 28) & MASK], 0, 64)
}

function pow2(k: i32): f64 {
  if k >= -1022 { return f64fromBits(((k + 1023) as i64) << 52) }
  f64fromBits(ONE64 << ((k + 1074) as i64))
}

// The double nearest `a`, ties to even, through the subnormals and out to infinity.
export function toF64(a: BF): f64 {
  if a.s == 0 { return 0.0 }
  const top = a.e + nBits(a.m) - 1
  let v = 1.0 / 0.0
  if top <= 1023 {
    let lsb = top - 52
    if lsb < -1074 { lsb = -1074 }
    const sh = lsb - a.e
    let mant = ZL
    if sh <= 0 {
      mant = toI64(nShl(a.m, 0 - sh))
    } else {
      mant = toI64(nShr(a.m, sh))
      if testBit(a.m, sh - 1) && (anyBelow(a.m, sh - 1) || (mant & 1) == 1) {
        mant = mant + 1
      }
    }
    v = (mant as f64) * pow2(lsb)
  }
  if a.s < 0 { return 0.0 - v }
  v
}

// floor(log2 |a|) for a nonzero `a`.
export function floorLog2(a: BF): i32 { a.e + nBits(a.m) - 1 }

export function ldexp(a: BF, k: i32): BF { { s: a.s, m: a.m, e: a.e + k } }

export function neg(a: BF): BF { { s: 0 - a.s, m: a.m, e: a.e } }

export function absBF(a: BF): BF {
  if a.s < 0 { return neg(a) }
  a
}

export function cmpAbs(a: BF, b: BF): i32 {
  if a.s == 0 || b.s == 0 {
    if a.s == 0 && b.s == 0 { return 0 }
    if a.s == 0 { return -1 }
    return 1
  }
  const ta = floorLog2(a)
  const tb = floorLog2(b)
  if ta != tb {
    if ta < tb { return -1 }
    return 1
  }
  let e0 = a.e
  if b.e < e0 { e0 = b.e }
  nCmp(nShl(a.m, a.e - e0), nShl(b.m, b.e - e0))
}

export function cmp(a: BF, b: BF): i32 {
  if a.s != b.s {
    if a.s < b.s { return -1 }
    return 1
  }
  if a.s >= 0 { return cmpAbs(a, b) }
  0 - cmpAbs(a, b)
}

export function round(a: BF, prec: i32): BF { mk(a.s, a.m, a.e, prec) }

// `a` rounded to `prec` bits, nearest with ties to even.
export function roundNearest(a: BF, prec: i32): BF {
  const n = nBits(a.m)
  if n <= prec { return a }
  const sh = n - prec
  let q = nShr(a.m, sh)
  if testBit(a.m, sh - 1) && (anyBelow(a.m, sh - 1) || (q[0] & 1) == 1) {
    q = nAdd(q, [ONE64])
  }
  mk(a.s, q, a.e + sh, prec + 1)
}

export function add(a: BF, b: BF, prec: i32): BF {
  if a.s == 0 { return round(b, prec) }
  if b.s == 0 { return round(a, prec) }
  let hi = a.e + nBits(a.m)
  const tb = b.e + nBits(b.m)
  if tb > hi { hi = tb }
  const cut = hi - prec - 16
  let am = a.m
  let ae = a.e
  if ae < cut {
    am = nShr(am, cut - ae)
    ae = cut
  }
  let bm = b.m
  let be = b.e
  if be < cut {
    bm = nShr(bm, cut - be)
    be = cut
  }
  if am.length == 0 { return mk(b.s, bm, be, prec) }
  if bm.length == 0 { return mk(a.s, am, ae, prec) }
  let e0 = ae
  if be < e0 { e0 = be }
  am = nShl(am, ae - e0)
  bm = nShl(bm, be - e0)
  if a.s == b.s { return mk(a.s, nAdd(am, bm), e0, prec) }
  const c = nCmp(am, bm)
  if c == 0 { return zero() }
  if c > 0 { return mk(a.s, nSub(am, bm), e0, prec) }
  mk(b.s, nSub(bm, am), e0, prec)
}

export function sub(a: BF, b: BF, prec: i32): BF { add(a, neg(b), prec) }

export function mul(a: BF, b: BF, prec: i32): BF {
  if a.s == 0 || b.s == 0 { return zero() }
  mk(a.s * b.s, nMul(a.m, b.m), a.e + b.e, prec)
}

// a * k for |k| < 2^28.
export function mulInt(a: BF, k: i32, prec: i32): BF {
  if a.s == 0 || k == 0 { return zero() }
  let s = a.s
  let c = k as i64
  if c < 0 {
    s = 0 - s
    c = 0 - c
  }
  mk(s, nMulSmall(a.m, c), a.e, prec)
}

// a / k for 0 < |k| < 2^34.
export function divInt(a: BF, k: i64, prec: i32): BF {
  if a.s == 0 { return a }
  let s = a.s
  let c = k
  if c < 0 {
    s = 0 - s
    c = 0 - c
  }
  let sh = prec + 40 - nBits(a.m)
  if sh < 0 { sh = 0 }
  mk(s, nDivSmall(nShl(a.m, sh), c), a.e - sh, prec)
}

// 1 / b for a nonzero `b`, by Newton from the double's reciprocal.
function recip(b: BF, prec: i32): BF {
  const t = floorLog2(b)
  const f = toF64({ s: 1, m: b.m, e: b.e - t })
  const seed = fromF64(1.0 / f)
  let r: BF = { s: b.s, m: seed.m, e: seed.e - t }
  let p = 48
  while p < prec + 8 {
    p = 2 * p
    const wp = p + 24
    const d = sub(one(), mul(b, r, wp), wp)
    r = add(r, mul(r, d, wp), wp)
  }
  round(r, prec)
}

export function div(a: BF, b: BF, prec: i32): BF {
  mul(a, recip(b, prec + 8), prec)
}

// sqrt(a) for a >= 0, as a / sqrt(a) by Newton on the inverse square root.
export function sqrtBF(a: BF, prec: i32): BF {
  if a.s == 0 { return a }
  const t = floorLog2(a)
  let k = t / 2
  if t < 0 && t % 2 != 0 { k = k - 1 }
  const f = toF64({ s: 1, m: a.m, e: a.e - 2 * k })
  const seed = fromF64(1.0 / sqrt(f))
  let r: BF = { s: 1, m: seed.m, e: seed.e - k }
  let p = 48
  while p < prec + 8 {
    p = 2 * p
    const wp = p + 24
    const d = sub(one(), mul(a, mul(r, r, wp), wp), wp)
    r = add(r, ldexp(mul(r, d, wp), -1), wp)
  }
  mul(a, r, prec)
}

// ── constants, cached at the widest precision asked for ──────────────────────────────

// sum of (+-)1 / ((2k+1) n^(2k+1)): atan(1/n), or atanh(1/n) when `hyper`.
function arcInv(n: i64, hyper: boolean, p: i32): BF {
  const x = divInt(one(), n, p)
  const n2 = n * n
  let term = x
  let sum = x
  let k = 1
  while true {
    term = divInt(term, n2, p)
    if term.s == 0 || floorLog2(term) < floorLog2(sum) - p - 4 { break }
    const t = divInt(term, (2 * k + 1) as i64, p)
    if hyper || k % 2 == 0 {
      sum = add(sum, t, p)
    } else {
      sum = sub(sum, t, p)
    }
    k = k + 1
  }
  sum
}

let piVal: BF = { s: 0, m: [], e: 0 }
let piAt = 0
let ln2Val: BF = { s: 0, m: [], e: 0 }
let ln2At = 0

export function piBF(prec: i32): BF {
  if piAt < prec {
    const p = prec + 64
    piVal = sub(
      ldexp(arcInv(5, false, p + 8), 4),
      ldexp(arcInv(239, false, p + 8), 2),
      p,
    )
    piAt = p
  }
  round(piVal, prec)
}

function ln2BF(prec: i32): BF {
  if ln2At < prec {
    const p = prec + 64
    ln2Val = round(ldexp(arcInv(3, true, p + 8), 1), p)
    ln2At = p
  }
  round(ln2Val, prec)
}

// ── functions ────────────────────────────────────────────────────────────────────

// e^x. Saturates: past x = 800 it answers 2^4000 and below x = -2000 it answers 2^-4000,
// which grade like the true value against any double.
export function expBF(x: BF, prec: i32): BF {
  if x.s == 0 { return one() }
  const xf = toF64(x)
  if xf > 800.0 { return ldexp(one(), 4000) }
  if xf < -2000.0 { return ldexp(one(), -4000) }
  const wp = prec + 48
  const k = nearest(xf / 0.6931471805599453) as! i32
  let r = x
  if k != 0 { r = sub(x, mulInt(ln2BF(wp + 16), k, wp + 16), wp) }
  r = ldexp(r, -12)
  // u = e^r - 1, then (1 + u)^2 - 1 = 2u + u^2 twelve times.
  let term = r
  let u = r
  let n = 1
  while true {
    n = n + 1
    term = divInt(mul(term, r, wp), n as i64, wp)
    if term.s == 0 || floorLog2(term) < 0 - wp { break }
    u = add(u, term, wp)
  }
  let i = 0
  while i < 12 {
    u = add(ldexp(u, 1), mul(u, u, wp), wp)
    i = i + 1
  }
  ldexp(add(one(), u, prec), k)
}

// ln x for x > 0: x = m 2^t with m in [0.75, 1.5), and ln m by two cubic Newton steps on
// e^y from the double's logarithm.
export function logBF(x: BF, prec: i32): BF {
  let t = floorLog2(x)
  let m = ldexp(x, 0 - t)
  if toF64(m) >= 1.5 {
    m = ldexp(m, -1)
    t = t + 1
  }
  const wp = prec + 48
  let y = fromF64(logF64(toF64(m)))
  let i = 0
  while i < 2 {
    const ey = expBF(y, wp)
    y = add(y, ldexp(div(sub(m, ey, wp), add(m, ey, wp), wp), 1), wp)
    i = i + 1
  }
  if t == 0 { return round(y, prec) }
  add(mulInt(ln2BF(wp), t, wp), y, prec)
}

// atan x: past 1 by pi/2 - atan(1/x), then four half-angle steps and the series.
export function atanBF(x: BF, prec: i32): BF {
  if x.s == 0 { return x }
  const wp = prec + 48
  let a = absBF(x)
  const inv = cmpAbs(a, one()) > 0
  if inv { a = div(one(), a, wp) }
  let i = 0
  while i < 4 {
    a = div(a, add(one(), sqrtBF(add(one(), mul(a, a, wp), wp), wp), wp), wp)
    i = i + 1
  }
  const a2 = mul(a, a, wp)
  let term = a
  let sum = a
  let k = 1
  while true {
    term = mul(term, a2, wp)
    const d = divInt(term, (2 * k + 1) as i64, wp)
    if d.s == 0 || floorLog2(d) < floorLog2(sum) - wp - 4 { break }
    if k % 2 == 0 { sum = add(sum, d, wp) } else { sum = sub(sum, d, wp) }
    k = k + 1
  }
  let r = ldexp(sum, 4)
  if inv { r = sub(ldexp(piBF(wp), -1), r, wp) }
  if x.s < 0 { r = neg(r) }
  round(r, prec)
}

// atan2(y, x), the angle of the point (x, y), in [-pi, pi].
export function atan2BF(y: BF, x: BF, prec: i32): BF {
  const wp = prec + 16
  if x.s == 0 {
    if y.s == 0 { return zero() }
    const h = ldexp(piBF(prec), -1)
    if y.s < 0 { return neg(h) }
    return h
  }
  if y.s == 0 {
    if x.s > 0 { return zero() }
    return piBF(prec)
  }
  const q = atanBF(div(y, x, wp), wp)
  if x.s > 0 { return round(q, prec) }
  if y.s > 0 { return add(q, piBF(wp), prec) }
  sub(q, piBF(wp), prec)
}

// sin x and cos x: x - k pi/2 with pi carried past x's own bits, then the series at x/256
// and eight double-angle steps on (sin, cos - 1).
export function sinCos(x: BF, prec: i32): SinCos {
  if x.s == 0 { return { sin: zero(), cos: one() } }
  let ex = floorLog2(x) + 1
  if ex < 0 { ex = 0 }
  const wp = ex + prec + 64
  const hp = ldexp(piBF(wp), -1)
  const q = mul(x, recip(hp, wp), wp)
  // k = nearest(q), and k mod 4.
  let k = zero()
  let quad = 0
  if q.e >= 0 {
    k = q
  } else if floorLog2(q) >= -1 {
    let km = nShr(q.m, 0 - q.e)
    if testBit(q.m, 0 - q.e - 1) { km = nAdd(km, [ONE64]) }
    k = mk(q.s, km, 0, wp)
  }
  if k.s != 0 && k.e < 2 {
    quad = ((k.m[0] << (k.e as i64)) & 3) as! i32
    if k.s < 0 { quad = (4 - quad) % 4 }
  }
  let r = x
  if k.s != 0 { r = sub(x, mul(k, hp, wp), wp) }
  const kp = prec + 32
  if r.s == 0 { return { sin: zero(), cos: one() } }
  const t = ldexp(round(r, kp), -8)
  const t2 = mul(t, t, kp)
  let term = t
  let s = t
  let n = 1
  while true {
    term = neg(divInt(mul(term, t2, kp), ((n + 1) * (n + 2)) as i64, kp))
    n = n + 2
    if term.s == 0 || floorLog2(term) < floorLog2(s) - kp - 4 { break }
    s = add(s, term, kp)
  }
  term = neg(ldexp(t2, -1))
  let c = term
  n = 2
  while true {
    term = neg(divInt(mul(term, t2, kp), ((n + 1) * (n + 2)) as i64, kp))
    n = n + 2
    if term.s == 0 || floorLog2(term) < floorLog2(c) - kp - 4 { break }
    c = add(c, term, kp)
  }
  const two = fromI32(2)
  let i = 0
  while i < 8 {
    const s2 = ldexp(mul(s, add(one(), c, kp), kp), 1)
    c = ldexp(mul(c, add(c, two, kp), kp), 1)
    s = s2
    i = i + 1
  }
  const co = add(one(), c, kp)
  if quad == 0 { return { sin: round(s, prec), cos: round(co, prec) } }
  if quad == 1 { return { sin: round(co, prec), cos: round(neg(s), prec) } }
  if quad == 2 {
    return { sin: round(neg(s), prec), cos: round(neg(co), prec) }
  }
  { sin: round(neg(co), prec), cos: round(s, prec) }
}
