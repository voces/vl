// Accuracy/determinism grid for std:math exp, log, pow, atan, asin, acos, atan2 and hypot.
// One line per point, upper case for f64 and lower case for f32:
//   E|L|A|S|C <x bits> <result bits>   (exp, log, atan, asin, acos)
//   P|T|H <x bits> <y bits> <result bits>   (pow(x, y), atan2(x, y), hypot(x, y))
import {
  acosF32,
  acosF64,
  asinF32,
  asinF64,
  atan2F32,
  atan2F64,
  atanF32,
  atanF64,
  expF32,
  expF64,
  hypotF32,
  hypotF64,
  logF32,
  logF64,
  powF32,
  powF64,
} from "std:math"

let seed: i64 = 0x2545F4914F6CDD1D
function next(): i64 {
  seed = seed * 6364136223846793005 + 1442695040888963407
  return seed
}
// Uniform in [0, 1).
function unit(): f64 {
  return ((next() >>> 11) as f64) * 1.1102230246251565e-16
}
function between(a: f64, b: f64): f64 { return a + (b - a) * unit() }

function ed(x: f64) { print("E \{f64bits(x)} \{f64bits(expF64(x))}") }
function ef(x: f32) { print("e \{f32bits(x)} \{f32bits(expF32(x))}") }
function ld(x: f64) { print("L \{f64bits(x)} \{f64bits(logF64(x))}") }
function lf(x: f32) { print("l \{f32bits(x)} \{f32bits(logF32(x))}") }
function pd(x: f64, y: f64) {
  print("P \{f64bits(x)} \{f64bits(y)} \{f64bits(powF64(x, y))}")
}
function pf(x: f32, y: f32) {
  print("p \{f32bits(x)} \{f32bits(y)} \{f32bits(powF32(x, y))}")
}

function ad(x: f64) { print("A \{f64bits(x)} \{f64bits(atanF64(x))}") }
function af(x: f32) { print("a \{f32bits(x)} \{f32bits(atanF32(x))}") }
function sd(x: f64) {
  print("S \{f64bits(x)} \{f64bits(asinF64(x))}")
  print("C \{f64bits(x)} \{f64bits(acosF64(x))}")
}
function sf(x: f32) {
  print("s \{f32bits(x)} \{f32bits(asinF32(x))}")
  print("c \{f32bits(x)} \{f32bits(acosF32(x))}")
}
function td(y: f64, x: f64) {
  print("T \{f64bits(y)} \{f64bits(x)} \{f64bits(atan2F64(y, x))}")
  print("H \{f64bits(y)} \{f64bits(x)} \{f64bits(hypotF64(y, x))}")
}
function tf(y: f32, x: f32) {
  print("t \{f32bits(y)} \{f32bits(x)} \{f32bits(atan2F32(y, x))}")
  print("h \{f32bits(y)} \{f32bits(x)} \{f32bits(hypotF32(y, x))}")
}

const N = 250000
let i = 0
// exp: the whole finite range, the unit interval, the tiny, and the subnormal results.
while i < N {
  ed(between(-745.2, 709.8))
  ed(between(-1.0, 1.0))
  ed(between(-1e-6, 1e-6))
  ed(between(-745.2, -700.0))
  ed(f64fromBits(next()))
  ef(between(-104.0, 88.8) as f32)
  ef(between(-1.0, 1.0) as f32)
  ef(f32fromBits((next() >>> 32) as% i32))
  i = i + 1
}
// log: every positive bit pattern, near 1 (where the result is tiny), and [0.5, 2].
i = 0
while i < N {
  ld(f64fromBits(next() >>> 1))
  ld(between(0.5, 2.0))
  ld(1.0 + between(-1e-6, 1e-6))
  ld(between(1e-300, 1e-290))
  lf(f32fromBits(((next() >>> 33) as% i32)))
  lf(between(0.5, 2.0) as f32)
  lf((1.0 + between(-1e-3, 1e-3)) as f32)
  i = i + 1
}
// pow: moderate pairs, any x with a y that keeps the result finite, x near 1 with a huge y,
// integer y over a negative x, and results in the subnormals.
i = 0
while i < N {
  pd(between(0.0, 4.0), between(-50.0, 50.0))
  const x = f64fromBits((next() >>> 2) + 0x1000000000000000)
  pd(x, between(-700.0, 700.0) / logF64(x))
  pd(1.0 + between(-1e-9, 1e-9), between(-1e12, 1e12))
  pd(between(-10.0, 10.0), nearest(between(-60.0, 60.0)))
  const xs = between(1e-3, 1e3)
  pd(xs, between(-745.0, -708.0) / logF64(xs))
  pf(between(0.0, 4.0) as f32, between(-30.0, 30.0) as f32)
  const xf = between(1e-30, 1e30)
  pf(xf as f32, (between(-100.0, 88.0) / logF64(xf)) as f32)
  pf(between(-10.0, 10.0) as f32, nearest(between(-30.0, 30.0)) as f32)
  pf((1.0 + between(-1e-4, 1e-4)) as f32, between(-1e5, 1e5) as f32)
  i = i + 1
}
// atan, asin, acos, atan2 and hypot: the interesting intervals, near the ends of asin/acos,
// every bit pattern, and atan2/hypot over magnitudes far apart, tiny and huge.
i = 0
while i < N {
  ad(between(-2.0, 2.0))
  ad(f64fromBits(next()))
  af(between(-4.0, 4.0) as f32)
  af(f32fromBits((next() >>> 32) as% i32))
  sd(between(-1.0, 1.0))
  sd(1.0 - between(0.0, 1e-6))
  sd(between(-1e-6, 1e-6))
  sf(between(-1.0, 1.0) as f32)
  sf((1.0 - between(0.0, 1e-3)) as f32)
  td(between(-10.0, 10.0), between(-10.0, 10.0))
  td(f64fromBits(next()), f64fromBits(next()))
  const m = between(-1.0, 1.0)
  td(m * powF64(10.0, between(-300.0, 300.0)), between(-1.0, 1.0))
  td(between(-1e-310, 1e-310), between(-1e-310, 1e-310))
  tf(between(-10.0, 10.0) as f32, between(-10.0, 10.0) as f32)
  tf(f32fromBits((next() >>> 32) as% i32), f32fromBits((next() >>> 32) as% i32))
  i = i + 1
}
// Every small integer power, which must come out exact whenever it is a double.
let a = -40
while a <= 40 {
  let b = -80
  while b <= 80 {
    pd(a as f64, b as f64)
    pf(a as f32, b as f32)
    b = b + 1
  }
  a = a + 1
}
// The edges: every pair of these, and each one through exp and log.
const zero = 0.0
const specials: f64[] = [
  0.0,
  -0.0,
  1.0,
  -1.0,
  0.5,
  -0.5,
  2.0,
  -2.0,
  3.0,
  -3.0,
  0.25,
  1.5,
  -1.5,
  1e300,
  -1e300,
  1e-300,
  5e-324,
  -5e-324,
  2.2250738585072014e-308,
  1.7976931348623157e308,
  -1.7976931348623157e308,
  9007199254740992.0,
  9007199254740994.0,
  -9007199254740991.0,
  1e17,
  709.782712893384,
  709.7827128933841,
  -745.1332191019411,
  -745.1332191019412,
  -708.3964185322641,
  88.72283935546875,
  88.72284,
  -103.97207708,
  -87.33654,
  0.9999999999999999,
  1.0000000000000002,
  zero / zero,
  1.0 / zero,
  -1.0 / zero,
]
for x in specials {
  ed(x)
  ef(x as f32)
  ld(x)
  lf(x as f32)
  ad(x)
  af(x as f32)
  sd(x)
  sf(x as f32)
  for y in specials {
    pd(x, y)
    pf(x as f32, y as f32)
    td(x, y)
    tf(x as f32, y as f32)
  }
}
