// Accuracy/determinism grid for std:math sin/cos. Prints one line per point:
//   D <x bits> <sinF64 bits> <cosF64 bits>
//   F <x bits> <sinF32 bits> <cosF32 bits>
import { cosF32, cosF64, sinF32, sinF64 } from "std:math"

let seed: i64 = 0x2545F4914F6CDD1D
function next(): i64 {
  seed = seed * 6364136223846793005 + 1442695040888963407
  return seed
}
function unit(): f64 {
  return ((next() >>> 11) as f64) * 1.1102230246251565e-16
}

function d(x: f64) {
  print("D \{f64bits(x)} \{f64bits(sinF64(x))} \{f64bits(cosF64(x))}")
}
function f(x: f32) {
  print("F \{f32bits(x)} \{f32bits(sinF32(x))} \{f32bits(cosF32(x))}")
}
function dn(x: f64) {
  d(x)
  d(f64fromBits(f64bits(x) + 1))
  d(f64fromBits(f64bits(x) - 1))
}
function fn(x: f32) {
  f(x)
  f(f32fromBits(f32bits(x) + 1))
  f(f32fromBits(f32bits(x) - 1))
}

const PIO2 = 1.5707963267948966
const N = 1000000

// A: uniform over [-1e6, 1e6], both widths.
let i = 0
while i < N {
  const x = (unit() * 2.0 - 1.0) * 1000000.0
  d(x)
  f(x as f32)
  i = i + 1
}
// B: random bit patterns, every exponent.
i = 0
while i < 200000 {
  const b = next()
  d(f64fromBits(b))
  f(f32fromBits((b >>> 32) as% i32))
  i = i + 1
}
// C: near multiples of π/2, small k exhaustive, large k random.
i = 1
while i <= 20000 {
  const k = i as f64
  dn(k * PIO2)
  dn(0.0 - k * PIO2)
  fn((k * PIO2) as f32)
  i = i + 1
}
i = 0
while i < 50000 {
  const k = nearest(unit() * 1125899906842624.0)
  dn(k * PIO2)
  const k32 = nearest(unit() * 268435456.0)
  fn((k32 * PIO2) as f32)
  i = i + 1
}
// D: special points.
const specials: f64[] = [
  0.0,
  -0.0,
  1e-300,
  -1e-300,
  5e-324,
  2.2250738585072014e-308,
  1e-310,
  1.4901161193847656e-8,
  1.4901161193847654e-8,
  7.450580596923828e-9,
  7.450580596923827e-9,
  0.7853981633974483,
  0.7853981633974484,
  1.0,
  2.0,
  3.0,
  3.141592653589793,
  6.283185307179586,
  1647098.9,
  1647099.0,
  1647099.1,
  1048576.0,
  1e6,
  -1e6,
  1e15,
  -1e15,
  1e22,
  1e100,
  1e300,
  1.7976931348623157e308,
  -1.7976931348623157e308,
  0.0 / 0.0,
  1.0 / 0.0,
  -1.0 / 0.0,
  f64fromBits(0x7A95B12A1F4C8D27),
  6381956970095103.0 * 1e240,
]
for x in specials {
  d(x)
  f(x as f32)
}
d(f64fromBits(0x7FF8000000000000))
d(f64fromBits(0xFFF8000000000001))
f(f32fromBits(0x7FC00000))
// The double closest to a multiple of π/2: 6381956970095103 * 2^797.
let w = 6381956970095103.0
let e = 0
while e < 797 {
  w = w * 2.0
  e = e + 1
}
dn(w)
dn(0.0 - w)
