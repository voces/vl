// Every non-negative finite f32 through sinF32 and cosF32, graded against sinF64/cosF64 (each
// within 1 f64 ulp, so a reference good to ~2^-29 f32 ulp). Prints the worst error in f32 ulps
// and where it occurs, and how many results differ from the reference rounded to f32. Both
// functions are odd/even by construction, so the negative half adds nothing.
import { cosF32, cosF64, sinF32, sinF64 } from "std:math"

function ulpErr(got: f32, ref: f64): f64 {
  let e = ((f64bits(ref) >>> 52) & 0x7FF) - 1023
  if e < -126 { e = -126 }
  const ulp = f64fromBits((e - 23 + 1023) << 52)
  return abs((got as f64) - ref) / ulp
}

let worstS = 0.0
let worstSx = 0
let worstC = 0.0
let worstCx = 0
let missS = 0
let missC = 0
let b = 0
while b <= 0x7F7FFFFF {
  const x = f32fromBits(b)
  const rs = sinF64(x as f64)
  const s = sinF32(x)
  const es = ulpErr(s, rs)
  if es > worstS {
    worstS = es
    worstSx = b
  }
  if s != (rs as f32) { missS = missS + 1 }
  const rc = cosF64(x as f64)
  const c = cosF32(x)
  const ec = ulpErr(c, rc)
  if ec > worstC {
    worstC = ec
    worstCx = b
  }
  if c != (rc as f32) { missC = missC + 1 }
  b = b + 1
}
print(
  "sinF32 worst \{worstS} ulp at bits \{worstSx}; \{missS} differ from sinF64 rounded",
)
print(
  "cosF32 worst \{worstC} ulp at bits \{worstCx}; \{missC} differ from cosF64 rounded",
)
