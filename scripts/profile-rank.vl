// Rank a `VL_PROFILE_GUEST` Firefox-profiler JSON by function SELF time.
//
//     VL_PROFILE_GUEST=/tmp/p.json vl build compiler/entry.vl -o /tmp/o.wasm --compiler <--names seed>
//     vl run scripts/profile-rank.vl -- /tmp/p.json [top=20] [--alloc]
//
// SELF is the samples whose leaf is the frame; INCL the samples with the frame anywhere on the
// stack, counted once per sample so recursion cannot double-count. `--alloc` sums each
// sample's weight (the bytes the resident set grew since the one before) instead of counting
// samples; read its INCL column, since a leaf is whatever ran when the epoch ticked. Without a
// `--names` seed every frame reads `wasm-function[N]`. `docs/internals/profiling-the-compiler.md`.

import { IoError, readTextFile } from "std:fs"
import { exit } from "std:process"
import { programArgs } from "std:args"
import { Utf8Error } from "std:utf8"
import { padLeft, parseI32, toFixed, toString } from "std:fmt"
import { Json, JsonError, parseJson } from "std:json"

type JsonMap = { [string]: Json }

const USAGE = "usage: vl run scripts/profile-rank.vl -- <profile.json> [top] [--alloc]"

function die(msg: string, code: i32) {
  print(msg)
  exit(code)
}

function field(m: JsonMap, key: string): Json { m[key] ?? null }

function obj(v: Json, what: string): JsonMap {
  if v is JsonMap { return v }
  die("profile-rank: \{what} is not an object", 2)
  const none: JsonMap = Map()
  none
}

function arr(v: Json, what: string): Json[] {
  if v is Json[] { return v }
  die("profile-rank: \{what} is not an array", 2)
  []
}

// An index column: each entry as an i32, -1 for a JSON null.
function ints(v: Json, what: string): i32[] {
  const out: i32[] = []
  for x in arr(v, what) {
    if x is f64 { out.push(x as! i32) } else { out.push(-1) }
  }
  out
}

function absent(v: Json): boolean {
  if v is Json[] { return v.length == 0 }
  v == null
}

// The name table: the thread's `stringArray` or `stringTable`, else the shared one; an empty
// table counts as absent.
function strings(prof: JsonMap, th: JsonMap): string[] {
  let src = field(th, "stringArray")
  if absent(src) { src = field(th, "stringTable") }
  if absent(src) {
    const shared = field(prof, "shared")
    if shared is JsonMap { src = field(shared, "stringArray") }
  }
  const out: string[] = []
  if src is Json[] {
    for s in src {
      if s is string { out.push(s) } else { out.push("") }
    }
  }
  out
}

// `xs`'s indices ordered by `key` descending; equal keys keep their order (a stable merge
// sort), which is how Python's `Counter.most_common` breaks ties.
function rankDesc(ix: i32[], key: f64[]): i32[] {
  if ix.length <= 1 { return ix }
  const mid = ix.length / 2
  const a = rankDesc(ix.slice(0, mid), key)
  const b = rankDesc(ix.slice(mid, ix.length), key)
  const out: i32[] = []
  let i = 0
  let j = 0
  while i < a.length || j < b.length {
    if j >= b.length || (i < a.length && key[a[i]] >= key[b[j]]) {
      out.push(a[i])
      i = i + 1
    } else {
      out.push(b[j])
      j = j + 1
    }
  }
  out
}

function pct(n: f64, total: f64): string {
  padLeft(toFixed(100.0 * n / total, 2), 7, " ")
}

function main(argv: string[]): i32 {
  let alloc = false
  const pos: string[] = []
  for a in argv {
    if a == "--alloc" { alloc = true } else { pos.push(a) }
  }
  if pos.length < 1 {
    print(USAGE)
    return 2
  }
  let top = 20
  if pos.length > 1 {
    const t = parseI32(pos[1])
    if t == null { die("profile-rank: top is not an integer: " + pos[1], 2) }
    top = t ?? 20
  }
  const text = readTextFile(pos[0])
  if text is IoError {
    die("profile-rank: cannot read \{pos[0]} (\{text.msg})", 2)
    return 2
  }
  const parsed = parseJson(text)
  if parsed is JsonError {
    die("profile-rank: \{pos[0]} is not JSON (\{parsed.msg})", 2)
    return 2
  }
  const prof = obj(parsed, "the profile")
  const th = obj(arr(field(prof, "threads"), "threads")[0], "threads[0]")
  const names = strings(prof, th)
  const frameFunc = ints(
    field(obj(field(th, "frameTable"), "frameTable"), "func"),
    "func",
  )
  const funcName = ints(
    field(obj(field(th, "funcTable"), "funcTable"), "name"),
    "name",
  )
  const stackTable = obj(field(th, "stackTable"), "stackTable")
  const prefix = ints(field(stackTable, "prefix"), "prefix")
  const stFrame = ints(field(stackTable, "frame"), "frame")
  const samples = obj(field(th, "samples"), "samples")
  const stacks = ints(field(samples, "stack"), "stack")
  const weightCol = field(samples, "threadCPUDelta")
  if alloc && weightCol == null {
    print("--alloc: this profile carries no per-sample weights")
    return 2
  }
  const weights: Json[] = []
  if alloc {
    for w in arr(weightCol, "threadCPUDelta") { weights.push(w) }
  }

  // Each stack node's name as an id, ids in first-seen order.
  const idOf: Map<string, i32> = Map()
  const idName: string[] = []
  const nodeId: i32[] = []
  for f in stFrame {
    const nm = names[funcName[frameFunc[f]]]
    const known = idOf[nm]
    if known != null {
      nodeId.push(known)
    } else {
      idOf[nm] = idName.length
      nodeId.push(idName.length)
      idName.push(nm)
    }
  }

  // SELF per name, the leaves in the order they were first seen, and each node's weight.
  const selfW: f64[] = []
  const firstSeen: boolean[] = []
  for _ in idName {
    selfW.push(0.0)
    firstSeen.push(false)
  }
  const nodeW: f64[] = []
  for _ in stFrame { nodeW.push(0.0) }
  const leafOrder: i32[] = []
  let total = 0.0
  let i = 0
  while i < stacks.length {
    const s = stacks[i]
    if s >= 0 {
      let w = 1.0
      if alloc {
        const x = weights[i]
        w = if x is f64 { x } else { 0.0 }
      }
      total = total + w
      const id = nodeId[s]
      selfW[id] = selfW[id] + w
      if !firstSeen[id] {
        firstSeen[id] = true
        leafOrder.push(id)
      }
      nodeW[s] = nodeW[s] + w
    }
    i = i + 1
  }

  // INCL: each weighted node's weight once to every distinct name on its chain.
  const inclW: f64[] = []
  const stamp: i32[] = []
  for _ in idName {
    inclW.push(0.0)
    stamp.push(-1)
  }
  let n = 0
  while n < nodeW.length {
    if nodeW[n] != 0.0 {
      let cur = n
      while cur >= 0 {
        const id = nodeId[cur]
        if stamp[id] != n {
          stamp[id] = n
          inclW[id] = inclW[id] + nodeW[n]
        }
        cur = prefix[cur]
      }
    }
    n = n + 1
  }

  if total == 0.0 {
    print("no samples")
    return 0
  }
  if alloc {
    print("\{toFixed(total / 1000.0, 1)} MB allocated")
  } else {
    print("\{toString(total as! i64)} samples")
  }
  print("  self%   incl%  function")
  const ranked = rankDesc(leafOrder, selfW)
  let k = 0
  while k < ranked.length && k < top {
    const id = ranked[k]
    print("\{pct(selfW[id], total)} \{pct(inclW[id], total)}  \{idName[id]}")
    k = k + 1
  }
  0
}

const argv = programArgs()
if argv is Utf8Error {
  die("profile-rank: an argument is not UTF-8: " + argv.msg, 2)
} else {
  exit(main(argv))
}
