// The Python ratchet: tracked `.py` files and their lines may only fall.
//
//     vl run scripts/py-budget.vl [--check | --write-baseline] [--baseline P]
//
// The owner's directive is zero Python in the repo; this holds the count while the
// census (docs/internals/python-removal.md) is worked down. `--check` exits 1 when
// either the file count or the line count is above the committed baseline;
// `--write-baseline` records the current pair and the HEAD commit, in the same PR as
// the deletion that earned it. Run it from the checkout root: paths are relative to
// the working directory.

import { IoError, readFile, readTextFile, writeTextFile } from "std:fs"
import { Json, JsonError, parseJson } from "std:json"
import { programArgs } from "std:args"
import { exit, runProgram } from "std:process"
import { Utf8Error, decodeUtf8 } from "std:utf8"
import { toString } from "std:fmt"
import { endsWith, split, trim } from "std:str"

type JsonMap = { [string]: Json }

const BASELINE = "scripts/py-budget-baseline.json"

type Count = { files: i64, lines: i64 }

// Stop with `code` after saying why; VL has no stderr sink, so this lands on stdout.
function die(msg: string, code: i32) {
  print(msg)
  exit(code)
}

// The tracked paths ending in `.py`, as git's index lists them. A tree that is not a
// checkout, or a git that cannot run, is a loud failure: a budget that counted zero
// there would pass for the wrong reason.
function trackedPy(): string[] {
  const r = runProgram("git", ["ls-files", "--", "*.py"])
  if r is IoError {
    die("py-budget: cannot run git (" + r.msg + ")", 1)
    return []
  }
  if r.code != 0 {
    die("py-budget: `git ls-files` exited " + toString(r.code), 1)
    return []
  }
  const t = decodeUtf8(r.stdout)
  if t is Utf8Error {
    die("py-budget: git printed a path that is not UTF-8", 1)
    return []
  }
  const out: string[] = []
  const rows = split(t, "\n")
  let i = 0
  while i < rows.length {
    if endsWith(rows[i], ".py") { out.push(rows[i]) }
    i = i + 1
  }
  out
}

// Newline bytes in `path`, the number `wc -l` prints. A listed file that is gone from
// the working tree (deleted, not yet staged) counts as absent, not as an error.
function lineCount(path: string): i64 {
  const b = readFile(path)
  if b is IoError { return -1 }
  let n: i64 = 0
  let i = 0
  while i < b.length {
    if b[i] == 10 { n = n + 1 }
    i = i + 1
  }
  n
}

function measure(): Count {
  const paths = trackedPy()
  let files: i64 = 0
  let lines: i64 = 0
  let i = 0
  while i < paths.length {
    const n = lineCount(paths[i])
    if n >= 0 {
      files = files + 1
      lines = lines + n
    }
    i = i + 1
  }
  { files: files, lines: lines }
}

function badFieldMsg(path: string, key: string): string {
  "py-budget: \{path} has no integer `\{key}` field"
}

// One whole-number member of the baseline row, loudly absent when it is not one.
function field(row: JsonMap, path: string, key: string): i64 {
  const v = row[key]
  if v is f64 {
    const n = v as? i64
    if n != null { return n }
  }
  die(badFieldMsg(path, key), 1)
  0
}

function loadBaseline(path: string): Count {
  const text = readTextFile(path)
  if text is IoError {
    die(
      "py-budget: cannot read the baseline \{path} (\{text.msg}). Write one with\n  vl run scripts/py-budget.vl --write-baseline",
      1,
    )
    return { files: 0, lines: 0 }
  }
  const row = parseJson(text)
  if row is JsonMap {
    return {
      files: field(row, path, "files"),
      lines: field(row, path, "lines"),
    }
  }
  if row is JsonError {
    die("py-budget: " + path + " is not JSON: " + row.msg, 1)
    return { files: 0, lines: 0 }
  }
  die("py-budget: " + path + " is not a JSON object", 1)
  { files: 0, lines: 0 }
}

// The short sha the baseline was written from: provenance for a reader, never an input
// to `--check`.
function headCommit(): string {
  const r = runProgram("git", ["rev-parse", "--short", "HEAD"])
  if r is IoError { return "unknown" }
  if r.code != 0 { return "unknown" }
  const t = decodeUtf8(r.stdout)
  if t is Utf8Error { return "unknown" }
  trim(t)
}

function report(now: Count, base: Count): string {
  "python files \{now.files} (baseline \{base.files}), lines \{now.lines} (baseline \{base.lines})"
}

function cmdWrite(baseline: string) {
  const now = measure()
  const commit = headCommit()
  const row = "{\"files\": \{now.files}, \"lines\": \{now.lines}, \"commit\": \"\{commit}\"}\n"
  const w = writeTextFile(baseline, row)
  if w != null {
    die("py-budget: cannot write \{baseline} (\{w.msg})", 1)
    return 0
  }
  print(
    "wrote \{baseline}: \{now.files} files, \{now.lines} lines at \{commit}",
  )
  0
}

function cmdCheck(baseline: string) {
  const base = loadBaseline(baseline)
  const now = measure()
  const line = report(now, base)
  if now.files > base.files || now.lines > base.lines {
    print("python budget EXCEEDED: \{line}")
    print(
      "Python is being removed from this repo (docs/internals/python-removal.md): write the tool in VL instead.\nIf the count fell and you only forgot the baseline, run\n  vl run scripts/py-budget.vl --write-baseline",
    )
    exit(1)
    return 0
  }
  print(line)
  0
}

function hasFlag(args: readonly string[], flag: string): boolean {
  let i = 0
  while i < args.length {
    if args[i] == flag { return true }
    i = i + 1
  }
  false
}

function flagValue(
  args: readonly string[],
  flag: string,
  fallback: string,
): string {
  let i = 0
  while i < args.length {
    if args[i] == flag {
      if i + 1 < args.length { return args[i + 1] }
      return fallback
    }
    i = i + 1
  }
  fallback
}

function main(args: readonly string[]) {
  const baseline = flagValue(args, "--baseline", BASELINE)
  if hasFlag(args, "--write-baseline") { return cmdWrite(baseline) }
  if hasFlag(args, "--check") { return cmdCheck(baseline) }
  print(report(measure(), loadBaseline(baseline)))
  0
}

const argv = programArgs()
if argv is Utf8Error {
  die("py-budget: an argument is not UTF-8: " + argv.msg, 2)
} else {
  main(argv)
}
