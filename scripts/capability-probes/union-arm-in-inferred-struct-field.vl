// A union ARM held in the field of an INFERRED holder literal. `vl check` returns 0 and the
// emitter refused with `emitProgram: object literal matches no union variant` — clause 2. An
// arm has no struct-table row, so the row a code-15 field stores through is minted on demand,
// and only a walk over declared `TypeDecl` field annotations asked for that mint; the literal
// was then refused a row and a union program boxes an unclaimed literal. `{f: 1}` is the
// control and always ran.
// Should print 1.
type UaiP = { x: i32 }
type UaiQ = { y: i32 }
type UaiU = UaiP | UaiQ
const uaiP: UaiP = { x: 1 }
const uaiHolder = { f: uaiP }
print(uaiHolder.f.x)
