// A function whose LAST statement is an `if` whose arm assigns a STRUCT module global.
// `vl check` returns 0, the module LOADS, and the call traps on `unreachable`: the tail-`if`
// was read as this function's value, the functype declares the assigned global's own ref
// result, and the body leaves nothing on the stack.
//
// THE DESTINATION KIND IS THE WHOLE INGREDIENT — an i32, string or list global in the same
// shape all run, and so does a struct LOCAL. So does the same body with a bare `return`
// appended, and so does the assignment without the enclosing `if`.
//
// It was invisible until D1115 wired the global-ASSIGNMENT recover: before that the module
// did not load, so nothing could reach the trap. Refusals come in layers. See D1220.
// Should print 7 then 7 then 7 then 7.
type C = { v: i32 }

let gi = 0
let gs = "a"
let gl: i32[] = [0]
let gc: C = { v: 1 }

function setI(y: i32) {
  if y > 0 { gi = y }
}
function setS(y: string) {
  if y != "" { gs = y }
}
function setL(y: i32[]) {
  if y.length > 0 { gl = y }
}
function setC(y: C) {
  if y.v > 0 { gc = y }
}

setI(7)
print(gi)
setS("7")
print(gs)
setL([7])
print(gl[0])
setC({ v: 7 })
print(gc.v)
