// An un-annotated function stored in two maps, one map an element of an annotated list literal of
// maps of a closed function type and the other an element of an un-annotated list literal. `vl
// check` returns 0 and emit refuses. Either list alone, or both annotated, runs. See D15756.
// Should print 1.5.
function half(a) { return a / 2.0 }
const m1 = Map()
m1.set("a", half)
const m4 = Map()
m4.set("a", half)
const ys = [m4]
const v: ({ [string]: (a: f64) => f64 })[] = [m1]
const g = v[0].get("a")
if g != null { print(g(3)) }
