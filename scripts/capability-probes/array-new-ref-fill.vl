// `__array_new__` with a REFERENCE fill value (here a string array). Compiler intrinsic
// rather than surface syntax, so it is the lowest-priority probe in this directory —
// kept because the refusal is a capability gap like any other and nothing else reaches it.
// Should print 2.
const s: string[] = ["a"]
const xs = __array_new__(2, s)
print(xs.length)
