// A list element handed on at its own record type after a second call built the list's records
// at a wider row. `vl check` refuses with `… is type-valid but not supported yet`: the element is
// stored at `J`, and `g` is not instanced at that rep. See D14532. Should print 40.
type J = { f: i32 | null }
function mk() { { f: 4 } }
function g(r: { f: i32 }) { r.f * 10 }
const wideJ: J = mk()
const xs = [mk()]
print(g(xs[0]))
print(wideJ.f ?? 0)
