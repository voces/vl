// D1563 / glean VL-029 — two nullable-struct module globals of DIFFERENT struct types, the
// first an ARM of a union a call returns. `vl check` (including `--codegen`'s own check) is
// clean and `vl build` writes a module wasmtime refuses: `type mismatch: expected (ref null
// $type), found (ref null $type)`, with both heap names elided, so the message is a
// tautology and the ABLATION is the finding.
//
// `t`'s cell is the `nulvariant` niche, so the start-fn init loop seeds `pendingVariantIdx`
// with `T`'s arm index — and never clears it. `emitNullLitNode` reads that seed BEFORE
// `pendingStructIdx` and does not consume it, so `c`'s own `= null` lowered as
// `ref.null $T` into `c`'s `(ref null $C)` cell. Two globals of the SAME arm type run (the
// seed and the cell agree); swapping the declaration order runs; making `T` a plain struct
// (`mk(): T | null`) runs — the union ARM is the ingredient.
// Should print 7 then 0.
type E = { msg: string }
type T = { n: i32, m: i32 }
type C = { a: i32, b: i32 }

function mk(x: i32): T | E {
  if x < 0 { return { msg: "no" } }
  return { n: x, m: x }
}

let t: T | null = null
let c: C | null = null

export function go(x: i32): i32 {
  const r = mk(x)
  if r is E { return 0 }
  t = r
  r.n
}
export function getC(): i32 {
  if c != null { c.a } else { 0 }
}

print(go(7))
print(getC())
