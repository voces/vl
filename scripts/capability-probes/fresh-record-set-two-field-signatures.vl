// D17786 — a fresh record's two fields hold one tagged set at two closed signatures, so no value
// arm pins its member at either and the conversion is refused: `emitProgram: a set's function
// converted to a closure needs the member's instance`. Should print 8.5.
function id(a) { return a }
function two() { return { f: id, g: id, n: 3 } }
const w: { f: (a: f64) => f64, g: (a: i32) => i32, n: i32 } = two()
const x = two()
print(w.f(2.5) + w.g(1) + x.f(2) + w.n)
