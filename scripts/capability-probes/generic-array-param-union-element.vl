// A generic `T[]` parameter applied at a UNION element list. `vl check` returns 0 and the
// monomorphizer refuses with
// ``emitProgram: monomorphize: expected an array argument for `xs` in a call to `first` ``
// (`compiler/emit_mono.vl:4813`). Should print 5.
//
// THE UNION ELEMENT IS THE INGREDIENT. The identical program at `const xs: Circle[]` compiles
// and runs; only the union-element spelling refuses. `monoArgPinName` hands back a name that
// `nameIsArray` does not recognise as an array, so the `T[]` binding rung declines an argument
// the CHECKER already proved is an array of the right element.
//
// The message says "expected an array argument" about an argument that is, verbatim, an array.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function first<T>(xs: T[]): T { return xs[0] }
function go(): i32 {
  const xs: Shape[] = [{ r: 5 }]
  const f = first(xs)
  if f is Circle { return f.r }
  return 0
}
print(go())
