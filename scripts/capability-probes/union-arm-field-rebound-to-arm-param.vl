// A field read of a union ARM, rebound through an annotated binding and delivered where the
// non-null arm is demanded. `vl check` returned 0 and the module did not validate — clause 1,
// `expected (ref $type), found (ref null $type)`. A code-15 field read is nullable-classified
// by design, so the cell takes the `nulvariant` niche from its initializer, while the two
// readers re-derived the answer from the annotation, which names the non-null arm.
// Should print 1.
type UafP = { x: i32 }
type UafQ = { y: i32 }
type UafU = UafP | UafQ
type UafW = { f: UafP }
const uafP: UafP = { x: 1 }
const uafW: UafW = { f: uafP }
const uafRebound: UafP = uafW.f
function uafTake(a: UafP): i32 { a.x }
print(uafTake(uafRebound))
