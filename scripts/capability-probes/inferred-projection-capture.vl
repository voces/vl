// An INFERRED binding whose initialiser is a PROJECTION of a struct — `xs[0]` here, `box.it`
// equally — captured by a lambda. `vl check` returns 0 and the module does not validate
// (`type mismatch: expected i32, found (ref $type)` in `go`): a clause-1 row.
//
// Four ingredients: the projection (a CALL initialiser runs), the struct (an `i32[]` or
// `string[]` element runs), the capture hop (`print(held.n)` runs), and the binding being
// UN-ANNOTATED — annotating `held` is the whole fix, which is why a fixture that annotates
// its captures cannot see this. Plain module scope also runs; the function body does not.
// See D1476.
// Should print 3.
function go() {
  const srcArr = [{ name: "ada", n: 3 }]
  const held = srcArr[0]
  const get = () => held
  const v = get()
  print(v.n)
}

go()
