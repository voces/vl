// A GENERIC whose RETURN TYPE is a union minted by SUBSTITUTION at the pin — `orE<T>(): T | E`
// at `T = Circle`, the generic `Result` shape every fallible helper wants. `collectU` is the
// only pass that mints a union row and the pass table orders it BEFORE `monomorphize`, so a
// union that exists only because a generic was pinned had no row under ANY spelling: `vl check`
// rc 0, then `emitProgram: union box atom test on a union with no recorded members: Circle|E`.
// The DIRECT spelling `function orE(x: Circle, bad: boolean): Circle | E` ran beside it.
//
// AND THE TWO PRODUCERS SPELT ONE UNION TWO WAYS, which is why a registry retry at the lookup
// was not the fix: canon SOFTENS a literal member at `RC_ROOT`, so the direct spelling of the
// literal-armed twin registers `i32|string` while the clone asks for `i32|"err"`. The pin
// registers THROUGH canon now, which is what makes the two spellings meet on ONE row — a
// union's box tags are positional over its member set, so a second row for one type is a value
// boxed under one tag slice and read under the other.
//
// FOUND 2026-09-02 (D1042). No corpus cell reaches it: the census axes carry no generic whose
// return type is a union over its own type parameter.
// Should print 1.5 then bad.
type E = { msg: string }
type Circle = { r: f64 }

function orE<T>(x: T, bad: boolean): T | E {
  if bad { return { msg: "bad" } }
  return x
}

const c: Circle = { r: 1.5 }
const ok = orE(c, false)
if ok is E { print(ok.msg) } else { print(ok.r) }
const err = orE(c, true)
if err is E { print(err.msg) } else { print(err.r) }
