// `==` over a struct, a record with a nullable field against its non-null twin, a nullable list
// against a list, and lists of two numeric elements. The refusals "` over this operand rep has
// no lowering", "has no lowering" and "has no lowering: the two are mutually assignable but
// store their elements differently" name these shapes; the plainest programs they forbid run.
// Should print true then true then true then true.
type P = {a: i32, b: string}
const x: P = { a: 1, b: "s" }
const y: P = { a: 1, b: "s" }
print(x == y)
const nr: {a: i32 | null} = { a: 1 }
const pr: {a: i32} = { a: 1 }
print(nr == pr)
const nl: i32[] | null = [1]
const pl = [1]
print(nl == pl)
const fl = [1.0]
const il = [1]
print(fl == il)
