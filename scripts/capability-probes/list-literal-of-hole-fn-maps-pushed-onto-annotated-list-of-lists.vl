// A list literal of maps of un-annotated functions pushed onto an annotated list of lists of maps
// of `(a: f64) => f64`. `vl check` returns 0 and emit refuses:
// `emitProgram: a list literal of maps whose value type is still open names no list row`.
// The same list as the outer list's literal, or the parameter annotated, runs. See D15943.
// Should print 10.
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const fnMap = Map()
fnMap.set("a", inc0)
fnMap.set("b", half)
const m2 = Map()
m2.set("a", half)
const xs: (({ [string]: (a: f64) => f64 })[])[] = []
xs.push([m2, fnMap])
const v = xs[0]
const g = v[1].get("a")
const h = v[0].get("a")
if g != null && h != null { print(g(6) + h(6)) }
