// The SILENT member of the same family, and the one that ships: `is` against a PLAIN arm of a
// union that merely CONTAINS a self-referential container arm. `vl check` returns 0 and the
// module does not load. Both container kinds do it. Grade a fix on this probe, not only on
// the loud one — the loud arm draws attention and this is the arm that reaches a user.
// See D985.
// Should print hi.
type J = null | string | J[]

function f(j: J) {
  if j is string { print(j) } else { print(0) }
}

f("hi")
