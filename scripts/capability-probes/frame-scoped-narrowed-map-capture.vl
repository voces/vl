// The same program as `annotated-rebind-narrowed-map-read.vl`, inside a FUNCTION. `vl check`
// returned 0 and the module did not validate: `type mismatch: expected (ref $type), found
// (ref null $type)`.
//
// The capture classifiers reach a name through the emit-time declared-locals table, the
// param arena, the capture set and the globals registry. A frame's own `let` is in none of
// them, and the env struct is typed in the type section, before any frame declares locals.
//
// The module-scope twin has run since D1632, which is what makes the scope the axis. The
// un-annotated rebind and the no-rebind spelling failed here too, so both faces are the
// gap rather than the annotation. See D1633. Should print 3.
function go() {
  const m: { [string]: { name: string, n: i32 } } = Map()
  m["k"] = { name: "ada", n: 3 }
  const mv = m["k"]
  if mv != null {
    const v: { name: string, n: i32 } = mv
    const g = () => v
    print(g().n)
  }
}
go()
