// A generic record instance whose field is a union ARM. It refused at emit with
// `emitProgram: nested-struct field element type is not interned`, because the instance's
// field recorded the arm's own name, which keys no row; it now records the arm's twin row,
// as a plain record's field does (D15096). Should print 4.
type O = { n: i32, k: i32 }
type P = { m: i32 }
type U = O | P
type W<T> = { o: O | null, v: T }
const w: W<i32> = { o: { n: 4, k: 0 }, v: 1 }
print(w.o?.n ?? 0)
