// A generic record instance whose field is a union ARM. `vl check` returns 0 and the emitter
// refuses with `emitProgram: nested-struct field element type is not interned`: the same
// field on a plain record runs, as does the instance over a record that is not an arm (D15096).
// Should print 4.
type O = { n: i32, k: i32 }
type P = { m: i32 }
type U = O | P
type W<T> = { o: O | null, v: T }
const w: W<i32> = { o: { n: 4, k: 0 }, v: 1 }
print(w.o?.n ?? 0)
