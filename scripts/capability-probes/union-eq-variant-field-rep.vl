// `==` over a union whose STRUCT arm carries a field that is not i32, boolean or string.
//
//   emitProgram: `==` over a struct union is not supported yet
//
// `vl check` returns 0, so this is a clause-2 violation by construction. silent-class
// inventory D1096.
//
// THE INGREDIENT IS THE FIELD'S REP, NOT THE ARM SET. The identical union with an `x: i32`
// field compares and runs at both spellings; swapping that one field for `f64`, `i64`,
// `f32` or a LIST makes `variantFieldsComparable` decline the arm, and one unservable arm
// declines the whole lowering. The gate accepts variant field codes 0 (i32 / boolean),
// 3 (string) and 15 (a nested shape) and nothing else, while the same field types compare
// fine as plain STRUCT fields — the cores exist, the variant-table ladder does not route
// to them.
//
// Both the union-vs-CONCRETE and the union-vs-union spelling take the same refusal from
// the same gate, so one witness grades both.
//
// Should print true then false.
type A = { d: f64 }

function mk(n: i32): A | i32 {
  if n == 0 { return 5 }
  { d: 1.5 }
}

const p = mk(1)
const same: A = { d: 1.5 }
const diff: A = { d: 2.5 }
print(p == same)
print(p == diff)
