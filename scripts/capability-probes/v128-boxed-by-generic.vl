// A generic's `T | null` and `T | i32` result bound to a 128-bit vector. The refusal "bound to a
// 128-bit vector, which a generic body has no lowering for yet" names this shape; the plainest
// programs it forbids run.
// Should print 1.5 then 3.
function opt<T>(x: T, c: boolean): T | null {
  if c { return x }
  return null
}
const r = opt(__splat_f32x4__(1.5), true)
if r != null { print(__extract_lane_f32x4__(r, 0)) }
function u<T>(x: T, c: boolean): T | i32 {
  if c { return x }
  return 3
}
const s = u(__splat_f32x4__(6.5), false)
if s is i32 { print(s) }
