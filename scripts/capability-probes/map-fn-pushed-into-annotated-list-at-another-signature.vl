// An un-annotated function stored in two maps, one map in an annotated list literal of maps of
// `(a: f64) => f64` and the other pushed onto an annotated list of maps of `(a: i32) => f64`.
// `vl check` returns 0 and emit refuses. The second map in its list's literal, or the function at
// one signature, runs. See D15940.
// Should print 3.
function half(a) { return a / 2.0 }
const m1 = Map()
m1.set("a", half)
const m4 = Map()
m4.set("a", half)
const ws: ({ [string]: (a: f64) => f64 })[] = [m1]
const g = ws[0].get("a")
const xs: ({ [string]: (a: i32) => f64 })[] = []
xs.push(m4)
if g != null { print(g(3) + 1.5) }
