// NARROWING A REF-ARRAY-VALUED MAP READ — silent-class-inventory D1040, the remainder of
// D1038:
//
//   emitProgram: `is` test but no union type declared
//
// `vl check` returns 0. D1038 closed this rung for scalar-list and nested-map values by
// giving the map read an arm in the rep classifiers; a REF-ARRAY value still refuses, and
// its arm is never reached — `declaredKind` for the binding is null, so the let-slot ladder
// assigns no kind and nothing asks the predicate. The hole is in the ladder, not the
// classifier. The ANNOTATED spelling works.
//
// Should print 7.
type P = { x: i32 }

const m: { [string]: P[] } = Map()
m["a"] = [{ x: 7 }]

const g = m["a"]
if g is P[] { print(g[0].x) }
