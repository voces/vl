// A map arm of a union spelled inside a function type, beside an alias of two records. Under
// the function type the union keys with its alias flattened, as at the top level, so the box
// holds the map arm. Should print 1.
type Circle = { r: i32 }
type Sq = { s: i32 }
type K = Circle | Sq
function f(h: () => ({[string]: i32} | K)): i32 { 1 }
print(f(() => Map()))
