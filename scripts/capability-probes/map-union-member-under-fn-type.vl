// A MAP arm of a union spelled inside a FUNCTION TYPE. `vl check` returns 0 and the emitter
// refuses with `emitProgram: a map union member is not supported — use a struct member
// instead` — clause 2. Under a function type `reachRegisterName` resolves through
// `tyToNominalName`, which keeps the alias `K` as an atom, so `isVariantBoxUnionAtoms`
// declines; spelled at the top level the same union flattens through canon and compiles.
// Should print 1.
type Circle = { r: i32 }
type Sq = { s: i32 }
type K = Circle | Sq
function f(h: () => ({[string]: i32} | K)): i32 { 1 }
print(f(() => Map()))
