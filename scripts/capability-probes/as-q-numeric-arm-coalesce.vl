// `u as? i32 ?? d` over a value union. The cast's result is `i32 | null`, a value-union BOX
// (a scalar has no spare null niche), and no annotation, `type` declaration or inferred
// binding in the program spells it — so nothing minted the row and `unionHasAtomTy` refused
// `emitProgram: union box atom test on a union with no recorded members: i32|null` after
// `vl check` returned 0. A clause-2 violation by construction.
// Found 2026-09-03 by the day-one sampler (#2478), `--seed 1 --count 400`. Closed by D1517.
// This file must NOT spell `i32 | null`: any use of that annotation registers the row and is
// the rescue the row records. Splitting the `??` off (`const r = u as? i32` then `!= null`)
// ran before the fix and must keep running.
// Should print 3.
type Val = i32 | string

function mkval(): Val { return 3 }

function go() {
  const v = mkval()
  print(v as? i32 ?? -1)
}

go()
