// D1561 — a `??` over a nullable DECLARED struct union delivered into an INFERRED binding,
// read at the shared discriminant. `vl check` rc 0, then
// `emitProgram: field access but no struct type declared` — a clause-2 violation by
// construction. Annotating the binding, or spelling the union's arms INLINE, each ran; only
// the named-arm, un-annotated spelling refused, which is the reverse direction of D1473.
// Found by the day-one sampler (#2478) as residue of D1473's close.
// Should print rect.
type Circle = { kind: "circle", r: f64 }
type Rect = { kind: "rect", w: f64, h: f64 }
type Shape = Circle | Rect
function mkval(): Shape { return { kind: "rect", w: 2.0, h: 3.0 } }
function passh(x) { return x }
function go() {
  const srcOpt: Shape | null = passh(mkval())
  let v = (srcOpt ?? { kind: "circle", r: 1.0 })
  v = (srcOpt ?? { kind: "circle", r: 1.0 })
  print(v.kind)
}
go()
