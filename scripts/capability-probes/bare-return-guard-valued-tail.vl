// A guard `return` in a function whose tail is a value-yielding member call. `vl check` is rc
// 0 at both seeds; the emitter refused the bare `return` at the function name, because the
// inferred result type is not void — `.push` is typed `i32` (D1592), so the tail made it `i32`
// and nothing in the source said so.
//
// The rule the close applies: a bare `return` anywhere in a body pins the return type to void
// and the tail is lowered in statement position, with the checker owning the verdict. D1600,
// reported by the `glean` consumer as VL-046.
// Should print 2.
const seen = []
const count: i32[] = []
function note(name: i32) {
  for i in 0 to seen.length - 1 {
    if seen[i] == name {
      count[i] += 1
      return
    }
  }
  seen.push(name)
  count.push(1)
}
note(7)
note(7)
print(count[0])
