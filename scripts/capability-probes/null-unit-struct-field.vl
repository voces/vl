// A struct field typed by the `null` unit type. `vl check` accepts it (rc 0); emit refuses with
// `emitProgram: struct field type `null` has no struct-field rep`, since no heap slot has a
// `nulnone` storage row (D4671). A list element and a map value of type `null` refuse the same
// way. Should print true.
type Box = { a: null }
const b: Box = { a: null }
print(b.a == null)
