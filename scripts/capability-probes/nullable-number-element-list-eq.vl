// `==` over two lists whose element is `i32 | null`, a union box in a list: pair by pair, tag
// first and then the value. The checker refused it as having no lowering while `i32[]` compared.
// Should print: true false
const a: (i32 | null)[] = [1, null]
const b: (i32 | null)[] = [1, null]
const c: (i32 | null)[] = [1, 2]
print(a == b)
print(a == c)
