// An if-EXPRESSION whose two ARMS are struct-typed FIELD READS. `vl check` returned 0 and the
// engine refused the emitted module — `type mismatch: expected (ref $type), found (ref null
// $type)` inside `pick` (D1577; reported by the glean session as VL-035). Should print 7.
//
// A NESTED-STRUCT FIELD IS STORED NULLABLE THOUGH ITS TYPE IS NOT. `ret: V` interns as
// `(field (mut (ref null $V)))`, so `struct.get` yields the niche and every DELIVERY into a
// `(ref $V)` destination owes `ref.as_non_null` (`nulNicheRecoverOwed`, D1115). The return,
// argument and binding boundaries made that recover; the if-expression ARM never did, so both
// arms pushed `(ref null $V)` under the `(if (result (ref $V)))` blocktype the non-null join
// asks for.
//
// BOTH FACES ARE THE SAME CELL: annotating the binding `: V` draws `@hint redundant type
// annotation` and emits the identical bytes, because the annotation agrees about the TYPE and
// the disagreement is about the REP.
type V = { i: i32 }
type S = { ret: V, flag: boolean }
function pick(s: S) {
  const out = if s.flag { s.ret } else { s.ret }
  out.i
}
print(pick({ ret: { i: 7 }, flag: true }))
