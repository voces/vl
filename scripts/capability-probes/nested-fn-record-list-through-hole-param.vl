// A list of records whose nested record holds un-annotated functions of different result types,
// handed to an un-annotated parameter and called through the nested field: the instance must read
// the field at the joined set. Refused at check until it does. See D16860.
// Should print 1.5.
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const rows = [{ a: { f: inc0 } }, { a: { f: half } }]
function take(p) { print(p[1].a.f(3)) }
take(rows)
