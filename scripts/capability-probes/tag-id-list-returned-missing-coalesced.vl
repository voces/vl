// A returned list's only tagged id read back through `??`: a missing key takes the default.
// Should print 8.
function inc(a) { return a + 1 }
function dbl(a) { return a * 2 }
const m = Map()
m["k"] = inc
m["d"] = dbl
function missing() { return [m["zz"]] }
const hs = missing()
const h = hs[0] ?? dbl
print(h(4))
