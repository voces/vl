// An if-expression arm that declares a local, delivered as a call ARGUMENT and at module scope:
// the arm's locals are allocated by node wherever the collect pass finds the expression (D2785).
// Should print 8.
function id(n: i32): i32 { n }
function f(c: boolean, x: i32): i32 {
  id(if c { const q = 3; q + x } else { const r = 5; r - x })
}
const c = f(false, 1) > 0
print(if c { const w = f(true, 1); w * 2 } else { 0 })
