// An UN-ANNOTATED array literal whose ELEMENT is a nullable CONTAINER. `vl check` returns 0
// and the engine refuses the module: the literal has no element type to build from, so it
// builds the default i32 list into a cell typed from the same missing answer
// (`expected i32, found (ref null $type)`).
//
// The annotation is the whole ingredient — `const xs: (i32[] | null)[] = [f(0)]` runs at
// every rep and at both scopes. The niche must be a CONTAINER: a `string | null` element
// at the identical spelling runs, because `nulstr` has a name the inference resolves.
//
// A LOUD FACE OF THE SAME CELL: add `const r = xs[0]` and `if r != null` and it becomes
// `emitProgram: bare null needs a struct-typed context`. The silent one is the worse cell
// and the one this probe holds. See D1270.
// Should print 1 then 1.
function f(n: i32): i32[] | null {
  if n == 0 { return [5] }
  return null
}
type P = { a: i32 }
function g(n: i32): P[] | null {
  if n == 0 { return [{ a: 5 }] }
  return null
}

const xs = [f(0)]
print(xs.length)
const ys = [g(0)]
print(ys.length)
