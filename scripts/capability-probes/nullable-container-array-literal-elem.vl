// D1270 — an UN-ANNOTATED array literal whose ELEMENT is a nullable CONTAINER. `vl check`
// returned 0 and the engine refused the module: `nodeArrayElemName` renders a nullable
// element only when its inner is a CLOSURE, so the literal had no element name and built the
// default i32 list with a `(ref null $wrapper)` stored into it (`expected i32, found (ref
// null $type)`). Adding `const r = xs[0]` and `if r != null` turned the same cell into the
// loud `emitProgram: bare null needs a struct-typed context`; both faces are closed.
//
// Closed 2026-09-03 by `arrLitNulRefElemName`, the sixth rung of `arrLitIsRef`'s
// recorded-element ladder. A nullable STRUCT element is the one rep the rung declines, and
// is filed as D1340.
// Should print 1 then 1.
function f(n: i32): i32[] | null {
  if n == 0 { return [5] }
  return null
}
type P = { a: i32 }
function g(n: i32): P[] | null {
  if n == 0 { return [{ a: 5 }] }
  return null
}

const xs = [f(0)]
print(xs.length)
const ys = [g(0)]
print(ys.length)
