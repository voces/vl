// A returned list of one tagged id read by a constant index, narrowed and called. Should print
// 4.
function inc(a) { return a + 1 }
function dbl(a) { return a * 2 }
const m = Map()
m["k"] = inc
m["d"] = dbl
function ret() { return [m["k"]] }
const fs = ret()
const f = fs[0]
if f != null { print(f(3)) }
