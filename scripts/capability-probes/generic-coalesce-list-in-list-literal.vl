// A list literal around generic calls whose result is a `??` over the parameter's list, with
// an empty and a parameter default. The refusal "another element at this type argument has no
// lowering yet" names a default of another element, which `vl check` refuses as a join (D2816);
// the default at the operand's own element runs.
// Should print 1.5 then 2.5.
function h<T>(xs: T[] | null): T[] { return xs ?? [] }
const q = [h<f64>(null), h<f64>([1.5])]
print(q[1][0])
function k<T>(xs: T[] | null, d: T[]): T[] { return xs ?? d }
const r = [k<f64>(null, [2.5])]
print(r[0][0])
