// Telling an EMPTY `u8[].pop()` from a stored `0`.
//
// silent-class inventory D1211. `u8` is a STORAGE type — its element VALUE is an i32 — so a
// `u8[]` pop denotes `i32 | null`, which is exactly the rep D1174 built for the other numeric
// backings. The checker records it as `u8 | null` instead (`mkNullableTy(rt.aElem)` over the
// storage element), so the box lowering declines and the two spellings that must distinguish
// absence refuse: `if v != null` is `emitProgram: bare null needs a struct-typed context` and
// `xs.pop() ?? d` is `` `??` over this nullable value is not supported ``. The spellings that
// do NOT need to tell them apart run — `print(xs.pop())` prints the raw widened byte.
//
// The annotated destination `const v: u8 | null = …` is a CHECK reject BY DESIGN and must stay
// one; the fix is for `.pop()` over a `u8[]` to be typed `i32 | null` in the checker.
//
// Should print 5 then -1

const xs: u8[] = [1, 5]
const a = xs.pop()
if a != null { print(a) }
xs.pop()
const b = xs.pop()
if b == null { print(0 - 1) }
