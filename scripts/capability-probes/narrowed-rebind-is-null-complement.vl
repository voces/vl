// D1252 — a REBIND of an already-narrowed nullable, re-discriminated with `is null`.
// `vl check` returned 0 and the module was INVALID (`type mismatch: expected (ref null
// $type), found i32`): the rebind's slot held the NARROWED scalar while the complement arm's
// READ lowered as a union-box unbox on it. The four numeric value-niche reps only —
// i32/i64/f32/f64 failed, string/struct/list/boolean ran beside them.
//
// `letIsUnion` decides the CELL from `exprUnion`, which declines a narrowed ident; the READ
// went through `unionNameOfExpr`, whose `Ident` arm had no such decline while its `Index` and
// `Member` siblings did. Closed 2026-09-03 by giving that arm the decline the two must answer
// together with.
// Should print 5.
const u: i32 | null = 5

if u != null {
  const v = u
  if v is null { print(0) } else { print(v) }
}
