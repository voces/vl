// A REBIND of an already-narrowed nullable, re-discriminated with `is null`. `vl check`
// returns 0 and the module is INVALID: `type mismatch: expected (ref null $type), found i32`.
// The rebind's slot holds the NARROWED scalar — the checker knows it, and refuses `v != null`
// at the same place with `cannot compare i32 with null` — but `v is null` is still admitted,
// and the complement arm's READ of `v` lowers as a union-box unbox on that scalar slot.
// The annotated rebind `const v: i32 | null = u` prints 5, so the program is type-valid.
// The four numeric value-niche reps only: i32/i64/f32/f64 fail, string/struct/list/boolean run.
// Found 2026-09-02 by the position-matrix harness at `map_value`; the map is not an ingredient.
// See D1252.
// Should print 5.
const u: i32 | null = 5

if u != null {
  const v = u
  if v is null { print(0) } else { print(v) }
}
