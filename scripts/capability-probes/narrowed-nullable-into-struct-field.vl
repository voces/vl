// A NARROWED nullable list delivered into a struct FIELD whose valtype is a non-null ref.
// `vl check` returns 0 and the engine refuses the module — the value is still the raw
// `(ref null $wrapper)` a kind-15 read leaves, and the field is `(ref $wrapper)`.
//
// D1115 wired the RETURN, BINDING, local-ASSIGNMENT and global-ASSIGNMENT boundaries off one
// question (`nulNicheRecoverOwed`, keyed by the destination's rep KIND). A struct field names
// its destination by field CODE instead, so this position and the field STORE (`b.f = y`) are
// the two the fix does not reach. The VARIANT rep already runs at both, which is what says the
// recover is reachable from here and only the list / map / ref-list niches were never hooked.
// See D1222.
// Should print 7 then 7.
type Box = { f: i32[] }

function viaField(y: i32[] | null, d: i32[]): Box {
  if y != null { return { f: y } }
  { f: d }
}

function viaStore(y: i32[] | null, d: i32[]): Box {
  const b: Box = { f: d }
  if y != null { b.f = y }
  b
}

print(viaField([7], [0]).f[0])
print(viaStore([7], [0]).f[0])
