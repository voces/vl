// CLAUSE 1: an if-expression as an ARRAY-LITERAL element, in a module that also declares a
// union, is check-clean INVALID WASM — `type mismatch: expected i32, found (ref $type)`,
// exit 70. Deleting the union declaration makes the same literal compile and run. None of
// `arrLitIsRef`'s rungs claims an if-expression element so the literal falls to the i32
// backing, and `emitArr`'s own loud floor misses it for the same reason — `exprStruct` is
// false for an if-expression too, so the struct ref is stored into an i32 array.
// Should print 1.
type P = { x: i32 }
type Q = { y: i32 }
type UU = P | Q
const p: P = { x: 1 }
const xs = [if true { p } else { p }]
print(xs.length)
