// D705 — a module-scope `const sh: string` shadowed by a function-local `const sh = 7`. The
// checker resolves the reference to the local; every emit-side classifier resolved it through
// the module NAME table instead (`globalIsStringSid` and twenty siblings), so `print` chose the
// STRING arm over an i32 and the module was check-clean INVALID WASM. A clause-1 violation:
// `vl check` returned 0 and the engine refused the module.
// Closed 2026-09-03 by `globalLetOfSidIn`, which asks the frame before the module table.
// Should print 7.
const sh: string = "hi"

function shadowLen(): i32 { sh.length }

function leg() {
  const sh = 7
  print(sh)
}

leg()
