// An UN-ANNOTATED binding of a `?.` whose leaf is a REF list. `vl check` returns 0 and the
// emitter refuses with `emitProgram: ref valtype with no interned shape` — clause 2, since
// the ANNOTATED spelling (`const v: S[] | null = b?.y`) runs and the checker calls that
// annotation redundant. The two spellings agree about the TYPE and disagree about the REP:
// the binding's cell resolves the initialiser through a resolver that takes no ref-list row,
// so the local is declared at a valtype the module never interned (D1681).
// Should print 4.
type S = { w: i32 }
type B = { y: S[] }
function mk(): B | null { { y: [{ w: 4 }] } }
const b = mk()
const v = b?.y
if v != null { print(v[0].w) } else { print(0) }
