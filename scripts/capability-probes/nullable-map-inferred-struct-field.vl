// A nullable MAP value in an INFERRED struct field — D1627's family at the one rep its close
// does not reach. `vl check` returns 0 and the emitter refuses with `emitProgram: ref valtype
// with no interned shape`, because the niche rung that codes a nullable field reads a
// `TyNullable` and a nullable map is not recorded as one, so no field code is minted.
//
// The annotated spelling through a declared `type W = { f: {[string]: i32} | null }` runs, a
// non-nullable map field runs, and every other nullable REF rep — closure, string, struct,
// scalar list, ref list — runs since D1627. See D1665.
// Should print 55.
function mk(): { [string]: i32 } | null {
  const m: { [string]: i32 } = Map()
  m["k"] = 55
  return m
}
const w = { f: mk() }
const v = w.f
if v != null { print(v["k"]) }
