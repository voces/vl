// A struct pinned into a GENERIC's array literal. `vl check` returns 0 and the emitter
// refuses with `emitProgram: struct array elements are not supported` — clause 2. Every
// direct spelling runs: `[p]`, `[mk()]`, `[ps[0]]`, `[m["k"]]`, `[np ?? p]`, `[[p]]`. Only
// the pin escapes `arrLitNominalElemName`, which reads the literal's own element spelling
// and finds a type variable.
// Should print 2.
type P = { x: i32 }
const zz: i32[] = [1]
function g<T>(v: T): i32 {
  const xs = [v]
  return xs.length
}
const p: P = { x: 1 }
print(g(p) + zz.length)
