// D1500 — a bare INDEX read assigned into a function-local `let`. `vl check` returned 0 and
// then the COMPILER trapped: `exprEmittedRefListSlot`'s `Index` arm consumed
// `refListSlotOfExpr`, whose miss CLAMPS to row 0, and a module that interns no ref list
// has an empty `rlElemName` — so slot 0 was an out-of-bounds read inside the seed. The
// probe stays because the ingredient (a scalar array with no ref-list row in the module)
// is what makes the clamp visible, and no corpus cell has it.
// Should print 5.
function f(xs: i32[]) {
  let len = 0
  len = xs[0]
  len
}
print(f([5]))
