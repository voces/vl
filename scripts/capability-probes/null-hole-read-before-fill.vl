// An A-infer-null hole READ BEFORE the assignment that fills it. `vl check` returns 0 at both
// seeds; the emitted module did not validate.
//
// THE READ WAS TYPED AGAINST AN OPEN HOLE. `let x = null` binds `mkNullableTy(-1)` and the
// first non-null assignment fills `nInner` IN PLACE, so a read earlier in program order asked
// `nonNullTy` of a `-1` inner — which hands the NULLABLE back. The bank therefore ALIASED the
// arena node the fill mutates: after `x = 5` the `??` node reads `i32 | null` while
// `emitCoalesce` lowers it unboxed, and `print` built a box temp for a raw i32.
//
// D1589, named as residue (c) on D1576.
// Should print 0 then 5.
function go(c: boolean) {
  let x = null
  print(x ?? 0)
  if c { x = 5 }
  print(x ?? 9)
}
go(true)
