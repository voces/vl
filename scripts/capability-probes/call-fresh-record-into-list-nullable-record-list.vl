// As call-fresh-record-into-list-nullable-fn-field.vl, with a field holding a list of nullable
// records: the copy of the call's fresh record has no arm for a record boxed into its nullable
// inside a list (D16392). Should print 2.
type J = { f: ({ g: i32 } | null)[] }
function mk() { return { f: [{ g: 4 }] } }
const wideJ: J = mk()
const xs = [mk()]
function os0() { return { f: [{ g: 1 }] } }
const ws = [xs[0], os0()]
print(ws.length)
