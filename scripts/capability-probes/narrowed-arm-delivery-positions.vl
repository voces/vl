// A NARROWED STRUCT ARM DELIVERED TO A DESTINATION TYPED AT THE ARM, at the ten positions
// that lost it. An `is`-narrowed struct arm is still the `{tag, payload}` box at the wasm
// level — the one narrowed rep whose READ does not unbox (`emitIdent` carries an unbox arm
// for the value-atom, ref-array and map arms and none for the struct one) — so every
// destination typed at the ARM has to recover the payload itself. Two positions did (a bare
// variant PARAM and a bare variant RETURN); ten did not, and every one of them was
// check-clean invalid wasm.
//
// EVERY LINE PRINTS A FIELD READ THROUGH THE DESTINATION, never the delivery alone: a cell
// that lands the BOX instead cannot pass by printing something. See D1031.
// Should print 7 then 7 then 7 then 7 then 7 then 7 then 7 then 7 then 7 then 7 then 7 then 7 then 7.
type Circle = { r: i32 }
type Other = { o: string }
type Shape = Circle | Other
type GW = { g: Circle }
type NW = { g: Circle | null }

function mk(): Shape { { r: 7 } }
function takeArm(c: Circle) { print(c.r) }
function takeNul(c: Circle | null) {
  if c == null { print(0) } else { print(c.r) }
}
function retArm(s: Shape): Circle {
  if s is Circle { return s }
  { r: 0 }
}
function retNul(s: Shape): Circle | null {
  if s is Circle { return s }
  null
}
function nulPrint(c: Circle | null) {
  if c == null { print(0) } else { print(c.r) }
}

let gv: Circle = { r: 0 }

const s = mk()
if s is Circle {
  const bound: Circle = s // BINDING at the arm
  print(bound.r)
  takeArm(s) // ARGUMENT, bare arm
  takeNul(s) // ARGUMENT, nullable arm
  const w: GW = { g: s } // STRUCT FIELD, construct
  print(w.g.r)
  const n: NW = { g: s } // STRUCT FIELD, construct, nullable
  nulPrint(n.g)
  const p: GW = { g: { r: 0 } }
  p.g = s // STRUCT FIELD, assign
  print(p.g.r)
  const q: NW = { g: null }
  q.g = s // STRUCT FIELD, assign, nullable
  nulPrint(q.g)
  const xs: Circle[] = [s] // REF-LIST ELEMENT, literal
  print(xs[0].r)
  const ys: Circle[] = []
  ys.push(s) // REF-LIST ELEMENT, push
  print(ys[0].r)
  gv = s // GLOBAL ASSIGNMENT
  print(gv.r)
  const mp: { [string]: Circle } = Map()
  mp["k"] = s // MAP VALUE
  const mv = mp["k"]
  if mv == null { print(0) } else { print(mv.r) }
}
print(retArm(mk()).r) // RETURN, bare arm
nulPrint(retNul(mk())) // RETURN, nullable arm
