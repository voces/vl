// A PROPAGATING `x as T` over a niche-repped `string | null`. `vl check` returns 0 and the
// emitter refuses: `emitProgram: `as string` over a `string | null` propagates the null to
// the caller`, and only the trapping and coalescing forms are lowered for that operand —
// clause 2. The sad path returns the enclosing function's own null, which needs the operand
// staged at its heap type; `as!` needs no stage (`ref.as_non_null`) and `as?` is the
// identity, so both run at every delivery position while this one refuses.
// Should print ok.
function name(): string | null { return "ok" }
function head(): string | null {
  const s = name() as string
  return s
}
print(head() ?? "none")
