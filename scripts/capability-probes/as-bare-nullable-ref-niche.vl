// The propagating `x as string` over a niche-repped `string | null` inside a function returning
// one: a present value is the string, and a null returns the function's own null (D1812).
// Should print ok.
function name(): string | null { return "ok" }
function head(): string | null {
  const s = name() as string
  return s
}
print(head() ?? "none")
