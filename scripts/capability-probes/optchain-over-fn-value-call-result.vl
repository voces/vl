// CLAUSE 1: `?.` whose receiver is a call through a function VALUE is check-clean INVALID
// WASM — `unknown local 0: local index out of bounds`, exit 70. The direct call
// `mk()?.y == null` runs, and binding the call result first (`const t = g(); t?.y == null`)
// runs, so the inline call-under-`?.` through a value binding is the ingredient. A
// struct-field closure receiver reproduces it identically, so it is a family.
// Should print false.
type B = { y: i32 }

function mk(): B | null { { y: 7 } }

const g = mk
print(g()?.y == null)
