// A struct that is BOTH a union ARM and the nested-struct FIELD of another union's arm, in
// BOTH declaration orders — the shape the first external consumer's MPQ reader wanted:
// `readMpqFile(): Buf | MpqError` beside `openMpq(): Mpq | MpqError`, with `Mpq` holding a
// `Buf` field.
//
// CLOSED by D1518. `collectS` SKIPS a `type X = {…}` that is a union member, so an arm has no
// `sNames` row; D761 built the mint that gives it one, but only from a declaration that OWNS
// a struct row — and here the declaration carrying the field is ITSELF an arm, so the mint
// never ran for either order.
//
// TWO SENTENCES, ONE MISSING INTERN, and which one you got depended on declaration order:
//
//   emitProgram: nested-struct field element type is not interned              (`M | E` first)
//   emitProgram: only i32 / … / array union-variant fields are supported       (`B | E` first)
//
// Both were POSITIONLESS (`at <file>`, no line:col) — the collect and type-section phases arm
// no diagnostic cursor. That half is D1519.
//
// Reported as VL-024 by the first external consumer (`~/glean/docs/vl-issues.md`).
//
// Should print: 1 16 2 f 2 8 g 2 8 g 1 16 2 f
type E = { msg: string }
type B = { base: i32, length: i32 }
type M = { a: B, n: i32 }

function f(ok: boolean): M | E {
  if !ok { return { msg: "f" } }
  return { a: { base: 1, length: 16 }, n: 2 }
}

function g(ok: boolean): B | E {
  if !ok { return { msg: "g" } }
  return { base: 2, length: 8 }
}

// The OTHER order, in the same module: `C | E` is registered before `N | E`, so the field
// `q: C` is coded while `C` is already a variant — the arm that took the second sentence.
type C = { base: i32, length: i32 }
type N = { q: C, k: i32 }

function h(ok: boolean): C | E {
  if !ok { return { msg: "g" } }
  return { base: 2, length: 8 }
}

function j(ok: boolean): N | E {
  if !ok { return { msg: "f" } }
  return { q: { base: 1, length: 16 }, k: 2 }
}

const m = f(true)
if m is M { print(m.a.base); print(m.a.length); print(m.n) }
const me = f(false)
if me is E { print(me.msg) }
const b = g(true)
if b is B { print(b.base); print(b.length) }
const be = g(false)
if be is E { print(be.msg) }

const c = h(true)
if c is C { print(c.base); print(c.length) }
const ce = h(false)
if ce is E { print(ce.msg) }
const n = j(true)
if n is N { print(n.q.base); print(n.q.length); print(n.k) }
const ne = j(false)
if ne is E { print(ne.msg) }
