// D17794 — a `.map` lambda annotated at a closed function type returns a list-of-records
// element's hole function at a signature no instance of the element reaches, so the callback is
// refused: `emitProgram: a .map/.filter callback needs an instance at the list's element type`.
// Should print 2 then 2.5.
function id(a) { return a }
function deliver() { return [{ f: id }] }
const u = deliver()
print(u[0].f(2))
const v = deliver().map((r): (a: f64) => f64 => r.f)
print(v[0](2.5))
