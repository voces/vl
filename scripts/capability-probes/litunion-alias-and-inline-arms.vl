// Two struct arms discriminated by a literal field, one spelling it as a named literal-union
// ALIAS and the other inline. D1023 rules this legal — both are string literal sets, so the
// values are comparable — and the checker agrees; the emitter refused, because an alias reps
// as the interned i32 atom and an inline set as a string ref, so the arms shared no layout.
//
// CLOSED BY D1050 (2026-09-02), and the probe stays as the pin. `unifyMixedLitRepArms` lays
// the mixed field out under ONE rep — the atom — in both the variant and the declared struct
// row, so the arms fold onto a single heap type and every consumer the atom already had
// (construct intern, `is` compare, read classifier, `emitAtomToStr` widen) serves the inline
// arm too. Its BOUND has a probe of its own beside this one:
// `litunion-mixed-arm-with-base-partner.vl`.
// Should print 2.
type K1 = "circle" | "round"
type A = { kind: K1, r: f64 }
type B = { kind: "x" | "y", r: f64 }
function f(n: i32): A | B {
  if n == 0 { return { kind: "circle", r: 1.0 } }
  return { kind: "x", r: 2.0 }
}
print(f(1).r)
