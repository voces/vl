// A plain struct whose field is a union ARM that recurses through a map VALUE. `vl check`
// returns 0 and the emitter refuses with `emitProgram: map value type has no interned slot`
// at `Q`: the arm alone, and the same record outside a union, both run (D15097).
// Should print 1.
type Q = { o: A }
type A = { n: i32, g: Map<string, A> }
type P = { m: i32 }
type U = A | P
const q: Q = { o: { n: 1, g: Map() } }
print(q.o.n)
