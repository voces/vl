// A plain struct whose field is a union ARM that recurses through a map VALUE. It refused at
// emit with `emitProgram: map value type has no interned slot` at `Q`, because the holder's
// twin check compared the two rows' map slots before `collectA` interned them; `collectS` now
// interns them first (D15097). Should print 1.
type Q = { o: A }
type A = { n: i32, g: Map<string, A> }
type P = { m: i32 }
type U = A | P
const q: Q = { o: { n: 1, g: Map() } }
print(q.o.n)
