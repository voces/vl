// A GENERIC MAKER CALLED AT TWO INSTANCES, each delivered at a record that stores `f` wider than
// the maker's literal (D17874). The record solve builds a maker's result at its destination
// through the kept table, which `own`, the instance's result type, already keys, but a generic
// maker is admitted only with one instance and its calls are compared across instances, so the
// check refuses the share. The hole spelling (`mk(x)`) runs. Should print 8 then s.
type J = { f: i32 | null, g: i32 }
type K = { f: string | null, g: string }
function mk<T>(x: T) { return { f: null, g: x } }
const j: J = mk(8)
const k: K = mk("s")
print(j.g)
print(k.g)
