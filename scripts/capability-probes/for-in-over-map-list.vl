// A `for … in` over a LIST OF MAPS. `vl check` returns 0 and the emitter refuses with
// `emitProgram: unsupported for-in iterable` — clause 2. `forInElemKind` has no arm for a
// map element, so `declareForInLocals` refuses in the collect pass, before the body is
// lowered. Every neighbouring element type iterates: `((i32) => i32)[]`, `u8[][]`,
// `i32[][][]`, `(i32|string)[]`, and a map is itself iterable with `.keys()`.
// Should print 0.
function count(xs: {[string]: i32}[]): i32 {
  let n = 0
  for m in xs { n = n + m.size }
  return n
}
print(0)
