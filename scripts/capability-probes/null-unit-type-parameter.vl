// A parameter typed by the `null` unit type alone, with no `T | null` around it. DECISIONS.md
// A-infer-null makes `null` a type of its own, so `vl check` accepts this (rc 0) and the emitter
// owes a lowering; today `emitProgram: a parameter of type `null` is type-valid but has no
// lowering yet` (`checkParams`, `emit_sections.vl`). The same unit type has no rep as a `let`,
// a return or a struct field either (D4550). Should print true.
function f(x: null) { print(x == null) }
f(null)
