// A record kept at its own type and converted into a type that stores a nested field
// differently, bound and passed. The refusal "is not yet supported: the converting copy does not
// reach a nested or nullable field" names this shape; the plainest programs it forbids run.
// Should print 3 then 3 then 5 then 6.
type W = {a: {b: i32 | null}}
const r = { a: { b: 3 } }
const w: W = r
print(w.a.b ?? 0)
print(r.a.b)
type V = {a: i32 | null, c: {b: i32 | null}}
function f(x: V) { return x.c.b ?? 0 }
const s = { a: 1, c: { b: 5 } }
print(f(s))
print(s.c.b + s.a)
