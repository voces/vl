// D1561's CLAUSE-1 FACE — the identical delivery read through `is` rather than the shared
// discriminant. `vl check` rc 0, then the engine refuses the module:
// `type mismatch: expected i32, found (ref $type)`. With no union name for the node the
// desugared `??` took an `(if (result i32))` blocktype while both arms pushed the union box.
// One read spelling apart from `coalesce-declared-union-inferred-binding`, and in the other
// clause — which is why both are probes.
// Should print 2.
type Circle = { kind: "circle", r: f64 }
type Rect = { kind: "rect", w: f64, h: f64 }
type Shape = Circle | Rect
function mkval(): Shape { return { kind: "rect", w: 2.0, h: 3.0 } }
function passh(x) { return x }
function go() {
  const srcOpt: Shape | null = passh(mkval())
  let v = (srcOpt ?? { kind: "circle", r: 1.0 })
  v = (srcOpt ?? { kind: "circle", r: 1.0 })
  if v is Rect { print(v.w) } else { print(0) }
}
go()
