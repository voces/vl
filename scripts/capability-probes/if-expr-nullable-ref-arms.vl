// An if-EXPRESSION whose two ARMS are CALLS returning `E | null`, bound WITHOUT an annotation.
// `vl check` returned 0 and the emitter refused with `emitProgram: bare null needs a
// struct-typed context` (D1560; reported by the glean session as VL-025). Should print a.
//
// THE CHECKER AND THE EMITTER AGREED ABOUT THE TYPE AND DISAGREED ABOUT THE REP. Both faces
// carry the identical arena row — `TyNullable(TyObj E)`, which is why annotating draws
// `@hint redundant type annotation` — but only the ANNOTATED one reached `letIsNulRef`. The
// `exprNullable*` family answered an if-expression only when the OTHER arm was a bare `null`,
// and then asked its NON-null predicate of the value, so a `T | null`-valued arm classified as
// nothing at all and the binding took the i32 slot default while the `if` pushed
// `(ref null $E)`.
//
// THE SIBLING PROBE (`if-expr-nullable-variant-arms.vl`) is the same construct one type-shape
// over — the arm's struct is a MEMBER of a declared union — and it refused with a DIFFERENT
// sentence, which is what made the reporter read the two as unrelated.
type E = { msg: string }
function mkA(ok: boolean): E | null {
  if ok { return null }
  return { msg: "a" }
}
function mkB(ok: boolean): E | null {
  if ok { return null }
  return { msg: "b" }
}
function pick(flag: boolean, ok: boolean) {
  const e = if flag { mkA(ok) } else { mkB(ok) }
  if e != null { return e.msg }
  "ok"
}
print(pick(true, false))
