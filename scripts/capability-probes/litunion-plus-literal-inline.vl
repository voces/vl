// A LITERAL UNION beside an EXTRA LITERAL of the same base — `Kind | "err"` where
// `Kind = "a" | "b"` — spelled INLINE in a function's return type.
//
//   emitProgram: literal `is` over a struct union is not supported
//
// THE DECLARED SPELLING OF THE SAME UNION RUNS. `type R = Kind | "err"` with the identical
// body prints `a`; only the inline annotation refuses. So this is the two union ROUTES
// disagreeing about one type rather than a missing capability: `litUnionFlatMembers` requires
// EVERY member to be a homogeneous literal UNION, and a bare `TyLit` member is not one, so
// the annotation route keeps `[Kind, "err"]` — a union whose member is a union — while the
// declaration route reaches a shape `is` can test.
//
// MEASURED PRE-EXISTING, not introduced by the D1024 subsumption collapse: a `git archive
// origin/master` build grades both spellings identically (inline refuses, declared runs).
// The collapse does not fire on this union at all, and must not — `Kind | "err"` has no
// `string` ARM (flattening `Kind` reaches its LITERALS), so it is a genuine three-atom
// litunion under the 2026-09-02 ruling.
//
// Should print a then b then e.
type Kind = "a" | "b"

function pick(n: i32): Kind | "err" {
  if n == 0 { return "a" }
  if n == 1 { return "b" }
  "err"
}

let i = 0
while i < 3 {
  const r = pick(i)
  if r is "a" {
    print("a")
  } else {
    if r is "b" { print("b") } else { print("e") }
  }
  i = i + 1
}
