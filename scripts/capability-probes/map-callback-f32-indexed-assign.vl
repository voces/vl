// An indexed ASSIGNMENT into a list produced by `.map` with an `f32`-returning callback.
// `vl check` returns 0 and the emitter refuses with
// `emitProgram: f32 indexed assignment but f32 list type not collected`
// (`compiler/wasmEmit.vl:16128`). Should print 1.
//
// MECHANISM — ONE MISSING LADDER, SHARED WITH `map-chain-i64-result.vl`.
// `collectMapFilterUse` (`emit_collect.vl:12800-12807`) classifies a `.map` result by the
// callback's return kind, and its ladder has an `f64` arm and an i32 DEFAULT — no `i64`, `f32`
// or `u8` arm. So a callback returning `f32` yields a list the emitter reps as f32 while
// `fa32Used` stays false, and the `*Used` floor fires.
//
// NO `f32[]` SPELLING APPEARS ANYWHERE IN THE PROGRAM, which is what keeps the other collector
// (`collectA`'s TypeRef chain) from setting the flag: the rep is inferred from the callback's
// return type and nothing writes the annotation that would register it.
//
// THE SAME HOLE IS BEHIND AT LEAST THREE MESSAGES — this one, `.map/.filter over i64[] but i64
// list type not collected`, and `.pop but list type not collected` (`wasmEmit.vl:17023`). Fixing
// the ladder is one change; the floors are downstream of it.
function toF(n: i32): f32 { return 1.5 }
function main() {
  const v: f32 = 2.5
  const xs = [1, 2]
  xs.map(toF)[0] = v
  print(1)
}
main()
