// An inline EMPTY object shape in a NULLABLE position (`{} | null`). `vl check` returns 0 and
// the emitter refuses with `emitProgram: ref valtype with no interned shape`.
// Should print 11 then -1.
//
// THE ALIAS SPELLING IS THE CONTROL AND IT RUNS: `type E = {}` then `type U = E | null` prints
// the same two values today. So the empty shape HAS a rep; the inline spelling in a nullable
// position is what fails to intern one.
//
// A DIFFERENT MECHANISM FROM D1081, which is why that row closed without this. D1081 was the
// field SPLIT reporting one empty field for a zero-field shape (`shapeInnerFieldSplit` pushing a
// part for the empty interior); this is the anon-shape INTERNER, and it fires after the split is
// already correct. The non-nullable inline spellings all run — `{} | { x: i32 }`,
// `{ x: i32 } | {}`, and a three-arm union with the empty arm first.
//
// `{ x: i32 } | null` also runs, so the ingredient is EMPTINESS plus INLINE plus NULLABLE, and
// not the nullable position on its own.
type U = {} | null

function tag(u: U) {
  if u != null { return 11 }
  return -1
}

const e: U = {}

print(tag(e))
print(tag(null))
