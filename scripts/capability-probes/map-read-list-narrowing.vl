// NARROWING A LIST-VALUED MAP READ — silent-class-inventory D1038:
//
//   emitProgram: `is` test but no union type declared
//
// `vl check` returns 0, so this is a clause-2 violation by construction. A declared
// `i32[] | null` local narrows at the IDENTICAL spelling, and a STRUCT-valued map read
// narrows too — it is the map read's own rep, and only for a value handed back as a ref
// container (a list, or a nested map). `?? []` is the workaround, so the value is readable.
//
// Should print 5.
const m: { [string]: i32[] } = Map()
m["a"] = [5]

const g = m["a"]
if g is i32[] { print(g[0]) }
