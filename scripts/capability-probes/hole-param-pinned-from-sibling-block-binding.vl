// D1596's RESIDUE, CLOSED BY D1598 — the ambiguous half of the module-frame table. A `const`
// written inside a top-level block is a start-function local, and the table that answers
// "which binding does this name denote at module scope" is FIRST-WINS over a walk with no
// notion of which block the call site sits in. So with two sibling blocks binding one name the
// monomorphizer's pin declined (`moduleLocalLetOfUnique`) rather than guess, and this call
// fell back to the `"i32"` catch-all over a `(ref $type)` argument: `vl check` rc 0, invalid
// wasm.
// Answering from the table unconditionally is a `runs -> not-runs` — it hands the i32 block's
// call the ref binding — so the resolution is the CHECKER's: the type it recorded for the site
// names which candidate the site denotes. `tests/cases/generics/pin-module-block-binding.vl`
// leg 7 is the control that shape must not break.
// Should print 5.
type Box = { base: i32 }

function ld(self: Box) { self.base }

function viaHole(b) { b.ld() }

if true {
  const p = 4
  print(p + 1)
}

if true {
  const p: Box = { base: 5 }
  print(viaHole(p))
}
