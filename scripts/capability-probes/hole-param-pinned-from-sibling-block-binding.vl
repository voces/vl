// D1596's RESIDUE — the ambiguous half of the module-frame table. A `const` written inside a
// top-level block is a start-function local, and the table that answers "which binding does
// this name denote at module scope" is FIRST-WINS over a walk with no notion of which block
// the call site sits in. So with two sibling blocks binding one name the monomorphizer's pin
// declines (`moduleLocalLetOfUnique`) rather than guess, and the second call falls back to the
// `"i32"` catch-all over a `(ref $type)` argument: `vl check` rc 0, invalid wasm.
// Answering unconditionally instead is a `runs -> not-runs` — it hands the i32 block's call
// the ref binding — so the fix is a LEXICAL resolution, not a wider scan.
// The closed half is `tests/cases/generics/pin-module-block-binding.vl` (leg 7 is the control
// this probe's shape must not break).
// Should print 5.
type Box = { base: i32 }

function ld(self: Box) { self.base }

function viaHole(b) { b.ld() }

if true {
  const p = 4
  print(p + 1)
}

if true {
  const p: Box = { base: 5 }
  print(viaHole(p))
}
