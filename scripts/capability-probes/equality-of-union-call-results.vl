// `==` over two call results of a struct union and of a scalar union, neither operand a
// binding. The refusals "emitProgram: union `==` over a non-binding union value is not
// supported yet" and "emitProgram: struct equality is not supported yet" name these shapes;
// the plainest programs they forbid run.
// Should print true twice.
type A = {a: i32}
type B = {b: string}
function mk(): A | B { return { a: 1 } }
print(mk() == mk())
const x: i32 | string = 3
function k(): i32 | string { return 3 }
print(k() == x)
