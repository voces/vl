// Every lane replace and extract SIMD intrinsic, each with a literal lane. The refusal "' has an
// operand shape with no lowering" names a lane intrinsic whose operand shape the emitter has no
// arm for; the plainest program over each one runs.
// Should print 9.5 then 8 then 200 then -56 then -4 then 300 then 300.
const v = __splat_f32x4__(1.5)
const v2 = __replace_lane_f32x4__(v, 2, 9.5)
print(__extract_lane_f32x4__(v2, 2))
const w = __splat_i64x2__(7 as i64)
const w2 = __replace_lane_i64x2__(w, 1, 8 as i64)
print(__extract_lane_i64x2__(w2, 1))
const z = __replace_lane_i8x16__(w, 3, 200)
print(__extract_lane_u_i8x16__(z, 3))
print(__extract_lane_s_i8x16__(z, 3))
const q = __replace_lane_i32x4__(z, 0, -4)
print(__extract_lane_i32x4__(q, 0))
const h = __replace_lane_i16x8__(q, 5, 300)
print(__extract_lane_s_i16x8__(h, 5))
print(__extract_lane_u_i16x8__(h, 5))
