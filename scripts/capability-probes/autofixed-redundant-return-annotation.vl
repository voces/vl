// The program `vl check --fix` WRITES when it acts on its own `redundant type annotation`
// hint. The source carried `function mk(len: i32): i32[]`; the checker called the `: i32[]`
// redundant, the autofix deleted it, and the SAME checker then refuses the result. A hint the
// compiler will apply for you and then reject is a clause-2 refusal of a program the compiler
// itself authored, so it belongs here rather than in the corpus.
//
// One of 165: `vl check --fix --severity hint` over a copy of `tests/cases/` rewrites 1,093
// fixtures and moves 165 of them `runs -> not-runs`. See D1044.
// Should print 0.
function mk(len: i32) {
  return __array_new_default__(len)
}

const zs = mk(6)
print(zs[0])
