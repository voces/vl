// `==` between a read of an un-annotated `Map()` of struct-union values and the union (D15058).
//
//   emitProgram: `==` over a struct union is not supported yet
//
// The map read's union is spelled structurally, `{k:i32}|{s:string}`, and has no member set, so
// it does not meet `U`'s row; an annotated `{[string]: U}` map runs.
//
// Should print: true
type U = { k: i32 } | { s: string }
const q: U = { s: "a" }
const m = Map()
m["k"] = q
const v = m["k"]
if v != null { print(v == q) }
