// `==` over records whose field is a string literal union on one side and `string` on the other:
// `vl check` returns 0 and emit refuses with `emitProgram: struct equality is not supported yet`.
// The list spelling is refused at check (D16393); this one reaches the emitter (D16394).
// Should print true.
const a: {f: "a" | "b"} = { f: "a" }
const b: {f: string} = { f: "a" }
print(a == b)
