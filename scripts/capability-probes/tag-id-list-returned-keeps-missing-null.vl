// A missing key's null among a tagged set's ids returned in a list survives the crossing to
// the closure list. Should print 4 then none.
function inc(a) { return a + 1 }
function dbl(a) { return a * 2 }
const m = Map()
m["k"] = inc
m["d"] = dbl
function withMiss() { return [m["k"], m["zz"]] }
const gs = withMiss()
let j = 0
while j < gs.length {
  const g = gs[j]
  if g != null { print(g(3)) } else { print("none") }
  j = j + 1
}
