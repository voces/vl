// A MAP ALIAS declared BEFORE the union it recurses through — the remaining half of
// silent-class-inventory D1036, filed as D1037:
//
//   emitProgram: unsupported map value type (…interned no mv slot)
//
// The identical program with the two declarations SWAPPED runs today (D1036 closed that
// order), so a type declaration's position in the file is observable at the emit boundary.
// The forward reference alone is fine — `type J = f64 | string` under the same order runs —
// what fails is the reference coming back to the map that made it.
//
// Should print 0 then 1 then 1.5.
type JO = { [string]: J }
type J = null | f64 | JO

const o: JO = Map()
print(o.size)

o["k"] = 1.5
print(o.size)

const v = o["k"]
if v is f64 { print(v) }
