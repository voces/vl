// A map `.get` on a record-valued map field read through an un-annotated parameter. `vl check`
// returns 0 and the emitter refuses with `emitProgram: callee is not a function name` at the
// call: the `.get` is lowered as a plain call of a member (D15153). Should print 7.
type R = { r: i32 }
type A = { g: Map<string, R> }
function take(a) {
  const v = a.g.get("x")
  print(v?.r ?? 0)
}
const g: Map<string, R> = Map()
g.set("x", { r: 7 })
const x: A = { g: g }
take(x)
