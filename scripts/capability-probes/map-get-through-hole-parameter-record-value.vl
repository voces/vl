// A map `.get` on a record-valued map field read through an un-annotated parameter: the
// instance's elaboration types the receiver as a map, so the call is the index read (D15153).
// Should print 7.
type R = { r: i32 }
type A = { g: Map<string, R> }
function take(a) {
  const v = a.g.get("x")
  print(v?.r ?? 0)
}
const g: Map<string, R> = Map()
g.set("x", { r: 7 })
const x: A = { g: g }
take(x)
