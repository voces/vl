// `.slice(a, b)` over a `u8[]`.
//
// silent-class inventory D1141.
//
//   at module scope     -> check rc 0, then: type mismatch: expected (ref $type), found (ref $type)
//   in a function body  -> emitProgram: callee is not a function name
//
// Every other element rep slices and prints 2 — `i32[]`, `i64[]`, `f64[]`, `f32[]`, `string[]`,
// `boolean[]`. `u8[]` is alone for the reason `scalarListElemKind`'s own header gives: it is the
// one list whose element VALUE kind (i32) does not identify its rep, because its backing is
// `(array (mut i8))` while every other i32-element list is `(array (mut i32))`. A slice mints a
// NEW list, so it has to pick the backing from the REP and not from the element kind.
//
// The function-scope sentence names neither `slice` nor `u8` nor lists, so the two faces of one
// gap point a reader at two unrelated subsystems.
//
// Should print: 2 2 1

const xs: u8[] = "abc".bytes()
const s = xs.slice(0, 2)
print(s.length)

function inFn() {
  const ys: u8[] = "abc".bytes()
  const t = ys.slice(0, 2)
  print(t.length)
  // The elements must survive the copy, not just the length: `"abc".bytes()[1]` is `b` = 98.
  const u = ys.slice(1, 2)
  print(u.length)
}

inFn()
