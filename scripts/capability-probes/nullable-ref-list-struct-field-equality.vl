// An `S[] | null` struct FIELD is the one ref niche whose guarded compare does not work, so
// it is held OUT of `nulFieldInnerCode` and refuses loudly instead.
//
//   emitProgram: unsupported struct field type in equality
//
// `vl check` returns 0, so this is a clause-2 violation by construction. silent-class
// inventory D1291.
//
// MEASURED, NOT ASSUMED. With `28 -> 5` in the table the guarded pair grades check-clean
// invalid wasm (`type mismatch: expected ref but found i32`), because the non-null twin's arm
// does not take two refs off the stack like the other leaf cores — it re-reads the two lists
// off the field path itself and hands them to `emitListEqAnyRep`, so the guard's
// `ref.as_non_null` recover lands in the wrong place. The entry was withdrawn rather than
// shipped: the table is D1180's admission gate, not a mapping.
//
// The sibling niches all run under the same wrapper, null case included, which is what says
// this is the arm's shape rather than the guard's.
//
// Should print true then false.
type Inner = { p: i32 }
type A = { d: Inner[] | null }

const same1: A = { d: [{ p: 5 }] }
const same2: A = { d: [{ p: 5 }] }
const diff: A = { d: [{ p: 6 }] }
print(same1 == same2)
print(same1 == diff)
