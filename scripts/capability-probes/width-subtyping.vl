// A value with MORE fields flowing into a shape with fewer. Structural width subtyping:
// the checker agrees it is type-valid and codegen has no field-dropping conversion.
// Should print 1.
type Wide = { a: i32, b: i32 }
type Narrow = { a: i32 }
function take(n: Narrow): i32 { return n.a }
const w: Wide = { a: 1, b: 2 }
print(take(w))
