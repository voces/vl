// A closure capturing a REF-typed local declared in a MODULE-SCOPE block. `vl check` returns
// 0 and the emitter refuses with `emitProgram: field access receiver is not a struct` —
// clause 2. The block is the ingredient, and specifically a block whose enclosing scope is
// the MODULE: the identical `if` body inside a function runs at every depth, and so does the
// same capture at module scope with no block. `if` / `else` / `while` / `for` / bare all
// refuse; a captured i32 runs; a captured list or string is check-clean INVALID WASM.
// Found 2026-09-02 by the position-matrix harness while grading `closure_capture`.
// See D1244.
// Should print 7.
type P = { x: i32 }

if true {
  const p: P = { x: 7 }
  const f = () => p.x
  print(f())
}
