// An un-annotated `x = null` binding that is NEVER written, read through an if-EXPRESSION and
// coalesced. `vl check` returns 0 — `x` is `_ | null`, the if-expression joins two copies of
// it, and `?? 0` is `i32` — and the emitter refuses with `emitProgram: \`??\` over this
// nullable value is not supported yet`. Should print 0.
//
// THE GAP IS THE HOLE'S REP, not the `??`. `x = null` binds a `TyNullable` whose inner
// is the OPEN A-infer-null hole (`mkNullableTy(-1)`); a write fills it (`x = 5` runs, see
// `tests/cases/types/infer-null-reassign.vl`), and with no write there is nothing to rep, so
// every delivery of the value refuses. Filling it with the JOIN of the reads, or reporting
// the never-filled hole at CHECK time the way an uninferable `[]` is reported, would close it.
//
// D1575. Until 2026-09-04 this program did not refuse — it TRAPPED the compiler, at
// `nodeTyIsNulScalarBox` reading `T.tys[-1]` (and at four siblings that shadow it).
function go(c: boolean) {
  const x = null
  const y = (if c { x } else { x }) ?? 0
  print(y)
}
go(true)
