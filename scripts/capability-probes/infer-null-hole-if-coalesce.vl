// An un-annotated `x = null` binding that is NEVER written, read through an if-EXPRESSION and
// coalesced. `vl check` returns 0 and the program prints 0.
//
// THE GAP WAS THE HOLE'S REP, not the `??`. `x = null` binds a `TyNullable` whose inner is the
// OPEN A-infer-null hole (`mkNullableTy(-1)`); a write fills it (`x = 5` runs, see
// `tests/cases/types/infer-null-reassign.vl`), and with no write there was nothing to rep, so
// every delivery of the value refused. D1576 answers the hole instead: at scope close a hole
// nothing filled resolves to the `null` TYPE, whose rep is `nullref` (D1567's `nulnone`).
//
// D1575. Until 2026-09-04 this program did not refuse — it TRAPPED the compiler, at
// `nodeTyIsNulScalarBox` reading `T.tys[-1]` (and at four siblings that shadow it).
function go(c: boolean) {
  const x = null
  const y = (if c { x } else { x }) ?? 0
  print(y)
}
go(true)
