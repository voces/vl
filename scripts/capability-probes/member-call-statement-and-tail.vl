// A MEMBER CALL WHOSE VALUE NO MUTATOR ARM CLAIMS, at every position it can stand in.
// `vl check` returns 0 and the emitter refused with `emitProgram: unsupported member-call
// statement` — clause 2, and at EVERY rep including `i32[]`, which is the rep everything
// else serves first. Should print 2 then 3 then 3 then 1 then 2.
//
// THE FILED SCOPE WAS WRONG: the row said TAIL position, with `return xs.slice(0, 2)` as the
// control. The control is a VALUE position, not a non-tail one — a non-tail statement, a
// module-scope statement and a tail in a `: void` function all refused identically. So the
// missing route is `emitCallStmt`'s DISCARD, the same rule its `Ident` arm applies to a
// value-returning `f(…)`, plus the tail-value exit for the one position where the value is
// the function's result.
//
// D1240. D1131's `u8[].clear()` drew the SAME sentence one gate earlier and is NOT the same
// route: that was a per-method gate admitting more receiver reps into `emitClear`, this is
// the fall-through for every method the ladder never claims.
function f(): i32[] {
  const xs: i32[] = [1, 2, 3]
  xs.slice(0, 2)
}
function nonTail(): i32 {
  const xs: i32[] = [1, 2, 3]
  xs.slice(0, 2)
  return xs.length
}
function voidTail(): void {
  const xs: i32[] = [1, 2, 3]
  xs.slice(0, 2)
}
function inferred(xs: i32[]) { xs.slice(0, 2) }

const ms: i32[] = [1, 2, 3]
ms.slice(0, 2)
print(f().length)
print(nonTail())
print(ms.length)
voidTail()
print(1)
print(inferred([1, 2, 3]).length)
