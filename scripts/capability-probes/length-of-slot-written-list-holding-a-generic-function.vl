// `.length` on a list of two generic functions, built from one un-annotated parameter, slot-written with
// another and read inside their instance, the listed one bound to a different generic at each of two calls.
// `vl check` returns 0 and the emitter refuses the argument: `emitProgram: a generic function taken
// as a value reaches no call that fixes its type — annotate the destination's function type`
// (D15577). Should print 1, 5, 1, 5.
function id<T>(x: T): T { x }
function id2<U>(x: U): U { x }
function id3<V>(x: V): V { x }
function use(ys) { print(ys.length) }
function take(a, b) {
  const xs = [a]
  xs[0] = b
  use(xs)
  print(xs[0]("abc").length + xs[0](2))
}
take(id, id2)
take(id3, id2)
