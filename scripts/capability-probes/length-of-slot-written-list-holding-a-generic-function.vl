// `.length` on a list of two generic functions, built from one un-annotated parameter, slot-written with
// another and read inside their instance, the first handed on through a hole parameter. `vl check`
// returns 0 and the emitter refuses the argument: `emitProgram: a generic function taken as a value
// reaches no call that fixes its type — annotate the destination's function type` (D15573).
// Should print 1 then 5.
function id<T>(x: T): T { x }
function id2<U>(x: U): U { x }
function use(ys) { print(ys.length) }
function take(a, b) {
  const xs = [a]
  xs[0] = b
  use(xs)
  print(xs[0]("abc").length + xs[0](2))
}
function fwd(f) { take(f, id2) }
fwd(id)
