// `.length` on a list of a generic function, built from one un-annotated parameter, slot-written with
// another and read inside their instance. `vl check` returns 0 and the emitter refuses with
// `emitProgram: '.length' on a receiver the emitter cannot classify as a list, string, map or set`
// (D15568). It replaced D15567's own-parameter write, which runs, as live-sites.json's row.
// Should print 1 then 5.
function id<T>(x: T): T { x }
function use(ys) { print(ys.length) }
function take(a, b) {
  const xs = [a]
  xs[0] = b
  use(xs)
  print(xs[0]("abc").length + xs[0](2))
}
take(id, id)
