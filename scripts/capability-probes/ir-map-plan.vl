// D17793 — `.map` returning a list-of-records element unchanged into a list annotated at a
// closed function field is refused at emit
// The IR refuses it as `cannot yet lower this statement (map plan...)`; the literal is `map
// plan`.
// Should print 2.5.
function id(a) { return a }
function deliver() { return [{ f: id }] }
const v: { f: (a: f64) => f64 }[] = deliver().map((r) => r)
print(v[0].f(2.5))
