// A named function's closure stored into a map whose slot holds a bundle's record, from a
// function: the slot's record has no member the named function builds. See D17700.
// Should print true.
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
function dbl(a: f64): f64 { return a * 2.0 }
const m = Map()
m["a"] = lap((a) => a + 1)
function g() {
  m["b"] = dbl
  return m.has("a")
}
print(g())
