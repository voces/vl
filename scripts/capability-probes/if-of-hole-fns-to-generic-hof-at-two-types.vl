// A top-level binding of an `if` choosing two un-annotated functions, handed to a generic
// higher-order function at `i32` and at `f64`: `vl check` returns 0 and emit refuses with
// `emitProgram: a binding of an `if` choosing generic functions is delivered at two function
// types — annotate the binding`. Inside a function body, or through an un-annotated
// higher-order function, it runs. See D16832. Should print 5 then 3.5.
function app<A, B>(f: (x: A) => B, x: A): B { return f(x) }
function hinc(x) { return x + 1 }
function hid(x) { return x }
const c = 3 > 2
const h = if c { hinc } else { hid }
print(app(h, 4))
print(app(h, 2.5))
