// A lambda whose result is an anonymous record, handed to a generic identity. Emit refuses it:
// "emitProgram: monomorphize: unsupported argument type for `x` in a call to `id`", while a
// named function or a declared record result runs. See D16890.
// Should print 5.
function id<T>(x: T): T { return x }
const f = id(() => ({ a: 5 }))
print(f().a)
