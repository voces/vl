// AN UN-ANNOTATED `const none = []` WHOSE ELEMENT TYPE A SIBLING RETURN ARM SUPPLIES — the
// "no data for this key" lookup shape (glean VL-041). The bare `[]` in the same tail position
// already answered; giving it a NAME lost the pin, because under an INFERRED return the
// destination is the join of every return and nothing pinned against it.
//
//   cannot infer a type for 'none' — add a type annotation
//
// CLOSED by D1591: every delivery to an inferred return is banked and pinned once the body's
// return witnesses are all in (`noteInferRetWitness` / `flushInferRetHoles`), which is what
// makes the ORDER-INDEPENDENT face below work too — the `return none` written BEFORE the arm
// that names the type has nothing to pin against at the delivery.
//
// THE ELEMENT IS NON-i32 ON PURPOSE. An unpinned hole lowers as the i32-list default, so an
// `i32[]` probe would pass whether or not the checker's pin reached the emitter.
//
// Should print: 0 3 1 0.75 4.5 0 z 9

// The consumer's own shape: a lookup that answers a measured table for the keys that have one
// and an empty array otherwise.
function radii(r: i32) {
  if r == 6 { return [1, 2, 4] }
  const none = []
  none
}
print(radii(7).length)
print(radii(6).length)

// A NON-i32 element, read back through arithmetic so the backing is proved, not just the
// length — and pushed after the delivery so the element type is proved too.
function measured(r: i32) {
  if r == 6 { return [1.5, 2.5, 4.0] }
  const none = []
  none
}
const v = measured(7)
v.push(0.5)
print(v.length)
print(v[0] + 0.25)
print(measured(6)[2] + 0.5)

// The RETURN written BEFORE the arm that supplies the type, and an explicit `return` rather
// than a trailing expression.
function early(r: i32) {
  const none = []
  if r == 7 { return none }
  [1.5, 2.5]
}
print(early(7).length)

// A tail `if`/`else` whose OTHER arm is the concrete one, and a `??` default.
function pick(r: i32) {
  const none = []
  if r == 6 { ["a", "b"] } else { none }
}
const p = pick(7)
p.push("z")
print(p[0])

function maybe(r: i32): i32[] | null {
  if r == 6 { return [1, 2, 4] }
  null
}
const fallback = []
const got = maybe(7) ?? fallback
got.push(9)
print(got[0])
