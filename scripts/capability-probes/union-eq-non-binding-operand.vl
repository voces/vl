// `==` over a union value that is NOT a binding — here a direct call result. The BOUND
// spelling of the identical comparison runs and prints `true`, so the lowering exists; only
// the re-readability predicate `unionEqOperandOk` (Ident / NumLit / StrLit / Member / Index)
// declines a Call, because the compare reads the operand twice — the tag, then the payload.
// The same shape D960 had for `??`, closed there by stashing the operand once.
// Found 2026-09-01 by hand-probing the `--sites` ZERO rows.
// Should print true.
function mk(c: boolean): i32 | string {
  if c { return 1 }
  "s"
}

print(mk(true) == 1)
