// An UN-ANNOTATED binding initialised from a struct-field read, then captured and called.
// `vl check` returns 0 and the emitter said `emitProgram: call to unknown function`. The
// ANNOTATED spelling of the same binding ran, and the checker emitted
// `@hint redundant type annotation` on the annotation that rescued it — the hint agreeing
// about the TYPE while the two spellings disagreed about the REP.
//
// `captureValKind` types an annotated env field from the annotation and an un-annotated one
// through `letInitCellKind`, whose syntactic arms cannot resolve a container read during a
// pass that runs before the locals registry is built. The array-element and map-read
// spellings are the same gap at the other two containers, the map one at the nullable rep.
// See D1621. Should print 55.
function go() {
  const w = { f: (n: i32) => n + 1 }
  const v = w.f
  const g = (n: i32) => v(n)
  print(g(54))
}
go()
