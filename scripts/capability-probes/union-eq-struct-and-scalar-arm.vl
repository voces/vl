// `==` over a union that carries a STRUCT arm beside a SCALAR arm.
//
//   emitProgram: `==` over a struct union is not supported yet
//
// `vl check` returns 0, so this is a clause-2 violation by construction. silent-class
// inventory D1061.
//
// THE MIXED ARM IS THE INGREDIENT, NOT THE STRUCT ONE. Two STRUCT arms (`A | B`) compare
// and run today; `A | i32` and `A | string` both refuse. Binding both operands to locals
// does not help — this is not the non-binding-receiver gap (D1060), and the two were
// separated by ablation rather than by their messages.
//
// Should print true then false.
type A = { x: i32 }

function mk(n: i32): A | i32 {
  if n == 0 { return 5 }
  { x: 1 }
}

const p = mk(0)
const q = mk(0)
print(p == q)
const r = mk(1)
print(p == r)
