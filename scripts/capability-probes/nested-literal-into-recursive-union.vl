// A bare NESTED array literal, and a bare literal holding a MAP, delivered to a destination
// typed as the RECURSIVE UNION rather than as its array arm. `[2.5]` at `Json` always
// worked; `[[2.5]]` and `[mv]` each had their own loud refusal (silent-class-inventory
// D1016), while the same values built through an annotated `Json[]` ran — so the arms had
// reps and only the literal→union conversion was missing.
// Should print 2.5 twice.
type Json = null | boolean | f64 | string | Json[] | { [string]: Json }

function leaf(c: Json): f64 {
  if c is Json[] {
    const e = c[0]
    if e is Json[] {
      const f = e[0]
      if f is f64 { return f }
    }
    if e is { [string]: Json } {
      const g = e["k"]
      if g is f64 { return g }
    }
  }
  0.0
}

const nested: Json = [[2.5]]
print(leaf(nested))

const mv: { [string]: Json } = Map()
mv["k"] = 2.5
const withMap: Json = [mv]
print(leaf(withMap))
