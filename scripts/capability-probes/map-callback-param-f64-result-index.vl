// A `.map` whose callback arrives as a function-typed PARAMETER, with an f64 result, then an
// index read. `collectMapFilterUse` reads a function-value callback's result list off the
// call's recorded `f64[]`, so the f64 list is collected.
// Should print 2.
function dbl(_n: i32): f64 { return 2.0 }
function go(f: (i32) => f64, xs: i32[]): f64 { return xs.map(f)[0] }
print(go(dbl, [1, 2]) as! i32)
