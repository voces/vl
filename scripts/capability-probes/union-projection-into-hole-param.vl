// A value union read out of a PROJECTION (a list element here; a struct field and a map read
// are the same mechanism) and handed to an UN-ANNOTATED parameter. Every channel the
// monomorphizer's pin ladder had asks a BINDING, so a projection reached none of them and the
// union floor returned "": `emitProgram: monomorphize: unsupported argument type for `p` in a
// call to `take`` after `vl check` returned 0. A clause-2 violation by construction.
// Found 2026-09-03 by the day-one sampler (#2478), `--seed 1 --count 400`. Closed by D1516.
// This file must NOT annotate `srcArr` or `take`'s parameter — both are rescues the row
// records, and either would make the probe pass for the wrong reason.
// Should print 3.
type Val = i32 | string

function mkval(): Val { return 3 }

const srcArr = [mkval()]

function take(p) {
  if p is i32 { print(p) } else { print(0) }
}

take(srcArr[0])
