// A read-only covariant list handed to a callee that is a function-typed PARAMETER. The
// covariant-write closure reads a callee's parameter list off the `FuncDecl` in the arena — a
// declared function's, or the lambda a `const` was bound to — and `fn` is neither, so with a
// mutable `Shape[]` the copy's licence was unknown and the emitter refused (D1687). Spelled
// `readonly` through the function type as well, nothing can write through `fn`'s parameter,
// and it runs; only a `readonly` list is covariant (D2161). Should print 1.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function __other() {
  const w: Shape[] = []
  w.push({ s: 3 })
  print(w.length)
}
function apply(fn: (readonly Shape[]) => void, xs: readonly Shape[]) { fn(xs) }
function f() {
  const a: Circle[] = [{ r: 7 }]
  const b: readonly Shape[] = a
  const take = (ys: readonly Shape[]): void => {
    print(ys.length)
  }
  apply(take, b)
}
f()
