// A read-only covariant list handed to a callee that is a function-typed PARAMETER. The
// covariant-write closure reads a callee's parameter list off the `FuncDecl` in the arena — a
// declared function's, or the lambda a `const` was bound to — and `fn` is neither: its value
// is chosen by the caller, so no one parameter list answers for it. `vl check` returns 0 and
// the emitter refuses with `emitProgram: covariant list delivery: a ` … `[] cannot be
// delivered into a ` … `[] here.`; calling the same lambda directly runs, which is what makes
// this a capability gap and not the design's covariant-write rule. Should print 1.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function __other() {
  const w: Shape[] = []
  w.push({ s: 3 })
  print(w.length)
}
function apply(fn: (Shape[]) => void, xs: Shape[]) { fn(xs) }
function f() {
  const a: Circle[] = [{ r: 7 }]
  const b: Shape[] = a
  const take = (ys: Shape[]): void => {
    print(ys.length)
  }
  apply(take, b)
}
f()
