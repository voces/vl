// A CAPTURING lambda used at two argument types. Value-flow monomorphization is
// single-type for a capturing lambda, so the second type can neither call_ref through
// the first instance nor call it by name without dropping the env.
// Should print 7 twice.
function outer() {
  const n = 7
  const f = (v) => {
    return n
  }
  print(f(1))
  print(f("s"))
}
outer()
