// A STRUCT FIELD named `pop`, holding a closure. `vl check` returns 0 — the call is typed against
// the field's own `(i32) => i32` — and the emitter refuses with
// `emitProgram: .pop takes no arguments` (`compiler/wasmEmit.vl:16985`). Should print 2.
//
// MECHANISM. `emitCallNode`'s member dispatch (`wasmEmit.vl:22125`) is
// `if callee.memProp == "pop" { return emitPop(...) }` — keyed on the property NAME with no
// receiver-kind guard, unlike its `map` / `filter` / `keys` / `values` neighbours, which all
// test the receiver first. A struct field named `pop` is therefore routed into the list `.pop`
// lowering, where the arity check fires before the receiver check ever runs.
//
// The sibling shape is `intrinsic-name-as-parameter.vl`: both are the emitter dispatching on a
// NAME the checker let the user bind. The fix is the same shape too — test the receiver (or the
// scope) before the name.
type S = { pop: (i32) => i32 }
function g(n: i32): i32 { return n + 1 }
function main() {
  const s: S = { pop: g }
  print(s.pop(1))
}
main()
