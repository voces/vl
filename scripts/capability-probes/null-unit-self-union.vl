// The annotation `null | null` — the `null` unit type joined with itself. `vl check` accepts it
// (rc 0), but the resolver records `<error> | null`, so emit refuses with
// `emitProgram: bare null needs a struct-typed context` where `x: null` runs (D4673).
// Should print true.
function f(x: null | null) { print(x == null) }
f(null)
