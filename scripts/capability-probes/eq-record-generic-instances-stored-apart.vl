// `==` in a generic body whose type parameters are instantiated at two records of one field set
// stored apart compares the field pairs at the instance (D16397).
// Should print true.
function eq<T, U>(a: T, b: U): boolean { return a == b }
const x: {f: i32} = { f: 1 }
const y: {f: f64} = { f: 1.0 }
print(eq(x, y))
