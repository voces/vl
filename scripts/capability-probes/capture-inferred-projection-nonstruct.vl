// D1476's capture pair at the reps its close did not reach. A binding whose initialiser is a
// PROJECTION commits no rep the syntactic ladder reads, so the capture fell to the i32 default
// and the closure's env field declared an i32 where a box, a niche or a map arrives —
// check-clean invalid wasm, `expected i32, found (ref $type)`.
//
// Annotating the binding fixes every line below, which is what says the missing rung is the
// BINDING's cell; annotating the container does nothing. See D1758.
// Should print 4 then 4 then 4 then 4.
type MaybeN = i32 | null
type Circle = { r: i32 }
type Rect = { w: i32 }
type Shape = Circle | Rect
type VU = i32 | string
type Rec = { n: i32 }
type BoxedMap = { it: { [string]: Rec } }

function mkNul(): MaybeN { return 4 }
function mkShape(): Shape { return { r: 4 } }
function mkVU(): VU { return 4 }
function mkMap(): { [string]: Rec } {
  const m: { [string]: Rec } = Map()
  m["k"] = { n: 4 }
  return m
}
function mkBox(): BoxedMap { return { it: mkMap() } }

function nulScalar() {
  const xs = [mkNul()]
  const held = xs[0]
  const get = () => held
  print(get() ?? 0)
}
function structUnion() {
  const xs = [mkShape()]
  const held = xs[0]
  const get = () => held
  const v = get()
  if v is Circle { print(v.r) } else { print(0) }
}
function valueUnion() {
  const xs = [mkVU()]
  const held = xs[0]
  const get = () => held
  const v = get()
  if v is i32 { print(v) } else { print(0) }
}
nulScalar()
structUnion()
valueUnion()
if true {
  const box = mkBox()
  const held = box.it
  const get = () => held
  print((get()["k"] ?? { n: 0 }).n)
}
