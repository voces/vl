// `__array_new__` with a NULLABLE REFERENCE fill — the shape a length-first array
// constructor exists for: size the table, fill it with a placeholder, write the slots
// later. `vl check` is rc 0 and the module fails to validate, at this spelling and
// through a generic wrapper alike. A value-union fill (`(i32 | string)[]`) is the same
// cell; a bare `null` fill is a loud refusal instead.
// Should print 2.
type Node = { count: i32, symbol: i32 }

function mk(): Node | null { return { count: 1, symbol: 2 } }

const seed: Node | null = mk()
const a: (Node | null)[] = __array_new__(2, seed)
print(a.length)
