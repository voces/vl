// A read-only covariant list inside a container whose CALL RESULT is delivered under no name
// — `mk(b).xs.length` reads straight off the returned literal, so there is no destination the
// escape can be filed under and no handle the write scan could match. `vl check` returns 0
// and the emitter refuses with `emitProgram: covariant list delivery: a ` … `[] cannot be
// delivered into a ` … `[] here.`, clause 2: nothing in this program writes either list, the
// element-converting copy is unobservable, and the copy exists (D791). Binding the same call
// result (`const sf = mk(b)`) runs. Should print 1.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box = { xs: Shape[] }
function __other() {
  const w: Shape[] = []
  w.push({ s: 3 })
  print(w.length)
}
function mk(v: Shape[]): Box { { xs: v } }
function f() {
  const a: Circle[] = [{ r: 7 }]
  const b: Shape[] = a
  print(mk(b).xs.length)
}
f()
