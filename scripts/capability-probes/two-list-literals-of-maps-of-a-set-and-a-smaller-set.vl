// Two list literals of maps of un-annotated functions, each of a set and a smaller set, in one
// program (D15394). `vl check` returns 0 and the
// emitter refuses it: `emitProgram: ref valtype with no interned shape`.
// Should print 4 then 6.

function half(a) { return a / 2.0 }
function dbl(a) { return a * 2 }
function inc0(a) { return a + 1 }
const m1 = Map()
m1.set("a", half)
const fnMap = Map()
fnMap.set("a", inc0)
fnMap.set("b", half)
const xs = [fnMap, m1]
const m4 = Map()
m4.set("a", half)
const m3 = Map()
m3.set("a", dbl)
m3.set("b", half)
const ys = [m3, m4]
const g = xs[0].get("a")
if g != null { print(g(3)) }
const d = ys[0].get("a")
if d != null { print(d(3)) }
