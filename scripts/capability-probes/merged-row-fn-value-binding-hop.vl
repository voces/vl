// A function whose param/return ROWS a `??` merge moved, handed over as a VALUE through a
// BINDING rather than by name. `vl check` returns 0 and the module does not load — a clause-1
// row, kept here for the same reason `hole-param-closure-field-call.vl` is: the probe runner is
// the standing instrument for "the type system accepts it and codegen does not build it".
//
// D940 closed the bare-name ARGUMENT position (`apply(src)`), which is the one the emitted
// `$fnsig` key can be redirected for. Every other delivery of the same value is still broken —
// this binding hop, a wrapping lambda, a struct field, an array element, and a slot fed two
// different functions. See D1043 for the nine-row position matrix.
// Should print 1 then 7.
function src(p: {r: i32}): {r: i32} | null { p }

function apply(cb: ({r: i32}) => {r: i32} | null) {
  const _v = cb({ r: 9 })
  1
}

function rd() {
  const h = src
  print(apply(h))
  const g1 = src({ r: 7 }) ?? { r: "s" }
  print(g1.r)
}

rd()
