// An un-annotated function taken as a value where no read resolves it to one function, a record
// chosen at run time handed through a generic identity, is instanced at the signature the calls
// through its place class agree on (D16842).
// Should print 4.
function inc0(a) { return a + 1 }
function inc1(a) { return a + 2 }
function id(x) { return x }
const n = 3
const r = id(if n > 2 { { f: inc0 } } else { { f: inc1 } })
print(r.f(3))
