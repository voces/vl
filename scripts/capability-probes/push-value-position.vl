// `.push` DELIVERED AS A VALUE — the `i32` new length the checker has always typed it.
// Should print 2 then 3 then 1 then 0.
//
// silent-class inventory D1301 / D1592. The checker's array-method arm returns `TY_I32` for
// `push`, so `const w: i32 = xs.push(2)` is `vl check` rc 0 and `const w: string = …` is
// `cannot assign i32 to 'w' of type string` — the value is owed. `emitPush` left an EMPTY
// stack and `emitCallNode` had no `push` rung, which split into two outcomes by position:
//
//   const w = xs.push(2)               ->  emitProgram: callee is not a function name
//   function f() { xs.push(1) }        ->  check-clean INVALID WASM: the tail is the
//   const v = f()                          function's result, `.push` was the one name
//                                          `memberCallYieldsValue` excluded, so the emitter
//                                          typed `f` `(func)` while the caller emitted
//                                          `local.set` after the `call`
//
// The last block is D1280's shape, reachable here with two pushes rather than a push and a
// pop: both receivers are module GLOBALS, so both stage into the frame's one `recvRef` slot
// and the inner op used to overwrite the outer's receiver — `n1` stayed empty while `n2`
// took both appends.

const xs: i32[] = [1]
const w = xs.push(2)
print(w)

function bump(ys: i32[]) { ys.push(3) }
const v = bump([1, 2])
print(v)

const n1: i32[] = []
const n2 = [1]
n1.push(n2.push(7))
print(n1.length)
print(n1[0] - n2.length)
