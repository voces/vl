// `==` over two lists whose element is a nullable record: pair by pair, two nulls equal, a
// null and a record unequal, two records field-wise. The checker refused it as having no
// lowering while `P[]` compared.
// Should print: true false
type P = { x: i32 }
const a: (P | null)[] = [{ x: 1 }, null]
const b: (P | null)[] = [{ x: 1 }, null]
const c: (P | null)[] = [{ x: 1 }, { x: 1 }]
print(a == b)
print(a == c)
