// D14401 — an un-annotated Map holding a generic used at two instances gets no value slot,
// although the checker stamps both deliveries
// The IR refuses it as `cannot yet lower this statement (map store value type...)`; the literal
// is `map store value type`.
// Should print 4.
function id<T>(x: T): T { return x }
function runAll<U>(a: ((x: U) => U)[], u: U): U { return a[0](u) }
const mp = Map()
mp["k"] = id
const mpv = mp["k"]
if mpv != null {
  const p = mpv
  print(runAll([p], 2) + runAll([p], "ab").length)
}
