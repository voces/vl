// An else-less TAIL `if c { x = 5 }` whose assigned cell is a value-union BOX. `vl check`
// returns 0 at both seeds; the emitted module did not validate, inside the function itself.
//
// THE VALUE OF AN ASSIGNMENT IS ITS TARGET CELL. An else-less tail `if` is a valued return
// and `fnAssignRetKind` already gives the functype the CELL's kind — the box — but
// `exprUnion` had no arm for an assignment node, so `emitUnionCoerce` read the store-then-
// re-read as an unclassified scalar and `struct.new`'d the box into an i32 payload field.
//
// D1589. The annotated cell is the witness; the un-annotated `let x = null` twin reaches the
// same arm through D1576's filled hole.
// Should print 5.
function mk(c: boolean) {
  let x: i32 | null = null
  if c { x = 5 }
}
print(mk(true) ?? 0)
