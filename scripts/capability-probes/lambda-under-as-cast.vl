// A LAMBDA anywhere underneath an `as` cast is never lifted. `vl check` returns 0 and the
// emitter refuses with `emitProgram: function literal not lifted`
// (`compiler/wasmEmit.vl:12891`). Should print 1.
//
// MECHANISM. `liftFnsInExpr` (`emit_collect.vl:3299-3355`) walks Block, LetDecl, RetStmt, If,
// While, ForRange, ForIn, Call, BinExpr, Unary, Paren, Member, Index, ObjLit and ArrayLit — and
// has NO `AsExpr` arm. A function literal in a subtree under `as` is therefore never pushed to
// `fnStmts`, so `fnStmtsPosOf` answers -1 at emit time.
//
// THE CAST IS SCENERY TO THE VALUE AND LOAD-BEARING TO THE WALK: delete `as f64` and the same
// call compiles and runs. This is a missing visitor arm, one node kind wide.
function pick(f: (i32) => i32): i32 { return f(1) }
const v = pick((n: i32) => {
  return n
}) as f64
print(v)
