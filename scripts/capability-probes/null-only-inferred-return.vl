// D1567 — an UN-ANNOTATED function whose every returned value is a bare `null`. The checker
// types that return `TyPrim:null` — the `null` TYPE itself, not a nullable of anything — so
// every producer in the inferred-return recorder declined, `fRetKind` kept its `"i32"`
// default, and the body's own `null` reached `emitNullLitNode` with no seed at all:
// `emitProgram: bare null needs a struct-typed context` after a clean `vl check`, at every
// delivery position and against every nullable destination.
//
// Left LOUD by D1563 (#2497): before it, the leaked `pendingVariantIdx` papered this over
// with the WRONG heap type wherever an arm-typed global happened to have armed it.
//
// The rep is `nullref` (`(ref null none)`), the bottom of the GC hierarchy: one value, and a
// subtype of every nullable REF valtype, so one result serves the struct destination here
// with no coercion. The i32-repped nullables (`boolean | null`, `K | null`, the value-union
// box) are not its subtypes and are converted at the call.
// Should print none then 4.
type C = { a: i32, b: i32 }

function np() { return null }

function some(): C | null { return { a: 4, b: 5 } }

const v: C | null = np()
if v != null { print(v.a) } else { print("none") }

const v2: C | null = some()
if v2 != null { print(v2.a) } else { print("none") }
