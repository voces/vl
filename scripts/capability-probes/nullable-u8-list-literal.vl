// A `u8[] | null` cell initialised from an ARRAY LITERAL. `vl check` returns 0; the cell is
// typed as the packed-byte wrapper and the value is built as the shared i32 list, so the
// module does not load. The non-null spelling `const g: u8[] = [5, 6]` RUNS — the same
// decision made correctly one annotation away. See D983.
// Should print 8.
const g: u8[] | null = [7, 8]

if g is u8[] { print(g[1]) }
