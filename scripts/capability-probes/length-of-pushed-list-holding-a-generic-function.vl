// `.length` on a list of a generic function, built, pushed and read inside an un-annotated
// parameter's instance: the pushed slot holds the parameter's set id, and each call through an
// element instances the generic at its own arguments (D15529).
// Should print 2 then 5.
function id<T>(x: T): T { x }
function use(ys) { print(ys.length) }
function take(a) {
  const xs = [a]
  xs.push(a)
  use(xs)
  print(xs[0]("abc").length + xs[0](2))
}
take(id)
