// `.length` on a list of a generic function, built, pushed and read inside an un-annotated
// parameter's instance. `vl check` returns 0 and the emitter refuses with `emitProgram: '.length' on a
// receiver the emitter cannot classify as a list, string, map or set` (D15529). It replaced D15010's
// unpushed witness, which runs, as live-sites.json's row.
// Should print 2 then 5.
function id<T>(x: T): T { x }
function use(ys) { print(ys.length) }
function take(a) {
  const xs = [a]
  xs.push(a)
  use(xs)
  print(xs[0]("abc").length + xs[0](2))
}
take(id)
