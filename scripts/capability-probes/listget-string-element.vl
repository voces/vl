// A `xs.get(i) ?? d` over a `string[]`, in a module that also has an i32 list. `.get`'s four
// element-kind descriptors fell through to the i32 list's answer, so the read was emitted at
// the i32 wrapper and backing: `vl check` rc 0 and an invalid module. Without the i32 list the
// same hole is a refusal instead, `emitProgram: .get but list type not collected` — one gap,
// two faces, and the collected-ness guard it lands on is the i32 list's `lUsed` flag.
// Should print 1 then b.
const nums = [1, 2]
print(nums[0])
const ys: string[] = ["a", "b"]
print(ys.get(1) ?? "z")
