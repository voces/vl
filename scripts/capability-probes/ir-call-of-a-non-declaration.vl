// D16291 — an un-annotated lambda literal written as a function's return value cannot infer its
// parameter, while the same lambda bound to a `const` and returned runs
// The IR refuses it as `cannot yet lower this statement (call of a non-declaration...)`; the
// literal is `call of a non-declaration`.
// Should print 11.
function compose(f, g) { return (x) => f(g(x)) }
const inc = (n: i32): i32 => n + 1
const dbl = (n: i32): i32 => n * 2
const k = compose(inc, dbl)
print(k(5))
