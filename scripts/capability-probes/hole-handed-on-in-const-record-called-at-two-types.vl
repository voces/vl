// A hole parameter its function never calls, handed on in a `const` record literal to a callee
// that calls the field at two types (D15700). `vl check` returns 0 and the emitter refuses the
// handed function: `emitProgram: a generic function taken as a value reaches no call that fixes
// its type — annotate the destination's function type`. The literal handed straight runs (D15649).
// Should print 2 then 5.
function dbl(v) { return v + v }
function call0(r, x) {
  print(r.f(1))
  print(r.f(x))
}
function both(g) {
  const r = { f: g }
  call0(r, 2.5)
}
both(dbl)
