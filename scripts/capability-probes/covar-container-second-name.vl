// A covariant list delivered into a struct field whose container is then bound to a SECOND
// name and written through it. `vl check` returns 0 — the covariant-write closure files the
// escaped value under the container's own name, so a second handle hides the write and the
// answer stays unknown — and the emitter refuses with `emitProgram: covariant list delivery:
// a ` … `[] cannot be delivered into a ` … `[] here.`, clause 2: the copy exists (D791) and
// the analysis cannot tell whether this program is one it may be made in. Writing
// `sf.xs.push` instead of `sf2.xs.push` is the same program the analysis does follow, and it
// is a loud check reject. Should print 2.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box = { xs: Shape[] }
function f() {
  const a: Circle[] = [{ r: 7 }]
  const b: Shape[] = a
  const sf: Box = { xs: b }
  const sf2 = sf
  sf2.xs.push({ s: 3 })
  print(a.length)
}
f()
