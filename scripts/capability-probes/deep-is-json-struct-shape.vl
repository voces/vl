// DEEP `is` WITH A STRUCT ON THE RIGHT — the half of D1035 that was LOUD rather than
// silent: `r is Cfg` over a `Json` was refused as ``'Cfg' is not a variant of Json``,
// because a struct is not one of the union's arms. It is not supposed to be: the design
// rules a JSON-SHAPE target a runtime shape walk, so the arm binds a real `Cfg` built out
// of the map. This probe also carries S2 (the JSON number `8080` matches `i32` because it
// is integral and in range — the same predicate `as? i32` applies) and S3 (the ABSENT
// `host` key matches `string | null` as `null`, the owner's 2026-09-02 ruling).
// Should print 8081 then true.
type Json = null | boolean | f64 | string | Json[] | { [string]: Json }
type Cfg = { port: i32, host: string | null }

const m: { [string]: Json } = Map()
m["port"] = 8080.0
const j: Json = m

if j is Cfg {
  print(j.port + 1)
  print(j.host == null)
} else {
  print(-1)
  print(false)
}
