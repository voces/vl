// The SILENT half of the width-subtyping gap. The direct case (see width-subtyping.vl) is a
// loud check reject; nest the pair one level and the same refusal does not fire —
// `objShapeAdapterless` returns adapterless without recursing once `objFieldNameSetsEq`
// answers, so the checker accepts and the engine refuses the module.
// This one is a clause-1 violation, not just a clause-2 one, and the corpus has no cell for it.
// Should print 1.
type Wide = { a: i32, b: i32 }
type Narrow = { a: i32 }
type OW = { n: Wide }
type ON = { n: Narrow }
function take(o: ON): i32 { return (o.n).a }
const w: OW = { n: { a: 1, b: 2 } }
print(take(w))
