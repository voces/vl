// D15445: a `const` list literal of a hole parameter (the reference twin of the record template), called
// through the holder at one type, at two types, and beside a direct call of the parameter, in a
// hole body and an annotated generic body. Every cell prints `15`, then `9`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __same<T>(k: T): T { k }
function __atOne(a) {
  const r = [a]
  return r[0](4)
}
function __atTwo(a) {
  const r = [a]
  const s: string = r[0]("v")
  return r[0](3) + s.length
}
function __atBoth(a) {
  const r = [a]
  return r[0]("vv").length + a(5)
}
function __typed<G>(a: G) {
  const r = [a]
  const s: string = r[0]("abc")
  return r[0](6) + s.length
}
// @@VALUE@@
__atOne(__same) + __atTwo(__same) + __atBoth(__same)
// @@TYPE@@
i32
// @@PROOF@@
print(v)
// @@WANT@@
15
// @@TEST@@
v == 15
// @@HIT@@
print(v)
// @@MISS@@
print(0)
// @@VALUE2@@
__typed(__same)
// @@TYPE2@@
i32
// @@PROOF2@@
print(v)
// @@WANT2@@
9
