// The generic twin of fn-value-lambda-map-param-by-context: the context-typed map parameter is
// handed to a generic whose value type stays open until that parameter binds it (D9990).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __sz<V>(k: {[string]: V}): i32 { k.length }
function __mk(): {[string]: i32} {
  const m: {[string]: i32} = Map()
  m.set("a", 41)
  m
}
// @@VALUE@@
(k) => __sz(k) + 41
// @@TYPE@@
(k: {[string]: i32}) => i32
// @@PROOF@@
print(v(__mk()))
// @@WANT@@
42
