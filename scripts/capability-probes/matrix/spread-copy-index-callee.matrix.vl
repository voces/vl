// A list a generic function was pushed into, spread into a copy, and called through that copy's
// element: `ys[0](2)`. The instance runs a copy of the index read as its own statement before the
// call, which answers the read's type. Each cell delivers the call's result to one position, at a
// closure, scalar, string or record result, and a module-scope copy reads the same.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type P = { n: i32 }
function id<T>(x: T): T { return x }
function pass<T>(x: T): T { return x }
// @@VALUE@@
id(5)
// @@TYPE@@
i32
// @@PROOF@@
print(v)
// @@WANT@@
5
// @@CELL_i32_return@@
// want: 2
function f(): i32 {
  const xs = []
  xs.push(id)
  const ys = [...xs]
  return ys[0](2)
}
print(f())
// @@CELL_f64_let@@
// want: 2.5
function f() {
  const xs = []
  xs.push(id)
  const ys = [...xs]
  const r = ys[0](2.5)
  print(r)
}
f()
// @@CELL_i64_argument@@
// want: 7
function f() {
  const xs = []
  xs.push(id)
  const ys = [...xs]
  print(pass(ys[0](7 as i64)))
}
f()
// @@CELL_string_concat@@
// want: s!
function f() {
  const xs = []
  xs.push(id)
  const ys = [...xs]
  print(ys[0]("s") + "!")
}
f()
// @@CELL_string_interp@@
// want: <s>
function f() {
  const xs = []
  xs.push(id)
  const ys = [...xs]
  print("<\{ys[0]("s")}>")
}
f()
// @@CELL_boolean_if_arm@@
// want: yes
function f() {
  const xs = []
  xs.push(id)
  const ys = [...xs]
  print(if ys[0](true) { "yes" } else { "no" })
}
f()
// @@CELL_record_field@@
// want: 4
function f() {
  const xs = []
  xs.push(id)
  const ys = [...xs]
  const p: P = { n: 4 }
  print(ys[0](p).n)
}
f()
// @@CELL_closure_result@@
// want: 11
function f() {
  const xs = []
  xs.push(id)
  const ys = [...xs]
  const g = (k: i32) => k + 10
  print(ys[0](g)(1))
}
f()
// @@CELL_module_scope@@
// want: 2
const mxs = []
mxs.push(id)
const mys = [...mxs]
print(mys[0](2))
// @@CELL_called_at_two_types@@
// want: 2 then s
function f() {
  const xs = []
  xs.push(id)
  const ys = [...xs]
  print(ys[0](2))
  print(ys[0]("s"))
}
f()
