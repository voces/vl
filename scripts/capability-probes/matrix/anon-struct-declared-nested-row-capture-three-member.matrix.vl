// D1694's three-member axis, and its other outcome: where the two-member template's nested
// capture prints a wrong value, a three-member one whose sets differ in a REF member traps at
// run time instead. Same ingredient, so the two templates must move together.
//
// The value boxes `i32 | boolean | string` and holds the i32 `7`; `Inner`'s box is
// `string | boolean | i64`, and reading the payload at the wrong tag is a cast failure rather
// than a mis-read scalar. Graded by PRINTED VALUE, like its two-member sibling.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type U3 = i32 | boolean | string
type U5 = string | boolean | i64
type Inner = { xs: U5 }
type H = { f: Inner }
function u3(): U3 { return 7 }
function u3b(): U3 { return 8 }
// @@VALUE@@
{ f: { xs: u3() } }
// @@TYPE@@
{ f: { xs: U3 } }
// @@PROOF@@
print(v.f.xs)
// @@WANT@@
7
// @@VALUE2@@
{ f: { xs: u3b() } }
// @@TYPE2@@
{ f: { xs: U3 } }
// @@PROOF2@@
print(v.f.xs)
// @@WANT2@@
8
// @@SKIP@@
is_in_if: the value is a struct, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
