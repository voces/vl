// D2690 — a nullable-ref map value stores as its non-null twin does, so the two maps are one
// struct; each owns its box tag. The test names the map the value is NOT, so a shared tag
// answers `wrong`; the proof reads, counts, walks and deletes through the narrowed map.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type Circle = { r: i32 }
type Sq = { s: i32 }
function mkc(): Circle | Sq { { r: 3 } }
function mks(): Circle | Sq { { s: 4 } }
function mkin(n: i32): {[string]: i32} {
  const m: {[string]: i32} = Map()
  m["q"] = n
  if n > 1 { m["r"] = n }
  m
}
function mka(): {[string]: string} {
  const m: {[string]: string} = Map()
  m.set("a", "x")
  m
}
function mkb(): {[string]: string | null} {
  const m: {[string]: string | null} = Map()
  m.set("a", "y")
  m.set("b", null)
  m
}
function pick(n: i32): {[string]: string} | {[string]: string | null} {
  if n > 0 { return mkb() }
  return mka()
}
// @@VALUE@@
pick(1)
// @@TYPE@@
{[string]: string} | {[string]: string | null}
// @@TEST@@
v is {[string]: string}
// @@HIT@@
print("wrong")
// @@MISS@@
if v is {[string]: string | null} {
print(v.length)
print(v.has("b"))
const x = v["a"]
if x != null { print(x) } else { print("null") }
let c = 0
for kk in v { c = c + 1 }
print(c)
v.delete("b")
print(v.has("b"))
} else { print("miss2") }
// @@WANT@@
2 then true then y then 2 then false
// @@VALUE2@@
pick(0)
// @@TYPE2@@
{[string]: string} | {[string]: string | null}
// @@PROOF2@@
if v is {[string]: string | null} { print("wrong") } else if v is {[string]: string} {
  print(v.length)
  const x = v["a"]
  if x != null { print(x) } else { print("null") }
} else { print("wrong") }
// @@WANT2@@
1 then x
