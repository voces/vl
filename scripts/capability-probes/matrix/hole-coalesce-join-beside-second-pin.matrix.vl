// D9913: a `??` over an un-annotated parameter pinned at `i64 | null`, with a float default, is
// the join `i64 | f64` inside the body though the function is also called at a never-null `f64`.
// The proof is true only when the default's `0.5` reached the sum.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __cwTake(a) {
  const r = a ?? 0.5
  const s = r + 1
  return s < 2
}
const __cwNul: i64 | null = null
const __cwOther = __cwTake(4.0)
// @@VALUE@@
__cwTake(__cwNul)
// @@TYPE@@
boolean
// @@TEST@@
v
// @@HIT@@
print("default")
// @@MISS@@
print("miss")
// @@WANT@@
default
