// A list-literal spread of a literal-union list alone into a `string[]` (D2868's repro
// shape): each atom is re-encoded as its string. The un-annotated face is a `Kx[]` copy.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type Kx = "x" | "y"
const src: Kx[] = ["x", "y"]
// @@VALUE@@
[...src]
// @@TYPE@@
string[]
// @@PROOF@@
print("\{v[0]}\{v[1]}\{v.length}")
// @@WANT@@
xy2
// @@SKIP@@
is_in_if: the value is a list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
