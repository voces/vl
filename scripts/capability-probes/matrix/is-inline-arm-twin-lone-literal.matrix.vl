// `is` between inline arms that differ only in a lone-literal field: both rows soften the
// literal to its base, so the arms share a layout and the test must compare the literal
// itself. The value is the `"b"` arm tested as `"a"`, so a test that only checks the layout
// prints the wrong branch; the second instance reads the field the narrowing names (D5157).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type N = { tag: "a", v: i32 } | { tag: "b", v: i32 }
function mk(a: boolean): N {
  if a { return { tag: "a", v: 7 } }
  { tag: "b", v: 8 }
}
// @@VALUE@@
mk(false)
// @@TYPE@@
N
// @@TEST@@
v is { tag: "a", v: i32 }
// @@HIT@@
print("a")
// @@MISS@@
print("other")
// @@WANT@@
other
// @@VALUE2@@
mk(true)
// @@TYPE2@@
N
// @@PROOF2@@
if v is { tag: "a", v: i32 } { print(100 + v.v) } else { print(v.v) }
// @@WANT2@@
107
