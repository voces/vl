// D1561's CLAUSE-1 FACE — the same delivery as `coalesce-declared-union-shared-read`, read
// through `is` instead of the shared discriminant. That one difference moved the cell from a
// loud emit refusal to `vl check`-clean INVALID WASM (`expected i32, found (ref $type)`), so
// the two reads need separate cells: a fix graded on the loud face alone cannot see the silent
// one, and `matrix.py` blocks on any SILENT in the after column.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type Circle = { kind: "circle", r: f64 }
type Rect = { kind: "rect", w: f64, h: f64 }
type Shape = Circle | Rect
function mkval(): Shape { return { kind: "rect", w: 2.0, h: 3.0 } }
function passh(x) { return x }
// @@SETUP@@
const srcOpt: Shape | null = passh(mkval())
// @@VALUE@@
(srcOpt ?? { kind: "circle", r: 1.0 })
// @@TYPE@@
Shape
// @@TEST@@
v is Rect
// @@HIT@@
print(v.w)
// @@MISS@@
print(0)
// @@WANT@@
2
