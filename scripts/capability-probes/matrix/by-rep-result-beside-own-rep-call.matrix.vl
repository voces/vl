// D15125: an element of a list whose records are built at a wider record J, handed back by a
// hole identity that is also called at its own storage, delivered at its own type.
// @@PRELUDE@@
type J = { f: i32 | null }
function mk() { { f: 4 } }
function back(r) { return r }
const wideJ: J = mk()
const jxs = [mk()]
const plain = { f: 5 }
if back(plain).f != 5 { print(0) }
// @@VALUE@@
back(jxs[0])
// @@TYPE@@
{ f: i32 }
// @@WANT@@
4
// @@PROOF@@
print(v.f)
// @@TEST@@
v.f == 4
// @@HIT@@
print(4)
// @@MISS@@
print(0)
