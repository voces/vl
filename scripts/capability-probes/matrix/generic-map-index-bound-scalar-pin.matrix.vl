// D10292's index sibling: a generic's un-annotated `const x = m[k]`, printed in the generic and
// handed back, at `V = f64` and `V = boolean`; the map itself is the value delivered.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __bi<V>(m: Map<string, V>, k: string) {
  const x = m[k]
  print(x)
  x
}
const __biF: Map<string, f64> = Map()
__biF.set("k", 1.5)
const __biB: Map<string, boolean> = Map()
__biB.set("k", true)
// @@VALUE@@
__biF
// @@TYPE@@
Map<string, f64>
// @@PROOF@@
__bi(v, "z")
__bi(v, "k")
// @@WANT@@
null then 1.5
// @@VALUE2@@
__biB
// @@TYPE2@@
Map<string, boolean>
// @@PROOF2@@
__bi(v, "z")
__bi(v, "k")
// @@WANT2@@
null then true
