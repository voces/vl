// D3155 — a scalar-valued map read whose receiver is typed at a hole's pin: a miss is `null`,
// which an `i32` map has no spare value for, so the read and a binding of it take the value
// box the direct spelling builds. The un-annotated argument cell read the raw `0`.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type H = { m: {[i32]: i32}, f: {[i32]: f64} }
function mkH(k: i32, x: i32): H {
  const m: {[i32]: i32} = Map()
  m[k] = x
  const f: {[i32]: f64} = Map()
  f[k] = 1.5
  { m: m, f: f }
}
// @@VALUE@@
mkH(3, 7)
// @@TYPE@@
H
// @@PROOF@@
const x = v.m[9]
const y = v.f[9]
print(x)
print(y)
print(v.m[3] ?? 0)
// @@WANT@@
null then null then 7
// @@VALUE2@@
mkH(4, 8)
// @@TYPE2@@
H
// @@PROOF2@@
const x = v.m[4]
if x == null { print("none") } else { print(x) }
// @@WANT2@@
8
// @@SKIP@@
is_in_if: the value is a record, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
