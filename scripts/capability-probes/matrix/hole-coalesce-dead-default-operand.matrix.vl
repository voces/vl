// D9870: a `??` over an un-annotated parameter pinned at a never-null `i64`, bound and then
// operated on, is the `i64 | f64` the checker types the call at. The proof narrows it to `i64`
// and computes with it.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __cdTake(a) {
  const r2 = a ?? 0.5
  return r2 + 1
}
const __cdPin: i64 = 4
// @@VALUE@@
__cdTake(__cdPin)
// @@TYPE@@
i64 | f64
// @@TEST@@
v is i64
// @@HIT@@
print(v * 2)
// @@MISS@@
print("miss")
// @@WANT@@
10
