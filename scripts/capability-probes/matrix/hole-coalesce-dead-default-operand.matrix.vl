// D9870: a `??` over an un-annotated parameter pinned at a never-null `i64`, bound and then
// operated on, is an `i64`: the default is dead whatever its width. The proof divides, which
// prints `2` at `i64` and would print `2.5` at `f64`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __cdTake(a) {
  const r2 = a ?? 0.5
  return r2 + 1
}
const __cdPin: i64 = 4
// @@VALUE@@
__cdTake(__cdPin)
// @@TYPE@@
i64
// @@TEST@@
v > 0
// @@HIT@@
print(v / 2)
// @@MISS@@
print("miss")
// @@WANT@@
2
