// D3140 — the `K | null` niche delivered into a `K | null | i32` box: the sentinel takes the
// null tag and any other id its member string. From the #3287 review; its `array_element*`
// cells also pin a union-list literal of niche values boxing into its destination.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type K = "ka" | "kb"
function kn(b: boolean): K | null {
  if b { return "kb" }
  return null
}
// @@VALUE@@
kn(false)
// @@TYPE@@
K | null | i32
// @@TEST@@
v == null
// @@HIT@@
print("N")
// @@MISS@@
print("other")
// @@WANT@@
N
// @@VALUE2@@
kn(true)
// @@TYPE2@@
K | null | i32
// @@PROOF2@@
if v is K { print(v) } else { print("other") }
// @@WANT2@@
kb
