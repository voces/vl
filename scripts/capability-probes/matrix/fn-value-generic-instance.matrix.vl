// D3112: a generic function named as a value, delivered to a concrete function type. It is
// instantiated at that type in every position, not only at a plain annotated binding. The
// un-annotated face leaves the generic uninstantiated.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function show<T>(x: T) { print(x * 3) }
function show2<T>(x: T) { print(x * 5) }
// @@VALUE@@
show
// @@TYPE@@
(i32) => void
// @@PROOF@@
v(2)
// @@WANT@@
6
// @@VALUE2@@
show2
// @@TYPE2@@
(i32) => void
// @@PROOF2@@
v(2)
// @@WANT2@@
10
// @@SKIP@@
is_in_if: the value is a function, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
