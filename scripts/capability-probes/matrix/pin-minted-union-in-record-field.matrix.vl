// D2681: a record annotation in a generic body whose field is a union the pin mints
// (`{ v: V | IM }` at `V := string`). The record exists only at the instance, so its row and its
// field's box row are registered there; the field read is delivered to every position.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type IM = {[i32]: i32}
type R = { r: i32 }
function g<V>(x: IM): V | IM {
  const b: { v: V | IM } = { v: x }
  return b.v
}
function seeded(): IM {
  const m: IM = Map()
  m[1] = 11
  return m
}
// @@VALUE@@
g<string>(seeded())
// @@TYPE@@
string | IM
// @@TEST@@
v is IM
// @@HIT@@
print(v[1] ?? -1)
// @@MISS@@
print("miss")
// @@WANT@@
11
// @@CELL_is_in_body@@
// want: true
function h<V>(x: IM) {
  const b: { v: V | IM } = { v: x }
  return b.v is IM
}
print(h<string>(seeded()))
// @@CELL_inferred_type_arg@@
// want: true
function h<V>(y: V, x: IM) {
  const b: { v: V | IM } = { v: x }
  return b.v is IM
}
print(h("s", seeded()))
// @@CELL_record_member@@
// want: 3
function h<V>(x: R): V | R {
  const b: { v: V | R } = { v: x }
  return b.v
}
const v = h<string>({ r: 3 })
if v is R { print(v.r) } else { print("miss") }
// @@CELL_two_pins@@
// want: true then true
function h<V>(x: IM) {
  const b: { v: V | IM } = { v: x }
  return b.v is IM
}
print(h<string>(seeded()))
print(h<boolean>(seeded()))
// @@CELL_other_member_stored@@
// want: s
function h<V>(y: V, x: IM): V | IM {
  const b: { v: V | IM } = { v: y }
  return b.v
}
const v = h("s", seeded())
if v is IM { print("miss") } else { print(v) }
// @@CELL_two_fields@@
// want: 11 then 2
function h<V>(x: IM) {
  const b: { v: V | IM, n: i32 } = { v: x, n: 2 }
  if b.v is IM { print(b.v[1] ?? -1) }
  return b.n
}
print(h<string>(seeded()))
// @@CELL_nested_record@@
// want: true
function h<V>(x: IM) {
  const b: { o: { v: V | IM } } = { o: { v: x } }
  return b.o.v is IM
}
print(h<string>(seeded()))
// @@CELL_nullable_field@@
// want: true
function h<V>(x: IM) {
  const b: { v: V | IM | null } = { v: x }
  return b.v is IM
}
print(h<string>(seeded()))
// @@CELL_list_field@@
// want: true
function h<V>(x: IM) {
  const b: { v: (V | IM)[] } = { v: [x] }
  return b.v[0] is IM
}
print(h<string>(seeded()))
// @@CELL_record_param@@
// want: true
function h<V>(b: { v: V | IM }) {
  return b.v is IM
}
print(h<string>({ v: seeded() }))
// @@CELL_list_field_unread@@
// want: 0
function h<V>(x: IM) {
  const b: { v: (V | IM)[] } = { v: [x] }
  return 0
}
print(h<string>(seeded()))
// @@CELL_nested_list_field_unread@@
// want: 0
function h<V>(x: IM) {
  const b: { o: { v: (V | IM)[] } } = { o: { v: [x] } }
  return 0
}
print(h<string>(seeded()))
