// D16939 — record arms stored alike that differ only in a literal set below the top level: the
// value's own row and its nested fields decide `is`, whichever arm the union names first.
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type A = { v: { x: 1 | 2 } }
type C = { v: { x: 3 | 4 } }
function pick(a: boolean): C | A {
  if a {
    const x: A = { v: { x: 1 } }
    return x
  }
  const c: C = { v: { x: 4 } }
  return c
}
// @@SETUP@@
const cval: C = { v: { x: 4 } }
// @@VALUE@@
cval
// @@TYPE@@
C | A
// @@TEST@@
v is C
// @@HIT@@
print("C")
// @@MISS@@
print("A")
// @@WANT@@
C
// @@VALUE2@@
pick(true)
// @@TYPE2@@
C | A
// @@PROOF2@@
if v is C { print("C") } else { print("A") }
// @@WANT2@@
A
