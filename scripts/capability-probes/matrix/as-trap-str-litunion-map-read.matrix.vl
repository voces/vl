// D11220's string twin — `m[k] as! K` over a map whose values are a string literal union. `K`
// is one interned atom, so an un-annotated destination takes the atom and prints the member.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type K = "a" | "b"
const m: {[string]: K} = Map()
m["q"] = "b"
m["r"] = "a"
// @@VALUE@@
m["q"] as! K
// @@TYPE@@
K
// @@TEST@@
v == "b"
// @@HIT@@
print(v + "!")
// @@MISS@@
print("miss")
// @@WANT@@
b!
// @@VALUE2@@
m["r"] as! K
// @@TYPE2@@
K
// @@PROOF2@@
print(v + "?")
// @@WANT2@@
a?
