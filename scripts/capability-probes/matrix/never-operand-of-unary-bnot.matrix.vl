// D17067 — unary `~` over a call that never returns, in a function whose other path returns a
// `i32`. Binary operators take `never` as a bottom (D14420); unary `-` and `~` refused it at
// check. The value is the live path's, so the delivery is plain and the cells grade the body.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function fail(): never { __trap__() }
function un(c: boolean, x: i32) {
  if c { return x }
  return ~fail()
}
// @@VALUE@@
un(true, 5)
// @@TYPE@@
i32
// @@FALLBACK@@
un(true, 5)
// @@TEST@@
v > 4
// @@HIT@@
print(v)
// @@MISS@@
print(9)
// @@WANT@@
5
