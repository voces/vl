// D3975: a reassigned function binding called at two argument types holds one instantiation
// per type, and a delivery to a position stores the instantiation at the position's type by
// value. The value is the binding itself, never annotated; the annotated face annotates only
// the destination.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __id<T>(x: T): T { return x }
function __k<T>(x: T): T { return x }
// @@SETUP@@
let __f = __id
__f = __k
const __s = __f("s")
const __n = __f(1)
// @@VALUE@@
__f
// @@TYPE@@
(x: i32) => i32
// @@PROOF@@
print(v(41))
// @@WANT@@
41
// @@TEST@@
v(0) == 0
// @@HIT@@
print(v(41))
// @@MISS@@
print(0)
