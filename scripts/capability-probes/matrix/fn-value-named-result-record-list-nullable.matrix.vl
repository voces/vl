// D9781: a named function returning a list of a declared record, delivered where a function
// returning `R[] | null` is expected. Every position must hand the call an adapter that widens
// the result.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type R = {x: i32}
function n(x: i32): R[] { return [{x: x}, {x: x + 1}] }
function m(x: i32): R[] { return [{x: x * 10}] }
// @@VALUE@@
n
// @@TYPE@@
(x: i32) => R[] | null
// @@PROOF@@
const r = v(7)
if r != null { print(r[0].x + r[1].x) } else { print(0) }
// @@WANT@@
15
// @@VALUE2@@
m
// @@TYPE2@@
(x: i32) => R[] | null
// @@PROOF2@@
const r2 = v(7)
if r2 != null { print(r2[0].x) } else { print(0) }
// @@WANT2@@
70
