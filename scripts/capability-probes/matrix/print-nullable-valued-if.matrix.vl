// A `print` of a `string | null` whose argument is a valued `if`: legacy opens the print's blocks
// before the `if` (`RPrintOpen`). The PROOF is that print over the delivered value, so every
// built-in position places it in another context; the cells vary the statement's own context and
// what the arms join, each printing a set value and `null`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type K = "a" | "b"
function pick(s: string): string | null { return if s == "" { null } else { s } }
function flag(): boolean { return true }
// @@VALUE@@
pick("x")
// @@TYPE@@
string | null
// @@PROOF@@
print(if flag() { v } else { null })
// @@WANT@@
x
// @@CELL_loop_body@@
// want: x then null
for c in [true, false] { print(if c { pick("x") } else { null }) }
// @@CELL_closure_body@@
// want: x then null
const show = (c: boolean) => { print(if c { pick("x") } else { null }) }
show(true)
show(false)
// @@CELL_if_arm@@
// want: x then null
for c in [true, false] {
  if flag() { print(if c { pick("x") } else { pick("") }) }
}
// @@CELL_module_scope@@
// want: x
print(if flag() { pick("x") } else { null })
// @@CELL_arm_coalesce@@
// want: dflt then x
function g(a: string | null, c: boolean) { print(if c { a ?? "dflt" } else { a }) }
g(null, true)
g("x", false)
// @@CELL_arm_call@@
// want: x then null
function g(c: boolean) { print(if c { pick("x") } else { pick("") }) }
g(true)
g(false)
// @@CELL_arm_string_literal@@
// want: lit then null
function g(a: string | null, c: boolean) { print(if c { "lit" } else { a }) }
g(null, true)
g(null, false)
// @@CELL_arm_atom_widened@@
// want: a then null
function g(k: K | null, c: boolean) { print(if c { k } else { null }) }
g("a", true)
g("a", false)
// @@CELL_nulbool@@
// want: true then null
function g(a: boolean | null, c: boolean) { print(if c { a } else { null }) }
g(true, true)
g(true, false)
