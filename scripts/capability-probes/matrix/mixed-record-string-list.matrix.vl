// D4688: a list literal of a record that matches a declared type and a string, delivered into
// a `(H | string)[]`. The un-annotated face infers the literal's own union list, which must stay
// a union list rather than the first element's struct list.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type H = { x: i32 }
// @@VALUE@@
[{ x: 1 }, "t"]
// @@TYPE@@
(H | string)[]
// @@PROOF@@
const e1 = v[1]
if e1 is string { print(e1) } else { print("miss") }
// @@WANT@@
t
