// D15744 — a `const` bound to an un-annotated lambda returning a hole lambda's bundle (a lambda
// its maker calls at two signatures and returns), its call delivered at every position, then
// handed to a parameter called at both signatures, and called directly.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function lap(f) {
  f(2.5)
  f(3)
  return f
}
function take(b) {
  print(b(4))
  print(b(1.5))
}
const g = () => lap((a) => a + 1)
// @@VALUE@@
g()
// @@TYPE@@
(f64) => f64
// @@PROOF@@
take(v)
print(v(9))
// @@WANT@@
5 then 2.5 then 10
// @@VALUE2@@
g()
// @@TYPE2@@
(f64) => f64
// @@PROOF2@@
print(v(0.5))
// @@WANT2@@
1.5
// @@SKIP@@
is_in_if: the value is a function, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
