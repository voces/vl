// D8062: a `for` over an inline list literal of hole functions and the same literal indexed,
// each handed a hole function its body calls at two types, so the argument's parameters stay
// open until each call types them. The value delivered is the sum of what the calls return.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __add(a, b) { a + b }
function __ap2(g) { g(1, 2) + g("ab", "c").length }
function __ap3(g) { g(10, 20) + g("x", "y").length }
function __each() {
  let s = 0
  for f in [__ap2, __ap3] { s = s + f(__add) }
  s
}
// @@VALUE@@
[__ap3, __ap2][1](__add) + __each()
// @@TYPE@@
i32
// @@PROOF@@
print(v)
// @@WANT@@
44
