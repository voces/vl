// D2199 — the disagreeing join with a `??` arm ahead of a one-literal arm. Lowering the `??`
// clears the atom context, and the next arm must still be emitted under it, so the value's
// first arm is the coalesce and its second the one-literal const.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
const G: "green" = "green"
const mp: {[string]: "red" | "blue"} = Map()
function one() { 1 }
// @@VALUE@@
if one() > 1 { mp["a"] ?? "blue" } else { G }
// @@TYPE@@
"red" | "green" | "blue"
// @@TEST@@
v == "green"
// @@HIT@@
print(v)
// @@MISS@@
print("miss")
// @@WANT@@
green
// @@VALUE2@@
if one() > 0 { mp["a"] ?? "blue" } else { G }
// @@TYPE2@@
"red" | "green" | "blue"
// @@PROOF2@@
print("c=" + v)
// @@WANT2@@
c=blue
