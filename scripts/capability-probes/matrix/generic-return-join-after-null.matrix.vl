// D16944 — a generic's returns joined in order `T`, `null`, then a concrete value: the inferred
// result keeps the concrete member, so a `boolean` instance returns the `7`.
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function gen<T>(a0: T, k: i32) {
  if k == 0 { return a0 }
  if k == 1 { return null }
  return 7
}
// @@VALUE@@
gen(true, 2)
// @@TYPE@@
boolean | i32 | null
// @@PROOF@@
print(v)
// @@WANT@@
7
// @@VALUE2@@
gen(false, 1)
// @@TYPE2@@
boolean | i32 | null
// @@PROOF2@@
print(v)
// @@WANT2@@
null
