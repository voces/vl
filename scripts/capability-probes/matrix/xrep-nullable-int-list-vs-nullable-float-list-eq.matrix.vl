// D15055: `==` between a list of `i32 | null` and a list of `f64 | null`, two union-box
// storages: each pair compares by value at `f64`, two nulls are equal. The second instance
// holds a null where the other side holds a number.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function xrMk(n: boolean): (i32 | null)[] {
  if n { return [1, null] }
  return [1, 2]
}
function xrF(a: f64 | null, b: f64 | null): (f64 | null)[] { [a, b] }
const xrEq: (f64 | null)[] = xrF(1.0, 2.0)
const xrNe: (f64 | null)[] = xrF(1.0, null)
// @@VALUE@@
xrMk(false)
// @@TYPE@@
(i32 | null)[]
// @@TEST@@
v == xrEq && v != xrNe
// @@HIT@@
print("value")
// @@MISS@@
print("storage")
// @@WANT@@
value
// @@VALUE2@@
xrMk(true)
// @@TYPE2@@
(i32 | null)[]
// @@PROOF2@@
print("\{v == xrNe} \{v == xrEq}")
// @@WANT2@@
true false
