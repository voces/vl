// A join of two record literals, one holding a record in a field and the other `null`, is the
// union `{j: {a: i32}} | {j: null}`; the annotated face delivers it as the one record `K`, whose
// field is `J | null` (D15719). Each fresh arm is built at `K`, so the join holds `K`.
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type J = { a: i32 }
type K = { j: J | null }
const go = [1].length > 0
// @@VALUE@@
if go { { j: { a: 1 } } } else { { j: null } }
// @@TYPE@@
K
// @@PROOF@@
print(v.j?.a ?? 5)
// @@WANT@@
1
// @@SKIP@@
is_in_if: the value is a record join, not a union to discriminate
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
