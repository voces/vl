// D2250 — an `if`/`else` whose value is `i32 | null` is the union box, and a value-position `if`
// picked a numeric blocktype for it everywhere except a union destination. The inline
// consumers are the D2250 grid's; this template grades the same value at every DELIVERY
// position, in both faces, so a destination that binds it without the box is seen too.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function pick(c: boolean, a: i32 | null, b: i32 | null): i32 | null { a ?? b }
const yes = true
const seven: i32 | null = pick(true, 7, null)
const none: i32 | null = pick(false, null, null)
// @@VALUE@@
if yes { seven } else { none }
// @@TYPE@@
i32 | null
// @@PROOF@@
print(v ?? -1)
// @@WANT@@
7
// @@TEST@@
v != null
// @@HIT@@
print(v ?? -1)
// @@MISS@@
print(0)
// @@VALUE2@@
if !yes { seven } else { none }
// @@TYPE2@@
i32 | null
// @@PROOF2@@
print(v == null)
// @@WANT2@@
true
