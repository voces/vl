// Closures made in a loop over its variable, delivered as a list: each holds its own iteration's
// value.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __mk(): (() => i32)[] {
  const fs: (() => i32)[] = []
  for i in 0 until 3 { fs.push(() => i) }
  return fs
}
// @@VALUE@@
__mk()
// @@TYPE@@
(() => i32)[]
// @@PROOF@@
print(v[0]() + v[2]())
// @@WANT@@
2
