// The result of `as! B` over a union one member of which may be `B` by its fields' values,
// delivered at every position (D16322): the cast is a value `if` that binds the arm, and each
// position reads it as that record.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type __A = { x: i32 }
type __B = { x: 1 | 2 }
type __C = { z: string }
function __mk(k: i32): __A | __C {
  if k > 0 { return { x: k } }
  { z: "z" }
}
const __r = __mk(2)
// @@VALUE@@
__r as! __B
// @@TYPE@@
__A
// @@PROOF@@
print(v.x + 40)
// @@WANT@@
42
// @@SKIP@@
is_in_if: the value is a struct, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
