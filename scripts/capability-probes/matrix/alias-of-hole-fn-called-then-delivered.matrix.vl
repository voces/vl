// An un-annotated alias of a named un-annotated function, called directly before it is delivered
// as a value: the direct call takes the function's instance by name, as it does when the delivery
// comes first (D16420). Cells: a hole callee, a list, a `let`, a chain of aliases, two types, a
// string identity, a reassigned `let`, a function body, and the delivery first.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function inc(t) { return t + 1 }
function app(g, v) { return g(v) }
const f = inc
// @@SKIP@@
return_inferred: the setup call runs outside the returning function, which cannot read it
return_annotated: the setup call runs outside the returning function, which cannot read it
// @@SETUP@@
const pre = f(3)
// @@VALUE@@
f
// @@TYPE@@
(t: i32) => i32
// @@PROOF@@
print(v(pre))
// @@WANT@@
5
// @@CELL_hole_callee@@
// want: 4 then 5
print(f(3))
print(app(f, 4))
// @@CELL_list_element@@
// want: 4 then 5
print(f(3))
const l = [f]
print(l[0](4))
// @@CELL_let_alias@@
// want: 4 then 5
let h = inc
print(h(3))
print(app(h, 4))
// @@CELL_alias_chain@@
// want: 4 then 5
const g = f
print(g(3))
print(app(g, 4))
// @@CELL_two_types@@
// want: 4 then 3.5 then 5
print(f(3))
print(f(2.5))
print(app(f, 4))
// @@CELL_string_identity@@
// want: a then b
function hid(t) { return t }
const s = hid
print(s("a"))
print(app(s, "b"))
// @@CELL_reassigned_let@@
// want: 4 then 6 then 8
function dbl(t) { return t * 2 }
let r = inc
print(r(3))
r = dbl
print(r(3))
print(app(r, 4))
// @@CELL_function_body@@
// want: 4 then 5
function main() {
  const k = inc
  print(k(3))
  print(app(k, 4))
}
main()
// @@CELL_delivery_first@@
// want: 5 then 4
print(app(f, 4))
print(f(3))
