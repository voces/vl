// A generic function returned by an un-annotated function, delivered to each position, then
// handed to a generic's function parameter at TWO types. No function type spells that, so the
// annotated face refuses by design (D10310).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function id<T>(x: T): T { x }
function run<U>(f: (x: U) => U, u: U): U { f(u) }
function mk() { id }
// @@VALUE@@
mk()
// @@TYPE@@
(x: i32) => i32
// @@PROOF@@
print(run(v, 2) + run(v, "ab").length)
// @@WANT@@
4
