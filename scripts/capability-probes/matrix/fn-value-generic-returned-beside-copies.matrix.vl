// The litunion-result twin delivered beside un-annotated functions returning the same generic:
// one bound at two results over one parameter (D9380), one bound at two parameters, and a third
// at one, so every position meets a generic other functions' copies already instanced (D9383).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type K = "x" | "y"
function same<T>(k: T): T { k }
function same2<T>(k: T): T { k }
function pre() { return same }
const pk: (k: K) => K = pre()
const pt: (k: K) => string = pre()
function pre3() { return same }
const ps: (k: string) => string = pre3()
function pre2() { return same2 }
const qk: (k: K) => K = pre2()
const qs: (k: string) => string = pre2()
// @@VALUE@@
same
// @@TYPE@@
(k: K) => string
// @@PROOF@@
print(v("x") + "!" + pt(pk("y")) + ps("q"))
// @@WANT@@
x!yq
// @@VALUE2@@
same2
// @@TYPE2@@
(k: K) => string
// @@PROOF2@@
print(v("y") + "?" + qk("x") + qs("q"))
// @@WANT2@@
y?xq
// @@SKIP@@
is_in_if: the value is a function, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
