// D2785 — the struct twin of `if-expr-arm-local-*`: the arm's value is a record local of its own
// prelude, so every position that classifies the join before the arm lowers must read that
// local's rep, not fall to i32.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type P = { a: i32 }
function pick(): boolean { true }
// @@VALUE@@
if pick() { const x: P = { a: 5 }; x } else { const y = { a: 7 }; y }
// @@TYPE@@
P
// @@TEST@@
v.a == 5
// @@HIT@@
print(v.a)
// @@MISS@@
print("miss")
// @@WANT@@
5
