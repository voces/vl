// The open twin of generic-list-union-dead-test-early-return: the value is a plain `i32`, so
// no argument binds `f`'s `T` and the instance is built at the unbound default, where the
// `is string[]` test is dead.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function f<T>(x: T[] | i32) {
  if x is string[] { return 1 }
  if x is i32 { return x }
  5
}
// @@VALUE@@
3
// @@TYPE@@
i32
// @@PROOF@@
const r: i32 = f(v)
print(r)
// @@WANT@@
3
// @@VALUE2@@
8
// @@TYPE2@@
i32
// @@PROOF2@@
const r: i32 = f(v)
print(r)
// @@WANT2@@
8
