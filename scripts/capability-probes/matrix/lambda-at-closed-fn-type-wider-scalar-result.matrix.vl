// D16310: an un-annotated lambda delivered to a closed function type with a wider scalar result,
// read through a record of a union: built at `() => i64`, the type the call site dispatches on.
// Format: scripts/capability-probes/README.md, "Template format".
// @@VALUE@@
{ a: [367], f: () => 6 }
// @@TYPE@@
{ a: i64[], f: () => i64 } | f64
// @@PROOF@@
if v is { a: i64[], f: () => i64 } { print(v.f() + 3000000000) } else { print(0) }
// @@WANT@@
3000000006
