// D2821 — the generic twin of `if-expr-arm-local-*`: inside a generic instance the arm's tail
// names a local of its own prelude, whose recorded type is the type parameter, so the join, the
// binding and a generic callee's pin must each read the local's slot or initializer instead.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function id<T>(x: T): T { x }
function sel<T>(c: boolean, a: T, b: T): T {
  const r = if c { const w = a; w } else { b }
  id(if c { const u = r; u } else { b })
}
// @@VALUE@@
sel(true, "x", "y")
// @@TYPE@@
string
// @@TEST@@
v == "x"
// @@HIT@@
print(v)
// @@MISS@@
print("miss")
// @@WANT@@
x
// @@VALUE2@@
sel(true, 7.5, 9.5)
// @@TYPE2@@
f64
// @@PROOF2@@
print(v)
// @@WANT2@@
7.5
