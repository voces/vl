// D9751 — a module `let mw` assigned (`=`, `+=`, `++`) beside a module-scope `for mw in` loop
// variable of another type. The value is the module binding read after the loop: every read
// and write of `mw` outside the loop must denote the module binding, not the loop variable.
//
// The proof reads it: `1`, assigned `2`, `+= 1`, `++` gives `4`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
let mw = 1
mw = 2
for mw in [2.5] {
  const t = mw + 1.0
}
mw += 1
mw++
// @@VALUE@@
mw
// @@TYPE@@
i32
// @@PROOF@@
print(v)
// @@TEST@@
v == 4
// @@HIT@@
print(4)
// @@MISS@@
print(0)
// @@WANT@@
4
