// The generic twin of map-nullable-union-arm-result: the `.map` runs inside a generic body whose
// element type is left open, so the nullable arm's `| null` row is reached only through the
// instance's binding of `T` (D12820). The callback's result row is the arm's own, read off the
// type the instance spells by shape (D12900).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type C = { r: i32 }
type S = { s: i32 }
type U = C | S
function keepIf<T>(xs: T[], keep: (T) => boolean): (T | null)[] {
  xs.map((e) => if keep(e) { e } else { null })
}
const cs: C[] = [{ r: 1 }, { r: 2 }]
const ss: S[] = [{ s: 3 }, { s: 4 }]
// @@VALUE@@
keepIf(cs, (c) => c.r > 1)
// @@TYPE@@
(C | null)[]
// @@PROOF@@
print(v.length + (v[1]?.r ?? 0) + (v[0]?.r ?? 100))
// @@WANT@@
104
// @@VALUE2@@
keepIf(ss, (s) => s.s < 4)
// @@TYPE2@@
(S | null)[]
// @@PROOF2@@
print((v[0]?.s ?? 0) + (v[1]?.s ?? 50))
// @@WANT2@@
53
