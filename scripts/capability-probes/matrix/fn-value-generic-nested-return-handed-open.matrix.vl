// A generic function passed back through two un-annotated functions' returns, delivered to each
// position, then handed to a generic at TWO types. No function type spells that, so the
// annotated face refuses by design (D10381).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function id<T>(x: T): T { return x }
function run<U>(f: (x: U) => U, u: U): U { return f(u) }
function mk() { return id }
function deliver() { return mk() }
// @@VALUE@@
deliver()
// @@TYPE@@
(x: i32) => i32
// @@PROOF@@
print(run(v, 2) + run(v, "ab").length)
// @@WANT@@
4
