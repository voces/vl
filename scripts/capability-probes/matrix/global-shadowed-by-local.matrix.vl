// D705 — a module-scope `const v: string` SHADOWED at every delivery position by a binding
// of another rep. The PRELUDE global is what makes this a matrix rather than one witness:
// the harness binds its value to `v` at each position, so every FUNCTION-scoped cell is a
// shadow. Before #2447 the emitter's classifiers resolved a bare identifier through the
// module NAME table (`globalIsStringSid` and twenty siblings), so `print(v)` chose the
// STRING arm over an i32 — check-clean invalid wasm. `globalLetOfSidIn` asks the frame first.
//
// THE MODULE-SCOPE POSITIONS ARE SKIPPED BECAUSE THEY CANNOT SHADOW: a second top-level
// `const v` is `redeclared v`, not a shadow, so those cells grade the checker's duplicate
// rule rather than this capability. Every position that delivers INSIDE a function is kept.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
const v: string = "shadowed"
function shadowLen(): i32 { v.length }
// @@VALUE@@
7
// @@TYPE@@
i32
// @@PROOF@@
print(v)
// @@TEST@@
v > 3
// @@HIT@@
print(7)
// @@MISS@@
print(0)
// @@WANT@@
7
// @@SKIP@@
binding: a second module-scope `const v` is `redeclared v`, not a shadow
return_inferred: the receiving binding is module-scope — `redeclared v`
return_annotated: the receiving binding is module-scope — `redeclared v`
struct_field_init: the destination binding is module-scope — `redeclared v`
struct_field_assign: the rebind is module-scope — `redeclared v`
array_element: the list binding is module-scope — `redeclared v`
array_element_assign: the rebind is module-scope — `redeclared v`
array_push: the rebind is module-scope — `redeclared v`
global_init: a global named `v` beside the prelude's is `redeclared v`
global_assign: a global named `v` beside the prelude's is `redeclared v`
is_in_if: the binding is module-scope — `redeclared v`
is_in_while: the binding is module-scope — `redeclared v`
is_in_and: the binding is module-scope — `redeclared v`
is_in_not: the binding is module-scope — `redeclared v`
else_if: the binding is module-scope — `redeclared v`
block_if_capture: a BLOCK-BODIED lambda in a module-scope block is invalid wasm with no global in sight (D1306) — the cell grades that, not this
block_while_capture: same as `block_if_capture` — D1306, not a shadow
block_bare_capture: same as `block_if_capture` — D1306, not a shadow
two_instances: both bindings are module-scope — `redeclared v`
