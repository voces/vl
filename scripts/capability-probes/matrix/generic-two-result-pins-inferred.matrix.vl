// D5531: a generic function returned bare from a function with an inferred result, whose
// results are called at two types: the prelude calls one result at f64, the cell calls another.
// The generic's type parameter stays open; the annotated face annotates only the destination.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __k<T>(x: T): T {
  return x
}
function __mk() {
  return __k
}
const __o = __mk()
const __of: f64 = __o(2.5)
// @@VALUE@@
__mk()
// @@TYPE@@
(x: i32) => i32
// @@PROOF@@
print(v(41))
// @@WANT@@
41
// @@TEST@@
v(0) == 0
// @@HIT@@
print(v(41))
// @@MISS@@
print(0)
// @@VALUE2@@
__mk()
// @@TYPE2@@
(x: string) => string
// @@PROOF2@@
print(v("s"))
// @@WANT2@@
s
