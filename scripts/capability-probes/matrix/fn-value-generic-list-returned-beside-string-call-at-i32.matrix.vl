// A list of a generic pushed a fixed-type `i32` function, handed back by an un-annotated function
// and delivered from that call to each position where its element is `(i32) => i32`, beside a
// call of the generic itself at `string` that cannot reach the list: every element fits, so every
// annotated position runs (D10151). The twin of `fn-value-generic-list-returned-at-i32.matrix.vl`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function id<T>(x: T): T { x }
function __inc(x: i32): i32 { x + 1 }
const __ys = [id]
__ys.push(__inc)
function __deliver() { return __ys }
// @@VALUE@@
__deliver()
// @@TYPE@@
((x: i32) => i32)[]
// @@PROOF@@
print(v[1](2) * 10 + id("s").length)
// @@WANT@@
31
