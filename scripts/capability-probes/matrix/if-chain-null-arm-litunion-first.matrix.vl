// D14571 — a value if-chain whose first arm is a literal-union atom, beside an `i32` arm and a
// `null` arm, delivered to every position. Its join is `K | i32 | null`, a box, so no position
// may take the first arm's niche for the whole chain; the proof prints the member it holds.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type K = "a" | "b"
function kv(): K { "a" }
function sel(): i32 { 0 }
// @@VALUE@@
if sel() == 0 { kv() } else if sel() == 1 { 7 } else { null }
// @@TYPE@@
K | i32 | null
// @@PROOF@@
print(v)
// @@WANT@@
a
