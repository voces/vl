// A `.map` whose callback is a function value bound from a call with an `f64` result: no lifted entry names the
// result's scalar list, so the call's recorded `f64[]` must collect it, at every position, in
// both faces.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function half(n: i32): f64 { (n as f64) / 2.0 }
function pick(): (i32) => f64 { return half }
const src: i32[] = [3, 5]
// @@SETUP@@
const cb = pick()
// @@VALUE@@
src.map(cb)
// @@TYPE@@
f64[]
// @@PROOF@@
print(v[1] * 2.0 + (v.length as f64))
// @@WANT@@
7
// @@SKIP@@
is_in_if: the value is a list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
