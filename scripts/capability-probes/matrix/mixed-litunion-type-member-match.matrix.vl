// D5714 — a union mixing a string literal with a type member (`"a" | i32`), discriminated by a
// `match` with a literal arm and a type arm after delivery to every position. The literal arm
// is an `==` test and the type arm reads the narrowed `i32`, so a position that delivered the
// wrong box takes the wrong arm or reads a wrong value.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function pick(n: i32): "a" | i32 {
  if n > 1 { return n * 10 }
  "a"
}
function name(c: "a" | i32): string {
  match c {
    "a" => "A"
    i32 => if c + 1 == 31 { "N30" } else { "N?" }
  }
}
// @@VALUE@@
pick(3)
// @@TYPE@@
"a" | i32
// @@TEST@@
v is i32
// @@HIT@@
print(name(v))
// @@MISS@@
print("miss")
// @@WANT@@
N30
// @@VALUE2@@
pick(0)
// @@TYPE2@@
"a" | i32
// @@PROOF2@@
print("c=" + name(v))
// @@WANT2@@
c=A
