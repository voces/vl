// D1866 — a MAP arm of a value union, read back through every map operation under its own
// `is` narrowing. The proof is the point: it reads a VALUE back through `.size`, `.length`,
// `.has`, an index read, `.get`, a `for`-in and a re-binding, so a position that recovers the
// map ref for one operation and not another cannot grade green.
//
// The `*_place` positions are what this template exists for: they re-read the delivery place
// inside the arm rather than a bound name, which is the spelling D1866 filed. A map value is
// the recursive case (`map_value_place` re-reads a map read), and the row's neighbours are
// D1865 (the same value spelled through a recursive alias) and D1822 (the list twin).
//
// TWO CELLS ARE RED AND NEITHER IS THIS ROW'S: `block_bare`/annotated prints the MISS arm and
// `block_bare_capture`/annotated is check-clean invalid wasm, both unchanged by D1866's close.
// A union whose only spelling is a module-scope BLOCK's own annotation does not register its
// map member, so the `is` compares against a spelling nothing banked; adding `const seen:
// { [string]: i32 } | i32 = 0` at module scope makes both cells run. The `string` and `i32[]`
// arms of the same block are correct, so it is the map member, not the block.

// @@PRELUDE@@
function mkInner(): { [string]: i32 } {
  const m: { [string]: i32 } = Map()
  m["a"] = 1
  m["b"] = 2
  m
}

// @@VALUE@@
mkInner()

// @@TYPE@@
{ [string]: i32 } | i32

// @@TEST@@
v is { [string]: i32 }

// @@HIT@@
print(v.size)
print(v.length)
print(v.has("a"))
print(v["a"] ?? -1)
print(v.get("b") ?? -1)
let t = 0
for kk in v { t = t + (v[kk] ?? 0) }
print(t)
const q = v
print(q.size)

// @@MISS@@
print(-1)

// @@WANT@@
2 then 2 then true then 1 then 2 then 3 then 2
