// D9620: an un-annotated parameter, or a lambda's, bound at an `i32` computes at `i64` beside a
// 64-bit literal, as the annotated `x: i32` does, so `2 + 5000000000` lands in an `i64`.
// The proof stores the result in an `i64` and computes past 32 bits with it.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type __S = 1 | 2
const __ls: __S = 2
function __add(x) { x + 5000000000 }
const __mul = (x) => x * 5000000000
// @@VALUE@@
__add(__ls)
// @@TYPE@@
i64
// @@TEST@@
v == 5000000002
// @@HIT@@
const w: i64 = v
print(w + 1)
// @@MISS@@
print("miss")
// @@WANT@@
5000000003
// @@VALUE2@@
__mul(3)
// @@TYPE2@@
i64
// @@PROOF2@@
print(v - 1)
// @@WANT2@@
14999999999
