// D1688 — the same anonymous struct field one element rep over: a NULLABLE-REF element list,
// produced by a call. Both reps refused at every un-annotated position and ran at every
// annotated one, which is what makes them one row and not two.
//
// The template must NOT declare a `type` for the OUTER shape: a declaration nothing spells is
// the rescue D1688 records, and it would turn every un-annotated cell green for the wrong
// reason. `Circle` IS declared, because the element being nominal is not the ingredient and
// the call needs a return annotation to write.
//
// The PROOF reads THROUGH the element after narrowing it (`v.xs[0] != null`), so a field whose
// element heap type came from the wrong wrapper traps or prints 0 rather than passing.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type Circle = { r: i32 }
function shapes(): (Circle | null)[] { return [{ r: 7 }] }
function shapes2(): (Circle | null)[] { return [{ r: 9 }] }
// @@VALUE@@
{ xs: shapes() }
// @@TYPE@@
{ xs: (Circle | null)[] }
// @@PROOF@@
const e = v.xs[0]
if e != null { print(e.r) } else { print(0) }
// @@WANT@@
7
// @@VALUE2@@
{ xs: shapes2() }
// @@TYPE2@@
{ xs: (Circle | null)[] }
// @@PROOF2@@
const e2 = v.xs[0]
if e2 != null { print(e2.r) } else { print(0) }
// @@WANT2@@
9
// @@SKIP@@
is_in_if: the value is a struct, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
