// A generic function delivered to each position, put in a list that is pushed the same generic
// through a `const` alias, and called through the pushed element at TWO types, so the value
// stays open. No function type spells that, so the annotated face refuses by design; the
// un-annotated face calls each type's instance (D10341).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function id<T>(x: T): T { x }
// @@VALUE@@
id
// @@TYPE@@
(x: i32) => i32
// @@PROOF@@
const __ws = [v]
const __al = __ws
__al.push(id)
__ws[1]("w")
print(__ws[1](7))
// @@WANT@@
7
