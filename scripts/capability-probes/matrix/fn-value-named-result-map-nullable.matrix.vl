// D9781: a named function returning a map, delivered where a function returning
// `{[string]: i32} | null` is expected. Every position must hand the call an adapter that
// widens the result.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function n(x: i32): {[string]: i32} {
  const m: {[string]: i32} = Map()
  m["a"] = x
  m
}
function k(x: i32): {[string]: i32} {
  const m: {[string]: i32} = Map()
  m["b"] = x * 2
  m
}
// @@VALUE@@
n
// @@TYPE@@
(x: i32) => {[string]: i32} | null
// @@PROOF@@
const r = v(4)
if r != null { print(r.length + (r["a"] ?? 0)) } else { print(0) }
// @@WANT@@
5
// @@VALUE2@@
k
// @@TYPE2@@
(x: i32) => {[string]: i32} | null
// @@PROOF2@@
const r2 = v(4)
if r2 != null { print(r2["b"] ?? 0) } else { print(0) }
