// D4024 — a bare `null` argument binds `T` in a `T[]` return from the destination's element,
// so the list holds records as well as `null`; the proof stores one.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type Item = { n: i32 }
function mk<T>(x: T): T[] { [x] }
// @@VALUE@@
mk(null)
// @@TYPE@@
(Item | null)[]
// @@PROOF@@
const q = v
q[0] = { n: 7 }
const e = q[0]
if e != null { print(e.n) } else { print("none") }
// @@WANT@@
7
