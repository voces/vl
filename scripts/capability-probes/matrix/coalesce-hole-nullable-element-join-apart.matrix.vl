// D9701: `??` over a nullable `i64` list element read inside an un-annotated function, with an
// `f64` literal default. The two numbers join apart, as at top level, so the result is the
// `i64 | f64` box: the null element takes the default, the other keeps its `i64`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
const __j: (i64 | null)[] = [3, null]
const __j2: (i64 | null)[] = [3, 4]
function __orHalf(a) { a[1] ?? 0.5 }
// @@VALUE@@
__orHalf(__j)
// @@TYPE@@
i64 | f64
// @@TEST@@
v is f64
// @@HIT@@
print(v + 1.0)
// @@MISS@@
print("miss")
// @@WANT@@
1.5
// @@VALUE2@@
__orHalf(__j2)
// @@TYPE2@@
i64 | f64
// @@PROOF2@@
if v is i64 { print(v + 1) } else { print("f64") }
// @@WANT2@@
5
