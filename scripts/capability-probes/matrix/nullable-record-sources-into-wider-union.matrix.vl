// D10170's neighbours — a `P | null` that is not a map read (a nullable record field, then a
// nullable list element) delivered straight into a union that also holds a scalar and `null`.
// The null must land as the union's null and the record as its arm.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type P = { x: i32 }
type H = { p: P | null }
const h: H = { p: null }
const l: (P | null)[] = [{ x: 7 }]
// @@VALUE@@
h.p
// @@TYPE@@
i32 | P | null
// @@TEST@@
v is null
// @@HIT@@
print("null")
// @@MISS@@
if v is P { print(v.x) } else { print("other") }
// @@WANT@@
null
// @@VALUE2@@
l[0]
// @@TYPE2@@
i32 | P | null
// @@PROOF2@@
if v is P { print(v.x) } else if v is null { print("null") } else { print("other") }
// @@WANT2@@
7
