// D9914: a `??` over an un-annotated parameter pinned at a never-null `i32` is that `i32`, though
// its default is a float. The proof divides, which prints `2` at `i32` and `2.5` at `f64`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __cfTake(a) { return a ?? 1.5 }
const __cfPin: i32 = 5
// @@VALUE@@
__cfTake(__cfPin)
// @@TYPE@@
i32
// @@TEST@@
v > 0
// @@HIT@@
print(v / 2)
// @@MISS@@
print("miss")
// @@WANT@@
2
