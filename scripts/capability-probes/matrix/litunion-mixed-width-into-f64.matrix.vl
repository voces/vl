// D3523 — a literal union whose integer members span two widths (`1 | 9000000000`) delivered
// where an `f64` is declared: every member is a constant `f64` holds exactly, so the box converts
// at the member it holds. The un-annotated face keeps `D` and converts at the proof's own `f64`
// binding. Both halve the wide member, which an integer division would not leave a fraction on.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type D = 9000000000 | 1
function pick(n: i32): D {
  if n > 0 { return 9000000000 }
  1
}
// @@VALUE@@
pick(1)
// @@TYPE@@
f64
// @@PROOF@@
const ww: f64 = v
print(ww / 4)
// @@WANT@@
2250000000
// @@VALUE2@@
pick(0)
// @@TYPE2@@
f64
// @@PROOF2@@
const ww: f64 = v
print(ww / 4)
// @@WANT2@@
0.25
