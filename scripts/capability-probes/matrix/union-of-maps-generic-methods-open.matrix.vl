// D10171, D10173's open twin: the union of maps is joined by an un-annotated function from its
// hole parameter, then read by a generic's `.has`, `.values()` and `for` at every position.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __pick(p, c: boolean) {
  const s: {[string]: string} = Map()
  s["k"] = p
  const t: {[string]: boolean} = Map()
  t["k"] = true
  if c { s } else { t }
}
function __has<V>(m: {[string]: V} | {[string]: string}, k: string): boolean { m.has(k) }
function __n<V>(m: {[string]: V} | {[string]: string}): i32 { m.values().length }
function __keys<V>(m: {[string]: V} | {[string]: string}): string {
  let s = ""
  for k in m { s = s + k }
  s
}
// @@VALUE@@
__pick("x", true)
// @@TYPE@@
{[string]: string} | {[string]: boolean}
// @@TEST@@
__has(v, "k") && !__has(v, "zz")
// @@HIT@@
print(__keys(v).length * 10 + __n(v))
// @@MISS@@
print("wrong")
// @@WANT@@
11
