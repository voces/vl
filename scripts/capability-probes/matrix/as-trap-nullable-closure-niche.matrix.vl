// D1812 — `x as! (i32) => i32` over a niche-repped nullable closure. The closure
// fat-pointer is a ref cell like any other, so it needs no arm of its own.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function s1(): ((i32) => i32) | null { return (n: i32) => n + 1 }
function s2(): ((i32) => i32) | null { return (n: i32) => n + 2 }
// @@VALUE@@
s1() as! (i32) => i32
// @@TYPE@@
(i32) => i32
// @@PROOF@@
print(v(4))
// @@WANT@@
5
// @@VALUE2@@
s2() as! (i32) => i32
// @@TYPE2@@
(i32) => i32
// @@PROOF2@@
print(v(4))
// @@WANT2@@
6
// @@SKIP@@
is_in_if: the value is a closure, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
