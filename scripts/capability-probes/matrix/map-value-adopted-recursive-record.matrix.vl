// D9963 — a record literal with a `null` field, beside a declared record that nests itself
// through that field, stored in an un-annotated `Map()` and read back. The literal is held
// as the declared record, so the map's value slot must be that record's row.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type Node = {v: i32, next: Node | null}
// @@VALUE@@
{v: 7, next: null}
// @@TYPE@@
Node
// @@FALLBACK@@
{v: 0, next: null}
// @@PROOF@@
const m = Map()
m["a"] = v
const n = m["a"]
if n != null { print(n.v) }
// @@WANT@@
7
