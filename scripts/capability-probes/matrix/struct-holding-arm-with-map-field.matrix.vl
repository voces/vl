// D15097 — a plain struct holding a union arm whose own field is a non-mono map. `collectS`
// coded the holder's field through the arm's twin check, which compared the two rows' map slots
// before `collectA` interned them, so every such holder refused. The second instance holds an
// arm whose map value is the arm itself.
//
// The PROOF reads a value back out of the held map, so a map field that lands on the wrong
// struct cannot print `7`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type A = { n: i32, g: Map<string, string> }
type P = { m: i32 }
type U = A | P
type Q = { o: A }
type B = { k: i32, h: Map<string, B> }
type UB = B | P
type QB = { b: B }
function mkQ(n: i32): Q {
  const g: Map<string, string> = Map()
  g.set("x", "seven")
  return { o: { n: n, g: g } }
}
function mkQB(k: i32): QB {
  const h: Map<string, B> = Map()
  h.set("y", { k: k, h: Map() })
  return { b: { k: 0, h: h } }
}
// @@VALUE@@
mkQ(7)
// @@TYPE@@
Q
// @@FALLBACK@@
mkQ(3)
// @@TEST@@
v.o.n == 7 && (v.o.g.get("x") ?? "") == "seven"
// @@HIT@@
print(7)
// @@MISS@@
print(9)
// @@WANT@@
7
// @@VALUE2@@
mkQB(5)
// @@TYPE2@@
QB
// @@PROOF2@@
print(v.b.h.get("y")?.k ?? 0)
// @@WANT2@@
5
