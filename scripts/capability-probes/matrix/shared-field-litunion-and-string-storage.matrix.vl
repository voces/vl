// A field every arm shares, stored as a literal-set atom in one arm and as a plain string in
// the other. The read is typed `string`, so the atom arm must deliver its member's text. The
// proof compares and prints it, which a raw atom id answers wrong (D5105).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type N = { kind: "a" | "b", v: i32 } | { kind: string, s: boolean }
function mk(e: boolean): N {
  if e { return { kind: "zz", s: true } }
  { kind: "b", v: 1 }
}
// @@VALUE@@
mk(true).kind
// @@TYPE@@
string
// @@TEST@@
v == "zz"
// @@HIT@@
print("zz")
// @@MISS@@
print("other")
// @@WANT@@
zz
// @@VALUE2@@
mk(false).kind
// @@TYPE2@@
string
// @@PROOF2@@
print(v)
// @@WANT2@@
b
