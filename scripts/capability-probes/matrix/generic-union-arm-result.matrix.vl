// D10522 — the value is a generic call whose `T | string` return binds `T` to a union, so its
// recorded type keeps that union nested (`(f64 | i32) | string`). Every delivery has to name
// the flattened box, and a test of the delivered value has to unbox its arm.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __gf<T>(u: T): T | string { u }
const __s: f64 | i32 = 3
// @@VALUE@@
__gf(__s)
// @@TYPE@@
f64 | i32 | string
// @@TEST@@
v is i32
// @@HIT@@
print(v + 1)
// @@MISS@@
print("miss")
// @@WANT@@
4
