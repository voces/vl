// D8720 generic twin — `pickG` infers its return and its dead tails are the open type parameter
// `T`, instantiated at two type arguments, so no instance may join `T` into its `string`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function pickG<T>(x: T, k: i32) {
  if k > 0 {
    return "p"
    x
  }
  return "n"
  x
}
// @@VALUE@@
pickG(true, 1) + pickG(2.5, 0)
// @@TYPE@@
string
// @@PROOF@@
print(v)
// @@WANT@@
pn
