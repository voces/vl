// D13781: an un-annotated function whose body gives `i32`, delivered where a function returning
// `string | i32` is expected. The un-annotated twin of
// `fn-value-named-result-i32-into-value-union.matrix.vl` (D10244): every position must hand the
// call an adapter that boxes the result. The second value is a binding of an un-annotated lambda.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function lenOf(s) { return s.length }
const __wide = (s) => s.length * 10
// @@VALUE@@
lenOf
// @@TYPE@@
(s: string) => string | i32
// @@PROOF@@
const r = v("abc")
print(r)
// @@WANT@@
3
// @@VALUE2@@
__wide
// @@TYPE2@@
(s: string) => string | i32
// @@PROOF2@@
const r2 = v("ab")
print(r2)
// @@WANT2@@
20
