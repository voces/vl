// D16728: a `string | null` field every arm of a record union stores, read off the un-narrowed
// union after a null test of the read itself. The value is such a union, delivered to every
// position; the proof narrows `v.v` and hands it to a non-null string slot.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type A = { v: string | null }
type B = { v: string | null, w: i32 }
type AB = A | B
function mkab(): AB { return { v: "hi", w: 3 } }
// @@VALUE@@
mkab()
// @@TYPE@@
AB
// @@PROOF@@
if v.v != null {
  const s: string = v.v
  print(s)
}
// @@WANT@@
hi
// @@CELL_param_print@@
function f(x: A | B) {
  if x.v != null { print(x.v) }
}
f({ v: "hi" })
f({ v: null, w: 3 })
// @@CELL_param_early_return@@
function f(x: A | B) {
  if x.v == null { return }
  print(x.v)
}
f({ v: "hi" })
f({ v: null, w: 3 })
// @@CELL_param_returned@@
function f(x: A | B): string {
  if x.v != null { return x.v }
  return "n"
}
print(f({ v: "hi" }))
// @@CELL_three_arms@@
// want: hi
type C = { v: string | null, z: boolean }
function f(x: A | B | C) {
  if x.v != null { print(x.v + "") }
}
f({ v: null, z: true })
f({ v: "hi" })
// @@CELL_null_member@@
function f(x: A | B | null) {
  if x != null {
    if x.v != null { print(x.v) }
  }
}
f(null)
f({ v: "hi", w: 1 })
