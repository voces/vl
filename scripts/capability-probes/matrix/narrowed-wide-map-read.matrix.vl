// D9630: a `!= null` test narrows an `i64`-valued map read itself, as it does an `i32` or
// `string` one, so the read delivers at `i64`, and a stored `0` beside it is present.
// The proof computes past 32 bits. `narrowed-f64-map-read` is the `f64` twin.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
const __wm: { [string]: i64 } = Map()
__wm["k"] = 5000000000
__wm["z"] = 0
// @@GUARD@@
__wm["k"] != null && __wm["z"] != null
// @@VALUE@@
__wm["k"]
// @@TYPE@@
i64
// @@FALLBACK@@
0
// @@TEST@@
v > 4000000000
// @@HIT@@
const w: i64 = v
print(w + 1)
// @@MISS@@
print("miss")
// @@WANT@@
5000000001
