// D16293 — an integer literal `let` joins a float stored into it, as ruling 4.3 joins any literal
// with a typed value it fits: `let t = 0` and a float store that holds the literal exactly make
// `t` that float, and in an un-annotated generic each instance's pin. Integer-only stores keep
// the integer widening, and a float that does not hold the literal exactly keeps the refusal.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function sum(xs) {
  let t = 0
  let i = 0
  while i < xs.length { t = t + xs[i]; i = i + 1 }
  return t
}
// @@VALUE@@
[1.5, 2.5]
// @@TYPE@@
f64[]
// @@PROOF@@
print(sum(v))
// @@WANT@@
4
// @@CELL_plain_store_with_float_literal@@
// want: 1.5
let t = 0
t = t + 1.5
print(t)
// @@CELL_plain_store_of_float_literal@@
// want: 1.25
let t = 0
t = 2.5
print(t / 2)
// @@CELL_plain_for_accumulator@@
// want: 4.25
const xs: f64[] = [1.5, 2.5, 0.25]
let acc = 0
for x in xs { acc = acc + x }
print(acc)
// @@CELL_plain_f32_store@@
// want: 1.5
let t = 0
const f: f32 = 1.5
t = f
print(t)
// @@CELL_plain_integer_widening@@
// want: 5000000000
let t = 0
const big: i64 = 5000000000
t = t + big
print(t)
// @@CELL_plain_f32_store_not_exact@@
// owed: cannot assign f32 to i32
let t = 16777217
const f: f32 = 1.5
t = f
print(t)
// @@CELL_generic_for_both_instances@@
// want: 3 then 4
function tot(xs) {
  let t = 0
  for x in xs { t = t + x }
  return t
}
print(tot([1, 2]))
print(tot([1.5, 2.5]))
// @@CELL_generic_i64_and_f32@@
// want: 6000000000 then 1.75
function tot(xs) {
  let t = 0
  for x in xs { t = t + x }
  return t
}
const a: i64[] = [3000000000, 3000000000]
const b: f32[] = [1.5, 0.25]
print(tot(a))
print(tot(b))
// @@CELL_generic_record_field@@
// want: 3.5 then 3
function tot(rs) {
  let t = 0
  let i = 0
  while i < rs.length { t = t + rs[i].v; i = i + 1 }
  return t
}
print(tot([{ v: 1.5 }, { v: 2.0 }]))
print(tot([{ v: 1 }, { v: 2 }]))
// @@CELL_generic_running_max@@
// want: 7.25 then 9
function mx(xs) {
  let m = 0
  for x in xs { if x > m { m = x } }
  return m
}
print(mx([1.5, 7.25, 2.0]))
print(mx([3, 9, 2]))
// @@CELL_generic_lambda@@
// want: 4
const tot = (xs) => {
  let t = 0
  for x in xs { t = t + x }
  return t
}
print(tot([1.5, 2.5]))
// @@CELL_generic_f32_not_exact@@
// owed: constant 16777217 is not exact at f32
function tot(xs) {
  let t = 16777217
  for x in xs { t = t + x }
  return t
}
const b: f32[] = [1.5, 0.25]
print(tot(b))
