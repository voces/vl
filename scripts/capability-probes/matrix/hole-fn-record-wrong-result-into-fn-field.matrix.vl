// D9471: a record literal holding an un-annotated function of i32 result. Delivered into an
// `R` whose field returns f64 (the annotated face) it is refused at check, as
// `const r: R = { f: inc0 }` is; un-annotated, the record keeps its own type and prints `4`.
// No cell may run the i32 function through the f64 signature.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type R = { f: (a: i32) => f64 }
function inc0(a) { return a + 1 }
// @@VALUE@@
{ f: inc0 }
// @@TYPE@@
R
// @@PROOF@@
print(v.f(3))
// @@WANT@@
4
// @@SKIP@@
is_in_if: the value is a record, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
