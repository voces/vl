// D9471: a record literal holding an un-annotated function of i32 result. Delivered into an
// `R` whose field returns f64 (the annotated face) its field adapts, widening the result
// (D15896); un-annotated, the record keeps its own type and the binding widens. `/ 8` on an `f64`
// binding prints `0.5` only from a converted result.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type R = { f: (a: i32) => f64 }
function inc0(a) { return a + 1 }
// @@VALUE@@
{ f: inc0 }
// @@TYPE@@
R
// @@PROOF@@
const __r: f64 = v.f(3)
print(__r / 8)
// @@WANT@@
0.5
// @@SKIP@@
is_in_if: the value is a record, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
