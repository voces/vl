// D1569 — an INFERRED-empty list whose element the checker pinned to a NON-i32 SCALAR, filled
// by a `.push` AND by an index STORE, delivered everywhere and read back through arithmetic.
// `const xs = []` + `xs.push(1.5)` + `xs[0] = 2.5` is the SUBJECT and it stays un-annotated in
// BOTH faces (it lives in @@SETUP@@); the face varies the DESTINATION's annotation, which is
// the annotated twin that already ran.
//
// THE TEMPLATE MUST NEVER SPELL `f64[]` IN @@PRELUDE@@ OR @@SETUP@@, and must never write a
// non-empty f64 literal there either. Either one mints the f64 wrapper/backing pair this defect
// is the absence of, so it would turn every cell green for the wrong reason — the annotated
// FACE is the controlled place for that spelling, one cell at a time.
//
// The PROOF reads the element back in all THREE operand positions — left (`v[0] + 1.0`), right
// (`1.0 + v[0]`) and unary (`-v[0]`) — because the emit refusal this row closes is reached from
// any of them and a list whose backing came from the i32 default would print a different sum.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
// @@SETUP@@
const __xs = []
__xs.push(1.5)
__xs[0] = 2.5
const __ys = []
__ys.push(0.5)
// @@VALUE@@
__xs
// @@TYPE@@
f64[]
// @@PROOF@@
const l = v[0] + 1.0
const r = 1.0 + v[0]
const u = -v[0]
print(l + r + u)
// @@WANT@@
4.5
// @@VALUE2@@
__ys
// @@TYPE2@@
f64[]
// @@PROOF2@@
print(v[0] + 0.25)
// @@WANT2@@
0.75
// @@SKIP@@
is_in_if: the value is a list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
