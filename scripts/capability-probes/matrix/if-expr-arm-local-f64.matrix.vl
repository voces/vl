// D2785 — an if-expression arm that declares a local, delivered to every position. The arm is
// a block whose last statement is its value; its locals are allocated by node wherever the
// expression sits, not only as a binding initializer inside a function.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function pick(): boolean { true }
// @@VALUE@@
if pick() { const q = 2.25; q * 2.0 } else { 1.5 }
// @@TYPE@@
f64
// @@TEST@@
v == 4.5
// @@HIT@@
print(v)
// @@MISS@@
print("miss")
// @@WANT@@
4.5
