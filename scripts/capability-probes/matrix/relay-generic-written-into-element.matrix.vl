// A generic function a relay of a maker returns, delivered at one closed type by a binding and
// written by another call into a container element called at a second type: each call site takes
// its own instance (D16864). The written element is reached by an index write, `set` or `push`.
// @@PRELUDE@@
function __k<T>(x: T): T { return x }
function __mk() { return __k }
function __dlv() { return __mk() }
const __s: (x: string) => string = __dlv()
// @@VALUE@@
__dlv()
// @@TYPE@@
(x: i32) => i32
// @@PROOF@@
print(v(41))
// @@WANT@@
41
// @@CELL_elem_map_index_write@@
// want: 41 then s
const mm = Map()
mm["k"] = __dlv()
const mv = mm["k"]
if mv != null { const g = mv; print(g(41)) }
print(__s("s"))
// @@CELL_elem_map_set@@
// want: 41 then s
const mm = Map()
mm.set("k", __dlv())
const mv = mm.get("k")
if mv != null { print(mv(41)) }
print(__s("s"))
// @@CELL_elem_list_push@@
// want: 7 then s
const ys = []
ys.push(__dlv())
print(ys[0](7))
print(__s("s"))
// @@CELL_elem_list_index_write@@
// want: t then s
const ys = [__s]
ys[0] = __dlv()
print(ys[0]("t"))
print(__s("s"))
// @@CELL_elem_map_two_signatures@@
// want: 41 then true then s
const mm = Map()
mm["k"] = __dlv()
const a = mm["k"]
if a != null { print(a(41)) }
const b = mm["k"]
if b != null { print(b(true)) }
print(__s("s"))
// @@CELL_elem_map_value_called_twice@@
// want: 41 then 42 then s
const mm = Map()
mm["k"] = __dlv()
const mv = mm["k"]
if mv != null {
  print(mv(41))
  print(mv(42))
}
print(__s("s"))
