// D2633 — a `v128 | string` union: the vector atom beside a ref atom, tested with `is`.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function pick(n: i32): v128 | string {
  if n < 0 { return "neg" }
  __splat_i32x4__(n)
}
// @@VALUE@@
pick(11)
// @@TYPE@@
v128 | string
// @@TEST@@
v is v128
// @@HIT@@
print(__extract_lane_i32x4__(v, 0))
// @@MISS@@
print(v)
// @@WANT@@
11
// @@VALUE2@@
pick(-1)
// @@TYPE2@@
v128 | string
// @@PROOF2@@
if v is string { print(v) } else { print("vector") }
// @@WANT2@@
neg
