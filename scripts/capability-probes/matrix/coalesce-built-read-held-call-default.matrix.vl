// D15240: a read of a map whose values are built wider, defaulted with `??` to a `const` that
// holds a function's fresh record result, delivered at every position. The binding and the
// function are built at the read's record, as a record literal default is (D15217).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type J = { f: i32 | null }
function mkv() { { f: 4 } }
const m = Map()
m.set("a", mkv())
const wm: {[string]: J} = Map()
wm.set("a", mkv())
function mkd() { { f: 1 } }
const dflt = mkd()
// @@VALUE@@
m.get("a") ?? dflt
// @@TYPE@@
J
// @@PROOF@@
print(v.f ?? 0)
// @@WANT@@
4
// @@SKIP@@
is_in_if: the value is a record, not a union; there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
