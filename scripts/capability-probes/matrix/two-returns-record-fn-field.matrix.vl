// A function returning one of two record literals that hold different un-annotated functions in a
// field, at every delivery position, the field called at two types through the delivered record
// (D15277). The value `if` twin is `if-arm-record-fn-field-two-members`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __idA(a) { return a }
function __idB(a) { return a }
function __mkR() {
  if 1 > 0 { return { f: __idA } }
  return { f: __idB }
}
// @@VALUE@@
__mkR()
// @@TYPE@@
{ f: (a: i32) => i32 }
// @@PROOF@@
print(v.f(2.5) + v.f(2))
// @@WANT@@
4.5
// @@VALUE2@@
__mkR()
// @@TYPE2@@
{ f: (a: i32) => i32 }
// @@PROOF2@@
print(v.f(0.5) * v.f(3))
// @@WANT2@@
1.5
// @@SKIP@@
is_in_if: the value is a struct, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
