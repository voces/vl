// D9523: an un-annotated parameter, or a lambda's, bound at a literal union whose members span
// two widths computes at `i64` from its narrow member too, so `2 * 3` lands in an `i64`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type __LW = 1 | 2 | 5000000000
const __wn: __LW = 2
const __ww: __LW = 5000000000
function __mul(x) { x * 3 }
const __sub = (x) => x - 7
// @@VALUE@@
__mul(__wn)
// @@TYPE@@
i64
// @@TEST@@
v == 6
// @@HIT@@
print(v)
// @@MISS@@
print("miss")
// @@WANT@@
6
// @@VALUE2@@
__sub(__ww)
// @@TYPE2@@
i64
// @@PROOF2@@
print(v)
// @@WANT2@@
4999999993
