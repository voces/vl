// A function's record result, read at its own row elsewhere, delivered to a record that stores a
// NESTED number wider (`i32` into `i64`): the delivery copies the record, each nested record at its
// own destination row (D15264). The proof multiplies past `i32`, so a value left at its own row
// prints a different answer or fails to validate.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type J = { f: i64 }
type K = { j: J, s: string }
function mk() { { j: { f: 4 }, s: "a" } }
const own = mk()
const ownN: i32 = own.j.f + 1
// @@VALUE@@
mk()
// @@TYPE@@
K
// @@PROOF@@
print(v.j.f * 4000000000 + ownN)
// @@WANT@@
16000000005
