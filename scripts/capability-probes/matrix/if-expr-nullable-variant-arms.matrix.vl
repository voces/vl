// D1560, THE SECOND SENTENCE — the same if-EXPRESSION over two `Hit | null`-returning calls,
// in a module that also DECLARES `type R = Hit | Miss`. Reported by the glean session as
// VL-025, whose MPQ reader refused with `ref valtype with no interned shape` where the minimal
// program said `bare null needs a struct-typed context`.
//
// The union declaration is the whole ablation: it moves `Hit`'s heap from `sHeapIdx` to
// `uVarHeap`, so the struct fallback claimed a kind whose slot resolves to -1 and `fbValtype`
// floored before any `null` was written. `R` is never USED here — declaring it is enough — and
// this face refused at BOTH spellings, where the plain-struct face refused only un-annotated.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type Hit = { msg: string }
type Miss = { why: string }
type R = Hit | Miss
function mkA(ok: boolean): Hit | null {
  if ok { return null }
  return { msg: "a" }
}
function mkB(ok: boolean): Hit | null {
  if ok { return null }
  return { msg: "b" }
}
function truthy() { 1 == 1 }
function falsy() { 1 == 2 }
// @@VALUE@@
if truthy() { mkA(falsy()) } else { mkB(falsy()) }
// @@TYPE@@
Hit | null
// @@FALLBACK@@
null
// @@TEST@@
v != null
// @@HIT@@
print(v.msg)
// @@MISS@@
print("null")
// @@WANT@@
a
// @@VALUE2@@
if truthy() { mkB(falsy()) } else { mkB(falsy()) }
// @@WANT2@@
b
