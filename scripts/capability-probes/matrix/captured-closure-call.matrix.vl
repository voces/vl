// D1608 at every delivery position: the value is a lambda that CALLS a function value it
// CAPTURED, so the refused shape rides inside whatever position the matrix hands it to and
// the proof calls it there. Master refuses the whole family with `emitProgram: call to
// unknown function`; the sibling template `closure-delivered-then-captured` is the other
// direction, a plain closure captured BY the proof.
//
// `54` and `1` in the proof rather than `50`/`5`: the want must fail if the call reaches
// `__add5` directly instead of through the captured value, and an addend the capture does
// not carry is what makes the two distinguishable.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function __mkCapturingCaller() {
  const inner = (n: i32) => n + 1
  return (n: i32) => inner(n)
}
// @@VALUE@@
__mkCapturingCaller()
// @@TYPE@@
(i32) => i32
// @@PROOF@@
print(v(54))
// @@WANT@@
55
// @@TEST@@
v(0) == 1
// @@HIT@@
print(v(54))
// @@MISS@@
print(0)
// @@SKIP@@
return_inferred: D1620 — a closure through TWO inferred-return hops classifies as i32, at both faces and with no capture at all
// @@VALUE2@@
__mkCapturingCaller()
// @@TYPE2@@
(i32) => i32
// @@PROOF2@@
print(v(65))
// @@WANT2@@
66
