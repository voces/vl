// D1714 — a `??` whose nullable-REF operand meets a default of ANOTHER type. The checker
// types the result as a union, so its rep is the value box; the arm lowered it through
// `br_on_non_null`, whose block type is the operand's OWN heap type, and the default landed
// in a string-typed block.
//
// The first line is the control: a FITTING default still takes the `br_on_non_null` shape and
// its bytes must not move. The last line is the `as?`-operand column — the row's own witness,
// where the niche is produced by a cast rather than by a nullable return.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@SKIP@@
map_value: the builder guards its read with `!= null`, and this template's operand is null by
design so the DEFAULT is what each line proves — the guarded body never runs
// @@PRELUDE@@
type A = { r: i32 }
function st(): A { return { r: 8 } }
function mkS(): string | null { return null }
function mkU(): i32 | string { return 4 }
// @@VALUE@@
mkS()
// @@TYPE@@
string | null
// @@PROOF@@
print(v ?? "x")
const j = v ?? 7
if j is string { print(0) } else { print(j) }
const k = v ?? st()
if k is A { print(k.r) } else { print(0) }
const q = (mkU() as? string) ?? st()
if q is A { print(q.r) } else { print(0) }
// @@WANT@@
x then 7 then 8 then 8
