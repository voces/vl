// D2236 — an un-annotated `string[] | null` from a join of a non-empty list literal with a
// bare `null`: the binding's slot must be the list wrapper the join builds, not the backing
// array or no shape at all. VALUE is an `if`, VALUE2 a `match`.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function truthy() { 1 == 1 }
function one() { 1 }
// @@VALUE@@
if truthy() { ["x"] } else { null }
// @@TYPE@@
string[] | null
// @@FALLBACK@@
null
// @@TEST@@
v != null
// @@HIT@@
print(v[0])
// @@MISS@@
print("null")
// @@WANT@@
x
// @@VALUE2@@
match one() { 1 => ["y"], _ => null }
// @@TYPE2@@
string[] | null
// @@PROOF2@@
if v != null { print(v[0]) } else { print("null") }
// @@WANT2@@
y
