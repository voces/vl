// A map of nullable functions, delivered: a stored `null`, a narrowed call, and a walk that calls
// the present values.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __mk(): {[string]: ((n: i32) => i32) | null} {
  const m: {[string]: ((n: i32) => i32) | null} = Map()
  m["a"] = (n: i32) => n + 10
  m["b"] = null
  return m
}
// @@VALUE@@
__mk()
// @@TYPE@@
{[string]: ((n: i32) => i32) | null}
// @@PROOF@@
const f = v["a"]
if f != null { print(f(1)) }
let c = 0
for k, g in v {
  if g != null { c = c + g(0) }
}
print(c)
// @@WANT@@
11 then 10
