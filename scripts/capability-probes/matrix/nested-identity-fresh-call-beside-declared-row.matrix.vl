// D8303: a fresh call handed through two nested generic identities, where the program declares a
// record of the call's own field storage (`Col`). Each identity is pinned only by the call
// inside, so the call is built at the record the outer one delivers to. The type parameter
// stays open.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type Col = { r: i32, g: i32 }
type J = { r: i32 | null, g: i32 }
function idn<T>(v: T): T { v }
function mk() { { r: 15, g: 1 } }
// @@VALUE@@
idn(idn(mk()))
// @@TYPE@@
J
// @@WANT@@
15
// @@TEST@@
true
// @@HIT@@
print(v.r ?? 0)
// @@MISS@@
print(0)
