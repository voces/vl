// A `let` re-pointed between two functions with open parameters and handed to a higher-order
// parameter at two argument types (D9006, D9030): `f` holds un-annotated functions handed to an
// un-annotated parameter, `g` generics handed to a generic's arrow parameter, and the prelude
// hands each at a second type, so the proof tells `dbl` from `inc0` and `lst` from `fst`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function wrapH(h, x) { return h(x) }
let f = inc0
if [1].length > 0 { f = dbl }
const fOther = wrapH(f, 1.5)
function fst<T>(xs: T[]): T { return xs[0] }
function lst<T>(xs: T[]): T { return xs[xs.length - 1] }
function appL<T>(h: (x: T[]) => T, v: T[]): T { return h(v) }
let g = fst
if [1].length > 0 { g = lst }
const gOther = appL(g, ["a", "b"])
// @@VALUE@@
wrapH(f, 5)
// @@TYPE@@
i32
// @@PROOF@@
print(v + 1)
// @@WANT@@
11
// @@VALUE2@@
appL(g, [1, 2, 3])
// @@TYPE2@@
i32
// @@PROOF2@@
print(v * 2)
// @@WANT2@@
6
