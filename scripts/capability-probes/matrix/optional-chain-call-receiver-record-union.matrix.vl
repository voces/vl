// `id(v)?.tag ?? "z"` over a nullable union of records: the receiver is a call, so it is
// evaluated once, tested and read again. The proof coalesces a present value and a null one
// (D5301).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type N = { tag: "a", v: i32 } | { tag: "b", w: i32 }
function mk(a: boolean): N | null {
  if a { return null }
  { tag: "b", w: 2 }
}
function id(x: N | null): N | null { x }
// @@VALUE@@
mk(false)
// @@TYPE@@
N | null
// @@PROOF@@
print(id(v)?.tag ?? "z")
// @@WANT@@
b
// @@VALUE2@@
mk(true)
// @@TYPE2@@
N | null
// @@PROOF2@@
print(id(v)?.tag ?? "z")
// @@WANT2@@
z
