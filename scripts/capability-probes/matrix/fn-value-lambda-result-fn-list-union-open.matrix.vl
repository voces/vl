// The generic twin of fn-value-lambda-result-fn-list-union: the delivered value is handed on to
// a generic whose result `T` stays open until the function binds it to the union (D9970).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __run<T>(f: () => T): T { f() }
// @@VALUE@@
() => [() => "z"]
// @@TYPE@@
() => (() => string)[] | i32
// @@PROOF@@
const __t = __run(v)
if __t is i32 { print(__t) } else { print(__t[0]()) }
// @@WANT@@
z
