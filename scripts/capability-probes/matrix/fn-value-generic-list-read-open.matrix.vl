// The generic twin of fn-value-generic-list-read: the element is read back and called at TWO
// types, so its type parameter stays open. No function type spells that, so the annotated
// face refuses by design; the un-annotated face instances the element once per call.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function id<T>(x: T): T { x }
// @@VALUE@@
[id]
// @@TYPE@@
((x: i32) => i32)[]
// @@PROOF@@
const __n = v[0](2)
const __s = v[0]("abc")
print(__s.length + __n)
// @@WANT@@
5
// @@TEST@@
v.length == 1
// @@HIT@@
const __n = v[0](2)
const __s = v[0]("abc")
print(__s.length + __n)
// @@MISS@@
print(0)
