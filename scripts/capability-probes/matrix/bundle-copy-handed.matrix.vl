// D15740, D15748, D15749 — a hole lambda's bundle (a lambda its maker calls at two signatures and
// returns), held in a module-scope `const` and delivered at every position, then handed whole to
// a parameter called at both signatures, handed to one called at one, and called directly.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function lap(f) {
  f(2.5)
  f(3)
  return f
}
function take(b) {
  print(b(4))
  print(b(1.5))
}
function take2(b) { print(b(7)) }
const c = lap((a) => a + 1)
// @@VALUE@@
c
// @@TYPE@@
(f64) => f64
// @@PROOF@@
take(v)
take2(v)
print(v(9))
// @@WANT@@
5 then 2.5 then 8 then 10
// @@VALUE2@@
c
// @@TYPE2@@
(f64) => f64
// @@PROOF2@@
print(v(0.5))
// @@WANT2@@
1.5
// @@SKIP@@
is_in_if: the value is a function, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
