// Control for capability-matrix.vl's map guard: TEST names `null` only as a call's argument, so
// the bound `(i32 | null)[]` is never null and the map positions must still strip the read's
// `| null`. Graded `check refuses` at map_value and map_set while any `null` in TEST dropped it.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function mgL(b: i32 | null): (i32 | null)[] { [1, b] }
function mgAt(xs: (i32 | null)[], i: i32, x: i32 | null): boolean { xs[i] == x }
// @@VALUE@@
mgL(null)
// @@TYPE@@
(i32 | null)[]
// @@TEST@@
mgAt(v, 1, null) && !mgAt(v, 1, 2)
// @@HIT@@
print("value")
// @@MISS@@
print("storage")
// @@WANT@@
value
