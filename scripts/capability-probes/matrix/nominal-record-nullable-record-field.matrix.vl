// D3762 — a `new` record whose field is a nullable record, at every delivery position. The
// brand is a second arena index over the record's body, and an un-annotated list literal of it
// found no struct row and fell to the i32 list. The PROOF reads through the nullable field, so
// a value built in the wrong row traps or prints the wrong number rather than passing.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type B = { v: i32 }
type H = new { f: B | null }
function mk(k: i32): H { return { f: { v: k } } }
function fv(h: H): i32 {
  const f = h.f
  if f != null { return f.v }
  0
}
// @@VALUE@@
mk(4)
// @@TYPE@@
H
// @@PROOF@@
print(fv(v))
// @@WANT@@
4
// @@VALUE2@@
mk(9)
// @@TYPE2@@
H
// @@PROOF2@@
print(fv(v))
// @@WANT2@@
9
// @@SKIP@@
is_in_if: the value is a struct, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
