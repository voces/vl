// D2564 at every position: a nullable-record function whose `return { … }` was emitted just
// after another nullable-record function's, in a program that spells a union of two records.
// A `return` of a literal left the other function's null heap seeded, and the next bare `null`
// took it, so `mkC` failed validation whatever position its value was delivered to.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type A = { r: i32 }
type B = { q: string }
type C = { c: i32, z: f64 }
function mkB(s: string): B | null { if s == "" { return null } return { q: s } }
function mkC(n: i32): C | null { if n == 0 { return null } return { c: n, z: 1.5 } }
function stB(): B { return { q: "d" } }
function spell(): boolean {
  const u: A | B = stB()
  u is B
}
// @@VALUE@@
mkC(4)
// @@TYPE@@
C | null
// @@TEST@@
v == null
// @@HIT@@
print("null")
// @@MISS@@
print(v.c)
// @@WANT@@
4
// @@VALUE2@@
mkC(0)
// @@TYPE2@@
C | null
// @@PROOF2@@
if v == null { print("null") } else { print(v.c) }
// @@WANT2@@
null
