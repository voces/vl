// D4056 — two record arms share both field names; `k` has one type in both and `n` differs,
// so only `n` decides which arm the value fits.
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type A = { k: i32, n: string }
type B = { k: i32, n: boolean }
function pick(a: boolean): A | B {
  if a { return { k: 1, n: "s" } }
  { k: 7, n: true }
}
// @@VALUE@@
pick(false)
// @@TYPE@@
A | B
// @@TEST@@
v is A
// @@HIT@@
print("A " + v.n)
// @@MISS@@
if v.n { print(v.k + 100) } else { print(v.k) }
// @@WANT@@
107
// @@VALUE2@@
pick(true)
// @@TYPE2@@
A | B
// @@PROOF2@@
print(v.k)
// @@WANT2@@
1
