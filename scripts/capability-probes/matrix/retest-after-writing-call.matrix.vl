// A re-test after a call that ends a narrowing, and a test after a call in the same condition
// (D2408, D2449, D2464, D3251): the tested place reads its storage, a narrowing made after the
// call holds, and the call is charged only against facts it follows. Each cell prints `true`.
// @@PRELUDE@@
// @@VALUE@@
1.5
// @@TYPE@@
f64
// @@PROOF@@
print(true)
// @@WANT@@
true
// @@SKIP@@
binding: every cell is its own program; the built-in positions deliver no tested place
return_inferred: same
return_annotated: same
argument: same
struct_field_init: same
struct_field_assign: same
array_element: same
array_element_assign: same
array_push: same
local_assign: same
global_init: same
global_assign: same
map_value: same
map_set: same
closure_capture: same
block_if: same
block_if_capture: same
block_while: same
block_while_capture: same
block_bare: same
block_bare_capture: same
fn_body: same
fn_body_capture: same
is_in_if: same
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
array_element_place: same
map_value_place: same
struct_field_place: same
early_return_guard: same
two_instances: same
// @@CELL_bare_retest_same@@
function f(): f64 {
  let v: boolean | f64 = 1.5
  const k = (): boolean => {
    v = 2.5
    true
  }
  if v is f64 && k() {
    if v is f64 { return v }
  }
  0.0
}
print(f() == 2.5)
// @@CELL_bare_retest_flipped@@
function f(): f64 {
  let v: boolean | f64 = 1.5
  const k = (): boolean => {
    v = true
    true
  }
  if v is f64 && k() {
    if v is f64 { return v }
    return -1.0
  }
  0.0
}
print(f() == -1.0)
// @@CELL_bare_retest_other_member@@
function f(): boolean {
  let v: boolean | f64 = 1.5
  const k = (): boolean => {
    v = true
    true
  }
  if v is f64 && k() {
    if v is boolean { return v }
  }
  false
}
print(f())
// @@CELL_bare_retest_paren@@
function f(): f64 {
  let v: boolean | f64 = 1.5
  const k = (): boolean => {
    v = 8.5
    true
  }
  if v is f64 && k() {
    if (v) is f64 { return v }
  }
  0.0
}
print(f() == 8.5)
// @@CELL_bare_retest_early_return@@
function f(): f64 {
  let v: boolean | f64 = 1.5
  const k = (): boolean => {
    v = 3.5
    true
  }
  if !(v is f64) || k() {
    if v is f64 { return v }
  }
  0.0
}
print(f() == 3.5)
// @@CELL_bare_retest_while@@
let v: boolean | f64 = 1.5
let n = 0
function k(): boolean {
  n = n + 1
  v = if n < 3 { 0.5 + n } else { true }
  n < 4
}
let sum = 0.0
while v is f64 && k() {
  if v is f64 { sum = sum + v } else { sum = sum + 100.0 }
}
print(sum == 104.0)
// @@CELL_path_retest_same@@
type W = { value: f64 | boolean }
function mutate(w: W): boolean {
  w.value = 4.5
  true
}
function f(v: W): f64 {
  if v.value is f64 {
    if mutate(v) {
      if v.value is f64 { return v.value }
    }
  }
  0.0
}
print(f({ value: 1.5 }) == 4.5)
// @@CELL_path_retest_flipped@@
type W = { value: f64 | boolean }
function mutate(w: W): boolean {
  w.value = true
  true
}
function f(v: W): f64 {
  if v.value is f64 {
    if mutate(v) {
      if v.value is f64 { return v.value }
      return -1.0
    }
  }
  0.0
}
print(f({ value: 1.5 }) == -1.0)
// @@CELL_index_retest_same@@
const xs: (f64 | boolean)[] = [1.5]
function mutate(): boolean {
  xs[0] = 6.5
  true
}
function f(): f64 {
  if xs[0] is f64 {
    if mutate() {
      if xs[0] is f64 { return xs[0] }
    }
  }
  0.0
}
print(f() == 6.5)
// @@CELL_capture_retest_index@@
const xs: (i32 | string)[] = [1]
function w() { xs[0] = "s" }
if xs[0] is i32 {
  const c = (): boolean => xs[0] is i32
  w()
  print(!c())
}
// @@CELL_capture_retest_field@@
type O = { v: i32 | string }
const o: O = { v: 1 }
function w() { o.v = "s" }
if o.v is i32 {
  const c = (): boolean => o.v is i32
  w()
  print(!c())
}
// @@CELL_cond_call_first_field_cleared@@
type R = { v: i32, f: (() => i32) | null }
const NF: (() => i32) | null = null
function clrB(q: R): boolean {
  q.f = NF
  return true
}
function F(z: R): boolean {
  if clrB(z) && z.f != null { return z.f() == 5 }
  true
}
print(F({ v: 1, f: () => 5 }))
// @@CELL_cond_call_first_field_set@@
type R = { v: i32, f: (() => i32) | null }
function setB(q: R): boolean {
  q.f = () => 7
  return true
}
function F(z: R): boolean {
  if setB(z) && z.f != null { return z.f() == 7 }
  false
}
print(F({ v: 1, f: null }))
// @@CELL_cond_call_first_bare@@
let g: i32 | null = null
function setg(): boolean {
  g = 41
  true
}
if setg() && g != null { print(g + 1 == 42) } else { print(false) }
// @@CELL_cond_call_first_or_else@@
let g: i32 | null = null
function setg(): boolean {
  g = 41
  false
}
if setg() || g == null { print(false) } else { print(g + 1 == 42) }
