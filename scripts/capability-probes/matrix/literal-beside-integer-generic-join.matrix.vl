// D16205: a number literal an integer binding beside it cannot hold, handed after that binding
// to a generic whose two uses of `T` join over widening. The value under test is such a call's
// result, delivered to every position; the cells vary the generic, the literal and the binding.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function mix<T>(a: T, b: T): T[] { return [a, b] }
function pick<T>(a: T, b: T): T { return b }
const one: i32 = 1
// @@VALUE@@
pick(one, 0.5)
// @@TYPE@@
f64
// @@PROOF@@
print(v)
// @@WANT@@
0.5
// @@CELL_list@@
// want: 0.25
print(mix(one, 0.5)[0] / 4.0)
// @@CELL_wide_integer@@
// want: 5000000000
print(pick(one, 5000000000))
// @@CELL_three_args@@
// want: 0.5
function pick3<T>(a: T, b: T, c: T): T { return c }
print(pick3(one, 2, 0.5))
// @@CELL_f32_adapts@@
// want: 0.6000000238418579
const x: f32 = 0.5
print(mix(x, 0.1)[0] + 0.1)
// @@CELL_int_literal_adapts@@
// want: true
print(pick(one, 2) is i32)
