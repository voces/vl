// D14140: a record whose field is a scalar, delivered where that field is stored as a union
// holding the scalar (`{v: i32}` into `{v: i32 | string}`). The value is a binding, not a
// literal, so no delivery can build it at its destination: each must copy it, boxing the field.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function mk(n: i32): {v: i32} { return {v: n} }
const r0 = mk(5)
// @@VALUE@@
r0
// @@TYPE@@
{v: i32 | string}
// @@PROOF@@
const f = v.v
if f is i32 { print(f + 1) } else { print(f) }
// @@WANT@@
6
// @@TEST@@
v.v is i32
// @@HIT@@
print(1)
// @@MISS@@
print(0)
