// D10294: a generic in a mutually recursive pair joins its non-null parameter and a runtime `f64`
// apart at each pin, as a generic that does not recurse does: each value keeps its own member.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __mgA<T>(q: T | null, d: f64, n: i32) {
  if n > 0 { return __mgB(q, d, n - 1) }
  const r = if q != null { q } else { d }
  r
}
function __mgB<T>(q: T | null, d: f64, n: i32) { __mgA(q, d, n) }
const __mgQ: i32 | null = 5
const __mgN: i32 | null = null
// @@VALUE@@
__mgA(__mgQ, 1.5, 2)
// @@TYPE@@
i32 | f64
// @@PROOF@@
print(v is i32 && v / 2 == 2)
// @@WANT@@
true
// @@VALUE2@@
__mgA(__mgN, 2.5, 3)
// @@TYPE2@@
i32 | f64
// @@PROOF2@@
print(v is f64 && v / 2.0 == 1.25)
// @@WANT2@@
true
