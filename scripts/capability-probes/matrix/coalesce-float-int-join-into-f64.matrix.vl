// D16606 — a `??` over an `f32 | null` whose integer default the `f32` cannot hold joins to
// `f32 | i32` (ruling 4.3), and that join delivered at an `f64` destination converts as a
// whole, so it is 16777217 whichever side was taken. The `f64` face of the D16605 template.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function noneF(): f32 | null { return null }
function someF(): f32 | null { return 1.5 }
// @@VALUE@@
noneF() ?? 16777217
// @@TYPE@@
f64
// @@PROOF@@
print(v)
// @@WANT@@
16777217
// @@VALUE2@@
someF() ?? 16777217
// @@TYPE2@@
f64
// @@PROOF2@@
print(v)
// @@WANT2@@
1.5
