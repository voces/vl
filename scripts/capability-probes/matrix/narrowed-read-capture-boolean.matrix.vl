// D2598 — the value is a read of a `string | boolean` union binding NARROWED to its `boolean` arm, under a
// GUARD. An un-annotated binding set from that read holds the arm's rep, and a closure that
// captures it must type its env field, and its own inferred result, at the arm too: neither
// the env field nor return inference replays the read's narrowing, so both asked the binding's
// box. The module-scope positions were where it showed, since a module frame has no locals to
// resolve the read against.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function __pick(n: i32): string | boolean {
  if n == 0 { return "s" }
  true
}
const __x = __pick(1)
// @@GUARD@@
__x is boolean
// @@VALUE@@
__x
// @@TYPE@@
boolean
// @@FALLBACK@@
true
// @@PROOF@@
print(!v)
// @@WANT@@
false
