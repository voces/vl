// The SOURCE-un-annotated face of the `?? d` over a two-link `?.` chain: the producer's
// return is INFERRED `Inner | null`, so nothing but inference decides the chain's rep. D1826's
// fixture annotates that return, which is exactly the shape the annotate-everything rule warns
// a fixture cannot see through.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function mkI(c: boolean) {
  if c { return { y: { z: 42 } } }
  return null
}
const o = mkI(true)
const q = mkI(false)
// @@VALUE@@
o?.y?.z ?? 0
// @@TYPE@@
i32
// @@FALLBACK@@
0
// @@PROOF@@
print(v)
// @@WANT@@
42
