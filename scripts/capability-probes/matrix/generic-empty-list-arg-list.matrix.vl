// D2607 — an empty `[]` argument for a generic's `xs: T[]`, whose `T` a second argument binds:
// the literal was built as the `i32` list while the instance's parameter is the `T` list.
// `T` is left open. VALUE2 hands a non-empty list, which ran before.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type P = { p: i32 }
function __first<T>(xs: T[], d: T) {
  for e in xs { return e }
  return d
}
// @@VALUE@@
__first([], [8, 9])
// @@TYPE@@
i32[]
// @@PROOF@@
print(v[1])
// @@WANT@@
9
// @@VALUE2@@
__first([[8, 9]], [8, 9])
// @@TYPE2@@
i32[]
// @@PROOF2@@
print(v[1])
// @@WANT2@@
9
