// D5530: a generic function passed to an un-annotated parameter and returned from it, whose type
// a call through the result fixes. The generic's type parameter stays open; the annotated
// face annotates only the destination.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __k<T>(x: T): T {
  return x
}
function __fw(f) {
  return f
}
function __fw2(f) {
  return __fw(f)
}
// @@VALUE@@
__fw(__k)
// @@TYPE@@
(x: i32) => i32
// @@PROOF@@
print(v(41))
// @@WANT@@
41
// @@TEST@@
v(0) == 0
// @@HIT@@
print(v(41))
// @@MISS@@
print(0)
// @@VALUE2@@
__fw2(__k)
// @@TYPE2@@
(x: string) => string
// @@PROOF2@@
print(v("s"))
// @@WANT2@@
s
