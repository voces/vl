// D2544's array-index sibling — an un-annotated function whose tail statement writes a map to
// a list element returns the map just stored.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __mk(): {[i32]: i32} {
  const n: {[i32]: i32} = Map()
  n[1] = 5
  n
}
const __xs: {[i32]: i32}[] = [Map()]
function __tw(xs: {[i32]: i32}[]) { xs[0] = __mk() }
// @@VALUE@@
__tw(__xs)
// @@TYPE@@
{[i32]: i32}
