// D2544's array-index sibling — an un-annotated function whose tail statement writes a map to
// a list element returns the map just stored.
//
// Since the 2026-11-14 return rule (DECISIONS) a block body returns only through `return`, so
// the write is returned as `return <write>`; an assignment's value is its right side (D2497).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __mk(): {[i32]: i32} {
  const n: {[i32]: i32} = Map()
  n[1] = 5
  return n
}
const __xs: {[i32]: i32}[] = [Map()]
function __tw(xs: {[i32]: i32}[]) { return xs[0] = __mk() }
// @@VALUE@@
__tw(__xs)
// @@TYPE@@
{[i32]: i32}
// @@PROOF@@
print(v[1] ?? 0)
// @@WANT@@
5
