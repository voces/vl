// D1714's second niche. The nullable-COLLECTION `??` shares the `br_on_non_null` core with
// the string and struct niches, so a joining default lands in a wrapper-typed block there too.
// The list rides the union box's anyref as its wrapper ref, tagged by its own atom.
//
// The first line is the control: a FITTING list default still takes the `br_on_non_null`
// shape and its bytes must not move.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@SKIP@@
map_value: the builder guards its read with `!= null`, and this template's operand is null by
design so the DEFAULT is what each line proves — the guarded body never runs
// @@PRELUDE@@
type A = { r: i32 }
function st(): A { return { r: 8 } }
function mkL(): i32[] | null { return null }
// @@VALUE@@
mkL()
// @@TYPE@@
i32[] | null
// @@PROOF@@
const f = v ?? [3]
print(f[0])
const j = v ?? 7
if j is i32 { print(j) } else { print(0) }
const k = v ?? st()
if k is A { print(k.r) } else { print(0) }
// @@WANT@@
3 then 7 then 8
