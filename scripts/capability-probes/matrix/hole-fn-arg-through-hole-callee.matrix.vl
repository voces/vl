// D6532: a hole function handed, inside a hole parameter's call, to another hole function that
// calls it at one type; nothing is annotated.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __id(a) { return a }
function __lap(g) { return g(1) + 1 }
function __lapF(g) { return g(1.5) * 2.0 }
function __use(k) { return k(__id) }
// @@VALUE@@
__use(__lap)
// @@TYPE@@
i32
// @@PROOF@@
print(v)
// @@WANT@@
2
// @@TEST@@
v == 2
// @@HIT@@
print(v)
// @@MISS@@
print(0)
// @@VALUE2@@
__use(__lapF)
// @@TYPE2@@
f64
// @@PROOF2@@
print(v + 1.0)
// @@WANT2@@
4
