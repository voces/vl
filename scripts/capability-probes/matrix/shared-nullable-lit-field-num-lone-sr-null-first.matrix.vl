// A shared field read through an un-narrowed union of records, where the field is
// a number literal beside `null` in one member, `i32 | null` in the other (D16031). The union is spelled `S | R` and each field names `null` first.
// The first instance reads `R`'s literal value, the second `S`'s `null`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type R = { x: null | 1, s: string }
type S = { x: null | i32, s: string, extra: i32 }
const r1: R = { x: 1, s: "r" }
const s1: S = { x: null, s: "s", extra: 3 }
const u1: S | R = r1
const u2: S | R = s1
// @@VALUE@@
u1.x
// @@TYPE@@
i32 | null
// @@WANT@@
1
// @@TEST@@
v == null
// @@HIT@@
print("null")
// @@MISS@@
print(v)
// @@VALUE2@@
u2.x
// @@TYPE2@@
i32 | null
// @@PROOF2@@
if v == null { print("null") } else { print(v) }
// @@WANT2@@
null
// @@CELL_param_receiver@@
// want: 1
function rd(u: S | R) {
  const y __A__ = u.x
  if y == null { print("null") } else { print(y) }
}
rd(r1)
// @@CELL_param_receiver_null@@
// want: null
function rd(u: S | R) {
  const y __A__ = u.x
  if y == null { print("null") } else { print(y) }
}
rd(s1)
// @@CELL_coalesce@@
// want: 1
print(u2.x ?? 1)
