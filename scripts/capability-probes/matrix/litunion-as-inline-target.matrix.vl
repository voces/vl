// D5289 — `as!` from a literal-union value to an inline target: a single member literal
// (VALUE) or an inline sub-union of members (VALUE2), at every delivery position and in both
// faces. The PROOF reads the result as an argument of the wide union and as text, so an atom
// read where a string is wanted, or the reverse, cannot pass.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type W = "a" | "b" | "c"
function src(i: i32): W { if i == 0 { "a" } else if i == 1 { "b" } else { "c" } }
function wide(w: W): string { w + "!" }
// @@VALUE@@
src(0) as! "a"
// @@TYPE@@
"a"
// @@PROOF@@
const r = v
print(wide(r) + r)
// @@WANT@@
a!a
// @@VALUE2@@
src(1) as! ("a" | "b")
// @@TYPE2@@
"a" | "b"
// @@PROOF2@@
const r2 = v
print(wide(r2) + r2)
// @@WANT2@@
b!b
// @@SKIP@@
is_in_if: the value is narrowed to one or two members already; the `is` grid is D5286's
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
