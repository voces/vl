// A record of one un-annotated function, delivered at every position and then written whole
// into a binding initialised with another, the binding's field called at two types (D15308's
// bound source). The binding's set is both functions, so each producer is built at its row.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __idA(a) { return a + 1 }
function __idB(a) { return a * 10 }
// @@VALUE@@
{ f: __idB }
// @@TYPE@@
{ f: (a: f64) => f64 }
// @@PROOF@@
let __r = { f: __idA }
const __w0 = __r.f(1)
__r = v
print("\{__w0},\{__r.f(2)},\{__r.f(2.5)}")
// @@WANT@@
2,20,25
// @@SKIP@@
is_in_if: the value is a struct, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
