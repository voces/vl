// Two closures sharing one captured `let`, delivered together in a record.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type CcPair = { inc: () => void, get: () => i32 }
function __mk(): CcPair {
  let n = 0
  return { inc: () => { n = n + 1 }, get: () => n }
}
// @@VALUE@@
__mk()
// @@TYPE@@
CcPair
// @@PROOF@@
v.inc()
v.inc()
print(v.get())
// @@WANT@@
2
