// D16392 — a call's fresh record copied where a record holding a nullable reference is built: a
// nullable function field, a list of nullable records. The built-in positions deliver the call at
// the record, a control; the cells copy it into a list the record's storage builds.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type J = { n: i32, f: (() => i32) | null }
function mk() { { n: 4, f: () => 4 } }
const wideJ: J = mk()
const js = [mk()]
function os0() { { n: 1, f: () => 1 } }
// @@VALUE@@
os0()
// @@TYPE@@
J
// @@PROOF@@
print(v.n)
// @@WANT@@
1
// @@CELL_fn_list_literal@@
// want: 4 1
const ws = [js[0], os0()]
let o = ""
for w in ws { o = o + (if o.length > 0 { " " } else { "" }) + "\{w.f()}" }
print(o)
// @@CELL_fn_list_push@@
// want: 4 1
js.push(os0())
