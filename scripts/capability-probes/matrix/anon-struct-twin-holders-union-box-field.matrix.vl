// D1689 — the same collapse one companion column over: two anonymous holders whose field
// boxes different MEMBER SETS. A box's tags are positional, so the second holder writing the
// first holder's box is a cast failure at run time rather than a refusal.
//
// The first holder lives in the PRELUDE, inside a function nothing calls: `collectAnonShapes`
// walks the whole arena, so its row is minted and available to collide with wherever the value
// under test is delivered.
//
// The two faces measure two different rows, and only the un-annotated one is D1689. The
// prelude holder is un-annotated, so the value's own un-annotated face meets an `#anon` row.
// Its ANNOTATED face gives the value a declared row and the prelude holder then collides onto
// THAT, which is D1674 and red at both seeds.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type U1 = i32 | boolean
type U2 = string | boolean
function u1(): U1 { return 7 }
function u2(): U2 { return "hi" }
function u2b(): U2 { return "ho" }
function firstHolder() {
  const first = { xs: u1() }
  print(first.xs)
}
// @@VALUE@@
{ xs: u2() }
// @@TYPE@@
{ xs: U2 }
// @@PROOF@@
print(v.xs)
// @@WANT@@
hi
// @@VALUE2@@
{ xs: u2b() }
// @@TYPE2@@
{ xs: U2 }
// @@PROOF2@@
print(v.xs)
// @@WANT2@@
ho
// @@SKIP@@
is_in_if: the value is a struct, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
