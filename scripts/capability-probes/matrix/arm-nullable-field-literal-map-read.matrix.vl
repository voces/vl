// D4636 — a record literal that adopts a union arm carrying a nullable field, read back through a
// map. The un-annotated face is the one whose map value type is inferred (`{q:i32}`), which has to
// find the arm whose field is a box; the proof reads the field without a null test of its own.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type U = { q: i32 | null } | { r: i32 }
// @@VALUE@@
{ q: 4 }
// @@TYPE@@
{ q: i32 | null }
// @@PROOF@@
print((v.q ?? 0) + 1)
// @@WANT@@
5
// @@VALUE2@@
{ q: 9 }
// @@TYPE2@@
{ q: i32 | null }
// @@PROOF2@@
print((v.q ?? 0) + 1)
// @@WANT2@@
10
