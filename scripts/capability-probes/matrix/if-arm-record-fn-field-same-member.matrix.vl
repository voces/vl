// A value `if` choosing between two record literals that hold the same un-annotated function in a
// field, at every delivery position, the field called through the delivered record (D15290's
// direct-field case). Its sibling `if-arm-record-fn-field-two-members` holds two functions.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __idA(a) { return a }
const __cA = 1 > 0
// @@VALUE@@
if __cA { { f: __idA } } else { { f: __idA } }
// @@TYPE@@
{ f: (a: i32) => i32 }
// @@PROOF@@
print(v.f(41) + 1)
// @@WANT@@
42
// @@VALUE2@@
if __cA { { f: __idA } } else { { f: __idA } }
// @@TYPE2@@
{ f: (a: i32) => i32 }
// @@PROOF2@@
print(v.f(6) * 2)
// @@WANT2@@
12
// @@SKIP@@
is_in_if: the value is a struct, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
