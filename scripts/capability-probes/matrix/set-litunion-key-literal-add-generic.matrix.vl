// D4350's generic twin: the key comes back through a type parameter left open, bound by the
// literal argument, before it is added to a literal-union-keyed set beside a member literal.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type K = "a" | "b" | "c"
function same<T>(x: T): T { x }
// @@VALUE@@
same("a")
// @@TYPE@@
K
// @@PROOF@@
const s: Set<K> = Set()
s.add(v)
s.add("b")
print(s.has("a") && s.has("b") && !s.has("c"))
// @@WANT@@
true
