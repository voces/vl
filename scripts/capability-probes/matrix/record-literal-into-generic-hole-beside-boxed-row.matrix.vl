// D8920: the generic twin of `record-literal-into-hole-beside-boxed-row`. A record literal handed
// to a parameter declared as a bare type parameter, directly or through a second one, whose body
// reads its field at the literal's own `i32`, while a declared record of the same field names
// boxes the field (`J`). The instance is pinned at the literal's row, so `J` must not be taken.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type J = { f: i32 | null }
function rd<T>(r: T) { return r.f + 1 }
function fwd<T>(a: T) { return rd(a) }
const keepJ: J = { f: null }
const keepF: i32 = keepJ.f ?? 0
// @@VALUE@@
fwd({ f: 4 })
// @@TYPE@@
i32
// @@WANT@@
5
// @@TEST@@
v == 5
// @@HIT@@
print(v + keepF)
// @@MISS@@
print(0)
// @@VALUE2@@
rd({ f: 8 })
// @@TYPE2@@
i32
// @@PROOF2@@
print(v * 2)
// @@WANT2@@
18
