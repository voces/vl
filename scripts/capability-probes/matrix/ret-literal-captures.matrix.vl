// D16291/D16292 family: a hole lambda a function returns, delivered and called.
// @@PRELUDE@@
function adder(n) { return (x) => x + n }
function mk() { return adder(1) }
// @@VALUE@@
mk()
// @@TYPE@@
(x: i32) => i32
// @@PROOF@@
print(v(5))
// @@WANT@@
6
// @@CELL_inline_call@@
print(mk()(5))
// @@CELL_two_makers_bound@@
function mk2() { return mk() }
const k = mk2()
print(k(5))
// @@CELL_two_makers_inline@@
function mk2() { return mk() }
print(mk2()(5))
// @@CELL_generic_param@@
function app<T>(h: (x: T) => T, a: T): T { return h(a) }
print(app(__V__, 5))
// @@CELL_hole_param@@
function ap(h) { return h(5) }
print(ap(__V__))
