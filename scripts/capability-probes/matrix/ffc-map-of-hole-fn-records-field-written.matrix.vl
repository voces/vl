// The un-annotated twin of ffc-map-of-fn-records-field-written: the members take their parameter
// from the field's call, and the map is built by an un-annotated maker.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __inc(n) { return n + 1 }
function __dbl(n) { return n * 2 }
function __mk() {
  const m = Map()
  m["a"] = { f: __inc }
  m["b"] = { f: __inc }
  return m
}
// @@VALUE@@
__mk()
// @@TYPE@@
{[string]: {f: (n: i32) => i32}}
// @@PROOF@@
const r = v["a"]
if r != null { r.f = __dbl }
let c = 0
for k, e in v { c = c + e.f(3) }
print(c)
// @@WANT@@
10
