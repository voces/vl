// D15215: a function's returned record literal holding another function's record result,
// delivered at every position into a record whose nested field stores the number as `i64`. The
// literal is built at the destination and the call inside it at the destination's field, as the
// literal written there builds it.
//
// The PROOF multiplies past `i32`, so a field left at `{f: i32}` storage cannot print the want.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type J = { f: i64 }
type K = { j: J, s: string }
function mk() { { f: 4 } }
function mkw() { { j: mk(), s: "a" } }
// @@VALUE@@
mkw()
// @@TYPE@@
K
// @@PROOF@@
print(v.j.f * 4000000000)
// @@WANT@@
16000000000
// @@SKIP@@
is_in_if: the value is a record, not a union; there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
