// D5287 — a value `if` (VALUE) or `match` (VALUE2) whose one arm is a list LITERAL of a string
// literal union's members and whose other arm is a list of that union, at every delivery
// position and in both faces. The literal arm has no type of its own to offer: it takes the
// destination's where there is one, and the other arm's where there is not. The PROOF reads
// an element both as a return and as an argument, so an atom read where a string is wanted
// cannot pass.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type A = "x" | "y" | "z"
const P: A[] = ["x", "y"]
function falsy() { 1 == 2 }
function pick(xs: A[], i: i32): A { xs[i] }
function show(a: A): string { a + "!" }
// @@VALUE@@
if falsy() { P } else { ["z", "y"] }
// @@TYPE@@
A[]
// @@PROOF@@
const r = v
print(show(pick(r, 1)) + r[0])
// @@WANT@@
y!z
// @@VALUE2@@
match P.length { 2 => ["z"], _ => P }
// @@TYPE2@@
A[]
// @@PROOF2@@
const r2 = v
print(show(r2[0]) + pick(r2, 0))
// @@WANT2@@
z!z
// @@SKIP@@
is_in_if: the value is a list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
