// `x !== null` is the null test `x != null` is (D15975): it narrows `x` to its non-null type, so
// the field read after it needs no further test, at every position the value is delivered to.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type P = { x: i32 }
const src: P = { x: 1 }
const none: P | null = null
// @@VALUE@@
src
// @@TYPE@@
P | null
// @@TEST@@
v !== null && v.x == 1
// @@HIT@@
print("same")
// @@MISS@@
print("other")
// @@WANT@@
same
// @@VALUE2@@
none
// @@TYPE2@@
P | null
// @@PROOF2@@
if v !== null { print(v.x) } else { print("null") }
// @@WANT2@@
null
