// D3522 — `x is string` over a literal union of a string and integers (`1 | 2 | "s"`) tests the
// members whose base is `string`, and narrows to them; its else holds the integer members, whose
// sum proves they were unboxed at `i32`.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type T0 = 1 | 2 | "s"
function pick(n: i32): T0 {
  if n > 1 { return 2 }
  if n > 0 { return 1 }
  "s"
}
// @@VALUE@@
pick(2)
// @@TYPE@@
T0
// @@TEST@@
v is string
// @@HIT@@
print(v + "!")
// @@MISS@@
print(v + 40)
// @@WANT@@
42
// @@VALUE2@@
pick(0)
// @@TYPE2@@
T0
// @@PROOF2@@
if v is string { print(v + "!") } else { print("num") }
// @@WANT2@@
s!
