// v128-list (D1981's array face) — an `F32x4[]`, delivered whole at every position. The list is a
// flat `v128` list; the proof reads its length and a lane back through `sumX`, a typed helper,
// since a getter does not satisfy a hole parameter's field. Own cells write, push, pop, slice
// and walk it, and run the list methods at a vector element.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
import { F32x4, f32x4, splatF32 } from "std:simd"
function mk(n: i32): F32x4[] {
  const r: F32x4[] = []
  let i = 0
  while i < n {
    r.push(f32x4(i as f32, 1.0, 2.0, 3.0))
    i = i + 1
  }
  r
}
function sumX(xs: F32x4[]): f32 {
  let s = 0.0 as f32
  for v in xs { s = s + v.x }
  s
}
// @@VALUE@@
mk(3)
// @@TYPE@@
F32x4[]
// @@TEST@@
v.length == 3 && sumX(v) == 3.0
// @@HIT@@
print(sumX(v))
// @@MISS@@
print("miss")
// @@WANT@@
3
// @@VALUE2@@
mk(4)
// @@TYPE2@@
F32x4[]
// @@PROOF2@@
print(sumX(v) + 1.0)
// @@WANT2@@
7
// @@CELL_index_write@@
// want: 7
const xs__A__ = __V__
xs[2] = xs[2] + splatF32(5.0)
print(xs[2].x)
// @@CELL_compound_write@@
// want: 4
const xs__A__ = __V__
xs[1] += splatF32(3.0)
print(xs[1].x)
// @@CELL_push_pop@@
// want: 4 then 9
const xs__A__ = __V__
xs.push(splatF32(9.0))
print(xs.length)
const p = xs.pop()
if p != null { print(p.x) }
// @@CELL_slice@@
// want: 2
const xs__A__ = __V__
print(sumX(xs.slice(1, 2)) + 1.0)
// @@CELL_map_filter@@
// want: 6 then 2
const xs__A__ = __V__
print(sumX(xs.map((v) => v * splatF32(2.0))))
print(xs.filter((v) => v.x > 0.5).length)
// @@CELL_spread@@
// want: 6
const xs__A__ = __V__
print(sumX([...xs, ...xs]))
// @@CELL_field@@
// want: 3
type Holder = { ps: F32x4[] }
const h: Holder = { ps: __V__ }
print(sumX(h.ps))
// @@CELL_returned_from_lambda@@
// want: 3
const f = () => __V__
print(sumX(f()))
