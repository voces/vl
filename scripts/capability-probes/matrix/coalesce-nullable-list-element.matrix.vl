// D1828 — `xs[i] ?? d` over a list whose element is a NULLABLE NUMERIC scalar. The element
// rides the `{tag, anyref}` value box, so the `??` result is the unboxed scalar and not
// another box; the arm that owns a box operand handed the box on, and every other arm asked
// the operand's TYPE (`i32 | null`) rather than its REP.
//
// The proof prints the ELEMENT, not its nullness: an arm that unboxed at the wrong kind would
// print a different number rather than refuse.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
const elems: (i32 | null)[] = [42, null]
// @@VALUE@@
elems[0] ?? 0
// @@TYPE@@
i32
// @@FALLBACK@@
0
// @@PROOF@@
print(v)
// @@WANT@@
42
// @@VALUE2@@
elems[1] ?? 42
// @@TYPE2@@
i32
// @@PROOF2@@
print(v)
// @@WANT2@@
42
