// A value `if` or `match` choosing between two maps of un-annotated functions, one of a set and one
// of a smaller set within it: the join is a map of the joined set, and the smaller set is decided
// with it (D15393).
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const fnMap = Map()
fnMap.set("a", inc0)
fnMap.set("b", half)
const m2 = Map()
m2.set("a", half)
const k = [1].length > 0
// @@VALUE@@
if k { m2 } else { fnMap }
// @@TYPE@@
{ [string]: (a: f64) => f64 }
// @@PROOF@@
const g = v.get("a")
if g != null { print(g(3)) }
// @@WANT@@
1.5
// @@CELL_returned_join@@
// want: 5.5
function pick(c: boolean) { return if c { m2 } else { fnMap } }
const g = pick(false).get("a")
const h = pick(true).get("a")
if g != null && h != null { print(g(3) + h(3)) }
// @@CELL_returned_join_wider_first@@
// want: 5.5
function pick(c: boolean) { return if c { fnMap } else { m2 } }
const g = pick(true).get("a")
const h = pick(false).get("a")
if g != null && h != null { print(g(3) + h(3)) }
// @@CELL_match_join@@
const n = [1, 2].length
const m = match n {
  1 => fnMap
  _ => m2
}
const g = m.get("a")
if g != null { print(g(3)) }
// @@CELL_join_in_function@@
function go() {
  const m = if k { m2 } else { fnMap }
  const g = m.get("a")
  if g != null { print(g(3)) }
}
go()
// @@CELL_join_read_wider_key@@
// want: 3
const m = if !k { m2 } else { fnMap }
const g = m.get("b")
if g != null { print(g(6)) }
// @@CELL_two_returns@@
// want: 5.5
function pick2(c: boolean) {
  if c { return m2 }
  return fnMap
}
const g = pick2(false).get("a")
const h = pick2(true).get("a")
if g != null && h != null { print(g(3) + h(3)) }
