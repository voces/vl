// `string` and then at `f64`, so each instance's literal takes its element from its own pin. The
// value is an element read back, so it halves only when the second list really is an `f64[]`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __fill(p) {
  const xs = []
  xs.push(p)
  xs.push(p)
  xs[1]
}
const __other = __fill("s")
// @@VALUE@@
__fill(2.5)
