// A union of records every member of which a record contains, delivered at every position
// where that record is declared (D16321): the union box lands in the record slot unboxed, each
// arm stored at the record's layout.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type __A = { x: i32 }
type __B = { x: 1 | 2 }
type __D = { x: 3 | 4 }
function __mk(k: i32): __B | __D {
  if k < 3 { return { x: 1 } }
  return { x: 3 }
}
// @@VALUE@@
__mk(5)
// @@TYPE@@
__A
// @@PROOF@@
print(v.x + 39)
// @@WANT@@
42
// @@SKIP@@
is_in_if: the value is a struct, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
