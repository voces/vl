// The generic twin of fn-value-nullable-fn-param (D9772): the nullable function parameter's
// type is the type parameter, and the value is called at TWO types, so it stays open. No
// function type spells that, so the annotated face refuses by design.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function g<T>(f: ((x: T) => T) | null, x: T): T {
  if f != null { return f(x) }
  x
}
// @@VALUE@@
g
// @@TYPE@@
(f: ((x: i32) => i32) | null, x: i32) => i32
// @@PROOF@@
const __n = v((x: i32) => x + 1, 2) * 10 + v(null, 5)
const __s = v((s: string) => s + "!", "ab") + v(null, "cd")
print(__s.length + __n)
// @@WANT@@
40
// @@SKIP@@
is_in_if: the value is a function, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
