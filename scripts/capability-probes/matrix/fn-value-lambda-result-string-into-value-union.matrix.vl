// D10244: a lambda annotated to return a `string`, or an `f64`, delivered where a function
// returning `f64 | string` is expected. Every position must hand the call an adapter that boxes
// the result.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@VALUE@@
(x: i32): string => "ab"
// @@TYPE@@
(x: i32) => f64 | string
// @@PROOF@@
const r = v(1)
if r is string { print(r.length + 40) } else { print(0) }
// @@WANT@@
42
// @@VALUE2@@
(x: i32): f64 => 1.5
// @@TYPE2@@
(x: i32) => f64 | string
// @@PROOF2@@
const r2 = v(1)
if r2 is string { print(0) } else { print(r2 * 2.0) }
// @@WANT2@@
3
