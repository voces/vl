// D8181: a value union holding inline string literals, handed through an un-annotated parameter
// that a second call clones. The clone keeps the argument's literal members, which its narrowed
// reads are keyed on.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __h(x) { return x }
const __clone = __h(7)
// @@SETUP@@
const __r: i32 | "a" | "b" | null = "b"
// @@VALUE@@
__h(__r)
// @@TYPE@@
i32 | "a" | "b" | null
// @@WANT@@
b
// @@TEST@@
v is i32
// @@HIT@@
print(v + 1)
// @@MISS@@
print(v)
