// A generic function delivered to each position, then put in a `const` list and called through
// the list at TWO types, so the value stays open. No function type spells that, so the annotated
// face refuses by design; the un-annotated face calls each type's instance (D9653).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function id<T>(x: T): T { x }
// @@VALUE@@
id
// @@TYPE@@
(x: i32) => i32
// @@PROOF@@
const __xs = [v]
print(__xs[0]("abc").length * 100 + __xs[0](7))
// @@WANT@@
307
