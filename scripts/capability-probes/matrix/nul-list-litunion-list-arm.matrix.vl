// D12561: an array literal delivered to a nullable list whose element is a union with a list arm
// over a literal union. The literal's own inference softens the literal union to `string`, so it
// must take the destination's type; the proof reads both arms back through `is`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type __K = "a" | "b"
function __sum(xs: ((__K | null)[] | {w: i32})[] | null): i32 {
  let o = 0
  if xs != null {
    const e0 = xs[0]
    if e0 is (__K | null)[] {
      if e0[0] == "a" { o = o + 10 }
      if e0[1] == null { o = o + 100 }
    }
    const e1 = xs[1]
    if e1 is {w: i32} { o = o + e1.w }
  }
  o
}
