// D2974 — a `string | i32` box delivered where `string | i64` is wanted. The destination holds
// the `i32` member only widened, so the box is rebuilt under the `i64` tag; passed raw, every
// read of it in the destination casts the `i32` payload to the `i64` box and traps.
//
// The value is a CALL so no position can re-box a literal; the proof prints through the
// destination's own dispatch, and the second instance proves the payload is an `i64`.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function umwJoin(c: boolean): string | i32 {
  if c { return "s" }
  return 7
}
// @@VALUE@@
umwJoin(false)
// @@TYPE@@
string | i64
// @@PROOF@@
print(v)
// @@WANT@@
7
// @@TEST@@
v is string
// @@HIT@@
print("s")
// @@MISS@@
print(v)
// @@VALUE2@@
umwJoin(true)
// @@TYPE2@@
string | i64
// @@PROOF2@@
print(v)
// @@WANT2@@
s
