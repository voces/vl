// A generic function delivered to each position, listed in a `const`, the list spread into a
// second one written with a fixed-type function, and the source list called through at TWO
// types, so its element stays open. No function type spells that, so the annotated face refuses
// by design; the un-annotated face calls each type's instance and the copy the written one (D9595).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function id<T>(x: T): T { x }
function __inc(x: i32): i32 { x + 1 }
// @@VALUE@@
id
// @@TYPE@@
(x: i32) => i32
// @@PROOF@@
const __xs = [v]
const __ys = [...__xs]
__ys[0] = __inc
print(__ys[0](2) * 100 + __xs[0](7) + __xs[0]("ab").length * 10)
// @@WANT@@
327
