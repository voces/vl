// A map whose values may be `null`, delivered: a stored `null` is a hit for `has` and a miss for
// `??`, and a values walk counts it.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __mk(): {[string]: i32 | null} {
  const m: {[string]: i32 | null} = Map()
  m["a"] = null
  m["b"] = 2
  return m
}
// @@VALUE@@
__mk()
// @@TYPE@@
{[string]: i32 | null}
// @@PROOF@@
print(v.has("a"))
print(v["a"] ?? -1)
print(v["b"] ?? -1)
let n = 0
for w in v.values() {
  if w == null { n = n + 1 }
}
print(n)
// @@WANT@@
true then -1 then 2 then 1
