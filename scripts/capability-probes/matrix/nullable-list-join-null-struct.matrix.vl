// D2236 — an un-annotated `P[] | null` from a join of a non-empty list literal with a
// bare `null`: the binding's slot must be the list wrapper the join builds, not the backing
// array or no shape at all. VALUE is an `if`, VALUE2 a `match`.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type P = { x: i32 }
function truthy() { 1 == 1 }
function one() { 1 }
// @@VALUE@@
if truthy() { [{ x: 7 }] } else { null }
// @@TYPE@@
P[] | null
// @@FALLBACK@@
null
// @@TEST@@
v != null
// @@HIT@@
print(v[0].x)
// @@MISS@@
print("null")
// @@WANT@@
7
// @@VALUE2@@
match one() { 1 => [{ x: 8 }], _ => null }
// @@TYPE2@@
P[] | null
// @@PROOF2@@
if v != null { print(v[0].x) } else { print("null") }
// @@WANT2@@
8
