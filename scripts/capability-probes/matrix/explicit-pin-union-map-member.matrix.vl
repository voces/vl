// D2676 — a type parameter bound only by an explicit type argument: the body's `V | IM` is the
// union the pin mints, so the map it holds keeps its tag and `is` answers from it.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type IM = {[i32]: i32}
function mk<V>(x: IM): V | IM {
  const u: V | IM = x
  if u is IM { return u }
  x
}
function seeded(): IM {
  const m: IM = Map()
  m[1] = 11
  m
}
// @@VALUE@@
mk<string>(seeded())
// @@TYPE@@
string | IM
// @@TEST@@
v is IM
// @@HIT@@
print(v[1] ?? -1)
// @@MISS@@
print("miss")
// @@WANT@@
11
