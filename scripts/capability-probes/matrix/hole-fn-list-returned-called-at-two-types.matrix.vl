// A list literal of un-annotated functions returned from an un-annotated function, delivered
// at every position and read back by a `.map` callback that calls its element at `i32`, while
// a second call of the same function is read back by one that calls it at `f64` (D9450). The
// proof prints the `f64` read only when the `i32` read was right.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __inc(a) { return a + 1 }
function __dbl(a) { return a * 2 }
function __give() {
  return [__inc, __dbl]
}
// @@VALUE@@
__give()
// @@TYPE@@
((a: i32) => i32)[]
// @@PROOF@@
if v.map((f) => f(3))[1] == 6 {
  print(__give().map((f) => f(1.25))[1])
} else {
  print("wrong i32 read")
}
// @@WANT@@
2.5
