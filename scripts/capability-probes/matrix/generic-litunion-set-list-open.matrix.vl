// The open twin of generic-litunion-set-list: `l`'s `T` is bound to another generic's own open
// `U`, so the literal set is joined only when the outer call binds `U` (D7041).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type K = "a" | "b"
type L = "x" | "y"
function l<T>(x: T, o: L): (T | L)[] { return [x, o] }
function fwd<U>(x: U): (U | L)[] { return l(x, "y") }
const a: K = "b"
// @@VALUE@@
fwd(a)
// @@TYPE@@
(K | L)[]
// @@WANT@@
y
// @@TEST@@
v.length == 2
// @@HIT@@
print(v[1])
// @@MISS@@
print("none")
