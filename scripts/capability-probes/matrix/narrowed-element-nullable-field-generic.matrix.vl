// D8145, the generic twin: the narrowed element's field read under its own `!= null` test,
// handed through a type parameter the call leaves open, so inference binds the hole to the
// field's narrowed atom rather than an annotation pinning it.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type J8145g = { r: i32 | null }
type K8145g = { z: i32 }
function keep8145<T>(x: T): T { x }
// @@SETUP@@
const __q: J8145g = { r: 5 }
const __xs: (J8145g | K8145g)[] = [__q, { z: 1 }]
// @@GUARD@@
__xs[0] is J8145g && __xs[0].r != null
// @@VALUE@@
keep8145(__xs[0].r)
// @@TYPE@@
i32
// @@FALLBACK@@
0
// @@TEST@@
v > 4
// @@HIT@@
print(v + 1)
// @@MISS@@
print(0)
// @@WANT@@
6
