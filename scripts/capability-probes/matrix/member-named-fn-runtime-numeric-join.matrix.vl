// D10281: a join of a runtime `i32` and a runtime `f64` in a function named like a member the
// program reads (`get` beside `m.get`, `push` beside `xs.push`) is `i32 | f64`, as it is in a
// function with any other name: each value keeps its own member.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function get(q: i32 | null, d: f64) {
  const r = if q != null { q } else { d }
  r
}
function push(q: i32 | null, d: f64) { q ?? d }
const __mnM: Map<string, i32> = Map()
const __mnXs: i32[] = []
__mnXs.push(__mnM.get("a") ?? 0)
// @@VALUE@@
get(5, 1.5)
// @@TYPE@@
i32 | f64
// @@PROOF@@
print(v is i32 && v == 5)
// @@WANT@@
true
// @@VALUE2@@
push(null, 2.5)
// @@TYPE2@@
i32 | f64
// @@PROOF2@@
print(v is f64 && v == 2.5)
// @@WANT2@@
true
