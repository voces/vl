// D1476 at every delivery position: the value is a struct read out of a container by a
// PROJECTION, and the proof captures it in a lambda and calls through. A projection commits
// no rep the syntactic `letIs*` ladder can read, so `captureValKind` took its i32 default and
// the closure's frame declared an i32 where the struct ref arrives.
//
// The un-annotated face is the one that matters here: annotating the binding commits the rep
// on its own, which is why every fixture in this family that annotates its captures was blind
// to the defect.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
const __src = [{ name: "ada", n: 3 }]
// @@VALUE@@
__src[0]
// @@TYPE@@
{ name: string, n: i32 }
// @@PROOF@@
const __g = () => v
print(__g().n)
// @@WANT@@
3
// @@TEST@@
v.n == 3
// @@HIT@@
const __h = () => v
print(__h().n)
// @@MISS@@
print(0)
// @@SKIP@@
map_value: D1632 — an ANNOTATED rebind of a narrowed struct-valued map read is invalid wasm in BOTH columns; the annotation is the ingredient, the mirror of this row
// @@VALUE2@@
__src[0]
// @@TYPE2@@
{ name: string, n: i32 }
// @@PROOF2@@
const __g2 = () => v
print(__g2().n)
// @@WANT2@@
3
