// D4601 — a record literal into a union whose tagged arm carries a nullable field
// (`{ kind: "a", q: i32 | null }`). The arm is adopted field-wise like any other tagged arm.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type U = { kind: "a", q: i32 | null } | { kind: "b" }
// @@VALUE@@
{ kind: "a", q: 4 }
// @@TYPE@@
U
// @@TEST@@
v.kind == "a"
// @@HIT@@
print(v.q == null)
// @@MISS@@
print("miss")
// @@WANT@@
false
// @@VALUE2@@
{ kind: "a", q: null }
// @@TYPE2@@
U
// @@PROOF2@@
if v.kind == "a" { print(v.q == null) } else { print("b") }
// @@WANT2@@
true
