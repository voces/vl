// D1608 from the other direction: a plain closure is delivered to the position, and the
// PROOF is what captures and calls it. The two templates split by where the capture lives —
// `captured-closure-call` carries it inside the delivered value, this one creates it at the
// delivery site — and only this one can tell a module-scope position from a frame one: a
// `const` at module scope is a GLOBAL, which `capRecord` deliberately does not record as a
// capture, so the module-scope rows are the RUNNING neighbours the fix must not lose and
// `argument`, `local_assign` and the six block rows are the refused ones.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@VALUE@@
(n: i32) => n + 1
// @@TYPE@@
(i32) => i32
// @@PROOF@@
const __cap = (m: i32) => v(m)
print(__cap(54))
// @@WANT@@
55
// @@TEST@@
v(0) == 1
// @@HIT@@
const __h = (m: i32) => v(m)
print(__h(54))
// @@MISS@@
print(0)
// @@VALUE2@@
(n: i32) => n + 12
// @@TYPE2@@
(i32) => i32
// @@PROOF2@@
const __cap2 = (m: i32) => v(m)
print(__cap2(54))
// @@WANT2@@
66
