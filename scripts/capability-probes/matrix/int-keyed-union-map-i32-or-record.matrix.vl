// D2519 — an i32-keyed mono map beside a record, narrowed by `match`.
// The proof reads, writes, deletes, counts and walks the map after narrowing, so a box that
// casts to the wrong map struct fails validation or prints wrong.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type Rec = { n: i32 }
function mk(): {[i32]: i32} {
  const m: {[i32]: i32} = Map()
  m.set(1, 10)
  m.set(2, 20)
  m
}
function pick(n: i32): {[i32]: i32} | Rec {
  if n > 0 { return mk() }
  return { n: 5 }
}
// @@VALUE@@
pick(1)
// @@TYPE@@
{[i32]: i32} | Rec
// @@TEST@@
v is {[i32]: i32}
// @@HIT@@
print(v.length)
print(v.has(1))
print((v.get(1) ?? -1))
v.set(3, 30)
print(v.length)
v.delete(2)
print(v.has(2))
let c = 0
for kk in v { c = c + 1 }
print(c)
print((v[3] ?? -1))
// @@MISS@@
print("miss")
// @@WANT@@
2 then true then 10 then 3 then false then 2 then 30
// @@VALUE2@@
pick(0)
// @@TYPE2@@
{[i32]: i32} | Rec
// @@PROOF2@@
match v {
  {[i32]: i32} => print("map")
  Rec => print(v.n + 1)
}
// @@WANT2@@
6
