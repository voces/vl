// D16897 — a union of a literal-union list and a string list read through a hole: the element
// union `K | string` is a string, not a box, so each arm's element is delivered at that rep and
// a literal-union element widens to its member string.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type K = "a" | "b"
function mk(k: i32): K[] | string[] {
  if k == 0 {
    const s: string[] = ["zz", "y"]
    return s
  }
  const a: K[] = ["b", "a"]
  return a
}
// @@VALUE@@
mk(1)
// @@TYPE@@
K[] | string[]
// @@PROOF@@
print(v.length)
// @@WANT@@
2
// @@VALUE2@@
mk(0)
// @@TYPE2@@
K[] | string[]
// @@PROOF2@@
print(v.length)
// @@WANT2@@
2
// @@CELL_hole_param_element@@
// want: true then b
function take(a__A__) {
  const e = a[0]
  print(e is K)
  print(e)
}
take(__V__)
// @@CELL_hole_param_for@@
// want: b then a
function take(a__A__) {
  for e in a { print(e) }
}
take(__V__)
// @@CELL_hole_param_widen_only@@
// want: 7 then 2
function take(a__A__) {
  const e = a[0]
  const out: string[] = []
  for x in a { out.push(x) }
  print(7)
  print(out.length)
}
take(__V__)
// @@CELL_hole_join_chain@@
// want: true then true then false then true
function g(a0, a1, k: i32) {
  const r = if k == 0 { a0 } else { a1 }
  const e = r[0]
  print(e is K)
  print(e is string)
}
const x0: K = "a"
const x1: string = "y"
g([x0], [x1], 0)
g([x0], [x1], 1)
// @@CELL_hole_join_match@@
// want: a then y
function g(a0, a1, k: i32) {
  const r = match k {
    0 => a0
    _ => a1
  }
  print(r[0])
}
const x0: K = "a"
const x1: string = "y"
g([x0], [x1], 0)
g([x0], [x1], 1)
// @@CELL_hole_param_concat@@
// want: <b> then <ba>
function take(a__A__) {
  print("<" + a[0] + ">")
  let o = ""
  for e in a { o = o + e }
  print("<" + o + ">")
}
take(__V__)
// @@CELL_hole_param_return@@
// want: b
function first(a__A__) { return a[0] }
print(first(__V__))
