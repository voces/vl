// D10161 — a function value whose result is `string`, handed to a generic that takes it as
// `() => T | string`. The result is the union's fixed member, so nothing binds `T`; it takes
// the unbound default, the function is delivered into the union box, and the instance narrows
// the call's value by `is string` and reads it.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function len<T>(f: () => T | string) {
  const t = f()
  if t is string { t.length } else { 99 }
}
// @@VALUE@@
() => "abc"
// @@TYPE@@
() => string
// @@PROOF@@
print(len(v))
// @@WANT@@
3
// @@VALUE2@@
(): string => "hello"
// @@TYPE2@@
() => string
// @@PROOF2@@
print(len(v))
// @@WANT2@@
5
