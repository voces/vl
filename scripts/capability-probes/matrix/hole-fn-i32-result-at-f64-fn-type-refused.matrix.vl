// The spelling that is REFUSED: an un-annotated function whose body gives `i32`, delivered as a
// value at a function type returning `f64` (D9011). A function value is not converted, so this
// is refused exactly as the annotated `inc0(a: i32)` is: the ANNOTATED face must read
// `check refuses` at every position, and never SILENT; the un-annotated face keeps the function's
// own type and runs. The second value is a binding of an un-annotated lambda.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function inc0(a) { return a + 1 }
const __dbl = (a) => a * 2
// @@VALUE@@
inc0
// @@TYPE@@
(a: i32) => f64
// @@PROOF@@
print(v(3))
// @@WANT@@
4
// @@VALUE2@@
__dbl
// @@TYPE2@@
(a: i32) => f64
// @@PROOF2@@
print(v(5))
// @@WANT2@@
10
