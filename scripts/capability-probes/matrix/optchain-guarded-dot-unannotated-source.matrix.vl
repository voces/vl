// The SOURCE-un-annotated face of the guarded-dot chain `o?.y.z`: the producer's return is
// INFERRED `Inner | null`, so the chain's rep comes from inference and not from an annotation
// on either end.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function mkG(c: boolean) {
  if c { return { y: { z: 42 } } }
  return null
}
const g = mkG(true)
const h = mkG(false)
// @@VALUE@@
g?.y.z ?? 0
// @@TYPE@@
i32
// @@FALLBACK@@
0
// @@PROOF@@
print(v)
// @@WANT@@
42
// @@VALUE2@@
h?.y.z ?? 42
// @@TYPE2@@
i32
// @@PROOF2@@
print(v)
// @@WANT2@@
42
