// The un-annotated twin of ffc-record-fn-list-field-pushed: the members' parameter comes from
// the call through the field, and the pushed record is a lambda.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __inc(n) { return n + 1 }
// @@VALUE@@
{ rs: [{ f: __inc }] }
// @@TYPE@@
{rs: {f: (n: i32) => i32}[]}
// @@PROOF@@
v.rs.push({ f: (n) => n * 2 })
let c = 0
for r in v.rs { c = c + r.f(1) }
print(c)
// @@WANT@@
4
