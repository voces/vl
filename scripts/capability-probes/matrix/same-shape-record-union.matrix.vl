// A union of two same-shape records is one record type (D3870): `A | B` is `A`, and a value
// of it is the record itself, with no box and no tag. `v is B` holds for a value built as an
// `A`. Graded at every delivery so a reader that classifies the spelling as a union box, not
// the type as the record, shows as the position it breaks.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type A = { x: i32 }
type B = { x: i32 }
function mkA(): A { return { x: 3 } }
// @@VALUE@@
mkA()
// @@TYPE@@
A | B
// @@TEST@@
v is B
// @@HIT@@
print(v.x)
// @@MISS@@
print(0)
// @@WANT@@
3
