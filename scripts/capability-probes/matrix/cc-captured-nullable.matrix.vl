// A closure over a nullable `let` it writes, delivered and called twice.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __mk() {
  let s: string | null = null
  return (x: string) => {
    s = (s ?? "") + x
    return s ?? ""
  }
}
// @@VALUE@@
__mk()
// @@TYPE@@
(x: string) => string
// @@PROOF@@
v("a")
print(v("b"))
// @@WANT@@
ab
