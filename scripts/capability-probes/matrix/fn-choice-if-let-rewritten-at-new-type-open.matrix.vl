// A `let` of an `if` choosing between two generic functions, written with the same `if`, then
// delivered to each position and called there at TWO types no peer is. No function type spells
// that, so the annotated face refuses by design; the un-annotated face runs (D10321).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function idg<T>(t: T): T { return t }
function kg<T>(t: T): T { return t + t }
let c = [1, 2].length
const p = idg
const i0 = p(3)
let h = if c > 1 { kg } else { idg }
c = [1].length
h = if c > 1 { kg } else { idg }
// @@VALUE@@
h
// @@TYPE@@
(x: f64) => f64
// @@PROOF@@
if v("ab") == "ab" { print(v(2.5) * 2.0 + 0.5) } else { print(0.0) }
// @@WANT@@
5.5
