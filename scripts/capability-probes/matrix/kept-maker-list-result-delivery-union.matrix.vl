// @@CELL_row_union_elements@@
// want: true
// owed: this value is built as Circle[] where
type Cir2 = { c2: i32 }
type Sq2 = { s2: i32 }
type Circle = { r: Cir2 | Sq2 }
function rows() {
  const t = [{ r: { c2: 1 } }, { r: { s2: 5 } }]
