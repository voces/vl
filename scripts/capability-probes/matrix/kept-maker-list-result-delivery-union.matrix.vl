print(h[1].r is Sq2 && !(h2[0].r is Sq2) && __V__.length == 1)
// @@CELL_record_into_record_union@@
// want: true
// owed: this value is built as Ring where
type Cir3 = { c3: i32 }
type Sq3 = { s3: i32 }
type Ring = { r: Cir3 | Sq3 }
function one() { { r: { c3: 1 } } }
const h = one()
const h2: Ring = one()
print(h.r.c3 == 1 && h2.r is Cir3 && __V__.length == 1)
// @@CELL_list_into_union_list@@
// want: true
// owed: this value is built as U where
type U = { f: (i32 | string)[] }
function ul() { { f: [4] } }
const h = ul()
const h2: U = ul()
print(h.f[0] == 4 && h2.f[0] is i32 && __V__.length == 1)
