// A KEPT MAKER whose result is a list of records — `mk2()` returns `[{ f: 7 }]` and one call is
// delivered at `J[]`, whose element stores `f` as `i32 | string` — delivered at every other
// position. The delivery at `J[]` is copied element by element, boxing `f` into the union, so the
// body stays at its own type for every other call. Format: scripts/capability-probes/README.md.
// @@PRELUDE@@
type J = { f: i32 | string }
function mk2() { [{ f: 7 }] }
const dA: J[] = mk2()
const go = [1].length > 0
// @@VALUE@@
mk2()
// @@TYPE@@
{ f: i32 }[]
// @@PROOF@@
print(v[0].f + 1)
// @@WANT@@
8
// @@SKIP@@
is_in_if: the value is a list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
