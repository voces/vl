// D8302: a literal-building function called twice, once delivered into a record that stores a
// field wider than the literal's own and once delivered nowhere, while the program declares a
// record of the literal's own field storage (`II`). The value is the delivered call; the call
// delivered nowhere is in the prelude and read at the literal's own type.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type II = { f: i32 }
type J = { f: i32 | null }
function mk() { { f: 4 } }
const ownK = mk()
const ownF: i32 = ownK.f + 1
// @@VALUE@@
mk()
// @@TYPE@@
J
// @@WANT@@
4
// @@TEST@@
true
// @@HIT@@
print(v.f ?? 0)
// @@MISS@@
print(0)
