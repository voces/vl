// D2493 — two maps of one representation in one union: each has its own box tag.
// The proof reads, writes, deletes, counts and walks the narrowed map, so a box tagged
// by its struct rather than its member type answers the wrong arm and prints wrong.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type L = "p" | "q"
function mka(): {[string]: boolean} {
  const m: {[string]: boolean} = Map()
  m.set("k1", true)
  m.set("k2", false)
  m
}
function mkb(): {[string]: L} {
  const m: {[string]: L} = Map()
  m.set("k1", "p")
  m.set("k2", "q")
  m
}
function pick(n: i32): {[string]: boolean} | {[string]: L} | string {
  if n > 0 { return mkb() }
  return mka()
}
// @@VALUE@@
pick(1)
// @@TYPE@@
{[string]: boolean} | {[string]: L} | string
// @@TEST@@
v is {[string]: L}
// @@HIT@@
print(v.length)
print(v.has("k1"))
print((v.get("k1") ?? "p"))
v.set("k3", "q")
print(v.length)
v.delete("k2")
print(v.has("k2"))
let c = 0
for kk in v { c = c + 1 }
print(c)
print((v["k3"] ?? "p"))
// @@MISS@@
print("miss")
// @@WANT@@
2 then true then p then 3 then false then 2 then q
// @@VALUE2@@
pick(0)
// @@TYPE2@@
{[string]: boolean} | {[string]: L} | string
// @@PROOF2@@
if v is {[string]: boolean} {
  print(v.length)
  print(v.has("k1"))
  print((v.get("k1") ?? false))
  v.set("k3", true)
  print(v.length)
  v.delete("k2")
  print(v.has("k2"))
  let c = 0
  for kk in v { c = c + 1 }
  print(c)
  print((v["k3"] ?? false))
} else { print("wrong") }
// @@WANT2@@
2 then true then true then 3 then false then 2 then true
