// D7183: a `const` joining two hole functions by `if`, and a `for` over a list of them, each
// handed a hole function its body calls at two types, so the argument's parameters stay open
// until the call types them. The value delivered is the sum of what the joins return.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __add(a, b) {
  a + b
}
function __ap2(g) {
  g(1, 2) + g("ab", "c").length
}
function __ap3(g) {
  g(10, 20) + g("x", "y").length
}
function __pick(c: boolean) {
  const f = if c { __ap2 } else { __ap3 }
  f(__add)
}
function __each() {
  let s = 0
  const fs = [__ap2, __ap3]
  for f in fs { s = s + f(__add) }
  s
}
// @@VALUE@@
__pick(true) + __pick(false) + __each()
// @@TYPE@@
i32
// @@PROOF@@
print(v)
// @@WANT@@
76
