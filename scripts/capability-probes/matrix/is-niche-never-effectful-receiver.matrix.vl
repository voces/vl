// D17031 — an `is` test its receiver's nullable niche cannot hold (`mk() is C` over `A | null`)
// is `false`, and its receiver still runs: every delivery position of the test's value, plus an
// assignment and an increment as the receiver's effect. Graded --before / --after the fix.
//
// Format: scripts/capability-probes/README.md, "Template format".

// @@PRELUDE@@
type A = { v: i32 }
type C = { v: i32, s: string }
let n = 0
let q: A | null = { v: 2 }
function mk(): A | null {
  n = n + 1
  return { v: 1 }
}
function clear(): A | null {
  q = null
  return q
}
function bump(): A | null {
  n += 1
  return null
}

// @@VALUE@@
mk() is C

// @@TYPE@@
boolean

// @@PROOF@@
print(v)
print(n)

// @@WANT@@
false then 1

// @@SKIP@@
struct_field_assign: the template spells the value twice (`let v = <value>` then `v = <value>`; capability-matrix.vl's *_assign positions), so two calls make `n` 2; one assignment calls it once; graded by CELL_twice
array_element_assign: same
local_assign: same
global_assign: same

// @@CELL_twice@@
// want: false then 2
let v__A__ = mk() is C
v = mk() is C
print(v)
print(n)

// @@CELL_assignment_receiver@@
// want: false then true
const v__A__ = clear() is C
print(v)
print(q == null)

// @@CELL_increment_receiver@@
// want: false then 1
const v__A__ = bump() is C
print(v)
print(n)

// @@CELL_condition@@
// want: n then 1
if mk() is C { print("y") } else { print("n") }
print(n)

// @@CELL_loop_test@@
// want: 1
let i = 0
while mk() is C && i < 3 { i = i + 1 }
print(n)
