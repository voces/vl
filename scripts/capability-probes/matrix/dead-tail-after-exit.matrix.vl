// D1974 — a value tail after a statement that always exits is not the implicit return: the
// checker does not type it against the declared return, so the emitter must not lower it as
// the result. `pick` holds one at an `if` arm tail and one at the body tail, each of a type
// the declared `string` is not.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function pick(k: i32): string {
  if k > 0 {
    return "p"
    5
  }
  return "n"
  7
}
// @@VALUE@@
pick(1) + pick(0)
// @@TYPE@@
string
// @@PROOF@@
print(v)
// @@WANT@@
pn
