// D4931: a `string[] | i32[]` value passed to a generic that forwards its `V[] | i32[]`
// parameter on to a second generic's `W[] | i32[]`; the forwarding instance has to bind `W`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function len<W>(a: W[] | i32[]) { a.length }
function fwd<V>(a: V[] | i32[]) { len(a) }
// @@VALUE@@
["a", "b"]
// @@TYPE@@
string[] | i32[]
// @@PROOF@@
print(fwd(v))
// @@WANT@@
2
// @@TEST@@
v is i32[]
// @@HIT@@
print(0)
// @@MISS@@
print(fwd(v))
