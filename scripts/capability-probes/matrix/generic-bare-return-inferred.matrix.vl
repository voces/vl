// D5360: a generic function named bare in the `return` of a function with an inferred result,
// whose type the caller's call through the result fixes. The generic's type parameter stays
// open; the annotated face annotates only the destination.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __k<T>(x: T): T {
  return x
}
function __mk() {
  return __k
}
function __mk2() {
  return (__k)
}
// @@VALUE@@
__mk()
// @@TYPE@@
(x: i32) => i32
// @@PROOF@@
print(v(41))
// @@WANT@@
41
// @@TEST@@
v(0) == 0
// @@HIT@@
print(v(41))
// @@MISS@@
print(0)
// @@VALUE2@@
__mk2()
// @@TYPE2@@
(x: string) => string
// @@PROOF2@@
print(v("s"))
// @@WANT2@@
s
