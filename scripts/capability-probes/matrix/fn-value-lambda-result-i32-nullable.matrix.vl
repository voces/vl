// D9742's control: a lambda returning an `i32`, or `null`, delivered where a function returning
// `i32 | null` is expected. The lambda takes the expected result as its own.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@VALUE@@
(x: i32) => x + 1
// @@TYPE@@
(x: i32) => i32 | null
// @@PROOF@@
print((v(40) ?? 0) + 1)
// @@WANT@@
42
// @@VALUE2@@
(x: i32) => null
// @@TYPE2@@
(x: i32) => i32 | null
// @@PROOF2@@
print(v(1) ?? 5)
// @@WANT2@@
5
