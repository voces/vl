// A capture-free lambda taken as a value is the module's one constant closure of that
// function, so the delivery allocates nothing. Function-value `==` compares the id and the env,
// never the closure struct: the second proof pins that two evaluations of one lambda still
// compare equal and two different lambdas still do not.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function mk(): (a: i32) => i32 { (a) => a * 3 + 1 }
// @@VALUE@@
(a: i32) => a * 3 + 1
// @@TYPE@@
(a: i32) => i32
// @@PROOF@@
print(v(4) * 10 + v(1))
// @@WANT@@
134
// @@VALUE2@@
mk()
// @@PROOF2@@
const u = mk()
const o: (a: i32) => i32 = (a) => a * 3 + 1
print(v == u && !(v == o) && v(2) == 7)
// @@WANT2@@
true
// @@SKIP@@
is_in_if: the value is a function, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
