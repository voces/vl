// one-literal-union-rep (owner 2026-10-13) — a record field typed at ONE string literal, read and
// delivered to a `string` destination at every position. The field reps as the interned atom
// whether it is spelled inline (`kind: "circle"`) or through an alias (`kind: KC`), so every
// delivery owes the atom-to-string widening: a position that forgets it prints the interned id,
// or slots an i32 where a string ref is owed (invalid wasm). The proof concatenates, which only a
// real string survives.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type KC = "square"
type C = { kind: "circle", r: i32 }
type Q = { kind: KC, r: i32 }
function mkC(n: i32): C { { kind: "circle", r: n } }
function mkQ(n: i32): Q { { kind: "square", r: n } }
// @@VALUE@@
mkC(1).kind
// @@TYPE@@
string
// @@TEST@@
v == "circle"
// @@HIT@@
print("w=" + v)
// @@MISS@@
print("miss")
// @@WANT@@
w = circle
// @@VALUE2@@
mkQ(0).kind
// @@TYPE2@@
string
// @@PROOF2@@
print("c=" + v)
// @@WANT2@@
c = square
