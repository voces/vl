// D16070: a `const`-bound lambda returns a hole lambda, and its calls deliver the result at two
// function types. Each call builds a fresh closure, so the design owes both deliveries (D12234 is
// the named-function twin, `hole-lambda-returned-by-function-at-two-types`).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
const outer = () => {
  const l = (x) => x
  return l
}
// @@VALUE@@
outer()
// @@TYPE@@
(x: i32) => i32
// @@PROOF@@
print(v(41) + 1)
// @@WANT@@
42
// @@VALUE2@@
outer()
// @@TYPE2@@
(x: string) => string
// @@PROOF2@@
print(v("s"))
// @@WANT2@@
s
