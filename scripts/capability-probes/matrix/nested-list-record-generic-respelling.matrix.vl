// D3790 — a record whose field is a list of records, handed through a generic as a SLICE
// result. The slice's element type is the record re-spelled structurally, so the instance
// mints its own struct row; that row and the declared one must share one heap type, or the
// instance's result mismatches the declared list wherever it is delivered.
//
// The PROOF reads keys and the nested list's length, so a dropped or reordered element, or
// a nested list read through the wrong heap, prints something else.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
import { concat } from "std:array"
type Blow = { tick: i32, dmg: i32 }
type St = { x: f64, key: i32, blows: Blow[] }
function mk(k: i32, n: i32): St {
  const s: St = { x: 1.0, key: k, blows: [] }
  for i in 0 until n { s.blows.push({ tick: i, dmg: 1 }) }
  s
}
const base: St[] = [mk(1, 0), mk(2, 5), mk(3, 2)]
// @@VALUE@@
base.slice(0, 1).concat(base.slice(2, 3))
// @@TYPE@@
St[]
// @@PROOF@@
print(v.length * 1000 + v[0].key * 100 + v[1].key * 10 + v[1].blows.length)
// @@WANT@@
2132
// @@VALUE2@@
base.slice(1, 2).concat(base.slice(0, 1))
// @@TYPE2@@
St[]
// @@PROOF2@@
print(v.length * 1000 + v[0].key * 100 + v[1].key * 10 + v[0].blows.length)
// @@WANT2@@
2215
// @@SKIP@@
is_in_if: the value is a list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
