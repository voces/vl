// A generic function held in a list, read back out and called at one type. The flow table
// fixes the element's instance from that call, at every delivery position of the list.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function id<T>(x: T): T { x }
function twice<T>(x: T): T { x }
// @@VALUE@@
[id]
// @@TYPE@@
((x: i32) => i32)[]
// @@PROOF@@
const g = v[0]
print(g(2))
// @@WANT@@
2
// @@TEST@@
v.length == 1
// @@HIT@@
print(v[0](2))
// @@MISS@@
print(0)
// @@VALUE2@@
[twice]
// @@TYPE2@@
((x: i32) => i32)[]
// @@PROOF2@@
for f in v { print(f(7)) }
// @@WANT2@@
7
