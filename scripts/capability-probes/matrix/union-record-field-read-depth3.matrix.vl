// D15314: a field 3 level(s) into a union of records whose members store it differently,
// delivered at every position; the proof reads the field. A shared field of a union
// reads at the union of its members' own records.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type H = { f: i32 | null }
type K = { g: { h: { f: i32 } } }
type J = { g: { h: H } }
function pickU(c: boolean): K | J {
  if c {
    const k: K = { g: { h: { f: 4 } } }
    return k
  }
  const j: J = { g: { h: { f: null } } }
  return j
}
// @@VALUE@@
pickU(true)
// @@TYPE@@
K | J
// @@PROOF@@
print(v.g.h.f ?? 0)
// @@WANT@@
4
// @@SKIP@@
is_in_if: the proof reads a field shared by both arms; the arm test is not what this grades
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
