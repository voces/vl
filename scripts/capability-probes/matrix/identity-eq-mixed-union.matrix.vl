// Reference identity over a union of a record arm and a function arm (D16039, DECISIONS A15):
// the record compares by its payload's `ref.eq`, the function by declaration and environment,
// so a value delivered through any position stays identical to the one it was read from. The
// second instance is the function arm, held against the record.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type P = { x: i32 }
type F = (i: i32) => i32
function inc(i: i32) { return i + 1 }
const src: P = { x: 1 }
const held: P | F = src
const heldFn: P | F = inc
// @@VALUE@@
src
// @@TYPE@@
P | F
// @@TEST@@
v === held
// @@HIT@@
print("same")
// @@MISS@@
print("other")
// @@WANT@@
same
// @@VALUE2@@
inc
// @@TYPE2@@
P | F
// @@PROOF2@@
if v === heldFn && v !== held { print("fn") } else { print("other") }
// @@WANT2@@
fn
