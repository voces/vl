// A list a record's field holds, of record literals whose function field holds un-annotated
// functions returning different types (D15804): a `for` loop over `mk().a` calls through each
// element's `f`, its result the join of theirs. Each proof sums the calls over the loop
// (4 + 1.5), so a call resolved to one member at compile time cannot pass for the dispatch.
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function mk() { return { a: [{ f: inc0 }, { f: half }] } }
function deep() { return { b: { a: [{ f: inc0 }, { f: half }] } } }
// @@VALUE@@
mk().a
// @@TYPE@@
{ f: (a: i32) => f64 }[]
// @@PROOF@@
let acc = 0.0
for e in v { acc = acc + e.f(3) }
print(acc)
// @@WANT@@
5.5
// @@CELL_loop_over_call_field@@
let acc = 0.0
for e in mk().a { acc = acc + e.f(3) }
print(acc)
// @@CELL_loop_over_bound_record@@
const r = mk()
let acc = 0.0
for e in r.a { acc = acc + e.f(3) }
print(acc)
// @@CELL_loop_two_records_down@@
let acc = 0.0
for e in deep().b.a { acc = acc + e.f(3) }
print(acc)
// @@CELL_loop_field_bound@@
let acc = 0.0
for e in mk().a {
  const g = e.f
  acc = acc + g(3)
}
print(acc)
// @@CELL_loop_captured@@
const gs = []
for e in mk().a { gs.push(() => e.f(3)) }
let acc = 0.0
for g in gs { acc = acc + g() }
print(acc)
// @@CELL_loop_pair@@
let acc = 0.0
for e, i in mk().a { acc = acc + e.f(3 + i - i) }
print(acc)
// @@CELL_loop_in_fn@@
function sum(): f64 {
  let acc = 0.0
  for e in mk().a { acc = acc + e.f(3) }
  acc
}
print(sum())
