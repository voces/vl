// D2666 — an un-annotated tail `if` whose arms assign an `i32`-keyed and an `i64`-keyed map
// joins to their union: the result is the union box, and the `i64`-keyed arm answers its own `is`.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function m32(): {[i32]: i32} {
  const m: {[i32]: i32} = Map()
  m[3] = 30
  m
}
function m64(): {[i64]: i32} {
  const m: {[i64]: i32} = Map()
  m[3 as i64] = 64
  m
}
let ga = m32()
let gb = m64()
function fc(c: boolean) {
  if c { ga = m32() } else { gb = m64() }
}
// @@VALUE@@
fc(false)
// @@TYPE@@
{[i32]: i32} | {[i64]: i32}
// @@TEST@@
v is {[i64]: i32}
// @@HIT@@
print(v[3 as i64] ?? -1)
// @@MISS@@
print("miss")
// @@WANT@@
64
// @@VALUE2@@
fc(true)
// @@TYPE2@@
{[i32]: i32} | {[i64]: i32}
// @@PROOF2@@
if v is {[i32]: i32} { print(v[3] ?? -1) } else { print("wrong") }
// @@WANT2@@
30
