// D1623 at every delivery position: the value is a closure ARRAY, and the proof calls its
// element DIRECTLY in a lambda's tail — `v[0](m)`, with no intermediate binding. That call is
// in statement position, and both ladders that decide statement position (`stmtIsTailValue`
// and `emitCallStmt`) had arms for a `Member` callee and an `Ident` callee and nothing else,
// so an `Index` callee reached `emitProgram: bare call statement is not supported`.
//
// The sibling `paren-callee-tail` is the same hole with no container at all, which is what
// shows that the container read is not the ingredient — the callee SHAPE is.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@VALUE@@
[(n: i32) => n + 1]
// @@TYPE@@
((i32) => i32)[]
// @@PROOF@@
const __cp = (m: i32) => v[0](m)
print(__cp(54))
// @@WANT@@
55
// @@TEST@@
v.length == 1
// @@HIT@@
const __h = (m: i32) => v[0](m)
print(__h(54))
// @@MISS@@
print(0)
// @@VALUE2@@
[(n: i32) => n + 12]
// @@TYPE2@@
((i32) => i32)[]
// @@PROOF2@@
const __cp2 = (m: i32) => v[0](m)
print(__cp2(54))
// @@WANT2@@
66
