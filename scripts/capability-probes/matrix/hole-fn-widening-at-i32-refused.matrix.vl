// The spelling that is REFUSED: the result of an un-annotated function that widens its `i32`
// argument to `f64`, delivered where `i32` is declared (D8161, D8940). Joined with a runtime
// `i32` return the value is `f64 | i32`, and alone it is `f64`; neither fits `i32` without `as`,
// so the ANNOTATED face must read `check refuses` at every position, and never SILENT; the
// un-annotated face infers the wide type and runs.
// `direct-hole-fn-widening-result.matrix.vl` is the twin delivered at `f64`, which runs.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function half(a) { return a / 2.0 }
function halfOr(a) {
  if a > 1 { return a / 2.0 }
  return a
}
// @@VALUE@@
halfOr(3)
// @@TYPE@@
i32
// @@PROOF@@
print(v)
// @@WANT@@
1.5
