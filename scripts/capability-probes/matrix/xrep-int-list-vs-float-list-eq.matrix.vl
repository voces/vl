// D15055: `==` between an `i32[]` and an `f64[]` compares element by element at `f64`. The
// second instance differs only in its last element.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function xrMk(last: i32): i32[] { [1, last] }
function xrF(a: f64, b: f64): f64[] { [a, b] }
const xrEq: f64[] = xrF(1.0, 2.0)
const xrNe: f64[] = xrF(1.0, 2.5)
// @@VALUE@@
xrMk(2)
// @@TYPE@@
i32[]
// @@TEST@@
v == xrEq && v != xrNe
// @@HIT@@
print("value")
// @@MISS@@
print("storage")
// @@WANT@@
value
// @@VALUE2@@
xrMk(3)
// @@TYPE2@@
i32[]
// @@PROOF2@@
print("\{v == xrEq} \{v != xrEq}")
// @@WANT2@@
false true
