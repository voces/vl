// A list of a generic function delivered to each position, then its element read out into a list
// literal beside a fixed-type `i32` function and handed straight to a generic called at `i32`
// (D10251). `fn-value-generic-list-element-literal-arg-open.matrix.vl` is the open twin.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function id<T>(x: T): T { x }
function __inc(x: i32): i32 { x + 1 }
function __run<U>(a: ((x: U) => U)[], u: U): U { a[0](u) * 10 + a[1](u) }
// @@VALUE@@
[id]
// @@TYPE@@
((x: i32) => i32)[]
// @@PROOF@@
print(__run([v[0], __inc], 2))
// @@WANT@@
23
