// D5083: a generic's inferred `T[] | i32[]` return, pinned to a literal's anonymous row. The
// union has to name the row's shape, or the returned list finds no arm at the box. VALUE2 is
// the generic-open face: the call sits in a generic body whose `T` the caller pins.
//
// The PROOF discriminates: the record arm tests false AND its read prints the field, so a fold
// of the test to a constant prints `9`, never `7`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function wrap<T>(t: T, b: boolean) {
  if b { return [t] }
  [1, 2, 3]
}
function viaT<T>(t: T, b: boolean) {
  const r = wrap(t, b)
  r
}
// @@VALUE@@
wrap({ x: 7 }, true)
// @@TYPE@@
{ x: i32 }[] | i32[]
// @@FALLBACK@@
wrap({ x: 7 }, true)
// @@TEST@@
!(v is i32[]) && v.length == 1
// @@HIT@@
print(7)
// @@MISS@@
print(9)
// @@WANT@@
7
// @@VALUE2@@
viaT({ x: 7 }, false)
// @@TYPE2@@
{ x: i32 }[] | i32[]
// @@PROOF2@@
print(v.length)
// @@WANT2@@
3
