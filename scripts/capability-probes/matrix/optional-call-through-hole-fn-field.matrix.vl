// `?.` through a record field typed at a hole (un-annotated) function, the record held in an
// un-annotated `Map()`: the member under the optional chain carries no type of its own, while the
// plain `.f` read is built at its field's storage. A null receiver short-circuits to the `??` arm.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function half(a) { return a / 2.0 }
const m = Map()
m["b"] = { f: half }
const n = Map()
n["b"] = { inner: { f: half } }
// @@VALUE@@
m["b"]?.f(4)
// @@TYPE@@
f64 | null
// @@PROOF@@
print(v ?? -1.0)
// @@TEST@@
v != null
// @@HIT@@
print(v ?? -1.0)
// @@MISS@@
print("miss")
// @@WANT@@
2
// @@CELL_read_field@@
// want: 3
const g = m["b"]?.f
if g != null { print(g(6)) }
// @@CELL_coalesce_default@@
// want: 2
print(m["b"]?.f(4) ?? 0.5)
// @@CELL_chain@@
// want: 4
print(n["b"]?.inner?.f(8) ?? -1.0)
// @@CELL_null_receiver@@
// want: -1
print(m["zz"]?.f(4) ?? -1.0)
// @@CELL_in_function@@
// want: 2 then -1
function k(key: string) { print(m[key]?.f(4) ?? -1.0) }
k("b")
k("zz")
