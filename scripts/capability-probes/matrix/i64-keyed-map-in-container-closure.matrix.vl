// i64-keyed-map-in-container-closure — an i64-keyed map (`{[i64]: (i64) => i64}`) delivered to every container position the
// position matrix knows, the i64 twin of `i32-keyed-map-in-container`. The PROOF writes through the
// delivered map at a key past the i32 range and reads it back, and the second instance reads the
// key whose low half is the first key's, so a map that lost the high half of its keys prints wrong.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function mkMap(): {[i64]: (i64) => i64} {
  const m: {[i64]: (i64) => i64} = Map()
  m.set(4294967296, (x: i64) => x + 1)
  return m
}
// @@VALUE@@
mkMap()
// @@TYPE@@
{[i64]: (i64) => i64}
// @@PROOF@@
v.set(4294967297, (x: i64) => x * 2)
const f = v.get(4294967297) ?? ((x: i64) => x)
print(f(21))
// @@WANT@@
42
// @@VALUE2@@
mkMap()
// @@TYPE2@@
{[i64]: (i64) => i64}
// @@PROOF2@@
const f = v.get(1) ?? ((x: i64) => 0)
print(f(21))
// @@WANT2@@
0
