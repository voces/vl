// D10061: a `??` written at the delivery over an `i32 | null` record field with a runtime `f64`
// default is `i32 | f64`, as the same `??` over a parameter is (the numeric-join ruling). The
// proof tests `is i32`, which the checker refused while the field arm typed the result `f64`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
const __cjO: { v: i32 | null } = { v: 5 }
const __cjN: { v: i32 | null } = { v: null }
const __cjD: f64 = 1.5
// @@VALUE@@
__cjO.v ?? __cjD
// @@TYPE@@
i32 | f64
// @@TEST@@
v is i32
// @@HIT@@
print(v * 2)
// @@MISS@@
print("widened")
// @@WANT@@
10
// @@VALUE2@@
__cjN.v ?? __cjD
// @@TYPE2@@
i32 | f64
// @@PROOF2@@
print(v)
// @@WANT2@@
1.5
