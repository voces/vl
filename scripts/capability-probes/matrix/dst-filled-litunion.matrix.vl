// D4024 (diderven DV-1002) — a string literal argument binds a literal-union `T` from the
// destination when it is a member, so `filled(4, "none")` delivered to `Dress[]` is a
// `Dress[]` and stores the union's other member. Un-annotated, `T` is `string`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
import { filled } from "std:array"
type Dress = "none" | "rubble"
// @@VALUE@@
filled(4, "none")
// @@TYPE@@
Dress[]
// @@PROOF@@
const q = v
q[2] = "rubble"
print(q[2] + q[3])
// @@WANT@@
rubblenone
