// D1511 — an INFERRED-empty list that a `.push` fills with struct literals, delivered
// everywhere and read back. `const xs = []` + `xs.push({y: 1, x: 2})` is the SUBJECT and it
// stays un-annotated in BOTH faces (it lives in @@SETUP@@); the face varies the DESTINATION's
// annotation, which is the annotated twin the report says already runs.
//
// THE TEMPLATE MUST NEVER SPELL `<shape>[]` IN @@PRELUDE@@ OR @@SETUP@@. A single `P[]`
// annotation ANYWHERE in the module mints the ref-list row this defect is the absence of, so a
// declaration there turns every cell green for the wrong reason — the annotated FACE is the
// controlled place for that spelling, one cell at a time.
//
// The PROOF reads the element back three ways in one line — a BOUND element (`p.y`), a DIRECT
// index read (`v[0].x`) and a `for`-in (`q.x`) — because those are the three spellings the
// consumer reported and a row whose element heap type came from the wrong shape would trap or
// print the wrong number rather than pass.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
// @@SETUP@@
const __xs = []
__xs.push({ y: 1, x: 2 })
const __ys = []
__ys.push({ y: 10, x: 20 })
// @@VALUE@@
__xs
// @@TYPE@@
{y:i32,x:i32}[]
// @@PROOF@@
const p = v[0]
let s = 0
for q in v {
  s = s + q.x
}
print(p.y + v[0].x + s)
// @@WANT@@
5
// @@VALUE2@@
__ys
// @@TYPE2@@
{y:i32,x:i32}[]
// @@PROOF2@@
const p2 = v[0]
print(p2.y + v[0].x)
// @@WANT2@@
30
// @@SKIP@@
is_in_if: the value is a list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
