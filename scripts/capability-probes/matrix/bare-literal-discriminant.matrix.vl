// D1460 — the ONE-MEMBER spelling of D1050's mixed discriminant: a named literal-union alias
// in one arm, a BARE single literal in the other. The bound D1050 recorded was "both arms
// carry a 2+-member set"; the member count was never the rep's question, the arena SHAPE was.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type K1 = "circle" | "round"
type A = { kind: K1, r: f64 }
type B = { kind: "a", r: f64 }
function f(n: i32): A | B {
  if n == 0 { return { kind: "circle", r: 1.0 } }
  const w: B = { kind: "a", r: 2.0 }
  return w
}
// @@VALUE@@
f(1)
// @@TYPE@@
A | B
// @@TEST@@
v is B
// @@HIT@@
print(v.r)
// @@MISS@@
print("notB")
// @@WANT@@
2
