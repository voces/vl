// D16710: a generic function returned bare from a maker with an inferred result, relayed by a
// second function with an inferred result, and delivered there: the prelude calls one result of
// the maker at f64, the cell takes the relay's at `(x: i32) => i32`. The second value relays
// through two inferred returns.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __k<T>(x: T): T {
  return x
}
function __mk() {
  return __k
}
const __o = __mk()
const __of: f64 = __o(2.5)
function __dlv() {
  return __mk()
}
function __rly() {
  return __dlv()
}
// @@VALUE@@
__dlv()
// @@TYPE@@
(x: i32) => i32
// @@PROOF@@
print(v(41))
// @@WANT@@
41
// @@TEST@@
v(0) == 0
// @@HIT@@
print(v(41))
// @@MISS@@
print(0)
// @@VALUE2@@
__rly()
// @@TYPE2@@
(x: i32) => i32
// @@PROOF2@@
print(v(42))
// @@WANT2@@
42
