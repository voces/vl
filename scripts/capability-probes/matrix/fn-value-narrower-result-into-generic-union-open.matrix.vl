// The open twin of fn-value-narrower-result-into-generic-union: the function value is a
// generic's own `() => V` result, so its result type is bound by inference at the maker's call.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function mkF<V>(x: V): () => V { (): V => x }
function len<T>(f: () => T | string) {
  const t = f()
  if t is string { 0 } else { 1 }
}
// @@VALUE@@
mkF(4)
// @@TYPE@@
() => i32
// @@PROOF@@
print(len(v))
// @@WANT@@
1
// @@VALUE2@@
mkF(2.5)
// @@TYPE2@@
() => f64
// @@PROOF2@@
print(len(v))
// @@WANT2@@
1
