// D2605 — a `i32[] | null` passed through an UN-ANNOTATED parameter and returned: the instance's
// result was declared at the non-null rep, so a null argument trapped (or, for a map, set or
// closure, the module was invalid). VALUE is the null combination, VALUE2 the non-null one.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function __mkm(): {[string]: i32} {
  const m: {[string]: i32} = Map()
  m["k"] = 6
  m
}
function __mks(): Set<i32> {
  const s: Set<i32> = Set()
  s.add(3)
  s
}
function __mk(n: i32): i32[] | null {
  if n == 2 { return null }
  [4, 5]
}
function __hole(v) { v }
// @@VALUE@@
__hole(__mk(2))
// @@TYPE@@
i32[] | null
// @@TEST@@
v == null
// @@HIT@@
print("null")
// @@MISS@@
print(v[1])
// @@WANT@@
null
// @@VALUE2@@
__hole(__mk(1))
// @@TYPE2@@
i32[] | null
