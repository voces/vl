// D8380: a function with an inferred return hands back a generic identity's object literal; one
// call is read at the literal's own type, and the value is delivered into a union holding a
// record that stores a field wider than the literal's own. The literal is built as that member.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type J = { r: i32 | null }
function idn<T>(v: T): T { v }
function deliver() { return idn({ r: 4 }) }
const ownR: i32 = deliver().r
// @@VALUE@@
deliver()
// @@TYPE@@
J | string
// @@WANT@@
4
// @@TEST@@
v is J
// @@HIT@@
print(v.r ?? 0)
// @@MISS@@
print(0)
// @@SKIP@@
array_element_place: a narrowed list element re-read for a nullable field is D8145, with no generic call in it
