const f = fnMap.get(ks[1])
if f != null { print(f(6) + f(4)) }
// @@CELL_keys_loop_has@@
let t = 0.0
for k in fnMap.keys() {
  if fnMap.has(k) {
    const f = fnMap.get(k)
    if f != null { t = t + f(6) }
  }
}
print(t)
// @@CELL_keys_loop_in_function@@
function walk() {
  let t = 0.0
  for k in fnMap.keys() {
    const f = fnMap.get(k)
    if f != null { t = t + f(6) }
  }
  print(t)
}
walk()
