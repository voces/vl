// A map of two un-annotated functions read by the keys its own `keys()` hands out, the functions
// called at two types: `keys()` reads no value, so the map's set is tagged as at a literal-key
// read (D15353).
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const fnMap = Map()
fnMap.set("a", inc0)
fnMap.set("b", half)
// @@VALUE@@
fnMap
// @@TYPE@@
{ [string]: (a: f64) => f64 }
// @@PROOF@@
let t = 0.0
for k in v.keys() {
  const f = v.get(k)
  if f != null { t = t + f(6) }
}
print(t)
// @@WANT@@
10
// @@CELL_keys_loop_module@@
let t = 0.0
for k in fnMap.keys() {
  const f = fnMap.get(k)
  if f != null { t = t + f(6) }
}
print(t)
// @@CELL_keys_bound_first@@
const ks = fnMap.keys()
let t = 0.0
for k in ks {
  const f = fnMap.get(k)
  if f != null { t = t + f(6) }
}
print(t)
