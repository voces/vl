// D5361: a never-written alias of a generic function, delivered where the destination's type or
// the calls through it fix the generic's type. The generic's type parameter stays open; the
// annotated face annotates only the destination.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __k<T>(x: T): T {
  return x
}
const __h = __k
const __j = __h
// @@VALUE@@
__h
// @@TYPE@@
(x: i32) => i32
// @@PROOF@@
print(v(41))
// @@WANT@@
41
// @@TEST@@
v(0) == 0
// @@HIT@@
print(v(41))
// @@MISS@@
print(0)
// @@VALUE2@@
__j
// @@TYPE2@@
(x: string) => string
// @@PROOF2@@
print(v("s"))
// @@WANT2@@
s
