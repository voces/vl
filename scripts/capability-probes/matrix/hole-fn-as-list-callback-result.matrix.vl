// An un-annotated function handed to `.map` / `.filter` over a list (D8944). The callback's
// result is its body's at the element, so `[3].map(half)` is `f64[]` and `.filter(pos)` keeps
// the receiver's `i32[]`; a lambda or an annotated `half(a: i32): f64` is typed by its own
// spelling and cannot see the defect.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function half(a) { return a / 2.0 }
function pos(a) { return a > 0 }
// @@VALUE@@
[3].map(half)
// @@TYPE@@
f64[]
// @@PROOF@@
print(v[0] * 2.0)
// @@WANT@@
3
// @@VALUE2@@
[3, -1].filter(pos)
// @@TYPE2@@
i32[]
// @@PROOF2@@
print(v[0] + v.length)
// @@WANT2@@
4
