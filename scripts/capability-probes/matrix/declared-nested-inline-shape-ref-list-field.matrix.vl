// D1692 — the value under test is an inline shape whose own field is a STRUCT-element ref
// list (`A[]`, field code 5). Every position that names a TYPE puts that shape inside a
// second one, so `struct_field_init`'s `type __W = { f: { xs: A[] } }` is the declared
// nested inline shape the row is about; the un-annotated face is the anonymous mint's.
//
// The element `A` is declared BEFORE the holder here and AFTER it in the depth-2 sibling,
// because the declaration walk classifies a nested shape before the struct table exists —
// so an element with a row and an element without one are two different questions.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type A = { r: i32 }
function as1(): A[] { return [{ r: 4 }] }
function as2(): A[] { return [{ r: 5 }] }
// @@VALUE@@
{ xs: as1() }
// @@TYPE@@
{ xs: A[] }
// @@PROOF@@
print(v.xs[0].r)
// @@WANT@@
4
// @@VALUE2@@
{ xs: as2() }
// @@TYPE2@@
{ xs: A[] }
// @@PROOF2@@
print(v.xs[0].r)
// @@WANT2@@
5
// @@SKIP@@
is_in_if: the value is a struct, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
