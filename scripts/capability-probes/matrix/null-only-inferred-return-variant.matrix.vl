// D1567's nullable-VARIANT face: the same `null`-typed call delivered where the destination
// is `Circle | null` over a DECLARED union — the `nulvariant` NICHE, a `(ref null
// $uVarHeap[vi])` and not a box (D1563). `nullref` is a subtype of that heap exactly as
// it is of the plain struct's, so the destination needs no coercion and the two faces of the
// rep have one answer.
//
// `Sq` and the `Shape` alias are what make `Circle` an ARM; delete either and the
// destination is an ordinary `nulstruct` and the sibling template covers it.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type Circle = { r: i32 }
type Sq = { w: i32 }
type Shape = Circle | Sq
function __np() {
  return null
}
// @@SETUP@@
const __s: Shape = { r: 3 }
// @@VALUE@@
__np()
// @@TYPE@@
Circle | null
// @@TEST@@
v != null
// @@HIT@@
print(v.r)
// @@MISS@@
print("none")
// @@WANT@@
none
// @@SKIP@@
map_value: a map whose VALUE is `null` cannot be told from a missing key — the read's `!= null` guard is false either way, so the proof prints nothing at both seeds
