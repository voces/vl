// A list `+` over two scalar list reps one widens into: `[1.5] + [2]` converts the `i32[]`
// operand to `f64` element-wise, and `ib + ia` the left `i32[]` into an `i64[]` (D4858). The
// proof divides, so a value left in the i32 rep cannot print the right answer.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
const ia: i64[] = [5]
const ib = [7]
// @@VALUE@@
[1.5] + [2]
// @@TYPE@@
f64[]
// @@PROOF@@
print(v[1] / 4.0 + v.length)
// @@WANT@@
2.5
// @@VALUE2@@
ib + ia
// @@TYPE2@@
i64[]
// @@PROOF2@@
print(v[0] * 3000000000 + v[1])
// @@WANT2@@
21000000005
// @@SKIP@@
is_in_if: the value is a list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
