// D8141: a fresh call delivered into a union holding a record wider than the call's own, where
// the program declares a record of the call's storage (`Col`). The union member cannot adopt
// the call's result, so the annotated positions refuse; none is invalid wasm.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type Col = { r: i32, g: i32 }
type J = { r: i32 | null, g: i32 }
function mk() { { r: 15, g: 1 } }
// @@VALUE@@
mk()
// @@TYPE@@
J | string
// @@WANT@@
15
// @@TEST@@
v is J
// @@HIT@@
print(v.r ?? 0)
// @@MISS@@
print(0)
