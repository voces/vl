// A literal set over two bases tested against a scalar union, at every position: each base's
// members are tested under that base's tag, so the numeric member is not lost.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type __K = 1 | "a"
function __mk(k: i32): i32 | string {
  if k > 0 { return k }
  "a"
}
// @@VALUE@@
__mk(1)
// @@TYPE@@
i32 | string
// @@TEST@@
v is __K
// @@HIT@@
print(42)
// @@MISS@@
print(0)
// @@WANT@@
42
