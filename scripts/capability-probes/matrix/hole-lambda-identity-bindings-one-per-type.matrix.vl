// Two bindings of one hole lambda handed through an identity, each called at its own type:
// each binding takes the lambda's copy at its type (D6241).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function fw(f) { return f }
const lam = (x) => x
const q = fw(lam)
const r = fw(lam)
// @@VALUE@@
"\{q(3)}" + r("w")
// @@TYPE@@
string
// @@PROOF@@
print(v)
// @@WANT@@
3w
// @@VALUE2@@
r("z") + "\{q(4)}"
// @@TYPE2@@
string
// @@PROOF2@@
print(v)
// @@WANT2@@
z4
