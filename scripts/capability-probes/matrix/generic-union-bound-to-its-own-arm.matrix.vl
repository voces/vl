// A generic's `T | B` with the type parameter left open and bound to `B` itself at the call, so
// the instance's result is the record `B` with no union around it (D7050).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type B = { x: i32 }
function mkB(): B { return { x: 3 } }
function orB<T>(v: T): T | B { return v }
// @@VALUE@@
orB(mkB())
// @@TYPE@@
B
// @@TEST@@
v.x > 0
// @@HIT@@
print(v.x)
// @@MISS@@
print(0)
// @@WANT@@
3
