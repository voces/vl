// D2199 — an `if` value whose arms carry different literal sets, delivered to every position at
// a declared set wider than the join. One arm is the atom (`A`), the other a one-literal value
// (`G`), and the join records the atom arm's own type, so every delivery has to narrow each arm
// where it is produced rather than stage the join as a string.
//
// The TEST is a compare, which is what the atom exists for, and the HIT prints the value, which
// is what proves the member survived the delivery (an id would print a number).
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
const A: "red" | "green" = "red"
const G: "green" = "green"
function one(): i32 { 1 }
// @@VALUE@@
if one() > 0 { G } else { A }
// @@TYPE@@
"red" | "green" | "blue"
// @@TEST@@
v == "green"
// @@HIT@@
print(v)
// @@MISS@@
print("miss")
// @@WANT@@
green
// @@VALUE2@@
if one() > 1 { G } else { A }
// @@TYPE2@@
"red" | "green" | "blue"
// @@PROOF2@@
print("c=" + v)
// @@WANT2@@
c=red
