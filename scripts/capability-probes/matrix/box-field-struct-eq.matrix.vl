// D1290 — `==` over a struct whose FIELD is a value-union BOX (`i32 | null`). The box
// field is the ingredient (ablated: give the field a plain `i32` and the same compare runs
// at every position), because the field ladder had no code-16 arm and the union box is the
// one field rep whose compare is a tag test plus a per-arm payload compare.
//
// The PROOF discriminates rather than just building: the box arm has to be READ, so a
// compare that answered `true` for a tag-only lowering would not print `2`.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type A = { d: i32 | null }
const same: A = { d: 3 }
const diff: A = { d: 4 }
const nul: A = { d: null }
// @@VALUE@@
{ d: 3 }
// @@TYPE@@
A
// @@FALLBACK@@
{ d: 0 }
// @@TEST@@
v == same
// @@HIT@@
if v == diff { print(0) } else { if v == nul { print(1) } else { print(2) } }
// @@MISS@@
print(9)
// @@WANT@@
2
