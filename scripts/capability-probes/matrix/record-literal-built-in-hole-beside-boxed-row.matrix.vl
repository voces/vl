// D8682: a record literal built inside a hole's body from the hole and read there, while the
// program declares a record of the same field names that stores the field boxed (`A`). The
// literal's field is the hole's `i32`, so the read inside the instance is bare.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type A = { d: i32 | null }
function g(x) {
  const w = { d: x }
  return w.d + 1
}
const keepA: A = { d: null }
const keepD: i32 = keepA.d ?? 0
// @@VALUE@@
g(3)
// @@TYPE@@
i32
// @@WANT@@
4
// @@TEST@@
v == 4
// @@HIT@@
print(v + keepD)
// @@MISS@@
print(0)
