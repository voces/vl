// D16390 — a radix constant tree read at an `f64`, delivered there or beside an `f64` operator
// peer, computes at 64 bits with integer division and then converts (owner ruling 2026-11-15,
// reversing D14990's f64 clause). The bare pattern reads its own digits; no destination is i32,
// so the un-annotated face and an inferred return print the ruled `999`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
const p: f64 = 0.5
// @@VALUE@@
0xFFFFFFFF + 1000
// @@TYPE@@
f64
// @@PROOF@@
print(v)
// @@WANT@@
4294968295
// @@CELL_peer_right@@
// want: 4294968295.5
print(p + (0xFFFFFFFF + 1000))
// @@CELL_peer_left@@
// want: 4294968295.5
print((0xFFFFFFFF + 1000) + p)
// @@CELL_peer_left_unparenthesised@@
// want: 8589934590.5
print(0xFFFFFFFF * 2 + p)
// @@CELL_peer_minus@@
// want: 4294967294.5
print(0xFFFFFFFF - 1 + p)
// @@CELL_peer_times@@
// want: 2147483648
print(2.0 * (0x80000000 >> 1))
// @@CELL_peer_compare@@
// want: true
print(p < 0xFFFFFFFF + 1)
// @@CELL_peer_eq@@
// want: false
print(p == 0xFFFFFFFF + 1)
// @@CELL_compound_assign@@
// want: 4294967296.5
let x = p
x += 0xFFFFFFFF + 1
print(x)
// @@CELL_integer_division@@
// want: 2147483647
const y: f64 = 0xFFFFFFFF / 2
print(y)
// @@CELL_shift_wide@@
// want: 8589934588
const y: f64 = 0x7FFFFFFF << 2
print(y)
// @@CELL_negated@@
// want: -4294967294
const y: f64 = -0xFFFFFFFF + 1
print(y)
// @@CELL_join_tail@@
// want: 4294968295
const c = true
const y: f64 = 0xFFFFFFFF + if c { 1000 } else { 1 }
print(y)
// @@CELL_nullable_dst@@
// want: 4294967296
const y: f64 | null = 0xFFFFFFFF + 1
print(y ?? 0.0)
// @@CELL_bare_pattern@@
// want: 4294967295
const y: f64 = 0xFFFFFFFF
print(y)
// @@CELL_no_destination_i32@@
// want: 0
print(0xFFFFFFFF + 1)
// @@CELL_as_f32_value@@
// want: 4294967296
print(0xFFFFFFFF as f32)
