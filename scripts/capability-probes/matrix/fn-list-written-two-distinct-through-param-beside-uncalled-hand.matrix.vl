// D15136 with distinct functions: a list of two functions, each element written a different
// function of another result type by a callee an uncalled function also hands a list to.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __inc(a) { return a + 1 }
function __half(a) { return a / 2.0 }
function __third(a) { return a / 3.0 }
function __put(ys) {
  ys[0] = __half
  ys[1] = __third
}
function _hand(zs) { return __put(zs) }
// @@SETUP@@
const __xs = [__inc, __inc]
__put(__xs)
// @@VALUE@@
__xs
// @@TYPE@@
readonly ((a: i32) => i32 | f64)[]
// @@PROOF@@
print(v[0](3) + v[1](6))
// @@WANT@@
3.5
