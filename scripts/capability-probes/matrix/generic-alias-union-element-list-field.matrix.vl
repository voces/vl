// D12560: a generic alias whose field is `T[]`, applied at a union. The field's element is the
// union, so its list needs a ref-list slot of that union; the second value binds `T` to the
// union by inference through a generic constructor, so no cell spells the union at the call.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type __Box<T> = { xs: T[] }
function __mk<T>(a: T, b: T): __Box<T> {
  return { xs: [a, b] }
}
const __ua: i32 | string = 1
const __ub: i32 | string = "z"
// @@VALUE@@
{ xs: [1, "z"] }
// @@TYPE@@
__Box<i32 | string>
// @@TEST@@
v.xs.length == 2
// @@HIT@@
print(v.xs[1])
// @@MISS@@
print("miss")
// @@WANT@@
z
// @@VALUE2@@
__mk(__ua, __ub)
// @@TYPE2@@
__Box<i32 | string>
// @@PROOF2@@
print(v.xs[1])
// @@WANT2@@
z
