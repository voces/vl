// D1592 — `.push` in VALUE position. The checker types `xs.push(v)` `i32` (the new length)
// and no position lowered that value: bound / argument / returned it was `emitProgram: callee
// is not a function name`, and as a function's inferred TAIL it was check-clean invalid wasm
// (the emitter classified the function void while the caller read the checker's `i32`).
//
// THE PROOF READS THE VALUE, not the list, so a cell that lowers a constant or drops the value
// prints the wrong number rather than passing. The receiver starts at length 1 and each cell
// pushes ONCE, so the answer is 2 at every position; `VALUE2` uses a SECOND list so the
// `two_instances` cell also wants 2 rather than 3.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
const mxs: i32[] = [1]
const mys: i32[] = [1]
// @@VALUE@@
mxs.push(7)
// @@TYPE@@
i32
// @@PROOF@@
print(v)
// @@WANT@@
2
// @@TEST@@
v == 2
// @@HIT@@
print(2)
// @@MISS@@
print(0)
// @@VALUE2@@
mys.push(7)
// @@TYPE2@@
i32
// @@PROOF2@@
print(v)
// @@WANT2@@
2
// @@SKIP@@
local_assign: delivers the VALUE TWICE (init then reassign) and `.push` MUTATES, so the second delivery answers 3 — the right answer, which `@@WANT@@` cannot express
struct_field_assign: delivers the VALUE TWICE, so the second push answers 3 (see local_assign)
array_element_assign: delivers the VALUE TWICE, so the second push answers 3 (see local_assign)
