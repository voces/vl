// D4615 — a union whose arm holds a nullable field of the union itself, delivered as the union.
// The arm's `next: Node | null` field is the box of the declaring union or null, and every
// position that builds the value writes that field; the proof walks the chain to its end.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type Node = { v: i32, next: Node | null } | { e: i32 }
function sumNode(n: Node | null): i32 {
  if n == null { return 0 }
  if n is { e: i32 } { return n.e * 100 }
  return n.v + sumNode(n.next)
}
// @@VALUE@@
{ v: 3, next: { v: 2, next: { e: 1 } } }
// @@TYPE@@
Node
// @@PROOF@@
print(sumNode(v))
// @@WANT@@
105
// @@VALUE2@@
{ v: 4, next: null }
// @@TYPE2@@
Node
// @@PROOF2@@
print(sumNode(v))
// @@WANT2@@
4
