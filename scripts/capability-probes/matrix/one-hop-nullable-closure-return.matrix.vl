// The ONE-hop control D1622's grading list names: a nullable closure from a function whose
// return IS annotated, so the niche was resolvable all along. It ran before that row and must
// keep running at every position — the ingredient the sibling template adds is the second,
// INFERRED hop, and a fix that moved this one would have changed the wrong ladder.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function __mkNulClo1(): ((i32) => i32) | null {
  return (n: i32) => n + 1
}
// @@VALUE@@
__mkNulClo1()
// @@TYPE@@
((i32) => i32) | null
// @@PROOF@@
if v != null { print(v(54)) } else { print(0) }
// @@WANT@@
55
// @@TEST@@
v != null
// @@HIT@@
if v != null { print(v(54)) } else { print(0) }
// @@MISS@@
print(0)
// @@FALLBACK@@
null
// @@VALUE2@@
__mkNulClo1()
// @@TYPE2@@
((i32) => i32) | null
// @@PROOF2@@
if v != null { print(v(65)) } else { print(0) }
// @@WANT2@@
66
