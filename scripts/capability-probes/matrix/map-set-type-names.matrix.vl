// A15 item 3 — `Map<K, V>` / `Set<T>` as TYPE names, graded at every delivery position in
// both faces. The annotated face spells the type with the new names; the map is built behind an
// index-signature return, so every map delivery is a flow between the two spellings. `Set<T>`
// is its own type (owner ruling Q2), so the set is built behind a `Set<string>` return.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function mkm(): {[string]: i32} {
  const m: {[string]: i32} = Map()
  m["a"] = 3
  m
}
function mks(): Set<string> {
  const s: Set<string> = Set()
  s.add("x")
  s
}
// @@VALUE@@
mkm()
// @@TYPE@@
Map<string, i32>
// @@PROOF@@
print(v["a"] ?? -1)
// @@WANT@@
3
// @@VALUE2@@
mks()
// @@TYPE2@@
Set<string>
// @@PROOF2@@
print(v.has("x"))
// @@WANT2@@
true
