// A list-literal spread of an `i32[]` alone into a list of `f64 | null`: each element is
// widened and then boxed (D2882). The un-annotated face is a plain `i32[]` copy.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
const src: i32[] = [3, 4]
// @@VALUE@@
[...src]
// @@TYPE@@
(f64 | null)[]
// @@PROOF@@
const e = v[1]
if e != null { print(e * 2 + v.length) } else { print("miss") }
// @@WANT@@
10
// @@SKIP@@
is_in_if: the value is a list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
