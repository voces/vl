// A narrowed box-field read (D17048): a box local narrowed by a discriminant compare, its one-
// literal field `f: "y"` (an atom row shared with `A`'s "x" | "y") read at each delivery position.
// Every cell prints the field's value, decoded where its storage is not the destination's rep.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type A = { tag: "b" | "c", f: "x" | "y" }
type B = { tag: "a", f: "y" }
function mk(n: i32): A | B {
  if n == 0 { return { tag: "b", f: "x" } }
  return { tag: "a", f: "y" }
}
// @@SETUP@@
const b = mk(2)
// @@GUARD@@
b.tag == "a"
// @@VALUE@@
b.f
// @@TYPE@@
string
// @@FALLBACK@@
"n"
// @@PROOF@@
print(v)
// @@TEST@@
v == "y"
// @@HIT@@
print("y")
// @@MISS@@
print("n")
// @@CELL_param_return@@
function h(b: A | B)__A__ {
  if b.tag == "a" { return __V__ }
  return "x"
}
const v = h(mk(2))
print(v)
// @@CELL_param_binding@@
function h(b: A | B) {
  if b.tag == "a" {
    const v__A__ = __V__
    print(v)
  }
}
h(mk(2))
// @@CELL_param_element@@
function h(b: A | B) {
  if b.tag == "a" {
    const xs__LA__ = [__V__]
    const v = xs[0]
    print(v)
  }
}
h(mk(2))
// @@CELL_param_argument@@
function take(v: __TY__) { print(v) }
function h(b: A | B) {
  if b.tag == "a" { take(__V__) }
}
h(mk(2))
// @@WANT@@
y
