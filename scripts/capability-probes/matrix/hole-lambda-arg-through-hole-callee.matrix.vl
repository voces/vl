// D6532: an un-annotated lambda, written in place or held by a `const`, handed inside a hole
// parameter's call to a hole function that calls it at one type; nothing is annotated.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
const __twice = (a) => a * 2
function __lap(g) { return g(1) + 1 }
function __lapF(g) { return g(1.5) * 2.0 }
function __use(k) { return k((a) => a * 10) }
function __useC(k) { return k(__twice) }
// @@VALUE@@
__use(__lap) + __useC(__lap)
// @@TYPE@@
i32
// @@PROOF@@
print(v)
// @@WANT@@
14
// @@TEST@@
v == 14
// @@HIT@@
print(v)
// @@MISS@@
print(0)
// @@VALUE2@@
__useC(__lapF)
// @@TYPE2@@
f64
// @@PROOF2@@
print(v + 1.0)
// @@WANT2@@
7
