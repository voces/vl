// D11220 — `m[k] as! N2` over a map whose values are a numeric literal union. `N2` is one
// `i32` atom and the fused map probe yields that `i32`, so every destination that leaves the
// type to inference must take the atom, not the union box.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type N2 = 1 | 2
const m: {[string]: N2} = Map()
m["q"] = 1
m["r"] = 2
// @@VALUE@@
m["q"] as! N2
// @@TYPE@@
N2
// @@TEST@@
v == 1
// @@HIT@@
print(v + 10)
// @@MISS@@
print(0)
// @@WANT@@
11
// @@VALUE2@@
m["r"] as! N2
// @@TYPE2@@
N2
// @@PROOF2@@
print(v + 20)
// @@WANT2@@
22
