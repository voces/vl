// Per instance: a generic function spreads a list literal holding a record whose function field is
// a generic function named at T into a push onto an annotated list. At i32 (3) and at string
// (ab). D16571, and the bare name of D16572.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __id<T>(x: T): T { return x }
function __run<T>(x: T): {f: (x: T) => T}[] {
  const rs: {f: (x: T) => T}[] = []
  rs.push(...[{ f: __id }])
  return rs
}
// @@VALUE@@
__run(3)
// @@TYPE@@
{f: (x: i32) => i32}[]
// @@PROOF@@
for r in v { print(r.f(3)) }
// @@WANT@@
3
// @@VALUE2@@
__run("ab")
// @@TYPE2@@
{f: (x: string) => string}[]
// @@PROOF2@@
for r in v { print(r.f("ab")) }
// @@WANT2@@
ab
// @@CELL_string_first@@
// want: ab then 3
const a = __run("ab")
print(a[0].f("ab"))
const b = __run(3)
print(b[0].f(3))
// @@CELL_four_instances@@
// want: 3 then ab then false then 2.5
print(__run(3)[0].f(3))
print(__run("ab")[0].f("ab"))
print(__run(true)[0].f(false))
print(__run(2.5)[0].f(2.5))
// @@CELL_body_bare_name@@
// want: 3 then ab
function __runB<T>(x: T) {
  const rs: ((x: T) => T)[] = []
  rs.push(...[__id])
  return rs
}
print(__runB(3)[0](3))
print(__runB("ab")[0]("ab"))
// @@CELL_body_two_elements@@
// want: 2 then 3 then ab
function __runT<T>(x: T) {
  const rs: {f: (x: T) => T}[] = []
  rs.push(...[{ f: __id }, { f: __id }])
  return rs
}
print(__runT(3).length)
print(__runT(3)[1].f(3))
print(__runT("ab")[1].f("ab"))
// @@CELL_body_after_direct_push@@
// want: 2 then 3 then ab
function __runD<T>(x: T) {
  const rs: {f: (x: T) => T}[] = []
  rs.push({ f: __id })
  rs.push(...[{ f: __id }])
  return rs
}
print(__runD(3).length)
print(__runD(3)[1].f(3))
print(__runD("ab")[1].f("ab"))
// @@CELL_body_paren@@
// want: 3 then ab
function __runP<T>(x: T) {
  const rs: {f: (x: T) => T}[] = []
  rs.push(...([{ f: __id }]))
  return rs
}
print(__runP(3)[0].f(3))
print(__runP("ab")[0].f("ab"))
// @@CELL_body_nested_record@@
// want: 3 then ab
function __runN<T>(x: T) {
  const rs: {g: {f: (x: T) => T}}[] = []
  rs.push(...[{ g: { f: __id } }])
  return rs
}
print(__runN(3)[0].g.f(3))
print(__runN("ab")[0].g.f("ab"))
// @@CELL_body_list_element@@
// want: 3 then ab
function __runL<T>(x: T) {
  const rs: ((x: T) => T)[][] = []
  rs.push(...[[__id]])
  return rs
}
print(__runL(3)[0][0](3))
print(__runL("ab")[0][0]("ab"))
// @@CELL_body_called@@
// want: 3 then ab
function __runC<T>(x: T): T {
  const rs: {f: (x: T) => T}[] = []
  rs.push(...[{ f: __id }])
  return rs[0].f(x)
}
print(__runC(3))
print(__runC("ab"))
// @@CELL_body_field_list@@
// want: 3 then ab
function __runF<T>(x: T) {
  const o: {rs: {f: (x: T) => T}[]} = { rs: [] }
  o.rs.push(...[{ f: __id }])
  return o.rs
}
print(__runF(3)[0].f(3))
print(__runF("ab")[0].f("ab"))
// @@CELL_body_unannotated_list@@
// want: 3 then ab
function __runU<T>(x: T) {
  const rs = []
  rs.push(...[{ f: __id }])
  return rs
}
print(__runU(3)[0].f(3))
print(__runU("ab")[0].f("ab"))
// @@CELL_body_spread_initialiser@@
// want: 3 then ab
function __runI<T>(x: T) {
  const rs: {f: (x: T) => T}[] = [...[{ f: __id }]]
  return rs
}
print(__runI(3)[0].f(3))
print(__runI("ab")[0].f("ab"))
// @@CELL_body_spread_initialiser_bare_name@@
// want: 3 then ab
function __runJ<T>(x: T) {
  const rs: ((x: T) => T)[] = [...[__id]]
  return rs
}
print(__runJ(3)[0](3))
print(__runJ("ab")[0]("ab"))
