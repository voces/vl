// D1568's nullable-VARIANT face. `Circle | null` over a DECLARED union is the `nulvariant`
// NICHE, not a box (D1563), so its field cell is a `(ref null $uVarHeap[vi])` and a
// bare `null` stored into it needs the arm's heap, not the ambient one. The store arm reaches
// it through `sFieldTgtStructIdx`, whose arena leg resolves the arm's layout twin row — the
// same row `emitObjField`'s construct-side seed uses, which is the property that keeps the
// two halves of the field code from disagreeing.
//
// `Sq` and the `Shape` alias are what make `Circle` an ARM; delete either and the field is an
// ordinary `nulstruct` and the sibling template covers it.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type Circle = { r: i32 }
type Sq = { w: i32 }
type Shape = Circle | Sq
// @@SETUP@@
const __s: Shape = { r: 3 }
// @@VALUE@@
null
// @@TYPE@@
Circle | null
// @@TEST@@
v != null
// @@HIT@@
print(v.r)
// @@MISS@@
print("none")
// @@WANT@@
none
// @@SKIP@@
map_value: a map whose VALUE is `null` cannot be told from a missing key — the read's `!= null` guard is false either way, so the proof prints nothing at both seeds
