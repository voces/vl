// D15450: a function nested in a non-generic function, capturing its encloser's parameter, and a
// choice between two such functions, handed to a hole parameter called at two types. Every cell
// prints `18`, then `12`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __both(f) {
  const a: i32 = f(4)
  const b: string = f("ab")
  return a + b.length
}
function __single(n: i32) {
  function inner(s) {
    if n < 0 { return s }
    return s
  }
  return __both(inner)
}
function __choice(c: boolean, n: i32) {
  function inner(s) {
    if n < 0 { return s }
    return s
  }
  function ask(s) { return s }
  return __both(if c { inner } else { ask })
}
// @@VALUE@@
__single(1) + __choice(true, 2) + __choice(false, 3)
// @@TYPE@@
i32
// @@PROOF@@
print(v)
// @@WANT@@
18
// @@TEST@@
v == 18
// @@HIT@@
print(v)
// @@MISS@@
print(0)
// @@VALUE2@@
__choice(true, 5) + __single(6)
// @@TYPE2@@
i32
// @@PROOF2@@
print(v)
// @@WANT2@@
12
