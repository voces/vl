// D16842: an un-annotated function held in a record a runtime `if` chooses, handed through a
// generic identity, read and called at every position: the function is instanced at the one
// signature the calls through its place's class agree on.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __hinc(a) { return a + 1 }
function __hinc1(a) { return a + 2 }
function __hid(x) { return x }
const __hn = 3
const __hr = __hid(if __hn > 2 { { f: __hinc } } else { { f: __hinc1 } })
// @@VALUE@@
__hr.f(3)
// @@TYPE@@
i32
// @@TEST@@
v == 4
// @@HIT@@
print(1)
// @@MISS@@
print(0)
// @@WANT@@
1
// @@CELL_inline_read@@
// want: 4
print(__hid({ f: __hinc }).f(3))
// @@CELL_declared_generic_list@@
// want: 4
function __hidt<T>(x: T): T { return x }
const __hxs = __hidt([__hinc])
print(__hxs[0](3))
// @@CELL_declared_generic_record@@
// want: 4
function __hidt2<T>(x: T): T { return x }
const __hrr = __hidt2({ f: __hinc })
print(__hrr.f(3))
// @@CELL_handed_and_called@@
// want: 13 then 14
function __happ(o) { return o.f(12) }
print(__happ({ f: __hinc }))
print(__happ({ f: __hinc1 }))
// @@CELL_written_after@@
// want: 5
const __hw = __hid({ f: __hinc })
__hw.f = __hinc1
print(__hw.f(3))
