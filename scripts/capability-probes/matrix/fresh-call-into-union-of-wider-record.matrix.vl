// A fresh call whose literal is beside a declared record of its fields (`Col`) delivered into a
// union whose record member stores a field more widely (`J | string`, `r: i32 | null`): the call
// is built at the member and boxed under its tag (D8141).
// @@PRELUDE@@
type Col = { r: i32, g: i32 }
type J = { r: i32 | null, g: i32 }
function mkU() { { r: 15, g: 1 } }
// @@VALUE@@
mkU()
// @@TYPE@@
J | string
// @@TEST@@
v is J
// @@HIT@@
if v is J { print(v.r ?? 0) }
// @@MISS@@
print(0)
// @@WANT@@
15
