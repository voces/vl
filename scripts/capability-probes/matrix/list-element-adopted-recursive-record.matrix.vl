// D10040 — a record literal with a `null` field, beside a declared record that nests itself
// through that field, listed in an un-annotated list literal and read back. The literal is
// held as the declared record, so the list's element must be that record's row.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type Node = {v: i32, next: Node | null}
// @@VALUE@@
{v: 7, next: null}
// @@TYPE@@
Node
// @@FALLBACK@@
{v: 0, next: null}
// @@PROOF@@
const __xs = [v]
print(__xs[0].v)
// @@WANT@@
7
// @@VALUE2@@
{v: 3, next: {v: 4, next: null}}
// @@TYPE2@@
Node
// @@PROOF2@@
const __ys = [v]
const __n = __ys[0].next
if __n != null { print(__ys[0].v + __n.v) }
// @@WANT2@@
7
