// D10090, the open face: the recursive functions of `recursive-fn-runtime-numeric-join` generic
// over the nullable argument's type, called at `i32`. A recursive generic still joins at master's
// widening (D3494, D10280), so this face grades what that gate does.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __rjgSelf<T>(q: T | null, d: f64, n: i32) {
  if n > 0 { return __rjgSelf(q, d, n - 1) }
  const r = if q != null { q } else { d }
  r
}
function __rjgA<T>(q: T | null, d: f64, n: i32) {
  if n > 0 { return __rjgB(q, d, n - 1) }
  q ?? d
}
function __rjgB<T>(q: T | null, d: f64, n: i32) { __rjgA(q, d, n) }
const __rjgQ: i32 | null = 5
const __rjgN: i32 | null = null
// @@VALUE@@
__rjgSelf(__rjgQ, 1.5, 2)
// @@TYPE@@
i32 | f64
// @@PROOF@@
print(v is i32 && v == 5)
// @@WANT@@
true
// @@VALUE2@@
__rjgA(__rjgN, 2.5, 2)
// @@TYPE2@@
i32 | f64
