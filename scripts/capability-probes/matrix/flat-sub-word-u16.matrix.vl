// D15978 (owner ruling (a), DECISIONS "A sub-word field of a `flat` record has storage
// semantics"): a `u16` field of a `flat` record stores as a `u16[]` element does, keeping the low
// bits of a computed value at its width, and a read widens it back to `i32`. The value under test
// is a `flat` record built from the computed 70000, which reads back as 4464. The cells add the
// store spellings: a literal in range, a computed field in a literal, field assignment, a nested
// `flat`, a list element's field, and the out-of-range literal the design refuses.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
flat type P = { a: u16, c: i32 }
flat type W = { p: P, z: i32 }
function k(n: i32) { n }
function mk(n: i32): P { return { a: n, c: 7 } }
// @@VALUE@@
mk(k(70000))
// @@TYPE@@
P
// @@WANT@@
4464
// @@TEST@@
v.c == 7
// @@HIT@@
print(v.a)
// @@MISS@@
print("miss")
// @@VALUE2@@
mk(k(65537))
// @@TYPE2@@
P
// @@PROOF2@@
print(v.a)
// @@WANT2@@
1
// @@CELL_literal_in_range@@
// want: 60000
const p: P = { a: 60000, c: 7 }
print(p.a)
// @@CELL_computed_in_literal@@
const p: P = { a: k(70000), c: 7 }
print(p.a)
// @@CELL_field_assign@@
const p__A__ = __V__
p.a = k(70000)
print(p.a)
// @@CELL_nested_flat@@
const w: W = { p: __V__, z: 1 }
print(w.p.a)
// @@CELL_list_elem_field@@
const ps__LA__ = [mk(0)]
ps[0].a = k(70000)
print(ps[0].a)
// @@CELL_read_arith@@
// want: 4465
const p__A__ = __V__
print(p.a + 1)
// @@CELL_literal_out_of_range@@
// owed: does not fit
const p: P = { a: -3, c: 7 }
print(p.a)
