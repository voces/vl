// D10882, generic twin: the `B<U>` value reaches the reading generic through a second generic
// whose `U` stays open, and the inner field is a list read as `v.s.g.length`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type B<U> = { s: { g: U } }
type L<U> = { s: { g: U[] } }
function __get<T>(v: B<T>): T { v.s.g }
function __outer<U>(v: B<U>): U { __get(v) }
function __len<T>(v: L<T>): i32 { v.s.g.length }
function __outerL<U>(v: L<U>): i32 { __len(v) }
// @@VALUE@@
{ s: { g: 3 } }
// @@TYPE@@
B<i32>
// @@PROOF@@
print(__outer(v) * 10)
// @@WANT@@
30
// @@VALUE2@@
{ s: { g: [3, 4] } }
// @@TYPE2@@
L<i32>
// @@PROOF2@@
print(__outerL(v))
// @@WANT2@@
2
// @@SKIP@@
is_in_if: the value is a record, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
