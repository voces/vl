// A hole call's result, where the handed function is un-annotated and widens its `i32`
// argument to `f64` (D8100).
//
// Every type is left OPEN: `call3`'s parameter is a hole, and so are `half`'s and the
// lambda's, so the value's `f64` comes only from the handed body at the call's argument type.
// An annotated `half(a: i32): f64` pins the result and cannot see the defect.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function half(a) { return a / 2.0 }
const quarter = (a) => a / 4.0
function call3(h) { return h(3) }
// @@VALUE@@
call3(half)
// @@TYPE@@
f64
// @@PROOF@@
print(v * 2.0)
// @@WANT@@
3
// @@VALUE2@@
call3(quarter)
// @@TYPE2@@
f64
// @@PROOF2@@
print(v * 4.0)
// @@WANT2@@
3
