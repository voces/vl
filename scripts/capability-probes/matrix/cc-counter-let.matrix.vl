// A closure over a `let` it writes, delivered and called three times: each call sees the last write.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __mk() {
  let n = 0
  return () => {
    n = n + 1
    return n
  }
}
// @@VALUE@@
__mk()
// @@TYPE@@
() => i32
// @@PROOF@@
v()
v()
print(v())
// @@WANT@@
3
