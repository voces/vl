// A generic `(T | null)[]` result whose `T` is bound to a string literal union (D12451): each
// element is the literal union's niche, read at the instance's rep, at every position, in both
// faces.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type K = "a" | "b"
function f<T>(x: T): (T | null)[] { [x, null] }
const k: K = "b"
// @@VALUE@@
f(k)
// @@TYPE@@
(K | null)[]
// @@PROOF@@
print((if v[0] == "b" { 10 } else { 0 }) + (if v[1] == null { v.length } else { 0 }))
// @@WANT@@
12
// @@SKIP@@
is_in_if: the value is a list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
