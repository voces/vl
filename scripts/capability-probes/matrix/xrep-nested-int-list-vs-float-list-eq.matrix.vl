// D15092: `==` between an `i32[][]` and an `f64[][]`: the cross-storage loop runs at each list
// level, comparing the leaves at `f64`. The second instance differs only in an inner element.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function xrMk(last: i32): i32[][] { [[1], [2, last]] }
function xrF(last: f64): f64[][] { [[1.0], [2.0, last]] }
const xrEq: f64[][] = xrF(3.0)
const xrNe: f64[][] = xrF(3.5)
// @@VALUE@@
xrMk(3)
// @@TYPE@@
i32[][]
// @@TEST@@
v == xrEq && v != xrNe
// @@HIT@@
print("value")
// @@MISS@@
print("storage")
// @@WANT@@
value
// @@VALUE2@@
xrMk(4)
// @@TYPE2@@
i32[][]
// @@PROOF2@@
print("\{v == xrEq} \{v != xrEq}")
// @@WANT2@@
false true
