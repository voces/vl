// D1171 — an EMPTY inline shape (`{}`) delivered in a NULLABLE position. The ingredient is
// emptiness plus INLINE plus nullable: the alias spelling (`type E = {}` then `E | null`)
// always ran, `{x: i32} | null` always ran, and the non-nullable inline empty spellings
// (`{}`, `{} | {x: i32}`) always ran. Only the inline empty in a nullable position reached
// `fbValtype` as `nulstruct` with structIdx -1, because `internInlineShapeTy` refused every
// zero-field split as malformed and no struct row was ever minted for it.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function mkE(n: i32): {} | null {
  if n == 0 { return {} }
  null
}
// @@VALUE@@
mkE(0)
// @@TYPE@@
{} | null
// @@FALLBACK@@
null
// @@TEST@@
v != null
// @@HIT@@
print(11)
// @@MISS@@
print(-1)
// @@WANT@@
11
