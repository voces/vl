// D1707 — the value is an inline shape whose own field is typed as a union ARM (`C`, a member
// of `type Shape = C | S`). At `struct_field_init` that becomes `type __W = { f: { xs: C } }`,
// the declared nested inline shape the row is about; the un-annotated face is the anonymous
// mint's, which already ran.
//
// An arm-typed field stores through the struct row the arm SHARES (D761), and that row is
// minted on demand by the declaration walk — so the ingredient is whether the mint happens
// before the nested shape asks for it, not whether the arm has a rep at all.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type C = { r: i32 }
type S = { s: i32 }
type Shape = C | S
function mk1(): C { return { r: 4 } }
function mk2(): C { return { r: 5 } }
// @@VALUE@@
{ xs: mk1() }
// @@TYPE@@
{ xs: C }
// @@PROOF@@
print(v.xs.r)
// @@WANT@@
4
// @@VALUE2@@
{ xs: mk2() }
// @@TYPE2@@
{ xs: C }
// @@PROOF2@@
print(v.xs.r)
// @@WANT2@@
5
// @@SKIP@@
is_in_if: the value is a struct, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
