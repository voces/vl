// D2199 — the join of `litunion-if-join-arms-disagree.matrix.vl` behind a condition that is
// itself a string test: a compare against a member's spelling, an `else if` link, and an `is`
// test. The condition is lowered outside the atom context its `if` value is emitted under, so
// a string literal in it stays a string; that template's `one() > 0` cannot see the leak.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
const A: "red" | "green" = "red"
const G: "green" = "green"
function s() { "green" }
function k(): string | i32 { "green" }
// @@VALUE@@
if s() == "red" { A } else if k() is string { G } else { A }
// @@TYPE@@
"red" | "green" | "blue"
// @@TEST@@
v == "green"
// @@HIT@@
print(v)
// @@MISS@@
print("miss")
// @@WANT@@
green
// @@VALUE2@@
if s() == "green" { A } else { G }
// @@TYPE2@@
"red" | "green" | "blue"
// @@PROOF2@@
print("c=" + v)
// @@WANT2@@
c=red
