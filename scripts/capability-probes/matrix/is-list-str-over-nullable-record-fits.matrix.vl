// `v is string[]` over `(string | null)[] | P[]`, `v` from the nullable arm. Element kinds that
// store alike share a box tag, and the test must still answer by the value (D17052).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type S = "a" | "b"
type K = 1 | 2
type P = { q: i32 }
function mk(c: boolean): (string | null)[] | P[] {
  const a: (string | null)[] = ["a"]
  const b: P[] = [{ q: 1 }]
  if c { return a }
  return b
}
// @@VALUE@@
mk(true)
// @@TYPE@@
(string | null)[] | P[]
// @@TEST@@
v is string[]
// @@HIT@@
print(true)
// @@MISS@@
print(false)
// @@WANT@@
true
