// D2493 — two maps of one representation in one union: each has its own box tag.
// The proof reads, writes, deletes, counts and walks the narrowed map, so a box tagged
// by its struct rather than its member type answers the wrong arm and prints wrong.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type L = "p" | "q"
function mka(): {[i64]: i32} {
  const m: {[i64]: i32} = Map()
  m.set(4294967296, 10)
  m.set(-3, 20)
  m
}
function mkb(): {[i64]: boolean} {
  const m: {[i64]: boolean} = Map()
  m.set(4294967296, true)
  m.set(-3, false)
  m
}
function pick(n: i32): {[i64]: i32} | {[i64]: boolean} {
  if n > 0 { return mkb() }
  return mka()
}
// @@VALUE@@
pick(1)
// @@TYPE@@
{[i64]: i32} | {[i64]: boolean}
// @@TEST@@
v is {[i64]: boolean}
// @@HIT@@
print(v.length)
print(v.has(4294967296))
print((v.get(4294967296) ?? false))
v.set(7, true)
print(v.length)
v.delete(-3)
print(v.has(-3))
let c = 0
for kk in v { c = c + 1 }
print(c)
print((v[7] ?? false))
// @@MISS@@
print("miss")
// @@WANT@@
2 then true then true then 3 then false then 2 then true
// @@VALUE2@@
pick(0)
// @@TYPE2@@
{[i64]: i32} | {[i64]: boolean}
// @@PROOF2@@
if v is {[i64]: i32} {
  print(v.length)
  print(v.has(4294967296))
  print((v.get(4294967296) ?? -1))
  v.set(7, 30)
  print(v.length)
  v.delete(-3)
  print(v.has(-3))
  let c = 0
  for kk in v { c = c + 1 }
  print(c)
  print((v[7] ?? -1))
} else { print("wrong") }
// @@WANT2@@
2 then true then 10 then 3 then false then 2 then 30
