// @@CELL_sliced_get@@
const rs__A__ = __V__
const s = rs.slice(0, two())
let acc = 0.0
let i = 0
while i < two() {
  const x = s.get(i)?.f(3) ?? 0.0
  acc = acc + x
  i = i + 1
}
print(acc)
// @@CELL_map_value_opt_call@@
const m = Map()
m["a"] = { f: inc0 }
m["b"] = { f: half }
print((m["a"]?.f(3) ?? 0.0) + (m["b"]?.f(3) ?? 0.0))
// @@CELL_record_opt_call@@
const c = two() > 1
const r = if c { { f: inc0 } } else { { f: half } }
const q = if c { { f: half } } else { { f: inc0 } }
print((r?.f(3) ?? 0.0) + (q?.f(3) ?? 0.0))
