// A `?.` call through the function field of a record whose functions return different types
// (D15801): the call runs the member stored there, its result the join of theirs, or `null`.
// The list is read at a runtime index, so a call resolved to one member at compile time cannot
// pass for the dispatch. Cells: an element read by index, by `.get`, a `.get` bound first, a
// map value and a record. A `.get` call's `?.` result is bound before the sum: inside an
// assignment's operand it is D15803's, whatever the field holds.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function two() { [1, 2].length }
function mk() { return [{ f: inc0 }, { f: half }] }
// @@VALUE@@
[{ f: inc0 }, { f: half }]
// @@TYPE@@
{ f: (a: i32) => f64 }[]
// @@PROOF@@
let acc = 0.0
let i = 0
while i < two() {
  acc = acc + (v[i]?.f(3) ?? 0.0)
  i = i + 1
}
print(acc)
// @@WANT@@
5.5
// @@SKIP@@
is_in_if: the value is a list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
// @@CELL_get@@
const rs__A__ = __V__
let acc = 0.0
let i = 0
while i < two() {
  const x = rs.get(i)?.f(3) ?? 0.0
  acc = acc + x
  i = i + 1
}
print(acc)
