// D6200: a generic handed to two parameters of one type parameter `F` that is also the result
// type, each parameter called at its own type: the second takes a type parameter of its own,
// and the result keeps the first's instance.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function same<T>(k: T): T { k }
function take(a) { a("x") }
function take2(a) { a(3) }
function mid<F>(a: F, a1: F): F {
  const s = take(a)
  const n = take2(a1)
  a
}
const __mm = mid(same, same)
// @@VALUE@@
__mm("y")
// @@TYPE@@
string
// @@PROOF@@
print(v)
// @@WANT@@
y
// @@VALUE2@@
mid(same, same)("z")
// @@TYPE2@@
string
// @@PROOF2@@
print(v)
// @@WANT2@@
z
