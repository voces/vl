// D2238 — a `u8[] | null` bound first and then delivered, so the `argument` and
// `early_return_guard` cells pin an un-annotated parameter to the packed byte list and read
// its element through the `!= null` narrowing; `200 + 200` proves the zero-extended read.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
const src: u8[] | null = [200]
// @@VALUE@@
src
// @@TYPE@@
u8[] | null
// @@FALLBACK@@
null
// @@TEST@@
v != null
// @@HIT@@
print(v[0] + v[0])
// @@MISS@@
print("null")
// @@WANT@@
400
// @@SKIP@@
array_push: D2239, a `(u8[] | null)[]` element is check-clean invalid wasm at the push
map_value: D2239, the same element as a map value
