// Flow-sensitive reads, the declared-generic face (D15956, D15957): a `let` first bound to a
// generic its delivery type cannot close, re-pointed to one it can, reads as the second, delivered
// at every position into a function type that closes it. The proof calls the delivered value.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@SETUP@@
function inner<U>(u: U): U { return u }
function plus<V>(v: V): i32 { return v + 1 }
let k = plus
k = inner
// @@VALUE@@
k
// @@TYPE@@
(b: boolean) => boolean
// @@PROOF@@
print(v(true))
// @@WANT@@
true
