// D9631, D9632: a list literal of an un-annotated parameter beside a second parameter bound
// wider, or beside arithmetic of it with a wider literal, holds each element at its own width
// in the body, as `x: i32` beside `y: i64` does. The body indexes the wide element back out.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __pairAt(x, y) {
  const xs = [x, y]
  xs[1]
}
function __halfAt(x) {
  const xs = [x, x + 1.5]
  xs[1]
}
// @@VALUE@@
__pairAt(2, 5000000000)
// @@TYPE@@
i64
// @@TEST@@
v > 4000000000
// @@HIT@@
const __e: i64 = v
print(__e + 1)
// @@MISS@@
print("miss")
// @@WANT@@
5000000001
// @@VALUE2@@
__halfAt(2)
// @@TYPE2@@
f64
// @@PROOF2@@
print(v * 2.0)
// @@WANT2@@
7
