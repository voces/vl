// D15096 — a generic record instance whose own field is typed as a union arm
// (`type W<T> = { o: O | null, v: T }`). The instance's field named the arm, not its twin
// row, so the type section found no element row. The second instance is at another argument.
//
// The PROOF reads through the nullable arm field, so a read that lands on the wrong row cannot
// print `4`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type O = { n: i32, next: O | null }
type P = { m: i32 }
type U = O | P
type W<T> = { o: O | null, v: T }
function mkW(n: i32): W<i32> {
  return { o: { n: n, next: null }, v: 1 }
}
function mkWs(n: i32): W<string> {
  return { o: { n: n, next: null }, v: "s" }
}
// @@VALUE@@
mkW(4)
// @@TYPE@@
W<i32>
// @@FALLBACK@@
mkW(7)
// @@TEST@@
(v.o?.n ?? 0) == 4
// @@HIT@@
print(4)
// @@MISS@@
print(9)
// @@WANT@@
4
// @@VALUE2@@
mkWs(6)
// @@TYPE2@@
W<string>
// @@PROOF2@@
print(v.o?.n ?? 0)
// @@WANT2@@
6
