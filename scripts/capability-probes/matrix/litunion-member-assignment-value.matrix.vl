// An assignment of one member of a literal-union field, used as a value, at every delivery
// position: the assignment is typed as the lone literal and the place holds the member's atom,
// so the proof reads the value and the place it wrote (D17340). The cells add an element place,
// a `K | null` place, a place of another literal union, a nested write, a compare and a literal
// that is not a member.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type __K = "zz" | "ww"
type __J = "ww" | "qq"
const __o: { f: __K } = { f: "zz" }
// @@VALUE@@
(__o.f = "ww")
// @@TYPE@@
"ww"
// @@PROOF@@
print(v)
print(__o.f)
// @@WANT@@
ww then ww
// @@CELL_element_place@@
// want: ww then ww
function f() {
  const ks: __K[] = ["zz"]
  print(ks[0] = "ww")
  print(ks[0])
}
f()
// @@CELL_element_place_module@@
// want: ww then ww
const ks: __K[] = ["zz"]
print(ks[0] = "ww")
print(ks[0])
// @@CELL_nullable_place@@
// want: ww then ww
function f() {
  const p: { f: __K | null } = { f: null }
  print(p.f = "ww")
  print(p.f)
}
f()
// @@CELL_other_union_place@@
// want: ww then ww
function f() {
  const q: { f: __J } = { f: "qq" }
  const k: __K = (q.f = "ww")
  print(k)
  print(q.f)
}
f()
// @@CELL_nested_write@@
// want: ww then ww then ww
function f() {
  const p: { g: __K } = { g: "zz" }
  print(__o.f = (p.g = "ww"))
  print(p.g)
  print(__o.f)
}
f()
// @@CELL_nested_write_module@@
// want: ww then ww then ww
const p: { g: __K } = { g: "zz" }
const w = (__o.f = (p.g = "ww"))
print(w)
print(p.g)
print(__o.f)
// @@CELL_compare@@
// want: true then false then ww
function f() {
  print((__o.f = "ww") == "ww")
  print((__o.f = "ww") != "ww")
  print(__o.f)
}
f()
// @@CELL_non_member@@
// owed: cannot assign string to __K
function f() {
  print(__o.f = "nn")
}
f()
