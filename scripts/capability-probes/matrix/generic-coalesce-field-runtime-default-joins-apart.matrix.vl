// D10061: the generic face. A `??` over a `T | null` record field with a runtime `f64` default,
// called at `T = i32`, is `i32 | f64`. `T` is left open, so the pin comes from the call.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __cjG<T>(r: { v: T | null }, d: f64) { return r.v ?? d }
const __cjR: { v: i32 | null } = { v: 5 }
const __cjS: { v: i32 | null } = { v: null }
// @@VALUE@@
__cjG(__cjR, 1.5)
// @@TYPE@@
i32 | f64
// @@TEST@@
v is i32
// @@HIT@@
print(v * 2)
// @@MISS@@
print("widened")
// @@WANT@@
10
// @@VALUE2@@
__cjG(__cjS, 1.5)
// @@TYPE2@@
i32 | f64
// @@PROOF2@@
print(v)
// @@WANT2@@
1.5
