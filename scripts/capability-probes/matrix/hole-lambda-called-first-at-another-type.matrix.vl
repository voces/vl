// A hole lambda called first at one type and then delivered, as itself, where a call reads it at
// another type: the delivery takes the lambda's copy at the call's type (D6474).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
const h = (u) => {
  return u
}
print(h("s"))
// @@VALUE@@
h
// @@TYPE@@
(n: i32) => i32
// @@PROOF@@
print(v(3) + 1)
// @@WANT@@
4
