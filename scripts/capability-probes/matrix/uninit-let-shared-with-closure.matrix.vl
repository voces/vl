// A `let` with no initializer, of a type with no zero value, that a closure captures and that is
// assigned after the capture: the closure shares the binding (D2340). Cells are type kind x
// capture position inside a function: the closure reads, writes after an outer write, or both;
// plus a module-scope read and uses through the binding. Every cell prints 7 unless it says.
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type P = { x: i32 }
type U = { a: i32 } | { b: string }
function ua(u: U): i32 {
  if u is { a: i32 } { return u.a }
  0
}
function vu(u: i32 | string): i32 {
  if u is i32 { return u }
  0
}
function nr(p: P | null): i32 {
  if p == null { return 0 }
  p.x
}
function mk(): { [string]: i32 } {
  const m: { [string]: i32 } = Map()
  m.set("a", 7)
  m
}
// @@VALUE@@
{ x: 7 }
// @@TYPE@@
P
// @@PROOF@@
print(v.x)
// @@WANT@@
7
// @@CELL_record_read@@
function go() {
  let p: P
  const g = () => p.x
  p = { x: 7 }
  print(g())
}
go()
// @@CELL_record_write@@
function go() {
  let p: P
  p = { x: 7 }
  const s = () => { p = { x: 7 } }
  s()
  print(p.x)
}
go()
// @@CELL_record_both@@
function go() {
  let p: P
  const s = () => { p = { x: 7 } }
  const g = () => p.x
  s()
  print(g())
}
go()
