// @@CELL_record_in_loop@@
// want: 12
function go() {
  let total = 0
  for i in 0 to 2 {
    let p: P
    const g = () => p.x
    p = { x: 3 + i }
    total = total + g()
  }
  print(total)
}
go()
// @@CELL_fn_called_twice@@
function go() {
  let p: (n: i32) => i32
  const g = () => p(3) + p(4)
  p = (n: i32) => n
  print(g())
}
go()
