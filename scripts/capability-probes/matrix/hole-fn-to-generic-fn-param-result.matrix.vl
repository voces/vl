// An un-annotated function handed to a function-typed parameter of a generic whose result
// type parameter only that function's body binds (D8943). `apply`'s `R` is left OPEN, so the
// value's type comes from `half`'s or `inc`'s body at the bound `T = i32`; an annotated
// `half(a: i32): f64` pins the result and cannot see the defect.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function half(a) { return a / 2.0 }
function inc(a) { return a + 1 }
function apply<T, R>(h: (T) => R, x: T): R { return h(x) }
// @@VALUE@@
apply(half, 3)
// @@TYPE@@
f64
// @@PROOF@@
print(v * 2.0)
// @@WANT@@
3
// @@VALUE2@@
apply(inc, 3)
// @@TYPE2@@
i32
// @@PROOF2@@
print(v + 1)
// @@WANT2@@
5
