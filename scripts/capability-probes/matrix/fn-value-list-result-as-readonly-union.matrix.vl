// D3073: a function value returning a record list, delivered as one returning a `readonly`
// list of a union holding the record. The adapter's result is the read-only view.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function mkL(n: i32): () => Circle[] {
  const xs: Circle[] = [{ r: n }]
  const g = () => xs
  return g
}
// @@VALUE@@
mkL(3)
// @@TYPE@@
() => readonly Shape[]
// @@PROOF@@
const __e = v()[0]
if __e is Circle { print(__e.r) } else { print(0) }
// @@WANT@@
3
// @@VALUE2@@
mkL(4)
// @@TYPE2@@
() => readonly Shape[]
// @@PROOF2@@
const __e2 = v()[0]
if __e2 is Circle { print(__e2.r) } else { print(0) }
// @@WANT2@@
4
// @@SKIP@@
is_in_if: the value is a function, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
