// D4770 — `.length`, an index read and `for … in` over a union of lists one of whose members
// holds a numeric literal union (`K[] | string[]`, `K = 0 | 1 | 2`), graded at every position.
// The proof reads all three off `v` and narrows the element, so a mis-tagged arm prints wrong.
// Own cells pair `K[]` with `i32[]` and `f64[]`, and put the literal arm second.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type K = 0 | 1 | 2
function mk(b: boolean): K[] | string[] {
  if b { return ["a", "bc"] }
  const k: K[] = [2, 1, 2]
  return k
}
// @@VALUE@@
mk(false)
// @@TYPE@@
K[] | string[]
// @@TEST@@
v[0] is K
// @@MISS@@
print(0)
// @@HIT@@
let t = v.length
for x in v {
  if x is K { t = t + x }
}
const e = v[1]
if e is K { print(t * 100 + e) } else { print(e) }
// @@WANT@@
801
// @@VALUE2@@
mk(true)
// @@TYPE2@@
K[] | string[]
// @@PROOF2@@
const e2 = v[1]
if e2 is string { print(e2.length * 10 + v.length) } else { print(0) }
// @@WANT2@@
22
// @@CELL_with_i32_list@@
// want: 3 then 1 then 6
const v__A__ = __V__
const a: i32[] | K[] = [1, 0, 1]
print(a.length)
print(a[2])
const b: K[] | i32[] = [5, 6]
let s = 0
for x in b { s = s + x }
print(s - 5)
// @@CELL_with_f64_list@@
// want: 1 then 2 then 1.5
const v__A__ = __V__
function g(a: K[] | f64[]) {
  print(a.length)
  print(a[0])
}
const k: K[] = [2]
g(k)
const f: f64[] = [1.5]
print(f[0])
// @@CELL_literal_arm_second@@
// want: 2 then s
const v__A__ = __V__
function h(a: string[] | K[]) {
  if a is string[] { print(a[0]) } else { print(a.length) }
}
const k: K[] = [1, 0]
h(k)
h(["s"])
// @@CELL_index_write@@
// owed: cannot write through an index of
const v__A__ = __V__
const a: i32[] | K[] = [1, 0]
a[0] = 5
print(a[0])
