// `is` and null tests over a record parameter `p: A | null` that the record-width rewrite makes
// generic, called with a wider row and with `null` (D16377): the `null` call is the declared
// parameter's instance, so each cell prints what the same function does with an exact `A`.
// The annotated face spells the value's own wide type on its binding.
// @@PRELUDE@@
type A = { v: i32 }
type C = { v: i32, s: string }
// @@VALUE@@
{ v: 1, s: "a" }
// @@TYPE@@
C
// @@PROOF@@
print(v.s)
// @@WANT@@
a
// @@SKIP@@
binding: the built-in positions deliver the value at its own type; the cells deliver it to P
return_inferred: same
return_annotated: same
argument: same
struct_field_init: same
struct_field_assign: same
array_element: same
array_element_assign: same
array_push: same
local_assign: same
global_init: same
global_assign: same
map_value: same
map_set: same
closure_capture: same
block_if: same
block_if_capture: same
block_while: same
block_while_capture: same
block_bare: same
block_bare_capture: same
fn_body: same
fn_body_capture: same
is_in_if: same
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
array_element_place: same
map_value_place: same
struct_field_place: same
early_return_guard: same
two_instances: same
// @@CELL_is_wider@@
// want: true then false
function f(p: A | null): boolean { return p is C }
const v__A__ = __V__
print(f(v))
print(f(null))
// @@CELL_is_declared@@
// want: false then false
function f(p: A | null): boolean { return p is A }
const v__A__ = __V__
print(f(v))
print(f(null))
// @@CELL_is_null@@
// want: false then true
function f(p: A | null): boolean { return p is null }
const v__A__ = __V__
print(f(v))
print(f(null))
// @@CELL_ne_null@@
// want: 1 then 0
function f(p: A | null): i32 { if p != null { p.v } else { 0 } }
const v__A__ = __V__
print(f(v))
print(f(null))
// @@CELL_narrowed_read@@
// want: a then none
function f(p: A | null) { if p is C { print(p.s) } else { print("none") } }
const v__A__ = __V__
f(v)
f(null)
// @@CELL_coalesce@@
// want: 1 then 9
function f(p: A | null): i32 { return (p ?? { v: 9 }).v }
const v__A__ = __V__
print(f(v))
print(f(null))
// @@CELL_null_first@@
// want: false then true
function f(p: A | null): boolean { return p is C }
const v__A__ = __V__
print(f(null))
print(f(v))
// @@CELL_two_params@@
// want: true then false
function f(p: A | null, q: A | null): boolean { return p is C && q == null }
const v__A__ = __V__
print(f(v, null))
print(f(null, v))
// @@CELL_ufcs@@
// want: true then false
function test(self: A | null): boolean { return self is C }
const v__A__ = __V__
print(v.test())
const n: A | null = null
print(n.test())
// @@CELL_forwarded@@
// want: true then false
function f(p: A | null): boolean { return p is C }
function g(q: A | null): boolean { return f(q) }
const v__A__ = __V__
print(g(v))
print(g(null))
// @@CELL_exact_beside@@
// want: true then false then false
function f(p: A | null): boolean { return p is C }
const v__A__ = __V__
print(f(v))
print(f({ v: 2 }))
print(f(null))
// @@CELL_loop@@
// want: true then false
function f(p: A | null): boolean { return p is C }
const v__A__ = __V__
for x in [true, false] { if x { print(f(v)) } else { print(f(null)) } }
