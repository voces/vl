// D9560: arithmetic over an un-annotated parameter bound at a literal union yields the union's
// base scalar, as the direct spelling does, so `x * 2` at `1 | 2` is the `i32` 4, not an `N`.
// The proof stores the result in an `i32` and computes past the set with it.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type __N = 1 | 2
const __lu: __N = 2
function __twice(x) { x * 2 }
const __shl = (x) => x << 3
// @@VALUE@@
__twice(__lu)
// @@TYPE@@
i32
// @@TEST@@
v == 4
// @@HIT@@
const w: i32 = v
print(w + 1)
// @@MISS@@
print("miss")
// @@WANT@@
5
// @@VALUE2@@
__shl(__lu)
// @@TYPE2@@
i32
// @@PROOF2@@
print(v - 1)
// @@WANT2@@
15
