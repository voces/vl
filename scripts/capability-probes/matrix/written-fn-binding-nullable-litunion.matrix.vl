// D5170: a written function binding called at a nullable literal union and its copy at a
// nullable `string`; each call's pin spells the union as an instance's parameter does. Every
// type parameter stays open; the annotated face annotates only the destination.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type __S = "p" | "q"
function __gA<U>(u: U) {
  print(u)
}
function __gB<V>(v: V) {
  print(v)
}
const __qa: __S | null = "q"
const __rb: string | null = "r"
// @@SETUP@@
let __x = __gA
__x = __gB
let __y = __x
__y(__rb)
__x(__qa)
// @@VALUE@@
__x
// @@TYPE@@
(s: __S | null) => void
// @@PROOF@@
v(__qa)
// @@WANT@@
q
