// D16739: a list of records holding un-annotated functions of different result types, handed
// through a generic identity and read by element and field off the binding of its result,
// delivered at every position: the read resolves to its one function through the call.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __hinc(a) { return a + 1 }
function __hhalf(a) { return a / 2.0 }
function __hid(x) { return x }
const __xs = __hid([{ f: __hinc }, { f: __hhalf }])
// @@VALUE@@
__xs[1].f(3)
// @@TYPE@@
f64
// @@TEST@@
v == 1.5
// @@HIT@@
print(1)
// @@MISS@@
print(0)
// @@WANT@@
1
// @@CELL_both_elements@@
// want: 4 then 1.5
print(__xs[0].f(3))
print(__xs[1].f(3))
