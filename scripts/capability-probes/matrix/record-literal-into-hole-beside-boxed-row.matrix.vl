// D8620: a record literal handed to an un-annotated parameter whose body reads its field at the
// literal's own `i32`, while the program declares a record of the same field names that stores
// the field boxed (`J`). The hole is the ingredient: the parameter stays open, so the literal's
// row is chosen by field names, and `J` must not be taken for a literal whose field is read bare.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type J = { f: i32 | null }
function rd(r) { return r.f + 1 }
const keepJ: J = { f: null }
const keepF: i32 = keepJ.f ?? 0
// @@VALUE@@
rd({ f: 4 })
// @@TYPE@@
i32
// @@WANT@@
5
// @@TEST@@
v == 5
// @@HIT@@
print(v + keepF)
// @@MISS@@
print(0)
// @@VALUE2@@
rd({ f: 8 })
// @@TYPE2@@
i32
// @@PROOF2@@
print(v * 2)
// @@WANT2@@
18
