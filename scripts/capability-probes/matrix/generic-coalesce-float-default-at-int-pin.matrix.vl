// D9910: a `??` over a declared type parameter pinned at a never-null `i32` is that `i32`, though
// its default is a float. `T` is left open: the pin comes from the call. The proof divides,
// which prints `2` at `i32` and `2.5` at `f64`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __cgTake<T>(a: T) { return a ?? 1.5 }
const __cgPin: i32 = 5
// @@VALUE@@
__cgTake(__cgPin)
// @@TYPE@@
i32
// @@TEST@@
v > 0
// @@HIT@@
print(v / 2)
// @@MISS@@
print("miss")
// @@WANT@@
2
