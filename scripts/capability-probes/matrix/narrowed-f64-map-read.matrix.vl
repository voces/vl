// D9630: a `!= null` test narrows an `f64`-valued map read itself, as it does an `i32` or
// `string` one, so the read delivers at `f64`, and a stored `0.0` beside it is present.
// The proof computes a fraction with it. `narrowed-wide-map-read` is the `i64` twin.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
const __fm: { [string]: f64 } = Map()
__fm["k"] = 2.5
__fm["z"] = 0.0
// @@GUARD@@
__fm["k"] != null && __fm["z"] != null
// @@VALUE@@
__fm["k"]
// @@TYPE@@
f64
// @@FALLBACK@@
0.0
// @@TEST@@
v > 2.0
// @@HIT@@
const w: f64 = v
print(w * 3.0)
// @@MISS@@
print("miss")
// @@WANT@@
7.5
