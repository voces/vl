// D16930 — a union of lists whose element is a record, read through a hole: the annotated face
// lowers by the list-union rewrite, while a pin's per-arm read declines a record element, so
// the un-annotated face is the row's refusal until the record delivery is built.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type P = { x: i32 }
type Q = { y: string }
function mk(k: i32): P[] | string[] {
  if k == 0 {
    const s: string[] = ["s"]
    return s
  }
  const a: P[] = [{ x: 3 }, { x: 4 }]
  return a
}
// @@VALUE@@
mk(1)
// @@TYPE@@
P[] | string[]
// @@PROOF@@
print(v.length)
// @@WANT@@
2
// @@VALUE2@@
mk(0)
// @@TYPE2@@
P[] | string[]
// @@PROOF2@@
print(v.length)
// @@WANT2@@
1
// @@CELL_hole_param_record_element@@
// want: 4
function take(a__A__) {
  const e = a[1]
  if e is P { print(e.x) } else { print(0) }
}
take(__V__)
// @@CELL_hole_param_record_for@@
// want: 7
function take(a__A__) {
  let n = 0
  for e in a {
    if e is P { n = n + e.x }
  }
  print(n)
}
take(__V__)
// @@CELL_hole_param_nullable_record@@
// want: 1
function take(a) {
  const e = a[0]
  if e == null { print(1) } else { print(2) }
}
const q: (P | null)[] | i32[] = [null]
take(q)
// @@CELL_hole_param_two_record_arms@@
// want: 5
function take(a) {
  const e = a[0]
  if e is P { print(e.x) } else { print(0) }
}
const q: P[] | Q[] = [{ x: 5 }]
take(q)
