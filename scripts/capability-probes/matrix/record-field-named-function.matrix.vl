// D15640 — a named function in a record field, at every delivery position, handed to a hole
// callee that calls the field, beside a hole function handed to the same callee at `f64`. The
// field is a set id, as a list element is, so the callee's two instances agree.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function dbl(v) { return v + v }
function call0(r, x) { print(r.f(x)) }
function both(g) {
  print(g(1))
  call0({ f: g }, 2.5)
}
both(dbl)
// @@VALUE@@
{ f: dbl }
// @@TYPE@@
{ f: (i32) => i32 }
// @@PROOF@@
call0(v, 4)
// @@WANT@@
2 then 5 then 8
// @@VALUE2@@
{ f: dbl }
// @@TYPE2@@
{ f: (i32) => i32 }
// @@PROOF2@@
print(v.f(3))
// @@WANT2@@
6
// @@SKIP@@
is_in_if: the value is a record, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
