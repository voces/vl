// `v?.tag ?? "z"` over a nullable union of records whose arms share only `tag`. The proof
// coalesces a present value and a null one, so a chain that lost the box refuses or prints
// the fallback (D5243).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type N = { tag: "a", v: i32 } | { tag: "b", w: i32 }
function mk(a: boolean): N | null {
  if a { return null }
  { tag: "b", w: 2 }
}
// @@VALUE@@
mk(false)
// @@TYPE@@
N | null
// @@PROOF@@
print(v?.tag ?? "z")
// @@WANT@@
b
// @@VALUE2@@
mk(true)
// @@TYPE2@@
N | null
// @@PROOF2@@
print(v?.tag ?? "z")
// @@WANT2@@
z
