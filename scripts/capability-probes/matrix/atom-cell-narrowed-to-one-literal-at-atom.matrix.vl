// An atom cell narrowed to one literal, whose read the checker types at that literal's string
// while the cell holds the id, delivered to every position at its literal union: the id passes as
// it is.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type __K = "ab" | "cd"
function __mk(i: i32): __K { return if i > 0 { "cd" } else { "ab" } }
// @@SETUP@@
const __m: __K = __mk(0)
// @@GUARD@@
__m == "ab"
// @@FALLBACK@@
__mk(1)
// @@VALUE@@
__m
// @@TYPE@@
__K
// @@PROOF@@
print(v)
// @@WANT@@
ab
// @@TEST@@
v == "ab"
// @@HIT@@
print("ab")
// @@MISS@@
print("no")
