// The generic twin of typaram-list-union-forward: the value is a generic's own `V[] | i32[]`
// return, so the element is bound only by inference at the call, never by an annotation.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function mk<V>(x: V): V[] | i32[] { [x, x, x] }
function len<W>(a: W[] | i32[]) { a.length }
function fwd<V>(a: V[] | i32[]) { len(a) }
// @@VALUE@@
mk("a")
// @@TYPE@@
string[] | i32[]
// @@PROOF@@
print(fwd(v))
// @@WANT@@
3
// @@TEST@@
v is i32[]
// @@HIT@@
print(0)
// @@MISS@@
print(fwd(v))
