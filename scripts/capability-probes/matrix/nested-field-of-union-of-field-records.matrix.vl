// A field read off a field of `K | J`, whose members hold that field as two different records
// (`K.h = {f: i32}`, `J.h = {f: i32 | null}`): `v.h` is the union of the two records, a union
// the un-annotated faces of the hole and type-parameter cells meet only at the instance (D15751).
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type K = { h: { f: i32 } }
type J = { h: { f: i32 | null } }
type S = { h: { f: i32 }, s: i32 }
const go = [1].length > 0
function pickKJ(b: boolean): K | J {
  if b { return { h: { f: 4 } } }
  { h: { f: null } }
}
// @@VALUE@@
pickKJ(go)
// @@TYPE@@
K | J
// @@PROOF@@
print(v.h.f ?? 0)
// @@WANT@@
4
// @@CELL_param_coalesce@@
function take(a__A__) { print(a.h.f ?? 0) }
take(__V__)
// @@CELL_param_no_coalesce@@
function take(a__A__) {
  const x = a.h.f
  if x != null { print(x) } else { print(0) }
}
take(__V__)
// @@CELL_param_inner_bound@@
function take(a__A__) {
  const x = a.h
  print(x.f ?? 0)
}
take(__V__)
// @@CELL_param_null_arm@@
// want: 0
function take(a__A__) { print(a.h.f ?? 0) }
take(pickKJ(false))
// @@CELL_type_param@@
function take<T>(a: T) { print(a.h.f ?? 0) }
take(__V__)
// @@CELL_same_inner_records@@
function take(a) { print(a.h.f) }
const w: K | S = { h: { f: 4 }, s: 1 }
take(w)
