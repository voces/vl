// D12234: a function declared by name returns a hole lambda, and its calls deliver the result at two
// function types. Each call builds a fresh closure, so the design owes both deliveries (D16070 is
// the lambda twin, `hole-lambda-returned-by-lambda-at-two-types`).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function outer() {
  const l = (x) => x
  return l
}
// @@VALUE@@
outer()
// @@TYPE@@
(x: i32) => i32
// @@PROOF@@
print(v(41) + 1)
// @@WANT@@
42
// @@VALUE2@@
outer()
// @@TYPE2@@
(x: string) => string
// @@PROOF2@@
print(v("s"))
// @@WANT2@@
s
