// D3005 — an `f32` field of a record literal a map store re-seats at `{ v: f64 }`, read back
// through a nested field at its own `f32` type and delivered at every position.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type D = { v: f64 }
type W = { d: D }
const y: f32 = 1.5
const c: {[string]: W} = Map()
const o = { d: { v: y } }
c["k"] = o
// @@VALUE@@
o.d.v
// @@TYPE@@
f32
// @@PROOF@@
print(v * 2)
// @@WANT@@
3
// @@TEST@@
v > 1
// @@HIT@@
print(v * 2)
// @@MISS@@
print(0)
