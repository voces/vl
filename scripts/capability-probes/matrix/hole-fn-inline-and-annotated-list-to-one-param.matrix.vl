// D9360: an inline list of un-annotated functions and an annotated list of the same function type,
// each handed to one un-annotated parameter whose element the body calls. The value delivered is
// the sum of the two calls' results.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __inc(a) { return a + 1 }
function __dbl(a) { return a * 2 }
function __early(a) {
  if a.length == 0 { return 0 }
  return a[0](4)
}
const __e: ((x: i32) => i32)[] = [__dbl]
// @@VALUE@@
__early([__inc]) + __early(__e)
// @@TYPE@@
i32
// @@PROOF@@
print(v)
// @@WANT@@
13
