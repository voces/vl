// D1197 — `.push` is the ONE delivery that drops the non-null recovery for a narrowed
// nullable REF. Filed 2026-09-02 with a hand-written nine-position matrix in which it is the
// only red cell; this is that matrix as a template, and `array_push` grading SILENT on
// master's seed is the proof the harness sees what it exists for.
//
// The GUARD is what makes the value NARROWED at the delivery: a value that reaches the
// position already non-null does not reproduce the row.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type Item = { name: string }
function mk(i: i32): Item | null {
  if i > 0 { return { name: "a" } }
  null
}
// @@SETUP@@
const e = mk(1)
// @@GUARD@@
e != null
// @@VALUE@@
e
// @@TYPE@@
Item
// @@FALLBACK@@
{ name: "z" }
// @@PROOF@@
print(v.name)
// @@WANT@@
a
