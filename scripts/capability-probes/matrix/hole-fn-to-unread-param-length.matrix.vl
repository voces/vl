// D6301: a declared function and a lambda whose bodies read `.length`, each handed to a
// parameter nothing reads, so the default its hole takes is never observable.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __len(a) {
  return a.length
}
function __outer(g) {
  return 4
}
// @@VALUE@@
__outer(__len)
// @@TYPE@@
i32
// @@PROOF@@
print(v)
// @@WANT@@
4
// @@TEST@@
v == 4
// @@HIT@@
print(v)
// @@MISS@@
print(0)
// @@VALUE2@@
__outer((a) => a.length + 1)
// @@TYPE2@@
i32
// @@PROOF2@@
print(v + 1)
// @@WANT2@@
5
