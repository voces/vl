// Flow-sensitive reads (DECISIONS.md, "A read of a `let` takes its most recent write's type"),
// the function-valued face (D14930): a `let` first bound to a generic and re-pointed to a lambda
// reads as the lambda, delivered at every position into a function type that closes it. The proof
// calls the delivered value.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@SETUP@@
function other<V>(v: V): V { return v }
let k = other
k = (n) => n + 1
// @@VALUE@@
k
// @@TYPE@@
(n: i32) => i32
// @@PROOF@@
print(v(41))
// @@WANT@@
42
