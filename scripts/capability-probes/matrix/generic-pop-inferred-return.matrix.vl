// D2574 — `x.pop()` over a generic `T[]`, returned with no annotation, at an `f64` instance:
// the result is the value box `f64 | null`. The parameter stays open, so the pin types it.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function mk(): f64[] { return [1.5, 2.5] }
function f<T>(x: T[]) { return x.pop() }
// @@VALUE@@
f(mk())
// @@TYPE@@
f64 | null
// @@PROOF@@
if v != null { print(v) } else { print("none") }
// @@WANT@@
2.5
// @@TEST@@
v != null
// @@HIT@@
print(v)
// @@MISS@@
print("none")
