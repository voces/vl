// A list of functions with un-annotated parameters, one element handed to a generic identity and
// the result called, directly and through a `const` at a computed index; the call takes the
// element type the list's pin closed (D9980).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __id<T>(x: T): T { return x }
function __hinc(a) { a + 1 }
function __hdbl(a) { a * 2 }
// @@VALUE@@
[__hinc, __hdbl]
// @@TYPE@@
((a: i32) => i32)[]
// @@PROOF@@
let __ek = 0
const __eg = __id(v[__ek])
print(__id(v[1])(5) * 100 + __eg(7))
// @@WANT@@
1008
