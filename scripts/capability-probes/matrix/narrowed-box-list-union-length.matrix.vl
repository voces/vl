// D16896 — a box narrowed by `is string`'s else to `i32[][] | f64[][]`, read in place: its
// `.length`, an element and a `for` over it go through the list-union rewrite, whose receiver
// binding names the narrowed union's box.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function mk(k: i32): i32[][] | f64[][] | string {
  if k == 0 { return "s" }
  if k == 1 {
    const a: i32[][] = [[1, 7], [2]]
    return a
  }
  const b: f64[][] = [[1.5]]
  return b
}
// @@VALUE@@
mk(1)
// @@TYPE@@
i32[][] | f64[][] | string
// @@TEST@@
v is string
// @@HIT@@
print(0)
// @@MISS@@
print(v.length)
// @@WANT@@
2
// @@VALUE2@@
mk(2)
// @@TYPE2@@
i32[][] | f64[][] | string
// @@PROOF2@@
if v is string { print(0) } else { print(v[0][0]) }
// @@WANT2@@
1.5
// @@CELL_element_length@@
function f(x: __TY__) {
  if x is string { print(0) } else { print(x[0].length) }
}
const v__A__ = __V__
f(v)
// @@CELL_for_over@@
// want: 3
function f(x: __TY__) {
  let n = 0
  if x is string { print(0) } else {
    for e in x { n = n + e.length }
    print(n)
  }
}
const v__A__ = __V__
f(v)
// @@CELL_length_bound@@
// want: 3
function f(x: __TY__) {
  if x is string { print(0) } else {
    const n = x.length
    print(n + 1)
  }
}
const v__A__ = __V__
f(v)
// @@CELL_length_in_value_if@@
function f(x: __TY__) {
  if x is string { print(0) } else { print(if true { x.length } else { 0 }) }
}
const v__A__ = __V__
f(v)
// @@CELL_bound_in_value_if_arm@@
function f(x: __TY__) {
  if x is string { print(0) } else {
    print(if true {
      const y = x
      y.length
    } else { 0 })
  }
}
const v__A__ = __V__
f(v)
// @@CELL_while_index@@
// want: 2 then 1
function f(x: __TY__) {
  if x is string { print(0) } else {
    let i = 0
    while i < x.length {
      print(x[i].length)
      i = i + 1
    }
  }
}
const v__A__ = __V__
f(v)
