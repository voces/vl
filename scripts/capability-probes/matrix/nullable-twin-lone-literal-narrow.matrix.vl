// `N | null` where `N`'s arms differ only in a lone-literal field, narrowed off `null` and
// read: the arms share a softened shape, so the nullable spelling must still name the box
// and its tags. The proof reads both the literal and the shared field, so a read that lost
// the box prints the wrong sign or refuses (D5163).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type N = { tag: "a", v: i32 } | { tag: "b", v: i32 }
function mk(a: boolean): N | null {
  if a { return { tag: "a", v: 7 } }
  { tag: "b", v: 8 }
}
// @@VALUE@@
mk(false)
// @@TYPE@@
N | null
// @@PROOF@@
if v != null { if v.tag == "b" { print(v.v) } else { print(0 - v.v) } } else { print(0) }
// @@WANT@@
8
// @@VALUE2@@
mk(true)
// @@TYPE2@@
N | null
// @@PROOF2@@
if v == null { print(0) } else { if v.tag == "a" { print(0 - v.v) } else { print(v.v) } }
// @@WANT2@@
-7
// @@SKIP@@
is_in_if: the narrowing under test is the null test, which the proof already makes
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
