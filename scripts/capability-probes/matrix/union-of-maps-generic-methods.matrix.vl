// D10171, D10173: a union of maps handed to a generic over `{[string]: V} | {[string]: string}`,
// whose body reads it through `.has`, `.values().length` and a `for` loop, at every position.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __mk(): {[string]: i32} | {[string]: string} {
  const s: {[string]: i32} = Map()
  s["q"] = 5
  s["r"] = 6
  s
}
function __has<V>(m: {[string]: V} | {[string]: string}, k: string): boolean { m.has(k) }
function __n<V>(m: {[string]: V} | {[string]: string}): i32 { m.values().length }
function __cnt<V>(m: {[string]: V} | {[string]: string}): i32 {
  let s = 0
  for k in m { s = s + k.length }
  s
}
// @@VALUE@@
__mk()
// @@TYPE@@
{[string]: i32} | {[string]: string}
// @@TEST@@
__has(v, "q") && !__has(v, "zz")
// @@HIT@@
print(__n(v) * 10 + __cnt(v) + v.values().length * 100)
// @@MISS@@
print("wrong")
// @@WANT@@
222
