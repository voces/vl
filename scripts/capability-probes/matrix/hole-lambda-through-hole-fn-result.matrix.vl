// A hole lambda handed through a hole function's result, called only through that result.
//
// `lam`'s parameter type is decided by no annotation and no call of `lam` itself: only by the
// calls through `fw`'s result, wherever the result is delivered. The elaboration keys `fw`'s
// call at the lambda's one instance; the twin template
// (`hole-lambda-through-generic-fn-result.matrix.vl`) holds the `<F>` face.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function fw(f) { return f }
const lam = (x) => x
// @@VALUE@@
fw(lam)
// @@TYPE@@
(x: i32) => i32
// @@PROOF@@
print(v(3) + v(4))
// @@WANT@@
7
// @@VALUE2@@
fw(lam)
// @@TYPE2@@
(x: string) => string
// @@PROOF2@@
print(v("w"))
// @@WANT2@@
w
