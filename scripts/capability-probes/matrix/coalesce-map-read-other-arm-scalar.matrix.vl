// D4643 — `m.get(k) ?? d` over an `i32`-valued map, where `d` is a `string` and the `??` is
// typed `i32 | string`. The fused read-with-default built the string default into the i32
// result, which the engine rejected; the result is the union box.
//
// The first instance hits and the second misses, so each arm of the result is proved.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
const nums: Map<string, i32> = Map()
nums["k"] = 4
// @@VALUE@@
nums.get("k") ?? "none"
// @@TYPE@@
i32 | string
// @@FALLBACK@@
0
// @@TEST@@
v is i32
// @@HIT@@
print(v + 1)
// @@MISS@@
print("other")
// @@WANT@@
5
// @@VALUE2@@
nums.get("z") ?? "none"
// @@TYPE2@@
i32 | string
// @@PROOF2@@
if v is string { print(v) } else { print("hit") }
// @@WANT2@@
none
