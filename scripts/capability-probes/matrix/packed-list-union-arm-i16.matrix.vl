// D16046: a `i16[]` list is a union arm with a box tag of its own, so `is`, the narrowed read,
// `==`, `as!` and a nullable niche's `??` recover it at its width. The value under test is a
// `i16[] | string` holding a list whose second element is -30000. The cells put the arm beside a
// second packed width, a map, a closure and a struct, and deliver an empty `[]` into it.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type B = { base: i32 }
function mk(n: i32): i16[] | string {
  if n < 0 { return "none" }
  const xs: i16[] = [-300, -30000]
  return xs
}
function nn(b: boolean): i16[] | null {
  if b { const r: i16[] = [-30000]; return r }
  null
}
// @@VALUE@@
mk(1)
// @@TYPE@@
i16[] | string
// @@WANT@@
-30000
// @@TEST@@
v is i16[]
// @@HIT@@
print(v[1])
// @@MISS@@
print("miss")
// @@VALUE2@@
mk(2)
// @@TYPE2@@
i16[] | string
// @@PROOF2@@
if v is i16[] { print(v.length) } else { print(v) }
// @@WANT2@@
2
// @@CELL_string_arm@@
// want: none
const u__A__ = mk(-1)
if u is i16[] { print(u.length) } else { print(u) }
// @@CELL_eq_same@@
// want: true
const a = mk(1)
const b = mk(1)
print(a == b)
// @@CELL_eq_other@@
// want: false
const a = mk(1)
const b = mk(-1)
print(a == b)
// @@CELL_as_bang@@
const xs = __V__ as! i16[]
print(xs[1])
// @@CELL_coalesce_niche@@
const z: i16[] | string = nn(true) ?? "none"
if z is i16[] { print(z[0]) } else { print(z) }
// @@CELL_beside_other_width@@
function two(b: boolean): i16[] | u16[] {
  if b { const p: i16[] = [-300, -30000]; return p }
  const q: u16[] = [1]
  return q
}
const t = two(true)
if t is u16[] { print("other") } else { print(t[1]) }
// @@CELL_beside_map_closure_struct@@
function mx(n: i32): Map<string, i32> | i16[] | (() => i32) | B {
  if n == 0 { return Map() }
  if n == 1 { return { base: 3 } }
  if n == 2 { return () => 4 }
  const p: i16[] = [-300, -30000]
  return p
}
const m = mx(3)
if m is i16[] { print(m[1]) } else { print("miss") }
// @@CELL_empty_list@@
// want: 0
function sink(d: i16[] | B) {
  if d is B { return 1000 }
  return d.length
}
print(sink([]))
