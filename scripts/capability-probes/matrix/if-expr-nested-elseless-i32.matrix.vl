// D2040 — an if-expression arm that ends in an else-less `if`, which yields `null` on its
// missing path: the inner `if` joins at the outer join's rep, nullable frame included.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function pick(): boolean { true }
// @@VALUE@@
if pick() { if pick() { if pick() { 5 } } } else { 6 }
// @@TYPE@@
i32 | null
// @@TEST@@
v != null
// @@HIT@@
print(v)
// @@MISS@@
print("miss")
// @@WANT@@
5
