// D14041 — `v is K[]` over a `K[] | string` box, `K` a union of `i32` literals: the `K[]` arm
// shares the `i32[]` tag, and the test is that tag.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type K = 0 | 1
function mk(k: i32): K[] | string {
  if k == 0 { return "s" }
  return [1, 0]
}
// @@VALUE@@
mk(1)
// @@TYPE@@
K[] | string
// @@TEST@@
v is K[]
// @@HIT@@
print(v[0] + 10)
// @@MISS@@
print(0)
// @@WANT@@
11
// @@VALUE2@@
mk(0)
// @@TYPE2@@
K[] | string
// @@PROOF2@@
if v is K[] { print(v.length) } else { print(9) }
// @@WANT2@@
9
