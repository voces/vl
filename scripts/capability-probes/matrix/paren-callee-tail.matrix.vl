// D1623 with NO container at all: the proof calls a plain closure through parentheses in a
// lambda's tail, `(v)(m)`. A `Paren` callee is neither a `Member` nor an `Ident`, so it
// reached the same `emitProgram: bare call statement is not supported` — which is what makes
// the callee SHAPE the ingredient rather than the container read the row was filed on.
//
// It is also the clean face of the pair: the sibling `container-read-callee` delivers a
// closure ARRAY, so its container-of-container positions (a closure array as a struct field,
// or nested in another array) meet gaps of their own and stay refused in both columns.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@VALUE@@
(n: i32) => n + 1
// @@TYPE@@
(i32) => i32
// @@PROOF@@
const __cp = (m: i32) => (v)(m)
print(__cp(54))
// @@WANT@@
55
// @@TEST@@
v(0) == 1
// @@HIT@@
const __h = (m: i32) => (v)(m)
print(__h(54))
// @@MISS@@
print(0)
// @@VALUE2@@
(n: i32) => n + 12
// @@TYPE2@@
(i32) => i32
// @@PROOF2@@
const __cp2 = (m: i32) => (v)(m)
print(__cp2(54))
// @@WANT2@@
66
