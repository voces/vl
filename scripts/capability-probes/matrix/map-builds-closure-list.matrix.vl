// A `.map` whose callback builds a fresh function value, so the result is a list of functions
// that no annotation or literal spells (D9231): a capturing function of one argument, and one
// of none. A list of functions in the prelude would spell the element and hide the defect.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
const base = 10
// @@VALUE@@
[1, 2].map((k) => (y: i32): i32 => y + k)
// @@TYPE@@
((y: i32) => i32)[]
// @@PROOF@@
print(v[1](7))
// @@WANT@@
9
// @@VALUE2@@
[1, 2].map((k) => (): i32 => k * base)
// @@TYPE2@@
(() => i32)[]
// @@PROOF2@@
print(v[1]() + v.length)
// @@WANT2@@
22
