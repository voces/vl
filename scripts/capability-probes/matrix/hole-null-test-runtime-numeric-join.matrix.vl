// D10293: a hole parameter read under a `!= null` test, joined with a runtime `f64`, is apart from
// it at each pin: the then-arm keeps the argument's own type and the else-arm stays `f64`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __hnG(q, d: f64) {
  const r = if q != null { q } else { d }
  r
}
const __hnQ: i32 | null = 5
const __hnN: i32 | null = null
// @@VALUE@@
__hnG(__hnQ, 1.5)
// @@TYPE@@
i32 | f64
// @@PROOF@@
print(v is i32 && v / 2 == 2)
// @@WANT@@
true
// @@VALUE2@@
__hnG(__hnN, 2.5)
// @@TYPE2@@
i32 | f64
// @@PROOF2@@
print(v is f64 && v / 2.0 == 1.25)
// @@WANT2@@
true
