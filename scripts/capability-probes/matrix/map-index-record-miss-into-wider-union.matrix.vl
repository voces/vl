// D10170 — the index spelling `c[k]` of a record-valued map's read, delivered straight into a
// union that also holds `string` and `null`. A miss must land as the union's null and a hit as
// the record arm, so the proof prints `is null` for the miss and a field of the hit.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type P = { x: i32 }
function mk(): {[i32]: P} {
  const m: {[i32]: P} = Map()
  m.set(1, { x: 7 })
  m
}
const c = mk()
// @@VALUE@@
c[2]
// @@TYPE@@
string | P | null
// @@TEST@@
v is null
// @@HIT@@
print("null")
// @@MISS@@
if v is P { print(v.x) } else { print("other") }
// @@WANT@@
null
// @@VALUE2@@
c[1]
// @@TYPE2@@
string | P | null
// @@PROOF2@@
if v is P { print(v.x) } else if v is null { print("null") } else { print("other") }
// @@WANT2@@
7
