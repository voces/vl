// A bare `v?.tag` over a nullable union of records whose arms share only `tag`, bound
// un-annotated before it is coalesced. The proof reads a present value and a null one, so a
// read that lost the guard refuses or prints the fallback (D5300).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type N = { tag: "a", v: i32 } | { tag: "b", w: i32 }
function mk(a: boolean): N | null {
  if a { return null }
  { tag: "b", w: 2 }
}
// @@VALUE@@
mk(false)
// @@TYPE@@
N | null
// @@PROOF@@
const t = v?.tag
print(t ?? "z")
// @@WANT@@
b
// @@VALUE2@@
mk(true)
// @@TYPE2@@
N | null
// @@PROOF2@@
const t = v?.tag
print(t ?? "z")
// @@WANT2@@
z
