// D1461 — a literal-union ALIAS discriminant beside its own BASE (`{kind: K1}` next to
// `{kind: string}`). The owner's 2026-09-02 amendment rules the pair legal; D1050 could not
// build it, because an arbitrary string has no interned id and the atom is the one rep the
// two arms cannot share. Unified on the STRING side instead.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type K1 = "circle" | "round"
type A = { kind: K1, r: f64 }
type B = { kind: string, r: f64 }
function f(n: i32): A | B {
  if n == 0 { return { kind: "circle", r: 1.0 } }
  const w: B = { kind: "zz", r: 2.0 }
  return w
}
// @@VALUE@@
f(1)
// @@TYPE@@
A | B
// @@TEST@@
v is A
// @@HIT@@
print(1.0)
// @@MISS@@
print(v.r)
// @@WANT@@
2
