// `v is K[]` over `i32[] | S[]`, `v` from the i32 arm. Element kinds that
// store alike share a box tag, and the test must still answer by the value (D17052).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type S = "a" | "b"
type K = 1 | 2
type P = { q: i32 }
function mk(c: boolean): i32[] | S[] {
  const a: i32[] = [1, 2]
  const b: S[] = ["b"]
  if c { return a }
  return b
}
// @@VALUE@@
mk(true)
// @@TYPE@@
i32[] | S[]
// @@TEST@@
v is K[]
// @@HIT@@
print(true)
// @@MISS@@
print(false)
// @@WANT@@
true
