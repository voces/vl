// D16077: a maker returning a generic function, its result called through a parameter. The
// annotated face types `run`'s parameter (`__A__`); the other leaves it a hole. Cells cover the
// argument's spelling and how many deliveries and calls the parameter sees.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function inc(x) { x + 1 }
function dec(x) { x - 1 }
// @@VALUE@@
() => inc
// @@TYPE@@
() => (x: i32) => i32
// @@PROOF@@
print(v()(41) + 1)
// @@WANT@@
43
// @@CELL_hole_param_inline@@
function run(f__A__) { return f()(41) }
print(run(__V__) + 1)
// @@CELL_hole_param_named_maker@@
function mk() { inc }
function run(f__A__) { return f()(41) }
print(run(mk) + 1)
// @@CELL_hole_param_const_lambda@@
const m = __V__
function run(f__A__) { return f()(41) }
print(run(m) + 1)
// @@CELL_hole_param_lambda_of_lambda@@
// want: 43
function run(f__A__) { return f()(41) }
print(run(() => (x: i32) => inc(x)) + 1)
// @@CELL_hole_param_two_calls_one_type@@
function run(f__A__) {
  const a = f()(41)
  const b = f()(41)
  return a + b - 42
}
print(run(__V__) + 1)
// @@CELL_hole_param_two_param_lists@@
// owed-annotated: argument 1: expected i32, got f64
function run(f__A__) {
  if f()(1.5) > 9.0 { return 0 }
  return f()(41)
}
print(run(__V__) + 1)
// @@CELL_hole_param_two_calls_same@@
// want: 84
function run(f__A__) { return f()(41) }
print(run(__V__) + run(__V__))
// @@CELL_hole_param_two_calls_other@@
// want: 82
function run(f__A__) { return f()(41) }
print(run(__V__) + run(() => dec))
// @@CELL_hole_param_two_calls_closed@@
// want: 124
function run(f__A__) { return f()(41) }
print(run(__V__) + run(() => (x: i32) => x * 2))
