// A nullable record wider than one union arm, delivered into the nullable union: its null is the
// union's null, and a record boxes under the arm it is wider than. The second instance is the
// null. The proof reads through a `UawPet | null` parameter, so the un-annotated face delivers it
// there too.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type UawA = { k: i32, legs: i32 }
type UawB = { s: string }
type UawPet = UawA | UawB
const uawSv = { k: 1, legs: 4, purr: true }
function uawMn(c: boolean) {
  if c { return uawSv }
  return null
}
function uawLegs(p: UawPet | null): i32 {
  if p == null { return -2 }
  if p is UawA { return p.legs }
  -1
}
// @@VALUE@@
uawMn(true)
// @@TYPE@@
UawPet | null
// @@TEST@@
uawLegs(v) >= 0
// @@HIT@@
print(uawLegs(v) + 1)
// @@MISS@@
print("b")
// @@WANT@@
5
// @@VALUE2@@
uawMn(false)
// @@TYPE2@@
UawPet | null
// @@PROOF2@@
print(uawLegs(v))
// @@WANT2@@
-2
