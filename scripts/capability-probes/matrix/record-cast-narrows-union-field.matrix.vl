// `as?` of a record to one that narrows a union field to a member, delivered at every position:
// the cast tests the field's tag and hands back the record it was given.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type __A = { x: i32 | string, z: i32 }
type __B = { x: i32, z: i32 }
function __mk(k: i32): __A {
  if k > 0 { return { x: k, z: k } }
  return { x: "s", z: 0 }
}
const __r = __mk(2)
// @@VALUE@@
__r as? __B
// @@TYPE@@
__A | null
// @@TEST@@
v != null
// @@HIT@@
print(v.z + 40)
// @@MISS@@
print(0)
// @@WANT@@
42
