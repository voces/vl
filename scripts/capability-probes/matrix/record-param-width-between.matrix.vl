// A record wider than the record-typed parameter it is handed to, where the extra field sorts between the two the parameter declares:
// the parameter is row-polymorphic, specialised per concrete row (L3, the parameter half).
// `record-param-width-before`, `-between` and `-after` hold the same cells. The annotated
// face spells the value's own wide type on its binding.
// @@PRELUDE@@
type P = { name: string, tag: string }
// @@VALUE@@
{ name: "a", oz: 3, tag: "a" }
// @@TYPE@@
{ name: string, oz: i32, tag: string }
// @@PROOF@@
print(v.name)
// @@WANT@@
a
// @@SKIP@@
binding: the built-in positions deliver the value at its own type; the cells deliver it to P
return_inferred: same
return_annotated: same
argument: same
struct_field_init: same
struct_field_assign: same
array_element: same
array_element_assign: same
array_push: same
local_assign: same
global_init: same
global_assign: same
map_value: same
map_set: same
closure_capture: same
block_if: same
block_if_capture: same
block_while: same
block_while_capture: same
block_bare: same
block_bare_capture: same
fn_body: same
fn_body_capture: same
is_in_if: same
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
array_element_place: same
map_value_place: same
struct_field_place: same
early_return_guard: same
two_instances: same
// @@CELL_direct@@
// want: a
function show(p: P) { print(p.name) }
const v__A__ = __V__
show(v)
// @@CELL_ufcs@@
// want: a
function show(self: P) { print(self.name) }
const v__A__ = __V__
v.show()
// @@CELL_two_rows@@
// want: a then b
function show(p: P) { print(p.name) }
const v__A__ = __V__
show(v)
show({ name: "b", oz: 4, tag: "b" })
// @@CELL_generic_fwd@@
// want: a
function show(p: P) { print(p.name) }
function fwd<T>(t: T) { return show(t) }
const v__A__ = __V__
fwd(v)
// @@CELL_generic_beside@@
// want: a then 1
function show<T>(p: P, t: T): T {
  print(p.name)
  return t
}
const v__A__ = __V__
print(show(v, 1))
// @@CELL_hole_fwd@@
// want: a
function show(p: P) { print(p.name) }
function h(q) { show(q) }
const v__A__ = __V__
h(v)
// @@CELL_nested_call@@
// want: a
function inner(p: P) { print(p.name) }
function outer(p: P) { return inner(p) }
const v__A__ = __V__
outer(v)
// @@CELL_nested_field@@
// want: a
function show(r: { p: P }) { print(r.p.name) }
const v__A__ = __V__
show({ p: v })
// @@CELL_recursive@@
// want: a
function walk(p: P, n: i32) {
  if n > 0 { walk(p, n - 1) } else { print(p.name) }
}
const v__A__ = __V__
walk(v, 3)
// @@CELL_loop@@
// want: a then a
function show(p: P) { print(p.name) }
const v__A__ = __V__
for x in [v, v] { show(x) }
// @@CELL_loop_two_rows@@
// want: a then b
function show(p: P) { print(p.name) }
const v__A__ = __V__
const w = { name: "b", oz: 4, tag: "b" }
let i = 0
while i < 2 {
  if i == 0 { show(v) } else { show(w) }
  i = i + 1
}
// @@CELL_returned@@
// want: a
function pass(p: P): P { return p }
const v__A__ = __V__
print(pass(v).name)
// @@CELL_returned_inferred@@
// want: a
function pass(p: P) { return p }
const v__A__ = __V__
print(pass(v).name)
// @@CELL_lambda_param@@
// want: a
const show = (p: P) => print(p.name)
const v__A__ = __V__
show(v)
// @@CELL_nine_rows@@
// want: 1 then 1 then 1 then 1 then 1 then 1 then 1 then 1 then 1
function show(p: P) { print(p.name.length) }
show({ name: "1", oz1: 1, tag: "t" })
show({ name: "2", oz2: 1, tag: "t" })
show({ name: "3", oz3: 1, tag: "t" })
show({ name: "4", oz4: 1, tag: "t" })
show({ name: "5", oz5: 1, tag: "t" })
show({ name: "6", oz6: 1, tag: "t" })
show({ name: "7", oz7: 1, tag: "t" })
show({ name: "8", oz8: 1, tag: "t" })
show({ name: "9", oz9: 1, tag: "t" })
