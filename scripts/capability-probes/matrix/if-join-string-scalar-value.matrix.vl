// D2839 — the scalar twin: a string then arm and an i32 else arm, whose join is the
// value union box `string | i32`, the same mechanism as the record template beside it.
// VALUE2 swaps the arms, the order that always ran.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function pick(): boolean { true }
// @@VALUE@@
if pick() { "s" } else { 7 }
// @@TYPE@@
string | i32
// @@TEST@@
v is string
// @@HIT@@
print(v)
// @@MISS@@
print(v + 1)
// @@WANT@@
s
// @@VALUE2@@
if pick() { 7 } else { "s" }
// @@TYPE2@@
i32 | string
// @@PROOF2@@
if v is string { print(v) } else { print(v + 1) }
// @@WANT2@@
8
