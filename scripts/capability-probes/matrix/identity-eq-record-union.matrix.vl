// Reference identity (D15975, docs/identity-design.md §0): `===`/`!==` on a union of record arms (the payload, never the widening box) is one `ref.eq`,
// so a value delivered through any position stays identical to the object it was read from,
// and a structurally equal object built elsewhere does not. Unbuilt today: every cell is a
// parse error until the operator lands.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type A = { a: i32 }
type B = { b: i32 }
const src: A = { a: 1 }
const other: B = { b: 1 }
const held: A | B = src
// @@VALUE@@
src
// @@TYPE@@
A | B
// @@TEST@@
v === held
// @@HIT@@
print("same")
// @@MISS@@
print("other")
// @@WANT@@
same
// @@VALUE2@@
other
// @@TYPE2@@
A | B
// @@PROOF2@@
if v === held { print("same") } else { print("other") }
// @@WANT2@@
other
