// D15054: `==` over a list of records whose field is a `(string | null)[]` holding a null. Each
// element pair compares field by field, and the string-list field tests its element pairs for
// null. The second instance differs only at the null.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type NslR = { xs: (string | null)[], n: i32 }
const nslQ: NslR[] = [{ xs: ["x", null], n: 1 }]
function nslMk(s: string | null): NslR[] {
  return [{ xs: ["x", s], n: 1 }]
}
// @@VALUE@@
nslMk(null)
// @@TYPE@@
NslR[]
// @@TEST@@
v == nslQ
// @@HIT@@
print("same")
// @@MISS@@
print("differs")
// @@WANT@@
same
// @@VALUE2@@
nslMk("y")
// @@TYPE2@@
NslR[]
// @@PROOF2@@
print(v == nslQ)
// @@WANT2@@
false
