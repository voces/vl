// An empty `Set()` or `Map()` handed to a type parameter nothing else types: the parameter closes
// to the container the literal is built at, so the instance takes the argument as built.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function one<B>(b: B) { return [b].length }
// @@VALUE@@
one(Set())
// @@TYPE@@
i32
// @@PROOF@@
print(v)
// @@WANT@@
1
// @@VALUE2@@
one(Map())
// @@TYPE2@@
i32
// @@PROOF2@@
print(v)
// @@WANT2@@
1
