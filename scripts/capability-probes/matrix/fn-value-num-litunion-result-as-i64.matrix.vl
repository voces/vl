// D9492: a function whose result is a numeric literal union of mixed widths, delivered as a
// function returning `i64`, which every member reaches exactly; the adapter converts the result
// as a `return` does. The second value is a lambda binding of an `i32`-based union, whose `* 10^12`
// overflows unless the result is converted.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type W = 1 | 2 | 5000000000
type N = 1 | 2
function __k(): W { return 5000000000 }
const __nTwo: N = 2
const __lamN = () => __nTwo
// @@VALUE@@
__k
// @@TYPE@@
() => i64
// @@PROOF@@
const __r: i64 = v()
print(__r + 1)
// @@WANT@@
5000000001
// @@VALUE2@@
__lamN
// @@TYPE2@@
() => i64
// @@PROOF2@@
const __r2: i64 = v()
print(__r2 * 1000000000000)
// @@WANT2@@
2000000000000
