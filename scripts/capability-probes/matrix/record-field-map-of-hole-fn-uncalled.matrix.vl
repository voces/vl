// D16201: a record holding a fresh map in a field, into which an un-annotated function nothing
// calls is written, bare, in a record or in a list. The value under test is such a record,
// delivered to every position; the proof writes through the delivered record's field and reads
// the map's size, so no call instances the function.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function inc0(a) { return a + 1 }
// @@VALUE@@
{ m: Map() }
// @@TYPE@@
{ m: { [string]: { f: (a: i32) => i32 } } }
// @@PROOF@@
v.m["k"] = { f: inc0 }
print(v.m.length)
// @@WANT@@
1
// @@CELL_const_bare@@
const o = { m: Map() }
o.m["k"] = inc0
print(o.m.length)
// @@CELL_const_record@@
const o = { m: Map() }
o.m["k"] = { f: inc0 }
print(o.m.length)
// @@CELL_const_list@@
const o = { m: Map() }
o.m["k"] = [inc0]
print(o.m.length)
// @@CELL_const_set@@
const o = { m: Map() }
o.m.set("k", { f: inc0 })
print(o.m.length)
// @@CELL_const_two_fields@@
// want: 2
const o = { m: Map(), n: 1 }
o.m["k"] = { f: inc0 }
print(o.m.length + o.n)
// @@CELL_const_nested_field@@
const o = { p: { m: Map() } }
o.p.m["k"] = { f: inc0 }
print(o.p.m.length)
// @@CELL_const_in_function@@
function build() {
  const o = { m: Map() }
  o.m["k"] = { f: inc0 }
  print(o.m.length)
}
build()
// @@CELL_const_read_back@@
const o = { m: Map() }
o.m["k"] = { f: inc0 }
const w = o.m["k"]
if w != null { print(1) }
