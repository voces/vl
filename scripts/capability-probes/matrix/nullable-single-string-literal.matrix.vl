// D2827 — a nullable ONE-member string literal union, `"x" | null`. Canon softens a single
// literal to `string`, so the type reps as the `string | null` niche; the atom niche is for
// two or more members. The proof compares against the literal, which is what read the value
// as a string while the signature carried the atom.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function mkx(b: boolean): "x" | null { if b { return "x" } null }
// @@VALUE@@
mkx(true)
// @@TYPE@@
"x" | null
// @@TEST@@
v == "x"
// @@HIT@@
print("hit")
// @@MISS@@
print("miss")
// @@WANT@@
hit
// @@VALUE2@@
mkx(false)
// @@TYPE2@@
"x" | null
// @@PROOF2@@
if v == null { print("none") } else { print(v) }
// @@WANT2@@
none
