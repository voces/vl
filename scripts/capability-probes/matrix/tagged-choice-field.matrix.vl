// A choice of two un-annotated functions whose closed results differ (`str` returns string, `inc`
// i32), held in an un-annotated record field.
// A call through it dispatches on the member, its result their join (DECISIONS, "A set of
// functions in one slot need not return one type"). Family D17100/D17101/D17104/D17105/D17107.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function inc(a) { return a + 1 }
function str(_a) { return "s" }
function ap(g, x) { return g(x) }
function id<T>(t: T): T { return t }
function wrap<T>(t: T): T[] { return [t] }
function flag(): boolean { return 1 > 0 }
// @@SETUP@@
const rr = { k: if flag() { str } else { inc } }
// @@VALUE@@
rr.k
// @@TYPE@@
(a: i32) => i32 | string
// @@PROOF@@
print(v(4))
// @@WANT@@
s
// @@SKIP@@
return_inferred: the setup runs outside the returning function, which cannot read it
return_annotated: the setup runs outside the returning function, which cannot read it
// @@CELL_called_directly@@
// want: s
const rr = { k: if flag() { str } else { inc } }
const w__A__ = rr.k
print(w(4))
// @@CELL_alias_called_beside@@
