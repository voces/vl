// A list-literal spread of an un-annotated list of nested-record literals whose layout
// matches an earlier-declared record with a nullable field (D2938): the copy must keep the
// source's own record row, at every position, in both faces.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type Ax = { v: i32 }
type Jx = { f: Ax | null }
type Ix = { f: Ax }
const src = [{ f: { v: 7 } }, { f: { v: 8 } }]
// @@VALUE@@
[...src]
// @@TYPE@@
Ix[]
// @@PROOF@@
print(v[1].f.v * 10 + v.length)
// @@WANT@@
82
// @@SKIP@@
is_in_if: the value is a list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
