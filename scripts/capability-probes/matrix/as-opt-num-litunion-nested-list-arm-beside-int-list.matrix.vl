// D16893 — `v as? K[][]` out of a `K[][] | i32[][] | string` box: an `i32[][]` value whose
// every leaf is a member fits (D4771), so the cast reads the elements, as `is` does.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type K = 0 | 1
function mk(k: i32): K[][] | i32[][] | string {
  if k == 0 { return "s" }
  const w: i32[][] = if k == 1 { [[1], [0, 1]] } else { [[1, 5]] }
  return w
}
// @@VALUE@@
mk(1) as? K[][]
// @@TYPE@@
K[][] | null
// @@TEST@@
v != null
// @@HIT@@
print(v[1][1] + 10)
// @@MISS@@
print(0)
// @@WANT@@
11
// @@VALUE2@@
mk(2) as? K[][]
// @@TYPE2@@
K[][] | null
// @@PROOF2@@
print(v == null)
// @@WANT2@@
true
