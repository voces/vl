// D3851, D16820: a lambda with an un-annotated parameter that nothing calls, stored in a binding
// a nested function writes (a capture cell) or in a list, where nothing reads either to call it:
// the lambda is dead, so no call has to fix its parameter types. The built-in positions deliver a
// hole lambda that is called; the cells store an uncalled one in a written cell or a list.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __tag(s: string) { return s + "C" }
// @@VALUE@@
(y) => __tag(y)
// @@TYPE@@
(y: string) => string
// @@PROOF@@
print(v("q"))
// @@WANT@@
qC
// @@CELL_cell_in_function@@
// want: a
function mk(x: string) {
  const c = (y) => y + "C"
  let d1 = c
  function w3(): i32 {
    d1 = c
    return 0
  }
  print(x)
}
mk("a")
// @@CELL_cell_alias_unread@@
// want: a
function mk(x: string) {
  const c = (y) => y + "C"
  let d1 = c
  function w3(): i32 {
    d1 = c
    return 0
  }
  const e = d1
  print(x)
}
mk("a")
// @@CELL_cell_numeric_body@@
// want: a
function mk(x: string) {
  const c = (y) => y * 2
  let d1 = c
  function w3(): i32 {
    d1 = c
    return 0
  }
  print(x)
}
mk("a")
// @@CELL_cell_two_lambdas@@
// want: a
function mk(x: string) {
  const c = (y) => y + "C"
  const k = (z) => z * 3
  let d1 = c
  let d2 = k
  function w3(): i32 {
    d1 = c
    d2 = k
    return 0
  }
  print(x)
}
mk("a")
// @@CELL_cell_called@@
// want: qC
function mk(x: string) {
  const c = (y) => y + "C"
  let d1 = c
  function w3(): i32 {
    d1 = c
    return 0
  }
  print(d1("q"))
}
mk("a")
// @@CELL_cell_at_module_scope@@
// want: a
const c = (y) => y + "C"
let d1 = c
function w3(): i32 {
  d1 = c
  return 0
}
print("a")
// @@CELL_list_unread@@
// want: a
function mk(x: string) {
  const c = (y) => y + "C"
  const fs = [c]
  print(x)
}
mk("a")
// @@CELL_list_two_lambdas@@
// want: a
function mk(x: string) {
  const c = (y) => y + "C"
  const k = (z) => z * 3
  const fs = [c, k]
  print(x)
}
mk("a")
// @@CELL_list_alias_unread@@
// want: a
function mk(x: string) {
  const c = (y) => y + "C"
  const fs = [c]
  const gs = fs
  print(x)
}
mk("a")
// @@CELL_list_called@@
// want: qC
function mk(x: string) {
  const c = (y) => y + "C"
  const fs = [c]
  print(fs[0]("q"))
}
mk("a")
// @@CELL_list_iterated@@
// want: qC
function mk(x: string) {
  const c = (y) => y + "C"
  const fs = [c]
  for f in fs { print(f("q")) }
}
mk("a")
// @@CELL_list_length_read@@
// want: 1
function mk(x: string) {
  const c = (y) => y + "C"
  const fs = [c]
  print(fs.length)
}
mk("a")
// @@CELL_list_at_module_scope@@
// want: a
const c = (y) => y + "C"
const fs = [c]
print("a")
