// A closure over a map it reads and writes by key, delivered and called twice.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __mk() {
  const m: {[string]: i32} = Map()
  return (k: string) => {
    m[k] = (m[k] ?? 0) + 1
    return m[k] ?? 0
  }
}
// @@VALUE@@
__mk()
// @@TYPE@@
(k: string) => i32
// @@PROOF@@
v("a")
print(v("a"))
// @@WANT@@
2
