// A generic `compose` of two generic functions, delivered and called at `string`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function gid<A>(x: A): A { x }
function compose<A, B, C>(f: (a: A) => B, g: (b: B) => C): (a: A) => C { (a: A) => g(f(a)) }
// @@VALUE@@
compose(gid, gid)
// @@TYPE@@
(a: string) => string
// @@PROOF@@
print(v("s"))
// @@WANT@@
s
