// D2621: a declared `__…__` intrinsic named as a value, not called. The value reads a wrapper
// function of the intrinsic's own signature, so every function-value position takes it.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function seed() { __store_i32__(64, 41) }
// @@SETUP@@
seed()
// @@VALUE@@
__load_i32__
// @@TYPE@@
(i32) => i32
// @@TEST@@
v(64) == 41
// @@HIT@@
print(v(64) + 1)
// @@MISS@@
print("miss")
// @@WANT@@
42
