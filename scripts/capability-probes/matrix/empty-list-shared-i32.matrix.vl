// sunpa SP-043: an empty list literal reads its element type's one shared zero-length backing.
// Capacity 0 means the first push reallocates, so no list ever writes the shared array. The
// proof grows the delivered list AND a second empty literal of the same type, then reads both:
// a push that wrote the shared backing would show in the other list.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@VALUE@@
[]
// @@TYPE@@
i32[]
// @@PROOF@@
v.push(4)
const other: i32[] = []
other.push(9)
v.push(5)
print(other.length * 10000 + v.length * 1000 + v[0] * 100 + v[1] * 10 + other[0])
// @@WANT@@
12459
// @@VALUE2@@
[]
// @@PROOF2@@
print(v.length + 70)
// @@WANT2@@
70
// @@SKIP@@
is_in_if: the value is a list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
