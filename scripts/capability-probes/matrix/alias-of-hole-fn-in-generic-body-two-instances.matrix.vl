// D6320/D6321/D6322: a generic body calling a `const` alias of a hole function, a `fw(id)`
// binding also read at module scope, or a block-local maker's result, at its own type
// parameter, instanced at two types. The prelude calls each body at the other type.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __id(x) { return x }
const __q = __id
function __body<T>(x: T): T { return __q(x) }
const __s = __body("s")
function __fw(f) { return f }
function __id2(x) { return x }
const __q2 = __fw(__id2)
const __q2m = __q2(3)
function __body2<T>(x: T): T { return __q2(x) }
const __t = __body2("t")
function __k<T>(x: T): T { return x }
function __body3<U>(u: U): U {
  function mk() { return __k }
  const a = mk()
  return a(u)
}
const __u = __body3("u")
// @@VALUE@@
__body(41)
// @@TYPE@@
i32
// @@PROOF@@
print(v)
// @@WANT@@
41
// @@TEST@@
v == 41
// @@HIT@@
print(v)
// @@MISS@@
print(0)
// @@VALUE2@@
__body2(7) + __body3(0)
// @@TYPE2@@
i32
// @@PROOF2@@
print(v)
// @@WANT2@@
7
