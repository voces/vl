// D16726, D16886: an empty `Map()` or `Set()`, or a generic's call handing one back, read in place
// by a key read, delivered to every position: the read's key fixes the container's key.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __ectake<B>(b: B): B { return b }
// @@VALUE@@
__ectake(Set()).has(1)
// @@TYPE@@
boolean
// @@TEST@@
v == false
// @@HIT@@
print(1)
// @@MISS@@
print(0)
// @@WANT@@
1
// @@CELL_set_has_int@@
// want: false
print(Set().has(1))
// @@CELL_map_has_int@@
// want: false
print(Map().has(1))
// @@CELL_map_index_default@@
// want: 0
print(Map()[1] ?? 0)
// @@CELL_map_get_default@@
// want: 7
print(Map().get(3) ?? 7)
// @@CELL_map_keys_length@@
// want: 0
print(Map().keys().length)
// @@CELL_generic_map_index@@
// want: 0
print(__ectake(Map())[1] ?? 0)
// @@CELL_map_has_string@@
// want: false
print(Map().has("a"))
// @@CELL_map_get_string_default@@
// want: 7
print(Map().get("a") ?? 7)
// @@CELL_map_get_string@@
// want: null
print(Map().get("a"))
