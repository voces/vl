// D16726, D16886, D16892: an empty `Map()` or `Set()`, a generic's call handing one back, or an
// element of a list literal of them, read in place by a key read, delivered to every position:
// the read's key fixes the container's key.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __ectake<B>(b: B): B { return b }
function __ecfld<B>(o: {m: B}): B { return o.m }
function __eckeep<B>(b: B, n: i32): B { return if n > 0 { b } else { b } }
// @@VALUE@@
__ectake(Set()).has(1)
// @@TYPE@@
boolean
// @@TEST@@
v == false
// @@HIT@@
print(1)
// @@MISS@@
print(0)
// @@WANT@@
1
// @@CELL_set_has_int@@
// want: false
print(Set().has(1))
// @@CELL_map_has_int@@
// want: false
print(Map().has(1))
// @@CELL_map_index_default@@
// want: 0
print(Map()[1] ?? 0)
// @@CELL_map_get_default@@
// want: 7
print(Map().get(3) ?? 7)
// @@CELL_map_keys_length@@
// want: 0
print(Map().keys().length)
// @@CELL_generic_map_index@@
// want: 0
print(__ectake(Map())[1] ?? 0)
// @@CELL_map_has_string@@
// want: false
print(Map().has("a"))
// @@CELL_map_get_string_default@@
// want: 7
print(Map().get("a") ?? 7)
// @@CELL_map_get_string@@
// want: null
print(Map().get("a"))
// @@CELL_list_elem_get_default@@
// want: 7
print([Map()][0].get("a") ?? 7)
// @@CELL_generic_list_elem_get_default@@
// want: 7
print(__ectake([Map()])[0].get("a") ?? 7)
// @@CELL_generic_scalar_arg_has@@
// want: false
print(__eckeep(Map(), 1).has("a"))
// @@CELL_pick_bound_global_then_written@@
// want: true
const g = Map()
function pickG<B>(a: B, b: boolean) { return if b { g } else { g } }
const r = pickG(Map(), true).has("a")
g.set("a", "x")
print(r == false && (g.get("a") ?? "n") == "x")
// @@CELL_field_of_bound_then_written@@
// want: true
const m = Map()
const r = __ecfld({ m: m }).has("a")
m.set("a", "x")
print(r == false && (m.get("a") ?? "n") == "x")
// @@CELL_generic_bound_then_written@@
// want: true
const m = Map()
const r = __ectake(m).has("a")
m.set("a", "x")
print(r == false && (m.get("a") ?? "n") == "x")
