// D2497 — the annotated twin of `tail-write-null-field`: the producer declares `: null` and its
// tail statement writes a bare `null` to a field, so the write's value is the return.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type __O = { v: string | null }
function __tw(o: __O): null { o.v = null }
// @@VALUE@@
__tw({ v: "a" })
// @@TYPE@@
string | null
// @@TEST@@
v != null
// @@HIT@@
print(v)
// @@MISS@@
print("none")
// @@WANT@@
none
// @@SKIP@@
map_value: a map whose VALUE is `null` cannot be told from a missing key — the read's `!= null` guard is false either way
