// D15059: `==` over a list of `(string | null)[]` lists holding a null. The inner compare is
// the string-list core, which tests each element pair for null wherever it is reached. The
// second instance differs only at the null.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
const nslQ: (string | null)[][] = [["x", null], [null, "z"]]
function nslMk(s: string | null): (string | null)[][] {
  return [["x", s], [null, "z"]]
}
// @@VALUE@@
nslMk(null)
// @@TYPE@@
(string | null)[][]
// @@TEST@@
v == nslQ
// @@HIT@@
print("same")
// @@MISS@@
print("differs")
// @@WANT@@
same
// @@VALUE2@@
nslMk("y")
// @@TYPE2@@
(string | null)[][]
// @@PROOF2@@
print(v == nslQ)
// @@WANT2@@
false
