// A generic's function-typed parameter delivered at a concrete function type, inside a body
// that also calls ANOTHER generic whose type parameter has the same name.
//
// The value's hole `T` is left open: `viaGen<T>` is bound only by its argument, and the parked
// demand `apply(g)` is re-asked when a hole named `T` takes a pin, and `j`'s `T`, pinned after
// it at `string`, is a different variable that must not re-ask that demand (D5290).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function j<T>(x: T): T { return x }
function apply(f: (x: i32) => i32): i32 { return f(6) }
function viaGen<T>(g: (x: T) => T): i32 { const a = apply(g); const s = j("str"); return a + s.length }
function dbl(x: i32): i32 { return x * 2 }
function neg(x: i32): i32 { return 0 - x }
// @@VALUE@@
viaGen(dbl)
// @@TYPE@@
i32
// @@PROOF@@
print(v)
// @@WANT@@
15
// @@VALUE2@@
viaGen(neg)
// @@TYPE2@@
i32
// @@PROOF2@@
print(v)
// @@WANT2@@
-3
