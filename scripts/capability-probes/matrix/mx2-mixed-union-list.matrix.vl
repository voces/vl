// D1719 — a MIXED scalar-and-struct union (`i32 | A`) delivered as a LIST ELEMENT, then
// discriminated and read at its struct arm. The element rep itself is the box every other
// boxed element uses; what the row is about is the READ, so the discrimination positions
// are the load-bearing half of this grid and the deliveries are its control.
//
// The template cannot express the row's own witness — every position binds the delivered
// value to `v` before proving, and `xs[0].r` under `if xs[0] is A` reads the PLACE. That
// receiver shape is graded by the grid on the row instead.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type A = { r: i32 }
type M = i32 | A
function st(): A { return { r: 8 } }
function pick(b: boolean): M { if b { return st() } return 7 }
// @@VALUE@@
pick(true)
// @@TYPE@@
M
// @@TEST@@
v is A
// @@HIT@@
print(v.r)
// @@MISS@@
print(0)
// @@WANT@@
8
