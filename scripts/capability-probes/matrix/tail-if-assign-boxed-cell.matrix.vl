// D1589 — the value is what an else-less tail `if c { x = 5 }` RETURNS when the assigned
// cell is a value-union BOX. An else-less `if` in tail position is `T | null` (DECISIONS,
// 2026-09-02) and an assignment's value is its TARGET CELL (`fnAssignRetKind`), so this
// function's result valtype is the box the cell already holds — and the re-read
// `emitBinExprNode` emits for the value pushes exactly that box. Nothing said so to
// `emitUnionCoerce`, which read the node as an unclassified scalar and `struct.new`'d the box
// into an i32 payload field: `expected i32, found (ref $type)`, `vl check` rc 0, before the
// caller was even reached.
//
// THE PRELUDE IS THE PRODUCER and the delivery is what it feeds: every position takes the
// value the broken function hands back, so a cell that RUNS proves both ends agree about the
// box. The `i32 | null` cell is the annotated spelling; the un-annotated `let x = null` twin
// reaches the same emit arm through D1576's filled hole.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function __tailfill(c: boolean) {
  let x: i32 | null = null
  if c { x = 5 }
}
// @@VALUE@@
__tailfill(true)
// @@TYPE@@
i32 | null
// @@TEST@@
v != null
// @@HIT@@
print(v)
// @@MISS@@
print("none")
// @@WANT@@
5
