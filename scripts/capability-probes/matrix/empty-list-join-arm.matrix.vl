// D2209 — an empty `[]` in one arm of a value `if`, at every delivery position and in both
// faces. The literal has no element of its own, so it is built at the type the join gives it:
// its sibling arm's. VALUE puts the empty arm second (plumb's PL-022 spelling), VALUE2 puts it
// first, where the empty arm used to decide the join's blocktype.
//
// The element is a STRUCT so the join is a ref list: a scalar-backed element (string, f64)
// exercises the strlist/f64list rungs, which the grid in the D2209 row graded separately.
// The PROOF takes the empty arm and pushes onto it, so a wrong backing cannot pass.
//
// The generic twin, which leaves the element type open, is `empty-list-join-arm-generic`.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type P = { x: i32 }
function falsy() { 1 == 2 }
function truthy() { 1 == 1 }
const src: P[] = [{ x: 1 }, { x: 2 }]
// @@VALUE@@
if falsy() { src } else { [] }
// @@TYPE@@
P[]
// @@PROOF@@
const r = v
r.push({ x: 7 })
print(r.length)
// @@WANT@@
1
// @@VALUE2@@
if truthy() { [] } else { src }
// @@TYPE2@@
P[]
// @@PROOF2@@
const r2 = v
r2.push({ x: 8 })
print(r2.length + r2[0].x)
// @@WANT2@@
9
// @@SKIP@@
is_in_if: the value is a list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
