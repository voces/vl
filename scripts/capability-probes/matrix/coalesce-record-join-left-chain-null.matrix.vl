// D2373's left-nested chain with every operand null: `(a ?? b) ?? c` over two records and a
// nullable last default is the box's null, and no arm test may answer true. The second
// instance is the right-nested twin with a same-record inner join.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@SKIP@@
map_value: the builder guards its read with `!= null`, and this template's value is null by
design, so the guarded body never runs
map_value_place: the same `!= null` guard as `map_value`
// @@PRELUDE@@
type A = { r: i32 }
type B = { q: string }
function mkA(n: i32): A | null { if n == 0 { return null } return { r: n } }
function mkB(n: i32): B | null { if n == 0 { return null } return { q: "b" } }
// @@VALUE@@
(mkA(0) ?? mkB(0)) ?? mkA(0)
// @@TYPE@@
A | B | null
// @@TEST@@
v is A || v is B
// @@HIT@@
print("arm")
// @@MISS@@
print("none")
// @@WANT@@
none
// @@VALUE2@@
mkA(0) ?? (mkB(0) ?? mkB(0))
// @@TYPE2@@
A | B | null
// @@PROOF2@@
print(v == null)
// @@WANT2@@
true
