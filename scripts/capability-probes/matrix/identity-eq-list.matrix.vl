// Reference identity (D15975, docs/identity-design.md §0): `===`/`!==` on a list (its header) is one `ref.eq`,
// so a value delivered through any position stays identical to the object it was read from,
// and a structurally equal object built elsewhere does not. Unbuilt today: every cell is a
// parse error until the operator lands.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
const src: i32[] = [1, 2]
function mkTwin(): i32[] { return [1, 2] }
// @@VALUE@@
src
// @@TYPE@@
i32[]
// @@TEST@@
v !== src
// @@HIT@@
print("other")
// @@MISS@@
print("same")
// @@WANT@@
same
// @@VALUE2@@
mkTwin()
// @@TYPE2@@
i32[]
// @@PROOF2@@
if v !== src { print("other") } else { print("same") }
// @@WANT2@@
other
