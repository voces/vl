// D8021: an object literal handed through a generic identity whose type parameter only the
// literal fixes, delivered into a union holding a record that stores a field wider than the
// literal's own. The literal is built as that union member and the instance is pinned from that
// member's row. The type parameter stays open.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type J = { r: i32 | null }
function idn<T>(v: T): T { v }
// @@VALUE@@
idn({ r: 4 })
// @@TYPE@@
J | string
// @@WANT@@
4
// @@TEST@@
v is J
// @@HIT@@
print(v.r ?? 0)
// @@MISS@@
print(0)
// @@SKIP@@
array_element_place: a narrowed list element re-read for a nullable field is D8145, with no generic call in it
