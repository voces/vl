// D8021: an object literal handed through a generic identity whose type parameter only the
// literal fixes, delivered into a union holding a record that stores a field wider than the
// literal's own. The literal should be built as that union member; the annotated positions are
// invalid wasm until the generic instance is pinned from that member's row. The type parameter
// stays open.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type J = { r: i32 | null }
function idn<T>(v: T): T { v }
// @@VALUE@@
idn({ r: 4 })
// @@TYPE@@
J | string
// @@WANT@@
4
// @@TEST@@
v is J
// @@HIT@@
print(v.r ?? 0)
// @@MISS@@
print(0)
