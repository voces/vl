// D2590 — a value union narrowed by elimination to `boolean | null`, delivered where that type
// is wanted: the read converts the box to the niche.
// @@PRELUDE@@
function pickB(n: i32): string | boolean | null {
  if n == 0 { return "s" }
  if n == 1 { return true }
  null
}
// @@SETUP@@
const x = pickB(1)
// @@GUARD@@
!(x is string)
// @@FALLBACK@@
null
// @@VALUE@@
x
// @@TYPE@@
boolean | null
// @@TEST@@
v == null
// @@HIT@@
print("null")
// @@MISS@@
print(!(v ?? false))
// @@WANT@@
false
