// A list of lists of records whose field holds un-annotated functions of different result types,
// delivered at every position: a call through `xs[i][j].f` runs the function stored there, as
// it does through a list of records or a list of lists of functions (D16824).
// @@PRELUDE@@
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const rows = [[{ f: inc0 }], [{ f: half }]]
// @@VALUE@@
rows
// @@TYPE@@
{ f: (f64) => f64 }[][]
// @@PROOF@@
print(v[1][0].f(3))
// @@WANT@@
1.5
// @@CELL_direct_both_rows@@
// want: 1.5 then 4
print(rows[1][0].f(3))
print(rows[0][0].f(3))
// @@CELL_one_inner_list@@
// want: 1.5 then 4
const ys = [[{ f: inc0 }, { f: half }]]
print(ys[0][1].f(3))
print(ys[0][0].f(3))
// @@CELL_three_levels@@
// want: 1.5
const ys = [[[{ f: inc0 }]], [[{ f: half }]]]
print(ys[1][0][0].f(3))
// @@CELL_field_written@@
// want: 1.5
const ys = [[{ f: inc0 }], [{ f: half }]]
ys[0][0].f = half
print(ys[0][0].f(3))
// @@CELL_inner_pushed@@
// want: 1.5
const ys = [[{ f: inc0 }]]
ys[0].push({ f: half })
print(ys[0][1].f(3))
// @@CELL_outer_pushed@@
// want: 1.5
const ys = [[{ f: inc0 }]]
ys.push([{ f: half }])
print(ys[1][0].f(3))
// @@CELL_loops@@
// want: 4 then 1.5
for row in rows {
  for r in row { print(r.f(3)) }
}
// @@CELL_second_field@@
// want: 1.5 then 2
const ys = [[{ f: inc0, n: 1 }], [{ f: half, n: 3 }]]
print(ys[1][0].f(ys[1][0].n))
print(ys[0][0].f(ys[0][0].n))
