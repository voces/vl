// An inline `<arms> | null` whose arms differ only in a lone-literal field, narrowed off
// `null` and read. The render of the arms re-parses to one record, so the type, not the
// spelling, must name the box. The proof reads the literal and the shared field (D5240).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function mk(a: boolean): { tag: "a", n: i32 } | { tag: "b", n: i32 } | null {
  if a { return { tag: "a", n: 7 } }
  { tag: "b", n: 8 }
}
// @@VALUE@@
mk(false)
// @@TYPE@@
{ tag: "a", n: i32 } | { tag: "b", n: i32 } | null
// @@TEST@@
v != null
// @@HIT@@
if v.tag == "b" { print(v.n) } else { print(0 - v.n) }
// @@MISS@@
print(0)
// @@WANT@@
8
// @@VALUE2@@
mk(true)
// @@TYPE2@@
{ tag: "a", n: i32 } | { tag: "b", n: i32 } | null
// @@PROOF2@@
if v == null { print(0) } else { if v.tag == "a" { print(0 - v.n) } else { print(v.n) } }
// @@WANT2@@
-7
