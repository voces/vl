// D10090: a join of a runtime `i32` and a runtime `f64` in a recursive function, an `if` bound and
// returned by a self-recursive one and a `??` returned by a mutually recursive pair, is `i32 | f64`
// as it is in a function that does not recurse: each value keeps its own member.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __rjSelf(q: i32 | null, d: f64, n: i32) {
  if n > 0 { return __rjSelf(q, d, n - 1) }
  const r = if q != null { q } else { d }
  r
}
function __rjA(q: i32 | null, d: f64, n: i32) {
  if n > 0 { return __rjB(q, d, n - 1) }
  q ?? d
}
function __rjB(q: i32 | null, d: f64, n: i32) { __rjA(q, d, n) }
// @@VALUE@@
__rjSelf(5, 1.5, 2)
// @@TYPE@@
i32 | f64
// @@PROOF@@
print(v is i32 && v == 5)
// @@WANT@@
true
// @@VALUE2@@
__rjA(null, 2.5, 2)
// @@TYPE2@@
i32 | f64
// @@PROOF2@@
print(v is f64 && v == 2.5)
// @@WANT2@@
true
