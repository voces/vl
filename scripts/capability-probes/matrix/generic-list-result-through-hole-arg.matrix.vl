// D6500: a generic's `T[]` result reached through an un-annotated parameter, then read. The
// type parameter is bound only through the hole's element; the annotated face annotates only
// the destination.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __lg<T>(x: T[]): T[] {
  return x
}
function __lf(a) {
  return __lg(a)
}
// @@VALUE@@
__lf([4, 5])
// @@TYPE@@
i32[]
// @@PROOF@@
print(v.length + v[1])
// @@WANT@@
7
// @@TEST@@
v[0] == 4
// @@HIT@@
print(v.length + v[1])
// @@MISS@@
print(0)
// @@VALUE2@@
__lf(["s", "t"])
// @@TYPE2@@
string[]
// @@PROOF2@@
print(v[1])
// @@WANT2@@
t
