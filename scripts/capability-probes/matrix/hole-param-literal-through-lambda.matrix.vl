// D5840: a list literal handed through a const lambda's un-annotated parameter to a function
// whose own parameter fixes its element type. The literal's ints must widen to f64 at that
// call, so the proof prints a half that an i32 element cannot hold.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __id(b: f64[][]): f64[][] {
  return b
}
const __ap = (g, y) => g(y)
// @@VALUE@@
__ap(__id, [[1]])
// @@TYPE@@
f64[][]
// @@PROOF@@
print(v[0][0] / 2)
// @@WANT@@
0.5
// @@TEST@@
v.length == 1
// @@HIT@@
print(v[0][0] / 2)
// @@MISS@@
print(0)
