// An un-annotated function handed to a generic whose result wraps the arrow's result type
// (`U[]`), which only that function's body binds (D9000). `m`'s `U` is left OPEN, so the list's
// element type comes from `half`'s or `inc`'s body at the bound `T = i32`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function half(a) { return a / 2.0 }
function inc(a) { return a + 1 }
function m<T, U>(xs: T[], k: (a: T) => U): U[] { return xs.map(k) }
// @@VALUE@@
m([3], half)
// @@TYPE@@
f64[]
// @@PROOF@@
print(v[0] * 2.0)
// @@WANT@@
3
// @@VALUE2@@
m([3], inc)
// @@TYPE2@@
i32[]
// @@PROOF2@@
print(v[0] + 1)
// @@WANT2@@
5
