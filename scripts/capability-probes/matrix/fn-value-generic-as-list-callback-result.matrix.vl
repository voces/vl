// A declared generic handed to `.map` over a list (D9004). The receiver's element binds the
// generic's type parameter, so `[1.5].map(idg)` is `f64[]` and `[3, 4].map(wrap)` is `i32[][]`;
// a lambda or an annotated destination is typed by its own spelling and cannot see the defect.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function idg<T>(t: T): T { return t }
function wrap<T>(t: T): T[] { return [t, t] }
// @@VALUE@@
[1.5].map(idg)
// @@TYPE@@
f64[]
// @@PROOF@@
print(v[0] * 2.0)
// @@WANT@@
3
// @@VALUE2@@
[3, 4].map(wrap)
// @@TYPE2@@
i32[][]
// @@PROOF2@@
print(v[1][0] + v[1].length)
// @@WANT2@@
6
