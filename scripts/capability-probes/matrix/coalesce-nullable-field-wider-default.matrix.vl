// D10060: a `??` over an `i32 | null` record field with an `f64` default builds, the field read
// at the result's rep. The result is `i32 | f64` (D10061, the numeric-join ruling), so the proof
// tests `is i32` on a present field and prints the default on a null one.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __cnPick(r: { v: i32 | null }, d: f64) { return r.v ?? d }
const __cnR: { v: i32 | null } = { v: 5 }
const __cnN: { v: i32 | null } = { v: null }
// @@VALUE@@
__cnPick(__cnR, 1.5)
// @@TYPE@@
i32 | f64
// @@TEST@@
v is i32
// @@HIT@@
print(v * 2)
// @@MISS@@
print("widened")
// @@WANT@@
10
// @@VALUE2@@
__cnPick(__cnN, 1.5)
// @@TYPE2@@
i32 | f64
// @@PROOF2@@
print(v)
// @@WANT2@@
1.5
