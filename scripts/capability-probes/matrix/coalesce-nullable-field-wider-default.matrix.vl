// D10060: a `??` over an `i32 | null` record field with an `f64` default is an `f64`, the
// field widened when present. The proof divides, which prints `2.5` only at `f64`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __cnPick(r: { v: i32 | null }, d: f64) { return r.v ?? d }
const __cnR: { v: i32 | null } = { v: 5 }
// @@VALUE@@
__cnPick(__cnR, 1.5)
// @@TYPE@@
f64
// @@TEST@@
v > 0
// @@HIT@@
print(v / 2)
// @@MISS@@
print("miss")
// @@WANT@@
2.5
