// D2235 — a narrowed nullable list FIELD delivered as a value, string elements: the
// receiver rows' control. The proof pushes, index-stores, reads `.length` and iterates, so
// every list operation is graded on the delivered value at every position.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@SETUP@@
const __r: { f: string[] | null } = { f: ["a"] }
// @@GUARD@@
__r.f != null
// @@VALUE@@
__r.f
// @@TYPE@@
string[]
// @@FALLBACK@@
["a"]
// @@TEST@@
v.length > 0
// @@HIT@@
v.push("b")
v[0] = "b"
let __n = 0
for __x in v {
  __n = __n + 1
}
print(__n == v.length && __n > 1)
// @@MISS@@
print(false)
// @@WANT@@
true
