// D3491 — a literal union whose integer members span two widths (`1 | 9000000000`) boxes,
// and a value returned through a function declared with it is delivered to every position.
// The declared result once lowered as a bare `i32` while every binding boxed, so the signature
// and its caller disagreed. The HIT prints the wide member, which an `i32` would truncate.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type D = 9000000000 | 1
function pick(n: i32): D {
  if n > 0 { return 9000000000 }
  1
}
// @@VALUE@@
pick(1)
// @@TYPE@@
D
// @@TEST@@
v == 9000000000
// @@HIT@@
print(v)
// @@MISS@@
print("miss")
// @@WANT@@
9000000000
// @@VALUE2@@
pick(0)
// @@TYPE2@@
D
// @@PROOF2@@
print(v)
// @@WANT2@@
1
