// A `const` bound to an `if` choosing between two generic functions, called at one type in the
// prelude and delivered at another at each position (D9120, D9121). The binding holds one value
// per type it is used at, so neither use is emitted against the other's instance.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function idg<T>(t: T): T { return t }
function kg<T>(t: T): T { return t + t }
function app<T>(g: (x: T) => T, v: T): T { return g(v) }
const on = [1].length > 0
const h = if on { kg } else { idg }
const s = h("x")
// @@VALUE@@
h(1.5)
// @@TYPE@@
f64
// @@PROOF@@
if s == "xx" { print(v * 2.0) } else { print(0.0) }
// @@WANT@@
6
// @@VALUE2@@
app(h, 2)
// @@TYPE2@@
i32
// @@PROOF2@@
print(v * s.length)
// @@WANT2@@
8
