// The open twin of fn-value-null-result-into-generic-nullable: the function value is a
// generic's own `() => V` result, bound to `null` by inference at the maker's call, and
// `len`'s `T` is still bound by nothing.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function mkF<V>(x: V): () => V { (): V => x }
function len<T>(f: () => T | null) {
  const t = f()
  if t == null { 7 } else { 99 }
}
// @@VALUE@@
mkF(null)
// @@TYPE@@
() => null
// @@PROOF@@
print(len(v))
// @@WANT@@
7
// @@VALUE2@@
mkF(null)
// @@TYPE2@@
() => null
// @@PROOF2@@
print(len(v) + 1)
// @@WANT2@@
8
