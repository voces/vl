// D9802, D9682: an un-annotated body that mixes i64 and f64 is refused at the pin, as at top
// level; the `as` spelling the refusal names must run at every position instead. VALUE is the
// union face (`i64 | null` defaulted with `0.5`), VALUE2 the scalar face (an i64 parameter).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
const __jq: i64 | null = null
function __mixTake(a) {
  const r = a ?? 0.5
  (r as f64) * 2.0
}
function __mixAdd(x) { (x as f64) + 1.5 }
// @@VALUE@@
__mixTake(__jq)
// @@TYPE@@
f64
// @@PROOF@@
print(v / 4.0)
// @@WANT@@
0.25
// @@TEST@@
v > 0.5
// @@HIT@@
print(v / 4.0)
// @@MISS@@
print("miss")
// @@VALUE2@@
__mixAdd(5000000000)
// @@TYPE2@@
f64
// @@PROOF2@@
print(v * 2.0)
// @@WANT2@@
10000000003
