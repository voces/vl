// D2690 — a union holding both same-struct twins, delivered into a union holding only the
// wider twin beside `string`: a box built under the narrower twin is retagged on delivery, so
// `is` and `match` in the destination name the member it holds there.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type Circle = { r: i32 }
type Sq = { s: i32 }
function mkc(): Circle | Sq { { r: 3 } }
function mks(): Circle | Sq { { s: 4 } }
function mkin(n: i32): {[string]: i32} {
  const m: {[string]: i32} = Map()
  m["q"] = n
  if n > 1 { m["r"] = n }
  m
}
function mka(): {[string]: Circle} {
  const m: {[string]: Circle} = Map()
  m.set("a", { r: 3 })
  m
}
function mkb(): {[string]: Circle | null} {
  const m: {[string]: Circle | null} = Map()
  m.set("a", { r: 4 })
  m.set("b", null)
  m
}
function pick(n: i32): {[string]: Circle} | {[string]: Circle | null} {
  if n > 0 { return mkb() }
  return mka()
}
// @@VALUE@@
pick(1)
// @@TYPE@@
{[string]: Circle | null} | string
// @@TEST@@
v is {[string]: Circle | null}
// @@HIT@@
print(v.length)
const x = v["a"]
if x != null { print(x.r) } else { print("null") }
// @@MISS@@
print("wrong")
// @@WANT@@
2 then 4
// @@VALUE2@@
pick(0)
// @@TYPE2@@
{[string]: Circle | null} | string
// @@PROOF2@@
if v is {[string]: Circle | null} {
  print(v.length)
  const x = v["a"]
  if x != null { print(x.r) } else { print("null") }
} else { print("wrong") }
match v {
  string => print("s")
  {[string]: Circle | null} => print("m")
}
// @@WANT2@@
1 then 3 then m
