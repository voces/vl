// A list-literal spread of a record list beside a `null`: the literal is `(Cx | null)[]` and
// must build at that nullable row, not its source's, at every position, in both faces.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type Cx = { r: i32 }
const src: Cx[] = [{ r: 6 }]
// @@VALUE@@
[...src, null]
// @@TYPE@@
(Cx | null)[]
// @@PROOF@@
const p = v[0]
const q = v[1]
if p != null && q == null { print(p.r * 10 + v.length) } else { print("miss") }
// @@WANT@@
62
// @@SKIP@@
is_in_if: the value is a list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
