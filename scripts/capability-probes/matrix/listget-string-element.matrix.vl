// D1684 — `xs.get(i) ?? d` over a `string[]`. Four descriptors keyed on the element kind
// (`scalarListWrap`, `scalarListBack`, `scalarListBlocktype`, `scalarListUsed`) each fell
// through to the i32 list's answer, and `exprArray`'s typed-IR fast path claims ANY array,
// so a string list read at the i32 backing: a refusal alone, invalid wasm beside an i32 list.
//
// The i32 list in the prelude is load-bearing — it is what turns the refusal into the
// clause-1 cell, since the fall-through it reaches is that list's `lUsed` flag.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
const nums = [1, 2]
const ys: string[] = ["a", "b"]
// @@SETUP@@
const __n = nums[0]
// @@VALUE@@
ys.get(1) ?? "z"
// @@TYPE@@
string
// @@FALLBACK@@
"z"
// @@TEST@@
v == "b"
// @@HIT@@
print("b")
// @@MISS@@
print("no")
// @@WANT@@
b
