// D8000: `is` on a value-union field of a map read narrowed by `!= null`. The map's value
// type is a generic body's open `E`, so the record's rep is only known at the instance.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type __E = { f: i32 | string }
function __mk(f: i32 | string): __E { return { f: f } }
function __single<E>(k: string, e: E): { [string]: E } {
  const m: { [string]: E } = Map()
  m[k] = e
  return m
}
// @@VALUE@@
__single("k", __mk(3))
// @@TYPE@@
{ [string]: __E }
// @@PROOF@@
if v["k"] != null { print(v["k"].f is i32) }
// @@WANT@@
true
// @@VALUE2@@
__single("k", __mk("s"))
// @@TYPE2@@
{ [string]: __E }
// @@PROOF2@@
if v["k"] != null { print(v["k"].f is i32) }
// @@WANT2@@
false
