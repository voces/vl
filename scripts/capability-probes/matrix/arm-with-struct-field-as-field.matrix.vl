// D1579 — a union ARM whose OWN field is a struct (`A = {n: i32, inner: Inner}`, `A | E`),
// read through a plain struct that HOLDS the arm (`S = {a: A, p: i32}`), delivered to every
// position. D1518 gave an arm a struct-table row; the cross-table layout guard still declined
// any arm carrying a ref the field CODE does not name, so `S` had no rep for its `a` field.
//
// THE HOLDER IS THE DELIVERED VALUE, not the union. The defect is the FIELD's storage, and a
// template that delivered `A | E` would grade the union's box at every position while
// exercising the arm-typed field only inside the proof. `arm-with-buf-field-state-struct`
// is the union-delivery face of the same capability.
//
// `make` IS LOAD-BEARING SCENERY, and `mkS` calls it so it is not merely declared: deleting
// the `A | E` union leaves `A` a plain struct with a plain nested field and every cell runs
// on master. It is what puts `A` under `collectS`'s union-member skip.
//
// THE PROOF READS BOTH LEAVES OF THE NESTED FIELD (`v.a.inner.base` and `.length`) plus the
// arm's own scalar and the holder's, so a row whose `a` slot named the wrong heap type traps
// or prints a wrong number rather than passing.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type Inner = { base: i32, length: i32 }
type A = { n: i32, inner: Inner }
type E = { msg: string }
type S = { a: A, p: i32 }

function make(ok: boolean): A | E {
  if !ok { return { msg: "make" } }
  return { n: 3, inner: { base: 1, length: 16 } }
}

function mkS(): S {
  const m = make(true)
  if m is A { return { a: m, p: 5 } }
  return { a: { n: 0, inner: { base: 0, length: 0 } }, p: 0 }
}

function mkS2(): S {
  return { a: { n: 4, inner: { base: 2, length: 8 } }, p: 6 }
}
// @@VALUE@@
mkS()
// @@TYPE@@
S
// @@PROOF@@
print(v.a.n + v.a.inner.base + v.a.inner.length + v.p)
// @@WANT@@
25
// @@VALUE2@@
mkS2()
// @@TYPE2@@
S
// @@PROOF2@@
print(v.a.n + v.a.inner.base + v.a.inner.length + v.p)
// @@WANT2@@
20
// @@SKIP@@
is_in_if: the value is a struct, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
