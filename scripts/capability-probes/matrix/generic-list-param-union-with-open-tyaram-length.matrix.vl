// D10880, generic twin: the `(U | i32)[]` list reaches the reading generic through a second
// generic whose `U` stays open, so the union arm binds at the inner call, not at the value.
// The second instance names a record beside the parameter, the grading list's `(S | T)[]`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type S = { g: i32 }
function __len<T>(v: (T | i32)[]): i32 { v.length }
function __outer<U>(v: (U | i32)[]): i32 { __len(v) }
function __lenS<T>(v: (S | T)[]): i32 { v.length }
function __outerS<U>(v: (S | U)[]): i32 { __lenS(v) }
// @@VALUE@@
["a", 3]
// @@TYPE@@
(string | i32)[]
// @@PROOF@@
print(__outer(v))
// @@WANT@@
2
// @@VALUE2@@
[{ g: 1 }, 3]
// @@TYPE2@@
(S | i32)[]
// @@PROOF2@@
print(__outerS(v))
// @@WANT2@@
2
// @@SKIP@@
is_in_if: the value is a list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
