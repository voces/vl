// A `.map`/`.filter` call read straight off its result under an `is` test, an `as` conversion or a
// `match` scrutinee (D10351): the call's scratch frame is reserved wherever the test sits.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function f(k: i32, a: i32, b: string): i32 | string {
  if k == 0 { return a }
  return b
}
// @@VALUE@@
[1].map((i) => f(0, 7, "s"))[0] is i32
// @@TYPE@@
boolean
// @@PROOF@@
print(v)
// @@WANT@@
true
// @@CELL_as_conversion@@
// want: 6.5
print(([3].map((i) => i * 2)[0] as f64) + 0.5)
// @@CELL_filter_is@@
print([1, 2].filter((i) => i > 1)[0] is i32)
// @@CELL_not_is@@
// want: true
print([1].map((i) => f(1, 7, "s"))[0] !is i32)
// @@CELL_match_scrutinee@@
// want: two
const r = match [1].map((i) => i + 1)[0] {
  2 => "two"
  _ => "other"
}
print(r)
// @@CELL_match_arm@@
// want: true
const q = match 1 {
  1 => [1].map((i) => f(0, 7, "s"))[0] is i32
  _ => false
}
print(q)
