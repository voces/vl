// D1518's ORDER FACE — `arm-also-nested-field.matrix.vl` with `B | E` declared BEFORE
// `M | E`, and nothing else changed.
//
// The order decides which of two sentences the program used to get, because it decides
// whether `variantIndexOf("B")` already answers when `collectVariantFields` codes `M`'s
// field: `M | E` first coded it 15 through `nameIsStructDecl` against a target row that
// never existed (the type section's `nested-struct field element type is not interned`),
// `B | E` first made `nameIsStructDecl` decline and the field had no code at all
// (`collectU`'s allow-list sentence, now D734's). ONE missing intern, two sentences — so a
// matrix over one order grades half the row.
//
// The matrix's own faces are annotated / un-annotated, which is why the order is a second
// TEMPLATE rather than a third face.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type E = { msg: string }
type B = { base: i32, length: i32 }
type M = { a: B, n: i32 }

function g(ok: boolean): B | E {
  if !ok { return { msg: "g" } }
  return { base: 2, length: 8 }
}

function f(ok: boolean): M | E {
  if !ok { return { msg: "f" } }
  return { a: { base: 1, length: 16 }, n: 2 }
}
// @@VALUE@@
f(true)
// @@TYPE@@
M | E
// @@TEST@@
v is M
// @@HIT@@
print(v.a.base + v.a.length + v.n)
// @@MISS@@
print(0 - 1)
// @@WANT@@
19
// @@FALLBACK@@
f(false)
// @@VALUE2@@
f(true)
// @@TYPE2@@
M | E
// @@PROOF2@@
if v is M { print(v.a.base + v.a.length + v.n) } else { print(0 - 1) }
// @@WANT2@@
19
