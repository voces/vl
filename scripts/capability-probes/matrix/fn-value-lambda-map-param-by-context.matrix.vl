// D9990: a lambda whose map parameter is typed only by the function type it is delivered to.
// The proof reads the map's length and a stored value through the parameter, so a map read
// through the wrong receiver cannot print 42.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __mk(): {[string]: i32} {
  const m: {[string]: i32} = Map()
  m.set("a", 41)
  m
}
// @@VALUE@@
(k) => k.length + (k.get("a") ?? 0)
// @@TYPE@@
(k: {[string]: i32}) => i32
// @@PROOF@@
print(v(__mk()))
// @@WANT@@
42
// @@VALUE2@@
(k) => k.length
// @@TYPE2@@
(k: {[i32]: i32}) => i32
// @@PROOF2@@
const __m: {[i32]: i32} = Map()
print(v(__m))
// @@WANT2@@
0
