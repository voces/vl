// Reference identity (D15975, docs/identity-design.md §0): `===`/`!==` on a nullable record is one `ref.eq`,
// so a value delivered through any position stays identical to the object it was read from,
// and a structurally equal object built elsewhere does not. Unbuilt today: every cell is a
// parse error until the operator lands.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type P = { x: i32 }
const src: P = { x: 1 }
const none: P | null = null
// @@VALUE@@
src
// @@TYPE@@
P | null
// @@TEST@@
v === src
// @@HIT@@
print("same")
// @@MISS@@
print("other")
// @@WANT@@
same
// @@VALUE2@@
none
// @@TYPE2@@
P | null
// @@PROOF2@@
if v === src { print("same") } else if v === null { print("null") } else { print("other") }
// @@WANT2@@
null
