// `==` over two records whose field pairs widen in opposite directions, the result delivered at
// every position: structural `==` compares field by field, so the pair compares (D16396).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
const __wa: {x: i32, y: i64} = { x: 1, y: 2 }
const __wb: {x: f64, y: i32} = { x: 1.0, y: 2 }
// @@VALUE@@
__wa == __wb
// @@TYPE@@
boolean
// @@TEST@@
v
// @@HIT@@
print(1)
// @@MISS@@
print(0)
// @@WANT@@
1
// @@CELL_unequal@@
// want: false then true
const __c: {x: f64, y: i32} = { x: 1.5, y: 2 }
print(__wa == __c)
print(__wa != __c)
// @@CELL_nested@@
// want: true
const __n: {y: {z: i64}, x: i32} = { y: { z: 3 }, x: 1 }
const __m: {y: {z: i32}, x: f64} = { y: { z: 3 }, x: 1.0 }
print(__n == __m)
// @@CELL_nullable@@
// want: false then true
const __p: {x: i32, y: i64} | null = { x: 1, y: 2 }
const __q: {x: f64, y: i32} | null = null
print(__p == __q)
const __r: {x: f64, y: i32} | null = { x: 1.0, y: 2 }
print(__p == __r)
// @@CELL_parameters@@
// want: true
function __f(a: {x: i32, y: i64}, b: {x: f64, y: i32}) { return a == b }
print(__f({ x: 1, y: 2 }, { x: 1.0, y: 2 }))
