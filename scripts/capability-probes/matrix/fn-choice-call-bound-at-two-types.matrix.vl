// A `const` bound to a call of a function returning one of two generic functions, called at one
// type in the prelude and delivered at another at each position (D10021). The binding runs the
// call once, as the index of the function returned, and selects that function per type.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function idg<T>(t: T): T { return t }
function kg<T>(t: T): T { return t + t }
function app<T>(g: (x: T) => T, v: T): T { return g(v) }
function pick(n: i32) {
  if n > 1 { return kg }
  return idg
}
const h = pick([1, 2].length)
const s = h("x")
// @@VALUE@@
h(1.5)
// @@TYPE@@
f64
// @@PROOF@@
if s == "xx" { print(v * 2.0) } else { print(0.0) }
// @@WANT@@
6
// @@VALUE2@@
app(h, 2)
// @@TYPE2@@
i32
// @@PROOF2@@
print(v * s.length)
// @@WANT2@@
8
