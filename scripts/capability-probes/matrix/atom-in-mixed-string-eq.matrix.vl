// An equality between a literal-union atom and a plain string, delivered to every position: the
// IR builds the string compare, decoding the atom to its member string as legacy's writer does.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type __K = "ab" | "cd"
function __mk(i: i32): __K { return if i > 0 { "cd" } else { "ab" } }
function __s(i: i32): string { return if i > 0 { "cd" } else { "q" } }
// @@SETUP@@
const __k: __K = __mk(1)
const __t = __s(1)
// @@VALUE@@
__k == __t
// @@TYPE@@
boolean
// @@PROOF@@
print(v)
// @@WANT@@
true
// @@TEST@@
v
// @@HIT@@
print("true")
// @@MISS@@
print("no")
