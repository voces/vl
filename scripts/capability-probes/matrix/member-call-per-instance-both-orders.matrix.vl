// A member call on an un-annotated parameter, through a local that only ever holds it or from
// inside a closure, is picked per instance in either order of instances (D2520, D16877): each
// program runs once with its two instances in one order and once reversed.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function slice(self: boolean | string, a: i32, b: i32) {
  if self == true || a > b { return "fn" }
  return "fn"
}
// @@VALUE@@
"hello"
// @@TYPE@@
string
// @@PROOF@@
print(v.slice(0, 2))
// @@WANT@@
he
// @@CELL_adv2_aliasin@@
// want: fn then he
function take(a) {
  const g = () => {
    const v = a
    print(v.slice(0, 2))
  }
  g()
}
take(true)
take("hello")
// @@CELL_adv2_aliasin_rev@@
// want: he then fn
function take(a) {
  const g = () => {
    const v = a
    print(v.slice(0, 2))
  }
  g()
}
take("hello")
take(true)
// @@CELL_adv2_inrecord@@
// want: fn then he
function take(a) {
  const r = { run: () => a.slice(0, 2) }
  print(r.run())
}
take(true)
take("hello")
// @@CELL_adv2_inrecord_rev@@
// want: he then fn
function take(a) {
  const r = { run: () => a.slice(0, 2) }
  print(r.run())
}
take("hello")
take(true)
// @@CELL_adv2_nested2@@
// want: fn then he
function take(a) {
  const g = () => {
    const h = () => { print(a.slice(0, 2)) }
    h()
  }
  g()
}
take(true)
take("hello")
// @@CELL_adv2_nested2_rev@@
// want: he then fn
function take(a) {
  const g = () => {
    const h = () => { print(a.slice(0, 2)) }
    h()
  }
  g()
}
take("hello")
take(true)
// @@CELL_adv2_returned@@
// want: he then fn
function mk(a) { return () => a.slice(0, 2) }
const f1 = mk(true)
const f2 = mk("hello")
print(f2())
print(f1())
// @@CELL_adv2_returned_rev@@
// want: fn then he
function mk(a) { return () => a.slice(0, 2) }
const f1 = mk(true)
const f2 = mk("hello")
print(f1())
print(f2())
// @@CELL_adv2_shadow@@
// want: zz then zz
function take(a) {
  const g = (a: string) => { print(a.slice(0, 2)) }
  g("zz")
}
take(true)
take("hello")
// @@CELL_adv2_shadow_rev@@
// want: zz then zz
