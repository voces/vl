// D2850: a record built by a hole constructor, `mk(a)` returning `{ f: a }`, at a string pin.
// The type parameter is left OPEN: nothing annotates `mk`, so the instance alone names the row.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function mk(a) { return { f: a } }
// @@VALUE@@
mk("ab")
// @@TYPE@@
{ f: string }
// @@TEST@@
v.f == "ab"
// @@HIT@@
print("ok")
// @@MISS@@
print("no")
// @@WANT@@
ok
// @@VALUE2@@
mk(1.5)
// @@TYPE2@@
{ f: f64 }
// @@PROOF2@@
print(v.f * 2.0)
// @@WANT2@@
3
