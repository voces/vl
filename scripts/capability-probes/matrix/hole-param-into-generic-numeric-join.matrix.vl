// D16206: an un-annotated parameter closed at `i32` by its caller, handed beside an `f64` to a
// generic whose two uses of `T` join at `f64`. The value under test is such a call's result,
// delivered to every position; the cells vary the generic, the order, a lambda and two callers.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function mix<T>(a: T, b: T): T[] { [a, b] }
function pick<T>(a: T, b: T): T { return a }
function w2(u, v: f64) { return mix(u, v)[0] / 4.0 }
const one: i32 = 1
// @@VALUE@@
w2(one, 0.5)
// @@TYPE@@
f64
// @@PROOF@@
print(v)
// @@WANT@@
0.25
// @@CELL_pick_first@@
// want: 1
function w3(u, v: f64) { return pick(u, v) }
print(w3(one, 0.5))
// @@CELL_literal_beside@@
// want: 1
function w4(u) { return mix(u, 0.5)[0] }
print(w4(one))
// @@CELL_two_callers@@
// want: 0.75
print(w2(one, 0.5) + w2(2.0, 0.5))
// @@CELL_lambda@@
const w5 = (u, v: f64) => mix(u, v)[0] / 4.0
print(w5(one, 0.5))
// @@CELL_in_loop@@
// want: 3
let acc = 0.0
let i = 0
while i < 4 {
  acc = acc + w2(i, 0.5) * 2.0
  i = i + 1
}
print(acc)
// @@CELL_i64@@
// want: 1
const big: i64 = 5
function w6(u, v: i64) { return pick(u, v) }
print(w6(one, big))
