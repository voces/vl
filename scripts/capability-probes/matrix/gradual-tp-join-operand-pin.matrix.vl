// D2906 — the body applies `+` to a join of a type parameter with a literal (`T | i32`), which
// is gradual: checked against `i32` in the body and against the whole union at the pin. At the
// `i32` pin the union is `i32` and the sum is delivered at every position.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function ga<T>(a: T, c: boolean) {
  const r = if c { a } else { 5 }
  return r + 1
}
// @@VALUE@@
ga(3, false)
// @@TYPE@@
i32
// @@TEST@@
v == 6
// @@HIT@@
print(v * 2)
// @@MISS@@
print("no")
// @@WANT@@
12
