// A fresh nested list literal joined with an `f64[][]` is built at `f64[]` and needs no copy,
// through a spread or as a direct element; the runtime twin is `nested-list-widen-runtime`
// (D4861). The proof divides, so an inner list left in the i32 rep cannot print the answer.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
const nf = [[1.5]]
// @@VALUE@@
[...nf, ...[[1, 2]]]
// @@TYPE@@
f64[][]
// @@PROOF@@
print(v[1][1] / 4.0 + v.length)
// @@WANT@@
2.5
// @@VALUE2@@
[nf[0], [1, 2]]
// @@TYPE2@@
f64[][]
// @@PROOF2@@
print(v[1][1] / 4.0 + v.length)
// @@WANT2@@
2.5
// @@SKIP@@
is_in_if: the value is a list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
