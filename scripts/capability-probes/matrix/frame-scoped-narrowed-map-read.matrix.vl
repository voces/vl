// D1633 at every delivery position: a struct-valued map read, narrowed non-null, then bound
// and captured. The axis is SCOPE — the same program at module scope has run since D1632, and
// inside a function frame the capture's env field took the wrong cell.
//
// A frame's own `let` is in neither the emit-time declared-locals table (loaded only while
// that frame's body is emitted) nor the globals registry, and the env struct is typed in the
// type section, before any frame declares its locals. So the `fn_body_capture` position is
// the witness and `closure_capture` and the three `block_*_capture` rows are its controls.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@SETUP@@
const __mm: { [string]: { name: string, n: i32 } } = Map()
__mm["k"] = { name: "ada", n: 3 }
const __mv = __mm["k"]
// @@GUARD@@
__mv != null
// @@VALUE@@
__mv
// @@TYPE@@
{ name: string, n: i32 }
// @@FALLBACK@@
{ name: "ada", n: 3 }
// @@PROOF@@
const __g = () => v
print(__g().n)
// @@WANT@@
3
// @@TEST@@
v.n == 3
// @@HIT@@
const __h = () => v
print(__h().n)
// @@MISS@@
print(0)
