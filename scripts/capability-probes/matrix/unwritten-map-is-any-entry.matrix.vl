// D16047 (owner ruling (a1)): an unwritten `Map()` joined with `i32` in an inferred return (`{[_]: _} | i32`). An element nothing writes fits every
// `is` of its kind, and a write through a narrowing pins it as a direct write does.
// The annotated face spells the settled type; the vacuous tests are un-annotated cells.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function pick(c: boolean) { if c { return Map() } return 1 }
// @@VALUE@@
pick(true)
// @@TYPE@@
{[string]: i32} | i32
// @@TEST@@
v is {[string]: i32}
// @@HIT@@
print("collection")
// @@MISS@@
print("other")
// @@WANT@@
collection
// @@VALUE2@@
pick(false)
// @@TYPE2@@
{[string]: i32} | i32
// @@PROOF2@@
if v is {[string]: i32} { print("collection") } else { print(v) }
// @@WANT2@@
1
// @@CELL_vacuous_0@@
// want: true
const v = pick(true)
print(v is {[i32]: string})
// @@CELL_vacuous_param_0@@
// want: true
function probe(c: boolean) {
  const v = pick(c)
  print(v is {[i32]: string})
}
probe(true)
// @@CELL_pin@@
// want: 7
const v = pick(true)
if v is {[string]: i32} { v["k"] = 7 }
if v is {[string]: i32} { print(v["k"] ?? 0) } else { print("other") }
