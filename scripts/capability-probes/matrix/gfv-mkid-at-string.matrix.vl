// A generic with no parameters returning a generic lambda, delivered and called at `string`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function mkId<A>(): (x: A) => A { (x: A) => x }
// @@VALUE@@
mkId()
// @@TYPE@@
(x: string) => string
// @@PROOF@@
print(v("s"))
