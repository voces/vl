// A `const` joining two const-bound literals (`const M = if c { A } else { B }`) is held as the
// joined set's atom (`constBindsLitSet`) though the checker types it `string`: every read decodes
// the member picked at run time. `c` is false at run time, so only `B`'s text proves the pick.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
const A = "x"
const B = "yy"
function flip(): boolean { return 1 > 2 }
// @@SETUP@@
const c = flip()
const M = if c { A } else { B }
// @@VALUE@@
M
// @@TYPE@@
string
// @@PROOF@@
print(v)
// @@TEST@@
v == "yy"
// @@HIT@@
print(v)
// @@MISS@@
print("miss")
// @@WANT@@
yy
// @@CELL_compare_member@@
// want: false then true then 2
function f() {
  const c = flip()
  const M = if c { A } else { B }
  print(M == A)
  print(M == "yy")
  print(M.length)
}
f()
// @@CELL_is_set@@
// want: true
function f() {
  const c = flip()
  const M = if c { A } else { B }
  print(M is "yy" | "z")
}
f()
