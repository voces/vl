// D2150 — the generic twin of `inline-litunion-value.matrix.vl`: the inline literal-union value
// passes through a type parameter left open, so the instance binds `T` to the inline set at the
// pin rather than reading an annotation. A template that fixes the type cannot see a pin that
// spells the set as a string ref while the argument arrives as the atom.
//
// NO `type` DECLARATION MAY BE ADDED, for the sibling's reason.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function pick(n: i32): "red" | "green" {
  if n > 0 { return "green" }
  "red"
}
function pass<T>(x: T): T { x }
// @@VALUE@@
pass(pick(1))
// @@TYPE@@
"red" | "green"
// @@TEST@@
v == "green"
// @@HIT@@
print(v)
// @@MISS@@
print("miss")
// @@WANT@@
green
// @@VALUE2@@
pass(pick(0))
// @@TYPE2@@
"red" | "green"
// @@PROOF2@@
print("c=" + v)
// @@WANT2@@
c=red
