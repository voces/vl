// D1518 — a struct (`B`) that is BOTH a union ARM (`B | E`) and the nested-struct FIELD of
// another union's arm (`M`'s `a: B`, with `M | E`), delivered to every position and read back
// THROUGH the nested field.
//
// THE DECLARATION ORDER IS THIS FAMILY'S SECOND FACE, and the matrix's own two faces are
// already spent on annotated / un-annotated — so the order rides a SECOND TEMPLATE,
// `arm-also-nested-field-order-swapped.matrix.vl`, identical but for the `M | E` / `B | E`
// declaration order in @@PRELUDE@@. Two templates × two faces × the position list is the
// full grid; running one alone would grade exactly one of the two sentences this row closed.
//
// THE PROOF READS `v.a.base` AND `v.a.length`, not just `v.n`. The defect is the FIELD's
// storage: `B` had no struct-table row, so a cell that only constructs — or that reads the
// plain `n` beside the nested field — would pass over a module whose `a` slot named the wrong
// heap type. Both leaves are read and summed so a wrong row traps or prints a wrong number.
//
// `g` IS LOAD-BEARING SCENERY. Deleting it leaves `B` a plain struct and every cell runs on
// master; it is what makes `B` an arm and puts it under `collectS`'s skip.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type E = { msg: string }
type B = { base: i32, length: i32 }
type M = { a: B, n: i32 }

function f(ok: boolean): M | E {
  if !ok { return { msg: "f" } }
  return { a: { base: 1, length: 16 }, n: 2 }
}

function g(ok: boolean): B | E {
  if !ok { return { msg: "g" } }
  return { base: 2, length: 8 }
}
// @@VALUE@@
f(true)
// @@TYPE@@
M | E
// @@TEST@@
v is M
// @@HIT@@
print(v.a.base + v.a.length + v.n)
// @@MISS@@
print(0 - 1)
// @@WANT@@
19
// @@FALLBACK@@
f(false)
// @@VALUE2@@
f(true)
// @@TYPE2@@
M | E
// @@PROOF2@@
if v is M { print(v.a.base + v.a.length + v.n) } else { print(0 - 1) }
// @@WANT2@@
19
