// Reference identity (D15975, docs/identity-design.md §0): `===`/`!==` on a function value (table index and captured environment) is one `ref.eq`,
// so a value delivered through any position stays identical to the object it was read from,
// and a structurally equal object built elsewhere does not. Unbuilt today: every cell is a
// parse error until the operator lands.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function mk(n: i32): () => i32 { return () => n }
const src = mk(1)
// @@VALUE@@
src
// @@TYPE@@
() => i32
// @@TEST@@
v === src
// @@HIT@@
print("same")
// @@MISS@@
print("other")
// @@WANT@@
same
// @@VALUE2@@
mk(1)
// @@TYPE2@@
() => i32
// @@PROOF2@@
if v === src { print("same") } else { print("other") }
// @@WANT2@@
other
