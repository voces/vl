// D8260 — a map whose record-or-string value union is spelled only as the constructor's type
// argument: the record stored in it boxes into that union, and `is` reads it back.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type J = { r: i32 }
function filled() {
  const m = Map<string, J | string>()
  m.set("a", { r: 5 })
  m.set("b", "s")
  m
}
// @@VALUE@@
filled()
// @@TYPE@@
Map<string, J | string>
// @@TEST@@
v.get("a") is J
// @@HIT@@
const g = v.get("a")
if g is J { print(g.r) }
// @@MISS@@
print("miss")
// @@WANT@@
5
