// A runtime `i32[][]` copied into an `f64[][]` by a spread or a list `+`: the copy converts
// only its own level, so each inner `i32[]` would have to be copied too and a write through
// it would no longer reach the source. The checker refuses it at every position (D4861).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
const nf = [[1.5]]
const ni = [[1, 2]]
// @@VALUE@@
[...nf, ...ni]
// @@TYPE@@
f64[][]
// @@PROOF@@
print(v[1][1] / 4.0 + v.length)
// @@WANT@@
2.5
// @@VALUE2@@
nf + ni
// @@TYPE2@@
f64[][]
// @@PROOF2@@
print(v[1][1] / 4.0 + v.length)
// @@WANT2@@
2.5
// @@SKIP@@
is_in_if: the value is a list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
