`==` over a list whose element is `f64 | null`, a union box: equal when each pair has one tag
and, for a number, one value; unequal on a null against a number (pick 1, slice C).
// @@PRELUDE@@
function mkEq(): (f64 | null)[] { [1.5, null] }
function mkNe(): (f64 | null)[] { [1.5, 2.5] }
// @@VALUE@@
mkEq()
// @@TYPE@@
(f64 | null)[]
// @@WANT@@
true false true
// @@TEST@@
v == mkEq() && v != mkNe()
// @@HIT@@
print("true false true")
// @@MISS@@
print("miss")
// @@VALUE2@@
mkNe()
// @@TYPE2@@
(f64 | null)[]
// @@PROOF2@@
print("\{v == mkNe()} \{v == mkEq()}")
// @@WANT2@@
true false
