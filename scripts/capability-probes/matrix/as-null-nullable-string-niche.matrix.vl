// D1812 — `x as? T` over a niche-repped `T | null`. `T | null` is what the operand already
// is, so the coalescing form is the identity: the same cell at the same rep, and the cast
// node's own type is the one every consumer reads.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function s1(): string | null { return "ok" }
function s2(): string | null { return "yes" }
// @@VALUE@@
s1() as? string
// @@TYPE@@
string | null
// @@PROOF@@
print(v ?? "none")
// @@WANT@@
ok
// @@VALUE2@@
s2() as? string
// @@TYPE2@@
string | null
// @@PROOF2@@
print(v ?? "none")
// @@WANT2@@
yes
// @@SKIP@@
is_in_if: the discrimination positions want a TEST, and the null test is what `??` already is
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
