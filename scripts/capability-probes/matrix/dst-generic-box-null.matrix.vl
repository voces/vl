// D4024 — a bare `null` argument binds `T` inside a generic record return from the
// destination's field type, so the field takes a record afterwards.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type Item = { n: i32 }
type Box<T> = { v: T }
function box<T>(x: T): Box<T> { { v: x } }
// @@VALUE@@
box(null)
// @@TYPE@@
Box<Item | null>
// @@PROOF@@
const q = v
q.v = { n: 5 }
const e = q.v
if e != null { print(e.n) } else { print("none") }
// @@WANT@@
5
