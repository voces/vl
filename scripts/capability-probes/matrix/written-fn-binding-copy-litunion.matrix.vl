// D4893: a copy of a written function binding is called at one literal union while the generic
// it holds is called directly at another; each instance spells its own union's members. The
// copy's type parameter stays open; the annotated face annotates only the destination.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type __S = "p" | "q"
type __R = "p" | "r"
function __gA<U>(u: U): i32 {
  print(u)
  return 1
}
function __gB<V>(v: V): i32 {
  print(v)
  return 2
}
function __gC<W>(w: W): i32 {
  print(w)
  return 3
}
const __qa: __S = "q"
const __rb: __R = "r"
// @@SETUP@@
let __x = __gA
__x = __gB
let __y = __gC
__y = __x
const __dm = __gB(__rb)
// @@VALUE@@
__y
// @@TYPE@@
(s: __S) => i32
// @@PROOF@@
const __r = v(__qa)
// @@WANT@@
q
