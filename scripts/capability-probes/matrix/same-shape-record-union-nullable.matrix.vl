// The nullable cell of a same-shape record union (D3870): `A | B | null` is `A | null`, a
// nullable record with no box. The proof reads the field behind the `null` test, so every
// delivery checks the cell holds the record and not a tagged box around it.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type A = { x: i32 }
type B = { x: i32 }
function mkB(): B { return { x: 4 } }
// @@VALUE@@
mkB()
// @@TYPE@@
A | B | null
// @@TEST@@
v != null
// @@HIT@@
print(v.x)
// @@MISS@@
print(0)
// @@WANT@@
4
