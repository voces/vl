// D2248 — `a ?? b` where both operands are record-or-null map reads. A nullable default leaves
// the coalesce `V | null`, which the fused get-with-default had only for a `{[K]: V | null}` map;
// over `{[K]: V}` it recovered the result non-null and refused or trapped on the null.
//
// The first instance misses on the left and hits on the right, so the value printed can only
// come from the default.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type Rec = { x: i32, y: i32 }
const recs: {[string]: Rec} = Map()
const more: {[string]: Rec} = Map()
more["k"] = { x: 9, y: 2 }
// @@VALUE@@
recs["k"] ?? more["k"]
// @@TYPE@@
Rec | null
// @@FALLBACK@@
null
// @@TEST@@
v != null
// @@HIT@@
print(v.x)
// @@MISS@@
print("none")
// @@WANT@@
9
// @@VALUE2@@
recs["z"] ?? more["z"]
// @@TYPE2@@
Rec | null
// @@PROOF2@@
if v != null { print(v.x) } else { print("none") }
// @@WANT2@@
none
