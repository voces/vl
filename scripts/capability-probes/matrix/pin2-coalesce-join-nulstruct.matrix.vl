// D1714's third niche. A nullable STRUCT `??` reaches the same `br_on_non_null` core, so a
// default of another type had nowhere to land there either. The struct rides the union box's
// anyref as its own ref, tagged by the arm whose heap type it already has.
//
// The first line is the control: a FITTING struct default still takes the `br_on_non_null`
// shape. The last is the `as?`-operand column, where the niche comes from a cast.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@SKIP@@
map_value: the builder guards its read with `!= null`, and this template's operand is null by
design so the DEFAULT is what each line proves — the guarded body never runs
// @@PRELUDE@@
type A = { r: i32 }
function st(): A { return { r: 8 } }
function mkA(): A | null { return null }
function mkV(): i32 | A { return 4 }
// @@VALUE@@
mkA()
// @@TYPE@@
A | null
// @@PROOF@@
const f = v ?? st()
print(f.r)
const j = v ?? 7
if j is A { print(0) } else { print(j) }
const q = (mkV() as? A) ?? 5
if q is A { print(0) } else { print(q) }
// @@WANT@@
8 then 7 then 5
