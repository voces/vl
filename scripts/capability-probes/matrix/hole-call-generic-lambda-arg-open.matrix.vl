// D6543, the type parameter left open: the hole call's other argument is the caller's own `T`,
// so the declared generic's `T` and the lambda's parameter are bound only per instance.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __app<T, U>(f: (T) => U, v: T): U { f(v) }
function __viaT<T>(a, x: T) { return a((n) => n, x) }
// @@VALUE@@
__viaT(__app, 5)
// @@TYPE@@
i32
// @@PROOF@@
print(v)
// @@WANT@@
5
// @@TEST@@
v == 5
// @@HIT@@
print(v)
// @@MISS@@
print(0)
// @@VALUE2@@
__viaT(__app, "s")
// @@TYPE2@@
string
// @@PROOF2@@
print(v + "!")
// @@WANT2@@
s!
