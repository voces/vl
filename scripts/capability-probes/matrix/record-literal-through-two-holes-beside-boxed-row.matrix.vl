// D8920: a record literal handed to an un-annotated parameter that hands it on to a second one
// whose body reads its field at the literal's own `i32`, while the program declares a record of
// the same field names that stores the field boxed (`J`). Both holes are pinned at the literal's
// row, so `J` must not be taken for it.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type J = { f: i32 | null }
function rd(r) { return r.f + 1 }
function fwd(a) { return rd(a) }
const keepJ: J = { f: null }
const keepF: i32 = keepJ.f ?? 0
// @@VALUE@@
fwd({ f: 4 })
// @@TYPE@@
i32
// @@WANT@@
5
// @@TEST@@
v == 5
// @@HIT@@
print(v + keepF)
// @@MISS@@
print(0)
// @@VALUE2@@
fwd({ f: 8 })
// @@TYPE2@@
i32
// @@PROOF2@@
print(v * 2)
// @@WANT2@@
18
