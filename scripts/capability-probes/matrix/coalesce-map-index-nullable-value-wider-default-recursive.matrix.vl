// @@PRELUDE@@
function __cwU(m: Map<string, i32 | null>, k: string, d: f64, n: i32) {
  if n > 0 { return __cwU(m, k, d, n - 1) }
  return m[k] ?? d
}
const __cwUMap: Map<string, i32 | null> = Map()
__cwUMap.set("k", 5)
__cwUMap.set("n", null)
