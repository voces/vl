// The parameter face of D3073: a function taking a union, delivered as one taking a record the
// union holds. The adapter boxes the argument before the call.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function area(s: Shape): i32 {
  if s is Circle { return s.r * 10 }
  0
}
function area2(s: Shape): i32 {
  if s is Circle { return s.r * 100 }
  0
}
// @@VALUE@@
area
// @@TYPE@@
(c: Circle) => i32
// @@PROOF@@
print(v({ r: 9 }))
// @@WANT@@
90
// @@VALUE2@@
area2
// @@TYPE2@@
(c: Circle) => i32
// @@PROOF2@@
print(v({ r: 9 }))
// @@WANT2@@
900
// @@SKIP@@
is_in_if: the value is a function, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
