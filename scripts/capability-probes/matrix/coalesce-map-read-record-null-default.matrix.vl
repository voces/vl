// D2247 — `m[k] ?? null` over a map whose value is a record. The read is `V | null` (a miss is
// its null) whatever the value type admits, so the coalesce is the read itself; it bound as the
// non-null record, refused its `!= null` as struct equality, and trapped at every delivery that
// recovered it non-null.
//
// The proof prints a FIELD of the hit and a word for the miss, so a lost null and a lost value
// both print something else.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type Rec = { x: i32, y: i32 }
const recs: {[string]: Rec} = Map()
recs["k"] = { x: 7, y: 2 }
// @@VALUE@@
recs["k"] ?? null
// @@TYPE@@
Rec | null
// @@FALLBACK@@
null
// @@TEST@@
v != null
// @@HIT@@
print(v.x)
// @@MISS@@
print("none")
// @@WANT@@
7
// @@VALUE2@@
recs["z"] ?? null
// @@TYPE2@@
Rec | null
// @@PROOF2@@
if v != null { print(v.x) } else { print("none") }
// @@WANT2@@
none
