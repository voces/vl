// D10797's shape: an `if` value whose then-arm is a hole function and whose else-arm has an
// annotated function parameter, delivered and then called with a closed function.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function apply2(g: (a: i32) => i32): i32 { g(2) }
function apply3(g): i32 { g(20) }
function id(a: i32) { return a }
function twice(a: i32) { return a * 2 }
let sel = false
// @@VALUE@@
if sel { apply3 } else { apply2 }
// @@TYPE@@
(g: (a: i32) => i32) => i32
// @@PROOF@@
print(v(id))
// @@WANT@@
2
// @@VALUE2@@
if !sel { apply3 } else { apply2 }
// @@TYPE2@@
(g: (a: i32) => i32) => i32
// @@PROOF2@@
print(v(twice))
// @@WANT2@@
40
