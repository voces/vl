// A generic whose result is a list, nullable or map of functions at its type parameter, bound
// only by the destination.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function gid<A>(x: A): A { x }
function lst<A>(f: (x: A) => A): ((x: A) => A)[] { [f] }
// @@VALUE@@
lst(gid)
// @@TYPE@@
((x: f64) => f64)[]
// @@PROOF@@
print(v[0](1.5))
// @@WANT@@
1.5
// @@CELL_nullable@@
// want: 1.5
function opt<A>(f: (x: A) => A): ((x: A) => A) | null { f }
const k: ((x: f64) => f64) | null = opt(gid)
if k != null { print(k(1.5)) }
// @@CELL_map@@
// want: 1.5
function mp<A>(f: (x: A) => A): {[string]: (x: A) => A} { const m: {[string]: (x: A) => A} = Map(); m["a"] = f; m }
const k: {[string]: (x: f64) => f64} = mp(gid)
const g = k["a"]
if g != null { print(g(1.5)) }
