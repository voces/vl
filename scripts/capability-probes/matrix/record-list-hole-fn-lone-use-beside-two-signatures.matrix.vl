// D15338: a list of records of an un-annotated function, delivered at every position and read
// once at `f64`, beside another list of the same function called at two signatures through a
// variable index. The set is tagged, and the delivered list holds closures at its one use.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __id(a) { return a }
const __xs = [{ f: __id }]
function __twoSigs(k: i32): f64 {
  const n: i32 = __xs[k].f(2)
  n + __xs[k].f(2.5)
}
// @@VALUE@@
[{ f: __id }]
// @@TYPE@@
{ f: (a: f64) => f64 }[]
// @@PROOF@@
print(__twoSigs(0) + v[0].f(2.5))
// @@WANT@@
7
