// D16043 (owner ruling, DECISIONS "A sub-word field of a `flat` record has storage semantics"):
// a `u8[]` list stores each element at its width, keeping the low bits of a computed value, and
// an element read widens back to `i32`. The value under test is a list whose second element is
// the computed 300, which reads back as 44. The cells add the store and read spellings, the
// out-of-range literal and a bare `u8` binding, both refusals the design owes.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type R = { f: u8[] }
function k(n: i32) { n }
function mk(n: i32): u8[] {
  const xs: u8[] = [1]
  xs.push(n)
  return xs
}
function collect(...xs: u8[]): u8[] { return xs }
// @@VALUE@@
mk(k(300))
// @@TYPE@@
u8[]
// @@WANT@@
44
// @@TEST@@
v.length == 2
// @@HIT@@
print(v[1])
// @@MISS@@
print("miss")
// @@VALUE2@@
mk(k(511))
// @@TYPE2@@
u8[]
// @@PROOF2@@
print(v[1])
// @@WANT2@@
255
// @@CELL_literal_in_range@@
// want: 200
const xs: u8[] = [1, 200]
print(xs[1])
// @@CELL_computed_in_literal@@
const xs: u8[] = [1, k(300)]
print(xs[1])
// @@CELL_push@@
const xs__A__ = __V__
xs.push(k(300))
print(xs[2])
// @@CELL_index_assign@@
const xs__A__ = __V__
xs[0] = k(300)
print(xs[0])
// @@CELL_read_arith@@
// want: 45
const xs__A__ = __V__
print(xs[1] + 1)
// @@CELL_for_of@@
// want: 45
let s = 0
for x in __V__ {
  s = s + x
}
print(s)
// @@CELL_nested@@
const ys: u8[][] = [__V__]
print(ys[0][1])
// @@CELL_nullable@@
const n: u8[] | null = __V__
if n != null { print(n[1]) } else { print("null") }
// @@CELL_map_value_read@@
const m: {[string]: u8[]} = Map()
m["k"] = __V__
const r = m["k"]
if r != null { print(r[1]) } else { print("null") }
// @@CELL_record_field@@
const r: R = { f: __V__ }
print(r.f[1])
// @@CELL_spread_rest_args@@
print(collect(1, k(300))[1])
// @@CELL_spread_rest_list@@
const c = collect(...__V__)
print(c[1])
// @@CELL_get@@
const g = __V__.get(1)
print(g ?? 0)
// @@CELL_empty_push@@
const e: u8[] = []
e.push(k(300))
print(e[0])
// @@CELL_literal_out_of_range@@
// owed: does not fit
const xs: u8[] = [1, 300]
print(xs[1])
// @@CELL_bare_binding@@
// owed: storage type
const x: u8 = 3
print(x)
