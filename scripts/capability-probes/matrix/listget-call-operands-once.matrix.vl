// D1677 — `xs.get(i)` emits its index and its receiver TWICE, for the bounds compare and
// again for the element read, so both were gated to a literal or a name and a call at either
// was refused. Both are now staged once in the frame's `.get` stash.
//
// `mark0()` runs once per delivery and each operand once per EVALUATION, so the proof
// `calls == marks * 2` (a receiver call plus an index call) is insensitive to how many times
// a position delivers — the `*_assign` positions deliver twice.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type S = { w: i32 }
let calls = 0
let marks = 0
const base: S[] = [{ w: 3 }]
function mark0(): i32 {
  marks = marks + 1
  0
}
function ix(): i32 {
  calls = calls + 1
  0
}
function recv(): S[] {
  calls = calls + 1
  base
}
// @@VALUE@@
(recv().get(ix())?.w ?? 0) + mark0()
// @@TYPE@@
i32
// @@FALLBACK@@
0
// @@TEST@@
v == 3
// @@HIT@@
print(calls == marks * 2)
// @@MISS@@
print(0)
// @@WANT@@
true
