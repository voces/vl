// D1667 — a `?.` whose receiver is a call through a function VALUE. `emitOptChainIsNull`
// lowers the receiver like any other expression, so the `call_ref` it emits needs the
// closure scratch slot — and `blockHasCallRef`, the pre-pass that reserves it, walked a `.`
// receiver and not a `?.` one, so the body read a local the vector never declared.
//
// The position axis is the frame axis here: each delivery lands in a different function, and
// the slot is reserved per frame. `SETUP` binds the function value in that same frame.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type B = { y: i32 }
function mkB(): B | null { { y: 7 } }
// @@SETUP@@
const g = mkB
// @@VALUE@@
g()?.y == null
// @@TYPE@@
boolean
// @@FALLBACK@@
true
// @@TEST@@
v == false
// @@HIT@@
print(false)
// @@MISS@@
print(true)
// @@WANT@@
false
