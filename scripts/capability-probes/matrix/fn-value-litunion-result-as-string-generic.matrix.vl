// D4351's generic twin: the callee's literal-union result is a type parameter's binding,
// pinned at `K` by the destination's parameter, so the adapter converts an instance's result.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type K = "x" | "y"
function same<T>(k: T): T { k }
function same2<T>(k: T): T { k }
// @@VALUE@@
same
// @@TYPE@@
(k: K) => string
// @@PROOF@@
print(v("x") + "!")
// @@WANT@@
x!
// @@VALUE2@@
same2
// @@TYPE2@@
(k: K) => string
// @@PROOF2@@
print(v("y") + "?")
// @@WANT2@@
y?
// @@SKIP@@
is_in_if: the value is a function, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
