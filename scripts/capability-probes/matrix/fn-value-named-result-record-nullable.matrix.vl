// D9781: a named function returning a declared record, delivered where a function returning
// `R | null` is expected. Every position must hand the call an adapter that widens the result.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type R = {x: i32, y: string}
function n(x: i32): R { return { x: x, y: "p" } }
function m(x: i32): R { return { x: x * 3, y: "q" } }
// @@VALUE@@
n
// @@TYPE@@
(x: i32) => R | null
// @@PROOF@@
const r = v(5)
if r != null { print(r.x + r.y.length) } else { print(0) }
// @@WANT@@
6
// @@VALUE2@@
m
// @@TYPE2@@
(x: i32) => R | null
// @@PROOF2@@
const r2 = v(5)
if r2 != null { print(r2.x + r2.y.length) } else { print(0) }
// @@WANT2@@
16
