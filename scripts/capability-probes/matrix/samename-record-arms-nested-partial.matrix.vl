// D4267 — `C`'s field `v` is a record whose own field fits `A`'s only for some values, so
// `is A` over a `C` value reads the nested record's box tag.
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type A = { v: { x: i32 } }
type C = { v: { x: i32 | string } }
function pick(a: boolean): A | C {
  if a {
    const c: C = { v: { x: 1 } }
    return c
  }
  const s: C = { v: { x: "s" } }
  return s
}
// @@SETUP@@
const cval: C = { v: { x: 7 } }
// @@VALUE@@
cval
// @@TYPE@@
A | C
// @@TEST@@
v is A
// @@HIT@@
print("A")
// @@MISS@@
print("C")
// @@WANT@@
A
// @@VALUE2@@
pick(false)
// @@TYPE2@@
A | C
// @@PROOF2@@
if v is A { print("A") } else { print("C") }
// @@WANT2@@
C
