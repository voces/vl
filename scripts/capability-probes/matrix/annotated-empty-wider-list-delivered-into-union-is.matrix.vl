// An empty list whose annotation fixes a wider element type, delivered into a union beside a
// narrower list arm at every position: `is` of the narrower arm is false though the list is
// empty, since its element type is fixed (the D16047 refinement).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
const __e: (i32 | string)[] = []
// @@VALUE@@
__e
// @@TYPE@@
(i32 | string)[] | i32[]
// @@TEST@@
v is i32[]
// @@HIT@@
print(0)
// @@MISS@@
print(42)
// @@WANT@@
42
