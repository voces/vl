// D10292's open twin: the generic's result is un-annotated and its map is built by a function
// whose hole parameter pins the value at `f64`, so neither the binding nor the pin is spelled.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __bo<V>(m: Map<string, V>, k: string) {
  const x = m.get(k)
  x
}
function __boMk(p) {
  const m: Map<string, f64> = Map()
  m.set("k", p)
  m
}
const __boM = __boMk(1.5)
// @@VALUE@@
__bo(__boM, "z")
// @@TYPE@@
f64 | null
// @@TEST@@
v == null
// @@HIT@@
print(__bo(__boM, "k") ?? 0.0)
// @@MISS@@
print("wrong")
// @@WANT@@
1.5
// @@VALUE2@@
__bo(__boM, "k")
// @@TYPE2@@
f64 | null
// @@PROOF2@@
print(v ?? 0.0)
// @@WANT2@@
1.5
