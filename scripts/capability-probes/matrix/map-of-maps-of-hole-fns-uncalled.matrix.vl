// D16121: `map-of-maps-of-hole-fns.matrix.vl` with no call through the inner map. The value
// under test is a map of an un-annotated function nothing calls but a read back through the
// outer map, so that read is the only call that instances the function.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function half(a) { return a / 2.0 }
const m4 = Map()
m4.set("a", half)
// @@VALUE@@
m4
// @@TYPE@@
{ [string]: (a: f64) => f64 }
// @@PROOF@@
const h = v.get("a")
if h != null { print(h(5.0)) }
// @@WANT@@
2.5
// @@CELL_outer_set@@
const mm = Map()
mm.set("k", __V__)
const f = mm.get("k")
if f != null {
  const h = f.get("a")
  if h != null { print(h(5.0)) }
}
// @@CELL_outer_index@@
const mm = Map()
mm["k"] = __V__
const f = mm["k"]
if f != null {
  const h = f["a"]
  if h != null { print(h(5.0)) }
}
// @@CELL_outer_size@@
// want: 1
const mm = Map()
mm.set("k", __V__)
const f = mm.get("k")
if f != null { print(f.length) }
// @@CELL_three_deep@@
const mm = Map()
mm.set("k", __V__)
const m3 = Map()
m3.set("z", mm)
const f2 = m3.get("z")
if f2 != null {
  const f = f2.get("k")
  if f != null {
    const h = f.get("a")
    if h != null { print(h(5.0)) }
  }
}
// @@CELL_outer_in_record@@
const mm = Map()
mm.set("k", __V__)
const r = { h: mm }
const f = r.h.get("k")
if f != null {
  const h = f.get("a")
  if h != null { print(h(5.0)) }
}
// @@CELL_outer_in_list@@
const mm = Map()
mm.set("k", __V__)
const xs = [mm]
const f = xs[0].get("k")
if f != null {
  const h = f.get("a")
  if h != null { print(h(5.0)) }
}
