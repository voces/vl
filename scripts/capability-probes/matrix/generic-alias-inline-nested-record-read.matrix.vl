// D10882: a generic alias whose field is an inline nested record (`B<U> = { s: { g: U } }`),
// delivered from every position to a generic that reads `v.s.g` in its own body, at an `i32`
// pin and (second instance) a `string` one.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type B<U> = { s: { g: U } }
function __get<T>(v: B<T>): T { v.s.g }
// @@VALUE@@
{ s: { g: 3 } }
// @@TYPE@@
B<i32>
// @@PROOF@@
print(__get(v) * 10)
// @@WANT@@
30
// @@VALUE2@@
{ s: { g: "x" } }
// @@TYPE2@@
B<string>
// @@PROOF2@@
print(__get(v))
// @@WANT2@@
x
// @@SKIP@@
is_in_if: the value is a record, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
