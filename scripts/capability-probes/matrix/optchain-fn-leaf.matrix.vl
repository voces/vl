// A standalone `?.` whose leaf field is a function value (D16036): `b?.f` over `b: B | null` is
// `(() => i32) | null`, the closure fat pointer's own nullable ref. The proof calls the function, so
// a delivery that loses the closure, or its captured environment, prints otherwise.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type B = { f: () => i32 }
function mk(k: i32): B | null {
  if k < 0 { return null }
  return { f: () => k + 1 }
}
const b = mk(6)
const none = mk(-1)
// @@VALUE@@
b?.f
// @@TYPE@@
(() => i32) | null
// @@TEST@@
v != null
// @@HIT@@
print(v())
// @@MISS@@
print("null")
// @@WANT@@
7
// @@VALUE2@@
none?.f
// @@TYPE2@@
(() => i32) | null
// @@PROOF2@@
if v != null { print(v()) } else { print("null") }
// @@WANT2@@
null
