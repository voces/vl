// D16897 — a union of lists read through `.length`, an element and a `for`, where the receiver
// reaches the read through a hole (an un-annotated parameter or binding): the list-union rewrite
// lowers the annotated face, and a pin's re-check must lower the un-annotated one.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function mk(k: i32): i32[][] | f64[][] {
  if k == 0 {
    const b: f64[][] = [[1.5]]
    return b
  }
  const a: i32[][] = [[1, 7], [2]]
  return a
}
// @@VALUE@@
mk(1)
// @@TYPE@@
i32[][] | f64[][]
// @@PROOF@@
print(v.length)
// @@WANT@@
2
// @@VALUE2@@
mk(0)
// @@TYPE2@@
i32[][] | f64[][]
// @@PROOF2@@
print(v[0].length)
// @@WANT2@@
1
// @@CELL_hole_param_length@@
function take(a__A__) { print(a.length) }
take(__V__)
// @@CELL_hole_param_element@@
// want: 2
function take(a__A__) { print(a[0].length) }
take(__V__)
// @@CELL_hole_param_for@@
// want: 3
function take(a__A__) {
  let n = 0
  for e in a { n = n + e.length }
  print(n)
}
take(__V__)
// @@CELL_hole_param_narrowed@@
function mkS(k: i32): i32[][] | f64[][] | string {
  if k == 0 { return "s" }
  const a: i32[][] = [[1, 7], [2]]
  return a
}
function take(a) {
  if a is string { print(0) } else { print(a.length) }
}
take(mkS(1))
// @@CELL_hole_lambda_length@@
const take = (a__A__) => a.length
print(take(__V__))
// @@CELL_hole_two_instances@@
// want: 2 then 3
function take(a) { print(a.length) }
take(__V__)
const plain: i32[] = [1, 2, 3]
take(plain)
