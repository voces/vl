// A list of an un-annotated function, delivered at every position, held as a record's field
// whose binding is then written a whole record with a list literal of another function, called
// at two types (D15392). The written literal is built at the binding's record.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __idA(a) { return a + 1 }
function __idB(a) { return a * 10 }
// @@VALUE@@
[__idA]
// @@TYPE@@
((a: f64) => f64)[]
// @@PROOF@@
let __r = { f: v }
const __w0 = __r.f[0](1)
__r = { f: [__idB] }
print("\{__w0},\{__r.f[0](2)},\{__r.f[0](2.5)}")
// @@WANT@@
2,20,25
// @@SKIP@@
is_in_if: the value is a list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
