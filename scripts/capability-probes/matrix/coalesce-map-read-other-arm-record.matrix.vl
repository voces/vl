// D4643 — `m[k] ?? d` over a record-valued map, where `d` is ANOTHER arm of the union the `??`
// is typed as. The fused read-with-default built `d` at the map's value type, so the literal
// was asked for the wrong arm's fields and refused.
//
// The first instance hits and the second misses, so each arm of the result is proved.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type R = { q: i32 }
type S = { r: i32 }
type U = R | S
const recs: Map<string, R> = Map()
recs["k"] = { q: 4 }
// @@VALUE@@
recs["k"] ?? { r: 1 }
// @@TYPE@@
U
// @@FALLBACK@@
{ r: 0 }
// @@TEST@@
v is R
// @@HIT@@
print(v.q)
// @@MISS@@
print("other")
// @@WANT@@
4
// @@VALUE2@@
recs["z"] ?? { r: 1 }
// @@TYPE2@@
U
// @@PROOF2@@
if v is S { print(v.r) } else { print("hit") }
// @@WANT2@@
1
