// A generic's `V[]` result over an un-annotated `[]` binding, delivered at every position: the
// result shares the binding's element, so it reads as the unbound default's empty list when
// nothing writes either, and as the written element when one does (D16782).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __gl<V>(v: V[]): V[] { return v }
const __e = []
// @@VALUE@@
__gl(__e)
// @@TYPE@@
i32[]
// @@TEST@@
v.length == 0
// @@HIT@@
print(0)
// @@MISS@@
print(1)
// @@WANT@@
0
// @@CELL_written_after@@
// want: 1 then 2.5
const __w = []
const __h = __gl(__w)
__w.push(2.5)
print(__h.length)
print(__h[0])
// @@CELL_written_through_result@@
// want: 1 then s
const __s = []
const __t = __gl(__s)
__t.push("s")
print(__s.length)
print(__s[0])
// @@CELL_in_function_body@@
// want: 4
function __m() {
  const __l = []
  const __r = __gl(__l)
  __r.push(3)
  print(__l[0] + 1)
}
__m()
