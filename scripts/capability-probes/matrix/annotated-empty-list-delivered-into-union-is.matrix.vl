// An empty list whose annotation fixes its element type, delivered into a union of two list
// types at every position: `is` answers by the arm it was delivered as, so the other arm's
// test is false though the list is empty (owner ruling 2026-11-15, refining D16047).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
const __m: i32[] = []
// @@VALUE@@
__m
// @@TYPE@@
i32[] | f64[]
// @@TEST@@
v is f64[]
// @@HIT@@
print(0)
// @@MISS@@
print(42)
// @@WANT@@
42
