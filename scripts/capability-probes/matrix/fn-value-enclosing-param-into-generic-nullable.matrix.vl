// A generic's own `() => x` handed to a generic's `() => T | null` parameter, at a pin where the
// enclosing type parameter is `null` (so the result is `null` alone) and at one where it is not.
// D10271.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function len<T>(f: () => T | null) {
  const t = f()
  if t == null { 7 } else { 99 }
}
function outer<U>(x: U): i32 { len(() => x) }
// @@VALUE@@
null
// @@TYPE@@
null
// @@PROOF@@
print(outer(v))
// @@WANT@@
7
// @@VALUE2@@
5
// @@TYPE2@@
i32
// @@PROOF2@@
print(outer(v))
// @@WANT2@@
99
