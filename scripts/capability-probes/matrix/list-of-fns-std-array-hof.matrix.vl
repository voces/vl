// D9860 — a list of functions handed to std:array's generic higher-order functions. The
// instance's `T[]` is pinned at a function type, so its list name must group the element:
// bare, `(i32)=>i32[]` is a function returning a list and names no list row.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
import { reduce, mapIndexed, retain } from "std:array"
function inc(a: i32): i32 { a + 1 }
function dbl(a: i32): i32 { a * 2 }
// @@VALUE@@
[inc, dbl]
// @@TYPE@@
((a: i32) => i32)[]
// @@FALLBACK@@
[dbl]
// @@PROOF@@
const s = v.reduce((t: i32, r: (a: i32) => i32): i32 => t + r(5), 100)
const o = v.mapIndexed((r: (a: i32) => i32, i: i32): i32 => r(5) * 10 + i)
v.retain((r: (a: i32) => i32): boolean => r(5) > 6)
print(s * 1000 + o[0] + o[1] + v.length * 100 + v[0](1))
// @@WANT@@
116263
