// D16162: a record nesting a record of an un-annotated function nothing calls. The value under
// test is such a record, delivered to every position and read for its plain field only, so no
// call instances the function. The cells store it into an un-annotated map by index and by `set`,
// wrap it in a list, nest it a level deeper, hold two functions, give it a sibling function, hold
// the map in a record field, and store it through a binding.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
// @@VALUE@@
{ r: { f: inc0 }, n: 1 }
// @@TYPE@@
{ r: { f: (a: i32) => i32 }, n: i32 }
// @@PROOF@@
print(v.n)
// @@WANT@@
1
// @@CELL_map_index_read@@
const m = Map()
m["k"] = __V__
const w = m["k"]
if w != null { print(w.n) }
// @@CELL_map_set_get@@
const m = Map()
m.set("k", __V__)
const w = m.get("k")
if w != null { print(w.n) }
// @@CELL_map_list_value@@
const m = Map()
m["k"] = [__V__]
const w = m["k"]
if w != null { print(w[0].n) }
// @@CELL_map_three_deep@@
// want: 2
const m = Map()
m["k"] = { o: __V__, n: 2 }
const w = m["k"]
if w != null { print(w.n) }
// @@CELL_map_two_fns@@
// want: 2
const m = Map()
m["a"] = __V__
m["b"] = { r: { f: dbl }, n: 1 }
print(m.length)
// @@CELL_map_sibling_fn@@
const m = Map()
m["k"] = { g: dbl, r: { f: inc0 }, n: 1 }
const w = m["k"]
if w != null { print(w.n) }
// @@CELL_map_has@@
// want: true
const m = Map()
m["k"] = __V__
print(m.has("k"))
// @@CELL_map_in_record_field@@
const o = { m: Map() }
o.m["k"] = __V__
const w = o.m["k"]
if w != null { print(w.n) }
// @@CELL_bound_into_map@@
const m = Map()
const b = __V__
m["k"] = b
const w = m["k"]
if w != null { print(w.n) }
