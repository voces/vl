// An un-annotated lambda returned by an un-annotated function, the value under test being the
// call `deliver()`, delivered at `(a: i32) => f64`: the lambda's `i32` result converts to `f64`
// wherever the relayed value lands, so `v(3) / 8.0` prints `0.5` (D16711). The second value is a
// second such maker.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function deliver() { return (a) => a + 1 }
function deliver2() { return (a) => a * 2 }
// @@VALUE@@
deliver()
// @@TYPE@@
(a: i32) => f64
// @@PROOF@@
print(v(3) / 8.0)
// @@WANT@@
0.5
// @@VALUE2@@
deliver2()
// @@TYPE2@@
(a: i32) => f64
// @@PROOF2@@
print(v(3) / 12.0)
// @@WANT2@@
0.5
