// The generic twin of `same-shape-record-union`: the union is `T | B` with the type
// parameter left open, bound to `A` at the call, so the twin collapse happens at the instance
// rather than at an annotation. A value built as an `A` still passes `v is B`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type A = { x: i32 }
type B = { x: i32 }
function mkA(): A { return { x: 3 } }
function orB<T>(v: T): T | B { return v }
// @@VALUE@@
orB(mkA())
// @@TYPE@@
A | B
// @@TEST@@
v is B
// @@HIT@@
print(v.x)
// @@MISS@@
print(0)
// @@WANT@@
3
