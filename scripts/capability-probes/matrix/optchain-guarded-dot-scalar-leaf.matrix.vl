// A5 / D1815 — one `?.` guards the WHOLE chain to its right, so `o?.y.z` reads as
// `o == null ? null : o.y.z` and the plain `.z` is a second guarded link rather than a member
// access on `Leaf | null`. The result carries the `| null` once, at the chain's end.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type Leaf = { z: i32 }
type Inner = { y: Leaf }
function mkI(c: boolean): Inner | null {
  if c { return { y: { z: 42 } } }
  return null
}
const o = mkI(true)
// @@VALUE@@
o?.y.z
// @@TYPE@@
i32 | null
// @@FALLBACK@@
null
// @@PROOF@@
print(v ?? 0)
// @@WANT@@
42
