// D15127: an inferred function's result that is a read of a list whose records are built at a
// wider record J, delivered at its own type.
// @@PRELUDE@@
type J = { f: i32 | null }
function mk() { { f: 4 } }
const wideJ: J = mk()
const jxs = [mk()]
function first() { return jxs[0] }
// @@VALUE@@
first()
// @@TYPE@@
{ f: i32 }
// @@WANT@@
4
// @@PROOF@@
print(v.f)
// @@TEST@@
v.f == 4
// @@HIT@@
print(4)
// @@MISS@@
print(0)
