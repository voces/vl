// D1691 — the third element kind the code-28 ladder held an empty arm for, and the one its
// own comment said folds elsewhere: `(A | null)[] | null`, a nullable ref list whose ELEMENT
// is itself a niche. It shares one wrapper with `A[]`, so it codes 28 like the others, and it
// is kept apart from them in the source because `(K | null)[]` is the i32 ATOM backing
// instead — only the inner kind tells those two apart, which this template and its litunion
// neighbour in the axis grid are what check.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type A = { r: i32 }
function plain(): (A | null)[] { return [{ r: 9 }] }
function nul1(): (A | null)[] | null { return [{ r: 4 }] }
function nul2(): (A | null)[] | null { return [{ r: 5 }] }
function firstHolder() {
  const first = { xs: plain() }
  const e = first.xs[0]
  if e != null { print(e.r) } else { print(0) }
}
// @@VALUE@@
{ xs: nul1() }
// @@TYPE@@
{ xs: (A | null)[] | null }
// @@PROOF@@
const l = v.xs
if l != null {
  const e = l[0]
  if e != null { print(e.r) } else { print(0) }
} else { print(0) }
// @@WANT@@
4
// @@VALUE2@@
{ xs: nul2() }
// @@TYPE2@@
{ xs: (A | null)[] | null }
// @@PROOF2@@
const l2 = v.xs
if l2 != null {
  const e2 = l2[0]
  if e2 != null { print(e2.r) } else { print(0) }
} else { print(0) }
// @@WANT2@@
5
// @@SKIP@@
is_in_if: the value is a struct, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
