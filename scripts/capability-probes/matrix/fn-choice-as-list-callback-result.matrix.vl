// An `if` choosing between two functions, inline as a `.map` callback (D9072) or handed to a
// generic higher-order parameter (D9005). The choice is built as a closure value of its own
// type, each generic arm instanced at the element or argument type that pins it.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function idg<T>(t: T): T { return t }
function kg<T>(t: T): T { return t + t }
function app<T>(g: (x: T) => T, v: T): T { return g(v) }
const on = [1].length > 5
// @@VALUE@@
[1.5].map(if on { idg } else { kg })
// @@TYPE@@
f64[]
// @@PROOF@@
print(v[0] * 2.0)
// @@WANT@@
6
// @@VALUE2@@
app(if on { idg } else { kg }, 1.25)
// @@TYPE2@@
f64
// @@PROOF2@@
print(v * 2.0)
// @@WANT2@@
5
