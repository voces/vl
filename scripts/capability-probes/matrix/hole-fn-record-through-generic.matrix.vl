// D16739: un-annotated functions held as record fields, handed through a generic identity and read
// by field off the binding of its result, delivered at every position: the read resolves to its
// one function through the call, which instances it at the call's arguments.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __hinc(a) { return a + 1 }
function __hhalf(a) { return a / 2.0 }
function __hid(x) { return x }
const __hr = __hid({ f: __hinc, g: __hhalf })
// @@VALUE@@
__hr.f(3)
// @@TYPE@@
i32
// @@TEST@@
v == 4
// @@HIT@@
print(1)
// @@MISS@@
print(0)
// @@WANT@@
1
// @@CELL_record_other_field@@
// want: 1.5
print(__hr.g(3))
