// A record whose function field holds un-annotated functions returning different types, joined
// by an `if` (D15801): a call through the field runs the member stored there, its result the join
// of theirs. The first arm holds `half` and the arm taken at run time `inc0`, the order in which a
// closure built at the first arm's signature traps. Cells: the field bound, written, read through
// `?.`, captured, a record returned by a call, and one nested in another.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function two() { [1, 2].length }
// @@VALUE@@
if two() > 5 { { f: half } } else { { f: inc0 } }
// @@TYPE@@
{ f: (a: i32) => f64 }
// @@PROOF@@
print(v.f(3) + v.f(4))
// @@WANT@@
9
// @@CELL_bound_field@@
const r__A__ = __V__
const g = r.f
print(g(3) + g(4))
// @@CELL_field_written@@
const r = { f: half }
if two() > 1 { r.f = inc0 }
print(r.f(3) + r.f(4))
// @@CELL_opt_call@@
const r__A__ = __V__
print((r?.f(3) ?? 0.0) + (r?.f(4) ?? 0.0))
// @@CELL_captured@@
const r__A__ = __V__
function go() { return r.f(3) + r.f(4) }
print(go())
// @@CELL_returned@@
function pick(b: boolean) { if b { return { f: half } } return { f: inc0 } }
const r = pick(two() > 5)
print(r.f(3) + r.f(4))
// @@CELL_nested@@
const o = if two() > 5 { { a: { f: half } } } else { { a: { f: inc0 } } }
print(o.a.f(3) + o.a.f(4))
