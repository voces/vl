// A record whose function field holds un-annotated functions returning different types, joined
// by an `if` (D15801): a call through the field runs the member stored there, its result the join
// of theirs. The first arm holds `half` and the arm taken at run time `inc0`, the order in which a
// closure built at the first arm's signature traps. Cells: the field bound, written, read through
// `?.`, captured, a record returned by a call (bound, at three returns, with two fields), one
// nested in records or in a list's element (D15805), and the join handed inline to a parameter
// at each arm (D15807, refused).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function two() { [1, 2].length }
// @@VALUE@@
if two() > 5 { { f: half } } else { { f: inc0 } }
// @@TYPE@@
{ f: (a: i32) => f64 }
// @@PROOF@@
print(v.f(3) + v.f(4))
// @@WANT@@
9
// @@CELL_bound_field@@
const r__A__ = __V__
const g = r.f
print(g(3) + g(4))
// @@CELL_field_written@@
const r = { f: half }
if two() > 1 { r.f = inc0 }
print(r.f(3) + r.f(4))
// @@CELL_opt_call@@
const r__A__ = __V__
print((r?.f(3) ?? 0.0) + (r?.f(4) ?? 0.0))
// @@CELL_captured@@
const r__A__ = __V__
function go() { return r.f(3) + r.f(4) }
print(go())
// @@CELL_returned@@
function pick(b: boolean) { if b { return { f: half } } return { f: inc0 } }
const r = pick(two() > 5)
print(r.f(3) + r.f(4))
// @@CELL_returned_direct@@
function pick(b: boolean) { if b { return { f: half } } return { f: inc0 } }
print(pick(two() > 5).f(3) + pick(two() > 5).f(4))
// @@CELL_returned_three@@
// want: 11.5
function dbl(a) { return a * 2 }
function pick3(n: i32) { if n > 5 { return { f: half } } if n > 1 { return { f: inc0 } } return { f: dbl } }
print(pick3(two()).f(3) + pick3(0).f(3) + pick3(9).f(3))
// @@CELL_returned_two_fields@@
// want: 5.5
function mk2(b: boolean) { if b { return { f: half, g: inc0 } } return { f: inc0, g: half } }
const r = mk2(two() > 5)
print(r.f(3) + r.g(3))
// @@CELL_nested@@
const o = if two() > 5 { { a: { f: half } } } else { { a: { f: inc0 } } }
print(o.a.f(3) + o.a.f(4))
// @@CELL_nested_deep@@
const o = if two() > 5 { { a: { b: { f: half } } } } else { { a: { b: { f: inc0 } } } }
print(o.a.b.f(3) + o.a.b.f(4))
// @@CELL_nested_returned@@
function mk(b: boolean) { if b { return { a: { f: half } } } return { a: { f: inc0 } } }
print(mk(two() > 5).a.f(3) + mk(two() > 5).a.f(4))
// @@CELL_nested_in_list@@
function pick(b: boolean) { if b { return [{ r: { f: half } }] } return [{ r: { f: inc0 } }] }
print(pick(two() > 5)[0].r.f(3) + pick(two() > 5)[0].r.f(4))
// @@CELL_arg_second_arm@@
function take(r) { return r.f(3) + r.f(4) }
print(take(if two() > 5 { { f: half } } else { { f: inc0 } }))
// @@CELL_arg_first_arm@@
// want: 3.5
function take(r) { return r.f(3) + r.f(4) }
print(take(if two() > 1 { { f: half } } else { { f: inc0 } }))
// @@CELL_arg_chain_second@@
function dbl(a) { return a * 2 }
function take(r) { return r.f(3) + r.f(4) }
print(take(if two() > 5 { { f: half } } else if two() > 1 { { f: inc0 } } else { { f: dbl } }))
// @@CELL_arg_chain_third@@
// want: 14
function dbl(a) { return a * 2 }
function take(r) { return r.f(3) + r.f(4) }
print(take(if two() > 5 { { f: half } } else if two() > 4 { { f: inc0 } } else { { f: dbl } }))
// @@CELL_arg_second_param@@
function take2(n, r) { return r.f(n) + r.f(4) }
print(take2(3, if two() > 5 { { f: half } } else { { f: inc0 } }))
// @@CELL_arg_in_expr@@
// want: 10
function take(r) { return r.f(3) + r.f(4) }
print(1 + take(if two() > 5 { { f: half } } else { { f: inc0 } }))
