// A `filter` or `slice` result of a list a kept maker's build stores at a wider record `J`, delivered
// at every position, annotated at the element type `{ f: null }[]` or not. The result holds the
// receiver's own elements, so it is delivered as the receiver itself is (D16763).
// @@PRELUDE@@
type J = { f: i32 | null }
function mk2() { return { f: null } }
const dA: J = mk2()
const src = [mk2()]
// @@VALUE@@
src.filter((y) => y.f == null)
// @@TYPE@@
{ f: null }[]
// @@PROOF@@
print(v[0].f)
// @@WANT@@
null
// @@CELL_receiver_itself@@
// want: null
const v__A__ = src
