// Reference identity (D15975, docs/identity-design.md §0): `===`/`!==` on a record is one `ref.eq`,
// so a value delivered through any position stays identical to the object it was read from,
// and a structurally equal object built elsewhere does not. Unbuilt today: every cell is a
// parse error until the operator lands.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type P = { x: i32 }
const src: P = { x: 1 }
function mkTwin(): P { return { x: 1 } }
// @@VALUE@@
src
// @@TYPE@@
P
// @@TEST@@
v === src
// @@HIT@@
print("same")
// @@MISS@@
print("other")
// @@WANT@@
same
// @@VALUE2@@
mkTwin()
// @@TYPE2@@
P
// @@PROOF2@@
if v === src { print("same") } else { print("other") }
// @@WANT2@@
other
