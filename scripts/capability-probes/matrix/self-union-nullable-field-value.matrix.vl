// D4615 — the nullable of a self-referential union, delivered as `Node | null`: the type a
// `Node` arm's own `next` field carries. The value is a chain built ahead of the delivery, so
// each position stores an existing box rather than a fresh literal.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type Node = { v: i32, next: Node | null } | { e: i32 }
function sumNode(n: Node | null): i32 {
  if n == null { return 0 }
  if n is { e: i32 } { return n.e * 100 }
  return n.v + sumNode(n.next)
}
function chain(k: i32): Node | null {
  const tail: Node = { e: 1 }
  const mid: Node = { v: k, next: tail }
  const top: Node = { v: 3, next: mid }
  return top
}
// @@VALUE@@
chain(2)
// @@TYPE@@
Node | null
// @@TEST@@
v != null
// @@HIT@@
print(sumNode(v))
// @@MISS@@
print(-1)
// @@WANT@@
105
// @@FALLBACK@@
null
// @@VALUE2@@
chain(5)
// @@TYPE2@@
Node | null
// @@PROOF2@@
print(sumNode(v))
// @@WANT2@@
108
