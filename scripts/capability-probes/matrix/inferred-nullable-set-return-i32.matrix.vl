// An un-annotated function returning `null` or a `Set<i32>` infers `Set<i32> | null` (D16037), the
// set struct's own nullable ref. The proof asks the set for its element, so a delivery that loses
// the set, or builds it at another key kind, prints otherwise.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function pick(c: boolean) {
  if c { return null }
  const m: Set<i32> = Set()
  m.add(3)
  return m
}
// @@VALUE@@
pick(false)
// @@TYPE@@
Set<i32> | null
// @@TEST@@
v != null
// @@HIT@@
print(v.has(3))
// @@MISS@@
print("null")
// @@WANT@@
true
// @@VALUE2@@
pick(true)
// @@TYPE2@@
Set<i32> | null
// @@PROOF2@@
if v != null { print(v.has(3)) } else { print("null") }
// @@WANT2@@
null
