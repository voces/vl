// A nested list of a function with an un-annotated parameter, its loop variable bound to a `const`
// in the body and indexed through it at one type, the list's element read at another; the alias
// takes the loop's rows (D9981).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __inc(a) { return a + 1 }
// @@VALUE@@
[[__inc]]
// @@TYPE@@
((a: i32) => i32)[][]
// @@PROOF@@
let __n = 0
for __r in v {
  const __q = __r
  __n = __q[0](3)
}
const __f = v[0][0](2.5)
if __n == 4 { print(__f) } else { print("wrong i32 read") }
