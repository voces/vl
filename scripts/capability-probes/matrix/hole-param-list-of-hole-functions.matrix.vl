// D6601: a list literal of un-annotated lambdas, and of a declared generic with its type
// parameter left open, handed to an un-annotated parameter that calls an element.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __run(fs) { return fs[0](3) }
function __runF(fs) { return fs[0](2.5) }
const __h = (u) => u + 1
function __idT<T>(a: T): T { return a }
// @@VALUE@@
__run([__h])
// @@TYPE@@
i32
// @@PROOF@@
print(v)
// @@WANT@@
4
// @@TEST@@
v == 4
// @@HIT@@
print(v)
// @@MISS@@
print(0)
// @@VALUE2@@
__runF([__idT])
// @@TYPE2@@
f64
// @@PROOF2@@
print(v + 1.0)
// @@WANT2@@
3.5
