// D6205/D6206: a generic body calling a maker's result (or a module binding of `fw(id)`) at its
// own type parameter, instanced at two types. The value is the body's result at one of them;
// the prelude calls it at the other, so every position reads one instance of a split body.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __k<T>(x: T): T {
  return x
}
function __mk() {
  return __k
}
function __body<U>(u: U): U {
  const a = __mk()
  return a(u)
}
const __s = __body("s")
function __fw(f) {
  return f
}
function __id(x) {
  return x
}
const __q = __fw(__id)
function __body2<T>(x: T): T {
  return __q(x)
}
const __t = __body2("t")
// @@VALUE@@
__body(41)
// @@TYPE@@
i32
// @@PROOF@@
print(v)
// @@WANT@@
41
// @@TEST@@
v == 41
// @@HIT@@
print(v)
// @@MISS@@
print(0)
// @@VALUE2@@
__body2(7)
// @@TYPE2@@
i32
// @@PROOF2@@
print(v)
// @@WANT2@@
7
