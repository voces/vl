// D1515 — the SAME anonymous struct-ref-list field D1443 built, produced by anything but an
// array literal of object literals. Here the list is a CALL result, so there is no element
// NODE to read a row off and the literal route declines; the companion has to come from the
// checker's recorded element type instead.
//
// The template must NOT declare a `type` for the OUTER shape — that declaration is the rescue
// D1443's row records, and it would turn every cell green for the wrong reason. `Rec` IS
// declared, because the element being nominal is not the ingredient (the un-declared element
// spelling refuses identically) and the call needs a return annotation to write.
//
// The PROOF reads THROUGH the element (`v.it[0].n`), so a row whose element heap type came
// from the wrong shape traps or prints the wrong number rather than passing.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type Rec = { name: string, n: i32 }
function rows(): Rec[] { return [{ name: "ada", n: 3 }] }
function rows2(): Rec[] { return [{ name: "bo", n: 4 }] }
// @@VALUE@@
{ it: rows() }
// @@TYPE@@
{ it: Rec[] }
// @@PROOF@@
print(v.it[0].n)
// @@WANT@@
3
// @@VALUE2@@
{ it: rows2() }
// @@TYPE2@@
{ it: Rec[] }
// @@PROOF2@@
print(v.it[0].n + 1)
// @@WANT2@@
5
// @@SKIP@@
is_in_if: the value is a struct, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
