// D15144's generic twin: the record of a parameter called at two signatures, held by a binding
// inside a generic function's instance and returned from it, so an instance holds it before
// each position does (D15145). Design: docs/internals/bundle-record-value-2026-11.md.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __lap(f) {
  const __a = f(2.5)
  const __b = f(3)
  return f
}
function __gen<T>(t: T, k: i32) {
  const r = __lap((a) => a + k)
  const __t = t
  return r
}
// @@VALUE@@
__gen("s", 1)
// @@TYPE@@
(x: f64) => f64
// @@PROOF@@
print("\{v(4)} \{v(1.5)}")
// @@WANT@@
5 2.5
// @@TEST@@
v(4) == 5
// @@HIT@@
print("\{v(4)} \{v(1.5)}")
// @@MISS@@
print(0)
// @@VALUE2@@
__gen(7, 3)
// @@TYPE2@@
(x: f64) => f64
// @@PROOF2@@
print("\{v(4)} \{v(1.5)}")
// @@WANT2@@
7 4.5
