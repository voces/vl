// D8320: a union whose record arm shares its field names with another union's record that
// stores a field differently. A value stored as that other record never sits in this union, so
// `is N` narrows to `N`'s own row and the field reads there.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type J = { r: i32 }
type N = { r: i32 | null }
const a: J | string = { r: 5 }
// @@VALUE@@
{ r: 7 }
// @@TYPE@@
N | string
// @@WANT@@
7
// @@TEST@@
v is N
// @@HIT@@
print(v.r ?? 0)
// @@MISS@@
print(0)
