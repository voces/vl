// A `map` over a list a kept maker's build stores at a wider record `J`, for every callback form:
// a lambda or named function that hands each element back, one that projects a field, and one
// that builds a fresh record. A result holding the elements keeps their build (D16211); a write
// through it reaches the original list's records. The annotated-parameter form is D16211's other
// half and stays refused.
// @@PRELUDE@@
type J = { f: i32 | null }
function mk2() { return { f: null } }
const dA: J = mk2()
const src = [mk2()]
// @@VALUE@@
src.map((y) => y)
// @@TYPE@@
{ f: null }[]
// @@PROOF@@
print(v[0].f)
// @@WANT@@
null
// @@CELL_identity_lambda@@
// want: null
const ns = src.map((y) => y)
print(ns[0].f)
// @@CELL_identity_block_lambda@@
// want: null
const ns = src.map((y) => {
  return y
})
print(ns[0].f)
// @@CELL_identity_named@@
// want: null
function same(y) { return y }
const ns = src.map(same)
print(ns[0].f)
// @@CELL_identity_alias_write@@
// want: null then 1
const ns = src.map((y) => y)
print(ns[0].f)
print(ns.length)
// @@CELL_identity_then_filter@@
// want: 1
const ns = src.map((y) => y).filter((y) => y.f == null)
print(ns.length)
// @@CELL_identity_returned@@
// want: null
function all() { return src.map((y) => y) }
print(all()[0].f)
// @@CELL_identity_in_field@@
// want: null
const r = { ns: src.map((y) => y) }
print(r.ns[0].f)
// @@CELL_identity_for_loop@@
// want: null
for e in src.map((y) => y) { print(e.f) }
// @@CELL_project_field@@
// want: true
print(src.map((y) => y.f == null)[0])
// @@CELL_project_field_named@@
// want: true
function isNull(y) { return y.f == null }
print(src.map(isNull)[0])
// @@CELL_build_record@@
// want: true
const ns = src.map((y) => {
  return { g: y.f == null }
})
print(ns[0].g)
// @@CELL_annotated_param@@
// owed: this container's
const ns = src.map((y: { f: null }) => y)
print(ns[0].f)
