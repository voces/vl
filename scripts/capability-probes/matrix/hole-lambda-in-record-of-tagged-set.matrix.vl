// D16937 at every delivery position: an un-annotated lambda written in a record literal's field
// into a list whose functions return different types, so the set is tagged and the field holds
// an id. The emitter refused a lambda value in a field that takes no closure, though a named
// member there is stored as its id. The CELL_ positions write the literal straight into the list.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __inc0(a) { return a + 1 }
function __half(a) { return a / 2.0 }
const __xs = [{ f: __inc0 }, { f: __half }]
// @@VALUE@@
{ f: (x) => x * 3 }
// @@TYPE@@
{ f: (x: i32) => i32 }
// @@PROOF@@
__xs.push(v)
print(__xs[2].f(3))
// @@WANT@@
9
// @@CELL_push_literal@@
__xs.push({ f: (x) => x * 3 })
print(__xs[2].f(3))
// @@CELL_index_store_literal@@
// want: 9 then 4
__xs[1] = { f: (x) => x * 3 }
print(__xs[1].f(3))
print(__xs[0].f(3))
// @@CELL_push_literal_all@@
// want: 4 then 1.5 then 9
__xs.push({ f: (x) => x * 3 })
for r in __xs { print(r.f(3)) }
// @@CELL_push_literal_capture@@
// want: 15
const k = 5
__xs.push({ f: (x) => x * k })
print(__xs[2].f(3))
// @@CELL_push_literal_f64@@
// want: 0.75 then 4
__xs.push({ f: (x) => x / 4.0 })
print(__xs[2].f(3))
print(__xs[0].f(3))
// @@CELL_push_literal_in_fn@@
function __go() {
  __xs.push({ f: (x) => x * 3 })
  print(__xs[2].f(3))
}
__go()
// @@CELL_call_before_push_literal@@
// want: 1.5 then 9
print(__xs[1].f(3))
__xs.push({ f: (x) => x * 3 })
print(__xs[2].f(3))
// @@CELL_call_before_push_bound@@
// want: 1.5 then 9
print(__xs[1].f(3))
const g = (x) => x * 3
__xs.push({ f: g })
print(__xs[2].f(3))
