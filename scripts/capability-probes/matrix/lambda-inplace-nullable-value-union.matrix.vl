// D2567 — a lambda literal called in place over `string | i32 | null`. Its `$fnsig` keys the
// result as the box, while the checker's type is a nullable union, which the emitter's union
// classifier read as no union; the destination then boxed the box as an `i32`. The let-bound
// spelling (`const f = …; f(7)`) always ran.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function show(u: string | i32 | null): string {
  if u == null { return "none" }
  if u is string { return u }
  return "num"
}
// @@VALUE@@
((p: string | i32 | null) => p)(7)
// @@TYPE@@
string | i32 | null
// @@PROOF@@
if v is i32 { print(v + 1) } else { print(0) }
// @@WANT@@
8
// @@TEST@@
v != null
// @@HIT@@
print(8)
// @@MISS@@
print(0)
// @@VALUE2@@
((p: string | i32 | null) => p)(null)
// @@TYPE2@@
string | i32 | null
// @@PROOF2@@
print(show(v))
// @@WANT2@@
none
