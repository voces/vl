// A read of a `null`-typed field as an operand of a guarded nullable compare, at every delivery
// position: the read runs for its effect inside the guard, and the compare answers by the other
// side's nullness (D17420; unfiled: D17420).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type __U = { id: i32, tags: null }
type __T = { id: i32, tags: string | null }
const __u: __U = { id: 2, tags: null }
const __s: string | null = "a"
const __t: __T = { id: 2, tags: null }
// @@VALUE@@
(__u.tags == __s)
// @@TYPE@@
boolean
// @@TEST@@
v
// @@HIT@@
print("hit")
// @@MISS@@
print("miss")
// @@WANT@@
miss
// @@CELL_right@@
// want: true
const v: boolean = __s != __u.tags
print(v)
// @@CELL_list@@
// want: true then false
function f(s: i32[] | null): boolean { return s == __u.tags }
print(f(null))
print(f([1]))
// @@CELL_record_literal_right@@
// want: true then false
function f(t: __T): boolean { return t == { id: 2, tags: null } }
print(f(__t))
print(f({ id: 2, tags: "a" }))
// @@CELL_record_literal_left@@
// want: false then true
function f(t: __T): boolean { return { id: 2, tags: null } != t }
print(f(__t))
print(f({ id: 3, tags: null }))
// @@CELL_record_nullable_blocked@@
// want: true then false
type __R = { r: i32 }
function f(s: __R | null): boolean { return s == __u.tags }
print(f(null))
print(f({ r: 1 }))
