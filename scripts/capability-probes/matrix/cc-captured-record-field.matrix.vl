// A closure over a record whose field it writes, delivered and called twice.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type CcR = { c: i32 }
function __mk() {
  const r: CcR = { c: 0 }
  return () => {
    r.c = r.c + 2
    return r.c
  }
}
// @@VALUE@@
__mk()
// @@TYPE@@
() => i32
// @@PROOF@@
v()
print(v())
// @@WANT@@
4
