// A literal-union arm narrowed out of a mixed box by `is` and joined into a string: the joined
// value is a string at every position, the arm reading back as its member text.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function pick(b: boolean): ("pp" | "qq") | f64 {
  if b { return "qq" }
  return 1.5
}
const x = pick(true)
// @@VALUE@@
x + "!"
// @@TYPE@@
string
// @@GUARD@@
x is ("pp" | "qq")
// @@FALLBACK@@
"O"
// @@PROOF@@
print(v)
// @@TEST@@
v == "qq!"
// @@HIT@@
print(v)
// @@MISS@@
print("miss")
// @@WANT@@
qq!
// @@CELL_union_param_argument@@
function show(s: string | i32) { if s is string { print(s) } else { print("i32") } }
if x is ("pp" | "qq") { show(__V__) }
// @@CELL_nested_call_argument@@
function id(s: string): string { return s }
if x is ("pp" | "qq") { print(id(id(__V__))) }
// @@CELL_concat_operand@@
// want: <qq!
if x is ("pp" | "qq") { print("<" + __V__) }
// @@CELL_concat_right_part@@
// want: <qq
if x is ("pp" | "qq") { print("<" + x) }
// @@CELL_interpolation_hole@@
// want: [qq]
if x is ("pp" | "qq") { print("[\{x}]") }
// @@CELL_if_arm_value@@
const t = pick(true)
if x is ("pp" | "qq") { const w = if t is f64 { "O" } else { __V__ }; print(w) }
// @@CELL_coalesce_operand@@
const n: string | null = if x is f64 { "O" } else { null }
if x is ("pp" | "qq") { print(n ?? __V__) }
