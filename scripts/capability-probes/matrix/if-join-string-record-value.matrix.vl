// D2839 — an if-expression whose then arm is a string and whose else arm is a record: the
// join is the value union `string | {b: string}`, a box. The classifier read the then arm and
// called the whole `if` a string, so an un-annotated parameter it reached pinned `string`.
// VALUE2 swaps the arms, the order that always ran.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function pick(): boolean { true }
// @@VALUE@@
if pick() { "s" } else { { b: "x" } }
// @@TYPE@@
string | { b: string }
// @@TEST@@
v is string
// @@HIT@@
print(v)
// @@MISS@@
print(v.b)
// @@WANT@@
s
// @@VALUE2@@
if pick() { { b: "x" } } else { "s" }
// @@TYPE2@@
{ b: string } | string
// @@PROOF2@@
if v is string { print(v) } else { print(v.b) }
// @@WANT2@@
x
