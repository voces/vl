// A `.map` whose callback is a function value bound from a call with an `i64` result: no lifted entry names the
// result's scalar list, so the call's recorded `i64[]` must collect it, at every position, in
// both faces.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function twice(n: i32): i64 { (n as i64) * 2 }
function pick(): (i32) => i64 { return twice }
const src: i32[] = [3, 5]
// @@SETUP@@
const cb = pick()
// @@VALUE@@
src.map(cb)
// @@TYPE@@
i64[]
// @@PROOF@@
print(v[1] + (v.length as i64))
