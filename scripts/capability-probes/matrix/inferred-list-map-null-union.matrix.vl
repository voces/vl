// lower as its annotated twin does. The value is the map arm; the second instance is the
// list arm.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type S = { n: i32 }
function k(n: i32) { n }
function pick(c: i32) {
  if c == 1 { return [k(1), 2] }
  if c == 2 { return null }
    const m: {[string]: i32} = Map()
  m["a"] = k(5)
  return m
}
// @@VALUE@@
pick(k(0))
// @@TYPE@@
i32[] | {[string]: i32} | null
// @@WANT@@
5
// @@TEST@@
v is i32[]
