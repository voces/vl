// A list-literal spread of an existing list whose record element carries an extra numeric
// field the destination's record drops (D14960): the literal is built at the destination's
// list type and each source element copied as it is, its struct a subtype of the
// destination's, at every position, in both faces.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type Shape = { r: i32 }
type Circle = { r: i32, w: f64 }
const cs: Circle[] = [{ r: 7, w: 2.5 }, { r: 8, w: 0.5 }]
// @@VALUE@@
[...cs]
// @@TYPE@@
Shape[]
// @@PROOF@@
print(v[1].r * 10 + v.length)
// @@WANT@@
82
// @@SKIP@@
is_in_if: the value is a list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
