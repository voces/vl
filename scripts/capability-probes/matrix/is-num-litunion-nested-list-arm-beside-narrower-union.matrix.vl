// D16894 — `v is K[][]` over a `K[][] | i32[][] | string` box once the program registered
// `K[][] | string | null` first: both unions key one row, an `i32[][]` value rides the `K[][]`
// arm's tag, and the test reads every leaf. `[[1], [0, 5]]` holds a `5` and does not fit.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type K = 0 | 1
function first(x: K[][] | string | null): i32 {
  if x is K[][] { return x.length }
  return 0
}
const seen = first([[1]])
function mk(k: i32): K[][] | i32[][] | string {
  if k == 0 { return "s" }
  const w: i32[][] = if k == 1 { [[1], [0, 5]] } else { [[1, 1]] }
  return w
}
// @@VALUE@@
mk(1)
// @@TYPE@@
K[][] | i32[][] | string
// @@TEST@@
v is K[][]
// @@HIT@@
print(-1)
// @@MISS@@
print(seen + 6)
// @@WANT@@
7
// @@VALUE2@@
mk(2)
// @@TYPE2@@
K[][] | i32[][] | string
// @@PROOF2@@
const y = v as? K[][]
if y == null { print(9) } else { print(y[0].length) }
// @@WANT2@@
2
