// D9610: an inline list of un-annotated functions handed to an un-annotated parameter that the
// body binds to an annotated local, so the annotation alone decides the parameter's type. The
// value delivered is the sum of the bound element's call and of a list written whole to an
// annotated `let` (D9670).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __inc(a) { return a + 1 }
function __dbl(a) { return a * 2 }
function __early(a) {
  const k: ((x: i32) => i32)[] = a
  let w: ((x: i32) => i32)[] = []
  w = [__dbl]
  return k[0](4) + w[0](4)
}
// @@VALUE@@
__early([__inc])
// @@TYPE@@
i32
// @@PROOF@@
print(v)
// @@WANT@@
13
