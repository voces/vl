function n(x: i32): string[] { return ["a", "b"] }
function m(x: i32): string[] { return ["c"] }
// @@VALUE@@
n
// @@TYPE@@
(x: i32) => string[] | null
// @@PROOF@@
const r = v(1)
if r != null { print(r[0] + r[1]) } else { print("none") }
