// A list `+` of a `(string | f64)[]` and a `(string | i32)[]`: the `i32` member is held by the
// other only as `f64`, so each such box is rebuilt under `f64` before the concat (D16880), at
// every position, both faces. VALUE2 puts the narrower operand on the LEFT.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
const wf: (string | f64)[] = ["p", 2.5]
const ni: (string | i32)[] = [1]
// @@VALUE@@
wf + ni
// @@TYPE@@
(string | f64)[]
// @@PROOF@@
const e = v[2]
if e is f64 { print("\{e + 0.5}") } else { print("miss") }
// @@WANT@@
1.5
// @@VALUE2@@
ni + wf
// @@TYPE2@@
(string | f64)[]
// @@PROOF2@@
const e = v[0]
if e is f64 { print("\{e + 0.5}\{v.length}") } else { print("miss") }
// @@WANT2@@
1.53
// @@SKIP@@
is_in_if: the value is a list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
