// D7840: an un-annotated list whose element is an `if` choosing between two hole functions that
// return their own parameter, called inside a generic at the generic's type parameter, which
// stays open: the generic is called at `i32` and at `string`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __fa(v) {
  v
}
function __fb(v) {
  v
}
function __run<T>(x: T, c: boolean): T {
  const fs = [if c { __fa } else { __fb }]
  fs[0](x)
}
// @@VALUE@@
__run("abc", false).length + __run(3, true)
// @@TYPE@@
i32
// @@PROOF@@
print(v)
// @@WANT@@
6
