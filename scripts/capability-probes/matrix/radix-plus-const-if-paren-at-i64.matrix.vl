// A radix literal plus a parenthesised value `if` of constant arms, delivered to each position at `i64` and as an operand beside an `i64` peer: the constant
// `if` is a constant of the tree, which takes the destination's width (D16319, D16374).
//
// The un-annotated face has no destination, so the radix literal is its 8-digit i32 pattern and
// the face prints `6` by DECISIONS' radix ruling: its WRONG cells are the ruled value.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
const __k = true
// @@VALUE@@
0xFFFFFFFF + (if __k { 7 } else { 5 })
// @@TYPE@@
i64
// @@PROOF@@
print(v)
// @@WANT@@
4294967302
// @@CELL_operator_peer@@
// want: 4294967303
const __p: i64 = 1
print(__V__ + __p)
