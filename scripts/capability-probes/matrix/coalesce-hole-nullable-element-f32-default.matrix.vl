// D9701: `??` over a nullable `f32` list element read inside an un-annotated function. An
// integer literal default adopts `f32`, as at top level; a call default returning `i32` joins
// apart, so the result is the `f32 | i32` box.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
const __x: f32 = 1.5
const __k: (f32 | null)[] = [__x, null]
function __dc() { 9 }
function __orZero(a) { a[1] ?? 0 }
function __orCall(a) { a[1] ?? __dc() }
// @@VALUE@@
__orZero(__k)
// @@TYPE@@
f32
// @@TEST@@
v < 1
// @@HIT@@
print(v + 1.5)
// @@MISS@@
print("miss")
// @@WANT@@
1.5
// @@VALUE2@@
__orCall(__k)
// @@TYPE2@@
f32 | i32
// @@PROOF2@@
if v is i32 { print(v + 1) } else { print("f32") }
// @@WANT2@@
10
