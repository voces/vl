// v128-generic-box (D2634) — a generic body's `T | null` and `T | i32` at `T = F32x4`. The value
// is a generic wrapper's `T | null` result, delivered at every position; own cells box the type
// parameter as a local, a union return, a `??` default, a record field and a list element. The
// proof reads a lane through `laneY`, a typed helper, since a getter does not satisfy a hole.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
import { F32x4, splatF32 } from "std:simd"
function wrapN<T>(x: T): T | null {
  const w: T | null = x
  return w
}
function laneY(v: F32x4): f32 { return v.y }
// @@VALUE@@
wrapN(splatF32(7.0))
// @@TYPE@@
F32x4 | null
// @@TEST@@
v != null
// @@HIT@@
if v != null { print(laneY(v)) }
// @@MISS@@
print("none")
// @@WANT@@
7
// @@VALUE2@@
wrapN(splatF32(4.0))
// @@TYPE2@@
F32x4 | null
// @@PROOF2@@
print((v ?? splatF32(0.0)).x)
// @@WANT2@@
4
// @@CELL_or_i32@@
// want: 2 then 0
const v__A__ = __V__
function orZ<T>(x: T, z: boolean): T | i32 {
  if z { return 0 }
  return x
}
const u = orZ(splatF32(2.0), false)
if u is F32x4 { print(u.x) } else { print(u) }
const u2 = orZ(splatF32(2.0), true)
if u2 is i32 { print(u2) }
// @@CELL_local_or_i32@@
// want: 3
const v__A__ = __V__
function keep<T>(x: T): T {
  const u: T | i32 = x
  if u is i32 { return x }
  return u
}
print(keep(splatF32(3.0)).z)
// @@CELL_coalesce_default@@
// want: 5 then 9
const v__A__ = __V__
function firstOf<V>(m: {[string]: V}, k: string, d: V): V { return m.get(k) ?? d }
const m: {[string]: F32x4} = Map()
m.set("k", splatF32(5.0))
print(firstOf(m, "k", splatF32(0.0)).y)
print(firstOf(m, "q", splatF32(9.0)).y)
// @@CELL_record_field@@
// want: 3 then true
const v__A__ = __V__
type Box<T> = { v: T | null }
function mk<T>(x: T): Box<T> { return { v: x } }
const b = mk(splatF32(3.0))
const bv = b.v
if bv != null { print(bv.z) }
const e: Box<F32x4> = { v: null }
print(e.v == null)
// @@CELL_list_element@@
// want: 2 then 6
const v__A__ = __V__
function lst<T>(x: T): (T | null)[] { return [x, null] }
const l = lst(splatF32(6.0))
print(l.length)
const l0 = l[0]
if l0 != null { print(l0.w) }
// @@CELL_reassign_null@@
// want: true then 1
const v__A__ = __V__
function swap<T>(x: T): T | null {
  let w: T | null = null
  if w == null { print(true) }
  w = x
  return w
}
const s = swap(splatF32(1.0))
if s != null { print(s.x) }
