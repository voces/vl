// A push onto a ref list whose element slot is nullable (`(R | null)[]`), at every position its
// value (the new length) is delivered to, and with each element spelling the IR admits: the
// value at its own rep, that ref widened to its nullable, or a bare `null`. Each cell reads the
// pushed element back.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type R = { v: i32 }
function mkr(n: i32): R { return { v: n } }
const nl: (R | null)[] = []
// @@VALUE@@
nl.push(mkr(4))
// @@TYPE@@
i32
// @@PROOF@@
print(v)
print(nl[0]?.v ?? 0)
// @@WANT@@
1 then 4
// @@SKIP@@
local_assign: the harness writes the value twice at this position (an initializer and an assignment), so the program pushes twice and prints 2
struct_field_assign: the harness writes the value twice at this position (an initializer and an assignment), so the program pushes twice and prints 2
array_element_assign: the harness writes the value twice at this position (an initializer and an assignment), so the program pushes twice and prints 2
// @@CELL_elem_null@@
// want: 1 then 0 then 2 then 5
const ys: (R | null)[] = []
print(ys.push(null))
print(ys[0]?.v ?? 0)
print(ys.push(mkr(5)))
print(ys[1]?.v ?? 0)
// @@CELL_elem_literal@@
// want: 1 then 6
const ys: (R | null)[] = []
print(ys.push({ v: 6 }))
print(ys[0]?.v ?? 0)
// @@CELL_elem_narrowed@@
// want: 1 then 7
function f(m: R | null) {
  const ys: (R | null)[] = []
  if m != null { print(ys.push(m)) }
  print(ys[0]?.v ?? 0)
}
f(mkr(7))
// @@CELL_elem_param@@
// want: 1 then 0
function f(m: R | null) {
  const ys: (R | null)[] = []
  print(ys.push(m))
  print(ys[0]?.v ?? 0)
}
f(null)
// @@CELL_elem_field@@
// want: 1 then 8
type H = { h: R | null }
function f(o: H) {
  const ys: (R | null)[] = []
  print(ys.push(o.h))
  print(ys[0]?.v ?? 0)
}
f({ h: mkr(8) })
// @@CELL_elem_closure@@
// want: 1 then 9
const fs: ((() => i32) | null)[] = []
print(fs.push(() => 9))
const g = fs[0]
print(if g != null { g() } else { 0 })
