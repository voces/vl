// D2506 — a map whose only pinning write was a bare `null`, filled by a later write
// (`m[k] = null` then `m[k2] = <T>`) with `T` = `C`. The null write pins
// `T | null` with `T` open, as `let x = null` does: the container is `{[string]: C | null}`.
//
// THE SETUP DECLARES IT IN THE DELIVERY'S OWN SCOPE, so each position exercises the storage
// class it has there: a function local, a start-fn local, a module global.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type C = { a: i32 }
// @@SETUP@@
const __o = Map()
__o["nul"] = null
__o["val"] = { a: 7 }
// @@VALUE@@
__o
// @@TYPE@@
{[string]: C | null}
// @@TEST@@
v["nul"] == null
// @@HIT@@
const __e = v["val"]
if __e != null { print(__e.a) } else { print("miss") }
// @@MISS@@
print("none")
// @@WANT@@
7
// @@SKIP@@
map_value: a value read back out of a map is `V | null`, and this proof indexes the container itself
map_value_place: the same `V | null` read as `map_value`
argument: an un-annotated parameter only READ as a map pins neither half, which the checker refuses by design (`holeMapDemandOpen`)
early_return_guard: the same read-only map parameter as `argument`
