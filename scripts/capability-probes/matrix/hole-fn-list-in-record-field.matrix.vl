// A record literal whose field is a list of a function with an un-annotated parameter, read back
// through the field and called. The list takes its element type from that call (D9061).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __h(u) { return u + 1 }
// @@VALUE@@
{ xs: [__h] }
// @@TYPE@@
{xs: ((u: i32) => i32)[]}
// @@PROOF@@
print(v.xs[0](3))
// @@WANT@@
4
// @@TEST@@
v.xs.length == 1
// @@HIT@@
print(v.xs[0](3))
// @@MISS@@
print(0)
