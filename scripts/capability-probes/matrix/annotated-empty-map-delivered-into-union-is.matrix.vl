// An empty map whose annotation fixes its element type, delivered into a union of two map
// types at every position: `is` answers by the arm it was delivered as, so the other arm's
// test is false though the map is empty (owner ruling 2026-11-15, refining D16047).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
const __m: {[i32]: boolean} = Map()
// @@VALUE@@
__m
// @@TYPE@@
{[i32]: boolean} | {[i32]: i32}
// @@TEST@@
v is {[i32]: i32}
// @@HIT@@
print(0)
// @@MISS@@
print(42)
// @@WANT@@
42
