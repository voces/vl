// A list of lists of records whose nested record's field holds un-annotated functions of
// different result types, delivered at every position: a call through `xs[i][j].a.f` runs the
// function stored there, as through a list of lists of the function records (D16835).
// @@PRELUDE@@
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const rows = [[{ a: { f: inc0 } }], [{ a: { f: half } }]]
// @@VALUE@@
rows
// @@TYPE@@
{ a: { f: (f64) => f64 } }[][]
// @@PROOF@@
print(v[1][0].a.f(3))
// @@WANT@@
1.5
// @@CELL_direct_both_rows@@
// want: 1.5 then 4
print(rows[1][0].a.f(3))
print(rows[0][0].a.f(3))
// @@CELL_one_inner_list@@
// want: 1.5 then 4
const ys = [[{ a: { f: inc0 } }, { a: { f: half } }]]
print(ys[0][1].a.f(3))
print(ys[0][0].a.f(3))
// @@CELL_deep_records@@
// want: 1.5 then 4
const ys = [[{ a: { b: { c: { f: inc0 } } } }], [{ a: { b: { c: { f: half } } } }]]
print(ys[1][0].a.b.c.f(3))
print(ys[0][0].a.b.c.f(3))
// @@CELL_three_levels@@
// want: 1.5
const ys = [[[{ a: { f: inc0 } }]], [[{ a: { f: half } }]]]
print(ys[1][0][0].a.f(3))
// @@CELL_field_written@@
// want: 1.5
const ys = [[{ a: { f: inc0 } }], [{ a: { f: half } }]]
ys[0][0].a.f = half
print(ys[0][0].a.f(3))
// @@CELL_record_written@@
// want: 1.5
const ys = [[{ a: { f: inc0 } }], [{ a: { f: half } }]]
ys[0][0].a = { f: half }
print(ys[0][0].a.f(3))
// @@CELL_inner_pushed@@
// want: 1.5
const ys = [[{ a: { f: inc0 } }]]
ys[0].push({ a: { f: half } })
print(ys[0][1].a.f(3))
// @@CELL_outer_pushed@@
// want: 1.5 then 4
const ys = [[{ a: { f: inc0 } }]]
ys.push([{ a: { f: half } }])
print(ys[1][0].a.f(3))
print(ys[0][0].a.f(3))
// @@CELL_loops@@
// want: 4 then 1.5
for row in rows {
  for r in row { print(r.a.f(3)) }
}
// @@CELL_second_field@@
// want: 1.5 then 2
const ys = [[{ a: { f: inc0 }, n: 1 }], [{ a: { f: half }, n: 3 }]]
print(ys[1][0].a.f(ys[1][0].n))
print(ys[0][0].a.f(ys[0][0].n))
