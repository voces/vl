// D8820: a null `string | i32 | null` handed from every position to a generic whose `T` stays
// open, written into a list element declared at that union. The pin decides whether the
// element is null, so the body's null test and `??` read it at the pin rather than folding.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function mkv(): string | i32 | null { null }
function mkv2(): string | i32 | null { 4 }
function __tvw<T>(x: T): string {
  const a: (string | i32 | null)[] = [1]
  a[0] = x
  const d = a[0] ?? "n"
  if a[0] == null && d == "n" { return "null n" }
  "set"
}
// @@VALUE@@
mkv()
// @@TYPE@@
string | i32 | null
// @@WANT@@
null n
// @@TEST@@
__tvw(v) == "null n"
// @@HIT@@
print(__tvw(v))
// @@MISS@@
print("miss")
// @@VALUE2@@
mkv2()
// @@TYPE2@@
string | i32 | null
// @@PROOF2@@
print(__tvw(v))
// @@WANT2@@
set
