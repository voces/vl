// D15090: `==` between a nullable `i32` and a nullable `f64` compares the values at `f64`, not
// the two boxes' tags; two nulls are equal and a null is no number. The second instance is the
// null. The proof compares against `f64 | null` values held apart.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function ncwF(v: f64, n: boolean): f64 | null {
  if n { return null }
  return v
}
function ncwI(v: i32, n: boolean): i32 | null {
  if n { return null }
  return v
}
const ncwOne: f64 | null = ncwF(1.0, false)
const ncwHalf: f64 | null = ncwF(1.5, false)
const ncwNul: f64 | null = ncwF(0.0, true)
// @@VALUE@@
ncwI(1, false)
// @@TYPE@@
i32 | null
// @@TEST@@
v == ncwOne && v != ncwHalf && v != ncwNul
// @@HIT@@
print("value")
// @@MISS@@
print("tag")
// @@WANT@@
value
// @@VALUE2@@
ncwI(1, true)
// @@TYPE2@@
i32 | null
// @@PROOF2@@
print("\{v == ncwNul} \{v == ncwOne}")
// @@WANT2@@
true false
