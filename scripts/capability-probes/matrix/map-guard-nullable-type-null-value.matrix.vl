// Control for capability-matrix.vl's map guard: TYPE is nullable and the value is `null`, while
// TEST names no `null`. The map positions must not guard on `!= null`, which skips the proof.
// Graded WRONG at the map positions while only a `null` in TEST dropped the guard.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function mgN(n: i32): i32 | null { if n > 0 { return n } null }
// @@VALUE@@
mgN(0)
// @@TYPE@@
i32 | null
// @@TEST@@
(v ?? 7) == 7
// @@HIT@@
print("value")
// @@MISS@@
print("storage")
// @@WANT@@
value
