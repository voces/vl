// D5160, D5161: a copy of a written function binding of generics, one of which fixes a union
// parameter, taken by an initializer and by a write, is called at a type that parameter takes
// another rep than. The copy reaches the adapted write. The type parameters stay open; the
// annotated face annotates only the destination.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __s<A, B>(a: A, b: B): i32 { return 0 }
function __w<B>(a: i32 | string, b: B): i32 {
  if a is i32 { return a }
  return -1
}
// @@SETUP@@
let __fw = __s
__fw = __w
let __cp = __fw
const __dn = __cp(1, true)
let __ew = __s
__ew = __cp
const __de = __ew(2, false)
// @@VALUE@@
__ew
// @@TYPE@@
(a: i32, b: boolean) => i32
// @@PROOF@@
print(v(41, true))
// @@WANT@@
41
// @@TEST@@
v(0, false) == 0
// @@HIT@@
print(v(41, true))
// @@MISS@@
print(0)
