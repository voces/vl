// The generic twin of fn-value-generic-compared: the comparison is made inside a generic whose
// type parameter only its arguments bind, so the function type the value is compared at is
// `(x: T) => i32` with `T` left open at the comparison (D7382).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function two<T>(x: T): i32 { return 1 }
function three<T>(x: T): i32 { return 3 }
function same<T>(f: (x: T) => i32, g: (x: T) => i32): boolean { return f == g }
// @@VALUE@@
two
// @@TYPE@@
(x: i32) => i32
// @@PROOF@@
print(same(v, two) && !same(v, three) && v(5) == 1)
// @@WANT@@
true
// @@VALUE2@@
three
// @@TYPE2@@
(x: i32) => i32
// @@PROOF2@@
print(same(v, three) && !same(v, two) && v(5) == 3)
// @@WANT2@@
true
// @@SKIP@@
is_in_if: the value is a function, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
