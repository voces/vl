// An empty `[]` or `Set()` inside a list literal handed through a generic identity: the inner
// literal closes to the open container's defaults (an `i32` element, a `string` set element),
// so the outer list, the call's result and an index into it read at that closed list.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function take<B>(b: B): B { return b }
// @@VALUE@@
take([[]])
// @@TYPE@@
i32[][]
// @@PROOF@@
print(v.length + v[0].length)
// @@WANT@@
1
// @@VALUE2@@
take([Set()])
// @@TYPE2@@
Set<string>[]
// @@PROOF2@@
print(v.length + v[0].length)
// @@WANT2@@
1
