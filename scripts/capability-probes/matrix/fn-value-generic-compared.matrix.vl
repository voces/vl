// D7382: a generic function named as a value is the same function at every delivery. Each
// delivery at a concrete function type adapts the generic, and the adapters must compare equal
// to one another and to the generic named in the comparison, and unequal to another generic.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function two<T>(x: T): i32 { return 1 }
function three<T>(x: T): i32 { return 3 }
const __w: (x: i32) => i32 = two
const __o: (x: i32) => i32 = three
// @@VALUE@@
two
// @@TYPE@@
(x: i32) => i32
// @@PROOF@@
print(v == __w && v == two && v != __o && v(5) == 1)
// @@WANT@@
true
// @@VALUE2@@
three
// @@TYPE2@@
(x: i32) => i32
// @@PROOF2@@
print(v == __o && v != __w && v(5) == 3)
// @@WANT2@@
true
// @@SKIP@@
is_in_if: the value is a function, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
