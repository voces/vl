// `?.` call through a hole-typed function field, its receiver's key and its argument each an
// effect that logs: delivered into a boxed `f64 | null`, the key runs before the argument and each
// runs once per evaluation (an assignment position evaluates the value twice), whatever position
// the call's value lands in.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
let log = ""
function half(a) { return a / 2.0 }
const m = Map()
m["b"] = { f: half }
function key(s: string) {
  log = log + "k"
  return s
}
function next() {
  log = log + "n"
  return 4
}
// @@VALUE@@
m[key("b")]?.f(next())
// @@TYPE@@
f64 | null
// @@PROOF@@
print(v ?? -1.0)
print(log == "kn" || log == "knkn")
// @@TEST@@
v != null
// @@HIT@@
print(v ?? -1.0)
print(log == "kn" || log == "knkn")
// @@MISS@@
print("miss")
// @@WANT@@
2 then true
// @@CELL_coalesce_default@@
// want: 2 then kn
print(m[key("b")]?.f(next()) ?? 0.5)
print(log)
// @@CELL_null_receiver@@
// want: -1 then k
print(m[key("zz")]?.f(next()) ?? -1.0)
print(log)
// @@CELL_in_function@@
// want: 2 then kn then -1 then knk
function k(s: string) {
  print(m[key(s)]?.f(next()) ?? -1.0)
  print(log)
}
k("b")
k("zz")
