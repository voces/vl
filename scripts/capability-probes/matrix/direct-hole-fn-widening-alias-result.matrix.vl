// A direct call through an un-annotated binding of an un-annotated function widening its
// `i32` arguments to `f64`, where the hole is not the first parameter (D8161).
//
// Every type is left OPEN: `scaled`'s second parameter is a hole and `f` carries no
// annotation, so the value's `f64` comes only from the callee's body at the call's arguments.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function scaled(k: i32, a) { return a / 2.0 + k - k }
function half(a) { return a / 2.0 }
const f = half
// @@VALUE@@
scaled(1, 3)
// @@TYPE@@
f64
// @@PROOF@@
print(v * 2.0)
// @@WANT@@
3
// @@VALUE2@@
f(3)
// @@TYPE2@@
f64
// @@PROOF2@@
print(v * 2.0)
// @@WANT2@@
3
