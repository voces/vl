// D15941: an un-annotated map of maps holds a map of an un-annotated function. The value under
// test is such a map, its function pinned at one signature by a call, delivered to every
// position and read back there. The cells store it into an un-annotated map of maps by `set` and
// by index, nest it three deep, hold the outer map in a record and a list, and leave it uncalled.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function half(a) { return a / 2.0 }
const m4 = Map()
m4.set("a", half)
const g0 = m4.get("a")
// @@VALUE@@
m4
// @@TYPE@@
{ [string]: (a: f64) => f64 }
// @@PROOF@@
const h = v.get("a")
if g0 != null && h != null { print(g0(3.0) + h(5.0)) }
// @@WANT@@
4
// @@CELL_outer_set@@
const mm = Map()
mm.set("k", __V__)
const f = mm.get("k")
if f != null {
  const h = f.get("a")
  if g0 != null && h != null { print(g0(3.0) + h(5.0)) }
}
// @@CELL_outer_index@@
const mm = Map()
mm["k"] = __V__
const f = mm["k"]
if f != null {
  const h = f["a"]
  if g0 != null && h != null { print(g0(3.0) + h(5.0)) }
}
// @@CELL_outer_size@@
// want: 1
const mm = Map()
mm.set("k", __V__)
const f = mm.get("k")
if f != null { print(f.length) }
// @@CELL_three_deep@@
const mm = Map()
mm.set("k", __V__)
const m3 = Map()
m3.set("z", mm)
const f2 = m3.get("z")
if f2 != null {
  const f = f2.get("k")
  if f != null {
    const h = f.get("a")
    if g0 != null && h != null { print(g0(3.0) + h(5.0)) }
  }
}
// @@CELL_outer_in_record@@
const mm = Map()
mm.set("k", __V__)
const r = { h: mm }
const f = r.h.get("k")
if f != null {
  const h = f.get("a")
  if g0 != null && h != null { print(g0(3.0) + h(5.0)) }
}
// @@CELL_outer_in_list@@
const mm = Map()
mm.set("k", __V__)
const xs = [mm]
const f = xs[0].get("k")
if f != null {
  const h = f.get("a")
  if g0 != null && h != null { print(g0(3.0) + h(5.0)) }
}
