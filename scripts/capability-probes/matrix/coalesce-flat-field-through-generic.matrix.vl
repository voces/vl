// D8342, generic twin: a fresh call's record, stored at the declared row `Col` that holds `r`
// flat, handed from every position to a generic whose `T` stays open. Under `is J` the read
// `a.r` is typed `i32 | null`, and `??` over it is the field itself.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type Col = { r: i32, g: i32 }
type J = { r: i32 | null, g: i32 }
function mk() { { r: 15, g: 1 } }
function __rOf<T>(a: T): i32 {
  if a is J { return a.r ?? 0 }
  0
}
// @@VALUE@@
mk()
// @@TYPE@@
Col
// @@WANT@@
15
// @@TEST@@
__rOf(v) == 15
// @@HIT@@
print(__rOf(v))
// @@MISS@@
print("miss")
