// A list-literal spread of an `i32[]` into a list of `f64 | null`: each element is widened
// and then boxed (D2882). The trailing `2.5` and `null` type the un-annotated face the same.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
const src: i32[] = [3, 4]
// @@VALUE@@
[...src, 2.5, null]
// @@TYPE@@
(f64 | null)[]
// @@PROOF@@
const e = v[0]
const f = v[2]
if e != null && f != null { print(e / 2.0 + f + v.length) } else { print("miss") }
// @@WANT@@
8
// @@SKIP@@
is_in_if: the value is a list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
