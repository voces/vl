// D4152 — a list of scalar lists delivered where a readonly list of a union holding that list
// is wanted. The element-converting copy boxes each inner list under the union's list tag; it
// served only a record row before, so every position built a module the engine refuses.
//
// The PROOF narrows an element back to `string[]` and prints its own string: a cell that
// printed only a length would pass on a list whose elements were never boxed.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
const __ss: string[][] = [["q"]]
// @@VALUE@@
__ss
// @@TYPE@@
readonly (string | string[])[]
// @@PROOF@@
const __e = v[0]
if __e is string[] { print(__e[0]) } else { print("no") }
// @@WANT@@
q
