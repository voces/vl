// D2633 — a `v128 | i32` union: the vector is a value-union atom beside the i32, tested with
// `is`. The proof reads a lane, so a box tagged with the wrong arm prints the wrong number.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function pick(n: i32): v128 | i32 {
  if n < 0 { return 0 - n }
  __splat_i32x4__(n)
}
// @@VALUE@@
pick(9)
// @@TYPE@@
v128 | i32
// @@TEST@@
v is v128
// @@HIT@@
print(__extract_lane_i32x4__(v, 3))
// @@MISS@@
print("scalar")
// @@WANT@@
9
// @@VALUE2@@
pick(-5)
// @@TYPE2@@
v128 | i32
// @@PROOF2@@
if v is i32 { print(v + 1) } else { print("vector") }
// @@WANT2@@
6
