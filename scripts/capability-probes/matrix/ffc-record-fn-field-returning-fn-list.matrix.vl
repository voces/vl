// A list of records whose function field returns a function: the outer call builds the adder and
// the inner call applies it. 10 + 1 and 10 + 2.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __adder(k: i32): (n: i32) => i32 { return (n: i32) => n + k }
// @@VALUE@@
[{ mk: __adder }]
// @@TYPE@@
{mk: (k: i32) => (n: i32) => i32}[]
// @@PROOF@@
const g = v[0].mk(1)
print(g(10))
print(v[0].mk(2)(10))
// @@WANT@@
11 then 12
