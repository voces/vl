// D14971: a lambda returning `Map()` delivered where a function returning
// `{[string]: i32} | Circle` is expected. The lambda result is left un-annotated, so the
// map's holes are pinned by the union's map arm, as at an annotated return.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type Circle = { r: i32 }
function useMu(u: {[string]: i32} | Circle): i32 {
  if u is Circle { return u.r }
  u["a"] = 41
  u["a"] ?? -1
}
// @@VALUE@@
() => Map()
// @@TYPE@@
() => ({[string]: i32} | Circle)
// @@PROOF@@
print(useMu(v()))
// @@WANT@@
41
// @@VALUE2@@
() => ({ r: 3 })
// @@TYPE2@@
() => ({[string]: i32} | Circle)
// @@PROOF2@@
print(useMu(v()))
// @@WANT2@@
3
