// The hole-function twin of fn-value-generic-list-read-open: a list of a function with an
// un-annotated parameter, its elements read back and called at TWO types, so the parameter stays
// open. The annotated face refuses by design; the un-annotated face instances each call (D6661).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __h(u) { return u }
// @@VALUE@@
[__h, __h]
// @@TYPE@@
((u: i32) => i32)[]
// @@PROOF@@
const __n = v[0](2)
const __s = v[1]("abc")
print(__s.length + __n)
// @@WANT@@
5
// @@TEST@@
v.length == 2
// @@HIT@@
const __n = v[0](2)
const __s = v[1]("abc")
print(__s.length + __n)
// @@MISS@@
print(0)
