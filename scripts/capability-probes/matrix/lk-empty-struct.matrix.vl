// List-kind audit (docs/internals/list-kind-audit-2026-09.md): an empty `[]` delivered as `K[]`, then pushed,
// element kind `struct`. One row of a empty-literal-by-kind grid over nine element kinds; the proof reads
// elements back, so a value built at another list rep prints a different answer or fails to
// validate. Written by `list-kind-grid.py --write`; edit that, not this file.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type P = { x: i32 }
function truthy() { 1 == 1 }
// @@VALUE@@
[]
// @@TYPE@@
P[]
// @@PROOF@@
const r = v
r.push({ x: 7 })
print(r.length)
// @@WANT@@
1
// @@VALUE2@@
[]
// @@TYPE2@@
P[]
// @@PROOF2@@
const r2 = v
r2.push({ x: 7 })
const w = r2
print(w[0].x)
// @@WANT2@@
7
// @@SKIP@@
is_in_if: the value is a list, not a union - there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
