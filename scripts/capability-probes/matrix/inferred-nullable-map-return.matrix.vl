// An un-annotated function returning `null` or an i32-keyed map infers `{[i32]: string} | null`
// (D1108), the map struct's own nullable ref. The proof reads a value back out of the map, so a
// delivery that loses the map, or builds it at the string-keyed struct, prints otherwise.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function pick(c: boolean) {
  if c { return null }
  const m: {[i32]: string} = Map()
  m[3] = "s"
  return m
}
// @@VALUE@@
pick(false)
// @@TYPE@@
{[i32]: string} | null
// @@TEST@@
v != null
// @@HIT@@
print(v[3] ?? "-")
// @@MISS@@
print("null")
// @@WANT@@
s
// @@VALUE2@@
pick(true)
// @@TYPE2@@
{[i32]: string} | null
// @@PROOF2@@
if v != null { print(v[3] ?? "-") } else { print("null") }
// @@WANT2@@
null
