// A hole callee's scalar argument is held to the parameter the callee is bound to (D3225): an
// `i32` handed to `(x: f32) => x` is refused at every spelling the direct call refuses.
// @@PRELUDE@@
const s: i32 = 16777217
// @@VALUE@@
s
// @@TYPE@@
i32
// @@PROOF@@
print(v)
// @@WANT@@
16777217
// @@CELL_direct@@
// owed: expected f32, got i32
print(((x: f32) => x)(s))
// @@CELL_hole@@
// owed: expected f32, got i32
function H(h, v) { return h(v) }
print(H((x: f32) => x, s))
// @@CELL_named_fn@@
// owed: expected f32, got i32
function H(h, v) { return h(v) }
function id(x: f32) { return x }
print(H(id, s))
// @@CELL_forwarded@@
// owed: expected f32, got i32
function H(h, v) { return h(v) }
function H2(h, v) { return H(h, v) }
print(H2((x: f32) => x, s))
// @@CELL_method@@
// owed: expected f32, got i32
function app(self, h) { return h(self) }
print(s.app((x: f32) => x))
// @@CELL_generic@@
// owed: expected f32, got i32
function G<T>(h, v: T) { return h(v) }
print(G((x: f32) => x, s))
// @@CELL_loop@@
// owed: expected f32, got i32
function H(h, v) { return h(v) }
for k in [s] { print(H((x: f32) => x, k)) }
// @@CELL_list_elem@@
// owed: expected f32, got i32
function H(h, v) { return h(v[0]) }
print(H((x: f32) => x, [s]))
// @@CELL_control@@
// want: 16777217
function H(h, v) { return h(v) }
print(H((x: i32) => x, s))
