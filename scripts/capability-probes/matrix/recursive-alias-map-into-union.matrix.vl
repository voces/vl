// D1865 — a map whose type is spelled through a RECURSIVE alias, delivered into the union
// that alias is part of. The alias is not transparent (a recursive one cannot be), so the
// name reaches the emitter, and the value's map slot is interned from the RENDERED spelling
// rather than the declared row. Every delivery position, both faces.
//
// The alias spelling is the whole point: the inline `{ [string]: V }` runs at every position
// on master and is the control this template does NOT test — see
// tests/cases/maps/alias-map-into-union-controls.vl for that side.

// @@PRELUDE@@
type V = f64 | string | { [string]: V }
type VMap = { [string]: V }

function mkVMap(): VMap {
  const m: VMap = Map()
  m["a"] = 1.0
  m["b"] = "x"
  m
}

// @@VALUE@@
mkVMap()

// @@TYPE@@
V

// @@TEST@@
v is { [string]: V }

// @@HIT@@
print(v.size)

// @@MISS@@
print(-1)

// @@WANT@@
2
