// A `.map` whose callback returns a map builds a ref list of maps (D12901). The second instance
// maps to a nullable map, so a result read at the plain map row cannot print the answer.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function mk(k: i32): Map<string, i32> {
  const m: Map<string, i32> = Map()
  m.set("a", k)
  m
}
function mkn(k: i32): Map<string, i32> | null { if k > 0 { mk(k) } else { null } }
// @@VALUE@@
[2, 5].map((k) => mk(k))
// @@TYPE@@
Map<string, i32>[]
// @@PROOF@@
print(v.length + (v[1].get("a") ?? 100))
// @@WANT@@
7
// @@VALUE2@@
[0, 6].map((k) => mkn(k))
// @@TYPE2@@
(Map<string, i32> | null)[]
// @@PROOF2@@
const q1 = v[1]
const q0 = v[0]
if q1 != null && q0 == null { print(q1.get("a") ?? 100) } else { print(-1) }
// @@WANT2@@
6
