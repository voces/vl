// D11160 — a three-member union FIELD read while narrowed to the two-member `i32 | null`
// box. The binding holds that smaller box, so the proof's `!= null` must leave exactly `i32`
// at every position; read under the field's whole union it leaves `i32 | string`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@SETUP@@
const __w: { f: i32 | null | string } = { f: 3 }
// @@GUARD@@
!(__w.f is string)
// @@VALUE@@
__w.f
// @@TYPE@@
i32 | null
// @@FALLBACK@@
null
// @@TEST@@
v != null
// @@HIT@@
print(v + 1)
// @@MISS@@
print(0)
// @@WANT@@
4
