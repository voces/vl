// D10294, the hole face: the pair of `mutual-recursive-generic-runtime-numeric-join` takes its
// nullable argument through a hole, and the join stays apart at each pin.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __mhA(q, d: f64, n: i32) {
  if n > 0 { return __mhB(q, d, n - 1) }
  const r = if q != null { q } else { d }
  r
}
function __mhB(q, d: f64, n: i32) { __mhA(q, d, n) }
const __mhQ: i32 | null = 5
const __mhN: i32 | null = null
// @@VALUE@@
__mhA(__mhQ, 1.5, 2)
// @@TYPE@@
i32 | f64
// @@PROOF@@
print(v is i32 && v / 2 == 2)
// @@WANT@@
true
// @@VALUE2@@
__mhA(__mhN, 2.5, 3)
// @@TYPE2@@
i32 | f64
