// A `let` list of a generic pushed a fixed-type `i32` function and then reassigned to a list of
// the generic alone BEFORE it is delivered where its element is `(string) => string` (D10202).
// Only the reassigned value reaches the call, so every face runs.
// `fn-value-generic-list-rebound-at-string-refused.matrix.vl` reassigns after the delivery.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function id<T>(x: T): T { x }
function __inc(x: i32): i32 { x + 1 }
let __zs = [id]
__zs.push(__inc)
__zs = [id, id]
// @@VALUE@@
__zs
// @@TYPE@@
((x: string) => string)[]
// @@PROOF@@
print(v[1]("s"))
// @@WANT@@
s
