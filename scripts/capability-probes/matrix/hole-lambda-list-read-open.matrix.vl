// The lambda twin of hole-fn-list-read-open: a list of an un-annotated `const` lambda, its
// elements read back and called at TWO types, so the parameter stays open. The annotated face
// refuses by design; the un-annotated face instances each call (D6603).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
const __h = (u) => u
// @@VALUE@@
[__h, __h]
// @@TYPE@@
((u: i32) => i32)[]
// @@PROOF@@
const __n = v[0](2)
const __s = v[1]("abc")
print(__s.length + __n)
// @@WANT@@
5
// @@TEST@@
v.length == 2
// @@HIT@@
const __n = v[0](2)
const __s = v[1]("abc")
print(__s.length + __n)
// @@MISS@@
print(0)
