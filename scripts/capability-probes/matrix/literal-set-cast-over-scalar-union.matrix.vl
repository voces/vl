// `as?` to a literal set over two bases from a scalar union, delivered at every position: the
// cast tests as `is` does and hands back the value at the set.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type __K = 1 | "a"
function __mk(k: i32): i32 | string {
  if k > 0 { return k }
  return "a"
}
const __r = __mk(1)
// @@VALUE@@
__r as? __K
// @@TYPE@@
__K | null
// @@TEST@@
v == 1
// @@HIT@@
print(42)
// @@MISS@@
print(0)
// @@WANT@@
42
