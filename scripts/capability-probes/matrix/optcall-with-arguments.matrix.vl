// A5 / D1814 — an optional call with ARGUMENTS. The guard covers the call, not the receiver
// alone, so the arguments are evaluated only on the non-null arm and bind against the
// callee's own parameters.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type P = { n: i32 }
function bump(self: P, d: i32) { self.n + d }
function mkP(c: boolean): P | null {
  if c { return { n: 21 } }
  return null
}
const p = mkP(true)
// @@VALUE@@
p?.bump(21)
// @@TYPE@@
i32 | null
// @@FALLBACK@@
null
// @@PROOF@@
print(v ?? 0)
// @@WANT@@
42
