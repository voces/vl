// D9915: a `??` over a list element of an un-annotated parameter pinned at a never-null `i32[]`
// is the element, though the function is also called at `(i32 | null)[]` with a float default.
// The proof divides, which prints `3` at `i32` and `3.5` at `f64`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __ceTake(a, d) { return a[1] ?? d }
const __ceNul: (i32 | null)[] = [null, 4]
const __ceOther = __ceTake(__ceNul, 1.5)
const __ceK: i32[] = [3, 7]
// @@VALUE@@
__ceTake(__ceK, 9)
// @@TYPE@@
i32
// @@TEST@@
v > 0
// @@HIT@@
print(v / 2)
// @@MISS@@
print("miss")
// @@WANT@@
3
