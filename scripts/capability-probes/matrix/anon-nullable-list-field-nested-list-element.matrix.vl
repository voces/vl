// D1691 — an anonymous holder whose field is `i32[][] | null`: a nullable ref list (code 28)
// whose ELEMENT is itself a list. The code-28 element ladder had a named empty arm for it
// while its code-5 twin admitted it, so widening that gate is what this template grades.
//
// A widened gate is the step that turns a loud refusal into invalid wasm at every position it
// was not wired for, which is why the row asked for this template before the two-line edit.
//
// The prelude holder is the NON-NULL twin of the value, sharing the field name `xs`: its row
// is minted by the whole-arena walk, so a code-28 value delivered anywhere can collide with a
// code-5 row of the same field name if the two stop being told apart.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function plain(): i32[][] { return [[9]] }
function nul1(): i32[][] | null { return [[4]] }
function nul2(): i32[][] | null { return [[5]] }
function firstHolder() {
  const first = { xs: plain() }
  print(first.xs[0][0])
}
// @@VALUE@@
{ xs: nul1() }
// @@TYPE@@
{ xs: i32[][] | null }
// @@PROOF@@
const l = v.xs
if l != null { print(l[0][0]) } else { print(0) }
// @@WANT@@
4
// @@VALUE2@@
{ xs: nul2() }
// @@TYPE2@@
{ xs: i32[][] | null }
// @@PROOF2@@
const l2 = v.xs
if l2 != null { print(l2[0][0]) } else { print(0) }
// @@WANT2@@
5
// @@SKIP@@
is_in_if: the value is a struct, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
