// D15249: a read of a map whose values are built wider, defaulted with `??` to a `const` whose
// record the read's record stores a number wider (`i32` into `i64`), delivered at every position.
// The binding is delivered at the read's record as a typed delivery of it is.
//
// The PROOF multiplies past `i32`, so a field left at `i32` storage cannot print the want.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type J = { f: i64 }
function mkv() { { f: 4 } }
const m = Map()
m.set("a", mkv())
const wm: {[string]: J} = Map()
wm.set("a", mkv())
const dflt = { f: 1 }
// @@VALUE@@
m.get("z") ?? dflt
// @@TYPE@@
J
// @@PROOF@@
print(v.f * 4000000000)
// @@WANT@@
4000000000
// @@SKIP@@
is_in_if: the value is a record, not a union; there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
