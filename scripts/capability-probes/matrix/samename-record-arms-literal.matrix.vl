// D4056's witness — the shared field `k` is a string literal in one arm and an integer literal
// in the other; the sets are disjoint, so `is` answers from the value.
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type A = { k: "x" }
type B = { k: 1 }
function pick(a: boolean): A | B {
  if a { return { k: "x" } }
  { k: 1 }
}
// @@VALUE@@
pick(false)
// @@TYPE@@
A | B
// @@TEST@@
v is A
// @@HIT@@
print("A " + v.k)
// @@MISS@@
print(v.k + 40)
// @@WANT@@
41
// @@VALUE2@@
pick(true)
// @@TYPE2@@
A | B
// @@PROOF2@@
if v is B { print("wrong") } else { print("A " + v.k) }
// @@WANT2@@
A x
