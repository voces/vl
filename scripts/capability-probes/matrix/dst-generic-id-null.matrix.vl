// D4024 — a bare `null` argument binds a bare-`T` return from the destination's whole nullable
// type, so `id(null)` delivered to `Item | null` is the `Item | null` instance. The
// un-annotated face has no destination and binds `T` to `null` itself (D4025).
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type Item = { n: i32 }
function id<T>(x: T): T { x }
// @@VALUE@@
id(null)
// @@TYPE@@
Item | null
// @@TEST@@
v == null
// @@HIT@@
print("none")
// @@MISS@@
print("some")
// @@WANT@@
none
