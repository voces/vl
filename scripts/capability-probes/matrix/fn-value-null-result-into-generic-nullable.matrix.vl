// D10211 — a function value whose result is `null`, handed to a generic that takes it as
// `() => T | null`. Nothing binds `T`; it takes the unbound default, and the instance reads
// the call's value against `null`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function len<T>(f: () => T | null) {
  const t = f()
  if t == null { 7 } else { 99 }
}
// @@VALUE@@
() => null
// @@TYPE@@
() => null
// @@PROOF@@
print(len(v))
// @@WANT@@
7
// @@VALUE2@@
(): null => null
// @@TYPE2@@
() => null
// @@PROOF2@@
print(len(v) + 1)
// @@WANT2@@
8
