// A nullable literal union (`("a" | "b") | null`) delivered into a union that reaches it only
// through an alias arm: `U = A | i32`, the alias written inline (`A | i32`) as the second
// instance. D7043, D7120 and D7121 were this value at a module global, a declared return and a
// module-scope block's binding: the scratch frame for the widening was reserved only when the
// union spelled the literal inline, so the alias spelling built invalid wasm.
// The inline spelling is `nullable-litunion-inline-arm.matrix.vl`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type A = ("a" | "b") | null
type U = A | i32
const ga: ("a" | "b") | null = "a"
const gb: A = "b"
// @@VALUE@@
ga
// @@TYPE@@
U
// @@TEST@@
v == null
// @@HIT@@
print("none")
// @@MISS@@
print(v)
// @@WANT@@
a
// @@VALUE2@@
gb
// @@TYPE2@@
A | i32
// @@PROOF2@@
if v == null { print("none") } else { print(v) }
// @@WANT2@@
b
