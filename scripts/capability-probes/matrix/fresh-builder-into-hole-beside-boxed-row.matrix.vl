// D8684: a fresh-builder call handed to a hole that reads its field, while the program declares a
// record of the same field names that stores the field boxed (`J`). The builder's literal holds
// a bare `i32`, so its row is its own storage, not `J`'s.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type J = { f: i32 | null }
function mk() { { f: 4 } }
function rd(r) { return r.f + 1 }
const keepJ: J = { f: null }
const keepF: i32 = keepJ.f ?? 0
// @@VALUE@@
rd(mk())
// @@TYPE@@
i32
// @@WANT@@
5
// @@TEST@@
v == 5
// @@HIT@@
print(v + keepF)
// @@MISS@@
print(0)
