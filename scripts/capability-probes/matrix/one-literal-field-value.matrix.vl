// one-literal-union-rep (owner 2026-10-13) — a record whose field is typed at ONE string literal,
// delivered whole at every position. The inline spelling (`kind: "circle"`) and the alias
// spelling (`kind: KC`) both rep the field as the interned atom and reach one struct row, so a
// position that keys the record by a softened `string` field builds a second row and fails the
// cast (invalid wasm or a trap). The proof reads the field back through `+` and checks the payload.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type KC = "circle"
type C = { kind: "circle", r: i32 }
type Q = { kind: KC, r: i32 }
function mkC(n: i32): C { { kind: "circle", r: n } }
// @@VALUE@@
mkC(3)
// @@TYPE@@
Q
// @@TEST@@
v.r == 3
// @@HIT@@
print("w=" + v.kind + (if v.r == 3 { "3" } else { "?" }))
// @@MISS@@
print("miss")
// @@WANT@@
w = circle3
// @@VALUE2@@
mkC(4)
// @@TYPE2@@
C
// @@PROOF2@@
print("c=" + v.kind + (if v.r == 4 { "4" } else { "?" }))
// @@WANT2@@
c = circle4
