// A record whose field is a list of un-annotated functions, written whole as a value `if` or
// `match` whose tails are such records, the functions called at two types: each tail literal is
// joined into the written binding's set as a direct write is (D15390).
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function id1(a) { return a }
function id2(a) { return a }
function id3(a) { return a }
const go = [1].length > 0
// @@VALUE@@
{ f: [id1] }
// @@TYPE@@
{ f: ((a: f64) => f64)[] }
// @@PROOF@@
print(v.f[0](2) + v.f[0](2.5))
// @@WANT@@
4.5
// @@CELL_if_write@@
let r__A__ = __V__
r = if go { { f: [id2] } } else { { f: [id3] } }
print(r.f[0](2) + r.f[0](2.5))
// @@CELL_if_write_else_arm@@
let r__A__ = __V__
r = if !go { { f: [id2] } } else { { f: [id3] } }
print(r.f[0](2) + r.f[0](2.5))
// @@CELL_else_if_write@@
let r__A__ = __V__
const k = [1, 2].length
r = if k == 1 { { f: [id2] } } else if k == 2 { { f: [id3] } } else { { f: [id1] } }
print(r.f[0](2) + r.f[0](2.5))
// @@CELL_match_write@@
let r__A__ = __V__
const k = [1, 2].length
r = match k {
  1 => { f: [id2] }
  _ => { f: [id3] }
}
print(r.f[0](2) + r.f[0](2.5))
// @@CELL_if_write_one_literal_arm@@
let r__A__ = __V__
const q__A__ = { f: [id2] }
r = if go { q } else { { f: [id3] } }
print(r.f[0](2) + r.f[0](2.5))
// @@CELL_if_write_in_function@@
function go2() {
  let r__A__ = __V__
  r = if go { { f: [id2] } } else { { f: [id3] } }
  print(r.f[0](2) + r.f[0](2.5))
}
go2()
// @@CELL_if_write_two_elements@@
let r__A__ = __V__
r = if go { { f: [id2, id3] } } else { { f: [id3] } }
print(r.f[1](2) + r.f[0](2.5))
