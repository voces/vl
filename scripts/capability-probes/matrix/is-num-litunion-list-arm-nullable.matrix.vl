// D14041 — `v is K[]` over a `K[] | string | null` box: false on `null`, the `i32[]` tag else.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type K = 0 | 1
function mk(k: i32): K[] | string | null {
  if k == 0 { return null }
  if k == 1 { return [1] }
  return "s"
}
// @@VALUE@@
mk(1)
// @@TYPE@@
K[] | string | null
// @@TEST@@
v is K[]
// @@HIT@@
print(v[0] + 10)
// @@MISS@@
print(0)
// @@WANT@@
11
// @@VALUE2@@
mk(0)
// @@TYPE2@@
K[] | string | null
// @@PROOF2@@
if v is K[] { print(v.length) } else { print(9) }
// @@WANT2@@
9
