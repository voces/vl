// D3512 — arithmetic over a literal union whose integer members span two widths computes at the
// common width `i64` (owner ruling: literals adapt). The narrow member widens before the add, so
// `1 + 2147483647` is not an `i32` overflow; the wide member keeps its value.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type D = 9000000000 | 1
function pick(n: i32): D {
  if n > 0 { return 9000000000 }
  1
}
// @@VALUE@@
pick(0) + 2147483647
// @@TYPE@@
i64
// @@TEST@@
v > 2147483647
// @@HIT@@
print(v)
// @@MISS@@
print("miss")
// @@WANT@@
2147483648
// @@VALUE2@@
pick(1) - 1
// @@TYPE2@@
i64
// @@PROOF2@@
print(v)
// @@WANT2@@
8999999999
