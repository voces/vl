// D9911: a record literal whose field is a `??` over a declared type parameter pinned at a
// never-null `i32` is a `{ n: i32 }`, though its default is a float. `T` is left open, so the
// pin comes from the call. The proof divides, which prints `2` at `i32` and `2.5` at `f64`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __cqTake<T>(a: T) { return { n: a ?? 1.5 } }
const __cqPin: i32 = 5
// @@VALUE@@
__cqTake(__cqPin)
// @@TYPE@@
{ n: i32 }
// @@TEST@@
v.n > 0
// @@HIT@@
print(v.n / 2)
// @@MISS@@
print("miss")
// @@WANT@@
2
