// D15057: a value of another union, one of whose arms is wider than an arm of the destination
// union, delivered whole: the box is re-tagged at run time, the wider arm under the arm its row
// subtypes and every other member under its own tag. The second instance is the other member.
// The proof reads through a `UawPet` parameter, so the un-annotated face delivers it there too.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type UawA = { k: i32, legs: i32 }
type UawB = { s: string }
type UawPet = UawA | UawB
type UawD = { k: i32, legs: i32, purr: boolean }
function uawMk(c: boolean): UawD | UawB {
  if c { return { k: 1, legs: 4, purr: true } }
  return { s: "x" }
}
function uawLegs(p: UawPet): i32 {
  if p is UawA { return p.legs }
  -1
}
// @@VALUE@@
uawMk(true)
// @@TYPE@@
UawPet
// @@TEST@@
uawLegs(v) >= 0
// @@HIT@@
print(uawLegs(v) + 1)
// @@MISS@@
print("b")
// @@WANT@@
5
// @@VALUE2@@
uawMk(false)
// @@TYPE2@@
UawPet
// @@PROOF2@@
print(uawLegs(v))
// @@WANT2@@
-1
