// D1270 — an UN-ANNOTATED array literal whose ELEMENT is a nullable CONTAINER
// (`[f(0)]` where `f(): i32[] | null`) built the mono i32 list: `vl check` rc 0 then
// `expected i32, found (ref null $type)`. The annotated spelling runs at every position,
// so the matrix's un-annotated face is where the row lives — `array_element` above all,
// which is the only cell the close moved here.
//
// ONE ELEMENT REP, because the axis this template varies is the POSITION. The element rep
// is D1270's other axis and is graded by its own grid; the one rep still refusing there is
// a nullable STRUCT (D1340, closed), and `string | null` is the rep that always ran.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function f(n: i32): i32[] | null {
  if n == 0 { return [5] }
  return null
}
// @@VALUE@@
f(0)
// @@TYPE@@
i32[] | null
// @@TEST@@
v != null
// @@HIT@@
print(v[0])
// @@MISS@@
print(0)
// @@WANT@@
5
