// D9523, D3524: arithmetic and negation over a type parameter bound at a literal union whose
// members span two widths compute at `i64`, as the direct spelling does (D3512), and the result
// is that `i64`, not a member of the set.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type __LW = 1 | 2 | 5000000000
const __ww: __LW = 5000000000
function __mul<T>(x: T) { x * 3 }
function __neg<T>(x: T) { -x }
// @@VALUE@@
__mul(__ww)
// @@TYPE@@
i64
// @@TEST@@
v == 15000000000
// @@HIT@@
print(v)
// @@MISS@@
print("miss")
// @@WANT@@
15000000000
// @@VALUE2@@
__neg(__ww)
// @@TYPE2@@
i64
// @@PROOF2@@
print(v + 1)
// @@WANT2@@
-4999999999
