// A generic method (UFCS, `self` first) whose function-typed parameter's type parameter is bound
// only by the destination. Cells: a struct receiver, a list receiver, and a parameter the
// receiver binds.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function gid<A>(x: A): A { x }
function selm<A>(self: i32, f: (x: A) => A): (x: A) => A { f }
// @@VALUE@@
0.selm(gid)
// @@TYPE@@
(x: f64) => f64
// @@PROOF@@
print(v(1.5))
// @@WANT@@
1.5
// @@CELL_struct_receiver@@
// want: 1.5
type Hold = { n: i32 }
function pick<A>(self: Hold, f: (x: A) => A): (x: A) => A { f }
const h: Hold = { n: 1 }
const k: (x: f64) => f64 = h.pick(gid)
print(k(1.5))
// @@CELL_list_receiver@@
// want: 1.5
function lpick<A, E>(self: E[], f: (x: A) => A): (x: A) => A { f }
const k: (x: f64) => f64 = [1, 2].lpick(gid)
print(k(1.5))
// @@CELL_method_of_receiver_param@@
// want: 3
function mapr<A>(self: A[], f: (x: A) => A): A[] { const o: A[] = []; for x in self { o.push(f(x)) } o }
const k: i32[] = [3].mapr(gid)
print(k[0])
