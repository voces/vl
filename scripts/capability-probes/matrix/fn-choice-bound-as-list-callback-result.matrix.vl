// A `const` bound to an `if` choosing between two generic functions, read as a `.map` callback
// or handed to a generic higher-order parameter (D9080). The binding is the `if` it names, so
// each arm is instanced at the element or argument type that pins the binding.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function idg<T>(t: T): T { return t }
function kg<T>(t: T): T { return t + t }
function app<T>(g: (x: T) => T, v: T): T { return g(v) }
const on = [1].length > 5
const h = if on { idg } else { kg }
// @@VALUE@@
[1.5].map(h)
// @@TYPE@@
f64[]
// @@PROOF@@
print(v[0] * 2.0)
// @@WANT@@
6
// @@VALUE2@@
app(h, 1.25)
// @@TYPE2@@
f64
// @@PROOF2@@
print(v * 2.0)
// @@WANT2@@
5
