// A record a second maker returns, holding the same un-annotated function as a first maker's
// record whose field is written another function, delivered at every position and its field
// called directly (D15274's sibling literal). The two sets are decided together.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __id0(a) { return a * 10 }
function __idA(a) { return a + 1 }
function __mk() { return { f: __idA } }
function __mk2() { return { f: __idA } }
const __r = __mk()
__r.f = __id0
// @@VALUE@@
__mk2()
// @@TYPE@@
{ f: (a: i32) => i32 }
// @@PROOF@@
print("\{__r.f(2)},\{__r.f(2.5)},\{v.f(7)}")
// @@WANT@@
20,25,8
// @@SKIP@@
is_in_if: the value is a struct, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
