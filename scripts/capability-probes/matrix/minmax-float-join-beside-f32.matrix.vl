// D16497 — a `min`/`max` over a typed `f32` and a value join of float literals, or a float tree
// over one, computes at `f32`, as the binary operators beside an `f32` do (ruling 4.3).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __no(): boolean { return false }
const __fm: f32 = 0.75
// @@VALUE@@
min(__fm, (if __no() { 0.1 } else { 0.7 }))
// @@TYPE@@
f32
// @@PROOF@@
print(v)
// @@WANT@@
0.699999988079071
// @@VALUE2@@
max(__fm, 0.5 * (if __no() { 0.1 } else { 1.7 }))
// @@TYPE2@@
f32
// @@PROOF2@@
print(v)
// @@WANT2@@
0.8500000238418579
