// D2567 — the factory spelling: a closure over `string | i32 | null` handed back by a call and
// called at once (`mk()(7)`), whose `$fnsig` keys the result as the box.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function mk() { return (p: string | i32 | null) => p }
// @@VALUE@@
mk()(7)
// @@TYPE@@
string | i32 | null
// @@PROOF@@
if v is i32 { print(v + 1) } else { print(0) }
// @@WANT@@
8
// @@TEST@@
v != null
// @@HIT@@
print(8)
// @@MISS@@
print(0)
