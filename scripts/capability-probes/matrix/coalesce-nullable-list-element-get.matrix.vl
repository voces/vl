// D1829 — the `.get(i)` spelling of D1828's read. The element is the same `{tag, anyref}`
// value box, but a `.get` is a CALL, and the `??` call-stash arm claimed it by syntax before
// the element arm could ask about its rep — check-clean invalid wasm at every delivery.
//
// The twin of `coalesce-nullable-list-element`, which carries the subscript spelling: the two
// must grade alike, or one capability is wired at one spelling again.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
const elems: (i32 | null)[] = [42, null]
// @@VALUE@@
elems.get(0) ?? 0
// @@TYPE@@
i32
// @@FALLBACK@@
0
// @@PROOF@@
print(v)
// @@WANT@@
42
// @@VALUE2@@
elems.get(9) ?? 42
// @@TYPE2@@
i32
// @@PROOF2@@
print(v)
// @@WANT2@@
42
