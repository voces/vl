// A `??` over a literal union's `K | null` niche that a call yields, with a default of another kind,
// at every delivery position: the join is a value union (`K | i32`). The operand counts its
// evaluations, and each cell prints the count, so a cell proves the call runs once (a built-in
// position may write the value twice, as `local_assign` does). The cells take each member, null,
// a boolean and a float default, defaults equal to the members' atom ids, chains of calls, an
// annotated binding and a re-readable control (D17182).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type __K = "a" | "b"
let __n = 0
function __gk(which: i32): __K | null {
  __n = __n + 1
  if which == 0 { return null }
  if which == 1 { return "a" }
  return "b"
}
// @@VALUE@@
(__gk(2) ?? 1)
// @@TYPE@@
__K | i32
// @@PROOF@@
print(v)
// @@WANT@@
b
// @@CELL_member_a@@
// want: a then 1
function f() {
  print(__gk(1) ?? 1)
  print(__n)
}
f()
// @@CELL_null_default@@
// want: 1 then 1
function f() {
  print(__gk(0) ?? 1)
  print(__n)
}
f()
// @@CELL_null_default_module@@
// want: 7 then 1
print(__gk(0) ?? 7)
print(__n)
// @@CELL_default_equals_atom_ids@@
// want: a then b then 0 then 1 then 4
function f() {
  print(__gk(1) ?? 0)
  print(__gk(2) ?? 1)
  print(__gk(0) ?? 0)
  print(__gk(0) ?? 1)
  print(__n)
}
f()
// @@CELL_boolean_default@@
// want: b then false then 2
function f() {
  print(__gk(2) ?? false)
  print(__gk(0) ?? false)
  print(__n)
}
f()
// @@CELL_float_default@@
// want: a then 2.5 then 2
function f() {
  print(__gk(1) ?? 2.5)
  print(__gk(0) ?? 2.5)
  print(__n)
}
f()
// @@CELL_chain_of_calls@@
// want: a then 2 then 2 then 4
function f() {
  print(__gk(0) ?? __gk(1) ?? 2)
  print(__n)
  print(__gk(0) ?? __gk(0) ?? 2)
  print(__n)
}
f()
// @@CELL_chain_of_calls_module@@
// want: b then 1 then b
print(__gk(2) ?? __gk(1) ?? 9)
print(__n)
const __m = __gk(0) ?? __gk(2) ?? 9
print(__m)
// @@CELL_annotated_binding@@
// want: a then 1
function f() {
  const r: __K | i32 = __gk(1) ?? 0
  print(r)
  print(__n)
}
f()
// @@CELL_reread_control@@
// want: b then 1
function f() {
  const x = __gk(2)
  print(x ?? 1)
  print(__n)
}
f()
