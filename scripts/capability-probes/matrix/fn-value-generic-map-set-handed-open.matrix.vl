// A generic function delivered to each position and called beside an un-annotated `Map()` handed
// to an un-annotated function storing the same generic by `.set`, its entry read back by `.get`
// and called at TWO types (D9591).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function id<T>(x: T): T { x }
function __fill(mm) { mm.set("k", id) }
// @@VALUE@@
id
// @@TYPE@@
(x: i32) => i32
// @@PROOF@@
const __m = Map()
__fill(__m)
const __r = __m.get("k")
if __r != null {
  const __s = __r("abc")
  print(__s.length + __r(2) + v(1))
}
// @@WANT@@
6
