// A binding holding an un-annotated function handed to `.map` (D8981): a `const` lambda, and a
// once-bound `let` naming a declared one. The callback's result is its body's at the element, so
// `[3].map(half)` is `f64[]`; the function named directly is
// `hole-fn-as-list-callback-result.matrix.vl` and cannot see the defect.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
const half = (a) => a / 2.0
function inc0(a) { return a + 1 }
let inc = inc0
// @@VALUE@@
[3].map(half)
// @@TYPE@@
f64[]
// @@PROOF@@
print(v[0] * 2.0)
// @@WANT@@
3
// @@VALUE2@@
[3].map(inc)
// @@TYPE2@@
i32[]
// @@PROOF2@@
print(v[0] + v.length)
// @@WANT2@@
5
