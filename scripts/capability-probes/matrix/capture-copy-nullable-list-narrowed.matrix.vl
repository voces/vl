// D2606 — the value is a copy of a `i32[] | null` binding read under a GUARD. A closure capturing an
// un-annotated copy of it typed its env field from the copy's initializer in a frame whose
// locals are not registered, so a function-scope capture fell to the `i32` default.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function __src(n: i32): i32[] | null { if n == 0 { return null } return [4, 5] }
// @@SETUP@@
const __x: i32[] | null = __src(1)
// @@GUARD@@
__x != null
// @@FALLBACK@@
[4, 5]
// @@VALUE@@
__x
// @@TYPE@@
i32[]
// @@PROOF@@
print(v[1])
// @@WANT@@
5
