// D9680: a declared type parameter's value beside its arithmetic with a float literal, in one
// list literal, is an `f64` list at an `i32` pin, as the un-annotated parameter's is. `T` is
// left open: the pin comes from the call.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __glw<T>(x: T) {
  const xs = [x, x + 1.5]
  return xs[1]
}
// @@VALUE@@
__glw(2)
// @@TYPE@@
f64
// @@TEST@@
v == 3.5
// @@HIT@@
print(v * 2)
// @@MISS@@
print("miss")
// @@WANT@@
7
