// D2590 — a value union narrowed by elimination to `string | null`, delivered where that type
// is wanted: the read converts the box to the nullable string.
// @@PRELUDE@@
function pickS(n: i32): i32 | string | null {
  if n == 0 { return 4 }
  if n == 1 { return "s" }
  null
}
// @@SETUP@@
const x = pickS(1)
// @@GUARD@@
!(x is i32)
// @@FALLBACK@@
null
// @@VALUE@@
x
// @@TYPE@@
string | null
// @@TEST@@
v == null
// @@HIT@@
print("null")
// @@MISS@@
print((v ?? "N") + "!")
// @@WANT@@
s!
