// D8281: a value union holding inline string literals and `null`, read under `!= null` and handed
// to a generic identity whose type parameter stays open. The instance is pinned at the union
// without its `null`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __g<T>(x: T): T { x }
// @@SETUP@@
const __r: i32 | "a" | "b" | null = "b"
// @@GUARD@@
__r != null
// @@FALLBACK@@
0
// @@VALUE@@
__g(__r)
// @@TYPE@@
i32 | "a" | "b"
// @@WANT@@
b
// @@TEST@@
v is i32
// @@HIT@@
print(v + 1)
// @@MISS@@
print(v)
// @@SKIP@@
global_assign: the un-annotated global is seeded at the FALLBACK `0`, an `i32`, so the write is a check error by design
