// D9822: a named function whose parameter is a nullable map, delivered where a function of
// that parameter is expected, and called with a map and with `null`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function g(p: {[string]: i32} | null): i32 {
  if p == null { return 5 }
  p.length + (p["a"] ?? 0)
}
function mk(): {[string]: i32} {
  const m: {[string]: i32} = Map()
  m["a"] = 3
  m
}
// @@VALUE@@
g
// @@TYPE@@
(p: {[string]: i32} | null) => i32
// @@PROOF@@
print(v(mk()) * 10 + v(null))
// @@WANT@@
45
