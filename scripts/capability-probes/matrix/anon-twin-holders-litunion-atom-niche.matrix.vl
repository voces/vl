// D1715 — two anonymous holders sharing the field name `xs`, one over a bare literal-union
// atom (code 0) and one over its `K | null` niche (code 30). Both slots are an i32, so the
// codes look interchangeable; they are not, and neither is a box.
//
// The prelude holder is the code-0 one and nothing calls it: `collectAnonShapes` walks the
// whole arena, so its row is minted and available to collide with wherever the value under
// test is delivered. Removing it turns every cell green for the wrong reason.
//
// The proof prints the MEMBER, not a number — an atom that lands on the wrong row loses the
// member set its id indexes, so the failure is a wrong VALUE or a widening refusal rather
// than a type error.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type K = "a" | "b"
function plain(): K { return "a" }
function nul1(): K | null { return "b" }
function nul2(): K | null { return "a" }
function firstHolder() {
  const first = { xs: plain() }
  print(first.xs)
}
// @@VALUE@@
{ xs: nul1() }
// @@TYPE@@
{ xs: K | null }
// @@PROOF@@
const l = v.xs
if l != null { print(l) } else { print("none") }
// @@WANT@@
b
// @@VALUE2@@
{ xs: nul2() }
// @@TYPE2@@
{ xs: K | null }
// @@PROOF2@@
const l2 = v.xs
if l2 != null { print(l2) } else { print("none") }
// @@WANT2@@
a
// @@SKIP@@
is_in_if: the value is a struct, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
