// D15090: `==` between a nullable `f32` and an `f64` compares the values at `f64`: the box's
// `f32` arm is widened, a null is no number. Refused at check before. The second instance is
// the null.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function nawF(v: f32, n: boolean): f32 | null {
  if n { return null }
  return v
}
function nawD(v: f64): f64 {
  return v
}
const nawHalf: f64 = nawD(1.5)
const nawOther: f64 = nawD(2.5)
// @@VALUE@@
nawF(1.5 as f32, false)
// @@TYPE@@
f32 | null
// @@TEST@@
v == nawHalf && v != nawOther
// @@HIT@@
print("value")
// @@MISS@@
print("other")
// @@WANT@@
value
// @@VALUE2@@
nawF(1.5 as f32, true)
// @@TYPE2@@
f32 | null
// @@PROOF2@@
print("\{v == nawHalf} \{v != nawHalf}")
// @@WANT2@@
false true
