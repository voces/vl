// A maker joining two record literals, one holding a record in a field and one `null`, whose
// result is the union of the two records, delivered at a declared record whose field is that
// record or `null`: every literal is built at the declared record (D15719; unfiled: D15719,
// filed in #7242).
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type J = { a: i32 }
type K = { j: J | null }
const go = [1].length > 0
function mk(b: boolean) { if b { { j: { a: 1 } } } else { { j: null } } }
// @@VALUE@@
mk(go)
// @@TYPE@@
K
// @@PROOF@@
print(v.j?.a ?? 0)
// @@WANT@@
1
// @@VALUE2@@
mk(!go)
// @@PROOF2@@
print(v.j?.a ?? 5)
// @@WANT2@@
5
// @@SKIP@@
is_in_if: the delivery at the declared record is the capability, not a discrimination
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
