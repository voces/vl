// D8680: a record literal a hole's body returns, built from the hole, while the program declares
// a record of the same field names that stores the field boxed (`J`). The literal's field is the
// hole's `i32`, so its row is its own storage, not `J`'s.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type J = { f: i32 | null }
function bump(n) { return { f: n + 1 } }
const keepJ: J = { f: null }
const keepF: i32 = keepJ.f ?? 0
// @@VALUE@@
bump(4)
// @@TYPE@@
{ f: i32 }
// @@WANT@@
5
// @@TEST@@
v.f == 5
// @@HIT@@
print(v.f + keepF)
// @@MISS@@
print(0)
