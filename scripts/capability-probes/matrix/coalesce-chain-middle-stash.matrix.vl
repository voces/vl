// D17183: a `??` chain over a literal union's `K | null` whose middle operand is written once into
// the coalesce stash (a field read off a call, an `if`), not re-read. Every operand logs: each runs
// at most once, left to right, the default only on the null path. A call middle, a field of a
// plain read and the read bound to a `const` first are the controls.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type K = "a" | "b"
type B = { v: K | null }
let log = ""
function boxK(x: K | null): B { return { v: x } }
function mkK(n: i32): K | null {
  log = log + "m"
  return if n == 1 { "b" } else { null }
}
function nul(): K | null {
  log = log + "r"
  return null
}
function dflt(): K {
  log = log + "d"
  return "a"
}
function one(): boolean {
  log = log + "o"
  return true
}
// @@VALUE@@
nul() ?? boxK(mkK(1)).v ?? dflt()
// @@TYPE@@
K
// @@PROOF@@
print(v)
print(log == "rm" || log == "rmrm")
// @@TEST@@
v == "b"
// @@HIT@@
print(v)
print(log == "rm" || log == "rmrm")
// @@MISS@@
print("miss")
// @@WANT@@
b then true
// @@CELL_default_reached@@
// want: a then rmd
print(nul() ?? boxK(mkK(0)).v ?? dflt())
print(log)
// @@CELL_if_middle@@
// want: b then rom
print(nul() ?? (if one() { mkK(1) } else { null }) ?? dflt())
print(log)
// @@CELL_if_middle_default@@
// want: a then romd
print(nul() ?? (if one() { mkK(0) } else { null }) ?? dflt())
print(log)
// @@CELL_four_links@@
// want: b then rrm
print(nul() ?? nul() ?? boxK(mkK(1)).v ?? dflt())
print(log)
// @@CELL_four_links_default@@
// want: a then rrmd
print(nul() ?? nul() ?? boxK(mkK(0)).v ?? dflt())
print(log)
// @@CELL_in_function@@
// want: b then a then rmrmd
function k(n: i32) { print(nul() ?? boxK(mkK(n)).v ?? dflt()) }
k(1)
k(0)
print(log)
// @@CELL_generic_box@@
// want: b then a then rmrmd
type Box<T> = { v: T | null }
function bx<T>(x: T | null): Box<T> { return { v: x } }
function g(n: i32) { print(nul() ?? bx(mkK(n)).v ?? dflt()) }
g(1)
g(0)
print(log)
// @@CELL_call_middle_control@@
// want: b then rm
print(nul() ?? mkK(1) ?? dflt())
print(log)
// @@CELL_plain_field_control@@
// want: b then mr
const bb = boxK(mkK(1))
print(nul() ?? bb.v ?? dflt())
print(log)
// @@CELL_bound_control@@
// want: b then mr
const mid = boxK(mkK(1)).v
print(nul() ?? mid ?? dflt())
print(log)
