// A `filter` or `slice` result of a list a kept maker's build stores at a wider record `J`, held in
// a record or list literal, delivered at every position. The literal's part holds the receiver's
// own elements, so it is laid out at the receiver's build, as the receiver itself is (D16765).
// @@PRELUDE@@
type J = { f: i32 | null }
function mk2() { return { f: null } }
const dA: J = mk2()
const src = [mk2()]
// @@VALUE@@
{ g: src.filter((y) => y.f == null) }
// @@TYPE@@
{ g: { f: null }[] }
// @@PROOF@@
print(v.g[0].f)
// @@WANT@@
null
// @@CELL_receiver_in_record@@
// want: null
const w = { g: src }
print(w.g[0].f)
// @@CELL_receiver_in_list@@
// want: null
const w = [src]
print(w[0][0].f)
// @@CELL_filter_in_record@@
// want: null
const w = { g: src.filter((y) => y.f == null) }
print(w.g[0].f)
// @@CELL_slice_in_record@@
// want: null
const w = { g: src.slice(0, 1) }
print(w.g[0].f)
// @@CELL_filter_in_list@@
// want: null
const w = [src.filter((y) => y.f == null)]
print(w[0][0].f)
// @@CELL_filter_in_nested_record@@
// want: null
const w = { h: { g: src.filter((y) => y.f == null) } }
print(w.h.g[0].f)
// @@CELL_filter_in_record_returned@@
// want: null
function mk() { return { g: src.filter((y) => y.f == null) } }
print(mk().g[0].f)
// @@CELL_filter_in_record_argument@@
// want: null
function show(r) { print(r.g[0].f) }
show({ g: src.filter((y) => y.f == null) })
