// D9381: a generic over a function-typed parameter, returned from an un-annotated function and
// delivered at a function type. The flow pins that parameter by a wasm signature only, so the
// instance is spelled from the closed parameter type the pin was taken at.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type F = (x: i32) => i32
function app<T>(f: (x: T) => T, x: T): T { f(x) }
function call<T>(f: () => T): T { f() }
function deliver() { return app }
function deliver2() { return call }
// @@VALUE@@
deliver()
// @@TYPE@@
(f: F, x: i32) => i32
// @@PROOF@@
print(v((n) => n * 2, 21))
// @@WANT@@
42
// @@VALUE2@@
deliver2()
// @@TYPE2@@
(f: () => i32) => i32
// @@PROOF2@@
print(v(() => 7))
// @@WANT2@@
7
// @@SKIP@@
is_in_if: the value is a function, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
