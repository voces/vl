// D10140's open twin: the union of maps is joined by an un-annotated function from its hole
// parameter, then read by index and by `.get` at every delivery position.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __pick(p, c: boolean) {
  const s: {[string]: string} = Map()
  s["k"] = p
  const t: {[string]: boolean} = Map()
  t["k"] = true
  if c { s } else { t }
}
function __show(r: string | boolean | null): string {
  if r is null { return "null" }
  if r is string { return r }
  "b"
}
// @@VALUE@@
__pick("x", true)
// @@TYPE@@
{[string]: string} | {[string]: boolean}
// @@TEST@@
v.has("k")
// @@HIT@@
print(__show(v["k"]) + __show(v.get("zz")))
// @@MISS@@
print("wrong")
// @@WANT@@
xnull
