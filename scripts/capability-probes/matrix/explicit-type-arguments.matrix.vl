// A15 item 3 — a call with explicit type arguments, graded at every delivery position in
// both faces. The written type is WIDER than the argument (`i32 | string` over `3`) or of
// another width (`f64` over `3`), so a delivery that used the inferred binding prints wrong.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function id<T>(x: T): T { x }
// @@VALUE@@
id<i32 | string>(3)
// @@TYPE@@
i32 | string
// @@TEST@@
v is i32
// @@HIT@@
print(v + 1)
// @@MISS@@
print(0)
// @@WANT@@
4
// @@VALUE2@@
id<f64>(3)
// @@TYPE2@@
f64
// @@PROOF2@@
print(v / 2.0)
// @@WANT2@@
1.5
