// D2383's niche. A `boolean | null` is the i32 niche whose null is the value 2, and a `??`
// over it with a default of another type joins to the union box: the default is boxed under
// its own arm, a present 0/1 under the boolean arm.
//
// The first line is the control: a FITTING boolean default keeps the i32 niche's own lowering.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@SKIP@@
map_value: the builder guards its read with `!= null`, and this template's operand is null by
design so the DEFAULT is what each line proves — the guarded body never runs
// @@PRELUDE@@
type A = { r: i32 }
function st(): A { return { r: 8 } }
function mkB(): boolean | null { return null }
// @@VALUE@@
mkB()
// @@TYPE@@
boolean | null
// @@PROOF@@
const c = v ?? true
print(c)
const f = v ?? st()
if f is A { print(f.r) } else { print(0) }
const j = v ?? 7
if j is boolean { print(0) } else { print(j) }
const s = v ?? "d"
if s is string { print(s) } else { print(0) }
// @@WANT@@
true then 8 then 7 then d
