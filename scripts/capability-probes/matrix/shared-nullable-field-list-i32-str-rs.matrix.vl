// A shared field read through an un-narrowed union of records (D16049), where the field is
// an `i32[] | null` in one member, a `string[] | null` in the other. The union is spelled `R | S`. The first
// instance reads `R`'s value, the second `S`'s `null`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type R = { x: i32[] | null, s: string }
type S = { x: string[] | null, s: string, extra: i32 }
const r1: R = { x: [4, 5], s: "r" }
const s1: S = { x: null, s: "s", extra: 3 }
const u1: R | S = r1
const u2: R | S = s1
// @@VALUE@@
u1.x
// @@TYPE@@
i32[] | string[] | null
// @@WANT@@
5
// @@TEST@@
v == null
// @@HIT@@
print("null")
// @@MISS@@
if v is i32[] { print(v[1]) } else { print("other") }
// @@VALUE2@@
u2.x
// @@TYPE2@@
i32[] | string[] | null
// @@PROOF2@@
if v == null { print("null") } else { print("value") }
// @@WANT2@@
null
// @@CELL_param_receiver@@
// want: 5
function rd(u: R | S) {
  const y __A__ = u.x
  if y == null { print("null") } else { if y is i32[] { print(y[1]) } else { print("other") } }
}
rd(r1)
// @@CELL_param_receiver_null@@
// want: null
function rd(u: R | S) {
  const y __A__ = u.x
  if y == null { print("null") } else { print("value") }
}
rd(s1)
