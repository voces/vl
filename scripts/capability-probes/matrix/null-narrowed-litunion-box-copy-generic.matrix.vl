// D8180 at an open `T`: the `T | AB | null` box comes out of a generic body, is read under
// `!= null` and delivered, so no annotation names the set the destination binds.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type __AB = "a" | "b"
function __pick<T>(x: T | __AB | null): T | __AB | null { return x }
// @@SETUP@@
const __r = __pick<i32>("b")
// @@GUARD@@
__r != null
// @@FALLBACK@@
0
// @@VALUE@@
__r
// @@TYPE@@
i32 | __AB
// @@WANT@@
b
// @@TEST@@
v is i32
// @@HIT@@
print(v + 1)
// @@MISS@@
print(v)
// @@SKIP@@
global_assign: the un-annotated global is seeded at the FALLBACK `0`, an `i32`, so the write is a check error by design
