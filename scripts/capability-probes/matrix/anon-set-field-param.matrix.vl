// D3123 (plumb PL-075) — an INFERRED record whose field is fed by a binding, not a `Map()`
// call: a set parameter. The field-code ladder coded a map only off a call and its spellability gate
// declines a `TyMap`, so the literal minted no row and its function's return had no shape.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function mkSet(k: i32): Set<i32> {
  const s: Set<i32> = Set()
  s.add(k)
  s.add(k + 1)
  s
}
function wrapS(s: Set<i32>) { { seen: s } }
// @@VALUE@@
wrapS(mkSet(7))
// @@TYPE@@
{ seen: Set<i32> }
// @@PROOF@@
print(v.seen.has(8) && !v.seen.has(9))
// @@WANT@@
true
// @@VALUE2@@
wrapS(mkSet(2))
// @@TYPE2@@
{ seen: Set<i32> }
// @@PROOF2@@
print(v.seen.has(3) && v.seen.length == 2)
// @@WANT2@@
true
// @@SKIP@@
is_in_if: the value is a struct, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
