// #8407 — a narrowing cast is no destination for its operand: a join with a radix tail wider
// than 32 bits widens to `i64` (ruling 4.3), and `as? u8` then misses, rather than pinning
// the tail at 32 bits and refusing it. VALUE2 is the `as? i32` face.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function flag(): boolean { return 1 == 2 }
// @@VALUE@@
(if flag() { 0 } else { 0x1FFFFFFFF }) as? u8
// @@TYPE@@
i32 | null
// @@PROOF@@
print(v ?? -7)
// @@WANT@@
-7
// @@TEST@@
v == null
// @@HIT@@
print(-7)
// @@MISS@@
print(0)
// @@VALUE2@@
(if flag() { 0 } else { 0x1FFFFFFFF }) as? i32
// @@TYPE2@@
i32 | null
// @@PROOF2@@
print(v ?? -7)
// @@WANT2@@
-7
