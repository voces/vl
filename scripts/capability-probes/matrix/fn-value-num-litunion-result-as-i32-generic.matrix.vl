// D9382's generic twin: the callee's numeric literal-union result is a type parameter's binding,
// pinned at `N` by the destination's parameter, and delivered as a function returning `i32`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type N = 1 | 2
function same<T>(k: T): T { k }
function same2<T>(k: T): T { k }
// @@VALUE@@
same
// @@TYPE@@
(k: N) => i32
// @@PROOF@@
print(v(2) + 40)
// @@WANT@@
42
// @@VALUE2@@
same2
// @@TYPE2@@
(k: N) => i32
// @@PROOF2@@
print(v(1) * 10)
// @@WANT2@@
10
// @@SKIP@@
is_in_if: the value is a function, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
