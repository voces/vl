// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __id<T>(x: T): T { return x }
function __half<T>(x: T): f64 { return x / 2.0 }
function __put(o) { o.fs[0] = __half }
// @@SETUP@@
const __rec = { fs: [__id] }
__put(__rec)
// @@VALUE@@
__rec
// @@TYPE@@
{ fs: readonly ((x: i32) => i32 | f64)[] }
// @@PROOF@@
print(v.fs[0](3))
// @@WANT@@
