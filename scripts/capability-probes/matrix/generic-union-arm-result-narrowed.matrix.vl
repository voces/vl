// D10522 — the value is a read of a module binding set, un-annotated, from a generic call whose
// `T | string` return binds `T` to a union, NARROWED to its `i32` arm. The call's recorded type
// keeps the bound union nested, which the box-name resolution declined, so the narrowed read
// handed its consumer the box where the `i32` belongs.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __gf<T>(u: T): T | string { u }
const __s: f64 | i32 = 3
const __x = __gf(__s)
// @@GUARD@@
__x is i32
// @@VALUE@@
__x
// @@TYPE@@
i32
// @@FALLBACK@@
3
// @@PROOF@@
print(v + 1)
// @@WANT@@
4
