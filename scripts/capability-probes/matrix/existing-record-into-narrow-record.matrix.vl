// An existing record of a wider shape (`A`, declared and annotated) delivered where a narrower
// record (`Pos`) is declared: specialized per concrete record, with no copy (owner ruling, DECISIONS
// "Width subtyping of an existing record"). Writes through the narrow handle read back through `a`.
// A slot holding two concrete records is refused by the one-layout contract.
// @@PRELUDE@@
type Pos = { x: f64, y: f64 }
type A = { k: i32, x: f64, y: f64 }
type B = { s: string, x: f64, y: f64 }
const a: A = { k: 7, x: 2.0, y: 3.0 }
const b: B = { s: "q", x: 10.0, y: 30.0 }
// @@VALUE@@
a
// @@TYPE@@
Pos
// @@PROOF@@
print(v.x)
// @@WANT@@
2
// @@SKIP@@
is_in_if: the value is a record, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
map_value: a map's value slot is fixed at its declared record, owed by the one-layout contract (cell owed_map_value)
map_set: same (cell owed_map_set)
array_push: an empty list's storage is fixed at its annotation, owed by the one-layout contract (cell owed_array_push)
// @@CELL_param_write_back@@
// want: 3
function mv(p: Pos) { p.x = p.x + 1.0 }
mv(__V__)
print(a.x)
// @@CELL_two_params_two_shapes@@
// want: -8
function d(p: Pos, q: Pos): f64 { p.x - q.x }
print(d(__V__, b))
// @@CELL_two_params_write_both@@
// want: 14
function w(p: Pos, q: Pos) {
  p.y = p.y + 1.0
  q.y = q.y + 2.0
}
w(__V__, b)
print(a.y + b.y - 22.0)
// @@CELL_nullable_param@@
// want: 3
function mvn(p: Pos | null) { if p != null { p.x = p.x + 1.0 } }
mvn(__V__)
print(a.x)
// @@CELL_list_param@@
// want: 3
function mvl(ps: Pos[]) { ps[0].x = ps[0].x + 1.0 }
mvl([__V__])
print(a.x)
// @@CELL_recursion_swap@@
// want: 5
function ping(p: Pos, q: Pos, n: i32) {
  if n > 0 {
    p.x = p.x + 1.0
    ping(q, p, n - 1)
  }
}
ping(__V__, b, 5)
print(a.x)
// @@CELL_binding_write_back@@
// want: 5
const n: Pos = __V__
n.x = 5.0
print(a.x)
// @@CELL_return_narrow@@
// want: 2
function pick(): Pos { __V__ }
print(pick().x)
// @@CELL_assign_one_shape@@
// want: 9
let s: Pos = __V__
s = __V__
s.x = 9.0
print(a.x)
// @@CELL_assign_literal_then_record@@
// owed: record layout
let s2: Pos = { x: 0.0, y: 0.0 }
s2 = __V__
print(s2.x)
// @@CELL_owed_map_value@@
// owed: record layout
const om: { [string]: Pos } = Map()
om["k"] = __V__
const omv = om["k"]
if omv != null { print(omv.x) }
// @@CELL_owed_map_set@@
// owed: record layout
const os: { [string]: Pos } = Map()
os.set("k", __V__)
const osv = os.get("k")
if osv != null { print(osv.x) }
// @@CELL_owed_array_push@@
// owed-annotated: record layout
const op__LA__ = []
op.push(__V__)
print(op[0].x)
// @@CELL_slot_feeds_join@@
// owed: record layout
const jn: Pos = __V__
const js = [jn, b]
print(js[0].x)
// @@CELL_mixed_slot@@
// owed: record layout
let m: Pos = __V__
m = b
print(m.x)
// @@CELL_mixed_list@@
// owed: record layout
const ms: Pos[] = [__V__, b]
print(ms[0].x)
// @@CELL_owed_existing_field_write@@
// owed: record layout
const ew: { f: Pos } = { f: { x: 1.0, y: 1.0 } }
ew.f = __V__
print(ew.f.x)
// @@CELL_owed_existing_element_write@@
// owed: record layout
const ee: Pos[] = [{ x: 1.0, y: 1.0 }]
ee[0] = __V__
print(ee[0].x)
