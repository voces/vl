// D4601 — a record literal that leaves out a tagged arm's nullable field (`{ kind: "a" }` into
// `{ kind: "a", q: i32 | null } | { kind: "b" }`). It is the arm with `q` unset, not the
// narrower arm its written field names also fit.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type U = { kind: "a", q: i32 | null } | { kind: "b" }
// @@VALUE@@
{ kind: "a" }
// @@TYPE@@
U
// @@TEST@@
v.kind == "a"
// @@HIT@@
print(v.q == null)
// @@MISS@@
print("miss")
// @@WANT@@
true
