// D8820: a null `string | i32 | null` handed from every position to a generic whose `T` stays
// open, written into a record field declared at that union. The pin decides whether the field
// is null, so the body's null test and `??` read it at the pin rather than folding.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type TvwR = { s: string | i32 | null }
function mkv(): string | i32 | null { null }
function mkv2(): string | i32 | null { 4 }
function __tvw<T>(x: T): string {
  const r: TvwR = { s: 1 }
  r.s = x
  const d = r.s ?? "n"
  if r.s == null && d == "n" { return "null n" }
  "set"
}
// @@VALUE@@
mkv()
// @@TYPE@@
string | i32 | null
// @@WANT@@
null n
// @@TEST@@
__tvw(v) == "null n"
// @@HIT@@
print(__tvw(v))
// @@MISS@@
print("miss")
// @@VALUE2@@
mkv2()
// @@TYPE2@@
string | i32 | null
// @@PROOF2@@
print(__tvw(v))
// @@WANT2@@
set
