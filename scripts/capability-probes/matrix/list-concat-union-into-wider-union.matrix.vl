// A list `+` of a `(string | i32 | f64)[]` and a `(string | i32)[]`: both are union-box lists,
// and the narrower one's boxes are already boxes of the wider union, so they concat at the wider
// row (D4860), at every position, both faces. VALUE2 puts the narrower operand on the LEFT.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
const wa: (string | i32 | f64)[] = ["p", 2.5]
const na: (string | i32)[] = [1]
// @@VALUE@@
wa + na
// @@TYPE@@
(string | i32 | f64)[]
// @@PROOF@@
const e = v[2]
if e is i32 { print("\{e + v.length}") } else { print("miss") }
// @@WANT@@
4
// @@VALUE2@@
na + wa
// @@TYPE2@@
(string | i32 | f64)[]
// @@PROOF2@@
const e = v[0]
const f = v[2]
if e is i32 && f is f64 { print("\{e + v.length}\{f}") } else { print("miss") }
// @@WANT2@@
42.5
// @@SKIP@@
is_in_if: the value is a list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
