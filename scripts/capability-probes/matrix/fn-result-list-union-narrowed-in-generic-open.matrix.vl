// The open twin of fn-result-list-union-narrowed-in-generic: the function value is a generic's
// own `() => V[] | i32` result, so its element type is bound by inference at the maker's call.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function mkG<V>(x: V): () => V[] | i32 { (): V[] | i32 => [x, x] }
function len<T>(f: () => T[] | i32) {
  const t = f()
  if t is i32 { t } else { t.length }
}
// @@VALUE@@
mkG("q")
// @@TYPE@@
() => string[] | i32
// @@PROOF@@
print(len(v))
// @@WANT@@
2
// @@VALUE2@@
mkG(1.5)
// @@TYPE2@@
() => f64[] | i32
// @@PROOF2@@
print(len(v))
// @@WANT2@@
2
