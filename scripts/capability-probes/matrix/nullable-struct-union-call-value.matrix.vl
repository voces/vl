// D5103 — the nullable of a plain record union, delivered as `U | null` from a call: the
// value is the union box with a null member, so every position must store that box, the
// un-annotated face included, which takes the element and slot reps from the call alone.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type U = { a: i32 } | { b: i32 }
function sumU(n: U | null): i32 {
  if n == null { return 0 }
  if n is { b: i32 } { return n.b * 100 }
  return n.a
}
function mk(k: i32): U | null {
  if k < 0 { return null }
  if k > 50 {
    const tb: U = { b: k }
    return tb
  }
  const t: U = { a: k }
  return t
}
// @@VALUE@@
mk(2)
// @@TYPE@@
U | null
// @@TEST@@
v != null
// @@HIT@@
print(sumU(v))
// @@MISS@@
print(-1)
// @@WANT@@
2
// @@FALLBACK@@
null
// @@VALUE2@@
mk(70)
// @@TYPE2@@
U | null
// @@PROOF2@@
print(sumU(v))
// @@WANT2@@
7000
