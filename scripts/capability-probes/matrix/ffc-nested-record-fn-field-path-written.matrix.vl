// A function field two records deep, rewritten through the whole path and called through a
// bound inner record. 5 * 2 needs the write to reach the record the binding reads.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __inc(n: i32): i32 { return n + 1 }
function __dbl(n: i32): i32 { return n * 2 }
// @@VALUE@@
{ a: { b: { f: __inc } } }
// @@TYPE@@
{a: {b: {f: (n: i32) => i32}}}
// @@PROOF@@
v.a.b.f = __dbl
const inner = v.a.b
print(inner.f(5))
// @@WANT@@
10
