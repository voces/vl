// A5 / D1814 — the optional call whose callee is a CALLABLE FIELD rather than a free
// `self`-function: `p?.f()` reads the field off the guarded receiver and `call_ref`s it.
// This is the face the old refusal named — `called value is not a function ((() => i32) |
// null)` — because the `?.` node's own type was handed to the call.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type P = { f: () => i32 }
function mkP(c: boolean): P | null {
  if c { return { f: () => 42 } }
  return null
}
const p = mkP(true)
// @@VALUE@@
p?.f()
// @@TYPE@@
i32 | null
// @@FALLBACK@@
null
// @@PROOF@@
print(v ?? 0)
// @@WANT@@
42
