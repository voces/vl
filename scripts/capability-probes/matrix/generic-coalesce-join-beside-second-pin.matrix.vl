// D9913: a `??` over a declared type parameter pinned at `i64 | null`, with a float default, is
// the join `i64 | f64` inside the body though the function is also called at a never-null `f64`.
// `T` is left open, so the pins come from the calls. The proof is true only when the default's
// `0.5` reached the sum.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __cvTake<T>(a: T) {
  const r = a ?? 0.5
  const s = r + 1
  return s < 2
}
const __cvNul: i64 | null = null
const __cvOther = __cvTake(4.0)
// @@VALUE@@
__cvTake(__cvNul)
// @@TYPE@@
boolean
// @@TEST@@
v
// @@HIT@@
print("default")
// @@MISS@@
print("miss")
// @@WANT@@
default
