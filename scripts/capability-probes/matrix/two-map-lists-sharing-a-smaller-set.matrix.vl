// Two list literals of maps of un-annotated functions, each of a wider set and a smaller set they
// share, in one program: the shared smaller set is decided with both wider sets (D15394).
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function half(a) { return a / 2.0 }
function dbl(a) { return a * 2 }
function inc0(a) { return a + 1 }
const m1 = Map()
m1.set("a", half)
const fnMap = Map()
fnMap.set("a", inc0)
fnMap.set("b", half)
const m4 = Map()
m4.set("a", half)
const m3 = Map()
m3.set("a", dbl)
m3.set("b", half)
const ys = [m3, m4]
// @@VALUE@@
[fnMap, m1]
// @@TYPE@@
({ [string]: (a: f64) => f64 })[]
// @@PROOF@@
const g = v[0].get("a")
const h = ys[0].get("a")
if g != null && h != null { print(g(3) + h(3)) }
// @@WANT@@
10
