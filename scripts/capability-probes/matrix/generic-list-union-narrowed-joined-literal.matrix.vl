// D10131 — a value of `i32[] | i32` handed to a generic that takes it as `T[] | i32`, narrows it
// by `is i32` and joins the narrowed arm with a literal. Both arms are `i32`, so the call is an
// `i32` and the proof binds it to one; the instance's return must not be the union box.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function len<T>(t: T[] | i32) {
  if t is i32 { t } else { 5 }
}
// @@VALUE@@
[1, 2]
// @@TYPE@@
i32[] | i32
// @@PROOF@@
const r: i32 = len(v)
print(r)
// @@WANT@@
5
// @@VALUE2@@
7
// @@TYPE2@@
string[] | i32
// @@PROOF2@@
const r: i32 = len(v)
print(r)
// @@WANT2@@
7
