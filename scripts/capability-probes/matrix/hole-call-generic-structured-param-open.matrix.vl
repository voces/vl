// D6541, D6542: a declared generic whose structured parameter (`T | null`, `T[]`) is left open
// through a hole, called at the generic's own instance for the hole call's argument types.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __orz<T>(v: T | null, d: T): T { v ?? d }
function __via(a) { return a(null, 3) + a(4, 0) }
function __len<T>(k: T[]): i32 { k.length }
function __vlen(a) { return a([]) + a([5, 6]) }
// @@VALUE@@
__via(__orz)
// @@TYPE@@
i32
// @@PROOF@@
print(v)
// @@WANT@@
7
// @@TEST@@
v == 7
// @@HIT@@
print(v)
// @@MISS@@
print(0)
// @@VALUE2@@
__vlen(__len)
// @@TYPE2@@
i32
// @@PROOF2@@
print(v + 1)
// @@WANT2@@
3
