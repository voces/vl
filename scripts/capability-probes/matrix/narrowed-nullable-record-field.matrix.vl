// A nullable record field the checker narrowed past its null, delivered to every position: the
// IR reads the field at its inner rep, and legacy's field tail writes the read's recover.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type __P = { x: i32, y: i32 }
type __R = { p: __P | null, n: i32 }
// @@SETUP@@
const __r: __R = { p: { x: 3, y: 4 }, n: 1 }
// @@GUARD@@
__r.p != null
// @@VALUE@@
__r.p
// @@TYPE@@
__P
// @@FALLBACK@@
{ x: 0, y: 0 }
// @@PROOF@@
print(v.x + v.y)
// @@WANT@@
7
// @@TEST@@
v.x == 3
// @@HIT@@
print(7)
// @@MISS@@
print(0)
