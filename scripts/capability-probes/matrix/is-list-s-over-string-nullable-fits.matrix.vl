// `v is S[]` over `string[] | (string | null)[]`, `v` from the string arm. Element kinds that
// store alike share a box tag, and the test must still answer by the value (D17052).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type S = "a" | "b"
type K = 1 | 2
type P = { q: i32 }
function mk(c: boolean): string[] | (string | null)[] {
  const a: string[] = ["a", "b"]
  const b: (string | null)[] = [null]
  if c { return a }
  return b
}
// @@VALUE@@
mk(true)
// @@TYPE@@
string[] | (string | null)[]
// @@TEST@@
v is S[]
// @@HIT@@
print(true)
// @@MISS@@
print(false)
// @@WANT@@
true
