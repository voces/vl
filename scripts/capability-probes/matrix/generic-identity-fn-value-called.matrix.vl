// D7763: an un-annotated generic identity handed a function value, its result called in
// place. The generic's type parameter stays open, so its return is the pin. The second
// instance hands it a lambda with a string result.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __id<T>(x: T) {
  return x
}
function __h(n: i32) {
  return n + 1
}
// @@VALUE@@
__id(__h)(2) + __id((n: i32) => n * 10)(3)
// @@TYPE@@
i32
// @@PROOF@@
print(v)
// @@WANT@@
33
// @@TEST@@
v == 33
// @@HIT@@
print(v)
// @@MISS@@
print(0)
// @@VALUE2@@
__id((s: string) => s + "!")("a")
// @@TYPE2@@
string
// @@PROOF2@@
print(v)
// @@WANT2@@
a!
