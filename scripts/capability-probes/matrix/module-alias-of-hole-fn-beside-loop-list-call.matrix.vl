// D15442: a module `const` alias of a hole function called with two functions, beside a call
// through a loop over a one-element list of that function inside a hole function. The value
// is the loop's result, so each position reads what the dispatch through the element built.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __add(a, b) { return a + b }
function __mul(a, b) { return a * b }
function __apply2(g) { return g(1, 2) }
const __k = __apply2
const __r1 = __k(__add)
const __r2 = __k(__mul)
function __viaFor(h) {
  let s = 0
  for f in [__apply2] { s = s + f(h) }
  return s
}
// @@VALUE@@
__viaFor(__add) * 10 + __r2
// @@TYPE@@
i32
// @@PROOF@@
print(v)
// @@WANT@@
32
// @@TEST@@
v == 32
// @@HIT@@
print(v)
// @@MISS@@
print(0)
// @@VALUE2@@
__viaFor(__mul) * 10 + __r1
// @@TYPE2@@
i32
// @@PROOF2@@
print(v)
// @@WANT2@@
23
