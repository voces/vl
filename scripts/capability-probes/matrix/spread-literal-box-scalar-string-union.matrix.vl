// A list-literal spread of an `i32[]` into a list of `i32 | string`: each source element is
// boxed under the union's `i32` arm, at every position, in both faces.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
const src: i32[] = [3, 4]
// @@VALUE@@
[...src, "s"]
// @@TYPE@@
(i32 | string)[]
// @@PROOF@@
const e = v[1]
const s = v[2]
if e is i32 && s is string {
  const n = e * 10 + v.length
  const t = s
  print("\{t}\{n}")
} else { print("miss") }
// @@WANT@@
s43
// @@SKIP@@
is_in_if: the value is a list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
