// D15057: a nullable value of another union whose arm is wider than an arm of the destination,
// delivered into the nullable union: the null keeps its tag and the wider arm is re-tagged. The
// second instance is the null. The proof reads through a `UawPet | null` parameter, so the
// un-annotated face delivers it there too.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type UawA = { k: i32, legs: i32 }
type UawB = { s: string }
type UawPet = UawA | UawB
type UawD = { k: i32, legs: i32, purr: boolean }
function uawMn(c: boolean): UawD | UawB | null {
  if c { return { k: 1, legs: 4, purr: true } }
  return null
}
function uawLegs(p: UawPet | null): i32 {
  if p == null { return -2 }
  if p is UawA { return p.legs }
  -1
}
// @@VALUE@@
uawMn(true)
// @@TYPE@@
UawPet | null
// @@TEST@@
uawLegs(v) >= 0
// @@HIT@@
print(uawLegs(v) + 1)
// @@MISS@@
print("b")
// @@WANT@@
5
// @@VALUE2@@
uawMn(false)
// @@TYPE2@@
UawPet | null
// @@PROOF2@@
print(uawLegs(v))
// @@WANT2@@
-2
