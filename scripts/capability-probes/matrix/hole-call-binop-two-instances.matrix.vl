// D6300: a hole called at two instances whose results meet a binary operator defined at
// both; the operator is judged at each instance, and this well-typed sibling must keep running.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __id(a) {
  return a
}
function __lap(g) {
  return g(1) + g("st").length
}
// @@VALUE@@
__lap(__id)
// @@TYPE@@
i32
// @@PROOF@@
print(v)
// @@WANT@@
3
// @@TEST@@
v == 3
// @@HIT@@
print(v)
// @@MISS@@
print(0)
// @@VALUE2@@
__lap((a) => a)
// @@TYPE2@@
i32
// @@PROOF2@@
print(v + 1)
// @@WANT2@@
4
