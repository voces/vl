`==` over a list whose element is `string | null`: equal when each pair is both null or the
same string, unequal on a null against a string (pick 1, slice B).
// @@PRELUDE@@
function mkEq(): (string | null)[] { ["a", null] }
function mkNe(): (string | null)[] { ["a", "b"] }
// @@VALUE@@
mkEq()
// @@TYPE@@
(string | null)[]
// @@WANT@@
true false true
// @@TEST@@
v == mkEq() && v != mkNe()
// @@HIT@@
print("true false true")
// @@MISS@@
print("miss")
// @@VALUE2@@
mkNe()
// @@TYPE2@@
(string | null)[]
// @@PROOF2@@
print("\{v == mkNe()} \{v == mkEq()}")
// @@WANT2@@
true false
