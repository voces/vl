// An `if` choosing between two generic functions, called inside a generic body whose type
// parameter has the callees' name and is bound to another type (D9160). The callees' own
// parameter is theirs, so the instance's binding of the shared name does not close it.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function idg<T>(t: T): T { return t }
function kg<T>(t: T): T { return t + t }
const on = [1].length > 0
function g<T>(v: T): string {
  const h = if on { kg } else { idg }
  return h("s")
}
function g2<T>(v: T): string { return g(v) }
// @@VALUE@@
g(3)
// @@TYPE@@
string
// @@PROOF@@
print(v)
// @@WANT@@
ss
// @@VALUE2@@
g2(2.5)
// @@TYPE2@@
string
// @@PROOF2@@
print(v.length)
// @@WANT2@@
2
