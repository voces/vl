// A map of lists of functions: an element of one list is overwritten through the map read, then
// each list is walked and called. 2*2 + 2+1 = 7.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __inc(n: i32): i32 { return n + 1 }
function __dbl(n: i32): i32 { return n * 2 }
function __mk(): {[string]: ((n: i32) => i32)[]} {
  const m: {[string]: ((n: i32) => i32)[]} = Map()
  m["k"] = [__inc, __inc]
  return m
}
// @@VALUE@@
__mk()
// @@TYPE@@
{[string]: ((n: i32) => i32)[]}
// @@PROOF@@
const __l = v["k"]
if __l != null { __l[0] = __dbl }
let c = 0
for k, fs in v { for f in fs { c = c + f(2) } }
print(c)
// @@WANT@@
7
