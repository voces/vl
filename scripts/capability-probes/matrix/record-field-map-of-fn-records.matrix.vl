// D15545: a record whose field holds a `Map()` of function-holding records, the map's value
// type known only from a store the proof makes later. The store is the first literal of the
// value record, so the holder's row must not be minted before that record's row exists.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@VALUE@@
{ f: Map() }
// @@TYPE@@
{ f: {[string]: {h: (i32) => string}} }
// @@PROOF@@
v.f["k"] = { h: (x: i32) => if x > 5 { "big" } else { "small" } }
const t1 = v.f["k"]
if t1 != null && v.f.length == 1 { print(t1.h(7)) }
// @@WANT@@
big
// @@VALUE2@@
{ f: Map() }
// @@TYPE2@@
{ f: {[string]: {g: i32}} }
// @@PROOF2@@
v.f["k"] = { g: 41 }
const t2 = v.f["k"]
if t2 != null { print(t2.g + 1) }
// @@WANT2@@
42
