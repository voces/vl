// A generic `twice` over a generic function, delivered and called at `string`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function gid<A>(x: A): A { return x }
function twice<A>(f: (x: A) => A): (x: A) => A { return (x: A) => f(f(x)) }
// @@VALUE@@
twice(gid)
// @@TYPE@@
(x: string) => string
// @@PROOF@@
print(v("s"))
// @@WANT@@
s
