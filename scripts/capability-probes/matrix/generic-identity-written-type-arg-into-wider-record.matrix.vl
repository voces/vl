// D8022: a generic identity whose type argument is written, `idn<{ r: i32 }>`, builds its
// literal at that type, so delivering it into a record that stores `r` as `i32 | null` is the
// existing-record refusal at every annotated position, and no position is invalid wasm.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type J = { r: i32 | null }
function idn<T>(v: T): T { v }
// @@VALUE@@
idn<{ r: i32 }>({ r: 4 })
// @@TYPE@@
J
// @@WANT@@
4
// @@TEST@@
true
// @@HIT@@
print(v.r ?? 0)
// @@MISS@@
print(0)
