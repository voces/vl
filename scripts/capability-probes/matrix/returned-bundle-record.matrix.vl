// D15144: a parameter called at two signatures and returned whole is a record of one closure
// per signature, delivered to each position and called there at both. Design:
// docs/internals/bundle-record-value-2026-11.md. The annotated face spells one signature.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __lap(f) {
  const __a = f(2.5)
  const __b = f(3)
  return f
}
// @@VALUE@@
__lap((a) => a + 1)
// @@TYPE@@
(x: f64) => f64
// @@PROOF@@
print("\{v(4)} \{v(1.5)}")
// @@WANT@@
5 2.5
// @@TEST@@
v(4) == 5
// @@HIT@@
print("\{v(4)} \{v(1.5)}")
// @@MISS@@
print(0)
// @@VALUE2@@
__lap((a) => a * 2)
// @@TYPE2@@
(x: f64) => f64
// @@PROOF2@@
print("\{v(4)} \{v(1.5)}")
// @@WANT2@@
8 3
