// Receiver overloading (O1) through a receiver each instance supplies: `__last`'s body calls
// the overloaded `lastIndexOf` on its type parameter, and each instance picks by its receiver.
// The type parameter stays open, so no cell can annotate the choice for the checker.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
import { lastIndexOf } from "std:array"
import { lastIndexOf } from "std:str"
function __last<T, N>(x: T, n: N): i32 { x.lastIndexOf(n) }
// @@VALUE@@
__last([1, 2, 3, 2], 2)
// @@TYPE@@
i32
// @@PROOF@@
print(v)
// @@WANT@@
3
// @@VALUE2@@
__last("abcb", "b")
// @@TYPE2@@
i32
// @@PROOF2@@
print(v)
// @@WANT2@@
3
