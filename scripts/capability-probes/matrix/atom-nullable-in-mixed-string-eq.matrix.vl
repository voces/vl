// An equality between a nullable literal-union atom (`K | null`) holding null and a plain string,
// delivered to every position: legacy decodes the null through the atom plan's nul arm.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type __K = "ab" | "cd"
function __mk(i: i32): __K | null { return if i > 0 { "cd" } else { null } }
function __s(i: i32): string { return if i > 0 { "cd" } else { "q" } }
// @@SETUP@@
const __k: __K | null = __mk(0)
const __t = __s(1)
// @@VALUE@@
__k == __t
// @@TYPE@@
boolean
// @@PROOF@@
print(v)
// @@WANT@@
false
// @@TEST@@
!v
// @@HIT@@
print("false")
// @@MISS@@
print("no")
