// A call-site spread into a rest parameter whose record element drops a numeric field the
// source's carries (D14960): the pack is built at the parameter's list type and each source
// element copied as it is, at every position, in both faces. The twin of
// `spread-into-rest-parameter.matrix.vl` with a converting element.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type Shape = { r: i32 }
type Circle = { r: i32, w: f64 }
function collect(...xs: Shape[]): Shape[] { return xs }
const cs: Circle[] = [{ r: 7, w: 2.5 }, { r: 8, w: 0.5 }]
// @@VALUE@@
collect(...cs)
// @@TYPE@@
Shape[]
// @@PROOF@@
print(v[1].r * 10 + v.length)
