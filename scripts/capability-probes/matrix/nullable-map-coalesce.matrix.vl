// `??` over a nullable map with a map default (D3257): the value is the operand's map when it
// is present, at the operand's own shape. The proof prints the present map's entry, which the
// default's would not.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function mk(n: i32): Map<string, i32> {
  const m = Map<string, i32>()
  m["a"] = n
  m
}
function maybe(n: i32): Map<string, i32> | null {
  if n > 0 { mk(n) } else { null }
}
// @@VALUE@@
maybe(5) ?? mk(-1)
// @@TYPE@@
Map<string, i32>
// @@PROOF@@
print(v["a"] ?? -9)
// @@WANT@@
5
// @@TEST@@
(v["a"] ?? -9) > 0
// @@HIT@@
print(v["a"] ?? -9)
// @@MISS@@
print("miss")
