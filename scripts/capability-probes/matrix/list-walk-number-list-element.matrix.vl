// A walk over a list of `f64` lists, `i64` lists or nullable byte lists binds each inner list as it
// is stored. The loop variable exists only inside its loop, so each position is a cell delivering
// the inner list from the loop body; the VALUE is one walk's result, graded at the built-ins.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function fl(): f64[][] { return [[1.5, 2.5], [], [3.5]] }
function il(): i64[][] { return [[1 as i64], [2 as i64, 3 as i64]] }
function ul(): (u8[] | null)[] { return [[1 as u8], null] }
function lastLen(xs: f64[][]): i32 {
  let t = 0
  for row in xs { t = row.length }
  return t
}
function len(r: f64[]): i32 { return r.length }
function ulen(r: u8[] | null): i32 { return if r != null { r.length } else { -1 } }
// @@VALUE@@
lastLen(fl())
// @@TYPE@@
i32
// @@PROOF@@
print(v)
// @@WANT@@
1
// @@CELL_arg@@
// want: 2 then 0 then 1
for row in fl() { print(len(row)) }
// @@CELL_nested_arg@@
// want: 2 then 0 then 1
for row in fl() { print(len(row) + 0) }
// @@CELL_concat@@
// want: n2 then n0 then n1
for row in fl() { print("n" + "\{row.length}") }
// @@CELL_let@@
// want: 2 then 0 then 1
for row in fl() {
  const r = row
  print(r.length)
}
// @@CELL_if_arm@@
// want: 2 then 0 then 1
for row in fl() { print(if row.length >= 0 { row.length } else { 0 }) }
// @@CELL_record_field@@
// want: 2 then 0 then 1
for row in fl() {
  const w = { r: row, k: 1 }
  print(w.r.length)
}
// @@CELL_return@@
// want: 1
function firstI(): i32 {
  for row in il() { return row.length }
  return 0
}
print(firstI())
// @@CELL_i64_arg@@
// want: 1 then 2
function ilen(r: i64[]): i32 { return r.length }
for row in il() { print(ilen(row)) }
// @@CELL_u8_nullable_arg@@
// want: 1 then -1
for b in ul() { print(ulen(b)) }
// @@CELL_u8_coalesce@@
// want: 1 then 0
for b in ul() { print((b ?? []).length) }
