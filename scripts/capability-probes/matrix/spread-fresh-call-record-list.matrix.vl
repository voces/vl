// A list literal that only spreads a call's fresh record list, delivered where a list of a wider
// record is declared (D16615): the call is copied element by element into the destination's
// element, at every position, in both faces. The proof adds a fraction, so it prints only if the
// copied field is a float. The own cells are the refused group (D16954): a call whose literal holds
// a record or list another binding holds is not fresh, so each must keep refusing in the annotated
// face; a copy there would print a stale value, graded WRONG against the shared one.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function mk() { return [{ x: 1 }, { x: 3 }] }
// @@VALUE@@
[...mk()]
// @@TYPE@@
{ x: f64 }[]
// @@PROOF@@
print(v[1].x + 0.25 + v.length)
// @@WANT@@
5.25
// @@SKIP@@
is_in_if: the value is a list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
// @@CELL_held_record_element@@
// want: 5
const r = { x: 1 }
function hk() { return [r] }
const w__A__ = [...hk()]
r.x = 5
print(w[0].x)
// @@CELL_held_record_element_two_calls@@
// want: 5
const r = { x: 1 }
function hk() { return [r] }
const w__A__ = hk()
const u = hk()
r.x = 5
print(w[0].x + u.length - 1)
// @@CELL_held_record_in_field@@
// want: 5
const r = { x: 1 }
function hk() { return [{ p: r }] }
const w: { p: { x: f64 } }[] = [...hk()]
r.x = 5
print(w[0].p.x)
// @@CELL_held_list_in_nested_list@@
// want: 2
const q = [1]
function hk() { return [q] }
const w: readonly (readonly f64[])[] = hk()
q.push(3)
print(w[0].length)
