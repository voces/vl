// A `let` bound to a call of a function returning one of two generic functions, called at one
// type, written with another such call, then delivered to each position and called there at TWO
// types it was not called at before the write. No function type spells that, so the annotated
// face refuses by design; the un-annotated face runs (D10322).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function idg<T>(t: T): T { return t }
function kg<T>(t: T): T { return t + t }
function pick(n: i32) {
  if n > 1 { return kg }
  return idg
}
let h = pick([1, 2].length)
const i0 = h(3)
h = pick([1].length)
// @@VALUE@@
h
// @@TYPE@@
(x: string) => string
// @@PROOF@@
if v("ab") == "ab" && i0 == 6 { print(v(2.5) * 2.0 + 0.5) } else { print(0.0) }
// @@WANT@@
5.5
