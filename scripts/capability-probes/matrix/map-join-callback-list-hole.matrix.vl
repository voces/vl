// D3125's list face: the joined `.map` result itself leaves a hole instance, through a local,
// and is delivered to every position. The one pin the reviews found trapping, `string | null`
// holding `null`.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function mk(x) {
  const m = [x].map((e) => {
    if e != null { return e }
    return null
  })
  return m
}
const sn: string | null = null
// @@VALUE@@
mk(sn)
// @@TYPE@@
(string | null)[]
// @@PROOF@@
print(v[0])
print(v.length)
// @@WANT@@
null
1
