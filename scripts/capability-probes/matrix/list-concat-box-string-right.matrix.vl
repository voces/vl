// A list `+` whose right operand is a `string[]` beside a `(string | i32)[]`: the string list
// is boxed into the union element before the concat (D4858), at every position, both faces.
// VALUE2 puts the narrower operand on the LEFT, through un-annotated bindings.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
const cb = ["q"]
const ca = ["p", 1]
// @@VALUE@@
["p", 1] + ["q"]
// @@TYPE@@
(string | i32)[]
// @@PROOF@@
const e = v[2]
if e is string { print("\{e}\{v.length}") } else { print("miss") }
// @@WANT@@
q3
// @@VALUE2@@
cb + ca
// @@TYPE2@@
(string | i32)[]
// @@PROOF2@@
const e = v[0]
const f = v[2]
if e is string && f is i32 { print("\{e}\{f + v.length}") } else { print("miss") }
// @@WANT2@@
q4
// @@SKIP@@
is_in_if: the value is a list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
