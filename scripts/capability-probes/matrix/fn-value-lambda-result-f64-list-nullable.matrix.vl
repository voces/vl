// D9742: a lambda returning an `f64` list, or `null`, delivered where a function returning
// `f64[] | null` is expected. The lambda takes the expected result as its own, as the
// annotated `(x: i32): f64[] | null => ...` result does.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@VALUE@@
(x: i32) => [1.5, 2.5]
// @@TYPE@@
(x: i32) => f64[] | null
// @@PROOF@@
const r = v(1)
if r == null { print(0) } else { print(r[0] + r[1]) }
// @@WANT@@
4
// @@VALUE2@@
(x: i32) => null
// @@TYPE2@@
(x: i32) => f64[] | null
// @@PROOF2@@
print(v(1) == null)
// @@WANT2@@
true
