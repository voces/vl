// A value `if` choosing between two record literals of un-annotated functions, delivered at
// every position, its field then written another function and called at two types (D15302's
// if-arm literal). Each arm is a producer of the written record, built at its widened row.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __id0(a) { return a * 10 }
function __idA(a) { return a + 1 }
function __idB(a) { return a + 100 }
const __cA = 1 > 0
// @@VALUE@@
if __cA { { f: __idA } } else { { f: __idB } }
// @@TYPE@@
{ f: (a: f64) => f64 }
// @@PROOF@@
const __w0 = v.f(1)
v.f = __id0
print("\{__w0},\{v.f(2)},\{v.f(2.5)}")
// @@WANT@@
2,20,25
// @@SKIP@@
is_in_if: the value is a struct, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
