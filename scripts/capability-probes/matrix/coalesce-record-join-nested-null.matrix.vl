// D2373's all-null case through a nested same-record join: `mkA(0) ?? mkA(0)` stays `A`'s
// niche, and boxing it into the outer join must test it for null rather than tag it `A`. The
// second instance delivers the same niche as a value `if` arm.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@SKIP@@
map_value: the builder guards its read with `!= null`, and this template's value is null by
design, so the guarded body never runs
map_value_place: the same `!= null` guard as `map_value`
// @@PRELUDE@@
type A = { r: i32 }
type B = { q: string }
function mkA(n: i32): A | null { if n == 0 { return null } return { r: n } }
function mkB(n: i32): B | null { if n == 0 { return null } return { q: "b" } }
function yes(): boolean { return true }
// @@VALUE@@
mkB(0) ?? (mkA(0) ?? mkA(0))
// @@TYPE@@
A | B | null
// @@TEST@@
v is A || v is B
// @@HIT@@
print("arm")
// @@MISS@@
print("none")
// @@WANT@@
none
// @@VALUE2@@
if yes() { mkA(0) ?? mkA(0) } else { mkB(1) }
// @@TYPE2@@
A | B | null
// @@PROOF2@@
print(v == null)
// @@WANT2@@
true
