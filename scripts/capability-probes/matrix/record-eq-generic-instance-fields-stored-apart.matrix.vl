// D16397 — `==` / `!=` in a generic body whose instance compares two records of one field set
// stored apart. The checker sees the body only at its type parameters, so the per-field-pair
// compare (D16394) is applied to each instance at its own operand types. Every cell is a generic
// body, proving `==` and `!=`, true and false.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function eqT<T, U>(a: T, b: U): boolean { return a == b }
function neT<T, U>(a: T, b: U): boolean { return a != b }
const yF: {f: f64} = { f: 1.0 }
const zF: {f: f64} = { f: 2.0 }
// @@VALUE@@
{ f: 1 }
// @@TYPE@@
{f: i32}
// @@PROOF@@
print(eqT(v, yF) && !eqT(v, zF) && neT(v, zF) && !neT(v, yF))
// @@WANT@@
true
// @@CELL_int_float@@
// want: true
const x: {f: i32} = { f: 1 }
const y: {f: f64} = { f: 1.0 }
const z: {f: f64} = { f: 2.0 }
print(eqT(x, y) && !eqT(x, z) && neT(x, z) && !neT(x, y))
// @@CELL_litunion_vs_string@@
// want: true
const x: {f: "a" | "b"} = { f: "a" }
const y: {f: string} = { f: "a" }
const z: {f: string} = { f: "b" }
print(eqT(x, y) && !eqT(x, z) && neT(x, z))
// @@CELL_nested_record@@
// want: true
const x: {g: {f: i32}} = { g: { f: 1 } }
const y: {g: {f: f64}} = { g: { f: 1.0 } }
const z: {g: {f: f64}} = { g: { f: 3.0 } }
print(eqT(x, y) && !eqT(x, z))
// @@CELL_two_fields@@
// want: true
const x: {f: i32, g: "p" | "q"} = { f: 1, g: "q" }
const y: {f: f64, g: string} = { f: 1.0, g: "q" }
const z: {f: f64, g: string} = { f: 1.0, g: "p" }
print(eqT(x, y) && !eqT(x, z) && neT(x, z))
// @@CELL_nullable_records@@
// want: true
const x: {f: i32} | null = { f: 1 }
const y: {f: f64} | null = { f: 1.0 }
const n1: {f: i32} | null = null
const n2: {f: f64} | null = null
print(eqT(x, y) && eqT(n1, n2) && !eqT(x, n2) && neT(n1, y))
// @@CELL_nullable_one_side@@
// want: true
const x: {f: i32} = { f: 1 }
const y: {f: f64} | null = { f: 1.0 }
const n: {f: f64} | null = null
print(eqT(x, y) && !eqT(x, n) && !eqT(n, x))
// @@CELL_record_param_of_t@@
// want: true
function eqF<T>(a: {f: T}, b: {f: f64}): boolean { return a == b }
print(eqF({ f: 1 }, { f: 1.0 }) && !eqF({ f: 2 }, { f: 1.0 }))
// @@CELL_local_copy@@
// want: true
function eqL<T, U>(a: T, b: U): boolean {
  const p = a
  return p == b
}
print(eqL({ f: 1 }, { f: 1.0 }) && !eqL({ f: 1 }, { f: 2.0 }))
// @@CELL_one_row_instance@@
// want: true
print(eqT({ f: 1 }, { f: 1 }) && !eqT({ f: 1 }, { f: 2 }))
// @@CELL_different_field_sets@@
// owed: have different fields
const x: {f: i32, g: i32} = { f: 1, g: 2 }
const y: {f: i32} = x
print(eqT(x, y))
