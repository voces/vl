// D16024: an un-annotated function returning an `i32[]` or a `Set<i32>` infers the union i32[] | Set<i32>, which must
// lower as its annotated twin does. The value is the Set arm; the second instance is the
// list arm.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type S = { n: i32 }
function k(n: i32) { n }
function pick(c: i32) {
  if c == 1 { return [k(1), 2] }
    const m: Set<i32> = Set()
  m.add(k(5))
  return m
}
// @@VALUE@@
pick(k(0))
// @@TYPE@@
i32[] | Set<i32>
// @@WANT@@
true
// @@TEST@@
v is i32[]
// @@HIT@@
print("list")
// @@MISS@@
print(v.has(5))
// @@VALUE2@@
pick(k(1))
// @@TYPE2@@
i32[] | Set<i32>
// @@PROOF2@@
if v is i32[] { print(v[0]) } else { print("map") }
// @@WANT2@@
1
