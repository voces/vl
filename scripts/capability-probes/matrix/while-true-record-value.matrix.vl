// A `while true` loop carrying a record (owner ruling 2026-09-29): it cannot run out, so its
// value is the plain non-null record, carried out of the loop through a typed frame. The proof
// reads a field the break computed.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type Circle = { r: i32 }
function seven(): i32 { 7 }
// @@VALUE@@
while true { if seven() > 0 { break { r: seven() * 3 } } }
// @@TYPE@@
Circle
// @@PROOF@@
print(v.r)
// @@WANT@@
21
// @@SKIP@@
is_in_if: the value is a record, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
