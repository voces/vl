// Reference identity on a record that reaches itself through a list field (D15975): `==` on one
// compares through a synthesized per-row core, and `===` reads no field, so it needs none and
// a structurally equal tree built elsewhere is a different record.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type N = { v: i32, kids: N[] }
const src: N = { v: 1, kids: [{ v: 2, kids: [] }] }
function mkTwin(): N { return { v: 1, kids: [{ v: 2, kids: [] }] } }
// @@VALUE@@
src
// @@TYPE@@
N
// @@TEST@@
v === src
// @@HIT@@
print("same")
// @@MISS@@
print("other")
// @@WANT@@
same
// @@VALUE2@@
mkTwin()
// @@TYPE2@@
N
// @@PROOF2@@
if v === src { print("same") } else { print("other") }
// @@WANT2@@
other
