// D3003/D3004 — a record literal a map store re-seats at a wider declared record `{ v: f64 }`,
// its field read back through an alias and delivered at every position. The literal-holding
// binding takes `D` as its type at every read (D3339, ruling A), the alias included, so the field
// reads `f64` as the annotated twin's does: the proof does not wrap at `i32` (D16751).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type D = { v: f64 }
const x = 2147483647
const c: {[string]: D} = Map()
const o = { v: x }
c["k"] = o
const same = o
// @@VALUE@@
same.v
// @@TYPE@@
f64
// @@PROOF@@
print(v + 1)
// @@WANT@@
2147483648
// @@TEST@@
v > 0
// @@HIT@@
print(v + 1)
// @@MISS@@
print(0)
