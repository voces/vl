// D3003/D3004 — a record literal a map store re-seats at a wider declared record `{ v: f64 }`,
// its field read back at its own `i32` type through an alias and delivered at every position.
// The read narrows from the wider slot, so the proof wraps at `i32`: a value left at `f64`
// prints 2147483648.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type D = { v: f64 }
const x = 2147483647
const c: {[string]: D} = Map()
const o = { v: x }
c["k"] = o
const same = o
// @@VALUE@@
same.v
// @@TYPE@@
i32
// @@PROOF@@
print(v + 1)
// @@WANT@@
-2147483648
// @@TEST@@
v > 0
// @@HIT@@
print(v + 1)
// @@MISS@@
print(0)
