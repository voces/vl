// D4350: a string literal union value delivered at each position, then added to a
// literal-union-keyed set beside a bare member literal, which the call adapts to the key.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type K = "a" | "b" | "c"
// @@VALUE@@
"a"
// @@TYPE@@
K
// @@PROOF@@
const s: Set<K> = Set()
s.add(v)
s.add("b")
print(s.has("a") && s.has("b") && !s.has("c"))
// @@WANT@@
true
// @@VALUE2@@
"c"
// @@TYPE2@@
K
// @@PROOF2@@
const s2: Set<K> = Set()
s2.add(v)
s2.add("a")
print(s2.has("c") && s2.has("a") && !s2.has("b"))
// @@WANT2@@
true
