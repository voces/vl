// A generic body indexes the result of a member call that its instance lowers to a direct
// call: `xs.rev()[0]`, the index re-made by the instance's pin pass (D17240). Each cell reads
// one element kind at one position (return, let, argument, print), and a few spellings
// of the index; every cell prints the element it read.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type P = { n: i32 }
function rev<T>(self: T[]): T[] { return self }
function first<T>(xs: T[]): T { return xs.rev()[0] }
function firstLet<T>(xs: T[]): T {
  const y = xs.rev()[0]
  return y
}
function pass<T>(x: T): T { return x }
function firstArg<T>(xs: T[]): T { return pass(xs.rev()[0]) }
function show<T>(xs: T[]) { print(xs.rev()[0]) }
// @@VALUE@@
first([3, 1, 2])
// @@TYPE@@
i32
// @@PROOF@@
print(v)
// @@WANT@@
3
// @@CELL_i32_return@@
// want: 3
const x = first([3, 1, 2])
print(x)
// @@CELL_i32_let@@
// want: 3
const x = firstLet([3, 1, 2])
print(x)
// @@CELL_i32_arg@@
// want: 3
const x = firstArg([3, 1, 2])
print(x)
// @@CELL_i32_print@@
// want: 3
show([3, 1, 2])
// @@CELL_i64_return@@
// want: 3
const x = first([(3 as i64), (1 as i64)])
print(x)
// @@CELL_i64_let@@
// want: 3
const x = firstLet([(3 as i64), (1 as i64)])
print(x)
// @@CELL_i64_arg@@
// want: 3
const x = firstArg([(3 as i64), (1 as i64)])
print(x)
// @@CELL_i64_print@@
// want: 3
show([(3 as i64), (1 as i64)])
// @@CELL_f64_return@@
// want: 1.5
const x = first([1.5, 2.5])
print(x)
// @@CELL_f64_let@@
// want: 1.5
const x = firstLet([1.5, 2.5])
print(x)
// @@CELL_f64_arg@@
// want: 1.5
const x = firstArg([1.5, 2.5])
print(x)
// @@CELL_f64_print@@
// want: 1.5
show([1.5, 2.5])
// @@CELL_string_return@@
// want: a
const x = first(["a", "b"])
print(x)
// @@CELL_string_let@@
// want: a
const x = firstLet(["a", "b"])
print(x)
// @@CELL_string_arg@@
// want: a
const x = firstArg(["a", "b"])
print(x)
// @@CELL_string_print@@
// want: a
show(["a", "b"])
// @@CELL_boolean_return@@
// want: true
const x = first([true, false])
print(x)
// @@CELL_boolean_let@@
// want: true
const x = firstLet([true, false])
print(x)
// @@CELL_boolean_arg@@
// want: true
const x = firstArg([true, false])
print(x)
// @@CELL_boolean_print@@
// want: true
show([true, false])
// @@CELL_record_return@@
// want: 4
const x = first([{ n: 4 }, { n: 5 }])
print(x.n)
// @@CELL_record_let@@
// want: 4
const x = firstLet([{ n: 4 }, { n: 5 }])
print(x.n)
// @@CELL_record_arg@@
// want: 4
const x = firstArg([{ n: 4 }, { n: 5 }])
print(x.n)
// @@CELL_list_return@@
// want: 7
const x = first([[7, 8], [9]])
print(x[0])
// @@CELL_list_let@@
// want: 7
const x = firstLet([[7, 8], [9]])
print(x[0])
// @@CELL_list_arg@@
// want: 7
const x = firstArg([[7, 8], [9]])
print(x[0])
// @@CELL_closure_return@@
// want: 11
const x = first([(k: i32) => k + 10, (k: i32) => k + 20])
print(x(1))
// @@CELL_closure_let@@
// want: 11
const x = firstLet([(k: i32) => k + 10, (k: i32) => k + 20])
print(x(1))
// @@CELL_closure_arg@@
// want: 11
const x = firstArg([(k: i32) => k + 10, (k: i32) => k + 20])
print(x(1))
// @@CELL_paren_index_f64@@
// want: 1.5
function pf<T>(xs: T[]): T { return (xs.rev())[0] }
print(pf([1.5, 2.5]))
// @@CELL_var_index_i64@@
// want: 1
function vi<T>(xs: T[], i: i32): T { return xs.rev()[i] }
print(vi([(3 as i64), (1 as i64)], 1))
// @@CELL_length_member@@
// want: 3 then 1
function ln<T>(xs: T[]): i32 { return xs.rev().length }
print(ln([3, 1, 2]))
print(ln([1.5]))
// @@CELL_two_instances_f64_i64@@
// want: 1.5 then 3
print(first([1.5, 2.5]))
print(first([(3 as i64), (1 as i64)]))
