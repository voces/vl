// D9915: a `??` over a record field of a parameter typed `{ v: T }` is the field at a never-null
// `{ v: i32 }` pin, though the function is also called at `{ v: i32 | null }` with a float
// default. `T` is left open, so the pins come from the calls. The proof divides, which prints
// `3` at `i32` and `3.5` at `f64`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __cqTake<T>(r: { v: T }, d: f64) { return r.v ?? d }
const __cqNul: { v: i32 | null } = { v: 4 }
const __cqOther = __cqTake(__cqNul, 1.5)
const __cqK: { v: i32 } = { v: 7 }
// @@VALUE@@
__cqTake(__cqK, 9)
// @@TYPE@@
i32
// @@TEST@@
v > 0
// @@HIT@@
print(v / 2)
// @@MISS@@
print("miss")
// @@WANT@@
3
