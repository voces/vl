// D2874 — `.length`, an index read and `for … in` over a union whose every member is a list,
// graded at every position the union can be delivered to. The proof reads all three off `v`
// and the element union's own arm, so a widened or mis-tagged element prints wrong.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function mk(b: boolean): string[] | i32[] {
  if b { return ["a", "bc"] }
  [4, 5, 6]
}
// @@VALUE@@
mk(false)
// @@TYPE@@
string[] | i32[]
// @@TEST@@
v[0] is i32
// @@MISS@@
print(0)
// @@HIT@@
let t = v.length
for x in v {
  if x is i32 { t = t + x }
}
const e = v[1]
if e is i32 { print(t * 100 + e) } else { print(e) }
// @@WANT@@
1805
// @@VALUE2@@
mk(true)
// @@TYPE2@@
string[] | i32[]
// @@PROOF2@@
const e2 = v[1]
if e2 is string { print(e2.length * 10 + v.length) } else { print(0) }
// @@WANT2@@
22
