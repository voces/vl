// D2692 — a union of two maps that store alike, delivered as its wider member at every
// position: the box's payload is that map, so each delivery unboxes it. The two instances
// hold each member, and the proof reads a value through the wider map.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type Circle = { r: i32 }
type Sq = { s: i32 }
function mkc(): Circle | Sq { { r: 3 } }
function mks(): Circle | Sq { { s: 4 } }
function mkin(n: i32): {[string]: i32} {
  const m: {[string]: i32} = Map()
  m["q"] = n
  if n > 1 { m["r"] = n }
  m
}
function mka(): {[string]: Circle} {
  const m: {[string]: Circle} = Map()
  m.set("a", { r: 3 })
  m
}
function mkb(): {[string]: Circle | null} {
  const m: {[string]: Circle | null} = Map()
  m.set("a", { r: 4 })
  m.set("b", null)
  m
}
function pick(n: i32): {[string]: Circle} | {[string]: Circle | null} {
  if n > 0 { return mkb() }
  return mka()
}
// @@VALUE@@
pick(0)
// @@TYPE@@
{[string]: Circle | null}
// @@PROOF@@
print(v.length)
const x = v["a"]
if x != null { print(x.r) } else { print("null") }
// @@WANT@@
1 then 3
// @@VALUE2@@
pick(1)
// @@TYPE2@@
{[string]: Circle | null}
// @@PROOF2@@
print(v.length)
const x = v["a"]
if x != null { print(x.r) } else { print("null") }
// @@WANT2@@
2 then 4
