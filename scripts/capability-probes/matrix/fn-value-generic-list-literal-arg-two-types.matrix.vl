// A generic function delivered to each position, then written alone into a list literal handed
// straight to a generic called at `i32`, while another literal of the same generic is handed to it
// at `string` (D10250). Each literal binds the call's type parameter from the value argument.
// `fn-value-generic-list-literal-arg-two-types-open.matrix.vl` is the open twin.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function id<T>(x: T): T { x }
function __run<U>(a: ((x: U) => U)[], u: U): U { a[0](u) }
// @@VALUE@@
id
// @@TYPE@@
(x: i32) => i32
// @@PROOF@@
print(__run([id], "s").length * 10 + __run([v], 2))
// @@WANT@@
12
