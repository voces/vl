// D10290: a top-level function with no type parameter and no hole, also read by value, joins a
// runtime `i32` and a runtime `f64` as `i32 | f64` at a direct call and through the value it was
// read as: each result keeps its own member.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __fvF(k: i32, a: i32, b: f64) {
  if k == 0 { return a }
  b
}
const __fvH = __fvF
// @@VALUE@@
__fvF(0, 7, 2.5)
// @@TYPE@@
i32 | f64
// @@PROOF@@
print(v is i32 && v / 2 == 3)
// @@WANT@@
true
// @@VALUE2@@
__fvH(1, 7, 2.5)
// @@TYPE2@@
i32 | f64
// @@PROOF2@@
print(v is f64 && v / 2.0 == 1.25)
// @@WANT2@@
true
