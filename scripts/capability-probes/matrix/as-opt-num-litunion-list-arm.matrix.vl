// D14042 — `v as? (0 | 1)[]` out of a `(0 | 1)[] | string` box: a hit is the `i32[]` tag, and
// the result is the list or `null`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function mk(k: i32): (0 | 1)[] | string {
  if k == 0 { return "s" }
  return [1, 0]
}
// @@VALUE@@
mk(1) as? (0 | 1)[]
// @@TYPE@@
(0 | 1)[] | null
// @@TEST@@
v != null
// @@HIT@@
print(v[0] + 10)
// @@MISS@@
print(0)
// @@WANT@@
11
// @@VALUE2@@
mk(0) as? (0 | 1)[]
// @@TYPE2@@
(0 | 1)[] | null
// @@PROOF2@@
print(v == null)
// @@WANT2@@
true
