// D2544's field sibling — the value is what an un-annotated function RETURNS when its tail
// statement writes a map to a record field: the write's right side, the map just stored.
//
// Since the 2026-11-14 return rule (DECISIONS) a block body returns only through `return`, so
// the write is returned as `return <write>`; an assignment's value is its right side (D2497).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type __O = { m: {[i32]: i32} }
function __mk(): {[i32]: i32} {
  const n: {[i32]: i32} = Map()
  n[1] = 5
  return n
}
const __o: __O = { m: Map() }
function __tw(o: __O) { return o.m = __mk() }
// @@VALUE@@
__tw(__o)
// @@TYPE@@
{[i32]: i32}
// @@PROOF@@
print(v[1] ?? 0)
// @@WANT@@
5
