// The generic twin of fn-list-written-through-param: the list's functions name their own open
// parameter `T`, bound where the element is called (D14648).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __id<T>(x: T): T { return x }
function __half<T>(x: T): f64 { return x / 2.0 }
function __put(ys) { ys[0] = __half }
function __hand(zs) { __put(zs) }
// @@SETUP@@
const __xs = [__id]
__hand(__xs)
// @@VALUE@@
__xs
// @@TYPE@@
readonly ((x: i32) => i32 | f64)[]
// @@PROOF@@
print(v[0](3))
// @@WANT@@
1.5
