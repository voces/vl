// D9915: a `??` over a list element of a parameter typed `T[]` is the element at a never-null
// `i32[]` pin, though the function is also called at `(i32 | null)[]` with a float default. `T`
// is left open, so the pins come from the calls. The proof divides, which prints `3` at `i32`
// and `3.5` at `f64`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __cgTake<T>(a: T[], d: f64) { return a[1] ?? d }
const __cgNul: (i32 | null)[] = [null, 4]
const __cgOther = __cgTake(__cgNul, 1.5)
const __cgK: i32[] = [3, 7]
// @@VALUE@@
__cgTake(__cgK, 9)
// @@TYPE@@
i32
// @@TEST@@
v > 0
// @@HIT@@
print(v / 2)
// @@MISS@@
print("miss")
// @@WANT@@
3
