// D1516 — a value union read out of a PROJECTION (a list element, a struct field, a map) and
// handed to an UN-ANNOTATED parameter. Every channel the monomorphizer's pin ladder had asks a
// BINDING — an annotation, a callee's return, a global's init — so a projection reached none of
// them and the union floor refused the instance.
//
// `take` is the hole; it is what makes this template about the pin rather than about the read.
// The list `srcArr` must stay UN-annotated: annotating it is the rescue the row records.
//
// The PROOF discriminates, so an instance pinned at the wrong rep prints the wrong branch
// rather than passing.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type Val = i32 | string
function mkval(): Val { return 3 }
function mkval2(): Val { return 7 }
const srcArr = [mkval()]
const srcArr2 = [mkval2()]
function take(p) {
  if p is i32 { print(p) } else { print(0) }
}
function take2(p) {
  if p is i32 { print(p + 1) } else { print(0) }
}
// @@VALUE@@
srcArr[0]
// @@TYPE@@
Val
// @@PROOF@@
take(v)
// @@WANT@@
3
// @@TEST@@
v is i32
// @@HIT@@
take(v)
// @@MISS@@
print(0)
// @@VALUE2@@
srcArr2[0]
// @@TYPE2@@
Val
// @@PROOF2@@
take2(v)
// @@WANT2@@
8
