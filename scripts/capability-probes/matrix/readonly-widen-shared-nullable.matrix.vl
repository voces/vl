// D2161's close, the spelling that RUNS: a `C[]` delivered where a `readonly (C | null)[]` is
// declared shares the list, since a view can store no `null` into it. Every position must run in
// both faces; the mutable spelling of the same TYPE is `mutable-widen-refused.matrix.vl`.
//
// The proof reads only the length: the un-annotated face types `v` as `C[]`, where a `null`
// test does not check. The list is shared, so there is no converted element to verify.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type C = { n: i32 }
// @@SETUP@@
const cs: C[] = [{ n: 7 }]
// @@VALUE@@
cs
// @@TYPE@@
readonly (C | null)[]
// @@PROOF@@
print(v.length + 6)
// @@WANT@@
7
