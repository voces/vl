// D16378, ruling Q8 — a constant shift count of 32 to 63 makes an untyped literal operand `i64`,
// where the fold keeps the tree whole (a negative operand under `>>>`, a radix pattern with its
// top bit set). A count never types the operand: a typed or variable count widens nothing. The
// built-in positions deliver it at `i64`; the cells cover the untyped reads, the typed counts and
// the fixed-type operands, whose refusal stands.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
const z = 0
// @@VALUE@@
(-3) >>> (40 + 1)
// @@TYPE@@
i64
// @@PROOF@@
print(v)
// @@WANT@@
8388607
// @@CELL_untyped_print@@
// want: 8388607
print((-3) >>> (40 + 1))
// @@CELL_untyped_const@@
// want: 8388607
const u = (-3) >>> (40 + 1)
print(u)
// @@CELL_untyped_count_32@@
// want: 4294967295
print((-3) >>> (16 + 16))
// @@CELL_untyped_radix_shr@@
// want: 0
print(0xFFFFFFFF >> (40 + 1))
// @@CELL_untyped_radix_shl@@
// want: -9223372036854775808
print(0x80000000 << (16 + 16))
// @@CELL_untyped_not@@
// want: 8388607
print((~2) >>> (40 + 1))
// @@CELL_untyped_literal_count@@
// want: 8388607
print((-3) >>> 41)
// @@CELL_untyped_in_sum@@
// want: 8388608
print(((-3) >>> (40 + 1)) + 1)
// @@CELL_untyped_count_31_stays_i32@@
// want: 1
print((-3) >>> (30 + 1))
// @@CELL_decimal_folds@@
// want: 1099511627776
print(1 << 40)
// @@CELL_typed_i32_dest_refused@@
// owed: shift count 41 is out of range for an i32 operand
const c: i32 = (-3) >>> (40 + 1)
print(c)
// @@CELL_typed_i32_operand_refused@@
// owed: shift count 41 is out of range for an i32 operand
let x: i32 = -3
print(x >>> (40 + 1))
// @@CELL_count_64_refused@@
// owed: shift count 65535 is out of range for an i64 operand
print(4294967296 >> 65535)
// @@CELL_typed_count_i32_at_i64_dest@@
// want: -17179869184
function g(c: i32) {
  const w: i64 = (0xFFFFFFFF << 31) << c
  print(w)
}
g(3)
// @@CELL_typed_count_i64_at_i64_dest@@
// want: -17179869184
function g(c: i64) {
  const w: i64 = (0xFFFFFFFF << 31) << c
  print(w)
}
g(3)
// @@CELL_const_count_i32_at_i64_dest@@
// want: -17179869184
const c3: i32 = 3
const w: i64 = (0xFFFFFFFF << 31) << c3
print(w)
// @@CELL_variable_count_widens_nothing@@
// want: 256
function g(c: i64) {
  const w = 1 << c
  print(w)
}
g(40)
// @@CELL_i32_operand_i64_count@@
// want: 8
function g(x: i32, c: i64) {
  const r: i32 = x << c
  print(r)
}
g(1, 3)
