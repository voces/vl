// A list of un-annotated functions that agree, delivered at every position and read back by a
// `.map` / `.filter` callback that calls its element (D9093). The second value holds a generic
// beside an un-annotated function, which the callback's call instances at `i32`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __inc(a) { return a + 1 }
function __dbl(a) { return a * 2 }
function __id<T>(a: T): T { return a }
// @@VALUE@@
[__inc, __dbl]
// @@TYPE@@
((a: i32) => i32)[]
// @@PROOF@@
print(v.map((f) => f(3))[1])
// @@WANT@@
6
// @@TEST@@
v.filter((f) => f(3) > 4).length == 1
// @@HIT@@
print(v.map((f) => f(3))[1])
// @@MISS@@
print(0)
// @@VALUE2@@
[__id, __dbl]
// @@TYPE2@@
((a: i32) => i32)[]
// @@PROOF2@@
print(v.map((f) => f(5))[0])
// @@WANT2@@
5
