// D1669 — `__array_new__` with an i64 fill inside a generic, delivered from the instance.
//
// `arrNewIntrKind` reads the fill's rep in a FRAME: inside a monomorphized instance only the
// substituted parameter annotation names it, so the frameless arena walk in `collectA`
// answered i32 while the emitter, which has the frame, built the i64 backing.
//
// The value under test is the generic's returned `T[]` at the i64 pin, so every delivery
// position is a position the caller can put an inferred `i64[]` in.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function pick<T>(v: T): T[] {
  const out = __array_new__(2, v)
  return out
}
function big(): i64 { 7 }
// @@VALUE@@
pick(big())
// @@TYPE@@
i64[]
// @@FALLBACK@@
pick(big())
// @@TEST@@
v.length == 2
// @@HIT@@
print(2)
// @@MISS@@
print(-1)
// @@WANT@@
2
