// A record binding wider than one union arm, delivered into the union: width subtyping admits
// it at the arm whose fields are the first of its own, and it boxes under that arm's tag as the
// same reference, so a write through the binding shows through the union.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type UawA = { k: i32, legs: i32 }
type UawB = { s: string }
type UawPet = UawA | UawB
const uawSv = { k: 1, legs: 4, purr: true }
const uawSw = { k: 2, legs: 6, purr: false }
function uawLegs(p: UawPet): i32 {
  if p is UawA { return p.legs }
  -1
}
// @@VALUE@@
uawSv
// @@TYPE@@
UawPet
// @@TEST@@
uawLegs(v) >= 0
// @@HIT@@
print(uawLegs(v) + 1)
// @@MISS@@
print("b")
// @@WANT@@
5
// @@VALUE2@@
uawSw
// @@TYPE2@@
UawPet
// @@PROOF2@@
print(uawLegs(v) + 2)
// @@WANT2@@
8
