// D1710 — the litunion column's nullable-ELEMENT twin, `(K | null)[] | null`. It folds onto
// the SAME i32 atom backing as `K[] | null`, because the atom niche spends `-1` on the hole
// and needs no second wrapper; only the element's inner kind separates it from the ref family.
//
// It is the pair that decides whether a ref-element rule and a litunion rule can be told
// apart at all: `(A | null)[] | null` and `(K | null)[] | null` are one spelling shape and two
// reps, and a candidate that keys on the outer shape gets one of them wrong.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type K = "a" | "b"
function plain(): (K | null)[] { return ["a"] }
function nul1(): (K | null)[] | null { return ["b", null] }
function nul2(): (K | null)[] | null { return ["a", null] }
function firstHolder() {
  const first = { xs: plain() }
  const e = first.xs[0]
  if e != null { print(e) } else { print("hole") }
}
// @@VALUE@@
{ xs: nul1() }
// @@TYPE@@
{ xs: (K | null)[] | null }
// @@PROOF@@
const l = v.xs
if l != null {
  const e = l[0]
  if e != null { print(e) } else { print("hole") }
} else { print("none") }
// @@WANT@@
b
// @@VALUE2@@
{ xs: nul2() }
// @@TYPE2@@
{ xs: (K | null)[] | null }
// @@PROOF2@@
const l2 = v.xs
if l2 != null {
  const e2 = l2[0]
  if e2 != null { print(e2) } else { print("hole") }
} else { print("none") }
// @@WANT2@@
a
// @@SKIP@@
is_in_if: the value is a struct, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
