// D16394 — `==` / `!=` over two records of one field set whose fields are STORED apart: a
// literal union beside its base `string`, two number widths, a nullable beside a plain field, a
// list of another element, a nested record of another storage. Each such pair compares field by
// field, as the same field values compare bare (spec T4.3); the one-row struct compare had no
// lowering, so the program passed check and was refused at emit (or built an invalid module).
//
// The built-in positions deliver a `{f: "a" | "b"}` and compare it with a `{f: string}`; the
// cells below take one field kind each, every one proving `==` and `!=` true and false.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
const s: {f: string} = { f: "a" }
const t: {f: string} = { f: "b" }
// @@VALUE@@
{ f: "a" }
// @@TYPE@@
{f: "a" | "b"}
// @@TEST@@
v == s && !(v != s) && !(v == t) && v != t
// @@HIT@@
print(2)
// @@MISS@@
print(9)
// @@WANT@@
2
// @@CELL_int_float@@
// want: true
const a: {f: i32} = { f: 1 }
const b: {f: f64} = { f: 1.0 }
const c: {f: f64} = { f: 1.5 }
print(a == b && !(a != b) && !(a == c) && a != c)
// @@CELL_int_widths@@
// want: true
const a: {f: i32} = { f: 7 }
const b: {f: i64} = { f: 7 }
const c: {f: i64} = { f: 8 }
print(a == b && !(a != b) && !(a == c) && a != c)
// @@CELL_float_widths@@
// want: true
const a: {f: f32} = { f: 1.5 }
const b: {f: f64} = { f: 1.5 }
const c: {f: f64} = { f: 2.5 }
print(a == b && !(a != b) && !(a == c) && a != c)
// @@CELL_nullable_vs_plain@@
// want: true
const a: {f: i32} = { f: 1 }
const b: {f: i32 | null} = { f: 1 }
const c: {f: i32 | null} = { f: null }
print(a == b && !(a != b) && !(a == c) && a != c)
// @@CELL_nullable_string@@
// want: true
const a: {f: string} = { f: "x" }
const b: {f: string | null} = { f: "x" }
const c: {f: string | null} = { f: null }
print(a == b && !(a != b) && !(a == c) && a != c)
// @@CELL_list_element_width@@
// want: true
const a: {f: i32[]} = { f: [1, 2] }
const b: {f: f64[]} = { f: [1.0, 2.0] }
const c: {f: f64[]} = { f: [1.0] }
print(a == b && !(a != b) && !(a == c) && a != c)
// @@CELL_list_element_nullable@@
// want: true
const a: {f: i32[]} = { f: [1] }
const b: {f: (i32 | null)[]} = { f: [1] }
const c: {f: (i32 | null)[]} = { f: [null] }
print(a == b && !(a != b) && !(a == c) && a != c)
// @@CELL_nested_record@@
// want: true
const a: {g: {f: i32}} = { g: { f: 1 } }
const b: {g: {f: f64}} = { g: { f: 1.0 } }
const c: {g: {f: f64}} = { g: { f: 2.0 } }
print(a == b && !(a != b) && !(a == c) && a != c)
// @@CELL_nested_nullable_record@@
// want: true
const a: {g: {f: i32} | null} = { g: { f: 1 } }
const b: {g: {f: f64} | null} = { g: { f: 1.0 } }
const c: {g: {f: f64} | null} = { g: null }
print(a == b && !(a != b) && !(a == c) && a != c)
// @@CELL_nullable_records@@
// want: true
const a: {f: i32} | null = { f: 1 }
const b: {f: f64} | null = { f: 1.0 }
const n1: {f: i32} | null = null
const n2: {f: f64} | null = null
print(a == b && n1 == n2 && !(a == n2) && n1 != b)
// @@CELL_two_fields_mixed@@
// want: true
const a: {x: i32, y: "p" | "q"} = { x: 3, y: "q" }
const b: {x: f64, y: string} = { x: 3.0, y: "q" }
const c: {x: f64, y: string} = { x: 3.0, y: "p" }
print(a == b && !(a != b) && !(a == c) && a != c)
// @@CELL_field_order@@
// want: true
const a: {x: i32, y: string} = { x: 1, y: "z" }
const b: {y: string, x: f64} = { y: "z", x: 1.0 }
print(a == b && !(a != b))
// @@CELL_call_operands_once@@
// want: A
// want: B
// want: true
function mkA(): {f: i32} {
  print("A")
  { f: 1 }
}
function mkB(): {f: f64} {
  print("B")
  { f: 1.0 }
}
print(mkA() == mkB())
// @@CELL_function_param@@
// want: true
function same(a: {f: "a" | "b"}, b: {f: string}): boolean { a == b }
print(same({ f: "b" }, { f: "b" }) && !same({ f: "a" }, { f: "b" }))
// @@CELL_litunion_list_field@@
// want: true
const a: {f: ("a" | "b")[]} = { f: ["a"] }
const b: {f: string[]} = { f: ["a"] }
print(a == b)
