// one-literal-union-rep (owner 2026-10-13) — an INLINE string-literal union under `| null`,
// delivered to every position. It reps as the atom with the `-1` null niche, the same rep as the
// `K | null` alias spelling: a position that slots a string ref is invalid wasm, and one that
// reads the niche as a string prints an id or a null.
//
// NO `type` DECLARATION MAY BE ADDED. The test narrows away `null` and compares, the hit prints
// the member, which only a correctly widened atom survives.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function pick(n: i32): "red" | "green" | null {
  if n > 1 { return null }
  if n > 0 { return "green" }
  "red"
}
// @@VALUE@@
pick(1)
// @@TYPE@@
"red" | "green" | null
// @@TEST@@
v != null && v == "green"
// @@HIT@@
print(v ?? "none")
// @@MISS@@
print("miss")
// @@WANT@@
green
// @@VALUE2@@
pick(2)
// @@TYPE2@@
"red" | "green" | null
// @@PROOF2@@
print("c=" + (v ?? "none"))
// @@WANT2@@
c=none
