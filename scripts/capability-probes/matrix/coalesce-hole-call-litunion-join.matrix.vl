// D9561, D9562, D9563, D9700: `??` over the call of an un-annotated parameter bound at a
// function returning a numeric literal union, with a default the union's values convert to.
// The instance that cannot be null delivers the operand into the join, and the null one tests
// its box: `5000000000` joined with `0` and read at `i64`, and a null `1 | 2` taking an `f64` default.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type __LW = 1 | 2 | 5000000000
type __LN = 1 | 2
const __wn: __LW = 5000000000
const __nz: __LN | null = null
function __orZero(f) { f() ?? 0 }
function __orHalf(f) { f() ?? 2.5 }
// @@VALUE@@
__orZero(() => __wn)
// @@TYPE@@
i64
// @@TEST@@
v == 5000000000
// @@HIT@@
print(v + 1)
// @@MISS@@
print("miss")
// @@WANT@@
5000000001
// @@VALUE2@@
__orHalf(() => __nz)
// @@TYPE2@@
f64
// @@PROOF2@@
print(v / 2.0)
// @@WANT2@@
1.25
