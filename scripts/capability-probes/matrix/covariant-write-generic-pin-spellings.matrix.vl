// A write through a generic list parameter refuses a covariant argument at every spelling (D1799):
// `Circle[]` into a mutable `T[]` at `T = Shape`.
// @@PRELUDE@@
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function poison<T>(self: T[], other: T[]) {
  return other.push(self[0])
}
// @@VALUE@@
1
// @@TYPE@@
i32
// @@PROOF@@
print(v)
// @@WANT@@
1
// @@CELL_method@@
// owed: Circle[]
const shapes: Shape[] = [{ s: 1 }]
const circles: Circle[] = [{ r: 7 }]
shapes.poison(circles)
print(circles.length)
// @@CELL_direct@@
// owed: Circle[]
const shapes: Shape[] = [{ s: 1 }]
const circles: Circle[] = [{ r: 7 }]
poison(shapes, circles)
print(circles.length)
// @@CELL_nested_generic@@
// owed: Circle[]
function via<U>(a: U[], b: U[]) { return poison(a, b) }
const shapes: Shape[] = [{ s: 1 }]
const circles: Circle[] = [{ r: 7 }]
via(shapes, circles)
print(circles.length)
// @@CELL_hole@@
// owed: Circle[]
function H(f, a, b) { return f(a, b) }
const shapes: Shape[] = [{ s: 1 }]
const circles: Circle[] = [{ r: 7 }]
H(poison, shapes, circles)
print(circles.length)
// @@CELL_loop@@
// owed: Circle[]
const shapes: Shape[] = [{ s: 1 }]
const circles: Circle[] = [{ r: 7 }]
for i in 0 to 1 { shapes.poison(circles) }
print(circles.length)
