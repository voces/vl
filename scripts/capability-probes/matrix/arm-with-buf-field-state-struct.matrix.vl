// D1579, THE REPORTER'S OWN SHAPE (the glean session, VL-032) — a lexer answers
// `Tokens | LexError` where `Tokens` carries a `Buf` from `std:buffer`, and the parser wants
// a state struct holding a `Tokens` field. Every std container is a struct, so an arm holding
// one hit the cross-table layout guard and the consumer wrapped its payload a second time.
//
// THIS IS THE UNION-DELIVERY FACE: the value is `Tokens | LexError`, and the arm reaches its
// struct FIELD inside the proof (`peek({ toks: v, pos: … })`).
// `arm-with-struct-field-as-field` delivers the HOLDER instead, so between them the field's
// storage is graded at every position on both sides of the seam.
//
// THE PROOF GOES THROUGH THE BUFFER, not just the scalar beside it: `loadI32` off the arm's
// `Buf` field proves the field's slot names the heap the buffer was built under, which a cell
// reading only `v.count` would pass over. Two offsets, so a stale base traps or misreads.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
import { Buf, Buffer, loadI32, storeI32 } from "std:buffer"

type Tokens = { buf: Buf, count: i32 }
type LexError = { msg: string, line: i32 }
type ParserState = { toks: Tokens, pos: i32 }

function lex(ok: boolean): Tokens | LexError {
  if !ok { return { msg: "lex", line: 1 } }
  const b = Buffer(16)
  storeI32(b, 0, 40)
  storeI32(b, 4, 2)
  return { buf: b, count: 2 }
}

function peek(st: ParserState): i32 {
  return loadI32(st.toks.buf, st.pos * 4) + st.toks.count
}
// @@VALUE@@
lex(true)
// @@TYPE@@
Tokens | LexError
// @@TEST@@
v is Tokens
// @@HIT@@
print(peek({ toks: v, pos: 0 }) + peek({ toks: v, pos: 1 }))
// @@MISS@@
print(0 - 1)
// @@WANT@@
46
// @@FALLBACK@@
lex(false)
// @@VALUE2@@
lex(true)
// @@TYPE2@@
Tokens | LexError
// @@PROOF2@@
if v is Tokens { print(peek({ toks: v, pos: 1 })) } else { print(0 - 1) }
// @@WANT2@@
4
