// D11221's scalar twin — `w as! N2` with `w: N3`. Both unions rep as the bare `i32`, so the cast
// is a member test of the scalar itself and yields it unchanged.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type N2 = 1 | 2
type N3 = 1 | 2 | 3
function mk(k: i32): N3 {
  if k == 0 { return 3 }
  if k == 1 { return 1 }
  2
}
// @@VALUE@@
mk(2) as! N2
// @@TYPE@@
N2
// @@TEST@@
v == 2
// @@HIT@@
print(v + 10)
// @@MISS@@
print(0)
// @@WANT@@
12
// @@VALUE2@@
mk(1) as! N2
// @@TYPE2@@
N2
// @@PROOF2@@
print(v + 20)
// @@WANT2@@
21
