// D10030 — `k?.get(key)` over a nullable map: the guarded read takes the map's non-null type, so
// it lowers as `k[key]` under the `?.` guard. Before the fix every position was a loud emit reject.
//
// The proof reads the found value through `??`, so a cell that reads the wrong rep prints a wrong
// value rather than refusing. The second instance is an f64-valued map.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function mkK(): {[string]: i32} | null {
  const m: {[string]: i32} = Map()
  m["a"] = 3
  m
}
function mkF(): {[string]: f64} | null {
  const m: {[string]: f64} = Map()
  m["a"] = 1.5
  m
}
const gk = mkK()
const gf = mkF()
// @@VALUE@@
gk?.get("a")
// @@TYPE@@
i32 | null
// @@TEST@@
v != null
// @@HIT@@
print(v ?? 0)
// @@MISS@@
print(0)
// @@WANT@@
3
// @@VALUE2@@
gf?.get("a")
// @@TYPE2@@
f64 | null
// @@PROOF2@@
print(v ?? 0.0)
// @@WANT2@@
1.5
