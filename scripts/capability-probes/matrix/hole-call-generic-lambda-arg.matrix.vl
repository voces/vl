// D6543: an un-annotated lambda handed through a hole to a declared generic's `(T) => U`
// parameter, `T` bound by the call's other argument and `U` by the lambda's body there.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __app<T, U>(f: (T) => U, v: T): U { f(v) }
function __app2<T, U>(v: T, f: (T) => U): U { f(v) }
function __via(a) { return a((n) => n + 1, 2) }
function __via2(a) { return a(2.5, (x) => x * 2.0) }
// @@VALUE@@
__via(__app)
// @@TYPE@@
i32
// @@PROOF@@
print(v)
// @@WANT@@
3
// @@TEST@@
v == 3
// @@HIT@@
print(v)
// @@MISS@@
print(0)
// @@VALUE2@@
__via2(__app2)
// @@TYPE2@@
f64
// @@PROOF2@@
print(v + 1.0)
// @@WANT2@@
6
