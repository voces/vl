// A map of un-annotated functions pushed onto a list literal of maps of a set and a smaller set,
// the functions called at two types: the pushed map takes the list's set as the literal's own
// elements do (D15395).
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const fnMap = Map()
fnMap.set("a", inc0)
fnMap.set("b", half)
const m2 = Map()
m2.set("a", half)
// @@VALUE@@
[m2, fnMap]
// @@TYPE@@
({ [string]: (a: f64) => f64 })[]
