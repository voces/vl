// D2850: a record built by a hole constructor, `mk(a)` returning `{ f: a }`, at an i32 pin.
// The type parameter is left OPEN: nothing annotates `mk`, so the instance alone names the row.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function mk(a) { return { f: a } }
// @@VALUE@@
mk(3)
// @@TYPE@@
{ f: i32 }
// @@TEST@@
v.f == 3
// @@HIT@@
print("ok")
// @@MISS@@
print("no")
// @@WANT@@
ok
// @@VALUE2@@
mk("x")
// @@TYPE2@@
{ f: string }
// @@PROOF2@@
print(v.f + "y")
// @@WANT2@@
xy
