// A closure whose inner closure writes the outer maker's `let`, delivered and called twice.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __mk() {
  let n = 0
  return () => {
    const inner = () => { n = n + 5 }
    inner()
    return n
  }
}
// @@VALUE@@
__mk()
// @@TYPE@@
() => i32
// @@PROOF@@
v()
print(v())
// @@WANT@@
10
