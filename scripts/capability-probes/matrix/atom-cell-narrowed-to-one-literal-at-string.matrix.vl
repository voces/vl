// An atom cell narrowed to one literal, whose read the checker types at that literal's string
// while the cell holds the id, delivered to every position at a `string`: the id decodes to its
// member string, as each legacy position widens it.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type __K = "ab" | "cd"
function __mk(i: i32): __K { return if i > 0 { "cd" } else { "ab" } }
// @@SETUP@@
const __q: __K = __mk(0)
// @@GUARD@@
__q == "ab"
// @@FALLBACK@@
"q"
// @@VALUE@@
__q
// @@TYPE@@
string
// @@PROOF@@
print(v)
// @@WANT@@
ab
// @@TEST@@
v == "ab"
// @@HIT@@
print("ab")
// @@MISS@@
print("no")
