// A literal binding a delivery builds at a wider record (`wideJ: J[] = [o]` builds `o` at `J`),
// stored into an un-annotated container that also holds a record literal at its own row (D15718).
// The built-in positions deliver `o` itself; the cells store it beside a literal, in both orders.
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type J = { f: i32 | null }
const o = { f: 4 }
const wideJ: J[] = [o]
// @@VALUE@@
o
// @@TYPE@@
{ f: i32 }
// @@PROOF@@
print(v.f)
// @@WANT@@
4
// @@SKIP@@
is_in_if: the value is a record, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
// @@CELL_map_set_after_literal@@
const m = Map()
m.set("b", { f: 5 })
m.set("a", __V__)
print(m.get("a")?.f ?? 0)
// @@CELL_map_set_before_literal@@
const m = Map()
m.set("a", __V__)
m.set("b", { f: 5 })
print(m.get("a")?.f ?? 0)
// @@CELL_map_index_after_literal@@
const m = Map()
m["b"] = { f: 5 }
m["a"] = __V__
print(m["a"]?.f ?? 0)
// @@CELL_push_after_literal@@
const xs = [{ f: 5 }]
xs.push(__V__)
print(xs[1].f)
// @@CELL_list_part_beside_literal@@
const xs = [{ f: 5 }, __V__]
print(xs[1].f)
