// D11221's string `as?` twin — `u as? K` out of a `K | i32` box. A hit is the string tag with a
// member payload, converted to the atom; a miss is the atom's `null`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type K = "a" | "b"
function mk(k: i32): K | i32 {
  if k == 0 { return 7 }
  if k == 1 { return "a" }
  "b"
}
// @@VALUE@@
mk(2) as? K
// @@TYPE@@
K | null
// @@TEST@@
v != null
// @@HIT@@
print(v + "!")
// @@MISS@@
print("miss")
// @@WANT@@
b!
// @@VALUE2@@
mk(0) as? K
// @@TYPE2@@
K | null
// @@PROOF2@@
print(v == null)
// @@WANT2@@
true
