// A generic function held in a list element, a record field and a call result, called inside a
// generic body whose type parameter has the callees' name and is bound to another type (D9190).
// The callees' own parameter is theirs, so the instance's binding of the shared name does not
// close it.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function idg<T>(t: T): T { return t }
function kg<T>(t: T): T { return t + t }
const on = [1].length > 0
function pick() { return kg }
function g<T>(v: T): string {
  const fs = [if on { kg } else { idg }]
  const r = { h: if on { idg } else { kg } }
  return fs[0]("s") + r.h("t") + pick()("u")
}
function g2<T>(v: T): T {
  const fs = [if on { kg } else { idg }]
  return fs[0](v)
}
// @@VALUE@@
g(3)
// @@TYPE@@
string
// @@PROOF@@
print(v)
// @@WANT@@
sstuu
// @@VALUE2@@
g2(2.5)
// @@TYPE2@@
f64
// @@PROOF2@@
print(v * 2.0)
// @@WANT2@@
10
