// `v is K[]` over `i32[] | string[]`, `v` from the string arm. Element kinds that
// store alike share a box tag, and the test must still answer by the value (D17052).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type S = "a" | "b"
type K = 1 | 2
type P = { q: i32 }
function mk(c: boolean): i32[] | string[] {
  const a: i32[] = [1, 2]
  const b: string[] = ["q"]
  if c { return b }
  return a
}
// @@VALUE@@
mk(true)
// @@TYPE@@
i32[] | string[]
// @@TEST@@
v is K[]
// @@HIT@@
print(true)
// @@MISS@@
print(false)
// @@WANT@@
false
