// An `==`/`!=` whose operand is a parenthesised `??` over a literal-union place: legacy's atom
// compare unwraps the paren to ask the `??`'s own rep, so the IR asks the same node; a `??` over a
// plain string stays the string compare. Each cell runs the compare in a generic body (its paren
// re-made by the instance's pin pass) and in a plain function, at a member and at null.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type K = "a" | "b"
function idK<T>(x: T): T { return x }
// @@VALUE@@
idK(1)
// @@TYPE@@
i32
// @@PROOF@@
print(v)
// @@WANT@@
1
// @@CELL_coal_default_off_member_eq_generic@@
// want: true then false
function g<T>(x: T): boolean {
  let s: K | null = null
  s = x
  return (s ?? "n") == "a"
}
const ka: K = "a"
const kn: K | null = null
print(g(ka))
print(g(kn))
// @@CELL_coal_default_off_member_eq_plain@@
// want: true then false
function p(s: K | null): boolean { return (s ?? "n") == "a" }
print(p("a"))
print(p(null))
// @@CELL_lit_eq_coal_member_default_generic@@
// want: true then false
function g<T>(x: T): boolean {
  let s: K | null = null
  s = x
  return "a" == (s ?? "b")
}
const ka: K = "a"
const kn: K | null = null
print(g(ka))
print(g(kn))
// @@CELL_lit_eq_coal_member_default_plain@@
// want: true then false
function p(s: K | null): boolean { return "a" == (s ?? "b") }
print(p("a"))
print(p(null))
// @@CELL_coal_member_default_ne_generic@@
// want: false then true
function g<T>(x: T): boolean {
  let s: K | null = null
  s = x
  return (s ?? "b") != "a"
}
const ka: K = "a"
const kn: K | null = null
print(g(ka))
print(g(kn))
// @@CELL_coal_member_default_ne_plain@@
// want: false then true
function p(s: K | null): boolean { return (s ?? "b") != "a" }
print(p("a"))
print(p(null))
