// @@CELL_non_atom_coal_generic@@
// want: true then false
function h<T>(x: T): boolean {
  let t: string | null = null
  t = x
  return (t ?? "x") == "a"
}
const sa: string | null = "a"
const sn: string | null = null
print(h(sa))
print(h(sn))
// @@CELL_non_atom_coal_plain@@
// want: true then false
function q(t: string | null): boolean { return (t ?? "x") == "a" }
