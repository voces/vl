// D2781: `is` against a record whose field union names the receiver's member in another order
// tests that member, at every position the value reaches.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type Q = { a: i32 | string }
// @@VALUE@@
{ a: 7 }
// @@TYPE@@
{ a: string | i32 } | string
// @@WANT@@
7
// @@TEST@@
v is { a: i32 | string }
// @@HIT@@
print(v.a)
// @@MISS@@
print(0)
