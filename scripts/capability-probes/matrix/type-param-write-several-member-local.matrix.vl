// D3446: a null `string | i32 | null` handed from every position to a generic whose `T` stays
// open, written into a local declared at that union. The pin decides whether the local is
// null, so the body's null test and `??` read it at the pin rather than folding.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function mkv(): string | i32 | null { null }
function mkv2(): string | i32 | null { 4 }
function __tvw<T>(x: T): string {
  let s: string | i32 | null = 1
  s = x
  const d = s ?? "n"
  if s == null && d == "n" { return "null n" }
  "set"
}
// @@VALUE@@
mkv()
// @@TYPE@@
string | i32 | null
// @@WANT@@
null n
// @@TEST@@
__tvw(v) == "null n"
// @@HIT@@
print(__tvw(v))
// @@MISS@@
print("miss")
// @@VALUE2@@
mkv2()
// @@TYPE2@@
string | i32 | null
// @@PROOF2@@
print(__tvw(v))
// @@WANT2@@
set
