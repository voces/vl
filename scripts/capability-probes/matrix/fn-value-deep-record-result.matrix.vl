// D9784 — a function value whose result is a record that nests another record twice over
// ten levels. The record's spelling passes the length the shape-row lookup compares, so the
// call's function type and its receiver must come from the arena row, not the render.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type A0 = {x: i32}
type A1 = {l: A0, r: A0}
type A2 = {l: A1, r: A1}
type A3 = {l: A2, r: A2}
type A4 = {l: A3, r: A3}
type A5 = {l: A4, r: A4}
type A6 = {l: A5, r: A5}
type A7 = {l: A6, r: A6}
type A8 = {l: A7, r: A7}
type A9 = {l: A8, r: A8}
type A10 = {l: A9, r: A9}
function mk(x: i32): A10 {
  const a0 = { x: x }
  const a1 = { l: a0, r: a0 }
  const a2 = { l: a1, r: a1 }
  const a3 = { l: a2, r: a2 }
  const a4 = { l: a3, r: a3 }
  const a5 = { l: a4, r: a4 }
  const a6 = { l: a5, r: a5 }
  const a7 = { l: a6, r: a6 }
  const a8 = { l: a7, r: a7 }
  const a9 = { l: a8, r: a8 }
  return { l: a9, r: a9 }
}
// @@VALUE@@
mk
// @@TYPE@@
(x: i32) => A10
// @@FALLBACK@@
(x: i32) => mk(0)
// @@PROOF@@
print(v(5).l.l.l.l.l.l.l.l.l.r.x)
// @@WANT@@
5
