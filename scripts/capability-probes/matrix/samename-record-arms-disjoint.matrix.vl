// D4056 — two record arms share the field name `n` with disjoint field types. `is` tests the
// value (spec Q4 (c)), so the B-built value answers `is A` false and reads its string.
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type A = { n: i32 }
type B = { n: string }
function pick(a: boolean): A | B {
  if a { return { n: 3 } }
  { n: "s" }
}
// @@VALUE@@
pick(false)
// @@TYPE@@
A | B
// @@TEST@@
v is A
// @@HIT@@
print(v.n + 1)
// @@MISS@@
print("B " + v.n)
// @@WANT@@
B s
// @@VALUE2@@
pick(true)
// @@TYPE2@@
A | B
// @@PROOF2@@
if v is B { print("wrong") } else { print(v.n * 10) }
// @@WANT2@@
30
