// `??` over a nullable function value (D3373): `f(c) ?? d` is the closure's own `(ref null $clo)`
// tested by `br_on_non_null`, so the result is a callable function. The proof calls it, so a
// delivery that keeps the wrong arm, or loses the captured environment, prints otherwise.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function f(k: i32): ((q: i32) => i32) | null {
  if k < 0 { return null }
  return (q: i32) => q + k
}
const bump = 100
// @@VALUE@@
f(-1) ?? ((q: i32) => q + bump)
// @@TYPE@@
(q: i32) => i32
// @@PROOF@@
print(v(1))
// @@WANT@@
101
// @@VALUE2@@
f(5) ?? ((q: i32) => q + bump)
// @@TYPE2@@
(q: i32) => i32
// @@PROOF2@@
print(v(1))
// @@WANT2@@
6
