// A `.map` whose callback returns a nullable list builds a ref list of that `| null` row
// (D12901). The second instance maps a list of string lists to a nullable string list, so a
// result read at the source's row cannot print the answer.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function g(k: i32): i32[] | null { if k > 0 { [k, k + 1] } else { null } }
const nss: string[][] = [["a"], ["b", "c"]]
// @@VALUE@@
[0, 4].map((k) => g(k))
// @@TYPE@@
(i32[] | null)[]
// @@PROOF@@
const q1 = v[1]
const q0 = v[0]
if q1 != null && q0 == null { print(v.length + q1[1]) } else { print(-1) }
// @@WANT@@
7
// @@VALUE2@@
nss.map((x): string[] | null => if x.length > 1 { x } else { null })
// @@TYPE2@@
(string[] | null)[]
// @@PROOF2@@
const q1 = v[1]
const q0 = v[0]
if q1 != null && q0 == null { print(q1[1]) } else { print("no") }
// @@WANT2@@
c
