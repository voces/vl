// D10091: a map read's `??` with an `f64` default in a recursive function, read at `f64`: a hit
// widens the stored `i32`, a miss is the default. The `??` itself joins as `i32 | f64` (D10090).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __cwM(m: Map<string, i32>, k: string, d: f64, n: i32) {
  if n > 0 { return __cwM(m, k, d, n - 1) }
  return m.get(k) ?? d
}
const __cwMap: Map<string, i32> = Map()
__cwMap.set("k", 5)
// @@VALUE@@
__cwM(__cwMap, "k", 1.5, 1)
// @@TYPE@@
f64
// @@PROOF@@
const __cwW: f64 = v
print(__cwW / 2)
// @@WANT@@
2.5
// @@VALUE2@@
__cwM(__cwMap, "z", 1.5, 1)
// @@TYPE2@@
f64
// @@PROOF2@@
print(v)
