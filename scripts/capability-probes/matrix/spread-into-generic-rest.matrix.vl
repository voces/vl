// A spread delivered into a GENERIC rest parameter, whose element HOLE the arguments pin.
//
// The sibling template (`spread-into-rest-parameter.matrix.vl`) pins a CONCRETE `i32[]` rest,
// so it never binds the hole at all — and that blindness is why a mixed-type generic rest
// shipped as check-clean invalid wasm. A matrix that fixes the element type cannot see a
// defect whose ingredient is the element being INFERRED, which is the annotate-everything
// blindness one level up.
//
// The value pins `T` from a spread source plus a plain argument of the same type, so the
// hole binds through both routes the design has: `bindGenWalk` over the ARRAY for the
// spread, and over the ELEMENT for the plain one.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function collect<T>(...xs: T[]): T[] { return xs }
const src: i32[] = [4, 5, 6]
const words: string[] = ["a", "b"]
// @@VALUE@@
collect(3, ...src)
// @@TYPE@@
i32[]
// @@PROOF@@
print(v.length * 100 + v[0] * 10 + v[3])
// @@WANT@@
436
// @@VALUE2@@
collect("z", ...words)
// @@TYPE2@@
string[]
// @@PROOF2@@
print(v.length)
// @@WANT2@@
3
// @@SKIP@@
is_in_if: the value is a list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
