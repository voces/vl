// D16600 — a narrowing cast over a value join every tail of which its domain holds cannot
// miss, so `as u8` over it is the infallible cast a bounded bare operand is, delivered
// anywhere, module scope included. The PROOF adds, so a wrapped or widened cell differs.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function flag(): boolean { return 1 == 2 }
function pick(): i32 { return 2 }
// @@VALUE@@
(if flag() { 1 } else { 0xFF }) as u8
// @@TYPE@@
i32
// @@PROOF@@
print(v + 1)
// @@WANT@@
256
// @@TEST@@
v > 100
// @@HIT@@
print(v + 1)
// @@MISS@@
print(0)
// @@VALUE2@@
(match pick() { 1 => 3, _ => 200 }) as u8
// @@TYPE2@@
i32
// @@PROOF2@@
print(v + 1)
// @@WANT2@@
201
