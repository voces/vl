// D4932: a `{ x: i32 }[] | i32[]` return whose record arm is spelled by shape while a declared
// `P` of that shape exists; every position has to read the record arm back under one slot.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type P = { x: i32 }
function wrapA(t: { x: i32 }): { x: i32 }[] | i32[] { [t] }
// @@VALUE@@
wrapA({ x: 4 })
// @@TYPE@@
{ x: i32 }[] | i32[]
// @@PROOF@@
const g = v
if g is P[] { for e in g { print(e.x) } } else { print("N") }
// @@WANT@@
4
// @@TEST@@
v is P[]
// @@HIT@@
for e in v { print(e.x) }
// @@MISS@@
print("N")
