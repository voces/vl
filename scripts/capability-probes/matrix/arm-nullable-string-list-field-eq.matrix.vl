// D15054: `==` over a union whose arm has a `(string | null)[]` field holding a null, and a
// nullable one. The arm's nulls are null references, so its string-list compare tests each
// element pair for null. The second instance differs only at the null.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type NslU = { k: i32 } | { xs: (string | null)[], ys: (string | null)[] | null }
const nslQ: NslU = { xs: ["x", null], ys: ["z", null] }
function nslMk(s: string | null): NslU {
  return { xs: ["x", s], ys: ["z", null] }
}
// @@VALUE@@
nslMk(null)
// @@TYPE@@
NslU
// @@TEST@@
v == nslQ
// @@HIT@@
print("same")
// @@MISS@@
print("differs")
// @@WANT@@
same
// @@VALUE2@@
nslMk("y")
// @@TYPE2@@
NslU
// @@PROOF2@@
print(v == nslQ)
// @@WANT2@@
false
