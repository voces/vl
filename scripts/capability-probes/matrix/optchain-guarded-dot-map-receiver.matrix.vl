// A5 / D1815 — the guarded chain over a MAP READ receiver: `m["k"]?.y.z`. A miss is a null,
// so the guard covers both the absent key and the chain below it, and the leaf still carries
// the `| null` exactly once.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type Leaf = { z: i32 }
type Inner = { y: Leaf }
const m: {[string]: Inner} = Map()
m["k"] = { y: { z: 42 } }
// @@VALUE@@
m["k"]?.y.z
// @@TYPE@@
i32 | null
// @@FALLBACK@@
null
// @@PROOF@@
print(v ?? 0)
// @@WANT@@
42
