// A record whose field is a list of function records: a new record is pushed through the field,
// then every element's function is called. 1+1 + 1*2 = 4.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __inc(n: i32): i32 { return n + 1 }
function __dbl(n: i32): i32 { return n * 2 }
// @@VALUE@@
{ rs: [{ f: __inc }] }
// @@TYPE@@
{rs: {f: (n: i32) => i32}[]}
// @@PROOF@@
v.rs.push({ f: __dbl })
let c = 0
for r in v.rs { c = c + r.f(1) }
print(c)
// @@WANT@@
4
