// D1630 — `__array_new__` filled with a UNION-typed value, the shape a length-first array
// constructor exists for: size the table, fill it with a placeholder, write the slots later.
// A union answers none of the fill ladder's questions, so the kind now comes off the
// destination's own rep.
//
// THE FILL MUST COME FROM A CALL. A struct LITERAL under the same annotation is a loud
// refusal instead, so a literal-fill version of this template grades a different cell.
//
// The PROOF narrows the element back out and reads a field through it, so a list allocated at
// the wrong backing traps or prints the wrong number rather than passing.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type AnfNode = { count: i32, symbol: i32 }
function anfMk(): AnfNode | null { return { count: 1, symbol: 2 } }
function anfMk2(): AnfNode | null { return { count: 3, symbol: 4 } }
// @@SETUP@@
const anfSeed: AnfNode | null = anfMk()
// @@VALUE@@
__array_new__(2, anfSeed)
// @@TYPE@@
(AnfNode | null)[]
// @@PROOF@@
const anfE = v[1]
if anfE != null { print(anfE.symbol) }
// @@WANT@@
2
// @@VALUE2@@
__array_new__(2, anfMk2())
// @@TYPE2@@
(AnfNode | null)[]
// @@PROOF2@@
const anfF = v[1]
if anfF != null { print(anfF.symbol + 1) }
// @@WANT2@@
5
