// @@PROOF@@
const __m = Map()
__m.set("k", id)
__m.set("k", __inc)
const __n = Map()
__n.set("a", v)
const __r = __n.get("a")
const __s = __m.get("k")
if __r != null && __s != null {
  print(__s(2) * 100 + __r("ab").length)
}
