// A closure over a `let` seeded from an un-annotated parameter, pinned at `f64` by the call.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __mk(start) {
  let n = start
  return () => {
    n = n + 1
    return n
  }
}
// @@VALUE@@
__mk(1.5)
// @@TYPE@@
() => f64
// @@PROOF@@
v()
print(v())
// @@WANT@@
3.5
