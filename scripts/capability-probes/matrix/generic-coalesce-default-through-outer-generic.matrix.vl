// D16946: a generic `__pc` whose `??` default is an `i32` list, called from inside another generic
// with its element open. The `i32` instance is one list and is delivered everywhere; a `boolean`
// or `string` instance joins two lists, and the outer call is refused at check as the direct one is.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __pc<T>(xs: T[] | null) { return xs ?? [1] }
function __p<T>(t: T, c: boolean) {
  let a: T[] | null = null
  if c { a = [t, t] }
  return __pc(a)
}
function __p2<T>(t: T, c: boolean) { return __p(t, c) }
// @@VALUE@@
__p2(5, true)
// @@TYPE@@
i32[]
// @@PROOF@@
print(v.length)
// @@WANT@@
2
// @@TEST@@
v.length == 2
// @@HIT@@
print(2)
// @@MISS@@
print(0)
// @@CELL_bool_depth1@@
// owed: the branches of an `if`, `match` or `??` join
const v = __p(true, true)
print(v.length)
// @@CELL_bool_depth2@@
// owed: the branches of an `if`, `match` or `??` join
const v = __p2(false, true)
print(v.length)
// @@CELL_string_depth1@@
// owed: the branches of an `if`, `match` or `??` join
const v = __p("s", false)
print(v.length)
// @@CELL_i32_default@@
// want: 1
const v__A__ = __p(4, false)
print(v.length)
// @@CELL_i32_in_list_literal@@
// want: 1
const v = [__p(4, false)]
print(v.length)
