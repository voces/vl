// D15445: a `const` record literal of a hole parameter, called
// through the holder at one type, at two types, and beside a direct call of the parameter, in a
// hole body, through an un-written `let` copy, and in an annotated generic body. Every cell
// prints `18`, then `9`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __same<T>(k: T): T { k }
function __atOne(a) {
  const r = { f: a }
  return r.f(4)
}
function __atTwo(a) {
  const r = { f: a }
  const s: string = r.f("v")
  return r.f(3) + s.length
}
function __atBoth(a) {
  const r = { f: a }
  return r.f("vv").length + a(5)
}
function __viaLet(a) {
  let b = a
  const r = { f: b }
  const s: string = r.f("xy")
  return r.f(1) + s.length
}
function __typed<G>(a: G) {
  const r = { f: a }
  const s: string = r.f("abc")
  return r.f(6) + s.length
}
// @@VALUE@@
__atOne(__same) + __atTwo(__same) + __atBoth(__same) + __viaLet(__same)
// @@TYPE@@
i32
// @@PROOF@@
print(v)
// @@WANT@@
18
// @@TEST@@
v == 18
// @@HIT@@
print(v)
// @@MISS@@
print(0)
// @@VALUE2@@
__typed(__same)
// @@TYPE2@@
i32
// @@PROOF2@@
print(v)
// @@WANT2@@
9
