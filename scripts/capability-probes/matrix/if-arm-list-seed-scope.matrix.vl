// D5370 — a value `if` (VALUE) joining two record lists, or a `match` (VALUE2) joining two
// f64 lists, at every delivery position and in both faces. The arm builds its list at the
// join's rep; that seed must end with the arm, so the PROOF's later `for` over a string
// literal, which has no destination of its own, builds a string list.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type Item = { a: i32 }
const W: Item = { a: 1 }
const X: Item = { a: 2 }
function falsy() { 1 == 2 }
// @@VALUE@@
if falsy() { [W] } else { [W, X] }
// @@TYPE@@
Item[]
// @@PROOF@@
const r = v
let s = ""
for p in ["p", "q"] { s = s + p }
print("\{s}\{r[1].a}")
// @@WANT@@
pq2
// @@VALUE2@@
match W.a { 1 => [2.5, 3.5], _ => [1.5] }
// @@TYPE2@@
f64[]
// @@PROOF2@@
const r2 = v
let s2 = ""
for p in ["p", "q"] { s2 = s2 + p }
print("\{s2}\{r2[1]}")
// @@WANT2@@
pq3.5
// @@SKIP@@
is_in_if: the value is a list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
