// D2493 — two maps of one representation in one union: each has its own box tag.
// The proof reads, writes, deletes, counts and walks the narrowed map, so a box tagged
// by its struct rather than its member type answers the wrong arm and prints wrong.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type L = "p" | "q"
function mka(): {[string]: i32} {
  const m: {[string]: i32} = Map()
  m.set("k1", 10)
  m.set("k2", 20)
  m
}
function mkb(): {[string]: boolean} {
  const m: {[string]: boolean} = Map()
  m.set("k1", true)
  m.set("k2", false)
  m
}
function pick(n: i32): {[string]: i32} | {[string]: boolean} {
  if n > 0 { return mkb() }
  return mka()
}
// @@VALUE@@
pick(1)
// @@TYPE@@
{[string]: i32} | {[string]: boolean}
// @@TEST@@
v is {[string]: i32}
// @@HIT@@
print("wrong")
// @@MISS@@
print(v.length)
print(v.has("k1"))
print((v.get("k1") ?? false))
v.set("k3", true)
print(v.length)
v.delete("k2")
print(v.has("k2"))
let c = 0
for kk in v { c = c + 1 }
print(c)
print((v["k3"] ?? false))
// @@WANT@@
2 then true then true then 3 then false then 2 then true
// @@VALUE2@@
pick(0)
// @@TYPE2@@
{[string]: i32} | {[string]: boolean}
// @@PROOF2@@
if v is {[string]: i32} {
  print(v.length)
  print(v.has("k1"))
  print((v.get("k1") ?? -1))
  v.set("k3", 30)
  print(v.length)
  v.delete("k2")
  print(v.has("k2"))
  let c = 0
  for kk in v { c = c + 1 }
  print(c)
  print((v["k3"] ?? -1))
} else { print("wrong") }
// @@WANT2@@
2 then true then 10 then 3 then false then 2 then 30
