// An element of a list a kept maker's build stores at a wider record `J`, read through a `for … in`
// loop variable or a `map`/`filter` callback's parameter and handed on at the element type
// `{ f: null }`. It is read where an index read is (D14532, D16783); the value cells deliver the
// index read itself, the control.
// @@PRELUDE@@
type J = { f: i32 | null }
function mk2() { return { f: null } }
const dA: J = mk2()
const src = [mk2()]
// @@VALUE@@
src[0]
// @@TYPE@@
{ f: null }
// @@PROOF@@
print(v.f)
// @@WANT@@
null
// @@CELL_loop_arg@@
// want: null
function show(z: { f: null }) { print(z.f) }
for y in src { show(y) }
// @@CELL_loop_arg_indexed@@
// want: null
function show(z: { f: null }) { print(z.f) }
for y, i in src { show(y) }
// @@CELL_loop_arg_in_fn@@
// want: null
function show(z: { f: null }) { print(z.f) }
function each() {
  for y in src { show(y) }
}
each()
// @@CELL_loop_arg_in_generic@@
// want: null then 3
function show(z: { f: null }) { print(z.f) }
function each<T>(t: T): T {
  for y in src { show(y) }
  return t
}
print(each(3))
// @@CELL_loop_over_filter@@
// want: null
function show(z: { f: null }) { print(z.f) }
for y in src.filter((q) => q.f == null) { show(y) }
// @@CELL_loop_two_params@@
// want: null then 1
function show2(z: { f: null }, n: i32) {
  print(z.f)
  print(n)
}
for y in src { show2(y, 1) }
// @@CELL_loop_field_read@@
// want: null
for y in src { print(y.f) }
// @@CELL_loop_binding_un_annotated@@
// want: null
function show(z: { f: null }) { print(z.f) }
for y in src {
  const z = y
  show(z)
}
// @@CELL_loop_return@@
// want: null
function first(): { f: null } | null {
  for y in src { return y }
  return null
}
const fv = first()
if fv != null { print(fv.f) }
// @@CELL_loop_nested_literal@@
// want: null
function show(z: { f: null }) { print(z.f) }
for y in src {
  for w in [y] { show(w) }
}
// @@CELL_filter_cb_arg@@
// want: null then 1
function show(z: { f: null }) { print(z.f) }
const r = src.filter((y) => {
  show(y)
  return true
})
print(r.length)
// @@CELL_map_cb_arg@@
// want: null then 1
function show(z: { f: null }) { print(z.f) }
const r = src.map((y) => {
  show(y)
  return 1
})
print(r[0])
// @@CELL_filter_cb_nested_fn@@
// want: null then 1
function show(z: { f: null }) { print(z.f) }
const r = src.filter((y) => {
  const go = () => show(y)
  go()
  return true
})
print(r.length)
// @@CELL_index_var_control@@
// want: null
function show(z: { f: null }) { print(z.f) }
let i = 0
while i < src.length {
  show(src[i])
  i = i + 1
}
// @@CELL_loop_literal_of_index@@
// want: null
function show(z: { f: null }) { print(z.f) }
for w in [src[0]] { show(w) }
// @@CELL_loop_literal_mixed@@
// want: null then null
function show(z: { f: null }) { print(z.f) }
for w in [src[0], { f: null }] { show(w) }
// @@CELL_loop_literal_binding@@
// want: null
function show(z: { f: null }) { print(z.f) }
const ws = [src[0]]
for w in ws { show(w) }
// @@CELL_callback_over_literal@@
// want: 1
print([src[0], { f: null }].filter((y: { f: null }) => y.f == null).length - 1)
// @@CELL_loop_literal_only_fresh@@
// want: null
function show(z: { f: null }) { print(z.f) }
for w in [{ f: null }] { show(w) }
// @@CELL_loop_alias_let@@
// want: null
function show(z: { f: null }) { print(z.f) }
for y in src {
  let z = y
  show(z)
}
// @@CELL_loop_alias_twice@@
// want: null
function show(z: { f: null }) { print(z.f) }
for y in src {
  const z = y
  const w = z
  show(w)
}
// @@CELL_loop_alias_field@@
// want: null
for y in src {
  const z = y
  print(z.f)
}
// @@CELL_loop_alias_in_fn@@
// want: null
function show(z: { f: null }) { print(z.f) }
function go() {
  for y in src {
    const z = y
    show(z)
  }
}
go()
// @@CELL_loop_alias_plain_list@@
// want: null
function show(z: { f: null }) { print(z.f) }
const plain = [{ f: null }]
for y in plain {
  const z = y
  show(z)
}
