// D2197 — `for … in` over an un-annotated parameter, which each call pins: the loop variables are
// holes the pin resolves as the typed loop binds them, an array's element and index, a map's key
// and value, a string's code point. The built-in positions deliver the argument; the cells vary
// what is iterated.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function total(xs) {
  let t = 0
  for x in xs { t = t + x }
  return t
}
// @@VALUE@@
[1, 2, 3]
// @@TYPE@@
i32[]
// @@PROOF@@
print(total(v))
// @@WANT@@
6
// @@CELL_f64_elements@@
// want: 4
function fsum(xs) {
  let t = 0.0
  for x in xs { t = t + x }
  return t
}
print(fsum([1.5, 2.5]))
// @@CELL_record_elements@@
// want: 5
type Shape = { w: i32 }
function ws(xs) {
  let t = 0
  for s in xs { t = t + s.w }
  return t
}
const shapes: Shape[] = [{ w: 2 }, { w: 3 }]
print(ws(shapes))
// @@CELL_union_elements@@
// want: na
function cat(xs) {
  let o = ""
  for x in xs {
    if x is string { o = o + x } else { o = o + "n" }
  }
  return o
}
const u: (i32 | string)[] = [1, "a"]
print(cat(u))
// @@CELL_element_and_index@@
// want: 01
function idx(xs) {
  let o = ""
  for x, i in xs { o = o + "\{i}" }
  return o
}
print(idx([7, 8]))
// @@CELL_map_keys@@
// want: a!
function keys(m) {
  let o = ""
  for k in m { o = o + k + "!" }
  return o
}
const mm: {[string]: i32} = Map()
mm["a"] = 1
print(keys(mm))
// @@CELL_map_values@@
// want: 2
function vals(m) {
  let t = 0
  for k, x in m { t = t + x + 1 }
  return t
}
const mv: {[string]: i32} = Map()
mv["a"] = 1
print(vals(mv))
// @@CELL_set_elements@@
// want: 4
function sset(s) {
  let t = 0
  for k in s { t = t + k }
  return t
}
const q: Set<i32> = Set()
q.add(4)
print(sset(q))
// @@CELL_string_code_points@@
// want: 195
function codes(s) {
  let t = 0
  for c in s { t = t + c }
  return t
}
print(codes("ab"))
// @@CELL_u8_elements_read_wide@@
// want: 256
function bump(xs) {
  let t = 0
  for b in xs { t = b + 1 }
  return t
}
const bs: u8[] = [255]
print(bump(bs))
// @@CELL_two_pins@@
// want: 3 ab
function joinAll(xs) {
  let o = ""
  for x in xs { o = o + "\{x}" }
  return o
}
const ns: i32[] = [1, 2]
print("\{total(ns)} \{joinAll(["a", "b"])}")
// @@CELL_not_iterable_refused@@
// owed: for-in expects an array, a map or a string
function bad(n) { for x in n { print(x) } }
bad(5)
