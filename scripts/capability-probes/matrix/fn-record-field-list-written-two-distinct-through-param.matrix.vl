// D15190 with distinct functions: a record's list field of two functions, each element written a
// different function of another result type through an un-annotated parameter, so each element's
// call runs the function written to it.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __inc(a) { return a + 1 }
function __half(a) { return a / 2.0 }
function __third(a) { return a / 3.0 }
function __put(o) {
  o.fs[0] = __half
  o.fs[1] = __third
}
// @@SETUP@@
const __rec = { fs: [__inc, __inc] }
__put(__rec)
// @@VALUE@@
__rec
// @@TYPE@@
{ fs: readonly ((a: i32) => i32 | f64)[] }
// @@PROOF@@
print(v.fs[0](3) + v.fs[1](6))
// @@WANT@@
3.5
