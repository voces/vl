// D1665 — the nullable-map template's pair with a SECOND holder that shares the field name
// `f` and disagrees about the map's VALUE type. Both fields code 29, so a row identity read
// off names and codes alone merges them and one holder stores its map into the other's slot.
//
// The first holder lives in the PRELUDE, inside a function nothing calls: `collectAnonShapes`
// walks the whole arena, so its row is minted and available to collide with wherever the value
// under test is delivered. Removing it turns every cell green for the wrong reason.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function strMap(): { [string]: string } | null {
  const m: { [string]: string } = Map()
  m["k"] = "first"
  return m
}
function nul1(): { [string]: i32 } | null {
  const m: { [string]: i32 } = Map()
  m["k"] = 55
  return m
}
function nul2(): { [string]: i32 } | null {
  const m: { [string]: i32 } = Map()
  m["k"] = 42
  return m
}
function firstHolder() {
  const first = { f: strMap() }
  const fm = first.f
  if fm != null { print(fm["k"]) } else { print("none") }
}
// @@VALUE@@
{ f: nul1() }
// @@TYPE@@
{ f: { [string]: i32 } | null }
// @@PROOF@@
const mv = v.f
if mv != null { print(mv["k"]) } else { print(0) }
// @@WANT@@
55
// @@VALUE2@@
{ f: nul2() }
// @@TYPE2@@
{ f: { [string]: i32 } | null }
// @@PROOF2@@
const mv2 = v.f
if mv2 != null { print(mv2["k"]) } else { print(0) }
// @@WANT2@@
42
// @@SKIP@@
is_in_if: the value is a struct, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
