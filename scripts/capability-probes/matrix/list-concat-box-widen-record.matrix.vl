// A list `+` whose narrower operand is boxed into a union element by a converting copy: an
// `i32[]` into `(string | f64)[]` widens each element to `f64` before boxing it, and a `Cx[]`
// into `(Cx | Dx)[]` boxes each record under its arm (D4858). Both through annotated bindings.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type Cx = { r: i32 }
type Dx = { s: string }
const da: (string | f64)[] = ["a", 1.5]
const db: i32[] = [2]
const ra: (Cx | Dx)[] = [{ r: 1 }, { s: "d" }]
const rb: Cx[] = [{ r: 9 }]
// @@VALUE@@
da + db
// @@TYPE@@
(string | f64)[]
// @@PROOF@@
const e = v[2]
if e is f64 { print(e / 4.0 + v.length) } else { print("miss") }
// @@WANT@@
3.5
// @@VALUE2@@
rb + ra
// @@TYPE2@@
(Cx | Dx)[]
// @@PROOF2@@
const e = v[0]
const f = v[2]
if e is Cx && f is Dx { print("\{f.s}\{e.r + v.length}") } else { print("miss") }
// @@WANT2@@
d12
// @@SKIP@@
is_in_if: the value is a list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
