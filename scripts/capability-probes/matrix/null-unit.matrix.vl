// D4550 — a value whose type is exactly the `null` unit type, not `T | null`. It has one
// inhabitant, so every position carries it without information; the proof reads it back
// through `==`, `!=` and `??`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function nothing(): null { return null }
// @@VALUE@@
null
// @@TYPE@@
null
// @@TEST@@
v == null
// @@HIT@@
print(v ?? 7)
// @@MISS@@
print("miss")
// @@WANT@@
7
// @@VALUE2@@
nothing()
// @@TYPE2@@
null
