// D2565 at every position: a `??` joining two nullable records, read where the last branch
// narrows the value to `B` only by ruling out `null` and then `A`. Every delivery that lands the
// join somewhere un-annotated has to spell its union under the name the checker's row carries,
// or the `is A` complement subtracts nothing and the field read under it has no struct.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type A = { r: i32 }
type B = { q: string }
function mkA(n: i32): A | null { if n == 0 { return null } return { r: n } }
function mkB(s: string): B | null { if s == "" { return null } return { q: s } }
// @@VALUE@@
mkA(0) ?? mkB("b")
// @@TYPE@@
A | B | null
// @@TEST@@
v == null
// @@HIT@@
print("null")
// @@MISS@@
if v is A { print(v.r) } else { print(v.q) }
// @@WANT@@
b
