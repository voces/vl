// D4989 at every position: a value of an inline union of two same-shape records, `A | B`, is a
// union box at the wasm level, while `A | B | null` (which is `A | null`) is the nullable record.
// The delivery has to unbox the payload, or the slot is stored the box.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type Pa = { tag: i32, val: i32 }
type Pb = { tag: i32, val: i32 }
function pick(n: i32): Pa | Pb {
  const b: Pb = { tag: 2, val: n }
  return b
}
// @@VALUE@@
pick(4)
// @@TYPE@@
Pa | Pb | null
// @@TEST@@
v == null
// @@HIT@@
print("null")
// @@MISS@@
print(v.val)
// @@WANT@@
4
// @@VALUE2@@
pick(7)
// @@TYPE2@@
Pa | null
// @@PROOF2@@
if v == null { print("null") } else { print(v.val + v.tag) }
// @@WANT2@@
9
