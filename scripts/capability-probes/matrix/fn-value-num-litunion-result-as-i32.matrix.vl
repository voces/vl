// D9382: a function whose result is a numeric literal union, delivered as a function returning
// `i32`. The union reps as its base `i32`, so both types share one signature and no adapter is
// needed. The second value is a binding of an annotated lambda.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type N = 1 | 2
function t(k: N): N { k }
const __flip: (k: N) => N = (k: N): N => {
  if k == 1 { return 2 }
  1
}
// @@VALUE@@
t
// @@TYPE@@
(k: N) => i32
// @@PROOF@@
print(v(2) + 40)
// @@WANT@@
42
// @@VALUE2@@
__flip
// @@TYPE2@@
(k: N) => i32
// @@PROOF2@@
print(v(1) * 10)
// @@WANT2@@
20
// @@SKIP@@
is_in_if: the value is a function, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
