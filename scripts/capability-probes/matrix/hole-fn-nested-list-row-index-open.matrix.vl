// A list of lists of a function with an un-annotated parameter, its row read through a computed
// index and called at one type, its literal row read at another, so the parameter stays open; the
// computed read runs its bound check and names the generic (D9900).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __inc(a) { return a + 1 }
// @@VALUE@@
[[__inc]]
// @@TYPE@@
((a: i32) => i32)[][]
// @@PROOF@@
let __row = 0
const __n = v[__row][0](3)
const __f = v[0][0](2.5)
if __n == 4 { print(__f) } else { print("wrong i32 read") }
// @@WANT@@
3.5
// @@TEST@@
v.length == 1
// @@HIT@@
let __row = 0
const __n = v[__row][0](3)
const __f = v[0][0](2.5)
if __n == 4 { print(__f) } else { print("wrong i32 read") }
// @@MISS@@
print(0)
