// D1722 — a value delivered into a NESTED index place (`ys[0][0]`) and read at that place.
// The emitter's keyer took one subscript level; the checker's takes any number, so the
// checker narrowed and the emitter had no arm narrowed.
//
// `array_element_place` is the load-bearing cell: it is the position that reads a place
// rather than a binding of it, and the template's own SETUP nests the list one level so the
// cell the position reads is `xs[0][0]` rather than `xs[0]`.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type A = { r: i32 }
type M = i32 | A
function st(): A {
  return { r: 8 }
}
function pick(b: boolean): M {
  if b { return st() }
  return 7
}
// @@SETUP@@
const __row: M[] = [pick(true)]
// @@VALUE@@
__row
// @@TYPE@@
M[]
// @@TEST@@
v[0] is A
// @@HIT@@
print(v[0].r)
// @@MISS@@
print(0)
// @@WANT@@
8
