// A list-literal spread of an `i32[]` into a list of `i32 | null`: each element is boxed
// into the nullable union, at every position, in both faces (the trailing `null` types the
// un-annotated face the same way).
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
const src: i32[] = [3, 4]
// @@VALUE@@
[...src, null]
// @@TYPE@@
(i32 | null)[]
// @@PROOF@@
const e = v[1]
const n = v[2]
if e != null && n == null { print(e * 10 + v.length) } else { print("miss") }
// @@WANT@@
43
// @@SKIP@@
is_in_if: the value is a list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
