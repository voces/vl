// D16755: a relay of a generic maker delivered at two function types whose results differ: the
// prelude takes the relay's result at `(x: string) => string` and calls it, the cell takes it at
// `(x: i32) => i32`. The relay is built per delivered result, as the maker is, so each call reaches
// its own instance of the generic.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __k<T>(x: T): T {
  return x
}
function __mk() {
  return __k
}
function __dlv() {
  return __mk()
}
const __w: (x: string) => string = __dlv()
print(__w("s"))
// @@VALUE@@
__dlv()
// @@TYPE@@
(x: i32) => i32
// @@PROOF@@
print(v(41))
// @@WANT@@
s then 41
// @@TEST@@
v(0) == 0
// @@HIT@@
print(v(41))
// @@MISS@@
print(0)
// @@VALUE2@@
__dlv()
// @@TYPE2@@
(x: f64) => f64
// @@PROOF2@@
print(v(2.5))
// @@WANT2@@
2.5
