// The generic twin of optchain-map-get-nullable-map: the `?.get` is in a generic's body over
// `{[string]: V} | null`, so the map's value type is bound only by the call, never written.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function look<V>(k: {[string]: V} | null): V | null { k?.get("a") }
const gm: {[string]: i32} = Map()
gm["a"] = 3
const gs: {[string]: string} = Map()
gs["a"] = "s"
// @@VALUE@@
look(gm)
// @@TYPE@@
i32 | null
// @@TEST@@
v != null
// @@HIT@@
print(v ?? 0)
// @@MISS@@
print(0)
// @@WANT@@
3
// @@VALUE2@@
look(gs)
// @@TYPE2@@
string | null
// @@PROOF2@@
print(v ?? "n")
// @@WANT2@@
s
