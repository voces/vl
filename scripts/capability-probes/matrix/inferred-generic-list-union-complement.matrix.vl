// D5111: the complement arm of a generic's `is T[]` over an inferred `T[] | i32[]`, returned
// from the instance. The emitter narrows it per instance where the checker cannot. VALUE2 is
// the generic-open face: the call sits in a generic body whose `T` the caller pins.
//
// `wrap`'s tail `[1, 2, 3]` follows a `return` and is not returned, so `wrap` infers
// `string[] | null` and the value is `null`: the test is false and the cells print `9` (D16713).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function wrap<T>(t: T, b: boolean) {
  if b { return [t] }
  return [1, 2, 3]
}
function rest<T>(t: T, b: boolean) {
  const u = wrap(t, b)
  if u is T[] { return wrap(t, false) } else { return u }
}
function viaT<T>(t: T, b: boolean) {
  const r = rest(t, b)
  return r
}
// @@VALUE@@
rest("s", false)
// @@TYPE@@
string[] | i32[]
// @@FALLBACK@@
rest("s", false)
// @@TEST@@
v is i32[] && v.length == 3
// @@HIT@@
print(3)
// @@MISS@@
print(9)
// @@WANT@@
9
// @@VALUE2@@
viaT("s", true)
// @@TYPE2@@
string[] | i32[]
// @@PROOF2@@
print(v.length)
// @@WANT2@@
3
