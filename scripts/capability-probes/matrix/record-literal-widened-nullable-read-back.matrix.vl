// D3006, as D3339's owner ruling (A) settles it: an `i32 | null` field of a record literal a map
// store re-seats at `{ v: f64 | null }` is boxed at the wider member, and the binding adopts that
// record, so every read sees `f64 | null`. The proof adds past `i32`'s range to show the width.
// Declaring the destination `i32 | null` is the refusal D3339 owes.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type D = { v: f64 | null }
const x: i32 | null = 2147483647
const c: {[string]: D} = Map()
const o = { v: x }
c["k"] = o
// @@VALUE@@
o.v
// @@TYPE@@
i32 | null
// @@PROOF@@
print((v ?? 0) + 1)
// @@WANT@@
2147483648
// @@OWED_ANNOTATED@@
cannot assign f64 | null to
cannot assign (f64 | null)[] to
cannot assign {f: f64 | null} to
expected i32 | null, got f64 | null
push: cannot add f64 | null to
// @@TEST@@
v != null
// @@HIT@@
print(v + 1)
// @@MISS@@
print(0)
