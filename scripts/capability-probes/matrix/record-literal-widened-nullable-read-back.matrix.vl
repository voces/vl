// D3006 — an `i32 | null` field of a record literal a map store re-seats at
// `{ v: f64 | null }`: its box is built at the wider member and read back at its own, delivered
// at every position. The proof wraps at `i32`.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type D = { v: f64 | null }
const x: i32 | null = 2147483647
const c: {[string]: D} = Map()
const o = { v: x }
c["k"] = o
// @@VALUE@@
o.v
// @@TYPE@@
i32 | null
// @@PROOF@@
print((v ?? 0) + 1)
// @@WANT@@
-2147483648
// @@TEST@@
v != null
// @@HIT@@
print(v + 1)
// @@MISS@@
print(0)
