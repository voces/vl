// A generic `twice` over a generic function, its result a lambda that calls the argument twice,
// delivered and called at `f64`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function gid<A>(x: A): A { return x }
function twice<A>(f: (x: A) => A): (x: A) => A { return (x: A) => f(f(x)) }
// @@VALUE@@
twice(gid)
// @@TYPE@@
(x: f64) => f64
// @@PROOF@@
print(v(1.5))
// @@WANT@@
1.5
