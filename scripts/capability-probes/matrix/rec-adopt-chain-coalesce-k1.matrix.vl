// D16958: a literal binding reaches a `??` default over a read of a map delivered as
// `{ [string]: J }`, through 1 link(s) ending in the `??`; the default lands in no binding the
// map's adoption reaches, so the re-check budget settles it, and the assertion must not refuse it.

// @@PRELUDE@@
type J = { f: i32 | null }

// @@SETUP@@
const cm = Map()
cm.set("a", { f: 4 })
const r0 = { f: 9 }
const zs = [cm.get("zz") ?? r0]
print(zs[0].f ?? 0)

// @@VALUE@@
cm

// @@TYPE@@
{ [string]: J }

// @@PROOF@@
print((v.get("a") ?? { f: 0 }).f ?? 0)

// @@WANT@@
9 then 4
