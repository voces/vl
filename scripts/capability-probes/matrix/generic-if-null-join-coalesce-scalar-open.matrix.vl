// D10231's open twin: the generic's `if c { x } else { null }` join is pinned at a value type the
// call infers from an un-annotated function's hole result, and is read through `??` unbound.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __nj<V>(c: boolean, x: V, d: V): V {
  const r = if c { x } else { null }
  r ?? d
}
function __nm<V>(c: boolean, x: V, d: V): V { (if c { null } else { x }) ?? d }
function __pick(p, q) { p + q }
// @@VALUE@@
__pick(1.0, 0.5)
// @@TYPE@@
f64
// @@TEST@@
__nj(false, v, 0.25) == 0.25
// @@HIT@@
print(__nj(true, v, 0.25) + __nj(false, v, 2.0) + __nm(true, v, 0.5))
// @@MISS@@
print("wrong")
// @@WANT@@
4
