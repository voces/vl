// D15136: an inferred list of one function, written a function of another result type by a callee
// that an uncalled function also hands its own parameter to. The uncalled body builds no instance
// of the callee, so a call through the element after the write runs the written function.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __inc(a) { return a + 1 }
function __half(a) { return a / 2.0 }
function __put(ys) { ys[0] = __half }
function _hand(zs) { return __put(zs) }
// @@SETUP@@
const __xs = [__inc]
__put(__xs)
// @@VALUE@@
__xs
// @@TYPE@@
readonly ((a: i32) => i32 | f64)[]
// @@PROOF@@
print(v[0](3))
// @@WANT@@
1.5
