// D3123 (plumb PL-075) — an INFERRED record whose field is fed by a binding, not a `Map()`
// call: a record-with-map nested in a record. The field-code ladder coded a map only off a call and its spellability gate
// declines a `TyMap`, so the literal minted no row and its function's return had no shape.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function mk(k: i32, x: i32): {[i32]: i32} {
  const m: {[i32]: i32} = Map()
  m[k] = x
  m
}
function wrapR(m: {[i32]: i32}) { { inner: { regs: m }, tag: "t" } }
// @@VALUE@@
wrapR(mk(3, 48))
// @@TYPE@@
{ inner: { regs: {[i32]: i32} }, tag: string }
// @@PROOF@@
print(v.tag.length * 100 + (v.inner.regs[3] ?? -1))
// @@WANT@@
148
// @@VALUE2@@
wrapR(mk(9, 49))
// @@TYPE2@@
{ inner: { regs: {[i32]: i32} }, tag: string }
// @@PROOF2@@
print(v.inner.regs[9] ?? -1)
// @@WANT2@@
49
// @@SKIP@@
is_in_if: the value is a struct, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
