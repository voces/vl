// D16945 (unfiled: D16945, filed by #8956) — a getter read through a parameter bound to `F32x4 | null` behind a null guard. With
// `: F32x4 | null` on the parameter the getter runs; without it the read infers a record field,
// which a getter does not satisfy, and check refuses it as it refuses the non-null argument.
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
import { F32x4, splatF32 } from "std:simd"
function mk(): F32x4 | null { return splatF32(1.0) }
// @@VALUE@@
mk()
// @@TYPE@@
F32x4 | null
// @@PROOF@@
if v != null { print(v.y) }
// @@WANT@@
1
// @@CELL_if_guard@@
// owed: is a getter, and the parameter's inferred
function take(a__A__) { if a != null { print(a.y) } }
take(__V__)
// @@CELL_early_return@@
// owed: is a getter, and the parameter's inferred
function take(a__A__) {
  if a == null { return }
  print(a.y)
}
take(__V__)
// @@CELL_else_arm@@
// owed: is a getter, and the parameter's inferred
function take(a__A__) {
  if a == null { print(0) } else { print(a.y) }
}
take(__V__)
// @@CELL_const_copy@@
// owed: is a getter, and the parameter's inferred
function take(a__A__) {
  const b = a
  if b != null { print(b.y) }
}
take(__V__)
