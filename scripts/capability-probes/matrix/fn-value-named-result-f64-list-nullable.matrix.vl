// D9781: a named function returning an `f64` list, delivered where a function returning
// `f64[] | null` is expected. The function's type is fixed before it reaches the slot, so
// every position must hand the call an adapter that widens the result.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function n(x: i32): f64[] { return [1.5, 2.5] }
function m(x: i32): f64[] { return [0.25, 0.5] }
// @@VALUE@@
n
// @@TYPE@@
(x: i32) => f64[] | null
// @@PROOF@@
const r = v(1)
if r != null { print(r[0] + r[1]) } else { print(0) }
// @@WANT@@
4
// @@VALUE2@@
m
// @@TYPE2@@
(x: i32) => f64[] | null
// @@PROOF2@@
const r2 = v(1)
if r2 != null { print(r2[0] + r2[1]) } else { print(0) }
// @@WANT2@@
0.75
