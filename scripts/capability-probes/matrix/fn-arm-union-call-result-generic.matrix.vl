// D4348's generic twin — the same call result handed through a type parameter left open
// (`idT<T>(x: T)`), so the pin of `T` is what reads the callee, not an annotation.
//
// The PROOF discriminates: the function arm must test true AND the string arm false, so a
// fold of either test to a constant prints `9`, never `2`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function mk(n: i32): ((x: i32) => i32) | string {
  if n == 0 { return "s" }
  return (x: i32) => x + n
}
function idT<T>(x: T): T { x }
// @@VALUE@@
idT(mk(1))
// @@TYPE@@
((x: i32) => i32) | string
// @@FALLBACK@@
mk(2)
// @@TEST@@
!(v is string) && v is (x: i32) => i32
// @@HIT@@
print(2)
// @@MISS@@
print(9)
// @@WANT@@
2
