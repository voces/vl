// A narrowed box-field read (D17048): a box local narrowed by a discriminant compare, its field
// `f` stored as boolean | null and read at each delivery position. Every cell prints the field's
// value, decoded where its storage is not the destination's rep.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type A = { tag: "b" | "c", f: boolean | null }
type B = { tag: "a", f: boolean | null }
function mk(n: i32): A | B {
  if n == 0 { return { tag: "b", f: null } }
  return { tag: "a", f: true }
}
// @@SETUP@@
const b = mk(2)
// @@GUARD@@
b.tag == "a"
// @@VALUE@@
b.f
// @@TYPE@@
boolean | null
// @@FALLBACK@@
null
// @@PROOF@@
print(v ?? false)
// @@TEST@@
v == true
// @@HIT@@
print(true)
// @@MISS@@
print(false)
// @@CELL_param_return@@
function h(b: A | B)__A__ {
  if b.tag == "a" { return __V__ }
  return null
}
const v = h(mk(2))
print(v ?? false)
// @@CELL_param_binding@@
function h(b: A | B) {
  if b.tag == "a" {
    const v__A__ = __V__
    print(v ?? false)
  }
}
h(mk(2))
// @@CELL_param_element@@
function h(b: A | B) {
  if b.tag == "a" {
    const xs__LA__ = [__V__]
    const v = xs[0]
    print(v ?? false)
  }
}
h(mk(2))
// @@CELL_param_argument@@
function take(v: __TY__) { print(v ?? false) }
function h(b: A | B) {
  if b.tag == "a" { take(__V__) }
}
h(mk(2))
// @@WANT@@
true
