// A generic function delivered to each position, then written alone into a list literal handed
// straight to a generic whose parameter leaves the element's type open, called at `i32` (D10204).
// `fn-value-generic-list-literal-arg-at-i32.matrix.vl` adds a fixed-type element beside it.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function id<T>(x: T): T { x }
function __run<U>(a: ((x: U) => U)[], u: U): U { a[0](u) }
// @@VALUE@@
id
// @@TYPE@@
(x: i32) => i32
// @@PROOF@@
print(__run([v], 2) * 10 + v(5))
// @@WANT@@
25
