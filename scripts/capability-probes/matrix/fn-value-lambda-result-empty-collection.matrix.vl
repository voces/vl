// D9782: a lambda with an un-annotated result returning `Map()`, or `[]`, delivered and called.
// Its key, value and element types come from the place it is delivered at, so the map is built
// at `{[i32]: string}` and the list at `i32[]`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@VALUE@@
(x: i32) => Map()
// @@TYPE@@
(x: i32) => {[i32]: string}
// @@PROOF@@
const m = v(1)
m[3] = "q"
print(m[3] ?? "none")
// @@WANT@@
q
// @@VALUE2@@
(x: i32) => []
// @@TYPE2@@
(x: i32) => i32[]
// @@PROOF2@@
const xs = v(2)
xs.push(7)
print(xs[0] + 1)
// @@WANT2@@
8
