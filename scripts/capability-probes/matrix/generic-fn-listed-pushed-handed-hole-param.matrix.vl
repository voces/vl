// A generic function delivered to each position, then handed to a hole parameter that lists
// it, pushes it again, hands the list on whole and calls its elements at two types (D15529).
// No function type spells a value called at two types, so the annotated face refuses by design.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function id<T>(x: T): T { x }
function __count(ys) { ys.length }
function __hold(a) {
  const xs = [a]
  xs.push(a)
  __count(xs) * 10 + xs[0]("abc").length + xs[1](2)
}
// @@VALUE@@
id
// @@TYPE@@
(x: i32) => i32
// @@PROOF@@
print(__hold(v))
// @@WANT@@
25
