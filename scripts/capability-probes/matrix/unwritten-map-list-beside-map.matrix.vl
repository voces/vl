// D16047 (owner ruling (a1)): a list of unwritten `Map()`s joined with a `{[string]: i32}` in an inferred return (D16047's witness). An element nothing writes fits every
// `is` of its kind, and a write through a narrowing pins it as a direct write does.
// The annotated face spells the settled type; the vacuous tests are un-annotated cells.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function pick(c: boolean) {
  if c { return [Map()] }
  const m: {[string]: i32} = Map()
  m["a"] = 3
  return m
}
// @@VALUE@@
pick(true)
// @@TYPE@@
{[string]: i32}[] | {[string]: i32}
// @@TEST@@
v is {[string]: i32}[]
// @@HIT@@
print("collection")
// @@MISS@@
print("other")
// @@WANT@@
collection
// @@VALUE2@@
pick(false)
// @@TYPE2@@
{[string]: i32}[] | {[string]: i32}
// @@PROOF2@@
if v is {[string]: i32}[] { print("collection") } else { print(v["a"] ?? 0) }
// @@WANT2@@
3
// @@CELL_vacuous_0@@
// want: true
const v = pick(true)
print(v is {[i32]: f64}[])
// @@CELL_vacuous_param_0@@
// want: true
function probe(c: boolean) {
  const v = pick(c)
  print(v is {[i32]: f64}[])
}
probe(true)
