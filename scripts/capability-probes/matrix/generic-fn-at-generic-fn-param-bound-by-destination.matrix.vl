// A generic function handed to a generic's function-typed parameter, with the parameter's type
// parameter named by no other argument: the destination binds it (D16410). The un-annotated face
// has no destination, so the type parameter is bound only by a later call (D16411, inferred
// interfaces). Cells: `i64`, `string`, an un-annotated hole function, `i32`, an explicit type
// argument, and a function bound only through another argument.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function gid<A>(x: A): A { return x }
function sel<A>(f: (x: A) => A): (x: A) => A { return f }
// @@VALUE@@
sel(gid)
// @@TYPE@@
(x: f64) => f64
// @@PROOF@@
print(v(1.5))
// @@WANT@@
1.5
// @@CELL_at_i64@@
// want: 9000000000
const k: (x: i64) => i64 = sel(gid)
print(k(9000000000))
// @@CELL_at_string@@
// want: s
const k: (x: string) => string = sel(gid)
print(k("s"))
// @@CELL_hole_fn@@
// want: 2.5
function hinc(x) { return x + 1 }
const k: (x: f64) => f64 = sel(hinc)
print(k(1.5))
// @@CELL_at_i32@@
// want: 4
const k: (x: i32) => i32 = sel(gid)
print(k(4))
// @@CELL_explicit@@
const k: (x: f64) => f64 = sel<f64>(gid)
print(k(1.5))
// @@CELL_bound_by_argument@@
// want: 2
function hinc2(x) { return x + 1 }
function app<A, B>(f: (x: A) => B, x: A): B { return f(x) }
print(app(hinc2, 1))
