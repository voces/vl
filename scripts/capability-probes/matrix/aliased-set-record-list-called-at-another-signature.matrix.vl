// D17819 / D17822: a binding's list of a set's records, aliased into a list annotated at a closed
// field, is one storage. Delivered on to each position and called there at (i32), it meets the
// annotation's (f64): the un-annotated face is owed the container refusal at every position, and
// the annotated face (the value closed at (f64) again) runs.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function id(a) { return a }
function deliver() { return [{ f: id }] }
const a = deliver()
const b: { f: (a: f64) => f64 }[] = a
print(b[0].f(2.5))
