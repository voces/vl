// D8720 — a `match` value arm whose block returns and then ends in a dead `i32`: the arm has no
// value, so the match is a `string` and so is `pickM`'s inferred return.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function pickM(k: i32) {
  const s = match k {
    1 => {
      return "a"
      5
    }
    _ => "b"
  }
  s
}
// @@VALUE@@
pickM(1) + pickM(2)
// @@TYPE@@
string
// @@PROOF@@
print(v)
// @@WANT@@
ab
