// A `never` operand of an arithmetic, bitwise or comparison operator outside a dead arm (D14420):
// the operator has no value, so it is `never` and the path ends there; a short-circuit operator and
// a string concatenation keep their own rules. Cells call `a(true)`, the live path.
// @@PRELUDE@@
function fail(): never { return __trap__() }
// @@VALUE@@
fail()
// @@TYPE@@
never
// @@PROOF@@
print(1)
// @@WANT@@
1
// @@SKIP@@
binding: the built-in positions bind or deliver the never value itself, which no value is
return_inferred: same
return_annotated: same
argument: same
struct_field_init: same
struct_field_assign: same
array_element: same
array_element_assign: same
array_push: same
local_assign: same
global_init: same
global_assign: same
map_value: same
map_set: same
closure_capture: same
block_if: same
block_if_capture: same
block_while: same
block_while_capture: same
block_bare: same
block_bare_capture: same
fn_body: same
fn_body_capture: same
is_in_if: same
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
array_element_place: same
map_value_place: same
struct_field_place: same
early_return_guard: same
two_instances: same
// @@CELL_add_right@@
function a(c: boolean): i32 { if c { return 1 } 1 + __V__ }
print(a(true))
// @@CELL_mul_left@@
function a(c: boolean): i32 { if c { return 1 } __V__ * 2 }
print(a(true))
// @@CELL_sub_f64@@
// want: 1.5
function a(c: boolean): f64 { if c { return 1.5 } 2.0 - __V__ }
print(a(true))
// @@CELL_div_i64@@
function a(c: boolean): i64 { if c { return 1 as i64 } (4 as i64) / __V__ }
print(a(true))
// @@CELL_rem@@
function a(c: boolean): i32 { if c { return 1 } 7 % __V__ }
print(a(true))
// @@CELL_bitand@@
function a(c: boolean): i32 { if c { return 1 } 3 & __V__ }
print(a(true))
// @@CELL_shift@@
function a(c: boolean): i32 { if c { return 1 } 1 << __V__ }
print(a(true))
// @@CELL_less@@
// want: true
function a(c: boolean): boolean { if c { return true } 1 < __V__ }
print(a(true))
// @@CELL_equals@@
// want: true
function a(c: boolean): boolean { if c { return true } 1 == __V__ }
print(a(true))
// @@CELL_nested@@
function a(c: boolean): i32 { if c { return 1 } (1 + __V__) * 2 }
print(a(true))
// @@CELL_returned@@
function a(c: boolean): i32 {
  if c { return 1 }
  return 1 + __V__
}
print(a(true))
// @@CELL_call_arg@@
function g(x: i32): i32 { return x }
function a(c: boolean): i32 { if c { return 1 } g(1 + __V__) }
print(a(true))
// @@CELL_if_arm@@
function a(c: boolean): i32 { if c { 1 } else { 1 + __V__ } }
print(a(true))
// @@CELL_concat@@
function a(c: boolean): string { if c { return "1" } "s" + __V__ }
print(a(true))
// @@CELL_and_short@@
// want: false
function a(c: boolean): boolean { return false && __V__ }
print(a(true))
// @@CELL_or_short@@
// want: true
function a(c: boolean): boolean { return true || __V__ }
print(a(true))
