// A `for` loop whose value is a map (owner ruling 2026-09-29): it can run out, so the value is
// `Map<string, i32> | null`, and `??` over it takes the map when present (D3257). The proof
// prints the entry of the map the break chose, which neither the default nor the first would.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function mk(n: i32): Map<string, i32> {
  const m = Map<string, i32>()
  m["a"] = n
  m
}
// @@VALUE@@
for i in 0 until 4 { if i == 2 { break mk(i * 10) } }
// @@TYPE@@
Map<string, i32> | null
// @@PROOF@@
print((v ?? mk(-1))["a"] ?? -9)
// @@WANT@@
20
// @@TEST@@
v != null
// @@HIT@@
print(v["a"] ?? -9)
// @@MISS@@
print("miss")
