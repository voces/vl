// D17059: `??` over a nullable field read off a receiver that runs code, `i32 | string | null` field.
// Every position must evaluate the receiver once: PROOF prints the value, then the call count.
// The cells add the index-with-call and closure-field-call receivers.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type P = { k: i32 }
type R = { m: i32, f: i32 | string | null }
let calls = 0
function mk(): R {
  calls = calls + 1
  return { m: 1, f: "u" }
}
const o = { mk: () => mk() }
// @@VALUE@@
mk().f ?? 0
// @@TYPE@@
i32 | string
// @@PROOF@@
print(v)
print(calls)
// @@WANT@@
u then 1
// @@SKIP@@
struct_field_assign: the position evaluates the value twice, an initializer and an assignment, so its count is not one evaluation's
array_element_assign: the position evaluates the value twice, an initializer and an assignment, so its count is not one evaluation's
local_assign: the position evaluates the value twice, an initializer and an assignment, so its count is not one evaluation's
global_assign: the position evaluates the value twice, an initializer and an assignment, so its count is not one evaluation's
// @@CELL_index_call_receiver@@
function go() {
  const v__A__ = [mk()][0].f ?? 0
  print(v)
  print(calls)
}
go()
// @@CELL_closure_field_call_receiver@@
function go() {
  const v__A__ = o.mk().f ?? 0
  print(v)
  print(calls)
}
go()
