// D1676 — a standalone `?.` whose leaf field is an f64. `emitOptMemberValue` dispatches on
// the result's rep, and `f64 | null` is the same `{tag, payload}` box `i32 | null` rides with
// a different tag — but the arm read `vbHeapIdxOfKind(0)` and `scalarTagOfKind(0)`, so the
// gate above it refused every leaf wider than i32.
//
// The proof is the VALUE, not its nullness: a box built at the wrong kind would unbox to a
// different number rather than refuse.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type B = { y: f64 }
function mkB(): B | null { { y: 1.5 } }
const b = mkB()
// @@VALUE@@
b?.y
// @@TYPE@@
f64 | null
// @@FALLBACK@@
null
// @@PROOF@@
print(v ?? 0.0)
// @@WANT@@
1.5
