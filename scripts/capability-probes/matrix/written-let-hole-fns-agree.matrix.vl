// A `let` re-pointed between two un-annotated functions that give one result at `i32`, then
// delivered and called at every position: handed to a parameter, returned, held in a record
// or list (D9007, D9008). The proof tells `dbl` from `inc0`. The second value is a `let`
// written inside a function and returned from it.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
let __k = inc0
if [1].length > 0 { __k = dbl }
function __get() {
  let m = inc0
  if [1].length > 0 { m = dbl }
  return m
}
// @@VALUE@@
__k
// @@TYPE@@
(a: i32) => i32
// @@PROOF@@
print(v(3))
// @@WANT@@
6
// @@VALUE2@@
__get()
// @@TYPE2@@
(a: i32) => i32
// @@PROOF2@@
print(v(5))
// @@WANT2@@
10
