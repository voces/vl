// D4164: a null `N | null` over a number-literal union, handed from every position to a
// generic whose `T` stays open and written into a local declared `N | null`. The pin decides
// whether the local is null, so `??` takes its default at a null pin.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type N = 1 | 2
function mkn(): N | null { null }
function mkn2(): N | null { 2 }
function __tvn<T>(x: T): i32 {
  let s: N | null = 1
  s = x
  const r: i32 = s ?? 7
  r
}
// @@VALUE@@
mkn()
// @@TYPE@@
N | null
// @@WANT@@
7
// @@TEST@@
__tvn(v) == 7
// @@HIT@@
print(__tvn(v))
// @@MISS@@
print("miss")
// @@VALUE2@@
mkn2()
// @@TYPE2@@
N | null
// @@PROOF2@@
print(__tvn(v))
// @@WANT2@@
2
// @@SKIP@@
map_value: a null stored in an `N | null` map reads as the miss, so the position never reaches the proof
map_set: same
map_value_place: same
