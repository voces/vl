// D9531: D9530's record literal of an un-annotated i32-result function, with a value of the
// declared `R` (whose field returns f64) built in the prelude, so its row is in use. Annotated,
// every cell is refused at check; un-annotated, the record keeps its own type and prints `4`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type R = { f: (a: i32) => f64 }
function inc0(a) { return a + 1 }
const r0: R = { f: (a: i32): f64 => 1.0 }
// @@VALUE@@
{ f: inc0 }
// @@TYPE@@
R
// @@PROOF@@
print(v.f(3))
// @@WANT@@
4
// @@SKIP@@
is_in_if: the value is a record, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
