// D5340 — a function returning the nullable atom `R | null` whose body falls off its end: an
// else-less tail `if` (VALUE) and an `if` that returns early (VALUE2). The fall-through path is
// the `-1` null sentinel, read at every delivery position and in both faces.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type R = "a" | "b" | "c"
function tail(c: boolean, r: R): R | null {
  if c { r }
}
function early(c: boolean, r: R): R | null {
  if c { return r }
}
// @@VALUE@@
tail(false, "b")
// @@TYPE@@
R | null
// @@PROOF@@
const r = v
print(r ?? "none")
// @@WANT@@
none
// @@VALUE2@@
early(true, "c")
// @@TYPE2@@
R | null
// @@PROOF2@@
const r2 = v
print(r2 ?? "none")
// @@WANT2@@
c
// @@SKIP@@
map_value: a stored null reads back as a missing key, so the cell guards it away and prints nothing
map_set: same
