// D8020: a fresh call handed through a generic identity, where the program declares a record of
// the call's own field storage (`Col`). The call is built at the record it is delivered to and
// the instance is taken there. A position that calls `mk` twice still refuses (D8201). The type
// parameter stays open.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type Col = { r: i32, g: i32 }
type J = { r: i32 | null, g: i32 }
function idn<T>(v: T): T { v }
function mk() { { r: 15, g: 1 } }
// @@VALUE@@
idn(mk())
// @@TYPE@@
J
// @@WANT@@
15
// @@TEST@@
true
// @@HIT@@
print(v.r ?? 0)
// @@MISS@@
print(0)
