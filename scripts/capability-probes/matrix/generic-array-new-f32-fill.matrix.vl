// D1673 — `__array_new__` with an f32 fill inside a GENERIC, delivered from the instance.
//
// The generic face of `array-new-f32-fill.matrix.vl`: inside a monomorphized instance the
// fill is a PARAMETER, and only the substituted annotation names its rep.
// `arrNewKindOfElemVKind` excluded `f32` by hand, so that channel answered -1 and the
// emitter's own floor fired — `__array_new__ fill names no element rep, and its destination
// names none either` — on a program `vl check` accepts.
//
// The value under test is the generic's returned `T[]` at the f32 pin, and the PROOF adds a
// fraction to an element so a list built at the i32 backing cannot pass.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function gnfPick<T>(v: T): T[] {
  const out = __array_new__(2, v)
  return out
}
function gnfMk(): f32 { 7.5 }
// @@VALUE@@
gnfPick(gnfMk())
// @@TYPE@@
f32[]
// @@FALLBACK@@
gnfPick(gnfMk())
// @@TEST@@
v.length == 2
// @@HIT@@
print(v[1] + 0.25)
// @@MISS@@
print(-1.0)
// @@WANT@@
7.75
