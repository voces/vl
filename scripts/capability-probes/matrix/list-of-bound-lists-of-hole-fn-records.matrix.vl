// A list literal whose elements are bound lists of records holding an un-annotated function
// called at two types: the inner element type keys no ref-list row of its own, so the outer
// row is the list of the inner list's row (D15358, D15356).
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function id1(a) { return a }
const inner = [{ f: id1, n: 3 }]
// @@VALUE@@
[inner]
// @@TYPE@@
{ f: (a: f64) => f64, n: i32 }[][]
// @@PROOF@@
print(v[0][0].f(v[0][0].n) + v[0][0].f(2.5))
// @@WANT@@
5.5
// @@CELL_same_binding_twice@@
const xs__A__ = [inner, inner]
print(xs[1][0].f(xs[0][0].n) + xs[0][0].f(2.5))
// @@CELL_literal_lead@@
const xs__A__ = [[{ f: id1, n: 3 }]]
print(xs[0][0].f(xs[0][0].n) + xs[0][0].f(2.5))
// @@CELL_local_scope@@
function go() {
  const ys = [{ f: id1, n: 3 }]
  const xs__A__ = [ys]
  print(xs[0][0].f(xs[0][0].n) + xs[0][0].f(2.5))
}
go()
// @@CELL_read_through_index@@
const xs__A__ = [inner]
const row = xs[0]
print(row[0].f(row[0].n) + row[0].f(2.5))
// @@CELL_for_over_outer@@
const xs__A__ = [inner]
for row in xs {
  print(row[0].f(row[0].n) + row[0].f(2.5))
}
