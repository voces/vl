// A generic function handed to a callee that hands it back, directly or inside a closure, and
// called by the caller at two types: each use gets its own instance, as a direct use's does
// (D16843). `call1` calls the value inside the callee, which pins its type: an owed refusal.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function same<T>(k: T): T { return k }
// @@VALUE@@
1
// @@TYPE@@
i32
// @@PROOF@@
print(same(v))
// @@WANT@@
1
// @@CELL_return@@
// want: 3 then x
function pass<G>(g: G) { return g }
function mid<F>(a: F) {
  print(pass(a)(3))
  print(a("x"))
}
mid(same)
// @@CELL_return_bound@@
// want: 3 then x
function pass<G>(g: G) { return g }
function mid<F>(a: F) {
  const b = pass(a)
  print(b(3))
  print(a("x"))
}
mid(same)
// @@CELL_capture@@
// want: 3 then x
function wrap<G>(g: G) { return () => g }
function mid<F>(a: F) {
  print(wrap(a)()(3))
  print(a("x"))
}
mid(same)
// @@CELL_capture_bound@@
// want: 3 then x
function wrap<G>(g: G) { return () => g }
function mid<F>(a: F) {
  const w = wrap(a)
  print(w()(3))
  print(a("x"))
}
mid(same)
// @@CELL_capture_record@@
// want: 3 then x
function wrapR<G>(g: G) { return { f: () => g } }
function mid<F>(a: F) {
  print(wrapR(a).f()(3))
  print(a("x"))
}
mid(same)
// @@CELL_capture_record_bound@@
// want: 3 then x
function wrapR<G>(g: G) { return { f: () => g } }
function mid<F>(a: F) {
  const r = wrapR(a)
  print(r.f()(3))
  print(a("x"))
}
mid(same)
// @@CELL_capture_local@@
// want: 3 then x
function mid<F>(a: F) {
  const h = () => a
  print(h()(3))
  print(a("x"))
}
mid(same)
// @@CELL_call1_control@@
// owed: expected string, got i32
function call1<G>(g: G) { return g(3) }
function mid<F>(a: F) {
  print(call1(a))
  print(a("x"))
}
mid(same)
