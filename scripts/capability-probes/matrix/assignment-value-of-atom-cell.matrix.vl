// A literal-union cell assigned a member, the assignment used as the value: it reads back the
// member just assigned at every position, a local's cell re-read as legacy re-reads it.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type K = "zz" | "ww" | "qq"
// @@SETUP@@
let k: K = "zz"
// @@VALUE@@
(k = "ww")
// @@TYPE@@
string
// @@PROOF@@
print(v)
// @@TEST@@
v == "ww"
// @@HIT@@
print(v)
// @@MISS@@
print("miss")
// @@WANT@@
ww
// @@CELL_string_param_argument@@
// want: <ww>
function show(s: string) { print("<" + s + ">") }
function run() {
  let k: K = "zz"
  show(k = "ww")
}
run()
// @@CELL_interpolation_hole@@
// want: [ww]
function run() {
  let k: K = "zz"
  print("[\{k = "ww"}]")
}
run()
// @@CELL_return_unannotated@@
function run() {
  let k: K = "zz"
  return k = "ww"
}
print(run())
