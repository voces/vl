// A record nested in a record, its field a list of un-annotated functions, the binding written
// whole with another such record and the functions called at two types: the written literal and
// the binding's own literal are built at the binding's rep, so they share one row (D15391).
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function id1(a) { return a }
function id2(a) { return a }
function id3(a) { return a }
// @@VALUE@@
{ g: { f: [id1] } }
// @@TYPE@@
{ g: { f: ((a: f64) => f64)[] } }
// @@PROOF@@
print(v.g.f[0](2) + v.g.f[0](2.5))
// @@WANT@@
4.5
// @@CELL_write_whole@@
let r__A__ = __V__
r = { g: { f: [id2] } }
print(r.g.f[0](2) + r.g.f[0](2.5))
// @@CELL_write_whole_twice@@
let r__A__ = __V__
r = { g: { f: [id2] } }
r = { g: { f: [id3] } }
print(r.g.f[0](2) + r.g.f[0](2.5))
// @@CELL_write_inner_field@@
let r__A__ = __V__
r.g = { f: [id2] }
print(r.g.f[0](2) + r.g.f[0](2.5))
// @@CELL_write_three_deep@@
let r = { h: { g: { f: [id1] } } }
r = { h: { g: { f: [id2] } } }
print(r.h.g.f[0](2) + r.h.g.f[0](2.5))
// @@CELL_write_whole_with_sibling@@
// want: 11.5
let r = { n: 1, g: { f: [id1], m: 2 } }
r = { n: 3, g: { f: [id2], m: 4 } }
print(r.g.f[0](2) + r.g.f[0](2.5) + r.n + r.g.m)
// @@CELL_write_whole_in_function@@
function go() {
  let r__A__ = __V__
  r = { g: { f: [id2] } }
  print(r.g.f[0](2) + r.g.f[0](2.5))
}
go()
// @@CELL_write_whole_two_elements@@
let r__A__ = __V__
r = { g: { f: [id2, id3] } }
print(r.g.f[1](2) + r.g.f[0](2.5))
