// D3041 — a `Circle[]` delivered where a `readonly (Circle | Sq)[]` is declared, and written to
// afterwards, is a view of its source: the proof reads the stored and the pushed records back
// through it. A snapshot copy prints the value from before the writes.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type RrvCircle = { r: i32 }
type RrvSq = { s: i32 }
function rrvMk(): RrvCircle[] { return [{ r: 1 }, { r: 2 }] }
const rrvL = rrvMk()
// @@VALUE@@
rrvL
// @@TYPE@@
readonly (RrvCircle | RrvSq)[]
// @@PROOF@@
rrvL[0] = { r: 7 }
rrvL.push({ r: 5 })
let t = 0
for e in v { if e is RrvCircle { t = t + e.r } }
print(t + v.length)
// @@WANT@@
17
