// `v is S[]` over `string[] | f64[]`, `v` from the f64 arm. Element kinds that
// store alike share a box tag, and the test must still answer by the value (D17052).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type S = "a" | "b"
type K = 1 | 2
type P = { q: i32 }
function mk(c: boolean): string[] | f64[] {
  const a: string[] = ["a", "b"]
  const b: f64[] = [0.5]
  if c { return b }
  return a
}
// @@VALUE@@
mk(true)
// @@TYPE@@
string[] | f64[]
// @@TEST@@
v is S[]
// @@HIT@@
print(true)
// @@MISS@@
print(false)
// @@WANT@@
false
