// D5280 — a value `if` (VALUE) or `match` (VALUE2) joining two lists of a string literal
// union, at every delivery position and in both faces. The join's type does not decide its
// rep: a literal-union list is an atom list or a string list by how it was built, so the
// un-annotated binding takes the arms' rep. The PROOF reads an element both as a return
// and as an argument, so an atom read where a string is wanted cannot pass.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type A = "x" | "y" | "z"
const P: A[] = ["x", "y"]
const Q: A[] = ["z"]
function falsy() { 1 == 2 }
function pick(xs: A[], i: i32): A { xs[i] }
function show(a: A): string { a + "!" }
// @@VALUE@@
if falsy() { Q } else { P }
// @@TYPE@@
A[]
// @@PROOF@@
const r = v
print(show(pick(r, 1)) + r[0])
// @@WANT@@
y!x
// @@VALUE2@@
match P.length { 2 => Q, _ => P }
// @@TYPE2@@
A[]
// @@PROOF2@@
const r2 = v
print(show(r2[0]) + pick(r2, 0))
// @@WANT2@@
z!z
// @@SKIP@@
is_in_if: the value is a list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
