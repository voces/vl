// `==` and `!=` over two `null`-typed sides, at every delivery position: each side runs for its
// effect, left then right, and the answer is the constant (D17088's follow-up). The cells read the
// call trace. An assignment of `null` as a side itself is D17423's invalid module.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type __Nu = { id: i32, tags: null }
let __ptr = ""
function __pn(): null {
  __ptr = __ptr + "n"
  return null
}
function __pm(): null {
  __ptr = __ptr + "m"
  return null
}
function __pk(): __Nu {
  __ptr = __ptr + "k"
  return { id: 1, tags: null }
}
// @@VALUE@@
(__pn() == __pm())
// @@TYPE@@
boolean
// @@PROOF@@
print(v)
// @@WANT@@
true
// @@TEST@@
v
// @@HIT@@
print(true)
// @@MISS@@
print(false)
// @@CELL_order_eq@@
// want: true then nm
print(__pn() == __pm())
print(__ptr)
// @@CELL_order_ne@@
// want: false then mn
print(__pm() != __pn())
print(__ptr)
// @@CELL_order_in_fn@@
// want: true then nm
function __f(): boolean { return __pn() == __pm() }
print(__f())
print(__ptr)
// @@CELL_assignment_bound_side@@
// want: true then true
function __g() {
  let s: string | null = "a"
  const x = (s = null)
  print(x == __pn())
  print(s == null)
}
__g()
// @@CELL_field_off_call@@
// want: false then kn
print(__pk().tags != __pn())
print(__ptr)
// @@CELL_coalesce_side@@
// want: true then nmn
print((__pn() ?? __pm()) == __pn())
print(__ptr)
// @@CELL_name_side@@
// want: true then n
const __z: null = null
print(__z == __pn())
print(__ptr)
