// D16230 for a record's list field: the callee's result is the assignment writing the field's
// element through an un-annotated parameter, delivered to each position.
//
// Since the 2026-11-14 return rule (DECISIONS) a block body returns only through `return`, so
// the write is returned as `return <write>`; an assignment's value is its right side (D2497).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __inc(a) { return a + 1 }
function __half(a) { return a / 2.0 }
function __put(o) { return o.fs[0] = __half }
const __rec = { fs: [__inc] }
// @@VALUE@@
__put(__rec)
// @@TYPE@@
(a: i32) => f64
// @@PROOF@@
print(v(4) + __rec.fs[0](3))
// @@WANT@@
3.5
