// D2373 — the value `if` twin: two non-null records of different types joined by an `if`,
// where no declaration names `A | B`. The join is the union box, its row minted from the
// checker's recorded type.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type A = { r: i32 }
type B = { q: string }
function mkA(): A { return { r: 3 } }
function mkB(): B { return { q: "b" } }
function flag(): boolean { return false }
// @@VALUE@@
if flag() { mkA() } else { mkB() }
// @@TYPE@@
A | B
// @@FALLBACK@@
mkA()
// @@TEST@@
v is B
// @@HIT@@
print("b")
// @@MISS@@
print("miss")
// @@WANT@@
b
// @@VALUE2@@
if flag() { mkB() } else { mkA() }
// @@TYPE2@@
A | B
// @@PROOF2@@
if v is A { print(v.r) } else { print("miss") }
// @@WANT2@@
3
