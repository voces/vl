// The generic twin of fn-value-generic-list-element-literal-arg: the element read out of the list
// is written into a list literal handed to a generic at `string` and again at `i32` (D10251), so its
// type parameter stays open. No function type spells that, so the annotated face refuses by design.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function id<T>(x: T): T { x }
function __run<U>(a: ((x: U) => U)[], u: U): U { a[0](u) }
// @@VALUE@@
[id]
// @@TYPE@@
((x: i32) => i32)[]
// @@PROOF@@
print(__run([v[0]], "ab").length * 10 + __run([v[0]], 2))
// @@WANT@@
22
