// D6532, the type parameter left open: the function handed on is a declared generic, bound only
// by the call the hole callee makes of it.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __id<T>(a: T): T { return a }
function __lap(g) { return g(1) + 1 }
function __lapS(g) { return g("ab") + "!" }
function __use(k) { return k(__id) }
// @@VALUE@@
__use(__lap)
// @@TYPE@@
i32
// @@PROOF@@
print(v)
// @@WANT@@
2
// @@TEST@@
v == 2
// @@HIT@@
print(v)
// @@MISS@@
print(0)
// @@VALUE2@@
__use(__lapS)
// @@TYPE2@@
string
// @@PROOF2@@
print(v + "?")
// @@WANT2@@
ab!?
