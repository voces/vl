// A list literal of un-annotated functions read where nothing names it: as the inline receiver of
// `.map` (D9863), and as a local binding returned from an un-annotated function and called at two
// types (D9763). The element is built at the callback's annotated parameter, or at each call; a
// receiver bound to a name, or a returned literal, cannot see the defect.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __inc(a) { return a + 1 }
function __ap(r: (a: i32) => i32): i32 { return r(5) }
function __give(_n) {
  const u = [__inc]
  return u
}
// @@VALUE@@
[__inc].map(__ap)
// @@TYPE@@
i32[]
// @@PROOF@@
print(v[0] + 1)
// @@WANT@@
7
// @@VALUE2@@
__give("s")
// @@TYPE2@@
((a: i32) => i32)[]
// @@PROOF2@@
if v[0](3) == 4 {
  print(__give(1)[0](2.5))
} else {
  print("wrong i32 read")
}
// @@WANT2@@
3.5
