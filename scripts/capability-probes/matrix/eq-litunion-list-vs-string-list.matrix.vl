// `==` over a list of a string literal union and a `string[]`, the result delivered at every
// position: the literal list is read as strings, so the two compare by value (D16393).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
const __ua: ("a" | "b")[] = ["a"]
const __ub: string[] = ["a"]
// @@VALUE@@
__ua == __ub
// @@TYPE@@
boolean
// @@TEST@@
v
// @@HIT@@
print(1)
// @@MISS@@
print(0)
// @@WANT@@
1
// @@CELL_reversed_and_not_equal@@
// want: true then false
print(__ub == __ua)
print(__ua != __ub)
// @@CELL_unequal@@
// want: false
const __uc: string[] = ["b"]
print(__ua == __uc)
// @@CELL_nullable_elements@@
// want: true then false
const __na: ("a" | "b" | null)[] = ["a", null]
const __nb: (string | null)[] = ["a", null]
print(__na == __nb)
const __nc: (string | null)[] = ["a", "b"]
print(__na == __nc)
// @@CELL_parameters@@
// want: true
function __pf(a: ("a" | "b")[], b: string[]) { return a == b }
print(__pf(["b"], ["b"]))
// @@CELL_original_kept@@
// want: true then 2
print(__ua == __ub)
__ua.push("b")
print(__ua.length)
