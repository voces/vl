// D15170: a generic parameter annotated with a type parameter beside literal members, `T | "a" |
// "b"`, tests a literal with `is` at the instance its argument pins. The second instance hands
// the literal itself.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function fk<T>(p: T | "a" | "b"): string {
  if p is "a" { return "is a" }
  "t"
}
function fm(n: i32): i32 { n + 1 }
// @@VALUE@@
fm(6)
// @@TYPE@@
i32
// @@TEST@@
fk(v) == "t" && fk<i32>(v) == "t"
// @@HIT@@
print("value")
// @@MISS@@
print("storage")
// @@WANT@@
value
// @@VALUE2@@
fm(1)
// @@TYPE2@@
i32
// @@PROOF2@@
print("\{fk(v)} \{fk<i32>("a")} \{fk<boolean>("b")}")
// @@WANT2@@
t is a t
