// D1522 — a BARE map `m.get(k)` (no `??`), the method spelling of `m[k]`. Before the fix
// it was `emitProgram: callee is not a function name` at every position; the bracket
// spelling ran at all of them, which is what says the rep was never the missing piece.
//
// This template is what re-grades it at every delivery, and it is the instrument that
// caught the first attempt: wiring the LOWERING alone made `print(m.get(k))` emit a plain
// i32 while `exprUnion` read the call's checker type (`i32 | null`) and claimed the
// value-union BOX — clause 2 traded for clause 1 at print, and the binding, the f64 rep
// and the fused form each still refusing.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
const gm: {[string]: i32} = Map()
gm.set("a", 3)
const gf: {[string]: f64} = Map()
gf.set("a", 1.5)
// @@VALUE@@
gm.get("a")
// @@TYPE@@
i32 | null
// @@TEST@@
v != null
// @@HIT@@
print(v ?? 0)
// @@MISS@@
print(0)
// @@WANT@@
3
// @@VALUE2@@
gf.get("a")
// @@TYPE2@@
f64 | null
// @@PROOF2@@
print(v ?? 0.0)
// @@WANT2@@
1.5
