// v128-struct-field (AE-004, D1981, D16481) — a record whose field is an `F32x4`, delivered
// whole at every position. The field is a `v128` struct slot; the proof reads a lane back and
// checks the record's other field, so a position that loses the vector or misreads its slot
// fails. Lanes are read through `zOf`, as a getter does not satisfy a hole parameter's field.
// Own cells write the field, compound-write it, copy it, and hold it in a generic.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
import { F32x4, f32x4, splatF32 } from "std:simd"
type Body = { p: F32x4, m: i32 }
function mk(n: i32): Body { return { p: f32x4(1.0, 2.0, 3.0, 4.0), m: n } }
function zOf(b: Body): f32 { return b.p.z }
// @@VALUE@@
mk(3)
// @@TYPE@@
Body
// @@TEST@@
v.m == 3 && zOf(v) == 3.0
// @@HIT@@
print(zOf(v))
// @@MISS@@
print("miss")
// @@WANT@@
3
// @@VALUE2@@
mk(4)
// @@TYPE2@@
Body
// @@PROOF2@@
print(zOf(v) + 1.0)
// @@WANT2@@
4
// @@CELL_field_write@@
// want: 6
const b__A__ = __V__
b.p = b.p + splatF32(5.0)
print(b.p.x)
// @@CELL_field_write_in_fn@@
// want: 13
function bump(b: Body, n: i32) {
  let i = 0
  while i < n {
    b.p = b.p + splatF32(1.0)
    i = i + 1
  }
}
const b__A__ = __V__
bump(b, 10)
print(b.p.z)
// @@CELL_compound_write@@
// want: 4
const b__A__ = __V__
b.p += b.p
print(b.p.y)
// @@CELL_literal_direct@@
// want: 7
const b__A__ = { p: splatF32(7.0), m: 1 }
print(b.p.w)
// @@CELL_field_copy@@
// want: 9 then 3
const b__A__ = __V__
const c = { p: b.p, m: 9 }
print(c.m)
print(c.p.z)
// @@CELL_generic_holder@@
// want: 2
type Box<T> = { val: T }
function hold<T>(x: T): Box<T> { return { val: x } }
const h = hold(__V__)
print(h.val.p.y)
// @@CELL_union_arm@@
// want: 4
type Ev = Body | { q: i32 }
function pick(b: boolean): Ev { return if b { mk(3) } else { { q: 1 } } }
const e = pick(true)
if e is Body { print(e.p.w) } else { print("q") }
// @@CELL_nullable_field@@
// want: 1
type NB = { p: F32x4 | null }
const n: NB = { p: splatF32(1.0) }
print((n.p ?? splatF32(0.0)).x)
// @@CELL_assign_value_through_element@@
// want: 9 then 9
const bs: Body[] = [__V__]
const w = (bs[0].p = splatF32(9.0))
print(w.x)
print(bs[0].p.y)
