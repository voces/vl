// D2519 — the all-null face: the union never holds the i64-keyed map.
// The proof reads, writes, deletes, counts and walks the map after narrowing, so a box that
// casts to the wrong map struct fails validation or prints wrong.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function mk(): {[i64]: i32} {
  const m: {[i64]: i32} = Map()
  m.set(4294967296, 10)
  m.set(4294967297, 20)
  m
}
function pick(n: i32): {[i64]: i32} | null {
  if n > 0 { return mk() }
  return null
}
// @@VALUE@@
pick(0)
// @@TYPE@@
{[i64]: i32} | null
// @@TEST@@
v == null
// @@HIT@@
print("none")
// @@MISS@@
print("miss")
// @@WANT@@
none
// @@VALUE2@@
pick(-1)
// @@TYPE2@@
{[i64]: i32} | null
// @@PROOF2@@
print((v ?? mk()).length)
// @@WANT2@@
2
