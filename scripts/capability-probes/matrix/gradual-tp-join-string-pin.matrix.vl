// D2906 — an un-annotated if-join of a type parameter with a literal, `T | i32` in the body,
// delivered at a `string` pin, where it is the value union `string | i32`. The type parameter
// is left open in the body; only the call pins it.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function gj<T>(a: T, c: boolean) {
  const r = if c { a } else { 5 }
  return r
}
// @@VALUE@@
gj("x", false)
// @@TYPE@@
string | i32
// @@TEST@@
v is i32
// @@HIT@@
print(v + 1)
// @@MISS@@
print("no")
// @@WANT@@
6
// @@VALUE2@@
gj("x", true)
// @@TYPE2@@
string | i32
// @@PROOF2@@
if v is string { print(v + "!") } else { print("no") }
// @@WANT2@@
x!
