// D16952: a field read across record arms whose shared field is a list of records in one arm and
// an atom in another (`({f: i32} | {f: {a: i32}[]}).f`). The list rides the read's box under its
// list's arm tag.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function pickR(b: boolean): {f: i32} | {f: {a: i32}[]} {
  if b { return { f: 5 } }
  return { f: [{ a: 9 }, { a: 4 }] }
}
// @@VALUE@@
pickR(false).f
// @@TYPE@@
i32 | {a: i32}[]
// @@PROOF@@
if v is i32 { print(v) } else { print(v[1].a) }
// @@WANT@@
4
// @@TEST@@
v is {a: i32}[]
// @@HIT@@
print(v[1].a)
// @@MISS@@
print(0)
// @@VALUE2@@
pickR(true).f
// @@TYPE2@@
i32 | {a: i32}[]
// @@PROOF2@@
if v is i32 { print(v) } else { print(v[1].a) }
// @@WANT2@@
5
// @@CELL_nullable_list_arm@@
// want: 5 then -1 then 9
function q(n: i32): {f: i32} | {f: {a: i32}[] | null} {
  if n == 0 { return { f: 5 } }
  if n == 1 { return { f: null } }
  return { f: [{ a: 9 }] }
}
for n in [0, 1, 2] {
  const v = q(n).f
  if v is i32 { print(v) } else if v == null { print(-1) } else { print(v[0].a) }
}
// @@CELL_beside_record_arm@@
// want: 5 then 9 then x
function q(n: i32): {f: i32} | {f: {a: i32}[]} | {f: {b: string}} {
  if n == 0 { return { f: 5 } }
  if n == 1 { return { f: [{ a: 9 }] } }
  return { f: { b: "x" } }
}
for n in [0, 1, 2] {
  const v = q(n).f
  if v is i32 { print(v) } else if v is {b: string} { print(v.b) } else { print(v[0].a) }
}
// @@CELL_string_arm@@
// want: s then 2 then u
function q(b: boolean): {f: string} | {f: {a: i32, s: string}[]} {
  if b { return { f: "s" } }
  return { f: [{ a: 1, s: "t" }, { a: 2, s: "u" }] }
}
for b in [true, false] {
  const v = q(b).f
  if v is string { print(v) } else { print(v.length) ; print(v[1].s) }
}
