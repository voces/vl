// D16047 (owner ruling (a1)): an unwritten `Set()` joined with `i32` in an inferred return (`Set<_> | i32`). An element nothing writes fits every
// `is` of its kind, and a write through a narrowing pins it as a direct write does.
// The annotated face spells the settled type; the vacuous tests are un-annotated cells.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function pick(c: boolean) { if c { return Set() } return 1 }
// @@VALUE@@
pick(true)
// @@TYPE@@
Set<i32> | i32
// @@TEST@@
v is Set<i32>
// @@HIT@@
print("collection")
// @@MISS@@
print("other")
// @@WANT@@
collection
// @@VALUE2@@
pick(false)
// @@TYPE2@@
Set<i32> | i32
// @@PROOF2@@
if v is Set<i32> { print("collection") } else { print(v) }
// @@WANT2@@
1
// @@CELL_vacuous_0@@
// want: true
const v = pick(true)
print(v is Set<string>)
// @@CELL_vacuous_param_0@@
// want: true
function probe(c: boolean) {
  const v = pick(c)
  print(v is Set<string>)
}
probe(true)
// @@CELL_pin@@
// want: true
const v = pick(true)
if v is Set<i32> { v.add(7) }
if v is Set<i32> { print(v.has(7)) } else { print("other") }
