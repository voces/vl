// The generic twin of mixed-nullable-record-string-list: the literal passes through an identity
// over `T[]`, so the element type is bound by inference at the call rather than spelled.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function keep<T>(xs: T[]): T[] { xs }
// @@VALUE@@
keep(["t", null, { x: 1 }])
// @@TYPE@@
(string | { x: i32 } | null)[]
// @@PROOF@@
const e2 = v[2]
let n = 0
if v[1] == null { n = 10 }
if e2 is string { print(-1) } else if e2 == null { print(-2) } else { print(e2.x + n) }
// @@WANT@@
11
// @@TEST@@
v.length == 3
// @@HIT@@
const e2 = v[2]
let n = 0
if v[1] == null { n = 10 }
if e2 is string { print(-1) } else if e2 == null { print(-2) } else { print(e2.x + n) }
// @@MISS@@
print(0)
