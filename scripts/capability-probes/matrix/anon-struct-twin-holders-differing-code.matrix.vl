// D1704 — D1663's pair one code-KIND over: two anonymous holders sharing a field NAME whose
// ref-list fields have DIFFERENT codes, neither of which names a heap. The prelude holder's
// `xs` is a struct-ref list (code 5) and the value's is a STRING list (code 6); the two slots
// are one wasm layout apart, so the second holder taking the first's row is invalid wasm.
//
// No nullability, no narrowing and no pin — which is what separates this from D1663, whose
// pair was code 5 beside the `| null` niche 28.
//
// The first holder lives in the PRELUDE, inside a function nothing calls: `collectAnonShapes`
// walks the whole arena, so its row is minted and available to collide wherever the value is
// delivered. Removing it turns every cell green for the wrong reason.
//
// Graded by PRINTED VALUE, so a cell that builds but reads the wrong slot is red too.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type A = { r: i32 }
function as1(): A[] { return [{ r: 7 }] }
function ss1(): string[] { return ["hi"] }
function ss2(): string[] { return ["ho"] }
function firstHolder() {
  const first = { xs: as1() }
  print(first.xs[0].r)
}
// @@VALUE@@
{ xs: ss1() }
// @@TYPE@@
{ xs: string[] }
// @@PROOF@@
print(v.xs[0])
// @@WANT@@
hi
// @@VALUE2@@
{ xs: ss2() }
// @@TYPE2@@
{ xs: string[] }
// @@PROOF2@@
print(v.xs[0])
// @@WANT2@@
ho
// @@SKIP@@
is_in_if: the value is a struct, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
