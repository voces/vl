// A `(T | null)[]` of functions, handed through a generic whose `T` inference binds.
//
// The value holds a function and a `null`; the proof calls the function element and tests the
// null one, so a rep built for the wrong element type shows up as a wrong number or a trap.
// The sibling `nullable-fn-list-through-generic-explicit` names `T`; this one leaves it open.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function keep<T>(xs: (T | null)[]): (T | null)[] { return xs }
function inc(a: i32): i32 { return a + 1 }
function dbl(a: i32): i32 { return a * 2 }
// @@VALUE@@
keep([inc, null])
// @@TYPE@@
(((a: i32) => i32) | null)[]
// @@PROOF@@
const f = v[0]
if f != null { print(f(1) * 10 + (if v[1] == null { 1 } else { 0 })) }
// @@WANT@@
21
// @@VALUE2@@
keep([null, dbl])
// @@TYPE2@@
(((a: i32) => i32) | null)[]
// @@PROOF2@@
const g = v[1]
if g != null { print(g(4)) }
// @@WANT2@@
8
// @@SKIP@@
is_in_if: the value is a list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
