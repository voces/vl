// A list of maps of functions: an element's entry is overwritten, then read through the list and
// called. 7 * 2 proves the overwrite reached the element the read sees.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __inc(n: i32): i32 { return n + 1 }
function __dbl(n: i32): i32 { return n * 2 }
function __mk(): {[string]: (n: i32) => i32}[] {
  const m: {[string]: (n: i32) => i32} = Map()
  m["k"] = __inc
  return [m]
}
// @@VALUE@@
__mk()
// @@TYPE@@
{[string]: (n: i32) => i32}[]
// @@PROOF@@
v[0]["k"] = __dbl
const g = v[0]["k"]
if g != null { print(g(7)) }
// @@WANT@@
14
