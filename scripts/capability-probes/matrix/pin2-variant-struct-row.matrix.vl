// D1737 / D1738 — a struct that becomes a union VARIANT through an INFERRED join has its
// struct row registered under the structural render rather than its declared name, so the
// name scan missed it and the VARIANT-table index answered in its place. The two coincide
// only while the arm's struct is row 0.
//
// The prelude declares a second struct AND builds the inferred join, which are the two
// ingredients both rows measured; a declared `type M = string | A` does not reproduce it,
// since that registration gives `A` its own named row.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type W = { g: i32, h: i32 }
type A = { r: i32 }
function mkS(): string | null { return null }
function st(): A { return { r: 8 } }
const wpad: W = { g: 1, h: 2 }
const vpad = mkS()
const kpad = vpad ?? st()
// @@VALUE@@
st()
// @@TYPE@@
A
// @@PROOF@@
print(v.r)
// @@WANT@@
8
