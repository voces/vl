// D10130: a generic's `k?.get("a") ?? d` over a nullable map parameter, pinned at a scalar value
// type, delivered a nullable map at every position.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __og<V>(k: {[string]: V} | null, d: V): V { k?.get("a") ?? d }
function __mk(): {[string]: i32} | null {
  const m: {[string]: i32} = Map()
  m["a"] = 5
  m
}
// @@VALUE@@
__mk()
// @@TYPE@@
{[string]: i32} | null
// @@TEST@@
__og(v, 0) == 5
// @@HIT@@
print(__og(v, 0) + __og(null, 7))
// @@MISS@@
print("wrong")
// @@WANT@@
12
