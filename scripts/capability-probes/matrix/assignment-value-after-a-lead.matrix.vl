// An assignment used as a value after an earlier operand that reads the place it stores: a local,
// a global, a field and an element, at each operand position. The earlier read sees the value
// before the store, as written left to right (D17109); each cell then reads the place again.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
let __h = 1
function twoS(a: i32, c: i32) { return a * 10 + c }
function idS(n: i32) { return n }
function two(a: i64 | f64 | i32, c: i64 | f64 | i32) { return "\{a} \{c}" }
function show<T>(n: T) { return "<\{n}>" }
// @@VALUE@@
(__h = 2)
// @@TYPE@@
i32
// @@PROOF@@
print(v)
print(__h)
// @@WANT@@
2 then 2
// @@CELL_local_arg@@
// want: 12 then 2
function f() {
  let b = 1
  print(twoS(b, b = 2))
  print(b)
}
f()
// @@CELL_local_nested@@
// want: 12 then 2
function f() {
  let b = 1
  print(twoS(b, idS(b = 2)))
  print(b)
}
f()
// @@CELL_local_unionArg@@
// want: 1 2 then 2
function f() {
  let b = 1
  print(two(b, b = 2))
  print(b)
}
f()
// @@CELL_local_binop@@
// want: 12 then 2
function f() {
  let b = 1
  print(b * 10 + (b = 2))
  print(b)
}
f()
// @@CELL_local_concat@@
// want: 1<2> then 2
function f() {
  let b = 1
  print("\{b}" + show(b = 2))
  print(b)
}
f()
// @@CELL_local_interp@@
// want: 1 2 then 2
function f() {
  let b = 1
  print("\{b} \{b = 2}")
  print(b)
}
f()
// @@CELL_local_record@@
// want: 1 2 then 2
function f() {
  let b = 1
  const r = { p: b, q: b = 2 }
  print("\{r.p} \{r.q}")
  print(b)
}
f()
// @@CELL_local_array@@
// want: 1 2 then 2
function f() {
  let b = 1
  const ys = [b, b = 2]
  print("\{ys[0]} \{ys[1]}")
  print(b)
}
f()
// @@CELL_local_compare@@
// want: false then 2
function f() {
  let b = 1
  print(b == (b = 2))
  print(b)
}
f()
