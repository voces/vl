// D3123 (plumb PL-075) — an INFERRED record whose field is fed by a binding, not a `Map()`
// call: a map (i32 keys, i32 values) parameter. The field-code ladder coded a map only off a call and its spellability gate
// declines a `TyMap`, so the literal minted no row and its function's return had no shape.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function mk(k: i32, x: i32): {[i32]: i32} {
  const m: {[i32]: i32} = Map()
  m[k] = x
  m
}
function wrap(m: {[i32]: i32}) { { regs: m } }
// @@VALUE@@
wrap(mk(3, 41))
// @@TYPE@@
{ regs: {[i32]: i32} }
// @@PROOF@@
print(v.regs[3] ?? -1)
// @@WANT@@
41
// @@VALUE2@@
wrap(mk(5, 42))
// @@TYPE2@@
{ regs: {[i32]: i32} }
// @@PROOF2@@
print(v.regs[5] ?? -1)
// @@WANT2@@
42
// @@SKIP@@
is_in_if: the value is a struct, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
