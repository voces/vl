// A literal-union value compared with a string literal that is one of its members. At an
// un-annotated position the comparison is re-checked at the pin, where the literal was recorded
// as `string` and the pin refused what the direct spelling accepts.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type AB = "a" | "b"
function mkAB(k: i32): AB | null {
  const m: {[i32]: AB} = Map()
  m[3] = "b"
  m[k]
}
// @@VALUE@@
mkAB(3)
// @@TYPE@@
AB | null
// @@PROOF@@
print(v == "b")
// @@WANT@@
true
// @@VALUE2@@
mkAB(4)
// @@TYPE2@@
AB | null
// @@PROOF2@@
print("a" != v)
// @@WANT2@@
true
