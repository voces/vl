n
// @@TYPE@@
(x: i32) => string | null
// @@PROOF@@
const r = v(1)
if r != null { print(r + "!") } else { print("none") }
// @@WANT@@
s!
// @@VALUE2@@
m
// @@TYPE2@@
(x: i32) => string | null
// @@PROOF2@@
const r2 = v(1)
if r2 != null { print(r2 + "?") } else { print("none") }
