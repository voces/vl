// D16278 — a list of records holding un-annotated functions whose results differ, built inside a
// call and handed to un-annotated parameters that call each element's field, by index and by
// `for`: each call dispatches on the member the element holds, as the same loop at module scope
// does. The built-in positions deliver the list; the cells vary where it comes from.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function mk() { return { a: [{ f: inc0 }, { f: half }] } }
function take(v) {
  let acc = 0.0
  let i = 0
  while i < v.length {
    acc = acc + v[i].f(3)
    i = i + 1
  }
  print(acc)
}
function takeF(v) {
  let acc = 0.0
  for e in v { acc = acc + e.f(3) }
  print(acc)
}
// @@VALUE@@
mk().a
// @@TYPE@@
{ f: (a: i32) => f64 }[]
// @@PROOF@@
take(v)
takeF(v)
// @@WANT@@
5.5 then 5.5
// @@CELL_bound_index@@
// want: 5.5
const L = mk().a
take(L)
// @@CELL_bound_for@@
// want: 5.5
const L = mk().a
takeF(L)
// @@CELL_bound_in_function@@
// want: 5.5 then 5.5
function main() {
  const L = mk().a
  take(L)
  takeF(L)
}
main()
// @@CELL_let_bound@@
// want: 5.5
let L = mk().a
take(L)
// @@CELL_literal_list_for@@
// want: 5.5
const L = [{ f: inc0 }, { f: half }]
takeF(L)
// @@CELL_literal_list_index@@
// want: 5.5
const L = [{ f: inc0 }, { f: half }]
take(L)
// @@CELL_direct_index@@
// want: 5.5
take(mk().a)
// @@CELL_direct_for@@
// want: 5.5
takeF(mk().a)
// @@CELL_record_bound_field@@
// want: 5.5
const r = mk()
take(r.a)
// @@CELL_module_loop@@
// want: 5.5
const v2 = mk().a
let acc = 0.0
for e in v2 { acc = acc + e.f(3) }
print(acc)
