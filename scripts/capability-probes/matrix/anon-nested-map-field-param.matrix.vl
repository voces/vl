// D3123 (plumb PL-075) — an INFERRED record whose field is fed by a binding, not a `Map()`
// call: a map of maps parameter. The field-code ladder coded a map only off a call and its spellability gate
// declines a `TyMap`, so the literal minted no row and its function's return had no shape.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function mkN(k: i32, x: i32): {[i32]: {[i32]: i32}} {
  const inner: {[i32]: i32} = Map()
  inner[k] = x
  const m: {[i32]: {[i32]: i32}} = Map()
  m[1] = inner
  m
}
function wrapN(m: {[i32]: {[i32]: i32}}) { { regs: m } }
// @@VALUE@@
wrapN(mkN(4, 43))
// @@TYPE@@
{ regs: {[i32]: {[i32]: i32}} }
// @@PROOF@@
const im = v.regs[1]
if im != null { print(im[4] ?? -1) } else { print(-2) }
// @@WANT@@
43
// @@VALUE2@@
wrapN(mkN(6, 44))
// @@TYPE2@@
{ regs: {[i32]: {[i32]: i32}} }
// @@PROOF2@@
const im2 = v.regs[1]
if im2 != null { print(im2[6] ?? -1) } else { print(-2) }
// @@WANT2@@
44
// @@SKIP@@
is_in_if: the value is a struct, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
