// D16170: a field read over a union of records whose members store the field as nullable records
// of different types. The value under test is that shared read, typed as both records or `null`,
// delivered to every position and tested for `null` there; the cells also narrow it back to one
// record.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type X = { a: i32 }
type Y = { b: string }
type A = { v: X | null }
type B = { v: Y | null }
const b: B = { v: { b: "s" } }
const u: A | B = b
// @@VALUE@@
u.v
// @@TYPE@@
X | Y | null
// @@TEST@@
v == null
// @@HIT@@
print("null")
// @@MISS@@
print("set")
// @@WANT@@
set
// @@CELL_narrow_other@@
// want: s
const w = u.v
if w is Y { print(w.b) } else { print("no") }
// @@CELL_null_arm@@
// want: true
const n: A | B = { v: null }
print(n.v == null)
// @@CELL_list_of_union@@
// want: 1
const us: (A | B)[] = [{ v: null }, b]
let nulls = 0
for x in us {
  if x.v == null { nulls = nulls + 1 }
}
print(nulls)
