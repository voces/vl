// D1812 — `x as! {[string]: i32}` over a niche-repped map. The map niche is the rep `??`
// itself does not serve, so this is the widest arm the trap form reaches.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function s1(): { [string]: i32 } | null {
  const m: { [string]: i32 } = Map()
  m["k"] = 5
  return m
}
function s2(): { [string]: i32 } | null {
  const m: { [string]: i32 } = Map()
  m["k"] = 8
  return m
}
// @@VALUE@@
s1() as! { [string]: i32 }
// @@TYPE@@
{ [string]: i32 }
// @@PROOF@@
print(v["k"] ?? 0)
// @@WANT@@
5
// @@VALUE2@@
s2() as! { [string]: i32 }
// @@TYPE2@@
{ [string]: i32 }
// @@PROOF2@@
print(v["k"] ?? 0)
// @@WANT2@@
8
// @@SKIP@@
is_in_if: the value is a plain map, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
