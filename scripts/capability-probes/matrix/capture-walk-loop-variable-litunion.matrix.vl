// D3119 — the value is read through a closure over an un-annotated copy of a `for-in` variable
// walking a `K | null` list, narrowed to `K`. The copy and the closure are un-annotated, so the
// loop variable's atom rep reaches every delivery through inference alone; a read at the
// wrong rep prints the atom's index instead of the literal.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type K = "a" | "b"
function __walk(ns: (K | null)[]): K {
  for n in ns {
    if n != null {
      const c = n
      const f = () => c
      return f()
    }
  }
  return "b"
}
// @@VALUE@@
__walk([null, "a"])
// @@TYPE@@
K
// @@WANT@@
a
// @@TEST@@
v == "a"
// @@HIT@@
print("a")
// @@MISS@@
print(v)
