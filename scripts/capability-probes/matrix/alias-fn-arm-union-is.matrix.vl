// D3269 — `is` over a value whose declared ALIAS has a function-type arm beside a value arm
// (`type F = ((x: i32) => i32) | string`). The alias is the ingredient: its member set joined
// the arm without its grouping parens, so every `is` against it folded to false; the inline
// spelling of the same union ran.
//
// The PROOF discriminates: the function arm must test true AND the string arm false, so a
// fold of either test to a constant prints `9`, never `2`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type F = ((x: i32) => i32) | string
function mk(n: i32): F {
  if n == 0 { return "s" }
  return (x: i32) => x + n
}
// @@VALUE@@
mk(1)
// @@TYPE@@
F
// @@FALLBACK@@
mk(2)
// @@TEST@@
!(v is string) && v is (x: i32) => i32
// @@HIT@@
print(2)
// @@MISS@@
print(9)
// @@WANT@@
2
