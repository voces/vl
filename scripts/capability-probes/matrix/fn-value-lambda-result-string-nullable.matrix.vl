// D9742's control: a lambda returning a `string`, or `null`, delivered where a function
// returning `string | null` is expected. The lambda takes the expected result as its own.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@VALUE@@
(x: i32) => "s"
// @@TYPE@@
(x: i32) => string | null
// @@PROOF@@
print(v(1) ?? "n")
// @@WANT@@
s
// @@VALUE2@@
(x: i32) => null
// @@TYPE2@@
(x: i32) => string | null
// @@PROOF2@@
print(v(1) ?? "n")
// @@WANT2@@
n
