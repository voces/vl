// i64-keyed-map-in-container-nullable — an i64-keyed map (`{[i64]: string | null}`) delivered to every container position the
// position matrix knows, the i64 twin of `i32-keyed-map-in-container`. The PROOF writes through the
// delivered map at a key past the i32 range and reads it back, and the second instance reads the
// key whose low half is the first key's, so a map that lost the high half of its keys prints wrong.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function mkMap(): {[i64]: string | null} {
  const m: {[i64]: string | null} = Map()
  m.set(4294967296, "a")
  return m
}
// @@VALUE@@
mkMap()
// @@TYPE@@
{[i64]: string | null}
// @@PROOF@@
v.set(4294967297, null)
print(v.has(4294967297) && (v.get(4294967297) ?? "was-null") == "was-null")
// @@WANT@@
true
// @@VALUE2@@
mkMap()
// @@TYPE2@@
{[i64]: string | null}
// @@PROOF2@@
print(v.has(1))
// @@WANT2@@
false
