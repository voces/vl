// D16398 — a record literal delivered into a union's record arm whose two fields each hold a
// one-function record of a different function type. The two nested records share one storage
// row; each literal is still the arm's own field type, and is boxed into the union as its arm.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type R = {a: {f: () => string}, b: {f: () => f64}}
function rd(g: R | string): string {
  if g is string { return g }
  "\{g.a.f()} \{g.b.f()}"
}
// @@VALUE@@
{a: {f: () => "a"}, b: {f: () => 9.5}}
// @@TYPE@@
R | string
// @@PROOF@@
print(rd(v))
// @@WANT@@
a 9.5
// @@CELL_union_with_i32@@
// want: 9.5
const g: R | i32 = {a: {f: () => "a"}, b: {f: () => 9.5}}
if g is i32 { print(0) } else { print(g.b.f()) }
// @@CELL_union_with_record@@
// want: a
const g: R | {q: i32} = {a: {f: () => "a"}, b: {f: () => 9.5}}
if g is R { print(g.a.f()) } else { print(0) }
// @@CELL_params_differ@@
// want: b3
const g: {a: {f: () => string}, b: {f: (x: i32) => string}} | string = {a: {f: () => "a"}, b: {f: (x: i32) => "b\{x}"}}
if g is string { print(0) } else { print(g.b.f(3)) }
// @@CELL_returned_through_alias@@
// want: a 9.5
type U = R | string
function mk(): U { return {a: {f: () => "a"}, b: {f: () => 9.5}} }
print(rd(mk()))
