// D3028 — an `i32[]` from a call, delivered where a `readonly i64[]` is declared, is a view of
// its source: the proof grows the source through the module binding the call returned, then
// reads the new element and the length through the view. A snapshot copy prints `2`'s sum, not
// this one; the un-annotated face shares the `i32[]` itself and must agree.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
const svwG: i32[] = [1, 2]
function svwGet(): i32[] { return svwG }
// @@SETUP@@
const svwL = svwGet()
// @@VALUE@@
svwL
// @@TYPE@@
readonly i64[]
// @@PROOF@@
svwG.push(9)
print(v[2] + v.length)
// @@WANT@@
12
