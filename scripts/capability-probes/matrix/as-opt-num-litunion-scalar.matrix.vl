// D11221's scalar `as?` twin — `w as? N2` with `w: N3`. A hit is the base-tagged box of the
// scalar, a miss its null box, so a `!= null` test narrows the result back to the atom.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type N2 = 1 | 2
type N3 = 1 | 2 | 3
function mk(k: i32): N3 {
  if k == 0 { return 3 }
  if k == 1 { return 1 }
  2
}
// @@VALUE@@
mk(2) as? N2
// @@TYPE@@
N2 | null
// @@TEST@@
v != null
// @@HIT@@
print(v + 10)
// @@MISS@@
print(0)
// @@WANT@@
12
// @@VALUE2@@
mk(0) as? N2
// @@TYPE2@@
N2 | null
// @@PROOF2@@
print(v == null)
// @@WANT2@@
true
