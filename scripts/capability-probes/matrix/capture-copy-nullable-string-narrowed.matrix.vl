// D2606 — the value is a copy of a `string | null` binding read under a GUARD. A closure capturing an
// un-annotated copy of it typed its env field from the copy's initializer in a frame whose
// locals are not registered, so a function-scope capture fell to the `i32` default.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function __src(n: i32): string | null { if n == 0 { return null } return "s" }
// @@SETUP@@
const __x: string | null = __src(1)
// @@GUARD@@
__x != null
// @@FALLBACK@@
"s"
// @@VALUE@@
__x
// @@TYPE@@
string
// @@PROOF@@
print(v + "!")
// @@WANT@@
s!
