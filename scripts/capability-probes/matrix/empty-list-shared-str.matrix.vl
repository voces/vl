// sunpa SP-043, the string-ref column: an empty `string[]` literal reads the shared backing of
// its type, and a push into one list must not show in another.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@VALUE@@
[]
// @@TYPE@@
string[]
// @@PROOF@@
v.push("p")
const other: string[] = []
other.push("w")
v.push("q")
print(v[0] + v[1] + other[0] + "/" + v[v.length - 1] + other[other.length - 1])
// @@WANT@@
pqw/qw
// @@VALUE2@@
[]
// @@PROOF2@@
if v.length == 0 { print("n0") }
// @@WANT2@@
n0
// @@SKIP@@
is_in_if: the value is a list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
