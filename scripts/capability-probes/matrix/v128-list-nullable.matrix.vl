// v128-list-nullable (D1981's `F32x4[] | null` face) — a nullable flat vector list, delivered
// at every position: the proof narrows it and reads a lane through `sumX`. The all-null twin is
// the own `all_null` cell. Own cells write through the narrowed list and read it as a map value.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
import { F32x4, f32x4, splatF32 } from "std:simd"
function mk(n: i32): F32x4[] | null {
  if n < 0 { return null }
  const r: F32x4[] = []
  let i = 0
  while i < n {
    r.push(f32x4(i as f32, 1.0, 2.0, 3.0))
    i = i + 1
  }
  return r
}
function sumX(xs: F32x4[]): f32 {
  let s = 0.0 as f32
  for v in xs { s = s + v.x }
  return s
}
// @@VALUE@@
mk(3)
// @@TYPE@@
F32x4[] | null
// @@TEST@@
v != null && v.length == 3
// @@HIT@@
if v != null { print(sumX(v)) }
// @@MISS@@
print("none")
// @@WANT@@
3
// @@VALUE2@@
mk(4)
// @@TYPE2@@
F32x4[] | null
// @@PROOF2@@
print(sumX(v ?? []) + 1.0)
// @@WANT2@@
7
// @@CELL_all_null@@
// want: true then 9
const xs__A__ = mk(-1)
print(xs == null)
print(sumX(xs ?? [splatF32(9.0)]))
// @@CELL_push_through_narrow@@
// want: 4 then 12
const xs__A__ = __V__
if xs != null {
  xs.push(splatF32(9.0))
  print(xs.length)
  print(sumX(xs))
}
// @@CELL_reassign@@
// want: 1 then true
let xs__A__ = __V__
xs = [splatF32(1.0)]
if xs != null { print(sumX(xs)) }
xs = null
print(xs == null)
// @@CELL_map_value_get@@
// want: 3 then 2
const xs__A__ = __V__
const m: {[string]: F32x4[]} = Map()
if xs != null { m.set("a", xs) }
const g = m.get("a")
if g != null { print(sumX(g)) }
m.set("b", [splatF32(1.0), splatF32(1.0)])
print(sumX(m["b"] ?? []))
// @@CELL_field@@
// want: 3
type Holder = { ps: F32x4[] | null }
const h: Holder = { ps: __V__ }
const p = h.ps
if p != null { print(sumX(p)) }
