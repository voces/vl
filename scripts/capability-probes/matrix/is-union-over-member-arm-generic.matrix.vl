// `is U` over a type parameter pinned at one member of the union `U`: the generic twin of
// `is-union-over-member-arm.matrix.vl`, its test asked in the instance of a generic body
// (D3359).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type P = { x: i32 }
type U = P | string
function fits<T>(a: T): boolean { return a is U }
function mk(n: i32): P { return { x: n } }
// @@VALUE@@
mk(4)
// @@TYPE@@
P
// @@TEST@@
fits(v)
// @@HIT@@
print(v.x)
// @@MISS@@
print(0)
// @@WANT@@
4
// @@VALUE2@@
"s"
// @@TYPE2@@
string
// @@PROOF2@@
print(fits(v))
// @@WANT2@@
true
