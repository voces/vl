// D16846, D16850: two calls of a maker with an un-annotated parameter, at two pins, each bound and
// handed on to a parameter that calls it at its own signature. `direct_*` and `one_instance` are
// the open faces (D16852, D16851); D16845's one closure at two signatures is not a cell here.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function adder(n) { return (a) => a + n }
// @@VALUE@@
adder(2)
// @@TYPE@@
(a: i32) => i32
// @@PROOF@@
print(v(3))
// @@WANT@@
5
// @@CELL_two_hole_params@@
// want: 5 then 2.75
function take(a__A__) { print(a(3)) }
function half(a) { print(a(0.5)) }
const x = __V__
take(x)
const z = adder(2.25)
half(z)
// @@CELL_two_hole_params_wider_first@@
// want: 2.75 then 5
function take(a__A__) { print(a(3)) }
function half(a) { print(a(0.5)) }
const z = adder(2.25)
half(z)
const x = __V__
take(x)
// @@CELL_annotated_destinations@@
// want: 5 then 2.75
function take(a: (a: i32) => i32) { print(a(3)) }
function half(a: (a: f64) => f64) { print(a(0.5)) }
const x = __V__
take(x)
const z = adder(2.25)
half(z)
// @@CELL_one_annotated_destination@@
// want: 5 then 2.75
function take(a__A__) { print(a(3)) }
function half(a: (a: f64) => f64) { print(a(0.5)) }
const x = __V__
take(x)
const z = adder(2.25)
half(z)
// @@CELL_direct_then_handed@@
// want: 5 then 2.75
function half(a) { print(a(0.5)) }
const x = __V__
print(x(3))
const z = adder(2.25)
half(z)
// @@CELL_direct_annotated_then_handed@@
// want: 5 then 2.75
function take(a: (a: i32) => i32) { print(a(3)) }
function half(a) { print(a(0.5)) }
const x = __V__
take(x)
const z = adder(2.25)
half(z)
// @@CELL_one_instance@@
// want: 5 then 2.75
function adderAt(n: f64) { return (a) => a + n }
function take(a: (a: i32) => f64) { print(a(3)) }
function half(a: (a: f64) => f64) { print(a(0.5)) }
const x = adderAt(2)
take(x)
const z = adderAt(2.25)
half(z)
