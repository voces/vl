// D1723 — a narrowed struct arm of an INFERRED union, delivered to a parameter annotated with
// the arm's own plain-struct name. `emitCall` unboxed only under `cVi`, the PARAMETER's
// variant row, and an inferred union's arm has no such row: the box went in whole at
// `vl check` rc 0.
//
// The union here is deliberately UN-declared — `mk` has no return annotation — since the
// declared spelling gives `A` a variant row and runs on either side.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type A = { r: i32 }
function st(): A { return { r: 8 } }
function mk(b: boolean) {
  if b { return st() }
  7
}
// @@SETUP@@
const p = mk(true)
// @@GUARD@@
p is A
// @@VALUE@@
p
// @@TYPE@@
A
// @@FALLBACK@@
st()
// @@PROOF@@
print(v.r)
// @@WANT@@
8
