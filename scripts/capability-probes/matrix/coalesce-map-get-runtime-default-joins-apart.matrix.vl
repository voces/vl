// D10061: a `??` over a method call's nullable `i32` result (`m.get(k)`) with a runtime `f64`
// default is `i32 | f64`, as the same `??` over a parameter is (the numeric-join ruling).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __cjM(m: Map<string, i32>, k: string, d: f64) { return m.get(k) ?? d }
const __cjMap: Map<string, i32> = Map()
__cjMap.set("k", 5)
// @@VALUE@@
__cjM(__cjMap, "k", 1.5)
// @@TYPE@@
i32 | f64
// @@TEST@@
v is i32
// @@HIT@@
print(v * 2)
// @@MISS@@
print("widened")
// @@WANT@@
10
// @@VALUE2@@
__cjM(__cjMap, "z", 1.5)
// @@TYPE2@@
i32 | f64
// @@PROOF2@@
print(v)
// @@WANT2@@
1.5
