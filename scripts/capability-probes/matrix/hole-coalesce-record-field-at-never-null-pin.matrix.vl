// D9911: a record literal whose field is a `??` over an un-annotated parameter pinned at a
// never-null `i32` is a `{ n: i32 }`, though its default is a float. The proof divides, which
// prints `2` at `i32` and `2.5` at `f64`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __crTake(a) { return { n: a ?? 1.5 } }
const __crPin: i32 = 5
// @@VALUE@@
__crTake(__crPin)
// @@TYPE@@
{ n: i32 }
// @@TEST@@
v.n > 0
// @@HIT@@
print(v.n / 2)
// @@MISS@@
print("miss")
// @@WANT@@
2
