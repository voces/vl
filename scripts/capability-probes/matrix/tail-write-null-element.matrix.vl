// D2497 — the element twin of `tail-write-null-field`: an un-annotated function whose tail
// statement writes a bare `null` to a list element returns that `null`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __tw(xs: (string | null)[]) { xs[0] = null }
// @@VALUE@@
__tw(["a"])
// @@TYPE@@
string | null
// @@TEST@@
v != null
// @@HIT@@
print(v)
// @@MISS@@
print("none")
// @@WANT@@
none
// @@SKIP@@
map_value: a map whose VALUE is `null` cannot be told from a missing key — the read's `!= null` guard is false either way
