// v128-list-union (D16943) — a vector list as a value-union member, `F32x4[] | string`, delivered
// at every position: the proof narrows it with `is` and reads a lane through `sumX`. Own cells
// pair the list with an `i32` and an `f32[]` arm, hold it in a list and a record field, and
// write the other arm over it.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
import { F32x4, f32x4, splatF32 } from "std:simd"
function pick(n: i32): F32x4[] | string {
  if n < 0 { return "none" }
  const r: F32x4[] = []
  let i = 0
  while i < n {
    r.push(f32x4(i as f32, 1.0, 2.0, 3.0))
    i = i + 1
  }
  return r
}
function sumX(xs: F32x4[]): f32 {
  let s = 0.0 as f32
  for v in xs { s = s + v.x }
  return s
}
// @@VALUE@@
pick(3)
// @@TYPE@@
F32x4[] | string
// @@TEST@@
v is F32x4[]
// @@HIT@@
if v is F32x4[] { print(sumX(v)) }
// @@MISS@@
print("miss")
// @@WANT@@
3
// @@VALUE2@@
pick(4)
// @@TYPE2@@
F32x4[] | string
// @@PROOF2@@
if v is F32x4[] { print(sumX(v) + 1.0) } else { print(v) }
// @@WANT2@@
7
// @@CELL_string_arm@@
// want: none
const v__A__ = pick(-1)
if v is string { print(v) } else { print(sumX(v)) }
// @@CELL_i32_arm@@
// want: 3 then 2
const v__A__ = __V__
let w: F32x4[] | i32 = 3
if w is i32 { print(w) }
w = [splatF32(1.0), splatF32(1.0)]
if w is F32x4[] { print(sumX(w)) }
// @@CELL_f32_list_arm@@
// want: 1.5 then 4
const v__A__ = __V__
let w: F32x4[] | f32[] = [1.5 as f32]
if w is f32[] { print(w[0]) }
w = [splatF32(4.0)]
if w is F32x4[] { print(w[0].x) }
// @@CELL_in_list@@
// want: a then 3
const v__A__ = __V__
const xs: (F32x4[] | string)[] = ["a", __V__]
for x in xs {
  if x is string { print(x) } else { print(sumX(x)) }
}
// @@CELL_field@@
// want: 3
type Holder = { u: F32x4[] | string }
const h: Holder = { u: __V__ }
const hu = h.u
if hu is F32x4[] { print(sumX(hu)) }
// @@CELL_overwrite@@
// want: s
let v__A__ = __V__
v = "s"
if v is string { print(v) }
