// A binding holding an un-annotated function handed to a function-typed parameter of a generic
// whose result type parameter only that function's body binds (D8981): a `const` lambda, and a
// `const` alias of a declared one. The function named directly is
// `hole-fn-to-generic-fn-param-result.matrix.vl` and cannot see the defect.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
const half = (a) => a / 2.0
function inc0(a) { return a + 1 }
const inc = inc0
function apply<T, R>(h: (T) => R, x: T): R { return h(x) }
// @@VALUE@@
apply(half, 3)
// @@TYPE@@
f64
// @@PROOF@@
print(v * 2.0)
// @@WANT@@
3
// @@VALUE2@@
apply(inc, 3)
// @@TYPE2@@
i32
// @@PROOF2@@
print(v + 1)
// @@WANT2@@
5
