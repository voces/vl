// D14224: a literal binding of two record shapes, delivered by its identifier as a record list,
// adopts the destination; every position must build it there.
// @@PRELUDE@@
type Cir2 = { c2: i32 }
type Sq2 = { s2: i32 }
type Shape2 = Cir2 | Sq2
type Circle = { r: Shape2 }
// @@SETUP@@
const lv1 = [{ r: { c2: 1 } }, { r: { s2: 5 } }]
// @@VALUE@@
lv1
// @@TYPE@@
Circle[]
