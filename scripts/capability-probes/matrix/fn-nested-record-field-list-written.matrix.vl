// D15168: a nested record literal's list field written a function of another result type. The
// write joins the nested field's element set, so a call through it runs the written function.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __inc(a) { return a + 1 }
function __half(a) { return a / 2.0 }
// @@SETUP@@
const __rec = { inner: { fs: [__inc] } }
__rec.inner.fs[0] = __half
// @@VALUE@@
__rec
// @@TYPE@@
{ inner: { fs: readonly ((a: i32) => i32 | f64)[] } }
// @@PROOF@@
print(v.inner.fs[0](3))
// @@WANT@@
1.5
