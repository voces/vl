// A `??` whose left is typed `null`, at every delivery position: the left runs for its effect where
// the value is read, then the default is the value (D17421). The cells read the call trace.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type __Nu = { id: i32, tags: null }
let __dtr = ""
const __du: __Nu = { id: 2, tags: null }
function __dmk(): __Nu {
  __dtr = __dtr + "m"
  return __du
}
function __dg(): string | null {
  __dtr = __dtr + "g"
  return "x"
}
function __dn(): null {
  __dtr = __dtr + "n"
  return null
}
// @@VALUE@@
(__du.tags ?? __dg())
// @@TYPE@@
string | null
// @@PROOF@@
print(v ?? "-")
// @@WANT@@
x
// @@TEST@@
v == "x"
// @@HIT@@
print("x")
// @@MISS@@
print("miss")
// @@CELL_print_call_left@@
// want: x then ng
print(__dn() ?? __dg())
print(__dtr)
// @@CELL_compare_left@@
// want: true then mg
function __f(s: string | null): boolean { return (__dmk().tags ?? __dg()) == s }
print(__f("x"))
print(__dtr)
// @@CELL_print_call_receiver@@
// want: x then mg
print(__dmk().tags ?? __dg())
print(__dtr)
// @@CELL_return_tail@@
// want: x then mg
function __r(): string | null { return __dmk().tags ?? __dg() }
print(__r() ?? "-")
print(__dtr)
// @@CELL_chain@@
// want: x then mng
print(__dmk().tags ?? __dn() ?? __dg())
print(__dtr)
// @@CELL_global_initializer@@
// want: true then mn
const __gi: null = __dmk().tags ?? __dn()
print(__gi == null)
print(__dtr)
