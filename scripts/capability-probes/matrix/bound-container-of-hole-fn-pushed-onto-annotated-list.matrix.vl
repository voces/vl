// A binding holding a container of an un-annotated function, pushed onto an annotated list of such
// containers and called through it: the push gives the binding's element its annotated destination,
// so the function is instanced there (D15752).
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function inc0(a) { return a + 1 }
const inner = [inc0]
// @@VALUE@@
inner
// @@TYPE@@
((a: f64) => f64)[]
// @@PROOF@@
print(v[0](6))
// @@WANT@@
7
// @@CELL_push_bound_list@@
const xs: ((a: f64) => f64)[][] = []
xs.push(inner)
print(xs[0][0](6))
// @@CELL_push_bound_list_default_sig@@
const xs: ((a: i32) => i32)[][] = []
xs.push(inner)
print(xs[0][0](6))
// @@CELL_push_bound_list_twice@@
// want: 14
const xs: ((a: f64) => f64)[][] = []
xs.push(inner)
xs.push(inner)
print(xs[0][0](6) + xs[1][0](6))
// @@CELL_push_bound_list_in_function@@
function go() {
  const ys = [inc0]
  const xs: ((a: f64) => f64)[][] = []
  xs.push(ys)
  print(xs[0][0](6))
}
go()
// @@CELL_push_bound_list_no_read@@
// want: 1
const xs: ((a: f64) => f64)[][] = []
xs.push(inner)
print(xs.length)
// @@CELL_push_bound_map@@
const m = Map()
m.set("a", inc0)
const xs: ({ [string]: (a: f64) => f64 })[] = []
xs.push(m)
const f = xs[0].get("a")
if f != null { print(f(6)) }
