// An un-annotated parameter written into a place that admits `null`, then read, at a litunion pin:
// the place reads at the pin's member, as a `<T>` parameter's write does (D3299, D3436).
// Positions: a local, a declared record's field, a list cell. Reads: member, operator,
// `== null`, print. The annotated face is the twin `x: TYPE`.
// @@PRELUDE@@
type Ab = "a" | "b"
// @@VALUE@@
"a"
// @@TYPE@@
Ab
// @@PROOF@@
print(v == null)
// @@WANT@@
false
// @@CELL_name_member@@
// want: true
function g(x__A__) {
  let s: Ab | null = null
  s = x
  print(s == "a")
}
g(__V__)
// @@CELL_name_operator@@
// want: a!
function g(x__A__) {
  let s: Ab | null = null
  s = x
  print(s + "!")
}
g(__V__)
