// A `const` bound to a call of a function returning one of two generic functions, delivered to
// each position and called there at TWO types, so the value stays open. No function type spells
// that, so the annotated face refuses by design; the un-annotated face selects each type's
// instance of the function the call returned (D10021).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function idg<T>(t: T): T { return t }
function kg<T>(t: T): T { return t + t }
function pick(n: i32) {
  if n > 1 { return kg }
  return idg
}
const h = pick([1, 2].length)
// @@VALUE@@
h
// @@TYPE@@
(x: i32) => i32
// @@PROOF@@
print(v("ab").length * 100 + v(7))
// @@WANT@@
414
