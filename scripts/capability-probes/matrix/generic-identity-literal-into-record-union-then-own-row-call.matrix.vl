// D8340, the D8203 face in the other order: a literal handed through a generic identity into a
// union holding a wider record, and after it a generic call taking a literal of the same field
// names at its own row. The proof's call needs that row. The type parameter stays open.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type J = { r: i32 | null }
function idn<T>(v: T): T { v }
function one<T>(v: T): i32 { 1 }
// @@VALUE@@
idn({ r: 4 })
// @@TYPE@@
J | string
// @@WANT@@
5
// @@PROOF@@
const got = if v is J { v.r ?? 0 } else { 0 }
print(got + one({ r: 5 }))
// @@SKIP@@
array_element_place: a narrowed list element re-read for a nullable field is D8145, with no generic call in it
