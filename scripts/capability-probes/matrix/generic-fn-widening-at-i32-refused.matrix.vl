// The generic twin of `hole-fn-widening-at-i32-refused.matrix.vl`: the widening function's
// parameter is a type parameter `T` left open, bound to `i32` only by the call (D8940). `x / 2.0`
// at `T = i32` is `f64`, so the ANNOTATED face must read `check refuses` at every position, and
// never SILENT; the un-annotated face infers `f64` and runs. The second instance is a generic
// wrapper of an un-annotated widening function.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function halfG<T>(x: T) { return x / 2.0 }
function half(a) { return a / 2.0 }
function wrapG<T>(x: T) { return half(x) }
// @@VALUE@@
halfG(3)
// @@TYPE@@
i32
// @@PROOF@@
print(v)
// @@WANT@@
1.5
// @@VALUE2@@
wrapG(3)
// @@TYPE2@@
i32
// @@PROOF2@@
print(v)
// @@WANT2@@
1.5
