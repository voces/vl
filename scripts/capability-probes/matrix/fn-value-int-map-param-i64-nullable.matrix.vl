// D9920: a named function whose parameter is a nullable i64-keyed map, delivered where a
// function of that parameter is expected, and called with a map and with `null`. The key is
// past the i32 range, so a map that lost the high half of its keys reads the miss.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function g(k: {[i64]: f64} | null): f64 {
  if k == null { return 0.25 }
  (k.get(4294967296) ?? 0.0) + 0.5
}
function mk(): {[i64]: f64} {
  const m: {[i64]: f64} = Map()
  m.set(4294967296, 41.0)
  m
}
// @@VALUE@@
g
// @@TYPE@@
(k: {[i64]: f64} | null) => f64
// @@PROOF@@
print(v(mk()) + v(null))
// @@WANT@@
41.75
