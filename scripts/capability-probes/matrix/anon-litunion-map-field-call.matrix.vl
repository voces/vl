// D3123 — an INFERRED record whose map field has a literal-union VALUE, fed by a call and by a
// binding. The field's mv-slot key came from a root render that widens the union to `string`,
// so the row held a string-valued slot and the map's i32 atoms were stored into it. The
// argument cell's un-annotated face reaches a separate hole-instance `??` defect.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type AB = "a" | "b"
function mkL(k: i32, x: AB): {[i32]: AB} {
  const m: {[i32]: AB} = Map()
  m[k] = x
  m
}
function wrapL(k: i32, x: AB) {
  const b = mkL(k + 1, x)
  { direct: mkL(k, x), bound: b }
}
// @@VALUE@@
wrapL(3, "b")
// @@TYPE@@
{ direct: {[i32]: AB}, bound: {[i32]: AB} }
// @@PROOF@@
print((v.direct[3] ?? "a") + (v.bound[4] ?? "a"))
// @@WANT@@
bb
// @@VALUE2@@
wrapL(5, "a")
// @@TYPE2@@
{ direct: {[i32]: AB}, bound: {[i32]: AB} }
// @@PROOF2@@
print((v.direct[5] ?? "b") + (v.bound[9] ?? "b"))
// @@WANT2@@
ab
// @@SKIP@@
is_in_if: the value is a struct, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
