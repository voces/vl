// D1042 — a union RETURN TYPE minted by GENERIC INSTANTIATION (`T | "err"` at a scalar `T`).
// Closed 2026-09-02; this template is what re-grades it at every delivery. On master's seed
// every position runs except `return_inferred`, which is D1194 (a loud check reject on an
// inferred return whose union carries a string LITERAL member).
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function orErr<T>(x: T, bad: boolean): T | "err" {
  if bad { return "err" }
  return x
}
// @@VALUE@@
orErr(5, false)
// @@TYPE@@
i32 | "err"
// @@TEST@@
v is "err"
// @@HIT@@
print("failed")
// @@MISS@@
print(v * 2)
// @@WANT@@
10
// @@VALUE2@@
orErr(2.5, false)
// @@TYPE2@@
f64 | "err"
// @@PROOF2@@
if v is "err" { print("failed") } else { print(v * 2.0) }
// @@WANT2@@
5
