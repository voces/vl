// A record field typed by one bare string literal is stored as its atom; a read of it delivered
// where the literal's string is wanted leaves the atom, which the delivery decodes. The record
// is no union member, so the read takes the plain struct arm.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type H = { k: "circle", n: i32 }
const h: H = { k: "circle", n: 1 }
// @@VALUE@@
h.k
// @@TYPE@@
"circle"
// @@PROOF@@
print(v)
// @@WANT@@
circle
// @@VALUE2@@
h.k
// @@TYPE2@@
string
// @@PROOF2@@
print(v + "!")
// @@WANT2@@
circle!
