// A `string | null` field the checker narrowed past its null, delivered to every position: the
// IR reads the field at its inner rep, and legacy's field tail writes the read's recover.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type __R = { s: string | null, n: i32 }
// @@SETUP@@
const __r: __R = { s: "hello", n: 1 }
// @@GUARD@@
__r.s != null
// @@VALUE@@
__r.s
// @@TYPE@@
string
// @@FALLBACK@@
""
// @@PROOF@@
print(v.length)
// @@WANT@@
5
// @@TEST@@
v.length == 5
// @@HIT@@
print(5)
// @@MISS@@
print(0)
