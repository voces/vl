// @@PRELUDE@@
type J = { f: i32 | null }
function mk() { { f: 4 } }
function back(r) { return r }
const wideJ: J = mk()
const jxs = [mk()]
const plain = { f: 5 }
// @@VALUE@@
jxs[0]
// @@TYPE@@
{ f: i32 }
