// The annotated twin of `fn-value-lambda-result-map-into-alias-arm-union`: the lambda names
// its `{[string]: i32} | K` result, so only the union's registration under the function
// type is under test, not the pin of the `Map()` holes.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type Circle = { r: i32 }
type Sq = { s: i32 }
type K = Circle | Sq
function useMu(u: {[string]: i32} | K): i32 {
  if u is Circle { return u.r }
  if u is Sq { return u.s }
  u["a"] = 41
  u["a"] ?? -1
}
// @@VALUE@@
(): {[string]: i32} | K => Map()
// @@TYPE@@
() => ({[string]: i32} | K)
// @@PROOF@@
print(useMu(v()))
// @@WANT@@
41
// @@VALUE2@@
(): {[string]: i32} | K => ({ s: 5 })
// @@TYPE2@@
() => ({[string]: i32} | K)
// @@PROOF2@@
print(useMu(v()))
// @@WANT2@@
5
