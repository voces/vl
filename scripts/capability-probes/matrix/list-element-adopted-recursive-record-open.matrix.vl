// D10040's open twin — the same adopted record handed to a generic that lists its parameter,
// so the list's element is the type argument rather than a type the call site spells.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type Node = {v: i32, next: Node | null}
function one<T>(x: T): T[] {
  const ys = [x]
  return ys
}
// @@VALUE@@
{v: 7, next: null}
// @@TYPE@@
Node
// @@FALLBACK@@
{v: 0, next: null}
// @@PROOF@@
const __xs = one(v)
print(__xs[0].v)
// @@WANT@@
7
