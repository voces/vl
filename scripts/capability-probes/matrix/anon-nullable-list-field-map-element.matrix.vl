// D1691 — the nested-list template's sibling one element kind over: the field is
// `{[string]: i32}[] | null`, a nullable ref list (code 28) whose element is a MAP. The two
// shared the same named empty arm, and a map element resolves through a different table than
// a list element, so a close that keys only on one of them cannot pass both.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function mk(n: i32): {[string]: i32} {
  const m = Map()
  m["k"] = n
  return m
}
function plain(): {[string]: i32}[] { return [mk(9)] }
function nul1(): {[string]: i32}[] | null { return [mk(4)] }
function nul2(): {[string]: i32}[] | null { return [mk(5)] }
function firstHolder() {
  const first = { xs: plain() }
  print(first.xs[0]["k"] ?? 0)
}
// @@VALUE@@
{ xs: nul1() }
// @@TYPE@@
{ xs: {[string]: i32}[] | null }
// @@PROOF@@
const l = v.xs
if l != null { print(l[0]["k"] ?? 0) } else { print(0) }
// @@WANT@@
4
// @@VALUE2@@
{ xs: nul2() }
// @@TYPE2@@
{ xs: {[string]: i32}[] | null }
// @@PROOF2@@
const l2 = v.xs
if l2 != null { print(l2[0]["k"] ?? 0) } else { print(0) }
// @@WANT2@@
5
// @@SKIP@@
is_in_if: the value is a struct, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
