// A value already held as a union box, delivered into a slot of the same union: legacy's box plan
// passes it whole (`holeBoxPlanOf` `pass`), so the IR may too. This grades that delivery at every
// position, record and variant fields included, where #9222 and #9244 first refused a box from a
// box and #9254's fence now asks the plan.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function pick(n: i32): i32 | string {
  if n > 2 { return n }
  return "s"
}
// @@VALUE@@
pick(3)
// @@TYPE@@
i32 | string
// @@TEST@@
v is i32
// @@HIT@@
print(v + 1)
// @@MISS@@
print(v)
// @@WANT@@
4
