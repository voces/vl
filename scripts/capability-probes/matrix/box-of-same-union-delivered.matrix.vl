// A value already held as a union box, delivered into a slot of the same union: legacy's box plan
// passes it whole (`holeBoxPlanOf` `pass`), so the IR may too. This grades that delivery at every
// position, record and variant fields included, where #9222 and #9244 first refused a box from a
// box and #9254's fence now asks the plan. Its own cells hold a struct and a variant receiver, an
// alias of the union, a box the checker records into a wider field, the `i32` into `f64 | string`
// cast, and a narrowed wider union into a narrower field: the last two are not `pass`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function pick(n: i32): i32 | string {
  if n > 2 { return n }
  return "s"
}
function wide(n: i32): i32 | string | boolean {
  if n > 2 { return n }
  return true
}
type U = i32 | string
type Q = { v: i32 | string }
type R = { v: U }
type W = { v: i32 | string | boolean }
type F = { v: f64 | string }
type Sv = { v: i32 | string } | { n: boolean }
// @@VALUE@@
pick(3)
// @@TYPE@@
i32 | string
// @@TEST@@
v is i32
// @@HIT@@
print(v + 1)
// @@MISS@@
print(v)
// @@WANT@@
4
// @@CELL_struct_receiver@@
function cell() {
  const x__A__ = __V__
  const q: Q = { v: x }
  if q.v is i32 { print(q.v + 1) }
}
cell()
// @@CELL_variant_receiver@@
function cell() {
  const x__A__ = __V__
  const s: Sv = { v: x }
  if s is { v: i32 | string } { if s.v is i32 { print(s.v + 1) } }
}
cell()
// @@CELL_alias_destination@@
function cell() {
  const x__A__ = __V__
  const r: R = { v: x }
  if r.v is i32 { print(r.v + 1) }
}
cell()
// @@CELL_recorded_box_into_wider@@
function cell() {
  const x__A__ = __V__
  const w: W = { v: x }
  if w.v is i32 { print(w.v + 1) }
}
cell()
// @@CELL_cast_into_f64_field@@
function cell() {
  const x__A__ = __V__
  const f: F = { v: x }
  if f.v is f64 { print(f.v + 1.0) }
}
cell()
// @@CELL_wider_into_narrower@@
function cell() {
  const y = wide(3)
  if !(y is boolean) {
    const r: R = { v: y }
    if r.v is i32 { print(r.v + 1) }
  }
}
cell()
