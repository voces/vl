// D16066, D16067 — the propagating `as` over a nullable struct, list, map or closure, delivered at positions
// inside a nullable-returning function. The built-in positions deliver the cast with `as!` at
// module scope, a control; the cells hold the propagating form, each printing the present and the
// absent call.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type P = { a: i32, b: string }
type E = { msg: string }
function mp(k: i32): P | null { if k > 0 { return { a: k, b: "p" } } else { return null } }
function ml(k: i32): string[] | null { if k > 0 { return ["x", "y"] } else { return null } }
function mf(k: i32): ((i32) => i32) | null {
  if k > 0 { return (n: i32) => n * k } else { return null }
}
function mm(k: i32): {[string]: i32} | null {
  if k > 0 {
    const m: {[string]: i32} = Map()
    m["k"] = k
    return m
  }
  return null
}
// @@VALUE@@
mp(3) as! P
// @@TYPE@@
P
// @@PROOF@@
print(v.a)
// @@WANT@@
3
// @@CELL_struct_binding@@
// want: 3 -1
function f(k: i32): i32 | null {
  const p = mp(k) as P
  return p.a
}
print("\{f(3) ?? 0} \{f(0) ?? -1}")
// @@CELL_struct_inline_field@@
// want: 3 -1
function f(k: i32): i32 | null { return (mp(k) as P).a }
print("\{f(3) ?? 0} \{f(0) ?? -1}")
// @@CELL_struct_returned@@
// want: p none
function f(k: i32): P | null { return mp(k) as P }
print("\{f(3)?.b ?? "x"} \{f(0)?.b ?? "none"}")
// @@CELL_struct_argument@@
// want: 4 -1
function g(p: P): i32 { return p.a + 1 }
function f(k: i32): i32 | null { return g(mp(k) as P) }
print("\{f(3) ?? 0} \{f(0) ?? -1}")
// @@CELL_struct_in_record@@
// want: 3 -1
type W = { inner: P }
function f(k: i32): i32 | null {
  const w: W = { inner: mp(k) as P }
  return w.inner.a
}
print("\{f(3) ?? 0} \{f(0) ?? -1}")
// @@CELL_struct_in_list@@
// want: 1 -1
function f(k: i32): i32 | null {
  const ps: P[] = [mp(k) as P]
  return ps.length
}
print("\{f(3) ?? 0} \{f(0) ?? -1}")
// @@CELL_struct_param_operand@@
// want: 3 -1
function f(x: P | null): i32 | null {
  const p = x as P
  return p.a
}
print("\{f(mp(3)) ?? 0} \{f(null) ?? -1}")
// @@CELL_struct_union_return@@
// want: 3 -1
function f(k: i32): i32 | E | null {
  const p = mp(k) as P
  return p.a
}
const r1 = f(3)
const r2 = f(0)
const s1 = if r1 is i32 { r1 } else { 0 }
const s2 = if r2 == null { -1 } else { 0 }
print("\{s1} \{s2}")
// @@CELL_struct_in_loop@@
// want: 6 -1
function f(k: i32): i32 | null {
  let s = 0
  for i in 0 until 3 {
    const p = mp(k) as P
    s = s + p.a - 1
  }
  return s
}
print("\{f(3) ?? 0} \{f(0) ?? -1}")
// @@CELL_list_binding@@
// want: 2 -1
function f(k: i32): i32 | null {
  const xs = ml(k) as string[]
  return xs.length
}
print("\{f(3) ?? 0} \{f(0) ?? -1}")
// @@CELL_list_index@@
// want: y none
function f(k: i32): string | null { return (ml(k) as string[])[1] }
print("\{f(3) ?? "x"} \{f(0) ?? "none"}")
// @@CELL_list_returned@@
// want: 2 1
function f(k: i32): string[] | null { return ml(k) as string[] }
print("\{(f(3) ?? ["q"]).length} \{(f(0) ?? ["q"]).length}")
// @@CELL_list_param_operand@@
// want: 2 -1
function f(x: string[] | null): i32 | null {
  const xs = x as string[]
  return xs.length
}
print("\{f(ml(1)) ?? 0} \{f(null) ?? -1}")
// @@CELL_map_binding@@
// want: 3 -1
function f(k: i32): i32 | null {
  const m = mm(k) as {[string]: i32}
  return m["k"] ?? 0
}
print("\{f(3) ?? 0} \{f(0) ?? -1}")
// @@CELL_map_length@@
// want: 1 -1
function f(k: i32): i32 | null { return (mm(k) as {[string]: i32}).length }
print("\{f(3) ?? 0} \{f(0) ?? -1}")
// @@CELL_map_param_operand@@
// want: 3 -1
function f(x: {[string]: i32} | null): i32 | null {
  const m = x as {[string]: i32}
  return m["k"] ?? 0
}
print("\{f(mm(3)) ?? 0} \{f(null) ?? -1}")
// @@CELL_closure_binding@@
// want: 6 -1
function f(k: i32): i32 | null {
  const g = mf(k) as (i32) => i32
  return g(2)
}
print("\{f(3) ?? 0} \{f(0) ?? -1}")
// @@CELL_closure_inline_call@@
// want: 6 -1
function f(k: i32): i32 | null { return (mf(k) as (i32) => i32)(2) }
print("\{f(3) ?? 0} \{f(0) ?? -1}")
// @@CELL_closure_param_operand@@
// want: 8 -1
function f(x: ((i32) => i32) | null): i32 | null {
  const g = x as (i32) => i32
  return g(4)
}
print("\{f(mf(2)) ?? 0} \{f(null) ?? -1}")
// @@CELL_closure_capturing_cell@@
// want: 15 -1
function f(k: i32, base: i32): i32 | null {
  const h: ((i32) => i32) | null = if k > 0 { (n: i32) => n + base } else { null }
  const g = h as (i32) => i32
  return g(5)
}
print("\{f(1, 10) ?? 0} \{f(0, 10) ?? -1}")
// @@CELL_closure_coalescing@@
// want: true false
function f(k: i32): boolean {
  const g = mf(k) as? (i32) => i32
  return g != null
}
print("\{f(3)} \{f(0)}")
// @@CELL_closure_trap@@
// want: 9
const g = mf(3) as! (i32) => i32
print(g(3))
