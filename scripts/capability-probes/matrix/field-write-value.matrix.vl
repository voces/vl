// D16015 — a field write through a receiver the emitter cannot re-read (a call), used as a value:
// the assignment yields the stored value at every delivery position, and the record holds it.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type FwQ = { x: i32 }
const fwq: FwQ = { x: 1 }
let fwCalls = 0
function fwGet(): FwQ {
  fwCalls = fwCalls + 1
  return fwq
}
// @@VALUE@@
(fwGet().x = 5)
// @@TYPE@@
i32
// @@PROOF@@
print(v * 10 + fwq.x)
// @@WANT@@
55
// @@SKIP@@
is_in_if: the value is an i32, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
// @@CELL_receiver_once@@
// want: 551
const v__A__ = (fwGet().x = 5)
print(v * 100 + fwq.x * 10 + fwCalls)
