// D2633 — a `v128 | null` boxes its vector as a value-union atom, so every delivery position
// holds it: the proof reads a lane back, which a box of the wrong arm cannot survive.
// The all-null twin is `v128-nullable-all-null.matrix.vl`.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function vec(n: i32): v128 | null {
  if n < 0 { return null }
  __splat_i32x4__(n)
}
// @@VALUE@@
vec(7)
// @@TYPE@@
v128 | null
// @@TEST@@
v != null
// @@HIT@@
print(__extract_lane_i32x4__(v, 2))
// @@MISS@@
print("none")
// @@WANT@@
7
// @@VALUE2@@
vec(4)
// @@TYPE2@@
v128 | null
// @@PROOF2@@
print(__extract_lane_i32x4__(v ?? __splat_i32x4__(0), 1))
// @@WANT2@@
4
