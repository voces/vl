// D10140: a value typed as a union of two map types, read through `.get`, `.has`, `.length` and
// `.keys()` at every delivery position. Each reads member by member, as the index does.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type __P = { x: i32 }
function __mk(): {[string]: f64} | {[string]: __P} {
  const s: {[string]: __P} = Map()
  s["k"] = { x: 4 }
  s["j"] = { x: 5 }
  s
}
function __x(r: f64 | __P | null): i32 {
  if r is __P { return r.x }
  if r is null { return 100 }
  -1
}
// @@VALUE@@
__mk()
// @@TYPE@@
{[string]: f64} | {[string]: __P}
// @@TEST@@
v.has("j") && !v.has("zz")
// @@HIT@@
print(__x(v.get("k")) + __x(v.get("zz")) + v.length + v.keys().length)
// @@MISS@@
print("wrong")
