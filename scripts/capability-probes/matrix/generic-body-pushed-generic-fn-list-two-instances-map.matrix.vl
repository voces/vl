// An un-annotated list a generic body pushes a generic function onto, returned, delivered at
// every position from the instance at `i32` and read back by a `.map` callback calling it at `i32`, while the
// instance at `string` is read the same way at `string` (D17729). The proof prints the
// `string` read only when the `i32` read was right.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __id<T>(x: T): T { return x }
function __run<T>(_x: T) {
  const rs = []
  rs.push(__id)
  return rs
}
// @@VALUE@@
__run(3)
// @@TYPE@@
((x: i32) => i32)[]
// @@PROOF@@
if v.map((f) => f(3))[0] == 3 {
  print(__run("ab").map((f) => f("ab"))[0])
} else {
  print("wrong i32 read")
}
// @@WANT@@
ab
