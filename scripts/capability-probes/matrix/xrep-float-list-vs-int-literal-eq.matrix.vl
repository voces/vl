// D15091: an `f64[]` compared with an integer list literal. The literal fits the `f64[]`, so it
// is delivered at it and the compare is one storage; the second instance compares unequal.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function xlF(a: f64, b: f64): f64[] { [a, b] }
// @@VALUE@@
xlF(1.0, 2.0)
// @@TYPE@@
f64[]
// @@TEST@@
v == [1, 2] && v != [1, 3] && [1, 2] == v
// @@HIT@@
print("value")
// @@MISS@@
print("storage")
// @@WANT@@
value
// @@VALUE2@@
xlF(1.0, 2.5)
// @@TYPE2@@
f64[]
// @@PROOF2@@
print("\{v == [1, 2]} \{v != [1, 2]}")
// @@WANT2@@
false true
