// D2781's generic twin: the value is handed through a generic identity whose type parameter only
// the literal fixes, so the stamp is graded at an instance as well as at a concrete type.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function idn<T>(v: T): T { v }
// @@VALUE@@
idn({ a: 7 })
// @@TYPE@@
{ a: string | i32 } | string
// @@WANT@@
7
// @@TEST@@
v is { a: i32 | string }
// @@HIT@@
print(v.a)
// @@MISS@@
print(0)
