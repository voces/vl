// A union of two records sharing a field, one storing a record there and the other `null`: the
// shared read is the record or `null` (D15717). The value is a join of two record literals, so
// the checker types it as the union, not as one record with a nullable field.
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
const go = [1].length > 0
function mk(b: boolean) { if b { { j: { a: 1 } } } else { { j: null } } }
// @@VALUE@@
mk(go)
// @@TYPE@@
{ j: { a: i32 } } | { j: null }
// @@PROOF@@
print(v.j?.a ?? 0)
// @@WANT@@
1
// @@VALUE2@@
mk(!go)
// @@PROOF2@@
print(v.j?.a ?? 5)
// @@WANT2@@
5
// @@SKIP@@
is_in_if: the shared read is the capability, not a discrimination
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
// @@CELL_join_binding@@
const v__A__ = if go { { j: { a: 1 } } } else { { j: null } }
print(v.j?.a ?? 0)
// @@CELL_field_bound@@
const v__A__ = mk(go)
const q = v.j
if q != null { print(q.a) }
// @@CELL_list_of_union@@
// want: 10
const xs__LA__ = [mk(go), mk(!go)]
print((xs[0].j?.a ?? 0) * 10 + (xs[1].j?.a ?? 0))
// @@CELL_read_in_fn@@
function rd(v__A__) { v.j?.a ?? 0 }
print(rd(mk(go)))
