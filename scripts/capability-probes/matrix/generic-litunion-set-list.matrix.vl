// D7041: a generic's `(T | L)[]` result with `T` bound by inference at a second string literal
// union. The instance's element is one flat literal set, the type the annotation spells, so it
// is delivered without a conversion. No call writes the type argument.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type K = "a" | "b"
type L = "x" | "y"
function l<T>(x: T, o: L): (T | L)[] { return [x, o] }
const a: K = "a"
// @@VALUE@@
l(a, "y")
// @@TYPE@@
(K | L)[]
// @@WANT@@
y
// @@TEST@@
v.length == 2
// @@HIT@@
print(v[1])
// @@MISS@@
print("none")
