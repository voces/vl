// The open twin of generic-list-union-narrowed-joined-literal: the value is a generic's own
// `V[] | i32` result, so the list's element type is bound by inference at the maker's call.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function wrap<V>(x: V): V[] | i32 { [x, x] }
function len<T>(t: T[] | i32) {
  if t is i32 { t } else { 5 }
}
// @@VALUE@@
wrap("q")
// @@TYPE@@
string[] | i32
// @@PROOF@@
const r: i32 = len(v)
print(r)
// @@WANT@@
5
// @@VALUE2@@
wrap(1.5)
// @@TYPE2@@
f64[] | i32
// @@PROOF2@@
const r: i32 = len(v)
print(r)
// @@WANT2@@
5
