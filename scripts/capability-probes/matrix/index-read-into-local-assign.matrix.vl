// D1500 — a bare INDEX read over a scalar array (`xs[0]` where `xs: i32[]`), delivered at
// every position. `exprEmittedRefListSlot`'s `Index` arm consumed `refListSlotOfExpr`, which
// CLAMPS a miss to row 0 — and a module that interns no ref list has an EMPTY `rlElemName`,
// so slot 0 is an out-of-bounds read and the COMPILER traps on a `vl check`-clean program.
//
// THE `local_assign` POSITION IS WHY THIS TEMPLATE EXISTS. `emitAssign`'s `local.set` arm is
// the only caller of that classifier pair on this path; the `global.set` arm returns before
// it. The matrix had `global_assign` (D965's) and no local sibling, so twenty-six positions
// graded this value green while the plainest reassignment in the language crashed the
// compiler. The prelude's array is a GLOBAL only so every position can reach it.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
const __xs: i32[] = [5]
// @@VALUE@@
__xs[0]
// @@TYPE@@
i32
// @@PROOF@@
print(v)
// @@TEST@@
v > 3
// @@HIT@@
print(5)
// @@MISS@@
print(0)
// @@WANT@@
5
