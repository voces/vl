// A5 / D1814 — an optional call whose RETURN is a struct, so the guard's two arms join on a
// nullable struct ref rather than on the scalar box. The result type is what the callee
// returns behind one `| null`, whatever rep that is.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type L = { s: string }
type P = { n: i32 }
function label(self: P): L { { s: "ok" } }
function mkP(c: boolean): P | null {
  if c { return { n: 21 } }
  return null
}
const p = mkP(true)
// @@VALUE@@
p?.label()
// @@TYPE@@
L | null
// @@FALLBACK@@
null
// @@PROOF@@
print(v?.s ?? "none")
// @@WANT@@
ok
