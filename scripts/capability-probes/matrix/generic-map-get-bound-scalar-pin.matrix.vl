// D10292: a generic's un-annotated `const x = m.get(k)`, returned, at the scalar pin `V = i32`.
// A miss is the binding's `null`, which the read's unboxed `i32` has no spare value for, so the
// binding takes the box its annotated twin `const x: V | null` does.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __bg<V>(m: Map<string, V>, k: string): V | null {
  const x = m.get(k)
  x
}
const __bgM: Map<string, i32> = Map()
__bgM.set("k", 5)
// @@VALUE@@
__bg(__bgM, "z")
// @@TYPE@@
i32 | null
// @@TEST@@
v == null
// @@HIT@@
print(__bg(__bgM, "k") ?? 0)
// @@MISS@@
print("wrong")
// @@WANT@@
5
// @@VALUE2@@
__bg(__bgM, "k")
// @@TYPE2@@
i32 | null
// @@PROOF2@@
print(v ?? 0)
// @@WANT2@@
5
