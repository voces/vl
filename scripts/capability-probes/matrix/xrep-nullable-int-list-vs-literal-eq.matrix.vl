// D15091: an `(i32 | null)[]` compared with list literals. `[1, 2]` and `[1, null]` fit it and
// are built at it; `[1.0, 2.0]` and `[1.0, null]` do not and compare across storage, by value.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function xlN(b: i32 | null): (i32 | null)[] { [1, b] }
// @@VALUE@@
xlN(2)
// @@TYPE@@
(i32 | null)[]
// @@TEST@@
v == [1, 2] && v == [1.0, 2.0] && v != [1, 3] && [1, 2] == v
// @@HIT@@
print("value")
// @@MISS@@
print("storage")
// @@WANT@@
value
// @@VALUE2@@
xlN(null)
// @@TYPE2@@
(i32 | null)[]
// @@PROOF2@@
print("\{v == [1, null]} \{v == [1.0, null]} \{v == [1, 2]} \{v != [1, null]}")
// @@WANT2@@
true true false false
