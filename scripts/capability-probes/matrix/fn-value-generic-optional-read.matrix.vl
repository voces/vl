// A generic function held in a record field, delivered where the record may be null and read
// back through `?.`, then called at one type. The flow table fixes the field's instance from
// that call, at every delivery position of the record.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function id<T>(x: T): T { x }
function twice<T>(x: T): T { x }
// @@VALUE@@
{ f: id }
// @@TYPE@@
{ f: (x: i32) => i32 } | null
// @@PROOF@@
print(v?.f(2) ?? 0)
// @@WANT@@
2
// @@TEST@@
v != null
// @@HIT@@
print(v?.f(2) ?? 0)
// @@MISS@@
print(0)
// @@VALUE2@@
{ f: twice }
// @@TYPE2@@
{ f: (x: i32) => i32 } | null
// @@PROOF2@@
print(v?.f(7) ?? 0)
// @@WANT2@@
7
