// D1688 — an anonymous struct whose field holds a UNION-BOX element list, produced by a call.
//
// The template must NOT declare a `type` for the OUTER shape: a declaration nothing spells is
// the rescue D1688 records, and it would turn every un-annotated cell green for the wrong
// reason. `Shape` IS declared, because the element being a declared union is not the
// ingredient — an inline member set refuses identically — and the call needs a return
// annotation to write.
//
// The PROOF reads THROUGH the element and discriminates it (`v.xs[0] is Circle`), so a field
// whose element heap type came from the wrong wrapper traps or prints 0 rather than passing.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function shapes(): Shape[] { return [{ r: 7 }] }
function shapes2(): Shape[] { return [{ r: 9 }] }
// @@VALUE@@
{ xs: shapes() }
// @@TYPE@@
{ xs: Shape[] }
// @@PROOF@@
const e = v.xs[0]
if e is Circle { print(e.r) } else { print(0) }
// @@WANT@@
7
// @@VALUE2@@
{ xs: shapes2() }
// @@TYPE2@@
{ xs: Shape[] }
// @@PROOF2@@
const e2 = v.xs[0]
if e2 is Circle { print(e2.r) } else { print(0) }
// @@WANT2@@
9
// @@SKIP@@
is_in_if: the value is a struct, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
