// A generic function returned by an un-annotated function, delivered to each position, bound to
// two `let`s, one written with the other, copied into a `const` and handed to a generic at TWO
// types. No function type spells that, so the annotated face refuses by design (D10380).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function id<T>(x: T): T { x }
function run<U>(f: (x: U) => U, u: U): U { f(u) }
function mk() { id }
// @@VALUE@@
mk()
// @@TYPE@@
(x: i32) => i32
// @@PROOF@@
let __wa = v
let __wb = v
__wb = __wa
const __wc = __wb
print(run(__wc, 2) + run(__wc, "ab").length)
// @@WANT@@
4
