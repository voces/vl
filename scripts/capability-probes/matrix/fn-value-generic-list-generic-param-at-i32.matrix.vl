// A list of a generic pushed a fixed-type `i32` function, delivered to each position and handed
// to a generic function whose other argument binds its type parameter to `i32`: every element
// fits, so every position runs. The twin of
// `fn-value-generic-list-generic-param-at-string-refused.matrix.vl`, which must refuse (D10150).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function id<T>(x: T): T { x }
function __inc(x: i32): i32 { x + 1 }
const __ys = [id]
__ys.push(__inc)
function __run<U>(a: ((x: U) => U)[], u: U): U { a[1](u) }
// @@VALUE@@
__ys
// @@TYPE@@
((x: i32) => i32)[]
// @@PROOF@@
print(__run(v, 2))
// @@WANT@@
3
