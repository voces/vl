// A shared field read through an un-narrowed union of records (D16048), where the field is
// a string literal set beside `null` in one member, `i32 | null` in the other. The union is spelled `R | S`, each field naming `null` first. The first
// instance reads `R`'s value, the second `S`'s `null`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type K = "a" | "b"
type R = { x: null | K, s: string }
type S = { x: null | i32, s: string, extra: i32 }
const r1: R = { x: "b", s: "r" }
const s1: S = { x: null, s: "s", extra: 3 }
const u1: R | S = r1
const u2: R | S = s1
// @@VALUE@@
u1.x
// @@TYPE@@
K | i32 | null
// @@WANT@@
b
// @@TEST@@
v == null
// @@HIT@@
print("null")
// @@MISS@@
print(v)
// @@VALUE2@@
u2.x
// @@TYPE2@@
K | i32 | null
// @@PROOF2@@
if v == null { print("null") } else { print("value") }
// @@WANT2@@
null
// @@CELL_param_receiver@@
// want: b
function rd(u: R | S) {
  const y __A__ = u.x
  if y == null { print("null") } else { print(y) }
}
rd(r1)
// @@CELL_param_receiver_null@@
// want: null
function rd(u: R | S) {
  const y __A__ = u.x
  if y == null { print("null") } else { print("value") }
}
rd(s1)
