// D16957: a record literal whose field holds a read of a container built at a wider record is
// stored by a list push, so its container is built with that field's build; an optional chain of the stored record
// reads the build, at every delivery position.

// @@PRELUDE@@
type J = { f: i32 | null }

// @@SETUP@@
const m = Map()
m.set("a", { f: 4 })
const wm: {[string]: J} = m
const d = { f: 1 }
const w3 = [{ x: d }]
w3.push({ x: m.get("a") ?? d })

// @@VALUE@@
w3[1]?.x.f ?? 0

// @@TYPE@@
i32

// @@PROOF@@
print(v)

// @@WANT@@
4
