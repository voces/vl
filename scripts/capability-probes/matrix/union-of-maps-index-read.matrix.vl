// D10140: a value typed as a union of two map types, read by index at every delivery position.
// The read is the union of the members' values or null; the miss reads null.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
import { toString } from "std:fmt"
function __mk(): {[string]: string} | {[string]: i32} {
  const s: {[string]: i32} = Map()
  s["k"] = 7
  s
}
function __show(r: string | i32 | null): string {
  if r is null { return "null" }
  if r is i32 { return "i" + toString(r) }
  "s" + r
}
// @@VALUE@@
__mk()
// @@TYPE@@
{[string]: string} | {[string]: i32}
// @@TEST@@
__show(v["k"]) == "i7"
// @@HIT@@
print(__show(v["k"]) + __show(v["zz"]))
// @@MISS@@
print("wrong")
// @@WANT@@
i7null
