// A spread whose source is a `u8[]` — the PACKED byte list, the one rep with no `arrLitIs*`
// of its own, because no element spells `u8`.
//
// Every classifier that reads a literal's elements is blind to it, so each has to ask the
// spread's SOURCE instead; D1850 is the module-global cell ladder that did not. This template
// exists because the other two spread matrices grade `i32` and a type parameter, and neither
// can reach a rep whose element type is shared with the list it must not be built as.
//
// Its skips are now only the six a list value cannot answer; the `map_value` pair (D1853) and
// the `struct_field_init` cell (D1854) are both closed. A cell's label is a position, and the
// mechanism is whatever the neighbouring spelling says.
//
// The proof reads an ELEMENT back rather than a length: a length agrees between the packed
// and the i32 backing, so it cannot tell them apart, and `u8` widens to nothing — it is a
// storage type, so arithmetic on an element is refused and only the read itself is portable.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function collect(...xs: u8[]): u8[] { return xs }
const bs: u8[] = [4, 5, 6]
const cs: u8[] = [7, 8]
// @@VALUE@@
collect(3, ...bs)
// @@TYPE@@
u8[]
// @@PROOF@@
print(v[3])
// @@WANT@@
6
// @@VALUE2@@
collect(...cs)
// @@TYPE2@@
u8[]
// @@PROOF2@@
print(v[1])
// @@WANT2@@
8
// @@SKIP@@
is_in_if: the value is a list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
