// D2196's nullable face — an `i32[]` delivered where a `readonly f64[] | null` is declared takes
// the readonly converting copy (D965/D791) under the `| null`. The proof divides an element, so a
// list left at `i32` prints `3` where the copied `f64` list prints `3.5`; the un-annotated face
// keeps its own `i32[]`. Own cells copy records into a readonly union list under `| null`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
// @@SETUP@@
const ints: i32[] = [7, 9]
// @@VALUE@@
ints
// @@TYPE@@
readonly f64[] | null
// @@TEST@@
v != null
// @@HIT@@
if v != null { print(v[0] / 2) }
// @@MISS@@
print("none")
// @@WANT@@
3.5
// @@WANT_UNANNOTATED@@
3
// @@SKIP@@
return_inferred: a held list handed back through an inferred return is refused into `readonly f64[]` without the `| null` too (D2161's written-list rule), not by this copy
// @@CELL_records_into_union@@
// want: 1 then 7
const cs: Circle[] = [{ r: 7 }]
const w: readonly Shape[] | null = cs
if w != null {
  print(w.length)
  const c = w[0]
  if c is Circle { print(c.r) }
}
// @@CELL_param_and_null@@
// want: 4.5 then none
const ints: i32[] = [7, 9]
function f(x: readonly f64[] | null) {
  if x != null { print(x[1] / 2) } else { print("none") }
}
f(ints)
f(null)
// @@CELL_return@@
// want: 1.5
function g(): readonly f64[] | null {
  const a: i32[] = [3]
  return a
}
const r = g()
if r != null { print(r[0] / 2) }
