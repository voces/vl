// The generic twin of fn-record-field-list-written: the field's functions name their own open
// parameter `T`, bound where the element is called (D15138, D15160).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __id<T>(x: T): T { return x }
function __half<T>(x: T): f64 { return x / 2.0 }
// @@SETUP@@
const __rec = { fs: [__id] }
__rec.fs[0] = __half
// @@VALUE@@
__rec
// @@TYPE@@
{ fs: readonly ((x: i32) => i32 | f64)[] }
// @@PROOF@@
print(v.fs[0](3))
// @@WANT@@
1.5
