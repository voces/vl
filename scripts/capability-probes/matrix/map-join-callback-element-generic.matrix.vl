// D3125's generic face: a `.map` callback whose returns join at the instance's pin, read back
// as an element and delivered to every position. The join is `T | null` at `T := i32`, the
// shape whose `return null` needed the pin's join to build at all.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function first<T>(x: T) {
  const m = [x].map((e) => {
    if e != null { return e }
    return null
  })
  return m[0]
}
// @@VALUE@@
first(4)
// @@TYPE@@
i32 | null
// @@TEST@@
v != null
// @@HIT@@
print(v)
// @@MISS@@
print("null")
// @@WANT@@
4
// @@VALUE2@@
first("s")
// @@TYPE2@@
string | null
// @@PROOF2@@
print(v)
// @@WANT2@@
s
