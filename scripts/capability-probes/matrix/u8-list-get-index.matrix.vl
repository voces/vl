// D1281 — the bare `.get(i)` over a list. The checker types it `T | null`, the same type
// `.pop()` gets, and before the close it lowered at ONE rep (the struct-element ref list);
// every other rep fell out of `emitCallNode`'s member ladder into `emitCall`.
//
// THE VALUE IS THE `u8[]` FACE, because that is the probe's own spelling and the packed
// backing is the rep whose element VALUE kind (i32) does not identify it. The REP axis is
// graded separately — ten reps × two scopes × in/out-of-bounds — since the axis this
// template varies is the POSITION.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
const bs: u8[] = [200, 255]
// @@VALUE@@
bs.get(0)
// @@TYPE@@
i32 | null
// @@TEST@@
v != null
// @@HIT@@
print(v)
// @@MISS@@
print(0)
// @@WANT@@
200
