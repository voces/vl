// A generic body's call-argument demand (`g(self)` with `g(n: i32)`) is owed at every spelling
// that instantiates the body at `string` (D2425). Each cell must refuse; a cell that builds is
// clause 1.
// @@PRELUDE@@
function g(n: i32) { return n + 1 }
function inc<T>(self: T) { return g(self) }
// @@VALUE@@
inc(3)
// @@TYPE@@
i32
// @@PROOF@@
print(v)
// @@WANT@@
4
// @@CELL_direct@@
// owed: flows into `g`
print(inc("s"))
// @@CELL_method@@
// owed: flows into `g`
print("s".inc())
// @@CELL_hole@@
// owed: flows into `g`
function H(h, v) { return h(v) }
print(H(inc, "s"))
// @@CELL_hof@@
// owed: flows into `g`
function run<T>(cb: (T) => i32, v: T) { return cb(v) }
print(run(inc, "s"))
// @@CELL_nested_generic@@
// owed: flows into `g`
function outer<U>(u: U) { return inc(u) }
print(outer("s"))
// @@CELL_nested_generic_method@@
// owed: flows into `g`
function outer<U>(u: U) { return u.inc() }
print(outer("s"))
// @@CELL_loop@@
// owed: flows into `g`
for s in ["a", "b"] { print(s.inc()) }
// @@CELL_fn_alias@@
// owed: flows into `g`
const f = inc
print(f("s"))
// @@CELL_control@@
// want: 2
print("s".length.inc())
