// Reference identity on a record with a function field (D15975): `==` gives such a record no
// value compare (DECISIONS A15), and `===` must not inherit that; it is one `ref.eq`, so a twin
// holding the same function is a different record.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function inc(i: i32) { return i + 1 }
type R = { n: i32, f: (i: i32) => i32 }
const src: R = { n: 1, f: inc }
function mkTwin(): R { return { n: 1, f: inc } }
// @@VALUE@@
src
// @@TYPE@@
R
// @@TEST@@
v === src
// @@HIT@@
print("same")
// @@MISS@@
print("other")
// @@WANT@@
same
// @@VALUE2@@
mkTwin()
// @@TYPE2@@
R
// @@PROOF2@@
if v === src { print("same") } else { print("other") }
// @@WANT2@@
other
