// D2597 — the value is a `let x = null` whose hole a later write FILLED with a `i32[]` through a `i32[] | null` write that holds null. The
// checker fills the hole in place, so the binding is `i32[] | null`; the emitter must give it the
// cell its annotated twin has, not the value box a name-scan guessed or the `null` type's
// `nullref`.
//
// THE SETUP DECLARES IT IN THE DELIVERY'S OWN SCOPE, so each position exercises the storage
// class it has there: a function local, a start-fn local, a module global.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type C = { a: i32 }
function __mk(b: boolean): i32[] | null {
  if b { return null }
  return [7]
}
// @@SETUP@@
let __h = null
__h = __mk(true)
// @@VALUE@@
__h
// @@TYPE@@
i32[] | null
// @@TEST@@
v != null
// @@HIT@@
print(v[0])
// @@MISS@@
print("none")
// @@WANT@@
none
// @@SKIP@@
map_value: a map whose VALUE is `null` cannot be told from a missing key
