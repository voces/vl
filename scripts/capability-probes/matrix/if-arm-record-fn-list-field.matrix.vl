// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __incL(a) { return a + 1 }
const __cL = 1 > 0
// @@VALUE@@
if __cL { { fs: [__incL] } } else { { fs: [__incL] } }
