// D16102 — a field written from a right-hand side that rebinds the receiver: the store goes into
// the object read first, and a later read of the field through the rebound name is not narrowed
// to the value written. The value is that later read; the proof also reads the first object.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type RbA = { x: i32 }
type RbH = { p: RbA | null }
let rbh: RbH = { p: null }
const rbKeep = rbh
function rbSwap(): RbA { rbh = { p: null }; return { x: 9 } }
rbh.p = rbSwap()
// @@VALUE@@
(rbh.p?.x ?? 0)
// @@TYPE@@
i32
// @@PROOF@@
print(v + (rbKeep.p?.x ?? 0) * 10)
// @@WANT@@
90
// @@SKIP@@
is_in_if: the value is an i32, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
// @@CELL_closure_rebind@@
// want: 80
let rcH: RbH = { p: null }
const rcKeep = rcH
const rcSwap = (): RbA => { rcH = { p: null }; return { x: 8 } }
rcH.p = rcSwap()
print((rcH.p?.x ?? 0) + (rcKeep.p?.x ?? 0) * 10)
// @@CELL_through_parameter@@
// want: 70
type RpBox = { h: RbH }
const rpBox: RpBox = { h: { p: null } }
const rpKeep = rpBox.h
function rpSwap(b: RpBox): RbA { b.h = { p: null }; return { x: 7 } }
rpBox.h.p = rpSwap(rpBox)
print((rpBox.h.p?.x ?? 0) + (rpKeep.p?.x ?? 0) * 10)
// @@CELL_nested_field@@
// want: 60
type RnOuter = { q: RbH }
const rnO: RnOuter = { q: { p: null } }
const rnKeep = rnO.q
function rnSwap(): RbA { rnO.q = { p: null }; return { x: 6 } }
rnO.q.p = rnSwap()
print((rnO.q.p?.x ?? 0) + (rnKeep.p?.x ?? 0) * 10)
// @@CELL_element_receiver@@
// want: 50
const reHs: RbH[] = [{ p: null }]
const reKeep = reHs[0]
function reSwap(): RbA { reHs[0] = { p: null }; return { x: 5 } }
reHs[0].p = reSwap()
print((reHs[0].p?.x ?? 0) + (reKeep.p?.x ?? 0) * 10)
// @@CELL_no_rebind_keeps_narrowing@@
// want: 4
const rkH: RbH = { p: null }
function rkMk(): RbA { return { x: 4 } }
rkH.p = rkMk()
print(rkH.p.x)
