// A `let` bound to a call of a function returning one of two generic functions, called at two
// types, written with another such call, then delivered to each position and called there at TWO
// types. No function type spells that, so the annotated face refuses by design; the un-annotated
// face selects each type's instance of the function the latest call returned (D10192).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function idg<T>(t: T): T { return t }
function kg<T>(t: T): T { return t + t }
function pick(n: i32) {
  if n > 1 { return kg }
  return idg
}
let h = pick([1, 2].length)
const s0 = h("x")
const i0 = h(3)
h = pick([1].length)
// @@VALUE@@
h
// @@TYPE@@
(x: i32) => i32
// @@PROOF@@
print(v("ab").length * 100 + v(7) * 10 + s0.length + i0)
// @@WANT@@
278
