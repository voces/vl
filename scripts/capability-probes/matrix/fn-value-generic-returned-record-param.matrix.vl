// D9381: a generic over a record parameter, returned from an un-annotated function and delivered
// at a function type naming the record by its declared name. The flow spells that parameter by
// the name, and the instance reads the type parameter out of the declaration's shape.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type K = "x" | "y"
type R = { k: K }
type In = { k: i32 }
type N = { inner: In }
function pick<T>(r: { k: T }): T { r.k }
function deep<T>(r: { inner: { k: T } }): T { r.inner.k }
function deliver() { return pick }
function deliver2() { return deep }
// @@VALUE@@
deliver()
// @@TYPE@@
(r: R) => K
// @@PROOF@@
print(v({ k: "y" }) + "!")
// @@WANT@@
y!
// @@VALUE2@@
deliver2()
// @@TYPE2@@
(r: N) => i32
// @@PROOF2@@
print(v({ inner: { k: 9 } }) + 1)
// @@WANT2@@
10
// @@SKIP@@
is_in_if: the value is a function, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
