// D1689 — a SECOND anonymous holder whose ref-list field shares the first holder's field NAME
// while naming a different element.
//
// The first holder lives in the PRELUDE, inside a function nothing calls: `collectAnonShapes`
// walks the whole arena, so its row is minted and available to collide with wherever the value
// under test is delivered. Removing it turns every cell green for the wrong reason.
//
// The two faces measure two different rows, and only the un-annotated one is D1689. The
// prelude holder is un-annotated, so the value's own un-annotated face meets an `#anon` row —
// the collapse this template is for. Its ANNOTATED face gives the value a declared row and
// the prelude holder then collides onto THAT, which is D1674 and red at both seeds — every
// cell this template leaves red is that row.
//
// The value under test is a plain ref list rather than the `| null` niche on purpose: a
// code-28 holder standing beside this prelude's code-5 one refuses for a different reason
// (D1663), which would redden the un-annotated column for a row this template is not for.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type A = { r: i32 }
type B = { q: i32, tag: string }
function as1(): A[] { return [{ r: 7 }] }
function bs1(): B[] { return [{ q: 4, tag: "a" }] }
function bs2(): B[] { return [{ q: 5, tag: "b" }] }
function firstHolder() {
  const first = { xs: as1() }
  print(first.xs[0].r)
}
// @@VALUE@@
{ xs: bs1() }
// @@TYPE@@
{ xs: B[] }
// @@PROOF@@
print(v.xs[0].q)
// @@WANT@@
4
// @@VALUE2@@
{ xs: bs2() }
// @@TYPE2@@
{ xs: B[] }
// @@PROOF2@@
print(v.xs[0].q)
// @@WANT2@@
5
// @@SKIP@@
is_in_if: the value is a struct, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
