// D16948/D16911: a list literal of records whose elements differ in a nested record field, so the
// checker's join of the elements holds a union of records no annotation spells
// (`{z: {f: i32} | {f: {a: boolean}}}`). Its union row is registered from the literal's own type;
// the prelude must not spell that union, or it registers the row itself.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
const k = 0
// @@VALUE@@
[{ z: { f: 5 } }, { z: { f: { a: true } } }]
// @@TYPE@@
{z: {f: i32} | {f: {a: boolean}}}[]
// @@PROOF@@
print(v.length + k)
// @@WANT@@
2
// @@TEST@@
v.length == 2
// @@HIT@@
print(v.length)
// @@MISS@@
print(0)
// @@CELL_bare_length@@
// want: 2
const v = [{ z: { f: 5 } }, { z: { f: { a: true } } }]
print(v.length)
// @@CELL_record_order_swapped@@
// want: 2
const v = [{ z: { f: { a: true } } }, { z: { f: 5 } }]
print(v.length)
// @@CELL_two_record_arms@@
// want: 2
const v = [{ z: { f: { a: 1 } } }, { z: { f: { b: 2 } } }]
print(v.length)
// @@CELL_three_elements@@
// want: 3
const v = [{ z: { f: 5 } }, { z: { f: { a: true } } }, { z: { f: 6 } }]
print(v.length)
// @@CELL_sibling_field@@
// want: 3
const v = [{ z: { f: 5, g: 1 } }, { z: { f: { a: true }, g: 2 } }]
print(v.length + v[1].z.g - 1)
// @@CELL_one_level_wide_scalar@@
// want: 2
const v = [{ f: { a: 5 as i64 } }, { f: { a: { a: true } } }]
print(v.length)
// @@CELL_three_levels@@
// want: 2
const v = [{ y: { z: { f: 5 } } }, { y: { z: { f: { a: true } } } }]
print(v.length)
// @@CELL_annotated_d16911@@
// want: 2
const v: {z: {f: {a: {a: boolean} | i64}}}[] = [{ z: { f: { a: 5 as i64 } } }, { z: { f: { a: { a: true } } } }]
print(v.length)
// @@CELL_narrowed_in_loop@@
// want: 5 then true
const v = [{ z: { f: 5 } }, { z: { f: { a: true } } }]
for e in v {
  const z = e.z
  if z is {f: i32} { print(z.f) } else { print(z.f.a) }
}
// @@CELL_shared_field_read@@
// want: 5
const v = [{ z: { f: 5 } }, { z: { f: { a: true } } }]
const r = v[0].z.f
if r is i32 { print(r) } else { print(r.a) }
