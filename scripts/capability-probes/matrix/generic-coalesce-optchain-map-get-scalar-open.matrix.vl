// D10130's open twin: the generic's `k?.get("a") ?? d` is pinned at a value type the call infers
// from an un-annotated function's hole result, and the nullable map is joined by inference.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __og<V>(k: {[string]: V} | null, d: V): V { k?.get("a") ?? d }
function __pick(p, c: boolean) {
  const m: {[string]: f64} = Map()
  m["a"] = p
  if c { m } else { null }
}
// @@VALUE@@
__pick(1.5, true)
// @@TYPE@@
{[string]: f64} | null
// @@TEST@@
__og(v, 0.25) == 1.5
// @@HIT@@
print(__og(v, 0.25) + __og(null, 2.0))
// @@MISS@@
print("wrong")
// @@WANT@@
3.5
