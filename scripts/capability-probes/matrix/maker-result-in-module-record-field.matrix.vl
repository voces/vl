// D6342/D6340: a module record field holding a maker's generic result, a lambda maker beside it,
// each called at two types. The value is a call at one of them; the prelude calls the field at
// the other, so every position reads a field whose generic is fixed by more than one call.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __k<T>(x: T): T {
  return x
}
function __mk() {
  return __k
}
const __r = { f: __mk() }
const __s = __r.f("s")
const __mkl = () => __k
const __al = __mkl()
const __t = __al("t")
// @@VALUE@@
__r.f(41)
// @@TYPE@@
i32
// @@PROOF@@
print(v)
// @@WANT@@
41
// @@TEST@@
v == 41
// @@HIT@@
print(v)
// @@MISS@@
print(0)
// @@VALUE2@@
__al(7)
// @@TYPE2@@
i32
// @@PROOF2@@
print(v)
// @@WANT2@@
7
