// D2519 — two mono maps whose keys differ in rep, one union.
// The proof reads, writes, deletes, counts and walks the map after narrowing, so a box that
// casts to the wrong map struct fails validation or prints wrong.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function mka(): {[i32]: i32} {
  const m: {[i32]: i32} = Map()
  m.set(1, 10)
  m.set(2, 20)
  m
}
function mkb(): {[string]: i32} {
  const m: {[string]: i32} = Map()
  m.set("k1", 10)
  m.set("k2", 20)
  m
}
function pick(n: i32): {[i32]: i32} | {[string]: i32} {
  if n > 0 { return mka() }
  return mkb()
}
// @@VALUE@@
pick(1)
// @@TYPE@@
{[i32]: i32} | {[string]: i32}
// @@TEST@@
v is {[i32]: i32}
// @@HIT@@
print(v.length)
print(v.has(1))
print((v.get(1) ?? -1))
v.set(3, 30)
print(v.length)
v.delete(2)
print(v.has(2))
let c = 0
for kk in v { c = c + 1 }
print(c)
print((v[3] ?? -1))
// @@MISS@@
print("miss")
// @@WANT@@
2 then true then 10 then 3 then false then 2 then 30
// @@VALUE2@@
pick(0)
// @@TYPE2@@
{[i32]: i32} | {[string]: i32}
// @@PROOF2@@
if v is {[string]: i32} {
  print(v.length)
  print(v.has("k1"))
  print((v.get("k1") ?? -1))
  v.set("k3", 30)
  print(v.length)
  v.delete("k2")
  print(v.has("k2"))
  let c = 0
  for kk in v { c = c + 1 }
  print(c)
  print((v["k3"] ?? -1))
} else { print("wrong") }
// @@WANT2@@
2 then true then 10 then 3 then false then 2 then 30
