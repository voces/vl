// D15098 — a plain struct holding a union arm whose map field's value is a declared record. The
// arm's twin row is minted from a render that spells the record by its shape, while the arm's
// own row spells it by name, so the two rows key different map slots and the holder refuses
// loudly. Graded to hold that refusal LOUD at every position until the render is fixed.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type R = { r: i32 }
type A = { n: i32, g: Map<string, R> }
type P = { m: i32 }
type U = A | P
type Q = { o: A }
function mkQ(n: i32): Q {
  const g: Map<string, R> = Map()
  g.set("x", { r: n })
  return { o: { n: 0, g: g } }
}
// @@VALUE@@
mkQ(7)
// @@TYPE@@
Q
// @@FALLBACK@@
mkQ(3)
// @@TEST@@
(v.o.g.get("x")?.r ?? 0) == 7
// @@HIT@@
print(7)
// @@MISS@@
print(9)
// @@WANT@@
7
