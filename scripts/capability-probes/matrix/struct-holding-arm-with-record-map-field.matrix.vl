// D15098 — a plain struct holding a union arm whose map field's value is a declared record. The
// arm's twin row is decided from the record-row class, and a map `.get` through an un-annotated
// parameter is the index read (D15153), so the holder runs at every position.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type R = { r: i32 }
type A = { n: i32, g: Map<string, R> }
type P = { m: i32 }
type U = A | P
type Q = { o: A }
function mkQ(n: i32): Q {
  const g: Map<string, R> = Map()
  g.set("x", { r: n })
  return { o: { n: 0, g: g } }
}
// @@VALUE@@
mkQ(7)
// @@TYPE@@
Q
// @@FALLBACK@@
mkQ(3)
// @@TEST@@
(v.o.g.get("x")?.r ?? 0) == 7
// @@HIT@@
print(7)
// @@MISS@@
print(9)
// @@WANT@@
7
