// D16473 — a value join of literals cast to `f64` takes the cast's context (ruling 4.3), so a
// radix arm is the value its digits spell, 4294967295, not the pattern -1, in every position
// the cast's result is delivered to. VALUE2 is the `match` face.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function flag(): boolean { return 1 == 2 }
function pick(): i32 { return 2 }
// @@VALUE@@
(if flag() { 2147483647 } else { 0xFFFFFFFF }) as f64
// @@TYPE@@
f64
// @@PROOF@@
print(v)
// @@WANT@@
4294967295
// @@TEST@@
v > 0.0
// @@HIT@@
print(v)
// @@MISS@@
print(0)
// @@VALUE2@@
(match pick() { 1 => 3, _ => 0xFFFFFFFF }) as f64
// @@TYPE2@@
f64
// @@PROOF2@@
print(v)
// @@WANT2@@
4294967295
