// D15314: a field 1 level(s) into a union of records whose members store it differently,
// delivered at every position; the proof writes a value every member stores, then reads it.
// A shared field of a union reads at the union of its members' own records.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type K = { f: i32 }
type J = { f: i32 | null }
function pickU(c: boolean): K | J {
  if c {
    const k: K = { f: 4 }
    return k
  }
  const j: J = { f: null }
  return j
}
// @@VALUE@@
pickU(true)
// @@TYPE@@
K | J
// @@PROOF@@
v.f = 7
print(v.f ?? 0)
// @@WANT@@
7
// @@SKIP@@
is_in_if: the proof reads a field shared by both arms; the arm test is not what this grades
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
