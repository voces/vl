// A field of a union variant stored as a union box, read off a value narrowed to that variant, is
// the box itself (a boxed nullable on the field's box). The `i64 | null` read goes to every position;
// the closure-or-null and record-or-null shapes are their own cells, each set and `null`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type P = { n: i32 }
type A = { tag: "a", x: i64 | null, p: P | null, f: ((k: i32) => i32) | null }
type B = { tag: "b", y: i32 }
type U = A | B
function mk(): U { return { tag: "a", x: 41, p: { n: 7 }, f: (k: i32) => 10 + k } }
function mkn(): U { return { tag: "a", x: null, p: null, f: null } }
// @@SETUP@@
const u: U = mk()
// @@GUARD@@
u is A
// @@VALUE@@
u.x
// @@TYPE@@
i64 | null
// @@FALLBACK@@
null
// @@PROOF@@
print(v ?? -1)
// @@WANT@@
41
// @@CELL_closure_field@@
// want: 13 then 103
function call(u: U): i32 {
  if u is A {
    const g = u.f ?? ((k: i32) => 100 + k)
    return g(3)
  }
  return 0
}
print(call(mk()))
print(call(mkn()))
// @@CELL_record_field@@
// want: 7 then -2
function rd(u: U): i32 {
  if u is A {
    const p = u.p
    if p != null { return p.n }
  }
  return -2
}
print(rd(mk()))
print(rd(mkn()))
// @@CELL_scalar_null@@
// want: -1 then 0
function sc(u: U): i64 {
  if u is A { return u.x ?? -1 }
  return 0
}
print(sc(mkn()))
print(sc({ tag: "b", y: 1 }))
