// A `??` over a boxed binding whose default is wider than the binding's present type: `q ?? big()`
// over `q: i32 | null` with an `i64` default is the `i32 | i64` union (the `valBox` arm).
// Evaluation order beside an earlier operand is pinned by tests/ir-shadow-rows/coalesce-box-*.vl,
// not here: an assign position evaluates the value twice.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function mkq(): i32 | null { return null }
function big(): i64 {
  return -9000000003
}
// @@SETUP@@
const q = mkq()
// @@VALUE@@
q ?? big()
// @@TYPE@@
i32 | i64
// @@WANT@@
-9000000003
// @@TEST@@
v is i64
// @@HIT@@
print(v)
// @@MISS@@
print("narrow")
