// D2373's left-nested chain whose last default is a non-null THIRD record: the chain's box has
// three arms, and the default's arm is the one taken when both operands are null. The second
// instance takes the middle operand.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type A = { r: i32 }
type B = { q: string }
type C = { c: i32, z: f64 }
function mkA(n: i32): A | null { if n == 0 { return null } return { r: n } }
function mkB(s: string): B | null { if s == "" { return null } return { q: s } }
function stC(): C { return { c: 9, z: 2.5 } }
// @@VALUE@@
(mkA(0) ?? mkB("")) ?? stC()
// @@TYPE@@
A | B | C
// @@TEST@@
v is C
// @@HIT@@
print("c")
// @@MISS@@
print("miss")
// @@WANT@@
c
// @@VALUE2@@
(mkA(0) ?? mkB("b")) ?? stC()
// @@TYPE2@@
A | B | C
// @@PROOF2@@
if v is B { print("b") } else { print("miss") }
// @@WANT2@@
b
