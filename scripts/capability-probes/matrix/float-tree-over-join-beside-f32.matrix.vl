// D16497 — float arithmetic over a value join of literals beside a typed `f32` computes at `f32`,
// as the join alone beside it does (ruling 4.3), at every position the sum is delivered to.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __no(): boolean { return false }
const __fp: f32 = 1.0
// @@VALUE@@
__fp * (0.1 * (if __no() { 0.3 } else { 0.7 }))
// @@TYPE@@
f32
// @@PROOF@@
print(v)
// @@WANT@@
0.07000000029802322
// @@VALUE2@@
__fp + -(if __no() { 0.3 } else { 0.7 })
// @@TYPE2@@
f32
// @@PROOF2@@
print(v)
// @@WANT2@@
0.30000001192092896
