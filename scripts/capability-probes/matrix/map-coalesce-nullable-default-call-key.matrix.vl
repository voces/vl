// D2254 — `m[k] ?? d` over a null-free scalar map with a NULLABLE default is `i32 | null`, the
// box. A call key is not re-read, so the read stays on the fused single-evaluation get, which
// built the scalar and handed the box-typed default to an `i32` blocktype. VALUE2 is D2253's
// side: a map whose own value is `i32 | null`, where the fused get peeled to the raw scalar.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function key(k: string) { k }
const n: {[string]: i32} = Map()
n["b"] = 7
const nm: {[string]: i32 | null} = Map()
nm["a"] = null
const dflt: i32 | null = null
const other: i32 | null = 99
// @@VALUE@@
n[key("b")] ?? dflt
// @@TYPE@@
i32 | null
// @@PROOF@@
print(v ?? -1)
// @@WANT@@
7
// @@TEST@@
v != null
// @@HIT@@
print(v ?? -1)
// @@MISS@@
print(0)
// @@VALUE2@@
nm["a"] ?? other
// @@TYPE2@@
i32 | null
// @@PROOF2@@
print(v ?? -1)
// @@WANT2@@
99
