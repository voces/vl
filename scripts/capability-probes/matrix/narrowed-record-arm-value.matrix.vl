//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type Out = { a: i32 }
type Err = { msg: string }
function mkOut(): Out | Err { return { a: 3 } }
// @@SETUP@@
const __r = mkOut()
// @@GUARD@@
__r is Out
// @@VALUE@@
__r
// @@TYPE@@
Out
// @@FALLBACK@@
{ a: 0 }
// @@TEST@@
v.a > 0
