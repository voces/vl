// A `filter` or `map` whose lambda annotates its parameter at the element type `{ f: null }`, over
// a list a kept maker's build stores at a wider record `J`, delivered at every position. The
// lambda is instanced at the build as an un-annotated one is (D16764).
// @@PRELUDE@@
type J = { f: i32 | null }
function mk2() { return { f: null } }
const dA: J = mk2()
const src = [mk2()]
// @@VALUE@@
src.filter((y: { f: null }) => y.f == null).length
// @@TYPE@@
i32
// @@PROOF@@
print(v)
// @@WANT@@
1
// @@CELL_map_to_bool@@
// want: true
const r = src.map((y: { f: null }) => y.f == null)
print(r[0])
// @@CELL_filter_element@@
// want: null
const r = src.filter((y: { f: null }) => y.f == null)
print(r[0].f)
// @@CELL_filter_in_fn@@
// want: 1
function count() { return src.filter((y: { f: null }) => y.f == null).length }
print(count())
// @@CELL_filter_in_generic@@
// want: 1 then 7
function count<T>(t: T): T {
  print(src.filter((y: { f: null }) => y.f == null).length)
  return t
}
print(count(7))
// @@CELL_filter_twice@@
// want: 1
print(
  src
    .filter((y: { f: null }) => y.f == null)
    .filter((y: { f: null }) => y.f == null)
    .length,
)
// @@CELL_block_body@@
// want: 1
const n = src
  .filter((y: { f: null }) => {
    const g = y.f
    return g == null
  })
  .length
print(n)
// @@CELL_capture@@
// want: 1
const want = true
print(src.filter((y: { f: null }) => (y.f == null) == want).length)
// @@CELL_param_passed_on@@
// want: null then true
function show(z: { f: null }) { print(z.f) }
const r = src.filter((y: { f: null }) => {
  show(y)
  return true
})
print(r.length == 1)
// @@CELL_nested_list@@
// want: 1
const srcs = [src]
print(srcs[0].filter((y: { f: null }) => y.f == null).length)
// @@CELL_identity_map@@
// want: null
const r = src.map((y: { f: null }) => y)
print(r[0].f)
// @@CELL_named_fn@@
// want: 1
function keep(y: { f: null }) { return y.f == null }
print(src.filter(keep).length)
// @@CELL_held_lambda@@
// want: 1
const ok = (y: { f: null }) => y.f == null
print(src.filter(ok).length)
