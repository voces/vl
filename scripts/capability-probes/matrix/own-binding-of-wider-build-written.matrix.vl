// A binding of a call the record solve builds at a wider record beside a delivery, written
// through a field afterwards: the binding takes its own copy of the call's result, so the write
// stores at its own row (D15246). The proof writes a nested record and reads it back.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type J = { f: i32 | null }
type K = { j: J }
function mk() { { j: { f: 4 } } }
const _k: K = mk()
// @@VALUE@@
mk()
// @@TYPE@@
{ j: { f: i32 } }
// @@PROOF@@
v.j = { f: 5 }
print(v.j.f)
// @@WANT@@
5
