// D2666 — an un-annotated tail `if` over two maps whose value reps differ joins to their union,
// not the wider map: the value is the union box, tagged per arm, at every delivery.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function mka(): {[string]: i32} {
  const m: {[string]: i32} = Map()
  m["k1"] = 10
  m
}
function mkb(): {[string]: i32 | null} {
  const m: {[string]: i32 | null} = Map()
  m["k1"] = null
  m["k2"] = 20
  m
}
function pick(n: i32) {
  if n > 0 { mkb() } else { mka() }
}
// @@VALUE@@
pick(1)
// @@TYPE@@
{[string]: i32} | {[string]: i32 | null}
// @@TEST@@
v is {[string]: i32 | null}
// @@HIT@@
print(v.length)
print(v.has("k1"))
print(v["k2"] ?? -1)
// @@MISS@@
print("miss")
// @@WANT@@
2 then true then 20
// @@VALUE2@@
pick(0)
// @@TYPE2@@
{[string]: i32} | {[string]: i32 | null}
// @@PROOF2@@
if v is {[string]: i32} { print(v["k1"] ?? -1) } else { print("wrong") }
// @@WANT2@@
10
