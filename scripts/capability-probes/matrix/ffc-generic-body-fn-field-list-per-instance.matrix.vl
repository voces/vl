// Per instance: a generic function builds a list of records whose function field is its own
// identity at T, writes a second, and calls both. At i32 (3 twice) and at string (ab twice).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __id<T>(x: T): T { return x }
function __run<T>(x: T): {f: (x: T) => T}[] {
  const rs = [{ f: __id }]
  rs.push({ f: __id })
  return rs
}
// @@VALUE@@
__run(3)
// @@TYPE@@
{f: (x: i32) => i32}[]
// @@PROOF@@
for r in v { print(r.f(3)) }
// @@WANT@@
3 twice
// @@VALUE2@@
__run("ab")
// @@TYPE2@@
{f: (x: string) => string}[]
// @@PROOF2@@
for r in v { print(r.f("ab")) }
// @@WANT2@@
ab twice
