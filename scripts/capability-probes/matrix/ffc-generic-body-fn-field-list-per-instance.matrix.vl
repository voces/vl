// Per instance: a generic function builds a list of records whose function field is its own
// identity at T, pushes a second, and calls both. At i32 (3 + 3) and at string ("ab" + "ab").
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __id<T>(x: T): T { return x }
function __run<T>(x: T): {f: (x: T) => T}[] {
  const rs = [{ f: __id }]
  rs.push({ f: __id })
  return rs
}
// @@VALUE@@
__run(3)
// @@TYPE@@
{f: (x: i32) => i32}[]
// @@PROOF@@
let c = 0
for r in v { c = c + r.f(3) }
print(c)
// @@WANT@@
6
// @@VALUE2@@
__run("ab")
// @@TYPE2@@
{f: (x: string) => string}[]
// @@PROOF2@@
let s = ""
for r in v { s = s + r.f("ab") }
print(s)
// @@WANT2@@
abab
