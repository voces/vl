// D3956: a declared generic function handed, from a closure inside a generic instance, to another
// closure's parameter typed by that instance's type parameter. The built-in positions deliver the
// generic itself at the closed parameter type; the cells make the call from a closure through a
// binding, a list element, a record field, a map value, a nested closure and two instances.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function other<V>(v: V): V {
  return v
}
// @@VALUE@@
other
// @@TYPE@@
(t: i32) => i32
// @@PROOF@@
print(v(5))
// @@WANT@@
5
// @@CELL_via_binding@@
// want: 5
function a<T>(x: T) {
  const w = (g: (t: T) => T) => { print(g(x)) }
  const w2 = () => { w(other) }
  w2()
}
a(5)
// @@CELL_via_list_element@@
// want: 5
function a<T>(x: T) {
  const fs = [(g: (t: T) => T) => { print(g(x)) }]
  const w2 = () => { fs[0](other) }
  w2()
}
a(5)
// @@CELL_via_record_field@@
// want: 5
function a<T>(x: T) {
  const r = { f: (g: (t: T) => T) => { print(g(x)) } }
  const w2 = () => { r.f(other) }
  w2()
}
a(5)
// @@CELL_via_map_value@@
// want: 5
function a<T>(x: T) {
  const m: {[string]: (g: (t: T) => T) => void} = Map()
  m["k"] = (g: (t: T) => T) => { print(g(x)) }
  const w2 = () => {
    const h = m["k"]
    if h != null { h(other) }
  }
  w2()
}
a(5)
// @@CELL_via_nested_closure@@
// want: 5
function a<T>(x: T) {
  const w = (g: (t: T) => T) => { print(g(x)) }
  const w2 = () => {
    const w3 = () => { w(other) }
    w3()
  }
  w2()
}
a(5)
// @@CELL_via_two_instances@@
// want: 5 then s
function a<T>(x: T) {
  const w = (g: (t: T) => T) => { print(g(x)) }
  const w2 = () => { w(other) }
  w2()
}
a(5)
a("s")
// @@CELL_via_capture_written@@
// want: 5
function a<T>(x: T): T {
  let keep = x
  const w = (g: (t: T) => T) => { keep = g(x) }
  const w2 = () => { w(other) }
  w2()
  return keep
}
print(a(5))
