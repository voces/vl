// A field every arm shares, stored as a literal-set atom in one arm and as a string in the
// other (a lone-literal arm's row is softened to `string`). The read is typed as the literal
// union, so every arm must deliver the atom. The proof compares against a member, which only
// the atom rep answers right, and prints it, which needs the atom widened back (D5105).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type N = { kind: "a" | "b", v: i32 } | { kind: "end" }
function mk(e: boolean): N {
  if e { return { kind: "end" } }
  { kind: "b", v: 1 }
}
// @@VALUE@@
mk(true).kind
// @@TYPE@@
"a" | "b" | "end"
// @@TEST@@
v == "end"
// @@HIT@@
print("end")
// @@MISS@@
print("other")
// @@WANT@@
end
// @@VALUE2@@
mk(false).kind
// @@TYPE2@@
"a" | "b" | "end"
// @@PROOF2@@
print(v)
// @@WANT2@@
b
