// A union member's field typed by one bare string literal is stored as its atom; a read of it off
// a value of that member delivered where the literal's string is wanted leaves the atom, which
// the delivery decodes. The receiver is a union member, so the read takes the variant arm.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type A = { kind: "a", x: i32 }
type B = { kind: "b" | "c", x: i32 }
type U = A | B
const a: A = { kind: "a", x: 1 }
const u: U = a
// @@VALUE@@
a.kind
// @@TYPE@@
"a"
// @@PROOF@@
print(v)
// @@WANT@@
a
// @@VALUE2@@
a.kind
// @@TYPE2@@
string
// @@PROOF2@@
print(v + "!")
// @@WANT2@@
a!
