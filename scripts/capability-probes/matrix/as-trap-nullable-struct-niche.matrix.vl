// D1812 — `x as! S` over a niche-repped `S | null`, the STRUCT rep. The struct face is the
// one where the un-annotated binding needs the cast's own target to resolve the layout: a
// standalone struct is not a union variant, so the variant table cannot answer for it.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type A = { a: i32 }
function s1(): A | null { return { a: 7 } }
function s2(): A | null { return { a: 9 } }
// @@VALUE@@
s1() as! A
// @@TYPE@@
A
// @@PROOF@@
print(v.a)
// @@WANT@@
7
// @@VALUE2@@
s2() as! A
// @@TYPE2@@
A
// @@PROOF2@@
print(v.a)
// @@WANT2@@
9
// @@SKIP@@
is_in_if: the value is a plain struct, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
