// A nullable literal-union atom (`P | null`) compared with a string by `==`/`!=`, delivered at
// every position: the atom reads as a nullable string, its null niche the null ref, so the
// compare is `string | null` against `string` (D16822).
// @@PRELUDE@@
type P = "i32" | "str"
function pick(n: i32): P | null {
  if n == 0 { return null }
  if n == 1 { return "str" }
  return "i32"
}
const probe: string = "str"
// @@VALUE@@
pick(1) != probe
// @@TYPE@@
boolean
// @@PROOF@@
print(v)
// @@WANT@@
false
// @@CELL_null_ne@@
// want: true
print(pick(0) != probe)
// @@CELL_null_eq@@
// want: false
print(pick(0) == probe)
// @@CELL_eq_match@@
// want: true
print(pick(1) == probe)
// @@CELL_eq_other@@
// want: false
print(pick(2) == probe)
// @@CELL_string_left_eq@@
// want: false then true
print(probe == pick(0))
print(probe == pick(1))
// @@CELL_string_left_ne@@
// want: true then false
print(probe != pick(2))
print(probe != pick(1))
// @@CELL_held_local@@
// want: false then true
function test(n: i32): boolean {
  const h = pick(n)
  return h == probe
}
print(test(0))
print(test(1))
// @@CELL_field_read@@
// want: false then true
type R = { p: P | null }
function test(r: R): boolean { return r.p == probe }
print(test({ p: null }))
print(test({ p: "str" }))
// @@CELL_param_string@@
// want: true then false
function test(n: i32, s: string): boolean { return pick(n) != s }
print(test(0, "str"))
print(test(1, "str"))
// @@CELL_two_atoms_control@@
// want: true then false
print(pick(0) == pick(0))
print(pick(0) == pick(1))
// @@CELL_in_if@@
// want: no
if pick(0) == probe { print("yes") } else { print("no") }
