// `while n < 2 && (side(v)?.tag ?? "z") == "b"`: the call receiver in a loop condition is
// evaluated once per test, and not at all once `n < 2` fails (D5331).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type N = { tag: "a", v: i32 } | { tag: "b", w: i32 }
function mk(a: boolean): N | null {
  if a { return null }
  { tag: "b", w: 2 }
}
let trace = ""
function side(x: N | null): N | null {
  trace = trace + "R"
  x
}
// @@VALUE@@
mk(false)
// @@TYPE@@
N | null
// @@PROOF@@
trace = ""
let n = 0
while n < 2 && (side(v)?.tag ?? "z") == "b" {
  n = n + 1
  trace = trace + "n"
}
print(trace)
// @@WANT@@
RnRn
// @@VALUE2@@
mk(true)
// @@TYPE2@@
N | null
// @@PROOF2@@
trace = ""
let n = 0
while n < 2 && (side(v)?.tag ?? "z") == "b" {
  n = n + 1
  trace = trace + "n"
}
print(trace)
// @@WANT2@@
R
