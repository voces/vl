// D15248: a read of a map whose values are built wider, defaulted with `??` to a `let` that
// holds a record literal, delivered at every position. The binding is delivered at the read's
// record as a typed delivery of it is (D15217 takes only a `const`).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type J = { f: i32 | null }
function mkv() { { f: 4 } }
const m = Map()
m.set("a", mkv())
const wm: {[string]: J} = Map()
wm.set("a", mkv())
let dflt = { f: 1 }
// @@VALUE@@
m.get("a") ?? dflt
// @@TYPE@@
J
// @@PROOF@@
print(v.f ?? 0)
