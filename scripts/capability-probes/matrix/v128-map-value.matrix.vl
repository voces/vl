// v128-map-value (D16891, D1981's map face) — a `{[string]: F32x4}`, delivered whole at every
// position. The value column is the flat `v128` list; the proof reads a lane back through
// `laneY`, a typed helper. Own cells set, overwrite, delete, walk and `??` the map, and key it
// by `i32`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
import { F32x4, f32x4, splatF32 } from "std:simd"
function mk(n: i32): {[string]: F32x4} {
  const r: {[string]: F32x4} = Map()
  let i = 0
  while i < n {
    r.set("k\{i}", f32x4(i as f32, 1.5, 2.0, 3.0))
    i = i + 1
  }
  return r
}
function laneY(m: {[string]: F32x4}, k: string): f32 {
  const v = m.get(k)
  if v == null { return 0.0 as f32 }
  return v.y
}
// @@VALUE@@
mk(3)
// @@TYPE@@
{[string]: F32x4}
// @@TEST@@
v.length == 3 && laneY(v, "k2") == 1.5
// @@HIT@@
print(laneY(v, "k1") * 2.0)
// @@MISS@@
print("miss")
// @@WANT@@
3
// @@VALUE2@@
mk(4)
// @@TYPE2@@
{[string]: F32x4}
// @@PROOF2@@
print(laneY(v, "k3") + v.length as f32)
// @@WANT2@@
5.5
// @@CELL_overwrite@@
// want: 7
const m__A__ = __V__
m["k1"] = splatF32(7.0)
print(laneY(m, "k1"))
// @@CELL_delete@@
// want: 2 then false
const m__A__ = __V__
m.delete("k0")
print(m.length)
print(m.has("k0"))
// @@CELL_walk@@
// want: 3 then 4.5
const m__A__ = __V__
let s = 0.0 as f32
for k, x in m { s = s + x.x }
print(s)
let t = 0.0 as f32
for x in m.values() { t = t + x.y }
print(t)
// @@CELL_coalesce@@
// want: 2 then 9
const m__A__ = __V__
print((m.get("k2") ?? splatF32(9.0)).x)
print((m.get("zz") ?? splatF32(9.0)).x)
// @@CELL_miss_is_null@@
// want: true
const m__A__ = __V__
print(m.get("zz") == null)
// @@CELL_i32_key@@
// want: 2 then 6
const src__A__ = __V__
const m: {[i32]: F32x4} = Map()
m[4] = splatF32(2.0)
m.set(5, splatF32(4.0))
print(m.length)
let s = 0.0 as f32
for x in m.values() { s = s + x.z }
print(s + laneY(src, "k0") - 1.5)
// @@CELL_field@@
// want: 3
type Holder = { ps: {[string]: F32x4} }
const h: Holder = { ps: __V__ }
print(laneY(h.ps, "k1") * 2.0)
// @@CELL_unannotated_build@@
// want: 1.25
const m__A__ = __V__
const u = Map()
u.set("q", splatF32(1.25))
const g = u.get("q")
if g != null { print(g.w) }
// @@CELL_generic_body@@
// want: 5
const m__A__ = __V__
function one<T>(x: T) { const r: {[string]: T} = Map(); r.set("k", x); return r }
const g = one(splatF32(5.0)).get("k")
if g != null { print(g.z) }
// @@CELL_returned_from_lambda@@
// want: 3
const f = () => __V__
print(laneY(f(), "k1") * 2.0)
// @@CELL_nested_map@@
// want: 1.5 then 1
const m__A__ = __V__
const outer: {[string]: {[string]: F32x4}} = Map()
outer.set("o", m)
const inner = outer.get("o")
if inner != null { print(laneY(inner, "k0")) }
print(outer.length)
// @@CELL_nullable_value@@
// want: 2 then true
const m__A__ = __V__
const n: {[string]: F32x4 | null} = Map()
n.set("a", splatF32(2.0))
n.set("b", null)
const a = n.get("a")
if a != null { print(a.x) }
print(n.get("b") == null)
