// D4340 — `==` / `!=` against a string literal over a union whose literal arm is a declared
// ALIAS beside a record arm (`K | E`). The alias is the ingredient: spelled inline
// (`"a" | "b" | E`) the same compare already ran, while the alias spelling refused at emit.
//
// The PROOF discriminates: it compares against the held member, the other member, and from
// the literal's side, so a tag-only lowering (any string arm equal) would not print `2`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type E = { code: i32 }
type K = "a" | "b"
function mk(n: i32): K | E {
  if n == 0 { return "b" }
  return { code: n }
}
// @@VALUE@@
mk(0)
// @@TYPE@@
K | E
// @@FALLBACK@@
mk(5)
// @@TEST@@
v == "b"
// @@HIT@@
if v == "a" {
  print(0)
} else {
  if "b" != v { print(1) } else { print(2) }
}
// @@MISS@@
print(9)
// @@WANT@@
2
