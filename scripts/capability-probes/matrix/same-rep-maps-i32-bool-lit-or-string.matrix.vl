// D2493 — two maps of one representation in one union: each has its own box tag.
// The proof reads, writes, deletes, counts and walks the narrowed map, so a box tagged
// by its struct rather than its member type answers the wrong arm and prints wrong.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type L = "p" | "q"
function mka(): {[i32]: boolean} {
  const m: {[i32]: boolean} = Map()
  m.set(1, true)
  m.set(-2, false)
  m
}
function mkb(): {[i32]: L} {
  const m: {[i32]: L} = Map()
  m.set(1, "p")
  m.set(-2, "q")
  m
}
function pick(n: i32): {[i32]: boolean} | {[i32]: L} | string {
  if n > 0 { return mkb() }
  return mka()
}
// @@VALUE@@
pick(1)
// @@TYPE@@
{[i32]: boolean} | {[i32]: L} | string
// @@TEST@@
v is {[i32]: L}
// @@HIT@@
print(v.length)
print(v.has(1))
print((v.get(1) ?? "p"))
v.set(100000, "q")
print(v.length)
v.delete(-2)
print(v.has(-2))
let c = 0
for kk in v { c = c + 1 }
print(c)
print((v[100000] ?? "p"))
// @@MISS@@
print("miss")
// @@WANT@@
2 then true then p then 3 then false then 2 then q
// @@VALUE2@@
pick(0)
// @@TYPE2@@
{[i32]: boolean} | {[i32]: L} | string
// @@PROOF2@@
if v is {[i32]: boolean} {
  print(v.length)
  print(v.has(1))
  print((v.get(1) ?? false))
  v.set(100000, true)
  print(v.length)
  v.delete(-2)
  print(v.has(-2))
  let c = 0
  for kk in v { c = c + 1 }
  print(c)
  print((v[100000] ?? false))
} else { print("wrong") }
// @@WANT2@@
2 then true then true then 3 then false then 2 then true
