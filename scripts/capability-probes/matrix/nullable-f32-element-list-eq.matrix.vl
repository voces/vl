`==` over a list whose element is `f32 | null`, a union box: equal when each pair has one tag
and, for a number, one value; unequal on a null against a number (D15056).
// @@PRELUDE@@
function mkEq(): (f32 | null)[] { [1.5 as f32, null] }
function mkNe(): (f32 | null)[] { [1.5 as f32, 2.5 as f32] }
// @@VALUE@@
mkEq()
// @@TYPE@@
(f32 | null)[]
// @@WANT@@
true false true
// @@TEST@@
v == mkEq() && v != mkNe()
// @@HIT@@
print("true false true")
// @@MISS@@
print("miss")
// @@VALUE2@@
mkNe()
// @@TYPE2@@
(f32 | null)[]
// @@PROOF2@@
print("\{v == mkNe()} \{v == mkEq()}")
// @@WANT2@@
true false
