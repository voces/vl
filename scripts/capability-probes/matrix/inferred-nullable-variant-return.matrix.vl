// D1562 — a `Circle | null` value whose producer's return is INFERRED. `computeRetInference`'s
// name ladder had a `nulstruct` arm and no `nulvariant` twin, and `retKindPri` had no tier for
// the kind at all — so `criClassify`'s tier-5 `nulstruct` write won and the pair reached
// `fbValtype` as (`"nulvariant"`'s heap, -1).
//
// THE UNION DECLARATION IS THE INGREDIENT. Delete `type R = Hit | Miss` and `Hit` is a plain
// struct with a struct-table row, which the `nulstruct` arm has always served; declaring it
// takes that row away (`collectS` skips a `TypeDecl` that `variantIndexOf` claims) and there
// was nothing on the other side to answer.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type Hit = { v: i32 }
type Miss = { m: string }
type R = Hit | Miss
function mkA(ok: boolean): Hit | null {
  if ok { return null }
  return { v: 7 }
}
// @@VALUE@@
mkA(false)
// @@TYPE@@
Hit | null
// @@TEST@@
v != null
// @@HIT@@
print(v.v)
// @@MISS@@
print(-1)
// @@WANT@@
7
