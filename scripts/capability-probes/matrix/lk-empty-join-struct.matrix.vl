// List-kind audit (docs/internals/list-kind-audit-2026-09.md): an if-join of a typed `K[]` name with an empty `[]` arm,
// element kind `struct`. One row of a join-by-kind grid over nine element kinds; the proof reads
// elements back, so a value built at another list rep prints a different answer or fails to
// validate. Written by `list-kind-grid.py --write`; edit that, not this file.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type P = { x: i32 }
function truthy() { 1 == 1 }
const src: P[] = [{ x: 7 }, { x: 1 }]
function falsy() { 1 == 2 }
// @@VALUE@@
if truthy() { src } else { [] }
// @@TYPE@@
P[]
// @@PROOF@@
print(v[0].x + v[1].x)
// @@WANT@@
8
// @@VALUE2@@
if falsy() { src } else { [] }
// @@TYPE2@@
P[]
// @@PROOF2@@
const r2 = v
r2.push({ x: 7 })
const w = r2
print(w[0].x)
// @@WANT2@@
7
// @@SKIP@@
is_in_if: the value is a list, not a union - there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
