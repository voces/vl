// D16019 — a record written into a field or element whose record is narrower, used as a value:
// the assignment yields the value at its own record at every delivery position.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type WrA = { x: i32 }
type WrB = { x: i32, y: i32 }
type WrH = { p: WrA | null }
const wrh: WrH = { p: null }
const wrb: WrB = { x: 1, y: 2 }
// @@VALUE@@
(wrh.p = wrb)
// @@TYPE@@
WrB
// @@PROOF@@
print(v.y * 10 + (wrh.p?.x ?? 0))
// @@WANT@@
21
// @@SKIP@@
is_in_if: the value is a record, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
// @@CELL_element_target@@
// want: 21
const wras: WrA[] = [{ x: 0 }]
let wri = 0
const v__A__ = (wras[wri] = wrb)
print(v.y * 10 + wras[0].x)
// @@CELL_call_value@@
// want: 65
function wrMk(): WrB { return { x: 5, y: 6 } }
const v__A__ = (wrh.p = wrMk())
print(v.y * 10 + (wrh.p?.x ?? 0))
// @@CELL_receiver_before_value@@
// want: 94
let wrh2: WrH = { p: null }
const wrKeep = wrh2
function wrSwap(): WrB { wrh2 = { p: null }; return { x: 9, y: 4 } }
const v__A__ = (wrh2.p = wrSwap())
print((wrKeep.p?.x ?? 0) * 10 + v.y)
// @@CELL_field_read@@
// want: 2
print((wrh.p = wrb).y)
