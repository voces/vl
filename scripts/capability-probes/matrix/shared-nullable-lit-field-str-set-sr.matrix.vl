// A shared field read through an un-narrowed union of records, where the field is
// a string literal set beside `null` in both members (D15882). The union is spelled `S | R`.
// The first instance reads `R`'s literal value, the second `S`'s `null`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type K = "a" | "b"
type R = { x: K | null, s: string }
type S = { x: K | null, s: string, extra: i32 }
const r1: R = { x: "b", s: "r" }
const s1: S = { x: null, s: "s", extra: 3 }
const u1: S | R = r1
const u2: S | R = s1
// @@VALUE@@
u1.x
// @@TYPE@@
K | null
// @@WANT@@
b
// @@TEST@@
v == null
// @@HIT@@
print("null")
// @@MISS@@
print(v)
// @@VALUE2@@
u2.x
// @@TYPE2@@
K | null
// @@PROOF2@@
if v == null { print("null") } else { print(v) }
// @@WANT2@@
null
// @@CELL_param_receiver@@
// want: b
function rd(u: S | R) {
  const y __A__ = u.x
  if y == null { print("null") } else { print(y) }
}
rd(r1)
// @@CELL_param_receiver_null@@
// want: null
function rd(u: S | R) {
  const y __A__ = u.x
  if y == null { print("null") } else { print(y) }
}
rd(s1)
// @@CELL_coalesce@@
// want: b
print(u2.x ?? "b")
