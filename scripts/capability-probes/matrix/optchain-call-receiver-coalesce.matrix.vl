// D1670 — `?? d` over a `?.` whose receiver is a CALL. The fused two-arm lowering reads the
// receiver two and three times, so `optRecvReReadable` declined a call outright and the `??`
// fell through to a nullable arm with no rep: `vl check` rc 0, then a loud emit refusal.
//
// `mark0()` runs once per delivery and the receiver once per EVALUATION, so the proof
// `calls == marks` grades a cell that runs but re-evaluates as WRONG rather than RUNS.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type C = { y: i32 }
let calls = 0
let marks = 0
function mark0(): i32 {
  marks = marks + 1
  0
}
function mkC(): C | null {
  calls = calls + 1
  { y: 7 }
}
// @@VALUE@@
(mkC()?.y ?? 0) + mark0()
// @@TYPE@@
i32
// @@FALLBACK@@
0
// @@TEST@@
v == 7
// @@HIT@@
print(calls == marks)
// @@MISS@@
print(0)
// @@WANT@@
true
