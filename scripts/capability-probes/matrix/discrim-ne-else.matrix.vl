// D1486 — the else branch of a `!=` on a literal discriminant reads the tested arm (named arms).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type Circle = { kind: "circle", r: f64 }
type Rect = { kind: "rect", w: f64, h: f64 }
type Shape = Circle | Rect
function mk(n: i32): Shape {
  if n == 0 { return { kind: "circle", r: 1.0 } }
  return { kind: "rect", w: 2.0, h: 3.0 }
}
// @@VALUE@@
mk(1)
// @@TYPE@@
Shape
// @@TEST@@
v.kind != "rect"
// @@HIT@@
print(v.r)
// @@MISS@@
print(v.h)
// @@WANT@@
3
