// D10880: a list whose element is a union with the type parameter (`(T | i32)[]`), handed from
// every position to a generic that reads its `.length`. The second instance puts the parameter
// inside a record arm (`({ g: T } | i32)[]`), the grading list's inner-arm spelling.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __len<T>(v: (T | i32)[]): i32 { v.length }
function __lenG<T>(v: ({ g: T } | i32)[]): i32 { v.length }
// @@VALUE@@
["a", 3]
// @@TYPE@@
(string | i32)[]
// @@PROOF@@
print(__len(v))
// @@WANT@@
2
// @@VALUE2@@
[{ g: 1 }, 3]
// @@TYPE2@@
({ g: i32 } | i32)[]
// @@PROOF2@@
print(__lenG(v))
// @@WANT2@@
2
// @@SKIP@@
is_in_if: the value is a list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
