// A hole parameter of an exported function called at two types takes a parameter per type, as
// an unexported one does (D6204).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function same<T>(k: T): T { k }
export function mid(a): string {
  const s = a("x")
  const m = a(3)
  "\{s}\{m}"
}
// @@VALUE@@
mid(same)
// @@TYPE@@
string
// @@PROOF@@
print(v)
// @@WANT@@
x3
// @@VALUE2@@
mid(same) + "!"
// @@TYPE2@@
string
// @@PROOF2@@
print(v)
// @@WANT2@@
x3!
