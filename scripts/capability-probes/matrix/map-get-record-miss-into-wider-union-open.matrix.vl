// D10170, the open twin — the same map read made inside a generic whose value type is left
// open, `m.get(k)` returned as `i32 | T | null` and called at a record. A miss must land as
// the union's null and a hit as the record arm.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type P = { x: i32 }
function mk(): {[i32]: P} {
  const m: {[i32]: P} = Map()
  m.set(1, { x: 7 })
  m
}
function at<T>(m: {[i32]: T}, k: i32): i32 | T | null { return m.get(k) }
const c = mk()
// @@VALUE@@
at(c, 2)
// @@TYPE@@
i32 | P | null
// @@TEST@@
v is null
// @@HIT@@
print("null")
// @@MISS@@
if v is P { print(v.x) } else { print("other") }
// @@WANT@@
null
// @@VALUE2@@
at(c, 1)
// @@TYPE2@@
i32 | P | null
// @@PROOF2@@
if v is P { print(v.x) } else if v is null { print("null") } else { print("other") }
// @@WANT2@@
7
