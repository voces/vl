// A shared field read through an un-narrowed union of records, where the field is
// a number literal set beside `null` in both members. The union is spelled `S | R`.
// The first instance reads `R`'s literal value, the second `S`'s `null`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type N = 1 | 2
type R = { x: N | null, s: string }
type S = { x: N | null, s: string, extra: i32 }
const r1: R = { x: 2, s: "r" }
const s1: S = { x: null, s: "s", extra: 3 }
const u1: S | R = r1
const u2: S | R = s1
// @@VALUE@@
u1.x
// @@TYPE@@
N | null
// @@WANT@@
2
// @@TEST@@
v == null
// @@HIT@@
print("null")
// @@MISS@@
print(v)
// @@VALUE2@@
u2.x
// @@TYPE2@@
N | null
// @@PROOF2@@
if v == null { print("null") } else { print(v) }
// @@WANT2@@
null
// @@CELL_param_receiver@@
// want: 2
function rd(u: S | R) {
  const y __A__ = u.x
  if y == null { print("null") } else { print(y) }
}
rd(r1)
// @@CELL_param_receiver_null@@
// want: null
function rd(u: S | R) {
  const y __A__ = u.x
  if y == null { print("null") } else { print(y) }
}
rd(s1)
// @@CELL_coalesce@@
// want: 2
print(u2.x ?? 2)
