// D16839: a list of un-annotated functions held below the top of a generic's argument (in a
// record field, in a list, in a list an `if` chooses), handed through a generic identity, read
// and called at every position: the argument is pinned at the type its place classes close.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __hinc(a) { return a + 1 }
function __hinc1(a) { return a + 2 }
function __hid(x) { return x }
const __hr = __hid({ l: [__hinc, __hinc1] })
// @@VALUE@@
__hr.l[0](3)
// @@TYPE@@
i32
// @@TEST@@
v == 4
// @@HIT@@
print(1)
// @@MISS@@
print(0)
// @@WANT@@
1
// @@CELL_list_in_list@@
// want: 5
const __hll = __hid([[__hinc, __hinc1]])
print(__hll[0][1](3))
// @@CELL_list_an_if_chooses@@
// want: 5
const __hc = 3
const __hli = __hid(if __hc > 2 { [__hinc, __hinc1] } else { [__hinc1, __hinc] })
print(__hli[1](3))
// @@CELL_record_in_record@@
// want: 5
const __hrr = __hid({ o: { l: [__hinc1] } })
print(__hrr.o.l[0](3))
// @@CELL_list_beside_number@@
// want: 7
const __hrn = __hid({ l: [__hinc], n: 3 })
print(__hrn.l[0](__hrn.n) + __hrn.n)
// @@CELL_inline_read@@
// want: 4
print(__hid({ l: [__hinc] }).l[0](3))
