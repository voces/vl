// D4265 — two record arms share field `v`; `B`'s is a box whose `string` member fits `A`'s
// `"a" | "b"` only for some strings, so `is A` over a `B` value compares the box's payload.
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type A = { v: "a" | "b" }
type B = { v: i32 | string }
function mkb(k: i32): B {
  if k == 1 { return { v: "b" } }
  if k == 2 { return { v: "z" } }
  return { v: 3 }
}
function pick(k: i32): A | B {
  return mkb(k)
}
// @@VALUE@@
pick(1)
// @@TYPE@@
A | B
// @@TEST@@
v is A
// @@HIT@@
print("A")
// @@MISS@@
print("B")
// @@WANT@@
A
// @@VALUE2@@
pick(2)
// @@TYPE2@@
A | B
// @@PROOF2@@
if v is A { print("A") } else { print("B") }
// @@WANT2@@
B
