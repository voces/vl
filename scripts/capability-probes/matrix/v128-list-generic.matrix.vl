// v128-list-generic (D1981's array face, the type-parameter template) — an `F32x4[]` handed to
// generic functions whose `T[]` is left open, so each instance builds, reads and returns a
// vector list at its pin. The proof reads a lane back through `lane0`, as a getter does not
// satisfy a hole parameter's field.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
import { F32x4, splatF32 } from "std:simd"
function firstOf<T>(xs: T[]): T { xs[0] }
function twice<T>(xs: T[]): T[] { [...xs, ...xs] }
function lenOf<T>(xs: T[]): i32 { xs.length }
function lane0(a: F32x4): f32 { a.x }
// @@VALUE@@
[splatF32(2.0), splatF32(5.0)]
// @@TYPE@@
F32x4[]
// @@PROOF@@
print(lane0(firstOf(v)) + (lenOf(twice(v)) as f32))
// @@WANT@@
6
// @@CELL_push_through_generic@@
// want: 3
function add<T>(xs: T[], x: T): T[] {
  xs.push(x)
  xs
}
const ys = add(__V__, splatF32(1.0))
print(lenOf(ys))
