// A function delivered to each position and handed to a generic that lists it, copies the list
// whole by `slice(0)` and calls through both lists at its type parameter, the generic itself
// called at `i32` and at `string`: the twin of fn-value-generic-slice-copy-at-two-types with the
// element type left open (D10190).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function id<T>(x: T): T { x }
function __twice<T>(f: (x: T) => T, a: T): T {
  const fs = [f]
  const gs = fs.slice(0)
  gs[0](fs[0](a))
}
// @@VALUE@@
id
// @@TYPE@@
(x: i32) => i32
// @@PROOF@@
print(__twice(v, 3) * 10 + __twice(id, "ab").length)
// @@WANT@@
32
