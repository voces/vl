// A member equality over a `0 | "one" | null` box narrowed past `0` by an earlier equality: the
// compare reads the box as legacy's union compare does, at every position its boolean reaches.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type N = 0 | "one"
function pick(b: boolean): N | null {
  if b { return "one" }
  return 0
}
const k = pick(true)
// @@VALUE@@
k == "one"
// @@TYPE@@
boolean
// @@GUARD@@
k != 0
// @@FALLBACK@@
false
// @@PROOF@@
print(v)
// @@TEST@@
v
// @@HIT@@
print(v)
// @@MISS@@
print("miss")
// @@WANT@@
true
// @@CELL_local_box_function@@
function run(z: boolean) {
  const kk = pick(z)
  if kk == 0 { print("zero") } else { print(kk == "one") }
}
run(true)
// @@CELL_param_box_function@@
// want: false
function run(kk: N | null) {
  if kk == 0 { print("zero") } else { print(kk != "one") }
}
run("one")
