// D2209's null-sibling case: an empty `[]` arm whose sibling is a bare `null`. The `null`
// has no element to lend, so the `[]` arm still decides the join's rep. Handing the join to
// the `null` arm gave an i32 blocktype over a list ref. VALUE is an `if`, VALUE2 a `match`.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function truthy() { 1 == 1 }
function one() { 1 }
// @@VALUE@@
if truthy() { [] } else { null }
// @@TYPE@@
string[] | null
// @@TEST@@
v != null
// @@HIT@@
print(v.length)
// @@MISS@@
print("null")
// @@WANT@@
0
// @@VALUE2@@
match one() { 1 => [], _ => null }
// @@TYPE2@@
string[] | null
// @@PROOF2@@
if v != null { print(v.length) } else { print("null") }
// @@WANT2@@
0
