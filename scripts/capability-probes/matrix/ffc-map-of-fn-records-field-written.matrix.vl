// A map of records holding a function field: one record's field is rewritten through a narrowed
// read, then every value's field is called in a walk. The sum (6 + 4) needs the rewritten member.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __inc(n: i32): i32 { return n + 1 }
function __dbl(n: i32): i32 { return n * 2 }
function __mk(): {[string]: {f: (n: i32) => i32}} {
  const m: {[string]: {f: (n: i32) => i32}} = Map()
  m["a"] = { f: __inc }
  m["b"] = { f: __inc }
  return m
}
// @@VALUE@@
__mk()
// @@TYPE@@
{[string]: {f: (n: i32) => i32}}
// @@PROOF@@
const r = v["a"]
if r != null { r.f = __dbl }
let c = 0
for k, e in v { c = c + e.f(3) }
print(c)
// @@WANT@@
10
