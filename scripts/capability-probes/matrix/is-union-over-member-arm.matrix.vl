// `is U` over a value whose type is one member of the union `U`: the value fits `U`, so the
// test is always true and narrows nothing (D3359, D3360).
//
// The unannotated faces leave the operand's type open, so the test is asked at each instance.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type P = { x: i32 }
type U = P | string
function mk(n: i32): P { return { x: n } }
// @@VALUE@@
mk(4)
// @@TYPE@@
P
// @@TEST@@
v is U
// @@HIT@@
print(v.x)
// @@MISS@@
print(0)
// @@WANT@@
4
// @@VALUE2@@
mk(6)
// @@TYPE2@@
P
// @@PROOF2@@
print(if v is U { v.x } else { 0 })
// @@WANT2@@
6
