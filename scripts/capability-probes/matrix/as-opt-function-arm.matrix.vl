// D4018 — `as?` to the function arm of a union box: the closure on the hit, `null` on the miss.
// The value under test is such a cast, delivered to every position; the proof calls it.
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type F = (x: i32) => i32
function mk(k: i32): F { return (x: i32) => x + k }
function src(w: boolean): F | string {
  if w { return mk(4) }
  return "s"
}
// @@SETUP@@
const fv = src(true)
// @@VALUE@@
(fv as? F)
// @@TYPE@@
F | null
// @@PROOF@@
if v != null { print(v(3)) } else { print("none") }
// @@WANT@@
7
// @@VALUE2@@
(src(false) as? F)
// @@TYPE2@@
F | null
// @@PROOF2@@
if v != null { print(v(3)) } else { print("none") }
// @@WANT2@@
none
