// An un-annotated lambda whose body hands its `i32` argument to an un-annotated function giving
// `i32`, delivered at the function type `(a: i32) => f64`: the lambda's result converts to `f64`,
// so `v(3) / 8.0` prints `0.5`, which an `i32` result cannot (D9020). The second value relays
// an `i32` product.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function inc0(a) { return a + 1 }
// @@VALUE@@
(a) => inc0(a)
// @@TYPE@@
(a: i32) => f64
// @@PROOF@@
print(v(3) / 8.0)
// @@WANT@@
0.5
// @@VALUE2@@
(a) => inc0(a) * 2
// @@TYPE2@@
(a: i32) => f64
// @@PROOF2@@
print(v(3) / 16.0)
// @@WANT2@@
0.5
