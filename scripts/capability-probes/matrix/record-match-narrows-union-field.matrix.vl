// A `match` whose record pattern narrows one member's union field to a member, delivered at
// every position: the arm is taken by the field's tag, ahead of the member's own arm.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type __A = { x: i32 | string, z: i32 }
type __B = { x: i32, z: i32 }
type __C = { w: string }
function __mk(k: i32): __A | __C {
  if k > 1 { return { x: k, z: k } }
  if k > 0 { return { x: "s", z: 0 } }
  return { w: "w" }
}
const __u = __mk(2)
// @@VALUE@@
match __u { __B => 42, __A => 1, __C => 2 }
// @@TYPE@@
i32
// @@PROOF@@
print(v)
// @@WANT@@
42
