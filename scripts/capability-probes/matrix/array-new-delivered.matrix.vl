// An `__array_new__(n, fill)` list delivered at every position: the length is stashed, the fill
// written at the list's element rep, then the list allocated. Its own cells hold an f64, a string
// and a record fill, a fill that is itself an `__array_new__`, and a fill boxed into a union
// element, which the IR leaves to legacy.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type P = { x: i32 }
function seven(): i32 { return 7 }
// @@VALUE@@
__array_new__(3, seven())
// @@TYPE@@
i32[]
// @@TEST@@
v.length == 3
// @@HIT@@
print(v[2])
// @@MISS@@
print(0)
// @@WANT@@
7
// @@CELL_f64_fill@@
function cell(n: i32) {
  const v: f64[] = __array_new__(n, 3.5)
  print(v[n - 1] + 3.5)
}
cell(3)
// @@CELL_string_fill@@
function cell(n: i32) {
  const v: string[] = __array_new__(n, "7")
  print(v[n - 1])
}
cell(3)
// @@CELL_record_fill@@
function cell(n: i32) {
  const v: P[] = __array_new__(n, { x: 7 })
  print(v[n - 1].x)
}
cell(3)
// @@CELL_nested_fill@@
function cell(n: i32) {
  const v: i32[][] = __array_new__(n, __array_new__(n, 7))
  print(v[n - 1][n - 1])
}
cell(3)
// @@CELL_union_element_fill@@
function cell(n: i32) {
  const v: (i32 | string)[] = __array_new__(n, 7)
  const e = v[n - 1]
  if e is i32 { print(e) }
}
cell(3)
