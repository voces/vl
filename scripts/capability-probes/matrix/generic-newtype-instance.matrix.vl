// An instance of a generic `new` type is branded per instance and erased at run time (owner
// ruling A14 (a)): every delivery position keeps `Handle<Texture>` and runs. The owed cells are
// the brand's refusals: a bare base value, another instance, a structural variable, and `is`
// between two instances, which no runtime tag can answer.
// @@PRELUDE@@
type Texture = { t: i32 }
type Mesh = { m: i32 }
type Handle<T> = new i32
type Box<T> = new { v: T, n: i32 }
get val(self: Box<i32>): i32 { self.v + 1 }
// @@VALUE@@
3 as Handle<Texture>
// @@TYPE@@
Handle<Texture>
// @@PROOF@@
print(v as i32)
// @@WANT@@
3
// @@CELL_getter@@
// want: 42
const b: Box<i32> = { v: 41, n: 0 }
print(b.val)
// @@CELL_generic_param@@
function same<T>(h: Handle<T>): Handle<T> { h }
const w__A__ = same(__V__)
print(w as i32)
// @@CELL_box_generic_read@@
// want: s
function get<T>(b: Box<T>): T { b.v }
const b: Box<string> = { v: "s", n: 0 }
print(get(b))
// @@CELL_bare_base_refused@@
// owed: expected Handle<Texture>, got i32
function load(h: Handle<Texture>): i32 { h as i32 }
const n: i32 = 5
print(load(n))
// @@CELL_other_instance_refused@@
// owed: Handle<Mesh> doesn't fit in Handle<Texture>
const g = 4 as Handle<Mesh>
const w: Handle<Texture> = g
print(w as i32)
// @@CELL_structural_variable_refused@@
// owed: expected Box<i32>, got {v: i32, n: i32}
function f(p: Box<i32>): i32 { p.v }
const r = { v: 41, n: 0 }
print(f(r))
// @@CELL_is_between_instances_refused@@
// owed: union members 'Handle<Texture>' and 'Handle<Mesh>' have
function k(x: Handle<Texture> | Handle<Mesh>): i32 {
  if x is Handle<Texture> { return 1 }
  2
}
print(k(3 as Handle<Mesh>))
