// The generic twin of fn-map-written-two-results: the map's functions name their own open
// parameter `T`, bound where the value is called (D15137, D15160).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __id<T>(x: T): T { return x }
function __half<T>(x: T): f64 { return x / 2.0 }
// @@SETUP@@
const __fm = Map()
__fm.set("a", __id)
__fm.set("b", __half)
// @@VALUE@@
__fm
// @@TYPE@@
{[string]: (x: i32) => i32 | f64}
// @@PROOF@@
const __got = v.get("b")
if __got != null { print(__got(3)) }
// @@WANT@@
1.5
