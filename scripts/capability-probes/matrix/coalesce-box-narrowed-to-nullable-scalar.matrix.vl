// A `??` over a union box narrowed past its string arm to `i32 | null` (D3172's desugar, which
// tests and copies the box): the coalesced value is the scalar at every position.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function pick(n: i32): i32 | null | string {
  if n == 0 { return null }
  if n == 1 { return 4 }
  return "s"
}
const e = pick(0)
const f = pick(1)
// @@VALUE@@
(e ?? 7) + (f ?? 9)
// @@TYPE@@
i32
// @@GUARD@@
!(e is string) && !(f is string)
// @@FALLBACK@@
0
// @@PROOF@@
print(v)
// @@TEST@@
v == 11
// @@HIT@@
print(v)
// @@MISS@@
print("miss")
// @@WANT@@
11
// @@CELL_union_param_argument@@
function show(s: string | i32) { if s is i32 { print(s) } else { print("str") } }
if !(e is string) && !(f is string) { show(__V__) }
// @@CELL_nested_call_argument@@
function id(n: i32): i32 { return n }
if !(e is string) && !(f is string) { print(id(id(__V__))) }
// @@CELL_concat_operand@@
// want: n11
if !(e is string) && !(f is string) { print("n" + "\{__V__}") }
// @@CELL_interpolation_hole@@
// want: [7]
if !(e is string) { print("[\{e ?? 7}]") }
// @@CELL_if_arm_value@@
if !(e is string) && !(f is string) { const w = if f == null { 0 } else { __V__ }; print(w) }
// @@CELL_coalesce_operand@@
// want: 7
if !(e is string) { const g: i32 | null = e; print(g ?? (e ?? 7)) }
// @@CELL_record_field@@
if !(e is string) && !(f is string) { const r = { a: __V__ }; print(r.a) }
