// A list of records with a function field, each field rewritten through the loop variable of a
// `for`, then called by index. Both calls see the rewrite: 6 + 6.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __inc(n: i32): i32 { return n + 1 }
function __dbl(n: i32): i32 { return n * 2 }
// @@VALUE@@
[{ f: __inc }, { f: __inc }]
// @@TYPE@@
{f: (n: i32) => i32}[]
// @@PROOF@@
for r in v { r.f = __dbl }
print(v[0].f(3) + v[1].f(3))
// @@WANT@@
12
