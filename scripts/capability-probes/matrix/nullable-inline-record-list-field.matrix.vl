// D4721: a record whose field is a list literal of an inline record and `null`. The un-annotated
// face infers the field's element as a nullable inline record, whose read must keep its null.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@VALUE@@
{ f: [{ x: 1 }, null] }
// @@TYPE@@
{ f: ({ x: i32 } | null)[] }
// @@PROOF@@
const e1 = v.f[1]
let n = 0
if e1 == null { n = 10 }
const e0 = v.f[0]
if e0 != null { print(e0.x + n) } else { print(-1) }
// @@WANT@@
11
// @@TEST@@
v.f.length == 2
// @@HIT@@
const e1 = v.f[1]
let n = 0
if e1 == null { n = 10 }
const e0 = v.f[0]
if e0 != null { print(e0.x + n) } else { print(-1) }
// @@MISS@@
print(0)
