// D1692 — the ref-list template one NESTING LEVEL deeper, with the element's own
// declaration AFTER the holder that lists it. `struct_field_init` writes
// `type __W = { f: { g: { xs: A[] | null } } }`, a three-level declared nest whose innermost
// field is a nullable ref list (code 28); the row's own witness is the two-level cell.
//
// The element is a declared STRUCT on purpose. A UNION element runs at every position
// already, because `collectU` fills the union table before the declaration walk while
// `collectS` fills the struct table during it — so only a struct element can be classified
// before its own row exists, and only it separates a fix from a no-op.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function ns1(): A[] | null { return [{ r: 4 }] }
function ns2(): A[] | null { return [{ r: 5 }] }
type A = { r: i32 }
// @@VALUE@@
{ g: { xs: ns1() } }
// @@TYPE@@
{ g: { xs: A[] | null } }
// @@PROOF@@
const l = v.g.xs
if l != null { print(l[0].r) } else { print(0) }
// @@WANT@@
4
// @@VALUE2@@
{ g: { xs: ns2() } }
// @@TYPE2@@
{ g: { xs: A[] | null } }
// @@PROOF2@@
const l2 = v.g.xs
if l2 != null { print(l2[0].r) } else { print(0) }
// @@WANT2@@
5
// @@SKIP@@
is_in_if: the value is a struct, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
