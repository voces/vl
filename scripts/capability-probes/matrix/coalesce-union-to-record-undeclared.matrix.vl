// D2260 — a `??` joining a union to a nullable record no declaration names as an arm: the
// join `i32[] | Err | Ok | null` needs a tag for `Ok`, and its row is minted from the
// checker's recorded type rather than from a binding.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type Err = { code: i32 }
type Ok = { v: i32 }
function mkOk(): Ok | null { return { v: 5 } }
function mkNo(): Ok | null { return null }
function mkMiss(): i32[] | Err | null { return null }
// @@VALUE@@
mkMiss() ?? mkOk()
// @@TYPE@@
i32[] | Err | Ok | null
// @@TEST@@
v is Ok
// @@HIT@@
print("5")
// @@MISS@@
print("miss")
// @@WANT@@
5
// @@VALUE2@@
mkMiss() ?? mkNo()
// @@TYPE2@@
i32[] | Err | Ok | null
// @@PROOF2@@
print(v == null)
// @@WANT2@@
true
