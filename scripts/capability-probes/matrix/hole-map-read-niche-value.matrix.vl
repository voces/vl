// D3130, D3157 — a niche-valued map read whose receiver is typed at a hole's pin: a `boolean`
// map's read is `boolean | null` and a literal-union map's is `K | null`, each on its i32
// sentinel. The un-annotated argument cell printed the raw i32 of the value or the sentinel.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type AB = "a" | "b"
type R = { a: {[i32]: AB | null}, b: {[i32]: boolean} }
function mkR(k: i32): R {
  const a: {[i32]: AB | null} = Map()
  a[k] = "b"
  a[k + 1] = null
  const b: {[i32]: boolean} = Map()
  b[k] = true
  { a: a, b: b }
}
// @@VALUE@@
mkR(3)
// @@TYPE@@
R
// @@PROOF@@
print(v.a[3] ?? null)
print(v.a[4] ?? "a")
print(v.b[3] ?? false)
print(v.b[9])
// @@WANT@@
b then a then true then null
// @@VALUE2@@
mkR(5)
// @@TYPE2@@
R
// @@PROOF2@@
const t = v.a[9]
if t == null { print("none") } else { print(t) }
// @@WANT2@@
none
// @@SKIP@@
is_in_if: the value is a record, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
