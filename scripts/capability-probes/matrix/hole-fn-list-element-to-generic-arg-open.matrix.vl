// A list of functions with un-annotated parameters, one element read straight into a generic's
// `T` argument beside the list as its `T[]`, the appended element then called; the argument takes
// the element type the list's pin closed (D9890).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __put<T>(xs: T[], x: T) { xs.push(x) }
function __hinc(a) { a + 1 }
function __hdbl(a) { a * 2 }
// @@VALUE@@
[__hinc, __hdbl]
// @@TYPE@@
((a: i32) => i32)[]
// @@PROOF@@
__put(v, v[1])
print(v.length * 100 + v[2](5))
// @@WANT@@
310
