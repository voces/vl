// A `boolean | null` field narrowed by `is boolean` and read inside the narrowing, off a plain record, so the read takes the struct arm:
// the read is the i32 the field's niche holds, as legacy reads it. The value is the narrowing
// `if`, so each position delivers the read's arm.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type O = { f: boolean | null, n: i32 }
const o: O = { f: true, n: 1 }
// @@VALUE@@
if o.f is boolean { o.f } else { false }
// @@TYPE@@
boolean
// @@PROOF@@
print(v)
// @@WANT@@
true
// @@VALUE2@@
if o.f is boolean { !o.f } else { true }
// @@TYPE2@@
boolean
// @@PROOF2@@
print(v == false)
// @@WANT2@@
true
