// D15310: a read of a map whose values are built wider, its nested record storing a number wider
// (`i64`), defaulted with `??` to a `const` of a literal, delivered at every position. The
// binding keeps its own type and is built at the read's record.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type H = { f: i64 }
type J = { h: H }
function mkv() { { h: { f: 4 } } }
const m = Map()
m.set("a", mkv())
const wm: {[string]: J} = Map()
wm.set("a", mkv())
const dflt = { h: { f: 1 } }
// @@VALUE@@
m.get("z") ?? dflt
// @@TYPE@@
J
// @@PROOF@@
print(v.h.f * 4000000000)
// @@WANT@@
4000000000
// @@SKIP@@
is_in_if: the value is a record, not a union; there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
