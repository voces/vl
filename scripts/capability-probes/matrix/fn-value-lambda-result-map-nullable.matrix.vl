// D9741, D9742: a lambda returning `Map()`, or `null`, delivered where a function returning
// `{[string]: i32} | null` is expected. The lambda takes the expected result as its own, as the
// annotated `(x: i32): {[string]: i32} | null => ...` result does.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@VALUE@@
(x: i32) => Map()
// @@TYPE@@
(x: i32) => {[string]: i32} | null
// @@PROOF@@
const m = v(1)
if m == null { print(0) } else {
  m["a"] = 4
  print(m.length + (m["a"] ?? 0))
}
// @@WANT@@
5
// @@VALUE2@@
(x: i32) => null
// @@TYPE2@@
(x: i32) => {[string]: i32} | null
// @@PROOF2@@
print(v(1) == null)
