// A list-literal spread mixing a function result, a plain run and an empty source, widened
// into `f64[]`: every group is its own copy, and an empty group must contribute nothing.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function mk(): i32[] { return [3, 4] }
const none: i32[] = []
// @@VALUE@@
[...mk(), 5, ...none, 2.5, ...mk()]
// @@TYPE@@
f64[]
// @@PROOF@@
print(v[0] / 2.0 + v[3] + v[5] + v.length)
// @@WANT@@
14
// @@SKIP@@
is_in_if: the value is a list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
