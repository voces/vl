// A spread of a call's fresh list of nullable records beside a wider record part.
// @@PRELUDE@@
function mk() { return [{ x: 1 }, null] }
// @@VALUE@@
[...mk(), { x: 2.5 }]
// @@TYPE@@
({ x: f64 } | null)[]
// @@PROOF@@
print((v[0] ?? { x: 0.0 }).x + 0.25 + v.length)
// @@WANT@@
4.25
// @@SKIP@@
is_in_if: the value is not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
