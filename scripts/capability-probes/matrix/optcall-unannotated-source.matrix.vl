// The SOURCE-un-annotated face of the A5 optional CALL: the receiver's producer has an
// INFERRED `P | null` return, so the guard's two arms join on a rep inference chose. The A5
// matrices all annotate that return.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type P = { n: i32 }
function twice(self: P) { self.n * 2 }
function mkU(c: boolean) {
  if c { return { n: 21 } }
  return null
}
const u = mkU(true)
const z = mkU(false)
// @@VALUE@@
u?.twice() ?? 0
// @@TYPE@@
i32
// @@FALLBACK@@
0
// @@PROOF@@
print(v)
// @@WANT@@
42
// @@VALUE2@@
z?.twice() ?? 42
// @@TYPE2@@
i32
// @@PROOF2@@
print(v)
// @@WANT2@@
42
