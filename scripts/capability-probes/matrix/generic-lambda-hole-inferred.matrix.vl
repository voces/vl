// D5403: a generic function passed to an un-annotated parameter of a `const`-bound lambda, whose
// type the lambda's own call fixes. The generic's type parameter stays open; the annotated face
// annotates only the destination.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __k<T>(x: T): T {
  return x
}
const __ap = (f) => f(41)
const __ap2 = (f) => f("s")
// @@VALUE@@
__ap(__k)
// @@TYPE@@
i32
// @@PROOF@@
print(v)
// @@WANT@@
41
// @@TEST@@
v == 41
// @@HIT@@
print(v)
// @@MISS@@
print(0)
// @@VALUE2@@
__ap2(__k)
// @@TYPE2@@
string
// @@PROOF2@@
print(v)
// @@WANT2@@
s
