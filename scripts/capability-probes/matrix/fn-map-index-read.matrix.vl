// D15139: an un-annotated map written two functions of different result types, read by index.
// The index read is the nullable value `get` reads, so narrowed and called it runs the function
// stored at that key.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __inc(a) { return a + 1 }
function __half(a) { return a / 2.0 }
// @@SETUP@@
const __fm = Map()
__fm["a"] = __inc
__fm["b"] = __half
// @@VALUE@@
__fm
// @@TYPE@@
{[string]: (a: i32) => i32 | f64}
// @@PROOF@@
const __got = v["b"]
if __got != null { print(__got(3)) }
// @@WANT@@
1.5
