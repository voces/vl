// An un-annotated function whose body gives `i32`, delivered as a value at a function type
// returning `f64`: the delivery's adapter widens the result (D3073, D15896), at every position
// and in both faces. `/ 8` on an `f64` binding prints `0.5` only from a converted result (the
// un-annotated face widens at the binding). The second value is a binding of an un-annotated lambda.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function inc0(a) { return a + 1 }
const __dbl = (a) => a * 2
// @@VALUE@@
inc0
// @@TYPE@@
(a: i32) => f64
// @@PROOF@@
const __r: f64 = v(3)
print(__r / 8)
// @@WANT@@
0.5
// @@VALUE2@@
__dbl
// @@TYPE2@@
(a: i32) => f64
// @@PROOF2@@
const __r2: f64 = v(5)
print(__r2 / 8)
// @@WANT2@@
1.25
