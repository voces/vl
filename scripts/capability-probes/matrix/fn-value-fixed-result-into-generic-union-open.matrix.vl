// The open twin of fn-value-fixed-result-into-generic-union: the function value is a generic's
// own `() => V` result, so its `string` result is bound by inference at the maker's call, and
// `len`'s `T` is still bound by nothing.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function mkF<V>(x: V): () => V { (): V => x }
function len<T>(f: () => T | string) {
  const t = f()
  if t is string { t.length } else { 99 }
}
// @@VALUE@@
mkF("abc")
// @@TYPE@@
() => string
// @@PROOF@@
print(len(v))
// @@WANT@@
3
// @@VALUE2@@
mkF("hello")
// @@TYPE2@@
() => string
// @@PROOF2@@
print(len(v))
// @@WANT2@@
5
