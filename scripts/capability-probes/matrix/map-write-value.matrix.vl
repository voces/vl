// D16017 — a map entry write with a computed key, used as a value: the assignment yields the
// stored value at every delivery position, and the map holds it afterwards.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
const mwm: {[string]: i32} = Map()
let mwk = "a"
// @@VALUE@@
(mwm[mwk] = 5)
// @@TYPE@@
i32
// @@PROOF@@
print(v * 10 + (mwm["a"] ?? 0))
// @@WANT@@
55
// @@SKIP@@
is_in_if: the value is an i32, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
// @@CELL_string_valued@@
// want: v!v
const msv: {[string]: string} = Map()
let msk = "x"
const v = (msv[msk] = "v") + "!"
print(v + (msv["x"] ?? "-"))
// @@CELL_record_valued@@
// want: 44
type MwP = { n: i32 }
const mrp: {[string]: MwP} = Map()
let mrk = "x"
const v__A__ = (mrp[mrk] = { n: 4 }).n
print(v * 10 + (mrp["x"]?.n ?? 0))
