// D2690 — the record twin at an i32 key, over a map whose every value is null: `is` still
// tells `{[i32]: Circle}` from `{[i32]: Circle | null}` by the box tag, not by a value.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type Circle = { r: i32 }
type Sq = { s: i32 }
function mkc(): Circle | Sq { { r: 3 } }
function mks(): Circle | Sq { { s: 4 } }
function mkin(n: i32): {[string]: i32} {
  const m: {[string]: i32} = Map()
  m["q"] = n
  if n > 1 { m["r"] = n }
  m
}
function mka(): {[i32]: Circle} {
  const m: {[i32]: Circle} = Map()
  m.set(1, { r: 3 })
  m
}
function mkb(): {[i32]: Circle | null} {
  const m: {[i32]: Circle | null} = Map()
  m.set(1, null)
  m.set(-2, null)
  m
}
function pick(n: i32): {[i32]: Circle} | {[i32]: Circle | null} {
  if n > 0 { return mkb() }
  return mka()
}
// @@VALUE@@
pick(1)
// @@TYPE@@
{[i32]: Circle} | {[i32]: Circle | null}
// @@TEST@@
v is {[i32]: Circle}
// @@HIT@@
print("wrong")
// @@MISS@@
if v is {[i32]: Circle | null} {
print(v.length)
print(v.has(-2))
const x = v[1]
if x != null { print(x.r) } else { print("null") }
let c = 0
for kk in v { c = c + 1 }
print(c)
v.delete(-2)
print(v.has(-2))
} else { print("miss2") }
// @@WANT@@
2 then true then null then 2 then false
// @@VALUE2@@
pick(0)
// @@TYPE2@@
{[i32]: Circle} | {[i32]: Circle | null}
// @@PROOF2@@
if v is {[i32]: Circle | null} { print("wrong") } else if v is {[i32]: Circle} {
  print(v.length)
  const x = v[1]
  if x != null { print(x.r) } else { print("null") }
} else { print("wrong") }
// @@WANT2@@
1 then 3
