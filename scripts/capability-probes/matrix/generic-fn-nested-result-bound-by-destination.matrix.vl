// A generic whose result is a function returning a function, its type parameter bound only by
// the destination (D16410's mechanism one level down). Cells: a parameter that is itself
// higher-order, and a destination that is.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function gid<A>(x: A): A { x }
function sel<A>(f: (x: A) => A): () => (x: A) => A { () => f }
// @@VALUE@@
sel(gid)
// @@TYPE@@
() => (x: f64) => f64
// @@PROOF@@
print(v()(1.5))
// @@WANT@@
1.5
// @@CELL_ho_param@@
// want: 2.5
function twice<A>(g: (h: (x: A) => A) => A, h: (x: A) => A): A { g(h) }
function at15(h: (x: f64) => f64): f64 { h(1.5) + 1.0 }
print(twice(at15, gid))
// @@CELL_ho_param_dst@@
// want: 1.5
function wrap<A>(f: (x: A) => A): (h: (x: A) => A) => (x: A) => A { (h: (x: A) => A) => f }
const k: (h: (x: f64) => f64) => (x: f64) => f64 = wrap(gid)
print(k(gid)(1.5))
