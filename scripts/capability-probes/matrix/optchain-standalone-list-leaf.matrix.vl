// D1676 — a standalone `?.` whose leaf field is a LIST. `T[] | null` is the list wrapper's
// own nullable ref, the rep the code-15 nested-struct arm already speaks one table over, and
// the gate refused it for want of that arm.
//
// The proof reads an ELEMENT through the narrow, so a cell that builds the wrapper at the
// wrong heap type is a wrong value or a trap rather than a refusal.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type B = { y: i32[] }
function mkB(): B | null { { y: [7, 8] } }
const b = mkB()
// @@VALUE@@
b?.y
// @@TYPE@@
i32[] | null
// @@FALLBACK@@
null
// @@PROOF@@
if v != null { print(v[0]) } else { print(0) }
// @@WANT@@
7
