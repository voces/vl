// D2850: a record built by a hole constructor, `mk(a)` returning `{ f: a }`, at a record pin.
// The type parameter is left OPEN: nothing annotates `mk`, so the instance alone names the row.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function mk(a) { return { f: a } }
// @@VALUE@@
mk({ w: 4 })
// @@TYPE@@
{ f: { w: i32 } }
// @@TEST@@
v.f.w == 4
// @@HIT@@
print("ok")
// @@MISS@@
print("no")
// @@WANT@@
ok
// @@VALUE2@@
mk({ w: "s" })
// @@TYPE2@@
{ f: { w: string } }
// @@PROOF2@@
print(v.f.w)
// @@WANT2@@
s
