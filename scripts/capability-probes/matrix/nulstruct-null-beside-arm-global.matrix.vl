// D1563 — a bare `null` of a nullable-STRUCT type, delivered in a module where a nullable
// union-ARM global has already been given a narrowed call result. `emitNullLitNode` reads
// `pendingVariantIdx` BEFORE `pendingStructIdx` and does not consume it, and the three
// GLOBAL boundaries that seed it — the two global-init loops and `emitAssign`'s `global.set`
// arm — never cleared it. The arm's heap type therefore followed the seed onto the next
// `null` and landed in a cell of a DIFFERENT struct: check-clean invalid wasm, with the
// validator eliding both heap names (`expected (ref null $type), found (ref null $type)`).
//
// The un-annotated face is EXPECTED to refuse: a bare `null` with nothing pinning its type
// has no rep to take, which is the language's answer and not a gap.
//
// Reported by the glean session as VL-029 (`~/glean/docs/vl-issues.md`).
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type E = { msg: string }
type T = { n: i32, m: i32 }
type C = { a: i32, b: i32 }
function mk(x: i32): T | E {
  if x < 0 { return { msg: "no" } }
  return { n: x, m: x }
}
let __t: T | null = null
// @@SETUP@@
const __r = mk(3)
if __r is E { print("E") } else { __t = __r }
// @@VALUE@@
null
// @@TYPE@@
C | null
// @@TEST@@
v != null
// @@HIT@@
print(v.a)
// @@MISS@@
print("none")
// @@WANT@@
none
