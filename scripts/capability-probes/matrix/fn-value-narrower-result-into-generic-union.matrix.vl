// D10133 — a function value whose result is `i32`, handed to a generic that takes it as
// `() => T | string`. `T` binds to `i32` through the union's open arm, so the function is
// delivered into the union box; the instance calls it and narrows by `is string`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function len<T>(f: () => T | string) {
  const t = f()
  if t is string { 0 } else { 1 }
}
// @@VALUE@@
() => 4
// @@TYPE@@
() => i32
// @@PROOF@@
print(len(v))
// @@WANT@@
1
// @@VALUE2@@
() => 2.5
// @@TYPE2@@
() => f64
// @@PROOF2@@
print(len(v))
// @@WANT2@@
1
