// D1694 — D1690's capture one level of NESTING in. The inner literal mints its own row
// correctly; the OUTER literal then lands on `type H`, whose `f` slot is `(ref $Inner)`, so
// the inner value is emitted as `Inner` whatever row it resolved to and its payload is read
// at `Inner`'s box tags.
//
// The value boxes `i32 | boolean` and holds the i32 `7`; `Inner`'s box is `string | boolean`,
// whose tag 1 is `boolean`. Graded by PRINTED VALUE — every red cell is a check-clean wrong
// value, which is why `WANT` is `7` and not a run marker.
//
// `type H` and `type Inner` are never named by a value; declaring them is the whole
// ingredient, and deleting either one turns every cell green for the wrong reason.
//
// The holder-absent controls and the widening floor live in
// `tests/cases/structs/anon-struct-declared-nested-row-not-captured.vl`, not here.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type U1 = i32 | boolean
type U2 = string | boolean
type Inner = { xs: U2 }
type H = { f: Inner }
function u1(): U1 { return 7 }
function u1b(): U1 { return 8 }
// @@VALUE@@
{ f: { xs: u1() } }
// @@TYPE@@
{ f: { xs: U1 } }
// @@PROOF@@
print(v.f.xs)
// @@WANT@@
7
// @@VALUE2@@
{ f: { xs: u1b() } }
// @@TYPE2@@
{ f: { xs: U1 } }
// @@PROOF2@@
print(v.f.xs)
// @@WANT2@@
8
// @@SKIP@@
is_in_if: the value is a struct, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
