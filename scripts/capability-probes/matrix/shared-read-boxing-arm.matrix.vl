// A shared field read whose arms box (`u.v` over `{v: i32} | {v: string}`): the members store the
// field at different atoms, so each arm boxes its scalar under its atom's tag.
//
// The PROOF discriminates: `pick(2)` is the `B` member, whose `v` is the string "st"; the `A`
// member's is the i32 7, which would print 8.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type A = { k: "a", v: i32 }
type B = { k: "b", v: string }
type U = A | B
function pick(i: i32): U {
  if i > 0 { return { k: "b", v: "s" + "t" } }
  return { k: "a", v: 7 }
}
const u: U = pick(2)
// @@VALUE@@
u.v
// @@TYPE@@
i32 | string
// @@PROOF@@
if v is i32 { print(v + 1) } else { print(v) }
// @@WANT@@
st
