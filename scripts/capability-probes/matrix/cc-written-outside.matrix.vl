// A closure reading a `let` another closure of the same maker writes after both exist.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __mk() {
  let n = 10
  const bump = () => { n = n + 1 }
  const read = () => n
  bump()
  bump()
  return read
}
// @@VALUE@@
__mk()
// @@TYPE@@
() => i32
// @@PROOF@@
print(v())
// @@WANT@@
12
