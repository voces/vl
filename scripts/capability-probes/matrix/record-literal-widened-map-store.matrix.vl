// D2990 — an un-annotated record literal whose `i32` field a wider declared record stores as
// `f64`, bound first and then delivered to that record at every position. The literal is fresh,
// so it is built at the destination's record; the positions the use walk follows run, and the
// map store is the one D2990 added. `return_inferred`'s annotated face is D2996 (a call result
// is not fresh), which waits on a ruling.
//
// The PROOF divides by 2.0, so a field left at its `i32` storage cannot print 1.5.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type D = { v: f64 }
const x: i32 = 3
// @@SETUP@@
const o = { v: x }
// @@VALUE@@
o
// @@TYPE@@
D
// @@PROOF@@
print(v.v / 2.0)
// @@WANT@@
1.5
// @@SKIP@@
is_in_if: the value is a record, not a union; there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
