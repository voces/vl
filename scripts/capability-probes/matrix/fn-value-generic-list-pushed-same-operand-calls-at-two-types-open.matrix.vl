// A generic function delivered to each position, put in a list that is pushed the same generic,
// and called through the pushed element at TWO types as operands of one expression, so the value
// stays open. No function type spells that, so the annotated face refuses by design; the
// un-annotated face calls each type's instance (D10342).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function id<T>(x: T): T { x }
// @@VALUE@@
id
// @@TYPE@@
(x: i32) => i32
// @@PROOF@@
const __ws = [v]
__ws.push(id)
print(__ws[1]("abc").length * 100 + __ws[1](7))
// @@WANT@@
307
