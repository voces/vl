// A list of a function with an un-annotated parameter, its loop variable bound to a `const` in
// the body and called through it at one type, the list's element read at another, so the
// parameter stays open; the `const`'s calls name the generic (D9901).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __inc(a) { return a + 1 }
// @@VALUE@@
[__inc]
// @@TYPE@@
((a: i32) => i32)[]
// @@PROOF@@
let __n = 0
for __g in v {
  const __q = __g
  __n = __q(3)
}
const __f = v[0](2.5)
if __n == 4 { print(__f) } else { print("wrong i32 read") }
// @@WANT@@
3.5
// @@TEST@@
v.length == 1
// @@HIT@@
let __n = 0
for __g in v {
  const __q = __g
  __n = __q(3)
}
const __f = v[0](2.5)
if __n == 4 { print(__f) } else { print("wrong i32 read") }
// @@MISS@@
print(0)
