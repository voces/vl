// D1622 at every delivery position: the value is a NULLABLE closure handed back through two
// INFERRED returns, and the proof narrows it and calls it. `retKindPri` gave `nulclosure` no
// tier, so `criSetRetKind` refused the fact and the slot stayed `i32`; the read side then had
// no rep for the compare's bare `null`.
//
// The one-hop control is the sibling template `one-hop-nullable-closure-return`, which ran
// before this row and must keep running — the ingredient is the SECOND inferred hop.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function __mkNulClo(): ((i32) => i32) | null {
  return (n: i32) => n + 1
}
function __deliverNulClo() {
  return __mkNulClo()
}
// @@VALUE@@
__deliverNulClo()
// @@TYPE@@
((i32) => i32) | null
// @@PROOF@@
if v != null { print(v(54)) } else { print(0) }
// @@WANT@@
55
// @@TEST@@
v != null
// @@HIT@@
if v != null { print(v(54)) } else { print(0) }
// @@MISS@@
print(0)
// @@FALLBACK@@
null
// @@VALUE2@@
__deliverNulClo()
// @@TYPE2@@
((i32) => i32) | null
// @@PROOF2@@
if v != null { print(v(65)) } else { print(0) }
// @@WANT2@@
66
