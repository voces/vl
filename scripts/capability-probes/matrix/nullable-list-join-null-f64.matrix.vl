// D2236 — an un-annotated `f64[] | null` from a join of a non-empty list literal with a
// bare `null`: the binding's slot must be the list wrapper the join builds, not the backing
// array or no shape at all. VALUE is an `if`, VALUE2 a `match`.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function truthy() { 1 == 1 }
function one() { 1 }
// @@VALUE@@
if truthy() { [1.5] } else { null }
// @@TYPE@@
f64[] | null
// @@FALLBACK@@
null
// @@TEST@@
v != null
// @@HIT@@
print(v[0])
// @@MISS@@
print("null")
// @@WANT@@
1.5
// @@VALUE2@@
match one() { 1 => [2.5], _ => null }
// @@TYPE2@@
f64[] | null
// @@PROOF2@@
if v != null { print(v[0]) } else { print("null") }
// @@WANT2@@
2.5
