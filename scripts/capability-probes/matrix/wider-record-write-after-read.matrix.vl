// D16103, D16104 — a wider record written into a narrower name or field, used as a value after an
// operand its right-hand side changes: the operand is read first and the value is the record at
// its own type. The value is read twice in some positions, so the cells check the order.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type WaA = { x: i32 }
type WaB = { x: i32, y: i32 }
type WaH = { p: WaA | null }
let wak = 0
let waa: WaA = { x: 0 }
function waY(q: WaB): i32 { return q.y }
function waNb(): WaB { wak = 1; return { x: 1, y: 10 } }
// @@VALUE@@
(wak * 0 + waY(waa = waNb()))
// @@TYPE@@
i32
// @@PROOF@@
print(v * 10 + waa.x)
// @@WANT@@
101
// @@SKIP@@
is_in_if: the value is an i32, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
// @@CELL_field_target@@
// want: 101
const wah: WaH = { p: null }
let wfk = 0
function wfNb(): WaB { wfk = 1; return { x: 1, y: 10 } }
const v__A__ = wfk + waY(wah.p = wfNb())
print(v * 10 + (wah.p?.x ?? 0))
// @@CELL_element_operand_first@@
// want: 21
const waxs = [5, 6]
let wek = 0
function weNb(): WaB { wek = 1; return { x: 1, y: 10 } }
let wea: WaA = { x: 0 }
const v__A__ = waxs[wek] + waY(wea = weNb()) + waxs[wek]
print(v)
// @@CELL_field_operand_first@@
// want: 14
let wfa: WaA = { x: 3 }
let wck = 0
function wcNb(): WaB { wck = 1; return { x: 1, y: 10 } }
const v__A__ = wfa.x + waY(wfa = wcNb()) + wfa.x
print(v)
// @@CELL_call_operand_first@@
// want: 65
let wgk = 0
let wga: WaA = { x: 0 }
function wgG(): i32 { wgk = wgk + 5; return wgk }
function wgNb(): WaB { wgk = wgk + 1; return { x: wgk, y: wgk * 10 } }
const v__A__ = wgG() + waY(wga = wgNb())
print(v)
