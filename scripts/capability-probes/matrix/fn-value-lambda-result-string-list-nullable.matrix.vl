// D9742: a lambda returning a `string` list, or `null`, delivered where a function returning
// `string[] | null` is expected. The lambda takes the expected result as its own, as the
// annotated `(x: i32): string[] | null => ...` result does.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@VALUE@@
(x: i32) => ["a", "b"]
// @@TYPE@@
(x: i32) => string[] | null
// @@PROOF@@
const r = v(1)
if r == null { print(0) } else { print(r[1]) }
// @@WANT@@
b
// @@VALUE2@@
(x: i32) => null
// @@TYPE2@@
(x: i32) => string[] | null
// @@PROOF2@@
print(v(1) == null)
// @@WANT2@@
true
