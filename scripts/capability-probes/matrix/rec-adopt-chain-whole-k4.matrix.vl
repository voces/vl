// ending in a whole assignment; the list's adoption must settle the whole chain within the checker's
// re-checks, at every delivery position.

// @@PRELUDE@@
type J = { f: i32 | null }

// @@SETUP@@
const r0 = { f: 9 }
let r1 = { f: 1 }
r1 = r0
let r2 = { f: 2 }
r2 = r1
let r3 = { f: 3 }
r3 = r2
let r4 = { f: 4 }
r4 = r3

// @@VALUE@@
r4

// @@TYPE@@
J

// @@PROOF@@
print(v.f ?? 0)

// @@WANT@@
9

// @@SKIP@@
return_inferred: D16961, a re-pointed `let` returned from a function with an inferred result builds only its initialiser
