// D16311: a null-only list literal delivered at a record field whose element is `string | null`, a
// niche that stores `null` as its own sentinel, not as a null ref.
// Format: scripts/capability-probes/README.md, "Template format".
// @@VALUE@@
{ f: [null] }
// @@TYPE@@
{ f: (string | null)[] }
// @@PROOF@@
print(v.f.length == 1 && v.f[0] == null)
// @@WANT@@
true
// @@CELL_returned_record@@
function mk(): __TY__ { return __V__ }
const r = mk()
print(r.f.length == 1 && r.f[0] == null)
// @@CELL_list_of_records@@
const rs: (__TY__)[] = [__V__]
print(rs[0].f.length == 1 && rs[0].f[0] == null)
// @@CELL_two_nulls_pushed@@
const r: __TY__ = { f: [null, null] }
r.f.push(null)
print(r.f.length == 3 && r.f[2] == null)
