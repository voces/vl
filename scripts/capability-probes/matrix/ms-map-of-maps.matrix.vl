// A map of maps, delivered: a narrowed inner map written and read back.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __mk(): {[string]: {[string]: i32}} {
  const m: {[string]: {[string]: i32}} = Map()
  const inner: {[string]: i32} = Map()
  inner["z"] = 1
  m["o"] = inner
  return m
}
// @@VALUE@@
__mk()
// @@TYPE@@
{[string]: {[string]: i32}}
// @@PROOF@@
const i1 = v["o"]
if i1 != null { i1["z"] = 5 }
const i2 = v["o"]
if i2 != null { print(i2["z"] ?? 0) }
print(v.has("o"))
