// A list of a `let` first bound to a generic and then written with a lambda, read back and
// called at every delivery position of the list (D7141, D7143). The second value is the
// generic itself, whose element is instanced at the call.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __other<V>(v: V) { print(v) }
let __k = __other
__k = (n) => { print(n + 1) }
// @@VALUE@@
[__k]
// @@TYPE@@
((n: i32) => void)[]
// @@PROOF@@
v[0](3)
// @@WANT@@
4
// @@TEST@@
v.length == 1
// @@HIT@@
v[0](3)
// @@MISS@@
print(0)
// @@VALUE2@@
[__other]
// @@TYPE2@@
((n: i32) => void)[]
// @@PROOF2@@
for f in v { f(7) }
// @@WANT2@@
7
