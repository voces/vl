// D6524: an un-annotated lambda, and a declared generic with its type parameter left open, put
// into an un-annotated list and copied out of it into an un-annotated binding before the call.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
const __h = (u) => u + 1
const __fs = [__h]
const __hg = __fs[0]
function __idT<T>(a: T): T { return a }
const __ts = [__idT]
const __tg = __ts[0]
// @@VALUE@@
__hg(3)
// @@TYPE@@
i32
// @@PROOF@@
print(v)
// @@WANT@@
4
// @@TEST@@
v == 4
// @@HIT@@
print(v)
// @@MISS@@
print(0)
// @@VALUE2@@
__tg(2.5)
// @@TYPE2@@
f64
// @@PROOF2@@
print(v + 1.0)
// @@WANT2@@
3.5
