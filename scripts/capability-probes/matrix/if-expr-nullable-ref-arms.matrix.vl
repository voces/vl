// D1560 — an if-EXPRESSION whose two arms are CALLS returning `E | null`, at every delivery
// position and in both faces. Reported by the glean session as VL-025.
//
// The un-annotated binding was `emitProgram: bare null needs a struct-typed context` and, with
// nothing reading the binding at all, check-clean INVALID WASM: `exprNullableStruct` answered
// only the "other arm is a bare `null`" shape, so a `T | null`-valued arm classified as nothing
// and the slot fell to the i32 default while the `if` pushed `(ref null $E)`.
//
// The PROOF discriminates: `mkA(false)` returns a real struct, so a cell that lost the value
// prints `null` rather than `a`. The sibling template pairs `E` with a declared union, which is
// the other sentence.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type E = { msg: string }
function mkA(ok: boolean): E | null {
  if ok { return null }
  return { msg: "a" }
}
function mkB(ok: boolean): E | null {
  if ok { return null }
  return { msg: "b" }
}
function truthy() { 1 == 1 }
function falsy() { 1 == 2 }
// @@VALUE@@
if truthy() { mkA(falsy()) } else { mkB(falsy()) }
// @@TYPE@@
E | null
// @@FALLBACK@@
null
// @@TEST@@
v != null
// @@HIT@@
print(v.msg)
// @@MISS@@
print("null")
// @@WANT@@
a
// @@VALUE2@@
if truthy() { mkB(falsy()) } else { mkB(falsy()) }
// @@WANT2@@
b
