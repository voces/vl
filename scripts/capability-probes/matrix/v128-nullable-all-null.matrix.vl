// D2633 — the all-null face of `v128-nullable.matrix.vl`: a `v128 | null` that never holds a
// vector is still the box, and its null tag must read as null at every delivery position.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function vec(n: i32): v128 | null {
  if n < 0 { return null }
  __splat_i32x4__(n)
}
// @@VALUE@@
vec(-1)
// @@TYPE@@
v128 | null
// @@TEST@@
v == null
// @@HIT@@
print("none")
// @@MISS@@
print(__extract_lane_i32x4__(v, 0))
// @@WANT@@
none
// @@VALUE2@@
vec(-2)
// @@TYPE2@@
v128 | null
// @@PROOF2@@
print(__extract_lane_i32x4__(v ?? __splat_i32x4__(6), 3))
// @@WANT2@@
6
