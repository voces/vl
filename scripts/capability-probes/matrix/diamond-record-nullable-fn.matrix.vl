// D9771, D9810 — a nullable function over a record that nests another record twice over
// twelve levels. Its type, and a list or map element of it, must come from the arena row, not
// the record's spelling, which doubles per level.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type A0 = {x: i32}
type A1 = {l: A0, r: A0}
type A2 = {l: A1, r: A1}
type A3 = {l: A2, r: A2}
type A4 = {l: A3, r: A3}
type A5 = {l: A4, r: A4}
type A6 = {l: A5, r: A5}
type A7 = {l: A6, r: A6}
type A8 = {l: A7, r: A7}
type A9 = {l: A8, r: A8}
type A10 = {l: A9, r: A9}
type A11 = {l: A10, r: A10}
type A12 = {l: A11, r: A11}
const a0: A0 = {x: 1}
const a1: A1 = {l: a0, r: a0}
const a2: A2 = {l: a1, r: a1}
const a3: A3 = {l: a2, r: a2}
const a4: A4 = {l: a3, r: a3}
const a5: A5 = {l: a4, r: a4}
const a6: A6 = {l: a5, r: a5}
const a7: A7 = {l: a6, r: a6}
const a8: A8 = {l: a7, r: a7}
const a9: A9 = {l: a8, r: a8}
const a10: A10 = {l: a9, r: a9}
const a11: A11 = {l: a10, r: a10}
const a12: A12 = {l: a11, r: a11}
// @@VALUE@@
(x: A12): i32 => x.l.r.l.r.l.r.l.r.l.r.l.r.x + 4
// @@TYPE@@
((x: A12) => i32) | null
// @@FALLBACK@@
null
// @@PROOF@@
if v != null { print(v(a12)) }
// @@WANT@@
5
