// Two hole function parameters, each called at one type, handed back in swapped positions by a
// recursive call: each parameter takes a slot per type its calls and its forwards reach (D6202).
// The value is the recursion's result, so every position delivers what both instances built.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function same<T>(k: T): T { k }
function mid(a, b, n: i32): string {
  const s = a("x")
  const m = b(n)
  if n > 0 { return "\{s}\{m}" + mid(b, a, n - 1) }
  "\{s}\{m}"
}
// @@VALUE@@
mid(same, same, 1)
// @@TYPE@@
string
// @@PROOF@@
print(v)
// @@WANT@@
x1x0
// @@VALUE2@@
mid(same, same, 0)
// @@TYPE2@@
string
// @@PROOF2@@
print(v)
// @@WANT2@@
x0
