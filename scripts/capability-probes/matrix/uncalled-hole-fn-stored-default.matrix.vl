const m = Map()
m["k"] = { f: g }
print(m.length)
// @@CELL_inc_field_map@@
// want: 1
function g(x) { return x + 1 }
const v = { m: Map() }
v.m["k"] = { f: g }
print(v.m.length)
// @@CELL_inc_map_in_map@@
// want: 1
function g(x) { return x + 1 }
const __m = Map()
__m.set("k", { m: Map() })
const __mv = __m.get("k")
if __mv != null {
  __mv.m["k"] = { f: g }
  print(__mv.m.length)
}
