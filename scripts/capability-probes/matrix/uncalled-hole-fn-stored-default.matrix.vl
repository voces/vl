// An un-annotated function no call instances, stored where its value is held, builds at the
// default its parameter hole takes at check: `i32` unless the body's operator or method refuses
// it there (D16927). Each cell stores the function and prints how many it stored.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@VALUE@@
1
// @@TYPE@@
i32
// @@PROOF@@
print(v)
// @@WANT@@
1
// @@CELL_inc_record@@
// want: 1
function g(x) { return x + 1 }
const r = { f: g }
print(1)
// @@CELL_inc_list@@
// want: 1
