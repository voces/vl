// D8180: an `i32 | AB | null` box read under `!= null` and delivered, so an un-annotated
// destination binds the box at the source's set, and its `is i32` else is the `AB` arm.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type __AB = "a" | "b"
function __src(k: i32): i32 | __AB | null {
  if k == 0 { return null }
  if k == 1 { return 7 }
  return "b"
}
// @@SETUP@@
const __r = __src(2)
// @@GUARD@@
__r != null
// @@FALLBACK@@
0
// @@VALUE@@
__r
// @@TYPE@@
i32 | __AB
// @@WANT@@
b
// @@TEST@@
v is i32
// @@HIT@@
print(v + 1)
// @@MISS@@
print(v)
// @@SKIP@@
global_assign: the un-annotated global is seeded at the FALLBACK `0`, an `i32`, so the write is a check error by design
