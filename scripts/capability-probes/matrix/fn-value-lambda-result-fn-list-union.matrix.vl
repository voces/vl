// D9970: a lambda whose result is a value union of a list of functions and a scalar, typed only
// by the function type it is delivered to. The proof calls an element of the list it returns,
// so a list that landed in the wrong arm cannot print z.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@VALUE@@
() => [() => "z"]
// @@TYPE@@
() => (() => string)[] | i32
// @@PROOF@@
const __t = v()
if __t is i32 { print(__t) } else { print(__t[0]()) }
// @@WANT@@
z
// @@VALUE2@@
() => [() => 2.5]
// @@TYPE2@@
() => (() => f64)[] | i32
// @@PROOF2@@
const __t = v()
if __t is i32 { print(__t) } else { print(__t[0]()) }
// @@WANT2@@
2.5
