// D1170 — `o?.f ?? d` where `f` is a NESTED-STRUCT field (code 15). The `if` this lowers to
// needs its result spelled from the field's own TARGET ROW; `fbIfForSharedField` is keyed on
// the field code alone and could not, so the site declined every code-15 field while the
// narrowed spelling (`if o != null { o.f }`) ran at all of them.
//
// A code-15 slot is `(ref null $S)` storage at BOTH declarations (D1180), so the lowering
// tests receiver-null OR field-null: `f: S | null` must yield `d` for a null field too.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type S = { a: i32 }
type T = { f: S }
function mkT(n: i32): T | null {
  if n == 0 { return { f: { a: 11 } } }
  null
}
function dflt(): S { { a: 12 } }
// @@SETUP@@
const src = mkT(0)
// @@VALUE@@
src?.f ?? dflt()
// @@TYPE@@
S
// @@FALLBACK@@
{ a: 0 }
// @@TEST@@
v.a == 11
// @@HIT@@
print(11)
// @@MISS@@
print(-1)
// @@WANT@@
11
