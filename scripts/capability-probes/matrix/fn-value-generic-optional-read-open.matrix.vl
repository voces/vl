// The generic twin of fn-value-generic-optional-read: the field is read back through `?.` and
// called at TWO types, so its type parameter stays open. No function type spells that, so the
// annotated face refuses by design; the un-annotated face instances the field once per call.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function id<T>(x: T): T { x }
// @@VALUE@@
{ f: id }
// @@TYPE@@
{ f: (x: i32) => i32 } | null
// @@PROOF@@
const __n = v?.f(2) ?? 0
const __s = v?.f("abc") ?? ""
print(__s.length + __n)
// @@WANT@@
5
// @@TEST@@
v != null
// @@HIT@@
const __n = v?.f(2) ?? 0
const __s = v?.f("abc") ?? ""
print(__s.length + __n)
// @@MISS@@
print(0)
