// D11221 — `u as! N2` out of a `N2 | string` box. The literal-union arm rides the box as its
// base `i32`, so the cast tests the base's tag AND the payload's membership in `1 | 2`, and
// yields the bare `i32` atom `N2` reps as.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type N2 = 1 | 2
function mk(k: i32): N2 | string {
  if k == 0 { return "s" }
  if k == 1 { return 1 }
  2
}
// @@VALUE@@
mk(2) as! N2
// @@TYPE@@
N2
// @@TEST@@
v == 2
// @@HIT@@
print(v + 10)
// @@MISS@@
print(0)
// @@WANT@@
12
// @@VALUE2@@
mk(1) as! N2
// @@TYPE2@@
N2
// @@PROOF2@@
print(v + 20)
// @@WANT2@@
21
