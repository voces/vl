// D1665 — an INFERRED struct field whose value is a nullable MAP. The niche rung that codes
// a nullable field peels a `TyNullable` and its map arm was empty, so the field took no code
// and the literal minted no row. The annotated face pins the field through its spelling and
// runs; the un-annotated face is the row.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function nul1(): { [string]: i32 } | null {
  const m: { [string]: i32 } = Map()
  m["k"] = 55
  return m
}
function nul2(): { [string]: i32 } | null {
  const m: { [string]: i32 } = Map()
  m["k"] = 42
  return m
}
// @@VALUE@@
{ f: nul1() }
// @@TYPE@@
{ f: { [string]: i32 } | null }
// @@PROOF@@
const mv = v.f
if mv != null { print(mv["k"]) } else { print(0) }
// @@WANT@@
55
// @@VALUE2@@
{ f: nul2() }
// @@TYPE2@@
{ f: { [string]: i32 } | null }
// @@PROOF2@@
const mv2 = v.f
if mv2 != null { print(mv2["k"]) } else { print(0) }
// @@WANT2@@
42
// @@SKIP@@
is_in_if: the value is a struct, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
