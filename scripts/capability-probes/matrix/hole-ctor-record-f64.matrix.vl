// D2850: a record built by a hole constructor, `mk(a)` returning `{ f: a }`, at an f64 pin.
// The type parameter is left OPEN: nothing annotates `mk`, so the instance alone names the row.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function mk(a) { return { f: a } }
// @@VALUE@@
mk(2.5)
// @@TYPE@@
{ f: f64 }
// @@TEST@@
v.f == 2.5
// @@HIT@@
print("ok")
// @@MISS@@
print("no")
// @@WANT@@
ok
// @@VALUE2@@
mk(7)
// @@TYPE2@@
{ f: i32 }
// @@PROOF2@@
print(v.f + 1)
// @@WANT2@@
8
