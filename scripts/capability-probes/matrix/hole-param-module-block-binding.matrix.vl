// D1596, the consumer's own shape (glean, VL-042's earlier spelling) — a struct value bound
// inside a MODULE-SCOPE BLOCK and handed to an UN-ANNOTATED parameter. The monomorphizer pins
// a hole parameter from its argument's binding, and its module-scope rung read only the flat
// top-level statement list; a binding inside a top-level `if`/`while`/bare block is a
// start-function local, so no channel named it and the `"i32"` catch-all declared an i32
// parameter over a `(ref $type)` argument.
//
// THE DELIVERY IS IN THE PROOF, not in the face: this capability is a CROSS PRODUCT of two
// axes the fixed positions each carry alone — the block scope (`block_*`) and the hole
// parameter (`argument`'s un-annotated face) — and each axis alone RUNS. So the proof calls
// `viaHole` at every position, and the face axis grades the binding's own annotation.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type Box = { base: i32 }

function ld(self: Box): i32 { self.base }

function viaHole(b) { b.ld() }

function mkBox(n: i32): Box { return { base: n } }
// @@VALUE@@
mkBox(3)
// @@TYPE@@
Box
// @@WANT@@
3
// @@PROOF@@
print(viaHole(v))
// @@VALUE2@@
mkBox(4)
// @@TYPE2@@
Box
// @@WANT2@@
4
// @@PROOF2@@
print(viaHole(v))
