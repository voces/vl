// D9565: a lambda returning `null` delivered where a function returning `null` is expected,
// and called.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@VALUE@@
(x: i32) => null
// @@TYPE@@
(x: i32) => null
// @@PROOF@@
print(v(1))
// @@WANT@@
null
// @@VALUE2@@
() => null
// @@TYPE2@@
() => null
// @@PROOF2@@
print(v() == null)
// @@WANT2@@
true
