// An assignment used as a value whose target is a union-box GLOBAL and whose value the checker
// types at the member written: legacy's value is the target's box re-read (`asgReadNode`), which
// each delivery unboxes to the member. Only the member written has `s`; `other_member` writes the
// other member, so a wrong unbox traps or prints wrong.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type A = { r: i32 }
type B = { s: string }
function src(): A | B { return { r: 3 } }
let x: A | B = src()
// @@VALUE@@
(x = { s: "b" })
// @@TYPE@@
B
// @@PROOF@@
print(v.s)
// @@TEST@@
v.s == "b"
// @@HIT@@
print(v.s)
// @@MISS@@
print("miss")
// @@WANT@@
b
// @@CELL_other_member@@
// want: 5
const v = (x = { r: 5 })
print(v.r)
