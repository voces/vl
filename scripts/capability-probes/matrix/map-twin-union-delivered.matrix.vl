// D15540 — a union of two maps nothing can tell apart (`LM | IM`, an i32-literal-union map
// beside its plain base twin) delivered at every position. The union reps as its one map, so
// the proof reads its entry count back through a generic map parameter.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type LM = {[i32]: 1 | 2}
type IM = {[i32]: i32}
function mkI(): LM | IM {
  const m: IM = Map()
  m.set(3, 40)
  m
}
function mkL(): LM | IM {
  const m: LM = Map()
  m.set(1, 1)
  m.set(2, 2)
  m
}
function lenOf<T>(m: {[i32]: T}): i32 { m.length }
// @@VALUE@@
mkI()
// @@TYPE@@
LM | IM
// @@PROOF@@
print(lenOf(v))
// @@WANT@@
1
// @@VALUE2@@
mkL()
// @@TYPE2@@
LM | IM
// @@PROOF2@@
print(lenOf(v))
// @@WANT2@@
2
