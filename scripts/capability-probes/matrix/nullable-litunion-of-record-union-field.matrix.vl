// `v?.tag`, a nullable union of records' shared literal-union field, delivered where its type
// is `"a" | "b" | null`. The proof reads a present value and a null one, so a join that kept
// the string rep refuses, prints the fallback or fails to validate (D5330).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type N = { tag: "a", v: i32 } | { tag: "b", w: i32 }
function mk(a: boolean): N | null {
  if a { return null }
  { tag: "b", w: 2 }
}
// @@VALUE@@
mk(false)?.tag
// @@TYPE@@
"a" | "b" | null
// @@PROOF@@
print(v ?? "z")
// @@WANT@@
b
// @@VALUE2@@
mk(true)?.tag
// @@TYPE2@@
"a" | "b" | null
// @@PROOF2@@
print(v ?? "z")
// @@WANT2@@
z
