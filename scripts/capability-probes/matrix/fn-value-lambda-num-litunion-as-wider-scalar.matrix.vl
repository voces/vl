// D9492: a lambda returning a numeric literal union, delivered where a function returning a
// numeric scalar every member converts to exactly is expected. The lambda adopts the scalar and
// converts at its return, as `const b: i64 = a` does. The first union spans two widths; the
// second is `1 | 2` at `f64`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type W = 1 | 2 | 5000000000
type N = 1 | 2
const __w: W = 2
const __n: N = 2
function __wf(): W { __w }
// @@VALUE@@
() => __wf()
// @@TYPE@@
() => i64
// @@PROOF@@
print(v() + 5000000000)
// @@WANT@@
5000000002
// @@VALUE2@@
() => __n
// @@TYPE2@@
() => f64
// @@PROOF2@@
print(v() / 4.0)
// @@WANT2@@
0.5
// @@SKIP@@
is_in_if: the value is a function, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
