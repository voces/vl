// `record-param-width-before`'s cells with the parameter's record written inline instead of named
// (D16290): the rewrite keys an inline record by its spelling, so each cell must run as its named
// sibling does. The annotated face spells the value's own wide type on its binding.
// @@PRELUDE@@
// @@VALUE@@
{ age: 3, name: "a" }
// @@TYPE@@
{ age: i32, name: string }
// @@PROOF@@
print(v.name)
// @@WANT@@
a
// @@SKIP@@
binding: the built-in positions deliver the value at its own type; the cells deliver it to { name: string }
return_inferred: same
return_annotated: same
argument: same
struct_field_init: same
struct_field_assign: same
array_element: same
array_element_assign: same
array_push: same
local_assign: same
global_init: same
global_assign: same
map_value: same
map_set: same
closure_capture: same
block_if: same
block_if_capture: same
block_while: same
block_while_capture: same
block_bare: same
block_bare_capture: same
fn_body: same
fn_body_capture: same
is_in_if: same
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
array_element_place: same
map_value_place: same
struct_field_place: same
early_return_guard: same
two_instances: same
// @@CELL_direct@@
// want: a
function show(p: { name: string }) { print(p.name) }
const v__A__ = __V__
show(v)
// @@CELL_ufcs@@
// want: a
function show(self: { name: string }) { print(self.name) }
const v__A__ = __V__
v.show()
// @@CELL_two_rows@@
// want: a then b
function show(p: { name: string }) { print(p.name) }
const v__A__ = __V__
show(v)
show({ age: 4, name: "b" })
// @@CELL_generic_fwd@@
// want: a
function show(p: { name: string }) { print(p.name) }
function fwd<T>(t: T) { show(t) }
const v__A__ = __V__
fwd(v)
// @@CELL_generic_beside@@
// want: a then 1
function show<T>(p: { name: string }, t: T): T {
  print(p.name)
  t
}
const v__A__ = __V__
print(show(v, 1))
// @@CELL_hole_fwd@@
// want: a
function show(p: { name: string }) { print(p.name) }
function h(q) { show(q) }
const v__A__ = __V__
h(v)
// @@CELL_nested_call@@
// want: a
function inner(p: { name: string }) { print(p.name) }
function outer(p: { name: string }) { inner(p) }
const v__A__ = __V__
outer(v)
// @@CELL_nested_field@@
// want: a
function show(r: { p: { name: string } }) { print(r.p.name) }
const v__A__ = __V__
show({ p: v })
// @@CELL_recursive@@
// want: a
function walk(p: { name: string }, n: i32) {
  if n > 0 { walk(p, n - 1) } else { print(p.name) }
}
const v__A__ = __V__
walk(v, 3)
// @@CELL_loop@@
// want: a then a
function show(p: { name: string }) { print(p.name) }
const v__A__ = __V__
for x in [v, v] { show(x) }
// @@CELL_loop_two_rows@@
// want: a then b
function show(p: { name: string }) { print(p.name) }
const v__A__ = __V__
const w = { age: 4, name: "b" }
let i = 0
while i < 2 {
  if i == 0 { show(v) } else { show(w) }
  i = i + 1
}
// @@CELL_returned@@
// want: a
function pass(p: { name: string }): { name: string } { p }
const v__A__ = __V__
print(pass(v).name)
// @@CELL_returned_inferred@@
// want: a
function pass(p: { name: string }) { p }
const v__A__ = __V__
print(pass(v).name)
// @@CELL_lambda_param@@
// want: a
const show = (p: { name: string }) => print(p.name)
const v__A__ = __V__
show(v)
// @@CELL_nine_rows@@
// want: 1 then 1 then 1 then 1 then 1 then 1 then 1 then 1 then 1
function show(p: { name: string }) { print(p.name.length) }
show({ a1: 1, name: "1" })
show({ a2: 1, name: "2" })
show({ a3: 1, name: "3" })
show({ a4: 1, name: "4" })
show({ a5: 1, name: "5" })
show({ a6: 1, name: "6" })
show({ a7: 1, name: "7" })
show({ a8: 1, name: "8" })
show({ a9: 1, name: "9" })
