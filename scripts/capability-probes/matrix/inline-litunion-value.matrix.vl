// D2150 — a value typed with an INLINE string-literal union, delivered to every position. The
// inline set reps as the interned atom exactly as its alias spelling does, so every delivery has
// to agree on the atom: a position that still slots a string ref is invalid wasm, and one that
// reads the atom where a string is owed prints the interned id instead of the member.
//
// NO `type` DECLARATION MAY BE ADDED: an alias is the spelling that always ran. The TEST is a
// compare, which is what the atom exists for, and the HIT prints the value, which is what proves
// the member survived the delivery (an id would print a number).
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function pick(n: i32): "red" | "green" {
  if n > 0 { return "green" }
  "red"
}
// @@VALUE@@
pick(1)
// @@TYPE@@
"red" | "green"
// @@TEST@@
v == "green"
// @@HIT@@
print(v)
// @@MISS@@
print("miss")
// @@WANT@@
green
// @@VALUE2@@
pick(0)
// @@TYPE2@@
"red" | "green"
// @@PROOF2@@
print("c=" + v)
// @@WANT2@@
c=red
