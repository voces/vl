// D16951: a field read across record arms whose shared field is a list in one arm and an atom in
// another (`({f: i32} | {f: i32[]}).f`). The list rides the read's box under its kind's tag.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function pickL(b: boolean): {f: i32} | {f: i32[]} {
  if b { return { f: 5 } }
  return { f: [1, 2] }
}
// @@VALUE@@
pickL(false).f
// @@TYPE@@
i32 | i32[]
// @@PROOF@@
if v is i32 { print(v) } else { print(v.length) }
// @@WANT@@
2
// @@TEST@@
v is i32[]
// @@HIT@@
print(v.length)
// @@MISS@@
print(0)
// @@VALUE2@@
pickL(true).f
// @@TYPE2@@
i32 | i32[]
// @@PROOF2@@
if v is i32 { print(v) } else { print(v.length) }
// @@WANT2@@
5
// @@CELL_nested_boolean_list_arm@@
// want: 5 then 0 then 2 then true
function q(b: boolean): {f: i32} | {f: boolean[][]} {
  if b { return { f: 5 } }
  return { f: [[true], [false, true]] }
}
for b in [true, false] {
  const v = q(b).f
  if v is i32 { print(v) } else { print(v[1].length) }
  if v is boolean[][] { print(v[1][1]) } else { print(0) }
}
// @@CELL_nullable_nested_boolean_list_arm@@
// want: 5 then -1 then true
function q(n: i32): {f: i32} | {f: boolean[][] | null} {
  if n == 0 { return { f: 5 } }
  if n == 1 { return { f: null } }
  return { f: [[true]] }
}
for n in [0, 1, 2] {
  const v = q(n).f
  if v is i32 { print(v) } else if v is boolean[][] { print(v[0][0]) } else { print(-1) }
}
// @@CELL_string_literal_list_arm@@
// want: 5 then b
function q(b: boolean): {f: i32} | {f: ("a" | "b")[]} {
  if b { return { f: 5 } }
  return { f: ["a", "b"] }
}
for b in [true, false] {
  const v = q(b).f
  if v is ("a" | "b")[] { print(v[1]) } else { print(v) }
}
