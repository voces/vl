// A list of record literals whose function field holds un-annotated functions returning different
// types (D15791): a call through `rs[i].f` runs whichever member is stored there, its result the
// join of theirs. Each proof sums the calls at a runtime index (4 + 1.5), so a call the emitter
// resolves to one member at compile time cannot pass for the dispatch.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function two() { [1, 2].length }
function mk() { return [{ f: inc0 }, { f: half }] }
// @@VALUE@@
[{ f: inc0 }, { f: half }]
// @@TYPE@@
{ f: (a: i32) => f64 }[]
// @@PROOF@@
let acc = 0.0
let i = 0
while i < two() {
  acc = acc + v[i].f(3)
  i = i + 1
}
print(acc)
// @@WANT@@
5.5
// @@CELL_bound_field@@
const rs__A__ = __V__
let acc = 0.0
let i = 0
while i < two() {
  const g = rs[i].f
  acc = acc + g(3)
  i = i + 1
}
print(acc)
// @@CELL_returned_call@@
let acc = 0.0
let i = 0
while i < two() {
  acc = acc + mk()[i].f(3)
  i = i + 1
}
print(acc)
// @@CELL_sliced@@
const rs__A__ = __V__
const s = rs.slice(0, two())
let acc = 0.0
let i = 0
while i < two() {
  acc = acc + s[i].f(3)
  i = i + 1
}
print(acc)
// @@CELL_returned_sliced@@
const s = mk().slice(0, two())
let acc = 0.0
let i = 0
while i < two() {
  acc = acc + s[i].f(3)
  i = i + 1
}
print(acc)
// @@CELL_element_of_call@@
let acc = 0.0
let i = 0
while i < two() {
  const e = mk()[i]
  acc = acc + e.f(3)
  i = i + 1
}
print(acc)
// @@CELL_in_loop@@
const rs__A__ = __V__
let acc = 0.0
for r in rs { acc = acc + r.f(3) }
print(acc)
// @@CELL_bound_returned@@
const rs = mk()
let acc = 0.0
let i = 0
while i < two() {
  acc = acc + rs[i].f(3)
  i = i + 1
}
print(acc)
