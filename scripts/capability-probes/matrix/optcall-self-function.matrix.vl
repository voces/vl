// A5 / D1814 — the optional CALL over a free `self`-function. `p?.twice()` is one guard over
// the receiver and the plain UFCS call inside it, so the value is that call's own return
// behind a single `| null`; before it the callee was typed as a value and refused.
//
// The proof prints the RESULT, not its nullness: a guard that took the wrong arm would print
// the fallback rather than refuse.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type P = { n: i32 }
function twice(self: P) { self.n * 2 }
function mkP(c: boolean): P | null {
  if c { return { n: 21 } }
  return null
}
const p = mkP(true)
// @@VALUE@@
p?.twice()
// @@TYPE@@
i32 | null
// @@FALLBACK@@
null
// @@PROOF@@
print(v ?? 0)
// @@WANT@@
42
