// D4639 / D4638 — an if-expression whose arms are record literals of an ANONYMOUS union arm
// (`{ q: i32 }` inside `U`). The arm has a variant row and no plain struct row, so every
// delivery builds the arm's struct through the variant table, and a map keyed on the arm's
// spelling interns the same value slot the declaration mints.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type U = { q: i32 } | { r: i32 }
function pickQ(n: i32): boolean { n > 0 }
const seen = pickQ(1)
// @@VALUE@@
if seen { { q: 5 } } else { { q: 6 } }
// @@TYPE@@
{ q: i32 }
// @@FALLBACK@@
{ q: 0 }
// @@TEST@@
v.q == 5
// @@HIT@@
print(5)
// @@MISS@@
print(-1)
// @@WANT@@
5
// @@VALUE2@@
if seen { { q: 7 } } else { { q: 8 } }
// @@TYPE2@@
{ q: i32 }
// @@PROOF2@@
print(v.q)
// @@WANT2@@
7
