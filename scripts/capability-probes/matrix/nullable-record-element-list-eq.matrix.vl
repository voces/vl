`==` over a list whose element is a nullable record: equal when each pair is both null or
field-wise equal, unequal on a null against a record (D-pick 1, slice A).
// @@PRELUDE@@
type P = { x: i32, s: string }
function mkEq(): (P | null)[] { [{ x: 1, s: "a" }, null] }
function mkNe(): (P | null)[] { [{ x: 1, s: "a" }, { x: 1, s: "a" }] }
// @@VALUE@@
mkEq()
// @@TYPE@@
(P | null)[]
// @@WANT@@
true false true
// @@TEST@@
v == mkEq() && v != mkNe()
// @@HIT@@
print("true false true")
// @@MISS@@
print("miss")
// @@VALUE2@@
mkNe()
// @@TYPE2@@
(P | null)[]
// @@PROOF2@@
print("\{v == mkNe()} \{v == mkEq()}")
// @@WANT2@@
true false
