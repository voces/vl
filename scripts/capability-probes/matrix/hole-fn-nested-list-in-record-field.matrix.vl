// A record literal whose field is a list of lists of functions with an un-annotated parameter,
// written inline, read back through the field and called. The inner slot takes its type from
// that call (D9713).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __inc(a) { return a + 1 }
function __dbl(a) { return a * 2 }
// @@VALUE@@
{ xs: [[__inc], [__dbl]] }
// @@TYPE@@
{xs: ((a: i32) => i32)[][]}
// @@PROOF@@
print(v.xs[1][0](3) + v.xs[0][0](1))
// @@WANT@@
8
// @@TEST@@
v.xs.length == 2
// @@HIT@@
print(v.xs[1][0](3) + v.xs[0][0](1))
// @@MISS@@
print(0)
