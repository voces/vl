// D15137: an un-annotated map written two functions of different result types by `set`. The
// writes join the map's value set, so a value read by `get` and called runs the function stored
// at that key.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __inc(a) { return a + 1 }
function __half(a) { return a / 2.0 }
// @@SETUP@@
const __fm = Map()
__fm.set("a", __inc)
__fm.set("b", __half)
// @@VALUE@@
__fm
// @@TYPE@@
{[string]: (a: i32) => i32 | f64}
// @@PROOF@@
const __got = v.get("b")
if __got != null { print(__got(3)) }
// @@WANT@@
1.5
