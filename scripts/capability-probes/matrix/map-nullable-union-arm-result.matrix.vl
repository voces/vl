// A `.map` whose callback returns a nullable record that is an arm of a declared union builds a
// list of that arm's `| null` rep (D12820). The second instance maps the union itself down to
// its other arm, so a result read at the source's rep cannot print the answer.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type C = { r: i32 }
type S = { s: i32 }
type U = C | S
function g(k: i32): C | null { if k > 0 { { r: k } } else { null } }
const us: U[] = [{ s: 3 }, { r: 4 }]
// @@VALUE@@
[0, 2].map((k) => g(k))
// @@TYPE@@
(C | null)[]
// @@PROOF@@
print(v.length + (v[1]?.r ?? 0) + (v[0]?.r ?? 100))
// @@WANT@@
104
// @@VALUE2@@
us.map((e) => if e is S { e } else { null })
// @@TYPE2@@
(S | null)[]
// @@PROOF2@@
print((v[0]?.s ?? 0) + (v[1]?.s ?? 50))
// @@WANT2@@
53
