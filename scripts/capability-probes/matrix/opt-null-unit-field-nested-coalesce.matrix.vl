// D17422: `outer?.u.f ?? d`, through a nested struct whose leaf field is typed `null`, is `d` at
// every delivery position.

// @@PRELUDE@@
type U = { id: i32, f: null }
type W = { u: U }

// @@SETUP@@
const outer: W | null = { u: { id: 1, f: null } }

// @@VALUE@@
outer?.u.f ?? "d"

// @@TYPE@@
string

// @@PROOF@@
print(v)

// @@WANT@@
d
