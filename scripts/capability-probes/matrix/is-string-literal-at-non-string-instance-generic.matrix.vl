// D15251's generic twin: the test is in a generic body whose type parameter only the call fixes.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __h<T>(x: T) { x is "x" }
print(__h("x"))
// @@VALUE@@
3
// @@TYPE@@
i32
// @@WANT@@
0
// @@TEST@@
__h(v)
// @@HIT@@
print(1)
// @@MISS@@
print(0)
