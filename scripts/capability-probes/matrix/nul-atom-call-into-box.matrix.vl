// D12466 — a `K | null` call result, which the callee hands back as the atom niche, delivered into
// a box that also holds an `i32`: the atom boxes as its member string, `null` under the null tag.
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type K = "ka" | "kb"
function kn(b: boolean): K | null {
  if b { return "kb" }
  return null
}
// @@VALUE@@
kn(true)
// @@TYPE@@
K | null | i32
// @@PROOF@@
if v is "kb" { print("kb") } else { print("other") }
// @@WANT@@
kb
// @@VALUE2@@
kn(false)
// @@TYPE2@@
K | null | i32
// @@PROOF2@@
if v == null { print("N") } else { print("other") }
// @@WANT2@@
N
