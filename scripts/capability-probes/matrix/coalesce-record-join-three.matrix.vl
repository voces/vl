// D2373 with three records: a left-nested `??` chain whose inner link already joins to the
// box. The emitter re-associates the chain, so both links take the chain's union and the
// inner link's box is the outer's default.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type A = { r: i32 }
type B = { q: string }
type C = { z: f64 }
function mkA(): A | null { return null }
function mkN(): B | null { return null }
function mkC(): C | null { return { z: 1.5 } }
// @@VALUE@@
(mkA() ?? mkN()) ?? mkC()
// @@TYPE@@
A | B | C | null
// @@TEST@@
v is C
// @@HIT@@
print("c")
// @@MISS@@
print("miss")
// @@WANT@@
c
