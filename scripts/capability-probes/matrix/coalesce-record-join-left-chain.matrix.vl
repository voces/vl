// D2373's left-nested chain with a non-null record as its last default. The emitter
// re-associates `(a ?? b) ?? d` as `a ?? (b ?? d)`, so the chain's box is tested on its first
// operand's niche; the second instance takes the first operand, not the default.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type A = { r: i32 }
type B = { q: string }
function mkA(n: i32): A | null { if n == 0 { return null } return { r: n } }
function mkB(s: string): B | null { if s == "" { return null } return { q: s } }
function stB(): B { return { q: "d" } }
// @@VALUE@@
(mkA(0) ?? mkB("")) ?? stB()
// @@TYPE@@
A | B
// @@TEST@@
v is B
// @@HIT@@
print("b")
// @@MISS@@
print("miss")
// @@WANT@@
b
// @@VALUE2@@
(mkA(7) ?? mkB("")) ?? stB()
// @@TYPE2@@
A | B
// @@PROOF2@@
if v is A { print("a") } else { print("miss") }
// @@WANT2@@
a
