// A record built by a call at its own row (`n: i32`), delivered at every position into a
// record that stores `n` as `i64`. The call is also read at its own type, so the literal keeps
// its row and each delivery copies it, converting the number field.
//
// The PROOF multiplies past `i32`, so a field left at `i32` storage cannot print the want.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type R = { n: i64, s: string }
function mk() { { n: 3, s: "a" } }
const own = mk()
const ownN: i32 = own.n + 1
// @@VALUE@@
mk()
// @@TYPE@@
R
// @@PROOF@@
print(v.n * 4000000000)
// @@WANT@@
12000000000
// @@SKIP@@
is_in_if: the value is a record, not a union; there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
