// D9490: a lambda whose returns are members of a numeric literal union, delivered where a
// function returning that union is expected. Every return is checked, not only the tail, and the
// union reps as its base, so the literal needs no conversion. The second value returns an `i64`
// union member through an early `return`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type N = 1 | 2
type L = 5000000000 | 6000000000
// @@VALUE@@
() => 2
// @@TYPE@@
() => N
// @@PROOF@@
print(v() + 40)
// @@WANT@@
42
// @@VALUE2@@
(k: i32) => {
  if k > 1 { return 6000000000 }
  5000000000
}
// @@TYPE2@@
(k: i32) => L
// @@PROOF2@@
print(v(2) + 1)
// @@WANT2@@
6000000001
// @@SKIP@@
is_in_if: the value is a function, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
