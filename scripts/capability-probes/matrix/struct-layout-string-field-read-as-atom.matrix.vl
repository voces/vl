// A literal-set field its layout family stores as its string (it sits beside a `string` field of
// the same tag), read as its atom off an anonymous record of the same shape, so the read takes the plain struct arm. The read is the
// string the field holds, which its consumer takes as legacy's does.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type K = "circle" | "round"
type A = { kind: K, r: i32 }
type B = { kind: string, r: i32 }
function mk(n: i32): A | B {
  if n == 0 { return { kind: "round", r: 1 } }
  return { kind: "zz", r: 2 }
}
const o: { kind: K, r: i32 } = { kind: "circle", r: 1 }
// @@VALUE@@
o.kind
// @@TYPE@@
K
// @@PROOF@@
print(v)
// @@WANT@@
circle
// @@VALUE2@@
o.kind
// @@TYPE2@@
string
// @@PROOF2@@
print(v + "!")
// @@WANT2@@
circle!
