// D1243 — the `is` COMPLEMENT over a NULLABLE union, at every position and both faces. The
// HIT arm narrows wherever the value lands; only the complement needs the destination's
// DECLARED type to subtract from, so the un-annotated face loses it. `orerr-generic-pin`
// shows the same two cells at a literal-union spelling, which is what proves the gap is the
// complement and not the literal member: this template carries no literal arm at all.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function mkU(bad: boolean): i32 | null {
  if bad { return null }
  return 5
}
// @@VALUE@@
mkU(false)
// @@TYPE@@
i32 | null
// @@TEST@@
v is null
// @@HIT@@
print(0)
// @@MISS@@
print(v * 2)
// @@WANT@@
10
// @@VALUE2@@
mkU(false)
// @@TYPE2@@
i32 | null
// @@PROOF2@@
if v is null { print(0) } else { print(v * 2) }
// @@WANT2@@
10
