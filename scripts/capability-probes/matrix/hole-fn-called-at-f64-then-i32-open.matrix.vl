// D8061: an un-annotated function handed to a hole its body calls first at `f64` and then at
// `i32`, so the argument's parameters stay open until each call types them. The `i32` call's
// result divides as an integer, so the value is 40 only when that call is typed at its own `i32`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __add(a, b) { a + b }
function __p(g) {
  const f = g(1.5, 2.5)
  if f > 3.5 { g(7, 2) / 2 * 10 } else { 0 }
}
// @@VALUE@@
__p(__add)
// @@TYPE@@
i32
// @@PROOF@@
print(v)
// @@WANT@@
40
