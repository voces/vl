// A standalone `?.` whose leaf field is a map (D1680): `b?.y` over `b: B | null` is
// `{[string]: i32} | null`, the map struct's own nullable ref. The proof reads a value back out of
// the map, so a delivery that loses the map, or builds it at another struct, prints otherwise.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type B = { y: {[string]: i32} }
function mk(n: i32): B | null {
  if n < 0 { return null }
  const m: {[string]: i32} = Map()
  m["a"] = n
  return { y: m }
}
const b = mk(7)
const none = mk(-1)
// @@VALUE@@
b?.y
// @@TYPE@@
{[string]: i32} | null
// @@TEST@@
v != null
// @@HIT@@
print(v["a"] ?? -1)
// @@MISS@@
print("null")
// @@WANT@@
7
// @@VALUE2@@
none?.y
// @@TYPE2@@
{[string]: i32} | null
// @@PROOF2@@
if v != null { print(v["a"] ?? -1) } else { print("null") }
// @@WANT2@@
null
