// The open twin of fn-value-enclosing-param-into-generic-nullable: the value is a generic's own
// result, so the pin `U = null` is bound by inference at that call, not written. D10271.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function pick<V>(x: V) { x }
function len<T>(f: () => T | null) {
  const t = f()
  if t == null { 7 } else { 99 }
}
function outer<U>(x: U): i32 { len(() => x) }
// @@VALUE@@
pick(null)
// @@TYPE@@
null
// @@PROOF@@
print(outer(v))
// @@WANT@@
7
// @@VALUE2@@
pick("s")
// @@TYPE2@@
string
// @@PROOF2@@
print(outer(v))
// @@WANT2@@
99
