// A record whose field holds an un-annotated map of a function with an un-annotated parameter,
// read back through the field and called. The map takes its value type from that call (D9061).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __h(u) { return u + 1 }
const __hm = Map()
__hm["k"] = __h
// @@VALUE@@
{ m: __hm }
// @@TYPE@@
{m: {[string]: (u: i32) => i32}}
// @@PROOF@@
const __x = v.m["k"]
if __x != null { print(__x(3)) }
// @@WANT@@
4
// @@TEST@@
v.m.length == 1
// @@HIT@@
const __x = v.m["k"]
if __x != null { print(__x(3)) }
// @@MISS@@
print(0)
