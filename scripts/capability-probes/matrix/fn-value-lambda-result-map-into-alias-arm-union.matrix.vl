// A lambda returning `Map()` delivered where a function returning `{[string]: i32} | K` is
// expected, `K` an alias of two records. The un-annotated twin of
// `fn-value-lambda-result-map-into-alias-arm-union-annotated`; the alias stays one atom
// under the function type, so the union must still register with its map arm.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type Circle = { r: i32 }
type Sq = { s: i32 }
type K = Circle | Sq
function useMu(u: {[string]: i32} | K): i32 {
  if u is Circle { return u.r }
  if u is Sq { return u.s }
  u["a"] = 41
  u["a"] ?? -1
}
// @@VALUE@@
() => Map()
// @@TYPE@@
() => ({[string]: i32} | K)
// @@PROOF@@
print(useMu(v()))
// @@WANT@@
41
// @@VALUE2@@
() => ({ s: 5 })
// @@TYPE2@@
() => ({[string]: i32} | K)
// @@PROOF2@@
print(useMu(v()))
// @@WANT2@@
5
