// D1561 — a `??` over a nullable DECLARED struct union delivered into an INFERRED destination.
// The `??` desugars to an `if`, whose recorded type renders the arms STRUCTURALLY, so the
// name-keyed registry scan could not name `Shape` and the destination carried no union name.
// Every read that keys on that name then floored: this template's is the SHARED discriminant
// (`v.kind`), which routes through `sharedUnionFieldPlan`'s member-set resolution.
//
// The un-annotated face is the one the row is about — annotating the destination always ran.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type Circle = { kind: "circle", r: f64 }
type Rect = { kind: "rect", w: f64, h: f64 }
type Shape = Circle | Rect
function mkval(): Shape { return { kind: "rect", w: 2.0, h: 3.0 } }
function passh(x) { return x }
// @@SETUP@@
const srcOpt: Shape | null = passh(mkval())
// @@VALUE@@
(srcOpt ?? { kind: "circle", r: 1.0 })
// @@TYPE@@
Shape
// @@TEST@@
v.kind == "rect"
// @@HIT@@
print(v.w)
// @@MISS@@
print(0)
// @@WANT@@
2
