// D2785 — the list twin of `if-expr-arm-local-*`: the arm's value is a list local of its own
// prelude, so every position that classifies the join before the arm lowers must read that
// local's rep, not fall to i32.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function pick(): boolean { true }
// @@VALUE@@
if pick() { const x = [5, 6]; x } else { const y: i32[] = [7]; y }
// @@TYPE@@
i32[]
// @@TEST@@
v[0] == 5
// @@HIT@@
print(v[0])
// @@MISS@@
print("miss")
// @@WANT@@
5
