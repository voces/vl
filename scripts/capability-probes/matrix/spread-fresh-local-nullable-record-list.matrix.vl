// The nullable face of D16615: a list literal that only spreads a call whose function returns a
// local list literal of records and `null`, delivered where a list of a wider nullable record is
// declared. Each call binds a new list, so the spread is copied at every position, in both faces.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function mk() {
  const cc = [{ x: 1 }, null]
  return cc
}
// @@VALUE@@
[...mk()]
// @@TYPE@@
({ x: f64 } | null)[]
// @@PROOF@@
const e = v[0]
if e != null { print(e.x + 0.25 + v.length) }
// @@WANT@@
3.25
// @@SKIP@@
is_in_if: the value is a list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
