// D3198 — the `-1` of a `K | null` atom-niche value, spelled inline as
// `"a" | "b" | "c" | null`, delivered into `string | null` at every position, module-scope ones
// included: the null sentinel widens to `null`, not to a member.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
const nx0: "a" | "b" | "c" | null = null
// @@VALUE@@
nx0
// @@TYPE@@
string | null
// @@TEST@@
v == null
// @@HIT@@
print("n")
// @@MISS@@
print(v)
// @@WANT@@
n
