// D14648: an inferred list of one function, handed through two un-annotated parameters to a
// callee that writes a function of another result type into it. The write joins the list's element set, so a
// call through the element after the callee returns runs the written function.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __inc(a) { return a + 1 }
function __half(a) { return a / 2.0 }
function __put(ys) { ys[0] = __half }
function __hand(zs) { __put(zs) }
// @@SETUP@@
const __xs = [__inc]
__hand(__xs)
// @@VALUE@@
__xs
// @@TYPE@@
readonly ((a: i32) => i32 | f64)[]
// @@PROOF@@
print(v[0](3))
// @@WANT@@
1.5
