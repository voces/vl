// A list of lists of a function with an un-annotated parameter, built as a local of a function
// that takes an argument and returned, the call's inner element read at two types, so the
// parameter stays open; each read names its generic (D9902).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __inc(a) { return a + 1 }
function __deliver(_n) {
  const u = [[__inc]]
  return u
}
// @@VALUE@@
__deliver("s")
// @@TYPE@@
((a: i32) => i32)[][]
// @@PROOF@@
const __n = v[0][0](3)
const __f = v[0][0](2.5)
if __n == 4 { print(__f) } else { print("wrong i32 read") }
// @@WANT@@
3.5
