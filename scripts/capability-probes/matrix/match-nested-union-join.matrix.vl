// D2822 — an if-expression arm that ends in another if-expression, joined into a union: the inner
// `if`'s arms are lowered as the outer join's own, so each leaf boxes once at the union.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function which(): i32 { 0 }
// @@VALUE@@
match which() {
  0 => if which() == 0 { 1 } else { "s" }
  _ => "t"
}
// @@TYPE@@
i32 | string
// @@TEST@@
v is i32
// @@HIT@@
print(v)
// @@MISS@@
print("miss")
// @@WANT@@
1
