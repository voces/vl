// D3026 — a `(string | i32)[]` delivered where a `readonly (string | i64)[]` is declared, and
// pushed to afterwards, is shared: the proof reads the pushed `i32` box back through the view
// as its `i64` member, which the read rebuilds. Without the rebuild the read casts and traps.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function ruvMk(c: boolean): string | i32 {
  if c { return "s" }
  return 8
}
const ruvL: (string | i32)[] = [ruvMk(true)]
// @@VALUE@@
ruvL
// @@TYPE@@
readonly (string | i64)[]
// @@PROOF@@
ruvL.push(ruvMk(false))
const e = v[1]
if e is string { print(e) } else { print(e + 1) }
// @@WANT@@
9
