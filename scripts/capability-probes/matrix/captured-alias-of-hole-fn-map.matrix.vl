// D15163 — a map whose function values have hole types, read through every delivery
// position. The capture positions are the point: the env field must be the map the local is.

// @@PRELUDE@@
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }

const fnMap = Map()
fnMap.set("a", inc0)
fnMap.set("b", half)

// @@VALUE@@
fnMap

// @@TYPE@@
{ [string]: (f64) => f64 }

// @@PROOF@@
const g = v.get("b")
if g != null { print(g(3)) }

// @@WANT@@
1.5
