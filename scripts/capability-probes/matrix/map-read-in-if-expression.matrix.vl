// D1827 — a module-global MAP read anywhere inside an if used as an EXPRESSION. The map
// scratch frame is reserved from `fnUsesMap`, whose walk (`exprHasMapOp`) tested every
// operand kind but not an `if` in expression position, so the body emitted `local.get`s
// against fifteen slots the locals vector never declared.
//
// The proof reads the map through the guard rather than testing its nullness: a frame that
// is missing shows up as a validator refusal, and one at the wrong BASE as a wrong value.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
const reg: {[string]: i32} = Map()
reg["k"] = 42
// @@VALUE@@
if reg["k"] != null { reg["k"] } else { null }
// @@TYPE@@
i32 | null
// @@FALLBACK@@
null
// @@PROOF@@
print(v ?? 0)
// @@WANT@@
42
