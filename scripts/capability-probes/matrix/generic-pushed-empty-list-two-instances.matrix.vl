// D10071's generic twin: the parameter is a type parameter rather than a hole, and the `[]` it is
// pushed into is still un-annotated, called at `string` and then at `f64`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __fill<T>(p: T) {
  const xs = []
  xs.push(p)
  xs.push(p)
  xs[1]
}
const __other = __fill("s")
// @@VALUE@@
__fill(2.5)
// @@TYPE@@
f64
// @@PROOF@@
print(v / 2.0)
// @@WANT@@
1.25
