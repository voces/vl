// D15055: `==` between a list of `P | null` and a `P[]`, the record plain beside nullable: each
// pair compares field-wise, a null against a record is unequal. The second instance holds a null.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type XrP = { x: i32, s: string }
function xrMk(n: boolean): (XrP | null)[] {
  if n { return [{ x: 1, s: "a" }, null] }
  return [{ x: 1, s: "a" }, { x: 2, s: "b" }]
}
function xrPl(b: string): XrP[] {
  return [{ x: 1, s: "a" }, { x: 2, s: b }]
}
const xrEq: XrP[] = xrPl("b")
const xrNe: XrP[] = xrPl("c")
// @@VALUE@@
xrMk(false)
// @@TYPE@@
(XrP | null)[]
// @@TEST@@
v == xrEq && v != xrNe
// @@HIT@@
print("value")
// @@MISS@@
print("storage")
// @@WANT@@
value
// @@VALUE2@@
xrMk(true)
// @@TYPE2@@
(XrP | null)[]
// @@PROOF2@@
print("\{v == xrEq} \{v != xrEq}")
// @@WANT2@@
false true
