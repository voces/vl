// A `let` of an `if` choosing between two generic functions, written with the same `if`, then
// delivered after the write at each position and called at a type no peer is; a peer binding of
// one of the generics is called at another type first (D10321).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function idg<T>(t: T): T { return t }
function kg<T>(t: T): T { return t + t }
function app<T>(g: (x: T) => T, v: T): T { return g(v) }
let c = [1, 2].length
const p = idg
const i0 = p(3)
let h = if c > 1 { kg } else { idg }
c = [1].length
h = if c > 1 { kg } else { idg }
// @@VALUE@@
h(1.5) + 1.0
// @@TYPE@@
f64
// @@PROOF@@
if i0 == 3 { print(v * 2.0) } else { print(0.0) }
// @@WANT@@
5
// @@VALUE2@@
app(h, "z")
// @@TYPE2@@
string
// @@PROOF2@@
print(v.length * 10 + i0)
// @@WANT2@@
13
