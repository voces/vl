// D11160 — a three-member union list ELEMENT read while narrowed to the two-member
// `i32 | null` box. The binding holds that smaller box, so the proof's `!= null` must leave
// exactly `i32` at every position; read under the element's whole union it leaves `i32 | string`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@SETUP@@
const __xs: (i32 | null | string)[] = [3]
// @@GUARD@@
!(__xs[0] is string)
// @@VALUE@@
__xs[0]
// @@TYPE@@
i32 | null
// @@FALLBACK@@
null
// @@TEST@@
v != null
// @@HIT@@
print(v + 1)
// @@MISS@@
print(0)
// @@WANT@@
4
