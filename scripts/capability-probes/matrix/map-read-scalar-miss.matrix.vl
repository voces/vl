// D2466 — a MISS on a bare scalar-valued map read `m[k]` is `null` at every delivery. The
// read's type is `i32 | null`, but an i32 has no spare bit, so a consumer that classified the
// read by its rep printed the probe's empty value `0` instead of `null`.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
const gm: {[string]: i32} = Map()
gm["a"] = 3
const gf: {[string]: f64} = Map()
gf["a"] = 1.5
// @@VALUE@@
gm["zz"]
// @@TYPE@@
i32 | null
// @@TEST@@
v == null
// @@HIT@@
print("null")
// @@MISS@@
print(v)
// @@WANT@@
null
// @@VALUE2@@
gf.get("zz")
// @@TYPE2@@
f64 | null
// @@PROOF2@@
print(v)
// @@WANT2@@
null
