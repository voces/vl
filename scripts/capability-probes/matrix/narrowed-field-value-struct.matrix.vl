// D2235 — a narrowed nullable list FIELD delivered as a value, P elements: the
// receiver rows' control. The proof pushes, index-stores, reads `.length` and iterates, so
// every list operation is graded on the delivered value at every position.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type P = { x: i32 }
// @@SETUP@@
const __r: { f: P[] | null } = { f: [{ x: 1 }] }
// @@GUARD@@
__r.f != null
// @@VALUE@@
__r.f
// @@TYPE@@
P[]
// @@FALLBACK@@
[{ x: 1 }]
// @@TEST@@
v.length > 0
// @@HIT@@
v.push({ x: 2 })
v[0] = { x: 2 }
let __n = 0
for __x in v {
  __n = __n + 1
}
print(__n == v.length && __n > 1)
// @@MISS@@
print(false)
// @@WANT@@
true
