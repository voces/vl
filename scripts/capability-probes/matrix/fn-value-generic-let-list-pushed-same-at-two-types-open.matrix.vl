// A generic function delivered to each position, then put in a `let` list that is pushed the same
// generic and called through the pushed element at TWO types, so the value stays open. No function
// type spells that, so the annotated face refuses by design; the un-annotated face calls each
// type's instance, as the `const` list does (D10300).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function id<T>(x: T): T { x }
// @@VALUE@@
id
// @@TYPE@@
(x: i32) => i32
// @@PROOF@@
let __ws = [v]
__ws.push(id)
__ws[1]("w")
print(__ws[1](7))
// @@WANT@@
7
