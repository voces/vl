// A list of lists of functions with an un-annotated parameter, written inline, its inner elements
// read back and called at two types, so the parameter stays open; each read names its generic
// (D9711).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __inc(a) { return a + 1 }
// @@VALUE@@
[[__inc], [__inc]]
// @@TYPE@@
((a: i32) => i32)[][]
// @@PROOF@@
const __n = v[0][0](3)
const __f = v[1][0](2.5)
if __n == 4 { print(__f) } else { print("wrong i32 read") }
// @@WANT@@
3.5
// @@TEST@@
v.length == 2
// @@HIT@@
const __n = v[0][0](3)
const __f = v[1][0](2.5)
if __n == 4 { print(__f) } else { print("wrong i32 read") }
// @@MISS@@
print(0)
