// A binding of an un-annotated lambda, delivered as a value at a function type whose result is
// its own `i32` widened to `i32 | null` (D15897): every call reaches the closure the lambda is
// built at. The second value is another such binding.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
const __dbl = (a) => a * 2
const __inc = (a) => a + 1
// @@VALUE@@
__dbl
// @@TYPE@@
(a: i32) => i32 | null
// @@PROOF@@
const __r: i32 | null = v(5)
print(__r ?? 0)
// @@WANT@@
10
// @@VALUE2@@
__inc
// @@TYPE2@@
(a: i32) => i32 | null
// @@PROOF2@@
const __r2: i32 | null = v(6)
print(__r2 ?? 0)
// @@WANT2@@
7
