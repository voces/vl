// D16016 — a member written into a union-typed element with a computed index, used as a value:
// the assignment yields the member's own value at every delivery position, and the list holds it.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
const uw: (i32 | string)[] = [1, "a"]
let uwi = 1
// @@VALUE@@
(uw[uwi] = 5)
// @@TYPE@@
i32
// @@PROOF@@
print(v * 10 + (if uw[1] is i32 { uw[1] } else { 0 }))
// @@WANT@@
55
// @@SKIP@@
is_in_if: the value is an i32, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
// @@CELL_string_member@@
// want: zz!
const v = (uw[uwi] = "zz") + "!"
print(v)
// @@CELL_union_map_entry@@
// want: 77
const um: {[string]: i32 | string} = Map()
let umk = "a"
const v__A__ = (um[umk] = 7)
print(v * 10 + (if um["a"] is i32 { um["a"] } else { 0 }))
// @@CELL_rowless_record_field@@
// want: 33
type UwNode = { v: i32, left: UwNode | null }
const uroot: UwNode = { v: 5, left: null }
function uwShow(n: UwNode): i32 { return n.v }
const v__A__ = uwShow(uroot.left = { v: 3, left: null })
print(v * 10 + (uroot.left?.v ?? 0))
