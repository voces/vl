// D1729 — the COMPLEMENT of a literal `is` (`else` of `v is "err"` over `i32 | "err"`),
// proved at the delivery place rather than through a binding of it. The literal member is
// gone from the emitter's member set by the time the complement rungs subtract from it, so
// they push the whole softened set back and there is no atom left to unbox to.
//
// The proof is deliberately in MISS, not HIT: the tested arm is the string and the arm the
// use needs is the surviving `i32`. The direct spelling (`v is i32`) ran throughout, which
// is what makes this the complement's own rung and not the place's.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function mk(b: boolean): i32 | "err" {
  if b { return "err" }
  return 5
}
// @@VALUE@@
mk(false)
// @@TYPE@@
i32 | "err"
// @@TEST@@
v is "err"
// @@HIT@@
print(0)
// @@MISS@@
print(v * 2)
// @@WANT@@
10
