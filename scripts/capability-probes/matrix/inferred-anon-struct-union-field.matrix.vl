// D1242 — an ANONYMOUS struct literal whose field holds a UNION value, delivered everywhere.
// The annotated face spells the destination `{ f: i32 | null }` and runs; the un-annotated
// face leaves inference to pin it, and the emitter takes the union-box route with no variant
// to match. The rescue is a `type` DECLARATION of the same shape, not the annotation — so
// this template must never declare one, or every cell goes green for the wrong reason.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function mkU(bad: boolean): i32 | null {
  if bad { return null }
  return 5
}
// @@VALUE@@
{ f: mkU(false) }
// @@TYPE@@
{ f: i32 | null }
// @@PROOF@@
print(v.f ?? 0)
// @@WANT@@
5
// @@VALUE2@@
{ f: mkU(false) }
// @@TYPE2@@
{ f: i32 | null }
// @@PROOF2@@
print((v.f ?? 0) + 1)
// @@WANT2@@
6
// @@SKIP@@
is_in_if: the value is a struct, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
