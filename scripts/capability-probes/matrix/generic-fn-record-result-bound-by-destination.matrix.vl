// A generic whose result is a record holding a function at its type parameter, bound only by
// the destination. Cells: two fields at two type parameters, a list of records, and a record
// literal argument holding the generic function (D16590).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function gid<A>(x: A): A { return x }
function boxf<A>(f: (x: A) => A): { f: (x: A) => A } { return { f: f } }
// @@VALUE@@
boxf(gid)
// @@TYPE@@
{ f: (x: f64) => f64 }
// @@PROOF@@
print(v.f(1.5))
// @@WANT@@
1.5
// @@CELL_two_fields@@
// want: 1.5 then s
function pair<A, B>(f: (x: A) => A, g: (x: B) => B): { f: (x: A) => A, g: (x: B) => B } { return { f: f, g: g } }
const k: { f: (x: f64) => f64, g: (x: string) => string } = pair(gid, gid)
print(k.f(1.5))
print(k.g("s"))
// @@CELL_list_of_records@@
// want: 1.5
function boxes<A>(f: (x: A) => A): { f: (x: A) => A }[] { return [{ f: f }] }
const k: { f: (x: f64) => f64 }[] = boxes(gid)
print(k[0].f(1.5))
// @@CELL_record_arg@@
// want: 1.5
function unbox<A>(r: { f: (x: A) => A }): (x: A) => A { return r.f }
const k: (x: f64) => f64 = unbox({ f: gid })
print(k(1.5))
