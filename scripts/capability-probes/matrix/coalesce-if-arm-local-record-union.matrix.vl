// `(if c { const t = v; t?.tag } else { null }) ?? "z"`: the coalesced `if` declares a local
// in the arm whose `?.` read is its value (D5333).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type N = { tag: "a", v: i32 } | { tag: "b", w: i32 }
function mk(a: boolean): N | null {
  if a { return null }
  { tag: "b", w: 2 }
}
// @@VALUE@@
mk(false)
// @@TYPE@@
N | null
// @@PROOF@@
print((if true { const t = v; t?.tag } else { null }) ?? "z")
// @@WANT@@
b
// @@VALUE2@@
mk(true)
// @@TYPE2@@
N | null
// @@PROOF2@@
const a = if true { const t = v; t?.tag } else { null }
print(a ?? "z")
// @@WANT2@@
z
