// D16024: an un-annotated function returning a `string[]` or a `{[string]: i32}` infers the union string[] | {[string]: i32}, which must
// lower as its annotated twin does. The value is the map arm; the second instance is the
// list arm.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type S = { n: i32 }
function k(n: i32) { n }
function pick(c: i32) {
  if c == 1 { return ["x", "y"] }
    const m: {[string]: i32} = Map()
  m["a"] = k(5)
  return m
}
// @@VALUE@@
pick(k(0))
// @@TYPE@@
string[] | {[string]: i32}
// @@WANT@@
5
// @@TEST@@
v is string[]
// @@HIT@@
print("list")
// @@MISS@@
print(v["a"] ?? 0)
// @@VALUE2@@
pick(k(1))
// @@TYPE2@@
string[] | {[string]: i32}
// @@PROOF2@@
if v is string[] { print(v[1]) } else { print("map") }
// @@WANT2@@
y
