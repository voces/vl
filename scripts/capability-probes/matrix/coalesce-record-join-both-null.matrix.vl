// D2373's both-null case at every position: a `??` joining two nullable records of different
// types whose operands are both null. The box carries the null tag, so neither arm test may
// answer true; a row minted one slot off answered `is A` from a null.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@SKIP@@
map_value: the builder guards its read with `!= null`, and this template's value is null by
design, so the guarded body never runs
map_value_place: the same `!= null` guard as `map_value`
// @@PRELUDE@@
type A = { r: i32 }
type B = { q: string }
type C = { z: f64 }
function mkA(): A | null { return null }
function mkN(): B | null { return null }
// @@VALUE@@
mkA() ?? mkN()
// @@TYPE@@
A | B | null
// @@TEST@@
v is A || v is B
// @@HIT@@
print("arm")
// @@MISS@@
print("none")
// @@WANT@@
none
