// D15055: `==` between a list of `i32 | null` (union boxes) and an `i32[]` (plain numbers) reads
// each side at its own storage and compares element by element: a null is no number. The second
// instance holds a null.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function xrMk(n: boolean): (i32 | null)[] {
  if n { return [1, null] }
  return [1, 2]
}
function xrPlain(a: i32, b: i32): i32[] { [a, b] }
const xrEq: i32[] = xrPlain(1, 2)
const xrNe: i32[] = xrPlain(1, 3)
// @@VALUE@@
xrMk(false)
// @@TYPE@@
(i32 | null)[]
// @@TEST@@
v == xrEq && v != xrNe
// @@HIT@@
print("value")
// @@MISS@@
print("storage")
// @@WANT@@
value
// @@VALUE2@@
xrMk(true)
// @@TYPE2@@
(i32 | null)[]
// @@PROOF2@@
print("\{v == xrEq} \{v != xrEq}")
// @@WANT2@@
false true
