// D2246 — an if-expression whose arms are `u8[]` values. The join's blocktype ladder had no
// packed byte-list rung, so the join took the i32-list (or i32) blocktype over a `u8[]` value:
// check-clean invalid wasm at every position.
//
// The proof prints an element, which a join at the i32-list rep could not have read.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
const bytesA: u8[] = [200, 1]
const bytesB: u8[] = []
const pick = true
// @@VALUE@@
if pick { bytesA } else { bytesB }
// @@TYPE@@
u8[]
// @@FALLBACK@@
bytesB
// @@PROOF@@
print(v[0])
// @@WANT@@
200
// @@VALUE2@@
if !pick { bytesA } else { bytesB }
// @@TYPE2@@
u8[]
// @@PROOF2@@
print(v.length)
// @@WANT2@@
0
