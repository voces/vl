// D3298: an alias whose body is a list of a nullable record, delivered at every position and read
// by its length and a narrowed element. Every cell prints `24`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type H = { v: i32 }
type R = (H | null)[]
// @@VALUE@@
[{ v: 4 }, null]
// @@TYPE@@
R
// @@PROOF@@
const e = v[0]
if e != null { print(v.length * 10 + e.v) }
// @@WANT@@
24
// @@SKIP@@
is_in_if: the value is a list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
