// D16799: a generic maker returns a hole lambda reading its parameter, and its calls deliver the
// result at two function types whose results differ, or pin it at two type arguments. Each call
// builds a fresh closure at the instance it pins, so the design owes every delivery.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __gadd<T>(n: T) { return (a) => a + n }
// @@VALUE@@
__gadd(2)
// @@TYPE@@
(a: i32) => i32
// @@PROOF@@
print(v(3))
// @@WANT@@
5
// @@VALUE2@@
__gadd(2)
// @@TYPE2@@
(a: i32) => f64
// @@PROOF2@@
print(v(3) / 8.0)
// @@WANT2@@
0.625
// @@CELL_two_pins@@
// want: 5 then 3.5
const __gv = __gadd(2)
print(__gv(3))
const __gx = __gadd(1.5)
print(__gx(2.0))
// @@CELL_two_pins_f64_first@@
// want: 3.5 then 5
const __gx = __gadd(1.5)
print(__gx(2.0))
const __gv = __gadd(2)
print(__gv(3))
// @@CELL_two_pins_annotated@@
// want: 5 then 3.5
const __gv: (a: i32) => i32 = __gadd(2)
print(__gv(3))
const __gx: (a: f64) => f64 = __gadd(1.5)
print(__gx(2.0))
// @@CELL_lambda_bound_first@@
// want: 5 then 3.5
function __gloc<T>(n: T) {
  const f = (a) => a + n
  return f
}
const __gv = __gloc(2)
print(__gv(3))
const __gx = __gloc(1.5)
print(__gx(2.0))
// @@CELL_param_annotated_t@@
// want: 5 then 3.5
function __gann<T>(n: T) { return (a: T) => a + n }
const __gv = __gann(2)
print(__gv(3))
const __gx = __gann(1.5)
print(__gx(2.0))
// @@CELL_explicit_type_args@@
// want: 5 then 3.5
const __gv = __gadd<i32>(2)
print(__gv(3))
const __gx = __gadd<f64>(1.5)
print(__gx(2.0))
// @@CELL_result_widens@@
// want: 0.625
const __gv = __gadd(2)
print(__gv(3) / 8.0)
// @@CELL_unbound_wider_pin@@
// want: 5
function __gcap<T>(n: T) { return () => n }
__gcap(2.5)
const __gw = __gcap(5)
print(__gw())
// @@CELL_unbound_wider_pin_hole@@
// want: 8
function __hadd(n) { return (a) => a + n }
const _hv = __hadd(2.5)
const __hw = __hadd(5)
print(__hw(3))
