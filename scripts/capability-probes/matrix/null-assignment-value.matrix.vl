// An assignment of `null` used as a value, at every delivery position: the value is the `null`
// unit and the assignment stores, so the proof reads the value and the cell it wrote (D17088,
// D17090).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
let __gs: string | null = "a"
// @@VALUE@@
(__gs = null)
// @@TYPE@@
null
// @@PROOF@@
print(v == null)
print(__gs == null)
// @@WANT@@
true then true
