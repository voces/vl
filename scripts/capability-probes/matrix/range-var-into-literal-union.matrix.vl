// D2065 — a constant-range loop variable delivered where a literal union holding its whole
// interval is expected. The built-in positions deliver the literal `2` (a control); the cells
// deliver the loop variable, and the `owed:` cells are the refusals the ruling keeps.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type Lane4 = 0 | 1 | 2 | 3
function take(x: Lane4): i32 { return x }
// @@VALUE@@
2
// @@TYPE@@
Lane4
// @@PROOF@@
print(v)
// @@WANT@@
2
// @@CELL_arg@@
// want: 6
let s = 0
for i in 0 until 4 { s = s + take(i) }
print(s)
// @@CELL_let_annotated@@
// want: 6
let s = 0
for i in 0 until 4 {
  const l: Lane4 = i
  s = s + l
}
print(s)
// @@CELL_let_reassigned@@
// want: 3
let l: Lane4 = 0
for i in 0 until 4 { l = i }
print(l)
// @@CELL_return@@
// want: 2
function pick(): Lane4 {
  for i in 0 until 4 { if i == 2 { return i } }
  return 0
}
print(pick())
// @@CELL_record_field@@
// want: 3
let r: { l: Lane4 } = { l: 0 }
for i in 0 until 4 { r = { l: i } }
print(r.l)
// @@CELL_list_element@@
// want: 4
const xs: Lane4[] = []
for i in 0 until 4 { xs.push(i) }
print(xs.length)
// @@CELL_list_literal@@
// want: 3
let xs: Lane4[] = []
for i in 0 until 4 { xs = [i] }
print(xs[0])
// @@CELL_nullable_dst@@
// want: 3
let l: Lane4 | null = null
for i in 0 until 4 { l = i }
print(l ?? 0)
// @@CELL_union_with_string@@
// want: 3
let l: Lane4 | "none" = "none"
for i in 0 until 4 { l = i }
if l is "none" { print(9) } else { print(l) }
// @@CELL_paren@@
// want: 6
let s = 0
for i in 0 until 4 { s = s + take((i)) }
print(s)
// @@CELL_inclusive_to@@
// want: 6
let s = 0
for i in 0 to 3 { s = s + take(i) }
print(s)
// @@CELL_step@@
// want: 2
let s = 0
for i in 0 until 4 step 2 { s = s + take(i) }
print(s)
// @@CELL_reversed@@
// want: 6
let s = 0
for i in 3 to 0 step -1 { s = s + take(i) }
print(s)
// @@CELL_const_bounds@@
// want: 6
const LO = 0
const HI = 4
const N = HI
let s = 0
for i in LO until N { s = s + take(i) }
print(s)
// @@CELL_sub_interval@@
// want: 3
let s = 0
for i in 1 until 3 { s = s + take(i) }
print(s)
// @@CELL_in_function@@
// want: 6
function sum(): i32 {
  let s = 0
  for i in 0 until 4 { s = s + take(i) }
  return s
}
print(sum())
// @@CELL_arith_decays@@
// want: 10
let s = 0
for i in 0 until 4 { s = s + i + 1 }
print(s)
// @@CELL_data_bounded@@
// owed: expected Lane4, got i32
function f(n: i32): i32 {
  let s = 0
  for i in 0 until n { s = s + take(i) }
  return s
}
print(f(4))
// @@CELL_interval_too_wide@@
// owed: expected Lane4, got i32
let s = 0
for i in 0 until 5 { s = s + take(i) }
print(s)
// @@CELL_written_in_body@@
// owed: expected Lane4, got i32
let s = 0
for i in 0 until 4 {
  s = s + take(i)
  i = 7
}
print(s)
// @@CELL_zero_trip@@
// owed: expected Lane4, got i32
let s = 0
for i in 2 until 2 { s = s + take(i) }
print(s)
// @@CELL_let_bound@@
// owed: expected Lane4, got i32
let hi = 4
let s = 0
for i in 0 until hi { s = s + take(i) }
print(s)
// @@CELL_const_alias@@
// want: 6
let s = 0
for i in 0 until 4 {
  const j = i
  s = s + take(j)
}
print(s)
// @@CELL_const_alias_transitive@@
// want: 6
let s = 0
for i in 0 until 4 {
  const j = i
  const k = (j)
  s = s + take(k)
}
print(s)
// @@CELL_const_alias_annotated_i32@@
// owed: expected Lane4, got i32
let s = 0
for i in 0 until 4 {
  const j: i32 = i
  s = s + take(j)
}
print(s)
