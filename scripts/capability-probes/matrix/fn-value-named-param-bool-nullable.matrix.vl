// D9824: a named function whose parameter is `boolean | null`, delivered where a function of
// that parameter is expected, and called with a boolean and with a bare `null`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function g(p: boolean | null): i32 {
  if p == null { return 5 }
  if p { return 1 }
  0
}
// @@VALUE@@
g
// @@TYPE@@
(p: boolean | null) => i32
// @@PROOF@@
print(v(true) * 100 + v(false) * 10 + v(null))
// @@WANT@@
105
