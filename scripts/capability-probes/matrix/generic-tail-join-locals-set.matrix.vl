// D2186 — a generic whose tail `if` joins two LOCALS of its type parameter, which the checker
// types as `T | T`; the instance's result fell to `i32`. `T` is left open: the argument binds it.
// VALUE2 joins the parameters themselves.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type P = { p: i32 }
function __mkm(n: i32): {[string]: i32} {
  const m: {[string]: i32} = Map()
  m["k"] = n
  m
}
function __mks(n: i32): Set<i32> {
  const s: Set<i32> = Set()
  s.add(n)
  s
}
function __join<T>(c: boolean, x: T, y: T) {
  const a = x
  const b = y
  if c { a } else { b }
}
function __joinp<T>(c: boolean, x: T, y: T) { if c { x } else { y } }
// @@VALUE@@
__join(true, __mks(1), __mks(2))
// @@TYPE@@
Set<i32>
// @@PROOF@@
print(v.has(1))
// @@WANT@@
true
// @@VALUE2@@
__joinp(true, __mks(1), __mks(2))
// @@TYPE2@@
Set<i32>
// @@PROOF2@@
print(v.has(1))
// @@WANT2@@
true
