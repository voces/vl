// `==` in a generic body over a call operand of two records of one field set stored apart, the
// result delivered at every position: the call runs once into a fresh binding, which then
// compares field by field at the instance (D16470).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __id<T>(x: T): T { return x }
function __eqc<T, U>(a: T, b: U): boolean { return __id(a) == b }
// @@VALUE@@
__eqc({ f: 1 }, { f: 1.0 })
// @@TYPE@@
boolean
// @@TEST@@
v
// @@HIT@@
print(1)
// @@MISS@@
print(0)
// @@WANT@@
1
// @@CELL_call_right@@
// want: true then false
function __eqr<T, U>(a: T, b: U): boolean { return a == __id(b) }
print(__eqr({ f: 1 }, { f: 1.0 }))
print(__eqr({ f: 1 }, { f: 2.0 }))
// @@CELL_call_both@@
// want: true
function __eqb<T, U>(a: T, b: U): boolean { return __id(a) == __id(b) }
print(__eqb({ f: 1, g: 2 }, { f: 1.0, g: 2.0 }))
// @@CELL_not_equal@@
// want: false then true
function __nec<T, U>(a: T, b: U): boolean { return __id(a) != b }
print(__nec({ f: 1 }, { f: 1.0 }))
print(__nec({ f: 1 }, { f: 3.0 }))
// @@CELL_runs_once@@
// want: 1 then true
let __n = 0
function __tick<T>(x: T): T {
  __n = __n + 1
  return x
}
function __eqt<T, U>(a: T, b: U): boolean { return __tick(a) == b }
const __r = __eqt({ f: 1, g: 2, h: 3 }, { f: 1.0, g: 2.0, h: 3.0 })
print(__n)
print(__r)
// @@CELL_nested_record@@
// want: true then false
print(__eqc({ f: 1, g: { h: 2 } }, { f: 1.0, g: { h: 2.0 } }))
print(__eqc({ f: 1, g: { h: 2 } }, { f: 1.0, g: { h: 3.0 } }))
// @@CELL_nullable_record@@
// want: true then false then true
const __x: { f: i32 } | null = { f: 1 }
const __y: { f: f64 } | null = { f: 1.0 }
const __z: { f: f64 } | null = null
const __w: { f: i32 } | null = null
print(__eqc(__x, __y))
print(__eqc(__x, __z))
print(__eqc(__w, __z))
// @@CELL_field_of_call@@
// want: true
function __eqm<T, U>(a: {v: T}, b: U): boolean { return __id(a).v == b }
print(__eqm({ v: { f: 1 } }, { f: 1.0 }))
