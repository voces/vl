// A literal-union value narrowed to one string member by a literal test, out of a set that also
// holds `null`, joined into a string: the joined value is a string at every position, the member
// reading back as its own text though the value is held as the wider set's atom.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function pick(b: boolean): "ss" | "tt" | null {
  if b { return "tt" }
  return null
}
const x = pick(true)
// @@VALUE@@
x + "!"
// @@TYPE@@
string
// @@GUARD@@
x is "tt"
// @@FALLBACK@@
"O"
// @@PROOF@@
print(v)
// @@TEST@@
v == "tt!"
// @@HIT@@
print(v)
// @@MISS@@
print("miss")
// @@WANT@@
tt!
// @@CELL_union_param_argument@@
function show(s: string | i32) { if s is string { print(s) } else { print("i32") } }
if x is "tt" { show(__V__) }
// @@CELL_nested_call_argument@@
function id(s: string): string { return s }
if x is "tt" { print(id(id(__V__))) }
// @@CELL_concat_operand@@
// want: <tt!
if x is "tt" { print("<" + __V__) }
// @@CELL_concat_right_part@@
// want: <tt
if x is "tt" { print("<" + x) }
// @@CELL_interpolation_hole@@
// want: [tt]
if x is "tt" { print("[\{x}]") }
// @@CELL_if_arm_value@@
const t = pick(false)
if x is "tt" { const w = if t == null { __V__ } else { "O" }; print(w) }
// @@CELL_coalesce_operand@@
const n: string | null = if x == null { "O" } else { null }
if x is "tt" { print(n ?? __V__) }
// @@CELL_record_field@@
if x is "tt" { const r = { s: __V__ }; print(r.s) }
