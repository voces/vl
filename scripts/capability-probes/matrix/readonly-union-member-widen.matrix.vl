// D2999 — a `(string | i32)[]` delivered where a `readonly (string | i64)[]` is declared. The
// destination holds the `i32` member only widened, so the list is copied with each box rebuilt
// under the `i64` tag; shared, a read of the element as `i64` casts the `i32` box and traps.
//
// The list is built from a CALL so no position can re-box a literal element. The proof reads
// the element through its non-string arm and adds one, which only a rebuilt box survives.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function rumJoin(c: boolean): string | i32 {
  if c { return "b" }
  return 7
}
// @@SETUP@@
const rumL: (string | i32)[] = [rumJoin(false)]
const rumM: (string | i32)[] = [rumJoin(true)]
// @@VALUE@@
rumL
// @@TYPE@@
readonly (string | i64)[]
// @@PROOF@@
const e = v[0]
if e is string { print(e) } else { print(e + 1) }
// @@WANT@@
8
// @@VALUE2@@
rumM
// @@TYPE2@@
readonly (string | i64)[]
// @@PROOF2@@
const e = v[0]
if e is string { print(e) } else { print(e + 1) }
// @@WANT2@@
b
