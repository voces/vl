// D2245 — a function boxes its own local `r` into a `i32[] | Err` return while a top-level
// block binds another `r: Err | null`. The nullable-variant classifier consulted the module
// block's bindings by name without asking whether the function binds the name itself, so the
// list was boxed under `Err`'s tag and `is Err` answered true for it.
//
// The proof prints the list's length, which a value tagged `Err` would not reach.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type Err = { code: i32, msg: string }
function readAll(): i32[] | Err {
  const r: i32[] = [1, 2, 3]
  r
}
function readParam(r: i32[]): i32[] | Err { r }
if true {
  const r: Err | null = null
  if r != null { print(r.msg) }
}
// @@VALUE@@
readAll()
// @@TYPE@@
i32[] | Err
// @@FALLBACK@@
readAll()
// @@TEST@@
v is Err
// @@HIT@@
print("err")
// @@MISS@@
print(v.length)
// @@WANT@@
3
// @@VALUE2@@
readParam([4, 5])
// @@TYPE2@@
i32[] | Err
// @@PROOF2@@
if v is Err { print("err") } else { print(v.length) }
// @@WANT2@@
2
// @@SKIP@@
map_value: an un-annotated `Map()` holding this union is invalid wasm with no module block at all, a separate defect
map_value_place: the same un-annotated `Map()` carrier, independent of the shadowing
