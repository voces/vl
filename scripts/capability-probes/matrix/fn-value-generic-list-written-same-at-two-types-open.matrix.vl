// A generic function delivered to each position, put in a list whose element is then written
// with the same generic, and called through the element at TWO types, so the value stays open.
// No function type spells that, so the annotated face refuses by design; the un-annotated face
// calls each type's instance (D10340).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function id<T>(x: T): T { x }
// @@VALUE@@
id
// @@TYPE@@
(x: i32) => i32
// @@PROOF@@
const __ws = [v]
__ws[0] = id
__ws[0]("w")
print(__ws[0](7))
// @@WANT@@
7
