// D3140 — the `K | null` niche delivered where `string | null` is expected: the `-1` sentinel is
// the null ref and any other id its member string. The widening tower had no null arm, so every
// position refused (`literal-union string widening with no members`) until the niche widen.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type K = "ka" | "kb"
function kn(b: boolean): K | null {
  if b { return "kb" }
  return null
}
// @@VALUE@@
kn(false)
// @@TYPE@@
string | null
// @@TEST@@
v == null
// @@HIT@@
print("N")
// @@MISS@@
print("other")
// @@WANT@@
N
// @@VALUE2@@
kn(true)
// @@TYPE2@@
string | null
// @@PROOF2@@
print(v ?? "N")
// @@WANT2@@
kb
