// D10164 — a value of `T[] | i32` handed to a generic whose body first tests `is string[]`,
// which the pin can make dead, then returns the `is i32` arm early before a literal tail. Every
// return is an `i32`, so the call is an `i32` and the proof binds it to one; the instance's
// return must not be the union box.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function f<T>(x: T[] | i32) {
  if x is string[] { return 1 }
  if x is i32 { return x }
  5
}
// @@VALUE@@
3
// @@TYPE@@
i32[] | i32
// @@PROOF@@
const r: i32 = f(v)
print(r)
// @@WANT@@
3
// @@VALUE2@@
["a"]
// @@TYPE2@@
string[] | i32
// @@PROOF2@@
const r: i32 = f(v)
print(r)
// @@WANT2@@
1
