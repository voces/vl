// A5 / D1814 — the optional call whose receiver is a MAP READ, the one receiver kind the
// guard DECLINES. A narrowed map read inside an if-expression bound to a local is check-clean
// invalid wasm on its own (D1827), so the desugar excludes it exactly as the `??` desugar
// does and the call keeps a loud emit refusal.
//
// Every cell here is expected to refuse today. It is the standing guard on that decline: a
// cell that comes back SILENT is D1827 being reached, and a cell that RUNS means D1827 closed
// and this exclusion can go.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type P = { n: i32 }
function twice(self: P) { self.n * 2 }
const m: {[string]: P} = Map()
m["k"] = { n: 21 }
// @@VALUE@@
m["k"]?.twice()
// @@TYPE@@
i32 | null
// @@FALLBACK@@
null
// @@PROOF@@
print(v ?? 0)
// @@WANT@@
42
