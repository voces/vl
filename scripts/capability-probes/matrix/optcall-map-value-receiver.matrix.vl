// A5 / D1814 — the optional call whose receiver is a MAP READ. The guard declined this
// receiver kind while a map read inside an if-expression reserved no scratch frame (D1827);
// with that closed the exclusion is gone and every cell runs.
//
// It stays the standing guard on the pair: a cell that comes back SILENT is D1827 returning,
// and one that REFUSES is the exclusion having crept back.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type P = { n: i32 }
function twice(self: P) { self.n * 2 }
const m: {[string]: P} = Map()
m["k"] = { n: 21 }
// @@VALUE@@
m["k"]?.twice()
// @@TYPE@@
i32 | null
// @@FALLBACK@@
null
// @@PROOF@@
print(v ?? 0)
// @@WANT@@
42
