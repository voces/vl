// D1668 — an if-expression whose arms are a concrete union ARM. `ifExprRefKind` classifies
// the join's blocktype from the deciding arm and had a `variant` rung only inside its
// nullable half, so a non-null arm answered no to every ref predicate and the join fell to
// the numeric blocktype: `if (result i32)` over `(ref $uVarHeap)` arms.
//
// The union declaration is the ingredient — with it, the arm value classifies as a variant
// and `structIndexOfExpr` declines; without it the same program is a plain struct join.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type P = { x: i32 }
type Q = { y: i32 }
type UU = P | Q
const p: P = { x: 1 }
function useUU(u: UU): i32 {
  if u is P { return u.x }
  0
}
const seen = useUU(p)
// @@VALUE@@
if seen == 1 { p } else { p }
// @@TYPE@@
P
// @@FALLBACK@@
p
// @@TEST@@
v.x == 1
// @@HIT@@
print(1)
// @@MISS@@
print(-1)
// @@WANT@@
1
