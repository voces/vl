// D16845, D17045: a maker returns a hole lambda it creates, and one call's value is held and
// called at two signatures. The design owes a closure per signature, its captures taken once.
// The annotated face spells one signature.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __mk() { return (a) => a + 1 }
function __mkd() { return (a) => a * 2 }
// @@VALUE@@
__mk()
// @@TYPE@@
(x: f64) => f64
// @@PROOF@@
print("\{v(4)} \{v(1.5)}")
// @@WANT@@
5 2.5
// @@TEST@@
v(4) == 5
// @@HIT@@
print("\{v(4)} \{v(1.5)}")
// @@MISS@@
print(0)
// @@VALUE2@@
__mkd()
// @@TYPE2@@
(x: f64) => f64
// @@PROOF2@@
print("\{v(4)} \{v(1.5)}")
// @@WANT2@@
8 3
