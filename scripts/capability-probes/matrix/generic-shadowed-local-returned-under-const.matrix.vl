// D10165 — a generic returns an inner `let x` that shadows an outer literal `const x = 7`.
// The return set at the pin re-checked each return after the body's scopes closed, so the
// returned `x` read the outer `const` and was rewritten in place into its literal: invalid
// wasm for a record, and the wrong value (`7`) for an `f64`. The type argument is explicit
// here; generic-shadowed-local-returned-under-const-open leaves it to inference.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type R = { a: i32, b: string }
function __pick<T>(w: T) {
  const x = 7
  if true {
    let x = w
    return x
  }
  w
}
function __pickf<T>(w: T, c: boolean) {
  const x = 7
  if c {
    let x = 2.5
    return x
  }
  1.5
}
// @@VALUE@@
__pick<R>({ a: 1, b: "r" })
// @@TYPE@@
R
// @@PROOF@@
print(v.b)
// @@TEST@@
v.a > 0
// @@HIT@@
print(v.b)
// @@MISS@@
print("miss")
// @@WANT@@
r
// @@VALUE2@@
__pickf<string>("s", true)
// @@TYPE2@@
f64
// @@PROOF2@@
print(v)
// @@WANT2@@
2.5
