// D16949: a field read across record arms whose shared field is a record in one arm and an atom
// in another (`({f: i32} | {f: {a: boolean}}).f`). The read is the union of the arms' fields, and
// the record arm boxes under its arm of that union beside the atom arms.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function pick(b: boolean): {f: i32} | {f: {a: boolean}} {
  if b { return { f: 5 } }
  return { f: { a: true } }
}
// @@VALUE@@
pick(false).f
// @@TYPE@@
i32 | {a: boolean}
// @@PROOF@@
if v is i32 { print(v) } else { print(v.a) }
// @@WANT@@
true
// @@TEST@@
v is {a: boolean}
// @@HIT@@
print(v.a)
// @@MISS@@
print(0)
// @@CELL_atom_arm_read@@
// want: 5
const z = pick(true)
const v = z.f
if v is i32 { print(v) } else { print(v.a) }
// @@CELL_field_receiver@@
// want: true
const w = { z: pick(false) }
const v = w.z.f
if v is i32 { print(v) } else { print(v.a) }
// @@CELL_string_arm@@
// want: s then 7
function q(b: boolean): {f: string} | {f: {a: i32}} {
  if b { return { f: "s" } }
  return { f: { a: 7 } }
}
for b in [true, false] {
  const v = q(b).f
  if v is string { print(v) } else { print(v.a) }
}
// @@CELL_f64_arm_nullable_receiver@@
// want: 2.5
function q(b: boolean): {f: f64} | {f: {a: boolean}} | null {
  if b { return { f: 2.5 } }
  return null
}
const z = q(true)
if z != null {
  const v = z.f
  if v is f64 { print(v) } else { print(v.a) }
}
// @@CELL_three_arms@@
// want: x
function q(b: boolean): {f: i32} | {f: {a: boolean}} | {f: {b: string}} {
  if b { return { f: 5 } }
  return { f: { b: "x" } }
}
const v = q(false).f
if v is i32 { print(v) } else if v is {a: boolean} { print(v.a) } else { print(v.b) }
// @@CELL_narrowed_set@@
// want: true
function q(n: i32): {f: i32, k: i32} | {f: {a: boolean}, k: i32} | {g: i32, k: i32} {
  if n == 0 { return { f: 5, k: 0 } }
  if n == 1 { return { f: { a: true }, k: 1 } }
  return { g: 2, k: 2 }
}
const z = q(1)
if !(z is {g: i32, k: i32}) {
  const v = z.f
  if v is i32 { print(v) } else { print(v.a) }
}
// @@CELL_list_arm@@
// want: 2
function q(b: boolean): {f: i32} | {f: i32[]} {
  if b { return { f: 5 } }
  return { f: [1, 2] }
}
const v = q(false).f
if v is i32 { print(v) } else { print(v.length) }
