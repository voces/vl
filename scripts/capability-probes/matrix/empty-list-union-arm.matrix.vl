// D2202 — an empty `[]` delivered to a union whose only list arm is a ref list (`P[] | B`) or a
// string list (VALUE2, `string[] | B`). Every empty literal classifies `i32[]`, so without the
// rung it was tagged and built as a list the union has no arm for. It is built as the list arm
// the checker adopted it as. The un-annotated face refuses at `const v = []`, by design.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type P = { x: i32 }
type B = { base: i32, length: i32 }
// @@VALUE@@
[]
// @@TYPE@@
P[] | B
// @@TEST@@
v is B
// @@HIT@@
print("B")
// @@MISS@@
print(v.length)
// @@WANT@@
0
// @@VALUE2@@
[]
// @@TYPE2@@
string[] | B
// @@PROOF2@@
if v is B { print("B") } else { print(v.length) }
// @@WANT2@@
0
