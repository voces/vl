// D17064 — an operator whose left operand is a call that never returns, beside an f64 operand, in
// a function whose other path returns that f64 (`fail() * x`). Legacy typed the operator at i32,
// so the f64 reached `i32.mul` and the module failed to validate wherever the function was built.
// The value is the live path's f64, so the delivery itself is plain; the cells grade the body.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function fail(): never { __trap__() }
function scaled(c: boolean, x: f64) {
  if c { return x }
  return fail() * x
}
// @@VALUE@@
scaled(true, 2.5)
// @@TYPE@@
f64
// @@FALLBACK@@
scaled(true, 0.5)
// @@TEST@@
v > 2.0
// @@HIT@@
print(v)
// @@MISS@@
print(9)
// @@WANT@@
2.5
