// D7763: an un-annotated generic identity handed a function value, the result delivered and
// called at the destination. The generic's type parameter stays open; the annotated face
// annotates only the destination.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __id<T>(x: T) {
  return x
}
function __h(n: i32) {
  return n + 1
}
// @@VALUE@@
__id(__h)
// @@TYPE@@
(n: i32) => i32
// @@PROOF@@
print(v(2))
// @@WANT@@
3
// @@VALUE2@@
__id((s: string) => s + "!")
// @@TYPE2@@
(s: string) => string
// @@PROOF2@@
print(v("a"))
// @@WANT2@@
a!
// @@SKIP@@
is_in_if: the value is a function, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
