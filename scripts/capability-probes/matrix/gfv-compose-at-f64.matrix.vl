// A generic `compose` of two generic functions, delivered and called at `f64`: nothing but the
// destination or the later call binds the composed type parameters.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function gid<A>(x: A): A { x }
function compose<A, B, C>(f: (a: A) => B, g: (b: B) => C): (a: A) => C { (a: A) => g(f(a)) }
// @@VALUE@@
compose(gid, gid)
// @@TYPE@@
(a: f64) => f64
// @@PROOF@@
print(v(1.5))
// @@WANT@@
1.5
