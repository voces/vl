// D1812 — `x as! i32[]` over a niche-repped `i32[] | null`, the LIST rep. `ref.as_non_null`
// hands the wrapper back at its own heap type, so the list wrapper needs no separate arm.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function s1(): i32[] | null { return [1, 2, 3] }
function s2(): i32[] | null { return [4, 5, 6] }
// @@VALUE@@
s1() as! i32[]
// @@TYPE@@
i32[]
// @@PROOF@@
print(v[1])
// @@WANT@@
2
// @@VALUE2@@
s2() as! i32[]
// @@TYPE2@@
i32[]
// @@PROOF2@@
print(v[1])
// @@WANT2@@
5
// @@SKIP@@
is_in_if: the value is a plain list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
