// A hole lambda handed through an identity inside a function whose result is inferred, then
// delivered from that function's call (D14884).
//
// The value carries the lambda as its one-member set, and its delivery to a declared function
// type builds the lambda's closure there.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function fw(f) { return f }
const lam = (x) => x
function deliver() { return fw(lam) }
// @@VALUE@@
deliver()
// @@TYPE@@
(x: i32) => i32
// @@PROOF@@
print(v(3) + v(4))
// @@WANT@@
7
// @@VALUE2@@
deliver()
// @@TYPE2@@
(x: string) => string
// @@PROOF2@@
print(v("w"))
// @@WANT2@@
w
