// An object literal delivered into a nullable union of records at every position: the box plan
// boxes it as the union's arm, whose row is not the literal's own layout, and the IR builds it at
// that arm's row, as legacy's `emitVariantStruct` does.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type __A = { t: i32, a: i32 }
type __B = { t: i32, b: i32 }
type __AB = __A | __B
function __n(i: i32): i32 { return i + 3 }
// @@VALUE@@
{ t: 1, b: __n(1) }
// @@TYPE@@
__AB | null
// @@PROOF@@
if v != null && v is __B { print(v.b) } else { print("no") }
// @@WANT@@
4
// @@TEST@@
v != null && v is __B
// @@HIT@@
print("4")
// @@MISS@@
print("no")
