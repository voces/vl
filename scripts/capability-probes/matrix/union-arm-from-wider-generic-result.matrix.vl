// A wider record handed through a generic identity, then delivered into a union with a narrower
// arm: the instance returns the record's own row, which boxes under the arm it is wider than.
// The proof reads through a `UawPet` parameter, so the un-annotated face delivers it there too.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type UawA = { k: i32, legs: i32 }
type UawB = { s: string }
type UawPet = UawA | UawB
function uawLegs(p: UawPet): i32 {
  if p is UawA { return p.legs }
  -1
}
function uawId<T>(x: T): T {
  return x
}
const uawSv = { k: 1, legs: 4, purr: true }
// @@VALUE@@
uawId(uawSv)
// @@TYPE@@
UawPet
// @@TEST@@
uawLegs(v) >= 0
// @@HIT@@
print(uawLegs(v) + 1)
// @@MISS@@
print("b")
// @@WANT@@
5
