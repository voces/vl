// D7841/D7842: hole functions whose bodies call a handed hole function at different sets of
// types, joined by `if` (called twice) and by a list iterated by `for`; the handed function's
// type parameters stay open.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __add(a, b) {
  a + b
}
function __p(g) {
  const d = g(1.5, 2.5)
  const e = g(1, 2)
  if d == 4.0 && e == 3 { 1 } else { 0 }
}
function __q(g) {
  if g(10, 20) == 30 { 10 } else { 0 }
}
function __pick(c: boolean): i32 {
  const f = if c { __p } else { __q }
  let s = f(__add) + f(__add)
  const fs = [__p, __q]
  for h in fs { s = s + h(__add) }
  s
}
// @@VALUE@@
__pick(true) + __pick(false)
// @@TYPE@@
i32
// @@PROOF@@
print(v)
// @@WANT@@
44
