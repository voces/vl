// D16939, D4267 — a nested literal set against a nested scalar: a `C` value whose nested `x` is a
// member of `A`'s set is an `A`, read by value through the nested record.
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type A = { v: { x: 1 | 2 } }
type C = { v: { x: i32 } }
function pick(a: boolean): A | C {
  if a {
    const c: C = { v: { x: 9 } }
    return c
  }
  const d: C = { v: { x: 2 } }
  return d
}
// @@SETUP@@
const cval: C = { v: { x: 2 } }
// @@VALUE@@
cval
// @@TYPE@@
A | C
// @@TEST@@
v is A
// @@HIT@@
print("A")
// @@MISS@@
print("C")
// @@WANT@@
A
// @@VALUE2@@
pick(true)
// @@TYPE2@@
A | C
// @@PROOF2@@
if v is A { print("A") } else { print("C") }
// @@WANT2@@
C
