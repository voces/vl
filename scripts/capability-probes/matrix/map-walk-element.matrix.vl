// A walk of a map's values or keys binds its variable at the rep the map stores it at; each cell
// delivers that variable to one position inside the loop body, for record values and for `i64`
// keys. The built-in positions wrap an expression, which a loop variable is not, so every
// position here is its own cell; the VALUE below is one walk's result, graded at the built-ins.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type P = { n: i32 }
function rmap(): {[string]: P} {
  const m: {[string]: P} = Map()
  m["a"] = { n: 11 }
  m["b"] = { n: 12 }
  m["c"] = { n: 13 }
  return m
}
function kmap(): {[i64]: i32} {
  const m: {[i64]: i32} = Map()
  m[10 as i64] = 1
  m[20 as i64] = 2
  m[30 as i64] = 3
  return m
}
function lastN(m: {[string]: P}): i32 {
  let t = 0
  for r in m.values() { t = r.n }
  return t
}
function pn(n: i32): i32 { return n }
function pu(x: i32 | string): string { return if x is i32 { "i" } else { "s" } }
function pk(k: i64): i64 { return k }
// @@VALUE@@
lastN(rmap())
// @@TYPE@@
i32
// @@PROOF@@
print(v)
// @@WANT@@
13
// @@CELL_rec_arg@@
// want: 11 then 12 then 13
for r in rmap().values() { print(pn(r.n)) }
// @@CELL_key_arg@@
// want: 10 then 20 then 30
for k in kmap().keys() { print(pk(k)) }
// @@CELL_rec_union_arg@@
// want: i then i then i
for r in rmap().values() { print(pu(r.n)) }
// @@CELL_rec_nested_arg@@
// want: 11 then 12 then 13
for r in rmap().values() { print(pn(pn(r.n))) }
// @@CELL_key_nested_arg@@
// want: 10 then 20 then 30
for k in kmap().keys() { print(pk(pk(k))) }
// @@CELL_rec_concat@@
// want: v11 then v12 then v13
for r in rmap().values() { print("v" + "\{r.n}") }
// @@CELL_key_concat@@
// want: v10 then v20 then v30
for k in kmap().keys() { print("v" + "\{k}") }
// @@CELL_rec_interp@@
// want: <11> then <12> then <13>
for r in rmap().values() { print("<\{r.n}>") }
// @@CELL_key_interp@@
// want: <10> then <20> then <30>
for k in kmap().keys() { print("<\{k}>") }
// @@CELL_rec_if_arm@@
// want: 11 then 12 then 13
for r in rmap().values() { print(if r.n > 0 { r.n } else { 0 }) }
// @@CELL_key_if_arm@@
// want: 10 then 20 then 30
for k in kmap().keys() { print(if k > (0 as i64) { k } else { 0 as i64 }) }
// @@CELL_rec_let_init@@
// want: 11 then 12 then 13
for r in rmap().values() {
  const q = r
  print(q.n)
}
// @@CELL_key_let_init@@
// want: 10 then 20 then 30
for k in kmap().keys() {
  const q = k
  print(q)
}
// @@CELL_rec_coalesce@@
// want: 11 then 12 then 13
function opt(r: P): P | null { return r }
for r in rmap().values() { print((opt(r) ?? r).n) }
// @@CELL_rec_record_field@@
// want: 11 then 12 then 13
for r in rmap().values() {
  const w = { p: r, k: 1 }
  print(w.p.n)
}
// @@CELL_key_record_field@@
// want: 10 then 20 then 30
for k in kmap().keys() {
  const w = { k: k, z: 1 }
  print(w.k)
}
// @@CELL_rec_return@@
// want: 11
function firstN(): i32 {
  for r in rmap().values() { return r.n }
  return 0
}
print(firstN())
// @@CELL_key_return@@
// want: 10
function firstK(): i64 {
  for k in kmap().keys() { return k }
  return 0 as i64
}
print(firstK())
// @@CELL_closure_values@@
// want: 101 then 201 then 301
const fs: {[string]: (k: i32) => i32} = Map()
fs["a"] = (k: i32) => k + 100
fs["b"] = (k: i32) => k + 200
fs["c"] = (k: i32) => k + 300
for g in fs.values() { print(g(1)) }
