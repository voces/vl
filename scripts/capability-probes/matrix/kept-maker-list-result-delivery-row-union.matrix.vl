// A KEPT MAKER whose result is a list of a union of records — `mk2()` returns
// `[{ r: { c: 7 } }, { r: { s: 2 } }]` and one call is delivered at `Sh[]`, which stores `r` as
// the union `Cir | Sq` — delivered at every other position. The delivery at `Sh[]` is copied
// element by element, each arm by its tag (D14385). Format: scripts/capability-probes/README.md.
// @@PRELUDE@@
type Cir = { c: i32 }
type Sq = { s: i32 }
type Sh = { r: Cir | Sq }
function mk2() { [{ r: { c: 7 } }, { r: { s: 2 } }] }
const dA: Sh[] = mk2()
const go = [1].length > 0
// @@VALUE@@
mk2()
// @@TYPE@@
({ r: { c: i32 } } | { r: { s: i32 } })[]
// @@PROOF@@
const p0 = v[0]
if p0 is { r: { c: i32 } } { print(p0.r.c + dA.length) } else { print(0) }
// @@WANT@@
9
// @@SKIP@@
is_in_if: the value is a list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
