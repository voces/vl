// D2519 — an i64-keyed typed-value map beside a `string`.
// The proof reads, writes, deletes, counts and walks the map after narrowing, so a box that
// casts to the wrong map struct fails validation or prints wrong.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function mk(): {[i64]: string} {
  const m: {[i64]: string} = Map()
  m.set(4294967296, "a")
  m.set(4294967297, "b")
  m
}
function pick(n: i32): {[i64]: string} | string {
  if n > 0 { return mk() }
  return "s"
}
// @@VALUE@@
pick(1)
// @@TYPE@@
{[i64]: string} | string
// @@TEST@@
v is {[i64]: string}
// @@HIT@@
print(v.length)
print(v.has(4294967296))
print((v.get(4294967296) ?? "?"))
v.set(4294967298, "c")
print(v.length)
v.delete(4294967297)
print(v.has(4294967297))
let c = 0
for kk in v { c = c + 1 }
print(c)
print((v[4294967298] ?? "?"))
// @@MISS@@
print("miss")
// @@WANT@@
2 then true then a then 3 then false then 2 then c
// @@VALUE2@@
pick(0)
// @@TYPE2@@
{[i64]: string} | string
// @@PROOF2@@
match v {
  {[i64]: string} => print("map")
  string => print(v + "!")
}
// @@WANT2@@
s!
