// D7381: an un-annotated list whose element is an `if` choosing between two generics, built and
// called inside a generic at the generic's own type parameter, which stays open: the generic is
// called at `i32` and at `string`. The value delivered is what the two calls return.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __fa<V>(v: V): V {
  v
}
function __fb<V>(v: V): V {
  v
}
function __run<T>(x: T, c: boolean): T {
  const fs = [if c { __fa } else { __fb }]
  fs[0](x)
}
// @@VALUE@@
__run("abc", false).length + __run(3, true)
// @@TYPE@@
i32
// @@PROOF@@
print(v)
// @@WANT@@
6
