// @@CELL_join_two_layouts@@
// want: 9 then 9 then 9 then 9 then true
const a = { pet: { legs: 4, purr: true } }
const b = { pet: { legs: 2, wings: 2 } }
function pick(c: boolean) {
  const u__A__ = if c { a } else { b }
  u.pet.legs = 9
  print(u.pet.legs)
}
pick(true)
pick(false)
print(a.pet.legs)
print(b.pet.legs)
print(a.pet.purr)
// @@CELL_relet_two_layouts@@
// owed: an existing record keeps its own record layout
function mk5(): { pet: { legs: i32, wings: i32 } } { return { pet: { legs: 2, wings: 2 } } }
let u: { pet: { legs: i32 } } = mk()
u = mk5()
print(u.pet.legs)
// @@CELL_existing_narrow_list@@
// owed: an existing record keeps its own record layout
function mk5(): { pet: { legs: i32, wings: i32 } } { return { pet: { legs: 2, wings: 2 } } }
const xs: { pet: { legs: i32 } }[] = []
xs.push(mk())
xs.push(mk5())
print(xs[0].pet.legs)
// @@CELL_existing_narrow_map@@
// owed: an existing record keeps its own record layout
const m: { [string]: { pet: { legs: i32 } } } = Map()
m["k"] = mk()
print(m["k"]?.pet.legs)
