// want: 4 then 5
const sv = mk()
const u__A__ = sv
print(u.pet.legs)
sv.pet.legs = 5
print(u.pet.legs)
// @@CELL_nested_write_misfit@@
// owed: purr
const sv = mk()
const u__A__ = sv
u.pet = { legs: 3 }
print(sv.pet.purr)
// @@CELL_pass_nested_on@@
