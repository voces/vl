// An existing record whose nested record carries a field the destination's nested record does not
// name: it is taken at its own type at any depth, with no copy (DECISIONS "Width subtyping reaches
// nested fields", D3431). The built-in positions deliver a declared-result call (an existing record)
// at the narrow type; the cells add depth 2, named nested types, aliasing proofs, the write through
// the annotated name that must fit the real layout, a join (taken as a union), and the one-layout
// contract refusals, owed by D4054 (the matrix truncates a refusal, so `owed:` quotes its opening).
// @@PRELUDE@@
function mk(): { pet: { legs: i32, purr: boolean } } { return { pet: { legs: 4, purr: true } } }
// @@VALUE@@
mk()
// @@TYPE@@
{ pet: { legs: i32 } }
// @@PROOF@@
print(v.pet.legs)
// @@WANT@@
4
// @@SKIP@@
array_push: an existing narrow list stores one record layout (D4054); graded owed by CELL_existing_narrow_list
map_value: an existing narrow map stores one record layout (D4054); graded owed by CELL_existing_narrow_map
map_set: same as map_value
// @@CELL_literal_binding@@
// want: true then 4
const sv = { pet: { legs: 4, purr: true } }
const u__A__ = sv
print(sv.pet.purr)
print(u.pet.legs)
// @@CELL_existing_binding@@
// want: true then 4
const sv = mk()
const u__A__ = sv
print(sv.pet.purr)
print(u.pet.legs)
// @@CELL_depth2@@
// want: true then 4
function mk2(): { a: { pet: { legs: i32, purr: boolean } } } { return { a: { pet: { legs: 4, purr: true } } } }
const sv = mk2()
const u: { a: { pet: { legs: i32 } } } = sv
print(sv.a.pet.purr)
print(u.a.pet.legs)
// @@CELL_depth2_literal@@
// want: true then 4
const sv = { a: { pet: { legs: 4, purr: true } } }
const u: { a: { pet: { legs: i32 } } } = sv
print(sv.a.pet.purr)
print(u.a.pet.legs)
// @@CELL_named_types@@
// want: true then 4
type Pet = { legs: i32 }
type U = { pet: Pet }
const sv = mk()
const u: U = sv
print(sv.pet.purr)
print(u.pet.legs)
// @@CELL_extra_top_and_nested@@
// want: 1 then true then 4
function mk3(): { pet: { legs: i32, purr: boolean }, x: i32 } { return { pet: { legs: 4, purr: true }, x: 1 } }
const sv = mk3()
const u: { pet: { legs: i32 } } = sv
print(sv.x)
print(sv.pet.purr)
print(u.pet.legs)
// @@CELL_returned_annotated@@
// want: 4
const sv = mk()
function get(): { pet: { legs: i32 } } { return sv }
print(get().pet.legs)
// @@CELL_argument_declared@@
// want: 4 then true
function show(u: { pet: { legs: i32 } }) { print(u.pet.legs) }
const sv = mk()
show(sv)
print(sv.pet.purr)
// @@CELL_argument_named@@
// want: 4 then true
type Pet = { legs: i32 }
type U = { pet: Pet }
function show(u: U) { print(u.pet.legs) }
const sv = mk()
show(sv)
print(sv.pet.purr)
// @@CELL_argument_two_rows@@
// want: 4 then 2
function show(u: { pet: { legs: i32 } }) { print(u.pet.legs) }
show(mk())
function mk4(): { pet: { legs: i32, wings: i32 } } { return { pet: { legs: 2, wings: 2 } } }
show(mk4())
