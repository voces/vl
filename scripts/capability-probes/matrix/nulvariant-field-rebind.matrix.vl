// D1112 / D1161 — a rebind off an `E | null` field where `E` is also a union ARM. The
// un-annotated rebind was check-clean invalid wasm (D1112) and the annotated one a loud emit
// reject wherever the narrowed value received a field ASSIGNMENT (D1161); both closed
// 2026-09-02, and the two faces landed in DIFFERENT clauses, which is why this template
// grades both. The proof WRITES through the delivered value and then reads it back, because
// a cell that only reads cannot see D1161.
//
// The discriminator here is `!= null`, not `is` — the six discrimination positions take
// whatever @@TEST@@ says.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type Other = { o: string }
type E = { at: i32, path: string }
type U = Other | E
type C = { err: E | null }
// @@SETUP@@
const c: C = { err: { at: 1, path: "p" } }
// @@VALUE@@
c.err
// @@TYPE@@
E | null
// @@TEST@@
v != null
// @@HIT@@
v.path = "/a" + v.path
print(v.path)
// @@MISS@@
print("none")
// @@WANT@@
/ap
// @@SKIP@@
map_value: the map read would narrow `E | null` a second time, which is a different program
