// D8302: the twin of `fresh-call-beside-unlanded-call-and-declared-row`. The value is the call
// delivered at the literal's own type, while another call of the same function is delivered into
// a record that stores a field wider (`J`) and the program declares the literal's own record
// (`II`). One body builds one row, so a delivery that fixes the call's own storage refuses.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type II = { f: i32 }
type J = { f: i32 | null }
function mk() { { f: 4 } }
const wideJ: J = mk()
const wideF: i32 = wideJ.f ?? 0
// @@VALUE@@
mk()
// @@TYPE@@
{ f: i32 }
// @@WANT@@
5
// @@TEST@@
v.f == 4
// @@HIT@@
print(v.f + 1)
// @@MISS@@
print(0)
