// `ok() && (side(v)?.tag ?? "z") == "b"` over a nullable union of records: the call receiver
// sits behind a short-circuit, so it is evaluated once, in source order, and only when the
// left side holds. The trace records each call (D5331).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type N = { tag: "a", v: i32 } | { tag: "b", w: i32 }
function mk(a: boolean): N | null {
  if a { return null }
  { tag: "b", w: 2 }
}
let trace = ""
function ok(t: string): boolean {
  trace = trace + t
  true
}
function side(t: string, x: N | null): N | null {
  trace = trace + t
  x
}
// @@VALUE@@
mk(false)
// @@TYPE@@
N | null
// @@PROOF@@
trace = ""
const c = ok("L") && (side("R", v)?.tag ?? "z") == "b"
print(trace + (if c { "1" } else { "0" }))
// @@WANT@@
LR1
// @@VALUE2@@
mk(true)
// @@TYPE2@@
N | null
// @@PROOF2@@
trace = ""
const c = !ok("L") || (side("R", v)?.tag ?? "z") == "b"
print(trace + (if c { "1" } else { "0" }))
// @@WANT2@@
LR0
