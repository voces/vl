// A set of strings, delivered: an add, a membership test, the length and a values walk.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __mk(): Set<string> {
  const s: Set<string> = Set()
  s.add("a")
  s.add("bb")
  return s
}
// @@VALUE@@
__mk()
// @@TYPE@@
Set<string>
// @@PROOF@@
v.add("c")
print(v.has("bb"))
print(v.length)
let n = 0
for x in v.values() { n = n + x.length }
print(n)
