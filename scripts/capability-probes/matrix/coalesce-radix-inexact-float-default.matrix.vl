// D16605 — a radix literal an `f32` cannot hold exactly, as the default of a `??` beside a
// typed `f32`, keeps its own type and the join widens (ruling 4.3), as the decimal does, so
// it is 16777217, not the rounded 16777216. Delivered at its join type; D16606 is the `f64`
// destination face.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function noneF(): f32 | null { return null }
// @@VALUE@@
noneF() ?? 0x1000001
// @@TYPE@@
f32 | i32
// @@PROOF@@
print(v)
// @@WANT@@
16777217
// @@TEST@@
v is i32
// @@HIT@@
print(v)
// @@MISS@@
print(0)
// @@VALUE2@@
noneF() ?? 0xFFFFFFFF
// @@TYPE2@@
f32 | i32
// @@PROOF2@@
print(v)
// @@WANT2@@
-1
