// D9951: D9570's list literal of a record, beside an earlier record of an un-annotated function
// sharing the field name, so both meet at one row. Every cell prints `30`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function inc5(a) { return a + 1 }
const r = { f: inc5 }
function take(a) { print(a.f(3) + r.f(0) - 1) }
// @@VALUE@@
[{ f: (x: i32): i32 => x * 10 }]
// @@TYPE@@
{ f: (a: i32) => i32 }[]
// @@PROOF@@
take(v[0])
// @@WANT@@
30
// @@SKIP@@
is_in_if: the value is a list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
