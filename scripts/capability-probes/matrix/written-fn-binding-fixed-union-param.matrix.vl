// D4892: a written function binding of generics, one of which fixes a union parameter, is
// called at a type that parameter takes another rep than: the write is adapted at the call type,
// so a delivery stores the instantiation at that type. The binding's type parameters stay open;
// the annotated face annotates only the destination.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __s<A, B>(a: A, b: B): i32 { return 0 }
function __w<B>(a: i32 | string, b: B): i32 {
  if a is i32 { return a }
  return -1
}
// @@SETUP@@
let __f = __s
__f = __w
const __dn = __f(1, true)
// @@VALUE@@
__f
// @@TYPE@@
(a: i32, b: boolean) => i32
// @@PROOF@@
print(v(41, true))
// @@WANT@@
41
// @@TEST@@
v(0, false) == 0
// @@HIT@@
print(v(41, true))
// @@MISS@@
print(0)
