// D10172's open twin: the union of maps is joined by an un-annotated function from its hole
// parameter, then walked by a `for` and counted by `.values().length` at every position.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __pick(p, c: boolean) {
  const s: {[string]: string} = Map()
  s["k"] = p
  const t: {[string]: boolean} = Map()
  t["j"] = true
  if c { s } else { t }
}
// @@VALUE@@
__pick("x", true)
// @@TYPE@@
{[string]: string} | {[string]: boolean}
// @@TEST@@
v.has("k")
// @@HIT@@
let s = ""
for k in v { s = s + k }
print(s.length * 10 + v.values().length)
// @@MISS@@
print("wrong")
// @@WANT@@
11
