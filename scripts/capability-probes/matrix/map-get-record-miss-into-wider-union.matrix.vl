// D10170 — a record-valued map's `.get` delivered straight into a union that also holds a
// scalar and `null`. A miss must land as the union's null and a hit as the record arm, so the
// proof prints `is null` for the miss and a field of the hit.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type P = { x: i32 }
function mk(): {[i32]: P} {
  const m: {[i32]: P} = Map()
  m.set(1, { x: 7 })
  m
}
const c = mk()
// @@VALUE@@
c.get(2)
// @@TYPE@@
i32 | P | null
// @@TEST@@
v is null
// @@HIT@@
print("null")
// @@MISS@@
if v is P { print(v.x) } else { print("other") }
// @@WANT@@
null
// @@VALUE2@@
c.get(1)
// @@TYPE2@@
i32 | P | null
// @@PROOF2@@
if v is P { print(v.x) } else if v is null { print("null") } else { print("other") }
// @@WANT2@@
7
