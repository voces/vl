// D5342 — a record literal whose nested element carries a field the element's shape drops,
// with a constant initialiser, at every delivery position and in both faces. At `global_init`
// the un-annotated face built a non-constant initialiser; the TEST reads both levels, so a
// literal that lost its element or kept the wrong one cannot take the HIT branch.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type M = { n: i32, kids: { n: i32 }[] }
// @@VALUE@@
{ n: 1, kids: [{ n: 2, kids: [] }] }
// @@TYPE@@
M
// @@TEST@@
v.n + v.kids[0].n * 10 == 21
// @@HIT@@
print(v.n + v.kids[0].n * 10)
// @@MISS@@
print("miss")
// @@WANT@@
21
