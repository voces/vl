// A list of records whose nested record's field holds un-annotated functions of different result
// types, delivered at every position: a call through `xs[i].a.f` runs the function stored there,
// or is refused at check; it never calls one at another's signature (D16860).
// @@PRELUDE@@
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const rows = [{ a: { f: inc0 } }, { a: { f: half } }]
// @@VALUE@@
rows
// @@TYPE@@
{ a: { f: (f64) => f64 } }[]
// @@PROOF@@
print(v[1].a.f(3))
// @@WANT@@
1.5
// @@CELL_direct@@
// want: 1.5 then 4
print(rows[1].a.f(3))
print(rows[0].a.f(3))
// @@CELL_param_flat_record@@
// want: 1.5
const ys = [{ f: inc0 }, { f: half }]
function take(p) { print(p[1].f(3)) }
take(ys)
// @@CELL_param_same_results@@
// want: 6
function dbl(a) { return a * 2 }
const ys = [{ a: { f: inc0 } }, { a: { f: dbl } }]
function take(p) { print(p[1].a.f(3)) }
take(ys)
// @@CELL_loop@@
// want: 4 then 1.5
for r in rows { print(r.a.f(3)) }
