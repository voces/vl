// D1710 — the litunion column of the nullable-list family: `K[] | null`, whose element is an
// interned i32 atom, so the list is an i32 list and the niche is the same nullable wrapper an
// `i32[] | null` field gets (code 18), not the ref wrapper a struct element gets.
//
// This template is also the standing guard on D1691's subtraction: before it the field took
// the REF wrapper and the module failed validation check-clean, so a cell that silently comes
// back here is that miscompile returning.
//
// The proof prints the MEMBER, not a number — an atom read back without its union name is a
// wrong value rather than a refusal.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type K = "a" | "b"
function plain(): K[] { return ["a"] }
function nul1(): K[] | null { return ["b"] }
function nul2(): K[] | null { return ["a"] }
function firstHolder() {
  const first = { xs: plain() }
  print(first.xs[0])
}
// @@VALUE@@
{ xs: nul1() }
// @@TYPE@@
{ xs: K[] | null }
// @@PROOF@@
const l = v.xs
if l != null { print(l[0]) } else { print("none") }
// @@WANT@@
b
// @@VALUE2@@
{ xs: nul2() }
// @@TYPE2@@
{ xs: K[] | null }
// @@PROOF2@@
const l2 = v.xs
if l2 != null { print(l2[0]) } else { print("none") }
// @@WANT2@@
a
// @@SKIP@@
is_in_if: the value is a struct, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
