// D8320's generic twin: the value is a literal handed through a generic identity whose type
// parameter only the literal fixes, so the narrowed row comes from the instance the delivery
// pins, not from an annotation. The type parameter stays open.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type J = { r: i32 }
type N = { r: i32 | null }
function idn<T>(v: T): T { v }
const a: J | string = { r: 5 }
// @@VALUE@@
idn({ r: 7 })
// @@TYPE@@
N | string
// @@WANT@@
7
// @@TEST@@
v is N
// @@HIT@@
print(v.r ?? 0)
// @@MISS@@
print(0)
// @@SKIP@@
array_element: a list literal of a generic identity's record beside a declared record of its field names is D8381
array_element_place: same
