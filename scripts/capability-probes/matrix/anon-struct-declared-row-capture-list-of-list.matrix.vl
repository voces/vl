// D1697 — the capture preference reaching through a SECOND container. A list-of-list element
// records the key `A[]`, which names no struct row, so the comparator's row walk had nothing
// to resolve and the declared row captured the literal anyway.
//
// The value's element boxes `i32 | boolean` and holds the i32 `7`; the declared row's boxes
// `string | boolean`. Graded by PRINTED VALUE — the red cells are check-clean invalid wasm,
// so this template's `WANT` is the value and not a run marker.
//
// `type Held` is never named by a value; declaring it is the whole ingredient, and taking one
// container off turns every cell green for the wrong reason (that spelling is D1674, closed).
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type U1 = i32 | boolean
type U2 = string | boolean
type A = { p: U1 }
type B = { p: U2 }
type Held = { ys: B[][] }
function as1(): A[][] { return [[{ p: 7 }]] }
function as2(): A[][] { return [[{ p: 8 }]] }
// @@VALUE@@
{ ys: as1() }
// @@TYPE@@
{ ys: A[][] }
// @@PROOF@@
print(v.ys[0][0].p)
// @@WANT@@
7
// @@VALUE2@@
{ ys: as2() }
// @@TYPE2@@
{ ys: A[][] }
// @@PROOF2@@
print(v.ys[0][0].p)
// @@WANT2@@
8
// @@SKIP@@
is_in_if: the value is a struct, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
