// A shared field read over a union box a call returns (`g(i).x` over `A | B`): legacy evaluates
// the receiver once into its stash slot and dispatches on the box's tag per member.
//
// The PROOF discriminates: `g(2)` is the `B` member, whose `x` is 2; the `A` member's is 1.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type A = { kind: "a", x: i32 }
type B = { kind: "b", x: i32, y: i32 }
type U = A | B
function g(i: i32): U {
  if i > 0 { return { kind: "b", x: i, y: 3 } }
  return { kind: "a", x: 1 }
}
// @@VALUE@@
g(2).x
// @@TYPE@@
i32
// @@PROOF@@
print(v)
// @@WANT@@
2
