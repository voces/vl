// D16816: the call of a maker with an un-annotated parameter, handed straight to a parameter as
// its argument rather than bound first. The cells hand `adder(2)` to an un-annotated parameter
// that calls it; `uncalled_*`, `generic_*` and `in_generic` are the positions the bound spelling
// is refused at too.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function adder(n) { return (a) => a + n }
// @@VALUE@@
adder(2)
// @@TYPE@@
(a: i32) => i32
// @@PROOF@@
print(v(3))
// @@WANT@@
5
// @@CELL_hole_param_called@@
function take(a__A__) { print(a(3)) }
take(__V__)
// @@CELL_hole_param_bound_inside@@
function take(a__A__) {
  const v = a
  print(v(3))
}
take(__V__)
// @@CELL_in_function@@
function take(a__A__) { print(a(3)) }
function main() { take(__V__) }
main()
// @@CELL_handed_on@@
function inner(f__A__) { print(f(3)) }
function take(a__A__) { inner(a) }
take(__V__)
// @@CELL_second_argument@@
function take(x: i32, a__A__) { print(a(x)) }
take(3, __V__)
// @@CELL_parenthesised@@
function take(a__A__) { print(a(3)) }
take((__V__))
// @@CELL_result_returned@@
// want: 10
function take(a__A__) { return a(3) * 2 }
print(take(__V__))
// @@CELL_two_calls_same_pin@@
// want: 5 then 7
function take(a__A__) { print(a(3)) }
take(__V__)
take(adder(4))
// @@CELL_two_calls_two_pins@@
// want: 5 then 5.5
function take(a) {
  const v = a
  print(v(3))
}
take(__V__)
take(adder(2.5))
// @@CELL_f64_pin@@
// want: 2.75
function take(a) { print(a(0.5)) }
take(adder(2.25))
// @@CELL_two_parameter_maker@@
// want: 7
function lin(m, c) { return (a) => a * m + c }
function take(a) { print(a(3)) }
take(lin(2, 1))
// @@CELL_uncalled_hole_param@@
// want: 7
function take(a__A__, x: i32) { print(x) }
take(__V__, 7)
// @@CELL_generic_param_called@@
function take<F>(a: F) { print(a(3)) }
take(__V__)
// @@CELL_in_generic@@
function take(a__A__) { print(a(3)) }
function run<T>(x: T) { take(__V__) }
run(1)
