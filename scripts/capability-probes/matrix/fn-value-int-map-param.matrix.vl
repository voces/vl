// D9920: a named function whose parameter is an i32-keyed map, delivered where a function of
// that parameter is expected. The proof writes through the map the value receives and reads
// the stored value back, so a map handed across with the wrong struct cannot print 42.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function g(k: {[i32]: i32}): i32 {
  k.set(4, 1)
  (k.get(3) ?? 0) + 1
}
function mk(): {[i32]: i32} {
  const m: {[i32]: i32} = Map()
  m.set(3, 41)
  m
}
// @@VALUE@@
g
// @@TYPE@@
(k: {[i32]: i32}) => i32
// @@PROOF@@
const m = mk()
print(v(m) + m.length * 100)
// @@WANT@@
242
// @@VALUE2@@
g
// @@TYPE2@@
(k: {[i32]: i32}) => i32
// @@PROOF2@@
print(v(mk()))
// @@WANT2@@
42
