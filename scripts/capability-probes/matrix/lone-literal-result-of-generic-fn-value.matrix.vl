// D8001: a call of a function value whose type returns one string literal, the function
// handed back by a generic identity at an open `F`, so the call's result type is never spelled.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __g(): "a" { return "a" }
function __pass<F>(f: F): F { return f }
// @@VALUE@@
__pass(__g)()
// @@TYPE@@
"a"
// @@PROOF@@
print(v + "x")
// @@WANT@@
ax
// @@TEST@@
v == "a"
// @@HIT@@
print("ax")
// @@MISS@@
print(0)
// @@VALUE2@@
__pass(__g)().length
// @@TYPE2@@
i32
// @@PROOF2@@
print(v)
// @@WANT2@@
1
