// Receiver overloading (O1): `lastIndexOf` names both std:array's and std:str's, and a list
// delivered to each position must reach std:array's. VALUE2 is the string twin, std:str's.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
import { lastIndexOf } from "std:array"
import { lastIndexOf } from "std:str"
// @@VALUE@@
[1, 2, 3, 2]
// @@TYPE@@
i32[]
// @@PROOF@@
print(v.lastIndexOf(2))
// @@WANT@@
3
// @@VALUE2@@
"abcb"
// @@TYPE2@@
string
// @@PROOF2@@
print(v.lastIndexOf("b"))
// @@WANT2@@
3
