// D14140's generic twin: the union field's member is a type parameter the argument binds, so
// the destination record is open until the instance closes it (`{v: T | string}` at `T = i32`).
// A template that annotates the field's type cannot see this delivery.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function mk(n: i32): {v: i32} { return {v: n} }
function hold<T>(x: {v: T | string}): {v: T | string} { x }
const r0 = mk(5)
// @@VALUE@@
hold(r0)
// @@TYPE@@
{v: i32 | string}
// @@PROOF@@
const f = v.v
if f is i32 { print(f + 1) } else { print(f) }
// @@WANT@@
6
// @@TEST@@
v.v is i32
// @@HIT@@
print(1)
// @@MISS@@
print(0)
