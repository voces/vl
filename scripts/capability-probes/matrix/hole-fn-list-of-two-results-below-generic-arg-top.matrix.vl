// D16859: a list of un-annotated functions of two result types held below the top of a generic's
// argument, handed through a generic identity, read and called at every position: the part that
// holds the list is pinned at the list's own rep, one closure of either signature per element.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __hinc(a) { return a + 1 }
function __hhalf(a) { return a / 2.0 }
function __hid(x) { return x }
const __hr = __hid({ l: [__hinc, __hhalf] })
// @@VALUE@@
__hr.l[0](3)
// @@TYPE@@
i32
// @@TEST@@
v == 4
// @@HIT@@
print(1)
// @@MISS@@
print(0)
// @@WANT@@
1
// @@CELL_other_member@@
// want: 1.5
print(__hr.l[1](3))
// @@CELL_list_in_list@@
// want: 1.5
const __hll = __hid([[__hinc, __hhalf]])
print(__hll[0][1](3))
// @@CELL_lists_of_one_result_each@@
// want: 4 then 1.5
const __hl2 = __hid([[__hinc], [__hhalf]])
print(__hl2[0][0](3))
print(__hl2[1][0](3))
// @@CELL_beside_number@@
// want: 1
const __hrn = __hid({ l: [__hinc, __hhalf], n: 2 })
print(__hrn.l[1](__hrn.n))
// @@CELL_two_fields@@
// want: 4 then 1.5
const __hrf = __hid({ a: [__hinc], b: [__hhalf] })
print(__hrf.a[0](3))
print(__hrf.b[0](3))
// @@CELL_handed_and_called@@
// want: 4 then 1.5
function __happ(o) { return o.l[0](3) }
print(__happ({ l: [__hinc, __hhalf] }))
print(__happ({ l: [__hhalf, __hinc] }))
