// A generic function passed back through two un-annotated functions' returns, delivered to each
// position, then handed to a generic's function parameter (D10381).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function id<T>(x: T): T { x }
function run<U>(f: (x: U) => U, u: U): U { f(u) }
function mk() { id }
function deliver() { return mk() }
// @@VALUE@@
deliver()
// @@TYPE@@
(x: i32) => i32
// @@PROOF@@
print(run(v, 2))
// @@WANT@@
2
