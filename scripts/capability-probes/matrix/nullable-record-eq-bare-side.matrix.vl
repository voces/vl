// A record compared with a nullable record of its type, at every delivery position: the bare
// record is one side of `==` and `!=`, each way round, against a present and a null partner.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type __C = { r: i32, s: string }
const __n: __C | null = { r: 1, s: "a" }
const __o: __C | null = null
// @@VALUE@@
({ r: 1, s: "a" })
// @@TYPE@@
__C
// @@WANT@@
true then false then false then true
// @@TEST@@
v == __n && __o != v
// @@HIT@@
print(v == __n)
print(__n != v)
print(__o == v)
print(v != __o)
// @@MISS@@
print("miss")
