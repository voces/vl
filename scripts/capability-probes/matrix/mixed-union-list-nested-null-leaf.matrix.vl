// D4635 — a list literal of a record and a string, whose record nests a record with a nullable
// leaf, delivered into a `(Holder | string)[]`. The un-annotated face infers the literal's own
// union; the annotated face must box each element into the destination's union, not the literal's.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type Holder = { h: { x: i32 | null } }
// @@VALUE@@
[{ h: { x: null } }, "t"]
// @@TYPE@@
(Holder | string)[]
// @@PROOF@@
const e0 = v[0]
if e0 is Holder { print(e0.h.x == null) } else { print("miss") }
// @@WANT@@
true
// @@VALUE2@@
[{ h: { x: 3 } }, "t"]
// @@TYPE2@@
(Holder | string)[]
// @@PROOF2@@
const e0 = v[0]
if e0 is Holder { print(e0.h.x ?? 0) } else { print("miss") }
// @@WANT2@@
3
