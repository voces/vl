// A `let` bound to a call of a function returning one of two generic functions, called at one
// type, then written with another such call and delivered after the write at each position,
// where it is called at a type it was not called at before the write (D10322).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function idg<T>(t: T): T { return t }
function kg<T>(t: T): T { return t + t }
function app<T>(g: (x: T) => T, v: T): T { return g(v) }
function pick(n: i32) {
  if n > 1 { return kg }
  return idg
}
let h = pick([1, 2].length)
const i0 = h(3)
h = pick([1].length)
const i1 = h(4)
// @@VALUE@@
h("y") + "z"
// @@TYPE@@
string
// @@PROOF@@
print(v.length * 100 + i0 * 10 + i1)
// @@WANT@@
264
// @@VALUE2@@
app(h, 2.5)
// @@TYPE2@@
f64
// @@PROOF2@@
print(v * 2.0 + 0.5)
// @@WANT2@@
5.5
