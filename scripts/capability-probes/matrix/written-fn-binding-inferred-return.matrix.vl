// D5062: a written function binding of a generic is returned from a function with an inferred
// result, and the call that fixes its type is the caller's, through the call result. The
// generic's type parameter stays open; the annotated face annotates only the destination.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __k<T>(x: T): T {
  return x
}
function __mk() {
  let g = __k
  g = __k
  return g
}
// @@VALUE@@
__mk()
// @@TYPE@@
(x: i32) => i32
// @@PROOF@@
print(v(41))
// @@WANT@@
41
// @@TEST@@
v(0) == 0
// @@HIT@@
print(v(41))
// @@MISS@@
print(0)
