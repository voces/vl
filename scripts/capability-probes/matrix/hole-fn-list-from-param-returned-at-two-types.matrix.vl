// A list literal built from a function's un-annotated parameter, handed an un-annotated function,
// delivered at every position and read back by a `.map` callback that calls its element at
// `i32`, while a second call handed the same function is read back at `f64` (D9602). The proof
// prints the `f64` read only when the `i32` read was right.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __inc(a) { return a + 1 }
function __give(g) {
  return [g, g]
}
// @@VALUE@@
__give(__inc)
// @@TYPE@@
((a: i32) => i32)[]
// @@PROOF@@
if v.map((f) => f(3))[1] == 4 {
  print(__give(__inc).map((f) => f(1.25))[0])
} else {
  print("wrong i32 read")
}
// @@WANT@@
2.25
