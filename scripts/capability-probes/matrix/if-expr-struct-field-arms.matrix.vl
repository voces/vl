// D1577 — an if-EXPRESSION whose ARMS are struct-typed FIELD READS, at every delivery
// position and in both faces. Reported by the glean session as VL-035.
//
// A nested-struct field is STORED `(ref null $V)` while its TYPE is not nullable, so
// `struct.get` yields the niche and every DELIVERY into a `(ref $V)` destination owes
// `ref.as_non_null` (D1115). The return, argument and binding boundaries made it; the
// if-expression ARM did not, so `if c { s.ret } else { s.ret }` pushed `(ref null $V)`
// under a `(ref $V)` blocktype: `vl check` rc 0, engine refuses the module.
//
// The PROOF discriminates on the VALUE, not just the shape: `mk()` returns `{ i: 9 }`, so a
// cell that took the wrong arm prints `other`. VALUE2 is the MIXED spelling — one field-read
// arm beside one CALL arm — which is red for the same reason and must move with it.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type V = { i: i32 }
type S = { ret: V, flag: boolean }
function mkS(): S { { ret: { i: 7 }, flag: true } }
function mk(): V { { i: 9 } }
const src = mkS()
function truthy() { 1 == 1 }
// @@VALUE@@
if truthy() { src.ret } else { src.ret }
// @@TYPE@@
V
// @@FALLBACK@@
mk()
// @@TEST@@
v.i == 7
// @@HIT@@
print("seven")
// @@MISS@@
print("other")
// @@WANT@@
seven
// @@VALUE2@@
if truthy() { src.ret } else { mk() }
// @@WANT2@@
seven
