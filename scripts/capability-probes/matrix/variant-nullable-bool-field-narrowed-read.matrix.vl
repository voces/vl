// A `boolean | null` field narrowed by `is boolean` and read inside the narrowing, off a union member, so the read takes the variant arm:
// the read is the i32 the field's niche holds, as legacy reads it. The value is the narrowing
// `if`, so each position delivers the read's arm.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type A = { kind: "a", f: boolean | null }
type B = { kind: "b", n: i32 }
type U = A | B
const o: A = { kind: "a", f: true }
const u: U = o
// @@VALUE@@
if o.f is boolean { o.f } else { false }
// @@TYPE@@
boolean
// @@PROOF@@
print(v)
// @@WANT@@
true
// @@VALUE2@@
if o.f is boolean { !o.f } else { true }
// @@TYPE2@@
boolean
// @@PROOF2@@
print(v == false)
// @@WANT2@@
true
