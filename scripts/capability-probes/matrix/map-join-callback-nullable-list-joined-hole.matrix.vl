// D10794's shape: a hole function's `.map` callback returns its element or `null`, and the
// result list is joined by an `if` and read inside the instance, so its elements are
// `string | null` there and a null element must read as null at every position.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function opt(x) {
  const c = 1 > 0
  const m = [x].map((e) => {
    if e != null { return e }
    return null
  })
  const n = if c { m } else { m }
  return n[0]
}
const nul: string | null = null
// @@VALUE@@
opt(nul)
// @@TYPE@@
string | null
// @@TEST@@
v == null
// @@HIT@@
print("null")
// @@MISS@@
print("value")
// @@WANT@@
null
// @@VALUE2@@
opt(4)
// @@TYPE2@@
i32 | null
// @@PROOF2@@
print(v)
// @@WANT2@@
4
