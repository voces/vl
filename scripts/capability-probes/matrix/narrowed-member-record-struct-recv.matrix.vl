// D17027 — a record field narrowed to one record member, off a plain record receiver,
// delivered at every position. Inside
// the guard the read is the member's record (`boxedArmOfMember`); a union destination owes the
// box again, a record destination the record itself. Graded --before / --after the fix.
//
// Format: scripts/capability-probes/README.md, "Template format".

// @@PRELUDE@@
type A = { v: i32 }
type B = { s: string, w: i32 }
type W = { h: A | B }
const z: W = { h: { s: "b", w: 1 } }
function mkA(): A | B { return { v: 0 } }
function showU(h: A | B) { return if h is B { h.s } else { "A" } }
function showB(b: B) { return b.s }
type C = { t: string }
type WN = { h: A | B | null }
function showABC(h: A | B | C) { return if h is B { h.s } else if h is A { "A" } else { "C" } }
function showBC(h: B | C) { return if h is B { h.s } else { "C" } }
function showN(h: A | B | null) { return if h is B { h.s } else if h == null { "null" } else { "A" } }
function idT<T>(x: T): T { return x }

// @@VALUE@@
z.h

// @@TYPE@@
A | B

// @@GUARD@@
z.h is B

// @@FALLBACK@@
mkA()

// @@TEST@@
v is B

// @@HIT@@
print(v.s)

// @@MISS@@
print("A")

// @@WANT@@
b

// @@CELL_record_param@@
if z.h is B { print(showB(z.h)) }

// @@CELL_union_param@@
if z.h is B { print(showU(z.h)) }

// @@CELL_early_return_union@@
function f(q: W) {
  if !(q.h is B) { return }
  print(showU(q.h))
}
f(z)

// @@CELL_early_return_record@@
function f(q: W) {
  if q.h is A { return }
  print(showB(q.h))
}
f(z)

// @@CELL_interpolation@@
// want: b1
if z.h is B { print("\{z.h.s}\{z.h.w}") }

// @@CELL_wider_union@@
if z.h is B { print(showABC(z.h)) }

// @@CELL_narrower_union@@
if z.h is B { print(showBC(z.h)) }

// @@CELL_generic_dest@@
if z.h is B { print(showB(idT(z.h))) }

// @@CELL_nullable_field_union@@
const wn: WN = { h: { s: "b", w: 1 } }
if wn.h is B { print(showN(wn.h)) }

// @@CELL_param_receiver@@
// want: b then b
function f(q: W) {
  if q.h is B { print(showU(q.h)) }
  if q.h is B { print(showABC(q.h)) }
}
f({ h: { s: "b", w: 1 } })

// @@CELL_local_receiver@@
function f(q: W) {
  let k = q
  if k.h is A { return }
  print(showU(k.h))
}
f({ h: { s: "b", w: 1 } })
