// A `K | null` atom cell narrowed past one member, delivered to every position at a
// `string | null`: the id decodes to its member string, and the null stays null.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type __K = "ab" | "cd"
function __mk(i: i32): __K | null { return if i > 1 { "cd" } else if i > 0 { "ab" } else { null } }
// @@SETUP@@
const __m: __K | null = __mk(1)
// @@GUARD@@
__m != "cd"
// @@FALLBACK@@
null
// @@VALUE@@
__m
// @@TYPE@@
string | null
// @@PROOF@@
print(v ?? "none")
// @@WANT@@
ab
// @@TEST@@
v == "ab"
// @@HIT@@
print("ab")
// @@MISS@@
print("no")
