// D7965: the `K | null` arm an `is i32` test leaves of an `i32 | K | null` box, printed. The
// box comes out of a generic body at an open `T`, so no position annotates the niche for it.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type __AB = "a" | "b"
function __pick<T>(x: T | __AB | null): T | __AB | null { return x }
// @@VALUE@@
__pick<i32>("b")
// @@TYPE@@
i32 | __AB | null
// @@WANT@@
b
// @@TEST@@
v is i32
// @@HIT@@
print(0)
// @@MISS@@
print(v)
// @@VALUE2@@
__pick<i32>(null)
// @@TYPE2@@
i32 | __AB | null
// @@PROOF2@@
if v is i32 { print(0) } else { print(v) }
// @@WANT2@@
null
