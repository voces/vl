// D6650 — a `v128 | string` union tested with `is v128` whose hit branch makes a call the checker
// treats as a possible writer: the miss branch still reads the complement, not the box.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function pick(n: i32): v128 | string {
  if n < 0 { return "neg" }
  __splat_i32x4__(n)
}
// @@VALUE@@
pick(-1)
// @@TYPE@@
v128 | string
// @@TEST@@
v is v128
// @@HIT@@
const q = __splat_i32x4__(3)
print(__extract_lane_i32x4__(q, 0))
// @@MISS@@
print(v + "!")
// @@WANT@@
neg!
// @@VALUE2@@
pick(7)
// @@TYPE2@@
v128 | string
// @@PROOF2@@
if v is v128 { const q = __splat_i32x4__(1); print(__extract_lane_i32x4__(v, 0)) } else { print(v) }
// @@WANT2@@
7
