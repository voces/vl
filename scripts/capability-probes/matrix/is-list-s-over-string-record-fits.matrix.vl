// `v is S[]` over `string[] | P[]`, `v` from the string arm. Element kinds that
// store alike share a box tag, and the test must still answer by the value (D17052).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type S = "a" | "b"
type K = 1 | 2
type P = { q: i32 }
function mk(c: boolean): string[] | P[] {
  const a: string[] = ["a", "b"]
  const b: P[] = [{ q: 1 }]
  if c { return a }
  return b
}
// @@VALUE@@
mk(true)
// @@TYPE@@
string[] | P[]
// @@TEST@@
v is S[]
// @@HIT@@
print(true)
// @@MISS@@
print(false)
// @@WANT@@
true
