// D1114 — a NESTED-STRUCT field read through an `Arm | null` receiver. The union
// DECLARATION alone is the ingredient (ablated: delete it and the same read runs; read the
// arm's SHALLOW field instead and it runs), because an arm has no struct-table row and the
// code-15 field's own heap cannot answer for a nested read.
//
// The GUARD is what makes the receiver narrowed; without it the read is not admitted at all.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type Inner = { p: i32 }
type S = { i: Inner, n: i32 }
type Other = { o: string }
type U = S | Other
function g(n: i32): S | null {
  if n == 0 { return { i: { p: 5 }, n: 1 } }
  null
}
// @@SETUP@@
const src = g(0)
// @@GUARD@@
src != null
// @@VALUE@@
src.i
// @@TYPE@@
Inner
// @@FALLBACK@@
{ p: 0 }
// @@PROOF@@
print(v.p * 2)
// @@WANT@@
10
