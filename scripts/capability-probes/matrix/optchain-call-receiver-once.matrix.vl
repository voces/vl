// D1671 — a `?.` whose receiver is a CALL and whose leaf field is a nullable struct. The
// lowering emitted the receiver twice — once for the `ref.is_null` test and once to read the
// field off it — so a receiver with a side effect ran twice at `vl check` rc 0.
//
// The proof is `calls == marks`, not the chain's value: `mark()` runs once per delivery and
// the receiver once per EVALUATION, so a cell that re-evaluates prints `false` whatever the
// position's delivery count is — the only way a silent double evaluation reaches a grader
// that reads output.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type I = { z: i32 }
type B = { y: I | null }
let calls = 0
let marks = 0
function mark(): boolean {
  marks = marks + 1
  true
}
function mkB(): B | null {
  calls = calls + 1
  { y: { z: 3 } }
}
// @@VALUE@@
mark() && mkB()?.y == null
// @@TYPE@@
boolean
// @@FALLBACK@@
true
// @@TEST@@
v == false
// @@HIT@@
print(calls == marks)
// @@MISS@@
print(0)
// @@WANT@@
true
