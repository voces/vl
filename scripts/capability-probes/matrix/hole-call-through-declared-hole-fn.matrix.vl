// A call through an un-annotated parameter bound to a declared un-annotated function, handed a
// lambda whose parameter only that function's body fixes (`lap` calls `g(1)`): the call is typed as
// the direct call `lap((a) => a * 10)` is, `i32` (D16334, D16335). Cells: two hole hops, a map, a
// record field, a list, a loop, a call of the parameter inside a nested function or through an
// alias, a shadowing binding, an escaping parameter, and an annotated binding of another type,
// which is refused.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function lap(g) { return g(1) + 1 }
function use(k) { return k((a) => a * 10) }
// @@VALUE@@
use(lap)
// @@TYPE@@
i32
// @@PROOF@@
print(v)
// @@WANT@@
11
// @@CELL_direct_call@@
print(lap((a) => a * 10))
// @@CELL_two_hops@@
function use2(k) { return use(k) }
print(use2(lap))
// @@CELL_bound_map@@
const m = Map()
m["k"] = use(lap)
const mv = m["k"]
print(mv)
// @@CELL_bound_map_set@@
const m = Map()
m.set("k", use(lap))
const mv = m.get("k")
if mv != null { print(mv) }
// @@CELL_record_field@@
const r = { x: use(lap) }
print(r.x)
// @@CELL_list_push@@
const l = []
l.push(use(lap))
print(l[0])
// @@CELL_loop@@
// want: 44
let acc = 0
for i in 0 to 3 { acc = acc + use(lap) }
print(acc)
// @@CELL_wrong_annotation@@
// owed: cannot assign i32
const s: boolean = use(lap)
print(s)
// @@CELL_nested_lambda_call@@
function lapN(g) { const h = () => g(1); return h() + 1 }
print(use(lapN))
// @@CELL_nested_fn_call@@
function lapF(g) {
  function inner() { return g(1) }
  return inner() + 1
}
print(use(lapF))
// @@CELL_nested_wrong_annotation@@
// owed: cannot assign i32
function lapN(g) { const h = () => g(1); return h() + 1 }
const s: boolean = use(lapN)
print(s)
// @@CELL_shadowed_param@@
function lapS(g) {
  if true {
    const g = (s: string) => s.length
    if g("abc") > 99 { return 0 }
  }
  return g(1) + 1
}
print(use(lapS))
// @@CELL_escaped_param@@
// want: 31
function other(f) { return f(2) }
function lapE(g) { const o = other(g); return g(1) + o + 1 }
print(use(lapE))
// @@CELL_escaped_wrong_annotation@@
// owed: cannot assign i32
function other(f) { return f(2) }
function lapE(g) { const o = other(g); return g(1) + o + 1 }
const s: boolean = use(lapE)
print(s)
// @@CELL_aliased_param@@
function lapA(g) { const h = g; return h(1) + 1 }
print(use(lapA))
// @@CELL_aliased_let_param@@
function lapL(g) { let h = g; return h(1) + 1 }
print(use(lapL))
// @@CELL_aliased_wrong_annotation@@
// owed: cannot assign i32
function lapA(g) { const h = g; return h(1) + 1 }
const s: boolean = use(lapA)
print(s)
