// A call through an un-annotated parameter bound to a declared un-annotated function, handed a
// lambda whose parameter only that function's body fixes (`lap` calls `g(1)`): the call is typed as
// the direct call `lap((a) => a * 10)` is, `i32` (D16334, D16335). Cells: two hole hops, a map, a
// record field, a list, a loop, and an annotated binding of another type, which the check refuses.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function lap(g) { return g(1) + 1 }
function use(k) { return k((a) => a * 10) }
// @@VALUE@@
use(lap)
// @@TYPE@@
i32
// @@PROOF@@
print(v)
// @@WANT@@
11
// @@CELL_direct_call@@
print(lap((a) => a * 10))
// @@CELL_two_hops@@
function use2(k) { return use(k) }
print(use2(lap))
// @@CELL_bound_map@@
const m = Map()
m["k"] = use(lap)
const mv = m["k"]
print(mv)
// @@CELL_bound_map_set@@
const m = Map()
m.set("k", use(lap))
const mv = m.get("k")
if mv != null { print(mv) }
// @@CELL_record_field@@
const r = { x: use(lap) }
print(r.x)
// @@CELL_list_push@@
const l = []
l.push(use(lap))
print(l[0])
// @@CELL_loop@@
// want: 44
let acc = 0
for i in 0 to 3 { acc = acc + use(lap) }
print(acc)
// @@CELL_wrong_annotation@@
// owed: cannot assign i32
const s: boolean = use(lap)
print(s)
