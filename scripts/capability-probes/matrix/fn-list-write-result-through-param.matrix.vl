// D16230: a callee writes a function of another result type into an inferred list through an
// un-annotated parameter, and its result is that assignment's value. The result is delivered to
// each position, and a call through it and through the element both run the written function.
//
// Since the 2026-11-14 return rule (DECISIONS) a block body returns only through `return`, so
// the write is returned as `return <write>`; an assignment's value is its right side (D2497).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __inc(a) { return a + 1 }
function __half(a) { return a / 2.0 }
function __put(ys) { return ys[0] = __half }
const __xs = [__inc]
// @@VALUE@@
__put(__xs)
// @@TYPE@@
(a: i32) => f64
// @@PROOF@@
print(v(4) + __xs[0](3))
// @@WANT@@
3.5
