// A list-literal spread of a record list into a list of a record union: each source element
// is boxed under its own arm, at every position, in both faces.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type Cx = { r: i32 }
type Dx = { s: string }
const src: Cx[] = [{ r: 3 }, { r: 4 }]
const dx: Dx = { s: "d" }
// @@VALUE@@
[...src, dx]
// @@TYPE@@
(Cx | Dx)[]
// @@PROOF@@
const e = v[1]
const d = v[2]
if e is Cx && d is Dx {
  const n = e.r * 10 + v.length
  const t = d.s
  print("\{t}\{n}")
} else { print("miss") }
// @@WANT@@
d43
// @@SKIP@@
is_in_if: the value is a list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
