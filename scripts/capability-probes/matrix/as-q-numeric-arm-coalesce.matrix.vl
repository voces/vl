// D1517 — `u as? i32 ?? d` over a value union. The cast's result is `i32 | null`, which is a
// value-union BOX (a scalar has no spare null niche), and that spelling exists NOWHERE else in
// the program: no annotation, no `type` declaration, no inferred binding. D1041 registers the
// row for a NUMERIC-operand cast; a UNION operand is excluded from that gate by construction,
// so the box was never minted and the `??` asked an unregistered row for its atoms.
//
// The template must NOT spell `i32 | null` anywhere — any use of it registers the row and is
// the rescue the row records. The `??` is the ingredient: splitting it into a binding plus a
// `!= null` test runs at every scope, before and after.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type Val = i32 | string
function mkval(): Val { return 3 }
function mkval2(): Val { return "s" }
// @@VALUE@@
mkval() as? i32 ?? -1
// @@TYPE@@
i32
// @@PROOF@@
print(v)
// @@WANT@@
3
// @@TEST@@
v > 0
// @@HIT@@
print(v)
// @@MISS@@
print(0)
// @@VALUE2@@
mkval2() as? i32 ?? -1
// @@TYPE2@@
i32
// @@PROOF2@@
print(v)
// @@WANT2@@
-1
