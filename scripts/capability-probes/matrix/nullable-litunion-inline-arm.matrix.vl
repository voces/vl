// A nullable literal union delivered into a union that spells it inline, and, as the second
// instance, through a nested alias (`W = U | boolean`, `U = A | i32`), which reaches the literal
// two aliases down. Both faces grade the same: the cells that refuse are D4041's (a function-local
// binding, an assignment, a returned parameter) at every spelling.
// The single-alias spelling is `nullable-litunion-through-alias-arm.matrix.vl`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type A = ("a" | "b") | null
type U = A | i32
type W = U | boolean
const ga: ("a" | "b") | null = "a"
const gb: A = "b"
// @@VALUE@@
ga
// @@TYPE@@
("a" | "b") | null | i32
// @@TEST@@
v == null
// @@HIT@@
print("none")
// @@MISS@@
print(v)
// @@WANT@@
a
// @@VALUE2@@
gb
// @@TYPE2@@
W
// @@PROOF2@@
if v == null { print("none") } else { print(v) }
// @@WANT2@@
b
