// D3073's family: a named function whose result is a record, delivered as a function
// returning a union holding it. The value keeps its own signature, so every position must
// hand the call an adapter that boxes the result.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function mkC(): Circle { return { r: 7 } }
function mkC2(): Circle { return { r: 8 } }
// @@VALUE@@
mkC
// @@TYPE@@
() => Shape
// @@PROOF@@
const __s = v()
if __s is Circle { print(__s.r) } else { print(0) }
// @@WANT@@
7
// @@VALUE2@@
mkC2
// @@TYPE2@@
() => Shape
// @@PROOF2@@
const __s2 = v()
if __s2 is Circle { print(__s2.r) } else { print(0) }
// @@WANT2@@
8
// @@SKIP@@
is_in_if: the value is a function, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
