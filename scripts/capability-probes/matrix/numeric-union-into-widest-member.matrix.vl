// D2611 and D3450: a union of numeric types delivered where its widest member is declared. The
// annotated face converts the `i32` member held into `f64` at every position; the un-annotated
// face keeps the union, whose `+` dispatches at the `i32` member beside a float literal. Both
// read `7.5`.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function src(c: boolean, x: f64, y: i32): i32 | f64 {
  if c { return x }
  y
}
// @@SETUP@@
const got = src(false, 2.5, 7)
// @@VALUE@@
got
// @@TYPE@@
f64
// @@PROOF@@
print(v + 0.5)
// @@WANT@@
7.5
