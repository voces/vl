// A5 / D1814 — the optional call whose receiver is a LIST ELEMENT. The guard names the
// receiver twice, so an index read has to be one the lowering may re-read; `exprReReadable`
// admits it exactly when its array and its index are themselves places.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type P = { n: i32 }
function twice(self: P) { self.n * 2 }
const items: (P | null)[] = [{ n: 21 }, null]
// @@VALUE@@
items[0]?.twice()
// @@TYPE@@
i32 | null
// @@FALLBACK@@
null
// @@PROOF@@
print(v ?? 0)
// @@WANT@@
42
