// D5341 — a record literal whose field is read from a binding at a lone literal type, at every
// delivery position and in both faces. The un-annotated face had no record shape for the
// field; the TEST reads the literal field and the scalar beside it, so a record built at the
// wrong shape cannot take the HIT branch.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type W = "a" | "b"
const x: "a" = "a"
// @@VALUE@@
{ f: x, g: 1 }
// @@TYPE@@
{ f: "a", g: i32 }
// @@TEST@@
v.f == "a" && v.g == 1
// @@HIT@@
print(v.f)
// @@MISS@@
print("miss")
// @@WANT@@
a
