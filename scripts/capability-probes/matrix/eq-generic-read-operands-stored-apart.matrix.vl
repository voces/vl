// `==` in a generic body over reads of two records of one field set stored apart, the result
// delivered at every position: each read compares field by field at the instance (D16470).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __eqf<T, U>(a: {v: T}, b: {v: U}): boolean { return a.v == b.v }
// @@VALUE@@
__eqf({ v: { f: 1 } }, { v: { f: 1.0 } })
// @@TYPE@@
boolean
// @@TEST@@
v
// @@HIT@@
print(1)
// @@MISS@@
print(0)
// @@WANT@@
1
// @@CELL_element_read@@
// want: true
function __eqi<T, U>(a: T[], b: U[]): boolean { return a[0] == b[0] }
print(__eqi([{ f: 1 }], [{ f: 1.0 }]))
// @@CELL_not_equal@@
// want: false
function __ne<T, U>(a: {v: T}, b: {v: U}): boolean { return a.v != b.v }
print(__ne({ v: { f: 1 } }, { v: { f: 1.0 } }))
// @@CELL_nested_record@@
// want: true then false
print(__eqf({ v: { f: 1, g: { h: 2 } } }, { v: { f: 1.0, g: { h: 2.0 } } }))
print(__eqf({ v: { f: 1, g: { h: 2 } } }, { v: { f: 1.0, g: { h: 3.0 } } }))
// @@CELL_nullable_record@@
// want: true then false
const __x: { f: i32 } | null = { f: 1 }
const __y: { f: f64 } | null = { f: 1.0 }
print(__eqf({ v: __x }, { v: __y }))
print(__eqf({ v: __x }, { v: null }))
