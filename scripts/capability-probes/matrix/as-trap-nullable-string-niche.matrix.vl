// D1812 — `x as! T` over a niche-repped `T | null`. The operand carries no tag (`ref.null` IS
// the absent arm), so the trio's arm test is the null test and the value rides through
// unchanged; the trapping form is `ref.as_non_null`, one opcode and no heap index.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function s1(): string | null { return "ok" }
function s2(): string | null { return "yes" }
// @@VALUE@@
s1() as! string
// @@TYPE@@
string
// @@PROOF@@
print(v)
// @@WANT@@
ok
// @@VALUE2@@
s2() as! string
// @@TYPE2@@
string
// @@PROOF2@@
print(v)
// @@WANT2@@
yes
// @@SKIP@@
is_in_if: the value is a plain string, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
