// A record literal whose field is initialised by a call of a function with an un-annotated
// parameter returning a list of functions with un-annotated parameters, read back through the
// field and called. The field takes the list type the call's instance returns (D9714).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __inc(a) { return a + 1 }
function __dbl(a) { return a * 2 }
function __give(_n) {
  return [__inc, __dbl]
}
// @@VALUE@@
{ xs: __give(1) }
// @@TYPE@@
{xs: ((a: i32) => i32)[]}
// @@PROOF@@
print(v.xs[1](3) + v.xs[0](1))
// @@WANT@@
8
// @@TEST@@
v.xs.length == 2
// @@HIT@@
print(v.xs[1](3) + v.xs[0](1))
// @@MISS@@
print(0)
