// D1695 — the same capture at the ARENA reader rather than the node one. The nested field's
// value is an IDENT, so its element row is resolved by `structRowOfObjFieldSet`, a field-set
// scan whose per-field test compares CODES; every union box is code 16 whatever it boxes, so
// the first box row in the table wins and the outer row records an element it does not have.
//
// The value boxes `i32 | boolean` and holds the i32 `7`; `type Inner`'s box is
// `string | boolean`, and the disagreement is a module that fails to validate rather than a
// mis-read value. Graded by PRINTED VALUE, like its node-reader siblings.
//
// `type Inner` is never named by a value. There is deliberately NO `type H` here: the outer
// declared row is D1694's ingredient, and this template must fail for its own reason.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type U1 = i32 | boolean
type U2 = string | boolean
type Inner = { xs: U2 }
function u1(): U1 { return 7 }
function u1b(): U1 { return 8 }
const held: { xs: U1 } = { xs: u1() }
const heldB: { xs: U1 } = { xs: u1b() }
// @@VALUE@@
{ f: held }
// @@TYPE@@
{ f: { xs: U1 } }
// @@PROOF@@
print(v.f.xs)
// @@WANT@@
7
// @@VALUE2@@
{ f: heldB }
// @@TYPE2@@
{ f: { xs: U1 } }
// @@PROOF2@@
print(v.f.xs)
// @@WANT2@@
8
// @@SKIP@@
is_in_if: the value is a struct, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
