// D2196's nested face — an `i32[][]` delivered where a `readonly (readonly f64[])[]` is declared
// takes the converting copy element by element, where the source is a `const` list literal of
// fresh lists read only at the delivery; a position that re-binds the root first keeps the
// refusal for the same reason as the cells below. The proof divides an inner element, so an inner list left
// at `i32` prints `0` where the copy prints `0.5`. Own cells grade the source shapes: fresh
// calls run; an aliased inner, a written root, a root read again and a parameter root each keep
// the refusal, since a copy would miss a later write to an inner list: a clause-2 gap that waits
// on a nested view (D16950), not a contract, so those cells grade as refusals.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function mk(): i32[] { return [5, 6] }
function show(v: readonly (readonly f64[])[]) { print(v[0][1] / 4) }
// @@SETUP@@
const a: i32[][] = [[1, 2], [3]]
// @@VALUE@@
a
// @@TYPE@@
readonly (readonly f64[])[]
// @@PROOF@@
show(v)
// @@WANT@@
0.5
// @@CELL_fresh_calls@@
// want: 1.5
const b: i32[][] = [mk(), [7]]
show(b)
// @@CELL_aliased_inner@@
const x: i32[] = [1, 2]
const c: i32[][] = [x]
show(c)
x.push(2)
// @@CELL_inner_read_out@@
const c: i32[][] = [[1, 2]]
show(c)
const y = c[0]
y.push(9)
// @@CELL_written_root@@
const c: i32[][] = [[1, 2]]
c[0].push(3)
show(c)
// @@CELL_param_root@@
function g(p: i32[][]) { show(p) }
g([[1, 2]])
