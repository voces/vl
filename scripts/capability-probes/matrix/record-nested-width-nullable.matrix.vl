// `record-nested-width-existing` with the nested record behind `| null` on both sides: the record
// is taken at its own type, its nullable field included (D16705, extending D3431). The cells add a
// literal source, a declared parameter, aliasing through a narrowed read, a `null` written through
// the annotated name (it fits), a record that misfits, and the one-layout contract (D4054).
// @@PRELUDE@@
function mk(): { pet: { legs: i32, purr: boolean } | null } { return { pet: { legs: 4, purr: true } } }
// @@VALUE@@
mk()
// @@TYPE@@
{ pet: { legs: i32 } | null }
// @@PROOF@@
print(v.pet?.legs)
// @@WANT@@
4
// @@SKIP@@
array_push: an existing narrow list stores one record layout (D4054); graded owed by CELL_existing_narrow_list
map_value: an existing narrow map stores one record layout (D4054)
map_set: same as map_value
// @@CELL_literal_binding@@
// want: 4 then true
const sv: { pet: { legs: i32, purr: boolean } | null } = { pet: { legs: 4, purr: true } }
const u__A__ = sv
print(u.pet?.legs)
print(sv.pet?.purr)
// @@CELL_existing_binding@@
// want: 4 then true
const sv = mk()
const u__A__ = sv
print(u.pet?.legs)
print(sv.pet?.purr)
// @@CELL_argument_declared@@
// want: 4 then true
function show(u: { pet: { legs: i32 } | null }) { print(u.pet?.legs) }
const sv = mk()
show(sv)
print(sv.pet?.purr)
// @@CELL_returned_annotated@@
// want: 4
const sv = mk()
function get(): { pet: { legs: i32 } | null } { return sv }
print(get().pet?.legs)
// @@CELL_field_init@@
// want: 4
const sv = mk()
const h: { u: { pet: { legs: i32 } | null } } = { u: sv }
print(h.u.pet?.legs)
// @@CELL_list_literal_element@@
// want: 4
const sv = mk()
const xs: { pet: { legs: i32 } | null }[] = [sv]
print(xs[0].pet?.legs)
// @@CELL_write_through_narrowed@@
// want: 5 then true
const sv = mk()
const u__A__ = sv
const p = u.pet
if p != null { p.legs = 5 }
print(sv.pet?.legs)
print(sv.pet?.purr)
// @@CELL_write_null_fits@@
// want: true
const sv = mk()
const u__A__ = sv
u.pet = null
print(sv.pet == null)
// @@CELL_write_misfit@@
// owed: purr
const sv = mk()
const u__A__ = sv
u.pet = { legs: 3 }
print(sv.pet?.purr)
// @@CELL_existing_narrow_list@@
// owed: an existing record keeps its own record layout
const xs: { pet: { legs: i32 } | null }[] = []
xs.push(mk())
print(xs[0].pet?.legs)
