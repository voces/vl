// D16958: a chain that ends in a push made inside a function, through its parameters. The
// adoption closure follows no edge into a parameter, so this grades what that delivery does
// today at every position: it is refused in the function body, chain or no chain.

// @@PRELUDE@@
type J = { f: i32 | null }
function put(ys, q) {
  ys.push(q)
  return 0
}

// @@SETUP@@
const xs = [{ f: 4 }]
const r0 = { f: 9 }
let r1 = { f: 1 }
r1 = r0
put(xs, r1)

// @@VALUE@@
xs

// @@TYPE@@
J[]

// @@PROOF@@
print(v[1].f ?? 0)

// @@WANT@@
9
