// A generic function delivered to each position, then written into a list literal beside a
// fixed-type `i32` function and handed straight to a generic whose parameter leaves the element's
// type open, called at `i32` (D10204). The literal binds the generic's type parameter at `i32`
// through its fixed element, ahead of the open one.
// `fn-value-generic-list-literal-arg-open.matrix.vl` is the open twin.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function id<T>(x: T): T { x }
function __inc(x: i32): i32 { x + 1 }
function __run<U>(a: ((x: U) => U)[], u: U): U { a[1](u) }
// @@VALUE@@
id
// @@TYPE@@
(x: i32) => i32
// @@PROOF@@
print(__run([v, __inc], 2) * 10 + v(5))
// @@WANT@@
35
