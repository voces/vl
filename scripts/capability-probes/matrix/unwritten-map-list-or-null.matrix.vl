// D16047 (owner ruling (a1)): a list of unwritten `Map()`s joined with `null` in an inferred return (`{[_]: _}[] | null`). An element nothing writes fits every
// `is` of its kind, and a write through a narrowing pins it as a direct write does.
// The annotated face spells the settled type; the vacuous tests are un-annotated cells.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function pick(c: boolean) { if c { return [Map()] } return null }
// @@VALUE@@
pick(true)
// @@TYPE@@
{[string]: i32}[] | null
// @@TEST@@
v != null
// @@HIT@@
print("collection")
// @@MISS@@
print("other")
// @@WANT@@
collection
// @@VALUE2@@
pick(false)
// @@TYPE2@@
{[string]: i32}[] | null
// @@PROOF2@@
if v != null { print("collection") } else { print("null") }
// @@WANT2@@
null
