// D14041 — `v is K[]` over a `K[] | i32[] | string` box: both list arms share the `i32[]` tag,
// so the test reads every element (D4771). `[1, 5]` holds a `5` and does not fit.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type K = 0 | 1
function mk(k: i32): K[] | i32[] | string {
  if k == 0 { return "s" }
  const w: i32[] = if k == 1 { [1, 5] } else { [1, 1] }
  return w
}
// @@VALUE@@
mk(1)
// @@TYPE@@
K[] | i32[] | string
// @@TEST@@
v is K[]
// @@HIT@@
print(-1)
// @@MISS@@
print(7)
// @@WANT@@
7
// @@VALUE2@@
mk(2)
// @@TYPE2@@
K[] | i32[] | string
// @@PROOF2@@
if v is K[] { print(v.length) } else { print(9) }
// @@WANT2@@
2
