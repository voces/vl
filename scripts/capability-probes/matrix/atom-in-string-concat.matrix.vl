// A string concatenation with a literal-union atom operand, delivered to every position: the IR
// builds the string op, decoding the atom to its member string as legacy's writer does.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type __K = "ab" | "cd"
function __mk(i: i32): __K { return if i > 0 { "cd" } else { "ab" } }
// @@SETUP@@
const __k: __K = __mk(1)
// @@VALUE@@
"x" + __k
// @@TYPE@@
string
// @@PROOF@@
print(v)
// @@WANT@@
xcd
// @@TEST@@
v == "xcd"
// @@HIT@@
print("xcd")
// @@MISS@@
print("no")
