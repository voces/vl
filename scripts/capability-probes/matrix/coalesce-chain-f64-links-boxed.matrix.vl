// D17401: a `??` chain over `f64 | null` links whose default is another kind, so the chain's value
// is a union box. Each link logs: it runs at most once, left to right; a reached default and a
// short-circuit show which links ran. The inner link bound to a `const` first is the control.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
let log = ""
function f(): f64 | null {
  log = log + "f"
  return null
}
function g(): f64 | null {
  log = log + "g"
  return 1.5
}
function h(): f64 | null {
  log = log + "h"
  return null
}
// @@VALUE@@
f() ?? g() ?? "s"
// @@TYPE@@
f64 | string
// @@PROOF@@
print(v)
print(log == "fg" || log == "fgfg")
// @@TEST@@
v == 1.5
// @@HIT@@
print(v)
print(log == "fg" || log == "fgfg")
// @@MISS@@
print("miss")
// @@WANT@@
1.5 then true
// @@CELL_string_default@@
// want: 1.5 then fg
print(f() ?? g() ?? "s")
print(log)
// @@CELL_string_default_reached@@
// want: s then fh
print(f() ?? h() ?? "s")
print(log)
// @@CELL_string_four_links@@
// want: 1.5 then fhg
print(f() ?? h() ?? g() ?? "s")
print(log)
// @@CELL_string_compare@@
// want: true
const y = f() ?? g() ?? "s"
print(y == 1.5)
// @@CELL_string_in_function@@
// want: 1.5 then fg then s then fgfh
function k1() { print(f() ?? g() ?? "s") }
function k2() { print(f() ?? h() ?? "s") }
k1()
print(log)
k2()
print(log)
// @@CELL_number_default@@
// want: 1.5 then fg
print(f() ?? g() ?? 2)
print(log)
// @@CELL_number_default_reached@@
// want: 2 then fh
print(f() ?? h() ?? 2)
print(log)
// @@CELL_number_four_links@@
// want: 1.5 then fhg
print(f() ?? h() ?? g() ?? 2)
print(log)
// @@CELL_number_compare@@
// want: true
const y = f() ?? g() ?? 2
print(y == 1.5)
// @@CELL_number_in_function@@
// want: 1.5 then fg then 2 then fgfh
function k1() { print(f() ?? g() ?? 2) }
function k2() { print(f() ?? h() ?? 2) }
k1()
print(log)
k2()
print(log)
// @@CELL_bool_default@@
// want: 1.5 then fg
print(f() ?? g() ?? false)
print(log)
// @@CELL_bool_default_reached@@
// want: false then fh
print(f() ?? h() ?? false)
print(log)
// @@CELL_bool_four_links@@
// want: 1.5 then fhg
print(f() ?? h() ?? g() ?? false)
print(log)
// @@CELL_bool_compare@@
// want: true
const y = f() ?? g() ?? false
print(y == 1.5)
// @@CELL_bool_in_function@@
// want: 1.5 then fg then false then fgfh
function k1() { print(f() ?? g() ?? false) }
function k2() { print(f() ?? h() ?? false) }
k1()
print(log)
k2()
print(log)
// @@CELL_short_circuit@@
// want: 1.5 then g
print(g() ?? f() ?? "s")
print(log)
// @@CELL_inner_bound_control@@
// want: 1.5 then gf
const inner = g() ?? "s"
print(f() ?? inner)
print(log)
