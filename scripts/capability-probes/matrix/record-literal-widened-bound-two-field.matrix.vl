// D3195 — a bound record literal of two number literals, whose `v` a wider declared record
// stores as `f64` and whose `w` it keeps as `i32`, delivered to that record at every position.
// The literal is fresh, so it is built at the destination's record; `map_set` is the delivery
// D3195 added beside D2990's index store.
//
// The PROOF divides by 2.0 and adds the `i32` field, so a field left at its `i32` storage
// cannot print 3.5.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type R = { v: f64, w: i32 }
// @@SETUP@@
const l = { v: 1, w: 3 }
// @@VALUE@@
l
// @@TYPE@@
R
// @@PROOF@@
print(v.v / 2.0 + v.w)
// @@WANT@@
3.5
// @@SKIP@@
is_in_if: the value is a record, not a union; there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
