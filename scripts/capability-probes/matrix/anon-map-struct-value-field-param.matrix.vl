// D3123 (plumb PL-075) — an INFERRED record whose field is fed by a binding, not a `Map()`
// call: a map with a record value parameter. The field-code ladder coded a map only off a call and its spellability gate
// declines a `TyMap`, so the literal minted no row and its function's return had no shape.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type Pt = { x: i32, y: i32 }
function mkP(k: string, x: i32): {[string]: Pt} {
  const m: {[string]: Pt} = Map()
  m[k] = { x: x, y: x + 1 }
  m
}
function wrapP(m: {[string]: Pt}) { { pts: m } }
// @@VALUE@@
wrapP(mkP("p", 45))
// @@TYPE@@
{ pts: {[string]: Pt} }
// @@PROOF@@
const p = v.pts["p"]
if p != null { print(p.y) } else { print(-1) }
// @@WANT@@
46
// @@VALUE2@@
wrapP(mkP("q", 50))
// @@TYPE2@@
{ pts: {[string]: Pt} }
// @@PROOF2@@
const p2 = v.pts["q"]
if p2 != null { print(p2.x) } else { print(-1) }
// @@WANT2@@
50
// @@SKIP@@
is_in_if: the value is a struct, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
