// Q2 (owner, 2026-09-25): `Set<T>` is its own type over the map rep. A set delivered to any
// position keeps the set surface: `.values()` and `for x in s` yield the ELEMENTS (never the
// membership booleans the rep stores), and `.has` answers membership. The proof prints both.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function mkset(): Set<string> {
  const s = Set()
  s.add("e1")
  s.add("e2")
  s
}
function mkiset(): Set<i32> {
  const s: Set<i32> = Set()
  s.add(40)
  s.add(2)
  s
}
// @@VALUE@@
mkset()
// @@TYPE@@
Set<string>
// @@TEST@@
v.has("e2")
// @@HIT@@
let acc = ""
for x in v { acc = acc + x }
print(v.values()[0] + acc)
// @@MISS@@
print("miss")
// @@WANT@@
e1e1e2
// @@VALUE2@@
mkiset()
// @@TYPE2@@
Set<i32>
// @@PROOF2@@
let t = 0
for x in v { t = t + x }
print(t + v.values()[1] + v.keys().length)
// @@WANT2@@
46
