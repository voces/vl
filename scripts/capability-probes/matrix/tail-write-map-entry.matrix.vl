// D2544 — an un-annotated function whose tail statement writes a map to a map ENTRY, under a
// computed key, returns the map just stored.
//
// Since the 2026-11-14 return rule (DECISIONS) a block body returns only through `return`, so
// the write is returned as `return <write>`; an assignment's value is its right side (D2497).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __mk(): {[i32]: i32} {
  const n: {[i32]: i32} = Map()
  n[1] = 5
  return n
}
const __mm: {[i32]: {[i32]: i32}} = Map()
function __tw(k: i32) { return __mm[k] = __mk() }
// @@VALUE@@
__tw(1)
// @@TYPE@@
{[i32]: i32}
// @@PROOF@@
print(v[1] ?? 0)
// @@WANT@@
5
