// D4743/D4744/D4745 — `i32[] | K[]` over a numeric literal union `K`: two members that both
// spell `i32[]`, so the union is one list rep at every position.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type K = 0 | 1
// @@VALUE@@
[1, 0, 1]
// @@TYPE@@
i32[] | K[]
// @@TEST@@
v is i32[]
// @@HIT@@
print(v.length)
// @@MISS@@
print(-1)
// @@WANT@@
3
// @@VALUE2@@
[0, 1]
// @@TYPE2@@
i32[] | K[]
// @@PROOF2@@
if v is i32[] { print(v[1]) } else { print(-1) }
// @@WANT2@@
1
