// D3123 control — an INFERRED record whose field is a function value fed by a parameter and a
// binding. A function-typed field already had its own code, so every cell ran before the map
// fix; it pins that the map rung placed ahead of the recorded-type rungs does not claim it.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function wrapF(f: (i32) => i32, k: i32) {
  const g = (x: i32): i32 => x * k
  { f: f, g: g }
}
function inc(x: i32): i32 { x + 1 }
// @@VALUE@@
wrapF(inc, 3)
// @@TYPE@@
{ f: (i32) => i32, g: (i32) => i32 }
// @@PROOF@@
print(v.f(4) * 100 + v.g(5))
// @@WANT@@
515
// @@VALUE2@@
wrapF(inc, 2)
// @@TYPE2@@
{ f: (i32) => i32, g: (i32) => i32 }
// @@PROOF2@@
print(v.g(v.f(1)))
// @@WANT2@@
4
// @@SKIP@@
is_in_if: the value is a struct, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
