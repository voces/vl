// sunpa SP-043, the ref-list column: an empty list of records, and the f64 list inside each,
// read their type's shared backing; a push into one list must not show in another.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type P = { x: i32, ys: f64[] }
// @@VALUE@@
[]
// @@TYPE@@
P[]
// @@PROOF@@
v.push({ x: 4, ys: [] })
const other: P[] = []
other.push({ x: 9, ys: [] })
v[0].ys.push(0.5)
v.push({ x: 5, ys: [] })
const n = other.length * 10000 + v.length * 1000 + v[0].x * 100 + v[1].x * 10 + other[0].x
print(v[0].ys[0] + (n + other[0].ys.length + v[1].ys.length) as f64)
// @@WANT@@
12459.5
// @@VALUE2@@
[]
// @@PROOF2@@
print(v.length + 70)
// @@WANT2@@
70
// @@SKIP@@
is_in_if: the value is a list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
