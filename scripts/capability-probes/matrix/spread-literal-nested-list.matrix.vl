// A list-literal spread of a nested `i32[][]` joined with a fresh inner list: the copy keeps
// the inner lists shared, at every position, in both faces.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
const src: i32[][] = [[3], [4, 5]]
// @@VALUE@@
[...src, [6]]
// @@TYPE@@
i32[][]
// @@PROOF@@
print(v[1][1] * 10 + v[2][0] + v.length)
// @@WANT@@
59
// @@SKIP@@
is_in_if: the value is a list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
