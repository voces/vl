// A narrowed box-field read (D17048): a box local narrowed by a discriminant compare, its field
// `f` stored as i32 | string and read at each delivery position. Every cell prints the field's
// value, decoded where its storage is not the destination's rep.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type A = { tag: "b" | "c", f: i32 | string }
type B = { tag: "a", f: i32 | string }
function mk(n: i32): A | B {
  if n == 0 { return { tag: "b", f: 1 } }
  return { tag: "a", f: "s" }
}
// @@SETUP@@
const b = mk(2)
// @@GUARD@@
b.tag == "a"
// @@VALUE@@
b.f
// @@TYPE@@
i32 | string
// @@FALLBACK@@
1
// @@PROOF@@
if v is string { print(v) } else { print(0) }
// @@TEST@@
v is string
// @@HIT@@
print("s")
// @@MISS@@
print(0)
// @@CELL_param_return@@
function h(b: A | B)__A__ {
  if b.tag == "a" { return __V__ }
  return 1
}
const v = h(mk(2))
if v is string { print(v) } else { print(0) }
// @@CELL_param_binding@@
function h(b: A | B) {
  if b.tag == "a" {
    const v__A__ = __V__
    if v is string { print(v) } else { print(0) }
  }
}
h(mk(2))
// @@CELL_param_element@@
function h(b: A | B) {
  if b.tag == "a" {
    const xs__LA__ = [__V__]
    const v = xs[0]
    if v is string { print(v) } else { print(0) }
  }
}
h(mk(2))
// @@CELL_param_argument@@
function take(v: __TY__) { if v is string { print(v) } else { print(0) } }
function h(b: A | B) {
  if b.tag == "a" { take(__V__) }
}
h(mk(2))
// @@SKIP@@
global_assign: the un-annotated global is seeded at the FALLBACK `1`, an `i32`, so the write is a check error by design
// @@WANT@@
s
