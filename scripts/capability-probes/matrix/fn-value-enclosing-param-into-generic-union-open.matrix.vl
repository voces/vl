// The open twin of fn-value-enclosing-param-into-generic-union: the value is a generic's own
// result, so the pin `U = string` is bound by inference at that call, not written. D10270.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function pick<V>(x: V) { x }
function len<T>(f: () => T | string) {
  const t = f()
  if t is string { t.length } else { 99 }
}
function outer<U>(x: U): i32 { len(() => x) }
// @@VALUE@@
pick("abcd")
// @@TYPE@@
string
// @@PROOF@@
print(outer(v))
// @@WANT@@
4
// @@VALUE2@@
pick(7)
// @@TYPE2@@
i32
// @@PROOF2@@
print(outer(v))
// @@WANT2@@
99
