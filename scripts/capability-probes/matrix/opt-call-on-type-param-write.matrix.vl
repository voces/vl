// D3469 at every delivery position: the value is a `?.` method call whose receiver is a nullable
// local the body wrote a type-parameter value into. The template typed the call without its
// `| null`, the guard's arm read the receiver as the hole, and a closure lowered the call at the
// template's rep while the instance read it at its own.
//
// The custom cells hold the call inside the generic body: plain, in a closure, as a map `get`,
// as a self-function and as a closure field, each at a null and a non-null pin.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type __P = { a: i32, f: (n: i32) => i32 }
function __twice(self: __P, n: i32): i32 { self.a * n }
function __tvwHas<T>(x: T) {
  let s: {[string]: i32} | null = null
  s = x
  return s?.has("k")
}
function __mapK(): {[string]: i32} {
  const m: {[string]: i32} = Map()
  m["k"] = 4
  return m
}
const __none: {[string]: i32} | null = null
// @@VALUE@@
__tvwHas(__mapK())
// @@TYPE@@
boolean | null
// @@PROOF@@
print(v ?? false)
// @@WANT@@
true
// @@TEST@@
v != null
// @@HIT@@
print(v ?? false)
// @@MISS@@
print(false)
// @@FALLBACK@@
null
// @@VALUE2@@
__tvwHas(__none)
// @@TYPE2@@
boolean | null
// @@PROOF2@@
print(v ?? false)
// @@WANT2@@
false
// @@CELL_closure_has@@
// want: null then true
function __g<T>(x: T) { let s: {[string]: i32} | null = null; s = x; const ff = () => s?.has("k"); print(ff()) }
__g(__none)
__g(__mapK())
// @@CELL_closure_get@@
// want: null then 4
function __g<T>(x: T) { let s: {[string]: i32} | null = null; s = x; const ff = () => s?.get("k"); print(ff()) }
__g(__none)
__g(__mapK())
// @@CELL_body_get@@
// want: null then 4
function __g<T>(x: T) { let s: {[string]: i32} | null = null; s = x; print(s?.get("k")) }
__g(__none)
__g(__mapK())
// @@CELL_body_has@@
// want: null then true
function __g<T>(x: T) { let s: {[string]: i32} | null = null; s = x; print(s?.has("k")) }
__g(__none)
__g(__mapK())
// @@CELL_set_has@@
// want: null then true
function __g<T>(x: T) { let s: Set<string> | null = null; s = x; const ff = () => s?.has("k"); print(ff()) }
const __ns: Set<string> | null = null
__g(__ns)
const __ss: Set<string> = Set()
__ss.add("k")
__g(__ss)
// @@CELL_string_includes@@
// want: null then true
function __g<T>(x: T) { let s: string | null = null; s = x; const ff = () => s?.includes("b"); print(ff()) }
const __nstr: string | null = null
__g(__nstr)
__g("abc")
// @@CELL_self_fn@@
// want: -1 then 20
function __g<T>(x: T) { let s: __P | null = null; s = x; const ff = () => s?.__twice(4); print(ff() ?? -1) }
const __np: __P | null = null
__g(__np)
__g({ a: 5, f: (k: i32) => k })
// @@CELL_closure_field@@
// want: -1 then 102
function __g<T>(x: T) { let s: __P | null = null; s = x; print(s?.f(2) ?? -1) }
const __np: __P | null = null
__g(__np)
__g({ a: 5, f: (k: i32) => k + 100 })
// @@CELL_statement_set@@
// want: -1 then 2
function __g<T>(x: T) { let s: {[string]: i32} | null = null; s = x; s?.set("q", 2); print(s?.get("q") ?? -1) }
__g(__none)
__g(__mapK())
