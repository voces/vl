// D1812 — `x as! string[]` over a niche-repped `string[] | null`. The distinct-backing
// scalar list is its own wrapper heap, so it is graded beside the i32-backed one rather than
// assumed to follow it.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function s1(): string[] | null { return ["a", "b"] }
function s2(): string[] | null { return ["c", "d"] }
// @@VALUE@@
s1() as! string[]
// @@TYPE@@
string[]
// @@PROOF@@
print(v[1])
// @@WANT@@
b
// @@VALUE2@@
s2() as! string[]
// @@TYPE2@@
string[]
// @@PROOF2@@
print(v[1])
// @@WANT2@@
d
// @@SKIP@@
is_in_if: the value is a plain list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
