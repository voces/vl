// A `const` bound to an `if` choosing between two generic functions whose condition calls a
// function that writes, called at one type in the prelude and delivered at another at each
// position (D9161). The condition runs once, at the binding, however many types use it.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function idg<T>(t: T): T { return t }
function kg<T>(t: T): T { return t + t }
function app<T>(g: (x: T) => T, v: T): T { return g(v) }
let picks = 0
function pick(): boolean {
  picks = picks + 1
  return picks > 0
}
const h = if pick() { kg } else { idg }
const s = h("x")
// @@VALUE@@
h(1.5)
// @@TYPE@@
f64
// @@PROOF@@
if s == "xx" && picks == 1 { print(v * 2.0) } else { print(0.0) }
// @@WANT@@
6
// @@VALUE2@@
app(h, 2)
// @@TYPE2@@
i32
// @@PROOF2@@
print(v * s.length * picks)
// @@WANT2@@
8
