// D4351: a named function whose result is a string literal union, delivered as a function
// returning `string`. The union reps as an atom and `string` as a string ref, so every
// position must hand the call an adapter that converts the result.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type K = "x" | "y"
function t(k: K): K { k }
function u(k: K): K {
  if k == "x" { return "y" }
  "x"
}
// @@VALUE@@
t
// @@TYPE@@
(k: K) => string
// @@PROOF@@
print(v("x") + "!")
// @@WANT@@
x!
// @@VALUE2@@
u
// @@TYPE2@@
(k: K) => string
// @@PROOF2@@
print(v("x") + "?")
// @@WANT2@@
y?
// @@SKIP@@
is_in_if: the value is a function, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
