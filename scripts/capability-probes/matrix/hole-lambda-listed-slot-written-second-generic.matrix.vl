// A hole lambda delivered to each position, then handed to a hole parameter that lists it,
// slot-writes it from a second parameter bound to a generic function, hands the list on whole
// and calls its elements at two types (D15572). The list holds the set of both.
// No function type spells a value called at two types, so the annotated face refuses by design.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function id2<U>(x: U): U { x }
function __count(ys) { ys.length }
function __hold(a, b) {
  const xs = [a]
  xs[0] = b
  __count(xs) * 10 + xs[0]("abc").length + xs[0](2)
}
// @@VALUE@@
(x) => x
// @@TYPE@@
(x: i32) => i32
// @@PROOF@@
print(__hold(v, id2))
// @@WANT@@
15
