// D11221's string twin — `u as! K` out of a `K | i32` box. The literal-union arm rides the box
// as its member string, so the cast tests the string tag and the payload's membership, and
// yields the interned atom `K` reps as.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type K = "a" | "b"
function mk(k: i32): K | i32 {
  if k == 0 { return 7 }
  if k == 1 { return "a" }
  "b"
}
// @@VALUE@@
mk(2) as! K
// @@TYPE@@
K
// @@TEST@@
v == "b"
// @@HIT@@
print(v + "!")
// @@MISS@@
print("miss")
// @@WANT@@
b!
// @@VALUE2@@
mk(1) as! K
// @@TYPE2@@
K
// @@PROOF2@@
print(v + "?")
// @@WANT2@@
a?
