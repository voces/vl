// Per instance: a generic function pushes a record whose function field is a generic function
// named at T onto an annotated list. At i32 (3) and at string (ab). D16235.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __id<T>(x: T): T { return x }
function __run<T>(x: T): {f: (x: T) => T}[] {
  const rs: {f: (x: T) => T}[] = []
  rs.push({ f: __id })
  return rs
}
// @@VALUE@@
__run(3)
// @@TYPE@@
{f: (x: i32) => i32}[]
// @@PROOF@@
for r in v { print(r.f(3)) }
// @@WANT@@
3
// @@VALUE2@@
__run("ab")
// @@TYPE2@@
{f: (x: string) => string}[]
// @@PROOF2@@
for r in v { print(r.f("ab")) }
// @@WANT2@@
ab
// @@CELL_string_first@@
// want: ab then 3
const a = __run("ab")
print(a[0].f("ab"))
const b = __run(3)
print(b[0].f(3))
// @@CELL_four_instances@@
// want: 3 then ab then false then 2.5
print(__run(3)[0].f(3))
print(__run("ab")[0].f("ab"))
print(__run(true)[0].f(false))
print(__run(2.5)[0].f(2.5))
// @@CELL_body_map_set@@
// want: 3 then ab
function __runM<T>(x: T) {
  const m: {[string]: {f: (x: T) => T}} = Map()
  m.set("k", { f: __id })
  return m.get("k")
}
const a = __runM(3)
if a != null { print(a.f(3)) }
const b = __runM("ab")
if b != null { print(b.f("ab")) }
// @@CELL_body_nested_record@@
// want: 3 then ab
function __runN<T>(x: T) {
  const rs: {g: {f: (x: T) => T}}[] = []
  rs.push({ g: { f: __id } })
  return rs
}
print(__runN(3)[0].g.f(3))
print(__runN("ab")[0].g.f("ab"))
// @@CELL_body_list_element@@
// want: 3 then ab
function __runL<T>(x: T) {
  const rs: ((x: T) => T)[][] = []
  rs.push([__id])
  return rs
}
print(__runL(3)[0][0](3))
print(__runL("ab")[0][0]("ab"))
// @@CELL_body_called@@
// want: 3 then ab
function __runC<T>(x: T): T {
  const rs: {f: (x: T) => T}[] = []
  rs.push({ f: __id })
  return rs[0].f(x)
}
print(__runC(3))
print(__runC("ab"))
// @@CELL_body_closed_field@@
// want: 3 then 4
function __runK<T>(x: T) {
  const rs: {f: (x: i32) => i32}[] = []
  rs.push({ f: __id })
  return rs
}
print(__runK(3)[0].f(3))
print(__runK("ab")[0].f(4))
