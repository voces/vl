// A `let` list binding reassigned another list literal — `let q = [{ v: 1 }]` then
// `q = [{ v: 3 }]` — delivered at every position; the annotated face delivers it as `D[]`, a list
// of a record storing `v` wider. The binding holds only literals, so both are built at `D[]`
// (D15871, the reassigned face of D3340). The annotated `return_inferred` cell is D15894: a `let`
// returned by an inferred function is refused, reassigned or not. Format:
// scripts/capability-probes/README.md.
// @@PRELUDE@@
type D = { v: i64 }
let q = [{ v: 1 }]
q = [{ v: 3 }]
const go = [1].length > 0
// @@VALUE@@
q
// @@TYPE@@
D[]
// @@PROOF@@
print(v[0].v)
// @@WANT@@
3
// @@SKIP@@
is_in_if: the value is a list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
