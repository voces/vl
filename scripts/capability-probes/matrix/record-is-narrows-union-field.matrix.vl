// A record tested against one that narrows a union field to a member, at every position: the
// test reads the field's tag, and the narrowed arm reads the field at the member.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type __A = { x: i32 | string, z: i32 }
type __B = { x: i32, z: i32 }
function __mk(k: i32): __A {
  if k > 0 { return { x: k, z: k } }
  { x: "s", z: 0 }
}
// @@VALUE@@
__mk(2)
// @@TYPE@@
__A
// @@TEST@@
v is __B
// @@HIT@@
print(v.x + 40)
// @@MISS@@
print(0)
// @@WANT@@
42
