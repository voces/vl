// A record whose field is a named, already-closed list of un-annotated functions, handed to an
// un-annotated parameter that calls an element: the field is not an open function named there,
// so it must keep its own closed type (the D9572 close once refused it). Every cell prints `4`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function inc0(a) { return a + 1 }
const hl = [inc0]
function take(p) { print(p.xs[0](3)) }
// @@VALUE@@
{ xs: hl }
// @@TYPE@@
{ xs: ((a: i32) => i32)[] }
// @@PROOF@@
take(v)
// @@WANT@@
4
