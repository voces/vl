// D15091: an `i32[]` compared with a float list literal. A float literal is no `i32`, so the
// literal stays an `f64[]` and the two compare across their storage, by value.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function xlI(a: i32, b: i32): i32[] { [a, b] }
// @@VALUE@@
xlI(1, 2)
// @@TYPE@@
i32[]
// @@TEST@@
v == [1.0, 2.0] && v != [1.5, 2.0] && [1.0, 2.0] == v
// @@HIT@@
print("value")
// @@MISS@@
print("storage")
// @@WANT@@
value
// @@VALUE2@@
xlI(1, 3)
// @@TYPE2@@
i32[]
// @@PROOF2@@
print("\{v == [1.0, 2.0]} \{v != [1.0, 2.0]}")
// @@WANT2@@
false true
