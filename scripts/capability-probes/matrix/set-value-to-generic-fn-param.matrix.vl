// D16093, D16097 — a value of a set of un-annotated functions handed to a generic parameter
// `g: (x: T) => R`. With results that differ, `R` is their join and the delivery dispatches on the
// member the value holds; with results that agree it is that type. Each cell hands the set from
// one delivery form: a list element, a record field, a choice, a bound `let`, a returned choice.
//
// The PROOF discriminates: `pick(true)` holds `str`, so the join prints `s`, never `4`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function inc(a) { return a + 1 }
function str(_a) { return "s" }
function dbl(a) { return a * 2 }
function app<T, R>(g: (x: T) => R, v: T): R { return g(v) }
function pick(c: boolean) { return if c { str } else { inc } }
// @@VALUE@@
app(pick(true), 3)
// @@TYPE@@
i32 | string
// @@PROOF@@
print(v)
// @@WANT@@
s
// @@CELL_list_differ@@
// want: s
function run(c: boolean) {
  const fs = [inc]
  if c { fs[0] = str }
  const r__A__ = app(fs[0], 3)
  print(r)
}
run(true)
// @@CELL_list_agree@@
// want: 6
function run(c: boolean) {
  const fs = [inc]
  if c { fs[0] = dbl }
  print(app(fs[0], 3))
}
run(true)
// @@CELL_field_differ@@
// want: s
function run(c: boolean) {
  const o = { f: inc }
  if c { o.f = str }
  const r__A__ = app(o.f, 3)
  print(r)
}
run(true)
// @@CELL_field_agree@@
// want: 6
function run(c: boolean) {
  const o = { f: inc }
  if c { o.f = dbl }
  print(app(o.f, 3))
}
run(true)
// @@CELL_choice_differ@@
// want: s
function run(c: boolean) {
  const r__A__ = app(if c { str } else { inc }, 3)
  print(r)
}
run(true)
// @@CELL_choice_agree@@
// want: 6
function run(c: boolean) { print(app(if c { dbl } else { inc }, 3)) }
run(true)
// @@CELL_let_differ@@
// want: s
function run(c: boolean) {
  let f = inc
  if c { f = str }
  const r__A__ = app(f, 3)
  print(r)
}
run(true)
// @@CELL_let_agree@@
// want: 6
function run(c: boolean) {
  let f = inc
  if c { f = dbl }
  print(app(f, 3))
}
run(true)
// @@CELL_returned_differ@@
// want: s
const r__A__ = app(pick(true), 3)
print(r)
// @@CELL_returned_agree@@
// want: 6
function pick2(c: boolean) { return if c { dbl } else { inc } }
print(app(pick2(true), 3))
// @@CELL_let_differ_false@@
// want: 4
function run(c: boolean) {
  let f = inc
  if c { f = str }
  print(app(f, 3))
}
run(false)
// @@CELL_let_misfit_closed@@
// owed: cannot write 'half' to 'f'
function half(a) { return a / 2.0 }
function w(h: (a: i32) => i32) { return h(3) }
let f = inc
f = half
print(w(f))
// @@CELL_let_misfit_generic@@
// owed: cannot write 'str' to 'f'
function same<T>(g: (x: T) => T, v: T): T { return g(v) }
function run(c: boolean) {
  let f = inc
  if c { f = str }
  print(same(f, 3))
}
run(true)
