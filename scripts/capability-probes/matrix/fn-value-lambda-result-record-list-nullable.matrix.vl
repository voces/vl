// D9742: a lambda returning a list of a declared record, or `null`, delivered where a function
// returning `R[] | null` is expected. The lambda takes the expected result as its own, as the
// annotated `(x: i32): R[] | null => ...` result does.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type R = {x: i32}
// @@VALUE@@
(x: i32) => [{x: x}]
// @@TYPE@@
(x: i32) => R[] | null
// @@PROOF@@
const r = v(7)
if r == null { print(0) } else { print(r[0].x) }
// @@WANT@@
7
// @@VALUE2@@
(x: i32) => null
// @@TYPE2@@
(x: i32) => R[] | null
// @@PROOF2@@
print(v(1) == null)
// @@WANT2@@
true
