// D16105 — a record written into a name whose record is narrower, used as a value: the assignment
// yields the value at its own record at every delivery position, and under a short-circuit
// operand, where the write cannot move ahead of its statement.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type WnA = { x: i32 }
type WnB = { x: i32, y: i32 }
let wna: WnA = { x: 0 }
const wnb: WnB = { x: 1, y: 2 }
function wnY(q: WnB) { return q.y }
// @@VALUE@@
(wna = wnb)
// @@TYPE@@
WnB
// @@PROOF@@
print(v.y * 10 + wna.x)
// @@WANT@@
21
// @@SKIP@@
is_in_if: the value is a record, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
// @@CELL_and_operand@@
// want: 21
let wnc = 0
const wnt = wnc < 5 && wnY(wna = wnb) == 2
print((if wnt { 2 } else { 0 }) * 10 + wna.x)
// @@CELL_or_operand@@
// want: 21
let wnc = 0
const wnt = wnc > 5 || wnY(wna = wnb) == 2
print((if wnt { 2 } else { 0 }) * 10 + wna.x)
// @@CELL_skipped_operand@@
// want: 0
let wnc = 0
const wnt = wnc > 5 && wnY(wna = wnb) == 2
print((if wnt { 2 } else { 0 }) * 10 + wna.x)
// @@CELL_while_condition@@
// want: 11
let wnn = 0
while wnn < 1 && wnY(wna = wnb) == 2 { wnn = wnn + 1 }
print(wnn * 10 + wna.x)
// @@CELL_field_read_under_and@@
// want: 21
let wnc = 0
const wnt = wnc < 5 && (wna = wnb).y == 2
print((if wnt { 2 } else { 0 }) * 10 + wna.x)
