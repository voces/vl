// D2573 — a generic returning its in-place lambda's result, un-annotated, at `T = string | null`:
// the instance's result is that niche, as the `: T` spelling says.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
const src: (string | null)[] = ["a", "b"]
function k<T>(v: T) { return ((p: T) => p)(v) }
const one = src[1]
// @@VALUE@@
k(one)
// @@TYPE@@
string | null
// @@PROOF@@
if v != null { print(v) } else { print("none") }
// @@WANT@@
b
// @@TEST@@
v != null
// @@HIT@@
print(v)
// @@MISS@@
print("none")
