// D11221's `as?` twin — `u as? N2` out of a `N2 | string` box. A hit is the base's tag with a
// member payload; the result is `N2 | null`, which a `!= null` test narrows back to the atom.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type N2 = 1 | 2
function mk(k: i32): N2 | string {
  if k == 0 { return "s" }
  if k == 1 { return 1 }
  2
}
// @@VALUE@@
mk(2) as? N2
// @@TYPE@@
N2 | null
// @@TEST@@
v != null
// @@HIT@@
print(v + 10)
// @@MISS@@
print(0)
// @@WANT@@
12
// @@VALUE2@@
mk(0) as? N2
// @@TYPE2@@
N2 | null
// @@PROOF2@@
print(v == null)
// @@WANT2@@
true
