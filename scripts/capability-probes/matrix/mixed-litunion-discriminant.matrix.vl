// D1050 — a union whose two arms spell their literal discriminant DIFFERENTLY (a named alias
// in one, an inline set in the other). Closed 2026-09-02 by laying the mixed field out under
// ONE rep; this template is the 48-cell matrix that close was graded on, re-derivable.
// D1195 and D1196 came out of it and are master's, not the close's.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type K1 = "circle" | "round"
type A = { kind: K1, r: f64 }
type B = { kind: "x" | "y", r: f64 }
function f(n: i32): A | B {
  if n == 0 { return { kind: "circle", r: 1.0 } }
  return { kind: "x", r: 2.0 }
}
// @@VALUE@@
f(1)
// @@TYPE@@
A | B
// @@TEST@@
v is B
// @@HIT@@
print(v.r)
// @@MISS@@
print("notB")
// @@WANT@@
2
