// A generic function taking a callback, delivered to each position, then called twice at one
// type with two different lambdas, so each call specialises the generic for its own callback. The
// un-annotated face calls one instance per lambda (D9853).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function g<T>(f: (x: T) => T, x: T): T { f(x) }
// @@VALUE@@
g
// @@TYPE@@
(f: (x: i32) => i32, x: i32) => i32
// @@PROOF@@
print(v((x: i32) => x + 1, 2) * 10 + v((x: i32) => x, 5))
// @@WANT@@
35
