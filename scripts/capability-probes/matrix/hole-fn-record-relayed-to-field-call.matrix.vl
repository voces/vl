// D9731: a record of an un-annotated function, handed to an un-annotated parameter that relays it
// to another one calling the field at f64. The function takes its type from that field call, so
// every cell prints `2.5`, which an i32 instance cannot.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function inc0(a) { return a + 1 }
function take(a) { print(a.f(1.5)) }
function relay(a) { take(a) }
// @@VALUE@@
{ f: inc0 }
// @@TYPE@@
{ f: (a: f64) => f64 }
// @@PROOF@@
relay(v)
// @@WANT@@
2.5
// @@SKIP@@
is_in_if: the value is a record, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
