// D4056 — three record arms share the field name `n` at three disjoint types; the else-if chain
// reaches the third arm only when the value fits neither of the first two.
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type A = { n: i32 }
type B = { n: string }
type C = { n: boolean }
function pick(n: i32): A | B | C {
  if n == 0 { return { n: 3 } }
  if n == 1 { return { n: "s" } }
  { n: true }
}
// @@VALUE@@
pick(2)
// @@TYPE@@
A | B | C
// @@TEST@@
v is C
// @@HIT@@
if v.n { print("C true") } else { print("C false") }
// @@MISS@@
print("wrong")
// @@WANT@@
C true
// @@VALUE2@@
pick(1)
// @@TYPE2@@
A | B | C
// @@PROOF2@@
if v is A { print("wrong A") } else if v is C { print("wrong C") } else { print("B " + v.n) }
// @@WANT2@@
B s
