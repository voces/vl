// D9960: an alias whose body is a list of a function type, delivered at every position and read
// by its length and a call through an element. Every cell prints `9`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type FF = (x: i32) => i32
type L = FF[]
// @@VALUE@@
[(x: i32): i32 => x + 1, (x: i32): i32 => x * 2]
// @@TYPE@@
L
// @@PROOF@@
print(v.length + v[0](6))
// @@WANT@@
9
// @@SKIP@@
is_in_if: the value is a list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
