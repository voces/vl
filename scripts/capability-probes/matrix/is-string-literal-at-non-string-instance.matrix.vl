// D15251: a string-literal `is` inside an un-annotated function, at an instance whose operand is
// no string, is false there, rather than a string compare on the operand.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __h(x) { x is "x" }
print(__h("x"))
// @@VALUE@@
3
// @@TYPE@@
i32
// @@WANT@@
0
// @@TEST@@
__h(v)
// @@HIT@@
print(1)
// @@MISS@@
print(0)
