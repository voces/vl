// D9491: a lambda returning a numeric literal union, or one of its member literals, delivered
// where a function returning that union or `null` is expected. The lambda's result is the
// base's nullable box, as an annotated `(): N | null` result is.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type N = 1 | 2
const __na: N = 2
// @@VALUE@@
() => __na
// @@TYPE@@
() => N | null
// @@PROOF@@
print((v() ?? 0) + 40)
// @@WANT@@
42
// @@VALUE2@@
() => 1
// @@TYPE2@@
() => N | null
// @@PROOF2@@
print((v() ?? 0) * 10)
// @@WANT2@@
10
// @@SKIP@@
is_in_if: the value is a function, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
