// D9915: a `??` over a record field of an un-annotated parameter pinned at a never-null
// `{ v: i32 }` is the field, though the function is also called at `{ v: i32 | null }` with a
// float default. The proof divides, which prints `3` at `i32` and `3.5` at `f64`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __cfTake(r, d) { return r.v ?? d }
const __cfNul: { v: i32 | null } = { v: 4 }
const __cfOther = __cfTake(__cfNul, 1.5)
const __cfK: { v: i32 } = { v: 7 }
// @@VALUE@@
__cfTake(__cfK, 9)
// @@TYPE@@
i32
// @@TEST@@
v > 0
// @@HIT@@
print(v / 2)
// @@MISS@@
print("miss")
// @@WANT@@
3
