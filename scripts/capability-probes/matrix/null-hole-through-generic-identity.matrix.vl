// D8280: a never-filled `const x = null` handed through a generic identity, whose open type
// parameter the binding pins. The pin is the `null` type, a `nullref`, not an `i32`, so the
// result serves a record destination. The proof reads through the narrow (`v.a`).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type C = { a: i32, b: i32 }
function __id<T>(x: T): T { x }
// @@SETUP@@
const __nn = null
// @@VALUE@@
__id(__nn)
// @@TYPE@@
C | null
// @@TEST@@
v != null
// @@HIT@@
print(v.a)
// @@MISS@@
print("none")
// @@WANT@@
none
// @@SKIP@@
map_value: a map whose VALUE is `null` cannot be told from a missing key, so the proof prints nothing at both seeds
map_set: the map value's null heap is seeded into the call's own argument, invalid wasm at both seeds (D8360)
map_value_place: the same seed through `m[k] = …`, invalid wasm at both seeds (D8360)
