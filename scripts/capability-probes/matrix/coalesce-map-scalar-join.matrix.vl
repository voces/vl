// A scalar map read under `??` joining another arm of its union (`coalesce mapScalarJoin`,
// `RMapGetOr` form 7): a hit boxes the stored `i32` at its own arm, a miss boxes the default.
// Graded at every delivery position, plus a generic receiver's hit and miss and a `??` operand.
// @@PRELUDE@@
const mm: {[i32]: i32} = Map()
mm[1] = 10
function viaRecv(p) {
  print(p.m[1] ?? true)
  print(p.m[9] ?? true)
}
// @@VALUE@@
mm[1] ?? true
// @@TYPE@@
i32 | boolean
// @@WANT@@
10
// @@TEST@@
v is i32
// @@HIT@@
print(v)
// @@MISS@@
print("miss")
// @@CELL_miss_default@@
// want: true
const v__A__ = mm[9] ?? true
print(v)
// @@CELL_generic_receiver@@
// want: 10 then true
viaRecv({ m: mm })
// @@CELL_coalesce_operand@@
// want: 10
const v__A__ = (mm[1] ?? true) ?? false
print(v)
