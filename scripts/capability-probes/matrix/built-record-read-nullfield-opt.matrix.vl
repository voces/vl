// D16964: a record literal whose field holds a read of a container built at a wider record is
// stored into a nullable record field whose initialiser is a join; the record is built at that
// field's build, and an optional chain of it reads the build, at every delivery position.

// @@PRELUDE@@
type J = { f: i32 | null }

// @@SETUP@@
const m = Map()
m.set("a", { f: 4 })
const wm: {[string]: J} = m
const d = { f: 1 }
const w3 = { k: if d.f == 99 { null } else { { x: { f: 7 } } } }
function put() {
  w3.k = { x: m.get("a") ?? d }
  return 0
}
put()

// @@VALUE@@
w3.k?.x.f ?? 0

// @@TYPE@@
i32

// @@PROOF@@
print(v)

// @@WANT@@
4
