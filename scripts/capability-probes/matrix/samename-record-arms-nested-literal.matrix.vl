// D16939 — two record arms store alike and differ only in a literal set one record deeper, so
// a value's own row and its nested field, not the first row of its shape, decide `is`.
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type A = { v: { x: 1 | 2 } }
type C = { v: { x: 3 | 4 } }
function pick(a: boolean): A | C {
  if a { return { v: { x: 1 } } }
  const c: C = { v: { x: 4 } }
  return c
}
// @@SETUP@@
const cval: C = { v: { x: 3 } }
// @@VALUE@@
cval
// @@TYPE@@
A | C
// @@TEST@@
v is A
// @@HIT@@
print("A")
// @@MISS@@
print("C")
// @@WANT@@
C
// @@VALUE2@@
pick(true)
// @@TYPE2@@
A | C
// @@PROOF2@@
if v is C { print("C") } else { print("A") }
// @@WANT2@@
A
