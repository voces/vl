// D1291 / D1293 — `==` over a struct whose FIELD is an `S[] | null` ref-list niche, at the
// plain-struct and the union-ARM spellings. The `| null` is the ingredient (ablated: drop it
// and the same compare runs), because the niche routes to its non-null twin's core under a
// null guard and that core starts a fresh chain the guard's recover must not follow into.
//
// The PROOF discriminates on the ELEMENT, not just on the wrapper: a compare that stopped at
// the two refs would answer `true` for `diff` and never print `2`.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type Inner = { p: i32 }
type A = { d: Inner[] | null }
const same: A = { d: [{ p: 5 }] }
const diff: A = { d: [{ p: 6 }] }
const nul: A = { d: null }
// @@VALUE@@
{ d: [{ p: 5 }] }
// @@TYPE@@
A
// @@FALLBACK@@
{ d: null }
// @@TEST@@
v == same
// @@HIT@@
if v == diff { print(0) } else { if v == nul { print(1) } else { print(2) } }
// @@MISS@@
print(9)
// @@WANT@@
2
