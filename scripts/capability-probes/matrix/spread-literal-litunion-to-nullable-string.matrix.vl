// A list-literal spread of a literal-union list into a `(string | null)[]`, which shares the
// string list's rep: each atom is re-encoded as its string, and the trailing `null` types the
// un-annotated face the same.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type Kx = "x" | "y"
const src: Kx[] = ["x", "y"]
// @@VALUE@@
[...src, null]
// @@TYPE@@
(string | null)[]
// @@PROOF@@
const p = v[1]
const q = v[2]
if p != null && q == null { print(p + "\{v.length}") } else { print("miss") }
// @@WANT@@
y3
// @@SKIP@@
is_in_if: the value is a list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
