// Flow-sensitive reads (DECISIONS.md, "A read of a `let` takes its most recent write's type"),
// the annotated-union face: a `let x: i32 | string` written a `string` reads as that `string`,
// delivered at every position into a `string`. The proof reads the delivered value's length.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@SETUP@@
let x: i32 | string = 1
x = "abc"
// @@VALUE@@
x
// @@TYPE@@
string
// @@PROOF@@
print(v.length)
// @@WANT@@
3
