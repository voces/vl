// D10881: a generic builds a record whose `(T | null)[]` field holds a list literal with a bare
// `null`, at a `string` pin and (second instance) a `boolean` one, where `T | null` is a niche.
// The record is delivered from every position; the proof reads both cells back.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __mk<T>(x: T): { g: (T | null)[] } { return { g: [x, null] } }
function __tb(x: boolean | null): string {
  if x == null { return "N" }
  if x { return "T" }
  "F"
}
// @@VALUE@@
__mk("s")
// @@TYPE@@
{ g: (string | null)[] }
// @@PROOF@@
print((v.g[0] ?? "nil") + (v.g[1] ?? "nil"))
// @@WANT@@
snil
// @@VALUE2@@
__mk(false)
// @@TYPE2@@
{ g: (boolean | null)[] }
// @@PROOF2@@
print(__tb(v.g[0]) + __tb(v.g[1]))
// @@WANT2@@
FN
// @@SKIP@@
is_in_if: the value is a record, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
