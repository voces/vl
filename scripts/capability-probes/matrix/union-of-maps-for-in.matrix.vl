// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __mk(): {[string]: i32} | {[string]: string} {
  const s: {[string]: string} = Map()
  s["k"] = "a"
  s
}
// @@VALUE@@
__mk()
// @@TYPE@@
{[string]: i32} | {[string]: string}
// @@TEST@@
v.has("k")
// @@HIT@@
let s = ""
for k in v { s = s + k }
for k, x in v { s = s + k }
print(s.length * 10 + v.values().length)
