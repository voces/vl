// A `string | null` field every arm of a record union carries, read off the un-narrowed union
// after a member null test, delivers the non-null string into every string slot (D16728).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type A = { v: string | null }
type B = { v: string | null, w: i32 }
function pick(b: boolean): A | B { return if b { { v: "hi" } } else { { v: null, w: 3 } } }
const x: A | B = pick(true)
// @@GUARD@@
x.v != null
// @@VALUE@@
x.v
// @@FALLBACK@@
"none"
// @@TYPE@@
string
// @@PROOF@@
print(v + "!")
// @@WANT@@
hi!
// @@CELL_early_return_guard_read@@
function f(y: A | B): string {
  if y.v == null { return "none" }
  return y.v
}
print(f(x) + "!")
// @@CELL_coalesce_read@@
const s__A__ = x.v ?? "none"
print(s + "!")
// @@CELL_concat_in_guard@@
if x.v != null { print(x.v + "!") }
// @@CELL_print_in_guard@@
// want: hi
if x.v != null { print(x.v) }
// @@CELL_arg_in_guard@@
function g(s: string): string { return s + "!" }
if x.v != null { print(g(x.v)) }
// @@CELL_field_store_in_guard@@
type H = { s: string }
if x.v != null { const h: H = { s: x.v }; print(h.s + "!") }
// @@CELL_list_field_control@@
// want: 2
type LA = { v: i32[] | null }
type LB = { v: i32[] | null, w: i32 }
function lpick(b: boolean): LA | LB { return if b { { v: [1, 2] } } else { { v: null, w: 3 } } }
const lx: LA | LB = lpick(true)
if lx.v != null { const l: i32[] = lx.v; print(l.length) }
// @@CELL_bool_field_control@@
// want: true
type BA = { v: boolean | null }
type BB = { v: boolean | null, w: i32 }
function bpick(b: boolean): BA | BB { return if b { { v: true } } else { { v: null, w: 3 } } }
const bx: BA | BB = bpick(true)
if bx.v != null { const t: boolean = bx.v; print(t) }
// @@CELL_record_field_control@@
// want: hi!
type P = { n: string }
type RA = { v: P | null }
type RB = { v: P | null, w: i32 }
function rpick(b: boolean): RA | RB { return if b { { v: { n: "hi" } } } else { { v: null, w: 3 } } }
const rx: RA | RB = rpick(true)
if rx.v != null { const p: P = rx.v; print(p.n + "!") }
// @@CELL_map_field_control@@
// want: 1
type MA = { v: Map<string, i32> | null }
type MB = { v: Map<string, i32> | null, w: i32 }
function mpick(b: boolean): MA | MB {
  const m: Map<string, i32> = Map()
  m.set("a", 1)
  return if b { { v: m } } else { { v: null, w: 3 } }
}
const mx: MA | MB = mpick(true)
if mx.v != null { const q: Map<string, i32> = mx.v; print(q.length) }
