// D1631 — `__array_new__` filled with a WIDE-SCALAR LIST (`f64[]`, and `i64[]`/`u8[]`/`f32[]`
// alike). The fill ladder had no arm for one, and the classifiers it did ask answer for a
// module GLOBAL and not for a parameter or a local — so the storage class, not the type,
// decided whether the list was allocated as the ref list or as the i32 one.
//
// THE FILL MUST NOT BE A MODULE GLOBAL. `global_init` is the position where this always ran;
// every other position holds the fill in a local or a parameter, which is the cell.
//
// The PROOF adds a fraction to the element, so a list allocated at the i32 backing traps or
// prints an integer rather than passing.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function awlMk(): f64[] { return [1.5] }
function awlMk2(): f64[] { return [2.5] }
// @@SETUP@@
const awlSeed: f64[] = awlMk()
// @@VALUE@@
__array_new__(2, awlSeed)
// @@TYPE@@
f64[][]
// @@PROOF@@
print(v[1][0] + 0.25)
// @@WANT@@
1.75
// @@VALUE2@@
__array_new__(2, awlMk2())
// @@TYPE2@@
f64[][]
// @@PROOF2@@
print(v[1][0] + 0.25)
// @@WANT2@@
2.75
