// D1606 — a union-annotated cell fed by a call returning one of its STRUCT ARMS, with a
// declared struct `A` that NO union claims sharing the arm's layout. The twin donates its
// struct row, so the arm resolves to one, and the two producers disagreed: `collectLocals`
// classified the binding from its init (the raw variant ref) while `emitLetDeclStmt` coerced
// against the annotation (the box). Every OTHER delivery of the same value ran, which is why
// the position matrix is the instrument — the binding is the one cell that was silent.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type A = { q: i32 }
type Q = { q: i32 }
type U = Q | i32
function mkQ(): Q { return { q: 5 } }
// @@VALUE@@
mkQ()
// @@TYPE@@
U
// @@TEST@@
v is Q
// @@HIT@@
print(v.q)
// @@MISS@@
print(0)
// @@WANT@@
5
