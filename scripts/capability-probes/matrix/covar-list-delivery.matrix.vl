// D1628 — where a COVARIANT list handle may be delivered. `const b: Shape[] = a` is lowered
// as an element-converting copy, licensed by the `Writable` analysis saying nothing writes
// this value; the claim pass had an arm for the direct binding only, so a delivery into a
// struct field, a nested element or a return left the write state unknown and the emitter
// built a module the engine refuses.
//
// The covariant assignment lives in SETUP, so every cell and both faces carry it and the
// axis is purely WHERE the handle then goes. `__other` is the unrelated write that makes
// the analysis run at all — `cwProgramHasWrite` is the gate, and it is syntactic, so the
// function need not be called.
//
// The PROOF reads an element back and prints the source's own field: a cell that printed
// only a length would pass on a list whose elements were never converted.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function __other() {
  const w: Shape[] = []
  w.push({ s: 3 })
  print(w.length)
}
// @@SETUP@@
const a: Circle[] = [{ r: 7 }]
const b: Shape[] = a
// @@VALUE@@
b
// @@TYPE@@
Shape[]
// @@PROOF@@
const e0 = v[0]
if e0 is Circle { print(e0.r) } else { print(0) }
// @@WANT@@
7
