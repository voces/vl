// D15264: a record built by a call at its own row (`j: {n: i32}`), delivered at every position
// into a record that stores the nested `n` as `i64`, the call also read at its own type. The
// flat twin (`fresh-call-record-into-wider-number-fields`) is served by a converting copy; the
// copy does not yet reach a nested field, so this one is refused at check.
//
// The PROOF multiplies past `i32`, so a field left at `i32` storage cannot print the want.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type J = { n: i64 }
type R = { j: J, s: string }
function mk() { { j: { n: 3 }, s: "a" } }
const own = mk()
const ownN: i32 = own.j.n + 1
// @@VALUE@@
mk()
// @@TYPE@@
R
// @@PROOF@@
print(v.j.n * 4000000000)
// @@WANT@@
12000000000
// @@SKIP@@
is_in_if: the value is a record, not a union; there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
