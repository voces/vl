// D1672 — a bare concrete union ARM, delivered to every position. The CONTROL matrix for
// `if-expr-variant-arm-join.matrix.vl`: the same value with no `if` around it, so a cell that
// refuses in both is the struct-field holder's classification and not the join's.
//
// The union declaration is the ingredient — with it, `p` is a union ARM (a `uVarHeap` ref) and
// the struct machinery reads the variant table rather than the struct one; delete `type Q` and
// `type UU` and the same program is a plain struct at every position.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type P = { x: i32 }
type Q = { y: i32 }
type UU = P | Q
const p: P = { x: 1 }
function useUU(u: UU): i32 {
  if u is P { return u.x }
  0
}
const seen = useUU(p)
// @@VALUE@@
p
// @@TYPE@@
P
// @@FALLBACK@@
p
// @@TEST@@
v.x == 1
// @@HIT@@
print(1)
// @@MISS@@
print(-1)
// @@WANT@@
1
