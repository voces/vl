// A list of un-annotated functions bound to a local const, wrapped in a list literal at the
// return of a function with an un-annotated parameter, delivered at every position from a call
// at `i32` and read back at `i32`, while a call at `string` takes a second instance read back at
// `f64` (D9600, D9660). The proof prints the `f64` read only when the `i32` read was right.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __inc(a) { return a + 1 }
function __dbl(a) { return a * 2 }
function __give(_n) {
  const w = [__inc, __dbl]
  return [w]
}
// @@VALUE@@
__give(1)
// @@TYPE@@
((a: i32) => i32)[][]
// @@PROOF@@
if v[0][1](3) == 6 {
  print(__give("s")[0][1](1.25))
} else {
  print("wrong i32 read")
}
// @@WANT@@
2.5
