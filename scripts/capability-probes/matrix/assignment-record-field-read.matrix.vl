// D16100 — a row-less record written into a nullable record field, read straight off the
// assignment's value: the read is the right-hand side's field at every delivery position.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type FrNode = { v: i32, left: FrNode | null }
const fr: FrNode = { v: 1, left: null }
// @@VALUE@@
(fr.left = { v: 3, left: null }).v
// @@TYPE@@
i32
// @@PROOF@@
print(v * 10 + (fr.left?.v ?? 0))
// @@WANT@@
33
// @@SKIP@@
is_in_if: the value is an i32, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
// @@CELL_element_target@@
// want: 44
const frs: FrNode[] = [{ v: 2, left: null }]
const v__A__ = (frs[0] = { v: 4, left: null }).v
print(v * 10 + frs[0].v)
// @@CELL_bound_then_read@@
// want: 3
const fx = fr.left = { v: 3, left: null }
print(fx.v)
// @@CELL_null_field_test@@
// want: true
print((fr.left = { v: 3, left: null }).left == null)
// @@CELL_name_target_null_field_test@@
// want: false
let fq: FrNode | null = null
print((fq = { v: 5, left: null }).left != null)
