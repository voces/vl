// D2497 — the value is what an un-annotated function RETURNS when its tail statement writes a
// bare `null` to a field. The checker types the write at its right side, so the function
// returns `null`; the emitter has to yield that `null` after the store rather than stay void.
// The prelude is the producer and every position consumes its result.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type __O = { v: string | null }
function __tw(o: __O) { o.v = null }
// @@VALUE@@
__tw({ v: "a" })
// @@TYPE@@
string | null
// @@TEST@@
v != null
// @@HIT@@
print(v)
// @@MISS@@
print("none")
// @@WANT@@
none
// @@SKIP@@
map_value: a map whose VALUE is `null` cannot be told from a missing key — the read's `!= null` guard is false either way
