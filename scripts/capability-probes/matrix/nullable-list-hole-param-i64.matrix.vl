// D2238 — an `i64[] | null` bound first and then delivered, so the `argument` and
// `early_return_guard` cells pin an un-annotated parameter to the nullable list itself and
// read its element through the `!= null` narrowing, at a value only i64 can hold.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
const src: i64[] | null = [(5000000000 as i64)]
// @@VALUE@@
src
// @@TYPE@@
i64[] | null
// @@FALLBACK@@
null
// @@TEST@@
v != null
// @@HIT@@
print(v[0] + v[0])
// @@MISS@@
print("null")
// @@WANT@@
10000000000
