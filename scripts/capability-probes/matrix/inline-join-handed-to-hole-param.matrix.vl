// A value `if` or `match` of records whose function field holds un-annotated functions, handed
// inline to an un-annotated parameter: the parameter's instance decides the join's set as it does
// a binding's. The value's arms return different types (the order in which a closure built at
// the first arm's signature traps). Cells: each inline spelling beside its bound twin, a swap of
// two functions between two fields (D15333), a `const` lambda callee (D15808), a call passing
// another parameter, and the join beside records sharing its functions (D15809).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function two() { [1, 2].length }
// @@VALUE@@
if two() > 5 { { f: half } } else { { f: inc0 } }
// @@TYPE@@
{ f: (a: i32) => f64 }
// @@PROOF@@
print(v.f(3) + v.f(4))
// @@WANT@@
9
// @@CELL_arg_bound@@
function take(r) { return r.f(3) + r.f(4) }
const q__A__ = __V__
print(take(q))
// @@CELL_arg_inline@@
function take(r) { return r.f(3) + r.f(4) }
print(take(if two() > 5 { { f: half } } else { { f: inc0 } }))
// @@CELL_arg_inline_first_arm@@
// want: 3.5
function take(r) { return r.f(3) + r.f(4) }
print(take(if two() > 1 { { f: half } } else { { f: inc0 } }))
// @@CELL_arg_inline_match@@
function take(r) { return r.f(3) + r.f(4) }
print(take(match two() { 5 => { f: half }, _ => { f: inc0 } }))
// @@CELL_arg_bound_match@@
function take(r) { return r.f(3) + r.f(4) }
const q = match two() { 5 => { f: half }, _ => { f: inc0 } }
print(take(q))
// @@CELL_arg_inline_chain@@
// want: 14
function dbl(a) { return a * 2 }
function take(r) { return r.f(3) + r.f(4) }
print(take(if two() > 5 { { f: half } } else if two() > 4 { { f: inc0 } } else { { f: dbl } }))
// @@CELL_arg_inline_paren@@
function take(r) { return r.f(3) + r.f(4) }
print(take((if two() > 5 { { f: half } } else { { f: inc0 } })))
// @@CELL_arg_inline_in_expr@@
// want: 10
function take(r) { return r.f(3) + r.f(4) }
print(1 + take(if two() > 5 { { f: half } } else { { f: inc0 } }))
// @@CELL_arg_inline_twice@@
// want: 12.5
function take(r) { return r.f(3) + r.f(4) }
print(take(if two() > 5 { { f: half } } else { { f: inc0 } }) + take(if two() > 1 { { f: half } } else { { f: inc0 } }))
// @@CELL_arg_inline_second_param@@
function take2(n, r) { return r.f(n) + r.f(4) }
print(take2(3, if two() > 5 { { f: half } } else { { f: inc0 } }))
// @@CELL_arg_bound_second_param@@
function take2(n, r) { return r.f(n) + r.f(4) }
const q__A__ = __V__
print(take2(3, q))
// @@CELL_arg_inline_const_lambda@@
const take = (r) => r.f(3) + r.f(4)
print(take(if two() > 5 { { f: half } } else { { f: inc0 } }))
// @@CELL_arg_bound_const_lambda@@
const take = (r) => r.f(3) + r.f(4)
const q__A__ = __V__
print(take(q))
// @@CELL_arg_inline_swap@@
// want: 3.5
function id1(a) { return a }
function id2(a) { return a }
function g(r) { return r.f(2) + r.g(1.5) }
print(g(if two() > 1 { { f: id1, g: id2 } } else { { f: id2, g: id1 } }))
// @@CELL_arg_bound_swap@@
// want: 3.5
function id1(a) { return a }
function id2(a) { return a }
function g(r) { return r.f(2) + r.g(1.5) }
const q = if two() > 1 { { f: id1, g: id2 } } else { { f: id2, g: id1 } }
print(g(q))
// @@CELL_arg_inline_beside_records@@
// want: 14.25
function dbl(a) { return a * 2 }
function take(r) { return r.f(3) + r.f(4) }
function take2(n, r) { return r.f(n) }
const q__A__ = __V__
print(take(q) + take2(3, if two() > 5 { { f: dbl } } else { { f: inc0 } }) + take2(2.5, if two() > 5 { { f: half } } else { { f: half } }))
