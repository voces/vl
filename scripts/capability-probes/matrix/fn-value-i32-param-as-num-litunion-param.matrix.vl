// D9382's parameter twin: a function taking `i32`, delivered as one taking a numeric literal
// union. Every `N` is an `i32`, so the narrower parameter type is accepted and shares the
// signature. The second value also returns `N`, so both slots relate at once.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type N = 1 | 2
function t(k: i32): i32 { k + 40 }
const __pick: (k: i32) => N = (k: i32): N => {
  if k > 1 { return 2 }
  1
}
// @@VALUE@@
t
// @@TYPE@@
(k: N) => i32
// @@PROOF@@
print(v(2))
// @@WANT@@
42
// @@VALUE2@@
__pick
// @@TYPE2@@
(k: N) => i32
// @@PROOF2@@
print(v(2) * 10)
// @@WANT2@@
20
// @@SKIP@@
is_in_if: the value is a function, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
