// D15165: a record literal's list field written through a `const` alias of the field. The write
// is the field's own, so a call through the field's element runs the written function.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __inc(a) { return a + 1 }
function __half(a) { return a / 2.0 }
// @@SETUP@@
const __rec = { fs: [__inc] }
const __ali = __rec.fs
__ali[0] = __half
// @@VALUE@@
__rec
// @@TYPE@@
{ fs: readonly ((a: i32) => i32 | f64)[] }
// @@PROOF@@
print(v.fs[0](3))
// @@WANT@@
1.5
