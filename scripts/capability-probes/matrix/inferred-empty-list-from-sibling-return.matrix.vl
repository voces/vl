// D1591 — an un-annotated `const none = []` whose element type is supplied by a SIBLING return
// arm of the same function, delivered everywhere and read back through arithmetic.
//
// THE SUBJECT IS IN @@PRELUDE@@ AND STAYS UN-ANNOTATED IN BOTH FACES. `lookup`'s return type is
// inferred, its `none` binding is bare, and the only thing in the program that says `f64` is the
// OTHER arm's `[1.5, 2.5, 4.0]`. The face varies the DESTINATION's annotation, which is the
// half that already ran; what is being graded is that every delivery position receives the list
// the pinned hole built.
//
// THE ELEMENT MUST BE NON-i32 AND THE PROOF MUST READ IT BACK. An unpinned `[]` hole lowers as
// the i32-list default (`emptyArrHoleBuildKind` answers 0), so an `i32[]` template would go
// green whether or not the checker's pin ever reached the emitter, and a `.length`-only proof
// would go green on the wrong backing. `v.push(0.5)` then `v[0] + 0.25` is the pair that fails
// loudly if the wrapper and its array disagree.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function lookup(r: i32) {
  if r == 6 { return [1.5, 2.5, 4.0] }
  const none = []
  none
}
// @@VALUE@@
lookup(7)
// @@TYPE@@
f64[]
// @@PROOF@@
v.push(0.5)
print(v.length)
print(v[0] + 0.25)
// @@WANT@@
1 then 0.75
// @@VALUE2@@
lookup(6)
// @@TYPE2@@
f64[]
// @@PROOF2@@
print(v[2] + 0.5)
// @@WANT2@@
4.5
// @@SKIP@@
is_in_if: the value is a list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
