// `is` naming an inline arm whose field is a lone literal: the union's row spells that field at
// its base, so the test resolves the arm through the receiver's union. The proof tests the arm
// and reads its field in the narrowed branch, which only the right arm row answers (D5143).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type N = { kind: "a" | "b", v: i32 } | { kind: "end" }
function mk(e: boolean): N {
  if e { return { kind: "end" } }
  { kind: "b", v: 1 }
}
// @@VALUE@@
mk(true)
// @@TYPE@@
N
// @@TEST@@
v is { kind: "end" }
// @@HIT@@
print("end")
// @@MISS@@
print("other")
// @@WANT@@
end
// @@VALUE2@@
mk(true)
// @@TYPE2@@
N
// @@PROOF2@@
if v is { kind: "end" } { print(v.kind) } else { print("other") }
// @@WANT2@@
end
