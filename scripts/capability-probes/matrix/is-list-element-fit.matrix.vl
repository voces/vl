// D4771 — `xs is K[]` over an `i32[]` value, `K` a numeric literal union: true only when every
// element fits `K`. The value holds a `5`, so the test is false; the second instance fits.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type K = 0 | 1
// @@VALUE@@
[1, 0, 5]
// @@TYPE@@
i32[]
// @@TEST@@
v is K[]
// @@HIT@@
print(1)
// @@MISS@@
print(v.length)
// @@WANT@@
3
// @@VALUE2@@
[0, 1]
// @@TYPE2@@
i32[]
// @@PROOF2@@
if v is K[] { print(v[1]) } else { print(-1) }
// @@WANT2@@
1
