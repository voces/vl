// D2506 — a list whose only pinning write was a bare `null`, filled by a later write
// (`.push(null)` then `.push(<T>)`) with `T` = `C`. The null write pins
// `T | null` with `T` open, as `let x = null` does: the container is `(C | null)[]`.
//
// THE SETUP DECLARES IT IN THE DELIVERY'S OWN SCOPE, so each position exercises the storage
// class it has there: a function local, a start-fn local, a module global.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type C = { a: i32 }
// @@SETUP@@
const __o = []
__o.push(null)
__o.push({ a: 7 })
// @@VALUE@@
__o
// @@TYPE@@
(C | null)[]
// @@TEST@@
v[0] == null
// @@HIT@@
const __e = v[1]
if __e != null { print(__e.a) } else { print("miss") }
// @@MISS@@
print("none")
// @@WANT@@
7
// @@SKIP@@
map_value: a value read back out of a map is `V | null`, and this proof indexes the container itself
map_value_place: the same `V | null` read as `map_value`
