// A `??` over a boxed binding whose default has the binding's present type: `q ?? five()` over
// `q: i32 | null` is an `i32` (the `valScalar` arm). Evaluation order beside an earlier operand is
// pinned by tests/ir-shadow-rows/coalesce-box-*.vl, not here: an assign position evaluates twice.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function mkq(): i32 | null { return null }
function five(): i32 {
  return 5
}
// @@SETUP@@
const q = mkq()
// @@VALUE@@
q ?? five()
// @@TYPE@@
i32
// @@PROOF@@
print(v * 2)
// @@WANT@@
10
