// D1783 — an ANONYMOUS object literal whose field's value is typed as an INLINE literal
// union. `fieldCodeOfSpelling` splits the declared twin two ways (an inline member set is the
// string slot, code 3; a registered alias is the atom, code 0) and the anonymous mint had only
// the alias half, so the inline field fell to `anonTySpellable`, which declines a `TyUnion`,
// and the whole literal lost its row.
//
// NO `type` DECLARATION MAY BE ADDED. An alias over the same member set takes the code-0 rung
// instead and every cell greens for the wrong reason — that is the control, not the cell. The
// field's value must not be a bare member LITERAL either: `{ f: "green" }` types as `TyLit`,
// a plain string field, and always ran.
//
// The PROOF reads the field back, which is what shows the member survived the mint.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
const srcArr: ("red" | "green")[] = ["green", "red"]
// @@VALUE@@
{ f: srcArr[0] }
// @@TYPE@@
{ f: "red" | "green" }
// @@PROOF@@
print(v.f)
// @@WANT@@
green
// @@VALUE2@@
{ f: srcArr[1] }
// @@TYPE2@@
{ f: "red" | "green" }
// @@PROOF2@@
print("c=" + v.f)
// @@WANT2@@
c=red
