// A box of another union, narrowed to its arm `UawD`, delivered into a union with a narrower arm:
// its payload re-boxes under the narrower arm's tag, since a box keeps the tag it was built with.
// The proof reads through a `UawPet` parameter, so the un-annotated face delivers it there too.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type UawA = { k: i32, legs: i32 }
type UawB = { s: string }
type UawPet = UawA | UawB
function uawLegs(p: UawPet): i32 {
  if p is UawA { return p.legs }
  -1
}
type UawD = { k: i32, legs: i32, purr: boolean }
function uawMk(c: boolean): UawD | UawB {
  if c { return { k: 1, legs: 4, purr: true } }
  return { s: "x" }
}
const uawU = uawMk(true)
// @@GUARD@@
uawU is UawD
// @@FALLBACK@@
{ s: "f" }
// @@VALUE@@
uawU
// @@TYPE@@
UawPet
// @@TEST@@
uawLegs(v) >= 0
// @@HIT@@
print(uawLegs(v) + 1)
// @@MISS@@
print("b")
// @@WANT@@
5
