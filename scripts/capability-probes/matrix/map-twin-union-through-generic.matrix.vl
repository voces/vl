// D15540 — the generic twin of map-twin-union-delivered: the twin union (`LM | IM`) is the
// value a generic `pass<T>` hands back with `T` left open, so the hole binds to the union by
// inference, and every position delivers that call result. The proof reads the entry count
// back through a generic map parameter.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type LM = {[i32]: 1 | 2}
type IM = {[i32]: i32}
function mkI(): LM | IM {
  const m: IM = Map()
  m.set(3, 40)
  m
}
function mkL(): LM | IM {
  const m: LM = Map()
  m.set(1, 1)
  m.set(2, 2)
  m
}
function pass<T>(x: T): T { x }
function lenOf<T>(m: {[i32]: T}): i32 { m.length }
// @@VALUE@@
pass(mkI())
// @@TYPE@@
LM | IM
// @@PROOF@@
print(lenOf(v))
// @@WANT@@
1
// @@VALUE2@@
pass(mkL())
// @@TYPE2@@
LM | IM
// @@PROOF2@@
print(lenOf(pass(v)))
// @@WANT2@@
2
