// D3123 control — an INFERRED record whose field is a NULLABLE map fed by a parameter. The
// niche rung already coded it (D1665), so every cell ran before the non-null twin did; it
// pins that the mv-slot key reader the two codes now share left it running.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function mkM(k: i32, x: i32): {[i32]: i32} | null {
  if k < 0 { return null }
  const m: {[i32]: i32} = Map()
  m[k] = x
  m
}
function wrapU(m: {[i32]: i32} | null) { { regs: m } }
// @@VALUE@@
wrapU(mkM(3, 47))
// @@TYPE@@
{ regs: {[i32]: i32} | null }
// @@PROOF@@
const r = v.regs
if r != null { print(r[3] ?? -1) } else { print(-2) }
// @@WANT@@
47
// @@VALUE2@@
wrapU(mkM(-1, 0))
// @@TYPE2@@
{ regs: {[i32]: i32} | null }
// @@PROOF2@@
const r2 = v.regs
if r2 != null { print(r2.length) } else { print(-2) }
// @@WANT2@@
-2
// @@SKIP@@
is_in_if: the value is a struct, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
