// D8800: a record literal handed back by an un-annotated identity into a record that stores its
// field boxed (`A`), while the program declares the literal's own record (`II`). The identity
// hands back what it is given, so the literal adopts `A` as it does through a generic identity.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type A = { d: i32 | null }
type II = { d: i32 }
function f(v) { return v }
// @@VALUE@@
f({ d: 3 })
// @@TYPE@@
A
// @@WANT@@
3
// @@TEST@@
(v.d ?? 0) == 3
// @@HIT@@
print(v.d ?? 0)
// @@MISS@@
print(0)
// @@VALUE2@@
f({ d: 8 })
// @@TYPE2@@
A
// @@PROOF2@@
print((v.d ?? 0) * 2)
// @@WANT2@@
16
