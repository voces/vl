// one-literal-union-rep (owner 2026-10-13) — an INLINE string-literal-union value discriminated
// by `match` and `is` after delivery to every position. Both lower to an atom compare, so a
// position that delivered a string ref (or a different atom) takes the wrong arm.
//
// NO `type` DECLARATION MAY BE ADDED. The three-member set makes a positional mix-up visible:
// a wrong arm prints a different member.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function pick(n: i32): "red" | "green" | "blue" {
  if n > 1 { return "blue" }
  if n > 0 { return "green" }
  "red"
}
function name(c: "red" | "green" | "blue"): string {
  match c {
    "red" => "R"
    "green" => "G"
    "blue" => "B"
  }
}
// @@VALUE@@
pick(2)
// @@TYPE@@
"red" | "green" | "blue"
// @@TEST@@
v is "blue"
// @@HIT@@
print(name(v))
// @@MISS@@
print("miss")
// @@WANT@@
B
// @@VALUE2@@
pick(1)
// @@TYPE2@@
"red" | "green" | "blue"
// @@PROOF2@@
print("c=" + name(v))
// @@WANT2@@
c=G
