// A declared record that is an arm of another union, delivered into a union with a narrower arm:
// the record's row declares the narrower arm's row its supertype and boxes under that arm's tag.
// The proof reads through a `UawPet` parameter, so the un-annotated face delivers it there too.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type UawA = { k: i32, legs: i32 }
type UawB = { s: string }
type UawPet = UawA | UawB
function uawLegs(p: UawPet): i32 {
  if p is UawA { return p.legs }
  -1
}
type UawD = { k: i32, legs: i32, purr: boolean }
const uawD: UawD = { k: 1, legs: 4, purr: true }
const uawW: UawD | UawB = uawD
// @@VALUE@@
uawD
// @@TYPE@@
UawPet
// @@TEST@@
uawLegs(v) >= 0
// @@HIT@@
print(uawLegs(v) + 1)
// @@MISS@@
print("b")
// @@WANT@@
5
