// A `??` chain of three or more links whose re-associated inner link (`b ?? d` of `a ?? b ?? d`)
// carries no type of its own: a literal-union chain whose default is a member literal, and a
// hole's map reads of mixed kinds (literal keys: a call key there is D17181). Each link runs at
// most once, left to right; the inner link bound to a `const` first is the control.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type K = "a" | "b"
let log = ""
function mkK(n: i32): K | null {
  log = log + "m"
  return if n == 1 { "b" } else { null }
}
function nul(): K | null {
  log = log + "r"
  return null
}
// @@VALUE@@
nul() ?? mkK(1) ?? "a"
// @@TYPE@@
K
// @@PROOF@@
print(v)
print(log == "rm" || log == "rmrm")
// @@TEST@@
v == "b"
// @@HIT@@
print(v)
print(log == "rm" || log == "rmrm")
// @@MISS@@
print("miss")
// @@WANT@@
b then true
// @@CELL_four_links@@
// want: b then rrm
print(nul() ?? nul() ?? mkK(1) ?? "a")
print(log)
// @@CELL_default_reached@@
// want: a then rm
print(nul() ?? mkK(0) ?? "a")
print(log)
// @@CELL_short_circuit@@
// want: b then m
print(mkK(1) ?? nul() ?? "a")
print(log)
// @@CELL_inner_bound_control@@
// want: b then mr
const inner = mkK(1) ?? "a"
print(nul() ?? inner)
print(log)
// @@CELL_hole_mixed_kinds@@
// want: 2 then true then 2
function f(a, b) { print(a[9] ?? a[8] ?? b[3]) }
const t: {[i32]: boolean} = Map()
const n: {[i32]: i32} = Map()
n[3] = 2
f(t, n)
const t2: {[i32]: boolean} = Map()
t2[8] = true
f(t2, n)
function f4(a, b) { print(a[9] ?? a[7] ?? a[6] ?? b[3]) }
f4(t, n)
// @@CELL_hole_mixed_bound_control@@
// want: 2
function g(a, b) {
  const x = a[8] ?? b[3]
  print(a[9] ?? x)
}
const gt: {[i32]: boolean} = Map()
const gn: {[i32]: i32} = Map()
gn[3] = 2
g(gt, gn)
