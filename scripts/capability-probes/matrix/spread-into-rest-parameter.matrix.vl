// A CALL-SITE SPREAD delivered into a REST parameter, at every position the value can be
// delivered to, in both faces. The rest parameter is enforced in ONE place (the checker's
// pack) and served in many, so the pack has to be graded at every delivery rather than at
// the argument boundary alone — CLAUDE.md's position-matrix rule.
//
// `collect` hands the packed list straight back, so the value under test IS the pack: a
// delivery that lost it prints the wrong length or fails to build.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function collect(...xs: i32[]): i32[] { return xs }
const src: i32[] = [4, 5, 6]
const src2: i32[] = [7, 8]
// @@VALUE@@
collect(3, ...src)
// @@TYPE@@
i32[]
// @@PROOF@@
print(v.length * 100 + v[0] * 10 + v[3])
// @@WANT@@
436
// @@VALUE2@@
collect(...src2)
// @@TYPE2@@
i32[]
// @@PROOF2@@
print(v.length * 100 + v[0] * 10 + v[1])
// @@WANT2@@
278
// @@SKIP@@
is_in_if: the value is a list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
