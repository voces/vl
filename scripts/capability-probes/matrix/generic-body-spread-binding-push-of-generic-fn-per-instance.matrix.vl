// Per instance: a generic function spreads an un-annotated binding of a fresh list holding a
// generic function named at T into a push onto an annotated list. At i32 (3) and at string (ab).
// D16695, and its field, element and initialiser positions D16698.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __id<T>(x: T): T { return x }
function __run<T>(x: T): ((x: T) => T)[] {
  const rs: ((x: T) => T)[] = []
  const src = [__id]
  rs.push(...src)
  return rs
}
// @@VALUE@@
__run(3)
// @@TYPE@@
((x: i32) => i32)[]
// @@PROOF@@
for f in v { print(f(3)) }
// @@WANT@@
3
// @@VALUE2@@
__run("ab")
// @@TYPE2@@
((x: string) => string)[]
// @@PROOF2@@
for f in v { print(f("ab")) }
// @@WANT2@@
ab
// @@CELL_string_first@@
// want: ab then 3
print(__run("ab")[0]("ab"))
print(__run(3)[0](3))
// @@CELL_four_instances@@
// want: 3 then ab then false then 2.5
print(__run(3)[0](3))
print(__run("ab")[0]("ab"))
print(__run(true)[0](false))
print(__run(2.5)[0](2.5))
// @@CELL_body_record@@
// want: 3 then ab
function __runR<T>(x: T) {
  const rs: {f: (x: T) => T}[] = []
  const src = [{ f: __id }]
  rs.push(...src)
  return rs
}
print(__runR(3)[0].f(3))
print(__runR("ab")[0].f("ab"))
// @@CELL_body_two_elements@@
// want: 2 then 3 then ab
function __runT<T>(x: T) {
  const rs: ((x: T) => T)[] = []
  const src = [__id, __id]
  rs.push(...src)
  return rs
}
print(__runT(3).length)
print(__runT(3)[1](3))
print(__runT("ab")[1]("ab"))
// @@CELL_body_after_direct_push@@
// want: 2 then 3 then ab
function __runD<T>(x: T) {
  const rs: ((x: T) => T)[] = []
  rs.push(__id)
  const src = [__id]
  rs.push(...src)
  return rs
}
print(__runD(3).length)
print(__runD(3)[1](3))
print(__runD("ab")[1]("ab"))
// @@CELL_body_called@@
// want: 3 then ab
function __runC<T>(x: T): T {
  const rs: ((x: T) => T)[] = []
  const src = [__id]
  rs.push(...src)
  return rs[0](x)
}
print(__runC(3))
print(__runC("ab"))
// @@CELL_body_unannotated_list@@
// want: 3 then ab
function __runU<T>(x: T) {
  const rs = []
  const src = [__id]
  rs.push(...src)
  return rs
}
print(__runU(3)[0](3))
print(__runU("ab")[0]("ab"))
// @@CELL_body_nested_record@@
// want: 3 then ab
function __runN<T>(x: T) {
  const rs: {g: {f: (x: T) => T}}[] = []
  const src = [{ g: { f: __id } }]
  rs.push(...src)
  return rs
}
print(__runN(3)[0].g.f(3))
print(__runN("ab")[0].g.f("ab"))
// @@CELL_body_annotated_binding@@
// want: 3 then ab
function __runA<T>(x: T) {
  const rs: ((x: T) => T)[] = []
  const src: ((x: T) => T)[] = [__id]
  rs.push(...src)
  return rs
}
print(__runA(3)[0](3))
print(__runA("ab")[0]("ab"))
// @@CELL_top_level_closed@@
// want: 9
function __sq(x: i32): i32 { return x * x }
const rs: ((x: i32) => i32)[] = []
const src = [__sq]
rs.push(...src)
print(rs[0](3))
// @@CELL_body_field_list@@
// want: 3 then ab
function __runF<T>(x: T) {
  const o: {rs: ((x: T) => T)[]} = { rs: [] }
  const src = [__id]
  o.rs.push(...src)
  return o.rs
}
print(__runF(3)[0](3))
print(__runF("ab")[0]("ab"))
// @@CELL_body_nested_field_list@@
// want: 3 then ab
function __runG<T>(x: T) {
  const o: {a: {rs: ((x: T) => T)[]}} = { a: { rs: [] } }
  const src = [__id]
  o.a.rs.push(...src)
  return o.a.rs
}
print(__runG(3)[0](3))
print(__runG("ab")[0]("ab"))
// @@CELL_body_element_list@@
// want: 3 then ab
function __runE<T>(x: T) {
  const ls: ((x: T) => T)[][] = [[]]
  const src = [__id]
  ls[0].push(...src)
  return ls[0]
}
print(__runE(3)[0](3))
print(__runE("ab")[0]("ab"))
// @@CELL_body_spread_initialiser@@
// want: 3 then ab
function __runI<T>(x: T) {
  const src = [__id]
  const rs: ((x: T) => T)[] = [...src]
  return rs
}
print(__runI(3)[0](3))
print(__runI("ab")[0]("ab"))
// @@CELL_body_spread_initialiser_record@@
// want: 3 then ab
function __runJ<T>(x: T) {
  const src = [{ f: __id }]
  const rs: {f: (x: T) => T}[] = [...src]
  return rs
}
print(__runJ(3)[0].f(3))
print(__runJ("ab")[0].f("ab"))
