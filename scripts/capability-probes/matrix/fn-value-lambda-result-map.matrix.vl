// D9741: a lambda returning `Map()` delivered where a function returning `{[string]: string}`
// is expected. The lambda takes the expected result as its own, as the annotated
// `(x: i32): {[string]: string} => Map()` result does, so the map is built at its value type.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@VALUE@@
(x: i32) => Map()
// @@TYPE@@
(x: i32) => {[string]: string}
// @@PROOF@@
const m = v(1)
m["a"] = "q"
print(m["a"] ?? "none")
// @@WANT@@
q
// @@VALUE2@@
(x: i32) => Map()
// @@TYPE2@@
(x: i32) => {[string]: string}
// @@PROOF2@@
print(v(2).length)
// @@WANT2@@
0
