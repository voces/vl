// D3123 (plumb PL-075) — an INFERRED record whose field is fed by a binding, not a `Map()`
// call: a map (string keys, string values) local. The field-code ladder coded a map only off a call and its spellability gate
// declines a `TyMap`, so the literal minted no row and its function's return had no shape.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function wrapL(k: string, x: string) {
  const m: {[string]: string} = Map()
  m[k] = x
  { n: m.length, regs: m }
}
// @@VALUE@@
wrapL("a", "ay")
// @@TYPE@@
{ n: i32, regs: {[string]: string} }
// @@PROOF@@
print(v.n * 100 + (v.regs["a"] ?? "").length)
// @@WANT@@
102
// @@VALUE2@@
wrapL("b", "bee")
// @@TYPE2@@
{ n: i32, regs: {[string]: string} }
// @@PROOF2@@
print(v.regs["b"] ?? "miss")
// @@WANT2@@
bee
// @@SKIP@@
is_in_if: the value is a struct, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
