// D8120: a map cell of an `i32 | K | null` box, narrowed to its literal-union arm by the else
// of `is i32`, printed. The map comes out of a generic body at an open `T`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type __AB = "a" | "b"
function __cell<T>(x: T | __AB | null): { [string]: T | __AB | null } {
  const m: { [string]: T | __AB | null } = Map()
  m["k"] = x
  return m
}
// @@VALUE@@
__cell<i32>("b")
// @@TYPE@@
{ [string]: i32 | __AB | null }
// @@PROOF@@
if v["k"] is i32 { print(0) } else { print(v["k"]) }
// @@WANT@@
b
// @@VALUE2@@
__cell<i32>(4)
// @@TYPE2@@
{ [string]: i32 | __AB | null }
// @@PROOF2@@
if v["k"] is i32 { print(v["k"] + 1) } else { print(v["k"]) }
// @@WANT2@@
5
