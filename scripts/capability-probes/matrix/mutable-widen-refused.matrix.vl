// D2161's close, the spelling that is REFUSED: a `C[]` delivered where a mutable `(C | null)[]`
// is declared. Only a `readonly` list is covariant, so the ANNOTATED face must read `check
// refuses` at every position, and never SILENT; the un-annotated face infers `C[]` and runs.
// `readonly-widen-shared-nullable.matrix.vl` is the twin that runs.
//
// The proof reads only the length: the un-annotated face types `v` as `C[]`, where a `null`
// test does not check. The list is shared, so there is no converted element to verify.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type C = { n: i32 }
// @@SETUP@@
const cs: C[] = [{ n: 7 }]
// @@VALUE@@
cs
// @@TYPE@@
(C | null)[]
// @@PROOF@@
print(v.length + 6)
// @@WANT@@
7
