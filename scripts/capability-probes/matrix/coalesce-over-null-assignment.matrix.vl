// A `??` over an assignment of `null`, at every delivery position: the assignment's value is the
// `null` unit, so the store runs and the `??` is its default. The default counts its evaluations
// and each cell prints the count and the place, so a cell proves the store ran and the default
// ran once (a built-in position may write the value twice, as `local_assign` does). The cells
// take a field, an element, a never-filled `let x = null` written by a call, a number default, a
// chain, module level and a present-value control (D17301).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
let __s: string | null = "x"
let __cnt = 0
function __d(): string {
  __cnt = __cnt + 1
  return "d"
}
function __same<T>(x: T): T { return x }
// @@VALUE@@
((__s = null) ?? __d())
// @@TYPE@@
string
// @@PROOF@@
print(v)
print(__s ?? "null")
// @@WANT@@
d then null
// @@CELL_local@@
// want: d then null then 1
function f() {
  let n: string | null = "x"
  print((n = null) ?? __d())
  print(n ?? "null")
  print(__cnt)
}
f()
// @@CELL_field@@
// want: d then null then 1
function f() {
  const o: { f: string | null } = { f: "x" }
  print((o.f = null) ?? __d())
  print(o.f ?? "null")
  print(__cnt)
}
f()
// @@CELL_element@@
// want: d then null then 1
function f() {
  const xs: (string | null)[] = ["x"]
  print((xs[0] = null) ?? __d())
  print(xs[0] ?? "null")
  print(__cnt)
}
f()
// @@CELL_hole_written_by_call@@
// want: d then 1
function f() {
  let h = null
  print((h = __same(null)) ?? __d())
  print(__cnt)
}
f()
// @@CELL_number_default@@
// want: 7 then null
function f() {
  let n: i32 | null = 3
  print((n = null) ?? 7)
  print(n ?? "null")
}
f()
// @@CELL_chain@@
// want: z then null then null
function f() {
  let a: string | null = "x"
  let b: string | null = "y"
  print((a = null) ?? (b = null) ?? "z")
  print(a ?? "null")
  print(b ?? "null")
}
f()
// @@CELL_module@@
// want: d then null then 1
let m: string | null = "x"
print((m = null) ?? __d())
print(m ?? "null")
print(__cnt)
// @@CELL_present_control@@
// want: y then 0
function f() {
  let n: string | null = "x"
  print((n = "y") ?? __d())
  print(__cnt)
}
f()
