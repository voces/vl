// D8145 — a list element narrowed to a record arm, its nullable value-box field read by `??`.
// The receiver is an index place, so the read has no member-path key; the arm comes out of the
// element's box and the atom out of the field's. The arm must also exist as a bare value
// (`__q`): that is what gives it a struct row for the index place to be mistaken for.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type J8145 = { r: i32 | null }
type K8145 = { z: i32 }
// @@SETUP@@
const __q: J8145 = { r: 5 }
const __xs: (J8145 | K8145)[] = [__q, { z: 1 }]
// @@GUARD@@
__xs[0] is J8145
// @@VALUE@@
__xs[0].r ?? 0
// @@TYPE@@
i32
// @@FALLBACK@@
0
// @@TEST@@
v > 4
// @@HIT@@
print(v + 1)
// @@MISS@@
print(0)
// @@WANT@@
6
