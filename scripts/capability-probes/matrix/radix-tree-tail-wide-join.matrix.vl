// D16498 — a radix tree as a value join's tail, beside a decimal outside `i32`, computes at the
// join's `i64` (ruling A with 4.3), under every operator, with or without a destination.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __yes(): boolean { return true }
// @@VALUE@@
if __yes() { 0xFFFFFFFF % 7 } else { 3000000000 }
// @@TYPE@@
i64
// @@PROOF@@
print(v)
// @@WANT@@
3
// @@VALUE2@@
if __yes() { 0xFFFFFFFF << 1 } else { 3000000000 }
// @@TYPE2@@
i64
// @@PROOF2@@
print(v)
// @@WANT2@@
8589934590
