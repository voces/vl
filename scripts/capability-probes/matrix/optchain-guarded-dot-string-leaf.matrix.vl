// A5 / D1815 — the guarded-chain leaf at the OTHER nullable rep: `string | null` is the
// nullable array-ref niche, not the `{tag, payload}` box the scalar leaf rides, so the two
// arms of the chain's own guard join on a different type.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type Leaf = { s: string }
type Inner = { y: Leaf }
function mkI(c: boolean): Inner | null {
  if c { return { y: { s: "ok" } } }
  return null
}
const o = mkI(true)
// @@VALUE@@
o?.y.s
// @@TYPE@@
string | null
// @@FALLBACK@@
null
// @@PROOF@@
print(v ?? "none")
// @@WANT@@
ok
