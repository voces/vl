// A set of functions whose results differ (`inc0` gives `i32`, `half` gives `f64`), left as
// closures inside an instance and called there: each call runs its member at the member's own
// signature, so the list walk prints 4 then 1.5 (D16747). The built-in positions deliver an element
// of a module-level set; the cells walk a list parameter and call each element through a `let`
// copy, a re-pointed copy, a record field, a capture, a handed-on value, a map and a return.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const __fs = [inc0, half]
// @@VALUE@@
__fs[1]
// @@TYPE@@
(a: i32) => f64
// @@PROOF@@
print(v(3))
// @@WANT@@
1.5
// @@CELL_for_direct@@
// want: 4 then 1.5
function run(xs) {
  for x in xs { print(x(3)) }
}
run([inc0, half])
// @@CELL_let_copy@@
// want: 4 then 1.5
function run(xs) {
  for x in xs {
    let y = x
    print(y(3))
  }
}
run([inc0, half])
// @@CELL_let_copy_repointed@@
// want: 1.5 then 1.5
function run(xs) {
  for x in xs {
    let y = x
    y = half
    print(y(3))
  }
}
run([inc0, half])
// @@CELL_record_field@@
// want: 4 then 1.5
function run(xs) {
  for x in xs {
    const r = { g: x }
    print(r.g(3))
  }
}
run([inc0, half])
// @@CELL_captured@@
// want: 4 then 1.5
function run(xs) {
  for x in xs {
    const c = () => x(3)
    print(c())
  }
}
run([inc0, half])
// @@CELL_handed_on@@
// want: 4 then 1.5
function call(g) { return g(3) }
function run(xs) {
  for x in xs { print(call(x)) }
}
run([inc0, half])
// @@CELL_beside_map_write@@
// want: 4 then 1.5
function run(xs) {
  const m: {[string]: i32} = Map()
  let i = 0
  for x in xs {
    m["k"] = i
    print(x(3))
    i = i + 1
  }
}
run([inc0, half])
// @@CELL_returned_element@@
// want: 4 then 1.5
function at(xs, i: i32) { return xs[i] }
function run(xs) {
  print(at(xs, 0)(3))
  print(at(xs, 1)(3))
}
run([inc0, half])
// @@CELL_while_index@@
// want: 4 then 1.5
function run(xs) {
  let i = 0
  while i < 2 {
    print(xs[i](3))
    i = i + 1
  }
}
run([inc0, half])
