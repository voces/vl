// A list of records whose function field is nullable: one is cleared, the other written, and the
// walk calls through a narrowed read. Only the written member answers: 8. The un-annotated face
// refuses the `null` write: the literal's field is `(n: i32) => i32`, and nothing widens it.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __dbl(n: i32): i32 { return n * 2 }
// @@VALUE@@
[{ f: __dbl }, { f: __dbl }]
// @@TYPE@@
{f: ((n: i32) => i32) | null}[]
// @@PROOF@@
v[0].f = null
let c = 0
for r in v {
  const g = r.f
  if g != null { c = c + g(4) }
}
print(c)
// @@WANT@@
8
