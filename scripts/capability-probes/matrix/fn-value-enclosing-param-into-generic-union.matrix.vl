// A generic's own `() => x` handed to a generic's `() => T | string` parameter, at a pin where the
// enclosing type parameter is `string` (so the result is that one member) and at one where it is
// not. D10270.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function len<T>(f: () => T | string) {
  const t = f()
  if t is string { t.length } else { 99 }
}
function outer<U>(x: U): i32 { len(() => x) }
// @@VALUE@@
"abc"
// @@TYPE@@
string
// @@PROOF@@
print(outer(v))
// @@WANT@@
3
// @@VALUE2@@
2.5
// @@TYPE2@@
f64
// @@PROOF2@@
print(outer(v))
// @@WANT2@@
99
