// D4056 — overlapping arms: `A`'s field is `i32 | string` and `B`'s is `string`. A value built
// as `A` that holds a string fits `B` too, and `is B` says so (spec Q4 (c)). A value that
// passed may be laid out as either arm; the hit reads `v.n` into the join so it spells the same
// whether the then arm keeps `A | B` (a declared union) or narrows (a type parameter).
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type A = { n: i32 | string }
type B = { n: string }
function pick(n: i32): A | B {
  const s: string = "s"
  if n == 0 { const a: A = { n: 3 }; return a }
  if n == 1 { const a: A = { n: s }; return a }
  { n: "b" }
}
// @@VALUE@@
pick(1)
// @@TYPE@@
A | B
// @@TEST@@
v is B
// @@HIT@@
const got: i32 | string = v.n
if got is string { print("B " + got) } else { print("wrong") }
// @@MISS@@
print("wrong")
// @@WANT@@
B s
// @@VALUE2@@
pick(0)
// @@TYPE2@@
A | B
// @@PROOF2@@
if v is B { print("wrong") } else { print(v.n is i32) }
// @@WANT2@@
true
