// An empty set whose annotation fixes its element type, delivered into a union of two set
// types at every position: `is` answers by the arm it was delivered as, so the other arm's
// test is false though the set is empty (owner ruling 2026-11-15, refining D16047).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
const __e: Set<i32> = Set()
// @@VALUE@@
__e
// @@TYPE@@
Set<i32> | Set<string>
// @@TEST@@
v is Set<string>
// @@HIT@@
print(0)
// @@MISS@@
print(42)
// @@WANT@@
42
