// D10091, the open face: a map read's `??` with an `f64` default in a recursive function generic
// over the map's value, called at `Map<string, i32>`, read at `f64`: a hit widens the stored
// `i32`, a miss is the default. The `??` itself joins as `i32 | f64`, as the direct twin's does.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __cwG<V>(m: Map<string, V>, k: string, d: f64, n: i32) {
  if n > 0 { return __cwG(m, k, d, n - 1) }
  return m.get(k) ?? d
}
const __cwGMap: Map<string, i32> = Map()
__cwGMap.set("k", 5)
// @@VALUE@@
__cwG(__cwGMap, "k", 1.5, 1)
// @@TYPE@@
f64
// @@PROOF@@
const __cwW: f64 = v
print(__cwW / 2)
// @@WANT@@
2.5
// @@VALUE2@@
__cwG(__cwGMap, "z", 1.5, 1)
// @@TYPE2@@
f64
// @@PROOF2@@
print(v)
// @@WANT2@@
1.5
