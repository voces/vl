// A list-literal spread of a literal-union list into a `string[]`: each atom is re-encoded
// as its string (D2868). The trailing `"z"` types the un-annotated face as a string list too.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type Kx = "x" | "y"
const src: Kx[] = ["x", "y"]
// @@VALUE@@
[...src, "z"]
// @@TYPE@@
string[]
// @@PROOF@@
print("\{v[0]}\{v[1]}\{v[2]}\{v.length}")
// @@WANT@@
xyz3
// @@SKIP@@
is_in_if: the value is a list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
