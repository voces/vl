// A write through the union to a literal-union field every arm shares, with the arms' sets
// differing: each arm stores the member at its own atoms. The value is the arm whose set
// is `"a" | "end"`, so a store at the other arm's layout reads back wrong (D5158).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type M = { k: "a" | "b", v: i32 } | { k: "a" | "end", w: boolean }
function mk(e: boolean): M {
  if e { return { k: "end", w: true } }
  { k: "b", v: 1 }
}
// @@VALUE@@
mk(true)
// @@TYPE@@
M
// @@PROOF@@
v.k = "a"
print(v.k == "a")
// @@WANT@@
true
// @@VALUE2@@
mk(false)
// @@TYPE2@@
M
// @@PROOF2@@
v.k = "a"
print(v.k)
// @@WANT2@@
a
