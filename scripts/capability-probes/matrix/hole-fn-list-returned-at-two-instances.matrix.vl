// A list literal of un-annotated functions returned from a function with an un-annotated
// parameter, delivered at every position from a call at `i32` and read back by a `.map` callback
// that calls its element at `i32`, while a call at `string` takes a second instance read back at
// `f64` (D9601). The proof prints the `f64` read only when the `i32` read was right.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __inc(a) { return a + 1 }
function __dbl(a) { return a * 2 }
function __give(_n) {
  return [__inc, __dbl]
}
// @@VALUE@@
__give(1)
// @@TYPE@@
((a: i32) => i32)[]
// @@PROOF@@
if v.map((f) => f(3))[1] == 6 {
  print(__give("s").map((f) => f(1.25))[1])
} else {
  print("wrong i32 read")
}
// @@WANT@@
2.5
