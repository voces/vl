// A narrowed box-field read (D17048): a box local narrowed by a discriminant compare, its field
// `f` stored as i32[] and read at each delivery position. Every cell prints the field's value,
// decoded where its storage is not the destination's rep.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type A = { tag: "b" | "c", f: i32[] }
type B = { tag: "a", f: i32[] }
function mk(n: i32): A | B {
  if n == 0 { return { tag: "b", f: [] } }
  return { tag: "a", f: [4, 5] }
}
// @@SETUP@@
const b = mk(2)
// @@GUARD@@
b.tag == "a"
// @@VALUE@@
b.f
// @@TYPE@@
i32[]
// @@FALLBACK@@
[0, 0]
// @@PROOF@@
print(v[1])
// @@TEST@@
v.length == 2
// @@HIT@@
print(5)
// @@MISS@@
print(0)
// @@CELL_param_return@@
function h(b: A | B)__A__ {
  if b.tag == "a" { return __V__ }
  return [0, 0]
}
const v = h(mk(2))
print(v[1])
// @@CELL_param_binding@@
function h(b: A | B) {
  if b.tag == "a" {
    const v__A__ = __V__
    print(v[1])
  }
}
h(mk(2))
// @@CELL_param_element@@
function h(b: A | B) {
  if b.tag == "a" {
    const xs__LA__ = [__V__]
    const v = xs[0]
    print(v[1])
  }
}
h(mk(2))
// @@CELL_param_argument@@
function take(v: __TY__) { print(v[1]) }
function h(b: A | B) {
  if b.tag == "a" { take(__V__) }
}
h(mk(2))
// @@WANT@@
5
