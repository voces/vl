// D4771 — `xs is S[]` over a `string[]` value, `S` a string literal union: true only when every
// element is a member of `S`. The value holds a `"c"`, so the test is false; the second fits.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type S = "a" | "b"
// @@VALUE@@
["a", "c"]
// @@TYPE@@
string[]
// @@TEST@@
v is S[]
// @@HIT@@
print("hit")
// @@MISS@@
print(v[1])
// @@WANT@@
c
// @@VALUE2@@
["b", "a"]
// @@TYPE2@@
string[]
// @@PROOF2@@
if v is S[] { print(v[0]) } else { print("miss") }
// @@WANT2@@
b
