// D1710 — an anonymous holder whose field is `K | null`, a literal-union ALIAS beside null:
// the i32 atom slot with `-1` for null (code 30). The code was already computed; what was
// missing is the union NAME beside it, which is how the membership is recovered.
//
// The proof prints the MEMBER, not a number: a litunion atom is an interned i32, so a field
// that lost its union name reads back as an id and the cell is a wrong VALUE, not a refusal.
//
// This template deliberately has NO non-null twin holder in its prelude, unlike its two
// list-element siblings. A `{ xs: K }` holder beside a `{ xs: K | null }` one refuses at both
// seeds — codes 0 and 30 collide on the field name — and that is D1715, not this row.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type K = "a" | "b"
function nul1(): K | null { return "b" }
function nul2(): K | null { return "a" }
// @@VALUE@@
{ xs: nul1() }
// @@TYPE@@
{ xs: K | null }
// @@PROOF@@
const l = v.xs
if l != null { print(l) } else { print("none") }
// @@WANT@@
b
// @@VALUE2@@
{ xs: nul2() }
// @@TYPE2@@
{ xs: K | null }
// @@PROOF2@@
const l2 = v.xs
if l2 != null { print(l2) } else { print("none") }
// @@WANT2@@
a
// @@SKIP@@
is_in_if: the value is a struct, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
