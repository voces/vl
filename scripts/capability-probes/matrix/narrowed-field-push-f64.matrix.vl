// D2235 — a narrowed nullable list FIELD as a `.push` receiver, f64 elements. The
// staged receiver slot is a non-null wrapper ref and the field read is `(ref null $wrap)`, so
// the stage owes the same `ref.as_non_null` a narrowed global or capture gets. The VALUE is
// the push itself, so every position delivers a push whose receiver is the field path.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@SETUP@@
const __r: { f: f64[] | null } = { f: [1.5] }
// @@GUARD@@
__r.f != null
// @@VALUE@@
__r.f.push(2.5)
// @@TYPE@@
i32
// @@FALLBACK@@
0
// @@TEST@@
v > 1
// @@HIT@@
print(true)
// @@MISS@@
print(false)
// @@WANT@@
true
