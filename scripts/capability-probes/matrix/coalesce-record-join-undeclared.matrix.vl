// D2373 — a `??` joining two nullable records of different types, where no declaration names
// the join `A | B | null`. The join is the union box and its row is minted from the checker's
// own recorded type; an unused `C` is declared so a row minted one slot off would show.
//
// The second instance is the both-null case: the box's null tag, never an arm.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type A = { r: i32 }
type B = { q: string }
type C = { z: f64 }
function mkA(): A | null { return null }
function mkB(): B | null { return { q: "b" } }
function mkN(): B | null { return null }
// @@VALUE@@
mkA() ?? mkB()
// @@TYPE@@
A | B | null
// @@TEST@@
v is B
// @@HIT@@
print("b")
// @@MISS@@
print("miss")
// @@WANT@@
b
// @@VALUE2@@
mkA() ?? mkN()
// @@TYPE2@@
A | B | null
// @@PROOF2@@
if v is A { print("A") } else if v is B { print("B") } else { print(v == null) }
// @@WANT2@@
true
