// Postfix `++`/`--` on a field or an element (D4055), and on a name of each numeric width in value
// position (D16216): the place is incremented once, as prefix `++` does, and the expression yields
// the old value. The annotated face spells the record's or the list's type on its binding.
// @@PRELUDE@@
type C = { n: i32, x: f64 }
// @@VALUE@@
{ n: 1, x: 1.5 }
// @@TYPE@@
C
// @@PROOF@@
print(v.n)
// @@WANT@@
1
// @@SKIP@@
binding: the built-in positions deliver the record; the cells increment its places
return_inferred: same
return_annotated: same
argument: same
struct_field_init: same
struct_field_assign: same
array_element: same
array_element_assign: same
array_push: same
local_assign: same
global_init: same
global_assign: same
map_value: same
map_set: same
closure_capture: same
block_if: same
block_if_capture: same
block_while: same
block_while_capture: same
block_bare: same
block_bare_capture: same
fn_body: same
fn_body_capture: same
is_in_if: same
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
array_element_place: same
map_value_place: same
struct_field_place: same
early_return_guard: same
two_instances: same
// @@CELL_field_stmt@@
// want: 2
const c__A__ = __V__
c.n++
print(c.n)
// @@CELL_field_dec@@
// want: 0
const c__A__ = __V__
c.n--
print(c.n)
// @@CELL_field_old@@
// want: 21
const c__A__ = __V__
const o = c.n++
print(o + c.n * 10)
// @@CELL_field_f64@@
// want: 2.5
const c__A__ = __V__
c.x++
print(c.x)
// @@CELL_field_f64_old@@
// want: 1.5
const c__A__ = __V__
print(c.x++)
// @@CELL_elem_stmt@@
// want: 3
const xs: i32[] = [1, 2]
xs[1]++
print(xs[1])
// @@CELL_elem_old@@
// want: 1
const xs: i32[] = [1, 2]
print(xs[0]--)
// @@CELL_elem_call_index@@
// want: 21
let calls = 0
function k(): i32 {
  calls = calls + 1
  0
}
const xs: i32[] = [1, 2]
xs[k()]++
print(xs[0] * 10 + calls)
// @@CELL_nested@@
// want: 2
const o = { c: __V__ }
o.c.n++
print(o.c.n)
// @@CELL_in_loop@@
// want: 3
const xs: i32[] = [0, 0, 0]
let i = 0
while i < 3 {
  xs[i]++
  i++
}
print(xs[0] + xs[1] + xs[2])
// @@CELL_param_field@@
// want: 2
function bump(c: C) { c.n++ }
const c__A__ = __V__
bump(c)
print(c.n)
// @@CELL_name_f64_old@@
// want: 1.5
let y = 1.5
print(y++)
// @@CELL_name_i64_old@@
// want: 5
let y = 5 as i64
print(y++)
