// A closure over a list it pushes to, delivered and called twice.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __mk() {
  const xs: i32[] = []
  return (x: i32) => {
    xs.push(x)
    return xs.length
  }
}
// @@VALUE@@
__mk()
// @@TYPE@@
(x: i32) => i32
// @@PROOF@@
v(5)
print(v(6))
// @@WANT@@
2
