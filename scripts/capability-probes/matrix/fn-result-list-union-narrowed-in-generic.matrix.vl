// D10031 — a function value whose result is `i32[] | i32`, handed to a generic that takes it as
// `() => T[] | i32`, calls it and reads `.length` past an `is i32` narrow. `T` is bound only
// through the function's union result; before the fix the instance's body read `t` unbound.
//
// The value is the function, so each position delivers it before the generic reads it.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function len<T>(f: () => T[] | i32) {
  const t = f()
  if t is i32 { t } else { t.length }
}
const g: () => i32[] | i32 = () => [1, 2]
const h: () => string[] | i32 = () => ["a", "b", "c"]
// @@VALUE@@
g
// @@TYPE@@
() => i32[] | i32
// @@PROOF@@
print(len(v))
// @@WANT@@
2
// @@VALUE2@@
h
// @@TYPE2@@
() => string[] | i32
// @@PROOF2@@
print(len(v))
// @@WANT2@@
3
