// D2209's generic twin: the empty `[]` arm sits inside a generic body whose element type is the
// open parameter `T`, so the literal's recorded type is the template's `T[]` and names no rep.
// Each instance has to build it at that instance's element. The pin here is `string`; the
// un-annotated tail `if` is the spelling that reads the instance's inferred return.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function falsy() { 1 == 2 }
function gtail<T>(xs: T[]) { if falsy() { xs } else { [] } }
function gbind<T>(xs: T[]) {
  const r = if falsy() { xs } else { [] }
  r
}
const src = ["a", "b"]
// @@VALUE@@
gtail(src)
// @@TYPE@@
string[]
// @@PROOF@@
const r = v
r.push("x")
print(r.length)
// @@WANT@@
1
// @@VALUE2@@
gbind(src)
// @@TYPE2@@
string[]
// @@PROOF2@@
const r2 = v
r2.push("y")
print(r2[0])
// @@WANT2@@
y
// @@SKIP@@
is_in_if: the value is a list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
