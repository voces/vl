// D9572: a record of an un-annotated function, and a record of an annotated lambda returning
// another type built in the prelude, both handed to one un-annotated parameter that calls the
// field. Each call keeps its own record type, so every cell prints `4`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function inc0(a) { return a + 1 }
function take(a) { return a.f(3) }
const other = take({ f: (x: i32): f64 => 1.5 })
// @@VALUE@@
{ f: inc0 }
// @@TYPE@@
{ f: (a: i32) => i32 }
// @@PROOF@@
print(take(v))
// @@WANT@@
4
// @@SKIP@@
is_in_if: the value is a record, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
