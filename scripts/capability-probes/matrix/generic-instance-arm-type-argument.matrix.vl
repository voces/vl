// D15096 — a generic record instance whose type ARGUMENT is a union arm (`Cell<O>` with
// `type Cell<T> = { val: T }`). The instance's field named the arm, not its twin row, and the
// arm's row was never minted when only a type argument reached it, so the type section found
// no element row. The second instance is over the union's other arm.
//
// The PROOF reads a field of the held arm, so a field read that lands on the wrong row cannot
// print `2`.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type O = { n: i32, k: i32 }
type P = { m: i32 }
type U = O | P
type Cell<T> = { val: T }
function mkCell(n: i32): Cell<O> {
  return { val: { n: n, k: 0 } }
}
function mkPCell(m: i32): Cell<P> {
  return { val: { m: m } }
}
// @@VALUE@@
mkCell(2)
// @@TYPE@@
Cell<O>
// @@FALLBACK@@
mkCell(5)
// @@TEST@@
v.val.n == 2
// @@HIT@@
print(2)
// @@MISS@@
print(9)
// @@WANT@@
2
// @@VALUE2@@
mkPCell(3)
// @@TYPE2@@
Cell<P>
// @@PROOF2@@
print(v.val.m)
// @@WANT2@@
3
