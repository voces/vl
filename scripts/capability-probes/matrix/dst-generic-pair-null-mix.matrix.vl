// D4024 — `null` beside a record argument binds `T` from the destination when the record is
// one of its members, so `pair(null, { n: 2 })` is the `Item | null` instance.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type Item = { n: i32 }
function pair<T>(a: T, b: T): T[] { [a, b] }
// @@VALUE@@
pair(null, { n: 2 })
// @@TYPE@@
(Item | null)[]
// @@PROOF@@
const e = v[1]
if e != null { print(e.n) } else { print("none") }
// @@WANT@@
2
