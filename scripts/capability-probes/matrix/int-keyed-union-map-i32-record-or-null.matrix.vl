// D2519 — an i32-keyed record-valued map as a `| null` niche.
// The proof reads, writes, deletes, counts and walks the map after narrowing, so a box that
// casts to the wrong map struct fails validation or prints wrong.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type Rec = { n: i32 }
function mk(): {[i32]: Rec} {
  const m: {[i32]: Rec} = Map()
  m.set(1, { n: 10 })
  m.set(2, { n: 20 })
  m
}
function pick(n: i32): {[i32]: Rec} | null {
  if n > 0 { return mk() }
  return null
}
// @@VALUE@@
pick(1)
// @@TYPE@@
{[i32]: Rec} | null
// @@TEST@@
v is {[i32]: Rec}
// @@HIT@@
print(v.length)
print(v.has(1))
print((v.get(1) ?? { n: -1 }).n)
v.set(3, { n: 30 })
print(v.length)
v.delete(2)
print(v.has(2))
let c = 0
for kk in v { c = c + 1 }
print(c)
print((v[3] ?? { n: -1 }).n)
// @@MISS@@
print("miss")
// @@WANT@@
2 then true then 10 then 3 then false then 2 then 30
// @@VALUE2@@
pick(0)
// @@TYPE2@@
{[i32]: Rec} | null
// @@PROOF2@@
if v == null { print("none") } else { print(v.length) }
// @@WANT2@@
none
