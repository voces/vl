// A generic function delivered to each position, put in a list twice, one element written with a
// fixed-type `i32` function and the other called at `string`. A list's elements share one type,
// as `[__inc, id]` called at `string` refuses, so every position refuses by design (D9721).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function id<T>(x: T): T { x }
function __inc(x: i32): i32 { x + 1 }
// @@VALUE@@
id
// @@TYPE@@
(x: i32) => i32
// @@PROOF@@
const __xs = [v, v]
__xs[0] = __inc
print(__xs[0](2) * 10 + __xs[1]("abc").length)
// @@WANT@@
33
