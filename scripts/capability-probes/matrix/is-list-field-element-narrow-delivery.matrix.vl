// D4957 — a list FIELD narrowed by `o.xs is K[]` narrows its element reads only (ruling (c) on
// #3792): the annotated face delivers it as `K[]` and is refused by the checker with the D4928
// message, the un-annotated face delivers its declared `i32[]` and runs.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type K = 0 | 1
type O = { xs: i32[] }
// @@SETUP@@
const o: O = { xs: [0, 1] }
// @@GUARD@@
o.xs is K[]
// @@FALLBACK@@
[]
// @@VALUE@@
o.xs
// @@TYPE@@
K[]
// @@PROOF@@
print(v.length)
// @@WANT@@
2
