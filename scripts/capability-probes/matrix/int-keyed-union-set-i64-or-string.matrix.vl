// D2519 — an i64-keyed Set beside a `string`, narrowed by `is` and `match`.
// The proof reads, writes, deletes, counts and walks the map after narrowing, so a box that
// casts to the wrong map struct fails validation or prints wrong.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
function mk(): Set<i64> {
  const m: Set<i64> = Set()
  m.add(4294967296)
  m.add(4294967297)
  m
}
function pick(n: i32): Set<i64> | string {
  if n > 0 { return mk() }
  return "s"
}
// @@VALUE@@
pick(1)
// @@TYPE@@
Set<i64> | string
// @@TEST@@
v is Set<i64>
// @@HIT@@
print(v.length)
print(v.has(4294967296))
v.add(4294967298)
print(v.length)
v.delete(4294967297)
print(v.has(4294967297))
let c = 0
for kk in v { c = c + 1 }
print(c)
print(v.has(4294967298))
// @@MISS@@
print("miss")
// @@WANT@@
2 then true then 3 then false then 2 then true
// @@VALUE2@@
pick(0)
// @@TYPE2@@
Set<i64> | string
// @@PROOF2@@
match v {
  Set<i64> => print("map")
  string => print(v + "!")
}
// @@WANT2@@
s!
