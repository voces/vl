// D9750 — an un-annotated alias `al` of a union value `w`, read while `w` (not `al`) is
// narrowed by `is`. The narrowing belongs to the reads of `w`; `al` is still the union box,
// so every delivery of `al` must carry the box, and the proof re-tests it.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function pick(b: boolean): i32 | string {
  if b { return 1 }
  return "s"
}
const w = pick(true)
const al = w
// @@VALUE@@
al
// @@TYPE@@
i32 | string
// @@GUARD@@
w is i32
// @@FALLBACK@@
al
// @@PROOF@@
print(v)
// @@TEST@@
v is i32
// @@HIT@@
print(1)
// @@MISS@@
print(0)
// @@WANT@@
1
