// D1663 — the ref-list template's pair one field CODE apart: the value under test is a
// `A[] | null` holder (code 28) and the prelude holder is a plain `A[]` one (code 5), sharing
// the field name `xs`. The two slots are `(ref null $arr)` and `(ref $arr)`, so they are two
// layouts and the second holder needs a row of its own.
//
// The first holder lives in the PRELUDE, inside a function nothing calls: `collectAnonShapes`
// walks the whole arena, so its row is minted and available to collide with wherever the value
// under test is delivered. Removing it turns every cell green for the wrong reason.
//
// The ELEMENT is deliberately the SAME `A` on both sides. The ref-list sibling template varies
// the element and holds the code fixed; this one varies the code and holds the element fixed,
// so a close that keys only on the element cannot pass both.
//
// The two faces measure two different rows, and only the un-annotated one is D1663. The
// prelude holder is un-annotated, so the value's own un-annotated face meets an `#anon` row.
// Its ANNOTATED face gives the value a DECLARED row that the prelude holder then collides
// onto, which is D1674 and red at both seeds.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type A = { r: i32 }
function as1(): A[] { return [{ r: 7 }] }
function ns1(): A[] | null { return [{ r: 4 }] }
function ns2(): A[] | null { return [{ r: 5 }] }
function firstHolder() {
  const first = { xs: as1() }
  print(first.xs[0].r)
}
// @@VALUE@@
{ xs: ns1() }
// @@TYPE@@
{ xs: A[] | null }
// @@PROOF@@
const l = v.xs
if l != null { print(l[0].r) } else { print(0) }
// @@WANT@@
4
// @@VALUE2@@
{ xs: ns2() }
// @@TYPE2@@
{ xs: A[] | null }
// @@PROOF2@@
const l2 = v.xs
if l2 != null { print(l2[0].r) } else { print(0) }
// @@WANT2@@
5
// @@SKIP@@
is_in_if: the value is a struct, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
