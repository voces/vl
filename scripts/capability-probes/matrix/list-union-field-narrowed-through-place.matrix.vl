// D8261: a record whose field is a union of two lists, narrowed by `is string[]` on that field
// and read back through the same place. The `*_place` positions re-read it through an index
// (`xs[0].items`), a map value and a struct field, which is where the narrowing has to be keyed.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type A = { kind: "a", items: f64[] | string[] }
// @@VALUE@@
{ kind: "a", items: ["x", "yz"] }
// @@TYPE@@
A
// @@TEST@@
v.items is string[]
// @@HIT@@
print(v.items.length * 10 + v.items[1].length)
// @@MISS@@
print(0)
// @@WANT@@
22
