// A hole lambda handed through a GENERIC function's result, called only through that result.
//
// The generic twin of `hole-lambda-through-hole-fn-result.matrix.vl`: the same flow through
// `fw<F>(f: F): F`, whose type parameter the argument binds to the lambda's open signature.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function fw<F>(f: F): F { return f }
const lam = (x) => x
// @@VALUE@@
fw(lam)
// @@TYPE@@
(x: i32) => i32
// @@PROOF@@
print(v(3) + v(4))
// @@WANT@@
7
// @@VALUE2@@
fw(lam)
// @@TYPE2@@
(x: string) => string
// @@PROOF2@@
print(v("w"))
// @@WANT2@@
w
