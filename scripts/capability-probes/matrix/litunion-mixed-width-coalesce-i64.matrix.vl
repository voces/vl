// D3516 and D3523 — `x ?? 5` over a nullable literal union whose integer members span two widths
// joins `9000000000 | 1 | i32`; every member converts into `i64` exactly, so the join is delivered
// there at the member it holds. The un-annotated face keeps the join and converts at the proof's
// own `i64` binding.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type E = 9000000000 | 1 | null
function pick(n: i32): E {
  if n > 1 { return 9000000000 }
  if n > 0 { return 1 }
  null
}
// @@VALUE@@
pick(2) ?? 5
// @@TYPE@@
i64
// @@PROOF@@
const ww: i64 = v
print(ww + 1)
// @@WANT@@
9000000001
// @@VALUE2@@
pick(0) ?? 5
// @@TYPE2@@
i64
// @@PROOF2@@
const ww: i64 = v
print(ww + 1)
// @@WANT2@@
6
