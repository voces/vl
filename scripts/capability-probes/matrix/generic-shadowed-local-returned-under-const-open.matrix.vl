// The open twin of generic-shadowed-local-returned-under-const (D10165): the generic's type
// parameter is bound by inference from the argument, and VALUE2 is a bare hole parameter,
// so no annotation pins what the returned inner `x` is.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function __pick<T>(w: T) {
  const x = 7
  if true {
    let x = w
    return x
  }
  w
}
function __pickh(w) {
  const x = 7
  if true {
    let x = w
    return x
  }
  w
}
// @@VALUE@@
__pick({ a: 1, b: "r" })
// @@TYPE@@
{ a: i32, b: string }
// @@PROOF@@
print(v.b)
// @@TEST@@
v.a > 0
// @@HIT@@
print(v.b)
// @@MISS@@
print("miss")
// @@WANT@@
r
// @@VALUE2@@
__pickh("q")
// @@TYPE2@@
string
// @@PROOF2@@
print(v)
// @@WANT2@@
q
