// D4743/D4744/D4745 — `type A = i32[] | K[]`, the declared-alias spelling: both members spell
// `i32[]`, so the alias is one list rep at every position.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type K = 0 | 1
type A = i32[] | K[]
// @@VALUE@@
[1, 0, 1]
// @@TYPE@@
A
// @@TEST@@
v is i32[]
// @@HIT@@
print(v.length)
// @@MISS@@
print(-1)
// @@WANT@@
3
// @@VALUE2@@
[0, 1]
// @@TYPE2@@
A
// @@PROOF2@@
if v is i32[] { print(v[1]) } else { print(-1) }
// @@WANT2@@
1
