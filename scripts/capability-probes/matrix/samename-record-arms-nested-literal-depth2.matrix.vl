// D16939 — record arms stored alike that differ only in a literal set below the top level: the
// value's own row and its nested fields decide `is`, whichever arm the union names first.
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type A = { v: { w: { x: 1 | 2 } } }
type C = { v: { w: { x: 3 | 4 } } }
function pick(a: boolean): A | C {
  if a {
    const x: A = { v: { w: { x: 2 } } }
    return x
  }
  const c: C = { v: { w: { x: 3 } } }
  return c
}
// @@SETUP@@
const cval: C = { v: { w: { x: 3 } } }
// @@VALUE@@
cval
// @@TYPE@@
A | C
// @@TEST@@
v is A
// @@HIT@@
print("A")
// @@MISS@@
print("C")
// @@WANT@@
C
// @@VALUE2@@
pick(true)
// @@TYPE2@@
A | C
// @@PROOF2@@
if v is A { print("A") } else { print("C") }
// @@WANT2@@
A
