// A `let` bound to a call of a function returning one of two generic functions, called at two
// types, then written with another such call and called at both again; the value is delivered
// after the write at each position (D10192). Each write re-runs the call as the arm index.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function idg<T>(t: T): T { return t }
function kg<T>(t: T): T { return t + t }
function app<T>(g: (x: T) => T, v: T): T { return g(v) }
function pick(n: i32) {
  if n > 1 { return kg }
  return idg
}
let h = pick([1, 2].length)
const s0 = h("x")
const f0 = h(1.0)
h = pick([1].length)
const s = h("y") + s0
// @@VALUE@@
h(1.5) + f0
// @@TYPE@@
f64
// @@PROOF@@
if s == "yxx" { print(v * 2.0) } else { print(0.0) }
// @@WANT@@
7
// @@VALUE2@@
app(h, 2)
// @@TYPE2@@
i32
// @@PROOF2@@
print(v * s.length)
// @@WANT2@@
6
