// D5282 — `==` over a record that reaches itself through a list field (VALUE), and over a
// list of one (VALUE2), at every delivery position and in both faces. The PROOF compares
// against a twin that differs only two levels down, so a compare that stopped at the first
// level, or answered by reference, cannot print the wanted pair.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type N = { v: i32, kids: N[] }
const same: N = { v: 1, kids: [{ v: 2, kids: [{ v: 3, kids: [] }] }] }
const diff: N = { v: 1, kids: [{ v: 2, kids: [{ v: 4, kids: [] }] }] }
// @@VALUE@@
{ v: 1, kids: [{ v: 2, kids: [{ v: 3, kids: [] }] }] }
// @@TYPE@@
N
// @@FALLBACK@@
{ v: 0, kids: [] }
// @@TEST@@
v == same
// @@HIT@@
if v == diff { print("bad") } else { print("eq") }
// @@MISS@@
print("miss")
// @@WANT@@
eq
// @@VALUE2@@
[same, diff]
// @@TYPE2@@
N[]
// @@PROOF2@@
const r2 = v
print((r2 == [same, diff]) && !(r2 == [same, same]))
// @@WANT2@@
true
