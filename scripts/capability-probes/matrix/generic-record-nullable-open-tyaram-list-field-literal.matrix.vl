// D10881, generic twin: the record is built by a generic called from a second generic whose `U`
// stays open, and the literal leads with its `null` (`[null, x]`), so no element types the list.
// The second instance returns through an alias, `Box<U>`, at a `boolean` pin.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type Box<U> = { g: (U | null)[] }
function __mk<T>(x: T): Box<T> { { g: [null, x] } }
function __outer<U>(x: U): Box<U> { __mk(x) }
function __tb(x: boolean | null): string {
  if x == null { return "N" }
  if x { return "T" }
  "F"
}
// @@VALUE@@
__outer("s")
// @@TYPE@@
Box<string>
// @@PROOF@@
print((v.g[0] ?? "nil") + (v.g[1] ?? "nil"))
// @@WANT@@
nils
// @@VALUE2@@
__outer(true)
// @@TYPE2@@
Box<boolean>
// @@PROOF2@@
print(__tb(v.g[0]) + __tb(v.g[1]))
// @@WANT2@@
NT
// @@SKIP@@
is_in_if: the value is a record, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
