// D5171: a copy of a written function binding is itself called at `string` and at a literal
// union, so the copy holds one instance per call type. Every type parameter stays open; the
// annotated face annotates only the destination.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type __S = "p" | "q"
function __gA<U>(u: U) {
  print(u)
}
function __gB<V>(v: V) {
  print(v)
}
const __qa: __S = "q"
// @@SETUP@@
let __x = __gA
__x = __gB
let __y = __x
__y("r")
__y(__qa)
// @@VALUE@@
__y
// @@TYPE@@
(s: __S) => void
// @@PROOF@@
v(__qa)
// @@WANT@@
q
