// A list-literal spread whose source's element widens (`i32` to `f64`), at every position
// the literal can be delivered to, in both faces. The trailing `2.5` types the literal
// `f64[]` in the un-annotated face too, so the widening copy is owed in both.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
const src: i32[] = [3, 4]
// @@VALUE@@
[...src, 2.5]
// @@TYPE@@
f64[]
// @@PROOF@@
print(v[0] / 2.0 + v[2] + v.length)
// @@WANT@@
7
// @@SKIP@@
is_in_if: the value is a list, not a union — there is no arm to test it against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
