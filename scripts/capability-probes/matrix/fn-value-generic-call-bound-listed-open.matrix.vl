// a `const` alias, each at TWO types (D9593, D9594).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function id<T>(x: T): T { x }
function __mk() { return id }
// @@VALUE@@
id
// @@TYPE@@
(x: i32) => i32
// @@PROOF@@
const __c = __mk()
const __w = __c
const __xs = [__c]
const __s = __xs[0]("abc")
print(__s.length + __xs[0](2) + __c(1) + __w("ab").length + __w(4) + v(2))
