// Empty lists a hole template allocates and hands to callbacks of other element types: holder x
// element type x instance count (1, 2, 3, one instance writing nothing). A list the template owns is
// fresh per call; a module-level one, one nested in a record, or one relayed to a second hole stays
// shared and refuses (D16603).
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function w_i32(b: i32[]) {
  b.push(7)
  print(b[0])
  return b.length
}
function r_i32(b: i32[]) { return b.length }
function w_f64(b: f64[]) {
  b.push(1.5)
  print(b[0])
  return b.length
}
function r_f64(b: f64[]) { return b.length }
function w_str(b: string[]) {
  b.push("s")
  print(b[0])
  return b.length
}
function r_str(b: string[]) { return b.length }
function w_rec(b: { x: i32 }[]) {
  b.push({ x: 4 })
  print(b[0].x)
  return b.length
}
function r_rec(b: { x: i32 }[]) { return b.length }
function w_bool(b: boolean[]) {
  b.push(true)
  print(b[0])
  return b.length
}
function r_bool(b: boolean[]) { return b.length }
// @@VALUE@@
[1.5]
// @@TYPE@@
f64[]
// @@PROOF@@
print(v[0])
// @@WANT@@
1.5
// @@CELL_const_one@@
// want: s then 1
function mk(h) {
  const a = []
  return h(a)
}
print(mk(w_str))
// @@CELL_const_one_reads@@
// want: 0
function mk(h) {
  const a = []
  return h(a)
}
print(mk(r_f64))
// @@CELL_const_two_same@@
// want: 7 then 1 then 7 then 1
function mk(h) {
  const a = []
  return h(a)
}
print(mk(w_i32))
print(mk(w_i32))
// @@CELL_const_two_f64_str@@
// want: 1.5 then 1 then s then 1
function mk(h) {
  const a = []
  return h(a)
}
print(mk(w_f64))
print(mk(w_str))
// @@CELL_const_two_rec_bool@@
// want: 4 then 1 then true then 1
function mk(h) {
  const a = []
  return h(a)
}
print(mk(w_rec))
print(mk(w_bool))
// @@CELL_const_three@@
// want: 7 then 1 then s then 1 then 1.5 then 1
function mk(h) {
  const a = []
  return h(a)
}
print(mk(w_i32))
print(mk(w_str))
print(mk(w_f64))
// @@CELL_const_three_mid_reads@@
// want: s then 1 then 0 then true then 1
function mk(h) {
  const a = []
  return h(a)
}
print(mk(w_str))
print(mk(r_rec))
print(mk(w_bool))
// @@CELL_const_three_first_reads@@
// want: 0 then 7 then 1 then s then 1
function mk(h) {
  const a = []
  return h(a)
}
print(mk(r_f64))
print(mk(w_i32))
print(mk(w_str))
// @@CELL_let_one@@
// want: s then 1
function mk(h) {
  let a = []
  return h(a)
}
print(mk(w_str))
// @@CELL_let_one_reads@@
// want: 0
function mk(h) {
  let a = []
  return h(a)
}
print(mk(r_f64))
// @@CELL_let_two_same@@
// want: 7 then 1 then 7 then 1
function mk(h) {
  let a = []
  return h(a)
}
print(mk(w_i32))
print(mk(w_i32))
// @@CELL_let_two_f64_str@@
// want: 1.5 then 1 then s then 1
function mk(h) {
  let a = []
  return h(a)
}
print(mk(w_f64))
print(mk(w_str))
// @@CELL_let_two_rec_bool@@
// want: 4 then 1 then true then 1
function mk(h) {
  let a = []
  return h(a)
}
print(mk(w_rec))
print(mk(w_bool))
// @@CELL_let_three@@
// want: 7 then 1 then s then 1 then 1.5 then 1
function mk(h) {
  let a = []
  return h(a)
}
print(mk(w_i32))
print(mk(w_str))
print(mk(w_f64))
// @@CELL_let_three_mid_reads@@
// want: s then 1 then 0 then true then 1
function mk(h) {
  let a = []
  return h(a)
}
print(mk(w_str))
print(mk(r_rec))
print(mk(w_bool))
// @@CELL_let_three_first_reads@@
// want: 0 then 7 then 1 then s then 1
function mk(h) {
  let a = []
  return h(a)
}
print(mk(r_f64))
print(mk(w_i32))
print(mk(w_str))
// @@CELL_direct_one@@
// want: s then 1
function mk(h) { return h([]) }
print(mk(w_str))
// @@CELL_direct_one_reads@@
// want: 0
function mk(h) { return h([]) }
print(mk(r_f64))
// @@CELL_direct_two_same@@
// want: 7 then 1 then 7 then 1
function mk(h) { return h([]) }
print(mk(w_i32))
print(mk(w_i32))
// @@CELL_direct_two_f64_str@@
// want: 1.5 then 1 then s then 1
function mk(h) { return h([]) }
print(mk(w_f64))
print(mk(w_str))
// @@CELL_direct_two_rec_bool@@
// want: 4 then 1 then true then 1
function mk(h) { return h([]) }
print(mk(w_rec))
print(mk(w_bool))
// @@CELL_direct_three@@
// want: 7 then 1 then s then 1 then 1.5 then 1
function mk(h) { return h([]) }
print(mk(w_i32))
print(mk(w_str))
print(mk(w_f64))
// @@CELL_direct_three_mid_reads@@
// want: s then 1 then 0 then true then 1
function mk(h) { return h([]) }
print(mk(w_str))
print(mk(r_rec))
print(mk(w_bool))
// @@CELL_direct_three_first_reads@@
// want: 0 then 7 then 1 then s then 1
function mk(h) { return h([]) }
print(mk(r_f64))
print(mk(w_i32))
