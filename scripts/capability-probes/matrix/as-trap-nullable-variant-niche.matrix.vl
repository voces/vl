// D1812 — `x as! Circle` over a niche-repped `Circle | null`, the union-VARIANT rep. The
// variant cell already has a rep classifier that reads a cast node, so this template is the
// control that says the struct arm's residue is about a STANDALONE struct.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
type Circle = { kind: "circle", r: i32 }
type Rect = { kind: "rect", w: i32 }
type Shape = Circle | Rect
function s1(): Circle | null { return { kind: "circle", r: 7 } }
function s2(): Circle | null { return { kind: "circle", r: 9 } }
function widen(c: Circle): Shape { return c }
// @@VALUE@@
s1() as! Circle
// @@TYPE@@
Circle
// @@PROOF@@
print(v.r)
// @@WANT@@
7
// @@VALUE2@@
s2() as! Circle
// @@TYPE2@@
Circle
// @@PROOF2@@
print(v.r)
// @@WANT2@@
9
// @@SKIP@@
is_in_if: the value is one variant, not the union — there is no second arm to test against
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
early_return_guard: same
