// A record whose function field holds un-annotated functions returning different types, joined by
// an `if`, handed to an un-annotated parameter whose callee binds it to a `let` it then writes
// with its own record literal (D16137): the literal's functions are ids of the parameter's set,
// decided after the caller hands it in. The built-in positions are
// `record-fn-field-two-results.matrix.vl`'s; the cells are the callee's own. No annotation spells
// the joined value's type, so both faces grade the same un-annotated program.
// @@PRELUDE@@
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function two() { [1, 2].length }
// @@VALUE@@
if two() < 5 { { f: inc0 } } else { { f: half } }
// @@TYPE@@
{ f: (a: i32) => f64 }
// @@PROOF@@
print(v.f(3))
// @@WANT@@
4
// @@SKIP@@
binding: the built-in positions are record-fn-field-two-results.matrix.vl's
return_inferred: same
return_annotated: same
argument: same
struct_field_init: same
struct_field_assign: same
array_element: same
array_element_assign: same
array_push: same
local_assign: same
global_init: same
global_assign: same
map_value: same
map_set: same
closure_capture: same
block_if: same
block_if_capture: same
block_while: same
block_while_capture: same
block_bare: same
block_bare_capture: same
fn_body: same
fn_body_capture: same
is_in_if: same
is_in_while: same
is_in_and: same
is_in_not: same
else_if: same
array_element_place: same
map_value_place: same
struct_field_place: same
early_return_guard: same
two_instances: same
// @@CELL_written_after_read@@
// want: 4 then 2
function take(a) {
  let v = a
  print(v.f(3))
  v = { f: half }
  print(v.f(4))
}
take(__V__)
// @@CELL_bound_arg@@
// want: 4 then 2
function take(a) {
  let v = a
  print(v.f(3))
  v = { f: half }
  print(v.f(4))
}
const r = __V__
take(r)
// @@CELL_written_before_read@@
// want: 2
function take(a) {
  let v = a
  v = { f: half }
  print(v.f(4))
}
const r = __V__
take(r)
// @@CELL_written_in_if@@
// want: 4 then 2
function take(a) {
  let v = a
  print(v.f(3))
  if two() > 1 { v = { f: half } }
  print(v.f(4))
}
const r = __V__
take(r)
// @@CELL_written_other_member@@
// want: 4 then 5
function take(a) {
  let v = a
  print(v.f(3))
  v = { f: inc0 }
  print(v.f(4))
}
const r = __V__
take(r)
// @@CELL_written_twice@@
// want: 4 then 2 then 5
function take(a) {
  let v = a
  print(v.f(3))
  v = { f: half }
  print(v.f(4))
  v = { f: inc0 }
  print(v.f(4))
}
const r = __V__
take(r)
// @@CELL_written_returned@@
// want: 2
function take(a) {
  let v = a
  v = { f: half }
  return v.f(4)
}
const r = __V__
print(take(r))
// @@CELL_two_calls_one_set@@
// want: 4 then 2 then 4 then 2
function take(a) {
  let v = a
  print(v.f(3))
  v = { f: half }
  print(v.f(4))
}
const r = __V__
const q = __V__
take(r)
take(q)
// @@CELL_two_sets_disagree@@
// want: 4 then 2 then 6 then 2
function dbl(a) { return a * 2 }
function take(a) {
  let v = a
  print(v.f(3))
  v = { f: half }
  print(v.f(4))
}
const r = __V__
const q = if two() < 5 { { f: dbl } } else { { f: half } }
take(r)
take(q)
// @@CELL_written_outside_set@@
// want: 4 then 8
function dbl(a) { return a * 2 }
function take(a) {
  let v = a
  print(v.f(3))
  v = { f: dbl }
  print(v.f(4))
}
const r = __V__
take(r)
// @@CELL_read_only_let@@
function take(a) {
  let v = a
  print(v.f(3))
}
const r = __V__
take(r)
// @@CELL_read_only_const@@
function take(a) {
