// D5471 — a map whose only value is an index-stored bare `[]`, at every delivery position and in
// both faces. The un-annotated face left the list's element unbound, so the map had no value rep;
// the TEST reads the stored list back, so a map that lost its entry cannot take the HIT.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
const src = Map()
src["k"] = []
// @@VALUE@@
src
// @@TYPE@@
Map<string, i32[]>
// @@TEST@@
v.length == 1 && v["k"] != null
// @@HIT@@
print(v.length)
// @@MISS@@
print("miss")
// @@WANT@@
1
