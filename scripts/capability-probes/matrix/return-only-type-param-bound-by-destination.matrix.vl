// A generic call whose type parameter only the result names: the destination binds it (D9073,
// the return-only face of D16410). The un-annotated face has no destination, so the call stays
// refused there. Cells: a nullable result, an extra parameter the argument binds, a UFCS call,
// an explicit type argument, and a callback position, which stays refused.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function mk<T>(): T[] { [] }
// @@VALUE@@
mk()
// @@TYPE@@
string[]
// @@PROOF@@
v.push("q")
print(v.length)
print(v[0])
// @@WANT@@
1 then q
// @@CELL_nullable@@
// want: true
function z<T>(): T | null { null }
const k: string | null = z()
print(k == null)
// @@CELL_extra_param@@
// want: 0
function cnst<T, U>(_t: T): U[] { return [] }
const k: i64[] = cnst(3)
print(k.length)
// @@CELL_ufcs@@
// want: 0
function mcnst<T, U>(self: T): U[] { return [] }
const k: f64[] = 3.mcnst()
print(k.length)
// @@CELL_explicit@@
// want: 0
const k: string[] = mk<string>()
print(k.length)
// @@CELL_callback@@
// owed: cannot infer
function cnst2<T, U>(_t: T): U[] { return [] }
const k: i64[][] = [3].map(cnst2)
print(k.length)
