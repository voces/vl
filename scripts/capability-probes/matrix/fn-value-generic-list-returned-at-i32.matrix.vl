// A list of a generic pushed a fixed-type `i32` function, handed back by an un-annotated function
// and delivered from that call to each position where its element is `(i32) => i32`: every
// element fits, so every position runs. The twin of
// `fn-value-generic-list-returned-at-string-refused.matrix.vl`, which must refuse (D10121).
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function id<T>(x: T): T { x }
function __inc(x: i32): i32 { x + 1 }
const __ys = [id]
__ys.push(__inc)
function __deliver() { return __ys }
// @@VALUE@@
__deliver()
// @@TYPE@@
((x: i32) => i32)[]
// @@PROOF@@
print(v[1](2))
// @@WANT@@
3
