// D5890 — the nullable twin of `mixed-litunion-type-member-match`: `"a" | i32 | null`, delivered
// to every position and discriminated by a `match` whose literal arm comes before its `null`
// arm. The failed literal test takes `"a"` out of the box, so the type arm reads the `i32` once
// `null` is ruled out, and a position that delivered the wrong box takes the wrong arm.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
function pick(n: i32): "a" | i32 | null {
  if n > 1 { return n * 10 }
  if n < 0 { return null }
  "a"
}
function name(c: "a" | i32 | null): string {
  match c {
    "a" => "A"
    null => "Z"
    i32 => if c + 1 == 31 { "N30" } else { "N?" }
  }
}
// @@VALUE@@
pick(3)
// @@TYPE@@
"a" | i32 | null
// @@TEST@@
v != null
// @@HIT@@
print(name(v))
// @@MISS@@
print("miss")
// @@WANT@@
N30
// @@VALUE2@@
pick(0)
// @@TYPE2@@
"a" | i32 | null
// @@PROOF2@@
print("c=" + name(v))
// @@WANT2@@
c=A
