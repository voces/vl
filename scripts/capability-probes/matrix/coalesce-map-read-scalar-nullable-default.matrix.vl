// D2248 — `a ?? b` where both operands are `i32 | null` map reads. The scalar's nullable rep is
// the value box, which the fused get-with-default never builds; a re-readable read lowers
// through the null test instead.
//
// The first instance misses on the left and hits on the right, so the value printed can only
// come from the default.
//
// Format: scripts/capability-probes/matrix.py, whose docstring is the spec.
// @@PRELUDE@@
const nums: {[string]: i32} = Map()
const more: {[string]: i32} = Map()
more["k"] = 9
// @@VALUE@@
nums["k"] ?? more["k"]
// @@TYPE@@
i32 | null
// @@FALLBACK@@
null
// @@TEST@@
v != null
// @@HIT@@
print(v)
// @@MISS@@
print("none")
// @@WANT@@
9
// @@VALUE2@@
nums["z"] ?? more["z"]
// @@TYPE2@@
i32 | null
// @@PROOF2@@
if v != null { print(v) } else { print("none") }
// @@WANT2@@
none
