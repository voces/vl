// D16038: a record union `==` whose operands differ only by `| null` is one box compare, `null`
// one more tag of it. The value under test is a `P | Q | null` holding `P` with `x` 1, delivered
// to every position and compared there with a `P | Q` holding an equal `P`. The cells cover the
// other operand order, `!=`, a `null` value, three members and records nested one level.
//
// Format: scripts/capability-probes/README.md, "Template format".
// @@PRELUDE@@
type P = { x: i32 }
type Q = { y: i32 }
type In = { v: i32 }
type A = { a: In }
type B = { b: In }
type C = { c: In }
const pp: P = { x: 1 }
const wpq: P | Q = pp
function mk(n: i32): P | Q | null {
  if n < 0 { return null }
  const p: P = { x: n }
  return p
}
// @@VALUE@@
mk(1)
// @@TYPE@@
P | Q | null
// @@WANT@@
true
// @@PROOF@@
print(v == wpq)
// @@VALUE2@@
mk(2)
// @@TYPE2@@
P | Q | null
// @@PROOF2@@
print(v == wpq)
// @@WANT2@@
false
// @@CELL_other_order@@
const u__A__ = __V__
print(wpq == u)
// @@CELL_not_equal@@
// want: false
const u__A__ = __V__
print(u != wpq)
// @@CELL_null_value@@
// want: false
const u: P | Q | null = mk(-1)
print(u == wpq)
// @@CELL_null_value_not_equal@@
const u: P | Q | null = mk(-1)
print(wpq != u)
// @@CELL_other_arm@@
// want: false
const q: Q = { y: 1 }
const wq: P | Q = q
const u__A__ = __V__
print(u == wq)
// @@CELL_three_members@@
function m3(n: i32): P | Q | B | null {
  if n < 0 { return null }
  const p: P = { x: n }
  return p
}
const t: P | Q | B = pp
const u = m3(1)
print(u == t)
// @@CELL_nested_records@@
function mn(n: i32): A | B | C | null {
  if n < 0 { return null }
  const r: A = { a: { v: n } }
  return r
}
const ra: A = { a: { v: 1 } }
const t: A | B | C = ra
const u = mn(1)
print(t == u)
// @@CELL_nested_records_differ@@
// want: false
function mn(n: i32): A | B | null {
  if n < 0 { return null }
  const r: A = { a: { v: n } }
  return r
}
const ra: A = { a: { v: 1 } }
const t: A | B = ra
const u = mn(2)
print(u == t)
