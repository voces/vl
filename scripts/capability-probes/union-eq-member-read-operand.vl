// `==` between a union box and a concrete variant reached through a struct FIELD READ.
//
//   emitProgram: `==` over a struct union is not supported yet
//
// `vl check` returns 0, so this is a clause-2 violation by construction. silent-class
// inventory D1097.
//
// THE OPERAND'S DELIVERY, NOT THE COMPARE, IS THE GAP. The same compare against a global,
// a local, a parameter, a call result or a struct-field read of the BOX all run; only a
// concrete variant delivered by reading a FIELD (or bound from one) refuses, because
// `exprVariantIndex` resolves a variant row for an ident, an `as`, a call and a global
// and has no leg for a Member.
//
// It is the operand-side face of a wider gap: with a union declared, the union path owns
// the struct `type`s, and `h.a == c` between two CONCRETE values of the same shape already
// refuses with `struct equality is not supported yet`. Closing that reader closes both.
//
// Should print true then false.
type A = { x: i32 }
type H = { a: A }

function mk(n: i32): A | i32 {
  if n == 0 { return 5 }
  { x: n }
}

const p = mk(1)
const h: H = { a: { x: 1 } }
const g: H = { a: { x: 2 } }
print(p == h.a)
print(p == g.a)
