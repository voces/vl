// `==` over a union whose arm is a CLOSURE.
//
//   emitProgram: `==` over a union's closure arm is not supported yet
//   emitProgram: union `==` atom has no value box            (the union-vs-union spelling)
//
// `vl check` returns 0, so this is a clause-2 violation by construction. silent-class
// inventory D1098.
//
// A CLOSURE ARM RIDES THE BOX'S `value` FIELD DIRECTLY, as its fat-pointer struct — the
// same shape a string and a list arm ride, both of which now compare. What it lacks is not
// an unbox (`emitUnionUnboxTail` recovers it for a narrowed read) but a COMPARE: two
// closures are equal by function identity, which is a separate lowering with its own scan
// (`cloEqNoteBin`), and the union arm ladder has no route into it.
//
// Should print true then false.
function seven(): i32 { 7 }

function mk(n: i32): (() => i32) | i32 {
  if n == 0 { return 5 }
  seven
}

const p = mk(1)
print(p == seven)
const q = mk(0)
print(q == seven)
