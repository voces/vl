// A union whose arm is a closure, compared by function identity once narrowed to that arm.
// `==` over the union is refused by design (DECISIONS A15, data-only `==`; pinned by
// `tests/cases/operators/error-eq-function-positions.vl`), so the probe takes the spelling A15
// leaves legal: `is` narrows, then `===` compares through the closure-arm unbox (D1098).
//
// Should print true then false then false.
function seven(): i32 { 7 }
function eight(): i32 { 8 }

function mk(n: i32): (() => i32) | i32 {
  if n == 0 { return 5 }
  if n == 1 { return eight }
  seven
}

const p = mk(2)
if p is () => i32 { print(p === seven) }
const q = mk(1)
if q is () => i32 { print(q === seven) }
const r = mk(0)
print(r is () => i32)
