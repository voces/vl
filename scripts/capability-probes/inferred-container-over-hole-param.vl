// An INFERRED container whose element or field is a closure delivered as an un-annotated
// parameter. `vl check` returns 0 and the emitter refuses at four different sentences, one
// per read shape, because the container's element and field kinds are classified from the
// initializer and the checker leaves the parameter the inference hole.
//
// The parameter annotated `a: (i32) => i32` runs, so does the binding annotated
// `const xs: ((i32) => i32)[] = [a]`, and so does a list of a lambda LITERAL. See D1664.
// Should print 55 then 55 then 55 then 55.
function tail(a) {
  const xs = [a]
  const run = (m: i32) => xs[0](m)
  print(run(54))
}
function expr(a) {
  const xs = [a]
  print(xs[0](54))
}
function rebound(a) {
  const xs = [a]
  const f = xs[0]
  print(f(54))
}
function field(a) {
  const s = { f: a }
  print(s.f(54))
}
tail((n: i32) => n + 1)
expr((n: i32) => n + 1)
rebound((n: i32) => n + 1)
field((n: i32) => n + 1)
