// An UN-ANNOTATED function whose returns join to a nullable CONTAINER. The checker agrees the
// inference is right — it names the inferred type in its own refusal — and then floors:
// `'pick' infers the nullable return type {[string]: i32} | null — type-valid, but an inferred
// return of this shape is not yet supported by codegen; annotate the return type`.
// Should print 7.
//
// THE ANNOTATED TWIN RUNS, which is what makes this a capability gap and not a design rule:
// adding `: {[string]: i32} | null` to `pick` compiles and prints 7. So does the list twin,
// `i64[] | null` (the inferred form of that one refuses with the same literal — one gap, two
// inner shapes; this file is the smaller of the two).
//
// WHAT ALREADY LIFTED, and why the residue is exactly this. D887 lifted the same floor for a
// nullable STRUCT (`{r: i32} | null`, declared inner or inline shape) by recording the row
// `nullableRetName` renders and giving the A20 pass and `emitReturnValue` the arms the
// annotated path already had. `nullableRetName` has no map arm and no distinct-backing scalar
// list arm, so those two inners record nothing and still floor. Closing this needs the renderer
// to name them AND the two consumers to key their slot — the same three-site shape D887 was.
function pick(c: boolean) {
  if c { return null }
  const m: {[string]: i32} = Map()
  m["k"] = 7
  m
}
const r = pick(false)
if r != null { print((r)["k"]) } else { print(0) }
