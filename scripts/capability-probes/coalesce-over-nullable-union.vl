// `??` over a nullable value the emitter cannot narrow: `string | i32 | null`. The checker
// accepts it (the `??` types fine and the default is assignable), and the emitter refuses —
// `emitProgram: `??` over this nullable value is not supported yet`. A clause-2 violation by
// construction: `vl check` returned 0 to reach the emitter.
// Found 2026-09-01 auditing `goal-scoreboard.py`'s CONCEDES phrase list, which had been
// missing every "not supported YET" literal — the other word order — and so reported half the
// population. See D958.
// Should print s.
function mk(b: boolean): string | i32 | null {
  if b { return "s" }
  null
}

const v = mk(true) ?? "d"

print(v)
