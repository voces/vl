// A NULLABLE REF value in an INFERRED struct field. `vl check` returns 0 and the emitter
// refuses with `emitProgram: ref valtype with no interned shape` — the field needs an
// interned wrapper shape and the inferred-field path mints none, so `fbValtype`'s bounds
// guard turns the missing slot into a refusal rather than a trap.
//
// Not closure-specific: a nullable string, struct or list field refuses identically, while a
// nullable `i32` field runs because its niche is the `-1` sentinel and needs no shape. The
// annotated field runs at every rep, a non-nullable closure field runs, a closure literal in
// an inferred field runs, and the same value bound as a local runs — so the ingredients are
// the field being INFERRED and its value being a nullable REF. Inside a function the same
// program reaches a different floor (`object literal but no struct type declared`).
// See D1627. Should print 55.
function mk(): ((i32) => i32) | null { return (n: i32) => n + 1 }
const w = { f: mk() }
const v = w.f
if v != null { print(v(54)) }
