// D1372 — an UN-ANNOTATED array literal whose ELEMENT is a BOXED nullable scalar
// (`i32 | null`). `vl check` returns 0 and the engine refuses the module: `i32` has no null
// representation, so the element is a union BOX rather than a niche, and
// `arrLitNulRefElemName` refuses a kind-2 element outright — the literal falls to the default
// i32 list with a `(ref $box)` stored into it (`expected i32, found (ref $type)`).
//
// The annotated `const xs: (i32 | null)[] = [f(0)]` spelling runs: `refArrShapeKind` answers 2
// through `parenUnionArrElemName`, whose `isValueUnionName` gate the niche rungs do not share,
// and the ANNOTATION walk interns the union-box element slot. The inferred literal has no
// annotation to walk, and the element has to be REGISTERED (`registerInlineUnion`) before a
// slot can key on it — which is why a seventh niche rung cannot reach this and D1340's close
// left it standing.
// Should print 1.
function f(n: i32): i32 | null {
  if n == 0 { return 5 }
  return null
}

const xs = [f(0)]
print(xs.length)
