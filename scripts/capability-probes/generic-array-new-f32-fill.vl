// `__array_new__` with an f32 FILL inside a generic, delivered from the instance. `vl check`
// returns 0 and the emitter refused with `emitProgram: __array_new__ fill names no element
// rep, and its destination names none either` — clause 2. Inside a monomorphized body the
// fill is a PARAMETER, so only the substituted annotation names its rep, and
// `arrNewKindOfElemVKind` excluded `f32` by hand. The i64 pin is the control (D1669).
// Should print 7.75.
function pick<T>(v: T): T[] {
  const out = __array_new__(2, v)
  return out
}
function small(): f32 { 7.5 }
const xs = pick(small())
print(xs[1] + 0.25)
