// A map of two un-annotated functions bound at an annotated map of a closed function type, one of
// the functions also stored in a second map nothing reads. `vl check` returns 0 and emit refuses:
// `monoPinMapValues: the map's stored functions close at another type than its slot fact`.
// Reading the second map, or leaving the shared function out of the first, runs. See D15754.
// Should print 4.
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const fnMap = Map()
fnMap.set("a", inc0)
fnMap.set("b", half)
const m2 = Map()
m2.set("a", half)
const v: { [string]: (a: f64) => f64 } = fnMap
const g = v.get("a")
if g != null { print(g(3)) }
