// `.get(i)` over a `u8[]` — the checked read whose absence the type already spells.
//
// silent-class inventory D1281. Since D1211 the checker answers `i32 | null` for this call,
// the same type `b.pop()` gets, and `b.pop()` runs at every delivery — so the type is not the
// gap. `emitListGet` refuses any receiver `structListPopGetElem` does not claim, and the call
// then falls out of `emitCallNode`'s member ladder into `emitCall`, whose sentence names
// neither `get` nor `u8` nor lists: `emitProgram: callee is not a function name`.
//
// The same shape D1141 fixed for `.slice`, one member over — a member lowering whose receiver
// ladder has rungs for every list rep except the packed one.
//
// Should print 200 then null

const b: u8[] = [200, 255]
print(b.get(0))
print(b.get(7))
