// A hole parameter copied into a `const`, read by a function nested in its owner, called there and
// handed through a one-element list to a function that calls it at two types, its owner called
// with two generics.
// `vl check` returns 0 and the emitter refuses the argument: `emitProgram: a generic function taken
// as a value reaches no call that fixes its type — annotate the destination's function type`
// (D14843 ran once the copy was only handed on). Should print 3, 4, 30, 2, 3.75, 200.
function add(a, b) { return a + b }
function mul(a, b) { return a * b }
function apply2(g) {
  print(g(1, 2))
  print(g(1.5, 2.5))
}
function run(h) {
  const hh = h
  function inner() {
    for f in [apply2] { f(hh) }
    print(hh(10, 20))
  }
  inner()
}
run(add)
run(mul)
