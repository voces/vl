// A read of a map whose values are built wider, and a list of such records, handed on at their
// own types to a parameter and to a list parameter. The refusal "is type-valid but not
// supported yet: field `" names this shape; the plainest programs it forbids run.
// Should print 4 then 1.
type J = { f: i32 | null }
function mk() { return { f: 4 } }
const m = Map()
m.set("a", mk())
const wm: {[string]: J} = Map()
wm.set("a", mk())
function take(r: {f: i32}) { return r.f }
const v = m.get("a")
if v != null { print(take(v)) }
const xs = [mk()]
const wl: J[] = [mk()]
function count(ys: {f: i32}[]) { return ys.length }
print(count(xs))
