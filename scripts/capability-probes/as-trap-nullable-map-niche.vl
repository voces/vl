// `x as! M` over a niche-repped `M | null` where `M` is a MAP. `vl check` returns 0 and the
// emitter refuses: `emitProgram: `as {[string]:i32}` over a `{[string]:i32} | null` is
// lowered for a string, a list, a struct and a union variant` — a map or closure cell has no
// rep classifier that reads a cast node, so admitting it would make the un-annotated face
// invalid wasm. Clause 2 (D1812).
// Should print 7.
function mk(): {[string]: i32} | null {
  const m: {[string]: i32} = Map()
  m["a"] = 7
  m
}
const v = mk() as! {[string]:i32}
print(v["a"] ?? 0)
