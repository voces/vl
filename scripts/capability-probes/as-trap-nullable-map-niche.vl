// `x as! M` over a niche-repped `M | null` where `M` is a MAP: the trap is `ref.as_non_null`, and
// every delivery position reads the cast node's map type (D1812).
// Should print 7.
function mk(): {[string]: i32} | null {
  const m: {[string]: i32} = Map()
  m["a"] = 7
  m
}
const v = mk() as! {[string]:i32}
print(v["a"] ?? 0)
