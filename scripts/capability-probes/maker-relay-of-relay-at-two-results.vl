// A relay of a relay of a maker's hole lambda, delivered at two function types whose results differ. See D16790.
// Should print 4 then 0.5.
function deliver() { return (a) => a + 1 }
function relay() { return deliver() }
function outer() { return relay() }
const v: (a: i32) => i32 = outer()
const w: (a: i32) => f64 = outer()
print(v(3))
print(w(3) / 8.0)
