// A captured `for-in` LOOP VARIABLE whose element type is not i32.
//
// silent-class inventory D1142.
//
//   for z in ["a", "b"] { const f = () => z }  -> check rc 0, then:
//     type mismatch: expected i32, found (ref $type)
//   for z in [1.5, 2.5] { const f = () => z }  -> expected i32, found f64
//
// NO SHADOWING OF ANY KIND — nothing else in the module is named `z`, which is what separates
// this from D1130. The env field for the captured loop variable is typed i32 whatever the
// iterated element is: `parentBindingOf` answers with a `Param` or a `LetDecl` and has no answer
// for a `ForRange`/`ForIn`, so the valtype falls to the i32 default.
//
// The `let` CONTROL is what makes it a loop-variable row: a captured `const z = "a"` runs and
// prints `a`, and a captured `const z = 1.5` runs and prints `1.5`. And the i32 loop variable is
// why it hid — `for q in 1 to 3 { () => q }` is i32, the default is right, and that is every
// `for-in` capture the corpus contains.
//
// Should print: ab 4

function strs(): string {
  let s = ""
  for z in ["a", "b"] {
    const f = () => z
    s = s + f()
  }
  s
}

print(strs())

function floats(): f64 {
  let s = 0.0
  for z in [1.5, 2.5] {
    const f = () => z
    s = s + f()
  }
  s
}

print(floats())
