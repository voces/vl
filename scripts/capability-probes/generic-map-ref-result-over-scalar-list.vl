// A `.map` with a REF-returning callback over a scalar list, inside a GENERIC whose return
// type hides the result. `vl check` returns 0 and the emitter refuses with `emitProgram:
// `.length` receiver's ref-list element does not resolve` — clause 2. At collect time the
// result element is still a type variable, so no ref-list row is interned for the result,
// while the emitter's per-instance classifier resolves it to a ref list. The i32 control
// (`mk(n: i32): i32`) runs.
// Should print 1.
type C = { r: i32 }
function mk(n: i32): C { { r: n } }
function cnt<T>(xs: i32[], m: (i32) => T): i32 { return xs.map(m).length }
const zs: i32[] = [1]
print(cnt(zs, mk))
