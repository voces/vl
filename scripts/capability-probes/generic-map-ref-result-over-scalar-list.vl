// A `.map` with a REF-returning callback over a scalar list, inside a GENERIC whose return
// type hides the result. `vl check` returns 0 and the emitter refuses with `emitProgram:
// .filter result is a ref list but ref list type not collected` — clause 2. At collect time
// the result element is still a type variable so `rlUsed` is never set, while the emitter's
// per-instance classifier resolves the result to a ref list. The i32 control (`mk(n: i32):
// i32`) runs. The sentence names `.filter`, which cannot reach this site — `.filter`
// preserves the rep, so its receiver-side guard fires first.
// Should print 1.
type C = { r: i32 }
function mk(n: i32): C { { r: n } }
function cnt<T>(xs: i32[], m: (i32) => T): i32 { return xs.map(m).length }
const zs: i32[] = [1]
print(cnt(zs, mk))
