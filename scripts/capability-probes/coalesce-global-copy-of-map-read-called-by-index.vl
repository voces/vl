// A `??` over a global copy of a map read of a list of an un-annotated function, an element of
// the joined list called by index at module scope (D17057, D17058). `vl check` returns 0 and the
// emitter refused it: `emitProgram: a function-value call has no interned signature`.
// Should print 4 then 4.

function inc0(a) { return a + 1 }
const m4 = Map()
m4["k"] = [inc0]
const mv4 = m4["k"]
const got = mv4 ?? [inc0]
print(got[0](3))
const absent = m4["absent"]
const dflt = absent ?? [inc0]
print(dflt[0](3))
