// A `u8[]` STRUCT FIELD — the packed byte list at a CONTAINER position. It shipped at every
// value position (global, parameter, return, binding, capture) and at no container one, so
// the VLB decoder's natural cursor shape refused (silent-class-inventory D1008):
//
//   emitProgram: struct field type `u8[]` has no struct-field rep
//
// Reads the value back rather than merely constructing: a one-byte backing is unforgiving
// of the wrong wrapper, so `255` through an element write is the part that proves the rep.
// Should print 3 then 255.
type Cur = { buf: u8[], pos: i32 }

const c: Cur = { buf: [1, 2, 3], pos: 0 }
print(c.buf.length)

c.buf[0] = 255
print(c.buf[0])
