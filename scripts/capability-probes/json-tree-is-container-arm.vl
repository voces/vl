// A JSON value tree's `is` ladder. The union declares and accepts values; `is` against the
// SELF-REFERENTIAL container arm is refused by the checker, and the refusal prints the arm
// inside the very union it says the arm is not in. Needs BOTH a `null` arm and a
// self-referential container arm — `type R = string | R[]` runs, and so does
// `boolean | string | J[]`. See D982.
// Should print 1.
type J = null | string | J[]

function f(j: J) {
  if j is J[] { print(1) } else { print(0) }
}

f(["a"])
