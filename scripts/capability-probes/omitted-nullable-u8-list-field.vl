// An OMITTED `u8[] | null` struct field. `emitOmittedFieldNull` had an arm for every other
// nullable field code, so this one refused with `object literal is missing a struct field`
// until `u8[] | null` got its own list-code rows (D2295-D2299). Runs.
// Should print 1.
type H = { g: u8[] | null, n: i32 }
const h: H = { n: 1 }
print(h.n)
