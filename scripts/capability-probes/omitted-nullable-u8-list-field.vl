// An OMITTED `u8[] | null` struct field. `vl check` returns 0 and the emitter refuses with
// `emitProgram: object literal is missing a struct field` — clause 2. `emitOmittedFieldNull`
// has an arm for every other nullable field code: `string|null`, `i32|null`, `f64|null`,
// `i32[]|null`, `C[]|null`, an arm, a union, a closure, a map and an inline shape all run
// with the field left out. `u8[]|null` is the one code with no null to write.
// Should print 1.
type H = { g: u8[] | null, n: i32 }
const h: H = { n: 1 }
print(h.n)
