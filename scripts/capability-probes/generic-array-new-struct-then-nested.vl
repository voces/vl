// A generic `T[]` constructor over `__array_new__`, instantiated at a named-struct
// element and at a nested list in ONE module. Each instantiation runs alone, and so
// does the pair in the other ORDER — struct first is check-clean invalid wasm, so what
// decides the module is which ref-list row was interned first, not either call.
// A `push`-loop constructor with the same signature runs at both orders.
// Should print -1 then 0.
type Node = { count: i32, symbol: i32 }

function filled<T>(n: i32, v: T): T[] { return __array_new__(n, v) }

const nodes: Node[] = filled(2, { count: 0, symbol: -1 })
print(nodes[1].symbol)

const rows: i32[][] = filled(2, [0, 0])
print(rows[1][0])
