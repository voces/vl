// `==` over a list of a string literal union and a `string[]`: `vl check` refuses, `has no
// lowering: the two are mutually assignable but store their elements differently`, since atoms
// and strings take different equality cores (D16393). Should print true.
const a: ("a" | "b")[] = ["a"]
const b: string[] = ["a"]
print(a == b)
