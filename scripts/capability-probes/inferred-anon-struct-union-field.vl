// An INFERRED anonymous struct whose field holds a UNION value. `vl check` returns 0 and the
// emitter refuses with `emitProgram: object literal matches no union variant` — clause 2.
// The rescue is not the annotation: DECLARING `type W = { f: i32 | null }` anywhere in the
// module, unused, makes this same un-annotated binding run. Inference alone never registers
// the shape, so the literal takes the union-box route and matches no variant.
// Found 2026-09-02 by the position-matrix harness at `struct_field_init`, un-annotated face.
// See D1242.
// Should print 5.
const u: i32 | null = 5

const w = { f: u }

print(w.f ?? 0)
