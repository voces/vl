// A NULLABLE closure handed back through two INFERRED returns. `vl check` returned 0 and the
// emitter refused with `emitProgram: bare null needs a struct-typed context`; annotating the
// receiver instead produced check-clean invalid wasm, so one gap sat in both clauses.
//
// The inferred-return kind column could not carry the niche: `retKindPri` gave `nulclosure`
// no tier, so `criSetRetKind`'s strict `>` refused the fact and the slot stayed `i32`. The
// non-null closure never uses that column — its channel is `fnReturnsClosure`, a boolean read
// ahead of the inferred kind — so the two cannot collide. One hop ran all along; the second,
// inferred hop is the ingredient. See D1622. Should print 55.
function mk(): ((i32) => i32) | null { return (n: i32) => n + 1 }
function deliver() { return mk() }
const v = deliver()
if v != null { print(v(54)) }
