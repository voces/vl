// An EMPTY inline object shape as a union arm: `type U = {} | { x: i32 }`. `vl check` returns 0
// and the emitter refuses with `emitProgram: malformed inline union-variant shape`
// (`compiler/emit_collect.vl:10808`). Should print 5.
//
// MECHANISM, ABLATED. `{}` satisfies `nameIsShapeSpanEnds`, so `collectVariantFields` routes it
// to `collectShapeVariantFields` (emit_collect.vl:10876). `groupInnerOf("{}")` is `""`, and
// `tyTopLevelSplit` is called with `dropEmpty=false` (emit_base.vl:3097), so it pushes ONE
// empty part whose `indexOf(":")` is -1 — `outNames.push("")` (emit_base.vl:3102) — and the
// `fnames[fi] == ""` guard fires on a shape that has no fields to be malformed about.
//
// The refusal's sentence is wrong about the program: nothing here is malformed. An empty object
// type is a legal type the checker accepts, and a zero-field arm is a legal union member.
type U = {} | { x: i32 }
function f(u: U): i32 {
  if u is { x: i32 } { return u.x }
  return 0
}
print(f({ x: 5 }))
