// Two instantiations of ONE unbounded generic that must dispatch `x.tag()` DIFFERENTLY:
// `Circle` has no such field and takes the free `self`-function, `Boxed` carries it as a
// closure FIELD and takes the field. Each spelling runs on its own (and D1002's fix makes
// the all-field program run); it is the DISAGREEMENT that has no lowering — `vl check`
// returns 0 and the module does not load, a clause-1 row.
//
// WHY IT IS BOUNDED OUT rather than fixed with D1002: `monoCloneBody` SHARES every leaf
// expression between instances (only the statement spine is rebuilt), so the two instances
// are ONE `x.tag()` node and one pre-monomorphization decision has to serve both.
// `emitCall`'s unrewritten-member fallback covers the UFCS side in expression position but
// not in the tail-statement one, and the local-kind / print-routing classifiers take the
// i32 default for it — so deferring unconditionally trades this cell for nine others.
// Verified 2026-09-02. See D1002 / D1043.
// Should print <C> then <fld>.
type Circle = { r: f64 }
type Boxed = { tag: () => string }

function tag(self: Circle): string {
  if self.r > 0.0 { return "C" }
  "c"
}

function describe<T>(x: T): string { "<" + x.tag() + ">" }

const c: Circle = { r: 1.0 }
const b: Boxed = { tag: () => "fld" }
print(describe(c))
print(describe(b))
