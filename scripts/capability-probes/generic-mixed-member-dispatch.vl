// Two instantiations of ONE unbounded generic that must dispatch `x.tag()` DIFFERENTLY:
// `Circle` has no such field and takes the free `self`-function, `Boxed` carries it as a
// closure FIELD and takes the field. Each spelling runs on its own; it is the DISAGREEMENT
// that had no lowering — `vl check` rc 0 and a module the engine refuses (D1063).
//
// WHAT MAKES IT HARD: `monoCloneBody` SHARES every leaf expression between instances (only
// the statement spine is rebuilt), so the two instances are ONE `x.tag()` node and a
// pre-monomorphization decision has to serve both. `dispatchRewrite` therefore DEFERS
// whenever any instantiation takes the field (`drwAnyInstanceTakesField`), and the deferred
// question is answered per instance off the pin, in `monoPinBinOps`' member-call arm —
// beside the two `drwWalk` arms D511/D512 already re-run there. Deferring with nothing
// behind it costs nine cells instead: the UFCS side then reaches emission unrewritten, where
// the tail statement has no fallback and the local-kind / print-routing classifiers take the
// i32 default. See D1002 / D1063.
// Should print <C> then <fld>.
type Circle = { r: f64 }
type Boxed = { tag: () => string }

function tag(self: Circle): string {
  if self.r > 0.0 { return "C" }
  "c"
}

function describe<T>(x: T): string { "<" + x.tag() + ">" }

const c: Circle = { r: 1.0 }
const b: Boxed = { tag: () => "fld" }
print(describe(c))
print(describe(b))
