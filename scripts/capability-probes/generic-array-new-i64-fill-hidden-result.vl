// `__array_new__` with an i64 FILL inside a generic whose return type hides the list.
// `vl check` returns 0 and the emitter refuses with `emitProgram: __array_new__ i64 fill but
// i64 list types not collected` — clause 2. `arrNewNamedKind` reads the fill's rep per
// instance, but nothing in the program spells `i64[]` so `ia64Used` was never set. Returning
// `T[]` instead of `i32` substitutes an `i64[]` annotation and compiles; the i32 control
// runs.
// Should print 1.
function pick<T>(v: T): i32 {
  const out = __array_new__(1, v)
  return out.length
}
function big(): i64 { 7 }
print(pick(big()))
