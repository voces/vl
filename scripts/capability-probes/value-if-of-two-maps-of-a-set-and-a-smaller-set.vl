// A value `if` choosing between two maps of un-annotated functions, one of a set and one of a
// smaller set (D15393). `vl check` returns 0 and the
// emitter refuses it: `emitProgram: unsupported map value type (no rep for a union-member struct`.
// Should print 4 then 1.5.

function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const fnMap = Map()
fnMap.set("a", inc0)
fnMap.set("b", half)
const m2 = Map()
m2.set("a", half)
function pick(c: boolean) { return if c { m2 } else { fnMap } }
const g = pick(false).get("a")
if g != null { print(g(3)) }
const h = pick(true).get("a")
if h != null { print(h(3)) }
