// A function VALUE whose parameter is a union ARM, given that arm read out of a struct
// field. `vl check` returns 0 and the emitter refuses with `emitProgram: value-call union-ARM
// parameter given a value that is not that arm — a value call does not yet build one
// (annotate the binding as the arm, or call it as a named function)` — clause 2. `cvBuildable`
// admits a union-typed expression, a literal object argument, or an arm heap twin, and a
// field read of an arm-typed value is none of the three; a call result and an index read out
// of a `Cat[]` both run.
// Should print 4.
type Cat = { legs: i32 }
type Dog = { wings: i32 }
type Animal = Cat | Dog
type Box = { c: Cat }
function takeCat(c: Cat): i32 { c.legs }
const b: Box = { c: { legs: 4 } }
const f = takeCat
print(f(b.c))
