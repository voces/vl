// A closure whose body yields the `null` unit type. `vl check` accepts it (rc 0); emit refuses
// with `emitProgram: bare null needs a struct-typed context`, since the lambda's un-annotated
// result gets no `nulnone` return kind (D9921). Should print true.
function nothing(): null { return null }
const cl = () => nothing()
print(cl() == null)
