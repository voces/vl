// `==` over a struct union one of whose arms has a REF field. D973 closed the scalar and
// string cases by comparing the arm's fields through the VARIANT table (`uFieldNames` /
// `uFieldTypes`) — the struct table is empty when a union is declared, so `emitStructEqRec`
// is not available. A ref / list / map field DECLINES there and keeps the loud refusal rather
// than becoming a bad lowering; closing it needs the same field compare made recursive, and
// the nested shape's fields found the same way the arm's were.
// Found 2026-09-01 by probing the residue D973 left.
// Should print true.
type C = { r: i32 }
type A = { c: C }
type B = { b: i32 }

function mk(n: i32): A | B {
  if n > 0 { return { c: { r: 1 } } }
  { b: 2 }
}

const u = mk(1)
const v = mk(1)
print(u == v)
