// A closure-value call in STATEMENT position whose callee is an index read, returning a
// value. `vl check` returns 0 and the emitter refuses with `emitProgram: a function-value
// call statement yields a value the tail-value ladder did not claim` — clause 2. The void
// twin is served one line above by `emitCallRef`, so the non-void arm is one missing `drop`
// on a path the ladder already reaches.
// Should print 1.
const fs = [(x: i32) => x + 1]
fs[0](3)
print(1)
