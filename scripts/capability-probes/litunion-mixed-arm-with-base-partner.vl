// A literal-union ALIAS discriminant beside its own BASE — `{kind: K1}` next to `{kind: string}`.
// D1023's "EITHER, not BOTH" amendment rules this pair legal (a set beside its base is the
// overlapping-set case: `is A` compares the value, `is B` is the tag test alone) and the
// checker agrees, so `vl check` returned 0 and the emitter then refused.
//
// IT WAS THE BOUND OF D1050's UNIFICATION, which only knew the ATOM direction — and the base
// arm holds an arbitrary string with no interned id, so the atom is the one rep these two arms
// cannot share.
//
// CLOSED BY D1461 in the OTHER direction, and the mirror was mostly already built: demoting the
// alias arm's row to the string rep lands it exactly where a declared INLINE set's row already
// sits, so the code-3 construct, `is` compare and read serve it unchanged, and it is the
// ATOM-typed destinations that convert — `strReppedLitUnionAt` -> `emitStrToAtom`. `K1` keeps
// the atom everywhere else in the module; only the FIELD moves.
// See DECISIONS §"a mixed-spelling variant field carries the ATOM".
// Should print circle then zz.
type K1 = "circle" | "round"
type A = { kind: K1, r: f64 }
type B = { kind: string, r: f64 }
function f(n: i32): A | B {
  if n == 0 { return { kind: "circle", r: 1.0 } }
  const v: B = { kind: "zz", r: 2.0 }
  return v
}
const a = f(0)
if a is A { print(a.kind) } else { print("notA") }
const b = f(1)
if b is B { print(b.kind) } else { print("notB") }
