// A literal-union ALIAS discriminant beside its own BASE — `{kind: K1}` next to `{kind: string}`.
// D1023's "EITHER, not BOTH" amendment rules this pair legal (a set beside its base is the
// overlapping-set case: `is A` compares the value, `is B` is the tag test alone) and the
// checker agrees, so `vl check` returns 0 and the emitter then refuses.
//
// IT IS THE BOUND OF D1050's UNIFICATION, NOT AN OVERSIGHT. That fix lays a mixed-spelling
// discriminant out under the interned-ATOM rep, which it may do only when both arms are atom
// material — a 2+-member set of string literals. The base arm holds an ARBITRARY string and
// has no interned id, so promoting it would have to invent a rep for a value that has none.
//
// CLOSING IT MEANS THE OTHER DIRECTION: unify on the STRING side instead, which needs the
// mirror of every atom consumer (construct intern, `is` compare, read classifier, widen) for
// the arm whose type is the alias — and gives that alias a rep the rest of the module does not
// use for it. See DECISIONS §"a mixed-spelling variant field carries the ATOM".
// Should print circle then zz.
type K1 = "circle" | "round"
type A = { kind: K1, r: f64 }
type B = { kind: string, r: f64 }
function f(n: i32): A | B {
  if n == 0 { return { kind: "circle", r: 1.0 } }
  const v: B = { kind: "zz", r: 2.0 }
  return v
}
const a = f(0)
if a is A { print(a.kind) } else { print("notA") }
const b = f(1)
if b is B { print(b.kind) } else { print("notB") }
