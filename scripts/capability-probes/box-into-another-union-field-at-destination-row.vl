// A value already held as `i32 | string` delivered into a record field typed `f64 | string`, in a
// literal built at its destination's row. Legacy converts the box's members (`emitUnionBoxArg` at
// the field's union), so the `i32` member reads back as the `f64` 3. With the box passed through
// unconverted, the `is f64` read hit a cast failure. Two fences hold it: the IR's field guard
// ("object field box from a box") and `deliver`'s box-into-box check. Should print 3.5 then s.
type D = { v: f64 | string }
const x: i32 | string = 3
const y: i32 | string = "s"
function mk() { return { v: x } }
function mks() { return { v: y } }
const d: D = mk()
if d.v is f64 { print(d.v + 0.5) }
const e: D = mks()
if e.v is string { print(e.v) }
