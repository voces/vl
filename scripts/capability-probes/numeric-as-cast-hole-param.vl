// A NUMERIC `as` CAST ON AN UN-ANNOTATED (hole) PARAMETER whose argument is union-repped.
// `vl check` returns 0 and the module is INVALID: `type mismatch: expected i32, found
// (ref $type)`. The cast emits NOTHING — the parameter's slot is the `{tag, payload}` box
// the call site pinned it to, and `local.get` goes straight into the i32 consumer.
// The annotated twin — `function take(a: i32 | null)` — prints 5, so the program is
// type-valid. Both gates read the operand's arena type, which for a hole is a `TyVar`:
// `checkCastNode`'s trio arm and `asExprIsUnionCast` both decline, and neither the
// propagation check nor the unbox is emitted. `as` / `as?` / `as!` all behave this way.
// See D1251.
// Should print 5.
const u: i32 | null = 5

function take(a) { print(a as! i32) }

take(u)
