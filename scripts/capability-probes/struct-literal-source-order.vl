// A struct literal whose fields are written in a NON-alphabetical order, each initialiser
// side-effecting. `struct.new` takes its operands in LAYOUT order (field names sorted, D622)
// and the emitter evaluated each initialiser at the moment it pushed it, so the initialisers
// ran permuted: check-clean, running, wrong answer — a clause-1 miscompile with no
// diagnostic. Reported by the glean session as VL-018 (`~/glean/docs/vl-issues.md`), where it
// silently permuted a nine-byte record read; filed as D1510 and CLOSED by evaluating
// out-of-order initialisers into scratch locals in source order. Kept as the probe that
// keeps it closed, and as the SIDE-EFFECTING witness the corpus has none of: every other
// object-literal cell initialises from constants, which cannot tell the two orders apart.
// Should print 1 then 2 then 3.
let n = 0

function next() {
  n += 1
  n
}

const s = { b: next(), a: next(), c: next() }

print(s.b)
print(s.a)
print(s.c)
