// An UN-ANNOTATED binding of a `.pop()` over a NESTED list.
//
// silent-class inventory D1210. `xs.pop()` over `i32[][]` is `i32[] | null` to the checker,
// and every DELIVERY of that type already exists — `const v: i32[] | null = xs.pop()` runs,
// and so does the same value from a declared `function src(): i32[] | null`. What is missing
// is the INFERENCE: `exprNullableList`'s `Call` arm resolves an `Ident` callee and a closure
// value, and a MEMBER callee reaches neither, so the un-annotated cell falls to the i32-list
// default and the pop pushes a `(ref $listWrapper)` into it — check-clean invalid wasm.
//
// D1174 closed the four NUMERIC reps by building the `{tag, anyref}` value box; a LIST already
// reps as a nullable wrapper ref, so this needs the inference arm and not the box, and D1174's
// fix left this cell exactly where it was.
//
// Should print 1 then 2

const xs: i32[][] = [[1], [2, 3]]
const v = xs.pop()
if v != null { print(v.length) }
const w = xs.pop()
if w != null { print(w.length + 1) }
