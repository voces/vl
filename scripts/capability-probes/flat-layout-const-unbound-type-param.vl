// A `flat` layout constant read off a type parameter that NO parameter binds, inside a
// lambda. `vl check` returns 0 — the checker defers the fold deliberately — and the emitter
// refuses with `emitProgram: monomorphize: `T.size` needs `T` bound by a parameter — a
// layout constant is per-instance` — clause 2. `monoInstantiate` pushes a type parameter
// only when a PARAMETER's annotation rides it, so a type parameter mentioned nowhere in the
// parameter list is never bound and `monoBindOf` answers the empty string.
// Should print 9.
flat type P = { a: i32, b: i32 }

function f<T>(n: i32): i32 {
  const g = () => T.size
  return g() + n
}

print(f(1))
