// A module-scope bare read of a map whose VALUE spelling carries `| null`. `vl check`
// returns 0 and the emitter refuses the compare's bare `null`.
//
// The CELL and the READ answered from two different sources. `globalCellKind` types the
// binding from `letNulMapReadValKind`, which reads the vals ELEMENT KIND; the read side
// asked `nameIsI32Array` / `nulScalarListKind` of `mvValName`, the DECLARED spelling, which
// cannot read past a `| null` — and the distinct-backing arm appended a second one.
//
// The value's own `| null` is the whole ingredient: `{[string]: i32[]}` at the identical
// module-scope read always ran, and inside a FUNCTION both spellings ran. The REF backings
// escaped because their global rung asks the cell rather than the name. See D1107.
// Should print 1 then s then 1.5.
const mi: {[string]: i32[] | null} = Map()
mi["k"] = [1]
const ri = mi["k"]
if ri != null { print(ri[0]) }

const ms: {[string]: string[] | null} = Map()
ms["k"] = ["s"]
const rs = ms["k"]
if rs != null { print(rs[0]) }

const md: {[string]: f64[] | null} = Map()
md["k"] = [1.5]
const rd = md["k"]
if rd != null { print(rd[0]) }
