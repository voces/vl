// `is <literal>` over a union value delivered by a CALL — a non-binding receiver.
//
//   emitProgram: literal `is` over a non-binding union value is not supported yet
//
// `vl check` returns 0, so this is a clause-2 violation by construction. silent-class
// inventory D1060.
//
// THE ABLATION SAYS "CALL", NOT "NON-IDENTIFIER", which is what makes the message's own
// wording misleading: a struct-FIELD receiver (`s.u is "a"`) and an ELEMENT receiver
// (`xs[0] is "a"`) both RUN today, and binding the call to a `const` first RUNS. Only the
// call result — parenthesised or not — refuses. So the missing piece is a scratch-local
// spill of the receiver, not a re-readability bound.
//
// Should print yes then no.
type K = "a" | "b"

function mk(n: i32): K | i32 {
  if n == 0 { return "a" }
  7
}

if mk(0) is "a" { print("yes") } else { print("no") }
if mk(1) is "a" { print("yes") } else { print("no") }
