// D17814 — a lambda written into a holder `let` of a maker's two-signature record is not built
// beside the maker's own lambda
// The IR refuses it as `cannot yet lower this statement (bundle result pick refused...)`; the
// literal is `bundle result pick refused`.
// Should print 3.
function lap(f) {
  const _a = f(2.5)
  const _b = f(3)
  return f
}
let k = lap((a) => a + 1)
k = (a) => a
print(k(3))
