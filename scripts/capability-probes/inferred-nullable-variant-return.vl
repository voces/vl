// D1562 — a function with NO return annotation whose returns deliver `Hit | null`, where `Hit`
// is an arm of a declared union. `computeRetInference`'s name ladder had a `nulstruct` arm and
// no `nulvariant` twin, and `retKindPri` gave the kind no tier at all — so `criClassify`'s
// tier-5 `nulstruct` write beat the annotated fact and `fnRetStructIndexSid`, kind-gated, had
// no row to hand back. `emitProgram: ref valtype with no interned shape` at `vl check` rc 0.
// The ANNOTATED twin (`function f(): Hit | null`) ran throughout, which is what makes this
// clause 2 rather than a design rule. No corpus cell has the shape.
// Should print 7.
type Hit = { v: i32 }
type Miss = { m: string }
type R = Hit | Miss

function mkA(ok: boolean): Hit | null {
  if ok { return null }
  return { v: 7 }
}

function f() { return mkA(false) }

const e = f()
if e != null { print(e.v) } else { print(-1) }
