// Named functions taking and returning a 128-bit vector, each taken as a value and called. The
// refusal "emitProgram: a function value's signature is not yet supported" names a signature
// the function-value ABI cannot key; the plainest programs it forbids run.
// Should print 3.5 then 2.5.
function f(v: v128) { return __extract_lane_f32x4__(v, 0) }
const g = f
print(g(__splat_f32x4__(3.5)))
function mk(x: f32): v128 { return __splat_f32x4__(x) }
const h = mk
print(__extract_lane_f32x4__(h(2.5), 3))
