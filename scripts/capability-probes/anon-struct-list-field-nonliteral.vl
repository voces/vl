// An anonymous struct literal whose field holds a LIST OF STRUCTS produced by a CALL rather
// than by an array literal of object literals. D1443 gave the field coder a code-5 rung for
// the literal spelling, where each element carries its own row; a call result has no element
// NODE to read a row off, so the coder answered -1, the OWNER literal got no row, and the
// refusal was `emitProgram: object literal field count does not match struct` — a sentence
// about a mismatch the program does not contain — after `vl check` returned 0.
// Found 2026-09-03 by the day-one sampler (#2478), `--seed 1 --count 400`. Closed by D1515.
// This file must NOT declare the OUTER shape (`type Holder = { it: Rec[] }`): that unused
// declaration is the rescue both rows record.
// Should print 3.
type Rec = { name: string, n: i32 }

function rows(): Rec[] { return [{ name: "ada", n: 3 }] }

function go() {
  const box = { it: rows() }
  print(box.it[0].n)
}

go()
