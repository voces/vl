// A `??` over a read of a map whose values are built wider, defaulted to a call's result held
// in a `const`, inside a list literal and a record literal. The refusal "for a read of a
// container built wider, is not yet supported inside a list or record literal" names this
// shape; the plainest program it forbids runs.
// Should print 1 then 4.
type J = { f: i32 | null }
function mk() { return { f: 4 } }
const m = Map()
m.set("a", mk())
const wm: {[string]: J} = Map()
wm.set("a", mk())
function dflt() { return { f: 1 } }
const d = dflt()
const xs = [m.get("a") ?? d]
print(xs.length)
const r = { g: m.get("a") ?? d }
print(r.g.f)
