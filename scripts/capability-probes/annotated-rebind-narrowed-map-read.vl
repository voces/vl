// An ANNOTATED rebind of a NARROWED struct-valued map read, then captured. `vl check`
// returned 0 and the module did not validate: `type mismatch: expected (ref $type), found
// (ref null $type)`.
//
// `captureValKind` typed the env field from the ANNOTATION (`(ref $S)`) while the local it
// captures keeps the map read's nullable niche — narrowing is type-level and the cell is not,
// so the two disagreed. The env field now matches the local.
//
// The annotation is the INGREDIENT here and the whole fix in D1476, the same seam read from
// opposite ends. Dropping the annotation, capturing the narrowed value with no rebind, and
// removing the map all ran before. See D1632. Should print 3.
const m: { [string]: { name: string, n: i32 } } = Map()
m["k"] = { name: "ada", n: 3 }
const mv = m["k"]
if mv != null {
  const v: { name: string, n: i32 } = mv
  const g = () => v
  print(g().n)
}
