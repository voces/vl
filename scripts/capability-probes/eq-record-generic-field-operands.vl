// `==` in a generic body over field reads whose instance types are two records of one field set
// stored apart: `vl check` returns 0 and emit refuses with
// `emitProgram: struct equality is not supported yet` (D16470).
// Should print true.
function eq<T, U>(a: {v: T}, b: {v: U}): boolean { return a.v == b.v }
print(eq({ v: { f: 1 } }, { v: { f: 1.0 } }))
