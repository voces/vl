// A MODULE-SCOPE lambda capturing a closure-typed module binding and returning it. `vl check`
// returns 0 and the module does not validate (`type mismatch: expected i32, found (ref $type)`
// in `get`) — a clause-1 row, kept here because the probe runner is the standing instrument for
// "the type system accepts it and codegen does not build it".
//
// Three ingredients: MODULE scope (the identical four lines inside `function go() { … }` print
// 5), the capture HOP (calling `held` directly runs), and the captured value being a CLOSURE (a
// captured struct at module scope with no block runs — see `module-block-closure-capture-struct`).
// Dropping the annotation on `v` turns the silence into a loud emit reject: same gap, other
// clause. See D1475.
// Should print 5.
const held: (i32) => i32 = (x: i32) => x + 1
const get = () => held
const v: (i32) => i32 = get()

print(v(4))
