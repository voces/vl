// `__array_new__` filled with a float and with a record literal. The refusal "emitProgram:
// __array_new__ fill type not yet supported natively" names an unresolved fill; the plainest
// programs it forbids run.
// Should print 1.5 then 4.
const xs = __array_new__(2, 1.5)
print(xs[1])
const ps = __array_new__(2, { a: 4 })
print(ps[1].a)
