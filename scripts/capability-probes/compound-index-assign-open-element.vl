// A COMPOUND ASSIGNMENT INTO AN UN-ANNOTATED EMPTY LIST — the tally shape a consumer writes
// when a key may not have a row yet (glean VL-046, D1600's residue).
//
// `count[i] += 1` desugars to `count[i] = count[i] + 1` with the target shared between the read
// and the write, so the read runs while the element is still open. It answered the in-band `-1`,
// the operator floor turned that into `TyErr`, and the store banked the error type as the
// element. In the guarded spelling the program still ran with a `<error>[]` binding; where the
// compound assignment is the function's TAIL the error type reached the return and the whole
// program was refused:
//
//   cannot infer a return type for 'bump' — annotate a return type
//
// CLOSED by D1603: a store's own right-hand side pins the open element from the value operand
// (`asgReadElemPin`), which is the answer the plain `count[i] = 1` spelling already took.
//
// THE f64 AND string CELLS ARE THE ONES THAT CAN FAIL. An unpinned hole lowers as the i32-list
// default, so an i32-only probe passes whether or not the pin reached the emitter.
//
// Should print: 3 2 2.25 a!

// The tail-position face — the one that was a check reject.
const tally = []
function bump(i: i32) { tally[i] += 2 }
tally.push(1)
bump(0)
print(tally[0])

// The consumer's guarded face, where the compound assignment sits behind an early return.
const seen = []
const count = []
function note(name: i32) {
  for i in 0 to seen.length - 1 {
    if seen[i] == name {
      count[i] += 1
      return
    }
  }
  seen.push(name)
  count.push(1)
}
note(7)
note(7)
print(count[0])

// A non-i32 element, read back through arithmetic.
const scaled = []
function scale(i: i32) {
  if scaled.length > i {
    scaled[i] += 0.5
    return
  }
  scaled.push(1.5)
}
scale(0)
scale(0)
print(scaled[0] + 0.25)

// A string element: `+=` is concatenation, so the pin has to name `string`.
const tags = []
function tag(i: i32) {
  if tags.length > i {
    tags[i] += "!"
    return
  }
  tags.push("a")
}
tag(0)
tag(0)
print(tags[0])
