// A top-level `let` re-pointed between two un-annotated functions, handed to a generic
// higher-order function at `i32` and at `f64`: `vl check` returns 0 and emit refuses with
// `emitProgram: the reassigned function binding `h` holds functions called at more than one
// argument type`. See D16833. Should print 5 then 3.5.
function app<A, B>(f: (x: A) => B, x: A): B { return f(x) }
function hinc(x) { return x + 1 }
function hid(x) { return x }
const c = 3 > 2
let h = hinc
if !c { h = hid }
print(app(h, 4))
print(app(h, 2.5))
