// `x as! S` over a niche-repped `S | null` where `S` is a STANDALONE struct. `vl check`
// returns 0 and the emitter refuses: `emitProgram: `as A` over a `A | null` is lowered for
// a string, a list and a union variant`, a standalone struct, map or closure cell being
// unwired at an un-annotated destination — clause 2. The lowering is one opcode and works;
// what is missing is the rep classifiers, which read the CAST node and find no struct row
// for a value that is not a union variant, so the un-annotated face was check-clean invalid
// wasm at six of twenty-six delivery positions. The map and closure cells are the same row.
// Should print 7.
type A = { a: i32 }
function mk(): A | null { return { a: 7 } }
const v: A = mk() as! A
print(v.a)
