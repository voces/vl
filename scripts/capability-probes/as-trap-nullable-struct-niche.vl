// `x as! S` over a niche-repped `S | null` where `S` is a STANDALONE struct. It was refused
// at emit until the struct rep classifiers learned to read the cast node; it runs in both
// faces now (`matrix/as-trap-nullable-struct-niche.matrix.vl`, D1812).
// Should print 7.
type A = { a: i32 }
function mk(): A | null { return { a: 7 } }
const v: A = mk() as! A
print(v.a)
