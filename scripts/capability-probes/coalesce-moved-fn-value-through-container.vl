// D1100 — a function whose param/return ROWS a `??` merge moved, delivered through a STRUCT
// FIELD and called through it. `vl check` returned 0 and the module did not load.
//
// The delivery positions that go through a BINDING, a module GLOBAL, a global ASSIGNMENT, a
// shared callback NAME, a two-target slot or a RETURN were closed by D1090's attribution work;
// this one was not attribution. Measured: with `anonLeafAnyIndirectCall` forced to `false` the
// family DID mint here and the cell still failed, at a different message — so the missing half
// was the DELIVERY (the field's stored closure carrying the moved `$fnsig`, and the `??`'s own
// local declared at the merged row), not the analysis. D1090 is the CLOSED prerequisite; D1100
// closed this cell and the array-element, array-of-structs and returned-value ones with it, by
// wiring each delivery and THEN narrowing the gate to an ATTRIBUTION question. The wrapping
// lambda is not this family — it ablates to a relay whose own return row does not move, D1420.
// Found while building D1090's position matrix, verified 2026-09-02.
// Should print 9 then 7.
function src(p: {r: i32}): {r: i32} | null { p }

function rd() {
  const o = { f: src }
  const v = o.f({ r: 9 }) ?? { r: 0 }
  print(v.r)
  const g1 = src({ r: 7 }) ?? { r: "s" }
  print(g1.r)
}

rd()
