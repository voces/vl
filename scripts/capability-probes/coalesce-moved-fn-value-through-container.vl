// A function whose param/return ROWS a `??` merge moved, delivered through a STRUCT FIELD and
// called through it. `vl check` returns 0 and the module does not load.
//
// The delivery positions that go through a BINDING, a module GLOBAL, a global ASSIGNMENT, a
// shared callback NAME, a two-target slot or a RETURN were closed by D1090's attribution work;
// this one is not attribution. Measured: with `anonLeafAnyIndirectCall` forced to `false` the
// family DOES mint here and the cell still fails, at a different message — so the missing half
// is the DELIVERY (the field's stored closure must carry the moved `$fnsig`, and the literal
// argument at the `call_ref` must be built at the merged row), not the analysis. The array-
// element and wrapping-lambda spellings are the same gap. See D1100.
// Found while building D1090's position matrix, verified 2026-09-02.
// Should print 9 then 7.
function src(p: {r: i32}): {r: i32} | null { p }

function rd() {
  const o = { f: src }
  const v = o.f({ r: 9 }) ?? { r: 0 }
  print(v.r)
  const g1 = src({ r: 7 }) ?? { r: "s" }
  print(g1.r)
}

rd()
