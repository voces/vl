// A RECURSIVE union alias composed into a wider union — the `T | Error` return shape every
// std module uses (`u8[] | IoError`, `string | Utf8Error`), with `T` the JSON value tree.
// The checker accepts it; the emitter does not flatten the recursive alias into the
// composition and treats `Json` as one opaque atom with no member table, so `is JsonError`
// refuses (`union box atom test on a union with no recorded members`) and, with the `is`
// removed, the function body is check-clean INVALID wasm (returns the error struct where the
// composed box is expected). The non-recursive twin — same six arm kinds, `f64[]` and
// `{[string]: f64}` in place of the self-references — runs. See D1021.
// Found 2026-09-01 measuring the `std:json` v1 surface (`docs/json-design.md`).
// Should print empty then 2.5.
type Json = null | boolean | f64 | string | Json[] | { [string]: Json }
type JsonError = { at: i32, kind: "syntax" | "depth", msg: string }

function parseJson(self: string): Json | JsonError {
  if self.length == 0 { return { at: 0, kind: "syntax", msg: "empty" } }
  return 2.5
}

const r = "".parseJson()
if r is JsonError { print(r.msg) }
const r2 = "x".parseJson()
if r2 is f64 { print(r2) }
