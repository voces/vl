// Two makers' lambdas relayed through a `match` at two function types whose results differ. See D16779.
// Should print 4 then 0.5.
function inc() { return (a) => a + 1 }
function dbl() { return (a) => a * 2 }
function pick(n: i32) {
  return match n {
    0 => inc()
    _ => dbl()
  }
}
const v: (a: i32) => i32 = pick(0)
const w: (a: i32) => f64 = pick(1)
print(v(3))
print(w(2) / 8.0)
