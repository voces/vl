// A list of un-annotated functions held below the top of a generic's argument is pinned at the
// type its place classes close (D16839).
// Should print 5.
function inc0(a) { return a + 1 }
function inc1(a) { return a + 2 }
function id(x) { return x }
const r = id({ l: [inc0, inc1] })
print(r.l[1](3))
