// An INFERRED nullable return whose non-null arm is a LIST.
//
// CLOSED by D1062 (`synthNulListRetAnns`): a NAMED un-annotated function whose returns
// join to `T[] | null` is pinned to the annotation the user did not write, so it lowers
// through the path the annotated spelling already had — at EVERY element type.
//
// What it used to be, and why the row was one row: ONE shape refused through TWO
// channels, decided by the element type.
//
//   emitProgram: bare null needs a struct-typed context           (i32[], boolean[])
//   'f' infers the nullable return type string[] | null — …       (everything else, at CHECK)
//
// A count of emit-side refusals saw one half and a count of checker-side refusals saw
// the other, so neither number described the gap. Both were clause-2 violations.
//
// ANNOTATING THE RETURN USED TO FIX IT, which is exactly why a fixture that annotates
// every destination could not see this defect (D969's rule).
//
// This probe covers BOTH former channels plus a distinct-backing leaf, and it READS
// THROUGH the returned container rather than only comparing it with `null` — a box or a
// mis-repped wrapper fails the read, not the comparison.
//
// Should print: true 2 10 a 1.5
function pickI32(n: i32) {
  if n == 0 { return [10, 20] }
  return null
}
print(pickI32(1) == null)
const ri = pickI32(0)
if ri != null {
  print(ri.length)
  print(ri[0])
}

function pickStr(n: i32) {
  const vs: string[] = ["a", "b"]
  if n == 0 { return vs }
  return null
}
const rs = pickStr(0)
if rs != null { print(rs[0]) }

function pickF64(n: i32) {
  const vf: f64[] = [1.5, 2.5]
  if n == 0 { return vf }
  return null
}
const rf = pickF64(0)
if rf != null { print(rf[0]) }
