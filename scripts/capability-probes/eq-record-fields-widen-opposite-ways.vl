// `==` over two records whose field pairs each compare bare but widen in opposite directions:
// the checker refuses, asking whether one whole record is assignable to the other (D16396).
// Should print true.
const a: {x: i32, y: i64} = { x: 1, y: 2 }
const b: {x: f64, y: i32} = { x: 1.0, y: 2 }
print(a == b)
