// A NAMED alias of a composition that carries a recursive union alias — `type JR = Json |
// E` — used as a return type, delivering one of the recursive alias's OWN arms. D1021's
// close (#2315) made the direct spelling `function f(): Json | E { return 2.5 }` run; the
// named hop over the same composition still loses every arm the recursive alias brought:
// `f64` is delivered raw where the composed box is expected (check-clean INVALID wasm,
// `expected (ref $type), found f64`), `boolean` and `string` likewise, a `Json[]` value
// refuses loudly, while the struct arm the composition added itself and `null` both land.
// The non-recursive twin named runs, and `type J2 = Json` alone runs, so the ingredient is
// the alias hop over the COMPOSITION, not over the recursive alias. See D1028. This is the
// spelling a `std:json` consumer writes the first time they tidy `Json | JsonError` into a
// name.
// Found 2026-09-01 by vl-de as D1021's residue; ablated by the tooling session.
// Should print 2.5 then empty.
type Json = null | boolean | f64 | string | Json[] | { [string]: Json }
type E = { at: i32, msg: string }
type JR = Json | E

function f(c: boolean): JR {
  if c { return 2.5 }
  return { at: 0, msg: "empty" }
}

const r = f(true)
if r is f64 { print(r) }
const r2 = f(false)
if r2 is E { print(r2.msg) }
