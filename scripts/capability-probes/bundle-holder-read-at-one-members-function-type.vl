// A bundle holder read where one member's function type is expected (D15749). `vl check` returns 0 and the
// emitter refuses it: `emitProgram: a function returning a parameter called at two signatures is called where its result is not used at one of them`.
// Should print 5 then 4.

function lap(f) {
  f(2.5)
  f(3)
  return f
}
function main() {
  const k = lap((a) => a + 1)
  const m: (f64) => f64 = k
  print(m(4))
  print(k(3))
}
main()
