// A `.map` whose callback arrives as a function-typed PARAMETER, with a STRUCT result, read
// through `?.`. The callback has no lifted entry, so the result list's struct row is interned
// from the call's own recorded type; without that row the `.get` receiver's slot did not
// resolve and the compiler trapped (D2301). Runs.
// Should print 2.
type A = { v: i32 }
type B = { w: i32 }
function toB(a: A): B { return { w: a.v + 1 } }
function go(f: (A) => B, xs: A[]): i32 { return xs.map(f).get(0)?.w ?? 0 }
print(go(toB, [{ v: 1 }]))
