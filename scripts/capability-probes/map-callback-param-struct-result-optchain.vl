// A `.map` whose callback arrives as a function-typed PARAMETER, with a STRUCT result, read
// through `?.`. `vl check` returns 0 and the emitter refuses with `emitProgram: `?.` field is
// not on the list's element struct` — clause 2. The struct arm of `collectMapFilterUse` is
// gated on the callback resolving to a known function entry, so no ref-list row is interned
// for the result and the receiver's slot resolves to the SOURCE list's element row — a row
// with no field `w`. With a named callback the same program gets past this guard.
// Should print 2.
type A = { v: i32 }
type B = { w: i32 }
function toB(a: A): B { return { w: a.v + 1 } }
function go(f: (A) => B, xs: A[]): i32 { return xs.map(f).get(0)?.w ?? 0 }
print(go(toB, [{ v: 1 }]))
