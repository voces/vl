// `==` over two lists whose element is `string | null`: pair by pair, two nulls equal, a null
// and a string unequal. The checker refused it as having no lowering while `string[]` compared.
// Should print: true false
const a: (string | null)[] = ["x", null]
const b: (string | null)[] = ["x", null]
const c: (string | null)[] = ["x", "y"]
print(a == b)
print(a == c)
