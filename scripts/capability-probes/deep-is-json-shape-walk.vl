// DEEP `is` OVER A `Json` VALUE — D1035's own witness. `r is string[]` where `r: Json` is
// not an arm test: a `Json[]` holding strings is not a `string[]` in the heap, so no
// registered tag matches the spelling and the emitter answered `false` for EVERY value on a
// `vl check`-clean program. The arm was still narrowed to `string[]` and its body compiled
// against a rep the value never had — unreachable only because the test never passed.
// `docs/serde-design.md` §"Deep `is` / `as` over a `Json` value" rules the test a runtime
// SHAPE WALK plus a conversion, so this prints the length of a converted `string[]` element
// rather than the boolean: a boolean cannot tell a walk that matched from one that built
// the wrong rep.
// Should print 3.
type Json = null | boolean | f64 | string | Json[] | { [string]: Json }

function d(r: Json): i32 {
  if r is string[] { return r[0].length }
  0
}

const l: Json = ["xyz"]
print(d(l))
