// D1598 — CLOSED. The CLAUSE-1 face of D1596's residue. Two sibling top-level blocks bind
// `n`; both bindings are `Cell`, so every candidate the module-frame table holds pins the SAME
// rep. `moduleLocalLetOfUnique` still declined on the duplicated name and the instance took
// the `"i32"` catch-all: `vl check` rc 0, invalid wasm.
//
// The pin now asks the CHECKER which binding the site denotes — its recorded type names one
// candidate — and falls back to a candidate set that all pin one spelling. The DISAGREEING
// shape the decline was built for is `hole-param-pinned-from-sibling-block-binding.vl`, and
// `tests/cases/generics/pin-module-block-binding.vl` leg 7 is the control that must keep the
// i32 instance.
// The loud face is `tests/cases/modules/sibling-block-hole-param-one-type-cross-module/`.
// Should print 3 then 4.
type Cell = { base: i32 }

function ld(self: Cell): i32 { return self.base }

function hsum(b) { return b.ld() }

if true {
  const n = { base: 3 }
  print(n.base)
}

if true {
  const n = { base: 4 }
  print(hsum(n))
}
