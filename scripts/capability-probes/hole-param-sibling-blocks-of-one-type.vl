// D1598 — the CLAUSE-1 face of D1596's residue, and the narrowing it needs. Two sibling
// top-level blocks bind `n`; both bindings are `Cell`, so every candidate the module-frame
// table holds pins the SAME rep. `moduleLocalLetOfUnique` still declines on the duplicated
// name and the instance takes the `"i32"` catch-all: `vl check` rc 0, invalid wasm.
//
// The DISAGREEING case is what that decline was built for (D1596), and it must keep
// declining — `tests/cases/generics/pin-module-block-binding.vl` leg 7 is that control.
// Agreeing candidates are the half the decline over-refuses.
// The loud face is `tests/cases/modules/sibling-block-hole-param-one-type-cross-module/`.
// Should print 3 then 4.
type Cell = { base: i32 }

function ld(self: Cell): i32 { return self.base }

function hsum(b) { return b.ld() }

if true {
  const n = { base: 3 }
  print(n.base)
}

if true {
  const n = { base: 4 }
  print(hsum(n))
}
