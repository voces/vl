// D1561's OTHER producer — a HOLE-parameter call delivering a declared struct union into an
// inferred destination. `vl check` rc 0, then
// `emitProgram: field access but no struct type declared`, with no `??` anywhere: the `??`
// was never the ingredient, the missing union NAME was. A generic pin (`pass<T>`) and a
// direct call both ran, which is what separated the hole from the call.
// Should print rect twice.
type Circle = { kind: "circle", r: f64 }
type Rect = { kind: "rect", w: f64, h: f64 }
type Shape = Circle | Rect
function mkval(): Shape { return { kind: "rect", w: 2.0, h: 3.0 } }
function passh(x) { return x }
function go() {
  const v = passh(mkval())
  print(v.kind)
  print(passh(mkval()).kind)
}
go()
