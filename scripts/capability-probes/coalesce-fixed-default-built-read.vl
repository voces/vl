// A `??` over a read of a map whose values are built wider, defaulted to a parameter stored at its
// own record. `vl check` refuses it: "a `??` whose default is a parameter or an annotated binding,
// stored apart from the J a read of a container built wider holds, is not yet supported". The
// parameter typed `J` runs, and so does the map without a wider build. See D15241.
// Should print 4.
type J = { f: i32 | null }
function mk() { { f: 4 } }
const m = Map()
m.set("a", mk())
const wm: {[string]: J} = Map()
wm.set("a", mk())
function pick(d: { f: i32 }) { (m.get("a") ?? d).f }
print(pick({ f: 1 }))
