// A field read on a union narrowed by its NULL COMPLEMENT. `vl check` returns 0 and the emitter
// refuses with `emitProgram: narrowed receiver names no union variant`
// (`compiler/wasmEmit.vl:4162`). Should print 7.
//
// THE `| null` THIRD ARM IS THE INGREDIENT, ABLATED: `type U = A | B` with the same
// shared-field read compiles and runs; adding `| null` and narrowing with `u != null` refuses.
//
// MECHANISM. The null-complement narrowing banks the RENDERED SURVIVOR SET — the string
// `"A | B"` — as the narrowed variant. `memIsNarrowed` then answers true because that string is
// non-empty, `emitMem` routes to `emitNarrowedMem`, and `variantIndexOf("A | B")` is an exact
// string compare against the variant table, which holds `A` and `B` separately and no member
// spelled `"A | B"`. A path key banks the SPELLING, not the arena type.
type A = { k: i32, a: i32 }
type B = { k: i32, b: i32 }
type U = A | B | null
function f(u: U): i32 {
  if u != null { return u.k }
  0
}
const a: A = { k: 7, a: 1 }
print(f(a))
