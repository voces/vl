// A `u8[] | null` RETURN, annotated. The checker accepts it and the emitter floors with
// `emitProgram: bare null needs a struct-typed context` — a message that reads like an
// internal invariant and so is invisible to `goal-scoreboard.py --sites`, which only
// matches refusals whose WORDING concedes a capability gap (CLAUDE.md's D964 note).
// Should print 1 then 0.
//
// THE SIBLING SHAPES RUN, which is what makes this a gap and not a design rule: the same
// function with `i32[] | null`, `string[] | null` or `f64 | null` compiles and runs, and so
// does `u8[] | SomeStruct`. It is the `u8[]` element type against a NULL arm specifically —
// the residue of the "nullable lists beyond `i32[]|null`" hole `std-design.md` names.
//
// FOUND BY: `std:base64`, which wanted `decodeBase64(s): u8[] | null` for stage 0 of the
// serde program and ships `u8[] | Base64Error` instead. That module's header records the
// swap and says nothing there should change when this closes.
function head(s: string): u8[] | null {
  if s.length == 0 { return null }
  const out: u8[] = []
  out.push(s[0])
  out
}
const a = head("A")
if a is null { print(0) } else { print(a.length) }
const b = head("")
if b is null { print(0) } else { print(b.length) }
