// A plain struct holding a union ARM whose map field's value is a nullable ARM (`P | null`).
// `vl check` returns 0 and the emitter refuses with `emitProgram: map value type has no
// interned slot` at `Q`: the arm's own row finds no map slot for that value when `collectS`
// asks, while a non-null arm value and a record value both run (D15151). Should print 8.
type Q = { o: A }
type A = { n: i32, p: Map<string, P | null> }
type P = { m: i32 }
type U = A | P
const pm: Map<string, P | null> = Map()
pm.set("z", { m: 8 })
const q: Q = { o: { n: 1, p: pm } }
print(q.o.p.get("z")?.m ?? 0)
