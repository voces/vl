// D17824 — a `let` bound to a call of a lifted lambda mono splits per width has no storage width
// The IR refuses it as `cannot yet lower this statement (local rep...)`; the literal is `local
// rep `.
// Should print 3 then 4.
function add(a, b) { return a + b }
function app(g, s) { return g(s, s) }
function p5(h) {
  const run = (x) => app(h, x)
  let v = run(1.5)
  print(v)
  let u = run(2)
  print(u)
}
p5(add)
