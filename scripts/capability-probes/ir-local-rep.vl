// D17808 — two `const`s bound to calls of one lifted lambda at different widths in one frame
// are refused, and so is a `let` bound to one
// The IR refuses it as `cannot yet lower this statement (local rep...)`; the literal is `local
// rep `.
// Should print 3 then 4.
function add(a, b) { return a + b }
function app(g, s) { return g(s, s) }
function p5(h) {
  const run = (x) => app(h, x)
  const v = run(1.5)
  print(v)
  const u = run(2)
  print(u)
}
p5(add)
