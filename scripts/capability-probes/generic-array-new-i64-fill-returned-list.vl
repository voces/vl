// CLAUSE 1: `__array_new__` with an i64 fill, bound to a local and RETURNED as `T[]` from a
// generic, is check-clean INVALID WASM — `type mismatch: expected i32, found (ref $type)`
// inside `pick`, exit 70. The i32 and f64 pins both run, and returning the call directly
// rather than through a local runs, so the three ingredients are the `T[]` return, the
// intermediate local and the i64 pin. `arrNewIntrKind` recognises the i64 fill while the
// local's slot stays classified as the plain i32 list.
// Should print 1.
function pick<T>(v: T): T[] {
  const out = __array_new__(1, v)
  return out
}
function big(): i64 { 7 }
print(pick(big()).length)
