// A record literal holding a lambda, pushed into a list of records of un-annotated functions with
// different results: `vl check` returns 0 and emit refuses with `emitProgram: a lambda field value
// resolved to a non-closure field slot`. The lambda bound to a name first, or one result type,
// runs. See D16937. Should print 9.
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const xs = [{ f: inc0 }, { f: half }]
xs.push({ f: (x) => x * 3 })
print(xs[2].f(3))
