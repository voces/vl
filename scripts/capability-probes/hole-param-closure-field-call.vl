// A closure-valued FIELD called on a HOLE-typed (un-annotated) parameter. `vl check` returns 0
// and the module does not load — a clause-1 row, not a capability refusal, kept here because
// the probe runner is the standing instrument for "the type system accepts it and codegen
// does not build it".
// Reported by the owner, minimized by vl-b7, verified 2026-09-01. See D976.
// Should print ok.
const a = { f: () => "ok" }

function p2(x) { print(x.f()) }

p2(a)
