// A read-only covariant list delivered into a container that is never bound to a name of its
// own — the object literal is RETURNED, so there is no `const` for the alias closure to file
// the escaped list under. It was refused at the emitter with `emitProgram: covariant list
// delivery`; a returned literal is now reached through the CALL RESULT the closure already
// roots at, so the escape is filed under every destination `mk`'s calls deliver to and this
// program runs (D1682). What still refuses is a container the walk cannot reach a handle of:
// a call result delivered under no name at all (`covar-container-unconsumed-result.vl`).
// Should print 1.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box = { xs: Shape[] }
function __other() {
  const w: Shape[] = []
  w.push({ s: 3 })
  print(w.length)
}
function mk(b: Shape[]): Box { { xs: b } }
function f() {
  const a: Circle[] = [{ r: 7 }]
  const b: Shape[] = a
  const sf = mk(b)
  print(sf.xs.length)
}
f()
