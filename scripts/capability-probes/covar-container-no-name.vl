// A read-only covariant list delivered into a container that is never bound to a name of
// its own — the object literal is RETURNED, so there is no `const` for the alias closure to
// file the escaped list under. `vl check` returns 0 and the emitter refuses with
// `emitProgram: covariant list delivery: a ` … `[] cannot be delivered into a ` … `[] here.`,
// clause 2: nothing in this program writes either list, the element-converting copy is
// unobservable, and the copy exists (D791). The same program with the literal bound to a
// name and returned by that name runs. Should print 1.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box = { xs: Shape[] }
function __other() {
  const w: Shape[] = []
  w.push({ s: 3 })
  print(w.length)
}
function mk(b: Shape[]): Box { { xs: b } }
function f() {
  const a: Circle[] = [{ r: 7 }]
  const b: Shape[] = a
  const sf = mk(b)
  print(sf.xs.length)
}
f()
