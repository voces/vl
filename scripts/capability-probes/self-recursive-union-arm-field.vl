// A union ARM that is self-recursive through its own nullable field. `vl check` returns 0
// and the emitter refuses with `emitProgram: a struct field typed as the union ARM `A` has
// no field rep — give the field the UNION's own type, or declare the arm as a plain struct`
// — clause 2, and the refusal fires on the DECLARATION alone: the program never constructs
// an `A`. `collectVariantFields` codes the arm's fields and has no rep for a field whose
// type is the arm itself, while the same shape declared outside a union runs.
// Should print 3.
type A = { f: A | null, n: i32 }
type B = { m: i32 }
type U = A | B
function pick(u: U): i32 {
  if u is B { return u.m }
  return 0
}
const b: B = { m: 3 }
print(pick(b))
