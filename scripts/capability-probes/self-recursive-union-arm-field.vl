// A union ARM that is self-recursive through its own nullable field. It used to refuse at
// emit on the declaration alone, `emitProgram: a struct field typed as the union ARM `A` has
// no field rep`, because `collectVariantFields` codes the arm's fields before the arm has a
// struct row; the field now waits for that row as a field naming any declared record does
// (D3329). Should print 3.
type A = { f: A | null, n: i32 }
type B = { m: i32 }
type U = A | B
function pick(u: U): i32 {
  if u is B { return u.m }
  return 0
}
const b: B = { m: 3 }
print(pick(b))
