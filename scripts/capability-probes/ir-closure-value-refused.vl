// D16925 — a lambda's record or map result at a generic's `() => {v: T | boolean}` has no
// function-value signature
// The IR refuses it as `cannot yet lower this statement (closure value refused...)`; the
// literal is `closure value refused`.
// Should print 1.
function gen<T>(f: () => {v: T | boolean}) { return [f].length }
print(gen(() => ({ v: 3 })))
