// `.clear()` over every list rep `.pop()` already serves, at BOTH scopes.
//
// silent-class inventory D1131. `.pop()` runs at i32, string, boolean, ref, f64, f32, i64 and u8;
// `.clear()` ran at four of those and failed three different ways at the rest — and which way
// depended on the SCOPE of the receiver, which the row's own table did not vary:
//
//   f64[] / f32[]   at module scope  ->  emitProgram: .clear but list type not collected
//   i64[] / f64[] / f32[] / u8[]  in a function  ->  emitProgram: unsupported member-call
//                                                    statement   (the STATEMENT DISPATCHER,
//                                                    one stage earlier, naming nothing about
//                                                    lists)
//   i64[] / u8[]    at module scope  ->  check-clean INVALID WASM   (clause 1, TWO reps)
//   P[] / i32[][]   in a function    ->  emitProgram: a ref-element list op needs its
//                                        receiver's element type known before the body is
//                                        lowered
//
// D977 built the scalar ladder for `pop` only, and nothing asked `clear` the same question.
// The last of those four is a different mechanism from the rest: the ref-element scratch frame
// was resolved EAGERLY, for a value only a STAGING receiver ever reads, so a bare-local receiver
// — which needs no frame and correctly had none reserved — was refused. The tell is that
// `xs.clear()` alone refused while `xs.clear()` followed by `xs.push(…)` ran.
//
// Should print: 0 0 0 0 0 0 0 0 1 9

// ── module scope, every scalar rep ────────────────────────────────────────────
const a: f64[] = [1.5, 2.5]
a.clear()
print(a.length)

const b: u8[] = "ab".bytes()
b.clear()
print(b.length)

const c: i64[] = [1, 2]
c.clear()
print(c.length)

const d: f32[] = [1.5, 2.5]
d.clear()
print(d.length)

// ── inside a function body, where the statement dispatcher refused first ──────
function scalarsInFn() {
  const e: i64[] = [1, 2]
  e.clear()
  print(e.length)

  const f: f64[] = [1.5, 2.5]
  f.clear()
  print(f.length)
}

scalarsInFn()

// ── a REF-element list on a bare local, where the frame was resolved eagerly ──
type P = { n: i32 }

function refElemsInFn() {
  const g: P[] = [{ n: 1 }, { n: 2 }]
  g.clear()
  print(g.length)

  const h: i32[][] = [[1], [2]]
  h.clear()
  print(h.length)

  // The backing is RETAINED, so a refill reuses it: clear then push, then read the element
  // back, which is what proves the cleared wrapper is still the right heap type.
  g.push({ n: 9 })
  print(g.length)
  print(g[0].n)
}

refElemsInFn()
