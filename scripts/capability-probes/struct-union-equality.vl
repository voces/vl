// `==` over a STRUCT union (`A | B` of two object shapes). Struct equality itself works —
// `x == y` over a single declared shape prints `true` — and a VALUE union's `==` works too;
// only the struct-union combination refuses (`emitProgram: `==` over a struct union is not
// supported yet`). Unlike the other probes in this directory this one is not a lowering that
// exists and is unreached: it needs a tag dispatch over the variant arms with a per-arm struct
// compare underneath.
// Found 2026-09-01 by hand-probing the `--sites` ZERO rows.
// Should print true.
type A = { a: i32 }
type B = { b: i32 }

function mk(c: boolean): A | B {
  if c { return { a: 1 } }
  { b: 2 }
}

const u = mk(true)
const v = mk(true)
print(u == v)
