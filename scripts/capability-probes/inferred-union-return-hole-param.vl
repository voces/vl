// An INFERRED union return passed to an UN-ANNOTATED parameter. The checker infers the union
// perfectly well and `typecheck.vl` conceded the gap in as many words — "an inferred union
// return through an un-annotated parameter is not yet supported by codegen; annotate the
// return type" — one of the 22 capability literals `goal-scoreboard.py --sites` reports and
// no corpus cell reaches. Annotating `f`'s return makes the identical program run.
// Should print 1 then s.
function f(c: boolean) {
  if c { return 1 }
  "s"
}

function id(x) { x }

print(id(f(true)))
print(id(f(false)))
