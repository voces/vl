// A record value with a field no union arm declares, delivered into the union through a binding:
// width subtyping admits it at the arm it fits, and no arm copy drops the extra field. A plain
// record destination runs the same program (D1696, D3339). The nested spelling is D3566.
//
// Should print: 1 5 5
type A = { k: i32, legs: i64 }
type B = { s: string }
type Pet = A | B
type Box = { pet: Pet }
let n = 0
function f(): boolean {
  n = n + 1
  return true
}
function shallow(): Pet {
  const sv = { k: 1, legs: 4, purr: f() }
  return sv
}
function nested(): Box {
  const sv = { pet: { k: 1, legs: 4, purr: true } }
  return sv
}
const p = shallow()
print(n)
if p is A { print(p.legs + 1) }
const q = nested().pet
if q is A { print(q.legs + 1) }
