// A record value with a field no union arm declares, delivered into the union through a binding,
// where a field also changes width (`legs` is built `i32`, the arm stores `i64`): width subtyping
// admits it at the arm it fits, and no conversion both widens a field and drops one. A plain
// record destination refuses the same pair; a record whose fields begin with the arm's runs. The
// nested spelling is D3566.
//
// Should print: 1 5 5
type A = { k: i32, legs: i64 }
type B = { s: string }
type Pet = A | B
type Box = { pet: Pet }
let n = 0
function f(): boolean {
  n = n + 1
  return true
}
function shallow(): Pet {
  const sv = { k: 1, legs: 4, purr: f() }
  return sv
}
function nested(): Box {
  const sv = { pet: { k: 1, legs: 4, purr: true } }
  return sv
}
const p = shallow()
print(n)
if p is A { print(p.legs + 1) }
const q = nested().pet
if q is A { print(q.legs + 1) }
