// `==` in a generic body over a call operand whose instance type is a record stored apart from
// the other operand's: `vl check` returns 0 and emit refuses with
// `emitProgram: struct equality is not supported yet` (D16470).
// Should print true.
function id<T>(x: T): T { return x }
function eq<T, U>(a: T, b: U): boolean { return id(a) == b }
print(eq({ f: 1 }, { f: 1.0 }))
