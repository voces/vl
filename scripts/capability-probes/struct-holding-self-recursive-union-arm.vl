// A plain struct whose field is a union ARM that is self-recursive. It refused at emit with
// `emitProgram: a struct field typed as the union ARM `O` has no field rep` at `Q`'s field,
// because the arm's twin row, which `collectS` points the field at, was never minted for a
// recursive arm; the mint now closes the arm's cycle on the row itself (D15095).
// Should print 5.
type Q = { o: O | null }
type O = { n: i32, next: O | null }
type P = { m: i32 }
type U = O | P
const o: O = { n: 1, next: { n: 5, next: null } }
const q: Q = { o: o }
if q.o != null {
  if q.o.next != null { print(q.o.next.n) }
}
