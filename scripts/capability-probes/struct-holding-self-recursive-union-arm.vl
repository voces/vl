// A plain struct whose field is a union ARM that is self-recursive. `vl check` returns 0 and
// the emitter refuses with `emitProgram: a struct field typed as the union ARM `O` has no
// field rep` at `Q`'s field: the arm builds and runs on its own (D3329), but the struct
// row `collectS` looks for, the arm's minted twin, is never minted for a recursive arm
// (D15095). Should print 5.
type Q = { o: O | null }
type O = { n: i32, next: O | null }
type P = { m: i32 }
type U = O | P
const o: O = { n: 1, next: { n: 5, next: null } }
const q: Q = { o: o }
if q.o != null {
  if q.o.next != null { print(q.o.next.n) }
}
