// `==` between a union box and an UN-ANNOTATED concrete operand of one of its arms, in a
// file that also declares an inline shape structurally identical to that arm.
//
//   emitProgram: `==` over a struct union is not supported yet
//
// `vl check` returns 0, so this is a clause-2 violation by construction. silent-class
// inventory D1099.
//
// THE INGREDIENT IS THE SECOND DECLARATION, NOT THE MISSING ANNOTATION. Delete `type N`
// and the same un-annotated `const a = { x: 1 }` compares and prints `true`; add `a: A`
// back and it runs with `N` present. Nothing has to USE `N` — declaring it is enough, so
// the ingredient is what the declaration does to the shape tables, not any flow through it.
//
// This is D962/D969's shape one function further in: the annotation PINS the operand's
// rep, so the defect lives only in the inferred spelling and a fixture that annotates every
// destination cannot see it.
//
// Should print true then false.
type A = { x: i32 }
type N = { inner: { x: i32 } }

function mk(n: i32): A | i32 {
  if n == 0 { return 5 }
  { x: n }
}

const p = mk(1)
const same = { x: 1 }
const diff = { x: 2 }
print(p == same)
print(p == diff)
