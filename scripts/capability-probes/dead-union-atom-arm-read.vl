// A generic `is`-atom arm whose atom the union T cannot hold: the test is
// constant-false, the checker accepts the program, and the emitter refuses the
// dead arm's read because no module union minted the i64 value box (inventory
// D947; std/test.vl routes around it by declaring a five-atom alias).
// Should print o.
function istr(v: i64) {
  if v == 0 { return "0" }
  "n"
}

function f<T>(x: T): string {
  if x is i64 { return istr(x) }
  "o"
}

const u: i32 | string = 4
print(f(u))
