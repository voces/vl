// A call in STATEMENT position whose callee is an element read. `vl check` returns 0 and the
// emitter refused with `emitProgram: bare call statement is not supported` — a message naming
// the arm that fired rather than the feature, since nothing here is a bare call statement.
//
// Two ladders decide statement position and each had arms for exactly a `Member` callee and
// an `Ident` callee: `stmtIsTailValue`, which routes a tail value to `emitReturnExit`, and
// `emitCallStmt`, which lowers a genuine statement. An `Index`, `Call` or `Paren` callee is
// claimed by neither. Neither the capture nor the container is an ingredient — `(f)(n)` with
// no container at all refused identically, and so did the same call with no capture. See
// D1623. Should print 55.
function go() {
  const xs = [(n: i32) => n + 5]
  const g = (n: i32) => xs[0](n)
  print(g(50))
}
go()
