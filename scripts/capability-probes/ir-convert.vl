// D17773 — a record a call returns holding a map of a tagged set, beside one holding a map of
// closures at the same signature, is refused at emit
// The IR refuses it as `cannot yet lower this statement (convert...)`; the literal is `convert
// `.
// Should print 4 then 6.
const f = (a) => a + 1
const hm = Map()
hm["k"] = f
function mk() { return { m: hm } }
const y = mk().m["k"]
if y != null { print(y(3)) }
const g1 = (a) => a + 1
const g2 = (a) => a * 2
const tm = Map()
tm["k"] = g1
tm["j"] = g2
function mkt() { return { m: tm } }
const yt = mkt().m["j"]
if yt != null { print(yt(3)) }
