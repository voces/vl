// A union whose arm is a list of maps, built from a literal and narrowed back. The refusal
// "emitProgram: a union arm that is an array-of-map is not yet supported" names this shape;
// the plainest program it forbids runs.
// Should print 7.
type U = {[string]: i32}[] | i32
const m: {[string]: i32} = Map()
m.set("k", 7)
const u: U = [m]
if u is {[string]: i32}[] { print(u[0].get("k") ?? 0) } else { print(u) }
