// One un-annotated list literal reaching two containers whose ELEMENTS are stored
// differently. Type-valid (i32 widens to f64); no element-converting copy exists.
// Should print 0.
function take_i(xs: i32[]): i32 { return xs.length }
function take_f(xs: f64[]): i32 { return xs.length }
const e = []
print(take_i(e) + take_f(e))
