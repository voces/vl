// One un-annotated list literal reaching two containers whose ELEMENTS are stored
// differently. Only a `readonly` list is covariant, so the `f64[]` side is a read-only view,
// which the element-converting copy serves.
// Should print 0.
function take_i(xs: i32[]): i32 { return xs.length }
function take_f(xs: readonly f64[]): i32 { return xs.length }
const e = []
print(take_i(e) + take_f(e))
