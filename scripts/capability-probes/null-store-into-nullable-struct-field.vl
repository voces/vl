// D1568 — `w.f = null` over a field declared `C | null`. `emitObjField` seeds
// `pendingStructIdx` from `sFieldTgtStructIdx` for a code-15 (nested-struct /
// nullable-struct) field, so the CONSTRUCT spelling `{ f: null }` lowers; the field-WRITE
// arm of `emitAssign` — the other half of every field code — never seeded it, so the `null`
// reached `emitNullLitNode` with every seed unset: `emitProgram: bare null needs a
// struct-typed context` after a clean `vl check`.
//
// Left LOUD by D1563 (#2497): before it, the leaked `pendingVariantIdx` papered this over
// with the WRONG heap type wherever an arm-typed global happened to have armed it.
//
// The store is graded in BOTH directions — null over a value, then a value over the null —
// so a cell that took the wrong heap type cannot pass by reading back null.
// Should print none then 7.
type C = { a: i32, b: i32 }
type W = { f: C | null }

const w: W = { f: { a: 1, b: 2 } }
w.f = null
if w.f != null { print(w.f.a) } else { print("none") }

w.f = { a: 7, b: 8 }
if w.f != null { print(w.f.a) } else { print("none") }
