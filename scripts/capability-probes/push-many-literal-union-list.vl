// A variadic `.push` onto a literal-union list. The one-argument push runs; two arguments, or a
// spread, take the bulk path, which refuses every nullable or literal-union element list with
// `emitProgram: a nullable or literal-union list takes one `.push` argument at a time`
// (`emitPushMany`, `wasmEmit.vl`) after `vl check` returned 0 (D4553). Should print 3.
type K = "a" | "b"
const xs: K[] = ["a"]
xs.push("a", "b")
print(xs.length)
