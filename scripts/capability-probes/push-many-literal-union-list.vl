// A variadic `.push` onto a literal-union list. The one-argument push ran; two arguments, or a
// spread, took the bulk path, which refused every nullable or literal-union element list after
// `vl check` returned 0. The bulk path now builds its argument run under the element seeds the
// one-argument push gives its value (D4553). Should print 3.
type K = "a" | "b"
const xs: K[] = ["a"]
xs.push("a", "b")
print(xs.length)
