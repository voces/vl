// `==` between a RECURSIVE union value (the `std:json` tree — six arms, two of them
// containers of itself) and a string literal. D973 closed `==` over a struct union whose
// arms are plain object shapes; a union carrying a LIST or MAP arm still takes the loud
// refusal (`emitProgram: `==` over a struct union is not supported yet`), and `Json` has
// both. This is on the critical path of every round-trip test a JSON consumer writes
// (`parsed == "b"`, `obj["k"] == 1.0`) and is why the usability critique's consumer
// programs carry a hand-written `deepEquals` (`docs/internals/json-critique-usability.md`
// F4). Scalar-vs-scalar over the tree is what the literal operand asks for; the container
// arms only need a tag mismatch to answer `false`.
// Found 2026-09-01 by the `std:json` usability critique.
// Should print true.
type Json = null | boolean | f64 | string | Json[] | { [string]: Json }

function mk(c: boolean): Json {
  if c { return "b" }
  2.5
}

const v = mk(true)
print(v == "b")
