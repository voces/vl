// A map whose value is a 128-bit vector. `vl check` refuses it: "holds a 128-bit vector inside
// an array or map, which has no lowering yet", while a list of vectors runs. See D16891.
// Should print 2.5.
const v = __splat_f32x4__(2.5)
const m: {[string]: v128} = Map()
m.set("a", v)
const g = m.get("a")
if g != null { print(__extract_lane_f32x4__(g, 1)) }
