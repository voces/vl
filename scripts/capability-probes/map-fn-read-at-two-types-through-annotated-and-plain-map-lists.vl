// An un-annotated function stored in two maps, one map an element of an annotated list literal of
// maps of `(a: f64) => f64` and the other an element of an un-annotated list literal through which
// it is called at `i32`: the second list holds its map at that map's pinned type. See D15757.
// Should print 3.
function half(a) { return a / 2.0 }
const m1 = Map()
m1.set("a", half)
const m4 = Map()
m4.set("a", half)
const ys = [m4]
const v: ({ [string]: (a: f64) => f64 })[] = [m1]
const g = v[0].get("a")
const h = ys[0].get("a")
if g != null && h != null { print(g(3) + h(3)) }
