// Two start-function locals of ONE name — a module-scope `for n` loop variable and a `const n`
// declared in a sibling top-level block. `vl check` returns 0 and the module does not validate
// (`unknown local N: local index out of bounds`): a clause-1 row.
//
// `emitStartFnCode` collects the start function's locals and THEN detects its scratch frames,
// with the scope stack empty — so `declaredSlotOf` falls back to a flat first-match-by-name
// scan and hands the block's read the LOOP VARIABLE's i32 slot. `print(n.msg)` is then not seen
// as a string op, the string frame goes unreserved, and the body `local.set`s into locals the
// vector never declared. Adding any unambiguous top-level string op (`const pad = "x" + "y"`)
// makes it run, which is what identifies the missing frame.
//
// CLOSED by D1595: the detection now asks its question once per same-named candidate slot and
// ORs the flags, so a shadowed name reserves every frame any of its bindings needs. The
// sibling half — a read TYPED through the wrong binding — was D1593.
// Should print 0 then 1 then hi.
type E = { msg: string }

function pick(k: i32): i32 | E {
  if k < 0 { return { msg: "hi" } }
  return 7
}

for n in 0 to 1 { print(n) }

if true {
  const n = pick(0 - 1)
  if n is E { print(n.msg) } else { print(n) }
}
