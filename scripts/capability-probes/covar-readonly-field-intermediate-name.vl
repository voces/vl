// A read-only covariant list stored in a container FIELD typed `readonly T[]`, then read back
// through an intermediate name (`q = o.inn`). The covariant-write closure ends at a read-only
// parameter and nowhere else, so the field files an escape it cannot follow, the copy's
// licence is unknown, and the emitter refuses with `emitProgram: covariant list delivery: a `
// … `[] cannot be delivered into a ` … `[] here.` (D1806). Should print 1.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Inner = { xs: readonly Shape[] }
type Outer = { inn: Inner }
function __other() {
  const w: Shape[] = []
  w.push({ s: 3 })
  print(w.length)
}
function f() {
  const a: Circle[] = [{ r: 7 }]
  const b: readonly Shape[] = a
  const o: Outer = { inn: { xs: b } }
  const q = o.inn
  print(q.xs.length)
}
f()
