// A generic `T[]` constructor over `__array_new__`, pinned at an `f64[]` element. The
// direct spelling (`const a: f64[][] = __array_new__(2, s)`) RUNS, so this is the pin's
// own face: inside a monomorphized instance the fill is a parameter, and
// `arrNewIntrKind`'s ladder has no arm that recognises a wide-scalar list there, so it
// falls through to the i32 list and `array.new` gets a ref where it wants an i32.
// `i64[]` and `u8[]` elements are the same cell; a `Node[]`, `i32[]` or `string[]`
// element resolves and runs. Should print 1.5.
function filled<T>(n: i32, v: T): T[] { return __array_new__(n, v) }

const seed: f64[] = [1.5]
const rows: f64[][] = filled(2, seed)
print(rows[1][0])
