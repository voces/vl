// The same if-EXPRESSION as `if-expr-nullable-ref-arms.vl`, in a module that also DECLARES
// `type R = Hit | Miss`. `vl check` returned 0 and the emitter refused with `emitProgram: ref
// valtype with no interned shape` — at the ANNOTATED spelling as well as this one (D1560;
// reported by the glean session as VL-025, whose MPQ reader hit this face). Should print h.
//
// ONE DECLARATION IS THE WHOLE ABLATION. `Hit`'s heap moves from `sHeapIdx` to `uVarHeap` the
// moment it is a union member, so the struct fallback claimed a kind whose slot resolves to
// -1 and `fbValtype` floored before any `null` was written. `R` is never USED here.
//
// WHY IT REFUSED AT BOTH SPELLINGS while the plain-struct face refused only un-annotated:
// there the annotation was enough to pin the binding, and the join's own kind still resolved;
// here the join had no variant rung at all, so the annotation had nothing to agree with.
type Hit = { msg: string }
type Miss = { why: string }
type R = Hit | Miss
function mkA(ok: boolean): Hit | null {
  if ok { return null }
  return { msg: "h" }
}
function mkB(ok: boolean): Hit | null {
  if ok { return null }
  return { msg: "i" }
}
function pick(flag: boolean, ok: boolean) {
  const v = if flag { mkA(ok) } else { mkB(ok) }
  if v != null { return v.msg }
  "ok"
}
print(pick(true, false))
