// A generic struct FIELD holding a union with a LIST member: the checker accepts
// the store of `string | i32[]` into `actual: T`, and the emitted constructor is
// invalid wasm (`type mismatch: expected (ref $type), found (ref $type)` in
// `expect`). The bare store is the whole recipe — no ladder, no closure, no
// second instantiation. Found 2026-08-31 grading std:test v2's union receivers
// past the D947 route-around; under v1's atom union the shape was a loud check
// refusal.
// Should print p.
type Expectation<T> = {
  actual: T,
  negated: boolean
}

function expect<T>(value: T): Expectation<T> {
  return { actual: value, negated: false }
}

function pick(b: boolean): string | i32[] {
  if b { return "s" }
  [1, 2]
}

const e = expect(pick(true))
if e.negated { print("n") } else { print("p") }
