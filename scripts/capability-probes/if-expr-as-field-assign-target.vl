// An if-expression as the RECEIVER of a field assignment, in a module whose every declared
// type is a union arm. `vl check` returns 0 and the emitter refuses with `emitProgram: field
// assignment but no struct type declared` — clause 2. `sDeclared` stays false because
// `collectS` skips arm declarations, and `exprVariantIndex` has arms for `Paren`, `AsExpr`,
// `Ident`, `Call`, `Index` and `??` but none for an `IfStmt` receiver. Every other receiver
// form runs: an ident, a parameter, a loop variable, `xs[0]`, `mk()`, a nested arm field.
// Should print 5.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq

const a: Circle = { r: 1 }
const b: Circle = { r: 2 }

function go(c: boolean): i32 {
  (if c { a } else { b }).r = 5
  return a.r
}
print(go(true))
