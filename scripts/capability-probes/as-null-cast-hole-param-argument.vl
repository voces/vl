// D1371 — `a as? i32` on a HOLE parameter, delivered as an ARGUMENT. `vl check` returns 0 and
// the engine refuses the module: the cast's result type is recorded as `T | null` by
// `castPinAdjudicate` at the call that PINS the hole (D1341), which is strictly after the
// hole's own body was checked — so the argument compare inside that body adjudicated the cast
// at the pre-pin type `i32` and passed. The box then goes straight into an `i32` parameter.
//
// The annotated `function take(a: i32 | null)` twin is the loud
// `argument 1: expected i32, got i32 | null`. The other three deliveries — statement, binding,
// return — all run, because their consumers read the node type at EMIT time, after the
// re-record. The general shape is the checker's one-body-many-pins limit; the two standing
// repairs (`noteArgCstr`'s deferred re-validation, `monoRecheckBegin`'s pinned re-check) both
// exist and neither is wired to the cast rung.
// Should print 5.
function id(x: i32): i32 { return x }
const u: i32 | null = 5

function take(a) { print(id(a as? i32)) }

take(u)
