// `===` is reference identity over records (DECISIONS A15): one record compared with itself is
// identical, and a structurally equal record built elsewhere is not. The checker accepts it and
// the emitter refuses it: `emitProgram: reference identity (`===` / `!==`) is not lowered yet`
// (D15975).
// Should print true, then false.
type P = { x: i32 }

function same(a: P, b: P): boolean { return a === b }

const p: P = { x: 1 }
const q: P = { x: 1 }
print(same(p, p))
print(same(p, q))
