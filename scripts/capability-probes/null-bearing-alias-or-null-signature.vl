// A union alias that ALREADY carries `null`, composed with `| null` again in a signature —
// `function first(self: Json): Json | null`, the accessor shape every JSON consumer writes
// first ("the element, or nothing"). `vl check` accepts it (rc 0) and the emitter refuses
// with `emitProgram: bare null needs a struct-typed context`: the alias expands to a union
// that names `null` twice, and the duplicate atom leaves the `return null` with no arm to
// land in. The same root as D1024 (`string | "err"`, which builds INVALID wasm instead of
// refusing) — a duplicate atom after alias expansion. The non-duplicating spelling
// (`: Json`) runs. Filed as D1026; the language question underneath (collapse the subsumed
// arm, or keep it) is `docs/json-design.md` §6 question 3.
// Found 2026-09-01 measuring the `std:json` v1 surface against its critiques.
// Should print 1.5 then true.
type Json = null | boolean | f64 | string | Json[] | { [string]: Json }

function first(self: Json): Json | null {
  if self is Json[] {
    if self.length > 0 { return self[0] }
  }
  return null
}

const arr: Json[] = [1.5, "x"]
const r = first(arr)
if r is f64 { print(r) }
print(first(null) == null)
