// A RECURSIVE union alias that ALREADY carries `null`, composed with `| null` again in a
// signature — `function first(self: Json): Json | null`, the accessor shape every JSON
// consumer writes first ("the element, or nothing"). `vl check` accepts it (rc 0) and the
// emitter refuses with `emitProgram: bare null needs a struct-typed context`, reported at
// the SIGNATURE. Filed as D1026 with a witness that dropped the recursion (`type P = null |
// f64`); #2312 closed THAT witness by folding `(T | null) | null` at `mkNullableTy` — and
// this probe, which kept the headline shape, still refused on the merged seed. The residue
// is D1027: recursion AND null membership together (either alone runs), which is D1021's
// mechanism — a recursive alias composed into a wider union stays an opaque atom with no
// member table — with `null` as the composed arm. Expected to close with D1021 route (1).
// The `: Json` control runs (1.5 / true).
// Found 2026-09-01 measuring the `std:json` v1 surface against its critiques; re-graded
// the day D1026 merged.
// Should print 1.5 then true.
type Json = null | boolean | f64 | string | Json[] | { [string]: Json }

function first(self: Json): Json | null {
  if self is Json[] {
    if self.length > 0 { return self[0] }
  }
  return null
}

const arr: Json[] = [1.5, "x"]
const r = first(arr)
if r is f64 { print(r) }
print(first(null) == null)
