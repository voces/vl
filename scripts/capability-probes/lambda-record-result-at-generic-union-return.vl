// An un-annotated lambda returning a record, handed to a generic's parameter `() => T | string`:
// `vl check` returns 0 and emit refuses with `emitProgram: ref valtype with no interned shape`,
// at no position. The record value is delivered into a union box the program never registers.
// See D14082 (and D15158, whose positionless witness this is). Should print 7.
type P = {a: i32}
const p: P = { a: 1 }
function len<T>(f: () => T | string) { 7 }
print(len(() => p))
