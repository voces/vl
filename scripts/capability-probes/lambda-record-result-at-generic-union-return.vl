// An un-annotated lambda returning a record, handed to a generic's parameter `() => T | string`:
// the record is boxed in the instance's `P | string`, a union no annotation spells. See D14082.
// Should print 7.
type P = {a: i32}
const p: P = { a: 1 }
function len<T>(f: () => T | string) { return 7 }
print(len(() => p))
