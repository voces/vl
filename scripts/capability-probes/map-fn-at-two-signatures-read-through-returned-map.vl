// An un-annotated function stored in two maps, one map in an annotated list literal of maps of
// `(a: f64) => f64` and the other returned by a function and called through at `i32`: the call's
// result holds the second map at its pinned type. See D15758.
// Should print 3.
function half(a) { return a / 2.0 }
const m1 = Map()
m1.set("a", half)
const m4 = Map()
m4.set("a", half)
const ws: ({ [string]: (a: f64) => f64 })[] = [m1]
const g = ws[0].get("a")
function mk() { return m4 }
const h = mk().get("a")
if g != null && h != null { print(g(3) + h(3)) }
