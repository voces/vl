// A `.map` whose callback arrives as a BINDING rather than a function name, with an i64
// result, then an indexed assignment into it. `vl check` returns 0 and the emitter refuses
// with `emitProgram: i64 indexed assignment but i64 list type not collected` — clause 2.
// `collectMapFilterUse` classifies the result through `mfCallbackFe`, which resolves a
// lifted function only, so a `const` binding of the callback (or a function-typed
// parameter) leaves `ia64Used` false while the emitter still resolves the result to i64.
// D1088 wired the direct-callback face: `xs.map(toI)[0] = v` runs today, this does not.
// Should print 1.
function toI(n: i32): i64 { return 5 as! i64 }
function main() {
  const cb = toI
  const xs = [1, 2]
  xs.map(cb)[0] = 7 as! i64
  print(1)
}
main()
