// A `.map` whose callback arrives as a BINDING rather than a function name, with an i64
// result, then an indexed assignment into it. `collectMapFilterUse` reads a function-value
// callback's result list off the call's recorded `i64[]`, so the i64 list is collected.
// Should print 1.
function toI(n: i32): i64 { return 5 as! i64 }
function main() {
  const cb = toI
  const xs = [1, 2]
  xs.map(cb)[0] = 7 as! i64
  print(1)
}
main()
