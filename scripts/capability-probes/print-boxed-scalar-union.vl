// `print` of boxed scalar unions: a float, an `i64` and `null`; a literal union with `null`; a
// boolean and a float. The refusal ") is type-valid but not yet supported by codegen — narrow
// it first" names a boxed union with an arm print cannot read; the plainest programs it
// forbids run.
// Should print 3 then 3 then true.
const v: f32 | i64 | null = 3 as i64
print(v)
const l: "a" | 3 | null = 3
print(l)
const b: boolean | f64 = true
print(b)
