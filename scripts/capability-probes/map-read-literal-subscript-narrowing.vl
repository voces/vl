// NARROWING A LITERAL MAP SUBSCRIPT — silent-class-inventory D1025:
//
//   cannot assign string | f64 | null to 'z' of type string
//
// A literal subscript is a stable PLACE exactly as `xs[0]` is, so `if m["a"] is string`
// narrows the CELL and the annotated read is legal. The STRING-literal spelling minted no
// narrowing key at all, so the checker refused this — a clause-2 refusal of a program the
// design permits, and the one every `{[string]: Json}` consumer meets (the json usability
// critique's "gap A"; its consumer programs hoist every `obj["k"]` read into a local
// precisely because of this).
//
// The INTEGER-literal spelling was the clause-1 half of the same gap: it minted a key, the
// checker narrowed it, and the emitter still lowered the raw `(ref null)` map get.
//
// Should print 3 then 1.25.
const m: { [string]: string | f64 } = Map()
m["a"] = "abc"

if m["a"] is string {
  const z: string = m["a"]
  print(z.length)
}

const n: { [i32]: string | f64 } = Map()
n[1] = 2.5

if n[1] is f64 { print(n[1] / 2.0) }
