// A call's fresh record beside a list element built at a record whose field is a nullable
// function: `vl check` refuses with `this record, returned by a call, is fresh and type-valid
// here, but not supported yet`. The call's result is fresh, so the list could copy it (D16392).
// Should print 2.
type J = { f: (() => i32) | null }
function mk() { return { f: () => 4 } }
const wideJ: J = mk()
const xs = [mk()]
function os0() { return { f: () => 1 } }
const ws = [xs[0], os0()]
print(ws.length)
