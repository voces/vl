// A plain struct holding a union ARM whose map field's value is a declared record. The arm's
// twin row is decided from the record-row class before the map slots exist (D15098). Should
// print 7.
type R = { r: i32 }
type Q = { o: A }
type A = { n: i32, g: Map<string, R> }
type P = { m: i32 }
type U = A | P
const g: Map<string, R> = Map()
g.set("x", { r: 7 })
const q: Q = { o: { n: 1, g: g } }
print(q.o.g.get("x")?.r ?? 0)
