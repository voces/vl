// A plain struct holding a union ARM whose map field's value is a declared record. `vl check`
// returns 0 and the emitter refuses with `emitProgram: map value type has no interned slot` at
// `Q`: the arm's twin row is minted from a render that spells `R` by its shape, the arm's own
// row by its name, and the two key different map slots (D15098). Should print 7.
type R = { r: i32 }
type Q = { o: A }
type A = { n: i32, g: Map<string, R> }
type P = { m: i32 }
type U = A | P
const g: Map<string, R> = Map()
g.set("x", { r: 7 })
const q: Q = { o: { n: 1, g: g } }
print(q.o.g.get("x")?.r ?? 0)
