// A literal-union ALIAS discriminant beside a BARE single literal — `{kind: K1}` next to
// `{kind: "a"}` — the one-member spelling of the pair D1050 unified. D1023's ruling calls it
// legal (both arms carry a string literal set, so `is` is a question about the VALUE) and the
// checker agrees, so `vl check` returned 0 and the emitter then refused.
//
// THE MEMBER COUNT WAS NEVER THE REP'S QUESTION, the arena SHAPE was. D1050's bound was
// written as "a 2+-member set" because `tyIsLitUnion` declines a bare `TyLit`, while the ALIAS
// spelling of the same one-member set (`type KC = "a"`) has carried the interned atom all
// along. `tyIsLitUnionOrLit` asks what the rep actually needs — a STRING literal set, of any
// size — and the promotion serves it.
//
// CLOSED BY D1460, and the probe stays as the pin. Its sibling
// `litunion-mixed-arm-with-base-partner.vl` is the pair whose partner is the whole BASE type,
// which is a different question: an arbitrary string has no interned id at all.
// Should print circle then a.
type K1 = "circle" | "round"
type A = { kind: K1, r: f64 }
type B = { kind: "a", r: f64 }
function f(n: i32): A | B {
  if n == 0 { return { kind: "circle", r: 1.0 } }
  const v: B = { kind: "a", r: 2.0 }
  return v
}
const a = f(0)
if a is A { print(a.kind) } else { print("notA") }
const b = f(1)
if b is B { print(b.kind) } else { print("notB") }
