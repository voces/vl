// `===` over a union whose arms are a record and a function (D16039): every arm has an identity
// under DECISIONS A15, a record's by `ref.eq` and a function's by declaration and environment,
// but no per-arm identity core exists yet, so the checker refuses it.
// Should print true then false.
type P = { x: i32 }
function inc(i: i32) { return i + 1 }
const p: P = { x: 1 }
const u: P | ((i: i32) => i32) = p
const v: P | ((i: i32) => i32) = inc
print(u === u)
print(u === v)
