// A closure taking a UNION, called through a generic's function-value parameter. `vl check`
// returns 0 and the emitter refuses with `emitProgram: value-call union parameter has no
// resolvable union name` — clause 2. Four neighbouring closure deliveries run: a struct-field
// closure `h.f(3)`, a closure-array element `fs[0](3)`, a returned closure `mk()(3)`, and a
// literal-union-mixed parameter — so the refusal is the generic pin losing the union's name,
// not a rule about calling a union-taking closure.
// Should print 1.
type U = i32 | string

function call2<T>(f: (T) => i32, x: T): i32 { f(x) }

const g: (U) => i32 = (u) => 1
const v: U = 3
print(call2(g, v))
