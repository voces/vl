// Spreads of scalar lists into union and nullable element lists. The refusal "element has no
// lowering yet; build the source list at the literal's element type" names a spread whose
// elements must each be boxed; the plainest programs it forbids run.
// Should print 3 then 2 then 1.5 then 2.
const a = [1, 2]
const b: (i32 | string)[] = [...a, "x"]
print(b.length)
const c: (i32 | null)[] = [...a]
print(c.length)
const fs = [1.5]
const fb: (f64 | boolean)[] = [...fs]
const e = fb[0]
if e is f64 { print(e) }
const s = ["p"]
const d: (string | i32)[] = [...s, ...fs.map((_x) => 3)]
print(d.length)
