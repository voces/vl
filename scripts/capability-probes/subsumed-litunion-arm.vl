// The RULING'S MIRROR HALF — a literal-union ALIAS beside its own base (`Kind | string`),
// where D1024's probe covers a BARE literal beside its base (`string | "err"`).
// silent-class-inventory D1048, closed 2026-09-02.
//
// A union is a set of values and an arm that adds no values adds no arm, so `Kind | string`
// is `string` exactly as `"err" | string` is. Before the collapse the litunion arm rode the
// box as its member STRING and shared the `string` atom's slot, so a `Kind | string`
// PARAMETER was `vl check` rc 0 followed by
// `type mismatch: expected (ref $type), found (ref $type)` at offset 254 — check-clean
// invalid wasm, and the same at a module GLOBAL, at a `+` operand and at a generic pin.
//
// IT TOOK TWO PRODUCERS AND THAT IS THE PROBE'S REAL SUBJECT. The arena projection
// (`homogLitUnionBase` inside `armLiteralBaseTy`) is one line and, alone, it is a
// `runs → not-runs` veto: canon's union arm PRESERVED the litunion arm (`litUnionPreserve`,
// and `mixedUnionLitAliasRegroup` for the inline spelling), so the arena said `string` while
// the spelling still said `Kind|string` and the emitter reserved a union box for a
// plain-string binding. Canon's half alone is the same veto from the other side, and it
// additionally answers `x is Kind` TRUE for the non-member `"zz"`.
//
// THE `is` ARMS ARE THE HALF THAT MUST DISCRIMINATE, not merely compile. `Kind | string` IS
// `string`, so `x is Kind` is membership over the payload — TRUE for `"a"`, FALSE for `"zz"`
// — and `x is string` is TRUE for both. A collapse that produced a rep the `is` could not
// read would still print something.
//
// THE CONTROLS ARE HERE BECAUSE THE RULE MUST NOT EAT THEM. `Kind | i32` and `Kind | null`
// carry no `string` ARM, so neither collapses: the first stays a genuine two-arm box whose
// tag decides `is Kind` exactly, the second stays the atom niche.
//
// Should print zz then a then K then S then S then S then box-K then niche-K.

type Kind = "a" | "b"

function mirror(x: Kind | string): string { x }
print(mirror("zz"))
print(mirror("a"))

function isK(x: Kind | string, hit: string, miss: string) {
  if x is Kind { print(hit) } else { print(miss) }
  0
}
isK("a", "K", "S")
isK("zz", "K", "S")

function isS(x: Kind | string, hit: string, miss: string) {
  if x is string { print(hit) } else { print(miss) }
  0
}
isS("a", "S", "N")
isS("zz", "S", "N")

// CONTROL — a `Kind | i32` box does not collapse and its tag still answers exactly.
function boxed(x: Kind | i32) {
  if x is Kind { print("box-K") } else { print("box-i") }
  0
}
boxed("b")

// CONTROL — a `Kind | null` niche does not collapse either.
const n: Kind | null = "a"
if n is Kind { print("niche-K") } else { print("niche-N") }
