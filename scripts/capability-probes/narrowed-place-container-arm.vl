// An `is` narrowing whose receiver is a struct FIELD or an ARRAY ELEMENT, delivered at a
// container arm. The narrow IS banked under a path key (`n.v`, `xs[0]`); every consumer took a
// `name: string` and asked about an identifier, so the emitter worked against the DECLARED
// union and refused at whichever consumer came first — four sentences for one lost fact
// (`unsupported for-in iterable`, `narrowed union field atom has no value box`, `index access
// but array type not collected`, `callee is not a function name`). Hoisting the read into a
// local before the `if` made all four run, which is what made it ONE row. See D1014.
//
// The three legs are the three deliveries a box can need — a scalar-element list atom (the
// list-WRAPPER cast), a ref-element list and a map (each the arm's own `ref.cast`) — at the
// two non-identifier receivers. Every leg is un-annotated at its destination.
// Should print 4 then 4 then a.
type K = f64 | K[]
type Node = { v: K }
type M = f64 | { [string]: M }
type MapNode = { mv: M }

const node: Node = { v: [2.5, 4.0] }
if node.v is K[] {
  for e in node.v {
    if e is f64 {}
  }
  const bound = node.v
  const at = bound[1]
  if at is f64 { print(at) }
}

const cells: K[] = [[2.5, 4.0]]
if cells[0] is K[] {
  const ce = cells[0][1]
  if ce is f64 { print(ce) }
}

const seed: { [string]: M } = Map()
seed["a"] = 2.5
const mnode: MapNode = { mv: seed }
if mnode.mv is { [string]: M } {
  for k in mnode.mv.keys() { print(k) }
}
