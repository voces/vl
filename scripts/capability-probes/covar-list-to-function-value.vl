// A read-only covariant list handed to a `function` VALUE. The argument edge resolved a
// callee through the name-keyed index of DECLARED functions, and a lambda is a nameless
// `FuncDecl` no index files, so the delivery was refused at the emitter. The lambda a
// once-bound `const` was initialised with is in the arena, so the edge reads its parameter
// list directly and this program runs (D1683). What still refuses is a callee whose parameter
// list the program does not spell — a function-typed parameter
// (`covar-callee-function-typed-param.vl`). Should print 1.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function __other() {
  const w: Shape[] = []
  w.push({ s: 3 })
  print(w.length)
}
function f() {
  const a: Circle[] = [{ r: 7 }]
  const b: Shape[] = a
  const take = (ys: Shape[]) => {
    print(ys.length)
  }
  take(b)
}
f()
