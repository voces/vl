// A read-only covariant list handed to a `function` VALUE. The covariant-write closure
// resolves a callee by name to a declared `function`, so a lambda's parameter list is one
// it cannot read and the argument edge ends there. `vl check` returns 0 and the emitter
// refuses the element-converting copy; naming the same body `function take(ys: Shape[])`
// makes the identical program run, which is what makes this a capability gap and not the
// design's covariant-write rule. Should print 1.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function __other() {
  const w: Shape[] = []
  w.push({ s: 3 })
  print(w.length)
}
function f() {
  const a: Circle[] = [{ r: 7 }]
  const b: Shape[] = a
  const take = (ys: Shape[]) => {
    print(ys.length)
  }
  take(b)
}
f()
