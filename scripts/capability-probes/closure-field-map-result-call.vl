// A closure FIELD whose RESULT is a MAP, called through the parameter that carries it. `vl
// check` returns 0 and the module does not load: `unknown local 3: local index out of bounds`
// in the callee — the map result's scratch local is never declared in the frame that reads it.
// A clause-1 row.
//
// NOT the inline-vs-alias reservation family (D1092): both spellings fail identically here,
// and the UNCALLED spelling of the same shape builds and runs. What this needs is the map
// result of a closure-VALUE call, which is a different rung. See D1101.
// Found while writing D1092's fixture, verified 2026-09-02.
// Should print 3.
function viaMap(m: {f: () => {[string]: i32}}) { m.f()["k"] }

function mkMap(): {[string]: i32} {
  const mp: {[string]: i32} = Map()
  mp["k"] = 3
  mp
}

print(viaMap({ f: () => mkMap() }))
