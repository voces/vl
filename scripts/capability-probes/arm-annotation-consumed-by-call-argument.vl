// A binding annotated as a union ARM whose initialiser is a CALL. The arm is the call's
// result, never its argument's, so the call ARGUMENT `{ p: 9 }` builds as `take`'s `P`
// rather than as a `Cat` with its field `c` missing (D12459).
// Should print 9.
type Cat = { c: i32 }
type Dog = { d: i32 }
type U = Cat | Dog
type P = { p: i32 }
function take(p: P): Cat { { c: p.p } }
const x: Cat = take({ p: 9 })
print(x.c)
