// A binding annotated as a union ARM whose initialiser is a CALL. `vl check` returns 0 and
// the emitter refuses with `emitProgram: object literal is missing a union-variant field` —
// clause 2 on a plainly legal program: `take` takes a `P` and `{ p: 9 }` is a `P`. The
// binding seeds `pendingVariantIdx` from its own annotation, and `emitObjLitNode` tests that
// hint before `structIndexOfObj` — so the first object literal the initialiser emits, the
// call ARGUMENT, is built as `Cat`'s variant struct and its field `c` is missing.
// Should print 9.
type Cat = { c: i32 }
type Dog = { d: i32 }
type U = Cat | Dog
type P = { p: i32 }
function take(p: P): Cat { { c: p.p } }
const x: Cat = take({ p: 9 })
print(x.c)
