// A generic `(T | null)[]` whose `T` is bound to a string literal union, a niche nullable.
// `vl check` accepts it and emit refuses (`emitProgram: a nullable-K list element has no rep`,
// the literal `emitProgram: a nullable-` with the bound type spliced in), since the instance's
// element reads take the generic original's rep (D2525's boundary). Should print 1.
type K = "a" | "b"
function f<T>(x: T): (T | null)[] { [x, null] }
const k: K = "a"
print(f(k).length)
