// A generic `(V | null)[]` whose `V` is a niche nullable: here `std:idtable`'s `IdTable<string>`.
// `vl check` accepts it and emit refuses (`emitProgram: a nullable-string list element has no
// rep`, the literal `emitProgram: a nullable-` with the bound type spliced in), since the
// instance's element reads take the generic original's rep (D2525's boundary). `boolean`, a
// string literal union and a function type refuse the same way. Should print a.
import { IdTable } from "std:idtable"

const t = IdTable<string>()
t.set(2, "a")
print(t.get(2) ?? "-")
