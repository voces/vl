// `.pop()` in VALUE position over the numeric element reps.
//
// silent-class inventory D1140. The STATEMENT form (`xs.pop()` discarded) runs at all eight
// list reps and both scopes; binding the result breaks four of them:
//
//   const v = xs.pop()   over i32[] / i64[] / f64[] / f32[]
//     -> check rc 0, then: type mismatch: expected (ref null $type), found i32 / i64 / f64 / f32
//
// So the gap is the RESULT rep of a scalar pop — the checker types it `T | null` and `emitPop`
// pushes the raw scalar — not the pop itself. `string[]` rides a nullable ref and `boolean[]`
// rides the i32 niche (true=1 / false=0 / null=2), which is why exactly those two work.
//
// Four delivery spellings and they do not agree: bound-and-unused is invalid wasm, bound then
// null-checked is a LOUD emit reject, an explicit `T | null` annotation is invalid wasm again,
// and `?? d` runs only at i32 (`emitPopOr` is an i32-family-only fused lowering) — refusing at
// f64/f32 and landing as invalid wasm at i64 and u8.
//
// Named as a known separate limit by D977 without ever getting a row of its own.
//
// Should print: 2 2 2.5 2.5

const a: i32[] = [1, 2]
const av = a.pop()
if av != null { print(av) }

const b: i64[] = [1, 2]
const bv = b.pop()
if bv != null { print(bv) }

const c: f64[] = [1.5, 2.5]
const cv = c.pop()
if cv != null { print(cv) }

const d: f32[] = [1.5, 2.5]
const dv = d.pop()
if dv != null { print(dv) }
