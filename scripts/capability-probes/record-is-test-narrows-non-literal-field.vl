// `is` between two record types where the tested type narrows a field to something other than
// a literal set: a union field to one member, here. `vl check` accepts it; the emitter refuses
// with `is` over a record tests a field that is not a literal set narrowed from the declared
// field. A nested record field or a list element type narrowed the same way reaches it too.
// Should print true then false.
type A = { x: i32 | string }
type B = { x: i32 }

function g(a: A): boolean { a is B }

print(g({ x: 1 }))
print(g({ x: "s" }))
