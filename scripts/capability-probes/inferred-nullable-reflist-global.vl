// An UN-ANNOTATED module global bound to a `<ref-array> | null` value. `vl check` returns 0
// and the emitter refuses the `!= null` compare's bare `null` — or, where nothing reads the
// binding, the engine refuses the module (`expected i32, found (ref null $type)` at the
// cell's own `global.set`). Two spellings of one binding in two different clauses.
//
// The delivery position is NOT the axis. The same value delivered through a `return`, a
// struct field, a list element or a `.length` read runs at every one of them once the READ
// binding is annotated; what refuses is the un-annotated global itself, whose cell kind is
// `globalCellKind`'s un-annotated arm and whose inner wrapper is `letAnnRefListSlot`.
//
// TWO ELEMENT ROWS, because the slot's wrong answer is `0` — a real row, the first one — so
// one such global in a module cannot tell a missing slot from slot 0. See D1106.
// Should print 5 then 6.
type P = { a: i32 }
type Q = { b: i32 }

function mkP(n: i32): P[] | null {
  if n == 0 { return [{ a: 5 }] }
  return null
}
function mkQ(n: i32): Q[] | null {
  if n == 0 { return [{ b: 6 }] }
  return null
}

const gp = mkP(0)
if gp != null { print(gp[0].a) }
const gq = mkQ(0)
if gq != null { print(gq[0].b) }
