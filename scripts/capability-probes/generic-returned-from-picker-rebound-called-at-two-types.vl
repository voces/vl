// A generic returned from either branch of a non-generic picker, its binding rebound to another
// picker's result and called at two types (D10370).
// The binding holds the join of both pickers' sets, its initialiser's subset decided with it.
// Should print 21 then third then 22 then third then b.
function id<T>(x: T): T { x }
function same<T>(x: T): T {
  print("same")
  x
}
function third<T>(x: T): T {
  print("third")
  x
}
function pick(n: i32) {
  if n > 1 { return id }
  return same
}
function pick3(n: i32) {
  if n > 1 { return id }
  if n > 0 { return third }
  return same
}
let k = pick(5)
print(k(21))
k = pick3(1)
print(k(22))
print(k("b"))
