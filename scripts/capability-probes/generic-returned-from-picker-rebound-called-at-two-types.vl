// A generic returned from either branch of a non-generic picker, its binding rebound to another
// picker's result and called at two types (D10370).
// `vl check` returns 0 and the emitter refuses the returned value: `emitProgram: a generic function
// taken as a value reaches no call that fixes its type — annotate the destination's function type`.
// Should print: 21 third 22 third b
function id<T>(x: T): T { x }
function same<T>(x: T): T {
  print("same")
  x
}
function third<T>(x: T): T {
  print("third")
  x
}
function pick(n: i32) {
  if n > 1 { return id }
  return same
}
function pick3(n: i32) {
  if n > 1 { return id }
  if n > 0 { return third }
  return same
}
let k = pick(5)
print(k(21))
k = pick3(1)
print(k(22))
print(k("b"))
