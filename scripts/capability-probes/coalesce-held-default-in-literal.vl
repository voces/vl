// A `??` default held in a binding, for a read of a map whose values are built wider, placed in a
// list literal. `vl check` refuses it: "a `??` whose default is a binding, built at J for a read of
// a container built wider, is not yet supported inside a list or record literal". The default
// written in the slot, and the join bound outside a literal, both run (D15312, D15217). See D15313.
// Should print 4.
type J = { f: i32 | null }
function mk() { { f: 4 } }
const m = Map()
m.set("a", mk())
const wm: {[string]: J} = Map()
wm.set("a", mk())
const dl = { f: 1 }
const xs = [m.get("a") ?? dl]
print(xs[0].f ?? 0)
