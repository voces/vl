// D16854 — an inline read of a list of an un-annotated function handed through a generic,
// beside unread and read runtime `if` records of others, has no interned call signature
// The IR refuses it as `cannot yet lower this statement (indirect call...)`; the literal is
// `indirect call`.
// Should print 4 then 14 then 0.75.
function inc0(a) { return a + 1 }
function inc1(a) { return a + 2 }
function half(a) { return a / 2.0 }
function quarter(a) { return a / 4.0 }
function id(x) { return x }
function app(o) { return o.f(12) }
const n = 3
const r = id(if n > 2 { { f: inc0 } } else { { f: inc1 } })
print(id([inc0])[0](3))
print(app({ f: inc1 }))
const h = id(if n > 2 { { f: half } } else { { f: quarter } })
print(h.f(3.0))
