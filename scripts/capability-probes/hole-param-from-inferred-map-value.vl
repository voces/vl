// A struct read back out of an UN-ANNOTATED `Map()`, narrowed against null, and handed to an
// un-annotated parameter: `emitProgram: monomorphize: unsupported argument type for `b`` after
// `vl check` returned 0 — a clause-2 violation by construction. Annotating either end rescues
// it (the map binding, or the parameter), so neither may appear here.
// This is the `map_value` un-annotated cell of D1596's position matrix
// (`hole-param-module-block-binding.matrix.vl`) kept whole. Its ANNOTATED twin was
// check-clean invalid wasm before D1596 and runs now; this face traded the same silence for
// the loud refusal above, which is where it stands.
// Should print 3.
type Box = { base: i32 }

function ld(self: Box) { self.base }

function viaHole(b) { b.ld() }

function mkBox(n: i32): Box { return { base: n } }

const m = Map()
m["k"] = mkBox(3)
const mv = m["k"]
if mv != null {
  const v = mv
  print(viaHole(v))
}
