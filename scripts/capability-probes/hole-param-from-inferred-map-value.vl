// A struct read back out of an UN-ANNOTATED `Map()`, narrowed against null, and handed to an
// un-annotated parameter. RUNS since the monomorphizer's argument-pin floors learned to ask the
// arena: it refuses at `1a5955551` with `emitProgram: monomorphize: unsupported argument type
// for `b`` and prints `3` at `4eb911603`, and #2774 (D1755) is the only argument-pin change in
// that range.
//
// Kept as a regression pin rather than a gap; its `live-sites` row comes off with it. Annotating
// either end — the map binding or the parameter — always rescued it, so neither may appear here.
// This is the `map_value` un-annotated cell of D1596's position matrix
// (`hole-param-module-block-binding.matrix.vl`) kept whole.
// Should print 3.
type Box = { base: i32 }

function ld(self: Box) { self.base }

function viaHole(b) { b.ld() }

function mkBox(n: i32): Box { return { base: n } }

const m = Map()
m["k"] = mkBox(3)
const mv = m["k"]
if mv != null {
  const v = mv
  print(viaHole(v))
}
