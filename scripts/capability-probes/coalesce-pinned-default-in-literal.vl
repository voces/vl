// A `??` default the record solve adopts at the read's record (here a `const` holding a call), for
// a read of a map whose values are built wider, placed in a list literal. `vl check` refuses it:
// "a `??` whose default is a `let` or a call's result held in a `const`, built at J for a read of
// a container built wider, is not yet supported inside a list or record literal". A `const` of a
// literal runs (D15313), and so does the join bound outside a literal (D15240). See D15316.
// Should print 4.
type J = { f: i32 | null }
function mk() { { f: 4 } }
const m = Map()
m.set("a", mk())
const wm: {[string]: J} = Map()
wm.set("a", mk())
function mkd() { { f: 1 } }
const dl = mkd()
const xs = [m.get("a") ?? dl]
print(xs[0].f ?? 0)
