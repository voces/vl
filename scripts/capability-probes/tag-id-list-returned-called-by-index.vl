// A tagged set's member ids read from a map, returned in a list and called through an index read:
// the list holds each member's closure. Should print 4 then 6.
function inc(a) { return a + 1 }
function dbl(a) { return a * 2 }
const m = Map()
m["k"] = inc
m["d"] = dbl
function both() { return [m["k"], m["d"]] }
const fs = both()
let i = 0
while i < fs.length {
  const f = fs[i]
  if f != null { print(f(3)) }
  i = i + 1
}
