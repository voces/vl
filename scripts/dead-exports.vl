// Finds the dead code of compiler/ for the dead-export ratchet: exports nothing references, and
// functions no live code reaches.
//
//     vl run scripts/dead-exports.vl -- --list [--root <dir>]
//     vl run scripts/dead-exports.vl -- --out <findings.json> [--root <dir>]
//
// A reference is a word-boundary occurrence of the name under compiler/, std/, tests/, lsp/,
// playground/ or scripts/ other than the declaration; docs/ is not a consumer. A compiler/
// function is reached when a mention outside compiler/, compiler/ top-level code, or a reached
// function's body names it; a comment or an `import` list is no mention. `--out` writes a
// `vl check --json`-shaped report that `vl check --budget scripts/export-budget-baseline.json
// --findings <file>` counts.

import { IoError, listDir, pathKind, readFile, writeTextFile } from "std:fs"
import { programArgs } from "std:args"
import { exit } from "std:process"
import { Utf8Error, decodeUtf8Lossy } from "std:utf8"
import { toJson } from "std:json"
import { join } from "std:str"
import { sort } from "std:array"

const CORPUS = ["compiler", "std", "tests", "lsp", "playground", "scripts"]
// Build output and vendored trees, derived from the very sources being graded.
const SKIP_DIRS = [
  ".git", "node_modules", "dist", "build", "target", "__pycache__", ".cache",
  ".deno",
]
const KINDS = ["function", "let", "const", "type"]

type Export = {
  rel: string,
  line: i32,
  kind: string,
  name: string,
  text: string,
}

// A top-level function of a compiler/ module, by its name's trie id.
type FnDecl = {
  at: Export,
  id: i32,
}

function die(msg: string, code: i32) {
  print(msg)
  exit(code)
}

// The slot of an identifier byte in a trie node, or -1 for any other byte.
function slot(c: i32): i32 {
  if c >= '0' && c <= '9' { return c - '0' }
  if c >= 'A' && c <= 'Z' { return c - 'A' + 10 }
  if c >= 'a' && c <= 'z' { return c - 'a' + 36 }
  if c == '_' { return 62 }
  -1
}

// Code-point order, the order Python's `sorted` gives a `str`.
function strLess(a: string, b: string): boolean {
  let i = 0
  while i < a.length && i < b.length {
    if a[i] != b[i] { return a[i] < b[i] }
    i = i + 1
  }
  a.length < b.length
}

function bytesOf(path: string): u8[] {
  const b = readFile(path)
  if b is IoError {
    die("dead-exports: cannot read \{path} (\{b.msg})", 2)
    return []
  }
  b
}

function sortedNames(dir: string): string[] {
  const names = listDir(dir)
  if names is IoError {
    die("dead-exports: cannot list \{dir} (\{names.msg})", 2)
    return []
  }
  sort(names, strLess)
  names
}

// Whether `b[i..]` spells `word`.
function bytesAt(b: u8[], i: i32, word: string): boolean {
  if i + word.length > b.length { return false }
  let k = 0
  while k < word.length {
    if b[i + k] != word[k] { return false }
    k = k + 1
  }
  true
}

// Every `export function|let|const|type NAME` whose `export` opens a line of a
// compiler/*.vl module. A re-export block names no new declaration and is skipped.
function exportsIn(root: string): Export[] {
  const out: Export[] = []
  for n in sortedNames("\{root}/compiler") {
    if n.length < 3 || n.slice(n.length - 3, n.length) != ".vl" { continue }
    const b = bytesOf("\{root}/compiler/\{n}")
    let ln = 1
    let a = 0
    while a <= b.length {
      let e = a
      while e < b.length && b[e] != '\n' { e = e + 1 }
      if bytesAt(b, a, "export ") {
        for kind in KINDS {
          const k0 = a + 7
          if (
            bytesAt(b, k0, kind)
            && k0 + kind.length < e
            && b[k0 + kind.length] == ' '
          ) {
            let i = k0 + kind.length + 1
            while i < e && b[i] == ' ' { i = i + 1 }
            let j = i
            while j < e && slot(b[j]) >= 0 { j = j + 1 }
            if j > i {
              out.push(
                {
                  rel: "compiler/\{n}",
                  line: ln,
                  kind: kind,
                  name: decodeUtf8Lossy(b.slice(i, j)),
                  text: decodeUtf8Lossy(b.slice(a, e)),
                },
              )
            }
            break
          }
        }
      }
      a = e + 1
      ln = ln + 1
    }
  }
  out
}

// A trie over the export names: `kids[node * 63 + slot]` is the child or 0, and
// `ends[node]` the name id spelled by the path to `node`, or -1.
let kids: i32[] = []
let ends: i32[] = []
let nameCount = 0

// The id of `name`, allocated the first time it is added.
function trieId(name: string): i32 {
  let node = 0
  for c in name {
    const at = node * 63 + slot(c)
    if kids[at] == 0 {
      kids[at] = ends.length
      ends.push(-1)
      let k = 0
      while k < 63 {
        kids.push(0)
        k = k + 1
      }
    }
    node = kids[at]
  }
  if ends[node] < 0 {
    ends[node] = nameCount
    nameCount = nameCount + 1
  }
  ends[node]
}

function trieReset() {
  kids = []
  ends = [-1]
  nameCount = 0
  let k = 0
  while k < 63 {
    kids.push(0)
    k = k + 1
  }
}

// Counts, into `hits[id]`, every identifier run of `b` that spells an export name.
function countWords(b: u8[], hits: i32[]) {
  let i = 0
  while i < b.length {
    if slot(b[i]) < 0 {
      i = i + 1
      continue
    }
    let node = 0
    while i < b.length {
      const s = slot(b[i])
      if s < 0 { break }
      if node >= 0 {
        node = kids[node * 63 + s]
        if node == 0 { node = -1 }
      }
      i = i + 1
    }
    if node > 0 && ends[node] >= 0 { hits[ends[node]] = hits[ends[node]] + 1 }
  }
  0
}

// Pushes onto `out` the id of every identifier run of `b[a..e]` that spells a trie name.
function wordIds(b: u8[], a: i32, e: i32, out: i32[]) {
  let i = a
  while i < e {
    if slot(b[i]) < 0 {
      i = i + 1
      continue
    }
    let node = 0
    while i < e {
      const s = slot(b[i])
      if s < 0 { break }
      if node >= 0 {
        node = kids[node * 63 + s]
        if node == 0 { node = -1 }
      }
      i = i + 1
    }
    if node > 0 && ends[node] >= 0 { out.push(ends[node]) }
  }
  0
}

// Where line `b[a..e]`'s code ends: the start of a `//` comment outside a string, else `e`.
function codeEnd(b: u8[], a: i32, e: i32): i32 {
  let i = a
  let inStr = false
  while i < e {
    const c = b[i]
    if inStr {
      if c == '\\' {
        i = i + 2
        continue
      }
      if c == '"' { inStr = false }
    } else if c == '"' {
      inStr = true
    } else if c == '/' && i + 1 < e && b[i + 1] == '/' {
      return i
    }
    i = i + 1
  }
  e
}

// Whether `b[a..e]` holds as many `{` as `}`, and at least one.
function bracesClose(b: u8[], a: i32, e: i32): boolean {
  let open = 0
  let close = 0
  let i = a
  while i < e {
    if b[i] == '{' { open = open + 1 }
    if b[i] == '}' { close = close + 1 }
    i = i + 1
  }
  open > 0 && open == close
}

// The top-level functions of `rel`'s bytes `b`. With `declare`, each name is added to the trie and
// pushed onto `fns`; without, every mention is an edge from the function whose body holds it
// (`from`, `to`), or a root (`roots`) from top-level code.
function scanModule(
  rel: string,
  b: u8[],
  declare: boolean,
  fns: FnDecl[],
  from: i32[],
  to: i32[],
  roots: i32[],
) {
  let ln = 1
  let a = 0
  let cur = -1
  let inImport = false
  while a <= b.length {
    let e = a
    while e < b.length && b[e] != '\n' { e = e + 1 }
    const ce = codeEnd(b, a, e)
    if cur >= 0 {
      if e - a == 1 && b[a] == '}' {
        cur = -1
      } else if !declare {
        const ids: i32[] = []
        wordIds(b, a, ce, ids)
        for t in ids {
          from.push(cur)
          to.push(t)
        }
      }
    } else if inImport || bytesAt(b, a, "import ") {
      inImport = !lineHasFrom(b, a, ce)
    } else {
      let k0 = -1
      if bytesAt(b, a, "function ") { k0 = a + 9 }
      if bytesAt(b, a, "export function ") { k0 = a + 16 }
      let j = k0
      while j >= 0 && j < ce && slot(b[j]) >= 0 { j = j + 1 }
      if k0 >= 0 && j > k0 {
        const name = decodeUtf8Lossy(b.slice(k0, j))
        const id = trieId(name)
        if declare {
          fns.push(
            {
              at: {
                rel: rel,
                line: ln,
                kind: "function",
                name: name,
                text: decodeUtf8Lossy(b.slice(a, e)),
              },
              id: id,
            },
          )
        } else {
          const ids: i32[] = []
          wordIds(b, j, ce, ids)
          for t in ids {
            from.push(id)
            to.push(t)
          }
        }
        if !bracesClose(b, a, ce) { cur = id }
      } else if !declare {
        wordIds(b, a, ce, roots)
      }
    }
    a = e + 1
    ln = ln + 1
  }
  0
}

// Whether `b[a..e]` holds the word `from`, the end of an `import` list.
function lineHasFrom(b: u8[], a: i32, e: i32): boolean {
  let i = a
  while i + 4 <= e {
    if (
      bytesAt(b, i, "from")
      && (i == a || slot(b[i - 1]) < 0)
      && (i + 4 == e || slot(b[i + 4]) < 0)
    ) {
      return true
    }
    i = i + 1
  }
  false
}

function isSkipped(name: string): boolean {
  for s in SKIP_DIRS {
    if s == name { return true }
  }
  false
}

function walk(dir: string, hits: i32[]) {
  for n in sortedNames(dir) {
    const path = "\{dir}/\{n}"
    const kind = pathKind(path)
    if kind is IoError { continue }
    if kind == "dir" {
      if !isSkipped(n) { walk(path, hits) }
    } else {
      countWords(bytesOf(path), hits)
    }
  }
  0
}

// One dead declaration and the sentence its finding gives.
type Dead = {
  at: Export,
  why: string,
}

// The exports the corpus mentions at most once (that once being the declaration), then the
// compiler/ functions no root reaches.
function deadExports(root: string): Dead[] {
  const exps = exportsIn(root)
  trieReset()
  const expIds: i32[] = []
  for x in exps { expIds.push(trieId(x.name)) }
  const mods: string[] = []
  for n in sortedNames("\{root}/compiler") {
    if n.length >= 3 && n.slice(n.length - 3, n.length) == ".vl" {
      mods.push(n)
    }
  }
  const fns: FnDecl[] = []
  const from: i32[] = []
  const to: i32[] = []
  const roots: i32[] = []
  for n in mods {
    scanModule(
      "compiler/\{n}",
      bytesOf("\{root}/compiler/\{n}"),
      true,
      fns,
      from,
      to,
      roots,
    )
  }
  for n in mods {
    scanModule(
      "compiler/\{n}",
      bytesOf("\{root}/compiler/\{n}"),
      false,
      fns,
      from,
      to,
      roots,
    )
  }
  const hits: i32[] = []
  const outside: i32[] = []
  while hits.length < nameCount {
    hits.push(0)
    outside.push(0)
  }
  for d in CORPUS {
    const top = "\{root}/\{d}"
    const kind = pathKind(top)
    if kind is IoError { continue }
    if kind == "dir" {
      if d == "compiler" { walk(top, hits) } else { walk(top, outside) }
    }
  }
  // A repeated name shares one id, so its declarations stand or fall together.
  const out: Dead[] = []
  const said: boolean[] = []
  while said.length < nameCount { said.push(false) }
  let k = 0
  while k < exps.length {
    const id = expIds[k]
    if hits[id] + outside[id] <= 1 {
      out.push(
        {
          at: exps[k],
          why: "is exported and referenced nowhere in \{join(CORPUS, "/, ")}/",
        },
      )
      said[id] = true
    }
    k = k + 1
  }
  for f in reachless(from, to, roots, outside) {
    for x in fns {
      if x.id == f && !said[f] {
        out.push(
          {
            at: x.at,
            why: "is reached only from comments, `import` lists or dead functions",
          },
        )
      }
    }
    said[f] = true
  }
  out
}

// The ids no root reaches: a root is a name in `roots` or one `outside` counts, and an edge
// `from[i] -> to[i]` reaches its target from a reached function.
function reachless(
  from: i32[],
  to: i32[],
  roots: i32[],
  outside: i32[],
): i32[] {
  const deg: i32[] = []
  while deg.length <= nameCount { deg.push(0) }
  for f in from { deg[f + 1] = deg[f + 1] + 1 }
  let i = 1
  while i <= nameCount {
    deg[i] = deg[i] + deg[i - 1]
    i = i + 1
  }
  const fill: i32[] = deg.slice(0, nameCount)
  const adj: i32[] = []
  while adj.length < to.length { adj.push(0) }
  i = 0
  while i < from.length {
    adj[fill[from[i]]] = to[i]
    fill[from[i]] = fill[from[i]] + 1
    i = i + 1
  }
  const seen: boolean[] = []
  while seen.length < nameCount { seen.push(false) }
  const stack: i32[] = []
  for r in roots { stack.push(r) }
  i = 0
  while i < nameCount {
    if outside[i] > 0 { stack.push(i) }
    i = i + 1
  }
  while stack.length > 0 {
    const n = stack[stack.length - 1]
    stack.pop()
    if seen[n] { continue }
    seen[n] = true
    let e = deg[n]
    while e < deg[n + 1] {
      if !seen[adj[e]] { stack.push(adj[e]) }
      e = e + 1
    }
  }
  const out: i32[] = []
  i = 0
  while i < nameCount {
    if !seen[i] { out.push(i) }
    i = i + 1
  }
  out
}

function jsonText(s: string): string {
  const j = toJson(s)
  if j is string { return j }
  "\"\""
}

function main(args: string[]) {
  let root = "."
  let list = false
  let outPath = ""
  let i = 0
  while i < args.length {
    if args[i] == "--root" && i + 1 < args.length {
      root = args[i + 1]
      i = i + 1
    } else if args[i] == "--out" && i + 1 < args.length {
      outPath = args[i + 1]
      i = i + 1
    } else if args[i] == "--list" {
      list = true
    } else {
      die("dead-exports: unknown argument `\{args[i]}`", 2)
    }
    i = i + 1
  }
  if !list && outPath == "" {
    die(
      "dead-exports: usage: dead-exports.vl (--list | --out <file>) [--root <dir>]",
      2,
    )
  }
  const dead = deadExports(root)
  if list {
    for x in dead {
      print("\{x.at.rel}:\{x.at.line}  \{x.at.kind} \{x.at.name}")
    }
  }
  if outPath != "" {
    const rows: string[] = []
    for d in dead {
      const x = d.at
      const msg = "`\{x.name}` \{d.why}"
      rows.push(
        "{\"file\": \{jsonText(x.rel)}, \"line\": \{x.line}, \"col\": 1, \"severity\": \"warning\", \"code\": \"dead-export\", \"message\": \{jsonText(msg)}, \"text\": \{jsonText(x.text)}}",
      )
    }
    const r = writeTextFile(outPath, "[\{join(rows, ",\n")}]\n")
    if r is IoError {
      die("dead-exports: cannot write \{outPath} (\{r.msg})", 2)
    }
  }
  0
}

const argv = programArgs()
if argv is Utf8Error {
  die("dead-exports: an argument is not UTF-8: \{argv.msg}", 2)
} else {
  main(argv)
}
