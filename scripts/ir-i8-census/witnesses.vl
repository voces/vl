// Writes the witness of every inventory row filed `runs` under `<out>/inv<k>/<id>/`, one file per
// `// file:` section, and prints each entry file's path: the I8 census's witness population.
//
//     vl run scripts/ir-i8-census/witnesses.vl -- <out> <inventory-dir>...

import { programArgs } from "std:args"
import { Utf8Error } from "std:utf8"
import { toString } from "std:fmt"
import { die, splitLines, univNl } from "../lib/common"
import {
  declaredOutcome,
  parseRows,
  resolve,
  splitFiles,
} from "../lib/inventory"
import { readText, spawn, writeText } from "../lib/corpus"

const got = programArgs()
const args: string[] = if got is Utf8Error { [] } else { got }
if args.length < 2 { die("usage: witnesses.vl -- <out> <inventory-dir>...", 2) }
const out = args[0]
let k = 1
while k < args.length {
  for doc in resolve(args[k]) {
    for r in parseRows(doc, splitLines(univNl(readText(doc)))) {
      if r.repro == "" || declaredOutcome(r.status) != "runs" { continue }
      const dir = out + "/inv" + toString(k) + "/" + r.id
      if spawn("mkdir", ["-p", dir]).code != 0 {
        die("witnesses: cannot make " + dir, 1)
      }
      const files = splitFiles(r.repro)
      let i = 0
      while i + 1 < files.length {
        writeText(dir + "/" + files[i], files[i + 1])
        i = i + 2
      }
      print(dir + "/" + files[files.length - 2])
    }
  }
  k = k + 1
}
