#!/bin/sh
# `node <script> [args...]` for a host with deno and no node (the macOS audit box), so the
# `#!/usr/bin/env node` launchers in node_modules/.bin (binaryen's wasm-opt, wasm-dis, ...)
# run. gate.sh appends this directory to the END of PATH: a real node always wins.
exec deno run -A --quiet --no-config "$(dirname "$0")/node-shim.cjs" "$@"
