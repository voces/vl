// The rep-classifier census, the discovery instrument behind the "one rep per node"
// campaign (docs/internals/rep-descriptor-campaign.md). A classifier is an emitter
// function whose body is a ladder of at least `--min` arms over a closed rep vocabulary
// and whose answer is a representation; the `reads` column names which producers it
// consults (ARENA, NAME, SPELLING, TABLE, FRAME), directly or with `--deep` transitively.
//
//     vl run scripts/rep-classifier-census.vl [-- --summary | --json | --why <fn>]
//         [--reads <producer>] [--deep] [--min N] [--all-compiler]
//
// Scope is compiler/emit_*.vl and compiler/wasmEmit.vl; `--all-compiler` widens it.
// Paths resolve against the working directory; run it from the checkout root.

import { programArgs } from "std:args"
import { exit } from "std:process"
import { Utf8Error } from "std:utf8"
import { parseI32 } from "std:fmt"
import {
  endsWith,
  join,
  lastIndexOf,
  split,
  startsWith,
  toLowerAscii,
  toUpperAscii,
} from "std:str"
import { includes, sort } from "std:array"
import { die, findFrom, jsonStr } from "./lib/common"
import {
  callNames,
  cutComment,
  fnHead,
  functions,
  hasStr,
  isDigitC,
  isLower,
  isUpper,
  isWord,
  modules,
  padL,
  padR,
  readOrDie,
  rstrip,
  skipWs,
  strLess,
  strip,
  stripLine,
  typeHead,
  typeRhs,
  wordEnd,
} from "./lib/ladder-walk"

const TOOL = "rep-classifier-census"

// The rep vocabulary's producers, as bits of a `reads` mask, in the order they print.
const ARENA = 1
const NAME = 2
const SPELLING = 4
const TABLE = 8
const FRAME = 16

const ARENA_TELLS = [
  "T.tys[", "repOfTy(", "repOfNode(", "repTreeOfTy(", "nodeTyIxOf(",
  "resolveAnnot(", "nodeRepTyIxOf(", "T.tys.length", "repCanonId(",
  "repElemId(", "litBaseTy(", "primTyOfName(",
]
const NAME_TELLS = [
  "nameIs", "tyNameOf(", ".tyName", "tyToStr(", "tyToEmitName(",
  "emitNameOfTy(", "renderTy(",
]
const SPELL_TELLS = [
  "endsWith(", "startsWith(", "indexOf(", ".substring(", "splitUnionAtoms(",
  "nullablePartOf(", "peelGroupParens(", "nameStripSpaces(", "sliceStr(",
  "nulSuffix", "annGenAppSpanEnds(", "nameIsShapeSpanEnds(",
]
const FRAME_TELLS = [
  "emitCurFnIx", "fnParent", "fnInstOrigin", "monoLamPinned", "monoLamShared",
  "callingFrame", "frameOf",
]
const FRAME_PARAMS = [
  "fnIx", "fnPos", "fnIdx", "frame", "frameIx", "ownerFn", "curFn",
]

// A predicate rung's name carries one of these; so does a boolean or name that answers
// a rep question.
const REP_NOUNS = [
  "closure", "clo", "ref", "box", "list", "arr", "array", "map", "union",
  "struct", "nullable", "nul", "variant", "str", "atom", "niche", "elem",
  "heap", "slot", "kind", "rep", "valtype", "shape", "tag", "sig", "litunion",
  "prim", "scalar", "obj", "field", "u8", "i64", "f64", "f32", "i32",
]
const SLOT_SUFFIX = [
  "slot", "idx", "index", "code", "tag", "shape", "kind", "row", "heap",
]
const NAME_SUFFIX = ["name", "key", "tok", "elem", "text", "spelling"]

type Row = {
  fn: string,
  at: string,
  file: string,
  arms: i32,
  shape: string,
  result: string,
  reads: i32,
  lines: i32,
  callers: i32,
  deep: i32,
}

// What the census reads off the tree besides the functions: `VKind`'s members, the
// arena's variant names, and the emitter's parallel state tables.
type Vocab = {
  vkinds: Map<string, boolean>,
  nVkinds: i32,
  variants: Map<string, boolean>,
  nVariants: i32,
  tables: Map<string, boolean>,
}

function lines(path: string): string[] { split(readOrDie(TOOL, path), "\n") }

function inScope(rel: string, all: boolean): boolean {
  all || startsWith(rel, "compiler/emit_") || rel == "compiler/wasmEmit.vl"
}

// The `|`-separated parts of the first `type <name>` the compiler declares, stripped.
function firstTypeParts(name: string): string[] {
  for m in modules(TOOL, ".") {
    const ls = lines(m[1])
    let n = 0
    while n < ls.length {
      const head = typeHead(ls[n])
      if head.length > 0 && head[0] == name {
        const out: string[] = []
        for p in split(typeRhs(ls, n, head[1]).rhs, "|") { out.push(strip(p)) }
        return out
      }
      n = n + 1
    }
  }
  []
}

// Whether `t`, after the name, is `[ws]* : [^=]* [] [ws]* =` (a list table) or
// `[ws]* : [ws]* {[` (a map table).
function tableTail(t: string): boolean {
  let k = skipWs(t, 0)
  if k >= t.length || t[k] != ':' { return false }
  k = k + 1
  const m = skipWs(t, k)
  if t.slice(m, m + 2) == "{[" { return true }
  const eq = findFrom(t, "=", k)
  if eq < 0 { return false }
  endsWith(rstrip(t.slice(k, eq)), "[]")
}

function vocab(): Vocab {
  const vkinds: Map<string, boolean> = Map()
  let nV = 0
  for p in firstTypeParts("VKind") {
    if p.length >= 2 && p[0] == '"' && p[p.length - 1] == '"' {
      const mem = p.slice(1, p.length - 1)
      if !vkinds.has(mem) {
        vkinds[mem] = true
        nV = nV + 1
      }
    }
  }
  const variants: Map<string, boolean> = Map()
  let nT = 0
  for p in firstTypeParts("Ty") {
    if startsWith(p, "Ty") && wordEnd(p, 0) == p.length && !variants.has(p) {
      variants[p] = true
      nT = nT + 1
    }
  }
  const tables: Map<string, boolean> = Map()
  for ln in lines("./compiler/emit_state.vl") {
    if startsWith(ln, "export let ") {
      const a = 11
      if a < ln.length && isWord(ln[a]) && !isDigitC(ln[a]) {
        const b = wordEnd(ln, a)
        if tableTail(ln.slice(b, ln.length)) { tables[ln.slice(a, b)] = true }
      }
    }
  }
  {
    vkinds: vkinds,
    nVkinds: nV,
    variants: variants,
    nVariants: nT,
    tables: tables,
  }
}

// The header text from `function` to the body's opening `{`, joined across a wrapped
// parameter list, comments cut and literals intact.
function signature(ls: readonly string[], lo: i32, hi: i32): string {
  const buf: string[] = []
  const top = if hi < lo + 12 { hi } else { lo + 12 }
  let n = lo
  while n <= top {
    const s = cutComment(ls[n])
    buf.push(s)
    if stripLine(s).includes("{") { break }
    n = n + 1
  }
  const txt = join(buf, " ")
  const b = txt.indexOf("{")
  if b >= 0 { return txt.slice(0, b) }
  txt
}

// The declared return type, or "" when it is inferred. Reads past the last `)`, so a
// function-typed parameter's own `: T` never wins.
function declaredReturn(sig: string): string {
  const b = lastIndexOf(sig, ")")
  if b < 0 { return "" }
  const k = skipWs(sig, b + 1)
  if k >= sig.length || sig[k] != ':' { return "" }
  strip(sig.slice(k + 1, sig.length))
}

// The string literals of `ln` with no backslash in them; one with an escape is skipped.
function plainLits(ln: string): string[] {
  const out: string[] = []
  let k = 0
  while k < ln.length {
    if ln[k] == '"' {
      let j = k + 1
      while j < ln.length && ln[j] != '"' && ln[j] != '\\' { j = j + 1 }
      if j < ln.length && ln[j] == '"' {
        out.push(ln.slice(k + 1, j))
        k = j + 1
        continue
      }
    }
    k = k + 1
  }
  out
}

function hasRepNoun(name: string): boolean {
  const low = toLowerAscii(name)
  for n in REP_NOUNS {
    if low.includes(n) { return true }
  }
  false
}

// Whether one of `words` is a whole camelCase segment of `name` (`[A-Z]?[a-z0-9]+`),
// not merely a substring: `unionNameOfExpr` carries `Name`, `nameStripSpaces` does not.
function hasSegment(name: string, words: readonly string[]): boolean {
  let k = 0
  while k < name.length {
    const lowOrDigit = (c: i32): boolean => isLower(c) || isDigitC(c)
    let a = -1
    if isUpper(name[k]) && k + 1 < name.length && lowOrDigit(name[k + 1]) {
      a = k
      k = k + 1
    } else if lowOrDigit(name[k]) {
      a = k
    }
    if a < 0 {
      k = k + 1
      continue
    }
    while k < name.length && lowOrDigit(name[k]) { k = k + 1 }
    if hasStr(words, toLowerAscii(name.slice(a, k))) { return true }
  }
  false
}

// Whether the stripped line is a bare `[return] <tail>`, `tail` being an integer, a
// boolean or `""` by `form` (0, 1, 2).
function bareReturn(s: string, form: i32): boolean {
  let k = skipWs(s, 0)
  if s.slice(k, k + 6) == "return" {
    const r = skipWs(s, k + 6)
    if r > k + 6 { k = r }
  }
  let e = -1
  if form == 0 {
    let d = k
    if d < s.length && s[d] == '-' { d = d + 1 }
    let j = d
    while j < s.length && isDigitC(s[j]) { j = j + 1 }
    if j > d { e = j }
  } else if form == 1 {
    if s.slice(k, k + 4) == "true" { e = k + 4 }
    if s.slice(k, k + 5) == "false" { e = k + 5 }
  } else if s.slice(k, k + 2) == "\"\"" {
    e = k + 2
  }
  e >= 0 && skipWs(s, e) == s.length
}

function anyBare(body: readonly string[], form: i32): boolean {
  for ln in body {
    if bareReturn(stripLine(ln), form) { return true }
  }
  false
}

// What kind of rep answer the function hands back, or "": a declared `VKind`, `VKind`
// literals as its returns, an interned slot or index, a boolean naming a rep family, or
// a name used as a table key. Decided in that order.
function resultClass(
  fname: string,
  sig: string,
  raw: readonly string[],
  v: Vocab,
): string {
  const ret = declaredReturn(sig)
  if ret.includes("VKind") { return "VKIND" }
  const lits: string[] = []
  for ln in raw {
    for l in plainLits(cutComment(ln)) {
      if v.vkinds.has(l) && !hasStr(lits, l) { lits.push(l) }
    }
  }
  if lits.length >= 2 { return "VKIND-LIT" }
  if ret == "i32" || ret == "i32 | null" || (ret == "" && anyBare(raw, 0)) {
    if hasSegment(fname, SLOT_SUFFIX) { return "SLOT" }
    if endsWith(toLowerAscii(fname), "flag") && hasRepNoun(fname) {
      return "REPBOOL"
    }
  }
  if (
    ret == "boolean"
    || ret == "boolean | null"
    || (ret == "" && anyBare(raw, 1))
  ) {
    if hasRepNoun(fname) { return "REPBOOL" }
  }
  if (
    ret == "string"
    || ret == "string | null"
    || (ret == "" && anyBare(raw, 2))
  ) {
    if hasSegment(fname, NAME_SUFFIX) && hasRepNoun(fname) { return "REPNAME" }
  }
  ""
}

// The type names `s` tests with `is` (a word `is`, whitespace, an upper-case name).
function isTests(s: string): string[] {
  const out: string[] = []
  let k = findFrom(s, "is", 0)
  while k >= 0 {
    let next = k + 1
    if k == 0 || !isWord(s[k - 1]) {
      const r = skipWs(s, k + 2)
      if r > k + 2 && r < s.length && isUpper(s[r]) {
        const e = wordEnd(s, r)
        out.push(s.slice(r, e))
        next = e
      }
    }
    k = findFrom(s, "is", next)
  }
  out
}

// A predicate rung: a call named like the emitter's rep questions.
function predHead(n: string): boolean {
  for p in ["nameIs", "tyIs", "annIs", "nodeTyIs", "nodeIs", "exprIs"] {
    if startsWith(n, p) { return true }
  }
  if startsWith(n, "is") && n.length > 2 && isUpper(n[2]) { return true }
  (n.length >= 5 && endsWith(n, "Flag"))
    || findFrom(n, "IsClosure", 1) > 0
    || findFrom(n, "IsRef", 1) > 0
}

function wordAt(s: string, k: i32, w: string): boolean {
  s.slice(k, k + w.length) == w
    && (k == 0 || !isWord(s[k - 1]))
    && (k + w.length >= s.length || !isWord(s[k + w.length]))
}

function hasWord(s: string, w: string): boolean {
  let k = findFrom(s, w, 0)
  while k >= 0 {
    if wordAt(s, k, w) { return true }
    k = findFrom(s, w, k + 1)
  }
  false
}

// A `match` arm head: an identifier, a string literal or `_`, then `=>`.
function matchArm(s: string): boolean {
  let k = skipWs(s, 0)
  if k >= s.length { return false }
  if isWord(s[k]) && !isDigitC(s[k]) {
    k = wordEnd(s, k)
  } else if s[k] == '"' {
    const q = findFrom(s, "\"", k + 1)
    if q < 0 { return false }
    k = q + 1
  } else {
    return false
  }
  k = skipWs(s, k)
  s.slice(k, k + 2) == "=>"
}

type Arms = { arms: i32, shape: string }

// The widest ladder in the body and its shape; a tie goes to the shape whose name sorts
// last.
function ladderArms(
  stripped: readonly string[],
  raw: readonly string[],
  v: Vocab,
): Arms {
  const tys: string[] = []
  const nodes: string[] = []
  for ln in stripped {
    for g in isTests(ln) {
      const set = if v.variants.has(g) { tys } else { nodes }
      if !hasStr(set, g) { set.push(g) }
    }
  }
  const lits: string[] = []
  for ln in raw {
    for l in plainLits(cutComment(ln)) {
      if v.vkinds.has(l) && !hasStr(lits, l) { lits.push(l) }
    }
  }
  const preds: string[] = []
  for ln in stripped {
    for n in callNames(ln, true) {
      if predHead(n) && hasRepNoun(n) && !hasStr(preds, n) { preds.push(n) }
    }
  }
  let marms = 0
  let hasMatch = false
  for ln in stripped {
    if hasWord(ln, "match") { hasMatch = true }
  }
  if hasMatch {
    for ln in stripped {
      if matchArm(ln) { marms = marms + 1 }
    }
  }
  const counts = [tys.length, nodes.length, lits.length, preds.length, marms]
  const names = ["ARENA-IS", "NODE-IS", "VKIND-LIT", "PREDICATE", "MATCH"]
  let best = 0
  let i = 1
  while i < 5 {
    if (
      counts[i] > counts[best]
      || (counts[i] == counts[best] && strLess(names[best], names[i]))
    ) {
      best = i
    }
    i = i + 1
  }
  { arms: counts[best], shape: names[best] }
}

// Whether a whole word `w` in `s` is followed, past whitespace, by `[` or `.`.
function tableRead(s: string, tables: Map<string, boolean>): boolean {
  let i = 0
  while i < s.length {
    if isWord(s[i]) {
      const e = wordEnd(s, i)
      if tables.has(s.slice(i, e)) {
        const k = skipWs(s, e)
        if k < s.length && (s[k] == '[' || s[k] == '.') { return true }
      }
      i = e
    } else {
      i = i + 1
    }
  }
  false
}

function anyIn(blob: string, tells: readonly string[]): boolean {
  for t in tells {
    if blob.includes(t) { return true }
  }
  false
}

// Whether `sig` declares the parameter `p` (`\bp\s*:`).
function declares(sig: string, p: string): boolean {
  let k = findFrom(sig, p, 0)
  while k >= 0 {
    if k == 0 || !isWord(sig[k - 1]) {
      const c = skipWs(sig, k + p.length)
      if c < sig.length && sig[c] == ':' { return true }
    }
    k = findFrom(sig, p, k + 1)
  }
  false
}

function arenaIs(blob: string): boolean {
  for g in isTests(blob) {
    if startsWith(g, "Ty") && g.length > 2 && isUpper(g[2]) { return true }
  }
  false
}

// The producers the body consults directly, as a mask.
function readsOf(sig: string, stripped: string[], v: Vocab): i32 {
  const blob = join(stripped, "\n")
  let got = 0
  if anyIn(blob, ARENA_TELLS) || arenaIs(blob) { got = got | ARENA }
  if anyIn(blob, NAME_TELLS) { got = got | NAME }
  if anyIn(blob, SPELL_TELLS) { got = got | SPELLING }
  if tableRead(blob, v.tables) { got = got | TABLE }
  if anyIn(blob, FRAME_TELLS) {
    got = got | FRAME
  } else {
    for p in FRAME_PARAMS {
      if declares(sig, p) {
        got = got | FRAME
        break
      }
    }
  }
  got
}

// The mask's names, sorted.
function readNames(m: i32): string[] {
  const out: string[] = []
  if (m & ARENA) != 0 { out.push("ARENA") }
  if (m & FRAME) != 0 { out.push("FRAME") }
  if (m & NAME) != 0 { out.push("NAME") }
  if (m & SPELLING) != 0 { out.push("SPELLING") }
  if (m & TABLE) != 0 { out.push("TABLE") }
  out
}

function bitOf(name: string): i32 {
  if name == "ARENA" { return ARENA }
  if name == "NAME" { return NAME }
  if name == "SPELLING" { return SPELLING }
  if name == "TABLE" { return TABLE }
  if name == "FRAME" { return FRAME }
  0
}

// How many times each name in `counts` is called across compiler/*.vl. A function's own
// header name and the `import { … }` lists are not calls, and neither is `x.name(`.
function callSites(counts: Map<string, i32>) {
  for m in modules(TOOL, ".") {
    let inImport = false
    for ln in lines(m[1]) {
      const s = stripLine(ln)
      if startsWith(s, "import ") {
        inImport = !s.includes("}")
        continue
      }
      if inImport {
        if s.includes("}") { inImport = false }
        continue
      }
      const head = fnHead(s)
      let i = 0
      while i < s.length {
        if isWord(s[i]) {
          const e = wordEnd(s, i)
          if (i == 0 || s[i - 1] != '.') && !(head.name != "" && i == head.a) {
            const n = counts[s.slice(i, e)] ?? -1
            if n >= 0 {
              const k = skipWs(s, e)
              if k < s.length && s[k] == '(' { counts[s.slice(i, e)] = n + 1 }
            }
          }
          i = e
        } else {
          i = i + 1
        }
      }
    }
  }
}

// Each row's `reads` closed over the call graph of every compiler function: what the
// classifier's answer ultimately depends on, where `reads` is where its ladder looks.
function deepReads(rows: Row[], v: Vocab) {
  const names: string[] = []
  const at: Map<string, i32> = Map()
  const sigs: string[] = []
  const bodies: string[][] = []
  for m in modules(TOOL, ".") {
    const ls = lines(m[1])
    for f in functions(ls) {
      const stripped: string[] = []
      let n = f.lo
      while n <= f.hi {
        stripped.push(stripLine(ls[n]))
        n = n + 1
      }
      const sig = signature(ls, f.lo, f.hi)
      const k = at[f.name] ?? -1
      if k < 0 {
        at[f.name] = names.length
        names.push(f.name)
        sigs.push(sig)
        bodies.push(stripped)
      } else {
        sigs[k] = sig
        bodies[k] = stripped
      }
    }
  }
  const reads: i32[] = []
  const edges: i32[][] = []
  let i = 0
  while i < names.length {
    reads.push(readsOf(sigs[i], bodies[i], v))
    const es: i32[] = []
    for ln in bodies[i] {
      for c in callNames(ln, true) {
        const j = at[c] ?? -1
        if j >= 0 && j != i && !es.includes(j) { es.push(j) }
      }
    }
    edges.push(es)
    i = i + 1
  }
  let changed = true
  let rounds = 0
  while changed && rounds < 64 {
    changed = false
    rounds = rounds + 1
    let k = 0
    while k < names.length {
      let r = reads[k]
      for c in edges[k] { r = r | reads[c] }
      if r != reads[k] {
        reads[k] = r
        changed = true
      }
      k = k + 1
    }
  }
  for r in rows {
    const k = at[r.fn] ?? -1
    r.deep = if k >= 0 { reads[k] } else { 0 }
  }
}

type Census = { rows: Row[], considered: i32 }

function census(minArms: i32, all: boolean, v: Vocab): Census {
  const rows: Row[] = []
  let considered = 0
  for m in modules(TOOL, ".") {
    if !inScope(m[0], all) { continue }
    const ls = lines(m[1])
    for f in functions(ls) {
      considered = considered + 1
      const raw = ls.slice(f.lo, f.hi + 1)
      const stripped: string[] = []
      for x in raw { stripped.push(stripLine(x)) }
      const sig = signature(ls, f.lo, f.hi)
      const la = ladderArms(stripped, raw, v)
      const res = resultClass(f.name, sig, raw, v)
      if res == "" { continue }
      // A declared `VKind` return is the rep by its type, so it is admitted at any arm
      // count; `retResultVKind` is the control.
      if res != "VKIND" && la.arms < minArms { continue }
      const shape = if la.arms < minArms { "PROJECTION" } else { la.shape }
      rows.push(
        {
          fn: f.name,
          at: "\{m[0]}:\{f.lo + 1}",
          file: m[0],
          arms: la.arms,
          shape: shape,
          result: res,
          reads: readsOf(sig, stripped, v),
          lines: f.hi - f.lo + 1,
          callers: 0,
          deep: 0,
        },
      )
    }
  }
  const counts: Map<string, i32> = Map()
  for r in rows { counts[r.fn] = 0 }
  callSites(counts)
  for r in rows { r.callers = counts[r.fn] ?? 0 }
  sort(rows, (a: Row, b: Row): boolean => {
    if a.callers != b.callers { return a.callers > b.callers }
    strLess(a.fn, b.fn)
  })
  { rows: rows, considered: considered }
}

function why(target: string, minArms: i32, all: boolean, v: Vocab): i32 {
  for m in modules(TOOL, ".") {
    if !inScope(m[0], all) { continue }
    const ls = lines(m[1])
    for f in functions(ls) {
      if f.name != target { continue }
      const raw = ls.slice(f.lo, f.hi + 1)
      const stripped: string[] = []
      for x in raw { stripped.push(stripLine(x)) }
      const sig = signature(ls, f.lo, f.hi)
      const la = ladderArms(stripped, raw, v)
      const res = resultClass(f.name, sig, raw, v)
      const ret = declaredReturn(sig)
      const reads = readNames(readsOf(sig, stripped, v))
      print("\{target}  \{m[0]}:\{f.lo + 1}  (\{f.hi - f.lo + 1} lines)")
      print("  signature      \{strip(sig)}")
      print("  declared ret   \{if ret == "" { "(inferred)" } else { ret }}")
      print(
        "  ladder         \{la.arms} arms, shape \{la.shape}  (floor \{minArms})",
      )
      print("  result class   \{if res == "" { "NOT REP-ISH" } else { res }}")
      print(
        "  reads          \{if reads.length == 0 { "(none)" } else { join(reads, ", ") }}",
      )
      const verdict = if la.arms >= minArms && res != "" { "CLASSIFIER" } else { "excluded" }
      print("  verdict        \{verdict}")
      return 0
    }
  }
  print("\{target}: no such top-level function in scope")
  1
}

function n2(n: i32, w: i32): string { padL("\{n}", w) }

function col(r: Row, deep: boolean): i32 {
  if deep { r.deep } else { r.reads }
}

function printSummary(
  rows: readonly Row[],
  considered: i32,
  v: Vocab,
  deep: boolean,
) {
  let sites = 0
  for r in rows { sites = sites + r.callers }
  print("population        \{considered} top-level functions in scope")
  print("classifiers       \{rows.length}")
  print("call sites        \{sites}")
  print(
    "vocabularies      VKind \{v.nVkinds} members · Ty arena \{v.nVariants} variants",
  )
  print("")
  print("by result class")
  for k in ["VKIND", "VKIND-LIT", "SLOT", "REPNAME", "REPBOOL"] {
    let n = 0
    let c = 0
    for r in rows {
      if r.result == k {
        n = n + 1
        c = c + r.callers
      }
    }
    if n > 0 {
      print("  \{padR(k, 10)} \{n2(n, 5)} classifiers  \{n2(c, 6)} call sites")
    }
  }
  print("")
  print("by ladder shape")
  for k in ["ARENA-IS", "NODE-IS", "VKIND-LIT", "PREDICATE", "MATCH"] {
    let n = 0
    for r in rows {
      if r.shape == k { n = n + 1 }
    }
    if n > 0 { print("  \{padR(k, 10)} \{n2(n, 5)}") }
  }
  print("")
  const how = if deep { "transitively, --deep" } else { "DIRECTLY" }
  print(
    "by what it READS (\{how}; a classifier may read several, so the sets are not disjoint)",
  )
  for k in ["ARENA", "NAME", "SPELLING", "TABLE", "FRAME"] {
    let n = 0
    let c = 0
    for r in rows {
      if (col(r, deep) & bitOf(k)) != 0 {
        n = n + 1
        c = c + r.callers
      }
    }
    print("  \{padR(k, 10)} \{n2(n, 5)} classifiers  \{n2(c, 6)} call sites")
  }
  print("")
  print("the pairs that matter — a rep answered from two different producers")
  const pairs = [
    ["ARENA", "NAME"],
    ["ARENA", "SPELLING"],
    ["ARENA", "TABLE"],
    ["NAME", "TABLE"],
    ["ARENA", "FRAME"],
  ]
  for p in pairs {
    const both = bitOf(p[0]) | bitOf(p[1])
    let n = 0
    for r in rows {
      if (col(r, deep) & both) == both { n = n + 1 }
    }
    print("  \{p[0]} + \{padR(p[1], 9)} \{n2(n, 5)}")
  }
  print("")
  print("by file")
  const files: string[] = []
  const nOf: i32[] = []
  const cOf: i32[] = []
  for r in rows {
    let k = 0
    while k < files.length && files[k] != r.file { k = k + 1 }
    if k == files.length {
      files.push(r.file)
      nOf.push(0)
      cOf.push(0)
    }
    nOf[k] = nOf[k] + 1
    cOf[k] = cOf[k] + r.callers
  }
  const ord: i32[] = []
  let i = 0
  while i < files.length {
    ord.push(i)
    i = i + 1
  }
  sort(ord, (a: i32, b: i32): boolean => nOf[a] > nOf[b])
  for k in ord {
    print(
      "  \{padR(files[k], 28)} \{n2(nOf[k], 4)} classifiers  \{n2(cOf[k], 6)} call sites",
    )
  }
}

function printTable(rows: readonly Row[], deep: boolean) {
  const name = if deep { "deep" } else { "reads" }
  print(
    "\{padR("classifier", 38)} \{padR("at", 28)} \{padL("arms", 4)} \{padR("shape", 10)} \{padR("result", 10)} \{padL("callers", 7)}  \{name}",
  )
  for r in rows {
    print(
      "\{padR(r.fn, 38)} \{padR(r.at, 28)} \{n2(r.arms, 4)} \{padR(r.shape, 10)} \{padR(r.result, 10)} \{n2(r.callers, 7)}  \{join(readNames(col(r, deep)), "+")}",
    )
  }
}

function jsonList(xs: readonly string[], ind: string): string {
  if xs.length == 0 { return "[]" }
  const parts: string[] = []
  for x in xs { parts.push("\{ind} \{jsonStr(x)}") }
  "[\n\{join(parts, ",\n")}\n\{ind}]"
}

// The rows as `json.dump(indent=1)` writes them.
function printJson(rows: readonly Row[], considered: i32) {
  const out: string[] = []
  for r in rows {
    const f = [
      "   \"fn\": \{jsonStr(r.fn)}",
      "   \"at\": \{jsonStr(r.at)}",
      "   \"file\": \{jsonStr(r.file)}",
      "   \"arms\": \{r.arms}",
      "   \"shape\": \{jsonStr(r.shape)}",
      "   \"result\": \{jsonStr(r.result)}",
      "   \"reads\": \{jsonList(readNames(r.reads), "   ")}",
      "   \"lines\": \{r.lines}",
      "   \"callers\": \{r.callers}",
      "   \"deep\": \{jsonList(readNames(r.deep), "   ")}",
    ]
    out.push("  {\n\{join(f, ",\n")}\n  }")
  }
  const body = if out.length == 0 { "[]" } else { "[\n\{join(out, ",\n")}\n ]" }
  print("{\n \"considered\": \{considered},\n \"rows\": \{body}\n}")
}

type Opts = {
  min: i32,
  summary: boolean,
  reads: string,
  why: string,
  json: boolean,
  deep: boolean,
  all: boolean,
}

const USAGE = "usage: rep-classifier-census.vl [-h] [--min MIN] [--summary] [--reads READS] [--why WHY] [--json] [--deep] [--all-compiler]"

// The options, `--flag value` or `--flag=value`, a repeated one's last value winning.
function parseOpts(args: readonly string[]): Opts {
  const o: Opts = {
    min: 2,
    summary: false,
    reads: "",
    why: "",
    json: false,
    deep: false,
    all: false,
  }
  let i = 0
  while i < args.length {
    let a = args[i]
    let val = ""
    let hasVal = false
    const eq = a.indexOf("=")
    if startsWith(a, "--") && eq > 0 {
      val = a.slice(eq + 1, a.length)
      a = a.slice(0, eq)
      hasVal = true
    }
    if a == "-h" || a == "--help" {
      print(USAGE)
      exit(0)
    }
    if a == "--min" || a == "--reads" || a == "--why" {
      if !hasVal {
        if i + 1 >= args.length {
          die(
            "\{USAGE}\n\{TOOL}: error: argument \{a}: expected one argument",
            2,
          )
        }
        i = i + 1
        val = args[i]
      }
      if a == "--min" {
        const n = parseI32(val)
        if n is i32 {
          o.min = n
        } else {
          die(
            "\{USAGE}\n\{TOOL}: error: argument --min: invalid int value: '\{val}'",
            2,
          )
        }
      }
      if a == "--reads" { o.reads = val }
      if a == "--why" { o.why = val }
    } else if hasVal {
      die(
        "\{USAGE}\n\{TOOL}: error: argument \{a}: ignored explicit argument '\{val}'",
        2,
      )
    } else if a == "--summary" {
      o.summary = true
    } else if a == "--json" {
      o.json = true
    } else if a == "--deep" {
      o.deep = true
    } else if a == "--all-compiler" {
      o.all = true
    } else {
      die("\{USAGE}\n\{TOOL}: error: unrecognized arguments: \{a}", 2)
    }
    i = i + 1
  }
  o
}

function main(args: string[]): i32 {
  const o = parseOpts(args)
  const v = vocab()
  if o.why != "" { return why(o.why, o.min, o.all, v) }
  const c = census(o.min, o.all, v)
  let rows = c.rows
  if o.deep || o.json { deepReads(rows, v) }
  if o.reads != "" {
    const name = if o.deep { "deep" } else { "reads" }
    const want = toUpperAscii(o.reads)
    const bit = bitOf(want)
    const kept: Row[] = []
    for r in rows {
      if bit != 0 && (col(r, o.deep) & bit) != 0 { kept.push(r) }
    }
    rows = kept
    // Every tally below counts the filtered rows against the whole population.
    print("filter            \{name} contains \{want}")
  }
  if o.json {
    printJson(rows, c.considered)
    return 0
  }
  printSummary(rows, c.considered, v, o.deep)
  if !o.summary {
    print("")
    printTable(rows, o.deep)
  }
  0
}

const argv = programArgs()
if argv is Utf8Error {
  die("\{TOOL}: an argument is not UTF-8: \{argv.msg}", 2)
} else {
  exit(main(argv))
}
