// Grades a type-taking twin against the render-then-parse call it replaces, on every arena row.
//
//     vl run scripts/twin-agreement.vl                        # every twin, the kind grid
//     vl run scripts/twin-agreement.vl -- --twins vak --list my-programs.txt
//     vl run scripts/twin-agreement.vl -- --twins vak --rev c114b836f   # the control
//
// It patches a copy of `compiler/` so the top of `emitProgram` asks every `T.tys` row both
// questions, builds that probe from `--seed`, and compiles one program per type kind plus any
// `--list` programs. A program that printed no `TWINSWEEP rows=` count never reached the emitter
// and is UNREACHED, not clean. Exits 1 on a disagreement or an unreached kind program. Rows made
// after the sweep (a monomorphization pin) are never compared: probe the call site for those.
// Run from the checkout root; `--rev` must disagree on every kind.

import { IoError, listDir, writeFile } from "std:fs"
import { Utf8Error, programArgs } from "std:args"
import { exit, runProgram } from "std:process"
import { decodeUtf8Lossy } from "std:utf8"
import { toString } from "std:fmt"
import { endsWith, join, replace, split, startsWith } from "std:str"
import { includes } from "std:array"
import {
  cpAt,
  envOr,
  findFrom,
  isDigit,
  mktempDirArgs,
  splitLines,
  stripWs,
  wsLen,
} from "./lib/common"
import {
  cwd,
  pyRepr,
  readText,
  sortStrings,
  spawn,
  writeText,
} from "./lib/corpus"

// One twin: its name, the compiler file the sweep is appended to, and the statements that
// compare twin and original for row `i` whose render is `nm`, appending
// " [<name> <render> twin=… orig=…]" to `out` when they differ.
type Twin = { name: string, file: string, body: string }

const TWINS: Twin[] = [
  {
    name: "vak",
    file: "emit_classify.vl",
    body: join(
      [
        "    const vak1 = boxTagOfTy(i)",
        "    const vak2 = valueAtomKind(nm)",
        "    if vak1 != vak2 {",
        "      out = out + \" [vak \" + nm + \" twin=\" + i32ToStr(vak1) + \" orig=\" + i32ToStr(vak2) + \"]\"",
        "    }",
      ],
      "\n",
    ),
  },
  // Excluded because the spelling is the wrong answer there: a function whose render ends in
  // `[]`, and a list whose render is "" (a `T[]` over an unbound type variable). The fixtures
  // `*-beside-fn-arm`, `map-or-list-arm-empty-literal` and
  // `list-of-param-arm-narrow-index` pin the call site over both.
  {
    name: "arr",
    file: "emit_classify.vl",
    body: join(
      [
        "    if !(T.tys[i] is TyFunc && nameIsArray(nm)) && !(nm == \"\" && tyIsArray(i)) && tyIsArray(i) != nameIsArray(nm) {",
        "      let arrT = \"0\"",
        "      if tyIsArray(i) { arrT = \"1\" }",
        "      let arrO = \"0\"",
        "      if nameIsArray(nm) { arrO = \"1\" }",
        "      out = out + \" [arr \" + nm + \" twin=\" + arrT + \" orig=\" + arrO + \"]\"",
        "    }",
      ],
      "\n",
    ),
  },
  // The original is the render itself when it spells a primitive, else "".
  {
    name: "tep",
    file: "emit_classify.vl",
    body: join(
      [
        "    const tep1 = primNameStr(tyEmitPrimOf(i))",
        "    let tep2 = \"\"",
        "    if nm == \"i32\" || nm == \"i64\" || nm == \"f32\" || nm == \"f64\" || nm == \"boolean\" || nm == \"string\" || nm == \"void\" || nm == \"null\" || nm == \"never\" || nm == \"u8\" || nm == \"v128\" { tep2 = nm }",
        "    if tep1 != tep2 { out = out + \" [tep \" + nm + \" twin=\" + tep1 + \" orig=\" + tep2 + \"]\" }",
      ],
      "\n",
    ),
  },
]

// [name, prelude, type, a value of it]. Every kind must reach the emitter, which is why the
// grid has no float or boolean literal type (not types) and no `u8` (storage only).
const KINDS: string[][] = [
  ["i32", "", "i32", "3"],
  ["i64", "", "i64", "3"],
  ["f32", "", "f32", "1.5"],
  ["f64", "", "f64", "1.5"],
  ["bool", "", "boolean", "true"],
  ["str", "", "string", "\"s\""],
  ["lit_int", "", "7", "7"],
  ["lit_str", "", "\"a\"", "\"a\""],
  ["lu_int", "", "0 | 1", "1"],
  ["lu_str", "", "\"a\" | \"b\"", "\"a\""],
  ["lu_mixed", "", "1 | \"a\"", "1"],
  ["alias_lu", "type K = 0 | 1\n", "K", "1"],
  ["alias_alias", "type K = 0 | 1\ntype K2 = K\n", "K2", "1"],
  ["alias_str_lu", "type S = \"a\" | \"b\"\n", "S", "\"a\""],
  ["nul_i32", "", "i32 | null", "3"],
  ["nul_f64", "", "f64 | null", "1.5"],
  ["nul_str", "", "string | null", "\"s\""],
  ["nul_lu", "", "(0 | 1) | null", "1"],
  ["nul_lit", "", "7 | null", "7"],
  ["nul_strlu", "", "(\"a\" | \"b\") | null", "\"a\""],
  ["vu", "", "i32 | string", "3"],
  ["vu3", "", "i32 | f64 | boolean", "3"],
  ["vu_nul", "", "i32 | string | null", "3"],
  ["fn", "", "(x: i32) => i32", "(x: i32) => x"],
  ["fn_str", "", "(s: string) => string", "(s: string) => s"],
  ["nul_fn", "", "((x: i32) => i32) | null", "(x: i32) => x"],
  ["map", "", "{ [string]: i32 }", "Map()"],
  ["map_str", "", "{ [string]: string }", "Map()"],
  ["arr_i32", "", "i32[]", "[1]"],
  ["arr_str", "", "string[]", "[\"a\"]"],
  ["arr_f64", "", "f64[]", "[1.5]"],
  ["arr_i64", "", "i64[]", "[1]"],
  ["arr_f32", "", "f32[]", "[1.5]"],
  ["arr_bool", "", "boolean[]", "[true]"],
  ["arr_u8", "", "u8[]", "[1]"],
  ["arr_lu", "", "(\"a\" | \"b\")[]", "[\"a\"]"],
  ["arr_nulstr", "", "(string | null)[]", "[\"a\"]"],
  ["arr_obj", "", "{ x: i32 }[]", "[{ x: 1 }]"],
  ["arr2", "", "i32[][]", "[[1]]"],
  ["arr_nul", "", "i32[] | null", "[1]"],
  ["obj", "", "{ x: i32 }", "{ x: 1 }"],
  ["obj_nul", "", "{ x: i32 } | null", "{ x: 1 }"],
