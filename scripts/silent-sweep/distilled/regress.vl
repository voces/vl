// Grade the distilled census corpus against a seed and diff it cell by cell against the
// baseline. The VL port of `regress.py` and the grading half of `census/gradecensus.py`,
// whose docstrings are the full contract; the two print the same report byte for byte.
//
//     vl run scripts/silent-sweep/distilled/regress.vl -- <seed.wasm> [--baseline F]
//         [--json OUT] [--write-baseline [--set <named-set>]] [--verify-fresh]
//
// Run it from the checkout root: paths resolve against the working directory. Chunks of
// cells are graded `$JOBS` at a time (default 6) by `xargs -P` over a build of this file,
// because `runProgram` waits for its child. Exit 1 only when a `runs` cell stopped running.

import {
  IoError,
  fileSize,
  listDir,
  pathExists,
  pathKind,
  readFile,
  writeTextFile,
} from "std:fs"
import { exit, runProgram } from "std:process"
import { getEnv } from "std:env"
import { programArgs } from "std:args"
import { Utf8Error, decodeUtf8Lossy } from "std:utf8"
import { parseI32, toString } from "std:fmt"
import { join, replaceAll, split, startsWith } from "std:str"
import { Json, JsonError, parseJson } from "std:json"

const HERE = "scripts/silent-sweep/distilled"
const SELF = "scripts/silent-sweep/distilled/regress.vl"
const COMPILER = "build/vl-compiler.wasm"
const CHUNK = 100

type JsonMap = { [string]: Json }

// One graded cell: its outcome class and the normalised message beside it.
type Res = { cls: string, msg: string }

// One `expected.jsonl` row: the census block and how many census cells it stands for.
type Idx = { block: string, represents: i32 }

// Stop with `code` after saying why, on stdout: VL has no stderr sink.
function die(msg: string, code: i32) {
  print(msg)
  exit(code)
}

// ── text helpers: the parts of Python's `str` this file reads with ──────────────────

// The byte length of the whitespace code point at `i` (Python's `str.isspace`), or 0.
function wsLen(s: string, i: i32): i32 {
  if i < 0 || i >= s.length { return 0 }
  const b = s[i]
  if b == 32 || (b >= 9 && b <= 13) || (b >= 28 && b <= 31) { return 1 }
  if b == 0xC2 && i + 1 < s.length {
    if s[i + 1] == 0x85 || s[i + 1] == 0xA0 { return 2 }
    return 0
  }
  if i + 2 >= s.length { return 0 }
  const c = s[i + 1]
  const d = s[i + 2]
  if b == 0xE1 && c == 0x9A && d == 0x80 { return 3 }
  if b == 0xE2 && c == 0x80 {
    if (d >= 0x80 && d <= 0x8A) || d == 0xA8 || d == 0xA9 || d == 0xAF {
      return 3
    }
  }
  if b == 0xE2 && c == 0x81 && d == 0x9F { return 3 }
  if b == 0xE3 && c == 0x80 && d == 0x80 { return 3 }
  0
}

// The byte length of a whitespace code point ending just before `end`, or 0.
function wsLenBefore(s: string, end: i32): i32 {
  let k = 1
  while k <= 3 {
    if end - k >= 0 && wsLen(s, end - k) == k { return k }
    k = k + 1
  }
  0
}

function stripWs(s: string): string {
  let a = 0
  while a < s.length && wsLen(s, a) > 0 { a = a + wsLen(s, a) }
  let b = s.length
  while b > a && wsLenBefore(s, b) > 0 { b = b - wsLenBefore(s, b) }
  s.slice(a, b)
}

// The byte length of the line break at `i` (Python's `str.splitlines` set), or 0.
function breakLen(s: string, i: i32): i32 {
  const b = s[i]
  if b == 13 {
    if i + 1 < s.length && s[i + 1] == 10 { return 2 }
    return 1
  }
  if b == 10 || b == 11 || b == 12 || b == 28 || b == 29 || b == 30 { return 1 }
  if b == 0xC2 && i + 1 < s.length && s[i + 1] == 0x85 { return 2 }
  if b == 0xE2 && i + 2 < s.length && s[i + 1] == 0x80 {
    if s[i + 2] == 0xA8 || s[i + 2] == 0xA9 { return 3 }
  }
  0
}

// Python's `str.splitlines()`: no trailing empty piece, every break kind recognised.
function splitLines(s: string): string[] {
  const out: string[] = []
  let start = 0
  let i = 0
  while i < s.length {
    const n = breakLen(s, i)
    if n > 0 {
      out.push(s.slice(start, i))
      i = i + n
      start = i
    } else {
      i = i + 1
    }
  }
  if start < s.length { out.push(s.slice(start, s.length)) }
  out
}

// Text as Python's universal-newline reader hands it over: every `\r\n` and `\r` is `\n`.
function univNl(s: string): string {
  replaceAll(replaceAll(s, "\r\n", "\n"), "\r", "\n")
}

// The first `n` code points of `s`, which is what a Python slice `[:n]` keeps.
function cpPrefix(s: string, n: i32): string {
  let seen = 0
  let i = 0
  while i < s.length {
    if (s[i] & 0xC0) != 0x80 {
      if seen == n { return s.slice(0, i) }
      seen = seen + 1
    }
    i = i + 1
  }
  s
}

// The byte index of `needle` in `s` at or after `from`, or -1.
function findFrom(s: string, needle: string, from: i32): i32 {
  let i = from
  while i + needle.length <= s.length {
    let j = 0
    while j < needle.length && s[i + j] == needle[j] { j = j + 1 }
    if j == needle.length { return i }
    i = i + 1
  }
  -1
}

function anyIn(s: string, needles: string[]): boolean {
  for n in needles {
    if findFrom(s, n, 0) >= 0 { return true }
  }
  false
}

// `s` padded with spaces to `w` code points, on the right (`<w`) or the left (`>w`).
function padRight(s: string, w: i32): string {
  let out = s
  let n = s.cpLen()
  while n < w {
    out = out + " "
    n = n + 1
  }
  out
}

function padLeft(s: string, w: i32): string {
  let out = s
  let n = s.cpLen()
  while n < w {
    out = " " + out
    n = n + 1
  }
  out
}

function isDigit(b: i32): boolean { b >= 48 && b <= 57 }

// `xs` in byte order, which for UTF-8 is Python's code-point order. A hand merge sort
// rather than `std:array`'s `sort`, whose comparator lambda makes the compiler trap (D4290).
function sortStrings(xs: string[]): string[] {
  if xs.length <= 1 { return xs }
  const mid = xs.length / 2
  const a = sortStrings(xs.slice(0, mid))
  const b = sortStrings(xs.slice(mid, xs.length))
  const out: string[] = []
  let i = 0
  let j = 0
  while i < a.length || j < b.length {
    if j >= b.length || (i < a.length && !(b[j] < a[i])) {
      out.push(a[i])
      i = i + 1
    } else {
      out.push(b[j])
      j = j + 1
    }
  }
  out
}

// ── Python's spellings of a string: `json.dumps` and `repr` ──────────────────────────

function hexDigits(v: i32, n: i32): string {
  const digits = "0123456789abcdef"
  let out = ""
  let k = n - 1
  while k >= 0 {
    const d = (v >> (k * 4)) & 15
    out = out + digits.slice(d, d + 1)
    k = k - 1
  }
  out
}

// The code point starting at byte `i` and its byte length, of valid UTF-8.
type Cp = { cp: i32, n: i32 }

function cpAt(s: string, i: i32): Cp {
  const b = s[i]
  if b < 0x80 { return { cp: b, n: 1 } }
  let cp = 0
  let n = 1
  if b >= 0xF0 {
    n = 4
    cp = b & 7
  } else if b >= 0xE0 {
    n = 3
    cp = b & 15
  } else {
    n = 2
    cp = b & 31
  }
  let k = 1
  while k < n && i + k < s.length {
    cp = (cp << 6) | (s[i + k] & 63)
    k = k + 1
  }
  { cp: cp, n: n }
}

function uEsc(cp: i32): string { "\\u" + hexDigits(cp, 4) }

// `json.dumps(s)` with its default `ensure_ascii`: everything outside space..`~` escaped.
function jsonStr(s: string): string {
  const parts = ["\""]
  let i = 0
  while i < s.length {
    const b = s[i]
    if b < 0x80 {
      if b == 34 { parts.push("\\\"") }
      else if b == 92 { parts.push("\\\\") }
      else if b == 10 { parts.push("\\n") }
      else if b == 13 { parts.push("\\r") }
      else if b == 9 { parts.push("\\t") }
      else if b == 8 { parts.push("\\b") }
      else if b == 12 { parts.push("\\f") }
      else if b < 32 || b == 127 { parts.push(uEsc(b)) }
      else { parts.push(s.slice(i, i + 1)) }
      i = i + 1
      continue
    }
    const c = cpAt(s, i)
    if c.cp > 0xFFFF {
      const v = c.cp - 0x10000
      parts.push(uEsc(0xD800 | (v >> 10)))
      parts.push(uEsc(0xDC00 | (v & 0x3FF)))
    } else {
      parts.push(uEsc(c.cp))
    }
    i = i + c.n
  }
  parts.push("\"")
  join(parts, "")
}

// Whether Python's `str.isprintable` refuses the non-ASCII code point `cp`: the
// separators, format and control characters, surrogates and private use. Unassigned
// code points, which Python also refuses, are not tabled.
function unprintable(cp: i32): boolean {
  if cp <= 0xA0 || cp == 0xAD || cp == 0x1680 || cp == 0x3000 { return true }
  if (cp >= 0x600 && cp <= 0x605) || cp == 0x61C || cp == 0x6DD || cp == 0x70F {
    return true
  }
  if cp == 0x180E || (cp >= 0x2000 && cp <= 0x200F) { return true }
  if (cp >= 0x2028 && cp <= 0x202F) || (cp >= 0x205F && cp <= 0x206F) {
    return true
  }
  if (cp >= 0xD800 && cp <= 0xF8FF) || cp == 0xFEFF { return true }
  if cp >= 0xFFF9 && cp <= 0xFFFB { return true }
  cp == 0xE0001 || (cp >= 0xE0020 && cp <= 0xE007F) || cp >= 0xF0000
}

// `repr(s)` for a `str`, as `%r` prints it.
function pyRepr(s: string): string {
  let q = 39
  if findFrom(s, "'", 0) >= 0 && findFrom(s, "\"", 0) < 0 { q = 34 }
  const qs = s.slice(0, 0) + (if q == 39 { "'" } else { "\"" })
  const parts = [qs]
  let i = 0
  while i < s.length {
    const b = s[i]
    if b < 0x80 {
      if b == q || b == 92 { parts.push("\\" + s.slice(i, i + 1)) }
      else if b == 9 { parts.push("\\t") }
      else if b == 10 { parts.push("\\n") }
      else if b == 13 { parts.push("\\r") }
      else if b < 32 || b == 127 { parts.push("\\x" + hexDigits(b, 2)) }
      else { parts.push(s.slice(i, i + 1)) }
      i = i + 1
      continue
    }
    const c = cpAt(s, i)
    if !unprintable(c.cp) { parts.push(s.slice(i, i + c.n)) }
    else if c.cp <= 0xFF { parts.push("\\x" + hexDigits(c.cp, 2)) }
    else if c.cp <= 0xFFFF { parts.push("\\u" + hexDigits(c.cp, 4)) }
    else { parts.push("\\U" + hexDigits(c.cp, 8)) }
    i = i + c.n
  }
  parts.push(qs)
  join(parts, "")
}

// ── the grader's message normaliser ──────────────────────────────────────────────

// The end of `\.vl:\d+:\d+:?` starting at byte `q`, or -1 when it does not match there.
function vlPosEnd(s: string, q: i32): i32 {
  if !startsWith(s.slice(q, s.length), ".vl:") { return -1 }
  let i = q + 4
  const d0 = i
  while i < s.length && isDigit(s[i]) { i = i + 1 }
  if i == d0 || i >= s.length || s[i] != 58 { return -1 }
  i = i + 1
  const d1 = i
  while i < s.length && isDigit(s[i]) { i = i + 1 }
  if i == d1 { return -1 }
  if i < s.length && s[i] == 58 { i = i + 1 }
  i
}

// `re.sub(r"\S*\.vl:\d+:\d+:?", "", m)` over text whose only whitespace is a space: each
// space-free run loses its prefix through the rightmost `.vl:<line>:<col>` it holds.
function dropVlPos(m: string): string {
  const parts: string[] = []
  let p = 0
  while p < m.length {
    if m[p] == 32 {
      parts.push(" ")
      p = p + 1
      continue
    }
    let e = p
    while e < m.length && m[e] != 32 { e = e + 1 }
    let cut = -1
    let q = e - 1
    while q >= p && cut < 0 {
      cut = vlPosEnd(m, q)
      q = q - 1
    }
    if cut < 0 {
      parts.push(m.slice(p, e))
      p = e
    } else {
      p = cut
    }
  }
  join(parts, "")
}

// `<word>\d+<close>` → `<word>N<close>` at every match, as `re.sub` rewrites it.
function numbersToN(m: string, word: string, close: string): string {
  const parts: string[] = []
  let from = 0
  let at = findFrom(m, word, 0)
  while at >= 0 {
    let i = at + word.length
    const d0 = i
    while i < m.length && isDigit(m[i]) { i = i + 1 }
    if i > d0 && startsWith(m.slice(i, m.length), close) {
      parts.push(m.slice(from, at))
      parts.push(word + "N" + close)
      from = i + close.length
      at = findFrom(m, word, from)
    } else {
      at = findFrom(m, word, at + 1)
    }
  }
  parts.push(m.slice(from, m.length))
  join(parts, "")
}

// The grader's `norm`: whitespace collapsed, offsets and function indices and source
// positions erased, cut to 220 code points.
function norm(msg: string): string {
  const words: string[] = []
  let i = 0
  while i < msg.length {
    while i < msg.length && wsLen(msg, i) > 0 { i = i + wsLen(msg, i) }
    const a = i
    while i < msg.length && wsLen(msg, i) == 0 { i = i + 1 }
    if i > a { words.push(msg.slice(a, i)) }
  }
  let m = join(words, " ")
  m = numbersToN(m, "offset ", "")
  m = numbersToN(m, "function[", "]")
  m = dropVlPos(m)
  cpPrefix(stripWs(m), 220)
}

// ── processes and files ──────────────────────────────────────────────────────────

// Exit code and both streams of one child, decoded as Python's `text=True` does.
type Proc = { code: i32, out: string, err: string }

function spawn(cmd: string, args: string[]): Proc {
  const r = runProgram(cmd, args)
  if r is IoError {
    die("regress: cannot run \{cmd} (\{r.msg})", 1)
    return { code: -1, out: "", err: "" }
  }
  {
    code: r.code,
    out: univNl(decodeUtf8Lossy(r.stdout)),
    err: univNl(decodeUtf8Lossy(r.stderr)),
  }
}

function readText(path: string): string {
  const t = readFile(path)
  if t is IoError {
    die("regress: cannot read \{path} (\{t.msg})", 1)
    return ""
  }
  univNl(decodeUtf8Lossy(t))
}

function writeText(path: string, text: string) {
  const w = writeTextFile(path, text)
  if w != null { die("regress: cannot write \{path} (\{w.msg})", 1) }
}

function exists(path: string): boolean {
  const e = pathExists(path)
  if e is IoError { return false }
  e
}

function isDir(path: string): boolean {
  const k = pathKind(path)
  if k is IoError { return false }
  k == "dir"
}

// Narrowed before the compare: `pathKind(p) == "file"` refuses at emit (D4340).
function isFile(path: string): boolean {
  const k = pathKind(path)
  if k is IoError { return false }
  k == "file"
}

function firstLine(s: string): string {
  const ls = splitLines(s)
  if ls.length == 0 { return "" }
  ls[0]
}

// The `*.vl` basenames of `dir`, without the extension, as `glob` lists them.
function cellsIn(dir: string): string[] {
  const out: string[] = []
  if !isDir(dir) { return out }
  const names = listDir(dir)
  if names is IoError { return out }
  for n in names {
    if (
      n.length > 3
      && !startsWith(n, ".")
      && n.slice(n.length - 3, n.length) == ".vl"
    ) {
      out.push(n.slice(0, n.length - 3))
    }
  }
  out
}

function parseOrDie(text: string, what: string): Json {
  const j = parseJson(text)
  if j is JsonError {
    die("regress: \{what} is not JSON: \{j.msg}", 1)
    return null
  }
  j
}

function strField(m: JsonMap, key: string): string {
  const v = m[key]
  if v is string { return v }
  ""
}

function numField(m: JsonMap, key: string): f64 {
  const v = m[key]
  if v is f64 { return v }
  0.0
}

// ── the corpus files, one JSON object per line ──────────────────────────────────────

// A Python `json.dumps` of a value read back from a cellmap file: integral numbers as
// integers, maps in the order they were read.
function dumpJson(v: Json): string {
  if v == null { return "null" }
  if v is boolean {
    if v { return "true" }
    return "false"
  }
  if v is string { return jsonStr(v) }
  if v is f64 {
    const n = v as? i64
    if n != null { return toString(n) }
    return toString(v)
  }
  if v is JsonMap {
    const parts: string[] = []
    for k, x in v { parts.push(jsonStr(k) + ": " + dumpJson(x)) }
    return "{" + join(parts, ", ") + "}"
  }
  const items: string[] = []
  if v is Json[] {
    for x in v { items.push(dumpJson(x)) }
  }
  "[" + join(items, ", ") + "]"
}

// `cellmap.load_cells`: every non-blank line one object, keyed by its `cell`.
function loadCells(path: string): Map<string, JsonMap> {
  const out: Map<string, JsonMap> = Map()
  for line in readText(path).split("\n") {
    if stripWs(line) == "" { continue }
    const rec = parseOrDie(line, path)
    if rec is JsonMap {
      out[strField(rec, "cell")] = rec
    } else {
      die("regress: a line of \{path} is not an object", 1)
    }
  }
  out
}

// `cellmap.dump_cells`: sorted by cell, `cell` first and the other keys sorted.
function dumpCells(path: string, cells: Map<string, JsonMap>) {
  const lines: string[] = []
  for c in sortStrings(cells.keys()) {
    const rec = cells[c]
    if rec == null { continue }
    const keys: string[] = []
    for k in rec.keys() {
      if k != "cell" { keys.push(k) }
    }
    const parts = ["\"cell\": " + jsonStr(c)]
    for k in sortStrings(keys) {
      parts.push(jsonStr(k) + ": " + dumpJson(rec[k] ?? null))
    }
    lines.push("{" + join(parts, ", ") + "}\n")
  }
  writeText(path, join(lines, ""))
}

function idxOf(rec: JsonMap): Idx {
  {
    block: strField(rec, "block"),
    represents: numField(rec, "represents") as! i32,
  }
}

// ── the corpus index, as `index.py` audits and writes it ────────────────────────────

const DERIVED = ["A", "B", "C", "D", "E"]

function isDerived(block: string): boolean {
  for d in DERIVED {
    if d == block { return true }
  }
  false
}

// The three ways the index and the corpus can disagree, each sorted.
type Gaps = { missing: string[], orphan: string[], unsourced: string[] }

function sourceNames(): Map<string, boolean> {
  const out: Map<string, boolean> = Map()
  const path = HERE + "/named/sources.json"
  if !exists(path) { return out }
  const j = parseOrDie(readText(path), path)
  if j is JsonMap {
    for k in j.keys() { out[k] = true }
  }
  out
}

function diskCells(): Map<string, boolean> {
  const out: Map<string, boolean> = Map()
  for c in cellsIn(HERE + "/cells") { out[c] = true }
  for c in cellsIn(HERE + "/named") { out[c] = true }
  out
}

function audit(): Gaps {
  const idx = loadCells(HERE + "/expected.jsonl")
  const disk = diskCells()
  const sources = sourceNames()
  const missing: string[] = []
  for c in disk.keys() {
    if !idx.has(c) { missing.push(c) }
  }
  const orphan: string[] = []
  const blocks: Map<string, boolean> = Map()
  for c, rec in idx {
    if !disk.has(c) { orphan.push(c) }
    const b = strField(rec, "block")
    if !isDerived(b) && !sources.has(b) { blocks[b] = true }
  }
  {
    missing: sortStrings(missing),
    orphan: sortStrings(orphan),
    unsourced: sortStrings(blocks.keys()),
  }
}

function firstEight(xs: string[]): string {
  const shown: string[] = []
  for x in xs {
    if shown.length < 8 { shown.push(x) }
  }
  let s = join(shown, ", ")
  if xs.length > 8 { s = s + ", … and " + toString(xs.length - 8) + " more" }
  s
}

// `index.complaint`: the loud sentence for a failing audit, or "".
function complaint(a: Gaps): string {
  if a.missing.length == 0 && a.orphan.length == 0 && a.unsourced.length == 0 {
    return ""
  }
  const out = [
    "distilled: THE CORPUS INDEX IS INCOMPLETE — expected.jsonl does not describe the cells this run would grade, and grading anyway means defaulting an answer nobody computed.",
  ]
  if a.missing.length > 0 {
    out.push(
      "  \{toString(a.missing.length)} cell(s) on disk with NO row: "
        + firstEight(a.missing),
    )
    out.push(
      "    fix: python3 index.py --set <named-set> --missing   (a curated set),",
    )
    out.push(
      "         or python3 redistil.py                        (a derived cell),",
    )
    out.push(
      "         or regress.py --write-baseline --set <named-set> in one move.",
    )
  }
  if a.orphan.length > 0 {
    out.push(
      "  \{toString(a.orphan.length)} row(s) with NO cell: "
        + firstEight(a.orphan),
    )
    out.push("    fix: python3 index.py --prune, or restore the missing `.vl`.")
  }
  if a.unsourced.length > 0 {
    out.push(
      "  \{toString(a.unsourced.length)} curated block(s) with no `named/sources.json` entry: "
        + join(a.unsourced, ", "),
    )
    out.push(
      "    fix: add the set's provenance — what named it and what it cost.",
    )
  }
  join(out, "\n")
}

// `index.prune`: drop the rows whose `.vl` is gone, and answer how many went.
function prune(): i32 {
  const path = HERE + "/expected.jsonl"
  const idx = loadCells(path)
  const disk = diskCells()
  const kept: Map<string, JsonMap> = Map()
  let gone = 0
  for c, rec in idx {
    if disk.has(c) { kept[c] = rec } else { gone = gone + 1 }
  }
  if gone > 0 { dumpCells(path, kept) }
  gone
}

// `index.write_set`: a curated row for each named cell; refuses an unknown set, a
// derived cell and a cell that is not on disk, as the Python's `SystemExit` does.
function writeSet(block: string, names: string[]): i32 {
  if !sourceNames().has(block) {
    die(
      "index: `\{block}` has no `named/sources.json` entry. A curated set carries its provenance there — what named it and what it cost — before it carries index rows.",
      1,
    )
  }
  const derived: Map<string, boolean> = Map()
  for c in cellsIn(HERE + "/cells") { derived[c] = true }
  const bad: string[] = []
  for n in names {
    if derived.has(n) { bad.push(n) }
  }
  if bad.length > 0 {
    die(
      "index: \{join(sortStrings(bad), ", ")} live in cells/, the DERIVED half. Their rows come from redistil.py, never from a named set.",
      1,
    )
  }
  const onDisk: Map<string, boolean> = Map()
  for c in cellsIn(HERE + "/named") { onDisk[c] = true }
  const gone: string[] = []
  for n in names {
    if !onDisk.has(n) { gone.push(n) }
  }
  if gone.length > 0 {
    const g = sortStrings(gone)
    die(
      "index: no `named/\{g[0]}.vl` (and \{toString(g.length - 1)} more). A row for a cell that is not there is the orphan half of the same defect.",
      1,
    )
  }
  const path = HERE + "/expected.jsonl"
  const idx = loadCells(path)
  for n in names {
    const rec: JsonMap = Map()
    rec["block"] = block
    rec["represents"] = 1.0
    idx[n] = rec
  }
  dumpCells(path, idx)
  names.length
}

// ── grading one cell, as `gradecensus.py` does ───────────────────────────────────────

const INVALID = [
  "Invalid input WebAssembly code", "WebAssembly translation error",
  "wasm validation", "failed to parse",
]
const TRAP = [
  "wasm trap", "unreachable", "out of bounds", "divide by zero",
  "null reference", "cast failure", "integer overflow",
]
const EMIT = [
  "emit error", "emitProgram:", "emitFail", "unsupported statement",
  "unsupported expression",
]

// What a chunk worker needs: the binary, the seed, `std/`, the part and its scratch dir.
type Ctx = { vl: string, seed: string, std: string, part: string, tmp: string }

// `vl` on the cells under `VL_STD`, bounded at `secs` as the Python's `timeout=` is; a
// `timeout` exit of 124 is the Python's `TimeoutExpired`.
function vlStd(c: Ctx, secs: string, args: string[]): Proc {
  const full = ["VL_STD=" + c.std, "timeout", secs, c.vl]
  for a in args { full.push(a) }
  spawn("env", full)
}

function wrongValue(exp: string, got: string): Res {
  {
    cls: "runs but wrong value",
    msg: "want " + pyRepr(exp) + " got " + pyRepr(cpPrefix(got, 80)),
  }
}

// The grader's `one`: check, run and, for a trap, build, each in its own process.
function gradeOne(c: Ctx, name: string, exp: string): Res {
  const f = c.part + "/" + name + ".vl"
  const chk = vlStd(c, "120", ["check", f, "--compiler", c.seed])
  if chk.code == 124 { return { cls: "compiler trap", msg: "check timeout" } }
  const cout = chk.out + chk.err
  let errLine = ""
  let hasErr = false
  for l in splitLines(cout) {
    if !hasErr && startsWith(l, "[ERROR]") {
      hasErr = true
      errLine = l
    }
  }
  if hasErr || chk.code != 0 {
    if hasErr { return { cls: "loud check reject", msg: norm(errLine) } }
    return { cls: "loud check reject", msg: norm(cout) }
  }
  const r = vlStd(c, "120", ["run", f, "--compiler", c.seed])
  if r.code == 124 { return { cls: "compiler trap", msg: "run timeout" } }
  if r.code == 0 {
    const got = stripWs(r.out)
    if got == exp { return { cls: "runs", msg: "" } }
    return wrongValue(exp, got)
  }
  const rerr = r.err + r.out
  if anyIn(rerr, EMIT) { return { cls: "loud emit reject", msg: norm(rerr) } }
  if anyIn(rerr, INVALID) {
    return { cls: "check-clean invalid wasm", msg: norm(rerr) }
  }
  if anyIn(rerr, TRAP) {
    const w = c.tmp + "/" + name + ".o.wasm"
    spawn("timeout", ["120", c.vl, "build", f, "--compiler", c.seed, "-o", w])
    let wrote = false
    const sz = fileSize(w)
    if sz is i64 { wrote = sz > 0 }
    if !wrote { return { cls: "compiler trap", msg: norm(rerr) } }
    return { cls: "trap_loads", msg: norm(rerr) }
  }
  { cls: "check-clean invalid wasm", msg: norm(rerr) }
}

// The grader's `batch_check`: one process for the chunk; a cell it cannot classify
// exactly as `one` would is left out of `res` and out of `clean`.
function batchCheck(c: Ctx, names: string[], res: Map<string, Res>): string[] {
  const clean: string[] = []
  const args = ["check", "--batch", "--json"]
  for n in names { args.push(c.part + "/" + n + ".vl") }
  args.push("--compiler")
  args.push(c.seed)
  const p = vlStd(c, "600", args)
  if p.code == 124 { return clean }
  const recs: JsonMap[] = []
  for l in splitLines(p.out) {
    if stripWs(l) == "" { continue }
    const j = parseOrDie(l, "a `vl check --batch --json` line")
    if j is JsonMap {
      recs.push(j)
    } else {
      die("regress: a check record is not an object", 1)
    }
  }
  if recs.length != names.length { return clean }
  let k = 0
  while k < names.length {
    const r = recs[k]
    const errs: string[] = []
    const ds = r["diagnostics"]
    if ds is Json[] {
      for d in ds {
        if d is JsonMap {
          if strField(d, "severity") == "error" {
            errs.push(strField(d, "message"))
          }
        }
      }
    }
    const code = numField(r, "exit")
    if code == 0.0 && errs.length == 0 {
      clean.push(names[k])
    } else if code == 1.0 && errs.length > 0 {
      res[names[k]] = {
        cls: "loud check reject",
        msg: norm("[ERROR]: " + firstLine(errs[0])),
      }
    }
    k = k + 1
  }
  clean
}

// The grader's `batch_run` over the check-clean cells of a chunk.
function batchRun(
  c: Ctx,
  names: string[],
  expect: Map<string, string>,
  res: Map<string, Res>,
) {
  const od = c.tmp + "/run"
  spawn("mkdir", ["-p", od])
  const args = ["run", "--batch", "--out-dir", od]
  for n in names { args.push(c.part + "/" + n + ".vl") }
  args.push("--compiler")
  args.push(c.seed)
  const p = vlStd(c, "600", args)
  if p.code == 124 { return 0 }
  for n in names {
    const o = od + "/" + n + ".vl.out"
    const e = od + "/" + n + ".vl.err"
    if !exists(o) { continue }
    const got = readText(o)
    const exp = expect[n] ?? ""
    if !exists(e) {
      const g = stripWs(got)
      if g == exp {
        res[n] = { cls: "runs", msg: "" }
      } else {
        res[n] = wrongValue(exp, g)
      }
      continue
    }
    const rerr = "Error: " + readText(e) + got
    if anyIn(rerr, EMIT) {
      res[n] = { cls: "loud emit reject", msg: norm(rerr) }
    }
  }
  0
}

// ── the chunk worker: `--grade-chunk <file>` ─────────────────────────────────────────

// A chunk file is six header lines (vl, seed, std, part, scratch, batch flag) and then one
// cell per two lines, its name and its expected stdout as a JSON string. The answer goes
// to `<file>.out`, one `name\tclass\tmsg` line per cell.
function gradeChunk(file: string) {
  const lines = readText(file).split("\n")
  const c: Ctx = {
    vl: lines[0],
    seed: lines[1],
    std: lines[2],
    part: lines[3],
    tmp: lines[4],
  }
  const batch = lines[5] == "1"
  const names: string[] = []
  const expect: Map<string, string> = Map()
  let k = 6
  while k + 1 < lines.length {
    const e = parseOrDie(lines[k + 1], file)
    if e is string {
      expect[lines[k]] = e
    } else {
      die("regress: a chunk expectation is not a string", 1)
    }
    names.push(lines[k])
    k = k + 2
  }
  const res: Map<string, Res> = Map()
  if batch {
    const clean = batchCheck(c, names, res)
    if clean.length > 0 { batchRun(c, clean, expect, res) }
  }
  const out: string[] = []
  for n in names {
    let r = res[n]
    if r == null { r = gradeOne(c, n, expect[n] ?? "") }
    out.push(n + "\t" + r.cls + "\t" + r.msg + "\n")
  }
  writeText(file + ".out", join(out, ""))
}

// ── the parent: stage chunks, fan them out, read the answers back ────────────────────

function makeTempDir(): string {
  const p = spawn("mktemp", ["-d"])
  if p.code != 0 { die("regress: mktemp -d failed: " + p.err, 1) }
  stripWs(p.out)
}

function cwd(): string {
  const p = spawn("pwd", ["-P"])
  if p.code != 0 { die("regress: pwd failed: " + p.err, 1) }
  stripWs(p.out)
}

function envOr(name: string, dflt: string): string {
  const v = getEnv(name)
  if v is string { return v }
  dflt
}

// A chunk staged for a worker, and the part it belongs to.
type Chunk = { file: string, part: string }

// Stage every chunk of `part` (a `cells`/`named` directory name) under `root`, sorted
// by cell as the grader's `sorted(EXPECT)` is.
function stagePart(
  root: string,
  abs: string,
  part: string,
  seed: string,
  batch: boolean,
  chunks: Chunk[],
) {
  const dir = abs + "/" + HERE + "/" + part
  const man = parseOrDie(
    readText(dir + "/manifest.json"),
    dir + "/manifest.json",
  )
  const expect: Map<string, string> = Map()
  if man is JsonMap {
    const e = man["expect"]
    if e is JsonMap {
      for k, v in e {
        if v is string { expect[k] = v }
      }
    }
  }
  const names = sortStrings(expect.keys())
  let size = CHUNK
  if !batch { size = 1 }
  const vl = envOr("VL", "scripts/vl-host/target/release/vl")
  let flag = "0"
  if batch { flag = "1" }
  let at = 0
  const dirs: string[] = ["-p"]
  const pending: string[] = []
  while at < names.length {
    const tmp = root + "/" + part + "-" + toString(chunks.length)
    const body = [vl, seed, abs + "/std", dir, tmp, flag]
    let k = 0
    while k < size && at < names.length {
      body.push(names[at])
      body.push(jsonStr(expect[names[at]] ?? ""))
      at = at + 1
      k = k + 1
    }
    dirs.push(tmp)
    pending.push(tmp + "/chunk")
    pending.push(join(body, "\n"))
    chunks.push({ file: tmp + "/chunk", part: part })
  }
  if dirs.length > 1 {
    const p = spawn("mkdir", dirs)
    if p.code != 0 { die("regress: mkdir failed: " + p.out + p.err, 1) }
  }
  let k = 0
  while k < pending.length {
    writeText(pending[k], pending[k + 1])
    k = k + 2
  }
}

function jobsFromEnv(): i32 {
  const j = envOr("JOBS", "6")
  const n = parseI32(stripWs(j))
  if n == null { die("regress: JOBS is not an integer: " + j, 1) }
  n ?? 6
}

// Grade both halves of the corpus against `seed`, or answer the failure's exit code.
type Graded = { now: Map<string, Res>, rc: i32 }

function gradeCorpus(seed: string, out: string): Graded {
  const now: Map<string, Res> = Map()
  const abs = cwd()
  const root = makeTempDir()
  const batch = envOr("GRADE_BATCH", "1") != "0"
  const chunks: Chunk[] = []
  const parts: string[] = []
  for part in ["cells", "named"] {
    if cellsIn(HERE + "/" + part).length > 0 {
      parts.push(part)
      stagePart(root, abs, part, seed, batch, chunks)
    }
  }
  if chunks.length > 0 {
    const grader = root + "/grader.wasm"
    const b = spawn(
      envOr("VL", "scripts/vl-host/target/release/vl"),
      ["build", SELF, "--compiler", COMPILER, "-o", grader],
    )
    if b.code != 0 {
      die("regress: cannot build \{SELF}:\n" + b.out + b.err, 1)
    }
    const files: string[] = []
    for ch in chunks { files.push(ch.file) }
    writeText(root + "/chunks", join(files, "\n") + "\n")
    const x = spawn(
      "xargs",
      [
        "-a",
        root + "/chunks",
        "-d",
        "\\n",
        "-P",
        toString(jobsFromEnv()),
        "-n",
        "1",
        envOr("VL", "scripts/vl-host/target/release/vl"),
        "run",
        grader,
        "--",
        "--grade-chunk",
      ],
    )
    if x.code != 0 {
      let part = chunks[0].part
      for ch in chunks {
        if !exists(ch.file + ".out") { part = ch.part }
      }
      print(
        "distilled: the grader itself failed on \{part}/ (rc=\{toString(x.code)})",
      )
      spawn("rm", ["-rf", root])
      return { now: now, rc: x.code }
    }
  }
  for part in parts {
    const mine: Map<string, Res> = Map()
    for ch in chunks {
      if ch.part != part { continue }
      for l in readText(ch.file + ".out").split("\n") {
        if l == "" { continue }
        const f = l.split("\t")
        mine[f[0]] = { cls: f[1], msg: f[2] }
        now[f[0]] = { cls: f[1], msg: f[2] }
      }
    }
    writeText(out + "." + part, gradeJson(mine))
  }
  spawn("rm", ["-rf", root])
  { now: now, rc: 0 }
}

// `json.dump(res, indent=0, sort_keys=True)`, the grader's own output file.
function gradeJson(res: Map<string, Res>): string {
  if res.length == 0 { return "{}" }
  const parts: string[] = []
  for c in sortStrings(res.keys()) {
    const r = res[c] ?? { cls: "", msg: "" }
    parts.push(
      jsonStr(c)
        + ": {\n\"class\": "
        + jsonStr(r.cls)
        + ",\n\"msg\": "
        + jsonStr(r.msg)
        + "\n}",
    )
  }
  "{\n" + join(parts, ",\n") + "\n}"
}

// `json.dump(now, indent=1, sort_keys=True)`, the `--json` file.
function lastJson(res: Map<string, Res>, cells: string[]): string {
  if cells.length == 0 { return "{}" }
  const parts: string[] = []
  for c in cells {
    const r = res[c] ?? { cls: "", msg: "" }
    parts.push(
      " "
        + jsonStr(c)
        + ": {\n  \"class\": "
        + jsonStr(r.cls)
        + ",\n  \"msg\": "
        + jsonStr(r.msg)
        + "\n }",
    )
  }
  "{\n" + join(parts, ",\n") + "\n}"
}

// ── the report ─────────────────────────────────────────────────────────────────

const SILENT = [
  "runs but wrong value", "check-clean invalid wasm", "compiler trap",
  "trap_loads",
]

function isSilent(cls: string): boolean {
  for s in SILENT {
    if s == cls { return true }
  }
  false
}

// One moved cell: its id, the class it had and has, and the census cells it stands for.
type Move = { cell: string, was: string, now: string, weight: i32 }

function show(title: string, rows: Move[], pop: i32) {
  let n = 0
  for r in rows { n = n + r.weight }
  print(
    "  \{padRight(title, 28)} \{padLeft(toString(rows.length), 4)} classes  (\{padLeft(toString(n), 6)} of \{toString(pop)} census cells)",
  )
  let k = 0
  while k < rows.length && k < 12 {
    const r = rows[k]
    print(
      "      \{r.cell}  \{r.was} -> \{r.now}   [\{toString(r.weight)} cells]",
    )
    k = k + 1
  }
  if rows.length > 12 {
    print("      … and \{toString(rows.length - 12)} more")
  }
}

// The value after `flag` anywhere in `args`, or `dflt` when the flag is absent.
function flagArg(args: string[], flag: string, dflt: string): string {
  let k = 0
  while k < args.length {
    if args[k] == flag {
      if k + 1 >= args.length { die("regress: \{flag} needs a value", 1) }
      return args[k + 1]
    }
    k = k + 1
  }
  dflt
}

function hasFlag(args: string[], flag: string): boolean {
  for a in args {
    if a == flag { return true }
  }
  false
}

const USAGE = "usage: vl run scripts/silent-sweep/distilled/regress.vl -- <seed.wasm> [--baseline F] [--json OUT]\n           [--write-baseline [--set <named-set>]] [--verify-fresh]\nRun from the checkout root; `$JOBS` chunks at a time (default 6).\nExit 1 only when a cell went `runs` -> not-runs, or under --verify-fresh when any cell moved;\n2 on a usage error or an incomplete corpus index."

function mainReport(args: string[]): i32 {
  if args.length < 1 {
    print(USAGE)
    return 2
  }
  const seed = args[0]
  if startsWith(seed, "-") || !isFile(seed) {
    print(
      "regress.py: argv[1] is the SEED wasm, and \{pyRepr(seed)} is not a file — usage: regress.py <seed.wasm> [--verify-fresh] [...]",
    )
    return 2
  }
  const baseline = flagArg(args, "--baseline", HERE + "/baseline.jsonl")
  const out = flagArg(args, "--json", HERE + "/.last.json")
  const setname = flagArg(args, "--set", "")
  const writing = hasFlag(args, "--write-baseline")
  let gaps = audit()
  if writing && (gaps.orphan.length > 0 || gaps.missing.length > 0) {
    if gaps.orphan.length > 0 {
      print(
        "distilled: index — pruned \{toString(prune())} row(s) whose cell is gone",
      )
    }
    if gaps.missing.length > 0 && setname == "" {
      print(complaint(gaps))
      return 2
    }
    if gaps.missing.length > 0 {
      const n = writeSet(setname, gaps.missing)
      print(
        "distilled: index — wrote \{toString(n)} curated row(s) at block \{setname}",
      )
    }
    gaps = audit()
  }
  const short = complaint(gaps)
  if short != "" {
    print(short)
    return 2
  }

  const g = gradeCorpus(seed, out)
  if g.rc != 0 { return g.rc }
  const now = g.now
  const cells = sortStrings(now.keys())
  writeText(out, lastJson(now, cells))
  if writing {
    const recs: Map<string, JsonMap> = Map()
    for c in cells {
      const r = now[c] ?? { cls: "", msg: "" }
      const rec: JsonMap = Map()
      rec["class"] = r.cls
      rec["msg"] = r.msg
      recs[c] = rec
    }
    dumpCells(baseline, recs)
    print(
      "distilled: wrote baseline for \{toString(cells.length)} cells from \{seed}",
    )
    return 0
  }

  const before = loadCells(baseline)
  const idxRaw = loadCells(HERE + "/expected.jsonl")
  const idx: Map<string, Idx> = Map()
  let pop = 0
  for c, rec in idxRaw {
    const i = idxOf(rec)
    idx[c] = i
    pop = pop + i.represents
  }
  const lost: Move[] = []
  const intoSilent: Move[] = []
  const other: Move[] = []
  for c in cells {
    const v = now[c] ?? { cls: "", msg: "" }
    const b = before[c]
    if b == null { continue }
    const bcls = strField(b, "class")
    if bcls == v.cls && strField(b, "msg") == v.msg { continue }
    const i = idx[c]
    if i == null {
      die("regress: \{c} has no expected.jsonl row", 1)
      return 1
    }
    const row: Move = { cell: c, was: bcls, now: v.cls, weight: i.represents }
    if bcls == "runs" { lost.push(row) }
    else if isSilent(v.cls) && !isSilent(bcls) { intoSilent.push(row) }
    else { other.push(row) }
  }
  let ncur = 0
  for c in cells {
    const i = idx[c]
    if i != null && !isDerived(i.block) { ncur = ncur + 1 }
  }
  print(
    "distilled corpus: \{toString(cells.length - ncur)} representatives standing for \{toString(pop)} census cells, plus \{toString(ncur)} curated cells from named regression sets",
  )
  show("runs -> NOT-RUNS  (blocking)", lost, pop)
  show("-> silent  (report)", intoSilent, pop)
  show("other movement", other, pop)
  if lost.length == 0 && intoSilent.length == 0 && other.length == 0 {
    print("  no cell changed class ✅")
  }
  if lost.length > 0 {
    print(
      "\ndistilled: REGRESSION — \{toString(lost.length)} behavioural class(es) stopped running",
    )
    return 1
  }
  if hasFlag(args, "--verify-fresh") {
    const n = lost.length + intoSilent.length + other.length
    if n > 0 {
      print(
        "\ndistilled: STALE BASELINE — \{toString(n)} cell(s) disagree with this seed. The committed baseline does not describe the committed compiler; re-run with --write-baseline and commit the result.",
      )
      return 1
    }
    print("\ndistilled: baseline is fresh for this seed ✅")
    return 0
  }
  print("\ndistilled: no runs lost ✅")
  0
}

function main(args: string[]): i32 {
  if args.length == 2 && args[0] == "--grade-chunk" {
    gradeChunk(args[1])
    return 0
  }
  mainReport(args)
}

const argv = programArgs()
if argv is Utf8Error {
  die("regress: an argument is not UTF-8: " + argv.msg, 2)
} else {
  exit(main(argv))
}
