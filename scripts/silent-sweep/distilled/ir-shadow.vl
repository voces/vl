// The IR shadow over the distilled corpus: every cell in `cells/` and `named/` is built with
// `$VL_IR_SHADOW=1` and the shadow's `[ir]` rows are summed.
//
//     vl run scripts/silent-sweep/distilled/ir-shadow.vl -- [--seed P] [--write-baseline]
//     vl run scripts/silent-sweep/distilled/ir-shadow.vl -- [--seed P] --blockers [--top N]
//     vl run scripts/silent-sweep/distilled/ir-shadow.vl -- [--seed P] --claims
//     vl run scripts/silent-sweep/distilled/ir-shadow.vl -- [--seed P] --cases [--write-baseline]
//
// It prints covered and matched, and every mismatch class with its count. It exits 1 on a
// verifier failure, or on a mismatch class whose count is above `ir-shadow-baseline.txt` (a
// class the baseline does not list counts as 0 there). A count that fell prints and passes,
// and `--write-baseline` records the current counts. Exit 2 is the harness failing: a chunk
// trapped or timed out, or the host printed no rows. Run it from the checkout root; chunks
// run `$JOBS` at a time (default 4), and the programs `heavy-programs.txt` names run after them in
// one process, so two multi-GB builds never overlap. `--blockers` runs the blocker census
// (`$VL_IR_SHADOW=4`) and prints, per set of one or two miss classes, the functions that set alone
// keeps uncovered: the functions a coverage step unblocks, an upper bound since a statement stops
// at its first miss.
// `--claims` builds disarmed (`$VL_IR_SHADOW=5`), as shipped, and exits 1 on any `claim fell back`
// row: a claimed function whose lowering or verifier failed would hide behind legacy's bytes.
// `--claims` also builds the programs `claims-fallbacks.txt` names from outside the corpus and
// every inventory witness filed `runs`, and reds when one falls back more than that file says
// (a witness by its row's file); `--write-fallbacks` rewrites the counts.
// `--cases` runs the armed shadow over every `tests/cases` program instead, against
// `ir-shadow-cases-baseline.txt`, which also holds that population's verifier failures. In both
// populations a `bytes` class is never baselined; a claimable function whose bytes differ prints
// `a byte difference (informational)` and passes, behaviour parity being the check, unless
// `$IR_SHADOW_BYTES=1`, which reds unless `scripts/ir-divergence-baseline.txt` lists it for that
// program (Q57). `--files` builds only the programs it names.

import { IoError, readTextFile, writeTextFile } from "std:fs"
import { programArgs } from "std:args"
import { Utf8Error } from "std:utf8"
import { exit } from "std:process"
import { parseI32, toString } from "std:fmt"
import { endsWith, join, lastIndexOf, split, startsWith, trim } from "std:str"
import { concat, indexOf, sort } from "std:array"
import { die, envOr, fanOutArgv, hasFlag } from "../../lib/common"
import { cellsIn, makeTempDir, spawn, writeText } from "../../lib/corpus"

const HERE = "scripts/silent-sweep/distilled"
const BASELINE = "scripts/silent-sweep/distilled/ir-shadow-baseline.txt"
const CASES_BASELINE = "scripts/silent-sweep/distilled/ir-shadow-cases-baseline.txt"
const FALLBACKS = "scripts/silent-sweep/distilled/claims-fallbacks.txt"
const ORDER_BASELINE = "scripts/silent-sweep/distilled/ir-prepost-baseline.txt"
const DIVERGENCE = "scripts/ir-divergence-baseline.txt"
const ORDER = "prepost"
const PREFIX = "[ir] "
const CHUNK = 200
const HEAVY = "scripts/silent-sweep/distilled/heavy-programs.txt"

// The programs `heavy-programs.txt` names: a row id (`D3417`, its staged witness) or a checkout
// path. Each builds at a multi-GB peak, so `measure` runs them after the fan-out, one process.
function heavyKeys(): string[] {
  const out: string[] = []
  for line in split(readOr(HEAVY), "\n") {
    if line == "" || startsWith(line, "#") { continue }
    const t = line.indexOf("\t")
    out.push(if t < 0 { line } else { line.slice(0, t) })
  }
  return out
}

// Whether `path` is a program `keys` names: a witness staged under its row id, or that path.
function isHeavy(path: string, keys: readonly string[]): boolean {
  for k in keys {
    if startsWith(k, "D") && path.indexOf("/" + k + "/") >= 0 { return true }
    if path == k || endsWith(path, "/" + k) { return true }
  }
  return false
}

// The value after `flag` in the arguments, or `dflt`.
function argOr(args: readonly string[], flag: string, dflt: string): string {
  let i = 0
  while i + 1 < args.length {
    if args[i] == flag { return args[i + 1] }
    i = i + 1
  }
  return dflt
}

// Every cell's path, sorted.
function corpus(): string[] {
  const out: string[] = []
  for part in ["cells", "named"] {
    for n in cellsIn(HERE + "/" + part) {
      out.push(HERE + "/" + part + "/" + n + ".vl")
    }
  }
  sort(out, (a: string, b: string) => a < b)
  return out
}

// Every `tests/cases` program the checkout tracks, sorted; a capability matrix is a template.
function casesPaths(): string[] {
  const x = spawn("git", ["ls-files", "tests/cases"])
  if x.code != 0 {
    die("ir-shadow: git ls-files tests/cases failed\n\{x.err}", 2)
  }
  const out: string[] = []
  for line in split(x.out, "\n") {
    if endsWith(line, ".vl") && !endsWith(line, ".matrix.vl") { out.push(line) }
  }
  sort(out, (a: string, b: string) => a < b)
  return out
}

// Whether class `key` is a byte difference, which no baseline admits.
function bytesClass(key: string): boolean { return key.indexOf("bytes") >= 0 }

// One row class and its count summed over the corpus.
type Row = { key: string, n: i32 }

// What a run measured: the rows by class, the cells that printed any (and which), and the chunks
// that did not finish (a trap or a timeout, as `vl check`'s exit code says). A cell that fails
// the check, or holds no function, prints no row.
type Measured = {
  rows: Row[],
  cells: i32,
  seen: Map<string, boolean>,
  broken: string[],
  held: Map<string, Row[]>,
}

function bump(rows: Row[], key: string, n: i32) {
  for r in rows {
    if r.key == key {
      r.n = r.n + n
      return 0
    }
  }
  rows.push({ key: key, n: n })
  return 0
}

function countOf(rows: Row[], key: string): i32 {
  for r in rows {
    if r.key == key { return r.n }
  }
  return 0
}

// Which rows carry their program's path ahead of the class, and a tab: none, every row, or only
// the fallback rows or the order rows, so a large population keeps few distinct keys.
type Keying = "none" | "every row" | "fallback rows" | "order rows"

// Adds the `[ir] <path>: <n>\t<row>` lines of one chunk's stderr into `m`, keyed by `keying`. A
// verifier failure's row carries its function's IR on the lines after it; only its first line is
// the class.
function addRows(
  m: Measured,
  text: string,
  keying: Keying,
  hold: Map<string, string[]>,
) {
  let last = ""
  for line in split(text, "\n") {
    if !startsWith(line, PREFIX) { continue }
    const c = line.indexOf(": ")
    const t = line.indexOf("\t")
    if c < 0 || t < c { continue }
    const path = line.slice(PREFIX.length, c)
    const n = parseI32(trim(line.slice(c + 2, t)))
    if n == null { continue }
    if path != last {
      m.cells = m.cells + 1
      m.seen[path] = true
      last = path
    }
    const row = line.slice(t + 1, line.length)
    const keyed = keying == "every row"
      || keying == "fallback rows"
      && startsWith(row, "claim fell back")
      || keying == "order rows" && startsWith(row, ORDER)
    if !keyed && hold[path] != null {
      const h = m.held[path] ?? []
      bump(h, row, n ?? 0)
      m.held[path] = h
      continue
    }
    bump(m.rows, if keyed { path + "\t" + row } else { row }, n ?? 0)
  }
  return 0
}

// Builds every cell under the armed shadow, `jobs` chunks at a time.
function measure(
  paths: string[],
  seed: string,
  jobs: string,
  mode: string,
  keying: Keying,
  hold: Map<string, string[]>,
): Measured {
  const m: Measured = {
    rows: [],
    cells: 0,
    seen: Map(),
    broken: [],
    held: Map(),
  }
  // No programs is no fan-out: an empty chunk would run `vl check` over the whole tree.
  if paths.length == 0 { return m }
  const vl = envOr("VL", "scripts/vl-host/target/release/vl")
  const root = makeTempDir()
  // A heavy program never shares the fan-out: two in parallel chunks would sum their peaks.
  const keys = heavyKeys()
  const light: string[] = []
  const heavy: string[] = []
  for p in paths {
    if isHeavy(p, keys) { heavy.push(p) } else { light.push(p) }
  }
  const chunks: string[] = []
  let i = 0
  while i < light.length {
    const f = root + "/chunk-" + toString(chunks.length)
    const end = if i + CHUNK < light.length { i + CHUNK } else { light.length }
    writeText(f, join(light.slice(i, end), "\n") + "\n")
    chunks.push(f)
    i = end
  }
  writeText(root + "/chunks", join(chunks, "\n") + "\n")
  // `$0` is the host, `$1` the seed and `$2` the chunk; each chunk's exit code lands beside it.
  const sh = "VL_IR_SHADOW="
    + mode
    + " timeout 1200 \"$0\" check --codegen --compiler \"$1\" $(cat \"$2\")"
    + " > /dev/null 2> \"$2.err\"; echo $? > \"$2.rc\""
  if chunks.length > 0 {
    const x = spawn(
      "sh",
      fanOutArgv(root + "/chunks", jobs, ["sh", "-c", sh, vl, seed]),
    )
    if x.code != 0 {
      spawn("rm", ["-rf", root])
      die("ir-shadow: the chunk fan-out failed (rc=\{x.code})\n\{x.err}", 2)
    }
  }
  // The heavy programs, after the fan-out has finished: one process, so one heavy peak at a time.
  if heavy.length > 0 {
    const f = root + "/chunk-heavy"
    writeText(f, join(heavy, "\n") + "\n")
    chunks.push(f)
    spawn("sh", ["-c", sh, vl, seed, f])
  }
  for f in chunks {
    const rc = parseI32(trim(readOr(f + ".rc")))
    // 0 and 1 are `vl check` grading the chunk; anything else is the chunk not finishing.
    if rc != 0 && rc != 1 { m.broken.push(f + " (rc=\{toString(rc ?? -1)})") }
    addRows(m, readOr(f + ".err"), keying, hold)
  }
  spawn("rm", ["-rf", root])
  return m
}

function readOr(path: string): string {
  const t = readTextFile(path)
  if t is IoError { return "" }
  return t
}

// The committed counts in `file`, one `<n>\t<class>` line each.
function loadBaseline(file: string): Row[] {
  const rows: Row[] = []
  const text = readTextFile(file)
  if text is IoError { return rows }
  for line in split(text, "\n") {
    if line == "" || startsWith(line, "#") { continue }
    const t = line.indexOf("\t")
    if t < 0 { die("ir-shadow: \{file}: no tab in `\{line}`", 2) }
    const n = parseI32(line.slice(0, t))
    if n == null { die("ir-shadow: \{file}: no count in `\{line}`", 2) }
    rows.push({ key: line.slice(t + 1, line.length), n: n ?? 0 })
  }
  return rows
}

// The rows whose class starts with `head`, by class.
function classes(rows: Row[], head: string): Row[] {
  const out: Row[] = []
  for r in rows {
    if startsWith(r.key, head) && r.n > 0 { out.push(r) }
  }
  sort(out, (a: Row, b: Row) => a.key < b.key)
  return out
}

// The census rows, by how many classes block: the sole and the paired, most functions first.
function printBlockers(rows: Row[], top: i32) {
  const none = countOf(rows, "blockers none")
  let fns = 0
  const one: Row[] = []
  const two: Row[] = []
  for r in rows {
    if !startsWith(r.key, "blockers ") { continue }
    fns = fns + r.n
    const set = r.key.slice(9, r.key.length)
    if set == "none" { continue }
    const parts = split(set, " + ")
    if parts.length == 1 { one.push({ key: set, n: r.n }) }
    if parts.length == 2 { two.push({ key: set, n: r.n }) }
  }
  sort(one, (a: Row, b: Row) => a.n > b.n)
  sort(two, (a: Row, b: Row) => a.n > b.n)
  print("blocker census: \{fns} functions, \{none} with no blocker")
  print("one class alone:")
  for r in one.slice(0, if top < one.length { top } else { one.length }) {
    print("  \{r.n}\t\{r.key}")
  }
  print("two classes together:")
  for r in two.slice(0, if top < two.length { top } else { two.length }) {
    print("  \{r.n}\t\{r.key}")
  }
  return 0
}

function writeBaseline(file: string, head: string, mm: Row[]) {
  for r in mm {
    if bytesClass(r.key) {
      die("ir-shadow: a byte difference is never a baseline: \{r.key}", 1)
    }
  }
  let text = "# " + head + "\n"
  for r in mm { text = text + "\{r.n}\t\{r.key}\n" }
  const w = writeTextFile(file, text)
  if w != null { die("ir-shadow: cannot write \{file} (\{w.msg})", 2) }
  print("wrote \{file}: \{mm.length} classes")
  return 0
}

// The expected fallbacks, one `<n>\t<path>\t<class>` line each, keyed `<path>\t<class>`.
function loadFallbacks(): Row[] {
  const rows: Row[] = []
  const got = readTextFile(FALLBACKS)
  if got is IoError {
    die("ir-shadow: cannot read \{FALLBACKS} (\{got.msg})", 2)
  }
  const text = if got is IoError { "" } else { got }
  for line in split(text, "\n") {
    if line == "" || startsWith(line, "#") { continue }
    const t = line.indexOf("\t")
    const n = if t < 0 { null } else { parseI32(line.slice(0, t)) }
    if n == null { die("ir-shadow: \{FALLBACKS}: no count in `\{line}`", 2) }
    rows.push({ key: line.slice(t + 1, line.length), n: n ?? 0 })
  }
  return rows
}

// The programs the fallback file names, each once, in its order. A filed witness's row is not
// one: the whole filed population is built apart.
function fallbackPaths(rows: Row[]): string[] {
  const out: string[] = []
  for r in rows {
    const p = r.key.slice(0, r.key.indexOf("\t"))
    if !isWitnessKey(p) && out.indexOf(p) < 0 { out.push(p) }
  }
  return out
}

// The inventories whose `runs` witnesses the claims run also builds, in the order
// `ir-i8-census/witnesses.vl` numbers them (`inv1`, `inv2`).
const WITNESS_DOCS = ["docs/internals/inventory", "docs/internals/inventory-2"]

// Whether a fallback key names a filed witness, by its row's file, rather than a program.
function isWitnessKey(key: string): boolean {
  for d in WITNESS_DOCS {
    if startsWith(key, d + "/") { return true }
  }
  return false
}

// Writes the witness of every row filed `runs` under `root` and returns each entry's path.
function witnessPaths(root: string, seed: string): string[] {
  const vl = envOr("VL", "scripts/vl-host/target/release/vl")
  const x = spawn(
    vl,
    concat(
      [
        "run",
        "scripts/ir-i8-census/witnesses.vl",
        "--compiler",
        seed,
        "--",
        root,
      ],
      WITNESS_DOCS,
    ),
  )
  if x.code != 0 {
    die(
      "ir-shadow: staging the filed witnesses failed (rc=\{x.code})\n\{x.err}",
      2,
    )
  }
  const out: string[] = []
  for line in split(x.out, "\n") {
    if line != "" { out.push(line) }
  }
  return out
}

// A witness row's key, `<root>/inv<k>/<id>/<file>\t<class>`, as its row's file and the class.
function witnessKey(root: string, key: string): string {
  const t = key.indexOf("\t")
  const parts = split(key.slice(root.length + 1, t), "/")
  const k = if parts.length < 3 { null } else { parseI32(parts[0].slice(3, parts[0].length)) }
  if k == null || k < 1 || k > WITNESS_DOCS.length {
    die("ir-shadow: a witness row outside the staged layout: \{key}", 2)
  }
  return WITNESS_DOCS[(k ?? 1) - 1]
    + "/"
    + parts[1]
    + ".md"
    + key.slice(t, key.length)
}

function writeFallbacks(paths: string[], fell: Row[]) {
  let text = "# Claims that fall back outside the distilled corpus, which `ir-shadow.vl -- --claims` holds\n"
  text = text
    + "# at these counts. A path with none left keeps a 0 row; a filed witness, named by its row's\n"
    + "# file, is listed only while it falls back. Rewrite: -- --claims --write-fallbacks\n"
  for p in paths {
    let any = false
    for r in fell {
      if startsWith(r.key, p + "\t") {
        text = text + "\{r.n}\t\{r.key}\n"
        any = true
      }
    }
    if !any { text = text + "0\t\{p}\tclaim fell back: none\n" }
  }
  for r in fell {
    if isWitnessKey(r.key) { text = text + "\{r.n}\t\{r.key}\n" }
  }
  const w = writeTextFile(FALLBACKS, text)
  if w != null { die("ir-shadow: cannot write \{FALLBACKS} (\{w.msg})", 2) }
  print(
    "wrote \{FALLBACKS}: \{fell.length} fallback rows over \{paths.length} programs",
  )
  return 0
}

// The shipped claim: how many functions the IR emitted, and every fallback, which reds in the
// corpus, and above the fallback file's count in the programs it names and the `nw` filed
// witnesses `w` measured.
function reportClaims(
  m: Measured,
  x: Measured,
  w: Measured,
  nw: i32,
  want: Row[],
  rewrite: boolean,
) {
  if m.broken.length > 0 || x.broken.length > 0 || w.broken.length > 0 {
    exit(2)
  }
  const fell = classes(m.rows, "claim fell back")
  const n = countOf(m.rows, "claimed")
  if n == 0 {
    die(
      "ir-shadow: no `claimed` rows; the host or the seed predates the shipped claim",
      2,
    )
  }
  print("ir claims: \{n} functions emitted by the IR")
  for r in fell { print("  \{r.n}\t\{r.key}") }
  const paths = fallbackPaths(want)
  const xfell: Row[] = []
  let xn = 0
  for r in x.rows.concat(w.rows) {
    const t = r.key.indexOf("\t")
    if t >= 0 && r.key.slice(t + 1, r.key.length) == "claimed" { xn = xn + r.n }
    if (
      t >= 0
      && startsWith(r.key.slice(t + 1, r.key.length), "claim fell back")
      && r.n > 0
    ) {
      xfell.push(r)
    }
  }
  sort(xfell, (a: Row, b: Row) => a.key < b.key)
  if rewrite { return writeFallbacks(paths, xfell) }
  let red = fell.length > 0
  if red { print("ir-shadow: a claimed function fell back to legacy") }
  for r in xfell {
    const was = countOf(want, r.key)
    if r.n > was {
      print(
        "ir-shadow: a fallback outside the corpus rose: \{r.key}: \{was} -> \{r.n}",
      )
      red = true
    }
  }
  for f in want {
    const now = countOf(xfell, f.key)
    if now < f.n {
      print(
        "ir-shadow: \{f.key} fell: \{f.n} -> \{now} (re-run with --write-fallbacks)",
      )
    }
  }
  print(
    "ir claims outside the corpus: \{xn} functions over \{paths.length} programs",
  )
  print(
    "ir claims over the filed witnesses: \{countOf(w.rows, "claimed")} functions over \{nw} witnesses filed runs",
  )
  if red { exit(1) }
  print("ir-shadow: ok")
  return 0
}

// The order baseline's rows, `<n>\t<path>\t<row>` each, as `<path>\t<row>` keys.
function loadOrderBaseline(): Row[] {
  const rows: Row[] = []
  const text = readTextFile(ORDER_BASELINE)
  if text is IoError { return rows }
  for line in split(text, "\n") {
    if line == "" || startsWith(line, "#") { continue }
    const t = line.indexOf("\t")
    const n = if t < 0 { null } else { parseI32(line.slice(0, t)) }
    if n == null {
      die("ir-shadow: \{ORDER_BASELINE}: no count in `\{line}`", 2)
    }
    rows.push({ key: line.slice(t + 1, line.length), n: n ?? 0 })
  }
  return rows
}

// Whether order-baseline key `key` is a `tests/cases` program's, else a corpus cell's.
function isCasesKey(key: string): boolean {
  return startsWith(key, "tests/cases/")
}

// Whether an early-build failure row names the program's own refusal: the plain shadow
// (`$VL_IR_SHADOW=1`) fails `path` with an error line that is exactly the row's message, so the
// order did not cause it. A message that only contains or prefixes it does not count.
function ownRefusal(path: string, row: string, seed: string): boolean {
  const head = "prepost differs: the early build failed the compile ("
  const end = row.lastIndexOf(") in ")
  if !startsWith(row, head) || end < head.length { return false }
  const want = "[ERROR]: " + row.slice(head.length, end)
  const vl = envOr("VL", "scripts/vl-host/target/release/vl")
  const sh = "VL_IR_SHADOW=1 \"$0\" check --codegen --compiler \"$1\" \"$2\" 2>&1 > /dev/null"
  const x = spawn("sh", ["-c", sh, vl, seed, path])
  if x.code == 0 { return false }
  for line in split(x.out, "\n") {
    if line == want { return true }
  }
  return false
}

// The order check over what mode 6 measured: a row above the order baseline reds, and so does a
// program that prints rows under the plain shadow but none under the order check, since that one
// failed to compile only there. With `rewrite`, this population's rows replace its baseline rows.

function orderCheck(
  m: Measured,
  paths: string[],
  seed: string,
  cases: boolean,
  rewrite: boolean,
): boolean {
  const rows: Row[] = []
  for r in m.rows {
    const t = r.key.indexOf("\t")
    if t < 0 || !startsWith(r.key.slice(t + 1, r.key.length), ORDER) {
      continue
    }
    if ownRefusal(r.key.slice(0, t), r.key.slice(t + 1, r.key.length), seed) {
      print("ir-shadow: the program's own refusal, not an order row: \{r.key}")
      continue
    }
    rows.push(r)
  }
  sort(rows, (a: Row, b: Row) => a.key < b.key)
  const rowless: string[] = []
  for p in paths {
    if !(m.seen[p] ?? false) { rowless.push(p) }
  }
  const plain = measure(rowless, seed, envOr("JOBS", "4"), "1", "none", Map())
  for b in plain.broken { print("ir-shadow: chunk did not finish: \{b}") }
  let red = plain.broken.length > 0
  let lost = 0
  for p in rowless {
    if plain.seen[p] ?? false {
      print("ir-shadow: fails only under the order check: \{p}")
      lost = lost + 1
      red = true
    }
  }
  const base = loadOrderBaseline()
  if rewrite {
    let text = "# IR order-check rows over the distilled corpus and tests/cases, which `ir-shadow.vl -- --prepost`\n"
      + "# holds at these counts. A row leaves as its fix lands. Rewrite: -- --prepost --write-order-baseline\n"
    const keep: Row[] = []
    for b in base {
      if isCasesKey(b.key) != cases { keep.push(b) }
    }
    const all = keep.concat(rows)
    sort(all, (a: Row, b: Row) => a.key < b.key)
    for r in all { text = text + "\{r.n}\t\{r.key}\n" }
    const w = writeTextFile(ORDER_BASELINE, text)
    if w != null {
      die("ir-shadow: cannot write \{ORDER_BASELINE} (\{w.msg})", 2)
    }
    print("wrote \{ORDER_BASELINE}: \{all.length} rows")
    return red
  }
  for r in rows {
    const was = countOf(base, r.key)
    if r.n > was {
      print(
        "ir-shadow: a function depends on the build order: \{r.key}: \{was} -> \{r.n}",
      )
      red = true
    }
  }
  for b in base {
    if isCasesKey(b.key) != cases { continue }
    const now = countOf(rows, b.key)
    if now < b.n {
      print(
        "ir-shadow: \{b.key} fell: \{b.n} -> \{now} (re-run with --prepost --write-order-baseline)",
      )
    }
  }
  print(
    "ir order check: \{rows.length} order rows; \{rowless.length} programs print none, \{lost} of them only under it",
  )
  return red
}

// ── chosen divergences (Q57) ─────────────────────────────────────────────────────

// The programs `--files` names, up to the next flag; [] builds the usual population.
function filesArg(args: readonly string[]): string[] {
  const out: string[] = []
  let i = 0
  while i < args.length && args[i] != "--files" { i = i + 1 }
  i = i + 1
  while i < args.length && !startsWith(args[i], "--") {
    out.push(args[i])
    i = i + 1
  }
  return out
}

// A `--names` function name as a detail row spells it: no `@<module>` suffix, the start `@start`.
function shadowName(fn: string): string {
  let n = fn
  const at = lastIndexOf(n, "@")
  if at > 0 && parseI32(n.slice(at + 1, n.length)) != null {
    n = n.slice(0, at)
  }
  return if n == "__start__" { "@start" } else { n }
}

// Each program `ir-divergence-baseline.txt` lists, with its functions as detail rows spell them.
function divergences(): Map<string, string[]> {
  const out: Map<string, string[]> = Map()
  const text = readTextFile(envOr("IR_DIVERGENCE_BASELINE", DIVERGENCE))
  if text is IoError { return out }
  for line in split(text, "\n") {
    if line == "" || startsWith(line, "#") { continue }
    const f = split(line, "\t")
    if f.length != 4 {
      die("ir-shadow: \{DIVERGENCE}: not four tab-separated fields: \{line}", 2)
    }
    const fns = out[f[0]] ?? []
    fns.push(shadowName(f[1]))
    out[f[0]] = fns
  }
  return out
}

// A row a chosen divergence accounts for: a byte mismatch, or the claim rule's fail for one.
function bytesRow(key: string): boolean {
  return bytesClass(key)
    && (startsWith(key, "mismatch ")
    || startsWith(key, "fail a claimable function did not match: "))
}

// Folds each listed program's held rows back into `m`, except its byte mismatches when the detail
// build (`$VL_IR_SHADOW=2`) names every one, each a function listed for it: those print as
// `expected divergence`. Otherwise they fold back too, so the byte check below reds on them.
function subtract(m: Measured, hold: Map<string, string[]>, seed: string) {
  const need: string[] = []
  for p, rows in m.held {
    let any = false
    for r in rows { any = any || bytesRow(r.key) }
    if any { need.push(p) }
  }
  sort(need, (a: string, b: string) => a < b)
  const d = if need.length > 0 { measure(need, seed, envOr("JOBS", "4"), "2", "every row", Map()) } else { m }
  // `d` is `m` itself when no listed program needs a detail build: copying its own list into it
  // would never end.
  if need.length > 0 {
    for b in d.broken { m.broken.push(b) }
  }
  for p, rows in m.held {
    let want = 0
    for r in rows {
      if bytesRow(r.key) && startsWith(r.key, "mismatch ") { want = want + r.n }
    }
    const listed = hold[p] ?? []
    const named: string[] = []
    const unlisted: string[] = []
    let got = 0
    for r in d.rows {
      if !startsWith(r.key, p + "\tdetail ") { continue }
      const row = r.key.slice(p.length + 1, r.key.length)
      const at = lastIndexOf(row, " in ")
      if !bytesClass(row.slice(7, at)) { continue }
      const fn = row.slice(at + 4, row.length)
      got = got + r.n
      if indexOf(named, fn) < 0 { named.push(fn) }
      if indexOf(listed, fn) < 0 && indexOf(unlisted, fn) < 0 {
        unlisted.push(fn)
      }
    }
    const ok = want > 0 && got == want && unlisted.length == 0
    if ok {
      print("ir-shadow: expected divergence \{p} (\{join(named, ", ")})")
    } else if want > 0 && unlisted.length > 0 {
      print(
        "ir-shadow: \{p}: a byte mismatch in a function the divergence baseline does not list: \{join(unlisted, ", ")}",
      )
    } else if want > 0 {
      print(
        "ir-shadow: \{p}: \{toString(want)} byte mismatches, the detail build names \{toString(got)} (it names at most 3 a class)",
      )
    }
    for r in rows {
      if !ok || !bytesRow(r.key) { bump(m.rows, r.key, r.n) }
    }
  }
  return 0
}

function main(args: readonly string[]) {
  const seed = argOr(args, "--seed", "build/vl-compiler.wasm")
  const cases = hasFlag(args, "--cases")
  const files = filesArg(args)
  const paths = if files.length > 0 { files } else if cases { casesPaths() } else { corpus() }
  if paths.length == 0 { die("ir-shadow: no programs to build", 2) }
  const census = hasFlag(args, "--blockers")
  const claims = hasFlag(args, "--claims")
  const prepost = hasFlag(args, "--prepost")
  const mode = if census { "4" } else if claims { "5" } else if prepost { "6" } else { "1" }
  const hold: Map<string, string[]> = if census || claims { Map() } else { divergences() }
  const m = measure(
    paths,
    seed,
    envOr("JOBS", "4"),
    mode,
    if prepost { "order rows" } else { "none" },
    hold,
  )
  for b in m.broken { print("ir-shadow: chunk did not finish: \{b}") }
  subtract(m, hold, seed)
  if claims {
    const want = loadFallbacks()
    const x = measure(
      fallbackPaths(want),
      seed,
      envOr("JOBS", "4"),
      mode,
      "every row",
      Map(),
    )
    for b in x.broken { print("ir-shadow: chunk did not finish: \{b}") }
    const root = makeTempDir()
    const wit = witnessPaths(root, seed)
    const w = measure(
      wit,
      seed,
      envOr("JOBS", "4"),
      mode,
      "fallback rows",
      Map(),
    )
    spawn("rm", ["-rf", root])
    for b in w.broken { print("ir-shadow: chunk did not finish: \{b}") }
    for r in w.rows {
      if r.key.indexOf("\t") >= 0 { r.key = witnessKey(root, r.key) }
    }
    return reportClaims(
      m,
      x,
      w,
      wit.length,
      want,
      hasFlag(args, "--write-fallbacks"),
    )
  }
  if m.cells == 0 {
    die(
      "ir-shadow: no `[ir]` rows; the seed or the host predates `$VL_IR_SHADOW` (a stale host: run `scripts/agent-setup.sh --host-check`)",
      2,
    )
  }
  if census {
    return printBlockers(m.rows, parseI32(argOr(args, "--top", "20")) ?? 20)
  }
  print(
    "ir shadow\{if cases { " (tests/cases)" } else { "" }}: \{m.cells} of \{paths.length} programs have functions; \{countOf(m.rows, "fns")} functions, \{countOf(m.rows, "covered")} covered, \{countOf(m.rows, "verified")} verified, \{countOf(m.rows, "matched")} matched",
  )
  const mm = classes(m.rows, "mismatch ")
  const fails = classes(m.rows, "fail ")
  // A claim that fails only on its bytes is a byte difference, which behaviour parity reports and
  // `$IR_SHADOW_BYTES=1` gates; any other fail (a verifier failure) reds the corpus.
  const bytesGate = envOr("IR_SHADOW_BYTES", "0") == "1"
  const hardFails: Row[] = []
  for r in fails {
    if bytesGate || !bytesClass(r.key) { hardFails.push(r) }
  }
  for r in mm { print("  \{r.n}\t\{r.key}") }
  for r in fails { print("  \{r.n}\t\{r.key}") }
  if m.broken.length > 0 { exit(2) }
  const orderRed = prepost
    && orderCheck(
    m,
    paths,
    seed,
    cases,
    hasFlag(args, "--write-order-baseline"),
  )
  if hasFlag(args, "--write-order-baseline") {
    return if orderRed { exit(1) } else { 0 }
  }
  // The corpus admits no verifier failure; `tests/cases` baselines its own, which may only fall.
  const tracked: Row[] = if cases { mm.concat(fails) } else { mm }
  if hasFlag(args, "--write-baseline") {
    if !cases && hardFails.length > 0 {
      die("ir-shadow: a verifier failure is never a baseline", 1)
    }
    if cases {
      writeBaseline(
        CASES_BASELINE,
        "IR shadow mismatches and verifier failures over tests/cases: vl run scripts/silent-sweep/distilled/ir-shadow.vl -- --cases --write-baseline",
        tracked,
      )
    } else {
      writeBaseline(
        BASELINE,
        "IR shadow mismatches over the distilled corpus: vl run scripts/silent-sweep/distilled/ir-shadow.vl -- --write-baseline",
        tracked,
      )
    }
    return 0
  }
  const base = loadBaseline(if cases { CASES_BASELINE } else { BASELINE })
  let red = orderRed || !cases && hardFails.length > 0
  // A byte difference from legacy is reported, not gated: behaviour parity (ci-ir-identity) is
  // the check (coordinator ruling 2026-11-25); `$IR_SHADOW_BYTES=1` restores the gate.
  for r in tracked {
    if bytesClass(r.key) {
      if bytesGate {
        print("ir-shadow: a byte difference: \{r.n}\t\{r.key}")
        red = true
      } else {
        print("ir-shadow: a byte difference (informational): \{r.n}\t\{r.key}")
      }
    }
  }
  for r in tracked {
    if bytesClass(r.key) && !bytesGate { continue }
    const was = countOf(base, r.key)
    if r.n > was {
      print("ir-shadow: \{r.key} rose: \{was} -> \{r.n}")
      red = true
    }
  }
  for b in base {
    const now = countOf(tracked, b.key)
    if now < b.n {
      print(
        "ir-shadow: \{b.key} fell: \{b.n} -> \{now} (re-run with --write-baseline)",
      )
    }
  }
  if red { exit(1) }
  print("ir-shadow: ok")
  return 0
}

const argv = programArgs()
if argv is Utf8Error {
  die("ir-shadow: an argument is not UTF-8: " + argv.msg, 2)
} else {
  main(argv)
}
