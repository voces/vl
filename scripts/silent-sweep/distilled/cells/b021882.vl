function mkI(): {[string]: i32} {
  const mi: {[string]: i32} = Map()
  mi["z"] = 1
  return mi
}
type Circle = { r: {[string]: i32} }
type Dot = { r: {[string]: i32} }
type DotB = { db: i32 }
type DotU = Dot | DotB
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = {[string]: Circle}[]
type Box2 = {[string]: Circle}[]
function useShape(s: Shape): i32 { if s is Sq { return 1 } return 0 }
const sqv: Sq = { s: 1 }
const _sp1: Box1 = []
const _sp2: Box2 = []
function mksrc() {
  const lv1 = Map()
  lv1["k0"] = { r: mkI() }
  const cc: {[string]: Circle}[] = [lv1]
  return cc
}
function rd(c: {[string]: Circle}[]) {
  function inner() {
    if useShape(sqv) > 99 { print(0) }
    const g0 = c
    if g0.length > 0 {
      const g1 = (g0[0])["k0"] ?? { r: Map() }
      if (g1).r.size == 1 { print(7) } else { print(0) }
    } else { print(0) }
  }
  inner()
}
rd(mksrc())
