type F = 1.5 | 2.5
type Circle = { r: F }
function sink(_x: {[string]: Circle}) { }
function rd() {
  const c = Map()
  c["k0"] = { r: 1.5 }
  c["k1"] = { r: 2.5 }
  sink(c)
  const lamc = (x: {[string]: Circle}) => x
  const dd = lamc(c)
  const g0 = (dd)["k0"] ?? { r: 2.5 }
  if (g0).r == 1.5 { print(7) } else { print(0) }
}
rd()
