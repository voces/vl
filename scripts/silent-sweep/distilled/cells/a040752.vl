type Circle = { r: string }
type Dot = { r: string }
type Sq = { s: i32 }
type Shape = Circle | Sq
function sink(_x: Circle[]) { }
function mkcall() {
  const cc = [{ r: "seven" }]
  return cc
}
function outer() {
  const lam = () => {
    sink(mkcall())
    const dd = mkcall()
    let hit = 0
    for zz in dd {
      if zz.r == "seven" { hit = 7 }
    }
    print(hit)
  }
  lam()
}
outer()
