type K = "p" | "q"
type WS1 = { f: {[string]: {r: K}} }
function mksrc() {
  const lv1 = Map()
  lv1["k0"] = { r: "p" }
  const cc: WS1 = { f: lv1 }
  return cc
}
function rd(c: WS1) {
  function inner() {
    const g1 = ((c).f)["k0"] ?? { r: "q" }
    if (g1).r == "p" { print(7) } else { print(0) }
  }
  inner()
}
rd(mksrc())
