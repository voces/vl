type WS1 = { f: {[string]: {r: f32}} }
function mksrc() {
  const lv1 = Map()
  lv1["k0"] = { r: 7.5 }
  const cc: WS1 = { f: lv1 }
  return cc
}
function rd(c: WS1) {
  function inner() {
    const g1 = ((c).f)["k0"] ?? { r: 0.5 }
    if (g1).r > 7.0 { print(7) } else { print(0) }
  }
  inner()
}
rd(mksrc())
