type N = 1 | 2
function rd() {
  const lv2 = Map()
  lv2["k0"] = { r: 1 }
  const lv1 = Map()
  lv1["k0"] = lv2
  const c: {[string]: {[string]: {[string]: {r: N}}}} = Map()
  c["k0"] = lv1
  const g0 = (c)["k0"] ?? Map()
  const g1 = (g0)["k0"] ?? Map()
  const g2 = (g1)["k0"] ?? { r: 2 }
  if (g2).r == 1 { print(7) } else { print(0) }
}
rd()
