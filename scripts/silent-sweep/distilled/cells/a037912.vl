type Circle = { r: string }
type Dot = { r: string }
type Sq = { s: i32 }
type Shape = Circle | Sq
type GW = { g: {[string]: {[string]: {[string]: Circle}}} }
function mkc(): {[string]: {[string]: {[string]: Circle}}} {
  const lv2 = Map()
  lv2["k0"] = { r: "seven" }
  const lv1 = Map()
  lv1["k0"] = lv2
  const cc = Map()
  return cc
}
function rd() {
  const c = mkc()
  const wv: GW = { g: c }
  const g0 = (wv.g)["k0"] ?? Map()
  const g1 = (g0)["k0"] ?? Map()
  const g2 = (g1)["k0"] ?? { r: "" }
  if (g2).r == "seven" { print(7) } else { print(0) }
}
rd()
