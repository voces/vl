import { reverse } from "std:array"
type F = 1.5 | 2.5
type Circle = { r: F }
function rd() {
  const lv1 = Map()
  lv1["k0"] = { r: 1.5 }
  const c: {[string]: Circle}[] = [lv1]
  const dd = reverse([c])[0]
  const g0 = dd
  if g0.length > 0 {
    const g1 = (g0[0])["k0"] ?? { r: 2.5 }
    if (g1).r == 1.5 { print(7) } else { print(0) }
  } else { print(0) }
}
rd()
