type Box1 = {[string]: {r: string}}[]
type Shape = Ua | Sq
type Ua = { ua: i32 }
type Sq = { s: i32 }
type Dot = { r: string }
type GW = { g: {[string]: {r: string}}[] }
const _sp1: Box1 = []
function outer() {
  const lv1 = Map()
  lv1["k0"] = { r: "seven" }
  const c = []
  function inner() {
    const wv: GW = { g: c }
    const g0 = wv.g
    if g0.length > 0 {
      const g1 = (g0[0])["k0"] ?? { r: "" }
      if (g1).r == "seven" { print(7) } else { print(0) }
    } else { print(0) }
  }
  inner()
}
outer()
