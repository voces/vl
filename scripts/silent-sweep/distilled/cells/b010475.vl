type N = 1 | 2
type Box1 = {[string]: {r: N}}
type Shape = Ua | Sq
type Ua = { ua: i32 }
type Sq = { s: i32 }
type Dot = { r: N }
const _sp1: Box1 = Map()
const dfl: {r: N} = { r: 2 }
function rd() {
  const c = Map()
  c["k0"] = { r: 1 }
  c["k1"] = { r: 1 }
  const g0 = (c)["k0"] ?? dfl
  const gp: {r: N} = g0
  if gp.r == 1 { print(7) } else { print(0) }
}
rd()
