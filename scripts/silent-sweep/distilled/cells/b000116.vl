import { reverse } from "std:array"
function mkI(): {[string]: i32} {
  const mi: {[string]: i32} = Map()
  mi["z"] = 1
  return mi
}
type Circle = { r: {[string]: i32} }
type Dot = { r: {[string]: i32} }
type DotB = { db: i32 }
type DotU = Dot | DotB
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = Circle
type Box2 = Circle
function useShape(s: Shape): i32 { if s is Sq { return 1 } return 0 }
const sqv: Sq = { s: 1 }
const _sp1: Box1 = { r: Map() }
const _sp2: Box2 = { r: Map() }
const c = { r: mkI() }
const dd = reverse([c])[0]
if useShape(sqv) > 99 { print(0) }
if (dd).r.size == 1 { print(7) } else { print(0) }
