type Box1 = {[string]: {r: i32 | null}}[]
type Shape = Circle | Sq
type Sq = { s: i32 }
type Dot = { r: i32 | null }
type Circle = { r: i32 | null }
type GW = { g: {[string]: {r: i32 | null}}[] }
function sink(_x: {[string]: {r: i32 | null}}[]) { }
const _sp1: Box1 = []
function mkcall() {
  const lv1 = Map()
  lv1["k0"] = { r: null }
  const cc = [lv1]
  return cc
}
function outer() {
  const lam = () => {
    sink(mkcall())
    const wv: GW = { g: mkcall() }
    const g0 = wv.g
    if g0.length > 0 {
      const g1 = (g0[0])["k0"] ?? { r: null }
      if (g1).r != null { print(7) } else { print(0) }
    } else { print(0) }
  }
  lam()
}
outer()
