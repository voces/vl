type F = 1.5 | 2.5
type Circle = { r: F }
function rd() {
  const lv1 = [{ r: 1.5 }, { r: 1.5 }]
  const c: Circle[][] = [lv1]
  const g0 = c
  if g0.length > 0 {
    const g1 = g0[0]
    if g1.length > 0 {
      if (g1[0]).r == 1.5 { print(7) } else { print(0) }
    } else { print(0) }
  } else { print(0) }
}
rd()
