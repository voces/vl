type K = "p" | "q"
type Circle = { r: K }
function rd() {
  const lv1 = Map()
  lv1["k0"] = { r: "p" }
  const c: {[string]: Circle}[] = [lv1]
  const g0 = c
  if g0.length > 0 {
    const g1 = (g0[0])["k0"] ?? { r: "q" }
    if (g1).r == "p" { print(7) } else { print(0) }
  } else { print(0) }
}
rd()
