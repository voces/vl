type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function rd() {
  const lv1 = Map()
  lv1["k0"] = { r: 7 }
  const c: {[string]: {[string]: Circle}} = Map()
  c["k0"] = lv1
  const g0 = (c)["k0"] ?? Map()
  const g1 = (g0)["k0"] ?? { r: 0 }
  if (g1).r == 7 { print(7) } else { print(0) }
}
rd()
