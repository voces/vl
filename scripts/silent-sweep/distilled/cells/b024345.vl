import { reverse } from "std:array"
type Box1 = WS1
type Shape = Circle | Sq
type Sq = { s: i32 }
type Dot = { r: i32 | null }
type Circle = { r: i32 | null }
type WS1 = { f: {[string]: {r: i32 | null}} }
const _sp1: Box1 = { f: Map() }
function rd() {
  const lv1 = Map()
  lv1["k0"] = { r: null }
  const c: WS1 = { f: lv1 }
  const dd = reverse([c])[0]
  const g1 = ((dd).f)["k0"] ?? { r: null }
  if (g1).r != null { print(7) } else { print(0) }
}
rd()
