type F = 1.5 | 2.5
type Circle = { r: F }
function sink(_x: Circle[]) { }
function outer() {
  const c = []
  function inner() {
    sink(c)
    const dd = c
    const g0 = dd
    if g0.length > 0 {
      if (g0[0]).r == 1.5 { print(7) } else { print(0) }
    } else { print(0) }
  }
  inner()
}
outer()
