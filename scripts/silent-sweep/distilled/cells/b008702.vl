type Circle = { r: i64 }
type Dot = { r: i64 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = {[string]: Circle}
const _sp1: Box1 = Map()
function mksrc() {
  const cc = Map()
  cc["k0"] = { r: 7 }
  return cc
}
function rd(c: {[string]: Circle}) {
  function inner() {
    const dd = c
    const g0 = (dd)["k0"] ?? { r: 0 }
    if (g0).r == 7 { print(7) } else { print(0) }
  }
  inner()
}
rd(mksrc())
