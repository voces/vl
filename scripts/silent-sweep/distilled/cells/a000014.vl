type Circle = { r: f32 }
function rd() {
  const lv2 = Map()
  lv2["k0"] = { r: 7.5 }
  const lv1 = Map()
  lv1["k0"] = lv2
  const c: {[string]: {[string]: {[string]: {r: f32}}}} = Map()
  const lamc = (x: {[string]: {[string]: {[string]: {r: f32}}}}) => x
  const dd = lamc(c)
  const g0 = (dd)["k0"] ?? Map()
  const g1 = (g0)["k0"] ?? Map()
  const g2 = (g1)["k0"] ?? { r: 0.5 }
  if (g2).r > 7.0 { print(7) } else { print(0) }
}
rd()
