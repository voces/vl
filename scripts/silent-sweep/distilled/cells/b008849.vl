type Circle = { r: string }
type Dot = { r: string }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = {[string]: Circle}
type GW = { g: {[string]: Circle} }
const _sp1: Box1 = Map()
function outer() {
  const c = Map()
  c["k0"] = { r: "seven" }
  c["k1"] = { r: "seven" }
  function inner() {
    const wv: GW = { g: c }
    const g0 = (wv.g)["k0"] ?? { r: "" }
    if (g0).r == "seven" { print(7) } else { print(0) }
  }
  inner()
}
outer()
