type Inner = { q: i32 }
type Circle = { r: Inner }
type Box1 = {[string]: Circle}[]
const _sp1: Box1 = []
const lv1 = Map()
const c: {[string]: Circle}[] = [lv1]
const g0 = c
if g0.length > 0 {
  const g1 = (g0[0])["k0"] ?? { r: { q: 0 } }
  if (g1).r.q == 7 { print(7) } else { print(0) }
} else { print(0) }
