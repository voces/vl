type Cir2 = { c2: i32 }
type Sq2 = { s2: i32 }
type Shape2 = Cir2 | Sq2
type Box2 = {[string]: {[string]: {[string]: {r: Shape2}}}}
type Box1 = {[string]: {[string]: {[string]: {r: Shape2}}}}
function thru(x: {[string]: {[string]: {[string]: {r: Shape2}}}}) { return x }
const _sp1: Box1 = Map()
const _sp2: Box2 = Map()
function mkc(): {[string]: {[string]: {[string]: {r: Shape2}}}} {
  const lv2 = Map()
  lv2["k0"] = { r: { c2: 1 } }
  lv2["k1"] = { r: { s2: 1 } }
  const lv1 = Map()
  lv1["k0"] = lv2
  const cc = Map()
  cc["k0"] = lv1
  return cc
}
function rd() {
  const c = mkc()
  const dd = thru(c)
  const g0 = (dd)["k0"] ?? Map()
  const g1 = (g0)["k0"] ?? Map()
  const g2 = (g1)["k0"] ?? { r: { s2: 1 } }
  if (g2).r is Cir2 { print(7) } else { print(0) }
}
rd()
