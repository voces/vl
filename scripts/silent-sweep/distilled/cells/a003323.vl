type Box1 = {[string]: Circle[]}
type Circle = { r: i32 | null }
type GW = { g: {[string]: Circle[]} }
const _sp1: Box1 = Map()
const dfl: Circle = { r: null }
function mkcall() {
  const lv1 = [{ r: null }]
  const cc = Map()
  cc["k0"] = lv1
  return cc
}
const wv: GW = { g: mkcall() }
const g0 = (wv.g)["k0"] ?? []
const g1 = g0
if g1.length > 0 {
  const gp: Circle = g1[0]
  if gp.r != null { print(7) } else { print(0) }
} else { print(0) }
