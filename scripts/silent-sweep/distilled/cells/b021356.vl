type F = 1.5 | 2.5
type Circle = { r: F }
type Dot = { r: F }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = {[string]: {r: F}}[]
const _sp1: Box1 = []
const lv1 = Map()
lv1["k0"] = { r: 1.5 }
lv1["k1"] = { r: 2.5 }
const c = [lv1]
const g0 = c
if g0.length > 0 {
  const g1 = (g0[0])["k0"] ?? { r: 2.5 }
