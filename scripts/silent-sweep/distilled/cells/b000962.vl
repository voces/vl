type F = 1.5 | 2.5
type Circle = { r: F }
function mksrc() {
  const cc = [{ r: 1.5 }, { r: 2.5 }]
  return cc
}
function rd(c: {r: F}[]) {
  function inner() {
    const g0 = c
    if g0.length > 0 {
      if (g0[0]).r == 1.5 { print(7) } else { print(0) }
    } else { print(0) }
  }
  inner()
}
rd(mksrc())
