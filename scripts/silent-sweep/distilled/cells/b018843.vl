type Circle = { r: i64 }
type GW = { g: {[string]: Circle[]} }
function mkcall() {
  const lv1 = [{ r: 7 }]
  const cc = Map()
  cc["k0"] = lv1
  return cc
}
function outer() {
  const lam = () => {
    const wv: GW = { g: mkcall() }
    const g0 = (wv.g)["k0"] ?? []
    const g1 = g0
    if g1.length > 0 {
      if (g1[0]).r == 7 { print(7) } else { print(0) }
    } else { print(0) }
  }
  lam()
}
outer()
