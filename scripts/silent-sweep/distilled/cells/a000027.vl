type Circle = { r: i64 }
function idg<T>(x: T): T { return x }
const dfl: Circle = { r: 0 }
function rd() {
  const lv1 = Map()
  lv1["k0"] = { r: 7 }
  const c = []
  const dd = idg(c)
  const g0 = dd
  if g0.length > 0 {
    const g1 = (g0[0])["k0"] ?? dfl
    const gp: Circle = g1
    if gp.r == 7 { print(7) } else { print(0) }
  } else { print(0) }
}
rd()
