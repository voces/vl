import { reverse } from "std:array"
type Cir2 = { c2: i32 }
type Sq2 = { s2: i32 }
type Shape2 = Cir2 | Sq2
type Circle = { r: Shape2 }
function mkc(): Circle {
  const cc = { r: { c2: 1 } }
  return cc
}
function outer() {
  const c = mkc()
  function inner() {
    const dd = reverse([c])[0]
    if (dd).r is Cir2 { print(7) } else { print(0) }
  }
  inner()
}
outer()
