type Circle = { r: i32 | null }
type GW = { g: {[string]: Circle[]} }
function outer() {
  const lv1 = [{ r: null }]
  const c = Map()
  c["k0"] = lv1
  function inner() {
    const wv: GW = { g: c }
    const g0 = (wv.g)["k0"] ?? []
    const g1 = g0
    if g1.length > 0 {
      if (g1[0]).r != null { print(7) } else { print(0) }
    } else { print(0) }
  }
  inner()
}
outer()
