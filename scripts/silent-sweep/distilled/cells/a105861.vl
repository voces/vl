type DotU = Dot | DotB
type DotB = { db: i32 }
type Dot = { r: string }
type Circle = { r: string }
function thru(x: {[string]: {r: string}}[]) { return x }
const _sp1: Box1 = []
function outer() {
  const lv1 = Map()
  const c = [lv1]
  function inner() {
    const dd = thru(c)
    const g0 = dd
    if g0.length > 0 {
      const g1 = (g0[0])["k0"] ?? { r: "" }
