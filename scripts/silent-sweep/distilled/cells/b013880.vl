type F = 1.5 | 2.5
type Circle = { r: F }
type GW = { g: {[string]: {[string]: {[string]: {r: F}}}} }
function rd() {
  const lv2 = Map()
  lv2["k0"] = { r: 1.5 }
  lv2["k1"] = { r: 2.5 }
  const lv1 = Map()
  lv1["k0"] = lv2
  const c = Map()
  c["k0"] = lv1
  const wv: GW = { g: c }
  const g0 = (wv.g)["k0"] ?? Map()
  const g1 = (g0)["k0"] ?? Map()
  const g2 = (g1)["k0"] ?? { r: 2.5 }
  if (g2).r == 1.5 { print(7) } else { print(0) }
}
rd()
