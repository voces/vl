type Circle = { r: f64 }
type Dot = { r: f64 }
type DotB = { db: i32 }
type DotU = Dot | DotB
type Box1 = {[string]: Circle}[]
const _sp1: Box1 = []
function mkcall() {
  const lv1 = Map()
  lv1["k0"] = { r: 7.5 }
  const cc: {[string]: Circle}[] = [lv1]
  return cc
}
function rd() {
  const g0 = mkcall()
  if g0.length > 0 {
    const g1 = (g0[0])["k0"] ?? { r: 0.5 }
    if (g1).r > 7.0 { print(7) } else { print(0) }
  } else { print(0) }
}
rd()
