type N = 1 | 2
type Box2 = {r: N}
type Box1 = {r: N}
type GW = { g: {r: N} }
const _sp1: Box1 = { r: 2 }
const _sp2: Box2 = { r: 2 }
function mksrc() {
  const cc: {r: N} = { r: 1 }
  return cc
}
function rd(c: {r: N}) {
  const wv: GW = { g: c }
  if (wv.g).r == 1 { print(7) } else { print(0) }
}
rd(mksrc())
