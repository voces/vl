type N = 1 | 2
type Box1 = {[string]: {r: N}}
type Shape = Ua | Sq
type Ua = { ua: i32 }
type Sq = { s: i32 }
type Dot = { r: N }
const _sp1: Box1 = Map()
function mkc(): {[string]: {r: N}} {
  const cc = Map()
  cc["k0"] = { r: 1 }
  cc["k1"] = { r: 1 }
  return cc
}
function rd() {
  const c = mkc()
  const dd = c
  const g0 = (dd)["k0"] ?? { r: 2 }
  if (g0).r == 1 { print(7) } else { print(0) }
}
