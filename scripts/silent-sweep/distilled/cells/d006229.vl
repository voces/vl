type N = 1 | 2
type Circle = { r: N }
function outer() {
  const lv1 = [{ r: 1 }]
  const c = Map()
  c["k0"] = lv1
  function inner() {
    const g0 = (c)["k0"] ?? []
    const g1 = g0
    if g1.length > 0 {
      if (g1[0]).r == 1 { print(7) } else { print(0) }
    } else { print(0) }
  }
  inner()
}
outer()
