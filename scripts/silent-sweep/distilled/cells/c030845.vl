type Inner = { q: i32 }
type Circle = { r: Inner }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = {[string]: {[string]: Circle}}
const _sp1: Box1 = Map()
function rd() {
  const lv1 = Map()
  lv1["k0"] = { r: { q: 7 } }
  const c: {[string]: {[string]: Circle}} = Map()
  c["k0"] = lv1
  const g0 = (c)["k0"] ?? Map()
  const g1 = (g0)["k0"] ?? { r: { q: 0 } }
  if (g1).r.q == 7 { print(7) } else { print(0) }
}
rd()
