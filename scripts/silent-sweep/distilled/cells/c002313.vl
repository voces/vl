type Circle = { r: i32 }
type Dot = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type WS1 = { f: {[string]: Circle} }
function mkcall() {
  const lv1 = Map()
  lv1["k0"] = { r: 7 }
  const cc: WS1 = { f: lv1 }
  return cc
}
function rd() {
  const g1 = ((mkcall()).f)["k0"] ?? { r: 0 }
  if (g1).r == 7 { print(7) } else { print(0) }
}
rd()
