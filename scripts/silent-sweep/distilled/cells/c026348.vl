type Circle = { r: i32[] }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = {[string]: Circle}[]
const _sp1: Box1 = []
function mkcall() {
  const lv1 = Map()
  lv1["k0"] = { r: [1, 2] }
  const cc: {[string]: Circle}[] = [lv1]
  return cc
}
function rd() {
  const g0 = mkcall()
  if g0.length > 0 {
    const g1 = (g0[0])["k0"] ?? { r: [] }
    if (g1).r.length == 2 { print(7) } else { print(0) }
  } else { print(0) }
}
rd()
