type Box1 = {[string]: {r: string}}[]
type Shape = Circle | Sq
type Sq = { s: i32 }
type Circle = { r: string }
function thru(x: {[string]: {r: string}}[]) { return x }
function useShape(s: Shape): i32 { if s is Sq { return 1 } return 0 }
const sqv: Sq = { s: 1 }
const _sp1: Box1 = []
function outer() {
  const lv1 = Map()
  const c = [lv1]
  function inner() {
    const dd = thru(c)
    if useShape(sqv) > 99 { print(0) }
    const g0 = dd
    if g0.length > 0 {
      const g1 = (g0[0])["k0"] ?? { r: "" }
      if (g1).r == "seven" { print(7) } else { print(0) }
    } else { print(0) }
  }
  inner()
}
outer()
