type Box1 = {[string]: Circle}[]
type Circle = { r: f32 }
function sink(_x: {[string]: Circle}[]) { }
const _sp1: Box1 = []
function rd() {
  const lv1 = Map()
  lv1["k0"] = { r: 7.5 }
  lv1["k1"] = { r: 7.5 }
  const c = [lv1]
  sink(c)
  const dd = c
  const g0 = dd
  if g0.length > 0 {
    const g1 = (g0[0])["k0"] ?? { r: 0.5 }
    if (g1).r > 7.0 { print(7) } else { print(0) }
  } else { print(0) }
}
rd()
