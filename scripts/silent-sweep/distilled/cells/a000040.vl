type Circle = { r: f32 }
const dfl: Circle = { r: 0.5 }
function rd() {
  const lv2 = [{ r: 7.5 }, { r: 7.5 }]
  const lv1 = [lv2]
  const c = [lv1]
  const g0 = c
  if g0.length > 0 {
    const g1 = g0[0]
    if g1.length > 0 {
      const g2 = g1[0]
      if g2.length > 0 {
        const gp: Circle = g2[0]
        if gp.r > 7.0 { print(7) } else { print(0) }
      } else { print(0) }
    } else { print(0) }
  } else { print(0) }
}
rd()
