type Box2 = Circle
type Box1 = Circle
type Shape = Circle | Sq
type Sq = { s: i32 }
type DotU = Dot | DotB
type DotB = { db: i32 }
type Dot = { r: f64 }
type Circle = { r: f64 }
function useShape(s: Shape): i32 { if s is Sq { return 1 } return 0 }
const sqv: Sq = { s: 1 }
const _sp1: Box1 = { r: 0.5 }
const _sp2: Box2 = { r: 0.5 }
const c = { r: 7.5 }
if useShape(sqv) > 99 { print(0) }
if (c).r > 7.0 { print(7) } else { print(0) }
