type Cir2 = { c2: i32 }
type Sq2 = { s2: i32 }
type Shape2 = Cir2 | Sq2
function mkcall() {
  const lv1 = Map()
  lv1["k0"] = { r: { c2: 1 } }
  const cc: {[string]: {[string]: {r: Shape2}}} = Map()
  cc["k0"] = lv1
  return cc
}
function outer() {
  const lam = () => {
    const g0 = (mkcall())["k0"] ?? Map()
    const g1 = (g0)["k0"] ?? { r: { s2: 1 } }
    if (g1).r is Cir2 { print(7) } else { print(0) }
  }
  lam()
}
outer()
