import { reverse } from "std:array"
type Circle = { r: i64 }
type Dot = { r: i64 }
type DotB = { db: i32 }
type DotU = Dot | DotB
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = Circle
type Box2 = Circle
function useShape(s: Shape): i32 { if s is Sq { return 1 } return 0 }
const sqv: Sq = { s: 1 }
const _sp1: Box1 = { r: 0 }
const _sp2: Box2 = { r: 0 }
const dfl: Circle = { r: 0 }
function rd() {
  const c = { r: 7 }
  const dd = reverse([c])[0]
  if useShape(sqv) > 99 { print(0) }
  const gp: Circle = dd
  if gp.r == 7 { print(7) } else { print(0) }
}
rd()
