type Box1 = {[string]: {r: f32}}
type Circle = { r: f32 }
function sink(_x: {[string]: {r: f32}}) { }
const _sp1: Box1 = Map()
function rd() {
  const c = Map()
  c["k0"] = { r: 7.5 }
  sink(c)
  const lamc = (x: {[string]: {r: f32}}) => x
  const dd = lamc(c)
  const g0 = (dd)["k0"] ?? { r: 0.5 }
  if (g0).r > 7.0 { print(7) } else { print(0) }
}
rd()
