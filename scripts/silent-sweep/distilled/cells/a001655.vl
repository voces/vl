import { reverse } from "std:array"
type N = 1 | 2
type Box1 = {[string]: Circle}
type Circle = { r: N }
const _sp1: Box1 = Map()
function mkc(): {[string]: Circle} {
  const cc = Map()
  cc["k0"] = { r: 1 }
  cc["k1"] = { r: 2 }
  return cc
}
function rd() {
  const c = mkc()
  const dd = reverse([c])[0]
  const g0 = (dd)["k0"] ?? { r: 2 }
  if (g0).r == 1 { print(7) } else { print(0) }
}
rd()
