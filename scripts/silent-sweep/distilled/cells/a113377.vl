type Box1 = {[string]: string}[]
type Shape = Ua | Sq
type Ua = { ua: i32 }
type Sq = { s: i32 }
type DotU = Dot | DotB
type DotB = { db: i32 }
type Dot = { r: string }
function thru(x: {[string]: string}[]) { return x }
function useShape(s: Shape): i32 { if s is Sq { return 1 } return 0 }
const sqv: Sq = { s: 1 }
const _sp1: Box1 = []
const dfl: string = ""
function outer() {
  function inner() {
    const lv1 = Map()
    lv1["k0"] = "seven"
    const c = []
    const dd = thru(c)
    if useShape(sqv) > 99 { print(0) }
    const g0 = dd
    if g0.length > 0 {
      const g1 = (g0[0])["k0"] ?? dfl
      const gp: string = g1
      if gp == "seven" { print(7) } else { print(0) }
    } else { print(0) }
  }
  inner()
}
outer()
