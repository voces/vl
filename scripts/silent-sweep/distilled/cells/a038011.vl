import { reverse } from "std:array"
type Shape = Circle | Sq
type Sq = { s: i32 }
type Dot = { r: string }
type Circle = { r: string }
function mkc(): {[string]: {[string]: Circle}} {
  const lv1 = Map()
  lv1["k0"] = { r: "seven" }
  lv1["k1"] = { r: "" }
  const cc = Map()
  cc["k0"] = lv1
  return cc
}
function rd() {
  const c = mkc()
  const dd = reverse([c])[0]
  const g0 = (dd)["k0"] ?? Map()
  const g1 = (g0)["k0"] ?? { r: "" }
  if (g1).r == "seven" { print(7) } else { print(0) }
}
rd()
