type Box1 = WS2
type Circle = { r: f32 }
type WS1 = { f: {[string]: Circle} }
type WS2 = { f: WS1 }
const _sp1: Box1 = { f: { f: Map() } }
function mkc(): WS2 {
  const lv2 = Map()
  lv2["k0"] = { r: 7.5 }
  lv2["k1"] = { r: 7.5 }
  const lv1: WS1 = { f: lv2 }
  const cc: WS2 = { f: lv1 }
  return cc
}
function rd() {
  const c = mkc()
  const dd = c
  const g2 = (((dd).f).f)["k0"] ?? { r: 0.5 }
  if (g2).r > 7.0 { print(7) } else { print(0) }
}
rd()
