type N = 1 | 2
function mksrc() {
  const lv1 = Map()
  lv1["k0"] = { r: 1 }
  const cc = [lv1]
  return cc
}
function rd(c: {[string]: {r: N}}[]) {
  function inner() {
    const g0 = c
    if g0.length > 0 {
      const g1 = (g0[0])["k0"] ?? { r: 2 }
      if (g1).r == 1 { print(7) } else { print(0) }
    } else { print(0) }
  }
  inner()
}
rd(mksrc())
