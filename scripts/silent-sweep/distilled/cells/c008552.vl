type Circle = { r: f32 }
function mksrc() {
  const lv1 = [{ r: 7.5 }]
  const cc: Circle[][] = [lv1]
  return cc
}
function rd(c: Circle[][]) {
  const g0 = c
  if g0.length > 0 {
    const g1 = g0[0]
    if g1.length > 0 {
      if (g1[0]).r > 7.0 { print(7) } else { print(0) }
    } else { print(0) }
  } else { print(0) }
}
rd(mksrc())
