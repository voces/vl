type Cir2 = { c2: i32 }
type Sq2 = { s2: i32 }
type Shape2 = Cir2 | Sq2
type Circle = { r: Shape2 }
type Dot = { r: Shape2 }
type DotB = { db: i32 }
type DotU = Dot | DotB
type Box1 = {[string]: Circle}[]
const _sp1: Box1 = []
function rd() {
  const lv1 = Map()
  const c: {[string]: Circle}[] = [lv1]
  const g0 = c
  if g0.length > 0 {
    const g1 = (g0[0])["k0"] ?? { r: { s2: 1 } }
    if (g1).r is Cir2 { print(7) } else { print(0) }
  } else { print(0) }
}
rd()
