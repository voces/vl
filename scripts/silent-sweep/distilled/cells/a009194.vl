type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function mksrc() {
  const cc = Map()
  cc["k0"] = { r: 7 }
  cc["k1"] = { r: 7 }
  return cc
}
function rd(c: {[string]: Circle}) {
  const dd = c
  const g0 = (dd)["k0"] ?? { r: 0 }
  if (g0).r == 7 { print(7) } else { print(0) }
}
rd(mksrc())
