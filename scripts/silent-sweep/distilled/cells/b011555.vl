type F = 1.5 | 2.5
type Circle = { r: F }
function rd() {
  const lv1 = Map()
  lv1["k0"] = { r: 1.5 }
  lv1["k1"] = { r: 2.5 }
  const c: {[string]: {[string]: {r: F}}} = Map()
  c["k0"] = lv1
  const dd = c
  const g0 = (dd)["k0"] ?? Map()
  const g1 = (g0)["k0"] ?? { r: 2.5 }
  if (g1).r == 1.5 { print(7) } else { print(0) }
}
rd()
