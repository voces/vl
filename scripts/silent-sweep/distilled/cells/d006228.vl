type N = 1 | 2
type Circle = { r: N }
function mkcall() {
  const lv1 = [{ r: 1 }]
  const cc = Map()
  cc["k0"] = lv1
  return cc
}
function outer() {
  const lam = () => {
    const g0 = (mkcall())["k0"] ?? []
    const g1 = g0
    if g1.length > 0 {
      if (g1[0]).r == 1 { print(7) } else { print(0) }
    } else { print(0) }
  }
  lam()
}
outer()
