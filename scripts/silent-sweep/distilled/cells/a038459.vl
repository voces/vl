type Shape = Circle | Sq
type Sq = { s: i32 }
type Dot = { r: string }
type Circle = { r: string }
function outer() {
  const lam = () => {
    const c: Circle = { r: "seven" }
    const lamc = (x: Circle) => x
    const dd = lamc(c)
    if (dd).r == "seven" { print(7) } else { print(0) }
  }
  lam()
}
outer()
