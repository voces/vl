type Box2 = {[string]: {r: string}}[]
type Box1 = {[string]: {r: string}}[]
type Shape = Ua | Sq
type Ua = { ua: i32 }
type Sq = { s: i32 }
type DotU = Dot | DotB
type DotB = { db: i32 }
type Dot = { r: string }
function sink(_x: {[string]: {r: string}}[]) { }
function useShape(s: Shape): i32 { if s is Sq { return 1 } return 0 }
const sqv: Sq = { s: 1 }
const _sp1: Box1 = []
const _sp2: Box2 = []
function outer() {
  const lv1 = Map()
  lv1["k0"] = { r: "seven" }
  const c = []
  function inner() {
    sink(c)
    const dd = c
    if useShape(sqv) > 99 { print(0) }
    const g0 = dd
    if g0.length > 0 {
      const g1 = (g0[0])["k0"] ?? { r: "" }
      if (g1).r == "seven" { print(7) } else { print(0) }
    } else { print(0) }
  }
  inner()
}
outer()
