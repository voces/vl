import { reverse } from "std:array"
type Circle = { r: i32 | null }
function mkc(): {[string]: Circle} {
  const cc = Map()
  cc["k0"] = { r: null }
  return cc
}
function rd() {
  const c = mkc()
  const dd = reverse([c])[0]
  const g0 = (dd)["k0"] ?? { r: null }
  if (g0).r != null { print(7) } else { print(0) }
}
rd()
