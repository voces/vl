type F = 1.5 | 2.5
type Circle = { r: F }
function mkc(): {[string]: {[string]: {[string]: {r: F}}}} {
  const lv2 = Map()
  lv2["k0"] = { r: 1.5 }
  lv2["k1"] = { r: 2.5 }
  const lv1 = Map()
  lv1["k0"] = lv2
  const cc = Map()
  cc["k0"] = lv1
  return cc
}
function rd() {
  const c = mkc()
  const g0 = (c)["k0"] ?? Map()
  const g1 = (g0)["k0"] ?? Map()
  const g2 = (g1)["k0"] ?? { r: 2.5 }
  if (g2).r == 1.5 { print(7) } else { print(0) }
}
rd()
