type Box1 = {[string]: {r: i32 | null}}[]
type Circle = { r: i32 | null }
function thru(x: {[string]: {r: i32 | null}}[]) { return x }
const _sp1: Box1 = []
function mkc(): {[string]: {r: i32 | null}}[] {
  const lv1 = Map()
  lv1["k0"] = { r: null }
  const cc = [lv1]
  return cc
}
function mksrc() {
  const cc = mkc()
  return cc
}
function rd(c: {[string]: {r: i32 | null}}[]) {
  const dd = thru(c)
  const g0 = dd
  if g0.length > 0 {
    const g1 = (g0[0])["k0"] ?? { r: null }
    if (g1).r != null { print(7) } else { print(0) }
  } else { print(0) }
}
rd(mksrc())
