type F = 1.5 | 2.5
type WS1 = { f: {[string]: {r: F}} }
function mkc(): WS1 {
  const lv1 = Map()
  lv1["k0"] = { r: 1.5 }
  lv1["k1"] = { r: 2.5 }
  const cc: WS1 = { f: lv1 }
  return cc
}
function rd() {
  const c = mkc()
  const lamc = (x: WS1) => x
  const dd = lamc(c)
  const g1 = ((dd).f)["k0"] ?? { r: 2.5 }
  if (g1).r == 1.5 { print(7) } else { print(0) }
}
rd()
