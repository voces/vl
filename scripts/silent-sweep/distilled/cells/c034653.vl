type Cir2 = { c2: i32 }
type Sq2 = { s2: i32 }
type Shape2 = Cir2 | Sq2
type Circle = { r: Shape2 }
type WS1 = { f: {[string]: Circle} }
function mkcall() {
  const lv1 = Map()
  lv1["k0"] = { r: { c2: 1 } }
  const cc: WS1 = { f: lv1 }
  return cc
}
function rd() {
  const g1 = ((mkcall()).f)["k0"] ?? { r: { s2: 1 } }
  if (g1).r is Cir2 { print(7) } else { print(0) }
}
rd()
