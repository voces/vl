type N = 1 | 2
function rd() {
  const lv2 = [{ r: 1 }]
  const lv1: {r: N}[][] = [lv2]
  const c: {r: N}[][][] = [lv1]
  const g0 = c
  if g0.length > 0 {
    const g1 = g0[0]
    if g1.length > 0 {
      const g2 = g1[0]
      if g2.length > 0 {
        if (g2[0]).r == 1 { print(7) } else { print(0) }
      } else { print(0) }
    } else { print(0) }
  } else { print(0) }
}
rd()
