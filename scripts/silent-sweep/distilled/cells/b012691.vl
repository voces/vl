type Circle = { r: i32 | null }
type Dot = { r: i32 | null }
type DotB = { db: i32 }
type DotU = Dot | DotB
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = {[string]: {[string]: Circle}}
type Box2 = {[string]: {[string]: Circle}}
function useShape(s: Shape): i32 { if s is Sq { return 1 } return 0 }
const sqv: Sq = { s: 1 }
const _sp1: Box1 = Map()
const _sp2: Box2 = Map()
function mkc(): {[string]: {[string]: Circle}} {
  const lv1 = Map()
  lv1["k0"] = { r: null }
  const cc = Map()
  cc["k0"] = lv1
  return cc
}
const c = mkc()
const dd = c
if useShape(sqv) > 99 { print(0) }
const g0 = (dd)["k0"] ?? Map()
const g1 = (g0)["k0"] ?? { r: null }
if (g1).r != null { print(7) } else { print(0) }
