type Box1 = {[string]: {r: f64}}[]
type Shape = Circle | Sq
type Sq = { s: i32 }
type Dot = { q: f64 }
type Circle = { r: f64 }
function useShape(s: Shape): i32 { if s is Sq { return 1 } return 0 }
const sqv: Sq = { s: 1 }
const _sp1: Box1 = []
function mkcall() {
  const lv1 = Map()
  lv1["k0"] = { r: 7.5 }
  const cc: {[string]: {r: f64}}[] = [lv1]
  return cc
}
function outer() {
  function inner() {
    const dd = mkcall()
    if useShape(sqv) > 99 { print(0) }
    const g0 = dd
    if g0.length > 0 {
      const g1 = (g0[0])["k0"] ?? { r: 0.5 }
      if (g1).r > 7.0 { print(7) } else { print(0) }
    } else { print(0) }
  }
  inner()
}
outer()
