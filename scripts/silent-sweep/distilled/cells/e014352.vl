type Circle = { r: string }
type Box1 = {[string]: Circle}[]
const _sp1: Box1 = []
function rd() {
  const lv1 = Map()
  lv1["k0"] = { r: "seven" }
  const c: {[string]: Circle}[] = [lv1]
  const g0 = c
  if g0.length > 0 {
    const g1 = (g0[0])["k0"] ?? { r: "" }
    if (g1).r == "seven" { print(7) } else { print(0) }
  } else { print(0) }
}
rd()
