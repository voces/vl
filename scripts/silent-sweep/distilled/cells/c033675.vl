type Cir2 = { c2: i32 }
type Sq2 = { s2: i32 }
type Shape2 = Cir2 | Sq2
type Circle = { r: Shape2 }
type Dot = { r: Shape2 }
type DotB = { db: i32 }
type DotU = Dot | DotB
type Sq = { s: i32 }
type Shape = Circle | Sq
function rd() {
  const lv1 = Map()
  lv1["k0"] = { r: { c2: 1 } }
  const c: {[string]: {[string]: Circle}} = Map()
  c["k0"] = lv1
  const g0 = (c)["k0"] ?? Map()
  const g1 = (g0)["k0"] ?? { r: { s2: 1 } }
  if (g1).r is Cir2 { print(7) } else { print(0) }
}
rd()
