function sink(_x: {[string]: {[string]: {[string]: {r: boolean}}}}) { }
function rd() {
  const lv2 = Map()
  lv2["k0"] = { r: true }
  lv2["k1"] = { r: true }
  const lv1 = Map()
  lv1["k0"] = lv2
  const c = Map()
  c["k0"] = lv1
  sink(c)
  const g0 = (c)["k0"] ?? Map()
  const g1 = (g0)["k0"] ?? Map()
  const g2 = (g1)["k0"] ?? { r: false }
  if (g2).r { print(7) } else { print(0) }
}
rd()
