type Dot = { r: f32 }
type DotB = { db: i32 }
type DotU = Dot | DotB
type Sq = { s: i32 }
type Ua = { ua: i32 }
type Shape = Ua | Sq
type Box1 = {[string]: {r: f32}}[]
type Box2 = {[string]: {r: f32}}[]
function useShape(s: Shape): i32 { if s is Sq { return 1 } return 0 }
const sqv: Sq = { s: 1 }
const _sp1: Box1 = []
const _sp2: Box2 = []
function mkc(): {[string]: {r: f32}}[] {
  const lv1 = Map()
  const cc = [lv1]
  return cc
}
function mksrc() {
  const cc = mkc()
  return cc
}
function rd(c: {[string]: {r: f32}}[]) {
  function inner() {
    if useShape(sqv) > 99 { print(0) }
    const g0 = c
    if g0.length > 0 {
      const g1 = (g0[0])["k0"] ?? { r: 0.5 }
      if (g1).r > 7.0 { print(7) } else { print(0) }
    } else { print(0) }
  }
  inner()
}
rd(mksrc())
