type Cir2 = { c2: i32 }
type Sq2 = { s2: i32 }
type Shape2 = Cir2 | Sq2
type Shape = Circle | Sq
type Sq = { s: i32 }
type Circle = { r: Shape2 }
function rd() {
  const c: Circle[] = []
  const lamc = (x: Circle[]) => x
  const dd = lamc(c)
  let hit = 0
  for zz in dd {
    if zz.r is Cir2 { hit = 7 }
  }
  print(hit)
}
rd()
