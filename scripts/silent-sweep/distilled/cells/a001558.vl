type Circle = { r: i64 }
type Box1 = {r: i64}[]
type GW = { g: {r: i64}[] }
const _sp1: Box1 = []
function mkc(): {r: i64}[] {
  const cc = [{ r: 7 }]
  return cc
}
function rd() {
  const c = mkc()
  const wv: GW = { g: c }
  const g0 = wv.g
  if g0.length > 0 {
    if (g0[0]).r == 7 { print(7) } else { print(0) }
  } else { print(0) }
}
rd()
