type F = 1.5 | 2.5
type Circle = { r: F }
function mksrc() {
  const cc = Map()
  cc["k0"] = { r: 1.5 }
  cc["k1"] = { r: 2.5 }
  return cc
}
function rd(c: {[string]: {r: F}}) {
  function inner() {
    const dd = c
    const g0 = (dd)["k0"] ?? { r: 2.5 }
    if (g0).r == 1.5 { print(7) } else { print(0) }
  }
  inner()
}
rd(mksrc())
