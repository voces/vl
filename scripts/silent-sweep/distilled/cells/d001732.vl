type F = 1.5 | 2.5
function mksrc() {
  const lv1 = [{ r: 1.5 }]
  const cc = [lv1]
  return cc
}
function rd(c: {r: F}[][]) {
  function inner() {
    const g0 = c
    if g0.length > 0 {
      const g1 = g0[0]
      if g1.length > 0 {
        if (g1[0]).r == 1.5 { print(7) } else { print(0) }
      } else { print(0) }
    } else { print(0) }
  }
  inner()
}
rd(mksrc())
