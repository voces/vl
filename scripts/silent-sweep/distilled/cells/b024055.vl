type N = 1 | 2
type Box1 = WS1
type Shape = Ua | Sq
type Ua = { ua: i32 }
type Sq = { s: i32 }
type Dot = { r: N }
type WS1 = { f: {[string]: {r: N}} }
const _sp1: Box1 = { f: Map() }
function rd() {
  const lv1 = Map()
  lv1["k0"] = { r: 1 }
  lv1["k1"] = { r: 1 }
  const c: WS1 = { f: lv1 }
  const g1 = ((c).f)["k0"] ?? { r: 2 }
  if (g1).r == 1 { print(7) } else { print(0) }
}
rd()
