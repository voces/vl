type Inner = { q: i32 }
type Circle = { r: Inner }
type Dot = { r: Inner }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = {[string]: Circle}[]
function useShape(s: Shape): i32 { if s is Sq { return 1 } return 0 }
const sqv: Sq = { s: 1 }
const _sp1: Box1 = []
function mkcall() {
  const lv1 = Map()
  const cc: {[string]: Circle}[] = [lv1]
  return cc
}
function outer() {
  function inner() {
    if useShape(sqv) > 99 { print(0) }
    const g0 = mkcall()
    if g0.length > 0 {
      const g1 = (g0[0])["k0"] ?? { r: { q: 0 } }
      if (g1).r.q == 7 { print(7) } else { print(0) }
    } else { print(0) }
  }
  inner()
}
outer()
