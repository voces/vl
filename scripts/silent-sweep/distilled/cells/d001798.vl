function mkcall() {
  const lv1 = ["seven"]
  const cc = [lv1]
  return cc
}
function outer() {
  const lam = () => {
    const g0 = mkcall()
    if g0.length > 0 {
      const g1 = g0[0]
      if g1.length > 0 {
        if (g1[0]) == "seven" { print(7) } else { print(0) }
      } else { print(0) }
    } else { print(0) }
  }
  lam()
}
outer()
