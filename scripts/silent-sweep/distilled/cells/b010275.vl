import { reverse } from "std:array"
type Circle = { r: string }
type Dot = { r: string }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = {[string]: Circle}
const _sp1: Box1 = Map()
function mkc(): {[string]: Circle} {
  const cc = Map()
  cc["k0"] = { r: "seven" }
  cc["k1"] = { r: "seven" }
  return cc
}
function rd() {
  const c = mkc()
  const dd = reverse([c])[0]
  const g0 = (dd)["k0"] ?? { r: "" }
  if (g0).r == "seven" { print(7) } else { print(0) }
}
rd()
