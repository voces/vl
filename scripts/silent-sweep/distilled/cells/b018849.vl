type Circle = { r: i64 }
type Dot = { r: i64 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = {[string]: Circle[]}
type GW = { g: {[string]: Circle[]} }
const _sp1: Box1 = Map()
function outer() {
  const lv1 = [{ r: 7 }]
  const c = Map()
  c["k0"] = lv1
  function inner() {
    const wv: GW = { g: c }
    const g0 = (wv.g)["k0"] ?? []
    const g1 = g0
    if g1.length > 0 {
      if (g1[0]).r == 7 { print(7) } else { print(0) }
    } else { print(0) }
  }
  inner()
}
outer()
