import { reverse } from "std:array"
type Shape = Ua | Sq
type Ua = { ua: i32 }
type Sq = { s: i32 }
function mkc(): {r: i32}[] {
  const cc = [{ r: 7 }]
  return cc
}
function rd() {
  const c = mkc()
  const dd = reverse([c])[0]
  let hit = 0
  for zz in dd {
    if zz.r == 7 { hit = 7 }
  }
  print(hit)
}
rd()
