import { reverse } from "std:array"
type Circle = { r: string }
type Dot = { r: string }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = {[string]: {[string]: {[string]: Circle}}}
const _sp1: Box1 = Map()
function mkc(): {[string]: {[string]: {[string]: Circle}}} {
  const lv2 = Map()
  lv2["k0"] = { r: "seven" }
  lv2["k1"] = { r: "seven" }
  const lv1 = Map()
  lv1["k0"] = lv2
  const cc = Map()
  cc["k0"] = lv1
  return cc
}
function rd() {
  const c = mkc()
  const dd = reverse([c])[0]
  const g0 = (dd)["k0"] ?? Map()
  const g1 = (g0)["k0"] ?? Map()
  const g2 = (g1)["k0"] ?? { r: "" }
  if (g2).r == "seven" { print(7) } else { print(0) }
}
rd()
