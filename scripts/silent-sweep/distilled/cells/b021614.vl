type Dot = { r: f32 }
type Sq = { s: i32 }
type Ua = { ua: i32 }
type Shape = Ua | Sq
type Box1 = {[string]: {r: f32}}[]
type GW = { g: {[string]: {r: f32}}[] }
const _sp1: Box1 = []
function outer() {
  const lv1 = Map()
  const c = [lv1]
  function inner() {
    const wv: GW = { g: c }
    const g0 = wv.g
    if g0.length > 0 {
      const g1 = (g0[0])["k0"] ?? { r: 0.5 }
      if (g1).r > 7.0 { print(7) } else { print(0) }
    } else { print(0) }
  }
  inner()
}
outer()
