type Inner = { q: i32 }
type Circle = { r: Inner }
type Box1 = {[string]: Circle}[]
const _sp1: Box1 = []
function mksrc() {
  const lv1 = Map()
  lv1["k0"] = { r: { q: 7 } }
  const cc: {[string]: Circle}[] = [lv1]
  return cc
}
function rd(c: {[string]: Circle}[]) {
  const g0 = c
  if g0.length > 0 {
    const g1 = (g0[0])["k0"] ?? { r: { q: 0 } }
    if (g1).r.q == 7 { print(7) } else { print(0) }
  } else { print(0) }
}
rd(mksrc())
