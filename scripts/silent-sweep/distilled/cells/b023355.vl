type Circle = { r: string }
type Dot = { r: string }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = {[string]: Circle}[]
function idg<T>(x: T): T { return x }
const _sp1: Box1 = []
function mkc(): {[string]: Circle}[] {
  const lv1 = Map()
  lv1["k0"] = { r: "seven" }
  lv1["k1"] = { r: "seven" }
  const cc = [lv1]
  return cc
}
function rd() {
  const c = mkc()
  const dd = idg(c)
  const g0 = dd
  if g0.length > 0 {
    const g1 = (g0[0])["k0"] ?? { r: "" }
    if (g1).r == "seven" { print(7) } else { print(0) }
  } else { print(0) }
}
rd()
