type Circle = { r: i32 | null }
type WS1 = { f: {[string]: Circle} }
function mkc(): WS1 {
  const lv1 = Map()
  lv1["k0"] = { r: null }
  const cc: WS1 = { f: lv1 }
  return cc
}
function rd() {
  const c = mkc()
  const g1 = ((c).f)["k0"] ?? { r: null }
  if (g1).r != null { print(7) } else { print(0) }
}
rd()
