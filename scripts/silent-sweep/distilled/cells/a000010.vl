type F = 1.5 | 2.5
type Circle = { r: F }
type GW = { g: {[string]: {[string]: Circle}} }
const dfl: Circle = { r: 2.5 }
function rd() {
  const lv1 = Map()
  lv1["k0"] = { r: 1.5 }
  lv1["k1"] = { r: 1.5 }
  const c = Map()
  c["k0"] = lv1
  const wv: GW = { g: c }
  const g0 = (wv.g)["k0"] ?? Map()
  const g1 = (g0)["k0"] ?? dfl
  const gp: Circle = g1
  if gp.r == 1.5 { print(7) } else { print(0) }
}
rd()
