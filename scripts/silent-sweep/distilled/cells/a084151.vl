type Box1 = {[string]: {r: i32 | null}}[]
type Shape = Circle | Sq
type Sq = { s: i32 }
type Dot = { q: i32 | null }
type Circle = { r: i32 | null }
function thru(x: {[string]: {r: i32 | null}}[]) { return x }
function useShape(s: Shape): i32 { if s is Sq { return 1 } return 0 }
const sqv: Sq = { s: 1 }
const _sp1: Box1 = []
function mkc(): {[string]: {r: i32 | null}}[] {
  const lv1 = Map()
  lv1["k0"] = { r: null }
  const cc = [lv1]
  return cc
}
function mkcall() { return mkc() }
const dd = thru(mkcall())
if useShape(sqv) > 99 { print(0) }
const g0 = dd
if g0.length > 0 {
  const g1 = (g0[0])["k0"] ?? { r: null }
  if (g1).r != null { print(7) } else { print(0) }
} else { print(0) }
