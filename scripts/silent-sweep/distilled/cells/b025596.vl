type Circle = { r: i32 | null }
type Dot = { r: i32 | null }
type DotB = { db: i32 }
type DotU = Dot | DotB
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = WS1
type Box2 = WS1
type WS1 = { f: {[string]: Circle} }
function useShape(s: Shape): i32 { if s is Sq { return 1 } return 0 }
const sqv: Sq = { s: 1 }
const _sp1: Box1 = { f: Map() }
const _sp2: Box2 = { f: Map() }
function mkc(): WS1 {
  const lv1 = Map()
  lv1["k0"] = { r: null }
  const cc: WS1 = { f: lv1 }
  return cc
}
const c = mkc()
const lamc = (x: WS1) => x
const dd = lamc(c)
if useShape(sqv) > 99 { print(0) }
const g1 = ((dd).f)["k0"] ?? { r: null }
if (g1).r != null { print(7) } else { print(0) }
