type Circle = { r: f32 }
function mksrc() {
  const lv1 = Map()
  lv1["k0"] = { r: 7.5 }
  const cc = [lv1]
  return cc
}
function rd(c: {[string]: Circle}[]) {
  function inner() {
    const g0 = c
    if g0.length > 0 {
      const g1 = (g0[0])["k0"] ?? { r: 0.5 }
      if (g1).r > 7.0 { print(7) } else { print(0) }
    } else { print(0) }
  }
  inner()
}
rd(mksrc())
