type F = 1.5 | 2.5
function rd() {
  const lv2 = [{ r: 1.5 }]
  const lv1 = [lv2]
  const c: {r: F}[][][] = [lv1]
  const g0 = c
  if g0.length > 0 {
    const g1 = g0[0]
    if g1.length > 0 {
      const g2 = g1[0]
      if g2.length > 0 {
        if (g2[0]).r == 1.5 { print(7) } else { print(0) }
      } else { print(0) }
    } else { print(0) }
  } else { print(0) }
}
rd()
