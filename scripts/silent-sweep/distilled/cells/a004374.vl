type Box2 = {[string]: {[string]: {[string]: {r: f32}}}}
type Box1 = {[string]: {[string]: {[string]: {r: f32}}}}
const _sp1: Box1 = Map()
const _sp2: Box2 = Map()
const dfl: {r: f32} = { r: 0.5 }
function rd() {
  const lv2 = Map()
  lv2["k0"] = { r: 7.5 }
  lv2["k1"] = { r: 7.5 }
  const lv1 = Map()
  lv1["k0"] = lv2
  const c = Map()
  c["k0"] = lv1
  const lamc = (x: {[string]: {[string]: {[string]: {r: f32}}}}) => x
  const dd = lamc(c)
  const g0 = (dd)["k0"] ?? Map()
  const g1 = (g0)["k0"] ?? Map()
  const g2 = (g1)["k0"] ?? dfl
  const gp: {r: f32} = g2
  if gp.r > 7.0 { print(7) } else { print(0) }
}
rd()
