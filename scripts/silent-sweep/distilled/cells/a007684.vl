type N = 1 | 2
type Shape = Circle | Sq
type Sq = { s: i32 }
type Circle = { r: N }
function sink(_x: {r: N}[][]) { }
function rd() {
  const lv1 = [{ r: 1 }, { r: 2 }]
  const c = [lv1]
  sink(c)
  const dd = c
  const g0 = dd
  if g0.length > 0 {
    const g1 = g0[0]
    if g1.length > 0 {
      if (g1[0]).r == 1 { print(7) } else { print(0) }
    } else { print(0) }
  } else { print(0) }
}
rd()
