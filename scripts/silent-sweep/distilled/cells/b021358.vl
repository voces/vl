type F = 1.5 | 2.5
type Circle = { r: F }
type Dot = { r: F }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = {[string]: {r: F}}[]
const _sp1: Box1 = []
function mkcall() {
  const lv1 = Map()
  lv1["k0"] = { r: 1.5 }
  lv1["k1"] = { r: 2.5 }
  const cc = [lv1]
  return cc
}
function outer() {
  const lam = () => {
    const g0 = mkcall()
    if g0.length > 0 {
      const g1 = (g0[0])["k0"] ?? { r: 2.5 }
      if (g1).r == 1.5 { print(7) } else { print(0) }
    } else { print(0) }
  }
  lam()
}
outer()
