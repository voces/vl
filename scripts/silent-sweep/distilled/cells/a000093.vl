import { reverse } from "std:array"
type Circle = { r: i32 | null }
function sink(_x: {[string]: {[string]: {r: i32 | null}}}) { }
function rd() {
  const lv1 = Map()
  lv1["k0"] = { r: 7 }
  lv1["k1"] = { r: 7 }
  const c = Map()
  c["k0"] = lv1
  sink(c)
  const dd = reverse([c])[0]
  const g0 = (dd)["k0"] ?? Map()
  const g1 = (g0)["k0"] ?? { r: null }
  if (g1).r != null { print(7) } else { print(0) }
}
rd()
