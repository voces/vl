function mkI(): {[string]: i32} {
  const mi: {[string]: i32} = Map()
  mi["z"] = 1
  return mi
}
type Circle = { r: {[string]: i32} }
function rd() {
  const c = Map()
  c["k0"] = { r: mkI() }
  const lamc = (x: {[string]: Circle}) => x
  const dd = lamc(c)
  const g0 = (dd)["k0"] ?? { r: Map() }
  if (g0).r.size == 1 { print(7) } else { print(0) }
}
rd()
