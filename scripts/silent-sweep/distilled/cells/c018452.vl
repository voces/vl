type K = "p" | "q"
type Circle = { r: K }
type WS1 = { f: {[string]: Circle} }
function mksrc() {
  const lv1 = Map()
  lv1["k0"] = { r: "p" }
  const cc: WS1 = { f: lv1 }
  return cc
}
function rd(c: WS1) {
  const g1 = ((c).f)["k0"] ?? { r: "q" }
  if (g1).r == "p" { print(7) } else { print(0) }
}
rd(mksrc())
