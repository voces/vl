type Circle = { r: i32 | null }
type Sq = { s: i32 }
type Shape = Circle | Sq
const lv1 = Map()
lv1["k0"] = { r: 7 }
const c: {[string]: Circle}[] = [lv1]
function rd() {
  const g0 = c
  if g0.length > 0 {
    const g1 = (g0[0])["k0"] ?? { r: null }
    if (g1).r != null { print(7) } else { print(0) }
  } else { print(0) }
}
rd()
