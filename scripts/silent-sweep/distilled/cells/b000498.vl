import { reverse } from "std:array"
type Circle = { r: i32 | null }
type Dot = { r: i32 | null }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = Circle
function sink(_x: Circle) { }
const _sp1: Box1 = { r: null }
function mkcall() {
  const cc = { r: null }
  return cc
}
function outer() {
  const lam = () => {
    sink(mkcall())
    const dd = reverse([mkcall()])[0]
    if (dd).r != null { print(7) } else { print(0) }
  }
  lam()
}
outer()
