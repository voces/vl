type N = 1 | 2
type Circle = { r: N }
function rd() {
  const lv1 = Map()
  const c: {[string]: {[string]: {r: N}}} = Map()
  c["k0"] = lv1
  const lamc = (x: {[string]: {[string]: {r: N}}}) => x
  const dd = lamc(c)
  const g0 = (dd)["k0"] ?? Map()
  const g1 = (g0)["k0"] ?? { r: 2 }
  if (g1).r == 1 { print(7) } else { print(0) }
}
rd()
