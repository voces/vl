type Cir2 = { c2: i32 }
type Sq2 = { s2: i32 }
type Shape2 = Cir2 | Sq2
function mksrc() {
  const lv1 = Map()
  lv1["k0"] = { r: { c2: 1 } }
  const cc: {[string]: {r: Shape2}}[] = [lv1]
  return cc
}
function rd(c: {[string]: {r: Shape2}}[]) {
  function inner() {
    const g0 = c
    if g0.length > 0 {
      const g1 = (g0[0])["k0"] ?? { r: { s2: 1 } }
      if (g1).r is Cir2 { print(7) } else { print(0) }
    } else { print(0) }
  }
  inner()
}
rd(mksrc())
