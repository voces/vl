type Box1 = {[string]: {[string]: {r: i32 | null}}}
type Shape = Circle | Sq
type Sq = { s: i32 }
type Dot = { r: i32 | null }
type Circle = { r: i32 | null }
const _sp1: Box1 = Map()
function mkcall() {
  const lv1 = Map()
  lv1["k0"] = { r: null }
  const cc: {[string]: {[string]: {r: i32 | null}}} = Map()
  cc["k0"] = lv1
  return cc
}
function outer() {
  const lam = () => {
    const g0 = (mkcall())["k0"] ?? Map()
    const g1 = (g0)["k0"] ?? { r: null }
    if (g1).r != null { print(7) } else { print(0) }
  }
  lam()
}
outer()
