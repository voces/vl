type Circle = { r: f64 }
type Dot = { r: f64 }
type DotB = { db: i32 }
type DotU = Dot | DotB
type Box1 = {[string]: Circle}[]
const _sp1: Box1 = []
function outer() {
  const lv1 = Map()
  lv1["k0"] = { r: 7.5 }
  const c: {[string]: Circle}[] = [lv1]
  function inner() {
    const g0 = c
    if g0.length > 0 {
      const g1 = (g0[0])["k0"] ?? { r: 0.5 }
      if (g1).r > 7.0 { print(7) } else { print(0) }
    } else { print(0) }
  }
  inner()
}
outer()
