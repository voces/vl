type Box1 = {[string]: i32}[]
const _sp1: Box1 = []
function mkcall() {
  const lv1 = Map()
  lv1["k0"] = 7
  lv1["k1"] = 7
  const cc = [lv1]
  return cc
}
const lamc = (x: {[string]: i32}[]) => x
const dd = lamc(mkcall())
const g0 = dd
if g0.length > 0 {
  const g1 = (g0[0])["k0"] ?? 0
  if (g1) == 7 { print(7) } else { print(0) }
} else { print(0) }
