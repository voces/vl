import { reverse } from "std:array"
type Circle = { r: string }
type Dot = { r: string }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = {[string]: {[string]: Circle}}
const _sp1: Box1 = Map()
function mkcall() {
  const lv1 = Map()
  lv1["k0"] = { r: "seven" }
  lv1["k1"] = { r: "seven" }
  const cc = Map()
  cc["k0"] = lv1
  return cc
}
function outer() {
  const lam = () => {
    const dd = reverse([mkcall()])[0]
    const g0 = (dd)["k0"] ?? Map()
    const g1 = (g0)["k0"] ?? { r: "" }
    if (g1).r == "seven" { print(7) } else { print(0) }
  }
  lam()
}
outer()
