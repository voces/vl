type Circle = { r: f32 }
type WS1 = { f: {[string]: Circle} }
type WS2 = { f: WS1 }
function rd() {
  const lv2 = Map()
  lv2["k0"] = { r: 7.5 }
  const lv1: WS1 = { f: lv2 }
  const c: WS2 = { f: lv1 }
  const g2 = (((c).f).f)["k0"] ?? { r: 0.5 }
  if (g2).r > 7.0 { print(7) } else { print(0) }
}
rd()
