type N = 1 | 2
type Circle = { r: N }
type WS1 = { f: {[string]: {r: N}} }
const dfl: {r: N} = { r: 2 }
function mksrc() {
  const lv1 = Map()
  lv1["k0"] = { r: 1 }
  const cc: WS1 = { f: lv1 }
  return cc
}
function rd(c: WS1) {
  const g1 = ((c).f)["k0"] ?? dfl
  const gp: {r: N} = g1
  if gp.r == 1 { print(7) } else { print(0) }
}
rd(mksrc())
