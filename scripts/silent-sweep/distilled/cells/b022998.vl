type Box2 = {[string]: {r: string}}[]
type Box1 = {[string]: {r: string}}[]
type Shape = Ua | Sq
type Ua = { ua: i32 }
type Sq = { s: i32 }
type DotU = Dot | DotB
type DotB = { db: i32 }
type Dot = { r: string }
function useShape(s: Shape): i32 { if s is Sq { return 1 } return 0 }
const sqv: Sq = { s: 1 }
const _sp1: Box1 = []
const _sp2: Box2 = []
function mkc(): {[string]: {r: string}}[] {
  const lv1 = Map()
  lv1["k0"] = { r: "seven" }
  const cc = []
  return cc
}
function mkcall() { return mkc() }
function outer() {
  const lam = () => {
    if useShape(sqv) > 99 { print(0) }
    const g0 = mkcall()
    if g0.length > 0 {
      const g1 = (g0[0])["k0"] ?? { r: "" }
      if (g1).r == "seven" { print(7) } else { print(0) }
    } else { print(0) }
  }
  lam()
}
outer()
