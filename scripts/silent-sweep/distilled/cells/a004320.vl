import { reverse } from "std:array"
type Box2 = {[string]: {r: i32 | null}}
type Box1 = {[string]: {r: i32 | null}}
function sink(_x: {[string]: {r: i32 | null}}) { }
const _sp1: Box1 = Map()
const _sp2: Box2 = Map()
