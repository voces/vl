type Circle = { r: i64 }
type Dot = { r: i64 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = {[string]: Circle}[]
type GW = { g: {[string]: Circle}[] }
const _sp1: Box1 = []
function mkcall() {
  const lv1 = Map()
  lv1["k0"] = { r: 7 }
  const cc: {[string]: Circle}[] = [lv1]
  return cc
}
function outer() {
  const lam = () => {
    const wv: GW = { g: mkcall() }
    const g0 = wv.g
    if g0.length > 0 {
      const g1 = (g0[0])["k0"] ?? { r: 0 }
      if (g1).r == 7 { print(7) } else { print(0) }
    } else { print(0) }
  }
  lam()
}
outer()
