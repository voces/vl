type Shape = Circle | Sq
type Sq = { s: i32 }
type Circle = { r: f64 }
function idg<T>(x: T): T { return x }
function mkc(): {[string]: {[string]: {[string]: Circle}}} {
  const lv2 = Map()
  lv2["k0"] = { r: 7.5 }
  lv2["k1"] = { r: 0.5 }
  const lv1 = Map()
  lv1["k0"] = lv2
  const cc = Map()
  cc["k0"] = lv1
  return cc
}
function rd() {
  const c = mkc()
  const dd = idg(c)
  const g0 = (dd)["k0"] ?? Map()
  const g1 = (g0)["k0"] ?? Map()
  const g2 = (g1)["k0"] ?? { r: 0.5 }
  if (g2).r > 7.0 { print(7) } else { print(0) }
}
rd()
