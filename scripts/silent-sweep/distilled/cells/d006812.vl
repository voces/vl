type K = "p" | "q"
function mksrc() {
  const lv1 = Map()
  lv1["k0"] = { r: "p" }
  const cc: {[string]: {r: K}}[] = [lv1]
  return cc
}
function rd(c: {[string]: {r: K}}[]) {
  function inner() {
    const g0 = c
    if g0.length > 0 {
      const g1 = (g0[0])["k0"] ?? { r: "q" }
      if (g1).r == "p" { print(7) } else { print(0) }
    } else { print(0) }
  }
  inner()
}
rd(mksrc())
