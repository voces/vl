type F = 1.5 | 2.5
type Circle = { r: F }
type GW = { g: {r: F}[][] }
function rd() {
  const lv1 = [{ r: 1.5 }, { r: 2.5 }]
  const c = [lv1]
  const wv: GW = { g: c }
  const g0 = wv.g
  if g0.length > 0 {
    const g1 = g0[0]
    if g1.length > 0 {
      if (g1[0]).r == 1.5 { print(7) } else { print(0) }
    } else { print(0) }
  } else { print(0) }
}
rd()
