type N = 1 | 2
type Dot = { q: N }
type Sq = { s: i32 }
type Ua = { ua: i32 }
type Shape = Ua | Sq
type Box1 = {[string]: {r: N}}[]
function useShape(s: Shape): i32 { if s is Sq { return 1 } return 0 }
const sqv: Sq = { s: 1 }
const _sp1: Box1 = []
function mkcall() {
  const lv1 = Map()
  lv1["k0"] = { r: 1 }
  lv1["k1"] = { r: 2 }
  const cc = [lv1]
  return cc
}
function outer() {
  function inner() {
    if useShape(sqv) > 99 { print(0) }
    const g0 = mkcall()
    if g0.length > 0 {
      const g1 = (g0[0])["k0"] ?? { r: 2 }
      if (g1).r == 1 { print(7) } else { print(0) }
    } else { print(0) }
  }
  inner()
}
outer()
