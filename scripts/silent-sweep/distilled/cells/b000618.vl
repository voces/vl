type Circle = { r: i64 }
type Dot = { r: i64 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = Circle
const _sp1: Box1 = { r: 0 }
function mkc(): Circle {
  const cc = { r: 7 }
  return cc
}
function mkcall() { return mkc() }
function outer() {
  const lam = () => {
    const lamc = (x: Circle) => x
    const dd = lamc(mkcall())
    if (dd).r == 7 { print(7) } else { print(0) }
  }
  lam()
}
outer()
