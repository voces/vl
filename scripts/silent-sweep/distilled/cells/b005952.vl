type F = 1.5 | 2.5
type Circle = { r: F }
function mksrc() {
  const lv2 = [{ r: 1.5 }, { r: 2.5 }]
  const lv1 = [lv2]
  const cc = [lv1]
  return cc
}
function rd(c: {r: F}[][][]) {
  function inner() {
    const g0 = c
    if g0.length > 0 {
      const g1 = g0[0]
      if g1.length > 0 {
        const g2 = g1[0]
        if g2.length > 0 {
          if (g2[0]).r == 1.5 { print(7) } else { print(0) }
        } else { print(0) }
      } else { print(0) }
    } else { print(0) }
  }
  inner()
}
rd(mksrc())
