type Box1 = Circle
type Shape = Circle | Sq
type Sq = { s: i32 }
type Dot = { r: f64 }
type Circle = { r: f64 }
const _sp1: Box1 = { r: 0.5 }
function mksrc() {
  const cc = { r: 7.5 }
  return cc
}
function rd(c: Circle) {
  function inner() {
    if (c).r > 7.0 { print(7) } else { print(0) }
  }
  inner()
}
rd(mksrc())
