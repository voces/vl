type Circle = { r: i32 | null }
type Dot = { r: i32 | null }
type DotB = { db: i32 }
type DotU = Dot | DotB
type Sq = { s: i32 }
type Shape = Circle | Sq
function sink(_x: {[string]: {[string]: Circle}}) { }
function rd() {
  const lv1 = Map()
  lv1["k0"] = { r: null }
  const c = Map()
  c["k0"] = lv1
  sink(c)
  const g0 = (c)["k0"] ?? Map()
  const g1 = (g0)["k0"] ?? { r: null }
  if (g1).r != null { print(7) } else { print(0) }
}
rd()
