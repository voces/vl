type F = 1.5 | 2.5
type Circle = { r: F }
type WS1 = { f: {[string]: {r: F}} }
type WS2 = { f: WS1 }
function rd() {
  const lv2 = Map()
  lv2["k0"] = { r: 1.5 }
  lv2["k1"] = { r: 2.5 }
  const lv1: WS1 = { f: lv2 }
  const c: WS2 = { f: lv1 }
  const g2 = (((c).f).f)["k0"] ?? { r: 2.5 }
  if (g2).r == 1.5 { print(7) } else { print(0) }
}
rd()
