type Cir2 = { c2: i32 }
type Sq2 = { s2: i32 }
type Shape2 = Cir2 | Sq2
type Circle = { r: Shape2 }
type WS1 = { f: {[string]: {r: Shape2}} }
const lv1 = Map()
lv1["k0"] = { r: { c2: 1 } }
const c: WS1 = { f: lv1 }
const g1 = ((c).f)["k0"] ?? { r: { s2: 1 } }
if (g1).r is Cir2 { print(7) } else { print(0) }
