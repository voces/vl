type F = 1.5 | 2.5
function rd() {
  const lv2 = Map()
  lv2["k0"] = { r: 1.5 }
  const lv1 = Map()
  lv1["k0"] = lv2
  const c: {[string]: {[string]: {[string]: {r: F}}}} = Map()
  c["k0"] = lv1
  const g0 = (c)["k0"] ?? Map()
  const g1 = (g0)["k0"] ?? Map()
  const g2 = (g1)["k0"] ?? { r: 2.5 }
  if (g2).r == 1.5 { print(7) } else { print(0) }
}
rd()
