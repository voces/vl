type N = 1 | 2
type Box1 = {[string]: {[string]: {[string]: {r: N}}}}
type Shape = Ua | Sq
type Ua = { ua: i32 }
type Sq = { s: i32 }
type Dot = { r: N }
const _sp1: Box1 = Map()
function mkc(): {[string]: {[string]: {[string]: {r: N}}}} {
  const lv2 = Map()
  lv2["k0"] = { r: 1 }
  lv2["k1"] = { r: 1 }
  const lv1 = Map()
  lv1["k0"] = lv2
  const cc = Map()
  cc["k0"] = lv1
  return cc
}
function rd() {
  const c = mkc()
  const dd = c
  const g0 = (dd)["k0"] ?? Map()
  const g1 = (g0)["k0"] ?? Map()
  const g2 = (g1)["k0"] ?? { r: 2 }
  if (g2).r == 1 { print(7) } else { print(0) }
}
rd()
