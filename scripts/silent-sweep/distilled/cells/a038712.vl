type Shape = Circle | Sq
type Sq = { s: i32 }
type Dot = { r: i32 | null }
type Circle = { r: i32 | null }
type WS1 = { f: {[string]: Circle} }
function sink(_x: WS1) { }
const lv1 = Map()
lv1["k0"] = { r: null }
const c: WS1 = { f: lv1 }
sink(c)
const lamc = (x: WS1) => x
const dd = lamc(c)
const g1 = ((dd).f)["k0"] ?? { r: null }
if (g1).r != null { print(7) } else { print(0) }
