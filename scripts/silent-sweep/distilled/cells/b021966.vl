type Circle = { r: string }
type Dot = { r: string }
type DotB = { db: i32 }
type DotU = Dot | DotB
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = {[string]: Circle}[]
type Box2 = {[string]: Circle}[]
function useShape(s: Shape): i32 { if s is Sq { return 1 } return 0 }
const sqv: Sq = { s: 1 }
const _sp1: Box1 = []
const _sp2: Box2 = []
const lv1 = Map()
lv1["k0"] = { r: "seven" }
lv1["k1"] = { r: "seven" }
const c: {[string]: Circle}[] = [lv1]
const dd = c
if useShape(sqv) > 99 { print(0) }
const g0 = dd
if g0.length > 0 {
  const g1 = (g0[0])["k0"] ?? { r: "" }
  if (g1).r == "seven" { print(7) } else { print(0) }
} else { print(0) }
