type Circle = { r: i32 | null }
type Dot = { r: i32 | null }
type DotB = { db: i32 }
type DotU = Dot | DotB
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = Circle
type Box2 = Circle
function sink(_x: Circle) { }
function useShape(s: Shape): i32 { if s is Sq { return 1 } return 0 }
const sqv: Sq = { s: 1 }
const _sp1: Box1 = { r: null }
const _sp2: Box2 = { r: null }
const c = { r: null }
sink(c)
const dd = c
if useShape(sqv) > 99 { print(0) }
if (dd).r != null { print(7) } else { print(0) }
