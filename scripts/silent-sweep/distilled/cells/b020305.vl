type Circle = { r: i32 | null }
function mkc(): {[string]: Circle[]} {
  const lv1 = [{ r: null }]
  const cc = Map()
  cc["k0"] = lv1
  return cc
}
function rd() {
  const c = mkc()
  const g0 = (c)["k0"] ?? []
  const g1 = g0
  if g1.length > 0 {
    if (g1[0]).r != null { print(7) } else { print(0) }
  } else { print(0) }
}
rd()
