import { reverse } from "std:array"
type K = "p" | "q"
type WS1 = { f: {[string]: {r: K}} }
function mkc(): WS1 {
  const lv1 = Map()
  lv1["k0"] = { r: "p" }
  lv1["k1"] = { r: "p" }
  const cc: WS1 = { f: lv1 }
  return cc
}
function rd() {
  const c = mkc()
  const dd = reverse([c])[0]
  const g1 = ((dd).f)["k0"] ?? { r: "q" }
  if (g1).r == "p" { print(7) } else { print(0) }
}
rd()
