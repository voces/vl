type N = 1 | 2
type Box1 = {[string]: {[string]: {r: N}}}
type Shape = Ua | Sq
type Ua = { ua: i32 }
type Sq = { s: i32 }
type Dot = { r: N }
const _sp1: Box1 = Map()
function mkc(): {[string]: {[string]: {r: N}}} {
  const lv1 = Map()
  lv1["k0"] = { r: 1 }
  lv1["k1"] = { r: 1 }
  const cc = Map()
  cc["k0"] = lv1
  return cc
}
function rd() {
  const c = mkc()
  const g0 = (c)["k0"] ?? Map()
  const g1 = (g0)["k0"] ?? { r: 2 }
  if (g1).r == 1 { print(7) } else { print(0) }
}
rd()
