type Cir2 = { c2: i32 }
type Sq2 = { s2: i32 }
type Shape2 = Cir2 | Sq2
type WS1 = { f: {[string]: {r: Shape2}} }
function mkcall() {
  const lv1 = Map()
  lv1["k0"] = { r: { c2: 1 } }
  const cc: WS1 = { f: lv1 }
  return cc
}
function outer() {
  const lam = () => {
    const g1 = ((mkcall()).f)["k0"] ?? { r: { s2: 1 } }
    if (g1).r is Cir2 { print(7) } else { print(0) }
  }
  lam()
}
outer()
