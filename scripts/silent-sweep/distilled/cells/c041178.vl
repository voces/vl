function mkcall() {
  const lv2 = ["seven"]
  const lv1 = [lv2]
  const cc: string[][][] = [lv1]
  return cc
}
function rd() {
  const g0 = mkcall()
  if g0.length > 0 {
    const g1 = g0[0]
    if g1.length > 0 {
      const g2 = g1[0]
      if g2.length > 0 {
        if (g2[0]) == "seven" { print(7) } else { print(0) }
      } else { print(0) }
    } else { print(0) }
  } else { print(0) }
}
rd()
