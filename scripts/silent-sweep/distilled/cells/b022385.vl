type Dot = { r: f32 }
type Sq = { s: i32 }
type Ua = { ua: i32 }
type Shape = Ua | Sq
type Box1 = {[string]: {r: f32}}[]
function thru(x: {[string]: {r: f32}}[]) { return x }
const _sp1: Box1 = []
function rd() {
  const lv1 = Map()
  const c: {[string]: {r: f32}}[] = [lv1]
  const dd = thru(c)
  const g0 = dd
  if g0.length > 0 {
    const g1 = (g0[0])["k0"] ?? { r: 0.5 }
    if (g1).r > 7.0 { print(7) } else { print(0) }
  } else { print(0) }
}
rd()
