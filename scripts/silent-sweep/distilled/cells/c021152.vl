type N = 1 | 2
type Circle = { r: N }
type WS1 = { f: {[string]: Circle} }
function mksrc() {
  const lv1 = Map()
  lv1["k0"] = { r: 1 }
  const cc: WS1 = { f: lv1 }
  return cc
}
function rd(c: WS1) {
  const g1 = ((c).f)["k0"] ?? { r: 2 }
  if (g1).r == 1 { print(7) } else { print(0) }
}
rd(mksrc())
