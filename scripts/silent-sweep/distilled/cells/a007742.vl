import { reverse } from "std:array"
type K = "p" | "q"
type Shape = Circle | Sq
type Sq = { s: i32 }
type Circle = { r: K }
function sink(_x: {r: K}[][]) { }
function rd() {
  const lv1 = [{ r: "p" }, { r: "p" }]
  const c = [lv1]
  sink(c)
  const dd = reverse([c])[0]
  const g0 = dd
  if g0.length > 0 {
    const g1 = g0[0]
    if g1.length > 0 {
      if (g1[0]).r == "p" { print(7) } else { print(0) }
    } else { print(0) }
  } else { print(0) }
}
rd()
