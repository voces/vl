import { reverse } from "std:array"
function sink(_x: {[string]: {r: f32}[]}) { }
function rd() {
  const lv1 = [{ r: 7.5 }, { r: 0.5 }]
  const c = Map()
  c["k0"] = lv1
  sink(c)
  const dd = reverse([c])[0]
  const g0 = (dd)["k0"] ?? []
  const g1 = g0
  if g1.length > 0 {
    if (g1[0]).r > 7.0 { print(7) } else { print(0) }
  } else { print(0) }
}
rd()
