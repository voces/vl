type Circle = { r: i64 }
const lv2 = Map()
lv2["k0"] = { r: 7 }
const lv1 = Map()
lv1["k0"] = lv2
const c: {[string]: {[string]: {[string]: Circle}}} = Map()
c["k0"] = lv1
const lamc = (x: {[string]: {[string]: {[string]: Circle}}}) => x
const dd = lamc(c)
const g0 = (dd)["k0"] ?? Map()
const g1 = (g0)["k0"] ?? Map()
const g2 = (g1)["k0"] ?? { r: 0 }
if (g2).r == 7 { print(7) } else { print(0) }
