type F = 1.5 | 2.5
type Box2 = {[string]: {r: F}[]}
type Box1 = {[string]: {r: F}[]}
const _sp1: Box1 = Map()
const _sp2: Box2 = Map()
function mksrc() {
  const lv1 = [{ r: 1.5 }, { r: 2.5 }]
  const cc = Map()
  cc["k0"] = lv1
  return cc
}
function rd(c: {[string]: {r: F}[]}) {
  const g0 = (c)["k0"] ?? []
  const g1 = g0
  if g1.length > 0 {
    if (g1[0]).r == 1.5 { print(7) } else { print(0) }
  } else { print(0) }
}
rd(mksrc())
