type Circle = { r: i32 }
type Dot = { q: i32 }
type Box1 = {[string]: Circle}[]
const _sp1: Box1 = []
function mksrc() {
  const lv1 = Map()
  lv1["k0"] = { r: 7 }
  const cc: {[string]: Circle}[] = [lv1]
  return cc
}
function rd(c: {[string]: Circle}[]) {
  const g0 = c
  if g0.length > 0 {
    const g1 = (g0[0])["k0"] ?? { r: 0 }
    if (g1).r == 7 { print(7) } else { print(0) }
  } else { print(0) }
}
rd(mksrc())
