type Circle = { r: i32 }
type Dot = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function outer() {
  const lv1 = [{ r: 7 }]
  const c: Circle[][] = [lv1]
  function inner() {
    const g0 = c
    if g0.length > 0 {
      const g1 = g0[0]
      if g1.length > 0 {
        if (g1[0]).r == 7 { print(7) } else { print(0) }
      } else { print(0) }
    } else { print(0) }
  }
  inner()
}
outer()
