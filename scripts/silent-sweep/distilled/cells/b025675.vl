import { reverse } from "std:array"
type Circle = { r: string }
type Dot = { r: string }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = WS1
type WS1 = { f: {[string]: Circle} }
const _sp1: Box1 = { f: Map() }
function mkc(): WS1 {
  const lv1 = Map()
  lv1["k0"] = { r: "seven" }
  lv1["k1"] = { r: "seven" }
  const cc: WS1 = { f: lv1 }
  return cc
}
function rd() {
  const c = mkc()
  const dd = reverse([c])[0]
  const g1 = ((dd).f)["k0"] ?? { r: "" }
  if (g1).r == "seven" { print(7) } else { print(0) }
}
rd()
