type Box1 = {[string]: {r: i32}}[]
type Shape = Circle | Sq
type Sq = { s: i32 }
type Dot = { r: i32 }
type Circle = { r: i32 }
const _sp1: Box1 = []
const lv1 = Map()
lv1["k0"] = { r: 7 }
lv1["k1"] = { r: 0 }
const c = [lv1]
const dd = c
const g0 = dd
if g0.length > 0 {
  const g1 = (g0[0])["k0"] ?? { r: 0 }
  if (g1).r == 7 { print(7) } else { print(0) }
} else { print(0) }
