type Shape = Circle | Sq
type Sq = { s: i32 }
type Circle = { r: i32 }
function mksrc() {
  const lv2 = Map()
  lv2["k0"] = { r: 7 }
  lv2["k1"] = { r: 7 }
  const lv1 = Map()
  lv1["k0"] = lv2
  const cc = Map()
  cc["k0"] = lv1
  return cc
}
function rd(c: {[string]: {[string]: {[string]: Circle}}}) {
  const lamc = (x: {[string]: {[string]: {[string]: Circle}}}) => x
  const dd = lamc(c)
  const g0 = (dd)["k0"] ?? Map()
  const g1 = (g0)["k0"] ?? Map()
  const g2 = (g1)["k0"] ?? { r: 0 }
  if (g2).r == 7 { print(7) } else { print(0) }
}
rd(mksrc())
