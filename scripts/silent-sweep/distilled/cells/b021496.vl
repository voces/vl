type Circle = { r: string }
type Dot = { r: string }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = {[string]: Circle}[]
const _sp1: Box1 = []
const lv1 = Map()
lv1["k0"] = { r: "seven" }
lv1["k1"] = { r: "seven" }
const c = [lv1]
const lamc = (x: {[string]: Circle}[]) => x
const dd = lamc(c)
const g0 = dd
if g0.length > 0 {
  const g1 = (g0[0])["k0"] ?? { r: "" }
  if (g1).r == "seven" { print(7) } else { print(0) }
} else { print(0) }
