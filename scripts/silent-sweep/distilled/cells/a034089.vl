type Box1 = {[string]: string}[]
type Dot = { r: string }
function thru(x: {[string]: string}[]) { return x }
const _sp1: Box1 = []
const dfl: string = ""
function outer() {
  const lv1 = Map()
  lv1["k0"] = "seven"
  const c = []
  function inner() {
    const dd = thru(c)
    const g0 = dd
    if g0.length > 0 {
      const g1 = (g0[0])["k0"] ?? dfl
      const gp: string = g1
      if gp == "seven" { print(7) } else { print(0) }
    } else { print(0) }
  }
  inner()
}
outer()
