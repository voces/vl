type F = 1.5 | 2.5
type Circle = { r: F }
function mksrc() {
  const lv1 = [{ r: 1.5 }, { r: 2.5 }]
  const cc = Map()
  cc["k0"] = lv1
  return cc
}
function rd(c: {[string]: {r: F}[]}) {
  function inner() {
    const dd = c
    const g0 = (dd)["k0"] ?? []
    const g1 = g0
    if g1.length > 0 {
      if (g1[0]).r == 1.5 { print(7) } else { print(0) }
    } else { print(0) }
  }
  inner()
}
rd(mksrc())
