type Shape = Circle | Sq
type Sq = { s: i32 }
type Dot = { r: i32 }
type Circle = { r: i32 }
type GW = { g: {[string]: {[string]: Circle}} }
function outer() {
  const lv1 = Map()
  lv1["k0"] = { r: 7 }
  const c = Map()
  c["k0"] = lv1
  function inner() {
    const wv: GW = { g: c }
    const g0 = (wv.g)["k0"] ?? Map()
    const g1 = (g0)["k0"] ?? { r: 0 }
    if (g1).r == 7 { print(7) } else { print(0) }
  }
  inner()
}
outer()
