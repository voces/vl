import { reverse } from "std:array"
type N = 1 | 2
type Box1 = Circle[][][]
type Circle = { r: N }
const _sp1: Box1 = []
function mkc(): Circle[][][] {
  const lv2 = [{ r: 1 }, { r: 1 }]
  const lv1 = [lv2]
  const cc = [lv1]
  return cc
}
function rd() {
  const c = mkc()
  const dd = reverse([c])[0]
  const g0 = dd
  if g0.length > 0 {
    const g1 = g0[0]
    if g1.length > 0 {
      const g2 = g1[0]
      if g2.length > 0 {
        if (g2[0]).r == 1 { print(7) } else { print(0) }
      } else { print(0) }
    } else { print(0) }
  } else { print(0) }
}
rd()
