type Box1 = {[string]: i32}[]
const _sp1: Box1 = []
function rd() {
  const lv1 = Map()
  lv1["k0"] = 7
  lv1["k1"] = 7
  const c = [lv1]
  const lamc = (x: {[string]: i32}[]) => x
  const dd = lamc(c)
  const g0 = dd
  if g0.length > 0 {
    const g1 = (g0[0])["k0"] ?? 0
    if (g1) == 7 { print(7) } else { print(0) }
  } else { print(0) }
}
rd()
