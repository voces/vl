type F = 1.5 | 2.5
type Circle = { r: F }
function mksrc() {
  const lv1 = Map()
  lv1["k0"] = { r: 1.5 }
  lv1["k1"] = { r: 2.5 }
  const cc = Map()
  cc["k0"] = lv1
  return cc
}
function rd(c: {[string]: {[string]: {r: F}}}) {
  function inner() {
    const g0 = (c)["k0"] ?? Map()
    const g1 = (g0)["k0"] ?? { r: 2.5 }
    if (g1).r == 1.5 { print(7) } else { print(0) }
  }
  inner()
}
rd(mksrc())
