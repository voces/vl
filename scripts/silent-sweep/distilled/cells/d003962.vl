type K = "p" | "q"
function mksrc() {
  const lv1 = Map()
  lv1["k0"] = { r: "p" }
  const cc = Map()
  cc["k0"] = lv1
  return cc
}
function rd(c: {[string]: {[string]: {r: K}}}) {
  function inner() {
    const g0 = (c)["k0"] ?? Map()
    const g1 = (g0)["k0"] ?? { r: "q" }
    if (g1).r == "p" { print(7) } else { print(0) }
  }
  inner()
}
rd(mksrc())
