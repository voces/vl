type Sq = { s: i32 }
type Ua = { ua: i32 }
type Shape = Ua | Sq
type Box1 = {[string]: string}[]
function useShape(s: Shape): i32 { if s is Sq { return 1 } return 0 }
const sqv: Sq = { s: 1 }
const _sp1: Box1 = []
function mksrc() {
  const lv1 = Map()
  lv1["k0"] = "seven"
  const cc: {[string]: string}[] = [lv1]
  return cc
}
function rd(c: {[string]: string}[]) {
  if useShape(sqv) > 99 { print(0) }
  const g0 = c
  if g0.length > 0 {
    const g1 = (g0[0])["k0"] ?? ""
    if (g1) == "seven" { print(7) } else { print(0) }
  } else { print(0) }
}
rd(mksrc())
