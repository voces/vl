function outer() {
  const lv2 = ["seven"]
  const lv1 = [lv2]
  const c: string[][][] = [lv1]
  function inner() {
    const g0 = c
    if g0.length > 0 {
      const g1 = g0[0]
      if g1.length > 0 {
        const g2 = g1[0]
        if g2.length > 0 {
          if (g2[0]) == "seven" { print(7) } else { print(0) }
        } else { print(0) }
      } else { print(0) }
    } else { print(0) }
  }
  inner()
}
outer()
