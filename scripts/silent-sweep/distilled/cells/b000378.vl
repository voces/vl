type Circle = { r: i64 }
type Dot = { r: i64 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = Circle
function sink(_x: Circle) { }
const _sp1: Box1 = { r: 0 }
function mkcall() {
  const cc = { r: 7 }
  return cc
}
function outer() {
  const lam = () => {
    sink(mkcall())
    if (mkcall()).r == 7 { print(7) } else { print(0) }
  }
  lam()
}
outer()
