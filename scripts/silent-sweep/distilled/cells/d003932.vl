function mksrc() {
  const lv1 = Map()
  lv1["k0"] = { r: 7.5 }
  const cc = Map()
  cc["k0"] = lv1
  return cc
}
function rd(c: {[string]: {[string]: {r: f32}}}) {
  function inner() {
    const g0 = (c)["k0"] ?? Map()
    const g1 = (g0)["k0"] ?? { r: 0.5 }
    if (g1).r > 7.0 { print(7) } else { print(0) }
  }
  inner()
}
rd(mksrc())
