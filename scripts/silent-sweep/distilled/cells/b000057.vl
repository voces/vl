type Circle = { r: i64 }
type Dot = { r: i64 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = Circle
const _sp1: Box1 = { r: 0 }
function mksrc() {
  const cc = { r: 7 }
  return cc
}
function rd(c: Circle) {
  function inner() {
    const lamc = (x: Circle) => x
    const dd = lamc(c)
    if (dd).r == 7 { print(7) } else { print(0) }
  }
  inner()
}
rd(mksrc())
