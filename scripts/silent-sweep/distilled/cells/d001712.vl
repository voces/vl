type K = "p" | "q"
function mksrc() {
  const lv1 = [{ r: "p" }]
  const cc = [lv1]
  return cc
}
function rd(c: {r: K}[][]) {
  function inner() {
    const g0 = c
    if g0.length > 0 {
      const g1 = g0[0]
      if g1.length > 0 {
        if (g1[0]).r == "p" { print(7) } else { print(0) }
      } else { print(0) }
    } else { print(0) }
  }
  inner()
}
rd(mksrc())
