type K = "p" | "q"
type Box2 = {[string]: {r: K}[]}
type Box1 = {[string]: {r: K}[]}
const _sp1: Box1 = Map()
const _sp2: Box2 = Map()
const dfl: {r: K} = { r: "q" }
function rd() {
  const lv1 = [{ r: "p" }]
  const c = Map()
  c["k0"] = lv1
  const lamc = (x: {[string]: {r: K}[]}) => x
  const dd = lamc(c)
  const g0 = (dd)["k0"] ?? []
  const g1 = g0
  if g1.length > 0 {
    const gp: {r: K} = g1[0]
    if gp.r == "p" { print(7) } else { print(0) }
  } else { print(0) }
}
rd()
