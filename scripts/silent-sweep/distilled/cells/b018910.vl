type Circle = { r: i32 | null }
type GW = { g: {[string]: Circle[]} }
function rd() {
  const lv1 = [{ r: null }]
  const c = Map()
  c["k0"] = lv1
  const wv: GW = { g: c }
  const g0 = (wv.g)["k0"] ?? []
  const g1 = g0
  if g1.length > 0 {
    if (g1[0]).r != null { print(7) } else { print(0) }
  } else { print(0) }
}
rd()
