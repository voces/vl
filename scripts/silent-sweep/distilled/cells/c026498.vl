type Circle = { r: i32[] }
type Dot = { r: i32[] }
type DotB = { db: i32 }
type DotU = Dot | DotB
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = {[string]: Circle}[]
function useShape(s: Shape): i32 { if s is Sq { return 1 } return 0 }
const sqv: Sq = { s: 1 }
const _sp1: Box1 = []
function mkcall() {
  const lv1 = Map()
  lv1["k0"] = { r: [1, 2] }
  const cc: {[string]: Circle}[] = [lv1]
  return cc
}
function rd() {
  if useShape(sqv) > 99 { print(0) }
  const g0 = mkcall()
  if g0.length > 0 {
    const g1 = (g0[0])["k0"] ?? { r: [] }
    if (g1).r.length == 2 { print(7) } else { print(0) }
  } else { print(0) }
}
rd()
