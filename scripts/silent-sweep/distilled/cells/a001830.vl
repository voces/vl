type Box1 = {[string]: {r: string}}[]
type Circle = { r: string }
function thru(x: {[string]: {r: string}}[]) { return x }
const _sp1: Box1 = []
function outer() {
  function inner() {
    const lv1 = Map()
    const c = [lv1]
    const dd = thru(c)
    const g0 = dd
    if g0.length > 0 {
      const g1 = (g0[0])["k0"] ?? { r: "" }
      if (g1).r == "seven" { print(7) } else { print(0) }
    } else { print(0) }
  }
  inner()
}
outer()
