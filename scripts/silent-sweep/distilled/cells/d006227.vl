type N = 1 | 2
type Circle = { r: N }
function mksrc() {
  const lv1 = [{ r: 1 }]
  const cc = Map()
  cc["k0"] = lv1
  return cc
}
function rd(c: {[string]: Circle[]}) {
  function inner() {
    const g0 = (c)["k0"] ?? []
    const g1 = g0
    if g1.length > 0 {
      if (g1[0]).r == 1 { print(7) } else { print(0) }
    } else { print(0) }
  }
  inner()
}
rd(mksrc())
