type Circle = { r: i64 }
type Dot = { r: i64 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = Circle[]
const _sp1: Box1 = []
function rd() {
  const c = [{ r: 7 }]
  const lamc = (x: Circle[]) => x
  const dd = lamc(c)
  const g0 = dd
  if g0.length > 0 {
    if (g0[0]).r == 7 { print(7) } else { print(0) }
  } else { print(0) }
}
rd()
