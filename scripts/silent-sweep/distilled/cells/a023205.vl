type Sq = { s: i32 }
type Ua = { ua: i32 }
type Shape = Ua | Sq
type Box1 = {[string]: i32}[]
function useShape(s: Shape): i32 { if s is Sq { return 1 } return 0 }
const sqv: Sq = { s: 1 }
const _sp1: Box1 = []
function mksrc() {
  const lv1 = Map()
  lv1["k0"] = 7
  lv1["k1"] = 7
  const cc = [lv1]
  return cc
}
function rd(c: {[string]: i32}[]) {
  function inner() {
    const lamc = (x: {[string]: i32}[]) => x
    const dd = lamc(c)
    if useShape(sqv) > 99 { print(0) }
    const g0 = dd
    if g0.length > 0 {
      const g1 = (g0[0])["k0"] ?? 0
      if (g1) == 7 { print(7) } else { print(0) }
    } else { print(0) }
  }
  inner()
}
rd(mksrc())
