function rd() {
  const lv2 = []
  const lv1 = [lv2]
  const c = [lv1]
  const dd = c
  const g0 = dd
  if g0.length > 0 {
    const g1 = g0[0]
    if g1.length > 0 {
      const g2 = g1[0]
      if g2.length > 0 {
        if (g2[0]) == "seven" { print(7) } else { print(0) }
      } else { print(0) }
    } else { print(0) }
  } else { print(0) }
}
rd()
