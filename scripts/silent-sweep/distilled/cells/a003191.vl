function mkI(): {[string]: i32} {
  const mi: {[string]: i32} = Map()
  mi["z"] = 1
  return mi
}
type Box1 = {[string]: Circle}[]
type Circle = { r: {[string]: i32} }
type GW = { g: {[string]: Circle}[] }
function sink(_x: {[string]: Circle}[]) { }
const _sp1: Box1 = []
function mkcall() {
  const lv1 = Map()
  lv1["k0"] = { r: mkI() }
  lv1["k1"] = { r: Map() }
  const cc = [lv1]
  return cc
}
sink(mkcall())
const wv: GW = { g: mkcall() }
const g0 = wv.g
if g0.length > 0 {
  const g1 = (g0[0])["k0"] ?? { r: Map() }
  if (g1).r.size == 1 { print(7) } else { print(0) }
} else { print(0) }
