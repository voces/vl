type Circle = { r: i32 }
type Dot = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type WS1 = { f: {[string]: Circle} }
const lv1 = Map()
lv1["k0"] = { r: 7 }
const c: WS1 = { f: lv1 }
function rd() {
  const g1 = ((c).f)["k0"] ?? { r: 0 }
  if (g1).r == 7 { print(7) } else { print(0) }
}
rd()
