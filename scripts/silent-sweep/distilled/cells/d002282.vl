function mksrc() {
  const lv2 = [{ r: 7.5 }]
  const lv1 = [lv2]
  const cc: {r: f32}[][][] = [lv1]
  return cc
}
function rd(c: {r: f32}[][][]) {
  function inner() {
    const g0 = c
    if g0.length > 0 {
      const g1 = g0[0]
      if g1.length > 0 {
        const g2 = g1[0]
        if g2.length > 0 {
          if (g2[0]).r > 7.0 { print(7) } else { print(0) }
        } else { print(0) }
      } else { print(0) }
    } else { print(0) }
  }
  inner()
}
rd(mksrc())
