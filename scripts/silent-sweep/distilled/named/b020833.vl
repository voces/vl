const dfl: {r: f32} = { r: 0.5 }
function mkcall() {
  const lv1 = []
  const cc = Map()
  cc["k0"] = lv1
  return cc
}
function outer() {
  const lam = () => {
    const g0 = (mkcall())["k0"] ?? []
    const g1 = g0
    if g1.length > 0 {
      const gp: {r: f32} = g1[0]
      if gp.r > 7.0 { print(7) } else { print(0) }
    } else { print(0) }
  }
  lam()
}
outer()
