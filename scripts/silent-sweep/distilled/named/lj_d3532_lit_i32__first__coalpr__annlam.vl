type K = "a" | "b"
const x0: K = "a"
const xn: K | null = "a"
type Rec = { x: i32 }
const r7: Rec = { x: 7 }
const r9: Rec = { x: 9 }
function app(f) { f() }
function F<A, B>(k: i32, a: A, b: B) {
  const g = () => { if k == 0 { null } else if k == 1 { a } else { b } }
  const v: A | B | null = g()
  print(v ?? "b")
}
F(0, x0, 3)
F(1, x0, 3)
F(2, x0, 3)
