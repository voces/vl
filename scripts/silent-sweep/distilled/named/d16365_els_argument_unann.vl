// d16365_els_argument_unann — D16365: `empty-list-shared-record.matrix.vl`, cell `argument_unann`. Should print 12459.5.
type P = { x: i32, ys: f64[] }
function __take(a) {
  const v = a
  v.push({ x: 4, ys: [] })
  const other: P[] = []
  other.push({ x: 9, ys: [] })
  v[0].ys.push(0.5)
  v.push({ x: 5, ys: [] })
  const n = other.length * 10000 + v.length * 1000 + v[0].x * 100 + v[1].x * 10 + other[0].x
  print(v[0].ys[0] + (n + other[0].ys.length + v[1].ys.length) as f64)
}
__take([])
