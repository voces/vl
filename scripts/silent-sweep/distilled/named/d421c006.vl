type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type K = "a" | "b"
type N = 1 | 2
type F = 1.5 | 2.5
type CM = {[string]: i32}

function eqL<T>(a: T[], b: T[]): boolean { return a == b }
function cell(): boolean {
  const a: F[] = [1.5]
  const b: F[] = [2.5]
  return eqL(a, b)
}
print(cell())
