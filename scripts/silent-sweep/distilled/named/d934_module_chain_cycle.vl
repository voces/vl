// D934 — a module-scope ident chain that is a CYCLE. `anonLeafArgIdentSeen` resolves a
// module-level name by re-entering itself, and the depth cap counts CALL frames, which an
// ident chain opens none of. The name-visited set is the only thing bounding this: without it
// the compiler exhausts its own call stack on this program (measured, not asserted).
function src(p: {r: i32}): {r: i32} | null {
  p
}

let a = { r: 7 }
let b = a
a = b

function rd() {
  const g1 = src(a) ?? { r: "s" }
  print(g1.r)
}

rd()
