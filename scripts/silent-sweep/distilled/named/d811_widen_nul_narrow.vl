type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function f() {
  const xs = [{ r: 7 }, null]
  const a: (Circle | null)[] = xs
  const b: (Shape | null)[] = xs
  print(a.length)
  const g0 = b[0]
  if g0 != null {
    if g0 is Circle { print(g0.r) }
  }
  const g1 = b[1]
  if g1 != null {
    if g1 is Circle { print(g1.r) }
  }
  print(9)
}
f()
