type Circle = { r: i32[] }
function mkcall() {
  const cc = Map()
  return cc
}
const g0 = mkcall()["k0"] ?? []
const g1 = g0
if g1.length > 0 {
  const gp: Circle = g1[0]
  print(gp.r.length)
} else { print(0) }
function rd() {
  const m = Map()
  const xs = m["k"] ?? [1, 2]
  print(xs[1] + 1)
}
rd()
