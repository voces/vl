type Circle = { r: i32 | null }
const dfl: Circle = { r: null }
const lv2 = [{ r: null }]
const lv1 = [lv2]
const c = [lv1]
const lamc = (x: Circle[][][]) => x
const dd = lamc(c)
const g0 = dd
if g0.length > 0 {
  const g1 = g0[0]
  if g1.length > 0 {
    const g2 = g1[0]
    if g2.length > 0 {
      const gp: Circle = g2[0]
      if gp.r != null { print(7) } else { print(0) }
    } else { print(0) }
  } else { print(0) }
} else { print(0) }
