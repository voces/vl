function loop() {
  let i = 0
  let acc = 0
  while i < 20 {
    i = i + 1
    const r = i % 5
    match r {
      0 => {
        continue
      }
      1 => {
        acc = acc + 1
      }
      2 => {
        acc = acc + 10
      }
      3 => {
        if i > 15 { break }
        acc = acc + 100
      }
      _ => {
        acc = acc + 1000
      }
    }
  }
  return acc * 100 + i
}
print(loop())
