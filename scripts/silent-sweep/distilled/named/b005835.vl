type Circle = { r: i32 | null }
function idg<T>(x: T): T { return x }
const dfl: Circle = { r: null }
function rd() {
  const lv1 = [{ r: null }]
  const c = [lv1]
  const dd = idg(c)
  const g0 = dd
  if g0.length > 0 {
    const g1 = g0[0]
    if g1.length > 0 {
      const gp: Circle = g1[0]
      if gp.r != null { print(7) } else { print(0) }
    } else { print(0) }
  } else { print(0) }
}
rd()
