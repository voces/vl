type Circle = { r: i64 }
type Dot = { r: i64 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = Circle[][]
function idg<T>(x: T): T { return x }
const _sp1: Box1 = []
const dfl: Circle = { r: 0 }
function rd() {
  const lv1 = [{ r: 7 }]
  const c = [lv1]
  const dd = idg(c)
  const g0 = dd
  if g0.length > 0 {
    const g1 = g0[0]
    if g1.length > 0 {
      const gp: Circle = g1[0]
      if gp.r == 7 { print(7) } else { print(0) }
    } else { print(0) }
  } else { print(0) }
}
rd()
