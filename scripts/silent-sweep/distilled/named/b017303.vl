type Circle = { r: i32 | null }
function sink(_x: Circle[]) { }
function mkcall() {
  const cc = [{ r: null }]
  return cc
}
function outer() {
  const lam = () => {
    sink(mkcall())
    let hit = 0
    for zz in mkcall() {
      if zz.r != null { hit = 7 }
    }
    print(hit)
  }
  lam()
}
outer()
