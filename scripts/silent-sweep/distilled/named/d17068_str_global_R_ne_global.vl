type U = i32 | string
type H = { k: string }
let tr = ""
let gk: string = "s"
let gu: U = "s"
function ok(): string {
  tr = tr + "o"
  return gk
}
function oh(): H {
  tr = tr + "o"
  return { k: gk }
}
function bx(): U {
  tr = tr + "b"
  return gu
}
function g() { return gk != gu }
gu = "s"
print(g())
gu = "t"
print(g())
gu = 1
print(g())
print(tr)
