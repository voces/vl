type AB = "a" | "b"
type N12 = 1 | 2
type R = { a: {[i32]: f64 | null}, b: {[i32]: f64} }
function show(x) { print(x) }
function mk(): R {
  const a: {[i32]: f64 | null} = Map()
  a[3] = 2.5
  a[4] = 4.5
  a[5] = null
  const b: {[i32]: f64} = Map()
  b[3] = 2.5
  b[4] = 4.5
  { a: a, b: b }
}
function use(p) {
  print(p.a[9] ?? p.a[8] ?? p.b[3])
}
use(mk())
