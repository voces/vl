// D935 — a two-field family, with the enrolled literal writing its fields in the OTHER order.
// `anonLeafSameFieldNames` compares names rather than positions, and the arithmetic pins that
// the enrolled row's slots are still read at the right fields.
function src2(p: {r: i32, s: i32}): {r: i32, s: i32} | null {
  p
}

function keep(q: {r: i32, s: i32}): i32 {
  q.r + q.s
}

function rd() {
  const q = { r: 7, s: 2 }
  const g1 = src2(q) ?? { r: "x", s: 9 }
  print(g1.r)
  print(keep(q))
  print(keep({ s: 5, r: 4 }))
}

rd()
