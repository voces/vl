type AB = "a" | "b"
type N12 = 1 | 2
type R = { a: {[i32]: N12 | null}, b: {[i32]: boolean} }
function show(x) { print(x) }
function mk(): R {
  const a: {[i32]: N12 | null} = Map()
  a[3] = 1
  a[4] = 2
  a[5] = null
  const b: {[i32]: boolean} = Map()
  b[3] = false
  b[4] = true
  { a: a, b: b }
}
function use(p) {
  print(p.a[9] ?? p.a[4] ?? p.b[3])
}
use(mk())
