type Circle = { r: i32 | null }
type Dot = { r: i32 | null }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = {[string]: {[string]: {[string]: Circle}}}
function thru(x: {[string]: {[string]: {[string]: Circle}}}) { return x }
const _sp1: Box1 = Map()
function mkc(): {[string]: {[string]: {[string]: Circle}}} {
  const lv2 = Map()
  lv2["k0"] = { r: null }
  const lv1 = Map()
  lv1["k0"] = lv2
  const cc = Map()
  cc["k0"] = lv1
  return cc
}
function mksrc() {
  const cc = mkc()
  return cc
}
function rd(c: {[string]: {[string]: {[string]: Circle}}}) {
  function inner() {
    const dd = thru(c)
    const g0 = (dd)["k0"] ?? Map()
    const g1 = (g0)["k0"] ?? Map()
    const g2 = (g1)["k0"] ?? { r: null }
    if (g2).r != null { print(7) } else { print(0) }
  }
  inner()
}
rd(mksrc())
