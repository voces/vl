function mkI(): {[string]: i32} {
  const mi: {[string]: i32} = Map()
  mi["z"] = 1
  return mi
}
type Box2 = {r: {[string]: i32}}
type Box1 = {r: {[string]: i32}}
type Shape = Circle | Sq
type Sq = { s: i32 }
type DotU = Dot | DotB
type DotB = { db: i32 }
type Dot = { r: {[string]: i32} }
type Circle = { r: {[string]: i32} }
function idg<T>(x: T): T { return x }
function useShape(s: Shape): i32 { if s is Sq { return 1 } return 0 }
const sqv: Sq = { s: 1 }
const _sp1: Box1 = { r: Map() }
const _sp2: Box2 = { r: Map() }
function mksrc() {
  const cc: {r: {[string]: i32}} = { r: mkI() }
  return cc
}
function rd(c: {r: {[string]: i32}}) {
  function inner() {
    const dd = idg(c)
    if useShape(sqv) > 99 { print(0) }
    if (dd).r.length == 1 { print(7) } else { print(0) }
  }
  inner()
}
rd(mksrc())
