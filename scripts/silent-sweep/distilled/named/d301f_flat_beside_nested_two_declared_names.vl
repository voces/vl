// @run
// @log 0
// @log 0
// D301's OWN FILED WITNESS, kept whole (silent-class-inventory D301).
//
// Two sections in one module: a FLAT `{[string]: Circle}` fed by an inferred `Map()`
// return (D300's shape, which D300 closed) and a NESTED `{[string]: {[string]: CircleN}}`
// of the same value layout. Deleting the nested half leaves D300's program, which RUNS.
// Deleting the FLAT half does NOT rescue the other — `type Circle` still stands, so the
// second declared name is still there and the nested half is still check-clean invalid
// wasm. That asymmetry is the row's mechanism: the defect is the SECOND DECLARED NAME, not
// the pairing of containers, and the filed row's "delete either section and the other
// RUNS" was true in one direction only.
//
// Renaming `CircleN` to `Circle` — one declared name instead of two layout twins — makes
// both halves run on master. That is the one-change control.
type Circle = { r: i32 | null }
type CircleN = { r: i32 | null }
function mkflat() {
  const cc = Map()
  cc["k0"] = { r: null }
  return cc
}
function thru(x: {[string]: {[string]: CircleN}}) { return x }
const flat: {[string]: Circle} = mkflat()
const f0 = flat["k0"] ?? { r: null }
if (f0).r != null { print(7) } else { print(0) }
function nested() {
  const iv = Map()
  iv["k0"] = { r: null }
  const om = Map()
  om["k0"] = iv
  const dd = thru(om)
  const n0 = (dd)["k0"] ?? Map()
  const n1 = (n0)["k0"] ?? { r: null }
  if (n1).r != null { print(7) } else { print(0) }
}
nested()
