// d16361_gl_map_set_unann — D16361: `fn-value-generic-list-literal-arg-at-i32.matrix.vl`, cell `map_set_unann`. Should print 35.
function id<T>(x: T): T { return x }
function __inc(x: i32): i32 { return x + 1 }
function __run<U>(a: ((x: U) => U)[], u: U): U { return a[1](u) }
const __m = Map()
__m.set("k", id)
const __mv = __m.get("k")
if __mv != null {
  const v = __mv
  print(__run([v, __inc], 2) * 10 + v(5))
}
