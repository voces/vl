type Circle = { r: i64 }
type Dot = { r: i64 }
type DotB = { db: i32 }
type DotU = Dot | DotB
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = Circle[][]
type Box2 = Circle[][]
type GW = { g: Circle[][] }
function useShape(s: Shape): i32 { if s is Sq { return 1 } return 0 }
const sqv: Sq = { s: 1 }
const _sp1: Box1 = []
const _sp2: Box2 = []
function rd() {
  const lv1 = [{ r: 7 }]
  const c = [lv1]
  const wv: GW = { g: c }
  if useShape(sqv) > 99 { print(0) }
  const g0 = wv.g
  if g0.length > 0 {
    const g1 = g0[0]
    if g1.length > 0 {
      if (g1[0]).r == 7 { print(7) } else { print(0) }
    } else { print(0) }
  } else { print(0) }
}
rd()
