type AB = "a" | "b"
type N12 = 1 | 2
function show(x) { print(x) }
type R = { a: {[string]: N12}, b: {[string]: N12} }
function mk(): R {
  const a: {[string]: N12} = Map()
  a["k1"] = 1
  a["k2"] = 2
  const b: {[string]: N12} = Map()
  b["k1"] = 2
  { a: a, b: b }
}
function use(p) {
  const r = p.a["k1"] ?? 1
  print(r == null)
}
use(mk())
