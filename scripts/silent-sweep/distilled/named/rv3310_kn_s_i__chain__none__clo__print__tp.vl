type K = "a" | "b"
type P = {x: i32}
function g<T0, T1, T2>(a0: T0, a1: T1, a2: T2, k: i32) {
  const f = (j: i32) => if j == 0 { a0 } else if j == 1 { a1 } else { a2 }
  const e = f(k)
  print(e)
}
const x0: K | null = "b"
const x1: string = "y"
const x2: i32 = 6
g(x0, x1, x2, 0)
g(x0, x1, x2, 1)
g(x0, x1, x2, 2)
