type Box1 = {[string]: {r: string}}[]
type Shape = Ua | Sq
type Ua = { ua: i32 }
type Sq = { s: i32 }
type Dot = { r: string }
function idg<T>(x: T): T { return x }
const _sp1: Box1 = []
const dfl: {r: string} = { r: "" }
function mksrc() {
  const lv1 = Map()
  lv1["k0"] = { r: "seven" }
  const cc = []
  return cc
}
function rd(c: {[string]: {r: string}}[]) {
  function inner() {
    const dd = idg(c)
    const g0 = dd
    if g0.length > 0 {
      const g1 = (g0[0])["k0"] ?? dfl
      const gp: {r: string} = g1
      if gp.r == "seven" { print(7) } else { print(0) }
    } else { print(0) }
  }
  inner()
}
rd(mksrc())
