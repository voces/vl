type U = i32 | boolean
type H = { k: boolean }
let tr = ""
let gk: boolean = true
let gu: U = true
function ok(): boolean {
  tr = tr + "o"
  return gk
}
function oh(): H {
  tr = tr + "o"
  return { k: gk }
}
function bx(): U {
  tr = tr + "b"
  return gu
}
function g() { return gk == gu }
gu = true
print(g())
gu = false
print(g())
gu = 1
print(g())
print(tr)
