type GW = { g: {[string]: {[string]: {r: f32}}} }
function mkcall() {
  const lv1 = Map()
  const cc = Map()
  cc["k0"] = lv1
  return cc
}
function outer() {
  const lam = () => {
    const wv: GW = { g: mkcall() }
    const g0 = (wv.g)["k0"] ?? Map()
    const g1 = (g0)["k0"] ?? { r: 0.5 }
    if (g1).r > 7.0 { print(7) } else { print(0) }
  }
  lam()
}
outer()
