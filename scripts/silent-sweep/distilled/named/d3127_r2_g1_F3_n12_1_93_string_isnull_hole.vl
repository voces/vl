type AB = "a" | "b"
type N12 = 1 | 2
type R = { a: {[string]: N12 | null} }
function show(x) { print(x) }
function mk(): R {
  const a: {[string]: N12 | null} = Map()
  a["k3"] = 1
  a["k4"] = 2
  a["k5"] = null
  { a: a }
}
function use(p) {
  const r = p.a["k9"] ?? p.a["k3"] ?? 1
  print(r == null)
}
use(mk())
