type Circle = { r: i32 | null }
type Dot = { r: i32 | null }
type DotB = { db: i32 }
type DotU = Dot | DotB
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = Circle[][][]
type Box2 = Circle[][][]
function thru(x: Circle[][][]) { return x }
function sink(_x: Circle[][][]) { }
function useShape(s: Shape): i32 { if s is Sq { return 1 } return 0 }
const sqv: Sq = { s: 1 }
const _sp1: Box1 = []
const _sp2: Box2 = []
const lv2 = [{ r: null }]
const lv1 = [lv2]
const c = [lv1]
sink(c)
const dd = thru(c)
if useShape(sqv) > 99 { print(0) }
const g0 = dd
if g0.length > 0 {
  const g1 = g0[0]
  if g1.length > 0 {
    const g2 = g1[0]
    if g2.length > 0 {
      if (g2[0]).r != null { print(7) } else { print(0) }
    } else { print(0) }
  } else { print(0) }
} else { print(0) }
