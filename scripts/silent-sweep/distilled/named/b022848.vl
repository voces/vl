function idg<T>(x: T): T { return x }
function sink(_x: {[string]: {r: f32}}[]) { }
function mkcall() {
  const lv1 = Map()
  const cc = [lv1]
  return cc
}
function outer() {
  const lam = () => {
    sink(mkcall())
    const dd = idg(mkcall())
    const g0 = dd
    if g0.length > 0 {
      const g1 = (g0[0])["k0"] ?? { r: 0.5 }
      if (g1).r > 7.0 { print(7) } else { print(0) }
    } else { print(0) }
  }
  lam()
}
outer()
