// @run
// @log 2.25
// @log 4
// @log 4
// @log 6
// @log 2.25
// @log 4
// @log 6
// A hole function over a list handed two sets' lists, one member also read at f64 elsewhere: each
// list takes its own instance, keyed by its set, and each call through an element dispatches by
// that instance's set (D15049). The control is `4 6`, not `4 4`.
function inc0(a) { return a + 1 }
function dbl0(a) { return a * 2 }
function deliver0() { return [inc0] }
function take2(a) { print(a.map((f) => [1].map((y) => f(y + 2))[0])[0]) }
print(deliver0().map((f) => f(1.25))[0])
take2(deliver0())
function take3(a) { return a.map((f) => f(3)) }
print(take3([inc0])[0])
print(take3([dbl0])[0])
function takeAt(a) { return [a[0](3)] }
print(deliver0()[0](1.25))
print(takeAt([inc0])[0])
print(takeAt([dbl0])[0])
