function __inc(a) { return a + 1 }
function __half(a) { return a / 2.0 }
const __rec = { fs: [__inc] }
const __ali = __rec.fs
__ali[0] = __half
const __m: { [string]: { fs: readonly ((a: i32) => i32 | f64)[] } } = Map()
__m["k"] = __rec
const __mv = __m["k"]
if __mv != null {
  const v: { fs: readonly ((a: i32) => i32 | f64)[] } = __mv
  print(v.fs[0](3))
}
