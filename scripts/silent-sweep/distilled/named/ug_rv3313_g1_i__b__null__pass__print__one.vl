type K = "a" | "b"
type P = {x: i32}
function g(a0, a1, k: i32) {
  const r = if k == 0 { a0 } else if k == 1 { a1 } else { null }
  return r
}
function h(x, y, k: i32) {
  return g(x, y, k)
}
const x0: i32 = 3
const x1: boolean = false
const v0_0 = h(x0, x1, 0)
print(v0_0)
const v0_1 = h(x0, x1, 1)
print(v0_1)
const v0_2 = h(x0, x1, 2)
print(v0_2)
const v1_0 = h(x0, x1, 0)
print(v1_0)
const v1_1 = h(x0, x1, 1)
print(v1_1)
const v1_2 = h(x0, x1, 2)
print(v1_2)
