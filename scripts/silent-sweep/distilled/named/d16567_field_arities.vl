type K = { keys: (x: i32) => i32, values: (x: i32, y: i32) => i32, clear: (x: i32) => i32, set: (x: i32) => i32, add: () => i32, has: () => boolean, push: () => i32, pop: (x: i32) => i32 }
function mk(): K { return { keys: (x) => x + 1, values: (x, y) => x + y, clear: (x) => x * 2, set: (x) => x - 1, add: () => 7, has: () => true, push: () => 9, pop: (x) => x + 100 } }
function t(a) { print(a.keys(1)); print(a.values(2, 3)); print(a.clear(4)); print(a.set(5)); print(a.add()); print(a.has()); print(a.push()); print(a.pop(1)) }
t(mk())
