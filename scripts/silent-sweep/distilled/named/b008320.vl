type Box1 = Circle[][][]
const _sp1: Box1 = []
const dfl: Circle = { r: null }
function rd() {
  const lv2 = [{ r: null }]
  const lv1 = [lv2]
  const c = [lv1]
  const lamc = (x: Circle[][][]) => x
  const dd = lamc(c)
  const g0 = dd
