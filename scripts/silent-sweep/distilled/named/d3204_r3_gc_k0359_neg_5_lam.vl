type A = { v: i32 }
type B = { s: string }
type D = { d: string }
type E = { e: i32 }
const F = (z) => {
  if !(z.h is A) { if !(z.h == null) { if !(z.h is E) { if !(z.h is D) { print(z.h + 1) } else { print(z.h.d) } } else { print(z.h.e) } } else { print("nul") } } else { print(z.h.v) }
}
const x: { h: A | D | E | i32 | null } = { h: { d: "dee" } }
F(x)
