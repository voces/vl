// d16361_gl_global_assign_unann — D16361: `fn-value-generic-list-literal-arg-at-i32.matrix.vl`, cell `global_assign_unann`. Should print 35.
function id<T>(x: T): T { x }
function __inc(x: i32): i32 { x + 1 }
function __run<U>(a: ((x: U) => U)[], u: U): U { a[1](u) }
let __a = id
let __b = id
__b = __a
const v = __b
print(__run([v, __inc], 2) * 10 + v(5))
