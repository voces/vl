import { reverse } from "std:array"
type Shape = Ua | Sq
type Ua = { ua: i32 }
type Sq = { s: i32 }
type Dot = { q: i64 }
function sink(_x: {r: i64}[][]) { }
const lv1 = [{ r: 7 }, { r: 7 }]
const c = [lv1]
function rd() {
  sink(c)
  const dd = reverse([c])[0]
  const g0 = dd
  if g0.length > 0 {
    const g1 = g0[0]
    if g1.length > 0 {
      if (g1[0]).r == 7 { print(7) } else { print(0) }
    } else { print(0) }
  } else { print(0) }
}
rd()
