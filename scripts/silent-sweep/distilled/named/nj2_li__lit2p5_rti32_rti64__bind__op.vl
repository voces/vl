function kind<T>(v: T): string {
  if v is i32 { return "i32" }
  if v is i64 { return "i64" }
  if v is f32 { return "f32" }
  if v is f64 { return "f64" }
  "other"
}
function run(e1: i32, e2: i64, k: i32) {
  const xs = [2.5, e1, e2]
  print(xs[0])
  print(kind(xs[0]))
  print(xs[1])
  print(kind(xs[1]))
  print(xs[2])
  print(kind(xs[2]))
  print("<\{xs[0]}>")
}
run(-3, -9000000003, 0)
