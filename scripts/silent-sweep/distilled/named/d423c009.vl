type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type K = "a" | "b"
type N = 1 | 2
type F = 1.5 | 2.5
type CM = {[string]: i32}

function eqLL<T>(a: T[][], b: T[][]): boolean { return a == b }
function cell(): boolean {
  const a: i32[][] = [[1]]
  const b: i32[][] = [[2]]
  return eqLL(a, b)
}
print(cell())
