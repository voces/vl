// @run
// @log 1
// THE CELL THAT PRICES D853's ELEMENT-READ GATE — `d741_w5_no_narrow`, kept as a fixture
// because it is the one running program the rule beside it could take.
//
// Same two disagreeing unions as `error-list-two-different-unions-written.vl`, same store
// of a `Tri` through the `Other[]` handle. The only difference is that no ELEMENT is ever
// read: `print(a.length)` asks about the list, not about what is in it.
//
// The confusion two unions create lives entirely in the element. The list's identity, its
// length and every handle on it stay correct, so this program's answer — `1` — is right,
// and a rule that refused it would be a clause-2 false reject. Dropping the element-read
// conjunct is exactly one `runs` cell lost, measured on the distilled corpus, and it is
// this one.
type Circle = { r: i32 }
type Sq = { s: i32 }
type Tri = { t: i32 }
type Shape = Circle | Sq
type Other = Circle | Tri

function f() {
  const xs = [{ r: 7 }]
  const a: Shape[] = xs
  const b: Other[] = xs
  b[0] = { t: 3 }
  print(a.length)
}

f()
