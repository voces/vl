type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function outer() {
  const lv1 = [{ r: 7 }]
  const cS: Circle[] = lv1
  function inner(lv1: Shape[]) {
    const cU: Shape[] = lv1
    print(cU.length)
  }
  const seed: Shape[] = [{ r: 1 }]
  inner(seed)
  if cS.length > 0 { print(cS[0].r) } else { print(0) }
}
outer()
