type Circle = { r: i64 }
type Dot = { r: i64 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = Circle[][]
function thru(x: Circle[][]) { return x }
const _sp1: Box1 = []
function mkc(): Circle[][] {
  const lv1 = [{ r: 7 }]
  const cc = [lv1]
  return cc
}
const c = mkc()
const dd = thru(c)
const g0 = dd
if g0.length > 0 {
  const g1 = g0[0]
  if g1.length > 0 {
    if (g1[0]).r == 7 { print(7) } else { print(0) }
  } else { print(0) }
} else { print(0) }
