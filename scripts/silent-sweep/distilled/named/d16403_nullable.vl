type P = { name: string }
function show(p: P | null) { if p != null { print(p.name) } else { print("none") } }
function fwd(t) { show(t) }
const v: { age: i32, name: string } = { age: 3, name: "a" }
const w: { name: string, z: f64 } | null = null
const x: P | null = { name: "c" }
fwd(v)
fwd(w)
fwd(x)
fwd(null)
print(v.age)
