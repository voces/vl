type K = "p" | "q"
type Dot = { r: K }
type DotB = { db: i32 }
type DotU = Dot | DotB
type Box1 = {r: K}
function idg<T>(x: T): T { return x }
const _sp1: Box1 = { r: "q" }
function outer() {
  const c: {r: K} = { r: "p" }
  const lam = () => {
    const dd = idg(c)
    if (dd).r == "p" { print(7) } else { print(0) }
  }
  lam()
}
outer()
