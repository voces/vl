// SOUNDNESS: rebinding the ROOT falsifies every `xs[...]` narrowing, and the prefix
// leg only matches `tgtKey + "."`, never `tgtKey + "["`.
function src(): i32[] | null { return [1, 2] }
function body() {
  let xs: (i32[] | null)[] = [src()]
  if xs[0] != null {
    xs = [null]
    print(xs[0].length)
  } else { print("NUL") }
}
body()
