import { reverse } from "std:array"
type Box2 = {r: i64}[][]
type Box1 = {r: i64}[][]
type Shape = Ua | Sq
type Ua = { ua: i32 }
type Sq = { s: i32 }
function sink(_x: {r: i64}[][]) { }
const _sp1: Box1 = []
const _sp2: Box2 = []
function outer() {
  const lv1 = [{ r: 7 }, { r: 7 }]
  const c = [lv1]
  const lam = () => {
    sink(c)
    const dd = reverse([c])[0]
    const g0 = dd
    if g0.length > 0 {
      const g1 = g0[0]
      if g1.length > 0 {
        if (g1[0]).r == 7 { print(7) } else { print(0) }
      } else { print(0) }
    } else { print(0) }
  }
  lam()
}
outer()
