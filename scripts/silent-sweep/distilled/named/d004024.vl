type Cir2 = { c2: i32 }
type Sq2 = { s2: i32 }
type Shape2 = Cir2 | Sq2
function outer() {
  const lv1 = Map()
  lv1["k0"] = { r: { c2: 1 } }
  const c = Map()
  c["k0"] = lv1
  function inner() {
    const g0 = (c)["k0"] ?? Map()
    const g1 = (g0)["k0"] ?? { r: { s2: 1 } }
    if (g1).r is Cir2 { print(7) } else { print(0) }
  }
  inner()
}
outer()
