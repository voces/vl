type K = "a" | "b"
type P = {x: i32}
function show<U>(v: U) {
  print(v is i32)
  print(v is string)
  print(v is boolean)
  print(v is f64)
  print(v is null)
  print(v is K)
  print(v is P)
}
function g(a0, a1, k: i32) {
  show(match k {
    0 => a0
    1 => a1
    _ => "z"
  })
}
const x0: K = "a"
const x1: K | null = null
g(x0, x1, 0)
g(x0, x1, 1)
g(x0, x1, 2)
