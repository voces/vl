type U = i32 | string | null
type H = { k: string | null }
let gk: string | null = null
let n = 0
function ck(): string | null { n = n + 1
  return gk }
function g(u: U, h: H) { return u != ck() }
gk = null
print(g("s", { k: null }))
gk = "s"
print(g("s", { k: "s" }))
gk = "t"
print(g("s", { k: "t" }))
print(n)
