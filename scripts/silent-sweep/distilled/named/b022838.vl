type Box1 = {[string]: {r: string}}[]
type Shape = Ua | Sq
type Ua = { ua: i32 }
type Sq = { s: i32 }
type Dot = { r: string }
function idg<T>(x: T): T { return x }
function sink(_x: {[string]: {r: string}}[]) { }
const _sp1: Box1 = []
function mkcall() {
  const lv1 = Map()
  lv1["k0"] = { r: "seven" }
  const cc = []
  return cc
}
function outer() {
  const lam = () => {
    sink(mkcall())
    const dd = idg(mkcall())
    const g0 = dd
