type Circle = { r: i32 }
type Sq = { z: i32 }
type Shape = Circle | Sq
type Dot = { r: i32 }
const c0: Circle = { r: 7 }
const t0: Dot = { r: 7 }
function viaA(f: (Circle) => Circle, x: Circle) { print(f(x).r) }
function viaB(g: (Dot) => Dot, y: Dot) { print(g(y).r) }
viaA((p: Circle) => p, c0)
viaB((q: Dot) => q, t0)
