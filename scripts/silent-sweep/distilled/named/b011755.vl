type Circle = { r: i32 | null }
type Dot = { r: i32 | null }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = {[string]: {[string]: Circle}}
type GW = { g: {[string]: {[string]: Circle}} }
const _sp1: Box1 = Map()
function rd() {
  const lv1 = Map()
  lv1["k0"] = { r: null }
  const c: {[string]: {[string]: Circle}} = Map()
  c["k0"] = lv1
  const wv: GW = { g: c }
  const g0 = (wv.g)["k0"] ?? Map()
  const g1 = (g0)["k0"] ?? { r: null }
  if (g1).r != null { print(7) } else { print(0) }
}
rd()
