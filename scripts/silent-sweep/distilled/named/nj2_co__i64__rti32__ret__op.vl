function kind<T>(v: T): string {
  if v is i32 { return "i32" }
  if v is i64 { return "i64" }
  if v is f32 { return "f32" }
  if v is f64 { return "f64" }
  "other"
}
function g(q: i64 | null, b: i32) { q ?? b }
function run(q: i64 | null, b: i32) {
  const r = g(q, b)
  print(r)
  print(kind(r))
  print("<\{r}>")
}
run(9000000001, -3)
run(null, -3)
