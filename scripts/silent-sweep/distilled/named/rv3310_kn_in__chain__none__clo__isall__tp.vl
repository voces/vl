type K = "a" | "b"
type P = {x: i32}
function g<T0, T1>(a0: T0, a1: T1, k: i32) {
  const f = (j: i32) => if j == 0 { a0 } else { a1 }
  const e = f(k)
  print(e is i32)
  print(e is string)
  print(e is boolean)
  print(e is f64)
  print(e is null)
  print(e is K)
  print(e is P)
}
const x0: K | null = "b"
const x1: i32 | null = null
g(x0, x1, 0)
g(x0, x1, 1)
