type Circle = { r: i32 | null }
type Dot = { r: i32 | null }
function rd() {
  const lv2 = [{ r: null }]
  const lv1 = [lv2]
  const c: Circle[][][] = [lv1]
  const g0 = c
  if g0.length > 0 {
    const g1 = g0[0]
    if g1.length > 0 {
      const g2 = g1[0]
      if g2.length > 0 {
        if (g2[0]).r != null { print(7) } else { print(0) }
      } else { print(0) }
    } else { print(0) }
  } else { print(0) }
}
rd()
