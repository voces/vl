type Cir2 = { c2: i32 }
type Sq2 = { s2: i32 }
type Shape2 = Cir2 | Sq2
function mkcall() {
  const lv2 = Map()
  lv2["k0"] = { r: { c2: 1 } }
  const lv1 = Map()
  lv1["k0"] = lv2
  const cc = Map()
  cc["k0"] = lv1
  return cc
}
function outer() {
  const lam = () => {
    const g0 = (mkcall())["k0"] ?? Map()
    const g1 = (g0)["k0"] ?? Map()
    const g2 = (g1)["k0"] ?? { r: { s2: 1 } }
    if (g2).r is Cir2 { print(7) } else { print(0) }
  }
  lam()
}
outer()
