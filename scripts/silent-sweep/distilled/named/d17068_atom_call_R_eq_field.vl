type K = "a" | "b"
type U = i32 | K
type H = { k: K }
let tr = ""
let gk: K = "a"
let gu: U = "a"
function ok(): K {
  tr = tr + "o"
  return gk
}
function oh(): H {
  tr = tr + "o"
  return { k: gk }
}
function bx(): U {
  tr = tr + "b"
  return gu
}
function g() { return oh().k == bx() }
gu = "a"
print(g())
gu = "b"
print(g())
gu = 1
print(g())
print(tr)
