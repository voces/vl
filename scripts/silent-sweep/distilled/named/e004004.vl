type Cir2 = { c2: i32 }
type Sq2 = { s2: i32 }
type Shape2 = Cir2 | Sq2
type Box1 = Circle[][][]
type Shape = Circle | Sq
type Sq = { s: i32 }
type Circle = { r: Shape2 }
const _sp1: Box1 = []
function rd() {
  const lv2 = [{ r: { c2: 1 } }, { r: { s2: 1 } }]
  const lv1 = [lv2]
  const c: Circle[][][] = [lv1]
  const g0 = c
  if g0.length > 0 {
    const g1 = g0[0]
    if g1.length > 0 {
      const g2 = g1[0]
      if g2.length > 0 {
        if (g2[0]).r is Cir2 { print(7) } else { print(0) }
      } else { print(0) }
    } else { print(0) }
  } else { print(0) }
}
rd()
