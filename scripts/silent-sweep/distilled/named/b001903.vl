type Circle = { r: i32 | null }
function sink(_x: Circle[]) { }
function mkcall() {
  const cc = [{ r: null }]
  return cc
}
function outer() {
  const lam = () => {
    sink(mkcall())
    const g0 = mkcall()
    if g0.length > 0 {
      if (g0[0]).r != null { print(7) } else { print(0) }
    } else { print(0) }
  }
  lam()
}
outer()
