type Box2 = {r: i32 | null}[]
type Box1 = {r: i32 | null}[]
type Shape = Circle | Sq
type Sq = { s: i32 }
type DotU = Dot | DotB
type DotB = { db: i32 }
type Dot = { r: i32 | null }
type Circle = { r: i32 | null }
function useShape(s: Shape): i32 { if s is Sq { return 1 } return 0 }
const sqv: Sq = { s: 1 }
const _sp1: Box1 = []
const _sp2: Box2 = []
const dfl: {r: i32 | null} = { r: null }
function outer() {
  const c = [{ r: null }]
  function inner() {
    const dd = c
    if useShape(sqv) > 99 { print(0) }
    let hit = 0
    for zz in dd {
      if zz.r != null { hit = 7 }
    }
    print(hit)
  }
  inner()
}
outer()
