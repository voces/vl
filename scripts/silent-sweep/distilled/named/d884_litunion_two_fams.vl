type K = "a" | "b"
function rd() {
  let a: {r: K} | null = null
  const g1 = a ?? { r: null }
  if g1.r == null { print("nul") } else { print("has") }
}
rd()
function rd2() {
  let a: {r: K} | null = { r: "b" }
  const g2 = a ?? { r: null }
  if g2.r == null { print("nul") } else { print(g2.r) }
}
rd2()
