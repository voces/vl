function kind<T>(v: T): string {
  if v is i32 { return "i32" }
  if v is i64 { return "i64" }
  if v is f32 { return "f32" }
  if v is f64 { return "f64" }
  "other"
}
function run(e1: f32, e2: i64, k: i32) {
  const xs = [5, e1, e2]
  xs.push(xs[0])
  print(xs[3])
  print(kind(xs[3]))
}
run(0.5, -9000000003, 0)
