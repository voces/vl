type Circle = { r: i64 }
function idg<T>(x: T): T { return x }
function sink(_x: Circle[][]) { }
function rd() {
  const lv1 = [{ r: 7 }]
  const c = [lv1]
  sink(c)
  const dd = idg(c)
  const g0 = dd
  if g0.length > 0 {
    const g1 = g0[0]
    if g1.length > 0 {
      if (g1[0]).r == 7 { print(7) } else { print(0) }
    } else { print(0) }
  } else { print(0) }
}
rd()
