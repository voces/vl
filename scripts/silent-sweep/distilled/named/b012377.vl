import { reverse } from "std:array"
type Circle = { r: i32 | null }
type Dot = { r: i32 | null }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = {[string]: {[string]: Circle}}
function sink(_x: {[string]: {[string]: Circle}}) { }
const _sp1: Box1 = Map()
function mksrc() {
  const lv1 = Map()
  lv1["k0"] = { r: null }
  const cc = Map()
  cc["k0"] = lv1
  return cc
}
function rd(c: {[string]: {[string]: Circle}}) {
  function inner() {
    sink(c)
    const dd = reverse([c])[0]
    const g0 = (dd)["k0"] ?? Map()
    const g1 = (g0)["k0"] ?? { r: null }
    if (g1).r != null { print(7) } else { print(0) }
  }
  inner()
}
rd(mksrc())
