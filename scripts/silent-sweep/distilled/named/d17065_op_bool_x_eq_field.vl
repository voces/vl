type U = i32 | boolean
type H = { k: boolean | null }
let gk: boolean | null = null
let n = 0
function ck(): boolean | null { n = n + 1
  return gk }
function g(u: U, h: H) { return u == h.k }
gk = null
print(g(true, { k: null }))
gk = true
print(g(true, { k: true }))
gk = false
print(g(true, { k: false }))
print(n)
