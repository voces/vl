type Box2 = {r: i32 | null}[][][]
type Box1 = {r: i32 | null}[][][]
type Shape = Circle | Sq
type Sq = { s: i32 }
type DotU = Dot | DotB
type DotB = { db: i32 }
type Dot = { r: i32 | null }
type Circle = { r: i32 | null }
function useShape(s: Shape): i32 { if s is Sq { return 1 } return 0 }
const sqv: Sq = { s: 1 }
const _sp1: Box1 = []
const _sp2: Box2 = []
function mkc(): {r: i32 | null}[][][] {
  const lv2 = [{ r: null }]
  const lv1 = [lv2]
  const cc = [lv1]
  return cc
}
function mkcall() { return mkc() }
function outer() {
  const lam = () => {
    if useShape(sqv) > 99 { print(0) }
    const g0 = mkcall()
    if g0.length > 0 {
      const g1 = g0[0]
      if g1.length > 0 {
        const g2 = g1[0]
        if g2.length > 0 {
          if (g2[0]).r != null { print(7) } else { print(0) }
        } else { print(0) }
      } else { print(0) }
    } else { print(0) }
  }
  lam()
}
outer()
