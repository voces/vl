type Cir2 = { c2: i32 }
type Sq2 = { s2: i32 }
type Shape2 = Cir2 | Sq2
type Box2 = Circle[][]
type Box1 = Circle[][]
type DotU = Dot | DotB
type DotB = { db: i32 }
type Dot = { r: Shape2 }
type Circle = { r: Shape2 }
const _sp1: Box1 = []
const _sp2: Box2 = []
function rd() {
  const lv1 = [{ r: { c2: 1 } }, { r: { s2: 1 } }]
  const c: Circle[][] = [lv1]
  const g0 = c
  if g0.length > 0 {
    const g1 = g0[0]
    if g1.length > 0 {
      if (g1[0]).r is Cir2 { print(7) } else { print(0) }
    } else { print(0) }
  } else { print(0) }
}
rd()
