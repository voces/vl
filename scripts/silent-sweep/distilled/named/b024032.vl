type Circle = { r: i32 | null }
type Dot = { r: i32 | null }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = {[string]: Circle}[]
function thru(x: {[string]: Circle}[]) { return x }
const _sp1: Box1 = []
const dfl: Circle = { r: null }
function mksrc() {
  const lv1 = Map()
  lv1["k0"] = { r: null }
  const cc = [lv1]
  return cc
}
function rd(c: {[string]: Circle}[]) {
  function inner() {
    const dd = thru(c)
    const g0 = dd
    if g0.length > 0 {
      const g1 = (g0[0])["k0"] ?? dfl
      const gp: Circle = g1
      if gp.r != null { print(7) } else { print(0) }
    } else { print(0) }
  }
  inner()
}
rd(mksrc())
