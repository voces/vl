type Inner = { q: i32 }
type Box1 = {[string]: {[string]: {[string]: {r: Inner}}}}
type Circle = { r: Inner }
function sink(_x: {[string]: {[string]: {[string]: {r: Inner}}}}) { }
const _sp1: Box1 = Map()
function mksrc() {
  const lv2 = Map()
  const lv1 = Map()
  lv1["k0"] = lv2
  const cc = Map()
  cc["k0"] = lv1
  return cc
}
function rd(c: {[string]: {[string]: {[string]: {r: Inner}}}}) {
  sink(c)
  const dd = c
  const g0 = (dd)["k0"] ?? Map()
  const g1 = (g0)["k0"] ?? Map()
  const g2 = (g1)["k0"] ?? { r: { q: 0 } }
  if (g2).r.q == 7 { print(7) } else { print(0) }
}
rd(mksrc())
