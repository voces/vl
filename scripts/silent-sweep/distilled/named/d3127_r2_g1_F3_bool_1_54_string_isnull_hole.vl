type AB = "a" | "b"
type N12 = 1 | 2
type R = { a: {[string]: boolean | null} }
function show(x) { print(x) }
function mk(): R {
  const a: {[string]: boolean | null} = Map()
  a["k3"] = false
  a["k4"] = true
  a["k5"] = null
  { a: a }
}
function use(p) {
  const r = p.a["k5"] ?? p.a["k4"] ?? true
  print(r == null)
}
use(mk())
