type AB = "a" | "b"
type N12 = 1 | 2
type R = { a: {[i32]: boolean | null}, b: {[i32]: N12} }
function show(x) { print(x) }
function mk(): R {
  const a: {[i32]: boolean | null} = Map()
  a[3] = false
  a[4] = true
  a[5] = null
  const b: {[i32]: N12} = Map()
  b[3] = 1
  b[4] = 2
  { a: a, b: b }
}
function use(p) {
  print(p.a[5] ?? p.b[4])
}
use(mk())
