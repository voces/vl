type Circle = { r: i32 | null }
type Dot = { r: i32 | null }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = {[string]: Circle}[]
function thru(x: {[string]: Circle}[]) { return x }
function sink(_x: {[string]: Circle}[]) { }
const _sp1: Box1 = []
function outer() {
  const lv1 = Map()
  lv1["k0"] = { r: null }
  const c = [lv1]
  function inner() {
    sink(c)
    const dd = thru(c)
    const g0 = dd
    if g0.length > 0 {
      const g1 = (g0[0])["k0"] ?? { r: null }
      if (g1).r != null { print(7) } else { print(0) }
    } else { print(0) }
  }
