type AB = "a" | "b"
type N12 = 1 | 2
type R = { a: {[string]: boolean}, b: {[string]: N12} }
function show(x) { print(x) }
function mk(): R {
  const a: {[string]: boolean} = Map()
  a["k3"] = false
  a["k4"] = true
  const b: {[string]: N12} = Map()
  b["k3"] = 1
  b["k4"] = 2
  { a: a, b: b }
}
function use(p) {
  show(p.a["k9"] ?? p.b["k3"])
}
use(mk())
