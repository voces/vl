type Rec = { x: i32 }
type Rec2 = { y: i32 }
type L = "p" | "q"
type U = {[i32]: Rec} | i32 | string | null
function smk(): {[string]: i32} {
  const m: {[string]: i32} = Map()
  m.set("s", 1)
  m
}
function i64mk(): {[i64]: i32} {
  const m: {[i64]: i32} = Map()
  m.set(8, 1)
  m
}
function ismk(): {[i32]: string} {
  const m: {[i32]: string} = Map()
  m.set(8, "t")
  m
}
function f(u: U) {
  match u {
    {[i32]: Rec} => {
      u.set(5, { x: 1 })
      u.set(-3, { x: 2 })
      u[100000] = { x: 3 }
      u.set(5, { x: 4 })
      u.delete(-3)
      print(u.has(-3))
      print(u.has(5))
      print(u.length)
      const g8 = u.get(5)
      if g8 != null { print(g8.x) } else { print(-1) }
      const g10 = u.get(-3)
      if g10 != null { print(g10.x) } else { print(-1) }
      const g12 = u[100000]
      if g12 != null { print(g12.x) } else { print(-1) }
      for k, v in u { print(k)
        print(v.x) }
    }
    i32 => print("other")
    string => print("other")
    null => print("other")
  }
}
function g(u: U) {
  match u {
    {[i32]: Rec} => {
      print(u.length)
      const g16 = u.get(100000)
      if g16 != null { print(g16.x) } else { print(-1) }
    }
    i32 => print("other2")
    string => print("other2")
    null => print("other2")
  }
}
const m0: {[i32]: Rec} = Map()
let gl: U = 42
gl = m0
f(gl)
g(gl)
print(m0.length)
const ov: i32 = 42
f(ov)
