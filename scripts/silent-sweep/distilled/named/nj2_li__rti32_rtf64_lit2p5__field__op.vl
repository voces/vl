function kind<T>(v: T): string {
  if v is i32 { return "i32" }
  if v is i64 { return "i64" }
  if v is f32 { return "f32" }
  if v is f64 { return "f64" }
  "other"
}
function run(e0: i32, e1: f64, k: i32) {
  const o = { v: [e0, e1, 2.5] }
  print(o.v[0])
  print(kind(o.v[0]))
  print(o.v[1])
  print(kind(o.v[1]))
  print(o.v[2])
  print(kind(o.v[2]))
  print("<\{o.v[0]}>")
}
run(7, 6.75, 0)
