function kind<T>(v: T): string {
  if v is i32 { return "i32" }
  if v is i64 { return "i64" }
  if v is f32 { return "f32" }
  if v is f64 { return "f64" }
  "other"
}
function run(e1: i64, e2: i32, k: i32) {
  const o = { v: [9000000000, e1, e2] }
  print(o.v[0])
  print(kind(o.v[0]))
  print(o.v[1])
  print(kind(o.v[1]))
  print(o.v[2])
  print(kind(o.v[2]))
  print("<\{o.v[0]}>")
}
run(-9000000003, -3, 0)
