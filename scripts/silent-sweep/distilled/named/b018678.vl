type Box1 = {[string]: {r: i32 | null}[]}
type Shape = Circle | Sq
type Sq = { s: i32 }
type Dot = { r: i32 | null }
type Circle = { r: i32 | null }
const _sp1: Box1 = Map()
function mkcall() {
  const lv1 = [{ r: null }]
  const cc = Map()
  cc["k0"] = lv1
  return cc
}
function outer() {
  const lam = () => {
    const g0 = (mkcall())["k0"] ?? []
    const g1 = g0
    if g1.length > 0 {
      if (g1[0]).r != null { print(7) } else { print(0) }
    } else { print(0) }
  }
  lam()
}
outer()
