type Circle = { r: i64 }
type Box1 = Circle[][][]
const _sp1: Box1 = []
const lv2 = [{ r: 7 }]
const lv1 = [lv2]
const c: Circle[][][] = [lv1]
function rd() {
  const g0 = c
  if g0.length > 0 {
    const g1 = g0[0]
    if g1.length > 0 {
      const g2 = g1[0]
      if g2.length > 0 {
        if (g2[0]).r == 7 { print(7) } else { print(0) }
      } else { print(0) }
    } else { print(0) }
  } else { print(0) }
}
rd()
