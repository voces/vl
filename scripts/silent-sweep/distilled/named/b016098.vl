type Circle = { r: i32 | null }
type Dot = { r: i32 | null }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = {[string]: {[string]: {[string]: Circle}}}
type GW = { g: {[string]: {[string]: {[string]: Circle}}} }
const _sp1: Box1 = Map()
const dfl: Circle = { r: null }
function mkcall() {
  const lv2 = Map()
  lv2["k0"] = { r: null }
  const lv1 = Map()
  lv1["k0"] = lv2
  const cc = Map()
  cc["k0"] = lv1
  return cc
}
function outer() {
  const lam = () => {
    const wv: GW = { g: mkcall() }
    const g0 = (wv.g)["k0"] ?? Map()
    const g1 = (g0)["k0"] ?? Map()
    const g2 = (g1)["k0"] ?? dfl
    const gp: Circle = g2
    if gp.r != null { print(7) } else { print(0) }
  }
  lam()
}
outer()
