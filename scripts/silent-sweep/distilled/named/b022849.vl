function idg<T>(x: T): T { return x }
function sink(_x: {[string]: {r: f32}}[]) { }
function outer() {
  const lv1 = Map()
  const c = [lv1]
  function inner() {
    sink(c)
    const dd = idg(c)
    const g0 = dd
    if g0.length > 0 {
      const g1 = (g0[0])["k0"] ?? { r: 0.5 }
      if (g1).r > 7.0 { print(7) } else { print(0) }
    } else { print(0) }
  }
  inner()
}
outer()
