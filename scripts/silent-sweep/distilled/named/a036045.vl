type Circle = { r: i32 | null }
type Dot = { r: i32 | null }
type Box1 = Circle[][]
type Box2 = Circle[][]
function thru(x: Circle[][]) { return x }
const _sp1: Box1 = []
const _sp2: Box2 = []
function mkc(): Circle[][] {
  const lv1 = [{ r: null }]
  const cc = [lv1]
  return cc
}
function mksrc() {
  const cc = mkc()
  return cc
}
function rd(c: Circle[][]) {
  const dd = thru(c)
  const g0 = dd
  if g0.length > 0 {
    const g1 = g0[0]
    if g1.length > 0 {
      if (g1[0]).r != null { print(7) } else { print(0) }
    } else { print(0) }
  } else { print(0) }
}
rd(mksrc())
