type Circle = { r: i64 }
function sink(_x: Circle[][]) { }
function mkcall() {
  const lv1 = [{ r: 7 }]
  const cc = [lv1]
  return cc
}
function outer() {
  const lam = () => {
    sink(mkcall())
    const dd = mkcall()
    const g0 = dd
    if g0.length > 0 {
      const g1 = g0[0]
      if g1.length > 0 {
        if (g1[0]).r == 7 { print(7) } else { print(0) }
      } else { print(0) }
    } else { print(0) }
  }
  lam()
}
outer()
