type Circle = { r: i64 }
function idg<T>(x: T): T { return x }
const dfl: Circle = { r: 0 }
function mkcall() {
  const lv1 = [{ r: 7 }]
  const cc = [lv1]
  return cc
}
function outer() {
  const lam = () => {
    const dd = idg(mkcall())
    const g0 = dd
    if g0.length > 0 {
      const g1 = g0[0]
      if g1.length > 0 {
        const gp: Circle = g1[0]
        if gp.r == 7 { print(7) } else { print(0) }
      } else { print(0) }
    } else { print(0) }
  }
  lam()
}
outer()
