function idg<T>(x: T): T { return x }
const dfl: {r: f32} = { r: 0.5 }
function mksrc() {
  const lv1 = Map()
  const cc = [lv1]
  return cc
}
function rd(c: {[string]: {r: f32}}[]) {
  function inner() {
    const dd = idg(c)
    const g0 = dd
    if g0.length > 0 {
      const g1 = (g0[0])["k0"] ?? dfl
      const gp: {r: f32} = g1
      if gp.r > 7.0 { print(7) } else { print(0) }
    } else { print(0) }
  }
  inner()
}
rd(mksrc())
