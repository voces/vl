type K = "a" | "b"
type U = i32 | K | null
type H = { k: K | null }
let gk: K | null = null
let n = 0
function ck(): K | null { n = n + 1
  return gk }
function g(u: U, h: H) { return u != ck() }
gk = null
print(g("a", { k: null }))
gk = "a"
print(g("a", { k: "a" }))
gk = "b"
print(g("a", { k: "b" }))
print(n)
