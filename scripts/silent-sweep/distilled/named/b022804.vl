function mkI(): {[string]: i32} {
  const mi: {[string]: i32} = Map()
  mi["z"] = 1
  return mi
}
type Circle = { r: {[string]: i32} }
function idg<T>(x: T): T { return x }
function sink(_x: {[string]: Circle}[]) { }
function outer() {
  const lv1 = Map()
  lv1["k0"] = { r: mkI() }
  const c = [lv1]
  function inner() {
    sink(c)
    const dd = idg(c)
    const g0 = dd
    if g0.length > 0 {
      const g1 = (g0[0])["k0"] ?? { r: Map() }
      if (g1).r.length == 1 { print(7) } else { print(0) }
    } else { print(0) }
  }
  inner()
}
outer()
