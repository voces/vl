type Dot = { r: i32 | null }
type DotB = { db: i32 }
type DotU = Dot | DotB
type Sq = { s: i32 }
type Ua = { ua: i32 }
type Shape = Ua | Sq
function idg<T>(x: T): T { return x }
function useShape(s: Shape): i32 { if s is Sq { return 1 } return 0 }
const sqv: Sq = { s: 1 }
function outer() {
  const c: {r: i32 | null} = { r: null }
  const lam = () => {
    const dd = idg(c)
    if useShape(sqv) > 99 { print(0) }
    if (dd).r != null { print(7) } else { print(0) }
  }
  lam()
}
outer()
