// D641's family, one ingredient wider than the cell the corpus held (D681). The corpus
// witness is a ONE-field anonymous shape; this is the two-field spelling, and it was
// `check-clean invalid wasm` on master for the same reason. Kept because the derived
// corpus has no anonymous-shape axis to have generated it.
function g<T>(self: T) {
  const xs: T[] = [self]
  return xs[0]
}
const z = g({ x: 7, y: "a" })
print(z.y)
