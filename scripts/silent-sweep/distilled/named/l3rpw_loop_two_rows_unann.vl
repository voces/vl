// l3rpw_loop_two_rows_unann — L3 PR A: `record-param-width-before.matrix.vl`, cell `loop_two_rows_unann`. Should print a b.
// record-param-width-before_loop_two_rows_unann — generated by capability-matrix.vl from record-param-width-before.matrix.vl. Should print a then b.
type P = { name: string }
function show(p: P) { print(p.name) }
const v = { age: 3, name: "a" }
const w = { age: 4, name: "b" }
let i = 0
while i < 2 {
  if i == 0 { show(v) } else { show(w) }
  i = i + 1
}
