type Circle = { r: i32 }
type Sq = { s: i32 }
type Tri = { t: i32 }
type Shape = Circle | Sq
type Animal = Circle | Sq
type Other = Circle | Tri
function f() {
  const xs = [{ r: 7 }]
  const a: Shape[] = xs
  const b: Other[] = xs
  b[0] = { t: 3 }
  const e = a[0]
  match e { Circle => print(100), Sq => print(200) }
}
f()
