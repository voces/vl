type J = { f: i32 | null }
function mk() { return { f: 4 } }
const m = Map()
m.set("a", mk())
const wm: {[string]: J} = Map()
wm.set("a", mk())
function mk2() { return { f: 1 } }
function mk4() { return mk2() }
const dA = mk4()
const bA = m.get("a") ?? dA
const b = m.get("z") ?? mk2()
print(bA.f ?? 0)
print(b.f ?? 0)
