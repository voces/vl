function kind<T>(v: T): string {
  if v is i32 { return "i32" }
  if v is i64 { return "i64" }
  if v is f32 { return "f32" }
  if v is f64 { return "f64" }
  "other"
}
function g(e1: f64, e2: i32, k: i32) { [2.5, e1, e2] }
function run(e1: f64, e2: i32, k: i32) {
  const xs = g(e1, e2, k)
  print(xs[0])
  print(kind(xs[0]))
  print(xs[1])
  print(kind(xs[1]))
  print(xs[2])
  print(kind(xs[2]))
  print("<\{xs[0]}>")
}
run(6.75, -3, 0)
