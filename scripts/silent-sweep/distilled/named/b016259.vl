type Circle = { r: i32 | null }
type Dot = { r: i32 | null }
type DotB = { db: i32 }
type DotU = Dot | DotB
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = {[string]: {[string]: {[string]: Circle}}}
type Box2 = {[string]: {[string]: {[string]: Circle}}}
function idg<T>(x: T): T { return x }
function useShape(s: Shape): i32 { if s is Sq { return 1 } return 0 }
const sqv: Sq = { s: 1 }
const _sp1: Box1 = Map()
const _sp2: Box2 = Map()
const dfl: Circle = { r: null }
function outer() {
  const lv2 = Map()
  lv2["k0"] = { r: null }
  const lv1 = Map()
  lv1["k0"] = lv2
  const c = Map()
  c["k0"] = lv1
  function inner() {
    const dd = idg(c)
    if useShape(sqv) > 99 { print(0) }
    const g0 = (dd)["k0"] ?? Map()
    const g1 = (g0)["k0"] ?? Map()
    const g2 = (g1)["k0"] ?? dfl
    const gp: Circle = g2
    if gp.r != null { print(7) } else { print(0) }
  }
  inner()
}
outer()
