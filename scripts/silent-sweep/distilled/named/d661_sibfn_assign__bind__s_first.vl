type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function fs() {
  const lv1 = [{ r: 7 }]
  const cS: Circle[] = lv1
  if cS.length > 0 { print(cS[0].r) } else { print(0) }
}
function fu() {
  const lv1 = [{ r: 7 }]
  let aU: Shape[] = []
  aU = lv1
  if aU.length > 0 { print(aU.length) } else { print(0) }
}
fs()
fu()
