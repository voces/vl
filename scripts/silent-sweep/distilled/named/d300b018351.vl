type Circle = { r: i32 | null }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = Circle[]
type Box2 = Circle[]
function useShape(s: Shape): i32 { if s is Sq { return 1 } return 0 }
const sqv: Sq = { s: 1 }
const _sp1: Box1 = []
const _sp2: Box2 = []
const dfl: Circle = { r: null }
const c = [{ r: null }]
const lamc = (x: Circle[]) => x
const dd = lamc(c)
if useShape(sqv) > 99 { print(0) }
let hit = 0
for zz in dd {
  if zz.r != null { hit = 7 }
}
print(hit)
