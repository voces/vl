type Circle = { r: i32 | null }
function mkc(): Circle[][] {
  const lv1 = [{ r: null }]
  const cc = [lv1]
  return cc
}
function outer() {
  const c = mkc()
  function inner() {
    const lamc = (x: Circle[][]) => x
    const dd = lamc(c)
    const g0 = dd
    if g0.length > 0 {
      const g1 = g0[0]
      if g1.length > 0 {
        if (g1[0]).r != null { print(7) } else { print(0) }
      } else { print(0) }
    } else { print(0) }
  }
  inner()
}
outer()
