type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function outer() {
  const lv1 = [{ r: 7 }]
  const cS: Circle[] = lv1
  function inner(): Shape[] {
    const lv1 = [{ r: 9 }]
    return lv1
  }
  const rrU = inner()
  print(rrU.length)
  if cS.length > 0 { print(cS[0].r) } else { print(0) }
}
outer()
