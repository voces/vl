type K = "a" | "b"
type P = {x: i32}
function g<T0, T1, T2>(a0: T0[], a1: T1[], a2: T2[], k: i32) {
  const r = match k {
    0 => a0
    1 => a1
    _ => a2
  }
  const e = r[0]
  print(e is i32)
  print(e is string)
  print(e is boolean)
  print(e is f64)
  print(e is null)
  print(e is K)
  print(e is P)
}
const x0: K = "a"
const x1: K = "b"
const x2: i32 | null = 8
g([x0], [x1], [x2], 0)
g([x0], [x1], [x2], 1)
g([x0], [x1], [x2], 2)
