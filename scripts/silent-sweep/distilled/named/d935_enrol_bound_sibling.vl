// D935 — the enrolment through the BINDING hop: `const z = { r: 3 }; keep(z)` is the same call
// site as `keep({ r: 3 })` with a name in the way. `anonLeafDeliversMember` answers false for
// it (the write is not yet joined), so without `anonLeafIdentAllObjLits` the slot declines and
// the widened `q` meets a narrow slot. Reading `z.r` afterwards pins that the enrolled literal
// is still a working i32 carrier.
function src(p: {r: i32}): {r: i32} | null {
  p
}

function keep(q: {r: i32}): i32 {
  q.r
}

function rd() {
  const q = { r: 7 }
  const g1 = src(q) ?? { r: "s" }
  const z = { r: 3 }
  print(g1.r)
  print(keep(q))
  print(keep(z))
  print(z.r)
}

rd()
