function mkcall() {
  const lv1 = Map()
  const cc = Map()
  cc["k0"] = lv1
  return cc
}
const dd = mkcall()
const g0 = dd["k0"] ?? Map()
const g1 = g0["k0"] ?? { r: 1 }
print(g1.r)
function mk2() {
  const cc = Map()
  cc["k0"] = Map()
  return cc
}
const h0 = mk2()["k0"]
if h0 != null { print(h0["j"] ?? "d") }
