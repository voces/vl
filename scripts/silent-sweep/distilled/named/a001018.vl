import { reverse } from "std:array"
type Cir2 = { c2: i32 }
type Sq2 = { s2: i32 }
type Shape2 = Cir2 | Sq2
type Circle = { r: Shape2 }
function mkcall() {
  const lv1 = Map()
  const cc = Map()
  cc["k0"] = lv1
  return cc
}
const dd = reverse([mkcall()])[0]
const g0 = (dd)["k0"] ?? Map()
const g1 = (g0)["k0"] ?? { r: { s2: 1 } }
if (g1).r is Cir2 { print(7) } else { print(0) }
