type Circle = { r: i32[] }
function idg<T>(x: T): T { return x }
const dfl: Circle = { r: [] }
function rd() {
  const lv1 = [{ r: [1, 2] }]
  const c = Map()
  const dd = idg(c)
  const g0 = (dd)["k0"] ?? []
  const g1 = g0
  if g1.length > 0 {
    const gp: Circle = g1[0]
