type Shape = Circle | Sq
type Sq = { s: i32 }
type Dot = { q: i32 | null }
type Circle = { r: i32 | null }
function useShape(s: Shape): i32 { if s is Sq { return 1 } return 0 }
const sqv: Sq = { s: 1 }
function rd() {
  const lv2 = [{ r: 7 }, { r: 7 }]
  const lv1 = [lv2]
  const c: Circle[][][] = [lv1]
  if useShape(sqv) > 99 { print(0) }
  const g0 = c
  if g0.length > 0 {
    const g1 = g0[0]
    if g1.length > 0 {
      const g2 = g1[0]
      if g2.length > 0 {
        if (g2[0]).r != null { print(7) } else { print(0) }
      } else { print(0) }
    } else { print(0) }
  } else { print(0) }
}
rd()
