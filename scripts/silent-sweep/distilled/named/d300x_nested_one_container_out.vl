// @run
// @log 0
// THE SAME SEAM ONE CONTAINER OUT (silent-class-inventory D300, the kind-6 half).
//
// The map's VALUE is itself a map, so the twin question is asked of a kind-6 slot whose
// own guard IS `rlSlotsLayoutTwin` — and that arm's kind-3 element recursion bottoms out
// in exactly the kind-1 pair the flat case merges (`{r: null}` against the declared
// `CircleN`). With only the kind-1 hoist the INNER pair merges and the OUTER map still
// keeps two byte-identical map structs, so this stays check-clean invalid wasm: the two
// hoists are one landing, and neither closes this alone.
//
// The `0` is the right answer: `r` is `null`, so the `!=` is false.
type CircleN = { r: i32 | null }
function thru(x: {[string]: {[string]: CircleN}}) { return x }
function nested() {
  const iv = Map()
  iv["k0"] = { r: null }
  const om = Map()
  om["k0"] = iv
  const dd = thru(om)
  const n0 = (dd)["k0"] ?? Map()
  const n1 = (n0)["k0"] ?? { r: null }
  if (n1).r != null { print(7) } else { print(0) }
}
nested()
