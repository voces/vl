type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type WU = { xs: Shape[] }
function fs(): Circle[] {
  const lv1 = [{ r: 7 }]
  return lv1
}
const lv1 = [{ r: 7 }]
const wU: WU = { xs: lv1 }
if (wU.xs).length > 0 { print((wU.xs).length) } else { print(0) }
