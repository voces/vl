function kind<T>(v: T): string {
  if v is i32 { return "i32" }
  if v is i64 { return "i64" }
  if v is f32 { return "f32" }
  if v is f64 { return "f64" }
  "other"
}
function run(q: i32 | f64 | null, b: f32) {
  const xs = [q ?? b]
  print(xs[0])
  print(kind(xs[0]))
  print("<\{xs[0]}>")
}
run(7, 0.5)
run(2.25, 0.5)
run(null, 0.5)
