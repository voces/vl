type N = 1 | 2
type Box1 = {[string]: {r: N}}[]
type Shape = Ua | Sq
type Ua = { ua: i32 }
type Sq = { s: i32 }
type Dot = { r: N }
function idg<T>(x: T): T { return x }
const _sp1: Box1 = []
function mkcall() {
  const lv1 = Map()
  lv1["k0"] = { r: 1 }
  lv1["k1"] = { r: 1 }
  const cc = [lv1]
  return cc
}
function outer() {
  const lam = () => {
    const dd = idg(mkcall())
    const g0 = dd
    if g0.length > 0 {
      const g1 = (g0[0])["k0"] ?? { r: 2 }
      if (g1).r == 1 { print(7) } else { print(0) }
    } else { print(0) }
  }
  lam()
}
outer()
