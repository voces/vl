type Dot = { r: i32, s: string }
type Shape = Circle | Sq
type Sq = { z: i32 }
type Circle = { r: i32, s: string }
const c0: Circle = { r: 7, s: "a" }
const t0: Dot = { r: 7, s: "a" }
function viaA(f: (i32) => Circle) { print(f(0).r) }
function viaB(g: (i32) => Dot) { print(g(0).r) }
viaA((p: i32) => c0)
viaB((q: i32) => t0)
