// D207's own witness — the `-3` map-value floor WITH a destination. Must keep RUNNING.
//
// `lv1` is an un-annotated `Map()` whose value type the checker infers from the first key
// write (`{r: i32|null}` adopted onto `Circle`'s row). The mv layer then asks for a rep
// under a render its struct table cannot name, answers the `-3` unsupported floor, and the
// binding used to keep that floor even though `c`'s declaration names the inner map's slot
// outright. `letMapShapeOf` now admits the floor to `letMapDestShape`, which is a FIND over
// slots the destination's own annotation walk already minted.
//
// This is the tripwire for the whole 6,037-cell block-B/C/D/E move. It is in `named/`
// rather than left to the derived half because the ABLATION is what it guards: it and
// `d207nodest.vl` are the pair that separates "supply a slot the destination names" from
// "mint one that nothing names", and only a program can hold that difference.
type Circle = { r: i32 | null }
const lv1 = Map()
lv1["k0"] = { r: 7 }
const c: {[string]: {[string]: Circle}} = Map()
c["k0"] = lv1
const g0 = (c)["k0"] ?? Map()
const g1 = (g0)["k0"] ?? { r: 0 }
if (g1).r != null { print(7) } else { print(0) }
