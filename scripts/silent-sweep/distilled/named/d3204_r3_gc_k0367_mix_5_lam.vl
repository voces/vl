type A = { v: i32 }
type B = { s: string }
type D = { d: string }
type E = { e: i32 }
const F = (z) => {
  if z.h is D { print(z.h.d)
    return }
  if z.h is E { print(z.h.e) } else { if !(z.h == null) { if !(z.h is A) { print(z.h + 1) } else { print(z.h.v) } } else { print("nul") } }
}
const x: { h: A | D | E | i32 | null } = { h: null }
F(x)
