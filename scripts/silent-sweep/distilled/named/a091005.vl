type K = "p" | "q"
type Dot = { r: K }
type DotB = { db: i32 }
type DotU = Dot | DotB
function idg<T>(x: T): T { return x }
function mksrc() {
  const cc: {r: K} = { r: "p" }
  return cc
}
function rd(c: {r: K}) {
  const lam = () => {
    const dd = idg(c)
    if (dd).r == "p" { print(7) } else { print(0) }
  }
  lam()
}
rd(mksrc())
