type B = { v: string | null }
function keep(v: string | null): B { return { v: v } }
function f<T>(x: T) {
  let s: string | null = "q"
  s = x
  const b = keep(s)
  print(b.v ?? "n")
  const l: (string | null)[] = [s]
  print(l[0] ?? "n")
  const o: B = { v: s }
  print(o.v == null)
}
const sn: string | null = null
f(sn)
f("hi")
