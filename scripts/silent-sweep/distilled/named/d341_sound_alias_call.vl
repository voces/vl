// SOUNDNESS: an ALIASING CALL that nulls the element. The property-path channel
// retires on `callInvalidatesNarrowedPath`; an index sub-path is not in that vocabulary.
function src(): i32[] | null { return [1, 2] }
function clr(ys: (i32[] | null)[]) { ys[0] = null }
function body() {
  const xs: (i32[] | null)[] = [src()]
  if xs[0] != null {
    clr(xs)
    print(xs[0].length)
  } else { print("NUL") }
}
body()
