import { reverse, indexOf } from "std:array"
function kind<T>(v: T): string {
  if v is i32 { return "i32" }
  if v is i64 { return "i64" }
  if v is f32 { return "f32" }
  if v is f64 { return "f64" }
  "other"
}
function run(e0: f64, e1: f32, k: i32) {
  const xs = [e0, e1]
  const ys = reverse(xs)
  print(ys[0])
  print(kind(ys[0]))
  print(indexOf(xs, xs[1]))
}
run(2.25, 0.5, 0)
