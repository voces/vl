type Circle = { r: i32 | null }
type Dot = { r: i32 | null }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = {[string]: Circle[]}
function idg<T>(x: T): T { return x }
const _sp1: Box1 = Map()
const dfl: Circle = { r: null }
function outer() {
  const lv1 = [{ r: null }]
  const c = Map()
  c["k0"] = lv1
  function inner() {
    const dd = idg(c)
    const g0 = (dd)["k0"] ?? []
