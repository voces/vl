type Circle = { r: i32 | null }
const _sp1: Box1 = Map()
const _sp2: Box2 = Map()
function rd() {
  const lv1 = [{ r: 7 }, { r: null }]
  const c: {[string]: Circle[]} = Map()
  c["k0"] = lv1
  const g0 = (c)["k0"] ?? []
