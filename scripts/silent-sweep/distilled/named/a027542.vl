type Cir2 = { c2: i32 }
type Sq2 = { s2: i32 }
type Shape2 = Cir2 | Sq2
type Box2 = Circle[][][]
type Box1 = Circle[][][]
type Shape = Circle | Sq
type Sq = { s: i32 }
type Circle = { r: Shape2 }
function useShape(s: Shape): i32 { if s is Sq { return 1 } return 0 }
const sqv: Sq = { s: 1 }
const _sp1: Box1 = []
const _sp2: Box2 = []
function mkc(): Circle[][][] {
  const lv2 = [{ r: { c2: 1 } }, { r: { c2: 1 } }]
  const lv1 = [lv2]
  const cc = [lv1]
  return cc
}
function mkcall() { return mkc() }
function outer() {
  function inner() {
    const lamc = (x: Circle[][][]) => x
    const dd = lamc(mkcall())
    if useShape(sqv) > 99 { print(0) }
    const g0 = dd
    if g0.length > 0 {
      const g1 = g0[0]
      if g1.length > 0 {
        const g2 = g1[0]
        if g2.length > 0 {
          if (g2[0]).r is Cir2 { print(7) } else { print(0) }
        } else { print(0) }
      } else { print(0) }
    } else { print(0) }
  }
  inner()
}
outer()
