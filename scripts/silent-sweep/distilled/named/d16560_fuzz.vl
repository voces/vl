let v5: i32 = (~v2)
let v6: i64 = ((if ((v3 * (-1)) >= v3) { (if (v3 == v3) { 1 } else { (-1) }) } else { tr_i64("e7", 9223372036854775807) }) / (~(3000000000 + (-9223372036854775807))))
