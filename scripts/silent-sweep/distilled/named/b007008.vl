type Circle = { r: i64 }
function sink(_x: Circle[][][]) { }
function mkcall() {
  const lv2 = [{ r: 7 }]
  const lv1 = [lv2]
  const cc = [lv1]
  return cc
}
function outer() {
  const lam = () => {
    sink(mkcall())
    const g0 = mkcall()
    if g0.length > 0 {
      const g1 = g0[0]
      if g1.length > 0 {
        const g2 = g1[0]
        if g2.length > 0 {
          if (g2[0]).r == 7 { print(7) } else { print(0) }
        } else { print(0) }
      } else { print(0) }
    } else { print(0) }
  }
  lam()
}
outer()
