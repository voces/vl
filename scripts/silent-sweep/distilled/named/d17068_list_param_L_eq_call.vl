type U = i32 | i32[]
type H = { k: i32[] }
let tr = ""
let gk: i32[] = [1, 2]
let gu: U = [1, 2]
function ok(): i32[] {
  tr = tr + "o"
  return gk
}
function oh(): H {
  tr = tr + "o"
  return { k: gk }
}
function bx(): U {
  tr = tr + "b"
  return gu
}
function g(u: U) { return u == ok() }
gu = [1, 2]
print(g(gu))
gu = [3]
print(g(gu))
gu = 1
print(g(gu))
print(tr)
