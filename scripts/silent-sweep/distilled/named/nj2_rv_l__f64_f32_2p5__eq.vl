function vi32(): i32 { 7 }
function vi64(): i64 { 9000000001 }
function vf32(): f32 { 1.5 }
function vf64(): f64 { 2.25 }
function wi32(): i32 { 11 }
function wi64(): i64 { 9000000005 }
function wf32(): f32 { 0.5 }
function wf64(): f64 { 6.75 }
function ni32(c: boolean): i32 | null { if c { return 7 } null }
function ni64(c: boolean): i64 | null { if c { return 9000000001 } null }
function nf32(c: boolean): f32 | null { if c { return 1.5 } null }
function nf64(c: boolean): f64 | null { if c { return 2.25 } null }
function kd<T>(v: T): string {
  if v is i32 { return "i32" }
  if v is i64 { return "i64" }
  if v is f32 { return "f32" }
  if v is f64 { return "f64" }
  "other"
}
function id<T>(v: T) { v }
function run() {
  print([vf64(), wf32(), 2.5] == [vf64(), wf32(), 2.5])
  print([vf64(), wf32(), 2.5][1])
}
run()
