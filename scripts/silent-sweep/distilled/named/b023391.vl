type Dot = { r: i32 | null }
type DotB = { db: i32 }
type DotU = Dot | DotB
type Sq = { s: i32 }
type Ua = { ua: i32 }
type Shape = Ua | Sq
type Box1 = {[string]: {r: i32 | null}}[]
type Box2 = {[string]: {r: i32 | null}}[]
function idg<T>(x: T): T { return x }
function useShape(s: Shape): i32 { if s is Sq { return 1 } return 0 }
const sqv: Sq = { s: 1 }
const _sp1: Box1 = []
const _sp2: Box2 = []
function mkc(): {[string]: {r: i32 | null}}[] {
  const lv1 = Map()
  lv1["k0"] = { r: 7 }
  const cc = []
  return cc
}
const c = mkc()
const dd = idg(c)
if useShape(sqv) > 99 { print(0) }
const g0 = dd
if g0.length > 0 {
  const g1 = (g0[0])["k0"] ?? { r: null }
  if (g1).r != null { print(7) } else { print(0) }
} else { print(0) }
