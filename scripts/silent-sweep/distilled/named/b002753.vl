type Circle = { r: i64 }
const dfl: Circle = { r: 0 }
function mkcall() {
  const cc = [{ r: 7 }]
  return cc
}
function outer() {
  const lam = () => {
    const g0 = mkcall()
    if g0.length > 0 {
      const gp: Circle = g0[0]
      if gp.r == 7 { print(7) } else { print(0) }
    } else { print(0) }
  }
  lam()
}
outer()
