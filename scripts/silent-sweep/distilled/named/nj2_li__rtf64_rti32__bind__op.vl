function kind<T>(v: T): string {
  if v is i32 { return "i32" }
  if v is i64 { return "i64" }
  if v is f32 { return "f32" }
  if v is f64 { return "f64" }
  "other"
}
function run(e0: f64, e1: i32, k: i32) {
  const xs = [e0, e1]
  print(xs[0])
  print(kind(xs[0]))
  print(xs[1])
  print(kind(xs[1]))
  print("<\{xs[0]}>")
}
run(2.25, -3, 0)
