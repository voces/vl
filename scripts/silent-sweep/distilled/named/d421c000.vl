type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type K = "a" | "b"
type N = 1 | 2
type CM = {[string]: i32}

function eqL<T>(a: T[], b: T[]): boolean { return a == b }
function cell(): boolean {
  const a: CM[] = [Map()]
  const b: CM[] = [Map()]
  return eqL(a, b)
}
print(cell())
