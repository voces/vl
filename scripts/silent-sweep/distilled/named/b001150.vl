type N = 1 | 2
type Box1 = {r: N}[]
type Shape = Ua | Sq
type Ua = { ua: i32 }
type Sq = { s: i32 }
type Dot = { r: N }
type GW = { g: {r: N}[] }
const _sp1: Box1 = []
function rd() {
  const c = [{ r: 1 }, { r: 1 }]
  const wv: GW = { g: c }
  const g0 = wv.g
  if g0.length > 0 {
    if (g0[0]).r == 1 { print(7) } else { print(0) }
  } else { print(0) }
}
rd()
