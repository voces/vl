function kind<T>(v: T): string {
  if v is i32 { return "i32" }
  if v is i64 { return "i64" }
  if v is f32 { return "f32" }
  if v is f64 { return "f64" }
  "other"
}
function run(q: i32 | null, r: i64 | null) {
  const z = (q ?? (r ?? 9000000000))
  print(z)
  print(kind(z))
  print("<\{z}>")
}
run(7, null)
run(null, -9000000003)
run(null, null)
