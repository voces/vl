type Circle = { r: i32 | null }
type Dot = { r: i32 | null }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = {[string]: Circle}[]
function thru(x: {[string]: Circle}[]) { return x }
const _sp1: Box1 = []
function mkcall() {
  const lv1 = Map()
  lv1["k0"] = { r: null }
  const cc = [lv1]
  return cc
}
function outer() {
  const lam = () => {
    const dd = thru(mkcall())
    const g0 = dd
    if g0.length > 0 {
      const g1 = (g0[0])["k0"] ?? { r: null }
      if (g1).r != null { print(7) } else { print(0) }
    } else { print(0) }
  }
  lam()
}
outer()
