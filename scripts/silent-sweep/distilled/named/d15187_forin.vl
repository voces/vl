// d15187 list of maps of a tagged function set — forin (D15187). Should print 1.5.
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const fnMap = Map()
fnMap.set("a", inc0)
fnMap.set("b", half)
const xs = [fnMap]
for m in xs {
  const g = m.get("b")
  if g != null { print(g(3)) }
}
