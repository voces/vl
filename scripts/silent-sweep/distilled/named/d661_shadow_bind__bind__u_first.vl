type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
const lv1 = [{ r: 7 }]
const cU: Shape[] = lv1
if cU.length > 0 { print(cU.length) } else { print(0) }
function fs() {
  const lv1 = [{ r: 7 }]
  const cS: Circle[] = lv1
  if cS.length > 0 { print(cS[0].r) } else { print(0) }
}
fs()
