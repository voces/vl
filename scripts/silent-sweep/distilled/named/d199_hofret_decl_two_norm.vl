type Circle = { r: i32, q: i32 }
type Sq = { z: i32 }
type Shape = Circle | Sq
type Dot = { r: i32, q: i32 }
const c0: Circle = { r: 7, q: 1 }
const t0: Dot = { r: 7, q: 1 }
function viaA(f: (i32) => Circle) { print(f(0).r) }
function viaB(g: (i32) => Dot) { print(g(0).r) }
viaA((p: i32) => c0)
viaB((q: i32) => t0)
