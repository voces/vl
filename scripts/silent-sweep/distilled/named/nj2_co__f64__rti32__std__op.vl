import { filled } from "std:array"
function kind<T>(v: T): string {
  if v is i32 { return "i32" }
  if v is i64 { return "i64" }
  if v is f32 { return "f32" }
  if v is f64 { return "f64" }
  "other"
}
function run(q: f64 | null, b: i32) {
  const xs = filled(2, q ?? b)
  print(xs[1])
  print(kind(xs[1]))
  print("<\{xs[1]}>")
}
run(2.25, -3)
run(null, -3)
