function kind<T>(v: T): string {
  if v is i32 { return "i32" }
  if v is i64 { return "i64" }
  if v is f32 { return "f32" }
  if v is f64 { return "f64" }
  "other"
}
function run(q: f64 | null, r: f64 | null, b: f32) {
  const z = (q ?? r ?? b)
  print(z)
  print(kind(z))
  print("<\{z}>")
}
run(2.25, null, 0.5)
run(null, 6.75, 0.5)
run(null, null, 0.5)
