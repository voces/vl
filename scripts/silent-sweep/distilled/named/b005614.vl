type Circle = { r: i64 }
type GW = { g: Circle[][] }
const dfl: Circle = { r: 0 }
function outer() {
  const lv1 = [{ r: 7 }]
  const c = [lv1]
  function inner() {
    const wv: GW = { g: c }
    const g0 = wv.g
    if g0.length > 0 {
      const g1 = g0[0]
      if g1.length > 0 {
        const gp: Circle = g1[0]
        if gp.r == 7 { print(7) } else { print(0) }
      } else { print(0) }
    } else { print(0) }
  }
  inner()
}
outer()
