type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function takeU(p: Shape[]) { print(p.length) }
function outer() {
  const lv1 = [{ r: 7 }]
  const cS: Circle[] = lv1
  function inner() {
    const lv1 = [{ r: 9 }]
    takeU(lv1)
  }
  inner()
  if cS.length > 0 { print(cS[0].r) } else { print(0) }
}
outer()
