type GW = { g: {[string]: {[string]: {r: f32}}} }
function rd() {
  const lv1 = Map()
  lv1["k0"] = { r: 7.5 }
  const c = Map()
  c["k0"] = lv1
  const wv: GW = { g: c }
  const g0 = (wv.g)["k0"] ?? Map()
  const g1 = (g0)["k0"] ?? { r: 0.5 }
  if (g1).r > 7.0 { print(7) } else { print(0) }
}
rd()
