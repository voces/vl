type K = "a" | "b"
function show<U>(x: U) { print(x) }
function g<T>(a: T, b: T, c: boolean) {
  print(if c { a ?? "b" } else { b })
}
const u0: K | null = "a"
const w0: K | null = "b"
g(u0, w0, true)
const u1: K | null = "a"
const w1: K | null = "b"
g(u1, w1, false)
const u2: K | null = null
const w2: K | null = "b"
g(u2, w2, true)
