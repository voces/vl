type Circle = { r: i32 }
type Sq = { s: i32 }
type Tri = { t: i32 }
type Shape = Circle | Sq
type Animal = Circle | Sq
type Other = Circle | Tri
function poke(p: Other[]) { p[0] = { t: 3 } }
function look(p: Shape[]) { const e = p[0]; match e { Circle => print(100 + e.r), Sq => print(200 + e.s) } }
function f() {
  const xs = [{ r: 7 }]
  poke(xs)
  look(xs)
}
f()
