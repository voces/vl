// The whole price of the REFUSED candidate, in three lines. Both owner literals have
// the field-name set `{r}`, so `structIndexOfObj` matches them to ONE anonymous row —
// but their nested values match DIFFERENT arms of the declared union. Minting an
// anonymous row for either nested literal collapses the two owners: `q` builds a union
// box `(struct.new $4 …)` into a field typed `(ref null $1)`, and the module does not
// parse. On the shipped tree both stay on the union-box path and this is a LOUD reject.
type Cir2 = { c2: i32 }
type Sq2 = { s2: i32 }
type Shape2 = Cir2 | Sq2
const p = { r: { c2: 1 } }
const q = { r: { s2: 1 } }
print(1)
