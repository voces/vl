type Dot = { r: i32 | null }
type DotB = { db: i32 }
type DotU = Dot | DotB
type Box1 = {r: i32 | null}
type Box2 = {r: i32 | null}
function idg<T>(x: T): T { return x }
const _sp1: Box1 = { r: null }
const _sp2: Box2 = { r: null }
function outer() {
  const c: {r: i32 | null} = { r: null }
  const lam = () => {
    const dd = idg(c)
    if (dd).r != null { print(7) } else { print(0) }
  }
  lam()
}
outer()
