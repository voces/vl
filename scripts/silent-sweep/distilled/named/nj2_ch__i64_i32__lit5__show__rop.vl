function kind<T>(v: T): string {
  if v is i32 { return "i32" }
  if v is i64 { return "i64" }
  if v is f32 { return "f32" }
  if v is f64 { return "f64" }
  "other"
}
function run(q: i64 | null, r: i32 | null) {
  const z = (q ?? (r ?? 5))
  print(z)
  print(kind(z))
  print("<\{z}>")
}
run(9000000001, null)
run(null, -3)
run(null, null)
