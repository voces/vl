type AB = "a" | "b"
type N12 = 1 | 2
type R = { a: {[i32]: AB | null}, b: {[i32]: i32} }
function show(x) { print(x) }
function mk(): R {
  const a: {[i32]: AB | null} = Map()
  a[3] = "a"
  a[4] = "b"
  a[5] = null
  const b: {[i32]: i32} = Map()
  b[3] = 2
  b[4] = 5
  { a: a, b: b }
}
function use(p) {
  print(p.a[9] ?? p.a[8] ?? p.b[3])
}
use(mk())
