// @run
// @log 6
// @log 6
// @log 2
// @log 4
// @log 6
// @log 4
// @log 4.5
// A `.map` over a list of declared un-annotated functions, returned from an un-annotated
// parameter's function, is a list at the caller: read in place, bound, and looped over, at two
// pins (D9280).
function inc0(a) { return a + 1 }
function dbl(a) { return a * 2 }
function half(a) { return a * 1.5 }
function take(a) { return a.map((f) => f(3)) }
const g = [inc0, dbl]
print(take(g)[1])
const r = take([inc0, dbl])
print(r[1])
print(r.length)
for x in take(g) { print(x) }
print(take([inc0])[0])
print(take([half])[0])
