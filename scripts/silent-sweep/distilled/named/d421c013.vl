type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type K = "a" | "b"
type N = 1 | 2
type F = 1.5 | 2.5
type CM = {[string]: i32}

function eqN<T>(a: T | null, b: T | null): boolean { return a == b }
function cell(): boolean {
  const a: CM | null = Map()
  const b: CM | null = Map()
  return eqN(a, b)
}
print(cell())
