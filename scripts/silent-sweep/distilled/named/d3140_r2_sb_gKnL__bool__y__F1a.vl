// want: y|true
type K = "a" | "b"
type L = "x" | "y"
function f<T>(x: T, p: boolean, o: boolean): T | boolean {
  if p { return x }
  return o
}
const a: (K | null) | L = "y"
const r1: (K | null) | L | boolean = f(a, true, true)
const r2: boolean | (K | null) | L = f(a, false, true)
print(r1)
print(r2)
