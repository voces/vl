type K = "a" | "b"
type P = {x: i32}
function g(a0, a1, k: i32) {
  const r = if k == 0 { a0 } else { a1 }
  const e = r[0]
  print(e is i32)
  print(e is string)
  print(e is boolean)
  print(e is f64)
  print(e is null)
  print(e is K)
  print(e is P)
}
const x0: K = "a"
const x1: string = "y"
g([x0], [x1], 0)
g([x0], [x1], 1)
