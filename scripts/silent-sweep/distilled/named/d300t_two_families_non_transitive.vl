// @run
// @log 7
// @log 7
// THE RUNG THAT SCORES ZERO AND IS STILL THE LANDING (silent-class-inventory D300).
//
// Two INDEPENDENT families over one layout: `Circle2`'s arms (`Cir2`/`Sq2`) and
// `CircleB`'s (`CirB`/`SqB`) are layout twins of each other, and both un-annotated maps
// infer the SAME value spelling `{r: {c2: i32}}`, so all three map-value slots meet. A
// LAYOUT-only twin rung is sound — every `1` still means one vals wrapper — but it stops
// the relation being TRANSITIVE, because the union of two equivalences is not one:
// `{r:{c2:i32}} ~canon Circle2` and `Circle2 ~layout CircleB` while the two ends do not
// twin pairwise.
//
// `mvCanonRepOf` returned the FIRST twin on the stated premise that the relation was
// transitive. `mAssignTypeIndices`'s heap mint, though, CHAINS
// (`mvMapTypeIdx[i] = mvMapTypeIdx[rep]`, itself already resolved) while `rlSig`'s
// map-element arm keys on a single hop — so the two disagreed, two ref-list slots the
// mint treats as one got different wrappers, and the "map-value layout twins resolved
// different vals wrappers" interlock fired. That interlock is an `emitFail`, which does
// NOT halt: its -1 became `typeOffset` and the emit walked off a parallel table. THIS
// FILE WAS A COMPILER TRAP, not a diagnostic, on the kind-1 hoist without the chained
// `mvCanonRepOf` — and it has run on every shipped compiler, so it is also the pin.
type Cir2 = { c2: i32 }
type Sq2 = { s2: i32 }
type Shape2 = Cir2 | Sq2
type Circle2 = { r: Shape2 }
const lv1 = Map()
lv1["k0"] = { r: { c2: 1 } }
const c1: {[string]: {[string]: Circle2}} = Map()
c1["k0"] = lv1
const a0 = (c1)["k0"] ?? Map()
const a1 = (a0)["k0"] ?? { r: { s2: 1 } }
if (a1).r is Cir2 { print(7) } else { print(0) }

type CirB = { c2: i32 }
type SqB = { s2: i32 }
type ShapeB = CirB | SqB
type CircleB = { r: ShapeB }
const lw2 = Map()
lw2["k0"] = { r: { c2: 1 } }
const lw1 = Map()
lw1["k0"] = lw2
const c2: {[string]: {[string]: {[string]: CircleB}}} = Map()
c2["k0"] = lw1
const b0 = (c2)["k0"] ?? Map()
const b1 = (b0)["k0"] ?? Map()
const b2 = (b1)["k0"] ?? { r: { s2: 1 } }
if (b2).r is CirB { print(7) } else { print(0) }
