function mkI(): {[string]: i32} {
  const mi: {[string]: i32} = Map()
  mi["z"] = 1
  return mi
}
type Circle = { r: {[string]: i32} }
type Dot = { r: {[string]: i32} }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = {[string]: Circle}[]
function idg<T>(x: T): T { return x }
const _sp1: Box1 = []
const dfl: Circle = { r: Map() }
function outer() {
  const lv1 = Map()
  lv1["k0"] = { r: mkI() }
  const c = [lv1]
  function inner() {
    const dd = idg(c)
    const g0 = dd
    if g0.length > 0 {
      const g1 = (g0[0])["k0"] ?? dfl
      const gp: Circle = g1
      if gp.r.length == 1 { print(7) } else { print(0) }
    } else { print(0) }
  }
  inner()
}
outer()
