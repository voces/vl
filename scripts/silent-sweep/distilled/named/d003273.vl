type Cir2 = { c2: i32 }
type Sq2 = { s2: i32 }
type Shape2 = Cir2 | Sq2
function mkcall() {
  const cc = Map()
  cc["k0"] = { r: { c2: 1 } }
  return cc
}
function outer() {
  const lam = () => {
    const g0 = (mkcall())["k0"] ?? { r: { s2: 1 } }
    if (g0).r is Cir2 { print(7) } else { print(0) }
  }
  lam()
}
outer()
