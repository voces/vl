type K = "a" | "b"
type P = {x: i32}
function g(a0, a1, k: i32) {
  const o = { v: match k {
    0 => a0
    1 => a1
    _ => "z"
  } }
  print(o.v is i32)
  print(o.v is string)
  print(o.v is boolean)
  print(o.v is f64)
  print(o.v is null)
  print(o.v is K)
  print(o.v is P)
}
const x0: K | null = "b"
const x1: K = "b"
g(x0, x1, 0)
g(x0, x1, 1)
g(x0, x1, 2)
