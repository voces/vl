type A = { v: i32 }
type B = { s: string }
type D = { d: string }
type E = { e: i32 }
const F = (z) => {
  if z.h is B { print(z.h.s)
    return }
  if z.h is A { print(z.h.v) } else { if !(z.h is D) { if !(z.h == null) { print(z.h + 1) } else { print("nul") } } else { print(z.h.d) } }
}
const x: { h: A | B | D | i32 | null } = { h: { v: 3 } }
F(x)
