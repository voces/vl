type Circle = { r: i32 | null }
type Dot = { r: i32 | null }
type DotB = { db: i32 }
type DotU = Dot | DotB
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = {[string]: Circle}
type Box2 = {[string]: Circle}
function idg<T>(x: T): T { return x }
function useShape(s: Shape): i32 { if s is Sq { return 1 } return 0 }
const sqv: Sq = { s: 1 }
const _sp1: Box1 = Map()
const _sp2: Box2 = Map()
const dfl: Circle = { r: null }
function rd() {
  const c = Map()
  c["k0"] = { r: null }
  const dd = idg(c)
  if useShape(sqv) > 99 { print(0) }
  const g0 = (dd)["k0"] ?? dfl
  const gp: Circle = g0
  if gp.r != null { print(7) } else { print(0) }
}
rd()
