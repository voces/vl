// SOUNDNESS: a write through a VARIABLE index falsifies the `xs[0]` narrowing, and
// `writeRetiresNarrowing` sees an unkeyable target (`xs[i]` -> "") so retires nothing.
function src(): i32[] | null { return [1, 2] }
function body(i: i32) {
  const xs: (i32[] | null)[] = [src()]
  if xs[0] != null {
    xs[i] = null
    print(xs[0].length)
  } else { print("NUL") }
}
body(0)
