// d15187 list of maps of a tagged function set — two_sets (D15187). Should print 1.5.
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const fnMap = Map()
fnMap.set("a", inc0)
fnMap.set("b", half)
const m2 = Map()
m2.set("a", half)
const xs = [fnMap, m2]
const g = xs[1].get("a")
if g != null { print(g(3)) }
