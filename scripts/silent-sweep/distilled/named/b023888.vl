function mkI(): {[string]: i32} {
  const mi: {[string]: i32} = Map()
  mi["z"] = 1
  return mi
}
type Circle = { r: {[string]: i32} }
function idg<T>(x: T): T { return x }
const dfl: Circle = { r: Map() }
function mkcall() {
  const lv1 = Map()
  lv1["k0"] = { r: mkI() }
  const cc = [lv1]
  return cc
}
function outer() {
  const lam = () => {
    const dd = idg(mkcall())
    const g0 = dd
    if g0.length > 0 {
      const g1 = (g0[0])["k0"] ?? dfl
      const gp: Circle = g1
      if gp.r.length == 1 { print(7) } else { print(0) }
    } else { print(0) }
  }
  lam()
}
outer()
