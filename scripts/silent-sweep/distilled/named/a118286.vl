type Dot = { r: i32 | null }
type DotB = { db: i32 }
type DotU = Dot | DotB
type Sq = { s: i32 }
type Ua = { ua: i32 }
type Shape = Ua | Sq
type Box1 = {r: i32 | null}
type Box2 = {r: i32 | null}
function idg<T>(x: T): T { return x }
function useShape(s: Shape): i32 { if s is Sq { return 1 } return 0 }
const sqv: Sq = { s: 1 }
const _sp1: Box1 = { r: null }
const _sp2: Box2 = { r: null }
function mksrc() {
  const cc: {r: i32 | null} = { r: null }
  return cc
}
function rd(c: {r: i32 | null}) {
  function inner() {
    const dd = idg(c)
    if useShape(sqv) > 99 { print(0) }
    if (dd).r != null { print(7) } else { print(0) }
  }
  inner()
}
rd(mksrc())
