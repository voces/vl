type AB = "a" | "b"
type N12 = 1 | 2
type R = { a: {[i32]: N12 | null}, b: {[i32]: i32} }
function show(x) { print(x) }
function mk(): R {
  const a: {[i32]: N12 | null} = Map()
  a[3] = 1
  a[4] = 2
  a[5] = null
  const b: {[i32]: i32} = Map()
  b[3] = 2
  b[4] = 5
  { a: a, b: b }
}
function use(p) {
  show(p.a[3] ?? p.b[4])
}
use(mk())
