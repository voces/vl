type U = f64 | string
type H = { k: f64 }
let tr = ""
let gk: f64 = 1.5
let gu: U = 1.5
function ok(): f64 {
  tr = tr + "o"
  return gk
}
function oh(): H {
  tr = tr + "o"
  return { k: gk }
}
function bx(): U {
  tr = tr + "b"
  return gu
}
function g(u: U) { return gk != u }
gu = 1.5
print(g(gu))
gu = 2.5
print(g(gu))
gu = "x"
print(g(gu))
print(tr)
