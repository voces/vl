type P = { name: string }
function show(p: P) { print(p.name) }
function fwd(t) { show(t) }
const v: { age: i32, name: string } = { age: 3, name: "a" }
const w: { name: string, z: f64, q: boolean } = { name: "b", z: 1.5, q: true }
const x: P = { name: "c" }
fwd(v)
fwd(w)
fwd(x)
print(v.age)
print(w.z)
