function mkI(): {[string]: i32} {
  const mi: {[string]: i32} = Map()
  mi["z"] = 1
  return mi
}
type Box1 = {[string]: {[string]: {[string]: {r: {[string]: i32}}}}}
type Shape = Circle | Sq
type Sq = { s: i32 }
type Dot = { r: {[string]: i32} }
type Circle = { r: {[string]: i32} }
type GW = { g: {[string]: {[string]: {[string]: {r: {[string]: i32}}}}} }
const _sp1: Box1 = Map()
function mkcall() {
  const lv2 = Map()
  const lv1 = Map()
  lv1["k0"] = lv2
  const cc = Map()
  cc["k0"] = lv1
  return cc
}
function outer() {
  const lam = () => {
    const wv: GW = { g: mkcall() }
    const g0 = (wv.g)["k0"] ?? Map()
    const g1 = (g0)["k0"] ?? Map()
    const g2 = (g1)["k0"] ?? { r: Map() }
    if (g2).r.length == 1 { print(7) } else { print(0) }
  }
  lam()
}
outer()
