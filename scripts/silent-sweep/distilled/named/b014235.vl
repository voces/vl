type Box1 = {[string]: {[string]: {[string]: Circle}}}
const _sp1: Box1 = Map()
function rd() {
  const lv2 = Map()
  lv2["k0"] = { r: null }
  const lv1 = Map()
  lv1["k0"] = lv2
  const c: {[string]: {[string]: {[string]: Circle}}} = Map()
