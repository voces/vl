type Circle = { r: i32 | null }
type Dot = { r: i32 | null }
type DotB = { db: i32 }
type DotU = Dot | DotB
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = {[string]: Circle}[]
type Box2 = {[string]: Circle}[]
function useShape(s: Shape): i32 { if s is Sq { return 1 } return 0 }
const sqv: Sq = { s: 1 }
const _sp1: Box1 = []
const _sp2: Box2 = []
const dfl: Circle = { r: null }
const lv1 = Map()
lv1["k0"] = { r: null }
const c = [lv1]
const lamc = (x: {[string]: Circle}[]) => x
const dd = lamc(c)
if useShape(sqv) > 99 { print(0) }
const g0 = dd
if g0.length > 0 {
  const g1 = (g0[0])["k0"] ?? dfl
  const gp: Circle = g1
  if gp.r != null { print(7) } else { print(0) }
} else { print(0) }
