// @run
// @log rubblenone
// @log 2
// A literal that is a member of the destination's literal union binds the type parameter to that
// union, so the list stores its other members (diderven DV-1002, D4024).
import { filled } from "std:array"

type Dress = "none" | "rubble"
const w: Dress[] = filled(4, "none")
w[2] = "rubble"
print(w[2] + w[3])
const lits: (1 | 2 | 7)[] = filled(2, 7)
lits[0] = 2
print(lits[0])
