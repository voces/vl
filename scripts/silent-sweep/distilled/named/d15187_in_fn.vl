// d15187 list of maps of a tagged function set — in_fn (D15187). Should print 2.5.
function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
const fnMap = Map()
fnMap.set("a", inc0)
fnMap.set("b", half)
function run() {
  const xs = [fnMap]
  const g = xs[0].get("b")
  if g != null { return g(5) }
  0.0
}
print(run())
