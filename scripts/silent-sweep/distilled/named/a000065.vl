import { reverse } from "std:array"
type N = 1 | 2
type Circle = { r: N }
const dfl: Circle = { r: 2 }
function rd() {
  const lv2 = Map()
  const lv1 = Map()
  lv1["k0"] = lv2
  const c = Map()
  c["k0"] = lv1
  const dd = reverse([c])[0]
  const g0 = (dd)["k0"] ?? Map()
  const g1 = (g0)["k0"] ?? Map()
  const g2 = (g1)["k0"] ?? dfl
  const gp: Circle = g2
  if gp.r == 1 { print(7) } else { print(0) }
}
rd()
