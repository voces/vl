type J = { f: i32 | null }
function mk() { { f: 4 } }
const m = Map()
m.set("a", mk())
const wm: {[string]: J} = Map()
wm.set("a", mk())
function mkA() { { f: 1 } }
const dA = mkA()
const a = m.get("a") ?? dA
print(a.f)
function mkE() { { f: 1 } }
function mkE2() { mkE() }
const e = m.get("z") ?? mkE2()
print(e.f ?? 0)
