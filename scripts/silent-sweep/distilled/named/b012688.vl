type Circle = { r: i32 | null }
type Dot = { r: i32 | null }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = {[string]: {[string]: Circle}}
const _sp1: Box1 = Map()
function mkc(): {[string]: {[string]: Circle}} {
  const lv1 = Map()
  lv1["k0"] = { r: null }
  const cc = Map()
  cc["k0"] = lv1
  return cc
}
function mkcall() { return mkc() }
function outer() {
  const lam = () => {
    const dd = mkcall()
    const g0 = (dd)["k0"] ?? Map()
    const g1 = (g0)["k0"] ?? { r: null }
    if (g1).r != null { print(7) } else { print(0) }
  }
  lam()
}
outer()
