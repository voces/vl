type P = { name: string }
function show(p: P[]) { print(p.length); for q in p { print(q.name) } }
function fwd(t) { show(t) }
const v: { age: i32, name: string }[] = [{ age: 3, name: "a" }, { age: 4, name: "b" }]
const w: { name: string, z: f64 }[] = []
const x: P[] = [{ name: "c" }]
fwd(v)
fwd(w)
fwd(x)
print(v[1].age)
