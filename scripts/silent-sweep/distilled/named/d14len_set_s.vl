function mk() {
  const m: {[string]: i32} = Map()
  m["a"] = 1
  return m
}
function mkset() {
  const s: Set<string> = Set()
  s.add("a")
  return s
}
function id1(q: i32) { return q }
function mknul(): i32 | null { return 7 }
function g<T>(x: T) { print(x.length) }
function body() {
  const v = mkset()
  g(v)
}
body()
