type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type WU = { xs: Shape[] }
function f() {
  const lv1 = [{ r: 7 }]
  const cS: Circle[][] = [lv1]
  const wU: WU = { xs: lv1 }
  if (wU.xs).length > 0 { print((wU.xs).length) } else { print(0) }
  if cS.length > 0 { if (cS[0]).length > 0 { print((cS[0])[0].r) } else { print(0) } } else { print(0) }
}
f()
