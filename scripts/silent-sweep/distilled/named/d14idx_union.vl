type Ca = { n: i32 }
type Sq = { s: i32 }
type U1 = Ca | Sq
function mku(): U1 { return { n: 7 } }
function mk() {
  const m: {[string]: i32} = Map()
  m["a"] = 1
  return m
}
function mkset() {
  const s: Set<string> = Set()
  s.add("a")
  return s
}
function id1(q: i32) { return q }
function mknul(): i32 | null { return 7 }
function g<T>(x: T) { print(x[0]) }
function body() {
  const v = mku()
  g(v)
}
body()
