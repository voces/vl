function kind<T>(v: T): string {
  if v is i32 { return "i32" }
  if v is i64 { return "i64" }
  if v is f32 { return "f32" }
  if v is f64 { return "f64" }
  "other"
}
function id<T>(v: T) { v }
function run(e0: f32, e1: f64, k: i32) {
  const xs = id([e0, e1, 9000000000])
  print(xs[0])
  print(kind(xs[0]))
  print(xs[1])
  print(kind(xs[1]))
  print(xs[2])
  print(kind(xs[2]))
  print("<\{xs[0]}>")
}
run(1.5, 6.75, 0)
