// want: a|true
type K = "a" | "b"
type L = "x" | "y"
function f<T>(x: T, p: boolean, o: boolean): T | boolean {
  if p { return x }
  return o
}
const a: K | (L | null) = "a"
const r1: K | (L | null) | boolean = f(a, true, true)
const r2: boolean | K | (L | null) = f(a, false, true)
print(r1)
print(r2)
