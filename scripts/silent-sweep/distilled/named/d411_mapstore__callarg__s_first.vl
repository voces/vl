type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function takeS(p: Circle[]) { print(p.length) }
function f() {
  const lv1 = [{ r: 7 }]
  takeS(lv1)
  const mU: {[string]: Shape[]} = Map()
  mU["k"] = lv1
  const gU = mU["k"] ?? []
  if gU.length > 0 { print(gU.length) } else { print(0) }
}
f()
