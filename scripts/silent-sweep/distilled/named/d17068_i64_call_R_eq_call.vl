type U = i64 | string
type H = { k: i64 }
let tr = ""
let gk: i64 = 7
let gu: U = 7
function ok(): i64 {
  tr = tr + "o"
  return gk
}
function oh(): H {
  tr = tr + "o"
  return { k: gk }
}
function bx(): U {
  tr = tr + "b"
  return gu
}
function g() { return ok() == bx() }
gu = 7
print(g())
gu = 8
print(g())
gu = "x"
print(g())
print(tr)
