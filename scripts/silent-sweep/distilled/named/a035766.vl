type Cir2 = { c2: i32 }
type Sq2 = { s2: i32 }
type Shape2 = Cir2 | Sq2
type Box2 = Circle[][][]
type Box1 = Circle[][][]
type Dot = { r: Shape2 }
type Circle = { r: Shape2 }
const _sp1: Box1 = []
const _sp2: Box2 = []
function mkc(): Circle[][][] {
  const lv2 = [{ r: { c2: 1 } }, { r: { c2: 1 } }]
  const lv1 = [lv2]
  const cc = [lv1]
  return cc
}
const c = mkc()
function outer() {
  const lam = () => {
    const lamc = (x: Circle[][][]) => x
    const dd = lamc(c)
    const g0 = dd
    if g0.length > 0 {
      const g1 = g0[0]
      if g1.length > 0 {
        const g2 = g1[0]
        if g2.length > 0 {
          if (g2[0]).r is Cir2 { print(7) } else { print(0) }
        } else { print(0) }
      } else { print(0) }
    } else { print(0) }
  }
  lam()
}
outer()
