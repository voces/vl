type Box2 = {[string]: {r: i32}}[]
type Box1 = {[string]: {r: i32}}[]
type Shape = Circle | Sq
type Sq = { s: i32 }
type DotU = Dot | DotB
type DotB = { db: i32 }
type Dot = { r: i32 }
type Circle = { r: i32 }
function idg<T>(x: T): T { return x }
function useShape(s: Shape): i32 { if s is Sq { return 1 } return 0 }
const sqv: Sq = { s: 1 }
const _sp1: Box1 = []
const _sp2: Box2 = []
const dfl: {r: i32} = { r: 0 }
function mkcall() {
  const lv1 = Map()
  lv1["k0"] = { r: 7 }
  lv1["k1"] = { r: 0 }
  const cc = [lv1]
  return cc
}
function outer() {
  const lam = () => {
    const dd = idg(mkcall())
    if useShape(sqv) > 99 { print(0) }
    const g0 = dd
    if g0.length > 0 {
      const g1 = (g0[0])["k0"] ?? dfl
      const gp: {r: i32} = g1
      if gp.r == 7 { print(7) } else { print(0) }
    } else { print(0) }
  }
  lam()
}
outer()
