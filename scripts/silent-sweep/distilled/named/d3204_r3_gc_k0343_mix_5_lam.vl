type A = { v: i32 }
type B = { s: string }
type D = { d: string }
type E = { e: i32 }
const F = (z) => {
  if z.h is A { print(z.h.v)
    return }
  if z.h is string { print(z.h.length) } else { if !(z.h == null) { if !(z.h is D) { print(z.h + 1) } else { print(z.h.d) } } else { print("nul") } }
}
const x: { h: A | D | i32 | string | null } = { h: { v: 3 } }
F(x)
