type AB = "a" | "b"
type N12 = 1 | 2
type R = { a: {[string]: f64 | null} }
function show(x) { print(x) }
function mk(): R {
  const a: {[string]: f64 | null} = Map()
  a["k3"] = 2.5
  a["k4"] = 4.5
  a["k5"] = null
  { a: a }
}
function use(p) {
  const r = p.a["k5"] ?? p.a["k4"] ?? 7.5
  print(r == null)
}
use(mk())
