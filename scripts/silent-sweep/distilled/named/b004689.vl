type Circle = { r: i64 }
type Dot = { r: i64 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = Circle[][]
function idg<T>(x: T): T { return x }
function sink(_x: Circle[][]) { }
const _sp1: Box1 = []
function outer() {
  const lv1 = [{ r: 7 }]
  const c = [lv1]
  function inner() {
    sink(c)
    const dd = idg(c)
    const g0 = dd
    if g0.length > 0 {
      const g1 = g0[0]
      if g1.length > 0 {
        if (g1[0]).r == 7 { print(7) } else { print(0) }
      } else { print(0) }
    } else { print(0) }
  }
