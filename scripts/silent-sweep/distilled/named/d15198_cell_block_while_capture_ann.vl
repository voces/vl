function __inc(a) { return a + 1 }
function __half(a) { return a / 2.0 }
const __rec = { fs: [__inc] }
const __ali = __rec.fs
__ali[0] = __half
let __i = 0
while __i < 1 {
  const __c: { fs: readonly ((a: i32) => i32 | f64)[] } = __rec
  const __f = () => {
    const v = __c
    print(v.fs[0](3))
  }
  __f()
  __i = __i + 1
}
