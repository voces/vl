// A generic a record or list literal names, where no read resolves it to one function, is instanced
// at the one signature the calls through its place class agree on (D16842).
function inc0(a) { return a + 1 }
function inc1(a) { return a + 2 }
function half(a) { return a / 2.0 }
function quarter(a) { return a / 4.0 }
function id(x) { return x }
function idt<T>(x: T): T { return x }
function app(o) { return o.f(12) }
const n = 3
const r = id(if n > 2 { { f: inc0 } } else { { f: inc1 } })
print(r.f(3))
print(id({ f: inc0 }).f(3))
const xs = idt([inc0])
print(xs[0](3))
print(app({ f: inc0 }))
print(app({ f: inc1 }))
const h = id(if n > 2 { { f: half } } else { { f: quarter } })
print(h.f(3.0))
