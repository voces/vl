type Box1 = {[string]: Circle[]}
type GW = { g: {[string]: Circle[]} }
const _sp1: Box1 = Map()
const dfl: Circle = { r: null }
function mksrc() {
  const lv1 = [{ r: null }]
  const cc = Map()
  cc["k0"] = lv1
  return cc
}
function rd(c: {[string]: Circle[]}) {
  function inner() {
    const wv: GW = { g: c }
    const g0 = (wv.g)["k0"] ?? []
    const g1 = g0
    if g1.length > 0 {
      const gp: Circle = g1[0]
      if gp.r != null { print(7) } else { print(0) }
    } else { print(0) }
  }
