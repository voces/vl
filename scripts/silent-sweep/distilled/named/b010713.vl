type Circle = { r: i32 | null }
type Dot = { r: i32 | null }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = {[string]: Circle}
type GW = { g: {[string]: Circle} }
const _sp1: Box1 = Map()
const dfl: Circle = { r: null }
function mkcall() {
  const cc = Map()
  cc["k0"] = { r: null }
  return cc
}
function outer() {
  const lam = () => {
    const wv: GW = { g: mkcall() }
    const g0 = (wv.g)["k0"] ?? dfl
    const gp: Circle = g0
    if gp.r != null { print(7) } else { print(0) }
  }
  lam()
}
outer()
