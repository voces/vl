type Circle = { r: i64 }
function idg<T>(x: T): T { return x }
function mkc(): Circle[][][] {
  const lv2 = [{ r: 7 }]
  const lv1 = [lv2]
  const cc = [lv1]
  return cc
}
const c = mkc()
const dd = idg(c)
const g0 = dd
if g0.length > 0 {
  const g1 = g0[0]
  if g1.length > 0 {
    const g2 = g1[0]
    if g2.length > 0 {
      if (g2[0]).r == 7 { print(7) } else { print(0) }
    } else { print(0) }
  } else { print(0) }
} else { print(0) }
