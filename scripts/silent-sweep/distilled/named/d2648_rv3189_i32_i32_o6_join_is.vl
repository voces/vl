type Rec = { x: i32 }
type Rec2 = { y: i32 }
type L = "p" | "q"
type U = {[i32]: i32} | {[i64]: i32} | string
function smk(): {[string]: i32} {
  const m: {[string]: i32} = Map()
  m.set("s", 1)
  m
}
function i64mk(): {[i64]: i32} {
  const m: {[i64]: i32} = Map()
  m.set(8, 1)
  m
}
function ismk(): {[i32]: string} {
  const m: {[i32]: string} = Map()
  m.set(8, "t")
  m
}
function f(u: U) {
  if u is {[i32]: i32} {
    u.set(5, 11)
    u.set(-3, 22)
    u[100000] = 33
    u.set(5, 44)
    u.delete(-3)
    print(u.has(-3))
    print(u.has(5))
    print(u.length)
    print(u.get(5) ?? -1)
    print(u.get(-3) ?? -1)
    print(u[100000] ?? -1)
    for k, v in u { print(k)
      print(v) }
  } else { print("other") }
}
function g(u: U) {
  if u is {[i32]: i32} {
    print(u.length)
    print(u.get(100000) ?? -1)
  } else { print("other2") }
}
const m0: {[i32]: i32} = Map()
function pick(c: boolean) {
  if c { return m0 }
  const o: {[i64]: i32} = i64mk()
  o
}
const u = pick(true)
f(u)
g(u)
print(m0.length)
const ov: {[i64]: i32} = i64mk()
f(ov)
