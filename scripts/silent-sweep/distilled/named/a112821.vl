type K = "p" | "q"
type Dot = { r: K }
type DotB = { db: i32 }
type DotU = Dot | DotB
type Sq = { s: i32 }
type Ua = { ua: i32 }
type Shape = Ua | Sq
function idg<T>(x: T): T { return x }
function useShape(s: Shape): i32 { if s is Sq { return 1 } return 0 }
const sqv: Sq = { s: 1 }
function outer() {
  const c: {r: K} = { r: "p" }
  function inner() {
    const dd = idg(c)
    if useShape(sqv) > 99 { print(0) }
    if (dd).r == "p" { print(7) } else { print(0) }
  }
  inner()
}
outer()
