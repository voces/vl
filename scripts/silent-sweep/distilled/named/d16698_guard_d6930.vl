function exclaim(s) { return s + "!" }

function hold<T>(x: T) {
  const _k = exclaim
  print(x)
}
function holdHole(x) {
  const _k = exclaim
  print(x)
}
function listed<T>(_x: T) {
  const xs = [exclaim]
  print(xs.length)
}
function get<T>(_x: T) { return exclaim }

hold(1)
holdHole("z")
