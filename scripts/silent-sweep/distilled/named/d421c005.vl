type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type K = "a" | "b"
type N = 1 | 2
type F = 1.5 | 2.5
type CM = {[string]: i32}

function addL<T>(a: T[], b: T[]): T[] { return a + b }
function cell(): i32 {
  const a: Circle[][] = [[{ r: 1 }]]
  const b: Circle[][] = [[{ r: 2 }]]
  return addL(a, b).length
}
print(cell())
