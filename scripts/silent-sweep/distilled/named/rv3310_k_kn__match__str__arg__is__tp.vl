type K = "a" | "b"
type P = {x: i32}
function show<U>(v: U) {
  print(v is K)
  print(v is null)
  print(v is string)
}
function g<T0, T1>(a0: T0, a1: T1, k: i32) {
  show(match k {
    0 => a0
    1 => a1
    _ => "z"
  })
}
const x0: K = "a"
const x1: K | null = null
g(x0, x1, 0)
g(x0, x1, 1)
g(x0, x1, 2)
