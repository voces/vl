go(1)
function keep(g) { const q = g; print(q(7)) }
function keepInList(g) { const xs = [g]; print(xs[0](1.5)) }
function keepBool(g) { const q = g; print(q(true)) }
function lap(f) {
  print(f(2.5))
  print(f(3))
  keep(f)
}
function lapList(f) {
  print(f(2.5))
  print(f(3))
  keepInList(f)
}
function lapBool(f) {
  print(f(2.5))
  print(f(3))
  keepBool(f)
}
function lapNested(f) {
  function inner(g) { const q = g; print(q(7)) }
  print(f(2.5))
  print(f(3))
  inner(f)
}
function go(k: i32) {
  lap((a) => a + k)
  lapList((a) => a + k)
  lapBool((a) => {
    print(k); return a
  })
  lapNested((a) => a + k)
  keep((x) => x + k + 1)
  keep((x) => x * k * 2)
}
