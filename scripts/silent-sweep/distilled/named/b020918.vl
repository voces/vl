function mkI(): {[string]: i32} {
  const mi: {[string]: i32} = Map()
  mi["z"] = 1
  return mi
}
type Box1 = {[string]: {r: {[string]: i32}}[]}
type Shape = Circle | Sq
type Sq = { s: i32 }
type Dot = { r: {[string]: i32} }
type Circle = { r: {[string]: i32} }
const _sp1: Box1 = Map()
const dfl: {r: {[string]: i32}} = { r: Map() }
function mkcall() {
  const lv1 = []
  const cc = Map()
  cc["k0"] = lv1
  return cc
}
function outer() {
  const lam = () => {
    const dd = mkcall()
    const g0 = (dd)["k0"] ?? []
    const g1 = g0
