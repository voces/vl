type A = { v: i32 }
type B = { s: string }
type D = { d: string }
type E = { e: i32 }
function F(z) {
  if z.h is E { print(z.h.e)
    return }
  if z.h is A { print(z.h.v)
    return }
  if z.h == null { print("nul")
    return }
  print(z.h + 1)
}
const x: { h: A | E | i32 | null } = { h: { v: 3 } }
F(x)
