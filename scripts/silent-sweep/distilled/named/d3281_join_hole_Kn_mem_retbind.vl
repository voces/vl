type K = "a" | "b"
function show<U>(x: U) { print(x) }
function g(a, b, c: boolean) {
  const r = if c { a ?? "b" } else { b }
  r
}
const u0: K | null = "a"
const w0: K | null = "b"
const v0 = g(u0, w0, true)
print(v0)
const u1: K | null = "a"
const w1: K | null = "b"
const v1 = g(u1, w1, false)
print(v1)
const u2: K | null = null
const w2: K | null = "b"
const v2 = g(u2, w2, true)
print(v2)
