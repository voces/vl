type Circle = { r: i32 | null }
const dfl: Circle = { r: null }
function mkcall() {
  const cc = [{ r: null }]
  return cc
}
function outer() {
  const lam = () => {
    const g0 = mkcall()
    if g0.length > 0 {
      const gp: Circle = g0[0]
      if gp.r != null { print(7) } else { print(0) }
    } else { print(0) }
  }
  lam()
}
outer()
