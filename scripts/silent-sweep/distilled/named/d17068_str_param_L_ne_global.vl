type U = i32 | string
type H = { k: string }
let tr = ""
let gk: string = "s"
let gu: U = "s"
function ok(): string {
  tr = tr + "o"
  return gk
}
function oh(): H {
  tr = tr + "o"
  return { k: gk }
}
function bx(): U {
  tr = tr + "b"
  return gu
}
function g(u: U) { return u != gk }
gu = "s"
print(g(gu))
gu = "t"
print(g(gu))
gu = 1
print(g(gu))
print(tr)
