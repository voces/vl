type K = "a" | "b"
type P = {x: i32}
const x0: boolean = true
const x1: P = {x: 8}
function outer<T, U>(a: T, b: U, k: i32) {
  function inner(k2: i32) {
    const r = if k2 == 0 { a } else { b }
    print(r == null)
    print(r is i32)
    print(r is string)
    print(r is boolean)
    print(r is f64)
    print(r is null)
    print(r is K)
    print(r is P)
  }
  inner(k)
}
outer(x0, x1, 0)
outer(x0, x1, 1)
