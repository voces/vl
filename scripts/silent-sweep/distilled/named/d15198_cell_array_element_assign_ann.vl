function __inc(a) { return a + 1 }
function __half(a) { return a / 2.0 }
const __rec = { fs: [__inc] }
const __ali = __rec.fs
__ali[0] = __half
const xs: ({ fs: readonly ((a: i32) => i32 | f64)[] })[] = [__rec]
xs[0] = __rec
const v: { fs: readonly ((a: i32) => i32 | f64)[] } = xs[0]
print(v.fs[0](3))
