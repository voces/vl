type F = (x: i32) => i32
function app<T>(f: (x: T) => T, x: T): T { return f(x) }
function deliver() { return app }
const v: (f: (x: i32) => i32, x: i32) => i32 = deliver()
print(v((n) => n * 2, 21))
const va: (f: F, x: i32) => i32 = deliver()
print(va((n) => n * 2, 21))
function call<T>(f: () => T): T { return f() }
function deliver2() { return call }
const c: (f: () => i32) => i32 = deliver2()
print(c(() => 7))
function app2<T>(f: (x: T) => T, x: T): T { return f(x) }
function deliver3() { return app2 }
function take(g) {
  const h = g
  print(h((n: i32) => n * 2, 21))
}
take(deliver3())
function twice<T>(f: (x: T) => T, x: T): T { return f(f(x)) }
function deliver4() { return twice }
const t: (f: F, x: i32) => i32 = deliver4()
print(t((n) => n * 2, 2))
