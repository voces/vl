type Circle = { r: i32 | null }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = {[string]: {[string]: {[string]: Circle}}}
type Box2 = {[string]: {[string]: {[string]: Circle}}}
type GW = { g: {[string]: {[string]: {[string]: Circle}}} }
function sink(_x: {[string]: {[string]: {[string]: Circle}}}) { }
function useShape(s: Shape): i32 { if s is Sq { return 1 } return 0 }
const sqv: Sq = { s: 1 }
const _sp1: Box1 = Map()
const _sp2: Box2 = Map()
function outer() {
  const lv2 = Map()
  lv2["k0"] = { r: null }
  const lv1 = Map()
  lv1["k0"] = lv2
  const c = Map()
  c["k0"] = lv1
  function inner() {
    sink(c)
    const wv: GW = { g: c }
    if useShape(sqv) > 99 { print(0) }
    const g0 = (wv.g)["k0"] ?? Map()
    const g1 = (g0)["k0"] ?? Map()
    const g2 = (g1)["k0"] ?? { r: null }
    if (g2).r != null { print(7) } else { print(0) }
  }
  inner()
}
outer()
