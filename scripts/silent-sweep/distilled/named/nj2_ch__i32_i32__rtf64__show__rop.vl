function kind<T>(v: T): string {
  if v is i32 { return "i32" }
  if v is i64 { return "i64" }
  if v is f32 { return "f32" }
  if v is f64 { return "f64" }
  "other"
}
function run(q: i32 | null, r: i32 | null, b: f64) {
  const z = (q ?? (r ?? b))
  print(z)
  print(kind(z))
  print("<\{z}>")
}
run(7, null, 6.75)
run(null, -3, 6.75)
run(null, null, 6.75)
