type AB = "a" | "b"
type N12 = 1 | 2
function show(x) { print(x) }
type R = { a: {[string]: f64}, b: {[string]: f64} }
function mk(): R {
  const a: {[string]: f64} = Map()
  a["k1"] = 2.5
  a["k2"] = -1.5
  const b: {[string]: f64} = Map()
  b["k1"] = -1.5
  { a: a, b: b }
}
function use(p) {
  const r = p.a["k1"] ?? -2.5
  print(r == null)
}
use(mk())
