type Circle = { r: i64 }
type GW = { g: Circle[][] }
function sink(_x: Circle[][]) { }
function rd() {
  const lv1 = [{ r: 7 }]
  const c = [lv1]
  sink(c)
  const wv: GW = { g: c }
  const g0 = wv.g
  if g0.length > 0 {
    const g1 = g0[0]
    if g1.length > 0 {
      if (g1[0]).r == 7 { print(7) } else { print(0) }
    } else { print(0) }
  } else { print(0) }
}
rd()
