type AB = "a" | "b"
type N12 = 1 | 2
type R = { a: {[string]: AB}, b: {[string]: i32} }
function show(x) { print(x) }
function mk(): R {
  const a: {[string]: AB} = Map()
  a["k3"] = "a"
  a["k4"] = "b"
  const b: {[string]: i32} = Map()
  b["k3"] = 2
  b["k4"] = 5
  { a: a, b: b }
}
function use(p) {
  print(p.a["k9"] ?? p.a["k8"] ?? p.b["k3"])
}
use(mk())
