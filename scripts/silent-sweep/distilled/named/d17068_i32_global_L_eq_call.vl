type U = i32 | string
type H = { k: i32 }
let tr = ""
let gk: i32 = 3
let gu: U = 3
function ok(): i32 {
  tr = tr + "o"
  return gk
}
function oh(): H {
  tr = tr + "o"
  return { k: gk }
}
function bx(): U {
  tr = tr + "b"
  return gu
}
function g() { return gu == ok() }
gu = 3
print(g())
gu = 4
print(g())
gu = "x"
print(g())
print(tr)
