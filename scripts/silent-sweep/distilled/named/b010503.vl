type Box2 = {[string]: {r: string}}
type Box1 = {[string]: {r: string}}
type Shape = Ua | Sq
type Ua = { ua: i32 }
type Sq = { s: i32 }
type DotU = Dot | DotB
type DotB = { db: i32 }
type Dot = { r: string }
function useShape(s: Shape): i32 { if s is Sq { return 1 } return 0 }
const sqv: Sq = { s: 1 }
const _sp1: Box1 = Map()
const _sp2: Box2 = Map()
const dfl: {r: string} = { r: "" }
function mkcall() {
  const cc = Map()
  return cc
}
function outer() {
  const lam = () => {
    if useShape(sqv) > 99 { print(0) }
    const g0 = (mkcall())["k0"] ?? dfl
    const gp: {r: string} = g0
    if gp.r == "seven" { print(7) } else { print(0) }
  }
  lam()
}
outer()
