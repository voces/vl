function idg<T>(x: T): T { return x }
function mkc(): {[string]: {r: i32 | null}}[] {
  const lv1 = Map()
  lv1["k0"] = { r: 7 }
  const cc = []
  return cc
}
const c = mkc()
const dd = idg(c)
const g0 = dd
if g0.length > 0 {
  const g1 = (g0[0])["k0"] ?? { r: null }
  if (g1).r != null { print(7) } else { print(0) }
} else { print(0) }
