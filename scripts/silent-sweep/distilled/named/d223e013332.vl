type Circle = { r: i32 | null }
type Dot = { q: i32 | null }
type Sq = { s: i32 }
type Shape = Circle | Sq
function rd() {
  const lv1 = [{ r: 7 }, { r: null }]
  const c: {[string]: Circle[]} = Map()
  c["k0"] = lv1
  const g0 = (c)["k0"] ?? []
  const g1 = g0
  if g1.length > 0 {
    if (g1[0]).r != null { print(7) } else { print(0) }
  } else { print(0) }
}
rd()
