print(head(2))
function addN(x: i32) { return x }
function mk(b: i32) { return addN(b) }
function tail(stop: i32) {
  return if stop == 0 { mk(42) } else { blk(stop - 1) }
}
function head(stop: i32) { return tail(stop) }
function fexpr(stop: i32) { return head(stop) }
function blk(stop: i32) { return fexpr(stop) }
