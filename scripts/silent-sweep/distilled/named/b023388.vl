type Dot = { r: i32 | null }
type Sq = { s: i32 }
type Ua = { ua: i32 }
type Shape = Ua | Sq
type Box1 = {[string]: {r: i32 | null}}[]
function idg<T>(x: T): T { return x }
const _sp1: Box1 = []
function mkc(): {[string]: {r: i32 | null}}[] {
  const lv1 = Map()
  lv1["k0"] = { r: 7 }
  const cc = []
  return cc
}
function mkcall() { return mkc() }
function outer() {
  const lam = () => {
    const dd = idg(mkcall())
    const g0 = dd
