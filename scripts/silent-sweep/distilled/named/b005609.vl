type Box2 = {r: i32 | null}[][]
type Box1 = {r: i32 | null}[][]
type Shape = Circle | Sq
type Sq = { s: i32 }
type DotU = Dot | DotB
type DotB = { db: i32 }
type Dot = { r: i32 | null }
type Circle = { r: i32 | null }
function useShape(s: Shape): i32 { if s is Sq { return 1 } return 0 }
const sqv: Sq = { s: 1 }
const _sp1: Box1 = []
const _sp2: Box2 = []
const dfl: {r: i32 | null} = { r: null }
function outer() {
  const lv1 = [{ r: null }]
  const c = [lv1]
  function inner() {
    const lamc = (x: {r: i32 | null}[][]) => x
    const dd = lamc(c)
    if useShape(sqv) > 99 { print(0) }
    const g0 = dd
    if g0.length > 0 {
      const g1 = g0[0]
      if g1.length > 0 {
        const gp: {r: i32 | null} = g1[0]
        if gp.r != null { print(7) } else { print(0) }
      } else { print(0) }
    } else { print(0) }
  }
  inner()
}
outer()
