type K = "a" | "b"
function show<U>(x: U) { print(x) }
function g(a, b, c: boolean) {
  const r = if c { a ?? "b" } else { b }
  print(r)
}
const u0: K | null = "a"
const w0: K | null = "b"
g(u0, w0, true)
const u1: K | null = "a"
const w1: K | null = "b"
g(u1, w1, false)
const u2: K | null = null
const w2: K | null = "b"
g(u2, w2, true)
