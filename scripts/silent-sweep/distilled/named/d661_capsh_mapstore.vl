type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function outer() {
  const lv1 = [{ r: 7 }]
  const cS: Circle[] = lv1
  function inner() {
    const lv1 = [{ r: 9 }]
    const mU: {[string]: Shape[]} = Map()
    mU["k"] = lv1
    const gU = mU["k"] ?? []
    if gU.length > 0 { print(gU.length) } else { print(0) }
  }
  inner()
  if cS.length > 0 { print(cS[0].r) } else { print(0) }
}
outer()
