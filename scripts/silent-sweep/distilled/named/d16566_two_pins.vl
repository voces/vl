type Q = { y: i32 }
type R = { y: f64 }
function mk(): {[string]: Q | null} { const m: {[string]: Q | null} = Map(); m["a"] = { y: 5 }; return m }
function mk2(): {[string]: R | null} { const m: {[string]: R | null} = Map(); m["a"] = { y: 1.5 }; return m }
function t(a) { let s = 0; for k, r in a { if r != null { s = s + r.y } }; print(s) }
t(mk())
t(mk2())
