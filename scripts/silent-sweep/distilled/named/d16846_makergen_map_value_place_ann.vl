function __k<T>(x: T): T {
  return x
}
function __mk() {
  return __k
}
function __body<U>(u: U): U {
  const a = __mk()
  return a(u)
}
const __s = __body("s")
function __fw(f) {
  return f
}
function __id(x) {
  return x
}
const __q = __fw(__id)
function __body2<T>(x: T): T {
  return __q(x)
}
const __t = __body2("t")
const __m: { [string]: i32 } = Map()
__m["k"] = __body(41)
