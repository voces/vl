type K = "a" | "b"
function p(v: string | null) { print(v ?? "n") }
type R = { s: K | null, n: i32 }
function g<T>(x: T) {
  const o: R = { s: null, n: 1 }
  o.s = "b"
  o.s = x
  const t: string | null = o.s
  print(t ?? "n")
}
const v3: K = "a"
const v4: K | null = null
const v5: K | null = "b"
g(v3)
g(v4)
g(v5)
