type K = "a" | "b"
type P = {x: i32}
const x0: i32 | null = null
const x1: string | null = null
function outer(k: i32) {
  function inner<V, W>(a: V, b: W, k2: i32) {
    const r = if k2 == 0 { a } else { b }
    print(r == null)
    print(r is i32)
    print(r is string)
    print(r is boolean)
    print(r is f64)
    print(r is null)
    print(r is K)
    print(r is P)
  }
  inner(x0, x1, k)
}
outer(0)
outer(1)
