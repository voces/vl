type Circle = { r: i64 }
type Dot = { r: i64 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = Circle[][][]
function idg<T>(x: T): T { return x }
const _sp1: Box1 = []
function mkc(): Circle[][][] {
  const lv2 = [{ r: 7 }]
  const lv1 = [lv2]
  const cc = [lv1]
  return cc
}
function outer() {
  const c = mkc()
  function inner() {
    const dd = idg(c)
    const g0 = dd
    if g0.length > 0 {
      const g1 = g0[0]
      if g1.length > 0 {
        const g2 = g1[0]
        if g2.length > 0 {
          if (g2[0]).r == 7 { print(7) } else { print(0) }
        } else { print(0) }
      } else { print(0) }
    } else { print(0) }
  }
  inner()
}
outer()
