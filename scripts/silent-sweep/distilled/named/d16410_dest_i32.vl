// d16410_dest_i32 — D16410's i32 face: a generic handed to a generic's function-typed parameter, `A` named only there, delivered at the i32 the instance defaults to. Should print 4.
function gid<A>(x: A): A { return x }
function sel<A>(f: (x: A) => A): (x: A) => A { return f }
const k: (x: i32) => i32 = sel(gid)
print(k(4))
