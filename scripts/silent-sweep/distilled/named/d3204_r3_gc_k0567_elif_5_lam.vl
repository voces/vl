type A = { v: i32 }
type B = { s: string }
type D = { d: string }
type E = { e: i32 }
const F = (z) => {
  if z.h is B { print(z.h.s) } else if z.h is D { print(z.h.d) } else if z.h is E { print(z.h.e) } else if z.h == null { print("nul") } else { print(z.h + 1) }
}
const x: { h: B | D | E | i32 | null } = { h: 5 }
F(x)
