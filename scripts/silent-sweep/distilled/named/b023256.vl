type Circle = { r: i32 | null }
type Dot = { r: i32 | null }
type Sq = { s: i32 }
type Shape = Circle | Sq
type Box1 = {[string]: Circle}[]
type GW = { g: {[string]: Circle}[] }
const _sp1: Box1 = []
function mkc(): {[string]: Circle}[] {
  const lv1 = Map()
  lv1["k0"] = { r: null }
  const cc = [lv1]
  return cc
}
const c = mkc()
const wv: GW = { g: c }
const g0 = wv.g
if g0.length > 0 {
  const g1 = (g0[0])["k0"] ?? { r: null }
  if (g1).r != null { print(7) } else { print(0) }
} else { print(0) }
