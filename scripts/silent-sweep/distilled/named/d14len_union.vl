type Ca = { n: i32 }
type Sq = { s: i32 }
type U1 = Ca | Sq
function mku(): U1 { { n: 7 } }
function mk() {
  const m: {[string]: i32} = Map()
  m["a"] = 1
  m
}
function mkset() {
  const s: {[string]: boolean} = Set()
  s.add("a")
  s
}
function id1(q: i32) { q }
function mknul(): i32 | null { 7 }
function g<T>(x: T) { print(x.length) }
function body() {
  const v = mku()
  g(v)
}
body()
