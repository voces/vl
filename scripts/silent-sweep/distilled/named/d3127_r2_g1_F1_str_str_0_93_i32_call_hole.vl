type AB = "a" | "b"
type N12 = 1 | 2
type R = { a: {[i32]: string}, b: {[i32]: string} }
function show(x) { print(x) }
function mk(): R {
  const a: {[i32]: string} = Map()
  a[3] = "x"
  a[4] = "y"
  const b: {[i32]: string} = Map()
  b[3] = "x"
  b[4] = "y"
  { a: a, b: b }
}
function use(p) {
  show(p.a[9] ?? p.b[3])
}
use(mk())
