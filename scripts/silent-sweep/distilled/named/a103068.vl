import { reverse } from "std:array"
type Box1 = {r: i64}[][]
type Shape = Ua | Sq
type Ua = { ua: i32 }
type Sq = { s: i32 }
type DotU = Dot | DotB
type DotB = { db: i32 }
type Dot = { r: i64 }
function sink(_x: {r: i64}[][]) { }
const _sp1: Box1 = []
function outer() {
  function inner() {
    const lv1 = [{ r: 7 }, { r: 7 }]
    const c = [lv1]
    sink(c)
    const dd = reverse([c])[0]
    const g0 = dd
    if g0.length > 0 {
      const g1 = g0[0]
      if g1.length > 0 {
        if (g1[0]).r == 7 { print(7) } else { print(0) }
      } else { print(0) }
    } else { print(0) }
  }
  inner()
}
outer()
