// d16209_map_sum — D16209's witness: a sum of calls through hole-function relays, stored into an un-annotated map. Should print 76.
function __add(a, b) {
  return a + b
}
function __ap2(g) {
  return g(1, 2) + g("ab", "c").length
}
function __ap3(g) {
  return g(10, 20) + g("x", "y").length
}
function __pick(c: boolean) {
  const f = if c { __ap2 } else { __ap3 }
  return f(__add)
}
function __each() {
  let s = 0
  const fs = [__ap2, __ap3]
  for f in fs { s = s + f(__add) }
  return s
}
const m = Map()
m["k"] = __pick(true) + __pick(false) + __each()
const mv = m["k"]
if mv != null { print(mv) }
