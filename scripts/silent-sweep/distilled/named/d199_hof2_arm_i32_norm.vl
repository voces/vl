type Circle = { r: i32 }
type Sq = { z: i32 }
type Shape = Circle | Sq
type Kot = { r: i32 }
type Sq2 = { w: i32 }
type Other = Kot | Sq2
const c0: Circle = { r: 7 }
const t0: Kot = { r: 7 }
function viaA(f: (Circle) => Circle, x: Circle) { print(f(x).r) }
function viaB(g: (Kot) => Kot, y: Kot) { print(g(y).r) }
viaA((p: Circle) => p, c0)
viaB((q: Kot) => q, t0)
