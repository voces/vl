function inc0(a) { return a + 1 }
function half(a) { return a / 2.0 }
function mk() { return { a: [{ f: inc0 }, { f: half }] } }
function take(v) { let acc = 0.0; let i = 0; while i < v.length { acc = acc + v[i].f(3); i = i + 1 }; print(acc) }
function takeF(v) { let acc = 0.0; for e in v { acc = acc + e.f(3) }; print(acc) }
function main() { const L = mk().a; take(L) }
main()
