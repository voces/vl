type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
type WU = { xs: Shape[] }
function outer() {
  const lv1 = [{ r: 7 }]
  const cS: Circle[] = lv1
  function inner() {
    const lv1 = [{ r: 9 }]
    const wU: WU = { xs: lv1 }
    if (wU.xs).length > 0 { print((wU.xs).length) } else { print(0) }
  }
  inner()
  if cS.length > 0 { print(cS[0].r) } else { print(0) }
}
outer()
