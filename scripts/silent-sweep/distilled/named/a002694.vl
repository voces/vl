type K = "p" | "q"
type Box1 = {[string]: {[string]: {r: K}}}
type Circle = { r: K }
function thru(x: {[string]: {[string]: {r: K}}}) { return x }
function sink(_x: {[string]: {[string]: {r: K}}}) { }
const _sp1: Box1 = Map()
function mksrc() {
  const lv1 = Map()
  const cc = Map()
  cc["k0"] = lv1
  return cc
}
function rd(c: {[string]: {[string]: {r: K}}}) {
  sink(c)
  const dd = thru(c)
  const g0 = (dd)["k0"] ?? Map()
  const g1 = (g0)["k0"] ?? { r: "q" }
  if (g1).r == "p" { print(7) } else { print(0) }
}
rd(mksrc())
