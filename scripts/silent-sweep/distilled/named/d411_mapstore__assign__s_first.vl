type Circle = { r: i32 }
type Sq = { s: i32 }
type Shape = Circle | Sq
function f() {
  const lv1 = [{ r: 7 }]
  let aS: Circle[] = []
  aS = lv1
  const mU: {[string]: Shape[]} = Map()
  mU["k"] = lv1
  const gU = mU["k"] ?? []
  if gU.length > 0 { print(gU.length) } else { print(0) }
  if aS.length > 0 { print(aS[0].r) } else { print(0) }
}
f()
