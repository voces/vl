type Circle = { r: i32 | null }
type GW = { g: Circle[][] }
function sink(_x: Circle[][]) { }
const lv1 = [{ r: null }]
const c = [lv1]
sink(c)
const wv: GW = { g: c }
const g0 = wv.g
if g0.length > 0 {
  const g1 = g0[0]
  if g1.length > 0 {
    if (g1[0]).r != null { print(7) } else { print(0) }
  } else { print(0) }
} else { print(0) }
