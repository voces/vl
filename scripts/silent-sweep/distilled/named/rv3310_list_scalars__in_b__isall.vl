type K = "a" | "b"
type P = {x: i32}
const x0: i32 | null = null
const x1: boolean = false
function g<T, U>(xs: T[], ys: U[], k: i32) {
  const a = xs[0]
  const b = ys[0]
  const r = if k == 0 { a } else { b }
  print(r == null)
  print(r is i32)
  print(r is string)
  print(r is boolean)
  print(r is f64)
  print(r is null)
  print(r is K)
  print(r is P)
}
g([x0], [x1], 0)
g([x0], [x1], 1)
