import { reverse } from "std:array"
type Box2 = {[string]: {r: i32 | null}[]}
type Box1 = {[string]: {r: i32 | null}[]}
type Shape = Circle | Sq
type Sq = { s: i32 }
type DotU = Dot | DotB
type DotB = { db: i32 }
type Dot = { r: i32 | null }
type Circle = { r: i32 | null }
function useShape(s: Shape): i32 { if s is Sq { return 1 } return 0 }
const sqv: Sq = { s: 1 }
const _sp1: Box1 = Map()
const _sp2: Box2 = Map()
function mkcall() {
  const lv1 = [{ r: null }]
  const cc = Map()
  cc["k0"] = lv1
  return cc
}
function outer() {
  const lam = () => {
    const dd = reverse([mkcall()])[0]
    if useShape(sqv) > 99 { print(0) }
    const g0 = (dd)["k0"] ?? []
    const g1 = g0
    if g1.length > 0 {
      if (g1[0]).r != null { print(7) } else { print(0) }
    } else { print(0) }
  }
  lam()
}
outer()
