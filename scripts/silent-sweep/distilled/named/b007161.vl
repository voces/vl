type Circle = { r: i64 }
function sink(_x: Circle[][][]) { }
const lv2 = [{ r: 7 }]
const lv1 = [lv2]
const c = [lv1]
sink(c)
const lamc = (x: Circle[][][]) => x
const dd = lamc(c)
const g0 = dd
if g0.length > 0 {
  const g1 = g0[0]
  if g1.length > 0 {
    const g2 = g1[0]
    if g2.length > 0 {
      if (g2[0]).r == 7 { print(7) } else { print(0) }
    } else { print(0) }
  } else { print(0) }
} else { print(0) }
