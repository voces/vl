type Box1 = {[string]: {r: i32}}[]
type Shape = Circle | Sq
type Sq = { s: i32 }
type Dot = { r: i32 }
type Circle = { r: i32 }
function idg<T>(x: T): T { return x }
const _sp1: Box1 = []
const dfl: {r: i32} = { r: 0 }
function mksrc() {
  const lv1 = Map()
  lv1["k0"] = { r: 7 }
  lv1["k1"] = { r: 0 }
  const cc = [lv1]
  return cc
}
function rd(c: {[string]: {r: i32}}[]) {
  function inner() {
    const dd = idg(c)
    const g0 = dd
    if g0.length > 0 {
      const g1 = (g0[0])["k0"] ?? dfl
      const gp: {r: i32} = g1
      if gp.r == 7 { print(7) } else { print(0) }
    } else { print(0) }
  }
  inner()
}
rd(mksrc())
