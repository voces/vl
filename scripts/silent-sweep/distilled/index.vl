// `expected.jsonl`, the corpus index, and the writer that owns its curated half. Every
// graded cell needs a row: `block` says derived (`A`-`E`, written by `redistil.vl`) or
// curated (a named set, `represents` 1), and `represents` how many census cells it
// stands for. A curated set carries its provenance in `named/sources.json` first.
//
//     vl run scripts/silent-sweep/distilled/index.vl -- --check
//     vl run scripts/silent-sweep/distilled/index.vl -- --set <block> <cell>...
//     vl run scripts/silent-sweep/distilled/index.vl -- --set <block> --missing
//     vl run scripts/silent-sweep/distilled/index.vl -- --prune
//
// Run from the checkout root. `--check` exits 2 when a cell has no row or a row no cell.

import { exit } from "std:process"
import { programArgs } from "std:args"
import { Utf8Error } from "std:utf8"
import { toString } from "std:fmt"
import { join, startsWith } from "std:str"
import { die, hasFlag } from "../../lib/common"
import {
  audit,
  complaint,
  isDerived,
  loadCells,
  prune,
  sortStrings,
  strField,
  writeSet,
} from "../../lib/corpus"

const USAGE = "usage: vl run scripts/silent-sweep/distilled/index.vl -- --check | --prune\n           | --set <block> <cell>... | --set <block> --missing\nRun from the checkout root. --check exits 2 when a cell has no row or a row no cell."

function check(): i32 {
  const msg = complaint(audit())
  if msg != "" {
    print(msg)
    return 2
  }
  const idx = loadCells("scripts/silent-sweep/distilled/expected.jsonl")
  let ncur = 0
  const sets: Map<string, boolean> = Map()
  for _c, rec in idx {
    const b = strField(rec, "block")
    if !isDerived(b) {
      ncur = ncur + 1
      sets[b] = true
    }
  }
  print(
    "index: \{toString(idx.length)} rows — \{toString(idx.length - ncur)} derived, \{toString(ncur)} curated over \{toString(sets.length)} named sets ✅",
  )
  0
}

// `--set <block>` then the cells after it (every argument not starting `-`), plus every
// unindexed cell under `--missing`.
function set(args: string[]): i32 {
  let at = 0
  while args[at] != "--set" { at = at + 1 }
  if at + 1 >= args.length {
    print(USAGE)
    return 2
  }
  const block = args[at + 1]
  const seen: Map<string, boolean> = Map()
  let k = at + 2
  while k < args.length {
    if !startsWith(args[k], "-") { seen[args[k]] = true }
    k = k + 1
  }
  if hasFlag(args, "--missing") {
    for c in audit().missing { seen[c] = true }
  }
  if seen.length == 0 {
    die(
      "index: --set names no cells. An empty write is not a no-op, it is a command that did nothing and said it worked.",
      1,
    )
  }
  const n = writeSet(block, sortStrings(seen.keys()))
  print("index: wrote \{toString(n)} row(s) at block \{block}")
  0
}

function main(args: string[]): i32 {
  if hasFlag(args, "--check") { return check() }
  if hasFlag(args, "--prune") {
    const gone = prune()
    let tail = ""
    if gone.length > 0 { tail = ": " + join(gone.slice(0, 8), ", ") }
    print("index: pruned \{toString(gone.length)} row(s) with no cell\{tail}")
    return 0
  }
  if hasFlag(args, "--set") { return set(args) }
  print(USAGE)
  2
}

const argv = programArgs()
if argv is Utf8Error {
  die("index: an argument is not UTF-8: " + argv.msg, 2)
} else {
  exit(main(argv))
}
