// Grade one census cell directory against one seed on the full outcome vocabulary, and
// write `{cell: {class, msg}}` to `out.json`. The expectation is the directory's
// `manifest.json`, never the compiler.
//
//     vl run scripts/silent-sweep/census/gradecensus.vl -- <celldir> <seed.wasm> <out.json>
//         [--jobs N]
//
// Run from the checkout root; `std:` is graded from this checkout's `std/`. Chunks are
// graded `$JOBS` at a time (default 4, which `REPRODUCE.md` fixes as the ceiling);
// `GRADE_BATCH=0` grades every cell on its own.

import { exit } from "std:process"
import { programArgs } from "std:args"
import { Utf8Error } from "std:utf8"
import { parseI32, toString } from "std:fmt"
import { die } from "../../lib/common"
import { padLeft, padRight, sortStrings, writeText } from "../../lib/corpus"
import {
  gradeChunk,
  gradeJson,
  gradeParts,
  jobsFromEnv,
} from "../../lib/census-grade"

const SELF = "scripts/silent-sweep/census/gradecensus.vl"
const USAGE = "usage: vl run scripts/silent-sweep/census/gradecensus.vl -- <celldir> <seed.wasm> <out.json> [--jobs N]"
const SILENT = [
  "runs but wrong value", "check-clean invalid wasm", "compiler trap",
  "trap_loads",
]

function main(args: string[]): i32 {
  if args.length == 2 && args[0] == "--grade-chunk" {
    gradeChunk(args[1])
    return 0
  }
  if args.length < 3 {
    print(USAGE)
    return 2
  }
  const cells = args[0]
  const seed = args[1]
  const out = args[2]
  let jobs = jobsFromEnv(4)
  let k = 3
  while k < args.length {
    if args[k] == "--jobs" {
      if k + 1 >= args.length { die("gradecensus: --jobs needs a value", 2) }
      const n = parseI32(args[k + 1])
      if n == null {
        die("gradecensus: --jobs is not an integer: \{args[k + 1]}", 2)
      }
      jobs = n ?? jobs
    }
    k = k + 1
  }
  const f = gradeParts(SELF, [{ name: "cells", dir: cells }], seed, jobs)
  if f.rc != 0 {
    print(
      "gradecensus: the grader itself failed on \{cells} (rc=\{toString(f.rc)})",
    )
    return 1
  }
  const res = f.parts["cells"] ?? Map()
  writeText(out, gradeJson(res))
  const count: Map<string, i32> = Map()
  for _c, r in res { count[r.cls] = (count[r.cls] ?? 0) + 1 }
  print("\{out}  cells=\{toString(res.length)}  seed=\{seed}")
  for cls in sortStrings(count.keys()) {
    print(
      "  " + padRight(cls, 26) + " " + padLeft(toString(count[cls] ?? 0), 6),
    )
  }
  let silent = 0
  for cls in SILENT { silent = silent + (count[cls] ?? 0) }
  print(
    "  " + padRight("SILENT TOTAL", 26) + " " + padLeft(toString(silent), 6),
  )
  0
}

const argv = programArgs()
if argv is Utf8Error {
  die("gradecensus: an argument is not UTF-8: " + argv.msg, 2)
} else {
  exit(main(argv))
}
