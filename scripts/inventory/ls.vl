// List the filed inventory rows (id, declared outcome, title) in id order, reading the
// status vocabulary `scripts/check-filed-witnesses.vl` grades against.
//
//     vl run scripts/inventory/ls.vl -- [<doc-or-dir>...] [--status S] [--tail N]
//     vl run scripts/inventory/ls.vl -- --next
//     vl run scripts/inventory/ls.vl -- --reserve D<lo>-D<hi> <holder> [<note>]
//     vl run scripts/inventory/ls.vl -- --release D<lo>-D<hi>
//
// Run from the checkout root: every path, `RESERVED.md` included, resolves against the
// working directory. `--next` skips the reserved ranges and names each on stderr, which it
// reaches through `/dev/stderr` because VL has no stderr sink (a `dogfood:` row).

import { IoError, appendTextFile, readTextFile, writeTextFile } from "std:fs"
import { exit, runProgram } from "std:process"
import { programArgs } from "std:args"
import { Utf8Error, decodeUtf8Lossy } from "std:utf8"
import { parseI32, toString } from "std:fmt"
import { endsWith, join, split, startsWith } from "std:str"
import {
  die,
  findFrom,
  isDigit,
  isFile,
  rstripWs,
  stripWs,
  univNl,
  wsLen,
} from "../lib/common"
import {
  IdKey,
  declaredOutcome,
  headOf,
  idKey,
  matchSec,
  padTo,
  resolve,
  sortKeys,
  statusJoinContinues,
  stripByte,
} from "../lib/inventory"

const TARGETS = ["docs/internals/inventory", "docs/internals/inventory-2"]
const RESERVED_DOC = "docs/internals/inventory/RESERVED.md"
const MARKER = "<!-- reservations below; the marker is what --reserve/--release edit around -->"
const USAGE = "usage: vl run scripts/inventory/ls.vl -- [<doc-or-dir>...] [--status S] [--tail N]\n       vl run scripts/inventory/ls.vl -- --next\n       vl run scripts/inventory/ls.vl -- --reserve D<lo>-D<hi> <holder> [<note>]\n       vl run scripts/inventory/ls.vl -- --release D<lo>-D<hi>\n`--status` takes open, closed, silent, loud, or any canonical outcome by name."

// One listed row; `key.path` carries the row's index into the list it came from.
type Listed = { id: string, outcome: string, title: string, key: IdKey }

// A live reservation line of `RESERVED.md`.
type Res = { lo: i64, hi: i64, who: string, date: string, note: string }

function readText(path: string): string {
  const t = readTextFile(path)
  if t is IoError {
    die("ls.vl: cannot read \{path} (\{t.msg})", 1)
    return ""
  }
  univNl(t)
}

// ── rows ────────────────────────────────────────────────────────────────────────

// `lines` without the `---` rule, and the blank lines around it, that joins a row to the next.
function stripSeparator(lines: string[]): string[] {
  let j = lines.length
  while j > 0 && stripWs(lines[j - 1]) == "" { j = j - 1 }
  if j > 0 && stripWs(lines[j - 1]) == "---" {
    j = j - 1
    while j > 0 && stripWs(lines[j - 1]) == "" { j = j - 1 }
  }
  lines.slice(0, j)
}

// The row's first `**` line as its status, joined across a wrap up to the closing `**`;
// "" when that first line never closes inside its paragraph.
function statusLine(body: string[]): string {
  let i = 0
  while i < body.length {
    const ln = body[i]
    if !startsWith(ln, "**") {
      i = i + 1
      continue
    }
    const r = rstripWs(ln)
    if endsWith(r, "**") && r.length > 2 { return stripWs(stripByte(ln, 42)) }
    const parts = [ln]
    let k = i + 1
    while k < body.length {
      if !statusJoinContinues(body[k]) { return "" }
      parts.push(body[k])
      if endsWith(rstripWs(body[k]), "**") {
        return stripWs(stripByte(join(parts, " "), 42))
      }
      k = k + 1
    }
    return ""
  }
  ""
}

// The outcome a row's body files, or "?": its status line, else its first bold line.
function rowOutcome(body: string[]): string {
  let status = statusLine(body)
  if status == "" {
    for ln in body {
      if startsWith(ln, "**") {
        status = stripWs(stripByte(ln, 42))
        break
      }
    }
  }
  const o = declaredOutcome(status)
  if o == "" { return "?" }
  o
}

// Every row of `doc`: a row runs from its heading to the next row or `#`/`##` heading.
function rowsOfDoc(doc: string, out: Listed[]) {
  const lines = split(readText(doc), "\n")
  let i = 0
  while i < lines.length {
    const m = matchSec(lines[i])
    if m.id == "" {
      i = i + 1
      continue
    }
    let j = i + 1
    while (
      j < lines.length
      && matchSec(lines[j]).id == ""
      && !headOf(lines[j], 1, 2)
    ) {
      j = j + 1
    }
    const key = idKey(m.id, toString(out.length))
    out.push(
      {
        id: m.id,
        outcome: rowOutcome(stripSeparator(lines.slice(i, j))),
        title: m.title,
        key: key,
      },
    )
    i = j
  }
}

// Every row of every target, in id order across all of them, stably.
function allRows(targets: string[]): Listed[] {
  const raw: Listed[] = []
  for t in targets {
    for doc in resolve(t) { rowsOfDoc(doc, raw) }
  }
  const keys: IdKey[] = []
  for r in raw { keys.push(r.key) }
  const out: Listed[] = []
  for k in sortKeys(keys) {
    const at = parseI32(k.path)
    if at is i32 { out.push(raw[at]) }
  }
  out
}

function wanted(want: string, outcome: string): boolean {
  if want == "open" { return outcome != "runs" }
  if want == "closed" { return outcome == "runs" }
  if want == "silent" { return startsWith(outcome, "silent_") }
  if want == "loud" { return endsWith(outcome, "_reject") }
  outcome == want
}

// ── reservations ────────────────────────────────────────────────────────────────

// The index past `\d{4}-\d{2}-\d{2}` at `i`, or -1.
function dateEnd(s: string, i: i32): i32 {
  const shape = "dddd-dd-dd"
  if i + shape.length > s.length { return -1 }
  let k = 0
  while k < shape.length {
    const b = s[i + k]
    if shape[k] == 45 {
      if b != 45 { return -1 }
    } else if !isDigit(b) {
      return -1
    }
    k = k + 1
  }
  i + shape.length
}

// The digits at `i` as a number and the index past them; `end` is -1 when there are none.
type Num = { n: i64, end: i32 }

function digitsAt(s: string, i: i32): Num {
  let j = i
  let n: i64 = 0
  while j < s.length && isDigit(s[j]) {
    n = n * 10 + ((s[j] - 48) as i64)
    j = j + 1
  }
  if j == i { return { n: 0, end: -1 } }
  { n: n, end: j }
}

// `D(\d+)-D(\d+)` at the start of `s`: lo in `a`, hi in `b`, and `b.end` is where it ends.
type Span = { a: Num, b: Num }

function spanAt(s: string): Span {
  const bad: Span = { a: { n: 0, end: -1 }, b: { n: 0, end: -1 } }
  if !startsWith(s, "D") { return bad }
  const a = digitsAt(s, 1)
  if a.end < 0 || !startsWith(s.slice(a.end, s.length), "-D") { return bad }
  const b = digitsAt(s, a.end + 2)
  if b.end < 0 { return bad }
  { a: a, b: b }
}

function wsRun(s: string, i: i32): i32 {
  let j = i
  while wsLen(s, j) > 0 { j = j + wsLen(s, j) }
  j - i
}

// One stripped line as a reservation, with the holder taken as the regex
// `^D(\d+)-D(\d+)\s+(.+?)\s+(\d{4}-\d{2}-\d{2})\s*(.*)$` takes it; `who` is "" when
// the line is not one.
function parseRes(ln: string): Res {
  const none: Res = { lo: 0, hi: 0, who: "", date: "", note: "" }
  const sp = spanAt(ln)
  if sp.b.end < 0 { return none }
  const w0 = sp.b.end
  const w = wsRun(ln, w0)
  if w == 0 { return none }
  // `\s+` gives back whitespace only when nothing else matches, so try it longest first.
  const starts: i32[] = []
  let j = w0
  while j < w0 + w {
    j = j + wsLen(ln, j)
    starts.push(j)
  }
  let s = starts.length - 1
  while s >= 0 {
    const hs = starts[s]
    let p = hs + 1
    while p <= ln.length {
      const k = wsRun(ln, p)
      if k > 0 {
        const e = dateEnd(ln, p + k)
        if e >= 0 {
          return {
            lo: sp.a.n,
            hi: sp.b.n,
            who: ln.slice(hs, p),
            date: ln.slice(p + k, e),
            note: stripWs(ln.slice(e, ln.length)),
          }
        }
      }
      p = p + 1
    }
    s = s - 1
  }
  none
}

function resLess(a: Res, b: Res): boolean {
  if a.lo != b.lo { return a.lo < b.lo }
  if a.hi != b.hi { return a.hi < b.hi }
  if a.who != b.who { return a.who < b.who }
  if a.date != b.date { return a.date < b.date }
  a.note < b.note
}

function sortRes(rs: Res[]): Res[] {
  const out: Res[] = []
  for r in rs {
    out.push(r)
    let i = out.length - 1
    while i > 0 && resLess(out[i], out[i - 1]) {
      const t = out[i]
      out[i] = out[i - 1]
      out[i - 1] = t
      i = i - 1
    }
  }
  out
}

// Every live range, sorted; none when the file is absent.
function reservations(): Res[] {
  if !isFile(RESERVED_DOC) { return [] }
  const out: Res[] = []
  for ln in split(readText(RESERVED_DOC), "\n") {
    const r = parseRes(stripWs(ln))
    if r.who != "" { out.push(r) }
  }
  sortRes(out)
}

function rangeText(r: Res): string { "D\{toString(r.lo)}-D\{toString(r.hi)}" }

function today(): string {
  const r = runProgram("date", ["+%F"])
  if r is IoError {
    die("ls.vl: cannot run date (\{r.msg})", 1)
    return ""
  }
  stripWs(decodeUtf8Lossy(r.stdout))
}

// `s` quoted as Python's `repr` quotes a plain string.
function pyRepr(s: string): string {
  let q = "'"
  if findFrom(s, "'", 0) >= 0 && findFrom(s, "\"", 0) < 0 { q = "\"" }
  let out = q
  let i = 0
  while i < s.length {
    const b = s[i]
    if b == 92 { out = out + "\\\\" }
    else if b == 10 { out = out + "\\n" }
    else if b == 13 { out = out + "\\r" }
    else if b == 9 { out = out + "\\t" }
    else if b == q[0] { out = out + "\\" + q }
    else { out = out + s.slice(i, i + 1) }
    i = i + 1
  }
  out + q
}

function cmdReserve(
  spec: string,
  holder: string,
  note: string,
  release: boolean,
): i32 {
  const sp = spanAt(spec)
  if sp.b.end != spec.length {
    print("ls.vl: range must read D<lo>-D<hi>, got \{pyRepr(spec)}")
    return 2
  }
  const lo = sp.a.n
  const hi = sp.b.n
  if lo > hi {
    print("ls.vl: \{spec} runs backwards")
    return 2
  }
  const want: Res = { lo: lo, hi: hi, who: holder, date: "", note: note }
  const res = reservations()
  const keep: Res[] = []
  if release {
    for r in res {
      if r.lo != lo || r.hi != hi { keep.push(r) }
    }
    if keep.length == res.length {
      print("ls.vl: no reservation exactly \{rangeText(want)} to release")
      return 2
    }
  } else {
    for r in res {
      if !(hi < r.lo || lo > r.hi) {
        let why = "ls.vl: \{rangeText(want)} overlaps \{rangeText(r)}, held by \{r.who} since \{r.date}"
        if r.note != "" { why = why + " (\{r.note})" }
        print(why)
        return 1
      }
      keep.push(r)
    }
    keep.push({ lo: lo, hi: hi, who: holder, date: today(), note: note })
  }
  const body = readText(RESERVED_DOC)
  let head = body
  const at = findFrom(body, MARKER, 0)
  if at >= 0 { head = body.slice(0, at) }
  const lines: string[] = []
  for r in sortRes(keep) {
    let ln = "\{rangeText(r)}  \{r.who}  \{r.date}"
    if r.note != "" { ln = ln + "  " + r.note }
    lines.push(ln)
  }
  const w = writeTextFile(
    RESERVED_DOC,
    head + MARKER + "\n\n" + join(lines, "\n") + "\n",
  )
  if w != null { die("ls.vl: cannot write \{RESERVED_DOC} (\{w.msg})", 1) }
  if release {
    print("released \{rangeText(want)}")
  } else {
    print("reserved \{rangeText(want)}")
  }
  0
}

// ── main ────────────────────────────────────────────────────────────────────────

function nextId(rows: Listed[]): i32 {
  let n: i64 = 1
  if rows.length > 0 {
    let top: i64 = rows[0].key.num
    for r in rows {
      if r.key.num > top { top = r.key.num }
    }
    n = top + 1
  }
  const res = reservations()
  const skipped: Res[] = []
  let moved = true
  while moved {
    moved = false
    for r in res {
      if r.lo <= n && n <= r.hi {
        skipped.push(r)
        n = r.hi + 1
        moved = true
        break
      }
    }
  }
  print("D\{toString(n)}")
  for r in skipped {
    let ln = "  skipped \{rangeText(r)} — \{r.who}, \{r.date}"
    if r.note != "" { ln = ln + ", " + r.note }
    const e = appendTextFile("/dev/stderr", ln + "\n")
    if e != null { print(ln) }
  }
  0
}

function main(args: string[]): i32 {
  let want = ""
  let tail = 0
  let nxt = false
  const targets: string[] = []
  let i = 0
  while i < args.length {
    const a = args[i]
    if a == "--status" || a == "--tail" {
      if i + 1 >= args.length {
        print(USAGE)
        return 2
      }
      if a == "--status" {
        want = args[i + 1]
      } else {
        const n = parseI32(args[i + 1])
        if n is null {
          print(USAGE)
          return 2
        }
        tail = n
      }
      i = i + 2
      continue
    }
    if a == "--next" {
      nxt = true
    } else if a == "--reserve" || a == "--release" {
      if i + 1 >= args.length {
        print(USAGE)
        return 2
      }
      let who = ""
      let note = ""
      if a == "--reserve" && i + 2 < args.length { who = args[i + 2] }
      if a == "--reserve" && i + 3 < args.length { note = args[i + 3] }
      return cmdReserve(args[i + 1], who, note, a == "--release")
    } else if startsWith(a, "--") {
      print(USAGE)
      return 2
    } else {
      targets.push(a)
    }
    i = i + 1
  }
  if targets.length == 0 {
    for t in TARGETS { targets.push(t) }
  }
  const rows = allRows(targets)
  if nxt { return nextId(rows) }
  let picked: Listed[] = []
  for r in rows {
    if want == "" || wanted(want, r.outcome) { picked.push(r) }
  }
  if tail > 0 && tail < picked.length {
    picked = picked.slice(picked.length - tail, picked.length)
  } else if tail < 0 {
    let from = -tail
    if from > picked.length { from = picked.length }
    picked = picked.slice(from, picked.length)
  }
  let w = 3
  for r in picked {
    if r.id.cpLen() > w { w = r.id.cpLen() }
  }
  for r in picked {
    print(padTo(r.id, w) + "  " + padTo(r.outcome, 22) + " " + r.title)
  }
  let sum = "\n\{toString(picked.length)} of \{toString(rows.length)} rows"
  if want != "" { sum = sum + " · --status " + want }
  print(sum + " · " + join(targets, ", "))
  0
}

const argv = programArgs()
if argv is Utf8Error {
  die("ls.vl: an argument is not UTF-8: " + argv.msg, 2)
} else {
  exit(main(argv))
}
