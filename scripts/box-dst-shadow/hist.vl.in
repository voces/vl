
// Probe only (probe.sh appends this file): the box record's write history at the node a delivery
// reads, graded against the site's union. "" where the node holds one union or none.
function bdsHistNode(ix: i32, fnIx: i32): i32[] {
  for c in [ix, unwrapParen(ix), nodeSrc[ix] ?? -1] {
    let at = c
    let hops = 0
    while at >= 0 && hops < 8 {
      if fnIx >= 0 && elabNodeBoxAt(at, fnIx) >= 0 {
        return bxwInstOf(at, elabKeyAt(fnIx))
      }
      if nodeBoxTyIxOf(at) >= 0 { return bxwHistOf(at) }
      at = tyCarrySrcOf(at)
      hops = hops + 1
    }
  }
  []
}

function bdsAgreeTy(unionName: string, unionTy: i32, r: i32): boolean {
  if unionTy >= 0 && unionTy == r { return true }
  const rn = tyToEmitName(r)
  if rn == unionName { return true }
  const ks = canonUnionKeyOfName(unionName)
  if ks >= 0 && (canonUnionKeyOfTy(r) == ks || canonUnionKeyOfName(rn) == ks) {
    return true
  }
  rn != "" && bdsSameAtoms(canonUnionKeyTextOfName(unionName), canonUnionKeyTextOfTy(r))
}

function bdsYN(b: boolean): string {
  if b { return "y" }
  "n"
}

function bdsHist(unionName: string, unionTy: i32, ix: i32, fnIx: i32): string {
  const h = bdsHistNode(ix, fnIx)
  // Consecutive writes of one spelling collapse; A > B > A stays three.
  const ds: i32[] = []
  const ns: string[] = []
  let distinct = false
  const roles = ["ctx", "join", "exit", "?"]
  for w in h {
    const t = w / 4
    const n = roles[w % 4] + ":" + tyToEmitName(t)
    if ds.length > 0 && tyToEmitName(t) != tyToEmitName(ds[0]) { distinct = true }
    if ns.length == 0 || ns[ns.length - 1] != n {
      ds.push(t)
      ns.push(n)
    }
  }
  if !distinct { return "" }
  // The join: every member any write named.
  const atoms: string[] = []
  for t in ds {
    const xs: string[] = []
    splitUnionAtoms(canonUnionKeyTextOfTy(t), xs)
    for x in xs {
      let hit = false
      for y in atoms {
        if y == x { hit = true }
      }
      if !hit { atoms.push(x) }
    }
  }
  const want: string[] = []
  splitUnionAtoms(canonUnionKeyTextOfName(unionName), want)
  let joinOk = want.length == atoms.length && want.length > 0
  for w in want {
    let hit = false
    for y in atoms {
      if y == w { hit = true }
    }
    if !hit { joinOk = false }
  }
  let any = false
  for t in ds {
    if bdsAgreeTy(unionName, unionTy, t) { any = true }
  }
  let trail = ""
  for n in ns {
    if trail != "" { trail = trail + " > " }
    trail = trail + n
  }
  " | hist first=" + bdsYN(bdsAgreeTy(unionName, unionTy, ds[0])) + " last=" +
    bdsYN(bdsAgreeTy(unionName, unionTy, ds[ds.length - 1])) + " join=" + bdsYN(joinOk) +
    " any=" + bdsYN(any) + " : " + trail
}
