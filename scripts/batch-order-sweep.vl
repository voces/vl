// Whether a program's `vl check` verdict depends on the programs checked before it on one
// instance (`vl check --batch`, the LSP): the cross-program leak class (D15934, D15935).
//
//     vl run scripts/batch-order-sweep.vl [-- --orders N] [--compiler SEED] [--dir DIR]
//
// One worker (`VL_JOBS=1`) checks every `.vl` under DIR (default `tests/cases`) in N shuffled
// orders (default 4). Each file's exit and error messages are compared with an oracle run where
// a trivial program precedes every file. A difference names the file, the order and the program
// checked just before it, and the script exits 1. Run it from the checkout root. A discovery
// instrument, not a gate: a leak shows only when its source lands right before its victim.
import { IoError, writeTextFile } from "std:fs"
import { exit } from "std:process"
import { programArgs } from "std:args"
import { Utf8Error } from "std:utf8"
import { toString } from "std:fmt"
import { sort } from "std:array"
import { join, split } from "std:str"
import { Json, parseJson } from "std:json"
import { spawn } from "./lib/probe-grade"

const VL = "scripts/vl-host/target/release/vl"

function flagValue(
  args: readonly string[],
  name: string,
  fallback: string,
): string {
  let i = 0
  while i + 1 < args.length {
    if args[i] == name { return args[i + 1] }
    i = i + 1
  }
  fallback
}

// The `.vl` files under `dir`, sorted, so every order starts from the same list.
function caseFiles(dir: string): string[] {
  const p = spawn("find", [dir, "-name", "*.vl", "-type", "f"])
  const out: string[] = []
  for l in split(p.out, "\n") {
    if l.length > 0 { out.push(l) }
  }
  out.sort((a: string, b: string): boolean => a < b)
  out
}

// A permutation of `xs` from `seed`, by a linear congruential stream: the same seed, the same order.
function shuffled(xs: string[], seed: i32): string[] {
  const out: string[] = []
  for x in xs { out.push(x) }
  let state = seed * 1103515245 + 12345
  let i = out.length - 1
  while i > 0 {
    state = state * 1103515245 + 12345
    const r = (state >> 8) & 0x7fffffff
    const j = r % (i + 1)
    const t = out[i]
    out[i] = out[j]
    out[j] = t
    i = i - 1
  }
  out
}

// Each record's file and verdict: its exit and its error messages, joined in order.
function batch(files: string[], compiler: string): string[][] {
  const args = [
    "VL_JOBS=1",
    "RUST_BACKTRACE=0",
    VL,
    "check",
    "--batch",
    "--json",
  ]
  for f in files { args.push(f) }
  args.push("--compiler")
  args.push(compiler)
  const p = spawn("env", args)
  const out: string[][] = []
  for l in split(p.out, "\n") {
    if l.length == 0 { continue }
    const j = parseJson(l)
    if j is { [string]: Json } {
      const f = j["file"]
      const e = j["exit"]
      const ds = j["diagnostics"]
      const msgs: string[] = []
      if ds is Json[] {
        for d in ds {
          if d is { [string]: Json } {
            const sev = d["severity"]
            const m = d["message"]
            if sev is string && sev == "error" && m is string { msgs.push(m) }
          }
        }
      }
      const ex = if e is f64 { toString(e) } else { "?" }
      if f is string { out.push([f, ex + " " + join(msgs, " | ")]) }
    }
  }
  out
}

function main(args: readonly string[]) {
  const dir = flagValue(args, "--dir", "tests/cases")
  const compiler = flagValue(args, "--compiler", "build/vl-compiler.wasm")
  const orders = parseOrders(flagValue(args, "--orders", "4"))
  const files = caseFiles(dir)
  const mk = spawn("mktemp", ["-d"])
  const tmp = split(mk.out, "\n")[0]
  const reset = tmp + "/reset.vl"
  const w = writeTextFile(reset, "print(1)\n")
  if w is IoError {
    print("batch-order-sweep: cannot write " + reset + ": " + w.msg)
    exit(2)
    return 0
  }
  const inter: string[] = []
  for f in files {
    inter.push(reset)
    inter.push(f)
  }
  const oracle = Map<string, string>()
  for r in batch(inter, compiler) {
    if r[0] != reset { oracle[r[0]] = r[1] }
  }
  let bad = 0
  let o = 0
  while o < orders {
    let prev = "(first)"
    for r in batch(shuffled(files, o + 1), compiler) {
      const want = oracle[r[0]] ?? ""
      if want != r[1] {
        bad = bad + 1
        print(
          "ORDER-DEPENDENT \{r[0]} (order \{toString(o + 1)}, after \{prev})",
        )
        print("  alone: \{want}")
        print("  after: \{r[1]}")
      }
      prev = r[0]
    }
    o = o + 1
  }
  spawn("rm", ["-rf", tmp])
  print(
    "batch-order-sweep: \{toString(files.length)} files, \{toString(orders)} orders, \{toString(bad)} order-dependent verdicts",
  )
  if bad > 0 { exit(1) }
  0
}

// The order count `s` names, at least one.
function parseOrders(s: string): i32 {
  let n = 0
  for c in s {
    if c < '0' || c > '9' { return 4 }
    n = n * 10 + (c - '0')
  }
  if n < 1 { 1 } else { n }
}

const argv = programArgs()
if argv is Utf8Error {
  print("batch-order-sweep: an argument is not UTF-8: " + argv.msg)
  exit(2)
} else {
  main(argv)
}
