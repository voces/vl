// Where is the compiler's module-scope mutable state CLEARED, and the invariant on what is not.
//
//     vl run scripts/emitter-state-audit.vl [-- --names]
//     vl run scripts/emitter-state-audit.vl -- --check [--without-reset NAME] [--dir DIR]
//
// Every `let` at column 0 in a compiler module survives a program, and one wasm instance runs
// many (`vl check --batch`, the LSP, `tests/cases_wasm_test.ts`). For each one this finds every
// write in `compiler/*.vl` (a one-line setter's calls count as writes in the caller) and
// classifies the variable by the function that CLEARS it — writes its initial value back, or
// overwrites it at top level without reading it: the compile prologue, a pass, a frame
// builder, some inner function. A `let` none clears is safe by shape (`letShape`), by a
// reviewed list (LSTAMPED, LSCOPED, LINSTANCE), or NEVER. The frame-builder table lists the
// `fnUses*` flags one of the two frame builders resets and the other does not (D1006/D1007).
//
// `--check` is an invariant, not a ratchet: it exits 1 naming every NEVER row, every emitter
// inner integer register holding a per-program id (D11770) that GUARDED does not cover, and
// every written module container (`const`, or a `let` mutated in place) nothing empties.
// `--without-reset NAME` ignores one function's clears and `--dir` audits another tree, so the
// tests' controls can make it red. Run from the checkout root: paths are relative to it.

import { IoError, listDir, readTextFile } from "std:fs"
import { programArgs } from "std:args"
import { exit } from "std:process"
import { Utf8Error } from "std:utf8"
import { toString } from "std:fmt"
import {
  endsWith,
  join,
  lastIndexOf,
  padEnd,
  padStart,
  split,
  startsWith,
} from "std:str"
import { sort } from "std:array"
import { die, findFrom, hasFlag, lstripWs, stripWs } from "./lib/common"

// The compiler sources audited: `compiler`, or the tree `--dir` names (the tests' controls).
let cdir = "compiler"

// The emitter's own modules, where the index-register rule (GUARDED, D11770) applies. The
// never-cleared rule reads every compiler module.
const EMIT = [
  "emit_state.vl", "emit_classify.vl", "emit_collect.vl", "emit_sections.vl",
  "emit_base.vl", "emit_rep.vl", "emit_bytes.vl", "emit_query.vl",
  "emit_mono.vl", "emit_rewrite.vl", "emit_bignum.vl", "wasmEmit.vl", "memo.vl",
  "emit_anon_fields.vl", "emit_atom_kinds.vl", "emit_capture_frames.vl",
  "emit_closure_callee.vl", "emit_closure_sites.vl", "emit_eq_rows.vl",
  "emit_field_codes.vl", "emit_fn_ret_kinds.vl", "emit_fn_scans.vl",
  "emit_if_arm_values.vl", "emit_join_records.vl", "emit_list_rep.vl",
  "emit_lit_atoms.vl", "emit_local_scope.vl", "emit_map_twins.vl",
  "emit_map_value_slots.vl", "emit_mv_slots.vl", "emit_local_slots.vl",
  "emit_nullable_rets.vl", "emit_obj_lit_fits.vl", "emit_ref_list_kinds.vl",
  "emit_shape_intern.vl", "emit_shape_rows.vl", "emit_sig_tokens.vl",
  "emit_start_block.vl", "emit_struct_order.vl", "emit_ty_canon.vl",
  "emit_union_atoms.vl", "emit_union_casts.vl", "emit_union_registry.vl",
  // The checker's loop-exit log: it feeds the box record the emitter reads (`boxExitsStamp`).
  "check_if_value.vl",
  "emit_value_sites.vl", "emit_variant_sig.vl",
]

// `emitProgram`'s prologue and the `*Reset` helpers it calls there: state cleared in one of
// these is clean before any pass of the next program runs. Each stands also for what it
// calls unconditionally (`closureOf`), so a helper a listed reset calls needs no entry here.
const PROLOGUE = [
  "emitProgram", "emitModule", "compileSrc", "checkSrc", "checkSrcSym",
  "srcReset", "modReset", "resetLitAtoms", "repReset", "msPoolReset",
  "resetRetMapFlight", "resetParentLetCache", "sidResetParentLet",
  "sidResetStartBlockLet", "hcReset", "sidKeyedTablesReset", "structTyIxReset",
  "structNameIxReset", "sioMemoReset", "shapeSetIxReset", "cliArgReset",
  "lintReset", "sidReset", "tsReset", "ufcsAliasReset", "dgLosslessReset",
  "covarWriteReset", "repSlotCacheSync", "rtSync", "repShadowSweep",
  "memoCompileReset", "tyRegMemoReset", "emitStateReset", "wasmEmitStateReset",
  "bcReset", "bignumReset", "capMemoEditsReset", "declStructIndexReset",
  "dslReset", "dupIndexReset", "iisReset", "mvShapeNestReset", "printPlanReset",
  "rewriteCountersReset", "shapeRowsReset", "tailSelfFnReset", "monoStateReset",
  "classifyStateReset", "emitProgramReset", "ifValueReset",
]

// `emitProgram`'s ordered pass table (`runEmitPass`): once per compile, but after the
// prologue, so a pass-cleared column is stale for anything an earlier pass reads.
const PASS = [
  "collectTyParamNames", "collectU", "collectS", "collectA", "collectFns",
  "passCheckTopLevel", "buildFnMap", "recordedVoidFns", "dispatchRewrite",
  "captureBoxRewrite", "scanArrLitCommit", "monomorphize",
  "collectGenAliasShapes", "collectAnnShapes", "synthVoidTwins",
  "synthExternValues", "collectMapFilterUse", "collectFnValUse",
  "collectCloSigs", "scanPrintUse", "capCacheBuild", "collectInlineUnions",
  "computeGlobalPromotion", "mAssignTypeIndices", "collectStartLocals",
  "gaeCollectDecls", "emitGlobalSection",
]

// Reviewed `let`s outside the emitter that no reset clears and no shape rule (`letShape`)
// proves. Each list's entries must be otherwise NEVER, or the audit stops, so none goes stale.
// `name:guard`: a memo key compared with a rising generation or a validity flag that is reset;
// the guard must appear in a function of the key's module that names the key.
const LSTAMPED = [
  // `memberMoves` and `arenaEpoch` only rise.
  "cwIxMMoves:memberMovesNow", "elabDlvMemoEpoch:arenaEpochNow",
  "elabReadIxEpoch:arenaEpochNow", "elabReadIxLen:elabReadIxEpoch",
  // `shMemoStampSame` compares all five; `tyMutEpoch` advances at every checker init.
  "shMemoEpoch:tyMutEpoch", "shMemoArena:tys", "shMemoDecl:substNestDecl",
  "shMemoMode:substNestMode", "shMemoQuiet:inferQuiet",
  // driver: `vcDiagMemoReset` clears `vcDiagsBufValid` and `vcDiagMsgBufI`.
  "vcDiagsBuf:vcDiagsBufValid", "vcDiagMsgBuf:vcDiagMsgBufI",
  // lint: the scan slot is reused only while `siScSrc[slot]` is this source.
  "siScratchSlot:siScanLines",
]

// Call-scoped: written in the same call before every read (a result register a caller reads
// after a `true`, a budget or cursor set just before the walk that spends it, a Begin/End pair).
const LSCOPED = [
  "canonTwinText", "cwLexMet", "ftCheckLen", "imBtV", "imC", "imD",
  "jwArrSpell", "jwMapSpell", "jwRecvTy", "mvValid", "nlDefaultAnn", "nlFnBind",
  "nlFnDecl", "nlFnLits", "nlFnName", "nlFnTy", "nlFnWant", "nlLeafWant",
  "nluAtoms", "ownLen", "pgrBudget", "sBase", "sDepth", "sK", "sReach",
  "sSegLo", "skPlainDecl", "stepMoves", "urcName", "wiRowsWhy",
  "monoRecheckDepth", "cuTy",
]

// Live across programs by design: `T`, whose fields `initChecker` resets; the CLI's parsed
// options; `tyWideUnionMinted`, only ever set, a gate that can only enable work; and the
// watch server's ownership of the interface hash.
const LINSTANCE = [
  "T", "cliBudget", "cliBudgetAct", "cliBudgetFindings", "cliBudgetPath",
  "tyWideUnionMinted", "wiOwnsIh",
]

// The two per-function frame builders; each stands for itself plus the same-module helpers
// it calls, which are walked rather than listed so a split of a builder is followed.
const FRAME_ROOTS = ["emitFuncCode", "emitStartFnCode"]

// The driver functions whose own unconditional calls are prologue too, beside PROLOGUE.
const DRIVERS = ["runEmitPasses", "emitProgramRun"]

// The pass dispatcher: every `return NAME(` in its body is a pass, added to PASS.
const PASS_DISPATCH = "runEmitPass"

// Index-shaped registers that are cleared only inside some inner function and are still safe
// across programs, each with the guard that makes them so: a memo key the row's module asks a
// `memo*Moved` call about (`memoCompileReset` moves every key, so the first ask of a compile
// rebuilds), or `length` (rebuilt whenever a table's length differs from it, and that table is
// emptied per program). Resetting one of these instead could let a stale stamp match. A guard
// the audit cannot find in the row's module, or a name no longer such a row, stops the audit.
const GUARDED = [
  "fdnLen:fdnGenKey", "fnPosFsLen:fnPosLenKey", "fnPosMoLen:fnPosLenKey",
  "gckGen:gckGenKey", "rasGen:rasGenKey", "ucIxUpTo:ucIxKey", "uovUpTo:uovKey",
]

// One module-scope mutable. A name declared twice keeps its first slot and its last
// declaration, as the Python original's dict did.
type Decl = { name: string, file: string, line: i32, init: string }

// One `function` span, 1-based and inclusive.
type Span = { name: string, a: i32, b: i32 }

// One compiler source: its lines (split on "\n", a trailing empty piece kept), its spans,
// and the enclosing function of each line ("<module>" outside every span).
type Src = { file: string, lines: string[], spans: Span[], lineFn: string[] }

function isIdStart(b: i32): boolean {
  (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95
}

function isIdChar(b: i32): boolean { isIdStart(b) || (b >= 48 && b <= 57) }

// Python's `\s` over ASCII.
function isSp(b: i32): boolean { b == 32 || (b >= 9 && b <= 13) }

function strLess(a: string, b: string): boolean { a < b }

function inList(xs: readonly string[], x: string): boolean {
  for y in xs {
    if y == x { return true }
  }
  false
}

// The identifier starting at `i`, or "" when none starts there.
function identAt(s: string, i: i32): string {
  if i >= s.length || !isIdStart(s[i]) { return "" }
  let j = i + 1
  while j < s.length && isIdChar(s[j]) { j = j + 1 }
  s.slice(i, j)
}

// A `memoKeyNew(…)` or `memoGenNew(…)` init: registered with, and reset by, `memoCompileReset`.
function isMemoInit(init: string): boolean {
  startsWith(init, "memoKeyNew(") || startsWith(init, "memoGenNew(")
}

// `^(export )?let NAME [: TYPE] = INIT [// …]`, the declaration shape; null when `ln` is not
// one. The type runs to the first `=`, and the init is cut at its first `//`. A `const` whose
// init is a memo key or generation counts too: its binding is fixed, its contents are not.
function declOf(ln: string, file: string, line: i32): Decl | null {
  let i = 0
  if startsWith(ln, "export ") { i = 7 }
  const isConst = startsWith(ln.slice(i, ln.length), "const ")
  if !isConst && !startsWith(ln.slice(i, ln.length), "let ") { return null }
  if isConst { i = i + 6 } else { i = i + 4 }
  const name = identAt(ln, i)
  if name.length == 0 { return null }
  i = i + name.length
  while i < ln.length && isSp(ln[i]) { i = i + 1 }
  if i < ln.length && ln[i] == 58 {
    i = i + 1
    while i < ln.length && isSp(ln[i]) { i = i + 1 }
    const t0 = i
    while i < ln.length && ln[i] != 61 { i = i + 1 }
    if i == t0 || i >= ln.length { return null }
  }
  if i >= ln.length || ln[i] != 61 { return null }
  let rest = ln.slice(i + 1, ln.length)
  const cut = rest.indexOf("//")
  if cut >= 0 { rest = rest.slice(0, cut) }
  if isConst && !isMemoInit(stripWs(rest)) { return null }
  { name: name, file: file, line: line, init: stripWs(rest) }
}

function readSrc(path: string): string {
  const t = readTextFile(path)
  if t is IoError {
    die("emitter-state-audit: cannot read \{path} (\{t.msg})", 1)
    return ""
  }
  t
}

// Every `function` span of `lines`: a span ends at a line that is exactly `}` or just
// before the next `function` header.
function spansOf(lines: string[]): Span[] {
  const out: Span[] = []
  let cur = ""
  let start = 0
  let i = 0
  while i < lines.length {
    const ln = lines[i]
    let h = 0
    if startsWith(ln, "export ") { h = 7 }
    let name = ""
    if startsWith(ln.slice(h, ln.length), "function ") {
      name = identAt(ln, h + 9)
    }
    if name.length > 0 {
      if cur.length > 0 { out.push({ name: cur, a: start, b: i }) }
      cur = name
      start = i + 1
    } else if ln == "}" && cur.length > 0 {
      out.push({ name: cur, a: start, b: i + 1 })
      cur = ""
    }
    i = i + 1
  }
  if cur.length > 0 { out.push({ name: cur, a: start, b: lines.length }) }
  out
}

function loadSrc(file: string): Src {
  const lines = split(readSrc(cdir + "/" + file), "\n")
  const spans = spansOf(lines)
  const lineFn: string[] = []
  let i = 0
  while i <= lines.length {
    lineFn.push("<module>")
    i = i + 1
  }
  for sp in spans {
    let k = sp.a
    while k <= sp.b {
      if lineFn[k] == "<module>" { lineFn[k] = sp.name }
      k = k + 1
    }
  }
  { file: file, lines: lines, spans: spans, lineFn: lineFn }
}

// `root` plus the functions it calls that its own module declares: one level deep, since a
// builder split into helpers keeps them beside itself. Empty when no module declares it.
function frameSide(root: string, srcs: Src[]): string[] {
  for s in srcs {
    const own = Map<string, boolean>()
    for sp in s.spans { own[sp.name] = true }
    if own[root] == null { continue }
    const side: string[] = [root]
    for sp in s.spans {
      if sp.name != root { continue }
      const body = join(s.lines.slice(sp.a, sp.b), "\n")
      let i = 0
      while i < body.length {
        if !isIdChar(body[i]) {
          i = i + 1
          continue
        }
        let j = i
        while j < body.length && isIdChar(body[j]) { j = j + 1 }
        const before = i == 0 || body[i - 1] != 46
        if before && isIdStart(body[i]) {
          let k = j
          while k < body.length && isSp(body[k]) { k = k + 1 }
          if k < body.length && body[k] == 40 {
            const callee = body.slice(i, j)
            if own[callee] != null && !inList(side, callee) {
              side.push(callee)
            }
          }
        }
        i = j
      }
    }
    return side
  }
  []
}

// Whether `s` holds the word `w`, bounded by non-identifier characters.
function hasWord(s: string, w: string): boolean {
  let at = s.indexOf(w)
  while at >= 0 {
    const okL = at == 0 || !isIdChar(s[at - 1])
    const e = at + w.length
    if okL && (e >= s.length || !isIdChar(s[e])) { return true }
    at = findFrom(s, w, at + 1)
  }
  false
}

// The callee a top-level line of a function body calls unconditionally, or "": `  f(…`,
// `  const x = f(…`, `  let x: T = f(…`, and the failure idiom `  if f(…) < 0 { return …`.
function topCallee(ln: string): string {
  if ln.length < 3 || ln[0] != 32 || ln[1] != 32 || !isIdStart(ln[2]) {
    return ""
  }
  let i = 2
  if startsWith(ln, "  const ") || startsWith(ln, "  let ") {
    const eq = ln.indexOf("=")
    if eq < 0 || (eq + 1 < ln.length && ln[eq + 1] == 61) { return "" }
    i = eq + 1
    while i < ln.length && isSp(ln[i]) { i = i + 1 }
  } else if startsWith(ln, "  if ") {
    if ln.indexOf(") < 0 { return") < 0 { return "" }
    i = 5
  }
  const id = identAt(ln, i)
  const j = i + id.length
  if id.length == 0 || j >= ln.length || ln[j] != 40 { return "" }
  id
}

// Whether a body line ends the unconditional prefix: a top-level `return`, a top-level `if`
// that returns other than by the failure idiom, or a `return` in any nested block.
function endsPrefix(ln: string): boolean {
  if !hasWord(ln, "return") { return false }
  if startsWith(ln, "   ") { return true }
  if startsWith(ln, "  if ") { return ln.indexOf(") < 0 { return") < 0 }
  true
}

// `roots` and every function they reach through `topCallee` lines before `endsPrefix`: the
// functions that run, start to finish of that prefix, whenever a root does.
function closureOf(roots: readonly string[], srcs: Src[]): string[] {
  const fsrc = Map<string, i32>()
  const fspan = Map<string, i32>()
  let si = 0
  while si < srcs.length {
    let pi = 0
    while pi < srcs[si].spans.length {
      const nm = srcs[si].spans[pi].name
      if fsrc[nm] == null {
        fsrc[nm] = si
        fspan[nm] = pi
      }
      pi = pi + 1
    }
    si = si + 1
  }
  const seen: string[] = []
  const on = Map<string, boolean>()
  for r in roots {
    if on[r] == null {
      on[r] = true
      seen.push(r)
    }
  }
  let w = 0
  while w < seen.length {
    const fn = seen[w]
    w = w + 1
    const s = fsrc[fn]
    const p = fspan[fn]
    if s == null || p == null { continue }
    const src = srcs[s]
    const sp = src.spans[p]
    let k = sp.a
    while k < sp.b && k < src.lines.length {
      let ln = src.lines[k]
      const cut = ln.indexOf("//")
      if cut >= 0 { ln = ln.slice(0, cut) }
      if endsPrefix(ln) { break }
      const c = topCallee(ln)
      if c.length > 0 && on[c] == null && fsrc[c] != null {
        on[c] = true
        seen.push(c)
      }
      k = k + 1
    }
  }
  seen
}

// PASS plus every pass `PASS_DISPATCH` returns into.
function passRoots(srcs: Src[]): string[] {
  const out: string[] = []
  for p in PASS { out.push(p) }
  for s in srcs {
    for sp in s.spans {
      if sp.name != PASS_DISPATCH { continue }
      let k = sp.a
      while k < sp.b && k < s.lines.length {
        const ln = s.lines[k]
        let at = ln.indexOf("return ")
        while at >= 0 {
          const id = identAt(ln, at + 7)
          const e = at + 7 + id.length
          if id.length > 0 && e < ln.length && ln[e] == 40 && id != "emitFail" {
            addUnique(out, id)
          }
          at = findFrom(ln, "return ", at + 1)
        }
        k = k + 1
      }
    }
  }
  out
}

// An integer-literal init: `N`, `-N` or `0 - N`; `neg` asks for a negative one.
function intInit(init: string, neg: boolean): boolean {
  let i = 0
  let isNeg = false
  if startsWith(init, "0 - ") {
    i = 4
    isNeg = true
  } else if startsWith(init, "-") {
    i = 1
    isNeg = true
  }
  if i >= init.length { return false }
  while i < init.length {
    if init[i] < 48 || init[i] > 57 { return false }
    i = i + 1
  }
  !neg || isNeg
}

// The last non-space byte of `s` before `i`, or -1.
function prevByte(s: string, i: i32): i32 {
  let k = i - 1
  while k >= 0 && isSp(s[k]) { k = k - 1 }
  if k < 0 { return -1 }
  s[k]
}

// The index of the first non-space byte of `s` at or after `j`.
function nextAt(s: string, j: i32): i32 {
  let k = j
  while k < s.length && isSp(s[k]) { k = k + 1 }
  k
}

// Whether the occurrence of a name at `[i, j)` of `ln` reads it as an id: an index
// (`[NAME]`, `nodeAt(NAME)`, `tyAt(NAME)`) or an `==`/`!=` against a non-literal operand.
function idUseAt(ln: string, i: i32, j: i32): boolean {
  const pb = prevByte(ln, i)
  const n = nextAt(ln, j)
  let nb = -1
  if n < ln.length { nb = ln[n] }
  if pb == 91 && nb == 93 { return true }
  if pb == 40 && nb == 41 {
    let k = i - 1
    while k >= 0 && isSp(ln[k]) { k = k - 1 }
    const e = k
    while k > 0 && isIdChar(ln[k - 1]) { k = k - 1 }
    const callee = ln.slice(k, e)
    if callee == "nodeAt" || callee == "tyAt" { return true }
  }
  if n + 1 < ln.length && (ln[n] == 61 || ln[n] == 33) && ln[n + 1] == 61 {
    const o = nextAt(ln, n + 2)
    if o < ln.length && (isIdStart(ln[o]) || ln[o] == 40) { return true }
  }
  let k = i - 1
  while k >= 0 && isSp(ln[k]) { k = k - 1 }
  if k >= 1 && ln[k] == 61 && (ln[k - 1] == 61 || ln[k - 1] == 33) {
    const b = prevByte(ln, k - 1)
    if b >= 0 && (isIdChar(b) || b == 41 || b == 93) { return true }
  }
  false
}

// For each declaration, whether some line of `srcs` reads it as an id (`idUseAt`). Only the
// rows `want` marks are looked for.
function idReadRows(
  srcs: Src[],
  ixOf: Map<string, i32>,
  want: boolean[],
): boolean[] {
  const out: boolean[] = []
  for _w in want { out.push(false) }
  for s in srcs {
    for raw in s.lines {
      if startsWith(lstripWs(raw), "//") || declLead(raw) { continue }
      let ln = raw
      const cut = ln.indexOf("//")
      if cut >= 0 { ln = ln.slice(0, cut) }
      let i = 0
      while i < ln.length {
        if !isIdChar(ln[i]) {
          i = i + 1
          continue
        }
        let j = i
        while j < ln.length && isIdChar(ln[j]) { j = j + 1 }
        if isIdStart(ln[i]) && (i == 0 || ln[i - 1] != 46) {
          const ix = ixOf[ln.slice(i, j)]
          if ix != null && want[ix] && !out[ix] && idUseAt(ln, i, j) {
            out[ix] = true
          }
        }
        i = j
      }
    }
  }
  out
}

// Whether `guard` holds for the declaration `d` (see GUARDED).
function guardHolds(
  d: Decl,
  guard: string,
  srcs: Src[],
  decls: Decl[],
): boolean {
  let src = srcs[0]
  for s in srcs {
    if s.file == d.file { src = s }
  }
  if guard == "length" {
    for ln in src.lines {
      if ln.indexOf(d.name + " != ") >= 0 && ln.indexOf(".length") >= 0 {
        return true
      }
    }
    return false
  }
  let isKey = false
  for k in decls {
    if k.name == guard && isMemoInit(k.init) { isKey = true }
  }
  if !isKey { return false }
  for ln in src.lines {
    if ln.indexOf("Moved") < 0 { continue }
    if (
      ln.indexOf("(" + guard + ",") >= 0
      || ln.indexOf("(" + guard + ")") >= 0
    ) {
      return true
    }
  }
  false
}

// For each 0-based line of `s`: 2 for a top-level statement of its function's unconditional
// prefix (`endsPrefix`), which runs whenever the function does; 1 for a top-level statement
// after that prefix, which runs whenever the call gets that far; 0 otherwise.
function prefixLines(s: Src): i32[] {
  const out: i32[] = []
  for _l in s.lines { out.push(0) }
  for sp in s.spans {
    let level = 2
    let k = sp.a
    while k < sp.b && k < s.lines.length {
      let ln = s.lines[k]
      const cut = ln.indexOf("//")
      if cut >= 0 { ln = ln.slice(0, cut) }
      if endsPrefix(ln) { level = 1 }
      if ln.length > 2 && ln[0] == 32 && ln[1] == 32 && isIdStart(ln[2]) {
        out[k] = level
      }
      k = k + 1
    }
  }
  out
}

// A one-line setter `function S(p: T) { NAME = p }` writes NAME on another module's behalf, so
// each call `S(arg)` is a write of NAME in the CALLER, graded as `writesIn` grades `NAME = arg`.
function setterWrites(
  srcs: Src[],
  lx: Map<string, i32>,
  decls: Decl[],
  out: Write[],
): Map<string, i32> {
  const target = Map<string, i32>()
  for s in srcs {
    for sp in s.spans {
      if sp.a < 1 { continue }
      const h = rstripLine(s.lines[sp.a - 1])
      const ps = paramsOf(s.lines, sp.a - 1)
      if ps.length != 1 || !endsWith(h, " }") { continue }
      const ob = h.lastIndexOf("{ ")
      if ob < 0 { continue }
      const body = h.slice(ob + 2, h.length - 2)
      const eq = body.indexOf(" = ")
      if eq < 0 || body.slice(eq + 3, body.length) != ps[0] { continue }
      const ix = lx[s.file + ":" + body.slice(0, eq)]
      if ix != null { target[sp.name] = ix }
    }
  }
  let si = -1
  for s in srcs {
    si = si + 1
    const tops = prefixLines(s)
    let i = 0
    while i < s.lines.length {
      let ln = s.lines[i]
      const cut = ln.indexOf("//")
      if cut >= 0 { ln = ln.slice(0, cut) }
      if (
        startsWith(lstripWs(ln), "export function ")
        || startsWith(lstripWs(ln), "function ")
      ) {
        i = i + 1
        continue
      }
      let a = 0
      while a < ln.length {
        if (
          !isIdStart(ln[a])
          || (a > 0 && (isIdChar(ln[a - 1]) || ln[a - 1] == 46))
        ) {
          a = a + 1
          continue
        }
        const id = identAt(ln, a)
        const e = a + id.length
        const ix = target[id]
        if ix != null && e < ln.length && ln[e] == 40 {
          let d = 1
          let t = e + 1
          while t < ln.length && d > 0 {
            if ln[t] == 40 || ln[t] == 91 || ln[t] == 123 { d = d + 1 }
            if ln[t] == 41 || ln[t] == 93 || ln[t] == 125 { d = d - 1 }
            t = t + 1
          }
          const arg = stripWs(ln.slice(e + 1, t - 1))
          const set = tops[i] > 0 && a == 2 && !hasWord(arg, decls[ix].name)
          const clear = (set && tops[i] == 2) || arg == decls[ix].init
          const fn = s.lineFn[i + 1]
          out.push(
            {
              ix: ix,
              fn: fn,
              clear: clear,
              late: set && !clear,
              rhs: arg,
              src: si,
              line: i,
            },
          )
        }
        a = e
      }
      i = i + 1
    }
  }
  target
}

function entryName(e: string): string { split(e, ":")[0] }

// The reviewed class of a `let`, or "NEVER" when no list names it.
function reviewedKind(name: string): string {
  for e in LSTAMPED {
    if entryName(e) == name { return "stamped" }
  }
  if inList(LSCOPED, name) { return "scoped" }
  if inList(LINSTANCE, name) { return "linstance" }
  "NEVER"
}

// Stops the audit on a reviewed entry naming no declaration, one a rule already covers, or a
// stamp whose guard no function of the key's module names beside the key.
function checkReviewed(
  decls: Decl[],
  kinds: string[],
  ixOf: Map<string, i32>,
  srcs: Src[],
) {
  const all: string[] = []
  for e in LSTAMPED { all.push(e) }
  for e in LSCOPED { all.push(e) }
  for e in LINSTANCE { all.push(e) }
  for e in all {
    const nm = entryName(e)
    const ix = ixOf[nm]
    if ix == null {
      die("a reviewed let list names no compiler declaration: " + nm, 2)
      return 0
    }
    const k = kinds[ix]
    if k != "stamped" && k != "scoped" && k != "linstance" {
      die(
        "a reviewed let list names a let a rule already covers (\{k}): " + nm,
        2,
      )
    }
    const parts = split(e, ":")
    if parts.length == 2 {
      let held = false
      for s in srcs {
        if s.file != decls[ix].file { continue }
        for sp in s.spans {
          let key = false
          let guard = false
          let li = sp.a
          while li < sp.b && li < s.lines.length {
            const t = codeOf(s.lines[li])
            if hasWord(t, nm) { key = true }
            if hasWord(t, parts[1]) { guard = true }
            li = li + 1
          }
          if key && guard { held = true }
        }
      }
      if !held {
        die(
          "LSTAMPED \{nm}: no function of compiler/\{decls[ix].file} names \{parts[1]}",
          2,
        )
      }
    }
  }
  0
}

// Whether no `return`, `break` or `continue` stands in `s` strictly between 0-based lines `a`, `b`.
function noExitBetween(s: Src, a: i32, b: i32): boolean {
  let k = a + 1
  while k < b {
    const t = codeOf(s.lines[k])
    if hasWord(t, "return") || hasWord(t, "break") || hasWord(t, "continue") {
      return false
    }
    k = k + 1
  }
  true
}

// Whether function `fn` of `s` binds a local to the variable's value: `const W = NAME`
// (or `let`); the local names returned, empty when none.
function savesOf(s: Src, fn: string, name: string): string[] {
  const out: string[] = []
  for sp in s.spans {
    if sp.name != fn { continue }
    let k = sp.a
    while k < sp.b && k < s.lines.length {
      const t = stripWs(codeOf(s.lines[k]))
      let i = -1
      if startsWith(t, "const ") { i = 6 }
      else if startsWith(t, "let ") { i = 4 }
      if i > 0 {
        const w = identAt(t, i)
        const e = t.indexOf(" = ")
        if w.length > 0 && e > 0 && stripWs(t.slice(e + 3, t.length)) == name {
          out.push(w)
        }
      }
      k = k + 1
    }
  }
  out
}

// The safe shape of a `let` no reset clears, or "NEVER": `init` (written only at module
// scope), `rises` (every write `g = g + 1`: a generation, never equal to a stamp from an
// earlier program), `balanced` (every write `d = d + 1` or `d = d - 1`, each rise undone in its
// own function with no exit between) or `restored` (every writing function saves the value to
// a local first and writes that local back).
function letShape(
  ix: i32,
  name: string,
  ws: Write[],
  srcs: Src[],
  setters: Map<string, i32>,
): string {
  // A setter's own `NAME = p` is accounted at its call sites.
  const mine: Write[] = []
  for w in ws {
    if w.ix == ix && setters[w.fn] != ix { mine.push(w) }
  }
  let onlyModule = true
  let allRise = true
  let allStep = true
  for w in mine {
    if w.fn != "<module>" { onlyModule = false }
    if w.rhs != name + " + 1" { allRise = false }
    if w.rhs != name + " + 1" && w.rhs != name + " - 1" { allStep = false }
  }
  if onlyModule { return "init" }
  if allRise { return "rises" }
  if allStep {
    let ok = true
    for w in mine {
      if w.rhs != name + " + 1" { continue }
      let fall = -1
      for x in mine {
        if (
          x.src == w.src
          && x.fn == w.fn
          && x.rhs == name + " - 1"
          && x.line > w.line
        ) {
          if fall < 0 || x.line < fall { fall = x.line }
        }
      }
      if fall < 0 || !noExitBetween(srcs[w.src], w.line, fall) { ok = false }
    }
    if ok { return "balanced" }
  }
  let restored = true
  for w in mine {
    const saves = savesOf(srcs[w.src], w.fn, name)
    let back = false
    for x in mine {
      if x.src == w.src && x.fn == w.fn && inList(saves, x.rhs) { back = true }
    }
    if !back { restored = false }
  }
  if restored { return "restored" }
  "NEVER"
}

// The `let` a name written in module `file` denotes: the module's own, else an export of it.
function letIxIn(lx: Map<string, i32>, file: string, name: string): i32 | null {
  const own = lx[file + ":" + name]
  if own != null { return own }
  lx[":" + name]
}

// One assignment the scan found: which declaration, which function, and whether it clears.
// `late`: a top-level overwrite after the function's first exit, a home that counts only as
// `inner` (shown as `~fn`).
type Write = {
  ix: i32,
  fn: string,
  clear: boolean,
  late: boolean,
  rhs: string,
  src: i32,
  line: i32,
}

// Every `NAME = RHS` in `text` (a line with its comment cut) whose NAME is declared: NAME not
// preceded by an identifier character or `.`, `=` not followed by `=`, and RHS running to the
// first `}` or the end of the line.
function writesIn(
  text: string,
  lx: Map<string, i32>,
  file: string,
  decls: Decl[],
  fn: string,
  top: i32,
  si: i32,
  line: i32,
  out: Write[],
) {
  let i = 0
  while i < text.length {
    if !isIdChar(text[i]) {
      i = i + 1
      continue
    }
    let j = i
    while j < text.length && isIdChar(text[j]) { j = j + 1 }
    const before = i == 0 || text[i - 1] != 46
    let next = j
    if before && isIdStart(text[i]) {
      const ix = letIxIn(lx, file, text.slice(i, j))
      if ix != null {
        let k = j
        while k < text.length && isSp(text[k]) { k = k + 1 }
        const eq = k < text.length && text[k] == 61
        if eq && !(k + 1 < text.length && text[k + 1] == 61) {
          k = k + 1
          while k < text.length && isSp(text[k]) { k = k + 1 }
          if k < text.length {
            let t = k + 1
            while t < text.length && text[t] != 125 { t = t + 1 }
            let rhs = stripWs(text.slice(k, t))
            let e = rhs.length
            while e > 0 && rhs[e - 1] == 125 { e = e - 1 }
            rhs = stripWs(rhs.slice(0, e))
            // An unconditional overwrite that does not read the old value re-establishes it.
            const set = top > 0 && i == 2 && !hasWord(rhs, decls[ix].name)
            const clear = (set && top == 2) || rhs == decls[ix].init
            out.push(
              {
                ix: ix,
                fn: fn,
                clear: clear,
                late: set && !clear,
                rhs: rhs,
                src: si,
                line: line,
              },
            )
            next = t + 1
          }
        }
      }
    }
    i = next
  }
  0
}

// The compiler's sources, sorted by name.
function compilerFiles(): string[] {
  const ents = listDir(cdir)
  if ents is IoError {
    die("emitter-state-audit: cannot list \{cdir} (\{ents.msg})", 1)
    return []
  }
  const out: string[] = []
  for e in ents {
    if endsWith(e, ".vl") { out.push(e) }
  }
  sort(out, strLess)
  out
}

// The whole audit's result, for the report and the ratchet alike.
type Audit = {
  decls: Decl[],
  kinds: string[],
  homes: string[][],
  writes: i32[],
  assigned: string[][],
  sides: string[][],
  index: boolean[],
  guards: string[],
  cont: CAudit,
}

function addUnique(xs: string[], x: string) {
  if !inList(xs, x) { xs.push(x) }
  0
}

// `without` names one function whose clears are not counted ("" for none): the check's control.
function audit(without: string): Audit {
  const files = compilerFiles()
  const srcs: Src[] = []
  for f in files { srcs.push(loadSrc(f)) }

  const decls: Decl[] = []
  // `ixOf`: a name's first declaration, for the lists; `lx`: how a write resolves (`letIxIn`).
  const ixOf = Map<string, i32>()
  const lx = Map<string, i32>()
  for f in files {
    let s = srcs[0]
    for x in srcs {
      if x.file == f { s = x }
    }
    // The Python original iterated the file's lines, so a trailing empty piece is no line.
    let n = s.lines.length
    if n > 0 && s.lines[n - 1].length == 0 { n = n - 1 }
    let i = 0
    while i < n {
      const d = declOf(s.lines[i], f, i + 1)
      if d != null {
        const at = lx[f + ":" + d.name]
        if at != null {
          decls[at] = d
        } else {
          if ixOf[d.name] == null { ixOf[d.name] = decls.length }
          lx[f + ":" + d.name] = decls.length
          if startsWith(s.lines[i], "export ") {
            lx[":" + d.name] = decls.length
          }
          decls.push(d)
        }
      }
      i = i + 1
    }
  }

  const sides: string[][] = []
  for r in FRAME_ROOTS {
    const side = frameSide(r, srcs)
    if side.length == 0 {
      die(
        "no compiler/*.vl function declares: "
          + r
          + "\nthe frame-builder anchors moved; re-point FRAME_ROOTS.",
        2,
      )
    }
    sides.push(side)
  }

  const ws: Write[] = []
  let wsi = -1
  for s in srcs {
    wsi = wsi + 1
    const tops = prefixLines(s)
    let n = s.lines.length
    if n > 0 && s.lines[n - 1].length == 0 { n = n - 1 }
    let i = 0
    while i < n {
      const ln = s.lines[i]
      const lead = lstripWs(ln)
      if !startsWith(lead, "//") && !declLead(ln) {
        let text = ln
        const cut = text.indexOf("//")
        if cut >= 0 { text = text.slice(0, cut) }
        writesIn(text, lx, s.file, decls, s.lineFn[i + 1], tops[i], wsi, i, ws)
      }
      i = i + 1
    }
  }

  const setters = setterWrites(srcs, lx, decls, ws)

  const writes: i32[] = []
  const homes: string[][] = []
  const assigned: string[][] = []
  for _d in decls {
    writes.push(0)
    homes.push([])
    assigned.push([])
  }
  for w in ws {
    writes[w.ix] = writes[w.ix] + 1
    addUnique(assigned[w.ix], w.fn)
    if w.clear && w.fn != without { addUnique(homes[w.ix], w.fn) }
    if w.late && w.fn != without { addUnique(homes[w.ix], "~" + w.fn) }
  }
  // Memo keys and generations are registered, and `memoCompileReset` resets them all.
  let di = 0
  while di < decls.length {
    if isMemoInit(decls[di].init) { addUnique(homes[di], "memoCompileReset") }
    di = di + 1
  }

  const frame: string[] = []
  for side in sides {
    for x in side { addUnique(frame, x) }
  }
  const proRoots: string[] = []
  for p in PROLOGUE { proRoots.push(p) }
  for p in DRIVERS { proRoots.push(p) }
  const prologue = closureOf(proRoots, srcs)
  const pass = closureOf(passRoots(srcs), srcs)
  const kinds: string[] = []
  let k = 0
  while k < decls.length {
    const h = homes[k]
    sort(h, strLess)
    let kind = "NEVER"
    if h.length > 0 { kind = "inner" }
    if anyIn(h, frame) { kind = "frame" }
    if anyIn(h, pass) { kind = "pass" }
    if anyIn(h, prologue) { kind = "prologue" }
    if kind == "NEVER" { kind = letShape(k, decls[k].name, ws, srcs, setters) }
    if kind == "NEVER" { kind = reviewedKind(decls[k].name) }
    kinds.push(kind)
    k = k + 1
  }
  checkReviewed(decls, kinds, ixOf, srcs)
  const letHomes = Map<string, string[]>()
  const letKinds = Map<string, string>()
  k = 0
  while k < decls.length {
    letHomes[decls[k].file + ":" + decls[k].name] = homes[k]
    letKinds[decls[k].file + ":" + decls[k].name] = kinds[k]
    k = k + 1
  }
  // An index-shaped register: an inner integer whose init is negative or that some line reads
  // as an id. Nothing per program puts it back, so a stale id names the next program's node.
  const intRow: boolean[] = []
  k = 0
  while k < decls.length {
    const emitMod = inList(EMIT, decls[k].file)
    intRow.push(emitMod && kinds[k] == "inner" && intInit(decls[k].init, false))
    k = k + 1
  }
  const idRead = idReadRows(srcs, ixOf, intRow)
  const index: boolean[] = []
  const guards: string[] = []
  k = 0
  while k < decls.length {
    index.push(intRow[k] && (intInit(decls[k].init, true) || idRead[k]))
    guards.push("")
    k = k + 1
  }
  for g in GUARDED {
    const parts = split(g, ":")
    const gi = ixOf[parts[0]]
    if gi == null {
      die("GUARDED names no emitter declaration: " + parts[0], 2)
      continue
    }
    if !index[gi] {
      die("GUARDED names no inner index-shaped register: " + parts[0], 2)
    }
    if !guardHolds(decls[gi], parts[1], srcs, decls) {
      const d = decls[gi]
      die("GUARDED \{parts[0]}: no \{parts[1]} guard in compiler/\{d.file}", 2)
    }
    guards[gi] = parts[1]
  }
  {
    decls: decls,
    kinds: kinds,
    homes: homes,
    writes: writes,
    assigned: assigned,
    sides: sides,
    index: index,
    guards: guards,
    cont: contAudit(srcs, without, prologue, pass, frame, letHomes, letKinds),
  }
}

// A written module `const` list, map or set has a lifetime like a `let` (#6759); these are read
// from every compiler module. Safe: emptied by a function (its home's kind), written only at
// module scope (`init`), every push popped in its own function with no exit between
// (`balanced`), or named below. Anything else is NEVER, and `--check` refuses it.

// `container:guard`: a `memoGenNew` generation, a `let` only ever bumped by one, or a STAMPED
// companion in the same module. The guard must be compared in the container's module or on a
// line naming the container; a stale or unprovable entry stops the audit.
const STAMPED = [
  // check_types: `tyMutEpoch` advances at every program's checker init and every in-place pin.
  "hhStamp:tyMutEpoch", "hhTrueAt:hhStamp", "hhFalseAt:hhStamp",
  "tdStamp:tyMutEpoch", "tdHeight:tdStamp",
  "emitNameMemoGen:emitNameGen", "emitNameMemoVal:emitNameMemoGen",
  "tyHasTyVarFreeEpoch:tyMutEpoch", "tyHasTyVarFreeGen:tyHasTyVarFreeEpoch",
  // emit_classify / emit_list_rep: per-compile memo generations.
  "mvrStamp:mvrGen", "mvrFn:mvrStamp", "mvrVal:mvrStamp",
  "rkMemoGen:rkGen", "rkMemoPass:rkMemoGen", "rkMemoReg:rkMemoGen", "rkMemoKind:rkMemoGen",
  "rkMemoNul:rkMemoGen",
  "rrStamp:rrGen", "rrFn:rrStamp", "rrVal:rrStamp",
  "rtvStamp:rtvGen", "rtvFn:rtvStamp", "rtvVal:rtvStamp", "rtvRaw:rtvStamp",
  "rtvDeclRaw:rtvStamp",
  "rvsAnsAt:rvsAnsGen", "rvsAnsRow:rvsAnsAt",
  "fnPosFsStamp:fnPosEpoch", "fnPosFs:fnPosFsStamp", "fnPosMoStamp:fnPosEpoch",
  "fnPosMo:fnPosMoStamp",
  // opt_multivalue: `foGen` advances at every function the pass scans.
  "foCand:foGen", "foSeen:foCand", "foChk:foCand", "foBad:foCand", "candN:foCand",
  "candT:foCand", "live:foCand",
]

// Reviewed: stacks, trails, logs and scratch a program leaves nothing in that a later one
// reads. Each group says what holds it.
const SCOPED = [
  // enter/leave pairs whose every caller leaves on every path it entered on
  "crAskOpen", "neFns", "neKeys", "neLive", "neUsedBy", "scWrOpen", "elabArmStageAt",
  "elabArmStageFe", "idLetBusy",
  // trails read and trimmed only above a height taken at frame entry
  "capTrailName", "shrTrailName", "shrTrailPrev", "shrTrailPrevDepth", "irhExprs", "irhTys",
  "irwExprs", "irwTys",
  // frame marks pushed at a body's entry and popped by its flush
  "irhMarks", "irhConcrete", "irwMarks",
  // a pending queue the same call flushes
  "monoShPendName", "monoShPendNode", "monoShPendTag",
  // reads validated against the live scope stack (D2181)
  "scopePrevSame", "scopeTopOf",
  // scratch written only below a height the call itself counts from zero
  "bcFound", "bcStack",
  // a log undone where it was written: the outermost intern, `modRenameClear`
  "iisMemoTy", "modRenameFirstBySid", "modRenameLastBySid",
  // per-depth caches revalidated against the walk's root and `crwGen` before any read
  "ccLevels",
  // sid stamps against `daCurGen` (minted per check from `daGenSeq`) and a token from `daHitSeq`,
  // sequences that only rise
  "daPos", "daGen", "daHitTok",
  // read only where the log's own `iisMemoTy` row matched
  "iisMemoRow",
  // read only below `ownLen` and above `sBase`, both rewritten by each scan
  "owner",
  // a shared empty argument whose one call (`fnBoundNames`) adds nothing to it
  "weNoNames",
]

// Containers whose lifetime is the instance by design.
const CINSTANCE = [
  // tables built on first use from constants
  "atomicAlign", "atomicI64", "atomicNames", "atomicOps", "atomicRowOf", "atomicSigs",
  "simdLaneMax", "simdNames", "simdOps", "simdRowOf", "simdSigs", "arTabs", "plainAr",
  "mimpStdHead", "mimpStdNext",
  // text interns and pure functions of their text key
  "cukIds", "cukTexts", "utkIds", "utkTexts", "indentCache", "ieeeMemoBytes",
  "ieeeMemoOver",
  // per-module caches kept with the source they read, or a file's root
  "ilGlobFns", "ilGlobMaps", "ilGlobSrc", "ilHoleSet", "ilHoleSrc", "ilScanSlot", "ilScanSrc",
  "siScDirect", "siScFrom", "siScNames", "siScOpenFn", "siScOpenName", "siScSrc", "siScTo",
  "modRootOfKey",
  // the registries `memoCompileReset` walks
  "memoGens", "memoKeys",
  // the atom intern: ids are text identities with no arena content
  "msAtomTexts", "msAtomIds",
  // std_receivers: rows of std's receivers and exports, filled once from constants.
  "stdRecvName", "stdRecvSpec", "stdRecvSelf", "stdRecvTparams", "stdRecvMin", "stdRecvMax",
  "stdExpName", "stdExpSpec",
]

// One module-scope container `const`.
// `isLet`: a `let` container, whose reassignments the `let` half grades and adds as homes.
type CDecl = {
  name: string,
  file: string,
  line: i32,
  exported: boolean,
  isLet: boolean,
}

// One write of a container: which, in which function of which source, at which 0-based line,
// and its shape: "push", "pop", "clear", "store" (an index store or any other method), "arg".
type CWrite = { ix: i32, src: i32, fn: string, line: i32, op: string }

// `^(export )?const NAME [: TYPE] = INIT` with INIT a list literal or `Map(`/`Set(`.
function contDeclOf(ln: string, file: string, line: i32): CDecl | null {
  let i = 0
  const exported = startsWith(ln, "export ")
  if exported { i = 7 }
  const isLet = startsWith(ln.slice(i, ln.length), "let ")
  if !isLet && !startsWith(ln.slice(i, ln.length), "const ") { return null }
  if isLet { i = i + 4 } else { i = i + 6 }
  const name = identAt(ln, i)
  if name.length == 0 { return null }
  const eq = findFrom(ln, "=", i)
  if eq < 0 { return null }
  const init = stripWs(ln.slice(eq + 1, ln.length))
  if (
    !(startsWith(init, "[")
      || startsWith(init, "Map(")
      || startsWith(init, "Map<")
      || startsWith(init, "Set(")
      || startsWith(init, "Set<"))
  ) {
    return null
  }
  { name: name, file: file, line: line, exported: exported, isLet: isLet }
}

// The container a name at source `si` denotes: the module's own, else the one export of it.
function contResolve(
  name: string,
  si: i32,
  srcs: Src[],
  own: Map<string, i32>,
  exp: Map<string, i32>,
): i32 {
  const o = own[srcs[si].file + ":" + name]
  if o != null { return o }
  exp[name] ?? -1
}

// The shape of the use of a container whose name ends at `j` of `s`, or "" for a read.
function contOpAt(s: string, j: i32): string {
  let k = nextAt(s, j)
  if k < s.length && s[k] == 46 {
    const m = identAt(s, k + 1)
    const after = k + 1 + m.length
    if after >= s.length || s[after] != 40 { return "" }
    if m == "push" { return "push" }
    if m == "pop" { return "pop" }
    if m == "clear" { return "clear" }
    if m == "set" || m == "delete" || m == "unshift" { return "store" }
    return ""
  }
  while k < s.length && s[k] == 91 {
    let d = 0
    while k < s.length {
      if s[k] == 91 { d = d + 1 }
      if s[k] == 93 {
        d = d - 1
        if d == 0 { break }
      }
      k = k + 1
    }
    k = nextAt(s, k + 1)
  }
  if (
    k > j
    && k < s.length
    && s[k] == 61
    && !(k + 1 < s.length && s[k + 1] == 61)
  ) {
    return "store"
  }
  ""
}

// The callee of the call whose argument list holds byte `i` of `s` at depth one, or "".
function calleeAround(s: string, i: i32): string {
  let k = i - 1
  let d = 0
  while k >= 0 {
    if s[k] == 41 || s[k] == 93 { d = d + 1 }
    if s[k] == 40 || s[k] == 91 {
      if d == 0 {
        if s[k] == 91 { return "" }
        let e = k
        while e > 0 && isSp(s[e - 1]) { e = e - 1 }
        let b = e
        while b > 0 && isIdChar(s[b - 1]) { b = b - 1 }
        return s.slice(b, e)
      }
      d = d - 1
    }
    k = k - 1
  }
  ""
}

// The 0-based argument position byte `i` of `s` sits at, in the call `calleeAround` names.
function argIndexAround(s: string, i: i32): i32 {
  let k = i - 1
  let d = 0
  let n = 0
  while k >= 0 {
    if s[k] == 41 || s[k] == 93 || s[k] == 125 { d = d + 1 }
    if s[k] == 40 || s[k] == 91 || s[k] == 123 {
      if d == 0 { return n }
      d = d - 1
    }
    if d == 0 && s[k] == 44 { n = n + 1 }
    k = k - 1
  }
  n
}

// Whether `s` passes the name at `[i, j)` as a whole argument: `(` or `,` before, `,` or `)` after.
function bareArgAt(s: string, i: i32, j: i32): boolean {
  const pb = prevByte(s, i)
  const n = nextAt(s, j)
  (pb == 40 || pb == 44) && n < s.length && (s[n] == 44 || s[n] == 41)
}

// The parameter names of the function whose header starts at 0-based line `h` of `lines`.
function paramsOf(lines: string[], h: i32): string[] {
  let txt = ""
  let k = h
  while k < lines.length && k < h + 12 {
    txt = txt + lines[k] + " "
    if endsWith(rstripLine(lines[k]), "{") { break }
    k = k + 1
  }
  const out: string[] = []
  let i = txt.indexOf("(")
  if i < 0 { return out }
  i = i + 1
  let d = 1
  let expect = true
  while i < txt.length && d > 0 {
    const c = txt[i]
    if c == 40 || c == 91 || c == 123 || c == 60 { d = d + 1 }
    if c == 41 || c == 93 || c == 125 || c == 62 { d = d - 1 }
    if d == 1 && c == 44 { expect = true }
    if d == 1 && expect && isIdStart(c) {
      const id = identAt(txt, i)
      out.push(id)
      expect = false
      i = i + id.length
      continue
    }
    i = i + 1
  }
  out
}

function rstripLine(s: string): string {
  let e = s.length
  while e > 0 && isSp(s[e - 1]) { e = e - 1 }
  s.slice(0, e)
}

// A line with its `//` comment cut, or "" for a comment or declaration line.
function codeOf(raw: string): string {
  if startsWith(lstripWs(raw), "//") || declLead(raw) { return "" }
  const cut = raw.indexOf("//")
  if cut >= 0 { return raw.slice(0, cut) }
  raw
}

// `function:position` for every parameter a function mutates in place: a call handing a
// container to one of these at that position writes it.
function mutatingHelpers(srcs: Src[]): Map<string, boolean> {
  const out = Map<string, boolean>()
  for s in srcs {
    for sp in s.spans {
      const ps = paramsOf(s.lines, sp.a - 1)
      if ps.length == 0 { continue }
      let k = sp.a
      while k < sp.b && k < s.lines.length {
        const t = codeOf(s.lines[k])
        let pi = -1
        for p in ps {
          pi = pi + 1
          let at = t.indexOf(p)
          while at >= 0 {
            const e = at + p.length
            const okL = at == 0 || (!isIdChar(t[at - 1]) && t[at - 1] != 46)
            if (
              okL
              && (e >= t.length || !isIdChar(t[e]))
              && contOpAt(t, e) != ""
            ) {
              out[sp.name + ":" + toString(pi)] = true
            }
            at = findFrom(t, p, at + 1)
          }
        }
        k = k + 1
      }
    }
  }
  out
}

// The container audit's result.
type CAudit = {
  decls: CDecl[],
  kinds: string[],
  homes: string[][],
  writes: i32[],
}

// Whether `w`, a push, is followed in its own function by a pop of the same container with no
// exit between.
function pushBalanced(w: CWrite, ws: CWrite[], srcs: Src[]): boolean {
  let pop = -1
  for x in ws {
    if (
      x.ix == w.ix
      && x.src == w.src
      && x.fn == w.fn
      && x.op == "pop"
      && x.line > w.line
    ) {
      if pop < 0 || x.line < pop { pop = x.line }
    }
  }
  if pop < 0 { return false }
  const s = srcs[w.src]
  let k = w.line + 1
  while k < pop {
    const t = codeOf(s.lines[k])
    if hasWord(t, "return") || hasWord(t, "break") || hasWord(t, "continue") {
      return false
    }
    k = k + 1
  }
  true
}

// Whether `g` is a generation: a `memoGenNew` const, or a `let` only ever bumped by one.
function isGeneration(g: string, srcs: Src[]): boolean {
  let decl = false
  for s in srcs {
    for raw in s.lines {
      const d = declOf(raw, s.file, 0)
      if d != null && d.name == g {
        if isMemoInit(d.init) { return true }
        decl = true
      }
    }
  }
  if !decl { return false }
  for s in srcs {
    for raw in s.lines {
      const t = codeOf(raw)
      let at = t.indexOf(g)
      while at >= 0 {
        const e = at + g.length
        const okL = at == 0 || (!isIdChar(t[at - 1]) && t[at - 1] != 46)
        if okL && (e >= t.length || !isIdChar(t[e])) {
          const n = nextAt(t, e)
          if (
            n < t.length
            && t[n] == 61
            && !(n + 1 < t.length && t[n + 1] == 61)
          ) {
            if stripWs(t.slice(n + 1, t.length)) != g + " + 1" { return false }
          }
        }
        at = findFrom(t, g, at + 1)
      }
    }
  }
  true
}

function contAudit(
  srcs: Src[],
  without: string,
  prologue: string[],
  pass: string[],
  frame: string[],
  letHomes: Map<string, string[]>,
  letKinds: Map<string, string>,
): CAudit {
  const decls: CDecl[] = []
  const own = Map<string, i32>()
  const exp = Map<string, i32>()
  for s in srcs {
    let i = 0
    while i < s.lines.length {
      const d = contDeclOf(s.lines[i], s.file, i + 1)
      if d != null {
        own[s.file + ":" + d.name] = decls.length
        if d.exported { exp[d.name] = decls.length }
        decls.push(d)
      }
      i = i + 1
    }
  }
  const helpers = mutatingHelpers(srcs)
  const ws: CWrite[] = []
  let si = 0
  while si < srcs.length {
    const s = srcs[si]
    let li = 0
    while li < s.lines.length {
      const t = codeOf(s.lines[li])
      let i = 0
      while i < t.length {
        if !isIdChar(t[i]) {
          i = i + 1
          continue
        }
        let j = i
        while j < t.length && isIdChar(t[j]) { j = j + 1 }
        if isIdStart(t[i]) && (i == 0 || t[i - 1] != 46) {
          const ix = contResolve(t.slice(i, j), si, srcs, own, exp)
          if ix >= 0 {
            let op = contOpAt(t, j)
            const site = calleeAround(t, i)
              + ":"
              + toString(argIndexAround(t, i))
            if op == "" && bareArgAt(t, i, j) && (helpers[site] ?? false) {
              op = "arg"
            }
            if op == "" && t.indexOf("while ") >= 0 {
              const e = nextAt(t, j)
              if startsWith(t.slice(e, t.length), ".length > 0") {
                op = "clear"
              }
            }
            if op != "" {
              ws.push(
                { ix: ix, src: si, fn: s.lineFn[li + 1], line: li, op: op },
              )
            }
          }
        }
        i = j
      }
      li = li + 1
    }
    si = si + 1
  }

  const kinds: string[] = []
  const homes: string[][] = []
  const writes: i32[] = []
  for _d in decls {
    kinds.push("")
    homes.push([])
    writes.push(0)
  }
  const atModule: boolean[] = []
  const stackOnly: boolean[] = []
  for _d in decls {
    atModule.push(true)
    stackOnly.push(true)
  }
  for w in ws {
    if w.op != "clear" { writes[w.ix] = writes[w.ix] + 1 }
    if w.fn != "<module>" { atModule[w.ix] = false }
    if w.op == "clear" && w.fn != without { addUnique(homes[w.ix], w.fn) }
    if w.op != "push" && w.op != "pop" && w.op != "clear" {
      stackOnly[w.ix] = false
    }
    if w.op == "push" && !pushBalanced(w, ws, srcs) { stackOnly[w.ix] = false }
  }
  const ixOfName = Map<string, i32>()
  let k = 0
  while k < decls.length {
    ixOfName[decls[k].name] = k
    k = k + 1
  }
  k = 0
  while k < decls.length {
    const lh = letHomes[decls[k].file + ":" + decls[k].name]
    if decls[k].isLet && lh != null {
      for x in lh { addUnique(homes[k], x) }
    }
    k = k + 1
  }
  k = 0
  while k < decls.length {
    const h = homes[k]
    sort(h, strLess)
    let kind = ""
    if writes[k] == 0 {
      kind = "unwritten"
    } else if atModule[k] {
      kind = "init"
    } else if h.length > 0 {
      kind = "inner"
      if anyIn(h, frame) { kind = "frame" }
      if anyIn(h, pass) { kind = "pass" }
      if anyIn(h, prologue) { kind = "prologue" }
    } else if stackOnly[k] {
      kind = "balanced"
    }
    // A `let` container a reviewed `let` list names keeps that class here.
    const lk = letKinds[decls[k].file + ":" + decls[k].name] ?? ""
    const reviewed = lk == "scoped" || lk == "linstance" || lk == "stamped"
    if kind == "" && decls[k].isLet && reviewed { kind = lk }
    kinds[k] = kind
    k = k + 1
  }
  // The reviewed lists: each entry must name a written container nothing above already covers.
  const lists = [SCOPED, CINSTANCE]
  const listKinds = ["scoped", "instance"]
  let li = 0
  while li < lists.length {
    for nm in lists[li] {
      const at = ixOfName[nm]
      if at == null {
        die("\{listKinds[li]} names no written container const: " + nm, 2)
        continue
      }
      if kinds[at] != "" {
        die("\{listKinds[li]} entry \{nm} is already \{kinds[at]}; drop it", 2)
      }
      kinds[at] = listKinds[li]
    }
    li = li + 1
  }
  for g in STAMPED {
    const parts = split(g, ":")
    const at = ixOfName[parts[0]]
    if at == null {
      die("STAMPED names no written container const: " + parts[0], 2)
      continue
    }
    if kinds[at] != "" {
      die("STAMPED entry \{parts[0]} is already \{kinds[at]}; drop it", 2)
    }
    const comp = ixOfName[parts[1]]
    let ok = false
    if comp != null {
      ok = decls[comp].file == decls[at].file
        && inList(STAMPED, parts[1] + ":" + stampOf(parts[1]))
    } else if isGeneration(parts[1], srcs) {
      for s in srcs {
        const home = s.file == decls[at].file
        for raw in s.lines {
          const t = codeOf(raw)
          if (
            hasWord(t, parts[1])
            && (home || hasWord(t, parts[0]))
            && (t.indexOf("==") >= 0 || t.indexOf("!=") >= 0)
          ) {
            ok = true
          }
        }
      }
    }
    if !ok {
      die(
        "STAMPED \{g}: no comparison of \{parts[0]} against generation \{parts[1]}",
        2,
      )
    }
    kinds[at] = "stamped"
  }
  k = 0
  while k < decls.length {
    if kinds[k] == "" { kinds[k] = "NEVER" }
    k = k + 1
  }
  { decls: decls, kinds: kinds, homes: homes, writes: writes }
}

// The guard STAMPED names for container `c`, or "".
function stampOf(c: string): string {
  for g in STAMPED {
    const parts = split(g, ":")
    if parts[0] == c { return parts[1] }
  }
  ""
}

// `^(export )?(let|const)\s`: the line is a declaration, so its `=` is no write.
function declLead(ln: string): boolean {
  let i = 0
  if startsWith(ln, "export ") { i = 7 }
  const rest = ln.slice(i, ln.length)
  startsWith(rest, "let ") || startsWith(rest, "const ")
}

function anyIn(xs: readonly string[], set: readonly string[]): boolean {
  for x in xs {
    if inList(set, x) { return true }
  }
  false
}

function countKind(a: Audit, kind: string): i32 {
  let n = 0
  for k in a.kinds {
    if k == kind { n = n + 1 }
  }
  n
}

function sortedIx(a: Audit, pred: (i32) => boolean): i32[] {
  const ixs: i32[] = []
  let i = 0
  while i < a.decls.length {
    if pred(i) { ixs.push(i) }
    i = i + 1
  }
  sort(ixs, (x: i32, y: i32): boolean => a.decls[x].name < a.decls[y].name)
  ixs
}

// The index-shaped inner rows no GUARDED entry covers: what `--check` refuses beside NEVER.
function unguarded(a: Audit): i32[] {
  sortedIx(a, (i: i32): boolean => a.index[i] && a.guards[i].length == 0)
}

function yesNo(b: boolean): string {
  if b { return "yes" }
  "NO"
}

// The written containers no rule or reviewed list covers, by file then line.
function contNever(a: Audit): i32[] {
  const out: i32[] = []
  let i = 0
  while i < a.cont.decls.length {
    if a.cont.kinds[i] == "NEVER" { out.push(i) }
    i = i + 1
  }
  out
}

function contCount(a: Audit, kind: string): i32 {
  let n = 0
  for k in a.cont.kinds {
    if k == kind { n = n + 1 }
  }
  n
}

function contWritten(a: Audit): i32 {
  a.cont.decls.length - contCount(a, "unwritten")
}

function report(a: Audit, names: boolean) {
  print(
    "module-scope mutables, every compiler module: " + toString(a.decls.length),
  )
  for k in [
    "prologue", "pass", "frame", "inner", "init", "rises", "balanced",
    "restored", "stamped", "scoped", "linstance", "NEVER",
  ] {
    print(
      "  " + padEnd(k, 9, " ") + " " + padStart(toString(countKind(a, k)), 4, " "),
    )
  }
  const ra = FRAME_ROOTS[0]
  const rb = FRAME_ROOTS[1]
  print(
    "\nTHE TWO FRAME BUILDERS MUST AGREE — a flag one clears and the other does not",
  )
  print(
    "survives into the next program's START function. Each side is the root plus the",
  )
  print("helpers its own module splits it into:")
  let r = 0
  while r < FRAME_ROOTS.length {
    const rest: string[] = []
    for x in a.sides[r] {
      if x != FRAME_ROOTS[r] { rest.push(x) }
    }
    sort(rest, strLess)
    let shown = join(rest, ", ")
    if shown.length == 0 { shown = "-" }
    print("  " + padEnd(FRAME_ROOTS[r], 16, " ") + " " + shown)
    r = r + 1
  }
  print("")
  const bad: string[] = []
  const flags = sortedIx(
    a,
    (i: i32): boolean => startsWith(a.decls[i].name, "fnUses"),
  )
  for i in flags {
    const n = a.decls[i].name
    const sa = anyIn(a.assigned[i], a.sides[0])
    const sb = anyIn(a.assigned[i], a.sides[1])
    let tail = ""
    if sa != sb {
      bad.push(n)
      tail = "   <-- ASYMMETRIC"
    }
    const fa = padEnd(yesNo(sa), 4, " ")
    const fb = padEnd(yesNo(sb), 4, " ")
    print("  \{padEnd(n, 20, " ")} \{ra} \{fa} \{rb} \{fb}\{tail}")
  }
  let badShown = join(bad, ", ")
  if badShown.length == 0 { badShown = "none" }
  print("  \{bad.length} of \{flags.length} asymmetric: \{badShown}")

  const never = sortedIx(a, (i: i32): boolean => a.kinds[i] == "NEVER")
  print(
    "\nNEVER CLEARED (\{never.length}) — ask whether each is rewritten unconditionally per compile",
  )
  for i in never {
    const d = a.decls[i]
    const nm = padEnd(d.name, 24, " ")
    const ln = padEnd(toString(d.line), 6, " ")
    const ini = padEnd(d.init, 8, " ")
    const by = join(a.assigned[i], ",")
    print("  \{nm} \{d.file}:\{ln} init=\{ini} writes=\{a.writes[i]} by=\{by}")
  }

  const idx = sortedIx(a, (i: i32): boolean => a.index[i])
  const open = unguarded(a)
  print(
    "\nINDEX-SHAPED, CLEARED ONLY INSIDE AN INNER FUNCTION (\{idx.length}, \{open.length} unguarded) — a stale id aliases the next program's node",
  )
  for i in idx {
    const d = a.decls[i]
    let g = a.guards[i]
    if g.length == 0 { g = "UNGUARDED" }
    const nm = padEnd(d.name, 24, " ")
    print("  \{nm} \{d.file}:\{d.line} \{g}")
  }

  const cn = contNever(a)
  print(
    "\nMODULE-SCOPE CONST CONTAINERS, every compiler module: \{a.cont.decls.length}, \{contWritten(a)} written",
  )
  for k in [
    "prologue", "pass", "frame", "inner", "init", "balanced", "stamped",
    "scoped", "instance", "NEVER",
  ] {
    print(
      "  " + padEnd(k, 9, " ") + " " + padStart(toString(contCount(a, k)), 4, " "),
    )
  }
  for i in cn {
    const d = a.cont.decls[i]
    print(
      "  NEVER \{padEnd(d.name, 24, " ")} \{d.file}:\{d.line} writes=\{a.cont.writes[i]}",
    )
  }

  if names {
    print("\nEVERY MUTABLE, with its clear sites")
    const all = sortedIx(a, (_i: i32): boolean => true)
    sort(all, (x: i32, y: i32): boolean => {
      const dx = a.decls[x]
      const dy = a.decls[y]
      if dx.file != dy.file { return dx.file < dy.file }
      dx.line < dy.line
    })
    for i in all {
      const d = a.decls[i]
      let hs = join(a.homes[i], ", ")
      if hs.length == 0 { hs = "-" }
      const k = padEnd(a.kinds[i], 9, " ")
      const nm = padEnd(d.name, 26, " ")
      const ln = padEnd(toString(d.line), 6, " ")
      print("  \{k} \{nm} \{d.file}:\{ln} \{hs}")
    }
    print("\nEVERY WRITTEN CONST CONTAINER, with its clear sites")
    let ci = 0
    while ci < a.cont.decls.length {
      const d = a.cont.decls[ci]
      if a.cont.kinds[ci] != "unwritten" {
        let hs = join(a.cont.homes[ci], ", ")
        if hs.length == 0 { hs = "-" }
        const k = padEnd(a.cont.kinds[ci], 9, " ")
        print("  \{k} \{padEnd(d.name, 26, " ")} \{d.file}:\{d.line} \{hs}")
      }
      ci = ci + 1
    }
  }
  0
}

function flagValue(
  args: readonly string[],
  flag: string,
  fallback: string,
): string {
  let i = 0
  while i + 1 < args.length {
    if args[i] == flag { return args[i + 1] }
    i = i + 1
  }
  fallback
}

function main(args: readonly string[]) {
  cdir = flagValue(args, "--dir", cdir)
  const a = audit(flagValue(args, "--without-reset", ""))
  if hasFlag(args, "--check") {
    const never = sortedIx(a, (i: i32): boolean => a.kinds[i] == "NEVER")
    const open = unguarded(a)
    const line = "never-cleared module state \{never.length} of \{a.decls.length} mutables"
    const iline = "unguarded inner index registers \{open.length}"
    if never.length > 0 {
      print("emitter state invariant BROKEN: " + line)
      print(
        "A module-scope `let` that no reset clears survives into the next program on the same instance (`vl check --batch`, the LSP).\nClear it in its module's per-program reset, a pass or a frame builder, derive it per call, or name it in LSTAMPED, LSCOPED or LINSTANCE with its reason:",
      )
      for i in never {
        const d = a.decls[i]
        print("  \{d.name} \{d.file}:\{d.line}")
      }
    }
    if open.length > 0 {
      print("emitter state invariant BROKEN: " + iline)
      print(
        "An integer register holding a node index or other per-program id, cleared only inside an inner function, keeps the last program's id on a shared instance (D11770).\nReset it in its module's per-program reset, or name it in GUARDED with the memo key or length that rebuilds it:",
      )
      for i in open {
        const d = a.decls[i]
        print("  \{d.name} \{d.file}:\{d.line}")
      }
    }
    const cn = contNever(a)
    const cline = "never-cleared const containers \{cn.length} of \{contWritten(a)} written"
    if cn.length > 0 {
      print("compiler state invariant BROKEN: " + cline)
      print(
        "A module-scope `const` list or map that is written and that nothing empties keeps the last program's entries on a shared instance (#6759).\nMake it a `let` reset in its module's per-program reset, or name it in STAMPED, SCOPED or CINSTANCE with its reason:",
      )
      for i in cn {
        const d = a.cont.decls[i]
        print("  \{d.name} \{d.file}:\{d.line}")
      }
    }
    if never.length > 0 || open.length > 0 || cn.length > 0 {
      exit(1)
      return 0
    }
    print(line + "; " + iline + "; " + cline)
    return 0
  }
  report(a, hasFlag(args, "--names"))
}

const argv = programArgs()
if argv is Utf8Error {
  die("emitter-state-audit: an argument is not UTF-8: " + argv.msg, 2)
} else {
  main(argv)
}
