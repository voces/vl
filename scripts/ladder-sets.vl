// The kind-ladder lint's closed sets must still be the tree's own declarations.
//
//     vl run scripts/ladder-sets.vl [-- --root <dir>]
//
// `kind-ladder-incomplete` (compiler/lint.vl) carries a copy of every closed set — each
// `type X = a | b | c …` in compiler/ whose members are all string literals or all type
// names — in the row table `klSets`, and of the field table `klFields`. This re-derives both
// from compiler/*.vl and exits 1 naming whatever drifted or sits out of order, so a new member
// or a new set fails here rather than moving the ladder budget for no reason a reader can find.
// Paths resolve against the working directory; run it from the checkout root.

import { programArgs } from "std:args"
import { Utf8Error } from "std:utf8"
import { endsWith, join, split, startsWith, trimEnd } from "std:str"
import { sort } from "std:array"
import { die } from "./lib/common"
import {
  ClosedSet,
  closedSets,
  fieldIndex,
  findSet,
  readOrDie,
  strLess,
} from "./lib/ladder-walk"

const TOOL = "ladder-sets"

// The quoted strings of `const NAME = [ … ]` in `src`: from the line that opens it to
// the first line ending in `]`. Numbers are kept too, as their text.
function constList(src: string, name: string): string[] {
  const lines = split(src, "\n")
  const open = "const \{name} = ["
  let i = 0
  while i < lines.length && !startsWith(lines[i], open) { i = i + 1 }
  if i == lines.length {
    die("ladder-sets: compiler/lint.vl has no `\{open}`", 2)
    return []
  }
  let body = lines[i].slice(open.length, lines[i].length)
  while !endsWith(trimEnd(body), "]") && i + 1 < lines.length {
    i = i + 1
    body = "\{body}\n\{lines[i]}"
  }
  const out: string[] = []
  let k = 0
  while k < body.length {
    if body[k] == '"' {
      const a = k + 1
      k = a
      while k < body.length && body[k] != '"' { k = k + 1 }
      out.push(body.slice(a, k))
    } else if body[k] >= '0' && body[k] <= '9' {
      const a = k
      while k < body.length && body[k] >= '0' && body[k] <= '9' { k = k + 1 }
      out.push(body.slice(a, k))
      k = k - 1
    }
    k = k + 1
  }
  return out
}

// The records of `const NAME: T[] = [ … ]` in `src`, each as its quoted strings and numbers in
// order (`constList`'s scan), read brace to brace however the formatter lays them out.
function rowList(src: string, name: string): string[][] {
  const lines = split(src, "\n")
  const open = "const \{name}: "
  let i = 0
  while i < lines.length && !startsWith(lines[i], open) { i = i + 1 }
  if i == lines.length {
    die("ladder-sets: compiler/lint.vl has no `\{open}`", 2)
    return []
  }
  const out: string[][] = []
  let row = ""
  let inRow = false
  i = i + 1
  while i < lines.length && trimEnd(lines[i]) != "]" {
    const ln = lines[i]
    let a = 0
    let k = 0
    while k < ln.length {
      if ln[k] == '{' {
        inRow = true
        row = ""
        a = k + 1
      } else if ln[k] == '}' {
        row = "\{row}\{ln.slice(a, k)}"
        out.push(constList("const r = [\{row}]", "r"))
        inRow = false
      }
      k = k + 1
    }
    if inRow { row = "\{row}\{ln.slice(a, ln.length)} " }
    i = i + 1
  }
  return out
}

function listText(xs: string[]): string {
  const q: string[] = []
  for x in xs { q.push("'\{x}'") }
  return "[\{join(q, ", ")}]"
}

function sameList(a: string[], b: string[]): boolean {
  if a.length != b.length { return false }
  let i = 0
  while i < a.length {
    if a[i] != b[i] { return false }
    i = i + 1
  }
  return true
}

// The lint's set copy against the tree: same sets, same members in the same order (the
// order is the union's box-tag order, and the lint reports `n of m` against it), and
// the same literal/type kind.
function checkSets(sets: ClosedSet[], lint: string, bad: string[]) {
  const rows = rowList(lint, "klSets")
  const names: string[] = []
  const isType: string[] = []
  for r in rows {
    if r.length != 2 {
      bad.push(
        "  a `klSets` row is not `{ ksName: \"X\", ksType: 0|1, ksMembers: klX }`",
      )
      return 0
    }
    names.push(r[0])
    isType.push(r[1])
  }
  const mine = names.slice(0, names.length)
  sort(mine, strLess)
  for name in mine {
    const si = findSet(sets, name)
    const members = constList(lint, "kl\{name}")
    if si < 0 {
      bad.push(
        "  `\{name}` is in compiler/lint.vl and no longer declared in the tree",
      )
    } else if !sameList(sets[si].members, members) {
      bad.push(
        "  `\{name}` differs: tree \{listText(sets[si].members)}\n            lint \{listText(members)}",
      )
    }
  }
  let i = 0
  while i < names.length {
    const si = findSet(sets, names[i])
    if si >= 0 && (isType[i] == "1") != sets[si].isType {
      bad.push(
        "  `\{names[i]}` is a set of \{kindWord(sets[si].isType)} in the tree and of \{kindWord(isType[i] == "1")} in `klSets`",
      )
    }
    // Rows run by member count, then name: `klSetOf` takes the first set holding every arm.
    if i > 0 && !setRowBefore(lint, names[i - 1], names[i]) {
      bad.push(
        "  `\{names[i]}` (\{constList(lint, "kl\{names[i]}").length} members) sits after `\{names[i - 1]}` in `klSets`, which runs by member count, then name",
      )
    }
    i = i + 1
  }
  const tree: string[] = []
  for s in sets { tree.push(s.name) }
  sort(tree, strLess)
  for name in tree {
    let found = false
    for x in names {
      if x == name { found = true }
    }
    if !found {
      const at = sets[findSet(sets, name)].at
      bad.push(
        "  `\{name}` (\{at}) is declared in the tree and missing from compiler/lint.vl's `klSets`",
      )
    }
  }
  0
}
// Whether set row `a` may come before row `b`: fewer members, or as many and an earlier name.
function setRowBefore(lint: string, a: string, b: string): boolean {
  const na = constList(lint, "kl\{a}").length
  const nb = constList(lint, "kl\{b}").length
  if na != nb { return na < nb }
  return strLess(a, b)
}

function kindWord(isType: boolean): string {
  if isType { return "type names" }
  return "string literals"
}

// The lint's field table against the tree's: the same fields, each naming the same set.
function checkFields(
  root: string,
  sets: ClosedSet[],
  lint: string,
  bad: string[],
) {
  const fields: string[] = []
  const setOf: string[] = []
  fieldIndex(TOOL, root, sets, fields, setOf)
  const mineF: string[] = []
  const mineS: string[] = []
  for r in rowList(lint, "klFields") {
    if r.length != 2 {
      bad.push("  a `klFields` row is not `{ kfName: \"f\", kfSet: \"X\" }`")
      return 0
    }
    if mineF.length > 0 && !strLess(mineF[mineF.length - 1], r[0]) {
      bad.push(
        "  `\{r[0]}` sits after `\{mineF[mineF.length - 1]}` in `klFields`, which runs by name",
      )
    }
    mineF.push(r[0])
    mineS.push(r[1])
  }
  const order = mineF.slice(0, mineF.length)
  sort(order, strLess)
  for f in order {
    let mi = 0
    while mineF[mi] != f { mi = mi + 1 }
    let ti = -1
    let q = 0
    while q < fields.length {
      if fields[q] == f { ti = q }
      q = q + 1
    }
    if ti < 0 {
      bad.push(
        "  `\{f}` is in compiler/lint.vl and no longer a single-closed-set field",
      )
    } else if setOf[ti] != mineS[mi] {
      bad.push("  `\{f}` differs: tree `\{setOf[ti]}`, lint `\{mineS[mi]}`")
    }
  }
  const tree = fields.slice(0, fields.length)
  sort(tree, strLess)
  for f in tree {
    let found = false
    for x in mineF {
      if x == f { found = true }
    }
    if !found {
      let q = 0
      while fields[q] != f { q = q + 1 }
      bad.push(
        "  `\{f}` (-> `\{setOf[q]}`) is a single-closed-set field in the tree and missing from compiler/lint.vl's `klFields`",
      )
    }
  }
  return 0
}

function main(args: string[]) {
  let root = "."
  let i = 0
  while i < args.length {
    if args[i] == "--root" && i + 1 < args.length {
      root = args[i + 1]
      i = i + 1
    } else {
      die("ladder-sets: usage: ladder-sets.vl [--root <dir>]", 2)
    }
    i = i + 1
  }
  const sets = closedSets(TOOL, root)
  const lint = readOrDie(TOOL, "\{root}/compiler/lint.vl")
  const badSets: string[] = []
  checkSets(sets, lint, badSets)
  if badSets.length > 0 {
    die(
      "ladder-sets: compiler/lint.vl's closed-set copy has drifted from the `export type` declarations it mirrors:\n\{join(badSets, "\n")}",
      1,
    )
  }
  const badFields: string[] = []
  checkFields(root, sets, lint, badFields)
  if badFields.length > 0 {
    die(
      "ladder-sets: compiler/lint.vl's field->set copy has drifted from the `type X = { f: T }` declarations it mirrors:\n\{join(badFields, "\n")}",
      1,
    )
  }
  print(
    "ladder-sets ok — \{sets.length} closed sets and \{rowList(lint, "klFields").length} set-typed fields match compiler/lint.vl",
  )
  0
}

const argv = programArgs()
if argv is Utf8Error {
  die("ladder-sets: an argument is not UTF-8: \{argv.msg}", 2)
} else {
  main(argv)
}
