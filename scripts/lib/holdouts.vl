// The I8 holdouts (`scripts/ir-i8-census/holdouts/`): programs the IR does not claim yet. A
// grader expects each one to be refused with `cannot yet lower`, and reds when one builds, so the
// list only shrinks. One `<slug>.tsv` file per program, holding `<program>\t<unit>\t<class>\t<owner>`,
// the program a checkout-relative path (`tests/cases/...`, `docs/internals/inventory/D<id>.md`, a
// distilled or probe `.vl`).
//
//     import { holdoutVerdict, holdouts } from "../lib/holdouts"

import { listDir } from "std:fs"
import { endsWith, split } from "std:str"
import { isDir } from "./common"
import { readText } from "./corpus"

export const HOLDOUTS = "scripts/ir-i8-census/holdouts"
export const HOLDOUT_REFUSAL = "cannot yet lower"

// Each holdout's program mapped to its class; empty when the directory is absent.
export function holdouts(): Map<string, string> {
  const out: Map<string, string> = Map()
  if !isDir(HOLDOUTS) { return out }
  const names = listDir(HOLDOUTS)
  if !(names is string[]) { return out }
  for n in names {
    if !endsWith(n, ".tsv") { continue }
    for line in readText(HOLDOUTS + "/" + n).split("\n") {
      if line == "" { continue }
      const f = split(line, "\t")
      out[f[0]] = if f.length > 2 { f[2] } else { "" }
    }
  }
  return out
}

// A holdout's grade: "" when its build was refused with `cannot yet lower`, else why it reds.
// `passed` says the build was not refused at emit; `err` is the build's error text.
export function holdoutVerdict(
  prog: string,
  passed: boolean,
  err: string,
): string {
  if passed {
    return "holdout \{prog} is no longer refused: delete its file under \{HOLDOUTS}/"
  }
  if err.indexOf(HOLDOUT_REFUSAL) < 0 {
    return "holdout \{prog} fails without `\{HOLDOUT_REFUSAL}`"
  }
  return ""
}
