// Reading a `VL_PROFILE_GUEST` Firefox-profiler JSON: the columns of its first thread, and
// the stable descending rank the profile tools print in. Shared by `scripts/profile-rank.vl`
// and `scripts/perf/profile-{parents,phases}.vl`; import with a relative path.

import { IoError, readTextFile } from "std:fs"
import { Json, JsonError, parseJson } from "std:json"
import { JsonMap, die } from "./common"

// The first thread's columns. `stacks` holds -1 for a sample with no stack, `prefix` -1 for
// a root node; `samples` is the raw samples object, for a column only one tool reads.
export type Profile = {
  names: string[],
  frameFunc: i32[],
  funcName: i32[],
  prefix: i32[],
  stFrame: i32[],
  stacks: i32[],
  samples: JsonMap,
}

export function field(m: JsonMap, key: string): Json { m[key] ?? null }

// `v` as an object, or exit 2 naming `tool` and `what`.
export function obj(v: Json, tool: string, what: string): JsonMap {
  if v is JsonMap { return v }
  die("\{tool}: \{what} is not an object", 2)
  const none: JsonMap = Map()
  none
}

export function arr(v: Json, tool: string, what: string): Json[] {
  if v is Json[] { return v }
  die("\{tool}: \{what} is not an array", 2)
  []
}

// An index column: each entry as an i32, -1 for a JSON null.
function ints(v: Json, tool: string, what: string): i32[] {
  const out: i32[] = []
  for x in arr(v, tool, what) {
    if x is f64 { out.push(x as! i32) } else { out.push(-1) }
  }
  out
}

function absent(v: Json): boolean {
  if v is Json[] { return v.length == 0 }
  v == null
}

// The name table: the thread's `stringArray` or `stringTable`, else the shared one; an empty
// table counts as absent.
function strings(prof: JsonMap, th: JsonMap): string[] {
  let src = field(th, "stringArray")
  if absent(src) { src = field(th, "stringTable") }
  if absent(src) {
    const shared = field(prof, "shared")
    if shared is JsonMap { src = field(shared, "stringArray") }
  }
  const out: string[] = []
  if src is Json[] {
    for s in src {
      if s is string { out.push(s) } else { out.push("") }
    }
  }
  out
}

// What a failed load returns; never seen, since `die` exits first.
function noProfile(): Profile {
  const none: JsonMap = Map()
  {
    names: [],
    frameFunc: [],
    funcName: [],
    prefix: [],
    stFrame: [],
    stacks: [],
    samples: none,
  }
}

// The profile at `path`; an unreadable, non-JSON or non-profile file exits 2 naming `tool`.
export function loadProfile(path: string, tool: string): Profile {
  const text = readTextFile(path)
  if text is IoError {
    die("\{tool}: cannot read \{path} (\{text.msg})", 2)
    return noProfile()
  }
  const parsed = parseJson(text)
  if parsed is JsonError {
    die("\{tool}: \{path} is not JSON (\{parsed.msg})", 2)
    return noProfile()
  }
  const prof = obj(parsed, tool, "the profile")
  const th = obj(
    arr(field(prof, "threads"), tool, "threads")[0],
    tool,
    "threads[0]",
  )
  // Read in this order so a malformed profile names the same first fault it always did.
  const names = strings(prof, th)
  const frameFunc = ints(
    field(
      obj(field(th, "frameTable"), tool, "frameTable"),
      "func",
    ),
    tool,
    "func",
  )
  const funcName = ints(
    field(obj(field(th, "funcTable"), tool, "funcTable"), "name"),
    tool,
    "name",
  )
  const stackTable = obj(field(th, "stackTable"), tool, "stackTable")
  const prefix = ints(field(stackTable, "prefix"), tool, "prefix")
  const stFrame = ints(field(stackTable, "frame"), tool, "frame")
  const samples = obj(field(th, "samples"), tool, "samples")
  const stacks = ints(field(samples, "stack"), tool, "stack")
  { names, frameFunc, funcName, prefix, stFrame, stacks, samples }
}

// The function name at stack node `s`.
export function nodeName(p: Profile, s: i32): string {
  p.names[p.funcName[p.frameFunc[p.stFrame[s]]]]
}

// `ix` ordered by `key` descending; equal keys keep their order (a stable merge sort), which
// is how Python's `Counter.most_common` breaks ties.
export function rankDesc(ix: i32[], key: f64[]): i32[] {
  if ix.length <= 1 { return ix }
  const mid = ix.length / 2
  const a = rankDesc(ix.slice(0, mid), key)
  const b = rankDesc(ix.slice(mid, ix.length), key)
  const out: i32[] = []
  let i = 0
  let j = 0
  while i < a.length || j < b.length {
    if j >= b.length || (i < a.length && key[a[i]] >= key[b[j]]) {
      out.push(a[i])
      i = i + 1
    } else {
      out.push(b[j])
      j = j + 1
    }
  }
  out
}
