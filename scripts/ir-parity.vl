// Behavioural parity of the IR: each program is built by the shipped seed (IR on) and by its
// `CLAIMED`-empty twin (IR off, `ir-identity.sh --build-claimless`); both run and must agree.
//
//     vl run scripts/ir-parity.vl -- [--seed P] [--claimless P] [--pop cells,cases,probes,pins|
//         refusals] [--sample N] [--files F...] [--from LIST] [--out F] [--run-all] [--cross]
// A `--files` or `--from` entry ending `.md` is an inventory row, graded on its witness.
//
// Rows `program\tverdict\tdetail` go to `--out` (default `build/ir-parity.tsv`); byte-identical
// modules are `same` unrun unless `--run-all`. Exit 1 on a `differs`, a one-sided `build-fails` or
// an unlisted byte differ (`ir-divergence-baseline.txt`; `--behaviour-only` passes it), and with
// `--cross` only where IR on fails to build or runs otherwise where IR off ran clean; 3 on a
// timeout. `--sample N` keeps a fixed 1-in-N of `cases`. `$JOBS` chunks at once (default 4).
// A program the baseline lists with a `legacy-wrong:` mechanism is graded on its IR-on build alone:
// it passes when that run meets the program's expected output (its `// @log` lines, a `// @trap`
// as any trap; an inventory row `--files` names, its `Want:`), whatever IR off does.
// Run it from the checkout root; $IR_DIVERGENCE_BASELINE names another baseline, as for ir-identity.sh.

import { programArgs } from "std:args"
import { Utf8Error } from "std:utf8"
import { exit } from "std:process"
import { parseI32, toString } from "std:fmt"
import { endsWith, join, split, startsWith } from "std:str"
import { sort } from "std:array"
import {
  die,
  envOr,
  fanOutArgv,
  firstLine,
  hasFlag,
  isFile,
  splitLines,
  univNl,
} from "./lib/common"
import { parseRows, splitFiles } from "./lib/inventory"
import {
  cellsIn,
  cwd,
  makeTempDir,
  readText,
  spawn,
  writeText,
} from "./lib/corpus"
import { norm } from "./lib/census-grade"
import { fnvFeed } from "./lib/witness-cache"

const SELF = "scripts/ir-parity.vl"
const BASELINE = "scripts/ir-divergence-baseline.txt"
const TOOL_COMPILER = "build/vl-compiler.wasm"
const CHUNK = 25
const BUILD_SECS = "60"
const RUN_SECS = "30"
// `timeout $0 $1 run $2` with each stream capped at 1 MiB, so a runaway loop cannot exhaust the
// worker's heap; it exits with the run's own code.
const CAPPED = "e=$(mktemp); timeout \"$0\" \"$1\" run \"$2\" 2> \"$e\" | head -c 1048576; rc=${PIPESTATUS[0]}; head -c 1048576 \"$e\" >&2; rm -f \"$e\"; exit $rc"
const DISTILLED = "scripts/silent-sweep/distilled"

// The values after `flag` up to the next `--` flag, or [] when it is absent.
function argsOf(args: readonly string[], flag: string): string[] {
  const out: string[] = []
  let i = 0
  while i < args.length && args[i] != flag { i = i + 1 }
  i = i + 1
  while i < args.length && !startsWith(args[i], "--") {
    out.push(args[i])
    i = i + 1
  }
  return out
}

function argOr(args: readonly string[], flag: string, dflt: string): string {
  const v = argsOf(args, flag)
  if v.length == 0 { return dflt }
  return v[0]
}

// ── the populations ──────────────────────────────────────────────────────────────

// Every distilled cell, `cells/` then `named/`.
function cellsPop(): string[] {
  const out: string[] = []
  for part in ["cells", "named"] {
    for n in cellsIn(DISTILLED + "/" + part) {
      out.push("\{DISTILLED}/\{part}/\{n}.vl")
    }
  }
  return out
}

// The `tests/cases` programs `ir-identity.sh --cases` builds: every `.vl` not marked `@error`.
function casesPop(): string[] {
  const x = spawn(
    "grep",
    ["-rL", "^// @error", "--include=*.vl", "tests/cases"],
  )
  if x.code > 1 { die("ir-parity: grep over tests/cases failed\n\{x.err}", 2) }
  const out: string[] = []
  for l in split(x.out, "\n") {
    if endsWith(l, ".vl") { out.push(l) }
  }
  return out
}

// The pinned position sweeps (Q58) and shadow-row programs under `tests/ir-shadow-rows`.
function pinsPop(): string[] {
  const out: string[] = []
  for n in cellsIn("tests/ir-shadow-rows") {
    out.push("tests/ir-shadow-rows/" + n + ".vl")
  }
  return out
}

function probesPop(): string[] {
  const out: string[] = []
  for n in cellsIn("scripts/capability-probes") {
    out.push("scripts/capability-probes/" + n + ".vl")
  }
  return out
}

// The programs legacy refuses at emit, where a claim that skipped the refusal would show: every
// `@emit-error` tests/cases program, `tests/ir-claim-fallback`, and each inventory witness filed
// `emit_reject`, materialised under `tmp` by `scripts/inventory/witnesses.vl`.
function refusalsPop(seed: string, tmp: string): string[] {
  const x = spawn(
    "grep",
    ["-rl", "^// @emit-error", "--include=*.vl", "tests/cases"],
  )
  if x.code > 1 { die("ir-parity: grep over tests/cases failed\n\{x.err}", 2) }
  const out: string[] = []
  for l in split(x.out, "\n") {
    if endsWith(l, ".vl") { out.push(l) }
  }
  for n in cellsIn("tests/ir-claim-fallback") {
    out.push("tests/ir-claim-fallback/" + n + ".vl")
  }
  const vl = envOr("VL", "scripts/vl-host/target/release/vl")
  const w = spawn(
    vl,
    [
      "run",
      "scripts/inventory/witnesses.vl",
      "--compiler",
      seed,
      "--",
      "--outcome",
      "emit_reject",
      "--out",
      tmp + "/witnesses",
    ],
  )
  if w.code != 0 { die("ir-parity: witnesses.vl failed\n\{w.out}\{w.err}", 2) }
  for l in split(w.out, "\n") {
    if endsWith(l, ".vl") { out.push(l) }
  }
  return out
}

// `--sample N`: the files whose path hashes to 0 mod `n` (FNV-1a), so the subset is fixed for a
// file and a new file joins or not without moving the others. `n` below 2 keeps every file.
function sampled(files: string[], n: i32): string[] {
  if n < 2 { return files }
  const out: string[] = []
  for f in files {
    const r = fnvFeed(-3750763034362895579, f.bytes()) % (n as i64)
    if r == 0 { out.push(f) }
  }
  return out
}

// The baseline key of each inventory witness `--files` materialised: its row's file.
const ROW_OF: Map<string, string> = Map()
// The `Want:` block of each such witness, "" when its row has none.
const WANT_OF: Map<string, string> = Map()

// The entry file of row file `doc`'s witness, written under `tmp`; `ROW_OF` and `WANT_OF` name it.
function rowWitness(doc: string, tmp: string): string {
  for r in parseRows(doc, splitLines(univNl(readText(doc)))) {
    if r.repro == "" { continue }
    const dir = tmp + "/rows/" + r.id
    if spawn("mkdir", ["-p", dir]).code != 0 {
      die("ir-parity: cannot make \{dir}", 2)
    }
    const parts = splitFiles(r.repro)
    let i = 0
    while i + 1 < parts.length {
      writeText(dir + "/" + parts[i], parts[i + 1])
      i = i + 2
    }
    const entry = dir + "/" + parts[parts.length - 2]
    ROW_OF[entry] = doc
    WANT_OF[entry] = r.want
    return entry
  }
  die("ir-parity: \{doc} holds no row with a Repro block", 2)
  return ""
}

function population(
  args: readonly string[],
  seed: string,
  tmp: string,
): string[] {
  const files = argsOf(args, "--files")
  const from = argOr(args, "--from", "")
  if files.length > 0 || from != "" {
    const out: string[] = []
    for f in files {
      if endsWith(f, ".md") {
        out.push(rowWitness(f, tmp))
      } else {
        out.push(f)
      }
    }
    // A `--from` line naming an inventory row is that row's witness, as with `--files`.
    if from != "" {
      for l in split(readText(from), "\n") {
        if endsWith(l, ".md") { out.push(rowWitness(l, tmp)) }
        else if l != "" { out.push(l) }
      }
    }
    return out
  }
  const out: string[] = []
  for p in split(argOr(args, "--pop", "cells,cases,probes"), ",") {
    let got: string[] = []
    if p == "cells" {
      got = cellsPop()
    } else if p == "cases" {
      got = sampled(casesPop(), parseI32(argOr(args, "--sample", "1")) ?? 1)
    } else if p == "probes" {
      got = probesPop()
    } else if p == "pins" {
      got = pinsPop()
    } else if p == "refusals" {
      got = refusalsPop(seed, tmp)
    } else {
      die(
        "ir-parity: --pop takes cells, cases, probes, pins and refusals, not \{p}",
        2,
      )
    }
    for f in got { out.push(f) }
  }
  sort(out, (a: string, b: string) => a < b)
  return out
}

// ── the chunk worker: `--chunk <file>` ───────────────────────────────────────────────

// What a chunk worker needs: the binary, both compilers, `std/`, scratch, and `--run-all`.
type Ctx = {
  vl: string,
  on: string,
  off: string,
  std: string,
  tmp: string,
  all: boolean,
}

// One side's build: its exit code and its first diagnostic line.
type Built = { rc: i32, err: string }

// The note a host prints before legacy's refusal when a claim declined (claimFallback.ts `softNote`).
const CLAIM_NOTE = "vl: note: an IR claim refused inside `"

// The first `path:line:col: message` line of a build log, else its first line, as
// `ir-identity.sh`'s `first_error` takes it.
function firstError(log: string): string {
  for l in split(log, "\n") {
    const c = l.indexOf(".vl:")
    if c > 0 && l.indexOf(" ") > c { return l }
  }
  // The host prints a declined claim's note before legacy's refusal; the refusal is compared.
  for l in split(log, "\n") {
    if l != "" && l.indexOf(CLAIM_NOTE) != 0 { return l }
  }
  return firstLine(log)
}

function build(c: Ctx, compiler: string, f: string, out: string): Built {
  // Strict, as every gate runs: an invalid claimed module is rc 70, never legacy's fallback bytes.
  const p = spawn(
    "env",
    [
      "VL_STD=" + c.std,
      "VL_IR_STRICT=1",
      "timeout",
      BUILD_SECS,
      c.vl,
      "build",
      f,
      "-o",
      out,
      "--compiler",
      compiler,
    ],
  )
  if p.code == 0 { return { rc: 0, err: "" } }
  return { rc: p.code, err: firstError(p.err + p.out) }
}

// One side's run: exit code, stdout, and how it failed (`ok`, `exit`, `trap: <kind>`,
// `invalid: <message>` or `error: <message>`), with offsets and indices erased.
type Ran = { rc: i32, out: string, how: string }

const INVALID = [
  "Invalid input WebAssembly code", "WebAssembly translation error",
  "wasm validation", "failed to parse", "failed to compile",
]

function run(c: Ctx, w: string): Ran {
  const p = spawn(
    "env",
    [
      "RUST_BACKTRACE=0",
      "VL_STD=" + c.std,
      "bash",
      "-c",
      CAPPED,
      RUN_SECS,
      c.vl,
      w,
    ],
  )
  if p.code == 0 { return { rc: 0, out: p.out, how: "ok" } }
  const t = p.err.indexOf("wasm trap: ")
  if t >= 0 {
    return {
      rc: p.code,
      out: p.out,
      how: "trap: " + firstLine(p.err.slice(t + 11, p.err.length)),
    }
  }
  for m in INVALID {
    if p.err.indexOf(m) >= 0 {
      return { rc: p.code, out: p.out, how: "invalid: " + norm(p.err) }
    }
  }
  if p.err == "" { return { rc: p.code, out: p.out, how: "exit" } }
  return { rc: p.code, out: p.out, how: "error: " + norm(firstLine(p.err)) }
}

// The first line on which two outputs part, for the detail column.
function firstDiff(a: string, b: string): string {
  const x = split(a, "\n")
  const y = split(b, "\n")
  let i = 0
  while i < x.length && i < y.length && x[i] == y[i] { i = i + 1 }
  const l = toString(i + 1)
  const xa = if i < x.length { x[i] } else { "<eof>" }
  const yb = if i < y.length { y[i] } else { "<eof>" }
  return "stdout line \{l}: \{xa.slice(0, 60)} vs \{yb.slice(0, 60)}"
}

function clean(s: string): string {
  return join(split(join(split(s, "\t"), " "), "\n"), " ")
}

// `s` without its trailing newlines.
function trimNl(s: string): string {
  let n = s.length
  while n > 0 && s.slice(n - 1, n) == "\n" { n = n - 1 }
  return s.slice(0, n)
}

// The row of a `legacy-wrong` program: its IR-on run against the expected output in `want`
// (`ok`, `trap` or `none` on the first line, then the stdout).
function legacyWrong(c: Ctx, f: string, k: string, want: string): string {
  const nl = want.indexOf("\n")
  const how = want.slice(0, nl)
  const out = want.slice(nl + 1, want.length)
  if how == "none" {
    return "differs\tlegacy-wrong: no expected output (no // @log, @trap or @run line, no Want)"
  }
  const a = c.tmp + "/" + k + ".on.wasm"
  const ba = build(c, c.on, f, a)
  if ba.rc == 124 { return "timeout(build on)\t" }
  if ba.rc != 0 { return "build-fails(on)\tlegacy-wrong: " + clean(ba.err) }
  const ra = run(c, a)
  spawn("rm", ["-f", a])
  if ra.rc == 124 { return "timeout(run on)\t" }
  if how == "ok" && ra.how != "ok" {
    return "differs\tlegacy-wrong: on "
      + clean(ra.how)
      + ", expected a clean run"
  }
  if how == "trap" && !startsWith(ra.how, "trap: ") {
    return "differs\tlegacy-wrong: on " + clean(ra.how) + ", expected a trap"
  }
  if trimNl(ra.out) != trimNl(out) {
    return "differs\tlegacy-wrong: on vs expected "
      + clean(firstDiff(ra.out, out))
  }
  return "same\tlegacy-wrong, on meets its expected output"
}

// One program's row: its verdict and detail, the two sides read as `on` and `off`.
function parity(c: Ctx, f: string, k: string): string {
  const wf = c.tmp + "/want/" + k
  if isFile(wf) { return legacyWrong(c, f, k, readText(wf)) }
  const a = c.tmp + "/" + k + ".on.wasm"
  const b = c.tmp + "/" + k + ".off.wasm"
  const ba = build(c, c.on, f, a)
  const bb = build(c, c.off, f, b)
  if ba.rc == 124 || bb.rc == 124 {
    const side = if ba.rc == 124 && bb.rc == 124 { "both" } else if ba.rc == 124 { "on" } else { "off" }
    return "timeout(build " + side + ")\t"
  }
  if ba.rc != 0 && bb.rc != 0 {
    if ba.err == bb.err { return "build-fails(both)\t" + clean(ba.err) }
    return "differs\trefusal: " + clean(ba.err) + " vs " + clean(bb.err)
  }
  if ba.rc != 0 { return "build-fails(on)\t" + clean(ba.err) }
  if bb.rc != 0 { return "build-fails(off)\t" + clean(bb.err) }
  const ident = spawn("cmp", ["-s", a, b]).code == 0
  if ident && !c.all {
    spawn("rm", ["-f", a, b])
    return "same\tbytes"
  }
  const ra = run(c, a)
  const rb = run(c, b)
  spawn("rm", ["-f", a, b])
  if ra.rc == 124 || rb.rc == 124 {
    const side = if ra.rc == 124 && rb.rc == 124 { "both" } else if ra.rc == 124 { "on" } else { "off" }
    return "timeout(run " + side + ")\t"
  }
  const parts: string[] = []
  if ra.rc != rb.rc {
    parts.push("exit " + toString(ra.rc) + " vs " + toString(rb.rc))
  }
  if ra.how != rb.how { parts.push(clean(ra.how) + " vs " + clean(rb.how)) }
  if ra.out != rb.out { parts.push(clean(firstDiff(ra.out, rb.out))) }
  // `off runs`: claimless ran clean, so the shipped side is the worse one (`--cross` reds on it).
  const lead = if rb.rc == 0 && rb.how == "ok" { "off runs; " } else { "" }
  if parts.length > 0 { return "differs\t" + lead + join(parts, "; ") }
  const how = if ra.how == "ok" { "" } else { ", " + clean(ra.how) }
  if ident { return "same\tbytes, ran" + how }
  return "same\tbehaviour" + how
}

// A chunk file is six header lines (vl, IR-on seed, IR-off seed, std, scratch, run-all) and then
// one program per line; the rows go to `<file>.out`.
function chunk(file: string) {
  const lines = split(readText(file), "\n")
  const c: Ctx = {
    vl: lines[0],
    on: lines[1],
    off: lines[2],
    std: lines[3],
    tmp: lines[4],
    all: lines[5] == "1",
  }
  const out: string[] = []
  let i = 6
  while i < lines.length {
    const f = lines[i]
    if f != "" {
      const k = join(split(f, "/"), "_")
      out.push(f + "\t" + parity(c, f, k) + "\n")
    }
    i = i + 1
  }
  writeText(file + ".out", join(out, ""))
}

// ── the parent ───────────────────────────────────────────────────────────────────

// The programs `ir-divergence-baseline.txt` lists (`program\tfunction\tmechanism\tPR`), each
// `true` when a line of it is `legacy-wrong:`.
function listed(path: string): Map<string, boolean> {
  const m: Map<string, boolean> = Map()
  if !isFile(path) { return m }
  for l in split(readText(path), "\n") {
    if l == "" || startsWith(l, "#") { continue }
    const f = split(l, "\t")
    if f.length != 4 {
      die("ir-parity: \{path}: not four tab-separated fields: \{l}", 2)
    }
    m[f[0]] = (m[f[0]] ?? false) || startsWith(f[2], "legacy-wrong:")
  }
  return m
}

// The expected output of program `f` as `legacyWrong` reads it: the row's `Want:` for a row
// witness, else the program's `// @log` lines, `// @trap` or `// @run`.
function expected(f: string): string {
  if ROW_OF.has(f) {
    const w = WANT_OF[f] ?? ""
    return if w == "" { "none\n" } else { "ok\n" + w }
  }
  let how = "none"
  const out: string[] = []
  for l in splitLines(univNl(readText(f))) {
    if l == "// @log" { out.push("\n") }
    else if startsWith(l, "// @log ") { out.push(l.slice(8, l.length) + "\n") }
    else if l == "// @trap" || startsWith(l, "// @trap ") { how = "trap" }
    else if l == "// @run" && how == "none" { how = "ok" }
  }
  if how == "none" && out.length > 0 { how = "ok" }
  return how + "\n" + join(out, "")
}

function count(m: Map<string, i32>, k: string) { m[k] = (m[k] ?? 0) + 1 }

function main(args: readonly string[]) {
  if args.length == 2 && args[0] == "--chunk" {
    chunk(args[1])
    return 0
  }
  const vl = envOr("VL", "scripts/vl-host/target/release/vl")
  const root = cwd()
  const seed = argOr(args, "--seed", TOOL_COMPILER)
  if !isFile(seed) { die("ir-parity: no seed at \{seed}", 2) }
  const tmp = makeTempDir()
  const progs = population(args, seed, tmp)
  if progs.length == 0 {
    spawn("rm", ["-rf", tmp])
    die("ir-parity: no programs", 2)
  }
  let off = argOr(args, "--claimless", "")
  if off == "" {
    off = tmp + "/claimless.wasm"
    const b = spawn(
      "bash",
      ["scripts/ir-identity.sh", "--build-claimless", seed, off],
    )
    if b.code != 0 {
      spawn("rm", ["-rf", tmp])
      die("ir-parity: cannot build the claimless compiler\n\{b.out}\{b.err}", 2)
    }
  }
  // Each compiler's compiled form is cached on first use, untimed here: a cold first use costs
  // about 15 s wall, and under load the workers' 60 s build timeout killed every cold compile
  // before it was stored, so every build compiled cold again and timed out.
  writeText(tmp + "/warm.vl", "print(1)\n")
  for c in [seed, off] {
    const h = spawn(
      vl,
      [
        "build",
        tmp + "/warm.vl",
        "--compiler",
        c,
        "-o",
        tmp + "/warm.wasm",
      ],
    )
    if h.code != 0 {
      spawn("rm", ["-rf", tmp])
      die("ir-parity: cannot warm the compiler \{c}\n\{h.out}\{h.err}", 2)
    }
  }
  const worker = tmp + "/worker.wasm"
  const w = spawn(
    vl,
    ["build", SELF, "--compiler", TOOL_COMPILER, "-o", worker],
  )
  if w.code != 0 {
    spawn("rm", ["-rf", tmp])
    die("ir-parity: cannot build \{SELF}\n\{w.out}\{w.err}", 2)
  }
  const base = listed(envOr("IR_DIVERGENCE_BASELINE", BASELINE))
  spawn("mkdir", ["-p", tmp + "/want"])
  for p in progs {
    if base[ROW_OF[p] ?? p] ?? false {
      writeText(tmp + "/want/" + join(split(p, "/"), "_"), expected(p))
    }
  }
  const abs = (p: string): string => if startsWith(p, "/") { p } else { root + "/" + p }
  const all = if hasFlag(args, "--run-all") { "1" } else { "0" }
  const head = join(
    [
      abs(vl),
      abs(seed),
      abs(off),
      envOr("VL_STD", root + "/std"),
      tmp,
      all,
    ],
    "\n",
  )
  const files: string[] = []
  let i = 0
  while i < progs.length {
    const file = tmp + "/chunk" + toString(files.length)
    writeText(file, head + "\n" + join(progs.slice(i, i + CHUNK), "\n") + "\n")
    files.push(file)
    i = i + CHUNK
  }
  writeText(tmp + "/chunks", join(files, "\n") + "\n")
  const jobs = parseI32(envOr("JOBS", "4")) ?? 4
  const cmd = [
    "env",
    "RAYON_NUM_THREADS=" + envOr("RAYON_NUM_THREADS", "1"),
    vl,
    "run",
    worker,
    "--",
    "--chunk",
  ]
  const x = spawn("sh", fanOutArgv(tmp + "/chunks", toString(jobs), cmd))
  const rows: string[] = []
  let missing = 0
  for file in files {
    if !isFile(file + ".out") {
      missing = missing + 1
      continue
    }
    for l in split(readText(file + ".out"), "\n") {
      if l != "" { rows.push(l) }
    }
  }
  spawn("rm", ["-rf", tmp])
  if x.code != 0 || missing > 0 {
    die(
      "ir-parity: \{toString(missing)} chunk(s) did not answer (fan-out rc \{toString(x.code)})\n\{x.err}",
      2,
    )
  }
  sort(rows, (a: string, b: string) => a < b)
  const loose = hasFlag(args, "--behaviour-only")
  const cross = hasFlag(args, "--cross")
  const n: Map<string, i32> = Map()
  let red = false
  let slow = false
  const out: string[] = []
  for r in rows {
    const f = split(r, "\t")
    f[0] = ROW_OF[f[0]] ?? f[0]
    const v = f[1]
    let d = f[2]
    if startsWith(d, "legacy-wrong, ") { count(n, "legacy-wrong") }
    if v == "same" && startsWith(d, "behaviour") {
      if base.has(f[0]) {
        d = d + ", expected divergence"
        count(n, "expected divergence")
      } else {
        d = d + ", unlisted divergence"
        count(n, "unlisted divergence")
        if !loose && !cross { red = true }
      }
    }
    count(n, v)
    if cross {
      if (
        v == "build-fails(on)"
        || v == "differs" && startsWith(d, "off runs; ")
      ) {
        red = true
      }
    } else if (
      v == "differs"
      || v == "build-fails(on)"
      || v == "build-fails(off)"
    ) {
      red = true
    }
    if startsWith(v, "timeout") { slow = true }
    const row = f[0] + "\t" + v + "\t" + d
    out.push(row + "\n")
    if (
      v != "same" && v != "build-fails(both)"
      || endsWith(d, "unlisted divergence")
    ) {
      print(row)
    }
  }
  const dest = argOr(args, "--out", "build/ir-parity.tsv")
  writeText(dest, join(out, ""))
  const keys = [
    "same", "differs", "build-fails(both)", "build-fails(on)",
    "build-fails(off)",
  ]
  const parts: string[] = []
  for k in keys { parts.push(k + " " + toString(n[k] ?? 0)) }
  let t = 0
  for k, c in n {
    if startsWith(k, "timeout") { t = t + c }
  }
  parts.push("timeout " + toString(t))
  print(
    "ir-parity: \{toString(rows.length)} programs: \{join(parts, ", ")}; byte differs behaviourally equal: expected \{toString(n["expected divergence"] ?? 0)}, unlisted \{toString(n["unlisted divergence"] ?? 0)}; legacy-wrong meeting expected output \{toString(n["legacy-wrong"] ?? 0)} (rows in \{dest})",
  )
  if red { exit(1) }
  if slow { exit(3) }
  return 0
}

const argv = programArgs()
if argv is Utf8Error {
  die("ir-parity: an argument is not UTF-8: " + argv.msg, 2)
} else {
  main(argv)
}
