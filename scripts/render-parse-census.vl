// Finds the emitter's render-then-parse calls, for the render-parse ratchet.
//
//     vl run scripts/render-parse-census.vl -- --list [<code>] [--root <dir>]
//     vl run scripts/render-parse-census.vl -- --out <findings.json> [--root <dir>]
//     vl run scripts/render-parse-census.vl -- --parsers [--root <dir>]   (every counted name)
//     vl run scripts/render-parse-census.vl -- --sites [--all-files] [--root <dir>]
//     vl run scripts/render-parse-census.vl -- --render-sites [--root <dir>]
//
// Counts render calls (`RENDERERS`; a message's `DISPLAY_RENDERERS` apart) and type-string parser
// calls in compiler/emit_*.vl, compiler/wasmEmit.vl and compiler/check_emit_queries.vl, minus
// the bodies of the renderers and parsers themselves (a parser's `<parser>Go` ladder included).
// The parsers are every export of compiler/tyname.vl, the type-name grammar, except the display
// rewrite `demangleSpelling` and the character test `nameIdentChar`, plus `EXTRA_PARSERS` below;
// a listed parser with no definition in compiler/ fails the census, so the list cannot go stale.
// Source is counted comment-stripped with string content blanked, so a name in a message is not
// a call.
// A parse's code is its input's origin, read from scripts/render-parse-origins.txt (written by
// scripts/render-parse-origins.ts): `ty-string-parse` a render or synthesized name, the
// violation; `ty-source-parse` source annotation text; `ty-parse-unclassified` a site no probe
// has graded. `--sites` prints each parse site's key, `<file>\t<fn>\t<callee>\t<ordinal>`, then
// its line and column; with `--all-files` it lists every compiler file's sites, not the emitter's.
// `--render-sites` prints each `ty-render` call the same way, keyed by its renderer.
// `--out` writes a `vl check --json`-shaped report that
// `vl check --budget scripts/render-parse-budget-baseline.json --findings <file>` counts.

import { IoError, listDir, readFile, writeTextFile } from "std:fs"
import { programArgs } from "std:args"
import { exit } from "std:process"
import { Utf8Error, decodeUtf8Lossy } from "std:utf8"
import { toJson } from "std:json"
import { join, split } from "std:str"
import { sort } from "std:array"

const RENDER = "ty-render"
const RENDER_DISPLAY = "ty-render-display"
const PARSE = "ty-string-parse"
const SOURCE = "ty-source-parse"
const UNCLASSIFIED = "ty-parse-unclassified"
const ORIGINS = "scripts/render-parse-origins.txt"
// The renderers whose spelling a later decision reads (a name, a row key, a pin), and the ones that
// render for a message, counted apart. A listed renderer declared nowhere fails the census.
const RENDERERS = [
  "tyToEmitName", "tyToNominalName", "tyToNominalNameAt", "canonEmitNameOfTy",
  "canonUnionKeyTextOfTy", "canonUnionKeyAtomOfTy", "unionSpellingOfTy",
  "cloSigNameOfTy", "rlRowNameOfTy", "monoPinSpellNoAnon", "monoPinSpellShaped",
]
const DISPLAY_RENDERERS = [
  "tyToStr", "tyToStructStr", "tyToStrUser", "tyToStructStrUser",
]
// The type-string parsers outside compiler/tyname.vl: each reads a type spelling back into a
// type, a member set, an atom kind or a shape fact. A checker-side one counts where the emitter
// calls it.
const EXTRA_PARSERS = [
  "nameToTy", "nameToTyAt", "resolveAnnot", "canonEmitName", "nullablePartOf",
  "annArrowAt", "nameIsLitUnionType", "isTopLevelFuncTypeName",
  "isValueUnionName", "unionHasAtom", "boolLeafListDepthOfName",
  "valueAtomKind", "nameIsInlineLitUnion",
  "canonUnionMembersInto", "canonUnionMembersLitsInto",
]
// The tyname.vl exports that read no spelling back: a rewrite for a message, and a test of one
// character code.
const DISPLAY_ONLY = ["demangleSpelling", "nameIdentChar"]
let PARSERS: string[] = []

type Hit = {
  rel: string,
  line: i32,
  col: i32,
  fn: string,
  code: string,
  callee: string,
  text: string,
}

function die(msg: string, code: i32) {
  print(msg)
  exit(code)
}

// Code-point order, the order Python's `sorted` gives a `str`.
function strLess(a: string, b: string): boolean {
  let i = 0
  while i < a.length && i < b.length {
    if a[i] != b[i] { return a[i] < b[i] }
    i = i + 1
  }
  a.length < b.length
}

function isIdent(c: i32): boolean {
  (c >= '0' && c <= '9')
    || (c >= 'A' && c <= 'Z')
    || (c >= 'a' && c <= 'z')
    || c == '_'
}

function isSpace(c: i32): boolean { c == ' ' || c == '\t' || c == '\r' }

function bytesOf(path: string): u8[] {
  const b = readFile(path)
  if b is IoError {
    die("render-parse-census: cannot read \{path} (\{b.msg})", 2)
    return []
  }
  b
}

function sortedNames(dir: string): string[] {
  const names = listDir(dir)
  if names is IoError {
    die("render-parse-census: cannot list \{dir} (\{names.msg})", 2)
    return []
  }
  sort(names, strLess)
  names
}

// Whether `b[i..]` spells `word`.
function bytesAt(b: u8[], i: i32, word: string): boolean {
  if i + word.length > b.length { return false }
  let k = 0
  while k < word.length {
    if b[i + k] != word[k] { return false }
    k = k + 1
  }
  true
}

// The line `b[lo..hi]` cut at its `//` comment, every string or char literal's content
// blanked to `x` with the quotes kept. Length is preserved, so a column read back lands
// where the walk found it.
function stripLine(b: u8[], lo: i32, hi: i32): u8[] {
  const out: u8[] = []
  let i = lo
  while i < hi {
    const c = b[i]
    if c == '/' && i + 1 < hi && b[i + 1] == '/' { break }
    if c == '"' || c == '\'' {
      out.push(c)
      i = i + 1
      while i < hi && b[i] != c {
        if b[i] == '\\' && i + 1 < hi {
          out.push('x')
          i = i + 1
        }
        out.push('x')
        i = i + 1
      }
      if i < hi {
        out.push(c)
        i = i + 1
      }
      continue
    }
    out.push(c)
    i = i + 1
  }
  out
}

// The name of a column-0 `[export ]function NAME(` header on `b[lo..hi]`, or "".
function headName(b: u8[], lo: i32, hi: i32): string {
  let i = lo
  if bytesAt(b, i, "export ") { i = i + 7 }
  if !bytesAt(b, i, "function ") { return "" }
  i = i + 9
  const s = i
  if i >= hi || !isIdent(b[i]) || (b[i] >= '0' && b[i] <= '9') { return "" }
  while i < hi && isIdent(b[i]) { i = i + 1 }
  const e = i
  while i < hi && isSpace(b[i]) { i = i + 1 }
  if i < hi && b[i] == '(' { return decodeUtf8Lossy(b.slice(s, e)) }
  ""
}

// The line the function opening at line `lo` closes on: `lo` for a one-liner, `hi` when
// the braces never balance.
function fnEnd(stripped: u8[][], lo: i32, hi: i32): i32 {
  let depth = 0
  let opened = false
  let n = lo
  while n <= hi {
    for ch in stripped[n] {
      if ch == '{' {
        depth = depth + 1
        opened = true
      } else if ch == '}' {
        depth = depth - 1
      }
    }
    if opened && depth <= 0 { return n }
    n = n + 1
  }
  hi
}

function blankLine(b: u8[], s: i32, e: i32): boolean {
  let i = s
  while i < e {
    if !isSpace(b[i]) { return false }
    i = i + 1
  }
  true
}

function isRendererName(name: string): boolean {
  for r in RENDERERS {
    if r == name { return true }
  }
  for r in DISPLAY_RENDERERS {
    if r == name { return true }
  }
  false
}

function isExempt(fn: string): boolean {
  // A renderer's body, its `<renderer>At`/`<renderer>Go` variants included, is the renderer.
  for r in RENDERERS {
    if fn.length >= r.length && fn.slice(0, r.length) == r { return true }
  }
  for r in DISPLAY_RENDERERS {
    if fn.length >= r.length && fn.slice(0, r.length) == r { return true }
  }
  // A parser's `<parser>Go` helper is the ladder behind its memo, so it is the parser's body.
  for p in PARSERS {
    if p == fn || "\{p}Go" == fn { return true }
  }
  false
}

function codeOf(callee: string): string {
  for r in RENDERERS {
    if r == callee { return RENDER }
  }
  for r in DISPLAY_RENDERERS {
    if r == callee { return RENDER_DISPLAY }
  }
  UNCLASSIFIED
}

// The stable key of a parse site: its file, enclosing function, callee and its ordinal among
// that function's calls to that callee, so a line moving does not orphan its grade.
function siteKey(h: Hit, ordinal: i32): string {
  "\{h.rel}\t\{h.fn}\t\{h.callee}\t\{ordinal}"
}

// Each parse hit's key, in `found`'s order.
function siteKeys(found: Hit[]): string[] {
  const keys: string[] = []
  const seen: string[] = []
  const counts: i32[] = []
  for h in found {
    if isRendererName(h.callee) {
      keys.push("")
      continue
    }
    const base = "\{h.rel}\t\{h.fn}\t\{h.callee}"
    let j = 0
    while j < seen.length && seen[j] != base { j = j + 1 }
    if j == seen.length {
      seen.push(base)
      counts.push(0)
    }
    keys.push(siteKey(h, counts[j]))
    counts[j] = counts[j] + 1
  }
  keys
}

// Each `ty-render` hit's key, in `found`'s order; "" for every other hit.
function renderKeys(found: Hit[]): string[] {
  const keys: string[] = []
  const seen: string[] = []
  const counts: i32[] = []
  for h in found {
    if h.code != RENDER {
      keys.push("")
      continue
    }
    const base = "\{h.rel}\t\{h.fn}\t\{h.callee}"
    let j = 0
    while j < seen.length && seen[j] != base { j = j + 1 }
    if j == seen.length {
      seen.push(base)
      counts.push(0)
    }
    keys.push(siteKey(h, counts[j]))
    counts[j] = counts[j] + 1
  }
  keys
}

// Re-codes each parse hit by the origin `<root>/scripts/render-parse-origins.txt` grades its key
// with (`render` or `source`); a key the file does not grade stays unclassified.
function applyOrigins(root: string, found: Hit[]): Hit[] {
  const path = "\{root}/\{ORIGINS}"
  const listed = listDir("\{root}/scripts")
  if listed is IoError { return found }
  let present = false
  for n in listed {
    if n == "render-parse-origins.txt" { present = true }
  }
  if !present { return found }
  const grades: {[string]: string} = Map()
  const text = decodeUtf8Lossy(bytesOf(path))
  for line in text.split("\n") {
    if line.length == 0 || line[0] == '#' { continue }
    let tab = 0
    while tab < line.length && line[tab] != '\t' { tab = tab + 1 }
    if tab >= line.length { continue }
    grades[line.slice(tab + 1, line.length)] = line.slice(0, tab)
  }
  const keys = siteKeys(found)
  const out: Hit[] = []
  let i = 0
  while i < found.length {
    const h = found[i]
    let code = h.code
    const g = grades[keys[i]] ?? ""
    if g == "render" { code = PARSE }
    else if g == "source" { code = SOURCE }
    out.push(
      {
        rel: h.rel,
        line: h.line,
        col: h.col,
        fn: h.fn,
        code: code,
        callee: h.callee,
        text: h.text,
      },
    )
    i = i + 1
  }
  out
}

// The counted callee spelled by the identifier run `t[s..e]`, or "".
function counted(t: u8[], s: i32, e: i32): string {
  const name = decodeUtf8Lossy(t.slice(s, e))
  if isRendererName(name) { return name }
  for p in PARSERS {
    if p == name { return name }
  }
  ""
}

function hitsIn(rel: string, b: u8[], out: Hit[]) {
  const starts: i32[] = []
  const ends: i32[] = []
  const stripped: u8[][] = []
  let a = 0
  while a <= b.length {
    let e = a
    while e < b.length && b[e] != '\n' { e = e + 1 }
    starts.push(a)
    ends.push(e)
    stripped.push(stripLine(b, a, e))
    a = e + 1
  }
  const nl = starts.length
  const owner: string[] = []
  const heads: i32[] = []
  const names: string[] = []
  let n = 0
  while n < nl {
    owner.push("")
    const h = headName(b, starts[n], ends[n])
    if h != "" {
      heads.push(n)
      names.push(h)
    }
    n = n + 1
  }
  let k = 0
  while k < heads.length {
    let end = fnEnd(stripped, heads[k], nl - 1)
    if k + 1 < heads.length && heads[k + 1] - 1 < end { end = heads[k + 1] - 1 }
    while end > heads[k] && blankLine(b, starts[end], ends[end]) {
      end = end - 1
    }
    let m = heads[k]
    while m <= end {
      owner[m] = names[k]
      m = m + 1
    }
    k = k + 1
  }
  n = 0
  while n < nl {
    const t = stripped[n]
    let i = 0
    while i < t.length {
      if !isIdent(t[i]) {
        i = i + 1
        continue
      }
      const s = i
      while i < t.length && isIdent(t[i]) { i = i + 1 }
      if s > 0 && (isIdent(t[s - 1]) || t[s - 1] == '.') { continue }
      const callee = counted(t, s, i)
      if callee == "" { continue }
      let j = i
      while j < t.length && isSpace(t[j]) { j = j + 1 }
      if j >= t.length || t[j] != '(' { continue }
      let p = s
      while p > 0 && isSpace(t[p - 1]) { p = p - 1 }
      if p >= 8 && decodeUtf8Lossy(t.slice(p - 8, p)) == "function" { continue }
      if isExempt(owner[n]) { continue }
      out.push(
        {
          rel: rel,
          line: n + 1,
          col: s + 1,
          fn: owner[n],
          code: codeOf(callee),
          callee: callee,
          text: decodeUtf8Lossy(b.slice(starts[n], ends[n])),
        },
      )
    }
    n = n + 1
  }
  0
}

// Every counted call in the emitter files under `root` (every compiler file but the grammar's
// own when `allFiles`), in file, line, column order.
function hits(root: string, allFiles: boolean): Hit[] {
  const out: Hit[] = []
  for n in sortedNames("\{root}/compiler") {
    if n.length < 3 || n.slice(n.length - 3, n.length) != ".vl" { continue }
    if (
      (n.length >= 5 && n.slice(0, 5) == "emit_")
      || n == "wasmEmit.vl"
      || n == "check_emit_queries.vl"
      || (allFiles && n != "tyname.vl")
    ) {
      hitsIn("compiler/\{n}", bytesOf("\{root}/compiler/\{n}"), out)
    }
  }
  out
}

// The function names `b` declares at column 0; `exportedOnly` keeps the `export`ed ones.
function declNames(b: u8[], exportedOnly: boolean): string[] {
  const out: string[] = []
  let a = 0
  while a < b.length {
    let e = a
    while e < b.length && b[e] != '\n' { e = e + 1 }
    const h = headName(b, a, e)
    if h != "" && (!exportedOnly || bytesAt(b, a, "export ")) { out.push(h) }
    a = e + 1
  }
  out
}

// The parser set under `root`: tyname.vl's exports but `DISPLAY_ONLY`, then
// `EXTRA_PARSERS`. Dies when an extra parser is declared nowhere in compiler/.
function loadParsers(root: string): string[] {
  const ps: string[] = []
  for nm in declNames(bytesOf("\{root}/compiler/tyname.vl"), true) {
    let shown = false
    for d in DISPLAY_ONLY {
      if d == nm { shown = true }
    }
    if !shown { ps.push(nm) }
  }
  const declared: string[] = []
  for n in sortedNames("\{root}/compiler") {
    if n.length < 3 || n.slice(n.length - 3, n.length) != ".vl" { continue }
    for nm in declNames(bytesOf("\{root}/compiler/\{n}"), false) {
      declared.push(nm)
    }
  }
  for x in EXTRA_PARSERS {
    let found = false
    for d in declared {
      if d == x { found = true }
    }
    if !found {
      die(
        "render-parse-census: parser `\{x}` is declared nowhere in compiler/; drop it from EXTRA_PARSERS",
        2,
      )
    }
    ps.push(x)
  }
  for group in [RENDERERS, DISPLAY_RENDERERS] {
    for x in group {
      let found = false
      for d in declared {
        if d == x { found = true }
      }
      if !found {
        die(
          "render-parse-census: renderer `\{x}` is declared nowhere in compiler/; drop it from its list",
          2,
        )
      }
    }
  }
  ps
}

function jsonText(s: string): string {
  const j = toJson(s)
  if j is string { return j }
  "\"\""
}

function main(args: string[]) {
  let root = "."
  let list = false
  let only = ""
  let outPath = ""
  let parsersOnly = false
  let sitesOnly = false
  let renderSites = false
  let allFiles = false
  let i = 0
  while i < args.length {
    if args[i] == "--root" && i + 1 < args.length {
      root = args[i + 1]
      i = i + 1
    } else if args[i] == "--out" && i + 1 < args.length {
      outPath = args[i + 1]
      i = i + 1
    } else if args[i] == "--parsers" {
      parsersOnly = true
    } else if args[i] == "--sites" {
      sitesOnly = true
    } else if args[i] == "--render-sites" {
      renderSites = true
    } else if args[i] == "--all-files" {
      allFiles = true
    } else if args[i] == "--list" {
      list = true
      if (
        i + 1 < args.length
        && !(args[i + 1].length >= 2 && args[i + 1].slice(0, 2) == "--")
      ) {
        only = args[i + 1]
        i = i + 1
      }
    } else {
      die("render-parse-census: unknown argument `\{args[i]}`", 2)
    }
    i = i + 1
  }
  PARSERS = loadParsers(root)
  if parsersOnly {
    for p in PARSERS { print(p) }
    for r in RENDERERS { print(r) }
    for r in DISPLAY_RENDERERS { print(r) }
    return 0
  }
  if sitesOnly {
    const all = hits(root, allFiles)
    const keys = siteKeys(all)
    let k = 0
    while k < all.length {
      if keys[k] != "" { print("\{keys[k]}\t\{all[k].line}\t\{all[k].col}") }
      k = k + 1
    }
    return 0
  }
  if renderSites {
    const all = hits(root, false)
    const keys = renderKeys(all)
    let k = 0
    while k < all.length {
      if keys[k] != "" { print("\{keys[k]}\t\{all[k].line}\t\{all[k].col}") }
      k = k + 1
    }
    return 0
  }
  if !list && outPath == "" {
    die(
      "render-parse-census: usage: render-parse-census.vl (--list [code] | --out <file> | --parsers | --sites | --render-sites) [--root <dir>]",
      2,
    )
  }
  const found = applyOrigins(root, hits(root, false))
  if list {
    for h in found {
      if only == "" || h.code == only {
        print("\{h.rel}:\{h.line}  \{h.fn}  \{h.callee}")
      }
    }
  }
  if outPath != "" {
    const rows: string[] = []
    for h in found {
      let msg = "`\{h.callee}(` in \{h.fn}: the emitter renders a type and parses the spelling back"
      if h.code == SOURCE {
        msg = "`\{h.callee}(` in \{h.fn}: the emitter parses source annotation text"
      } else if h.code == UNCLASSIFIED {
        msg = "`\{h.callee}(` in \{h.fn}: a type-string parse no origin probe has graded"
      }
      rows.push(
        "{\"file\": \{jsonText(h.rel)}, \"line\": \{h.line}, \"col\": \{h.col}, \"severity\": \"warning\", \"code\": \"\{h.code}\", \"message\": \{jsonText(msg)}, \"text\": \{jsonText(h.text)}}",
      )
    }
    const r = writeTextFile(outPath, "[\{join(rows, ",\n")}]\n")
    if r is IoError {
      die("render-parse-census: cannot write \{outPath} (\{r.msg})", 2)
    }
  }
  0
}

const argv = programArgs()
if argv is Utf8Error {
  die("render-parse-census: an argument is not UTF-8: \{argv.msg}", 2)
} else {
  main(argv)
}
