// Finds the emitter's render-then-parse calls, for the render-parse ratchet.
//
//     vl run scripts/render-parse-census.vl -- --list [ty-render|ty-string-parse] [--root <dir>]
//     vl run scripts/render-parse-census.vl -- --out <findings.json> [--root <dir>]
//
// Counts `tyToEmitName(` calls and calls to ten type-string parsers in compiler/emit_*.vl and
// compiler/wasmEmit.vl, minus the bodies of the renderers and parsers themselves (a parser's
// `<parser>Go` ladder included). Source is counted comment-stripped with string content blanked,
// so a name in a message is not a call.
// `--out` writes a `vl check --json`-shaped report that
// `vl check --budget scripts/render-parse-budget-baseline.json --findings <file>` counts.

import { IoError, listDir, readFile, writeTextFile } from "std:fs"
import { programArgs } from "std:args"
import { exit } from "std:process"
import { Utf8Error, decodeUtf8Lossy } from "std:utf8"
import { toJson } from "std:json"
import { join } from "std:str"
import { sort } from "std:array"

const RENDER = "ty-render"
const PARSE = "ty-string-parse"
const RENDERER = "tyToEmitName"
const PARSERS = [
  "nameIsArray", "nullablePartOf", "nameIsLitUnionType", "splitUnionAtoms",
  "annArrowAt", "nameIsRefArray", "unionMemberCount", "mapValNameOf",
  "refArrElemName", "isTopLevelFuncTypeName",
]

type Hit = {
  rel: string,
  line: i32,
  col: i32,
  fn: string,
  code: string,
  callee: string,
  text: string,
}

function die(msg: string, code: i32) {
  print(msg)
  exit(code)
}

// Code-point order, the order Python's `sorted` gives a `str`.
function strLess(a: string, b: string): boolean {
  let i = 0
  while i < a.length && i < b.length {
    if a[i] != b[i] { return a[i] < b[i] }
    i = i + 1
  }
  a.length < b.length
}

function isIdent(c: i32): boolean {
  (c >= '0' && c <= '9')
    || (c >= 'A' && c <= 'Z')
    || (c >= 'a' && c <= 'z')
    || c == '_'
}

function isSpace(c: i32): boolean { c == ' ' || c == '\t' || c == '\r' }

function bytesOf(path: string): u8[] {
  const b = readFile(path)
  if b is IoError {
    die("render-parse-census: cannot read \{path} (\{b.msg})", 2)
    return []
  }
  b
}

function sortedNames(dir: string): string[] {
  const names = listDir(dir)
  if names is IoError {
    die("render-parse-census: cannot list \{dir} (\{names.msg})", 2)
    return []
  }
  sort(names, strLess)
  names
}

// Whether `b[i..]` spells `word`.
function bytesAt(b: u8[], i: i32, word: string): boolean {
  if i + word.length > b.length { return false }
  let k = 0
  while k < word.length {
    if b[i + k] != word[k] { return false }
    k = k + 1
  }
  true
}

// The line `b[lo..hi]` cut at its `//` comment, every string or char literal's content
// blanked to `x` with the quotes kept. Length is preserved, so a column read back lands
// where the walk found it.
function stripLine(b: u8[], lo: i32, hi: i32): u8[] {
  const out: u8[] = []
  let i = lo
  while i < hi {
    const c = b[i]
    if c == '/' && i + 1 < hi && b[i + 1] == '/' { break }
    if c == '"' || c == '\'' {
      out.push(c)
      i = i + 1
      while i < hi && b[i] != c {
        if b[i] == '\\' && i + 1 < hi {
          out.push('x')
          i = i + 1
        }
        out.push('x')
        i = i + 1
      }
      if i < hi {
        out.push(c)
        i = i + 1
      }
      continue
    }
    out.push(c)
    i = i + 1
  }
  out
}

// The name of a column-0 `[export ]function NAME(` header on `b[lo..hi]`, or "".
function headName(b: u8[], lo: i32, hi: i32): string {
  let i = lo
  if bytesAt(b, i, "export ") { i = i + 7 }
  if !bytesAt(b, i, "function ") { return "" }
  i = i + 9
  const s = i
  if i >= hi || !isIdent(b[i]) || (b[i] >= '0' && b[i] <= '9') { return "" }
  while i < hi && isIdent(b[i]) { i = i + 1 }
  const e = i
  while i < hi && isSpace(b[i]) { i = i + 1 }
  if i < hi && b[i] == '(' { return decodeUtf8Lossy(b.slice(s, e)) }
  ""
}

// The line the function opening at line `lo` closes on: `lo` for a one-liner, `hi` when
// the braces never balance.
function fnEnd(stripped: u8[][], lo: i32, hi: i32): i32 {
  let depth = 0
  let opened = false
  let n = lo
  while n <= hi {
    for ch in stripped[n] {
      if ch == '{' {
        depth = depth + 1
        opened = true
      } else if ch == '}' {
        depth = depth - 1
      }
    }
    if opened && depth <= 0 { return n }
    n = n + 1
  }
  hi
}

function blankLine(b: u8[], s: i32, e: i32): boolean {
  let i = s
  while i < e {
    if !isSpace(b[i]) { return false }
    i = i + 1
  }
  true
}

function isExempt(fn: string): boolean {
  if fn.length >= RENDERER.length && fn.slice(0, RENDERER.length) == RENDERER {
    return true
  }
  // A parser's `<parser>Go` helper is the ladder behind its memo, so it is the parser's body.
  for p in PARSERS {
    if p == fn || "\{p}Go" == fn { return true }
  }
  false
}

function codeOf(callee: string): string {
  if callee == RENDERER { return RENDER }
  PARSE
}

// The counted callee spelled by the identifier run `t[s..e]`, or "".
function counted(t: u8[], s: i32, e: i32): string {
  const name = decodeUtf8Lossy(t.slice(s, e))
  if name == RENDERER { return name }
  for p in PARSERS {
    if p == name { return name }
  }
  ""
}

function hitsIn(rel: string, b: u8[], out: Hit[]) {
  const starts: i32[] = []
  const ends: i32[] = []
  const stripped: u8[][] = []
  let a = 0
  while a <= b.length {
    let e = a
    while e < b.length && b[e] != '\n' { e = e + 1 }
    starts.push(a)
    ends.push(e)
    stripped.push(stripLine(b, a, e))
    a = e + 1
  }
  const nl = starts.length
  const owner: string[] = []
  const heads: i32[] = []
  const names: string[] = []
  let n = 0
  while n < nl {
    owner.push("")
    const h = headName(b, starts[n], ends[n])
    if h != "" {
      heads.push(n)
      names.push(h)
    }
    n = n + 1
  }
  let k = 0
  while k < heads.length {
    let end = fnEnd(stripped, heads[k], nl - 1)
    if k + 1 < heads.length && heads[k + 1] - 1 < end { end = heads[k + 1] - 1 }
    while end > heads[k] && blankLine(b, starts[end], ends[end]) {
      end = end - 1
    }
    let m = heads[k]
    while m <= end {
      owner[m] = names[k]
      m = m + 1
    }
    k = k + 1
  }
  n = 0
  while n < nl {
    const t = stripped[n]
    let i = 0
    while i < t.length {
      if !isIdent(t[i]) {
        i = i + 1
        continue
      }
      const s = i
      while i < t.length && isIdent(t[i]) { i = i + 1 }
      if s > 0 && (isIdent(t[s - 1]) || t[s - 1] == '.') { continue }
      const callee = counted(t, s, i)
      if callee == "" { continue }
      let j = i
      while j < t.length && isSpace(t[j]) { j = j + 1 }
      if j >= t.length || t[j] != '(' { continue }
      let p = s
      while p > 0 && isSpace(t[p - 1]) { p = p - 1 }
      if p >= 8 && decodeUtf8Lossy(t.slice(p - 8, p)) == "function" { continue }
      if isExempt(owner[n]) { continue }
      out.push(
        {
          rel: rel,
          line: n + 1,
          col: s + 1,
          fn: owner[n],
          code: codeOf(callee),
          callee: callee,
          text: decodeUtf8Lossy(b.slice(starts[n], ends[n])),
        },
      )
    }
    n = n + 1
  }
  0
}

// Every counted call in the emitter files under `root`, in file, line, column order.
function hits(root: string): Hit[] {
  const out: Hit[] = []
  for n in sortedNames("\{root}/compiler") {
    if n.length < 3 || n.slice(n.length - 3, n.length) != ".vl" { continue }
    if (n.length >= 5 && n.slice(0, 5) == "emit_") || n == "wasmEmit.vl" {
      hitsIn("compiler/\{n}", bytesOf("\{root}/compiler/\{n}"), out)
    }
  }
  out
}

function jsonText(s: string): string {
  const j = toJson(s)
  if j is string { return j }
  "\"\""
}

function main(args: string[]) {
  let root = "."
  let list = false
  let only = ""
  let outPath = ""
  let i = 0
  while i < args.length {
    if args[i] == "--root" && i + 1 < args.length {
      root = args[i + 1]
      i = i + 1
    } else if args[i] == "--out" && i + 1 < args.length {
      outPath = args[i + 1]
      i = i + 1
    } else if args[i] == "--list" {
      list = true
      if (
        i + 1 < args.length
        && !(args[i + 1].length >= 2 && args[i + 1].slice(0, 2) == "--")
      ) {
        only = args[i + 1]
        i = i + 1
      }
    } else {
      die("render-parse-census: unknown argument `\{args[i]}`", 2)
    }
    i = i + 1
  }
  if !list && outPath == "" {
    die(
      "render-parse-census: usage: render-parse-census.vl (--list [code] | --out <file>) [--root <dir>]",
      2,
    )
  }
  const found = hits(root)
  if list {
    for h in found {
      if only == "" || h.code == only {
        print("\{h.rel}:\{h.line}  \{h.fn}  \{h.callee}")
      }
    }
  }
  if outPath != "" {
    const rows: string[] = []
    for h in found {
      const msg = "`\{h.callee}(` in \{h.fn}: the emitter renders a type and parses the spelling back"
      rows.push(
        "{\"file\": \{jsonText(h.rel)}, \"line\": \{h.line}, \"col\": \{h.col}, \"severity\": \"warning\", \"code\": \"\{h.code}\", \"message\": \{jsonText(msg)}, \"text\": \{jsonText(h.text)}}",
      )
    }
    const r = writeTextFile(outPath, "[\{join(rows, ",\n")}]\n")
    if r is IoError {
      die("render-parse-census: cannot write \{outPath} (\{r.msg})", 2)
    }
  }
  0
}

const argv = programArgs()
if argv is Utf8Error {
  die("render-parse-census: an argument is not UTF-8: \{argv.msg}", 2)
} else {
  main(argv)
}
